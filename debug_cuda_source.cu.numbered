  348: struct Element {
  349: 
  350:    // Geometry information
  351:    int idx;               // Index of the element
  352:    int i34;               // Number of sides for the element 
  353:    Side *sides[4];        // Sides of the element
  354:    Node *nodes[4];        // Nodes of the element
  355:    Element *nghbElems[4]; // Neighbors of the element
  356: 
  357:    int kb;                    // Bottom index of the element
  358:    double area;               // Area of the element
  359:    double ssign[4];           // Sign associated with each side of an element
  360:    double radius;             // Element equivalent radii
  361: 
  362:    Frame frame;
  363: 
  364:    Vector2 gradPhi[4];       // Derivatives of shape functions
  365:    Vector2 gradEta[nvrt];    // Gradient of free surface elevation
  366: 
  367:    bool isDry;                  // True if the element is dry
  368:    int kbe;                   // Bottom index of the element
  369: 
  370:    Vector3 center;            // Element center coordinates
  371:    double xlon_el, ylat_el;   // Element center lat/lon coordinates in _degrees_
  372:    double depth;              // Depth at element (min of all nodes)
  373:    double z[nvrt];            // z-coord  (local frame - vertical up)
  374: 
  375:    // Physical information
  376:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  377: 
  378:    static const bool isblock = false;              // Always false
  379: 
  380:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  381:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  382: 
  383:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  384: 
  385:    
  386: 
  387:    double vsource;            // Volumetric source/sink term [m^3/s]
  388: 
  389:    double rho[nvrt];          // Density at each prism center
  390:    double rho_mean[nvrt];     // Mean density at each prism center
  391:    CubicSpline rho_spl;
  392:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  393:    double rho_z[nvrt];        // First derivative of density at each prism center
  394:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  395: 
  396:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  397: 
  398:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  399:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  400: 
  401:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 1; }
  402:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 1; }
  403: 
  404:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  405:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  406:       // Find the local index of the node in the element (0,1,2,3)
  407:       int res = __ffs((nodes[0] == node) | 
  408:                      ((nodes[1] == node) << 1) | 
  409:                      ((nodes[2] == node) << 2) | 
  410:                      ((nodes[3] == node) << 3)) - 1;
  411:       
  412:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  413:       return res;
  414:    }
  415: 
  416:    __inline__ __device__ int findLevel(double z1, int k) const {
  417:       // Starting at index k, find sequentially the level that contains z
  418: 
  419:       // if z is already betweeen z[k] and z[k+1], return k
  420:       if (z1 >= z[k] && z1 < z[k+1]) return k;
  421:       else if (z1 < z[k]) { 
  422:          // Search for increasing levels
  423:          for (int kk = k; kk < nvrt - 1; kk++) {
  424:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  425:          }
  426:          return nvrt - 1;
  427:       }
  428:       else {
  429:          // Search for decreasing levels
  430:          for (int kk = k; kk > 0; kk--) {
  431:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  432:          }
  433:          return 0;
  434:       }
  435:    }
  436: 
  437:    __inline__ __device__ double z_prism(int k) const { return 0.5*(z[k+1] + z[k]); }
  438:    __inline__ __device__ double Dz(int k)      const { return z[k+1] - z[k]; }
  439: 
  440:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  441: 
  442:    __inline__ __device__ double computeSignedArea(void) const;
  443: 
  444:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  445:       // Nudges the point (x,y) to the barycenter of the element
  446:       p = (1-eps)*p + eps*toVector2(center);
  447:    }
  448: 
  449:    __device__ bool computeShapeCoords(Point2 xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  450: 
  451:    __device__ Vector2 grad(double *a) const
  452:    {
  453:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  454:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  455:       if (isQuad()) {
  456:          gx += a[3]*gradPhi[3].x;
  457:          gy += a[3]*gradPhi[3].y;
  458:       }
  459:       return {gx, gy};
  460:    }
  461: 
  462:    __device__ void setFrame(void) {
  463: 
  464:       double ar1, ar2;
  465:       computeLonLat(center, ar1, ar2);
  466: 
  467:       frame.update(ar1, ar2);        
  468:     }
  469: 
  470:    __device__ bool findNextIntersection(Point2 x2, Side *&side, Element *&nextElement, double &t, 
  471:                                         double& tIntersect);
  472:    __device__ bool findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement, double &t, 
  473:                                         double& tIntersect);
  474: 
  475:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  476:       // Check if the point (xt,yt) is inside the element
  477:       double shpCoords[4];
  478:       bool res = computeShapeCoords(xt, shpCoords, false);
  479:       return res;
  480:    }
  481: 
  482:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4])
  483:    {
  484:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  485:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  486:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  487:       
  488:    }
  489: 
  490:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int);
  491: 
  492:    // ------------------------------------------------------------------------------------------------
  493:    // These are functions that work on all nodes of the element.
  494:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  495:    //
  496:    // An example of how to use these functions is:
  497:    //   
  498:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  499:    // 
  500:    // Where L is the level at which the field is to be interpolated. The field can be either
  501:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  502:    // There are different versions of getNodalValues for each of these cases.
  503: 
  504:    template<typename T>
  505:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  506:       // Get the values of the field at the nodes of the element
  507:       res[0] = nodes[0]->*field;
  508:       res[1] = nodes[1]->*field;
  509:       res[2] = nodes[2]->*field;
  510:       if (isQuad()) res[3] = nodes[3]->*field;
  511:       else          res[3] = T();
  512:    }
  513: 
  514:    template<typename T>
  515:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  516:       // Get the values of the field at the nodes of the element
  517:       res[0] = (nodes[0]->*field)[level];
  518:       res[1] = (nodes[1]->*field)[level];
  519:       res[2] = (nodes[2]->*field)[level];
  520:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  521:       else          res[3] = T();
  522:    }    
  523: 
  524:    template<typename T>
  525:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  526:       // Get the values of the func at the nodes of the element
  527:       res[0] = (nodes[0]->*func)(level);
  528:       res[1] = (nodes[1]->*func)(level);
  529:       res[2] = (nodes[2]->*func)(level);
  530:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  531:       else          res[3] = T();  // This is 0.0 or a zero vector
  532: 
  533:    }      
  534: 
  535:    template<typename T>
  536:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  537:       // Get the values of the field at the nodes of the element
  538:       res[0] = sides[0]->*field;
  539:       res[1] = sides[1]->*field;
  540:       res[2] = sides[2]->*field;
  541:       if (isQuad()) res[3] = sides[3]->*field;
  542:       else          res[3] = T();
  543:    }
  544: 
  545:    template<typename T>
  546:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  547:       // Get the values of the field at the nodes of the element
  548:       res[0] = (sides[0]->*field)[level];
  549:       res[1] = (sides[1]->*field)[level];
  550:       res[2] = (sides[2]->*field)[level];
  551:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  552:       else          res[3] = T();
  553:    }    
  554: 
  555:    template<typename T>
  556:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  557:       // Get the values of the func at the nodes of the element
  558:       res[0] = (sides[0]->*func)(level);
  559:       res[1] = (sides[1]->*func)(level);
  560:       res[2] = (sides[2]->*func)(level);
  561:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  562:       else          res[3] = T();  // This is 0.0 or a zero vector
  563: 
  564:    }      
  565: 
  566: 
  567:    __device__ double interpolate(int level, const double shapeCoords[4], double (Node::*func)(int) const) const {
  568:       double values[4];
  569:       getNodalValues(level, func, values);
  570: 
  571:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  572:    }
  573: 
  574:    template<typename T>
  575:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  576:       T values[4];
  577:       getNodalValues(field, values);
  578:       
  579:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  580:    }
  581: 
  582: 
  583:    template<typename T>
  584:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  585:       T values[4];
  586:       getNodalValues(level, field, values);
  587: 
  588:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  589:    }
  590: 
  591:    template<typename T>
  592:    __device__ T mean(T Node::* field) const {
  593:       T values[4];
  594:       getNodalValues(field, values);
  595: 
  596:       return (values[0] + values[1] + values[2] + values[3])/i34;
  597:    }
  598: 
  599:    template<typename T>
  600:    __device__ T mean(T Side::* field) const {
  601:       T values[4];
  602:       getSideValues(field, values);
  603:       
  604:       return (values[0] + values[1] + values[2] + values[3])/i34;
  605:    }   
  606: 
  607:    // __device__ double mean(double (Node::*func)(int) const) const {
  608:    //    double values[4];
  609:    //    getNodalValues(level, func, values);
  610:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  611:    // }
  612:    // ------------------------------------------------------------------------------------------------
  613: 
  614:    __device__ bool globalToLocal(double xt, double yt, double &xlocal, double &ylocal) const {
  615:       // Convert global coordinates to local coordinates
  616:       printf("NOT IMPLEMENTED: globalToLocal\n");
  617:       return true;
  618:    }
  619: 
  620:    __inline__ __device__ bool localToGlobal(double xlocal, double ylocal, double &xt, double &yt) const {
  621:       // Convert local coordinates to global coordinates
  622:       printf("NOT IMPLEMENTED: localToGlobal\n");
  623:       return true;
  624:    }
  625: 
  626:    __device__ void trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
  627:                                        double &dt, Point3 &xt, double zint, Vector3 &u_int);
  628:     
  629:    __device__ bool trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
  630:                                                  Element *&nextElem, int &jlev, double &dt);
  631: 
  632: };
