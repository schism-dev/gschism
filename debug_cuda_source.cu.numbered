 2386: 
 2387: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 2388:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 2389:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 2390:    // 
 2391:    // This kernel is called for all nodes.
 2392: 
 2393: 
 2394:    NODE(node1);
 2395: 
 2396: 
 2397:    node1->clearMatrixRow();
 2398:    node1->qel = 0.0;
 2399: 
 2400:    // THIS IS FOR STRUCTURES XXX
 2401:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 2402: 
 2403:    
 2404:    for (int j=0; j<node1->numElements; j++) {
 2405:       // For each element connected to the node...
 2406: 
 2407:       Element *elem = node1->elements[j];
 2408: 
 2409:       // Compute the average gravity
 2410:       const double grav3 = elem->mean(&Node::grav2);
 2411: 
 2412:       // Look at the documentation for the description of the terms in the following integrals
 2413: 
 2414:       // Integral I_1 
 2415:       // \bar{\breve{H}} 
 2416:       const double hhatb = elem->mean(&Side::hhat);        
 2417: 
 2418:       assert((hhatb >= 0.0 || ihh != 1) && "Invalid hhat");
 2419: 
 2420:       const int id1 = elem->nodeLocalIdx(node1); 
 2421:       const double area = elem->area;
 2422: 
 2423:       if (elem->isTri()) {
 2424: 
 2425:          // To clarify the notation in this section: 
 2426:          //   i standtimes for the node under consideration (node1)
 2427:          //   j (node2) and k (node3) are the other nodes of the triangle.
 2428:          const int id2 = elem->nxq(1 + id1);
 2429:          const int id3 = elem->nxq(2 + id1);
 2430:          Node *node2 = elem->nodes[id2];
 2431:          Node *node3 = elem->nodes[id3];
 2432: 
 2433:          const Point2 x1 = node1->p2();
 2434:          const Point2 x2 = node2->p2();
 2435:          const Point2 x3 = node3->p2();
 2436: 
 2437:          // integral of phi_i*phi_j
 2438:          const double ipp_ii = (1.0/6.0 )*area;
 2439:          const double ipp_ij = (1.0/12.0)*area;
 2440:          const double ipp_ik = (1.0/12.0)*area;
 2441: 
 2442:          // integral of [(grad phi_i) * (grad phi_j)]
 2443:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 2444:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 2445:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 2446: 
 2447:          // Computes the different components of integral I_1 of each node with respect to node i.
 2448:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 2449:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 2450:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 2451: 
 2452:          node1->addToSparseMatrix(node1, I1_ii);
 2453:          node1->addToSparseMatrix(node2, I1_ij); 
 2454:          node1->addToSparseMatrix(node3, I1_ik);
 2455: 
 2456:          printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 2457:      
 2458:       }
 2459:       else { // Quad
 2460:          // XXX IMPLEMENT THIS
 2461:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2462:       } 
 2463: 
 2464:  
 2465:       // Integral I_4
 2466:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 2467:       // Where
 2468:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 2469: 
 2470:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 2471:       // of U over the element.
 2472:       Vector2 Umean = {0.0, 0.0};
 2473:       for (int m=0; m<elem->i34; m++) {      
 2474:          const Side *side = elem->sides[m];
 2475: 
 2476:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 2477:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 2478:       }
 2479:       Umean = Umean/elem->i34;
 2480: 
 2481:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 2482: 
 2483:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 2484:       const double I_4_1 = dot(gradPhi_1, Umean);
 2485: 
 2486:       // Integral of \nabla\phi_i \cdot \pmb{E}
 2487:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 2488:      
 2489:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);
 2490:       
 2491: 
 2492:       // Additional terms 
 2493:       double vnorm = 0.0;
 2494:       if (imm == 2)  { // Pre-compute vnorm on the element
 2495:          Vector3 ubed;
 2496:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 2497: 
 2498:          Vector3 gradP(0.0, 0.0, 1.0);
 2499:          for (int m=0; m < elem->i34; m++) {
 2500:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 2501:            gradP += toVector3(gradP_2D, 0.0);
 2502:          }   
 2503:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 2504:       } // imm==2
 2505: 
 2506:       if (elem->isTri()) {
 2507:          for (int l=0; l<3; l++) {
 2508:            double fac;
 2509: 
 2510:            Node *node = elem->nodes[l];
 2511: 
 2512:            (node == node1)? fac=2.0 : fac=1.0;
 2513: 
 2514:            if (imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 2515:            else        node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 2516:            
 2517:          }
 2518: 
 2519:          if (!elem->isDry) {
 2520:            const Vector2 gradEta = elem->nodes[0]->eta2*elem->gradPhi[0] +
 2521:                                    elem->nodes[1]->eta2*elem->gradPhi[1] +
 2522:                                    elem->nodes[2]->eta2*elem->gradPhi[2];
 2523: 
 2524:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 2525:          }
 2526: 
 2527:       } // isTri
 2528:       else { // isQuad
 2529:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2530:          // for (int l=0; l<4; l++) {
 2531:          //   const Node *node = elem->nodes[l];
 2532: 
 2533:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 2534:          //   else        tmp2 = node->bdef2 - node->bdef1;
 2535: 
 2536:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 2537:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 2538:          // }
 2539: 
 2540:       } // isQuad
 2541: 
 2542: 
 2543:       node1->qel += (dt/elem->i34)*elem->vsource;
 2544:       
 2545: 
 2546:    } // for all elements connected to the node
 2547:    
 2548: 
 2549: 
 2550:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 2551:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 2552:    NodeBoundary *nodeBnd = node1->nodeBnd;
 2553:    if (nodeBnd != nullptr)  { 
 2554:       // If it is an open boundary node...
 2555: 
 2556:       // At least one open bnd side, maybe two
 2557:       for (int l=0; l<2; l++) { 
 2558: 
 2559:          // Gets each of the sides sharing the node. 
 2560:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 2561: 
 2562:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 2563: 
 2564:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 2565: 
 2566: 
 2567:          if (sideBnd != nullptr) {
 2568:             // If the side is on a boundary...
 2569: 
 2570:             // Get the boundary segment
 2571:             const BoundarySegment *sideSegment = sideBnd->segment;
 2572:             const Side *side = sideBnd->side;
 2573: 
 2574:             // Integral I_3
 2575:             if (sideSegment->ifltype != 0) {
 2576:             // Natural or Flather b.c.
 2577: 
 2578:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 2579:                // especially for Flather b.c.
 2580:                double ri3 = 0.0;
 2581:                if (!side->isDry) {
 2582:                   // If the side is not dry
 2583:                   
 2584:                   // Computes the side flux of (uth, vth)
 2585:                   double Vn = 0.0;
 2586:                   for (int k = side->kb; k<nvrt-1; k++) {
 2587:                      // uth, vth in lat/lon frame if ics=2
 2588:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 2589:                      const double vn1 = dot(side->uth[k  ], side->n); // outer normal
 2590:                      const double vn2 = dot(side->uth[k+1], side->n);
 2591: 
 2592:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 2593:                   }
 2594: 
 2595:                   ri3 = 0.5*side->length*Vn;
 2596:                }
 2597: 
 2598:                if (sideSegment->ifltype == -1) { // Flather 1
 2599: 
 2600:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 2601:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 2602: 
 2603:                   const double con0 = (1.0/6.0)*side->length*sqrt(grav*side->depth()); // For coefficient matrix
 2604:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 2605:                   
 2606:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 2607:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 2608: 
 2609:                } 
 2610:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 2611:                   // Reset ri3
 2612:                   ri3 = 0.0;
 2613: 
 2614:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 2615: 
 2616:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 2617: 
 2618:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 2619:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 2620: 
 2621:                   const double con0 = (1.0/6.0)*side->length*tmp*thetai*dt;
 2622:                   node1->addToSparseMatrix(node1, con0*2.0);
 2623:                   node1->addToSparseMatrix(node2, con0);
 2624: 
 2625:                } // if Flather or Discharge
 2626: 
 2627:                node1->qel -= thetai*dt*ri3;
 2628: 
 2629:             } // I_3
 2630:           
 2631: 
 2632:             // Integral I_5
 2633:             if(!side->isDry) {
 2634: 
 2635:                const double Unbar = dot(side->U, side->n);
 2636: 
 2637:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->length*Unbar;
 2638:                
 2639:             } // I_5
 2640: 
 2641:          } // if is boundary side
 2642: 
 2643:       } // for l
 2644: 
 2645:    } // if isbnd
 2646: 
 2647: }
 2648: 
 2649: 
 2650: extern "C" {
 2651:    __global__ void backtrackAllNodes(void) {
 2652: 
 2653:       // max/min # of sub-divisions
 2654:       const int ndelt_max = max(1.0, dt/dtb_min);
 2655:       const int ndelt_min = max(1.0, dt/dtb_max); 
 2656: 
 2657:       // Removed all references to swild98 XXX
 2658:       // swild98=0.d0 !init
 2659: 
 2660:       SIDE(side);
 2661: 
 2662:       const int kb = side->kb;
 2663: 
 2664:       // Initialize btrack velocities to the actual velocities at the side 
 2665:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 2666: 
 2667:       if (side->isDry) return;
 2668: 
 2669:       // Checks that at least one element is not dry
 2670:       const Element *elem1 = side->elems[0];
 2671:       const Element *elem2 = side->elems[1];
 2672: 
 2673:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 2674: 
 2675:       // XXXXXX
 2676:       // !swild_tmp to store global coord. of the starting side
 2677:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 2678:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 2679:       // !Use sframe2 
 2680:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 2681: 
 2682: 
 2683:       for (int k = kb; k < nvrt; k++) {
 2684:       //  Initialize (xt,yt,zt), nnel and vel.
 2685:       //  For ics=2, the coordinates are in local frames
 2686:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 2687: 
 2688: 
 2689:          const int iadvf = side->iadv();  // Advection flag
 2690: 
 2691:          Point3 xt;
 2692:          if constexpr(ics==1) {
 2693:             xt = side->center3D(k); 
 2694:          }
 2695:          else // lat/lon; in side lat/lon frame
 2696:          {
 2697:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 2698:          // XXX IMPLEMENT THIS
 2699:       //          xt=0.d0
 2700:       //          yt=0.d0
 2701:       //          !centroid coord. for nudging
 2702:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 2703:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 2704:          }  // ics
 2705: 
 2706: 
 2707:          // Velocity at the side (in ll frame for ics, same vertical direction)
 2708:          // XXX IS THIS NECESSARY?
 2709:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 2710: 
 2711:          // If on land or open boundary...
 2712:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 2713:          
 2714:          const double vmag = length(toVector2(u_int));
 2715: 
 2716:          if (vmag <= velmin_btrack) {
 2717:             // No activity 
 2718: 
 2719:             side->btu[k] = side->u2[k];
 2720:             
 2721:          } else {  // do btrack
 2722: 
 2723:             
 2724:             // Compute number of sub-divisions based on local gradients 
 2725:             // XXX IS THIS NECESSARY?
 2726:             double suma = 0.0;
 2727:             int icount = 0;
 2728:             for (int ii=0; ii<2; ii++) {
 2729: 
 2730:                const Element *elem = side->elems[ii];
 2731:                  
 2732:                if (elem == nullptr) continue;
 2733: 
 2734:                icount++;
 2735: 
 2736:                // Not strictly along z; in ll frame for ics=2
 2737: 
 2738:                double utmp[4];
 2739:                double vtmp[4];
 2740:                for (int jj = 0; jj < elem->i34; jj++) {
 2741: 
 2742:                   const Node *node = elem->nodes[jj];
 2743: 
 2744:                   if constexpr(ics==1) {
 2745:                      utmp[jj] = node->u2[k].x;
 2746:                      vtmp[jj] = node->u2[k].y;  
 2747:                   } else {
 2748:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 2749:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 2750:                   }
 2751:                } // for jj
 2752: 
 2753:                const Vector2 grad_u = elem->grad(utmp); 
 2754:                const Vector2 grad_v = elem->grad(vtmp);
 2755: 
 2756:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 2757:             } // for ii
 2758: 
 2759:             assert(icount > 0 && "Impossible 77");
 2760: 
 2761:             // '4' is somewhat arbitrary
 2762:             const int ndelt = max(ndelt_min, min(ndelt_max, int(suma/icount)*4)); // >=1
 2763:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 2764:          
 2765:             // call btrack(l,ipsgb,ifl_bnd,j,iadvf,swild_tmp,swild10_tmp, dtbk,time_rm,time_rm2,uuint,vvint,wwint,nnel,jlev,xt,yt,zt,swild3,ltmp)
 2766:             Vector3 u_int = {0.0, 0.0, 0.0};
 2767:             side->btrack(k, dt, dtbk, u_int);
 2768: 
 2769:             printf("backtrackAllNodes: side->idx = %d, u_int = %f,%f\n", side->idx, u_int.x, u_int.y);
 2770: 
 2771:                
 2772:          } // if vmag (do backtrack)
 2773: 
 2774:       } // for j=jmin,nvrt-1
 2775: 
 2776:    }
 2777: } // extern "C"
 2778: 
 2779: template<int nc>
 2780: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 2781: 
 2782: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 2783: //
 2784: // a,b,c,r: input vectors and are not modified by this program.
 2785: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 2786: // r is the r.h.s.
 2787: // n: actual rank of the system.
 2788: // rows in u() and r();
 2789: // u: output with nc columns (transposed to rows)
 2790: // gam: a working array.
 2791: //
 2792: // NOTES:
 2793: // This is a template function that allows for different numbers of columns in the rhs vector.
 2794: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 2795: 
 2796:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 2797:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 2798: 
 2799:    double bet = b[0];
 2800:    if constexpr (nc == 1) {
 2801:       u[0] = rhs[0]/bet;
 2802:    } else {
 2803:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 2804:    }
 2805: 
 2806:    for (int j = 1; j < n; j++) {
 2807:       gam[j] = c[j-1]/bet;
 2808:       bet = b[j] - a[j]*gam[j];
 2809: 
 2810:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 2811: 
 2812:       if constexpr (nc == 1) {
 2813:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 2814:       } else {
 2815:          for (int k = 0; k < nc; k++) {
 2816:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 2817:          }
 2818:       }
 2819:    }
 2820: 
 2821:    // Back-substitution
 2822:    for (int j=n-1; j>=1; j--) {
 2823:       if constexpr (nc == 1) {
 2824:          u[j] = u[j] - gam[j+1]*u[j-1];
 2825:       } else {
 2826:          for (int k = 0; k < nc; k++) {
 2827:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 2828:          }
 2829:       }
 2830:    }
 2831: }
 2832: 
 2833: 
 2834: 
 2835: 
 2836: // Helper function that contains the core algorithm
 2837: template<typename XAccessor, typename YAccessor>
 2838: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 2839:                                     double  yp_top, double  yp_bot, 
 2840:                                     CubicSpline &spline) {
 2841:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 2842:    // 
 2843:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 2844:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 2845:    //
 2846:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 2847:    // 
 2848:    // Inputs: 
 2849:    //            n: dimension for x etc; # of data pts (>=2);
 2850:    //            getX, getY: functions to access x,y coordinates
 2851:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 2852:    //     Output: 
 2853:    //            spline (CubicSpline): spline structure with x,y,y',y''
 2854: 
 2855:    const int n = k2 - k1 + 1;
 2856:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 2857: 
 2858:    // Allocate memory for the splines
 2859:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 2860:    spline.x   = new double[n];
 2861:    spline.y   = new double[n];
 2862:    spline.yp  = new double[n];
 2863:    spline.ypp = new double[n];
 2864: 
 2865:    for (int k=k1; k<=k2; k++) {
 2866:       spline.x[k] = getX(k);
 2867:       spline.y[k] = getY(k);
 2868:    }
 2869: 
 2870:    // This is to simplify expressions later
 2871:    double *x = spline.x;
 2872:    double *y = spline.y;
 2873: 
 2874:    double *a = nullptr;
 2875:    double *b = nullptr;
 2876:    double *c = nullptr;
 2877:    double *gam = nullptr;
 2878:    double *rhs = nullptr;
 2879:    
 2880: 
 2881:       a = new double[n];   // Lower diagonal
 2882:       b = new double[n];   // Diagonal
 2883:       c = new double[n];   // Upper diagonal
 2884:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 2885:       rhs = new double[n]; // Right-hand side
 2886: 
 2887:    for (int k=k1; k<=k2; k++) {
 2888:       if (k == k1) {
 2889:          // Bottom level
 2890:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 2891:          b[k] = (x[k+1] - x[k])/3.0;
 2892:          c[k] = b[k]/2.0;
 2893:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 2894:       } else if (k == n - 1) {
 2895:          // Top level (surface)
 2896:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 2897:          b[k] = (x[k] - x[k-1])/3.0;
 2898:          a[k] = b[k]/2.0;
 2899:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 2900:       } else {
 2901:          // Intermediate levels
 2902:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 2903:          b[k] = (x[k+1] - x[k-1])/3.0;
 2904:          a[k] = (x[k  ] - x[k-1])/6.0;
 2905:          c[k] = (x[k+1] - x[k  ])/6.0;
 2906:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 2907:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 2908:       }
 2909:    }
 2910: 
 2911:    // Solve the tridiagonal system
 2912:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 2913:    
 2914:    spline.yp[k1] = yp_bot;
 2915:    spline.yp[k2] = yp_top;
 2916: 
 2917:    // Compute rest of 1st derivatives using the splines
 2918:    for (int k=k1+1; k<k2; k++) {
 2919:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 2920:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 2921:    }
 2922:    
 2923:    delete[] a;
 2924:    delete[] b;
 2925:    delete[] c;
 2926:    delete[] gam;
 2927:    delete[] rhs;
 2928: 
 2929: }
 2930: 
 2931: // Array version
 2932: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 2933:                                 double y_top, double y_bot, 
 2934:                                 CubicSpline &spline) {
 2935:    auto getX = [x] (int k) { return x[k]; };
 2936:    auto getY = [y] (int k) { return y[k]; };
 2937:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 2938: }
 2939: 
 2940: // Lambda version - allows custom access patterns
 2941: template<typename XFunc, typename YFunc>
 2942: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 2943:                                 double y_top, double y_bot,
 2944:                                 CubicSpline &spline) {
 2945:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 2946: }
 2947: 
 2948: 
 2949: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 2950: {
 2951:    assert("Not implemented");
 2952: 
 2953:    return 0.0;
 2954: }
 2955: 
 2956: // __device__ void vertLinearInterp(int nc, double zt, int k1, int k2, double *za, double *s_in, double *s_out, int *ibelow) {
 2957: // //     Routine to do vertical linear interpolation in z
 2958: // //     Inputs:
