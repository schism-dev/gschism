 2959: extern "C" {
 2960: 
 2961:    __global__ void scaleGravity(double loadtide_coef) {
 2962: 
 2963:       NODE(node);
 2964: 
 2965:       // SAL option: scale gravity
 2966:       if constexpr(iloadtide==2) {  // simple const
 2967:          node->grav2 = grav*(1.0 - loadtide_coef);
 2968: 
 2969:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 2970:         
 2971:           const double depth = max(node->depth, 0.0);
 2972:           const double tmp1 = sqrt(depth);
 2973:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 2974:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 2975:                              2.6969e-13*depth*depth*depth*tmp1;
 2976:           
 2977:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 2978:           
 2979: 
 2980: 
 2981:           node->grav2 = grav*(1.0 - beta_bar);
 2982: 
 2983:       } else {  // iloadtide=0,1
 2984:         node->grav2=grav;
 2985: 
 2986:       }
 2987: 
 2988:       printf("scaleGravity: node(%d)->grav2 = %f\n", node->idx, node->grav2);
 2989:    }
