 1034:                    SideBoundary *localSideBoundaryMem,
 1035:                    BoundarySegment *localSegmentMem,
 1036:                    double h_s, double theta_b, double theta_f, double *sigma_lcl, double *sigma, double *ztot,
 1037:                    double *cs, double *dcs
 1038:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 1039:                        np(np), ne(ne), ns(ns),
 1040:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
 1041:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
 1042:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
 1043:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
 1044:                        localNodeBoundaryMem(localNodeBoundaryMem), localSideBoundaryMem(localSideBoundaryMem),
 1045:                        localSegmentMem(localSegmentMem),
 1046:                        h_s(h_s), theta_b(theta_b), theta_f(theta_f), sigma_lcl(sigma_lcl), sigma(sigma), ztot(ztot),
 1047:                        cs(cs), dcs(dcs)
 1048:    {
