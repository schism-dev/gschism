  178: // Polynomial class
  179: template<int grade>
  180: struct Polynomial {
  181:     // Static assertion to give a clear error message at compile time
  182:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  183: };
  184: 
  185: 
  186: // Explicit specialization for grade 4
  187: template<>
  188: struct Polynomial<4> {
  189:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  190: 
  191:    // Constructor from coefficients
  192:    __device__ __host__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  193: 
  194:    __device__ __host__ __forceinline__ double eval(double x) const {
  195:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  196:    }
  197: };
