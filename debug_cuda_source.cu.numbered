  980:    {
  981:       printf("Testing mesh for partition %d, x=%f, y=%f\n", partNum, x, y);
  982:       for (int i = 0; i < ne; i++) {
  983:          auto isInside = localElemData[i].containsPoint({x, y});
  984: 
  985:          if (isInside) {
  986:             printf("Point %f %f %f is inside element %d\n", x, y, z, i);
  987:             Element *elem = &localElemData[i];
  988:             
  989:             Vector3 u_int;
  990:             // auto res = elem->trackThroughElementsAndLevels(x,y,z, 
  991:             //                                                x+0.01,y+0.01,z,
  992:             //                                                uuint, vvint, wwint, elem);
  993:             // Choose the first side
  994:             Side *side = elem->sides[0];
  995:             int jlev = 5;  
  996:             // RECORDAR:
  997:             // - con y=0 no encuentra el triangulo
  998:             // - jlev = 5, z = 0.1...
  999:             side->btrack(5, 3000.0, 3.1, nullptr, u_int);
 1000: 
 1001:          }
 1002:       }
 1003:    } 
 1004: 
 1005: }; // End of Mesh class
