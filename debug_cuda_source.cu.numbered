  726: struct Side {
  727: 
  728:    // Geometry information
  729:    int idx;               // Index of the side
  730:    Node *n1, *n2;
  731:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  732: 
  733:    double length;         // Length of the side. Used to be called distj; but I think this name is less clear now.
  734:    Vector2 center;        // Location of side center. 
  735:    double zc[nvrt];       // Side center z-coord at each vertical level
  736: 
  737:    Frame frame;
  738: 
  739:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  740:                           // this is nullptr
  741:    
  742:    int kb;                // Bottom index of the side
  743:    bool isDry;             // True if the side is dry
  744:  
  745:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  746: 
  747:    // Physical information
  748:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  749:    double  w2[nvrt];            // Vertical velocity at each vertical level
  750:    Vector2 btu[nvrt];           // Back-tracked velocity
  751:    Vector2 uth[nvrt];           // "Time history" velocity
  752:    Vector2 U;                   // Vertically averaged velocity vector  
  753: 
  754:    Vector2 d2uv[nvrt];          // divergence of (nu*grad u) XXX COMPUTE!!
  755: 
  756:    Vector2 bcc[nvrt];           // Baroclinic term
  757: 
  758:    double hhat;                 // \breve{H} in notes
  759: 
  760:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
  761: 
  762:    double coriolis;             // Coriolis parameter
  763: 
  764:    // Vegetation parameters
  765:    double veg_c2;
  766:    double veg_beta;
  767: 
  768:    // Bottom drag parameters.
  769:    double chi;
  770:    double chi2;
  771: 
  772:    __inline__ __device__ double x(double t) const;
  773:    __inline__ __device__ double y(double t) const;
  774:    __inline__ __device__ Point2 p_t(double t) const;
  775: 
  776:    __inline__ __device__ Point3 center3D(int k) const { return {center.x, center.y, zc[k]}; }
  777:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
  778:    __inline__ __device__ double Dz(int k)       const { return zc[k] - zc[k-1]; }
  779: 
  780:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
  781: 
  782:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
  783: 
  784:    __inline__ __device__ int iadv(void) const;
  785: 
  786:    __inline__ __device__ double eta2(void) const;
  787:    __inline__ __device__ double depth(void) const;
  788:    __inline__ __device__ double htot(void) const { return eta2() + depth(); }
  789: 
  790:    __inline__ __device__ double veg_h(void)  const;
  791:    __inline__ __device__ double veg_nv(void) const;
  792:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
  793:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
  794: 
  795:    __inline__ __device__ double Cd(void) const;
  796: 
  797:    __inline__ __device__ Vector2 tau(void) const;
  798: 
  799:    __inline__ __device__ double zb(void) const { return zc[kb]; }
  800:    
  801: 
  802:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
  803:    __inline__ __device__ double zLevelVegRatio(int k) const { 
  804:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
  805:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
  806:    } 
  807:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
  808:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot(); }
  809:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 1; }
  810:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 1; }
  811: 
  812:    // Get valid starting element (for backtracking)
  813:    __inline__ __device__ Element* getStartElement() {
  814:       return elems[0] ? elems[0] : elems[1];
  815:    }
  816: 
  817:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
  818:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
  819: 
  820:       // If one of the elements is null, return the other one
  821:       if      (elems[0] == nullptr) return elems[1];
  822:       else if (elems[1] == nullptr) return elems[0];
  823: 
  824: 
  825:       // Dot product of the negative velocity vector with the side normal vector
  826:       const double dot_prod1 = -dot(u, n);
  827:       
  828:       // Vector from side center to element 0 centroid
  829:       const Vector2 v2 = toVector2(elems[0]->center) - center;
  830: 
  831:       // Dot product of the vector with the side normal vector
  832:       const double dot_prod2 = dot(v2, n);
  833: 
  834:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
  835:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
  836: 
  837:       if (dot_prod1*dot_prod2 > 0.0) return elems[0];
  838:       else                           return elems[1];
  839: 
  840:  
  841:    }
  842: 
  843:    __forceinline__ __device__ Element* otherElem(const Element* elem) {
  844:       // Given an element, returns the other element that shares this side
  845:       return (elems[0] == elem) ? elems[1] : elems[0];
  846:    }
  847: 
  848:    __forceinline__ __device__ Node* otherNode(Node* node) {
  849:       // Given a node, returns the other node that shares this side
  850:       return (n1 == node) ? n2 : n1;
  851:    }
  852:  
  853:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
  854: 
  855: 
  856: 
  857: 
  858: };
  859: 
