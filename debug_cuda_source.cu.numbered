 1528: 
 1529: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1530:                                               double &t, double& tIntersect) {
 1531: 
 1532:    double closest_intersect_t = 1e10;
 1533:    bool found_intersection = false;
 1534: 
 1535: double minDelta = 1e10; 
 1536: double btt1, btt2;
 1537:    for (int i = 0; i < i34; i++) {
 1538: 
 1539:       Side *side2 = sides[i];
 1540: 
 1541:       // (x3,y3)-(x4,y4) is the element side line
 1542:       const Point2 x3 = side2->n1->p2();
 1543:       const Point2 x4 = side2->n2->p2();
 1544: 
 1545:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1546:       const double delta = cross(x2 - x1, x3 - x4);
 1547: 
 1548:       if (abs(delta) > 0) {
 1549: 
 1550:          const double delta1 = cross(x3 - x1, x3 - x4);
 1551:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1552: 
 1553:          // Solves the two linear equations for tt1 and tt2
 1554:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1555:          const double tt2 = delta2/delta;
 1556: 
 1557: if (abs(delta) < minDelta) {
 1558:    minDelta = abs(delta);
 1559:    btt1 = tt1;
 1560:    btt2 = tt2;
 1561: }
 1562: double small = 1e-7;
 1563:          printf("RRRRRR tt1 = %e, tt2 = %e\n", tt1, tt2);
 1564:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1565:             closest_intersect_t = min(closest_intersect_t, tt1);
 1566:             side = side2;
 1567:             nextElement = side->otherElem(this);
 1568:             t = tt2;
 1569:             tIntersect = max(small, min(tt1, 1.0-small));
 1570:             found_intersection = true;
 1571:          }
 1572:       
 1573:       }
 1574:       else {  // parallel segments
 1575:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1576:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1577: 
 1578:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1579: 
 1580:          // const double dist = dot(x1 - x3, side2->n);
 1581:          // if (abs(dist) < small*length(x3 - x4)) {
 1582:          //    const double2 unitarySide = normalize(x4 - x3);
 1583:          //    const double len = dot(x2 - x1, unitarySide);
 1584:          //    t = t + len;
 1585:          //    t = max(0.0, min(t, 1.0));
 1586:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1587: 
 1588: 
 1589:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1590:          //    // t = tt2;
 1591:          //    found_intersection = true;
 1592:          // }
 1593:       }
 1594: 
 1595: 
 1596:    }
 1597: 
 1598:    if (!found_intersection) {
 1599:       
 1600:       printf("ZZ No intersection found:\n"
 1601:            "Element %d\n"
 1602:            "in = %d\n"
 1603:            "minDelta = %e\n"
 1604:            "tt1 = %e, tt2 = %e\n"
 1605:            "segment: (%f, %f)-(%f, %f)\n"
 1606:            "Vertices:\n"
 1607:          //   "  Nodes nextElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n"
 1608:            "  Nodes curElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n",
 1609:            IDX(nextElement),
 1610:            (btt1 >= -small && btt2 >= -small && btt2 <= 1.0 + small && btt1 <= 1.0 + small),
 1611:            minDelta,
 1612:            btt1, btt2,
 1613:            x1.x, x1.y,
 1614:            x2.x, x2.y,
 1615:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1616:          //   nextElement->nodes[1]->p.x, nextElement->nodes[1]->p.y,
 1617:          //   nextElement->nodes[2]->p.x, nextElement->nodes[2]->p.y,
 1618:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1619:            nodes[0]->p.x, nodes[0]->p.y,
 1620:            nodes[1]->p.x, nodes[1]->p.y,
 1621:            nodes[2]->p.x, nodes[2]->p.y,
 1622:            nodes[0]->p.x, nodes[0]->p.y);
 1623: 
 1624:    }
 1625: 
 1626:    // assert(found_intersection && "No intersection found");
 1627: 
 1628:    // found_intersection should always be true, since we checked all the sides.  
 1629:    return found_intersection;
 1630: }
 1631: 
 1632: 
 1633: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1634:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1635: 
 1636:    printf("Tracking segment goes out of water at element %d\n", curElem->idx);
 1637: 
 1638:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1639:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1640:    // curElement.
 1641: 
 1642:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1643:    // And uses this velocity instead to continue the tracking.
 1644: 
 1645:    // computes the intersection point in cartesian coordinates
 1646:    Point2 intersection = nextSide->p_t(tt);
 1647: 
 1648:    // Nudges the point to the barycenter of the element. 
 1649:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1650:    // next segment intersects the element sides.  
 1651:    curElem->nudgeToBarycenter(intersection);
 1652: 
 1653:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1654:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1655:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1656:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1657: 
 1658:    // If the side is an open boundary, the tangential velocity is zero.
 1659:    if (nextSide->isBnd()) vtan = 0.0;
 1660: 
 1661:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1662:    const double us = vtan*nextSide->t().x;
 1663:    const double vs = vtan*nextSide->t().y;
 1664:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1665: 
 1666:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1667:    const double len2 = length(intersection - toPoint2(xt));
 1668:    const double vel2 = u_int.x*u_int.x + u_int.y*u_int.y;        
 1669:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 1670:    else            dt = 0.0;
 1671: 
 1672:    // The end of this tracking segment is now the intersection point.
 1673:    xt = {intersection.x, intersection.y, zint};
 1674: printf("BBB u_int = %f,%f,%f\n", us, vs, ws);   
 1675:    u_int = {us, vs, ws};
 1676:    
 1677: }
 1678: 
 1679: /**
 1680:  * Tracks a particle through elements and vertical levels in the mesh.
 1681:  * 
 1682:  * @param x0,y0,z0     Starting position coordinates
 1683:  * @param xt,yt,zt     Target position coordinates
 1684:  * @param dtb          Time step for tracking
 1685:  * @param uuint,vvint,wwint Initial velocity components
 1686:  * @param nextElem     Starting/resulting element index
 1687:  * 
 1688:  * @return Status code of type trackExitCodes
 1689:  * 
 1690:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1691:  * of the details are different. The idea is that the code requires less branches and is better fit
 1692:  * for GPU execution.
 1693:  * 
 1694:  * The main ideas here are:
 1695:  * - The starting point is expected to be in the starting element.
 1696:  * - The end point is guaranteed to be inside an element.
 1697:  * - since the starting point is inside the element, there are only two cases: 
 1698:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1699:  *     (b) it does not and (xt,yt) is already in the starting element.
 1700:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1701:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1702:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1703:  * - tt1 can be positive or negative. We only consider the positive values.
 1704:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1705:  * - The next intersection will occur at the smallest positive tt1.
 1706:  * - This intersection will be the next (x0,y0) position.
 1707:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1708:  *   of getting stuck in a loop.
 1709:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1710:  *   was found.
 1711:  */
 1712: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1713:                                                        Element *&nextElem, int &jlev, double &dt) {
 1714: 
 1715:    // First thing is to check if the target point is inside the element. If it is there is nothing
 1716:    // else to do.
 1717: 
 1718:    const Element *curElem = nextElem;
 1719:    if (containsPoint(toPoint2(xt))) {
 1720:       curElem->interpolateVelocities(xt, u_int);
 1721:       return true;
 1722:    }
 1723: 
 1724:    Side *side = nullptr;
 1725: 
 1726:    // 1. Initial checks
 1727:    // Verify starting element is valid (wet)
 1728:    assert(!curElem->isDry && "Starting element is dry");
 1729: 
 1730:    // Checks if track has a zero length.
 1731:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1732:    // assert(len2 > 0.0 && "Zero length track"); 
 1733:    
 1734:    const int MAX_ITERATIONS = 1000;
 1735:    
 1736:    double t;
 1737:    Side *nextSide = nullptr;
 1738:    double tIntersect = 1e10;
 1739:    double zint = x0.z;
 1740: 
 1741:    // Horizontal tracking loop
 1742:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1743:    // (x0,y0) is inside the element but the target point is not.
 1744: 
 1745:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1746: 
 1747:    if (!found_intersection) {
 1748: double shpCoords_0[4];
 1749: double shpCoords_t[4];
 1750: computeShapeCoords(toPoint2(x0), shpCoords_0, false);
 1751: computeShapeCoords(toPoint2(xt), shpCoords_t, false);
 1752:       printf("No intersection found (containsPoint = %d, %d [%.17g, %.17g, %.17g] [%.17g, %.17g, %.17g]):\n"
 1753:            "Elements %d, %d\n"
 1754:            "Side %d\n"
 1755:            "segment: (%f, %f),(%f, %f)\n"
 1756:            "triangle node indices: %d, %d, %d\n"
 1757:            "triangle: (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n",
 1758:            containsPoint(toPoint2(x0)), containsPoint(toPoint2(xt)),
 1759:            shpCoords_0[0], shpCoords_0[1], shpCoords_0[2],
 1760:            shpCoords_t[0], shpCoords_t[1], shpCoords_t[2],
 1761:            IDX(curElem), IDX(nextElem),
 1762:            IDX(nextSide),
 1763:            x0.x, x0.y,
 1764:            xt.x, xt.y,
 1765:            curElem->nodes[0]->idx, curElem->nodes[1]->idx, curElem->nodes[2]->idx,
 1766:            curElem->nodes[0]->p.x, curElem->nodes[0]->p.y,
 1767:            curElem->nodes[1]->p.x, curElem->nodes[1]->p.y,
 1768:            curElem->nodes[2]->p.x, curElem->nodes[2]->p.y,
 1769:            curElem->nodes[0]->p.x, curElem->nodes[0]->p.y);
 1770:    }
 1771:    assert(found_intersection && "No intersection found at %d");
 1772: 
 1773:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1774: 
 1775:    // if the tracking segment goes out of water (either dry or edge boundary)
 1776:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1777: 
 1778: 
 1779:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1780:       nextElem = this;
 1781:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1782:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1783:       return true;    
 1784:    }
 1785: 
 1786: 
 1787:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1788:    int iterations = 0;
 1789:    while (iterations < MAX_ITERATIONS) {
 1790:       iterations++;
 1791:       
 1792:       Element *curElem = nextElem;
 1793: 
 1794:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1795: 
 1796:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1797: 
 1798:       // If we are already in the target element, we are done.
 1799:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1800:       if (!found_intersection) break;
 1801: 
 1802: 
 1803: 
 1804:       // if the tracking segment goes out of water (either dry or edge boundary).
 1805:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1806: 
 1807:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1808: 
 1809:          nextElem = curElem;
 1810: 
 1811: 
 1812:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1813:          // In this case, the caller (btrack) needs to take into account the remaining time.
 1814:          return true;
 1815:       }
 1816:       
 1817:       // Update position and element for next iteration
 1818:       side = nextSide;
 1819: 
 1820:    }
 1821: 
 1822:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 1823: 
 1824:  
 1825:    // Interpolate velocities at the final position. This is a conceptually simple step,
 1826:    // but the function is not simple, because it has to search for the vertical level containing zt.
 1827:    nextElem->interpolateVelocities(xt, u_int);
 1828: 
 1829: 
 1830:    return true;
 1831: }
 1832: 
 1833: 
 1834: 
 1835: 
 1836: __inline__ __device__ double Element::computeSignedArea(void) const {
 1837:    // Compute the area of the element
 1838: 
 1839:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 1840: 
 1841:    // In the quad case we need to add the area of the other triangle.
 1842:    if (isQuad()) {
 1843:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1844:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 1845:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1846:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 1847:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 1848:          Error("Negative area found in quad element");
 1849:       }
 1850:       res += ar1;
 1851:    }
 1852: 
 1853:    return res;
 1854: }
 1855: 
 1856: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 1857:    // In boundary sides, the element 1 is nullptr
 1858:    return side->elems[1] == nullptr; 
 1859: }
 1860: 
 1861: 
 1862: 
 1863: /**
 1864:    Compute the shape coordinates of the point (xt,yt) in the element.
 1865:    @param xt (input): x-coordinate of the point
 1866:    @param shpCoords (output): shape coordinates of the point
 1867:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 1868:    @return true if the point is inside the element, false otherwise
 1869: **/
 1870: __device__ bool Element::computeShapeCoords(Point2 xt, double shpCoords[4],
 1871:                                             bool fixNegshpCoord) const {
 1872: 
 1873:    // Compute the shape coordinates of the point xt in the element.
 1874:    if (i34==3) {
 1875:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 1876:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 1877:       // and in this case, the pt will be nudged into the element
 1878:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 1879:       // from the local frame, so use additional check.
 1880: 
 1881:       Point2 x0, x1, x2;
 1882: 
 1883:       if constexpr(ics==1) {
 1884:          x0 = nodes[0]->p2();
 1885:          x1 = nodes[1]->p2();
 1886:          x2 = nodes[2]->p2();
 1887:       }
 1888:       else // lat/lon
 1889:       {
 1890:          Error("Not implemented yet");
 1891: #ifdef ICS2
 1892:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 1893:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 1894:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 1895: #endif
 1896:       }
 1897: 
 1898:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 1899:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 1900:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 1901:       shpCoords[3] = 0.0;
 1902:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 1903: 
 1904:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 1905:       // then we fix the negative shape coordinates.
 1906:       if (fixNegshpCoord && tmpmin<=0.0) {
 1907: 
 1908:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 1909:          // keeping the sum of the shape coordinates equal to 1.
 1910:          // I have tested and compared the new algorithm with the old one, and they give
 1911:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 1912:          // The new algorithm should be faster since it is branchless.
 1913:          const double a = - tmpmin + 1.0e-2;  // XXX it used to be 1.0e-4 in the comments of the original code
 1914:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 1915:          
 1916:          shpCoords[0] = (shpCoords[0] + a)*b;
 1917:          shpCoords[1] = (shpCoords[1] + a)*b;
 1918:          shpCoords[2] = (shpCoords[2] + a)*b;          
 1919: 
 1920:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 1921:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 1922:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 1923:          }
 1924: 
 1925:          // Update the point coordinates for the new shape coordinates
 1926:          double xcoords[3] = {x0.x, x1.x, x2.x};
 1927:          double ycoords[3] = {x0.y, x1.y, x2.y};
 1928:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 1929: 
 1930:       }
 1931: 
 1932:       // Check if the point is inside the element
 1933:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 1934:    }
 1935:    else {
 1936:       Error("Not implemented yet");
 1937: #ifdef QUADS
 1938:       // Reproject pt in eframe of nel for ics=2
 1939:       if constexpr(ics==1) {
 1940:          xn2 = xt; 
 1941:          yn2 = yt;
 1942:       }
 1943:       else {
 1944:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 1945:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 1946:       }
 1947: 
 1948:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 1949: #endif
 1950:    }
 1951: 
 1952:    return false;  // Never reached
 1953: 
 1954: }
 1955: 
 1956: 
 1957: /**  Interpolate velocities at a given point (xt,yt,zt)
 1958: 
 1959:    @param xt, yt, zt: coordinates of the point to interpolate
 1960:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 1961: 
 1962:    This is done in four steps:
 1963: 
 1964:    1. Find the shape coordinates for the final position in the element.
 1965:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 1966:    3. Perform a *binary search* to find the vertical level containing zt. It will have to interpolate the 
 1967:       z levels at xt, yt at each step.   
 1968:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 1969:       horizontally and vertically.
 1970: **/
 1971: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 1972:    // Interpolate the velocities at the point xt. 
 1973:    // This function works the same for triangular and quadrilateral elements.
 1974:    double shpCoord[4];
 1975: 
 1976: 
 1977:    // First step is to compute the shape coordinates of (xt,yt)
 1978:    computeShapeCoords(toVector2(xt), shpCoord, false);
 1979:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 1980: 
 1981:    // Second step is to find the level that contains zt
 1982:    // Uses a binary search to find the level
 1983:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 1984:    int L = kbe;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 1985:    int R = nvrt - 1;
 1986: 
 1987:    // Get the z coordinates at the nodes of the element at the levels L and R
 1988:    double zLAtNodes[4], zRAtNodes[4];
 1989:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 1990:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 1991: 
 1992:    double zL = interpolate(shpCoord, zLAtNodes);
 1993:    double zR = interpolate(shpCoord, zRAtNodes);
 1994:    
 1995:    // Interpolates vertically the velocities
 1996:    double wght1, wght2;
 1997:    if (xt.z<=zL) {
 1998:       wght1 = 1.0;
 1999:       wght2 = 0.0;
 2000:    }
 2001:    else if (xt.z>=zR) {
 2002:       wght1 = 0.0;
 2003:       wght2 = 1.0;
 2004:    }
 2005:    else {
 2006:       // Perform a binary search to find the levels between L and R that contain xt.z
 2007:       while (R - L > 1) {
 2008:          int M = (L + R) / 2;
 2009: 
 2010:          double zMAtNodes[4];
 2011:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2012:          double zM = interpolate(shpCoord, zMAtNodes);
 2013:          if (zM < xt.z) 
 2014:          {
 2015:             L = M;
 2016:             zL = zM;
 2017:          }
 2018:          else 
 2019:          {
 2020:             R = M;
 2021:             zR = zM;
 2022:          }
 2023:       }
 2024:       assert(L == R-1);
 2025:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2026: 
 2027:       wght2 = (xt.z - zL)/(zR - zL);
 2028:       wght1 = 1.0 - wght2;
 2029:    }
 2030: // printf("$$$ wght1 = %f, wght2 = %f, zt = %f, zL = %f, zR = %f\n", wght1, wght2, zt, zL, zR);
 2031: // printf("$$$ shpCoord = %f, %f, %f, %f\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 2032:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2033:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 2034: 
 2035:    // Neither of the interpolated velocities should be NaN
 2036:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2037: 
 2038: }
 2039: 
 2040: 
 2041: 
 2042: __inline__ __device__ double Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2043: __inline__ __device__ double Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2044: __inline__ __device__ Point2 Side::p_t(double t) const { return {x(t), y(t)}; }
 2045: __inline__ __device__ int    Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 2046: __inline__ __device__ double Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 2047: __inline__ __device__ double Side::depth(void)   const { return 0.5*(n1->depth + n2->depth); }
 2048: 
 2049: __inline__ __device__ double Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 2050: __inline__ __device__ double Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 2051: __inline__ __device__ double Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 2052: 
 2053: 
 2054: __inline__ __device__ double Side::Cd(void)      const { if constexpr(nchi != 0) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 2055: 
 2056: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 2057: 
 2058: /**
 2059:  * This method performs backtracking from the side center until a time -dt back in time 
 2060:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2061:  * intermediate point.
 2062:  *
 2063:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2064:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2065:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2066:  * remaining time.
 2067:  * 
 2068:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2069:  * 
 2070:  * @param uuint, vvint, wwint: Velocities at the final point
 2071:  * @param jlev: Level at which the backtracking is performed
 2072:  * @param dt, dtbk: Tracking timesteps
 2073:  * @return: True if the backtracking was successful, false otherwise
 2074:  */
 2075: __inline__ __device__ bool Side::btrack(
 2076:       int jlev,
 2077:       double dt,            // Tracking time
 2078:       double dtbk,          // Tracking timestep
 2079:       Vector3 &u_int
 2080: ) const {
 2081: 
 2082:    // Start from side center
 2083:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2084:  
 2085: 
 2086:    double time_rm = dt; // Remaining time
 2087: 
 2088: 
 2089:    // // Initialize outputs XXX
 2090:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2091:    //    sclr[i] = 0.0;
 2092:    // }
 2093: 
 2094: 
 2095:    // Initial velocities
 2096:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 2097: 
 2098: // printf("YY 1, u_int = %f,%f\n", u_int.x, u_int.y);
 2099: 
 2100:    // Find the element that is in the direction opposite to the velocity
 2101:    Element* curElem = findElementTowards({u_int.x, u_int.y});
 2102: // printf("YY 2, curElem = %p\n", curElem);
 2103:    const int MAX_ITERATIONS = 1000; 
 2104:    Element* nextElem = curElem;
 2105:    int iter = 0;
 2106:    while(true) {
 2107:       // Calculate timestep
 2108:       double dtb = min(dtbk, time_rm);
 2109: 
 2110:       // Next point in the backtracking curve
 2111:       Point3 xt = x0 - dtb*u_int;
 2112: // printf("YY 3, dtb = %f, curElem = %p, u_int = %f,%f,%f\n", dtb, curElem, u_int.x, u_int.y, u_int.z);
 2113:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb);
 2114: // printf("YY 4, found = %d\n", found);
 2115:       assert(found && "Backtracking failed in btrack");
 2116: // printf("<>T = %f, %f %f %f\n", time_rm - dtb, xt, yt, zt);
 2117:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2118:                       // then time_rm needs to be increased by the unused time.
 2119:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2120: 
 2121:       // The current point becomes the next segment's starting point.
 2122:       x0 = xt;
 2123:  
 2124:       curElem = nextElem;
 2125: 
 2126:       iter++;
 2127:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2128:    }
 2129: 
 2130: 
 2131: }
 2132: 
 2133: 
