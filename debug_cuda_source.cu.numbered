  184: // ------------------------------------------------------------------------------------------------
  185: 
  186: 
  187: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  188:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  189:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  190: }
  191: 
  192: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  193:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  194:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  195: }
  196: 
  197: 
  198: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  199:    x3 = y1*z2 - y2*z1;
  200:    y3 = x2*z1 - x1*z2;
  201:    z3 = x1*y2 - x2*y1;
  202: }
  203: 
  204: 
  205: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  206: // Given a 3D global point (may not be on surface of earth), find its longitude and latitude in radians
  207: 
  208:    const double radius2 = dot(p, p);
  209:    assert(radius2 != 0.0     && "computeLonLat: radius = 0");
  210:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  211: 
  212:    rlon = atan2(p.y, p.x); // (-pi,pi]
  213: 
  214:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  215:       rlat = asin(p.z/sqrt(radius2));
  216:    } else {
  217:       rlat = asin(p.z/rearth_pole);
  218:    }
  219:   
  220: }
  221: 
  222: __inline__ __device__ void Error(const char* msg) {
  223:    printf("Error: %s\n", msg);
  224:    assert(false);
  225: }
  226: 
  227: struct Tracers {
  228:     double tracer[N_TRACERS];
  229: };
  230: 
  231: 
  232: 
  233: struct Frame {
  234:    double _t[9]; // t stands for tensor.
  235: 
  236:    // Access the tensor in Fortran order
  237:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  238: 
  239:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  240: 
  241:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  242: 
  243:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  244:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  245:       sincos(ar2, &sin_ar2, &cos_ar2);
  246: 
  247:       t(0,0) = -sin_ar1;
  248:       t(1,0) =  cos_ar1;
  249:       t(2,0) =  0.0;
  250:       t(0,1) = -cos_ar1*sin_ar2;
  251:       t(1,1) = -sin_ar1*sin_ar2;
  252: 
  253:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  254: 
  255:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  256:       assert (ar4!=0.0 && "GRID: ar4=0");
  257: 
  258:       const double ar4_inv = 1.0/ar4;
  259:       t(0,1) = t(0,1)*ar4_inv;
  260:       t(1,1) = t(1,1)*ar4_inv;
  261:       t(2,1) = t(2,1)*ar4_inv;
  262: 
  263:       // The third vector is the cross product of the first two
  264:       crossProduct(t(0,0), t(1,0), t(2,0), 
  265:                    t(0,1), t(1,1), t(2,1), 
  266:                    t(0,2), t(1,2), t(2,2));
  267:    }
  268: 
  269: 
  270:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  271:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  272:    // Inputs:
  273:    //        vec0: vel. in this frame;
  274:    //        frameout: Output frame;
  275:    // Output: 
  276:    //        vec1: vel. in new frame  
  277: 
  278:       auto const fo = frameout;
  279:       Vector2 vec1;
  280: 
  281:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  282:       // of t and fo.t are the same.
  283:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  284:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  285: 
  286:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  287:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  288: 
  289:       return vec1;
  290:    }
  291: 
  292:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  293:       // Transform a vector from global to local frame
  294:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  295:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  296:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  297:    }
  298: 
  299:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  300:       // Transform a vector from local to global frame
  301:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  302:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  303:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  304:    }   
  305: 
  306:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  307:    // Tranforms a point from global to local frame     
  308:       G2L(pi - origin0, po);
  309:    }
  310: 
  311:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  312:    // Transforms a point from local to global frame      
  313:       L2G(pi, po);
  314:       po = po + origin0;
  315:    }
  316: 
  317: };
