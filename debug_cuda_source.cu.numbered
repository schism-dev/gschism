 1150:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1151:       // Compute the different time ramps used in the code 
 1152:       // This function is performed by just one thread
 1153: 
 1154:       if constexpr(ibc == 0) {
 1155:          if (drampbc > 0.0) {
 1156:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1157:          } else {
 1158:             rampbc = 1.0;
 1159:          }
 1160: 
 1161:          if (nws != 0 && drampwind > 0.0) {
 1162:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1163:          } else {
 1164:             rampwind = 1.0;
 1165:          }
 1166:       }
 1167: 
 1168:       if (drampwafo > 0.0) {
 1169:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1170:       } else {
 1171:          rampwafo = 1.0;
 1172:       }
 1173: 
 1174:       // For source/sinks
 1175:       if (if_source && dramp_ss > 0.0) {
 1176:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1177:       } else {
 1178:          ramp_ss = 1.0;
 1179:       }
 1180: 
 1181:       if (dramp > 0.0) {
 1182:          ramp = tanh(2.0*time/86400.0/dramp);
 1183:       } else {
 1184:          ramp = 1.0;
 1185:       }
 1186: 
 1187:       printf("computeTimeRamps: i = %d, nws = %d, if_source = %d, drampbc = %f, drampwind = %f, drampwafo = %f, dramp_ss = %f, dramp = %f\n", 
 1188:              threadIdx.x + blockIdx.x * blockDim.x, nws, if_source, drampbc, drampwind, drampwafo, dramp_ss, dramp);
 1189:    }
