 1230: // Helper functions for computing the local node index at a given offset from another.
 1231: __device__ __inline__ int nxq(int offset, int index, int size) {
 1232:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1233:    // to the index to make it positive
 1234:    assert(index + offset + 16*size >= 0);
 1235:    return (index + offset + 16*size) % size;  
 1236: }
 1237: 
 1238: __device__ __inline__ int nxq(int index, int size) {
 1239:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1240:    // to the index to make it positive
 1241:    assert(index + 16*size >= 0);
 1242:    return (index + 16*size) % size; 
 1243: }
