 1389: 
 1390: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1391:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1392: 
 1393:    printf("Tracking segment goes out of water at element %d\n", curElem->idx);
 1394: 
 1395:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1396:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1397:    // curElement.
 1398: 
 1399:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1400:    // And uses this velocity instead to continue the tracking.
 1401: 
 1402:    // computes the intersection point in cartesian coordinates
 1403:    Point2 intersection = nextSide->p_t(tt);
 1404: 
 1405:    // Nudges the point to the barycenter of the element. 
 1406:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1407:    // next segment intersects the element sides.  
 1408:    curElem->nudgeToBarycenter(intersection);
 1409: 
 1410:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1411:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1412:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1413:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1414: 
 1415:    // If the side is an open boundary, the tangential velocity is zero.
 1416:    if (nextSide->isBnd()) vtan = 0.0;
 1417: 
 1418:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1419:    const double us = vtan*nextSide->t().x;
 1420:    const double vs = vtan*nextSide->t().y;
 1421:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1422: 
 1423:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1424:    const double len2 = length(intersection - toPoint2(xt));
 1425:    const double vel2 = u_int.x*u_int.x + u_int.y*u_int.y;        
 1426:    assert(vel2 > 0.0 && "Zero velocity found");
 1427:    dt = dt - sqrt(len2/vel2); 
 1428: 
 1429:    // The end of this tracking segment is now the intersection point.
 1430:    xt = {intersection.x, intersection.y, zint};
 1431:    
 1432:    u_int = {us, vs, ws};
 1433:    
 1434: }
 1435: 
 1436: /**
 1437:  * Tracks a particle through elements and vertical levels in the mesh.
 1438:  * 
 1439:  * @param x0,y0,z0     Starting position coordinates
 1440:  * @param xt,yt,zt     Target position coordinates
 1441:  * @param dtb          Time step for tracking
 1442:  * @param uuint,vvint,wwint Initial velocity components
 1443:  * @param nextElem     Starting/resulting element index
 1444:  * 
 1445:  * @return Status code of type trackExitCodes
 1446:  * 
 1447:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1448:  * of the details are different. The idea is that the code requires less branches and is better fit
 1449:  * for GPU execution.
 1450:  * 
 1451:  * The main ideas here are:
 1452:  * - The starting point is expected to be in the starting element.
 1453:  * - The end point is guaranteed to be inside an element.
 1454:  * - since the starting point is inside the element, there are only two cases: 
 1455:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1456:  *     (b) it does not and (xt,yt) is already in the starting element.
 1457:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1458:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1459:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1460:  * - tt1 can be positive or negative. We only consider the positive values.
 1461:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1462:  * - The next intersection will occur at the smallest positive tt1.
 1463:  * - This intersection will be the next (x0,y0) position.
 1464:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1465:  *   of getting stuck in a loop.
 1466:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1467:  *   was found.
 1468:  */
 1469: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1470:                                                        Element *&nextElem, int &jlev, double &dt) {
 1471: 
 1472:    // First thing is to check if the target point is inside the element. If it is there is nothing
 1473:    // else to do.
 1474:    if (containsPoint(toPoint2(xt))) {
 1475:       nextElem->interpolateVelocities(xt, u_int);
 1476:       return true;
 1477:    }
 1478: 
 1479:    Side *side = nullptr;
 1480: 
 1481:    // 1. Initial checks
 1482:    // Verify starting element is valid (wet)
 1483:    assert(!nextElem->idry && "Starting element is dry");
 1484: 
 1485:    // Checks if track has a zero length.
 1486:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1487:    assert(len2 > 0.0 && "Zero length track"); 
 1488:    
 1489: 
 1490:    const int MAX_ITERATIONS = 1000;
 1491:    
 1492:    double t;
 1493:    Side *nextSide = nullptr;
 1494:    double tIntersect = 1e10;
 1495:    double zint = x0.z;
 1496: 
 1497:    // Horizontal tracking loop
 1498:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1499:    // (x0,y0) is inside the element but the target point is not.
 1500:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1501:    assert(found_intersection && "No intersection found");
 1502: 
 1503:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1504: 
 1505:    // if the tracking segment goes out of water (either dry or edge boundary)
 1506:    if (isEdgeBoundary(nextSide) || (nextElem->idry)) {
 1507:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1508:       nextElem = this;
 1509:       
 1510:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1511:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1512:       return true;    
 1513:       }
 1514: 
 1515:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1516:    int iterations = 0;
 1517:    while (iterations < MAX_ITERATIONS) {
 1518:       iterations++;
 1519:       
 1520:       Element *curElem = nextElem;
 1521: 
 1522:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1523:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1524: 
 1525:       // If we are already in the target element, we are done.
 1526:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1527:       if (!found_intersection) break;
 1528: 
 1529: 
 1530:   
 1531:       // if the tracking segment goes out of water (either dry or edge boundary).
 1532:       if (curElem->isEdgeBoundary(nextSide) || (nextElem->idry)) {
 1533: 
 1534:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1535: 
 1536:          nextElem = curElem;
 1537: 
 1538:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1539:          // In this case, the caller (btrack) needs to take into account the remaining time.
 1540:          return true;
 1541:       }
 1542:       
 1543:       // Update position and element for next iteration
 1544:       side = nextSide;
 1545: 
 1546:    }
 1547: 
 1548: 
 1549:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 1550: 
 1551:  
 1552:    // Interpolate velocities at the final position. This is a conceptually simple step,
 1553:    // but the function is not simple, because it has to search for the vertical level containing zt.
 1554:    nextElem->interpolateVelocities(xt, u_int);
 1555: 
 1556: 
 1557:    return true;
 1558: }
 1559: 
 1560: 
 1561: 
 1562: 
 1563: __inline__ __device__ double Element::computeSignedArea(void) const {
 1564:    // Compute the area of the element
 1565: 
 1566:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 1567: 
 1568:    // In the quad case we need to add the area of the other triangle.
 1569:    if (isQuad()) {
 1570:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1571:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 1572:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1573:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 1574:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 1575:          Error("Negative area found in quad element");
 1576:       }
 1577:       res += ar1;
 1578:    }
 1579: 
 1580:    return res;
 1581: }
 1582: 
 1583: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 1584:    // In boundary sides, the element 1 is nullptr
 1585:    return side->elems[1] == nullptr; 
 1586: }
 1587: 
 1588: /**
 1589:    Compute the shape coordinates of the point (xt,yt) in the element.
 1590:    @param xt (input): x-coordinate of the point
 1591:    @param shpCoords (output): shape coordinates of the point
 1592:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 1593:    @return true if the point is inside the element, false otherwise
 1594: **/
 1595: __device__ bool Element::computeShapeCoords(Point2 xt, double shpCoords[4],
 1596:                                             bool fixNegshpCoord) const {
 1597: 
 1598:    // Compute the shape coordinates of the point xt in the element.
 1599:    if (i34==3) {
 1600:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 1601:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 1602:       // and in this case, the pt will be nudged into the element
 1603:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 1604:       // from the local frame, so use additional check.
 1605: 
 1606:       Point2 x0, x1, x2;
 1607: 
 1608:       if constexpr(ics==1) {
 1609:          x0 = nodes[0]->p2();
 1610:          x1 = nodes[1]->p2();
 1611:          x2 = nodes[2]->p2();
 1612:       }
 1613:       else // lat/lon
 1614:       {
 1615:          Error("Not implemented yet");
 1616: #ifdef ICS2
 1617:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 1618:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 1619:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 1620: #endif
 1621:       }
 1622: 
 1623:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 1624:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 1625:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 1626:       shpCoords[3] = 0.0;
 1627:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 1628: 
 1629:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 1630:       // then we fix the negative shape coordinates.
 1631:       if (fixNegshpCoord && tmpmin<=0.0) {
 1632: 
 1633:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 1634:          // keeping the sum of the shape coordinates equal to 1.
 1635:          // I have tested and compared the new algorithm with the old one, and they give
 1636:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 1637:          // The new algorithm should be faster since it is branchless.
 1638:          const double a = - tmpmin + 1.0e-2;  // XXX it used to be 1.0e-4 in the comments of the original code
 1639:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 1640:          
 1641:          shpCoords[0] = (shpCoords[0] + a)*b;
 1642:          shpCoords[1] = (shpCoords[1] + a)*b;
 1643:          shpCoords[2] = (shpCoords[2] + a)*b;          
 1644: 
 1645:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 1646:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 1647:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 1648:          }
 1649: 
 1650:          // Update the point coordinates for the new shape coordinates
 1651:          double xcoords[3] = {x0.x, x1.x, x2.x};
 1652:          double ycoords[3] = {x0.y, x1.y, x2.y};
 1653:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 1654: 
 1655:       }
 1656: 
 1657:       // Check if the point is inside the element
 1658:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 1659:    }
 1660:    else {
 1661:       Error("Not implemented yet");
 1662: #ifdef QUADS
 1663:       // Reproject pt in eframe of nel for ics=2
 1664:       if constexpr(ics==1) {
 1665:          xn2 = xt; 
 1666:          yn2 = yt;
 1667:       }
 1668:       else {
 1669:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 1670:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 1671:       }
 1672: 
 1673:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 1674: #endif
 1675:    }
 1676: 
 1677: }
 1678: 
 1679: 
 1680: /**  Interpolate velocities at a given point (xt,yt,zt)
 1681: 
 1682:    @param xt, yt, zt: coordinates of the point to interpolate
 1683:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 1684: 
 1685:    This is done in four steps:
 1686: 
 1687:    1. Find the shape coordinates for the final position in the element.
 1688:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 1689:    3. Perform a *binary search* to find the vertical level containing zt. It will have to interpolate the 
 1690:       z levels at xt, yt at each step.   
 1691:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 1692:       horizontally and vertically.
 1693: **/
 1694: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) {
 1695:    // Interpolate the velocities at the point xt. 
 1696:    // This function works the same for triangular and quadrilateral elements.
 1697:    double shpCoord[4];
 1698: 
 1699: 
 1700:    // First step is to compute the shape coordinates of (xt,yt)
 1701:    computeShapeCoords(toVector2(xt), shpCoord, false);
 1702:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 1703: 
 1704:    // Second step is to find the level that contains zt
 1705:    // Uses a binary search to find the level
 1706:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 1707:    int L = kbe;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 1708:    int R = nvrt - 1;
 1709: 
 1710:    // Get the z coordinates at the nodes of the element at the levels L and R
 1711:    double zLAtNodes[4], zRAtNodes[4];
 1712:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 1713:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 1714: 
 1715:    double zL = interpolate(shpCoord, zLAtNodes);
 1716:    double zR = interpolate(shpCoord, zRAtNodes);
 1717:    
 1718:    // Interpolates vertically the velocities
 1719:    double wght1, wght2;
 1720:    if (xt.z<=zL) {
 1721:       wght1 = 1.0;
 1722:       wght2 = 0.0;
 1723:    }
 1724:    else if (xt.z>=zR) {
 1725:       wght1 = 0.0;
 1726:       wght2 = 1.0;
 1727:    }
 1728:    else {
 1729:       // Perform a binary search to find the levels between L and R that contain xt.z
 1730:       while (R - L > 1) {
 1731:          int M = (L + R) / 2;
 1732: 
 1733:          double zMAtNodes[4];
 1734:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 1735:          double zM = interpolate(shpCoord, zMAtNodes);
 1736:          if (zM < xt.z) 
 1737:          {
 1738:             L = M;
 1739:             zL = zM;
 1740:          }
 1741:          else 
 1742:          {
 1743:             R = M;
 1744:             zR = zM;
 1745:          }
 1746:       }
 1747:       assert(L == R-1);
 1748:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 1749: 
 1750:       wght2 = (xt.z - zL)/(zR - zL);
 1751:       wght1 = 1.0 - wght2;
 1752:    }
 1753: // printf("$$$ wght1 = %f, wght2 = %f, zt = %f, zL = %f, zR = %f\n", wght1, wght2, zt, zL, zR);
 1754: // printf("$$$ shpCoord = %f, %f, %f, %f\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 1755:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 1756:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 1757: 
 1758:    // Neither of the interpolated velocities should be NaN
 1759:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 1760: 
 1761: }
 1762: 
 1763: 
 1764: 
 1765: __inline__ __device__ double Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 1766: __inline__ __device__ double Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 1767: __inline__ __device__ Point2 Side::p_t(double t) const { return {x(t), y(t)}; }
 1768: __inline__ __device__ int    Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 1769: __inline__ __device__ double Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 1770: 
 1771: __inline__ __device__ double Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 1772: __inline__ __device__ double Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 1773: __inline__ __device__ double Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 1774: 
 1775: 
 1776: __inline__ __device__ double Side::Cd(void)      const { if constexpr(nchi != 0) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 1777: 
 1778: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 1779: 
 1780: /**
 1781:  * This method performs backtracking from the side center until a time -dt back in time 
 1782:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 1783:  * intermediate point.
 1784:  *
 1785:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 1786:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 1787:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 1788:  * remaining time.
 1789:  * 
 1790:  * NOTE: Runge-Kutta is not implemented yet. XXX
 1791:  * 
 1792:  * @param uuint, vvint, wwint: Velocities at the final point
 1793:  * @param jlev: Level at which the backtracking is performed
 1794:  * @param dt, dtbk: Tracking timesteps
 1795:  * @param sclr: Array for backtracked values
 1796:  * @return: True if the backtracking was successful, false otherwise
 1797:  */
 1798: __inline__ __device__ bool Side::btrack(
 1799:       int jlev,
 1800:       double dt,            // Tracking time
 1801:       double dtbk,          // Tracking timestep
 1802:       double* sclr,         // Array for backtracked values
 1803:       Vector3 &u_int
 1804: ) const {
 1805: 
 1806:    // Start from side center
 1807:    Point3 x0 = {center.x, center.y, zc[jlev]};
 1808:  
 1809: 
 1810:    double time_rm = dt; // Remaining time
 1811: 
 1812: 
 1813:    // // Initialize outputs XXX
 1814:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 1815:    //    sclr[i] = 0.0;
 1816:    // }
 1817: 
 1818: 
 1819:    // Initial velocities
 1820:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 1821: 
 1822:    // Find the element that is in the direction opposite to the velocity
 1823:    Element* curElem = findElementTowards({u_int.x, u_int.y});
 1824: 
 1825: 
 1826:    const int MAX_ITERATIONS = 1000; 
 1827:    Element* nextElem = curElem;
 1828:    int iter = 0;
 1829:    while(true) {
 1830:       // Calculate timestep
 1831:       double dtb = min(dtbk, time_rm);
 1832: 
 1833:       // Next point in the backtracking curve
 1834:       Point3 xt = x0 - dtb*u_int;
 1835: 
 1836:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb);
 1837:       assert(found && "Backtracking failed in btrack");
 1838: // printf("<>T = %f, %f %f %f\n", time_rm - dtb, xt, yt, zt);
 1839:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 1840:                       // then time_rm needs to be increased by the unused time.
 1841: 
 1842: 
 1843:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 1844: 
 1845:       // The current point becomes the next segment's starting point.
 1846:       x0 = xt;
 1847:  
 1848:       curElem = nextElem;
 1849: 
 1850:       iter++;
 1851:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 1852:    }
 1853: 
 1854: 
 1855: }
 1856: 
