  225: // Polynomial class
  226: template<int grade>
  227: struct Polynomial {
  228:     // Static assertion to give a clear error message at compile time
  229:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  230: };
  231: 
  232: 
  233: // Explicit specialization for grade 4
  234: template<>
  235: struct Polynomial<4> {
  236:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  237: 
  238:    // Constructor from coefficients
  239:    __device__ __host__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  240: 
  241:    __device__ __host__ __forceinline__ double eval(double x) const {
  242:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  243:    }
  244: };
