  931: struct Node {
  932: 
  933:    // Geometry information
  934:    int idx;        // Index of the node
  935:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
  936:    int numNodes;   // Number of nodes neighbors of this node
  937: 
  938:    Element **elements; // Array of pointers to the elements that share this node
  939:    int numElements;   // Number of elements that share this node
  940: 
  941:    Point3 p;
  942:    Vector3 u2[nvrt];
  943:    double znl[nvrt];
  944:    double lon, lat;
  945:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
  946:    double depth;
  947: 
  948:    int kb;       // Bottom index of the node
  949: 
  950:    bool isDry;     // True if the node is dry
  951: 
  952:    int iadv;     // Advection flag
  953: 
  954:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
  955: 
  956:    // Physical information
  957:    Tracers tr_nd0[nvrt]; // Initial tracer conc. at nodes
  958: 
  959:    double rho[nvrt];     // Density
  960: 
  961:    double eta1; // Elevation at nodes at previous timestep
  962:    double eta2; // Elevation at nodes at current timestep
  963: 
  964:    double ETP;  // Earth Tidal Potential
  965: 
  966:    
  967:    double pr;    // Air pressure
  968:    double grav2; // Gravity 
  969:    
  970:    Vector2 dav;  // Depth averaged velocity
  971: 
  972:    Vector2 tau; // Wind stress vector
  973: 
  974:    // Vegetation parameters
  975:    double veg_h;
  976:    double veg_nv;
  977:    double veg_di;
  978:    double veg_Cd;
  979:    double veg_h_unbent;
  980:    double veg_di_unbent;
  981:    double veg_nv_unbent;
  982:    double veg_alpha_vert_mean;
  983:    double veg_alpha0;
  984:    double veg_alpha3D[nvrt];
  985: 
  986:    // Bottom drag parameters
  987:    double Cd;       // Bottom drag coefficient
  988:    double rough;    // Bottom roughness length
  989:    Vector2 tau_bot; // Bottom stress vector
  990: 
  991:    double bdef1; // Bottom deformation at previous timestep
  992:    double bdef2; // Bottom deformation at current timestep
  993: 
  994:    double qel; // RHS
  995:    double coeffDiag; // Diagonal coefficient of the matrix
  996:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
  997: 
  998:    double mP; // Search direction for conjugate gradient method
  999:    double mR; // Residual for conjugate gradient method
 1000:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1001:    double mX; // Solution for conjugate gradient method
 1002: 
 1003:    // Meteorological forcing
 1004:    Vector2 u_air;
 1005:    double p_air;
 1006:    double t_air;
 1007:    double q_air;
 1008:    double wind_angle;  // Wind rotation angle
 1009: 
 1010:    __host__ __device__ void setWind(Vector2 &u) {
 1011:    // Sets the wind vector taking into account the wind rotation angle
 1012:    
 1013:       const double dir = atan2(-u.x,-u.y);
 1014:       const double speed = length(u);
 1015: 
 1016:       // Calculate new u and v components with added rotation angle
 1017:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1018:    }
 1019: 
 1020:    __host__ __device__ Point2 p2(void) const { return {p.x, p.y}; }
 1021: 
 1022:    __host__ __device__ double sigmaTransitionDepth(void) const;
 1023: 
 1024:    __inline__ __device__ double Dz(int k) const { return znl[k] - znl[k-1]; }
 1025:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1026:    __inline__ __device__ double zTopCanopy(void) const { return znl[kb] + veg_h; } 
 1027: 
 1028:    __device__ void clearMatrixRow(void) {
 1029:       // Clear the matrix row for this node
 1030:       coeffDiag = 0.0;
 1031:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1032: 
 1033:    }
 1034: 
 1035:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1036:       // Add the value to the sparse matrix for this node
 1037:       
 1038:       if (node == this) {
 1039:          coeffDiag += value;
 1040: printf("addToSparseMatrix: node == this, value = %f\n", coeffDiag);         
 1041:       } else {
 1042:          // Search (linearly)the index of the node in the array of nodes
 1043:          // XXX: This is not efficient, see if we can improve this
 1044:          int i;
 1045:          for (i = 0; i < numNodes; i++) {
 1046:             if (nodes[i] == node) {
 1047:                break;
 1048:             }
 1049:          }
 1050:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1051:          coeffMatrix[i] += value;
 1052:       }
 1053:    }
 1054: 
 1055: #ifdef BACKTRACKING
 1056:    __device__ void updateZCoordData() {
 1057:    // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 1058: 
 1059:       // Check if node is wet
 1060:       isDry = (depth + eta2 <= h0);  // XXX Check if we are doing this elsewhere
 1061: 
 1062:       if (idry) return;
 1063: 
 1064:       if constexpr(ivcor == 2) {  // SZ coordinates
 1065:          
 1066:          // Compute bottom level index
 1067:          if (depth <= mesh->h_s) {
 1068:                kb = mesh->nzlevels;
 1069:          } else {
 1070:                kb = -1;
 1071:                for (int i = 0; i < mesh->kz-1; i++) {
 1072:                   if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 1073:                      kb = i;
 1074:                      break;
 1075:                   }
 1076:                }
 1077:          }
 1078:       } 
 1079:       else if (ivcor == 1) {  // Localized sigma
 1080:          // Do nothing
 1081:       }
 1082: 
 1083:    }
 1084: #endif   
 1085: 
 1086:    __device__ double compZCoord(int k) const;
 1087: 
 1088: 
 1089: 
 1090: };
