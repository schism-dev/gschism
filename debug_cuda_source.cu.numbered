 1053: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1054:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1055: }
 1056: 
 1057: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1058:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1059: }   
