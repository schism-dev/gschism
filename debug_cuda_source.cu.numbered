 1212: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1213:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1214: }
 1215: 
 1216: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1217:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1218: }   
 1219: 
 1220: __device__ __inline__ double min3(double a, double b, double c) {
 1221:    return min(a, min(b, c));
 1222: }
 1223: 
 1224: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1225:    return min(a, min(b, min(c, d)));
 1226: }
