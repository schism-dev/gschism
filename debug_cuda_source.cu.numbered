 2173: 
 2174: __host__ __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2175: 
 2176: __device__ double Node::compZCoord(int k) const {
 2177:    // Computes the z coordinate at level k.
 2178:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2179:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2180:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2181:    // used 
 2182:    
 2183:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2184:       
 2185:    if (isDry)  return 0.0;
 2186: 
 2187:    if constexpr(ivcor == 2) {
 2188: 
 2189:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2190:       const int kz = mesh->kz;
 2191: 
 2192:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2193:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2194:       // once per time step/node.
 2195:       // CHECK: updateZCoordData
 2196:       if (k == kz)               return -hmod2;
 2197:       else if (k == nvrt-1)      return eta2;
 2198:       else if (k == kb)          return -depth;
 2199:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2200:       else if (k > kz) {
 2201:          const int ksig = k - kz + 1;
 2202: 
 2203:          if (hmod2 <= mesh->h_c) {
 2204:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2205:          } 
 2206:          else if (eta2 <= - mesh->h_c - (depth - mesh->h_c) * mesh->theta_f/mesh->sinh_theta_f) {
 2207:             printf("Please choose larger h_c: %f %f\n", eta2, mesh->h_c);
 2208:             Error("ZCOOR: invalid h_c\n");
 2209:          } 
 2210:          else {
 2211:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2212:                          mesh->h_c * mesh->sigma[ksig] + 
 2213:                          (hmod2 - mesh->h_c) * mesh->cs[ksig];
 2214:          }
 2215:       } else { 
 2216:          Error("ZCOOR: invalid level or coordinate system\n");
 2217:       }
 2218: 
 2219:    }
 2220:    else if constexpr(ivcor == 1) {
 2221:       if (k == kb) return -depth;
 2222:       else if (k == nvrt-1) return eta2;
 2223:       else if (k >= kb) {
 2224:             return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2225:       }
 2226:    }
 2227:    
 2228:    printf("ZCOOR: invalid level or coordinate system\n");
 2229:    return 0.0;
 2230: }
 2231: 
 2232: 
 2233: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2234:                 double *node_coords, double *wind_rotate_angle, 
 2235:                 int *isdel, int *isidenode, int *isbnd,
 2236:                 int *nond, int *nlnd, int *iond, int *ilnd,
 2237:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2238:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2239:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2240:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2241:                 int *localNodePart,     int *localElemPart,     int *localSidePart) {
 2242: 
 2243:    printf("Populating mesh for partition %d, %d, %d\n", partNum, nond, nlnd);
 2244: 
 2245:    // Horizontal grid
 2246:    printf("Processing %d nodes\n", np);    
 2247: 
 2248: 
 2249:    int idxNodeBoundary = 0;  
 2250:    for (int i = 0; i < np; i++)
 2251:    {
 2252:       Node &node = localNodeData[i];
 2253: 
 2254:       node.idx = i;
 2255: 
 2256:       const int idxNodeStart = nodeNeighNodesStart[i];
 2257:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2258:       node.numNodes = idxNodeEnd - idxNodeStart;
 2259:       node.nodes = nodeNeighNodes + idxNodeStart;
 2260:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2261: 
 2262: 
 2263: 
 2264:       const int idxElemStart = nodeNeighElemsStart[i];
 2265:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2266:       node.numElements = idxElemEnd - idxElemStart;
 2267:       node.elements = nodeNeighElems + idxElemStart;
 2268: 
 2269: 
 2270:       
 2271:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2272:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2273:          const int partNode = localNodePart[idxNodeGlobal]; 
 2274:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2275: 
 2276: 
 2277:          Node *node_ptr = nodes[partNode] + idxNode;
 2278:          
 2279:          nodeNeighNodes[idx] = node_ptr;
 2280:       }
 2281: 
 2282:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2283:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2284:          const int partElem = localElemPart[idxElemGlobal];
 2285:          const int idxElem  = localElemIndices[idxElemGlobal];
 2286: 
 2287:          Element *elem_ptr = elems[partElem] + idxElem;
 2288: 
 2289:          nodeNeighElems[idx] = elem_ptr;
 2290:       }      
 2291: 
 2292: 
 2293:       node.wind_angle = wind_rotate_angle[i];
 2294: 
 2295:       // Element **elements; // pointer to the elements connected to this node
 2296:       // int numElements;   // number of elements shared by this node
 2297: 
 2298:       node.p.x   = node_coords[i * 3];
 2299:       node.p.y   = node_coords[i * 3 + 1];
 2300:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2301:       node.depth = node_coords[i * 3 + 2];
 2302: 
 2303: 
 2304: 
 2305:       // Links the node to the boundary information
 2306:       if (isbnd[i] >= 0) {
 2307:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2308:          node.nodeBnd->node = &node;
 2309: 
 2310:          if (isbnd[i]>0) {
 2311: 
 2312:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2313:             node.nodeBnd->segment->ifltype = isbnd[i];
 2314: 
 2315:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2316:             node.nodeBnd->segment->clen  = nan("1");
 2317:             node.nodeBnd->segment->carea = nan("1");
 2318: 
 2319:          }
 2320:          else {
 2321:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2322:          }
 2323:          
 2324:          idxNodeBoundary++;
 2325:       }
 2326:       else {
 2327:          node.nodeBnd = nullptr;
 2328:       }
 2329: 
 2330: // XXXX
 2331: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2332: constexpr double rot_per = 3000.0;
 2333: constexpr double rot_f = 2.0*pi/rot_per;
 2334: for (int k = 0; k < nvrt; k++) {node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0};}
 2335: // XXXXX
 2336:    }
 2337: 
 2338:    nbp = idxNodeBoundary;
 2339: 
 2340:    printf("Processing %d sides\n", ns);
 2341:    int idxSideBoundary = 0;
 2342:    for (int i = 0; i < ns; i++)
 2343:    {
 2344:       Side &side = localSideData[i];
 2345:       side.idx = i;
 2346:       // finding the pointer to the nodes that form the side
 2347:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2348:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2349: 
 2350:       const int locidx_n1 = localNodeIndices[idx_n1];
 2351:       const int locidx_n2 = localNodeIndices[idx_n2];
 2352:       const int part_n1 =   localNodePart[idx_n1];
 2353:       const int part_n2 =   localNodePart[idx_n2];
 2354: 
 2355:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2356:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2357: 
 2358:       // Normal vector to the side
 2359:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2360:       const double norm = sqrt(dot(side.n, side.n));
 2361:       side.n = side.n/norm;
 2362: 
 2363:       // Side boundary type
 2364:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 2365:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 2366:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2367:       
 2368:       if (n1bnd != nullptr || n2bnd != nullptr) 
 2369:       {
 2370:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2371:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2372:          else                  side.sideBnd->segment = n2bnd->segment;
 2373:          side.sideBnd->side = &side;
 2374:          idxSideBoundary++;
 2375:       }
 2376:       else side.sideBnd = nullptr;
 2377: 
 2378:       // finding the pointer to the elements that share the side
 2379:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2380:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2381: 
 2382:       if (idx_e1 > -1) {
 2383:          const int locidx_e1 = localElemIndices[idx_e1];
 2384:          const int part_e1 =  localElemPart[idx_e1];
 2385:          side.elems[0] = elems[part_e1] + locidx_e1;
 2386:          // printf("s@@ part_e1 = %d, locidx_e1 = %d, elems[part_e1] = %p\n", part_e1, locidx_e1, elems[part_e1]);
 2387:          // // printf("s-- side.elems[0] = %p idx = %d i34 = %d (x,y,z) = (%f,%f,%f) size = %d\n", side.elems[0], side.elems[0]->idx, side.elems[0]->i34, side.elems[0]->center.x, side.elems[0]->center.y, side.elems[0]->center.z, sizeof(Element));
 2388:          // printf("o-- elems = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2389:       }
 2390:       else {
 2391:          side.elems[0] = nullptr;
 2392:       }
 2393: 
 2394:       if (idx_e2 > -1) {
 2395:          const int locidx_e2 = localElemIndices[idx_e2];
 2396:          const int part_e2 =  localElemPart[idx_e2];
 2397:          side.elems[1] = elems[part_e2] + locidx_e2;
 2398:       }
 2399:       else {
 2400:          side.elems[1] = nullptr;
 2401:       }
 2402: 
 2403: 
 2404: 
 2405:       // Compute the center of the side
 2406:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2407: 
 2408: // XXXX
 2409: constexpr double rot_per=3000.0;
 2410: constexpr double rot_f=2.0*pi/rot_per;
 2411: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2412: // XXXXX      
 2413: 
 2414:       // Compute the z level at the center of the side
 2415:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->znl[k] + side.n2->znl[k]);
 2416: 
 2417:       // Compute the length of the side
 2418:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2419:       side.length = sqrt(dot(vLen, vLen));
 2420: 
 2421:    }
 2422: 
 2423:    printf("Processing %d elements\n", ne);
 2424:    for (int i = 0; i < ne; i++)
 2425:    {
 2426:       Element &elem = localElemData[i];
 2427:       elem.idx = i;
 2428:       for (int j = 0; j < i34[i]; j++) {
 2429:          const int idxNode = elnode[i*4 + j];  
 2430:          const int idxSide = elside[i*4 + j];
 2431:          
 2432:          elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 2433:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2434: 
 2435: 
 2436: 
 2437:          // Find the neighboring element  
 2438:          if (elem.sides[j]->elems[0] == &elem) {
 2439:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2440:          }
 2441:          else {
 2442:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2443:          }
 2444:          
 2445:       }
 2446: 
 2447:       elem.i34 = i34[i];
 2448: 
 2449: // printf("elem = %p, elem.i34 = %d\n", &elem, elem.i34);
 2450: 
 2451:       // Compute the centroid of the element and its depth
 2452:       Vector2 center = {0.0, 0.0};
 2453:       elem.depth = 0.0;
 2454:       for (int j = 0; j < i34[i]; j++) {
 2455:          center += elem.nodes[j]->p2()/i34[i];
 2456:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2457:       }
 2458:       elem.center.x = center.x;
 2459:       elem.center.y = center.y;
 2460: 
 2461:       // printf("elem = %p, i34 = %d, center = (%f,%f,%f)\n", &elem, elem.i34, elem.center.x, elem.center.y, elem.depth);
 2462:       
 2463:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2464:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2465: 
 2466:       elem.area = elem.computeSignedArea(); 
 2467:       elem.radius = sqrt(elem.area)/pi; 
 2468:       
 2469:       // Determines which way the normal vector to each side is oriented.
 2470:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2471:       for (int j = 0; j < i34[i]; j++)  
 2472:       {
 2473:          if (elem.sides[j]->elems[0] == &elem) {
 2474:             elem.ssign[j] =  1.0;
 2475:          }
 2476:          else {
 2477:             elem.ssign[j] = -1.0;
 2478:          }
 2479: 
 2480:       }
 2481: 
 2482:       // Derivatives of shape functions
 2483:       //  For ics=2, this is done inside element/ll frame XXX
 2484:       //  For quads, the derivative is evaluated at centroid
 2485:       const int i34 = elem.i34;
 2486:       for (int j = 0; j < i34; j++) {
 2487:          const double area = elem.area;
 2488:          const int id2 = elem.nxq(1 + j);
 2489:          const int id3 = elem.nxq(2 + j);
 2490:          const int id4 = elem.nxq(3 + j);
 2491:          if (elem.isTri()) {
 2492:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2493:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2494:             // da1/dx = (y1 - y2)/(2*area)
 2495:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2496:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2497:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2498:          }
 2499:          else  { // Quad; evaluate at centroid
 2500:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2501:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2502:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2503:          } // if Tri
 2504: 
 2505:       } // for j
 2506: 
 2507:    }
 2508: 
 2509: }
 2510: 
 2511: 
 2512: 
 2513: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 2514:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 2515:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 2516:    // 
 2517:    // This kernel is called for all nodes.
 2518: 
 2519: 
 2520:    NODE(node1);
 2521: 
 2522: 
 2523:    node1->clearMatrixRow();
 2524:    node1->qel = 0.0;
 2525: 
 2526:    // THIS IS FOR STRUCTURES XXX
 2527:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 2528: 
 2529:    
 2530:    for (int j=0; j<node1->numElements; j++) {
 2531:       // For each element connected to the node...
 2532: 
 2533:       Element *elem = node1->elements[j];
 2534: 
 2535:       // Compute the average gravity
 2536:       const double grav3 = elem->mean(&Node::grav2);
 2537: 
 2538:       // Look at the documentation for the description of the terms in the following integrals
 2539: 
 2540:       // Integral I_1 
 2541:       // \bar{\breve{H}} 
 2542:       const double hhatb = elem->mean(&Side::hhat);        
 2543: 
 2544:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 2545: 
 2546:       const int id1 = elem->nodeLocalIdx(node1); 
 2547:       const double area = elem->area;
 2548: 
 2549:       if (elem->isTri()) {
 2550: 
 2551:          // To clarify the notation in this section: 
 2552:          //   i standtimes for the node under consideration (node1)
 2553:          //   j (node2) and k (node3) are the other nodes of the triangle.
 2554:          const int id2 = elem->nxq(1 + id1);
 2555:          const int id3 = elem->nxq(2 + id1);
 2556:          Node *node2 = elem->nodes[id2];
 2557:          Node *node3 = elem->nodes[id3];
 2558: 
 2559:          const Point2 x1 = node1->p2();
 2560:          const Point2 x2 = node2->p2();
 2561:          const Point2 x3 = node3->p2();
 2562: 
 2563:          // integral of phi_i*phi_j
 2564:          const double ipp_ii = (1.0/6.0 )*area;
 2565:          const double ipp_ij = (1.0/12.0)*area;
 2566:          const double ipp_ik = (1.0/12.0)*area;
 2567: 
 2568:          // integral of [(grad phi_i) * (grad phi_j)]
 2569:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 2570:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 2571:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 2572: 
 2573:          // Computes the different components of integral I_1 of each node with respect to node i.
 2574:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 2575:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 2576:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 2577: 
 2578:          node1->addToSparseMatrix(node1, I1_ii);
 2579:          node1->addToSparseMatrix(node2, I1_ij); 
 2580:          node1->addToSparseMatrix(node3, I1_ik);
 2581: 
 2582:          printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 2583:      
 2584:       }
 2585:       else { // Quad
 2586:          // XXX IMPLEMENT THIS
 2587:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2588:       } 
 2589: 
 2590:  
 2591:       // Integral I_4
 2592:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 2593:       // Where
 2594:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 2595: 
 2596:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 2597:       // of U over the element.
 2598:       Vector2 Umean = {0.0, 0.0};
 2599:       for (int m=0; m<elem->i34; m++) {      
 2600:          const Side *side = elem->sides[m];
 2601: 
 2602:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 2603:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 2604:       }
 2605:       Umean = Umean/elem->i34;
 2606: 
 2607:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 2608: 
 2609:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 2610:       const double I_4_1 = dot(gradPhi_1, Umean);
 2611: 
 2612:       // Integral of \nabla\phi_i \cdot \pmb{E}
 2613:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 2614:      
 2615:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);
 2616:       
 2617: 
 2618:       // Additional terms 
 2619:       double vnorm = 0.0;
 2620:       if (imm == 2)  { // Pre-compute vnorm on the element
 2621:          Vector3 ubed;
 2622:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 2623: 
 2624:          Vector3 gradP = {0.0, 0.0, 1.0};
 2625:          for (int m=0; m < elem->i34; m++) {
 2626:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 2627:            gradP += toVector3(gradP_2D, 0.0);
 2628:          }   
 2629:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 2630:       } // imm==2
 2631: 
 2632:       if (elem->isTri()) {
 2633:          for (int l=0; l<3; l++) {
 2634:            double fac;
 2635: 
 2636:            Node *node = elem->nodes[l];
 2637: 
 2638:            (node == node1)? fac=2.0 : fac=1.0;
 2639: 
 2640:            if (imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 2641:            else        node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 2642:            
 2643:          }
 2644: 
 2645:          if (!elem->isDry) {
 2646:            const Vector2 gradEta = elem->nodes[0]->eta2*elem->gradPhi[0] +
 2647:                                    elem->nodes[1]->eta2*elem->gradPhi[1] +
 2648:                                    elem->nodes[2]->eta2*elem->gradPhi[2];
 2649: 
 2650:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 2651:          }
 2652: 
 2653:       } // isTri
 2654:       else { // isQuad
 2655:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2656:          // for (int l=0; l<4; l++) {
 2657:          //   const Node *node = elem->nodes[l];
 2658: 
 2659:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 2660:          //   else        tmp2 = node->bdef2 - node->bdef1;
 2661: 
 2662:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 2663:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 2664:          // }
 2665: 
 2666:       } // isQuad
 2667: 
 2668: 
 2669:       node1->qel += (dt/elem->i34)*elem->vsource;
 2670:       
 2671: 
 2672:    } // for all elements connected to the node
 2673:    
 2674: 
 2675: 
 2676:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 2677:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 2678:    NodeBoundary *nodeBnd = node1->nodeBnd;
 2679:    if (nodeBnd != nullptr)  { 
 2680:       // If it is an open boundary node...
 2681: 
 2682:       // At least one open bnd side, maybe two
 2683:       for (int l=0; l<2; l++) { 
 2684: 
 2685:          // Gets each of the sides sharing the node. 
 2686:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 2687: 
 2688:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 2689: 
 2690:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 2691: 
 2692: 
 2693:          if (sideBnd != nullptr) {
 2694:             // If the side is on a boundary...
 2695: 
 2696:             // Get the boundary segment
 2697:             const BoundarySegment *sideSegment = sideBnd->segment;
 2698:             const Side *side = sideBnd->side;
 2699: 
 2700:             // Integral I_3
 2701:             if (sideSegment->ifltype != 0) {
 2702:             // Natural or Flather b.c.
 2703: 
 2704:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 2705:                // especially for Flather b.c.
 2706:                double ri3 = 0.0;
 2707:                if (!side->isDry) {
 2708:                   // If the side is not dry
 2709:                   
 2710:                   // Computes the side flux of (uth, vth)
 2711:                   double Vn = 0.0;
 2712:                   for (int k = side->kb; k<nvrt-1; k++) {
 2713:                      // uth, vth in lat/lon frame if ics=2
 2714:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 2715:                      const double vn1 = dot(side->uth[k  ], side->n); // outer normal
 2716:                      const double vn2 = dot(side->uth[k+1], side->n);
 2717: 
 2718:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 2719:                   }
 2720: 
 2721:                   ri3 = 0.5*side->length*Vn;
 2722:                }
 2723: 
 2724:                if (sideSegment->ifltype == -1) { // Flather 1
 2725: 
 2726:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 2727:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 2728: 
 2729:                   const double con0 = (1.0/6.0)*side->length*sqrt(grav*side->depth()); // For coefficient matrix
 2730:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 2731:                   
 2732:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 2733:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 2734: 
 2735:                } 
 2736:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 2737:                   // Reset ri3
 2738:                   ri3 = 0.0;
 2739: 
 2740:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 2741: 
 2742:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 2743: 
 2744:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 2745:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 2746: 
 2747:                   const double con0 = (1.0/6.0)*side->length*tmp*thetai*dt;
 2748:                   node1->addToSparseMatrix(node1, con0*2.0);
 2749:                   node1->addToSparseMatrix(node2, con0);
 2750: 
 2751:                } // if Flather or Discharge
 2752: 
 2753:                node1->qel -= thetai*dt*ri3;
 2754: 
 2755:             } // I_3
 2756:           
 2757: 
 2758:             // Integral I_5
 2759:             if(!side->isDry) {
 2760: 
 2761:                const double Unbar = dot(side->U, side->n);
 2762: 
 2763:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->length*Unbar;
 2764:                
 2765:             } // I_5
 2766: 
 2767:          } // if is boundary side
 2768: 
 2769:       } // for l
 2770: 
 2771:    } // if isbnd
 2772: 
 2773: }
 2774: 
 2775: 
 2776: extern "C" {
 2777:    __global__ void backtrackAllNodes(void) {
 2778: 
 2779:       // max/min # of sub-divisions
 2780:       const int ndelt_max = max(1.0, dt/dtb_min);
 2781:       const int ndelt_min = max(1.0, dt/dtb_max); 
 2782: 
 2783:       // Removed all references to swild98 XXX
 2784:       // swild98=0.d0 !init
 2785: 
 2786: 
 2787:       SIDE(side);
 2788: 
 2789:       const int kb = side->kb;
 2790: 
 2791:       printf("backtrackAllNodes: side->idx = %d, nvrt = %d\n", side->idx, nvrt);
 2792: 
 2793:       // Initialize btrack velocities to the actual velocities at the side 
 2794:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 2795: 
 2796: 
 2797:       if (side->isDry) return;
 2798: 
 2799: 
 2800:       // Checks that at least one element is not dry
 2801:       const Element *elem1 = side->elems[0];
 2802:       const Element *elem2 = side->elems[1];
 2803: 
 2804: 
 2805:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 2806:       
 2807:       // XXXXXX
 2808:       // !swild_tmp to store global coord. of the starting side
 2809:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 2810:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 2811:       // !Use sframe2 
 2812:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 2813: 
 2814: 
 2815:       for (int k = kb; k < nvrt; k++) {
 2816:       //  Initialize (xt,yt,zt), nnel and vel.
 2817:       //  For ics=2, the coordinates are in local frames
 2818:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 2819: 
 2820: 
 2821:          const int iadvf = side->iadv();  // Advection flag
 2822: 
 2823:          Point3 xt;
 2824:          if constexpr(ics==1) {
 2825:             xt = side->center3D(k); 
 2826:          }
 2827:          else // lat/lon; in side lat/lon frame
 2828:          {
 2829:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 2830:          // XXX IMPLEMENT THIS
 2831:       //          xt=0.d0
 2832:       //          yt=0.d0
 2833:       //          !centroid coord. for nudging
 2834:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 2835:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 2836:          }  // ics
 2837: 
 2838: 
 2839:          // Velocity at the side (in ll frame for ics, same vertical direction)
 2840:          // XXX IS THIS NECESSARY?
 2841:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 2842: 
 2843:          // If on land or open boundary...
 2844:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 2845:          
 2846:          const double vmag = length(toVector2(u_int));
 2847: 
 2848:          if (vmag <= velmin_btrack) {
 2849:             // No activity 
 2850: 
 2851:             side->btu[k] = side->u2[k];
 2852: 
 2853:             
 2854:          } else {  // do btrack
 2855: 
 2856:           
 2857:             // Compute number of sub-divisions based on local gradients 
 2858:             // XXX IS THIS NECESSARY?
 2859:             double suma = 0.0;
 2860:             int icount = 0;
 2861:             for (int ii=0; ii<2; ii++) {
 2862: 
 2863:                const Element *elem = side->elems[ii];
 2864:                  
 2865:                if (elem == nullptr) continue;
 2866: 
 2867:                icount++;
 2868: 
 2869:                // Not strictly along z; in ll frame for ics=2
 2870: 
 2871:                double utmp[4];
 2872:                double vtmp[4];
 2873:                for (int jj = 0; jj < elem->i34; jj++) {
 2874: 
 2875:                   const Node *node = elem->nodes[jj];
 2876: 
 2877:                   if constexpr(ics==1) {
 2878:                      utmp[jj] = node->u2[k].x;
 2879:                      vtmp[jj] = node->u2[k].y;  
 2880:                   } else {
 2881:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 2882:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 2883:                   }
 2884:                } // for jj
 2885: 
 2886:                const Vector2 grad_u = elem->grad(utmp); 
 2887:                const Vector2 grad_v = elem->grad(vtmp);
 2888: 
 2889:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 2890:             } // for ii
 2891: 
 2892:             assert(icount > 0 && "Impossible 77");
 2893: 
 2894:             // '4' is somewhat arbitrary
 2895:             const int ndelt = max(ndelt_min, min(ndelt_max, int(suma/icount)*4)); // >=1
 2896: 
 2897:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 2898:          
 2899: 
 2900:             Vector3 u_int = {0.0, 0.0, 0.0};
 2901: 
 2902:             side->btrack(k, dt, dtbk, u_int);
 2903: 
 2904:                
 2905:          } // if vmag (do backtrack)
 2906: 
 2907:       } // for j=jmin,nvrt-1
 2908: 
 2909:    }
 2910: } // extern "C"
 2911: 
 2912: template<int nc>
 2913: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 2914: 
 2915: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 2916: //
 2917: // a,b,c,r: input vectors and are not modified by this program.
 2918: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 2919: // r is the r.h.s.
 2920: // n: actual rank of the system.
 2921: // rows in u() and r();
 2922: // u: output with nc columns (transposed to rows)
 2923: // gam: a working array.
 2924: //
 2925: // NOTES:
 2926: // This is a template function that allows for different numbers of columns in the rhs vector.
 2927: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 2928: 
 2929:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 2930:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 2931: 
 2932:    double bet = b[0];
 2933:    if constexpr (nc == 1) {
 2934:       u[0] = rhs[0]/bet;
 2935:    } else {
 2936:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 2937:    }
 2938: 
 2939:    for (int j = 1; j < n; j++) {
 2940:       gam[j] = c[j-1]/bet;
 2941:       bet = b[j] - a[j]*gam[j];
 2942: 
 2943:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 2944: 
 2945:       if constexpr (nc == 1) {
 2946:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 2947:       } else {
 2948:          for (int k = 0; k < nc; k++) {
 2949:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 2950:          }
 2951:       }
 2952:    }
 2953: 
 2954:    // Back-substitution
 2955:    for (int j=n-1; j>=1; j--) {
 2956:       if constexpr (nc == 1) {
 2957:          u[j] = u[j] - gam[j+1]*u[j-1];
 2958:       } else {
 2959:          for (int k = 0; k < nc; k++) {
 2960:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 2961:          }
 2962:       }
 2963:    }
 2964: }
 2965: 
 2966: 
 2967: 
 2968: 
 2969: // Helper function that contains the core algorithm
 2970: template<typename XAccessor, typename YAccessor>
 2971: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 2972:                                     double  yp_top, double  yp_bot, 
 2973:                                     CubicSpline &spline) {
 2974:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 2975:    // 
 2976:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 2977:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 2978:    //
 2979:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 2980:    // 
 2981:    // Inputs: 
 2982:    //            n: dimension for x etc; # of data pts (>=2);
 2983:    //            getX, getY: functions to access x,y coordinates
 2984:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 2985:    //     Output: 
 2986:    //            spline (CubicSpline): spline structure with x,y,y',y''
 2987: 
 2988:    const int n = k2 - k1 + 1;
 2989:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 2990: 
 2991:    // Allocate memory for the splines
 2992:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 2993:    spline.x   = new double[n];
 2994:    spline.y   = new double[n];
 2995:    spline.yp  = new double[n];
 2996:    spline.ypp = new double[n];
 2997: 
 2998:    for (int k=k1; k<=k2; k++) {
 2999:       spline.x[k] = getX(k);
 3000:       spline.y[k] = getY(k);
 3001:    }
 3002: 
 3003:    // This is to simplify expressions later
 3004:    double *x = spline.x;
 3005:    double *y = spline.y;
 3006: 
 3007:    double *a = nullptr;
 3008:    double *b = nullptr;
 3009:    double *c = nullptr;
 3010:    double *gam = nullptr;
 3011:    double *rhs = nullptr;
 3012:    
 3013: 
 3014:       a = new double[n];   // Lower diagonal
 3015:       b = new double[n];   // Diagonal
 3016:       c = new double[n];   // Upper diagonal
 3017:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3018:       rhs = new double[n]; // Right-hand side
 3019: 
 3020:    for (int k=k1; k<=k2; k++) {
 3021:       if (k == k1) {
 3022:          // Bottom level
 3023:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3024:          b[k] = (x[k+1] - x[k])/3.0;
 3025:          c[k] = b[k]/2.0;
 3026:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3027:       } else if (k == n - 1) {
 3028:          // Top level (surface)
 3029:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3030:          b[k] = (x[k] - x[k-1])/3.0;
 3031:          a[k] = b[k]/2.0;
 3032:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3033:       } else {
 3034:          // Intermediate levels
 3035:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3036:          b[k] = (x[k+1] - x[k-1])/3.0;
 3037:          a[k] = (x[k  ] - x[k-1])/6.0;
 3038:          c[k] = (x[k+1] - x[k  ])/6.0;
 3039:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3040:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3041:       }
 3042:    }
 3043: 
 3044:    // Solve the tridiagonal system
 3045:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3046:    
 3047:    spline.yp[k1] = yp_bot;
 3048:    spline.yp[k2] = yp_top;
 3049: 
 3050:    // Compute rest of 1st derivatives using the splines
 3051:    for (int k=k1+1; k<k2; k++) {
 3052:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3053:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3054:    }
 3055:    
 3056:    delete[] a;
 3057:    delete[] b;
 3058:    delete[] c;
 3059:    delete[] gam;
 3060:    delete[] rhs;
 3061: 
 3062: }
 3063: 
 3064: // Array version
 3065: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3066:                                 double y_top, double y_bot, 
 3067:                                 CubicSpline &spline) {
 3068:    auto getX = [x] (int k) { return x[k]; };
 3069:    auto getY = [y] (int k) { return y[k]; };
 3070:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3071: }
 3072: 
 3073: // Lambda version - allows custom access patterns
 3074: template<typename XFunc, typename YFunc>
 3075: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3076:                                 double y_top, double y_bot,
 3077:                                 CubicSpline &spline) {
 3078:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3079: }
 3080: 
 3081: 
 3082: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 3083: {
 3084:    assert("Not implemented");
 3085: 
 3086:    return 0.0;
 3087: }
