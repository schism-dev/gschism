 1135: /**
 1136:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1137:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1138:    If the segment is completely inside the element, then it returns true.
 1139: 
 1140:    This function assumes:
 1141:    - The initial point is on a side of the element. 
 1142:    - Its position is given by parameter t in the range [0,1].
 1143:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1144:       intersects the element (elements are convex).
 1145: 
 1146:    To find the intersection point, this function does the following:
 1147:    - it finds the intersection of the line segment with all the element side lines,
 1148:       except for the one that contains the initial point.
 1149:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1150:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1151:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1152:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1153:       track segment is almost parallel to the element side line.
 1154: 
 1155:    Inputs:
 1156:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1157:    @param x2, y2: other end of the line segment
 1158: 
 1159:    Outputs:
 1160:    @param side:  side that intersects the line segment (input and output)
 1161:    @param nextElement (output): element that contains the intersection point
 1162:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1163:    @param zint (input/output): Vertical coordinate of the intersection point
 1164: 
 1165:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1166:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1167:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1168: 
 1169:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1170:    (Delta) being zero.
 1171: 
 1172:    The intersection2 point happens when:
 1173:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1174:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1175:    
 1176:    Assumption: the 4 points (including those of the side segment) are different.
 1177:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1178:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1179:    If true, (xIntersect,yIntersect) is the intersection.				
 1180:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1181: **/
 1182: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1183:                                               double &t, double& tIntersect) {
 1184: 
 1185:    double closest_intersect_t = 1e10;
 1186:    bool found_intersection = false;
 1187: 
 1188:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1189:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1190:    const Point2 x1 = side->point(t);
 1191:    
 1192: 
 1193:    Side *nextSide = nullptr;
 1194: 
 1195:    for (int i = 0; i < i34; i++) {
 1196: 
 1197:       // Element's i-th side 
 1198:       Side *side2 = sides[i];
 1199: 
 1200:       // Skip the side that contains the initial point
 1201:       if (side2 == side) continue;
 1202: 
 1203:       // (x3,y3)-(x4,y4) is the element side line
 1204:       const Point2 x3 = side2->n1->p2();
 1205:       const Point2 x4 = side2->n2->p2();
 1206: 
 1207:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1208:       const double delta = cross(x2 - x1, x3 - x4);
 1209: 
 1210:       if (delta != 0.0) {
 1211: 
 1212:          const double delta1 = cross(x3 - x1, x3 - x4);
 1213:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1214: 
 1215:          // Solves the two linear equations for tt1 and tt2
 1216:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1217:          const double tt2 = delta2/delta;
 1218: 
 1219:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1220:             closest_intersect_t = min(closest_intersect_t, tt1);
 1221:             nextSide = side2;
 1222: 
 1223:             nextElement = nextSide->otherElem(this);
 1224:             tIntersect = max(small, min(tt1, 1.0-small));
 1225:             t = tt2;
 1226: 
 1227:             found_intersection = true;
 1228:          }
 1229:       
 1230:       }
 1231: 
 1232:    }
 1233: 
 1234: 
 1235:    // found_intersection should always be true, since we checked all the sides.  
 1236:    side = nextSide;
 1237: // if (found_intersection) {
 1238: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1239: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1240: // }   
 1241:    return found_intersection;
 1242: }
 1243: 
 1244: 
 1245: 
 1246: 
 1247: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1248:                                               double &t, double& tIntersect) {
 1249: 
 1250:    double closest_intersect_t = 1e10;
 1251:    bool found_intersection = false;
 1252: 
 1253:    for (int i = 0; i < i34; i++) {
 1254: 
 1255:       Side *side2 = sides[i];
 1256: 
 1257:       // (x3,y3)-(x4,y4) is the element side line
 1258:       const Point2 x3 = side2->n1->p2();
 1259:       const Point2 x4 = side2->n2->p2();
 1260: 
 1261:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1262:       const double delta = cross(x2 - x1, x3 - x4);
 1263: 
 1264:       if (delta != 0.0) {
 1265: 
 1266:          const double delta1 = cross(x3 - x1, x3 - x4);
 1267:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1268: 
 1269:          // Solves the two linear equations for tt1 and tt2
 1270:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1271:          const double tt2 = delta2/delta;
 1272: 
 1273:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1274:             closest_intersect_t = min(closest_intersect_t, tt1);
 1275:             side = side2;
 1276:             nextElement = side->otherElem(this);
 1277:             t = tt2;
 1278:             tIntersect = max(small, min(tt1, 1.0-small));
 1279:             found_intersection = true;
 1280:          }
 1281:       
 1282:       }
 1283: 
 1284:    }
 1285: 
 1286: // if (found_intersection) {
 1287: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1288: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1289: // }
 1290: 
 1291:    // found_intersection should always be true, since we checked all the sides.  
 1292:    return found_intersection;
 1293: }
 1294: 
 1295: 
 1296: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1297:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1298: 
 1299:    printf("Tracking segment goes out of water at element %d\n", curElem->idx);
 1300: 
 1301:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1302:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1303:    // curElement.
 1304: 
 1305:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1306:    // And uses this velocity instead to continue the tracking.
 1307: 
 1308:    // computes the intersection point in cartesian coordinates
 1309:    Point2 intersection = nextSide->p_t(tt);
 1310: 
 1311:    // Nudges the point to the barycenter of the element. 
 1312:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1313:    // next segment intersects the element sides.  
 1314:    curElem->nudgeToBarycenter(intersection);
 1315: 
 1316:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1317:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1318:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1319:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1320: 
 1321:    // If the side is an open boundary, the tangential velocity is zero.
 1322:    if (nextSide->isBnd()) vtan = 0.0;
 1323: 
 1324:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1325:    const double us = vtan*nextSide->t().x;
 1326:    const double vs = vtan*nextSide->t().y;
 1327:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1328: 
 1329:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1330:    const double len2 = length(intersection - toPoint2(xt));
 1331:    const double vel2 = u_int.x*u_int.x + u_int.y*u_int.y;        
 1332:    assert(vel2 > 0.0 && "Zero velocity found");
 1333:    dt = dt - sqrt(len2/vel2); 
 1334: 
 1335:    // The end of this tracking segment is now the intersection point.
 1336:    xt = {intersection.x, intersection.y, zint};
 1337:    
 1338:    u_int = {us, vs, ws};
 1339:    
 1340: }
 1341: 
 1342: /**
 1343:  * Tracks a particle through elements and vertical levels in the mesh.
 1344:  * 
 1345:  * @param x0,y0,z0     Starting position coordinates
 1346:  * @param xt,yt,zt     Target position coordinates
 1347:  * @param dtb          Time step for tracking
 1348:  * @param uuint,vvint,wwint Initial velocity components
 1349:  * @param nextElem     Starting/resulting element index
 1350:  * 
 1351:  * @return Status code of type trackExitCodes
 1352:  * 
 1353:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1354:  * of the details are different. The idea is that the code requires less branches and is better fit
 1355:  * for GPU execution.
 1356:  * 
 1357:  * The main ideas here are:
 1358:  * - The starting point is expected to be in the starting element.
 1359:  * - The end point is guaranteed to be inside an element.
 1360:  * - since the starting point is inside the element, there are only two cases: 
 1361:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1362:  *     (b) it does not and (xt,yt) is already in the starting element.
 1363:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1364:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1365:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1366:  * - tt1 can be positive or negative. We only consider the positive values.
 1367:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1368:  * - The next intersection will occur at the smallest positive tt1.
 1369:  * - This intersection will be the next (x0,y0) position.
 1370:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1371:  *   of getting stuck in a loop.
 1372:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1373:  *   was found.
 1374:  */
 1375: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1376:                                                        Element *&nextElem, int &jlev, double &dt) {
 1377: // printf("trackThroughElementsAndLevels: x0=%f, y0=%f, xt=%f, yt=%f\n", x0, y0, xt, yt);
 1378:    // First thing is to check if the target point is inside the element. If it is there is nothing
 1379:    // else to do.
 1380:    if (containsPoint(toPoint2(xt))) {
 1381:       nextElem->interpolateVelocities(xt, u_int);
 1382:       return true;
 1383:    }
 1384: 
 1385:    Side *side = nullptr;
 1386: 
 1387:    // 1. Initial checks
 1388:    // Verify starting element is valid (wet)
 1389:    assert(!nextElem->idry && "Starting element is dry");
 1390: 
 1391:    // Checks if track has a zero length.
 1392:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1393:    assert(len2 > 0.0 && "Zero length track"); 
 1394:    
 1395: 
 1396:    const int MAX_ITERATIONS = 1000;
 1397:    
 1398:    double t;
 1399:    Side *nextSide = nullptr;
 1400:    double tIntersect = 1e10;
 1401:    double zint = x0.z;
 1402: 
 1403:    // Horizontal tracking loop
 1404:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1405:    // (x0,y0) is inside the element but the target point is not.
 1406:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1407:    assert(found_intersection && "No intersection found");
 1408: 
 1409:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1410: 
 1411:    // if the tracking segment goes out of water (either dry or edge boundary)
 1412:    if (isEdgeBoundary(nextSide) || (nextElem->idry)) {
 1413:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1414:       nextElem = this;
 1415:       
 1416:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1417:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1418:       return true;    
 1419:       }
 1420: 
 1421:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1422:    int iterations = 0;
 1423:    while (iterations < MAX_ITERATIONS) {
 1424:       iterations++;
 1425:       
 1426:       Element *curElem = nextElem;
 1427: 
 1428:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1429:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1430: 
 1431:       // If we are already in the target element, we are done.
 1432:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1433:       if (!found_intersection) break;
 1434: 
 1435: 
 1436:   
 1437:       // if the tracking segment goes out of water (either dry or edge boundary).
 1438:       if (curElem->isEdgeBoundary(nextSide) || (nextElem->idry)) {
 1439: 
 1440:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1441: 
 1442:          nextElem = curElem;
 1443: 
 1444:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1445:          // In this case, the caller (btrack) needs to take into account the remaining time.
 1446:          return true;
 1447:       }
 1448:       
 1449:       // Update position and element for next iteration
 1450:       side = nextSide;
 1451: 
 1452:    }
 1453: 
 1454: 
 1455:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 1456: 
 1457:  
 1458:    // Interpolate velocities at the final position. This is a conceptually simple step,
 1459:    // but the function is not simple, because it has to search for the vertical level containing zt.
 1460:    nextElem->interpolateVelocities(xt, u_int);
 1461: 
 1462: 
 1463:    return true;
 1464: }
 1465: 
 1466: 
 1467: 
 1468: 
 1469: __inline__ __device__ double Element::computeSignedArea(void) const {
 1470:    // Compute the area of the element
 1471: 
 1472:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 1473: 
 1474:    // In the quad case we need to add the area of the other triangle.
 1475:    if (isQuad()) {
 1476:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1477:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 1478:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1479:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 1480:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 1481:          Error("Negative area found in quad element");
 1482:       }
 1483:       res += ar1;
 1484:    }
 1485: 
 1486:    return res;
 1487: }
 1488: 
 1489: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 1490:    // In boundary sides, the element 1 is nullptr
 1491:    return side->elems[1] == nullptr; 
 1492: }
 1493: 
 1494: /**
 1495:    Compute the shape coordinates of the point (xt,yt) in the element.
 1496:    @param xt (input): x-coordinate of the point
 1497:    @param shpCoords (output): shape coordinates of the point
 1498:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 1499:    @return true if the point is inside the element, false otherwise
 1500: **/
 1501: __device__ bool Element::computeShapeCoords(Point2 xt, double shpCoords[4],
 1502:                                             bool fixNegshpCoord) const {
 1503: 
 1504:    // Compute the shape coordinates of the point xt in the element.
 1505:    if (i34==3) {
 1506:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 1507:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 1508:       // and in this case, the pt will be nudged into the element
 1509:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 1510:       // from the local frame, so use additional check.
 1511: 
 1512:       Point2 x0, x1, x2;
 1513: 
 1514:       if constexpr(ics==1) {
 1515:          x0 = nodes[0]->p2();
 1516:          x1 = nodes[1]->p2();
 1517:          x2 = nodes[2]->p2();
 1518:       }
 1519:       else // lat/lon
 1520:       {
 1521:          Error("Not implemented yet");
 1522: #ifdef ICS2
 1523:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 1524:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 1525:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 1526: #endif
 1527:       }
 1528: 
 1529:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 1530:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 1531:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 1532:       shpCoords[3] = 0.0;
 1533:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 1534: 
 1535:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 1536:       // then we fix the negative shape coordinates.
 1537:       if (fixNegshpCoord && tmpmin<=0.0) {
 1538: 
 1539:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 1540:          // keeping the sum of the shape coordinates equal to 1.
 1541:          // I have tested and compared the new algorithm with the old one, and they give
 1542:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 1543:          // The new algorithm should be faster since it is branchless.
 1544:          const double a = - tmpmin + 1.0e-2;  // XXX it used to be 1.0e-4 in the comments of the original code
 1545:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 1546:          
 1547:          shpCoords[0] = (shpCoords[0] + a)*b;
 1548:          shpCoords[1] = (shpCoords[1] + a)*b;
 1549:          shpCoords[2] = (shpCoords[2] + a)*b;          
 1550: 
 1551:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 1552:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 1553:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 1554:          }
 1555: 
 1556:          // Update the point coordinates for the new shape coordinates
 1557:          double xcoords[3] = {x0.x, x1.x, x2.x};
 1558:          double ycoords[3] = {x0.y, x1.y, x2.y};
 1559:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 1560: 
 1561:       }
 1562: 
 1563:       // Check if the point is inside the element
 1564:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 1565:    }
 1566:    else {
 1567:       Error("Not implemented yet");
 1568: #ifdef QUADS
 1569:       // Reproject pt in eframe of nel for ics=2
 1570:       if constexpr(ics==1) {
 1571:          xn2 = xt; 
 1572:          yn2 = yt;
 1573:       }
 1574:       else {
 1575:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 1576:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 1577:       }
 1578: 
 1579:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 1580: #endif
 1581:    }
 1582: 
 1583: }
 1584: 
 1585: 
 1586: /**  Interpolate velocities at a given point (xt,yt,zt)
 1587: 
 1588:    @param xt, yt, zt: coordinates of the point to interpolate
 1589:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 1590: 
 1591:    This is done in four steps:
 1592: 
 1593:    1. Find the shape coordinates for the final position in the element.
 1594:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 1595:    3. Perform a *binary search* to find the vertical level containing zt. It will have to interpolate the 
 1596:       z levels at xt, yt at each step.   
 1597:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 1598:       horizontally and vertically.
 1599: **/
 1600: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) {
 1601:    // Interpolate the velocities at the point xt. 
 1602:    // This function works the same for triangular and quadrilateral elements.
 1603:    double shpCoord[4];
 1604: 
 1605: 
 1606:    // First step is to compute the shape coordinates of (xt,yt)
 1607:    computeShapeCoords(toVector2(xt), shpCoord, false);
 1608:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 1609: 
 1610:    // Second step is to find the level that contains zt
 1611:    // Uses a binary search to find the level
 1612:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 1613:    int L = kbe;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 1614:    int R = nvrt - 1;
 1615: 
 1616:    // Get the z coordinates at the nodes of the element at the levels L and R
 1617:    double zLAtNodes[4], zRAtNodes[4];
 1618:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 1619:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 1620: 
 1621:    double zL = interpolate(shpCoord, zLAtNodes);
 1622:    double zR = interpolate(shpCoord, zRAtNodes);
 1623:    
 1624:    // Interpolates vertically the velocities
 1625:    double wght1, wght2;
 1626:    if (xt.z<=zL) {
 1627:       wght1 = 1.0;
 1628:       wght2 = 0.0;
 1629:    }
 1630:    else if (xt.z>=zR) {
 1631:       wght1 = 0.0;
 1632:       wght2 = 1.0;
 1633:    }
 1634:    else {
 1635:       // Perform a binary search to find the levels between L and R that contain xt.z
 1636:       while (R - L > 1) {
 1637:          int M = (L + R) / 2;
 1638: 
 1639:          double zMAtNodes[4];
 1640:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 1641:          double zM = interpolate(shpCoord, zMAtNodes);
 1642:          if (zM < xt.z) 
 1643:          {
 1644:             L = M;
 1645:             zL = zM;
 1646:          }
 1647:          else 
 1648:          {
 1649:             R = M;
 1650:             zR = zM;
 1651:          }
 1652:       }
 1653:       assert(L == R-1);
 1654:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 1655: 
 1656:       wght2 = (xt.z - zL)/(zR - zL);
 1657:       wght1 = 1.0 - wght2;
 1658:    }
 1659: // printf("$$$ wght1 = %f, wght2 = %f, zt = %f, zL = %f, zR = %f\n", wght1, wght2, zt, zL, zR);
 1660: // printf("$$$ shpCoord = %f, %f, %f, %f\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 1661:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 1662:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 1663: 
 1664:    // Neither of the interpolated velocities should be NaN
 1665:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 1666: 
 1667: }
 1668: 
