  143: // Polynomial class
  144: template<int grade>
  145: struct Polynomial {
  146:     // Static assertion to give a clear error message at compile time
  147:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  148: };
  149: 
  150: 
  151: // Explicit specialization for grade 4
  152: template<>
  153: struct Polynomial<4> {
  154:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  155: 
  156:    // Constructor from coefficients
  157:    __device__ __host__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  158: 
  159:    __device__ __host__ __forceinline__ double eval(double x) const {
  160:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  161:    }
  162: };
