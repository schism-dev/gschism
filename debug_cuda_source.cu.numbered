  981:    double h_c; 
  982:    int    kz;
  983:    double theta_b;
  984:    double theta_f, sinh_theta_f;
  985:    double *sigma_lcl;
  986:    double *sigma;
  987:    double *ztot;
  988:    double *cs;
  989:    double *dcs;
