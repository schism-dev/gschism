  119: // VECTOR/POINT operations ---------------------------------------------------------------------------
  120: 
  121: using Vector2 = double2; 
  122: using Vector3 = double3;
  123: using Point2  = double2;
  124: using Point3  = double3;
  125: 
  126: __device__ __host__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
  127:     return make_double2(a.x + b.x, a.y + b.y);
  128: }
  129: 
  130: __device__ __host__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
  131:     a.x += b.x;
  132:     a.y += b.y;
  133:     return a;
  134: }
  135: 
  136: __device__ __host__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
  137:     return make_double2(a.x - b.x, a.y - b.y);
  138: }
  139: 
  140: __device__ __host__ __forceinline__ double2 operator-=(double2& a, const double2& b) {
  141:     a.x -= b.x;
  142:     a.y -= b.y;
  143:     return a;
  144: }
  145: 
  146: __device__ __host__ __forceinline__ double2 operator*(const double2& v, const double s) {
  147:     return make_double2(v.x * s, v.y * s);
  148: }
  149: 
  150: __device__ __host__ __forceinline__ double2 operator*(const double s, const double2& v) {
  151:     return v * s;  // reuse the previous operator
  152: }
  153: 
  154: __device__ __host__ __forceinline__ double2 operator/(const double2& v, double s) {
  155:     return make_double2(v.x / s, v.y / s);
  156: }
  157: 
  158: __device__ __host__ __forceinline__ double length(const double2& v) {
  159:     return sqrt(v.x*v.x + v.y*v.y);
  160: }
  161: 
  162: __device__ __host__ __forceinline__ double2 normalize(const double2& v) {
  163:     return v / length(v);
  164: }
  165: 
  166: __device__ __host__ __forceinline__ double dot(const double2& v, const double2& w) {
  167:     return v.x*w.x + v.y*w.y;
  168: }
  169: 
  170: __device__ __host__ __forceinline__ double cross(const double2& v, const double2& w) {
  171:     return v.x*w.y - v.y*w.x;
  172: }
  173: 
  174: __device__ __host__ __forceinline__ double3 operator+(const double3& a, const double3& b) {
  175:     return make_double3(a.x + b.x, a.y + b.y, a.z + b.z);
  176: }
  177: 
  178: __device__ __host__ __forceinline__ double3 operator+=(double3& a, const double3& b) {
  179:     a.x += b.x;
  180:     a.y += b.y;
  181:     a.z += b.z;
  182:     return a;
  183: }
  184: 
  185: __device__ __host__ __forceinline__ double3 operator-(const double3& a, const double3& b) {
  186:     return make_double3(a.x - b.x, a.y - b.y, a.z - b.z);
  187: }
  188: 
  189: __device__ __host__ __forceinline__ double3 operator*(const double3& v, double s) {
  190:     return make_double3(v.x * s, v.y * s, v.z * s);
  191: }
  192: 
  193: __device__ __host__ __forceinline__ double3 operator*(double s, const double3& v) {
  194:     return v * s;
  195: }
  196: 
  197: __device__ __host__ __forceinline__ double3 operator/(const double3& v, double s) {
  198:     return make_double3(v.x / s, v.y / s, v.z / s);
  199: }
  200: 
  201: __device__ __host__ __forceinline__ double dot(const double3& v, const double3& w) {
  202:     return v.x*w.x + v.y*w.y + v.z*w.z;
  203: }
  204: 
  205: __device__ __host__ __forceinline__ Vector2 toVector2(const double3& v) {
  206:     return make_double2(v.x, v.y);
  207: }
  208: 
  209: __device__ __host__ __forceinline__ double3 toVector3(const double2& v, double w) {
  210:     return make_double3(v.x, v.y, w);
  211: }
  212: 
  213: __device__ __host__ __forceinline__ Point2 toPoint2(const double3& p) {
  214:     return make_double2(p.x, p.y);
  215: }
  216: 
  217: __device__ __host__ __forceinline__ Point3 toPoint3(const double2& p, double z) {
  218:     return make_double3(p.x, p.y, z);
  219: }
