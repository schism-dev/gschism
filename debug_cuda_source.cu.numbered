  510: 
  511:    __device__ void trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
  512:                                        double &dt, Point3 &xt, double zint, Vector3 &u_int);
  513:     
  514:    __device__ bool trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
  515:                                                  Element *&nextElem, int &jlev, double &dt);
  516: 
