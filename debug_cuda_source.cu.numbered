 2840: __device__ void computeElevationBoundaryConditions(double ramp, double time) {
 2841:    // Compute elevation essential boundary conditions 
 2842: 
 2843:    NodeBoundary *nodeBnd = NODE_BND_PTR; // A boundary node
 2844: 
 2845:    const Node *node = nodeBnd->node;
 2846:    const int iettype = nodeBnd->iettype;
 2847: 
 2848:    double eic = 0.0;
 2849:    if (nramp_elev==1) eic = nodeBnd->etaic;
 2850:    else               eic = 0.0;
 2851: 
 2852:    const double r_eic = (1.0 - ramp)*eic; 
 2853:    const double r_eth = ramp*nodeBnd->eth;
 2854:    double eta1_bar = r_eic;
 2855: 
 2856:    // Compute tide elevation
 2857:    if (iettype == 3 || iettype == 5) {
 2858:      
 2859:       // XXX IMPLEMENT TIDE THINGS
 2860:       assert(true && "Tide elevation not implemented");
 2861:       // for (int jfr=0; jfr<nbfr; jfr++) { // For all tide frequencies
 2862:       //    const int ncyc = int(amig[jfr]*time/(2.0*pi));
 2863:       //    const double arg = amig[jfr]*time - 2.0*pi*ncyc + face[jfr] - efa[i,j,jfr];
 2864:       //    eta1_bar += ramp*ff[jfr]*emo[i,j,jfr]*cos(arg);
 2865:       // } // for jfr
 2866:    } // if iettype
 2867: 
 2868:    switch (iettype) {
 2869:       case 1:
 2870:       case 2:
 2871:          nodeBnd->elbc = r_eth + r_eic;
 2872:          break;
 2873:       case 3:
 2874:          nodeBnd->elbc = eta1_bar + r_eic;
 2875:          break;
 2876:       case 4:
 2877:          nodeBnd->elbc = r_eth + r_eic;
 2878:          break;
 2879:       case 5:
 2880:          nodeBnd->elbc = r_eth + eta1_bar + r_eic;
 2881:          break;
 2882:    } // switch
 2883: 
 2884: 
 2885:    //Add inverse barometric effects
 2886:    if (iettype != 0 && inv_atm_bnd == 1) {
 2887:       nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 2888:    }
 2889: 
 2890: }
