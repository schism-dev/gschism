 3279:    __global__ void computeElevationBoundaryConditions(double time) {
 3280:       // Compute elevation essential boundary conditions 
 3281: 
 3282:       NODE_BND(nodeBnd); // Each boundary node.
 3283: 
 3284:       const Node *node = nodeBnd->node;
 3285:       const int iettype = nodeBnd->iettype;
 3286: 
 3287:       double eic = 0.0;
 3288:       if (nramp_elev==1) eic = nodeBnd->etaic;
 3289:       else               eic = 0.0;
 3290: 
 3291:       const double r_eic = (1.0 - ramp)*eic; 
 3292:       const double r_eth = ramp*nodeBnd->eth;
 3293:       double eta1_bar = r_eic;
 3294: 
 3295:       // Compute tide elevation
 3296:       if (iettype == 3 || iettype == 5) {
 3297:         
 3298:          // XXX IMPLEMENT TIDE THINGS
 3299:          assert(false && "Tide elevation not implemented");
 3300:          // for (int jfr=0; jfr<nbfr; jfr++) { // For all tide frequencies
 3301:          //    const int ncyc = int(amig[jfr]*time/(2.0*pi));
 3302:          //    const double arg = amig[jfr]*time - 2.0*pi*ncyc + face[jfr] - efa[i,j,jfr];
 3303:          //    eta1_bar += ramp*ff[jfr]*emo[i,j,jfr]*cos(arg);
 3304:          // } // for jfr
 3305:       } // if iettype
 3306: 
 3307:       switch (iettype) {
 3308:          case 1:
 3309:          case 2:
 3310:             nodeBnd->elbc = r_eth + r_eic;
 3311:             break;
 3312:          case 3:
 3313:             nodeBnd->elbc = eta1_bar + r_eic;
 3314:             break;
 3315:          case 4:
 3316:             nodeBnd->elbc = r_eth + r_eic;
 3317:             break;
 3318:          case 5:
 3319:             nodeBnd->elbc = r_eth + eta1_bar + r_eic;
 3320:             break;
 3321:       } // switch
 3322: 
 3323: 
 3324:       //Add inverse barometric effects
 3325:       if (iettype != 0 && inv_atm_bnd == 1) {
 3326:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 3327:       }
 3328: 
 3329:    }
 3330: 
 3331:    __global__ void computeVerticallyIntegratedVelocity(void) {
 3332: 
 3333:       SIDE(side);
 3334: 
 3335:       printf("computeVerticallyIntegratedVelocity: side = %p, side->idx = %d\n", side, side->idx);
 3336: 
 3337:       side->U = {0.0, 0.0}; 
 3338:          
 3339:       if(side->isDry) return;
 3340: 
 3341:       const Node *node1 = side->n1;
 3342:       const Node *node2 = side->n2;
 3343: 
 3344:       // Vertically integrated velocity U (in ll if ics=2)
 3345:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 3346:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 3347:       }
 3348: 
 3349:    }
 3350: 
 3351:    __global__ void computeBottomDragVegetation(void) {
 3352:       // UNFINISHED. CHECK THIS:
 3353:       // How many kernels are needed? Why so many for loops?
 3354:       // Is the loop on sides needed?
 3355: 
 3356:       NODE(node);
 3357: 
 3358:       const int    kb      = node->kb;
 3359:       const double htot    = node->htot();
 3360:       const double rough   = node->rough;
 3361: 
 3362: 
 3363:       if (node->isDry) {
 3364:          // Default values for dry nodes
 3365:          node->veg_alpha_vert_mean = node->veg_alpha0;
 3366:          /// XXX CHECK INDICES
 3367:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 3368:       }
 3369: 
 3370:       // Compute bottom drag Cd
 3371:       //--------------------------------
 3372: 
 3373:       // nchi = {-1, 0, 1} is the type of bottom drag.
 3374:       if (nchi==1) {
 3375: 
 3376:          bool ltmp = false; // for WBL iteration
 3377: 
 3378:          // Cdmax=-1 !max. Cd at node for this process (info only)
 3379:          // Drag at nodes
 3380:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 3381:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 3382:         
 3383:          const double rough = node->rough;
 3384:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3385:          if (node->rough == 0.0) {
 3386:             node->Cd = 0.0;
 3387: 
 3388:          } else { //roughness >0 
 3389:             
 3390:             const double bthick_ori = node->znl[kb + 1] - node->znl[kb];  // thickness of bottom bnd layer
 3391:             const double bthick = max(dzb_min, bthick_ori);
 3392: 
 3393:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 3394: 
 3395:             double tmp = 1.0/(2.5*log(bthick/rough));
 3396:             node->Cd = tmp*tmp;
 3397: 
 3398:          } // if rough
 3399: 
 3400: 
 3401:          // RECOVER THIS: XXX
 3402:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 3403:          // Output warning for WBL if iteration didn't converge
 3404: 
 3405: 
 3406:       } // nchi==1
 3407: 
 3408:       //   Bottom stress in m^2/s^2
 3409:       if (node->rho[kb + 1] >= -98.0)
 3410:       {
 3411:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 3412:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 3413:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 3414:          // !sediment erosion: this part needs more documentation
 3415:       }
 3416: 
 3417:     
 3418:       // Compute vegetation parameters
 3419:       //--------------------------------
 3420: 
 3421:       // SAV constants
 3422:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 3423:       constexpr double veg_cfpsi = 0.16;
 3424: 
 3425:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 3426:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 3427: 
 3428:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 3429:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 3430:          int kbin = 0; // bin index
 3431:          for (int k = kb; k < nvrt; k++) {
 3432:             // Computes node height above the bottom level
 3433:             const double tmp_h = node->znl[k] - node->znl[kb]; // >=0
 3434:             assert(false && "Vertical variation of vegetation not implemented");
 3435: 
 3436:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 3437:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 3438:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 3439:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 3440:             // } else {
 3441:             //    // Find the bin at which the current vertical level is
 3442:             //    while (kbin<nbins_veg_vert) {
 3443:             //       const double zn = node->znl[kbin];
 3444:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 3445:             //          break;
 3446:             //       } // if
 3447:             //       kbin++;
 3448:             //    } // while
 3449:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 3450: 
 3451:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 3452:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 3453:                
 3454:             //    // Linear interpolation of the vegetation parameters
 3455:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 3456:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 3457:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 3458:             // } // if rl10
 3459: 
 3460:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 3461: 
 3462:          } // for k
 3463: 
 3464: 
 3465:       } else { // Ganthy (iveg=2)
 3466:       //  Modify canopy height, diameter, and density
 3467: 
 3468:          // Make sure there is vegetation on this node
 3469:          if (node->veg_h_unbent > 0.0) {
 3470:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 3471: 
 3472:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 3473:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 3474:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 3475: 
 3476:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 3477:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 3478:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 3479:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 3480:          } // if veg_h_unbent
 3481: 
 3482:          for (int k = 0; k < nvrt; k++) {
 3483:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 3484:          } // for k
 3485:       
 3486: 
 3487:       } // if iveg
 3488:      
 3489:          
 3490: 
 3491:       // Compute vertical mean of veg_alpha3D
 3492:       if (iveg != 0) {
 3493:          const double ztop = node->zTopCanopy(); // Top of the canopy
 3494:          double sum1=0.0;
 3495:          double sum2=0.0;
 3496:          // Integrate over each level under the canopy...
 3497:          for (int k=kb; k<nvrt-1 && node->znl[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 3498:             const double Dz = node->Dz(k);
 3499: 
 3500:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 3501:             sum2 += Dz;
 3502: 
 3503:          } // for k
 3504: 
 3505:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 3506:          else             node->veg_alpha_vert_mean = sum1/sum2;
 3507: 
 3508:       } // if iveg
 3509: 
 3510:       printf("computeBottomDragVegetation: nodeIdx = %d, node->veg_alpha_vert_mean = %f\n", node->idx, node->veg_alpha_vert_mean);
 3511: 
 3512:    }
 3513: 
 3514:    __global__ void computeVegetationAndDragParameters(void) {
 3515:       // Computes the vegetation and drag model parameters:
 3516:       // chi, \tilde\chi, beta, \breve{H}
 3517:       
 3518:       SIDE(side);
 3519: 
 3520:       const double htot = side->htot();
 3521:       const int    kb   = side->kb;
 3522: 
 3523:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 3524: 
 3525:       const double veg_h     = side->veg_h();
 3526:       const double veg_nv    = side->veg_nv();
 3527:       const double veg_c     = side->veg_c();
 3528:       const double veg_beta  = side->veg_beta;
 3529:       const double veg_alpha = side->veg_alpha_vert_mean();
 3530: 
 3531:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 3532:       // Velocity magnitude at the bottom level
 3533:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 3534:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 3535:       side->chi2 = side->Cd()*vmag1;
 3536:       side->chi  = side->chi2;
 3537:       if constexpr(iveg != 0) {
 3538:          const Node *n1 = side->n1;
 3539:          const Node *n2 = side->n2;
 3540:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 3541:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 3542:       }
 3543: 
 3544:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 3545: 
 3546:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 3547:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 3548:       double magUa = 0.0;
 3549:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 3550:          // 3D wet side with veg...
 3551: 
 3552:          double magUa = 0.0;
 3553:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 3554:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 3555: 
 3556:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 3557:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 3558:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 3559: 
 3560:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 3561:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 3562: 
 3563:                // Velocity magnitude at the bottom (l) of the level
 3564:                const double ul = length(side->u2[k]);
 3565: 
 3566:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 3567:                magUa += Dz*0.5*(uh + ul);
 3568: 
 3569:             } // if HasVegetation
 3570:          } // for k
 3571:          const double ua = magUa/min(htot, veg_h); // Vertical average
 3572: 
 3573:          // Computes beta, used for computing the stress term at the top of the canopy.      
 3574:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 3575:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 3576:             const double zCpy = side->zTopCanopy();
 3577:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 3578:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 3579:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 3580:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 3581:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 3582:          } // if isSubmerged
 3583:       } // if iveg   
 3584: 
 3585:       // Computes the friction modified depth, \breve{H} in notes
 3586:       if (side->is2D()) { // 2D
 3587: 
 3588:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 3589:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 3590: 
 3591:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 3592: 
 3593:          side->hhat = htot*htot/fricH; 
 3594: 
 3595:       } else { // 3D
 3596:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 3597: 
 3598:          if constexpr(iveg != 0) {
 3599:             
 3600:             if (side->isSubmerged()) { 
 3601:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 3602:                side->hhat -= veg_c*Hhat_alpha;
 3603: 
 3604:             } else { // Emergent
 3605:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 3606:             }
 3607:          } // if iveg
 3608: 
 3609:          // Enforce positivity for 3D model
 3610:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 3611:       } // if 3D
 3612: 
 3613:       printf("computeVegetationAndDragParameters: sideIdx = %d, side->htot = %f, side->hhat = %f\n", side->idx, side->htot(), side->hhat);
 3614: 
 3615:         
 3616:    }
 3617: 
 3618: 
 3619: 
 3620:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 3621:    // Computes the density gradient between two elements, e1 and e2.
 3622:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 3623:    // zero in the direction normal to the side. 
 3624:    // 
 3625:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 3626:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 3627:    //
 3628:    // Input:
 3629:    //    e1: Element
 3630:    //    e2: Neighbor element (or nullptr if boundary)
 3631:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 3632:    //    k: Index of the half-level at which the density is interpolated
 3633:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 3634:    // 
 3635:    // Output:
 3636:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 3637:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 3638: 
 3639:       if (e2 == nullptr || e2->isDry) {
 3640:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 3641: 
 3642:          Side *side = e1->sides[j];
 3643:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 3644:                  
 3645:          if constexpr(ics == 1) {
 3646:             vec = side->n; // Normal vector to the side
 3647:          } else {
 3648:             // IMPLEMENT THIS XXXXXX
 3649:             // !replace with xel, yel?
 3650:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 3651:             //      &eframe(:,:,i),xn1,yn1,tmp)
 3652:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 3653:             //      &eframe(:,:,i),xn2,yn2,tmp)
 3654:          } //ics
 3655:                    
 3656:          diffRho = 0.0;
 3657: 
 3658:       } else { //internal and wet
 3659:          if constexpr(ics==1) {
 3660:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 3661: 
 3662:             // Vector from e1 to e2
 3663:             vec = toVector2(e2->center - e1->center);
 3664: 
 3665:          } else { 
 3666:             // IMPLEMENT THIS XXXXXX
 3667:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 3668:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 3669:             //                   alow(j)=xctr2
 3670:             //                   bdia(j)=yctr2
 3671:          } // ics
 3672: 
 3673:          diffRho = rho2 - e1->demeanedDensity(k);
 3674:       }
 3675: 
 3676:    }
 3677: 
 3678:    __global__ void computeDensityCubicSplines(void) {
 3679:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 3680: 
 3681:       ELEM(elem);
 3682: 
 3683:       if (elem->isDry) return;
 3684: 
 3685:       const int kb = elem->kb;
 3686: 
 3687:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 3688:       if (elem->is2D()) {
 3689:          // In the 2D case, the density is constant at the prism level. 
 3690:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 3691:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 3692:       } else { //3D
 3693: 
 3694:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 3695:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 3696:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 3697:          ///// XXXX CHECK INDICES!!!!!
 3698:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 3699:       } // 2D/3D
 3700: 
 3701:    }
 3702: } // extern "C"
 3703: 
 3704: 
 3705: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 3706: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 3707: 
 3708:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 3709: 
 3710:    const int kb  = elem->kb;
 3711:    const int kb2 = elem2->kb;
 3712: 
 3713:    // z-coordinate of prism of elem
 3714:    const double zp = elem->z_prism(k);
 3715: 
 3716:    double rho = 0.0;
 3717: 
 3718:    if (elem2->is2D()) {
 3719:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 3720: 
 3721:    } else {  // 3D
 3722: 
 3723:       // eta_min may be < zmax
 3724:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 3725:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 3726: 
 3727:       // (Extrapolate density below bottom, we will fix it later)
 3728:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 3729:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 3730:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 3731:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 3732:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 3733:    } // 2D/3D
 3734:      
 3735: 
 3736:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 3737:    // Now we need to fix it.
 3738:    if (elem->z[k] < elem2->z[kb2]) {
 3739:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 3740: 
 3741:       // There are two methods to adjust the density at the bottom of the element.
 3742:       // iunder_deep=0: 
 3743:       const double depth1 = abs(elem->z[kb]); // larger depth
 3744: 
 3745:       if (iunder_deep==0) {
 3746: 
 3747:          const double weight = max(0.0, min(1.0, (depth1 - h1_bcc)/(h2_bcc - h1_bcc))); // weight
 3748: 
 3749:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 3750: 
 3751:       } else { // iunder_deep != 0
 3752: 
 3753:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 3754: 
 3755:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 3756: 
 3757:          //   Demeaned density at the same z coordinate as
 3758:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 3759:          }
 3760: 
 3761:       } // if iunder_deep
 3762:    } // if elem->z[kb] < elem2->z[kb]
 3763: 
 3764:    return rho;
 3765: }
 3766: 
 3767: 
 3768: extern "C" {
 3769:    __global__ void computeDensityGradient(void) {
 3770: 
 3771:          // Compute the horizontal density gradient at each element.
 3772:       // It works in two steps:
 3773:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 3774:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 3775:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 3776:       //             gradRho.r1 = rho1 - rho0
 3777:       //             gradRho.r2 = rho2 - rho0
 3778:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 3779:       // 
 3780:       //  NOTE: We use de-meaned densities.
 3781: 
 3782:       ELEM(elem);
 3783: 
 3784:       if (elem->isDry) return;
 3785: 
 3786:       const int kb  = elem->kb;
 3787:       const int i34 = elem->i34;
 3788: 
 3789:       for (int k = kb + 1; k < nvrt; k++) {
 3790:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 3791:          //             gradRho.r1 = rho1 - rho0
 3792:          //             gradRho.r2 = rho2 - rho0
 3793:          int icount = 0;
 3794:          double sumRx = 0.0;
 3795:          double sumRy = 0.0;
 3796:          for (int j1=0; j1<i34; j1++) { 
 3797: 
 3798:             const int j2 = elem->nxq(j1 + 1);
 3799: 
 3800:             // Pairs of consecutive neighbor elements of elem
 3801:             const Element *e1 = elem->nghbElems[j1];
 3802:             const Element *e2 = elem->nghbElems[j2];
 3803: 
 3804:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 3805:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 3806:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 3807: 
 3808:             // Compute the density difference and the vector from elem to e1 and e2
 3809:             // getRhoDiffAndVec takes into account boundaries/dry elements
 3810:             double diffRho1, diffRho2;
 3811:             Vector2 vec1, vec2;
 3812:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 3813:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 3814: 
 3815:             const double rl1 = length(vec1);
 3816:             const double rl2 = length(vec2);
 3817:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 3818: 
 3819:             const double delta = cross(vec1, vec2);
 3820:             const double sintheta = abs(delta)/(rl1*rl2);
 3821: 
 3822:             // To avoid problems, avoid elements with small angle between vectors
 3823:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 3824:             const bool validEq = (sintheta > sin_one_deg);
 3825: 
 3826:             if (validEq) {
 3827:                // Solve the system of equations to get the density gradient at elem
 3828:                icount++;
 3829:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 3830:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 3831:                sumRx += Rx;
 3832:                sumRy += Ry;
 3833:             }
 3834:          } // for j1
 3835: 
 3836:          // Compute the average density gradient at elem
 3837:          if (icount==0) {
 3838:            // Bad mesh quality; bail out with 0 b-cc
 3839:            elem->gradRho[k] = {0.0, 0.0};
 3840:          } else {
 3841:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 3842:          }
 3843: 
 3844:       } // for k
 3845: 
 3846:    }
 3847: 
 3848:    __global__ void computeBaroclinicTerm(void) {
 3849:    // Computes the baroclinic term at sides (at half levels).
 3850:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 3851:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 3852: 
 3853:       SIDE(side);
 3854: 
 3855:       if (side->isDry) return;
 3856: 
 3857:       const Element *e1 = side->elems[0];
 3858:       const Element *e2 = side->elems[1];      
 3859:       const int kb = side->kb;
 3860:       
 3861:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 3862: 
 3863:       // interpolates vertically the density gradient of the two elements at the half level/
 3864: 
 3865:       // Starts the integration at the surface and goes down to the bottom
 3866:       int k1 = nvrt - 1;
 3867:       int k2 = nvrt - 1;
 3868: 
 3869:       side->bcc[nvrt-1] = {0.0, 0.0};
 3870:       for (int k = nvrt-1; k >= kb; k--) {
 3871:       // For each prism level (from surface to bottom)...
 3872: 
 3873:          // For both elements, interpolate density gradient at the side's half level.
 3874:          // The gradient at the side is the average of the gradients at the elements.
 3875:          // w1, w2 are used to take into account boundary sides, with just one element.
 3876:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 3877:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 3878:          const double wsum = w1 + w2;
 3879:          w1 = w1/wsum;
 3880:          w2 = w2/wsum;
 3881:          printf("w1 = %f, w2 = %f\n", w1, w2);
 3882:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 3883: 
 3884:          // Linear interpolation of both elements' density gradient at the shared side's level.
 3885:          Vector2 gradRho = {0.0, 0.0};
 3886:          if (e1 != nullptr && k > kb) {
 3887:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 3888:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 3889:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 3890:             
 3891:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 3892:          }      
 3893:          if (e2 != nullptr && k > kb) {
 3894:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 3895:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 3896:             
 3897:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 3898:          }
 3899: 
 3900:          if constexpr(ics==2) {
 3901:             // IMPLEMENT THIS XXXXXX
 3902:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 3903:             // swild(1)=tmp1
 3904:             // swild(2)=tmp2
 3905:          }
 3906:          
 3907:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 3908:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 3909:          // CHECK INDICES!!! XXX
 3910:          const double grav3 = 0.5*(side->n1->grav2 + side->n2->grav2);
 3911:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 3912:       } // for
 3913: 
 3914:    }
 3915: 
 3916: } // extern "C"
 3917: 
 3918: #ifdef DONTCOMPILE
 3919: __device__ void computeVerticalAdvection(void) {
 3920:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 3921: 
 3922:    sdbt(1:2,:,:)=0.d0
 3923: 
 3924:    const Side *side = FROM kernel;
 3925: 
 3926:    if(side->isDry) return;
 3927: 
 3928:    // If side is wet...
 3929: 
 3930: 
 3931:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 3932:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 3933:    double ws[nvrt] = {} // w @ side
 3934:    int icount = 0;
 3935:    for (int j=0; j<2; j++) {
 3936:       const Element *elem = side->elements[j];
 3937:        
 3938:       if(elem != nullptr) {
 3939:          icount++;
 3940:          for (int k=0; k<nvrt; k++) {
 3941:             ws[k] = ws[k] + elem->w[k];
 3942:          }
 3943:       }
 3944:    }  // for j
 3945: 
 3946:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 3947:    ws = ws/icount;
 3948: 
 3949:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 3950:    // Splines allow for a smooth transition between vertical levels.
 3951:    // Splines have continuity restrictions at the internal knots, but
 3952:    // we have to provide the 1st derivatives at the endpoints.
 3953:    const int kbs = side->kbs; 
 3954:    
 3955:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3956:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3957:    initCubicSpline(kbs, nvrt, side, ws, up)
 3958: 
 3959:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3960:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3961:    initCubicSpline(kbs, nvrt, side, ws, vp)
 3962: 
 3963:    // Total advection (average onto side)
 3964:    const Node *node1 = side->nodes[0];
 3965:    const Node *node2 = side->nodes[1];
 3966:    for (int k=kbs(i); k<nvrt; k++) {
 3967: 
 3968:       if constexpr(ics==1) {
 3969:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 3970:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 3971:       } else {
 3972:          // XXX IMPLEMENT THIS
 3973:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 3974:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 3975:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 3976:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 3977:       }  // if ics
 3978: 
 3979: 
 3980:    }
 3981: }
 3982: #endif
 3983: 
 3984: 
 3985: extern "C" {
 3986:    __global__ void computeElemAverageGhat(void) {
 3987:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 3988: 
 3989:       ELEM(elem);
 3990:       
 3991:       elem->ghat1= {0.0, 0.0};  
 3992: 
 3993:       if constexpr(ihydraulics != 0) {
 3994:          if (nhtblocks > 0 && elem->isblock) return;
 3995:       }
 3996: 
 3997:       if (elem->isDry) return;
 3998: 
 3999:       // Wet elements.
 4000:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 4001:       // tidal potential, horizontal diffusion, and baroclinic etc
 4002:       // Remember to update both fb and F 
 4003:       // If ics=2, ghat1 are in eframe (ll)
 4004:       // cff1-3: coefficients for 2D/3D
 4005:       Vector2 gradEta = {0.0, 0.0};  // \nabla \eta
 4006:       Vector2 gradPr  = {0.0, 0.0};  // \nabla pressure
 4007:       Vector2 gradETP = {0.0, 0.0};  // \nabla etp
 4008: 
 4009:       double av_cff1 = 0.0;  // av. for cff1
 4010:       double av_cff2 = 0.0;  // av. for cff2
 4011:       double av_cff3 = 0.0;  // av. for cff3
 4012:       double av_df = 0.0;  // av. for H^\alpha / H
 4013:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 4014:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 4015: 
 4016:       const int i34 = elem->i34;
 4017:       const int kb = elem->kb;
 4018: 
 4019:       for (int j=1; j<i34; j++) {
 4020:          // For each node and side in the element...
 4021: 
 4022:          const Node *node = elem->nodes[j];
 4023:          const Side *side = elem->sides[j];
 4024: 
 4025:          const double chi      = side->chi;
 4026:          const double veg_c2   = side->veg_c2;
 4027:          const double veg_beta = side->veg_beta;
 4028:          const double veg_h    = side->veg_h();
 4029:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 4030: 
 4031:          // Node - const in elem
 4032:          gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 4033:          gradPr  += node->pr  *elem->gradPhi[j];
 4034: 
 4035:          if (elem->depth >= tip_dp) {
 4036:            gradETP += node->ETP*elem->gradPhi[j];
 4037:          }
 4038: 
 4039:          
 4040:          const double htot  = side->htot();        // Total depth at the side
 4041:          const double zctr2 = side->zTopCanopy();  
 4042: 
 4043:          double cff1; 
 4044:          double cff2; 
 4045:          double cff3;   
 4046:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 4047:          // coefficients applied to 2D/3D case 
 4048:             cff1 = side->hhat/htot;
 4049:             cff2 = 0.0;
 4050:             cff3 = 0.0;
 4051:          } else { //3D
 4052:             //Init for no-veg case
 4053:             cff1 = 1.0;
 4054:             cff2 = 1.0;
 4055:             cff3 = 0.0;
 4056: 
 4057:             if constexpr(iveg != 0) {
 4058:                // Computes coefficients used with vegetation terms G1, G2
 4059:                // cff1, cff3 are used for the first two terms in G1, G2:
 4060:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 4061:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 4062:                // In general, cff1*Ustar - cff3*Ustar_alpha
 4063:                if(veg_h < 0.99*htot) { // submergent vegetation
 4064:                   cff1=1;
 4065:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 4066:                   cff3 = veg_c;
 4067: 
 4068:                } else { // emergent vegetation
 4069:                   cff1 = 1.0/(1.0 + veg_c2);
 4070:                   cff2 = cff1;
 4071:                   cff3 = 0.0;
 4072: 
 4073:                }
 4074:             } // if iveg
 4075:          } //  2D/3D
 4076: 
 4077:          av_cff1 += cff1/i34;
 4078:          av_cff2 += cff2/i34;
 4079:          av_cff3 += cff3/i34;
 4080:          av_cff2_chi += cff2*chi/i34;
 4081:          av_cff3_chi += cff3*chi/i34;
 4082:          av_df += min(htot, veg_h)/(htot*i34);
 4083: 
 4084: 
 4085:          // btrack values: U^\star, U^{\star\alpha}
 4086:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 4087:          Vector2 Ustar       = {0.0, 0.0}; 
 4088:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 4089:          for (int k = side->kb; k < nvrt; k++) {
 4090:             if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 4091:                Ustar += side->btu[nvrt]*side->Dz(k);
 4092: 
 4093:             } else { //3D
 4094:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 4095:                Ustar += w2;
 4096: 
 4097:                if constexpr(iveg != 0) {
 4098:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 4099:                        const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k)); // For the top of the canopy, ratio of the level that is below the canopy
 4100:                        Ustar_alpha += zrat*w2; // XXXX
 4101:                    }
 4102:                }  // if iveg
 4103:             }  //2/3D
 4104:          }  //k
 4105:          
 4106: 
 4107:          // Add btrack & surface stress terms to \breve{G} first
 4108:          if constexpr(ics==1) {
 4109:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 4110:          } else {
 4111:             // XXX IMPLEMENT THIS
 4112:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 4113:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 4114:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 4115:          }  // if ics
 4116: 
 4117:          // Surface and bottom stress terms
 4118:          if constexpr(ics==1) {
 4119:             const Vector2 tau    = side->tau();
 4120:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 4121: 
 4122:             // Term for surface and bottom stress
 4123:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 4124:          } else {
 4125:             // XXX IMPLEMENT THIS
 4126:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 4127:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 4128:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 4129:             // tau_x=(vn1+tt1)/2.d0
 4130:             // tau_y=(vn2+ss1)/2.d0
 4131:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 4132:          }  // if ics
 4133: 
 4134:          
 4135: 
 4136:          // All terms in F,F^\alpha,f_b except baroclinic
 4137:          // F, f_b: all explicit terms excluding vegetation 
 4138:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 4139:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 4140:          const double coriolis = side->coriolis;
 4141:          Vector2 F  =  coriolis*side->U;  // F_x
 4142:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 4143:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 4144: 
 4145:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 4146:             
 4147:             for (int k = side->kb; k < nvrt; k++) {
 4148:                if (zctr2 > side->zc[k-1]) {
 4149:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 4150:                    const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 4151:                    Fa +=  coriolis*w2*zrat;
 4152:                } // if zctr2
 4153:             } // k
 4154:          } // iveg
 4155: 
 4156:          // Integrate horizontal viscosity force vertically
 4157:          for (int k=side->kb + 1; k<nvrt; k++) {
 4158:             const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.0; 
 4159: 
 4160:             F += levelHorVisc;
 4161: 
 4162:             // Vegetation term
 4163:             if constexpr(iveg!=0) {
 4164:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 4165:                   const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 4166:                   Fa += levelHorVisc*zrat;
 4167:                } 
 4168:             } // if iveg
 4169:          } // for k
 4170: 
 4171:          fb += side->d2uv[side->kb];
 4172: 
 4173: 
 4174:          // Add to ghat1
 4175:          if constexpr(ics==2) {
 4176:             // XXX IMPLEMENT THIS
 4177:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4178:             // bigf1=vn1; bigf2=vn2
 4179:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4180:             // botf1=vn1; botf2=vn2
 4181:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4182:             // bigfa1=vn1; bigfa2=vn2
 4183:          } // if ics
 4184: 
 4185:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 4186:       } // for j (nodes and sides)
 4187: 
 4188:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 4189:          
 4190:       // Finish off terms in F, F^\alpha and f_b
 4191:       const double grav3 = elem->mean(&Node::grav2);
 4192:       const Vector2 fb = grav3*gradETP - gradPr/rho0; //const in each elem
 4193: 
 4194: 
 4195:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 4196:       for (int j=1; j<i34; j++) { 
 4197:          // For each side in the element...
 4198:          const Side *side = elem->sides[j];
 4199:          const double chi = side->chi;
 4200: 
 4201:          const double htot = side->htot();
 4202:          const double veg_h = side->veg_h();
 4203:          const Vector2 F  = htot*fb;
 4204:          const Vector2 Fa = min(htot, veg_h)*fb;
 4205: 
 4206:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 4207:       } // for j
 4208: 
 4209:       //botf1 etc are already in elem frame
 4210:       elem->ghat1 += tmp/i34;
 4211: 
 4212:       // Baroclinic force
 4213:       if constexpr(ibc==0) {
 4214:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 4215: 
 4216:          Vector2 Fa = {0.0, 0.0};
 4217:          Vector2 intGradRho = {0.0, 0.0};
 4218:          
 4219:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 4220:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 4221:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 4222: 
 4223:             // \in F [m^2/s/s]
 4224:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 4225:          }
 4226: 
 4227:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 4228:          const Vector2 F = av_df*Fa; //approx
 4229:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 4230: 
 4231:       } // if ibc
 4232: 
 4233:    }
 4234: 
 4235: } // extern "C"
 4236: 
 4237: 
 4238: 
 4239: #ifdef DONTCOMPILE
 4240: __global__ void checkMassConservation(Tracers* sumtr) {
 4241: 
 4242:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 4243: 
 4244:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 4245: 
 4246:    Element *elem = &(mesh->localElemData[i]);
 4247: 
 4248:    // Skip dry elements
 4249:    if (elem->isDry) return;
 4250: 
 4251:    // Local sum array for this thread
 4252:    double localSum[N_TRACERS] = {0.0};
 4253: 
 4254:    // Sum over vertical levels for this element
 4255:    const int kbe = elem->kbe;
 4256:    const double area = elem->area;
 4257: 
 4258:    for (int k = kbe; k < nvrt; k++) {
 4259:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 4260:       
 4261:       // Accumulate tracer mass
 4262:       for (int tr = 0; tr < N_TRACERS; tr++) {
 4263:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 4264:       }
 4265:    }
 4266: 
 4267:    
 4268: 
 4269:    //  This function returns per element sums. A reduction must be done on the host side.
 4270: }
 4271: 
 4272: 
 4273: __global__ void transport(void) {
 4274: 
 4275:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 4276: 
 4277:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 4278: 
 4279:    Element *elem = &(mesh->localElemData[ie]);
 4280: 
 4281:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 4282: 
 4283:                for (int m=0; m<ntr; m++) {
 4284:                   for (int k=kbe(ie); k<nvrt; k++) {
 4285:                      // Calculate each polynomial's weight 
 4286:                      wm=0.d0; sum1=0.d0; 
 4287:                      wm1=0.d0; wm2=0.d0; 
 4288:                      for (int i=0; i<elem->nweno2; i++) {
 4289:                   
 4290:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4291:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4292:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4293:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4294:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4295:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 4296:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 4297:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 4298:                      // -----------------Hu and Shu (1999)'s method----------------
 4299:                      b4=b1+b2+b3
 4300: 
 4301: //Error: add PRODUCTION CPP
 4302: #ifdef DEBUG
 4303:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 4304:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 4305:                     call parallel_abort(errmsg)
 4306:                   }
 4307: #endif
 4308: 
 4309:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 4310:                   // !----test-------------- 
 4311:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 4312:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 4313:                   // !wm(i)=wm1(i)*wm2(i)
 4314:                   // !---------------------- 
 4315:                   sum1=sum1+wm(i)
 4316:                 } // end for i
 4317: 
 4318:                 wm=wm/sum1
 4319: 
 4320:                 for (int j=0; j<elem->i34; j++) {
 4321: 
 4322:                   const Side *side  = elem->sides[j];
 4323:                   const Node *node1 = side->n1;
 4324:                   const Node *node2 = side->n2;
 4325: 
 4326:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 4327:                      trsd=0.d0
 4328:                      for (int kk=0; kk<nquad; kk++) {
 4329:                         for (int i=0; i<elem->nweno2; i++) {
 4330:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4331:                         } // end for i   
 4332:                      } // end for kk
 4333:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 4334:                   } // outward flux
 4335:                } // end for j=1,i34(ie) ! side
 4336:             }
 4337:          }
 4338:               
 4339: 
 4340: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 4341: //             //   calculate each polynomial's weight 
 4342: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 4343: //                 wm=0.d0; sum1=0.d0
 4344: //                 do i=1,nweno1(ie) !for each polynomial
 4345: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4346: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4347: //                   b1=b1*b1+b2*b2 !smoothness indicator
 4348: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 4349: //                   wm(i)=b2
 4350: //                   sum1=sum1+b2
 4351: //                   !wm(i)=1.d0
 4352: //                   !sum1=sum1+1.d0
 4353: 
 4354: // // Error: PRODUCTION
 4355: // #ifdef DEBUG
 4356: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 4357: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 4358: //                     call parallel_abort(errmsg)
 4359: //                   endif
 4360: // #endif
 4361: 
 4362: //                 enddo !i
 4363: //                 wm=wm/sum1 !final weight
 4364: 
 4365:                 for (int j=0; j<elem->i34; j++) { // side
 4366:                   const Side *side = elem->sides[j];
 4367:                   const Node *node1 = side->n1;
 4368:                   const Node *node2 = side->n2;
 4369: 
 4370:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 4371:                     trsd=0.d0
 4372:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 4373:                       for (int i=0; i<elem->nweno1; i++) {
 4374:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 4375:                       }
 4376:                     enddo //kk
 4377:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 4378:                   } // outward flux
 4379:                 } // end for j=1,i34(ie) ! side
 4380:               } // end for k; ntr 
 4381: 
 4382:             else !simple upwind method
 4383:               do j=1,i34(ie)
 4384:                 jsj=elside(j,ie)
 4385:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 4386:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 4387:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 4388:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 4389:                   endif
 4390:                 enddo  !vertical layers
 4391:               enddo !j=1,i34(ie) ! side
 4392:             endif !order of accuracy
