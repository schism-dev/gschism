 1802: /**
 1803:  * This method performs backtracking from the side center until a time -dt back in time 
 1804:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 1805:  * intermediate point.
 1806:  *
 1807:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 1808:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 1809:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 1810:  * remaining time.
 1811:  * 
 1812:  * NOTE: Runge-Kutta is not implemented yet. XXX
 1813:  * 
 1814:  * @param uuint, vvint, wwint: Velocities at the final point
 1815:  * @param jlev: Level at which the backtracking is performed
 1816:  * @param dt, dtbk: Tracking timesteps
 1817:  * @param sclr: Array for backtracked values
 1818:  * @return: True if the backtracking was successful, false otherwise
 1819:  */
 1820: __inline__ __device__ bool Side::btrack(
 1821:       int jlev,
 1822:       double dt,            // Tracking time
 1823:       double dtbk,          // Tracking timestep
 1824:       double* sclr,         // Array for backtracked values
 1825:       Vector3 &u_int
 1826: ) const {
 1827: 
 1828:    // Start from side center
 1829:    Point3 x0 = {center.x, center.y, zc[jlev]};
 1830:  
 1831: 
 1832:    double time_rm = dt; // Remaining time
 1833: 
 1834: 
 1835:    // // Initialize outputs XXX
 1836:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 1837:    //    sclr[i] = 0.0;
 1838:    // }
 1839: 
 1840: 
 1841:    // Initial velocities
 1842:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 1843: 
 1844:    // Find the element that is in the direction opposite to the velocity
 1845:    Element* curElem = findElementTowards({u_int.x, u_int.y});
 1846: 
 1847: 
 1848:    const int MAX_ITERATIONS = 1000; 
 1849:    Element* nextElem = curElem;
 1850:    int iter = 0;
 1851:    while(true) {
 1852:       // Calculate timestep
 1853:       double dtb = min(dtbk, time_rm);
 1854: 
 1855:       // Next point in the backtracking curve
 1856:       Point3 xt = x0 - dtb*u_int;
 1857: 
 1858:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb);
 1859:       assert(found && "Backtracking failed in btrack");
 1860: // printf("<>T = %f, %f %f %f\n", time_rm - dtb, xt, yt, zt);
 1861:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 1862:                       // then time_rm needs to be increased by the unused time.
 1863: 
 1864: 
 1865:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 1866: 
 1867:       // The current point becomes the next segment's starting point.
 1868:       x0 = xt;
 1869:  
 1870:       curElem = nextElem;
 1871: 
 1872:       iter++;
 1873:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 1874:    }
 1875: 
 1876: 
 1877: }
