 1218: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1219:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1220: }
 1221: 
 1222: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1223:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1224: }   
 1225: 
 1226: __device__ __inline__ double min3(double a, double b, double c) {
 1227:    return min(a, min(b, c));
 1228: }
 1229: 
 1230: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1231:    return min(a, min(b, min(c, d)));
 1232: }
