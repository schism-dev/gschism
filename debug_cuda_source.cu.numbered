 1274: __device__ __inline__ double min3(double a, double b, double c) {
 1275:    return min(a, min(b, c));
 1276: }
 1277: 
 1278: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1279:    return min(a, min(b, min(c, d)));
 1280: }
