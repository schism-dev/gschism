  780: // This struct is used to store the boundary information for a node.
  781: struct NodeBoundary {   
  782:    BoundarySegment *segment;
  783:    Node *node;
  784:    
  785:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
  786:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
  787: 
  788:    double etaic;  // Elevation at nodes used for essential boundary conditions
  789:    double elbc;   // Elevation boundary condition
  790:    int iettype;   // Type of elevation boundary condition
  791:    double eth;    // Elevation time history
  792: 
  793:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
  794:       assert(index == 0 || index == 1); 
  795:       return (index == 0) ? sideBnd1 : sideBnd2; 
  796:    }
  797: };
