 3942:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 3943:                     trsd=0.d0
 3944:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 3945:                       for (int i=0; i<elem->nweno1; i++) {
