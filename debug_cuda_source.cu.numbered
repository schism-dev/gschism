 4322: 
 4323: extern "C" {
 4324:    __global__ void computeElemAverageGhat(void) {
 4325:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 4326: 
 4327:       ELEM(elem);
 4328:       
 4329:       elem->ghat1= {0.0, 0.0};  
 4330: 
 4331:       if constexpr(ihydraulics != 0) {
 4332:          if (nhtblocks > 0 && elem->isblock) return;
 4333:       }
 4334: 
 4335:       if (elem->isDry) return;
 4336: 
 4337:       // Wet elements.
 4338:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 4339:       // tidal potential, horizontal diffusion, and baroclinic etc
 4340:       // Remember to update both fb and F 
 4341:       // If ics=2, ghat1 are in eframe (ll)
 4342:       // cff1-3: coefficients for 2D/3D
 4343:       Vector2 gradEta = {0.0, 0.0};  // \nabla \eta
 4344:       Vector2 gradPr  = {0.0, 0.0};  // \nabla pressure
 4345:       Vector2 gradETP = {0.0, 0.0};  // \nabla etp
 4346: 
 4347:       double av_cff1 = 0.0;  // av. for cff1
 4348:       double av_cff2 = 0.0;  // av. for cff2
 4349:       double av_cff3 = 0.0;  // av. for cff3
 4350:       double av_df = 0.0;  // av. for H^\alpha / H
 4351:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 4352:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 4353: 
 4354:       const int i34 = elem->i34;
 4355:       const int kb = elem->kb;
 4356: 
 4357:       for (int j=1; j<i34; j++) {
 4358:          // For each node and side in the element...
 4359: 
 4360:          const Node *node = elem->nodes[j];
 4361:          const Side *side = elem->sides[j];
 4362: 
 4363:          const double chi      = side->chi;
 4364:          const double veg_c2   = side->veg_c2;
 4365:          const double veg_beta = side->veg_beta;
 4366:          const double veg_h    = side->veg_h();
 4367:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 4368: 
 4369:          // Node - const in elem
 4370:          gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 4371:          gradPr  += node->pr  *elem->gradPhi[j];
 4372: 
 4373:          if (elem->depth >= tip_dp) {
 4374:            gradETP += node->ETP*elem->gradPhi[j];
 4375:          }
 4376: 
 4377:          
 4378:          const double htot  = side->htot();        // Total depth at the side
 4379:          const double zctr2 = side->zTopCanopy();  
 4380: 
 4381:          double cff1; 
 4382:          double cff2; 
 4383:          double cff3;   
 4384:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 4385:          // coefficients applied to 2D/3D case 
 4386:             cff1 = side->hhat/htot;
 4387:             cff2 = 0.0;
 4388:             cff3 = 0.0;
 4389:          } else { //3D
 4390:             //Init for no-veg case
 4391:             cff1 = 1.0;
 4392:             cff2 = 1.0;
 4393:             cff3 = 0.0;
 4394: 
 4395:             if constexpr(iveg != 0) {
 4396:                // Computes coefficients used with vegetation terms G1, G2
 4397:                // cff1, cff3 are used for the first two terms in G1, G2:
 4398:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 4399:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 4400:                // In general, cff1*Ustar - cff3*Ustar_alpha
 4401:                if(veg_h < 0.99*htot) { // submergent vegetation
 4402:                   cff1=1;
 4403:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 4404:                   cff3 = veg_c;
 4405: 
 4406:                } else { // emergent vegetation
 4407:                   cff1 = 1.0/(1.0 + veg_c2);
 4408:                   cff2 = cff1;
 4409:                   cff3 = 0.0;
 4410: 
 4411:                }
 4412:             } // if iveg
 4413:          } //  2D/3D
 4414: 
 4415:          av_cff1 += cff1/i34;
 4416:          av_cff2 += cff2/i34;
 4417:          av_cff3 += cff3/i34;
 4418:          av_cff2_chi += cff2*chi/i34;
 4419:          av_cff3_chi += cff3*chi/i34;
 4420:          av_df += min(htot, veg_h)/(htot*i34);
 4421: 
 4422: 
 4423:          // btrack values: U^\star, U^{\star\alpha}
 4424:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 4425:          Vector2 Ustar       = {0.0, 0.0}; 
 4426:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 4427: 
 4428:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 4429:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 4430:          } else { //3D
 4431:             for (int k = side->kb; k < nvrt; k++) {
 4432:             
 4433:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 4434:                Ustar += w2;
 4435: 
 4436:                if constexpr(iveg != 0) {
 4437:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 4438:                        const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k)); // For the top of the canopy, ratio of the level that is below the canopy
 4439:                        Ustar_alpha += zrat*w2; // XXXX
 4440:                    }
 4441:                }  // if iveg
 4442:             }  // for k
 4443:          }  //2D/3D
 4444:          
 4445: 
 4446:          // Add btrack & surface stress terms to \breve{G} first
 4447:          if constexpr(ics==1) {
 4448:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 4449:          } else {
 4450:             // XXX IMPLEMENT THIS
 4451:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 4452:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 4453:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 4454:          }  // if ics
 4455: 
 4456:          // Surface and bottom stress terms
 4457:          if constexpr(ics==1) {
 4458:             const Vector2 tau    = side->tau();
 4459:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 4460: 
 4461:             // Term for surface and bottom stress
 4462:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 4463:          } else {
 4464:             // XXX IMPLEMENT THIS
 4465:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 4466:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 4467:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 4468:             // tau_x=(vn1+tt1)/2.d0
 4469:             // tau_y=(vn2+ss1)/2.d0
 4470:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 4471:          }  // if ics
 4472: 
 4473:          
 4474: 
 4475:          // All terms in F,F^\alpha,f_b except baroclinic
 4476:          // F, f_b: all explicit terms excluding vegetation 
 4477:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 4478:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 4479:          const double coriolis = side->coriolis;
 4480:          Vector2 F  =  coriolis*side->U;  // F_x
 4481:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 4482:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 4483: 
 4484:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 4485:             
 4486:             for (int k = side->kb; k < nvrt; k++) {
 4487:                if (zctr2 > side->zc[k-1]) {
 4488:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 4489:                    const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 4490:                    Fa +=  coriolis*w2*zrat;
 4491:                } // if zctr2
 4492:             } // k
 4493:          } // iveg
 4494: 
 4495:          // Integrate horizontal viscosity force vertically
 4496:          for (int k=side->kb + 1; k<nvrt; k++) {
 4497:             const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.0; 
 4498: 
 4499:             F += levelHorVisc;
 4500: 
 4501:             // Vegetation term
 4502:             if constexpr(iveg!=0) {
 4503:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 4504:                   const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 4505:                   Fa += levelHorVisc*zrat;
 4506:                } 
 4507:             } // if iveg
 4508:          } // for k
 4509: 
 4510:          fb += side->d2uv[side->kb];
 4511: 
 4512: 
 4513:          // Add to ghat1
 4514:          if constexpr(ics==2) {
 4515:             // XXX IMPLEMENT THIS
 4516:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4517:             // bigf1=vn1; bigf2=vn2
 4518:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4519:             // botf1=vn1; botf2=vn2
 4520:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4521:             // bigfa1=vn1; bigfa2=vn2
 4522:          } // if ics
 4523: 
 4524:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 4525:       } // for j (nodes and sides)
 4526: 
 4527:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 4528:          
 4529:       // Finish off terms in F, F^\alpha and f_b
 4530:       const double grav3 = elem->mean(&Node::grav2);
 4531:       const Vector2 fb = grav3*gradETP - gradPr/rho0; //const in each elem
 4532: 
 4533: 
 4534:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 4535:       for (int j=1; j<i34; j++) { 
 4536:          // For each side in the element...
 4537:          const Side *side = elem->sides[j];
 4538:          const double chi = side->chi;
 4539: 
 4540:          const double htot = side->htot();
 4541:          const double veg_h = side->veg_h();
 4542:          const Vector2 F  = htot*fb;
 4543:          const Vector2 Fa = min(htot, veg_h)*fb;
 4544: 
 4545:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 4546:       } // for j
 4547: printf("$$$ tmp = %.15g, %.15g\n", tmp.x, tmp.y);
 4548:       //botf1 etc are already in elem frame
 4549:       elem->ghat1 += tmp/i34;
 4550: 
 4551:       // Baroclinic force
 4552:       if constexpr(ibc==0) {
 4553:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 4554: 
 4555:          Vector2 Fa = {0.0, 0.0};
 4556:          Vector2 intGradRho = {0.0, 0.0};
 4557:          
 4558:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 4559:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 4560:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 4561: 
 4562:             // \in F [m^2/s/s]
 4563:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 4564:          }
 4565: 
 4566:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 4567:          const Vector2 F = av_df*Fa; //approx
 4568:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 4569: 
 4570:       } // if ibc
 4571: 
 4572: 
 4573: 
 4574:    }
 4575: 
 4576: } // extern "C"
 4577: 
 4578: 
 4579: 
 4580: #ifdef DONTCOMPILE
 4581: __global__ void checkMassConservation(Tracers* sumtr) {
 4582: 
 4583:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 4584: 
 4585:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 4586: 
 4587:    Element *elem = &(mesh->localElemData[i]);
 4588: 
 4589:    // Skip dry elements
 4590:    if (elem->isDry) return;
 4591: 
 4592:    // Local sum array for this thread
 4593:    double localSum[N_TRACERS] = {0.0};
 4594: 
 4595:    // Sum over vertical levels for this element
 4596:    const int kbe = elem->kbe;
 4597:    const double area = elem->area;
 4598: 
 4599:    for (int k = kbe; k < nvrt; k++) {
 4600:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 4601:       
 4602:       // Accumulate tracer mass
 4603:       for (int tr = 0; tr < N_TRACERS; tr++) {
 4604:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 4605:       }
 4606:    }
 4607: 
 4608:    
 4609: 
 4610:    //  This function returns per element sums. A reduction must be done on the host side.
 4611: }
 4612: 
 4613: 
 4614: __global__ void transport(void) {
 4615: 
 4616:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 4617: 
 4618:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 4619: 
 4620:    Element *elem = &(mesh->localElemData[ie]);
 4621: 
 4622:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 4623: 
 4624:                for (int m=0; m<ntr; m++) {
 4625:                   for (int k=kbe(ie); k<nvrt; k++) {
 4626:                      // Calculate each polynomial's weight 
 4627:                      wm=0.d0; sum1=0.d0; 
 4628:                      wm1=0.d0; wm2=0.d0; 
 4629:                      for (int i=0; i<elem->nweno2; i++) {
 4630:                   
 4631:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4632:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4633:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4634:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4635:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4636:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 4637:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 4638:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 4639:                      // -----------------Hu and Shu (1999)'s method----------------
 4640:                      b4=b1+b2+b3
 4641: 
 4642: //Error: add PRODUCTION CPP
 4643: #ifdef DEBUG
 4644:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 4645:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 4646:                     call parallel_abort(errmsg)
 4647:                   }
 4648: #endif
 4649: 
 4650:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 4651:                   // !----test-------------- 
 4652:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 4653:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 4654:                   // !wm(i)=wm1(i)*wm2(i)
 4655:                   // !---------------------- 
 4656:                   sum1=sum1+wm(i)
 4657:                 } // end for i
 4658: 
 4659:                 wm=wm/sum1
 4660: 
 4661:                 for (int j=0; j<elem->i34; j++) {
 4662: 
 4663:                   const Side *side  = elem->sides[j];
 4664:                   const Node *node1 = side->n1;
 4665:                   const Node *node2 = side->n2;
 4666: 
 4667:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 4668:                      trsd=0.d0
 4669:                      for (int kk=0; kk<nquad; kk++) {
 4670:                         for (int i=0; i<elem->nweno2; i++) {
 4671:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4672:                         } // end for i   
 4673:                      } // end for kk
 4674:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 4675:                   } // outward flux
 4676:                } // end for j=1,i34(ie) ! side
 4677:             }
 4678:          }
 4679:               
 4680: 
 4681: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 4682: //             //   calculate each polynomial's weight 
 4683: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 4684: //                 wm=0.d0; sum1=0.d0
 4685: //                 do i=1,nweno1(ie) !for each polynomial
 4686: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4687: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4688: //                   b1=b1*b1+b2*b2 !smoothness indicator
 4689: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 4690: //                   wm(i)=b2
 4691: //                   sum1=sum1+b2
 4692: //                   !wm(i)=1.d0
 4693: //                   !sum1=sum1+1.d0
 4694: 
 4695: // // Error: PRODUCTION
 4696: // #ifdef DEBUG
 4697: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 4698: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 4699: //                     call parallel_abort(errmsg)
 4700: //                   endif
 4701: // #endif
 4702: 
 4703: //                 enddo !i
 4704: //                 wm=wm/sum1 !final weight
 4705: 
 4706:                 for (int j=0; j<elem->i34; j++) { // side
 4707:                   const Side *side = elem->sides[j];
 4708:                   const Node *node1 = side->n1;
 4709:                   const Node *node2 = side->n2;
 4710: 
 4711:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 4712:                     trsd=0.d0
 4713:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 4714:                       for (int i=0; i<elem->nweno1; i++) {
 4715:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 4716:                       }
 4717:                     enddo //kk
 4718:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 4719:                   } // outward flux
 4720:                 } // end for j=1,i34(ie) ! side
 4721:               } // end for k; ntr 
 4722: 
 4723:             else !simple upwind method
 4724:               do j=1,i34(ie)
 4725:                 jsj=elside(j,ie)
 4726:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 4727:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 4728:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 4729:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 4730:                   endif
 4731:                 enddo  !vertical layers
 4732:               enddo !j=1,i34(ie) ! side
 4733:             endif !order of accuracy
 4734: 
 4735:          //  enddo !ie
 4736: // !$OMP     end do
 4737: 
 4738: // !$OMP     master
 4739: //           !message passing
 4740: //           if (nproc>1) then
 4741: //             !make a copy of side concentrations
 4742: //             trsd_tmp0=trsd_tmp 
 4743: 
 4744: //             !this exchange routine swaps interface concentration between two partitions
 4745: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 4746: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 4747: 
 4748: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 4749: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 4750: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 4751: 
 4752: 
 4753: //             !This obtains final values for interface sides
 4754: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 4755: //       :    endif !nproc>1
 4756: //           !message passing end
 4757: // !$OMP     end master
 4758: // !$OMP     barrier
 4759: 
 4760: 
 4761: // !         Do advection; conc @ dry elem will not be changed
 4762: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 4763: // !$OMP     do reduction(+: h_mass_in)
 4764: //           do i=1,ne
 4765: //             if(idry_e(i)==1) cycle
 4766: 
 4767: 
 4768: // !           Wet elements with 3 wet nodes
 4769: //             do k=kbe(i)+1,nvrt
 4770: 
 4771: 
 4772: //               bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 4773: //               dtb_by_bigv = dtb/bigv
 4774:     
 4775: // !             Advective flux
 4776: //               if (ntd_weno==1 .or. itd_weno==1) then
 4777: //                 adv_tr(1:ntr)=trel_tmp(1:ntr,k,i) 
 4778: //               else
 4779: //                 adv_tr(1:ntr)=(1.d0-rk_coef(itd_weno))*trel_tmp0(1:ntr,k,i)+rk_coef(itd_weno)*trel_tmp(1:ntr,k,i) 
 4780: //               endif
 4781: 
 4782: //               !psum=0.d0 !sum of modified fluxes for all inflow bnds
 4783: //               do j=1,i34(i)
 4784: //                 jsj=elside(j,i) !side
 4785: //                 iweno=.true. !use weno reconstruction as default
 4786: //                 iel=ic3(j,i) !neighboring elem
