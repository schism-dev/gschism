 1779: 
 1780: __inline__ __device__ double Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 1781: __inline__ __device__ double Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 1782: __inline__ __device__ Point2 Side::p_t(double t) const { return {x(t), y(t)}; }
 1783: __inline__ __device__ int    Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 1784: __inline__ __device__ double Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 1785: 
 1786: __inline__ __device__ double Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 1787: __inline__ __device__ double Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 1788: __inline__ __device__ double Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 1789: 
 1790: 
 1791: __inline__ __device__ double Side::Cd(void)      const { if constexpr(nchi != 0) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 1792: 
 1793: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 1794: 
 1795: /**
 1796:  * This method performs backtracking from the side center until a time -dt back in time 
 1797:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 1798:  * intermediate point.
 1799:  *
 1800:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 1801:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 1802:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 1803:  * remaining time.
 1804:  * 
 1805:  * NOTE: Runge-Kutta is not implemented yet. XXX
 1806:  * 
 1807:  * @param uuint, vvint, wwint: Velocities at the final point
 1808:  * @param jlev: Level at which the backtracking is performed
 1809:  * @param dt, dtbk: Tracking timesteps
 1810:  * @param sclr: Array for backtracked values
 1811:  * @return: True if the backtracking was successful, false otherwise
 1812:  */
 1813: __inline__ __device__ bool Side::btrack(
 1814:       int jlev,
 1815:       double dt,            // Tracking time
 1816:       double dtbk,          // Tracking timestep
 1817:       double* sclr,         // Array for backtracked values
 1818:       Vector3 &u_int
 1819: ) const {
 1820: 
 1821:    // Start from side center
 1822:    Point3 x0 = {center.x, center.y, zc[jlev]};
 1823:  
 1824: 
 1825:    double time_rm = dt; // Remaining time
 1826: 
 1827: 
 1828:    // // Initialize outputs XXX
 1829:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 1830:    //    sclr[i] = 0.0;
 1831:    // }
 1832: 
 1833: 
 1834:    // Initial velocities
 1835:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 1836: 
 1837:    // Find the element that is in the direction opposite to the velocity
 1838:    Element* curElem = findElementTowards({u_int.x, u_int.y});
 1839: 
 1840: 
 1841:    const int MAX_ITERATIONS = 1000; 
 1842:    Element* nextElem = curElem;
 1843:    int iter = 0;
 1844:    while(true) {
 1845:       // Calculate timestep
 1846:       double dtb = min(dtbk, time_rm);
 1847: 
 1848:       // Next point in the backtracking curve
 1849:       Point3 xt = x0 - dtb*u_int;
 1850: 
 1851:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb);
 1852:       assert(found && "Backtracking failed in btrack");
 1853: // printf("<>T = %f, %f %f %f\n", time_rm - dtb, xt, yt, zt);
 1854:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 1855:                       // then time_rm needs to be increased by the unused time.
 1856: 
 1857: 
 1858:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 1859: 
 1860:       // The current point becomes the next segment's starting point.
 1861:       x0 = xt;
 1862:  
 1863:       curElem = nextElem;
 1864: 
 1865:       iter++;
 1866:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 1867:    }
 1868: 
 1869: 
 1870: }
 1871: 
