 2292: __device__ void backtrackAllNodes(void) {
 2293: 
 2294:    // max/min # of sub-divisions
 2295:    const int ndelt_max = max(1.0, dt/dtb_min);
 2296:    const int ndelt_min = max(1.0, dt/dtb_max); 
 2297: 
 2298:    // Removed all references to swild98 XXX
 2299:    // swild98=0.d0 !init
 2300: 
 2301:    Side *side = FROM kernel;
 2302: 
 2303:    const int kb = side->kb;
 2304:    for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 2305: 
 2306:    if (side->idry == 1) return;
 2307: 
 2308:    // Checks that at least one element is not dry
 2309:    const Element *elem1 = side->elems[0];
 2310:    const Element *elem2 = side->elems[1];
 2311:    assert ((elem1 != nullptr && !(elem1->idry)) || (elem2 != nullptr && !(elem2->idry)) && "backtrackAllNodes: non dry side without two dry elements.");
 2312: 
 2313:    // XXXXXX
 2314:    // !swild_tmp to store global coord. of the starting side
 2315:    // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 2316:    // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 2317:    // !Use sframe2 
 2318:    // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 2319: 
 2320: 
 2321:    for (int k = kb; k < nvrt; k++) {
 2322:    //  Initialize (xt,yt,zt), nnel and vel.
 2323:    //  For ics=2, the coordinates are in local frames
 2324:    //  Caution! nnel must be initialized inside this loop as it is updated inside.
 2325: 
 2326: 
 2327:       const int iadvf = side->iadv();  // Advection flag
 2328: 
 2329:       Point3 xt;
 2330:       if constexpr(ics==1) {
 2331:          xt = side->center3D(k); 
 2332:       }
 2333:       else // lat/lon; in side lat/lon frame
 2334:       {
 2335:       // XXX IMPLEMENT THIS
 2336:    //          xt=0.d0
 2337:    //          yt=0.d0
 2338:    //          !centroid coord. for nudging
 2339:    //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 2340:    //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 2341:       }  // ics
 2342: 
 2343: 
 2344:       // Velocity at the side (in ll frame for ics, same vertical direction)
 2345:       // XXX IS THIS NECESSARY?
 2346:       Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 2347: 
 2348:       // If on land or open boundary...
 2349:       const bool ifl_bnd =  (side->sideBnd != nullptr);
 2350:       
 2351:       const double vmag = length(toVector2(u_int));
 2352: 
 2353:       vis_coe = 0.0;
 2354: 
 2355:       if (vmag <= velmin_btrack) {
 2356:          // No activity 
 2357: 
 2358:          side->btu[k] = side->u2[k];
 2359: 
 2360: 
 2361:       } else {  // do btrack
 2362: 
 2363:          // Compute number of sub-divisions based on local gradients 
 2364:          // XXX IS THIS NECESSARY?
 2365:          double suma = 0.0;
 2366:          int icount = 0;
 2367:          for (int ii=0; ii<2; ii++) {
 2368: 
 2369:             const Element *elem = side->elems[ii];
 2370:               
 2371:             if (elem == nullptr) continue;
 2372: 
 2373:             icount++;
 2374: 
 2375:             // Not strictly along z; in ll frame for ics=2
 2376: 
 2377:             for (int jj = 0; jj < elem->i34; jj++) {
 2378: 
 2379:                const Node *node = elem->nodes[jj];
 2380: 
 2381:                if constexpr(ics==1) {
 2382:                   Vector2 u_node = {node->u2[k].x, node->u2[k].y};
 2383:                } else {
 2384:                   // XXX IMPLEMENT THIS
 2385:                   // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 2386:                }
 2387:             } // for jj
 2388: 
 2389:             const Vector2 grad_u = elem->grad(u_int.x); // XXX IMPLEMENT THIS
 2390:             const Vector2 grad_v = elem->grad(u_int.y);
 2391: 
 2392:             suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 2393:          } // for ii
 2394: 
 2395:          assert(icount > 0 && "Impossible 77");
 2396: 
 2397:          // '4' is somewhat arbitrary
 2398:          const int ndelt = max(ndelt_min, min(ndelt_max, int(suma/icount)*4)); // >=1
 2399:          const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 2400: 
 2401: 
 2402:          // Perturb starting pt to avoid underflow 
 2403:          // XXX I don't think this is needed with the current implementation
 2404:          // eps=btrack_nudge
 2405:          // if constexpr(ics==1) {
 2406:          //    xt=(1.d0-eps)*xt+eps*xctr(nnel)
 2407:          //    yt=(1.d0-eps)*yt+eps*yctr(nnel)
 2408:          // } else { //lat/lon
 2409:          //    xt=(1.d0-eps)*xt+eps*xctr2
 2410:          //    yt=(1.d0-eps)*yt+eps*yctr2
 2411:          // } // ics
 2412: 
 2413:       
 2414:          // call btrack(l,ipsgb,ifl_bnd,j,iadvf,swild_tmp,swild10_tmp, dtbk,vis_coe,time_rm,time_rm2,uuint,vvint,wwint,nnel,jlev,xt,yt,zt,swild3,ltmp)
 2415: 
 2416:             
 2417:       } // if vmag (do backtrack)
 2418: 
 2419:    } // for j=jmin,nvrt-1
 2420: 
 2421: }
 2422: 
 2423: template<int nc>
 2424: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 2425: 
 2426: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 2427: //
 2428: // a,b,c,r: input vectors and are not modified by this program.
 2429: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 2430: // r is the r.h.s.
 2431: // n: actual rank of the system.
 2432: // rows in u() and r();
 2433: // u: output with nc columns (transposed to rows)
 2434: // gam: a working array.
 2435: //
 2436: // NOTES:
 2437: // This is a template function that allows for different numbers of columns in the rhs vector.
 2438: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 2439: 
 2440:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 2441:    assert(nc <= nvec   && "TRIDAG: Increase number of columns");
 2442:    assert(b[0] != 0.d0 && "TRIDAG: b[0]=0");
 2443: 
 2444:    double bet = b[0];
 2445:    if constexpr (nc == 1) {
 2446:       u[0] = rhs[0]/bet;
 2447:    } else {
 2448:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 2449:    }
 2450: 
 2451:    for (int j = 1; j < n; j++) {
 2452:       gam[j] = c[j-1]/bet;
 2453:       bet = b[j] - a[j]*gam[j];
 2454: 
 2455:       assert (bet!=0.d0 && "TRIDIAGONAL SOLVER: bet=0");
 2456: 
 2457:       if constexpr (nc == 1) {
 2458:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 2459:       } else {
 2460:          for (int k = 0; k < nc; k++) {
 2461:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 2462:          }
 2463:       }
 2464:    }
 2465: 
 2466:    // Back-substitution
 2467:    for (int j=n-1; j>=1; j--) {
 2468:       if constexpr (nc == 1) {
 2469:          u[j] = u[j] - gam[j+1]*u[j-1];
 2470:       } else {
 2471:          for (int k = 0; k < nc; k++) {
 2472:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 2473:          }
 2474:       }
 2475:    }
 2476: }
 2477: 
 2478: 
 2479: // Helper function that contains the core algorithm
 2480: template<typename XAccessor, typename YAccessor>
 2481: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 2482:                                            double yp_top, double yp_bot, 
 2483:                                            double *yp_out, double *ypp_out) {
 2484:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 2485:    // 
 2486:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 2487:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 2488:    //
 2489:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 2490:    // 
 2491:    // Inputs: 
 2492:    //            n: dimension for x etc; # of data pts (>=2);
 2493:    //            getX, getY: functions to access x,y coordinates
 2494:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 2495:    //     Output: 
 2496:    //            ypp[n]: 2nd derivatives used in interpolation.
 2497:    //             yp[n]: 1st derivatives 
 2498: 
 2499:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 2500: 
 2501:    const int n = k2 - k1 + 1;
 2502:    double a[n];   // Lower diagonal
 2503:    double b[n];   // Diagonal
 2504:    double c[n];   // Upper diagonal
 2505:    double gam[n]; // Gamma, used by the tridiagonal solver
 2506:    double rhs[n]; // Right-hand side
 2507: 
 2508:    for (int k=k1; k<=k2; k++) {
 2509:       if (k == k1) {
 2510:          // Bottom level
 2511:          assert(getX(k+1) - getX(k) != 0.0 && "CUBIC SPLINE: bottom problem");
 2512:          b[k] = (getX(k+1) - getX(k))/3.0;
 2513:          c[k] = b[k]/2.0;
 2514:          rhs[k] = (getY(k+1) - getY(k))/(getX(k+1) - getX(k)) - yp_bot;
 2515:       } else if (k == n - 1) {
 2516:          // Top level (surface)
 2517:          assert(getX(k) - getX(k-1) != 0.0 && "CUBIC SPLINE: surface problem");
 2518:          b[k] = (getX(k) - getX(k-1))/3.0;
 2519:          a[k] = b[k]/2.0;
 2520:          rhs[k] = -(getY(k) - getY(k-1))/(getX(k) - getX(k-1)) + yp_top;
 2521:       } else {
 2522:          // Intermediate levels
 2523:          assert(getX(k) - getX(k-1) != 0.0 && getX(k+1) - getX(k) != 0.0 && "CUBIC SPLINE: middle problem");
 2524:          b[k] = (getX(k+1) - getX(k-1))/3.0;
 2525:          a[k] = (getX(k  ) - getX(k-1))/6.0;
 2526:          c[k] = (getX(k+1) - getX(k  ))/6.0;
 2527:          rhs[k] = (getY(k+1) - getY(k  ))/(getX(k+1) - getX(k  )) - 
 2528:                   (getY(k  ) - getY(k-1))/(getX(k  ) - getX(k-1));
 2529:       }
 2530:    }
 2531: 
 2532:    // Solve the tridiagonal system
 2533:    tridag_sch<1>(n, a, b, c, rhs, ypp_out, gam);
 2534:     
 2535:    yp_out[k1] = yp_bot;
 2536:    yp_out[k2] = yp_top;
 2537: 
 2538:    // Compute rest of 1st derivatives using the splines
 2539:    for (int k=k1+1; k<k2; k++) {
 2540:       yp_out[k] = (getY(k+1) - getY(k))/(getX(k+1) - getX(k)) - 
 2541:                   (getX(k+1) - getX(k))/6.0*(2.0*ypp_out[k] + ypp_out[k+1]);
 2542:    }
 2543: }
 2544: 
 2545: // Array version
 2546: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 2547:                                 double y_top, double y_bot, 
 2548:                                 double *yp_out, double *ypp_out) {
 2549:    auto getX = [x] (int k) { return x[k]; };
 2550:    auto getY = [y] (int k) { return y[k]; };
 2551:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, yp_out, ypp_out);
 2552: }
 2553: 
 2554: // Lambda version - allows custom access patterns
 2555: template<typename XFunc, typename YFunc>
 2556: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 2557:                                        double y_top, double y_bot,
 2558:                                        double *yp_out, double *ypp_out) {
 2559:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, yp_out, ypp_out);
 2560: }
 2561: 
