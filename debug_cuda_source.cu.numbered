 1023: 
 1024:    __device__ Mesh(int partNum,
 1025:                    int npgb, int negb, int nsgb, 
 1026:                    int np, int ne, int ns, int nvrt, int kz,
 1027:                    int max_np, int max_ne, int max_ns, int nseg,
 1028:                    Node **nodesPtr, Element **elemsPtr, Side **sidesPtr,
 1029:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 1030:                    Node    **localNodeNeighNodesMem,
 1031:                    Element **localNodeNeighElemsMem,
 1032:                    NodeBoundary *localNodeBoundaryMem,
 1033:                    SideBoundary *localSideBoundaryMem,
 1034:                    BoundarySegment *localSegmentMem,
 1035:                    double h_s, double theta_b, double theta_f, double *sigma_lcl, double *sigma, double *ztot,
 1036:                    double *cs, double *dcs
 1037:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 1038:                        np(np), ne(ne), ns(ns),
 1039:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
 1040:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
 1041:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
 1042:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
 1043:                        localNodeBoundaryMem(localNodeBoundaryMem), localSideBoundaryMem(localSideBoundaryMem),
 1044:                        localSegmentMem(localSegmentMem),
 1045:                        h_s(h_s), theta_b(theta_b), theta_f(theta_f), sigma_lcl(sigma_lcl), sigma(sigma), ztot(ztot),
 1046:                        cs(cs), dcs(dcs)
 1047:    {
