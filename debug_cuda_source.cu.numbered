 1272: 
 1273: /**
 1274:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1275:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1276:    If the segment is completely inside the element, then it returns true.
 1277: 
 1278:    This function assumes:
 1279:    - The initial point is on a side of the element. 
 1280:    - Its position is given by parameter t in the range [0,1].
 1281:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1282:       intersects the element (elements are convex).
 1283: 
 1284:    To find the intersection point, this function does the following:
 1285:    - it finds the intersection of the line segment with all the element side lines,
 1286:       except for the one that contains the initial point.
 1287:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1288:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1289:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1290:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1291:       track segment is almost parallel to the element side line.
 1292: 
 1293:    Inputs:
 1294:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1295:    @param x2, y2: other end of the line segment
 1296: 
 1297:    Outputs:
 1298:    @param side:  side that intersects the line segment (input and output)
 1299:    @param nextElement (output): element that contains the intersection point
 1300:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1301:    @param zint (input/output): Vertical coordinate of the intersection point
 1302: 
 1303:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1304:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1305:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1306: 
 1307:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1308:    (Delta) being zero.
 1309: 
 1310:    The intersection2 point happens when:
 1311:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1312:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1313:    
 1314:    Assumption: the 4 points (including those of the side segment) are different.
 1315:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1316:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1317:    If true, (xIntersect,yIntersect) is the intersection.				
 1318:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1319: **/
 1320: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1321:                                               double &t, double& tIntersect) {
 1322: 
 1323:    double closest_intersect_t = 1e10;
 1324:    bool found_intersection = false;
 1325: 
 1326:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1327:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1328:    const Point2 x1 = side->point(t);
 1329:    
 1330: 
 1331:    Side *nextSide = nullptr;
 1332: 
 1333:    for (int i = 0; i < i34; i++) {
 1334: 
 1335:       // Element's i-th side 
 1336:       Side *side2 = sides[i];
 1337: 
 1338:       // Skip the side that contains the initial point
 1339:       if (side2 == side) continue;
 1340: 
 1341:       // (x3,y3)-(x4,y4) is the element side line
 1342:       const Point2 x3 = side2->n1->p2();
 1343:       const Point2 x4 = side2->n2->p2();
 1344: 
 1345:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1346:       const double delta = cross(x2 - x1, x3 - x4);
 1347: 
 1348:       if (delta != 0.0) {
 1349: 
 1350:          const double delta1 = cross(x3 - x1, x3 - x4);
 1351:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1352: 
 1353:          // Solves the two linear equations for tt1 and tt2
 1354:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1355:          const double tt2 = delta2/delta;
 1356: 
 1357:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1358:             closest_intersect_t = min(closest_intersect_t, tt1);
 1359:             nextSide = side2;
 1360: 
 1361:             nextElement = nextSide->otherElem(this);
 1362:             tIntersect = max(small, min(tt1, 1.0-small));
 1363:             t = tt2;
 1364: 
 1365:             found_intersection = true;
 1366:          }
 1367:       
 1368:       }
 1369: 
 1370:    }
 1371: 
 1372: 
 1373:    // found_intersection should always be true, since we checked all the sides.  
 1374:    side = nextSide;
 1375: // if (found_intersection) {
 1376: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1377: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1378: // }   
 1379:    if (!found_intersection) {
 1380:       // Check if the segment is parallel to the initial side
 1381:       printf("XXX %f\n", dot(x2 - x1, side->n1->p2() - side->n2->p2()));
 1382:       if (abs(dot(x2 - x1, side->n1->p2() - side->n2->p2())) < small) {
 1383:          found_intersection = true;
 1384:          nextElement = side->otherElem(this);
 1385:          tIntersect = t;
 1386:          t = 0.0;
 1387:          found_intersection = true;
 1388:       }
 1389:    }
 1390:    return found_intersection;
 1391: }
 1392: 
 1393: 
 1394: 
 1395: 
 1396: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1397:                                               double &t, double& tIntersect) {
 1398: 
 1399:    double closest_intersect_t = 1e10;
 1400:    bool found_intersection = false;
 1401: 
 1402:    for (int i = 0; i < i34; i++) {
 1403: 
 1404:       Side *side2 = sides[i];
 1405: 
 1406:       // (x3,y3)-(x4,y4) is the element side line
 1407:       const Point2 x3 = side2->n1->p2();
 1408:       const Point2 x4 = side2->n2->p2();
 1409: 
 1410:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1411:       const double delta = cross(x2 - x1, x3 - x4);
 1412: 
 1413:       if (delta != 0.0) {
 1414: 
 1415:          const double delta1 = cross(x3 - x1, x3 - x4);
 1416:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1417: 
 1418:          // Solves the two linear equations for tt1 and tt2
 1419:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1420:          const double tt2 = delta2/delta;
 1421: 
 1422:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1423:             closest_intersect_t = min(closest_intersect_t, tt1);
 1424:             side = side2;
 1425:             nextElement = side->otherElem(this);
 1426:             t = tt2;
 1427:             tIntersect = max(small, min(tt1, 1.0-small));
 1428:             found_intersection = true;
 1429:          }
 1430:       
 1431:       }
 1432: 
 1433: 
 1434:    }
 1435: 
 1436:    assert(found_intersection && "No intersection found");
 1437: 
 1438:    // found_intersection should always be true, since we checked all the sides.  
 1439:    return found_intersection;
 1440: }
 1441: 
 1442: 
 1443: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1444:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1445: 
 1446:    printf("Tracking segment goes out of water at element %d\n", curElem->idx);
 1447: 
 1448:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1449:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1450:    // curElement.
 1451: 
 1452:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1453:    // And uses this velocity instead to continue the tracking.
 1454: 
 1455:    // computes the intersection point in cartesian coordinates
 1456:    Point2 intersection = nextSide->p_t(tt);
 1457: 
 1458:    // Nudges the point to the barycenter of the element. 
 1459:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1460:    // next segment intersects the element sides.  
 1461:    curElem->nudgeToBarycenter(intersection);
 1462: 
 1463:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1464:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1465:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1466:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1467: 
 1468:    // If the side is an open boundary, the tangential velocity is zero.
 1469:    if (nextSide->isBnd()) vtan = 0.0;
 1470: 
 1471:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1472:    const double us = vtan*nextSide->t().x;
 1473:    const double vs = vtan*nextSide->t().y;
 1474:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1475: 
 1476:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1477:    const double len2 = length(intersection - toPoint2(xt));
 1478:    const double vel2 = u_int.x*u_int.x + u_int.y*u_int.y;        
 1479:    assert(vel2 > 0.0 && "Zero velocity found");
 1480:    dt = dt - sqrt(len2/vel2); 
 1481: 
 1482:    // The end of this tracking segment is now the intersection point.
 1483:    xt = {intersection.x, intersection.y, zint};
 1484:    
 1485:    u_int = {us, vs, ws};
 1486:    
 1487: }
 1488: 
 1489: /**
 1490:  * Tracks a particle through elements and vertical levels in the mesh.
 1491:  * 
 1492:  * @param x0,y0,z0     Starting position coordinates
 1493:  * @param xt,yt,zt     Target position coordinates
 1494:  * @param dtb          Time step for tracking
 1495:  * @param uuint,vvint,wwint Initial velocity components
 1496:  * @param nextElem     Starting/resulting element index
 1497:  * 
 1498:  * @return Status code of type trackExitCodes
 1499:  * 
 1500:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1501:  * of the details are different. The idea is that the code requires less branches and is better fit
 1502:  * for GPU execution.
 1503:  * 
 1504:  * The main ideas here are:
 1505:  * - The starting point is expected to be in the starting element.
 1506:  * - The end point is guaranteed to be inside an element.
 1507:  * - since the starting point is inside the element, there are only two cases: 
 1508:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1509:  *     (b) it does not and (xt,yt) is already in the starting element.
 1510:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1511:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1512:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1513:  * - tt1 can be positive or negative. We only consider the positive values.
 1514:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1515:  * - The next intersection will occur at the smallest positive tt1.
 1516:  * - This intersection will be the next (x0,y0) position.
 1517:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1518:  *   of getting stuck in a loop.
 1519:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1520:  *   was found.
 1521:  */
 1522: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1523:                                                        Element *&nextElem, int &jlev, double &dt) {
 1524: 
 1525:    // First thing is to check if the target point is inside the element. If it is there is nothing
 1526:    // else to do.
 1527:    if (containsPoint(toPoint2(xt))) {
 1528:       nextElem->interpolateVelocities(xt, u_int);
 1529:       return true;
 1530:    }
 1531: 
 1532:    Side *side = nullptr;
 1533: 
 1534:    // 1. Initial checks
 1535:    // Verify starting element is valid (wet)
 1536:    assert(!nextElem->isDry && "Starting element is dry");
 1537: 
 1538:    // Checks if track has a zero length.
 1539:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1540:    assert(len2 > 0.0 && "Zero length track"); 
 1541:    
 1542: 
 1543:    const int MAX_ITERATIONS = 1000;
 1544:    
 1545:    double t;
 1546:    Side *nextSide = nullptr;
 1547:    double tIntersect = 1e10;
 1548:    double zint = x0.z;
 1549: 
 1550:    // Horizontal tracking loop
 1551:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1552:    // (x0,y0) is inside the element but the target point is not.
 1553:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1554:    if (!found_intersection) {
 1555:       printf("No intersection found:\n"
 1556:            "Element %d\n"
 1557:            "Start point: (%f, %f)\n"
 1558:            "Target point: (%f, %f)\n"
 1559:            "Vertices:\n"
 1560:            "  Node 0: (%f, %f)\n"
 1561:            "  Node 1: (%f, %f)\n"
 1562:            "  Node 2: (%f, %f)\n",
 1563:            nextElem->idx,
 1564:            x0.x, x0.y,
 1565:            xt.x, xt.y,
 1566:            nextElem->nodes[0]->p.x, nextElem->nodes[0]->p.y,
 1567:            nextElem->nodes[1]->p.x, nextElem->nodes[1]->p.y,
 1568:            nextElem->nodes[2]->p.x, nextElem->nodes[2]->p.y);
 1569:    }
 1570:    assert(found_intersection && "No intersection found at %d");
 1571: 
 1572:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1573: 
 1574:    // if the tracking segment goes out of water (either dry or edge boundary)
 1575:    if (isEdgeBoundary(nextSide) || (nextElem->isDry)) {
 1576:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1577:       nextElem = this;
 1578:       
 1579:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1580:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1581:       return true;    
 1582:       }
 1583: 
 1584:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1585:    int iterations = 0;
 1586:    while (iterations < MAX_ITERATIONS) {
 1587:       iterations++;
 1588:       
 1589:       Element *curElem = nextElem;
 1590: 
 1591:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1592:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1593: 
 1594:       // If we are already in the target element, we are done.
 1595:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1596:       if (!found_intersection) break;
 1597: 
 1598: 
 1599:   
 1600:       // if the tracking segment goes out of water (either dry or edge boundary).
 1601:       if (curElem->isEdgeBoundary(nextSide) || (nextElem->isDry)) {
 1602: 
 1603:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1604: 
 1605:          nextElem = curElem;
 1606: 
 1607:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1608:          // In this case, the caller (btrack) needs to take into account the remaining time.
 1609:          return true;
 1610:       }
 1611:       
 1612:       // Update position and element for next iteration
 1613:       side = nextSide;
 1614: 
 1615:    }
 1616: 
 1617: 
 1618:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 1619: 
 1620:  
 1621:    // Interpolate velocities at the final position. This is a conceptually simple step,
 1622:    // but the function is not simple, because it has to search for the vertical level containing zt.
 1623:    nextElem->interpolateVelocities(xt, u_int);
 1624: 
 1625: 
 1626:    return true;
 1627: }
 1628: 
 1629: 
 1630: 
 1631: 
 1632: __inline__ __device__ double Element::computeSignedArea(void) const {
 1633:    // Compute the area of the element
 1634: 
 1635:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 1636: 
 1637:    // In the quad case we need to add the area of the other triangle.
 1638:    if (isQuad()) {
 1639:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1640:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 1641:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1642:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 1643:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 1644:          Error("Negative area found in quad element");
 1645:       }
 1646:       res += ar1;
 1647:    }
 1648: 
 1649:    return res;
 1650: }
 1651: 
 1652: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 1653:    // In boundary sides, the element 1 is nullptr
 1654:    return side->elems[1] == nullptr; 
 1655: }
 1656: 
 1657: 
 1658: 
 1659: /**
 1660:    Compute the shape coordinates of the point (xt,yt) in the element.
 1661:    @param xt (input): x-coordinate of the point
 1662:    @param shpCoords (output): shape coordinates of the point
 1663:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 1664:    @return true if the point is inside the element, false otherwise
 1665: **/
 1666: __device__ bool Element::computeShapeCoords(Point2 xt, double shpCoords[4],
 1667:                                             bool fixNegshpCoord) const {
 1668: 
 1669:    // Compute the shape coordinates of the point xt in the element.
 1670:    if (i34==3) {
 1671:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 1672:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 1673:       // and in this case, the pt will be nudged into the element
 1674:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 1675:       // from the local frame, so use additional check.
 1676: 
 1677:       Point2 x0, x1, x2;
 1678: 
 1679:       if constexpr(ics==1) {
 1680:          x0 = nodes[0]->p2();
 1681:          x1 = nodes[1]->p2();
 1682:          x2 = nodes[2]->p2();
 1683:       }
 1684:       else // lat/lon
 1685:       {
 1686:          Error("Not implemented yet");
 1687: #ifdef ICS2
 1688:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 1689:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 1690:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 1691: #endif
 1692:       }
 1693: 
 1694:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 1695:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 1696:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 1697:       shpCoords[3] = 0.0;
 1698:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 1699: 
 1700:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 1701:       // then we fix the negative shape coordinates.
 1702:       if (fixNegshpCoord && tmpmin<=0.0) {
 1703: 
 1704:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 1705:          // keeping the sum of the shape coordinates equal to 1.
 1706:          // I have tested and compared the new algorithm with the old one, and they give
 1707:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 1708:          // The new algorithm should be faster since it is branchless.
 1709:          const double a = - tmpmin + 1.0e-2;  // XXX it used to be 1.0e-4 in the comments of the original code
 1710:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 1711:          
 1712:          shpCoords[0] = (shpCoords[0] + a)*b;
 1713:          shpCoords[1] = (shpCoords[1] + a)*b;
 1714:          shpCoords[2] = (shpCoords[2] + a)*b;          
 1715: 
 1716:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 1717:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 1718:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 1719:          }
 1720: 
 1721:          // Update the point coordinates for the new shape coordinates
 1722:          double xcoords[3] = {x0.x, x1.x, x2.x};
 1723:          double ycoords[3] = {x0.y, x1.y, x2.y};
 1724:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 1725: 
 1726:       }
 1727: 
 1728:       // Check if the point is inside the element
 1729:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 1730:    }
 1731:    else {
 1732:       Error("Not implemented yet");
 1733: #ifdef QUADS
 1734:       // Reproject pt in eframe of nel for ics=2
 1735:       if constexpr(ics==1) {
 1736:          xn2 = xt; 
 1737:          yn2 = yt;
 1738:       }
 1739:       else {
 1740:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 1741:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 1742:       }
 1743: 
 1744:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 1745: #endif
 1746:    }
 1747: 
 1748: }
 1749: 
 1750: 
 1751: /**  Interpolate velocities at a given point (xt,yt,zt)
 1752: 
 1753:    @param xt, yt, zt: coordinates of the point to interpolate
 1754:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 1755: 
 1756:    This is done in four steps:
 1757: 
 1758:    1. Find the shape coordinates for the final position in the element.
 1759:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 1760:    3. Perform a *binary search* to find the vertical level containing zt. It will have to interpolate the 
 1761:       z levels at xt, yt at each step.   
 1762:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 1763:       horizontally and vertically.
 1764: **/
 1765: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) {
 1766:    // Interpolate the velocities at the point xt. 
 1767:    // This function works the same for triangular and quadrilateral elements.
 1768:    double shpCoord[4];
 1769: 
 1770: 
 1771:    // First step is to compute the shape coordinates of (xt,yt)
 1772:    computeShapeCoords(toVector2(xt), shpCoord, false);
 1773:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 1774: 
 1775:    // Second step is to find the level that contains zt
 1776:    // Uses a binary search to find the level
 1777:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 1778:    int L = kbe;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 1779:    int R = nvrt - 1;
 1780: 
 1781:    // Get the z coordinates at the nodes of the element at the levels L and R
 1782:    double zLAtNodes[4], zRAtNodes[4];
 1783:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 1784:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 1785: 
 1786:    double zL = interpolate(shpCoord, zLAtNodes);
 1787:    double zR = interpolate(shpCoord, zRAtNodes);
 1788:    
 1789:    // Interpolates vertically the velocities
 1790:    double wght1, wght2;
 1791:    if (xt.z<=zL) {
 1792:       wght1 = 1.0;
 1793:       wght2 = 0.0;
 1794:    }
 1795:    else if (xt.z>=zR) {
 1796:       wght1 = 0.0;
 1797:       wght2 = 1.0;
 1798:    }
 1799:    else {
 1800:       // Perform a binary search to find the levels between L and R that contain xt.z
 1801:       while (R - L > 1) {
 1802:          int M = (L + R) / 2;
 1803: 
 1804:          double zMAtNodes[4];
 1805:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 1806:          double zM = interpolate(shpCoord, zMAtNodes);
 1807:          if (zM < xt.z) 
 1808:          {
 1809:             L = M;
 1810:             zL = zM;
 1811:          }
 1812:          else 
 1813:          {
 1814:             R = M;
 1815:             zR = zM;
 1816:          }
 1817:       }
 1818:       assert(L == R-1);
 1819:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 1820: 
 1821:       wght2 = (xt.z - zL)/(zR - zL);
 1822:       wght1 = 1.0 - wght2;
 1823:    }
 1824: // printf("$$$ wght1 = %f, wght2 = %f, zt = %f, zL = %f, zR = %f\n", wght1, wght2, zt, zL, zR);
 1825: // printf("$$$ shpCoord = %f, %f, %f, %f\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 1826:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 1827:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 1828: 
 1829:    // Neither of the interpolated velocities should be NaN
 1830:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 1831: 
 1832: }
 1833: 
 1834: 
 1835: 
 1836: __inline__ __device__ double Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 1837: __inline__ __device__ double Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 1838: __inline__ __device__ Point2 Side::p_t(double t) const { return {x(t), y(t)}; }
 1839: __inline__ __device__ int    Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 1840: __inline__ __device__ double Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 1841: __inline__ __device__ double Side::depth(void)   const { return 0.5*(n1->depth + n2->depth); }
 1842: 
 1843: __inline__ __device__ double Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 1844: __inline__ __device__ double Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 1845: __inline__ __device__ double Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 1846: 
 1847: 
 1848: __inline__ __device__ double Side::Cd(void)      const { if constexpr(nchi != 0) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 1849: 
 1850: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 1851: 
 1852: /**
 1853:  * This method performs backtracking from the side center until a time -dt back in time 
 1854:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 1855:  * intermediate point.
 1856:  *
 1857:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 1858:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 1859:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 1860:  * remaining time.
 1861:  * 
 1862:  * NOTE: Runge-Kutta is not implemented yet. XXX
 1863:  * 
 1864:  * @param uuint, vvint, wwint: Velocities at the final point
 1865:  * @param jlev: Level at which the backtracking is performed
 1866:  * @param dt, dtbk: Tracking timesteps
 1867:  * @return: True if the backtracking was successful, false otherwise
 1868:  */
 1869: __inline__ __device__ bool Side::btrack(
 1870:       int jlev,
 1871:       double dt,            // Tracking time
 1872:       double dtbk,          // Tracking timestep
 1873:       Vector3 &u_int
 1874: ) const {
 1875: 
 1876:    // Start from side center
 1877:    Point3 x0 = {center.x, center.y, zc[jlev]};
 1878:  
 1879: 
 1880:    double time_rm = dt; // Remaining time
 1881: 
 1882: 
 1883:    // // Initialize outputs XXX
 1884:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 1885:    //    sclr[i] = 0.0;
 1886:    // }
 1887: 
 1888: 
 1889:    // Initial velocities
 1890:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 1891: 
 1892:    // Find the element that is in the direction opposite to the velocity
 1893:    Element* curElem = findElementTowards({u_int.x, u_int.y});
 1894: 
 1895: 
 1896:    const int MAX_ITERATIONS = 1000; 
 1897:    Element* nextElem = curElem;
 1898:    int iter = 0;
 1899:    while(true) {
 1900:       // Calculate timestep
 1901:       double dtb = min(dtbk, time_rm);
 1902: 
 1903:       // Next point in the backtracking curve
 1904:       Point3 xt = x0 - dtb*u_int;
 1905: 
 1906:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb);
 1907:       assert(found && "Backtracking failed in btrack");
 1908: // printf("<>T = %f, %f %f %f\n", time_rm - dtb, xt, yt, zt);
 1909:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 1910:                       // then time_rm needs to be increased by the unused time.
 1911: 
 1912: 
 1913:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 1914: 
 1915:       // The current point becomes the next segment's starting point.
 1916:       x0 = xt;
 1917:  
 1918:       curElem = nextElem;
 1919: 
 1920:       iter++;
 1921:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 1922:    }
 1923: 
 1924: 
 1925: }
