 1922: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 1923: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 1924: 
 1925: //       if (delta != 0.0) {
 1926: //          // Solves the two linear equations for tt1 and tt2
 1927: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1928: //          const double tt2 = delta2/delta;
 1929: 
 1930: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
