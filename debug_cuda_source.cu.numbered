 1123: 
 1124: /**
 1125:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1126:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1127:    If the segment is completely inside the element, then it returns true.
 1128: 
 1129:    This function assumes:
 1130:    - The initial point is on a side of the element. 
 1131:    - Its position is given by parameter t in the range [0,1].
 1132:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1133:       intersects the element (elements are convex).
 1134: 
 1135:    To find the intersection point, this function does the following:
 1136:    - it finds the intersection of the line segment with all the element side lines,
 1137:       except for the one that contains the initial point.
 1138:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1139:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1140:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1141:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1142:       track segment is almost parallel to the element side line.
 1143: 
 1144:    Inputs:
 1145:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1146:    @param x2, y2: other end of the line segment
 1147: 
 1148:    Outputs:
 1149:    @param side:  side that intersects the line segment (input and output)
 1150:    @param nextElement (output): element that contains the intersection point
 1151:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1152:    @param zint (input/output): Vertical coordinate of the intersection point
 1153: 
 1154:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1155:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1156:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1157: 
 1158:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1159:    (Delta) being zero.
 1160: 
 1161:    The intersection2 point happens when:
 1162:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1163:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1164:    
 1165:    Assumption: the 4 points (including those of the side segment) are different.
 1166:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1167:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1168:    If true, (xIntersect,yIntersect) is the intersection.				
 1169:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1170: **/
 1171: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1172:                                               double &t, double& tIntersect) {
 1173: 
 1174:    double closest_intersect_t = 1e10;
 1175:    bool found_intersection = false;
 1176: 
 1177:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1178:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1179:    const Point2 x1 = side->point(t);
 1180:    
 1181: 
 1182:    Side *nextSide = nullptr;
 1183: 
 1184:    for (int i = 0; i < i34; i++) {
 1185: 
 1186:       // Element's i-th side 
 1187:       Side *side2 = sides[i];
 1188: 
 1189:       // Skip the side that contains the initial point
 1190:       if (side2 == side) continue;
 1191: 
 1192:       // (x3,y3)-(x4,y4) is the element side line
 1193:       const Point2 x3 = side2->n1->p2();
 1194:       const Point2 x4 = side2->n2->p2();
 1195: 
 1196:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1197:       const double delta = cross(x2 - x1, x3 - x4);
 1198: 
 1199:       if (delta != 0.0) {
 1200: 
 1201:          const double delta1 = cross(x3 - x1, x3 - x4);
 1202:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1203: 
 1204:          // Solves the two linear equations for tt1 and tt2
 1205:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1206:          const double tt2 = delta2/delta;
 1207: 
 1208:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1209:             closest_intersect_t = min(closest_intersect_t, tt1);
 1210:             nextSide = side2;
 1211: 
 1212:             nextElement = nextSide->otherElem(this);
 1213:             tIntersect = max(small, min(tt1, 1.0-small));
 1214:             t = tt2;
 1215: 
 1216:             found_intersection = true;
 1217:          }
 1218:       
 1219:       }
 1220: 
 1221:    }
 1222: 
 1223: 
 1224:    // found_intersection should always be true, since we checked all the sides.  
 1225:    side = nextSide;
 1226: // if (found_intersection) {
 1227: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1228: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1229: // }   
 1230:    return found_intersection;
 1231: }
 1232: 
 1233: 
 1234: 
 1235: 
 1236: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1237:                                               double &t, double& tIntersect) {
 1238: 
 1239:    double closest_intersect_t = 1e10;
 1240:    bool found_intersection = false;
 1241: 
 1242:    for (int i = 0; i < i34; i++) {
 1243: 
 1244:       Side *side2 = sides[i];
 1245: 
 1246:       // (x3,y3)-(x4,y4) is the element side line
 1247:       const Point2 x3 = side2->n1->p2();
 1248:       const Point2 x4 = side2->n2->p2();
 1249: 
 1250:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1251:       const double delta = cross(x2 - x1, x3 - x4);
 1252: 
 1253:       if (delta != 0.0) {
 1254: 
 1255:          const double delta1 = cross(x3 - x1, x3 - x4);
 1256:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1257: 
 1258:          // Solves the two linear equations for tt1 and tt2
 1259:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1260:          const double tt2 = delta2/delta;
 1261: 
 1262:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1263:             closest_intersect_t = min(closest_intersect_t, tt1);
 1264:             side = side2;
 1265:             nextElement = side->otherElem(this);
 1266:             t = tt2;
 1267:             tIntersect = max(small, min(tt1, 1.0-small));
 1268:             found_intersection = true;
 1269:          }
 1270:       
 1271:       }
 1272: 
 1273:    }
 1274: 
 1275: // if (found_intersection) {
 1276: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1277: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1278: // }
 1279: 
 1280:    // found_intersection should always be true, since we checked all the sides.  
 1281:    return found_intersection;
 1282: }
 1283: 
 1284: 
 1285: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1286:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1287: 
 1288:    printf("Tracking segment goes out of water at element %d\n", curElem->idx);
 1289: 
 1290:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1291:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1292:    // curElement.
 1293: 
 1294:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1295:    // And uses this velocity instead to continue the tracking.
 1296: 
 1297:    // computes the intersection point in cartesian coordinates
 1298:    Point2 intersection = nextSide->p_t(tt);
 1299: 
 1300:    // Nudges the point to the barycenter of the element. 
 1301:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1302:    // next segment intersects the element sides.  
 1303:    curElem->nudgeToBarycenter(intersection);
 1304: 
 1305:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1306:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1307:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1308:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1309: 
 1310:    // If the side is an open boundary, the tangential velocity is zero.
 1311:    if (nextSide->isBnd()) vtan = 0.0;
 1312: 
 1313:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1314:    const double us = vtan*nextSide->t().x;
 1315:    const double vs = vtan*nextSide->t().y;
 1316:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1317: 
 1318:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1319:    const double len2 = length(intersection - toPoint2(xt));
 1320:    const double vel2 = u_int.x*u_int.x + u_int.y*u_int.y;        
 1321:    assert(vel2 > 0.0 && "Zero velocity found");
 1322:    dt = dt - sqrt(len2/vel2); 
 1323: 
 1324:    // The end of this tracking segment is now the intersection point.
 1325:    xt = {intersection.x, intersection.y, zint};
 1326:    
 1327:    u_int = {us, vs, ws};
 1328:    
 1329: }
 1330: 
 1331: /**
 1332:  * Tracks a particle through elements and vertical levels in the mesh.
 1333:  * 
 1334:  * @param x0,y0,z0     Starting position coordinates
 1335:  * @param xt,yt,zt     Target position coordinates
 1336:  * @param dtb          Time step for tracking
 1337:  * @param uuint,vvint,wwint Initial velocity components
 1338:  * @param nextElem     Starting/resulting element index
 1339:  * 
 1340:  * @return Status code of type trackExitCodes
 1341:  * 
 1342:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1343:  * of the details are different. The idea is that the code requires less branches and is better fit
 1344:  * for GPU execution.
 1345:  * 
 1346:  * The main ideas here are:
 1347:  * - The starting point is expected to be in the starting element.
 1348:  * - The end point is guaranteed to be inside an element.
 1349:  * - since the starting point is inside the element, there are only two cases: 
 1350:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1351:  *     (b) it does not and (xt,yt) is already in the starting element.
 1352:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1353:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1354:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1355:  * - tt1 can be positive or negative. We only consider the positive values.
 1356:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1357:  * - The next intersection will occur at the smallest positive tt1.
 1358:  * - This intersection will be the next (x0,y0) position.
 1359:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1360:  *   of getting stuck in a loop.
 1361:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1362:  *   was found.
 1363:  */
 1364: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1365:                                                        Element *&nextElem, int &jlev, double &dt) {
 1366: // printf("trackThroughElementsAndLevels: x0=%f, y0=%f, xt=%f, yt=%f\n", x0, y0, xt, yt);
 1367:    // First thing is to check if the target point is inside the element. If it is there is nothing
 1368:    // else to do.
 1369:    if (containsPoint(toPoint2(xt))) {
 1370:       nextElem->interpolateVelocities(xt, u_int);
 1371:       return true;
 1372:    }
 1373: 
 1374:    Side *side = nullptr;
 1375: 
 1376:    // 1. Initial checks
 1377:    // Verify starting element is valid (wet)
 1378:    assert(!nextElem->idry && "Starting element is dry");
 1379: 
 1380:    // Checks if track has a zero length.
 1381:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1382:    assert(len2 > 0.0 && "Zero length track"); 
 1383:    
 1384: 
 1385:    const int MAX_ITERATIONS = 1000;
 1386:    
 1387:    double t;
 1388:    Side *nextSide = nullptr;
 1389:    double tIntersect = 1e10;
 1390:    double zint = x0.z;
 1391: 
 1392:    // Horizontal tracking loop
 1393:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1394:    // (x0,y0) is inside the element but the target point is not.
 1395:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1396:    assert(found_intersection && "No intersection found");
 1397: 
 1398:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1399: 
 1400:    // if the tracking segment goes out of water (either dry or edge boundary)
 1401:    if (isEdgeBoundary(nextSide) || (nextElem->idry)) {
 1402:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1403:       nextElem = this;
 1404:       
 1405:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1406:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1407:       return true;    
 1408:       }
 1409: 
 1410:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1411:    int iterations = 0;
 1412:    while (iterations < MAX_ITERATIONS) {
 1413:       iterations++;
 1414:       
 1415:       Element *curElem = nextElem;
 1416: 
 1417:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1418:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1419: 
 1420:       // If we are already in the target element, we are done.
 1421:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1422:       if (!found_intersection) break;
 1423: 
 1424: 
 1425:   
 1426:       // if the tracking segment goes out of water (either dry or edge boundary).
 1427:       if (curElem->isEdgeBoundary(nextSide) || (nextElem->idry)) {
 1428: 
 1429:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1430: 
 1431:          nextElem = curElem;
 1432: 
 1433:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1434:          // In this case, the caller (btrack) needs to take into account the remaining time.
 1435:          return true;
 1436:       }
 1437:       
 1438:       // Update position and element for next iteration
 1439:       side = nextSide;
 1440: 
 1441:    }
 1442: 
 1443: 
 1444:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 1445: 
 1446:  
 1447:    // Interpolate velocities at the final position. This is a conceptually simple step,
 1448:    // but the function is not simple, because it has to search for the vertical level containing zt.
 1449:    nextElem->interpolateVelocities(xt, u_int);
 1450: 
 1451: 
 1452:    return true;
 1453: }
 1454: 
 1455: 
 1456: 
 1457: 
 1458: __inline__ __device__ double Element::computeSignedArea(void) const {
 1459:    // Compute the area of the element
 1460: 
 1461:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 1462: 
 1463:    // In the quad case we need to add the area of the other triangle.
 1464:    if (isQuad()) {
 1465:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1466:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 1467:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1468:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 1469:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 1470:          Error("Negative area found in quad element");
 1471:       }
 1472:       res += ar1;
 1473:    }
 1474: 
 1475:    return res;
 1476: }
 1477: 
 1478: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 1479:    // In boundary sides, the element 1 is nullptr
 1480:    return side->elems[1] == nullptr; 
 1481: }
 1482: 
 1483: /**
 1484:    Compute the shape coordinates of the point (xt,yt) in the element.
 1485:    @param xt (input): x-coordinate of the point
 1486:    @param shpCoords (output): shape coordinates of the point
 1487:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 1488:    @return true if the point is inside the element, false otherwise
 1489: **/
 1490: __device__ bool Element::computeShapeCoords(Point2 xt, double shpCoords[4],
 1491:                                             bool fixNegshpCoord) const {
 1492: 
 1493:    // Compute the shape coordinates of the point xt in the element.
 1494:    if (i34==3) {
 1495:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 1496:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 1497:       // and in this case, the pt will be nudged into the element
 1498:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 1499:       // from the local frame, so use additional check.
 1500: 
 1501:       Point2 x0, x1, x2;
 1502: 
 1503:       if constexpr(ics==1) {
 1504:          x0 = nodes[0]->p2();
 1505:          x1 = nodes[1]->p2();
 1506:          x2 = nodes[2]->p2();
 1507:       }
 1508:       else // lat/lon
 1509:       {
 1510:          Error("Not implemented yet");
 1511: #ifdef ICS2
 1512:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 1513:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 1514:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 1515: #endif
 1516:       }
 1517: 
 1518:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 1519:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 1520:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 1521:       shpCoords[3] = 0.0;
 1522:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 1523: 
 1524:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 1525:       // then we fix the negative shape coordinates.
 1526:       if (fixNegshpCoord && tmpmin<=0.0) {
 1527: 
 1528:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 1529:          // keeping the sum of the shape coordinates equal to 1.
 1530:          // I have tested and compared the new algorithm with the old one, and they give
 1531:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 1532:          // The new algorithm should be faster since it is branchless.
 1533:          const double a = - tmpmin + 1.0e-2;  // XXX it used to be 1.0e-4 in the comments of the original code
 1534:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 1535:          
 1536:          shpCoords[0] = (shpCoords[0] + a)*b;
 1537:          shpCoords[1] = (shpCoords[1] + a)*b;
 1538:          shpCoords[2] = (shpCoords[2] + a)*b;          
 1539: 
 1540:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 1541:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 1542:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 1543:          }
 1544: 
 1545:          // Update the point coordinates for the new shape coordinates
 1546:          double xcoords[3] = {x0.x, x1.x, x2.x};
 1547:          double ycoords[3] = {x0.y, x1.y, x2.y};
 1548:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 1549: 
 1550:       }
 1551: 
 1552:       // Check if the point is inside the element
 1553:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 1554:    }
 1555:    else {
 1556:       Error("Not implemented yet");
 1557: #ifdef QUADS
 1558:       // Reproject pt in eframe of nel for ics=2
 1559:       if constexpr(ics==1) {
 1560:          xn2 = xt; 
 1561:          yn2 = yt;
 1562:       }
 1563:       else {
 1564:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 1565:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 1566:       }
 1567: 
 1568:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 1569: #endif
 1570:    }
 1571: 
 1572: }
 1573: 
 1574: 
 1575: /**  Interpolate velocities at a given point (xt,yt,zt)
 1576: 
 1577:    @param xt, yt, zt: coordinates of the point to interpolate
 1578:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 1579: 
 1580:    This is done in four steps:
 1581: 
 1582:    1. Find the shape coordinates for the final position in the element.
 1583:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 1584:    3. Perform a *binary search* to find the vertical level containing zt. It will have to interpolate the 
 1585:       z levels at xt, yt at each step.   
 1586:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 1587:       horizontally and vertically.
 1588: **/
 1589: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) {
 1590:    // Interpolate the velocities at the point xt. 
 1591:    // This function works the same for triangular and quadrilateral elements.
 1592:    double shpCoord[4];
 1593: 
 1594: 
 1595:    // First step is to compute the shape coordinates of (xt,yt)
 1596:    computeShapeCoords(toVector2(xt), shpCoord, false);
 1597:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 1598: 
 1599:    // Second step is to find the level that contains zt
 1600:    // Uses a binary search to find the level
 1601:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 1602:    int L = kbe;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 1603:    int R = nvrt - 1;
 1604: 
 1605:    // Get the z coordinates at the nodes of the element at the levels L and R
 1606:    double zLAtNodes[4], zRAtNodes[4];
 1607:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 1608:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 1609: 
 1610:    double zL = interpolate(shpCoord, zLAtNodes);
 1611:    double zR = interpolate(shpCoord, zRAtNodes);
 1612:    
 1613:    // Interpolates vertically the velocities
 1614:    double wght1, wght2;
 1615:    if (xt.z<=zL) {
 1616:       wght1 = 1.0;
 1617:       wght2 = 0.0;
 1618:    }
 1619:    else if (xt.z>=zR) {
 1620:       wght1 = 0.0;
 1621:       wght2 = 1.0;
 1622:    }
 1623:    else {
 1624:       // Perform a binary search to find the levels between L and R that contain xt.z
 1625:       while (R - L > 1) {
 1626:          int M = (L + R) / 2;
 1627: 
 1628:          double zMAtNodes[4];
 1629:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 1630:          double zM = interpolate(shpCoord, zMAtNodes);
 1631:          if (zM < xt.z) 
 1632:          {
 1633:             L = M;
 1634:             zL = zM;
 1635:          }
 1636:          else 
 1637:          {
 1638:             R = M;
 1639:             zR = zM;
 1640:          }
 1641:       }
 1642:       assert(L == R-1);
 1643:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 1644: 
 1645:       wght2 = (xt.z - zL)/(zR - zL);
 1646:       wght1 = 1.0 - wght2;
 1647:    }
 1648: // printf("$$$ wght1 = %f, wght2 = %f, zt = %f, zL = %f, zR = %f\n", wght1, wght2, zt, zL, zR);
 1649: // printf("$$$ shpCoord = %f, %f, %f, %f\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 1650:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 1651:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 1652: 
 1653:    // Neither of the interpolated velocities should be NaN
 1654:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 1655: 
 1656: }
