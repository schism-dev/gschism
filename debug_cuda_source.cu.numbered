 3010:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3011: 
 3012:       NODE_BND(nodeBnd);
 3013: 
 3014:       Node *node = nodeBnd->node;
 3015: 
 3016:       printf("computeTidalPotential: nodeIdx = %d, ntip = %d\n", node->idx, ntip);
 3017:       node->ETP = 0.0;
 3018: 
 3019:       for (int j=0; j<ntip; j++) {
 3020: 
 3021:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3022:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3023:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3024: 
 3025:          if constexpr(iloadtide==1) { // loading tide
 3026:             assert(true && "Loading tide not implemented");
 3027:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3028:          }
 3029:          
 3030:       }
 3031:       
 3032:    }
