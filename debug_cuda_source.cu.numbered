  121: // VECTOR/POINT operations ---------------------------------------------------------------------------
  122: 
  123: using Vector2 = double2; 
  124: using Vector3 = double3;
  125: using Point2  = double2;
  126: using Point3  = double3;
  127: 
  128: __device__ __host__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
  129:     return make_double2(a.x + b.x, a.y + b.y);
  130: }
  131: 
  132: __device__ __host__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
  133:     a.x += b.x;
  134:     a.y += b.y;
  135:     return a;
  136: }
  137: 
  138: __device__ __host__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
  139:     return make_double2(a.x - b.x, a.y - b.y);
  140: }
  141: 
  142: __device__ __host__ __forceinline__ double2 operator-=(double2& a, const double2& b) {
  143:     a.x -= b.x;
  144:     a.y -= b.y;
  145:     return a;
  146: }
  147: 
  148: __device__ __host__ __forceinline__ double2 operator*(const double2& v, const double s) {
  149:     return make_double2(v.x * s, v.y * s);
  150: }
  151: 
  152: __device__ __host__ __forceinline__ double2 operator*(const double s, const double2& v) {
  153:     return v * s;  // reuse the previous operator
  154: }
  155: 
  156: __device__ __host__ __forceinline__ double2 operator/(const double2& v, double s) {
  157:     return make_double2(v.x / s, v.y / s);
  158: }
  159: 
  160: __device__ __host__ __forceinline__ double length(const double2& v) {
  161:     return sqrt(v.x*v.x + v.y*v.y);
  162: }
  163: 
  164: __device__ __host__ __forceinline__ double2 normalize(const double2& v) {
  165:     return v / length(v);
  166: }
  167: 
  168: __device__ __host__ __forceinline__ double dot(const double2& v, const double2& w) {
  169:     return v.x*w.x + v.y*w.y;
  170: }
  171: 
  172: __device__ __host__ __forceinline__ double cross(const double2& v, const double2& w) {
  173:     return v.x*w.y - v.y*w.x;
  174: }
  175: 
  176: __device__ __host__ __forceinline__ double3 operator+(const double3& a, const double3& b) {
  177:     return make_double3(a.x + b.x, a.y + b.y, a.z + b.z);
  178: }
  179: 
  180: __device__ __host__ __forceinline__ double3 operator+=(double3& a, const double3& b) {
  181:     a.x += b.x;
  182:     a.y += b.y;
  183:     a.z += b.z;
  184:     return a;
  185: }
  186: 
  187: __device__ __host__ __forceinline__ double3 operator-(const double3& a, const double3& b) {
  188:     return make_double3(a.x - b.x, a.y - b.y, a.z - b.z);
  189: }
  190: 
  191: __device__ __host__ __forceinline__ double3 operator*(const double3& v, double s) {
  192:     return make_double3(v.x * s, v.y * s, v.z * s);
  193: }
  194: 
  195: __device__ __host__ __forceinline__ double3 operator*(double s, const double3& v) {
  196:     return v * s;
  197: }
  198: 
  199: __device__ __host__ __forceinline__ double3 operator/(const double3& v, double s) {
  200:     return make_double3(v.x / s, v.y / s, v.z / s);
  201: }
  202: 
  203: __device__ __host__ __forceinline__ double dot(const double3& v, const double3& w) {
  204:     return v.x*w.x + v.y*w.y + v.z*w.z;
  205: }
  206: 
  207: __device__ __host__ __forceinline__ Vector2 toVector2(const double3& v) {
  208:     return make_double2(v.x, v.y);
  209: }
  210: 
  211: __device__ __host__ __forceinline__ double3 toVector3(const double2& v, double w) {
  212:     return make_double3(v.x, v.y, w);
  213: }
  214: 
  215: __device__ __host__ __forceinline__ Point2 toPoint2(const double3& p) {
  216:     return make_double2(p.x, p.y);
  217: }
  218: 
  219: __device__ __host__ __forceinline__ Point3 toPoint3(const double2& p, double z) {
  220:     return make_double3(p.x, p.y, z);
  221: }
