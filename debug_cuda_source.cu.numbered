  967:    //    return elems[idx] + idx;
  968:    // }
  969: 
  970:    // // Get's the pointer to the side using the array of global pointers to sides
  971:    // __device__ const Side *getGlobalSide(int js) {
  972:    //    const int idx = js / max_ns; // Get the index of the partition that contains the side
  973:    //    return sides[idx] + idx;
  974:    // }
  975: 
  976:    // // Get's the global index of local node idx
  977:    // __device__ int getGlobalNodeIndex(int idx) {
  978:    //    return idx + partNum * max_np;
  979:    // }
  980: 
  981:    // // Get's the global index of local element idx
  982:    // __device__ int getGlobalElemIndex(int idx) {
  983:    //    return idx + partNum * max_ne;
  984:    // }
  985: 
  986:    // // Get's the global index of local side idx
  987:    // __device__ int getGlobalSideIndex(int idx) {
  988:    //    return idx + partNum * max_ns;
  989:    // }  
  990: 
  991:    __device__ Mesh(int partNum,
  992:                    int npgb, int negb, int nsgb, 
  993:                    int np, int ne, int ns, int nvrt, int kz,
  994:                    int max_np, int max_ne, int max_ns, int nseg,
  995:                    const Node **nodesPtr, const Element **elemsPtr, const Side **sidesPtr,
  996:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
  997:                    Node    **localNodeNeighNodesMem,
  998:                    Element **localNodeNeighElemsMem,
  999:                    NodeBoundary *localNodeBoundaryMem,
 1000:                    SideBoundary *localSideBoundaryMem,
 1001:                    BoundarySegment *localSegmentMem,
 1002:                    double h_s, double theta_b, double theta_f, double *sigma_lcl, double *sigma, double *ztot,
 1003:                    double *cs, double *dcs
 1004:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 1005:                        np(np), ne(ne), ns(ns),
 1006:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
 1007:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
 1008:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
 1009:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
 1010:                        localNodeBoundaryMem(localNodeBoundaryMem), localSideBoundaryMem(localSideBoundaryMem),
 1011:                        localSegmentMem(localSegmentMem),
 1012:                        h_s(h_s), theta_b(theta_b), theta_f(theta_f), sigma_lcl(sigma_lcl), sigma(sigma), ztot(ztot),
 1013:                        cs(cs), dcs(dcs)
