  801: struct Node {
  802: 
  803:    // Geometry information
  804:    int idx;        // Index of the node
  805:    Node **nodes;   // pointer to the nodes that are neighbors of this node (there is no guarantee that they are connected)
  806:    int numNodes;   // number of nodes neighbors of this node
  807: 
  808:    Element **elements; // pointer to the elements that share this node
  809:    int numElements;   // number of elements that share this node
  810: 
  811:    Point3 p;
  812:    Vector3 u2[nvrt];
  813:    double znl[nvrt];
  814:    double lon, lat;
  815:    double depth;
  816: 
  817:    int kb;       // Bottom index of the node
  818: 
  819:    int idry;     // True if the node is dry
  820: 
  821:    int iadv;     // Advection flag
  822: 
  823:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
  824: 
  825:    // Physical information
  826:    Tracers tr_nd0[nvrt]; // Initial tracer conc. at nodes
  827: 
  828:    double rho[nvrt];     // Density
  829: 
  830:    double eta1; // Elevation at nodes at previous timestep
  831:    double eta2; // Elevation at nodes at current timestep
  832: 
  833:    double etp;  // Earth Tidal Potential
  834: 
  835:    
  836:    double pr;    // Air pressure
  837:    double grav2; // Gravity 
  838:    
  839:    Vector2 dav;  // Depth averaged velocity
  840: 
  841:    Vector2 tau; // Wind stress vector
  842: 
  843:    // Vegetation parameters
  844:    double veg_h;
  845:    double veg_nv;
  846:    double veg_di;
  847:    double veg_Cd;
  848:    double veg_h_unbent;
  849:    double veg_di_unbent;
  850:    double veg_nv_unbent;
  851:    double veg_alpha_vert_mean;
  852:    double veg_alpha0;
  853:    double veg_alpha3D[nvrt];
  854: 
  855:    // Bottom drag parameters
  856:    double Cd;       // Bottom drag coefficient
  857:    double rough;    // Bottom roughness length
  858:    Vector2 tau_bot; // Bottom stress vector
  859: 
  860:    double bdef1; // Bottom deformation at previous timestep
  861:    double bdef2; // Bottom deformation at current timestep
  862: 
  863:    double qel; // RHS
  864: 
  865:    __host__ __device__ Point2 p2(void) const { return {p.x, p.y}; }
  866: 
  867:    __host__ __device__ double sigmaTransitionDepth(void) const;
  868: 
  869:    __inline__ __device__ double Dz(int k) const { return znl[k] - znl[k-1]; }
  870:    __inline__ __device__ double htot(void) const { return eta2 + depth; }
  871:    __inline__ __device__ double zTopCanopy(void) const { return znl[kb] + veg_h; } 
  872: 
  873:    __device__ void clearMatrixRow(void) {
  874:       // Clear the matrix row for this node
  875:       printf("NOT IMPLEMENTED: clearMatrixRow\n");
  876:    }
  877: 
  878:    __device__ void addToSparseMatrix(Node const *node, double value) {
  879:       // Add the value to the sparse matrix for this node
  880:       printf("NOT IMPLEMENTED: addToSparseMatrix\n");
  881:    }
  882: 
  883: #ifdef BACKTRACKING
  884:    __device__ void updateZCoordData() {
  885:    // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
  886: 
  887:       // Check if node is wet
  888:       idry = (depth + eta2 <= h0);  // XXX Check if we are doing this elsewhere
  889: 
  890:       if (idry) return;
  891: 
  892:       if constexpr(ivcor == 2) {  // SZ coordinates
  893:          
  894:          // Compute bottom level index
  895:          if (depth <= mesh->h_s) {
  896:                kb = mesh->nzlevels;
  897:          } else {
  898:                kb = -1;
  899:                for (int i = 0; i < mesh->kz-1; i++) {
  900:                   if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
  901:                      kb = i;
  902:                      break;
  903:                   }
  904:                }
  905:          }
  906:       } 
  907:       else if (ivcor == 1) {  // Localized sigma
  908:          // Do nothing
  909:       }
  910: 
  911:    }
  912: #endif   
  913: 
  914:    __device__ double compZCoord(int k) const;
  915: 
  916: 
  917: 
  918: };
