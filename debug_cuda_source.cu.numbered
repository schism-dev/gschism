  719: #ifdef BACKTRACKING
  720:    __device__ void updateZCoordData() {
  721:    // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
  722: 
  723:       // Check if node is wet
  724:       idry = (depth + eta2 <= h0);  // XXX Check if we are doing this elsewhere
  725: 
  726:       if (idry) return;
  727: 
  728:       if constexpr(ivcor == 2) {  // SZ coordinates
  729:          
  730:          // Compute bottom level index
  731:          if (depth <= mesh->h_s) {
  732:                kb = mesh->nzlevels;
  733:          } else {
  734:                kb = -1;
  735:                for (int i = 0; i < mesh->kz-1; i++) {
  736:                   if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
  737:                      kb = i;
  738:                      break;
  739:                   }
  740:                }
  741:          }
  742:       } 
  743:       else if (ivcor == 1) {  // Localized sigma
  744:          // Do nothing
  745:       }
  746: 
  747:    }
  748: #endif   
  749: 
  750:    __device__ double compZCoord(int k) const;
  751: 
  752: 
  753: 
  754: };
