  755: // This struct is used to store the boundary information for a node.
  756: struct NodeBoundary {   
  757:    BoundarySegment *segment;
  758:    Node *node;
  759:    
  760:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
  761:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
  762: 
  763:    double etaic;  // Elevation at nodes used for essential boundary conditions
  764:    double elbc;   // Elevation boundary condition
  765:    int iettype;   // Type of elevation boundary condition
  766:    double eth;    // Elevation time history
  767: 
  768:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
  769:       assert(index == 0 || index == 1); 
  770:       return (index == 0) ? sideBnd1 : sideBnd2; 
  771:    }
  772: };
