 2960: extern "C" {
 2961: 
 2962:    __global__ void scaleGravity(double loadtide_coef) {
 2963: 
 2964:       printf("scaleGravity: i = %d, np = %d\n", threadIdx.x + blockIdx.x * blockDim.x,mesh->np);
 2965:       NODE(node);
 2966: 
 2967:       // SAL option: scale gravity
 2968:       if constexpr(iloadtide==2) {  // simple const
 2969:          node->grav2 = grav*(1.0 - loadtide_coef);
 2970: 
 2971:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 2972:         
 2973:           const double depth = max(node->depth, 0.0);
 2974:           const double tmp1 = sqrt(depth);
 2975:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 2976:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 2977:                              2.6969e-13*depth*depth*depth*tmp1;
 2978:           
 2979:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 2980:           
 2981: 
 2982: 
 2983:           node->grav2 = grav*(1.0 - beta_bar);
 2984: 
 2985:       } else {  // iloadtide=0,1
 2986:         node->grav2=grav;
 2987: 
 2988:       }
 2989: 
 2990:       printf("scaleGravity: node(%d)->grav2 = %f\n", node->idx, node->grav2);
 2991:    }
 2992: 
 2993: 
 2994:    __global__ void computeTidalPotential(double time, int ntip, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 2995: 
 2996:       NODE(node);
 2997: 
 2998:       printf("computeTidalPotential:  ntip = %d\n",  ntip);
 2999:       node->ETP = 0.0;
 3000: 
 3001:       for (int j=0; j<ntip; j++) {
 3002: 
 3003:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3004:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3005:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3006: 
 3007:          if constexpr(iloadtide==1) { // loading tide
 3008:             assert(true && "Loading tide not implemented");
 3009:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3010:          }
 3011:          
 3012:       }
 3013:       
 3014:    }
 3015: 
 3016: 
 3017:    __global__ void computeElevationBoundaryConditions(double ramp, double time) {
 3018:       // Compute elevation essential boundary conditions 
 3019: 
 3020:       NODE_BND(nodeBnd); // Each boundary node.
 3021: 
 3022:       const Node *node = nodeBnd->node;
 3023:       const int iettype = nodeBnd->iettype;
 3024: 
 3025:       double eic = 0.0;
 3026:       if (nramp_elev==1) eic = nodeBnd->etaic;
 3027:       else               eic = 0.0;
 3028: 
 3029:       const double r_eic = (1.0 - ramp)*eic; 
 3030:       const double r_eth = ramp*nodeBnd->eth;
 3031:       double eta1_bar = r_eic;
 3032: 
 3033:       // Compute tide elevation
 3034:       if (iettype == 3 || iettype == 5) {
 3035:         
 3036:          // XXX IMPLEMENT TIDE THINGS
 3037:          assert(true && "Tide elevation not implemented");
 3038:          // for (int jfr=0; jfr<nbfr; jfr++) { // For all tide frequencies
 3039:          //    const int ncyc = int(amig[jfr]*time/(2.0*pi));
 3040:          //    const double arg = amig[jfr]*time - 2.0*pi*ncyc + face[jfr] - efa[i,j,jfr];
 3041:          //    eta1_bar += ramp*ff[jfr]*emo[i,j,jfr]*cos(arg);
 3042:          // } // for jfr
 3043:       } // if iettype
 3044: 
 3045:       switch (iettype) {
 3046:          case 1:
 3047:          case 2:
 3048:             nodeBnd->elbc = r_eth + r_eic;
 3049:             break;
 3050:          case 3:
 3051:             nodeBnd->elbc = eta1_bar + r_eic;
 3052:             break;
 3053:          case 4:
 3054:             nodeBnd->elbc = r_eth + r_eic;
 3055:             break;
 3056:          case 5:
 3057:             nodeBnd->elbc = r_eth + eta1_bar + r_eic;
 3058:             break;
 3059:       } // switch
 3060: 
 3061: 
 3062:       //Add inverse barometric effects
 3063:       if (iettype != 0 && inv_atm_bnd == 1) {
 3064:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 3065:       }
 3066: 
 3067:    }
 3068: 
 3069:    __device__ void computeVerticallyIntegratedVelocity(void) {
 3070: 
 3071:       SIDE(side);
 3072: 
 3073:       side->U = {0.0, 0.0}; 
 3074:          
 3075:       if(side->idry) return;
 3076: 
 3077:       const Node *node1 = side->n1;
 3078:       const Node *node2 = side->n2;
 3079: 
 3080:       // Vertically integrated velocity U (in ll if ics=2)
 3081:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 3082:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 3083:       }
 3084: 
 3085:    }
 3086: 
 3087:    __global__ void computeBottomDragVegetation(void) {
 3088:       // UNFINISHED. CHECK THIS:
 3089:       // How many kernels are needed? Why so many for loops?
 3090:       // Is the loop on sides needed?
 3091: 
 3092:       NODE(node);
 3093: 
 3094:       const int    kb      = node->kb;
 3095:       const double htot    = node->htot();
 3096:       const double rough   = node->rough;
 3097: 
 3098: 
 3099:       if (node->idry) {
 3100:          // Default values for dry nodes
 3101:          node->veg_alpha_vert_mean = node->veg_alpha0;
 3102:          /// XXX CHECK INDICES
 3103:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 3104:       }
 3105: 
 3106:       // Compute bottom drag Cd
 3107:       //--------------------------------
 3108: 
 3109:       // nchi = {-1, 0, 1} is the type of bottom drag.
 3110:       if (nchi==1) {
 3111: 
 3112:          bool ltmp = false; // for WBL iteration
 3113: 
 3114:          // Cdmax=-1 !max. Cd at node for this process (info only)
 3115:          // Drag at nodes
 3116:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 3117:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 3118:         
 3119:          const double rough = node->rough;
 3120:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3121:          if (node->rough == 0.0) {
 3122:             node->Cd = 0.0;
 3123: 
 3124:          } else { //roughness >0 
 3125:             
 3126:             const double bthick_ori = node->znl[kb + 1] - node->znl[kb];  // thickness of bottom bnd layer
 3127:             const double bthick = max(dzb_min, bthick_ori);
 3128: 
 3129:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 3130: 
 3131:             double tmp = 1.0/(2.5*log(bthick/rough));
 3132:             node->Cd = tmp*tmp;
 3133: 
 3134:          } // if rough
 3135: 
 3136: 
 3137:          // RECOVER THIS: XXX
 3138:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 3139:          // Output warning for WBL if iteration didn't converge
 3140: 
 3141: 
 3142:       } // nchi==1
 3143: 
 3144:       //   Bottom stress in m^2/s^2
 3145:       if (node->rho[kb + 1] >= -98.0)
 3146:       {
 3147:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 3148:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 3149:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 3150:          // !sediment erosion: this part needs more documentation
 3151:       }
 3152: 
 3153:     
 3154:       // Compute vegetation parameters
 3155:       //--------------------------------
 3156: 
 3157:       // SAV constants
 3158:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 3159:       constexpr double veg_cfpsi = 0.16;
 3160: 
 3161:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 3162:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 3163: 
 3164:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 3165:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 3166:          int kbin = 0; // bin index
 3167:          for (int k = kb; k < nvrt; k++) {
 3168:             // Computes node height above the bottom level
 3169:             const double tmp_h = node->znl[k] - node->znl[kb]; // >=0
 3170:             assert(true && "Vertical variation of vegetation not implemented");
 3171: 
 3172:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 3173:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 3174:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 3175:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 3176:             // } else {
 3177:             //    // Find the bin at which the current vertical level is
 3178:             //    while (kbin<nbins_veg_vert) {
 3179:             //       const double zn = node->znl[kbin];
 3180:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 3181:             //          break;
 3182:             //       } // if
 3183:             //       kbin++;
 3184:             //    } // while
 3185:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 3186: 
 3187:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 3188:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 3189:                
 3190:             //    // Linear interpolation of the vegetation parameters
 3191:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 3192:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 3193:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 3194:             // } // if rl10
 3195: 
 3196:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 3197: 
 3198:          } // for k
 3199: 
 3200: 
 3201:       } else { // Ganthy (iveg=2)
 3202:       //  Modify canopy height, diameter, and density
 3203: 
 3204:          // Make sure there is vegetation on this node
 3205:          if (node->veg_h_unbent > 0.0) {
 3206:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 3207: 
 3208:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 3209:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 3210:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 3211: 
 3212:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 3213:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 3214:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 3215:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 3216:          } // if veg_h_unbent
 3217: 
 3218:          for (int k = 0; k < nvrt; k++) {
 3219:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 3220:          } // for k
 3221:       
 3222: 
 3223:       } // if iveg
 3224:      
 3225:          
 3226: 
 3227:       // Compute vertical mean of veg_alpha3D
 3228:       if (iveg != 0) {
 3229:          const double ztop = node->zTopCanopy(); // Top of the canopy
 3230:          double sum1=0.0;
 3231:          double sum2=0.0;
 3232:          // Integrate over each level under the canopy...
 3233:          for (int k=kb; k<nvrt-1 && node->znl[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 3234:             const double Dz = node->Dz(k);
 3235: 
 3236:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 3237:             sum2 += Dz;
 3238: 
 3239:          } // for k
 3240: 
 3241:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 3242:          else             node->veg_alpha_vert_mean = sum1/sum2;
 3243: 
 3244:       } // if iveg
 3245: 
 3246:    }
 3247: 
 3248:    __global__ void computeVegetationAndDragParameters(void) {
 3249:       // Computes the vegetation and drag model parameters:
 3250:       // chi, \tilde\chi, beta, \breve{H}
 3251:       
 3252:       SIDE(side);
 3253: 
 3254:       const double htot = side->htot();
 3255:       const int    kb   = side->kb;
 3256: 
 3257:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 3258: 
 3259:       const double veg_h     = side->veg_h();
 3260:       const double veg_nv    = side->veg_nv();
 3261:       const double veg_c     = side->veg_c();
 3262:       const double veg_beta  = side->veg_beta;
 3263:       const double veg_alpha = side->veg_alpha_vert_mean();
 3264: 
 3265:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 3266:       // Velocity magnitude at the bottom level
 3267:       // XXXX Check if we have add -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 3268:       assert(true && "Must use backtracked velocity");
 3269:       const double vmag1 = length(side->u2[kb + 1]); //BACKTRACKED VELOCITY
 3270:       side->chi2 = side->Cd()*vmag1;
 3271:       side->chi  = side->chi2;
 3272:       if constexpr(iveg != 0) {
 3273:          const Node *n1 = side->n1;
 3274:          const Node *n2 = side->n2;
 3275:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 3276:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 3277:       }
 3278: 
 3279:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 3280: 
 3281:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 3282:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 3283:       double magUa = 0.0;
 3284:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 3285:          // 3D wet side with veg...
 3286: 
 3287:          double magUa = 0.0;
 3288:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 3289:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 3290: 
 3291:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 3292:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 3293:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 3294: 
 3295:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 3296:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 3297: 
 3298:                // Velocity magnitude at the bottom (l) of the level
 3299:                const double ul = length(side->u2[k]);
 3300: 
 3301:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 3302:                magUa += Dz*0.5*(uh + ul);
 3303: 
 3304:             } // if HasVegetation
 3305:          } // for k
 3306:          const double ua = magUa/min(htot, veg_h); // Vertical average
 3307: 
 3308:          // Computes beta, used for computing the stress term at the top of the canopy.      
 3309:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 3310:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 3311:             const double zCpy = side->zTopCanopy();
 3312:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 3313:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 3314:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 3315:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 3316:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 3317:          } // if isSubmerged
 3318:       } // if iveg   
 3319: 
 3320:       // Computes the friction modified depth, \breve{H} in notes
 3321:       if (side->is2D()) { // 2D
 3322: 
 3323:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 3324:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 3325: 
 3326:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 3327: 
 3328:          side->hhat = htot*htot/fricH; 
 3329: 
 3330:       } else { // 3D
 3331:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 3332: 
 3333:          if constexpr(iveg != 0) {
 3334:             
 3335:             if (side->isSubmerged()) { 
 3336:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 3337:                side->hhat -= veg_c*Hhat_alpha;
 3338: 
 3339:             } else { // Emergent
 3340:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 3341:             }
 3342:          } // if iveg
 3343: 
 3344:          // Enforce positivity for 3D model
 3345:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 3346:       } // if 3D
 3347: 
 3348:         
 3349:    }
 3350: 
 3351: 
 3352: 
 3353:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 3354:    // Computes the density gradient between two elements, e1 and e2.
 3355:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 3356:    // zero in the direction normal to the side. 
 3357:    // 
 3358:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 3359:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 3360:    //
 3361:    // Input:
 3362:    //    e1: Element
 3363:    //    e2: Neighbor element (or nullptr if boundary)
 3364:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 3365:    //    k: Index of the half-level at which the density is interpolated
 3366:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 3367:    // 
 3368:    // Output:
 3369:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 3370:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 3371: 
 3372:       if (e2 == nullptr || e2->idry) {
 3373:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 3374: 
 3375:          Side *side = e1->sides[j];
 3376:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->idry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 3377:                  
 3378:          if constexpr(ics == 1) {
 3379:             vec = side->n; // Normal vector to the side
 3380:          } else {
 3381:             // IMPLEMENT THIS XXXXXX
 3382:             // !replace with xel, yel?
 3383:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 3384:             //      &eframe(:,:,i),xn1,yn1,tmp)
 3385:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 3386:             //      &eframe(:,:,i),xn2,yn2,tmp)
 3387:          } //ics
 3388:                    
 3389:          diffRho = 0.0;
 3390: 
 3391:       } else { //internal and wet
 3392:          if constexpr(ics==1) {
 3393:             assert(e2 != nullptr || e2->idry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 3394: 
 3395:             // Vector from e1 to e2
 3396:             vec = toVector2(e2->center - e1->center);
 3397: 
 3398:          } else { 
 3399:             // IMPLEMENT THIS XXXXXX
 3400:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 3401:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 3402:             //                   alow(j)=xctr2
 3403:             //                   bdia(j)=yctr2
 3404:          } // ics
 3405: 
 3406:          diffRho = rho2 - e1->demeanedDensity(k);
 3407:       }
 3408: 
 3409:    }
 3410: 
 3411:    __global__ void computeDensityCubicSplines(void) {
 3412:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 3413: 
 3414:       ELEM(elem);
 3415: 
 3416:       if (elem->idry) return;
 3417: 
 3418:       const int kb = elem->kb;
 3419: 
 3420:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 3421:       if (elem->is2D()) {
 3422:          // In the 2D case, the density is constant at the prism level. 
 3423:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 3424:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 3425:       } else { //3D
 3426: 
 3427:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 3428:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 3429:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 3430:          ///// XXXX CHECK INDICES!!!!!
 3431:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 3432:       } // 2D/3D
 3433: 
 3434:    }
 3435: } // extern "C"
 3436: 
 3437: 
 3438: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 3439: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 3440: 
 3441:    if (elem2 == nullptr || elem2->idry) return 0.0;
 3442: 
 3443:    const int kb  = elem->kb;
 3444:    const int kb2 = elem2->kb;
 3445: 
 3446:    // z-coordinate of prism of elem
 3447:    const double zp = elem->z_prism(k);
 3448: 
 3449:    double rho = 0.0;
 3450: 
 3451:    if (elem2->is2D()) {
 3452:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 3453: 
 3454:    } else {  // 3D
 3455: 
 3456:       // eta_min may be < zmax
 3457:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 3458:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 3459: 
 3460:       // (Extrapolate density below bottom, we will fix it later)
 3461:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 3462:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 3463:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 3464:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 3465:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 3466:    } // 2D/3D
 3467:      
 3468: 
 3469:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 3470:    // Now we need to fix it.
 3471:    if (elem->z[k] < elem2->z[kb2]) {
 3472:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 3473: 
 3474:       // There are two methods to adjust the density at the bottom of the element.
 3475:       // iunder_deep=0: 
 3476:       const double depth1 = abs(elem->z[kb]); // larger depth
 3477: 
 3478:       if (iunder_deep==0) {
 3479: 
 3480:          const double weight = max(0.0, min(1.0, (depth1 - h1_bcc)/(h2_bcc - h1_bcc))); // weight
 3481: 
 3482:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 3483: 
 3484:       } else { // iunder_deep != 0
 3485: 
 3486:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 3487: 
 3488:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 3489: 
 3490:          //   Demeaned density at the same z coordinate as
 3491:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 3492:          }
 3493: 
 3494:       } // if iunder_deep
 3495:    } // if elem->z[kb] < elem2->z[kb]
 3496: 
 3497:    return rho;
 3498: }
 3499: 
 3500: 
 3501: extern "C" {
 3502:    __global__ void computeDensityGradient(void) {
 3503: 
 3504:          // Compute the horizontal density gradient at each element.
 3505:       // It works in two steps:
 3506:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 3507:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 3508:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 3509:       //             gradRho.r1 = rho1 - rho0
 3510:       //             gradRho.r2 = rho2 - rho0
 3511:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 3512:       // 
 3513:       //  NOTE: We use de-meaned densities.
 3514: 
 3515:       ELEM(elem);
 3516: 
 3517:       if (elem->idry) return;
 3518: 
 3519:       const int kb  = elem->kb;
 3520:       const int i34 = elem->i34;
 3521: 
 3522:       for (int k = kb + 1; k < nvrt; k++) {
 3523:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 3524:          //             gradRho.r1 = rho1 - rho0
 3525:          //             gradRho.r2 = rho2 - rho0
 3526:          int icount = 0;
 3527:          double sumRx = 0.0;
 3528:          double sumRy = 0.0;
 3529:          for (int j1=0; j1<i34; j1++) { 
 3530: 
 3531:             const int j2 = elem->nxq(j1 + 1);
 3532: 
 3533:             // Pairs of consecutive neighbor elements of elem
 3534:             const Element *e1 = elem->nghbElems[j1];
 3535:             const Element *e2 = elem->nghbElems[j2];
 3536: 
 3537:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 3538:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 3539:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 3540: 
 3541:             // Compute the density difference and the vector from elem to e1 and e2
 3542:             // getRhoDiffAndVec takes into account boundaries/dry elements
 3543:             double diffRho1, diffRho2;
 3544:             Vector2 vec1, vec2;
 3545:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 3546:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 3547: 
 3548:             const double rl1 = length(vec1);
 3549:             const double rl2 = length(vec2);
 3550:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 3551: 
 3552:             const double delta = cross(vec1, vec2);
 3553:             const double sintheta = abs(delta)/(rl1*rl2);
 3554: 
 3555:             // To avoid problems, avoid elements with small angle between vectors
 3556:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 3557:             const bool validEq = (sintheta > sin_one_deg);
 3558: 
 3559:             if (validEq) {
 3560:                // Solve the system of equations to get the density gradient at elem
 3561:                icount++;
 3562:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 3563:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 3564:                sumRx += Rx;
 3565:                sumRy += Ry;
 3566:             }
 3567:          } // for j1
 3568: 
 3569:          // Compute the average density gradient at elem
 3570:          if (icount==0) {
 3571:            // Bad mesh quality; bail out with 0 b-cc
 3572:            elem->gradRho[k] = {0.0, 0.0};
 3573:          } else {
 3574:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 3575:          }
 3576: 
 3577:       } // for k
 3578: 
 3579:    }
 3580: 
 3581:    __global__ void computeBaroclinicTerm(double rampbc) {
 3582:    // Computes the baroclinic term at sides (at half levels).
 3583:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 3584:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 3585: 
 3586:       SIDE(side);
 3587: 
 3588:       if (side->idry == 1) return;
 3589: 
 3590:       const Element *e1 = side->elems[0];
 3591:       const Element *e2 = side->elems[1];      
 3592:       const int kb = side->kb;
 3593:       
 3594:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 3595: 
 3596:       // interpolates vertically the density gradient of the two elements at the half level/
 3597: 
 3598:       // Starts the integration at the surface and goes down to the bottom
 3599:       int k1 = nvrt - 1;
 3600:       int k2 = nvrt - 1;
 3601: 
 3602:       side->bcc[nvrt-1] = {0.0, 0.0};
 3603:       for (int k = nvrt-1; k >= kb; k--) {
 3604:       // For each prism level (from surface to bottom)...
 3605: 
 3606:          // For both elements, interpolate density gradient at the side's half level.
 3607:          // The gradient at the side is the average of the gradients at the elements.
 3608:          // w1, w2 are used to take into account boundary sides, with just one element.
 3609:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 3610:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 3611:          w1 = w1/(w1 + w2);
 3612:          w2 = w2/(w1 + w2);
 3613: 
 3614:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 3615: 
 3616:          // Linear interpolation of both elements' density gradient at the shared side's level.
 3617:          Vector2 gradRho = {0.0, 0.0};
 3618:          if (e1 != nullptr && k > kb) {
 3619:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 3620:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 3621:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 3622:             
 3623:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 3624:          }      
 3625:          if (e2 != nullptr && k > kb) {
 3626:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 3627:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 3628:             
 3629:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 3630:          }
 3631: 
 3632:          if constexpr(ics==2) {
 3633:             // IMPLEMENT THIS XXXXXX
 3634:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 3635:             // swild(1)=tmp1
 3636:             // swild(2)=tmp2
 3637:          }
 3638:          
 3639:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 3640:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 3641:          // CHECK INDICES!!! XXX
 3642:          const double grav3 = 0.5*(side->n1->grav2 + side->n2->grav2);
 3643:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 3644:       } // for
 3645: 
 3646:    }
 3647: 
 3648: } // extern "C"
 3649: 
 3650: #ifdef DONTCOMPILE
 3651: __device__ void computeVerticalAdvection(void) {
 3652:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 3653: 
 3654:    sdbt(1:2,:,:)=0.d0
 3655: 
 3656:    const Side *side = FROM kernel;
 3657: 
 3658:    if(side->idry) return;
 3659: 
 3660:    // If side is wet...
 3661: 
 3662: 
 3663:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 3664:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 3665:    double ws[nvrt] = {} // w @ side
 3666:    int icount = 0;
 3667:    for (int j=0; j<2; j++) {
 3668:       const Element *elem = side->elements[j];
 3669:        
 3670:       if(elem != nullptr) {
 3671:          icount++;
 3672:          for (int k=0; k<nvrt; k++) {
 3673:             ws[k] = ws[k] + elem->w[k];
 3674:          }
 3675:       }
 3676:    }  // for j
 3677: 
 3678:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 3679:    ws = ws/icount;
 3680: 
 3681:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 3682:    // Splines allow for a smooth transition between vertical levels.
 3683:    // Splines have continuity restrictions at the internal knots, but
 3684:    // we have to provide the 1st derivatives at the endpoints.
 3685:    const int kbs = side->kbs; 
 3686:    
 3687:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3688:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3689:    initCubicSpline(kbs, nvrt, side, ws, up)
 3690: 
 3691:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3692:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3693:    initCubicSpline(kbs, nvrt, side, ws, vp)
 3694: 
 3695:    // Total advection (average onto side)
 3696:    const Node *node1 = side->nodes[0];
 3697:    const Node *node2 = side->nodes[1];
 3698:    for (int k=kbs(i); k<nvrt; k++) {
 3699: 
 3700:       if constexpr(ics==1) {
 3701:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 3702:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 3703:       } else {
 3704:          // XXX IMPLEMENT THIS
 3705:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 3706:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 3707:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 3708:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 3709:       }  // if ics
 3710: 
 3711: 
 3712:    }
 3713: }
 3714: #endif
 3715: 
 3716: 
 3717: extern "C" {
 3718:    __global__ void computeElemAverageGhat(double rampbc) {
 3719:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 3720: 
 3721:       ELEM(elem);
 3722:       
 3723:       elem->ghat1= {0.0, 0.0};  
 3724: 
 3725:       if constexpr(ihydraulics != 0) {
 3726:          if (nhtblocks > 0 && elem->isblock) return;
 3727:       }
 3728: 
 3729:       if (elem->idry == 1) return;
 3730: 
 3731:       // Wet elements.
 3732:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 3733:       // tidal potential, horizontal diffusion, and baroclinic etc
 3734:       // Remember to update both fb and F 
 3735:       // If ics=2, ghat1 are in eframe (ll)
 3736:       // cff1-3: coefficients for 2D/3D
 3737:       Vector2 gradEta = {0.0, 0.0};  // \nabla \eta
 3738:       Vector2 gradPr  = {0.0, 0.0};  // \nabla pressure
 3739:       Vector2 gradETP = {0.0, 0.0};  // \nabla etp
 3740: 
 3741:       double av_cff1 = 0.0;  // av. for cff1
 3742:       double av_cff2 = 0.0;  // av. for cff2
 3743:       double av_cff3 = 0.0;  // av. for cff3
 3744:       double av_df = 0.0;  // av. for H^\alpha / H
 3745:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 3746:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 3747: 
 3748:       const int i34 = elem->i34;
 3749:       const int kb = elem->kb;
 3750: 
 3751:       for (int j=1; j<i34; j++) {
 3752:          // For each node and side in the element...
 3753: 
 3754:          const Node *node = elem->nodes[j];
 3755:          const Side *side = elem->sides[j];
 3756: 
 3757:          const double chi      = side->chi;
 3758:          const double veg_c2   = side->veg_c2;
 3759:          const double veg_beta = side->veg_beta;
 3760:          const double veg_h    = side->veg_h();
 3761:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 3762: 
 3763:          // Node - const in elem
 3764:          gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 3765:          gradPr  += node->pr  *elem->gradPhi[j];
 3766: 
 3767:          if (elem->depth >= tip_dp) {
 3768:            gradETP += node->ETP*elem->gradPhi[j];
 3769:          }
 3770: 
 3771:          
 3772:          const double htot  = side->htot();        // Total depth at the side
 3773:          const double zctr2 = side->zTopCanopy();  
 3774: 
 3775:          double cff1; 
 3776:          double cff2; 
 3777:          double cff3;   
 3778:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 3779:          // coefficients applied to 2D/3D case 
 3780:             cff1 = side->hhat/htot;
 3781:             cff2 = 0.0;
 3782:             cff3 = 0.0;
 3783:          } else { //3D
 3784:             //Init for no-veg case
 3785:             cff1 = 1.0;
 3786:             cff2 = 1.0;
 3787:             cff3 = 0.0;
 3788: 
 3789:             if constexpr(iveg != 0) {
 3790:                // Computes coefficients used with vegetation terms G1, G2
 3791:                // cff1, cff3 are used for the first two terms in G1, G2:
 3792:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 3793:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 3794:                // In general, cff1*Ustar - cff3*Ustar_alpha
 3795:                if(veg_h < 0.99*htot) { // submergent vegetation
 3796:                   cff1=1;
 3797:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 3798:                   cff3 = veg_c;
 3799: 
 3800:                } else { // emergent vegetation
 3801:                   cff1 = 1.0/(1.0 + veg_c2);
 3802:                   cff2 = cff1;
 3803:                   cff3 = 0.0;
 3804: 
 3805:                }
 3806:             } // if iveg
 3807:          } //  2D/3D
 3808: 
 3809:          av_cff1 += cff1/i34;
 3810:          av_cff2 += cff2/i34;
 3811:          av_cff3 += cff3/i34;
 3812:          av_cff2_chi += cff2*chi/i34;
 3813:          av_cff3_chi += cff3*chi/i34;
 3814:          av_df += min(htot, veg_h)/(htot*i34);
 3815: 
 3816: 
 3817:          // btrack values: U^\star, U^{\star\alpha}
 3818:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 3819:          Vector2 Ustar       = {0.0, 0.0}; 
 3820:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 3821:          for (int k = side->kb; k < nvrt; k++) {
 3822:             if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 3823:                Ustar += side->btu[nvrt]*side->Dz(k);
 3824: 
 3825:             } else { //3D
 3826:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 3827:                Ustar += w2;
 3828: 
 3829:                if constexpr(iveg != 0) {
 3830:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 3831:                        const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k)); // For the top of the canopy, ratio of the level that is below the canopy
 3832:                        Ustar_alpha += zrat*w2; // XXXX
 3833:                    }
 3834:                }  // if iveg
 3835:             }  //2/3D
 3836:          }  //k
 3837:          
 3838: 
 3839:          // Add btrack & surface stress terms to \breve{G} first
 3840:          if constexpr(ics==1) {
 3841:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 3842:          } else {
 3843:             // XXX IMPLEMENT THIS
 3844:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 3845:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 3846:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 3847:          }  // if ics
 3848: 
 3849:          // Surface and bottom stress terms
 3850:          if constexpr(ics==1) {
 3851:             const Vector2 tau    = side->tau();
 3852:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 3853: 
 3854:             // Term for surface and bottom stress
 3855:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 3856:          } else {
 3857:             // XXX IMPLEMENT THIS
 3858:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 3859:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 3860:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 3861:             // tau_x=(vn1+tt1)/2.d0
 3862:             // tau_y=(vn2+ss1)/2.d0
 3863:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 3864:          }  // if ics
 3865: 
 3866:          
 3867: 
 3868:          // All terms in F,F^\alpha,f_b except baroclinic
 3869:          // F, f_b: all explicit terms excluding vegetation 
 3870:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 3871:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 3872:          const double coriolis = side->coriolis;
 3873:          Vector2 F  =  coriolis*side->U;  // F_x
 3874:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 3875:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 3876: 
 3877:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 3878:             
 3879:             for (int k = side->kb; k < nvrt; k++) {
 3880:                if (zctr2 > side->zc[k-1]) {
 3881:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 3882:                    const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 3883:                    Fa +=  coriolis*w2*zrat;
 3884:                } // if zctr2
 3885:             } // k
 3886:          } // iveg
 3887: 
 3888:          // Integrate horizontal viscosity force vertically
 3889:          for (int k=side->kb + 1; k<nvrt; k++) {
 3890:             const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.0; 
 3891: 
 3892:             F += levelHorVisc;
 3893: 
 3894:             // Vegetation term
 3895:             if constexpr(iveg!=0) {
 3896:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 3897:                   const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 3898:                   Fa += levelHorVisc*zrat;
 3899:                } 
 3900:             } // if iveg
 3901:          } // for k
 3902: 
 3903:          fb += side->d2uv[side->kb];
 3904: 
 3905: 
 3906:          // Add to ghat1
 3907:          if constexpr(ics==2) {
 3908:             // XXX IMPLEMENT THIS
 3909:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 3910:             // bigf1=vn1; bigf2=vn2
 3911:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 3912:             // botf1=vn1; botf2=vn2
 3913:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 3914:             // bigfa1=vn1; bigfa2=vn2
 3915:          } // if ics
 3916: 
 3917:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 3918:       } // for j (nodes and sides)
 3919: 
 3920:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 3921:          
 3922:       // Finish off terms in F, F^\alpha and f_b
 3923:       const double grav3 = elem->mean(&Node::grav2);
 3924:       const Vector2 fb = grav3*gradETP - gradPr/rho0; //const in each elem
 3925: 
 3926: 
 3927:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 3928:       for (int j=1; j<i34; j++) { 
 3929:          // For each side in the element...
 3930:          const Side *side = elem->sides[j];
 3931:          const double chi = side->chi;
 3932: 
 3933:          const double htot = side->htot();
 3934:          const double veg_h = side->veg_h();
 3935:          const Vector2 F  = htot*fb;
 3936:          const Vector2 Fa = min(htot, veg_h)*fb;
 3937: 
 3938:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 3939:       } // for j
 3940: 
 3941:       //botf1 etc are already in elem frame
 3942:       elem->ghat1 += tmp/i34;
 3943: 
 3944:       // Baroclinic force
 3945:       if constexpr(ibc==0) {
 3946:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 3947: 
 3948:          Vector2 Fa = {0.0, 0.0};
 3949:          Vector2 intGradRho = {0.0, 0.0};
 3950:          
 3951:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 3952:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 3953:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 3954: 
 3955:             // \in F [m^2/s/s]
 3956:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 3957:          }
 3958: 
 3959:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 3960:          const Vector2 F = av_df*Fa; //approx
 3961:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 3962: 
 3963:       } // if ibc
 3964: 
 3965:    }
 3966: 
 3967: } // extern "C"
 3968: 
