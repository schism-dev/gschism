 2765: __device__ void computeElevationBoundaryConditions(double ramp, double time) {
 2766:    // Compute elevation essential boundary conditions 
 2767: 
 2768:    NodeBoundary *nodeBnd = NODE_BND_PTR; // A boundary node
 2769: 
 2770:    const Node *node = nodeBnd->node;
 2771:    const int iettype = nodeBnd->iettype;
 2772: 
 2773:    double eic = 0.0;
 2774:    if (nramp_elev==1) eic = nodeBnd->etaic;
 2775:    else               eic = 0.0;
 2776: 
 2777:    const double r_eic = (1.0 - ramp)*eic; 
 2778:    const double r_eth = ramp*nodeBnd->eth;
 2779:    double eta1_bar = r_eic;
 2780: 
 2781:    // Compute tide elevation
 2782:    if (iettype == 3 || iettype == 5) {
 2783:      
 2784:       // XXX IMPLEMENT TIDE THINGS
 2785:       assert(true && "Tide elevation not implemented");
 2786:       // for (int jfr=0; jfr<nbfr; jfr++) { // For all tide frequencies
 2787:       //    const int ncyc = int(amig[jfr]*time/(2.0*pi));
 2788:       //    const double arg = amig[jfr]*time - 2.0*pi*ncyc + face[jfr] - efa[i,j,jfr];
 2789:       //    eta1_bar += ramp*ff[jfr]*emo[i,j,jfr]*cos(arg);
 2790:       // } // for jfr
 2791:    } // if iettype
 2792: 
 2793:    switch (iettype) {
 2794:       case 1:
 2795:       case 2:
 2796:          nodeBnd->elbc = r_eth + r_eic;
 2797:          break;
 2798:       case 3:
 2799:          nodeBnd->elbc = eta1_bar + r_eic;
 2800:          break;
 2801:       case 4:
 2802:          nodeBnd->elbc = r_eth + r_eic;
 2803:          break;
 2804:       case 5:
 2805:          nodeBnd->elbc = r_eth + eta1_bar + r_eic;
 2806:          break;
 2807:    } // switch
 2808: 
 2809: 
 2810:    //Add inverse barometric effects
 2811:    if (iettype != 0 && inv_atm_bnd == 1) {
 2812:       nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 2813:    }
 2814: 
 2815: }
