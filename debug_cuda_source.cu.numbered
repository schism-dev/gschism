 1229: /**
 1230:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1231:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1232:    If the segment is completely inside the element, then it returns true.
 1233: 
 1234:    This function assumes:
 1235:    - The initial point is on a side of the element. 
 1236:    - Its position is given by parameter t in the range [0,1].
 1237:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1238:       intersects the element (elements are convex).
 1239: 
 1240:    To find the intersection point, this function does the following:
 1241:    - it finds the intersection of the line segment with all the element side lines,
 1242:       except for the one that contains the initial point.
 1243:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1244:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1245:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1246:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1247:       track segment is almost parallel to the element side line.
 1248: 
 1249:    Inputs:
 1250:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1251:    @param x2, y2: other end of the line segment
 1252: 
 1253:    Outputs:
 1254:    @param side:  side that intersects the line segment (input and output)
 1255:    @param nextElement (output): element that contains the intersection point
 1256:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1257:    @param zint (input/output): Vertical coordinate of the intersection point
 1258: 
 1259:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1260:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1261:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1262: 
 1263:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1264:    (Delta) being zero.
 1265: 
 1266:    The intersection2 point happens when:
 1267:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1268:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1269:    
 1270:    Assumption: the 4 points (including those of the side segment) are different.
 1271:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1272:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1273:    If true, (xIntersect,yIntersect) is the intersection.				
 1274:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1275: **/
 1276: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1277:                                               double &t, double& tIntersect) {
 1278: 
 1279:    double closest_intersect_t = 1e10;
 1280:    bool found_intersection = false;
 1281: 
 1282:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1283:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1284:    const Point2 x1 = side->point(t);
 1285:    
 1286: 
 1287:    Side *nextSide = nullptr;
 1288: 
 1289:    for (int i = 0; i < i34; i++) {
 1290: 
 1291:       // Element's i-th side 
 1292:       Side *side2 = sides[i];
 1293: 
 1294:       // Skip the side that contains the initial point
 1295:       if (side2 == side) continue;
 1296: 
 1297:       // (x3,y3)-(x4,y4) is the element side line
 1298:       const Point2 x3 = side2->n1->p2();
 1299:       const Point2 x4 = side2->n2->p2();
 1300: 
 1301:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1302:       const double delta = cross(x2 - x1, x3 - x4);
 1303: 
 1304:       if (delta != 0.0) {
 1305: 
 1306:          const double delta1 = cross(x3 - x1, x3 - x4);
 1307:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1308: 
 1309:          // Solves the two linear equations for tt1 and tt2
 1310:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1311:          const double tt2 = delta2/delta;
 1312: 
 1313:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1314:             closest_intersect_t = min(closest_intersect_t, tt1);
 1315:             nextSide = side2;
 1316: 
 1317:             nextElement = nextSide->otherElem(this);
 1318:             tIntersect = max(small, min(tt1, 1.0-small));
 1319:             t = tt2;
 1320: 
 1321:             found_intersection = true;
 1322:          }
 1323:       
 1324:       }
 1325: 
 1326:    }
 1327: 
 1328: 
 1329:    // found_intersection should always be true, since we checked all the sides.  
 1330:    side = nextSide;
 1331: // if (found_intersection) {
 1332: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1333: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1334: // }   
 1335:    return found_intersection;
 1336: }
 1337: 
 1338: 
 1339: 
 1340: 
 1341: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1342:                                               double &t, double& tIntersect) {
 1343: 
 1344:    double closest_intersect_t = 1e10;
 1345:    bool found_intersection = false;
 1346: 
 1347:    for (int i = 0; i < i34; i++) {
 1348: 
 1349:       Side *side2 = sides[i];
 1350: 
 1351:       // (x3,y3)-(x4,y4) is the element side line
 1352:       const Point2 x3 = side2->n1->p2();
 1353:       const Point2 x4 = side2->n2->p2();
 1354: 
 1355:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1356:       const double delta = cross(x2 - x1, x3 - x4);
 1357: 
 1358:       if (delta != 0.0) {
 1359: 
 1360:          const double delta1 = cross(x3 - x1, x3 - x4);
 1361:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1362: 
 1363:          // Solves the two linear equations for tt1 and tt2
 1364:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1365:          const double tt2 = delta2/delta;
 1366: 
 1367:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1368:             closest_intersect_t = min(closest_intersect_t, tt1);
 1369:             side = side2;
 1370:             nextElement = side->otherElem(this);
 1371:             t = tt2;
 1372:             tIntersect = max(small, min(tt1, 1.0-small));
 1373:             found_intersection = true;
 1374:          }
 1375:       
 1376:       }
 1377: 
 1378:    }
 1379: 
 1380: // if (found_intersection) {
 1381: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1382: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1383: // }
 1384: 
 1385:    // found_intersection should always be true, since we checked all the sides.  
 1386:    return found_intersection;
 1387: }
