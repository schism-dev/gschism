 1158:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1159:       // Compute the different time ramps used in the code 
 1160:       // This function is performed by just one thread
 1161: 
 1162:       if constexpr(ibc == 0) {
 1163:          if (drampbc > 0.0) {
 1164:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1165:          } else {
 1166:             rampbc = 1.0;
 1167:          }
 1168: 
 1169:          if (nws != 0 && drampwind > 0.0) {
 1170:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1171:          } else {
 1172:             rampwind = 1.0;
 1173:          }
 1174:       }
 1175: 
 1176:       if (drampwafo > 0.0) {
 1177:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1178:       } else {
 1179:          rampwafo = 1.0;
 1180:       }
 1181: 
 1182:       // For source/sinks
 1183:       if (if_source && dramp_ss > 0.0) {
 1184:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1185:       } else {
 1186:          ramp_ss = 1.0;
 1187:       }
 1188: 
 1189:       if (dramp > 0.0) {
 1190:          ramp = tanh(2.0*time/86400.0/dramp);
 1191:       } else {
 1192:          ramp = 1.0;
 1193:       }
 1194: 
 1195:       printf("computeTimeRamps: i = %d, nws = %d, if_source = %d, drampbc = %f, drampwind = %f, drampwafo = %f, dramp_ss = %f, dramp = %f\n", 
 1196:              threadIdx.x + blockIdx.x * blockDim.x, nws, if_source, drampbc, drampwind, drampwafo, dramp_ss, dramp);
 1197:    }
