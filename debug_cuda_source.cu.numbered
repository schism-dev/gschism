 2000: __host__ __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2001: 
 2002: __device__ double Node::compZCoord(int k) const {
 2003:    // Computes the z coordinate at level k.
 2004:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2005:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2006:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2007:    // used 
 2008:    
 2009:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2010:       
 2011:    if (isDry)  return 0.0;
 2012: 
 2013:    if constexpr(ivcor == 2) {
 2014: 
 2015:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2016:       const int kz = mesh->kz;
 2017: 
 2018:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2019:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2020:       // once per time step/node.
 2021:       // CHECK: updateZCoordData
 2022:       if (k == kz)               return -hmod2;
 2023:       else if (k == nvrt-1)      return eta2;
 2024:       else if (k == kb)          return -depth;
 2025:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2026:       else if (k > kz) {
 2027:          const int ksig = k - kz + 1;
 2028: 
 2029:          if (hmod2 <= mesh->h_c) {
 2030:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2031:          } 
 2032:          else if (eta2 <= - mesh->h_c - (depth - mesh->h_c) * mesh->theta_f/mesh->sinh_theta_f) {
 2033:             printf("Please choose larger h_c: %f %f\n", eta2, mesh->h_c);
 2034:             Error("ZCOOR: invalid h_c\n");
 2035:          } 
 2036:          else {
 2037:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2038:                          mesh->h_c * mesh->sigma[ksig] + 
 2039:                          (hmod2 - mesh->h_c) * mesh->cs[ksig];
 2040:          }
 2041:       } else { 
 2042:          Error("ZCOOR: invalid level or coordinate system\n");
 2043:       }
 2044: 
 2045:    }
 2046:    else if constexpr(ivcor == 1) {
 2047:       if (k == kb) return -depth;
 2048:       else if (k == nvrt-1) return eta2;
 2049:       else if (k >= kb) {
 2050:             return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2051:       }
 2052:    }
 2053:    
 2054:    printf("ZCOOR: invalid level or coordinate system\n");
 2055:    return 0.0;
 2056: }
