 2867: __device__ void computeElevationBoundaryConditions(double ramp, double time) {
 2868:    // Compute elevation essential boundary conditions 
 2869: 
 2870:    NodeBoundary *nodeBnd = NODE_BND_PTR; // A boundary node
 2871: 
 2872:    const Node *node = nodeBnd->node;
 2873:    const int iettype = nodeBnd->iettype;
 2874: 
 2875:    double eic = 0.0;
 2876:    if (nramp_elev==1) eic = nodeBnd->etaic;
 2877:    else               eic = 0.0;
 2878: 
 2879:    const double r_eic = (1.0 - ramp)*eic; 
 2880:    const double r_eth = ramp*nodeBnd->eth;
 2881:    double eta1_bar = r_eic;
 2882: 
 2883:    // Compute tide elevation
 2884:    if (iettype == 3 || iettype == 5) {
 2885:      
 2886:       // XXX IMPLEMENT TIDE THINGS
 2887:       assert(true && "Tide elevation not implemented");
 2888:       // for (int jfr=0; jfr<nbfr; jfr++) { // For all tide frequencies
 2889:       //    const int ncyc = int(amig[jfr]*time/(2.0*pi));
 2890:       //    const double arg = amig[jfr]*time - 2.0*pi*ncyc + face[jfr] - efa[i,j,jfr];
 2891:       //    eta1_bar += ramp*ff[jfr]*emo[i,j,jfr]*cos(arg);
 2892:       // } // for jfr
 2893:    } // if iettype
 2894: 
 2895:    switch (iettype) {
 2896:       case 1:
 2897:       case 2:
 2898:          nodeBnd->elbc = r_eth + r_eic;
 2899:          break;
 2900:       case 3:
 2901:          nodeBnd->elbc = eta1_bar + r_eic;
 2902:          break;
 2903:       case 4:
 2904:          nodeBnd->elbc = r_eth + r_eic;
 2905:          break;
 2906:       case 5:
 2907:          nodeBnd->elbc = r_eth + eta1_bar + r_eic;
 2908:          break;
 2909:    } // switch
 2910: 
 2911: 
 2912:    //Add inverse barometric effects
 2913:    if (iettype != 0 && inv_atm_bnd == 1) {
 2914:       nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 2915:    }
 2916: 
 2917: }
