 1081: __device__ __inline__ double min3(double a, double b, double c) {
 1082:    return min(a, min(b, c));
 1083: }
 1084: 
 1085: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1086:    return min(a, min(b, min(c, d)));
