 3077:    __global__ void scaleGravity(double loadtide_coef) {
 3078: 
 3079: 
 3080:       NODE(node);
 3081: 
 3082:       // SAL option: scale gravity
 3083:       if constexpr(iloadtide==2) {  // simple const
 3084:          node->grav2 = grav*(1.0 - loadtide_coef);
 3085: 
 3086:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3087:         
 3088:           const double depth = max(node->depth, 0.0);
 3089:           const double tmp1 = sqrt(depth);
 3090:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3091:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3092:                              2.6969e-13*depth*depth*depth*tmp1;
 3093:           
 3094:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3095:           
 3096: 
 3097: 
 3098:           node->grav2 = grav*(1.0 - beta_bar);
 3099: 
 3100:       } else {  // iloadtide=0,1
 3101:         node->grav2=grav;
 3102: 
 3103:       }
 3104: 
 3105:       printf("scaleGravity: node(%d)->grav2 = %f\n", node->idx, node->grav2);
 3106:    }
