 1100: // Helper functions for computing the local node index at a given offset from another.
 1101: __device__ __inline__ int nxq(int offset, int index, int size) {
 1102:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1103:    // to the index to make it positive
 1104:    assert(index + offset + 16*size >= 0);
 1105:    return (index + offset + 16*size) % size;  
 1106: }
 1107: 
 1108: __device__ __inline__ int nxq(int index, int size) {
 1109:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1110:    // to the index to make it positive
 1111:    assert(index + 16*size >= 0);
 1112:    return (index + 16*size) % size; 
 1113: }
