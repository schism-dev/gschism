 3351: extern "C" {
 3352: 
 3353:    __global__ void scaleGravity(double loadtide_coef) {
 3354: 
 3355: 
 3356:       NODE(node);
 3357: 
 3358:       // SAL option: scale gravity
 3359:       if constexpr(iloadtide==2) {  // simple const
 3360:          node->grav2 = grav*(1.0 - loadtide_coef);
 3361: 
 3362:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3363:         
 3364:           const double depth = max(node->depth, 0.0);
 3365:           const double tmp1 = sqrt(depth);
 3366:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3367:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3368:                              2.6969e-13*depth*depth*depth*tmp1;
 3369:           
 3370:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3371:           
 3372: 
 3373: 
 3374:           node->grav2 = grav*(1.0 - beta_bar);
 3375: 
 3376:       } else {  // iloadtide=0,1
 3377:         node->grav2=grav;
 3378: 
 3379:       }
 3380: 
 3381:       printf("scaleGravity: node(%d)->grav2 = %f\n", node->idx, node->grav2);
 3382:    }
