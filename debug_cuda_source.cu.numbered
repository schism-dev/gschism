 1254: 
 1255: /**
 1256:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1257:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1258:    If the segment is completely inside the element, then it returns true.
 1259: 
 1260:    This function assumes:
 1261:    - The initial point is on a side of the element. 
 1262:    - Its position is given by parameter t in the range [0,1].
 1263:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1264:       intersects the element (elements are convex).
 1265: 
 1266:    To find the intersection point, this function does the following:
 1267:    - it finds the intersection of the line segment with all the element side lines,
 1268:       except for the one that contains the initial point.
 1269:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1270:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1271:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1272:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1273:       track segment is almost parallel to the element side line.
 1274: 
 1275:    Inputs:
 1276:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1277:    @param x2, y2: other end of the line segment
 1278: 
 1279:    Outputs:
 1280:    @param side:  side that intersects the line segment (input and output)
 1281:    @param nextElement (output): element that contains the intersection point
 1282:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1283:    @param zint (input/output): Vertical coordinate of the intersection point
 1284: 
 1285:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1286:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1287:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1288: 
 1289:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1290:    (Delta) being zero.
 1291: 
 1292:    The intersection2 point happens when:
 1293:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1294:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1295:    
 1296:    Assumption: the 4 points (including those of the side segment) are different.
 1297:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1298:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1299:    If true, (xIntersect,yIntersect) is the intersection.				
 1300:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1301: **/
 1302: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1303:                                               double &t, double& tIntersect) {
 1304: 
 1305:    double closest_intersect_t = 1e10;
 1306:    bool found_intersection = false;
 1307: 
 1308:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1309:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1310:    const Point2 x1 = side->point(t);
 1311:    
 1312: 
 1313:    Side *nextSide = nullptr;
 1314: 
 1315:    for (int i = 0; i < i34; i++) {
 1316: 
 1317:       // Element's i-th side 
 1318:       Side *side2 = sides[i];
 1319: 
 1320:       // Skip the side that contains the initial point
 1321:       if (side2 == side) continue;
 1322: 
 1323:       // (x3,y3)-(x4,y4) is the element side line
 1324:       const Point2 x3 = side2->n1->p2();
 1325:       const Point2 x4 = side2->n2->p2();
 1326: 
 1327:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1328:       const double delta = cross(x2 - x1, x3 - x4);
 1329: 
 1330:       if (delta != 0.0) {
 1331: 
 1332:          const double delta1 = cross(x3 - x1, x3 - x4);
 1333:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1334: 
 1335:          // Solves the two linear equations for tt1 and tt2
 1336:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1337:          const double tt2 = delta2/delta;
 1338: 
 1339:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1340:             closest_intersect_t = min(closest_intersect_t, tt1);
 1341:             nextSide = side2;
 1342: 
 1343:             nextElement = nextSide->otherElem(this);
 1344:             tIntersect = max(small, min(tt1, 1.0-small));
 1345:             t = tt2;
 1346: 
 1347:             found_intersection = true;
 1348:          }
 1349:       
 1350:       }
 1351: 
 1352:    }
 1353: 
 1354: 
 1355:    // found_intersection should always be true, since we checked all the sides.  
 1356:    side = nextSide;
 1357: // if (found_intersection) {
 1358: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1359: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1360: // }   
 1361:    if (!found_intersection) {
 1362:       // Check if the segment is parallel to the initial side
 1363:       printf("XXX %f\n", dot(x2 - x1, side->n1->p2() - side->n2->p2()));
 1364:       if (abs(dot(x2 - x1, side->n1->p2() - side->n2->p2())) < small) {
 1365:          found_intersection = true;
 1366:          nextElement = side->otherElem(this);
 1367:          tIntersect = t;
 1368:          t = 0.0;
 1369:          found_intersection = true;
 1370:       }
 1371:    }
 1372:    return found_intersection;
 1373: }
 1374: 
 1375: 
 1376: 
 1377: 
 1378: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1379:                                               double &t, double& tIntersect) {
 1380: 
 1381:    double closest_intersect_t = 1e10;
 1382:    bool found_intersection = false;
 1383: 
 1384:    for (int i = 0; i < i34; i++) {
 1385: 
 1386:       Side *side2 = sides[i];
 1387: 
 1388:       // (x3,y3)-(x4,y4) is the element side line
 1389:       const Point2 x3 = side2->n1->p2();
 1390:       const Point2 x4 = side2->n2->p2();
 1391: 
 1392:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1393:       const double delta = cross(x2 - x1, x3 - x4);
 1394: 
 1395:       if (delta != 0.0) {
 1396: 
 1397:          const double delta1 = cross(x3 - x1, x3 - x4);
 1398:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1399: 
 1400:          // Solves the two linear equations for tt1 and tt2
 1401:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1402:          const double tt2 = delta2/delta;
 1403: 
 1404:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1405:             closest_intersect_t = min(closest_intersect_t, tt1);
 1406:             side = side2;
 1407:             nextElement = side->otherElem(this);
 1408:             t = tt2;
 1409:             tIntersect = max(small, min(tt1, 1.0-small));
 1410:             found_intersection = true;
 1411:          }
 1412:       
 1413:       }
 1414: 
 1415: 
 1416:    }
 1417: 
 1418:    assert(found_intersection && "No intersection found");
 1419: 
 1420:    // found_intersection should always be true, since we checked all the sides.  
 1421:    return found_intersection;
 1422: }
 1423: 
 1424: 
 1425: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1426:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1427: 
 1428:    printf("Tracking segment goes out of water at element %d\n", curElem->idx);
 1429: 
 1430:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1431:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1432:    // curElement.
 1433: 
 1434:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1435:    // And uses this velocity instead to continue the tracking.
 1436: 
 1437:    // computes the intersection point in cartesian coordinates
 1438:    Point2 intersection = nextSide->p_t(tt);
 1439: 
 1440:    // Nudges the point to the barycenter of the element. 
 1441:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1442:    // next segment intersects the element sides.  
 1443:    curElem->nudgeToBarycenter(intersection);
 1444: 
 1445:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1446:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1447:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1448:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1449: 
 1450:    // If the side is an open boundary, the tangential velocity is zero.
 1451:    if (nextSide->isBnd()) vtan = 0.0;
 1452: 
 1453:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1454:    const double us = vtan*nextSide->t().x;
 1455:    const double vs = vtan*nextSide->t().y;
 1456:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1457: 
 1458:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1459:    const double len2 = length(intersection - toPoint2(xt));
 1460:    const double vel2 = u_int.x*u_int.x + u_int.y*u_int.y;        
 1461:    assert(vel2 > 0.0 && "Zero velocity found");
 1462:    dt = dt - sqrt(len2/vel2); 
 1463: 
 1464:    // The end of this tracking segment is now the intersection point.
 1465:    xt = {intersection.x, intersection.y, zint};
 1466:    
 1467:    u_int = {us, vs, ws};
 1468:    
 1469: }
 1470: 
 1471: /**
 1472:  * Tracks a particle through elements and vertical levels in the mesh.
 1473:  * 
 1474:  * @param x0,y0,z0     Starting position coordinates
 1475:  * @param xt,yt,zt     Target position coordinates
 1476:  * @param dtb          Time step for tracking
 1477:  * @param uuint,vvint,wwint Initial velocity components
 1478:  * @param nextElem     Starting/resulting element index
 1479:  * 
 1480:  * @return Status code of type trackExitCodes
 1481:  * 
 1482:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1483:  * of the details are different. The idea is that the code requires less branches and is better fit
 1484:  * for GPU execution.
 1485:  * 
 1486:  * The main ideas here are:
 1487:  * - The starting point is expected to be in the starting element.
 1488:  * - The end point is guaranteed to be inside an element.
 1489:  * - since the starting point is inside the element, there are only two cases: 
 1490:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1491:  *     (b) it does not and (xt,yt) is already in the starting element.
 1492:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1493:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1494:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1495:  * - tt1 can be positive or negative. We only consider the positive values.
 1496:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1497:  * - The next intersection will occur at the smallest positive tt1.
 1498:  * - This intersection will be the next (x0,y0) position.
 1499:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1500:  *   of getting stuck in a loop.
 1501:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1502:  *   was found.
 1503:  */
 1504: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1505:                                                        Element *&nextElem, int &jlev, double &dt) {
 1506: 
 1507:    // First thing is to check if the target point is inside the element. If it is there is nothing
 1508:    // else to do.
 1509:    if (containsPoint(toPoint2(xt))) {
 1510:       nextElem->interpolateVelocities(xt, u_int);
 1511:       return true;
 1512:    }
 1513: 
 1514:    Side *side = nullptr;
 1515: 
 1516:    // 1. Initial checks
 1517:    // Verify starting element is valid (wet)
 1518:    assert(!nextElem->isDry && "Starting element is dry");
 1519: 
 1520:    // Checks if track has a zero length.
 1521:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1522:    assert(len2 > 0.0 && "Zero length track"); 
 1523:    
 1524: 
 1525:    const int MAX_ITERATIONS = 1000;
 1526:    
 1527:    double t;
 1528:    Side *nextSide = nullptr;
 1529:    double tIntersect = 1e10;
 1530:    double zint = x0.z;
 1531: 
 1532:    // Horizontal tracking loop
 1533:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1534:    // (x0,y0) is inside the element but the target point is not.
 1535:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1536:    if (!found_intersection) {
 1537:       printf("No intersection found:\n"
 1538:            "Element %d\n"
 1539:            "Start point: (%f, %f)\n"
 1540:            "Target point: (%f, %f)\n"
 1541:            "Vertices:\n"
 1542:            "  Node 0: (%f, %f)\n"
 1543:            "  Node 1: (%f, %f)\n"
 1544:            "  Node 2: (%f, %f)\n",
 1545:            nextElem->idx,
 1546:            x0.x, x0.y,
 1547:            xt.x, xt.y,
 1548:            nextElem->nodes[0]->p.x, nextElem->nodes[0]->p.y,
 1549:            nextElem->nodes[1]->p.x, nextElem->nodes[1]->p.y,
 1550:            nextElem->nodes[2]->p.x, nextElem->nodes[2]->p.y);
 1551:    }
 1552:    assert(found_intersection && "No intersection found at %d");
 1553: 
 1554:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1555: 
 1556:    // if the tracking segment goes out of water (either dry or edge boundary)
 1557:    if (isEdgeBoundary(nextSide) || (nextElem->isDry)) {
 1558:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1559:       nextElem = this;
 1560:       
 1561:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1562:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1563:       return true;    
 1564:       }
 1565: 
 1566:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1567:    int iterations = 0;
 1568:    while (iterations < MAX_ITERATIONS) {
 1569:       iterations++;
 1570:       
 1571:       Element *curElem = nextElem;
 1572: 
 1573:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1574:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1575: 
 1576:       // If we are already in the target element, we are done.
 1577:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1578:       if (!found_intersection) break;
 1579: 
 1580: 
 1581:   
 1582:       // if the tracking segment goes out of water (either dry or edge boundary).
 1583:       if (curElem->isEdgeBoundary(nextSide) || (nextElem->isDry)) {
 1584: 
 1585:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1586: 
 1587:          nextElem = curElem;
 1588: 
 1589:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1590:          // In this case, the caller (btrack) needs to take into account the remaining time.
 1591:          return true;
 1592:       }
 1593:       
 1594:       // Update position and element for next iteration
 1595:       side = nextSide;
 1596: 
 1597:    }
 1598: 
 1599: 
 1600:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 1601: 
 1602:  
 1603:    // Interpolate velocities at the final position. This is a conceptually simple step,
 1604:    // but the function is not simple, because it has to search for the vertical level containing zt.
 1605:    nextElem->interpolateVelocities(xt, u_int);
 1606: 
 1607: 
 1608:    return true;
 1609: }
 1610: 
 1611: 
 1612: 
 1613: 
 1614: __inline__ __device__ double Element::computeSignedArea(void) const {
 1615:    // Compute the area of the element
 1616: 
 1617:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 1618: 
 1619:    // In the quad case we need to add the area of the other triangle.
 1620:    if (isQuad()) {
 1621:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1622:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 1623:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1624:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 1625:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 1626:          Error("Negative area found in quad element");
 1627:       }
 1628:       res += ar1;
 1629:    }
 1630: 
 1631:    return res;
 1632: }
 1633: 
 1634: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 1635:    // In boundary sides, the element 1 is nullptr
 1636:    return side->elems[1] == nullptr; 
 1637: }
 1638: 
 1639: /**
 1640:    Compute the shape coordinates of the point (xt,yt) in the element.
 1641:    @param xt (input): x-coordinate of the point
 1642:    @param shpCoords (output): shape coordinates of the point
 1643:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 1644:    @return true if the point is inside the element, false otherwise
 1645: **/
 1646: __device__ bool Element::computeShapeCoords(Point2 xt, double shpCoords[4],
 1647:                                             bool fixNegshpCoord) const {
 1648: 
 1649:    // Compute the shape coordinates of the point xt in the element.
 1650:    if (i34==3) {
 1651:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 1652:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 1653:       // and in this case, the pt will be nudged into the element
 1654:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 1655:       // from the local frame, so use additional check.
 1656: 
 1657:       Point2 x0, x1, x2;
 1658: 
 1659:       if constexpr(ics==1) {
 1660:          x0 = nodes[0]->p2();
 1661:          x1 = nodes[1]->p2();
 1662:          x2 = nodes[2]->p2();
 1663:       }
 1664:       else // lat/lon
 1665:       {
 1666:          Error("Not implemented yet");
 1667: #ifdef ICS2
 1668:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 1669:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 1670:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 1671: #endif
 1672:       }
 1673: 
 1674:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 1675:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 1676:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 1677:       shpCoords[3] = 0.0;
 1678:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 1679: 
 1680:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 1681:       // then we fix the negative shape coordinates.
 1682:       if (fixNegshpCoord && tmpmin<=0.0) {
 1683: 
 1684:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 1685:          // keeping the sum of the shape coordinates equal to 1.
 1686:          // I have tested and compared the new algorithm with the old one, and they give
 1687:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 1688:          // The new algorithm should be faster since it is branchless.
 1689:          const double a = - tmpmin + 1.0e-2;  // XXX it used to be 1.0e-4 in the comments of the original code
 1690:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 1691:          
 1692:          shpCoords[0] = (shpCoords[0] + a)*b;
 1693:          shpCoords[1] = (shpCoords[1] + a)*b;
 1694:          shpCoords[2] = (shpCoords[2] + a)*b;          
 1695: 
 1696:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 1697:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 1698:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 1699:          }
 1700: 
 1701:          // Update the point coordinates for the new shape coordinates
 1702:          double xcoords[3] = {x0.x, x1.x, x2.x};
 1703:          double ycoords[3] = {x0.y, x1.y, x2.y};
 1704:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 1705: 
 1706:       }
 1707: 
 1708:       // Check if the point is inside the element
 1709:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 1710:    }
 1711:    else {
 1712:       Error("Not implemented yet");
 1713: #ifdef QUADS
 1714:       // Reproject pt in eframe of nel for ics=2
 1715:       if constexpr(ics==1) {
 1716:          xn2 = xt; 
 1717:          yn2 = yt;
 1718:       }
 1719:       else {
 1720:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 1721:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 1722:       }
 1723: 
 1724:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 1725: #endif
 1726:    }
 1727: 
 1728: }
 1729: 
 1730: 
 1731: /**  Interpolate velocities at a given point (xt,yt,zt)
 1732: 
 1733:    @param xt, yt, zt: coordinates of the point to interpolate
 1734:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 1735: 
 1736:    This is done in four steps:
 1737: 
 1738:    1. Find the shape coordinates for the final position in the element.
 1739:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 1740:    3. Perform a *binary search* to find the vertical level containing zt. It will have to interpolate the 
 1741:       z levels at xt, yt at each step.   
 1742:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 1743:       horizontally and vertically.
 1744: **/
 1745: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) {
 1746:    // Interpolate the velocities at the point xt. 
 1747:    // This function works the same for triangular and quadrilateral elements.
 1748:    double shpCoord[4];
 1749: 
 1750: 
 1751:    // First step is to compute the shape coordinates of (xt,yt)
 1752:    computeShapeCoords(toVector2(xt), shpCoord, false);
 1753:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 1754: 
 1755:    // Second step is to find the level that contains zt
 1756:    // Uses a binary search to find the level
 1757:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 1758:    int L = kbe;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 1759:    int R = nvrt - 1;
 1760: 
 1761:    // Get the z coordinates at the nodes of the element at the levels L and R
 1762:    double zLAtNodes[4], zRAtNodes[4];
 1763:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 1764:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 1765: 
 1766:    double zL = interpolate(shpCoord, zLAtNodes);
 1767:    double zR = interpolate(shpCoord, zRAtNodes);
 1768:    
 1769:    // Interpolates vertically the velocities
 1770:    double wght1, wght2;
 1771:    if (xt.z<=zL) {
 1772:       wght1 = 1.0;
 1773:       wght2 = 0.0;
 1774:    }
 1775:    else if (xt.z>=zR) {
 1776:       wght1 = 0.0;
 1777:       wght2 = 1.0;
 1778:    }
 1779:    else {
 1780:       // Perform a binary search to find the levels between L and R that contain xt.z
 1781:       while (R - L > 1) {
 1782:          int M = (L + R) / 2;
 1783: 
 1784:          double zMAtNodes[4];
 1785:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 1786:          double zM = interpolate(shpCoord, zMAtNodes);
 1787:          if (zM < xt.z) 
 1788:          {
 1789:             L = M;
 1790:             zL = zM;
 1791:          }
 1792:          else 
 1793:          {
 1794:             R = M;
 1795:             zR = zM;
 1796:          }
 1797:       }
 1798:       assert(L == R-1);
 1799:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 1800: 
 1801:       wght2 = (xt.z - zL)/(zR - zL);
 1802:       wght1 = 1.0 - wght2;
 1803:    }
 1804: // printf("$$$ wght1 = %f, wght2 = %f, zt = %f, zL = %f, zR = %f\n", wght1, wght2, zt, zL, zR);
 1805: // printf("$$$ shpCoord = %f, %f, %f, %f\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 1806:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 1807:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 1808: 
 1809:    // Neither of the interpolated velocities should be NaN
 1810:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 1811: 
 1812: }
 1813: 
 1814: 
 1815: 
 1816: __inline__ __device__ double Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 1817: __inline__ __device__ double Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 1818: __inline__ __device__ Point2 Side::p_t(double t) const { return {x(t), y(t)}; }
 1819: __inline__ __device__ int    Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 1820: __inline__ __device__ double Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 1821: __inline__ __device__ double Side::depth(void)   const { return 0.5*(n1->depth + n2->depth); }
 1822: 
 1823: __inline__ __device__ double Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 1824: __inline__ __device__ double Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 1825: __inline__ __device__ double Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 1826: 
 1827: 
 1828: __inline__ __device__ double Side::Cd(void)      const { if constexpr(nchi != 0) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 1829: 
 1830: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 1831: 
 1832: /**
 1833:  * This method performs backtracking from the side center until a time -dt back in time 
 1834:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 1835:  * intermediate point.
 1836:  *
 1837:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 1838:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 1839:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 1840:  * remaining time.
 1841:  * 
 1842:  * NOTE: Runge-Kutta is not implemented yet. XXX
 1843:  * 
 1844:  * @param uuint, vvint, wwint: Velocities at the final point
 1845:  * @param jlev: Level at which the backtracking is performed
 1846:  * @param dt, dtbk: Tracking timesteps
 1847:  * @return: True if the backtracking was successful, false otherwise
 1848:  */
 1849: __inline__ __device__ bool Side::btrack(
 1850:       int jlev,
 1851:       double dt,            // Tracking time
 1852:       double dtbk,          // Tracking timestep
 1853:       Vector3 &u_int
 1854: ) const {
 1855: 
 1856:    // Start from side center
 1857:    Point3 x0 = {center.x, center.y, zc[jlev]};
 1858:  
 1859: 
 1860:    double time_rm = dt; // Remaining time
 1861: 
 1862: 
 1863:    // // Initialize outputs XXX
 1864:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 1865:    //    sclr[i] = 0.0;
 1866:    // }
 1867: 
 1868: 
 1869:    // Initial velocities
 1870:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 1871: 
 1872:    // Find the element that is in the direction opposite to the velocity
 1873:    Element* curElem = findElementTowards({u_int.x, u_int.y});
 1874: 
 1875: 
 1876:    const int MAX_ITERATIONS = 1000; 
 1877:    Element* nextElem = curElem;
 1878:    int iter = 0;
 1879:    while(true) {
 1880:       // Calculate timestep
 1881:       double dtb = min(dtbk, time_rm);
 1882: 
 1883:       // Next point in the backtracking curve
 1884:       Point3 xt = x0 - dtb*u_int;
 1885: 
 1886:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb);
 1887:       assert(found && "Backtracking failed in btrack");
 1888: // printf("<>T = %f, %f %f %f\n", time_rm - dtb, xt, yt, zt);
 1889:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 1890:                       // then time_rm needs to be increased by the unused time.
 1891: 
 1892: 
 1893:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 1894: 
 1895:       // The current point becomes the next segment's starting point.
 1896:       x0 = xt;
 1897:  
 1898:       curElem = nextElem;
 1899: 
 1900:       iter++;
 1901:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 1902:    }
 1903: 
 1904: 
 1905: }
 1906: 
