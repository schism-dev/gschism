  729:    // Elevation boundary condition
  730:    int iettype;  // Type of elevation boundary condition
  731:    double eth;   // Elevation time history
  732: 
  733:    // Flow boundary condition
  734:    double qthcon;  // Flow time history constant
  735:    double vobc1;   // Velocity coefficient 1
  736:    double vobc2;   // Velocity coefficient 2
  737: 
  738:    // Tracer boundary conditions
  739:    // double trobc[natrm];    // Tracer boundary condition nudging factor
  740:    // int  itrtype[natrm];    // Tracer boundary condition type
  741: 
  742:    
  743: };
