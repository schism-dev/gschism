  774: struct Node {
  775: 
  776:    // Geometry information
  777:    int idx;        // Index of the node
  778:    Node **nodes;   // pointer to the nodes that are neighbors of this node (there is no guarantee that they are connected)
  779:    int numNodes;   // number of nodes neighbors of this node
  780: 
  781:    Element **elements; // pointer to the elements that share this node
  782:    int numElements;   // number of elements that share this node
  783: 
  784:    Point3 p;
  785:    Vector3 u2[nvrt];
  786:    double znl[nvrt];
  787:    double lon, lat;
  788:    double depth;
  789: 
  790:    int kb;       // Bottom index of the node
  791: 
  792:    int idry;     // True if the node is dry
  793: 
  794:    int iadv;     // Advection flag
  795: 
  796:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
  797: 
  798:    // Physical information
  799:    Tracers tr_nd0[nvrt]; // Initial tracer conc. at nodes
  800: 
  801:    double rho[nvrt];     // Density
  802: 
  803:    double eta1; // Elevation at nodes at previous timestep
  804:    double eta2; // Elevation at nodes at current timestep
  805: 
  806:    double etp;  // Earth Tidal Potential
  807: 
  808:    
  809:    double pr;    // Air pressure
  810:    double grav2; // Gravity 
  811:    
  812:    Vector2 dav;  // Depth averaged velocity
  813: 
  814:    Vector2 tau; // Wind stress vector
  815: 
  816:    // Vegetation parameters
  817:    double veg_h;
  818:    double veg_nv;
  819:    double veg_di;
  820:    double veg_Cd;
  821:    double veg_h_unbent;
  822:    double veg_di_unbent;
  823:    double veg_nv_unbent;
  824:    double veg_alpha_vert_mean;
  825:    double veg_alpha0;
  826:    double veg_alpha3D[nvrt];
  827: 
  828:    // Bottom drag parameters
  829:    double Cd;       // Bottom drag coefficient
  830:    double rough;    // Bottom roughness length
  831:    Vector2 tau_bot; // Bottom stress vector
  832: 
  833:    double bdef1; // Bottom deformation at previous timestep
  834:    double bdef2; // Bottom deformation at current timestep
  835: 
  836:    double qel; // RHS
  837: 
  838:    __host__ __device__ Point2 p2(void) const { return {p.x, p.y}; }
  839: 
  840:    __host__ __device__ double sigmaTransitionDepth(void) const;
  841: 
  842:    __inline__ __device__ double Dz(int k) const { return znl[k] - znl[k-1]; }
  843:    __inline__ __device__ double htot(void) const { return eta2 + depth; }
  844:    __inline__ __device__ double zTopCanopy(void) const { return znl[kb] + veg_h; } 
  845: 
  846:    __device__ void clearMatrixRow(void) {
  847:       // Clear the matrix row for this node
  848:       printf("NOT IMPLEMENTED: clearMatrixRow\n");
  849:    }
  850: 
  851:    __device__ void addToSparseMatrix(Node const *node, double value) {
  852:       // Add the value to the sparse matrix for this node
  853:       printf("NOT IMPLEMENTED: addToSparseMatrix\n");
  854:    }
  855: 
  856: #ifdef BACKTRACKING
  857:    __device__ void updateZCoordData() {
  858:    // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
  859: 
  860:       // Check if node is wet
  861:       idry = (depth + eta2 <= h0);  // XXX Check if we are doing this elsewhere
  862: 
  863:       if (idry) return;
  864: 
  865:       if constexpr(ivcor == 2) {  // SZ coordinates
  866:          
  867:          // Compute bottom level index
  868:          if (depth <= mesh->h_s) {
  869:                kb = mesh->nzlevels;
  870:          } else {
  871:                kb = -1;
  872:                for (int i = 0; i < mesh->kz-1; i++) {
  873:                   if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
  874:                      kb = i;
  875:                      break;
  876:                   }
  877:                }
  878:          }
  879:       } 
  880:       else if (ivcor == 1) {  // Localized sigma
  881:          // Do nothing
  882:       }
  883: 
  884:    }
  885: #endif   
  886: 
  887:    __device__ double compZCoord(int k) const;
  888: 
  889: 
  890: 
  891: };
