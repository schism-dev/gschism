  327: struct Element {
  328: 
  329:    // Geometry information
  330:    int idx;               // Index of the element
  331:    int i34;               // Number of sides for the element 
  332:    Side *sides[4];        // Sides of the element
  333:    Node *nodes[4];        // Nodes of the element
  334:    Element *nghbElems[4]; // Neighbors of the element
  335: 
  336:    int kb;                    // Bottom index of the element
  337:    double area;               // Area of the element
  338:    double ssign[4];           // Sign associated with each side of an element
  339:    double radius;             // Element equivalent radii
  340: 
  341:    double wind_angle;         // Wind rotation angle
  342: 
  343:    Frame frame;
  344: 
  345:    Vector2 gradPhi[4];       // Derivatives of shape functions
  346: 
  347:    int idry;                  // True if the element is dry
  348:    int kbe;                   // Bottom index of the element
  349: 
  350:    Vector3 center;            // Element center coordinates
  351:    double xlon_el, ylat_el;   // Element center lat/lon coordinates in _degrees_
  352:    double depth;              // Depth at element (min of all nodes)
  353:    double z[nvrt];            // z-coord  (local frame - vertical up)
  354: 
  355:    // Physical information
  356:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  357: 
  358:    static const bool isblock = false;              // Always false
  359: 
  360:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  361:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  362: 
  363:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  364: 
  365:    
  366: 
  367:    double vsource;            // Volumetric source/sink term [m^3/s]
  368: 
  369:    double rho[nvrt];          // Density at each prism center
  370:    double rho_mean[nvrt];     // Mean density at each prism center
  371:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  372:    double rho_z[nvrt];        // First derivative of density at each prism center
  373:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  374: 
  375:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  376: 
  377:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  378:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  379: 
  380:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 1; }
  381:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 1; }
  382: 
  383:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  384:    __inline__ __device__ int nodeLocalIdx(Node *node) const { 
  385:       int res = (nodes[0] == node) ? 0 : ((nodes[1] == node) ? 1 : ((nodes[2] == node) ? 2 : 3)); 
  386:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  387:       return res;
  388:    }
  389: 
  390:    __inline__ __device__ int findLevel(double z1, int k) const {
  391:       // Starting at index k, find sequentially the level that contains z
  392: 
  393:       // if z is alreaf betweeen z[k] and z[k+1], return k
  394:       if (z1 >= z[k] && z1 < z[k+1]) return k;
  395:       else if (z1 < z[k]) { 
  396:          // Search for increasing levels
  397:          for (int kk = k; kk < nvrt - 1; kk++) {
  398:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  399:          }
  400:          return nvrt - 1;
  401:       }
  402:       else {
  403:          // Search for decreasing levels
  404:          for (int kk = k; kk > 0; kk--) {
  405:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  406:          }
  407:          return 0;
  408:       }
  409:    }
  410: 
  411:    __inline__ __device__ double z_prism(int k) const { return 0.5*(z[k+1] + z[k]); }
  412:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  413: 
  414:    __inline__ __device__ double computeSignedArea(void) const;
  415: 
  416:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  417:       // Nudges the point (x,y) to the barycenter of the element
  418:       p = (1-eps)*p + eps*toVector2(center);
  419:    }
  420: 
  421:    __device__ bool computeShapeCoords(Point2 xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  422: 
  423:    __device__ Vector2 grad(double *a) const
  424:    {
  425:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  426:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  427:       if (isQuad()) {
  428:          gx += a[3]*gradPhi[3].x;
  429:          gy += a[3]*gradPhi[3].y;
  430:       }
  431:       return {gx, gy};
  432:    }
  433: 
  434:    __device__ void setFrame(void) {
  435: 
  436:       double ar1, ar2;
  437:       computeLonLat(center, ar1, ar2);
  438: 
  439:       frame.update(ar1, ar2);        
  440:     }
  441: 
  442:    __device__ bool findNextIntersection(Point2 x2, Side *&side, Element *&nextElement, double &t, 
  443:                                         double& tIntersect);
  444:    __device__ bool findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement, double &t, 
  445:                                         double& tIntersect);
  446: 
  447:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  448:       // Check if the point (xt,yt) is inside the element
  449:       double shpCoords[4];
  450:       bool res = computeShapeCoords(xt, shpCoords, false);
  451:       return res;
  452:    }
  453: 
  454:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4])
  455:    {
  456:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  457:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  458:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  459:       
  460:    }
  461: 
  462:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int);
  463: 
  464:    // ------------------------------------------------------------------------------------------------
  465:    // These are functions that work on all nodes of the element.
  466:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  467:    //
  468:    // An example of how to use these functions is:
  469:    //   
  470:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  471:    // 
  472:    // Where L is the level at which the field is to be interpolated. The field can be either
  473:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  474:    // There are different versions of getNodalValues for each of these cases.
  475: 
  476:    template<typename T>
  477:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  478:       // Get the values of the field at the nodes of the element
  479:       res[0] = nodes[0]->*field;
  480:       res[1] = nodes[1]->*field;
  481:       res[2] = nodes[2]->*field;
  482:       if (isQuad()) res[3] = nodes[3]->*field;
  483:       else          res[3] = T();
  484:    }
  485: 
  486:    template<typename T>
  487:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  488:       // Get the values of the field at the nodes of the element
  489:       res[0] = (nodes[0]->*field)[level];
  490:       res[1] = (nodes[1]->*field)[level];
  491:       res[2] = (nodes[2]->*field)[level];
  492:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  493:       else          res[3] = T();
  494:    }    
  495: 
  496:    template<typename T>
  497:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  498:       // Get the values of the func at the nodes of the element
  499:       res[0] = (nodes[0]->*func)(level);
  500:       res[1] = (nodes[1]->*func)(level);
  501:       res[2] = (nodes[2]->*func)(level);
  502:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  503:       else          res[3] = T();  // This is 0.0 or a zero vector
  504: 
  505:    }      
  506: 
  507:    template<typename T>
  508:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  509:       // Get the values of the field at the nodes of the element
  510:       res[0] = sides[0]->*field;
  511:       res[1] = sides[1]->*field;
  512:       res[2] = sides[2]->*field;
  513:       if (isQuad()) res[3] = sides[3]->*field;
  514:       else          res[3] = T();
  515:    }
  516: 
  517:    template<typename T>
  518:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  519:       // Get the values of the field at the nodes of the element
  520:       res[0] = (sides[0]->*field)[level];
  521:       res[1] = (sides[1]->*field)[level];
  522:       res[2] = (sides[2]->*field)[level];
  523:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  524:       else          res[3] = T();
  525:    }    
  526: 
  527:    template<typename T>
  528:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  529:       // Get the values of the func at the nodes of the element
  530:       res[0] = (sides[0]->*func)(level);
  531:       res[1] = (sides[1]->*func)(level);
  532:       res[2] = (sides[2]->*func)(level);
  533:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  534:       else          res[3] = T();  // This is 0.0 or a zero vector
  535: 
  536:    }      
  537: 
  538: 
  539:    __device__ double interpolate(int level, const double shapeCoords[4], double (Node::*func)(int) const) const {
  540:       double values[4];
  541:       getNodalValues(level, func, values);
  542: 
  543:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  544:    }
  545: 
  546:    template<typename T>
  547:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  548:       T values[4];
  549:       getNodalValues(field, values);
  550:       
  551:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  552:    }
  553: 
  554: 
  555:    template<typename T>
  556:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  557:       T values[4];
  558:       getNodalValues(level, field, values);
  559: 
  560:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  561:    }
  562: 
  563:    template<typename T>
  564:    __device__ T mean(T Node::* field) const {
  565:       T values[4];
  566:       getNodalValues(field, values);
  567: 
  568:       return (values[0] + values[1] + values[2] + values[3])/i34;
  569:    }
  570: 
  571:    template<typename T>
  572:    __device__ T mean(T Side::* field) const {
  573:       T values[4];
  574:       getSideValues(field, values);
  575:       
  576:       return (values[0] + values[1] + values[2] + values[3])/i34;
  577:    }   
  578: 
  579:    // __device__ double mean(double (Node::*func)(int) const) const {
  580:    //    double values[4];
  581:    //    getNodalValues(level, func, values);
  582:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  583:    // }
  584:    // ------------------------------------------------------------------------------------------------
  585: 
  586:    __device__ bool globalToLocal(double xt, double yt, double &xlocal, double &ylocal) const {
  587:       // Convert global coordinates to local coordinates
  588:       printf("NOT IMPLEMENTED: globalToLocal\n");
  589:       return true;
  590:    }
  591: 
  592:    __inline__ __device__ bool localToGlobal(double xlocal, double ylocal, double &xt, double &yt) const {
  593:       // Convert local coordinates to global coordinates
  594:       printf("NOT IMPLEMENTED: localToGlobal\n");
  595:       return true;
  596:    }
  597: 
  598:    __device__ void trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
  599:                                        double &dt, Point3 &xt, double zint, Vector3 &u_int);
  600:     
  601:    __device__ bool trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
  602:                                                  Element *&nextElem, int &jlev, double &dt);
  603: 
  604: };
