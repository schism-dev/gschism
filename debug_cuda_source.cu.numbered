 2254: __host__ __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2255: 
 2256: __device__ double Node::compZCoord(int k) const {
 2257:    // Computes the z coordinate at level k.
 2258:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2259:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2260:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2261:    // used 
 2262:    
 2263:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2264:       
 2265:    if (isDry)  return 0.0;
 2266: 
 2267:    if constexpr(ivcor == 2) {
 2268: 
 2269:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2270:       const int kz = mesh->kz;
 2271: 
 2272:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2273:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2274:       // once per time step/node.
 2275:       // CHECK: updateZCoordData
 2276:       if (k == kz)               return -hmod2;
 2277:       else if (k == nvrt-1)      return eta2;
 2278:       else if (k == kb)          return -depth;
 2279:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2280:       else if (k > kz) {
 2281:          const int ksig = k - kz + 1;
 2282: 
 2283:          if (hmod2 <= mesh->h_c) {
 2284:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2285:          } 
 2286:          else if (eta2 <= - mesh->h_c - (depth - mesh->h_c) * mesh->theta_f/mesh->sinh_theta_f) {
 2287:             printf("Please choose larger h_c: %f %f\n", eta2, mesh->h_c);
 2288:             Error("ZCOOR: invalid h_c\n");
 2289:          } 
 2290:          else {
 2291:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2292:                          mesh->h_c * mesh->sigma[ksig] + 
 2293:                          (hmod2 - mesh->h_c) * mesh->cs[ksig];
 2294:          }
 2295:       } else { 
 2296:          Error("ZCOOR: invalid level or coordinate system\n");
 2297:       }
 2298: 
 2299:    }
 2300:    else if constexpr(ivcor == 1) {
 2301:       if (k == kb) return -depth;
 2302:       else if (k == nvrt-1) return eta2;
 2303:       else if (k >= kb) {
 2304:             return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2305:       }
 2306:    }
 2307:    
 2308:    printf("ZCOOR: invalid level or coordinate system\n");
 2309:    return 0.0;
 2310: }
 2311: 
 2312: 
 2313: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2314:                 double *node_coords, double *wind_rotate_angle, 
 2315:                 int *isdel, int *isidenode, int *isbnd,
 2316:                 int *nond, int *nlnd, int *iond, int *ilnd,
 2317:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2318:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2319:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2320:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2321:                 int *localNodePart,     int *localElemPart,     int *localSidePart) {
 2322: 
 2323:    printf("Populating mesh for partition %d\n", partNum);
 2324: 
 2325:    // Horizontal grid
 2326:    printf("Processing %d nodes\n", np);    
 2327: 
 2328: 
 2329:    int idxNodeBoundary = 0;  
 2330:    for (int i = 0; i < np; i++)
 2331:    {
 2332:       Node &node = localNodeData[i];
 2333: 
 2334:       node.idx = i;
 2335: 
 2336:       const int idxNodeStart = nodeNeighNodesStart[i];
 2337:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2338:       node.numNodes = idxNodeEnd - idxNodeStart;
 2339:       node.nodes = nodeNeighNodes + idxNodeStart;
 2340:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2341: 
 2342: 
 2343: 
 2344:       const int idxElemStart = nodeNeighElemsStart[i];
 2345:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2346:       node.numElements = idxElemEnd - idxElemStart;
 2347:       node.elements = nodeNeighElems + idxElemStart;
 2348: 
 2349: 
 2350:       
 2351:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2352:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2353:          const int partNode = localNodePart[idxNodeGlobal]; 
 2354:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2355: 
 2356: 
 2357:          Node *node_ptr = nodes[partNode] + idxNode;
 2358:          
 2359:          nodeNeighNodes[idx] = node_ptr;
 2360:       }
 2361: 
 2362:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2363:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2364:          const int partElem = localElemPart[idxElemGlobal];
 2365:          const int idxElem  = localElemIndices[idxElemGlobal];
 2366: 
 2367:          Element *elem_ptr = elems[partElem] + idxElem;
 2368: 
 2369:          nodeNeighElems[idx] = elem_ptr;
 2370:       }      
 2371: 
 2372: 
 2373:       node.wind_angle = wind_rotate_angle[i];
 2374: 
 2375:       // Element **elements; // pointer to the elements connected to this node
 2376:       // int numElements;   // number of elements shared by this node
 2377: 
 2378:       node.p.x   = node_coords[i * 3];
 2379:       node.p.y   = node_coords[i * 3 + 1];
 2380:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2381:       node.depth = node_coords[i * 3 + 2];
 2382: 
 2383: 
 2384: 
 2385:       // Links the node to the boundary information
 2386:       if (isbnd[i] >= 0) {
 2387:        
 2388:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2389:          node.nodeBnd->node = &node;
 2390: 
 2391:          if (isbnd[i]>0) {
 2392: 
 2393:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2394:             node.nodeBnd->segment->ifltype = isbnd[i];
 2395: 
 2396:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2397:             node.nodeBnd->segment->clen  = nan("1");
 2398:             node.nodeBnd->segment->carea = nan("1");
 2399: 
 2400:          }
 2401:          else {
 2402:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2403:          }
 2404:          
 2405:          idxNodeBoundary++;
 2406:       }
 2407:       else {
 2408:          node.nodeBnd = nullptr;
 2409:       }
 2410: 
 2411: // XXXX
 2412: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2413: constexpr double rot_per = 3000.0;
 2414: constexpr double rot_f = 0.0*2.0*pi/rot_per;
 2415: for (int k = 0; k < nvrt; k++) {node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0};}
 2416: // XXXXX
 2417:    }
 2418: 
 2419:    nbp = idxNodeBoundary;
 2420: 
 2421:    printf("Processing %d sides\n", ns);
 2422:    int idxSideBoundary = 0;
 2423:    for (int i = 0; i < ns; i++)
 2424:    {
 2425:       Side &side = localSideData[i];
 2426:       side.idx = i;
 2427:       // finding the pointer to the nodes that form the side
 2428:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2429:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2430: 
 2431:       const int locidx_n1 = localNodeIndices[idx_n1];
 2432:       const int locidx_n2 = localNodeIndices[idx_n2];
 2433:       const int part_n1 =   localNodePart[idx_n1];
 2434:       const int part_n2 =   localNodePart[idx_n2];
 2435: 
 2436:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2437:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2438: 
 2439:       // Normal vector to the side
 2440:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2441:       const double norm = sqrt(dot(side.n, side.n));
 2442:       side.n = side.n/norm;
 2443: 
 2444:       // Side boundary type
 2445:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 2446:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 2447:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2448:       
 2449:       if (n1bnd != nullptr || n2bnd != nullptr) 
 2450:       {
 2451:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2452:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2453:          else                  side.sideBnd->segment = n2bnd->segment;
 2454:          side.sideBnd->side = &side;
 2455:          idxSideBoundary++;
 2456:       }
 2457:       else side.sideBnd = nullptr;
 2458: 
 2459:       // finding the pointer to the elements that share the side
 2460:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2461:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2462: 
 2463:       if (idx_e1 > -1) {
 2464:          const int locidx_e1 = localElemIndices[idx_e1];
 2465:          const int part_e1 =  localElemPart[idx_e1];
 2466:          side.elems[0] = elems[part_e1] + locidx_e1;
 2467:          // printf("s@@ part_e1 = %d, locidx_e1 = %d, elems[part_e1] = %p\n", part_e1, locidx_e1, elems[part_e1]);
 2468:          // // printf("s-- side.elems[0] = %p idx = %d i34 = %d (x,y,z) = (%f,%f,%f) size = %d\n", side.elems[0], side.elems[0]->idx, side.elems[0]->i34, side.elems[0]->center.x, side.elems[0]->center.y, side.elems[0]->center.z, sizeof(Element));
 2469:          // printf("o-- elems = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2470:       }
 2471:       else {
 2472:          side.elems[0] = nullptr;
 2473:       }
 2474: 
 2475:       if (idx_e2 > -1) {
 2476:          const int locidx_e2 = localElemIndices[idx_e2];
 2477:          const int part_e2 =  localElemPart[idx_e2];
 2478:          side.elems[1] = elems[part_e2] + locidx_e2;
 2479:       }
 2480:       else {
 2481:          side.elems[1] = nullptr;
 2482:       }
 2483: 
 2484: 
 2485: 
 2486:       // Compute the center of the side
 2487:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2488: 
 2489: // XXXX
 2490: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2491: constexpr double rot_per=3000.0;
 2492: constexpr double rot_f=0.0*2.0*pi/rot_per;
 2493: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2494: // XXXXX      
 2495: 
 2496:       // Compute the z level at the center of the side
 2497:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->znl[k] + side.n2->znl[k]);
 2498: 
 2499:       // Compute the length of the side
 2500:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2501:       side.length = sqrt(dot(vLen, vLen));
 2502: 
 2503:    }
 2504: 
 2505:    printf("Processing %d elements\n", ne);
 2506:    for (int i = 0; i < ne; i++)
 2507:    {
 2508:       Element &elem = localElemData[i];
 2509:       elem.idx = i;
 2510:       for (int j = 0; j < i34[i]; j++) {
 2511:          const int idxNode = elnode[i*4 + j];  
 2512:          const int idxSide = elside[i*4 + j];
 2513:          
 2514:          elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 2515:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2516: 
 2517: 
 2518: 
 2519:          // Find the neighboring element  
 2520:          if (elem.sides[j]->elems[0] == &elem) {
 2521:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2522:          }
 2523:          else {
 2524:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2525:          }
 2526:          
 2527:       }
 2528: 
 2529:       elem.i34 = i34[i];
 2530: 
 2531: // printf("elem = %p, elem.i34 = %d\n", &elem, elem.i34);
 2532: 
 2533:       // Compute the centroid of the element and its depth
 2534:       Vector2 center = {0.0, 0.0};
 2535:       elem.depth = 0.0;
 2536:       for (int j = 0; j < i34[i]; j++) {
 2537:          center += elem.nodes[j]->p2()/i34[i];
 2538:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2539:       }
 2540:       elem.center.x = center.x;
 2541:       elem.center.y = center.y;
 2542: 
 2543:       // printf("elem = %p, i34 = %d, center = (%f,%f,%f)\n", &elem, elem.i34, elem.center.x, elem.center.y, elem.depth);
 2544:       
 2545:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2546:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2547: 
 2548:       elem.area = elem.computeSignedArea(); 
 2549:       elem.radius = sqrt(elem.area)/pi; 
 2550:       
 2551:       // Determines which way the normal vector to each side is oriented.
 2552:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2553:       for (int j = 0; j < i34[i]; j++)  
 2554:       {
 2555:          if (elem.sides[j]->elems[0] == &elem) {
 2556:             elem.ssign[j] =  1.0;
 2557:          }
 2558:          else {
 2559:             elem.ssign[j] = -1.0;
 2560:          }
 2561: 
 2562:       }
 2563: 
 2564:       // Derivatives of shape functions
 2565:       //  For ics=2, this is done inside element/ll frame XXX
 2566:       //  For quads, the derivative is evaluated at centroid
 2567:       const int i34 = elem.i34;
 2568:       for (int j = 0; j < i34; j++) {
 2569:          const double area = elem.area;
 2570:          const int id2 = elem.nxq(1 + j);
 2571:          const int id3 = elem.nxq(2 + j);
 2572:          const int id4 = elem.nxq(3 + j);
 2573:          if (elem.isTri()) {
 2574:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2575:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2576:             // da1/dx = (y1 - y2)/(2*area)
 2577:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2578:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2579:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2580:          }
 2581:          else  { // Quad; evaluate at centroid
 2582:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2583:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2584:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2585:          } // if Tri
 2586: 
 2587:       } // for j
 2588: 
 2589:    }
 2590: 
 2591: 
 2592:    // Processing the boundary nodes
 2593:    int idx = 0;
 2594:    for (int iseg = 0; iseg < nope; iseg++) {
 2595:       for (int ilnd = 0; ilnd < nlnd[iseg]; ilnd++) {
 2596: 
 2597:          NodeBoundary *nodeBnd = &localNodeBoundaryMem[idx];
 2598: 
 2599:          nodeBnd->isEssentialBC = true;
 2600: nodeBnd->iettype = 3;
 2601:          nodeBnd->bcValue = 0.0;
 2602: 
 2603:          idx++;
 2604:       }
 2605: 
 2606:    }
 2607: 
 2608: }
 2609: 
 2610: 
 2611: 
 2612: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 2613:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 2614:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 2615:    // 
 2616:    // This kernel is called for all nodes.
 2617: 
 2618: 
 2619:    NODE(node1);
 2620: 
 2621: 
 2622:    node1->clearMatrixRow();
 2623:    node1->qel = 0.0;
 2624: 
 2625:    // THIS IS FOR STRUCTURES XXX
 2626:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 2627: 
 2628:    
 2629:    for (int j=0; j<node1->numElements; j++) {
 2630:       // For each element connected to the node...
 2631: 
 2632:       Element *elem = node1->elements[j];
 2633: 
 2634:       // Compute the average gravity
 2635:       printf("UUU Node::grav2 = %f, %f, %f\n", elem->nodes[0]->grav2, elem->nodes[1]->grav2, elem->nodes[2]->grav2);
 2636:       const double grav3 = elem->mean(&Node::grav2);
 2637: 
 2638:       // Look at the documentation for the description of the terms in the following integrals
 2639: 
 2640:       // Integral I_1 
 2641:       // \bar{\breve{H}} 
 2642:       const double hhatb = elem->mean(&Side::hhat);        
 2643: 
 2644: 
 2645:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 2646: 
 2647:       const int id1 = elem->nodeLocalIdx(node1); 
 2648:       const double area = elem->area;
 2649: 
 2650:       if (elem->isTri()) {
 2651: 
 2652:          // To clarify the notation in this section: 
 2653:          //   i stands for the node under consideration (node1)
 2654:          //   j (node2) and k (node3) are the other nodes of the triangle.
 2655:          const int id2 = elem->nxq(1 + id1);
 2656:          const int id3 = elem->nxq(2 + id1);
 2657:          Node *node2 = elem->nodes[id2];
 2658:          Node *node3 = elem->nodes[id3];
 2659: 
 2660:          const Point2 x1 = node1->p2();
 2661:          const Point2 x2 = node2->p2();
 2662:          const Point2 x3 = node3->p2();
 2663: 
 2664:          // integral of phi_i*phi_j
 2665:          const double ipp_ii = (1.0/6.0 )*area;
 2666:          const double ipp_ij = (1.0/12.0)*area;
 2667:          const double ipp_ik = (1.0/12.0)*area;
 2668: 
 2669:          // integral of [(grad phi_i) * (grad phi_j)]
 2670:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 2671:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 2672:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 2673: 
 2674:          // Computes the different components of integral I_1 of each node with respect to node i.
 2675:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 2676:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 2677:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 2678: 
 2679: if (j==node1->numElements-1) {
 2680: printf("grav3 = %f, thetai = %f, dt = %f, hhatb = %f, area = %f, dot1= %f, dot2 = %f, dot3 = %f\n", grav3, thetai, dt, hhatb, area, dot(x3-x2, x3-x2), dot(x3-x2, x1-x3), dot(x1-x3, x1-x3));
 2681: printf("node idx = %d, x1 = %f, %f, x2 = %f, %f, x3 = %f, %f\n", node1->idx, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y);
 2682: printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 2683: }
 2684: 
 2685:          node1->addToSparseMatrix(node1, I1_ii);
 2686:          node1->addToSparseMatrix(node2, I1_ij); 
 2687:          node1->addToSparseMatrix(node3, I1_ik);
 2688: 
 2689: if (j==node1->numElements-1) printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 2690:      
 2691:       }
 2692:       else { // Quad
 2693:          // XXX IMPLEMENT THIS
 2694:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2695:       } 
 2696: 
 2697:  
 2698:       // Integral I_4
 2699:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 2700:       // Where
 2701:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 2702: 
 2703:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 2704:       // of U over the element.
 2705:       Vector2 Umean = {0.0, 0.0};
 2706:       for (int m=0; m<elem->i34; m++) {      
 2707:          const Side *side = elem->sides[m];
 2708: 
 2709:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 2710:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 2711:       }
 2712:       Umean = Umean/elem->i34;
 2713: 
 2714:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 2715: 
 2716:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 2717:       const double I_4_1 = dot(gradPhi_1, Umean);
 2718: 
 2719:       // Integral of \nabla\phi_i \cdot \pmb{E}
 2720:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 2721:      
 2722:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 2723: if (j==node1->numElements-1) printf("MMMMmm  idx_node = %d, I_4_1 = %.15g, I_4_2 = %.15g, node1->qel = %.15g, gradPhi_1 = %.15g, %.15g, elem->ghat1 = %.15g, %.15g\n", node1->idx, I_4_1, I_4_2, node1->qel, gradPhi_1.x, gradPhi_1.y, elem->ghat1.x, elem->ghat1.y);
 2724: 
 2725:       // Additional terms 
 2726:       double vnorm = 0.0;
 2727:       if (imm == 2)  { // Pre-compute vnorm on the element
 2728:          Vector3 ubed;
 2729:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 2730: 
 2731:          Vector3 gradP = {0.0, 0.0, 1.0};
 2732:          for (int m=0; m < elem->i34; m++) {
 2733:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 2734:            gradP += toVector3(gradP_2D, 0.0);
 2735:          }   
 2736:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 2737:       } // imm==2
 2738: 
 2739:       if (elem->isTri()) {
 2740:          for (int l=0; l<3; l++) {
 2741:            double fac;
 2742: 
 2743:            Node *node = elem->nodes[l];
 2744: 
 2745:            (node == node1)? fac=2.0 : fac=1.0;
 2746: 
 2747:            if (imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 2748:            else        node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 2749:            
 2750:          }
 2751: 
 2752: 
 2753:          if (!elem->isDry) {
 2754:            const Vector2 gradEta = elem->nodes[0]->eta2*elem->gradPhi[0] +
 2755:                                    elem->nodes[1]->eta2*elem->gradPhi[1] +
 2756:                                    elem->nodes[2]->eta2*elem->gradPhi[2];
 2757: 
 2758:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 2759:          }
 2760: if (j==node1->numElements-1) printf("&&& node1->qel = %f\n", node1->qel, node1->eta2);
 2761: 
 2762:       } // isTri
 2763:       else { // isQuad
 2764:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2765:          // for (int l=0; l<4; l++) {
 2766:          //   const Node *node = elem->nodes[l];
 2767: 
 2768:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 2769:          //   else        tmp2 = node->bdef2 - node->bdef1;
 2770: 
 2771:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 2772:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 2773:          // }
 2774: 
 2775:       } // isQuad
 2776: 
 2777: 
 2778:       node1->qel += (dt/elem->i34)*elem->vsource;
 2779:       
 2780: 
 2781:    } // for all elements connected to the node
 2782:    
 2783: 
 2784: 
 2785:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 2786:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 2787:    NodeBoundary *nodeBnd = node1->nodeBnd;
 2788:    if (nodeBnd != nullptr)  { 
 2789:       // If it is an open boundary node...
 2790: 
 2791:       // At least one open bnd side, maybe two
 2792:       for (int l=0; l<2; l++) { 
 2793: 
 2794:          // Gets each of the sides sharing the node. 
 2795:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 2796: 
 2797:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 2798: 
 2799:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 2800: 
 2801: 
 2802:          if (sideBnd != nullptr) {
 2803:             // If the side is on a boundary...
 2804: 
 2805:             // Get the boundary segment
 2806:             const BoundarySegment *sideSegment = sideBnd->segment;
 2807:             const Side *side = sideBnd->side;
 2808: 
 2809:             // Integral I_3
 2810:             if (sideSegment->ifltype != 0) {
 2811:             // Natural or Flather b.c.
 2812: 
 2813:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 2814:                // especially for Flather b.c.
 2815:                double ri3 = 0.0;
 2816:                if (!side->isDry) {
 2817:                   // If the side is not dry
 2818:                   
 2819:                   // Computes the side flux of (uth, vth)
 2820:                   double Vn = 0.0;
 2821:                   for (int k = side->kb; k<nvrt-1; k++) {
 2822:                      // uth, vth in lat/lon frame if ics=2
 2823:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 2824:                      const double vn1 = dot(side->uth[k  ], side->n); // outer normal
 2825:                      const double vn2 = dot(side->uth[k+1], side->n);
 2826: 
 2827:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 2828:                   }
 2829: 
 2830:                   ri3 = 0.5*side->length*Vn;
 2831:                }
 2832: 
 2833:                if (sideSegment->ifltype == -1) { // Flather 1
 2834: 
 2835:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 2836:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 2837: 
 2838:                   const double con0 = (1.0/6.0)*side->length*sqrt(grav*side->depth()); // For coefficient matrix
 2839:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 2840:                   
 2841:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 2842:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 2843: 
 2844:                } 
 2845:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 2846:                   // Reset ri3
 2847:                   ri3 = 0.0;
 2848: 
 2849:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 2850: 
 2851:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 2852: 
 2853:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 2854:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 2855: 
 2856:                   const double con0 = (1.0/6.0)*side->length*tmp*thetai*dt;
 2857:                   node1->addToSparseMatrix(node1, con0*2.0);
 2858:                   node1->addToSparseMatrix(node2, con0);
 2859: 
 2860:                } // if Flather or Discharge
 2861: 
 2862:                node1->qel -= thetai*dt*ri3;
 2863: 
 2864:             } // I_3
 2865:           
 2866: 
 2867:             // Integral I_5
 2868:             if(!side->isDry) {
 2869: 
 2870:                const double Unbar = dot(side->U, side->n);
 2871: 
 2872:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->length*Unbar;
 2873:                
 2874:             } // I_5
 2875: 
 2876:          } // if is boundary side
 2877: 
 2878:       } // for l
 2879: 
 2880:    } // if isbnd
 2881: 
 2882: 
 2883:    printf("44444444 idx_node = %d, node1->qel = %f\n", node1->idx, node1->qel);
 2884: 
 2885: }
 2886: 
 2887: 
 2888: extern "C" {
 2889:    __global__ void backtrackAllNodes(void) {
 2890: 
 2891:       // max/min # of sub-divisions
 2892:       const int ndelt_max = max(1.0, dt/dtb_min);
 2893:       const int ndelt_min = max(1.0, dt/dtb_max); 
 2894: 
 2895:       // Removed all references to swild98 XXX
 2896:       // swild98=0.d0 !init
 2897: 
 2898: 
 2899:       SIDE(side);
 2900: 
 2901:       const int kb = side->kb;
 2902: 
 2903:       printf("backtrackAllNodes: side->idx = %d, nvrt = %d\n", side->idx, nvrt);
 2904: 
 2905:       // Initialize btrack velocities to the actual velocities at the side 
 2906:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 2907: 
 2908: 
 2909:       if (side->isDry) return;
 2910: 
 2911: 
 2912:       // Checks that at least one element is not dry
 2913:       const Element *elem1 = side->elems[0];
 2914:       const Element *elem2 = side->elems[1];
 2915: 
 2916: 
 2917:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 2918:       
 2919:       // XXXXXX
 2920:       // !swild_tmp to store global coord. of the starting side
 2921:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 2922:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 2923:       // !Use sframe2 
 2924:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 2925: 
 2926: 
 2927:       for (int k = kb; k < nvrt; k++) {
 2928:       //  Initialize (xt,yt,zt), nnel and vel.
 2929:       //  For ics=2, the coordinates are in local frames
 2930:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 2931: 
 2932: 
 2933:          const int iadvf = side->iadv();  // Advection flag
 2934: 
 2935:          Point3 xt;
 2936:          if constexpr(ics==1) {
 2937:             xt = side->center3D(k); 
 2938:          }
 2939:          else // lat/lon; in side lat/lon frame
 2940:          {
 2941:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 2942:          // XXX IMPLEMENT THIS
 2943:       //          xt=0.d0
 2944:       //          yt=0.d0
 2945:       //          !centroid coord. for nudging
 2946:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 2947:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 2948:          }  // ics
 2949: 
 2950: 
 2951:          // Velocity at the side (in ll frame for ics, same vertical direction)
 2952:          // XXX IS THIS NECESSARY?
 2953:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 2954: 
 2955:          // If on land or open boundary...
 2956:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 2957:          
 2958:          const double vmag = length(toVector2(u_int));
 2959: 
 2960:          if (vmag <= velmin_btrack) {
 2961:             // No activity 
 2962: 
 2963:             side->btu[k] = side->u2[k];
 2964: 
 2965:             
 2966:          } else {  // do btrack
 2967: 
 2968:           
 2969:             // Compute number of sub-divisions based on local gradients 
 2970:             // XXX IS THIS NECESSARY?
 2971:             double suma = 0.0;
 2972:             int icount = 0;
 2973:             for (int ii=0; ii<2; ii++) {
 2974: 
 2975:                const Element *elem = side->elems[ii];
 2976:                  
 2977:                if (elem == nullptr) continue;
 2978: 
 2979:                icount++;
 2980: 
 2981:                // Not strictly along z; in ll frame for ics=2
 2982: 
 2983:                double utmp[4];
 2984:                double vtmp[4];
 2985:                for (int jj = 0; jj < elem->i34; jj++) {
 2986: 
 2987:                   const Node *node = elem->nodes[jj];
 2988: 
 2989:                   if constexpr(ics==1) {
 2990:                      utmp[jj] = node->u2[k].x;
 2991:                      vtmp[jj] = node->u2[k].y;  
 2992:                   } else {
 2993:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 2994:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 2995:                   }
 2996:                } // for jj
 2997: 
 2998:                const Vector2 grad_u = elem->grad(utmp); 
 2999:                const Vector2 grad_v = elem->grad(vtmp);
 3000: 
 3001:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3002:             } // for ii
 3003: 
 3004:             assert(icount > 0 && "Impossible 77");
 3005: 
 3006:             // '4' is somewhat arbitrary
 3007:             const int ndelt = max(ndelt_min, min(ndelt_max, int(suma/icount)*4)); // >=1
 3008: 
 3009:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3010:          
 3011: 
 3012:             Vector3 u_int = {0.0, 0.0, 0.0};
 3013: 
 3014:             side->btrack(k, dt, dtbk, u_int);
 3015: 
 3016:                
 3017:          } // if vmag (do backtrack)
 3018: 
 3019:       } // for j=jmin,nvrt-1
 3020: 
 3021:    }
 3022: } // extern "C"
 3023: 
 3024: template<int nc>
 3025: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3026: 
 3027: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3028: //
 3029: // a,b,c,r: input vectors and are not modified by this program.
 3030: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3031: // r is the r.h.s.
 3032: // n: actual rank of the system.
 3033: // rows in u() and r();
 3034: // u: output with nc columns (transposed to rows)
 3035: // gam: a working array.
 3036: //
 3037: // NOTES:
 3038: // This is a template function that allows for different numbers of columns in the rhs vector.
 3039: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3040: 
 3041:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3042:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3043: 
 3044:    double bet = b[0];
 3045:    if constexpr (nc == 1) {
 3046:       u[0] = rhs[0]/bet;
 3047:    } else {
 3048:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 3049:    }
 3050: 
 3051:    for (int j = 1; j < n; j++) {
 3052:       gam[j] = c[j-1]/bet;
 3053:       bet = b[j] - a[j]*gam[j];
 3054: 
 3055:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3056: 
 3057:       if constexpr (nc == 1) {
 3058:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3059:       } else {
 3060:          for (int k = 0; k < nc; k++) {
 3061:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 3062:          }
 3063:       }
 3064:    }
 3065: 
 3066:    // Back-substitution
 3067:    for (int j=n-1; j>=1; j--) {
 3068:       if constexpr (nc == 1) {
 3069:          u[j] = u[j] - gam[j+1]*u[j-1];
 3070:       } else {
 3071:          for (int k = 0; k < nc; k++) {
 3072:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 3073:          }
 3074:       }
 3075:    }
 3076: }
 3077: 
 3078: 
 3079: 
 3080: 
 3081: // Helper function that contains the core algorithm
 3082: template<typename XAccessor, typename YAccessor>
 3083: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3084:                                     double  yp_top, double  yp_bot, 
 3085:                                     CubicSpline &spline) {
 3086:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3087:    // 
 3088:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3089:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3090:    //
 3091:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3092:    // 
 3093:    // Inputs: 
 3094:    //            n: dimension for x etc; # of data pts (>=2);
 3095:    //            getX, getY: functions to access x,y coordinates
 3096:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3097:    //     Output: 
 3098:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3099: 
 3100:    const int n = k2 - k1 + 1;
 3101:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3102: 
 3103:    // Allocate memory for the splines
 3104:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3105:    spline.x   = new double[n];
 3106:    spline.y   = new double[n];
 3107:    spline.yp  = new double[n];
 3108:    spline.ypp = new double[n];
 3109: 
 3110:    for (int k=k1; k<=k2; k++) {
 3111:       spline.x[k] = getX(k);
 3112:       spline.y[k] = getY(k);
 3113:    }
 3114: 
 3115:    // This is to simplify expressions later
 3116:    double *x = spline.x;
 3117:    double *y = spline.y;
 3118: 
 3119:    double *a = nullptr;
 3120:    double *b = nullptr;
 3121:    double *c = nullptr;
 3122:    double *gam = nullptr;
 3123:    double *rhs = nullptr;
 3124:    
 3125: 
 3126:       a = new double[n];   // Lower diagonal
 3127:       b = new double[n];   // Diagonal
 3128:       c = new double[n];   // Upper diagonal
 3129:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3130:       rhs = new double[n]; // Right-hand side
 3131: 
 3132:    for (int k=k1; k<=k2; k++) {
 3133:       if (k == k1) {
 3134:          // Bottom level
 3135:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3136:          b[k] = (x[k+1] - x[k])/3.0;
 3137:          c[k] = b[k]/2.0;
 3138:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3139:       } else if (k == n - 1) {
 3140:          // Top level (surface)
 3141:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3142:          b[k] = (x[k] - x[k-1])/3.0;
 3143:          a[k] = b[k]/2.0;
 3144:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3145:       } else {
 3146:          // Intermediate levels
 3147:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3148:          b[k] = (x[k+1] - x[k-1])/3.0;
 3149:          a[k] = (x[k  ] - x[k-1])/6.0;
 3150:          c[k] = (x[k+1] - x[k  ])/6.0;
 3151:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3152:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3153:       }
 3154:    }
 3155: 
 3156:    // Solve the tridiagonal system
 3157:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3158:    
 3159:    spline.yp[k1] = yp_bot;
 3160:    spline.yp[k2] = yp_top;
 3161: 
 3162:    // Compute rest of 1st derivatives using the splines
 3163:    for (int k=k1+1; k<k2; k++) {
 3164:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3165:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3166:    }
 3167:    
 3168:    delete[] a;
 3169:    delete[] b;
 3170:    delete[] c;
 3171:    delete[] gam;
 3172:    delete[] rhs;
 3173: 
 3174: }
 3175: 
 3176: // Array version
 3177: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3178:                                 double y_top, double y_bot, 
 3179:                                 CubicSpline &spline) {
 3180:    auto getX = [x] (int k) { return x[k]; };
 3181:    auto getY = [y] (int k) { return y[k]; };
 3182:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3183: }
 3184: 
 3185: // Lambda version - allows custom access patterns
 3186: template<typename XFunc, typename YFunc>
 3187: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3188:                                 double y_top, double y_bot,
 3189:                                 CubicSpline &spline) {
 3190:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3191: }
 3192: 
 3193: 
 3194: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 3195: {
 3196:    assert("Not implemented");
 3197: 
 3198:    return 0.0;
 3199: }
