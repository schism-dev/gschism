   39: constexpr int nzlev = 5; // Number of z levels (in contrast to sigma levels)
   40: constexpr int nsiglev = nvrt - nzlev + 1; // Number of sigma levels (in contrast to z levels)
   41: 
   42: constexpr double small1 = 1.0e-10;       // Small non-negative number
   43: constexpr double small2 = small1*100.0;  // Slightly larger than small1
   44: constexpr double small = 0.0;            // Small positive number or 0
