 3267: extern "C" {
 3268: 
 3269:    __global__ void scaleGravity(double loadtide_coef) {
 3270: 
 3271: 
 3272:       NODE(node);
 3273: 
 3274:       // SAL option: scale gravity
 3275:       if constexpr(iloadtide==2) {  // simple const
 3276:          node->grav2 = grav*(1.0 - loadtide_coef);
 3277: 
 3278:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3279:         
 3280:           const double depth = max(node->depth, 0.0);
 3281:           const double tmp1 = sqrt(depth);
 3282:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3283:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3284:                              2.6969e-13*depth*depth*depth*tmp1;
 3285:           
 3286:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3287:           
 3288: 
 3289: 
 3290:           node->grav2 = grav*(1.0 - beta_bar);
 3291: 
 3292:       } else {  // iloadtide=0,1
 3293:         node->grav2=grav;
 3294: 
 3295:       }
 3296: 
 3297:       printf("scaleGravity: node(%d)->grav2 = %f\n", node->idx, node->grav2);
 3298:    }
 3299: 
