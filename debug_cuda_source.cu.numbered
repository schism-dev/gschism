 3216:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3217: 
 3218:       NODE_BND(nodeBnd);
 3219: 
 3220:       Node *node = nodeBnd->node;
 3221: 
 3222:       printf("computeTidalPotential: nodeIdx = %d, ntip = %d\n", node->idx, ntip);
 3223:       node->ETP = 0.0;
 3224: 
 3225:       for (int j=0; j<ntip; j++) {
 3226: 
 3227:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3228:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3229:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3230: 
 3231:          if constexpr(iloadtide==1) { // loading tide
 3232:             assert(false && "Loading tide not implemented");
 3233:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3234:          }
 3235:          
 3236:       }
 3237:       
 3238:    }
