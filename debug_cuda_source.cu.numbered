 2193: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2194:                 double *node_coords, double *wind_rotate_angle, 
 2195:                 int *isdel, int *isidenode, int *isbnd,
 2196:                 int *nond, int *nlnd, int *iond, int *ilnd,
 2197:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2198:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2199:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2200:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2201:                 int *localNodePart,     int *localElemPart,     int *localSidePart) {
 2202: 
 2203:    printf("Populating mesh for partition %d, %d, %d\n", partNum, nond, nlnd);
 2204: 
 2205:    // Horizontal grid
 2206:    printf("Processing %d nodes\n", np);    
 2207: 
 2208: 
 2209:    int idxNodeBoundary = 0;  
 2210:    for (int i = 0; i < np; i++)
 2211:    {
 2212:       Node &node = localNodeData[i];
 2213: 
 2214:       node.idx = i;
 2215: 
 2216:       const int idxNodeStart = nodeNeighNodesStart[i];
 2217:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2218:       node.numNodes = idxNodeEnd - idxNodeStart;
 2219:       node.nodes = nodeNeighNodes + idxNodeStart;
 2220:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2221: 
 2222: 
 2223: 
 2224:       const int idxElemStart = nodeNeighElemsStart[i];
 2225:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2226:       node.numElements = idxElemEnd - idxElemStart;
 2227:       node.elements = nodeNeighElems + idxElemStart;
 2228: 
 2229: 
 2230:       
 2231:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2232:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2233:          const int partNode = localNodePart[idxNodeGlobal]; 
 2234:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2235: 
 2236: 
 2237:          Node *node_ptr = nodes[partNode] + idxNode;
 2238:          
 2239:          nodeNeighNodes[idx] = node_ptr;
 2240:       }
 2241: 
 2242:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2243:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2244:          const int partElem = localElemPart[idxElemGlobal];
 2245:          const int idxElem  = localElemIndices[idxElemGlobal];
 2246: 
 2247:          Element *elem_ptr = elems[partElem] + idxElem;
 2248: 
 2249:          nodeNeighElems[idx] = elem_ptr;
 2250:       }      
 2251: 
 2252: 
 2253:       node.wind_angle = wind_rotate_angle[i];
 2254: 
 2255:       // Element **elements; // pointer to the elements connected to this node
 2256:       // int numElements;   // number of elements shared by this node
 2257: 
 2258:       node.p.x   = node_coords[i * 3];
 2259:       node.p.y   = node_coords[i * 3 + 1];
 2260:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2261:       node.depth = node_coords[i * 3 + 2];
 2262: 
 2263:       // printf("ZZ elemsPtr = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2264: 
 2265:       // Links the node to the boundary information
 2266:       if (isbnd[i] >= 0) {
 2267:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2268:          if (isbnd[i]>0) {
 2269: 
 2270:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2271:             node.nodeBnd->segment->ifltype = isbnd[i];
 2272: 
 2273:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2274:             node.nodeBnd->segment->clen  = nan("1");
 2275:             node.nodeBnd->segment->carea = nan("1");
 2276: 
 2277:          }
 2278:          else {
 2279:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2280:          }
 2281:          
 2282:          idxNodeBoundary++;
 2283:       }
 2284:       else {
 2285:          node.nodeBnd = nullptr;
 2286:       }
 2287: 
 2288: // XXXX
 2289: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2290: constexpr double rot_per = 3000.0;
 2291: constexpr double rot_f = 2.0*pi/rot_per;
 2292: for (int k = 0; k < nvrt; k++) {node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0};}
 2293: // XXXXX
 2294:    }
 2295: 
 2296:    nbp = idxNodeBoundary;
 2297: 
 2298:    printf("Processing %d sides\n", ns);
 2299:    int idxSideBoundary = 0;
 2300:    for (int i = 0; i < ns; i++)
 2301:    {
 2302:       Side &side = localSideData[i];
 2303:       side.idx = i;
 2304:       // finding the pointer to the nodes that form the side
 2305:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2306:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2307: 
 2308:       const int locidx_n1 = localNodeIndices[idx_n1];
 2309:       const int locidx_n2 = localNodeIndices[idx_n2];
 2310:       const int part_n1 =   localNodePart[idx_n1];
 2311:       const int part_n2 =   localNodePart[idx_n2];
 2312: 
 2313:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2314:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2315: 
 2316:       // Normal vector to the side
 2317:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2318:       const double norm = sqrt(dot(side.n, side.n));
 2319:       side.n = side.n/norm;
 2320: 
 2321:       // Side boundary type
 2322:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 2323:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 2324:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2325:       
 2326:       if (n1bnd != nullptr || n2bnd != nullptr) 
 2327:       {
 2328:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2329:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2330:          else                  side.sideBnd->segment = n2bnd->segment;
 2331:          side.sideBnd->side = &side;
 2332:          idxSideBoundary++;
 2333:       }
 2334:       else side.sideBnd = nullptr;
 2335: 
 2336:       // finding the pointer to the elements that share the side
 2337:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2338:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2339: 
 2340:       if (idx_e1 > -1) {
 2341:          const int locidx_e1 = localElemIndices[idx_e1];
 2342:          const int part_e1 =  localElemPart[idx_e1];
 2343:          side.elems[0] = elems[part_e1] + locidx_e1;
 2344:          // printf("s@@ part_e1 = %d, locidx_e1 = %d, elems[part_e1] = %p\n", part_e1, locidx_e1, elems[part_e1]);
 2345:          // // printf("s-- side.elems[0] = %p idx = %d i34 = %d (x,y,z) = (%f,%f,%f) size = %d\n", side.elems[0], side.elems[0]->idx, side.elems[0]->i34, side.elems[0]->center.x, side.elems[0]->center.y, side.elems[0]->center.z, sizeof(Element));
 2346:          // printf("o-- elems = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2347:       }
 2348:       else {
 2349:          side.elems[0] = nullptr;
 2350:       }
 2351: 
 2352:       if (idx_e2 > -1) {
 2353:          const int locidx_e2 = localElemIndices[idx_e2];
 2354:          const int part_e2 =  localElemPart[idx_e2];
 2355:          side.elems[1] = elems[part_e2] + locidx_e2;
 2356:       }
 2357:       else {
 2358:          side.elems[1] = nullptr;
 2359:       }
 2360: 
 2361: 
 2362: 
 2363:       // Compute the center of the side
 2364:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2365: 
 2366: // XXXX
 2367: constexpr double rot_per=3000.0;
 2368: constexpr double rot_f=2.0*pi/rot_per;
 2369: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2370: // XXXXX      
 2371: 
 2372:       // Compute the z level at the center of the side
 2373:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->znl[k] + side.n2->znl[k]);
 2374: 
 2375:       // Compute the length of the side
 2376:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2377:       side.length = sqrt(dot(vLen, vLen));
 2378: 
 2379:    }
 2380: 
 2381:    printf("Processing %d elements\n", ne);
 2382:    for (int i = 0; i < ne; i++)
 2383:    {
 2384:       Element &elem = localElemData[i];
 2385:       elem.idx = i;
 2386:       for (int j = 0; j < i34[i]; j++) {
 2387:          const int idxNode = elnode[i*4 + j];  
 2388:          const int idxSide = elside[i*4 + j];
 2389:          
 2390:          elem.nodes[j] = (Node *)&(nodes[localElemPart[idxNode]][localElemIndices[idxNode]]);
 2391:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2392: 
 2393: 
 2394: 
 2395:          // Find the neighboring element  
 2396:          if (elem.sides[j]->elems[0] == &elem) {
 2397:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2398:          }
 2399:          else {
 2400:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2401:          }
 2402:          
 2403:       }
 2404: 
 2405:       elem.i34 = i34[i];
 2406: 
 2407: // printf("elem = %p, elem.i34 = %d\n", &elem, elem.i34);
 2408: 
 2409:       // Compute the centroid of the element and its depth
 2410:       Vector2 center = {0.0, 0.0};
 2411:       elem.depth = 0.0;
 2412:       for (int j = 0; j < i34[i]; j++) {
 2413:          center += elem.nodes[j]->p2()/i34[i];
 2414:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2415:       }
 2416:       elem.center.x = center.x;
 2417:       elem.center.y = center.y;
 2418: 
 2419:       // printf("elem = %p, i34 = %d, center = (%f,%f,%f)\n", &elem, elem.i34, elem.center.x, elem.center.y, elem.depth);
 2420:       
 2421:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2422:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2423: 
 2424:       elem.area = elem.computeSignedArea(); 
 2425:       elem.radius = sqrt(elem.area)/pi; 
 2426:       
 2427:       // Determines which way the normal vector to each side is oriented.
 2428:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2429:       for (int j = 0; j < i34[i]; j++)  
 2430:       {
 2431:          if (elem.sides[j]->elems[0] == &elem) {
 2432:             elem.ssign[j] =  1.0;
 2433:          }
 2434:          else {
 2435:             elem.ssign[j] = -1.0;
 2436:          }
 2437: 
 2438:       }
 2439: 
 2440:       // Derivatives of shape functions
 2441:       //  For ics=2, this is done inside element/ll frame XXX
 2442:       //  For quads, the derivative is evaluated at centroid
 2443:       const int i34 = elem.i34;
 2444:       for (int j = 0; j < i34; j++) {
 2445:          const double area = elem.area;
 2446:          const int id2 = elem.nxq(1 + j);
 2447:          const int id3 = elem.nxq(2 + j);
 2448:          const int id4 = elem.nxq(3 + j);
 2449:          if (elem.isTri()) {
 2450:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2451:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2452:             // da1/dx = (y1 - y2)/(2*area)
 2453:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2454:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2455:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2456:          }
 2457:          else  { // Quad; evaluate at centroid
 2458:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2459:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2460:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2461:          } // if Tri
 2462: 
 2463:       } // for j
 2464: 
 2465:    }
 2466: 
 2467: }
 2468: 
