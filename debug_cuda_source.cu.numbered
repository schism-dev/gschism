 2312: 
 2313: __global__ void setupCoefficientMatrixAndRHS(double time) {
 2314: // Setup coefficient matrix, sparsem, for the shallow water wave equation
 2315: // No elevation essential b.c. are imposed yet but other b.c. is imposed
 2316: // 
 2317: // This kernel is called for all nodes.
 2318: 
 2319:    int in = 1; //XXX blockIdx.x * blockDim.x + threadIdx.x;
 2320: 
 2321:    Node *node1 = &(mesh->localNodeData[in]);
 2322: 
 2323: 
 2324:    node1->clearMatrixRow();
 2325:    node1->qel = 0.0;
 2326: 
 2327:    // THIS IS FOR STRUCTURES XXX
 2328:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 2329: 
 2330: 
 2331:    for (int j=0; j<node1->numElements; j++) {
 2332:       // For each element connected to the node...
 2333: 
 2334:       Element *elem = node1->elements[j];
 2335: 
 2336: 
 2337:       // Compute the average gravity
 2338:       const double grav3 = elem->mean(&Node::grav2);
 2339: 
 2340:       // Look at the documentation for the description of the terms in the following integrals
 2341: 
 2342:       // Integral I_1 
 2343:       // \bar{\breve{H}} 
 2344:       const double hhatb = elem->mean(&Side::hhat);        
 2345: 
 2346:       assert((hhatb >= 0.0 || ihh != 1) && "Invalid hhat");
 2347: 
 2348:       const int id1 = elem->nodeLocalIdx(node1); 
 2349:       const double area = elem->area;
 2350: 
 2351:       if (elem->isTri()) {
 2352: 
 2353:          // To clarify the notation in this section: 
 2354:          //   i standtimes for the node under consideration (node1)
 2355:          //   j (node2) and k (node3) are the other nodes of the triangle.
 2356:          const int id2 = elem->nxq(1 + id1);
 2357:          const int id3 = elem->nxq(2 + id1);
 2358:          Node *node2 = elem->nodes[id2];
 2359:          Node *node3 = elem->nodes[id3];
 2360: 
 2361:          const Point2 x1 = node1->p2();
 2362:          const Point2 x2 = node2->p2();
 2363:          const Point2 x3 = node3->p2();
 2364: 
 2365:          // integral of phi_i*phi_j
 2366:          const double ipp_ii = (1.0/6.0 )*area;
 2367:          const double ipp_ij = (1.0/12.0)*area;
 2368:          const double ipp_ik = (1.0/12.0)*area;
 2369: 
 2370:          // integral of [(grad phi_i) * (grad phi_j)]
 2371:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 2372:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 2373:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 2374: 
 2375:          // Computes the different components of integral I_1 of each node with respect to node i.
 2376:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 2377:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 2378:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 2379: 
 2380:          node1->addToSparseMatrix(node1, I1_ii);
 2381:          node1->addToSparseMatrix(node2, I1_ij); 
 2382:          node1->addToSparseMatrix(node3, I1_ik);
 2383:      
 2384:       }
 2385:       else { // Quad
 2386:          // XXX IMPLEMENT THIS
 2387:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2388:       } 
 2389: 
 2390:  
 2391:       // Integral I_4
 2392:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 2393:       // Where
 2394:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 2395: 
 2396:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 2397:       // of U over the element.
 2398:       Vector2 Umean = {0.0, 0.0};
 2399:       for (int m=0; m<elem->i34; m++) {      
 2400:          const Side *side = elem->sides[m];
 2401: 
 2402:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 2403:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 2404:       }
 2405:       Umean = Umean/elem->i34;
 2406: 
 2407:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 2408: 
 2409:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 2410:       const double I_4_1 = dot(gradPhi_1, Umean);
 2411: 
 2412:       // Integral of \nabla\phi_i \cdot \pmb{E}
 2413:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 2414:      
 2415:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);
 2416:       
 2417: 
 2418:       // Additional terms 
 2419:       double vnorm = 0.0;
 2420:       if (imm == 2)  { // Pre-compute vnorm on the element
 2421:          Vector3 ubed;
 2422:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 2423: 
 2424:          Vector3 gradP(0.0, 0.0, 1.0);
 2425:          for (int m=0; m < elem->i34; m++) {
 2426:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 2427:            gradP += toVector3(gradP_2D, 0.0);
 2428:          }   
 2429:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 2430:       } // imm==2
 2431: 
 2432:       if (elem->isTri()) {
 2433:          for (int l=0; l<3; l++) {
 2434:            double fac;
 2435: 
 2436:            Node *node = elem->nodes[l];
 2437: 
 2438:            (node == node1)? fac=2.0 : fac=1.0;
 2439: 
 2440:            if (imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 2441:            else        node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 2442:            
 2443:          }
 2444: 
 2445:          if (!elem->isDry) {
 2446:            const Vector2 gradEta = elem->nodes[0]->eta2*elem->gradPhi[0] +
 2447:                                    elem->nodes[1]->eta2*elem->gradPhi[1] +
 2448:                                    elem->nodes[2]->eta2*elem->gradPhi[2];
 2449: 
 2450:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 2451:          }
 2452: 
 2453:       } // isTri
 2454:       else { // isQuad
 2455:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2456:          // for (int l=0; l<4; l++) {
 2457:          //   const Node *node = elem->nodes[l];
 2458: 
 2459:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 2460:          //   else        tmp2 = node->bdef2 - node->bdef1;
 2461: 
 2462:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 2463:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 2464:          // }
 2465: 
 2466:       } // isQuad
 2467: 
 2468: 
 2469: 
 2470:       node1->qel += (dt/elem->i34)*elem->vsource;
 2471: 
 2472:    } // for all elements connected to the node
 2473:    
 2474: 
 2475: 
 2476:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 2477:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 2478:    NodeBoundary *nodeBnd = node1->nodeBnd;
 2479:    if (nodeBnd != nullptr)  { 
 2480:       // If it is an open boundary node...
 2481: 
 2482:       // At least one open bnd side, maybe two
 2483:       for (int l=0; l<2; l++) { 
 2484: 
 2485:          // Gets each of the sides sharing the node. 
 2486:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 2487: 
 2488:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 2489: 
 2490:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 2491: 
 2492: 
 2493:          if (sideBnd != nullptr) {
 2494:             // If the side is on a boundary...
 2495: 
 2496:             // Get the boundary segment
 2497:             const BoundarySegment *sideSegment = sideBnd->segment;
 2498:             const Side *side = sideBnd->side;
 2499: 
 2500:             // Integral I_3
 2501:             if (sideSegment->ifltype != 0) {
 2502:             // Natural or Flather b.c.
 2503: 
 2504:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 2505:                // especially for Flather b.c.
 2506:                double ri3 = 0.0;
 2507:                if (!side->isDry) {
 2508:                   // If the side is not dry
 2509:                   
 2510:                   // Computes the side flux of (uth, vth)
 2511:                   double Vn = 0.0;
 2512:                   for (int k = side->kb; k<nvrt-1; k++) {
 2513:                      // uth, vth in lat/lon frame if ics=2
 2514:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 2515:                      const double vn1 = dot(side->uth[k  ], side->n); // outer normal
 2516:                      const double vn2 = dot(side->uth[k+1], side->n);
 2517: 
 2518:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 2519:                   }
 2520: 
 2521:                   ri3 = 0.5*side->length*Vn;
 2522:                }
 2523: 
 2524:                if (sideSegment->ifltype == -1) { // Flather 1
 2525: 
 2526:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 2527:                   assert(side->depth > 0.0 && "Negative depth at Flather boundary");
 2528: 
 2529:                   const double con0 = (1.0/6.0)*side->length*sqrt(grav*side->depth); // For coefficient matrix
 2530:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 2531:                   
 2532:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 2533:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 2534: 
 2535:                } 
 2536:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 2537:                   // Reset ri3
 2538:                   ri3 = 0.0;
 2539: 
 2540:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 2541: 
 2542:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 2543: 
 2544:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 2545:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 2546: 
 2547:                   const double con0 = (1.0/6.0)*side->length*tmp*thetai*dt;
 2548:                   node1->addToSparseMatrix(node1, con0*2.0);
 2549:                   node1->addToSparseMatrix(node2, con0);
 2550: 
 2551:                } // if Flather or Discharge
 2552: 
 2553:                node1->qel -= thetai*dt*ri3;
 2554: 
 2555:             } // I_3
 2556:           
 2557: 
 2558:             // Integral I_5
 2559:             if(!side->isDry) {
 2560: 
 2561:                const double Unbar = dot(side->U, side->n);
 2562: 
 2563:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->length*Unbar;
 2564:                
 2565:             } // I_5
 2566: 
 2567:          } // if is boundary side
 2568: 
 2569:       } // for l
 2570: 
 2571:    } // if isbnd
 2572: 
 2573: }
 2574: 
 2575: 
 2576: extern "C" {
 2577:    __global__ void backtrackAllNodes(void) {
 2578: 
 2579:       // max/min # of sub-divisions
 2580:       const int ndelt_max = max(1.0, dt/dtb_min);
 2581:       const int ndelt_min = max(1.0, dt/dtb_max); 
 2582: 
 2583:       // Removed all references to swild98 XXX
 2584:       // swild98=0.d0 !init
 2585: 
 2586:       SIDE(side);
 2587: 
 2588:       printf("backtrackAllNodes: side = %p idx = %d isDry = %d center = (%f,%f)\n", side, side->idx, side->isDry, side->center.x, side->center.y);
 2589: 
 2590:       const int kb = side->kb;
 2591: 
 2592:       // Initialize btrack velocities to the actual velocities at the side 
 2593:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 2594: 
 2595:       if (side->isDry) return;
 2596: 
 2597:       // Checks that at least one element is not dry
 2598:       const Element *elem1 = side->elems[0];
 2599:       const Element *elem2 = side->elems[1];
 2600: 
 2601:       // printf("backtrackAllNodes: side->isDry = %d, idx = %d, elem1 = %p, elem2 = %p\n", side->isDry, side->idx, elem1, elem2);
 2602:       // printf("elem1->isDry = %d, elem2->isDry = %d\n", elem1!=nullptr?elem1->isDry:-10, elem2!=nullptr?elem2->isDry:-10);
 2603:       // if (elem1!=nullptr && (elem1->isDry<0 || elem1->isDry>1)) printf("XXXX elem1 = %p idx = %d isDry = %d\n", elem1, elem1->idx, elem1->isDry);
 2604:       // if (elem2!=nullptr && (elem2->isDry<0 || elem2->isDry>1)) printf("XXXX elem2 = %p idx = %d isDry = %d\n", elem2, elem2->idx, elem2->isDry);
 2605:       // if (elem1!=nullptr && (elem1->isDry==0 || elem1->isDry==1)) printf("elem1 = %p idx = %d isDry = %d\n", elem1, elem1->idx, elem1->isDry);
 2606:       // if (elem2!=nullptr && (elem2->isDry==0 || elem2->isDry==1)) printf("elem2 = %p idx = %d isDry = %d\n", elem2, elem2->idx, elem2->isDry);
 2607:       if (elem1!=nullptr) printf("elem1 = %p idx = %d i34 = %d (x,y,z) = (%f,%f,%f)\n", elem1, elem1->idx, elem1->i34, elem1->center.x, elem1->center.y, elem1->center.z);
 2608:       if (elem2!=nullptr) printf("elem2 = %p idx = %d i34 = %d (x,y,z) = (%f,%f,%f)\n", elem2, elem2->idx, elem2->i34, elem2->center.x, elem2->center.y, elem2->center.z);
 2609: 
 2610:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 2611: 
 2612:       // XXXXXX
 2613:       // !swild_tmp to store global coord. of the starting side
 2614:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 2615:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 2616:       // !Use sframe2 
 2617:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 2618: 
 2619: 
 2620:       for (int k = kb; k < nvrt; k++) {
 2621:       //  Initialize (xt,yt,zt), nnel and vel.
 2622:       //  For ics=2, the coordinates are in local frames
 2623:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 2624: 
 2625: 
 2626:          const int iadvf = side->iadv();  // Advection flag
 2627: 
 2628:          Point3 xt;
 2629:          if constexpr(ics==1) {
 2630:             xt = side->center3D(k); 
 2631:          }
 2632:          else // lat/lon; in side lat/lon frame
 2633:          {
 2634:          // XXX IMPLEMENT THIS
 2635:       //          xt=0.d0
 2636:       //          yt=0.d0
 2637:       //          !centroid coord. for nudging
 2638:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 2639:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 2640:          }  // ics
 2641: 
 2642: 
 2643:          // Velocity at the side (in ll frame for ics, same vertical direction)
 2644:          // XXX IS THIS NECESSARY?
 2645:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 2646: 
 2647:          // If on land or open boundary...
 2648:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 2649:          
 2650:          const double vmag = length(toVector2(u_int));
 2651: 
 2652:          if (vmag <= velmin_btrack) {
 2653:             // No activity 
 2654: 
 2655:             side->btu[k] = side->u2[k];
 2656: 
 2657: 
 2658:          } else {  // do btrack
 2659: 
 2660:             // Compute number of sub-divisions based on local gradients 
 2661:             // XXX IS THIS NECESSARY?
 2662:             double suma = 0.0;
 2663:             int icount = 0;
 2664:             for (int ii=0; ii<2; ii++) {
 2665: 
 2666:                const Element *elem = side->elems[ii];
 2667:                  
 2668:                if (elem == nullptr) continue;
 2669: 
 2670:                icount++;
 2671: 
 2672:                // Not strictly along z; in ll frame for ics=2
 2673: 
 2674:                double utmp[4];
 2675:                double vtmp[4];
 2676:                for (int jj = 0; jj < elem->i34; jj++) {
 2677: 
 2678:                   const Node *node = elem->nodes[jj];
 2679: 
 2680:                   if constexpr(ics==1) {
 2681:                      utmp[jj] = node->u2[k].x;
 2682:                      vtmp[jj] = node->u2[k].y;  
 2683:                   } else {
 2684:                      // XXX IMPLEMENT THIS
 2685:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 2686:                   }
 2687:                } // for jj
 2688: 
 2689:                const Vector2 grad_u = elem->grad(utmp); 
 2690:                const Vector2 grad_v = elem->grad(vtmp);
 2691: 
 2692:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 2693:             } // for ii
 2694: 
 2695:             assert(icount > 0 && "Impossible 77");
 2696: 
 2697:             // '4' is somewhat arbitrary
 2698:             const int ndelt = max(ndelt_min, min(ndelt_max, int(suma/icount)*4)); // >=1
 2699:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 2700: 
 2701: 
 2702:             // Perturb starting pt to avoid underflow 
 2703:             // XXX I don't think this is needed with the current implementation
 2704:             // eps=btrack_nudge
 2705:             // if constexpr(ics==1) {
 2706:             //    xt=(1.d0-eps)*xt+eps*xctr(nnel)
 2707:             //    yt=(1.d0-eps)*yt+eps*yctr(nnel)
 2708:             // } else { //lat/lon
 2709:             //    xt=(1.d0-eps)*xt+eps*xctr2
 2710:             //    yt=(1.d0-eps)*yt+eps*yctr2
 2711:             // } // ics
 2712: 
 2713:          
 2714:             // call btrack(l,ipsgb,ifl_bnd,j,iadvf,swild_tmp,swild10_tmp, dtbk,time_rm,time_rm2,uuint,vvint,wwint,nnel,jlev,xt,yt,zt,swild3,ltmp)
 2715: 
 2716:                
 2717:          } // if vmag (do backtrack)
 2718: 
 2719:       } // for j=jmin,nvrt-1
 2720: 
 2721:    }
 2722: } // extern "C"
