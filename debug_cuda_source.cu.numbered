 3349:    __global__ void computeElevationBoundaryConditions(double time) {
 3350:       // Compute elevation essential boundary conditions 
 3351: 
 3352:       NODE_BND(nodeBnd); // Each boundary node.
 3353: 
 3354:       const Node *node = nodeBnd->node;
 3355:       const int iettype = nodeBnd->iettype;
 3356: 
 3357:       double eic = 0.0;
 3358:       if (nramp_elev==1) eic = nodeBnd->etaic;
 3359:       else               eic = 0.0;
 3360: 
 3361:       const double r_eic = (1.0 - ramp)*eic; 
 3362:       const double r_eth = ramp*nodeBnd->eth;
 3363:       double eta1_bar = r_eic;
 3364: 
 3365:       // Compute tide elevation
 3366:       if (iettype == 3 || iettype == 5) {
 3367:         
 3368:          // XXX IMPLEMENT TIDE THINGS
 3369:          assert(false && "Tide elevation not implemented");
 3370:          // for (int jfr=0; jfr<nbfr; jfr++) { // For all tide frequencies
 3371:          //    const int ncyc = int(amig[jfr]*time/(2.0*pi));
 3372:          //    const double arg = amig[jfr]*time - 2.0*pi*ncyc + face[jfr] - efa[i,j,jfr];
 3373:          //    eta1_bar += ramp*ff[jfr]*emo[i,j,jfr]*cos(arg);
 3374:          // } // for jfr
 3375:       } // if iettype
 3376: 
 3377:       switch (iettype) {
 3378:          case 1:
 3379:          case 2:
 3380:             nodeBnd->elbc = r_eth + r_eic;
 3381:             break;
 3382:          case 3:
 3383:             nodeBnd->elbc = eta1_bar + r_eic;
 3384:             break;
 3385:          case 4:
 3386:             nodeBnd->elbc = r_eth + r_eic;
 3387:             break;
 3388:          case 5:
 3389:             nodeBnd->elbc = r_eth + eta1_bar + r_eic;
 3390:             break;
 3391:       } // switch
 3392: 
 3393: 
 3394:       //Add inverse barometric effects
 3395:       if (iettype != 0 && inv_atm_bnd == 1) {
 3396:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 3397:       }
 3398: 
 3399:    }
 3400: 
 3401:    __global__ void computeVerticallyIntegratedVelocity(void) {
 3402: 
 3403:       SIDE(side);
 3404: 
 3405: 
 3406:       side->U = {0.0, 0.0}; 
 3407:          
 3408:       if(side->isDry) return;
 3409: 
 3410:       const Node *node1 = side->n1;
 3411:       const Node *node2 = side->n2;
 3412: 
 3413:       // Vertically integrated velocity U (in ll if ics=2)
 3414:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 3415:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 3416:       }
 3417: 
 3418:    }
 3419: 
 3420:    __global__ void computeBottomDragVegetation(void) {
 3421:       // UNFINISHED. CHECK THIS:
 3422:       // How many kernels are needed? Why so many for loops?
 3423:       // Is the loop on sides needed?
 3424: 
 3425:       NODE(node);
 3426: 
 3427:       const int    kb      = node->kb;
 3428:       const double htot    = node->htot();
 3429:       const double rough   = node->rough;
 3430: 
 3431: 
 3432:       if (node->isDry) {
 3433:          // Default values for dry nodes
 3434:          node->veg_alpha_vert_mean = node->veg_alpha0;
 3435:          /// XXX CHECK INDICES
 3436:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 3437:       }
 3438: 
 3439:       // Compute bottom drag Cd
 3440:       //--------------------------------
 3441: 
 3442:       // nchi = {-1, 0, 1} is the type of bottom drag.
 3443:       if (nchi==1) {
 3444: 
 3445:          bool ltmp = false; // for WBL iteration
 3446: 
 3447:          // Cdmax=-1 !max. Cd at node for this process (info only)
 3448:          // Drag at nodes
 3449:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 3450:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 3451:         
 3452:          const double rough = node->rough;
 3453:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3454:          if (node->rough == 0.0) {
 3455:             node->Cd = 0.0;
 3456: 
 3457:          } else { //roughness >0 
 3458:             
 3459:             const double bthick_ori = node->znl[kb + 1] - node->znl[kb];  // thickness of bottom bnd layer
 3460:             const double bthick = max(dzb_min, bthick_ori);
 3461: 
 3462:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 3463: 
 3464:             double tmp = 1.0/(2.5*log(bthick/rough));
 3465:             node->Cd = tmp*tmp;
 3466: 
 3467:          } // if rough
 3468: 
 3469: 
 3470:          // RECOVER THIS: XXX
 3471:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 3472:          // Output warning for WBL if iteration didn't converge
 3473: 
 3474: 
 3475:       } // nchi==1
 3476: 
 3477:       //   Bottom stress in m^2/s^2
 3478:       if (node->rho[kb + 1] >= -98.0)
 3479:       {
 3480:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 3481:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 3482:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 3483:          // !sediment erosion: this part needs more documentation
 3484:       }
 3485: 
 3486:     
 3487:       // Compute vegetation parameters
 3488:       //--------------------------------
 3489: 
 3490:       // SAV constants
 3491:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 3492:       constexpr double veg_cfpsi = 0.16;
 3493: 
 3494:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 3495:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 3496: 
 3497:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 3498:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 3499:          int kbin = 0; // bin index
 3500:          for (int k = kb; k < nvrt; k++) {
 3501:             // Computes node height above the bottom level
 3502:             const double tmp_h = node->znl[k] - node->znl[kb]; // >=0
 3503:             assert(false && "Vertical variation of vegetation not implemented");
 3504: 
 3505:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 3506:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 3507:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 3508:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 3509:             // } else {
 3510:             //    // Find the bin at which the current vertical level is
 3511:             //    while (kbin<nbins_veg_vert) {
 3512:             //       const double zn = node->znl[kbin];
 3513:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 3514:             //          break;
 3515:             //       } // if
 3516:             //       kbin++;
 3517:             //    } // while
 3518:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 3519: 
 3520:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 3521:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 3522:                
 3523:             //    // Linear interpolation of the vegetation parameters
 3524:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 3525:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 3526:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 3527:             // } // if rl10
 3528: 
 3529:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 3530: 
 3531:          } // for k
 3532: 
 3533: 
 3534:       } else { // Ganthy (iveg=2)
 3535:       //  Modify canopy height, diameter, and density
 3536: 
 3537:          // Make sure there is vegetation on this node
 3538:          if (node->veg_h_unbent > 0.0) {
 3539:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 3540: 
 3541:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 3542:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 3543:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 3544: 
 3545:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 3546:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 3547:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 3548:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 3549:          } // if veg_h_unbent
 3550: 
 3551:          for (int k = 0; k < nvrt; k++) {
 3552:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 3553:          } // for k
 3554:       
 3555: 
 3556:       } // if iveg
 3557:      
 3558:          
 3559: 
 3560:       // Compute vertical mean of veg_alpha3D
 3561:       if (iveg != 0) {
 3562:          const double ztop = node->zTopCanopy(); // Top of the canopy
 3563:          double sum1=0.0;
 3564:          double sum2=0.0;
 3565:          // Integrate over each level under the canopy...
 3566:          for (int k=kb; k<nvrt-1 && node->znl[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 3567:             const double Dz = node->Dz(k);
 3568: 
 3569:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 3570:             sum2 += Dz;
 3571: 
 3572:          } // for k
 3573: 
 3574:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 3575:          else             node->veg_alpha_vert_mean = sum1/sum2;
 3576: 
 3577:       } // if iveg
 3578: 
 3579:       printf("computeBottomDragVegetation: nodeIdx = %d, node->veg_alpha_vert_mean = %f\n", node->idx, node->veg_alpha_vert_mean);
 3580: 
 3581:    }
 3582: 
 3583:    __global__ void computeVegetationAndDragParameters(void) {
 3584:       // Computes the vegetation and drag model parameters:
 3585:       // chi, \tilde\chi, beta, \breve{H}
 3586:       
 3587:       SIDE(side);
 3588: 
 3589:       const double htot = side->htot();
 3590:       const int    kb   = side->kb;
 3591: 
 3592:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 3593: 
 3594:       const double veg_h     = side->veg_h();
 3595:       const double veg_nv    = side->veg_nv();
 3596:       const double veg_c     = side->veg_c();
 3597:       const double veg_beta  = side->veg_beta;
 3598:       const double veg_alpha = side->veg_alpha_vert_mean();
 3599: 
 3600:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 3601:       // Velocity magnitude at the bottom level
 3602:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 3603:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 3604:       side->chi2 = side->Cd()*vmag1;
 3605:       side->chi  = side->chi2;
 3606:       if constexpr(iveg != 0) {
 3607:          const Node *n1 = side->n1;
 3608:          const Node *n2 = side->n2;
 3609:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 3610:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 3611:       }
 3612: 
 3613:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 3614: 
 3615:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 3616:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 3617:       double magUa = 0.0;
 3618:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 3619:          // 3D wet side with veg...
 3620: 
 3621:          double magUa = 0.0;
 3622:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 3623:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 3624: 
 3625:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 3626:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 3627:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 3628: 
 3629:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 3630:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 3631: 
 3632:                // Velocity magnitude at the bottom (l) of the level
 3633:                const double ul = length(side->u2[k]);
 3634: 
 3635:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 3636:                magUa += Dz*0.5*(uh + ul);
 3637: 
 3638:             } // if HasVegetation
 3639:          } // for k
 3640:          const double ua = magUa/min(htot, veg_h); // Vertical average
 3641: 
 3642:          // Computes beta, used for computing the stress term at the top of the canopy.      
 3643:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 3644:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 3645:             const double zCpy = side->zTopCanopy();
 3646:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 3647:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 3648:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 3649:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 3650:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 3651:          } // if isSubmerged
 3652:       } // if iveg   
 3653: 
 3654:       // Computes the friction modified depth, \breve{H} in notes
 3655:       if (side->is2D()) { // 2D
 3656: 
 3657:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 3658:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 3659: 
 3660:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 3661: 
 3662:          side->hhat = htot*htot/fricH; 
 3663: 
 3664:       } else { // 3D
 3665:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 3666: 
 3667:          if constexpr(iveg != 0) {
 3668:             
 3669:             if (side->isSubmerged()) { 
 3670:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 3671:                side->hhat -= veg_c*Hhat_alpha;
 3672: 
 3673:             } else { // Emergent
 3674:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 3675:             }
 3676:          } // if iveg
 3677: 
 3678:          // Enforce positivity for 3D model
 3679:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 3680:       } // if 3D
 3681: 
 3682:       printf("computeVegetationAndDragParameters: sideIdx = %d, side->htot = %f, side->hhat = %f\n", side->idx, side->htot(), side->hhat);
 3683: 
 3684:         
 3685:    }
 3686: 
 3687: 
 3688: 
 3689:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 3690:    // Computes the density gradient between two elements, e1 and e2.
 3691:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 3692:    // zero in the direction normal to the side. 
 3693:    // 
 3694:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 3695:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 3696:    //
 3697:    // Input:
 3698:    //    e1: Element
 3699:    //    e2: Neighbor element (or nullptr if boundary)
 3700:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 3701:    //    k: Index of the half-level at which the density is interpolated
 3702:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 3703:    // 
 3704:    // Output:
 3705:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 3706:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 3707: 
 3708:       if (e2 == nullptr || e2->isDry) {
 3709:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 3710: 
 3711:          Side *side = e1->sides[j];
 3712:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 3713:                  
 3714:          if constexpr(ics == 1) {
 3715:             vec = side->n; // Normal vector to the side
 3716:          } else {
 3717:             // IMPLEMENT THIS XXXXXX
 3718:             // !replace with xel, yel?
 3719:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 3720:             //      &eframe(:,:,i),xn1,yn1,tmp)
 3721:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 3722:             //      &eframe(:,:,i),xn2,yn2,tmp)
 3723:          } //ics
 3724:                    
 3725:          diffRho = 0.0;
 3726: 
 3727:       } else { //internal and wet
 3728:          if constexpr(ics==1) {
 3729:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 3730: 
 3731:             // Vector from e1 to e2
 3732:             vec = toVector2(e2->center - e1->center);
 3733: 
 3734:          } else { 
 3735:             // IMPLEMENT THIS XXXXXX
 3736:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 3737:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 3738:             //                   alow(j)=xctr2
 3739:             //                   bdia(j)=yctr2
 3740:          } // ics
 3741: 
 3742:          diffRho = rho2 - e1->demeanedDensity(k);
 3743:       }
 3744: 
 3745:    }
 3746: 
 3747:    __global__ void computeDensityCubicSplines(void) {
 3748:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 3749: 
 3750:       ELEM(elem);
 3751: 
 3752:       if (elem->isDry) return;
 3753: 
 3754:       const int kb = elem->kb;
 3755: 
 3756:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 3757:       if (elem->is2D()) {
 3758:          // In the 2D case, the density is constant at the prism level. 
 3759:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 3760:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 3761:       } else { //3D
 3762: 
 3763:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 3764:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 3765:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 3766:          ///// XXXX CHECK INDICES!!!!!
 3767:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 3768:       } // 2D/3D
 3769: 
 3770:    }
 3771: } // extern "C"
 3772: 
 3773: 
 3774: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 3775: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 3776: 
 3777:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 3778: 
 3779:    const int kb  = elem->kb;
 3780:    const int kb2 = elem2->kb;
 3781: 
 3782:    // z-coordinate of prism of elem
 3783:    const double zp = elem->z_prism(k);
 3784: 
 3785:    double rho = 0.0;
 3786: 
 3787:    if (elem2->is2D()) {
 3788:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 3789: 
 3790:    } else {  // 3D
 3791: 
 3792:       // eta_min may be < zmax
 3793:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 3794:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 3795: 
 3796:       // (Extrapolate density below bottom, we will fix it later)
 3797:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 3798:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 3799:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 3800:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 3801:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 3802:    } // 2D/3D
 3803:      
 3804: 
 3805:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 3806:    // Now we need to fix it.
 3807:    if (elem->z[k] < elem2->z[kb2]) {
 3808:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 3809: 
 3810:       // There are two methods to adjust the density at the bottom of the element.
 3811:       // iunder_deep=0: 
 3812:       const double depth1 = abs(elem->z[kb]); // larger depth
 3813: 
 3814:       if (iunder_deep==0) {
 3815: 
 3816:          const double weight = max(0.0, min(1.0, (depth1 - h1_bcc)/(h2_bcc - h1_bcc))); // weight
 3817: 
 3818:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 3819: 
 3820:       } else { // iunder_deep != 0
 3821: 
 3822:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 3823: 
 3824:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 3825: 
 3826:          //   Demeaned density at the same z coordinate as
 3827:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 3828:          }
 3829: 
 3830:       } // if iunder_deep
 3831:    } // if elem->z[kb] < elem2->z[kb]
 3832: 
 3833:    return rho;
 3834: }
 3835: 
 3836: 
 3837: extern "C" {
 3838:    __global__ void computeDensityGradient(void) {
 3839: 
 3840:          // Compute the horizontal density gradient at each element.
 3841:       // It works in two steps:
 3842:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 3843:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 3844:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 3845:       //             gradRho.r1 = rho1 - rho0
 3846:       //             gradRho.r2 = rho2 - rho0
 3847:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 3848:       // 
 3849:       //  NOTE: We use de-meaned densities.
 3850: 
 3851:       ELEM(elem);
 3852: 
 3853:       if (elem->isDry) return;
 3854: 
 3855:       const int kb  = elem->kb;
 3856:       const int i34 = elem->i34;
 3857: 
 3858:       for (int k = kb + 1; k < nvrt; k++) {
 3859:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 3860:          //             gradRho.r1 = rho1 - rho0
 3861:          //             gradRho.r2 = rho2 - rho0
 3862:          int icount = 0;
 3863:          double sumRx = 0.0;
 3864:          double sumRy = 0.0;
 3865:          for (int j1=0; j1<i34; j1++) { 
 3866: 
 3867:             const int j2 = elem->nxq(j1 + 1);
 3868: 
 3869:             // Pairs of consecutive neighbor elements of elem
 3870:             const Element *e1 = elem->nghbElems[j1];
 3871:             const Element *e2 = elem->nghbElems[j2];
 3872: 
 3873:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 3874:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 3875:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 3876: 
 3877:             // Compute the density difference and the vector from elem to e1 and e2
 3878:             // getRhoDiffAndVec takes into account boundaries/dry elements
 3879:             double diffRho1, diffRho2;
 3880:             Vector2 vec1, vec2;
 3881:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 3882:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 3883: 
 3884:             const double rl1 = length(vec1);
 3885:             const double rl2 = length(vec2);
 3886:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 3887: 
 3888:             const double delta = cross(vec1, vec2);
 3889:             const double sintheta = abs(delta)/(rl1*rl2);
 3890: 
 3891:             // To avoid problems, avoid elements with small angle between vectors
 3892:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 3893:             const bool validEq = (sintheta > sin_one_deg);
 3894: 
 3895:             if (validEq) {
 3896:                // Solve the system of equations to get the density gradient at elem
 3897:                icount++;
 3898:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 3899:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 3900:                sumRx += Rx;
 3901:                sumRy += Ry;
 3902:             }
 3903:          } // for j1
 3904: 
 3905:          // Compute the average density gradient at elem
 3906:          if (icount==0) {
 3907:            // Bad mesh quality; bail out with 0 b-cc
 3908:            elem->gradRho[k] = {0.0, 0.0};
 3909:          } else {
 3910:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 3911:          }
 3912: 
 3913:       } // for k
 3914: 
 3915:    }
 3916: 
 3917:    __global__ void computeBaroclinicTerm(void) {
 3918:    // Computes the baroclinic term at sides (at half levels).
 3919:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 3920:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 3921: 
 3922:       SIDE(side);
 3923: 
 3924:       if (side->isDry) return;
 3925: 
 3926:       const Element *e1 = side->elems[0];
 3927:       const Element *e2 = side->elems[1];      
 3928:       const int kb = side->kb;
 3929:       
 3930:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 3931: 
 3932:       // interpolates vertically the density gradient of the two elements at the half level/
 3933: 
 3934:       // Starts the integration at the surface and goes down to the bottom
 3935:       int k1 = nvrt - 1;
 3936:       int k2 = nvrt - 1;
 3937: 
 3938:       side->bcc[nvrt-1] = {0.0, 0.0};
 3939:       for (int k = nvrt-1; k >= kb; k--) {
 3940:       // For each prism level (from surface to bottom)...
 3941: 
 3942:          // For both elements, interpolate density gradient at the side's half level.
 3943:          // The gradient at the side is the average of the gradients at the elements.
 3944:          // w1, w2 are used to take into account boundary sides, with just one element.
 3945:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 3946:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 3947:          const double wsum = w1 + w2;
 3948:          w1 = w1/wsum;
 3949:          w2 = w2/wsum;
 3950:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 3951: 
 3952:          // Linear interpolation of both elements' density gradient at the shared side's level.
 3953:          Vector2 gradRho = {0.0, 0.0};
 3954:          if (e1 != nullptr && k > kb) {
 3955:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 3956:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 3957:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 3958:             
 3959:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 3960:          }      
 3961:          if (e2 != nullptr && k > kb) {
 3962:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 3963:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 3964:             
 3965:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 3966:          }
 3967: 
 3968:          if constexpr(ics==2) {
 3969:             // IMPLEMENT THIS XXXXXX
 3970:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 3971:             // swild(1)=tmp1
 3972:             // swild(2)=tmp2
 3973:          }
 3974:          
 3975:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 3976:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 3977:          // CHECK INDICES!!! XXX
 3978:          const double grav3 = 0.5*(side->n1->grav2 + side->n2->grav2);
 3979:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 3980:       } // for
 3981: 
 3982:    }
 3983: 
 3984: } // extern "C"
 3985: 
 3986: #ifdef DONTCOMPILE
 3987: __device__ void computeVerticalAdvection(void) {
 3988:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 3989: 
 3990:    sdbt(1:2,:,:)=0.d0
 3991: 
 3992:    const Side *side = FROM kernel;
 3993: 
 3994:    if(side->isDry) return;
 3995: 
 3996:    // If side is wet...
 3997: 
 3998: 
 3999:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 4000:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 4001:    double ws[nvrt] = {} // w @ side
 4002:    int icount = 0;
 4003:    for (int j=0; j<2; j++) {
 4004:       const Element *elem = side->elements[j];
 4005:        
 4006:       if(elem != nullptr) {
 4007:          icount++;
 4008:          for (int k=0; k<nvrt; k++) {
 4009:             ws[k] = ws[k] + elem->w[k];
 4010:          }
 4011:       }
 4012:    }  // for j
 4013: 
 4014:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 4015:    ws = ws/icount;
 4016: 
 4017:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 4018:    // Splines allow for a smooth transition between vertical levels.
 4019:    // Splines have continuity restrictions at the internal knots, but
 4020:    // we have to provide the 1st derivatives at the endpoints.
 4021:    const int kbs = side->kbs; 
 4022:    
 4023:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 4024:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 4025:    initCubicSpline(kbs, nvrt, side, ws, up)
 4026: 
 4027:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 4028:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 4029:    initCubicSpline(kbs, nvrt, side, ws, vp)
 4030: 
 4031:    // Total advection (average onto side)
 4032:    const Node *node1 = side->nodes[0];
 4033:    const Node *node2 = side->nodes[1];
 4034:    for (int k=kbs(i); k<nvrt; k++) {
 4035: 
 4036:       if constexpr(ics==1) {
 4037:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 4038:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 4039:       } else {
 4040:          // XXX IMPLEMENT THIS
 4041:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 4042:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 4043:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 4044:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 4045:       }  // if ics
 4046: 
 4047: 
 4048:    }
 4049: }
 4050: #endif
 4051: 
 4052: 
 4053: extern "C" {
 4054:    __global__ void computeElemAverageGhat(void) {
 4055:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 4056: 
 4057:       ELEM(elem);
 4058:       
 4059:       elem->ghat1= {0.0, 0.0};  
 4060: 
 4061:       if constexpr(ihydraulics != 0) {
 4062:          if (nhtblocks > 0 && elem->isblock) return;
 4063:       }
 4064: 
 4065:       if (elem->isDry) return;
 4066: 
 4067:       // Wet elements.
 4068:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 4069:       // tidal potential, horizontal diffusion, and baroclinic etc
 4070:       // Remember to update both fb and F 
 4071:       // If ics=2, ghat1 are in eframe (ll)
 4072:       // cff1-3: coefficients for 2D/3D
 4073:       Vector2 gradEta = {0.0, 0.0};  // \nabla \eta
 4074:       Vector2 gradPr  = {0.0, 0.0};  // \nabla pressure
 4075:       Vector2 gradETP = {0.0, 0.0};  // \nabla etp
 4076: 
 4077:       double av_cff1 = 0.0;  // av. for cff1
 4078:       double av_cff2 = 0.0;  // av. for cff2
 4079:       double av_cff3 = 0.0;  // av. for cff3
 4080:       double av_df = 0.0;  // av. for H^\alpha / H
 4081:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 4082:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 4083: 
 4084:       const int i34 = elem->i34;
 4085:       const int kb = elem->kb;
 4086: 
 4087:       for (int j=1; j<i34; j++) {
 4088:          // For each node and side in the element...
 4089: 
 4090:          const Node *node = elem->nodes[j];
 4091:          const Side *side = elem->sides[j];
 4092: 
 4093:          const double chi      = side->chi;
 4094:          const double veg_c2   = side->veg_c2;
 4095:          const double veg_beta = side->veg_beta;
 4096:          const double veg_h    = side->veg_h();
 4097:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 4098: 
 4099:          // Node - const in elem
 4100:          gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 4101:          gradPr  += node->pr  *elem->gradPhi[j];
 4102: 
 4103:          if (elem->depth >= tip_dp) {
 4104:            gradETP += node->ETP*elem->gradPhi[j];
 4105:          }
 4106: 
 4107:          
 4108:          const double htot  = side->htot();        // Total depth at the side
 4109:          const double zctr2 = side->zTopCanopy();  
 4110: 
 4111:          double cff1; 
 4112:          double cff2; 
 4113:          double cff3;   
 4114:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 4115:          // coefficients applied to 2D/3D case 
 4116:             cff1 = side->hhat/htot;
 4117:             cff2 = 0.0;
 4118:             cff3 = 0.0;
 4119:          } else { //3D
 4120:             //Init for no-veg case
 4121:             cff1 = 1.0;
 4122:             cff2 = 1.0;
 4123:             cff3 = 0.0;
 4124: 
 4125:             if constexpr(iveg != 0) {
 4126:                // Computes coefficients used with vegetation terms G1, G2
 4127:                // cff1, cff3 are used for the first two terms in G1, G2:
 4128:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 4129:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 4130:                // In general, cff1*Ustar - cff3*Ustar_alpha
 4131:                if(veg_h < 0.99*htot) { // submergent vegetation
 4132:                   cff1=1;
 4133:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 4134:                   cff3 = veg_c;
 4135: 
 4136:                } else { // emergent vegetation
 4137:                   cff1 = 1.0/(1.0 + veg_c2);
 4138:                   cff2 = cff1;
 4139:                   cff3 = 0.0;
 4140: 
 4141:                }
 4142:             } // if iveg
 4143:          } //  2D/3D
 4144: 
 4145:          av_cff1 += cff1/i34;
 4146:          av_cff2 += cff2/i34;
 4147:          av_cff3 += cff3/i34;
 4148:          av_cff2_chi += cff2*chi/i34;
 4149:          av_cff3_chi += cff3*chi/i34;
 4150:          av_df += min(htot, veg_h)/(htot*i34);
 4151: 
 4152: 
 4153:          // btrack values: U^\star, U^{\star\alpha}
 4154:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 4155:          Vector2 Ustar       = {0.0, 0.0}; 
 4156:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 4157:          for (int k = side->kb; k < nvrt; k++) {
 4158:             if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 4159:                Ustar += side->btu[nvrt]*side->Dz(k);
 4160: 
 4161:             } else { //3D
 4162:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 4163:                Ustar += w2;
 4164: 
 4165:                if constexpr(iveg != 0) {
 4166:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 4167:                        const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k)); // For the top of the canopy, ratio of the level that is below the canopy
 4168:                        Ustar_alpha += zrat*w2; // XXXX
 4169:                    }
 4170:                }  // if iveg
 4171:             }  //2/3D
 4172:          }  //k
 4173:          
 4174: 
 4175:          // Add btrack & surface stress terms to \breve{G} first
 4176:          if constexpr(ics==1) {
 4177:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 4178:          } else {
 4179:             // XXX IMPLEMENT THIS
 4180:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 4181:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 4182:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 4183:          }  // if ics
 4184: 
 4185:          // Surface and bottom stress terms
 4186:          if constexpr(ics==1) {
 4187:             const Vector2 tau    = side->tau();
 4188:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 4189: 
 4190:             // Term for surface and bottom stress
 4191:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 4192:          } else {
 4193:             // XXX IMPLEMENT THIS
 4194:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 4195:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 4196:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 4197:             // tau_x=(vn1+tt1)/2.d0
 4198:             // tau_y=(vn2+ss1)/2.d0
 4199:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 4200:          }  // if ics
 4201: 
 4202:          
 4203: 
 4204:          // All terms in F,F^\alpha,f_b except baroclinic
 4205:          // F, f_b: all explicit terms excluding vegetation 
 4206:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 4207:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 4208:          const double coriolis = side->coriolis;
 4209:          Vector2 F  =  coriolis*side->U;  // F_x
 4210:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 4211:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 4212: 
 4213:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 4214:             
 4215:             for (int k = side->kb; k < nvrt; k++) {
 4216:                if (zctr2 > side->zc[k-1]) {
 4217:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 4218:                    const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 4219:                    Fa +=  coriolis*w2*zrat;
 4220:                } // if zctr2
 4221:             } // k
 4222:          } // iveg
 4223: 
 4224:          // Integrate horizontal viscosity force vertically
 4225:          for (int k=side->kb + 1; k<nvrt; k++) {
 4226:             const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.0; 
 4227: 
 4228:             F += levelHorVisc;
 4229: 
 4230:             // Vegetation term
 4231:             if constexpr(iveg!=0) {
 4232:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 4233:                   const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 4234:                   Fa += levelHorVisc*zrat;
 4235:                } 
 4236:             } // if iveg
 4237:          } // for k
 4238: 
 4239:          fb += side->d2uv[side->kb];
 4240: 
 4241: 
 4242:          // Add to ghat1
 4243:          if constexpr(ics==2) {
 4244:             // XXX IMPLEMENT THIS
 4245:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4246:             // bigf1=vn1; bigf2=vn2
 4247:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4248:             // botf1=vn1; botf2=vn2
 4249:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4250:             // bigfa1=vn1; bigfa2=vn2
 4251:          } // if ics
 4252: 
 4253:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 4254:       } // for j (nodes and sides)
 4255: 
 4256:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 4257:          
 4258:       // Finish off terms in F, F^\alpha and f_b
 4259:       const double grav3 = elem->mean(&Node::grav2);
 4260:       const Vector2 fb = grav3*gradETP - gradPr/rho0; //const in each elem
 4261: 
 4262: 
 4263:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 4264:       for (int j=1; j<i34; j++) { 
 4265:          // For each side in the element...
 4266:          const Side *side = elem->sides[j];
 4267:          const double chi = side->chi;
 4268: 
 4269:          const double htot = side->htot();
 4270:          const double veg_h = side->veg_h();
 4271:          const Vector2 F  = htot*fb;
 4272:          const Vector2 Fa = min(htot, veg_h)*fb;
 4273: 
 4274:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 4275:       } // for j
 4276: 
 4277:       //botf1 etc are already in elem frame
 4278:       elem->ghat1 += tmp/i34;
 4279: 
 4280:       // Baroclinic force
 4281:       if constexpr(ibc==0) {
 4282:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 4283: 
 4284:          Vector2 Fa = {0.0, 0.0};
 4285:          Vector2 intGradRho = {0.0, 0.0};
 4286:          
 4287:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 4288:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 4289:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 4290: 
 4291:             // \in F [m^2/s/s]
 4292:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 4293:          }
 4294: 
 4295:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 4296:          const Vector2 F = av_df*Fa; //approx
 4297:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 4298: 
 4299:       } // if ibc
 4300: 
 4301:    }
 4302: 
 4303: } // extern "C"
 4304: 
 4305: 
 4306: 
 4307: #ifdef DONTCOMPILE
 4308: __global__ void checkMassConservation(Tracers* sumtr) {
 4309: 
 4310:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 4311: 
 4312:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 4313: 
 4314:    Element *elem = &(mesh->localElemData[i]);
 4315: 
 4316:    // Skip dry elements
 4317:    if (elem->isDry) return;
 4318: 
 4319:    // Local sum array for this thread
 4320:    double localSum[N_TRACERS] = {0.0};
 4321: 
 4322:    // Sum over vertical levels for this element
 4323:    const int kbe = elem->kbe;
 4324:    const double area = elem->area;
 4325: 
 4326:    for (int k = kbe; k < nvrt; k++) {
 4327:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 4328:       
 4329:       // Accumulate tracer mass
 4330:       for (int tr = 0; tr < N_TRACERS; tr++) {
 4331:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 4332:       }
 4333:    }
 4334: 
 4335:    
 4336: 
 4337:    //  This function returns per element sums. A reduction must be done on the host side.
 4338: }
 4339: 
 4340: 
 4341: __global__ void transport(void) {
 4342: 
 4343:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 4344: 
 4345:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 4346: 
 4347:    Element *elem = &(mesh->localElemData[ie]);
 4348: 
 4349:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 4350: 
 4351:                for (int m=0; m<ntr; m++) {
 4352:                   for (int k=kbe(ie); k<nvrt; k++) {
 4353:                      // Calculate each polynomial's weight 
 4354:                      wm=0.d0; sum1=0.d0; 
 4355:                      wm1=0.d0; wm2=0.d0; 
 4356:                      for (int i=0; i<elem->nweno2; i++) {
 4357:                   
 4358:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4359:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4360:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4361:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4362:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4363:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 4364:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 4365:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 4366:                      // -----------------Hu and Shu (1999)'s method----------------
 4367:                      b4=b1+b2+b3
 4368: 
 4369: //Error: add PRODUCTION CPP
 4370: #ifdef DEBUG
 4371:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 4372:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 4373:                     call parallel_abort(errmsg)
 4374:                   }
 4375: #endif
 4376: 
 4377:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 4378:                   // !----test-------------- 
 4379:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 4380:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 4381:                   // !wm(i)=wm1(i)*wm2(i)
 4382:                   // !---------------------- 
 4383:                   sum1=sum1+wm(i)
 4384:                 } // end for i
 4385: 
 4386:                 wm=wm/sum1
 4387: 
 4388:                 for (int j=0; j<elem->i34; j++) {
 4389: 
 4390:                   const Side *side  = elem->sides[j];
 4391:                   const Node *node1 = side->n1;
 4392:                   const Node *node2 = side->n2;
 4393: 
 4394:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 4395:                      trsd=0.d0
 4396:                      for (int kk=0; kk<nquad; kk++) {
 4397:                         for (int i=0; i<elem->nweno2; i++) {
 4398:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4399:                         } // end for i   
 4400:                      } // end for kk
 4401:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 4402:                   } // outward flux
 4403:                } // end for j=1,i34(ie) ! side
 4404:             }
 4405:          }
 4406:               
 4407: 
 4408: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 4409: //             //   calculate each polynomial's weight 
 4410: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 4411: //                 wm=0.d0; sum1=0.d0
 4412: //                 do i=1,nweno1(ie) !for each polynomial
 4413: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4414: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4415: //                   b1=b1*b1+b2*b2 !smoothness indicator
 4416: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 4417: //                   wm(i)=b2
 4418: //                   sum1=sum1+b2
 4419: //                   !wm(i)=1.d0
