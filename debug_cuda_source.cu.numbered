  843:    __device__ Mesh(int partNum,
  844:                    int npgb, int negb, int nsgb, 
  845:                    int np, int ne, int ns, int nvrt, int kz,
  846:                    int max_np, int max_ne, int max_ns, int nseg,
  847:                    const Node **nodesPtr, const Element **elemsPtr, const Side **sidesPtr,
  848:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
  849:                    Node    **localNodeNeighNodesMem,
  850:                    Element **localNodeNeighElemsMem,
  851:                    NodeBoundary *localNodeBoundaryMem,
  852:                    SideBoundary *localSideBoundaryMem,
  853:                    BoundarySegment *localSegmentMem,
  854:                    double h_s, double theta_b, double theta_f, double *sigma_lcl, double *sigma, double *ztot,
  855:                    double *cs, double *dcs
  856:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
