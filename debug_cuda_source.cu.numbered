 3192: 
 3193:    __global__ void scaleGravity(double loadtide_coef) {
 3194: 
 3195: 
 3196:       NODE(node);
 3197: 
 3198:       // SAL option: scale gravity
 3199:       if constexpr(iloadtide==2) {  // simple const
 3200:          node->grav2 = grav*(1.0 - loadtide_coef);
 3201: 
 3202:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3203:         
 3204:           const double depth = max(node->depth, 0.0);
 3205:           const double tmp1 = sqrt(depth);
 3206:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3207:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3208:                              2.6969e-13*depth*depth*depth*tmp1;
 3209:           
 3210:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3211:           
 3212: 
 3213: 
 3214:           node->grav2 = grav*(1.0 - beta_bar);
 3215: 
 3216:       } else {  // iloadtide=0,1
 3217:         node->grav2=grav;
 3218: 
 3219:       }
 3220: 
 3221:       printf("scaleGravity: node(%d)->grav2 = %f\n", node->idx, node->grav2);
 3222:    }
