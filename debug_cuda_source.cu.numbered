 2321: __global__ void setupCoefficientMatrixAndRHS(double time) {
 2322: // Setup coefficient matrix, sparsem, for the shallow water wave equation
 2323: // No elevation essential b.c. are imposed yet but other b.c. is imposed
 2324: // 
 2325: // This kernel is called for all nodes.
 2326: 
 2327:    int in = 1; //XXX blockIdx.x * blockDim.x + threadIdx.x;
 2328: 
 2329:    Node *node1 = &(mesh->localNodeData[in]);
 2330: 
 2331: 
 2332:    node1->clearMatrixRow();
 2333:    node1->qel = 0.0;
 2334: 
 2335:    // THIS IS FOR STRUCTURES XXX
 2336:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 2337: 
 2338: 
 2339:    for (int j=0; j<node1->numElements; j++) {
 2340:       // For each element connected to the node...
 2341: 
 2342:       Element *elem = node1->elements[j];
 2343: 
 2344: 
 2345:       // Compute the average gravity
 2346:       const double grav3 = elem->mean(&Node::grav2);
 2347: 
 2348:       // Look at the documentation for the description of the terms in the following integrals
 2349: 
 2350:       // Integral I_1 
 2351:       // \bar{\breve{H}} 
 2352:       const double hhatb = elem->mean(&Side::hhat);        
 2353: 
 2354:       assert((hhatb >= 0.0 || ihh != 1) && "Invalid hhat");
 2355: 
 2356:       const int id1 = elem->nodeLocalIdx(node1); 
 2357:       const double area = elem->area;
 2358: 
 2359:       if (elem->isTri()) {
 2360: 
 2361:          // To clarify the notation in this section: 
 2362:          //   i standtimes for the node under consideration (node1)
 2363:          //   j (node2) and k (node3) are the other nodes of the triangle.
 2364:          const int id2 = elem->nxq(1 + id1);
 2365:          const int id3 = elem->nxq(2 + id1);
 2366:          Node *node2 = elem->nodes[id2];
 2367:          Node *node3 = elem->nodes[id3];
 2368: 
 2369:          const Point2 x1 = node1->p2();
 2370:          const Point2 x2 = node2->p2();
 2371:          const Point2 x3 = node3->p2();
 2372: 
 2373:          // integral of phi_i*phi_j
 2374:          const double ipp_ii = (1.0/6.0 )*area;
 2375:          const double ipp_ij = (1.0/12.0)*area;
 2376:          const double ipp_ik = (1.0/12.0)*area;
 2377: 
 2378:          // integral of [(grad phi_i) * (grad phi_j)]
 2379:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 2380:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 2381:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 2382: 
 2383:          // Computes the different components of integral I_1 of each node with respect to node i.
 2384:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 2385:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 2386:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 2387: 
 2388:          node1->addToSparseMatrix(node1, I1_ii);
 2389:          node1->addToSparseMatrix(node2, I1_ij); 
 2390:          node1->addToSparseMatrix(node3, I1_ik);
 2391:      
 2392:       }
 2393:       else { // Quad
 2394:          // XXX IMPLEMENT THIS
 2395:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2396:       } 
 2397: 
 2398:  
 2399:       // Integral I_4
 2400:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 2401:       // Where
 2402:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 2403: 
 2404:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 2405:       // of U over the element.
 2406:       Vector2 Umean = {0.0, 0.0};
 2407:       for (int m=0; m<elem->i34; m++) {      
 2408:          const Side *side = elem->sides[m];
 2409: 
 2410:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 2411:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 2412:       }
 2413:       Umean = Umean/elem->i34;
 2414: 
 2415:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 2416: 
 2417:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 2418:       const double I_4_1 = dot(gradPhi_1, Umean);
 2419: 
 2420:       // Integral of \nabla\phi_i \cdot \pmb{E}
 2421:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 2422:      
 2423:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);
 2424:       
 2425: 
 2426:       // Additional terms 
 2427:       double vnorm = 0.0;
 2428:       if (imm == 2)  { // Pre-compute vnorm on the element
 2429:          Vector3 ubed;
 2430:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 2431: 
 2432:          Vector3 gradP(0.0, 0.0, 1.0);
 2433:          for (int m=0; m < elem->i34; m++) {
 2434:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 2435:            gradP += toVector3(gradP_2D, 0.0);
 2436:          }   
 2437:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 2438:       } // imm==2
 2439: 
 2440:       if (elem->isTri()) {
 2441:          for (int l=0; l<3; l++) {
 2442:            double fac;
 2443: 
 2444:            Node *node = elem->nodes[l];
 2445: 
 2446:            (node == node1)? fac=2.0 : fac=1.0;
 2447: 
 2448:            if (imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 2449:            else        node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 2450:            
 2451:          }
 2452: 
 2453:          if (!elem->isDry) {
 2454:            const Vector2 gradEta = elem->nodes[0]->eta2*elem->gradPhi[0] +
 2455:                                    elem->nodes[1]->eta2*elem->gradPhi[1] +
 2456:                                    elem->nodes[2]->eta2*elem->gradPhi[2];
 2457: 
 2458:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 2459:          }
 2460: 
 2461:       } // isTri
 2462:       else { // isQuad
 2463:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2464:          // for (int l=0; l<4; l++) {
 2465:          //   const Node *node = elem->nodes[l];
 2466: 
 2467:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 2468:          //   else        tmp2 = node->bdef2 - node->bdef1;
 2469: 
 2470:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 2471:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 2472:          // }
 2473: 
 2474:       } // isQuad
 2475: 
 2476: 
 2477: 
 2478:       node1->qel += (dt/elem->i34)*elem->vsource;
 2479: 
 2480:    } // for all elements connected to the node
 2481:    
 2482: 
 2483: 
 2484:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 2485:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 2486:    NodeBoundary *nodeBnd = node1->nodeBnd;
 2487:    if (nodeBnd != nullptr)  { 
 2488:       // If it is an open boundary node...
 2489: 
 2490:       // At least one open bnd side, maybe two
 2491:       for (int l=0; l<2; l++) { 
 2492: 
 2493:          // Gets each of the sides sharing the node. 
 2494:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 2495: 
 2496:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 2497: 
 2498:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 2499: 
 2500: 
 2501:          if (sideBnd != nullptr) {
 2502:             // If the side is on a boundary...
 2503: 
 2504:             // Get the boundary segment
 2505:             const BoundarySegment *sideSegment = sideBnd->segment;
 2506:             const Side *side = sideBnd->side;
 2507: 
 2508:             // Integral I_3
 2509:             if (sideSegment->ifltype != 0) {
 2510:             // Natural or Flather b.c.
 2511: 
 2512:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 2513:                // especially for Flather b.c.
 2514:                double ri3 = 0.0;
 2515:                if (!side->isDry) {
 2516:                   // If the side is not dry
 2517:                   
 2518:                   // Computes the side flux of (uth, vth)
 2519:                   double Vn = 0.0;
 2520:                   for (int k = side->kb; k<nvrt-1; k++) {
 2521:                      // uth, vth in lat/lon frame if ics=2
 2522:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 2523:                      const double vn1 = dot(side->uth[k  ], side->n); // outer normal
 2524:                      const double vn2 = dot(side->uth[k+1], side->n);
 2525: 
 2526:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 2527:                   }
 2528: 
 2529:                   ri3 = 0.5*side->length*Vn;
 2530:                }
 2531: 
 2532:                if (sideSegment->ifltype == -1) { // Flather 1
 2533: 
 2534:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 2535:                   assert(side->depth > 0.0 && "Negative depth at Flather boundary");
 2536: 
 2537:                   const double con0 = (1.0/6.0)*side->length*sqrt(grav*side->depth); // For coefficient matrix
 2538:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 2539:                   
 2540:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 2541:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 2542: 
 2543:                } 
 2544:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 2545:                   // Reset ri3
 2546:                   ri3 = 0.0;
 2547: 
 2548:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 2549: 
 2550:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 2551: 
 2552:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 2553:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 2554: 
 2555:                   const double con0 = (1.0/6.0)*side->length*tmp*thetai*dt;
 2556:                   node1->addToSparseMatrix(node1, con0*2.0);
 2557:                   node1->addToSparseMatrix(node2, con0);
 2558: 
 2559:                } // if Flather or Discharge
 2560: 
 2561:                node1->qel -= thetai*dt*ri3;
 2562: 
 2563:             } // I_3
 2564:           
 2565: 
 2566:             // Integral I_5
 2567:             if(!side->isDry) {
 2568: 
 2569:                const double Unbar = dot(side->U, side->n);
 2570: 
 2571:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->length*Unbar;
 2572:                
 2573:             } // I_5
 2574: 
 2575:          } // if is boundary side
 2576: 
 2577:       } // for l
 2578: 
 2579:    } // if isbnd
 2580: 
 2581: }
 2582: 
 2583: 
 2584: extern "C" {
 2585:    __global__ void backtrackAllNodes(void) {
 2586: 
 2587:       // max/min # of sub-divisions
 2588:       const int ndelt_max = max(1.0, dt/dtb_min);
 2589:       const int ndelt_min = max(1.0, dt/dtb_max); 
 2590: 
 2591:       // Removed all references to swild98 XXX
 2592:       // swild98=0.d0 !init
 2593: 
 2594:       SIDE(side);
 2595: 
 2596:       // printf("backtrackAllNodes: side = %p idx = %d isDry = %d center = (%f,%f)\n", side, side->idx, side->isDry, side->center.x, side->center.y);
 2597: 
 2598:       const int kb = side->kb;
 2599: 
 2600:       // Initialize btrack velocities to the actual velocities at the side 
 2601:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 2602: 
 2603:       if (side->isDry) return;
 2604: 
 2605:       // Checks that at least one element is not dry
 2606:       const Element *elem1 = side->elems[0];
 2607:       const Element *elem2 = side->elems[1];
 2608: 
 2609:       // printf("backtrackAllNodes: side->isDry = %d, idx = %d, elem1 = %p, elem2 = %p\n", side->isDry, side->idx, elem1, elem2);
 2610:       // printf("elem1->isDry = %d, elem2->isDry = %d\n", elem1!=nullptr?elem1->isDry:-10, elem2!=nullptr?elem2->isDry:-10);
 2611:       // if (elem1!=nullptr && (elem1->isDry<0 || elem1->isDry>1)) printf("XXXX elem1 = %p idx = %d isDry = %d\n", elem1, elem1->idx, elem1->isDry);
 2612:       // if (elem2!=nullptr && (elem2->isDry<0 || elem2->isDry>1)) printf("XXXX elem2 = %p idx = %d isDry = %d\n", elem2, elem2->idx, elem2->isDry);
 2613:       // if (elem1!=nullptr && (elem1->isDry==0 || elem1->isDry==1)) printf("elem1 = %p idx = %d isDry = %d\n", elem1, elem1->idx, elem1->isDry);
 2614:       // if (elem2!=nullptr && (elem2->isDry==0 || elem2->isDry==1)) printf("elem2 = %p idx = %d isDry = %d\n", elem2, elem2->idx, elem2->isDry);
 2615:       if (elem1!=nullptr) printf("elem1 = %p idx = %d i34 = %d (x,y,z) = (%f,%f,%f)\n", elem1, elem1->idx, elem1->i34, elem1->center.x, elem1->center.y, elem1->center.z);
 2616:       if (elem2!=nullptr) printf("elem2 = %p idx = %d i34 = %d (x,y,z) = (%f,%f,%f)\n", elem2, elem2->idx, elem2->i34, elem2->center.x, elem2->center.y, elem2->center.z);
 2617:       printf("elem1 = %p, elem2 = %p\n", elem1, elem2);
 2618: 
 2619:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 2620: 
 2621:       // XXXXXX
 2622:       // !swild_tmp to store global coord. of the starting side
 2623:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 2624:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 2625:       // !Use sframe2 
 2626:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 2627: 
 2628: 
 2629:       for (int k = kb; k < nvrt; k++) {
 2630:       //  Initialize (xt,yt,zt), nnel and vel.
 2631:       //  For ics=2, the coordinates are in local frames
 2632:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 2633: 
 2634: 
 2635:          const int iadvf = side->iadv();  // Advection flag
 2636: 
 2637:          Point3 xt;
 2638:          if constexpr(ics==1) {
 2639:             xt = side->center3D(k); 
 2640:          }
 2641:          else // lat/lon; in side lat/lon frame
 2642:          {
 2643:          // XXX IMPLEMENT THIS
 2644:       //          xt=0.d0
 2645:       //          yt=0.d0
 2646:       //          !centroid coord. for nudging
 2647:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 2648:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 2649:          }  // ics
 2650: 
 2651: 
 2652:          // Velocity at the side (in ll frame for ics, same vertical direction)
 2653:          // XXX IS THIS NECESSARY?
 2654:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 2655: 
 2656:          // If on land or open boundary...
 2657:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 2658:          
 2659:          const double vmag = length(toVector2(u_int));
 2660: 
 2661:          if (vmag <= velmin_btrack) {
 2662:             // No activity 
 2663: 
 2664:             side->btu[k] = side->u2[k];
 2665:             printf("XXX vmag = %f\n", vmag);
 2666: 
 2667:          } else {  // do btrack
 2668: 
 2669:             // Compute number of sub-divisions based on local gradients 
 2670:             // XXX IS THIS NECESSARY?
 2671:             double suma = 0.0;
 2672:             int icount = 0;
 2673:             for (int ii=0; ii<2; ii++) {
 2674: 
 2675:                const Element *elem = side->elems[ii];
 2676:                  
 2677:                if (elem == nullptr) continue;
 2678: 
 2679:                icount++;
 2680: 
 2681:                // Not strictly along z; in ll frame for ics=2
 2682: 
 2683:                double utmp[4];
 2684:                double vtmp[4];
 2685:                for (int jj = 0; jj < elem->i34; jj++) {
 2686: 
 2687:                   const Node *node = elem->nodes[jj];
 2688: 
 2689:                   if constexpr(ics==1) {
 2690:                      utmp[jj] = node->u2[k].x;
 2691:                      vtmp[jj] = node->u2[k].y;  
 2692:                   } else {
 2693:                      // XXX IMPLEMENT THIS
 2694:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 2695:                   }
 2696:                } // for jj
 2697: 
 2698:                const Vector2 grad_u = elem->grad(utmp); 
 2699:                const Vector2 grad_v = elem->grad(vtmp);
 2700: 
 2701:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 2702:             } // for ii
 2703: 
 2704:             assert(icount > 0 && "Impossible 77");
 2705: 
 2706:             // '4' is somewhat arbitrary
 2707:             const int ndelt = max(ndelt_min, min(ndelt_max, int(suma/icount)*4)); // >=1
 2708:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 2709: 
 2710:             // printf("dtbk = %f\n", dtbk);
 2711: 
 2712: 
 2713:             // Perturb starting pt to avoid underflow 
 2714:             // XXX I don't think this is needed with the current implementation
 2715:             // eps=btrack_nudge
 2716:             // if constexpr(ics==1) {
 2717:             //    xt=(1.d0-eps)*xt+eps*xctr(nnel)
 2718:             //    yt=(1.d0-eps)*yt+eps*yctr(nnel)
 2719:             // } else { //lat/lon
 2720:             //    xt=(1.d0-eps)*xt+eps*xctr2
 2721:             //    yt=(1.d0-eps)*yt+eps*yctr2
 2722:             // } // ics
 2723: 
 2724:          
 2725:             // call btrack(l,ipsgb,ifl_bnd,j,iadvf,swild_tmp,swild10_tmp, dtbk,time_rm,time_rm2,uuint,vvint,wwint,nnel,jlev,xt,yt,zt,swild3,ltmp)
 2726: 
 2727:                
 2728:          } // if vmag (do backtrack)
 2729: 
 2730:       } // for j=jmin,nvrt-1
 2731: 
 2732:    }
 2733: } // extern "C"
 2734: 
 2735: template<int nc>
 2736: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 2737: 
 2738: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 2739: //
 2740: // a,b,c,r: input vectors and are not modified by this program.
 2741: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 2742: // r is the r.h.s.
 2743: // n: actual rank of the system.
 2744: // rows in u() and r();
 2745: // u: output with nc columns (transposed to rows)
 2746: // gam: a working array.
 2747: //
 2748: // NOTES:
 2749: // This is a template function that allows for different numbers of columns in the rhs vector.
 2750: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 2751: 
 2752:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 2753:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 2754: 
 2755:    double bet = b[0];
 2756:    if constexpr (nc == 1) {
 2757:       u[0] = rhs[0]/bet;
 2758:    } else {
 2759:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 2760:    }
 2761: 
 2762:    for (int j = 1; j < n; j++) {
 2763:       gam[j] = c[j-1]/bet;
 2764:       bet = b[j] - a[j]*gam[j];
 2765: 
 2766:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 2767: 
 2768:       if constexpr (nc == 1) {
 2769:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 2770:       } else {
 2771:          for (int k = 0; k < nc; k++) {
 2772:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 2773:          }
 2774:       }
 2775:    }
 2776: 
 2777:    // Back-substitution
 2778:    for (int j=n-1; j>=1; j--) {
 2779:       if constexpr (nc == 1) {
 2780:          u[j] = u[j] - gam[j+1]*u[j-1];
 2781:       } else {
 2782:          for (int k = 0; k < nc; k++) {
 2783:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 2784:          }
 2785:       }
 2786:    }
 2787: }
 2788: 
 2789: 
 2790: 
 2791: 
 2792: // Helper function that contains the core algorithm
 2793: template<typename XAccessor, typename YAccessor>
 2794: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 2795:                                     double  yp_top, double  yp_bot, 
 2796:                                     CubicSpline &spline) {
 2797:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 2798:    // 
 2799:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 2800:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 2801:    //
 2802:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 2803:    // 
 2804:    // Inputs: 
 2805:    //            n: dimension for x etc; # of data pts (>=2);
 2806:    //            getX, getY: functions to access x,y coordinates
 2807:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 2808:    //     Output: 
 2809:    //            spline (CubicSpline): spline structure with x,y,y',y''
 2810: 
 2811:    const int n = k2 - k1 + 1;
 2812:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 2813: 
 2814:    // Allocate memory for the splines
 2815:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 2816:    spline.x   = new double[n];
 2817:    spline.y   = new double[n];
 2818:    spline.yp  = new double[n];
 2819:    spline.ypp = new double[n];
 2820: 
 2821:    for (int k=k1; k<=k2; k++) {
 2822:       spline.x[k] = getX(k);
 2823:       spline.y[k] = getY(k);
 2824:    }
 2825: 
 2826:    // This is to simplify expressions later
 2827:    double *x = spline.x;
 2828:    double *y = spline.y;
 2829: 
 2830:    double *a = nullptr;
 2831:    double *b = nullptr;
 2832:    double *c = nullptr;
 2833:    double *gam = nullptr;
 2834:    double *rhs = nullptr;
 2835:    
 2836: 
 2837:       a = new double[n];   // Lower diagonal
 2838:       b = new double[n];   // Diagonal
 2839:       c = new double[n];   // Upper diagonal
 2840:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 2841:       rhs = new double[n]; // Right-hand side
 2842: 
 2843:    for (int k=k1; k<=k2; k++) {
 2844:       if (k == k1) {
 2845:          // Bottom level
 2846:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 2847:          b[k] = (x[k+1] - x[k])/3.0;
 2848:          c[k] = b[k]/2.0;
 2849:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 2850:       } else if (k == n - 1) {
 2851:          // Top level (surface)
 2852:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 2853:          b[k] = (x[k] - x[k-1])/3.0;
 2854:          a[k] = b[k]/2.0;
 2855:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 2856:       } else {
 2857:          // Intermediate levels
 2858:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 2859:          b[k] = (x[k+1] - x[k-1])/3.0;
 2860:          a[k] = (x[k  ] - x[k-1])/6.0;
 2861:          c[k] = (x[k+1] - x[k  ])/6.0;
 2862:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 2863:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 2864:       }
 2865:    }
 2866: 
 2867:    // Solve the tridiagonal system
 2868:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 2869:    
 2870:    spline.yp[k1] = yp_bot;
 2871:    spline.yp[k2] = yp_top;
 2872: 
 2873:    // Compute rest of 1st derivatives using the splines
 2874:    for (int k=k1+1; k<k2; k++) {
 2875:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 2876:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 2877:    }
 2878:    
 2879:    delete[] a;
 2880:    delete[] b;
 2881:    delete[] c;
 2882:    delete[] gam;
 2883:    delete[] rhs;
 2884: 
 2885: }
 2886: 
 2887: // Array version
 2888: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 2889:                                 double y_top, double y_bot, 
 2890:                                 CubicSpline &spline) {
 2891:    auto getX = [x] (int k) { return x[k]; };
 2892:    auto getY = [y] (int k) { return y[k]; };
 2893:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 2894: }
 2895: 
 2896: // Lambda version - allows custom access patterns
 2897: template<typename XFunc, typename YFunc>
 2898: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 2899:                                 double y_top, double y_bot,
 2900:                                 CubicSpline &spline) {
 2901:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 2902: }
 2903: 
 2904: 
 2905: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 2906: {
 2907:    assert("Not implemented");
 2908: 
 2909:    return 0.0;
 2910: }
 2911: 
 2912: // __device__ void vertLinearInterp(int nc, double zt, int k1, int k2, double *za, double *s_in, double *s_out, int *ibelow) {
 2913: // //     Routine to do vertical linear interpolation in z
 2914: // //     Inputs:
 2915: // //
 2916: // //       nc: actual # of variables 
 2917: // //       k1,k2: lower and upper limits for za, s_in 
 2918: // //       zt: desired interpolation level
 2919: // //       za[0:nvrt-1]: z-coordinates for s_in (must be in ascending order)
 2920: // //       s_in[0:nc-1,0:nvrt-1]: values to be interpolated from; dimensions must match driving program
 2921: 
 2922: // //     Outputs:
 2923: // //       s_out[0:nc-1]: interpolated value @ z=zt (bottom value if ibelow=1). Constant extrapolation
 2924: // //                   is used below bottom or above surface.
 2925: // //       ibelow: flag indicating if zt is below za(k1)
 2926: // //
 2927: 
 2928: //    assert(k1 >= 0 && k2 < nvrt && "vertLinearInterp: k1 or k2 out of bounds");
 2929: //    assert(k1 <= k2 && "vertLinearInterp: k1 > k2");
 2930:    
 2931: //    ibelow = 0;
 2932: 
 2933: //    if (zt < za[k1]) {
 2934: //       // Below bottom
 2935: //       ibelow = 1;
 2936: //       for (int i = 0; i < nc; i++) s_out[i] = s_in[i + k1*nc];
 2937: 
 2938: //    } else if(zt>=za[k2]) {
 2939: //       // Above surface
 2940: //       for (int i = 0; i < nc; i++) s_out[i] = s_in[i + k2*nc];
 2941: 
 2942: //    } else {
 2943: //       // Normal case (between bottom and surface)
 2944:       
 2945: //       // Finds the level index using binary search
 2946: //       int l1 = k1;
 2947: //       int l2 = k2;
 2948: //       int k = (l1 + l2)/2;
 2949: //       while (l2 - l1 > 1) {  // Stop when we have adjacent levels
 2950: //           int k = (l1 + l2)/2;
 2951: //           if (zt >= za[k]) l1 = k;
