  638: // This struct is used to store the boundary information for a node.
  639: struct NodeBoundary {   
  640:    BoundarySegment *segment;
  641:    
  642:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
  643:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
  644: 
  645:    double elbc;   // Elevation boundary condition
  646:    int iettype;   // Type of elevation boundary condition
  647: 
  648:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
  649:       assert(index == 0 || index == 1); 
  650:       return (index == 0) ? sideBnd1 : sideBnd2; 
  651:    }
  652: };
