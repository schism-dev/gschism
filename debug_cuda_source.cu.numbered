  644: 
  645: struct Side {
  646: 
  647:    // Geometry information
  648:    int idx;               // Index of the side
  649:    Node *n1, *n2;
  650:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  651: 
  652:    double length;         // Length of the side. Used to be called distj; but I think this name is less clear now.
  653:    Vector2 center;        // Location of side center. 
  654:    double zc[nvrt];       // Side center z-coord at each vertical level
  655: 
  656:    Frame frame;
  657: 
  658:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  659:                           // this is nullptr
  660:    
  661:    int kb;                // Bottom index of the side
  662:    bool isDry;             // True if the side is dry
  663:  
  664:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  665: 
  666:    // Physical information
  667:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  668:    double  w2[nvrt];            // Vertical velocity at each vertical level
  669:    Vector2 btu[nvrt];           // Back-tracked velocity
  670:    Vector2 uth[nvrt];           // "Time history" velocity
  671:    Vector2 U;                   // Vertically averaged velocity vector  
  672: 
  673:    Vector2 d2uv[nvrt];          // divergence of (nu*grad u) XXX COMPUTE!!
  674: 
  675:    Vector2 bcc[nvrt];           // Baroclinic term
  676: 
  677:    double hhat;                 // \breve{H} in notes
  678: 
  679:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
  680: 
  681:    double coriolis;             // Coriolis parameter
  682: 
  683:    // Vegetation parameters
  684:    double veg_c2;
  685:    double veg_beta;
  686: 
  687:    // Bottom drag parameters.
  688:    double chi;
  689:    double chi2;
  690: 
  691:    __inline__ __device__ double x(double t) const;
  692:    __inline__ __device__ double y(double t) const;
  693:    __inline__ __device__ Point2 p_t(double t) const;
  694: 
  695:    __inline__ __device__ Point3 center3D(int k) const { return {center.x, center.y, zc[k]}; }
  696:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
  697:    __inline__ __device__ double Dz(int k)       const { return zc[k] - zc[k-1]; }
  698: 
  699:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
  700: 
  701:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
  702: 
  703:    __inline__ __device__ int iadv(void) const;
  704: 
  705:    __inline__ __device__ double eta2(void) const;
  706:    __inline__ __device__ double depth(void) const;
  707:    __inline__ __device__ double htot(void) const { return eta2() + depth(); }
  708: 
  709:    __inline__ __device__ double veg_h(void)  const;
  710:    __inline__ __device__ double veg_nv(void) const;
  711:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
  712:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
  713: 
  714:    __inline__ __device__ double Cd(void) const;
  715: 
  716:    __inline__ __device__ Vector2 tau(void) const;
  717: 
  718:    __inline__ __device__ double zb(void) const { return zc[kb]; }
  719:    
  720: 
  721:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
  722:    __inline__ __device__ double zLevelVegRatio(int k) const { 
  723:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
  724:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
  725:    } 
  726:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
  727:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot(); }
  728:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 1; }
  729:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 1; }
  730: 
  731:    // Get valid starting element (for backtracking)
  732:    __inline__ __device__ Element* getStartElement() {
  733:       return elems[0] ? elems[0] : elems[1];
  734:    }
  735: 
  736:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
  737:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
  738: 
  739:       // If one of the elements is null, return the other one
  740:       if      (elems[0] == nullptr) return elems[1];
  741:       else if (elems[1] == nullptr) return elems[0];
  742: 
  743: 
  744:       // Dot product of the negative velocity vector with the side normal vector
  745:       const double dot_prod1 = -dot(u, n);
  746:       
  747:       // Vector from side center to element 0 centroid
  748:       const Vector2 v2 = toVector2(elems[0]->center) - center;
  749: 
  750:       // Dot product of the vector with the side normal vector
  751:       const double dot_prod2 = dot(v2, n);
  752: 
  753:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
  754:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
  755: 
  756:       if (dot_prod1*dot_prod2 > 0.0) return elems[0];
  757:       else                           return elems[1];
  758: 
  759:  
  760:    }
  761: 
  762:    __forceinline__ __device__ Element* otherElem(const Element* elem) {
  763:       // Given an element, returns the other element that shares this side
  764:       return (elems[0] == elem) ? elems[1] : elems[0];
  765:    }
  766: 
  767:    __forceinline__ __device__ Node* otherNode(Node* node) {
  768:       // Given a node, returns the other node that shares this side
  769:       return (n1 == node) ? n2 : n1;
  770:    }
  771:  
  772:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
  773: 
  774: 
  775: 
  776: 
  777: };
