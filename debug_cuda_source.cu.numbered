  784: // This struct is used to store the boundary information for a node.
  785: struct NodeBoundary {   
  786:    BoundarySegment *segment;
  787:    Node *node;
  788:    
  789:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
  790:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
  791: 
  792:    double etaic;  // Elevation at nodes used for essential boundary conditions
  793:    double elbc;   // Elevation boundary condition
  794:    int iettype;   // Type of elevation boundary condition
  795:    double eth;    // Elevation time history
  796: 
  797:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
  798:       assert(index == 0 || index == 1); 
  799:       return (index == 0) ? sideBnd1 : sideBnd2; 
  800:    }
  801: };
