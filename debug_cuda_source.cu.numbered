 2921: 
 2922: __device__ void computeBottomDragVegetation(void) {
 2923:    // UNFINISHED. CHECK THIS:
 2924:    // How many kernels are needed? Why so many for loops?
 2925:    // Is the loop on sides needed?
 2926: 
 2927:    Node *node = NODE_PTR;
 2928: 
 2929:    const int    kb      = node->kb;
 2930:    const double htot    = node->htot();
 2931:    const double rough   = node->rough;
 2932: 
 2933: 
 2934:    if (node->idry) {
 2935:       // Default values for dry nodes
 2936:       node->veg_alpha_vert_mean = node->veg_alpha0;
 2937:       /// XXX CHECK INDICES
 2938:       if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 2939:    }
 2940: 
 2941:    // Compute bottom drag Cd
 2942:    //--------------------------------
 2943: 
 2944:    // nchi = {-1, 0, 1} is the type of bottom drag.
 2945:    if (nchi==1) {
 2946: 
 2947:       bool ltmp = false; // for WBL iteration
 2948: 
 2949:       // Cdmax=-1 !max. Cd at node for this process (info only)
 2950:       // Drag at nodes
 2951: /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 2952: // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 2953:      
 2954:       const double rough = node->rough;
 2955:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 2956:       if (node->rough == 0.0) {
 2957:          node->Cd = 0.0;
 2958: 
 2959:       } else { //roughness >0 
 2960:          
 2961:          const double bthick_ori = node->znl[kb + 1] - node->znl[kb];  // thickness of bottom bnd layer
 2962:          const double bthick = max(dzb_min, bthick_ori);
 2963: 
 2964:          assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 2965: 
 2966:          double tmp = 1.0/(2.5*log(bthick/rough));
 2967:          node->Cd = tmp*tmp;
 2968: 
 2969:       } // if rough
 2970: 
 2971: 
 2972:       // RECOVER THIS: XXX
 2973:       // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 2974:       // Output warning for WBL if iteration didn't converge
 2975: 
 2976: 
 2977:    } // nchi==1
 2978: 
 2979:    //   Bottom stress in m^2/s^2
 2980:    if (node->rho[kb + 1] >= -98.0)
 2981:    {
 2982:       const double mag_u = length(toVector2(node->u2[kb + 1]));
 2983:       node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 2984:       // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 2985:       // !sediment erosion: this part needs more documentation
 2986:    }
 2987: 
 2988:  
 2989:    // Compute vegetation parameters
 2990:    //--------------------------------
 2991: 
 2992:    // SAV constants
 2993:    constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 2994:    constexpr double veg_cfpsi = 0.16;
 2995: 
 2996:    // Add vertical variation to veg_alpha and compute vertical mean etc.
 2997:    if constexpr(iveg == 1) { //  Vertical variation specified by functions
 2998: 
 2999:       // Compute the vegetation "density" \alpha = D*N*Cd/2
 3000:       // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 3001:       int kbin = 0; // bin index
 3002:       for (int k = kb; k < nvrt; k++) {
 3003:          // Computes node height above the bottom level
 3004:          const double tmp_h = node->znl[k] - node->znl[kb]; // >=0
 3005:          assert(true && "Vertical variation of vegetation not implemented");
 3006: 
 3007:          // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 3008:          //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 3009:          //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 3010:          //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 3011:          // } else {
 3012:          //    // Find the bin at which the current vertical level is
 3013:          //    while (kbin<nbins_veg_vert) {
 3014:          //       const double zn = node->znl[kbin];
 3015:          //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 3016:          //          break;
 3017:          //       } // if
 3018:          //       kbin++;
 3019:          //    } // while
 3020:          //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 3021: 
 3022:          //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 3023:          //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 3024:             
 3025:          //    // Linear interpolation of the vegetation parameters
 3026:          //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 3027:          //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 3028:          //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 3029:          // } // if rl10
 3030: 
 3031:          // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 3032: 
 3033:       } // for k
 3034: 
 3035: 
 3036:    } else { // Ganthy (iveg=2)
 3037:    //  Modify canopy height, diameter, and density
 3038: 
 3039:       // Make sure there is vegetation on this node
 3040:       if (node->veg_h_unbent > 0.0) {
 3041:          const double wtmp2 = length(node->dav)*100.0; // cm/s
 3042: 
 3043:          node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 3044:                                 0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 3045:          node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 3046: 
 3047:          const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 3048:          node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 3049:          const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 3050:          node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 3051:       } // if veg_h_unbent
 3052: 
 3053:       for (int k = 0; k < nvrt; k++) {
 3054:          node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 3055:       } // for k
 3056:    
 3057: 
 3058:    } // if iveg
 3059:   
 3060:       
 3061: 
 3062:    // Compute vertical mean of veg_alpha3D
 3063:    if (iveg != 0) {
 3064:       const double ztop = node->zTopCanopy(); // Top of the canopy
 3065:       double sum1=0.0;
 3066:       double sum2=0.0;
 3067:       // Integrate over each level under the canopy...
 3068:       for (int k=kb; k<nvrt-1 && node->znl[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 3069:          const double Dz = node->Dz(k);
 3070: 
 3071:          sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 3072:          sum2 += Dz;
 3073: 
 3074:       } // for k
 3075: 
 3076:       if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 3077:       else             node->veg_alpha_vert_mean = sum1/sum2;
 3078: 
 3079:    } // if iveg
 3080: 
 3081: }
 3082: 
 3083: __device__ void computeVegetationAndDragParameters(void) {
 3084:    // Computes the vegetation and drag model parameters:
 3085:    // chi, \tilde\chi, beta, \breve{H}
 3086:    
 3087:    Side *side = SIDE_PTR;
 3088: 
 3089:    const double htot = side->htot();
 3090:    const int    kb   = side->kb;
 3091: 
 3092:    assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 3093: 
 3094:    const double veg_h     = side->veg_h();
 3095:    const double veg_nv    = side->veg_nv();
 3096:    const double veg_c     = side->veg_c();
 3097:    const double veg_beta  = side->veg_beta;
 3098:    const double veg_alpha = side->veg_alpha_vert_mean();
 3099: 
 3100:    // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 3101:    // Velocity magnitude at the bottom level
 3102:    // XXXX Check if we have add -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 3103:    assert(true && "Must use backtracked velocity");
 3104:    const double vmag1 = length(side->u2[kb + 1]); //BACKTRACKED VELOCITY
 3105:    side->chi2 = side->Cd()*vmag1;
 3106:    side->chi  = side->chi2;
 3107:    if constexpr(iveg != 0) {
 3108:       const Node *n1 = side->n1;
 3109:       const Node *n2 = side->n2;
 3110:       const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 3111:       side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 3112:    }
 3113: 
 3114:    // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 3115: 
 3116:    // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 3117:    // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 3118:    double magUa = 0.0;
 3119:    if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 3120:       // 3D wet side with veg...
 3121: 
 3122:       double magUa = 0.0;
 3123:       for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 3124:          if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 3125: 
 3126:             // Velocity magnitude must be computed at the center of each level to perform the integration.
 3127:             // The tricky part is to compute that velocity at the level that may be partially submerged.
 3128:             const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 3129: 
 3130:             // Velocity magnitude at the top (h) of the level (may be partially submerged)
 3131:             const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 3132: 
 3133:             // Velocity magnitude at the bottom (l) of the level
 3134:             const double ul = length(side->u2[k]);
 3135: 
 3136:             const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 3137:             magUa += Dz*0.5*(uh + ul);
 3138: 
 3139:          } // if HasVegetation
 3140:       } // for k
 3141:       const double ua = magUa/min(htot, veg_h); // Vertical average
 3142: 
 3143:       // Computes beta, used for computing the stress term at the top of the canopy.      
 3144:       side->veg_c2 = veg_alpha*dt*ua; // >=0
 3145:       if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 3146:          const double zCpy = side->zTopCanopy();
 3147:          const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 3148:          const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 3149:          const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 3150:          const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 3151:          side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 3152:       } // if isSubmerged
 3153:    } // if iveg   
 3154: 
 3155:    // Computes the friction modified depth, \breve{H} in notes
 3156:    if (side->is2D()) { // 2D
 3157: 
 3158:       double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 3159:       if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 3160: 
 3161:       assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 3162: 
 3163:       side->hhat = htot*htot/fricH; 
 3164: 
 3165:    } else { // 3D
 3166:       side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 3167: 
 3168:       if constexpr(iveg != 0) {
 3169:          
 3170:          if (side->isSubmerged()) { 
 3171:             const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 3172:             side->hhat -= veg_c*Hhat_alpha;
 3173: 
 3174:          } else { // Emergent
 3175:             side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 3176:          }
 3177:       } // if iveg
 3178: 
 3179:       // Enforce positivity for 3D model
 3180:       if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 3181:    } // if 3D
 3182: 
 3183:      
 3184: }
 3185: 
 3186: 
 3187: 
 3188: __device__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 3189: // Computes the density gradient between two elements, e1 and e2.
 3190: // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 3191: // zero in the direction normal to the side. 
 3192: // 
 3193: // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 3194: // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 3195: //
 3196: // Input:
 3197: //    e1: Element
 3198: //    e2: Neighbor element (or nullptr if boundary)
 3199: //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 3200: //    k: Index of the half-level at which the density is interpolated
 3201: //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 3202: // 
 3203: // Output:
 3204: //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 3205: //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 3206: 
 3207:    if (e2 == nullptr || e2->idry) {
 3208:       // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 3209: 
 3210:       Side *side = e1->sides[j];
 3211:       assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->idry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 3212:               
 3213:       if constexpr(ics == 1) {
 3214:          vec = side->n; // Normal vector to the side
 3215:       } else {
 3216:          // IMPLEMENT THIS XXXXXX
 3217:          // !replace with xel, yel?
 3218:          //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 3219:          //      &eframe(:,:,i),xn1,yn1,tmp)
 3220:          //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 3221:          //      &eframe(:,:,i),xn2,yn2,tmp)
 3222:       } //ics
 3223:                 
 3224:       diffRho = 0.0;
 3225: 
 3226:    } else { //internal and wet
 3227:       if constexpr(ics==1) {
 3228:          assert(e2 != nullptr || e2->idry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 3229: 
 3230:          // Vector from e1 to e2
 3231:          vec = toVector2(e2->center - e1->center);
 3232: 
 3233:       } else { 
 3234:          // IMPLEMENT THIS XXXXXX
 3235:          //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 3236:          //      &eframe(:,:,i),xctr2,yctr2,tmp)
 3237:          //                   alow(j)=xctr2
 3238:          //                   bdia(j)=yctr2
 3239:       } // ics
 3240: 
 3241:       diffRho = rho2 - e1->demeanedDensity(k);
 3242:    }
 3243: 
 3244: }
 3245: 
 3246: __device__ void computeDensityCubicSplines(void) {
 3247:    // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 3248: 
 3249:    Element *elem = ELEM_PTR;
 3250:    if (elem->idry) return;
 3251: 
 3252:    const int kb = elem->kb;
 3253: 
 3254:    // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 3255:    if (elem->is2D()) {
 3256:       // In the 2D case, the density is constant at the prism level. 
 3257:       // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 3258:       elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 3259:    } else { //3D
 3260: 
 3261:       // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 3262:       auto getX = [elem] (int k) { return elem->z_prism(k); };
 3263:       auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 3264:       ///// XXXX CHECK INDICES!!!!!
 3265:       initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_zz, elem->rho_z);
 3266:    } // 2D/3D
 3267: 
 3268: }
 3269: 
 3270: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 3271: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 3272: 
 3273:    if (elem2 == nullptr || elem2->idry) return 0.0;
 3274: 
 3275:    const int kb  = elem->kb;
 3276:    const int kb2 = elem2->kb;
 3277: 
 3278:    // z-coordinate of prism of elem
 3279:    const double zp = elem->z_prism(k);
 3280: 
 3281:    double rho = 0.0;
 3282: 
 3283:    if (elem2->is2D()) {
 3284:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 3285: 
 3286:    } else {  // 3D
 3287: 
 3288:       // eta_min may be < zmax
 3289:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 3290:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 3291: 
 3292:       // (Extrapolate density below bottom, we will fix it later)
 3293:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 3294:       rho = evalCubicSpline(zp, elem->rho_z, elem->rho_zz, elem->demeanedDensity(k), true);
 3295:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 3296:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 3297:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 3298:    } // 2D/3D
 3299:      
 3300: 
 3301:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 3302:    // Now we need to fix it.
 3303:    if (elem->z[k] < elem2->z[kb2]) {
 3304:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 3305: 
 3306:       // There are two methods to adjust the density at the bottom of the element.
 3307:       // iunder_deep=0: 
 3308:       const double depth1 = abs(elem->z[kb]); // larger depth
 3309: 
 3310:       if (iunder_deep==0) {
 3311: 
 3312:          const double weight = max(0.0, min(1.0, (depth1 - h1_bcc)/(h2_bcc - h1_bcc))); // weight
 3313: 
 3314:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 3315: 
 3316:       } else { // iunder_deep != 0
 3317: 
 3318:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 3319: 
 3320:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 3321: 
 3322:          //   Demeaned density at the same z coordinate as
 3323:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 3324:          }
 3325: 
 3326:       } // if iunder_deep
 3327:    } // if elem->z[kb] < elem2->z[kb]
 3328: 
 3329:    return rho;
 3330: }
 3331: 
 3332: __device__ void computeDensityGradient(void) {
 3333: 
 3334:    // Compute the horizontal density gradient at each element.
 3335:    // It works in two steps:
 3336:    // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 3337:    // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 3338:    //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 3339:    //             gradRho.r1 = rho1 - rho0
 3340:    //             gradRho.r2 = rho2 - rho0
 3341:    //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 3342:    // 
 3343:    //  NOTE: We use de-meaned densities.
 3344: 
 3345:    Element *elem = ELEM_PTR;
 3346: 
 3347:    if (elem->idry) return;
 3348: 
 3349:    const int kb  = elem->kb;
 3350:    const int i34 = elem->i34;
 3351: 
 3352:    for (int k = kb + 1; k < nvrt; k++) {
 3353:       // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 3354:       //             gradRho.r1 = rho1 - rho0
 3355:       //             gradRho.r2 = rho2 - rho0
 3356:       int icount = 0;
 3357:       double sumRx = 0.0;
 3358:       double sumRy = 0.0;
 3359:       for (int j1=0; j1<i34; j1++) { 
 3360: 
 3361:          const int j2 = elem->nxq(j1 + 1);
 3362: 
 3363:          // Pairs of consecutive neighbor elements of elem
 3364:          const Element *e1 = elem->nghbElems[j1];
 3365:          const Element *e2 = elem->nghbElems[j2];
 3366: 
 3367:          // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 3368:          const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 3369:          const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 3370: 
 3371:          // Compute the density difference and the vector from elem to e1 and e2
 3372:          // getRhoDiffAndVec takes into account boundaries/dry elements
 3373:          double diffRho1, diffRho2;
 3374:          Vector2 vec1, vec2;
 3375:          getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 3376:          getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 3377: 
 3378:          const double rl1 = length(vec1);
 3379:          const double rl2 = length(vec2);
 3380:          assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 3381: 
 3382:          const double delta = cross(vec1, vec2);
 3383:          const double sintheta = abs(delta)/(rl1*rl2);
 3384: 
 3385:          // To avoid problems, avoid elements with small angle between vectors
 3386:          constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 3387:          const bool validEq = (sintheta > sin_one_deg);
 3388: 
 3389:          if (validEq) {
 3390:             // Solve the system of equations to get the density gradient at elem
 3391:             icount++;
 3392:             const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 3393:             const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 3394:             sumRx += Rx;
 3395:             sumRy += Ry;
 3396:          }
 3397:       } // for j1
 3398: 
 3399:       // Compute the average density gradient at elem
 3400:       if (icount==0) {
 3401:         // Bad mesh quality; bail out with 0 b-cc
 3402:         elem->gradRho[k] = {0.0, 0.0};
 3403:       } else {
 3404:         elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 3405:       }
 3406: 
 3407:    } // for k
 3408: 
 3409: }
 3410: 
 3411: __device__ void computeBaroclinicTerm(double rampbc) {
 3412: // Computes the baroclinic term at sides (at half levels).
 3413: // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 3414: // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 3415: 
 3416:    Side *side = SIDE_PTR;
 3417: 
 3418:    if (side->idry == 1) return;
 3419: 
 3420:    const Element *e1 = side->elems[0];
 3421:    const Element *e2 = side->elems[1];      
 3422:    const int kb = side->kb;
 3423:    
 3424:    assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 3425: 
 3426:    // interpolates vertically the density gradient of the two elements at the half level/
 3427: 
 3428:    // Starts the integration at the surface and goes down to the bottom
 3429:    int k1 = nvrt - 1;
 3430:    int k2 = nvrt - 1;
 3431: 
 3432:    side->bcc[nvrt-1] = {0.0, 0.0};
 3433:    for (int k = nvrt-1; k >= kb; k--) {
 3434:    // For each prism level (from surface to bottom)...
 3435: 
 3436:       // For both elements, interpolate density gradient at the side's half level.
 3437:       // The gradient at the side is the average of the gradients at the elements.
 3438:       // w1, w2 are used to take into account boundary sides, with just one element.
 3439:       double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 3440:       double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 3441:       w1 = w1/(w1 + w2);
 3442:       w2 = w2/(w1 + w2);
 3443: 
 3444:       assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 3445: 
 3446:       // Linear interpolation of both elements' density gradient at the shared side's level.
 3447:       Vector2 gradRho = {0.0, 0.0};
 3448:       if (e1 != nullptr && k > kb) {
 3449:          // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 3450:          k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 3451:          const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 3452:          
 3453:          gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 3454:       }      
 3455:       if (e2 != nullptr && k > kb) {
 3456:          k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 3457:          const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 3458:          
 3459:          gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 3460:       }
 3461: 
 3462:       if constexpr(ics==2) {
 3463:          // IMPLEMENT THIS XXXXXX
 3464:          // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 3465:          // swild(1)=tmp1
 3466:          // swild(2)=tmp2
 3467:       }
 3468:       
 3469:       // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 3470:       // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 3471:       // CHECK INDICES!!! XXX
 3472:       const double grav3 = 0.5*(side->n1->grav2 + side->n2->grav2);
 3473:       side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 3474:    } // for
 3475: 
 3476: }
 3477: 
 3478: #ifdef DONTCOMPILE
 3479: __device__ void computeVerticalAdvection(void) {
 3480:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 3481: 
 3482:    sdbt(1:2,:,:)=0.d0
 3483: 
 3484:    const Side *side = FROM kernel;
 3485: 
 3486:    if(side->idry) return;
 3487: 
 3488:    // If side is wet...
 3489: 
 3490: 
 3491:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 3492:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 3493:    double ws[nvrt] = {} // w @ side
 3494:    int icount = 0;
 3495:    for (int j=0; j<2; j++) {
 3496:       const Element *elem = side->elements[j];
 3497:        
 3498:       if(elem != nullptr) {
 3499:          icount++;
 3500:          for (int k=0; k<nvrt; k++) {
 3501:             ws[k] = ws[k] + elem->w[k];
 3502:          }
 3503:       }
 3504:    }  // for j
 3505: 
 3506:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 3507:    ws = ws/icount;
 3508: 
 3509:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 3510:    // Splines allow for a smooth transition between vertical levels.
 3511:    // Splines have continuity restrictions at the internal knots, but
 3512:    // we have to provide the 1st derivatives at the endpoints.
 3513:    const int kbs = side->kbs; 
 3514:    
 3515:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3516:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3517:    initCubicSpline(kbs, nvrt, side, ws, up)
 3518: 
 3519:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3520:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3521:    initCubicSpline(kbs, nvrt, side, ws, vp)
 3522: 
 3523:    // Total advection (average onto side)
 3524:    const Node *node1 = side->nodes[0];
 3525:    const Node *node2 = side->nodes[1];
 3526:    for (int k=kbs(i); k<nvrt; k++) {
 3527: 
 3528:       if constexpr(ics==1) {
 3529:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 3530:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 3531:       } else {
 3532:          // XXX IMPLEMENT THIS
 3533:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 3534:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 3535:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 3536:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 3537:       }  // if ics
 3538: 
 3539: 
 3540:    }
 3541: }
 3542: #endif
 3543: 
 3544: __device__ void computeElemAverageGhat(void) {
 3545: // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 3546: 
 3547:    Element *elem = ELEM_PTR;
 3548:    
 3549:    elem->ghat1= {0.0, 0.0};  
 3550: 
 3551:    if constexpr(ihydraulics != 0) {
 3552:       if (nhtblocks > 0 && elem->isblock) return;
 3553:    }
 3554: 
 3555:    if (elem->idry == 1) return;
 3556: 
 3557:    // Wet elements.
 3558:    // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 3559:    // tidal potential, horizontal diffusion, and baroclinic etc
 3560:    // Remember to update both fb and F 
 3561:    // If ics=2, ghat1 are in eframe (ll)
 3562:    // cff1-3: coefficients for 2D/3D
 3563:    Vector2 gradEta = {0.0, 0.0};  // \nabla \eta
 3564:    Vector2 gradPr  = {0.0, 0.0};  // \nabla pressure
 3565:    Vector2 gradEtp = {0.0, 0.0};  // \nabla etp
 3566: 
 3567:    double av_cff1 = 0.0;  // av. for cff1
 3568:    double av_cff2 = 0.0;  // av. for cff2
 3569:    double av_cff3 = 0.0;  // av. for cff3
 3570:    double av_df = 0.0;  // av. for H^\alpha / H
 3571:    double av_cff2_chi = 0.0;  // av. for cff2*chi
 3572:    double av_cff3_chi = 0.0;  // av. for cff3*chi
 3573: 
 3574:    const int i34 = elem->i34;
 3575:    const int kb = elem->kb;
 3576: 
 3577:    for (int j=1; j<i34; j++) {
 3578:       // For each node and side in the element...
 3579: 
 3580:       const Node *node = elem->nodes[j];
 3581:       const Side *side = elem->sides[j];
 3582: 
 3583:       const double chi      = side->chi;
 3584:       const double veg_c2   = side->veg_c2;
 3585:       const double veg_beta = side->veg_beta;
 3586:       const double veg_h    = side->veg_h();
 3587:       const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 3588: 
 3589:       // Node - const in elem
 3590:       gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 3591:       gradPr  += node->pr  *elem->gradPhi[j];
 3592: 
 3593:       if (elem->depth >= tip_dp) {
 3594:         gradEtp += node->etp*elem->gradPhi[j];
 3595:       }
 3596: 
 3597:       
 3598:       const double htot  = side->htot();        // Total depth at the side
 3599:       const double zctr2 = side->zTopCanopy();  
 3600: 
 3601:       double cff1; 
 3602:       double cff2; 
 3603:       double cff3;   
 3604:       if (side->is2D()) {  // XXX Check indices, it used to have a +1
 3605:       // coefficients applied to 2D/3D case 
 3606:          cff1 = side->hhat/htot;
 3607:          cff2 = 0.0;
 3608:          cff3 = 0.0;
 3609:       } else { //3D
 3610:          //Init for no-veg case
 3611:          cff1 = 1.0;
 3612:          cff2 = 1.0;
 3613:          cff3 = 0.0;
 3614: 
 3615:          if constexpr(iveg != 0) {
 3616:             // Computes coefficients used with vegetation terms G1, G2
 3617:             // cff1, cff3 are used for the first two terms in G1, G2:
 3618:             // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 3619:             // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 3620:             // In general, cff1*Ustar - cff3*Ustar_alpha
 3621:             if(veg_h < 0.99*htot) { // submergent vegetation
 3622:                cff1=1;
 3623:                cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 3624:                cff3 = veg_c;
 3625: 
 3626:             } else { // emergent vegetation
 3627:                cff1 = 1.0/(1.0 + veg_c2);
 3628:                cff2 = cff1;
 3629:                cff3 = 0.0;
 3630: 
 3631:             }
 3632:          } // if iveg
 3633:       } //  2D/3D
 3634: 
 3635:       av_cff1 += cff1/i34;
 3636:       av_cff2 += cff2/i34;
 3637:       av_cff3 += cff3/i34;
 3638:       av_cff2_chi += cff2*chi/i34;
 3639:       av_cff3_chi += cff3*chi/i34;
 3640:       av_df += min(htot, veg_h)/(htot*i34);
 3641: 
 3642: 
 3643:       // btrack values: U^\star, U^{\star\alpha}
 3644:       // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 3645:       Vector2 Ustar       = {0.0, 0.0}; 
 3646:       Vector2 Ustar_alpha = {0.0, 0.0}; 
 3647:       for (int k = side->kb; k < nvrt; k++) {
 3648:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 3649:             Ustar += side->btu[nvrt]*side->Dz(k);
 3650: 
 3651:          } else { //3D
 3652:             Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 3653:             Ustar += w2;
 3654: 
 3655:             if constexpr(iveg != 0) {
 3656:                 if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 3657:                     const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k)); // For the top of the canopy, ratio of the level that is below the canopy
 3658:                     Ustar_alpha += zrat*w2; // XXXX
 3659:                 }
 3660:             }  // if iveg
 3661:          }  //2/3D
 3662:       }  //k
 3663:       
 3664: 
 3665:       // Add btrack & surface stress terms to \breve{G} first
 3666:       if constexpr(ics==1) {
 3667:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 3668:       } else {
 3669:          // XXX IMPLEMENT THIS
 3670:          // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 3671:          // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 3672:          // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 3673:       }  // if ics
 3674: 
 3675:       // Surface and bottom stress terms
 3676:       if constexpr(ics==1) {
 3677:          const Vector2 tau    = side->tau();
 3678:          const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 3679: 
 3680:          // Term for surface and bottom stress
 3681:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 3682:       } else {
 3683:          // XXX IMPLEMENT THIS
 3684:          // n1=isidenode(1,isd); n2=isidenode(2,isd)
 3685:          // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 3686:          // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 3687:          // tau_x=(vn1+tt1)/2.d0
 3688:          // tau_y=(vn2+ss1)/2.d0
 3689:          // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 3690:       }  // if ics
 3691: 
 3692:       
 3693: 
 3694:       // All terms in F,F^\alpha,f_b except baroclinic
 3695:       // F, f_b: all explicit terms excluding vegetation 
 3696:       // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 3697:       // Only need to calculate F^\alpha for 3D sides (but init=0) 
 3698:       const double coriolis = side->coriolis;
 3699:       Vector2 F  =  coriolis*side->U;  // F_x
 3700:       Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 3701:       Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 3702: 
 3703:       if (iveg != 0 && nvrt > side->kb) {  // 3D
 3704:          
 3705:          for (int k = side->kb; k < nvrt; k++) {
 3706:             if (zctr2 > side->zc[k-1]) {
 3707:                 const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 3708:                 const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 3709:                 Fa +=  coriolis*w2*zrat;
 3710:             } // if zctr2
 3711:          } // k
 3712:       } // iveg
 3713: 
 3714:       // Integrate horizontal viscosity force vertically
 3715:       for (int k=side->kb + 1; k<nvrt; k++) {
 3716:          const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.0; 
 3717: 
 3718:          F += levelHorVisc;
 3719: 
 3720:          // Vegetation term
 3721:          if constexpr(iveg!=0) {
 3722:             if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 3723:                const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 3724:                Fa += levelHorVisc*zrat;
 3725:             } 
 3726:          } // if iveg
 3727:       } // for k
 3728: 
 3729:       fb += side->d2uv[side->kb];
 3730: 
 3731: 
 3732:       // Add to ghat1
 3733:       if constexpr(ics==2) {
 3734:          // XXX IMPLEMENT THIS
 3735:          // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 3736:          // bigf1=vn1; bigf2=vn2
 3737:          // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 3738:          // botf1=vn1; botf2=vn2
 3739:          // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 3740:          // bigfa1=vn1; bigfa2=vn2
 3741:       } // if ics
 3742: 
 3743:       elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 3744:    } // for j (nodes and sides)
 3745: 
 3746:    elem->ghat1 = (1.0/i34)*elem->ghat1;
 3747:       
 3748:    // Finish off terms in F, F^\alpha and f_b
 3749:    const double grav3 = elem->mean(Node::grav2);
 3750:    const Vector2 fb = grav3*gradEtp - gradPr/rho0; //const in each elem
 3751: 
 3752: 
 3753:    Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 3754:    for (int j=1; j<i34; j++) { 
 3755:       // For each side in the element...
 3756:       const Side *side = elem->sides[j];
 3757: 
 3758:       const double htot = side->htot();
 3759:       const Vector2 F  = htot*fb;
 3760:       const Vector2 Fa = min(htot, veg_h)*fb;
 3761: 
 3762:       tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 3763:    } // for j
 3764: 
 3765:    //botf1 etc are already in elem frame
 3766:    elem->ghat1 += tmp/i34;
 3767: 
 3768:    // Baroclinic force
 3769:    if constexpr(ibc==0) {
 3770:       assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 3771: 
 3772:       Vector2 Fa = {0.0, 0.0};
 3773:       Vector2 intGradRho = {0.0, 0.0};
 3774:       
 3775:       // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 3776:       for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 3777:          intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 3778: 
 3779:          // \in F [m^2/s/s]
 3780:          Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 3781:       }
 3782: 
 3783:       const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 3784:       const Vector2 F = av_df*Fa; //approx
 3785:       elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 3786: 
 3787:    } // if ibc
 3788: 
 3789: }
 3790: 
 3791: 
 3792: 
 3793: #ifdef DONTCOMPILE
 3794: __global__ void checkMassConservation(Tracers* sumtr) {
 3795: 
 3796:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 3797: 
 3798:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 3799: 
 3800:    Element *elem = &(mesh->localElemData[i]);
 3801: 
 3802:    // Skip dry elements
 3803:    if (elem->idry) return;
 3804: 
 3805:    // Local sum array for this thread
 3806:    double localSum[N_TRACERS] = {0.0};
 3807: 
 3808:    // Sum over vertical levels for this element
 3809:    const int kbe = elem->kbe;
 3810:    const double area = elem->area;
 3811: 
 3812:    for (int k = kbe; k < nvrt; k++) {
 3813:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 3814:       
 3815:       // Accumulate tracer mass
 3816:       for (int tr = 0; tr < N_TRACERS; tr++) {
 3817:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 3818:       }
 3819:    }
 3820: 
 3821:    
 3822: 
 3823:    //  This function returns per element sums. A reduction must be done on the host side.
 3824: }
 3825: 
 3826: 
 3827: __global__ void transport(void) {
 3828: 
 3829:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 3830: 
 3831:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 3832: 
 3833:    Element *elem = &(mesh->localElemData[ie]);
 3834: 
 3835:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 3836: 
 3837:                for (int m=0; m<ntr; m++) {
 3838:                   for (int k=kbe(ie); k<nvrt; k++) {
 3839:                      // Calculate each polynomial's weight 
 3840:                      wm=0.d0; sum1=0.d0; 
 3841:                      wm1=0.d0; wm2=0.d0; 
 3842:                      for (int i=0; i<elem->nweno2; i++) {
 3843:                   
 3844:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3845:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3846:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3847:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3848:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3849:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 3850:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 3851:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 3852:                      // -----------------Hu and Shu (1999)'s method----------------
 3853:                      b4=b1+b2+b3
 3854: 
 3855: //Error: add PRODUCTION CPP
 3856: #ifdef DEBUG
 3857:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 3858:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 3859:                     call parallel_abort(errmsg)
 3860:                   }
 3861: #endif
 3862: 
 3863:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 3864:                   // !----test-------------- 
 3865:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 3866:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 3867:                   // !wm(i)=wm1(i)*wm2(i)
 3868:                   // !---------------------- 
 3869:                   sum1=sum1+wm(i)
 3870:                 } // end for i
 3871: 
 3872:                 wm=wm/sum1
 3873: 
 3874:                 for (int j=0; j<elem->i34; j++) {
 3875: 
 3876:                   const Side *side  = elem->sides[j];
 3877:                   const Node *node1 = side->n1;
 3878:                   const Node *node2 = side->n2;
 3879: 
 3880:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 3881:                      trsd=0.d0
 3882:                      for (int kk=0; kk<nquad; kk++) {
 3883:                         for (int i=0; i<elem->nweno2; i++) {
 3884:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3885:                         } // end for i   
 3886:                      } // end for kk
 3887:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 3888:                   } // outward flux
 3889:                } // end for j=1,i34(ie) ! side
 3890:             }
 3891:          }
