  151: // Polynomial class
  152: template<int grade>
  153: struct Polynomial {
  154:     // Static assertion to give a clear error message at compile time
  155:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  156: };
  157: 
  158: 
  159: // Explicit specialization for grade 4
  160: template<>
  161: struct Polynomial<4> {
  162:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  163: 
  164:    // Constructor from coefficients
  165:    __device__ __host__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  166: 
  167:    __device__ __host__ __forceinline__ double eval(double x) const {
  168:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  169:    }
  170: };
