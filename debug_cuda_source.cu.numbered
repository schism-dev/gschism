  629: 
  630: struct Side {
  631: 
  632:    // Geometry information
  633:    int idx;               // Index of the side
  634:    Node *n1, *n2;
  635:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  636: 
  637:    double length;         // Length of the side. Used to be called distj; but I think this name is less clear now.
  638:    Vector2 center;        // Location of side center. 
  639:    double zc[nvrt];       // Side center z-coord at each vertical level
  640:    double depth;          // Depth at side center
  641: 
  642:    Frame frame;
  643: 
  644:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  645:                           // this is nullptr
  646:    
  647:    int kb;                // Bottom index of the side
  648:    bool idry;             // True if the side is dry
  649:  
  650:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  651: 
  652:    // Physical information
  653:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  654:    double  w2[nvrt];            // Vertical velocity at each vertical level
  655:    Vector2 btu[nvrt];           // Back-tracked velocity
  656:    Vector2 uth[nvrt];           // "Time history" velocity
  657:    Vector2 U;                   // Vertically averaged velocity vector  
  658: 
  659:    Vector2 d2uv[nvrt];          // divergence of (nu*grad u) XXX COMPUTE!!
  660: 
  661:    Vector2 bcc[nvrt];           // Baroclinic term
  662: 
  663:    double hhat;                 // \breve{H} in notes
  664: 
  665:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
  666: 
  667:    double coriolis;             // Coriolis parameter
  668: 
  669:    // Vegetation parameters
  670:    double veg_c2;
  671:    double veg_beta;
  672: 
  673:    // Bottom drag parameters.
  674:    double chi;
  675:    double chi2;
  676: 
  677:    __inline__ __device__ double x(double t) const;
  678:    __inline__ __device__ double y(double t) const;
  679:    __inline__ __device__ Point2 p_t(double t) const;
  680: 
  681:    __inline__ __device__ Point3 center3D(int k) const { return {center.x, center.y, zc[k]}; }
  682:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
  683:    __inline__ __device__ double Dz(int k)       const { return zc[k] - zc[k-1]; }
  684: 
  685:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
  686: 
  687:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
  688: 
  689:    __inline__ __device__ int iadv(void) const;
  690: 
  691:    __inline__ __device__ double eta2(void) const;
  692:    __inline__ __device__ double htot(void) const { return eta2() + depth; }
  693: 
  694:    __inline__ __device__ double veg_h(void)  const;
  695:    __inline__ __device__ double veg_nv(void) const;
  696:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
  697:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
  698: 
  699:    __inline__ __device__ double Cd(void) const;
  700: 
  701:    __inline__ __device__ Vector2 tau(void) const;
  702: 
  703:    __inline__ __device__ double zb(void) const { return zc[kb]; }
  704:    
  705: 
  706:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
  707:    __inline__ __device__ double zLevelVegRatio(int k) const { 
  708:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
  709:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
  710:    } 
  711:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
  712:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot(); }
  713:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 1; }
  714:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 1; }
  715: 
  716:    // Get valid starting element (for backtracking)
  717:    __inline__ __device__ Element* getStartElement() {
  718:       return elems[0] ? elems[0] : elems[1];
  719:    }
  720: 
  721:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
  722:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
  723: 
  724:       // If one of the elements is null, return the other one
  725:       if      (elems[0] == nullptr) return elems[1];
  726:       else if (elems[1] == nullptr) return elems[0];
  727: 
  728: 
  729:       // Dot product of the negative velocity vector with the side normal vector
  730:       const double dot_prod1 = -dot(u, n);
  731:       
  732:       // Vector from side center to element 0 centroid
  733:       const Vector2 v2 = toVector2(elems[0]->center) - center;
  734: 
  735:       // Dot product of the vector with the side normal vector
  736:       const double dot_prod2 = dot(v2, n);
  737: 
  738:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
  739:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
  740: 
  741:       if (dot_prod1*dot_prod2 > 0.0) return elems[0];
  742:       else                           return elems[1];
  743: 
  744:  
  745:    }
  746: 
  747:    __forceinline__ __device__ Element* otherElem(const Element* elem) {
  748:       // Given an element, returns the other element that shares this side
  749:       return (elems[0] == elem) ? elems[1] : elems[0];
  750:    }
  751: 
  752:    __forceinline__ __device__ Node* otherNode(Node* node) {
  753:       // Given a node, returns the other node that shares this side
  754:       return (n1 == node) ? n2 : n1;
  755:    }
  756:  
  757:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, double* sclr,
  758:                                      Vector3 &u_int) const;
  759: 
  760: 
  761: 
  762: 
  763: };
  764: 
