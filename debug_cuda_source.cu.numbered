 1390: 
 1391: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1392:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1393: 
 1394:    printf("Tracking segment goes out of water at element %d\n", curElem->idx);
 1395: 
 1396:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1397:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1398:    // curElement.
 1399: 
 1400:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1401:    // And uses this velocity instead to continue the tracking.
 1402: 
 1403:    // computes the intersection point in cartesian coordinates
 1404:    Point2 intersection = nextSide->p_t(tt);
 1405: 
 1406:    // Nudges the point to the barycenter of the element. 
 1407:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1408:    // next segment intersects the element sides.  
 1409:    curElem->nudgeToBarycenter(intersection);
 1410: 
 1411:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1412:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1413:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1414:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1415: 
 1416:    // If the side is an open boundary, the tangential velocity is zero.
 1417:    if (nextSide->isBnd()) vtan = 0.0;
 1418: 
 1419:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1420:    const double us = vtan*nextSide->t().x;
 1421:    const double vs = vtan*nextSide->t().y;
 1422:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1423: 
 1424:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1425:    const double len2 = length(intersection - toPoint2(xt));
 1426:    const double vel2 = u_int.x*u_int.x + u_int.y*u_int.y;        
 1427:    assert(vel2 > 0.0 && "Zero velocity found");
 1428:    dt = dt - sqrt(len2/vel2); 
 1429: 
 1430:    // The end of this tracking segment is now the intersection point.
 1431:    xt = {intersection.x, intersection.y, zint};
 1432:    
 1433:    u_int = {us, vs, ws};
 1434:    
 1435: }
 1436: 
 1437: /**
 1438:  * Tracks a particle through elements and vertical levels in the mesh.
 1439:  * 
 1440:  * @param x0,y0,z0     Starting position coordinates
 1441:  * @param xt,yt,zt     Target position coordinates
 1442:  * @param dtb          Time step for tracking
 1443:  * @param uuint,vvint,wwint Initial velocity components
 1444:  * @param nextElem     Starting/resulting element index
 1445:  * 
 1446:  * @return Status code of type trackExitCodes
 1447:  * 
 1448:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1449:  * of the details are different. The idea is that the code requires less branches and is better fit
 1450:  * for GPU execution.
 1451:  * 
 1452:  * The main ideas here are:
 1453:  * - The starting point is expected to be in the starting element.
 1454:  * - The end point is guaranteed to be inside an element.
 1455:  * - since the starting point is inside the element, there are only two cases: 
 1456:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1457:  *     (b) it does not and (xt,yt) is already in the starting element.
 1458:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1459:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1460:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1461:  * - tt1 can be positive or negative. We only consider the positive values.
 1462:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1463:  * - The next intersection will occur at the smallest positive tt1.
 1464:  * - This intersection will be the next (x0,y0) position.
 1465:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1466:  *   of getting stuck in a loop.
 1467:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1468:  *   was found.
 1469:  */
 1470: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1471:                                                        Element *&nextElem, int &jlev, double &dt) {
 1472: 
 1473:    // First thing is to check if the target point is inside the element. If it is there is nothing
 1474:    // else to do.
 1475:    if (containsPoint(toPoint2(xt))) {
 1476:       nextElem->interpolateVelocities(xt, u_int);
 1477:       return true;
 1478:    }
 1479: 
 1480:    Side *side = nullptr;
 1481: 
 1482:    // 1. Initial checks
 1483:    // Verify starting element is valid (wet)
 1484:    assert(!nextElem->idry && "Starting element is dry");
 1485: 
 1486:    // Checks if track has a zero length.
 1487:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1488:    assert(len2 > 0.0 && "Zero length track"); 
 1489:    
 1490: 
 1491:    const int MAX_ITERATIONS = 1000;
 1492:    
 1493:    double t;
 1494:    Side *nextSide = nullptr;
 1495:    double tIntersect = 1e10;
 1496:    double zint = x0.z;
 1497: 
 1498:    // Horizontal tracking loop
 1499:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1500:    // (x0,y0) is inside the element but the target point is not.
 1501:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1502:    assert(found_intersection && "No intersection found");
 1503: 
 1504:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1505: 
 1506:    // if the tracking segment goes out of water (either dry or edge boundary)
 1507:    if (isEdgeBoundary(nextSide) || (nextElem->idry)) {
 1508:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1509:       nextElem = this;
 1510:       
 1511:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1512:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1513:       return true;    
 1514:       }
 1515: 
 1516:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1517:    int iterations = 0;
 1518:    while (iterations < MAX_ITERATIONS) {
 1519:       iterations++;
 1520:       
 1521:       Element *curElem = nextElem;
 1522: 
 1523:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1524:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1525: 
 1526:       // If we are already in the target element, we are done.
 1527:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1528:       if (!found_intersection) break;
 1529: 
 1530: 
 1531:   
 1532:       // if the tracking segment goes out of water (either dry or edge boundary).
 1533:       if (curElem->isEdgeBoundary(nextSide) || (nextElem->idry)) {
 1534: 
 1535:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1536: 
 1537:          nextElem = curElem;
 1538: 
 1539:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1540:          // In this case, the caller (btrack) needs to take into account the remaining time.
 1541:          return true;
 1542:       }
 1543:       
 1544:       // Update position and element for next iteration
 1545:       side = nextSide;
 1546: 
 1547:    }
 1548: 
 1549: 
 1550:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 1551: 
 1552:  
 1553:    // Interpolate velocities at the final position. This is a conceptually simple step,
 1554:    // but the function is not simple, because it has to search for the vertical level containing zt.
 1555:    nextElem->interpolateVelocities(xt, u_int);
 1556: 
 1557: 
 1558:    return true;
 1559: }
 1560: 
 1561: 
 1562: 
 1563: 
 1564: __inline__ __device__ double Element::computeSignedArea(void) const {
 1565:    // Compute the area of the element
 1566: 
 1567:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 1568: 
 1569:    // In the quad case we need to add the area of the other triangle.
 1570:    if (isQuad()) {
 1571:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1572:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 1573:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1574:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 1575:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 1576:          Error("Negative area found in quad element");
 1577:       }
 1578:       res += ar1;
 1579:    }
 1580: 
 1581:    return res;
 1582: }
 1583: 
 1584: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 1585:    // In boundary sides, the element 1 is nullptr
 1586:    return side->elems[1] == nullptr; 
 1587: }
 1588: 
 1589: /**
 1590:    Compute the shape coordinates of the point (xt,yt) in the element.
 1591:    @param xt (input): x-coordinate of the point
 1592:    @param shpCoords (output): shape coordinates of the point
 1593:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 1594:    @return true if the point is inside the element, false otherwise
 1595: **/
 1596: __device__ bool Element::computeShapeCoords(Point2 xt, double shpCoords[4],
 1597:                                             bool fixNegshpCoord) const {
 1598: 
 1599:    // Compute the shape coordinates of the point xt in the element.
 1600:    if (i34==3) {
 1601:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 1602:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 1603:       // and in this case, the pt will be nudged into the element
 1604:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 1605:       // from the local frame, so use additional check.
 1606: 
 1607:       Point2 x0, x1, x2;
 1608: 
 1609:       if constexpr(ics==1) {
 1610:          x0 = nodes[0]->p2();
 1611:          x1 = nodes[1]->p2();
 1612:          x2 = nodes[2]->p2();
 1613:       }
 1614:       else // lat/lon
 1615:       {
 1616:          Error("Not implemented yet");
 1617: #ifdef ICS2
 1618:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 1619:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 1620:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 1621: #endif
 1622:       }
 1623: 
 1624:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 1625:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 1626:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 1627:       shpCoords[3] = 0.0;
 1628:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 1629: 
 1630:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 1631:       // then we fix the negative shape coordinates.
 1632:       if (fixNegshpCoord && tmpmin<=0.0) {
 1633: 
 1634:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 1635:          // keeping the sum of the shape coordinates equal to 1.
 1636:          // I have tested and compared the new algorithm with the old one, and they give
 1637:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 1638:          // The new algorithm should be faster since it is branchless.
 1639:          const double a = - tmpmin + 1.0e-2;  // XXX it used to be 1.0e-4 in the comments of the original code
 1640:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 1641:          
 1642:          shpCoords[0] = (shpCoords[0] + a)*b;
 1643:          shpCoords[1] = (shpCoords[1] + a)*b;
 1644:          shpCoords[2] = (shpCoords[2] + a)*b;          
 1645: 
 1646:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 1647:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 1648:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 1649:          }
 1650: 
 1651:          // Update the point coordinates for the new shape coordinates
 1652:          double xcoords[3] = {x0.x, x1.x, x2.x};
 1653:          double ycoords[3] = {x0.y, x1.y, x2.y};
 1654:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 1655: 
 1656:       }
 1657: 
 1658:       // Check if the point is inside the element
 1659:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 1660:    }
 1661:    else {
 1662:       Error("Not implemented yet");
 1663: #ifdef QUADS
 1664:       // Reproject pt in eframe of nel for ics=2
 1665:       if constexpr(ics==1) {
 1666:          xn2 = xt; 
 1667:          yn2 = yt;
 1668:       }
 1669:       else {
 1670:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 1671:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 1672:       }
 1673: 
 1674:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 1675: #endif
 1676:    }
 1677: 
 1678: }
 1679: 
 1680: 
 1681: /**  Interpolate velocities at a given point (xt,yt,zt)
 1682: 
 1683:    @param xt, yt, zt: coordinates of the point to interpolate
 1684:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 1685: 
 1686:    This is done in four steps:
 1687: 
 1688:    1. Find the shape coordinates for the final position in the element.
 1689:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 1690:    3. Perform a *binary search* to find the vertical level containing zt. It will have to interpolate the 
 1691:       z levels at xt, yt at each step.   
 1692:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 1693:       horizontally and vertically.
 1694: **/
 1695: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) {
 1696:    // Interpolate the velocities at the point xt. 
 1697:    // This function works the same for triangular and quadrilateral elements.
 1698:    double shpCoord[4];
 1699: 
 1700: 
 1701:    // First step is to compute the shape coordinates of (xt,yt)
 1702:    computeShapeCoords(toVector2(xt), shpCoord, false);
 1703:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 1704: 
 1705:    // Second step is to find the level that contains zt
 1706:    // Uses a binary search to find the level
 1707:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 1708:    int L = kbe;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 1709:    int R = nvrt - 1;
 1710: 
 1711:    // Get the z coordinates at the nodes of the element at the levels L and R
 1712:    double zLAtNodes[4], zRAtNodes[4];
 1713:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 1714:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 1715: 
 1716:    double zL = interpolate(shpCoord, zLAtNodes);
 1717:    double zR = interpolate(shpCoord, zRAtNodes);
 1718:    
 1719:    // Interpolates vertically the velocities
 1720:    double wght1, wght2;
 1721:    if (xt.z<=zL) {
 1722:       wght1 = 1.0;
 1723:       wght2 = 0.0;
 1724:    }
 1725:    else if (xt.z>=zR) {
 1726:       wght1 = 0.0;
 1727:       wght2 = 1.0;
 1728:    }
 1729:    else {
 1730:       // Perform a binary search to find the levels between L and R that contain xt.z
 1731:       while (R - L > 1) {
 1732:          int M = (L + R) / 2;
 1733: 
 1734:          double zMAtNodes[4];
 1735:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 1736:          double zM = interpolate(shpCoord, zMAtNodes);
 1737:          if (zM < xt.z) 
 1738:          {
 1739:             L = M;
 1740:             zL = zM;
 1741:          }
 1742:          else 
 1743:          {
 1744:             R = M;
 1745:             zR = zM;
 1746:          }
 1747:       }
 1748:       assert(L == R-1);
 1749:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 1750: 
 1751:       wght2 = (xt.z - zL)/(zR - zL);
 1752:       wght1 = 1.0 - wght2;
 1753:    }
 1754: // printf("$$$ wght1 = %f, wght2 = %f, zt = %f, zL = %f, zR = %f\n", wght1, wght2, zt, zL, zR);
 1755: // printf("$$$ shpCoord = %f, %f, %f, %f\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 1756:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 1757:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 1758: 
 1759:    // Neither of the interpolated velocities should be NaN
 1760:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 1761: 
 1762: }
 1763: 
 1764: 
 1765: 
 1766: __inline__ __device__ double Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 1767: __inline__ __device__ double Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 1768: __inline__ __device__ Point2 Side::p_t(double t) const { return {x(t), y(t)}; }
 1769: __inline__ __device__ int    Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 1770: __inline__ __device__ double Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 1771: 
 1772: __inline__ __device__ double Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 1773: __inline__ __device__ double Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 1774: __inline__ __device__ double Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 1775: 
 1776: 
 1777: __inline__ __device__ double Side::Cd(void)      const { if constexpr(nchi != 0) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 1778: 
 1779: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 1780: 
 1781: /**
 1782:  * This method performs backtracking from the side center until a time -dt back in time 
 1783:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 1784:  * intermediate point.
 1785:  *
 1786:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 1787:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 1788:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 1789:  * remaining time.
 1790:  * 
 1791:  * NOTE: Runge-Kutta is not implemented yet. XXX
 1792:  * 
 1793:  * @param uuint, vvint, wwint: Velocities at the final point
 1794:  * @param jlev: Level at which the backtracking is performed
 1795:  * @param dt, dtbk: Tracking timesteps
 1796:  * @param sclr: Array for backtracked values
 1797:  * @return: True if the backtracking was successful, false otherwise
 1798:  */
 1799: __inline__ __device__ bool Side::btrack(
 1800:       int jlev,
 1801:       double dt,            // Tracking time
 1802:       double dtbk,          // Tracking timestep
 1803:       double* sclr,         // Array for backtracked values
 1804:       Vector3 &u_int
 1805: ) const {
 1806: 
 1807:    // Start from side center
 1808:    Point3 x0 = {center.x, center.y, zc[jlev]};
 1809:  
 1810: 
 1811:    double time_rm = dt; // Remaining time
 1812: 
 1813: 
 1814:    // // Initialize outputs XXX
 1815:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 1816:    //    sclr[i] = 0.0;
 1817:    // }
 1818: 
 1819: 
 1820:    // Initial velocities
 1821:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 1822: 
 1823:    // Find the element that is in the direction opposite to the velocity
 1824:    Element* curElem = findElementTowards({u_int.x, u_int.y});
 1825: 
 1826: 
 1827:    const int MAX_ITERATIONS = 1000; 
 1828:    Element* nextElem = curElem;
 1829:    int iter = 0;
 1830:    while(true) {
 1831:       // Calculate timestep
 1832:       double dtb = min(dtbk, time_rm);
 1833: 
 1834:       // Next point in the backtracking curve
 1835:       Point3 xt = x0 - dtb*u_int;
 1836: 
 1837:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb);
 1838:       assert(found && "Backtracking failed in btrack");
 1839: // printf("<>T = %f, %f %f %f\n", time_rm - dtb, xt, yt, zt);
 1840:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 1841:                       // then time_rm needs to be increased by the unused time.
 1842: 
 1843: 
 1844:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 1845: 
 1846:       // The current point becomes the next segment's starting point.
 1847:       x0 = xt;
 1848:  
 1849:       curElem = nextElem;
 1850: 
 1851:       iter++;
 1852:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 1853:    }
 1854: 
 1855: 
 1856: }
 1857: 
 1858: 
