  163: // Polynomial class
  164: template<int grade>
  165: struct Polynomial {
  166:     // Static assertion to give a clear error message at compile time
  167:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  168: };
  169: 
  170: 
  171: // Explicit specialization for grade 4
  172: template<>
  173: struct Polynomial<4> {
  174:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  175: 
  176:    // Constructor from coefficients
  177:    __device__ __host__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  178: 
  179:    __device__ __host__ __forceinline__ double eval(double x) const {
  180:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  181:    }
  182: };
