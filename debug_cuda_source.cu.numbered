  244: // ------------------------------------------------------------------------------------------------
  245: 
  246: 
  247: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  248:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  249:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  250: }
  251: 
  252: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  253:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  254:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  255: }
  256: 
  257: 
  258: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  259:    x3 = y1*z2 - y2*z1;
  260:    y3 = x2*z1 - x1*z2;
  261:    z3 = x1*y2 - x2*y1;
  262: }
  263: 
  264: 
  265: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  266: // Given a 3D global point (may not be on surface of earth), find its longitude and latitude in radians
  267: 
  268:    const double radius2 = dot(p, p);
  269:    assert(radius2 != 0.0     && "computeLonLat: radius = 0");
  270:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  271: 
  272:    rlon = atan2(p.y, p.x); // (-pi,pi]
  273: 
  274:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  275:       rlat = asin(p.z/sqrt(radius2));
  276:    } else {
  277:       rlat = asin(p.z/rearth_pole);
  278:    }
  279:   
  280: }
  281: 
  282: __inline__ __device__ void Error(const char* msg) {
  283:    printf("Error: %s\n", msg);
  284:    assert(false);
  285: }
  286: 
  287: struct Tracers {
  288:     double tracer[N_TRACERS];
  289: };
  290: 
  291: 
  292: 
  293: struct Frame {
  294:    double _t[9]; // t stands for tensor.
  295: 
  296:    // Access the tensor in Fortran order
  297:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  298: 
  299:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  300: 
  301:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  302: 
  303:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  304:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  305:       sincos(ar2, &sin_ar2, &cos_ar2);
  306: 
  307:       t(0,0) = -sin_ar1;
  308:       t(1,0) =  cos_ar1;
  309:       t(2,0) =  0.0;
  310:       t(0,1) = -cos_ar1*sin_ar2;
  311:       t(1,1) = -sin_ar1*sin_ar2;
  312: 
  313:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  314: 
  315:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  316:       assert (ar4!=0.0 && "GRID: ar4=0");
  317: 
  318:       const double ar4_inv = 1.0/ar4;
  319:       t(0,1) = t(0,1)*ar4_inv;
  320:       t(1,1) = t(1,1)*ar4_inv;
  321:       t(2,1) = t(2,1)*ar4_inv;
  322: 
  323:       // The third vector is the cross product of the first two
  324:       crossProduct(t(0,0), t(1,0), t(2,0), 
  325:                    t(0,1), t(1,1), t(2,1), 
  326:                    t(0,2), t(1,2), t(2,2));
  327:    }
  328: 
  329: 
  330:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  331:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  332:    // Inputs:
  333:    //        vec0: vel. in this frame;
  334:    //        frameout: Output frame;
  335:    // Output: 
  336:    //        vec1: vel. in new frame  
  337: 
  338:       auto const fo = frameout;
  339:       Vector2 vec1;
  340: 
  341:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  342:       // of t and fo.t are the same.
  343:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  344:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  345: 
  346:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  347:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  348: 
  349:       return vec1;
  350:    }
  351: 
  352:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  353:       // Transform a vector from global to local frame
  354:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  355:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  356:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  357:    }
  358: 
  359:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  360:       // Transform a vector from local to global frame
  361:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  362:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  363:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  364:    }   
  365: 
  366:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  367:    // Tranforms a point from global to local frame     
  368:       G2L(pi - origin0, po);
  369:    }
  370: 
  371:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  372:    // Transforms a point from local to global frame      
  373:       L2G(pi, po);
  374:       po = po + origin0;
  375:    }
  376: 
  377: };
