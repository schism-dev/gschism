 1584: 
 1585: __inline__ __device__ double Element::computeSignedArea(void) const {
 1586:    // Compute the area of the element
 1587: 
 1588:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 1589: 
 1590:    // In the quad case we need to add the area of the other triangle.
 1591:    if (isQuad()) {
 1592:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1593:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 1594:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1595:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 1596:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 1597:          Error("Negative area found in quad element");
 1598:       }
 1599:       res += ar1;
 1600:    }
 1601: 
 1602:    return res;
 1603: }
 1604: 
 1605: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 1606:    // In boundary sides, the element 1 is nullptr
 1607:    return side->elems[1] == nullptr; 
 1608: }
 1609: 
 1610: /**
 1611:    Compute the shape coordinates of the point (xt,yt) in the element.
 1612:    @param xt (input): x-coordinate of the point
 1613:    @param shpCoords (output): shape coordinates of the point
 1614:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 1615:    @return true if the point is inside the element, false otherwise
 1616: **/
 1617: __device__ bool Element::computeShapeCoords(Point2 xt, double shpCoords[4],
 1618:                                             bool fixNegshpCoord) const {
 1619: 
 1620:    // Compute the shape coordinates of the point xt in the element.
 1621:    if (i34==3) {
 1622:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 1623:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 1624:       // and in this case, the pt will be nudged into the element
 1625:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 1626:       // from the local frame, so use additional check.
 1627: 
 1628:       Point2 x0, x1, x2;
 1629: 
 1630:       if constexpr(ics==1) {
 1631:          x0 = nodes[0]->p2();
 1632:          x1 = nodes[1]->p2();
 1633:          x2 = nodes[2]->p2();
 1634:       }
 1635:       else // lat/lon
 1636:       {
 1637:          Error("Not implemented yet");
 1638: #ifdef ICS2
 1639:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 1640:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 1641:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 1642: #endif
 1643:       }
 1644: 
 1645:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 1646:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 1647:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 1648:       shpCoords[3] = 0.0;
 1649:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 1650: 
 1651:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 1652:       // then we fix the negative shape coordinates.
 1653:       if (fixNegshpCoord && tmpmin<=0.0) {
 1654: 
 1655:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 1656:          // keeping the sum of the shape coordinates equal to 1.
 1657:          // I have tested and compared the new algorithm with the old one, and they give
 1658:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 1659:          // The new algorithm should be faster since it is branchless.
 1660:          const double a = - tmpmin + 1.0e-2;  // XXX it used to be 1.0e-4 in the comments of the original code
 1661:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 1662:          
 1663:          shpCoords[0] = (shpCoords[0] + a)*b;
 1664:          shpCoords[1] = (shpCoords[1] + a)*b;
 1665:          shpCoords[2] = (shpCoords[2] + a)*b;          
 1666: 
 1667:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 1668:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 1669:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 1670:          }
 1671: 
 1672:          // Update the point coordinates for the new shape coordinates
 1673:          double xcoords[3] = {x0.x, x1.x, x2.x};
 1674:          double ycoords[3] = {x0.y, x1.y, x2.y};
 1675:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 1676: 
 1677:       }
 1678: 
 1679:       // Check if the point is inside the element
 1680:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 1681:    }
 1682:    else {
 1683:       Error("Not implemented yet");
 1684: #ifdef QUADS
 1685:       // Reproject pt in eframe of nel for ics=2
 1686:       if constexpr(ics==1) {
 1687:          xn2 = xt; 
 1688:          yn2 = yt;
 1689:       }
 1690:       else {
 1691:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 1692:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 1693:       }
 1694: 
 1695:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 1696: #endif
 1697:    }
 1698: 
 1699: }
 1700: 
 1701: 
 1702: /**  Interpolate velocities at a given point (xt,yt,zt)
 1703: 
 1704:    @param xt, yt, zt: coordinates of the point to interpolate
 1705:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 1706: 
 1707:    This is done in four steps:
 1708: 
 1709:    1. Find the shape coordinates for the final position in the element.
 1710:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 1711:    3. Perform a *binary search* to find the vertical level containing zt. It will have to interpolate the 
 1712:       z levels at xt, yt at each step.   
 1713:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 1714:       horizontally and vertically.
 1715: **/
 1716: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) {
 1717:    // Interpolate the velocities at the point xt. 
 1718:    // This function works the same for triangular and quadrilateral elements.
 1719:    double shpCoord[4];
 1720: 
 1721: 
 1722:    // First step is to compute the shape coordinates of (xt,yt)
 1723:    computeShapeCoords(toVector2(xt), shpCoord, false);
 1724:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 1725: 
 1726:    // Second step is to find the level that contains zt
 1727:    // Uses a binary search to find the level
 1728:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 1729:    int L = kbe;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 1730:    int R = nvrt - 1;
 1731: 
 1732:    // Get the z coordinates at the nodes of the element at the levels L and R
 1733:    double zLAtNodes[4], zRAtNodes[4];
 1734:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 1735:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 1736: 
 1737:    double zL = interpolate(shpCoord, zLAtNodes);
 1738:    double zR = interpolate(shpCoord, zRAtNodes);
 1739:    
 1740:    // Interpolates vertically the velocities
 1741:    double wght1, wght2;
 1742:    if (xt.z<=zL) {
 1743:       wght1 = 1.0;
 1744:       wght2 = 0.0;
 1745:    }
 1746:    else if (xt.z>=zR) {
 1747:       wght1 = 0.0;
 1748:       wght2 = 1.0;
 1749:    }
 1750:    else {
 1751:       // Perform a binary search to find the levels between L and R that contain xt.z
 1752:       while (R - L > 1) {
 1753:          int M = (L + R) / 2;
 1754: 
 1755:          double zMAtNodes[4];
 1756:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 1757:          double zM = interpolate(shpCoord, zMAtNodes);
 1758:          if (zM < xt.z) 
 1759:          {
 1760:             L = M;
 1761:             zL = zM;
 1762:          }
 1763:          else 
 1764:          {
 1765:             R = M;
 1766:             zR = zM;
 1767:          }
 1768:       }
 1769:       assert(L == R-1);
 1770:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 1771: 
 1772:       wght2 = (xt.z - zL)/(zR - zL);
 1773:       wght1 = 1.0 - wght2;
 1774:    }
 1775: // printf("$$$ wght1 = %f, wght2 = %f, zt = %f, zL = %f, zR = %f\n", wght1, wght2, zt, zL, zR);
 1776: // printf("$$$ shpCoord = %f, %f, %f, %f\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 1777:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 1778:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 1779: 
 1780:    // Neither of the interpolated velocities should be NaN
 1781:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 1782: 
 1783: }
 1784: 
