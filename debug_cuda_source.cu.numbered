 2204: 
 2205: __host__ __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2206: 
 2207: __device__ double Node::compZCoord(int k) const {
 2208:    // Computes the z coordinate at level k.
 2209:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2210:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2211:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2212:    // used 
 2213:    
 2214:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2215:       
 2216:    if (isDry)  return 0.0;
 2217: 
 2218:    if constexpr(ivcor == 2) {
 2219: 
 2220:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2221:       const int kz = mesh->kz;
 2222: 
 2223:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2224:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2225:       // once per time step/node.
 2226:       // CHECK: updateZCoordData
 2227:       if (k == kz)               return -hmod2;
 2228:       else if (k == nvrt-1)      return eta2;
 2229:       else if (k == kb)          return -depth;
 2230:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2231:       else if (k > kz) {
 2232:          const int ksig = k - kz + 1;
 2233: 
 2234:          if (hmod2 <= mesh->h_c) {
 2235:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2236:          } 
 2237:          else if (eta2 <= - mesh->h_c - (depth - mesh->h_c) * mesh->theta_f/mesh->sinh_theta_f) {
 2238:             printf("Please choose larger h_c: %f %f\n", eta2, mesh->h_c);
 2239:             Error("ZCOOR: invalid h_c\n");
 2240:          } 
 2241:          else {
 2242:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2243:                          mesh->h_c * mesh->sigma[ksig] + 
 2244:                          (hmod2 - mesh->h_c) * mesh->cs[ksig];
 2245:          }
 2246:       } else { 
 2247:          Error("ZCOOR: invalid level or coordinate system\n");
 2248:       }
 2249: 
 2250:    }
 2251:    else if constexpr(ivcor == 1) {
 2252:       if (k == kb) return -depth;
 2253:       else if (k == nvrt-1) return eta2;
 2254:       else if (k >= kb) {
 2255:             return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2256:       }
 2257:    }
 2258:    
 2259:    printf("ZCOOR: invalid level or coordinate system\n");
 2260:    return 0.0;
 2261: }
