 3971: #ifdef DONTCOMPILE
 3972: __global__ void checkMassConservation(Tracers* sumtr) {
 3973: 
 3974:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 3975: 
 3976:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 3977: 
 3978:    Element *elem = &(mesh->localElemData[i]);
 3979: 
 3980:    // Skip dry elements
 3981:    if (elem->idry) return;
 3982: 
 3983:    // Local sum array for this thread
 3984:    double localSum[N_TRACERS] = {0.0};
 3985: 
 3986:    // Sum over vertical levels for this element
 3987:    const int kbe = elem->kbe;
 3988:    const double area = elem->area;
 3989: 
 3990:    for (int k = kbe; k < nvrt; k++) {
 3991:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 3992:       
 3993:       // Accumulate tracer mass
 3994:       for (int tr = 0; tr < N_TRACERS; tr++) {
 3995:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 3996:       }
 3997:    }
 3998: 
 3999:    
 4000: 
 4001:    //  This function returns per element sums. A reduction must be done on the host side.
 4002: }
 4003: 
 4004: 
 4005: __global__ void transport(void) {
 4006: 
 4007:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 4008: 
 4009:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 4010: 
 4011:    Element *elem = &(mesh->localElemData[ie]);
 4012: 
 4013:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 4014: 
 4015:                for (int m=0; m<ntr; m++) {
 4016:                   for (int k=kbe(ie); k<nvrt; k++) {
 4017:                      // Calculate each polynomial's weight 
 4018:                      wm=0.d0; sum1=0.d0; 
 4019:                      wm1=0.d0; wm2=0.d0; 
 4020:                      for (int i=0; i<elem->nweno2; i++) {
 4021:                   
 4022:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4023:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4024:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4025:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4026:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4027:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 4028:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 4029:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 4030:                      // -----------------Hu and Shu (1999)'s method----------------
 4031:                      b4=b1+b2+b3
 4032: 
 4033: //Error: add PRODUCTION CPP
 4034: #ifdef DEBUG
 4035:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 4036:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 4037:                     call parallel_abort(errmsg)
 4038:                   }
 4039: #endif
 4040: 
 4041:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 4042:                   // !----test-------------- 
 4043:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 4044:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 4045:                   // !wm(i)=wm1(i)*wm2(i)
 4046:                   // !---------------------- 
 4047:                   sum1=sum1+wm(i)
 4048:                 } // end for i
 4049: 
 4050:                 wm=wm/sum1
 4051: 
 4052:                 for (int j=0; j<elem->i34; j++) {
 4053: 
 4054:                   const Side *side  = elem->sides[j];
 4055:                   const Node *node1 = side->n1;
 4056:                   const Node *node2 = side->n2;
 4057: 
 4058:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 4059:                      trsd=0.d0
 4060:                      for (int kk=0; kk<nquad; kk++) {
 4061:                         for (int i=0; i<elem->nweno2; i++) {
 4062:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4063:                         } // end for i   
 4064:                      } // end for kk
 4065:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 4066:                   } // outward flux
 4067:                } // end for j=1,i34(ie) ! side
 4068:             }
 4069:          }
 4070:               
 4071: 
 4072: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 4073: //             //   calculate each polynomial's weight 
 4074: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 4075: //                 wm=0.d0; sum1=0.d0
 4076: //                 do i=1,nweno1(ie) !for each polynomial
 4077: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4078: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4079: //                   b1=b1*b1+b2*b2 !smoothness indicator
 4080: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 4081: //                   wm(i)=b2
 4082: //                   sum1=sum1+b2
 4083: //                   !wm(i)=1.d0
 4084: //                   !sum1=sum1+1.d0
 4085: 
 4086: // // Error: PRODUCTION
 4087: // #ifdef DEBUG
 4088: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 4089: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 4090: //                     call parallel_abort(errmsg)
 4091: //                   endif
 4092: // #endif
 4093: 
 4094: //                 enddo !i
 4095: //                 wm=wm/sum1 !final weight
 4096: 
 4097:                 for (int j=0; j<elem->i34; j++) { // side
 4098:                   const Side *side = elem->sides[j];
 4099:                   const Node *node1 = side->n1;
 4100:                   const Node *node2 = side->n2;
 4101: 
 4102:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 4103:                     trsd=0.d0
 4104:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 4105:                       for (int i=0; i<elem->nweno1; i++) {
 4106:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 4107:                       }
 4108:                     enddo //kk
 4109:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 4110:                   } // outward flux
 4111:                 } // end for j=1,i34(ie) ! side
 4112:               } // end for k; ntr 
 4113: 
 4114:             else !simple upwind method
 4115:               do j=1,i34(ie)
 4116:                 jsj=elside(j,ie)
 4117:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 4118:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 4119:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 4120:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 4121:                   endif
 4122:                 enddo  !vertical layers
 4123:               enddo !j=1,i34(ie) ! side
 4124:             endif !order of accuracy
