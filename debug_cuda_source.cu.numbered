 2851: __device__ void computeElevationBoundaryConditions(double ramp, double time) {
 2852:    // Compute elevation essential boundary conditions 
 2853: 
 2854:    NodeBoundary *nodeBnd = NODE_BND_PTR; // A boundary node
 2855: 
 2856:    const Node *node = nodeBnd->node;
 2857:    const int iettype = nodeBnd->iettype;
 2858: 
 2859:    double eic = 0.0;
 2860:    if (nramp_elev==1) eic = nodeBnd->etaic;
 2861:    else               eic = 0.0;
 2862: 
 2863:    const double r_eic = (1.0 - ramp)*eic; 
 2864:    const double r_eth = ramp*nodeBnd->eth;
 2865:    double eta1_bar = r_eic;
 2866: 
 2867:    // Compute tide elevation
 2868:    if (iettype == 3 || iettype == 5) {
 2869:      
 2870:       // XXX IMPLEMENT TIDE THINGS
 2871:       assert(true && "Tide elevation not implemented");
 2872:       // for (int jfr=0; jfr<nbfr; jfr++) { // For all tide frequencies
 2873:       //    const int ncyc = int(amig[jfr]*time/(2.0*pi));
 2874:       //    const double arg = amig[jfr]*time - 2.0*pi*ncyc + face[jfr] - efa[i,j,jfr];
 2875:       //    eta1_bar += ramp*ff[jfr]*emo[i,j,jfr]*cos(arg);
 2876:       // } // for jfr
 2877:    } // if iettype
 2878: 
 2879:    switch (iettype) {
 2880:       case 1:
 2881:       case 2:
 2882:          nodeBnd->elbc = r_eth + r_eic;
 2883:          break;
 2884:       case 3:
 2885:          nodeBnd->elbc = eta1_bar + r_eic;
 2886:          break;
 2887:       case 4:
 2888:          nodeBnd->elbc = r_eth + r_eic;
 2889:          break;
 2890:       case 5:
 2891:          nodeBnd->elbc = r_eth + eta1_bar + r_eic;
 2892:          break;
 2893:    } // switch
 2894: 
 2895: 
 2896:    //Add inverse barometric effects
 2897:    if (iettype != 0 && inv_atm_bnd == 1) {
 2898:       nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 2899:    }
 2900: 
 2901: }
