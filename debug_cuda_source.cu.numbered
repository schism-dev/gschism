  533: 
  534: struct Side {
  535: 
  536:    // Geometry information
  537:    int idx;               // Index of the side
  538:    Node *n1, *n2;
  539:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  540: 
  541:    double length;         // Length of the side. Used to be called distj; but I think this name is less clear now.
  542:    Vector2 center;        // Location of side center. 
  543:    double zc[nvrt];       // Side center z-coord at each vertical level
  544:    double depth;          // Depth at side center
  545: 
  546:    Frame frame;
  547: 
  548:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  549:                           // this is nullptr
  550: 
  551:    
  552:    int kb;                // Bottom index of the side
  553:    bool idry;             // True if the side is dry
  554:  
  555:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  556: 
  557:    // Physical information
  558:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  559:    double  w2[nvrt];            // Vertical velocity at each vertical level
  560:    Vector2 btu[nvrt];           // Back-tracked velocity
  561:    Vector2 uth[nvrt];           // "Time history" velocity
  562:    Vector2 U;                   // Vertically averaged velocity vector   
  563: 
  564:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
  565: 
  566:    double veg_c2;
  567: 
  568:    __inline__ __device__ double x(double t) const;
  569:    __inline__ __device__ double y(double t) const;
  570:    __inline__ __device__ Point2 p_t(double t) const;
  571: 
  572:    __inline__ __device__ Point3 center3D(int k) const { return {center.x, center.y, zc[k]}; }
  573:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
  574:    __inline__ __device__ double Dz(int k)       const { return zc[k] - zc[k-1]; }
  575: 
  576:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
  577: 
  578:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
  579: 
  580:    __inline__ __device__ int iadv(void) const;
  581: 
  582:    __inline__ __device__ double eta2(void) const;
  583:    __inline__ __device__ double htot(void) const { return eta2() + depth; }
  584: 
  585:    __inline__ __device__ double veg_h(void) const;
  586:    __inline__ __device__ double veg_nv(void) const;
  587:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
  588: 
  589:    __inline__ __device__ double Cd(void) const;
  590: 
  591:    __inline__ __device__ Vector2 tau(void) const;
  592: 
  593:    __inline__ __device__ double zb(void) const { return zc[kb]; }
  594:    
  595: 
  596:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
  597:    __inline__ __device__ double zLevelVegRatio(int k) const { 
  598:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
  599:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
  600:    } 
  601:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
  602:    __inline__ __device__ bool isSubmerged(int k) const { return veg_h() < 0.99*htot(); }
  603:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 1; }
  604:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 1; }
  605: 
  606:    // Get valid starting element (for backtracking)
  607:    __inline__ __device__ Element* getStartElement() {
  608:       return elems[0] ? elems[0] : elems[1];
  609:    }
  610: 
  611:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
  612:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
  613: 
  614:       // If one of the elements is null, return the other one
  615:       if      (elems[0] == nullptr) return elems[1];
  616:       else if (elems[1] == nullptr) return elems[0];
  617: 
  618: 
  619:       // Dot product of the negative velocity vector with the side normal vector
  620:       const double dot_prod1 = -dot(u, n);
  621:       
  622:       // Vector from side center to element 0 centroid
  623:       const Vector2 v2 = toVector2(elems[0]->center) - center;
  624: 
  625:       // Dot product of the vector with the side normal vector
  626:       const double dot_prod2 = dot(v2, n);
  627: 
  628:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
  629:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
  630: 
  631:       if (dot_prod1*dot_prod2 > 0.0) return elems[0];
  632:       else                           return elems[1];
  633: 
  634:  
  635:    }
  636: 
  637:    __forceinline__ __device__ Element* otherElement(Element* elem) {
  638:       // Given an element, returns the other element that shares this side
  639:       return (elems[0] == elem) ? elems[1] : elems[0];
  640:    }
  641: 
  642:    __forceinline__ __device__ Node* otherNode(Node* node) {
  643:       // Given a node, returns the other node that shares this side
  644:       return (n1 == node) ? n2 : n1;
  645:    }
  646:  
  647:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, double* sclr,
  648:                                      Vector3 &u_int) const;
  649: 
  650: 
  651: 
  652: 
  653: };
  654: 
  655: 
  656: // This struct is used to store the boundary information for a node.
  657: struct NodeBoundary {   
  658:    BoundarySegment *segment;
  659:    
  660:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
  661:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
  662: 
  663:    double etaic;  // Elevation at nodes used for essential boundary conditions
  664:    double elbc;   // Elevation boundary condition
  665:    int iettype;   // Type of elevation boundary condition
  666:    double eth;    // Elevation time history
  667: 
  668:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
  669:       assert(index == 0 || index == 1); 
  670:       return (index == 0) ? sideBnd1 : sideBnd2; 
  671:    }
  672: };
