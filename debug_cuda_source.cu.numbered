  277: // ------------------------------------------------------------------------------------------------
  278: 
  279: 
  280: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  281:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  282:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  283: }
  284: 
  285: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  286:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  287:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  288: }
  289: 
  290: 
  291: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  292:    x3 = y1*z2 - y2*z1;
  293:    y3 = x2*z1 - x1*z2;
  294:    z3 = x1*y2 - x2*y1;
  295: }
  296: 
  297: 
  298: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  299: // Given a 3D global point (may not be on surface of earth), find its longitude and latitude in radians
  300: 
  301:    const double radius2 = dot(p, p);
  302:    assert(radius2 != 0.0     && "computeLonLat: radius = 0");
  303:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  304: 
  305:    rlon = atan2(p.y, p.x); // (-pi,pi]
  306: 
  307:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  308:       rlat = asin(p.z/sqrt(radius2));
  309:    } else {
  310:       rlat = asin(p.z/rearth_pole);
  311:    }
  312:   
  313: }
  314: 
  315: __inline__ __device__ void Error(const char* msg) {
  316:    printf("Error: %s\n", msg);
  317:    assert(false);
  318: }
  319: 
  320: struct Tracers {
  321:     double tracer[N_TRACERS];
  322: };
  323: 
  324: 
  325: 
  326: struct Frame {
  327:    double _t[9]; // t stands for tensor.
  328: 
  329:    // Access the tensor in Fortran order
  330:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  331: 
  332:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  333: 
  334:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  335: 
  336:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  337:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  338:       sincos(ar2, &sin_ar2, &cos_ar2);
  339: 
  340:       t(0,0) = -sin_ar1;
  341:       t(1,0) =  cos_ar1;
  342:       t(2,0) =  0.0;
  343:       t(0,1) = -cos_ar1*sin_ar2;
  344:       t(1,1) = -sin_ar1*sin_ar2;
  345: 
  346:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  347: 
  348:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  349:       assert (ar4!=0.0 && "GRID: ar4=0");
  350: 
  351:       const double ar4_inv = 1.0/ar4;
  352:       t(0,1) = t(0,1)*ar4_inv;
  353:       t(1,1) = t(1,1)*ar4_inv;
  354:       t(2,1) = t(2,1)*ar4_inv;
  355: 
  356:       // The third vector is the cross product of the first two
  357:       crossProduct(t(0,0), t(1,0), t(2,0), 
  358:                    t(0,1), t(1,1), t(2,1), 
  359:                    t(0,2), t(1,2), t(2,2));
  360:    }
  361: 
  362: 
  363:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  364:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  365:    // Inputs:
  366:    //        vec0: vel. in this frame;
  367:    //        frameout: Output frame;
  368:    // Output: 
  369:    //        vec1: vel. in new frame  
  370: 
  371:       auto const fo = frameout;
  372:       Vector2 vec1;
  373: 
  374:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  375:       // of t and fo.t are the same.
  376:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  377:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  378: 
  379:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  380:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  381: 
  382:       return vec1;
  383:    }
  384: 
  385:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  386:       // Transform a vector from global to local frame
  387:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  388:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  389:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  390:    }
  391: 
  392:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  393:       // Transform a vector from local to global frame
  394:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  395:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  396:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  397:    }   
  398: 
  399:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  400:    // Tranforms a point from global to local frame     
  401:       G2L(pi - origin0, po);
  402:    }
  403: 
  404:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  405:    // Transforms a point from local to global frame      
  406:       L2G(pi, po);
  407:       po = po + origin0;
  408:    }
  409: 
  410: };
