  782: // This struct is used to store the boundary information for a node.
  783: struct NodeBoundary {   
  784:    BoundarySegment *segment;
  785:    Node *node;
  786:    
  787:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
  788:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
  789: 
  790:    double etaic;  // Elevation at nodes used for essential boundary conditions
  791:    double elbc;   // Elevation boundary condition
  792:    int iettype;   // Type of elevation boundary condition
  793:    double eth;    // Elevation time history
  794: 
  795:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
  796:       assert(index == 0 || index == 1); 
  797:       return (index == 0) ? sideBnd1 : sideBnd2; 
  798:    }
  799: };
