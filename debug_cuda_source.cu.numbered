   69: // VECTOR/POINT operations ---------------------------------------------------------------------------
   70: 
   71: using Vector2 = double2; 
   72: using Vector3 = double3;
   73: using Point2  = double2;
   74: using Point3  = double3;
   75: 
   76: __device__ __host__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
   77:     return make_double2(a.x + b.x, a.y + b.y);
   78: }
   79: 
   80: __device__ __host__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
   81:     a.x += b.x;
   82:     a.y += b.y;
   83:     return a;
   84: }
   85: 
   86: __device__ __host__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
   87:     return make_double2(a.x - b.x, a.y - b.y);
   88: }
   89: 
   90: __device__ __host__ __forceinline__ double2 operator-=(double2& a, const double2& b) {
   91:     a.x -= b.x;
   92:     a.y -= b.y;
   93:     return a;
   94: }
   95: 
   96: __device__ __host__ __forceinline__ double2 operator*(const double2& v, const double s) {
   97:     return make_double2(v.x * s, v.y * s);
   98: }
   99: 
  100: __device__ __host__ __forceinline__ double2 operator*(const double s, const double2& v) {
  101:     return v * s;  // reuse the previous operator
  102: }
  103: 
  104: __device__ __host__ __forceinline__ double2 operator/(const double2& v, double s) {
  105:     return make_double2(v.x / s, v.y / s);
  106: }
  107: 
  108: __device__ __host__ __forceinline__ double length(const double2& v) {
  109:     return sqrt(v.x*v.x + v.y*v.y);
  110: }
  111: 
  112: __device__ __host__ __forceinline__ double dot(const double2& v, const double2& w) {
  113:     return v.x*w.x + v.y*w.y;
  114: }
  115: 
  116: __device__ __host__ __forceinline__ double cross(const double2& v, const double2& w) {
  117:     return v.x*w.y - v.y*w.x;
  118: }
  119: 
  120: __device__ __host__ __forceinline__ double3 operator+(const double3& a, const double3& b) {
  121:     return make_double3(a.x + b.x, a.y + b.y, a.z + b.z);
  122: }
  123: 
  124: __device__ __host__ __forceinline__ double3 operator+=(double3& a, const double3& b) {
  125:     a.x += b.x;
  126:     a.y += b.y;
  127:     a.z += b.z;
  128:     return a;
  129: }
  130: 
  131: __device__ __host__ __forceinline__ double3 operator-(const double3& a, const double3& b) {
  132:     return make_double3(a.x - b.x, a.y - b.y, a.z - b.z);
  133: }
  134: 
  135: __device__ __host__ __forceinline__ double3 operator*(const double3& v, double s) {
  136:     return make_double3(v.x * s, v.y * s, v.z * s);
  137: }
  138: 
  139: __device__ __host__ __forceinline__ double3 operator*(double s, const double3& v) {
  140:     return v * s;
  141: }
  142: 
  143: __device__ __host__ __forceinline__ double3 operator/(const double3& v, double s) {
  144:     return make_double3(v.x / s, v.y / s, v.z / s);
  145: }
  146: 
  147: __device__ __host__ __forceinline__ double dot(const double3& v, const double3& w) {
  148:     return v.x*w.x + v.y*w.y + v.z*w.z;
  149: }
  150: 
  151: __device__ __host__ __forceinline__ Vector2 toVector2(const double3& v) {
  152:     return make_double2(v.x, v.y);
  153: }
  154: 
  155: __device__ __host__ __forceinline__ double3 toVector3(const double2& v, double w) {
  156:     return make_double3(v.x, v.y, w);
  157: }
  158: 
  159: __device__ __host__ __forceinline__ Point2 toPoint2(const double3& p) {
  160:     return make_double2(p.x, p.y);
  161: }
  162: 
  163: __device__ __host__ __forceinline__ Point3 toPoint3(const double2& p, double z) {
  164:     return make_double3(p.x, p.y, z);
  165: }
