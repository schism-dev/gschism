  799: struct Node {
  800: 
  801:    // Geometry information
  802:    int idx;        // Index of the node
  803:    Node **nodes;   // pointer to the nodes that are neighbors of this node (there is no guarantee that they are connected)
  804:    int numNodes;   // number of nodes neighbors of this node
  805: 
  806:    Element **elements; // pointer to the elements that share this node
  807:    int numElements;   // number of elements that share this node
  808: 
  809:    Point3 p;
  810:    Vector3 u2[nvrt];
  811:    double znl[nvrt];
  812:    double lon, lat;
  813:    double fun_lat[ntip]; // XXXXX CHECK IF THIS MAKES SENSE
  814:    double depth;
  815: 
  816:    int kb;       // Bottom index of the node
  817: 
  818:    bool isDry;     // True if the node is dry
  819: 
  820:    int iadv;     // Advection flag
  821: 
  822:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
  823: 
  824:    // Physical information
  825:    Tracers tr_nd0[nvrt]; // Initial tracer conc. at nodes
  826: 
  827:    double rho[nvrt];     // Density
  828: 
  829:    double eta1; // Elevation at nodes at previous timestep
  830:    double eta2; // Elevation at nodes at current timestep
  831: 
  832:    double ETP;  // Earth Tidal Potential
  833: 
  834:    
  835:    double pr;    // Air pressure
  836:    double grav2; // Gravity 
  837:    
  838:    Vector2 dav;  // Depth averaged velocity
  839: 
  840:    Vector2 tau; // Wind stress vector
  841: 
  842:    // Vegetation parameters
  843:    double veg_h;
  844:    double veg_nv;
  845:    double veg_di;
  846:    double veg_Cd;
  847:    double veg_h_unbent;
  848:    double veg_di_unbent;
  849:    double veg_nv_unbent;
  850:    double veg_alpha_vert_mean;
  851:    double veg_alpha0;
  852:    double veg_alpha3D[nvrt];
  853: 
  854:    // Bottom drag parameters
  855:    double Cd;       // Bottom drag coefficient
  856:    double rough;    // Bottom roughness length
  857:    Vector2 tau_bot; // Bottom stress vector
  858: 
  859:    double bdef1; // Bottom deformation at previous timestep
  860:    double bdef2; // Bottom deformation at current timestep
  861: 
  862:    double qel; // RHS
  863: 
  864:    // Meteorological forcing
  865:    Vector2 u_air;
  866:    double p_air;
  867:    double t_air;
  868:    double q_air;
  869:    double wind_angle;  // Wind rotation angle
  870: 
  871:    __host__ __device__ void setWind(Vector2 &u) {
  872:    // Sets the wind vector taking into account the wind rotation angle
  873:    
  874:       const double dir = atan2(-u.x,-u.y);
  875:       const double speed = length(u);
  876: 
  877:       // Calculate new u and v components with added rotation angle
  878:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
  879:    }
  880: 
  881:    __host__ __device__ Point2 p2(void) const { return {p.x, p.y}; }
  882: 
  883:    __host__ __device__ double sigmaTransitionDepth(void) const;
  884: 
  885:    __inline__ __device__ double Dz(int k) const { return znl[k] - znl[k-1]; }
  886:    __inline__ __device__ double htot(void) const { return eta2 + depth; }
  887:    __inline__ __device__ double zTopCanopy(void) const { return znl[kb] + veg_h; } 
  888: 
  889:    __device__ void clearMatrixRow(void) {
  890:       // Clear the matrix row for this node
  891:       printf("NOT IMPLEMENTED: clearMatrixRow\n");
  892:    }
  893: 
  894:    __device__ void addToSparseMatrix(Node const *node, double value) {
  895:       // Add the value to the sparse matrix for this node
  896:       printf("NOT IMPLEMENTED: addToSparseMatrix\n");
  897:    }
  898: 
  899: #ifdef BACKTRACKING
  900:    __device__ void updateZCoordData() {
  901:    // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
  902: 
  903:       // Check if node is wet
  904:       isDry = (depth + eta2 <= h0);  // XXX Check if we are doing this elsewhere
  905: 
  906:       if (idry) return;
  907: 
  908:       if constexpr(ivcor == 2) {  // SZ coordinates
  909:          
  910:          // Compute bottom level index
  911:          if (depth <= mesh->h_s) {
  912:                kb = mesh->nzlevels;
  913:          } else {
  914:                kb = -1;
  915:                for (int i = 0; i < mesh->kz-1; i++) {
  916:                   if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
  917:                      kb = i;
  918:                      break;
  919:                   }
  920:                }
  921:          }
  922:       } 
  923:       else if (ivcor == 1) {  // Localized sigma
  924:          // Do nothing
  925:       }
  926: 
  927:    }
  928: #endif   
  929: 
  930:    __device__ double compZCoord(int k) const;
  931: 
  932: 
  933: 
  934: };
