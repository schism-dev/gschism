 1243: 
 1244: /**
 1245:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1246:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1247:    If the segment is completely inside the element, then it returns true.
 1248: 
 1249:    This function assumes:
 1250:    - The initial point is on a side of the element. 
 1251:    - Its position is given by parameter t in the range [0,1].
 1252:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1253:       intersects the element (elements are convex).
 1254: 
 1255:    To find the intersection point, this function does the following:
 1256:    - it finds the intersection of the line segment with all the element side lines,
 1257:       except for the one that contains the initial point.
 1258:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1259:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1260:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1261:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1262:       track segment is almost parallel to the element side line.
 1263: 
 1264:    Inputs:
 1265:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1266:    @param x2, y2: other end of the line segment
 1267: 
 1268:    Outputs:
 1269:    @param side:  side that intersects the line segment (input and output)
 1270:    @param nextElement (output): element that contains the intersection point
 1271:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1272:    @param zint (input/output): Vertical coordinate of the intersection point
 1273: 
 1274:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1275:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1276:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1277: 
 1278:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1279:    (Delta) being zero.
 1280: 
 1281:    The intersection2 point happens when:
 1282:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1283:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1284:    
 1285:    Assumption: the 4 points (including those of the side segment) are different.
 1286:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1287:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1288:    If true, (xIntersect,yIntersect) is the intersection.				
 1289:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1290: **/
 1291: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1292:                                               double &t, double& tIntersect) {
 1293: 
 1294:    double closest_intersect_t = 1e10;
 1295:    bool found_intersection = false;
 1296: 
 1297:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1298:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1299:    const Point2 x1 = side->point(t);
 1300:    
 1301: 
 1302:    Side *nextSide = nullptr;
 1303: 
 1304:    for (int i = 0; i < i34; i++) {
 1305: 
 1306:       // Element's i-th side 
 1307:       Side *side2 = sides[i];
 1308: 
 1309:       // Skip the side that contains the initial point
 1310:       if (side2 == side) continue;
 1311: 
 1312:       // (x3,y3)-(x4,y4) is the element side line
 1313:       const Point2 x3 = side2->n1->p2();
 1314:       const Point2 x4 = side2->n2->p2();
 1315: 
 1316:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1317:       const double delta = cross(x2 - x1, x3 - x4);
 1318: 
 1319:       if (delta != 0.0) {
 1320: 
 1321:          const double delta1 = cross(x3 - x1, x3 - x4);
 1322:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1323: 
 1324:          // Solves the two linear equations for tt1 and tt2
 1325:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1326:          const double tt2 = delta2/delta;
 1327: 
 1328:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1329:             closest_intersect_t = min(closest_intersect_t, tt1);
 1330:             nextSide = side2;
 1331: 
 1332:             nextElement = nextSide->otherElem(this);
 1333:             tIntersect = max(small, min(tt1, 1.0-small));
 1334:             t = tt2;
 1335: 
 1336:             found_intersection = true;
 1337:          }
 1338:       
 1339:       }
 1340: 
 1341:    }
 1342: 
 1343: 
 1344:    // found_intersection should always be true, since we checked all the sides.  
 1345:    side = nextSide;
 1346: // if (found_intersection) {
 1347: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1348: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1349: // }   
 1350:    return found_intersection;
 1351: }
 1352: 
 1353: 
 1354: 
 1355: 
 1356: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1357:                                               double &t, double& tIntersect) {
 1358: 
 1359:    double closest_intersect_t = 1e10;
 1360:    bool found_intersection = false;
 1361: 
 1362:    for (int i = 0; i < i34; i++) {
 1363: 
 1364:       Side *side2 = sides[i];
 1365: 
 1366:       // (x3,y3)-(x4,y4) is the element side line
 1367:       const Point2 x3 = side2->n1->p2();
 1368:       const Point2 x4 = side2->n2->p2();
 1369: 
 1370:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1371:       const double delta = cross(x2 - x1, x3 - x4);
 1372: 
 1373:       if (delta != 0.0) {
 1374: 
 1375:          const double delta1 = cross(x3 - x1, x3 - x4);
 1376:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1377: 
 1378:          // Solves the two linear equations for tt1 and tt2
 1379:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1380:          const double tt2 = delta2/delta;
 1381: 
 1382:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1383:             closest_intersect_t = min(closest_intersect_t, tt1);
 1384:             side = side2;
 1385:             nextElement = side->otherElem(this);
 1386:             t = tt2;
 1387:             tIntersect = max(small, min(tt1, 1.0-small));
 1388:             found_intersection = true;
 1389:          }
 1390:       
 1391:       }
 1392: 
 1393:    }
 1394: 
 1395: // if (found_intersection) {
 1396: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1397: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1398: // }
 1399: 
 1400:    // found_intersection should always be true, since we checked all the sides.  
 1401:    return found_intersection;
 1402: }
 1403: 
 1404: 
 1405: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1406:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1407: 
 1408:    printf("Tracking segment goes out of water at element %d\n", curElem->idx);
 1409: 
 1410:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1411:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1412:    // curElement.
 1413: 
 1414:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1415:    // And uses this velocity instead to continue the tracking.
 1416: 
 1417:    // computes the intersection point in cartesian coordinates
 1418:    Point2 intersection = nextSide->p_t(tt);
 1419: 
 1420:    // Nudges the point to the barycenter of the element. 
 1421:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1422:    // next segment intersects the element sides.  
 1423:    curElem->nudgeToBarycenter(intersection);
 1424: 
 1425:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1426:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1427:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1428:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1429: 
 1430:    // If the side is an open boundary, the tangential velocity is zero.
 1431:    if (nextSide->isBnd()) vtan = 0.0;
 1432: 
 1433:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1434:    const double us = vtan*nextSide->t().x;
 1435:    const double vs = vtan*nextSide->t().y;
 1436:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1437: 
 1438:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1439:    const double len2 = length(intersection - toPoint2(xt));
 1440:    const double vel2 = u_int.x*u_int.x + u_int.y*u_int.y;        
 1441:    assert(vel2 > 0.0 && "Zero velocity found");
 1442:    dt = dt - sqrt(len2/vel2); 
 1443: 
 1444:    // The end of this tracking segment is now the intersection point.
 1445:    xt = {intersection.x, intersection.y, zint};
 1446:    
 1447:    u_int = {us, vs, ws};
 1448:    
 1449: }
 1450: 
 1451: /**
 1452:  * Tracks a particle through elements and vertical levels in the mesh.
 1453:  * 
 1454:  * @param x0,y0,z0     Starting position coordinates
 1455:  * @param xt,yt,zt     Target position coordinates
 1456:  * @param dtb          Time step for tracking
 1457:  * @param uuint,vvint,wwint Initial velocity components
 1458:  * @param nextElem     Starting/resulting element index
 1459:  * 
 1460:  * @return Status code of type trackExitCodes
 1461:  * 
 1462:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1463:  * of the details are different. The idea is that the code requires less branches and is better fit
 1464:  * for GPU execution.
 1465:  * 
 1466:  * The main ideas here are:
 1467:  * - The starting point is expected to be in the starting element.
 1468:  * - The end point is guaranteed to be inside an element.
 1469:  * - since the starting point is inside the element, there are only two cases: 
 1470:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1471:  *     (b) it does not and (xt,yt) is already in the starting element.
 1472:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1473:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1474:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1475:  * - tt1 can be positive or negative. We only consider the positive values.
 1476:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1477:  * - The next intersection will occur at the smallest positive tt1.
 1478:  * - This intersection will be the next (x0,y0) position.
 1479:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1480:  *   of getting stuck in a loop.
 1481:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1482:  *   was found.
 1483:  */
 1484: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1485:                                                        Element *&nextElem, int &jlev, double &dt) {
 1486: 
 1487:    // First thing is to check if the target point is inside the element. If it is there is nothing
 1488:    // else to do.
 1489:    if (containsPoint(toPoint2(xt))) {
 1490:       nextElem->interpolateVelocities(xt, u_int);
 1491:       return true;
 1492:    }
 1493: 
 1494:    Side *side = nullptr;
 1495: 
 1496:    // 1. Initial checks
 1497:    // Verify starting element is valid (wet)
 1498:    assert(!nextElem->idry && "Starting element is dry");
 1499: 
 1500:    // Checks if track has a zero length.
 1501:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1502:    assert(len2 > 0.0 && "Zero length track"); 
 1503:    
 1504: 
 1505:    const int MAX_ITERATIONS = 1000;
 1506:    
 1507:    double t;
 1508:    Side *nextSide = nullptr;
 1509:    double tIntersect = 1e10;
 1510:    double zint = x0.z;
 1511: 
 1512:    // Horizontal tracking loop
 1513:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1514:    // (x0,y0) is inside the element but the target point is not.
 1515:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1516:    assert(found_intersection && "No intersection found");
 1517: 
 1518:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1519: 
 1520:    // if the tracking segment goes out of water (either dry or edge boundary)
 1521:    if (isEdgeBoundary(nextSide) || (nextElem->idry)) {
 1522:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1523:       nextElem = this;
 1524:       
 1525:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1526:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1527:       return true;    
 1528:       }
 1529: 
 1530:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1531:    int iterations = 0;
 1532:    while (iterations < MAX_ITERATIONS) {
 1533:       iterations++;
 1534:       
 1535:       Element *curElem = nextElem;
 1536: 
 1537:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1538:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1539: 
 1540:       // If we are already in the target element, we are done.
 1541:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1542:       if (!found_intersection) break;
 1543: 
 1544: 
 1545:   
 1546:       // if the tracking segment goes out of water (either dry or edge boundary).
 1547:       if (curElem->isEdgeBoundary(nextSide) || (nextElem->idry)) {
 1548: 
 1549:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1550: 
 1551:          nextElem = curElem;
 1552: 
 1553:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1554:          // In this case, the caller (btrack) needs to take into account the remaining time.
 1555:          return true;
 1556:       }
 1557:       
 1558:       // Update position and element for next iteration
 1559:       side = nextSide;
 1560: 
 1561:    }
 1562: 
 1563: 
 1564:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 1565: 
 1566:  
 1567:    // Interpolate velocities at the final position. This is a conceptually simple step,
 1568:    // but the function is not simple, because it has to search for the vertical level containing zt.
 1569:    nextElem->interpolateVelocities(xt, u_int);
 1570: 
 1571: 
 1572:    return true;
 1573: }
 1574: 
 1575: 
 1576: 
 1577: 
 1578: __inline__ __device__ double Element::computeSignedArea(void) const {
 1579:    // Compute the area of the element
 1580: 
 1581:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 1582: 
 1583:    // In the quad case we need to add the area of the other triangle.
 1584:    if (isQuad()) {
 1585:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1586:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 1587:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1588:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 1589:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 1590:          Error("Negative area found in quad element");
 1591:       }
 1592:       res += ar1;
 1593:    }
 1594: 
 1595:    return res;
 1596: }
 1597: 
 1598: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 1599:    // In boundary sides, the element 1 is nullptr
 1600:    return side->elems[1] == nullptr; 
 1601: }
 1602: 
 1603: /**
 1604:    Compute the shape coordinates of the point (xt,yt) in the element.
 1605:    @param xt (input): x-coordinate of the point
 1606:    @param shpCoords (output): shape coordinates of the point
 1607:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 1608:    @return true if the point is inside the element, false otherwise
 1609: **/
 1610: __device__ bool Element::computeShapeCoords(Point2 xt, double shpCoords[4],
 1611:                                             bool fixNegshpCoord) const {
 1612: 
 1613:    // Compute the shape coordinates of the point xt in the element.
 1614:    if (i34==3) {
 1615:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 1616:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 1617:       // and in this case, the pt will be nudged into the element
 1618:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 1619:       // from the local frame, so use additional check.
 1620: 
 1621:       Point2 x0, x1, x2;
 1622: 
 1623:       if constexpr(ics==1) {
 1624:          x0 = nodes[0]->p2();
 1625:          x1 = nodes[1]->p2();
 1626:          x2 = nodes[2]->p2();
 1627:       }
 1628:       else // lat/lon
 1629:       {
 1630:          Error("Not implemented yet");
 1631: #ifdef ICS2
 1632:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 1633:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 1634:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 1635: #endif
 1636:       }
 1637: 
 1638:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 1639:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 1640:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 1641:       shpCoords[3] = 0.0;
 1642:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 1643: 
 1644:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 1645:       // then we fix the negative shape coordinates.
 1646:       if (fixNegshpCoord && tmpmin<=0.0) {
 1647: 
 1648:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 1649:          // keeping the sum of the shape coordinates equal to 1.
 1650:          // I have tested and compared the new algorithm with the old one, and they give
 1651:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 1652:          // The new algorithm should be faster since it is branchless.
 1653:          const double a = - tmpmin + 1.0e-2;  // XXX it used to be 1.0e-4 in the comments of the original code
 1654:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 1655:          
 1656:          shpCoords[0] = (shpCoords[0] + a)*b;
 1657:          shpCoords[1] = (shpCoords[1] + a)*b;
 1658:          shpCoords[2] = (shpCoords[2] + a)*b;          
 1659: 
 1660:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 1661:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 1662:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 1663:          }
 1664: 
 1665:          // Update the point coordinates for the new shape coordinates
 1666:          double xcoords[3] = {x0.x, x1.x, x2.x};
 1667:          double ycoords[3] = {x0.y, x1.y, x2.y};
 1668:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 1669: 
 1670:       }
 1671: 
 1672:       // Check if the point is inside the element
 1673:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 1674:    }
 1675:    else {
 1676:       Error("Not implemented yet");
 1677: #ifdef QUADS
 1678:       // Reproject pt in eframe of nel for ics=2
 1679:       if constexpr(ics==1) {
 1680:          xn2 = xt; 
 1681:          yn2 = yt;
 1682:       }
 1683:       else {
 1684:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 1685:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 1686:       }
 1687: 
 1688:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 1689: #endif
 1690:    }
 1691: 
 1692: }
 1693: 
 1694: 
 1695: /**  Interpolate velocities at a given point (xt,yt,zt)
 1696: 
 1697:    @param xt, yt, zt: coordinates of the point to interpolate
 1698:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 1699: 
 1700:    This is done in four steps:
 1701: 
 1702:    1. Find the shape coordinates for the final position in the element.
 1703:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 1704:    3. Perform a *binary search* to find the vertical level containing zt. It will have to interpolate the 
 1705:       z levels at xt, yt at each step.   
 1706:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 1707:       horizontally and vertically.
 1708: **/
 1709: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) {
 1710:    // Interpolate the velocities at the point xt. 
 1711:    // This function works the same for triangular and quadrilateral elements.
 1712:    double shpCoord[4];
 1713: 
 1714: 
 1715:    // First step is to compute the shape coordinates of (xt,yt)
 1716:    computeShapeCoords(toVector2(xt), shpCoord, false);
 1717:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 1718: 
 1719:    // Second step is to find the level that contains zt
 1720:    // Uses a binary search to find the level
 1721:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 1722:    int L = kbe;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 1723:    int R = nvrt - 1;
 1724: 
 1725:    // Get the z coordinates at the nodes of the element at the levels L and R
 1726:    double zLAtNodes[4], zRAtNodes[4];
 1727:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 1728:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 1729: 
 1730:    double zL = interpolate(shpCoord, zLAtNodes);
 1731:    double zR = interpolate(shpCoord, zRAtNodes);
 1732:    
 1733:    // Interpolates vertically the velocities
 1734:    double wght1, wght2;
 1735:    if (xt.z<=zL) {
 1736:       wght1 = 1.0;
 1737:       wght2 = 0.0;
 1738:    }
 1739:    else if (xt.z>=zR) {
 1740:       wght1 = 0.0;
 1741:       wght2 = 1.0;
 1742:    }
 1743:    else {
 1744:       // Perform a binary search to find the levels between L and R that contain xt.z
 1745:       while (R - L > 1) {
 1746:          int M = (L + R) / 2;
 1747: 
 1748:          double zMAtNodes[4];
 1749:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 1750:          double zM = interpolate(shpCoord, zMAtNodes);
 1751:          if (zM < xt.z) 
 1752:          {
 1753:             L = M;
 1754:             zL = zM;
 1755:          }
 1756:          else 
 1757:          {
 1758:             R = M;
 1759:             zR = zM;
 1760:          }
 1761:       }
 1762:       assert(L == R-1);
 1763:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 1764: 
 1765:       wght2 = (xt.z - zL)/(zR - zL);
 1766:       wght1 = 1.0 - wght2;
 1767:    }
 1768: // printf("$$$ wght1 = %f, wght2 = %f, zt = %f, zL = %f, zR = %f\n", wght1, wght2, zt, zL, zR);
 1769: // printf("$$$ shpCoord = %f, %f, %f, %f\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 1770:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 1771:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 1772: 
 1773:    // Neither of the interpolated velocities should be NaN
 1774:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 1775: 
 1776: }
 1777: 
