 2991: 
 2992:    __global__ void computeElevationBoundaryConditions(double ramp, double time) {
 2993:       // Compute elevation essential boundary conditions 
 2994: 
 2995:       NODE_BND(nodeBnd); // Each boundary node.
 2996: 
 2997:       const Node *node = nodeBnd->node;
 2998:       const int iettype = nodeBnd->iettype;
 2999: 
 3000:       double eic = 0.0;
 3001:       if (nramp_elev==1) eic = nodeBnd->etaic;
 3002:       else               eic = 0.0;
 3003: 
 3004:       const double r_eic = (1.0 - ramp)*eic; 
 3005:       const double r_eth = ramp*nodeBnd->eth;
 3006:       double eta1_bar = r_eic;
 3007: 
 3008:       // Compute tide elevation
 3009:       if (iettype == 3 || iettype == 5) {
 3010:         
 3011:          // XXX IMPLEMENT TIDE THINGS
 3012:          assert(true && "Tide elevation not implemented");
 3013:          // for (int jfr=0; jfr<nbfr; jfr++) { // For all tide frequencies
 3014:          //    const int ncyc = int(amig[jfr]*time/(2.0*pi));
 3015:          //    const double arg = amig[jfr]*time - 2.0*pi*ncyc + face[jfr] - efa[i,j,jfr];
 3016:          //    eta1_bar += ramp*ff[jfr]*emo[i,j,jfr]*cos(arg);
 3017:          // } // for jfr
 3018:       } // if iettype
 3019: 
 3020:       switch (iettype) {
 3021:          case 1:
 3022:          case 2:
 3023:             nodeBnd->elbc = r_eth + r_eic;
 3024:             break;
 3025:          case 3:
 3026:             nodeBnd->elbc = eta1_bar + r_eic;
 3027:             break;
 3028:          case 4:
 3029:             nodeBnd->elbc = r_eth + r_eic;
 3030:             break;
 3031:          case 5:
 3032:             nodeBnd->elbc = r_eth + eta1_bar + r_eic;
 3033:             break;
 3034:       } // switch
 3035: 
 3036: 
 3037:       //Add inverse barometric effects
 3038:       if (iettype != 0 && inv_atm_bnd == 1) {
 3039:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 3040:       }
 3041: 
 3042:    }
 3043: 
 3044:    __device__ void computeVerticallyIntegratedVelocity(void) {
 3045: 
 3046:       SIDE(side);
 3047: 
 3048:       side->U = {0.0, 0.0}; 
 3049:          
 3050:       if(side->idry) return;
 3051: 
 3052:       const Node *node1 = side->n1;
 3053:       const Node *node2 = side->n2;
 3054: 
 3055:       // Vertically integrated velocity U (in ll if ics=2)
 3056:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 3057:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 3058:       }
 3059: 
 3060:    }
 3061: 
 3062:    __global__ void computeBottomDragVegetation(void) {
 3063:       // UNFINISHED. CHECK THIS:
 3064:       // How many kernels are needed? Why so many for loops?
 3065:       // Is the loop on sides needed?
 3066: 
 3067:       NODE(node);
 3068: 
 3069:       const int    kb      = node->kb;
 3070:       const double htot    = node->htot();
 3071:       const double rough   = node->rough;
 3072: 
 3073: 
 3074:       if (node->idry) {
 3075:          // Default values for dry nodes
 3076:          node->veg_alpha_vert_mean = node->veg_alpha0;
 3077:          /// XXX CHECK INDICES
 3078:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 3079:       }
 3080: 
 3081:       // Compute bottom drag Cd
 3082:       //--------------------------------
 3083: 
 3084:       // nchi = {-1, 0, 1} is the type of bottom drag.
 3085:       if (nchi==1) {
 3086: 
 3087:          bool ltmp = false; // for WBL iteration
 3088: 
 3089:          // Cdmax=-1 !max. Cd at node for this process (info only)
 3090:          // Drag at nodes
 3091:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 3092:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 3093:         
 3094:          const double rough = node->rough;
 3095:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3096:          if (node->rough == 0.0) {
 3097:             node->Cd = 0.0;
 3098: 
 3099:          } else { //roughness >0 
 3100:             
 3101:             const double bthick_ori = node->znl[kb + 1] - node->znl[kb];  // thickness of bottom bnd layer
 3102:             const double bthick = max(dzb_min, bthick_ori);
 3103: 
 3104:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 3105: 
 3106:             double tmp = 1.0/(2.5*log(bthick/rough));
 3107:             node->Cd = tmp*tmp;
 3108: 
 3109:          } // if rough
 3110: 
 3111: 
 3112:          // RECOVER THIS: XXX
 3113:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 3114:          // Output warning for WBL if iteration didn't converge
 3115: 
 3116: 
 3117:       } // nchi==1
 3118: 
 3119:       //   Bottom stress in m^2/s^2
 3120:       if (node->rho[kb + 1] >= -98.0)
 3121:       {
 3122:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 3123:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 3124:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 3125:          // !sediment erosion: this part needs more documentation
 3126:       }
 3127: 
 3128:     
 3129:       // Compute vegetation parameters
 3130:       //--------------------------------
 3131: 
 3132:       // SAV constants
 3133:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 3134:       constexpr double veg_cfpsi = 0.16;
 3135: 
 3136:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 3137:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 3138: 
 3139:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 3140:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 3141:          int kbin = 0; // bin index
 3142:          for (int k = kb; k < nvrt; k++) {
 3143:             // Computes node height above the bottom level
 3144:             const double tmp_h = node->znl[k] - node->znl[kb]; // >=0
 3145:             assert(true && "Vertical variation of vegetation not implemented");
 3146: 
 3147:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 3148:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 3149:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 3150:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 3151:             // } else {
 3152:             //    // Find the bin at which the current vertical level is
 3153:             //    while (kbin<nbins_veg_vert) {
 3154:             //       const double zn = node->znl[kbin];
 3155:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 3156:             //          break;
 3157:             //       } // if
 3158:             //       kbin++;
 3159:             //    } // while
 3160:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 3161: 
 3162:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 3163:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 3164:                
 3165:             //    // Linear interpolation of the vegetation parameters
 3166:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 3167:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 3168:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 3169:             // } // if rl10
 3170: 
 3171:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 3172: 
 3173:          } // for k
 3174: 
 3175: 
 3176:       } else { // Ganthy (iveg=2)
 3177:       //  Modify canopy height, diameter, and density
 3178: 
 3179:          // Make sure there is vegetation on this node
 3180:          if (node->veg_h_unbent > 0.0) {
 3181:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 3182: 
 3183:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 3184:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 3185:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 3186: 
 3187:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 3188:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 3189:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 3190:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 3191:          } // if veg_h_unbent
 3192: 
 3193:          for (int k = 0; k < nvrt; k++) {
 3194:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 3195:          } // for k
 3196:       
 3197: 
 3198:       } // if iveg
 3199:      
 3200:          
 3201: 
 3202:       // Compute vertical mean of veg_alpha3D
 3203:       if (iveg != 0) {
 3204:          const double ztop = node->zTopCanopy(); // Top of the canopy
 3205:          double sum1=0.0;
 3206:          double sum2=0.0;
 3207:          // Integrate over each level under the canopy...
 3208:          for (int k=kb; k<nvrt-1 && node->znl[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 3209:             const double Dz = node->Dz(k);
 3210: 
 3211:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 3212:             sum2 += Dz;
 3213: 
 3214:          } // for k
 3215: 
 3216:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 3217:          else             node->veg_alpha_vert_mean = sum1/sum2;
 3218: 
 3219:       } // if iveg
 3220: 
 3221:    }
 3222: 
 3223:    __global__ void computeVegetationAndDragParameters(void) {
 3224:       // Computes the vegetation and drag model parameters:
 3225:       // chi, \tilde\chi, beta, \breve{H}
 3226:       
 3227:       SIDE(side);
 3228: 
 3229:       const double htot = side->htot();
 3230:       const int    kb   = side->kb;
 3231: 
 3232:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 3233: 
 3234:       const double veg_h     = side->veg_h();
 3235:       const double veg_nv    = side->veg_nv();
 3236:       const double veg_c     = side->veg_c();
 3237:       const double veg_beta  = side->veg_beta;
 3238:       const double veg_alpha = side->veg_alpha_vert_mean();
 3239: 
 3240:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 3241:       // Velocity magnitude at the bottom level
 3242:       // XXXX Check if we have add -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 3243:       assert(true && "Must use backtracked velocity");
 3244:       const double vmag1 = length(side->u2[kb + 1]); //BACKTRACKED VELOCITY
 3245:       side->chi2 = side->Cd()*vmag1;
 3246:       side->chi  = side->chi2;
 3247:       if constexpr(iveg != 0) {
 3248:          const Node *n1 = side->n1;
 3249:          const Node *n2 = side->n2;
 3250:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 3251:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 3252:       }
 3253: 
 3254:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 3255: 
 3256:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 3257:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 3258:       double magUa = 0.0;
 3259:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 3260:          // 3D wet side with veg...
 3261: 
 3262:          double magUa = 0.0;
 3263:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 3264:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 3265: 
 3266:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 3267:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 3268:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 3269: 
 3270:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 3271:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 3272: 
 3273:                // Velocity magnitude at the bottom (l) of the level
 3274:                const double ul = length(side->u2[k]);
 3275: 
 3276:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 3277:                magUa += Dz*0.5*(uh + ul);
 3278: 
 3279:             } // if HasVegetation
 3280:          } // for k
 3281:          const double ua = magUa/min(htot, veg_h); // Vertical average
 3282: 
 3283:          // Computes beta, used for computing the stress term at the top of the canopy.      
 3284:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 3285:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 3286:             const double zCpy = side->zTopCanopy();
 3287:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 3288:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 3289:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 3290:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 3291:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 3292:          } // if isSubmerged
 3293:       } // if iveg   
 3294: 
 3295:       // Computes the friction modified depth, \breve{H} in notes
 3296:       if (side->is2D()) { // 2D
 3297: 
 3298:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 3299:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 3300: 
 3301:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 3302: 
 3303:          side->hhat = htot*htot/fricH; 
 3304: 
 3305:       } else { // 3D
 3306:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 3307: 
 3308:          if constexpr(iveg != 0) {
 3309:             
 3310:             if (side->isSubmerged()) { 
 3311:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 3312:                side->hhat -= veg_c*Hhat_alpha;
 3313: 
 3314:             } else { // Emergent
 3315:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 3316:             }
 3317:          } // if iveg
 3318: 
 3319:          // Enforce positivity for 3D model
 3320:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 3321:       } // if 3D
 3322: 
 3323:         
 3324:    }
 3325: 
 3326: 
 3327: 
 3328:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 3329:    // Computes the density gradient between two elements, e1 and e2.
 3330:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 3331:    // zero in the direction normal to the side. 
 3332:    // 
 3333:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 3334:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 3335:    //
 3336:    // Input:
 3337:    //    e1: Element
 3338:    //    e2: Neighbor element (or nullptr if boundary)
 3339:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 3340:    //    k: Index of the half-level at which the density is interpolated
 3341:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 3342:    // 
 3343:    // Output:
 3344:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 3345:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 3346: 
 3347:       if (e2 == nullptr || e2->idry) {
 3348:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 3349: 
 3350:          Side *side = e1->sides[j];
 3351:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->idry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 3352:                  
 3353:          if constexpr(ics == 1) {
 3354:             vec = side->n; // Normal vector to the side
 3355:          } else {
 3356:             // IMPLEMENT THIS XXXXXX
 3357:             // !replace with xel, yel?
 3358:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 3359:             //      &eframe(:,:,i),xn1,yn1,tmp)
 3360:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 3361:             //      &eframe(:,:,i),xn2,yn2,tmp)
 3362:          } //ics
 3363:                    
 3364:          diffRho = 0.0;
 3365: 
 3366:       } else { //internal and wet
 3367:          if constexpr(ics==1) {
 3368:             assert(e2 != nullptr || e2->idry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 3369: 
 3370:             // Vector from e1 to e2
 3371:             vec = toVector2(e2->center - e1->center);
 3372: 
 3373:          } else { 
 3374:             // IMPLEMENT THIS XXXXXX
 3375:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 3376:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 3377:             //                   alow(j)=xctr2
 3378:             //                   bdia(j)=yctr2
 3379:          } // ics
 3380: 
 3381:          diffRho = rho2 - e1->demeanedDensity(k);
 3382:       }
 3383: 
 3384:    }
 3385: 
 3386:    __global__ void computeDensityCubicSplines(void) {
 3387:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 3388: 
 3389:       ELEM(elem);
 3390: 
 3391:       if (elem->idry) return;
 3392: 
 3393:       const int kb = elem->kb;
 3394: 
 3395:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 3396:       if (elem->is2D()) {
 3397:          // In the 2D case, the density is constant at the prism level. 
 3398:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 3399:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 3400:       } else { //3D
 3401: 
 3402:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 3403:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 3404:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 3405:          ///// XXXX CHECK INDICES!!!!!
 3406:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 3407:       } // 2D/3D
 3408: 
 3409:    }
 3410: } // extern "C"
 3411: 
 3412: 
 3413: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 3414: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 3415: 
 3416:    if (elem2 == nullptr || elem2->idry) return 0.0;
 3417: 
 3418:    const int kb  = elem->kb;
 3419:    const int kb2 = elem2->kb;
 3420: 
 3421:    // z-coordinate of prism of elem
 3422:    const double zp = elem->z_prism(k);
 3423: 
 3424:    double rho = 0.0;
 3425: 
 3426:    if (elem2->is2D()) {
 3427:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 3428: 
 3429:    } else {  // 3D
 3430: 
 3431:       // eta_min may be < zmax
 3432:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 3433:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 3434: 
 3435:       // (Extrapolate density below bottom, we will fix it later)
 3436:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 3437:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 3438:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 3439:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 3440:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 3441:    } // 2D/3D
 3442:      
 3443: 
 3444:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 3445:    // Now we need to fix it.
 3446:    if (elem->z[k] < elem2->z[kb2]) {
 3447:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 3448: 
 3449:       // There are two methods to adjust the density at the bottom of the element.
 3450:       // iunder_deep=0: 
 3451:       const double depth1 = abs(elem->z[kb]); // larger depth
 3452: 
 3453:       if (iunder_deep==0) {
 3454: 
 3455:          const double weight = max(0.0, min(1.0, (depth1 - h1_bcc)/(h2_bcc - h1_bcc))); // weight
 3456: 
 3457:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 3458: 
 3459:       } else { // iunder_deep != 0
 3460: 
 3461:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 3462: 
 3463:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 3464: 
 3465:          //   Demeaned density at the same z coordinate as
 3466:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 3467:          }
 3468: 
 3469:       } // if iunder_deep
 3470:    } // if elem->z[kb] < elem2->z[kb]
 3471: 
 3472:    return rho;
 3473: }
 3474: 
 3475: 
 3476: extern "C" {
 3477:    __global__ void computeDensityGradient(void) {
 3478: 
 3479:          // Compute the horizontal density gradient at each element.
 3480:       // It works in two steps:
 3481:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 3482:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 3483:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 3484:       //             gradRho.r1 = rho1 - rho0
 3485:       //             gradRho.r2 = rho2 - rho0
 3486:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 3487:       // 
 3488:       //  NOTE: We use de-meaned densities.
 3489: 
 3490:       ELEM(elem);
 3491: 
 3492:       if (elem->idry) return;
 3493: 
 3494:       const int kb  = elem->kb;
 3495:       const int i34 = elem->i34;
 3496: 
 3497:       for (int k = kb + 1; k < nvrt; k++) {
 3498:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 3499:          //             gradRho.r1 = rho1 - rho0
 3500:          //             gradRho.r2 = rho2 - rho0
 3501:          int icount = 0;
 3502:          double sumRx = 0.0;
 3503:          double sumRy = 0.0;
 3504:          for (int j1=0; j1<i34; j1++) { 
 3505: 
 3506:             const int j2 = elem->nxq(j1 + 1);
 3507: 
 3508:             // Pairs of consecutive neighbor elements of elem
 3509:             const Element *e1 = elem->nghbElems[j1];
 3510:             const Element *e2 = elem->nghbElems[j2];
 3511: 
 3512:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 3513:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 3514:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 3515: 
 3516:             // Compute the density difference and the vector from elem to e1 and e2
 3517:             // getRhoDiffAndVec takes into account boundaries/dry elements
 3518:             double diffRho1, diffRho2;
 3519:             Vector2 vec1, vec2;
 3520:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 3521:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 3522: 
 3523:             const double rl1 = length(vec1);
 3524:             const double rl2 = length(vec2);
 3525:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 3526: 
 3527:             const double delta = cross(vec1, vec2);
 3528:             const double sintheta = abs(delta)/(rl1*rl2);
 3529: 
 3530:             // To avoid problems, avoid elements with small angle between vectors
 3531:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 3532:             const bool validEq = (sintheta > sin_one_deg);
 3533: 
 3534:             if (validEq) {
 3535:                // Solve the system of equations to get the density gradient at elem
 3536:                icount++;
 3537:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 3538:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 3539:                sumRx += Rx;
 3540:                sumRy += Ry;
 3541:             }
 3542:          } // for j1
 3543: 
 3544:          // Compute the average density gradient at elem
 3545:          if (icount==0) {
 3546:            // Bad mesh quality; bail out with 0 b-cc
 3547:            elem->gradRho[k] = {0.0, 0.0};
 3548:          } else {
 3549:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 3550:          }
 3551: 
 3552:       } // for k
 3553: 
 3554:    }
 3555: 
 3556:    __global__ void computeBaroclinicTerm(double rampbc) {
 3557:    // Computes the baroclinic term at sides (at half levels).
 3558:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 3559:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 3560: 
 3561:       SIDE(side);
 3562: 
 3563:       if (side->idry == 1) return;
 3564: 
 3565:       const Element *e1 = side->elems[0];
 3566:       const Element *e2 = side->elems[1];      
 3567:       const int kb = side->kb;
 3568:       
 3569:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 3570: 
 3571:       // interpolates vertically the density gradient of the two elements at the half level/
 3572: 
 3573:       // Starts the integration at the surface and goes down to the bottom
 3574:       int k1 = nvrt - 1;
 3575:       int k2 = nvrt - 1;
 3576: 
 3577:       side->bcc[nvrt-1] = {0.0, 0.0};
 3578:       for (int k = nvrt-1; k >= kb; k--) {
 3579:       // For each prism level (from surface to bottom)...
 3580: 
 3581:          // For both elements, interpolate density gradient at the side's half level.
 3582:          // The gradient at the side is the average of the gradients at the elements.
 3583:          // w1, w2 are used to take into account boundary sides, with just one element.
 3584:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 3585:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 3586:          w1 = w1/(w1 + w2);
 3587:          w2 = w2/(w1 + w2);
 3588: 
 3589:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 3590: 
 3591:          // Linear interpolation of both elements' density gradient at the shared side's level.
 3592:          Vector2 gradRho = {0.0, 0.0};
 3593:          if (e1 != nullptr && k > kb) {
 3594:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 3595:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 3596:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 3597:             
 3598:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 3599:          }      
 3600:          if (e2 != nullptr && k > kb) {
 3601:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 3602:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 3603:             
 3604:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 3605:          }
 3606: 
 3607:          if constexpr(ics==2) {
 3608:             // IMPLEMENT THIS XXXXXX
 3609:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 3610:             // swild(1)=tmp1
 3611:             // swild(2)=tmp2
 3612:          }
 3613:          
 3614:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 3615:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 3616:          // CHECK INDICES!!! XXX
 3617:          const double grav3 = 0.5*(side->n1->grav2 + side->n2->grav2);
 3618:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 3619:       } // for
 3620: 
 3621:    }
 3622: 
 3623: } // extern "C"
 3624: 
 3625: #ifdef DONTCOMPILE
 3626: __device__ void computeVerticalAdvection(void) {
 3627:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 3628: 
 3629:    sdbt(1:2,:,:)=0.d0
 3630: 
 3631:    const Side *side = FROM kernel;
 3632: 
 3633:    if(side->idry) return;
 3634: 
 3635:    // If side is wet...
 3636: 
 3637: 
 3638:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 3639:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 3640:    double ws[nvrt] = {} // w @ side
 3641:    int icount = 0;
 3642:    for (int j=0; j<2; j++) {
 3643:       const Element *elem = side->elements[j];
 3644:        
 3645:       if(elem != nullptr) {
 3646:          icount++;
 3647:          for (int k=0; k<nvrt; k++) {
 3648:             ws[k] = ws[k] + elem->w[k];
 3649:          }
 3650:       }
 3651:    }  // for j
 3652: 
 3653:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 3654:    ws = ws/icount;
 3655: 
 3656:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 3657:    // Splines allow for a smooth transition between vertical levels.
 3658:    // Splines have continuity restrictions at the internal knots, but
 3659:    // we have to provide the 1st derivatives at the endpoints.
 3660:    const int kbs = side->kbs; 
 3661:    
 3662:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3663:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3664:    initCubicSpline(kbs, nvrt, side, ws, up)
 3665: 
 3666:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3667:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3668:    initCubicSpline(kbs, nvrt, side, ws, vp)
 3669: 
 3670:    // Total advection (average onto side)
 3671:    const Node *node1 = side->nodes[0];
 3672:    const Node *node2 = side->nodes[1];
 3673:    for (int k=kbs(i); k<nvrt; k++) {
 3674: 
 3675:       if constexpr(ics==1) {
 3676:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 3677:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 3678:       } else {
 3679:          // XXX IMPLEMENT THIS
 3680:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 3681:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 3682:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 3683:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 3684:       }  // if ics
 3685: 
 3686: 
 3687:    }
 3688: }
 3689: #endif
 3690: 
 3691: 
 3692: extern "C" {
 3693:    __global__ void computeElemAverageGhat(double rampbc) {
 3694:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 3695: 
 3696:       ELEM(elem);
 3697:       
 3698:       elem->ghat1= {0.0, 0.0};  
 3699: 
 3700:       if constexpr(ihydraulics != 0) {
 3701:          if (nhtblocks > 0 && elem->isblock) return;
 3702:       }
 3703: 
 3704:       if (elem->idry == 1) return;
 3705: 
 3706:       // Wet elements.
 3707:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 3708:       // tidal potential, horizontal diffusion, and baroclinic etc
 3709:       // Remember to update both fb and F 
 3710:       // If ics=2, ghat1 are in eframe (ll)
 3711:       // cff1-3: coefficients for 2D/3D
 3712:       Vector2 gradEta = {0.0, 0.0};  // \nabla \eta
 3713:       Vector2 gradPr  = {0.0, 0.0};  // \nabla pressure
 3714:       Vector2 gradEtp = {0.0, 0.0};  // \nabla etp
 3715: 
 3716:       double av_cff1 = 0.0;  // av. for cff1
 3717:       double av_cff2 = 0.0;  // av. for cff2
 3718:       double av_cff3 = 0.0;  // av. for cff3
 3719:       double av_df = 0.0;  // av. for H^\alpha / H
 3720:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 3721:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 3722: 
 3723:       const int i34 = elem->i34;
 3724:       const int kb = elem->kb;
 3725: 
 3726:       for (int j=1; j<i34; j++) {
 3727:          // For each node and side in the element...
 3728: 
 3729:          const Node *node = elem->nodes[j];
 3730:          const Side *side = elem->sides[j];
 3731: 
 3732:          const double chi      = side->chi;
 3733:          const double veg_c2   = side->veg_c2;
 3734:          const double veg_beta = side->veg_beta;
 3735:          const double veg_h    = side->veg_h();
 3736:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 3737: 
 3738:          // Node - const in elem
 3739:          gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 3740:          gradPr  += node->pr  *elem->gradPhi[j];
 3741: 
 3742:          if (elem->depth >= tip_dp) {
 3743:            gradEtp += node->etp*elem->gradPhi[j];
 3744:          }
 3745: 
 3746:          
 3747:          const double htot  = side->htot();        // Total depth at the side
 3748:          const double zctr2 = side->zTopCanopy();  
 3749: 
 3750:          double cff1; 
 3751:          double cff2; 
 3752:          double cff3;   
 3753:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 3754:          // coefficients applied to 2D/3D case 
 3755:             cff1 = side->hhat/htot;
 3756:             cff2 = 0.0;
 3757:             cff3 = 0.0;
 3758:          } else { //3D
 3759:             //Init for no-veg case
 3760:             cff1 = 1.0;
 3761:             cff2 = 1.0;
 3762:             cff3 = 0.0;
 3763: 
 3764:             if constexpr(iveg != 0) {
 3765:                // Computes coefficients used with vegetation terms G1, G2
 3766:                // cff1, cff3 are used for the first two terms in G1, G2:
 3767:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 3768:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 3769:                // In general, cff1*Ustar - cff3*Ustar_alpha
 3770:                if(veg_h < 0.99*htot) { // submergent vegetation
 3771:                   cff1=1;
 3772:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 3773:                   cff3 = veg_c;
 3774: 
 3775:                } else { // emergent vegetation
 3776:                   cff1 = 1.0/(1.0 + veg_c2);
 3777:                   cff2 = cff1;
 3778:                   cff3 = 0.0;
 3779: 
 3780:                }
 3781:             } // if iveg
 3782:          } //  2D/3D
 3783: 
 3784:          av_cff1 += cff1/i34;
 3785:          av_cff2 += cff2/i34;
 3786:          av_cff3 += cff3/i34;
 3787:          av_cff2_chi += cff2*chi/i34;
 3788:          av_cff3_chi += cff3*chi/i34;
 3789:          av_df += min(htot, veg_h)/(htot*i34);
 3790: 
 3791: 
 3792:          // btrack values: U^\star, U^{\star\alpha}
 3793:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 3794:          Vector2 Ustar       = {0.0, 0.0}; 
 3795:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 3796:          for (int k = side->kb; k < nvrt; k++) {
 3797:             if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 3798:                Ustar += side->btu[nvrt]*side->Dz(k);
 3799: 
 3800:             } else { //3D
 3801:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 3802:                Ustar += w2;
 3803: 
 3804:                if constexpr(iveg != 0) {
 3805:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 3806:                        const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k)); // For the top of the canopy, ratio of the level that is below the canopy
 3807:                        Ustar_alpha += zrat*w2; // XXXX
 3808:                    }
 3809:                }  // if iveg
 3810:             }  //2/3D
 3811:          }  //k
 3812:          
 3813: 
 3814:          // Add btrack & surface stress terms to \breve{G} first
 3815:          if constexpr(ics==1) {
 3816:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 3817:          } else {
 3818:             // XXX IMPLEMENT THIS
 3819:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 3820:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 3821:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 3822:          }  // if ics
 3823: 
 3824:          // Surface and bottom stress terms
 3825:          if constexpr(ics==1) {
 3826:             const Vector2 tau    = side->tau();
 3827:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 3828: 
 3829:             // Term for surface and bottom stress
 3830:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 3831:          } else {
 3832:             // XXX IMPLEMENT THIS
 3833:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 3834:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 3835:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 3836:             // tau_x=(vn1+tt1)/2.d0
 3837:             // tau_y=(vn2+ss1)/2.d0
 3838:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 3839:          }  // if ics
 3840: 
 3841:          
 3842: 
 3843:          // All terms in F,F^\alpha,f_b except baroclinic
 3844:          // F, f_b: all explicit terms excluding vegetation 
 3845:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 3846:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 3847:          const double coriolis = side->coriolis;
 3848:          Vector2 F  =  coriolis*side->U;  // F_x
 3849:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 3850:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 3851: 
 3852:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 3853:             
 3854:             for (int k = side->kb; k < nvrt; k++) {
 3855:                if (zctr2 > side->zc[k-1]) {
 3856:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 3857:                    const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 3858:                    Fa +=  coriolis*w2*zrat;
 3859:                } // if zctr2
 3860:             } // k
 3861:          } // iveg
 3862: 
 3863:          // Integrate horizontal viscosity force vertically
 3864:          for (int k=side->kb + 1; k<nvrt; k++) {
 3865:             const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.0; 
 3866: 
 3867:             F += levelHorVisc;
 3868: 
 3869:             // Vegetation term
 3870:             if constexpr(iveg!=0) {
 3871:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 3872:                   const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 3873:                   Fa += levelHorVisc*zrat;
 3874:                } 
 3875:             } // if iveg
 3876:          } // for k
 3877: 
 3878:          fb += side->d2uv[side->kb];
 3879: 
 3880: 
 3881:          // Add to ghat1
 3882:          if constexpr(ics==2) {
 3883:             // XXX IMPLEMENT THIS
 3884:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 3885:             // bigf1=vn1; bigf2=vn2
 3886:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 3887:             // botf1=vn1; botf2=vn2
 3888:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 3889:             // bigfa1=vn1; bigfa2=vn2
 3890:          } // if ics
 3891: 
 3892:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 3893:       } // for j (nodes and sides)
 3894: 
 3895:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 3896:          
 3897:       // Finish off terms in F, F^\alpha and f_b
 3898:       const double grav3 = elem->mean(&Node::grav2);
 3899:       const Vector2 fb = grav3*gradEtp - gradPr/rho0; //const in each elem
 3900: 
 3901: 
 3902:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 3903:       for (int j=1; j<i34; j++) { 
 3904:          // For each side in the element...
 3905:          const Side *side = elem->sides[j];
 3906:          const double chi = side->chi;
 3907: 
 3908:          const double htot = side->htot();
 3909:          const double veg_h = side->veg_h();
 3910:          const Vector2 F  = htot*fb;
 3911:          const Vector2 Fa = min(htot, veg_h)*fb;
 3912: 
 3913:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 3914:       } // for j
 3915: 
 3916:       //botf1 etc are already in elem frame
 3917:       elem->ghat1 += tmp/i34;
 3918: 
 3919:       // Baroclinic force
 3920:       if constexpr(ibc==0) {
 3921:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 3922: 
 3923:          Vector2 Fa = {0.0, 0.0};
 3924:          Vector2 intGradRho = {0.0, 0.0};
 3925:          
 3926:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 3927:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 3928:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 3929: 
 3930:             // \in F [m^2/s/s]
 3931:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 3932:          }
 3933: 
 3934:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 3935:          const Vector2 F = av_df*Fa; //approx
 3936:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 3937: 
 3938:       } // if ibc
 3939: 
 3940:    }
 3941: 
 3942: } // extern "C"
 3943: 
 3944: 
 3945: 
 3946: #ifdef DONTCOMPILE
 3947: __global__ void checkMassConservation(Tracers* sumtr) {
 3948: 
 3949:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 3950: 
 3951:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 3952: 
 3953:    Element *elem = &(mesh->localElemData[i]);
 3954: 
 3955:    // Skip dry elements
 3956:    if (elem->idry) return;
 3957: 
 3958:    // Local sum array for this thread
 3959:    double localSum[N_TRACERS] = {0.0};
 3960: 
 3961:    // Sum over vertical levels for this element
 3962:    const int kbe = elem->kbe;
 3963:    const double area = elem->area;
 3964: 
 3965:    for (int k = kbe; k < nvrt; k++) {
 3966:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 3967:       
 3968:       // Accumulate tracer mass
 3969:       for (int tr = 0; tr < N_TRACERS; tr++) {
 3970:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 3971:       }
 3972:    }
 3973: 
 3974:    
 3975: 
 3976:    //  This function returns per element sums. A reduction must be done on the host side.
 3977: }
 3978: 
 3979: 
 3980: __global__ void transport(void) {
 3981: 
 3982:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 3983: 
 3984:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 3985: 
 3986:    Element *elem = &(mesh->localElemData[ie]);
 3987: 
 3988:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 3989: 
 3990:                for (int m=0; m<ntr; m++) {
 3991:                   for (int k=kbe(ie); k<nvrt; k++) {
 3992:                      // Calculate each polynomial's weight 
 3993:                      wm=0.d0; sum1=0.d0; 
 3994:                      wm1=0.d0; wm2=0.d0; 
 3995:                      for (int i=0; i<elem->nweno2; i++) {
 3996:                   
 3997:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3998:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3999:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4000:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4001:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4002:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 4003:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 4004:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 4005:                      // -----------------Hu and Shu (1999)'s method----------------
 4006:                      b4=b1+b2+b3
 4007: 
 4008: //Error: add PRODUCTION CPP
 4009: #ifdef DEBUG
 4010:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 4011:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 4012:                     call parallel_abort(errmsg)
 4013:                   }
 4014: #endif
 4015: 
 4016:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 4017:                   // !----test-------------- 
 4018:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 4019:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 4020:                   // !wm(i)=wm1(i)*wm2(i)
 4021:                   // !---------------------- 
 4022:                   sum1=sum1+wm(i)
 4023:                 } // end for i
 4024: 
 4025:                 wm=wm/sum1
 4026: 
 4027:                 for (int j=0; j<elem->i34; j++) {
 4028: 
 4029:                   const Side *side  = elem->sides[j];
 4030:                   const Node *node1 = side->n1;
 4031:                   const Node *node2 = side->n2;
 4032: 
 4033:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 4034:                      trsd=0.d0
 4035:                      for (int kk=0; kk<nquad; kk++) {
 4036:                         for (int i=0; i<elem->nweno2; i++) {
 4037:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4038:                         } // end for i   
 4039:                      } // end for kk
 4040:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 4041:                   } // outward flux
 4042:                } // end for j=1,i34(ie) ! side
 4043:             }
 4044:          }
 4045:               
 4046: 
 4047: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 4048: //             //   calculate each polynomial's weight 
 4049: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 4050: //                 wm=0.d0; sum1=0.d0
 4051: //                 do i=1,nweno1(ie) !for each polynomial
 4052: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4053: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4054: //                   b1=b1*b1+b2*b2 !smoothness indicator
 4055: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 4056: //                   wm(i)=b2
 4057: //                   sum1=sum1+b2
 4058: //                   !wm(i)=1.d0
 4059: //                   !sum1=sum1+1.d0
 4060: 
 4061: // // Error: PRODUCTION
 4062: // #ifdef DEBUG
 4063: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 4064: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 4065: //                     call parallel_abort(errmsg)
 4066: //                   endif
 4067: // #endif
 4068: 
 4069: //                 enddo !i
 4070: //                 wm=wm/sum1 !final weight
 4071: 
 4072:                 for (int j=0; j<elem->i34; j++) { // side
 4073:                   const Side *side = elem->sides[j];
 4074:                   const Node *node1 = side->n1;
 4075:                   const Node *node2 = side->n2;
 4076: 
 4077:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 4078:                     trsd=0.d0
 4079:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 4080:                       for (int i=0; i<elem->nweno1; i++) {
 4081:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 4082:                       }
 4083:                     enddo //kk
 4084:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 4085:                   } // outward flux
 4086:                 } // end for j=1,i34(ie) ! side
 4087:               } // end for k; ntr 
 4088: 
 4089:             else !simple upwind method
 4090:               do j=1,i34(ie)
 4091:                 jsj=elside(j,ie)
 4092:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 4093:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 4094:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 4095:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 4096:                   endif
 4097:                 enddo  !vertical layers
 4098:               enddo !j=1,i34(ie) ! side
 4099:             endif !order of accuracy
 4100: 
 4101:          //  enddo !ie
 4102: // !$OMP     end do
