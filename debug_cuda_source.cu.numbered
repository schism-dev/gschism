 2961: extern "C" {
 2962:    __global__ void computeElevationBoundaryConditions(double ramp, double time) {
 2963:       // Compute elevation essential boundary conditions 
 2964: 
 2965:       NODE_BND(nodeBnd); // Each boundary node.
 2966: 
 2967:       const Node *node = nodeBnd->node;
 2968:       const int iettype = nodeBnd->iettype;
 2969: 
 2970:       double eic = 0.0;
 2971:       if (nramp_elev==1) eic = nodeBnd->etaic;
 2972:       else               eic = 0.0;
 2973: 
 2974:       const double r_eic = (1.0 - ramp)*eic; 
 2975:       const double r_eth = ramp*nodeBnd->eth;
 2976:       double eta1_bar = r_eic;
 2977: 
 2978:       // Compute tide elevation
 2979:       if (iettype == 3 || iettype == 5) {
 2980:         
 2981:          // XXX IMPLEMENT TIDE THINGS
 2982:          assert(true && "Tide elevation not implemented");
 2983:          // for (int jfr=0; jfr<nbfr; jfr++) { // For all tide frequencies
 2984:          //    const int ncyc = int(amig[jfr]*time/(2.0*pi));
 2985:          //    const double arg = amig[jfr]*time - 2.0*pi*ncyc + face[jfr] - efa[i,j,jfr];
 2986:          //    eta1_bar += ramp*ff[jfr]*emo[i,j,jfr]*cos(arg);
 2987:          // } // for jfr
 2988:       } // if iettype
 2989: 
 2990:       switch (iettype) {
 2991:          case 1:
 2992:          case 2:
 2993:             nodeBnd->elbc = r_eth + r_eic;
 2994:             break;
 2995:          case 3:
 2996:             nodeBnd->elbc = eta1_bar + r_eic;
 2997:             break;
 2998:          case 4:
 2999:             nodeBnd->elbc = r_eth + r_eic;
 3000:             break;
 3001:          case 5:
 3002:             nodeBnd->elbc = r_eth + eta1_bar + r_eic;
 3003:             break;
 3004:       } // switch
 3005: 
 3006: 
 3007:       //Add inverse barometric effects
 3008:       if (iettype != 0 && inv_atm_bnd == 1) {
 3009:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 3010:       }
 3011: 
 3012:    }
 3013: 
 3014:    __device__ void computeVerticallyIntegratedVelocity(void) {
 3015: 
 3016:       SIDE(side);
 3017: 
 3018:       side->U = {0.0, 0.0}; 
 3019:          
 3020:       if(side->idry) return;
 3021: 
 3022:       const Node *node1 = side->n1;
 3023:       const Node *node2 = side->n2;
 3024: 
 3025:       // Vertically integrated velocity U (in ll if ics=2)
 3026:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 3027:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 3028:       }
 3029: 
 3030:    }
 3031: 
 3032:    __global__ void computeBottomDragVegetation(void) {
 3033:       // UNFINISHED. CHECK THIS:
 3034:       // How many kernels are needed? Why so many for loops?
 3035:       // Is the loop on sides needed?
 3036: 
 3037:       NODE(node);
 3038: 
 3039:       const int    kb      = node->kb;
 3040:       const double htot    = node->htot();
 3041:       const double rough   = node->rough;
 3042: 
 3043: 
 3044:       if (node->idry) {
 3045:          // Default values for dry nodes
 3046:          node->veg_alpha_vert_mean = node->veg_alpha0;
 3047:          /// XXX CHECK INDICES
 3048:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 3049:       }
 3050: 
 3051:       // Compute bottom drag Cd
 3052:       //--------------------------------
 3053: 
 3054:       // nchi = {-1, 0, 1} is the type of bottom drag.
 3055:       if (nchi==1) {
 3056: 
 3057:          bool ltmp = false; // for WBL iteration
 3058: 
 3059:          // Cdmax=-1 !max. Cd at node for this process (info only)
 3060:          // Drag at nodes
 3061:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 3062:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 3063:         
 3064:          const double rough = node->rough;
 3065:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3066:          if (node->rough == 0.0) {
 3067:             node->Cd = 0.0;
 3068: 
 3069:          } else { //roughness >0 
 3070:             
 3071:             const double bthick_ori = node->znl[kb + 1] - node->znl[kb];  // thickness of bottom bnd layer
 3072:             const double bthick = max(dzb_min, bthick_ori);
 3073: 
 3074:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 3075: 
 3076:             double tmp = 1.0/(2.5*log(bthick/rough));
 3077:             node->Cd = tmp*tmp;
 3078: 
 3079:          } // if rough
 3080: 
 3081: 
 3082:          // RECOVER THIS: XXX
 3083:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 3084:          // Output warning for WBL if iteration didn't converge
 3085: 
 3086: 
 3087:       } // nchi==1
 3088: 
 3089:       //   Bottom stress in m^2/s^2
 3090:       if (node->rho[kb + 1] >= -98.0)
 3091:       {
 3092:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 3093:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 3094:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 3095:          // !sediment erosion: this part needs more documentation
 3096:       }
 3097: 
 3098:     
 3099:       // Compute vegetation parameters
 3100:       //--------------------------------
 3101: 
 3102:       // SAV constants
 3103:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 3104:       constexpr double veg_cfpsi = 0.16;
 3105: 
 3106:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 3107:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 3108: 
 3109:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 3110:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 3111:          int kbin = 0; // bin index
 3112:          for (int k = kb; k < nvrt; k++) {
 3113:             // Computes node height above the bottom level
 3114:             const double tmp_h = node->znl[k] - node->znl[kb]; // >=0
 3115:             assert(true && "Vertical variation of vegetation not implemented");
 3116: 
 3117:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 3118:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 3119:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 3120:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 3121:             // } else {
 3122:             //    // Find the bin at which the current vertical level is
 3123:             //    while (kbin<nbins_veg_vert) {
 3124:             //       const double zn = node->znl[kbin];
 3125:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 3126:             //          break;
 3127:             //       } // if
 3128:             //       kbin++;
 3129:             //    } // while
 3130:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 3131: 
 3132:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 3133:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 3134:                
 3135:             //    // Linear interpolation of the vegetation parameters
 3136:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 3137:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 3138:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 3139:             // } // if rl10
 3140: 
 3141:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 3142: 
 3143:          } // for k
 3144: 
 3145: 
 3146:       } else { // Ganthy (iveg=2)
 3147:       //  Modify canopy height, diameter, and density
 3148: 
 3149:          // Make sure there is vegetation on this node
 3150:          if (node->veg_h_unbent > 0.0) {
 3151:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 3152: 
 3153:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 3154:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 3155:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 3156: 
 3157:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 3158:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 3159:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 3160:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 3161:          } // if veg_h_unbent
 3162: 
 3163:          for (int k = 0; k < nvrt; k++) {
 3164:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 3165:          } // for k
 3166:       
 3167: 
 3168:       } // if iveg
 3169:      
 3170:          
 3171: 
 3172:       // Compute vertical mean of veg_alpha3D
 3173:       if (iveg != 0) {
 3174:          const double ztop = node->zTopCanopy(); // Top of the canopy
 3175:          double sum1=0.0;
 3176:          double sum2=0.0;
 3177:          // Integrate over each level under the canopy...
 3178:          for (int k=kb; k<nvrt-1 && node->znl[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 3179:             const double Dz = node->Dz(k);
 3180: 
 3181:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 3182:             sum2 += Dz;
 3183: 
 3184:          } // for k
 3185: 
 3186:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 3187:          else             node->veg_alpha_vert_mean = sum1/sum2;
 3188: 
 3189:       } // if iveg
 3190: 
 3191:    }
 3192: 
 3193:    __global__ void computeVegetationAndDragParameters(void) {
 3194:       // Computes the vegetation and drag model parameters:
 3195:       // chi, \tilde\chi, beta, \breve{H}
 3196:       
 3197:       SIDE(side);
 3198: 
 3199:       const double htot = side->htot();
 3200:       const int    kb   = side->kb;
 3201: 
 3202:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 3203: 
 3204:       const double veg_h     = side->veg_h();
 3205:       const double veg_nv    = side->veg_nv();
 3206:       const double veg_c     = side->veg_c();
 3207:       const double veg_beta  = side->veg_beta;
 3208:       const double veg_alpha = side->veg_alpha_vert_mean();
 3209: 
 3210:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 3211:       // Velocity magnitude at the bottom level
 3212:       // XXXX Check if we have add -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 3213:       assert(true && "Must use backtracked velocity");
 3214:       const double vmag1 = length(side->u2[kb + 1]); //BACKTRACKED VELOCITY
 3215:       side->chi2 = side->Cd()*vmag1;
 3216:       side->chi  = side->chi2;
 3217:       if constexpr(iveg != 0) {
 3218:          const Node *n1 = side->n1;
 3219:          const Node *n2 = side->n2;
 3220:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 3221:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 3222:       }
 3223: 
 3224:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 3225: 
 3226:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 3227:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 3228:       double magUa = 0.0;
 3229:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 3230:          // 3D wet side with veg...
 3231: 
 3232:          double magUa = 0.0;
 3233:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 3234:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 3235: 
 3236:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 3237:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 3238:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 3239: 
 3240:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 3241:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 3242: 
 3243:                // Velocity magnitude at the bottom (l) of the level
 3244:                const double ul = length(side->u2[k]);
 3245: 
 3246:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 3247:                magUa += Dz*0.5*(uh + ul);
 3248: 
 3249:             } // if HasVegetation
 3250:          } // for k
 3251:          const double ua = magUa/min(htot, veg_h); // Vertical average
 3252: 
 3253:          // Computes beta, used for computing the stress term at the top of the canopy.      
 3254:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 3255:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 3256:             const double zCpy = side->zTopCanopy();
 3257:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 3258:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 3259:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 3260:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 3261:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 3262:          } // if isSubmerged
 3263:       } // if iveg   
 3264: 
 3265:       // Computes the friction modified depth, \breve{H} in notes
 3266:       if (side->is2D()) { // 2D
 3267: 
 3268:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 3269:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 3270: 
 3271:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 3272: 
 3273:          side->hhat = htot*htot/fricH; 
 3274: 
 3275:       } else { // 3D
 3276:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 3277: 
 3278:          if constexpr(iveg != 0) {
 3279:             
 3280:             if (side->isSubmerged()) { 
 3281:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 3282:                side->hhat -= veg_c*Hhat_alpha;
 3283: 
 3284:             } else { // Emergent
 3285:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 3286:             }
 3287:          } // if iveg
 3288: 
 3289:          // Enforce positivity for 3D model
 3290:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 3291:       } // if 3D
 3292: 
 3293:         
 3294:    }
 3295: 
 3296: 
 3297: 
 3298:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 3299:    // Computes the density gradient between two elements, e1 and e2.
 3300:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 3301:    // zero in the direction normal to the side. 
 3302:    // 
 3303:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 3304:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 3305:    //
 3306:    // Input:
 3307:    //    e1: Element
 3308:    //    e2: Neighbor element (or nullptr if boundary)
 3309:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 3310:    //    k: Index of the half-level at which the density is interpolated
 3311:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 3312:    // 
 3313:    // Output:
 3314:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 3315:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 3316: 
 3317:       if (e2 == nullptr || e2->idry) {
 3318:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 3319: 
 3320:          Side *side = e1->sides[j];
 3321:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->idry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 3322:                  
 3323:          if constexpr(ics == 1) {
 3324:             vec = side->n; // Normal vector to the side
 3325:          } else {
 3326:             // IMPLEMENT THIS XXXXXX
 3327:             // !replace with xel, yel?
 3328:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 3329:             //      &eframe(:,:,i),xn1,yn1,tmp)
 3330:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 3331:             //      &eframe(:,:,i),xn2,yn2,tmp)
 3332:          } //ics
 3333:                    
 3334:          diffRho = 0.0;
 3335: 
 3336:       } else { //internal and wet
 3337:          if constexpr(ics==1) {
 3338:             assert(e2 != nullptr || e2->idry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 3339: 
 3340:             // Vector from e1 to e2
 3341:             vec = toVector2(e2->center - e1->center);
 3342: 
 3343:          } else { 
 3344:             // IMPLEMENT THIS XXXXXX
 3345:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 3346:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 3347:             //                   alow(j)=xctr2
 3348:             //                   bdia(j)=yctr2
 3349:          } // ics
 3350: 
 3351:          diffRho = rho2 - e1->demeanedDensity(k);
 3352:       }
 3353: 
 3354:    }
 3355: 
 3356:    __global__ void computeDensityCubicSplines(void) {
 3357:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 3358: 
 3359:       ELEM(elem);
 3360: 
 3361:       if (elem->idry) return;
 3362: 
 3363:       const int kb = elem->kb;
 3364: 
 3365:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 3366:       if (elem->is2D()) {
 3367:          // In the 2D case, the density is constant at the prism level. 
 3368:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 3369:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 3370:       } else { //3D
 3371: 
 3372:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 3373:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 3374:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 3375:          ///// XXXX CHECK INDICES!!!!!
 3376:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 3377:       } // 2D/3D
 3378: 
 3379:    }
 3380: } // extern "C"
 3381: 
 3382: 
 3383: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 3384: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 3385: 
 3386:    if (elem2 == nullptr || elem2->idry) return 0.0;
 3387: 
 3388:    const int kb  = elem->kb;
 3389:    const int kb2 = elem2->kb;
 3390: 
 3391:    // z-coordinate of prism of elem
 3392:    const double zp = elem->z_prism(k);
 3393: 
 3394:    double rho = 0.0;
 3395: 
 3396:    if (elem2->is2D()) {
 3397:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 3398: 
 3399:    } else {  // 3D
 3400: 
 3401:       // eta_min may be < zmax
 3402:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 3403:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 3404: 
 3405:       // (Extrapolate density below bottom, we will fix it later)
 3406:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 3407:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 3408:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 3409:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 3410:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 3411:    } // 2D/3D
 3412:      
 3413: 
 3414:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 3415:    // Now we need to fix it.
 3416:    if (elem->z[k] < elem2->z[kb2]) {
 3417:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 3418: 
 3419:       // There are two methods to adjust the density at the bottom of the element.
 3420:       // iunder_deep=0: 
 3421:       const double depth1 = abs(elem->z[kb]); // larger depth
 3422: 
 3423:       if (iunder_deep==0) {
 3424: 
 3425:          const double weight = max(0.0, min(1.0, (depth1 - h1_bcc)/(h2_bcc - h1_bcc))); // weight
 3426: 
 3427:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 3428: 
 3429:       } else { // iunder_deep != 0
 3430: 
 3431:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 3432: 
 3433:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 3434: 
 3435:          //   Demeaned density at the same z coordinate as
 3436:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 3437:          }
 3438: 
 3439:       } // if iunder_deep
 3440:    } // if elem->z[kb] < elem2->z[kb]
 3441: 
 3442:    return rho;
 3443: }
 3444: 
 3445: 
 3446: extern "C" {
 3447:    __global__ void computeDensityGradient(void) {
 3448: 
 3449:          // Compute the horizontal density gradient at each element.
 3450:       // It works in two steps:
 3451:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 3452:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 3453:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 3454:       //             gradRho.r1 = rho1 - rho0
 3455:       //             gradRho.r2 = rho2 - rho0
 3456:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 3457:       // 
 3458:       //  NOTE: We use de-meaned densities.
 3459: 
 3460:       ELEM(elem);
 3461: 
 3462:       if (elem->idry) return;
 3463: 
 3464:       const int kb  = elem->kb;
 3465:       const int i34 = elem->i34;
 3466: 
 3467:       for (int k = kb + 1; k < nvrt; k++) {
 3468:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 3469:          //             gradRho.r1 = rho1 - rho0
 3470:          //             gradRho.r2 = rho2 - rho0
 3471:          int icount = 0;
 3472:          double sumRx = 0.0;
 3473:          double sumRy = 0.0;
 3474:          for (int j1=0; j1<i34; j1++) { 
 3475: 
 3476:             const int j2 = elem->nxq(j1 + 1);
 3477: 
 3478:             // Pairs of consecutive neighbor elements of elem
 3479:             const Element *e1 = elem->nghbElems[j1];
 3480:             const Element *e2 = elem->nghbElems[j2];
 3481: 
 3482:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 3483:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 3484:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 3485: 
 3486:             // Compute the density difference and the vector from elem to e1 and e2
 3487:             // getRhoDiffAndVec takes into account boundaries/dry elements
 3488:             double diffRho1, diffRho2;
 3489:             Vector2 vec1, vec2;
 3490:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 3491:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 3492: 
 3493:             const double rl1 = length(vec1);
 3494:             const double rl2 = length(vec2);
 3495:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 3496: 
 3497:             const double delta = cross(vec1, vec2);
 3498:             const double sintheta = abs(delta)/(rl1*rl2);
 3499: 
 3500:             // To avoid problems, avoid elements with small angle between vectors
 3501:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 3502:             const bool validEq = (sintheta > sin_one_deg);
 3503: 
 3504:             if (validEq) {
 3505:                // Solve the system of equations to get the density gradient at elem
 3506:                icount++;
 3507:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 3508:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 3509:                sumRx += Rx;
 3510:                sumRy += Ry;
 3511:             }
 3512:          } // for j1
 3513: 
 3514:          // Compute the average density gradient at elem
 3515:          if (icount==0) {
 3516:            // Bad mesh quality; bail out with 0 b-cc
 3517:            elem->gradRho[k] = {0.0, 0.0};
 3518:          } else {
 3519:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 3520:          }
 3521: 
 3522:       } // for k
 3523: 
 3524:    }
 3525: 
 3526:    __global__ void computeBaroclinicTerm(double rampbc) {
 3527:    // Computes the baroclinic term at sides (at half levels).
 3528:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 3529:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 3530: 
 3531:       SIDE(side);
 3532: 
 3533:       if (side->idry == 1) return;
 3534: 
 3535:       const Element *e1 = side->elems[0];
 3536:       const Element *e2 = side->elems[1];      
 3537:       const int kb = side->kb;
 3538:       
 3539:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 3540: 
 3541:       // interpolates vertically the density gradient of the two elements at the half level/
 3542: 
 3543:       // Starts the integration at the surface and goes down to the bottom
 3544:       int k1 = nvrt - 1;
 3545:       int k2 = nvrt - 1;
 3546: 
 3547:       side->bcc[nvrt-1] = {0.0, 0.0};
 3548:       for (int k = nvrt-1; k >= kb; k--) {
 3549:       // For each prism level (from surface to bottom)...
 3550: 
 3551:          // For both elements, interpolate density gradient at the side's half level.
 3552:          // The gradient at the side is the average of the gradients at the elements.
 3553:          // w1, w2 are used to take into account boundary sides, with just one element.
 3554:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 3555:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 3556:          w1 = w1/(w1 + w2);
 3557:          w2 = w2/(w1 + w2);
 3558: 
 3559:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 3560: 
 3561:          // Linear interpolation of both elements' density gradient at the shared side's level.
 3562:          Vector2 gradRho = {0.0, 0.0};
 3563:          if (e1 != nullptr && k > kb) {
 3564:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 3565:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 3566:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 3567:             
 3568:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 3569:          }      
 3570:          if (e2 != nullptr && k > kb) {
 3571:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 3572:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 3573:             
 3574:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 3575:          }
 3576: 
 3577:          if constexpr(ics==2) {
 3578:             // IMPLEMENT THIS XXXXXX
 3579:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 3580:             // swild(1)=tmp1
 3581:             // swild(2)=tmp2
 3582:          }
 3583:          
 3584:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 3585:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 3586:          // CHECK INDICES!!! XXX
 3587:          const double grav3 = 0.5*(side->n1->grav2 + side->n2->grav2);
 3588:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 3589:       } // for
 3590: 
 3591:    }
 3592: 
 3593: } // extern "C"
 3594: 
 3595: #ifdef DONTCOMPILE
 3596: __device__ void computeVerticalAdvection(void) {
 3597:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 3598: 
 3599:    sdbt(1:2,:,:)=0.d0
 3600: 
 3601:    const Side *side = FROM kernel;
 3602: 
 3603:    if(side->idry) return;
 3604: 
 3605:    // If side is wet...
 3606: 
 3607: 
 3608:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 3609:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 3610:    double ws[nvrt] = {} // w @ side
 3611:    int icount = 0;
 3612:    for (int j=0; j<2; j++) {
 3613:       const Element *elem = side->elements[j];
 3614:        
 3615:       if(elem != nullptr) {
 3616:          icount++;
 3617:          for (int k=0; k<nvrt; k++) {
 3618:             ws[k] = ws[k] + elem->w[k];
 3619:          }
 3620:       }
 3621:    }  // for j
 3622: 
 3623:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 3624:    ws = ws/icount;
 3625: 
 3626:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 3627:    // Splines allow for a smooth transition between vertical levels.
 3628:    // Splines have continuity restrictions at the internal knots, but
 3629:    // we have to provide the 1st derivatives at the endpoints.
 3630:    const int kbs = side->kbs; 
 3631:    
 3632:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3633:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3634:    initCubicSpline(kbs, nvrt, side, ws, up)
 3635: 
 3636:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3637:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3638:    initCubicSpline(kbs, nvrt, side, ws, vp)
 3639: 
 3640:    // Total advection (average onto side)
 3641:    const Node *node1 = side->nodes[0];
 3642:    const Node *node2 = side->nodes[1];
 3643:    for (int k=kbs(i); k<nvrt; k++) {
 3644: 
 3645:       if constexpr(ics==1) {
 3646:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 3647:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 3648:       } else {
 3649:          // XXX IMPLEMENT THIS
 3650:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 3651:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 3652:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 3653:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 3654:       }  // if ics
 3655: 
 3656: 
 3657:    }
 3658: }
 3659: #endif
 3660: 
 3661: 
 3662: extern "C" {
 3663:    __global__ void computeElemAverageGhat(double rampbc) {
 3664:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 3665: 
 3666:       ELEM(elem);
 3667:       
 3668:       elem->ghat1= {0.0, 0.0};  
 3669: 
 3670:       if constexpr(ihydraulics != 0) {
 3671:          if (nhtblocks > 0 && elem->isblock) return;
 3672:       }
 3673: 
 3674:       if (elem->idry == 1) return;
 3675: 
 3676:       // Wet elements.
 3677:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 3678:       // tidal potential, horizontal diffusion, and baroclinic etc
 3679:       // Remember to update both fb and F 
 3680:       // If ics=2, ghat1 are in eframe (ll)
 3681:       // cff1-3: coefficients for 2D/3D
 3682:       Vector2 gradEta = {0.0, 0.0};  // \nabla \eta
 3683:       Vector2 gradPr  = {0.0, 0.0};  // \nabla pressure
 3684:       Vector2 gradEtp = {0.0, 0.0};  // \nabla etp
 3685: 
 3686:       double av_cff1 = 0.0;  // av. for cff1
 3687:       double av_cff2 = 0.0;  // av. for cff2
 3688:       double av_cff3 = 0.0;  // av. for cff3
 3689:       double av_df = 0.0;  // av. for H^\alpha / H
 3690:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 3691:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 3692: 
 3693:       const int i34 = elem->i34;
 3694:       const int kb = elem->kb;
 3695: 
 3696:       for (int j=1; j<i34; j++) {
 3697:          // For each node and side in the element...
 3698: 
 3699:          const Node *node = elem->nodes[j];
 3700:          const Side *side = elem->sides[j];
 3701: 
 3702:          const double chi      = side->chi;
 3703:          const double veg_c2   = side->veg_c2;
 3704:          const double veg_beta = side->veg_beta;
 3705:          const double veg_h    = side->veg_h();
 3706:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 3707: 
 3708:          // Node - const in elem
 3709:          gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 3710:          gradPr  += node->pr  *elem->gradPhi[j];
 3711: 
 3712:          if (elem->depth >= tip_dp) {
 3713:            gradEtp += node->etp*elem->gradPhi[j];
 3714:          }
 3715: 
 3716:          
 3717:          const double htot  = side->htot();        // Total depth at the side
 3718:          const double zctr2 = side->zTopCanopy();  
 3719: 
 3720:          double cff1; 
 3721:          double cff2; 
 3722:          double cff3;   
 3723:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 3724:          // coefficients applied to 2D/3D case 
 3725:             cff1 = side->hhat/htot;
 3726:             cff2 = 0.0;
 3727:             cff3 = 0.0;
 3728:          } else { //3D
 3729:             //Init for no-veg case
 3730:             cff1 = 1.0;
 3731:             cff2 = 1.0;
 3732:             cff3 = 0.0;
 3733: 
 3734:             if constexpr(iveg != 0) {
 3735:                // Computes coefficients used with vegetation terms G1, G2
 3736:                // cff1, cff3 are used for the first two terms in G1, G2:
 3737:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 3738:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 3739:                // In general, cff1*Ustar - cff3*Ustar_alpha
 3740:                if(veg_h < 0.99*htot) { // submergent vegetation
 3741:                   cff1=1;
 3742:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 3743:                   cff3 = veg_c;
 3744: 
 3745:                } else { // emergent vegetation
 3746:                   cff1 = 1.0/(1.0 + veg_c2);
 3747:                   cff2 = cff1;
 3748:                   cff3 = 0.0;
 3749: 
 3750:                }
 3751:             } // if iveg
 3752:          } //  2D/3D
 3753: 
 3754:          av_cff1 += cff1/i34;
 3755:          av_cff2 += cff2/i34;
 3756:          av_cff3 += cff3/i34;
 3757:          av_cff2_chi += cff2*chi/i34;
 3758:          av_cff3_chi += cff3*chi/i34;
 3759:          av_df += min(htot, veg_h)/(htot*i34);
 3760: 
 3761: 
 3762:          // btrack values: U^\star, U^{\star\alpha}
 3763:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 3764:          Vector2 Ustar       = {0.0, 0.0}; 
 3765:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 3766:          for (int k = side->kb; k < nvrt; k++) {
 3767:             if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 3768:                Ustar += side->btu[nvrt]*side->Dz(k);
 3769: 
 3770:             } else { //3D
 3771:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 3772:                Ustar += w2;
 3773: 
 3774:                if constexpr(iveg != 0) {
 3775:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 3776:                        const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k)); // For the top of the canopy, ratio of the level that is below the canopy
 3777:                        Ustar_alpha += zrat*w2; // XXXX
 3778:                    }
 3779:                }  // if iveg
 3780:             }  //2/3D
 3781:          }  //k
 3782:          
 3783: 
 3784:          // Add btrack & surface stress terms to \breve{G} first
 3785:          if constexpr(ics==1) {
 3786:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 3787:          } else {
 3788:             // XXX IMPLEMENT THIS
 3789:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 3790:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 3791:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 3792:          }  // if ics
 3793: 
 3794:          // Surface and bottom stress terms
 3795:          if constexpr(ics==1) {
 3796:             const Vector2 tau    = side->tau();
 3797:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 3798: 
 3799:             // Term for surface and bottom stress
 3800:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 3801:          } else {
 3802:             // XXX IMPLEMENT THIS
 3803:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 3804:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 3805:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 3806:             // tau_x=(vn1+tt1)/2.d0
 3807:             // tau_y=(vn2+ss1)/2.d0
 3808:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 3809:          }  // if ics
 3810: 
 3811:          
 3812: 
 3813:          // All terms in F,F^\alpha,f_b except baroclinic
 3814:          // F, f_b: all explicit terms excluding vegetation 
 3815:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 3816:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 3817:          const double coriolis = side->coriolis;
 3818:          Vector2 F  =  coriolis*side->U;  // F_x
 3819:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 3820:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 3821: 
 3822:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 3823:             
 3824:             for (int k = side->kb; k < nvrt; k++) {
 3825:                if (zctr2 > side->zc[k-1]) {
 3826:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 3827:                    const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 3828:                    Fa +=  coriolis*w2*zrat;
 3829:                } // if zctr2
 3830:             } // k
 3831:          } // iveg
 3832: 
 3833:          // Integrate horizontal viscosity force vertically
 3834:          for (int k=side->kb + 1; k<nvrt; k++) {
 3835:             const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.0; 
 3836: 
 3837:             F += levelHorVisc;
 3838: 
 3839:             // Vegetation term
 3840:             if constexpr(iveg!=0) {
 3841:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 3842:                   const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 3843:                   Fa += levelHorVisc*zrat;
 3844:                } 
 3845:             } // if iveg
 3846:          } // for k
 3847: 
 3848:          fb += side->d2uv[side->kb];
 3849: 
 3850: 
 3851:          // Add to ghat1
 3852:          if constexpr(ics==2) {
 3853:             // XXX IMPLEMENT THIS
 3854:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 3855:             // bigf1=vn1; bigf2=vn2
 3856:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 3857:             // botf1=vn1; botf2=vn2
 3858:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 3859:             // bigfa1=vn1; bigfa2=vn2
 3860:          } // if ics
 3861: 
 3862:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 3863:       } // for j (nodes and sides)
 3864: 
 3865:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 3866:          
 3867:       // Finish off terms in F, F^\alpha and f_b
 3868:       const double grav3 = elem->mean(&Node::grav2);
 3869:       const Vector2 fb = grav3*gradEtp - gradPr/rho0; //const in each elem
 3870: 
 3871: 
 3872:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 3873:       for (int j=1; j<i34; j++) { 
 3874:          // For each side in the element...
 3875:          const Side *side = elem->sides[j];
 3876:          const double chi = side->chi;
 3877: 
 3878:          const double htot = side->htot();
 3879:          const double veg_h = side->veg_h();
 3880:          const Vector2 F  = htot*fb;
 3881:          const Vector2 Fa = min(htot, veg_h)*fb;
 3882: 
 3883:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 3884:       } // for j
 3885: 
 3886:       //botf1 etc are already in elem frame
 3887:       elem->ghat1 += tmp/i34;
 3888: 
 3889:       // Baroclinic force
 3890:       if constexpr(ibc==0) {
 3891:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 3892: 
 3893:          Vector2 Fa = {0.0, 0.0};
 3894:          Vector2 intGradRho = {0.0, 0.0};
 3895:          
 3896:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 3897:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 3898:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 3899: 
 3900:             // \in F [m^2/s/s]
 3901:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 3902:          }
 3903: 
 3904:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 3905:          const Vector2 F = av_df*Fa; //approx
 3906:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 3907: 
 3908:       } // if ibc
 3909: 
 3910:    }
 3911: 
 3912: } // extern "C"
 3913: 
 3914: 
 3915: 
 3916: #ifdef DONTCOMPILE
 3917: __global__ void checkMassConservation(Tracers* sumtr) {
 3918: 
 3919:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 3920: 
 3921:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 3922: 
 3923:    Element *elem = &(mesh->localElemData[i]);
 3924: 
 3925:    // Skip dry elements
 3926:    if (elem->idry) return;
 3927: 
 3928:    // Local sum array for this thread
 3929:    double localSum[N_TRACERS] = {0.0};
 3930: 
 3931:    // Sum over vertical levels for this element
 3932:    const int kbe = elem->kbe;
 3933:    const double area = elem->area;
 3934: 
 3935:    for (int k = kbe; k < nvrt; k++) {
 3936:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 3937:       
 3938:       // Accumulate tracer mass
 3939:       for (int tr = 0; tr < N_TRACERS; tr++) {
 3940:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 3941:       }
 3942:    }
 3943: 
 3944:    
 3945: 
 3946:    //  This function returns per element sums. A reduction must be done on the host side.
 3947: }
 3948: 
 3949: 
 3950: __global__ void transport(void) {
 3951: 
 3952:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 3953: 
 3954:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 3955: 
 3956:    Element *elem = &(mesh->localElemData[ie]);
 3957: 
 3958:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 3959: 
 3960:                for (int m=0; m<ntr; m++) {
 3961:                   for (int k=kbe(ie); k<nvrt; k++) {
 3962:                      // Calculate each polynomial's weight 
 3963:                      wm=0.d0; sum1=0.d0; 
 3964:                      wm1=0.d0; wm2=0.d0; 
 3965:                      for (int i=0; i<elem->nweno2; i++) {
 3966:                   
 3967:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3968:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3969:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3970:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3971:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3972:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 3973:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 3974:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 3975:                      // -----------------Hu and Shu (1999)'s method----------------
 3976:                      b4=b1+b2+b3
 3977: 
 3978: //Error: add PRODUCTION CPP
 3979: #ifdef DEBUG
 3980:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 3981:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 3982:                     call parallel_abort(errmsg)
 3983:                   }
 3984: #endif
 3985: 
 3986:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 3987:                   // !----test-------------- 
 3988:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 3989:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 3990:                   // !wm(i)=wm1(i)*wm2(i)
 3991:                   // !---------------------- 
 3992:                   sum1=sum1+wm(i)
 3993:                 } // end for i
 3994: 
 3995:                 wm=wm/sum1
 3996: 
 3997:                 for (int j=0; j<elem->i34; j++) {
 3998: 
 3999:                   const Side *side  = elem->sides[j];
 4000:                   const Node *node1 = side->n1;
 4001:                   const Node *node2 = side->n2;
 4002: 
 4003:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 4004:                      trsd=0.d0
 4005:                      for (int kk=0; kk<nquad; kk++) {
 4006:                         for (int i=0; i<elem->nweno2; i++) {
 4007:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4008:                         } // end for i   
 4009:                      } // end for kk
 4010:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 4011:                   } // outward flux
 4012:                } // end for j=1,i34(ie) ! side
 4013:             }
 4014:          }
 4015:               
 4016: 
 4017: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 4018: //             //   calculate each polynomial's weight 
 4019: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 4020: //                 wm=0.d0; sum1=0.d0
 4021: //                 do i=1,nweno1(ie) !for each polynomial
 4022: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4023: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4024: //                   b1=b1*b1+b2*b2 !smoothness indicator
 4025: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 4026: //                   wm(i)=b2
 4027: //                   sum1=sum1+b2
 4028: //                   !wm(i)=1.d0
 4029: //                   !sum1=sum1+1.d0
 4030: 
 4031: // // Error: PRODUCTION
 4032: // #ifdef DEBUG
 4033: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 4034: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 4035: //                     call parallel_abort(errmsg)
 4036: //                   endif
 4037: // #endif
 4038: 
 4039: //                 enddo !i
 4040: //                 wm=wm/sum1 !final weight
 4041: 
 4042:                 for (int j=0; j<elem->i34; j++) { // side
 4043:                   const Side *side = elem->sides[j];
 4044:                   const Node *node1 = side->n1;
 4045:                   const Node *node2 = side->n2;
 4046: 
 4047:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 4048:                     trsd=0.d0
 4049:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 4050:                       for (int i=0; i<elem->nweno1; i++) {
 4051:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 4052:                       }
 4053:                     enddo //kk
 4054:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 4055:                   } // outward flux
 4056:                 } // end for j=1,i34(ie) ! side
 4057:               } // end for k; ntr 
 4058: 
 4059:             else !simple upwind method
 4060:               do j=1,i34(ie)
 4061:                 jsj=elside(j,ie)
