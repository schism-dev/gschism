 4953: __global__ void getStructSizes(int* sizes)  {
 4954:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 4955:       sizes[0] = (int)sizeof(Node);
 4956:       sizes[1] = (int)sizeof(Element);
 4957:       sizes[2] = (int)sizeof(Side);
 4958:       sizes[3] = (int)sizeof(NodeBoundary);
 4959:       sizes[4] = (int)sizeof(SideBoundary);
 4960:       sizes[5] = (int)sizeof(BoundarySegment);
 4961: }
