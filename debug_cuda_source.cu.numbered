 1230: /**
 1231:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1232:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1233:    If the segment is completely inside the element, then it returns true.
 1234: 
 1235:    This function assumes:
 1236:    - The initial point is on a side of the element. 
 1237:    - Its position is given by parameter t in the range [0,1].
 1238:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1239:       intersects the element (elements are convex).
 1240: 
 1241:    To find the intersection point, this function does the following:
 1242:    - it finds the intersection of the line segment with all the element side lines,
 1243:       except for the one that contains the initial point.
 1244:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1245:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1246:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1247:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1248:       track segment is almost parallel to the element side line.
 1249: 
 1250:    Inputs:
 1251:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1252:    @param x2, y2: other end of the line segment
 1253: 
 1254:    Outputs:
 1255:    @param side:  side that intersects the line segment (input and output)
 1256:    @param nextElement (output): element that contains the intersection point
 1257:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1258:    @param zint (input/output): Vertical coordinate of the intersection point
 1259: 
 1260:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1261:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1262:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1263: 
 1264:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1265:    (Delta) being zero.
 1266: 
 1267:    The intersection2 point happens when:
 1268:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1269:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1270:    
 1271:    Assumption: the 4 points (including those of the side segment) are different.
 1272:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1273:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1274:    If true, (xIntersect,yIntersect) is the intersection.				
 1275:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1276: **/
 1277: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1278:                                               double &t, double& tIntersect) {
 1279: 
 1280:    double closest_intersect_t = 1e10;
 1281:    bool found_intersection = false;
 1282: 
 1283:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1284:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1285:    const Point2 x1 = side->point(t);
 1286:    
 1287: 
 1288:    Side *nextSide = nullptr;
 1289: 
 1290:    for (int i = 0; i < i34; i++) {
 1291: 
 1292:       // Element's i-th side 
 1293:       Side *side2 = sides[i];
 1294: 
 1295:       // Skip the side that contains the initial point
 1296:       if (side2 == side) continue;
 1297: 
 1298:       // (x3,y3)-(x4,y4) is the element side line
 1299:       const Point2 x3 = side2->n1->p2();
 1300:       const Point2 x4 = side2->n2->p2();
 1301: 
 1302:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1303:       const double delta = cross(x2 - x1, x3 - x4);
 1304: 
 1305:       if (delta != 0.0) {
 1306: 
 1307:          const double delta1 = cross(x3 - x1, x3 - x4);
 1308:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1309: 
 1310:          // Solves the two linear equations for tt1 and tt2
 1311:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1312:          const double tt2 = delta2/delta;
 1313: 
 1314:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1315:             closest_intersect_t = min(closest_intersect_t, tt1);
 1316:             nextSide = side2;
 1317: 
 1318:             nextElement = nextSide->otherElem(this);
 1319:             tIntersect = max(small, min(tt1, 1.0-small));
 1320:             t = tt2;
 1321: 
 1322:             found_intersection = true;
 1323:          }
 1324:       
 1325:       }
 1326: 
 1327:    }
 1328: 
 1329: 
 1330:    // found_intersection should always be true, since we checked all the sides.  
 1331:    side = nextSide;
 1332: // if (found_intersection) {
 1333: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1334: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1335: // }   
 1336:    return found_intersection;
 1337: }
 1338: 
 1339: 
 1340: 
 1341: 
 1342: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1343:                                               double &t, double& tIntersect) {
 1344: 
 1345:    double closest_intersect_t = 1e10;
 1346:    bool found_intersection = false;
 1347: 
 1348:    for (int i = 0; i < i34; i++) {
 1349: 
 1350:       Side *side2 = sides[i];
 1351: 
 1352:       // (x3,y3)-(x4,y4) is the element side line
 1353:       const Point2 x3 = side2->n1->p2();
 1354:       const Point2 x4 = side2->n2->p2();
 1355: 
 1356:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1357:       const double delta = cross(x2 - x1, x3 - x4);
 1358: 
 1359:       if (delta != 0.0) {
 1360: 
 1361:          const double delta1 = cross(x3 - x1, x3 - x4);
 1362:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1363: 
 1364:          // Solves the two linear equations for tt1 and tt2
 1365:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1366:          const double tt2 = delta2/delta;
 1367: 
 1368:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1369:             closest_intersect_t = min(closest_intersect_t, tt1);
 1370:             side = side2;
 1371:             nextElement = side->otherElem(this);
 1372:             t = tt2;
 1373:             tIntersect = max(small, min(tt1, 1.0-small));
 1374:             found_intersection = true;
 1375:          }
 1376:       
 1377:       }
 1378: 
 1379:    }
 1380: 
 1381: // if (found_intersection) {
 1382: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1383: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1384: // }
 1385: 
 1386:    // found_intersection should always be true, since we checked all the sides.  
 1387:    return found_intersection;
 1388: }
