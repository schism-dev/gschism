 3109:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3110: 
 3111:       NODE_BND(nodeBnd);
 3112: 
 3113:       Node *node = nodeBnd->node;
 3114: 
 3115:       printf("computeTidalPotential: nodeIdx = %d, ntip = %d\n", node->idx, ntip);
 3116:       node->ETP = 0.0;
 3117: 
 3118:       for (int j=0; j<ntip; j++) {
 3119: 
 3120:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3121:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3122:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3123: 
 3124:          if constexpr(iloadtide==1) { // loading tide
 3125:             assert(false && "Loading tide not implemented");
 3126:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3127:          }
 3128:          
 3129:       }
 3130:       
 3131:    }
