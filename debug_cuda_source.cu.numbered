 4797: 
 4798: __global__ void computeMatrixProductAndDotProducts() {
 4799:    // Computes A*p, r'Mr and p'Ap
 4800: 
 4801:    // 1) shared buffer: first half for rMr, second for pAp
 4802:    __shared__ double sdata[2*BLOCK_SIZE];
 4803:    double* s_rMr = sdata;
 4804:    double* s_pAp = sdata + BLOCK_SIZE;
 4805: 
 4806:    // 2) get your node pointer
 4807:    NODE(node);  
 4808:    const int tid = threadIdx.x;
 4809: 
 4810:    const double diag = node->coeffDiag;
 4811:    const double r    = node->mR;
 4812:    const double p    = node->mP;  
 4813: 
 4814:    // apply preconditioner on the fly:
 4815:    const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 4816: 
 4817: 
 4818:    // 4) compute Ap = A.p
 4819:    double Ap = node->coeffDiag * node->mP;
 4820:    #pragma unroll
 4821:    for (int j = 0; j < node->numNodes; ++j) {
 4822:       const Node *nbNode = node->nodes[j];
 4823:       Ap += node->coeffMatrix[j] * nbNode->mP;
 4824:    }
 4825:    node->mAp = Ap;
 4826:     
 4827: 
 4828:    // 5) dot-products individual products (r'Mr, p'Ap)
 4829:    const double l_rMr = r*Mr;  // r'Mr
 4830:    const double l_pAp = p*Ap;  // p'Ap
 4831: 
 4832:    // 6) write into shared mem
 4833:    s_rMr[tid] = l_rMr;
 4834:    s_pAp[tid] = l_pAp;
 4835:    __syncthreads();
 4836: 
 4837:    // 7) block-wide tree reduction
 4838:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 4839:       if (tid < stride) {
 4840:          s_rMr[tid] += s_rMr[tid + stride];
 4841:          s_pAp[tid] += s_pAp[tid + stride];
 4842:       }
 4843:       __syncthreads();
 4844:    }
 4845: 
 4846:    // 8) thread 0 atomically accumulates into the globals
 4847:    // XXX: This is slower than it needs to be, but it is simple and works
 4848:    if (tid == 0) {
 4849:       atomicAdd(&rMr_old, s_rMr[0]);
 4850:       atomicAdd(&pAp, s_pAp[0]);
 4851:    }   
 4852: }
 4853: 
 4854: 
 4855: __global__ void updateSolutionAndDotProducts() {
 4856:     extern __shared__ double sdata[];       // 2*BLOCK_SIZE doubles
 4857:     double* s_rMr = sdata;                  // [0 .. BLOCK_SIZE-1]
 4858:     double* s_rr  = sdata + BLOCK_SIZE;     // [BLOCK_SIZE .. 2*BLOCK_SIZE-1]
 4859: 
 4860:     // get node & bounds-check:
 4861:     NODE(node);
 4862:     const int tid = threadIdx.x;
 4863: 
 4864:     // Compute alpha
 4865:     const double alpha = rMr_old/pAp;
 4866: 
 4867:     // load scalars
 4868:     const double diag = node->coeffDiag;
 4869:     const double p    = node->mP;
 4870:     const double Ap   = node->mAp;
 4871:     const double x    = node->mX;
 4872:     const double r    = node->mR;
 4873: 
 4874:     // 1) update solution & residual
 4875:     const double x_new = x + alpha*p;
 4876:     const double r_new = r - alpha*Ap;
 4877:     node->mX = x_new;
 4878:     node->mR = r_new;
 4879: 
 4880:     // 2) apply Jacobi preconditioner on the fly
 4881:     const double Mr_new = r_new/diag;
 4882: 
 4883:     // 3) local contributions for the two dot-products
 4884:     const double l_rMr = r_new*Mr_new;  // r'M^-1r
 4885:     const double l_rr  = r_new*r_new;   // r'r
 4886: 
 4887:     // 4) write into shared-mem
 4888:     s_rMr[tid] = l_rMr;
 4889:     s_rr [tid] = l_rr;
 4890:     __syncthreads();
 4891: 
 4892:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 4893:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 4894:         if (tid < stride) {
 4895:             s_rMr[tid] += s_rMr[tid + stride];
 4896:             s_rr [tid] += s_rr [tid  + stride];
 4897:         }
 4898:         __syncthreads();
 4899:     }
 4900: 
 4901:     // 6) thread 0 atomically folds into the global accumulators
 4902:     if (tid == 0) {
 4903:         atomicAdd(&rMr_new, s_rMr[0]);
 4904:         atomicAdd(&rr,      s_rr [0]);
 4905:     }
 4906: }
 4907: 
 4908: 
 4909: __global__ void updateSearchDirection() {
 4910:     NODE(node);
 4911: 
 4912:     // recompute z on-the-fly
 4913:     const double z = node->mR / node->coeffDiag;
 4914:     const double p = node->mP;
 4915: 
 4916:     const double beta = rMr_new/rMr_old;
 4917: 
 4918:     // p =z + beta*p
 4919:     node->mP = z + beta*p;
 4920: }
