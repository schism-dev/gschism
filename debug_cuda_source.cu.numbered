 1070: // Helper functions for computing the local node index at a given offset from another.
 1071: __device__ __inline__ int nxq(int offset, int index, int size) {
 1072:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1073:    // to the index to make it positive
 1074:    assert(index + offset + 16*size >= 0);
 1075:    return (index + offset + 16*size) % size;  
 1076: }
 1077: 
 1078: __device__ __inline__ int nxq(int index, int size) {
 1079:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1080:    // to the index to make it positive
 1081:    assert(index + 16*size >= 0);
 1082:    return (index + 16*size) % size; 
 1083: }
