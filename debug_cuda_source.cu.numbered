 1993: __host__ __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 1994: 
 1995: __device__ double Node::compZCoord(int k) const {
 1996:    // Computes the z coordinate at level k.
 1997:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 1998:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 1999:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2000:    // used 
 2001:    
 2002:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2003:       
 2004:    if (idry) {
 2005:       return 0.0;
 2006:    }
 2007: 
 2008:    if constexpr(ivcor == 2) {
 2009: 
 2010:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2011:       const int kz = mesh->kz;
 2012: 
 2013:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2014:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2015:       // once per time step/node.
 2016:       // CHECK: updateZCoordData
 2017:       if (k == kz)               return -hmod2;
 2018:       else if (k == nvrt-1)      return eta2;
 2019:       else if (k == kb)          return -depth;
 2020:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2021:       else if (k > kz) {
 2022:          const int ksig = k - kz + 1;
 2023: 
 2024:          if (hmod2 <= mesh->h_c) {
 2025:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2026:          } 
 2027:          else if (eta2 <= - mesh->h_c - (depth - mesh->h_c) * mesh->theta_f/mesh->sinh_theta_f) {
 2028:             printf("Please choose larger h_c: %f %f\n", eta2, mesh->h_c);
 2029:             Error("ZCOOR: invalid h_c\n");
 2030:          } 
 2031:          else {
 2032:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2033:                          mesh->h_c * mesh->sigma[ksig] + 
 2034:                          (hmod2 - mesh->h_c) * mesh->cs[ksig];
 2035:          }
 2036:       } else { 
 2037:          Error("ZCOOR: invalid level or coordinate system\n");
 2038:       }
 2039: 
 2040:    }
 2041:    else if constexpr(ivcor == 1) {
 2042:       if (k == kb) return -depth;
 2043:       else if (k == nvrt-1) return eta2;
 2044:       else if (k >= kb) {
 2045:             return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2046:       }
 2047:    }
 2048:    
 2049:    printf("ZCOOR: invalid level or coordinate system\n");
 2050:    return 0.0;
 2051: }
 2052: 
 2053: 
 2054: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2055:                 double *node_coords, double *wind_rotate_angle, 
 2056:                 int *isdel, int *isidenode, int *isbnd,
 2057:                 int *nond, int *nlnd, int *iond, int *ilnd,
 2058:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2059:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2060:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2061:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2062:                 int *localNodePart,     int *localElemPart,     int *localSidePart) {
 2063: 
 2064:    printf("Populating mesh for partition %d, %d, %d\n", partNum, nond, nlnd);
 2065: 
 2066:    // Horizontal grid
 2067:    printf("Processing %d nodes\n", np);    
 2068:    int idxNodeBoundary = 0;  
 2069:    for (int i = 0; i < np; i++)
 2070:    {
 2071:       Node &node = localNodeData[i];
 2072: 
 2073:       const int idxStart = nodeNeighNodesStart[i];
 2074:       const int idxEnd   = nodeNeighNodesStart[i+1];
 2075:       node.numNodes = idxEnd - idxStart;
 2076:       node.nodes = (Node **)(nodeNeighNodes + idxStart*sizeof(Node *));
 2077:       node.idx = i;
 2078: 
 2079:       for (int idx = idxStart; idx < idxEnd; idx++) {
 2080:          int idxNode = nodeNeighNodesIndices[idx];
 2081:          Node *node_ptr = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 2082: 
 2083:          nodeNeighNodes[idxNode] = node_ptr;
 2084:          node.nodes = &(nodeNeighNodes[idxNode]);
 2085: 
 2086:          node_ptr->wind_angle = wind_rotate_angle[i];
 2087:       }
 2088: 
 2089:       // Element **elements; // pointer to the elements connected to this node
 2090:       // int numElements;   // number of elements shared by this node
 2091: 
 2092:       node.p.x = node_coords[i * 3];
 2093:       node.p.y = node_coords[i * 3 + 1];
 2094:       node.p.z = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2095:       node.depth = node_coords[i * 3 + 2];
 2096: 
 2097:       // Links the node to the boundary information
 2098:       if (isbnd[i] >= 0) {
 2099:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2100:          if (isbnd[i]>0) {
 2101: 
 2102:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2103:             node.nodeBnd->segment->ifltype = isbnd[i];
 2104: 
 2105:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2106:             node.nodeBnd->segment->clen  = nan("1");
 2107:             node.nodeBnd->segment->carea = nan("1");
 2108: 
 2109:          }
 2110:          else {
 2111:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2112:          }
 2113:          
 2114:          idxNodeBoundary++;
 2115:       }
 2116:       else {
 2117:          node.nodeBnd = nullptr;
 2118:       }
 2119: 
 2120: // XXXX
 2121: constexpr double rot_per = 3000.0;
 2122: constexpr double rot_f = 2.0*pi/rot_per;
 2123: for (int k = 0; k < nvrt; k++) {node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0};}
 2124: // XXXXX
 2125:    }
 2126: 
 2127:    nbp = idxNodeBoundary;
 2128: 
 2129:    printf("Processing %d sides\n", ns);
 2130:    int idxSideBoundary = 0;
 2131:    for (int i = 0; i < ns; i++)
 2132:    {
 2133:       Side &side = localSideData[i];
 2134:       side.idx = i;
 2135:       // finding the pointer to the nodes that form the side
 2136:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2137:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2138: 
 2139:       const int locidx_n1 = localNodeIndices[idx_n1];
 2140:       const int locidx_n2 = localNodeIndices[idx_n2];
 2141:       const int part_n1 =   localNodePart[idx_n1];
 2142:       const int part_n2 =   localNodePart[idx_n2];
 2143: 
 2144:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2145:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2146: 
 2147:       // Normal vector to the side
 2148:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2149:       const double norm = sqrt(dot(side.n, side.n));
 2150:       side.n = side.n/norm;
 2151: 
 2152:       // Side boundary type
 2153:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 2154:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 2155:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2156:       
 2157:       if (n1bnd != nullptr || n2bnd != nullptr) 
 2158:       {
 2159:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2160:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2161:          else                  side.sideBnd->segment = n2bnd->segment;
 2162:          side.sideBnd->side = &side;
 2163:          idxSideBoundary++;
 2164:       }
 2165:       else side.sideBnd = nullptr;
 2166: 
 2167:       // finding the pointer to the elements that share the side
 2168:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2169:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2170: 
 2171:       if (idx_e1 > -1) {
 2172:          const int locidx_e1 = localElemIndices[idx_e1];
 2173:          const int part_e1 =  localElemPart[idx_e1];
 2174:          side.elems[0] = (Element *)&(elems[part_e1][locidx_e1]);
 2175:       }
 2176:       else {
 2177:          side.elems[0] = nullptr;
 2178:       }
 2179: 
 2180:       if (idx_e2 > -1) {
 2181:          const int locidx_e2 = localElemIndices[idx_e2];
 2182:          const int part_e2 =  localElemPart[idx_e2];
 2183:          side.elems[1] = (Element *)&(elems[part_e2][locidx_e2]);
 2184:       }
 2185:       else {
 2186:          side.elems[1] = nullptr;
 2187:       }
 2188: 
 2189: 
 2190: 
 2191:       // Compute the center of the side
 2192:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2193: 
 2194: // XXXX
 2195: constexpr double rot_per=3000.0;
 2196: constexpr double rot_f=2.0*pi/rot_per;
 2197: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2198: // XXXXX      
 2199: 
 2200:       // Compute the z level at the center of the side
 2201:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->znl[k] + side.n2->znl[k]);
 2202: 
 2203:       // Compute the length of the side
 2204:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2205:       side.length = sqrt(dot(vLen, vLen));
 2206: 
 2207:    }
 2208: 
 2209:    printf("Processing %d elements\n", ne);
 2210:    for (int i = 0; i < ne; i++)
 2211:    {
 2212:       Element &elem = localElemData[i];
 2213:       elem.idx = i;
 2214:       for (int j = 0; j < i34[i]; j++) {
 2215:          const int idxNode = elnode[i*4 + j];  
 2216:          const int idxSide = elside[i*4 + j];
 2217:          
 2218:          elem.nodes[j] = (Node *)&(nodes[localElemPart[idxNode]][localElemIndices[idxNode]]);
 2219:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2220: 
 2221:          // Find the neighboring element  
 2222:          if (elem.sides[j]->elems[0] == &elem) {
 2223:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2224:          }
 2225:          else {
 2226:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2227:          }
 2228:       }
 2229: 
 2230:       
 2231: 
 2232:       elem.i34 = i34[i];
 2233: 
 2234:       // Compute the centroid of the element and its depth
 2235:       Vector2 center = {0.0, 0.0};
 2236:       elem.depth = 0.0;
 2237:       for (int j = 0; j < i34[i]; j++) {
 2238:          center += elem.nodes[j]->p2()/i34[i];
 2239:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2240:       }
 2241:       elem.center.x = center.x;
 2242:       elem.center.y = center.y;
 2243:       
 2244:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2245:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2246: 
 2247:       elem.area = elem.computeSignedArea(); 
 2248:       elem.radius = sqrt(elem.area)/pi; 
 2249:       
 2250:       // Determines which way the normal vector to each side is oriented.
 2251:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2252:       for (int j = 0; j < i34[i]; j++)  
 2253:       {
 2254:          if (elem.sides[j]->elems[0] == &elem) {
 2255:             elem.ssign[j] =  1.0;
 2256:          }
 2257:          else {
 2258:             elem.ssign[j] = -1.0;
 2259:          }
 2260: 
 2261:       }
 2262: 
 2263:       // Derivatives of shape functions
 2264:       //  For ics=2, this is done inside element/ll frame XXX
 2265:       //  For quads, the derivative is evaluated at centroid
 2266:       const int i34 = elem.i34;
 2267:       for (int j = 0; j < i34; j++) {
 2268:          const double area = elem.area;
 2269:          const int id2 = elem.nxq(1 + j);
 2270:          const int id3 = elem.nxq(2 + j);
 2271:          const int id4 = elem.nxq(3 + j);
 2272:          if (elem.isTri()) {
 2273:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2274:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2275:             // da1/dx = (y1 - y2)/(2*area)
 2276:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2277:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2278:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2279:          }
 2280:          else  { // Quad; evaluate at centroid
 2281:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2282:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2283:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2284:          } // if Tri
 2285: 
 2286:       } // for j
 2287: 
 2288:    }
 2289: 
 2290: 
 2291: 
 2292:    
 2293: }
 2294: 
 2295: 
 2296: __global__ void setupCoefficientMatrixAndRHS(double time) {
 2297: // Setup coefficient matrix, sparsem, for the shallow water wave equation
 2298: // No elevation essential b.c. are imposed yet but other b.c. is imposed
 2299: // 
 2300: // This kernel is called for all nodes.
 2301: 
 2302:    int in = 1; //XXX blockIdx.x * blockDim.x + threadIdx.x;
 2303: 
 2304:    Node *node1 = &(mesh->localNodeData[in]);
 2305: 
 2306: 
 2307:    node1->clearMatrixRow();
 2308:    node1->qel = 0.0;
 2309: 
 2310:    // THIS IS FOR STRUCTURES XXX
 2311:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 2312: 
 2313: 
 2314:    for (int j=0; j<node1->numElements; j++) {
 2315:       // For each element connected to the node...
 2316: 
 2317:       Element *elem = node1->elements[j];
 2318: 
 2319: 
 2320:       // Compute the average gravity
 2321:       const double grav3 = elem->mean(&Node::grav2);
 2322: 
 2323:       // Look at the documentation for the description of the terms in the following integrals
 2324: 
 2325:       // Integral I_1 
 2326:       // \bar{\breve{H}} 
 2327:       const double hhatb = elem->mean(&Side::hhat);        
 2328: 
 2329:       assert((hhatb >= 0.0 || ihh != 1) && "Invalid hhat");
 2330: 
 2331:       const int id1 = elem->nodeLocalIdx(node1); 
 2332:       const double area = elem->area;
 2333: 
 2334:       if (elem->isTri()) {
 2335: 
 2336:          // To clarify the notation in this section: 
 2337:          //   i standtimes for the node under consideration (node1)
 2338:          //   j (node2) and k (node3) are the other nodes of the triangle.
 2339:          const int id2 = elem->nxq(1 + id1);
 2340:          const int id3 = elem->nxq(2 + id1);
 2341:          Node *node2 = elem->nodes[id2];
 2342:          Node *node3 = elem->nodes[id3];
 2343: 
 2344:          const Point2 x1 = node1->p2();
 2345:          const Point2 x2 = node2->p2();
 2346:          const Point2 x3 = node3->p2();
 2347: 
 2348:          // integral of phi_i*phi_j
 2349:          const double ipp_ii = (1.0/6.0 )*area;
 2350:          const double ipp_ij = (1.0/12.0)*area;
 2351:          const double ipp_ik = (1.0/12.0)*area;
 2352: 
 2353:          // integral of [(grad phi_i) * (grad phi_j)]
 2354:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 2355:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 2356:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 2357: 
 2358:          // Computes the different components of integral I_1 of each node with respect to node i.
 2359:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 2360:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 2361:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 2362: 
 2363:          node1->addToSparseMatrix(node1, I1_ii);
 2364:          node1->addToSparseMatrix(node2, I1_ij); 
 2365:          node1->addToSparseMatrix(node3, I1_ik);
 2366:      
 2367:       }
 2368:       else { // Quad
 2369:          // XXX IMPLEMENT THIS
 2370:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2371:       } 
 2372: 
 2373:  
 2374:       // Integral I_4
 2375:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 2376:       // Where
 2377:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 2378: 
 2379:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 2380:       // of U over the element.
 2381:       Vector2 Umean = {0.0, 0.0};
 2382:       for (int m=0; m<elem->i34; m++) {      
 2383:          const Side *side = elem->sides[m];
 2384: 
 2385:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 2386:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 2387:       }
 2388:       Umean = Umean/elem->i34;
 2389: 
 2390:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 2391: 
 2392:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 2393:       const double I_4_1 = dot(gradPhi_1, Umean);
 2394: 
 2395:       // Integral of \nabla\phi_i \cdot \pmb{E}
 2396:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 2397:      
 2398:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);
 2399:       
 2400: 
 2401:       // Additional terms 
 2402:       double vnorm = 0.0;
 2403:       if (imm == 2)  { // Pre-compute vnorm on the element
 2404:          Vector3 ubed;
 2405:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 2406: 
 2407:          Vector3 gradP(0.0, 0.0, 1.0);
 2408:          for (int m=0; m < elem->i34; m++) {
 2409:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 2410:            gradP += toVector3(gradP_2D, 0.0);
 2411:          }   
 2412:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 2413:       } // imm==2
 2414: 
 2415:       if (elem->isTri()) {
 2416:          for (int l=0; l<3; l++) {
 2417:            double fac;
 2418: 
 2419:            Node *node = elem->nodes[l];
 2420: 
 2421:            (node == node1)? fac=2.0 : fac=1.0;
 2422: 
 2423:            if (imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 2424:            else        node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 2425:            
 2426:          }
 2427: 
 2428:          if (elem->idry == 0) {
 2429:            const Vector2 gradEta = elem->nodes[0]->eta2*elem->gradPhi[0] +
 2430:                                    elem->nodes[1]->eta2*elem->gradPhi[1] +
 2431:                                    elem->nodes[2]->eta2*elem->gradPhi[2];
 2432: 
 2433:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 2434:          }
 2435: 
 2436:       } // isTri
 2437:       else { // isQuad
 2438:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2439:          // for (int l=0; l<4; l++) {
 2440:          //   const Node *node = elem->nodes[l];
 2441: 
 2442:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 2443:          //   else        tmp2 = node->bdef2 - node->bdef1;
 2444: 
 2445:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 2446:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 2447:          // }
 2448: 
 2449:       } // isQuad
 2450: 
 2451: 
 2452: 
 2453:       node1->qel += (dt/elem->i34)*elem->vsource;
 2454: 
 2455:    } // for all elements connected to the node
 2456:    
 2457: 
 2458: 
 2459:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 2460:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 2461:    NodeBoundary *nodeBnd = node1->nodeBnd;
 2462:    if (nodeBnd != nullptr)  { 
 2463:       // If it is an open boundary node...
 2464: 
 2465:       // At least one open bnd side, maybe two
 2466:       for (int l=0; l<2; l++) { 
 2467: 
 2468:          // Gets each of the sides sharing the node. 
 2469:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 2470: 
 2471:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 2472: 
 2473:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 2474: 
 2475: 
 2476:          if (sideBnd != nullptr) {
 2477:             // If the side is on a boundary...
 2478: 
 2479:             // Get the boundary segment
 2480:             const BoundarySegment *sideSegment = sideBnd->segment;
 2481:             const Side *side = sideBnd->side;
 2482: 
 2483:             // Integral I_3
 2484:             if (sideSegment->ifltype != 0) {
 2485:             // Natural or Flather b.c.
 2486: 
 2487:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 2488:                // especially for Flather b.c.
 2489:                double ri3 = 0.0;
 2490:                if (side->idry != 1) {
 2491:                   // If the side is not dry
 2492:                   
 2493:                   // Computes the side flux of (uth, vth)
 2494:                   double Vn = 0.0;
 2495:                   for (int k = side->kb; k<nvrt-1; k++) {
 2496:                      // uth, vth in lat/lon frame if ics=2
 2497:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 2498:                      const double vn1 = dot(side->uth[k  ], side->n); // outer normal
 2499:                      const double vn2 = dot(side->uth[k+1], side->n);
 2500: 
 2501:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 2502:                   }
 2503: 
 2504:                   ri3 = 0.5*side->length*Vn;
 2505:                }
 2506: 
 2507:                if (sideSegment->ifltype == -1) { // Flather 1
 2508: 
 2509:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 2510:                   assert(side->depth > 0.0 && "Negative depth at Flather boundary");
 2511: 
 2512:                   const double con0 = (1.0/6.0)*side->length*sqrt(grav*side->depth); // For coefficient matrix
 2513:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 2514:                   
 2515:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 2516:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 2517: 
 2518:                } 
 2519:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 2520:                   // Reset ri3
 2521:                   ri3 = 0.0;
 2522: 
 2523:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 2524: 
 2525:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 2526: 
 2527:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 2528:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 2529: 
 2530:                   const double con0 = (1.0/6.0)*side->length*tmp*thetai*dt;
 2531:                   node1->addToSparseMatrix(node1, con0*2.0);
 2532:                   node1->addToSparseMatrix(node2, con0);
 2533: 
 2534:                } // if Flather or Discharge
 2535: 
 2536:                node1->qel -= thetai*dt*ri3;
 2537: 
 2538:             } // I_3
 2539:           
 2540: 
 2541:             // Integral I_5
 2542:             if(side->idry != 1) {
 2543: 
 2544:                const double Unbar = dot(side->U, side->n);
 2545: 
 2546:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->length*Unbar;
 2547:                
 2548:             } // I_5
 2549: 
 2550:          } // if is boundary side
 2551: 
 2552:       } // for l
 2553: 
 2554:    } // if isbnd
 2555: 
 2556: }
 2557: 
 2558: 
 2559: extern "C" {
 2560:    __global__ void backtrackAllNodes(void) {
 2561: 
 2562:       // max/min # of sub-divisions
 2563:       const int ndelt_max = max(1.0, dt/dtb_min);
 2564:       const int ndelt_min = max(1.0, dt/dtb_max); 
 2565: 
 2566:       // Removed all references to swild98 XXX
 2567:       // swild98=0.d0 !init
 2568: 
 2569:       SIDE(side);
 2570: 
 2571:       if (side - mesh->localSideData >= mesh->ns) return;
 2572: 
 2573:       const int kb = side->kb;
 2574: 
 2575:       // Initialize btrack velocities to the actual velocities at the side 
 2576:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 2577: 
 2578:       if (side->idry == 1) return;
 2579: 
 2580:       // Checks that at least one element is not dry
 2581:       const Element *elem1 = side->elems[0];
 2582:       const Element *elem2 = side->elems[1];
 2583:       assert ((elem1 != nullptr && !(elem1->idry)) || (elem2 != nullptr && !(elem2->idry)) && "backtrackAllNodes: non dry side without two dry elements.");
 2584: 
 2585:       // XXXXXX
 2586:       // !swild_tmp to store global coord. of the starting side
 2587:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 2588:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 2589:       // !Use sframe2 
 2590:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 2591: 
 2592: 
 2593:       for (int k = kb; k < nvrt; k++) {
 2594:       //  Initialize (xt,yt,zt), nnel and vel.
 2595:       //  For ics=2, the coordinates are in local frames
 2596:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 2597: 
 2598: 
 2599:          const int iadvf = side->iadv();  // Advection flag
 2600: 
 2601:          Point3 xt;
 2602:          if constexpr(ics==1) {
 2603:             xt = side->center3D(k); 
 2604:          }
 2605:          else // lat/lon; in side lat/lon frame
 2606:          {
 2607:          // XXX IMPLEMENT THIS
 2608:       //          xt=0.d0
 2609:       //          yt=0.d0
 2610:       //          !centroid coord. for nudging
 2611:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 2612:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 2613:          }  // ics
 2614: 
 2615: 
 2616:          // Velocity at the side (in ll frame for ics, same vertical direction)
 2617:          // XXX IS THIS NECESSARY?
 2618:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 2619: 
 2620:          // If on land or open boundary...
 2621:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 2622:          
 2623:          const double vmag = length(toVector2(u_int));
 2624: 
 2625:          if (vmag <= velmin_btrack) {
 2626:             // No activity 
 2627: 
 2628:             side->btu[k] = side->u2[k];
 2629: 
 2630: 
 2631:          } else {  // do btrack
 2632: 
 2633:             // Compute number of sub-divisions based on local gradients 
 2634:             // XXX IS THIS NECESSARY?
 2635:             double suma = 0.0;
 2636:             int icount = 0;
 2637:             for (int ii=0; ii<2; ii++) {
 2638: 
 2639:                const Element *elem = side->elems[ii];
 2640:                  
 2641:                if (elem == nullptr) continue;
 2642: 
 2643:                icount++;
 2644: 
 2645:                // Not strictly along z; in ll frame for ics=2
 2646: 
 2647:                double utmp[4];
 2648:                double vtmp[4];
 2649:                for (int jj = 0; jj < elem->i34; jj++) {
 2650: 
 2651:                   const Node *node = elem->nodes[jj];
 2652: 
 2653:                   if constexpr(ics==1) {
 2654:                      utmp[jj] = node->u2[k].x;
 2655:                      vtmp[jj] = node->u2[k].y;  
 2656:                   } else {
 2657:                      // XXX IMPLEMENT THIS
 2658:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 2659:                   }
 2660:                } // for jj
 2661: 
 2662:                const Vector2 grad_u = elem->grad(utmp); 
 2663:                const Vector2 grad_v = elem->grad(vtmp);
 2664: 
 2665:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 2666:             } // for ii
 2667: 
 2668:             assert(icount > 0 && "Impossible 77");
 2669: 
 2670:             // '4' is somewhat arbitrary
 2671:             const int ndelt = max(ndelt_min, min(ndelt_max, int(suma/icount)*4)); // >=1
 2672:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 2673: 
 2674: 
 2675:             // Perturb starting pt to avoid underflow 
 2676:             // XXX I don't think this is needed with the current implementation
 2677:             // eps=btrack_nudge
 2678:             // if constexpr(ics==1) {
 2679:             //    xt=(1.d0-eps)*xt+eps*xctr(nnel)
 2680:             //    yt=(1.d0-eps)*yt+eps*yctr(nnel)
 2681:             // } else { //lat/lon
 2682:             //    xt=(1.d0-eps)*xt+eps*xctr2
 2683:             //    yt=(1.d0-eps)*yt+eps*yctr2
 2684:             // } // ics
 2685: 
 2686:          
 2687:             // call btrack(l,ipsgb,ifl_bnd,j,iadvf,swild_tmp,swild10_tmp, dtbk,time_rm,time_rm2,uuint,vvint,wwint,nnel,jlev,xt,yt,zt,swild3,ltmp)
 2688: 
 2689:                
 2690:          } // if vmag (do backtrack)
 2691: 
 2692:       } // for j=jmin,nvrt-1
 2693: 
 2694:    }
 2695: } // extern "C"
