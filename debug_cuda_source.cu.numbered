 1145:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1146:       // Compute the different time ramps used in the code 
 1147:       // This function is performed by just one thread
 1148: 
 1149:       if constexpr(ibc == 0) {
 1150:          if (drampbc > 0.0) {
 1151:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1152:          } else {
 1153:             rampbc = 1.0;
 1154:          }
 1155: 
 1156:          if (nws != 0 && drampwind > 0.0) {
 1157:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1158:          } else {
 1159:             rampwind = 1.0;
 1160:          }
 1161:       }
 1162: 
 1163:       if (drampwafo > 0.0) {
 1164:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1165:       } else {
 1166:          rampwafo = 1.0;
 1167:       }
 1168: 
 1169:       // For source/sinks
 1170:       if (if_source && dramp_ss > 0.0) {
 1171:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1172:       } else {
 1173:          ramp_ss = 1.0;
 1174:       }
 1175: 
 1176:       if (dramp > 0.0) {
 1177:          ramp = tanh(2.0*time/86400.0/dramp);
 1178:       } else {
 1179:          ramp = 1.0;
 1180:       }
 1181: 
 1182:       printf("computeTimeRamps: i = %d, nws = %d, if_source = %d, drampbc = %f, drampwind = %f, drampwafo = %f, dramp_ss = %f, dramp = %f\n", 
 1183:              threadIdx.x + blockIdx.x * blockDim.x, nws, if_source, drampbc, drampwind, drampwafo, dramp_ss, dramp);
 1184:    }
