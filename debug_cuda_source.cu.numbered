  223: // Polynomial class
  224: template<int grade>
  225: struct Polynomial {
  226:     // Static assertion to give a clear error message at compile time
  227:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  228: };
  229: 
  230: 
  231: // Explicit specialization for grade 4
  232: template<>
  233: struct Polynomial<4> {
  234:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  235: 
  236:    // Constructor from coefficients
  237:    __device__ __host__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  238: 
  239:    __device__ __host__ __forceinline__ double eval(double x) const {
  240:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  241:    }
  242: };
