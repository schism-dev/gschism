 1130:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1131:       // Compute the different time ramps used in the code 
 1132:       // This function is performed by just one thread
 1133: 
 1134:       if constexpr(ibc == 0) {
 1135:          if (drampbc > 0.0) {
 1136:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1137:          } else {
 1138:             rampbc = 1.0;
 1139:          }
 1140: 
 1141:          if (nws != 0 && drampwind > 0.0) {
 1142:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1143:          } else {
 1144:             rampwind = 1.0;
 1145:          }
 1146:       }
 1147: 
 1148:       if (drampwafo > 0.0) {
 1149:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1150:       } else {
 1151:          rampwafo = 1.0;
 1152:       }
 1153: 
 1154:       // For source/sinks
 1155:       if (if_source && dramp_ss > 0.0) {
 1156:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1157:       } else {
 1158:          ramp_ss = 1.0;
 1159:       }
 1160: 
 1161:       if (dramp > 0.0) {
 1162:          ramp = tanh(2.0*time/86400.0/dramp);
 1163:       } else {
 1164:          ramp = 1.0;
 1165:       }
 1166: 
 1167:       printf("computeTimeRamps: i = %d, nws = %d, if_source = %d, drampbc = %f, drampwind = %f, drampwafo = %f, dramp_ss = %f, dramp = %f\n", 
 1168:              threadIdx.x + blockIdx.x * blockDim.x, nws, if_source, drampbc, drampwind, drampwafo, dramp_ss, dramp);
 1169:    }
