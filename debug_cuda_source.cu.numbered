 1675: /**
 1676:  * This method performs backtracking from the side center until a time -dt back in time 
 1677:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 1678:  * intermediate point.
 1679:  *
 1680:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 1681:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 1682:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 1683:  * remaining time.
 1684:  * 
 1685:  * NOTE: Runge-Kutta is not implemented yet. XXX
 1686:  * 
 1687:  * @param uuint, vvint, wwint: Velocities at the final point
 1688:  * @param jlev: Level at which the backtracking is performed
 1689:  * @param dt, dtbk: Tracking timesteps
 1690:  * @param sclr: Array for backtracked values
 1691:  * @return: True if the backtracking was successful, false otherwise
 1692:  */
 1693: __inline__ __device__ bool Side::btrack(
 1694:       int jlev,
 1695:       double dt,            // Tracking time
 1696:       double dtbk,          // Tracking timestep
 1697:       double* sclr,         // Array for backtracked values
 1698:       Vector3 &u_int
 1699: ) const {
 1700: 
 1701:    // Start from side center
 1702:    Point3 x0 = {center.x, center.y, zc[jlev]};
 1703:  
 1704: 
 1705:    double time_rm = dt; // Remaining time
 1706: 
 1707: 
 1708:    // // Initialize outputs
 1709:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 1710:    //    sclr[i] = 0.0;
 1711:    // }
 1712: 
 1713: 
 1714:    // Initial velocities
 1715:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 1716: 
 1717:    // Find the element that is in the direction opposite to the velocity
 1718:    Element* curElem = findElementTowards({u_int.x, u_int.y});
 1719: 
 1720: printf("$$$  %d, %d, %.5f, %.5f\n",  curElem->idx,idx, x0.x, x0.y)   ;
 1721:    const int MAX_ITERATIONS = 100000; // XXX 1000
 1722:    Element* nextElem = curElem;
 1723:    int iter = 0;
 1724:    while(true) {
 1725:       // Calculate timestep
 1726:       double dtb = min(dtbk, time_rm);
 1727: 
 1728:       // Next point in the backtracking curve
 1729:       Point3 xt = x0 - dtb*u_int;
 1730: 
 1731:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb);
 1732:       assert(found && "Backtracking failed in btrack");
 1733: // printf("<>T = %f, %f %f %f\n", time_rm - dtb, xt, yt, zt);
 1734:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 1735:                       // then time_rm needs to be increased by the unused time.
 1736: 
 1737: 
 1738:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 1739: 
 1740:       // The current point becomes the next segment's starting point.
 1741:       x0 = xt;
 1742:  
 1743:       curElem = nextElem;
 1744: 
 1745:       iter++;
 1746:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 1747:    }
 1748: 
 1749: 
 1750: }
 1751: 
 1752: 
