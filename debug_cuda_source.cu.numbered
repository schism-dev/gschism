 4454:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 4455:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 4456:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 4457:                   endif
 4458:                 enddo  !vertical layers
 4459:               enddo !j=1,i34(ie) ! side
 4460:             endif !order of accuracy
