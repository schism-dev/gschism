 1018:    // }
 1019: 
 1020:    // // Get's the global index of local side idx
 1021:    // __device__ int getGlobalSideIndex(int idx) {
 1022:    //    return idx + partNum * max_ns;
 1023:    // }  
 1024: 
 1025:    __device__ Mesh(int partNum,
 1026:                    int npgb, int negb, int nsgb, 
 1027:                    int np, int ne, int ns, int nvrt, int kz,
 1028:                    int max_np, int max_ne, int max_ns, int nseg,
 1029:                    const Node **nodesPtr, const Element **elemsPtr, const Side **sidesPtr,
