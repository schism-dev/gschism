 4761: __global__ void computeMatrixProductAndDotProducts() {
 4762:    // Computes A*p, r'Mr and p'Ap
 4763: 
 4764:    // 1) shared buffer: first half for rMr, second for pAp
 4765:    __shared__ double sdata[2*BLOCK_SIZE];
 4766:    double* s_rMr = sdata;
 4767:    double* s_pAp = sdata + BLOCK_SIZE;
 4768: 
 4769:    // 2) get your node pointer
 4770:    NODE(node);  
 4771:    const int tid = threadIdx.x;
 4772: 
 4773:    const double diag = node->coeffDiag;
 4774:    const double r    = node->mR;
 4775:    const double p    = node->mP;  
 4776: 
 4777:    // apply preconditioner on the fly:
 4778:    const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 4779: 
 4780: 
 4781:    // 4) compute sp = A.p
 4782:    double Ap = node->coeffDiag * node->mP;
 4783:    #pragma unroll
 4784:    for (int j = 0; j < node->numNodes; ++j) {
 4785:       const Node *nbNode = node->nodes[j];
 4786:       Ap += node->coeffMatrix[j] * nbNode->mP;
 4787:    }
 4788:    node->mAp = Ap;
 4789:     
 4790: 
 4791:    // 5) dot-products individual products (r'Mr, p'Ap)
 4792:    const double l_rMr = r*Mr;  // r'Mr
 4793:    const double l_pAp = p*Ap;  // p'Ap
 4794: 
 4795:    // 6) write into shared mem
 4796:    s_rMr[tid] = l_rMr;
 4797:    s_pAp[tid] = l_pAp;
 4798:    __syncthreads();
 4799: 
 4800:    // 7) block-wide tree reduction
 4801:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 4802:       if (tid < stride) {
 4803:          s_rMr[tid] += s_rMr[tid + stride];
 4804:          s_pAp[tid] += s_pAp[tid + stride];
 4805:       }
 4806:       __syncthreads();
 4807:    }
 4808: 
 4809:    // 8) thread 0 atomically accumulates into the globals
 4810:    // XXX: This is slower than it needs to be, but it is simple and works
 4811:    if (tid == 0) {
 4812:       atomicAdd(&rMr_old, s_rMr[0]);
 4813:       atomicAdd(&pAp, s_pAp[0]);
 4814:    }   
 4815: }
 4816: 
 4817: 
 4818: __global__ void updateSolutionAndDotProducts() {
 4819:     extern __shared__ double sdata[];       // 2*BLOCK_SIZE doubles
 4820:     double* s_rMr = sdata;                  // [0 .. BLOCK_SIZE-1]
 4821:     double* s_rr  = sdata + BLOCK_SIZE;     // [BLOCK_SIZE .. 2*BLOCK_SIZE-1]
 4822: 
 4823:     // get node & bounds-check:
 4824:     NODE(node);
 4825:     const int tid = threadIdx.x;
 4826: 
 4827:     // Compute alpha
 4828:     const double alpha = rMr_old/pAp;
 4829: 
 4830:     // load scalars
 4831:     const double diag = node->coeffDiag;
 4832:     const double p    = node->mP;
 4833:     const double Ap   = node->mAp;
 4834:     const double x    = node->mX;
 4835:     const double r    = node->mR;
 4836: 
 4837:     // 1) update solution & residual
 4838:     const double x_new = x + alpha*p;
 4839:     const double r_new = r - alpha*Ap;
 4840:     node->mX = x_new;
 4841:     node->mR = r_new;
 4842: 
 4843:     // 2) apply Jacobi preconditioner on the fly
 4844:     const double Mr_new = r_new/diag;
 4845: 
 4846:     // 3) local contributions for the two dot-products
 4847:     const double l_rMr = r_new*Mr_new;  // r'M^-1r
 4848:     const double l_rr  = r_new*r_new;   // r'r
 4849: 
 4850:     // 4) write into shared-mem
 4851:     s_rMr[tid] = l_rMr;
 4852:     s_rr [tid] = l_rr;
 4853:     __syncthreads();
 4854: 
 4855:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 4856:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 4857:         if (tid < stride) {
 4858:             s_rMr[tid] += s_rMr[tid + stride];
 4859:             s_rr [tid] += s_rr [tid  + stride];
 4860:         }
 4861:         __syncthreads();
 4862:     }
 4863: 
 4864:     // 6) thread 0 atomically folds into the global accumulators
 4865:     if (tid == 0) {
 4866:         atomicAdd(&rMr_new, s_rMr[0]);
 4867:         atomicAdd(&rr,      s_rr [0]);
 4868:     }
 4869: }
 4870: 
 4871: 
 4872: __global__ void updateSearchDirection() {
 4873:     NODE(node);
 4874: 
 4875:     // recompute z on-the-fly
 4876:     const double z = node->mR / node->coeffDiag;
 4877:     const double p = node->mP;
 4878: 
 4879:     const double beta = rMr_new/rMr_old;
 4880: 
 4881:     // p =z + beta*p
 4882:     node->mP = z + beta*p;
 4883: }
 4884: 
