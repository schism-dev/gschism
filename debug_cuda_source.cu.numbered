  717:    double veg_nv;
  718:    double veg_di;
  719:    double veg_Cd;
  720:    double veg_h_unbent;
  721:    double veg_di_unbent;
  722:    double veg_nv_unbent;
  723:    double veg_alpha_vert_mean;
  724:    double veg_alpha0;
  725:    double veg_alpha3D[nvrt];
  726: 
  727:    // Bottom drag parameters
