 1121: // Helper functions for computing the local node index at a given offset from another.
 1122: __device__ __inline__ int nxq(int offset, int index, int size) {
 1123:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1124:    // to the index to make it positive
 1125:    assert(index + offset + 16*size >= 0);
 1126:    return (index + offset + 16*size) % size;  
 1127: }
 1128: 
 1129: __device__ __inline__ int nxq(int index, int size) {
 1130:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1131:    // to the index to make it positive
 1132:    assert(index + 16*size >= 0);
 1133:    return (index + 16*size) % size; 
 1134: }
