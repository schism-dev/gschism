 2968: // //                   is used below bottom or above surface.
 2969: // //       ibelow: flag indicating if zt is below za(k1)
 2970: // //
 2971: 
 2972: //    assert(k1 >= 0 && k2 < nvrt && "vertLinearInterp: k1 or k2 out of bounds");
 2973: //    assert(k1 <= k2 && "vertLinearInterp: k1 > k2");
 2974:    
 2975: //    ibelow = 0;
 2976: 
 2977: //    if (zt < za[k1]) {
 2978: //       // Below bottom
 2979: //       ibelow = 1;
 2980: //       for (int i = 0; i < nc; i++) s_out[i] = s_in[i + k1*nc];
 2981: 
 2982: //    } else if(zt>=za[k2]) {
 2983: //       // Above surface
 2984: //       for (int i = 0; i < nc; i++) s_out[i] = s_in[i + k2*nc];
 2985: 
 2986: //    } else {
 2987: //       // Normal case (between bottom and surface)
 2988:       
 2989: //       // Finds the level index using binary search
 2990: //       int l1 = k1;
 2991: //       int l2 = k2;
 2992: //       int k = (l1 + l2)/2;
 2993: //       while (l2 - l1 > 1) {  // Stop when we have adjacent levels
 2994: //           int k = (l1 + l2)/2;
 2995: //           if (zt >= za[k]) l1 = k;
 2996: //           else             l2 = k;
 2997: //       }
