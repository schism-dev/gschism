 2027: 
 2028: __host__ __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2029: 
 2030: __device__ double Node::compZCoord(int k) const {
 2031:    // Computes the z coordinate at level k.
 2032:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2033:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2034:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2035:    // used 
 2036:    
 2037:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2038:       
 2039:    if (isDry)  return 0.0;
 2040: 
 2041:    if constexpr(ivcor == 2) {
 2042: 
 2043:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2044:       const int kz = mesh->kz;
 2045: 
 2046:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2047:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2048:       // once per time step/node.
 2049:       // CHECK: updateZCoordData
 2050:       if (k == kz)               return -hmod2;
 2051:       else if (k == nvrt-1)      return eta2;
 2052:       else if (k == kb)          return -depth;
 2053:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2054:       else if (k > kz) {
 2055:          const int ksig = k - kz + 1;
 2056: 
 2057:          if (hmod2 <= mesh->h_c) {
 2058:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2059:          } 
 2060:          else if (eta2 <= - mesh->h_c - (depth - mesh->h_c) * mesh->theta_f/mesh->sinh_theta_f) {
 2061:             printf("Please choose larger h_c: %f %f\n", eta2, mesh->h_c);
 2062:             Error("ZCOOR: invalid h_c\n");
 2063:          } 
 2064:          else {
 2065:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2066:                          mesh->h_c * mesh->sigma[ksig] + 
 2067:                          (hmod2 - mesh->h_c) * mesh->cs[ksig];
 2068:          }
 2069:       } else { 
 2070:          Error("ZCOOR: invalid level or coordinate system\n");
 2071:       }
 2072: 
 2073:    }
 2074:    else if constexpr(ivcor == 1) {
 2075:       if (k == kb) return -depth;
 2076:       else if (k == nvrt-1) return eta2;
 2077:       else if (k >= kb) {
 2078:             return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2079:       }
 2080:    }
 2081:    
 2082:    printf("ZCOOR: invalid level or coordinate system\n");
 2083:    return 0.0;
 2084: }
