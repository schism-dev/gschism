 1270: __device__ __inline__ double min3(double a, double b, double c) {
 1271:    return min(a, min(b, c));
 1272: }
 1273: 
 1274: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1275:    return min(a, min(b, min(c, d)));
 1276: }
