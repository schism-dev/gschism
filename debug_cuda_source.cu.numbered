  150: // Polynomial class
  151: template<int grade>
  152: struct Polynomial {
  153:     // Static assertion to give a clear error message at compile time
  154:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  155: };
  156: 
  157: 
  158: // Explicit specialization for grade 4
  159: template<>
  160: struct Polynomial<4> {
  161:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  162: 
  163:    // Constructor from coefficients
  164:    __device__ __host__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  165: 
  166:    __device__ __host__ __forceinline__ double eval(double x) const {
  167:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  168:    }
  169: };
