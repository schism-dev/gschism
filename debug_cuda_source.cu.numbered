 2724: template<int nc>
 2725: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 2726: 
 2727: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 2728: //
 2729: // a,b,c,r: input vectors and are not modified by this program.
 2730: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 2731: // r is the r.h.s.
 2732: // n: actual rank of the system.
 2733: // rows in u() and r();
 2734: // u: output with nc columns (transposed to rows)
 2735: // gam: a working array.
 2736: //
 2737: // NOTES:
 2738: // This is a template function that allows for different numbers of columns in the rhs vector.
 2739: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 2740: 
 2741:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 2742:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 2743: 
 2744:    double bet = b[0];
 2745:    if constexpr (nc == 1) {
 2746:       u[0] = rhs[0]/bet;
 2747:    } else {
 2748:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 2749:    }
 2750: 
 2751:    for (int j = 1; j < n; j++) {
 2752:       gam[j] = c[j-1]/bet;
 2753:       bet = b[j] - a[j]*gam[j];
 2754: 
 2755:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 2756: 
 2757:       if constexpr (nc == 1) {
 2758:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 2759:       } else {
 2760:          for (int k = 0; k < nc; k++) {
 2761:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 2762:          }
 2763:       }
 2764:    }
 2765: 
 2766:    // Back-substitution
 2767:    for (int j=n-1; j>=1; j--) {
 2768:       if constexpr (nc == 1) {
 2769:          u[j] = u[j] - gam[j+1]*u[j-1];
 2770:       } else {
 2771:          for (int k = 0; k < nc; k++) {
 2772:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 2773:          }
 2774:       }
 2775:    }
 2776: }
 2777: 
 2778: 
 2779: 
 2780: 
 2781: // Helper function that contains the core algorithm
 2782: template<typename XAccessor, typename YAccessor>
 2783: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 2784:                                     double  yp_top, double  yp_bot, 
 2785:                                     CubicSpline &spline) {
 2786:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 2787:    // 
 2788:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 2789:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 2790:    //
 2791:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 2792:    // 
 2793:    // Inputs: 
 2794:    //            n: dimension for x etc; # of data pts (>=2);
 2795:    //            getX, getY: functions to access x,y coordinates
 2796:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 2797:    //     Output: 
 2798:    //            spline (CubicSpline): spline structure with x,y,y',y''
 2799: 
 2800:    const int n = k2 - k1 + 1;
 2801:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 2802: 
 2803:    // Allocate memory for the splines
 2804:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 2805:    spline.x   = new double[n];
 2806:    spline.y   = new double[n];
 2807:    spline.yp  = new double[n];
 2808:    spline.ypp = new double[n];
 2809: 
 2810:    for (int k=k1; k<=k2; k++) {
 2811:       spline.x[k] = getX(k);
 2812:       spline.y[k] = getY(k);
 2813:    }
 2814: 
 2815:    // This is to simplify expressions later
 2816:    double *x = spline.x;
 2817:    double *y = spline.y;
 2818: 
 2819:    double *a = nullptr;
 2820:    double *b = nullptr;
 2821:    double *c = nullptr;
 2822:    double *gam = nullptr;
 2823:    double *rhs = nullptr;
 2824:    
 2825: 
 2826:       a = new double[n];   // Lower diagonal
 2827:       b = new double[n];   // Diagonal
 2828:       c = new double[n];   // Upper diagonal
 2829:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 2830:       rhs = new double[n]; // Right-hand side
 2831: 
 2832:    for (int k=k1; k<=k2; k++) {
 2833:       if (k == k1) {
 2834:          // Bottom level
 2835:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 2836:          b[k] = (x[k+1] - x[k])/3.0;
 2837:          c[k] = b[k]/2.0;
 2838:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 2839:       } else if (k == n - 1) {
 2840:          // Top level (surface)
 2841:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 2842:          b[k] = (x[k] - x[k-1])/3.0;
 2843:          a[k] = b[k]/2.0;
 2844:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 2845:       } else {
 2846:          // Intermediate levels
 2847:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 2848:          b[k] = (x[k+1] - x[k-1])/3.0;
 2849:          a[k] = (x[k  ] - x[k-1])/6.0;
 2850:          c[k] = (x[k+1] - x[k  ])/6.0;
 2851:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 2852:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 2853:       }
 2854:    }
 2855: 
 2856:    // Solve the tridiagonal system
 2857:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 2858:    
 2859:    spline.yp[k1] = yp_bot;
 2860:    spline.yp[k2] = yp_top;
 2861: 
 2862:    // Compute rest of 1st derivatives using the splines
 2863:    for (int k=k1+1; k<k2; k++) {
 2864:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 2865:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 2866:    }
 2867:    
 2868:    delete[] a;
 2869:    delete[] b;
 2870:    delete[] c;
 2871:    delete[] gam;
 2872:    delete[] rhs;
 2873: 
 2874: }
 2875: 
 2876: // Array version
 2877: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 2878:                                 double y_top, double y_bot, 
 2879:                                 CubicSpline &spline) {
 2880:    auto getX = [x] (int k) { return x[k]; };
 2881:    auto getY = [y] (int k) { return y[k]; };
 2882:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 2883: }
 2884: 
 2885: // Lambda version - allows custom access patterns
 2886: template<typename XFunc, typename YFunc>
 2887: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 2888:                                 double y_top, double y_bot,
 2889:                                 CubicSpline &spline) {
 2890:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 2891: }
 2892: 
 2893: 
 2894: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 2895: {
 2896:    assert("Not implemented");
 2897: 
 2898:    return 0.0;
 2899: }
