 2055: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2056:                 double *node_coords, double *wind_rotate_angle, 
 2057:                 int *isdel, int *isidenode, int *isbnd,
 2058:                 int *nond, int *nlnd, int *iond, int *ilnd,
 2059:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2060:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2061:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2062:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2063:                 int *localNodePart,     int *localElemPart,     int *localSidePart) {
 2064: 
 2065:    printf("Populating mesh for partition %d, %d, %d\n", partNum, nond, nlnd);
 2066:    printf("DDDD\n");printf("DDDD\n");printf("DDDD\n");printf("DDDD\n");printf("DDDD\n");printf("DDDD\n");printf("DDDD\n");
 2067: 
 2068:    printf("XXX elemsPtr = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2069: 
 2070:    // Horizontal grid
 2071:    printf("Processing %d nodes\n", np);    
 2072: 
 2073: 
 2074:    int idxNodeBoundary = 0;  
 2075:    for (int i = 0; i < np; i++)
 2076:    {
 2077:       Node &node = localNodeData[i];
 2078: 
 2079:       const int idxStart = nodeNeighNodesStart[i];
 2080:       const int idxEnd   = nodeNeighNodesStart[i+1];
 2081:       node.numNodes = idxEnd - idxStart;
 2082:       node.nodes = (Node **)(nodeNeighNodes + idxStart*sizeof(Node *));
 2083:       node.idx = i;
 2084: 
 2085:       
 2086:       // for (int idx = idxStart; idx < idxEnd; idx++) {
 2087:       //    int idxNode = nodeNeighNodesIndices[idx];
 2088: 
 2089:       //    Node *node_ptr = nodes[localNodePart[idxNode]];
 2090:       //    // printf("idx = %d, idxNode = %d, nodes = %p, localNodePart[idxNode] = %d, localNodeIndices[idxNode] = %d\n", idx, idxNode, nodes, localNodePart[idxNode], localNodeIndices[idxNode]);
 2091:       //    // printf("nodeNeighNodes[idxNode] = %d, (nodes[%d][%d]) = %p\n", nodeNeighNodes[idxNode], localNodePart[idxNode], localNodeIndices[idxNode], nodes + idxNode);
 2092: 
 2093:       //    nodeNeighNodes[idxNode] = node_ptr;
 2094:       // }
 2095:       // node.nodes = nodeNeighNodes + idxStart;
 2096: 
 2097:       // node.wind_angle = wind_rotate_angle[i];
 2098: 
 2099:       // Element **elements; // pointer to the elements connected to this node
 2100:       // int numElements;   // number of elements shared by this node
 2101: 
 2102:       node.p.x   = node_coords[i * 3];
 2103:       node.p.y   = node_coords[i * 3 + 1];
 2104:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2105:       node.depth = node_coords[i * 3 + 2];
 2106: 
 2107:       // printf("ZZ elemsPtr = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2108: 
 2109:       // Links the node to the boundary information
 2110:       if (isbnd[i] >= 0) {
 2111:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2112:          if (isbnd[i]>0) {
 2113: 
 2114:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2115:             node.nodeBnd->segment->ifltype = isbnd[i];
 2116: 
 2117:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2118:             node.nodeBnd->segment->clen  = nan("1");
 2119:             node.nodeBnd->segment->carea = nan("1");
 2120: 
 2121:          }
 2122:          else {
 2123:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2124:          }
 2125:          
 2126:          idxNodeBoundary++;
 2127:       }
 2128:       else {
 2129:          node.nodeBnd = nullptr;
 2130:       }
 2131: 
 2132: // XXXX
 2133: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2134: constexpr double rot_per = 3000.0;
 2135: constexpr double rot_f = 2.0*pi/rot_per;
 2136: for (int k = 0; k < nvrt; k++) {node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0};}
 2137: // XXXXX
 2138:    }
 2139: 
 2140:    nbp = idxNodeBoundary;
 2141: 
 2142:    printf("YY elemsPtr = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2143:    printf("Processing %d sides\n", ns);
 2144:    int idxSideBoundary = 0;
 2145:    for (int i = 0; i < ns; i++)
 2146:    {
 2147:       Side &side = localSideData[i];
 2148:       side.idx = i;
 2149:       // finding the pointer to the nodes that form the side
 2150:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2151:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2152: 
 2153:       const int locidx_n1 = localNodeIndices[idx_n1];
 2154:       const int locidx_n2 = localNodeIndices[idx_n2];
 2155:       const int part_n1 =   localNodePart[idx_n1];
 2156:       const int part_n2 =   localNodePart[idx_n2];
 2157: 
 2158:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2159:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2160: 
 2161:       // Normal vector to the side
 2162:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2163:       const double norm = sqrt(dot(side.n, side.n));
 2164:       side.n = side.n/norm;
 2165: 
 2166:       // Side boundary type
 2167:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 2168:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 2169:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2170:       
 2171:       if (n1bnd != nullptr || n2bnd != nullptr) 
 2172:       {
 2173:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2174:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2175:          else                  side.sideBnd->segment = n2bnd->segment;
 2176:          side.sideBnd->side = &side;
 2177:          idxSideBoundary++;
 2178:       }
 2179:       else side.sideBnd = nullptr;
 2180: 
 2181:       // finding the pointer to the elements that share the side
 2182:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2183:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2184: 
 2185:       if (idx_e1 > -1) {
 2186:          const int locidx_e1 = localElemIndices[idx_e1];
 2187:          const int part_e1 =  localElemPart[idx_e1];
 2188:          side.elems[0] = elems[part_e1] + locidx_e1;
 2189:          // printf("s@@ part_e1 = %d, locidx_e1 = %d, elems[part_e1] = %p\n", part_e1, locidx_e1, elems[part_e1]);
 2190:          // // printf("s-- side.elems[0] = %p idx = %d i34 = %d (x,y,z) = (%f,%f,%f) size = %d\n", side.elems[0], side.elems[0]->idx, side.elems[0]->i34, side.elems[0]->center.x, side.elems[0]->center.y, side.elems[0]->center.z, sizeof(Element));
 2191:          // printf("o-- elems = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2192:       }
 2193:       else {
 2194:          side.elems[0] = nullptr;
 2195:       }
 2196: 
 2197:       if (idx_e2 > -1) {
 2198:          const int locidx_e2 = localElemIndices[idx_e2];
 2199:          const int part_e2 =  localElemPart[idx_e2];
 2200:          side.elems[1] = elems[part_e2] + locidx_e2;
 2201:       }
 2202:       else {
 2203:          side.elems[1] = nullptr;
 2204:       }
 2205: 
 2206: 
 2207: 
 2208:       // Compute the center of the side
 2209:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2210: 
 2211: // XXXX
 2212: constexpr double rot_per=3000.0;
 2213: constexpr double rot_f=2.0*pi/rot_per;
 2214: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2215: // XXXXX      
 2216: 
 2217:       // Compute the z level at the center of the side
 2218:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->znl[k] + side.n2->znl[k]);
 2219: 
 2220:       // Compute the length of the side
 2221:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2222:       side.length = sqrt(dot(vLen, vLen));
 2223: 
 2224:    }
 2225: 
 2226:    printf("Processing %d elements\n", ne);
 2227:    for (int i = 0; i < ne; i++)
 2228:    {
 2229:       Element &elem = localElemData[i];
 2230:       elem.idx = i;
 2231:       for (int j = 0; j < i34[i]; j++) {
 2232:          const int idxNode = elnode[i*4 + j];  
 2233:          const int idxSide = elside[i*4 + j];
 2234:          
 2235:          elem.nodes[j] = (Node *)&(nodes[localElemPart[idxNode]][localElemIndices[idxNode]]);
 2236:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2237: 
 2238:          // Find the neighboring element  
 2239:          if (elem.sides[j]->elems[0] == &elem) {
 2240:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2241:          }
 2242:          else {
 2243:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2244:          }
 2245:       }
 2246: 
 2247:       
 2248: 
 2249:       elem.i34 = i34[i];
 2250: 
 2251: // printf("elem = %p, elem.i34 = %d\n", &elem, elem.i34);
 2252: 
 2253:       // Compute the centroid of the element and its depth
 2254:       Vector2 center = {0.0, 0.0};
 2255:       elem.depth = 0.0;
 2256:       for (int j = 0; j < i34[i]; j++) {
 2257:          center += elem.nodes[j]->p2()/i34[i];
 2258:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2259:       }
 2260:       elem.center.x = center.x;
 2261:       elem.center.y = center.y;
 2262: 
 2263:       // printf("elem = %p, i34 = %d, center = (%f,%f,%f)\n", &elem, elem.i34, elem.center.x, elem.center.y, elem.depth);
 2264:       
 2265:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2266:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2267: 
 2268:       elem.area = elem.computeSignedArea(); 
 2269:       elem.radius = sqrt(elem.area)/pi; 
 2270:       
 2271:       // Determines which way the normal vector to each side is oriented.
 2272:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2273:       for (int j = 0; j < i34[i]; j++)  
 2274:       {
 2275:          if (elem.sides[j]->elems[0] == &elem) {
 2276:             elem.ssign[j] =  1.0;
 2277:          }
 2278:          else {
 2279:             elem.ssign[j] = -1.0;
 2280:          }
 2281: 
 2282:       }
 2283: 
 2284:       // Derivatives of shape functions
 2285:       //  For ics=2, this is done inside element/ll frame XXX
 2286:       //  For quads, the derivative is evaluated at centroid
 2287:       const int i34 = elem.i34;
 2288:       for (int j = 0; j < i34; j++) {
 2289:          const double area = elem.area;
 2290:          const int id2 = elem.nxq(1 + j);
 2291:          const int id3 = elem.nxq(2 + j);
 2292:          const int id4 = elem.nxq(3 + j);
 2293:          if (elem.isTri()) {
 2294:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2295:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2296:             // da1/dx = (y1 - y2)/(2*area)
 2297:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2298:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2299:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2300:          }
 2301:          else  { // Quad; evaluate at centroid
 2302:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2303:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2304:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2305:          } // if Tri
 2306: 
 2307:       } // for j
 2308: 
 2309:    }
 2310: 
 2311: 
 2312: 
 2313:    
 2314: }
