  980: 
  981: /**
  982:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
  983:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
  984:    If the segment is completely inside the element, then it returns true.
  985: 
  986:    This function assumes:
  987:    - The initial point is on a side of the element. 
  988:    - Its position is given by parameter t in the range [0,1].
  989:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
  990:       intersects the element (elements are convex).
  991: 
  992:    To find the intersection point, this function does the following:
  993:    - it finds the intersection of the line segment with all the element side lines,
  994:       except for the one that contains the initial point.
  995:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
  996:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
  997:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
  998:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
  999:       track segment is almost parallel to the element side line.
 1000: 
 1001:    Inputs:
 1002:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1003:    @param x2, y2: other end of the line segment
 1004: 
 1005:    Outputs:
 1006:    @param side:  side that intersects the line segment (input and output)
 1007:    @param nextElement (output): element that contains the intersection point
 1008:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1009:    @param zint (input/output): Vertical coordinate of the intersection point
 1010: 
 1011:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1012:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1013:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1014: 
 1015:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1016:    (Delta) being zero.
 1017: 
 1018:    The intersection2 point happens when:
 1019:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1020:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1021:    
 1022:    Assumption: the 4 points (including those of the side segment) are different.
 1023:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1024:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1025:    If true, (xIntersect,yIntersect) is the intersection.				
 1026:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1027: **/
 1028: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1029:                                               double &t, double& tIntersect) {
 1030: 
 1031:    double closest_intersect_t = 1e10;
 1032:    bool found_intersection = false;
 1033: 
 1034:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1035:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1036:    const Point2 x1 = side->point(t);
 1037:    
 1038: 
 1039:    Side *nextSide = nullptr;
 1040: 
 1041:    for (int i = 0; i < i34; i++) {
 1042: 
 1043:       // Element's i-th side 
 1044:       Side *side2 = sides[i];
 1045: 
 1046:       // Skip the side that contains the initial point
 1047:       if (side2 == side) continue;
 1048: 
 1049:       // (x3,y3)-(x4,y4) is the element side line
 1050:       const Point2 x3 = side2->n1->p2();
 1051:       const Point2 x4 = side2->n2->p2();
 1052: 
 1053:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1054:       const double delta = cross(x2 - x1, x3 - x4);
 1055: 
 1056:       if (delta != 0.0) {
 1057: 
 1058:          const double delta1 = cross(x3 - x1, x3 - x4);
 1059:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1060: 
 1061:          // Solves the two linear equations for tt1 and tt2
 1062:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1063:          const double tt2 = delta2/delta;
 1064: 
 1065:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1066:             closest_intersect_t = min(closest_intersect_t, tt1);
 1067:             nextSide = side2;
 1068: 
 1069:             nextElement = nextSide->otherElement(this);
 1070:             tIntersect = max(small, min(tt1, 1.0-small));
 1071:             t = tt2;
 1072: 
 1073:             found_intersection = true;
 1074:          }
 1075:       
 1076:       }
 1077: 
 1078:    }
 1079: 
 1080: 
 1081:    // found_intersection should always be true, since we checked all the sides.  
 1082:    side = nextSide;
 1083: // if (found_intersection) {
 1084: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1085: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1086: // }   
 1087:    return found_intersection;
 1088: }
 1089: 
 1090: 
 1091: 
 1092: 
 1093: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1094:                                               double &t, double& tIntersect) {
 1095: 
 1096:    double closest_intersect_t = 1e10;
 1097:    bool found_intersection = false;
 1098: 
 1099:    for (int i = 0; i < i34; i++) {
 1100: 
 1101:       Side *side2 = sides[i];
 1102: 
 1103:       // (x3,y3)-(x4,y4) is the element side line
 1104:       const Point2 x3 = side2->n1->p2();
 1105:       const Point2 x4 = side2->n2->p2();
 1106: 
 1107:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1108:       const double delta = cross(x2 - x1, x3 - x4);
 1109: 
 1110:       if (delta != 0.0) {
 1111: 
 1112:          const double delta1 = cross(x3 - x1, x3 - x4);
 1113:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1114: 
 1115:          // Solves the two linear equations for tt1 and tt2
 1116:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1117:          const double tt2 = delta2/delta;
 1118: 
 1119:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1120:             closest_intersect_t = min(closest_intersect_t, tt1);
 1121:             side = side2;
 1122:             nextElement = side->otherElement(this);
 1123:             t = tt2;
 1124:             tIntersect = max(small, min(tt1, 1.0-small));
 1125:             found_intersection = true;
 1126:          }
 1127:       
 1128:       }
 1129: 
 1130:    }
 1131: 
 1132: // if (found_intersection) {
 1133: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1134: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1135: // }
 1136: 
 1137:    // found_intersection should always be true, since we checked all the sides.  
 1138:    return found_intersection;
 1139: }
 1140: 
 1141: 
 1142: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1143:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1144: 
 1145:    printf("Tracking segment goes out of water at element %d\n", curElem->idx);
 1146: 
 1147:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1148:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1149:    // curElement.
 1150: 
 1151:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1152:    // And uses this velocity instead to continue the tracking.
 1153: 
 1154:    // computes the intersection point in cartesian coordinates
 1155:    Point2 intersection = nextSide->p_t(tt);
 1156: 
 1157:    // Nudges the point to the barycenter of the element. 
 1158:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1159:    // next segment intersects the element sides.  
 1160:    curElem->nudgeToBarycenter(intersection);
 1161: 
 1162:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1163:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1164:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1165:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1166: 
 1167:    // If the side is an open boundary, the tangential velocity is zero.
 1168:    if (nextSide->isBnd()) vtan = 0.0;
 1169: 
 1170:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1171:    const double us = vtan*nextSide->t().x;
 1172:    const double vs = vtan*nextSide->t().y;
 1173:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1174: 
 1175:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1176:    const double len2 = length(intersection - toPoint2(xt));
 1177:    const double vel2 = u_int.x*u_int.x + u_int.y*u_int.y;        
 1178:    assert(vel2 > 0.0 && "Zero velocity found");
 1179:    dt = dt - sqrt(len2/vel2); 
 1180: 
 1181:    // The end of this tracking segment is now the intersection point.
 1182:    xt = {intersection.x, intersection.y, zint};
 1183:    
 1184:    u_int = {us, vs, ws};
 1185:    
 1186: }
 1187: 
 1188: /**
 1189:  * Tracks a particle through elements and vertical levels in the mesh.
 1190:  * 
 1191:  * @param x0,y0,z0     Starting position coordinates
 1192:  * @param xt,yt,zt     Target position coordinates
 1193:  * @param dtb          Time step for tracking
 1194:  * @param uuint,vvint,wwint Initial velocity components
 1195:  * @param nextElem     Starting/resulting element index
 1196:  * 
 1197:  * @return Status code of type trackExitCodes
 1198:  * 
 1199:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1200:  * of the details are different. The idea is that the code requires less branches and is better fit
 1201:  * for GPU execution.
 1202:  * 
 1203:  * The main ideas here are:
 1204:  * - The starting point is expected to be in the starting element.
 1205:  * - The end point is guaranteed to be inside an element.
 1206:  * - since the starting point is inside the element, there are only two cases: 
 1207:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1208:  *     (b) it does not and (xt,yt) is already in the starting element.
 1209:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1210:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1211:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1212:  * - tt1 can be positive or negative. We only consider the positive values.
 1213:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1214:  * - The next intersection will occur at the smallest positive tt1.
 1215:  * - This intersection will be the next (x0,y0) position.
 1216:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1217:  *   of getting stuck in a loop.
 1218:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1219:  *   was found.
 1220:  */
 1221: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1222:                                                        Element *&nextElem, int &jlev, double &dt) {
 1223: // printf("trackThroughElementsAndLevels: x0=%f, y0=%f, xt=%f, yt=%f\n", x0, y0, xt, yt);
 1224:    // First thing is to check if the target point is inside the element. If it is there is nothing
 1225:    // else to do.
 1226:    if (containsPoint(toPoint2(xt))) {
 1227:       nextElem->interpolateVelocities(xt, u_int);
 1228:       return true;
 1229:    }
 1230: 
 1231:    Side *side = nullptr;
 1232: 
 1233:    // 1. Initial checks
 1234:    // Verify starting element is valid (wet)
 1235:    assert(!nextElem->idry && "Starting element is dry");
 1236: 
 1237:    // Checks if track has a zero length.
 1238:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1239:    assert(len2 > 0.0 && "Zero length track"); 
 1240:    
 1241: 
 1242:    const int MAX_ITERATIONS = 1000;
 1243:    
 1244:    double t;
 1245:    Side *nextSide = nullptr;
 1246:    double tIntersect = 1e10;
 1247:    double zint = x0.z;
 1248: 
 1249:    // Horizontal tracking loop
 1250:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1251:    // (x0,y0) is inside the element but the target point is not.
 1252:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1253:    assert(found_intersection && "No intersection found");
 1254: 
 1255:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1256: 
 1257:    // if the tracking segment goes out of water (either dry or edge boundary)
 1258:    if (isEdgeBoundary(nextSide) || (nextElem->idry)) {
 1259:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1260:       nextElem = this;
 1261:       
 1262:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1263:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1264:       return true;    
 1265:       }
 1266: 
 1267:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1268:    int iterations = 0;
 1269:    while (iterations < MAX_ITERATIONS) {
 1270:       iterations++;
 1271:       
 1272:       Element *curElem = nextElem;
 1273: 
 1274:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1275:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1276: 
 1277:       // If we are already in the target element, we are done.
 1278:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1279:       if (!found_intersection) break;
 1280: 
 1281: 
 1282:   
 1283:       // if the tracking segment goes out of water (either dry or edge boundary).
 1284:       if (curElem->isEdgeBoundary(nextSide) || (nextElem->idry)) {
 1285: 
 1286:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1287: 
 1288:          nextElem = curElem;
 1289: 
 1290:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1291:          // In this case, the caller (btrack) needs to take into account the remaining time.
 1292:          return true;
 1293:       }
 1294:       
 1295:       // Update position and element for next iteration
 1296:       side = nextSide;
 1297: 
 1298:    }
 1299: 
 1300: 
 1301:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 1302: 
 1303:  
 1304:    // Interpolate velocities at the final position. This is a conceptually simple step,
 1305:    // but the function is not simple, because it has to search for the vertical level containing zt.
 1306:    nextElem->interpolateVelocities(xt, u_int);
 1307: 
 1308: 
 1309:    return true;
 1310: }
 1311: 
 1312: 
 1313: 
 1314: 
 1315: __inline__ __device__ double Element::computeSignedArea(void) const {
 1316:    // Compute the area of the element
 1317: 
 1318:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 1319: 
 1320:    // In the quad case we need to add the area of the other triangle.
 1321:    if (isQuad()) {
 1322:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1323:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 1324:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1325:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 1326:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 1327:          Error("Negative area found in quad element");
 1328:       }
 1329:       res += ar1;
 1330:    }
 1331: 
 1332:    return res;
 1333: }
 1334: 
 1335: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 1336:    // In boundary sides, the element 1 is nullptr
 1337:    return side->elems[1] == nullptr; 
 1338: }
 1339: 
 1340: /**
 1341:    Compute the shape coordinates of the point (xt,yt) in the element.
 1342:    @param xt (input): x-coordinate of the point
 1343:    @param shpCoords (output): shape coordinates of the point
 1344:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 1345:    @return true if the point is inside the element, false otherwise
 1346: **/
 1347: __device__ bool Element::computeShapeCoords(Point2 xt, double shpCoords[4],
 1348:                                             bool fixNegshpCoord) const {
 1349: 
 1350:    // Compute the shape coordinates of the point xt in the element.
 1351:    if (i34==3) {
 1352:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 1353:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 1354:       // and in this case, the pt will be nudged into the element
 1355:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 1356:       // from the local frame, so use additional check.
 1357: 
 1358:       Point2 x0, x1, x2;
 1359: 
 1360:       if constexpr(ics==1) {
 1361:          x0 = nodes[0]->p2();
 1362:          x1 = nodes[1]->p2();
 1363:          x2 = nodes[2]->p2();
 1364:       }
 1365:       else // lat/lon
 1366:       {
 1367:          Error("Not implemented yet");
 1368: #ifdef ICS2
 1369:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 1370:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 1371:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 1372: #endif
 1373:       }
 1374: 
 1375:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 1376:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 1377:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 1378:       shpCoords[3] = 0.0;
 1379:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 1380: 
 1381:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 1382:       // then we fix the negative shape coordinates.
 1383:       if (fixNegshpCoord && tmpmin<=0.0) {
 1384: 
 1385:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 1386:          // keeping the sum of the shape coordinates equal to 1.
 1387:          // I have tested and compared the new algorithm with the old one, and they give
 1388:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 1389:          // The new algorithm should be faster since it is branchless.
 1390:          const double a = - tmpmin + 1.0e-2;  // XXX it used to be 1.0e-4 in the comments of the original code
 1391:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 1392:          
 1393:          shpCoords[0] = (shpCoords[0] + a)*b;
 1394:          shpCoords[1] = (shpCoords[1] + a)*b;
 1395:          shpCoords[2] = (shpCoords[2] + a)*b;          
 1396: 
 1397:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 1398:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 1399:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 1400:          }
 1401: 
 1402:          // Update the point coordinates for the new shape coordinates
 1403:          double xcoords[3] = {x0.x, x1.x, x2.x};
 1404:          double ycoords[3] = {x0.y, x1.y, x2.y};
 1405:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 1406: 
 1407:       }
 1408: 
 1409:       // Check if the point is inside the element
 1410:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 1411:    }
 1412:    else {
 1413:       Error("Not implemented yet");
 1414: #ifdef QUADS
 1415:       // Reproject pt in eframe of nel for ics=2
 1416:       if constexpr(ics==1) {
 1417:          xn2 = xt; 
 1418:          yn2 = yt;
 1419:       }
 1420:       else {
 1421:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 1422:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 1423:       }
 1424: 
 1425:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 1426: #endif
 1427:    }
 1428: 
 1429: }
 1430: 
 1431: 
 1432: /**  Interpolate velocities at a given point (xt,yt,zt)
 1433: 
 1434:    @param xt, yt, zt: coordinates of the point to interpolate
 1435:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 1436: 
 1437:    This is done in four steps:
 1438: 
 1439:    1. Find the shape coordinates for the final position in the element.
 1440:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 1441:    3. Perform a *binary search* to find the vertical level containing zt. It will have to interpolate the 
 1442:       z levels at xt, yt at each step.   
 1443:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 1444:       horizontally and vertically.
 1445: **/
 1446: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) {
 1447:    // Interpolate the velocities at the point xt. 
 1448:    // This function works the same for triangular and quadrilateral elements.
 1449:    double shpCoord[4];
 1450: 
 1451: 
 1452:    // First step is to compute the shape coordinates of (xt,yt)
 1453:    computeShapeCoords(toVector2(xt), shpCoord, false);
 1454:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 1455: 
 1456:    // Second step is to find the level that contains zt
 1457:    // Uses a binary search to find the level
 1458:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 1459:    int L = kbe;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 1460:    int R = nvrt - 1;
 1461: 
 1462:    // Get the z coordinates at the nodes of the element at the levels L and R
 1463:    double zLAtNodes[4], zRAtNodes[4];
 1464:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 1465:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 1466: 
 1467:    double zL = interpolate(shpCoord, zLAtNodes);
 1468:    double zR = interpolate(shpCoord, zRAtNodes);
 1469:    
 1470:    // Interpolates vertically the velocities
 1471:    double wght1, wght2;
 1472:    if (xt.z<=zL) {
 1473:       wght1 = 1.0;
 1474:       wght2 = 0.0;
 1475:    }
 1476:    else if (xt.z>=zR) {
 1477:       wght1 = 0.0;
 1478:       wght2 = 1.0;
 1479:    }
 1480:    else {
 1481:       // Perform a binary search to find the levels between L and R that contain xt.z
 1482:       while (R - L > 1) {
 1483:          int M = (L + R) / 2;
 1484: 
 1485:          double zMAtNodes[4];
 1486:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 1487:          double zM = interpolate(shpCoord, zMAtNodes);
 1488:          if (zM < xt.z) 
 1489:          {
 1490:             L = M;
 1491:             zL = zM;
 1492:          }
 1493:          else 
 1494:          {
 1495:             R = M;
 1496:             zR = zM;
 1497:          }
 1498:       }
 1499:       assert(L == R-1);
 1500:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 1501: 
 1502:       wght2 = (xt.z - zL)/(zR - zL);
 1503:       wght1 = 1.0 - wght2;
 1504:    }
 1505: // printf("$$$ wght1 = %f, wght2 = %f, zt = %f, zL = %f, zR = %f\n", wght1, wght2, zt, zL, zR);
 1506: // printf("$$$ shpCoord = %f, %f, %f, %f\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 1507:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 1508:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 1509: 
 1510:    // Neither of the interpolated velocities should be NaN
 1511:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 1512: 
 1513: }
 1514: 
 1515: 
 1516: 
 1517: __inline__ __device__ double Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 1518: __inline__ __device__ double Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 1519: __inline__ __device__ Point2 Side::p_t(double t) const { return {x(t), y(t)}; }
 1520: __inline__ __device__ int    Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 1521: __inline__ __device__ double Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 1522: 
 1523: __inline__ __device__ double Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 1524: __inline__ __device__ double Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 1525: 
 1526: __inline__ __device__ double Side::Cd(void)      const { if constexpr(nchi != 0) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 1527: 
 1528: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 1529: 
 1530: /**
 1531:  * This method performs backtracking from the side center until a time -dt back in time 
 1532:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 1533:  * intermediate point.
 1534:  *
 1535:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 1536:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 1537:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 1538:  * remaining time.
 1539:  * 
 1540:  * NOTE: Runge-Kutta is not implemented yet. XXX
 1541:  * 
 1542:  * @param uuint, vvint, wwint: Velocities at the final point
 1543:  * @param jlev: Level at which the backtracking is performed
 1544:  * @param dt, dtbk: Tracking timesteps
 1545:  * @param sclr: Array for backtracked values
 1546:  * @return: True if the backtracking was successful, false otherwise
 1547:  */
 1548: __inline__ __device__ bool Side::btrack(
 1549:       int jlev,
 1550:       double dt,            // Tracking time
 1551:       double dtbk,          // Tracking timestep
 1552:       double* sclr,         // Array for backtracked values
 1553:       Vector3 &u_int
 1554: ) const {
 1555: 
 1556:    // Start from side center
 1557:    Point3 x0 = {center.x, center.y, zc[jlev]};
 1558:  
 1559: 
 1560:    double time_rm = dt; // Remaining time
 1561: 
 1562: 
 1563:    // // Initialize outputs
 1564:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 1565:    //    sclr[i] = 0.0;
 1566:    // }
 1567: 
 1568: 
 1569:    // Initial velocities
 1570:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 1571: 
 1572:    // Find the element that is in the direction opposite to the velocity
 1573:    Element* curElem = findElementTowards({u_int.x, u_int.y});
 1574: 
 1575: printf("$$$  %d, %d, %.5f, %.5f\n",  curElem->idx,idx, x0.x, x0.y)   ;
 1576:    const int MAX_ITERATIONS = 100000; // XXX 1000
 1577:    Element* nextElem = curElem;
 1578:    int iter = 0;
 1579:    while(true) {
 1580:       // Calculate timestep
 1581:       double dtb = min(dtbk, time_rm);
 1582: 
 1583:       // Next point in the backtracking curve
 1584:       Point3 xt = x0 - dtb*u_int;
 1585: 
 1586:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb);
 1587:       assert(found && "Backtracking failed in btrack");
 1588: // printf("<>T = %f, %f %f %f\n", time_rm - dtb, xt, yt, zt);
 1589:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 1590:                       // then time_rm needs to be increased by the unused time.
 1591: 
 1592: 
 1593:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 1594: 
 1595:       // The current point becomes the next segment's starting point.
 1596:       x0 = xt;
 1597:  
 1598:       curElem = nextElem;
 1599: 
 1600:       iter++;
 1601:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 1602:    }
 1603: 
 1604: 
 1605: }
 1606: 
 1607: 
