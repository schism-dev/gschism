  200: 
  201: 
  202: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  203:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  204:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  205: }
  206: 
  207: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  208:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  209:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  210: }
  211: 
  212: 
  213: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  214:    x3 = y1*z2 - y2*z1;
  215:    y3 = x2*z1 - x1*z2;
  216:    z3 = x1*y2 - x2*y1;
  217: }
  218: 
  219: 
  220: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  221: // Given a 3D global point (may not be on surface of earth), find its longitude and latitude in radians
  222: 
  223:    const double radius2 = dot(p, p);
  224:    assert(radius2 != 0.0     && "computeLonLat: radius = 0");
  225:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  226: 
  227:    rlon = atan2(p.y, p.x); // (-pi,pi]
  228: 
  229:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  230:       rlat = asin(p.z/sqrt(radius2));
  231:    } else {
  232:       rlat = asin(p.z/rearth_pole);
  233:    }
  234:   
  235: }
  236: 
  237: __inline__ __device__ void Error(const char* msg) {
  238:    printf("Error: %s\n", msg);
  239:    assert(false);
  240: }
  241: 
  242: struct Tracers {
  243:     double tracer[N_TRACERS];
  244: };
  245: 
  246: 
  247: 
  248: struct Frame {
  249:    double _t[9]; // t stands for tensor.
  250: 
  251:    // Access the tensor in Fortran order
  252:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  253: 
  254:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  255: 
  256:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  257: 
  258:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  259:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  260:       sincos(ar2, &sin_ar2, &cos_ar2);
  261: 
  262:       t(0,0) = -sin_ar1;
  263:       t(1,0) =  cos_ar1;
  264:       t(2,0) =  0.0;
  265:       t(0,1) = -cos_ar1*sin_ar2;
  266:       t(1,1) = -sin_ar1*sin_ar2;
  267: 
  268:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  269: 
  270:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  271:       assert (ar4!=0.0 && "GRID: ar4=0");
  272: 
  273:       const double ar4_inv = 1.0/ar4;
  274:       t(0,1) = t(0,1)*ar4_inv;
  275:       t(1,1) = t(1,1)*ar4_inv;
  276:       t(2,1) = t(2,1)*ar4_inv;
  277: 
  278:       // The third vector is the cross product of the first two
  279:       crossProduct(t(0,0), t(1,0), t(2,0), 
  280:                    t(0,1), t(1,1), t(2,1), 
  281:                    t(0,2), t(1,2), t(2,2));
  282:    }
  283: 
  284: 
  285:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  286:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  287:    // Inputs:
  288:    //        vec0: vel. in this frame;
  289:    //        frameout: Output frame;
  290:    // Output: 
  291:    //        vec1: vel. in new frame  
  292: 
  293:       auto const fo = frameout;
  294:       Vector2 vec1;
  295: 
  296:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  297:       // of t and fo.t are the same.
  298:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  299:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  300: 
  301:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  302:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  303: 
  304:       return vec1;
  305:    }
  306: 
  307:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  308:       // Transform a vector from global to local frame
  309:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  310:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  311:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  312:    }
  313: 
  314:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  315:       // Transform a vector from local to global frame
  316:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  317:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  318:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  319:    }   
  320: 
  321:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  322:    // Tranforms a point from global to local frame     
  323:       G2L(pi - origin0, po);
  324:    }
  325: 
  326:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  327:    // Transforms a point from local to global frame      
  328:       L2G(pi, po);
  329:       po = po + origin0;
  330:    }
  331: 
  332: };
