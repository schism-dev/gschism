 2047: 
 2048: __host__ __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2049: 
 2050: __device__ double Node::compZCoord(int k) const {
 2051:    // Computes the z coordinate at level k.
 2052:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2053:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2054:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2055:    // used 
 2056:    
 2057:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2058:       
 2059:    if (isDry)  return 0.0;
 2060: 
 2061:    if constexpr(ivcor == 2) {
 2062: 
 2063:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2064:       const int kz = mesh->kz;
 2065: 
 2066:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2067:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2068:       // once per time step/node.
 2069:       // CHECK: updateZCoordData
 2070:       if (k == kz)               return -hmod2;
 2071:       else if (k == nvrt-1)      return eta2;
 2072:       else if (k == kb)          return -depth;
 2073:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2074:       else if (k > kz) {
 2075:          const int ksig = k - kz + 1;
 2076: 
 2077:          if (hmod2 <= mesh->h_c) {
 2078:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2079:          } 
 2080:          else if (eta2 <= - mesh->h_c - (depth - mesh->h_c) * mesh->theta_f/mesh->sinh_theta_f) {
 2081:             printf("Please choose larger h_c: %f %f\n", eta2, mesh->h_c);
 2082:             Error("ZCOOR: invalid h_c\n");
 2083:          } 
 2084:          else {
 2085:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2086:                          mesh->h_c * mesh->sigma[ksig] + 
 2087:                          (hmod2 - mesh->h_c) * mesh->cs[ksig];
 2088:          }
 2089:       } else { 
 2090:          Error("ZCOOR: invalid level or coordinate system\n");
 2091:       }
 2092: 
 2093:    }
 2094:    else if constexpr(ivcor == 1) {
 2095:       if (k == kb) return -depth;
 2096:       else if (k == nvrt-1) return eta2;
 2097:       else if (k >= kb) {
 2098:             return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2099:       }
 2100:    }
 2101:    
 2102:    printf("ZCOOR: invalid level or coordinate system\n");
 2103:    return 0.0;
 2104: }
