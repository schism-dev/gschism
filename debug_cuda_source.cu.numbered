 3918: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 3919: //                   b1=b1*b1+b2*b2 !smoothness indicator
 3920: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 3921: //                   wm(i)=b2
