 3554:    __global__ void computeElevationBoundaryConditions(double time) {
 3555:       // Compute elevation essential boundary conditions 
 3556: 
 3557:       NODE_BND(nodeBnd); // Each boundary node.
 3558: 
 3559:       const Node *node = nodeBnd->node;
 3560:       const int iettype = nodeBnd->iettype;
 3561: 
 3562:       double eic = 0.0;
 3563:       if (nramp_elev==1) eic = nodeBnd->etaic;
 3564:       else               eic = 0.0;
 3565: 
 3566:       const double r_eic = (1.0 - ramp)*eic; 
 3567:       const double r_eth = ramp*nodeBnd->eth;
 3568:       double eta1_bar = r_eic;
 3569: 
 3570: printf("++++>> node[%d]->iettype = %d\n", node->idx, iettype);
 3571:       // Compute tide elevation
 3572:       if (iettype == 3 || iettype == 5) {   
 3573: 
 3574:          if constexpr(iloadtide==1) { // loading tide
 3575:             assert(false && "Loading tide not implemented");
 3576:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3577:          }
 3578:          
 3579:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 3580: 
 3581:             const double efa  = nodeBnd->efa[jfr]; 
 3582:             const double emo  = nodeBnd->emo[jfr]; 
 3583: 
 3584:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 3585:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 3586:             eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 3587: 
 3588:  printf("++++>> jfr = %d, time = %f, ramp = %f, node->idx = %d, amig = %f, face = %f, ff = %f, efa = %f, emo = %f, arg = %f, eta1_bar = %f\n", jfr, time, ramp, node->idx, amig[jfr], face[jfr], ff[jfr], efa, emo, arg, eta1_bar);            
 3589:          } // for jfr
 3590: 
 3591:       } // if iettype
 3592: 
 3593:       switch (iettype) {
 3594:          case 1:
 3595:          case 2:
 3596:             nodeBnd->elbc = r_eth + r_eic;
 3597:             break;
 3598:          case 3:
 3599:             nodeBnd->elbc = eta1_bar + r_eic;
 3600:             break;
 3601:          case 4:
 3602:             nodeBnd->elbc = r_eth + r_eic;
 3603:             break;
 3604:          case 5:
 3605:             nodeBnd->elbc = r_eth + eta1_bar + r_eic;
 3606:             break;
 3607:       } // switch
 3608: 
 3609: 
 3610:       //Add inverse barometric effects
 3611:       if (iettype != 0 && inv_atm_bnd == 1) {
 3612:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 3613:       }
 3614: printf("++++>> nodeBnd->elbc = %f\n", nodeBnd->elbc);
 3615:    }
 3616: 
 3617: 
 3618:    __global__ void setEssentialBC(void) {
 3619:       // Set essential boundary conditions 
 3620:       NODE(node); // Each boundary node
 3621:       NodeBoundary *nodeBnd = node->nodeBnd;
 3622: printf("node idx = %d, nodeBnd = %p, essentialBC = %d\n", node->idx, nodeBnd, nodeBnd ? nodeBnd->isEssentialBC : -1);
 3623:       
 3624: // nodeBnd->isEssentialBC = true;      
 3625:       // Check if this node has essential BC
 3626:       if (nodeBnd && nodeBnd->isEssentialBC) {
 3627:          // Verify BC value is valid
 3628:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 3629: 
 3630:          printf("XX node IDX = %d, nodeBnd->isEssentialBC = %d\n", node->idx, nodeBnd->isEssentialBC);
 3631:          
 3632:          // Set diagonal to 1 and zero off-diagonals
 3633:          node->coeffDiag = 1.0;
 3634:          printf("ZZZZZZZ node->coeffDiag = %16.9f\n", node->coeffDiag);
 3635: 
 3636:          for (int j = 0; j < node->numNodes; j++) {
 3637:                node->coeffMatrix[j] = 0.0;
 3638:                printf("YY node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 3639:          }
 3640:          
 3641:          // Set solution and RHS to BC value
 3642:          node->mX  = nodeBnd->elbc;
 3643:          node->qel = nodeBnd->elbc;
 3644: printf("{{{{ node->mX = %f, node->qel = %f\n", node->mX, node->qel);         
 3645:       } else {
 3646:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 3647: 
 3648:          for (int j = 0; j < node->numNodes; j++) {
 3649:                Node* nbNode = node->nodes[j];
 3650:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 3651:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 3652:                   // Verify neighbor's BC value
 3653:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 3654: 
 3655:                   // Subtract contribution to RHS
 3656:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 3657:                   node->coeffMatrix[j] = 0.0;  
 3658:                   printf("ZZ node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 3659:                }
 3660:          }
 3661:       }
 3662:    }
 3663: 
 3664: 
 3665:    __global__ void updateElevation(void) {
 3666:       NODE(node);
 3667: 
 3668:       node->eta2 = node->mX;
 3669: printf("node[%d]->eta2 = %f, qel = %f\n", node->idx, node->eta2, node->qel);
 3670:    }
