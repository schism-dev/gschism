  649: struct Side {
  650: 
  651:    // Geometry information
  652:    int idx;               // Index of the side
  653:    Node *n1, *n2;
  654:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  655: 
  656:    double length;         // Length of the side. Used to be called distj; but I think this name is less clear now.
  657:    Vector2 center;        // Location of side center. 
  658:    double zc[nvrt];       // Side center z-coord at each vertical level
  659: 
  660:    Frame frame;
  661: 
  662:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  663:                           // this is nullptr
  664:    
  665:    int kb;                // Bottom index of the side
  666:    bool isDry;             // True if the side is dry
  667:  
  668:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  669: 
  670:    // Physical information
  671:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  672:    double  w2[nvrt];            // Vertical velocity at each vertical level
  673:    Vector2 btu[nvrt];           // Back-tracked velocity
  674:    Vector2 uth[nvrt];           // "Time history" velocity
  675:    Vector2 U;                   // Vertically averaged velocity vector  
  676: 
  677:    Vector2 d2uv[nvrt];          // divergence of (nu*grad u) XXX COMPUTE!!
  678: 
  679:    Vector2 bcc[nvrt];           // Baroclinic term
  680: 
  681:    double hhat;                 // \breve{H} in notes
  682: 
  683:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
  684: 
  685:    double coriolis;             // Coriolis parameter
  686: 
  687:    // Vegetation parameters
  688:    double veg_c2;
  689:    double veg_beta;
  690: 
  691:    // Bottom drag parameters.
  692:    double chi;
  693:    double chi2;
  694: 
  695:    __inline__ __device__ double x(double t) const;
  696:    __inline__ __device__ double y(double t) const;
  697:    __inline__ __device__ Point2 p_t(double t) const;
  698: 
  699:    __inline__ __device__ Point3 center3D(int k) const { return {center.x, center.y, zc[k]}; }
  700:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
  701:    __inline__ __device__ double Dz(int k)       const { return zc[k] - zc[k-1]; }
  702: 
  703:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
  704: 
  705:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
  706: 
  707:    __inline__ __device__ int iadv(void) const;
  708: 
  709:    __inline__ __device__ double eta2(void) const;
  710:    __inline__ __device__ double depth(void) const;
  711:    __inline__ __device__ double htot(void) const { return eta2() + depth(); }
  712: 
  713:    __inline__ __device__ double veg_h(void)  const;
  714:    __inline__ __device__ double veg_nv(void) const;
  715:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
  716:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
  717: 
  718:    __inline__ __device__ double Cd(void) const;
  719: 
  720:    __inline__ __device__ Vector2 tau(void) const;
  721: 
  722:    __inline__ __device__ double zb(void) const { return zc[kb]; }
  723:    
  724: 
  725:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
  726:    __inline__ __device__ double zLevelVegRatio(int k) const { 
  727:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
  728:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
  729:    } 
  730:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
  731:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot(); }
  732:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 1; }
  733:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 1; }
  734: 
  735:    // Get valid starting element (for backtracking)
  736:    __inline__ __device__ Element* getStartElement() {
  737:       return elems[0] ? elems[0] : elems[1];
  738:    }
  739: 
  740:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
  741:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
  742: 
  743:       // If one of the elements is null, return the other one
  744:       if      (elems[0] == nullptr) return elems[1];
  745:       else if (elems[1] == nullptr) return elems[0];
  746: 
  747: 
  748:       // Dot product of the negative velocity vector with the side normal vector
  749:       const double dot_prod1 = -dot(u, n);
  750:       
  751:       // Vector from side center to element 0 centroid
  752:       const Vector2 v2 = toVector2(elems[0]->center) - center;
  753: 
  754:       // Dot product of the vector with the side normal vector
  755:       const double dot_prod2 = dot(v2, n);
  756: 
  757:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
  758:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
  759: 
  760:       if (dot_prod1*dot_prod2 > 0.0) return elems[0];
  761:       else                           return elems[1];
  762: 
  763:  
  764:    }
  765: 
  766:    __forceinline__ __device__ Element* otherElem(const Element* elem) {
  767:       // Given an element, returns the other element that shares this side
  768:       return (elems[0] == elem) ? elems[1] : elems[0];
  769:    }
  770: 
  771:    __forceinline__ __device__ Node* otherNode(Node* node) {
  772:       // Given a node, returns the other node that shares this side
  773:       return (n1 == node) ? n2 : n1;
  774:    }
  775:  
  776:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
  777: 
  778: 
  779: 
  780: 
  781: };
  782: 
