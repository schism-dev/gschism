 2179: __host__ __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2180: 
 2181: __device__ double Node::compZCoord(int k) const {
 2182:    // Computes the z coordinate at level k.
 2183:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2184:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2185:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2186:    // used 
 2187:    
 2188:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2189:       
 2190:    if (isDry)  return 0.0;
 2191: 
 2192:    if constexpr(ivcor == 2) {
 2193: 
 2194:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2195:       const int kz = mesh->kz;
 2196: 
 2197:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2198:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2199:       // once per time step/node.
 2200:       // CHECK: updateZCoordData
 2201:       if (k == kz)               return -hmod2;
 2202:       else if (k == nvrt-1)      return eta2;
 2203:       else if (k == kb)          return -depth;
 2204:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2205:       else if (k > kz) {
 2206:          const int ksig = k - kz + 1;
 2207: 
 2208:          if (hmod2 <= mesh->h_c) {
 2209:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2210:          } 
 2211:          else if (eta2 <= - mesh->h_c - (depth - mesh->h_c) * mesh->theta_f/mesh->sinh_theta_f) {
 2212:             printf("Please choose larger h_c: %f %f\n", eta2, mesh->h_c);
 2213:             Error("ZCOOR: invalid h_c\n");
 2214:          } 
 2215:          else {
 2216:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2217:                          mesh->h_c * mesh->sigma[ksig] + 
 2218:                          (hmod2 - mesh->h_c) * mesh->cs[ksig];
 2219:          }
 2220:       } else { 
 2221:          Error("ZCOOR: invalid level or coordinate system\n");
 2222:       }
 2223: 
 2224:    }
 2225:    else if constexpr(ivcor == 1) {
 2226:       if (k == kb) return -depth;
 2227:       else if (k == nvrt-1) return eta2;
 2228:       else if (k >= kb) {
 2229:             return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2230:       }
 2231:    }
 2232:    
 2233:    printf("ZCOOR: invalid level or coordinate system\n");
 2234:    return 0.0;
 2235: }
 2236: 
 2237: 
 2238: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2239:                 double *node_coords, double *wind_rotate_angle, 
 2240:                 int *isdel, int *isidenode, int *isbnd,
 2241:                 int nond, int nlnd, int *iond, int *ilnd,
 2242:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2243:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2244:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2245:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2246:                 int *localNodePart,     int *localElemPart,     int *localSidePart) {
 2247: 
 2248:    printf("Populating mesh for partition %d, %d, %d\n", partNum, nond, nlnd);
 2249: 
 2250:    // Horizontal grid
 2251:    printf("Processing %d nodes\n", np);    
 2252: 
 2253: 
 2254:    int idxNodeBoundary = 0;  
 2255:    for (int i = 0; i < np; i++)
 2256:    {
 2257:       Node &node = localNodeData[i];
 2258: 
 2259:       node.idx = i;
 2260: 
 2261:       const int idxNodeStart = nodeNeighNodesStart[i];
 2262:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2263:       node.numNodes = idxNodeEnd - idxNodeStart;
 2264:       node.nodes = nodeNeighNodes + idxNodeStart;
 2265:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2266: 
 2267: 
 2268: 
 2269:       const int idxElemStart = nodeNeighElemsStart[i];
 2270:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2271:       node.numElements = idxElemEnd - idxElemStart;
 2272:       node.elements = nodeNeighElems + idxElemStart;
 2273: 
 2274: 
 2275:       
 2276:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2277:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2278:          const int partNode = localNodePart[idxNodeGlobal]; 
 2279:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2280: 
 2281: 
 2282:          Node *node_ptr = nodes[partNode] + idxNode;
 2283:          
 2284:          nodeNeighNodes[idx] = node_ptr;
 2285:       }
 2286: 
 2287:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2288:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2289:          const int partElem = localElemPart[idxElemGlobal];
 2290:          const int idxElem  = localElemIndices[idxElemGlobal];
 2291: 
 2292:          Element *elem_ptr = elems[partElem] + idxElem;
 2293: 
 2294:          nodeNeighElems[idx] = elem_ptr;
 2295:       }      
 2296: 
 2297: 
 2298:       node.wind_angle = wind_rotate_angle[i];
 2299: 
 2300:       // Element **elements; // pointer to the elements connected to this node
 2301:       // int numElements;   // number of elements shared by this node
 2302: 
 2303:       node.p.x   = node_coords[i * 3];
 2304:       node.p.y   = node_coords[i * 3 + 1];
 2305:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2306:       node.depth = node_coords[i * 3 + 2];
 2307: 
 2308: 
 2309: 
 2310:       // Links the node to the boundary information
 2311:       if (isbnd[i] >= 0) {
 2312:        
 2313:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2314:          node.nodeBnd->node = &node;
 2315: 
 2316:          if (isbnd[i]>0) {
 2317: 
 2318:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2319:             node.nodeBnd->segment->ifltype = isbnd[i];
 2320: 
 2321:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2322:             node.nodeBnd->segment->clen  = nan("1");
 2323:             node.nodeBnd->segment->carea = nan("1");
 2324: 
 2325:          }
 2326:          else {
 2327:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2328:          }
 2329:          
 2330:          idxNodeBoundary++;
 2331:       }
 2332:       else {
 2333:          node.nodeBnd = nullptr;
 2334:       }
 2335: 
 2336: // XXXX
 2337: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2338: constexpr double rot_per = 3000.0;
 2339: constexpr double rot_f = 2.0*pi/rot_per;
 2340: for (int k = 0; k < nvrt; k++) {node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0};}
 2341: // XXXXX
 2342:    }
 2343: 
 2344:    nbp = idxNodeBoundary;
 2345: 
 2346:    printf("Processing %d sides\n", ns);
 2347:    int idxSideBoundary = 0;
 2348:    for (int i = 0; i < ns; i++)
 2349:    {
 2350:       Side &side = localSideData[i];
 2351:       side.idx = i;
 2352:       // finding the pointer to the nodes that form the side
 2353:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2354:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2355: 
 2356:       const int locidx_n1 = localNodeIndices[idx_n1];
 2357:       const int locidx_n2 = localNodeIndices[idx_n2];
 2358:       const int part_n1 =   localNodePart[idx_n1];
 2359:       const int part_n2 =   localNodePart[idx_n2];
 2360: 
 2361:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2362:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2363: 
 2364:       // Normal vector to the side
 2365:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2366:       const double norm = sqrt(dot(side.n, side.n));
 2367:       side.n = side.n/norm;
 2368: 
 2369:       // Side boundary type
 2370:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 2371:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 2372:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2373:       
 2374:       if (n1bnd != nullptr || n2bnd != nullptr) 
 2375:       {
 2376:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2377:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2378:          else                  side.sideBnd->segment = n2bnd->segment;
 2379:          side.sideBnd->side = &side;
 2380:          idxSideBoundary++;
 2381:       }
 2382:       else side.sideBnd = nullptr;
 2383: 
 2384:       // finding the pointer to the elements that share the side
 2385:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2386:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2387: 
 2388:       if (idx_e1 > -1) {
 2389:          const int locidx_e1 = localElemIndices[idx_e1];
 2390:          const int part_e1 =  localElemPart[idx_e1];
 2391:          side.elems[0] = elems[part_e1] + locidx_e1;
 2392:          // printf("s@@ part_e1 = %d, locidx_e1 = %d, elems[part_e1] = %p\n", part_e1, locidx_e1, elems[part_e1]);
 2393:          // // printf("s-- side.elems[0] = %p idx = %d i34 = %d (x,y,z) = (%f,%f,%f) size = %d\n", side.elems[0], side.elems[0]->idx, side.elems[0]->i34, side.elems[0]->center.x, side.elems[0]->center.y, side.elems[0]->center.z, sizeof(Element));
 2394:          // printf("o-- elems = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2395:       }
 2396:       else {
 2397:          side.elems[0] = nullptr;
 2398:       }
 2399: 
 2400:       if (idx_e2 > -1) {
 2401:          const int locidx_e2 = localElemIndices[idx_e2];
 2402:          const int part_e2 =  localElemPart[idx_e2];
 2403:          side.elems[1] = elems[part_e2] + locidx_e2;
 2404:       }
 2405:       else {
 2406:          side.elems[1] = nullptr;
 2407:       }
 2408: 
 2409: 
 2410: 
 2411:       // Compute the center of the side
 2412:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2413: 
 2414: // XXXX
 2415: constexpr double rot_per=3000.0;
 2416: constexpr double rot_f=2.0*pi/rot_per;
 2417: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2418: // XXXXX      
 2419: 
 2420:       // Compute the z level at the center of the side
 2421:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->znl[k] + side.n2->znl[k]);
 2422: 
 2423:       // Compute the length of the side
 2424:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2425:       side.length = sqrt(dot(vLen, vLen));
 2426: 
 2427:    }
 2428: 
 2429:    printf("Processing %d elements\n", ne);
 2430:    for (int i = 0; i < ne; i++)
 2431:    {
 2432:       Element &elem = localElemData[i];
 2433:       elem.idx = i;
 2434:       for (int j = 0; j < i34[i]; j++) {
 2435:          const int idxNode = elnode[i*4 + j];  
 2436:          const int idxSide = elside[i*4 + j];
 2437:          
 2438:          elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 2439:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2440: 
 2441: 
 2442: 
 2443:          // Find the neighboring element  
 2444:          if (elem.sides[j]->elems[0] == &elem) {
 2445:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2446:          }
 2447:          else {
 2448:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2449:          }
 2450:          
 2451:       }
 2452: 
 2453:       elem.i34 = i34[i];
 2454: 
 2455: // printf("elem = %p, elem.i34 = %d\n", &elem, elem.i34);
 2456: 
 2457:       // Compute the centroid of the element and its depth
 2458:       Vector2 center = {0.0, 0.0};
 2459:       elem.depth = 0.0;
 2460:       for (int j = 0; j < i34[i]; j++) {
 2461:          center += elem.nodes[j]->p2()/i34[i];
 2462:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2463:       }
 2464:       elem.center.x = center.x;
 2465:       elem.center.y = center.y;
 2466: 
 2467:       // printf("elem = %p, i34 = %d, center = (%f,%f,%f)\n", &elem, elem.i34, elem.center.x, elem.center.y, elem.depth);
 2468:       
 2469:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2470:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2471: 
 2472:       elem.area = elem.computeSignedArea(); 
 2473:       elem.radius = sqrt(elem.area)/pi; 
 2474:       
 2475:       // Determines which way the normal vector to each side is oriented.
 2476:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2477:       for (int j = 0; j < i34[i]; j++)  
 2478:       {
 2479:          if (elem.sides[j]->elems[0] == &elem) {
 2480:             elem.ssign[j] =  1.0;
 2481:          }
 2482:          else {
 2483:             elem.ssign[j] = -1.0;
 2484:          }
 2485: 
 2486:       }
 2487: 
 2488:       // Derivatives of shape functions
 2489:       //  For ics=2, this is done inside element/ll frame XXX
 2490:       //  For quads, the derivative is evaluated at centroid
 2491:       const int i34 = elem.i34;
 2492:       for (int j = 0; j < i34; j++) {
 2493:          const double area = elem.area;
 2494:          const int id2 = elem.nxq(1 + j);
 2495:          const int id3 = elem.nxq(2 + j);
 2496:          const int id4 = elem.nxq(3 + j);
 2497:          if (elem.isTri()) {
 2498:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2499:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2500:             // da1/dx = (y1 - y2)/(2*area)
 2501:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2502:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2503:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2504:          }
 2505:          else  { // Quad; evaluate at centroid
 2506:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2507:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2508:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2509:          } // if Tri
 2510: 
 2511:       } // for j
 2512: 
 2513:    }
 2514: 
 2515: 
 2516:    // Processing the boundary nodes
 2517:    for (int i = 0; i < nond; i++) {
 2518:       NodeBoundary *nodeBnd = &localNodeBoundaryMem[i];
 2519: 
 2520: 
 2521:       nodeBnd->isEssentialBC = true;
 2522:       nodeBnd->bcValue = 7.0;
 2523: printf("XXXXSXX nodeBnd = %p, IDX = %d, nodeBnd->isEssentialBC = %d\n", nodeBnd, iond[i], nodeBnd->isEssentialBC);
 2524:    }
 2525: 
 2526: }
 2527: 
 2528: 
 2529: 
 2530: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 2531:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 2532:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 2533:    // 
 2534:    // This kernel is called for all nodes.
 2535: 
 2536: 
 2537:    NODE(node1);
 2538: 
 2539: 
 2540:    node1->clearMatrixRow();
 2541:    node1->qel = 0.0;
 2542: 
 2543:    // THIS IS FOR STRUCTURES XXX
 2544:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 2545: 
 2546:    
 2547:    for (int j=0; j<node1->numElements; j++) {
 2548:       // For each element connected to the node...
 2549: 
 2550:       Element *elem = node1->elements[j];
 2551: 
 2552:       // Compute the average gravity
 2553:       printf("UUU Node::grav2 = %f, %f, %f\n", elem->nodes[0]->grav2, elem->nodes[1]->grav2, elem->nodes[2]->grav2);
 2554:       const double grav3 = elem->mean(&Node::grav2);
 2555: 
 2556:       // Look at the documentation for the description of the terms in the following integrals
 2557: 
 2558:       // Integral I_1 
 2559:       // \bar{\breve{H}} 
 2560:       const double hhatb = elem->mean(&Side::hhat);        
 2561: 
 2562: 
 2563:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 2564: 
 2565:       const int id1 = elem->nodeLocalIdx(node1); 
 2566:       const double area = elem->area;
 2567: 
 2568:       if (elem->isTri()) {
 2569: 
 2570:          // To clarify the notation in this section: 
 2571:          //   i stands for the node under consideration (node1)
 2572:          //   j (node2) and k (node3) are the other nodes of the triangle.
 2573:          const int id2 = elem->nxq(1 + id1);
 2574:          const int id3 = elem->nxq(2 + id1);
 2575:          Node *node2 = elem->nodes[id2];
 2576:          Node *node3 = elem->nodes[id3];
 2577: 
 2578:          const Point2 x1 = node1->p2();
 2579:          const Point2 x2 = node2->p2();
 2580:          const Point2 x3 = node3->p2();
 2581: 
 2582:          // integral of phi_i*phi_j
 2583:          const double ipp_ii = (1.0/6.0 )*area;
 2584:          const double ipp_ij = (1.0/12.0)*area;
 2585:          const double ipp_ik = (1.0/12.0)*area;
 2586: 
 2587:          // integral of [(grad phi_i) * (grad phi_j)]
 2588:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 2589:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 2590:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 2591: 
 2592:          // Computes the different components of integral I_1 of each node with respect to node i.
 2593:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 2594:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 2595:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 2596: 
 2597:          printf("grav3 = %f, thetai = %f, dt = %f, hhatb = %f, area = %f, dot1= %f, dot2 = %f, dot3 = %f\n", grav3, thetai, dt, hhatb, area, dot(x3-x2, x3-x2), dot(x3-x2, x1-x3), dot(x1-x3, x1-x3));
 2598:          printf("node idx = %d, x1 + %f, %f, x2 + %f, %f, x3 + %f, %f\n", node1->idx, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y);
 2599:          printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 2600: 
 2601:          node1->addToSparseMatrix(node1, I1_ii);
 2602:          node1->addToSparseMatrix(node2, I1_ij); 
 2603:          node1->addToSparseMatrix(node3, I1_ik);
 2604: 
 2605: printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 2606:      
 2607:       }
 2608:       else { // Quad
 2609:          // XXX IMPLEMENT THIS
 2610:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2611:       } 
 2612: 
 2613:  
 2614:       // Integral I_4
 2615:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 2616:       // Where
 2617:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 2618: 
 2619:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 2620:       // of U over the element.
 2621:       Vector2 Umean = {0.0, 0.0};
 2622:       for (int m=0; m<elem->i34; m++) {      
 2623:          const Side *side = elem->sides[m];
 2624: 
 2625:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 2626:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 2627:       }
 2628:       Umean = Umean/elem->i34;
 2629: 
 2630:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 2631: 
 2632:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 2633:       const double I_4_1 = dot(gradPhi_1, Umean);
 2634: 
 2635:       // Integral of \nabla\phi_i \cdot \pmb{E}
 2636:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 2637:      
 2638:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);
 2639:       
 2640: 
 2641:       // Additional terms 
 2642:       double vnorm = 0.0;
 2643:       if (imm == 2)  { // Pre-compute vnorm on the element
 2644:          Vector3 ubed;
 2645:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 2646: 
 2647:          Vector3 gradP = {0.0, 0.0, 1.0};
 2648:          for (int m=0; m < elem->i34; m++) {
 2649:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 2650:            gradP += toVector3(gradP_2D, 0.0);
 2651:          }   
 2652:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 2653:       } // imm==2
 2654: 
 2655:       if (elem->isTri()) {
 2656:          for (int l=0; l<3; l++) {
 2657:            double fac;
 2658: 
 2659:            Node *node = elem->nodes[l];
 2660: 
 2661:            (node == node1)? fac=2.0 : fac=1.0;
 2662: 
 2663:            if (imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 2664:            else        node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 2665:            
 2666:          }
 2667: 
 2668:          if (!elem->isDry) {
 2669:            const Vector2 gradEta = elem->nodes[0]->eta2*elem->gradPhi[0] +
 2670:                                    elem->nodes[1]->eta2*elem->gradPhi[1] +
 2671:                                    elem->nodes[2]->eta2*elem->gradPhi[2];
 2672: 
 2673:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 2674:          }
 2675: 
 2676:       } // isTri
 2677:       else { // isQuad
 2678:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2679:          // for (int l=0; l<4; l++) {
 2680:          //   const Node *node = elem->nodes[l];
 2681: 
 2682:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 2683:          //   else        tmp2 = node->bdef2 - node->bdef1;
 2684: 
 2685:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 2686:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 2687:          // }
 2688: 
 2689:       } // isQuad
 2690: 
 2691: 
 2692:       node1->qel += (dt/elem->i34)*elem->vsource;
 2693:       
 2694: 
 2695:    } // for all elements connected to the node
 2696:    
 2697: 
 2698: 
 2699:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 2700:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 2701:    NodeBoundary *nodeBnd = node1->nodeBnd;
 2702:    if (nodeBnd != nullptr)  { 
 2703:       // If it is an open boundary node...
 2704: 
 2705:       // At least one open bnd side, maybe two
 2706:       for (int l=0; l<2; l++) { 
 2707: 
 2708:          // Gets each of the sides sharing the node. 
 2709:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 2710: 
 2711:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 2712: 
 2713:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 2714: 
 2715: 
 2716:          if (sideBnd != nullptr) {
 2717:             // If the side is on a boundary...
 2718: 
 2719:             // Get the boundary segment
 2720:             const BoundarySegment *sideSegment = sideBnd->segment;
 2721:             const Side *side = sideBnd->side;
 2722: 
 2723:             // Integral I_3
 2724:             if (sideSegment->ifltype != 0) {
 2725:             // Natural or Flather b.c.
 2726: 
 2727:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 2728:                // especially for Flather b.c.
 2729:                double ri3 = 0.0;
 2730:                if (!side->isDry) {
 2731:                   // If the side is not dry
 2732:                   
 2733:                   // Computes the side flux of (uth, vth)
 2734:                   double Vn = 0.0;
 2735:                   for (int k = side->kb; k<nvrt-1; k++) {
 2736:                      // uth, vth in lat/lon frame if ics=2
 2737:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 2738:                      const double vn1 = dot(side->uth[k  ], side->n); // outer normal
 2739:                      const double vn2 = dot(side->uth[k+1], side->n);
 2740: 
 2741:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 2742:                   }
 2743: 
 2744:                   ri3 = 0.5*side->length*Vn;
 2745:                }
 2746: 
 2747:                if (sideSegment->ifltype == -1) { // Flather 1
 2748: 
 2749:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 2750:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 2751: 
 2752:                   const double con0 = (1.0/6.0)*side->length*sqrt(grav*side->depth()); // For coefficient matrix
 2753:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 2754:                   
 2755:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 2756:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 2757: 
 2758:                } 
 2759:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 2760:                   // Reset ri3
 2761:                   ri3 = 0.0;
 2762: 
 2763:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 2764: 
 2765:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 2766: 
 2767:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 2768:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 2769: 
 2770:                   const double con0 = (1.0/6.0)*side->length*tmp*thetai*dt;
 2771:                   node1->addToSparseMatrix(node1, con0*2.0);
 2772:                   node1->addToSparseMatrix(node2, con0);
 2773: 
 2774:                } // if Flather or Discharge
 2775: 
 2776:                node1->qel -= thetai*dt*ri3;
 2777: 
 2778:             } // I_3
 2779:           
 2780: 
 2781:             // Integral I_5
 2782:             if(!side->isDry) {
 2783: 
 2784:                const double Unbar = dot(side->U, side->n);
 2785: 
 2786:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->length*Unbar;
 2787:                
 2788:             } // I_5
 2789: 
 2790:          } // if is boundary side
 2791: 
 2792:       } // for l
 2793: 
 2794:    } // if isbnd
 2795: 
 2796: 
 2797:    printf("44444444 idx_node = %d, node1->qel = %f\n", node1->idx, node1->qel);
 2798: 
 2799: }
 2800: 
 2801: 
 2802: extern "C" {
 2803:    __global__ void backtrackAllNodes(void) {
 2804: 
 2805:       // max/min # of sub-divisions
 2806:       const int ndelt_max = max(1.0, dt/dtb_min);
 2807:       const int ndelt_min = max(1.0, dt/dtb_max); 
 2808: 
 2809:       // Removed all references to swild98 XXX
 2810:       // swild98=0.d0 !init
 2811: 
 2812: 
 2813:       SIDE(side);
 2814: 
 2815:       const int kb = side->kb;
 2816: 
 2817:       printf("backtrackAllNodes: side->idx = %d, nvrt = %d\n", side->idx, nvrt);
 2818: 
 2819:       // Initialize btrack velocities to the actual velocities at the side 
 2820:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 2821: 
 2822: 
 2823:       if (side->isDry) return;
 2824: 
 2825: 
 2826:       // Checks that at least one element is not dry
 2827:       const Element *elem1 = side->elems[0];
 2828:       const Element *elem2 = side->elems[1];
 2829: 
 2830: 
 2831:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 2832:       
 2833:       // XXXXXX
 2834:       // !swild_tmp to store global coord. of the starting side
 2835:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 2836:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 2837:       // !Use sframe2 
 2838:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 2839: 
 2840: 
 2841:       for (int k = kb; k < nvrt; k++) {
 2842:       //  Initialize (xt,yt,zt), nnel and vel.
 2843:       //  For ics=2, the coordinates are in local frames
 2844:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 2845: 
 2846: 
 2847:          const int iadvf = side->iadv();  // Advection flag
 2848: 
 2849:          Point3 xt;
 2850:          if constexpr(ics==1) {
 2851:             xt = side->center3D(k); 
 2852:          }
 2853:          else // lat/lon; in side lat/lon frame
 2854:          {
 2855:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 2856:          // XXX IMPLEMENT THIS
 2857:       //          xt=0.d0
 2858:       //          yt=0.d0
 2859:       //          !centroid coord. for nudging
 2860:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 2861:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 2862:          }  // ics
 2863: 
 2864: 
 2865:          // Velocity at the side (in ll frame for ics, same vertical direction)
 2866:          // XXX IS THIS NECESSARY?
 2867:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 2868: 
 2869:          // If on land or open boundary...
 2870:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 2871:          
 2872:          const double vmag = length(toVector2(u_int));
 2873: 
 2874:          if (vmag <= velmin_btrack) {
 2875:             // No activity 
 2876: 
 2877:             side->btu[k] = side->u2[k];
 2878: 
 2879:             
 2880:          } else {  // do btrack
 2881: 
 2882:           
 2883:             // Compute number of sub-divisions based on local gradients 
 2884:             // XXX IS THIS NECESSARY?
 2885:             double suma = 0.0;
 2886:             int icount = 0;
 2887:             for (int ii=0; ii<2; ii++) {
 2888: 
 2889:                const Element *elem = side->elems[ii];
 2890:                  
 2891:                if (elem == nullptr) continue;
 2892: 
 2893:                icount++;
 2894: 
 2895:                // Not strictly along z; in ll frame for ics=2
 2896: 
 2897:                double utmp[4];
 2898:                double vtmp[4];
 2899:                for (int jj = 0; jj < elem->i34; jj++) {
 2900: 
 2901:                   const Node *node = elem->nodes[jj];
 2902: 
 2903:                   if constexpr(ics==1) {
 2904:                      utmp[jj] = node->u2[k].x;
 2905:                      vtmp[jj] = node->u2[k].y;  
 2906:                   } else {
 2907:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 2908:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 2909:                   }
 2910:                } // for jj
 2911: 
 2912:                const Vector2 grad_u = elem->grad(utmp); 
 2913:                const Vector2 grad_v = elem->grad(vtmp);
 2914: 
 2915:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 2916:             } // for ii
 2917: 
 2918:             assert(icount > 0 && "Impossible 77");
 2919: 
 2920:             // '4' is somewhat arbitrary
 2921:             const int ndelt = max(ndelt_min, min(ndelt_max, int(suma/icount)*4)); // >=1
 2922: 
 2923:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 2924:          
 2925: 
 2926:             Vector3 u_int = {0.0, 0.0, 0.0};
 2927: 
 2928:             side->btrack(k, dt, dtbk, u_int);
 2929: 
 2930:                
 2931:          } // if vmag (do backtrack)
 2932: 
 2933:       } // for j=jmin,nvrt-1
 2934: 
 2935:    }
 2936: } // extern "C"
 2937: 
 2938: template<int nc>
 2939: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 2940: 
 2941: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 2942: //
 2943: // a,b,c,r: input vectors and are not modified by this program.
 2944: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 2945: // r is the r.h.s.
 2946: // n: actual rank of the system.
 2947: // rows in u() and r();
 2948: // u: output with nc columns (transposed to rows)
 2949: // gam: a working array.
 2950: //
 2951: // NOTES:
 2952: // This is a template function that allows for different numbers of columns in the rhs vector.
 2953: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 2954: 
 2955:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 2956:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 2957: 
 2958:    double bet = b[0];
 2959:    if constexpr (nc == 1) {
 2960:       u[0] = rhs[0]/bet;
 2961:    } else {
 2962:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 2963:    }
 2964: 
 2965:    for (int j = 1; j < n; j++) {
 2966:       gam[j] = c[j-1]/bet;
 2967:       bet = b[j] - a[j]*gam[j];
 2968: 
 2969:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 2970: 
 2971:       if constexpr (nc == 1) {
 2972:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 2973:       } else {
 2974:          for (int k = 0; k < nc; k++) {
 2975:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 2976:          }
 2977:       }
 2978:    }
 2979: 
 2980:    // Back-substitution
 2981:    for (int j=n-1; j>=1; j--) {
 2982:       if constexpr (nc == 1) {
 2983:          u[j] = u[j] - gam[j+1]*u[j-1];
 2984:       } else {
 2985:          for (int k = 0; k < nc; k++) {
 2986:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 2987:          }
 2988:       }
 2989:    }
 2990: }
 2991: 
 2992: 
 2993: 
 2994: 
 2995: // Helper function that contains the core algorithm
 2996: template<typename XAccessor, typename YAccessor>
 2997: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 2998:                                     double  yp_top, double  yp_bot, 
 2999:                                     CubicSpline &spline) {
 3000:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3001:    // 
 3002:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3003:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3004:    //
 3005:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3006:    // 
 3007:    // Inputs: 
 3008:    //            n: dimension for x etc; # of data pts (>=2);
 3009:    //            getX, getY: functions to access x,y coordinates
 3010:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3011:    //     Output: 
 3012:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3013: 
 3014:    const int n = k2 - k1 + 1;
 3015:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3016: 
 3017:    // Allocate memory for the splines
 3018:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3019:    spline.x   = new double[n];
 3020:    spline.y   = new double[n];
 3021:    spline.yp  = new double[n];
 3022:    spline.ypp = new double[n];
 3023: 
 3024:    for (int k=k1; k<=k2; k++) {
 3025:       spline.x[k] = getX(k);
 3026:       spline.y[k] = getY(k);
 3027:    }
 3028: 
 3029:    // This is to simplify expressions later
 3030:    double *x = spline.x;
 3031:    double *y = spline.y;
 3032: 
 3033:    double *a = nullptr;
 3034:    double *b = nullptr;
 3035:    double *c = nullptr;
 3036:    double *gam = nullptr;
 3037:    double *rhs = nullptr;
 3038:    
 3039: 
 3040:       a = new double[n];   // Lower diagonal
 3041:       b = new double[n];   // Diagonal
 3042:       c = new double[n];   // Upper diagonal
 3043:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3044:       rhs = new double[n]; // Right-hand side
 3045: 
 3046:    for (int k=k1; k<=k2; k++) {
 3047:       if (k == k1) {
 3048:          // Bottom level
 3049:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3050:          b[k] = (x[k+1] - x[k])/3.0;
 3051:          c[k] = b[k]/2.0;
 3052:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3053:       } else if (k == n - 1) {
 3054:          // Top level (surface)
 3055:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3056:          b[k] = (x[k] - x[k-1])/3.0;
 3057:          a[k] = b[k]/2.0;
 3058:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3059:       } else {
 3060:          // Intermediate levels
 3061:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3062:          b[k] = (x[k+1] - x[k-1])/3.0;
 3063:          a[k] = (x[k  ] - x[k-1])/6.0;
 3064:          c[k] = (x[k+1] - x[k  ])/6.0;
 3065:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3066:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3067:       }
 3068:    }
 3069: 
 3070:    // Solve the tridiagonal system
 3071:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3072:    
 3073:    spline.yp[k1] = yp_bot;
 3074:    spline.yp[k2] = yp_top;
 3075: 
 3076:    // Compute rest of 1st derivatives using the splines
 3077:    for (int k=k1+1; k<k2; k++) {
 3078:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3079:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3080:    }
 3081:    
 3082:    delete[] a;
 3083:    delete[] b;
 3084:    delete[] c;
 3085:    delete[] gam;
 3086:    delete[] rhs;
 3087: 
 3088: }
 3089: 
 3090: // Array version
 3091: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3092:                                 double y_top, double y_bot, 
 3093:                                 CubicSpline &spline) {
 3094:    auto getX = [x] (int k) { return x[k]; };
 3095:    auto getY = [y] (int k) { return y[k]; };
 3096:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3097: }
 3098: 
 3099: // Lambda version - allows custom access patterns
 3100: template<typename XFunc, typename YFunc>
 3101: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3102:                                 double y_top, double y_bot,
 3103:                                 CubicSpline &spline) {
 3104:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3105: }
 3106: 
 3107: 
 3108: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 3109: {
 3110:    assert("Not implemented");
 3111: 
 3112:    return 0.0;
 3113: }
