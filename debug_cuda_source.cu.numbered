  727: struct Side {
  728: 
  729:    // Geometry information
  730:    int idx;               // Index of the side
  731:    Node *n1, *n2;
  732:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  733: 
  734:    double length;         // Length of the side. Used to be called distj; but I think this name is less clear now.
  735:    Vector2 center;        // Location of side center. 
  736:    double zc[nvrt];       // Side center z-coord at each vertical level
  737: 
  738:    Frame frame;
  739: 
  740:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  741:                           // this is nullptr
  742:    
  743:    int kb;                // Bottom index of the side
  744:    bool isDry;             // True if the side is dry
  745:  
  746:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  747: 
  748:    // Physical information
  749:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  750:    double  w2[nvrt];            // Vertical velocity at each vertical level
  751:    Vector2 btu[nvrt];           // Back-tracked velocity
  752:    Vector2 uth[nvrt];           // "Time history" velocity
  753:    Vector2 U;                   // Vertically averaged velocity vector  
  754: 
  755:    Vector2 d2uv[nvrt];          // divergence of (nu*grad u) XXX COMPUTE!!
  756: 
  757:    Vector2 bcc[nvrt];           // Baroclinic term
  758: 
  759:    double hhat;                 // \breve{H} in notes
  760: 
  761:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
  762: 
  763:    double coriolis;             // Coriolis parameter
  764: 
  765:    // Vegetation parameters
  766:    double veg_c2;
  767:    double veg_beta;
  768: 
  769:    // Bottom drag parameters.
  770:    double chi;
  771:    double chi2;
  772: 
  773:    __inline__ __device__ double x(double t) const;
  774:    __inline__ __device__ double y(double t) const;
  775:    __inline__ __device__ Point2 p_t(double t) const;
  776: 
  777:    __inline__ __device__ Point3 center3D(int k) const { return {center.x, center.y, zc[k]}; }
  778:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
  779:    __inline__ __device__ double Dz(int k)       const { return zc[k] - zc[k-1]; }
  780: 
  781:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
  782: 
  783:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
  784: 
  785:    __inline__ __device__ int iadv(void) const;
  786: 
  787:    __inline__ __device__ double eta2(void) const;
  788:    __inline__ __device__ double depth(void) const;
  789:    __inline__ __device__ double htot(void) const { return eta2() + depth(); }
  790: 
  791:    __inline__ __device__ double veg_h(void)  const;
  792:    __inline__ __device__ double veg_nv(void) const;
  793:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
  794:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
  795: 
  796:    __inline__ __device__ double Cd(void) const;
  797: 
  798:    __inline__ __device__ Vector2 tau(void) const;
  799: 
  800:    __inline__ __device__ double zb(void) const { return zc[kb]; }
  801:    
  802: 
  803:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
  804:    __inline__ __device__ double zLevelVegRatio(int k) const { 
  805:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
  806:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
  807:    } 
  808:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
  809:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot(); }
  810:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 1; }
  811:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 1; }
  812: 
  813:    // Get valid starting element (for backtracking)
  814:    __inline__ __device__ Element* getStartElement() {
  815:       return elems[0] ? elems[0] : elems[1];
  816:    }
  817: 
  818:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
  819:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
  820: 
  821:       // If one of the elements is null, return the other one
  822:       if      (elems[0] == nullptr) return elems[1];
  823:       else if (elems[1] == nullptr) return elems[0];
  824: 
  825: 
  826:       // Dot product of the negative velocity vector with the side normal vector
  827:       const double dot_prod1 = -dot(u, n);
  828:       
  829:       // Vector from side center to element 0 centroid
  830:       const Vector2 v2 = toVector2(elems[0]->center) - center;
  831: 
  832:       // Dot product of the vector with the side normal vector
  833:       const double dot_prod2 = dot(v2, n);
  834: 
  835:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
  836:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
  837: 
  838:       if (dot_prod1*dot_prod2 > 0.0) return elems[0];
  839:       else                           return elems[1];
  840: 
  841:  
  842:    }
  843: 
  844:    __forceinline__ __device__ Element* otherElem(const Element* elem) {
  845:       // Given an element, returns the other element that shares this side
  846:       return (elems[0] == elem) ? elems[1] : elems[0];
  847:    }
  848: 
  849:    __forceinline__ __device__ Node* otherNode(Node* node) {
  850:       // Given a node, returns the other node that shares this side
  851:       return (n1 == node) ? n2 : n1;
  852:    }
  853:  
  854:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
  855: 
  856: 
  857: 
  858: 
  859: };
  860: 
  861: 
  862: // This struct is used to store the boundary information for a node.
  863: struct NodeBoundary {   
  864:    BoundarySegment *segment;
  865:    Node *node;
  866:    
  867:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
  868:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
  869: 
  870:    double etaic;  // Elevation at nodes used for essential boundary conditions
  871:    double elbc;   // Elevation boundary condition
  872:    int iettype;   // Type of elevation boundary condition
  873:    double eth;    // Elevation time history
  874: 
  875:    bool isEssentialBC;
  876:    double bcValue;
  877: 
  878:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
  879:       assert(index == 0 || index == 1); 
  880:       return (index == 0) ? sideBnd1 : sideBnd2; 
  881:    }
  882: 
  883: 
  884: };
  885: 
  886: struct Node {
  887: 
  888:    // Geometry information
  889:    int idx;        // Index of the node
  890:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
  891:    int numNodes;   // Number of nodes neighbors of this node
  892: 
  893:    Element **elements; // Array of pointers to the elements that share this node
  894:    int numElements;   // Number of elements that share this node
  895: 
  896:    Point3 p;
  897:    Vector3 u2[nvrt];
  898:    double znl[nvrt];
  899:    double lon, lat;
  900:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
  901:    double depth;
  902: 
  903:    int kb;       // Bottom index of the node
  904: 
  905:    bool isDry;     // True if the node is dry
  906: 
  907:    int iadv;     // Advection flag
  908: 
  909:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
  910: 
  911:    // Physical information
  912:    Tracers tr_nd0[nvrt]; // Initial tracer conc. at nodes
  913: 
  914:    double rho[nvrt];     // Density
  915: 
  916:    double eta1; // Elevation at nodes at previous timestep
  917:    double eta2; // Elevation at nodes at current timestep
  918: 
  919:    double ETP;  // Earth Tidal Potential
  920: 
  921:    
  922:    double pr;    // Air pressure
  923:    double grav2; // Gravity 
  924:    
  925:    Vector2 dav;  // Depth averaged velocity
  926: 
  927:    Vector2 tau; // Wind stress vector
  928: 
  929:    // Vegetation parameters
  930:    double veg_h;
  931:    double veg_nv;
  932:    double veg_di;
  933:    double veg_Cd;
  934:    double veg_h_unbent;
  935:    double veg_di_unbent;
  936:    double veg_nv_unbent;
  937:    double veg_alpha_vert_mean;
  938:    double veg_alpha0;
  939:    double veg_alpha3D[nvrt];
  940: 
  941:    // Bottom drag parameters
  942:    double Cd;       // Bottom drag coefficient
  943:    double rough;    // Bottom roughness length
  944:    Vector2 tau_bot; // Bottom stress vector
  945: 
  946:    double bdef1; // Bottom deformation at previous timestep
  947:    double bdef2; // Bottom deformation at current timestep
  948: 
  949:    double qel; // RHS
  950:    double coeffDiag; // Diagonal coefficient of the matrix
  951:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
  952: 
  953:    double mP; // Search direction for conjugate gradient method
  954:    double mR; // Residual for conjugate gradient method
  955:    double mAp; // Product of matrix and search direction for conjugate gradient method
  956:    double mX; // Solution for conjugate gradient method
  957: 
  958:    // Meteorological forcing
  959:    Vector2 u_air;
  960:    double p_air;
  961:    double t_air;
  962:    double q_air;
  963:    double wind_angle;  // Wind rotation angle
  964: 
  965:    __host__ __device__ void setWind(Vector2 &u) {
  966:    // Sets the wind vector taking into account the wind rotation angle
  967:    
  968:       const double dir = atan2(-u.x,-u.y);
  969:       const double speed = length(u);
  970: 
  971:       // Calculate new u and v components with added rotation angle
  972:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
  973:    }
  974: 
  975:    __host__ __device__ Point2 p2(void) const { return {p.x, p.y}; }
  976: 
  977:    __host__ __device__ double sigmaTransitionDepth(void) const;
  978: 
  979:    __inline__ __device__ double Dz(int k) const { return znl[k] - znl[k-1]; }
  980:    __inline__ __device__ double htot(void) const { return eta2 + depth; }
  981:    __inline__ __device__ double zTopCanopy(void) const { return znl[kb] + veg_h; } 
  982: 
  983:    __device__ void clearMatrixRow(void) {
  984:       // Clear the matrix row for this node
  985:       coeffDiag = 0.0;
  986:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
  987: 
  988:    }
  989: 
  990:    __device__ void addToSparseMatrix(Node const *node, double value) {
  991:       // Add the value to the sparse matrix for this node
  992:       
  993:       if (node == this) {
  994:          coeffDiag += value;
  995: printf("addToSparseMatrix: node == this, value = %f\n", coeffDiag);         
  996:       } else {
  997:          // Search (linearly)the index of the node in the array of nodes
  998:          // XXX: This is not efficient, see if we can improve this
  999:          int i;
 1000:          for (i = 0; i < numNodes; i++) {
 1001:             if (nodes[i] == node) {
 1002:                break;
 1003:             }
 1004:          }
 1005:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1006:          coeffMatrix[i] += value;
 1007:       }
 1008:    }
 1009: 
 1010: #ifdef BACKTRACKING
 1011:    __device__ void updateZCoordData() {
 1012:    // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 1013: 
 1014:       // Check if node is wet
 1015:       isDry = (depth + eta2 <= h0);  // XXX Check if we are doing this elsewhere
 1016: 
 1017:       if (idry) return;
 1018: 
 1019:       if constexpr(ivcor == 2) {  // SZ coordinates
 1020:          
 1021:          // Compute bottom level index
 1022:          if (depth <= mesh->h_s) {
 1023:                kb = mesh->nzlevels;
 1024:          } else {
 1025:                kb = -1;
 1026:                for (int i = 0; i < mesh->kz-1; i++) {
 1027:                   if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 1028:                      kb = i;
 1029:                      break;
 1030:                   }
 1031:                }
 1032:          }
 1033:       } 
 1034:       else if (ivcor == 1) {  // Localized sigma
 1035:          // Do nothing
 1036:       }
 1037: 
 1038:    }
 1039: #endif   
