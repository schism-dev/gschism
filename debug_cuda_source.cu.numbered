 1978: 
 1979: __host__ __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 1980: 
 1981: __device__ double Node::compZCoord(int k) const {
 1982:    // Computes the z coordinate at level k.
 1983:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 1984:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 1985:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 1986:    // used 
 1987:    
 1988:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 1989:       
 1990:    if (idry) {
 1991:       return 0.0;
 1992:    }
 1993: 
 1994:    if constexpr(ivcor == 2) {
 1995: 
 1996:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 1997:       const int kz = mesh->kz;
 1998: 
 1999:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2000:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2001:       // once per time step/node.
 2002:       // CHECK: updateZCoordData
 2003:       if (k == kz)               return -hmod2;
 2004:       else if (k == nvrt-1)      return eta2;
 2005:       else if (k == kb)          return -depth;
 2006:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2007:       else if (k > kz) {
 2008:          const int ksig = k - kz + 1;
 2009: 
 2010:          if (hmod2 <= mesh->h_c) {
 2011:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2012:          } 
 2013:          else if (eta2 <= - mesh->h_c - (depth - mesh->h_c) * mesh->theta_f/mesh->sinh_theta_f) {
 2014:             printf("Please choose larger h_c: %f %f\n", eta2, mesh->h_c);
 2015:             Error("ZCOOR: invalid h_c\n");
 2016:          } 
 2017:          else {
 2018:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2019:                          mesh->h_c * mesh->sigma[ksig] + 
 2020:                          (hmod2 - mesh->h_c) * mesh->cs[ksig];
 2021:          }
 2022:       } else { 
 2023:          Error("ZCOOR: invalid level or coordinate system\n");
 2024:       }
 2025: 
 2026:    }
 2027:    else if constexpr(ivcor == 1) {
 2028:       if (k == kb) return -depth;
 2029:       else if (k == nvrt-1) return eta2;
 2030:       else if (k >= kb) {
 2031:             return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2032:       }
 2033:    }
 2034:    
 2035:    printf("ZCOOR: invalid level or coordinate system\n");
 2036:    return 0.0;
 2037: }
 2038: 
 2039: 
 2040: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2041:                 double *node_coords, double *wind_rotate_angle, 
 2042:                 int *isdel, int *isidenode, int *isbnd,
 2043:                 int *nond, int *nlnd, int *iond, int *ilnd,
 2044:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2045:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2046:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2047:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2048:                 int *localNodePart,     int *localElemPart,     int *localSidePart) {
 2049: 
 2050:    printf("Populating mesh for partition %d, %d, %d\n", partNum, nond, nlnd);
 2051: 
 2052:    // Horizontal grid
 2053:    printf("Processing %d nodes\n", np);    
 2054:    int idxNodeBoundary = 0;  
 2055:    for (int i = 0; i < np; i++)
 2056:    {
 2057:       Node &node = localNodeData[i];
 2058: 
 2059:       const int idxStart = nodeNeighNodesStart[i];
 2060:       const int idxEnd   = nodeNeighNodesStart[i+1];
 2061:       node.numNodes = idxEnd - idxStart;
 2062:       node.nodes = (Node **)(nodeNeighNodes + idxStart*sizeof(Node *));
 2063:       node.idx = i;
 2064: 
 2065:       for (int idx = idxStart; idx < idxEnd; idx++) {
 2066:          int idxNode = nodeNeighNodesIndices[idx];
 2067:          Node *node_ptr = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 2068: 
 2069:          nodeNeighNodes[idxNode] = node_ptr;
 2070:          node.nodes = &(nodeNeighNodes[idxNode]);
 2071:       }
 2072: 
 2073:       // Element **elements; // pointer to the elements connected to this node
 2074:       // int numElements;   // number of elements shared by this node
 2075: 
 2076:       node.p.x = node_coords[i * 3];
 2077:       node.p.y = node_coords[i * 3 + 1];
 2078:       node.p.z = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2079:       node.depth = node_coords[i * 3 + 2];
 2080: 
 2081:       // Links the node to the boundary information
 2082:       if (isbnd[i] >= 0) {
 2083:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2084:          if (isbnd[i]>0) {
 2085: 
 2086:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2087:             node.nodeBnd->segment->ifltype = isbnd[i];
 2088: 
 2089:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2090:             node.nodeBnd->segment->clen  = nan("1");
 2091:             node.nodeBnd->segment->carea = nan("1");
 2092: 
 2093:          }
 2094:          else {
 2095:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2096:          }
 2097:          
 2098:          idxNodeBoundary++;
 2099:       }
 2100:       else {
 2101:          node.nodeBnd = nullptr;
 2102:       }
 2103: 
 2104: // XXXX
 2105: constexpr double rot_per = 3000.0;
 2106: constexpr double rot_f = 2.0*pi/rot_per;
 2107: for (int k = 0; k < nvrt; k++) {node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0};}
 2108: // XXXXX
 2109:    }
 2110: 
 2111:    nbp = idxNodeBoundary;
 2112: 
 2113:    printf("Processing %d sides\n", ns);
 2114:    int idxSideBoundary = 0;
 2115:    for (int i = 0; i < ns; i++)
 2116:    {
 2117:       Side &side = localSideData[i];
 2118:       side.idx = i;
 2119:       // finding the pointer to the nodes that form the side
 2120:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2121:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2122: 
 2123:       const int locidx_n1 = localNodeIndices[idx_n1];
 2124:       const int locidx_n2 = localNodeIndices[idx_n2];
 2125:       const int part_n1 =   localNodePart[idx_n1];
 2126:       const int part_n2 =   localNodePart[idx_n2];
 2127: 
 2128:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2129:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2130: 
 2131:       // Normal vector to the side
 2132:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2133:       const double norm = sqrt(dot(side.n, side.n));
 2134:       side.n = side.n/norm;
 2135: 
 2136:       // Side boundary type
 2137:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 2138:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 2139:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2140:       
 2141:       if (n1bnd != nullptr || n2bnd != nullptr) 
 2142:       {
 2143:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2144:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2145:          else                  side.sideBnd->segment = n2bnd->segment;
 2146:          side.sideBnd->side = &side;
 2147:          idxSideBoundary++;
 2148:       }
 2149:       else side.sideBnd = nullptr;
 2150: 
 2151:       // finding the pointer to the elements that share the side
 2152:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2153:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2154: 
 2155:       if (idx_e1 > -1) {
 2156:          const int locidx_e1 = localElemIndices[idx_e1];
 2157:          const int part_e1 =  localElemPart[idx_e1];
 2158:          side.elems[0] = (Element *)&(elems[part_e1][locidx_e1]);
 2159:       }
 2160:       else {
 2161:          side.elems[0] = nullptr;
 2162:       }
 2163: 
 2164:       if (idx_e2 > -1) {
 2165:          const int locidx_e2 = localElemIndices[idx_e2];
 2166:          const int part_e2 =  localElemPart[idx_e2];
 2167:          side.elems[1] = (Element *)&(elems[part_e2][locidx_e2]);
 2168:       }
 2169:       else {
 2170:          side.elems[1] = nullptr;
 2171:       }
 2172: 
 2173: 
 2174: 
 2175:       // Compute the center of the side
 2176:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2177: 
 2178: // XXXX
 2179: constexpr double rot_per=3000.0;
 2180: constexpr double rot_f=2.0*pi/rot_per;
 2181: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2182: // XXXXX      
 2183: 
 2184:       // Compute the z level at the center of the side
 2185:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->znl[k] + side.n2->znl[k]);
 2186: 
 2187:       // Compute the length of the side
 2188:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2189:       side.length = sqrt(dot(vLen, vLen));
 2190: 
 2191:    }
 2192: 
 2193:    printf("Processing %d elements\n", ne);
 2194:    for (int i = 0; i < ne; i++)
 2195:    {
 2196:       Element &elem = localElemData[i];
 2197:       elem.idx = i;
 2198:       for (int j = 0; j < i34[i]; j++) {
 2199:          const int idxNode = elnode[i*4 + j];  
 2200:          const int idxSide = elside[i*4 + j];
 2201:          
 2202:          elem.nodes[j] = (Node *)&(nodes[localElemPart[idxNode]][localElemIndices[idxNode]]);
 2203:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2204: 
 2205:          // Find the neighboring element  
 2206:          if (elem.sides[j]->elems[0] == &elem) {
 2207:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2208:          }
 2209:          else {
 2210:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2211:          }
 2212:       }
 2213: 
 2214:       
 2215: 
 2216:       elem.i34 = i34[i];
 2217:       elem.wind_angle = wind_rotate_angle[i];
 2218: 
 2219:       // Compute the centroid of the element and its depth
 2220:       Vector2 center = {0.0, 0.0};
 2221:       elem.depth = 0.0;
 2222:       for (int j = 0; j < i34[i]; j++) {
 2223:          center += elem.nodes[j]->p2()/i34[i];
 2224:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2225:       }
 2226:       elem.center.x = center.x;
 2227:       elem.center.y = center.y;
 2228:       
 2229:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2230:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2231: 
 2232:       elem.area = elem.computeSignedArea(); 
 2233:       elem.radius = sqrt(elem.area)/pi; 
 2234:       
 2235:       // Determines which way the normal vector to each side is oriented.
 2236:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2237:       for (int j = 0; j < i34[i]; j++)  
 2238:       {
 2239:          if (elem.sides[j]->elems[0] == &elem) {
 2240:             elem.ssign[j] =  1.0;
 2241:          }
 2242:          else {
 2243:             elem.ssign[j] = -1.0;
 2244:          }
 2245: 
 2246:       }
 2247: 
 2248:       // Derivatives of shape functions
 2249:       //  For ics=2, this is done inside element/ll frame XXX
 2250:       //  For quads, the derivative is evaluated at centroid
 2251:       const int i34 = elem.i34;
 2252:       for (int j = 0; j < i34; j++) {
 2253:          const double area = elem.area;
 2254:          const int id2 = elem.nxq(1 + j);
 2255:          const int id3 = elem.nxq(2 + j);
 2256:          const int id4 = elem.nxq(3 + j);
 2257:          if (elem.isTri()) {
 2258:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2259:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2260:             // da1/dx = (y1 - y2)/(2*area)
 2261:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2262:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2263:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2264:          }
 2265:          else  { // Quad; evaluate at centroid
 2266:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2267:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2268:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2269:          } // if Tri
 2270: 
 2271:       } // for j
 2272: 
 2273:    }
 2274: 
 2275: 
 2276: 
 2277:    
 2278: }
 2279: 
 2280: 
 2281: __global__ void setupCoefficientMatrixAndRHS(double time) {
 2282: // Setup coefficient matrix, sparsem, for the shallow water wave equation
 2283: // No elevation essential b.c. are imposed yet but other b.c. is imposed
 2284: // 
 2285: // This kernel is called for all nodes.
 2286: 
 2287:    int in = 1; //XXX blockIdx.x * blockDim.x + threadIdx.x;
 2288: 
 2289:    Node *node1 = &(mesh->localNodeData[in]);
 2290: 
 2291: 
 2292:    node1->clearMatrixRow();
 2293:    node1->qel = 0.0;
 2294: 
 2295:    // THIS IS FOR STRUCTURES XXX
 2296:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 2297: 
 2298: 
 2299:    for (int j=0; j<node1->numElements; j++) {
 2300:       // For each element connected to the node...
 2301: 
 2302:       Element *elem = node1->elements[j];
 2303: 
 2304: 
 2305:       // Compute the average gravity
 2306:       const double grav3 = elem->mean(&Node::grav2);
 2307: 
 2308:       // Look at the documentation for the description of the terms in the following integrals
 2309: 
 2310:       // Integral I_1 
 2311:       // \bar{\breve{H}} 
 2312:       const double hhatb = elem->mean(&Side::hhat);        
 2313: 
 2314:       assert((hhatb >= 0.0 || ihh != 1) && "Invalid hhat");
 2315: 
 2316:       const int id1 = elem->nodeLocalIdx(node1); 
 2317:       const double area = elem->area;
 2318: 
 2319:       if (elem->isTri()) {
 2320: 
 2321:          // To clarify the notation in this section: 
 2322:          //   i standtimes for the node under consideration (node1)
 2323:          //   j (node2) and k (node3) are the other nodes of the triangle.
 2324:          const int id2 = elem->nxq(1 + id1);
 2325:          const int id3 = elem->nxq(2 + id1);
 2326:          Node *node2 = elem->nodes[id2];
 2327:          Node *node3 = elem->nodes[id3];
 2328: 
 2329:          const Point2 x1 = node1->p2();
 2330:          const Point2 x2 = node2->p2();
 2331:          const Point2 x3 = node3->p2();
 2332: 
 2333:          // integral of phi_i*phi_j
 2334:          const double ipp_ii = (1.0/6.0 )*area;
 2335:          const double ipp_ij = (1.0/12.0)*area;
 2336:          const double ipp_ik = (1.0/12.0)*area;
 2337: 
 2338:          // integral of [(grad phi_i) * (grad phi_j)]
 2339:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 2340:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 2341:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 2342: 
 2343:          // Computes the different components of integral I_1 of each node with respect to node i.
 2344:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 2345:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 2346:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 2347: 
 2348:          node1->addToSparseMatrix(node1, I1_ii);
 2349:          node1->addToSparseMatrix(node2, I1_ij); 
 2350:          node1->addToSparseMatrix(node3, I1_ik);
 2351:      
 2352:       }
 2353:       else { // Quad
 2354:          // XXX IMPLEMENT THIS
 2355:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2356:       } 
 2357: 
 2358:  
 2359:       // Integral I_4
 2360:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 2361:       // Where
 2362:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 2363: 
 2364:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 2365:       // of U over the element.
 2366:       Vector2 Umean = {0.0, 0.0};
 2367:       for (int m=0; m<elem->i34; m++) {      
 2368:          const Side *side = elem->sides[m];
 2369: 
 2370:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 2371:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 2372:       }
 2373:       Umean = Umean/elem->i34;
 2374: 
 2375:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 2376: 
 2377:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 2378:       const double I_4_1 = dot(gradPhi_1, Umean);
 2379: 
 2380:       // Integral of \nabla\phi_i \cdot \pmb{E}
 2381:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 2382:      
 2383:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);
 2384:       
 2385: 
 2386:       // Additional terms 
 2387:       double vnorm = 0.0;
 2388:       if (imm == 2)  { // Pre-compute vnorm on the element
 2389:          Vector3 ubed;
 2390:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 2391: 
 2392:          Vector3 gradP(0.0, 0.0, 1.0);
 2393:          for (int m=0; m < elem->i34; m++) {
 2394:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 2395:            gradP += toVector3(gradP_2D, 0.0);
 2396:          }   
 2397:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 2398:       } // imm==2
 2399: 
 2400:       if (elem->isTri()) {
 2401:          for (int l=0; l<3; l++) {
 2402:            double fac;
 2403: 
 2404:            Node *node = elem->nodes[l];
 2405: 
 2406:            (node == node1)? fac=2.0 : fac=1.0;
 2407: 
 2408:            if (imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 2409:            else        node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 2410:            
 2411:          }
 2412: 
 2413:          if (elem->idry == 0) {
 2414:            const Vector2 gradEta = elem->nodes[0]->eta2*elem->gradPhi[0] +
 2415:                                    elem->nodes[1]->eta2*elem->gradPhi[1] +
 2416:                                    elem->nodes[2]->eta2*elem->gradPhi[2];
 2417: 
 2418:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 2419:          }
 2420: 
 2421:       } // isTri
 2422:       else { // isQuad
 2423:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2424:          // for (int l=0; l<4; l++) {
 2425:          //   const Node *node = elem->nodes[l];
 2426: 
 2427:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 2428:          //   else        tmp2 = node->bdef2 - node->bdef1;
 2429: 
 2430:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 2431:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 2432:          // }
 2433: 
 2434:       } // isQuad
 2435: 
 2436: 
 2437: 
 2438:       node1->qel += (dt/elem->i34)*elem->vsource;
 2439: 
 2440:    } // for all elements connected to the node
 2441:    
 2442: 
 2443: 
 2444:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 2445:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 2446:    NodeBoundary *nodeBnd = node1->nodeBnd;
 2447:    if (nodeBnd != nullptr)  { 
 2448:       // If it is an open boundary node...
 2449: 
 2450:       // At least one open bnd side, maybe two
 2451:       for (int l=0; l<2; l++) { 
 2452: 
 2453:          // Gets each of the sides sharing the node. 
 2454:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 2455: 
 2456:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 2457: 
 2458:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 2459: 
 2460: 
 2461:          if (sideBnd != nullptr) {
 2462:             // If the side is on a boundary...
 2463: 
 2464:             // Get the boundary segment
 2465:             const BoundarySegment *sideSegment = sideBnd->segment;
 2466:             const Side *side = sideBnd->side;
 2467: 
 2468:             // Integral I_3
 2469:             if (sideSegment->ifltype != 0) {
 2470:             // Natural or Flather b.c.
 2471: 
 2472:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 2473:                // especially for Flather b.c.
 2474:                double ri3 = 0.0;
 2475:                if (side->idry != 1) {
 2476:                   // If the side is not dry
 2477:                   
 2478:                   // Computes the side flux of (uth, vth)
 2479:                   double Vn = 0.0;
 2480:                   for (int k = side->kb; k<nvrt-1; k++) {
 2481:                      // uth, vth in lat/lon frame if ics=2
 2482:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 2483:                      const double vn1 = dot(side->uth[k  ], side->n); // outer normal
 2484:                      const double vn2 = dot(side->uth[k+1], side->n);
 2485: 
 2486:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 2487:                   }
 2488: 
 2489:                   ri3 = 0.5*side->length*Vn;
 2490:                }
 2491: 
 2492:                if (sideSegment->ifltype == -1) { // Flather 1
 2493: 
 2494:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 2495:                   assert(side->depth > 0.0 && "Negative depth at Flather boundary");
 2496: 
 2497:                   const double con0 = (1.0/6.0)*side->length*sqrt(grav*side->depth); // For coefficient matrix
 2498:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 2499:                   
 2500:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 2501:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 2502: 
 2503:                } 
 2504:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 2505:                   // Reset ri3
 2506:                   ri3 = 0.0;
 2507: 
 2508:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 2509: 
 2510:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 2511: 
 2512:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 2513:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 2514: 
 2515:                   const double con0 = (1.0/6.0)*side->length*tmp*thetai*dt;
 2516:                   node1->addToSparseMatrix(node1, con0*2.0);
 2517:                   node1->addToSparseMatrix(node2, con0);
 2518: 
 2519:                } // if Flather or Discharge
 2520: 
 2521:                node1->qel -= thetai*dt*ri3;
 2522: 
 2523:             } // I_3
 2524:           
 2525: 
 2526:             // Integral I_5
 2527:             if(side->idry != 1) {
 2528: 
 2529:                const double Unbar = dot(side->U, side->n);
 2530: 
 2531:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->length*Unbar;
 2532:                
 2533:             } // I_5
 2534: 
 2535:          } // if is boundary side
 2536: 
 2537:       } // for l
 2538: 
 2539:    } // if isbnd
 2540: 
 2541: }
 2542: 
 2543: 
 2544: extern "C" {
 2545:    __global__ void backtrackAllNodes(void) {
 2546: 
 2547:       // max/min # of sub-divisions
 2548:       const int ndelt_max = max(1.0, dt/dtb_min);
 2549:       const int ndelt_min = max(1.0, dt/dtb_max); 
 2550: 
 2551:       // Removed all references to swild98 XXX
 2552:       // swild98=0.d0 !init
 2553: 
 2554:       SIDE(side);
 2555: 
 2556:       if (side - mesh->localSideData >= mesh->ns) return;
 2557: 
 2558:       const int kb = side->kb;
 2559: 
 2560:       // Initialize btrack velocities to the actual velocities at the side 
 2561:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 2562: 
 2563:       if (side->idry == 1) return;
 2564: 
 2565:       // Checks that at least one element is not dry
 2566:       const Element *elem1 = side->elems[0];
 2567:       const Element *elem2 = side->elems[1];
 2568:       assert ((elem1 != nullptr && !(elem1->idry)) || (elem2 != nullptr && !(elem2->idry)) && "backtrackAllNodes: non dry side without two dry elements.");
 2569: 
 2570:       // XXXXXX
 2571:       // !swild_tmp to store global coord. of the starting side
 2572:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 2573:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 2574:       // !Use sframe2 
 2575:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 2576: 
 2577: 
 2578:       for (int k = kb; k < nvrt; k++) {
 2579:       //  Initialize (xt,yt,zt), nnel and vel.
 2580:       //  For ics=2, the coordinates are in local frames
 2581:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 2582: 
 2583: 
 2584:          const int iadvf = side->iadv();  // Advection flag
 2585: 
 2586:          Point3 xt;
 2587:          if constexpr(ics==1) {
 2588:             xt = side->center3D(k); 
 2589:          }
 2590:          else // lat/lon; in side lat/lon frame
 2591:          {
 2592:          // XXX IMPLEMENT THIS
 2593:       //          xt=0.d0
 2594:       //          yt=0.d0
 2595:       //          !centroid coord. for nudging
 2596:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 2597:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 2598:          }  // ics
 2599: 
 2600: 
 2601:          // Velocity at the side (in ll frame for ics, same vertical direction)
 2602:          // XXX IS THIS NECESSARY?
 2603:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 2604: 
 2605:          // If on land or open boundary...
 2606:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 2607:          
 2608:          const double vmag = length(toVector2(u_int));
 2609: 
 2610:          if (vmag <= velmin_btrack) {
 2611:             // No activity 
 2612: 
 2613:             side->btu[k] = side->u2[k];
 2614: 
 2615: 
 2616:          } else {  // do btrack
 2617: 
 2618:             // Compute number of sub-divisions based on local gradients 
 2619:             // XXX IS THIS NECESSARY?
 2620:             double suma = 0.0;
 2621:             int icount = 0;
 2622:             for (int ii=0; ii<2; ii++) {
 2623: 
 2624:                const Element *elem = side->elems[ii];
 2625:                  
 2626:                if (elem == nullptr) continue;
 2627: 
 2628:                icount++;
 2629: 
 2630:                // Not strictly along z; in ll frame for ics=2
 2631: 
 2632:                double utmp[4];
 2633:                double vtmp[4];
 2634:                for (int jj = 0; jj < elem->i34; jj++) {
 2635: 
 2636:                   const Node *node = elem->nodes[jj];
 2637: 
 2638:                   if constexpr(ics==1) {
 2639:                      utmp[jj] = node->u2[k].x;
 2640:                      vtmp[jj] = node->u2[k].y;  
 2641:                   } else {
 2642:                      // XXX IMPLEMENT THIS
 2643:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 2644:                   }
 2645:                } // for jj
 2646: 
 2647:                const Vector2 grad_u = elem->grad(utmp); 
 2648:                const Vector2 grad_v = elem->grad(vtmp);
 2649: 
 2650:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 2651:             } // for ii
 2652: 
 2653:             assert(icount > 0 && "Impossible 77");
 2654: 
 2655:             // '4' is somewhat arbitrary
 2656:             const int ndelt = max(ndelt_min, min(ndelt_max, int(suma/icount)*4)); // >=1
 2657:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 2658: 
 2659: 
 2660:             // Perturb starting pt to avoid underflow 
 2661:             // XXX I don't think this is needed with the current implementation
 2662:             // eps=btrack_nudge
 2663:             // if constexpr(ics==1) {
 2664:             //    xt=(1.d0-eps)*xt+eps*xctr(nnel)
 2665:             //    yt=(1.d0-eps)*yt+eps*yctr(nnel)
 2666:             // } else { //lat/lon
 2667:             //    xt=(1.d0-eps)*xt+eps*xctr2
 2668:             //    yt=(1.d0-eps)*yt+eps*yctr2
 2669:             // } // ics
 2670: 
 2671:          
 2672:             // call btrack(l,ipsgb,ifl_bnd,j,iadvf,swild_tmp,swild10_tmp, dtbk,time_rm,time_rm2,uuint,vvint,wwint,nnel,jlev,xt,yt,zt,swild3,ltmp)
 2673: 
 2674:                
 2675:          } // if vmag (do backtrack)
 2676: 
 2677:       } // for j=jmin,nvrt-1
 2678: 
 2679:    }
 2680: } // extern "C"
 2681: 
 2682: template<int nc>
 2683: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 2684: 
 2685: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 2686: //
 2687: // a,b,c,r: input vectors and are not modified by this program.
 2688: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 2689: // r is the r.h.s.
 2690: // n: actual rank of the system.
 2691: // rows in u() and r();
 2692: // u: output with nc columns (transposed to rows)
 2693: // gam: a working array.
 2694: //
 2695: // NOTES:
 2696: // This is a template function that allows for different numbers of columns in the rhs vector.
 2697: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 2698: 
 2699:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 2700:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 2701: 
 2702:    double bet = b[0];
 2703:    if constexpr (nc == 1) {
 2704:       u[0] = rhs[0]/bet;
 2705:    } else {
 2706:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 2707:    }
 2708: 
 2709:    for (int j = 1; j < n; j++) {
 2710:       gam[j] = c[j-1]/bet;
 2711:       bet = b[j] - a[j]*gam[j];
 2712: 
 2713:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 2714: 
 2715:       if constexpr (nc == 1) {
 2716:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 2717:       } else {
 2718:          for (int k = 0; k < nc; k++) {
 2719:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 2720:          }
 2721:       }
 2722:    }
 2723: 
 2724:    // Back-substitution
 2725:    for (int j=n-1; j>=1; j--) {
 2726:       if constexpr (nc == 1) {
 2727:          u[j] = u[j] - gam[j+1]*u[j-1];
 2728:       } else {
 2729:          for (int k = 0; k < nc; k++) {
 2730:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 2731:          }
 2732:       }
 2733:    }
 2734: }
 2735: 
 2736: 
 2737: 
 2738: 
 2739: // Helper function that contains the core algorithm
 2740: template<typename XAccessor, typename YAccessor>
 2741: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 2742:                                     double  yp_top, double  yp_bot, 
 2743:                                     CubicSpline &spline) {
 2744:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 2745:    // 
 2746:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 2747:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 2748:    //
 2749:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 2750:    // 
 2751:    // Inputs: 
 2752:    //            n: dimension for x etc; # of data pts (>=2);
 2753:    //            getX, getY: functions to access x,y coordinates
 2754:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 2755:    //     Output: 
 2756:    //            spline (CubicSpline): spline structure with x,y,y',y''
 2757: 
 2758:    const int n = k2 - k1 + 1;
 2759:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 2760: 
 2761:    // Allocate memory for the splines
 2762:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 2763:    spline.x   = new double[n];
 2764:    spline.y   = new double[n];
 2765:    spline.yp  = new double[n];
 2766:    spline.ypp = new double[n];
 2767: 
 2768:    for (int k=k1; k<=k2; k++) {
 2769:       spline.x[k] = getX(k);
 2770:       spline.y[k] = getY(k);
 2771:    }
 2772: 
 2773:    // This is to simplify expressions later
 2774:    double *x = spline.x;
 2775:    double *y = spline.y;
 2776: 
 2777:    double *a = nullptr;
 2778:    double *b = nullptr;
 2779:    double *c = nullptr;
 2780:    double *gam = nullptr;
 2781:    double *rhs = nullptr;
 2782:    
 2783: 
 2784:       a = new double[n];   // Lower diagonal
 2785:       b = new double[n];   // Diagonal
 2786:       c = new double[n];   // Upper diagonal
 2787:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 2788:       rhs = new double[n]; // Right-hand side
 2789: 
 2790:    for (int k=k1; k<=k2; k++) {
 2791:       if (k == k1) {
 2792:          // Bottom level
 2793:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 2794:          b[k] = (x[k+1] - x[k])/3.0;
 2795:          c[k] = b[k]/2.0;
 2796:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 2797:       } else if (k == n - 1) {
 2798:          // Top level (surface)
 2799:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 2800:          b[k] = (x[k] - x[k-1])/3.0;
 2801:          a[k] = b[k]/2.0;
 2802:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 2803:       } else {
 2804:          // Intermediate levels
 2805:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 2806:          b[k] = (x[k+1] - x[k-1])/3.0;
 2807:          a[k] = (x[k  ] - x[k-1])/6.0;
 2808:          c[k] = (x[k+1] - x[k  ])/6.0;
 2809:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 2810:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 2811:       }
 2812:    }
 2813: 
 2814:    // Solve the tridiagonal system
 2815:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 2816:    
 2817:    spline.yp[k1] = yp_bot;
 2818:    spline.yp[k2] = yp_top;
 2819: 
 2820:    // Compute rest of 1st derivatives using the splines
 2821:    for (int k=k1+1; k<k2; k++) {
 2822:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 2823:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 2824:    }
 2825:    
 2826:    delete[] a;
 2827:    delete[] b;
 2828:    delete[] c;
 2829:    delete[] gam;
 2830:    delete[] rhs;
 2831: 
 2832: }
 2833: 
 2834: // Array version
 2835: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 2836:                                 double y_top, double y_bot, 
 2837:                                 CubicSpline &spline) {
 2838:    auto getX = [x] (int k) { return x[k]; };
 2839:    auto getY = [y] (int k) { return y[k]; };
 2840:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 2841: }
 2842: 
 2843: // Lambda version - allows custom access patterns
 2844: template<typename XFunc, typename YFunc>
 2845: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 2846:                                 double y_top, double y_bot,
 2847:                                 CubicSpline &spline) {
 2848:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 2849: }
 2850: 
 2851: 
 2852: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 2853: {
 2854:    assert("Not implemented");
 2855: 
 2856:    return 0.0;
 2857: }
