  141: // VECTOR/POINT operations ---------------------------------------------------------------------------
  142: 
  143: using Vector2 = double2; 
  144: using Vector3 = double3;
  145: using Point2  = double2;
  146: using Point3  = double3;
  147: 
  148: __device__ __host__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
  149:     return make_double2(a.x + b.x, a.y + b.y);
  150: }
  151: 
  152: __device__ __host__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
  153:     a.x += b.x;
  154:     a.y += b.y;
  155:     return a;
  156: }
  157: 
  158: __device__ __host__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
  159:     return make_double2(a.x - b.x, a.y - b.y);
  160: }
  161: 
  162: __device__ __host__ __forceinline__ double2 operator-=(double2& a, const double2& b) {
  163:     a.x -= b.x;
  164:     a.y -= b.y;
  165:     return a;
  166: }
  167: 
  168: __device__ __host__ __forceinline__ double2 operator*(const double2& v, const double s) {
  169:     return make_double2(v.x * s, v.y * s);
  170: }
  171: 
  172: __device__ __host__ __forceinline__ double2 operator*(const double s, const double2& v) {
  173:     return v * s;  // reuse the previous operator
  174: }
  175: 
  176: __device__ __host__ __forceinline__ double2 operator/(const double2& v, double s) {
  177:     return make_double2(v.x / s, v.y / s);
  178: }
  179: 
  180: __device__ __host__ __forceinline__ double length(const double2& v) {
  181:     return sqrt(v.x*v.x + v.y*v.y);
  182: }
  183: 
  184: __device__ __host__ __forceinline__ double2 normalize(const double2& v) {
  185:     return v / length(v);
  186: }
  187: 
  188: __device__ __host__ __forceinline__ double dot(const double2& v, const double2& w) {
  189:     return v.x*w.x + v.y*w.y;
  190: }
  191: 
  192: __device__ __host__ __forceinline__ double cross(const double2& v, const double2& w) {
  193:     return v.x*w.y - v.y*w.x;
  194: }
  195: 
  196: __device__ __host__ __forceinline__ double2 rot90(const double2& a) {
  197:     return make_double2(a.y, -a.x);
  198: }
  199: 
  200: __device__ __host__ __forceinline__ double3 operator+(const double3& a, const double3& b) {
  201:     return make_double3(a.x + b.x, a.y + b.y, a.z + b.z);
  202: }
  203: 
  204: __device__ __host__ __forceinline__ double3 operator+=(double3& a, const double3& b) {
  205:     a.x += b.x;
  206:     a.y += b.y;
  207:     a.z += b.z;
  208:     return a;
  209: }
  210: 
  211: __device__ __host__ __forceinline__ double3 operator-(const double3& a, const double3& b) {
  212:     return make_double3(a.x - b.x, a.y - b.y, a.z - b.z);
  213: }
  214: 
  215: __device__ __host__ __forceinline__ double3 operator*(const double3& v, double s) {
  216:     return make_double3(v.x * s, v.y * s, v.z * s);
  217: }
  218: 
  219: __device__ __host__ __forceinline__ double3 operator*(double s, const double3& v) {
  220:     return v * s;
  221: }
  222: 
  223: __device__ __host__ __forceinline__ double3 operator/(const double3& v, double s) {
  224:     return make_double3(v.x / s, v.y / s, v.z / s);
  225: }
  226: 
  227: __device__ __host__ __forceinline__ double dot(const double3& v, const double3& w) {
  228:     return v.x*w.x + v.y*w.y + v.z*w.z;
  229: }
  230: 
  231: __device__ __host__ __forceinline__ Vector2 toVector2(const double3& v) {
  232:     return make_double2(v.x, v.y);
  233: }
  234: 
  235: __device__ __host__ __forceinline__ double3 toVector3(const double2& v, double w) {
  236:     return make_double3(v.x, v.y, w);
  237: }
  238: 
  239: __device__ __host__ __forceinline__ Point2 toPoint2(const double3& p) {
  240:     return make_double2(p.x, p.y);
  241: }
  242: 
  243: __device__ __host__ __forceinline__ Point3 toPoint3(const double2& p, double z) {
  244:     return make_double3(p.x, p.y, z);
  245: }
