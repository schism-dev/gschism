  983: extern "C" {
  984:    __global__ void getStructSizes(int* sizes)  {
  985:       // Get the size of each struct. This is used to allocate memory for the structs in the host code.
  986:        sizes[0] = (int)sizeof(Node);
  987:        sizes[1] = (int)sizeof(Element);
  988:        sizes[2] = (int)sizeof(Side);
  989:        sizes[3] = (int)sizeof(NodeBoundary);
  990:        sizes[4] = (int)sizeof(SideBoundary);
  991:        sizes[5] = (int)sizeof(BoundarySegment);
  992:    }
  993: }
  994: // END INCLUDE: meshdata.h
