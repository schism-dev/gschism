 2735: 
 2736: __device__ void computeBottomDragVegetation(void) {
 2737:    // UNFINISHED. CHECK THIS:
 2738:    // How many kernels are needed? Why so many for loops?
 2739:    // Is the loop on sides needed?
 2740: 
 2741:    Node *node = FROM kernel;
 2742: 
 2743:    const int    kb      = node->kb;
 2744:    const double htot    = node->htot();
 2745:    const double rough_p = node->rough_p;
 2746: 
 2747: 
 2748:    if (node->idry) {
 2749:       // Default values for dry nodes
 2750:       node->veg_alpha_vert_mean = veg_alpha0;
 2751:       /// XXX CHECK INDICES
 2752:       if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = veg_alpha0;
 2753:    }
 2754: 
 2755:    // Compute bottom drag Cd
 2756:    //--------------------------------
 2757: 
 2758:    // nchi = {-1, 0, 1} is the type of bottom drag.
 2759:    if (nchi==1) {
 2760: 
 2761:       bool ltmp = false; // for WBL iteration
 2762: 
 2763:       // Cdmax=-1 !max. Cd at node for this process (info only)
 2764:       // Drag at nodes
 2765: /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 2766: // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 2767:      
 2768:       const double rough = node->rough;
 2769:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough_p < 0");
 2770:       if (node->rough == 0.0) {
 2771:          node->Cd = 0.0;
 2772: 
 2773:       } else { //roughness >0 
 2774:          
 2775:          const double bthick_ori = node->znl[kb + 1] - node->znl[kb];  // thickness of bottom bnd layer
 2776:          const double bthick = max(dzb_min, bthick_ori);
 2777: 
 2778:          assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 2779: 
 2780:          double tmp = 1.0/(2.5*log(bthick/rough));
 2781:          node->Cd = tmp*tmp;
 2782: 
 2783:       } // if rough_p
 2784: 
 2785: 
 2786:       // RECOVER THIS: XXX
 2787:       // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 2788:       // Output warning for WBL if iteration didn't converge
 2789: 
 2790: 
 2791:    } // nchi==1
 2792: 
 2793:    //   Bottom stress in m^2/s^2
 2794:    if (node->rho[kb + 1] >= -98.d0)
 2795:    {
 2796:       const double mag_u = length(node->u2[kb + 1]);
 2797:       node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 2798:    }
 2799: 
 2800:  
 2801:    // Compute vegetation parameters
 2802:    //--------------------------------
 2803: 
 2804:    // SAV constants
 2805:    constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 2806:    constexpr double veg_cfpsi = 0.16;
 2807: 
 2808:    // Add vertical variation to veg_alpha and compute vertical mean etc.
 2809:    if constexpr(iveg == 1) { //  Vertical variation specified by functions
 2810: 
 2811:       // Compute the vegetation "density" \alpha = D*N*Cd/2
 2812:       // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 2813:       int kbin = 0; // bin index
 2814:       for (int k=node->kbp; k<nvrt; k++) {
 2815:          // Computes node height above the bottom level
 2816:          const double tmp_h = node->znl[k] - node->znl[node->kbp]; // >=0
 2817:          
 2818:          if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 2819:             cff1 = veg_vert_scale_cd[nbins_veg_vert];
 2820:             cff2 = veg_vert_scale_N [nbins_veg_vert];
 2821:             cff3 = veg_vert_scale_D [nbins_veg_vert];
 2822:          } else {
 2823:             // Find the bin at which the current vertical level is
 2824:             while (kbin<nbins_veg_vert) {
 2825:                const double zn = node->znl[kbin];
 2826:                if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 2827:                   break;
 2828:                } // if
 2829:                kbin++;
 2830:             } // while
 2831:             assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 2832: 
 2833:             // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 2834:             const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 2835:             
 2836:             // Linear interpolation of the vegetation parameters
 2837:             cff1 = veg_vert_scale_cd[kbin]*(1.d0-zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 2838:             cff2 = veg_vert_scale_N [kbin]*(1.d0-zrat) + veg_vert_scale_N [kbin+1]*zrat;
 2839:             cff3 = veg_vert_scale_D [kbin]*(1.d0-zrat) + veg_vert_scale_D [kbin+1]*zrat;
 2840:          } // if rl10
 2841: 
 2842:          veg_alpha3D(k,i) = veg_alpha0(i)*cff1*cff2*cff3
 2843: 
 2844:       } // for k
 2845: 
 2846: 
 2847:    } else { // Ganthy (iveg=2)
 2848:    //  Modify canopy height, diameter, and density
 2849: 
 2850:       // Make sure there is vegetation on this node
 2851:       if (node->veg_h_unbent > 0.0) {
 2852:          const double wtmp2 = length(node->dav)*100.0; // cm/s
 2853: 
 2854:          node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 2855:                                 0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784d0
 2856:          node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 2857: 
 2858:          const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 2859:          node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 2860:          const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 2861:          node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 2862:       } // if veg_h_unbent
 2863:       veg_alpha3D(:,i) = 0.5d0*veg_di(i)*veg_nv(i)*veg_cd(i)
 2864:    
 2865: 
 2866:    } // if iveg
 2867:   
 2868:       
 2869: 
 2870:    // Compute vertical mean of veg_alpha3D
 2871:    if (iveg != 0) {
 2872:       const double ztop = node->zTopCanopy(); // Top of the canopy
 2873:       double sum1=0.0;
 2874:       double sum2=0.0;
 2875:       // Integrate over each level under the canopy...
 2876:       for (int k=kb; k<nvrt-1 && node->znl[k+1] <= zztop; k++) { /// XXX CHECK INDICES
 2877:          const double Dz = node->Dz(k);
 2878: 
 2879:          sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 2880:          sum2 += Dz;
 2881: 
 2882:       } // for k
 2883: 
 2884:       if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 2885:       else             node->veg_alpha_vert_mean = sum1/sum2;
 2886: 
 2887:    } // if iveg
 2888: 
 2889: }
 2890: 
 2891: __device__ void computeVegetationAndDragParameters(void) {
 2892:    // Computes the vegetation and drag model parameters:
 2893:    // chi, \tilde\chi, beta, \breve{H}
 2894:    
 2895:    Side *side = FROM kernel;
 2896: 
 2897:    const double htot = side->htot();
 2898:    const double kb   = side->kb;
 2899: 
 2900:    assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 2901: 
 2902:    const double veg_h    = side->veg_h();
 2903:    const double veg_nv   = side->veg_nv();
 2904:    const double veg_c    = side->veg_c();
 2905:    const double veg_beta = side->veg_beta();
 2906: 
 2907:    // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 2908:    // Velocity magnitude at the bottom level
 2909:    // XXXX Check if we have add -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 2910:    const double vmag1 = length(side->u2[kb + 1]) BACKTRACKED VELOCITY
 2911:    side->chi2 = side->Cd*vmag1 
 2912:    side->chi  = side->chi2
 2913:    if constexpr(iveg != 0) {
 2914:       const Node *n1 = side->n1;
 2915:       const Node *n2 = side->n2;
 2916:       const double veg_alpha_bot = 0.5*(n1->veg_alpha3D(n1->kb) + n2->veg_alpha3D(n2->kb));
 2917:       side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt)
 2918:    }
 2919: 
 2920:    // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 2921: 
 2922:    // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 2923:    // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 2924:    double magUa = 0.0;
 2925:    if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 2926:       // 3D wet side with veg...
 2927: 
 2928:       for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 2929:          if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 2930: 
 2931:             // Velocity magnitude must be computed at the center of each level to perform the integration.
 2932:             // The tricky part is to compute that velocity at the level that may be partially submerged.
 2933:             const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 2934: 
 2935:             // Velocity magnitude at the top (h) of the level (may be partially submerged)
 2936:             const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 2937: 
 2938:             // Velocity magnitude at the bottom (l) of the level
 2939:             const double ul = length(side->u2[k]);
 2940: 
 2941:             const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 2942:             magUa += Dz*0.5*(uh + ul);
 2943: 
 2944:          } // if HasVegetation
 2945:       } // for k
 2946:       const double ua = magUa/min(htot, veg_h); // Vertical average
 2947: 
 2948:       // Computes beta, used for computing the stress term at the top of the canopy.
 2949:       const double veg_alpha = side->veg_alpha_vert_mean();
 2950:       side->veg_c2 = side->veg_alpha*dt*ua; // >=0
 2951:       if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 2952:          const double zCpy = side->zTopCanopy();
 2953:          const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 2954:          const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 2955:          const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I))
 2956:          const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 2957:          side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 2958:       } // if isSubmerged
 2959:    } // if iveg   
 2960: 
 2961:    // Computes the friction modified depth, \breve{H} in notes
 2962:    if (side->is2D()) { // 2D
 2963: 
 2964:       double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 2965:       if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 2966: 
 2967:       assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 2968: 
 2969:       side->hhat = htot*htot/fricH; 
 2970: 
 2971:    else { // 3D
 2972:       side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 2973: 
 2974:       if constexpr(iveg != 0) {
 2975:          
 2976:          if (side->isSubmerged()) { 
 2977:             const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 2978:             side->hhat -= veg_c*Hhat_alpha;
 2979: 
 2980:          } else { // Emergent
 2981:             side->hhat = side->hhat/(1.0 + veg_c2); // veg_c2 = alpha*|u|*dt
 2982:          }
 2983:       } // if iveg
 2984: 
 2985:       // Enforce positivity for 3D model
 2986:       if (ihhat == 1) side->hhat = max(0.0, side->hhat)
 2987:    } // if 3D
 2988: 
 2989:      
 2990: }
 2991: 
 2992: 
 2993: 
 2994: __device__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 *vec, double *diffRho) {
 2995: // Computes the density gradient between two elements, e1 and e2.
 2996: // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 2997: // zero in the direction normal to the side. 
 2998: // 
 2999: // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 3000: // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 3001: //
 3002: // Input:
 3003: //    e1: Element
 3004: //    e2: Neighbor element (or nullptr if boundary)
 3005: //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 3006: //    k: Index of the half-level at which the density is interpolated
 3007: //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 3008: // 
 3009: // Output:
 3010: //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 3011: //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 3012: 
 3013:    if (e2 == nullptr || e2->idry) {
 3014:       // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 3015: 
 3016:       Side *side = e1->sides[j];
 3017:       assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->idry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 3018:               
 3019:       if constexpr(ics==1) {
 3020:          vec = side->n(); // Normal vector to the side
 3021:       } else {
 3022:          // IMPLEMENT THIS XXXXXX
 3023:          // !replace with xel, yel?
 3024:          //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 3025:          //      &eframe(:,:,i),xn1,yn1,tmp)
 3026:          //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 3027:          //      &eframe(:,:,i),xn2,yn2,tmp)
 3028:       } //ics
 3029:                 
 3030:       diffRho = 0.0;
 3031: 
 3032:    } else { //internal and wet
 3033:       if constexpr(ics==1) {
 3034:          assert(e2 != nullptr || e2->idry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 3035: 
 3036:          // Vector from e1 to e2
 3037:          vec = toVector2(e2->center - e1->center);
 3038: 
 3039:       } else { 
 3040:          // IMPLEMENT THIS XXXXXX
 3041:          //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 3042:          //      &eframe(:,:,i),xctr2,yctr2,tmp)
 3043:          //                   alow(j)=xctr2
 3044:          //                   bdia(j)=yctr2
 3045:       } // ics
 3046: 
 3047:       diffRho = rho2 - e1->demeanedDensity(k);
 3048:    }
 3049: 
 3050: }
 3051: 
 3052: __device__ void computeDensityCubicSplines(void) {
 3053:    // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 3054: 
 3055:    if (elem->idry) return;
 3056: 
 3057:    const int kb = elem->kb;
 3058: 
 3059:    // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 3060:    if (elem->is2D()) {
 3061:       // In the 2D case, the density is constant at the prism level. 
 3062:       // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 3063:       elem->rho_z[nvrt-1] = elem->rho[nvrt-1] - elem->rho_mean[nvrt-1]
 3064:    } else { //3D
 3065: 
 3066:       // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 3067:       auto getX = [zp             ] __forceinline__ (int k) { return elem->z_prism(k); };
 3068:       auto getY = [elem,k,rho_mean] __forceinline__ (int k) { return elem->rho[k] - elem->rho_mean[k]; };
 3069:       ///// XXXX CHECK INDICES!!!!!
 3070:       initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_zz, elem->rho_z);
 3071:    } // 2D/3D
 3072: 
 3073: }
 3074: 
 3075: __device__ double interpolateDensityAtHalfLevel(Element *elem, Element *elem2, int k, double &rho) {
 3076: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 3077: 
 3078:    if (elem2 == nullptr || elem2->idry) return 0.0;
 3079: 
 3080:    const int kb  = elem->kb;
 3081:    const int kb2 = elem2->kb;
 3082: 
 3083:    // z-coordinate of prism of elem
 3084:    const double zp = elem->z_prism(k);
 3085: 
 3086:    if (elem2->is2D()) {
 3087:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 3088: 
 3089:    } else {  // 3D
 3090: 
 3091:       // eta_min may be < zmax
 3092:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1])
 3093:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]) ;
 3094: 
 3095:       // (Extrapolate density below bottom, we will fix it later)
 3096:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 3097:       rho = evalCubicSpline(zp, elem->rho_z, elem->rho_zz, elem->demeanedDensity(k), extrapolate = true);
 3098:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 3099:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 3100:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 3101:    } // 2D/3D
 3102:      
 3103: 
 3104:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 3105:    // Now we need to fix it.
 3106:    if (elem->z[k] < elem2->z[kb2]) {
 3107:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 3108: 
 3109:       // There are two methods to adjust the density at the bottom of the element.
 3110:       // iunder_deep=0: 
 3111:       const double depth1 = abs(elem->z[kb]); // larger depth
 3112: 
 3113:       if (iunder_deep==0) {
 3114: 
 3115:          const double weight = max(0.0, min(1.0, (depth1 - elem->h1_bcc)/(elem->h2_bcc - elem->h1_bcc))); // weight
 3116: 
 3117:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k)
 3118: 
 3119:       } else { // iunder_deep != 0
 3120: 
 3121:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]) // Change??? XXX Was like this in the original code
 3122: 
 3123:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 3124: 
 3125:          //   Demeaned density at the same z coordinate as
 3126:                rho = elem->demeanedDensity(k) // would make cupp() below=0
 3127:             }
 3128:          } // if tmp0>=
 3129:       } // if iunder_deep
 3130:    } // if elem->z[kb] < elem2->z[kb]
 3131: }
 3132: 
 3133: __device__ void computeDensityGradient(void) {
 3134: 
 3135:    // Compute the horizontal density gradient at each element.
 3136:    // It works in two steps:
 3137:    // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 3138:    // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 3139:    //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 3140:    //             gradRho.r1 = rho1 - rho0
 3141:    //             gradRho.r2 = rho2 - rho0
 3142:    //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 3143:    // 
 3144:    //  NOTE: We use de-meaned densities.
 3145: 
 3146:    Element *elem = FROM kernel;
 3147: 
 3148:    if (elem->idry) return;
 3149: 
 3150:    const int kb  = elem->kb;
 3151:    const int i34 = elem->i34;
 3152: 
 3153:    for (int k = kb + 1; k < nvrt; k++) {
 3154:       // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 3155:       //             gradRho.r1 = rho1 - rho0
 3156:       //             gradRho.r2 = rho2 - rho0
 3157:       icount=0
 3158:       double sumRx = 0.0;
 3159:       double sumRy = 0.0;
 3160:       for (int j1=0; j1<i34; j1++) { 
 3161: 
 3162:          const int j2 = elem->nxq(j1 + 1);
 3163: 
 3164:          // Pairs of consecutive neighbor elements of elem
 3165:          const Element *e1 = elem->elements[j1];
 3166:          const Element *e2 = elem->elements[j2];
 3167: 
 3168:          // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 3169:          const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 3170:          const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 3171: 
 3172:          // Compute the density difference and the vector from elem to e1 and e2
 3173:          // getRhoDiffAndVec takes into account boundaries/dry elements
 3174:          double diffRho1, diffRho2;
 3175:          Vector2 vec1, vec2;
 3176:          getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 3177:          getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 3178: 
 3179:          const double rl1 = length(vec1);
 3180:          const double rl2 = length(vec2);
 3181:          assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 3182: 
 3183:          const double delta = cross(vec1, vec2);
 3184:          const double sintheta = abs(delta)/(rl1*rl2);
 3185: 
 3186:          // To avoid problems, avoid elements with small angle between vectors
 3187:          constexpr double sin_one_deg = sin(pi/180.0); // use 1 degree as threshold for well-conditioned system
 3188:          const bool validEq = (sintheta > sin_one_deg);
 3189: 
 3190:          if (validEq) {
 3191:             // Solve the system of equations to get the density gradient at elem
 3192:             icount++;
 3193:             const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 3194:             const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 3195:             sumRx += Rx;
 3196:             sumRy += Ry;
 3197:          }
 3198:       } // for j1
 3199: 
 3200:       // Compute the average density gradient at elem
 3201:       if (icount==0) {
 3202:         // Bad mesh quality; bail out with 0 b-cc
 3203:         elem->gradRho[k] = {0.0, 0.0};
 3204:       } else {
 3205:         elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 3206:       }
 3207: 
 3208:    } // for k
 3209: 
 3210: }
 3211: 
 3212: __device__ void computeBaroclinicTerm(double rampbc) {
 3213: // Computes the baroclinic term at sides (at half levels).
 3214: // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 3215: // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 3216: 
 3217:    Side *side = FROM kernel;
 3218: 
 3219:    if (side->idry == 1) return;
 3220: 
 3221:    const Element *e1 = side->elements[0];
 3222:    const Element *e2 = side->elements[1];      
 3223:    const int kb = side->kb;
 3224:    
 3225:    assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 3226: 
 3227:    // interpolates vertically the density gradient of the two elements at the half level/
 3228: 
 3229:    // Starts the integration at the surface and goes down to the bottom
 3230:    int k1 = nvrt - 1;
 3231:    int k2 = nvrt - 1;
 3232: 
 3233:    side->bcc[nvrt-1] = {0.0, 0.0};
 3234:    for (int k = nvrt-1; k >= side->kbs; k--) {
 3235:    // For each prism level (from surface to bottom)...
 3236: 
 3237:       // For both elements, interpolate density gradient at the side's half level.
 3238:       // The gradient at the side is the average of the gradients at the elements.
 3239:       // w1, w2 are used to take into account boundary sides, with just one element.
 3240:       double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 3241:       double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 3242:       w1 = w1/(w1 + w2);
 3243:       w2 = w2/(w1 + w2);
 3244: 
 3245:       assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 3246: 
 3247:       // Linear interpolation of both elements' density gradient at the shared side's level.
 3248:       Vector2 gradRho = {0.0, 0.0};
 3249:       if (e1 != nullptr && k > kb) {
 3250:          // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 3251:          k1 = e1->findLevel(side->z[k], k1); // finds the index at the half level starting the search at k1
 3252:          const double zrat = (side->z[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 3253:          
 3254:          gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 3255:       }      
 3256:       if (e2 != nullptr && k > kb) {
 3257:          k2 = e2->findLevel(side->z[k], k2); // finds the index at the half level starting the search at k2
 3258:          const double zrat = (side->z[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 3259:          
 3260:          gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 3261:       }
 3262: 
 3263:       if constexpr(ics==2) {
 3264:          // IMPLEMENT THIS XXXXXX
 3265:          // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 3266:          // swild(1)=tmp1
 3267:          // swild(2)=tmp2
 3268:       }
 3269:       
 3270:       // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 3271:       // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 3272:       // CHECK INDICES!!! XXX
 3273:       const double grav3 = 0.5*(side->n1->grav2 + side->n2->grav2);
 3274:       side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 3275:    } // for
 3276: 
 3277: }
 3278: 
 3279: #ifdef DONTCOMPILE
 3280: __device__ void computeVerticalAdvection(void) {
 3281:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 3282: 
 3283:    sdbt(1:2,:,:)=0.d0
 3284: 
 3285:    const Side *side = FROM kernel;
 3286: 
 3287:    if(side->idry) return;
 3288: 
 3289:    // If side is wet...
 3290: 
 3291: 
 3292:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 3293:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 3294:    double ws[nvrt] = {} // w @ side
 3295:    int icount = 0;
 3296:    for (int j=0; j<2; j++) {
 3297:       const Element *elem = side->elements[j];
 3298:        
 3299:       if(elem != nullptr) {
 3300:          icount++;
 3301:          for (int k=0; k<nvrt; k++) {
 3302:             ws[k] = ws[k] + elem->w[k];
 3303:          }
 3304:       }
 3305:    }  // for j
 3306: 
 3307:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 3308:    ws = ws/icount;
 3309: 
 3310:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 3311:    // Splines allow for a smooth transition between vertical levels.
 3312:    // Splines have continuity restrictions at the internal knots, but
 3313:    // we have to provide the 1st derivatives at the endpoints.
 3314:    const int kbs = side->kbs; 
 3315:    
 3316:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3317:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3318:    initCubicSpline(kbs, nvrt, side, ws, up)
 3319: 
 3320:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3321:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3322:    initCubicSpline(kbs, nvrt, side, ws, vp)
 3323: 
 3324:    // Total advection (average onto side)
 3325:    const Node *node1 = side->nodes[0];
 3326:    const Node *node2 = side->nodes[1];
 3327:    for (int k=kbs(i); k<nvrt; k++) {
 3328: 
 3329:       if constexpr(ics==1) {
 3330:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 3331:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 3332:       } else {
 3333:          // XXX IMPLEMENT THIS
 3334:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 3335:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 3336:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 3337:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 3338:       }  // if ics
 3339: 
 3340: 
 3341:    }
 3342: }
 3343: #endif
 3344: 
 3345: __device__ void computeElemAverageGhat(void) {
 3346: // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 3347: 
 3348:    Element *elem = FROM kernel;
 3349:    
 3350:    elem->ghat1= {0.0, 0.0};  
 3351: 
 3352:    if constexpr(ihydraulics != 0) {
 3353:       if (nhtblocks > 0 && (elem->isblock > 0)) return;
 3354:    }
 3355: 
 3356:    if (elem->idry == 1) return;
 3357: 
 3358:    // Wet elements.
 3359:    // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 3360:    // tidal potential, horizontal diffusion, and baroclinic etc
 3361:    // Remember to update both fb and F 
 3362:    // If ics=2, ghat1 are in eframe (ll)
 3363:    // cff1-3: coefficients for 2D/3D
 3364:    Vector2 gradEta = {0.0, 0.0};  // \nabla \eta
 3365:    Vector2 gradPr  = {0.0, 0.0};  // \nabla pressure
 3366:    Vector2 gradEtp = {0.0, 0.0};  // \nabla etp
 3367: 
 3368:    double av_cff1 = 0.0;  // av. for cff1
 3369:    double av_cff2 = 0.0;  // av. for cff2
 3370:    double av_cff3 = 0.0;  // av. for cff3
 3371:    double av_df = 0.0;  // av. for H^\alpha / H
 3372:    double av_cff2_chi = 0.0;  // av. for cff2*chi
 3373:    double av_cff3_chi = 0.0;  // av. for cff3*chi
 3374: 
 3375:    const int i34 = elem->i34;
 3376: 
 3377:    for (int j=1; j<i34; j++) {
 3378:       // For each node and side in the element...
 3379: 
 3380:       const Node *node = elem->nodes[j];
 3381:       const Side *side = elem->sides[j];
 3382: 
 3383:       const double chi      = side->chi;
 3384:       const double veg_c2   = side->veg_c2;
 3385:       const double veg_beta = side->veg_beta;
 3386:       const double veg_h    = side->veg_h();
 3387:       const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 3388: 
 3389:       // Node - const in elem
 3390:       gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 3391:       gradPr  += node->pr  *elem->gradPhi[j];
 3392: 
 3393:       if (elem->depth >= tip_dp) {
 3394:         gradEtp += node->etp*elem->gradPhi[j];
 3395:       }
 3396: 
 3397:       
 3398:       const double htot  = side->htot();        // Total depth at the side
 3399:       const double zctr2 = side->zTopCanopy();  
 3400: 
 3401:       double cff1; 
 3402:       double cff2; 
 3403:       double cff3;   
 3404:       if (side->is2D()) {  // XXX Check indices, it used to have a +1
 3405:       // coefficients applied to 2D/3D case 
 3406:          cff1 = side->hhat/htot;
 3407:          cff2 = 0.0;
 3408:          cff3 = 0.0;
 3409:       } else { //3D
 3410:          //Init for no-veg case
 3411:          cff1 = 1.0;
 3412:          cff2 = 1.0;
 3413:          cff3 = 0.0;
 3414: 
 3415:          if constexpr(iveg != 0) {
 3416:             // Computes coefficients used with vegetation terms G1, G2
 3417:             // cff1, cff3 are used for the first two terms in G1, G2:
 3418:             // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 3419:             // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 3420:             // In general, cff1*Ustar - cff3*Ustar_alpha
 3421:             if(veg_h < 0.99*htot) { // submergent vegetation
 3422:                cff1=1;
 3423:                cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 3424:                cff3 = veg_c;
 3425: 
 3426:             } else { // emergent vegetation
 3427:                cff1 = 1.0/(1.0 + veg_c2);
 3428:                cff2 = cff1;
 3429:                cff3 = 0.0;
 3430: 
 3431:             }
 3432:          } // if iveg
 3433:       } //  2D/3D
 3434: 
 3435:       av_cff1 += cff1/i34;
 3436:       av_cff2 += cff2/i34;
 3437:       av_cff3 += cff3/i34;
 3438:       av_cff2_chi += cff2*chi/i34;
 3439:       av_cff3_chi += cff3*chi/i34;
 3440:       av_df += min(htot, veg_h)/(htot*i34);
 3441: 
 3442: 
 3443:       // btrack values: U^\star, U^{\star\alpha}
 3444:       // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 3445:       Vector2 Ustar       = {0.0, 0.0}; 
 3446:       Vector2 Ustar_alpha = {0.0, 0.0}; 
 3447:       for (int k = side->kb; k < nvrt; k++) {
 3448:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 3449:             Ustar += side->bt[nvrt]*side->Dz(k);
 3450: 
 3451:          } else { //3D
 3452:             Vector2 w2 = (side->bt[k] + side->bt[k-1])/2.0*side->Dz(k);
 3453:             Ustar += w2;
 3454: 
 3455:             if constexpr(iveg != 0) {
 3456:                 if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 3457:                     const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k)); // For the top of the canopy, ratio of the level that is below the canopy
 3458:                     Ustar_alpha += zrat*w2; // XXXX
 3459:                 }
 3460:             }  // if iveg
 3461:          }  //2/3D
 3462:       }  //k
 3463:       
 3464: 
 3465:       // Add btrack & surface stress terms to \breve{G} first
 3466:       if constexpr(ics==1) {
 3467:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 3468:       } else {
 3469:          // XXX IMPLEMENT THIS
 3470:          // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 3471:          // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 3472:          // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 3473:       }  // if ics
 3474: 
 3475:       // Surface and bottom stress terms
 3476:       if constexpr(ics==1) {
 3477:          const Vector2 tau    = side->tau();
 3478:          const Vector2 ubstar = side->sdbt[side->kb+1]; // XXX CHECK INDICES
 3479:       } else {
 3480:          // XXX IMPLEMENT THIS
 3481:          // n1=isidenode(1,isd); n2=isidenode(2,isd)
 3482:          // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 3483:          // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 3484:          // tau_x=(vn1+tt1)/2.d0
 3485:          // tau_y=(vn2+ss1)/2.d0
 3486:          // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 3487:       }  // if ics
 3488: 
 3489:       // Term for surface and bottom stress
 3490:       elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 3491: 
 3492:       // All terms in F,F^\alpha,f_b except baroclinic
 3493:       // F, f_b: all explicit terms excluding vegetation 
 3494:       // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 3495:       // Only need to calculate F^\alpha for 3D sides (but init=0) 
 3496:       const double coriolis = side->cori;
 3497:       const Vector2 F  =  coriolis*side->U;  // F_x
 3498:       const Vector2 fb =  coriolis*side->u2;  // f_b_x
 3499:       Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 3500: 
 3501:       if (iveg != 0 && nvrt > side->kb) {  // 3D
 3502:          
 3503:          for (int k = side->kb; k < nvrt; k++) {
 3504:             if (zctr2 > side->z[k-1]) {
 3505:                 const Vector2 w2 = side->Dz[k]*(side->u2[k] + side->u2[k-1])/2.0;
 3506:                 const double zrat = min(1.0, (zctr2 - side->z[k-1])/side->Dz[k]);
 3507:                 Fa +=  coriolis*w2*zrat;
 3508:             } // if zctr2
 3509:          } // k
 3510:       } // iveg
 3511: 
 3512:       // Integrate horizontal viscosity vertically
 3513:       for (int k=side->kb; k<nvrt; k++) {
 3514:          const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.d0 // (d2uv(1,k,isd)+d2uv(1,k-1,isd))/2
 3515: 
 3516:          F += w2;
 3517: 
 3518:          // Vegetation term
 3519:          if constexpr(iveg!=0) {
 3520:             if (nvrt > side->kbs + 1 && zctr2 > side->z[k-1]) { // 3D
 3521:                const double zrat = min(1.0, (zctr2 - side->z[k-1])/side->Dz(k));
 3522:                Fa += w2*zrat;
 3523:             } 
 3524:          } // if iveg
 3525:       } // for k
 3526: 
 3527:       fb += side->d2uv[side->kb];
 3528: 
 3529: 
 3530:       // Add to ghat1
 3531:       if constexpr(ics==2) {
 3532:          // XXX IMPLEMENT THIS
 3533:          // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 3534:          // bigf1=vn1; bigf2=vn2
 3535:          // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 3536:          // botf1=vn1; botf2=vn2
 3537:          // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 3538:          // bigfa1=vn1; bigfa2=vn2
 3539:       } // if ics
 3540: 
 3541:       elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 3542:    } // for j (nodes and sides)
 3543: 
 3544:    elem->ghat1 = (1.0/i34)*elem->ghat1;
 3545:       
 3546:    // Finish off terms in F, F^\alpha and f_b
 3547:    const double grav3 = elem->mean(Element::grav2)
 3548:    const Vector2 fb = grav3*gradP - gradPr/rho0 //const in each elem
 3549: 
 3550: 
 3551:    Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 3552:    for (int j=1; j<i34; j++) { 
 3553:       // For each side in the element...
 3554:       const Side *side = elem->sides[j];
 3555: 
 3556:       const double htot = side->htot();
 3557:       const double F  = htot*fb;
 3558:       const double Fa = min(htot, veg_h)*fb;
 3559: 
 3560:       tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 3561:    } // for j
 3562: 
 3563:    //botf1 etc are already in elem frame
 3564:    elem->ghat1 += tmp/i34;
 3565: 
 3566:    // Baroclinic force
 3567:    if constexpr(ibc==0) {
 3568:       assert(elem->nodes[0]->rho >= -98.d0 && elem->nodes[1]->rho >= -98.d0 && elem->nodes[2]->rho >= -98.d0 && "computeElemAverageGhat1: Impossible dry");
 3569: 
 3570:       Vector2 Fa = {0.0, 0.0};
 3571:       Vector2 intGradRho = {0.0, 0.0};
 3572:       
 3573:       // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 3574:       for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 3575:          intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 3576: 
 3577:          // \in F [m^2/s/s]
 3578:          Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 3579:       }
 3580: 
 3581:       const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 3582:       const Vector2 F = av_df*Fa; //approx
 3583:       elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 3584: 
 3585:    } // if ibc
 3586: 
 3587: }
 3588: 
 3589: 
 3590: 
 3591: #ifdef DONTCOMPILE
 3592: __global__ void checkMassConservation(Tracers* sumtr) {
 3593: 
 3594:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 3595: 
 3596:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 3597: 
 3598:    Element *elem = &(mesh->localElemData[i]);
 3599: 
 3600:    // Skip dry elements
 3601:    if (elem->idry) return;
 3602: 
 3603:    // Local sum array for this thread
 3604:    double localSum[N_TRACERS] = {0.0};
 3605: 
 3606:    // Sum over vertical levels for this element
 3607:    const int kbe = elem->kbe;
 3608:    const double area = elem->area;
 3609: 
 3610:    for (int k = kbe; k < nvrt; k++) {
 3611:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 3612:       
 3613:       // Accumulate tracer mass
 3614:       for (int tr = 0; tr < N_TRACERS; tr++) {
 3615:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 3616:       }
 3617:    }
 3618: 
 3619:    
 3620: 
 3621:    //  This function returns per element sums. A reduction must be done on the host side.
 3622: }
 3623: 
 3624: 
 3625: __global__ void transport(void) {
 3626: 
 3627:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 3628: 
 3629:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 3630: 
 3631:    Element *elem = &(mesh->localElemData[ie]);
 3632: 
 3633:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 3634: 
 3635:                for (int m=0; m<ntr; m++) {
 3636:                   for (int k=kbe(ie); k<nvrt; k++) {
 3637:                      // Calculate each polynomial's weight 
 3638:                      wm=0.d0; sum1=0.d0; 
 3639:                      wm1=0.d0; wm2=0.d0; 
 3640:                      for (int i=0; i<elem->nweno2; i++) {
 3641:                   
 3642:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3643:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3644:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3645:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3646:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3647:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 3648:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 3649:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 3650:                      // -----------------Hu and Shu (1999)'s method----------------
 3651:                      b4=b1+b2+b3
 3652: 
 3653: //Error: add PRODUCTION CPP
 3654: #ifdef DEBUG
 3655:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 3656:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 3657:                     call parallel_abort(errmsg)
 3658:                   }
 3659: #endif
 3660: 
 3661:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 3662:                   // !----test-------------- 
 3663:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 3664:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 3665:                   // !wm(i)=wm1(i)*wm2(i)
 3666:                   // !---------------------- 
 3667:                   sum1=sum1+wm(i)
 3668:                 } // end for i
 3669: 
 3670:                 wm=wm/sum1
 3671: 
 3672:                 for (int j=0; j<elem->i34; j++) {
 3673: 
 3674:                   const Side *side  = elem->sides[j];
 3675:                   const Node *node1 = side->n1;
 3676:                   const Node *node2 = side->n2;
 3677: 
 3678:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 3679:                      trsd=0.d0
 3680:                      for (int kk=0; kk<nquad; kk++) {
 3681:                         for (int i=0; i<elem->nweno2; i++) {
 3682:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3683:                         } // end for i   
 3684:                      } // end for kk
 3685:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 3686:                   } // outward flux
 3687:                } // end for j=1,i34(ie) ! side
 3688:             }
 3689:          }
 3690:               
 3691: 
 3692: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 3693: //             //   calculate each polynomial's weight 
 3694: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 3695: //                 wm=0.d0; sum1=0.d0
 3696: //                 do i=1,nweno1(ie) !for each polynomial
 3697: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 3698: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 3699: //                   b1=b1*b1+b2*b2 !smoothness indicator
 3700: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 3701: //                   wm(i)=b2
 3702: //                   sum1=sum1+b2
 3703: //                   !wm(i)=1.d0
 3704: //                   !sum1=sum1+1.d0
 3705: 
 3706: // // Error: PRODUCTION
 3707: // #ifdef DEBUG
 3708: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 3709: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 3710: //                     call parallel_abort(errmsg)
 3711: //                   endif
 3712: // #endif
 3713: 
 3714: //                 enddo !i
 3715: //                 wm=wm/sum1 !final weight
 3716: 
 3717:                 for (int j=0; j<elem->i34; j++) { // side
 3718:                   const Side *side = elem->sides[j];
 3719:                   const Node *node1 = side->n1;
 3720:                   const Node *node2 = side->n2;
 3721: 
 3722:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 3723:                     trsd=0.d0
 3724:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 3725:                       for (int i=0; i<elem->nweno1; i++) {
 3726:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 3727:                       }
 3728:                     enddo //kk
 3729:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 3730:                   } // outward flux
 3731:                 } // end for j=1,i34(ie) ! side
 3732:               } // end for k; ntr 
 3733: 
 3734:             else !simple upwind method
 3735:               do j=1,i34(ie)
 3736:                 jsj=elside(j,ie)
 3737:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 3738:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 3739:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 3740:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 3741:                   endif
 3742:                 enddo  !vertical layers
 3743:               enddo !j=1,i34(ie) ! side
 3744:             endif !order of accuracy
 3745: 
 3746:          //  enddo !ie
 3747: // !$OMP     end do
 3748: 
 3749: // !$OMP     master
 3750: //           !message passing
 3751: //           if (nproc>1) then
 3752: //             !make a copy of side concentrations
 3753: //             trsd_tmp0=trsd_tmp 
 3754: 
 3755: //             !this exchange routine swaps interface concentration between two partitions
 3756: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 3757: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 3758: 
 3759: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 3760: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 3761: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 3762: 
 3763: 
 3764: //             !This obtains final values for interface sides
 3765: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 3766: //       :    endif !nproc>1
