 4176: #ifdef DONTCOMPILE
 4177: __global__ void checkMassConservation(Tracers* sumtr) {
 4178: 
 4179:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 4180: 
 4181:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 4182: 
 4183:    Element *elem = &(mesh->localElemData[i]);
 4184: 
 4185:    // Skip dry elements
 4186:    if (elem->isDry) return;
 4187: 
 4188:    // Local sum array for this thread
 4189:    double localSum[N_TRACERS] = {0.0};
 4190: 
 4191:    // Sum over vertical levels for this element
 4192:    const int kbe = elem->kbe;
 4193:    const double area = elem->area;
 4194: 
 4195:    for (int k = kbe; k < nvrt; k++) {
 4196:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 4197:       
 4198:       // Accumulate tracer mass
 4199:       for (int tr = 0; tr < N_TRACERS; tr++) {
 4200:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 4201:       }
 4202:    }
 4203: 
 4204:    
 4205: 
 4206:    //  This function returns per element sums. A reduction must be done on the host side.
 4207: }
 4208: 
 4209: 
 4210: __global__ void transport(void) {
 4211: 
 4212:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 4213: 
 4214:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 4215: 
 4216:    Element *elem = &(mesh->localElemData[ie]);
 4217: 
 4218:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 4219: 
 4220:                for (int m=0; m<ntr; m++) {
 4221:                   for (int k=kbe(ie); k<nvrt; k++) {
 4222:                      // Calculate each polynomial's weight 
 4223:                      wm=0.d0; sum1=0.d0; 
 4224:                      wm1=0.d0; wm2=0.d0; 
 4225:                      for (int i=0; i<elem->nweno2; i++) {
 4226:                   
 4227:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4228:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4229:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4230:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4231:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4232:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 4233:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 4234:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 4235:                      // -----------------Hu and Shu (1999)'s method----------------
 4236:                      b4=b1+b2+b3
 4237: 
 4238: //Error: add PRODUCTION CPP
 4239: #ifdef DEBUG
 4240:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 4241:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 4242:                     call parallel_abort(errmsg)
 4243:                   }
 4244: #endif
 4245: 
 4246:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 4247:                   // !----test-------------- 
 4248:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 4249:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 4250:                   // !wm(i)=wm1(i)*wm2(i)
 4251:                   // !---------------------- 
 4252:                   sum1=sum1+wm(i)
 4253:                 } // end for i
 4254: 
 4255:                 wm=wm/sum1
 4256: 
 4257:                 for (int j=0; j<elem->i34; j++) {
 4258: 
 4259:                   const Side *side  = elem->sides[j];
 4260:                   const Node *node1 = side->n1;
 4261:                   const Node *node2 = side->n2;
 4262: 
 4263:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 4264:                      trsd=0.d0
 4265:                      for (int kk=0; kk<nquad; kk++) {
 4266:                         for (int i=0; i<elem->nweno2; i++) {
 4267:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4268:                         } // end for i   
 4269:                      } // end for kk
 4270:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 4271:                   } // outward flux
 4272:                } // end for j=1,i34(ie) ! side
 4273:             }
 4274:          }
 4275:               
 4276: 
 4277: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 4278: //             //   calculate each polynomial's weight 
 4279: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 4280: //                 wm=0.d0; sum1=0.d0
 4281: //                 do i=1,nweno1(ie) !for each polynomial
 4282: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4283: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4284: //                   b1=b1*b1+b2*b2 !smoothness indicator
 4285: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 4286: //                   wm(i)=b2
 4287: //                   sum1=sum1+b2
 4288: //                   !wm(i)=1.d0
 4289: //                   !sum1=sum1+1.d0
 4290: 
 4291: // // Error: PRODUCTION
 4292: // #ifdef DEBUG
