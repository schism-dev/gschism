 3183: 
 3184:    __global__ void scaleGravity(double loadtide_coef) {
 3185: 
 3186: 
 3187:       NODE(node);
 3188: 
 3189:       // SAL option: scale gravity
 3190:       if constexpr(iloadtide==2) {  // simple const
 3191:          node->grav2 = grav*(1.0 - loadtide_coef);
 3192: 
 3193:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3194:         
 3195:           const double depth = max(node->depth, 0.0);
 3196:           const double tmp1 = sqrt(depth);
 3197:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3198:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3199:                              2.6969e-13*depth*depth*depth*tmp1;
 3200:           
 3201:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3202:           
 3203: 
 3204: 
 3205:           node->grav2 = grav*(1.0 - beta_bar);
 3206: 
 3207:       } else {  // iloadtide=0,1
 3208:         node->grav2=grav;
 3209: 
 3210:       }
 3211: 
 3212:       printf("scaleGravity: node(%d)->grav2 = %f\n", node->idx, node->grav2);
 3213:    }
