 3538:    __global__ void computeBottomDragVegetation(void) {
 3539:       // UNFINISHED. CHECK THIS:
 3540:       // How many kernels are needed? Why so many for loops?
 3541:       // Is the loop on sides needed?
 3542: 
 3543:       NODE(node);
 3544: 
 3545:       const int    kb      = node->kb;
 3546:       const double htot    = node->htot();
 3547:       const double rough   = node->rough;
 3548: 
 3549: 
 3550:       if (node->isDry) {
 3551:          // Default values for dry nodes
 3552:          node->veg_alpha_vert_mean = node->veg_alpha0;
 3553:          /// XXX CHECK INDICES
 3554:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 3555:       }
 3556: 
 3557:       // Compute bottom drag Cd
 3558:       //--------------------------------
 3559: 
 3560:       // nchi = {-1, 0, 1} is the type of bottom drag.
 3561:       if (nchi==1) {
 3562: 
 3563:          bool ltmp = false; // for WBL iteration
 3564: 
 3565:          // Cdmax=-1 !max. Cd at node for this process (info only)
 3566:          // Drag at nodes
 3567:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 3568:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 3569:         
 3570:          const double rough = node->rough;
 3571:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3572:          if (node->rough == 0.0) {
 3573:             node->Cd = 0.0;
 3574: 
 3575:          } else { //roughness >0 
 3576:             
 3577:             const double bthick_ori = node->znl[kb + 1] - node->znl[kb];  // thickness of bottom bnd layer
 3578:             const double bthick = max(dzb_min, bthick_ori);
 3579: 
 3580:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 3581: 
 3582:             double tmp = 1.0/(2.5*log(bthick/rough));
 3583:             node->Cd = tmp*tmp;
 3584: 
 3585:          } // if rough
 3586: 
 3587: 
 3588:          // RECOVER THIS: XXX
 3589:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 3590:          // Output warning for WBL if iteration didn't converge
 3591: 
 3592: 
 3593:       } // nchi==1
 3594: 
 3595:       //   Bottom stress in m^2/s^2
 3596:       if (node->rho[kb + 1] >= -98.0)
 3597:       {
 3598:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 3599:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 3600:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 3601:          // !sediment erosion: this part needs more documentation
 3602:       }
 3603: 
 3604:     
 3605:       // Compute vegetation parameters
 3606:       //--------------------------------
 3607: 
 3608:       // SAV constants
 3609:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 3610:       constexpr double veg_cfpsi = 0.16;
 3611: 
 3612:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 3613:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 3614: 
 3615:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 3616:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 3617:          int kbin = 0; // bin index
 3618:          for (int k = kb; k < nvrt; k++) {
 3619:             // Computes node height above the bottom level
 3620:             const double tmp_h = node->znl[k] - node->znl[kb]; // >=0
 3621:             assert(false && "Vertical variation of vegetation not implemented");
 3622: 
 3623:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 3624:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 3625:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 3626:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 3627:             // } else {
 3628:             //    // Find the bin at which the current vertical level is
 3629:             //    while (kbin<nbins_veg_vert) {
 3630:             //       const double zn = node->znl[kbin];
 3631:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 3632:             //          break;
 3633:             //       } // if
 3634:             //       kbin++;
 3635:             //    } // while
 3636:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 3637: 
 3638:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 3639:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 3640:                
 3641:             //    // Linear interpolation of the vegetation parameters
 3642:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 3643:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 3644:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 3645:             // } // if rl10
 3646: 
 3647:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 3648: 
 3649:          } // for k
 3650: 
 3651: 
 3652:       } else { // Ganthy (iveg=2)
 3653:       //  Modify canopy height, diameter, and density
 3654: 
 3655:          // Make sure there is vegetation on this node
 3656:          if (node->veg_h_unbent > 0.0) {
 3657:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 3658: 
 3659:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 3660:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 3661:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 3662: 
 3663:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 3664:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 3665:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 3666:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 3667:          } // if veg_h_unbent
 3668: 
 3669:          for (int k = 0; k < nvrt; k++) {
 3670:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 3671:          } // for k
 3672:       
 3673: 
 3674:       } // if iveg
 3675:      
 3676:          
 3677: 
 3678:       // Compute vertical mean of veg_alpha3D
 3679:       if (iveg != 0) {
 3680:          const double ztop = node->zTopCanopy(); // Top of the canopy
 3681:          double sum1=0.0;
 3682:          double sum2=0.0;
 3683:          // Integrate over each level under the canopy...
 3684:          for (int k=kb; k<nvrt-1 && node->znl[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 3685:             const double Dz = node->Dz(k);
 3686: 
 3687:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 3688:             sum2 += Dz;
 3689: 
 3690:          } // for k
 3691: 
 3692:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 3693:          else             node->veg_alpha_vert_mean = sum1/sum2;
 3694: 
 3695:       } // if iveg
 3696: 
 3697:       printf("computeBottomDragVegetation: nodeIdx = %d, node->veg_alpha_vert_mean = %f\n", node->idx, node->veg_alpha_vert_mean);
 3698: 
 3699:    }
 3700: 
 3701:    __global__ void computeVegetationAndDragParameters(void) {
 3702:       // Computes the vegetation and drag model parameters:
 3703:       // chi, \tilde\chi, beta, \breve{H}
 3704:       
 3705:       SIDE(side);
 3706: 
 3707:       const double htot = side->htot();
 3708:       const int    kb   = side->kb;
 3709: 
 3710:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 3711: 
 3712:       const double veg_h     = side->veg_h();
 3713:       const double veg_nv    = side->veg_nv();
 3714:       const double veg_c     = side->veg_c();
 3715:       const double veg_beta  = side->veg_beta;
 3716:       const double veg_alpha = side->veg_alpha_vert_mean();
 3717: 
 3718:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 3719:       // Velocity magnitude at the bottom level
 3720:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 3721:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 3722:       side->chi2 = side->Cd()*vmag1;
 3723:       side->chi  = side->chi2;
 3724:       if constexpr(iveg != 0) {
 3725:          const Node *n1 = side->n1;
 3726:          const Node *n2 = side->n2;
 3727:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 3728:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 3729:       }
 3730: 
 3731:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 3732: 
 3733:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 3734:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 3735:       double magUa = 0.0;
 3736:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 3737:          // 3D wet side with veg...
 3738: 
 3739:          double magUa = 0.0;
 3740:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 3741:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 3742: 
 3743:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 3744:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 3745:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 3746: 
 3747:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 3748:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 3749: 
 3750:                // Velocity magnitude at the bottom (l) of the level
 3751:                const double ul = length(side->u2[k]);
 3752: 
 3753:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 3754:                magUa += Dz*0.5*(uh + ul);
 3755: 
 3756:             } // if HasVegetation
 3757:          } // for k
 3758:          const double ua = magUa/min(htot, veg_h); // Vertical average
 3759: 
 3760:          // Computes beta, used for computing the stress term at the top of the canopy.      
 3761:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 3762:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 3763:             const double zCpy = side->zTopCanopy();
 3764:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 3765:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 3766:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 3767:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 3768:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 3769:          } // if isSubmerged
 3770:       } // if iveg   
 3771: 
 3772:       // Computes the friction modified depth, \breve{H} in notes
 3773:       if (side->is2D()) { // 2D
 3774: 
 3775:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 3776:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 3777: 
 3778:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 3779: 
 3780:          side->hhat = htot*htot/fricH; 
 3781: 
 3782:       } else { // 3D
 3783:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 3784: 
 3785:          if constexpr(iveg != 0) {
 3786:             
 3787:             if (side->isSubmerged()) { 
 3788:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 3789:                side->hhat -= veg_c*Hhat_alpha;
 3790: 
 3791:             } else { // Emergent
 3792:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 3793:             }
 3794:          } // if iveg
 3795: 
 3796:          // Enforce positivity for 3D model
 3797:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 3798:       } // if 3D
 3799: 
 3800:       printf("computeVegetationAndDragParameters: sideIdx = %d, side->htot = %f, side->hhat = %f\n", side->idx, side->htot(), side->hhat);
 3801: 
 3802:         
 3803:    }
 3804: 
 3805: 
 3806: 
 3807:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 3808:    // Computes the density gradient between two elements, e1 and e2.
 3809:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 3810:    // zero in the direction normal to the side. 
 3811:    // 
 3812:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 3813:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 3814:    //
 3815:    // Input:
 3816:    //    e1: Element
 3817:    //    e2: Neighbor element (or nullptr if boundary)
 3818:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 3819:    //    k: Index of the half-level at which the density is interpolated
 3820:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 3821:    // 
 3822:    // Output:
 3823:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 3824:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 3825: 
 3826:       if (e2 == nullptr || e2->isDry) {
 3827:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 3828: 
 3829:          Side *side = e1->sides[j];
 3830:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 3831:                  
 3832:          if constexpr(ics == 1) {
 3833:             vec = side->n; // Normal vector to the side
 3834:          } else {
 3835:             // IMPLEMENT THIS XXXXXX
 3836:             // !replace with xel, yel?
 3837:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 3838:             //      &eframe(:,:,i),xn1,yn1,tmp)
 3839:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 3840:             //      &eframe(:,:,i),xn2,yn2,tmp)
 3841:          } //ics
 3842:                    
 3843:          diffRho = 0.0;
 3844: 
 3845:       } else { //internal and wet
 3846:          if constexpr(ics==1) {
 3847:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 3848: 
 3849:             // Vector from e1 to e2
 3850:             vec = toVector2(e2->center - e1->center);
 3851: 
 3852:          } else { 
 3853:             // IMPLEMENT THIS XXXXXX
 3854:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 3855:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 3856:             //                   alow(j)=xctr2
 3857:             //                   bdia(j)=yctr2
 3858:          } // ics
 3859: 
 3860:          diffRho = rho2 - e1->demeanedDensity(k);
 3861:       }
 3862: 
 3863:    }
 3864: 
 3865:    __global__ void computeDensityCubicSplines(void) {
 3866:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 3867: 
 3868:       ELEM(elem);
 3869: 
 3870:       if (elem->isDry) return;
 3871: 
 3872:       const int kb = elem->kb;
 3873: 
 3874:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 3875:       if (elem->is2D()) {
 3876:          // In the 2D case, the density is constant at the prism level. 
 3877:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 3878:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 3879:       } else { //3D
 3880: 
 3881:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 3882:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 3883:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 3884:          ///// XXXX CHECK INDICES!!!!!
 3885:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 3886:       } // 2D/3D
 3887: 
 3888:    }
 3889: } // extern "C"
 3890: 
 3891: 
 3892: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 3893: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 3894: 
 3895:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 3896: 
 3897:    const int kb  = elem->kb;
 3898:    const int kb2 = elem2->kb;
 3899: 
 3900:    // z-coordinate of prism of elem
 3901:    const double zp = elem->z_prism(k);
 3902: 
 3903:    double rho = 0.0;
 3904: 
 3905:    if (elem2->is2D()) {
 3906:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 3907: 
 3908:    } else {  // 3D
 3909: 
 3910:       // eta_min may be < zmax
 3911:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 3912:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 3913: 
 3914:       // (Extrapolate density below bottom, we will fix it later)
 3915:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 3916:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 3917:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 3918:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 3919:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 3920:    } // 2D/3D
 3921:      
 3922: 
 3923:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 3924:    // Now we need to fix it.
 3925:    if (elem->z[k] < elem2->z[kb2]) {
 3926:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 3927: 
 3928:       // There are two methods to adjust the density at the bottom of the element.
 3929:       // iunder_deep=0: 
 3930:       const double depth1 = abs(elem->z[kb]); // larger depth
 3931: 
 3932:       if (iunder_deep==0) {
 3933: 
 3934:          const double weight = max(0.0, min(1.0, (depth1 - h1_bcc)/(h2_bcc - h1_bcc))); // weight
 3935: 
 3936:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 3937: 
 3938:       } else { // iunder_deep != 0
 3939: 
 3940:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 3941: 
 3942:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 3943: 
 3944:          //   Demeaned density at the same z coordinate as
 3945:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 3946:          }
 3947: 
 3948:       } // if iunder_deep
 3949:    } // if elem->z[kb] < elem2->z[kb]
 3950: 
 3951:    return rho;
 3952: }
 3953: 
 3954: 
 3955: extern "C" {
 3956:    __global__ void computeDensityGradient(void) {
 3957: 
 3958:          // Compute the horizontal density gradient at each element.
 3959:       // It works in two steps:
 3960:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 3961:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 3962:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 3963:       //             gradRho.r1 = rho1 - rho0
 3964:       //             gradRho.r2 = rho2 - rho0
 3965:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 3966:       // 
 3967:       //  NOTE: We use de-meaned densities.
 3968: 
 3969:       ELEM(elem);
 3970: 
 3971:       if (elem->isDry) return;
 3972: 
 3973:       const int kb  = elem->kb;
 3974:       const int i34 = elem->i34;
 3975: 
 3976:       for (int k = kb + 1; k < nvrt; k++) {
 3977:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 3978:          //             gradRho.r1 = rho1 - rho0
 3979:          //             gradRho.r2 = rho2 - rho0
 3980:          int icount = 0;
 3981:          double sumRx = 0.0;
 3982:          double sumRy = 0.0;
 3983:          for (int j1=0; j1<i34; j1++) { 
 3984: 
 3985:             const int j2 = elem->nxq(j1 + 1);
 3986: 
 3987:             // Pairs of consecutive neighbor elements of elem
 3988:             const Element *e1 = elem->nghbElems[j1];
 3989:             const Element *e2 = elem->nghbElems[j2];
 3990: 
 3991:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 3992:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 3993:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 3994: 
 3995:             // Compute the density difference and the vector from elem to e1 and e2
 3996:             // getRhoDiffAndVec takes into account boundaries/dry elements
 3997:             double diffRho1, diffRho2;
 3998:             Vector2 vec1, vec2;
 3999:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 4000:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 4001: 
 4002:             const double rl1 = length(vec1);
 4003:             const double rl2 = length(vec2);
 4004:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 4005: 
 4006:             const double delta = cross(vec1, vec2);
 4007:             const double sintheta = abs(delta)/(rl1*rl2);
 4008: 
 4009:             // To avoid problems, avoid elements with small angle between vectors
 4010:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 4011:             const bool validEq = (sintheta > sin_one_deg);
 4012: 
 4013:             if (validEq) {
 4014:                // Solve the system of equations to get the density gradient at elem
 4015:                icount++;
 4016:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 4017:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 4018:                sumRx += Rx;
 4019:                sumRy += Ry;
 4020:             }
 4021:          } // for j1
 4022: 
 4023:          // Compute the average density gradient at elem
 4024:          if (icount==0) {
 4025:            // Bad mesh quality; bail out with 0 b-cc
 4026:            elem->gradRho[k] = {0.0, 0.0};
 4027:          } else {
 4028:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 4029:          }
 4030: 
 4031:       } // for k
 4032: 
 4033:    }
 4034: 
 4035:    __global__ void computeBaroclinicTerm(void) {
 4036:    // Computes the baroclinic term at sides (at half levels).
 4037:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 4038:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 4039: 
 4040:       SIDE(side);
 4041: 
 4042:       if (side->isDry) return;
 4043: 
 4044:       const Element *e1 = side->elems[0];
 4045:       const Element *e2 = side->elems[1];      
 4046:       const int kb = side->kb;
 4047:       
 4048:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 4049: 
 4050:       // interpolates vertically the density gradient of the two elements at the half level/
 4051: 
 4052:       // Starts the integration at the surface and goes down to the bottom
 4053:       int k1 = nvrt - 1;
 4054:       int k2 = nvrt - 1;
 4055: 
 4056:       side->bcc[nvrt-1] = {0.0, 0.0};
 4057:       for (int k = nvrt-1; k >= kb; k--) {
 4058:       // For each prism level (from surface to bottom)...
 4059: 
 4060:          // For both elements, interpolate density gradient at the side's half level.
 4061:          // The gradient at the side is the average of the gradients at the elements.
 4062:          // w1, w2 are used to take into account boundary sides, with just one element.
 4063:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 4064:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 4065:          const double wsum = w1 + w2;
 4066:          w1 = w1/wsum;
 4067:          w2 = w2/wsum;
 4068:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 4069: 
 4070:          // Linear interpolation of both elements' density gradient at the shared side's level.
 4071:          Vector2 gradRho = {0.0, 0.0};
 4072:          if (e1 != nullptr && k > kb) {
 4073:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 4074:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 4075:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 4076:             
 4077:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 4078:          }      
 4079:          if (e2 != nullptr && k > kb) {
 4080:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4081:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4082:             
 4083:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4084:          }
 4085: 
 4086:          if constexpr(ics==2) {
 4087:             // IMPLEMENT THIS XXXXXX
 4088:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4089:             // swild(1)=tmp1
 4090:             // swild(2)=tmp2
 4091:          }
 4092:          
 4093:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4094:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4095:          // CHECK INDICES!!! XXX
 4096:          const double grav3 = 0.5*(side->n1->grav2 + side->n2->grav2);
 4097:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4098:       } // for
 4099: 
 4100:    }
 4101: 
 4102: } // extern "C"
 4103: 
 4104: #ifdef DONTCOMPILE
 4105: __device__ void computeVerticalAdvection(void) {
 4106:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 4107: 
 4108:    sdbt(1:2,:,:)=0.d0
 4109: 
 4110:    const Side *side = FROM kernel;
 4111: 
 4112:    if(side->isDry) return;
 4113: 
 4114:    // If side is wet...
 4115: 
 4116: 
 4117:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 4118:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 4119:    double ws[nvrt] = {} // w @ side
 4120:    int icount = 0;
 4121:    for (int j=0; j<2; j++) {
 4122:       const Element *elem = side->elements[j];
 4123:        
 4124:       if(elem != nullptr) {
 4125:          icount++;
 4126:          for (int k=0; k<nvrt; k++) {
 4127:             ws[k] = ws[k] + elem->w[k];
 4128:          }
 4129:       }
 4130:    }  // for j
 4131: 
 4132:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 4133:    ws = ws/icount;
 4134: 
 4135:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 4136:    // Splines allow for a smooth transition between vertical levels.
 4137:    // Splines have continuity restrictions at the internal knots, but
 4138:    // we have to provide the 1st derivatives at the endpoints.
 4139:    const int kbs = side->kbs; 
 4140:    
 4141:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 4142:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 4143:    initCubicSpline(kbs, nvrt, side, ws, up)
 4144: 
 4145:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 4146:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 4147:    initCubicSpline(kbs, nvrt, side, ws, vp)
 4148: 
 4149:    // Total advection (average onto side)
 4150:    const Node *node1 = side->nodes[0];
 4151:    const Node *node2 = side->nodes[1];
 4152:    for (int k=kbs(i); k<nvrt; k++) {
 4153: 
 4154:       if constexpr(ics==1) {
 4155:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 4156:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 4157:       } else {
 4158:          // XXX IMPLEMENT THIS
 4159:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 4160:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 4161:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 4162:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 4163:       }  // if ics
 4164: 
 4165: 
 4166:    }
 4167: }
 4168: #endif
 4169: 
 4170: 
 4171: extern "C" {
 4172:    __global__ void computeElemAverageGhat(void) {
 4173:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 4174: 
 4175:       ELEM(elem);
 4176:       
 4177:       elem->ghat1= {0.0, 0.0};  
 4178: 
 4179:       if constexpr(ihydraulics != 0) {
 4180:          if (nhtblocks > 0 && elem->isblock) return;
 4181:       }
 4182: 
 4183:       if (elem->isDry) return;
 4184: 
 4185:       // Wet elements.
 4186:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 4187:       // tidal potential, horizontal diffusion, and baroclinic etc
 4188:       // Remember to update both fb and F 
 4189:       // If ics=2, ghat1 are in eframe (ll)
 4190:       // cff1-3: coefficients for 2D/3D
 4191:       Vector2 gradEta = {0.0, 0.0};  // \nabla \eta
 4192:       Vector2 gradPr  = {0.0, 0.0};  // \nabla pressure
 4193:       Vector2 gradETP = {0.0, 0.0};  // \nabla etp
 4194: 
 4195:       double av_cff1 = 0.0;  // av. for cff1
 4196:       double av_cff2 = 0.0;  // av. for cff2
 4197:       double av_cff3 = 0.0;  // av. for cff3
 4198:       double av_df = 0.0;  // av. for H^\alpha / H
 4199:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 4200:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 4201: 
 4202:       const int i34 = elem->i34;
 4203:       const int kb = elem->kb;
 4204: 
 4205:       for (int j=1; j<i34; j++) {
 4206:          // For each node and side in the element...
 4207: 
 4208:          const Node *node = elem->nodes[j];
 4209:          const Side *side = elem->sides[j];
 4210: 
 4211:          const double chi      = side->chi;
 4212:          const double veg_c2   = side->veg_c2;
 4213:          const double veg_beta = side->veg_beta;
 4214:          const double veg_h    = side->veg_h();
 4215:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 4216: 
 4217:          // Node - const in elem
 4218:          gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 4219:          gradPr  += node->pr  *elem->gradPhi[j];
 4220: 
 4221:          if (elem->depth >= tip_dp) {
 4222:            gradETP += node->ETP*elem->gradPhi[j];
 4223:          }
 4224: 
 4225:          
 4226:          const double htot  = side->htot();        // Total depth at the side
 4227:          const double zctr2 = side->zTopCanopy();  
 4228: 
 4229:          double cff1; 
 4230:          double cff2; 
 4231:          double cff3;   
 4232:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 4233:          // coefficients applied to 2D/3D case 
 4234:             cff1 = side->hhat/htot;
 4235:             cff2 = 0.0;
 4236:             cff3 = 0.0;
 4237:          } else { //3D
 4238:             //Init for no-veg case
 4239:             cff1 = 1.0;
 4240:             cff2 = 1.0;
 4241:             cff3 = 0.0;
 4242: 
 4243:             if constexpr(iveg != 0) {
 4244:                // Computes coefficients used with vegetation terms G1, G2
 4245:                // cff1, cff3 are used for the first two terms in G1, G2:
 4246:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 4247:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 4248:                // In general, cff1*Ustar - cff3*Ustar_alpha
 4249:                if(veg_h < 0.99*htot) { // submergent vegetation
 4250:                   cff1=1;
 4251:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 4252:                   cff3 = veg_c;
 4253: 
 4254:                } else { // emergent vegetation
 4255:                   cff1 = 1.0/(1.0 + veg_c2);
 4256:                   cff2 = cff1;
 4257:                   cff3 = 0.0;
 4258: 
 4259:                }
 4260:             } // if iveg
 4261:          } //  2D/3D
 4262: 
 4263:          av_cff1 += cff1/i34;
 4264:          av_cff2 += cff2/i34;
 4265:          av_cff3 += cff3/i34;
 4266:          av_cff2_chi += cff2*chi/i34;
 4267:          av_cff3_chi += cff3*chi/i34;
 4268:          av_df += min(htot, veg_h)/(htot*i34);
 4269: 
 4270: 
 4271:          // btrack values: U^\star, U^{\star\alpha}
 4272:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 4273:          Vector2 Ustar       = {0.0, 0.0}; 
 4274:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 4275:          for (int k = side->kb; k < nvrt; k++) {
 4276:             if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 4277:                Ustar += side->btu[nvrt]*side->Dz(k);
 4278: 
 4279:             } else { //3D
 4280:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 4281:                Ustar += w2;
 4282: 
 4283:                if constexpr(iveg != 0) {
 4284:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 4285:                        const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k)); // For the top of the canopy, ratio of the level that is below the canopy
 4286:                        Ustar_alpha += zrat*w2; // XXXX
 4287:                    }
 4288:                }  // if iveg
 4289:             }  //2/3D
 4290:          }  //k
 4291:          
 4292: 
 4293:          // Add btrack & surface stress terms to \breve{G} first
 4294:          if constexpr(ics==1) {
 4295:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 4296:          } else {
 4297:             // XXX IMPLEMENT THIS
 4298:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 4299:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 4300:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 4301:          }  // if ics
 4302: 
 4303:          // Surface and bottom stress terms
 4304:          if constexpr(ics==1) {
 4305:             const Vector2 tau    = side->tau();
 4306:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 4307: 
 4308:             // Term for surface and bottom stress
 4309:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 4310:          } else {
 4311:             // XXX IMPLEMENT THIS
 4312:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 4313:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 4314:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 4315:             // tau_x=(vn1+tt1)/2.d0
 4316:             // tau_y=(vn2+ss1)/2.d0
 4317:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 4318:          }  // if ics
 4319: 
 4320:          
 4321: 
 4322:          // All terms in F,F^\alpha,f_b except baroclinic
 4323:          // F, f_b: all explicit terms excluding vegetation 
 4324:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 4325:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 4326:          const double coriolis = side->coriolis;
 4327:          Vector2 F  =  coriolis*side->U;  // F_x
 4328:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 4329:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 4330: 
 4331:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 4332:             
 4333:             for (int k = side->kb; k < nvrt; k++) {
 4334:                if (zctr2 > side->zc[k-1]) {
 4335:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 4336:                    const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 4337:                    Fa +=  coriolis*w2*zrat;
 4338:                } // if zctr2
 4339:             } // k
 4340:          } // iveg
 4341: 
 4342:          // Integrate horizontal viscosity force vertically
 4343:          for (int k=side->kb + 1; k<nvrt; k++) {
 4344:             const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.0; 
 4345: 
 4346:             F += levelHorVisc;
 4347: 
 4348:             // Vegetation term
 4349:             if constexpr(iveg!=0) {
 4350:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 4351:                   const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 4352:                   Fa += levelHorVisc*zrat;
 4353:                } 
 4354:             } // if iveg
 4355:          } // for k
 4356: 
 4357:          fb += side->d2uv[side->kb];
 4358: 
 4359: 
 4360:          // Add to ghat1
 4361:          if constexpr(ics==2) {
 4362:             // XXX IMPLEMENT THIS
 4363:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4364:             // bigf1=vn1; bigf2=vn2
 4365:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4366:             // botf1=vn1; botf2=vn2
 4367:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4368:             // bigfa1=vn1; bigfa2=vn2
 4369:          } // if ics
 4370: 
 4371:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 4372:       } // for j (nodes and sides)
 4373: 
 4374:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 4375:          
 4376:       // Finish off terms in F, F^\alpha and f_b
 4377:       const double grav3 = elem->mean(&Node::grav2);
 4378:       const Vector2 fb = grav3*gradETP - gradPr/rho0; //const in each elem
 4379: 
 4380: 
 4381:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 4382:       for (int j=1; j<i34; j++) { 
 4383:          // For each side in the element...
 4384:          const Side *side = elem->sides[j];
 4385:          const double chi = side->chi;
 4386: 
 4387:          const double htot = side->htot();
 4388:          const double veg_h = side->veg_h();
 4389:          const Vector2 F  = htot*fb;
 4390:          const Vector2 Fa = min(htot, veg_h)*fb;
 4391: 
 4392:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 4393:       } // for j
 4394: 
 4395:       //botf1 etc are already in elem frame
 4396:       elem->ghat1 += tmp/i34;
 4397: 
 4398:       // Baroclinic force
 4399:       if constexpr(ibc==0) {
 4400:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 4401: 
 4402:          Vector2 Fa = {0.0, 0.0};
 4403:          Vector2 intGradRho = {0.0, 0.0};
 4404:          
 4405:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 4406:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 4407:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 4408: 
 4409:             // \in F [m^2/s/s]
 4410:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 4411:          }
 4412: 
 4413:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 4414:          const Vector2 F = av_df*Fa; //approx
 4415:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 4416: 
 4417:       } // if ibc
 4418: 
 4419:    }
 4420: 
 4421: } // extern "C"
 4422: 
