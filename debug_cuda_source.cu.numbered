 3943: // #ifdef DEBUG
 3944: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 3945: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 3946: //                     call parallel_abort(errmsg)
 3947: //                   endif
 3948: // #endif
 3949: 
 3950: //                 enddo !i
 3951: //                 wm=wm/sum1 !final weight
 3952: 
 3953:                 for (int j=0; j<elem->i34; j++) { // side
 3954:                   const Side *side = elem->sides[j];
 3955:                   const Node *node1 = side->n1;
 3956:                   const Node *node2 = side->n2;
 3957: 
 3958:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 3959:                     trsd=0.d0
 3960:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 3961:                       for (int i=0; i<elem->nweno1; i++) {
 3962:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 3963:                       }
 3964:                     enddo //kk
 3965:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 3966:                   } // outward flux
 3967:                 } // end for j=1,i34(ie) ! side
 3968:               } // end for k; ntr 
 3969: 
 3970:             else !simple upwind method
 3971:               do j=1,i34(ie)
 3972:                 jsj=elside(j,ie)
 3973:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 3974:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 3975:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 3976:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 3977:                   endif
 3978:                 enddo  !vertical layers
 3979:               enddo !j=1,i34(ie) ! side
 3980:             endif !order of accuracy
