 4996: extern "C"
 4997:                                  
 4998:   __global__ void populateMesh(int *i34, int *elnode, int *elside,
 4999:                    double *node_coords, double *wind_rotate_angle, 
 5000:                    int *isdel, int *isidenode, int *isbnd,
 5001:                    int *nond, int *nlnd, int *iond, int *ilnd,
 5002:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 5003:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 5004:                    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 5005:                    int *localNodeIndices, int *localElemIndices, int *localSideIndices,
 5006:                    int *localNodePart,    int *localElemPart,    int *localSidePart,
 5007:                    double *emo, double *efa, 
 5008:                    double *umo, double *ufa, 
 5009:                    double *vmo, double *vfa) {
 5010: 
 5011:     mesh->populateMesh(i34, elnode, elside, node_coords, wind_rotate_angle, 
 5012:                        isdel, isidenode, isbnd,
 5013:                        nond, nlnd, iond, ilnd,
 5014:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 5015:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 5016:                        globalNodeIndices, globalElemIndices, globalSideIndices,
 5017:                        localNodeIndices, localElemIndices, localSideIndices,
 5018:                        localNodePart, localElemPart, localSidePart,
 5019:                        emo, efa, umo, ufa, vmo, vfa);
 5020:   }
