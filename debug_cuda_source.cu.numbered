  636: 
  637: struct Side {
  638: 
  639:    // Geometry information
  640:    int idx;               // Index of the side
  641:    Node *n1, *n2;
  642:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  643: 
  644:    double length;         // Length of the side. Used to be called distj; but I think this name is less clear now.
  645:    Vector2 center;        // Location of side center. 
  646:    double zc[nvrt];       // Side center z-coord at each vertical level
  647:    double depth;          // Depth at side center
  648: 
  649:    Frame frame;
  650: 
  651:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  652:                           // this is nullptr
  653:    
  654:    int kb;                // Bottom index of the side
  655:    bool idry;             // True if the side is dry
  656:  
  657:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  658: 
  659:    // Physical information
  660:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  661:    double  w2[nvrt];            // Vertical velocity at each vertical level
  662:    Vector2 btu[nvrt];           // Back-tracked velocity
  663:    Vector2 uth[nvrt];           // "Time history" velocity
  664:    Vector2 U;                   // Vertically averaged velocity vector  
  665: 
  666:    Vector2 d2uv[nvrt];          // divergence of (nu*grad u) XXX COMPUTE!!
  667: 
  668:    Vector2 bcc[nvrt];           // Baroclinic term
  669: 
  670:    double hhat;                 // \breve{H} in notes
  671: 
  672:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
  673: 
  674:    double coriolis;             // Coriolis parameter
  675: 
  676:    // Vegetation parameters
  677:    double veg_c2;
  678:    double veg_beta;
  679: 
  680:    // Bottom drag parameters.
  681:    double chi;
  682:    double chi2;
  683: 
  684:    __inline__ __device__ double x(double t) const;
  685:    __inline__ __device__ double y(double t) const;
  686:    __inline__ __device__ Point2 p_t(double t) const;
  687: 
  688:    __inline__ __device__ Point3 center3D(int k) const { return {center.x, center.y, zc[k]}; }
  689:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
  690:    __inline__ __device__ double Dz(int k)       const { return zc[k] - zc[k-1]; }
  691: 
  692:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
  693: 
  694:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
  695: 
  696:    __inline__ __device__ int iadv(void) const;
  697: 
  698:    __inline__ __device__ double eta2(void) const;
  699:    __inline__ __device__ double htot(void) const { return eta2() + depth; }
  700: 
  701:    __inline__ __device__ double veg_h(void)  const;
  702:    __inline__ __device__ double veg_nv(void) const;
  703:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
  704:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
  705: 
  706:    __inline__ __device__ double Cd(void) const;
  707: 
  708:    __inline__ __device__ Vector2 tau(void) const;
  709: 
  710:    __inline__ __device__ double zb(void) const { return zc[kb]; }
  711:    
  712: 
  713:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
  714:    __inline__ __device__ double zLevelVegRatio(int k) const { 
  715:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
  716:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
  717:    } 
  718:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
  719:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot(); }
  720:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 1; }
  721:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 1; }
  722: 
  723:    // Get valid starting element (for backtracking)
  724:    __inline__ __device__ Element* getStartElement() {
  725:       return elems[0] ? elems[0] : elems[1];
  726:    }
  727: 
  728:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
  729:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
  730: 
  731:       // If one of the elements is null, return the other one
  732:       if      (elems[0] == nullptr) return elems[1];
  733:       else if (elems[1] == nullptr) return elems[0];
  734: 
  735: 
  736:       // Dot product of the negative velocity vector with the side normal vector
  737:       const double dot_prod1 = -dot(u, n);
  738:       
  739:       // Vector from side center to element 0 centroid
  740:       const Vector2 v2 = toVector2(elems[0]->center) - center;
  741: 
  742:       // Dot product of the vector with the side normal vector
  743:       const double dot_prod2 = dot(v2, n);
  744: 
  745:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
  746:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
  747: 
  748:       if (dot_prod1*dot_prod2 > 0.0) return elems[0];
  749:       else                           return elems[1];
  750: 
  751:  
  752:    }
  753: 
  754:    __forceinline__ __device__ Element* otherElem(const Element* elem) {
  755:       // Given an element, returns the other element that shares this side
  756:       return (elems[0] == elem) ? elems[1] : elems[0];
  757:    }
  758: 
  759:    __forceinline__ __device__ Node* otherNode(Node* node) {
  760:       // Given a node, returns the other node that shares this side
  761:       return (n1 == node) ? n2 : n1;
  762:    }
  763:  
  764:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, double* sclr,
  765:                                      Vector3 &u_int) const;
  766: 
  767: 
  768: 
  769: 
  770: };
  771: 
