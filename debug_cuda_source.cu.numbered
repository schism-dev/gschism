 1689: __inline__ __device__ double Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 1690: __inline__ __device__ double Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 1691: __inline__ __device__ Point2 Side::p_t(double t) const { return {x(t), y(t)}; }
 1692: __inline__ __device__ int    Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 1693: __inline__ __device__ double Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 1694: 
 1695: __inline__ __device__ double Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 1696: __inline__ __device__ double Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 1697: __inline__ __device__ double Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 1698: 
 1699: 
 1700: __inline__ __device__ double Side::Cd(void)      const { if constexpr(nchi != 0) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 1701: 
 1702: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 1703: 
 1704: /**
 1705:  * This method performs backtracking from the side center until a time -dt back in time 
 1706:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 1707:  * intermediate point.
 1708:  *
 1709:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 1710:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 1711:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 1712:  * remaining time.
 1713:  * 
 1714:  * NOTE: Runge-Kutta is not implemented yet. XXX
 1715:  * 
 1716:  * @param uuint, vvint, wwint: Velocities at the final point
 1717:  * @param jlev: Level at which the backtracking is performed
 1718:  * @param dt, dtbk: Tracking timesteps
 1719:  * @param sclr: Array for backtracked values
 1720:  * @return: True if the backtracking was successful, false otherwise
 1721:  */
 1722: __inline__ __device__ bool Side::btrack(
 1723:       int jlev,
 1724:       double dt,            // Tracking time
 1725:       double dtbk,          // Tracking timestep
 1726:       double* sclr,         // Array for backtracked values
 1727:       Vector3 &u_int
 1728: ) const {
 1729: 
 1730:    // Start from side center
 1731:    Point3 x0 = {center.x, center.y, zc[jlev]};
 1732:  
 1733: 
 1734:    double time_rm = dt; // Remaining time
 1735: 
 1736: 
 1737:    // // Initialize outputs XXX
 1738:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 1739:    //    sclr[i] = 0.0;
 1740:    // }
 1741: 
 1742: 
 1743:    // Initial velocities
 1744:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 1745: 
 1746:    // Find the element that is in the direction opposite to the velocity
 1747:    Element* curElem = findElementTowards({u_int.x, u_int.y});
 1748: 
 1749: 
 1750:    const int MAX_ITERATIONS = 1000; 
 1751:    Element* nextElem = curElem;
 1752:    int iter = 0;
 1753:    while(true) {
 1754:       // Calculate timestep
 1755:       double dtb = min(dtbk, time_rm);
 1756: 
 1757:       // Next point in the backtracking curve
 1758:       Point3 xt = x0 - dtb*u_int;
 1759: 
 1760:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb);
 1761:       assert(found && "Backtracking failed in btrack");
 1762: // printf("<>T = %f, %f %f %f\n", time_rm - dtb, xt, yt, zt);
 1763:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 1764:                       // then time_rm needs to be increased by the unused time.
 1765: 
 1766: 
 1767:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 1768: 
 1769:       // The current point becomes the next segment's starting point.
 1770:       x0 = xt;
 1771:  
 1772:       curElem = nextElem;
 1773: 
 1774:       iter++;
 1775:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 1776:    }
 1777: 
 1778: 
 1779: }
 1780: 
