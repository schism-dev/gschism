  315: struct Element {
  316: 
  317:    // Geometry information
  318:    int idx;               // Index of the element
  319:    int i34;               // Number of sides for the element 
  320:    Side *sides[4];        // Sides of the element
  321:    Node *nodes[4];        // Nodes of the element
  322:    Element *nghbElems[4]; // Neighbors of the element
  323: 
  324:    int kb;                    // Bottom index of the element
  325:    double area;               // Area of the element
  326:    double ssign[4];           // Sign associated with each side of an element
  327:    double radius;             // Element equivalent radii
  328: 
  329:    double wind_angle;         // Wind rotation angle
  330: 
  331:    Frame frame;
  332: 
  333:    Vector2 gradPhi[4];       // Derivatives of shape functions
  334: 
  335:    int idry;                  // True if the element is dry
  336:    int kbe;                   // Bottom index of the element
  337: 
  338:    Vector3 center;            // Element center coordinates
  339:    double xlon_el, ylat_el;   // Element center lat/lon coordinates in _degrees_
  340:    double depth;              // Depth at element (min of all nodes)
  341:    double z[nvrt];            // z-coord  (local frame - vertical up)
  342: 
  343:    // Physical information
  344:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  345: 
  346:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  347:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  348: 
  349:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  350: 
  351:    double vsource;            // Volumetric source/sink term [m^3/s]
  352: 
  353:    double rho[nvrt];          // Density at each prism center
  354:    double rho_mean[nvrt];     // Mean density at each prism center
  355: 
  356:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  357: 
  358:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  359:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  360: 
  361:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 1; }
  362:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 1; }
  363: 
  364:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  365:    __inline__ __device__ int nodeLocalIdx(Node *node) const { 
  366:       int res = (nodes[0] == node) ? 0 : ((nodes[1] == node) ? 1 : ((nodes[2] == node) ? 2 : 3)); 
  367:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  368:       return res;
  369:    }
  370: 
  371:    __inline__ __device__ double z_prism(int k) const { return 0.5*(z[k+1] + z[k]); }
  372:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  373: 
  374:    __inline__ __device__ double computeSignedArea(void) const;
  375: 
  376:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  377:       // Nudges the point (x,y) to the barycenter of the element
  378:       p = (1-eps)*p + eps*toVector2(center);
  379:    }
  380: 
  381:    __device__ bool computeShapeCoords(Point2 xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  382: 
  383:    __device__ Vector2 grad(double *a) const
  384:    {
  385:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  386:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  387:       if (isQuad()) {
  388:          gx += a[3]*gradPhi[3].x;
  389:          gy += a[3]*gradPhi[3].y;
  390:       }
  391:       return {gx, gy};
  392:    }
  393: 
  394:    __device__ void setFrame(void) {
  395: 
  396:       double ar1, ar2;
  397:       computeLonLat(center, ar1, ar2);
  398: 
  399:       frame.update(ar1, ar2);        
  400:     }
  401: 
  402:    __device__ bool findNextIntersection(Point2 x2, Side *&side, Element *&nextElement, double &t, 
  403:                                         double& tIntersect);
  404:    __device__ bool findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement, double &t, 
  405:                                         double& tIntersect);
  406: 
  407:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  408:       // Check if the point (xt,yt) is inside the element
  409:       double shpCoords[4];
  410:       bool res = computeShapeCoords(xt, shpCoords, false);
  411:       return res;
  412:    }
  413: 
  414:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4])
  415:    {
  416:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  417:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  418:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  419:       
  420:    }
  421: 
  422:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int);
  423: 
  424:    // ------------------------------------------------------------------------------------------------
  425:    // These are functions that work on all nodes of the element.
  426:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  427:    //
  428:    // An example of how to use these functions is:
  429:    //   
  430:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  431:    // 
  432:    // Where L is the level at which the field is to be interpolated. The field can be either
  433:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  434:    // There are different versions of getNodalValues for each of these cases.
  435: 
  436:    template<typename T>
  437:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  438:       // Get the values of the field at the nodes of the element
  439:       res[0] = nodes[0]->*field;
  440:       res[1] = nodes[1]->*field;
  441:       res[2] = nodes[2]->*field;
  442:       if (isQuad()) res[3] = nodes[3]->*field;
  443:       else          res[3] = T();
  444:    }
  445: 
  446:    template<typename T>
  447:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  448:       // Get the values of the field at the nodes of the element
  449:       res[0] = (nodes[0]->*field)[level];
  450:       res[1] = (nodes[1]->*field)[level];
  451:       res[2] = (nodes[2]->*field)[level];
  452:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  453:       else          res[3] = T();
  454:    }    
  455: 
  456:    template<typename T>
  457:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  458:       // Get the values of the func at the nodes of the element
  459:       res[0] = (nodes[0]->*func)(level);
  460:       res[1] = (nodes[1]->*func)(level);
  461:       res[2] = (nodes[2]->*func)(level);
  462:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  463:       else          res[3] = T();  // This is 0.0 or a zero vector
  464: 
  465:    }      
  466: 
  467:    template<typename T>
  468:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  469:       // Get the values of the field at the nodes of the element
  470:       res[0] = sides[0]->*field;
  471:       res[1] = sides[1]->*field;
  472:       res[2] = sides[2]->*field;
  473:       if (isQuad()) res[3] = sides[3]->*field;
  474:       else          res[3] = T();
  475:    }
  476: 
  477:    template<typename T>
  478:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  479:       // Get the values of the field at the nodes of the element
  480:       res[0] = (sides[0]->*field)[level];
  481:       res[1] = (sides[1]->*field)[level];
  482:       res[2] = (sides[2]->*field)[level];
  483:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  484:       else          res[3] = T();
  485:    }    
  486: 
  487:    template<typename T>
  488:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  489:       // Get the values of the func at the nodes of the element
  490:       res[0] = (sides[0]->*func)(level);
  491:       res[1] = (sides[1]->*func)(level);
  492:       res[2] = (sides[2]->*func)(level);
  493:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  494:       else          res[3] = T();  // This is 0.0 or a zero vector
  495: 
  496:    }      
  497: 
  498: 
  499:    __device__ double interpolate(int level, const double shapeCoords[4], double (Node::*func)(int) const) const {
  500:       double values[4];
  501:       getNodalValues(level, func, values);
  502: 
  503:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  504:    }
  505: 
  506:    template<typename T>
  507:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  508:       T values[4];
  509:       getNodalValues(field, values);
  510:       
  511:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  512:    }
  513: 
  514: 
  515:    template<typename T>
  516:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  517:       T values[4];
  518:       getNodalValues(level, field, values);
  519: 
  520:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  521:    }
  522: 
  523:    template<typename T>
  524:    __device__ T mean(T Node::* field) const {
  525:       T values[4];
  526:       getNodalValues(field, values);
  527: 
  528:       return (values[0] + values[1] + values[2] + values[3])/i34;
  529:    }
  530: 
  531:    template<typename T>
  532:    __device__ T mean(T Side::* field) const {
  533:       T values[4];
  534:       getSideValues(field, values);
  535:       
  536:       return (values[0] + values[1] + values[2] + values[3])/i34;
  537:    }   
  538: 
  539:    // __device__ double mean(double (Node::*func)(int) const) const {
  540:    //    double values[4];
  541:    //    getNodalValues(level, func, values);
  542:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  543:    // }
  544:    // ------------------------------------------------------------------------------------------------
  545: 
  546:    __device__ bool globalToLocal(double xt, double yt, double &xlocal, double &ylocal) const {
  547:       // Convert global coordinates to local coordinates
  548:       printf("NOT IMPLEMENTED: globalToLocal\n");
  549:       return true;
  550:    }
  551: 
  552:    __inline__ __device__ bool localToGlobal(double xlocal, double ylocal, double &xt, double &yt) const {
  553:       // Convert local coordinates to global coordinates
  554:       printf("NOT IMPLEMENTED: localToGlobal\n");
  555:       return true;
  556:    }
  557: 
  558:    __device__ void trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
  559:                                        double &dt, Point3 &xt, double zint, Vector3 &u_int);
  560:     
  561:    __device__ bool trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
  562:                                                  Element *&nextElem, int &jlev, double &dt);
  563: 
  564: };
