  419: struct Element {
  420: 
  421:    // Geometry information
  422:    int idx;               // Index of the element
  423:    int i34;               // Number of sides for the element 
  424:    Side *sides[4];        // Sides of the element
  425:    Node *nodes[4];        // Nodes of the element
  426:    Element *nghbElems[4]; // Neighbors of the element
  427: 
  428:    int kb;                    // Bottom index of the element
  429:    double area;               // Area of the element
  430:    double ssign[4];           // Sign associated with each side of an element
  431:    double radius;             // Element equivalent radii
  432: 
  433:    Frame frame;
  434: 
  435:    Vector2 gradPhi[4];       // Derivatives of shape functions
  436:    Vector2 gradEta;          // Gradient of free surface elevation
  437:    Vector2 gradPr;           // Gradient of pressure    
  438:    Vector2 gradETP;          // Gradient of Earth Tidal Potential    XXXXX Really used?
  439: 
  440:    bool isDry;                  // True if the element is dry
  441:    int kbe;                   // Bottom index of the element
  442: 
  443:    Vector3 center;            // Element center coordinates
  444:    double xlon_el, ylat_el;   // Element center lat/lon coordinates in _degrees_
  445:    double depth;              // Depth at element (min of all nodes)
  446:    double z[nvrt];            // z-coord  (local frame - vertical up)
  447: 
  448:    // Physical information
  449:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  450: 
  451:    static const bool isblock = false;              // Always false
  452: 
  453:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  454:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  455: 
  456:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  457: 
  458:    
  459: 
  460:    double vsource;            // Volumetric source/sink term [m^3/s]
  461: 
  462:    double rho[nvrt];          // Density at each prism center
  463:    double rho_mean[nvrt];     // Mean density at each prism center
  464:    CubicSpline rho_spl;
  465:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  466:    double rho_z[nvrt];        // First derivative of density at each prism center
  467:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  468: 
  469:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  470: 
  471:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  472:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  473: 
  474:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 1; }
  475:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 1; }
  476: 
  477:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  478:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  479:       // Find the local index of the node in the element (0,1,2,3)
  480:       int res = __ffs((nodes[0] == node) | 
  481:                      ((nodes[1] == node) << 1) | 
  482:                      ((nodes[2] == node) << 2) | 
  483:                      ((nodes[3] == node) << 3)) - 1;
  484:       
  485:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  486:       return res;
  487:    }
  488: 
  489:    __inline__ __device__ int findLevel(double z1, int k) const {
  490:       // Starting at index k, find sequentially the level that contains z
  491: 
  492:       // if z is already betweeen z[k] and z[k+1], return k
  493:       if (z1 >= z[k] && z1 < z[k+1]) return k;
  494:       else if (z1 < z[k]) { 
  495:          // Search for increasing levels
  496:          for (int kk = k; kk < nvrt - 1; kk++) {
  497:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  498:          }
  499:          return nvrt - 1;
  500:       }
  501:       else {
  502:          // Search for decreasing levels
  503:          for (int kk = k; kk > 0; kk--) {
  504:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  505:          }
  506:          return 0;
  507:       }
  508:    }
  509: 
  510:    __inline__ __device__ double z_prism(int k) const { return 0.5*(z[k+1] + z[k]); }
  511:    __inline__ __device__ double Dz(int k)      const { return z[k+1] - z[k]; }
  512: 
  513:    // Check if the element is dry using the more up-to-date elevation.
  514:    __inline__ __device__ bool isDry2(void) const;
  515: 
  516:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  517: 
  518:    __inline__ __device__ double computeSignedArea(void) const;
  519: 
  520:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  521:       // Nudges the point (x,y) to the barycenter of the element
  522:       p = (1-eps)*p + eps*toVector2(center);
  523:    }
  524: 
  525:    __device__ bool computeShapeCoords(Point2 xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  526: 
  527:    __device__ Vector2 grad2(double *a) const
  528:    {
  529:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  530:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  531:       if (isQuad()) {
  532:          gx += a[3]*gradPhi[3].x;
  533:          gy += a[3]*gradPhi[3].y;
  534:       }
  535:       return {gx, gy};
  536:    }
  537: 
  538:    __device__ Vector2 grad2(double Node::* field) const
  539:    {
  540:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  541:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  542:       if (isQuad()) {
  543:          gx += (nodes[3]->*field)*gradPhi[3].x;
  544:          gy += (nodes[3]->*field)*gradPhi[3].y;
  545:       }
  546:       return {gx, gy};
  547:    }
  548: 
  549:    __device__ void setFrame(void) {
  550: 
  551:       double ar1, ar2;
  552:       computeLonLat(center, ar1, ar2);
  553: 
  554:       frame.update(ar1, ar2);        
  555:     }
  556: 
  557:    __device__ bool findNextIntersection(Point2 x2, Side *&side, Element *&nextElement, double &t, 
  558:                                         double& tIntersect);
  559:    __device__ bool findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement, double &t, 
  560:                                         double& tIntersect);
  561: 
  562:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  563:       // Check if the point (xt,yt) is inside the element
  564:       double shpCoords[4];
  565:       bool res = computeShapeCoords(xt, shpCoords, false);
  566:       return res;
  567:    }
  568: 
  569:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  570:    {
  571:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  572:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  573:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  574:       
  575:    }
  576: 
  577:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int) const;
  578: 
  579:    // ------------------------------------------------------------------------------------------------
  580:    // These are functions that work on all nodes of the element.
  581:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  582:    //
  583:    // An example of how to use these functions is:
  584:    //   
  585:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  586:    // 
  587:    // Where L is the level at which the field is to be interpolated. The field can be either
  588:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  589:    // There are different versions of getNodalValues for each of these cases.
  590: 
  591:    template<typename T>
  592:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  593:       // Get the values of the field at the nodes of the element
  594:       res[0] = nodes[0]->*field;
  595:       res[1] = nodes[1]->*field;
  596:       res[2] = nodes[2]->*field;
  597:       if (isQuad()) res[3] = nodes[3]->*field;
  598:       else          res[3] = T();
  599:    }
  600: 
  601:    template<typename T>
  602:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  603:       // Get the values of the field at the nodes of the element
  604:       res[0] = (nodes[0]->*field)[level];
  605:       res[1] = (nodes[1]->*field)[level];
  606:       res[2] = (nodes[2]->*field)[level];
  607:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  608:       else          res[3] = T();
  609:    }    
  610: 
  611:    template<typename T>
  612:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  613:       // Get the values of the func at the nodes of the element
  614:       res[0] = (nodes[0]->*func)(level);
  615:       res[1] = (nodes[1]->*func)(level);
  616:       res[2] = (nodes[2]->*func)(level);
  617:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  618:       else          res[3] = T();  // This is 0.0 or a zero vector
  619: 
  620:    }      
  621: 
  622:    template<typename T>
  623:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  624:       // Get the values of the field at the nodes of the element
  625:       res[0] = sides[0]->*field;
  626:       res[1] = sides[1]->*field;
  627:       res[2] = sides[2]->*field;
  628:       if (isQuad()) res[3] = sides[3]->*field;
  629:       else          res[3] = T();
  630:    }
  631: 
  632:    template<typename T>
  633:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  634:       // Get the values of the field at the nodes of the element
  635:       res[0] = (sides[0]->*field)[level];
  636:       res[1] = (sides[1]->*field)[level];
  637:       res[2] = (sides[2]->*field)[level];
  638:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  639:       else          res[3] = T();
  640:    }    
  641: 
  642:    template<typename T>
  643:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  644:       // Get the values of the func at the nodes of the element
  645:       res[0] = (sides[0]->*func)(level);
  646:       res[1] = (sides[1]->*func)(level);
  647:       res[2] = (sides[2]->*func)(level);
  648:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  649:       else          res[3] = T();  // This is 0.0 or a zero vector
  650: 
  651:    }      
  652: 
  653: 
  654:    __device__ double interpolate(int level, const double shapeCoords[4], double (Node::*func)(int) const) const {
  655:       double values[4];
  656:       getNodalValues(level, func, values);
  657: 
  658:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  659:    }
  660: 
  661:    template<typename T>
  662:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  663:       T values[4];
  664:       getNodalValues(field, values);
  665:       
  666:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  667:    }
  668: 
  669: 
  670:    template<typename T>
  671:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  672:       T values[4];
  673:       getNodalValues(level, field, values);
  674: 
  675:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  676:    }
  677: 
  678:    template<typename T>
  679:    __device__ T mean(T Node::* field) const {
  680:       T values[4];
  681:       getNodalValues(field, values);
  682: 
  683:       return (values[0] + values[1] + values[2] + values[3])/i34;
  684:    }
  685: 
  686:    template<typename T>
  687:    __device__ T mean(T Side::* field) const {
  688:       T values[4];
  689:       getSideValues(field, values);
  690:       
  691:       return (values[0] + values[1] + values[2] + values[3])/i34;
  692:    }   
  693: 
  694:    // __device__ double mean(double (Node::*func)(int) const) const {
  695:    //    double values[4];
  696:    //    getNodalValues(level, func, values);
  697:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  698:    // }
  699:    // ------------------------------------------------------------------------------------------------
  700: 
  701:    __device__ bool globalToLocal(double xt, double yt, double &xlocal, double &ylocal) const {
  702:       // Convert global coordinates to local coordinates
  703:       printf("NOT IMPLEMENTED: globalToLocal\n");
  704:       return true;
  705:    }
  706: 
  707:    __inline__ __device__ bool localToGlobal(double xlocal, double ylocal, double &xt, double &yt) const {
  708:       // Convert local coordinates to global coordinates
  709:       printf("NOT IMPLEMENTED: localToGlobal\n");
  710:       return true;
  711:    }
  712: 
  713:    __device__ void trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
  714:                                        double &dt, Point3 &xt, double zint, Vector3 &u_int);
  715:     
  716:    __device__ bool trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
  717:                                                  Element *&nextElem, int &jlev, double &dt);
  718: 
  719: };
