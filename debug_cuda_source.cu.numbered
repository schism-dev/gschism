 3954:             else !simple upwind method
 3955:               do j=1,i34(ie)
 3956:                 jsj=elside(j,ie)
 3957:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 3958:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 3959:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 3960:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 3961:                   endif
 3962:                 enddo  !vertical layers
 3963:               enddo !j=1,i34(ie) ! side
 3964:             endif !order of accuracy
