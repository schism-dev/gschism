 1301:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1302:       // Compute the different time ramps used in the code 
 1303:       // This function is performed by just one thread
 1304: 
 1305:       if constexpr(ibc == 0) {
 1306:          if (drampbc > 0.0) {
 1307:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1308:          } else {
 1309:             rampbc = 1.0;
 1310:          }
 1311: 
 1312:          if (nws != 0 && drampwind > 0.0) {
 1313:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1314:          } else {
 1315:             rampwind = 1.0;
 1316:          }
 1317:       }
 1318: 
 1319:       if (drampwafo > 0.0) {
 1320:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1321:       } else {
 1322:          rampwafo = 1.0;
 1323:       }
 1324: 
 1325:       // For source/sinks
 1326:       if (if_source && dramp_ss > 0.0) {
 1327:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1328:       } else {
 1329:          ramp_ss = 1.0;
 1330:       }
 1331: 
 1332:       if (dramp > 0.0) {
 1333:          ramp = tanh(2.0*time/86400.0/dramp);
 1334:       } else {
 1335:          ramp = 1.0;
 1336:       }
 1337: 
 1338:       printf("computeTimeRamps: i = %d, nws = %d, if_source = %d, drampbc = %f, drampwind = %f, drampwafo = %f, dramp_ss = %f, dramp = %f\n", 
 1339:              threadIdx.x + blockIdx.x * blockDim.x, nws, if_source, drampbc, drampwind, drampwafo, dramp_ss, dramp);
 1340:    }
