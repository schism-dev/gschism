  190: // ------------------------------------------------------------------------------------------------
  191: 
  192: 
  193: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  194:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  195:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  196: }
  197: 
  198: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  199:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  200:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  201: }
  202: 
  203: 
  204: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  205:    x3 = y1*z2 - y2*z1;
  206:    y3 = x2*z1 - x1*z2;
  207:    z3 = x1*y2 - x2*y1;
  208: }
  209: 
  210: 
  211: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  212: // Given a 3D global point (may not be on surface of earth), find its longitude and latitude in radians
  213: 
  214:    const double radius2 = dot(p, p);
  215:    assert(radius2 != 0.0     && "computeLonLat: radius = 0");
  216:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  217: 
  218:    rlon = atan2(p.y, p.x); // (-pi,pi]
  219: 
  220:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  221:       rlat = asin(p.z/sqrt(radius2));
  222:    } else {
  223:       rlat = asin(p.z/rearth_pole);
  224:    }
  225:   
  226: }
  227: 
  228: __inline__ __device__ void Error(const char* msg) {
  229:    printf("Error: %s\n", msg);
  230:    assert(false);
  231: }
  232: 
  233: struct Tracers {
  234:     double tracer[N_TRACERS];
  235: };
  236: 
  237: 
  238: 
  239: struct Frame {
  240:    double _t[9]; // t stands for tensor.
  241: 
  242:    // Access the tensor in Fortran order
  243:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  244: 
  245:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  246: 
  247:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  248: 
  249:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  250:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  251:       sincos(ar2, &sin_ar2, &cos_ar2);
  252: 
  253:       t(0,0) = -sin_ar1;
  254:       t(1,0) =  cos_ar1;
  255:       t(2,0) =  0.0;
  256:       t(0,1) = -cos_ar1*sin_ar2;
  257:       t(1,1) = -sin_ar1*sin_ar2;
  258: 
  259:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  260: 
  261:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  262:       assert (ar4!=0.0 && "GRID: ar4=0");
  263: 
  264:       const double ar4_inv = 1.0/ar4;
  265:       t(0,1) = t(0,1)*ar4_inv;
  266:       t(1,1) = t(1,1)*ar4_inv;
  267:       t(2,1) = t(2,1)*ar4_inv;
  268: 
  269:       // The third vector is the cross product of the first two
  270:       crossProduct(t(0,0), t(1,0), t(2,0), 
  271:                    t(0,1), t(1,1), t(2,1), 
  272:                    t(0,2), t(1,2), t(2,2));
  273:    }
  274: 
  275: 
  276:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  277:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  278:    // Inputs:
  279:    //        vec0: vel. in this frame;
  280:    //        frameout: Output frame;
  281:    // Output: 
  282:    //        vec1: vel. in new frame  
  283: 
  284:       auto const fo = frameout;
  285:       Vector2 vec1;
  286: 
  287:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  288:       // of t and fo.t are the same.
  289:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  290:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  291: 
  292:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  293:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  294: 
  295:       return vec1;
  296:    }
  297: 
  298:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  299:       // Transform a vector from global to local frame
  300:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  301:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  302:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  303:    }
  304: 
  305:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  306:       // Transform a vector from local to global frame
  307:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  308:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  309:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  310:    }   
  311: 
  312:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  313:    // Tranforms a point from global to local frame     
  314:       G2L(pi - origin0, po);
  315:    }
  316: 
  317:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  318:    // Transforms a point from local to global frame      
  319:       L2G(pi, po);
  320:       po = po + origin0;
  321:    }
  322: 
  323: };
