 3251:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3252: 
 3253:       NODE_BND(nodeBnd);
 3254: 
 3255:       Node *node = nodeBnd->node;
 3256: 
 3257:       node->ETP = 0.0;
 3258: 
 3259:       for (int j=0; j<ntip; j++) {
 3260: 
 3261:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3262:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3263:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3264: 
 3265:          if constexpr(iloadtide==1) { // loading tide
 3266:             assert(false && "Loading tide not implemented");
 3267:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3268:          }
 3269:          
 3270:       }
 3271:       
 3272:    }
