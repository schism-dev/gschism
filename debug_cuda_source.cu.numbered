  747: 
  748:    __device__ void addToSparseMatrix(Node const *node, double value) {
  749:       // Add the value to the sparse matrix for this node
  750:       printf("NOT IMPLEMENTED: addToSparseMatrix\n");
  751:    }
  752: 
  753: #ifdef BACKTRACKING
  754:    __device__ void updateZCoordData() {
  755:    // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
  756: 
  757:       // Check if node is wet
  758:       idry = (depth + eta2 <= h0);  // XXX Check if we are doing this elsewhere
  759: 
  760:       if (idry) return;
  761: 
  762:       if constexpr(ivcor == 2) {  // SZ coordinates
  763:          
  764:          // Compute bottom level index
  765:          if (depth <= mesh->h_s) {
  766:                kb = mesh->nzlevels;
  767:          } else {
  768:                kb = -1;
  769:                for (int i = 0; i < mesh->kz-1; i++) {
  770:                   if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
  771:                      kb = i;
  772:                      break;
  773:                   }
  774:                }
  775:          }
  776:       } 
  777:       else if (ivcor == 1) {  // Localized sigma
  778:          // Do nothing
  779:       }
  780: 
  781:    }
  782: #endif   
  783: 
  784:    __device__ double compZCoord(int k) const;
  785: 
  786: 
  787: 
  788: };
