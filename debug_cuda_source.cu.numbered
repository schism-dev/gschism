 4910: 
 4911: __global__ void computeMatrixProductAndDotProducts() {
 4912:    // Computes A*p, r'Mr and p'Ap
 4913: 
 4914:    // 1) shared buffer: first half for rMr, second for pAp
 4915:    __shared__ double sdata[2*BLOCK_SIZE];
 4916:    double* s_rMr = sdata;
 4917:    double* s_pAp = sdata + BLOCK_SIZE;
 4918: 
 4919:    // 2) get your node pointer
 4920:    NODE(node);  
 4921:    const int tid = threadIdx.x;
 4922: 
 4923:    const double diag = node->coeffDiag;
 4924:    const double r    = node->mR;
 4925:    const double p    = node->mP;  
 4926: 
 4927:    // apply preconditioner on the fly:
 4928:    const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 4929: 
 4930: 
 4931:    // 4) compute Ap = A.p
 4932:    double Ap = node->coeffDiag * node->mP;
 4933:    for (int j = 0; j < node->numNodes; ++j) {
 4934:       const Node *nbNode = node->nodes[j];
 4935:       Ap += node->coeffMatrix[j] * nbNode->mP;
 4936: 
 4937:    }
 4938:    node->mAp = Ap;
 4939:     
 4940: 
 4941:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 4942:    const double l_rMr = r*Mr;  // r'Mr
 4943:    const double l_pAp = p*Ap;  // p'Ap
 4944: 
 4945:    // 6) write into shared mem
 4946:    s_rMr[tid] = l_rMr;
 4947:    s_pAp[tid] = l_pAp;
 4948: 
 4949: 
 4950:    __syncthreads();
 4951: 
 4952:    // 7) block-wide tree reduction
 4953:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 4954:       if (tid < stride)  s_pAp[tid] += s_pAp[tid + stride];
 4955:       __syncthreads();
 4956:    }
 4957: 
 4958:    // 8) thread 0 atomically accumulates into the globals
 4959:    // XXX: This is slower than it needs to be, but it is simple and works
 4960:    if (tid == 0) atomicAdd(pAp, s_pAp[0]);
 4961: 
 4962: 
 4963: 
 4964: }
 4965: 
 4966: 
 4967: __global__ void updateSolutionAndDotProducts(void) {
 4968:     extern __shared__ double s_rMr[BLOCK_SIZE];       
 4969: 
 4970: 
 4971:     // get node & bounds-check:
 4972:     NODE(node);
 4973:     const int tid = threadIdx.x;
 4974: 
 4975: 
 4976: 
 4977:     // Compute alpha
 4978:     const double alpha = (*rMr_old)/(*pAp);
 4979: 
 4980:     // load scalars
 4981:     const double diag = node->coeffDiag;
 4982:     const double p    = node->mP;
 4983:     const double Ap   = node->mAp;
 4984:     const double x    = node->mX;
 4985:     const double r    = node->mR;
 4986:     
 4987:     assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 4988: 
 4989:     // 1) update solution & residual
 4990:     const double x_new = x + alpha*p;
 4991:     const double r_new = r - alpha*Ap;
 4992:     node->mX = x_new;
 4993:     node->mR = r_new;
 4994: 
 4995:     // 2) apply Jacobi preconditioner on the fly
 4996:     const double Mr_new = r_new/diag;
 4997: 
 4998:     // 3) local contributions for the two dot-products
 4999:     const double l_rMr = r_new*Mr_new;  // r'M^-1r
 5000: 
 5001:     // 4) write into shared-mem
 5002:     s_rMr[tid] = l_rMr;
 5003: 
 5004:     __syncthreads();
 5005: 
 5006: 
 5007:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 5008:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 5009:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 5010:         __syncthreads();
 5011:     }
 5012: 
 5013:     // 6) thread 0 atomically folds into the global accumulators
 5014:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 5015: 
 5016: 
 5017: }
 5018: 
 5019: 
 5020: __global__ void updateSearchDirection() {
 5021:     NODE(node);
 5022: 
 5023:     // recompute z on-the-fly
 5024: // printf("updateSearchDirection: node = %d, coeffDiag = %f, rMr_old = %f, rMr_new = %f\n", node, node->coeffDiag, rMr_old, rMr_new);
 5025:     const double z = node->mR / node->coeffDiag;
 5026:     const double p = node->mP;
 5027: 
 5028:     const double beta = (*rMr_new)/(*rMr_old);
 5029: 
 5030: // printf("ZZZ updateSearchDirection: beta = %f\n", beta);
 5031: 
 5032:     // p =z + beta*p
 5033:     node->mP = z + beta*p;
 5034: 
 5035: }
 5036: 
 5037: __global__ void initializePreconditionedResidual(double *scalars) {
 5038: 
 5039:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 5040: 
 5041:     NODE(node);
 5042:     const int tid = threadIdx.x;
 5043:     // For the first iteration:
 5044:     // 1. Initial solution x = 0 (already set)
 5045:     // 2. Initial residual r = b (stored in qel)
 5046:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 5047: 
 5048: // XXX we should use the guess solution here    
 5049: 
 5050:     // Set initial residual r = b (from qel)
 5051:     node->mR = node->qel;
 5052: 
 5053:     // Compute z = M^-1 * r (preconditioned residual)
 5054:     const double z = node->mR / node->coeffDiag;
 5055: 
 5056:     // Set initial search direction p = z
 5057:     node->mP = z;
 5058: 
 5059:     // Initialize other variables needed for CG
 5060:     node->mX = 0.0;  // Initial solution
 5061:     node->mAp = 0.0; // Will be computed in first iteration
 5062: 
 5063:     // These point to a cupy array in the host code
 5064:     rMr_old = scalars + 0;
 5065:     rMr_new = scalars + 1;
 5066:     pAp     = scalars + 2;
 5067: 
 5068:     // Computes the first r'Mr (reduction)
 5069:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 5070: 
 5071:     // 4) write into shared-mem
 5072:     s_rMr[tid] = l_rMr;
 5073: 
 5074:     __syncthreads();
 5075: 
 5076: 
 5077:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 5078:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 5079:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 5080:         __syncthreads();
 5081:     }
 5082: 
 5083:     // 6) thread 0 atomically folds into the global accumulators
 5084:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 5085: 
 5086:     *rMr_old = 0.0;
 5087:     *pAp = 0.0;
 5088: }
