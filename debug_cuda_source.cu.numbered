 1403: /**
 1404:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1405:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1406:    If the segment is completely inside the element, then it returns true.
 1407: 
 1408:    This function assumes:
 1409:    - The initial point is on a side of the element. 
 1410:    - Its position is given by parameter t in the range [0,1].
 1411:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1412:       intersects the element (elements are convex).
 1413: 
 1414:    To find the intersection point, this function does the following:
 1415:    - it finds the intersection of the line segment with all the element side lines,
 1416:       except for the one that contains the initial point.
 1417:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1418:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1419:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1420:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1421:       track segment is almost parallel to the element side line.
 1422: 
 1423:    Inputs:
 1424:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1425:    @param x2, y2: other end of the line segment
 1426: 
 1427:    Outputs:
 1428:    @param side:  side that intersects the line segment (input and output)
 1429:    @param nextElement (output): element that contains the intersection point
 1430:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1431:    @param zint (input/output): Vertical coordinate of the intersection point
 1432: 
 1433:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1434:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1435:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1436: 
 1437:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1438:    (Delta) being zero.
 1439: 
 1440:    The intersection2 point happens when:
 1441:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1442:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1443:    
 1444:    Assumption: the 4 points (including those of the side segment) are different.
 1445:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1446:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1447:    If true, (xIntersect,yIntersect) is the intersection.				
 1448:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1449: **/
 1450: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1451:                                               double &t, double& tIntersect) {
 1452: 
 1453:    double closest_intersect_t = 1e10;
 1454:    bool found_intersection = false;
 1455: 
 1456:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1457:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1458:    const Point2 x1 = side->point(t);
 1459:    
 1460: 
 1461:    Side *nextSide = nullptr;
 1462:    for (int i = 0; i < i34; i++) {
 1463: 
 1464:       // Element's i-th side 
 1465:       Side *side2 = sides[i];
 1466: 
 1467:       // Skip the side that contains the initial point
 1468:       if (side2 == side) continue;
 1469: 
 1470:       // (x3,y3)-(x4,y4) is the element side line
 1471:       const Point2 x3 = side2->n1->p2();
 1472:       const Point2 x4 = side2->n2->p2();
 1473: 
 1474:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1475:       const double delta = cross(x2 - x1, x3 - x4);
 1476: 
 1477:       if (delta != 0.0) {
 1478: 
 1479:          const double delta1 = cross(x3 - x1, x3 - x4);
 1480:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1481: 
 1482:          // Solves the two linear equations for tt1 and tt2
 1483:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1484:          const double tt2 = delta2/delta;
 1485: 
 1486:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1487:             closest_intersect_t = min(closest_intersect_t, tt1);
 1488:             nextSide = side2;
 1489: 
 1490:             nextElement = nextSide->otherElem(this);
 1491:             tIntersect = max(small, min(tt1, 1.0-small));
 1492:             t = tt2;
 1493: 
 1494:             found_intersection = true;
 1495:          }
 1496:       
 1497:       }
 1498: 
 1499:    }
 1500:    
 1501: printf("AAA 1, found_intersection = %d, nextSide = %p, nextElement = %p\n", found_intersection, nextSide, nextElement);
 1502: 
 1503: 
 1504:    // found_intersection should always be true, since we checked all the sides.  
 1505:    side = nextSide;
 1506: // if (found_intersection) {
 1507: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1508: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1509: // }   
 1510:    // if (!found_intersection) {
 1511:    //    // Check if the segment is parallel to the initial side
 1512:    //    printf("XXX segment: side = %p\n", side);
 1513:    //    printf("XXX %f\n", dot(x2 - x1, side->n1->p2() - side->n2->p2()));
 1514:    //    if (abs(dot(x2 - x1, side->n1->p2() - side->n2->p2())) < small) {
 1515:    //       assert(false && "Segment is parallel to the initial side");
 1516:    //       found_intersection = true;
 1517:    //       nextElement = side->otherElem(this);
 1518:    //       tIntersect = t;
 1519:    //       t = 0.0;
 1520:    //       found_intersection = true;
 1521:    //    }
 1522:    // }
 1523:    return found_intersection;
 1524: }
