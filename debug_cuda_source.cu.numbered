 1128: // Helper functions for computing the local node index at a given offset from another.
 1129: __device__ __inline__ int nxq(int offset, int index, int size) {
 1130:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1131:    // to the index to make it positive
 1132:    assert(index + offset + 16*size >= 0);
 1133:    return (index + offset + 16*size) % size;  
 1134: }
 1135: 
 1136: __device__ __inline__ int nxq(int index, int size) {
 1137:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1138:    // to the index to make it positive
 1139:    assert(index + 16*size >= 0);
 1140:    return (index + 16*size) % size; 
 1141: }
