 1550: 
 1551: __inline__ __device__ double Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 1552: __inline__ __device__ double Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 1553: __inline__ __device__ Point2 Side::p_t(double t) const { return {x(t), y(t)}; }
 1554: __inline__ __device__ int    Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 1555: __inline__ __device__ double Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 1556: 
 1557: __inline__ __device__ double Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 1558: __inline__ __device__ double Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 1559: 
 1560: __inline__ __device__ double Side::Cd(void)      const { if constexpr(nchi != 0) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 1561: 
 1562: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 1563: 
 1564: /**
 1565:  * This method performs backtracking from the side center until a time -dt back in time 
 1566:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 1567:  * intermediate point.
 1568:  *
 1569:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 1570:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 1571:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 1572:  * remaining time.
 1573:  * 
 1574:  * NOTE: Runge-Kutta is not implemented yet. XXX
 1575:  * 
 1576:  * @param uuint, vvint, wwint: Velocities at the final point
 1577:  * @param jlev: Level at which the backtracking is performed
 1578:  * @param dt, dtbk: Tracking timesteps
 1579:  * @param sclr: Array for backtracked values
 1580:  * @return: True if the backtracking was successful, false otherwise
 1581:  */
 1582: __inline__ __device__ bool Side::btrack(
 1583:       int jlev,
 1584:       double dt,            // Tracking time
 1585:       double dtbk,          // Tracking timestep
 1586:       double* sclr,         // Array for backtracked values
 1587:       Vector3 &u_int
 1588: ) const {
 1589: 
 1590:    // Start from side center
 1591:    Point3 x0 = {center.x, center.y, zc[jlev]};
 1592:  
 1593: 
 1594:    double time_rm = dt; // Remaining time
 1595: 
 1596: 
 1597:    // // Initialize outputs
 1598:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 1599:    //    sclr[i] = 0.0;
 1600:    // }
 1601: 
 1602: 
 1603:    // Initial velocities
 1604:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 1605: 
 1606:    // Find the element that is in the direction opposite to the velocity
 1607:    Element* curElem = findElementTowards({u_int.x, u_int.y});
 1608: 
 1609: printf("$$$  %d, %d, %.5f, %.5f\n",  curElem->idx,idx, x0.x, x0.y)   ;
 1610:    const int MAX_ITERATIONS = 100000; // XXX 1000
 1611:    Element* nextElem = curElem;
 1612:    int iter = 0;
 1613:    while(true) {
 1614:       // Calculate timestep
 1615:       double dtb = min(dtbk, time_rm);
 1616: 
 1617:       // Next point in the backtracking curve
 1618:       Point3 xt = x0 - dtb*u_int;
 1619: 
 1620:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb);
 1621:       assert(found && "Backtracking failed in btrack");
 1622: // printf("<>T = %f, %f %f %f\n", time_rm - dtb, xt, yt, zt);
 1623:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 1624:                       // then time_rm needs to be increased by the unused time.
 1625: 
 1626: 
 1627:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 1628: 
 1629:       // The current point becomes the next segment's starting point.
 1630:       x0 = xt;
 1631:  
 1632:       curElem = nextElem;
 1633: 
 1634:       iter++;
 1635:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 1636:    }
 1637: 
 1638: 
 1639: }
 1640: 
 1641: 
 1642: 
 1643: // /**
 1644: //    For a point (x1,y1) inside the element and a line segment (x1,y1)-(x2,y2), find the intersection point 
 1645: //    (xIntersect,yIntersect) and the side (intersectingSide) that it intersects.
 1646: 
 1647: //    Inputs:
 1648: //    @param x1, y1: point inside the element
 1649: //    @param x2, y2: other end of the line segment
 1650: 
 1651: //    Outputs:
 1652: //    @param intersectingSide:  side that intersects the line segment
 1653: //    @param nextElement: element that contains the intersection point
 1654: //    @param xIntersect, yIntersect: intersection point  
 1655: 
 1656: //    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1657: //    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1658: //    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1659: 
 1660: //    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1661: //    (Delta) being zero.
