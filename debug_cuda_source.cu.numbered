  333: struct Element {
  334: 
  335:    // Geometry information
  336:    int idx;               // Index of the element
  337:    int i34;               // Number of sides for the element 
  338:    Side *sides[4];        // Sides of the element
  339:    Node *nodes[4];        // Nodes of the element
  340:    Element *nghbElems[4]; // Neighbors of the element
  341: 
  342:    int kb;                    // Bottom index of the element
  343:    double area;               // Area of the element
  344:    double ssign[4];           // Sign associated with each side of an element
  345:    double radius;             // Element equivalent radii
  346: 
  347:    double wind_angle;         // Wind rotation angle
  348: 
  349:    Frame frame;
  350: 
  351:    Vector2 gradPhi[4];       // Derivatives of shape functions
  352:    Vector2 gradEta[nvrt];    // Gradient of free surface elevation
  353: 
  354:    int idry;                  // True if the element is dry
  355:    int kbe;                   // Bottom index of the element
  356: 
  357:    Vector3 center;            // Element center coordinates
  358:    double xlon_el, ylat_el;   // Element center lat/lon coordinates in _degrees_
  359:    double depth;              // Depth at element (min of all nodes)
  360:    double z[nvrt];            // z-coord  (local frame - vertical up)
  361: 
  362:    // Physical information
  363:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  364: 
  365:    static const bool isblock = false;              // Always false
  366: 
  367:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  368:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  369: 
  370:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  371: 
  372:    
  373: 
  374:    double vsource;            // Volumetric source/sink term [m^3/s]
  375: 
  376:    double rho[nvrt];          // Density at each prism center
  377:    double rho_mean[nvrt];     // Mean density at each prism center
  378:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  379:    double rho_z[nvrt];        // First derivative of density at each prism center
  380:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  381: 
  382:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  383: 
  384:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  385:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  386: 
  387:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 1; }
  388:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 1; }
  389: 
  390:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  391:    __inline__ __device__ int nodeLocalIdx(Node *node) const { 
  392:       int res = (nodes[0] == node) ? 0 : ((nodes[1] == node) ? 1 : ((nodes[2] == node) ? 2 : 3)); 
  393:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  394:       return res;
  395:    }
  396: 
  397:    __inline__ __device__ int findLevel(double z1, int k) const {
  398:       // Starting at index k, find sequentially the level that contains z
  399: 
  400:       // if z is already betweeen z[k] and z[k+1], return k
  401:       if (z1 >= z[k] && z1 < z[k+1]) return k;
  402:       else if (z1 < z[k]) { 
  403:          // Search for increasing levels
  404:          for (int kk = k; kk < nvrt - 1; kk++) {
  405:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  406:          }
  407:          return nvrt - 1;
  408:       }
  409:       else {
  410:          // Search for decreasing levels
  411:          for (int kk = k; kk > 0; kk--) {
  412:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  413:          }
  414:          return 0;
  415:       }
  416:    }
  417: 
  418:    __inline__ __device__ double z_prism(int k) const { return 0.5*(z[k+1] + z[k]); }
  419:    __inline__ __device__ double Dz(int k)      const { return z[k+1] - z[k]; }
  420: 
  421:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  422: 
  423:    __inline__ __device__ double computeSignedArea(void) const;
  424: 
  425:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  426:       // Nudges the point (x,y) to the barycenter of the element
  427:       p = (1-eps)*p + eps*toVector2(center);
  428:    }
  429: 
  430:    __device__ bool computeShapeCoords(Point2 xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  431: 
  432:    __device__ Vector2 grad(double *a) const
  433:    {
  434:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  435:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  436:       if (isQuad()) {
  437:          gx += a[3]*gradPhi[3].x;
  438:          gy += a[3]*gradPhi[3].y;
  439:       }
  440:       return {gx, gy};
  441:    }
  442: 
  443:    __device__ void setFrame(void) {
  444: 
  445:       double ar1, ar2;
  446:       computeLonLat(center, ar1, ar2);
  447: 
  448:       frame.update(ar1, ar2);        
  449:     }
  450: 
  451:    __device__ bool findNextIntersection(Point2 x2, Side *&side, Element *&nextElement, double &t, 
  452:                                         double& tIntersect);
  453:    __device__ bool findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement, double &t, 
  454:                                         double& tIntersect);
  455: 
  456:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  457:       // Check if the point (xt,yt) is inside the element
  458:       double shpCoords[4];
  459:       bool res = computeShapeCoords(xt, shpCoords, false);
  460:       return res;
  461:    }
  462: 
  463:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4])
  464:    {
  465:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  466:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  467:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  468:       
  469:    }
  470: 
  471:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int);
  472: 
  473:    // ------------------------------------------------------------------------------------------------
  474:    // These are functions that work on all nodes of the element.
  475:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  476:    //
  477:    // An example of how to use these functions is:
  478:    //   
  479:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  480:    // 
  481:    // Where L is the level at which the field is to be interpolated. The field can be either
  482:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  483:    // There are different versions of getNodalValues for each of these cases.
  484: 
  485:    template<typename T>
  486:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  487:       // Get the values of the field at the nodes of the element
  488:       res[0] = nodes[0]->*field;
  489:       res[1] = nodes[1]->*field;
  490:       res[2] = nodes[2]->*field;
  491:       if (isQuad()) res[3] = nodes[3]->*field;
  492:       else          res[3] = T();
  493:    }
  494: 
  495:    template<typename T>
  496:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  497:       // Get the values of the field at the nodes of the element
  498:       res[0] = (nodes[0]->*field)[level];
  499:       res[1] = (nodes[1]->*field)[level];
  500:       res[2] = (nodes[2]->*field)[level];
  501:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  502:       else          res[3] = T();
  503:    }    
  504: 
  505:    template<typename T>
  506:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  507:       // Get the values of the func at the nodes of the element
  508:       res[0] = (nodes[0]->*func)(level);
  509:       res[1] = (nodes[1]->*func)(level);
  510:       res[2] = (nodes[2]->*func)(level);
  511:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  512:       else          res[3] = T();  // This is 0.0 or a zero vector
  513: 
  514:    }      
  515: 
  516:    template<typename T>
  517:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  518:       // Get the values of the field at the nodes of the element
  519:       res[0] = sides[0]->*field;
  520:       res[1] = sides[1]->*field;
  521:       res[2] = sides[2]->*field;
  522:       if (isQuad()) res[3] = sides[3]->*field;
  523:       else          res[3] = T();
  524:    }
  525: 
  526:    template<typename T>
  527:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  528:       // Get the values of the field at the nodes of the element
  529:       res[0] = (sides[0]->*field)[level];
  530:       res[1] = (sides[1]->*field)[level];
  531:       res[2] = (sides[2]->*field)[level];
  532:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  533:       else          res[3] = T();
  534:    }    
  535: 
  536:    template<typename T>
  537:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  538:       // Get the values of the func at the nodes of the element
  539:       res[0] = (sides[0]->*func)(level);
  540:       res[1] = (sides[1]->*func)(level);
  541:       res[2] = (sides[2]->*func)(level);
  542:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  543:       else          res[3] = T();  // This is 0.0 or a zero vector
  544: 
  545:    }      
  546: 
  547: 
  548:    __device__ double interpolate(int level, const double shapeCoords[4], double (Node::*func)(int) const) const {
  549:       double values[4];
  550:       getNodalValues(level, func, values);
  551: 
  552:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  553:    }
  554: 
  555:    template<typename T>
  556:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  557:       T values[4];
  558:       getNodalValues(field, values);
  559:       
  560:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  561:    }
  562: 
  563: 
  564:    template<typename T>
  565:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  566:       T values[4];
  567:       getNodalValues(level, field, values);
  568: 
  569:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  570:    }
  571: 
  572:    template<typename T>
  573:    __device__ T mean(T Node::* field) const {
  574:       T values[4];
  575:       getNodalValues(field, values);
  576: 
  577:       return (values[0] + values[1] + values[2] + values[3])/i34;
  578:    }
  579: 
  580:    template<typename T>
  581:    __device__ T mean(T Side::* field) const {
  582:       T values[4];
  583:       getSideValues(field, values);
  584:       
  585:       return (values[0] + values[1] + values[2] + values[3])/i34;
  586:    }   
  587: 
  588:    // __device__ double mean(double (Node::*func)(int) const) const {
  589:    //    double values[4];
  590:    //    getNodalValues(level, func, values);
  591:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  592:    // }
  593:    // ------------------------------------------------------------------------------------------------
  594: 
  595:    __device__ bool globalToLocal(double xt, double yt, double &xlocal, double &ylocal) const {
  596:       // Convert global coordinates to local coordinates
  597:       printf("NOT IMPLEMENTED: globalToLocal\n");
  598:       return true;
  599:    }
  600: 
  601:    __inline__ __device__ bool localToGlobal(double xlocal, double ylocal, double &xt, double &yt) const {
  602:       // Convert local coordinates to global coordinates
  603:       printf("NOT IMPLEMENTED: localToGlobal\n");
  604:       return true;
  605:    }
  606: 
  607:    __device__ void trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
  608:                                        double &dt, Point3 &xt, double zint, Vector3 &u_int);
  609:     
  610:    __device__ bool trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
  611:                                                  Element *&nextElem, int &jlev, double &dt);
  612: 
  613: };
