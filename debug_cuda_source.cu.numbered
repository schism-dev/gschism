 1999: __host__ __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2000: 
 2001: __device__ double Node::compZCoord(int k) const {
 2002:    // Computes the z coordinate at level k.
 2003:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2004:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2005:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2006:    // used 
 2007:    
 2008:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2009:       
 2010:    if (isDry)  return 0.0;
 2011: 
 2012:    if constexpr(ivcor == 2) {
 2013: 
 2014:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2015:       const int kz = mesh->kz;
 2016: 
 2017:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2018:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2019:       // once per time step/node.
 2020:       // CHECK: updateZCoordData
 2021:       if (k == kz)               return -hmod2;
 2022:       else if (k == nvrt-1)      return eta2;
 2023:       else if (k == kb)          return -depth;
 2024:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2025:       else if (k > kz) {
 2026:          const int ksig = k - kz + 1;
 2027: 
 2028:          if (hmod2 <= mesh->h_c) {
 2029:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2030:          } 
 2031:          else if (eta2 <= - mesh->h_c - (depth - mesh->h_c) * mesh->theta_f/mesh->sinh_theta_f) {
 2032:             printf("Please choose larger h_c: %f %f\n", eta2, mesh->h_c);
 2033:             Error("ZCOOR: invalid h_c\n");
 2034:          } 
 2035:          else {
 2036:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2037:                          mesh->h_c * mesh->sigma[ksig] + 
 2038:                          (hmod2 - mesh->h_c) * mesh->cs[ksig];
 2039:          }
 2040:       } else { 
 2041:          Error("ZCOOR: invalid level or coordinate system\n");
 2042:       }
 2043: 
 2044:    }
 2045:    else if constexpr(ivcor == 1) {
 2046:       if (k == kb) return -depth;
 2047:       else if (k == nvrt-1) return eta2;
 2048:       else if (k >= kb) {
 2049:             return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2050:       }
 2051:    }
 2052:    
 2053:    printf("ZCOOR: invalid level or coordinate system\n");
 2054:    return 0.0;
 2055: }
