  694:    int iadv;     // Advection flag
  695: 
  696:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
  697: 
  698:    // Physical information
  699:    Tracers tr_nd0[nvrt]; // Initial tracer conc. at nodes
  700: 
  701:    double rho[nvrt];     // Density
  702: 
  703:    double eta1; // Elevation at nodes at previous timestep
  704:    double eta2; // Elevation at nodes at current timestep
  705: 
  706:    
  707:    double pr;    // Air pressure
  708:    double grav2; // Gravity 
  709:    double hhat;  // \breve{H} in notes
  710: 
  711:    Vector2 dav;  // Depth averaged velocity
