 1227: 
 1228: /**
 1229:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1230:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1231:    If the segment is completely inside the element, then it returns true.
 1232: 
 1233:    This function assumes:
 1234:    - The initial point is on a side of the element. 
 1235:    - Its position is given by parameter t in the range [0,1].
 1236:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1237:       intersects the element (elements are convex).
 1238: 
 1239:    To find the intersection point, this function does the following:
 1240:    - it finds the intersection of the line segment with all the element side lines,
 1241:       except for the one that contains the initial point.
 1242:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1243:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1244:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1245:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1246:       track segment is almost parallel to the element side line.
 1247: 
 1248:    Inputs:
 1249:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1250:    @param x2, y2: other end of the line segment
 1251: 
 1252:    Outputs:
 1253:    @param side:  side that intersects the line segment (input and output)
 1254:    @param nextElement (output): element that contains the intersection point
 1255:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1256:    @param zint (input/output): Vertical coordinate of the intersection point
 1257: 
 1258:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1259:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1260:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1261: 
 1262:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1263:    (Delta) being zero.
 1264: 
 1265:    The intersection2 point happens when:
 1266:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1267:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1268:    
 1269:    Assumption: the 4 points (including those of the side segment) are different.
 1270:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1271:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1272:    If true, (xIntersect,yIntersect) is the intersection.				
 1273:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1274: **/
 1275: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1276:                                               double &t, double& tIntersect) {
 1277: 
 1278:    double closest_intersect_t = 1e10;
 1279:    bool found_intersection = false;
 1280: 
 1281:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1282:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1283:    const Point2 x1 = side->point(t);
 1284:    
 1285: 
 1286:    Side *nextSide = nullptr;
 1287: 
 1288:    for (int i = 0; i < i34; i++) {
 1289: 
 1290:       // Element's i-th side 
 1291:       Side *side2 = sides[i];
 1292: 
 1293:       // Skip the side that contains the initial point
 1294:       if (side2 == side) continue;
 1295: 
 1296:       // (x3,y3)-(x4,y4) is the element side line
 1297:       const Point2 x3 = side2->n1->p2();
 1298:       const Point2 x4 = side2->n2->p2();
 1299: 
 1300:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1301:       const double delta = cross(x2 - x1, x3 - x4);
 1302: 
 1303:       if (delta != 0.0) {
 1304: 
 1305:          const double delta1 = cross(x3 - x1, x3 - x4);
 1306:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1307: 
 1308:          // Solves the two linear equations for tt1 and tt2
 1309:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1310:          const double tt2 = delta2/delta;
 1311: 
 1312:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1313:             closest_intersect_t = min(closest_intersect_t, tt1);
 1314:             nextSide = side2;
 1315: 
 1316:             nextElement = nextSide->otherElem(this);
 1317:             tIntersect = max(small, min(tt1, 1.0-small));
 1318:             t = tt2;
 1319: 
 1320:             found_intersection = true;
 1321:          }
 1322:       
 1323:       }
 1324: 
 1325:    }
 1326: 
 1327: 
 1328:    // found_intersection should always be true, since we checked all the sides.  
 1329:    side = nextSide;
 1330: // if (found_intersection) {
 1331: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1332: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1333: // }   
 1334:    return found_intersection;
 1335: }
 1336: 
 1337: 
 1338: 
 1339: 
 1340: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1341:                                               double &t, double& tIntersect) {
 1342: 
 1343:    double closest_intersect_t = 1e10;
 1344:    bool found_intersection = false;
 1345: 
 1346:    for (int i = 0; i < i34; i++) {
 1347: 
 1348:       Side *side2 = sides[i];
 1349: 
 1350:       // (x3,y3)-(x4,y4) is the element side line
 1351:       const Point2 x3 = side2->n1->p2();
 1352:       const Point2 x4 = side2->n2->p2();
 1353: 
 1354:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1355:       const double delta = cross(x2 - x1, x3 - x4);
 1356: 
 1357:       if (delta != 0.0) {
 1358: 
 1359:          const double delta1 = cross(x3 - x1, x3 - x4);
 1360:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1361: 
 1362:          // Solves the two linear equations for tt1 and tt2
 1363:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1364:          const double tt2 = delta2/delta;
 1365: 
 1366:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1367:             closest_intersect_t = min(closest_intersect_t, tt1);
 1368:             side = side2;
 1369:             nextElement = side->otherElem(this);
 1370:             t = tt2;
 1371:             tIntersect = max(small, min(tt1, 1.0-small));
 1372:             found_intersection = true;
 1373:          }
 1374:       
 1375:       }
 1376: 
 1377:    }
 1378: 
 1379: // if (found_intersection) {
 1380: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1381: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1382: // }
 1383: 
 1384:    // found_intersection should always be true, since we checked all the sides.  
 1385:    return found_intersection;
 1386: }
 1387: 
 1388: 
 1389: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1390:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1391: 
 1392:    printf("Tracking segment goes out of water at element %d\n", curElem->idx);
 1393: 
 1394:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1395:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1396:    // curElement.
 1397: 
 1398:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1399:    // And uses this velocity instead to continue the tracking.
 1400: 
 1401:    // computes the intersection point in cartesian coordinates
 1402:    Point2 intersection = nextSide->p_t(tt);
 1403: 
 1404:    // Nudges the point to the barycenter of the element. 
 1405:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1406:    // next segment intersects the element sides.  
 1407:    curElem->nudgeToBarycenter(intersection);
 1408: 
 1409:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1410:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1411:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1412:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1413: 
 1414:    // If the side is an open boundary, the tangential velocity is zero.
 1415:    if (nextSide->isBnd()) vtan = 0.0;
 1416: 
 1417:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1418:    const double us = vtan*nextSide->t().x;
 1419:    const double vs = vtan*nextSide->t().y;
 1420:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1421: 
 1422:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1423:    const double len2 = length(intersection - toPoint2(xt));
 1424:    const double vel2 = u_int.x*u_int.x + u_int.y*u_int.y;        
 1425:    assert(vel2 > 0.0 && "Zero velocity found");
 1426:    dt = dt - sqrt(len2/vel2); 
 1427: 
 1428:    // The end of this tracking segment is now the intersection point.
 1429:    xt = {intersection.x, intersection.y, zint};
 1430:    
 1431:    u_int = {us, vs, ws};
 1432:    
 1433: }
 1434: 
 1435: /**
 1436:  * Tracks a particle through elements and vertical levels in the mesh.
 1437:  * 
 1438:  * @param x0,y0,z0     Starting position coordinates
 1439:  * @param xt,yt,zt     Target position coordinates
 1440:  * @param dtb          Time step for tracking
 1441:  * @param uuint,vvint,wwint Initial velocity components
 1442:  * @param nextElem     Starting/resulting element index
 1443:  * 
 1444:  * @return Status code of type trackExitCodes
 1445:  * 
 1446:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1447:  * of the details are different. The idea is that the code requires less branches and is better fit
 1448:  * for GPU execution.
 1449:  * 
 1450:  * The main ideas here are:
 1451:  * - The starting point is expected to be in the starting element.
 1452:  * - The end point is guaranteed to be inside an element.
 1453:  * - since the starting point is inside the element, there are only two cases: 
 1454:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1455:  *     (b) it does not and (xt,yt) is already in the starting element.
 1456:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1457:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1458:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1459:  * - tt1 can be positive or negative. We only consider the positive values.
 1460:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1461:  * - The next intersection will occur at the smallest positive tt1.
 1462:  * - This intersection will be the next (x0,y0) position.
 1463:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1464:  *   of getting stuck in a loop.
 1465:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1466:  *   was found.
 1467:  */
 1468: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1469:                                                        Element *&nextElem, int &jlev, double &dt) {
 1470: 
 1471:    // First thing is to check if the target point is inside the element. If it is there is nothing
 1472:    // else to do.
 1473:    if (containsPoint(toPoint2(xt))) {
 1474:       nextElem->interpolateVelocities(xt, u_int);
 1475:       return true;
 1476:    }
 1477: 
 1478:    Side *side = nullptr;
 1479: 
 1480:    // 1. Initial checks
 1481:    // Verify starting element is valid (wet)
 1482:    assert(!nextElem->idry && "Starting element is dry");
 1483: 
 1484:    // Checks if track has a zero length.
 1485:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1486:    assert(len2 > 0.0 && "Zero length track"); 
 1487:    
 1488: 
 1489:    const int MAX_ITERATIONS = 1000;
 1490:    
 1491:    double t;
 1492:    Side *nextSide = nullptr;
 1493:    double tIntersect = 1e10;
 1494:    double zint = x0.z;
 1495: 
 1496:    // Horizontal tracking loop
 1497:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1498:    // (x0,y0) is inside the element but the target point is not.
 1499:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1500:    assert(found_intersection && "No intersection found");
 1501: 
 1502:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1503: 
 1504:    // if the tracking segment goes out of water (either dry or edge boundary)
 1505:    if (isEdgeBoundary(nextSide) || (nextElem->idry)) {
 1506:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1507:       nextElem = this;
 1508:       
 1509:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1510:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1511:       return true;    
 1512:       }
 1513: 
 1514:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1515:    int iterations = 0;
 1516:    while (iterations < MAX_ITERATIONS) {
 1517:       iterations++;
 1518:       
 1519:       Element *curElem = nextElem;
 1520: 
 1521:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1522:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1523: 
 1524:       // If we are already in the target element, we are done.
 1525:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1526:       if (!found_intersection) break;
 1527: 
 1528: 
 1529:   
 1530:       // if the tracking segment goes out of water (either dry or edge boundary).
 1531:       if (curElem->isEdgeBoundary(nextSide) || (nextElem->idry)) {
 1532: 
 1533:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1534: 
 1535:          nextElem = curElem;
 1536: 
 1537:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1538:          // In this case, the caller (btrack) needs to take into account the remaining time.
 1539:          return true;
 1540:       }
 1541:       
 1542:       // Update position and element for next iteration
 1543:       side = nextSide;
 1544: 
 1545:    }
 1546: 
 1547: 
 1548:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 1549: 
 1550:  
 1551:    // Interpolate velocities at the final position. This is a conceptually simple step,
 1552:    // but the function is not simple, because it has to search for the vertical level containing zt.
 1553:    nextElem->interpolateVelocities(xt, u_int);
 1554: 
 1555: 
 1556:    return true;
 1557: }
 1558: 
 1559: 
 1560: 
 1561: 
 1562: __inline__ __device__ double Element::computeSignedArea(void) const {
 1563:    // Compute the area of the element
 1564: 
 1565:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 1566: 
 1567:    // In the quad case we need to add the area of the other triangle.
 1568:    if (isQuad()) {
 1569:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1570:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 1571:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1572:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 1573:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 1574:          Error("Negative area found in quad element");
 1575:       }
 1576:       res += ar1;
 1577:    }
 1578: 
 1579:    return res;
 1580: }
 1581: 
 1582: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 1583:    // In boundary sides, the element 1 is nullptr
 1584:    return side->elems[1] == nullptr; 
 1585: }
 1586: 
 1587: /**
 1588:    Compute the shape coordinates of the point (xt,yt) in the element.
 1589:    @param xt (input): x-coordinate of the point
 1590:    @param shpCoords (output): shape coordinates of the point
 1591:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 1592:    @return true if the point is inside the element, false otherwise
 1593: **/
 1594: __device__ bool Element::computeShapeCoords(Point2 xt, double shpCoords[4],
 1595:                                             bool fixNegshpCoord) const {
 1596: 
 1597:    // Compute the shape coordinates of the point xt in the element.
 1598:    if (i34==3) {
 1599:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 1600:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 1601:       // and in this case, the pt will be nudged into the element
 1602:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 1603:       // from the local frame, so use additional check.
 1604: 
 1605:       Point2 x0, x1, x2;
 1606: 
 1607:       if constexpr(ics==1) {
 1608:          x0 = nodes[0]->p2();
 1609:          x1 = nodes[1]->p2();
 1610:          x2 = nodes[2]->p2();
 1611:       }
 1612:       else // lat/lon
 1613:       {
 1614:          Error("Not implemented yet");
 1615: #ifdef ICS2
 1616:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 1617:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 1618:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 1619: #endif
 1620:       }
 1621: 
 1622:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 1623:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 1624:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 1625:       shpCoords[3] = 0.0;
 1626:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 1627: 
 1628:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 1629:       // then we fix the negative shape coordinates.
 1630:       if (fixNegshpCoord && tmpmin<=0.0) {
 1631: 
 1632:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 1633:          // keeping the sum of the shape coordinates equal to 1.
 1634:          // I have tested and compared the new algorithm with the old one, and they give
 1635:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 1636:          // The new algorithm should be faster since it is branchless.
 1637:          const double a = - tmpmin + 1.0e-2;  // XXX it used to be 1.0e-4 in the comments of the original code
 1638:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 1639:          
 1640:          shpCoords[0] = (shpCoords[0] + a)*b;
 1641:          shpCoords[1] = (shpCoords[1] + a)*b;
 1642:          shpCoords[2] = (shpCoords[2] + a)*b;          
 1643: 
 1644:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 1645:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 1646:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 1647:          }
 1648: 
 1649:          // Update the point coordinates for the new shape coordinates
 1650:          double xcoords[3] = {x0.x, x1.x, x2.x};
 1651:          double ycoords[3] = {x0.y, x1.y, x2.y};
 1652:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 1653: 
 1654:       }
 1655: 
 1656:       // Check if the point is inside the element
 1657:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 1658:    }
 1659:    else {
 1660:       Error("Not implemented yet");
 1661: #ifdef QUADS
 1662:       // Reproject pt in eframe of nel for ics=2
 1663:       if constexpr(ics==1) {
 1664:          xn2 = xt; 
 1665:          yn2 = yt;
 1666:       }
 1667:       else {
 1668:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 1669:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 1670:       }
 1671: 
 1672:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 1673: #endif
 1674:    }
 1675: 
 1676: }
 1677: 
 1678: 
 1679: /**  Interpolate velocities at a given point (xt,yt,zt)
 1680: 
 1681:    @param xt, yt, zt: coordinates of the point to interpolate
 1682:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 1683: 
 1684:    This is done in four steps:
 1685: 
 1686:    1. Find the shape coordinates for the final position in the element.
 1687:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 1688:    3. Perform a *binary search* to find the vertical level containing zt. It will have to interpolate the 
 1689:       z levels at xt, yt at each step.   
 1690:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 1691:       horizontally and vertically.
 1692: **/
 1693: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) {
 1694:    // Interpolate the velocities at the point xt. 
 1695:    // This function works the same for triangular and quadrilateral elements.
 1696:    double shpCoord[4];
 1697: 
 1698: 
 1699:    // First step is to compute the shape coordinates of (xt,yt)
 1700:    computeShapeCoords(toVector2(xt), shpCoord, false);
 1701:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 1702: 
 1703:    // Second step is to find the level that contains zt
 1704:    // Uses a binary search to find the level
 1705:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 1706:    int L = kbe;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 1707:    int R = nvrt - 1;
 1708: 
 1709:    // Get the z coordinates at the nodes of the element at the levels L and R
 1710:    double zLAtNodes[4], zRAtNodes[4];
 1711:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 1712:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 1713: 
 1714:    double zL = interpolate(shpCoord, zLAtNodes);
 1715:    double zR = interpolate(shpCoord, zRAtNodes);
 1716:    
 1717:    // Interpolates vertically the velocities
 1718:    double wght1, wght2;
 1719:    if (xt.z<=zL) {
 1720:       wght1 = 1.0;
 1721:       wght2 = 0.0;
 1722:    }
 1723:    else if (xt.z>=zR) {
 1724:       wght1 = 0.0;
 1725:       wght2 = 1.0;
 1726:    }
 1727:    else {
 1728:       // Perform a binary search to find the levels between L and R that contain xt.z
 1729:       while (R - L > 1) {
 1730:          int M = (L + R) / 2;
 1731: 
 1732:          double zMAtNodes[4];
 1733:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 1734:          double zM = interpolate(shpCoord, zMAtNodes);
 1735:          if (zM < xt.z) 
 1736:          {
 1737:             L = M;
 1738:             zL = zM;
 1739:          }
 1740:          else 
 1741:          {
 1742:             R = M;
 1743:             zR = zM;
 1744:          }
 1745:       }
 1746:       assert(L == R-1);
 1747:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 1748: 
 1749:       wght2 = (xt.z - zL)/(zR - zL);
 1750:       wght1 = 1.0 - wght2;
 1751:    }
 1752: // printf("$$$ wght1 = %f, wght2 = %f, zt = %f, zL = %f, zR = %f\n", wght1, wght2, zt, zL, zR);
 1753: // printf("$$$ shpCoord = %f, %f, %f, %f\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 1754:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 1755:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 1756: 
 1757:    // Neither of the interpolated velocities should be NaN
 1758:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 1759: 
 1760: }
 1761: 
 1762: 
 1763: 
 1764: __inline__ __device__ double Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 1765: __inline__ __device__ double Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 1766: __inline__ __device__ Point2 Side::p_t(double t) const { return {x(t), y(t)}; }
 1767: __inline__ __device__ int    Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 1768: __inline__ __device__ double Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 1769: 
 1770: __inline__ __device__ double Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 1771: __inline__ __device__ double Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 1772: __inline__ __device__ double Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 1773: 
 1774: 
 1775: __inline__ __device__ double Side::Cd(void)      const { if constexpr(nchi != 0) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 1776: 
 1777: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 1778: 
 1779: /**
 1780:  * This method performs backtracking from the side center until a time -dt back in time 
 1781:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 1782:  * intermediate point.
 1783:  *
 1784:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 1785:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 1786:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 1787:  * remaining time.
 1788:  * 
 1789:  * NOTE: Runge-Kutta is not implemented yet. XXX
 1790:  * 
 1791:  * @param uuint, vvint, wwint: Velocities at the final point
 1792:  * @param jlev: Level at which the backtracking is performed
 1793:  * @param dt, dtbk: Tracking timesteps
 1794:  * @param sclr: Array for backtracked values
 1795:  * @return: True if the backtracking was successful, false otherwise
 1796:  */
 1797: __inline__ __device__ bool Side::btrack(
 1798:       int jlev,
 1799:       double dt,            // Tracking time
 1800:       double dtbk,          // Tracking timestep
 1801:       double* sclr,         // Array for backtracked values
 1802:       Vector3 &u_int
 1803: ) const {
 1804: 
 1805:    // Start from side center
 1806:    Point3 x0 = {center.x, center.y, zc[jlev]};
 1807:  
 1808: 
 1809:    double time_rm = dt; // Remaining time
 1810: 
 1811: 
 1812:    // // Initialize outputs XXX
 1813:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 1814:    //    sclr[i] = 0.0;
 1815:    // }
 1816: 
 1817: 
 1818:    // Initial velocities
 1819:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 1820: 
 1821:    // Find the element that is in the direction opposite to the velocity
 1822:    Element* curElem = findElementTowards({u_int.x, u_int.y});
 1823: 
 1824: 
 1825:    const int MAX_ITERATIONS = 1000; 
 1826:    Element* nextElem = curElem;
 1827:    int iter = 0;
 1828:    while(true) {
 1829:       // Calculate timestep
 1830:       double dtb = min(dtbk, time_rm);
 1831: 
 1832:       // Next point in the backtracking curve
 1833:       Point3 xt = x0 - dtb*u_int;
 1834: 
 1835:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb);
 1836:       assert(found && "Backtracking failed in btrack");
 1837: // printf("<>T = %f, %f %f %f\n", time_rm - dtb, xt, yt, zt);
 1838:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 1839:                       // then time_rm needs to be increased by the unused time.
 1840: 
 1841: 
 1842:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 1843: 
 1844:       // The current point becomes the next segment's starting point.
 1845:       x0 = xt;
 1846:  
 1847:       curElem = nextElem;
 1848: 
 1849:       iter++;
 1850:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 1851:    }
 1852: 
 1853: 
 1854: }
 1855: 
 1856: 
 1857: 
 1858: // /**
 1859: //    For a point (x1,y1) inside the element and a line segment (x1,y1)-(x2,y2), find the intersection point 
 1860: //    (xIntersect,yIntersect) and the side (intersectingSide) that it intersects.
 1861: 
 1862: //    Inputs:
 1863: //    @param x1, y1: point inside the element
 1864: //    @param x2, y2: other end of the line segment
 1865: 
 1866: //    Outputs:
 1867: //    @param intersectingSide:  side that intersects the line segment
 1868: //    @param nextElement: element that contains the intersection point
 1869: //    @param xIntersect, yIntersect: intersection point  
 1870: 
 1871: //    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1872: //    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1873: //    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1874: 
 1875: //    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1876: //    (Delta) being zero.
