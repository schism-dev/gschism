 3037:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3038: 
 3039:       NODE_BND(nodeBnd);
 3040: 
 3041:       Node *node = nodeBnd->node;
 3042: 
 3043:       printf("computeTidalPotential: nodeIdx = %d, ntip = %d\n", node->idx, ntip);
 3044:       node->ETP = 0.0;
 3045: 
 3046:       for (int j=0; j<ntip; j++) {
 3047: 
 3048:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3049:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3050:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3051: 
 3052:          if constexpr(iloadtide==1) { // loading tide
 3053:             assert(true && "Loading tide not implemented");
 3054:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3055:          }
 3056:          
 3057:       }
 3058:       
 3059:    }
