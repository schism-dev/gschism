 3385:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3386: 
 3387:       NODE_BND(nodeBnd);
 3388: 
 3389:       Node *node = nodeBnd->node;
 3390: 
 3391:       node->ETP = 0.0;
 3392: 
 3393:       for (int j=0; j<ntip; j++) {
 3394: 
 3395:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3396:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3397:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3398: 
 3399:          if constexpr(iloadtide==1) { // loading tide
 3400:             assert(false && "Loading tide not implemented");
 3401:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3402:          }
 3403:          
 3404:       }
 3405:       
 3406:    }
