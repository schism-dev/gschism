 1250: /**
 1251:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1252:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1253:    If the segment is completely inside the element, then it returns true.
 1254: 
 1255:    This function assumes:
 1256:    - The initial point is on a side of the element. 
 1257:    - Its position is given by parameter t in the range [0,1].
 1258:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1259:       intersects the element (elements are convex).
 1260: 
 1261:    To find the intersection point, this function does the following:
 1262:    - it finds the intersection of the line segment with all the element side lines,
 1263:       except for the one that contains the initial point.
 1264:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1265:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1266:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1267:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1268:       track segment is almost parallel to the element side line.
 1269: 
 1270:    Inputs:
 1271:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1272:    @param x2, y2: other end of the line segment
 1273: 
 1274:    Outputs:
 1275:    @param side:  side that intersects the line segment (input and output)
 1276:    @param nextElement (output): element that contains the intersection point
 1277:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1278:    @param zint (input/output): Vertical coordinate of the intersection point
 1279: 
 1280:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1281:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1282:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1283: 
 1284:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1285:    (Delta) being zero.
 1286: 
 1287:    The intersection2 point happens when:
 1288:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1289:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1290:    
 1291:    Assumption: the 4 points (including those of the side segment) are different.
 1292:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1293:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1294:    If true, (xIntersect,yIntersect) is the intersection.				
 1295:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1296: **/
 1297: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1298:                                               double &t, double& tIntersect) {
 1299: 
 1300:    double closest_intersect_t = 1e10;
 1301:    bool found_intersection = false;
 1302: 
 1303:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1304:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1305:    const Point2 x1 = side->point(t);
 1306:    
 1307: 
 1308:    Side *nextSide = nullptr;
 1309: 
 1310:    for (int i = 0; i < i34; i++) {
 1311: 
 1312:       // Element's i-th side 
 1313:       Side *side2 = sides[i];
 1314: 
 1315:       // Skip the side that contains the initial point
 1316:       if (side2 == side) continue;
 1317: 
 1318:       // (x3,y3)-(x4,y4) is the element side line
 1319:       const Point2 x3 = side2->n1->p2();
 1320:       const Point2 x4 = side2->n2->p2();
 1321: 
 1322:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1323:       const double delta = cross(x2 - x1, x3 - x4);
 1324: 
 1325:       if (delta != 0.0) {
 1326: 
 1327:          const double delta1 = cross(x3 - x1, x3 - x4);
 1328:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1329: 
 1330:          // Solves the two linear equations for tt1 and tt2
 1331:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1332:          const double tt2 = delta2/delta;
 1333: 
 1334:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1335:             closest_intersect_t = min(closest_intersect_t, tt1);
 1336:             nextSide = side2;
 1337: 
 1338:             nextElement = nextSide->otherElem(this);
 1339:             tIntersect = max(small, min(tt1, 1.0-small));
 1340:             t = tt2;
 1341: 
 1342:             found_intersection = true;
 1343:          }
 1344:       
 1345:       }
 1346: 
 1347:    }
 1348: 
 1349: 
 1350:    // found_intersection should always be true, since we checked all the sides.  
 1351:    side = nextSide;
 1352: // if (found_intersection) {
 1353: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1354: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1355: // }   
 1356:    return found_intersection;
 1357: }
 1358: 
 1359: 
 1360: 
 1361: 
 1362: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1363:                                               double &t, double& tIntersect) {
 1364: 
 1365:    double closest_intersect_t = 1e10;
 1366:    bool found_intersection = false;
 1367: 
 1368:    for (int i = 0; i < i34; i++) {
 1369: 
 1370:       Side *side2 = sides[i];
 1371: 
 1372:       // (x3,y3)-(x4,y4) is the element side line
 1373:       const Point2 x3 = side2->n1->p2();
 1374:       const Point2 x4 = side2->n2->p2();
 1375: 
 1376:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1377:       const double delta = cross(x2 - x1, x3 - x4);
 1378: 
 1379:       if (delta != 0.0) {
 1380: 
 1381:          const double delta1 = cross(x3 - x1, x3 - x4);
 1382:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1383: 
 1384:          // Solves the two linear equations for tt1 and tt2
 1385:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1386:          const double tt2 = delta2/delta;
 1387: 
 1388:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1389:             closest_intersect_t = min(closest_intersect_t, tt1);
 1390:             side = side2;
 1391:             nextElement = side->otherElem(this);
 1392:             t = tt2;
 1393:             tIntersect = max(small, min(tt1, 1.0-small));
 1394:             found_intersection = true;
 1395:          }
 1396:       
 1397:       }
 1398: 
 1399:    }
 1400: 
 1401: // if (found_intersection) {
 1402: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1403: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1404: // }
 1405: 
 1406:    // found_intersection should always be true, since we checked all the sides.  
 1407:    return found_intersection;
 1408: }
 1409: 
 1410: 
 1411: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1412:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1413: 
 1414:    printf("Tracking segment goes out of water at element %d\n", curElem->idx);
 1415: 
 1416:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1417:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1418:    // curElement.
 1419: 
 1420:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1421:    // And uses this velocity instead to continue the tracking.
 1422: 
 1423:    // computes the intersection point in cartesian coordinates
 1424:    Point2 intersection = nextSide->p_t(tt);
 1425: 
 1426:    // Nudges the point to the barycenter of the element. 
 1427:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1428:    // next segment intersects the element sides.  
 1429:    curElem->nudgeToBarycenter(intersection);
 1430: 
 1431:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1432:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1433:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1434:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1435: 
 1436:    // If the side is an open boundary, the tangential velocity is zero.
 1437:    if (nextSide->isBnd()) vtan = 0.0;
 1438: 
 1439:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1440:    const double us = vtan*nextSide->t().x;
 1441:    const double vs = vtan*nextSide->t().y;
 1442:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1443: 
 1444:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1445:    const double len2 = length(intersection - toPoint2(xt));
 1446:    const double vel2 = u_int.x*u_int.x + u_int.y*u_int.y;        
 1447:    assert(vel2 > 0.0 && "Zero velocity found");
 1448:    dt = dt - sqrt(len2/vel2); 
 1449: 
 1450:    // The end of this tracking segment is now the intersection point.
 1451:    xt = {intersection.x, intersection.y, zint};
 1452:    
 1453:    u_int = {us, vs, ws};
 1454:    
 1455: }
 1456: 
 1457: /**
 1458:  * Tracks a particle through elements and vertical levels in the mesh.
 1459:  * 
 1460:  * @param x0,y0,z0     Starting position coordinates
 1461:  * @param xt,yt,zt     Target position coordinates
 1462:  * @param dtb          Time step for tracking
 1463:  * @param uuint,vvint,wwint Initial velocity components
 1464:  * @param nextElem     Starting/resulting element index
 1465:  * 
 1466:  * @return Status code of type trackExitCodes
 1467:  * 
 1468:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1469:  * of the details are different. The idea is that the code requires less branches and is better fit
 1470:  * for GPU execution.
 1471:  * 
 1472:  * The main ideas here are:
 1473:  * - The starting point is expected to be in the starting element.
 1474:  * - The end point is guaranteed to be inside an element.
 1475:  * - since the starting point is inside the element, there are only two cases: 
 1476:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1477:  *     (b) it does not and (xt,yt) is already in the starting element.
 1478:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1479:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1480:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1481:  * - tt1 can be positive or negative. We only consider the positive values.
 1482:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1483:  * - The next intersection will occur at the smallest positive tt1.
 1484:  * - This intersection will be the next (x0,y0) position.
 1485:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1486:  *   of getting stuck in a loop.
 1487:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1488:  *   was found.
 1489:  */
 1490: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1491:                                                        Element *&nextElem, int &jlev, double &dt) {
 1492: 
 1493:    // First thing is to check if the target point is inside the element. If it is there is nothing
 1494:    // else to do.
 1495:    if (containsPoint(toPoint2(xt))) {
 1496:       nextElem->interpolateVelocities(xt, u_int);
 1497:       return true;
 1498:    }
 1499: 
 1500:    Side *side = nullptr;
 1501: 
 1502:    // 1. Initial checks
 1503:    // Verify starting element is valid (wet)
 1504:    assert(!nextElem->isDry && "Starting element is dry");
 1505: 
 1506:    // Checks if track has a zero length.
 1507:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1508:    assert(len2 > 0.0 && "Zero length track"); 
 1509:    
 1510: 
 1511:    const int MAX_ITERATIONS = 1000;
 1512:    
 1513:    double t;
 1514:    Side *nextSide = nullptr;
 1515:    double tIntersect = 1e10;
 1516:    double zint = x0.z;
 1517: 
 1518:    // Horizontal tracking loop
 1519:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1520:    // (x0,y0) is inside the element but the target point is not.
 1521:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1522:    assert(found_intersection && "No intersection found");
 1523: 
 1524:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1525: 
 1526:    // if the tracking segment goes out of water (either dry or edge boundary)
 1527:    if (isEdgeBoundary(nextSide) || (nextElem->isDry)) {
 1528:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1529:       nextElem = this;
 1530:       
 1531:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1532:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1533:       return true;    
 1534:       }
 1535: 
 1536:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1537:    int iterations = 0;
 1538:    while (iterations < MAX_ITERATIONS) {
 1539:       iterations++;
 1540:       
 1541:       Element *curElem = nextElem;
 1542: 
 1543:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1544:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1545: 
 1546:       // If we are already in the target element, we are done.
 1547:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1548:       if (!found_intersection) break;
 1549: 
 1550: 
 1551:   
 1552:       // if the tracking segment goes out of water (either dry or edge boundary).
 1553:       if (curElem->isEdgeBoundary(nextSide) || (nextElem->isDry)) {
 1554: 
 1555:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1556: 
 1557:          nextElem = curElem;
 1558: 
 1559:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1560:          // In this case, the caller (btrack) needs to take into account the remaining time.
 1561:          return true;
 1562:       }
 1563:       
 1564:       // Update position and element for next iteration
 1565:       side = nextSide;
 1566: 
 1567:    }
 1568: 
 1569: 
 1570:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 1571: 
 1572:  
 1573:    // Interpolate velocities at the final position. This is a conceptually simple step,
 1574:    // but the function is not simple, because it has to search for the vertical level containing zt.
 1575:    nextElem->interpolateVelocities(xt, u_int);
 1576: 
 1577: 
 1578:    return true;
 1579: }
 1580: 
 1581: 
 1582: 
 1583: 
 1584: __inline__ __device__ double Element::computeSignedArea(void) const {
 1585:    // Compute the area of the element
 1586: 
 1587:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 1588: 
 1589:    // In the quad case we need to add the area of the other triangle.
 1590:    if (isQuad()) {
 1591:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1592:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 1593:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1594:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 1595:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 1596:          Error("Negative area found in quad element");
 1597:       }
 1598:       res += ar1;
 1599:    }
 1600: 
 1601:    return res;
 1602: }
 1603: 
 1604: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 1605:    // In boundary sides, the element 1 is nullptr
 1606:    return side->elems[1] == nullptr; 
 1607: }
 1608: 
 1609: /**
 1610:    Compute the shape coordinates of the point (xt,yt) in the element.
 1611:    @param xt (input): x-coordinate of the point
 1612:    @param shpCoords (output): shape coordinates of the point
 1613:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 1614:    @return true if the point is inside the element, false otherwise
 1615: **/
 1616: __device__ bool Element::computeShapeCoords(Point2 xt, double shpCoords[4],
 1617:                                             bool fixNegshpCoord) const {
 1618: 
 1619:    // Compute the shape coordinates of the point xt in the element.
 1620:    if (i34==3) {
 1621:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 1622:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 1623:       // and in this case, the pt will be nudged into the element
 1624:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 1625:       // from the local frame, so use additional check.
 1626: 
 1627:       Point2 x0, x1, x2;
 1628: 
 1629:       if constexpr(ics==1) {
 1630:          x0 = nodes[0]->p2();
 1631:          x1 = nodes[1]->p2();
 1632:          x2 = nodes[2]->p2();
 1633:       }
 1634:       else // lat/lon
 1635:       {
 1636:          Error("Not implemented yet");
 1637: #ifdef ICS2
 1638:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 1639:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 1640:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 1641: #endif
 1642:       }
 1643: 
 1644:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 1645:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 1646:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 1647:       shpCoords[3] = 0.0;
 1648:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 1649: 
 1650:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 1651:       // then we fix the negative shape coordinates.
 1652:       if (fixNegshpCoord && tmpmin<=0.0) {
 1653: 
 1654:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 1655:          // keeping the sum of the shape coordinates equal to 1.
 1656:          // I have tested and compared the new algorithm with the old one, and they give
 1657:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 1658:          // The new algorithm should be faster since it is branchless.
 1659:          const double a = - tmpmin + 1.0e-2;  // XXX it used to be 1.0e-4 in the comments of the original code
 1660:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 1661:          
 1662:          shpCoords[0] = (shpCoords[0] + a)*b;
 1663:          shpCoords[1] = (shpCoords[1] + a)*b;
 1664:          shpCoords[2] = (shpCoords[2] + a)*b;          
 1665: 
 1666:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 1667:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 1668:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 1669:          }
 1670: 
 1671:          // Update the point coordinates for the new shape coordinates
 1672:          double xcoords[3] = {x0.x, x1.x, x2.x};
 1673:          double ycoords[3] = {x0.y, x1.y, x2.y};
 1674:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 1675: 
 1676:       }
 1677: 
 1678:       // Check if the point is inside the element
 1679:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 1680:    }
 1681:    else {
 1682:       Error("Not implemented yet");
 1683: #ifdef QUADS
 1684:       // Reproject pt in eframe of nel for ics=2
 1685:       if constexpr(ics==1) {
 1686:          xn2 = xt; 
 1687:          yn2 = yt;
 1688:       }
 1689:       else {
 1690:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 1691:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 1692:       }
 1693: 
 1694:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 1695: #endif
 1696:    }
 1697: 
 1698: }
 1699: 
 1700: 
 1701: /**  Interpolate velocities at a given point (xt,yt,zt)
 1702: 
 1703:    @param xt, yt, zt: coordinates of the point to interpolate
 1704:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 1705: 
 1706:    This is done in four steps:
 1707: 
 1708:    1. Find the shape coordinates for the final position in the element.
 1709:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 1710:    3. Perform a *binary search* to find the vertical level containing zt. It will have to interpolate the 
 1711:       z levels at xt, yt at each step.   
 1712:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 1713:       horizontally and vertically.
 1714: **/
 1715: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) {
 1716:    // Interpolate the velocities at the point xt. 
 1717:    // This function works the same for triangular and quadrilateral elements.
 1718:    double shpCoord[4];
 1719: 
 1720: 
 1721:    // First step is to compute the shape coordinates of (xt,yt)
 1722:    computeShapeCoords(toVector2(xt), shpCoord, false);
 1723:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 1724: 
 1725:    // Second step is to find the level that contains zt
 1726:    // Uses a binary search to find the level
 1727:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 1728:    int L = kbe;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 1729:    int R = nvrt - 1;
 1730: 
 1731:    // Get the z coordinates at the nodes of the element at the levels L and R
 1732:    double zLAtNodes[4], zRAtNodes[4];
 1733:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 1734:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 1735: 
 1736:    double zL = interpolate(shpCoord, zLAtNodes);
 1737:    double zR = interpolate(shpCoord, zRAtNodes);
 1738:    
 1739:    // Interpolates vertically the velocities
 1740:    double wght1, wght2;
 1741:    if (xt.z<=zL) {
 1742:       wght1 = 1.0;
 1743:       wght2 = 0.0;
 1744:    }
 1745:    else if (xt.z>=zR) {
 1746:       wght1 = 0.0;
 1747:       wght2 = 1.0;
 1748:    }
 1749:    else {
 1750:       // Perform a binary search to find the levels between L and R that contain xt.z
 1751:       while (R - L > 1) {
 1752:          int M = (L + R) / 2;
 1753: 
 1754:          double zMAtNodes[4];
 1755:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 1756:          double zM = interpolate(shpCoord, zMAtNodes);
 1757:          if (zM < xt.z) 
 1758:          {
 1759:             L = M;
 1760:             zL = zM;
 1761:          }
 1762:          else 
 1763:          {
 1764:             R = M;
 1765:             zR = zM;
 1766:          }
 1767:       }
 1768:       assert(L == R-1);
 1769:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 1770: 
 1771:       wght2 = (xt.z - zL)/(zR - zL);
 1772:       wght1 = 1.0 - wght2;
 1773:    }
 1774: // printf("$$$ wght1 = %f, wght2 = %f, zt = %f, zL = %f, zR = %f\n", wght1, wght2, zt, zL, zR);
 1775: // printf("$$$ shpCoord = %f, %f, %f, %f\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 1776:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 1777:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 1778: 
 1779:    // Neither of the interpolated velocities should be NaN
 1780:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 1781: 
 1782: }
 1783: 
 1784: 
 1785: 
 1786: __inline__ __device__ double Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 1787: __inline__ __device__ double Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 1788: __inline__ __device__ Point2 Side::p_t(double t) const { return {x(t), y(t)}; }
 1789: __inline__ __device__ int    Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 1790: __inline__ __device__ double Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 1791: 
 1792: __inline__ __device__ double Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 1793: __inline__ __device__ double Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 1794: __inline__ __device__ double Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 1795: 
 1796: 
 1797: __inline__ __device__ double Side::Cd(void)      const { if constexpr(nchi != 0) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 1798: 
 1799: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
