 1090: __device__ __inline__ double min3(double a, double b, double c) {
 1091:    return min(a, min(b, c));
 1092: }
 1093: 
 1094: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1095:    return min(a, min(b, min(c, d)));
