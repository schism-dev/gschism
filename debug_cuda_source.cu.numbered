  645: 
  646: struct Side {
  647: 
  648:    // Geometry information
  649:    int idx;               // Index of the side
  650:    Node *n1, *n2;
  651:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  652: 
  653:    double length;         // Length of the side. Used to be called distj; but I think this name is less clear now.
  654:    Vector2 center;        // Location of side center. 
  655:    double zc[nvrt];       // Side center z-coord at each vertical level
  656:    double depth;          // Depth at side center
  657: 
  658:    Frame frame;
  659: 
  660:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  661:                           // this is nullptr
  662:    
  663:    int kb;                // Bottom index of the side
  664:    bool idry;             // True if the side is dry
  665:  
  666:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  667: 
  668:    // Physical information
  669:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  670:    double  w2[nvrt];            // Vertical velocity at each vertical level
  671:    Vector2 btu[nvrt];           // Back-tracked velocity
  672:    Vector2 uth[nvrt];           // "Time history" velocity
  673:    Vector2 U;                   // Vertically averaged velocity vector  
  674: 
  675:    Vector2 d2uv[nvrt];          // divergence of (nu*grad u) XXX COMPUTE!!
  676: 
  677:    Vector2 bcc[nvrt];           // Baroclinic term
  678: 
  679:    double hhat;                 // \breve{H} in notes
  680: 
  681:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
  682: 
  683:    double coriolis;             // Coriolis parameter
  684: 
  685:    // Vegetation parameters
  686:    double veg_c2;
  687:    double veg_beta;
  688: 
  689:    // Bottom drag parameters.
  690:    double chi;
  691:    double chi2;
  692: 
  693:    __inline__ __device__ double x(double t) const;
  694:    __inline__ __device__ double y(double t) const;
  695:    __inline__ __device__ Point2 p_t(double t) const;
  696: 
  697:    __inline__ __device__ Point3 center3D(int k) const { return {center.x, center.y, zc[k]}; }
  698:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
  699:    __inline__ __device__ double Dz(int k)       const { return zc[k] - zc[k-1]; }
  700: 
  701:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
  702: 
  703:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
  704: 
  705:    __inline__ __device__ int iadv(void) const;
  706: 
  707:    __inline__ __device__ double eta2(void) const;
  708:    __inline__ __device__ double htot(void) const { return eta2() + depth; }
  709: 
  710:    __inline__ __device__ double veg_h(void)  const;
  711:    __inline__ __device__ double veg_nv(void) const;
  712:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
  713:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
  714: 
  715:    __inline__ __device__ double Cd(void) const;
  716: 
  717:    __inline__ __device__ Vector2 tau(void) const;
  718: 
  719:    __inline__ __device__ double zb(void) const { return zc[kb]; }
  720:    
  721: 
  722:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
  723:    __inline__ __device__ double zLevelVegRatio(int k) const { 
  724:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
  725:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
  726:    } 
  727:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
  728:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot(); }
  729:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 1; }
  730:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 1; }
  731: 
  732:    // Get valid starting element (for backtracking)
  733:    __inline__ __device__ Element* getStartElement() {
  734:       return elems[0] ? elems[0] : elems[1];
  735:    }
  736: 
  737:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
  738:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
  739: 
  740:       // If one of the elements is null, return the other one
  741:       if      (elems[0] == nullptr) return elems[1];
  742:       else if (elems[1] == nullptr) return elems[0];
  743: 
  744: 
  745:       // Dot product of the negative velocity vector with the side normal vector
  746:       const double dot_prod1 = -dot(u, n);
  747:       
  748:       // Vector from side center to element 0 centroid
  749:       const Vector2 v2 = toVector2(elems[0]->center) - center;
  750: 
  751:       // Dot product of the vector with the side normal vector
  752:       const double dot_prod2 = dot(v2, n);
  753: 
  754:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
  755:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
  756: 
  757:       if (dot_prod1*dot_prod2 > 0.0) return elems[0];
  758:       else                           return elems[1];
  759: 
  760:  
  761:    }
  762: 
  763:    __forceinline__ __device__ Element* otherElem(const Element* elem) {
  764:       // Given an element, returns the other element that shares this side
  765:       return (elems[0] == elem) ? elems[1] : elems[0];
  766:    }
  767: 
  768:    __forceinline__ __device__ Node* otherNode(Node* node) {
  769:       // Given a node, returns the other node that shares this side
  770:       return (n1 == node) ? n2 : n1;
  771:    }
  772:  
  773:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, double* sclr,
  774:                                      Vector3 &u_int) const;
  775: 
  776: 
  777: 
  778: 
  779: };
