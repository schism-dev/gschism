 4840: 
 4841: __global__ void computeMatrixProductAndDotProducts() {
 4842:    // Computes A*p, r'Mr and p'Ap
 4843: 
 4844:    // 1) shared buffer: first half for rMr, second for pAp
 4845:    __shared__ double sdata[2*BLOCK_SIZE];
 4846:    double* s_rMr = sdata;
 4847:    double* s_pAp = sdata + BLOCK_SIZE;
 4848: 
 4849:    // 2) get your node pointer
 4850:    NODE(node);  
 4851:    const int tid = threadIdx.x;
 4852: 
 4853:    const double diag = node->coeffDiag;
 4854:    const double r    = node->mR;
 4855:    const double p    = node->mP;  
 4856: 
 4857:    // apply preconditioner on the fly:
 4858:    const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 4859: 
 4860: 
 4861:    // 4) compute Ap = A.p
 4862:    double Ap = node->coeffDiag * node->mP;
 4863:    #pragma unroll
 4864:    for (int j = 0; j < node->numNodes; ++j) {
 4865:       const Node *nbNode = node->nodes[j];
 4866:       Ap += node->coeffMatrix[j] * nbNode->mP;
 4867: // printf("computeMatrixProductAndDotProducts: coeff = %f, mp = %f\n", node->coeffMatrix[j], nbNode->mP);
 4868:    }
 4869:    node->mAp = Ap;
 4870:     
 4871: // printf("YYYY: tid = %d, diag = %f, r = %f\n", tid, diag, r);    
 4872: 
 4873:    // 5) dot-products individual products (r'Mr, p'Ap)
 4874:    const double l_rMr = r*Mr;  // r'Mr
 4875:    const double l_pAp = p*Ap;  // p'Ap
 4876: 
 4877:    // 6) write into shared mem
 4878:    s_rMr[tid] = l_rMr;
 4879:    s_pAp[tid] = l_pAp;
 4880: 
 4881: // printf("crrr omputeMatrixProductAndDotProducts: tid = %d, l_rMr = %f, l_pAp = %f\n", tid, l_rMr, l_pAp);
 4882: 
 4883:    __syncthreads();
 4884: 
 4885:    // 7) block-wide tree reduction
 4886:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 4887:       if (tid < stride)  s_pAp[tid] += s_pAp[tid + stride];
 4888:       __syncthreads();
 4889:    }
 4890: 
 4891:    // 8) thread 0 atomically accumulates into the globals
 4892:    // XXX: This is slower than it needs to be, but it is simple and works
 4893:    if (tid == 0) atomicAdd(pAp, s_pAp[0]);
 4894: 
 4895:    // if (*rMr_new != 0.0) *rMr_old = *rMr_new;
 4896: 
 4897:    // // Reset these value for the next iteration
 4898:    // *rMr_new = 0.0;
 4899:    
 4900: 
 4901: printf("STEP 1: tid = %d, rMr_old = %f, rMr_new = %f, pAp = %f\n", tid, *rMr_old, *rMr_new, *pAp);
 4902: }
 4903: 
 4904: 
 4905: __global__ void updateSolutionAndDotProducts(void) {
 4906:     extern __shared__ double s_rMr[BLOCK_SIZE];       
 4907: 
 4908: 
 4909:     // get node & bounds-check:
 4910:     NODE(node);
 4911:     const int tid = threadIdx.x;
 4912: 
 4913: 
 4914: 
 4915:     // Compute alpha
 4916:     const double alpha = (*rMr_old)/(*pAp);
 4917: // printf("DDD updateSolutionAndDotProducts: alpha = %f\n", alpha);
 4918:     // load scalars
 4919:     const double diag = node->coeffDiag;
 4920:     const double p    = node->mP;
 4921:     const double Ap   = node->mAp;
 4922:     const double x    = node->mX;
 4923:     const double r    = node->mR;
 4924:     
 4925:     assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 4926: 
 4927:     // 1) update solution & residual
 4928:     const double x_new = x + alpha*p;
 4929:     const double r_new = r - alpha*Ap;
 4930:     node->mX = x_new;
 4931:     node->mR = r_new;
 4932:    //  printf("XXXXX: tid = %d, diag = %f, r_new = %f\n", tid, diag, r_new);
 4933: 
 4934:     // 2) apply Jacobi preconditioner on the fly
 4935:     const double Mr_new = r_new/diag;
 4936: 
 4937:     // 3) local contributions for the two dot-products
 4938:     const double l_rMr = r_new*Mr_new;  // r'M^-1r
 4939: 
 4940:     // 4) write into shared-mem
 4941:     s_rMr[tid] = l_rMr;
 4942: 
 4943:     __syncthreads();
 4944: 
 4945: 
 4946:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 4947:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 4948:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 4949:         __syncthreads();
 4950:     }
 4951: 
 4952:     // 6) thread 0 atomically folds into the global accumulators
 4953:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 4954: 
 4955:     
 4956: printf("STEP 2: tid = %d, rMr_new = %f, rMr_old = %f\n", tid,  *rMr_new, *rMr_old);    
 4957: }
 4958: 
 4959: 
 4960: __global__ void updateSearchDirection() {
 4961:     NODE(node);
 4962: 
 4963:     // recompute z on-the-fly
 4964: // printf("updateSearchDirection: node = %d, coeffDiag = %f, rMr_old = %f, rMr_new = %f\n", node, node->coeffDiag, rMr_old, rMr_new);
 4965:     const double z = node->mR / node->coeffDiag;
 4966:     const double p = node->mP;
 4967: 
 4968: printf("updateSearchDirection: rMr_new = %f, rMr_old = %f\n", *rMr_new, *rMr_old);
 4969:     const double beta = (*rMr_new)/(*rMr_old);
 4970: 
 4971: // printf("ZZZ updateSearchDirection: beta = %f\n", beta);
 4972: 
 4973:     // p =z + beta*p
 4974:     node->mP = z + beta*p;
 4975: 
 4976: 
 4977: 
 4978: }
 4979: 
 4980: __global__ void initializePreconditionedResidual(double *scalars) {
 4981: 
 4982:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 4983: 
 4984:     NODE(node);
 4985:     const int tid = threadIdx.x;
 4986:     // For the first iteration:
 4987:     // 1. Initial solution x = 0 (already set)
 4988:     // 2. Initial residual r = b (stored in qel)
 4989:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 4990: 
 4991: // XXX we should use the guess solution here    
 4992: 
 4993:     // Set initial residual r = b (from qel)
 4994:     node->mR = node->qel;
 4995: 
 4996:     // Compute z = M^-1 * r (preconditioned residual)
 4997:     const double z = node->mR / node->coeffDiag;
 4998: 
 4999:     // Set initial search direction p = z
 5000:     node->mP = z;
 5001: 
 5002:     // Initialize other variables needed for CG
 5003:     node->mX = 0.0;  // Initial solution
 5004:     node->mAp = 0.0; // Will be computed in first iteration
 5005: 
 5006:     // These point to a cupy array in the host code
 5007:     rMr_old = scalars + 0;
 5008:     rMr_new = scalars + 1;
 5009:     pAp     = scalars + 2;
 5010: 
 5011:     // Computes the first r'Mr (reduction)
 5012:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 5013: 
 5014:     // 4) write into shared-mem
 5015:     s_rMr[tid] = l_rMr;
 5016: 
 5017:     __syncthreads();
 5018: 
 5019: 
 5020:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 5021:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 5022:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 5023:         __syncthreads();
 5024:     }
 5025: 
 5026:     // 6) thread 0 atomically folds into the global accumulators
 5027:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 5028: 
 5029:     *rMr_old = 0.0;
 5030:     *pAp = 0.0;
 5031: }
