 3589:    __global__ void computeVerticallyIntegratedVelocity(void) {
 3590: 
 3591:       SIDE(side);
 3592: 
 3593: 
 3594:       side->U = {0.0, 0.0}; 
 3595:          
 3596:       if(side->isDry) return;
 3597: 
 3598:       const Node *node1 = side->n1;
 3599:       const Node *node2 = side->n2;
 3600: 
 3601:       // Vertically integrated velocity U (in ll if ics=2)
 3602:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 3603:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 3604:       }
 3605: 
 3606:    }
 3607: 
 3608:    __global__ void computeBottomDragVegetation(void) {
 3609:       // UNFINISHED. CHECK THIS:
 3610:       // How many kernels are needed? Why so many for loops?
 3611:       // Is the loop on sides needed?
 3612: 
 3613:       NODE(node);
 3614: 
 3615:       const int    kb      = node->kb;
 3616:       const double htot    = node->htot();
 3617:       const double rough   = node->rough;
 3618: 
 3619: 
 3620:       if (node->isDry) {
 3621:          // Default values for dry nodes
 3622:          node->veg_alpha_vert_mean = node->veg_alpha0;
 3623:          /// XXX CHECK INDICES
 3624:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 3625:       }
 3626: 
 3627:       // Compute bottom drag Cd
 3628:       //--------------------------------
 3629: 
 3630:       // nchi = {-1, 0, 1} is the type of bottom drag.
 3631:       if (nchi==1) {
 3632: 
 3633:          bool ltmp = false; // for WBL iteration
 3634: 
 3635:          // Cdmax=-1 !max. Cd at node for this process (info only)
 3636:          // Drag at nodes
 3637:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 3638:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 3639:         
 3640:          const double rough = node->rough;
 3641:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3642:          if (node->rough == 0.0) {
 3643:             node->Cd = 0.0;
 3644: 
 3645:          } else { //roughness >0 
 3646:             
 3647:             const double bthick_ori = node->znl[kb + 1] - node->znl[kb];  // thickness of bottom bnd layer
 3648:             const double bthick = max(dzb_min, bthick_ori);
 3649: 
 3650:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 3651: 
 3652:             double tmp = 1.0/(2.5*log(bthick/rough));
 3653:             node->Cd = tmp*tmp;
 3654: 
 3655:          } // if rough
 3656: 
 3657: 
 3658:          // RECOVER THIS: XXX
 3659:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 3660:          // Output warning for WBL if iteration didn't converge
 3661: 
 3662: 
 3663:       } // nchi==1
 3664: 
 3665:       //   Bottom stress in m^2/s^2
 3666:       if (node->rho[kb + 1] >= -98.0)
 3667:       {
 3668:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 3669:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 3670:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 3671:          // !sediment erosion: this part needs more documentation
 3672:       }
 3673: 
 3674:     
 3675:       // Compute vegetation parameters
 3676:       //--------------------------------
 3677: 
 3678:       // SAV constants
 3679:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 3680:       constexpr double veg_cfpsi = 0.16;
 3681: 
 3682:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 3683:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 3684: 
 3685:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 3686:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 3687:          int kbin = 0; // bin index
 3688:          for (int k = kb; k < nvrt; k++) {
 3689:             // Computes node height above the bottom level
 3690:             const double tmp_h = node->znl[k] - node->znl[kb]; // >=0
 3691:             assert(false && "Vertical variation of vegetation not implemented");
 3692: 
 3693:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 3694:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 3695:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 3696:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 3697:             // } else {
 3698:             //    // Find the bin at which the current vertical level is
 3699:             //    while (kbin<nbins_veg_vert) {
 3700:             //       const double zn = node->znl[kbin];
 3701:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 3702:             //          break;
 3703:             //       } // if
 3704:             //       kbin++;
 3705:             //    } // while
 3706:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 3707: 
 3708:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 3709:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 3710:                
 3711:             //    // Linear interpolation of the vegetation parameters
 3712:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 3713:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 3714:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 3715:             // } // if rl10
 3716: 
 3717:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 3718: 
 3719:          } // for k
 3720: 
 3721: 
 3722:       } else { // Ganthy (iveg=2)
 3723:       //  Modify canopy height, diameter, and density
 3724: 
 3725:          // Make sure there is vegetation on this node
 3726:          if (node->veg_h_unbent > 0.0) {
 3727:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 3728: 
 3729:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 3730:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 3731:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 3732: 
 3733:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 3734:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 3735:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 3736:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 3737:          } // if veg_h_unbent
 3738: 
 3739:          for (int k = 0; k < nvrt; k++) {
 3740:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 3741:          } // for k
 3742:       
 3743: 
 3744:       } // if iveg
 3745:      
 3746:          
 3747: 
 3748:       // Compute vertical mean of veg_alpha3D
 3749:       if (iveg != 0) {
 3750:          const double ztop = node->zTopCanopy(); // Top of the canopy
 3751:          double sum1=0.0;
 3752:          double sum2=0.0;
 3753:          // Integrate over each level under the canopy...
 3754:          for (int k=kb; k<nvrt-1 && node->znl[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 3755:             const double Dz = node->Dz(k);
 3756: 
 3757:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 3758:             sum2 += Dz;
 3759: 
 3760:          } // for k
 3761: 
 3762:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 3763:          else             node->veg_alpha_vert_mean = sum1/sum2;
 3764: 
 3765:       } // if iveg
 3766: 
 3767:       printf("computeBottomDragVegetation: nodeIdx = %d, node->veg_alpha_vert_mean = %f\n", node->idx, node->veg_alpha_vert_mean);
 3768: 
 3769:    }
 3770: 
 3771:    __global__ void computeVegetationAndDragParameters(void) {
 3772:       // Computes the vegetation and drag model parameters:
 3773:       // chi, \tilde\chi, beta, \breve{H}
 3774:       
 3775:       SIDE(side);
 3776: 
 3777:       const double htot = side->htot();
 3778:       const int    kb   = side->kb;
 3779: 
 3780:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 3781: 
 3782:       const double veg_h     = side->veg_h();
 3783:       const double veg_nv    = side->veg_nv();
 3784:       const double veg_c     = side->veg_c();
 3785:       const double veg_beta  = side->veg_beta;
 3786:       const double veg_alpha = side->veg_alpha_vert_mean();
 3787: 
 3788:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 3789:       // Velocity magnitude at the bottom level
 3790:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 3791:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 3792:       side->chi2 = side->Cd()*vmag1;
 3793:       side->chi  = side->chi2;
 3794:       if constexpr(iveg != 0) {
 3795:          const Node *n1 = side->n1;
 3796:          const Node *n2 = side->n2;
 3797:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 3798:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 3799:       }
 3800: 
 3801:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 3802: 
 3803:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 3804:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 3805:       double magUa = 0.0;
 3806:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 3807:          // 3D wet side with veg...
 3808: 
 3809:          double magUa = 0.0;
 3810:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 3811:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 3812: 
 3813:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 3814:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 3815:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 3816: 
 3817:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 3818:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 3819: 
 3820:                // Velocity magnitude at the bottom (l) of the level
 3821:                const double ul = length(side->u2[k]);
 3822: 
 3823:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 3824:                magUa += Dz*0.5*(uh + ul);
 3825: 
 3826:             } // if HasVegetation
 3827:          } // for k
 3828:          const double ua = magUa/min(htot, veg_h); // Vertical average
 3829: 
 3830:          // Computes beta, used for computing the stress term at the top of the canopy.      
 3831:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 3832:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 3833:             const double zCpy = side->zTopCanopy();
 3834:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 3835:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 3836:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 3837:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 3838:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 3839:          } // if isSubmerged
 3840:       } // if iveg   
 3841: 
 3842:       // Computes the friction modified depth, \breve{H} in notes
 3843:       if (side->is2D()) { // 2D
 3844: 
 3845:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 3846:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 3847: 
 3848:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 3849: 
 3850:          side->hhat = htot*htot/fricH; 
 3851: 
 3852:       } else { // 3D
 3853:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 3854: 
 3855:          if constexpr(iveg != 0) {
 3856:             
 3857:             if (side->isSubmerged()) { 
 3858:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 3859:                side->hhat -= veg_c*Hhat_alpha;
 3860: 
 3861:             } else { // Emergent
 3862:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 3863:             }
 3864:          } // if iveg
 3865: 
 3866:          // Enforce positivity for 3D model
 3867:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 3868:       } // if 3D
 3869: 
 3870:       printf("computeVegetationAndDragParameters: sideIdx = %d, side->htot = %f, side->hhat = %f\n", side->idx, side->htot(), side->hhat);
 3871: 
 3872:         
 3873:    }
 3874: 
 3875: 
 3876: 
 3877:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 3878:    // Computes the density gradient between two elements, e1 and e2.
 3879:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 3880:    // zero in the direction normal to the side. 
 3881:    // 
 3882:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 3883:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 3884:    //
 3885:    // Input:
 3886:    //    e1: Element
 3887:    //    e2: Neighbor element (or nullptr if boundary)
 3888:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 3889:    //    k: Index of the half-level at which the density is interpolated
 3890:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 3891:    // 
 3892:    // Output:
 3893:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 3894:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 3895: 
 3896:       if (e2 == nullptr || e2->isDry) {
 3897:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 3898: 
 3899:          Side *side = e1->sides[j];
 3900:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 3901:                  
 3902:          if constexpr(ics == 1) {
 3903:             vec = side->n; // Normal vector to the side
 3904:          } else {
 3905:             // IMPLEMENT THIS XXXXXX
 3906:             // !replace with xel, yel?
 3907:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 3908:             //      &eframe(:,:,i),xn1,yn1,tmp)
 3909:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 3910:             //      &eframe(:,:,i),xn2,yn2,tmp)
 3911:          } //ics
 3912:                    
 3913:          diffRho = 0.0;
 3914: 
 3915:       } else { //internal and wet
 3916:          if constexpr(ics==1) {
 3917:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 3918: 
 3919:             // Vector from e1 to e2
 3920:             vec = toVector2(e2->center - e1->center);
 3921: 
 3922:          } else { 
 3923:             // IMPLEMENT THIS XXXXXX
 3924:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 3925:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 3926:             //                   alow(j)=xctr2
 3927:             //                   bdia(j)=yctr2
 3928:          } // ics
 3929: 
 3930:          diffRho = rho2 - e1->demeanedDensity(k);
 3931:       }
 3932: 
 3933:    }
 3934: 
 3935:    __global__ void computeDensityCubicSplines(void) {
 3936:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 3937: 
 3938:       ELEM(elem);
 3939: 
 3940:       if (elem->isDry) return;
 3941: 
 3942:       const int kb = elem->kb;
 3943: 
 3944:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 3945:       if (elem->is2D()) {
 3946:          // In the 2D case, the density is constant at the prism level. 
 3947:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 3948:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 3949:       } else { //3D
 3950: 
 3951:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 3952:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 3953:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 3954:          ///// XXXX CHECK INDICES!!!!!
 3955:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 3956:       } // 2D/3D
 3957: 
 3958:    }
 3959: } // extern "C"
 3960: 
 3961: 
 3962: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 3963: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 3964: 
 3965:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 3966: 
 3967:    const int kb  = elem->kb;
 3968:    const int kb2 = elem2->kb;
 3969: 
 3970:    // z-coordinate of prism of elem
 3971:    const double zp = elem->z_prism(k);
 3972: 
 3973:    double rho = 0.0;
 3974: 
 3975:    if (elem2->is2D()) {
 3976:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 3977: 
 3978:    } else {  // 3D
 3979: 
 3980:       // eta_min may be < zmax
 3981:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 3982:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 3983: 
 3984:       // (Extrapolate density below bottom, we will fix it later)
 3985:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 3986:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 3987:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 3988:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 3989:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 3990:    } // 2D/3D
 3991:      
 3992: 
 3993:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 3994:    // Now we need to fix it.
 3995:    if (elem->z[k] < elem2->z[kb2]) {
 3996:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 3997: 
 3998:       // There are two methods to adjust the density at the bottom of the element.
 3999:       // iunder_deep=0: 
 4000:       const double depth1 = abs(elem->z[kb]); // larger depth
 4001: 
 4002:       if (iunder_deep==0) {
 4003: 
 4004:          const double weight = max(0.0, min(1.0, (depth1 - h1_bcc)/(h2_bcc - h1_bcc))); // weight
 4005: 
 4006:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4007: 
 4008:       } else { // iunder_deep != 0
 4009: 
 4010:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4011: 
 4012:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4013: 
 4014:          //   Demeaned density at the same z coordinate as
 4015:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4016:          }
 4017: 
 4018:       } // if iunder_deep
 4019:    } // if elem->z[kb] < elem2->z[kb]
 4020: 
 4021:    return rho;
 4022: }
 4023: 
 4024: 
 4025: extern "C" {
 4026:    __global__ void computeDensityGradient(void) {
 4027: 
 4028:          // Compute the horizontal density gradient at each element.
 4029:       // It works in two steps:
 4030:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4031:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4032:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4033:       //             gradRho.r1 = rho1 - rho0
 4034:       //             gradRho.r2 = rho2 - rho0
 4035:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4036:       // 
 4037:       //  NOTE: We use de-meaned densities.
 4038: 
 4039:       ELEM(elem);
 4040: 
 4041:       if (elem->isDry) return;
 4042: 
 4043:       const int kb  = elem->kb;
 4044:       const int i34 = elem->i34;
 4045: 
 4046:       for (int k = kb + 1; k < nvrt; k++) {
 4047:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 4048:          //             gradRho.r1 = rho1 - rho0
 4049:          //             gradRho.r2 = rho2 - rho0
 4050:          int icount = 0;
 4051:          double sumRx = 0.0;
 4052:          double sumRy = 0.0;
 4053:          for (int j1=0; j1<i34; j1++) { 
 4054: 
 4055:             const int j2 = elem->nxq(j1 + 1);
 4056: 
 4057:             // Pairs of consecutive neighbor elements of elem
 4058:             const Element *e1 = elem->nghbElems[j1];
 4059:             const Element *e2 = elem->nghbElems[j2];
 4060: 
 4061:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 4062:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 4063:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 4064: 
 4065:             // Compute the density difference and the vector from elem to e1 and e2
 4066:             // getRhoDiffAndVec takes into account boundaries/dry elements
 4067:             double diffRho1, diffRho2;
 4068:             Vector2 vec1, vec2;
 4069:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 4070:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 4071: 
 4072:             const double rl1 = length(vec1);
 4073:             const double rl2 = length(vec2);
 4074:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 4075: 
 4076:             const double delta = cross(vec1, vec2);
 4077:             const double sintheta = abs(delta)/(rl1*rl2);
 4078: 
 4079:             // To avoid problems, avoid elements with small angle between vectors
 4080:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 4081:             const bool validEq = (sintheta > sin_one_deg);
 4082: 
 4083:             if (validEq) {
 4084:                // Solve the system of equations to get the density gradient at elem
 4085:                icount++;
 4086:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 4087:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 4088:                sumRx += Rx;
 4089:                sumRy += Ry;
 4090:             }
 4091:          } // for j1
 4092: 
 4093:          // Compute the average density gradient at elem
 4094:          if (icount==0) {
 4095:            // Bad mesh quality; bail out with 0 b-cc
 4096:            elem->gradRho[k] = {0.0, 0.0};
 4097:          } else {
 4098:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 4099:          }
 4100: 
 4101:       } // for k
 4102: 
 4103:    }
 4104: 
 4105:    __global__ void computeBaroclinicTerm(void) {
 4106:    // Computes the baroclinic term at sides (at half levels).
 4107:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 4108:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 4109: 
 4110:       SIDE(side);
 4111: 
 4112:       if (side->isDry) return;
 4113: 
 4114:       const Element *e1 = side->elems[0];
 4115:       const Element *e2 = side->elems[1];      
 4116:       const int kb = side->kb;
 4117:       
 4118:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 4119: 
 4120:       // interpolates vertically the density gradient of the two elements at the half level/
 4121: 
 4122:       // Starts the integration at the surface and goes down to the bottom
 4123:       int k1 = nvrt - 1;
 4124:       int k2 = nvrt - 1;
 4125: 
 4126:       side->bcc[nvrt-1] = {0.0, 0.0};
 4127:       for (int k = nvrt-1; k >= kb; k--) {
 4128:       // For each prism level (from surface to bottom)...
 4129: 
 4130:          // For both elements, interpolate density gradient at the side's half level.
 4131:          // The gradient at the side is the average of the gradients at the elements.
 4132:          // w1, w2 are used to take into account boundary sides, with just one element.
 4133:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 4134:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 4135:          const double wsum = w1 + w2;
 4136:          w1 = w1/wsum;
 4137:          w2 = w2/wsum;
 4138:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 4139: 
 4140:          // Linear interpolation of both elements' density gradient at the shared side's level.
 4141:          Vector2 gradRho = {0.0, 0.0};
 4142:          if (e1 != nullptr && k > kb) {
 4143:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 4144:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 4145:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 4146:             
 4147:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 4148:          }      
 4149:          if (e2 != nullptr && k > kb) {
 4150:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4151:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4152:             
 4153:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4154:          }
 4155: 
 4156:          if constexpr(ics==2) {
 4157:             // IMPLEMENT THIS XXXXXX
 4158:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4159:             // swild(1)=tmp1
 4160:             // swild(2)=tmp2
 4161:          }
 4162:          
 4163:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4164:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4165:          // CHECK INDICES!!! XXX
 4166:          const double grav3 = 0.5*(side->n1->grav2 + side->n2->grav2);
 4167:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4168:       } // for
 4169: 
 4170:    }
 4171: 
 4172: } // extern "C"
 4173: 
 4174: #ifdef DONTCOMPILE
 4175: __device__ void computeVerticalAdvection(void) {
 4176:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 4177: 
 4178:    sdbt(1:2,:,:)=0.d0
 4179: 
 4180:    const Side *side = FROM kernel;
 4181: 
 4182:    if(side->isDry) return;
 4183: 
 4184:    // If side is wet...
 4185: 
 4186: 
 4187:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 4188:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 4189:    double ws[nvrt] = {} // w @ side
 4190:    int icount = 0;
 4191:    for (int j=0; j<2; j++) {
 4192:       const Element *elem = side->elements[j];
 4193:        
 4194:       if(elem != nullptr) {
 4195:          icount++;
 4196:          for (int k=0; k<nvrt; k++) {
 4197:             ws[k] = ws[k] + elem->w[k];
 4198:          }
 4199:       }
 4200:    }  // for j
 4201: 
 4202:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 4203:    ws = ws/icount;
 4204: 
 4205:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 4206:    // Splines allow for a smooth transition between vertical levels.
 4207:    // Splines have continuity restrictions at the internal knots, but
 4208:    // we have to provide the 1st derivatives at the endpoints.
 4209:    const int kbs = side->kbs; 
 4210:    
 4211:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 4212:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 4213:    initCubicSpline(kbs, nvrt, side, ws, up)
 4214: 
 4215:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 4216:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 4217:    initCubicSpline(kbs, nvrt, side, ws, vp)
 4218: 
 4219:    // Total advection (average onto side)
 4220:    const Node *node1 = side->nodes[0];
 4221:    const Node *node2 = side->nodes[1];
 4222:    for (int k=kbs(i); k<nvrt; k++) {
 4223: 
 4224:       if constexpr(ics==1) {
 4225:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 4226:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 4227:       } else {
 4228:          // XXX IMPLEMENT THIS
 4229:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 4230:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 4231:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 4232:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 4233:       }  // if ics
 4234: 
 4235: 
 4236:    }
 4237: }
 4238: #endif
 4239: 
 4240: 
 4241: extern "C" {
 4242:    __global__ void computeElemAverageGhat(void) {
 4243:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 4244: 
 4245:       ELEM(elem);
 4246:       
 4247:       elem->ghat1= {0.0, 0.0};  
 4248: 
 4249:       if constexpr(ihydraulics != 0) {
 4250:          if (nhtblocks > 0 && elem->isblock) return;
 4251:       }
 4252: 
 4253:       if (elem->isDry) return;
 4254: 
 4255:       // Wet elements.
 4256:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 4257:       // tidal potential, horizontal diffusion, and baroclinic etc
 4258:       // Remember to update both fb and F 
 4259:       // If ics=2, ghat1 are in eframe (ll)
 4260:       // cff1-3: coefficients for 2D/3D
 4261:       Vector2 gradEta = {0.0, 0.0};  // \nabla \eta
 4262:       Vector2 gradPr  = {0.0, 0.0};  // \nabla pressure
 4263:       Vector2 gradETP = {0.0, 0.0};  // \nabla etp
 4264: 
 4265:       double av_cff1 = 0.0;  // av. for cff1
 4266:       double av_cff2 = 0.0;  // av. for cff2
 4267:       double av_cff3 = 0.0;  // av. for cff3
 4268:       double av_df = 0.0;  // av. for H^\alpha / H
 4269:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 4270:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 4271: 
 4272:       const int i34 = elem->i34;
 4273:       const int kb = elem->kb;
 4274: 
 4275:       for (int j=1; j<i34; j++) {
 4276:          // For each node and side in the element...
 4277: 
 4278:          const Node *node = elem->nodes[j];
 4279:          const Side *side = elem->sides[j];
 4280: 
 4281:          const double chi      = side->chi;
 4282:          const double veg_c2   = side->veg_c2;
 4283:          const double veg_beta = side->veg_beta;
 4284:          const double veg_h    = side->veg_h();
 4285:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 4286: 
 4287:          // Node - const in elem
 4288:          gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 4289:          gradPr  += node->pr  *elem->gradPhi[j];
 4290: 
 4291:          if (elem->depth >= tip_dp) {
 4292:            gradETP += node->ETP*elem->gradPhi[j];
 4293:          }
 4294: 
 4295:          
 4296:          const double htot  = side->htot();        // Total depth at the side
 4297:          const double zctr2 = side->zTopCanopy();  
 4298: 
 4299:          double cff1; 
 4300:          double cff2; 
 4301:          double cff3;   
 4302:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 4303:          // coefficients applied to 2D/3D case 
 4304:             cff1 = side->hhat/htot;
 4305:             cff2 = 0.0;
 4306:             cff3 = 0.0;
 4307:          } else { //3D
 4308:             //Init for no-veg case
 4309:             cff1 = 1.0;
 4310:             cff2 = 1.0;
 4311:             cff3 = 0.0;
 4312: 
 4313:             if constexpr(iveg != 0) {
 4314:                // Computes coefficients used with vegetation terms G1, G2
 4315:                // cff1, cff3 are used for the first two terms in G1, G2:
 4316:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 4317:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 4318:                // In general, cff1*Ustar - cff3*Ustar_alpha
 4319:                if(veg_h < 0.99*htot) { // submergent vegetation
 4320:                   cff1=1;
 4321:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 4322:                   cff3 = veg_c;
 4323: 
 4324:                } else { // emergent vegetation
 4325:                   cff1 = 1.0/(1.0 + veg_c2);
 4326:                   cff2 = cff1;
 4327:                   cff3 = 0.0;
 4328: 
 4329:                }
 4330:             } // if iveg
 4331:          } //  2D/3D
 4332: 
 4333:          av_cff1 += cff1/i34;
 4334:          av_cff2 += cff2/i34;
 4335:          av_cff3 += cff3/i34;
 4336:          av_cff2_chi += cff2*chi/i34;
 4337:          av_cff3_chi += cff3*chi/i34;
 4338:          av_df += min(htot, veg_h)/(htot*i34);
 4339: 
 4340: 
 4341:          // btrack values: U^\star, U^{\star\alpha}
 4342:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 4343:          Vector2 Ustar       = {0.0, 0.0}; 
 4344:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 4345: 
 4346:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 4347:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 4348:          } else { //3D
 4349:             for (int k = side->kb; k < nvrt; k++) {
 4350:             
 4351:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 4352:                Ustar += w2;
 4353: 
 4354:                if constexpr(iveg != 0) {
 4355:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 4356:                        const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k)); // For the top of the canopy, ratio of the level that is below the canopy
 4357:                        Ustar_alpha += zrat*w2; // XXXX
 4358:                    }
 4359:                }  // if iveg
 4360:             }  // for k
 4361:          }  //2D/3D
 4362:          
 4363: 
 4364:          // Add btrack & surface stress terms to \breve{G} first
 4365:          if constexpr(ics==1) {
 4366:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 4367:          } else {
 4368:             // XXX IMPLEMENT THIS
 4369:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 4370:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 4371:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 4372:          }  // if ics
 4373: 
 4374:          // Surface and bottom stress terms
 4375:          if constexpr(ics==1) {
 4376:             const Vector2 tau    = side->tau();
 4377:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 4378: 
 4379:             // Term for surface and bottom stress
 4380:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 4381:          } else {
 4382:             // XXX IMPLEMENT THIS
 4383:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 4384:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 4385:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 4386:             // tau_x=(vn1+tt1)/2.d0
 4387:             // tau_y=(vn2+ss1)/2.d0
 4388:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 4389:          }  // if ics
 4390: 
 4391:          
 4392: 
 4393:          // All terms in F,F^\alpha,f_b except baroclinic
 4394:          // F, f_b: all explicit terms excluding vegetation 
 4395:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 4396:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 4397:          const double coriolis = side->coriolis;
 4398:          Vector2 F  =  coriolis*side->U;  // F_x
 4399:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 4400:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 4401: 
 4402:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 4403:             
 4404:             for (int k = side->kb; k < nvrt; k++) {
 4405:                if (zctr2 > side->zc[k-1]) {
 4406:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 4407:                    const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 4408:                    Fa +=  coriolis*w2*zrat;
 4409:                } // if zctr2
 4410:             } // k
 4411:          } // iveg
 4412: 
 4413:          // Integrate horizontal viscosity force vertically
 4414:          for (int k=side->kb + 1; k<nvrt; k++) {
 4415:             const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.0; 
 4416: 
 4417:             F += levelHorVisc;
 4418: 
 4419:             // Vegetation term
 4420:             if constexpr(iveg!=0) {
 4421:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 4422:                   const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 4423:                   Fa += levelHorVisc*zrat;
 4424:                } 
 4425:             } // if iveg
 4426:          } // for k
 4427: 
 4428:          fb += side->d2uv[side->kb];
 4429: 
 4430: 
 4431:          // Add to ghat1
 4432:          if constexpr(ics==2) {
 4433:             // XXX IMPLEMENT THIS
 4434:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4435:             // bigf1=vn1; bigf2=vn2
 4436:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4437:             // botf1=vn1; botf2=vn2
 4438:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4439:             // bigfa1=vn1; bigfa2=vn2
 4440:          } // if ics
 4441: 
 4442:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 4443:       } // for j (nodes and sides)
 4444: 
 4445:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 4446:          
 4447:       // Finish off terms in F, F^\alpha and f_b
 4448:       const double grav3 = elem->mean(&Node::grav2);
 4449:       const Vector2 fb = grav3*gradETP - gradPr/rho0; //const in each elem
 4450: 
 4451: 
 4452:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 4453:       for (int j=1; j<i34; j++) { 
 4454:          // For each side in the element...
 4455:          const Side *side = elem->sides[j];
 4456:          const double chi = side->chi;
 4457: 
 4458:          const double htot = side->htot();
 4459:          const double veg_h = side->veg_h();
 4460:          const Vector2 F  = htot*fb;
 4461:          const Vector2 Fa = min(htot, veg_h)*fb;
 4462: 
 4463:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 4464:       } // for j
 4465: printf("$$$ tmp = %.15g, %.15g\n", tmp.x, tmp.y);
 4466:       //botf1 etc are already in elem frame
 4467:       elem->ghat1 += tmp/i34;
 4468: 
 4469:       // Baroclinic force
 4470:       if constexpr(ibc==0) {
 4471:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 4472: 
 4473:          Vector2 Fa = {0.0, 0.0};
 4474:          Vector2 intGradRho = {0.0, 0.0};
 4475:          
 4476:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 4477:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 4478:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 4479: 
 4480:             // \in F [m^2/s/s]
 4481:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 4482:          }
 4483: 
 4484:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 4485:          const Vector2 F = av_df*Fa; //approx
 4486:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 4487: 
 4488:       } // if ibc
 4489: 
 4490: 
 4491: 
 4492:    }
 4493: 
 4494: } // extern "C"
 4495: 
 4496: 
 4497: 
 4498: #ifdef DONTCOMPILE
 4499: __global__ void checkMassConservation(Tracers* sumtr) {
 4500: 
 4501:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 4502: 
 4503:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 4504: 
 4505:    Element *elem = &(mesh->localElemData[i]);
 4506: 
 4507:    // Skip dry elements
 4508:    if (elem->isDry) return;
 4509: 
 4510:    // Local sum array for this thread
 4511:    double localSum[N_TRACERS] = {0.0};
 4512: 
 4513:    // Sum over vertical levels for this element
 4514:    const int kbe = elem->kbe;
 4515:    const double area = elem->area;
 4516: 
 4517:    for (int k = kbe; k < nvrt; k++) {
 4518:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 4519:       
 4520:       // Accumulate tracer mass
 4521:       for (int tr = 0; tr < N_TRACERS; tr++) {
 4522:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 4523:       }
 4524:    }
 4525: 
 4526:    
 4527: 
 4528:    //  This function returns per element sums. A reduction must be done on the host side.
 4529: }
 4530: 
 4531: 
 4532: __global__ void transport(void) {
 4533: 
 4534:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 4535: 
 4536:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 4537: 
 4538:    Element *elem = &(mesh->localElemData[ie]);
 4539: 
 4540:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 4541: 
 4542:                for (int m=0; m<ntr; m++) {
 4543:                   for (int k=kbe(ie); k<nvrt; k++) {
 4544:                      // Calculate each polynomial's weight 
 4545:                      wm=0.d0; sum1=0.d0; 
 4546:                      wm1=0.d0; wm2=0.d0; 
 4547:                      for (int i=0; i<elem->nweno2; i++) {
 4548:                   
 4549:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4550:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4551:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4552:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4553:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4554:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 4555:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 4556:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 4557:                      // -----------------Hu and Shu (1999)'s method----------------
 4558:                      b4=b1+b2+b3
 4559: 
 4560: //Error: add PRODUCTION CPP
 4561: #ifdef DEBUG
 4562:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 4563:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 4564:                     call parallel_abort(errmsg)
 4565:                   }
 4566: #endif
 4567: 
 4568:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 4569:                   // !----test-------------- 
 4570:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 4571:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 4572:                   // !wm(i)=wm1(i)*wm2(i)
 4573:                   // !---------------------- 
 4574:                   sum1=sum1+wm(i)
 4575:                 } // end for i
 4576: 
 4577:                 wm=wm/sum1
 4578: 
 4579:                 for (int j=0; j<elem->i34; j++) {
 4580: 
 4581:                   const Side *side  = elem->sides[j];
 4582:                   const Node *node1 = side->n1;
 4583:                   const Node *node2 = side->n2;
 4584: 
 4585:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 4586:                      trsd=0.d0
 4587:                      for (int kk=0; kk<nquad; kk++) {
 4588:                         for (int i=0; i<elem->nweno2; i++) {
 4589:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4590:                         } // end for i   
 4591:                      } // end for kk
 4592:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 4593:                   } // outward flux
 4594:                } // end for j=1,i34(ie) ! side
 4595:             }
 4596:          }
 4597:               
 4598: 
 4599: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 4600: //             //   calculate each polynomial's weight 
 4601: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 4602: //                 wm=0.d0; sum1=0.d0
 4603: //                 do i=1,nweno1(ie) !for each polynomial
 4604: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4605: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4606: //                   b1=b1*b1+b2*b2 !smoothness indicator
 4607: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 4608: //                   wm(i)=b2
 4609: //                   sum1=sum1+b2
 4610: //                   !wm(i)=1.d0
 4611: //                   !sum1=sum1+1.d0
 4612: 
 4613: // // Error: PRODUCTION
 4614: // #ifdef DEBUG
 4615: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 4616: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 4617: //                     call parallel_abort(errmsg)
 4618: //                   endif
 4619: // #endif
 4620: 
 4621: //                 enddo !i
 4622: //                 wm=wm/sum1 !final weight
 4623: 
 4624:                 for (int j=0; j<elem->i34; j++) { // side
 4625:                   const Side *side = elem->sides[j];
 4626:                   const Node *node1 = side->n1;
 4627:                   const Node *node2 = side->n2;
 4628: 
 4629:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 4630:                     trsd=0.d0
 4631:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 4632:                       for (int i=0; i<elem->nweno1; i++) {
 4633:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 4634:                       }
 4635:                     enddo //kk
 4636:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 4637:                   } // outward flux
 4638:                 } // end for j=1,i34(ie) ! side
 4639:               } // end for k; ntr 
 4640: 
 4641:             else !simple upwind method
 4642:               do j=1,i34(ie)
 4643:                 jsj=elside(j,ie)
 4644:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 4645:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 4646:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 4647:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 4648:                   endif
 4649:                 enddo  !vertical layers
 4650:               enddo !j=1,i34(ie) ! side
 4651:             endif !order of accuracy
 4652: 
 4653:          //  enddo !ie
 4654: // !$OMP     end do
