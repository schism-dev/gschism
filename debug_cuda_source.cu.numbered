 2665: __device__ void computeElevationBoundaryConditions(double ramp, double time) {
 2666:    // Compute elevation essential boundary conditions 
 2667: 
 2668:    // In case of border node on >1 bnd with imposed elevation, the bnd with largest segment # prevails.
 2669: 
 2670:    const Node *node = FROM kernel; // A boundary node
 2671:    NodeBoundary *nodeBnd = node->nodeBnd;
 2672:    const int iettype = nodeBnd->iettype;
 2673: 
 2674:    double eic = 0.0;
 2675:    if (nramp_elev==1) eic = nodeBnd->etaic;
 2676:    else               eic = 0.0;
 2677: 
 2678:    const double r_eic = (1.0 - ramp)*eic; 
 2679:    const double r_eth = ramp*eth(1,i);
 2680:    double eta1_bar = r_eic;
 2681: 
 2682:    // Compute tide elevation
 2683:    if (iettype == 3 || iettype == 5) {
 2684:      
 2685:       // XXX IMPLEMENT TIDE THINGS
 2686:       for (int jfr=0; jfr<nbfr; jfr++) { // For all tide frequencies
 2687:          const int ncyc = int(amig[jfr]*time/(2.0*pi));
 2688:          const double arg = amig[jfr]*time - 2.0*pi*ncyc + face[jfr] - efa[i,j,jfr];
 2689:          eta1_bar += ramp*ff[jfr]*emo[i,j,jfr]*cos(arg);
 2690:       } // for jfr
 2691:    } // if iettype
 2692: 
 2693:    switch (iettype) {
 2694:       case 1:
 2695:       case 2:
 2696:          nodeBnd->elbc = r_eth + r_eic;
 2697:          break;
 2698:       case 3:
 2699:          nodeBnd->elbc = eta1_bar + r_eic;
 2700:          break;
 2701:       case 4:
 2702:          nodeBnd->elbc = r_eth + r_eic;
 2703:          break;
 2704:       case 5:
 2705:          nodeBnd->elbc = r_eth + eta1_bar + r_eic;
 2706:          break;
 2707:    } // switch
 2708: 
 2709: 
 2710:    //Add inverse barometric effects
 2711:    if (iettype != 0 && inv_atm_bnd == 1) {
 2712:       nodeBnd->elbc += ramp*(prmsl_ref - pr(ip))/grav/rho0;
 2713:    }
 2714: 
 2715: }
