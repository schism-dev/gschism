 3218:    __global__ void computeElevationBoundaryConditions(double time) {
 3219:       // Compute elevation essential boundary conditions 
 3220: 
 3221:       NODE_BND(nodeBnd); // Each boundary node.
 3222: 
 3223:       const Node *node = nodeBnd->node;
 3224:       const int iettype = nodeBnd->iettype;
 3225: 
 3226:       double eic = 0.0;
 3227:       if (nramp_elev==1) eic = nodeBnd->etaic;
 3228:       else               eic = 0.0;
 3229: 
 3230:       const double r_eic = (1.0 - ramp)*eic; 
 3231:       const double r_eth = ramp*nodeBnd->eth;
 3232:       double eta1_bar = r_eic;
 3233: 
 3234:       // Compute tide elevation
 3235:       if (iettype == 3 || iettype == 5) {
 3236:         
 3237:          // XXX IMPLEMENT TIDE THINGS
 3238:          assert(true && "Tide elevation not implemented");
 3239:          // for (int jfr=0; jfr<nbfr; jfr++) { // For all tide frequencies
 3240:          //    const int ncyc = int(amig[jfr]*time/(2.0*pi));
 3241:          //    const double arg = amig[jfr]*time - 2.0*pi*ncyc + face[jfr] - efa[i,j,jfr];
 3242:          //    eta1_bar += ramp*ff[jfr]*emo[i,j,jfr]*cos(arg);
 3243:          // } // for jfr
 3244:       } // if iettype
 3245: 
 3246:       switch (iettype) {
 3247:          case 1:
 3248:          case 2:
 3249:             nodeBnd->elbc = r_eth + r_eic;
 3250:             break;
 3251:          case 3:
 3252:             nodeBnd->elbc = eta1_bar + r_eic;
 3253:             break;
 3254:          case 4:
 3255:             nodeBnd->elbc = r_eth + r_eic;
 3256:             break;
 3257:          case 5:
 3258:             nodeBnd->elbc = r_eth + eta1_bar + r_eic;
 3259:             break;
 3260:       } // switch
 3261: 
 3262: 
 3263:       //Add inverse barometric effects
 3264:       if (iettype != 0 && inv_atm_bnd == 1) {
 3265:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 3266:       }
 3267: 
 3268:    }
 3269: 
 3270:    __global__ void computeVerticallyIntegratedVelocity(void) {
 3271: 
 3272:       SIDE(side);
 3273: 
 3274:       printf("computeVerticallyIntegratedVelocity: side = %p, side->idx = %d\n", side, side->idx);
 3275: 
 3276:       side->U = {0.0, 0.0}; 
 3277:          
 3278:       if(side->isDry) return;
 3279: 
 3280:       const Node *node1 = side->n1;
 3281:       const Node *node2 = side->n2;
 3282: 
 3283:       // Vertically integrated velocity U (in ll if ics=2)
 3284:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 3285:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 3286:       }
 3287: 
 3288:    }
 3289: 
 3290:    __global__ void computeBottomDragVegetation(void) {
 3291:       // UNFINISHED. CHECK THIS:
 3292:       // How many kernels are needed? Why so many for loops?
 3293:       // Is the loop on sides needed?
 3294: 
 3295:       NODE(node);
 3296: 
 3297:       const int    kb      = node->kb;
 3298:       const double htot    = node->htot();
 3299:       const double rough   = node->rough;
 3300: 
 3301: 
 3302:       if (node->isDry) {
 3303:          // Default values for dry nodes
 3304:          node->veg_alpha_vert_mean = node->veg_alpha0;
 3305:          /// XXX CHECK INDICES
 3306:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 3307:       }
 3308: 
 3309:       // Compute bottom drag Cd
 3310:       //--------------------------------
 3311: 
 3312:       // nchi = {-1, 0, 1} is the type of bottom drag.
 3313:       if (nchi==1) {
 3314: 
 3315:          bool ltmp = false; // for WBL iteration
 3316: 
 3317:          // Cdmax=-1 !max. Cd at node for this process (info only)
 3318:          // Drag at nodes
 3319:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 3320:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 3321:         
 3322:          const double rough = node->rough;
 3323:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3324:          if (node->rough == 0.0) {
 3325:             node->Cd = 0.0;
 3326: 
 3327:          } else { //roughness >0 
 3328:             
 3329:             const double bthick_ori = node->znl[kb + 1] - node->znl[kb];  // thickness of bottom bnd layer
 3330:             const double bthick = max(dzb_min, bthick_ori);
 3331: 
 3332:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 3333: 
 3334:             double tmp = 1.0/(2.5*log(bthick/rough));
 3335:             node->Cd = tmp*tmp;
 3336: 
 3337:          } // if rough
 3338: 
 3339: 
 3340:          // RECOVER THIS: XXX
 3341:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 3342:          // Output warning for WBL if iteration didn't converge
 3343: 
 3344: 
 3345:       } // nchi==1
 3346: 
 3347:       //   Bottom stress in m^2/s^2
 3348:       if (node->rho[kb + 1] >= -98.0)
 3349:       {
 3350:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 3351:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 3352:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 3353:          // !sediment erosion: this part needs more documentation
 3354:       }
 3355: 
 3356:     
 3357:       // Compute vegetation parameters
 3358:       //--------------------------------
 3359: 
 3360:       // SAV constants
 3361:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 3362:       constexpr double veg_cfpsi = 0.16;
 3363: 
 3364:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 3365:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 3366: 
 3367:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 3368:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 3369:          int kbin = 0; // bin index
 3370:          for (int k = kb; k < nvrt; k++) {
 3371:             // Computes node height above the bottom level
 3372:             const double tmp_h = node->znl[k] - node->znl[kb]; // >=0
 3373:             assert(true && "Vertical variation of vegetation not implemented");
 3374: 
 3375:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 3376:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 3377:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 3378:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 3379:             // } else {
 3380:             //    // Find the bin at which the current vertical level is
 3381:             //    while (kbin<nbins_veg_vert) {
 3382:             //       const double zn = node->znl[kbin];
 3383:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 3384:             //          break;
 3385:             //       } // if
 3386:             //       kbin++;
 3387:             //    } // while
 3388:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 3389: 
 3390:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 3391:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 3392:                
 3393:             //    // Linear interpolation of the vegetation parameters
 3394:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 3395:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 3396:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 3397:             // } // if rl10
 3398: 
 3399:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 3400: 
 3401:          } // for k
 3402: 
 3403: 
 3404:       } else { // Ganthy (iveg=2)
 3405:       //  Modify canopy height, diameter, and density
 3406: 
 3407:          // Make sure there is vegetation on this node
 3408:          if (node->veg_h_unbent > 0.0) {
 3409:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 3410: 
 3411:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 3412:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 3413:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 3414: 
 3415:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 3416:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 3417:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 3418:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 3419:          } // if veg_h_unbent
 3420: 
 3421:          for (int k = 0; k < nvrt; k++) {
 3422:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 3423:          } // for k
 3424:       
 3425: 
 3426:       } // if iveg
 3427:      
 3428:          
 3429: 
 3430:       // Compute vertical mean of veg_alpha3D
 3431:       if (iveg != 0) {
 3432:          const double ztop = node->zTopCanopy(); // Top of the canopy
 3433:          double sum1=0.0;
 3434:          double sum2=0.0;
 3435:          // Integrate over each level under the canopy...
 3436:          for (int k=kb; k<nvrt-1 && node->znl[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 3437:             const double Dz = node->Dz(k);
 3438: 
 3439:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 3440:             sum2 += Dz;
 3441: 
 3442:          } // for k
 3443: 
 3444:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 3445:          else             node->veg_alpha_vert_mean = sum1/sum2;
 3446: 
 3447:       } // if iveg
 3448: 
 3449:       printf("computeBottomDragVegetation: nodeIdx = %d, node->veg_alpha_vert_mean = %f\n", node->idx, node->veg_alpha_vert_mean);
 3450: 
 3451:    }
 3452: 
 3453:    __global__ void computeVegetationAndDragParameters(void) {
 3454:       // Computes the vegetation and drag model parameters:
 3455:       // chi, \tilde\chi, beta, \breve{H}
 3456:       
 3457:       SIDE(side);
 3458: 
 3459:       const double htot = side->htot();
 3460:       const int    kb   = side->kb;
 3461: 
 3462:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 3463: 
 3464:       const double veg_h     = side->veg_h();
 3465:       const double veg_nv    = side->veg_nv();
 3466:       const double veg_c     = side->veg_c();
 3467:       const double veg_beta  = side->veg_beta;
 3468:       const double veg_alpha = side->veg_alpha_vert_mean();
 3469: 
 3470:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 3471:       // Velocity magnitude at the bottom level
 3472:       // XXXX Check if we have add -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 3473:       assert(true && "Must use backtracked velocity");
 3474:       const double vmag1 = length(side->u2[kb + 1]); //BACKTRACKED VELOCITY
 3475:       side->chi2 = side->Cd()*vmag1;
 3476:       side->chi  = side->chi2;
 3477:       if constexpr(iveg != 0) {
 3478:          const Node *n1 = side->n1;
 3479:          const Node *n2 = side->n2;
 3480:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 3481:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 3482:       }
 3483: 
 3484:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 3485: 
 3486:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 3487:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 3488:       double magUa = 0.0;
 3489:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 3490:          // 3D wet side with veg...
 3491: 
 3492:          double magUa = 0.0;
 3493:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 3494:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 3495: 
 3496:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 3497:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 3498:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 3499: 
 3500:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 3501:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 3502: 
 3503:                // Velocity magnitude at the bottom (l) of the level
 3504:                const double ul = length(side->u2[k]);
 3505: 
 3506:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 3507:                magUa += Dz*0.5*(uh + ul);
 3508: 
 3509:             } // if HasVegetation
 3510:          } // for k
 3511:          const double ua = magUa/min(htot, veg_h); // Vertical average
 3512: 
 3513:          // Computes beta, used for computing the stress term at the top of the canopy.      
 3514:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 3515:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 3516:             const double zCpy = side->zTopCanopy();
 3517:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 3518:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 3519:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 3520:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 3521:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 3522:          } // if isSubmerged
 3523:       } // if iveg   
 3524: 
 3525:       // Computes the friction modified depth, \breve{H} in notes
 3526:       if (side->is2D()) { // 2D
 3527: 
 3528:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 3529:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 3530: 
 3531:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 3532: 
 3533:          side->hhat = htot*htot/fricH; 
 3534: 
 3535:       } else { // 3D
 3536:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 3537: 
 3538:          if constexpr(iveg != 0) {
 3539:             
 3540:             if (side->isSubmerged()) { 
 3541:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 3542:                side->hhat -= veg_c*Hhat_alpha;
 3543: 
 3544:             } else { // Emergent
 3545:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 3546:             }
 3547:          } // if iveg
 3548: 
 3549:          // Enforce positivity for 3D model
 3550:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 3551:       } // if 3D
 3552: 
 3553:         
 3554:    }
 3555: 
 3556: 
 3557: 
 3558:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 3559:    // Computes the density gradient between two elements, e1 and e2.
 3560:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 3561:    // zero in the direction normal to the side. 
 3562:    // 
 3563:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 3564:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 3565:    //
 3566:    // Input:
 3567:    //    e1: Element
 3568:    //    e2: Neighbor element (or nullptr if boundary)
 3569:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 3570:    //    k: Index of the half-level at which the density is interpolated
 3571:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 3572:    // 
 3573:    // Output:
 3574:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 3575:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 3576: 
 3577:       if (e2 == nullptr || e2->isDry) {
 3578:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 3579: 
 3580:          Side *side = e1->sides[j];
 3581:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 3582:                  
 3583:          if constexpr(ics == 1) {
 3584:             vec = side->n; // Normal vector to the side
 3585:          } else {
 3586:             // IMPLEMENT THIS XXXXXX
 3587:             // !replace with xel, yel?
 3588:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 3589:             //      &eframe(:,:,i),xn1,yn1,tmp)
 3590:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 3591:             //      &eframe(:,:,i),xn2,yn2,tmp)
 3592:          } //ics
 3593:                    
 3594:          diffRho = 0.0;
 3595: 
 3596:       } else { //internal and wet
 3597:          if constexpr(ics==1) {
 3598:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 3599: 
 3600:             // Vector from e1 to e2
 3601:             vec = toVector2(e2->center - e1->center);
 3602: 
 3603:          } else { 
 3604:             // IMPLEMENT THIS XXXXXX
 3605:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 3606:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 3607:             //                   alow(j)=xctr2
 3608:             //                   bdia(j)=yctr2
 3609:          } // ics
 3610: 
 3611:          diffRho = rho2 - e1->demeanedDensity(k);
 3612:       }
 3613: 
 3614:    }
 3615: 
 3616:    __global__ void computeDensityCubicSplines(void) {
 3617:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 3618: 
 3619:       ELEM(elem);
 3620: 
 3621:       if (elem->isDry) return;
 3622: 
 3623:       const int kb = elem->kb;
 3624: 
 3625:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 3626:       if (elem->is2D()) {
 3627:          // In the 2D case, the density is constant at the prism level. 
 3628:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 3629:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 3630:       } else { //3D
 3631: 
 3632:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 3633:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 3634:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 3635:          ///// XXXX CHECK INDICES!!!!!
 3636:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 3637:       } // 2D/3D
 3638: 
 3639:    }
 3640: } // extern "C"
 3641: 
 3642: 
 3643: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 3644: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 3645: 
 3646:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 3647: 
 3648:    const int kb  = elem->kb;
 3649:    const int kb2 = elem2->kb;
 3650: 
 3651:    // z-coordinate of prism of elem
 3652:    const double zp = elem->z_prism(k);
 3653: 
 3654:    double rho = 0.0;
 3655: 
 3656:    if (elem2->is2D()) {
 3657:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 3658: 
 3659:    } else {  // 3D
 3660: 
 3661:       // eta_min may be < zmax
 3662:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 3663:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 3664: 
 3665:       // (Extrapolate density below bottom, we will fix it later)
 3666:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 3667:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 3668:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 3669:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 3670:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 3671:    } // 2D/3D
 3672:      
 3673: 
 3674:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 3675:    // Now we need to fix it.
 3676:    if (elem->z[k] < elem2->z[kb2]) {
 3677:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 3678: 
 3679:       // There are two methods to adjust the density at the bottom of the element.
 3680:       // iunder_deep=0: 
 3681:       const double depth1 = abs(elem->z[kb]); // larger depth
 3682: 
 3683:       if (iunder_deep==0) {
 3684: 
 3685:          const double weight = max(0.0, min(1.0, (depth1 - h1_bcc)/(h2_bcc - h1_bcc))); // weight
 3686: 
 3687:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 3688: 
 3689:       } else { // iunder_deep != 0
 3690: 
 3691:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 3692: 
 3693:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 3694: 
 3695:          //   Demeaned density at the same z coordinate as
 3696:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 3697:          }
 3698: 
 3699:       } // if iunder_deep
 3700:    } // if elem->z[kb] < elem2->z[kb]
 3701: 
 3702:    return rho;
 3703: }
 3704: 
 3705: 
 3706: extern "C" {
 3707:    __global__ void computeDensityGradient(void) {
 3708: 
 3709:          // Compute the horizontal density gradient at each element.
 3710:       // It works in two steps:
 3711:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 3712:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 3713:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 3714:       //             gradRho.r1 = rho1 - rho0
 3715:       //             gradRho.r2 = rho2 - rho0
 3716:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 3717:       // 
 3718:       //  NOTE: We use de-meaned densities.
 3719: 
 3720:       ELEM(elem);
 3721: 
 3722:       if (elem->isDry) return;
 3723: 
 3724:       const int kb  = elem->kb;
 3725:       const int i34 = elem->i34;
 3726: 
 3727:       for (int k = kb + 1; k < nvrt; k++) {
 3728:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 3729:          //             gradRho.r1 = rho1 - rho0
 3730:          //             gradRho.r2 = rho2 - rho0
 3731:          int icount = 0;
 3732:          double sumRx = 0.0;
 3733:          double sumRy = 0.0;
 3734:          for (int j1=0; j1<i34; j1++) { 
 3735: 
 3736:             const int j2 = elem->nxq(j1 + 1);
 3737: 
 3738:             // Pairs of consecutive neighbor elements of elem
 3739:             const Element *e1 = elem->nghbElems[j1];
 3740:             const Element *e2 = elem->nghbElems[j2];
 3741: 
 3742:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 3743:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 3744:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 3745: 
 3746:             // Compute the density difference and the vector from elem to e1 and e2
 3747:             // getRhoDiffAndVec takes into account boundaries/dry elements
 3748:             double diffRho1, diffRho2;
 3749:             Vector2 vec1, vec2;
 3750:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 3751:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 3752: 
 3753:             const double rl1 = length(vec1);
 3754:             const double rl2 = length(vec2);
 3755:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 3756: 
 3757:             const double delta = cross(vec1, vec2);
 3758:             const double sintheta = abs(delta)/(rl1*rl2);
 3759: 
 3760:             // To avoid problems, avoid elements with small angle between vectors
 3761:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 3762:             const bool validEq = (sintheta > sin_one_deg);
 3763: 
 3764:             if (validEq) {
 3765:                // Solve the system of equations to get the density gradient at elem
 3766:                icount++;
 3767:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 3768:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 3769:                sumRx += Rx;
 3770:                sumRy += Ry;
 3771:             }
 3772:          } // for j1
 3773: 
 3774:          // Compute the average density gradient at elem
 3775:          if (icount==0) {
 3776:            // Bad mesh quality; bail out with 0 b-cc
 3777:            elem->gradRho[k] = {0.0, 0.0};
 3778:          } else {
 3779:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 3780:          }
 3781: 
 3782:       } // for k
 3783: 
 3784:    }
 3785: 
 3786:    __global__ void computeBaroclinicTerm(void) {
 3787:    // Computes the baroclinic term at sides (at half levels).
 3788:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 3789:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 3790: 
 3791:       SIDE(side);
 3792: 
 3793:       if (side->isDry) return;
 3794: 
 3795:       const Element *e1 = side->elems[0];
 3796:       const Element *e2 = side->elems[1];      
 3797:       const int kb = side->kb;
 3798:       
 3799:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 3800: 
 3801:       // interpolates vertically the density gradient of the two elements at the half level/
 3802: 
 3803:       // Starts the integration at the surface and goes down to the bottom
 3804:       int k1 = nvrt - 1;
 3805:       int k2 = nvrt - 1;
 3806: 
 3807:       side->bcc[nvrt-1] = {0.0, 0.0};
 3808:       for (int k = nvrt-1; k >= kb; k--) {
 3809:       // For each prism level (from surface to bottom)...
 3810: 
 3811:          // For both elements, interpolate density gradient at the side's half level.
 3812:          // The gradient at the side is the average of the gradients at the elements.
 3813:          // w1, w2 are used to take into account boundary sides, with just one element.
 3814:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 3815:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 3816:          w1 = w1/(w1 + w2);
 3817:          w2 = w2/(w1 + w2);
 3818: 
 3819:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 3820: 
 3821:          // Linear interpolation of both elements' density gradient at the shared side's level.
 3822:          Vector2 gradRho = {0.0, 0.0};
 3823:          if (e1 != nullptr && k > kb) {
 3824:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 3825:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 3826:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 3827:             
 3828:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 3829:          }      
 3830:          if (e2 != nullptr && k > kb) {
 3831:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 3832:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 3833:             
 3834:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 3835:          }
 3836: 
 3837:          if constexpr(ics==2) {
 3838:             // IMPLEMENT THIS XXXXXX
 3839:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 3840:             // swild(1)=tmp1
 3841:             // swild(2)=tmp2
 3842:          }
 3843:          
 3844:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 3845:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 3846:          // CHECK INDICES!!! XXX
 3847:          const double grav3 = 0.5*(side->n1->grav2 + side->n2->grav2);
 3848:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 3849:       } // for
 3850: 
 3851:    }
 3852: 
 3853: } // extern "C"
 3854: 
 3855: #ifdef DONTCOMPILE
 3856: __device__ void computeVerticalAdvection(void) {
 3857:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 3858: 
 3859:    sdbt(1:2,:,:)=0.d0
 3860: 
 3861:    const Side *side = FROM kernel;
 3862: 
 3863:    if(side->isDry) return;
 3864: 
 3865:    // If side is wet...
 3866: 
 3867: 
 3868:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 3869:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 3870:    double ws[nvrt] = {} // w @ side
 3871:    int icount = 0;
 3872:    for (int j=0; j<2; j++) {
 3873:       const Element *elem = side->elements[j];
 3874:        
 3875:       if(elem != nullptr) {
 3876:          icount++;
 3877:          for (int k=0; k<nvrt; k++) {
 3878:             ws[k] = ws[k] + elem->w[k];
 3879:          }
 3880:       }
 3881:    }  // for j
 3882: 
 3883:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 3884:    ws = ws/icount;
 3885: 
 3886:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 3887:    // Splines allow for a smooth transition between vertical levels.
 3888:    // Splines have continuity restrictions at the internal knots, but
 3889:    // we have to provide the 1st derivatives at the endpoints.
 3890:    const int kbs = side->kbs; 
 3891:    
 3892:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3893:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3894:    initCubicSpline(kbs, nvrt, side, ws, up)
 3895: 
 3896:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3897:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3898:    initCubicSpline(kbs, nvrt, side, ws, vp)
 3899: 
 3900:    // Total advection (average onto side)
 3901:    const Node *node1 = side->nodes[0];
 3902:    const Node *node2 = side->nodes[1];
 3903:    for (int k=kbs(i); k<nvrt; k++) {
 3904: 
 3905:       if constexpr(ics==1) {
 3906:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 3907:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 3908:       } else {
 3909:          // XXX IMPLEMENT THIS
 3910:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 3911:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 3912:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 3913:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 3914:       }  // if ics
 3915: 
 3916: 
 3917:    }
 3918: }
 3919: #endif
 3920: 
 3921: 
 3922: extern "C" {
 3923:    __global__ void computeElemAverageGhat(double rampbc) {
 3924:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 3925: 
 3926:       ELEM(elem);
 3927:       
 3928:       elem->ghat1= {0.0, 0.0};  
 3929: 
 3930:       if constexpr(ihydraulics != 0) {
 3931:          if (nhtblocks > 0 && elem->isblock) return;
 3932:       }
 3933: 
 3934:       if (elem->isDry) return;
 3935: 
 3936:       // Wet elements.
 3937:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 3938:       // tidal potential, horizontal diffusion, and baroclinic etc
 3939:       // Remember to update both fb and F 
 3940:       // If ics=2, ghat1 are in eframe (ll)
 3941:       // cff1-3: coefficients for 2D/3D
 3942:       Vector2 gradEta = {0.0, 0.0};  // \nabla \eta
 3943:       Vector2 gradPr  = {0.0, 0.0};  // \nabla pressure
 3944:       Vector2 gradETP = {0.0, 0.0};  // \nabla etp
 3945: 
 3946:       double av_cff1 = 0.0;  // av. for cff1
 3947:       double av_cff2 = 0.0;  // av. for cff2
 3948:       double av_cff3 = 0.0;  // av. for cff3
 3949:       double av_df = 0.0;  // av. for H^\alpha / H
 3950:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 3951:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 3952: 
 3953:       const int i34 = elem->i34;
 3954:       const int kb = elem->kb;
 3955: 
 3956:       for (int j=1; j<i34; j++) {
 3957:          // For each node and side in the element...
 3958: 
 3959:          const Node *node = elem->nodes[j];
 3960:          const Side *side = elem->sides[j];
 3961: 
 3962:          const double chi      = side->chi;
 3963:          const double veg_c2   = side->veg_c2;
 3964:          const double veg_beta = side->veg_beta;
 3965:          const double veg_h    = side->veg_h();
 3966:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 3967: 
 3968:          // Node - const in elem
 3969:          gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 3970:          gradPr  += node->pr  *elem->gradPhi[j];
 3971: 
 3972:          if (elem->depth >= tip_dp) {
 3973:            gradETP += node->ETP*elem->gradPhi[j];
 3974:          }
 3975: 
 3976:          
 3977:          const double htot  = side->htot();        // Total depth at the side
 3978:          const double zctr2 = side->zTopCanopy();  
 3979: 
 3980:          double cff1; 
 3981:          double cff2; 
 3982:          double cff3;   
 3983:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 3984:          // coefficients applied to 2D/3D case 
 3985:             cff1 = side->hhat/htot;
 3986:             cff2 = 0.0;
 3987:             cff3 = 0.0;
 3988:          } else { //3D
 3989:             //Init for no-veg case
 3990:             cff1 = 1.0;
 3991:             cff2 = 1.0;
 3992:             cff3 = 0.0;
 3993: 
 3994:             if constexpr(iveg != 0) {
 3995:                // Computes coefficients used with vegetation terms G1, G2
 3996:                // cff1, cff3 are used for the first two terms in G1, G2:
 3997:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 3998:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 3999:                // In general, cff1*Ustar - cff3*Ustar_alpha
 4000:                if(veg_h < 0.99*htot) { // submergent vegetation
 4001:                   cff1=1;
 4002:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 4003:                   cff3 = veg_c;
 4004: 
 4005:                } else { // emergent vegetation
 4006:                   cff1 = 1.0/(1.0 + veg_c2);
 4007:                   cff2 = cff1;
 4008:                   cff3 = 0.0;
 4009: 
 4010:                }
 4011:             } // if iveg
 4012:          } //  2D/3D
 4013: 
 4014:          av_cff1 += cff1/i34;
 4015:          av_cff2 += cff2/i34;
 4016:          av_cff3 += cff3/i34;
 4017:          av_cff2_chi += cff2*chi/i34;
 4018:          av_cff3_chi += cff3*chi/i34;
 4019:          av_df += min(htot, veg_h)/(htot*i34);
 4020: 
 4021: 
 4022:          // btrack values: U^\star, U^{\star\alpha}
 4023:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 4024:          Vector2 Ustar       = {0.0, 0.0}; 
 4025:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 4026:          for (int k = side->kb; k < nvrt; k++) {
 4027:             if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 4028:                Ustar += side->btu[nvrt]*side->Dz(k);
 4029: 
 4030:             } else { //3D
 4031:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 4032:                Ustar += w2;
 4033: 
 4034:                if constexpr(iveg != 0) {
 4035:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 4036:                        const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k)); // For the top of the canopy, ratio of the level that is below the canopy
 4037:                        Ustar_alpha += zrat*w2; // XXXX
 4038:                    }
 4039:                }  // if iveg
 4040:             }  //2/3D
 4041:          }  //k
 4042:          
 4043: 
 4044:          // Add btrack & surface stress terms to \breve{G} first
 4045:          if constexpr(ics==1) {
 4046:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 4047:          } else {
 4048:             // XXX IMPLEMENT THIS
 4049:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 4050:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 4051:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 4052:          }  // if ics
 4053: 
 4054:          // Surface and bottom stress terms
 4055:          if constexpr(ics==1) {
 4056:             const Vector2 tau    = side->tau();
 4057:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 4058: 
 4059:             // Term for surface and bottom stress
 4060:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 4061:          } else {
 4062:             // XXX IMPLEMENT THIS
 4063:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 4064:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 4065:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 4066:             // tau_x=(vn1+tt1)/2.d0
 4067:             // tau_y=(vn2+ss1)/2.d0
 4068:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 4069:          }  // if ics
 4070: 
 4071:          
 4072: 
 4073:          // All terms in F,F^\alpha,f_b except baroclinic
 4074:          // F, f_b: all explicit terms excluding vegetation 
 4075:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 4076:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 4077:          const double coriolis = side->coriolis;
 4078:          Vector2 F  =  coriolis*side->U;  // F_x
 4079:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 4080:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 4081: 
 4082:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 4083:             
 4084:             for (int k = side->kb; k < nvrt; k++) {
 4085:                if (zctr2 > side->zc[k-1]) {
 4086:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 4087:                    const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 4088:                    Fa +=  coriolis*w2*zrat;
 4089:                } // if zctr2
 4090:             } // k
 4091:          } // iveg
 4092: 
 4093:          // Integrate horizontal viscosity force vertically
 4094:          for (int k=side->kb + 1; k<nvrt; k++) {
 4095:             const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.0; 
 4096: 
 4097:             F += levelHorVisc;
 4098: 
 4099:             // Vegetation term
 4100:             if constexpr(iveg!=0) {
 4101:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 4102:                   const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 4103:                   Fa += levelHorVisc*zrat;
 4104:                } 
 4105:             } // if iveg
 4106:          } // for k
 4107: 
 4108:          fb += side->d2uv[side->kb];
 4109: 
 4110: 
 4111:          // Add to ghat1
 4112:          if constexpr(ics==2) {
 4113:             // XXX IMPLEMENT THIS
 4114:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4115:             // bigf1=vn1; bigf2=vn2
 4116:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4117:             // botf1=vn1; botf2=vn2
 4118:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4119:             // bigfa1=vn1; bigfa2=vn2
 4120:          } // if ics
 4121: 
 4122:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 4123:       } // for j (nodes and sides)
 4124: 
 4125:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 4126:          
 4127:       // Finish off terms in F, F^\alpha and f_b
 4128:       const double grav3 = elem->mean(&Node::grav2);
 4129:       const Vector2 fb = grav3*gradETP - gradPr/rho0; //const in each elem
 4130: 
 4131: 
 4132:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 4133:       for (int j=1; j<i34; j++) { 
 4134:          // For each side in the element...
 4135:          const Side *side = elem->sides[j];
 4136:          const double chi = side->chi;
 4137: 
 4138:          const double htot = side->htot();
 4139:          const double veg_h = side->veg_h();
 4140:          const Vector2 F  = htot*fb;
 4141:          const Vector2 Fa = min(htot, veg_h)*fb;
 4142: 
 4143:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 4144:       } // for j
 4145: 
 4146:       //botf1 etc are already in elem frame
 4147:       elem->ghat1 += tmp/i34;
 4148: 
 4149:       // Baroclinic force
 4150:       if constexpr(ibc==0) {
 4151:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 4152: 
 4153:          Vector2 Fa = {0.0, 0.0};
 4154:          Vector2 intGradRho = {0.0, 0.0};
 4155:          
 4156:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 4157:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 4158:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 4159: 
 4160:             // \in F [m^2/s/s]
 4161:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 4162:          }
 4163: 
 4164:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 4165:          const Vector2 F = av_df*Fa; //approx
 4166:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 4167: 
 4168:       } // if ibc
 4169: 
 4170:    }
 4171: 
 4172: } // extern "C"
 4173: 
 4174: 
