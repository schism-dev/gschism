  961: class Mesh {
  962:    public:  
  963: 
  964:    int partNum; // Partition number for this mesh.
  965: 
  966:    // Pointers to each GPU's local memory (size is the number of partitions).
  967:    Node**    nodes;  
  968:    Element** elems;  
  969:    Side**    sides;  
  970:    
  971:    // Local memory
  972:    Node*    localNodeData; 
  973:    Element* localElemData;
  974:    Side*    localSideData; 
  975: 
  976:    NodeBoundary *localNodeBoundaryMem; // Array of objects with the boundary information of each node
  977:    SideBoundary *localSideBoundaryMem; // Array of objects with the boundary information of each side
  978:    double       *coeffMatrixMem;       // Matrix coefficients for neighbors. [0..numNodes-1], doesn't include the diagonal
  979:    BoundarySegment *localSegmentMem;   // Array of objects with the boundary segments
  980:    
  981:    const int npgb;  // Global number of horizontal nodes
  982:    const int negb;  // Global number of elements
  983:    const int nsgb;  // Global number of sides
  984: 
  985:    const int np;   // Local number of horizontal nodes 
  986:    const int ne;   // Local number of elements
  987:    const int ns;   // Local number of sides
  988: 
  989:    int nbp;  // Local number of boundary nodes
  990: 
  991:    const int max_np; // Maximum number of horizontal nodes per partition (shared by all partitions)
  992:    const int max_ne; // Maximum number of elements per partition (shared by all partitions)
  993:    const int max_ns; // Maximum number of sides per partition (shared by all partitions)
  994: 
  995:   
  996:    // Additional topology information
  997:    Node    **nodeNeighNodes; // Array of pointers to the nodes neighbors of each node
  998:    Element **nodeNeighElems; // Array of pointers to the elements neighbors of each node
  999: 
 1000: 
 1001: 
 1002:    // Vertical coordinate system
 1003:    // Sigma levels
 1004:    double h_s; 
 1005:    double h_c; 
 1006:    int    kz;
 1007:    double theta_b;
 1008:    double theta_f, sinh_theta_f;
 1009:    double *sigma_lcl;
 1010:    double *sigma;
 1011:    double *ztot;
 1012:    double *cs;
 1013:    double *dcs;
 1014: 
 1015:    // // Get's the pointer to the node using the array of global pointers to nodes
 1016:    // __device__ const Node *getGlobalNode(int jn) {
 1017:    //    const int idx = jn / max_np; // Get the index of the partition that contains the node
 1018:    //    return nodes[idx] + idx;
 1019:    // }
 1020: 
 1021:    // // Get's the pointer to the element using the array of global pointers to elements
 1022:    // __device__ const Element *getGlobalElem(int je) {
 1023:    //    const int idx = je / max_ne; // Get the index of the partition that contains the element
 1024:    //    return elems[idx] + idx;
 1025:    // }
 1026: 
