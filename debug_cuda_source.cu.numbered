  978:    // }  
  979: 
  980:    __device__ Mesh(int partNum,
  981:                    int npgb, int negb, int nsgb, 
  982:                    int np, int ne, int ns, int nvrt, int kz,
  983:                    int max_np, int max_ne, int max_ns, int nseg,
  984:                    const Node **nodesPtr, const Element **elemsPtr, const Side **sidesPtr,
  985:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
  986:                    Node    **localNodeNeighNodesMem,
  987:                    Element **localNodeNeighElemsMem,
  988:                    NodeBoundary *localNodeBoundaryMem,
  989:                    SideBoundary *localSideBoundaryMem,
  990:                    BoundarySegment *localSegmentMem,
  991:                    double h_s, double theta_b, double theta_f, double *sigma_lcl, double *sigma, double *ztot,
  992:                    double *cs, double *dcs
  993:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
  994:                        np(np), ne(ne), ns(ns),
  995:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
  996:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
  997:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
  998:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
  999:                        localNodeBoundaryMem(localNodeBoundaryMem), localSideBoundaryMem(localSideBoundaryMem),
 1000:                        localSegmentMem(localSegmentMem),
 1001:                        h_s(h_s), theta_b(theta_b), theta_f(theta_f), sigma_lcl(sigma_lcl), sigma(sigma), ztot(ztot),
 1002:                        cs(cs), dcs(dcs)
 1003:    {
 1004:       printf("Mesh constructor for partition %d\n", partNum);
 1005:       
 1006:       sinh_theta_f = sinh(theta_f);
 1007: 
 1008:    }
