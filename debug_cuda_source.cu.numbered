 1246: // Helper functions for computing the local node index at a given offset from another.
 1247: __device__ __inline__ int nxq(int offset, int index, int size) {
 1248:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1249:    // to the index to make it positive
 1250:    assert(index + offset + 16*size >= 0);
 1251:    return (index + offset + 16*size) % size;  
 1252: }
 1253: 
 1254: __device__ __inline__ int nxq(int index, int size) {
 1255:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1256:    // to the index to make it positive
 1257:    assert(index + 16*size >= 0);
 1258:    return (index + 16*size) % size; 
 1259: }
