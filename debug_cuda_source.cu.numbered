 1279: // Helper functions for computing the local node index at a given offset from another.
 1280: __device__ __inline__ int nxq(int offset, int index, int size) {
 1281:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1282:    // to the index to make it positive
 1283:    assert(index + offset + 16*size >= 0);
 1284:    return (index + offset + 16*size) % size;  
 1285: }
 1286: 
 1287: __device__ __inline__ int nxq(int index, int size) {
 1288:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1289:    // to the index to make it positive
 1290:    assert(index + 16*size >= 0);
 1291:    return (index + 16*size) % size; 
 1292: }
