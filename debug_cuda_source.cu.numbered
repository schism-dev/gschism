 2128: //       yIntersect=-1.e25;
 2129: 
 2130: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 2131: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 2132: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 2133: 
 2134: //       if (delta != 0.0) {
 2135: //          // Solves the two linear equations for tt1 and tt2
 2136: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2137: //          const double tt2 = delta2/delta;
 2138: 
 2139: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 2140: //          // Similarly, we use tt2 to compute the intersection point.
 2141: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
