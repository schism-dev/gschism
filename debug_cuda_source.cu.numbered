 3218:    __global__ void computeElevationBoundaryConditions(double time) {
 3219:       // Compute elevation essential boundary conditions 
 3220: 
 3221:       NODE_BND(nodeBnd); // Each boundary node.
 3222: 
 3223:       const Node *node = nodeBnd->node;
 3224:       const int iettype = nodeBnd->iettype;
 3225: 
 3226:       double eic = 0.0;
 3227:       if (nramp_elev==1) eic = nodeBnd->etaic;
 3228:       else               eic = 0.0;
 3229: 
 3230:       const double r_eic = (1.0 - ramp)*eic; 
 3231:       const double r_eth = ramp*nodeBnd->eth;
 3232:       double eta1_bar = r_eic;
 3233: 
 3234:       // Compute tide elevation
 3235:       if (iettype == 3 || iettype == 5) {
 3236:         
 3237:          // XXX IMPLEMENT TIDE THINGS
 3238:          assert(false && "Tide elevation not implemented");
 3239:          // for (int jfr=0; jfr<nbfr; jfr++) { // For all tide frequencies
 3240:          //    const int ncyc = int(amig[jfr]*time/(2.0*pi));
 3241:          //    const double arg = amig[jfr]*time - 2.0*pi*ncyc + face[jfr] - efa[i,j,jfr];
 3242:          //    eta1_bar += ramp*ff[jfr]*emo[i,j,jfr]*cos(arg);
 3243:          // } // for jfr
 3244:       } // if iettype
 3245: 
 3246:       switch (iettype) {
 3247:          case 1:
 3248:          case 2:
 3249:             nodeBnd->elbc = r_eth + r_eic;
 3250:             break;
 3251:          case 3:
 3252:             nodeBnd->elbc = eta1_bar + r_eic;
 3253:             break;
 3254:          case 4:
 3255:             nodeBnd->elbc = r_eth + r_eic;
 3256:             break;
 3257:          case 5:
 3258:             nodeBnd->elbc = r_eth + eta1_bar + r_eic;
 3259:             break;
 3260:       } // switch
 3261: 
 3262: 
 3263:       //Add inverse barometric effects
 3264:       if (iettype != 0 && inv_atm_bnd == 1) {
 3265:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 3266:       }
 3267: 
 3268:    }
 3269: 
 3270:    __global__ void computeVerticallyIntegratedVelocity(void) {
 3271: 
 3272:       SIDE(side);
 3273: 
 3274:       printf("computeVerticallyIntegratedVelocity: side = %p, side->idx = %d\n", side, side->idx);
 3275: 
 3276:       side->U = {0.0, 0.0}; 
 3277:          
 3278:       if(side->isDry) return;
 3279: 
 3280:       const Node *node1 = side->n1;
 3281:       const Node *node2 = side->n2;
 3282: 
 3283:       // Vertically integrated velocity U (in ll if ics=2)
 3284:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 3285:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 3286:       }
 3287: 
 3288:    }
 3289: 
 3290:    __global__ void computeBottomDragVegetation(void) {
 3291:       // UNFINISHED. CHECK THIS:
 3292:       // How many kernels are needed? Why so many for loops?
 3293:       // Is the loop on sides needed?
 3294: 
 3295:       NODE(node);
 3296: 
 3297:       const int    kb      = node->kb;
 3298:       const double htot    = node->htot();
 3299:       const double rough   = node->rough;
 3300: 
 3301: 
 3302:       if (node->isDry) {
 3303:          // Default values for dry nodes
 3304:          node->veg_alpha_vert_mean = node->veg_alpha0;
 3305:          /// XXX CHECK INDICES
 3306:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 3307:       }
 3308: 
 3309:       // Compute bottom drag Cd
 3310:       //--------------------------------
 3311: 
 3312:       // nchi = {-1, 0, 1} is the type of bottom drag.
 3313:       if (nchi==1) {
 3314: 
 3315:          bool ltmp = false; // for WBL iteration
 3316: 
 3317:          // Cdmax=-1 !max. Cd at node for this process (info only)
 3318:          // Drag at nodes
 3319:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 3320:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 3321:         
 3322:          const double rough = node->rough;
 3323:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3324:          if (node->rough == 0.0) {
 3325:             node->Cd = 0.0;
 3326: 
 3327:          } else { //roughness >0 
 3328:             
 3329:             const double bthick_ori = node->znl[kb + 1] - node->znl[kb];  // thickness of bottom bnd layer
 3330:             const double bthick = max(dzb_min, bthick_ori);
 3331: 
 3332:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 3333: 
 3334:             double tmp = 1.0/(2.5*log(bthick/rough));
 3335:             node->Cd = tmp*tmp;
 3336: 
 3337:          } // if rough
 3338: 
 3339: 
 3340:          // RECOVER THIS: XXX
 3341:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 3342:          // Output warning for WBL if iteration didn't converge
 3343: 
 3344: 
 3345:       } // nchi==1
 3346: 
 3347:       //   Bottom stress in m^2/s^2
 3348:       if (node->rho[kb + 1] >= -98.0)
 3349:       {
 3350:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 3351:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 3352:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 3353:          // !sediment erosion: this part needs more documentation
 3354:       }
 3355: 
 3356:     
 3357:       // Compute vegetation parameters
 3358:       //--------------------------------
 3359: 
 3360:       // SAV constants
 3361:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 3362:       constexpr double veg_cfpsi = 0.16;
 3363: 
 3364:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 3365:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 3366: 
 3367:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 3368:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 3369:          int kbin = 0; // bin index
 3370:          for (int k = kb; k < nvrt; k++) {
 3371:             // Computes node height above the bottom level
 3372:             const double tmp_h = node->znl[k] - node->znl[kb]; // >=0
 3373:             assert(false && "Vertical variation of vegetation not implemented");
 3374: 
 3375:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 3376:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 3377:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 3378:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 3379:             // } else {
 3380:             //    // Find the bin at which the current vertical level is
 3381:             //    while (kbin<nbins_veg_vert) {
 3382:             //       const double zn = node->znl[kbin];
 3383:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 3384:             //          break;
 3385:             //       } // if
 3386:             //       kbin++;
 3387:             //    } // while
 3388:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 3389: 
 3390:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 3391:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 3392:                
 3393:             //    // Linear interpolation of the vegetation parameters
 3394:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 3395:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 3396:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 3397:             // } // if rl10
 3398: 
 3399:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 3400: 
 3401:          } // for k
 3402: 
 3403: 
 3404:       } else { // Ganthy (iveg=2)
 3405:       //  Modify canopy height, diameter, and density
 3406: 
 3407:          // Make sure there is vegetation on this node
 3408:          if (node->veg_h_unbent > 0.0) {
 3409:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 3410: 
 3411:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 3412:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 3413:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 3414: 
 3415:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 3416:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 3417:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 3418:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 3419:          } // if veg_h_unbent
 3420: 
 3421:          for (int k = 0; k < nvrt; k++) {
 3422:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 3423:          } // for k
 3424:       
 3425: 
 3426:       } // if iveg
 3427:      
 3428:          
 3429: 
 3430:       // Compute vertical mean of veg_alpha3D
 3431:       if (iveg != 0) {
 3432:          const double ztop = node->zTopCanopy(); // Top of the canopy
 3433:          double sum1=0.0;
 3434:          double sum2=0.0;
 3435:          // Integrate over each level under the canopy...
 3436:          for (int k=kb; k<nvrt-1 && node->znl[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 3437:             const double Dz = node->Dz(k);
 3438: 
 3439:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 3440:             sum2 += Dz;
 3441: 
 3442:          } // for k
 3443: 
 3444:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 3445:          else             node->veg_alpha_vert_mean = sum1/sum2;
 3446: 
 3447:       } // if iveg
 3448: 
 3449:       printf("computeBottomDragVegetation: nodeIdx = %d, node->veg_alpha_vert_mean = %f\n", node->idx, node->veg_alpha_vert_mean);
 3450: 
 3451:    }
 3452: 
 3453:    __global__ void computeVegetationAndDragParameters(void) {
 3454:       // Computes the vegetation and drag model parameters:
 3455:       // chi, \tilde\chi, beta, \breve{H}
 3456:       
 3457:       SIDE(side);
 3458: 
 3459:       const double htot = side->htot();
 3460:       const int    kb   = side->kb;
 3461: 
 3462:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 3463: 
 3464:       const double veg_h     = side->veg_h();
 3465:       const double veg_nv    = side->veg_nv();
 3466:       const double veg_c     = side->veg_c();
 3467:       const double veg_beta  = side->veg_beta;
 3468:       const double veg_alpha = side->veg_alpha_vert_mean();
 3469: 
 3470:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 3471:       // Velocity magnitude at the bottom level
 3472:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 3473:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 3474:       side->chi2 = side->Cd()*vmag1;
 3475:       side->chi  = side->chi2;
 3476:       if constexpr(iveg != 0) {
 3477:          const Node *n1 = side->n1;
 3478:          const Node *n2 = side->n2;
 3479:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 3480:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 3481:       }
 3482: 
 3483:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 3484: 
 3485:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 3486:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 3487:       double magUa = 0.0;
 3488:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 3489:          // 3D wet side with veg...
 3490: 
 3491:          double magUa = 0.0;
 3492:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 3493:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 3494: 
 3495:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 3496:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 3497:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 3498: 
 3499:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 3500:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 3501: 
 3502:                // Velocity magnitude at the bottom (l) of the level
 3503:                const double ul = length(side->u2[k]);
 3504: 
 3505:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 3506:                magUa += Dz*0.5*(uh + ul);
 3507: 
 3508:             } // if HasVegetation
 3509:          } // for k
 3510:          const double ua = magUa/min(htot, veg_h); // Vertical average
 3511: 
 3512:          // Computes beta, used for computing the stress term at the top of the canopy.      
 3513:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 3514:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 3515:             const double zCpy = side->zTopCanopy();
 3516:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 3517:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 3518:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 3519:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 3520:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 3521:          } // if isSubmerged
 3522:       } // if iveg   
 3523: 
 3524:       // Computes the friction modified depth, \breve{H} in notes
 3525:       if (side->is2D()) { // 2D
 3526: 
 3527:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 3528:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 3529: 
 3530:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 3531: 
 3532:          side->hhat = htot*htot/fricH; 
 3533: 
 3534:       } else { // 3D
 3535:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 3536: 
 3537:          if constexpr(iveg != 0) {
 3538:             
 3539:             if (side->isSubmerged()) { 
 3540:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 3541:                side->hhat -= veg_c*Hhat_alpha;
 3542: 
 3543:             } else { // Emergent
 3544:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 3545:             }
 3546:          } // if iveg
 3547: 
 3548:          // Enforce positivity for 3D model
 3549:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 3550:       } // if 3D
 3551: 
 3552:       printf("computeVegetationAndDragParameters: sideIdx = %d, side->htot = %f, side->hhat = %f\n", side->idx, side->htot(), side->hhat);
 3553: 
 3554:         
 3555:    }
 3556: 
 3557: 
 3558: 
 3559:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 3560:    // Computes the density gradient between two elements, e1 and e2.
 3561:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 3562:    // zero in the direction normal to the side. 
 3563:    // 
 3564:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 3565:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 3566:    //
 3567:    // Input:
 3568:    //    e1: Element
 3569:    //    e2: Neighbor element (or nullptr if boundary)
 3570:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 3571:    //    k: Index of the half-level at which the density is interpolated
 3572:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 3573:    // 
 3574:    // Output:
 3575:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 3576:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 3577: 
 3578:       if (e2 == nullptr || e2->isDry) {
 3579:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 3580: 
 3581:          Side *side = e1->sides[j];
 3582:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 3583:                  
 3584:          if constexpr(ics == 1) {
 3585:             vec = side->n; // Normal vector to the side
 3586:          } else {
 3587:             // IMPLEMENT THIS XXXXXX
 3588:             // !replace with xel, yel?
 3589:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 3590:             //      &eframe(:,:,i),xn1,yn1,tmp)
 3591:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 3592:             //      &eframe(:,:,i),xn2,yn2,tmp)
 3593:          } //ics
 3594:                    
 3595:          diffRho = 0.0;
 3596: 
 3597:       } else { //internal and wet
 3598:          if constexpr(ics==1) {
 3599:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 3600: 
 3601:             // Vector from e1 to e2
 3602:             vec = toVector2(e2->center - e1->center);
 3603: 
 3604:          } else { 
 3605:             // IMPLEMENT THIS XXXXXX
 3606:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 3607:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 3608:             //                   alow(j)=xctr2
 3609:             //                   bdia(j)=yctr2
 3610:          } // ics
 3611: 
 3612:          diffRho = rho2 - e1->demeanedDensity(k);
 3613:       }
 3614: 
 3615:    }
 3616: 
 3617:    __global__ void computeDensityCubicSplines(void) {
 3618:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 3619: 
 3620:       ELEM(elem);
 3621: 
 3622:       if (elem->isDry) return;
 3623: 
 3624:       const int kb = elem->kb;
 3625: 
 3626:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 3627:       if (elem->is2D()) {
 3628:          // In the 2D case, the density is constant at the prism level. 
 3629:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 3630:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 3631:       } else { //3D
 3632: 
 3633:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 3634:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 3635:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 3636:          ///// XXXX CHECK INDICES!!!!!
 3637:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 3638:       } // 2D/3D
 3639: 
 3640:    }
 3641: } // extern "C"
 3642: 
 3643: 
 3644: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 3645: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 3646: 
 3647:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 3648: 
 3649:    const int kb  = elem->kb;
 3650:    const int kb2 = elem2->kb;
 3651: 
 3652:    // z-coordinate of prism of elem
 3653:    const double zp = elem->z_prism(k);
 3654: 
 3655:    double rho = 0.0;
 3656: 
 3657:    if (elem2->is2D()) {
 3658:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 3659: 
 3660:    } else {  // 3D
 3661: 
 3662:       // eta_min may be < zmax
 3663:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 3664:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 3665: 
 3666:       // (Extrapolate density below bottom, we will fix it later)
 3667:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 3668:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 3669:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 3670:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 3671:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 3672:    } // 2D/3D
 3673:      
 3674: 
 3675:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 3676:    // Now we need to fix it.
 3677:    if (elem->z[k] < elem2->z[kb2]) {
 3678:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 3679: 
 3680:       // There are two methods to adjust the density at the bottom of the element.
 3681:       // iunder_deep=0: 
 3682:       const double depth1 = abs(elem->z[kb]); // larger depth
 3683: 
 3684:       if (iunder_deep==0) {
 3685: 
 3686:          const double weight = max(0.0, min(1.0, (depth1 - h1_bcc)/(h2_bcc - h1_bcc))); // weight
 3687: 
 3688:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 3689: 
 3690:       } else { // iunder_deep != 0
 3691: 
 3692:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 3693: 
 3694:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 3695: 
 3696:          //   Demeaned density at the same z coordinate as
 3697:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 3698:          }
 3699: 
 3700:       } // if iunder_deep
 3701:    } // if elem->z[kb] < elem2->z[kb]
 3702: 
 3703:    return rho;
 3704: }
 3705: 
 3706: 
 3707: extern "C" {
 3708:    __global__ void computeDensityGradient(void) {
 3709: 
 3710:          // Compute the horizontal density gradient at each element.
 3711:       // It works in two steps:
 3712:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 3713:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 3714:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 3715:       //             gradRho.r1 = rho1 - rho0
 3716:       //             gradRho.r2 = rho2 - rho0
 3717:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 3718:       // 
 3719:       //  NOTE: We use de-meaned densities.
 3720: 
 3721:       ELEM(elem);
 3722: 
 3723:       if (elem->isDry) return;
 3724: 
 3725:       const int kb  = elem->kb;
 3726:       const int i34 = elem->i34;
 3727: 
 3728:       for (int k = kb + 1; k < nvrt; k++) {
 3729:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 3730:          //             gradRho.r1 = rho1 - rho0
 3731:          //             gradRho.r2 = rho2 - rho0
 3732:          int icount = 0;
 3733:          double sumRx = 0.0;
 3734:          double sumRy = 0.0;
 3735:          for (int j1=0; j1<i34; j1++) { 
 3736: 
 3737:             const int j2 = elem->nxq(j1 + 1);
 3738: 
 3739:             // Pairs of consecutive neighbor elements of elem
 3740:             const Element *e1 = elem->nghbElems[j1];
 3741:             const Element *e2 = elem->nghbElems[j2];
 3742: 
 3743:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 3744:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 3745:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 3746: 
 3747:             // Compute the density difference and the vector from elem to e1 and e2
 3748:             // getRhoDiffAndVec takes into account boundaries/dry elements
 3749:             double diffRho1, diffRho2;
 3750:             Vector2 vec1, vec2;
 3751:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 3752:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 3753: 
 3754:             const double rl1 = length(vec1);
 3755:             const double rl2 = length(vec2);
 3756:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 3757: 
 3758:             const double delta = cross(vec1, vec2);
 3759:             const double sintheta = abs(delta)/(rl1*rl2);
 3760: 
 3761:             // To avoid problems, avoid elements with small angle between vectors
 3762:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 3763:             const bool validEq = (sintheta > sin_one_deg);
 3764: 
 3765:             if (validEq) {
 3766:                // Solve the system of equations to get the density gradient at elem
 3767:                icount++;
 3768:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 3769:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 3770:                sumRx += Rx;
 3771:                sumRy += Ry;
 3772:             }
 3773:          } // for j1
 3774: 
 3775:          // Compute the average density gradient at elem
 3776:          if (icount==0) {
 3777:            // Bad mesh quality; bail out with 0 b-cc
 3778:            elem->gradRho[k] = {0.0, 0.0};
 3779:          } else {
 3780:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 3781:          }
 3782: 
 3783:       } // for k
 3784: 
 3785:    }
 3786: 
 3787:    __global__ void computeBaroclinicTerm(void) {
 3788:    // Computes the baroclinic term at sides (at half levels).
 3789:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 3790:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 3791: 
 3792:       SIDE(side);
 3793: 
 3794:       if (side->isDry) return;
 3795: 
 3796:       const Element *e1 = side->elems[0];
 3797:       const Element *e2 = side->elems[1];      
 3798:       const int kb = side->kb;
 3799:       
 3800:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 3801: 
 3802:       // interpolates vertically the density gradient of the two elements at the half level/
 3803: 
 3804:       // Starts the integration at the surface and goes down to the bottom
 3805:       int k1 = nvrt - 1;
 3806:       int k2 = nvrt - 1;
 3807: 
 3808:       side->bcc[nvrt-1] = {0.0, 0.0};
 3809:       for (int k = nvrt-1; k >= kb; k--) {
 3810:       // For each prism level (from surface to bottom)...
 3811: 
 3812:          // For both elements, interpolate density gradient at the side's half level.
 3813:          // The gradient at the side is the average of the gradients at the elements.
 3814:          // w1, w2 are used to take into account boundary sides, with just one element.
 3815:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 3816:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 3817:          const double wsum = w1 + w2;
 3818:          w1 = w1/wsum;
 3819:          w2 = w2/wsum;
 3820:          printf("w1 = %f, w2 = %f\n", w1, w2);
 3821:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 3822: 
 3823:          // Linear interpolation of both elements' density gradient at the shared side's level.
 3824:          Vector2 gradRho = {0.0, 0.0};
 3825:          if (e1 != nullptr && k > kb) {
 3826:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 3827:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 3828:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 3829:             
 3830:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 3831:          }      
 3832:          if (e2 != nullptr && k > kb) {
 3833:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 3834:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 3835:             
 3836:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 3837:          }
 3838: 
 3839:          if constexpr(ics==2) {
 3840:             // IMPLEMENT THIS XXXXXX
 3841:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 3842:             // swild(1)=tmp1
 3843:             // swild(2)=tmp2
 3844:          }
 3845:          
 3846:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 3847:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 3848:          // CHECK INDICES!!! XXX
 3849:          const double grav3 = 0.5*(side->n1->grav2 + side->n2->grav2);
 3850:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 3851:       } // for
 3852: 
 3853:    }
 3854: 
 3855: } // extern "C"
 3856: 
 3857: #ifdef DONTCOMPILE
 3858: __device__ void computeVerticalAdvection(void) {
 3859:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 3860: 
 3861:    sdbt(1:2,:,:)=0.d0
 3862: 
 3863:    const Side *side = FROM kernel;
 3864: 
 3865:    if(side->isDry) return;
 3866: 
 3867:    // If side is wet...
 3868: 
 3869: 
 3870:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 3871:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 3872:    double ws[nvrt] = {} // w @ side
 3873:    int icount = 0;
 3874:    for (int j=0; j<2; j++) {
 3875:       const Element *elem = side->elements[j];
 3876:        
 3877:       if(elem != nullptr) {
 3878:          icount++;
 3879:          for (int k=0; k<nvrt; k++) {
 3880:             ws[k] = ws[k] + elem->w[k];
 3881:          }
 3882:       }
 3883:    }  // for j
 3884: 
 3885:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 3886:    ws = ws/icount;
 3887: 
 3888:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 3889:    // Splines allow for a smooth transition between vertical levels.
 3890:    // Splines have continuity restrictions at the internal knots, but
 3891:    // we have to provide the 1st derivatives at the endpoints.
 3892:    const int kbs = side->kbs; 
 3893:    
 3894:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3895:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3896:    initCubicSpline(kbs, nvrt, side, ws, up)
 3897: 
 3898:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3899:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3900:    initCubicSpline(kbs, nvrt, side, ws, vp)
 3901: 
 3902:    // Total advection (average onto side)
 3903:    const Node *node1 = side->nodes[0];
 3904:    const Node *node2 = side->nodes[1];
 3905:    for (int k=kbs(i); k<nvrt; k++) {
 3906: 
 3907:       if constexpr(ics==1) {
 3908:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 3909:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 3910:       } else {
 3911:          // XXX IMPLEMENT THIS
 3912:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 3913:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 3914:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 3915:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 3916:       }  // if ics
 3917: 
 3918: 
 3919:    }
 3920: }
 3921: #endif
 3922: 
 3923: 
 3924: extern "C" {
 3925:    __global__ void computeElemAverageGhat(void) {
 3926:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 3927: 
 3928:       ELEM(elem);
 3929:       
 3930:       elem->ghat1= {0.0, 0.0};  
 3931: 
 3932:       if constexpr(ihydraulics != 0) {
 3933:          if (nhtblocks > 0 && elem->isblock) return;
 3934:       }
 3935: 
 3936:       if (elem->isDry) return;
 3937: 
 3938:       // Wet elements.
 3939:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 3940:       // tidal potential, horizontal diffusion, and baroclinic etc
 3941:       // Remember to update both fb and F 
 3942:       // If ics=2, ghat1 are in eframe (ll)
 3943:       // cff1-3: coefficients for 2D/3D
 3944:       Vector2 gradEta = {0.0, 0.0};  // \nabla \eta
 3945:       Vector2 gradPr  = {0.0, 0.0};  // \nabla pressure
 3946:       Vector2 gradETP = {0.0, 0.0};  // \nabla etp
 3947: 
 3948:       double av_cff1 = 0.0;  // av. for cff1
 3949:       double av_cff2 = 0.0;  // av. for cff2
 3950:       double av_cff3 = 0.0;  // av. for cff3
 3951:       double av_df = 0.0;  // av. for H^\alpha / H
 3952:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 3953:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 3954: 
 3955:       const int i34 = elem->i34;
 3956:       const int kb = elem->kb;
 3957: 
 3958:       for (int j=1; j<i34; j++) {
 3959:          // For each node and side in the element...
 3960: 
 3961:          const Node *node = elem->nodes[j];
 3962:          const Side *side = elem->sides[j];
 3963: 
 3964:          const double chi      = side->chi;
 3965:          const double veg_c2   = side->veg_c2;
 3966:          const double veg_beta = side->veg_beta;
 3967:          const double veg_h    = side->veg_h();
 3968:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 3969: 
 3970:          // Node - const in elem
 3971:          gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 3972:          gradPr  += node->pr  *elem->gradPhi[j];
 3973: 
 3974:          if (elem->depth >= tip_dp) {
 3975:            gradETP += node->ETP*elem->gradPhi[j];
 3976:          }
 3977: 
 3978:          
 3979:          const double htot  = side->htot();        // Total depth at the side
 3980:          const double zctr2 = side->zTopCanopy();  
 3981: 
 3982:          double cff1; 
 3983:          double cff2; 
 3984:          double cff3;   
 3985:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 3986:          // coefficients applied to 2D/3D case 
 3987:             cff1 = side->hhat/htot;
 3988:             cff2 = 0.0;
 3989:             cff3 = 0.0;
 3990:          } else { //3D
 3991:             //Init for no-veg case
 3992:             cff1 = 1.0;
 3993:             cff2 = 1.0;
 3994:             cff3 = 0.0;
 3995: 
 3996:             if constexpr(iveg != 0) {
 3997:                // Computes coefficients used with vegetation terms G1, G2
 3998:                // cff1, cff3 are used for the first two terms in G1, G2:
 3999:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 4000:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 4001:                // In general, cff1*Ustar - cff3*Ustar_alpha
 4002:                if(veg_h < 0.99*htot) { // submergent vegetation
 4003:                   cff1=1;
 4004:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 4005:                   cff3 = veg_c;
 4006: 
 4007:                } else { // emergent vegetation
 4008:                   cff1 = 1.0/(1.0 + veg_c2);
 4009:                   cff2 = cff1;
 4010:                   cff3 = 0.0;
 4011: 
 4012:                }
 4013:             } // if iveg
 4014:          } //  2D/3D
 4015: 
 4016:          av_cff1 += cff1/i34;
 4017:          av_cff2 += cff2/i34;
 4018:          av_cff3 += cff3/i34;
 4019:          av_cff2_chi += cff2*chi/i34;
 4020:          av_cff3_chi += cff3*chi/i34;
 4021:          av_df += min(htot, veg_h)/(htot*i34);
 4022: 
 4023: 
 4024:          // btrack values: U^\star, U^{\star\alpha}
 4025:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 4026:          Vector2 Ustar       = {0.0, 0.0}; 
 4027:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 4028:          for (int k = side->kb; k < nvrt; k++) {
 4029:             if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 4030:                Ustar += side->btu[nvrt]*side->Dz(k);
 4031: 
 4032:             } else { //3D
 4033:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 4034:                Ustar += w2;
 4035: 
 4036:                if constexpr(iveg != 0) {
 4037:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 4038:                        const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k)); // For the top of the canopy, ratio of the level that is below the canopy
 4039:                        Ustar_alpha += zrat*w2; // XXXX
 4040:                    }
 4041:                }  // if iveg
 4042:             }  //2/3D
 4043:          }  //k
 4044:          
 4045: 
 4046:          // Add btrack & surface stress terms to \breve{G} first
 4047:          if constexpr(ics==1) {
 4048:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 4049:          } else {
 4050:             // XXX IMPLEMENT THIS
 4051:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 4052:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 4053:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 4054:          }  // if ics
 4055: 
 4056:          // Surface and bottom stress terms
 4057:          if constexpr(ics==1) {
 4058:             const Vector2 tau    = side->tau();
 4059:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 4060: 
 4061:             // Term for surface and bottom stress
 4062:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 4063:          } else {
 4064:             // XXX IMPLEMENT THIS
 4065:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 4066:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 4067:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 4068:             // tau_x=(vn1+tt1)/2.d0
 4069:             // tau_y=(vn2+ss1)/2.d0
 4070:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 4071:          }  // if ics
 4072: 
 4073:          
 4074: 
 4075:          // All terms in F,F^\alpha,f_b except baroclinic
 4076:          // F, f_b: all explicit terms excluding vegetation 
 4077:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 4078:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 4079:          const double coriolis = side->coriolis;
 4080:          Vector2 F  =  coriolis*side->U;  // F_x
 4081:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 4082:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 4083: 
 4084:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 4085:             
 4086:             for (int k = side->kb; k < nvrt; k++) {
 4087:                if (zctr2 > side->zc[k-1]) {
 4088:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 4089:                    const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 4090:                    Fa +=  coriolis*w2*zrat;
 4091:                } // if zctr2
 4092:             } // k
 4093:          } // iveg
 4094: 
 4095:          // Integrate horizontal viscosity force vertically
 4096:          for (int k=side->kb + 1; k<nvrt; k++) {
 4097:             const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.0; 
 4098: 
 4099:             F += levelHorVisc;
 4100: 
 4101:             // Vegetation term
 4102:             if constexpr(iveg!=0) {
 4103:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 4104:                   const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 4105:                   Fa += levelHorVisc*zrat;
 4106:                } 
 4107:             } // if iveg
 4108:          } // for k
 4109: 
 4110:          fb += side->d2uv[side->kb];
 4111: 
 4112: 
 4113:          // Add to ghat1
 4114:          if constexpr(ics==2) {
 4115:             // XXX IMPLEMENT THIS
 4116:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4117:             // bigf1=vn1; bigf2=vn2
 4118:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4119:             // botf1=vn1; botf2=vn2
 4120:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4121:             // bigfa1=vn1; bigfa2=vn2
 4122:          } // if ics
 4123: 
 4124:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 4125:       } // for j (nodes and sides)
 4126: 
 4127:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 4128:          
 4129:       // Finish off terms in F, F^\alpha and f_b
 4130:       const double grav3 = elem->mean(&Node::grav2);
 4131:       const Vector2 fb = grav3*gradETP - gradPr/rho0; //const in each elem
 4132: 
 4133: 
 4134:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 4135:       for (int j=1; j<i34; j++) { 
 4136:          // For each side in the element...
 4137:          const Side *side = elem->sides[j];
 4138:          const double chi = side->chi;
 4139: 
 4140:          const double htot = side->htot();
 4141:          const double veg_h = side->veg_h();
 4142:          const Vector2 F  = htot*fb;
 4143:          const Vector2 Fa = min(htot, veg_h)*fb;
 4144: 
 4145:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 4146:       } // for j
 4147: 
 4148:       //botf1 etc are already in elem frame
 4149:       elem->ghat1 += tmp/i34;
 4150: 
 4151:       // Baroclinic force
 4152:       if constexpr(ibc==0) {
 4153:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 4154: 
 4155:          Vector2 Fa = {0.0, 0.0};
 4156:          Vector2 intGradRho = {0.0, 0.0};
 4157:          
 4158:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 4159:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 4160:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 4161: 
 4162:             // \in F [m^2/s/s]
 4163:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 4164:          }
 4165: 
 4166:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 4167:          const Vector2 F = av_df*Fa; //approx
 4168:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 4169: 
 4170:       } // if ibc
 4171: 
 4172:    }
 4173: 
 4174: } // extern "C"
 4175: 
 4176: 
 4177: 
 4178: #ifdef DONTCOMPILE
 4179: __global__ void checkMassConservation(Tracers* sumtr) {
 4180: 
 4181:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 4182: 
 4183:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 4184: 
 4185:    Element *elem = &(mesh->localElemData[i]);
 4186: 
 4187:    // Skip dry elements
 4188:    if (elem->isDry) return;
 4189: 
 4190:    // Local sum array for this thread
 4191:    double localSum[N_TRACERS] = {0.0};
 4192: 
 4193:    // Sum over vertical levels for this element
 4194:    const int kbe = elem->kbe;
 4195:    const double area = elem->area;
 4196: 
 4197:    for (int k = kbe; k < nvrt; k++) {
 4198:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 4199:       
 4200:       // Accumulate tracer mass
 4201:       for (int tr = 0; tr < N_TRACERS; tr++) {
 4202:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 4203:       }
 4204:    }
 4205: 
 4206:    
 4207: 
 4208:    //  This function returns per element sums. A reduction must be done on the host side.
 4209: }
 4210: 
 4211: 
 4212: __global__ void transport(void) {
 4213: 
 4214:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 4215: 
 4216:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 4217: 
 4218:    Element *elem = &(mesh->localElemData[ie]);
 4219: 
 4220:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 4221: 
 4222:                for (int m=0; m<ntr; m++) {
 4223:                   for (int k=kbe(ie); k<nvrt; k++) {
 4224:                      // Calculate each polynomial's weight 
 4225:                      wm=0.d0; sum1=0.d0; 
 4226:                      wm1=0.d0; wm2=0.d0; 
 4227:                      for (int i=0; i<elem->nweno2; i++) {
 4228:                   
 4229:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4230:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4231:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4232:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4233:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4234:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 4235:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 4236:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 4237:                      // -----------------Hu and Shu (1999)'s method----------------
 4238:                      b4=b1+b2+b3
 4239: 
 4240: //Error: add PRODUCTION CPP
 4241: #ifdef DEBUG
 4242:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 4243:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 4244:                     call parallel_abort(errmsg)
 4245:                   }
 4246: #endif
 4247: 
 4248:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 4249:                   // !----test-------------- 
 4250:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 4251:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 4252:                   // !wm(i)=wm1(i)*wm2(i)
 4253:                   // !---------------------- 
 4254:                   sum1=sum1+wm(i)
 4255:                 } // end for i
 4256: 
 4257:                 wm=wm/sum1
 4258: 
 4259:                 for (int j=0; j<elem->i34; j++) {
 4260: 
 4261:                   const Side *side  = elem->sides[j];
 4262:                   const Node *node1 = side->n1;
 4263:                   const Node *node2 = side->n2;
 4264: 
 4265:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 4266:                      trsd=0.d0
 4267:                      for (int kk=0; kk<nquad; kk++) {
 4268:                         for (int i=0; i<elem->nweno2; i++) {
 4269:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4270:                         } // end for i   
 4271:                      } // end for kk
 4272:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 4273:                   } // outward flux
 4274:                } // end for j=1,i34(ie) ! side
 4275:             }
 4276:          }
 4277:               
 4278: 
 4279: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 4280: //             //   calculate each polynomial's weight 
 4281: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 4282: //                 wm=0.d0; sum1=0.d0
 4283: //                 do i=1,nweno1(ie) !for each polynomial
 4284: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
