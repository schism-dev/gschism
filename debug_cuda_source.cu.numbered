 2817: __device__ void computeVerticallyIntegratedVelocity(void) {
 2818: 
 2819:    Side *side = SIDE_PTR;
 2820: 
 2821:    side->U = {0.0, 0.0}; 
 2822:       
 2823:    if(side->idry) return;
 2824: 
 2825:    const Node *node1 = side->n1;
 2826:    const Node *node2 = side->n2;
 2827: 
 2828:    // Vertically integrated velocity U (in ll if ics=2)
 2829:    for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 2830:       side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 2831:    }
 2832: 
 2833: }
