 1246: 
 1247: /**
 1248:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1249:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1250:    If the segment is completely inside the element, then it returns true.
 1251: 
 1252:    This function assumes:
 1253:    - The initial point is on a side of the element. 
 1254:    - Its position is given by parameter t in the range [0,1].
 1255:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1256:       intersects the element (elements are convex).
 1257: 
 1258:    To find the intersection point, this function does the following:
 1259:    - it finds the intersection of the line segment with all the element side lines,
 1260:       except for the one that contains the initial point.
 1261:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1262:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1263:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1264:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1265:       track segment is almost parallel to the element side line.
 1266: 
 1267:    Inputs:
 1268:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1269:    @param x2, y2: other end of the line segment
 1270: 
 1271:    Outputs:
 1272:    @param side:  side that intersects the line segment (input and output)
 1273:    @param nextElement (output): element that contains the intersection point
 1274:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1275:    @param zint (input/output): Vertical coordinate of the intersection point
 1276: 
 1277:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1278:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1279:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1280: 
 1281:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1282:    (Delta) being zero.
 1283: 
 1284:    The intersection2 point happens when:
 1285:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1286:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1287:    
 1288:    Assumption: the 4 points (including those of the side segment) are different.
 1289:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1290:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1291:    If true, (xIntersect,yIntersect) is the intersection.				
 1292:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1293: **/
 1294: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1295:                                               double &t, double& tIntersect) {
 1296: 
 1297:    double closest_intersect_t = 1e10;
 1298:    bool found_intersection = false;
 1299: 
 1300:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1301:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1302:    const Point2 x1 = side->point(t);
 1303:    
 1304: 
 1305:    Side *nextSide = nullptr;
 1306: 
 1307:    for (int i = 0; i < i34; i++) {
 1308: 
 1309:       // Element's i-th side 
 1310:       Side *side2 = sides[i];
 1311: 
 1312:       // Skip the side that contains the initial point
 1313:       if (side2 == side) continue;
 1314: 
 1315:       // (x3,y3)-(x4,y4) is the element side line
 1316:       const Point2 x3 = side2->n1->p2();
 1317:       const Point2 x4 = side2->n2->p2();
 1318: 
 1319:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1320:       const double delta = cross(x2 - x1, x3 - x4);
 1321: 
 1322:       if (delta != 0.0) {
 1323: 
 1324:          const double delta1 = cross(x3 - x1, x3 - x4);
 1325:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1326: 
 1327:          // Solves the two linear equations for tt1 and tt2
 1328:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1329:          const double tt2 = delta2/delta;
 1330: 
 1331:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1332:             closest_intersect_t = min(closest_intersect_t, tt1);
 1333:             nextSide = side2;
 1334: 
 1335:             nextElement = nextSide->otherElem(this);
 1336:             tIntersect = max(small, min(tt1, 1.0-small));
 1337:             t = tt2;
 1338: 
 1339:             found_intersection = true;
 1340:          }
 1341:       
 1342:       }
 1343: 
 1344:    }
 1345: 
 1346: 
 1347:    // found_intersection should always be true, since we checked all the sides.  
 1348:    side = nextSide;
 1349: // if (found_intersection) {
 1350: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1351: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1352: // }   
 1353:    return found_intersection;
 1354: }
 1355: 
 1356: 
 1357: 
 1358: 
 1359: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1360:                                               double &t, double& tIntersect) {
 1361: 
 1362:    double closest_intersect_t = 1e10;
 1363:    bool found_intersection = false;
 1364: 
 1365:    for (int i = 0; i < i34; i++) {
 1366: 
 1367:       Side *side2 = sides[i];
 1368: 
 1369:       // (x3,y3)-(x4,y4) is the element side line
 1370:       const Point2 x3 = side2->n1->p2();
 1371:       const Point2 x4 = side2->n2->p2();
 1372: 
 1373:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1374:       const double delta = cross(x2 - x1, x3 - x4);
 1375: 
 1376:       if (delta != 0.0) {
 1377: 
 1378:          const double delta1 = cross(x3 - x1, x3 - x4);
 1379:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1380: 
 1381:          // Solves the two linear equations for tt1 and tt2
 1382:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1383:          const double tt2 = delta2/delta;
 1384: 
 1385:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1386:             closest_intersect_t = min(closest_intersect_t, tt1);
 1387:             side = side2;
 1388:             nextElement = side->otherElem(this);
 1389:             t = tt2;
 1390:             tIntersect = max(small, min(tt1, 1.0-small));
 1391:             found_intersection = true;
 1392:          }
 1393:       
 1394:       }
 1395: 
 1396:    }
 1397: 
 1398: // if (found_intersection) {
 1399: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1400: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1401: // }
 1402: 
 1403:    // found_intersection should always be true, since we checked all the sides.  
 1404:    return found_intersection;
 1405: }
 1406: 
 1407: 
 1408: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1409:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1410: 
 1411:    printf("Tracking segment goes out of water at element %d\n", curElem->idx);
 1412: 
 1413:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1414:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1415:    // curElement.
 1416: 
 1417:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1418:    // And uses this velocity instead to continue the tracking.
 1419: 
 1420:    // computes the intersection point in cartesian coordinates
 1421:    Point2 intersection = nextSide->p_t(tt);
 1422: 
 1423:    // Nudges the point to the barycenter of the element. 
 1424:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1425:    // next segment intersects the element sides.  
 1426:    curElem->nudgeToBarycenter(intersection);
 1427: 
 1428:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1429:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1430:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1431:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1432: 
 1433:    // If the side is an open boundary, the tangential velocity is zero.
 1434:    if (nextSide->isBnd()) vtan = 0.0;
 1435: 
 1436:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1437:    const double us = vtan*nextSide->t().x;
 1438:    const double vs = vtan*nextSide->t().y;
 1439:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1440: 
 1441:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1442:    const double len2 = length(intersection - toPoint2(xt));
 1443:    const double vel2 = u_int.x*u_int.x + u_int.y*u_int.y;        
 1444:    assert(vel2 > 0.0 && "Zero velocity found");
 1445:    dt = dt - sqrt(len2/vel2); 
 1446: 
 1447:    // The end of this tracking segment is now the intersection point.
 1448:    xt = {intersection.x, intersection.y, zint};
 1449:    
 1450:    u_int = {us, vs, ws};
 1451:    
 1452: }
 1453: 
 1454: /**
 1455:  * Tracks a particle through elements and vertical levels in the mesh.
 1456:  * 
 1457:  * @param x0,y0,z0     Starting position coordinates
 1458:  * @param xt,yt,zt     Target position coordinates
 1459:  * @param dtb          Time step for tracking
 1460:  * @param uuint,vvint,wwint Initial velocity components
 1461:  * @param nextElem     Starting/resulting element index
 1462:  * 
 1463:  * @return Status code of type trackExitCodes
 1464:  * 
 1465:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1466:  * of the details are different. The idea is that the code requires less branches and is better fit
 1467:  * for GPU execution.
 1468:  * 
 1469:  * The main ideas here are:
 1470:  * - The starting point is expected to be in the starting element.
 1471:  * - The end point is guaranteed to be inside an element.
 1472:  * - since the starting point is inside the element, there are only two cases: 
 1473:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1474:  *     (b) it does not and (xt,yt) is already in the starting element.
 1475:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1476:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1477:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1478:  * - tt1 can be positive or negative. We only consider the positive values.
 1479:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1480:  * - The next intersection will occur at the smallest positive tt1.
 1481:  * - This intersection will be the next (x0,y0) position.
 1482:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1483:  *   of getting stuck in a loop.
 1484:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1485:  *   was found.
 1486:  */
 1487: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1488:                                                        Element *&nextElem, int &jlev, double &dt) {
 1489: 
 1490:    // First thing is to check if the target point is inside the element. If it is there is nothing
 1491:    // else to do.
 1492:    if (containsPoint(toPoint2(xt))) {
 1493:       nextElem->interpolateVelocities(xt, u_int);
 1494:       return true;
 1495:    }
 1496: 
 1497:    Side *side = nullptr;
 1498: 
 1499:    // 1. Initial checks
 1500:    // Verify starting element is valid (wet)
 1501:    assert(!nextElem->isDry && "Starting element is dry");
 1502: 
 1503:    // Checks if track has a zero length.
 1504:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1505:    assert(len2 > 0.0 && "Zero length track"); 
 1506:    
 1507: 
 1508:    const int MAX_ITERATIONS = 1000;
 1509:    
 1510:    double t;
 1511:    Side *nextSide = nullptr;
 1512:    double tIntersect = 1e10;
 1513:    double zint = x0.z;
 1514: 
 1515:    // Horizontal tracking loop
 1516:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1517:    // (x0,y0) is inside the element but the target point is not.
 1518:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1519:    if (!found_intersection) printf("No intersection found at %d, x0 = %f, y0 = %f, xt = %f, yt = %f\n", nextElem->idx, x0.x, x0.y, xt.x, xt.y);
 1520:    assert(found_intersection && "No intersection found at %d");
 1521: 
 1522:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1523: 
 1524:    // if the tracking segment goes out of water (either dry or edge boundary)
 1525:    if (isEdgeBoundary(nextSide) || (nextElem->isDry)) {
 1526:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1527:       nextElem = this;
 1528:       
 1529:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1530:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1531:       return true;    
 1532:       }
 1533: 
 1534:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1535:    int iterations = 0;
 1536:    while (iterations < MAX_ITERATIONS) {
 1537:       iterations++;
 1538:       
 1539:       Element *curElem = nextElem;
 1540: 
 1541:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1542:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1543: 
 1544:       // If we are already in the target element, we are done.
 1545:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1546:       if (!found_intersection) break;
 1547: 
 1548: 
 1549:   
 1550:       // if the tracking segment goes out of water (either dry or edge boundary).
 1551:       if (curElem->isEdgeBoundary(nextSide) || (nextElem->isDry)) {
 1552: 
 1553:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1554: 
 1555:          nextElem = curElem;
 1556: 
 1557:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1558:          // In this case, the caller (btrack) needs to take into account the remaining time.
 1559:          return true;
 1560:       }
 1561:       
 1562:       // Update position and element for next iteration
 1563:       side = nextSide;
 1564: 
 1565:    }
 1566: 
 1567: 
 1568:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 1569: 
 1570:  
 1571:    // Interpolate velocities at the final position. This is a conceptually simple step,
 1572:    // but the function is not simple, because it has to search for the vertical level containing zt.
 1573:    nextElem->interpolateVelocities(xt, u_int);
 1574: 
 1575: 
 1576:    return true;
 1577: }
 1578: 
 1579: 
 1580: 
 1581: 
 1582: __inline__ __device__ double Element::computeSignedArea(void) const {
 1583:    // Compute the area of the element
 1584: 
 1585:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 1586: 
 1587:    // In the quad case we need to add the area of the other triangle.
 1588:    if (isQuad()) {
 1589:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1590:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 1591:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1592:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 1593:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 1594:          Error("Negative area found in quad element");
 1595:       }
 1596:       res += ar1;
 1597:    }
 1598: 
 1599:    return res;
 1600: }
 1601: 
 1602: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 1603:    // In boundary sides, the element 1 is nullptr
 1604:    return side->elems[1] == nullptr; 
 1605: }
 1606: 
 1607: /**
 1608:    Compute the shape coordinates of the point (xt,yt) in the element.
 1609:    @param xt (input): x-coordinate of the point
 1610:    @param shpCoords (output): shape coordinates of the point
 1611:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 1612:    @return true if the point is inside the element, false otherwise
 1613: **/
 1614: __device__ bool Element::computeShapeCoords(Point2 xt, double shpCoords[4],
 1615:                                             bool fixNegshpCoord) const {
 1616: 
 1617:    // Compute the shape coordinates of the point xt in the element.
 1618:    if (i34==3) {
 1619:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 1620:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 1621:       // and in this case, the pt will be nudged into the element
 1622:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 1623:       // from the local frame, so use additional check.
 1624: 
 1625:       Point2 x0, x1, x2;
 1626: 
 1627:       if constexpr(ics==1) {
 1628:          x0 = nodes[0]->p2();
 1629:          x1 = nodes[1]->p2();
 1630:          x2 = nodes[2]->p2();
 1631:       }
 1632:       else // lat/lon
 1633:       {
 1634:          Error("Not implemented yet");
 1635: #ifdef ICS2
 1636:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 1637:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 1638:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 1639: #endif
 1640:       }
 1641: 
 1642:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 1643:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 1644:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 1645:       shpCoords[3] = 0.0;
 1646:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 1647: 
 1648:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 1649:       // then we fix the negative shape coordinates.
 1650:       if (fixNegshpCoord && tmpmin<=0.0) {
 1651: 
 1652:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 1653:          // keeping the sum of the shape coordinates equal to 1.
 1654:          // I have tested and compared the new algorithm with the old one, and they give
 1655:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 1656:          // The new algorithm should be faster since it is branchless.
 1657:          const double a = - tmpmin + 1.0e-2;  // XXX it used to be 1.0e-4 in the comments of the original code
 1658:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 1659:          
 1660:          shpCoords[0] = (shpCoords[0] + a)*b;
 1661:          shpCoords[1] = (shpCoords[1] + a)*b;
 1662:          shpCoords[2] = (shpCoords[2] + a)*b;          
 1663: 
 1664:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 1665:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 1666:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 1667:          }
 1668: 
 1669:          // Update the point coordinates for the new shape coordinates
 1670:          double xcoords[3] = {x0.x, x1.x, x2.x};
 1671:          double ycoords[3] = {x0.y, x1.y, x2.y};
 1672:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 1673: 
 1674:       }
 1675: 
 1676:       // Check if the point is inside the element
 1677:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 1678:    }
 1679:    else {
 1680:       Error("Not implemented yet");
 1681: #ifdef QUADS
 1682:       // Reproject pt in eframe of nel for ics=2
 1683:       if constexpr(ics==1) {
 1684:          xn2 = xt; 
 1685:          yn2 = yt;
 1686:       }
 1687:       else {
 1688:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 1689:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 1690:       }
 1691: 
 1692:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 1693: #endif
 1694:    }
 1695: 
 1696: }
 1697: 
 1698: 
 1699: /**  Interpolate velocities at a given point (xt,yt,zt)
 1700: 
 1701:    @param xt, yt, zt: coordinates of the point to interpolate
 1702:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 1703: 
 1704:    This is done in four steps:
 1705: 
 1706:    1. Find the shape coordinates for the final position in the element.
 1707:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 1708:    3. Perform a *binary search* to find the vertical level containing zt. It will have to interpolate the 
 1709:       z levels at xt, yt at each step.   
 1710:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 1711:       horizontally and vertically.
 1712: **/
 1713: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) {
 1714:    // Interpolate the velocities at the point xt. 
 1715:    // This function works the same for triangular and quadrilateral elements.
 1716:    double shpCoord[4];
 1717: 
 1718: 
 1719:    // First step is to compute the shape coordinates of (xt,yt)
 1720:    computeShapeCoords(toVector2(xt), shpCoord, false);
 1721:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 1722: 
 1723:    // Second step is to find the level that contains zt
 1724:    // Uses a binary search to find the level
 1725:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 1726:    int L = kbe;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 1727:    int R = nvrt - 1;
 1728: 
 1729:    // Get the z coordinates at the nodes of the element at the levels L and R
 1730:    double zLAtNodes[4], zRAtNodes[4];
 1731:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 1732:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 1733: 
 1734:    double zL = interpolate(shpCoord, zLAtNodes);
 1735:    double zR = interpolate(shpCoord, zRAtNodes);
 1736:    
 1737:    // Interpolates vertically the velocities
 1738:    double wght1, wght2;
 1739:    if (xt.z<=zL) {
 1740:       wght1 = 1.0;
 1741:       wght2 = 0.0;
 1742:    }
 1743:    else if (xt.z>=zR) {
 1744:       wght1 = 0.0;
 1745:       wght2 = 1.0;
 1746:    }
 1747:    else {
 1748:       // Perform a binary search to find the levels between L and R that contain xt.z
 1749:       while (R - L > 1) {
 1750:          int M = (L + R) / 2;
 1751: 
 1752:          double zMAtNodes[4];
 1753:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 1754:          double zM = interpolate(shpCoord, zMAtNodes);
 1755:          if (zM < xt.z) 
 1756:          {
 1757:             L = M;
 1758:             zL = zM;
 1759:          }
 1760:          else 
 1761:          {
 1762:             R = M;
 1763:             zR = zM;
 1764:          }
 1765:       }
 1766:       assert(L == R-1);
 1767:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 1768: 
 1769:       wght2 = (xt.z - zL)/(zR - zL);
 1770:       wght1 = 1.0 - wght2;
 1771:    }
 1772: // printf("$$$ wght1 = %f, wght2 = %f, zt = %f, zL = %f, zR = %f\n", wght1, wght2, zt, zL, zR);
 1773: // printf("$$$ shpCoord = %f, %f, %f, %f\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 1774:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 1775:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 1776: 
 1777:    // Neither of the interpolated velocities should be NaN
 1778:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 1779: 
 1780: }
 1781: 
 1782: 
 1783: 
 1784: __inline__ __device__ double Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 1785: __inline__ __device__ double Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 1786: __inline__ __device__ Point2 Side::p_t(double t) const { return {x(t), y(t)}; }
 1787: __inline__ __device__ int    Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 1788: __inline__ __device__ double Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 1789: __inline__ __device__ double Side::depth(void)   const { return 0.5*(n1->depth + n2->depth); }
 1790: 
 1791: __inline__ __device__ double Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 1792: __inline__ __device__ double Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 1793: __inline__ __device__ double Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 1794: 
 1795: 
 1796: __inline__ __device__ double Side::Cd(void)      const { if constexpr(nchi != 0) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 1797: 
 1798: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 1799: 
 1800: /**
 1801:  * This method performs backtracking from the side center until a time -dt back in time 
 1802:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 1803:  * intermediate point.
 1804:  *
 1805:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 1806:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 1807:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 1808:  * remaining time.
 1809:  * 
 1810:  * NOTE: Runge-Kutta is not implemented yet. XXX
 1811:  * 
 1812:  * @param uuint, vvint, wwint: Velocities at the final point
 1813:  * @param jlev: Level at which the backtracking is performed
 1814:  * @param dt, dtbk: Tracking timesteps
 1815:  * @return: True if the backtracking was successful, false otherwise
 1816:  */
 1817: __inline__ __device__ bool Side::btrack(
 1818:       int jlev,
 1819:       double dt,            // Tracking time
 1820:       double dtbk,          // Tracking timestep
 1821:       Vector3 &u_int
 1822: ) const {
 1823: 
 1824:    // Start from side center
 1825:    Point3 x0 = {center.x, center.y, zc[jlev]};
 1826:  
 1827: 
 1828:    double time_rm = dt; // Remaining time
 1829: 
 1830: 
 1831:    // // Initialize outputs XXX
 1832:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 1833:    //    sclr[i] = 0.0;
 1834:    // }
 1835: 
 1836: 
 1837:    // Initial velocities
 1838:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 1839: 
 1840:    // Find the element that is in the direction opposite to the velocity
 1841:    Element* curElem = findElementTowards({u_int.x, u_int.y});
 1842: 
 1843: 
 1844:    const int MAX_ITERATIONS = 1000; 
 1845:    Element* nextElem = curElem;
 1846:    int iter = 0;
 1847:    while(true) {
 1848:       // Calculate timestep
 1849:       double dtb = min(dtbk, time_rm);
 1850: 
 1851:       // Next point in the backtracking curve
 1852:       Point3 xt = x0 - dtb*u_int;
 1853: 
 1854:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb);
 1855:       assert(found && "Backtracking failed in btrack");
 1856: // printf("<>T = %f, %f %f %f\n", time_rm - dtb, xt, yt, zt);
 1857:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 1858:                       // then time_rm needs to be increased by the unused time.
 1859: 
 1860: 
 1861:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 1862: 
 1863:       // The current point becomes the next segment's starting point.
 1864:       x0 = xt;
 1865:  
 1866:       curElem = nextElem;
 1867: 
 1868:       iter++;
 1869:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 1870:    }
 1871: 
 1872: 
 1873: }
 1874: 
 1875: 
