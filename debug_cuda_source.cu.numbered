 1996: __host__ __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 1997: 
 1998: __device__ double Node::compZCoord(int k) const {
 1999:    // Computes the z coordinate at level k.
 2000:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2001:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2002:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2003:    // used 
 2004:    
 2005:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2006:       
 2007:    if (isDry)  return 0.0;
 2008: 
 2009:    if constexpr(ivcor == 2) {
 2010: 
 2011:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2012:       const int kz = mesh->kz;
 2013: 
 2014:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2015:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2016:       // once per time step/node.
 2017:       // CHECK: updateZCoordData
 2018:       if (k == kz)               return -hmod2;
 2019:       else if (k == nvrt-1)      return eta2;
 2020:       else if (k == kb)          return -depth;
 2021:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2022:       else if (k > kz) {
 2023:          const int ksig = k - kz + 1;
 2024: 
 2025:          if (hmod2 <= mesh->h_c) {
 2026:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2027:          } 
 2028:          else if (eta2 <= - mesh->h_c - (depth - mesh->h_c) * mesh->theta_f/mesh->sinh_theta_f) {
 2029:             printf("Please choose larger h_c: %f %f\n", eta2, mesh->h_c);
 2030:             Error("ZCOOR: invalid h_c\n");
 2031:          } 
 2032:          else {
 2033:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2034:                          mesh->h_c * mesh->sigma[ksig] + 
 2035:                          (hmod2 - mesh->h_c) * mesh->cs[ksig];
 2036:          }
 2037:       } else { 
 2038:          Error("ZCOOR: invalid level or coordinate system\n");
 2039:       }
 2040: 
 2041:    }
 2042:    else if constexpr(ivcor == 1) {
 2043:       if (k == kb) return -depth;
 2044:       else if (k == nvrt-1) return eta2;
 2045:       else if (k >= kb) {
 2046:             return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2047:       }
 2048:    }
 2049:    
 2050:    printf("ZCOOR: invalid level or coordinate system\n");
 2051:    return 0.0;
 2052: }
