 1946: //       const double y4 = nodes[nxq(i+1)]->y;
 1947: 
 1948: //       const Side& side = sides[i];
 1949: 
 1950: //       xIntersect=-1.e25;
 1951: //       yIntersect=-1.e25;
 1952: 
 1953: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 1954: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 1955: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 1956: 
 1957: //       if (delta != 0.0) {
 1958: //          // Solves the two linear equations for tt1 and tt2
 1959: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1960: //          const double tt2 = delta2/delta;
 1961: 
 1962: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 1963: //          // Similarly, we use tt2 to compute the intersection point.
 1964: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 1965: //             xIntersect = x3 + (x4 - x3)*tt2;
 1966: //             yIntersect = y3 + (y4 - y3)*tt2;
 1967: 
 1968: //             intersectingSide = side;
 1969: //             nextElement = nghbElems[i];
 1970: 
 1971: //             return true;
 1972: //          }
 1973:       
 1974: //       }
 1975: //       else {
 1976: //          // The two segments are parallel
 1977: //          return false;
 1978: //       }
 1979: 
 1980: //    }
 1981: 
 1982: //    return false;
 1983: 
 1984: // }
