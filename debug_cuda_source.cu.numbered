  962:    //    return sides[idx] + idx;
  963:    // }
  964: 
  965:    // // Get's the global index of local node idx
  966:    // __device__ int getGlobalNodeIndex(int idx) {
  967:    //    return idx + partNum * max_np;
  968:    // }
