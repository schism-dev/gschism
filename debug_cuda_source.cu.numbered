  348: struct Element {
  349: 
  350:    // Geometry information
  351:    int idx;               // Index of the element
  352:    int i34;               // Number of sides for the element 
  353:    Side *sides[4];        // Sides of the element
  354:    Node *nodes[4];        // Nodes of the element
  355:    Element *nghbElems[4]; // Neighbors of the element
  356: 
  357:    int kb;                    // Bottom index of the element
  358:    double area;               // Area of the element
  359:    double ssign[4];           // Sign associated with each side of an element
  360:    double radius;             // Element equivalent radii
  361: 
  362:    Frame frame;
  363: 
  364:    Vector2 gradPhi[4];       // Derivatives of shape functions
  365:    Vector2 gradEta[nvrt];    // Gradient of free surface elevation
  366: 
  367:    bool isDry;                  // True if the element is dry
  368:    int kbe;                   // Bottom index of the element
  369: 
  370:    Vector3 center;            // Element center coordinates
  371:    double xlon_el, ylat_el;   // Element center lat/lon coordinates in _degrees_
  372:    double depth;              // Depth at element (min of all nodes)
  373:    double z[nvrt];            // z-coord  (local frame - vertical up)
  374: 
  375:    // Physical information
  376:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  377: 
  378:    static const bool isblock = false;              // Always false
  379: 
  380:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  381:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  382: 
  383:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  384: 
  385:    
  386: 
  387:    double vsource;            // Volumetric source/sink term [m^3/s]
  388: 
  389:    double rho[nvrt];          // Density at each prism center
  390:    double rho_mean[nvrt];     // Mean density at each prism center
  391:    CubicSpline rho_spl;
  392:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  393:    double rho_z[nvrt];        // First derivative of density at each prism center
  394:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  395: 
  396:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  397: 
  398:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  399:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  400: 
  401:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 1; }
  402:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 1; }
  403: 
  404:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  405:    __inline__ __device__ int nodeLocalIdx(Node *node) const { 
  406:       int res = (nodes[0] == node) ? 0 : ((nodes[1] == node) ? 1 : ((nodes[2] == node) ? 2 : 3)); 
  407:       printf("nodeLocalIdx: node = %p, nodes[0] = %p, nodes[1] = %p, nodes[2] = %p, nodes[3] = %p\n", node, nodes[0], nodes[1], nodes[2], nodes[3]);
  408:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  409:       return res;
  410:    }
  411: 
  412:    __inline__ __device__ int findLevel(double z1, int k) const {
  413:       // Starting at index k, find sequentially the level that contains z
  414: 
  415:       // if z is already betweeen z[k] and z[k+1], return k
  416:       if (z1 >= z[k] && z1 < z[k+1]) return k;
  417:       else if (z1 < z[k]) { 
  418:          // Search for increasing levels
  419:          for (int kk = k; kk < nvrt - 1; kk++) {
  420:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  421:          }
  422:          return nvrt - 1;
  423:       }
  424:       else {
  425:          // Search for decreasing levels
  426:          for (int kk = k; kk > 0; kk--) {
  427:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  428:          }
  429:          return 0;
  430:       }
  431:    }
  432: 
  433:    __inline__ __device__ double z_prism(int k) const { return 0.5*(z[k+1] + z[k]); }
  434:    __inline__ __device__ double Dz(int k)      const { return z[k+1] - z[k]; }
  435: 
  436:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  437: 
  438:    __inline__ __device__ double computeSignedArea(void) const;
  439: 
  440:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  441:       // Nudges the point (x,y) to the barycenter of the element
  442:       p = (1-eps)*p + eps*toVector2(center);
  443:    }
  444: 
  445:    __device__ bool computeShapeCoords(Point2 xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  446: 
  447:    __device__ Vector2 grad(double *a) const
  448:    {
  449:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  450:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  451:       if (isQuad()) {
  452:          gx += a[3]*gradPhi[3].x;
  453:          gy += a[3]*gradPhi[3].y;
  454:       }
  455:       return {gx, gy};
  456:    }
  457: 
