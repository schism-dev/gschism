 4963: __global__ void printMatrix(void) {
 4964: 
 4965: 
 4966:    // Let only one thread per block print at a time 
 4967: 
 4968:    if (threadIdx.x == 0) {
 4969:       for (int ithread = 0; ithread < blockDim.x; ithread++) {
 4970:          const int idx_node = ithread + blockIdx.x * blockDim.x;
 4971:          if (idx_node >= mesh->np) return;
 4972:          const Node *node = mesh->localNodeData + idx_node;
 4973:          printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 4974:          for (int j = 0; j < node->numNodes; j++) {
 4975:             Node* nbNode = node->nodes[j];
 4976:             if (node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 4977:          }
 4978:          printf("]\n");
 4979: 
 4980:       }
 4981:    }
 4982: 
 4983: 
 4984: 
 4985: }
