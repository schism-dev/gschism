 1884: __host__ __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 1885: 
 1886: __device__ double Node::compZCoord(int k) const {
 1887:    // Computes the z coordinate at level k.
 1888:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 1889:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 1890:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 1891:    // used 
 1892:    
 1893:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 1894:       
 1895:    if (idry) {
 1896:       return 0.0;
 1897:    }
 1898: 
 1899:    if constexpr(ivcor == 2) {
 1900: 
 1901:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 1902:       const int kz = mesh->kz;
 1903: 
 1904:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 1905:       // The FORTAN code computes it every time this function is called, but it should be done only 
 1906:       // once per time step/node.
 1907:       // CHECK: updateZCoordData
 1908:       if (k == kz)               return -hmod2;
 1909:       else if (k == nvrt-1)      return eta2;
 1910:       else if (k == kb)          return -depth;
 1911:       else if (k < kz && k >= 0) return mesh->ztot[k];
 1912:       else if (k > kz) {
 1913:          const int ksig = k - kz + 1;
 1914: 
 1915:          if (hmod2 <= mesh->h_c) {
 1916:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 1917:          } 
 1918:          else if (eta2 <= - mesh->h_c - (depth - mesh->h_c) * mesh->theta_f/mesh->sinh_theta_f) {
 1919:             printf("Please choose larger h_c: %f %f\n", eta2, mesh->h_c);
 1920:             Error("ZCOOR: invalid h_c\n");
 1921:          } 
 1922:          else {
 1923:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 1924:                          mesh->h_c * mesh->sigma[ksig] + 
 1925:                          (hmod2 - mesh->h_c) * mesh->cs[ksig];
 1926:          }
 1927:       } else { 
 1928:          Error("ZCOOR: invalid level or coordinate system\n");
 1929:       }
 1930: 
 1931:    }
 1932:    else if constexpr(ivcor == 1) {
 1933:       if (k == kb) return -depth;
 1934:       else if (k == nvrt-1) return eta2;
 1935:       else if (k >= kb) {
 1936:             return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 1937:       }
 1938:    }
 1939:    
 1940:    printf("ZCOOR: invalid level or coordinate system\n");
 1941:    return 0.0;
 1942: }
