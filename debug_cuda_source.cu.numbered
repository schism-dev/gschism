  766: // This struct is used to store the boundary information for a node.
  767: struct NodeBoundary {   
  768:    BoundarySegment *segment;
  769:    Node *node;
  770:    
  771:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
  772:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
  773: 
  774:    double etaic;  // Elevation at nodes used for essential boundary conditions
  775:    double elbc;   // Elevation boundary condition
  776:    int iettype;   // Type of elevation boundary condition
  777:    double eth;    // Elevation time history
  778: 
  779:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
  780:       assert(index == 0 || index == 1); 
  781:       return (index == 0) ? sideBnd1 : sideBnd2; 
  782:    }
  783: };
