  986:    //    return elems[idx] + idx;
  987:    // }
  988: 
  989:    // // Get's the pointer to the side using the array of global pointers to sides
  990:    // __device__ const Side *getGlobalSide(int js) {
  991:    //    const int idx = js / max_ns; // Get the index of the partition that contains the side
  992:    //    return sides[idx] + idx;
  993:    // }
  994: 
  995:    // // Get's the global index of local node idx
  996:    // __device__ int getGlobalNodeIndex(int idx) {
  997:    //    return idx + partNum * max_np;
  998:    // }
  999: 
 1000:    // // Get's the global index of local element idx
 1001:    // __device__ int getGlobalElemIndex(int idx) {
 1002:    //    return idx + partNum * max_ne;
 1003:    // }
 1004: 
 1005:    // // Get's the global index of local side idx
 1006:    // __device__ int getGlobalSideIndex(int idx) {
 1007:    //    return idx + partNum * max_ns;
 1008:    // }  
 1009: 
 1010:    __device__ Mesh(int partNum,
 1011:                    int npgb, int negb, int nsgb, 
 1012:                    int np, int ne, int ns, int nvrt, int kz,
 1013:                    int max_np, int max_ne, int max_ns, int nseg,
 1014:                    const Node **nodesPtr, const Element **elemsPtr, const Side **sidesPtr,
 1015:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 1016:                    Node    **localNodeNeighNodesMem,
 1017:                    Element **localNodeNeighElemsMem,
 1018:                    NodeBoundary *localNodeBoundaryMem,
 1019:                    SideBoundary *localSideBoundaryMem,
 1020:                    BoundarySegment *localSegmentMem,
 1021:                    double h_s, double theta_b, double theta_f, double *sigma_lcl, double *sigma, double *ztot,
 1022:                    double *cs, double *dcs
 1023:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 1024:                        np(np), ne(ne), ns(ns),
