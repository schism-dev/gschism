 2286: 
 2287: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2288:                 double *node_coords, double *wind_rotate_angle, 
 2289:                 int *isdel, int *isidenode, int *isbnd,
 2290:                 int *nond, int *nlnd, int *iond, int *ilnd,
 2291:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2292:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2293:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2294:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2295:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 2296:                 double *emo, double *efa, 
 2297:                 double *umo, double *ufa, 
 2298:                 double *vmo, double *vfa) {
 2299: 
 2300:    printf("Populating mesh for partition %d\n", partNum);
 2301: 
 2302:    // Horizontal grid
 2303:    printf("Processing %d nodes\n", np);    
 2304: 
 2305: 
 2306:    int idxNodeBoundary = 0;  
 2307:    for (int i = 0; i < np; i++)
 2308:    {
 2309:       Node &node = localNodeData[i];
 2310: 
 2311:       node.idx = i;
 2312: 
 2313:       const int idxNodeStart = nodeNeighNodesStart[i];
 2314:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2315:       node.numNodes = idxNodeEnd - idxNodeStart;
 2316:       node.nodes = nodeNeighNodes + idxNodeStart;
 2317:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2318: 
 2319: 
 2320: 
 2321:       const int idxElemStart = nodeNeighElemsStart[i];
 2322:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2323:       node.numElements = idxElemEnd - idxElemStart;
 2324:       node.elements = nodeNeighElems + idxElemStart;
 2325: 
 2326: 
 2327:       
 2328:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2329:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2330:          const int partNode = localNodePart[idxNodeGlobal]; 
 2331:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2332: 
 2333: 
 2334:          Node *node_ptr = nodes[partNode] + idxNode;
 2335:          
 2336:          nodeNeighNodes[idx] = node_ptr;
 2337:       }
 2338: 
 2339:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2340:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2341:          const int partElem = localElemPart[idxElemGlobal];
 2342:          const int idxElem  = localElemIndices[idxElemGlobal];
 2343: 
 2344:          Element *elem_ptr = elems[partElem] + idxElem;
 2345: 
 2346:          nodeNeighElems[idx] = elem_ptr;
 2347:       }      
 2348: 
 2349: 
 2350:       node.wind_angle = wind_rotate_angle[i];
 2351: 
 2352:       // Element **elements; // pointer to the elements connected to this node
 2353:       // int numElements;   // number of elements shared by this node
 2354: 
 2355:       node.p.x   = node_coords[i * 3];
 2356:       node.p.y   = node_coords[i * 3 + 1];
 2357:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2358:       node.depth = node_coords[i * 3 + 2];
 2359: 
 2360: 
 2361: 
 2362:       // Links the node to the boundary information
 2363:       if (isbnd[i] >= 0) {
 2364:        
 2365:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2366:          node.nodeBnd->node = &node;
 2367: 
 2368:          if (isbnd[i]>0) {
 2369: 
 2370:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2371:             node.nodeBnd->segment->ifltype = isbnd[i];
 2372: 
 2373:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2374:             node.nodeBnd->segment->clen  = nan("1");
 2375:             node.nodeBnd->segment->carea = nan("1");
 2376: 
 2377:          }
 2378:          else {
 2379:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2380:          }
 2381:          
 2382:          idxNodeBoundary++;
 2383:       }
 2384:       else {
 2385:          node.nodeBnd = nullptr;
 2386:       }
 2387: 
 2388: // XXXX
 2389: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2390: constexpr double rot_per = 3000.0;
 2391: constexpr double rot_f = 0.0*2.0*pi/rot_per;
 2392: for (int k = 0; k < nvrt; k++) {node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0};}
 2393: // XXXXX
 2394:    }
 2395: 
 2396:    nbp = idxNodeBoundary;
 2397: 
 2398:    printf("Processing %d sides\n", ns);
 2399:    int idxSideBoundary = 0;
 2400:    for (int i = 0; i < ns; i++)
 2401:    {
 2402:       Side &side = localSideData[i];
 2403:       side.idx = i;
 2404:       // finding the pointer to the nodes that form the side
 2405:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2406:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2407: 
 2408:       const int locidx_n1 = localNodeIndices[idx_n1];
 2409:       const int locidx_n2 = localNodeIndices[idx_n2];
 2410:       const int part_n1 =   localNodePart[idx_n1];
 2411:       const int part_n2 =   localNodePart[idx_n2];
 2412: 
 2413:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2414:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2415: 
 2416:       // Normal vector to the side
 2417:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2418:       const double norm = sqrt(dot(side.n, side.n));
 2419:       side.n = side.n/norm;
 2420: 
 2421:       // Side boundary type
 2422:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 2423:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 2424:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2425:       
 2426:       if (n1bnd != nullptr || n2bnd != nullptr) 
 2427:       {
 2428:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2429:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2430:          else                  side.sideBnd->segment = n2bnd->segment;
 2431:          side.sideBnd->side = &side;
 2432:          idxSideBoundary++;
 2433:       }
 2434:       else side.sideBnd = nullptr;
 2435: 
 2436:       // finding the pointer to the elements that share the side
 2437:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2438:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2439: 
 2440:       if (idx_e1 > -1) {
 2441:          const int locidx_e1 = localElemIndices[idx_e1];
 2442:          const int part_e1 =  localElemPart[idx_e1];
 2443:          side.elems[0] = elems[part_e1] + locidx_e1;
 2444:          // printf("s@@ part_e1 = %d, locidx_e1 = %d, elems[part_e1] = %p\n", part_e1, locidx_e1, elems[part_e1]);
 2445:          // // printf("s-- side.elems[0] = %p idx = %d i34 = %d (x,y,z) = (%f,%f,%f) size = %d\n", side.elems[0], side.elems[0]->idx, side.elems[0]->i34, side.elems[0]->center.x, side.elems[0]->center.y, side.elems[0]->center.z, sizeof(Element));
 2446:          // printf("o-- elems = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2447:       }
 2448:       else {
 2449:          side.elems[0] = nullptr;
 2450:       }
 2451: 
 2452:       if (idx_e2 > -1) {
 2453:          const int locidx_e2 = localElemIndices[idx_e2];
 2454:          const int part_e2 =  localElemPart[idx_e2];
 2455:          side.elems[1] = elems[part_e2] + locidx_e2;
 2456:       }
 2457:       else {
 2458:          side.elems[1] = nullptr;
 2459:       }
 2460: 
 2461: 
 2462: 
 2463:       // Compute the center of the side
 2464:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2465: 
 2466: // XXXX
 2467: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2468: constexpr double rot_per=3000.0;
 2469: constexpr double rot_f=0.0*2.0*pi/rot_per;
 2470: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2471: // XXXXX      
 2472: 
 2473:       // Compute the z level at the center of the side
 2474:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->znl[k] + side.n2->znl[k]);
 2475: 
 2476:       // Compute the length of the side
 2477:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2478:       side.length = sqrt(dot(vLen, vLen));
 2479: 
 2480:    }
 2481: 
 2482:    printf("Processing %d elements\n", ne);
 2483:    for (int i = 0; i < ne; i++)
 2484:    {
 2485:       Element &elem = localElemData[i];
 2486:       elem.idx = i;
 2487:       for (int j = 0; j < i34[i]; j++) {
 2488:          const int idxNode = elnode[i*4 + j];  
 2489:          const int idxSide = elside[i*4 + j];
 2490:          
 2491:          elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 2492:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2493: 
 2494: 
 2495: 
 2496:          // Find the neighboring element  
 2497:          if (elem.sides[j]->elems[0] == &elem) {
 2498:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2499:          }
 2500:          else {
 2501:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2502:          }
 2503:          
 2504:       }
 2505: 
 2506:       elem.i34 = i34[i];
 2507: 
 2508: // printf("elem = %p, elem.i34 = %d\n", &elem, elem.i34);
 2509: 
 2510:       // Compute the centroid of the element and its depth
 2511:       Vector2 center = {0.0, 0.0};
 2512:       elem.depth = 0.0;
 2513:       for (int j = 0; j < i34[i]; j++) {
 2514:          center += elem.nodes[j]->p2()/i34[i];
 2515:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2516:       }
 2517:       elem.center.x = center.x;
 2518:       elem.center.y = center.y;
 2519: 
 2520:       // printf("elem = %p, i34 = %d, center = (%f,%f,%f)\n", &elem, elem.i34, elem.center.x, elem.center.y, elem.depth);
 2521:       
 2522:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2523:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2524: 
 2525:       elem.area = elem.computeSignedArea(); 
 2526:       elem.radius = sqrt(elem.area)/pi; 
 2527:       
 2528:       // Determines which way the normal vector to each side is oriented.
 2529:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2530:       for (int j = 0; j < i34[i]; j++)  
 2531:       {
 2532:          if (elem.sides[j]->elems[0] == &elem) {
 2533:             elem.ssign[j] =  1.0;
 2534:          }
 2535:          else {
 2536:             elem.ssign[j] = -1.0;
 2537:          }
 2538: 
 2539:       }
 2540: 
 2541:       // Derivatives of shape functions
 2542:       //  For ics=2, this is done inside element/ll frame XXX
 2543:       //  For quads, the derivative is evaluated at centroid
 2544:       const int i34 = elem.i34;
 2545:       for (int j = 0; j < i34; j++) {
 2546:          const double area = elem.area;
 2547:          const int id2 = elem.nxq(1 + j);
 2548:          const int id3 = elem.nxq(2 + j);
 2549:          const int id4 = elem.nxq(3 + j);
 2550:          if (elem.isTri()) {
 2551:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2552:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2553:             // da1/dx = (y1 - y2)/(2*area)
 2554:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2555:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2556:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2557:          }
 2558:          else  { // Quad; evaluate at centroid
 2559:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2560:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2561:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2562:          } // if Tri
 2563: 
 2564:       } // for j
 2565: 
 2566:    }
 2567: 
 2568: 
 2569:    // Processing the boundary nodes
 2570:    int idx = 0;
 2571:    for (int iseg = 0; iseg < nope; iseg++) {
 2572:       for (int ilnd = 0; ilnd < nlnd[iseg]; ilnd++) {
 2573: 
 2574:          NodeBoundary *nodeBnd = &localNodeBoundaryMem[idx];
 2575: 
 2576:          nodeBnd->isEssentialBC = true;
 2577: nodeBnd->iettype = 3;
 2578:          nodeBnd->elbc = 0.0;
 2579: 
 2580:          for (int jfr = 0; jfr < nbfr; jfr++) {
 2581:             nodeBnd->efa[jfr] = efa[jfr + iseg*nbfr];
 2582:             nodeBnd->emo[jfr] = emo[jfr + iseg*nbfr];
 2583:             nodeBnd->umo[jfr] = umo[jfr + iseg*nbfr];
 2584:             nodeBnd->ufa[jfr] = ufa[jfr + iseg*nbfr];
 2585:             nodeBnd->vmo[jfr] = vmo[jfr + iseg*nbfr];
 2586:             nodeBnd->vfa[jfr] = vfa[jfr + iseg*nbfr];
 2587: printf("nodeBnd->efa[%d] = %f, nodeBnd->emo[%d] = %f, nodeBnd->umo[%d] = %f, nodeBnd->ufa[%d] = %f, nodeBnd->vmo[%d] = %f, nodeBnd->vfa[%d] = %f\n", jfr, nodeBnd->efa[jfr], jfr, nodeBnd->emo[jfr], jfr, nodeBnd->umo[jfr], jfr, nodeBnd->ufa[jfr], jfr, nodeBnd->vmo[jfr], jfr, nodeBnd->vfa[jfr]);
 2588:          }
 2589: 
 2590:          idx++;
 2591:       }
 2592: 
 2593:    }
 2594: 
 2595: }
 2596: 
 2597: 
 2598: 
 2599: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 2600:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 2601:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 2602:    // 
 2603:    // This kernel is called for all nodes.
 2604: 
 2605: 
 2606:    NODE(node1);
 2607: 
 2608: 
 2609:    node1->clearMatrixRow();
 2610:    node1->qel = 0.0;
 2611: 
 2612:    // THIS IS FOR STRUCTURES XXX
 2613:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 2614: 
 2615:    
 2616:    for (int j=0; j<node1->numElements; j++) {
 2617:       // For each element connected to the node...
 2618: 
 2619:       Element *elem = node1->elements[j];
 2620: 
 2621:       // Compute the average gravity
 2622:       printf("UUU Node::grav2 = %f, %f, %f\n", elem->nodes[0]->grav2, elem->nodes[1]->grav2, elem->nodes[2]->grav2);
 2623:       const double grav3 = elem->mean(&Node::grav2);
 2624: 
 2625:       // Look at the documentation for the description of the terms in the following integrals
 2626: 
 2627:       // Integral I_1 
 2628:       // \bar{\breve{H}} 
 2629:       const double hhatb = elem->mean(&Side::hhat);        
 2630: 
 2631: 
 2632:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 2633: 
 2634:       const int id1 = elem->nodeLocalIdx(node1); 
 2635:       const double area = elem->area;
 2636: 
 2637:       if (elem->isTri()) {
 2638: 
 2639:          // To clarify the notation in this section: 
 2640:          //   i stands for the node under consideration (node1)
 2641:          //   j (node2) and k (node3) are the other nodes of the triangle.
 2642:          const int id2 = elem->nxq(1 + id1);
 2643:          const int id3 = elem->nxq(2 + id1);
 2644:          Node *node2 = elem->nodes[id2];
 2645:          Node *node3 = elem->nodes[id3];
 2646: 
 2647:          const Point2 x1 = node1->p2();
 2648:          const Point2 x2 = node2->p2();
 2649:          const Point2 x3 = node3->p2();
 2650: 
 2651:          // integral of phi_i*phi_j
 2652:          const double ipp_ii = (1.0/6.0 )*area;
 2653:          const double ipp_ij = (1.0/12.0)*area;
 2654:          const double ipp_ik = (1.0/12.0)*area;
 2655: 
 2656:          // integral of [(grad phi_i) * (grad phi_j)]
 2657:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 2658:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 2659:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 2660: 
 2661:          // Computes the different components of integral I_1 of each node with respect to node i.
 2662:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 2663:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 2664:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 2665: 
 2666: if (j==node1->numElements-1) {
 2667: printf("grav3 = %f, thetai = %f, dt = %f, hhatb = %f, area = %f, dot1= %f, dot2 = %f, dot3 = %f\n", grav3, thetai, dt, hhatb, area, dot(x3-x2, x3-x2), dot(x3-x2, x1-x3), dot(x1-x3, x1-x3));
 2668: printf("node idx = %d, x1 = %f, %f, x2 = %f, %f, x3 = %f, %f\n", node1->idx, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y);
 2669: printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 2670: }
 2671: 
 2672:          node1->addToSparseMatrix(node1, I1_ii);
 2673:          node1->addToSparseMatrix(node2, I1_ij); 
 2674:          node1->addToSparseMatrix(node3, I1_ik);
 2675: 
 2676: if (j==node1->numElements-1) printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 2677:      
 2678:       }
 2679:       else { // Quad
 2680:          // XXX IMPLEMENT THIS
 2681:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2682:       } 
 2683: 
 2684:  
 2685:       // Integral I_4
 2686:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 2687:       // Where
 2688:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 2689: 
 2690:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 2691:       // of U over the element.
 2692:       Vector2 Umean = {0.0, 0.0};
 2693:       for (int m=0; m<elem->i34; m++) {      
 2694:          const Side *side = elem->sides[m];
 2695: 
 2696:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 2697:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 2698:       }
 2699:       Umean = Umean/elem->i34;
 2700: 
 2701:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 2702: 
 2703:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 2704:       const double I_4_1 = dot(gradPhi_1, Umean);
 2705: 
 2706:       // Integral of \nabla\phi_i \cdot \pmb{E}
 2707:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 2708:      
 2709:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 2710: if (j==node1->numElements-1) printf("MMMMmm  idx_node = %d, I_4_1 = %.15g, I_4_2 = %.15g, node1->qel = %.15g, gradPhi_1 = %.15g, %.15g, elem->ghat1 = %.15g, %.15g\n", node1->idx, I_4_1, I_4_2, node1->qel, gradPhi_1.x, gradPhi_1.y, elem->ghat1.x, elem->ghat1.y);
 2711: 
 2712:       // Additional terms 
 2713:       double vnorm = 0.0;
 2714:       if (imm == 2)  { // Pre-compute vnorm on the element
 2715:          Vector3 ubed;
 2716:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 2717: 
 2718:          Vector3 gradP = {0.0, 0.0, 1.0};
 2719:          for (int m=0; m < elem->i34; m++) {
 2720:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 2721:            gradP += toVector3(gradP_2D, 0.0);
 2722:          }   
 2723:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 2724:       } // imm==2
 2725: 
 2726:       if (elem->isTri()) {
 2727:          for (int l=0; l<3; l++) {
 2728:            double fac;
 2729: 
 2730:            Node *node = elem->nodes[l];
 2731: 
 2732:            (node == node1)? fac=2.0 : fac=1.0;
 2733: 
 2734:            if (imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 2735:            else        node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 2736:            
 2737:          }
 2738: 
 2739: 
 2740:          if (!elem->isDry) {
 2741:            const Vector2 gradEta = elem->nodes[0]->eta2*elem->gradPhi[0] +
 2742:                                    elem->nodes[1]->eta2*elem->gradPhi[1] +
 2743:                                    elem->nodes[2]->eta2*elem->gradPhi[2];
 2744: 
 2745:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 2746:          }
 2747: if (j==node1->numElements-1) printf("&&& node1->qel = %f\n", node1->qel, node1->eta2);
 2748: 
 2749:       } // isTri
 2750:       else { // isQuad
 2751:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2752:          // for (int l=0; l<4; l++) {
 2753:          //   const Node *node = elem->nodes[l];
 2754: 
 2755:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 2756:          //   else        tmp2 = node->bdef2 - node->bdef1;
 2757: 
 2758:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 2759:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 2760:          // }
 2761: 
 2762:       } // isQuad
 2763: 
 2764: 
 2765:       node1->qel += (dt/elem->i34)*elem->vsource;
 2766:       
 2767: 
 2768:    } // for all elements connected to the node
 2769:    
 2770: 
 2771: 
 2772:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 2773:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 2774:    NodeBoundary *nodeBnd = node1->nodeBnd;
 2775:    if (nodeBnd != nullptr)  { 
 2776:       // If it is an open boundary node...
 2777: 
 2778:       // At least one open bnd side, maybe two
 2779:       for (int l=0; l<2; l++) { 
 2780: 
 2781:          // Gets each of the sides sharing the node. 
 2782:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 2783: 
 2784:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 2785: 
 2786:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 2787: 
 2788: 
 2789:          if (sideBnd != nullptr) {
 2790:             // If the side is on a boundary...
 2791: 
 2792:             // Get the boundary segment
 2793:             const BoundarySegment *sideSegment = sideBnd->segment;
 2794:             const Side *side = sideBnd->side;
 2795: 
 2796:             // Integral I_3
 2797:             if (sideSegment->ifltype != 0) {
 2798:             // Natural or Flather b.c.
 2799: 
 2800:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 2801:                // especially for Flather b.c.
 2802:                double ri3 = 0.0;
 2803:                if (!side->isDry) {
 2804:                   // If the side is not dry
 2805:                   
 2806:                   // Computes the side flux of (uth, vth)
 2807:                   double Vn = 0.0;
 2808:                   for (int k = side->kb; k<nvrt-1; k++) {
 2809:                      // uth, vth in lat/lon frame if ics=2
 2810:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 2811:                      const double vn1 = dot(side->uth[k  ], side->n); // outer normal
 2812:                      const double vn2 = dot(side->uth[k+1], side->n);
 2813: 
 2814:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 2815:                   }
 2816: 
 2817:                   ri3 = 0.5*side->length*Vn;
 2818:                }
 2819: 
 2820:                if (sideSegment->ifltype == -1) { // Flather 1
 2821: 
 2822:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 2823:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 2824: 
 2825:                   const double con0 = (1.0/6.0)*side->length*sqrt(grav*side->depth()); // For coefficient matrix
 2826:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 2827:                   
 2828:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 2829:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 2830: 
 2831:                } 
 2832:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 2833:                   // Reset ri3
 2834:                   ri3 = 0.0;
 2835: 
 2836:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 2837: 
 2838:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 2839: 
 2840:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 2841:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 2842: 
 2843:                   const double con0 = (1.0/6.0)*side->length*tmp*thetai*dt;
 2844:                   node1->addToSparseMatrix(node1, con0*2.0);
 2845:                   node1->addToSparseMatrix(node2, con0);
 2846: 
 2847:                } // if Flather or Discharge
 2848: 
 2849:                node1->qel -= thetai*dt*ri3;
 2850: 
 2851:             } // I_3
 2852:           
 2853: 
 2854:             // Integral I_5
 2855:             if(!side->isDry) {
 2856: 
 2857:                const double Unbar = dot(side->U, side->n);
 2858: 
 2859:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->length*Unbar;
 2860:                
 2861:             } // I_5
 2862: 
 2863:          } // if is boundary side
 2864: 
 2865:       } // for l
 2866: 
 2867:    } // if isbnd
 2868: 
 2869: 
 2870:    printf("44444444 idx_node = %d, node1->qel = %f\n", node1->idx, node1->qel);
 2871: 
 2872: }
 2873: 
 2874: 
 2875: extern "C" {
 2876:    __global__ void backtrackAllNodes(void) {
 2877: 
 2878:       // max/min # of sub-divisions
 2879:       const int ndelt_max = max(1.0, dt/dtb_min);
 2880:       const int ndelt_min = max(1.0, dt/dtb_max); 
 2881: 
 2882:       // Removed all references to swild98 XXX
 2883:       // swild98=0.d0 !init
 2884: 
 2885: 
 2886:       SIDE(side);
 2887: 
 2888:       const int kb = side->kb;
 2889: 
 2890:       printf("backtrackAllNodes: side->idx = %d, nvrt = %d\n", side->idx, nvrt);
 2891: 
 2892:       // Initialize btrack velocities to the actual velocities at the side 
 2893:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 2894: 
 2895: 
 2896:       if (side->isDry) return;
 2897: 
 2898: 
 2899:       // Checks that at least one element is not dry
 2900:       const Element *elem1 = side->elems[0];
 2901:       const Element *elem2 = side->elems[1];
 2902: 
 2903: 
 2904:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 2905:       
 2906:       // XXXXXX
 2907:       // !swild_tmp to store global coord. of the starting side
 2908:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 2909:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 2910:       // !Use sframe2 
 2911:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 2912: 
 2913: 
 2914:       for (int k = kb; k < nvrt; k++) {
 2915:       //  Initialize (xt,yt,zt), nnel and vel.
 2916:       //  For ics=2, the coordinates are in local frames
 2917:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 2918: 
 2919: 
 2920:          const int iadvf = side->iadv();  // Advection flag
 2921: 
 2922:          Point3 xt;
 2923:          if constexpr(ics==1) {
 2924:             xt = side->center3D(k); 
 2925:          }
 2926:          else // lat/lon; in side lat/lon frame
 2927:          {
 2928:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 2929:          // XXX IMPLEMENT THIS
 2930:       //          xt=0.d0
 2931:       //          yt=0.d0
 2932:       //          !centroid coord. for nudging
 2933:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 2934:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 2935:          }  // ics
 2936: 
 2937: 
 2938:          // Velocity at the side (in ll frame for ics, same vertical direction)
 2939:          // XXX IS THIS NECESSARY?
 2940:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 2941: 
 2942:          // If on land or open boundary...
 2943:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 2944:          
 2945:          const double vmag = length(toVector2(u_int));
 2946: 
 2947:          if (vmag <= velmin_btrack) {
 2948:             // No activity 
 2949: 
 2950:             side->btu[k] = side->u2[k];
 2951: 
 2952:             
 2953:          } else {  // do btrack
 2954: 
 2955:           
 2956:             // Compute number of sub-divisions based on local gradients 
 2957:             // XXX IS THIS NECESSARY?
 2958:             double suma = 0.0;
 2959:             int icount = 0;
 2960:             for (int ii=0; ii<2; ii++) {
 2961: 
 2962:                const Element *elem = side->elems[ii];
 2963:                  
 2964:                if (elem == nullptr) continue;
 2965: 
 2966:                icount++;
 2967: 
 2968:                // Not strictly along z; in ll frame for ics=2
 2969: 
 2970:                double utmp[4];
 2971:                double vtmp[4];
 2972:                for (int jj = 0; jj < elem->i34; jj++) {
 2973: 
 2974:                   const Node *node = elem->nodes[jj];
 2975: 
 2976:                   if constexpr(ics==1) {
 2977:                      utmp[jj] = node->u2[k].x;
 2978:                      vtmp[jj] = node->u2[k].y;  
 2979:                   } else {
 2980:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 2981:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 2982:                   }
 2983:                } // for jj
 2984: 
 2985:                const Vector2 grad_u = elem->grad(utmp); 
 2986:                const Vector2 grad_v = elem->grad(vtmp);
 2987: 
 2988:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 2989:             } // for ii
 2990: 
 2991:             assert(icount > 0 && "Impossible 77");
 2992: 
 2993:             // '4' is somewhat arbitrary
 2994:             const int ndelt = max(ndelt_min, min(ndelt_max, int(suma/icount)*4)); // >=1
 2995: 
 2996:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 2997:          
 2998: 
 2999:             Vector3 u_int = {0.0, 0.0, 0.0};
 3000: 
 3001:             side->btrack(k, dt, dtbk, u_int);
 3002: 
 3003:                
 3004:          } // if vmag (do backtrack)
 3005: 
 3006:       } // for j=jmin,nvrt-1
 3007: 
 3008:    }
 3009: } // extern "C"
 3010: 
 3011: template<int nc>
 3012: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3013: 
 3014: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3015: //
 3016: // a,b,c,r: input vectors and are not modified by this program.
 3017: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3018: // r is the r.h.s.
 3019: // n: actual rank of the system.
 3020: // rows in u() and r();
 3021: // u: output with nc columns (transposed to rows)
 3022: // gam: a working array.
 3023: //
 3024: // NOTES:
 3025: // This is a template function that allows for different numbers of columns in the rhs vector.
 3026: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3027: 
 3028:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3029:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3030: 
 3031:    double bet = b[0];
 3032:    if constexpr (nc == 1) {
 3033:       u[0] = rhs[0]/bet;
 3034:    } else {
 3035:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 3036:    }
 3037: 
 3038:    for (int j = 1; j < n; j++) {
 3039:       gam[j] = c[j-1]/bet;
 3040:       bet = b[j] - a[j]*gam[j];
 3041: 
 3042:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3043: 
 3044:       if constexpr (nc == 1) {
 3045:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3046:       } else {
 3047:          for (int k = 0; k < nc; k++) {
 3048:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 3049:          }
 3050:       }
 3051:    }
 3052: 
 3053:    // Back-substitution
 3054:    for (int j=n-1; j>=1; j--) {
 3055:       if constexpr (nc == 1) {
 3056:          u[j] = u[j] - gam[j+1]*u[j-1];
 3057:       } else {
 3058:          for (int k = 0; k < nc; k++) {
 3059:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 3060:          }
 3061:       }
 3062:    }
 3063: }
 3064: 
 3065: 
 3066: 
 3067: 
 3068: // Helper function that contains the core algorithm
 3069: template<typename XAccessor, typename YAccessor>
 3070: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3071:                                     double  yp_top, double  yp_bot, 
 3072:                                     CubicSpline &spline) {
 3073:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3074:    // 
 3075:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3076:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3077:    //
 3078:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3079:    // 
 3080:    // Inputs: 
 3081:    //            n: dimension for x etc; # of data pts (>=2);
 3082:    //            getX, getY: functions to access x,y coordinates
 3083:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3084:    //     Output: 
 3085:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3086: 
 3087:    const int n = k2 - k1 + 1;
 3088:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3089: 
 3090:    // Allocate memory for the splines
 3091:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3092:    spline.x   = new double[n];
 3093:    spline.y   = new double[n];
 3094:    spline.yp  = new double[n];
 3095:    spline.ypp = new double[n];
 3096: 
 3097:    for (int k=k1; k<=k2; k++) {
 3098:       spline.x[k] = getX(k);
 3099:       spline.y[k] = getY(k);
 3100:    }
 3101: 
 3102:    // This is to simplify expressions later
 3103:    double *x = spline.x;
 3104:    double *y = spline.y;
 3105: 
 3106:    double *a = nullptr;
 3107:    double *b = nullptr;
 3108:    double *c = nullptr;
 3109:    double *gam = nullptr;
 3110:    double *rhs = nullptr;
 3111:    
 3112: 
 3113:       a = new double[n];   // Lower diagonal
 3114:       b = new double[n];   // Diagonal
 3115:       c = new double[n];   // Upper diagonal
 3116:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3117:       rhs = new double[n]; // Right-hand side
 3118: 
 3119:    for (int k=k1; k<=k2; k++) {
 3120:       if (k == k1) {
 3121:          // Bottom level
 3122:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3123:          b[k] = (x[k+1] - x[k])/3.0;
 3124:          c[k] = b[k]/2.0;
 3125:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3126:       } else if (k == n - 1) {
 3127:          // Top level (surface)
 3128:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3129:          b[k] = (x[k] - x[k-1])/3.0;
 3130:          a[k] = b[k]/2.0;
 3131:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3132:       } else {
 3133:          // Intermediate levels
 3134:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3135:          b[k] = (x[k+1] - x[k-1])/3.0;
 3136:          a[k] = (x[k  ] - x[k-1])/6.0;
 3137:          c[k] = (x[k+1] - x[k  ])/6.0;
 3138:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3139:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3140:       }
 3141:    }
 3142: 
 3143:    // Solve the tridiagonal system
 3144:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3145:    
 3146:    spline.yp[k1] = yp_bot;
 3147:    spline.yp[k2] = yp_top;
 3148: 
 3149:    // Compute rest of 1st derivatives using the splines
 3150:    for (int k=k1+1; k<k2; k++) {
 3151:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3152:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3153:    }
 3154:    
 3155:    delete[] a;
 3156:    delete[] b;
 3157:    delete[] c;
 3158:    delete[] gam;
 3159:    delete[] rhs;
 3160: 
 3161: }
 3162: 
 3163: // Array version
 3164: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3165:                                 double y_top, double y_bot, 
 3166:                                 CubicSpline &spline) {
 3167:    auto getX = [x] (int k) { return x[k]; };
 3168:    auto getY = [y] (int k) { return y[k]; };
 3169:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3170: }
 3171: 
 3172: // Lambda version - allows custom access patterns
 3173: template<typename XFunc, typename YFunc>
 3174: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3175:                                 double y_top, double y_bot,
 3176:                                 CubicSpline &spline) {
 3177:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3178: }
