 1887: 
 1888: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 1889:                 double *node_coords, double *wind_rotate_angle, 
 1890:                 int *isdel, int *isidenode, int *isbnd,
 1891:                 int *nond, int *nlnd, int *iond, int *ilnd,
 1892:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 1893:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 1894:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 1895:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 1896:                 int *localNodePart,     int *localElemPart,     int *localSidePart) {
 1897: 
 1898:    printf("Populating mesh for partition %d, %d, %d\n", partNum, nond, nlnd);
 1899: 
 1900:    // Horizontal grid
 1901:    printf("Processing %d nodes\n", np);      
 1902:    for (int i = 0; i < np; i++)
 1903:    {
 1904:       Node &node = localNodeData[i];
 1905: 
 1906:       const int idxStart = nodeNeighNodesStart[i];
 1907:       const int idxEnd   = nodeNeighNodesStart[i+1];
 1908:       node.numNodes = idxEnd - idxStart;
 1909:       node.nodes = (Node **)(nodeNeighNodes + idxStart*sizeof(Node *));
 1910:       node.idx = i;
 1911: 
 1912:       for (int idx = idxStart; idx < idxEnd; idx++) {
 1913:          int idxNode = nodeNeighNodesIndices[idx];
 1914:          Node *node_ptr = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 1915: 
 1916:          nodeNeighNodes[idxNode] = node_ptr;
 1917:          node.nodes = &(nodeNeighNodes[idxNode]);
 1918:       }
 1919: 
 1920:       // Element **elements; // pointer to the elements connected to this node
 1921:       // int numElements;   // number of elements shared by this node
 1922: 
 1923:       node.p.x = node_coords[i * 3];
 1924:       node.p.y = node_coords[i * 3 + 1];
 1925:       node.p.z = node_coords[i * 3 + 2];  // XXX this is probably wrong
 1926:       node.depth = node_coords[i * 3 + 2];
 1927: 
 1928:       // Links the node to the boundary information
 1929:       int idxNodeBoundary = 0;
 1930:       if (isbnd[i] >= 0) {
 1931:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 1932:          if (isbnd[i]>0) {
 1933: 
 1934:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 1935:             node.nodeBnd->segment->ifltype = isbnd[i];
 1936: 
 1937:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 1938:             node.nodeBnd->segment->clen  = nan("1");
 1939:             node.nodeBnd->segment->carea = nan("1");
 1940: 
 1941:          }
 1942:          else {
 1943:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 1944:          }
 1945:          
 1946:          idxNodeBoundary++;
 1947:       }
 1948:       else {
 1949:          node.nodeBnd = nullptr;
 1950:       }
 1951: 
 1952: // XXXX
 1953: constexpr double rot_per = 3000.0;
 1954: constexpr double rot_f = 2.0*pi/rot_per;
 1955: for (int k = 0; k < nvrt; k++) {node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0};}
 1956: // XXXXX
 1957:    }
 1958: 
 1959:    printf("Processing %d sides\n", ns);
 1960:    int idxSideBoundary = 0;
 1961:    for (int i = 0; i < ns; i++)
 1962:    {
 1963:       Side &side = localSideData[i];
 1964:       side.idx = i;
 1965:       // finding the pointer to the nodes that form the side
 1966:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 1967:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 1968: 
 1969:       const int locidx_n1 = localNodeIndices[idx_n1];
 1970:       const int locidx_n2 = localNodeIndices[idx_n2];
 1971:       const int part_n1 =   localNodePart[idx_n1];
 1972:       const int part_n2 =   localNodePart[idx_n2];
 1973: 
 1974:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 1975:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 1976: 
 1977:       // Normal vector to the side
 1978:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 1979:       const double norm = sqrt(dot(side.n, side.n));
 1980:       side.n = side.n/norm;
 1981: 
 1982:       // Side boundary type
 1983:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 1984:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 1985:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 1986:       
 1987:       if (n1bnd != nullptr || n2bnd != nullptr) 
 1988:       {
 1989:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 1990:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 1991:          else                  side.sideBnd->segment = n2bnd->segment;
 1992:          side.sideBnd->side = &side;
 1993:          idxSideBoundary++;
 1994:       }
 1995:       else side.sideBnd = nullptr;
 1996: 
 1997:       // finding the pointer to the elements that share the side
 1998:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 1999:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2000: 
 2001:       if (idx_e1 > -1) {
 2002:          const int locidx_e1 = localElemIndices[idx_e1];
 2003:          const int part_e1 =  localElemPart[idx_e1];
 2004:          side.elems[0] = (Element *)&(elems[part_e1][locidx_e1]);
 2005:       }
 2006:       else {
 2007:          side.elems[0] = nullptr;
 2008:       }
 2009: 
 2010:       if (idx_e2 > -1) {
 2011:          const int locidx_e2 = localElemIndices[idx_e2];
 2012:          const int part_e2 =  localElemPart[idx_e2];
 2013:          side.elems[1] = (Element *)&(elems[part_e2][locidx_e2]);
 2014:       }
 2015:       else {
 2016:          side.elems[1] = nullptr;
 2017:       }
 2018: 
 2019: 
 2020: 
 2021:       // Compute the center of the side
 2022:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2023: 
 2024: // XXXX
 2025: constexpr double rot_per=3000.0;
 2026: constexpr double rot_f=2.0*pi/rot_per;
 2027: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2028: // XXXXX      
 2029: 
 2030:       // Compute the z level at the center of the side
 2031:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->znl[k] + side.n2->znl[k]);
 2032: 
 2033:       // Compute the length of the side
 2034:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2035:       side.length = sqrt(dot(vLen, vLen));
 2036: 
 2037:    }
 2038: 
 2039:    printf("Processing %d elements\n", ne);
 2040:    for (int i = 0; i < ne; i++)
 2041:    {
 2042:       Element &elem = localElemData[i];
 2043:       elem.idx = i;
 2044:       for (int j = 0; j < i34[i]; j++) {
 2045:          const int idxNode = elnode[i*4 + j];  
 2046:          const int idxSide = elside[i*4 + j];
 2047:          
 2048:          elem.nodes[j] = (Node *)&(nodes[localElemPart[idxNode]][localElemIndices[idxNode]]);
 2049:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2050: 
 2051:          // Find the neighboring element  
 2052:          if (elem.sides[j]->elems[0] == &elem) {
 2053:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2054:          }
 2055:          else {
 2056:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2057:          }
 2058:       }
 2059: 
 2060:       
 2061: 
 2062:       elem.i34 = i34[i];
 2063:       elem.wind_angle = wind_rotate_angle[i];
 2064: 
 2065:       // Compute the centroid of the element and its depth
 2066:       Vector2 center = {0.0, 0.0};
 2067:       elem.depth = 0.0;
 2068:       for (int j = 0; j < i34[i]; j++) {
 2069:          center += elem.nodes[j]->p2()/i34[i];
 2070:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2071:       }
 2072:       elem.center.x = center.x;
 2073:       elem.center.y = center.y;
 2074:       
 2075:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2076:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2077: 
 2078:       elem.area = elem.computeSignedArea(); 
 2079:       elem.radius = sqrt(elem.area)/pi; 
 2080:       
 2081:       // Determines which way the normal vector to each side is oriented.
 2082:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2083:       for (int j = 0; j < i34[i]; j++)  
 2084:       {
 2085:          if (elem.sides[j]->elems[0] == &elem) {
 2086:             elem.ssign[j] =  1.0;
 2087:          }
 2088:          else {
 2089:             elem.ssign[j] = -1.0;
 2090:          }
 2091: 
 2092:       }
 2093: 
 2094:       // Derivatives of shape functions
 2095:       //  For ics=2, this is done inside element/ll frame XXX
 2096:       //  For quads, the derivative is evaluated at centroid
 2097:       const int i34 = elem.i34;
 2098:       for (int j = 0; j < i34; j++) {
 2099:          const double area = elem.area;
 2100:          const int id2 = elem.nxq(1 + j);
 2101:          const int id3 = elem.nxq(2 + j);
 2102:          const int id4 = elem.nxq(3 + j);
 2103:          if (elem.isTri()) {
 2104:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2105:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2106:             // da1/dx = (y1 - y2)/(2*area)
 2107:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2108:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2109:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2110:          }
 2111:          else  { // Quad; evaluate at centroid
 2112:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2113:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2114:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2115:          } // if Tri
 2116: 
 2117:       } // for j
 2118: 
 2119:    }
 2120: 
 2121: 
 2122: 
 2123:    
 2124: }
 2125: 
 2126: 
 2127: __global__ void setupCoefficientMatrixAndRHS(double time) {
 2128: // Setup coefficient matrix, sparsem, for the shallow water wave equation
 2129: // No elevation essential b.c. are imposed yet but other b.c. is imposed
 2130: // 
 2131: // This kernel is called for all nodes.
 2132: 
 2133:    int in = 1; //XXX blockIdx.x * blockDim.x + threadIdx.x;
 2134: 
 2135:    Node *node1 = &(mesh->localNodeData[in]);
 2136: 
 2137: 
 2138:    node1->clearMatrixRow();
 2139:    node1->qel = 0.0;
 2140: 
 2141:    // THIS IS FOR STRUCTURES XXX
 2142:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 2143: 
 2144: 
 2145:    for (int j=0; j<node1->numElements; j++) {
 2146:       // For each element connected to the node...
 2147: 
 2148:       Element *elem = node1->elements[j];
 2149: 
 2150: 
 2151:       // Compute the average gravity
 2152:       const double grav3 = elem->mean(&Node::grav2);
 2153: 
 2154:       // Look at the documentation for the description of the terms in the following integrals
 2155: 
 2156:       // Integral I_1 
 2157:       // \bar{\breve{H}} 
 2158:       const double hhatb = elem->mean(&Side::hhat);        
 2159: 
 2160:       assert((hhatb >= 0.0 || ihh != 1) && "Invalid hhat");
 2161: 
 2162:       const int id1 = elem->nodeLocalIdx(node1); 
 2163:       const double area = elem->area;
 2164: 
 2165:       if (elem->isTri()) {
 2166: 
 2167:          // To clarify the notation in this section: 
 2168:          //   i standtimes for the node under consideration (node1)
 2169:          //   j (node2) and k (node3) are the other nodes of the triangle.
 2170:          const int id2 = elem->nxq(1 + id1);
 2171:          const int id3 = elem->nxq(2 + id1);
 2172:          Node *node2 = elem->nodes[id2];
 2173:          Node *node3 = elem->nodes[id3];
 2174: 
 2175:          const Point2 x1 = node1->p2();
 2176:          const Point2 x2 = node2->p2();
 2177:          const Point2 x3 = node3->p2();
 2178: 
 2179:          // integral of phi_i*phi_j
 2180:          const double ipp_ii = (1.0/6.0 )*area;
 2181:          const double ipp_ij = (1.0/12.0)*area;
 2182:          const double ipp_ik = (1.0/12.0)*area;
 2183: 
 2184:          // integral of [(grad phi_i) * (grad phi_j)]
 2185:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 2186:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 2187:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 2188: 
 2189:          // Computes the different components of integral I_1 of each node with respect to node i.
 2190:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 2191:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 2192:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 2193: 
 2194:          node1->addToSparseMatrix(node1, I1_ii);
 2195:          node1->addToSparseMatrix(node2, I1_ij); 
 2196:          node1->addToSparseMatrix(node3, I1_ik);
 2197:      
 2198:       }
 2199:       else { // Quad
 2200:          // XXX IMPLEMENT THIS
 2201:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2202:       } 
 2203: 
 2204:  
 2205:       // Integral I_4
 2206:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 2207:       // Where
 2208:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 2209: 
 2210:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 2211:       // of U over the element.
 2212:       Vector2 Umean = {0.0, 0.0};
 2213:       for (int m=0; m<elem->i34; m++) {      
 2214:          const Side *side = elem->sides[m];
 2215: 
 2216:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 2217:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 2218:       }
 2219:       Umean = Umean/elem->i34;
 2220: 
 2221:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 2222: 
 2223:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 2224:       const double I_4_1 = dot(gradPhi_1, Umean);
 2225: 
 2226:       // Integral of \nabla\phi_i \cdot \pmb{E}
 2227:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 2228:      
 2229:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);
 2230:       
 2231: 
 2232:       // Additional terms 
 2233:       double vnorm = 0.0;
 2234:       if (imm == 2)  { // Pre-compute vnorm on the element
 2235:          Vector3 ubed;
 2236:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 2237: 
 2238:          Vector3 gradP(0.0, 0.0, 1.0);
 2239:          for (int m=0; m < elem->i34; m++) {
 2240:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 2241:            gradP += toVector3(gradP_2D, 0.0);
 2242:          }   
 2243:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 2244:       } // imm==2
 2245: 
 2246:       if (elem->isTri()) {
 2247:          for (int l=0; l<3; l++) {
 2248:            double fac;
 2249: 
 2250:            Node *node = elem->nodes[l];
 2251: 
 2252:            (node == node1)? fac=2.0 : fac=1.0;
 2253: 
 2254:            if (imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 2255:            else        node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 2256:            
 2257:          }
 2258: 
 2259:          if (elem->idry == 0) {
 2260:            const Vector2 gradEta = elem->nodes[0]->eta2*elem->gradPhi[0] +
 2261:                                    elem->nodes[1]->eta2*elem->gradPhi[1] +
 2262:                                    elem->nodes[2]->eta2*elem->gradPhi[2];
 2263: 
 2264:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 2265:          }
 2266: 
 2267:       } // isTri
 2268:       else { // isQuad
 2269:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2270:          // for (int l=0; l<4; l++) {
 2271:          //   const Node *node = elem->nodes[l];
 2272: 
 2273:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 2274:          //   else        tmp2 = node->bdef2 - node->bdef1;
 2275: 
 2276:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 2277:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 2278:          // }
 2279: 
 2280:       } // isQuad
 2281: 
 2282: 
 2283: 
 2284:       node1->qel += (dt/elem->i34)*elem->vsource;
 2285: 
 2286:    } // for all elements connected to the node
 2287:    
 2288: 
 2289: 
 2290:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 2291:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 2292:    NodeBoundary *nodeBnd = node1->nodeBnd;
 2293:    if (nodeBnd != nullptr)  { 
 2294:       // If it is an open boundary node...
 2295: 
 2296:       // At least one open bnd side, maybe two
 2297:       for (int l=0; l<2; l++) { 
 2298: 
 2299:          // Gets each of the sides sharing the node. 
 2300:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 2301: 
 2302:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 2303: 
 2304:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 2305: 
 2306: 
 2307:          if (sideBnd != nullptr) {
 2308:             // If the side is on a boundary...
 2309: 
 2310:             // Get the boundary segment
 2311:             const BoundarySegment *sideSegment = sideBnd->segment;
 2312:             const Side *side = sideBnd->side;
 2313: 
 2314:             // Integral I_3
 2315:             if (sideSegment->ifltype != 0) {
 2316:             // Natural or Flather b.c.
 2317: 
 2318:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 2319:                // especially for Flather b.c.
 2320:                double ri3 = 0.0;
 2321:                if (side->idry != 1) {
 2322:                   // If the side is not dry
 2323:                   
 2324:                   // Computes the side flux of (uth, vth)
 2325:                   double Vn = 0.0;
 2326:                   for (int k = side->kb; k<nvrt-1; k++) {
 2327:                      // uth, vth in lat/lon frame if ics=2
 2328:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 2329:                      const double vn1 = dot(side->uth[k  ], side->n); // outer normal
 2330:                      const double vn2 = dot(side->uth[k+1], side->n);
 2331: 
 2332:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 2333:                   }
 2334: 
 2335:                   ri3 = 0.5*side->length*Vn;
 2336:                }
 2337: 
 2338:                if (sideSegment->ifltype == -1) { // Flather 1
 2339: 
 2340:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 2341:                   assert(side->depth > 0.0 && "Negative depth at Flather boundary");
 2342: 
 2343:                   const double con0 = (1.0/6.0)*side->length*sqrt(grav*side->depth); // For coefficient matrix
 2344:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 2345:                   
 2346:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 2347:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 2348: 
 2349:                } 
 2350:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 2351:                   // Reset ri3
 2352:                   ri3 = 0.0;
 2353: 
 2354:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 2355: 
 2356:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 2357: 
 2358:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 2359:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 2360: 
 2361:                   const double con0 = (1.0/6.0)*side->length*tmp*thetai*dt;
 2362:                   node1->addToSparseMatrix(node1, con0*2.0);
 2363:                   node1->addToSparseMatrix(node2, con0);
 2364: 
 2365:                } // if Flather or Discharge
 2366: 
 2367:                node1->qel -= thetai*dt*ri3;
 2368: 
 2369:             } // I_3
 2370:           
 2371: 
 2372:             // Integral I_5
 2373:             if(side->idry != 1) {
 2374: 
 2375:                const double Unbar = dot(side->U, side->n);
 2376: 
 2377:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->length*Unbar;
 2378:                
 2379:             } // I_5
 2380: 
 2381:          } // if is boundary side
 2382: 
 2383:       } // for l
 2384: 
 2385:    } // if isbnd
 2386: 
 2387: }
 2388: 
 2389: 
 2390: 
 2391: __device__ void backtrackAllNodes(void) {
 2392: 
 2393:    // max/min # of sub-divisions
 2394:    const int ndelt_max = max(1.0, dt/dtb_min);
 2395:    const int ndelt_min = max(1.0, dt/dtb_max); 
 2396: 
 2397:    // Removed all references to swild98 XXX
 2398:    // swild98=0.d0 !init
 2399: 
 2400:    Side *side = SIDE_PTR;
 2401: 
 2402:    const int kb = side->kb;
 2403:    for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 2404: 
 2405:    if (side->idry == 1) return;
 2406: 
 2407:    // Checks that at least one element is not dry
 2408:    const Element *elem1 = side->elems[0];
 2409:    const Element *elem2 = side->elems[1];
 2410:    assert ((elem1 != nullptr && !(elem1->idry)) || (elem2 != nullptr && !(elem2->idry)) && "backtrackAllNodes: non dry side without two dry elements.");
 2411: 
 2412:    // XXXXXX
 2413:    // !swild_tmp to store global coord. of the starting side
 2414:    // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 2415:    // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 2416:    // !Use sframe2 
 2417:    // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 2418: 
 2419: 
 2420:    for (int k = kb; k < nvrt; k++) {
 2421:    //  Initialize (xt,yt,zt), nnel and vel.
 2422:    //  For ics=2, the coordinates are in local frames
 2423:    //  Caution! nnel must be initialized inside this loop as it is updated inside.
 2424: 
 2425: 
 2426:       const int iadvf = side->iadv();  // Advection flag
 2427: 
 2428:       Point3 xt;
 2429:       if constexpr(ics==1) {
 2430:          xt = side->center3D(k); 
 2431:       }
 2432:       else // lat/lon; in side lat/lon frame
 2433:       {
 2434:       // XXX IMPLEMENT THIS
 2435:    //          xt=0.d0
 2436:    //          yt=0.d0
 2437:    //          !centroid coord. for nudging
 2438:    //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 2439:    //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 2440:       }  // ics
 2441: 
 2442: 
 2443:       // Velocity at the side (in ll frame for ics, same vertical direction)
 2444:       // XXX IS THIS NECESSARY?
 2445:       Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 2446: 
 2447:       // If on land or open boundary...
 2448:       const bool ifl_bnd =  (side->sideBnd != nullptr);
 2449:       
 2450:       const double vmag = length(toVector2(u_int));
 2451: 
 2452:       if (vmag <= velmin_btrack) {
 2453:          // No activity 
 2454: 
 2455:          side->btu[k] = side->u2[k];
 2456: 
 2457: 
 2458:       } else {  // do btrack
 2459: 
 2460:          // Compute number of sub-divisions based on local gradients 
 2461:          // XXX IS THIS NECESSARY?
 2462:          double suma = 0.0;
 2463:          int icount = 0;
 2464:          for (int ii=0; ii<2; ii++) {
 2465: 
 2466:             const Element *elem = side->elems[ii];
 2467:               
 2468:             if (elem == nullptr) continue;
 2469: 
 2470:             icount++;
 2471: 
 2472:             // Not strictly along z; in ll frame for ics=2
 2473: 
 2474:             double utmp[4];
 2475:             double vtmp[4];
 2476:             for (int jj = 0; jj < elem->i34; jj++) {
 2477: 
 2478:                const Node *node = elem->nodes[jj];
 2479: 
 2480:                if constexpr(ics==1) {
 2481:                   utmp[jj] = node->u2[k].x;
 2482:                   vtmp[jj] = node->u2[k].y;  
 2483:                } else {
 2484:                   // XXX IMPLEMENT THIS
 2485:                   // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 2486:                }
 2487:             } // for jj
 2488: 
 2489:             const Vector2 grad_u = elem->grad(utmp); 
 2490:             const Vector2 grad_v = elem->grad(vtmp);
 2491: 
 2492:             suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 2493:          } // for ii
 2494: 
 2495:          assert(icount > 0 && "Impossible 77");
 2496: 
 2497:          // '4' is somewhat arbitrary
 2498:          const int ndelt = max(ndelt_min, min(ndelt_max, int(suma/icount)*4)); // >=1
 2499:          const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 2500: 
 2501: 
 2502:          // Perturb starting pt to avoid underflow 
 2503:          // XXX I don't think this is needed with the current implementation
 2504:          // eps=btrack_nudge
 2505:          // if constexpr(ics==1) {
 2506:          //    xt=(1.d0-eps)*xt+eps*xctr(nnel)
 2507:          //    yt=(1.d0-eps)*yt+eps*yctr(nnel)
 2508:          // } else { //lat/lon
 2509:          //    xt=(1.d0-eps)*xt+eps*xctr2
 2510:          //    yt=(1.d0-eps)*yt+eps*yctr2
 2511:          // } // ics
 2512: 
 2513:       
 2514:          // call btrack(l,ipsgb,ifl_bnd,j,iadvf,swild_tmp,swild10_tmp, dtbk,time_rm,time_rm2,uuint,vvint,wwint,nnel,jlev,xt,yt,zt,swild3,ltmp)
 2515: 
 2516:             
 2517:       } // if vmag (do backtrack)
 2518: 
 2519:    } // for j=jmin,nvrt-1
 2520: 
 2521: }
 2522: 
 2523: template<int nc>
 2524: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 2525: 
 2526: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 2527: //
 2528: // a,b,c,r: input vectors and are not modified by this program.
 2529: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 2530: // r is the r.h.s.
 2531: // n: actual rank of the system.
 2532: // rows in u() and r();
 2533: // u: output with nc columns (transposed to rows)
 2534: // gam: a working array.
 2535: //
 2536: // NOTES:
 2537: // This is a template function that allows for different numbers of columns in the rhs vector.
 2538: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 2539: 
 2540:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 2541:    assert(nc <= nvec   && "TRIDAG: Increase number of columns");
 2542:    assert(b[0] != 0.d0 && "TRIDAG: b[0]=0");
 2543: 
 2544:    double bet = b[0];
 2545:    if constexpr (nc == 1) {
 2546:       u[0] = rhs[0]/bet;
 2547:    } else {
 2548:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 2549:    }
 2550: 
 2551:    for (int j = 1; j < n; j++) {
 2552:       gam[j] = c[j-1]/bet;
 2553:       bet = b[j] - a[j]*gam[j];
 2554: 
 2555:       assert (bet!=0.d0 && "TRIDIAGONAL SOLVER: bet=0");
 2556: 
 2557:       if constexpr (nc == 1) {
 2558:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 2559:       } else {
 2560:          for (int k = 0; k < nc; k++) {
 2561:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 2562:          }
 2563:       }
 2564:    }
 2565: 
 2566:    // Back-substitution
 2567:    for (int j=n-1; j>=1; j--) {
 2568:       if constexpr (nc == 1) {
 2569:          u[j] = u[j] - gam[j+1]*u[j-1];
 2570:       } else {
 2571:          for (int k = 0; k < nc; k++) {
 2572:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 2573:          }
 2574:       }
 2575:    }
 2576: }
 2577: 
 2578: 
 2579: // Helper function that contains the core algorithm
 2580: template<typename XAccessor, typename YAccessor>
 2581: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 2582:                                            double yp_top, double yp_bot, 
 2583:                                            double *yp_out, double *ypp_out) {
 2584:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 2585:    // 
 2586:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 2587:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 2588:    //
 2589:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 2590:    // 
 2591:    // Inputs: 
 2592:    //            n: dimension for x etc; # of data pts (>=2);
 2593:    //            getX, getY: functions to access x,y coordinates
 2594:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 2595:    //     Output: 
 2596:    //            ypp[n]: 2nd derivatives used in interpolation.
 2597:    //             yp[n]: 1st derivatives 
 2598: 
 2599:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 2600: 
 2601:    const int n = k2 - k1 + 1;
 2602:    double a[n];   // Lower diagonal
 2603:    double b[n];   // Diagonal
 2604:    double c[n];   // Upper diagonal
 2605:    double gam[n]; // Gamma, used by the tridiagonal solver
 2606:    double rhs[n]; // Right-hand side
 2607: 
 2608:    for (int k=k1; k<=k2; k++) {
 2609:       if (k == k1) {
 2610:          // Bottom level
 2611:          assert(getX(k+1) - getX(k) != 0.0 && "CUBIC SPLINE: bottom problem");
 2612:          b[k] = (getX(k+1) - getX(k))/3.0;
 2613:          c[k] = b[k]/2.0;
 2614:          rhs[k] = (getY(k+1) - getY(k))/(getX(k+1) - getX(k)) - yp_bot;
 2615:       } else if (k == n - 1) {
 2616:          // Top level (surface)
 2617:          assert(getX(k) - getX(k-1) != 0.0 && "CUBIC SPLINE: surface problem");
 2618:          b[k] = (getX(k) - getX(k-1))/3.0;
 2619:          a[k] = b[k]/2.0;
 2620:          rhs[k] = -(getY(k) - getY(k-1))/(getX(k) - getX(k-1)) + yp_top;
 2621:       } else {
 2622:          // Intermediate levels
 2623:          assert(getX(k) - getX(k-1) != 0.0 && getX(k+1) - getX(k) != 0.0 && "CUBIC SPLINE: middle problem");
 2624:          b[k] = (getX(k+1) - getX(k-1))/3.0;
 2625:          a[k] = (getX(k  ) - getX(k-1))/6.0;
 2626:          c[k] = (getX(k+1) - getX(k  ))/6.0;
 2627:          rhs[k] = (getY(k+1) - getY(k  ))/(getX(k+1) - getX(k  )) - 
 2628:                   (getY(k  ) - getY(k-1))/(getX(k  ) - getX(k-1));
 2629:       }
 2630:    }
 2631: 
 2632:    // Solve the tridiagonal system
 2633:    tridag_sch<1>(n, a, b, c, rhs, ypp_out, gam);
 2634:     
 2635:    yp_out[k1] = yp_bot;
 2636:    yp_out[k2] = yp_top;
 2637: 
 2638:    // Compute rest of 1st derivatives using the splines
 2639:    for (int k=k1+1; k<k2; k++) {
 2640:       yp_out[k] = (getY(k+1) - getY(k))/(getX(k+1) - getX(k)) - 
 2641:                   (getX(k+1) - getX(k))/6.0*(2.0*ypp_out[k] + ypp_out[k+1]);
 2642:    }
 2643: }
 2644: 
 2645: // Array version
 2646: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 2647:                                 double y_top, double y_bot, 
 2648:                                 double *yp_out, double *ypp_out) {
 2649:    auto getX = [x] (int k) { return x[k]; };
 2650:    auto getY = [y] (int k) { return y[k]; };
 2651:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, yp_out, ypp_out);
 2652: }
 2653: 
 2654: // Lambda version - allows custom access patterns
 2655: template<typename XFunc, typename YFunc>
 2656: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 2657:                                        double y_top, double y_bot,
 2658:                                        double *yp_out, double *ypp_out) {
 2659:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, yp_out, ypp_out);
 2660: }
