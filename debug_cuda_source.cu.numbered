  169: // Polynomial class
  170: template<int grade>
  171: struct Polynomial {
  172:     // Static assertion to give a clear error message at compile time
  173:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  174: };
  175: 
  176: 
  177: // Explicit specialization for grade 4
  178: template<>
  179: struct Polynomial<4> {
  180:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  181: 
  182:    // Constructor from coefficients
  183:    __device__ __host__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  184: 
  185:    __device__ __host__ __forceinline__ double eval(double x) const {
  186:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  187:    }
  188: };
