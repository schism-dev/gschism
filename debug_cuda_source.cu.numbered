  924: class Mesh {
  925:    public:  
  926: 
  927:    int partNum; // Partition number for this mesh.
  928: 
  929:    // Pointers to each GPU's local memory (size is the number of partitions).
  930:    const Node**    nodes;  
  931:    const Element** elems;  
  932:    const Side**    sides;  
  933:    
  934:    // Local memory
  935:    Node*    localNodeData; 
  936:    Element* localElemData;
  937:    Side*    localSideData; 
  938: 
  939:    NodeBoundary *localNodeBoundaryMem; // Array of objects with the boundary information of each node
  940:    SideBoundary *localSideBoundaryMem; // Array of objects with the boundary information of each side
  941:    BoundarySegment *localSegmentMem;   // Array of objects with the boundary segments
  942:    
  943:    const int npgb;  // Global number of horizontal nodes
  944:    const int negb;  // Global number of elements
  945:    const int nsgb;  // Global number of sides
  946: 
  947:    const int np;   // Local number of horizontal nodes 
  948:    const int ne;   // Local number of elements
  949:    const int ns;   // Local number of sides
  950: 
  951:    int nbp;  // Local number of boundary nodes
  952: 
  953:    const int max_np; // Maximum number of horizontal nodes per partition (shared by all partitions)
  954:    const int max_ne; // Maximum number of elements per partition (shared by all partitions)
  955:    const int max_ns; // Maximum number of sides per partition (shared by all partitions)
  956: 
  957:   
  958:    // Additional topology information
  959:    Node    **nodeNeighNodes; // Array of pointers to the nodes neighbors of each node
  960:    Element **nodeNeighElems; // Array of pointers to the elements neighbors of each node
  961: 
  962: 
  963: 
  964:    // Vertical coordinate system
  965:    // Sigma levels
  966:    double h_s; 
  967:    double h_c; 
  968:    int    kz;
  969:    double theta_b;
  970:    double theta_f, sinh_theta_f;
  971:    double *sigma_lcl;
  972:    double *sigma;
  973:    double *ztot;
  974:    double *cs;
  975:    double *dcs;
  976: 
  977:    // // Get's the pointer to the node using the array of global pointers to nodes
  978:    // __device__ const Node *getGlobalNode(int jn) {
  979:    //    const int idx = jn / max_np; // Get the index of the partition that contains the node
  980:    //    return nodes[idx] + idx;
