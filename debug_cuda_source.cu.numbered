 1257:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1258:       // Compute the different time ramps used in the code 
 1259:       // This function is performed by just one thread
 1260: 
 1261:       if constexpr(ibc == 0) {
 1262:          if (drampbc > 0.0) {
 1263:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1264:          } else {
 1265:             rampbc = 1.0;
 1266:          }
 1267: 
 1268:          if (nws != 0 && drampwind > 0.0) {
 1269:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1270:          } else {
 1271:             rampwind = 1.0;
 1272:          }
 1273:       }
 1274: 
 1275:       if (drampwafo > 0.0) {
 1276:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1277:       } else {
 1278:          rampwafo = 1.0;
 1279:       }
 1280: 
 1281:       // For source/sinks
 1282:       if (if_source && dramp_ss > 0.0) {
 1283:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1284:       } else {
 1285:          ramp_ss = 1.0;
 1286:       }
 1287: 
 1288:       if (dramp > 0.0) {
 1289:          ramp = tanh(2.0*time/86400.0/dramp);
 1290:       } else {
 1291:          ramp = 1.0;
 1292:       }
 1293: 
 1294:       printf("computeTimeRamps: i = %d, nws = %d, if_source = %d, drampbc = %f, drampwind = %f, drampwafo = %f, dramp_ss = %f, dramp = %f\n", 
 1295:              threadIdx.x + blockIdx.x * blockDim.x, nws, if_source, drampbc, drampwind, drampwafo, dramp_ss, dramp);
 1296:    }
