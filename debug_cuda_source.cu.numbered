 1235: // Helper functions for computing the local node index at a given offset from another.
 1236: __device__ __inline__ int nxq(int offset, int index, int size) {
 1237:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1238:    // to the index to make it positive
 1239:    assert(index + offset + 16*size >= 0);
 1240:    return (index + offset + 16*size) % size;  
 1241: }
 1242: 
 1243: __device__ __inline__ int nxq(int index, int size) {
 1244:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1245:    // to the index to make it positive
 1246:    assert(index + 16*size >= 0);
 1247:    return (index + 16*size) % size; 
 1248: }
