 1305:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1306:       // Compute the different time ramps used in the code 
 1307:       // This function is performed by just one thread
 1308: 
 1309:       if constexpr(ibc == 0) {
 1310:          if (drampbc > 0.0) {
 1311:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1312:          } else {
 1313:             rampbc = 1.0;
 1314:          }
 1315: 
 1316:          if (nws != 0 && drampwind > 0.0) {
 1317:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1318:          } else {
 1319:             rampwind = 1.0;
 1320:          }
 1321:       }
 1322: 
 1323:       if (drampwafo > 0.0) {
 1324:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1325:       } else {
 1326:          rampwafo = 1.0;
 1327:       }
 1328: 
 1329:       // For source/sinks
 1330:       if (if_source && dramp_ss > 0.0) {
 1331:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1332:       } else {
 1333:          ramp_ss = 1.0;
 1334:       }
 1335: 
 1336:       if (dramp > 0.0) {
 1337:          ramp = tanh(2.0*time/86400.0/dramp);
 1338:       } else {
 1339:          ramp = 1.0;
 1340:       }
 1341: 
 1342:       printf("computeTimeRamps: i = %d, time = %f, nws = %d, if_source = %d, ramp = %f, drampbc = %f, drampwind = %f, drampwafo = %f, dramp_ss = %f, dramp = %f\n", 
 1343:              threadIdx.x + blockIdx.x * blockDim.x, time, nws, if_source, ramp, drampbc, drampwind, drampwafo, dramp_ss, dramp);
 1344:    }
