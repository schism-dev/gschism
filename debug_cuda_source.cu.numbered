  792: struct Node {
  793: 
  794:    // Geometry information
  795:    int idx;        // Index of the node
  796:    Node **nodes;   // pointer to the nodes that are neighbors of this node (there is no guarantee that they are connected)
  797:    int numNodes;   // number of nodes neighbors of this node
  798: 
  799:    Element **elements; // pointer to the elements that share this node
  800:    int numElements;   // number of elements that share this node
  801: 
  802:    Point3 p;
  803:    Vector3 u2[nvrt];
  804:    double znl[nvrt];
  805:    double lon, lat;
  806:    double depth;
  807: 
  808:    int kb;       // Bottom index of the node
  809: 
  810:    int idry;     // True if the node is dry
  811: 
  812:    int iadv;     // Advection flag
  813: 
  814:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
  815: 
  816:    // Physical information
  817:    Tracers tr_nd0[nvrt]; // Initial tracer conc. at nodes
  818: 
  819:    double rho[nvrt];     // Density
  820: 
  821:    double eta1; // Elevation at nodes at previous timestep
  822:    double eta2; // Elevation at nodes at current timestep
  823: 
  824:    double etp;  // Earth Tidal Potential
  825: 
  826:    
  827:    double pr;    // Air pressure
  828:    double grav2; // Gravity 
  829:    
  830:    Vector2 dav;  // Depth averaged velocity
  831: 
  832:    Vector2 tau; // Wind stress vector
  833: 
  834:    // Vegetation parameters
  835:    double veg_h;
  836:    double veg_nv;
  837:    double veg_di;
  838:    double veg_Cd;
  839:    double veg_h_unbent;
  840:    double veg_di_unbent;
  841:    double veg_nv_unbent;
  842:    double veg_alpha_vert_mean;
  843:    double veg_alpha0;
  844:    double veg_alpha3D[nvrt];
  845: 
  846:    // Bottom drag parameters
  847:    double Cd;       // Bottom drag coefficient
  848:    double rough;    // Bottom roughness length
  849:    Vector2 tau_bot; // Bottom stress vector
  850: 
  851:    double bdef1; // Bottom deformation at previous timestep
  852:    double bdef2; // Bottom deformation at current timestep
  853: 
  854:    double qel; // RHS
  855: 
  856:    __host__ __device__ Point2 p2(void) const { return {p.x, p.y}; }
  857: 
  858:    __host__ __device__ double sigmaTransitionDepth(void) const;
  859: 
  860:    __inline__ __device__ double Dz(int k) const { return znl[k] - znl[k-1]; }
  861:    __inline__ __device__ double htot(void) const { return eta2 + depth; }
  862:    __inline__ __device__ double zTopCanopy(void) const { return znl[kb] + veg_h; } 
  863: 
  864:    __device__ void clearMatrixRow(void) {
  865:       // Clear the matrix row for this node
  866:       printf("NOT IMPLEMENTED: clearMatrixRow\n");
  867:    }
  868: 
  869:    __device__ void addToSparseMatrix(Node const *node, double value) {
  870:       // Add the value to the sparse matrix for this node
  871:       printf("NOT IMPLEMENTED: addToSparseMatrix\n");
  872:    }
  873: 
  874: #ifdef BACKTRACKING
  875:    __device__ void updateZCoordData() {
  876:    // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
  877: 
  878:       // Check if node is wet
  879:       idry = (depth + eta2 <= h0);  // XXX Check if we are doing this elsewhere
  880: 
  881:       if (idry) return;
  882: 
  883:       if constexpr(ivcor == 2) {  // SZ coordinates
  884:          
  885:          // Compute bottom level index
  886:          if (depth <= mesh->h_s) {
  887:                kb = mesh->nzlevels;
  888:          } else {
  889:                kb = -1;
  890:                for (int i = 0; i < mesh->kz-1; i++) {
  891:                   if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
  892:                      kb = i;
  893:                      break;
  894:                   }
  895:                }
  896:          }
  897:       } 
  898:       else if (ivcor == 1) {  // Localized sigma
  899:          // Do nothing
  900:       }
  901: 
  902:    }
  903: #endif   
  904: 
  905:    __device__ double compZCoord(int k) const;
  906: 
  907: 
  908: 
  909: };
