 4446:                   } // outward flux
 4447:                 } // end for j=1,i34(ie) ! side
 4448:               } // end for k; ntr 
 4449: 
 4450:             else !simple upwind method
 4451:               do j=1,i34(ie)
 4452:                 jsj=elside(j,ie)
