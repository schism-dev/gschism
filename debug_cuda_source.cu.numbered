  801: struct Node {
  802: 
  803:    // Geometry information
  804:    int idx;        // Index of the node
  805:    Node **nodes;   // pointer to the nodes that are neighbors of this node (there is no guarantee that they are connected)
  806:    int numNodes;   // number of nodes neighbors of this node
  807: 
  808:    Element **elements; // pointer to the elements that share this node
  809:    int numElements;   // number of elements that share this node
  810: 
  811:    Point3 p;
  812:    Vector3 u2[nvrt];
  813:    double znl[nvrt];
  814:    double lon, lat;
  815:    double fun_lat[ntip]; // XXXXX CHECK IF THIS MAKES SENSE
  816:    double depth;
  817: 
  818:    int kb;       // Bottom index of the node
  819: 
  820:    int idry;     // True if the node is dry
  821: 
  822:    int iadv;     // Advection flag
  823: 
  824:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
  825: 
  826:    // Physical information
  827:    Tracers tr_nd0[nvrt]; // Initial tracer conc. at nodes
  828: 
  829:    double rho[nvrt];     // Density
  830: 
  831:    double eta1; // Elevation at nodes at previous timestep
  832:    double eta2; // Elevation at nodes at current timestep
  833: 
  834:    double ETP;  // Earth Tidal Potential
  835: 
  836:    
  837:    double pr;    // Air pressure
  838:    double grav2; // Gravity 
  839:    
  840:    Vector2 dav;  // Depth averaged velocity
  841: 
  842:    Vector2 tau; // Wind stress vector
  843: 
  844:    // Vegetation parameters
  845:    double veg_h;
  846:    double veg_nv;
  847:    double veg_di;
  848:    double veg_Cd;
  849:    double veg_h_unbent;
  850:    double veg_di_unbent;
  851:    double veg_nv_unbent;
  852:    double veg_alpha_vert_mean;
  853:    double veg_alpha0;
  854:    double veg_alpha3D[nvrt];
  855: 
  856:    // Bottom drag parameters
  857:    double Cd;       // Bottom drag coefficient
  858:    double rough;    // Bottom roughness length
  859:    Vector2 tau_bot; // Bottom stress vector
  860: 
  861:    double bdef1; // Bottom deformation at previous timestep
  862:    double bdef2; // Bottom deformation at current timestep
  863: 
  864:    double qel; // RHS
  865: 
  866:    __host__ __device__ Point2 p2(void) const { return {p.x, p.y}; }
  867: 
  868:    __host__ __device__ double sigmaTransitionDepth(void) const;
  869: 
  870:    __inline__ __device__ double Dz(int k) const { return znl[k] - znl[k-1]; }
  871:    __inline__ __device__ double htot(void) const { return eta2 + depth; }
  872:    __inline__ __device__ double zTopCanopy(void) const { return znl[kb] + veg_h; } 
  873: 
  874:    __device__ void clearMatrixRow(void) {
  875:       // Clear the matrix row for this node
  876:       printf("NOT IMPLEMENTED: clearMatrixRow\n");
  877:    }
  878: 
  879:    __device__ void addToSparseMatrix(Node const *node, double value) {
  880:       // Add the value to the sparse matrix for this node
  881:       printf("NOT IMPLEMENTED: addToSparseMatrix\n");
  882:    }
  883: 
  884: #ifdef BACKTRACKING
  885:    __device__ void updateZCoordData() {
  886:    // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
  887: 
  888:       // Check if node is wet
  889:       idry = (depth + eta2 <= h0);  // XXX Check if we are doing this elsewhere
  890: 
  891:       if (idry) return;
  892: 
  893:       if constexpr(ivcor == 2) {  // SZ coordinates
  894:          
  895:          // Compute bottom level index
  896:          if (depth <= mesh->h_s) {
  897:                kb = mesh->nzlevels;
  898:          } else {
  899:                kb = -1;
  900:                for (int i = 0; i < mesh->kz-1; i++) {
  901:                   if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
  902:                      kb = i;
  903:                      break;
  904:                   }
  905:                }
  906:          }
  907:       } 
  908:       else if (ivcor == 1) {  // Localized sigma
  909:          // Do nothing
  910:       }
  911: 
  912:    }
  913: #endif   
  914: 
  915:    __device__ double compZCoord(int k) const;
  916: 
  917: 
  918: 
  919: };
