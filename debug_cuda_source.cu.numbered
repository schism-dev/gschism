  914: class Mesh {
  915:    public:  
  916: 
  917:    int partNum; // Partition number for this mesh.
  918: 
  919:    // Pointers to each GPU's local memory (size is the number of partitions).
  920:    const Node**    nodes;  
  921:    const Element** elems;  
  922:    const Side**    sides;  
  923:    
  924:    // Local memory
  925:    Node*    localNodeData; 
  926:    Element* localElemData;
  927:    Side*    localSideData; 
  928: 
  929:    NodeBoundary *localNodeBoundaryMem; // Array of objects with the boundary information of each node
  930:    SideBoundary *localSideBoundaryMem; // Array of objects with the boundary information of each side
  931:    BoundarySegment *localSegmentMem;   // Array of objects with the boundary segments
  932:    
  933:    const int npgb;  // Global number of horizontal nodes
  934:    const int negb;  // Global number of elements
  935:    const int nsgb;  // Global number of sides
  936: 
  937:    const int np;   // Local number of horizontal nodes 
  938:    const int ne;   // Local number of elements
  939:    const int ns;   // Local number of sides
  940: 
  941:    int nbp;  // Local number of boundary nodes
  942: 
  943:    const int max_np; // Maximum number of horizontal nodes per partition (shared by all partitions)
  944:    const int max_ne; // Maximum number of elements per partition (shared by all partitions)
  945:    const int max_ns; // Maximum number of sides per partition (shared by all partitions)
  946: 
  947:   
  948:    // Additional topology information
  949:    Node    **nodeNeighNodes; // Array of pointers to the nodes neighbors of each node
  950:    Element **nodeNeighElems; // Array of pointers to the elements neighbors of each node
  951: 
  952: 
  953: 
  954:    // Vertical coordinate system
  955:    // Sigma levels
  956:    double h_s; 
  957:    double h_c; 
  958:    int    kz;
  959:    double theta_b;
  960:    double theta_f, sinh_theta_f;
  961:    double *sigma_lcl;
  962:    double *sigma;
  963:    double *ztot;
  964:    double *cs;
  965:    double *dcs;
  966: 
  967:    // // Get's the pointer to the node using the array of global pointers to nodes
  968:    // __device__ const Node *getGlobalNode(int jn) {
  969:    //    const int idx = jn / max_np; // Get the index of the partition that contains the node
  970:    //    return nodes[idx] + idx;
  971:    // }
  972: 
  973:    // // Get's the pointer to the element using the array of global pointers to elements
  974:    // __device__ const Element *getGlobalElem(int je) {
  975:    //    const int idx = je / max_ne; // Get the index of the partition that contains the element
  976:    //    return elems[idx] + idx;
  977:    // }
  978: 
  979:    // // Get's the pointer to the side using the array of global pointers to sides
  980:    // __device__ const Side *getGlobalSide(int js) {
  981:    //    const int idx = js / max_ns; // Get the index of the partition that contains the side
  982:    //    return sides[idx] + idx;
  983:    // }
  984: 
  985:    // // Get's the global index of local node idx
  986:    // __device__ int getGlobalNodeIndex(int idx) {
  987:    //    return idx + partNum * max_np;
  988:    // }
  989: 
  990:    // // Get's the global index of local element idx
  991:    // __device__ int getGlobalElemIndex(int idx) {
  992:    //    return idx + partNum * max_ne;
  993:    // }
  994: 
  995:    // // Get's the global index of local side idx
  996:    // __device__ int getGlobalSideIndex(int idx) {
  997:    //    return idx + partNum * max_ns;
  998:    // }  
  999: 
 1000:    __device__ Mesh(int partNum,
 1001:                    int npgb, int negb, int nsgb, 
 1002:                    int np, int ne, int ns, int nvrt, int kz,
 1003:                    int max_np, int max_ne, int max_ns, int nseg,
 1004:                    const Node **nodesPtr, const Element **elemsPtr, const Side **sidesPtr,
 1005:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 1006:                    Node    **localNodeNeighNodesMem,
 1007:                    Element **localNodeNeighElemsMem,
 1008:                    NodeBoundary *localNodeBoundaryMem,
 1009:                    SideBoundary *localSideBoundaryMem,
 1010:                    BoundarySegment *localSegmentMem,
 1011:                    double h_s, double theta_b, double theta_f, double *sigma_lcl, double *sigma, double *ztot,
 1012:                    double *cs, double *dcs
 1013:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 1014:                        np(np), ne(ne), ns(ns),
 1015:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
 1016:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
 1017:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
