 1923: //       yIntersect=-1.e25;
 1924: 
 1925: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 1926: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 1927: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 1928: 
 1929: //       if (delta != 0.0) {
 1930: //          // Solves the two linear equations for tt1 and tt2
 1931: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1932: //          const double tt2 = delta2/delta;
 1933: 
 1934: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 1935: //          // Similarly, we use tt2 to compute the intersection point.
 1936: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
