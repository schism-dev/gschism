 2226: 
 2227: __host__ __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2228: 
 2229: __device__ double Node::compZCoord(int k) const {
 2230:    // Computes the z coordinate at level k.
 2231:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2232:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2233:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2234:    // used 
 2235:    
 2236:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2237:       
 2238:    if (isDry)  return 0.0;
 2239: 
 2240:    if constexpr(ivcor == 2) {
 2241: 
 2242:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2243:       const int kz = mesh->kz;
 2244: 
 2245:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2246:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2247:       // once per time step/node.
 2248:       // CHECK: updateZCoordData
 2249: 
 2250:       if (k == kz)               return -hmod2;
 2251:       else if (k == nvrt-1)      return eta2;
 2252:       else if (k == kb)          return -depth;
 2253:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2254:       else if (k > kz) {
 2255:          const int ksig = k - kz + 1;
 2256: 
 2257:          if (hmod2 <= mesh->h_c) {
 2258:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2259:          } 
 2260:          else if (eta2 <= - mesh->h_c - (depth - mesh->h_c) * mesh->theta_f/mesh->sinh_theta_f) {
 2261:             printf("Please choose larger h_c: %f %f\n", eta2, mesh->h_c);
 2262:             Error("ZCOOR: invalid h_c\n");
 2263:          } 
 2264:          else {
 2265:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2266:                          mesh->h_c * mesh->sigma[ksig] + 
 2267:                          (hmod2 - mesh->h_c) * mesh->cs[ksig];
 2268:          }
 2269:       } else { 
 2270:          Error("ZCOOR: invalid level or coordinate system\n");
 2271:       }
 2272: 
 2273:    }
 2274:    else if constexpr(ivcor == 1) {
 2275:       if (k == kb) return -depth;
 2276:       else if (k == nvrt-1) return eta2;
 2277:       else if (k >= kb) {
 2278:             return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2279:       }
 2280:    }
 2281:    
 2282:    printf("ZCOOR: invalid level or coordinate system\n");
 2283:    return 0.0;
 2284: }
