 3290: extern "C" {
 3291: 
 3292:    __global__ void scaleGravity(double loadtide_coef) {
 3293: 
 3294: 
 3295:       NODE(node);
 3296: 
 3297:       // SAL option: scale gravity
 3298:       if constexpr(iloadtide==2) {  // simple const
 3299:          node->grav2 = grav*(1.0 - loadtide_coef);
 3300: 
 3301:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3302:         
 3303:           const double depth = max(node->depth, 0.0);
 3304:           const double tmp1 = sqrt(depth);
 3305:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3306:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3307:                              2.6969e-13*depth*depth*depth*tmp1;
 3308:           
 3309:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3310:           
 3311: 
 3312: 
 3313:           node->grav2 = grav*(1.0 - beta_bar);
 3314: 
 3315:       } else {  // iloadtide=0,1
 3316:         node->grav2=grav;
 3317: 
 3318:       }
 3319: 
 3320:       printf("scaleGravity: node(%d)->grav2 = %f\n", node->idx, node->grav2);
 3321:    }
 3322: 
