 3092:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3093: 
 3094:       NODE_BND(nodeBnd);
 3095: 
 3096:       Node *node = nodeBnd->node;
 3097: 
 3098:       printf("computeTidalPotential: nodeIdx = %d, ntip = %d\n", node->idx, ntip);
 3099:       node->ETP = 0.0;
 3100: 
 3101:       for (int j=0; j<ntip; j++) {
 3102: 
 3103:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3104:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3105:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3106: 
 3107:          if constexpr(iloadtide==1) { // loading tide
 3108:             assert(false && "Loading tide not implemented");
 3109:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3110:          }
 3111:          
 3112:       }
 3113:       
 3114:    }
