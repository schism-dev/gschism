 3493:    __global__ void computeElevationBoundaryConditions(double time) {
 3494:       // Compute elevation essential boundary conditions 
 3495: 
 3496:       NODE_BND(nodeBnd); // Each boundary node.
 3497: 
 3498:       const Node *node = nodeBnd->node;
 3499:       const int iettype = nodeBnd->iettype;
 3500: 
 3501:       double eic = 0.0;
 3502:       if (nramp_elev==1) eic = nodeBnd->etaic;
 3503:       else               eic = 0.0;
 3504: 
 3505:       const double r_eic = (1.0 - ramp)*eic; 
 3506:       const double r_eth = ramp*nodeBnd->eth;
 3507:       double eta1_bar = r_eic;
 3508: 
 3509: printf("++++>> node[%d]->iettype = %d\n", node->idx, iettype);
 3510:       // Compute tide elevation
 3511:       if (iettype == 3 || iettype == 5) {   
 3512: 
 3513:          if constexpr(iloadtide==1) { // loading tide
 3514:             assert(false && "Loading tide not implemented");
 3515:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3516:          }
 3517:          
 3518:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 3519: 
 3520:             const double efa  = nodeBnd->efa[jfr]; 
 3521:             const double emo  = nodeBnd->emo[jfr]; 
 3522: 
 3523:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 3524:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 3525:             eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 3526: 
 3527:  printf("++++>> jfr = %d, time = %f, ramp = %f, node->idx = %d, amig = %f, face = %f, ff = %f, efa = %f, emo = %f, arg = %f, eta1_bar = %f\n", jfr, time, ramp, node->idx, amig[jfr], face[jfr], ff[jfr], efa, emo, arg, eta1_bar);            
 3528:          } // for jfr
 3529: 
 3530:       } // if iettype
 3531: 
 3532:       switch (iettype) {
 3533:          case 1:
 3534:          case 2:
 3535:             nodeBnd->elbc = r_eth + r_eic;
 3536:             break;
 3537:          case 3:
 3538:             nodeBnd->elbc = eta1_bar + r_eic;
 3539:             break;
 3540:          case 4:
 3541:             nodeBnd->elbc = r_eth + r_eic;
 3542:             break;
 3543:          case 5:
 3544:             nodeBnd->elbc = r_eth + eta1_bar + r_eic;
 3545:             break;
 3546:       } // switch
 3547: 
 3548: 
 3549:       //Add inverse barometric effects
 3550:       if (iettype != 0 && inv_atm_bnd == 1) {
 3551:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 3552:       }
 3553: printf("++++>> nodeBnd->elbc = %f\n", nodeBnd->elbc);
 3554:    }
 3555: 
 3556: 
 3557:    __global__ void setEssentialBC(void) {
 3558:       // Set essential boundary conditions 
 3559:       NODE(node); // Each boundary node
 3560:       NodeBoundary *nodeBnd = node->nodeBnd;
 3561: printf("node idx = %d, nodeBnd = %p, essentialBC = %d\n", node->idx, nodeBnd, nodeBnd ? nodeBnd->isEssentialBC : -1);
 3562:       
 3563: // nodeBnd->isEssentialBC = true;      
 3564:       // Check if this node has essential BC
 3565:       if (nodeBnd && nodeBnd->isEssentialBC) {
 3566:          // Verify BC value is valid
 3567:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 3568: 
 3569:          printf("XX node IDX = %d, nodeBnd->isEssentialBC = %d\n", node->idx, nodeBnd->isEssentialBC);
 3570:          
 3571:          // Set diagonal to 1 and zero off-diagonals
 3572:          node->coeffDiag = 1.0;
 3573:          printf("ZZZZZZZ node->coeffDiag = %16.9f\n", node->coeffDiag);
 3574: 
 3575:          for (int j = 0; j < node->numNodes; j++) {
 3576:                node->coeffMatrix[j] = 0.0;
 3577:                printf("YY node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 3578:          }
 3579:          
 3580:          // Set solution and RHS to BC value
 3581:          node->mX  = nodeBnd->elbc;
 3582:          node->qel = nodeBnd->elbc;
 3583: printf("{{{{ node->mX = %f, node->qel = %f\n", node->mX, node->qel);         
 3584:       } else {
 3585:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 3586: 
 3587:          for (int j = 0; j < node->numNodes; j++) {
 3588:                Node* nbNode = node->nodes[j];
 3589:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 3590:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 3591:                   // Verify neighbor's BC value
 3592:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 3593: 
 3594:                   // Subtract contribution to RHS
 3595:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 3596:                   node->coeffMatrix[j] = 0.0;  
 3597:                   printf("ZZ node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 3598:                }
 3599:          }
 3600:       }
 3601:    }
 3602: 
 3603: 
 3604:    __global__ void updateElevation(void) {
 3605:       NODE(node);
 3606: 
 3607:       node->eta2 = node->mX;
 3608: printf("node[%d]->eta2 = %f, qel = %f\n", node->idx, node->eta2, node->qel);
 3609:    }
