 1976: 
 1977: __host__ __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 1978: 
 1979: __device__ double Node::compZCoord(int k) const {
 1980:    // Computes the z coordinate at level k.
 1981:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 1982:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 1983:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 1984:    // used 
 1985:    
 1986:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 1987:       
 1988:    if (idry) {
 1989:       return 0.0;
 1990:    }
 1991: 
 1992:    if constexpr(ivcor == 2) {
 1993: 
 1994:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 1995:       const int kz = mesh->kz;
 1996: 
 1997:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 1998:       // The FORTAN code computes it every time this function is called, but it should be done only 
 1999:       // once per time step/node.
 2000:       // CHECK: updateZCoordData
 2001:       if (k == kz)               return -hmod2;
 2002:       else if (k == nvrt-1)      return eta2;
 2003:       else if (k == kb)          return -depth;
 2004:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2005:       else if (k > kz) {
 2006:          const int ksig = k - kz + 1;
 2007: 
 2008:          if (hmod2 <= mesh->h_c) {
 2009:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2010:          } 
 2011:          else if (eta2 <= - mesh->h_c - (depth - mesh->h_c) * mesh->theta_f/mesh->sinh_theta_f) {
 2012:             printf("Please choose larger h_c: %f %f\n", eta2, mesh->h_c);
 2013:             Error("ZCOOR: invalid h_c\n");
 2014:          } 
 2015:          else {
 2016:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2017:                          mesh->h_c * mesh->sigma[ksig] + 
 2018:                          (hmod2 - mesh->h_c) * mesh->cs[ksig];
 2019:          }
 2020:       } else { 
 2021:          Error("ZCOOR: invalid level or coordinate system\n");
 2022:       }
 2023: 
 2024:    }
 2025:    else if constexpr(ivcor == 1) {
 2026:       if (k == kb) return -depth;
 2027:       else if (k == nvrt-1) return eta2;
 2028:       else if (k >= kb) {
 2029:             return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2030:       }
 2031:    }
 2032:    
 2033:    printf("ZCOOR: invalid level or coordinate system\n");
 2034:    return 0.0;
 2035: }
 2036: 
 2037: 
 2038: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2039:                 double *node_coords, double *wind_rotate_angle, 
 2040:                 int *isdel, int *isidenode, int *isbnd,
 2041:                 int *nond, int *nlnd, int *iond, int *ilnd,
 2042:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2043:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2044:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2045:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2046:                 int *localNodePart,     int *localElemPart,     int *localSidePart) {
 2047: 
 2048:    printf("Populating mesh for partition %d, %d, %d\n", partNum, nond, nlnd);
 2049: 
 2050:    // Horizontal grid
 2051:    printf("Processing %d nodes\n", np);    
 2052:    int idxNodeBoundary = 0;  
 2053:    for (int i = 0; i < np; i++)
 2054:    {
 2055:       Node &node = localNodeData[i];
 2056: 
 2057:       const int idxStart = nodeNeighNodesStart[i];
 2058:       const int idxEnd   = nodeNeighNodesStart[i+1];
 2059:       node.numNodes = idxEnd - idxStart;
 2060:       node.nodes = (Node **)(nodeNeighNodes + idxStart*sizeof(Node *));
 2061:       node.idx = i;
 2062: 
 2063:       for (int idx = idxStart; idx < idxEnd; idx++) {
 2064:          int idxNode = nodeNeighNodesIndices[idx];
 2065:          Node *node_ptr = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 2066: 
 2067:          nodeNeighNodes[idxNode] = node_ptr;
 2068:          node.nodes = &(nodeNeighNodes[idxNode]);
 2069:       }
 2070: 
 2071:       // Element **elements; // pointer to the elements connected to this node
 2072:       // int numElements;   // number of elements shared by this node
 2073: 
 2074:       node.p.x = node_coords[i * 3];
 2075:       node.p.y = node_coords[i * 3 + 1];
 2076:       node.p.z = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2077:       node.depth = node_coords[i * 3 + 2];
 2078: 
 2079:       // Links the node to the boundary information
 2080:       if (isbnd[i] >= 0) {
 2081:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2082:          if (isbnd[i]>0) {
 2083: 
 2084:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2085:             node.nodeBnd->segment->ifltype = isbnd[i];
 2086: 
 2087:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2088:             node.nodeBnd->segment->clen  = nan("1");
 2089:             node.nodeBnd->segment->carea = nan("1");
 2090: 
 2091:          }
 2092:          else {
 2093:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2094:          }
 2095:          
 2096:          idxNodeBoundary++;
 2097:       }
 2098:       else {
 2099:          node.nodeBnd = nullptr;
 2100:       }
 2101: 
 2102: // XXXX
 2103: constexpr double rot_per = 3000.0;
 2104: constexpr double rot_f = 2.0*pi/rot_per;
 2105: for (int k = 0; k < nvrt; k++) {node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0};}
 2106: // XXXXX
 2107:    }
 2108: 
 2109:    nbp = idxNodeBoundary;
 2110: 
 2111:    printf("Processing %d sides\n", ns);
 2112:    int idxSideBoundary = 0;
 2113:    for (int i = 0; i < ns; i++)
 2114:    {
 2115:       Side &side = localSideData[i];
 2116:       side.idx = i;
 2117:       // finding the pointer to the nodes that form the side
 2118:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2119:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2120: 
 2121:       const int locidx_n1 = localNodeIndices[idx_n1];
 2122:       const int locidx_n2 = localNodeIndices[idx_n2];
 2123:       const int part_n1 =   localNodePart[idx_n1];
 2124:       const int part_n2 =   localNodePart[idx_n2];
 2125: 
 2126:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2127:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2128: 
 2129:       // Normal vector to the side
 2130:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2131:       const double norm = sqrt(dot(side.n, side.n));
 2132:       side.n = side.n/norm;
 2133: 
 2134:       // Side boundary type
 2135:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 2136:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 2137:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2138:       
 2139:       if (n1bnd != nullptr || n2bnd != nullptr) 
 2140:       {
 2141:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2142:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2143:          else                  side.sideBnd->segment = n2bnd->segment;
 2144:          side.sideBnd->side = &side;
 2145:          idxSideBoundary++;
 2146:       }
 2147:       else side.sideBnd = nullptr;
 2148: 
 2149:       // finding the pointer to the elements that share the side
 2150:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2151:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2152: 
 2153:       if (idx_e1 > -1) {
 2154:          const int locidx_e1 = localElemIndices[idx_e1];
 2155:          const int part_e1 =  localElemPart[idx_e1];
 2156:          side.elems[0] = (Element *)&(elems[part_e1][locidx_e1]);
 2157:       }
 2158:       else {
 2159:          side.elems[0] = nullptr;
 2160:       }
 2161: 
 2162:       if (idx_e2 > -1) {
 2163:          const int locidx_e2 = localElemIndices[idx_e2];
 2164:          const int part_e2 =  localElemPart[idx_e2];
 2165:          side.elems[1] = (Element *)&(elems[part_e2][locidx_e2]);
 2166:       }
 2167:       else {
 2168:          side.elems[1] = nullptr;
 2169:       }
 2170: 
 2171: 
 2172: 
 2173:       // Compute the center of the side
 2174:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2175: 
 2176: // XXXX
 2177: constexpr double rot_per=3000.0;
 2178: constexpr double rot_f=2.0*pi/rot_per;
 2179: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2180: // XXXXX      
 2181: 
 2182:       // Compute the z level at the center of the side
 2183:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->znl[k] + side.n2->znl[k]);
 2184: 
 2185:       // Compute the length of the side
 2186:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2187:       side.length = sqrt(dot(vLen, vLen));
 2188: 
 2189:    }
 2190: 
 2191:    printf("Processing %d elements\n", ne);
 2192:    for (int i = 0; i < ne; i++)
 2193:    {
 2194:       Element &elem = localElemData[i];
 2195:       elem.idx = i;
 2196:       for (int j = 0; j < i34[i]; j++) {
 2197:          const int idxNode = elnode[i*4 + j];  
 2198:          const int idxSide = elside[i*4 + j];
 2199:          
 2200:          elem.nodes[j] = (Node *)&(nodes[localElemPart[idxNode]][localElemIndices[idxNode]]);
 2201:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2202: 
 2203:          // Find the neighboring element  
 2204:          if (elem.sides[j]->elems[0] == &elem) {
 2205:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2206:          }
 2207:          else {
 2208:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2209:          }
 2210:       }
 2211: 
 2212:       
 2213: 
 2214:       elem.i34 = i34[i];
 2215:       elem.wind_angle = wind_rotate_angle[i];
 2216: 
 2217:       // Compute the centroid of the element and its depth
 2218:       Vector2 center = {0.0, 0.0};
 2219:       elem.depth = 0.0;
 2220:       for (int j = 0; j < i34[i]; j++) {
 2221:          center += elem.nodes[j]->p2()/i34[i];
 2222:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2223:       }
 2224:       elem.center.x = center.x;
 2225:       elem.center.y = center.y;
 2226:       
 2227:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2228:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2229: 
 2230:       elem.area = elem.computeSignedArea(); 
 2231:       elem.radius = sqrt(elem.area)/pi; 
 2232:       
 2233:       // Determines which way the normal vector to each side is oriented.
 2234:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2235:       for (int j = 0; j < i34[i]; j++)  
 2236:       {
 2237:          if (elem.sides[j]->elems[0] == &elem) {
 2238:             elem.ssign[j] =  1.0;
 2239:          }
 2240:          else {
 2241:             elem.ssign[j] = -1.0;
 2242:          }
 2243: 
 2244:       }
 2245: 
 2246:       // Derivatives of shape functions
 2247:       //  For ics=2, this is done inside element/ll frame XXX
 2248:       //  For quads, the derivative is evaluated at centroid
 2249:       const int i34 = elem.i34;
 2250:       for (int j = 0; j < i34; j++) {
 2251:          const double area = elem.area;
 2252:          const int id2 = elem.nxq(1 + j);
 2253:          const int id3 = elem.nxq(2 + j);
 2254:          const int id4 = elem.nxq(3 + j);
 2255:          if (elem.isTri()) {
 2256:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2257:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2258:             // da1/dx = (y1 - y2)/(2*area)
 2259:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2260:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2261:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2262:          }
 2263:          else  { // Quad; evaluate at centroid
 2264:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2265:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2266:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2267:          } // if Tri
 2268: 
 2269:       } // for j
 2270: 
 2271:    }
 2272: 
 2273: 
 2274: 
 2275:    
 2276: }
 2277: 
 2278: 
 2279: __global__ void setupCoefficientMatrixAndRHS(double time) {
 2280: // Setup coefficient matrix, sparsem, for the shallow water wave equation
 2281: // No elevation essential b.c. are imposed yet but other b.c. is imposed
 2282: // 
 2283: // This kernel is called for all nodes.
 2284: 
 2285:    int in = 1; //XXX blockIdx.x * blockDim.x + threadIdx.x;
 2286: 
 2287:    Node *node1 = &(mesh->localNodeData[in]);
 2288: 
 2289: 
 2290:    node1->clearMatrixRow();
 2291:    node1->qel = 0.0;
 2292: 
 2293:    // THIS IS FOR STRUCTURES XXX
 2294:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 2295: 
 2296: 
 2297:    for (int j=0; j<node1->numElements; j++) {
 2298:       // For each element connected to the node...
 2299: 
 2300:       Element *elem = node1->elements[j];
 2301: 
 2302: 
 2303:       // Compute the average gravity
 2304:       const double grav3 = elem->mean(&Node::grav2);
 2305: 
 2306:       // Look at the documentation for the description of the terms in the following integrals
 2307: 
 2308:       // Integral I_1 
 2309:       // \bar{\breve{H}} 
 2310:       const double hhatb = elem->mean(&Side::hhat);        
 2311: 
 2312:       assert((hhatb >= 0.0 || ihh != 1) && "Invalid hhat");
 2313: 
 2314:       const int id1 = elem->nodeLocalIdx(node1); 
 2315:       const double area = elem->area;
 2316: 
 2317:       if (elem->isTri()) {
 2318: 
 2319:          // To clarify the notation in this section: 
 2320:          //   i standtimes for the node under consideration (node1)
 2321:          //   j (node2) and k (node3) are the other nodes of the triangle.
 2322:          const int id2 = elem->nxq(1 + id1);
 2323:          const int id3 = elem->nxq(2 + id1);
 2324:          Node *node2 = elem->nodes[id2];
 2325:          Node *node3 = elem->nodes[id3];
 2326: 
 2327:          const Point2 x1 = node1->p2();
 2328:          const Point2 x2 = node2->p2();
 2329:          const Point2 x3 = node3->p2();
 2330: 
 2331:          // integral of phi_i*phi_j
 2332:          const double ipp_ii = (1.0/6.0 )*area;
 2333:          const double ipp_ij = (1.0/12.0)*area;
 2334:          const double ipp_ik = (1.0/12.0)*area;
 2335: 
 2336:          // integral of [(grad phi_i) * (grad phi_j)]
 2337:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 2338:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 2339:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 2340: 
 2341:          // Computes the different components of integral I_1 of each node with respect to node i.
 2342:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 2343:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 2344:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 2345: 
 2346:          node1->addToSparseMatrix(node1, I1_ii);
 2347:          node1->addToSparseMatrix(node2, I1_ij); 
 2348:          node1->addToSparseMatrix(node3, I1_ik);
 2349:      
 2350:       }
 2351:       else { // Quad
 2352:          // XXX IMPLEMENT THIS
 2353:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2354:       } 
 2355: 
 2356:  
 2357:       // Integral I_4
 2358:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 2359:       // Where
 2360:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 2361: 
 2362:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 2363:       // of U over the element.
 2364:       Vector2 Umean = {0.0, 0.0};
 2365:       for (int m=0; m<elem->i34; m++) {      
 2366:          const Side *side = elem->sides[m];
 2367: 
 2368:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 2369:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 2370:       }
 2371:       Umean = Umean/elem->i34;
 2372: 
 2373:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 2374: 
 2375:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 2376:       const double I_4_1 = dot(gradPhi_1, Umean);
 2377: 
 2378:       // Integral of \nabla\phi_i \cdot \pmb{E}
 2379:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 2380:      
 2381:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);
 2382:       
 2383: 
 2384:       // Additional terms 
 2385:       double vnorm = 0.0;
 2386:       if (imm == 2)  { // Pre-compute vnorm on the element
 2387:          Vector3 ubed;
 2388:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 2389: 
 2390:          Vector3 gradP(0.0, 0.0, 1.0);
 2391:          for (int m=0; m < elem->i34; m++) {
 2392:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 2393:            gradP += toVector3(gradP_2D, 0.0);
 2394:          }   
 2395:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 2396:       } // imm==2
 2397: 
 2398:       if (elem->isTri()) {
 2399:          for (int l=0; l<3; l++) {
 2400:            double fac;
 2401: 
 2402:            Node *node = elem->nodes[l];
 2403: 
 2404:            (node == node1)? fac=2.0 : fac=1.0;
 2405: 
 2406:            if (imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 2407:            else        node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 2408:            
 2409:          }
 2410: 
 2411:          if (elem->idry == 0) {
 2412:            const Vector2 gradEta = elem->nodes[0]->eta2*elem->gradPhi[0] +
 2413:                                    elem->nodes[1]->eta2*elem->gradPhi[1] +
 2414:                                    elem->nodes[2]->eta2*elem->gradPhi[2];
 2415: 
 2416:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 2417:          }
 2418: 
 2419:       } // isTri
 2420:       else { // isQuad
 2421:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2422:          // for (int l=0; l<4; l++) {
 2423:          //   const Node *node = elem->nodes[l];
 2424: 
 2425:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 2426:          //   else        tmp2 = node->bdef2 - node->bdef1;
 2427: 
 2428:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 2429:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 2430:          // }
 2431: 
 2432:       } // isQuad
 2433: 
 2434: 
 2435: 
 2436:       node1->qel += (dt/elem->i34)*elem->vsource;
 2437: 
 2438:    } // for all elements connected to the node
 2439:    
 2440: 
 2441: 
 2442:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 2443:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 2444:    NodeBoundary *nodeBnd = node1->nodeBnd;
 2445:    if (nodeBnd != nullptr)  { 
 2446:       // If it is an open boundary node...
 2447: 
 2448:       // At least one open bnd side, maybe two
 2449:       for (int l=0; l<2; l++) { 
 2450: 
 2451:          // Gets each of the sides sharing the node. 
 2452:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 2453: 
 2454:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 2455: 
 2456:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 2457: 
 2458: 
 2459:          if (sideBnd != nullptr) {
 2460:             // If the side is on a boundary...
 2461: 
 2462:             // Get the boundary segment
 2463:             const BoundarySegment *sideSegment = sideBnd->segment;
 2464:             const Side *side = sideBnd->side;
 2465: 
 2466:             // Integral I_3
 2467:             if (sideSegment->ifltype != 0) {
 2468:             // Natural or Flather b.c.
 2469: 
 2470:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 2471:                // especially for Flather b.c.
 2472:                double ri3 = 0.0;
 2473:                if (side->idry != 1) {
 2474:                   // If the side is not dry
 2475:                   
 2476:                   // Computes the side flux of (uth, vth)
 2477:                   double Vn = 0.0;
 2478:                   for (int k = side->kb; k<nvrt-1; k++) {
 2479:                      // uth, vth in lat/lon frame if ics=2
 2480:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 2481:                      const double vn1 = dot(side->uth[k  ], side->n); // outer normal
 2482:                      const double vn2 = dot(side->uth[k+1], side->n);
 2483: 
 2484:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 2485:                   }
 2486: 
 2487:                   ri3 = 0.5*side->length*Vn;
 2488:                }
 2489: 
 2490:                if (sideSegment->ifltype == -1) { // Flather 1
 2491: 
 2492:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 2493:                   assert(side->depth > 0.0 && "Negative depth at Flather boundary");
 2494: 
 2495:                   const double con0 = (1.0/6.0)*side->length*sqrt(grav*side->depth); // For coefficient matrix
 2496:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 2497:                   
 2498:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 2499:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 2500: 
 2501:                } 
 2502:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 2503:                   // Reset ri3
 2504:                   ri3 = 0.0;
 2505: 
 2506:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 2507: 
 2508:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 2509: 
 2510:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 2511:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 2512: 
 2513:                   const double con0 = (1.0/6.0)*side->length*tmp*thetai*dt;
 2514:                   node1->addToSparseMatrix(node1, con0*2.0);
 2515:                   node1->addToSparseMatrix(node2, con0);
 2516: 
 2517:                } // if Flather or Discharge
 2518: 
 2519:                node1->qel -= thetai*dt*ri3;
 2520: 
 2521:             } // I_3
 2522:           
 2523: 
 2524:             // Integral I_5
 2525:             if(side->idry != 1) {
 2526: 
 2527:                const double Unbar = dot(side->U, side->n);
 2528: 
 2529:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->length*Unbar;
 2530:                
 2531:             } // I_5
 2532: 
 2533:          } // if is boundary side
 2534: 
 2535:       } // for l
 2536: 
 2537:    } // if isbnd
 2538: 
 2539: }
 2540: 
 2541: 
 2542: extern "C" {
 2543:    __global__ void backtrackAllNodes(void) {
 2544: 
 2545:       // max/min # of sub-divisions
 2546:       const int ndelt_max = max(1.0, dt/dtb_min);
 2547:       const int ndelt_min = max(1.0, dt/dtb_max); 
 2548: 
 2549:       // Removed all references to swild98 XXX
 2550:       // swild98=0.d0 !init
 2551: 
 2552:       SIDE(side);
 2553: 
 2554:       if (side - mesh->localSideData >= mesh->ns) return;
 2555: 
 2556:       const int kb = side->kb;
 2557: 
 2558:       // Initialize btrack velocities to the actual velocities at the side 
 2559:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 2560: 
 2561:       if (side->idry == 1) return;
 2562: 
 2563:       // Checks that at least one element is not dry
 2564:       const Element *elem1 = side->elems[0];
 2565:       const Element *elem2 = side->elems[1];
 2566:       assert ((elem1 != nullptr && !(elem1->idry)) || (elem2 != nullptr && !(elem2->idry)) && "backtrackAllNodes: non dry side without two dry elements.");
 2567: 
 2568:       // XXXXXX
 2569:       // !swild_tmp to store global coord. of the starting side
 2570:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 2571:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 2572:       // !Use sframe2 
 2573:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 2574: 
 2575: 
 2576:       for (int k = kb; k < nvrt; k++) {
 2577:       //  Initialize (xt,yt,zt), nnel and vel.
 2578:       //  For ics=2, the coordinates are in local frames
 2579:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 2580: 
 2581: 
 2582:          const int iadvf = side->iadv();  // Advection flag
 2583: 
 2584:          Point3 xt;
 2585:          if constexpr(ics==1) {
 2586:             xt = side->center3D(k); 
 2587:          }
 2588:          else // lat/lon; in side lat/lon frame
 2589:          {
 2590:          // XXX IMPLEMENT THIS
 2591:       //          xt=0.d0
 2592:       //          yt=0.d0
 2593:       //          !centroid coord. for nudging
 2594:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 2595:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 2596:          }  // ics
 2597: 
 2598: 
 2599:          // Velocity at the side (in ll frame for ics, same vertical direction)
 2600:          // XXX IS THIS NECESSARY?
 2601:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 2602: 
 2603:          // If on land or open boundary...
 2604:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 2605:          
 2606:          const double vmag = length(toVector2(u_int));
 2607: 
 2608:          if (vmag <= velmin_btrack) {
 2609:             // No activity 
 2610: 
 2611:             side->btu[k] = side->u2[k];
 2612: 
 2613: 
 2614:          } else {  // do btrack
 2615: 
 2616:             // Compute number of sub-divisions based on local gradients 
 2617:             // XXX IS THIS NECESSARY?
 2618:             double suma = 0.0;
 2619:             int icount = 0;
 2620:             for (int ii=0; ii<2; ii++) {
 2621: 
 2622:                const Element *elem = side->elems[ii];
 2623:                  
 2624:                if (elem == nullptr) continue;
 2625: 
 2626:                icount++;
 2627: 
 2628:                // Not strictly along z; in ll frame for ics=2
 2629: 
 2630:                double utmp[4];
 2631:                double vtmp[4];
 2632:                for (int jj = 0; jj < elem->i34; jj++) {
 2633: 
 2634:                   const Node *node = elem->nodes[jj];
 2635: 
 2636:                   if constexpr(ics==1) {
 2637:                      utmp[jj] = node->u2[k].x;
 2638:                      vtmp[jj] = node->u2[k].y;  
 2639:                   } else {
 2640:                      // XXX IMPLEMENT THIS
 2641:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 2642:                   }
 2643:                } // for jj
 2644: 
 2645:                const Vector2 grad_u = elem->grad(utmp); 
 2646:                const Vector2 grad_v = elem->grad(vtmp);
 2647: 
 2648:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 2649:             } // for ii
 2650: 
 2651:             assert(icount > 0 && "Impossible 77");
 2652: 
 2653:             // '4' is somewhat arbitrary
 2654:             const int ndelt = max(ndelt_min, min(ndelt_max, int(suma/icount)*4)); // >=1
 2655:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 2656: 
 2657: 
 2658:             // Perturb starting pt to avoid underflow 
 2659:             // XXX I don't think this is needed with the current implementation
 2660:             // eps=btrack_nudge
 2661:             // if constexpr(ics==1) {
 2662:             //    xt=(1.d0-eps)*xt+eps*xctr(nnel)
 2663:             //    yt=(1.d0-eps)*yt+eps*yctr(nnel)
 2664:             // } else { //lat/lon
 2665:             //    xt=(1.d0-eps)*xt+eps*xctr2
 2666:             //    yt=(1.d0-eps)*yt+eps*yctr2
 2667:             // } // ics
 2668: 
 2669:          
 2670:             // call btrack(l,ipsgb,ifl_bnd,j,iadvf,swild_tmp,swild10_tmp, dtbk,time_rm,time_rm2,uuint,vvint,wwint,nnel,jlev,xt,yt,zt,swild3,ltmp)
 2671: 
 2672:                
 2673:          } // if vmag (do backtrack)
 2674: 
 2675:       } // for j=jmin,nvrt-1
 2676: 
 2677:    }
 2678: } // extern "C"
 2679: 
 2680: template<int nc>
 2681: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 2682: 
 2683: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 2684: //
 2685: // a,b,c,r: input vectors and are not modified by this program.
 2686: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 2687: // r is the r.h.s.
 2688: // n: actual rank of the system.
 2689: // rows in u() and r();
 2690: // u: output with nc columns (transposed to rows)
 2691: // gam: a working array.
 2692: //
 2693: // NOTES:
 2694: // This is a template function that allows for different numbers of columns in the rhs vector.
 2695: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 2696: 
 2697:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 2698:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 2699: 
 2700:    double bet = b[0];
 2701:    if constexpr (nc == 1) {
 2702:       u[0] = rhs[0]/bet;
 2703:    } else {
 2704:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 2705:    }
 2706: 
 2707:    for (int j = 1; j < n; j++) {
 2708:       gam[j] = c[j-1]/bet;
 2709:       bet = b[j] - a[j]*gam[j];
 2710: 
 2711:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 2712: 
 2713:       if constexpr (nc == 1) {
 2714:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 2715:       } else {
 2716:          for (int k = 0; k < nc; k++) {
 2717:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 2718:          }
 2719:       }
 2720:    }
 2721: 
 2722:    // Back-substitution
 2723:    for (int j=n-1; j>=1; j--) {
 2724:       if constexpr (nc == 1) {
 2725:          u[j] = u[j] - gam[j+1]*u[j-1];
 2726:       } else {
 2727:          for (int k = 0; k < nc; k++) {
 2728:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 2729:          }
 2730:       }
 2731:    }
 2732: }
 2733: 
 2734: 
 2735: 
 2736: 
 2737: // Helper function that contains the core algorithm
 2738: template<typename XAccessor, typename YAccessor>
 2739: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 2740:                                     double  yp_top, double  yp_bot, 
 2741:                                     CubicSpline &spline) {
 2742:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 2743:    // 
 2744:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 2745:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 2746:    //
 2747:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 2748:    // 
 2749:    // Inputs: 
 2750:    //            n: dimension for x etc; # of data pts (>=2);
 2751:    //            getX, getY: functions to access x,y coordinates
 2752:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 2753:    //     Output: 
 2754:    //            spline (CubicSpline): spline structure with x,y,y',y''
 2755: 
 2756:    const int n = k2 - k1 + 1;
 2757:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 2758: 
 2759:    // Allocate memory for the splines
 2760:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 2761:    spline.x   = new double[n];
 2762:    spline.y   = new double[n];
 2763:    spline.yp  = new double[n];
 2764:    spline.ypp = new double[n];
 2765: 
 2766:    for (int k=k1; k<=k2; k++) {
 2767:       spline.x[k] = getX(k);
 2768:       spline.y[k] = getY(k);
 2769:    }
 2770: 
 2771:    // This is to simplify expressions later
 2772:    double *x = spline.x;
 2773:    double *y = spline.y;
 2774: 
 2775:    double *a = nullptr;
 2776:    double *b = nullptr;
 2777:    double *c = nullptr;
 2778:    double *gam = nullptr;
 2779:    double *rhs = nullptr;
 2780:    
 2781: 
 2782:       a = new double[n];   // Lower diagonal
 2783:       b = new double[n];   // Diagonal
 2784:       c = new double[n];   // Upper diagonal
 2785:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 2786:       rhs = new double[n]; // Right-hand side
 2787: 
 2788:    for (int k=k1; k<=k2; k++) {
 2789:       if (k == k1) {
 2790:          // Bottom level
 2791:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 2792:          b[k] = (x[k+1] - x[k])/3.0;
 2793:          c[k] = b[k]/2.0;
 2794:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 2795:       } else if (k == n - 1) {
 2796:          // Top level (surface)
 2797:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 2798:          b[k] = (x[k] - x[k-1])/3.0;
 2799:          a[k] = b[k]/2.0;
 2800:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 2801:       } else {
 2802:          // Intermediate levels
 2803:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 2804:          b[k] = (x[k+1] - x[k-1])/3.0;
 2805:          a[k] = (x[k  ] - x[k-1])/6.0;
 2806:          c[k] = (x[k+1] - x[k  ])/6.0;
 2807:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 2808:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 2809:       }
 2810:    }
 2811: 
 2812:    // Solve the tridiagonal system
 2813:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 2814:    
 2815:    spline.yp[k1] = yp_bot;
 2816:    spline.yp[k2] = yp_top;
 2817: 
 2818:    // Compute rest of 1st derivatives using the splines
 2819:    for (int k=k1+1; k<k2; k++) {
 2820:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 2821:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 2822:    }
 2823:    
 2824:    delete[] a;
 2825:    delete[] b;
 2826:    delete[] c;
 2827:    delete[] gam;
 2828:    delete[] rhs;
 2829: 
 2830: }
 2831: 
 2832: // Array version
 2833: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 2834:                                 double y_top, double y_bot, 
 2835:                                 CubicSpline &spline) {
 2836:    auto getX = [x] (int k) { return x[k]; };
 2837:    auto getY = [y] (int k) { return y[k]; };
 2838:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 2839: }
 2840: 
 2841: // Lambda version - allows custom access patterns
 2842: template<typename XFunc, typename YFunc>
 2843: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 2844:                                 double y_top, double y_bot,
 2845:                                 CubicSpline &spline) {
 2846:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 2847: }
 2848: 
 2849: 
 2850: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 2851: {
 2852:    assert("Not implemented");
 2853: 
 2854:    return 0.0;
 2855: }
