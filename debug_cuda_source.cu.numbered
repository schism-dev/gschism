 2087: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2088:                 double *node_coords, double *wind_rotate_angle, 
 2089:                 int *isdel, int *isidenode, int *isbnd,
 2090:                 int *nond, int *nlnd, int *iond, int *ilnd,
 2091:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2092:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2093:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2094:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2095:                 int *localNodePart,     int *localElemPart,     int *localSidePart) {
 2096: 
 2097:    printf("Populating mesh for partition %d, %d, %d\n", partNum, nond, nlnd);
 2098:    printf("DDDD\n");printf("DDDD\n");printf("DDDD\n");printf("DDDD\n");printf("DDDD\n");printf("DDDD\n");printf("DDDD\n");
 2099: 
 2100:    printf("XXX elemsPtr = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2101: 
 2102:    // Horizontal grid
 2103:    printf("Processing %d nodes\n", np);    
 2104: 
 2105: 
 2106:    int idxNodeBoundary = 0;  
 2107:    for (int i = 0; i < np; i++)
 2108:    {
 2109:       Node &node = localNodeData[i];
 2110: 
 2111:       node.idx = i;
 2112: 
 2113:       const int idxNodeStart = nodeNeighNodesStart[i];
 2114:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2115:       node.numNodes = idxNodeEnd - idxNodeStart;
 2116:       node.nodes = (Node **)(nodeNeighNodes + idxNodeStart);
 2117:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2118: 
 2119:       const int idxElemStart = nodeNeighElemsStart[i];
 2120:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2121:       node.numElements = idxElemEnd - idxElemStart;
 2122:       node.elements = (Element **)(nodeNeighElems + idxElemStart);
 2123: 
 2124:       
 2125:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2126:          const int idxNode = nodeNeighNodesIndices[idx];
 2127:          const int partNode = localNodePart[idxNode]; 
 2128: 
 2129:          Node *node_ptr = nodes[partNode] + localNodeIndices[idxNode];
 2130:          // printf("idx = %d, idxNode = %d, nodes = %p, localNodePart[idxNode] = %d, localNodeIndices[idxNode] = %d\n", idx, idxNode, nodes, localNodePart[idxNode], localNodeIndices[idxNode]);
 2131:          // printf("nodeNeighNodes[idxNode] = %d, (nodes[%d][%d]) = %p\n", nodeNeighNodes[idxNode], localNodePart[idxNode], localNodeIndices[idxNode], nodes + idxNode);
 2132: 
 2133:          nodeNeighNodes[idxNode] = node_ptr;
 2134:       }
 2135: 
 2136:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2137:          const int idxElem = nodeNeighElemsIndices[idx];
 2138:          const int partElem = localElemPart[idxElem];
 2139: 
 2140:          Element *elem_ptr = elems[partElem] + localElemIndices[idxElem];
 2141:          // printf("idx = %d, idxNode = %d, nodes = %p, localNodePart[idxNode] = %d, localNodeIndices[idxNode] = %d\n", idx, idxNode, nodes, localNodePart[idxNode], localNodeIndices[idxNode]);
 2142:          // printf("nodeNeighNodes[idxNode] = %d, (nodes[%d][%d]) = %p\n", nodeNeighNodes[idxNode], localNodePart[idxNode], localNodeIndices[idxNode], nodes + idxNode);
 2143:          // printf("i = %d, idx = %d, idxElem = %d, elems = %p, localElemPart[idxElem] = %d, localElemIndices[idxElem] = %d\n", i, idx, idxElem, elem_ptr, localElemPart[idxElem], localElemIndices[idxElem]);
 2144:          
 2145:          // printf("i = %d, idx = %d, ii = %d, idxElem = %d, nodes =  %d, %d, %d\n", 
 2146:          //       i, idx, localElemIndices[idxElem], idxElem, elem_ptr->nodes[0]->idx, elem_ptr->nodes[1]->idx, elem_ptr->nodes[2]->idx);
 2147:          printf("i = %d, idx = %d, ii = %d, idxElem = %d, elem_ptr = %p, nodes = %p, %p, %p\n", 
 2148:                i, idx, localElemIndices[idxElem], idxElem, elem_ptr, elem_ptr->nodes[0], elem_ptr->nodes[1], elem_ptr->nodes[2]);
 2149: 
 2150:          nodeNeighElems[idxElem] = elem_ptr;
 2151:       }      
 2152: 
 2153: 
 2154:       node.wind_angle = wind_rotate_angle[i];
 2155: 
 2156:       // Element **elements; // pointer to the elements connected to this node
 2157:       // int numElements;   // number of elements shared by this node
 2158: 
 2159:       node.p.x   = node_coords[i * 3];
 2160:       node.p.y   = node_coords[i * 3 + 1];
 2161:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2162:       node.depth = node_coords[i * 3 + 2];
 2163: 
 2164:       // printf("ZZ elemsPtr = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2165: 
 2166:       // Links the node to the boundary information
 2167:       if (isbnd[i] >= 0) {
 2168:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2169:          if (isbnd[i]>0) {
 2170: 
 2171:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2172:             node.nodeBnd->segment->ifltype = isbnd[i];
 2173: 
 2174:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2175:             node.nodeBnd->segment->clen  = nan("1");
 2176:             node.nodeBnd->segment->carea = nan("1");
 2177: 
 2178:          }
 2179:          else {
 2180:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2181:          }
 2182:          
 2183:          idxNodeBoundary++;
 2184:       }
 2185:       else {
 2186:          node.nodeBnd = nullptr;
 2187:       }
 2188: 
 2189: // XXXX
 2190: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2191: constexpr double rot_per = 3000.0;
 2192: constexpr double rot_f = 2.0*pi/rot_per;
 2193: for (int k = 0; k < nvrt; k++) {node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0};}
 2194: // XXXXX
 2195:    }
 2196: 
 2197:    nbp = idxNodeBoundary;
 2198: 
 2199:    printf("YY elemsPtr = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2200:    printf("Processing %d sides\n", ns);
 2201:    int idxSideBoundary = 0;
 2202:    for (int i = 0; i < ns; i++)
 2203:    {
 2204:       Side &side = localSideData[i];
 2205:       side.idx = i;
 2206:       // finding the pointer to the nodes that form the side
 2207:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2208:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2209: 
 2210:       const int locidx_n1 = localNodeIndices[idx_n1];
 2211:       const int locidx_n2 = localNodeIndices[idx_n2];
 2212:       const int part_n1 =   localNodePart[idx_n1];
 2213:       const int part_n2 =   localNodePart[idx_n2];
 2214: 
 2215:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2216:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2217: 
 2218:       // Normal vector to the side
 2219:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2220:       const double norm = sqrt(dot(side.n, side.n));
 2221:       side.n = side.n/norm;
 2222: 
 2223:       // Side boundary type
 2224:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 2225:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 2226:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2227:       
 2228:       if (n1bnd != nullptr || n2bnd != nullptr) 
 2229:       {
 2230:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2231:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2232:          else                  side.sideBnd->segment = n2bnd->segment;
 2233:          side.sideBnd->side = &side;
 2234:          idxSideBoundary++;
 2235:       }
 2236:       else side.sideBnd = nullptr;
 2237: 
 2238:       // finding the pointer to the elements that share the side
 2239:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2240:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2241: 
 2242:       if (idx_e1 > -1) {
 2243:          const int locidx_e1 = localElemIndices[idx_e1];
 2244:          const int part_e1 =  localElemPart[idx_e1];
 2245:          side.elems[0] = elems[part_e1] + locidx_e1;
 2246:          // printf("s@@ part_e1 = %d, locidx_e1 = %d, elems[part_e1] = %p\n", part_e1, locidx_e1, elems[part_e1]);
 2247:          // // printf("s-- side.elems[0] = %p idx = %d i34 = %d (x,y,z) = (%f,%f,%f) size = %d\n", side.elems[0], side.elems[0]->idx, side.elems[0]->i34, side.elems[0]->center.x, side.elems[0]->center.y, side.elems[0]->center.z, sizeof(Element));
 2248:          // printf("o-- elems = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2249:       }
 2250:       else {
 2251:          side.elems[0] = nullptr;
 2252:       }
 2253: 
 2254:       if (idx_e2 > -1) {
 2255:          const int locidx_e2 = localElemIndices[idx_e2];
 2256:          const int part_e2 =  localElemPart[idx_e2];
 2257:          side.elems[1] = elems[part_e2] + locidx_e2;
 2258:       }
 2259:       else {
 2260:          side.elems[1] = nullptr;
 2261:       }
 2262: 
 2263: 
 2264: 
 2265:       // Compute the center of the side
 2266:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2267: 
 2268: // XXXX
 2269: constexpr double rot_per=3000.0;
 2270: constexpr double rot_f=2.0*pi/rot_per;
 2271: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2272: // XXXXX      
 2273: 
 2274:       // Compute the z level at the center of the side
 2275:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->znl[k] + side.n2->znl[k]);
 2276: 
 2277:       // Compute the length of the side
 2278:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2279:       side.length = sqrt(dot(vLen, vLen));
 2280: 
 2281:    }
 2282: 
 2283:    printf("Processing %d elements\n", ne);
 2284:    for (int i = 0; i < ne; i++)
 2285:    {
 2286:       Element &elem = localElemData[i];
 2287:       elem.idx = i;
 2288:       for (int j = 0; j < i34[i]; j++) {
 2289:          const int idxNode = elnode[i*4 + j];  
 2290:          const int idxSide = elside[i*4 + j];
 2291:          
 2292:          elem.nodes[j] = (Node *)&(nodes[localElemPart[idxNode]][localElemIndices[idxNode]]);
 2293:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2294: 
 2295:          // Find the neighboring element  
 2296:          if (elem.sides[j]->elems[0] == &elem) {
 2297:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2298:          }
 2299:          else {
 2300:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2301:          }
 2302:       }
 2303: 
 2304:       
 2305: 
 2306:       elem.i34 = i34[i];
 2307: 
 2308: // printf("elem = %p, elem.i34 = %d\n", &elem, elem.i34);
 2309: 
 2310:       // Compute the centroid of the element and its depth
 2311:       Vector2 center = {0.0, 0.0};
 2312:       elem.depth = 0.0;
 2313:       for (int j = 0; j < i34[i]; j++) {
 2314:          center += elem.nodes[j]->p2()/i34[i];
 2315:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2316:       }
 2317:       elem.center.x = center.x;
 2318:       elem.center.y = center.y;
 2319: 
 2320:       // printf("elem = %p, i34 = %d, center = (%f,%f,%f)\n", &elem, elem.i34, elem.center.x, elem.center.y, elem.depth);
 2321:       
 2322:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2323:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2324: 
 2325:       elem.area = elem.computeSignedArea(); 
 2326:       elem.radius = sqrt(elem.area)/pi; 
 2327:       
 2328:       // Determines which way the normal vector to each side is oriented.
 2329:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2330:       for (int j = 0; j < i34[i]; j++)  
 2331:       {
 2332:          if (elem.sides[j]->elems[0] == &elem) {
 2333:             elem.ssign[j] =  1.0;
 2334:          }
 2335:          else {
 2336:             elem.ssign[j] = -1.0;
 2337:          }
 2338: 
 2339:       }
 2340: 
 2341:       // Derivatives of shape functions
 2342:       //  For ics=2, this is done inside element/ll frame XXX
 2343:       //  For quads, the derivative is evaluated at centroid
 2344:       const int i34 = elem.i34;
 2345:       for (int j = 0; j < i34; j++) {
 2346:          const double area = elem.area;
 2347:          const int id2 = elem.nxq(1 + j);
 2348:          const int id3 = elem.nxq(2 + j);
 2349:          const int id4 = elem.nxq(3 + j);
 2350:          if (elem.isTri()) {
 2351:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2352:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2353:             // da1/dx = (y1 - y2)/(2*area)
 2354:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2355:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2356:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2357:          }
 2358:          else  { // Quad; evaluate at centroid
 2359:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2360:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2361:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2362:          } // if Tri
 2363: 
 2364:       } // for j
 2365: 
 2366:    }
 2367: 
 2368: 
 2369: 
 2370:    
 2371: }
 2372: 
 2373: 
 2374: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 2375:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 2376:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 2377:    // 
 2378:    // This kernel is called for all nodes.
 2379: 
 2380: 
 2381:    NODE(node1);
 2382: 
 2383: 
 2384: 
 2385:    node1->clearMatrixRow();
 2386:    node1->qel = 0.0;
 2387: 
 2388:    // THIS IS FOR STRUCTURES XXX
 2389:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 2390: 
 2391:    
 2392:    for (int j=0; j<node1->numElements; j++) {
 2393:       // For each element connected to the node...
 2394: 
 2395:       Element *elem = node1->elements[j];
 2396: 
 2397:       //printf("node1 = %p, elem = %p, elem idx = %d, elem i34 = %d, elem nodes = %p, %p, %p\n", node1, elem, elem->idx, elem->i34, elem->nodes[0], elem->nodes[1], elem->nodes[2]);
 2398:       printf("node1 = %d, elem = %d, elem i34 = %d, elem nodes = %d, %d, %d\n", node1->idx, elem->idx, elem->i34, elem->nodes[0]->idx, elem->nodes[1]->idx, elem->nodes[2]->idx);
 2399: 
 2400: 
 2401:       // Compute the average gravity
 2402:       const double grav3 = elem->mean(&Node::grav2);
 2403: 
 2404:       // Look at the documentation for the description of the terms in the following integrals
 2405: 
 2406:       // Integral I_1 
 2407:       // \bar{\breve{H}} 
 2408:       const double hhatb = elem->mean(&Side::hhat);        
 2409: 
 2410:       assert((hhatb >= 0.0 || ihh != 1) && "Invalid hhat");
 2411: 
 2412:       const int id1 = elem->nodeLocalIdx(node1); 
 2413:       const double area = elem->area;
 2414: 
 2415:       if (elem->isTri()) {
 2416: 
 2417:          // To clarify the notation in this section: 
 2418:          //   i standtimes for the node under consideration (node1)
 2419:          //   j (node2) and k (node3) are the other nodes of the triangle.
 2420:          const int id2 = elem->nxq(1 + id1);
 2421:          const int id3 = elem->nxq(2 + id1);
 2422:          Node *node2 = elem->nodes[id2];
 2423:          Node *node3 = elem->nodes[id3];
 2424: 
 2425:          const Point2 x1 = node1->p2();
 2426:          const Point2 x2 = node2->p2();
 2427:          const Point2 x3 = node3->p2();
 2428: 
 2429:          // integral of phi_i*phi_j
 2430:          const double ipp_ii = (1.0/6.0 )*area;
 2431:          const double ipp_ij = (1.0/12.0)*area;
 2432:          const double ipp_ik = (1.0/12.0)*area;
 2433: 
 2434:          // integral of [(grad phi_i) * (grad phi_j)]
 2435:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 2436:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 2437:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 2438: 
 2439:          // Computes the different components of integral I_1 of each node with respect to node i.
 2440:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 2441:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 2442:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 2443: 
 2444:          node1->addToSparseMatrix(node1, I1_ii);
 2445:          node1->addToSparseMatrix(node2, I1_ij); 
 2446:          node1->addToSparseMatrix(node3, I1_ik);
 2447:      
 2448:       }
 2449:       else { // Quad
 2450:          // XXX IMPLEMENT THIS
 2451:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2452:       } 
 2453: 
 2454:  
 2455:       // Integral I_4
 2456:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 2457:       // Where
 2458:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 2459: 
 2460:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 2461:       // of U over the element.
 2462:       Vector2 Umean = {0.0, 0.0};
 2463:       for (int m=0; m<elem->i34; m++) {      
 2464:          const Side *side = elem->sides[m];
 2465: 
 2466:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 2467:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 2468:       }
 2469:       Umean = Umean/elem->i34;
 2470: 
 2471:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 2472: 
 2473:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 2474:       const double I_4_1 = dot(gradPhi_1, Umean);
 2475: 
 2476:       // Integral of \nabla\phi_i \cdot \pmb{E}
 2477:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 2478:      
 2479:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);
 2480:       
 2481: 
 2482:       // Additional terms 
 2483:       double vnorm = 0.0;
 2484:       if (imm == 2)  { // Pre-compute vnorm on the element
 2485:          Vector3 ubed;
 2486:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 2487: 
 2488:          Vector3 gradP(0.0, 0.0, 1.0);
 2489:          for (int m=0; m < elem->i34; m++) {
 2490:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 2491:            gradP += toVector3(gradP_2D, 0.0);
 2492:          }   
 2493:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 2494:       } // imm==2
 2495: 
 2496:       if (elem->isTri()) {
 2497:          for (int l=0; l<3; l++) {
 2498:            double fac;
 2499: 
 2500:            Node *node = elem->nodes[l];
 2501: 
 2502:            (node == node1)? fac=2.0 : fac=1.0;
 2503: 
 2504:            if (imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 2505:            else        node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 2506:            
 2507:          }
 2508: 
 2509:          if (!elem->isDry) {
 2510:            const Vector2 gradEta = elem->nodes[0]->eta2*elem->gradPhi[0] +
 2511:                                    elem->nodes[1]->eta2*elem->gradPhi[1] +
 2512:                                    elem->nodes[2]->eta2*elem->gradPhi[2];
 2513: 
 2514:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 2515:          }
 2516: 
 2517:       } // isTri
 2518:       else { // isQuad
 2519:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2520:          // for (int l=0; l<4; l++) {
 2521:          //   const Node *node = elem->nodes[l];
 2522: 
 2523:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 2524:          //   else        tmp2 = node->bdef2 - node->bdef1;
 2525: 
 2526:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 2527:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 2528:          // }
 2529: 
 2530:       } // isQuad
 2531: 
 2532: 
 2533:       // printf("node1 = %p\n", node1);
 2534:       node1->qel += (dt/elem->i34)*elem->vsource;
 2535:       
 2536: 
 2537:    } // for all elements connected to the node
 2538:    
 2539: 
 2540: 
 2541:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 2542:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 2543:    NodeBoundary *nodeBnd = node1->nodeBnd;
 2544:    if (nodeBnd != nullptr)  { 
 2545:       // If it is an open boundary node...
 2546: 
 2547:       // At least one open bnd side, maybe two
 2548:       for (int l=0; l<2; l++) { 
 2549: 
 2550:          // Gets each of the sides sharing the node. 
 2551:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 2552: 
 2553:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 2554: 
 2555:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 2556: 
 2557: 
 2558:          if (sideBnd != nullptr) {
 2559:             // If the side is on a boundary...
 2560: 
 2561:             // Get the boundary segment
 2562:             const BoundarySegment *sideSegment = sideBnd->segment;
 2563:             const Side *side = sideBnd->side;
 2564: 
 2565:             // Integral I_3
 2566:             if (sideSegment->ifltype != 0) {
 2567:             // Natural or Flather b.c.
 2568: 
 2569:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 2570:                // especially for Flather b.c.
 2571:                double ri3 = 0.0;
 2572:                if (!side->isDry) {
 2573:                   // If the side is not dry
 2574:                   
 2575:                   // Computes the side flux of (uth, vth)
 2576:                   double Vn = 0.0;
 2577:                   for (int k = side->kb; k<nvrt-1; k++) {
 2578:                      // uth, vth in lat/lon frame if ics=2
 2579:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 2580:                      const double vn1 = dot(side->uth[k  ], side->n); // outer normal
 2581:                      const double vn2 = dot(side->uth[k+1], side->n);
 2582: 
 2583:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 2584:                   }
 2585: 
 2586:                   ri3 = 0.5*side->length*Vn;
 2587:                }
 2588: 
 2589:                if (sideSegment->ifltype == -1) { // Flather 1
 2590: 
 2591:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 2592:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 2593: 
 2594:                   const double con0 = (1.0/6.0)*side->length*sqrt(grav*side->depth()); // For coefficient matrix
 2595:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 2596:                   
 2597:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 2598:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 2599: 
 2600:                } 
 2601:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 2602:                   // Reset ri3
 2603:                   ri3 = 0.0;
 2604: 
 2605:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 2606: 
 2607:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 2608: 
 2609:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 2610:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 2611: 
 2612:                   const double con0 = (1.0/6.0)*side->length*tmp*thetai*dt;
 2613:                   node1->addToSparseMatrix(node1, con0*2.0);
 2614:                   node1->addToSparseMatrix(node2, con0);
 2615: 
 2616:                } // if Flather or Discharge
 2617: 
 2618:                node1->qel -= thetai*dt*ri3;
 2619: 
 2620:             } // I_3
 2621:           
 2622: 
 2623:             // Integral I_5
 2624:             if(!side->isDry) {
 2625: 
 2626:                const double Unbar = dot(side->U, side->n);
 2627: 
 2628:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->length*Unbar;
 2629:                
 2630:             } // I_5
 2631: 
 2632:          } // if is boundary side
 2633: 
 2634:       } // for l
 2635: 
 2636:    } // if isbnd
 2637: 
 2638: }
 2639: 
 2640: 
 2641: extern "C" {
 2642:    __global__ void backtrackAllNodes(void) {
 2643: 
 2644:       // max/min # of sub-divisions
 2645:       const int ndelt_max = max(1.0, dt/dtb_min);
 2646:       const int ndelt_min = max(1.0, dt/dtb_max); 
 2647: 
 2648:       // Removed all references to swild98 XXX
 2649:       // swild98=0.d0 !init
 2650: 
 2651:       SIDE(side);
 2652: 
 2653:       // printf("backtrackAllNodes: side = %p idx = %d isDry = %d center = (%f,%f)\n", side, side->idx, side->isDry, side->center.x, side->center.y);
 2654: 
 2655:       const int kb = side->kb;
 2656: 
 2657:       // Initialize btrack velocities to the actual velocities at the side 
 2658:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 2659: 
 2660:       if (side->isDry) return;
 2661: 
 2662:       // Checks that at least one element is not dry
 2663:       const Element *elem1 = side->elems[0];
 2664:       const Element *elem2 = side->elems[1];
 2665: 
 2666:       // printf("backtrackAllNodes: side->isDry = %d, idx = %d, elem1 = %p, elem2 = %p\n", side->isDry, side->idx, elem1, elem2);
 2667:       // printf("elem1->isDry = %d, elem2->isDry = %d\n", elem1!=nullptr?elem1->isDry:-10, elem2!=nullptr?elem2->isDry:-10);
 2668:       // if (elem1!=nullptr && (elem1->isDry<0 || elem1->isDry>1)) printf("XXXX elem1 = %p idx = %d isDry = %d\n", elem1, elem1->idx, elem1->isDry);
 2669:       // if (elem2!=nullptr && (elem2->isDry<0 || elem2->isDry>1)) printf("XXXX elem2 = %p idx = %d isDry = %d\n", elem2, elem2->idx, elem2->isDry);
 2670:       // if (elem1!=nullptr && (elem1->isDry==0 || elem1->isDry==1)) printf("elem1 = %p idx = %d isDry = %d\n", elem1, elem1->idx, elem1->isDry);
 2671:       // if (elem2!=nullptr && (elem2->isDry==0 || elem2->isDry==1)) printf("elem2 = %p idx = %d isDry = %d\n", elem2, elem2->idx, elem2->isDry);
 2672:       // if (elem1!=nullptr) printf("elem1 = %p idx = %d i34 = %d (x,y,z) = (%f,%f,%f)\n", elem1, elem1->idx, elem1->i34, elem1->center.x, elem1->center.y, elem1->center.z);
 2673:       // if (elem2!=nullptr) printf("elem2 = %p idx = %d i34 = %d (x,y,z) = (%f,%f,%f)\n", elem2, elem2->idx, elem2->i34, elem2->center.x, elem2->center.y, elem2->center.z);
 2674:       // printf("elem1 = %p, elem2 = %p\n", elem1, elem2);
 2675: 
 2676:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 2677: 
 2678:       // XXXXXX
 2679:       // !swild_tmp to store global coord. of the starting side
 2680:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 2681:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 2682:       // !Use sframe2 
 2683:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 2684: 
 2685: 
 2686:       for (int k = kb; k < nvrt; k++) {
 2687:       //  Initialize (xt,yt,zt), nnel and vel.
 2688:       //  For ics=2, the coordinates are in local frames
 2689:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 2690: 
 2691: 
 2692:          const int iadvf = side->iadv();  // Advection flag
 2693: 
 2694:          Point3 xt;
 2695:          if constexpr(ics==1) {
 2696:             xt = side->center3D(k); 
 2697:          }
 2698:          else // lat/lon; in side lat/lon frame
 2699:          {
 2700:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 2701:          // XXX IMPLEMENT THIS
 2702:       //          xt=0.d0
 2703:       //          yt=0.d0
 2704:       //          !centroid coord. for nudging
 2705:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 2706:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 2707:          }  // ics
 2708: 
 2709: 
 2710:          // Velocity at the side (in ll frame for ics, same vertical direction)
 2711:          // XXX IS THIS NECESSARY?
 2712:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 2713: 
 2714:          // If on land or open boundary...
 2715:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 2716:          
 2717:          const double vmag = length(toVector2(u_int));
 2718: 
 2719:          if (vmag <= velmin_btrack) {
 2720:             // No activity 
 2721: 
 2722:             side->btu[k] = side->u2[k];
 2723:             
 2724:          } else {  // do btrack
 2725: 
 2726:             
 2727:             // Compute number of sub-divisions based on local gradients 
 2728:             // XXX IS THIS NECESSARY?
 2729:             double suma = 0.0;
 2730:             int icount = 0;
 2731:             for (int ii=0; ii<2; ii++) {
 2732: 
 2733:                const Element *elem = side->elems[ii];
 2734:                  
 2735:                if (elem == nullptr) continue;
 2736: 
 2737:                icount++;
 2738: 
 2739:                // Not strictly along z; in ll frame for ics=2
 2740: 
 2741:                double utmp[4];
 2742:                double vtmp[4];
 2743:                for (int jj = 0; jj < elem->i34; jj++) {
 2744: 
 2745:                   const Node *node = elem->nodes[jj];
 2746: 
 2747:                   if constexpr(ics==1) {
 2748:                      utmp[jj] = node->u2[k].x;
 2749:                      vtmp[jj] = node->u2[k].y;  
 2750:                   } else {
 2751:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 2752:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 2753:                   }
 2754:                } // for jj
 2755: 
 2756:                const Vector2 grad_u = elem->grad(utmp); 
 2757:                const Vector2 grad_v = elem->grad(vtmp);
 2758: 
 2759:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 2760:             } // for ii
 2761: 
 2762:             assert(icount > 0 && "Impossible 77");
 2763: 
 2764:             // '4' is somewhat arbitrary
 2765:             const int ndelt = max(ndelt_min, min(ndelt_max, int(suma/icount)*4)); // >=1
 2766:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 2767: 
 2768:             // printf("ndelt = %d, dt = %f, dtbk = %f\n", ndelt, dt, dtbk);
 2769: 
 2770: 
 2771: 
 2772:             // Perturb starting pt to avoid underflow 
 2773:             // XXX I don't think this is needed with the current implementation
 2774:             // eps=btrack_nudge
 2775:             // if constexpr(ics==1) {
 2776:             //    xt=(1.d0-eps)*xt+eps*xctr(nnel)
 2777:             //    yt=(1.d0-eps)*yt+eps*yctr(nnel)
 2778:             // } else { //lat/lon
 2779:             //    xt=(1.d0-eps)*xt+eps*xctr2
 2780:             //    yt=(1.d0-eps)*yt+eps*yctr2
 2781:             // } // ics
 2782: 
 2783:          
 2784:             // call btrack(l,ipsgb,ifl_bnd,j,iadvf,swild_tmp,swild10_tmp, dtbk,time_rm,time_rm2,uuint,vvint,wwint,nnel,jlev,xt,yt,zt,swild3,ltmp)
 2785:             Vector3 u_int = {0.0, 0.0, 0.0};
 2786:             side->btrack(k, dt, dtbk, u_int);
 2787: 
 2788:                
 2789:          } // if vmag (do backtrack)
 2790: 
 2791:       } // for j=jmin,nvrt-1
 2792: 
 2793:    }
 2794: } // extern "C"
 2795: 
 2796: template<int nc>
 2797: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 2798: 
 2799: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 2800: //
 2801: // a,b,c,r: input vectors and are not modified by this program.
 2802: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 2803: // r is the r.h.s.
 2804: // n: actual rank of the system.
 2805: // rows in u() and r();
 2806: // u: output with nc columns (transposed to rows)
 2807: // gam: a working array.
 2808: //
 2809: // NOTES:
 2810: // This is a template function that allows for different numbers of columns in the rhs vector.
 2811: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 2812: 
 2813:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 2814:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 2815: 
 2816:    double bet = b[0];
 2817:    if constexpr (nc == 1) {
 2818:       u[0] = rhs[0]/bet;
 2819:    } else {
 2820:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 2821:    }
 2822: 
 2823:    for (int j = 1; j < n; j++) {
 2824:       gam[j] = c[j-1]/bet;
 2825:       bet = b[j] - a[j]*gam[j];
 2826: 
 2827:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 2828: 
 2829:       if constexpr (nc == 1) {
 2830:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 2831:       } else {
 2832:          for (int k = 0; k < nc; k++) {
 2833:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 2834:          }
 2835:       }
 2836:    }
 2837: 
 2838:    // Back-substitution
 2839:    for (int j=n-1; j>=1; j--) {
 2840:       if constexpr (nc == 1) {
 2841:          u[j] = u[j] - gam[j+1]*u[j-1];
 2842:       } else {
 2843:          for (int k = 0; k < nc; k++) {
 2844:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 2845:          }
 2846:       }
 2847:    }
 2848: }
 2849: 
 2850: 
 2851: 
 2852: 
 2853: // Helper function that contains the core algorithm
 2854: template<typename XAccessor, typename YAccessor>
 2855: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 2856:                                     double  yp_top, double  yp_bot, 
 2857:                                     CubicSpline &spline) {
 2858:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 2859:    // 
 2860:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 2861:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 2862:    //
 2863:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 2864:    // 
 2865:    // Inputs: 
 2866:    //            n: dimension for x etc; # of data pts (>=2);
 2867:    //            getX, getY: functions to access x,y coordinates
 2868:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 2869:    //     Output: 
 2870:    //            spline (CubicSpline): spline structure with x,y,y',y''
 2871: 
 2872:    const int n = k2 - k1 + 1;
 2873:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 2874: 
 2875:    // Allocate memory for the splines
 2876:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 2877:    spline.x   = new double[n];
 2878:    spline.y   = new double[n];
 2879:    spline.yp  = new double[n];
 2880:    spline.ypp = new double[n];
 2881: 
 2882:    for (int k=k1; k<=k2; k++) {
 2883:       spline.x[k] = getX(k);
 2884:       spline.y[k] = getY(k);
 2885:    }
 2886: 
 2887:    // This is to simplify expressions later
 2888:    double *x = spline.x;
 2889:    double *y = spline.y;
 2890: 
 2891:    double *a = nullptr;
 2892:    double *b = nullptr;
 2893:    double *c = nullptr;
 2894:    double *gam = nullptr;
 2895:    double *rhs = nullptr;
 2896:    
 2897: 
 2898:       a = new double[n];   // Lower diagonal
 2899:       b = new double[n];   // Diagonal
 2900:       c = new double[n];   // Upper diagonal
 2901:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 2902:       rhs = new double[n]; // Right-hand side
 2903: 
 2904:    for (int k=k1; k<=k2; k++) {
 2905:       if (k == k1) {
 2906:          // Bottom level
 2907:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 2908:          b[k] = (x[k+1] - x[k])/3.0;
 2909:          c[k] = b[k]/2.0;
 2910:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 2911:       } else if (k == n - 1) {
 2912:          // Top level (surface)
 2913:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 2914:          b[k] = (x[k] - x[k-1])/3.0;
 2915:          a[k] = b[k]/2.0;
 2916:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 2917:       } else {
 2918:          // Intermediate levels
 2919:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 2920:          b[k] = (x[k+1] - x[k-1])/3.0;
 2921:          a[k] = (x[k  ] - x[k-1])/6.0;
 2922:          c[k] = (x[k+1] - x[k  ])/6.0;
 2923:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 2924:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 2925:       }
 2926:    }
 2927: 
 2928:    // Solve the tridiagonal system
 2929:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 2930:    
 2931:    spline.yp[k1] = yp_bot;
 2932:    spline.yp[k2] = yp_top;
 2933: 
 2934:    // Compute rest of 1st derivatives using the splines
 2935:    for (int k=k1+1; k<k2; k++) {
 2936:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 2937:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 2938:    }
 2939:    
 2940:    delete[] a;
 2941:    delete[] b;
 2942:    delete[] c;
 2943:    delete[] gam;
 2944:    delete[] rhs;
 2945: 
 2946: }
 2947: 
 2948: // Array version
 2949: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 2950:                                 double y_top, double y_bot, 
 2951:                                 CubicSpline &spline) {
 2952:    auto getX = [x] (int k) { return x[k]; };
 2953:    auto getY = [y] (int k) { return y[k]; };
 2954:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 2955: }
 2956: 
 2957: // Lambda version - allows custom access patterns
 2958: template<typename XFunc, typename YFunc>
 2959: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 2960:                                 double y_top, double y_bot,
 2961:                                 CubicSpline &spline) {
 2962:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 2963: }
 2964: 
 2965: 
 2966: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 2967: {
 2968:    assert("Not implemented");
 2969: 
 2970:    return 0.0;
 2971: }
