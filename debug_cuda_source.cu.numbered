 2263: 
 2264: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2265:                 double *node_coords, double *wind_rotate_angle, 
 2266:                 int *isdel, int *isidenode, int *isbnd,
 2267:                 int *nond, int *nlnd, int *iond, int *ilnd,
 2268:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2269:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2270:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2271:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2272:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 2273:                 double *emo, double *efa, 
 2274:                 double *umo, double *ufa, 
 2275:                 double *vmo, double *vfa) {
 2276: 
 2277:    printf("Populating mesh for partition %d\n", partNum);
 2278: 
 2279:    // Horizontal grid
 2280:    printf("Processing %d nodes\n", np);    
 2281: 
 2282: 
 2283:    int idxNodeBoundary = 0;  
 2284:    for (int i = 0; i < np; i++)
 2285:    {
 2286:       Node &node = localNodeData[i];
 2287: 
 2288:       node.idx = i;
 2289: 
 2290:       const int idxNodeStart = nodeNeighNodesStart[i];
 2291:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2292:       node.numNodes = idxNodeEnd - idxNodeStart;
 2293:       node.nodes = nodeNeighNodes + idxNodeStart;
 2294:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2295: 
 2296: 
 2297: 
 2298:       const int idxElemStart = nodeNeighElemsStart[i];
 2299:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2300:       node.numElements = idxElemEnd - idxElemStart;
 2301:       node.elements = nodeNeighElems + idxElemStart;
 2302: 
 2303: 
 2304:       
 2305:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2306:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2307:          const int partNode = localNodePart[idxNodeGlobal]; 
 2308:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2309: 
 2310: 
 2311:          Node *node_ptr = nodes[partNode] + idxNode;
 2312:          
 2313:          nodeNeighNodes[idx] = node_ptr;
 2314:       }
 2315: 
 2316:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2317:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2318:          const int partElem = localElemPart[idxElemGlobal];
 2319:          const int idxElem  = localElemIndices[idxElemGlobal];
 2320: 
 2321:          Element *elem_ptr = elems[partElem] + idxElem;
 2322: 
 2323:          nodeNeighElems[idx] = elem_ptr;
 2324:       }      
 2325: 
 2326: 
 2327:       node.wind_angle = wind_rotate_angle[i];
 2328: 
 2329:       // Element **elements; // pointer to the elements connected to this node
 2330:       // int numElements;   // number of elements shared by this node
 2331: 
 2332:       node.p.x   = node_coords[i * 3];
 2333:       node.p.y   = node_coords[i * 3 + 1];
 2334:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2335:       node.depth = node_coords[i * 3 + 2];
 2336: 
 2337: 
 2338: 
 2339:       // Links the node to the boundary information
 2340:       if (isbnd[i] >= 0) {
 2341:        
 2342:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2343:          node.nodeBnd->node = &node;
 2344: 
 2345:          if (isbnd[i]>0) {
 2346: 
 2347:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2348:             node.nodeBnd->segment->ifltype = isbnd[i];
 2349: 
 2350:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2351:             node.nodeBnd->segment->clen  = nan("1");
 2352:             node.nodeBnd->segment->carea = nan("1");
 2353: 
 2354:          }
 2355:          else {
 2356:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2357:          }
 2358:          
 2359:          idxNodeBoundary++;
 2360:       }
 2361:       else {
 2362:          node.nodeBnd = nullptr;
 2363:       }
 2364: 
 2365: // XXXX
 2366: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2367: constexpr double rot_per = 3000.0;
 2368: constexpr double rot_f = 0.0*2.0*pi/rot_per;
 2369: for (int k = 0; k < nvrt; k++) {node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0};}
 2370: // XXXXX
 2371:    }
 2372: 
 2373:    nbp = idxNodeBoundary;
 2374: 
 2375:    printf("Processing %d sides\n", ns);
 2376:    int idxSideBoundary = 0;
 2377:    for (int i = 0; i < ns; i++)
 2378:    {
 2379:       Side &side = localSideData[i];
 2380:       side.idx = i;
 2381:       // finding the pointer to the nodes that form the side
 2382:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2383:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2384: 
 2385:       const int locidx_n1 = localNodeIndices[idx_n1];
 2386:       const int locidx_n2 = localNodeIndices[idx_n2];
 2387:       const int part_n1 =   localNodePart[idx_n1];
 2388:       const int part_n2 =   localNodePart[idx_n2];
 2389: 
 2390:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2391:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2392: 
 2393:       // Normal vector to the side
 2394:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2395:       const double norm = sqrt(dot(side.n, side.n));
 2396:       side.n = side.n/norm;
 2397: 
 2398:       // Side boundary type
 2399:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 2400:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 2401:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2402:       
 2403:       if (n1bnd != nullptr || n2bnd != nullptr) 
 2404:       {
 2405:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2406:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2407:          else                  side.sideBnd->segment = n2bnd->segment;
 2408:          side.sideBnd->side = &side;
 2409:          idxSideBoundary++;
 2410:       }
 2411:       else side.sideBnd = nullptr;
 2412: 
 2413:       // finding the pointer to the elements that share the side
 2414:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2415:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2416: 
 2417:       if (idx_e1 > -1) {
 2418:          const int locidx_e1 = localElemIndices[idx_e1];
 2419:          const int part_e1 =  localElemPart[idx_e1];
 2420:          side.elems[0] = elems[part_e1] + locidx_e1;
 2421:          // printf("s@@ part_e1 = %d, locidx_e1 = %d, elems[part_e1] = %p\n", part_e1, locidx_e1, elems[part_e1]);
 2422:          // // printf("s-- side.elems[0] = %p idx = %d i34 = %d (x,y,z) = (%f,%f,%f) size = %d\n", side.elems[0], side.elems[0]->idx, side.elems[0]->i34, side.elems[0]->center.x, side.elems[0]->center.y, side.elems[0]->center.z, sizeof(Element));
 2423:          // printf("o-- elems = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2424:       }
 2425:       else {
 2426:          side.elems[0] = nullptr;
 2427:       }
 2428: 
 2429:       if (idx_e2 > -1) {
 2430:          const int locidx_e2 = localElemIndices[idx_e2];
 2431:          const int part_e2 =  localElemPart[idx_e2];
 2432:          side.elems[1] = elems[part_e2] + locidx_e2;
 2433:       }
 2434:       else {
 2435:          side.elems[1] = nullptr;
 2436:       }
 2437: 
 2438: 
 2439: 
 2440:       // Compute the center of the side
 2441:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2442: 
 2443: // XXXX
 2444: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2445: constexpr double rot_per=3000.0;
 2446: constexpr double rot_f=0.0*2.0*pi/rot_per;
 2447: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2448: // XXXXX      
 2449: 
 2450:       // Compute the z level at the center of the side
 2451:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->znl[k] + side.n2->znl[k]);
 2452: 
 2453:       // Compute the length of the side
 2454:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2455:       side.length = sqrt(dot(vLen, vLen));
 2456: 
 2457:    }
 2458: 
 2459:    printf("Processing %d elements\n", ne);
 2460:    for (int i = 0; i < ne; i++)
 2461:    {
 2462:       Element &elem = localElemData[i];
 2463:       elem.idx = i;
 2464:       for (int j = 0; j < i34[i]; j++) {
 2465:          const int idxNode = elnode[i*4 + j];  
 2466:          const int idxSide = elside[i*4 + j];
 2467:          
 2468:          elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 2469:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2470: 
 2471: 
 2472: 
 2473:          // Find the neighboring element  
 2474:          if (elem.sides[j]->elems[0] == &elem) {
 2475:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2476:          }
 2477:          else {
 2478:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2479:          }
 2480:          
 2481:       }
 2482: 
 2483:       elem.i34 = i34[i];
 2484: 
 2485: // printf("elem = %p, elem.i34 = %d\n", &elem, elem.i34);
 2486: 
 2487:       // Compute the centroid of the element and its depth
 2488:       Vector2 center = {0.0, 0.0};
 2489:       elem.depth = 0.0;
 2490:       for (int j = 0; j < i34[i]; j++) {
 2491:          center += elem.nodes[j]->p2()/i34[i];
 2492:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2493:       }
 2494:       elem.center.x = center.x;
 2495:       elem.center.y = center.y;
 2496: 
 2497:       // printf("elem = %p, i34 = %d, center = (%f,%f,%f)\n", &elem, elem.i34, elem.center.x, elem.center.y, elem.depth);
 2498:       
 2499:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2500:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2501: 
 2502:       elem.area = elem.computeSignedArea(); 
 2503:       elem.radius = sqrt(elem.area)/pi; 
 2504:       
 2505:       // Determines which way the normal vector to each side is oriented.
 2506:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2507:       for (int j = 0; j < i34[i]; j++)  
 2508:       {
 2509:          if (elem.sides[j]->elems[0] == &elem) {
 2510:             elem.ssign[j] =  1.0;
 2511:          }
 2512:          else {
 2513:             elem.ssign[j] = -1.0;
 2514:          }
 2515: 
 2516:       }
 2517: 
 2518:       // Derivatives of shape functions
 2519:       //  For ics=2, this is done inside element/ll frame XXX
 2520:       //  For quads, the derivative is evaluated at centroid
 2521:       const int i34 = elem.i34;
 2522:       for (int j = 0; j < i34; j++) {
 2523:          const double area = elem.area;
 2524:          const int id2 = elem.nxq(1 + j);
 2525:          const int id3 = elem.nxq(2 + j);
 2526:          const int id4 = elem.nxq(3 + j);
 2527:          if (elem.isTri()) {
 2528:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2529:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2530:             // da1/dx = (y1 - y2)/(2*area)
 2531:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2532:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2533:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2534:          }
 2535:          else  { // Quad; evaluate at centroid
 2536:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2537:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2538:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2539:          } // if Tri
 2540: 
 2541:       } // for j
 2542: 
 2543:    }
 2544: 
 2545: 
 2546:    // Processing the boundary nodes
 2547:    int idx = 0;
 2548:    for (int iseg = 0; iseg < nope; iseg++) {
 2549:       for (int ilnd = 0; ilnd < nlnd[iseg]; ilnd++) {
 2550: 
 2551:          NodeBoundary *nodeBnd = &localNodeBoundaryMem[idx];
 2552: 
 2553:          nodeBnd->isEssentialBC = true;
 2554: nodeBnd->iettype = 3;
 2555:          nodeBnd->elbc = 0.0;
 2556: 
 2557:          for (int jfr = 0; jfr < nbfr; jfr++) {
 2558:             nodeBnd->efa[jfr] = efa[jfr + iseg*nbfr];
 2559:             nodeBnd->emo[jfr] = emo[jfr + iseg*nbfr];
 2560:             nodeBnd->umo[jfr] = umo[jfr + iseg*nbfr];
 2561:             nodeBnd->ufa[jfr] = ufa[jfr + iseg*nbfr];
 2562:             nodeBnd->vmo[jfr] = vmo[jfr + iseg*nbfr];
 2563:             nodeBnd->vfa[jfr] = vfa[jfr + iseg*nbfr];
 2564: printf("nodeBnd->efa[%d] = %f, nodeBnd->emo[%d] = %f, nodeBnd->umo[%d] = %f, nodeBnd->ufa[%d] = %f, nodeBnd->vmo[%d] = %f, nodeBnd->vfa[%d] = %f\n", jfr, nodeBnd->efa[jfr], jfr, nodeBnd->emo[jfr], jfr, nodeBnd->umo[jfr], jfr, nodeBnd->ufa[jfr], jfr, nodeBnd->vmo[jfr], jfr, nodeBnd->vfa[jfr]);
 2565:          }
 2566: 
 2567:          idx++;
 2568:       }
 2569: 
 2570:    }
 2571: 
 2572: }
 2573: 
 2574: 
 2575: 
 2576: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 2577:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 2578:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 2579:    // 
 2580:    // This kernel is called for all nodes.
 2581: 
 2582: 
 2583:    NODE(node1);
 2584: 
 2585: 
 2586:    node1->clearMatrixRow();
 2587:    node1->qel = 0.0;
 2588: 
 2589:    // THIS IS FOR STRUCTURES XXX
 2590:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 2591: 
 2592:    
 2593:    for (int j=0; j<node1->numElements; j++) {
 2594:       // For each element connected to the node...
 2595: 
 2596:       Element *elem = node1->elements[j];
 2597: 
 2598:       // Compute the average gravity
 2599:       printf("UUU Node::grav2 = %f, %f, %f\n", elem->nodes[0]->grav2, elem->nodes[1]->grav2, elem->nodes[2]->grav2);
 2600:       const double grav3 = elem->mean(&Node::grav2);
 2601: 
 2602:       // Look at the documentation for the description of the terms in the following integrals
 2603: 
 2604:       // Integral I_1 
 2605:       // \bar{\breve{H}} 
 2606:       const double hhatb = elem->mean(&Side::hhat);        
 2607: 
 2608: 
 2609:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 2610: 
 2611:       const int id1 = elem->nodeLocalIdx(node1); 
 2612:       const double area = elem->area;
 2613: 
 2614:       if (elem->isTri()) {
 2615: 
 2616:          // To clarify the notation in this section: 
 2617:          //   i stands for the node under consideration (node1)
 2618:          //   j (node2) and k (node3) are the other nodes of the triangle.
 2619:          const int id2 = elem->nxq(1 + id1);
 2620:          const int id3 = elem->nxq(2 + id1);
 2621:          Node *node2 = elem->nodes[id2];
 2622:          Node *node3 = elem->nodes[id3];
 2623: 
 2624:          const Point2 x1 = node1->p2();
 2625:          const Point2 x2 = node2->p2();
 2626:          const Point2 x3 = node3->p2();
 2627: 
 2628:          // integral of phi_i*phi_j
 2629:          const double ipp_ii = (1.0/6.0 )*area;
 2630:          const double ipp_ij = (1.0/12.0)*area;
 2631:          const double ipp_ik = (1.0/12.0)*area;
 2632: 
 2633:          // integral of [(grad phi_i) * (grad phi_j)]
 2634:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 2635:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 2636:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 2637: 
 2638:          // Computes the different components of integral I_1 of each node with respect to node i.
 2639:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 2640:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 2641:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 2642: 
 2643: if (j==node1->numElements-1) {
 2644: printf("grav3 = %f, thetai = %f, dt = %f, hhatb = %f, area = %f, dot1= %f, dot2 = %f, dot3 = %f\n", grav3, thetai, dt, hhatb, area, dot(x3-x2, x3-x2), dot(x3-x2, x1-x3), dot(x1-x3, x1-x3));
 2645: printf("node idx = %d, x1 = %f, %f, x2 = %f, %f, x3 = %f, %f\n", node1->idx, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y);
 2646: printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 2647: }
 2648: 
 2649:          node1->addToSparseMatrix(node1, I1_ii);
 2650:          node1->addToSparseMatrix(node2, I1_ij); 
 2651:          node1->addToSparseMatrix(node3, I1_ik);
 2652: 
 2653: if (j==node1->numElements-1) printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 2654:      
 2655:       }
 2656:       else { // Quad
 2657:          // XXX IMPLEMENT THIS
 2658:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2659:       } 
 2660: 
 2661:  
 2662:       // Integral I_4
 2663:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 2664:       // Where
 2665:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 2666: 
 2667:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 2668:       // of U over the element.
 2669:       Vector2 Umean = {0.0, 0.0};
 2670:       for (int m=0; m<elem->i34; m++) {      
 2671:          const Side *side = elem->sides[m];
 2672: 
 2673:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 2674:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 2675:       }
 2676:       Umean = Umean/elem->i34;
 2677: 
 2678:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 2679: 
 2680:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 2681:       const double I_4_1 = dot(gradPhi_1, Umean);
 2682: 
 2683:       // Integral of \nabla\phi_i \cdot \pmb{E}
 2684:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 2685:      
 2686:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 2687: if (j==node1->numElements-1) printf("MMMMmm  idx_node = %d, I_4_1 = %.15g, I_4_2 = %.15g, node1->qel = %.15g, gradPhi_1 = %.15g, %.15g, elem->ghat1 = %.15g, %.15g\n", node1->idx, I_4_1, I_4_2, node1->qel, gradPhi_1.x, gradPhi_1.y, elem->ghat1.x, elem->ghat1.y);
 2688: 
 2689:       // Additional terms 
 2690:       double vnorm = 0.0;
 2691:       if (imm == 2)  { // Pre-compute vnorm on the element
 2692:          Vector3 ubed;
 2693:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 2694: 
 2695:          Vector3 gradP = {0.0, 0.0, 1.0};
 2696:          for (int m=0; m < elem->i34; m++) {
 2697:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 2698:            gradP += toVector3(gradP_2D, 0.0);
 2699:          }   
 2700:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 2701:       } // imm==2
 2702: 
 2703:       if (elem->isTri()) {
 2704:          for (int l=0; l<3; l++) {
 2705:            double fac;
 2706: 
 2707:            Node *node = elem->nodes[l];
 2708: 
 2709:            (node == node1)? fac=2.0 : fac=1.0;
 2710: 
 2711:            if (imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 2712:            else        node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 2713:            
 2714:          }
 2715: 
 2716: 
 2717:          if (!elem->isDry) {
 2718:            const Vector2 gradEta = elem->nodes[0]->eta2*elem->gradPhi[0] +
 2719:                                    elem->nodes[1]->eta2*elem->gradPhi[1] +
 2720:                                    elem->nodes[2]->eta2*elem->gradPhi[2];
 2721: 
 2722:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 2723:          }
 2724: if (j==node1->numElements-1) printf("&&& node1->qel = %f\n", node1->qel, node1->eta2);
 2725: 
 2726:       } // isTri
 2727:       else { // isQuad
 2728:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2729:          // for (int l=0; l<4; l++) {
 2730:          //   const Node *node = elem->nodes[l];
 2731: 
 2732:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 2733:          //   else        tmp2 = node->bdef2 - node->bdef1;
 2734: 
 2735:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 2736:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 2737:          // }
 2738: 
 2739:       } // isQuad
 2740: 
 2741: 
 2742:       node1->qel += (dt/elem->i34)*elem->vsource;
 2743:       
 2744: 
 2745:    } // for all elements connected to the node
 2746:    
 2747: 
 2748: 
 2749:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 2750:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 2751:    NodeBoundary *nodeBnd = node1->nodeBnd;
 2752:    if (nodeBnd != nullptr)  { 
 2753:       // If it is an open boundary node...
 2754: 
 2755:       // At least one open bnd side, maybe two
 2756:       for (int l=0; l<2; l++) { 
 2757: 
 2758:          // Gets each of the sides sharing the node. 
 2759:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 2760: 
 2761:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 2762: 
 2763:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 2764: 
 2765: 
 2766:          if (sideBnd != nullptr) {
 2767:             // If the side is on a boundary...
 2768: 
 2769:             // Get the boundary segment
 2770:             const BoundarySegment *sideSegment = sideBnd->segment;
 2771:             const Side *side = sideBnd->side;
 2772: 
 2773:             // Integral I_3
 2774:             if (sideSegment->ifltype != 0) {
 2775:             // Natural or Flather b.c.
 2776: 
 2777:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 2778:                // especially for Flather b.c.
 2779:                double ri3 = 0.0;
 2780:                if (!side->isDry) {
 2781:                   // If the side is not dry
 2782:                   
 2783:                   // Computes the side flux of (uth, vth)
 2784:                   double Vn = 0.0;
 2785:                   for (int k = side->kb; k<nvrt-1; k++) {
 2786:                      // uth, vth in lat/lon frame if ics=2
 2787:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 2788:                      const double vn1 = dot(side->uth[k  ], side->n); // outer normal
 2789:                      const double vn2 = dot(side->uth[k+1], side->n);
 2790: 
 2791:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 2792:                   }
 2793: 
 2794:                   ri3 = 0.5*side->length*Vn;
 2795:                }
 2796: 
 2797:                if (sideSegment->ifltype == -1) { // Flather 1
 2798: 
 2799:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 2800:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 2801: 
 2802:                   const double con0 = (1.0/6.0)*side->length*sqrt(grav*side->depth()); // For coefficient matrix
 2803:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 2804:                   
 2805:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 2806:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 2807: 
 2808:                } 
 2809:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 2810:                   // Reset ri3
 2811:                   ri3 = 0.0;
 2812: 
 2813:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 2814: 
 2815:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 2816: 
 2817:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 2818:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 2819: 
 2820:                   const double con0 = (1.0/6.0)*side->length*tmp*thetai*dt;
 2821:                   node1->addToSparseMatrix(node1, con0*2.0);
 2822:                   node1->addToSparseMatrix(node2, con0);
 2823: 
 2824:                } // if Flather or Discharge
 2825: 
 2826:                node1->qel -= thetai*dt*ri3;
 2827: 
 2828:             } // I_3
 2829:           
 2830: 
 2831:             // Integral I_5
 2832:             if(!side->isDry) {
 2833: 
 2834:                const double Unbar = dot(side->U, side->n);
 2835: 
 2836:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->length*Unbar;
 2837:                
 2838:             } // I_5
 2839: 
 2840:          } // if is boundary side
 2841: 
 2842:       } // for l
 2843: 
 2844:    } // if isbnd
 2845: 
 2846: 
 2847:    printf("44444444 idx_node = %d, node1->qel = %f\n", node1->idx, node1->qel);
 2848: 
 2849: }
 2850: 
 2851: 
 2852: extern "C" {
 2853:    __global__ void backtrackAllNodes(void) {
 2854: 
 2855:       // max/min # of sub-divisions
 2856:       const int ndelt_max = max(1.0, dt/dtb_min);
 2857:       const int ndelt_min = max(1.0, dt/dtb_max); 
 2858: 
 2859:       // Removed all references to swild98 XXX
 2860:       // swild98=0.d0 !init
 2861: 
 2862: 
 2863:       SIDE(side);
 2864: 
 2865:       const int kb = side->kb;
 2866: 
 2867:       printf("backtrackAllNodes: side->idx = %d, nvrt = %d\n", side->idx, nvrt);
 2868: 
 2869:       // Initialize btrack velocities to the actual velocities at the side 
 2870:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 2871: 
 2872: 
 2873:       if (side->isDry) return;
 2874: 
 2875: 
 2876:       // Checks that at least one element is not dry
 2877:       const Element *elem1 = side->elems[0];
 2878:       const Element *elem2 = side->elems[1];
 2879: 
 2880: 
 2881:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 2882:       
 2883:       // XXXXXX
 2884:       // !swild_tmp to store global coord. of the starting side
 2885:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 2886:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 2887:       // !Use sframe2 
 2888:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 2889: 
 2890: 
 2891:       for (int k = kb; k < nvrt; k++) {
 2892:       //  Initialize (xt,yt,zt), nnel and vel.
 2893:       //  For ics=2, the coordinates are in local frames
 2894:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 2895: 
 2896: 
 2897:          const int iadvf = side->iadv();  // Advection flag
 2898: 
 2899:          Point3 xt;
 2900:          if constexpr(ics==1) {
 2901:             xt = side->center3D(k); 
 2902:          }
 2903:          else // lat/lon; in side lat/lon frame
 2904:          {
 2905:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 2906:          // XXX IMPLEMENT THIS
 2907:       //          xt=0.d0
 2908:       //          yt=0.d0
 2909:       //          !centroid coord. for nudging
 2910:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 2911:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 2912:          }  // ics
 2913: 
 2914: 
 2915:          // Velocity at the side (in ll frame for ics, same vertical direction)
 2916:          // XXX IS THIS NECESSARY?
 2917:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 2918: 
 2919:          // If on land or open boundary...
 2920:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 2921:          
 2922:          const double vmag = length(toVector2(u_int));
 2923: 
 2924:          if (vmag <= velmin_btrack) {
 2925:             // No activity 
 2926: 
 2927:             side->btu[k] = side->u2[k];
 2928: 
 2929:             
 2930:          } else {  // do btrack
 2931: 
 2932:           
 2933:             // Compute number of sub-divisions based on local gradients 
 2934:             // XXX IS THIS NECESSARY?
 2935:             double suma = 0.0;
 2936:             int icount = 0;
 2937:             for (int ii=0; ii<2; ii++) {
 2938: 
 2939:                const Element *elem = side->elems[ii];
 2940:                  
 2941:                if (elem == nullptr) continue;
 2942: 
 2943:                icount++;
 2944: 
 2945:                // Not strictly along z; in ll frame for ics=2
 2946: 
 2947:                double utmp[4];
 2948:                double vtmp[4];
 2949:                for (int jj = 0; jj < elem->i34; jj++) {
 2950: 
 2951:                   const Node *node = elem->nodes[jj];
 2952: 
 2953:                   if constexpr(ics==1) {
 2954:                      utmp[jj] = node->u2[k].x;
 2955:                      vtmp[jj] = node->u2[k].y;  
 2956:                   } else {
 2957:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 2958:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 2959:                   }
 2960:                } // for jj
 2961: 
 2962:                const Vector2 grad_u = elem->grad(utmp); 
 2963:                const Vector2 grad_v = elem->grad(vtmp);
 2964: 
 2965:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 2966:             } // for ii
 2967: 
 2968:             assert(icount > 0 && "Impossible 77");
 2969: 
 2970:             // '4' is somewhat arbitrary
 2971:             const int ndelt = max(ndelt_min, min(ndelt_max, int(suma/icount)*4)); // >=1
 2972: 
 2973:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 2974:          
 2975: 
 2976:             Vector3 u_int = {0.0, 0.0, 0.0};
 2977: 
 2978:             side->btrack(k, dt, dtbk, u_int);
 2979: 
 2980:                
 2981:          } // if vmag (do backtrack)
 2982: 
 2983:       } // for j=jmin,nvrt-1
 2984: 
 2985:    }
 2986: } // extern "C"
 2987: 
 2988: template<int nc>
 2989: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 2990: 
 2991: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 2992: //
 2993: // a,b,c,r: input vectors and are not modified by this program.
 2994: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 2995: // r is the r.h.s.
 2996: // n: actual rank of the system.
 2997: // rows in u() and r();
 2998: // u: output with nc columns (transposed to rows)
 2999: // gam: a working array.
 3000: //
 3001: // NOTES:
 3002: // This is a template function that allows for different numbers of columns in the rhs vector.
 3003: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3004: 
 3005:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3006:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3007: 
 3008:    double bet = b[0];
 3009:    if constexpr (nc == 1) {
 3010:       u[0] = rhs[0]/bet;
 3011:    } else {
 3012:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 3013:    }
 3014: 
 3015:    for (int j = 1; j < n; j++) {
 3016:       gam[j] = c[j-1]/bet;
 3017:       bet = b[j] - a[j]*gam[j];
 3018: 
 3019:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3020: 
 3021:       if constexpr (nc == 1) {
 3022:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3023:       } else {
 3024:          for (int k = 0; k < nc; k++) {
 3025:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 3026:          }
 3027:       }
 3028:    }
 3029: 
 3030:    // Back-substitution
 3031:    for (int j=n-1; j>=1; j--) {
 3032:       if constexpr (nc == 1) {
 3033:          u[j] = u[j] - gam[j+1]*u[j-1];
 3034:       } else {
 3035:          for (int k = 0; k < nc; k++) {
 3036:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 3037:          }
 3038:       }
 3039:    }
 3040: }
 3041: 
 3042: 
 3043: 
 3044: 
 3045: // Helper function that contains the core algorithm
 3046: template<typename XAccessor, typename YAccessor>
 3047: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3048:                                     double  yp_top, double  yp_bot, 
 3049:                                     CubicSpline &spline) {
 3050:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3051:    // 
 3052:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3053:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3054:    //
 3055:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3056:    // 
 3057:    // Inputs: 
 3058:    //            n: dimension for x etc; # of data pts (>=2);
 3059:    //            getX, getY: functions to access x,y coordinates
 3060:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3061:    //     Output: 
 3062:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3063: 
 3064:    const int n = k2 - k1 + 1;
 3065:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3066: 
 3067:    // Allocate memory for the splines
 3068:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3069:    spline.x   = new double[n];
 3070:    spline.y   = new double[n];
 3071:    spline.yp  = new double[n];
 3072:    spline.ypp = new double[n];
 3073: 
 3074:    for (int k=k1; k<=k2; k++) {
 3075:       spline.x[k] = getX(k);
 3076:       spline.y[k] = getY(k);
 3077:    }
 3078: 
 3079:    // This is to simplify expressions later
 3080:    double *x = spline.x;
 3081:    double *y = spline.y;
 3082: 
 3083:    double *a = nullptr;
 3084:    double *b = nullptr;
 3085:    double *c = nullptr;
 3086:    double *gam = nullptr;
 3087:    double *rhs = nullptr;
 3088:    
 3089: 
 3090:       a = new double[n];   // Lower diagonal
 3091:       b = new double[n];   // Diagonal
 3092:       c = new double[n];   // Upper diagonal
 3093:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3094:       rhs = new double[n]; // Right-hand side
 3095: 
 3096:    for (int k=k1; k<=k2; k++) {
 3097:       if (k == k1) {
 3098:          // Bottom level
 3099:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3100:          b[k] = (x[k+1] - x[k])/3.0;
 3101:          c[k] = b[k]/2.0;
 3102:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3103:       } else if (k == n - 1) {
 3104:          // Top level (surface)
 3105:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3106:          b[k] = (x[k] - x[k-1])/3.0;
 3107:          a[k] = b[k]/2.0;
 3108:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3109:       } else {
 3110:          // Intermediate levels
 3111:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3112:          b[k] = (x[k+1] - x[k-1])/3.0;
 3113:          a[k] = (x[k  ] - x[k-1])/6.0;
 3114:          c[k] = (x[k+1] - x[k  ])/6.0;
 3115:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3116:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3117:       }
 3118:    }
 3119: 
 3120:    // Solve the tridiagonal system
 3121:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3122:    
 3123:    spline.yp[k1] = yp_bot;
 3124:    spline.yp[k2] = yp_top;
 3125: 
 3126:    // Compute rest of 1st derivatives using the splines
 3127:    for (int k=k1+1; k<k2; k++) {
 3128:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3129:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3130:    }
 3131:    
 3132:    delete[] a;
 3133:    delete[] b;
 3134:    delete[] c;
 3135:    delete[] gam;
 3136:    delete[] rhs;
 3137: 
 3138: }
 3139: 
 3140: // Array version
 3141: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3142:                                 double y_top, double y_bot, 
 3143:                                 CubicSpline &spline) {
 3144:    auto getX = [x] (int k) { return x[k]; };
 3145:    auto getY = [y] (int k) { return y[k]; };
 3146:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3147: }
 3148: 
 3149: // Lambda version - allows custom access patterns
 3150: template<typename XFunc, typename YFunc>
 3151: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3152:                                 double y_top, double y_bot,
 3153:                                 CubicSpline &spline) {
 3154:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3155: }
 3156: 
 3157: 
 3158: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 3159: {
 3160:    assert("Not implemented");
 3161: 
 3162:    return 0.0;
 3163: }
