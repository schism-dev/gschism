 3394:    __global__ void computeElevationBoundaryConditions(double time) {
 3395:       // Compute elevation essential boundary conditions 
 3396: 
 3397:       NODE_BND(nodeBnd); // Each boundary node.
 3398: 
 3399:       const Node *node = nodeBnd->node;
 3400:       const int iettype = nodeBnd->iettype;
 3401: 
 3402:       double eic = 0.0;
 3403:       if (nramp_elev==1) eic = nodeBnd->etaic;
 3404:       else               eic = 0.0;
 3405: 
 3406:       const double r_eic = (1.0 - ramp)*eic; 
 3407:       const double r_eth = ramp*nodeBnd->eth;
 3408:       double eta1_bar = r_eic;
 3409: 
 3410:       // Compute tide elevation
 3411:       if (iettype == 3 || iettype == 5) {
 3412:         
 3413:          // XXX IMPLEMENT TIDE THINGS
 3414:          assert(false && "Tide elevation not implemented");
 3415:          // for (int jfr=0; jfr<nbfr; jfr++) { // For all tide frequencies
 3416:          //    const int ncyc = int(amig[jfr]*time/(2.0*pi));
 3417:          //    const double arg = amig[jfr]*time - 2.0*pi*ncyc + face[jfr] - efa[i,j,jfr];
 3418:          //    eta1_bar += ramp*ff[jfr]*emo[i,j,jfr]*cos(arg);
 3419:          // } // for jfr
 3420:       } // if iettype
 3421: 
 3422:       switch (iettype) {
 3423:          case 1:
 3424:          case 2:
 3425:             nodeBnd->elbc = r_eth + r_eic;
 3426:             break;
 3427:          case 3:
 3428:             nodeBnd->elbc = eta1_bar + r_eic;
 3429:             break;
 3430:          case 4:
 3431:             nodeBnd->elbc = r_eth + r_eic;
 3432:             break;
 3433:          case 5:
 3434:             nodeBnd->elbc = r_eth + eta1_bar + r_eic;
 3435:             break;
 3436:       } // switch
 3437: 
 3438: 
 3439:       //Add inverse barometric effects
 3440:       if (iettype != 0 && inv_atm_bnd == 1) {
 3441:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 3442:       }
 3443: 
 3444:    }
 3445: 
 3446:    __global__ void computeVerticallyIntegratedVelocity(void) {
 3447: 
 3448:       SIDE(side);
 3449: 
 3450: 
 3451:       side->U = {0.0, 0.0}; 
 3452:          
 3453:       if(side->isDry) return;
 3454: 
 3455:       const Node *node1 = side->n1;
 3456:       const Node *node2 = side->n2;
 3457: 
 3458:       // Vertically integrated velocity U (in ll if ics=2)
 3459:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 3460:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 3461:       }
 3462: 
 3463:    }
