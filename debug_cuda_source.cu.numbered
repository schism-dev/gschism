 1088: // Helper functions for computing the local node index at a given offset from another.
 1089: __device__ __inline__ int nxq(int offset, int index, int size) {
 1090:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1091:    // to the index to make it positive
 1092:    assert(index + offset + 16*size >= 0);
 1093:    return (index + offset + 16*size) % size;  
 1094: }
 1095: 
 1096: __device__ __inline__ int nxq(int index, int size) {
 1097:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1098:    // to the index to make it positive
 1099:    assert(index + 16*size >= 0);
 1100:    return (index + 16*size) % size; 
 1101: }
