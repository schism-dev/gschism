 1404: 
 1405: /**
 1406:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1407:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1408:    If the segment is completely inside the element, then it returns true.
 1409: 
 1410:    This function assumes:
 1411:    - The initial point is on a side of the element. 
 1412:    - Its position is given by parameter t in the range [0,1].
 1413:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1414:       intersects the element (elements are convex).
 1415: 
 1416:    To find the intersection point, this function does the following:
 1417:    - it finds the intersection of the line segment with all the element side lines,
 1418:       except for the one that contains the initial point.
 1419:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1420:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1421:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1422:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1423:       track segment is almost parallel to the element side line.
 1424: 
 1425:    Inputs:
 1426:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1427:    @param x2, y2: other end of the line segment
 1428: 
 1429:    Outputs:
 1430:    @param side:  side that intersects the line segment (input and output)
 1431:    @param nextElement (output): element that contains the intersection point
 1432:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1433:    @param zint (input/output): Vertical coordinate of the intersection point
 1434: 
 1435:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1436:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1437:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1438: 
 1439:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1440:    (Delta) being zero.
 1441: 
 1442:    The intersection2 point happens when:
 1443:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1444:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1445:    
 1446:    Assumption: the 4 points (including those of the side segment) are different.
 1447:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1448:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1449:    If true, (xIntersect,yIntersect) is the intersection.				
 1450:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1451: **/
 1452: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1453:                                               double &t, double& tIntersect) {
 1454: 
 1455:    double closest_intersect_t = 1e10;
 1456:    bool found_intersection = false;
 1457: 
 1458:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1459:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1460:    const Point2 x1 = side->point(t);
 1461:    
 1462: 
 1463:    Side *nextSide = nullptr;
 1464:    for (int i = 0; i < i34; i++) {
 1465: 
 1466:       // Element's i-th side 
 1467:       Side *side2 = sides[i];
 1468: 
 1469:       // Skip the side that contains the initial point
 1470:       if (side2 == side) continue;
 1471: 
 1472:       // (x3,y3)-(x4,y4) is the element side line
 1473:       const Point2 x3 = side2->n1->p2();
 1474:       const Point2 x4 = side2->n2->p2();
 1475: 
 1476:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1477:       const double delta = cross(x2 - x1, x3 - x4);
 1478: 
 1479:       if (delta != 0.0) {
 1480: 
 1481:          const double delta1 = cross(x3 - x1, x3 - x4);
 1482:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1483: 
 1484:          // Solves the two linear equations for tt1 and tt2
 1485:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1486:          const double tt2 = delta2/delta;
 1487: 
 1488:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1489:             closest_intersect_t = min(closest_intersect_t, tt1);
 1490:             nextSide = side2;
 1491: 
 1492:             nextElement = nextSide->otherElem(this);
 1493:             tIntersect = max(small, min(tt1, 1.0-small));
 1494:             t = tt2;
 1495: 
 1496:             found_intersection = true;
 1497:          }
 1498:       
 1499:       }
 1500: 
 1501:    }
 1502:    
 1503: printf("AAA 1, found_intersection = %d, nextSide = %p, nextElement = %p\n", found_intersection, nextSide, nextElement);
 1504: 
 1505: 
 1506:    // found_intersection should always be true, since we checked all the sides.  
 1507:    side = nextSide;
 1508: // if (found_intersection) {
 1509: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1510: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1511: // }   
 1512:    // if (!found_intersection) {
 1513:    //    // Check if the segment is parallel to the initial side
 1514:    //    printf("XXX segment: side = %p\n", side);
 1515:    //    printf("XXX %f\n", dot(x2 - x1, side->n1->p2() - side->n2->p2()));
 1516:    //    if (abs(dot(x2 - x1, side->n1->p2() - side->n2->p2())) < small) {
 1517:    //       assert(false && "Segment is parallel to the initial side");
 1518:    //       found_intersection = true;
 1519:    //       nextElement = side->otherElem(this);
 1520:    //       tIntersect = t;
 1521:    //       t = 0.0;
 1522:    //       found_intersection = true;
 1523:    //    }
 1524:    // }
 1525:    return found_intersection;
 1526: }
 1527: 
 1528: 
 1529: 
 1530: 
 1531: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1532:                                               double &t, double& tIntersect) {
 1533: 
 1534:    double closest_intersect_t = 1e10;
 1535:    bool found_intersection = false;
 1536: 
 1537: double minDelta = 1e10; 
 1538: double btt1, btt2;
 1539:    for (int i = 0; i < i34; i++) {
 1540: 
 1541:       Side *side2 = sides[i];
 1542: 
 1543:       // (x3,y3)-(x4,y4) is the element side line
 1544:       const Point2 x3 = side2->n1->p2();
 1545:       const Point2 x4 = side2->n2->p2();
 1546: 
 1547:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1548:       const double delta = cross(x2 - x1, x3 - x4);
 1549: 
 1550:       if (abs(delta) > 0) {
 1551: 
 1552:          const double delta1 = cross(x3 - x1, x3 - x4);
 1553:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1554: 
 1555:          // Solves the two linear equations for tt1 and tt2
 1556:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1557:          const double tt2 = delta2/delta;
 1558: 
 1559: if (abs(delta) < minDelta) {
 1560:    minDelta = abs(delta);
 1561:    btt1 = tt1;
 1562:    btt2 = tt2;
 1563: }
 1564: double small = 1e-7;
 1565:          printf("RRRRRR tt1 = %e, tt2 = %e\n", tt1, tt2);
 1566:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1567:             closest_intersect_t = min(closest_intersect_t, tt1);
 1568:             side = side2;
 1569:             nextElement = side->otherElem(this);
 1570:             t = tt2;
 1571:             tIntersect = max(small, min(tt1, 1.0-small));
 1572:             found_intersection = true;
 1573:          }
 1574:       
 1575:       }
 1576:       else {  // parallel segments
 1577:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1578:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1579: 
 1580:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1581: 
 1582:          // const double dist = dot(x1 - x3, side2->n);
 1583:          // if (abs(dist) < small*length(x3 - x4)) {
 1584:          //    const double2 unitarySide = normalize(x4 - x3);
 1585:          //    const double len = dot(x2 - x1, unitarySide);
 1586:          //    t = t + len;
 1587:          //    t = max(0.0, min(t, 1.0));
 1588:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1589: 
 1590: 
 1591:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1592:          //    // t = tt2;
 1593:          //    found_intersection = true;
 1594:          // }
 1595:       }
 1596: 
 1597: 
 1598:    }
 1599: 
 1600:    if (!found_intersection) {
 1601:       
 1602:       printf("ZZ No intersection found:\n"
 1603:            "Element %d\n"
 1604:            "in = %d\n"
 1605:            "minDelta = %e\n"
 1606:            "tt1 = %e, tt2 = %e\n"
 1607:            "segment: (%f, %f)-(%f, %f)\n"
 1608:            "Vertices:\n"
 1609:          //   "  Nodes nextElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n"
 1610:            "  Nodes curElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n",
 1611:            IDX(nextElement),
 1612:            (btt1 >= -small && btt2 >= -small && btt2 <= 1.0 + small && btt1 <= 1.0 + small),
 1613:            minDelta,
 1614:            btt1, btt2,
 1615:            x1.x, x1.y,
 1616:            x2.x, x2.y,
 1617:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1618:          //   nextElement->nodes[1]->p.x, nextElement->nodes[1]->p.y,
 1619:          //   nextElement->nodes[2]->p.x, nextElement->nodes[2]->p.y,
 1620:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1621:            nodes[0]->p.x, nodes[0]->p.y,
 1622:            nodes[1]->p.x, nodes[1]->p.y,
 1623:            nodes[2]->p.x, nodes[2]->p.y,
 1624:            nodes[0]->p.x, nodes[0]->p.y);
 1625: 
 1626:    }
 1627: 
 1628:    // assert(found_intersection && "No intersection found");
 1629: 
 1630:    // found_intersection should always be true, since we checked all the sides.  
 1631:    return found_intersection;
 1632: }
 1633: 
 1634: 
 1635: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1636:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1637: 
 1638:    printf("Tracking segment goes out of water at element %d\n", curElem->idx);
 1639: 
 1640:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1641:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1642:    // curElement.
 1643: 
 1644:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1645:    // And uses this velocity instead to continue the tracking.
 1646: 
 1647:    // computes the intersection point in cartesian coordinates
 1648:    Point2 intersection = nextSide->p_t(tt);
 1649: 
 1650:    // Nudges the point to the barycenter of the element. 
 1651:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1652:    // next segment intersects the element sides.  
 1653:    curElem->nudgeToBarycenter(intersection);
 1654: 
 1655:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1656:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1657:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1658:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1659: 
 1660:    // If the side is an open boundary, the tangential velocity is zero.
 1661:    if (nextSide->isBnd()) vtan = 0.0;
 1662: 
 1663:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1664:    const double us = vtan*nextSide->t().x;
 1665:    const double vs = vtan*nextSide->t().y;
 1666:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1667: 
 1668:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1669:    const double len2 = length(intersection - toPoint2(xt));
 1670:    const double vel2 = u_int.x*u_int.x + u_int.y*u_int.y;        
 1671:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 1672:    else            dt = 0.0;
 1673: 
 1674:    // The end of this tracking segment is now the intersection point.
 1675:    xt = {intersection.x, intersection.y, zint};
 1676: printf("BBB u_int = %f,%f,%f\n", us, vs, ws);   
 1677:    u_int = {us, vs, ws};
 1678:    
 1679: }
 1680: 
 1681: /**
 1682:  * Tracks a particle through elements and vertical levels in the mesh.
 1683:  * 
 1684:  * @param x0,y0,z0     Starting position coordinates
 1685:  * @param xt,yt,zt     Target position coordinates
 1686:  * @param dtb          Time step for tracking
 1687:  * @param uuint,vvint,wwint Initial velocity components
 1688:  * @param nextElem     Starting/resulting element index
 1689:  * 
 1690:  * @return Status code of type trackExitCodes
 1691:  * 
 1692:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1693:  * of the details are different. The idea is that the code requires less branches and is better fit
 1694:  * for GPU execution.
 1695:  * 
 1696:  * The main ideas here are:
 1697:  * - The starting point is expected to be in the starting element.
 1698:  * - The end point is guaranteed to be inside an element.
 1699:  * - since the starting point is inside the element, there are only two cases: 
 1700:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1701:  *     (b) it does not and (xt,yt) is already in the starting element.
 1702:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1703:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1704:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1705:  * - tt1 can be positive or negative. We only consider the positive values.
 1706:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1707:  * - The next intersection will occur at the smallest positive tt1.
 1708:  * - This intersection will be the next (x0,y0) position.
 1709:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1710:  *   of getting stuck in a loop.
 1711:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1712:  *   was found.
 1713:  */
 1714: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1715:                                                        Element *&nextElem, int &jlev, double &dt) {
 1716: 
 1717:    // First thing is to check if the target point is inside the element. If it is there is nothing
 1718:    // else to do.
 1719: 
 1720:    const Element *curElem = nextElem;
 1721:    if (containsPoint(toPoint2(xt))) {
 1722:       curElem->interpolateVelocities(xt, u_int);
 1723:       return true;
 1724:    }
 1725: 
 1726:    Side *side = nullptr;
 1727: 
 1728:    // 1. Initial checks
 1729:    // Verify starting element is valid (wet)
 1730:    assert(!curElem->isDry && "Starting element is dry");
 1731: 
 1732:    // Checks if track has a zero length.
 1733:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1734:    // assert(len2 > 0.0 && "Zero length track"); 
 1735:    
 1736:    const int MAX_ITERATIONS = 1000;
 1737:    
 1738:    double t;
 1739:    Side *nextSide = nullptr;
 1740:    double tIntersect = 1e10;
 1741:    double zint = x0.z;
 1742: 
 1743:    // Horizontal tracking loop
 1744:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1745:    // (x0,y0) is inside the element but the target point is not.
 1746: 
 1747:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1748: 
 1749:    if (!found_intersection) {
 1750: double shpCoords_0[4];
 1751: double shpCoords_t[4];
 1752: computeShapeCoords(toPoint2(x0), shpCoords_0, false);
 1753: computeShapeCoords(toPoint2(xt), shpCoords_t, false);
 1754:       printf("No intersection found (containsPoint = %d, %d [%.17g, %.17g, %.17g] [%.17g, %.17g, %.17g]):\n"
 1755:            "Elements %d, %d\n"
 1756:            "Side %d\n"
 1757:            "segment: (%f, %f),(%f, %f)\n"
 1758:            "triangle node indices: %d, %d, %d\n"
 1759:            "triangle: (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n",
 1760:            containsPoint(toPoint2(x0)), containsPoint(toPoint2(xt)),
 1761:            shpCoords_0[0], shpCoords_0[1], shpCoords_0[2],
 1762:            shpCoords_t[0], shpCoords_t[1], shpCoords_t[2],
 1763:            IDX(curElem), IDX(nextElem),
 1764:            IDX(nextSide),
 1765:            x0.x, x0.y,
 1766:            xt.x, xt.y,
 1767:            curElem->nodes[0]->idx, curElem->nodes[1]->idx, curElem->nodes[2]->idx,
 1768:            curElem->nodes[0]->p.x, curElem->nodes[0]->p.y,
 1769:            curElem->nodes[1]->p.x, curElem->nodes[1]->p.y,
 1770:            curElem->nodes[2]->p.x, curElem->nodes[2]->p.y,
 1771:            curElem->nodes[0]->p.x, curElem->nodes[0]->p.y);
 1772:    }
 1773:    assert(found_intersection && "No intersection found at %d");
 1774: 
 1775:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1776: 
 1777:    // if the tracking segment goes out of water (either dry or edge boundary)
 1778:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1779: 
 1780: 
 1781:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1782:       nextElem = this;
 1783:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1784:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1785:       return true;    
 1786:    }
 1787: 
 1788: 
 1789:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1790:    int iterations = 0;
 1791:    while (iterations < MAX_ITERATIONS) {
 1792:       iterations++;
 1793:       
 1794:       Element *curElem = nextElem;
 1795: 
 1796:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1797: 
 1798:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1799: 
 1800:       // If we are already in the target element, we are done.
 1801:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1802:       if (!found_intersection) break;
 1803: 
 1804: 
 1805: 
 1806:       // if the tracking segment goes out of water (either dry or edge boundary).
 1807:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1808: 
 1809:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1810: 
 1811:          nextElem = curElem;
 1812: 
 1813: 
 1814:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1815:          // In this case, the caller (btrack) needs to take into account the remaining time.
 1816:          return true;
 1817:       }
 1818:       
 1819:       // Update position and element for next iteration
 1820:       side = nextSide;
 1821: 
 1822:    }
 1823: 
 1824:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 1825: 
 1826:  
 1827:    // Interpolate velocities at the final position. This is a conceptually simple step,
 1828:    // but the function is not simple, because it has to search for the vertical level containing zt.
 1829:    nextElem->interpolateVelocities(xt, u_int);
 1830: 
 1831: 
 1832:    return true;
 1833: }
 1834: 
 1835: 
 1836: __inline__ __device__ double Element::computeSignedArea(void) const {
 1837:    // Compute the area of the element
 1838: 
 1839:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 1840: 
 1841:    // In the quad case we need to add the area of the other triangle.
 1842:    if (isQuad()) {
 1843:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1844:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 1845:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1846:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 1847:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 1848:          Error("Negative area found in quad element");
 1849:       }
 1850:       res += ar1;
 1851:    }
 1852: 
 1853:    return res;
 1854: }
 1855: 
 1856: 
 1857: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->eta2 + nodes[0]->depth <= h0) ||
 1858:                                                                 (nodes[1]->eta2 + nodes[1]->depth <= h0) ||
 1859:                                                                 (nodes[2]->eta2 + nodes[2]->depth <= h0) ||
 1860:                                                                 (i34==4 && nodes[3]->eta2 + nodes[3]->depth <= h0);
 1861: }
 1862: 
 1863: 
 1864: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 1865:    // In boundary sides, the element 1 is nullptr
 1866:    return side->elems[1] == nullptr; 
 1867: }
 1868: 
 1869: 
 1870: 
 1871: /**
 1872:    Compute the shape coordinates of the point (xt,yt) in the element.
 1873:    @param xt (input): x-coordinate of the point
 1874:    @param shpCoords (output): shape coordinates of the point
 1875:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 1876:    @return true if the point is inside the element, false otherwise
 1877: **/
 1878: __device__ bool Element::computeShapeCoords(Point2 xt, double shpCoords[4],
 1879:                                             bool fixNegshpCoord) const {
 1880: 
 1881:    // Compute the shape coordinates of the point xt in the element.
 1882:    if (i34==3) {
 1883:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 1884:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 1885:       // and in this case, the pt will be nudged into the element
 1886:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 1887:       // from the local frame, so use additional check.
 1888: 
 1889:       Point2 x0, x1, x2;
 1890: 
 1891:       if constexpr(ics==1) {
 1892:          x0 = nodes[0]->p2();
 1893:          x1 = nodes[1]->p2();
 1894:          x2 = nodes[2]->p2();
 1895:       }
 1896:       else // lat/lon
 1897:       {
 1898:          Error("Not implemented yet");
 1899: #ifdef ICS2
 1900:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 1901:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 1902:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 1903: #endif
 1904:       }
 1905: 
 1906:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 1907:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 1908:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 1909:       shpCoords[3] = 0.0;
 1910:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 1911: 
 1912:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 1913:       // then we fix the negative shape coordinates.
 1914:       if (fixNegshpCoord && tmpmin<=0.0) {
 1915: 
 1916:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 1917:          // keeping the sum of the shape coordinates equal to 1.
 1918:          // I have tested and compared the new algorithm with the old one, and they give
 1919:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 1920:          // The new algorithm should be faster since it is branchless.
 1921:          const double a = - tmpmin + 1.0e-2;  // XXX it used to be 1.0e-4 in the comments of the original code
 1922:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 1923:          
 1924:          shpCoords[0] = (shpCoords[0] + a)*b;
 1925:          shpCoords[1] = (shpCoords[1] + a)*b;
 1926:          shpCoords[2] = (shpCoords[2] + a)*b;          
 1927: 
 1928:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 1929:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 1930:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 1931:          }
 1932: 
 1933:          // Update the point coordinates for the new shape coordinates
 1934:          double xcoords[3] = {x0.x, x1.x, x2.x};
 1935:          double ycoords[3] = {x0.y, x1.y, x2.y};
 1936:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 1937: 
 1938:       }
 1939: 
 1940:       // Check if the point is inside the element
 1941:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 1942:    }
 1943:    else {
 1944:       Error("Not implemented yet");
 1945: #ifdef QUADS
 1946:       // Reproject pt in eframe of nel for ics=2
 1947:       if constexpr(ics==1) {
 1948:          xn2 = xt; 
 1949:          yn2 = yt;
 1950:       }
 1951:       else {
 1952:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 1953:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 1954:       }
 1955: 
 1956:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 1957: #endif
 1958:    }
 1959: 
 1960:    return false;  // Never reached
 1961: 
 1962: }
 1963: 
 1964: 
 1965: /**  Interpolate velocities at a given point (xt,yt,zt)
 1966: 
 1967:    @param xt, yt, zt: coordinates of the point to interpolate
 1968:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 1969: 
 1970:    This is done in four steps:
 1971: 
 1972:    1. Find the shape coordinates for the final position in the element.
 1973:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 1974:    3. Perform a *binary search* to find the vertical level containing zt. It will have to interpolate the 
 1975:       z levels at xt, yt at each step.   
 1976:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 1977:       horizontally and vertically.
 1978: **/
 1979: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 1980:    // Interpolate the velocities at the point xt. 
 1981:    // This function works the same for triangular and quadrilateral elements.
 1982:    double shpCoord[4];
 1983: 
 1984: 
 1985:    // First step is to compute the shape coordinates of (xt,yt)
 1986:    computeShapeCoords(toVector2(xt), shpCoord, false);
 1987:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 1988: 
 1989:    // Second step is to find the level that contains zt
 1990:    // Uses a binary search to find the level
 1991:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 1992:    int L = kbe;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 1993:    int R = nvrt - 1;
 1994: 
 1995:    // Get the z coordinates at the nodes of the element at the levels L and R
 1996:    double zLAtNodes[4], zRAtNodes[4];
 1997:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 1998:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 1999: 
 2000:    double zL = interpolate(shpCoord, zLAtNodes);
 2001:    double zR = interpolate(shpCoord, zRAtNodes);
 2002:    
 2003:    // Interpolates vertically the velocities
 2004:    double wght1, wght2;
 2005:    if (xt.z<=zL) {
 2006:       wght1 = 1.0;
 2007:       wght2 = 0.0;
 2008:    }
 2009:    else if (xt.z>=zR) {
 2010:       wght1 = 0.0;
 2011:       wght2 = 1.0;
 2012:    }
 2013:    else {
 2014:       // Perform a binary search to find the levels between L and R that contain xt.z
 2015:       while (R - L > 1) {
 2016:          int M = (L + R) / 2;
 2017: 
 2018:          double zMAtNodes[4];
 2019:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2020:          double zM = interpolate(shpCoord, zMAtNodes);
 2021:          if (zM < xt.z) 
 2022:          {
 2023:             L = M;
 2024:             zL = zM;
 2025:          }
 2026:          else 
 2027:          {
 2028:             R = M;
 2029:             zR = zM;
 2030:          }
 2031:       }
 2032:       assert(L == R-1);
 2033:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2034: 
 2035:       wght2 = (xt.z - zL)/(zR - zL);
 2036:       wght1 = 1.0 - wght2;
 2037:    }
 2038: // printf("$$$ wght1 = %f, wght2 = %f, zt = %f, zL = %f, zR = %f\n", wght1, wght2, zt, zL, zR);
 2039: // printf("$$$ shpCoord = %f, %f, %f, %f\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 2040:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2041:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 2042: 
 2043:    // Neither of the interpolated velocities should be NaN
 2044:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2045: 
 2046: }
 2047: 
 2048: 
 2049: 
 2050: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2051: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2052: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2053: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2054:    Vector2 grad = {0.0, 0.0};
 2055:    int count = 0;
 2056: 
 2057:    if constexpr(ics == 2) assert(false && "computeHorGradientAtSide: ics = 2 not implemented");
 2058: 
 2059:    // First element
 2060:    if (elems[0] != nullptr && condition(elems[0])) {
 2061:       grad += elems[0]->grad2(field);
 2062:       count++;
 2063:    }
 2064: 
 2065:    // Second element
 2066:    if (elems[1] != nullptr && condition(elems[1])) {
 2067:       grad += elems[1]->grad2(field);
 2068:       count++;
 2069:    }
 2070: 
 2071:    if (count > 0) {
 2072:       grad = grad/count;
 2073:    }
 2074:    
 2075:    return grad;
 2076: }
