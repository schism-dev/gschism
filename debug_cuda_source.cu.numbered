    6: constexpr int ivcor = 2; // Vertical coordinate system
    7: constexpr int ics = 1;   // 1: global, 2: local
    8: constexpr int ihh = 1;   // Option to limit \hat{H} to enhance stability for large friction in shallow area
    9: constexpr int imm = 0;   // Option to pre-compute vnorm on the element
   10: constexpr int iveg = 0;  // Vegetation option, 0: no vegetation, 1: vegetation
   11: constexpr int ihhat = 1; // Option to limit \hat{H} to enhance stability for large friction in shallow area
   12: 
   13: constexpr int nchi = 0;  // Option to compute drag coefficients chi and chi2
   14: 
   15: constexpr int nramp_elev = 0; // Option to use ramp for elevation boundary conditions
   16: 
   17: constexpr int    iloadtide = 0;       // Option to use polynomial for discharge boundary
   18: constexpr double loadtide_coef = 0.1; // Load tide coefficient
   19: 
   20: constexpr int    inv_atm_bnd = 0;     // Option to use inverse barometric effects at boundary
   21: constexpr double prmsl_ref = 101325.0; // Reference pressure for inverse barometric effects
   22: 
   23: constexpr double veg_lai = 1.0; // Vegetation drag coefficient
   24: constexpr double veg_cw = 1.5; // Vegetation drag coefficient
