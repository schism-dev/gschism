 1146: // Helper functions for computing the local node index at a given offset from another.
 1147: __device__ __inline__ int nxq(int offset, int index, int size) {
 1148:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1149:    // to the index to make it positive
 1150:    assert(index + offset + 16*size >= 0);
 1151:    return (index + offset + 16*size) % size;  
 1152: }
 1153: 
 1154: __device__ __inline__ int nxq(int index, int size) {
 1155:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1156:    // to the index to make it positive
 1157:    assert(index + 16*size >= 0);
 1158:    return (index + 16*size) % size; 
 1159: }
