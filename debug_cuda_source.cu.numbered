  393: struct Element {
  394: 
  395:    // Geometry information
  396:    int idx;               // Index of the element
  397:    int i34;               // Number of sides for the element 
  398:    Side *sides[4];        // Sides of the element
  399:    Node *nodes[4];        // Nodes of the element
  400:    Element *nghbElems[4]; // Neighbors of the element
  401: 
  402:    int kb;                    // Bottom index of the element
  403:    double area;               // Area of the element
  404:    double ssign[4];           // Sign associated with each side of an element
  405:    double radius;             // Element equivalent radii
  406: 
  407:    Frame frame;
  408: 
  409:    Vector2 gradPhi[4];       // Derivatives of shape functions
  410:    Vector2 gradEta[nvrt];    // Gradient of free surface elevation
  411: 
  412:    bool isDry;                  // True if the element is dry
  413:    int kbe;                   // Bottom index of the element
  414: 
  415:    Vector3 center;            // Element center coordinates
  416:    double xlon_el, ylat_el;   // Element center lat/lon coordinates in _degrees_
  417:    double depth;              // Depth at element (min of all nodes)
  418:    double z[nvrt];            // z-coord  (local frame - vertical up)
  419: 
  420:    // Physical information
  421:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  422: 
  423:    static const bool isblock = false;              // Always false
  424: 
  425:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  426:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  427: 
  428:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  429: 
  430:    
  431: 
  432:    double vsource;            // Volumetric source/sink term [m^3/s]
  433: 
  434:    double rho[nvrt];          // Density at each prism center
  435:    double rho_mean[nvrt];     // Mean density at each prism center
  436:    CubicSpline rho_spl;
  437:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  438:    double rho_z[nvrt];        // First derivative of density at each prism center
  439:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  440: 
  441:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  442: 
  443:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  444:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  445: 
  446:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 1; }
  447:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 1; }
  448: 
  449:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  450:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  451:       // Find the local index of the node in the element (0,1,2,3)
  452:       int res = __ffs((nodes[0] == node) | 
  453:                      ((nodes[1] == node) << 1) | 
  454:                      ((nodes[2] == node) << 2) | 
  455:                      ((nodes[3] == node) << 3)) - 1;
  456:       
  457:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  458:       return res;
  459:    }
  460: 
  461:    __inline__ __device__ int findLevel(double z1, int k) const {
  462:       // Starting at index k, find sequentially the level that contains z
  463: 
  464:       // if z is already betweeen z[k] and z[k+1], return k
  465:       if (z1 >= z[k] && z1 < z[k+1]) return k;
  466:       else if (z1 < z[k]) { 
  467:          // Search for increasing levels
  468:          for (int kk = k; kk < nvrt - 1; kk++) {
  469:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  470:          }
  471:          return nvrt - 1;
  472:       }
  473:       else {
  474:          // Search for decreasing levels
  475:          for (int kk = k; kk > 0; kk--) {
  476:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  477:          }
  478:          return 0;
  479:       }
  480:    }
  481: 
  482:    __inline__ __device__ double z_prism(int k) const { return 0.5*(z[k+1] + z[k]); }
  483:    __inline__ __device__ double Dz(int k)      const { return z[k+1] - z[k]; }
  484: 
  485:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  486: 
  487:    __inline__ __device__ double computeSignedArea(void) const;
  488: 
  489:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  490:       // Nudges the point (x,y) to the barycenter of the element
  491:       p = (1-eps)*p + eps*toVector2(center);
  492:    }
  493: 
  494:    __device__ bool computeShapeCoords(Point2 xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  495: 
  496:    __device__ Vector2 grad(double *a) const
  497:    {
  498:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  499:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  500:       if (isQuad()) {
  501:          gx += a[3]*gradPhi[3].x;
  502:          gy += a[3]*gradPhi[3].y;
  503:       }
  504:       return {gx, gy};
  505:    }
  506: 
  507:    __device__ void setFrame(void) {
  508: 
  509:       double ar1, ar2;
  510:       computeLonLat(center, ar1, ar2);
  511: 
  512:       frame.update(ar1, ar2);        
  513:     }
  514: 
  515:    __device__ bool findNextIntersection(Point2 x2, Side *&side, Element *&nextElement, double &t, 
  516:                                         double& tIntersect);
  517:    __device__ bool findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement, double &t, 
  518:                                         double& tIntersect);
  519: 
  520:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  521:       // Check if the point (xt,yt) is inside the element
  522:       double shpCoords[4];
  523:       bool res = computeShapeCoords(xt, shpCoords, false);
  524:       return res;
  525:    }
  526: 
  527:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  528:    {
  529:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  530:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  531:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  532:       
  533:    }
  534: 
  535:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int) const;
  536: 
  537:    // ------------------------------------------------------------------------------------------------
  538:    // These are functions that work on all nodes of the element.
  539:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  540:    //
  541:    // An example of how to use these functions is:
  542:    //   
  543:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  544:    // 
  545:    // Where L is the level at which the field is to be interpolated. The field can be either
  546:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  547:    // There are different versions of getNodalValues for each of these cases.
  548: 
  549:    template<typename T>
  550:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  551:       // Get the values of the field at the nodes of the element
  552:       res[0] = nodes[0]->*field;
  553:       res[1] = nodes[1]->*field;
  554:       res[2] = nodes[2]->*field;
  555:       if (isQuad()) res[3] = nodes[3]->*field;
  556:       else          res[3] = T();
  557:    }
  558: 
  559:    template<typename T>
  560:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  561:       // Get the values of the field at the nodes of the element
  562:       res[0] = (nodes[0]->*field)[level];
  563:       res[1] = (nodes[1]->*field)[level];
  564:       res[2] = (nodes[2]->*field)[level];
  565:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  566:       else          res[3] = T();
  567:    }    
  568: 
  569:    template<typename T>
  570:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  571:       // Get the values of the func at the nodes of the element
  572:       res[0] = (nodes[0]->*func)(level);
  573:       res[1] = (nodes[1]->*func)(level);
  574:       res[2] = (nodes[2]->*func)(level);
  575:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  576:       else          res[3] = T();  // This is 0.0 or a zero vector
  577: 
  578:    }      
  579: 
  580:    template<typename T>
  581:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  582:       // Get the values of the field at the nodes of the element
  583:       res[0] = sides[0]->*field;
  584:       res[1] = sides[1]->*field;
  585:       res[2] = sides[2]->*field;
  586:       if (isQuad()) res[3] = sides[3]->*field;
  587:       else          res[3] = T();
  588:    }
  589: 
  590:    template<typename T>
  591:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  592:       // Get the values of the field at the nodes of the element
  593:       res[0] = (sides[0]->*field)[level];
  594:       res[1] = (sides[1]->*field)[level];
  595:       res[2] = (sides[2]->*field)[level];
  596:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  597:       else          res[3] = T();
  598:    }    
  599: 
  600:    template<typename T>
  601:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  602:       // Get the values of the func at the nodes of the element
  603:       res[0] = (sides[0]->*func)(level);
  604:       res[1] = (sides[1]->*func)(level);
  605:       res[2] = (sides[2]->*func)(level);
  606:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  607:       else          res[3] = T();  // This is 0.0 or a zero vector
  608: 
  609:    }      
  610: 
  611: 
  612:    __device__ double interpolate(int level, const double shapeCoords[4], double (Node::*func)(int) const) const {
  613:       double values[4];
  614:       getNodalValues(level, func, values);
  615: 
  616:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  617:    }
  618: 
  619:    template<typename T>
  620:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  621:       T values[4];
  622:       getNodalValues(field, values);
  623:       
  624:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  625:    }
  626: 
  627: 
  628:    template<typename T>
  629:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  630:       T values[4];
  631:       getNodalValues(level, field, values);
  632: 
  633:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  634:    }
  635: 
  636:    template<typename T>
  637:    __device__ T mean(T Node::* field) const {
  638:       T values[4];
  639:       getNodalValues(field, values);
  640: 
  641:       return (values[0] + values[1] + values[2] + values[3])/i34;
  642:    }
  643: 
  644:    template<typename T>
  645:    __device__ T mean(T Side::* field) const {
  646:       T values[4];
  647:       getSideValues(field, values);
  648:       
  649:       return (values[0] + values[1] + values[2] + values[3])/i34;
  650:    }   
  651: 
  652:    // __device__ double mean(double (Node::*func)(int) const) const {
  653:    //    double values[4];
  654:    //    getNodalValues(level, func, values);
  655:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  656:    // }
  657:    // ------------------------------------------------------------------------------------------------
  658: 
  659:    __device__ bool globalToLocal(double xt, double yt, double &xlocal, double &ylocal) const {
  660:       // Convert global coordinates to local coordinates
  661:       printf("NOT IMPLEMENTED: globalToLocal\n");
  662:       return true;
  663:    }
  664: 
  665:    __inline__ __device__ bool localToGlobal(double xlocal, double ylocal, double &xt, double &yt) const {
  666:       // Convert local coordinates to global coordinates
  667:       printf("NOT IMPLEMENTED: localToGlobal\n");
  668:       return true;
  669:    }
  670: 
  671:    __device__ void trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
  672:                                        double &dt, Point3 &xt, double zint, Vector3 &u_int);
  673:     
  674:    __device__ bool trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
  675:                                                  Element *&nextElem, int &jlev, double &dt);
  676: 
  677: };
