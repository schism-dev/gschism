    6: constexpr int ivcor = 2; // Vertical coordinate system
    7: constexpr int ics = 1;   // 1: global, 2: local
    8: constexpr int ihh = 1;   // Option to limit \hat{H} to enhance stability for large friction in shallow area
    9: constexpr int imm = 0;   // Option to pre-compute vnorm on the element
   10: constexpr int iveg = 0;  // Vegetation option, 0: no vegetation, 1: vegetation
   11: 
   12: constexpr int nchi = 0;  // Option to compute drag coefficients chi and chi2
   13: 
   14: constexpr int nramp_elev = 0; // Option to use ramp for elevation boundary conditions
   15: 
   16: constexpr int    iloadtide = 0;       // Option to use polynomial for discharge boundary
   17: constexpr double loadtide_coef = 0.1; // Load tide coefficient
   18: 
   19: constexpr int    inv_atm_bnd = 0;     // Option to use inverse barometric effects at boundary
   20: constexpr double prmsl_ref = 101325.0; // Reference pressure for inverse barometric effects
   21: 
   22: constexpr double veg_lai = 1.0; // Vegetation drag coefficient
   23: constexpr double veg_cw = 1.5; // Vegetation drag coefficient
