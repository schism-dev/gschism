 2107: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2108:                 double *node_coords, double *wind_rotate_angle, 
 2109:                 int *isdel, int *isidenode, int *isbnd,
 2110:                 int *nond, int *nlnd, int *iond, int *ilnd,
 2111:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2112:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2113:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2114:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2115:                 int *localNodePart,     int *localElemPart,     int *localSidePart) {
 2116: 
 2117:    printf("Populating mesh for partition %d, %d, %d\n", partNum, nond, nlnd);
 2118: 
 2119:    // Horizontal grid
 2120:    printf("Processing %d nodes\n", np);    
 2121: 
 2122: 
 2123:    int idxNodeBoundary = 0;  
 2124:    for (int i = 0; i < np; i++)
 2125:    {
 2126:       Node &node = localNodeData[i];
 2127: 
 2128:       node.idx = i;
 2129: 
 2130:       const int idxNodeStart = nodeNeighNodesStart[i];
 2131:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2132:       node.numNodes = idxNodeEnd - idxNodeStart;
 2133:       node.nodes = nodeNeighNodes + idxNodeStart;
 2134:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2135: 
 2136: 
 2137: 
 2138:       const int idxElemStart = nodeNeighElemsStart[i];
 2139:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2140:       node.numElements = idxElemEnd - idxElemStart;
 2141:       node.elements = nodeNeighElems + idxElemStart;
 2142: 
 2143: 
 2144:       
 2145:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2146:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2147:          const int partNode = localNodePart[idxNodeGlobal]; 
 2148:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2149: 
 2150: 
 2151:          Node *node_ptr = nodes[partNode] + idxNode;
 2152:          
 2153:          nodeNeighNodes[idx] = node_ptr;
 2154:       }
 2155: 
 2156:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2157:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2158:          const int partElem = localElemPart[idxElemGlobal];
 2159:          const int idxElem  = localElemIndices[idxElemGlobal];
 2160: 
 2161:          Element *elem_ptr = elems[partElem] + idxElem;
 2162: 
 2163:          nodeNeighElems[idx] = elem_ptr;
 2164:       }      
 2165: 
 2166: 
 2167:       node.wind_angle = wind_rotate_angle[i];
 2168: 
 2169:       // Element **elements; // pointer to the elements connected to this node
 2170:       // int numElements;   // number of elements shared by this node
 2171: 
 2172:       node.p.x   = node_coords[i * 3];
 2173:       node.p.y   = node_coords[i * 3 + 1];
 2174:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2175:       node.depth = node_coords[i * 3 + 2];
 2176: 
 2177:       // printf("ZZ elemsPtr = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2178: 
 2179:       // Links the node to the boundary information
 2180:       if (isbnd[i] >= 0) {
 2181:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2182:          if (isbnd[i]>0) {
 2183: 
 2184:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2185:             node.nodeBnd->segment->ifltype = isbnd[i];
 2186: 
 2187:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2188:             node.nodeBnd->segment->clen  = nan("1");
 2189:             node.nodeBnd->segment->carea = nan("1");
 2190: 
 2191:          }
 2192:          else {
 2193:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2194:          }
 2195:          
 2196:          idxNodeBoundary++;
 2197:       }
 2198:       else {
 2199:          node.nodeBnd = nullptr;
 2200:       }
 2201: 
 2202: // XXXX
 2203: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2204: constexpr double rot_per = 3000.0;
 2205: constexpr double rot_f = 2.0*pi/rot_per;
 2206: for (int k = 0; k < nvrt; k++) {node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0};}
 2207: // XXXXX
 2208:    }
 2209: 
 2210:    nbp = idxNodeBoundary;
 2211: 
 2212:    printf("Processing %d sides\n", ns);
 2213:    int idxSideBoundary = 0;
 2214:    for (int i = 0; i < ns; i++)
 2215:    {
 2216:       Side &side = localSideData[i];
 2217:       side.idx = i;
 2218:       // finding the pointer to the nodes that form the side
 2219:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2220:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2221: 
 2222:       const int locidx_n1 = localNodeIndices[idx_n1];
 2223:       const int locidx_n2 = localNodeIndices[idx_n2];
 2224:       const int part_n1 =   localNodePart[idx_n1];
 2225:       const int part_n2 =   localNodePart[idx_n2];
 2226: 
 2227:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2228:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2229: 
 2230:       // Normal vector to the side
 2231:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2232:       const double norm = sqrt(dot(side.n, side.n));
 2233:       side.n = side.n/norm;
 2234: 
 2235:       // Side boundary type
 2236:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 2237:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 2238:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2239:       
 2240:       if (n1bnd != nullptr || n2bnd != nullptr) 
 2241:       {
 2242:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2243:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2244:          else                  side.sideBnd->segment = n2bnd->segment;
 2245:          side.sideBnd->side = &side;
 2246:          idxSideBoundary++;
 2247:       }
 2248:       else side.sideBnd = nullptr;
 2249: 
 2250:       // finding the pointer to the elements that share the side
 2251:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2252:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2253: 
 2254:       if (idx_e1 > -1) {
 2255:          const int locidx_e1 = localElemIndices[idx_e1];
 2256:          const int part_e1 =  localElemPart[idx_e1];
 2257:          side.elems[0] = elems[part_e1] + locidx_e1;
 2258:          // printf("s@@ part_e1 = %d, locidx_e1 = %d, elems[part_e1] = %p\n", part_e1, locidx_e1, elems[part_e1]);
 2259:          // // printf("s-- side.elems[0] = %p idx = %d i34 = %d (x,y,z) = (%f,%f,%f) size = %d\n", side.elems[0], side.elems[0]->idx, side.elems[0]->i34, side.elems[0]->center.x, side.elems[0]->center.y, side.elems[0]->center.z, sizeof(Element));
 2260:          // printf("o-- elems = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2261:       }
 2262:       else {
 2263:          side.elems[0] = nullptr;
 2264:       }
 2265: 
 2266:       if (idx_e2 > -1) {
 2267:          const int locidx_e2 = localElemIndices[idx_e2];
 2268:          const int part_e2 =  localElemPart[idx_e2];
 2269:          side.elems[1] = elems[part_e2] + locidx_e2;
 2270:       }
 2271:       else {
 2272:          side.elems[1] = nullptr;
 2273:       }
 2274: 
 2275: 
 2276: 
 2277:       // Compute the center of the side
 2278:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2279: 
 2280: // XXXX
 2281: constexpr double rot_per=3000.0;
 2282: constexpr double rot_f=2.0*pi/rot_per;
 2283: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2284: // XXXXX      
 2285: 
 2286:       // Compute the z level at the center of the side
 2287:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->znl[k] + side.n2->znl[k]);
 2288: 
 2289:       // Compute the length of the side
 2290:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2291:       side.length = sqrt(dot(vLen, vLen));
 2292: 
 2293:    }
 2294: 
 2295:    printf("Processing %d elements\n", ne);
 2296:    for (int i = 0; i < ne; i++)
 2297:    {
 2298:       Element &elem = localElemData[i];
 2299:       elem.idx = i;
 2300:       for (int j = 0; j < i34[i]; j++) {
 2301:          const int idxNode = elnode[i*4 + j];  
 2302:          const int idxSide = elside[i*4 + j];
 2303:          
 2304:          elem.nodes[j] = (Node *)&(nodes[localElemPart[idxNode]][localElemIndices[idxNode]]);
 2305:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2306: 
 2307: 
 2308: 
 2309:          // Find the neighboring element  
 2310:          if (elem.sides[j]->elems[0] == &elem) {
 2311:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2312:          }
 2313:          else {
 2314:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2315:          }
 2316:          
 2317:       }
 2318: 
 2319:       elem.i34 = i34[i];
 2320: 
 2321: // printf("elem = %p, elem.i34 = %d\n", &elem, elem.i34);
 2322: 
 2323:       // Compute the centroid of the element and its depth
 2324:       Vector2 center = {0.0, 0.0};
 2325:       elem.depth = 0.0;
 2326:       for (int j = 0; j < i34[i]; j++) {
 2327:          center += elem.nodes[j]->p2()/i34[i];
 2328:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2329:       }
 2330:       elem.center.x = center.x;
 2331:       elem.center.y = center.y;
 2332: 
 2333:       // printf("elem = %p, i34 = %d, center = (%f,%f,%f)\n", &elem, elem.i34, elem.center.x, elem.center.y, elem.depth);
 2334:       
 2335:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2336:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2337: 
 2338:       elem.area = elem.computeSignedArea(); 
 2339:       elem.radius = sqrt(elem.area)/pi; 
 2340:       
 2341:       // Determines which way the normal vector to each side is oriented.
 2342:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2343:       for (int j = 0; j < i34[i]; j++)  
 2344:       {
 2345:          if (elem.sides[j]->elems[0] == &elem) {
 2346:             elem.ssign[j] =  1.0;
 2347:          }
 2348:          else {
 2349:             elem.ssign[j] = -1.0;
 2350:          }
 2351: 
 2352:       }
 2353: 
 2354:       // Derivatives of shape functions
 2355:       //  For ics=2, this is done inside element/ll frame XXX
 2356:       //  For quads, the derivative is evaluated at centroid
 2357:       const int i34 = elem.i34;
 2358:       for (int j = 0; j < i34; j++) {
 2359:          const double area = elem.area;
 2360:          const int id2 = elem.nxq(1 + j);
 2361:          const int id3 = elem.nxq(2 + j);
 2362:          const int id4 = elem.nxq(3 + j);
 2363:          if (elem.isTri()) {
 2364:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2365:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2366:             // da1/dx = (y1 - y2)/(2*area)
 2367:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2368:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2369:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2370:          }
 2371:          else  { // Quad; evaluate at centroid
 2372:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2373:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2374:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2375:          } // if Tri
 2376: 
 2377:       } // for j
 2378: 
 2379:    }
 2380: 
 2381: 
 2382: 
 2383:    
 2384: }
