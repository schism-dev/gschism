 2231: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2232:                 double *node_coords, double *wind_rotate_angle, 
 2233:                 int *isdel, int *isidenode, int *isbnd,
 2234:                 int *nond, int *nlnd, int *iond, int *ilnd,
 2235:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2236:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2237:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2238:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2239:                 int *localNodePart,     int *localElemPart,     int *localSidePart) {
 2240: 
 2241:    printf("Populating mesh for partition %d, %d, %d\n", partNum, nond, nlnd);
 2242: 
 2243:    // Horizontal grid
 2244:    printf("Processing %d nodes\n", np);    
 2245: 
 2246: 
 2247:    int idxNodeBoundary = 0;  
 2248:    for (int i = 0; i < np; i++)
 2249:    {
 2250:       Node &node = localNodeData[i];
 2251: 
 2252:       node.idx = i;
 2253: 
 2254:       const int idxNodeStart = nodeNeighNodesStart[i];
 2255:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2256:       node.numNodes = idxNodeEnd - idxNodeStart;
 2257:       node.nodes = nodeNeighNodes + idxNodeStart;
 2258:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2259: 
 2260: 
 2261: 
 2262:       const int idxElemStart = nodeNeighElemsStart[i];
 2263:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2264:       node.numElements = idxElemEnd - idxElemStart;
 2265:       node.elements = nodeNeighElems + idxElemStart;
 2266: 
 2267: 
 2268:       
 2269:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2270:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2271:          const int partNode = localNodePart[idxNodeGlobal]; 
 2272:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2273: 
 2274: 
 2275:          Node *node_ptr = nodes[partNode] + idxNode;
 2276:          
 2277:          nodeNeighNodes[idx] = node_ptr;
 2278:       }
 2279: 
 2280:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2281:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2282:          const int partElem = localElemPart[idxElemGlobal];
 2283:          const int idxElem  = localElemIndices[idxElemGlobal];
 2284: 
 2285:          Element *elem_ptr = elems[partElem] + idxElem;
 2286: 
 2287:          nodeNeighElems[idx] = elem_ptr;
 2288:       }      
 2289: 
 2290: 
 2291:       node.wind_angle = wind_rotate_angle[i];
 2292: 
 2293:       // Element **elements; // pointer to the elements connected to this node
 2294:       // int numElements;   // number of elements shared by this node
 2295: 
 2296:       node.p.x   = node_coords[i * 3];
 2297:       node.p.y   = node_coords[i * 3 + 1];
 2298:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2299:       node.depth = node_coords[i * 3 + 2];
 2300: 
 2301:       // printf("ZZ elemsPtr = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2302: 
 2303:       // Links the node to the boundary information
 2304:       if (isbnd[i] >= 0) {
 2305:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2306:          if (isbnd[i]>0) {
 2307: 
 2308:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2309:             node.nodeBnd->segment->ifltype = isbnd[i];
 2310: 
 2311:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2312:             node.nodeBnd->segment->clen  = nan("1");
 2313:             node.nodeBnd->segment->carea = nan("1");
 2314: 
 2315:          }
 2316:          else {
 2317:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2318:          }
 2319:          
 2320:          idxNodeBoundary++;
 2321:       }
 2322:       else {
 2323:          node.nodeBnd = nullptr;
 2324:       }
 2325: 
 2326: // XXXX
 2327: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2328: constexpr double rot_per = 3000.0;
 2329: constexpr double rot_f = 2.0*pi/rot_per;
 2330: for (int k = 0; k < nvrt; k++) {node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0};}
 2331: // XXXXX
 2332:    }
 2333: 
 2334:    nbp = idxNodeBoundary;
 2335: 
 2336:    printf("Processing %d sides\n", ns);
 2337:    int idxSideBoundary = 0;
 2338:    for (int i = 0; i < ns; i++)
 2339:    {
 2340:       Side &side = localSideData[i];
 2341:       side.idx = i;
 2342:       // finding the pointer to the nodes that form the side
 2343:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2344:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2345: 
 2346:       const int locidx_n1 = localNodeIndices[idx_n1];
 2347:       const int locidx_n2 = localNodeIndices[idx_n2];
 2348:       const int part_n1 =   localNodePart[idx_n1];
 2349:       const int part_n2 =   localNodePart[idx_n2];
 2350: 
 2351:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2352:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2353: 
 2354:       // Normal vector to the side
 2355:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2356:       const double norm = sqrt(dot(side.n, side.n));
 2357:       side.n = side.n/norm;
 2358: 
 2359:       // Side boundary type
 2360:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 2361:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 2362:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2363:       
 2364:       if (n1bnd != nullptr || n2bnd != nullptr) 
 2365:       {
 2366:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2367:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2368:          else                  side.sideBnd->segment = n2bnd->segment;
 2369:          side.sideBnd->side = &side;
 2370:          idxSideBoundary++;
 2371:       }
 2372:       else side.sideBnd = nullptr;
 2373: 
 2374:       // finding the pointer to the elements that share the side
 2375:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2376:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2377: 
 2378:       if (idx_e1 > -1) {
 2379:          const int locidx_e1 = localElemIndices[idx_e1];
 2380:          const int part_e1 =  localElemPart[idx_e1];
 2381:          side.elems[0] = elems[part_e1] + locidx_e1;
 2382:          // printf("s@@ part_e1 = %d, locidx_e1 = %d, elems[part_e1] = %p\n", part_e1, locidx_e1, elems[part_e1]);
 2383:          // // printf("s-- side.elems[0] = %p idx = %d i34 = %d (x,y,z) = (%f,%f,%f) size = %d\n", side.elems[0], side.elems[0]->idx, side.elems[0]->i34, side.elems[0]->center.x, side.elems[0]->center.y, side.elems[0]->center.z, sizeof(Element));
 2384:          // printf("o-- elems = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2385:       }
 2386:       else {
 2387:          side.elems[0] = nullptr;
 2388:       }
 2389: 
 2390:       if (idx_e2 > -1) {
 2391:          const int locidx_e2 = localElemIndices[idx_e2];
 2392:          const int part_e2 =  localElemPart[idx_e2];
 2393:          side.elems[1] = elems[part_e2] + locidx_e2;
 2394:       }
 2395:       else {
 2396:          side.elems[1] = nullptr;
 2397:       }
 2398: 
 2399: 
 2400: 
 2401:       // Compute the center of the side
 2402:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2403: 
 2404: // XXXX
 2405: constexpr double rot_per=3000.0;
 2406: constexpr double rot_f=2.0*pi/rot_per;
 2407: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2408: // XXXXX      
 2409: 
 2410:       // Compute the z level at the center of the side
 2411:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->znl[k] + side.n2->znl[k]);
 2412: 
 2413:       // Compute the length of the side
 2414:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2415:       side.length = sqrt(dot(vLen, vLen));
 2416: 
 2417:    }
 2418: 
 2419:    printf("Processing %d elements\n", ne);
 2420:    for (int i = 0; i < ne; i++)
 2421:    {
 2422:       Element &elem = localElemData[i];
 2423:       elem.idx = i;
 2424:       for (int j = 0; j < i34[i]; j++) {
 2425:          const int idxNode = elnode[i*4 + j];  
 2426:          const int idxSide = elside[i*4 + j];
 2427:          
 2428:          elem.nodes[j] = (Node *)&(nodes[localElemPart[idxNode]][localElemIndices[idxNode]]);
 2429:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2430: 
 2431: 
 2432: 
 2433:          // Find the neighboring element  
 2434:          if (elem.sides[j]->elems[0] == &elem) {
 2435:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2436:          }
 2437:          else {
 2438:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2439:          }
 2440:          
 2441:       }
 2442: 
 2443:       elem.i34 = i34[i];
 2444: 
 2445: // printf("elem = %p, elem.i34 = %d\n", &elem, elem.i34);
 2446: 
 2447:       // Compute the centroid of the element and its depth
 2448:       Vector2 center = {0.0, 0.0};
 2449:       elem.depth = 0.0;
 2450:       for (int j = 0; j < i34[i]; j++) {
 2451:          center += elem.nodes[j]->p2()/i34[i];
 2452:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2453:       }
 2454:       elem.center.x = center.x;
 2455:       elem.center.y = center.y;
 2456: 
 2457:       // printf("elem = %p, i34 = %d, center = (%f,%f,%f)\n", &elem, elem.i34, elem.center.x, elem.center.y, elem.depth);
 2458:       
 2459:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2460:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2461: 
 2462:       elem.area = elem.computeSignedArea(); 
 2463:       elem.radius = sqrt(elem.area)/pi; 
 2464:       
 2465:       // Determines which way the normal vector to each side is oriented.
 2466:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2467:       for (int j = 0; j < i34[i]; j++)  
 2468:       {
 2469:          if (elem.sides[j]->elems[0] == &elem) {
 2470:             elem.ssign[j] =  1.0;
 2471:          }
 2472:          else {
 2473:             elem.ssign[j] = -1.0;
 2474:          }
 2475: 
 2476:       }
 2477: 
 2478:       // Derivatives of shape functions
 2479:       //  For ics=2, this is done inside element/ll frame XXX
 2480:       //  For quads, the derivative is evaluated at centroid
 2481:       const int i34 = elem.i34;
 2482:       for (int j = 0; j < i34; j++) {
 2483:          const double area = elem.area;
 2484:          const int id2 = elem.nxq(1 + j);
 2485:          const int id3 = elem.nxq(2 + j);
 2486:          const int id4 = elem.nxq(3 + j);
 2487:          if (elem.isTri()) {
 2488:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2489:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2490:             // da1/dx = (y1 - y2)/(2*area)
 2491:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2492:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2493:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2494:          }
 2495:          else  { // Quad; evaluate at centroid
 2496:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2497:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2498:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2499:          } // if Tri
 2500: 
 2501:       } // for j
 2502: 
 2503:    }
 2504: 
 2505: }
 2506: 
 2507: 
 2508: 
 2509: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 2510:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 2511:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 2512:    // 
 2513:    // This kernel is called for all nodes.
 2514: 
 2515: 
 2516:    NODE(node1);
 2517: 
 2518: 
 2519:    node1->clearMatrixRow();
 2520:    node1->qel = 0.0;
 2521: 
 2522:    // THIS IS FOR STRUCTURES XXX
 2523:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 2524: 
 2525:    
 2526:    for (int j=0; j<node1->numElements; j++) {
 2527:       // For each element connected to the node...
 2528: 
 2529:       Element *elem = node1->elements[j];
 2530: 
 2531:       // Compute the average gravity
 2532:       const double grav3 = elem->mean(&Node::grav2);
 2533: 
 2534:       // Look at the documentation for the description of the terms in the following integrals
 2535: 
 2536:       // Integral I_1 
 2537:       // \bar{\breve{H}} 
 2538:       const double hhatb = elem->mean(&Side::hhat);        
 2539: 
 2540:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 2541: 
 2542:       const int id1 = elem->nodeLocalIdx(node1); 
 2543:       const double area = elem->area;
 2544: 
 2545:       if (elem->isTri()) {
 2546: 
 2547:          // To clarify the notation in this section: 
 2548:          //   i standtimes for the node under consideration (node1)
 2549:          //   j (node2) and k (node3) are the other nodes of the triangle.
 2550:          const int id2 = elem->nxq(1 + id1);
 2551:          const int id3 = elem->nxq(2 + id1);
 2552:          Node *node2 = elem->nodes[id2];
 2553:          Node *node3 = elem->nodes[id3];
 2554: 
 2555:          const Point2 x1 = node1->p2();
 2556:          const Point2 x2 = node2->p2();
 2557:          const Point2 x3 = node3->p2();
 2558: 
 2559:          // integral of phi_i*phi_j
 2560:          const double ipp_ii = (1.0/6.0 )*area;
 2561:          const double ipp_ij = (1.0/12.0)*area;
 2562:          const double ipp_ik = (1.0/12.0)*area;
 2563: 
 2564:          // integral of [(grad phi_i) * (grad phi_j)]
 2565:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 2566:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 2567:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 2568: 
 2569:          // Computes the different components of integral I_1 of each node with respect to node i.
 2570:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 2571:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 2572:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 2573: 
 2574:          node1->addToSparseMatrix(node1, I1_ii);
 2575:          node1->addToSparseMatrix(node2, I1_ij); 
 2576:          node1->addToSparseMatrix(node3, I1_ik);
 2577: 
 2578:          printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 2579:      
 2580:       }
 2581:       else { // Quad
 2582:          // XXX IMPLEMENT THIS
 2583:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2584:       } 
 2585: 
 2586:  
 2587:       // Integral I_4
 2588:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 2589:       // Where
 2590:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 2591: 
 2592:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 2593:       // of U over the element.
 2594:       Vector2 Umean = {0.0, 0.0};
 2595:       for (int m=0; m<elem->i34; m++) {      
 2596:          const Side *side = elem->sides[m];
 2597: 
 2598:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 2599:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 2600:       }
 2601:       Umean = Umean/elem->i34;
 2602: 
 2603:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 2604: 
 2605:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 2606:       const double I_4_1 = dot(gradPhi_1, Umean);
 2607: 
 2608:       // Integral of \nabla\phi_i \cdot \pmb{E}
 2609:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 2610:      
 2611:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);
 2612:       
 2613: 
 2614:       // Additional terms 
 2615:       double vnorm = 0.0;
 2616:       if (imm == 2)  { // Pre-compute vnorm on the element
 2617:          Vector3 ubed;
 2618:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 2619: 
 2620:          Vector3 gradP = {0.0, 0.0, 1.0};
 2621:          for (int m=0; m < elem->i34; m++) {
 2622:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 2623:            gradP += toVector3(gradP_2D, 0.0);
 2624:          }   
 2625:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 2626:       } // imm==2
 2627: 
 2628:       if (elem->isTri()) {
 2629:          for (int l=0; l<3; l++) {
 2630:            double fac;
 2631: 
 2632:            Node *node = elem->nodes[l];
 2633: 
 2634:            (node == node1)? fac=2.0 : fac=1.0;
 2635: 
 2636:            if (imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 2637:            else        node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 2638:            
 2639:          }
 2640: 
 2641:          if (!elem->isDry) {
 2642:            const Vector2 gradEta = elem->nodes[0]->eta2*elem->gradPhi[0] +
 2643:                                    elem->nodes[1]->eta2*elem->gradPhi[1] +
 2644:                                    elem->nodes[2]->eta2*elem->gradPhi[2];
 2645: 
 2646:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 2647:          }
 2648: 
 2649:       } // isTri
 2650:       else { // isQuad
 2651:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2652:          // for (int l=0; l<4; l++) {
 2653:          //   const Node *node = elem->nodes[l];
 2654: 
 2655:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 2656:          //   else        tmp2 = node->bdef2 - node->bdef1;
 2657: 
 2658:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 2659:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 2660:          // }
 2661: 
 2662:       } // isQuad
 2663: 
 2664: 
 2665:       node1->qel += (dt/elem->i34)*elem->vsource;
 2666:       
 2667: 
 2668:    } // for all elements connected to the node
 2669:    
 2670: 
 2671: 
 2672:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 2673:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 2674:    NodeBoundary *nodeBnd = node1->nodeBnd;
 2675:    if (nodeBnd != nullptr)  { 
 2676:       // If it is an open boundary node...
 2677: 
 2678:       // At least one open bnd side, maybe two
 2679:       for (int l=0; l<2; l++) { 
 2680: 
 2681:          // Gets each of the sides sharing the node. 
 2682:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 2683: 
 2684:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 2685: 
 2686:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 2687: 
 2688: 
 2689:          if (sideBnd != nullptr) {
 2690:             // If the side is on a boundary...
 2691: 
 2692:             // Get the boundary segment
 2693:             const BoundarySegment *sideSegment = sideBnd->segment;
 2694:             const Side *side = sideBnd->side;
 2695: 
 2696:             // Integral I_3
 2697:             if (sideSegment->ifltype != 0) {
 2698:             // Natural or Flather b.c.
 2699: 
 2700:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 2701:                // especially for Flather b.c.
 2702:                double ri3 = 0.0;
 2703:                if (!side->isDry) {
 2704:                   // If the side is not dry
 2705:                   
 2706:                   // Computes the side flux of (uth, vth)
 2707:                   double Vn = 0.0;
 2708:                   for (int k = side->kb; k<nvrt-1; k++) {
 2709:                      // uth, vth in lat/lon frame if ics=2
 2710:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 2711:                      const double vn1 = dot(side->uth[k  ], side->n); // outer normal
 2712:                      const double vn2 = dot(side->uth[k+1], side->n);
 2713: 
 2714:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 2715:                   }
 2716: 
 2717:                   ri3 = 0.5*side->length*Vn;
 2718:                }
 2719: 
 2720:                if (sideSegment->ifltype == -1) { // Flather 1
 2721: 
 2722:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 2723:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 2724: 
 2725:                   const double con0 = (1.0/6.0)*side->length*sqrt(grav*side->depth()); // For coefficient matrix
 2726:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 2727:                   
 2728:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 2729:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 2730: 
 2731:                } 
 2732:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 2733:                   // Reset ri3
 2734:                   ri3 = 0.0;
 2735: 
 2736:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 2737: 
 2738:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 2739: 
 2740:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 2741:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 2742: 
 2743:                   const double con0 = (1.0/6.0)*side->length*tmp*thetai*dt;
 2744:                   node1->addToSparseMatrix(node1, con0*2.0);
 2745:                   node1->addToSparseMatrix(node2, con0);
 2746: 
 2747:                } // if Flather or Discharge
 2748: 
 2749:                node1->qel -= thetai*dt*ri3;
 2750: 
 2751:             } // I_3
 2752:           
 2753: 
 2754:             // Integral I_5
 2755:             if(!side->isDry) {
 2756: 
 2757:                const double Unbar = dot(side->U, side->n);
 2758: 
 2759:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->length*Unbar;
 2760:                
 2761:             } // I_5
 2762: 
 2763:          } // if is boundary side
 2764: 
 2765:       } // for l
 2766: 
 2767:    } // if isbnd
 2768: 
 2769: }
 2770: 
 2771: 
 2772: extern "C" {
 2773:    __global__ void backtrackAllNodes(void) {
 2774: 
 2775:       // max/min # of sub-divisions
 2776:       const int ndelt_max = max(1.0, dt/dtb_min);
 2777:       const int ndelt_min = max(1.0, dt/dtb_max); 
 2778: 
 2779:       // Removed all references to swild98 XXX
 2780:       // swild98=0.d0 !init
 2781: 
 2782:       SIDE(side);
 2783: 
 2784:       const int kb = side->kb;
 2785: 
 2786:       // Initialize btrack velocities to the actual velocities at the side 
 2787:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 2788: 
 2789: 
 2790: 
 2791:       if (side->isDry) return;
 2792: 
 2793:       // Checks that at least one element is not dry
 2794:       const Element *elem1 = side->elems[0];
 2795:       const Element *elem2 = side->elems[1];
 2796: 
 2797:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 2798:       
 2799:       // XXXXXX
 2800:       // !swild_tmp to store global coord. of the starting side
 2801:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 2802:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 2803:       // !Use sframe2 
 2804:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 2805: 
 2806: 
 2807:       for (int k = kb; k < nvrt; k++) {
 2808:       //  Initialize (xt,yt,zt), nnel and vel.
 2809:       //  For ics=2, the coordinates are in local frames
 2810:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 2811: 
 2812: 
 2813:          const int iadvf = side->iadv();  // Advection flag
 2814: 
 2815:          Point3 xt;
 2816:          if constexpr(ics==1) {
 2817:             xt = side->center3D(k); 
 2818:          }
 2819:          else // lat/lon; in side lat/lon frame
 2820:          {
 2821:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 2822:          // XXX IMPLEMENT THIS
 2823:       //          xt=0.d0
 2824:       //          yt=0.d0
 2825:       //          !centroid coord. for nudging
 2826:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 2827:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 2828:          }  // ics
 2829: 
 2830: 
 2831:          // Velocity at the side (in ll frame for ics, same vertical direction)
 2832:          // XXX IS THIS NECESSARY?
 2833:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 2834: 
 2835:          // If on land or open boundary...
 2836:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 2837:          
 2838:          const double vmag = length(toVector2(u_int));
 2839: 
 2840:          if (vmag <= velmin_btrack) {
 2841:             // No activity 
 2842: 
 2843:             side->btu[k] = side->u2[k];
 2844:             
 2845:          } else {  // do btrack
 2846: 
 2847:           
 2848:             // Compute number of sub-divisions based on local gradients 
 2849:             // XXX IS THIS NECESSARY?
 2850:             double suma = 0.0;
 2851:             int icount = 0;
 2852:             for (int ii=0; ii<2; ii++) {
 2853: 
 2854:                const Element *elem = side->elems[ii];
 2855:                  
 2856:                if (elem == nullptr) continue;
 2857: 
 2858:                icount++;
 2859: 
 2860:                // Not strictly along z; in ll frame for ics=2
 2861: 
 2862:                double utmp[4];
 2863:                double vtmp[4];
 2864:                for (int jj = 0; jj < elem->i34; jj++) {
 2865: 
 2866:                   const Node *node = elem->nodes[jj];
 2867: 
 2868:                   if constexpr(ics==1) {
 2869:                      utmp[jj] = node->u2[k].x;
 2870:                      vtmp[jj] = node->u2[k].y;  
 2871:                   } else {
 2872:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 2873:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 2874:                   }
 2875:                } // for jj
 2876: 
 2877:                const Vector2 grad_u = elem->grad(utmp); 
 2878:                const Vector2 grad_v = elem->grad(vtmp);
 2879: 
 2880:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 2881:             } // for ii
 2882: 
 2883:             assert(icount > 0 && "Impossible 77");
 2884: 
 2885:             // '4' is somewhat arbitrary
 2886:             const int ndelt = max(ndelt_min, min(ndelt_max, int(suma/icount)*4)); // >=1
 2887:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 2888:          
 2889: 
 2890:             Vector3 u_int = {0.0, 0.0, 0.0};
 2891:             side->btrack(k, dt, dtbk, u_int);
 2892: 
 2893:             printf("backtrackAllNodes: side->idx = %d, u_int = %f,%f\n", side->idx, u_int.x, u_int.y);
 2894: 
 2895:                
 2896:          } // if vmag (do backtrack)
 2897: 
 2898:       } // for j=jmin,nvrt-1
 2899: 
 2900:    }
 2901: } // extern "C"
 2902: 
 2903: template<int nc>
 2904: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 2905: 
 2906: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 2907: //
 2908: // a,b,c,r: input vectors and are not modified by this program.
 2909: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 2910: // r is the r.h.s.
 2911: // n: actual rank of the system.
 2912: // rows in u() and r();
 2913: // u: output with nc columns (transposed to rows)
 2914: // gam: a working array.
 2915: //
 2916: // NOTES:
 2917: // This is a template function that allows for different numbers of columns in the rhs vector.
 2918: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 2919: 
 2920:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 2921:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 2922: 
 2923:    double bet = b[0];
 2924:    if constexpr (nc == 1) {
 2925:       u[0] = rhs[0]/bet;
 2926:    } else {
 2927:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 2928:    }
 2929: 
 2930:    for (int j = 1; j < n; j++) {
 2931:       gam[j] = c[j-1]/bet;
 2932:       bet = b[j] - a[j]*gam[j];
 2933: 
 2934:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 2935: 
 2936:       if constexpr (nc == 1) {
 2937:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 2938:       } else {
 2939:          for (int k = 0; k < nc; k++) {
 2940:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 2941:          }
 2942:       }
 2943:    }
 2944: 
 2945:    // Back-substitution
 2946:    for (int j=n-1; j>=1; j--) {
 2947:       if constexpr (nc == 1) {
 2948:          u[j] = u[j] - gam[j+1]*u[j-1];
 2949:       } else {
 2950:          for (int k = 0; k < nc; k++) {
 2951:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 2952:          }
 2953:       }
 2954:    }
 2955: }
 2956: 
 2957: 
 2958: 
 2959: 
 2960: // Helper function that contains the core algorithm
 2961: template<typename XAccessor, typename YAccessor>
 2962: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 2963:                                     double  yp_top, double  yp_bot, 
 2964:                                     CubicSpline &spline) {
 2965:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 2966:    // 
 2967:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 2968:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 2969:    //
 2970:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 2971:    // 
 2972:    // Inputs: 
 2973:    //            n: dimension for x etc; # of data pts (>=2);
 2974:    //            getX, getY: functions to access x,y coordinates
 2975:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 2976:    //     Output: 
 2977:    //            spline (CubicSpline): spline structure with x,y,y',y''
 2978: 
 2979:    const int n = k2 - k1 + 1;
 2980:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 2981: 
 2982:    // Allocate memory for the splines
 2983:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 2984:    spline.x   = new double[n];
 2985:    spline.y   = new double[n];
 2986:    spline.yp  = new double[n];
 2987:    spline.ypp = new double[n];
 2988: 
 2989:    for (int k=k1; k<=k2; k++) {
 2990:       spline.x[k] = getX(k);
 2991:       spline.y[k] = getY(k);
 2992:    }
 2993: 
 2994:    // This is to simplify expressions later
 2995:    double *x = spline.x;
 2996:    double *y = spline.y;
 2997: 
 2998:    double *a = nullptr;
 2999:    double *b = nullptr;
 3000:    double *c = nullptr;
 3001:    double *gam = nullptr;
 3002:    double *rhs = nullptr;
 3003:    
 3004: 
 3005:       a = new double[n];   // Lower diagonal
 3006:       b = new double[n];   // Diagonal
 3007:       c = new double[n];   // Upper diagonal
 3008:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3009:       rhs = new double[n]; // Right-hand side
 3010: 
 3011:    for (int k=k1; k<=k2; k++) {
 3012:       if (k == k1) {
 3013:          // Bottom level
 3014:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3015:          b[k] = (x[k+1] - x[k])/3.0;
 3016:          c[k] = b[k]/2.0;
 3017:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3018:       } else if (k == n - 1) {
 3019:          // Top level (surface)
 3020:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3021:          b[k] = (x[k] - x[k-1])/3.0;
 3022:          a[k] = b[k]/2.0;
 3023:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3024:       } else {
 3025:          // Intermediate levels
 3026:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3027:          b[k] = (x[k+1] - x[k-1])/3.0;
 3028:          a[k] = (x[k  ] - x[k-1])/6.0;
 3029:          c[k] = (x[k+1] - x[k  ])/6.0;
 3030:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3031:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3032:       }
 3033:    }
 3034: 
 3035:    // Solve the tridiagonal system
 3036:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3037:    
 3038:    spline.yp[k1] = yp_bot;
 3039:    spline.yp[k2] = yp_top;
 3040: 
 3041:    // Compute rest of 1st derivatives using the splines
 3042:    for (int k=k1+1; k<k2; k++) {
 3043:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3044:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3045:    }
 3046:    
 3047:    delete[] a;
 3048:    delete[] b;
 3049:    delete[] c;
 3050:    delete[] gam;
 3051:    delete[] rhs;
 3052: 
 3053: }
 3054: 
 3055: // Array version
 3056: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3057:                                 double y_top, double y_bot, 
 3058:                                 CubicSpline &spline) {
 3059:    auto getX = [x] (int k) { return x[k]; };
 3060:    auto getY = [y] (int k) { return y[k]; };
 3061:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3062: }
 3063: 
 3064: // Lambda version - allows custom access patterns
 3065: template<typename XFunc, typename YFunc>
 3066: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3067:                                 double y_top, double y_bot,
 3068:                                 CubicSpline &spline) {
 3069:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3070: }
 3071: 
 3072: 
 3073: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 3074: {
 3075:    assert("Not implemented");
 3076: 
 3077:    return 0.0;
 3078: }
