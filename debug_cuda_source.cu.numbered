  916: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
  917:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
  918: }
  919: 
  920: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
  921:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
  922: }   
  923: 
  924: __device__ __inline__ double min3(double a, double b, double c) {
  925:    return min(a, min(b, c));
  926: }
  927: 
  928: __device__ __inline__ double min4(double a, double b, double c, double d) {
  929:    return min(a, min(b, min(c, d)));
  930: }
  931: 
  932: 
  933: // Helper functions for computing the local node index at a given offset from another.
  934: __device__ __inline__ int nxq(int offset, int index, int size) {
  935:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
  936:    // to the index to make it positive
  937:    assert(index + offset + 16*size >= 0);
  938:    return (index + offset + 16*size) % size;  
  939: }
  940: 
  941: __device__ __inline__ int nxq(int index, int size) {
  942:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
  943:    // to the index to make it positive
  944:    assert(index + 16*size >= 0);
  945:    return (index + 16*size) % size; 
  946: }
