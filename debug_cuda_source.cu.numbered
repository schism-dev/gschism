  785: struct Node {
  786: 
  787:    // Geometry information
  788:    int idx;        // Index of the node
  789:    Node **nodes;   // pointer to the nodes that are neighbors of this node (there is no guarantee that they are connected)
  790:    int numNodes;   // number of nodes neighbors of this node
  791: 
  792:    Element **elements; // pointer to the elements that share this node
  793:    int numElements;   // number of elements that share this node
  794: 
  795:    Point3 p;
  796:    Vector3 u2[nvrt];
  797:    double znl[nvrt];
  798:    double lon, lat;
  799:    double depth;
  800: 
  801:    int kb;       // Bottom index of the node
  802: 
  803:    int idry;     // True if the node is dry
  804: 
  805:    int iadv;     // Advection flag
  806: 
  807:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
  808: 
  809:    // Physical information
  810:    Tracers tr_nd0[nvrt]; // Initial tracer conc. at nodes
  811: 
  812:    double rho[nvrt];     // Density
  813: 
  814:    double eta1; // Elevation at nodes at previous timestep
  815:    double eta2; // Elevation at nodes at current timestep
  816: 
  817:    double etp;  // Earth Tidal Potential
  818: 
  819:    
  820:    double pr;    // Air pressure
  821:    double grav2; // Gravity 
  822:    
  823:    Vector2 dav;  // Depth averaged velocity
  824: 
  825:    Vector2 tau; // Wind stress vector
  826: 
  827:    // Vegetation parameters
  828:    double veg_h;
  829:    double veg_nv;
  830:    double veg_di;
  831:    double veg_Cd;
  832:    double veg_h_unbent;
  833:    double veg_di_unbent;
  834:    double veg_nv_unbent;
  835:    double veg_alpha_vert_mean;
  836:    double veg_alpha0;
  837:    double veg_alpha3D[nvrt];
  838: 
  839:    // Bottom drag parameters
  840:    double Cd;       // Bottom drag coefficient
  841:    double rough;    // Bottom roughness length
  842:    Vector2 tau_bot; // Bottom stress vector
  843: 
  844:    double bdef1; // Bottom deformation at previous timestep
  845:    double bdef2; // Bottom deformation at current timestep
  846: 
  847:    double qel; // RHS
  848: 
  849:    __host__ __device__ Point2 p2(void) const { return {p.x, p.y}; }
  850: 
  851:    __host__ __device__ double sigmaTransitionDepth(void) const;
  852: 
  853:    __inline__ __device__ double Dz(int k) const { return znl[k] - znl[k-1]; }
  854:    __inline__ __device__ double htot(void) const { return eta2 + depth; }
  855:    __inline__ __device__ double zTopCanopy(void) const { return znl[kb] + veg_h; } 
  856: 
  857:    __device__ void clearMatrixRow(void) {
  858:       // Clear the matrix row for this node
  859:       printf("NOT IMPLEMENTED: clearMatrixRow\n");
  860:    }
  861: 
  862:    __device__ void addToSparseMatrix(Node const *node, double value) {
  863:       // Add the value to the sparse matrix for this node
  864:       printf("NOT IMPLEMENTED: addToSparseMatrix\n");
  865:    }
  866: 
  867: #ifdef BACKTRACKING
  868:    __device__ void updateZCoordData() {
  869:    // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
  870: 
  871:       // Check if node is wet
  872:       idry = (depth + eta2 <= h0);  // XXX Check if we are doing this elsewhere
  873: 
  874:       if (idry) return;
  875: 
  876:       if constexpr(ivcor == 2) {  // SZ coordinates
  877:          
  878:          // Compute bottom level index
  879:          if (depth <= mesh->h_s) {
  880:                kb = mesh->nzlevels;
  881:          } else {
  882:                kb = -1;
  883:                for (int i = 0; i < mesh->kz-1; i++) {
  884:                   if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
  885:                      kb = i;
  886:                      break;
  887:                   }
  888:                }
  889:          }
  890:       } 
  891:       else if (ivcor == 1) {  // Localized sigma
  892:          // Do nothing
  893:       }
  894: 
  895:    }
  896: #endif   
  897: 
  898:    __device__ double compZCoord(int k) const;
  899: 
  900: 
  901: 
  902: };
