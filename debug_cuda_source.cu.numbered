 2133: 
 2134: __host__ __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2135: 
 2136: __device__ double Node::compZCoord(int k) const {
 2137:    // Computes the z coordinate at level k.
 2138:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2139:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2140:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2141:    // used 
 2142:    
 2143:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2144:       
 2145:    if (isDry)  return 0.0;
 2146: 
 2147:    if constexpr(ivcor == 2) {
 2148: 
 2149:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2150:       const int kz = mesh->kz;
 2151: 
 2152:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2153:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2154:       // once per time step/node.
 2155:       // CHECK: updateZCoordData
 2156:       if (k == kz)               return -hmod2;
 2157:       else if (k == nvrt-1)      return eta2;
 2158:       else if (k == kb)          return -depth;
 2159:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2160:       else if (k > kz) {
 2161:          const int ksig = k - kz + 1;
 2162: 
 2163:          if (hmod2 <= mesh->h_c) {
 2164:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2165:          } 
 2166:          else if (eta2 <= - mesh->h_c - (depth - mesh->h_c) * mesh->theta_f/mesh->sinh_theta_f) {
 2167:             printf("Please choose larger h_c: %f %f\n", eta2, mesh->h_c);
 2168:             Error("ZCOOR: invalid h_c\n");
 2169:          } 
 2170:          else {
 2171:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2172:                          mesh->h_c * mesh->sigma[ksig] + 
 2173:                          (hmod2 - mesh->h_c) * mesh->cs[ksig];
 2174:          }
 2175:       } else { 
 2176:          Error("ZCOOR: invalid level or coordinate system\n");
 2177:       }
 2178: 
 2179:    }
 2180:    else if constexpr(ivcor == 1) {
 2181:       if (k == kb) return -depth;
 2182:       else if (k == nvrt-1) return eta2;
 2183:       else if (k >= kb) {
 2184:             return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2185:       }
 2186:    }
 2187:    
 2188:    printf("ZCOOR: invalid level or coordinate system\n");
 2189:    return 0.0;
 2190: }
 2191: 
