  446: struct Element {
  447: 
  448:    // Geometry information
  449:    int idx;               // Index of the element
  450:    int i34;               // Number of sides for the element 
  451:    Side *sides[4];        // Sides of the element
  452:    Node *nodes[4];        // Nodes of the element
  453:    Element *nghbElems[4]; // Neighbors of the element
  454: 
  455:    int kb;                    // Bottom index of the element
  456:    double area;               // Area of the element
  457:    double ssign[4];           // Sign associated with each side of an element
  458:    double radius;             // Element equivalent radii
  459: 
  460:    Frame frame;
  461: 
  462:    Vector2 gradPhi[4];       // Derivatives of shape functions
  463:    Vector2 gradEta[nvrt];    // Gradient of free surface elevation
  464: 
  465:    bool isDry;                  // True if the element is dry
  466:    int kbe;                   // Bottom index of the element
  467: 
  468:    Vector3 center;            // Element center coordinates
  469:    double xlon_el, ylat_el;   // Element center lat/lon coordinates in _degrees_
  470:    double depth;              // Depth at element (min of all nodes)
  471:    double z[nvrt];            // z-coord  (local frame - vertical up)
  472: 
  473:    // Physical information
  474:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  475: 
  476:    static const bool isblock = false;              // Always false
  477: 
  478:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  479:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  480: 
  481:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  482: 
  483:    
  484: 
  485:    double vsource;            // Volumetric source/sink term [m^3/s]
  486: 
  487:    double rho[nvrt];          // Density at each prism center
  488:    double rho_mean[nvrt];     // Mean density at each prism center
  489:    CubicSpline rho_spl;
  490:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  491:    double rho_z[nvrt];        // First derivative of density at each prism center
  492:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  493: 
  494:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  495: 
  496:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  497:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  498: 
  499:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 1; }
  500:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 1; }
  501: 
  502:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  503:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  504:       // Find the local index of the node in the element (0,1,2,3)
  505:       int res = __ffs((nodes[0] == node) | 
  506:                      ((nodes[1] == node) << 1) | 
  507:                      ((nodes[2] == node) << 2) | 
  508:                      ((nodes[3] == node) << 3)) - 1;
  509:       
  510:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  511:       return res;
  512:    }
  513: 
  514:    __inline__ __device__ int findLevel(double z1, int k) const {
  515:       // Starting at index k, find sequentially the level that contains z
  516: 
  517:       // if z is already betweeen z[k] and z[k+1], return k
  518:       if (z1 >= z[k] && z1 < z[k+1]) return k;
  519:       else if (z1 < z[k]) { 
  520:          // Search for increasing levels
  521:          for (int kk = k; kk < nvrt - 1; kk++) {
  522:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  523:          }
  524:          return nvrt - 1;
  525:       }
  526:       else {
  527:          // Search for decreasing levels
  528:          for (int kk = k; kk > 0; kk--) {
  529:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  530:          }
  531:          return 0;
  532:       }
  533:    }
  534: 
  535:    __inline__ __device__ double z_prism(int k) const { return 0.5*(z[k+1] + z[k]); }
  536:    __inline__ __device__ double Dz(int k)      const { return z[k+1] - z[k]; }
  537: 
  538:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  539: 
  540:    __inline__ __device__ double computeSignedArea(void) const;
  541: 
  542:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  543:       // Nudges the point (x,y) to the barycenter of the element
  544:       p = (1-eps)*p + eps*toVector2(center);
  545:    }
  546: 
  547:    __device__ bool computeShapeCoords(Point2 xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  548: 
  549:    __device__ Vector2 grad(double *a) const
  550:    {
  551:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  552:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  553:       if (isQuad()) {
  554:          gx += a[3]*gradPhi[3].x;
  555:          gy += a[3]*gradPhi[3].y;
  556:       }
  557:       return {gx, gy};
  558:    }
  559: 
  560:    __device__ void setFrame(void) {
  561: 
  562:       double ar1, ar2;
  563:       computeLonLat(center, ar1, ar2);
  564: 
  565:       frame.update(ar1, ar2);        
  566:     }
  567: 
  568:    __device__ bool findNextIntersection(Point2 x2, Side *&side, Element *&nextElement, double &t, 
  569:                                         double& tIntersect);
  570:    __device__ bool findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement, double &t, 
  571:                                         double& tIntersect);
  572: 
  573:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  574:       // Check if the point (xt,yt) is inside the element
  575:       double shpCoords[4];
  576:       bool res = computeShapeCoords(xt, shpCoords, false);
  577:       return res;
  578:    }
  579: 
  580:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  581:    {
  582:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  583:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  584:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  585:       
  586:    }
  587: 
  588:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int) const;
  589: 
  590:    // ------------------------------------------------------------------------------------------------
  591:    // These are functions that work on all nodes of the element.
  592:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  593:    //
  594:    // An example of how to use these functions is:
  595:    //   
  596:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  597:    // 
  598:    // Where L is the level at which the field is to be interpolated. The field can be either
  599:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  600:    // There are different versions of getNodalValues for each of these cases.
  601: 
  602:    template<typename T>
  603:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  604:       // Get the values of the field at the nodes of the element
  605:       res[0] = nodes[0]->*field;
  606:       res[1] = nodes[1]->*field;
  607:       res[2] = nodes[2]->*field;
  608:       if (isQuad()) res[3] = nodes[3]->*field;
  609:       else          res[3] = T();
  610:    }
  611: 
  612:    template<typename T>
  613:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  614:       // Get the values of the field at the nodes of the element
  615:       res[0] = (nodes[0]->*field)[level];
  616:       res[1] = (nodes[1]->*field)[level];
  617:       res[2] = (nodes[2]->*field)[level];
  618:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  619:       else          res[3] = T();
  620:    }    
  621: 
  622:    template<typename T>
  623:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  624:       // Get the values of the func at the nodes of the element
  625:       res[0] = (nodes[0]->*func)(level);
  626:       res[1] = (nodes[1]->*func)(level);
  627:       res[2] = (nodes[2]->*func)(level);
  628:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  629:       else          res[3] = T();  // This is 0.0 or a zero vector
  630: 
  631:    }      
  632: 
  633:    template<typename T>
  634:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  635:       // Get the values of the field at the nodes of the element
  636:       res[0] = sides[0]->*field;
  637:       res[1] = sides[1]->*field;
  638:       res[2] = sides[2]->*field;
  639:       if (isQuad()) res[3] = sides[3]->*field;
  640:       else          res[3] = T();
  641:    }
  642: 
  643:    template<typename T>
  644:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  645:       // Get the values of the field at the nodes of the element
  646:       res[0] = (sides[0]->*field)[level];
  647:       res[1] = (sides[1]->*field)[level];
  648:       res[2] = (sides[2]->*field)[level];
  649:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  650:       else          res[3] = T();
  651:    }    
  652: 
  653:    template<typename T>
  654:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  655:       // Get the values of the func at the nodes of the element
  656:       res[0] = (sides[0]->*func)(level);
  657:       res[1] = (sides[1]->*func)(level);
  658:       res[2] = (sides[2]->*func)(level);
  659:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  660:       else          res[3] = T();  // This is 0.0 or a zero vector
  661: 
  662:    }      
  663: 
  664: 
  665:    __device__ double interpolate(int level, const double shapeCoords[4], double (Node::*func)(int) const) const {
  666:       double values[4];
  667:       getNodalValues(level, func, values);
  668: 
  669:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  670:    }
  671: 
  672:    template<typename T>
  673:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  674:       T values[4];
  675:       getNodalValues(field, values);
  676:       
  677:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  678:    }
  679: 
  680: 
  681:    template<typename T>
  682:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  683:       T values[4];
  684:       getNodalValues(level, field, values);
  685: 
  686:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  687:    }
  688: 
  689:    template<typename T>
  690:    __device__ T mean(T Node::* field) const {
  691:       T values[4];
  692:       getNodalValues(field, values);
  693: 
  694:       return (values[0] + values[1] + values[2] + values[3])/i34;
  695:    }
  696: 
  697:    template<typename T>
  698:    __device__ T mean(T Side::* field) const {
  699:       T values[4];
  700:       getSideValues(field, values);
  701:       
  702:       return (values[0] + values[1] + values[2] + values[3])/i34;
  703:    }   
  704: 
  705:    // __device__ double mean(double (Node::*func)(int) const) const {
  706:    //    double values[4];
  707:    //    getNodalValues(level, func, values);
  708:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  709:    // }
  710:    // ------------------------------------------------------------------------------------------------
  711: 
  712:    __device__ bool globalToLocal(double xt, double yt, double &xlocal, double &ylocal) const {
  713:       // Convert global coordinates to local coordinates
  714:       printf("NOT IMPLEMENTED: globalToLocal\n");
  715:       return true;
  716:    }
  717: 
  718:    __inline__ __device__ bool localToGlobal(double xlocal, double ylocal, double &xt, double &yt) const {
  719:       // Convert local coordinates to global coordinates
  720:       printf("NOT IMPLEMENTED: localToGlobal\n");
  721:       return true;
  722:    }
  723: 
  724:    __device__ void trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
  725:                                        double &dt, Point3 &xt, double zint, Vector3 &u_int);
  726:     
  727:    __device__ bool trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
  728:                                                  Element *&nextElem, int &jlev, double &dt);
  729: 
  730: };
