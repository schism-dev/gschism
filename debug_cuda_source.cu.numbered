   56: // VECTOR/POINT operations ---------------------------------------------------------------------------
   57: 
   58: using Vector2 = double2; 
   59: using Vector3 = double3;
   60: using Point2  = double2;
   61: using Point3  = double3;
   62: 
   63: __device__ __host__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
   64:     return make_double2(a.x + b.x, a.y + b.y);
   65: }
   66: 
   67: __device__ __host__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
   68:     a.x += b.x;
   69:     a.y += b.y;
   70:     return a;
   71: }
   72: 
   73: __device__ __host__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
   74:     return make_double2(a.x - b.x, a.y - b.y);
   75: }
   76: 
   77: __device__ __host__ __forceinline__ double2 operator*(const double2& v, double s) {
   78:     return make_double2(v.x * s, v.y * s);
   79: }
   80: 
   81: __device__ __host__ __forceinline__ double2 operator*(double s, const double2& v) {
   82:     return v * s;  // reuse the previous operator
   83: }
   84: 
   85: __device__ __host__ __forceinline__ double2 operator/(const double2& v, double s) {
   86:     return make_double2(v.x / s, v.y / s);
   87: }
   88: 
   89: __device__ __host__ __forceinline__ double length(const double2& v) {
   90:     return sqrt(v.x*v.x + v.y*v.y);
   91: }
   92: 
   93: __device__ __host__ __forceinline__ double dot(const double2& v, const double2& w) {
   94:     return v.x*w.x + v.y*w.y;
   95: }
   96: 
   97: __device__ __host__ __forceinline__ double cross(const double2& v, const double2& w) {
   98:     return v.x*w.y - v.y*w.x;
   99: }
  100: 
  101: __device__ __host__ __forceinline__ double3 operator+(const double3& a, const double3& b) {
  102:     return make_double3(a.x + b.x, a.y + b.y, a.z + b.z);
  103: }
  104: 
  105: __device__ __host__ __forceinline__ double3 operator+=(double3& a, const double3& b) {
  106:     a.x += b.x;
  107:     a.y += b.y;
  108:     a.z += b.z;
  109:     return a;
  110: }
  111: 
  112: __device__ __host__ __forceinline__ double3 operator-(const double3& a, const double3& b) {
  113:     return make_double3(a.x - b.x, a.y - b.y, a.z - b.z);
  114: }
  115: 
  116: __device__ __host__ __forceinline__ double3 operator*(const double3& v, double s) {
  117:     return make_double3(v.x * s, v.y * s, v.z * s);
  118: }
  119: 
  120: __device__ __host__ __forceinline__ double3 operator*(double s, const double3& v) {
  121:     return v * s;
  122: }
  123: 
  124: __device__ __host__ __forceinline__ double3 operator/(const double3& v, double s) {
  125:     return make_double3(v.x / s, v.y / s, v.z / s);
  126: }
  127: 
  128: __device__ __host__ __forceinline__ double dot(const double3& v, const double3& w) {
  129:     return v.x*w.x + v.y*w.y + v.z*w.z;
  130: }
  131: 
  132: __device__ __host__ __forceinline__ Vector2 toVector2(const double3& v) {
  133:     return make_double2(v.x, v.y);
  134: }
  135: 
  136: __device__ __host__ __forceinline__ double3 toVector3(const double2& v, double w) {
  137:     return make_double3(v.x, v.y, w);
  138: }
  139: 
  140: __device__ __host__ __forceinline__ Point2 toPoint2(const double3& p) {
  141:     return make_double2(p.x, p.y);
  142: }
  143: 
  144: __device__ __host__ __forceinline__ Point3 toPoint3(const double2& p, double z) {
  145:     return make_double3(p.x, p.y, z);
  146: }
