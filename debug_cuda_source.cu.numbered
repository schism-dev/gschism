  156: // VECTOR/POINT operations ---------------------------------------------------------------------------
  157: 
  158: using Vector2 = double2; 
  159: using Vector3 = double3;
  160: using Point2  = double2;
  161: using Point3  = double3;
  162: 
  163: __device__ __host__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
  164:     return make_double2(a.x + b.x, a.y + b.y);
  165: }
  166: 
  167: __device__ __host__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
  168:     a.x += b.x;
  169:     a.y += b.y;
  170:     return a;
  171: }
  172: 
  173: __device__ __host__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
  174:     return make_double2(a.x - b.x, a.y - b.y);
  175: }
  176: 
  177: __device__ __host__ __forceinline__ double2 operator-=(double2& a, const double2& b) {
  178:     a.x -= b.x;
  179:     a.y -= b.y;
  180:     return a;
  181: }
  182: 
  183: __device__ __host__ __forceinline__ double2 operator*(const double2& v, const double s) {
  184:     return make_double2(v.x * s, v.y * s);
  185: }
  186: 
  187: __device__ __host__ __forceinline__ double2 operator*(const double s, const double2& v) {
  188:     return v * s;  // reuse the previous operator
  189: }
  190: 
  191: __device__ __host__ __forceinline__ double2 operator/(const double2& v, double s) {
  192:     return make_double2(v.x / s, v.y / s);
  193: }
  194: 
  195: __device__ __host__ __forceinline__ double length(const double2& v) {
  196:     return sqrt(v.x*v.x + v.y*v.y);
  197: }
  198: 
  199: __device__ __host__ __forceinline__ double dot(const double2& v, const double2& w) {
  200:     return v.x*w.x + v.y*w.y;
  201: }
  202: 
  203: __device__ __host__ __forceinline__ double cross(const double2& v, const double2& w) {
  204:     return v.x*w.y - v.y*w.x;
  205: }
  206: 
  207: __device__ __host__ __forceinline__ double3 operator+(const double3& a, const double3& b) {
  208:     return make_double3(a.x + b.x, a.y + b.y, a.z + b.z);
  209: }
  210: 
  211: __device__ __host__ __forceinline__ double3 operator+=(double3& a, const double3& b) {
  212:     a.x += b.x;
  213:     a.y += b.y;
  214:     a.z += b.z;
  215:     return a;
  216: }
  217: 
  218: __device__ __host__ __forceinline__ double3 operator-(const double3& a, const double3& b) {
  219:     return make_double3(a.x - b.x, a.y - b.y, a.z - b.z);
  220: }
  221: 
  222: __device__ __host__ __forceinline__ double3 operator*(const double3& v, double s) {
  223:     return make_double3(v.x * s, v.y * s, v.z * s);
  224: }
  225: 
  226: __device__ __host__ __forceinline__ double3 operator*(double s, const double3& v) {
  227:     return v * s;
  228: }
  229: 
  230: __device__ __host__ __forceinline__ double3 operator/(const double3& v, double s) {
  231:     return make_double3(v.x / s, v.y / s, v.z / s);
  232: }
  233: 
  234: __device__ __host__ __forceinline__ double dot(const double3& v, const double3& w) {
  235:     return v.x*w.x + v.y*w.y + v.z*w.z;
  236: }
  237: 
  238: __device__ __host__ __forceinline__ Vector2 toVector2(const double3& v) {
  239:     return make_double2(v.x, v.y);
  240: }
  241: 
  242: __device__ __host__ __forceinline__ double3 toVector3(const double2& v, double w) {
  243:     return make_double3(v.x, v.y, w);
  244: }
  245: 
  246: __device__ __host__ __forceinline__ Point2 toPoint2(const double3& p) {
  247:     return make_double2(p.x, p.y);
  248: }
  249: 
  250: __device__ __host__ __forceinline__ Point3 toPoint3(const double2& p, double z) {
  251:     return make_double3(p.x, p.y, z);
  252: }
