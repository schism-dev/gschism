 3420:    __global__ void computeElevationBoundaryConditions(double time) {
 3421:       // Compute elevation essential boundary conditions 
 3422: 
 3423:       NODE_BND(nodeBnd); // Each boundary node.
 3424: 
 3425:       const Node *node = nodeBnd->node;
 3426:       const int iettype = nodeBnd->iettype;
 3427: 
 3428:       double eic = 0.0;
 3429:       if (nramp_elev==1) eic = nodeBnd->etaic;
 3430:       else               eic = 0.0;
 3431: 
 3432:       const double r_eic = (1.0 - ramp)*eic; 
 3433:       const double r_eth = ramp*nodeBnd->eth;
 3434:       double eta1_bar = r_eic;
 3435: 
 3436:       // Compute tide elevation
 3437:       if (iettype == 3 || iettype == 5) {
 3438:         
 3439:          // XXX IMPLEMENT TIDE THINGS
 3440:          assert(false && "Tide elevation not implemented");
 3441:          // for (int jfr=0; jfr<nbfr; jfr++) { // For all tide frequencies
 3442:          //    const int ncyc = int(amig[jfr]*time/(2.0*pi));
 3443:          //    const double arg = amig[jfr]*time - 2.0*pi*ncyc + face[jfr] - efa[i,j,jfr];
 3444:          //    eta1_bar += ramp*ff[jfr]*emo[i,j,jfr]*cos(arg);
 3445:          // } // for jfr
 3446:       } // if iettype
 3447: 
 3448:       switch (iettype) {
 3449:          case 1:
 3450:          case 2:
 3451:             nodeBnd->elbc = r_eth + r_eic;
 3452:             break;
 3453:          case 3:
 3454:             nodeBnd->elbc = eta1_bar + r_eic;
 3455:             break;
 3456:          case 4:
 3457:             nodeBnd->elbc = r_eth + r_eic;
 3458:             break;
 3459:          case 5:
 3460:             nodeBnd->elbc = r_eth + eta1_bar + r_eic;
 3461:             break;
 3462:       } // switch
 3463: 
 3464: 
 3465:       //Add inverse barometric effects
 3466:       if (iettype != 0 && inv_atm_bnd == 1) {
 3467:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 3468:       }
 3469: 
 3470:    }
 3471: 
 3472: 
 3473:    __global__ void setEssentialBC(void) {
 3474:       // Set essential boundary conditions 
 3475:       NODE(node); // Each boundary node
 3476:       NodeBoundary *nodeBnd = node->nodeBnd;
 3477: printf("node idx = %d, nodeBnd = %p, essentialBC = %d\n", node->idx, nodeBnd, nodeBnd ? nodeBnd->isEssentialBC : -1);
 3478:       
 3479: // nodeBnd->isEssentialBC = true;      
 3480:       // Check if this node has essential BC
 3481:       if (nodeBnd && nodeBnd->isEssentialBC) {
 3482:          // Verify BC value is valid
 3483:          assert(nodeBnd->bcValue >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 3484: 
 3485:          printf("XX node IDX = %d, nodeBnd->isEssentialBC = %d\n", node->idx, nodeBnd->isEssentialBC);
 3486:          
 3487:          // Set diagonal to 1 and zero off-diagonals
 3488:          node->coeffDiag = 1.0;
 3489:          printf("ZZZZZZZ node->coeffDiag = %16.9f\n", node->coeffDiag);
 3490: 
 3491:          for (int j = 0; j < node->numNodes; j++) {
 3492:                node->coeffMatrix[j] = 0.0;
 3493:                printf("YY node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 3494:          }
 3495:          
 3496:          // Set solution and RHS to BC value
 3497:          node->mX  = nodeBnd->bcValue;
 3498:          node->qel = nodeBnd->bcValue;
 3499:       } else {
 3500:          // Not an essential BC node
 3501:          // Modify RHS for neighbors with essential BCs
 3502:          for (int j = 0; j < node->numNodes; j++) {
 3503:                Node* nbNode = node->nodes[j];
 3504:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 3505:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 3506:                   // Verify neighbor's BC value
 3507:                   assert(nbNodeBnd->bcValue >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 3508: 
 3509:                   // Subtract contribution to RHS
 3510:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->bcValue;
 3511:                   node->coeffMatrix[j] = 0.0;  
 3512:                   printf("ZZ node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 3513:                }
 3514:          }
 3515:       }
 3516:    }
 3517: 
 3518: 
 3519:    __global__ void computeVerticallyIntegratedVelocity(void) {
 3520: 
 3521:       SIDE(side);
 3522: 
 3523: 
 3524:       side->U = {0.0, 0.0}; 
 3525:          
 3526:       if(side->isDry) return;
 3527: 
 3528:       const Node *node1 = side->n1;
 3529:       const Node *node2 = side->n2;
 3530: 
 3531:       // Vertically integrated velocity U (in ll if ics=2)
 3532:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 3533:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 3534:       }
 3535: 
 3536:    }
