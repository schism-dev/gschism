 2059: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2060:                 double *node_coords, double *wind_rotate_angle, 
 2061:                 int *isdel, int *isidenode, int *isbnd,
 2062:                 int *nond, int *nlnd, int *iond, int *ilnd,
 2063:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2064:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2065:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2066:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2067:                 int *localNodePart,     int *localElemPart,     int *localSidePart) {
 2068: 
 2069:    printf("Populating mesh for partition %d, %d, %d\n", partNum, nond, nlnd);
 2070:    printf("DDDD\n");printf("DDDD\n");printf("DDDD\n");printf("DDDD\n");printf("DDDD\n");printf("DDDD\n");printf("DDDD\n");
 2071: 
 2072:    printf("XXX elemsPtr = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2073: 
 2074:    // Horizontal grid
 2075:    printf("Processing %d nodes\n", np);    
 2076: 
 2077: 
 2078:    int idxNodeBoundary = 0;  
 2079:    for (int i = 0; i < np; i++)
 2080:    {
 2081:       Node &node = localNodeData[i];
 2082: 
 2083:       const int idxStart = nodeNeighNodesStart[i];
 2084:       const int idxEnd   = nodeNeighNodesStart[i+1];
 2085:       node.numNodes = idxEnd - idxStart;
 2086:       node.nodes = (Node **)(nodeNeighNodes + idxStart*sizeof(Node *));
 2087:       node.idx = i;
 2088: 
 2089:       
 2090:       // for (int idx = idxStart; idx < idxEnd; idx++) {
 2091:       //    int idxNode = nodeNeighNodesIndices[idx];
 2092: 
 2093:       //    Node *node_ptr = nodes[localNodePart[idxNode]];
 2094:       //    // printf("idx = %d, idxNode = %d, nodes = %p, localNodePart[idxNode] = %d, localNodeIndices[idxNode] = %d\n", idx, idxNode, nodes, localNodePart[idxNode], localNodeIndices[idxNode]);
 2095:       //    // printf("nodeNeighNodes[idxNode] = %d, (nodes[%d][%d]) = %p\n", nodeNeighNodes[idxNode], localNodePart[idxNode], localNodeIndices[idxNode], nodes + idxNode);
 2096: 
 2097:       //    nodeNeighNodes[idxNode] = node_ptr;
 2098:       // }
 2099:       // node.nodes = nodeNeighNodes + idxStart;
 2100: 
 2101:       // node.wind_angle = wind_rotate_angle[i];
 2102: 
 2103:       // Element **elements; // pointer to the elements connected to this node
 2104:       // int numElements;   // number of elements shared by this node
 2105: 
 2106:       node.p.x   = node_coords[i * 3];
 2107:       node.p.y   = node_coords[i * 3 + 1];
 2108:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2109:       node.depth = node_coords[i * 3 + 2];
 2110: 
 2111:       // printf("ZZ elemsPtr = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2112: 
 2113:       // Links the node to the boundary information
 2114:       if (isbnd[i] >= 0) {
 2115:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2116:          if (isbnd[i]>0) {
 2117: 
 2118:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2119:             node.nodeBnd->segment->ifltype = isbnd[i];
 2120: 
 2121:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2122:             node.nodeBnd->segment->clen  = nan("1");
 2123:             node.nodeBnd->segment->carea = nan("1");
 2124: 
 2125:          }
 2126:          else {
 2127:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2128:          }
 2129:          
 2130:          idxNodeBoundary++;
 2131:       }
 2132:       else {
 2133:          node.nodeBnd = nullptr;
 2134:       }
 2135: 
 2136: // XXXX
 2137: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2138: constexpr double rot_per = 3000.0;
 2139: constexpr double rot_f = 2.0*pi/rot_per;
 2140: for (int k = 0; k < nvrt; k++) {node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0};}
 2141: // XXXXX
 2142:    }
 2143: 
 2144:    nbp = idxNodeBoundary;
 2145: 
 2146:    printf("YY elemsPtr = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2147:    printf("Processing %d sides\n", ns);
 2148:    int idxSideBoundary = 0;
 2149:    for (int i = 0; i < ns; i++)
 2150:    {
 2151:       Side &side = localSideData[i];
 2152:       side.idx = i;
 2153:       // finding the pointer to the nodes that form the side
 2154:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2155:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2156: 
 2157:       const int locidx_n1 = localNodeIndices[idx_n1];
 2158:       const int locidx_n2 = localNodeIndices[idx_n2];
 2159:       const int part_n1 =   localNodePart[idx_n1];
 2160:       const int part_n2 =   localNodePart[idx_n2];
 2161: 
 2162:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2163:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2164: 
 2165:       // Normal vector to the side
 2166:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2167:       const double norm = sqrt(dot(side.n, side.n));
 2168:       side.n = side.n/norm;
 2169: 
 2170:       // Side boundary type
 2171:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 2172:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 2173:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2174:       
 2175:       if (n1bnd != nullptr || n2bnd != nullptr) 
 2176:       {
 2177:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2178:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2179:          else                  side.sideBnd->segment = n2bnd->segment;
 2180:          side.sideBnd->side = &side;
 2181:          idxSideBoundary++;
 2182:       }
 2183:       else side.sideBnd = nullptr;
 2184: 
 2185:       // finding the pointer to the elements that share the side
 2186:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2187:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2188: 
 2189:       if (idx_e1 > -1) {
 2190:          const int locidx_e1 = localElemIndices[idx_e1];
 2191:          const int part_e1 =  localElemPart[idx_e1];
 2192:          side.elems[0] = elems[part_e1] + locidx_e1;
 2193:          // printf("s@@ part_e1 = %d, locidx_e1 = %d, elems[part_e1] = %p\n", part_e1, locidx_e1, elems[part_e1]);
 2194:          // // printf("s-- side.elems[0] = %p idx = %d i34 = %d (x,y,z) = (%f,%f,%f) size = %d\n", side.elems[0], side.elems[0]->idx, side.elems[0]->i34, side.elems[0]->center.x, side.elems[0]->center.y, side.elems[0]->center.z, sizeof(Element));
 2195:          // printf("o-- elems = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2196:       }
 2197:       else {
 2198:          side.elems[0] = nullptr;
 2199:       }
 2200: 
 2201:       if (idx_e2 > -1) {
 2202:          const int locidx_e2 = localElemIndices[idx_e2];
 2203:          const int part_e2 =  localElemPart[idx_e2];
 2204:          side.elems[1] = elems[part_e2] + locidx_e2;
 2205:       }
 2206:       else {
 2207:          side.elems[1] = nullptr;
 2208:       }
 2209: 
 2210: 
 2211: 
 2212:       // Compute the center of the side
 2213:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2214: 
 2215: // XXXX
 2216: constexpr double rot_per=3000.0;
 2217: constexpr double rot_f=2.0*pi/rot_per;
 2218: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2219: // XXXXX      
 2220: 
 2221:       // Compute the z level at the center of the side
 2222:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->znl[k] + side.n2->znl[k]);
 2223: 
 2224:       // Compute the length of the side
 2225:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2226:       side.length = sqrt(dot(vLen, vLen));
 2227: 
 2228:    }
 2229: 
 2230:    printf("Processing %d elements\n", ne);
 2231:    for (int i = 0; i < ne; i++)
 2232:    {
 2233:       Element &elem = localElemData[i];
 2234:       elem.idx = i;
 2235:       for (int j = 0; j < i34[i]; j++) {
 2236:          const int idxNode = elnode[i*4 + j];  
 2237:          const int idxSide = elside[i*4 + j];
 2238:          
 2239:          elem.nodes[j] = (Node *)&(nodes[localElemPart[idxNode]][localElemIndices[idxNode]]);
 2240:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2241: 
 2242:          // Find the neighboring element  
 2243:          if (elem.sides[j]->elems[0] == &elem) {
 2244:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2245:          }
 2246:          else {
 2247:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2248:          }
 2249:       }
 2250: 
 2251:       
 2252: 
 2253:       elem.i34 = i34[i];
 2254: 
 2255: // printf("elem = %p, elem.i34 = %d\n", &elem, elem.i34);
 2256: 
 2257:       // Compute the centroid of the element and its depth
 2258:       Vector2 center = {0.0, 0.0};
 2259:       elem.depth = 0.0;
 2260:       for (int j = 0; j < i34[i]; j++) {
 2261:          center += elem.nodes[j]->p2()/i34[i];
 2262:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2263:       }
 2264:       elem.center.x = center.x;
 2265:       elem.center.y = center.y;
 2266: 
 2267:       // printf("elem = %p, i34 = %d, center = (%f,%f,%f)\n", &elem, elem.i34, elem.center.x, elem.center.y, elem.depth);
 2268:       
 2269:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2270:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2271: 
 2272:       elem.area = elem.computeSignedArea(); 
 2273:       elem.radius = sqrt(elem.area)/pi; 
 2274:       
 2275:       // Determines which way the normal vector to each side is oriented.
 2276:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2277:       for (int j = 0; j < i34[i]; j++)  
 2278:       {
 2279:          if (elem.sides[j]->elems[0] == &elem) {
 2280:             elem.ssign[j] =  1.0;
 2281:          }
 2282:          else {
 2283:             elem.ssign[j] = -1.0;
 2284:          }
 2285: 
 2286:       }
 2287: 
 2288:       // Derivatives of shape functions
 2289:       //  For ics=2, this is done inside element/ll frame XXX
 2290:       //  For quads, the derivative is evaluated at centroid
 2291:       const int i34 = elem.i34;
 2292:       for (int j = 0; j < i34; j++) {
 2293:          const double area = elem.area;
 2294:          const int id2 = elem.nxq(1 + j);
 2295:          const int id3 = elem.nxq(2 + j);
 2296:          const int id4 = elem.nxq(3 + j);
 2297:          if (elem.isTri()) {
 2298:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2299:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2300:             // da1/dx = (y1 - y2)/(2*area)
 2301:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2302:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2303:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2304:          }
 2305:          else  { // Quad; evaluate at centroid
 2306:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2307:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2308:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2309:          } // if Tri
 2310: 
 2311:       } // for j
 2312: 
 2313:    }
 2314: 
 2315: 
 2316: 
 2317:    
 2318: }
