 2938: __device__ void computeBottomDragVegetation(void) {
 2939:    // UNFINISHED. CHECK THIS:
 2940:    // How many kernels are needed? Why so many for loops?
 2941:    // Is the loop on sides needed?
 2942: 
 2943:    Node *node = NODE_PTR;
 2944: 
 2945:    const int    kb      = node->kb;
 2946:    const double htot    = node->htot();
 2947:    const double rough   = node->rough;
 2948: 
 2949: 
 2950:    if (node->idry) {
 2951:       // Default values for dry nodes
 2952:       node->veg_alpha_vert_mean = node->veg_alpha0;
 2953:       /// XXX CHECK INDICES
 2954:       if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 2955:    }
 2956: 
 2957:    // Compute bottom drag Cd
 2958:    //--------------------------------
 2959: 
 2960:    // nchi = {-1, 0, 1} is the type of bottom drag.
 2961:    if (nchi==1) {
 2962: 
 2963:       bool ltmp = false; // for WBL iteration
 2964: 
 2965:       // Cdmax=-1 !max. Cd at node for this process (info only)
 2966:       // Drag at nodes
 2967: /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 2968: // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 2969:      
 2970:       const double rough = node->rough;
 2971:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 2972:       if (node->rough == 0.0) {
 2973:          node->Cd = 0.0;
 2974: 
 2975:       } else { //roughness >0 
 2976:          
 2977:          const double bthick_ori = node->znl[kb + 1] - node->znl[kb];  // thickness of bottom bnd layer
 2978:          const double bthick = max(dzb_min, bthick_ori);
 2979: 
 2980:          assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 2981: 
 2982:          double tmp = 1.0/(2.5*log(bthick/rough));
 2983:          node->Cd = tmp*tmp;
 2984: 
 2985:       } // if rough
 2986: 
 2987: 
 2988:       // RECOVER THIS: XXX
 2989:       // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 2990:       // Output warning for WBL if iteration didn't converge
 2991: 
 2992: 
 2993:    } // nchi==1
 2994: 
 2995:    //   Bottom stress in m^2/s^2
 2996:    if (node->rho[kb + 1] >= -98.0)
 2997:    {
 2998:       const double mag_u = length(toVector2(node->u2[kb + 1]));
 2999:       node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 3000:       // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 3001:       // !sediment erosion: this part needs more documentation
 3002:    }
 3003: 
 3004:  
 3005:    // Compute vegetation parameters
 3006:    //--------------------------------
 3007: 
 3008:    // SAV constants
 3009:    constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 3010:    constexpr double veg_cfpsi = 0.16;
 3011: 
 3012:    // Add vertical variation to veg_alpha and compute vertical mean etc.
 3013:    if constexpr(iveg == 1) { //  Vertical variation specified by functions
 3014: 
 3015:       // Compute the vegetation "density" \alpha = D*N*Cd/2
 3016:       // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 3017:       int kbin = 0; // bin index
 3018:       for (int k = kb; k < nvrt; k++) {
 3019:          // Computes node height above the bottom level
 3020:          const double tmp_h = node->znl[k] - node->znl[kb]; // >=0
 3021:          assert(true && "Vertical variation of vegetation not implemented");
 3022: 
 3023:          // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 3024:          //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 3025:          //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 3026:          //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 3027:          // } else {
 3028:          //    // Find the bin at which the current vertical level is
 3029:          //    while (kbin<nbins_veg_vert) {
 3030:          //       const double zn = node->znl[kbin];
 3031:          //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 3032:          //          break;
 3033:          //       } // if
 3034:          //       kbin++;
 3035:          //    } // while
 3036:          //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 3037: 
 3038:          //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 3039:          //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 3040:             
 3041:          //    // Linear interpolation of the vegetation parameters
 3042:          //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 3043:          //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 3044:          //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 3045:          // } // if rl10
 3046: 
 3047:          // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 3048: 
 3049:       } // for k
 3050: 
 3051: 
 3052:    } else { // Ganthy (iveg=2)
 3053:    //  Modify canopy height, diameter, and density
 3054: 
 3055:       // Make sure there is vegetation on this node
 3056:       if (node->veg_h_unbent > 0.0) {
 3057:          const double wtmp2 = length(node->dav)*100.0; // cm/s
 3058: 
 3059:          node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 3060:                                 0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 3061:          node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 3062: 
 3063:          const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 3064:          node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 3065:          const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 3066:          node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 3067:       } // if veg_h_unbent
 3068: 
 3069:       for (int k = 0; k < nvrt; k++) {
 3070:          node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 3071:       } // for k
 3072:    
 3073: 
 3074:    } // if iveg
 3075:   
 3076:       
 3077: 
 3078:    // Compute vertical mean of veg_alpha3D
 3079:    if (iveg != 0) {
 3080:       const double ztop = node->zTopCanopy(); // Top of the canopy
 3081:       double sum1=0.0;
 3082:       double sum2=0.0;
 3083:       // Integrate over each level under the canopy...
 3084:       for (int k=kb; k<nvrt-1 && node->znl[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 3085:          const double Dz = node->Dz(k);
 3086: 
 3087:          sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 3088:          sum2 += Dz;
 3089: 
 3090:       } // for k
 3091: 
 3092:       if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 3093:       else             node->veg_alpha_vert_mean = sum1/sum2;
 3094: 
 3095:    } // if iveg
 3096: 
 3097: }
 3098: 
 3099: __device__ void computeVegetationAndDragParameters(void) {
 3100:    // Computes the vegetation and drag model parameters:
 3101:    // chi, \tilde\chi, beta, \breve{H}
 3102:    
 3103:    Side *side = SIDE_PTR;
 3104: 
 3105:    const double htot = side->htot();
 3106:    const int    kb   = side->kb;
 3107: 
 3108:    assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 3109: 
 3110:    const double veg_h     = side->veg_h();
 3111:    const double veg_nv    = side->veg_nv();
 3112:    const double veg_c     = side->veg_c();
 3113:    const double veg_beta  = side->veg_beta;
 3114:    const double veg_alpha = side->veg_alpha_vert_mean();
 3115: 
 3116:    // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 3117:    // Velocity magnitude at the bottom level
 3118:    // XXXX Check if we have add -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 3119:    assert(true && "Must use backtracked velocity");
 3120:    const double vmag1 = length(side->u2[kb + 1]); //BACKTRACKED VELOCITY
 3121:    side->chi2 = side->Cd()*vmag1;
 3122:    side->chi  = side->chi2;
 3123:    if constexpr(iveg != 0) {
 3124:       const Node *n1 = side->n1;
 3125:       const Node *n2 = side->n2;
 3126:       const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 3127:       side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 3128:    }
 3129: 
 3130:    // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 3131: 
 3132:    // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 3133:    // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 3134:    double magUa = 0.0;
 3135:    if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 3136:       // 3D wet side with veg...
 3137: 
 3138:       double magUa = 0.0;
 3139:       for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 3140:          if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 3141: 
 3142:             // Velocity magnitude must be computed at the center of each level to perform the integration.
 3143:             // The tricky part is to compute that velocity at the level that may be partially submerged.
 3144:             const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 3145: 
 3146:             // Velocity magnitude at the top (h) of the level (may be partially submerged)
 3147:             const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 3148: 
 3149:             // Velocity magnitude at the bottom (l) of the level
 3150:             const double ul = length(side->u2[k]);
 3151: 
 3152:             const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 3153:             magUa += Dz*0.5*(uh + ul);
 3154: 
 3155:          } // if HasVegetation
 3156:       } // for k
 3157:       const double ua = magUa/min(htot, veg_h); // Vertical average
 3158: 
 3159:       // Computes beta, used for computing the stress term at the top of the canopy.      
 3160:       side->veg_c2 = veg_alpha*dt*ua; // >=0
 3161:       if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 3162:          const double zCpy = side->zTopCanopy();
 3163:          const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 3164:          const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 3165:          const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 3166:          const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 3167:          side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 3168:       } // if isSubmerged
 3169:    } // if iveg   
 3170: 
 3171:    // Computes the friction modified depth, \breve{H} in notes
 3172:    if (side->is2D()) { // 2D
 3173: 
 3174:       double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 3175:       if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 3176: 
 3177:       assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 3178: 
 3179:       side->hhat = htot*htot/fricH; 
 3180: 
 3181:    } else { // 3D
 3182:       side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 3183: 
 3184:       if constexpr(iveg != 0) {
 3185:          
 3186:          if (side->isSubmerged()) { 
 3187:             const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 3188:             side->hhat -= veg_c*Hhat_alpha;
 3189: 
 3190:          } else { // Emergent
 3191:             side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 3192:          }
 3193:       } // if iveg
 3194: 
 3195:       // Enforce positivity for 3D model
 3196:       if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 3197:    } // if 3D
 3198: 
 3199:      
 3200: }
 3201: 
 3202: 
 3203: 
 3204: __device__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 3205: // Computes the density gradient between two elements, e1 and e2.
 3206: // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 3207: // zero in the direction normal to the side. 
 3208: // 
 3209: // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 3210: // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 3211: //
 3212: // Input:
 3213: //    e1: Element
 3214: //    e2: Neighbor element (or nullptr if boundary)
 3215: //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 3216: //    k: Index of the half-level at which the density is interpolated
 3217: //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 3218: // 
 3219: // Output:
 3220: //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 3221: //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 3222: 
 3223:    if (e2 == nullptr || e2->idry) {
 3224:       // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 3225: 
 3226:       Side *side = e1->sides[j];
 3227:       assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->idry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 3228:               
 3229:       if constexpr(ics == 1) {
 3230:          vec = side->n; // Normal vector to the side
 3231:       } else {
 3232:          // IMPLEMENT THIS XXXXXX
 3233:          // !replace with xel, yel?
 3234:          //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 3235:          //      &eframe(:,:,i),xn1,yn1,tmp)
 3236:          //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 3237:          //      &eframe(:,:,i),xn2,yn2,tmp)
 3238:       } //ics
 3239:                 
 3240:       diffRho = 0.0;
 3241: 
 3242:    } else { //internal and wet
 3243:       if constexpr(ics==1) {
 3244:          assert(e2 != nullptr || e2->idry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 3245: 
 3246:          // Vector from e1 to e2
 3247:          vec = toVector2(e2->center - e1->center);
 3248: 
 3249:       } else { 
 3250:          // IMPLEMENT THIS XXXXXX
 3251:          //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 3252:          //      &eframe(:,:,i),xctr2,yctr2,tmp)
 3253:          //                   alow(j)=xctr2
 3254:          //                   bdia(j)=yctr2
 3255:       } // ics
 3256: 
 3257:       diffRho = rho2 - e1->demeanedDensity(k);
 3258:    }
 3259: 
 3260: }
 3261: 
 3262: __device__ void computeDensityCubicSplines(void) {
 3263:    // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 3264: 
 3265:    Element *elem = ELEM_PTR;
 3266:    if (elem->idry) return;
 3267: 
 3268:    const int kb = elem->kb;
 3269: 
 3270:    // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 3271:    if (elem->is2D()) {
 3272:       // In the 2D case, the density is constant at the prism level. 
 3273:       // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 3274:       elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 3275:    } else { //3D
 3276: 
 3277:       // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 3278:       auto getX = [elem] (int k) { return elem->z_prism(k); };
 3279:       auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 3280:       ///// XXXX CHECK INDICES!!!!!
 3281:       initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 3282:    } // 2D/3D
 3283: 
 3284: }
 3285: 
 3286: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 3287: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 3288: 
 3289:    if (elem2 == nullptr || elem2->idry) return 0.0;
 3290: 
 3291:    const int kb  = elem->kb;
 3292:    const int kb2 = elem2->kb;
 3293: 
 3294:    // z-coordinate of prism of elem
 3295:    const double zp = elem->z_prism(k);
 3296: 
 3297:    double rho = 0.0;
 3298: 
 3299:    if (elem2->is2D()) {
 3300:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 3301: 
 3302:    } else {  // 3D
 3303: 
 3304:       // eta_min may be < zmax
 3305:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 3306:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 3307: 
 3308:       // (Extrapolate density below bottom, we will fix it later)
 3309:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 3310:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 3311:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 3312:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 3313:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 3314:    } // 2D/3D
 3315:      
 3316: 
 3317:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 3318:    // Now we need to fix it.
 3319:    if (elem->z[k] < elem2->z[kb2]) {
 3320:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 3321: 
 3322:       // There are two methods to adjust the density at the bottom of the element.
 3323:       // iunder_deep=0: 
 3324:       const double depth1 = abs(elem->z[kb]); // larger depth
 3325: 
 3326:       if (iunder_deep==0) {
 3327: 
 3328:          const double weight = max(0.0, min(1.0, (depth1 - h1_bcc)/(h2_bcc - h1_bcc))); // weight
 3329: 
 3330:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 3331: 
 3332:       } else { // iunder_deep != 0
 3333: 
 3334:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 3335: 
 3336:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 3337: 
 3338:          //   Demeaned density at the same z coordinate as
 3339:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 3340:          }
 3341: 
 3342:       } // if iunder_deep
 3343:    } // if elem->z[kb] < elem2->z[kb]
 3344: 
 3345:    return rho;
 3346: }
 3347: 
 3348: __device__ void computeDensityGradient(void) {
 3349: 
 3350:    // Compute the horizontal density gradient at each element.
 3351:    // It works in two steps:
 3352:    // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 3353:    // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 3354:    //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 3355:    //             gradRho.r1 = rho1 - rho0
 3356:    //             gradRho.r2 = rho2 - rho0
 3357:    //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 3358:    // 
 3359:    //  NOTE: We use de-meaned densities.
 3360: 
 3361:    Element *elem = ELEM_PTR;
 3362: 
 3363:    if (elem->idry) return;
 3364: 
 3365:    const int kb  = elem->kb;
 3366:    const int i34 = elem->i34;
 3367: 
 3368:    for (int k = kb + 1; k < nvrt; k++) {
 3369:       // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 3370:       //             gradRho.r1 = rho1 - rho0
 3371:       //             gradRho.r2 = rho2 - rho0
 3372:       int icount = 0;
 3373:       double sumRx = 0.0;
 3374:       double sumRy = 0.0;
 3375:       for (int j1=0; j1<i34; j1++) { 
 3376: 
 3377:          const int j2 = elem->nxq(j1 + 1);
 3378: 
 3379:          // Pairs of consecutive neighbor elements of elem
 3380:          const Element *e1 = elem->nghbElems[j1];
 3381:          const Element *e2 = elem->nghbElems[j2];
 3382: 
 3383:          // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 3384:          const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 3385:          const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 3386: 
 3387:          // Compute the density difference and the vector from elem to e1 and e2
 3388:          // getRhoDiffAndVec takes into account boundaries/dry elements
 3389:          double diffRho1, diffRho2;
 3390:          Vector2 vec1, vec2;
 3391:          getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 3392:          getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 3393: 
 3394:          const double rl1 = length(vec1);
 3395:          const double rl2 = length(vec2);
 3396:          assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 3397: 
 3398:          const double delta = cross(vec1, vec2);
 3399:          const double sintheta = abs(delta)/(rl1*rl2);
 3400: 
 3401:          // To avoid problems, avoid elements with small angle between vectors
 3402:          constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 3403:          const bool validEq = (sintheta > sin_one_deg);
 3404: 
 3405:          if (validEq) {
 3406:             // Solve the system of equations to get the density gradient at elem
 3407:             icount++;
 3408:             const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 3409:             const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 3410:             sumRx += Rx;
 3411:             sumRy += Ry;
 3412:          }
 3413:       } // for j1
 3414: 
 3415:       // Compute the average density gradient at elem
 3416:       if (icount==0) {
 3417:         // Bad mesh quality; bail out with 0 b-cc
 3418:         elem->gradRho[k] = {0.0, 0.0};
 3419:       } else {
 3420:         elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 3421:       }
 3422: 
 3423:    } // for k
 3424: 
 3425: }
 3426: 
 3427: __device__ void computeBaroclinicTerm(double rampbc) {
 3428: // Computes the baroclinic term at sides (at half levels).
 3429: // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 3430: // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 3431: 
 3432:    Side *side = SIDE_PTR;
 3433: 
 3434:    if (side->idry == 1) return;
 3435: 
 3436:    const Element *e1 = side->elems[0];
 3437:    const Element *e2 = side->elems[1];      
 3438:    const int kb = side->kb;
 3439:    
 3440:    assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 3441: 
 3442:    // interpolates vertically the density gradient of the two elements at the half level/
 3443: 
 3444:    // Starts the integration at the surface and goes down to the bottom
 3445:    int k1 = nvrt - 1;
 3446:    int k2 = nvrt - 1;
 3447: 
 3448:    side->bcc[nvrt-1] = {0.0, 0.0};
 3449:    for (int k = nvrt-1; k >= kb; k--) {
 3450:    // For each prism level (from surface to bottom)...
 3451: 
 3452:       // For both elements, interpolate density gradient at the side's half level.
 3453:       // The gradient at the side is the average of the gradients at the elements.
 3454:       // w1, w2 are used to take into account boundary sides, with just one element.
 3455:       double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 3456:       double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 3457:       w1 = w1/(w1 + w2);
 3458:       w2 = w2/(w1 + w2);
 3459: 
 3460:       assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 3461: 
 3462:       // Linear interpolation of both elements' density gradient at the shared side's level.
 3463:       Vector2 gradRho = {0.0, 0.0};
 3464:       if (e1 != nullptr && k > kb) {
 3465:          // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 3466:          k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 3467:          const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 3468:          
 3469:          gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 3470:       }      
 3471:       if (e2 != nullptr && k > kb) {
 3472:          k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 3473:          const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 3474:          
 3475:          gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 3476:       }
 3477: 
 3478:       if constexpr(ics==2) {
 3479:          // IMPLEMENT THIS XXXXXX
 3480:          // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 3481:          // swild(1)=tmp1
 3482:          // swild(2)=tmp2
 3483:       }
 3484:       
 3485:       // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 3486:       // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 3487:       // CHECK INDICES!!! XXX
 3488:       const double grav3 = 0.5*(side->n1->grav2 + side->n2->grav2);
 3489:       side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 3490:    } // for
 3491: 
 3492: }
 3493: 
 3494: #ifdef DONTCOMPILE
 3495: __device__ void computeVerticalAdvection(void) {
 3496:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 3497: 
 3498:    sdbt(1:2,:,:)=0.d0
 3499: 
 3500:    const Side *side = FROM kernel;
 3501: 
 3502:    if(side->idry) return;
 3503: 
 3504:    // If side is wet...
 3505: 
 3506: 
 3507:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 3508:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 3509:    double ws[nvrt] = {} // w @ side
 3510:    int icount = 0;
 3511:    for (int j=0; j<2; j++) {
 3512:       const Element *elem = side->elements[j];
 3513:        
 3514:       if(elem != nullptr) {
 3515:          icount++;
 3516:          for (int k=0; k<nvrt; k++) {
 3517:             ws[k] = ws[k] + elem->w[k];
 3518:          }
 3519:       }
 3520:    }  // for j
 3521: 
 3522:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 3523:    ws = ws/icount;
 3524: 
 3525:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 3526:    // Splines allow for a smooth transition between vertical levels.
 3527:    // Splines have continuity restrictions at the internal knots, but
 3528:    // we have to provide the 1st derivatives at the endpoints.
 3529:    const int kbs = side->kbs; 
 3530:    
 3531:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3532:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3533:    initCubicSpline(kbs, nvrt, side, ws, up)
 3534: 
 3535:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3536:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3537:    initCubicSpline(kbs, nvrt, side, ws, vp)
 3538: 
 3539:    // Total advection (average onto side)
 3540:    const Node *node1 = side->nodes[0];
 3541:    const Node *node2 = side->nodes[1];
 3542:    for (int k=kbs(i); k<nvrt; k++) {
 3543: 
 3544:       if constexpr(ics==1) {
 3545:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 3546:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 3547:       } else {
 3548:          // XXX IMPLEMENT THIS
 3549:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 3550:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 3551:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 3552:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 3553:       }  // if ics
 3554: 
 3555: 
 3556:    }
 3557: }
 3558: #endif
 3559: 
 3560: __device__ void computeElemAverageGhat(double rampbc) {
 3561: // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 3562: 
 3563:    Element *elem = ELEM_PTR;
 3564:    
 3565:    elem->ghat1= {0.0, 0.0};  
 3566: 
 3567:    if constexpr(ihydraulics != 0) {
 3568:       if (nhtblocks > 0 && elem->isblock) return;
 3569:    }
 3570: 
 3571:    if (elem->idry == 1) return;
 3572: 
 3573:    // Wet elements.
 3574:    // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 3575:    // tidal potential, horizontal diffusion, and baroclinic etc
 3576:    // Remember to update both fb and F 
 3577:    // If ics=2, ghat1 are in eframe (ll)
 3578:    // cff1-3: coefficients for 2D/3D
 3579:    Vector2 gradEta = {0.0, 0.0};  // \nabla \eta
 3580:    Vector2 gradPr  = {0.0, 0.0};  // \nabla pressure
 3581:    Vector2 gradEtp = {0.0, 0.0};  // \nabla etp
 3582: 
 3583:    double av_cff1 = 0.0;  // av. for cff1
 3584:    double av_cff2 = 0.0;  // av. for cff2
 3585:    double av_cff3 = 0.0;  // av. for cff3
 3586:    double av_df = 0.0;  // av. for H^\alpha / H
 3587:    double av_cff2_chi = 0.0;  // av. for cff2*chi
 3588:    double av_cff3_chi = 0.0;  // av. for cff3*chi
 3589: 
 3590:    const int i34 = elem->i34;
 3591:    const int kb = elem->kb;
 3592: 
 3593:    for (int j=1; j<i34; j++) {
 3594:       // For each node and side in the element...
 3595: 
 3596:       const Node *node = elem->nodes[j];
 3597:       const Side *side = elem->sides[j];
 3598: 
 3599:       const double chi      = side->chi;
 3600:       const double veg_c2   = side->veg_c2;
 3601:       const double veg_beta = side->veg_beta;
 3602:       const double veg_h    = side->veg_h();
 3603:       const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 3604: 
 3605:       // Node - const in elem
 3606:       gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 3607:       gradPr  += node->pr  *elem->gradPhi[j];
 3608: 
 3609:       if (elem->depth >= tip_dp) {
 3610:         gradEtp += node->etp*elem->gradPhi[j];
 3611:       }
 3612: 
 3613:       
 3614:       const double htot  = side->htot();        // Total depth at the side
 3615:       const double zctr2 = side->zTopCanopy();  
 3616: 
 3617:       double cff1; 
 3618:       double cff2; 
 3619:       double cff3;   
 3620:       if (side->is2D()) {  // XXX Check indices, it used to have a +1
 3621:       // coefficients applied to 2D/3D case 
 3622:          cff1 = side->hhat/htot;
 3623:          cff2 = 0.0;
 3624:          cff3 = 0.0;
 3625:       } else { //3D
 3626:          //Init for no-veg case
 3627:          cff1 = 1.0;
 3628:          cff2 = 1.0;
 3629:          cff3 = 0.0;
 3630: 
 3631:          if constexpr(iveg != 0) {
 3632:             // Computes coefficients used with vegetation terms G1, G2
 3633:             // cff1, cff3 are used for the first two terms in G1, G2:
 3634:             // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 3635:             // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 3636:             // In general, cff1*Ustar - cff3*Ustar_alpha
 3637:             if(veg_h < 0.99*htot) { // submergent vegetation
 3638:                cff1=1;
 3639:                cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 3640:                cff3 = veg_c;
 3641: 
 3642:             } else { // emergent vegetation
 3643:                cff1 = 1.0/(1.0 + veg_c2);
 3644:                cff2 = cff1;
 3645:                cff3 = 0.0;
 3646: 
 3647:             }
 3648:          } // if iveg
 3649:       } //  2D/3D
 3650: 
 3651:       av_cff1 += cff1/i34;
 3652:       av_cff2 += cff2/i34;
 3653:       av_cff3 += cff3/i34;
 3654:       av_cff2_chi += cff2*chi/i34;
 3655:       av_cff3_chi += cff3*chi/i34;
 3656:       av_df += min(htot, veg_h)/(htot*i34);
 3657: 
 3658: 
 3659:       // btrack values: U^\star, U^{\star\alpha}
 3660:       // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 3661:       Vector2 Ustar       = {0.0, 0.0}; 
 3662:       Vector2 Ustar_alpha = {0.0, 0.0}; 
 3663:       for (int k = side->kb; k < nvrt; k++) {
 3664:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 3665:             Ustar += side->btu[nvrt]*side->Dz(k);
 3666: 
 3667:          } else { //3D
 3668:             Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 3669:             Ustar += w2;
 3670: 
 3671:             if constexpr(iveg != 0) {
 3672:                 if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 3673:                     const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k)); // For the top of the canopy, ratio of the level that is below the canopy
 3674:                     Ustar_alpha += zrat*w2; // XXXX
 3675:                 }
 3676:             }  // if iveg
 3677:          }  //2/3D
 3678:       }  //k
 3679:       
 3680: 
 3681:       // Add btrack & surface stress terms to \breve{G} first
 3682:       if constexpr(ics==1) {
 3683:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 3684:       } else {
 3685:          // XXX IMPLEMENT THIS
 3686:          // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 3687:          // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 3688:          // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 3689:       }  // if ics
 3690: 
 3691:       // Surface and bottom stress terms
 3692:       if constexpr(ics==1) {
 3693:          const Vector2 tau    = side->tau();
 3694:          const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 3695: 
 3696:          // Term for surface and bottom stress
 3697:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 3698:       } else {
 3699:          // XXX IMPLEMENT THIS
 3700:          // n1=isidenode(1,isd); n2=isidenode(2,isd)
 3701:          // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 3702:          // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 3703:          // tau_x=(vn1+tt1)/2.d0
 3704:          // tau_y=(vn2+ss1)/2.d0
 3705:          // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 3706:       }  // if ics
 3707: 
 3708:       
 3709: 
 3710:       // All terms in F,F^\alpha,f_b except baroclinic
 3711:       // F, f_b: all explicit terms excluding vegetation 
 3712:       // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 3713:       // Only need to calculate F^\alpha for 3D sides (but init=0) 
 3714:       const double coriolis = side->coriolis;
 3715:       Vector2 F  =  coriolis*side->U;  // F_x
 3716:       Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 3717:       Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 3718: 
 3719:       if (iveg != 0 && nvrt > side->kb) {  // 3D
 3720:          
 3721:          for (int k = side->kb; k < nvrt; k++) {
 3722:             if (zctr2 > side->zc[k-1]) {
 3723:                 const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 3724:                 const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 3725:                 Fa +=  coriolis*w2*zrat;
 3726:             } // if zctr2
 3727:          } // k
 3728:       } // iveg
 3729: 
 3730:       // Integrate horizontal viscosity force vertically
 3731:       for (int k=side->kb + 1; k<nvrt; k++) {
 3732:          const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.0; 
 3733: 
 3734:          F += levelHorVisc;
 3735: 
 3736:          // Vegetation term
 3737:          if constexpr(iveg!=0) {
 3738:             if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 3739:                const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 3740:                Fa += levelHorVisc*zrat;
 3741:             } 
 3742:          } // if iveg
 3743:       } // for k
 3744: 
 3745:       fb += side->d2uv[side->kb];
 3746: 
 3747: 
 3748:       // Add to ghat1
 3749:       if constexpr(ics==2) {
 3750:          // XXX IMPLEMENT THIS
 3751:          // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 3752:          // bigf1=vn1; bigf2=vn2
 3753:          // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 3754:          // botf1=vn1; botf2=vn2
 3755:          // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 3756:          // bigfa1=vn1; bigfa2=vn2
 3757:       } // if ics
 3758: 
 3759:       elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 3760:    } // for j (nodes and sides)
 3761: 
 3762:    elem->ghat1 = (1.0/i34)*elem->ghat1;
 3763:       
 3764:    // Finish off terms in F, F^\alpha and f_b
 3765:    const double grav3 = elem->mean(&Node::grav2);
 3766:    const Vector2 fb = grav3*gradEtp - gradPr/rho0; //const in each elem
 3767: 
 3768: 
 3769:    Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 3770:    for (int j=1; j<i34; j++) { 
 3771:       // For each side in the element...
 3772:       const Side *side = elem->sides[j];
 3773:       const double chi = side->chi;
 3774: 
 3775:       const double htot = side->htot();
 3776:       const double veg_h = side->veg_h();
 3777:       const Vector2 F  = htot*fb;
 3778:       const Vector2 Fa = min(htot, veg_h)*fb;
 3779: 
 3780:       tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 3781:    } // for j
 3782: 
 3783:    //botf1 etc are already in elem frame
 3784:    elem->ghat1 += tmp/i34;
 3785: 
 3786:    // Baroclinic force
 3787:    if constexpr(ibc==0) {
 3788:       assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 3789: 
 3790:       Vector2 Fa = {0.0, 0.0};
 3791:       Vector2 intGradRho = {0.0, 0.0};
 3792:       
 3793:       // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 3794:       for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 3795:          intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 3796: 
 3797:          // \in F [m^2/s/s]
 3798:          Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 3799:       }
 3800: 
 3801:       const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 3802:       const Vector2 F = av_df*Fa; //approx
 3803:       elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 3804: 
 3805:    } // if ibc
 3806: 
 3807: }
 3808: 
 3809: 
 3810: 
 3811: #ifdef DONTCOMPILE
 3812: __global__ void checkMassConservation(Tracers* sumtr) {
 3813: 
 3814:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 3815: 
 3816:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 3817: 
 3818:    Element *elem = &(mesh->localElemData[i]);
 3819: 
 3820:    // Skip dry elements
 3821:    if (elem->idry) return;
 3822: 
 3823:    // Local sum array for this thread
 3824:    double localSum[N_TRACERS] = {0.0};
 3825: 
 3826:    // Sum over vertical levels for this element
 3827:    const int kbe = elem->kbe;
 3828:    const double area = elem->area;
 3829: 
 3830:    for (int k = kbe; k < nvrt; k++) {
 3831:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 3832:       
 3833:       // Accumulate tracer mass
 3834:       for (int tr = 0; tr < N_TRACERS; tr++) {
 3835:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 3836:       }
 3837:    }
 3838: 
 3839:    
 3840: 
 3841:    //  This function returns per element sums. A reduction must be done on the host side.
 3842: }
 3843: 
 3844: 
 3845: __global__ void transport(void) {
 3846: 
 3847:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 3848: 
 3849:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 3850: 
 3851:    Element *elem = &(mesh->localElemData[ie]);
 3852: 
 3853:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 3854: 
 3855:                for (int m=0; m<ntr; m++) {
 3856:                   for (int k=kbe(ie); k<nvrt; k++) {
 3857:                      // Calculate each polynomial's weight 
 3858:                      wm=0.d0; sum1=0.d0; 
 3859:                      wm1=0.d0; wm2=0.d0; 
 3860:                      for (int i=0; i<elem->nweno2; i++) {
 3861:                   
 3862:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3863:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3864:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3865:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3866:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3867:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 3868:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 3869:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 3870:                      // -----------------Hu and Shu (1999)'s method----------------
 3871:                      b4=b1+b2+b3
 3872: 
 3873: //Error: add PRODUCTION CPP
 3874: #ifdef DEBUG
 3875:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 3876:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 3877:                     call parallel_abort(errmsg)
 3878:                   }
 3879: #endif
 3880: 
 3881:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 3882:                   // !----test-------------- 
 3883:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 3884:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 3885:                   // !wm(i)=wm1(i)*wm2(i)
 3886:                   // !---------------------- 
 3887:                   sum1=sum1+wm(i)
 3888:                 } // end for i
 3889: 
 3890:                 wm=wm/sum1
 3891: 
 3892:                 for (int j=0; j<elem->i34; j++) {
 3893: 
 3894:                   const Side *side  = elem->sides[j];
 3895:                   const Node *node1 = side->n1;
 3896:                   const Node *node2 = side->n2;
 3897: 
 3898:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 3899:                      trsd=0.d0
 3900:                      for (int kk=0; kk<nquad; kk++) {
 3901:                         for (int i=0; i<elem->nweno2; i++) {
 3902:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3903:                         } // end for i   
 3904:                      } // end for kk
 3905:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 3906:                   } // outward flux
 3907:                } // end for j=1,i34(ie) ! side
 3908:             }
 3909:          }
 3910:               
 3911: 
 3912: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
