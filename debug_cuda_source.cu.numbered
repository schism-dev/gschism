 1801: /**
 1802:  * This method performs backtracking from the side center until a time -dt back in time 
 1803:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 1804:  * intermediate point.
 1805:  *
 1806:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 1807:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 1808:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 1809:  * remaining time.
 1810:  * 
 1811:  * NOTE: Runge-Kutta is not implemented yet. XXX
 1812:  * 
 1813:  * @param uuint, vvint, wwint: Velocities at the final point
 1814:  * @param jlev: Level at which the backtracking is performed
 1815:  * @param dt, dtbk: Tracking timesteps
 1816:  * @param sclr: Array for backtracked values
 1817:  * @return: True if the backtracking was successful, false otherwise
 1818:  */
 1819: __inline__ __device__ bool Side::btrack(
 1820:       int jlev,
 1821:       double dt,            // Tracking time
 1822:       double dtbk,          // Tracking timestep
 1823:       double* sclr,         // Array for backtracked values
 1824:       Vector3 &u_int
 1825: ) const {
 1826: 
 1827:    // Start from side center
 1828:    Point3 x0 = {center.x, center.y, zc[jlev]};
 1829:  
 1830: 
 1831:    double time_rm = dt; // Remaining time
 1832: 
 1833: 
 1834:    // // Initialize outputs XXX
 1835:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 1836:    //    sclr[i] = 0.0;
 1837:    // }
 1838: 
 1839: 
 1840:    // Initial velocities
 1841:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 1842: 
 1843:    // Find the element that is in the direction opposite to the velocity
 1844:    Element* curElem = findElementTowards({u_int.x, u_int.y});
 1845: 
 1846: 
 1847:    const int MAX_ITERATIONS = 1000; 
 1848:    Element* nextElem = curElem;
 1849:    int iter = 0;
 1850:    while(true) {
 1851:       // Calculate timestep
 1852:       double dtb = min(dtbk, time_rm);
 1853: 
 1854:       // Next point in the backtracking curve
 1855:       Point3 xt = x0 - dtb*u_int;
 1856: 
 1857:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb);
 1858:       assert(found && "Backtracking failed in btrack");
 1859: // printf("<>T = %f, %f %f %f\n", time_rm - dtb, xt, yt, zt);
 1860:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 1861:                       // then time_rm needs to be increased by the unused time.
 1862: 
 1863: 
 1864:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 1865: 
 1866:       // The current point becomes the next segment's starting point.
 1867:       x0 = xt;
 1868:  
 1869:       curElem = nextElem;
 1870: 
 1871:       iter++;
 1872:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 1873:    }
 1874: 
 1875: 
 1876: }
 1877: 
