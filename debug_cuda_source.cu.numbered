 4272: extern "C" {
 4273:    __global__ void computeElemAverageGhat(void) {
 4274:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 4275: 
 4276:       ELEM(elem);
 4277:       
 4278:       elem->ghat1= {0.0, 0.0};  
 4279: 
 4280:       if constexpr(ihydraulics != 0) {
 4281:          if (nhtblocks > 0 && elem->isblock) return;
 4282:       }
 4283: 
 4284:       if (elem->isDry) return;
 4285: 
 4286:       // Wet elements.
 4287:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 4288:       // tidal potential, horizontal diffusion, and baroclinic etc
 4289:       // Remember to update both fb and F 
 4290:       // If ics=2, ghat1 are in eframe (ll)
 4291:       // cff1-3: coefficients for 2D/3D
 4292:       Vector2 gradEta = {0.0, 0.0};  // \nabla \eta
 4293:       Vector2 gradPr  = {0.0, 0.0};  // \nabla pressure
 4294:       Vector2 gradETP = {0.0, 0.0};  // \nabla etp
 4295: 
 4296:       double av_cff1 = 0.0;  // av. for cff1
 4297:       double av_cff2 = 0.0;  // av. for cff2
 4298:       double av_cff3 = 0.0;  // av. for cff3
 4299:       double av_df = 0.0;  // av. for H^\alpha / H
 4300:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 4301:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 4302: 
 4303:       const int i34 = elem->i34;
 4304:       const int kb = elem->kb;
 4305: 
 4306:       for (int j=1; j<i34; j++) {
 4307:          // For each node and side in the element...
 4308: 
 4309:          const Node *node = elem->nodes[j];
 4310:          const Side *side = elem->sides[j];
 4311: 
 4312:          const double chi      = side->chi;
 4313:          const double veg_c2   = side->veg_c2;
 4314:          const double veg_beta = side->veg_beta;
 4315:          const double veg_h    = side->veg_h();
 4316:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 4317: 
 4318:          // Node - const in elem
 4319:          gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 4320:          gradPr  += node->pr  *elem->gradPhi[j];
 4321: 
 4322:          if (elem->depth >= tip_dp) {
 4323:            gradETP += node->ETP*elem->gradPhi[j];
 4324:          }
 4325: 
 4326:          
 4327:          const double htot  = side->htot();        // Total depth at the side
 4328:          const double zctr2 = side->zTopCanopy();  
 4329: 
 4330:          double cff1; 
 4331:          double cff2; 
 4332:          double cff3;   
 4333:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 4334:          // coefficients applied to 2D/3D case 
 4335:             cff1 = side->hhat/htot;
 4336:             cff2 = 0.0;
 4337:             cff3 = 0.0;
 4338:          } else { //3D
 4339:             //Init for no-veg case
 4340:             cff1 = 1.0;
 4341:             cff2 = 1.0;
 4342:             cff3 = 0.0;
 4343: 
 4344:             if constexpr(iveg != 0) {
 4345:                // Computes coefficients used with vegetation terms G1, G2
 4346:                // cff1, cff3 are used for the first two terms in G1, G2:
 4347:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 4348:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 4349:                // In general, cff1*Ustar - cff3*Ustar_alpha
 4350:                if(veg_h < 0.99*htot) { // submergent vegetation
 4351:                   cff1=1;
 4352:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 4353:                   cff3 = veg_c;
 4354: 
 4355:                } else { // emergent vegetation
 4356:                   cff1 = 1.0/(1.0 + veg_c2);
 4357:                   cff2 = cff1;
 4358:                   cff3 = 0.0;
 4359: 
 4360:                }
 4361:             } // if iveg
 4362:          } //  2D/3D
 4363: 
 4364:          av_cff1 += cff1/i34;
 4365:          av_cff2 += cff2/i34;
 4366:          av_cff3 += cff3/i34;
 4367:          av_cff2_chi += cff2*chi/i34;
 4368:          av_cff3_chi += cff3*chi/i34;
 4369:          av_df += min(htot, veg_h)/(htot*i34);
 4370: 
 4371: 
 4372:          // btrack values: U^\star, U^{\star\alpha}
 4373:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 4374:          Vector2 Ustar       = {0.0, 0.0}; 
 4375:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 4376: 
 4377:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 4378:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 4379:          } else { //3D
 4380:             for (int k = side->kb; k < nvrt; k++) {
 4381:             
 4382:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 4383:                Ustar += w2;
 4384: 
 4385:                if constexpr(iveg != 0) {
 4386:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 4387:                        const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k)); // For the top of the canopy, ratio of the level that is below the canopy
 4388:                        Ustar_alpha += zrat*w2; // XXXX
 4389:                    }
 4390:                }  // if iveg
 4391:             }  // for k
 4392:          }  //2D/3D
 4393:          
 4394: 
 4395:          // Add btrack & surface stress terms to \breve{G} first
 4396:          if constexpr(ics==1) {
 4397:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 4398:          } else {
 4399:             // XXX IMPLEMENT THIS
 4400:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 4401:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 4402:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 4403:          }  // if ics
 4404: 
 4405:          // Surface and bottom stress terms
 4406:          if constexpr(ics==1) {
 4407:             const Vector2 tau    = side->tau();
 4408:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 4409: 
 4410:             // Term for surface and bottom stress
 4411:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 4412:          } else {
 4413:             // XXX IMPLEMENT THIS
 4414:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 4415:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 4416:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 4417:             // tau_x=(vn1+tt1)/2.d0
 4418:             // tau_y=(vn2+ss1)/2.d0
 4419:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 4420:          }  // if ics
 4421: 
 4422:          
 4423: 
 4424:          // All terms in F,F^\alpha,f_b except baroclinic
 4425:          // F, f_b: all explicit terms excluding vegetation 
 4426:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 4427:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 4428:          const double coriolis = side->coriolis;
 4429:          Vector2 F  =  coriolis*side->U;  // F_x
 4430:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 4431:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 4432: 
 4433:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 4434:             
 4435:             for (int k = side->kb; k < nvrt; k++) {
 4436:                if (zctr2 > side->zc[k-1]) {
 4437:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 4438:                    const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 4439:                    Fa +=  coriolis*w2*zrat;
 4440:                } // if zctr2
 4441:             } // k
 4442:          } // iveg
 4443: 
 4444:          // Integrate horizontal viscosity force vertically
 4445:          for (int k=side->kb + 1; k<nvrt; k++) {
 4446:             const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.0; 
 4447: 
 4448:             F += levelHorVisc;
 4449: 
 4450:             // Vegetation term
 4451:             if constexpr(iveg!=0) {
 4452:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 4453:                   const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 4454:                   Fa += levelHorVisc*zrat;
 4455:                } 
 4456:             } // if iveg
 4457:          } // for k
 4458: 
 4459:          fb += side->d2uv[side->kb];
 4460: 
 4461: 
 4462:          // Add to ghat1
 4463:          if constexpr(ics==2) {
 4464:             // XXX IMPLEMENT THIS
 4465:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4466:             // bigf1=vn1; bigf2=vn2
 4467:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4468:             // botf1=vn1; botf2=vn2
 4469:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4470:             // bigfa1=vn1; bigfa2=vn2
 4471:          } // if ics
 4472: 
 4473:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 4474:       } // for j (nodes and sides)
 4475: 
 4476:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 4477:          
 4478:       // Finish off terms in F, F^\alpha and f_b
 4479:       const double grav3 = elem->mean(&Node::grav2);
 4480:       const Vector2 fb = grav3*gradETP - gradPr/rho0; //const in each elem
 4481: 
 4482: 
 4483:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 4484:       for (int j=1; j<i34; j++) { 
 4485:          // For each side in the element...
 4486:          const Side *side = elem->sides[j];
 4487:          const double chi = side->chi;
 4488: 
 4489:          const double htot = side->htot();
 4490:          const double veg_h = side->veg_h();
 4491:          const Vector2 F  = htot*fb;
 4492:          const Vector2 Fa = min(htot, veg_h)*fb;
 4493: 
 4494:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 4495:       } // for j
 4496: printf("$$$ tmp = %.15g, %.15g\n", tmp.x, tmp.y);
 4497:       //botf1 etc are already in elem frame
 4498:       elem->ghat1 += tmp/i34;
 4499: 
 4500:       // Baroclinic force
 4501:       if constexpr(ibc==0) {
 4502:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 4503: 
 4504:          Vector2 Fa = {0.0, 0.0};
 4505:          Vector2 intGradRho = {0.0, 0.0};
 4506:          
 4507:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 4508:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 4509:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 4510: 
 4511:             // \in F [m^2/s/s]
 4512:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 4513:          }
 4514: 
 4515:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 4516:          const Vector2 F = av_df*Fa; //approx
 4517:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 4518: 
 4519:       } // if ibc
 4520: 
 4521: 
 4522: 
 4523:    }
 4524: 
 4525: } // extern "C"
 4526: 
 4527: 
