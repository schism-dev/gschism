 1681: 
 1682: //       const Side& side = sides[i];
 1683: 
 1684: //       xIntersect=-1.e25;
 1685: //       yIntersect=-1.e25;
 1686: 
 1687: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 1688: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 1689: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 1690: 
 1691: //       if (delta != 0.0) {
 1692: //          // Solves the two linear equations for tt1 and tt2
 1693: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1694: //          const double tt2 = delta2/delta;
 1695: 
 1696: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 1697: //          // Similarly, we use tt2 to compute the intersection point.
 1698: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
