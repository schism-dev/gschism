  471:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  472:       // Check if the point (xt,yt) is inside the element
  473:       double shpCoords[4];
  474:       bool res = computeShapeCoords(xt, shpCoords, false);
  475:       return res;
  476:    }
  477: 
  478:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4])
  479:    {
  480:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  481:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  482:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  483:       
  484:    }
