   49: // VECTOR/POINT operations ---------------------------------------------------------------------------
   50: 
   51: using Vector2 = double2; 
   52: using Vector3 = double3;
   53: using Point2  = double2;
   54: using Point3  = double3;
   55: 
   56: __device__ __host__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
   57:     return make_double2(a.x + b.x, a.y + b.y);
   58: }
   59: 
   60: __device__ __host__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
   61:     a.x += b.x;
   62:     a.y += b.y;
   63:     return a;
   64: }
   65: 
   66: __device__ __host__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
   67:     return make_double2(a.x - b.x, a.y - b.y);
   68: }
   69: 
   70: __device__ __host__ __forceinline__ double2 operator*(const double2& v, double s) {
   71:     return make_double2(v.x * s, v.y * s);
   72: }
   73: 
   74: __device__ __host__ __forceinline__ double2 operator*(double s, const double2& v) {
   75:     return v * s;  // reuse the previous operator
   76: }
   77: 
   78: __device__ __host__ __forceinline__ double2 operator/(const double2& v, double s) {
   79:     return make_double2(v.x / s, v.y / s);
   80: }
   81: 
   82: __device__ __host__ __forceinline__ double length(const double2& v) {
   83:     return sqrt(v.x*v.x + v.y*v.y);
   84: }
   85: 
   86: __device__ __host__ __forceinline__ double dot(const double2& v, const double2& w) {
   87:     return v.x*w.x + v.y*w.y;
   88: }
   89: 
   90: __device__ __host__ __forceinline__ double cross(const double2& v, const double2& w) {
   91:     return v.x*w.y - v.y*w.x;
   92: }
   93: 
   94: __device__ __host__ __forceinline__ double3 operator+(const double3& a, const double3& b) {
   95:     return make_double3(a.x + b.x, a.y + b.y, a.z + b.z);
   96: }
   97: 
   98: __device__ __host__ __forceinline__ double3 operator+=(double3& a, const double3& b) {
   99:     a.x += b.x;
  100:     a.y += b.y;
  101:     a.z += b.z;
  102:     return a;
  103: }
  104: 
  105: __device__ __host__ __forceinline__ double3 operator-(const double3& a, const double3& b) {
  106:     return make_double3(a.x - b.x, a.y - b.y, a.z - b.z);
  107: }
  108: 
  109: __device__ __host__ __forceinline__ double3 operator*(const double3& v, double s) {
  110:     return make_double3(v.x * s, v.y * s, v.z * s);
  111: }
  112: 
  113: __device__ __host__ __forceinline__ double3 operator*(double s, const double3& v) {
  114:     return v * s;
  115: }
  116: 
  117: __device__ __host__ __forceinline__ double3 operator/(const double3& v, double s) {
  118:     return make_double3(v.x / s, v.y / s, v.z / s);
  119: }
  120: 
  121: __device__ __host__ __forceinline__ double dot(const double3& v, const double3& w) {
  122:     return v.x*w.x + v.y*w.y + v.z*w.z;
  123: }
  124: 
  125: __device__ __host__ __forceinline__ Vector2 toVector2(const double3& v) {
  126:     return make_double2(v.x, v.y);
  127: }
  128: 
  129: __device__ __host__ __forceinline__ double3 toVector3(const double2& v, double w) {
  130:     return make_double3(v.x, v.y, w);
  131: }
  132: 
  133: __device__ __host__ __forceinline__ Point2 toPoint2(const double3& p) {
  134:     return make_double2(p.x, p.y);
  135: }
  136: 
  137: __device__ __host__ __forceinline__ Point3 toPoint3(const double2& p, double z) {
  138:     return make_double3(p.x, p.y, z);
  139: }
