  348: struct Element {
  349: 
  350:    // Geometry information
  351:    int idx;               // Index of the element
  352:    int i34;               // Number of sides for the element 
  353:    Side *sides[4];        // Sides of the element
  354:    Node *nodes[4];        // Nodes of the element
  355:    Element *nghbElems[4]; // Neighbors of the element
  356: 
  357:    int kb;                    // Bottom index of the element
  358:    double area;               // Area of the element
  359:    double ssign[4];           // Sign associated with each side of an element
  360:    double radius;             // Element equivalent radii
  361: 
  362:    Frame frame;
  363: 
  364:    Vector2 gradPhi[4];       // Derivatives of shape functions
  365:    Vector2 gradEta[nvrt];    // Gradient of free surface elevation
  366: 
  367:    int idry;                  // True if the element is dry
  368:    int kbe;                   // Bottom index of the element
  369: 
  370:    Vector3 center;            // Element center coordinates
  371:    double xlon_el, ylat_el;   // Element center lat/lon coordinates in _degrees_
  372:    double depth;              // Depth at element (min of all nodes)
  373:    double z[nvrt];            // z-coord  (local frame - vertical up)
  374: 
  375:    // Physical information
  376:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  377: 
  378:    static const bool isblock = false;              // Always false
  379: 
  380:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  381:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  382: 
  383:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  384: 
  385:    
  386: 
  387:    double vsource;            // Volumetric source/sink term [m^3/s]
  388: 
  389:    double rho[nvrt];          // Density at each prism center
  390:    double rho_mean[nvrt];     // Mean density at each prism center
  391:    CubicSpline rho_spl;
  392:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  393:    double rho_z[nvrt];        // First derivative of density at each prism center
  394:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  395: 
  396:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  397: 
  398:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  399:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  400: 
  401:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 1; }
  402:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 1; }
  403: 
  404:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  405:    __inline__ __device__ int nodeLocalIdx(Node *node) const { 
  406:       int res = (nodes[0] == node) ? 0 : ((nodes[1] == node) ? 1 : ((nodes[2] == node) ? 2 : 3)); 
  407:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  408:       return res;
  409:    }
  410: 
  411:    __inline__ __device__ int findLevel(double z1, int k) const {
  412:       // Starting at index k, find sequentially the level that contains z
  413: 
  414:       // if z is already betweeen z[k] and z[k+1], return k
  415:       if (z1 >= z[k] && z1 < z[k+1]) return k;
  416:       else if (z1 < z[k]) { 
  417:          // Search for increasing levels
  418:          for (int kk = k; kk < nvrt - 1; kk++) {
  419:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  420:          }
  421:          return nvrt - 1;
  422:       }
  423:       else {
  424:          // Search for decreasing levels
  425:          for (int kk = k; kk > 0; kk--) {
  426:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  427:          }
  428:          return 0;
  429:       }
  430:    }
  431: 
  432:    __inline__ __device__ double z_prism(int k) const { return 0.5*(z[k+1] + z[k]); }
  433:    __inline__ __device__ double Dz(int k)      const { return z[k+1] - z[k]; }
  434: 
  435:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  436: 
  437:    __inline__ __device__ double computeSignedArea(void) const;
  438: 
  439:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  440:       // Nudges the point (x,y) to the barycenter of the element
  441:       p = (1-eps)*p + eps*toVector2(center);
  442:    }
  443: 
  444:    __device__ bool computeShapeCoords(Point2 xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  445: 
  446:    __device__ Vector2 grad(double *a) const
  447:    {
  448:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  449:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  450:       if (isQuad()) {
  451:          gx += a[3]*gradPhi[3].x;
  452:          gy += a[3]*gradPhi[3].y;
  453:       }
  454:       return {gx, gy};
  455:    }
  456: 
  457:    __device__ void setFrame(void) {
  458: 
  459:       double ar1, ar2;
  460:       computeLonLat(center, ar1, ar2);
  461: 
  462:       frame.update(ar1, ar2);        
  463:     }
  464: 
  465:    __device__ bool findNextIntersection(Point2 x2, Side *&side, Element *&nextElement, double &t, 
  466:                                         double& tIntersect);
  467:    __device__ bool findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement, double &t, 
  468:                                         double& tIntersect);
  469: 
  470:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  471:       // Check if the point (xt,yt) is inside the element
  472:       double shpCoords[4];
  473:       bool res = computeShapeCoords(xt, shpCoords, false);
  474:       return res;
  475:    }
  476: 
  477:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4])
  478:    {
  479:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  480:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  481:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  482:       
  483:    }
  484: 
  485:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int);
  486: 
  487:    // ------------------------------------------------------------------------------------------------
  488:    // These are functions that work on all nodes of the element.
  489:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  490:    //
  491:    // An example of how to use these functions is:
  492:    //   
  493:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  494:    // 
  495:    // Where L is the level at which the field is to be interpolated. The field can be either
  496:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  497:    // There are different versions of getNodalValues for each of these cases.
  498: 
  499:    template<typename T>
  500:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  501:       // Get the values of the field at the nodes of the element
  502:       res[0] = nodes[0]->*field;
  503:       res[1] = nodes[1]->*field;
  504:       res[2] = nodes[2]->*field;
  505:       if (isQuad()) res[3] = nodes[3]->*field;
  506:       else          res[3] = T();
  507:    }
  508: 
  509:    template<typename T>
  510:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  511:       // Get the values of the field at the nodes of the element
  512:       res[0] = (nodes[0]->*field)[level];
  513:       res[1] = (nodes[1]->*field)[level];
  514:       res[2] = (nodes[2]->*field)[level];
  515:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  516:       else          res[3] = T();
  517:    }    
  518: 
  519:    template<typename T>
  520:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  521:       // Get the values of the func at the nodes of the element
  522:       res[0] = (nodes[0]->*func)(level);
  523:       res[1] = (nodes[1]->*func)(level);
  524:       res[2] = (nodes[2]->*func)(level);
  525:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  526:       else          res[3] = T();  // This is 0.0 or a zero vector
  527: 
  528:    }      
  529: 
  530:    template<typename T>
  531:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  532:       // Get the values of the field at the nodes of the element
  533:       res[0] = sides[0]->*field;
  534:       res[1] = sides[1]->*field;
  535:       res[2] = sides[2]->*field;
  536:       if (isQuad()) res[3] = sides[3]->*field;
  537:       else          res[3] = T();
  538:    }
  539: 
  540:    template<typename T>
  541:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  542:       // Get the values of the field at the nodes of the element
  543:       res[0] = (sides[0]->*field)[level];
  544:       res[1] = (sides[1]->*field)[level];
  545:       res[2] = (sides[2]->*field)[level];
  546:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  547:       else          res[3] = T();
  548:    }    
  549: 
  550:    template<typename T>
  551:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  552:       // Get the values of the func at the nodes of the element
  553:       res[0] = (sides[0]->*func)(level);
  554:       res[1] = (sides[1]->*func)(level);
  555:       res[2] = (sides[2]->*func)(level);
  556:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  557:       else          res[3] = T();  // This is 0.0 or a zero vector
  558: 
  559:    }      
  560: 
  561: 
  562:    __device__ double interpolate(int level, const double shapeCoords[4], double (Node::*func)(int) const) const {
  563:       double values[4];
  564:       getNodalValues(level, func, values);
  565: 
  566:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  567:    }
  568: 
  569:    template<typename T>
  570:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  571:       T values[4];
  572:       getNodalValues(field, values);
  573:       
  574:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  575:    }
  576: 
  577: 
  578:    template<typename T>
  579:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  580:       T values[4];
  581:       getNodalValues(level, field, values);
  582: 
  583:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  584:    }
  585: 
  586:    template<typename T>
  587:    __device__ T mean(T Node::* field) const {
  588:       T values[4];
  589:       getNodalValues(field, values);
  590: 
  591:       return (values[0] + values[1] + values[2] + values[3])/i34;
  592:    }
  593: 
  594:    template<typename T>
  595:    __device__ T mean(T Side::* field) const {
  596:       T values[4];
  597:       getSideValues(field, values);
  598:       
  599:       return (values[0] + values[1] + values[2] + values[3])/i34;
  600:    }   
  601: 
  602:    // __device__ double mean(double (Node::*func)(int) const) const {
  603:    //    double values[4];
  604:    //    getNodalValues(level, func, values);
  605:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  606:    // }
  607:    // ------------------------------------------------------------------------------------------------
  608: 
  609:    __device__ bool globalToLocal(double xt, double yt, double &xlocal, double &ylocal) const {
  610:       // Convert global coordinates to local coordinates
  611:       printf("NOT IMPLEMENTED: globalToLocal\n");
  612:       return true;
  613:    }
  614: 
  615:    __inline__ __device__ bool localToGlobal(double xlocal, double ylocal, double &xt, double &yt) const {
  616:       // Convert local coordinates to global coordinates
  617:       printf("NOT IMPLEMENTED: localToGlobal\n");
  618:       return true;
  619:    }
  620: 
  621:    __device__ void trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
  622:                                        double &dt, Point3 &xt, double zint, Vector3 &u_int);
  623:     
  624:    __device__ bool trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
  625:                                                  Element *&nextElem, int &jlev, double &dt);
  626: 
  627: };
