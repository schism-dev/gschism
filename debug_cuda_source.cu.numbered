  271: 
  272: 
  273: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  274:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  275:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  276: }
  277: 
  278: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  279:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  280:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  281: }
  282: 
  283: 
  284: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  285:    x3 = y1*z2 - y2*z1;
  286:    y3 = x2*z1 - x1*z2;
  287:    z3 = x1*y2 - x2*y1;
  288: }
  289: 
  290: 
  291: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  292: // Given a 3D global point (may not be on surface of earth), find its longitude and latitude in radians
  293: 
  294:    const double radius2 = dot(p, p);
  295:    assert(radius2 != 0.0     && "computeLonLat: radius = 0");
  296:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  297: 
  298:    rlon = atan2(p.y, p.x); // (-pi,pi]
  299: 
  300:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  301:       rlat = asin(p.z/sqrt(radius2));
  302:    } else {
  303:       rlat = asin(p.z/rearth_pole);
  304:    }
  305:   
  306: }
  307: 
  308: __inline__ __device__ void Error(const char* msg) {
  309:    printf("Error: %s\n", msg);
  310:    assert(false);
  311: }
  312: 
  313: struct Tracers {
  314:     double tracer[N_TRACERS];
  315: };
  316: 
  317: 
  318: 
  319: struct Frame {
  320:    double _t[9]; // t stands for tensor.
  321: 
  322:    // Access the tensor in Fortran order
  323:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  324: 
  325:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  326: 
  327:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  328: 
  329:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  330:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  331:       sincos(ar2, &sin_ar2, &cos_ar2);
  332: 
  333:       t(0,0) = -sin_ar1;
  334:       t(1,0) =  cos_ar1;
  335:       t(2,0) =  0.0;
  336:       t(0,1) = -cos_ar1*sin_ar2;
  337:       t(1,1) = -sin_ar1*sin_ar2;
  338: 
  339:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  340: 
  341:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  342:       assert (ar4!=0.0 && "GRID: ar4=0");
  343: 
  344:       const double ar4_inv = 1.0/ar4;
  345:       t(0,1) = t(0,1)*ar4_inv;
  346:       t(1,1) = t(1,1)*ar4_inv;
  347:       t(2,1) = t(2,1)*ar4_inv;
  348: 
  349:       // The third vector is the cross product of the first two
  350:       crossProduct(t(0,0), t(1,0), t(2,0), 
  351:                    t(0,1), t(1,1), t(2,1), 
  352:                    t(0,2), t(1,2), t(2,2));
  353:    }
  354: 
  355: 
  356:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  357:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  358:    // Inputs:
  359:    //        vec0: vel. in this frame;
  360:    //        frameout: Output frame;
  361:    // Output: 
  362:    //        vec1: vel. in new frame  
  363: 
  364:       auto const fo = frameout;
  365:       Vector2 vec1;
  366: 
  367:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  368:       // of t and fo.t are the same.
  369:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  370:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  371: 
  372:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  373:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  374: 
  375:       return vec1;
  376:    }
  377: 
  378:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  379:       // Transform a vector from global to local frame
  380:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  381:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  382:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  383:    }
  384: 
  385:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  386:       // Transform a vector from local to global frame
  387:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  388:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  389:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  390:    }   
  391: 
  392:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  393:    // Tranforms a point from global to local frame     
  394:       G2L(pi - origin0, po);
  395:    }
  396: 
  397:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  398:    // Transforms a point from local to global frame      
  399:       L2G(pi, po);
  400:       po = po + origin0;
  401:    }
  402: 
  403: };
