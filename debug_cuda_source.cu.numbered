 2717: __device__ void computeVerticallyIntegratedVelocity(void) {
 2718: 
 2719:    Side *side = FROM kernel;
 2720: 
 2721:    side->U = {0.0, 0.0}; 
 2722:       
 2723:    if(side->idry) return;
 2724: 
 2725:    const Node *node1 = side->n1;
 2726:    const Node *node2 = side->n2;
 2727: 
 2728:    // Vertically integrated velocity U (in ll if ics=2)
 2729:    for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 2730:       side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 2731:    }
 2732: 
 2733: }
