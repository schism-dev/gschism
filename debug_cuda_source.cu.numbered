 1369: 
 1370: /**
 1371:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1372:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1373:    If the segment is completely inside the element, then it returns true.
 1374: 
 1375:    This function assumes:
 1376:    - The initial point is on a side of the element. 
 1377:    - Its position is given by parameter t in the range [0,1].
 1378:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1379:       intersects the element (elements are convex).
 1380: 
 1381:    To find the intersection point, this function does the following:
 1382:    - it finds the intersection of the line segment with all the element side lines,
 1383:       except for the one that contains the initial point.
 1384:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1385:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1386:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1387:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1388:       track segment is almost parallel to the element side line.
 1389: 
 1390:    Inputs:
 1391:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1392:    @param x2, y2: other end of the line segment
 1393: 
 1394:    Outputs:
 1395:    @param side:  side that intersects the line segment (input and output)
 1396:    @param nextElement (output): element that contains the intersection point
 1397:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1398:    @param zint (input/output): Vertical coordinate of the intersection point
 1399: 
 1400:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1401:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1402:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1403: 
 1404:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1405:    (Delta) being zero.
 1406: 
 1407:    The intersection2 point happens when:
 1408:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1409:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1410:    
 1411:    Assumption: the 4 points (including those of the side segment) are different.
 1412:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1413:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1414:    If true, (xIntersect,yIntersect) is the intersection.				
 1415:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1416: **/
 1417: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1418:                                               double &t, double& tIntersect) {
 1419: 
 1420:    double closest_intersect_t = 1e10;
 1421:    bool found_intersection = false;
 1422: 
 1423:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1424:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1425:    const Point2 x1 = side->point(t);
 1426:    
 1427: 
 1428:    Side *nextSide = nullptr;
 1429:    for (int i = 0; i < i34; i++) {
 1430: 
 1431:       // Element's i-th side 
 1432:       Side *side2 = sides[i];
 1433: 
 1434:       // Skip the side that contains the initial point
 1435:       if (side2 == side) continue;
 1436: 
 1437:       // (x3,y3)-(x4,y4) is the element side line
 1438:       const Point2 x3 = side2->n1->p2();
 1439:       const Point2 x4 = side2->n2->p2();
 1440: 
 1441:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1442:       const double delta = cross(x2 - x1, x3 - x4);
 1443: 
 1444:       if (delta != 0.0) {
 1445: 
 1446:          const double delta1 = cross(x3 - x1, x3 - x4);
 1447:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1448: 
 1449:          // Solves the two linear equations for tt1 and tt2
 1450:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1451:          const double tt2 = delta2/delta;
 1452: 
 1453:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1454:             closest_intersect_t = min(closest_intersect_t, tt1);
 1455:             nextSide = side2;
 1456: 
 1457:             nextElement = nextSide->otherElem(this);
 1458:             tIntersect = max(small, min(tt1, 1.0-small));
 1459:             t = tt2;
 1460: 
 1461:             found_intersection = true;
 1462:          }
 1463:       
 1464:       }
 1465: 
 1466:    }
 1467:    
 1468: printf("AAA 1, found_intersection = %d, nextSide = %p, nextElement = %p\n", found_intersection, nextSide, nextElement);
 1469: 
 1470: 
 1471:    // found_intersection should always be true, since we checked all the sides.  
 1472:    side = nextSide;
 1473: // if (found_intersection) {
 1474: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1475: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1476: // }   
 1477:    // if (!found_intersection) {
 1478:    //    // Check if the segment is parallel to the initial side
 1479:    //    printf("XXX segment: side = %p\n", side);
 1480:    //    printf("XXX %f\n", dot(x2 - x1, side->n1->p2() - side->n2->p2()));
 1481:    //    if (abs(dot(x2 - x1, side->n1->p2() - side->n2->p2())) < small) {
 1482:    //       assert(false && "Segment is parallel to the initial side");
 1483:    //       found_intersection = true;
 1484:    //       nextElement = side->otherElem(this);
 1485:    //       tIntersect = t;
 1486:    //       t = 0.0;
 1487:    //       found_intersection = true;
 1488:    //    }
 1489:    // }
 1490:    return found_intersection;
 1491: }
 1492: 
 1493: 
 1494: 
 1495: 
 1496: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1497:                                               double &t, double& tIntersect) {
 1498: 
 1499:    double closest_intersect_t = 1e10;
 1500:    bool found_intersection = false;
 1501: 
 1502: double minDelta = 1e10; 
 1503: double btt1, btt2;
 1504:    for (int i = 0; i < i34; i++) {
 1505: 
 1506:       Side *side2 = sides[i];
 1507: 
 1508:       // (x3,y3)-(x4,y4) is the element side line
 1509:       const Point2 x3 = side2->n1->p2();
 1510:       const Point2 x4 = side2->n2->p2();
 1511: 
 1512:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1513:       const double delta = cross(x2 - x1, x3 - x4);
 1514: 
 1515:       if (abs(delta) > 0) {
 1516: 
 1517:          const double delta1 = cross(x3 - x1, x3 - x4);
 1518:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1519: 
 1520:          // Solves the two linear equations for tt1 and tt2
 1521:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1522:          const double tt2 = delta2/delta;
 1523: 
 1524: if (abs(delta) < minDelta) {
 1525:    minDelta = abs(delta);
 1526:    btt1 = tt1;
 1527:    btt2 = tt2;
 1528: }
 1529: double small = 1e-7;
 1530:          printf("RRRRRR tt1 = %e, tt2 = %e\n", tt1, tt2);
 1531:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1532:             closest_intersect_t = min(closest_intersect_t, tt1);
 1533:             side = side2;
 1534:             nextElement = side->otherElem(this);
 1535:             t = tt2;
 1536:             tIntersect = max(small, min(tt1, 1.0-small));
 1537:             found_intersection = true;
 1538:          }
 1539:       
 1540:       }
 1541:       else {  // parallel segments
 1542:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1543:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1544: 
 1545:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1546: 
 1547:          // const double dist = dot(x1 - x3, side2->n);
 1548:          // if (abs(dist) < small*length(x3 - x4)) {
 1549:          //    const double2 unitarySide = normalize(x4 - x3);
 1550:          //    const double len = dot(x2 - x1, unitarySide);
 1551:          //    t = t + len;
 1552:          //    t = max(0.0, min(t, 1.0));
 1553:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1554: 
 1555: 
 1556:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1557:          //    // t = tt2;
 1558:          //    found_intersection = true;
 1559:          // }
 1560:       }
 1561: 
 1562: 
 1563:    }
 1564: 
 1565:    if (!found_intersection) {
 1566:       
 1567:       printf("ZZ No intersection found:\n"
 1568:            "Element %d\n"
 1569:            "in = %d\n"
 1570:            "minDelta = %e\n"
 1571:            "tt1 = %e, tt2 = %e\n"
 1572:            "segment: (%f, %f)-(%f, %f)\n"
 1573:            "Vertices:\n"
 1574:          //   "  Nodes nextElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n"
 1575:            "  Nodes curElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n",
 1576:            IDX(nextElement),
 1577:            (btt1 >= -small && btt2 >= -small && btt2 <= 1.0 + small && btt1 <= 1.0 + small),
 1578:            minDelta,
 1579:            btt1, btt2,
 1580:            x1.x, x1.y,
 1581:            x2.x, x2.y,
 1582:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1583:          //   nextElement->nodes[1]->p.x, nextElement->nodes[1]->p.y,
 1584:          //   nextElement->nodes[2]->p.x, nextElement->nodes[2]->p.y,
 1585:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1586:            nodes[0]->p.x, nodes[0]->p.y,
 1587:            nodes[1]->p.x, nodes[1]->p.y,
 1588:            nodes[2]->p.x, nodes[2]->p.y,
 1589:            nodes[0]->p.x, nodes[0]->p.y);
 1590: 
 1591:    }
 1592: 
 1593:    // assert(found_intersection && "No intersection found");
 1594: 
 1595:    // found_intersection should always be true, since we checked all the sides.  
 1596:    return found_intersection;
 1597: }
 1598: 
 1599: 
 1600: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1601:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1602: 
 1603:    printf("Tracking segment goes out of water at element %d\n", curElem->idx);
 1604: 
 1605:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1606:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1607:    // curElement.
 1608: 
 1609:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1610:    // And uses this velocity instead to continue the tracking.
 1611: 
 1612:    // computes the intersection point in cartesian coordinates
 1613:    Point2 intersection = nextSide->p_t(tt);
 1614: 
 1615:    // Nudges the point to the barycenter of the element. 
 1616:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1617:    // next segment intersects the element sides.  
 1618:    curElem->nudgeToBarycenter(intersection);
 1619: 
 1620:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1621:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1622:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1623:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1624: 
 1625:    // If the side is an open boundary, the tangential velocity is zero.
 1626:    if (nextSide->isBnd()) vtan = 0.0;
 1627: 
 1628:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1629:    const double us = vtan*nextSide->t().x;
 1630:    const double vs = vtan*nextSide->t().y;
 1631:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1632: 
 1633:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1634:    const double len2 = length(intersection - toPoint2(xt));
 1635:    const double vel2 = u_int.x*u_int.x + u_int.y*u_int.y;        
 1636:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 1637:    else            dt = 0.0;
 1638: 
 1639:    // The end of this tracking segment is now the intersection point.
 1640:    xt = {intersection.x, intersection.y, zint};
 1641: printf("BBB u_int = %f,%f,%f\n", us, vs, ws);   
 1642:    u_int = {us, vs, ws};
 1643:    
 1644: }
 1645: 
 1646: /**
 1647:  * Tracks a particle through elements and vertical levels in the mesh.
 1648:  * 
 1649:  * @param x0,y0,z0     Starting position coordinates
 1650:  * @param xt,yt,zt     Target position coordinates
 1651:  * @param dtb          Time step for tracking
 1652:  * @param uuint,vvint,wwint Initial velocity components
 1653:  * @param nextElem     Starting/resulting element index
 1654:  * 
 1655:  * @return Status code of type trackExitCodes
 1656:  * 
 1657:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1658:  * of the details are different. The idea is that the code requires less branches and is better fit
 1659:  * for GPU execution.
 1660:  * 
 1661:  * The main ideas here are:
 1662:  * - The starting point is expected to be in the starting element.
 1663:  * - The end point is guaranteed to be inside an element.
 1664:  * - since the starting point is inside the element, there are only two cases: 
 1665:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1666:  *     (b) it does not and (xt,yt) is already in the starting element.
 1667:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1668:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1669:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1670:  * - tt1 can be positive or negative. We only consider the positive values.
 1671:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1672:  * - The next intersection will occur at the smallest positive tt1.
 1673:  * - This intersection will be the next (x0,y0) position.
 1674:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1675:  *   of getting stuck in a loop.
 1676:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1677:  *   was found.
 1678:  */
 1679: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1680:                                                        Element *&nextElem, int &jlev, double &dt) {
 1681: 
 1682:    // First thing is to check if the target point is inside the element. If it is there is nothing
 1683:    // else to do.
 1684: 
 1685:    const Element *curElem = nextElem;
 1686:    if (containsPoint(toPoint2(xt))) {
 1687:       curElem->interpolateVelocities(xt, u_int);
 1688:       return true;
 1689:    }
 1690: 
 1691:    Side *side = nullptr;
 1692: 
 1693:    // 1. Initial checks
 1694:    // Verify starting element is valid (wet)
 1695:    assert(!curElem->isDry && "Starting element is dry");
 1696: 
 1697:    // Checks if track has a zero length.
 1698:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1699:    // assert(len2 > 0.0 && "Zero length track"); 
 1700:    
 1701:    const int MAX_ITERATIONS = 1000;
 1702:    
 1703:    double t;
 1704:    Side *nextSide = nullptr;
 1705:    double tIntersect = 1e10;
 1706:    double zint = x0.z;
 1707: 
 1708:    // Horizontal tracking loop
 1709:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1710:    // (x0,y0) is inside the element but the target point is not.
 1711: 
 1712:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1713: 
 1714:    if (!found_intersection) {
 1715: double shpCoords_0[4];
 1716: double shpCoords_t[4];
 1717: computeShapeCoords(toPoint2(x0), shpCoords_0, false);
 1718: computeShapeCoords(toPoint2(xt), shpCoords_t, false);
 1719:       printf("No intersection found (containsPoint = %d, %d [%.17g, %.17g, %.17g] [%.17g, %.17g, %.17g]):\n"
 1720:            "Elements %d, %d\n"
 1721:            "Side %d\n"
 1722:            "segment: (%f, %f),(%f, %f)\n"
 1723:            "triangle node indices: %d, %d, %d\n"
 1724:            "triangle: (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n",
 1725:            containsPoint(toPoint2(x0)), containsPoint(toPoint2(xt)),
 1726:            shpCoords_0[0], shpCoords_0[1], shpCoords_0[2],
 1727:            shpCoords_t[0], shpCoords_t[1], shpCoords_t[2],
 1728:            IDX(curElem), IDX(nextElem),
 1729:            IDX(nextSide),
 1730:            x0.x, x0.y,
 1731:            xt.x, xt.y,
 1732:            curElem->nodes[0]->idx, curElem->nodes[1]->idx, curElem->nodes[2]->idx,
 1733:            curElem->nodes[0]->p.x, curElem->nodes[0]->p.y,
 1734:            curElem->nodes[1]->p.x, curElem->nodes[1]->p.y,
 1735:            curElem->nodes[2]->p.x, curElem->nodes[2]->p.y,
 1736:            curElem->nodes[0]->p.x, curElem->nodes[0]->p.y);
 1737:    }
 1738:    assert(found_intersection && "No intersection found at %d");
 1739: 
 1740:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1741: 
 1742:    // if the tracking segment goes out of water (either dry or edge boundary)
 1743:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1744: 
 1745: 
 1746:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1747:       nextElem = this;
 1748:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1749:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1750:       return true;    
 1751:    }
 1752: 
 1753: 
 1754:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1755:    int iterations = 0;
 1756:    while (iterations < MAX_ITERATIONS) {
 1757:       iterations++;
 1758:       
 1759:       Element *curElem = nextElem;
 1760: 
 1761:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1762: 
 1763:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1764: 
 1765:       // If we are already in the target element, we are done.
 1766:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1767:       if (!found_intersection) break;
 1768: 
 1769: 
 1770: 
 1771:       // if the tracking segment goes out of water (either dry or edge boundary).
 1772:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1773: 
 1774:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1775: 
 1776:          nextElem = curElem;
 1777: 
 1778: 
 1779:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1780:          // In this case, the caller (btrack) needs to take into account the remaining time.
 1781:          return true;
 1782:       }
 1783:       
 1784:       // Update position and element for next iteration
 1785:       side = nextSide;
 1786: 
 1787:    }
 1788: 
 1789:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 1790: 
 1791:  
 1792:    // Interpolate velocities at the final position. This is a conceptually simple step,
 1793:    // but the function is not simple, because it has to search for the vertical level containing zt.
 1794:    nextElem->interpolateVelocities(xt, u_int);
 1795: 
 1796: 
 1797:    return true;
 1798: }
 1799: 
 1800: 
 1801: __inline__ __device__ double Element::computeSignedArea(void) const {
 1802:    // Compute the area of the element
 1803: 
 1804:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 1805: 
 1806:    // In the quad case we need to add the area of the other triangle.
 1807:    if (isQuad()) {
 1808:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1809:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 1810:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1811:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 1812:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 1813:          Error("Negative area found in quad element");
 1814:       }
 1815:       res += ar1;
 1816:    }
 1817: 
 1818:    return res;
 1819: }
 1820: 
 1821: 
 1822: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->eta2 + nodes[0]->depth <= h0) ||
 1823:                                                                 (nodes[1]->eta2 + nodes[1]->depth <= h0) ||
 1824:                                                                 (nodes[2]->eta2 + nodes[2]->depth <= h0) ||
 1825:                                                                 (nodes[3]->eta2 + nodes[3]->depth <= h0);
 1826: }
 1827: 
 1828: 
 1829: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 1830:    // In boundary sides, the element 1 is nullptr
 1831:    return side->elems[1] == nullptr; 
 1832: }
 1833: 
 1834: 
 1835: 
 1836: /**
 1837:    Compute the shape coordinates of the point (xt,yt) in the element.
 1838:    @param xt (input): x-coordinate of the point
 1839:    @param shpCoords (output): shape coordinates of the point
 1840:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 1841:    @return true if the point is inside the element, false otherwise
 1842: **/
 1843: __device__ bool Element::computeShapeCoords(Point2 xt, double shpCoords[4],
 1844:                                             bool fixNegshpCoord) const {
 1845: 
 1846:    // Compute the shape coordinates of the point xt in the element.
 1847:    if (i34==3) {
 1848:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 1849:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 1850:       // and in this case, the pt will be nudged into the element
 1851:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 1852:       // from the local frame, so use additional check.
 1853: 
 1854:       Point2 x0, x1, x2;
 1855: 
 1856:       if constexpr(ics==1) {
 1857:          x0 = nodes[0]->p2();
 1858:          x1 = nodes[1]->p2();
 1859:          x2 = nodes[2]->p2();
 1860:       }
 1861:       else // lat/lon
 1862:       {
 1863:          Error("Not implemented yet");
 1864: #ifdef ICS2
 1865:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 1866:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 1867:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 1868: #endif
 1869:       }
 1870: 
 1871:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 1872:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 1873:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 1874:       shpCoords[3] = 0.0;
 1875:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 1876: 
 1877:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 1878:       // then we fix the negative shape coordinates.
 1879:       if (fixNegshpCoord && tmpmin<=0.0) {
 1880: 
 1881:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 1882:          // keeping the sum of the shape coordinates equal to 1.
 1883:          // I have tested and compared the new algorithm with the old one, and they give
 1884:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 1885:          // The new algorithm should be faster since it is branchless.
 1886:          const double a = - tmpmin + 1.0e-2;  // XXX it used to be 1.0e-4 in the comments of the original code
 1887:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 1888:          
 1889:          shpCoords[0] = (shpCoords[0] + a)*b;
 1890:          shpCoords[1] = (shpCoords[1] + a)*b;
 1891:          shpCoords[2] = (shpCoords[2] + a)*b;          
 1892: 
 1893:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 1894:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 1895:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 1896:          }
 1897: 
 1898:          // Update the point coordinates for the new shape coordinates
 1899:          double xcoords[3] = {x0.x, x1.x, x2.x};
 1900:          double ycoords[3] = {x0.y, x1.y, x2.y};
 1901:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 1902: 
 1903:       }
 1904: 
 1905:       // Check if the point is inside the element
 1906:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 1907:    }
 1908:    else {
 1909:       Error("Not implemented yet");
 1910: #ifdef QUADS
 1911:       // Reproject pt in eframe of nel for ics=2
 1912:       if constexpr(ics==1) {
 1913:          xn2 = xt; 
 1914:          yn2 = yt;
 1915:       }
 1916:       else {
 1917:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 1918:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 1919:       }
 1920: 
 1921:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 1922: #endif
 1923:    }
 1924: 
 1925:    return false;  // Never reached
 1926: 
 1927: }
 1928: 
 1929: 
 1930: /**  Interpolate velocities at a given point (xt,yt,zt)
 1931: 
 1932:    @param xt, yt, zt: coordinates of the point to interpolate
 1933:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 1934: 
 1935:    This is done in four steps:
 1936: 
 1937:    1. Find the shape coordinates for the final position in the element.
 1938:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 1939:    3. Perform a *binary search* to find the vertical level containing zt. It will have to interpolate the 
 1940:       z levels at xt, yt at each step.   
 1941:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 1942:       horizontally and vertically.
 1943: **/
 1944: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 1945:    // Interpolate the velocities at the point xt. 
 1946:    // This function works the same for triangular and quadrilateral elements.
 1947:    double shpCoord[4];
 1948: 
 1949: 
 1950:    // First step is to compute the shape coordinates of (xt,yt)
 1951:    computeShapeCoords(toVector2(xt), shpCoord, false);
 1952:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 1953: 
 1954:    // Second step is to find the level that contains zt
 1955:    // Uses a binary search to find the level
 1956:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 1957:    int L = kbe;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 1958:    int R = nvrt - 1;
 1959: 
 1960:    // Get the z coordinates at the nodes of the element at the levels L and R
 1961:    double zLAtNodes[4], zRAtNodes[4];
 1962:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 1963:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 1964: 
 1965:    double zL = interpolate(shpCoord, zLAtNodes);
 1966:    double zR = interpolate(shpCoord, zRAtNodes);
 1967:    
 1968:    // Interpolates vertically the velocities
 1969:    double wght1, wght2;
 1970:    if (xt.z<=zL) {
 1971:       wght1 = 1.0;
 1972:       wght2 = 0.0;
 1973:    }
 1974:    else if (xt.z>=zR) {
 1975:       wght1 = 0.0;
 1976:       wght2 = 1.0;
 1977:    }
 1978:    else {
 1979:       // Perform a binary search to find the levels between L and R that contain xt.z
 1980:       while (R - L > 1) {
 1981:          int M = (L + R) / 2;
 1982: 
 1983:          double zMAtNodes[4];
 1984:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 1985:          double zM = interpolate(shpCoord, zMAtNodes);
 1986:          if (zM < xt.z) 
 1987:          {
 1988:             L = M;
 1989:             zL = zM;
 1990:          }
 1991:          else 
 1992:          {
 1993:             R = M;
 1994:             zR = zM;
 1995:          }
 1996:       }
 1997:       assert(L == R-1);
 1998:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 1999: 
 2000:       wght2 = (xt.z - zL)/(zR - zL);
 2001:       wght1 = 1.0 - wght2;
 2002:    }
 2003: // printf("$$$ wght1 = %f, wght2 = %f, zt = %f, zL = %f, zR = %f\n", wght1, wght2, zt, zL, zR);
 2004: // printf("$$$ shpCoord = %f, %f, %f, %f\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 2005:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2006:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 2007: 
 2008:    // Neither of the interpolated velocities should be NaN
 2009:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2010: 
 2011: }
 2012: 
 2013: 
 2014: 
 2015: __inline__ __device__ double Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2016: __inline__ __device__ double Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2017: __inline__ __device__ Point2 Side::p_t(double t) const { return {x(t), y(t)}; }
 2018: __inline__ __device__ int    Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 2019: __inline__ __device__ double Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 2020: __inline__ __device__ double Side::depth(void)   const { return 0.5*(n1->depth + n2->depth); }
 2021: 
 2022: __inline__ __device__ double Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 2023: __inline__ __device__ double Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 2024: __inline__ __device__ double Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 2025: 
 2026: 
 2027: __inline__ __device__ double Side::Cd(void)      const { if constexpr(nchi != 0) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 2028: 
 2029: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 2030: 
 2031: /**
 2032:  * This method performs backtracking from the side center until a time -dt back in time 
 2033:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2034:  * intermediate point.
 2035:  *
 2036:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2037:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2038:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2039:  * remaining time.
 2040:  * 
 2041:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2042:  * 
 2043:  * @param uuint, vvint, wwint: Velocities at the final point
 2044:  * @param jlev: Level at which the backtracking is performed
 2045:  * @param dt, dtbk: Tracking timesteps
 2046:  * @return: True if the backtracking was successful, false otherwise
 2047:  */
 2048: __inline__ __device__ bool Side::btrack(
 2049:       int jlev,
 2050:       double dt,            // Tracking time
 2051:       double dtbk,          // Tracking timestep
 2052:       Vector3 &u_int
 2053: ) const {
 2054: 
 2055:    // Start from side center
 2056:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2057:  
 2058: 
 2059:    double time_rm = dt; // Remaining time
 2060: 
 2061: 
 2062:    // // Initialize outputs XXX
 2063:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2064:    //    sclr[i] = 0.0;
 2065:    // }
 2066: 
 2067: 
 2068:    // Initial velocities
 2069:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 2070: 
 2071: // printf("YY 1, u_int = %f,%f\n", u_int.x, u_int.y);
 2072: 
 2073:    // Find the element that is in the direction opposite to the velocity
 2074:    Element* curElem = findElementTowards({u_int.x, u_int.y});
 2075: // printf("YY 2, curElem = %p\n", curElem);
 2076:    const int MAX_ITERATIONS = 1000; 
 2077:    Element* nextElem = curElem;
 2078:    int iter = 0;
 2079:    while(true) {
 2080:       // Calculate timestep
 2081:       double dtb = min(dtbk, time_rm);
 2082: 
 2083:       // Next point in the backtracking curve
 2084:       Point3 xt = x0 - dtb*u_int;
 2085: // printf("YY 3, dtb = %f, curElem = %p, u_int = %f,%f,%f\n", dtb, curElem, u_int.x, u_int.y, u_int.z);
 2086:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb);
 2087: // printf("YY 4, found = %d\n", found);
 2088:       assert(found && "Backtracking failed in btrack");
 2089: // printf("<>T = %f, %f %f %f\n", time_rm - dtb, xt, yt, zt);
 2090:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2091:                       // then time_rm needs to be increased by the unused time.
 2092:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2093: 
 2094:       // The current point becomes the next segment's starting point.
 2095:       x0 = xt;
 2096:  
 2097:       curElem = nextElem;
 2098: 
 2099:       iter++;
 2100:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2101:    }
 2102: 
 2103: 
 2104: }
 2105: 
 2106: 
