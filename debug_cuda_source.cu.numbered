 4425: #ifdef DONTCOMPILE
 4426: __global__ void checkMassConservation(Tracers* sumtr) {
 4427: 
 4428:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 4429: 
 4430:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 4431: 
 4432:    Element *elem = &(mesh->localElemData[i]);
 4433: 
 4434:    // Skip dry elements
 4435:    if (elem->isDry) return;
 4436: 
 4437:    // Local sum array for this thread
 4438:    double localSum[N_TRACERS] = {0.0};
 4439: 
 4440:    // Sum over vertical levels for this element
 4441:    const int kbe = elem->kbe;
 4442:    const double area = elem->area;
 4443: 
 4444:    for (int k = kbe; k < nvrt; k++) {
 4445:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 4446:       
 4447:       // Accumulate tracer mass
 4448:       for (int tr = 0; tr < N_TRACERS; tr++) {
 4449:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 4450:       }
 4451:    }
 4452: 
 4453:    
 4454: 
 4455:    //  This function returns per element sums. A reduction must be done on the host side.
 4456: }
 4457: 
 4458: 
 4459: __global__ void transport(void) {
 4460: 
 4461:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 4462: 
 4463:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 4464: 
 4465:    Element *elem = &(mesh->localElemData[ie]);
 4466: 
 4467:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 4468: 
 4469:                for (int m=0; m<ntr; m++) {
 4470:                   for (int k=kbe(ie); k<nvrt; k++) {
 4471:                      // Calculate each polynomial's weight 
 4472:                      wm=0.d0; sum1=0.d0; 
 4473:                      wm1=0.d0; wm2=0.d0; 
 4474:                      for (int i=0; i<elem->nweno2; i++) {
 4475:                   
 4476:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4477:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4478:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4479:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4480:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4481:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 4482:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 4483:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 4484:                      // -----------------Hu and Shu (1999)'s method----------------
 4485:                      b4=b1+b2+b3
 4486: 
 4487: //Error: add PRODUCTION CPP
 4488: #ifdef DEBUG
 4489:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 4490:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 4491:                     call parallel_abort(errmsg)
 4492:                   }
 4493: #endif
 4494: 
 4495:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 4496:                   // !----test-------------- 
 4497:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 4498:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 4499:                   // !wm(i)=wm1(i)*wm2(i)
 4500:                   // !---------------------- 
 4501:                   sum1=sum1+wm(i)
 4502:                 } // end for i
 4503: 
 4504:                 wm=wm/sum1
 4505: 
 4506:                 for (int j=0; j<elem->i34; j++) {
 4507: 
 4508:                   const Side *side  = elem->sides[j];
 4509:                   const Node *node1 = side->n1;
 4510:                   const Node *node2 = side->n2;
 4511: 
 4512:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 4513:                      trsd=0.d0
 4514:                      for (int kk=0; kk<nquad; kk++) {
 4515:                         for (int i=0; i<elem->nweno2; i++) {
 4516:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4517:                         } // end for i   
 4518:                      } // end for kk
 4519:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 4520:                   } // outward flux
 4521:                } // end for j=1,i34(ie) ! side
 4522:             }
 4523:          }
 4524:               
 4525: 
 4526: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 4527: //             //   calculate each polynomial's weight 
 4528: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 4529: //                 wm=0.d0; sum1=0.d0
 4530: //                 do i=1,nweno1(ie) !for each polynomial
 4531: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4532: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4533: //                   b1=b1*b1+b2*b2 !smoothness indicator
 4534: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 4535: //                   wm(i)=b2
 4536: //                   sum1=sum1+b2
 4537: //                   !wm(i)=1.d0
 4538: //                   !sum1=sum1+1.d0
 4539: 
 4540: // // Error: PRODUCTION
 4541: // #ifdef DEBUG
 4542: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 4543: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 4544: //                     call parallel_abort(errmsg)
 4545: //                   endif
 4546: // #endif
 4547: 
 4548: //                 enddo !i
 4549: //                 wm=wm/sum1 !final weight
 4550: 
 4551:                 for (int j=0; j<elem->i34; j++) { // side
 4552:                   const Side *side = elem->sides[j];
 4553:                   const Node *node1 = side->n1;
 4554:                   const Node *node2 = side->n2;
 4555: 
 4556:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 4557:                     trsd=0.d0
 4558:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 4559:                       for (int i=0; i<elem->nweno1; i++) {
 4560:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 4561:                       }
 4562:                     enddo //kk
 4563:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 4564:                   } // outward flux
 4565:                 } // end for j=1,i34(ie) ! side
 4566:               } // end for k; ntr 
 4567: 
 4568:             else !simple upwind method
 4569:               do j=1,i34(ie)
 4570:                 jsj=elside(j,ie)
 4571:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 4572:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 4573:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 4574:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 4575:                   endif
 4576:                 enddo  !vertical layers
 4577:               enddo !j=1,i34(ie) ! side
 4578:             endif !order of accuracy
 4579: 
