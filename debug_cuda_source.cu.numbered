 1358: 
 1359: /**
 1360:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1361:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1362:    If the segment is completely inside the element, then it returns true.
 1363: 
 1364:    This function assumes:
 1365:    - The initial point is on a side of the element. 
 1366:    - Its position is given by parameter t in the range [0,1].
 1367:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1368:       intersects the element (elements are convex).
 1369: 
 1370:    To find the intersection point, this function does the following:
 1371:    - it finds the intersection of the line segment with all the element side lines,
 1372:       except for the one that contains the initial point.
 1373:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1374:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1375:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1376:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1377:       track segment is almost parallel to the element side line.
 1378: 
 1379:    Inputs:
 1380:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1381:    @param x2, y2: other end of the line segment
 1382: 
 1383:    Outputs:
 1384:    @param side:  side that intersects the line segment (input and output)
 1385:    @param nextElement (output): element that contains the intersection point
 1386:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1387:    @param zint (input/output): Vertical coordinate of the intersection point
 1388: 
 1389:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1390:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1391:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1392: 
 1393:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1394:    (Delta) being zero.
 1395: 
 1396:    The intersection2 point happens when:
 1397:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1398:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1399:    
 1400:    Assumption: the 4 points (including those of the side segment) are different.
 1401:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1402:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1403:    If true, (xIntersect,yIntersect) is the intersection.				
 1404:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1405: **/
 1406: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1407:                                               double &t, double& tIntersect) {
 1408: 
 1409:    double closest_intersect_t = 1e10;
 1410:    bool found_intersection = false;
 1411: 
 1412:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1413:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1414:    const Point2 x1 = side->point(t);
 1415:    
 1416: 
 1417:    Side *nextSide = nullptr;
 1418:    for (int i = 0; i < i34; i++) {
 1419: 
 1420:       // Element's i-th side 
 1421:       Side *side2 = sides[i];
 1422: 
 1423:       // Skip the side that contains the initial point
 1424:       if (side2 == side) continue;
 1425: 
 1426:       // (x3,y3)-(x4,y4) is the element side line
 1427:       const Point2 x3 = side2->n1->p2();
 1428:       const Point2 x4 = side2->n2->p2();
 1429: 
 1430:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1431:       const double delta = cross(x2 - x1, x3 - x4);
 1432: 
 1433:       if (delta != 0.0) {
 1434: 
 1435:          const double delta1 = cross(x3 - x1, x3 - x4);
 1436:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1437: 
 1438:          // Solves the two linear equations for tt1 and tt2
 1439:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1440:          const double tt2 = delta2/delta;
 1441: 
 1442:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1443:             closest_intersect_t = min(closest_intersect_t, tt1);
 1444:             nextSide = side2;
 1445: 
 1446:             nextElement = nextSide->otherElem(this);
 1447:             tIntersect = max(small, min(tt1, 1.0-small));
 1448:             t = tt2;
 1449: 
 1450:             found_intersection = true;
 1451:          }
 1452:       
 1453:       }
 1454: 
 1455:    }
 1456:    
 1457: printf("AAA 1, found_intersection = %d, nextSide = %p, nextElement = %p\n", found_intersection, nextSide, nextElement);
 1458: 
 1459: 
 1460:    // found_intersection should always be true, since we checked all the sides.  
 1461:    side = nextSide;
 1462: // if (found_intersection) {
 1463: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1464: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1465: // }   
 1466:    // if (!found_intersection) {
 1467:    //    // Check if the segment is parallel to the initial side
 1468:    //    printf("XXX segment: side = %p\n", side);
 1469:    //    printf("XXX %f\n", dot(x2 - x1, side->n1->p2() - side->n2->p2()));
 1470:    //    if (abs(dot(x2 - x1, side->n1->p2() - side->n2->p2())) < small) {
 1471:    //       assert(false && "Segment is parallel to the initial side");
 1472:    //       found_intersection = true;
 1473:    //       nextElement = side->otherElem(this);
 1474:    //       tIntersect = t;
 1475:    //       t = 0.0;
 1476:    //       found_intersection = true;
 1477:    //    }
 1478:    // }
 1479:    return found_intersection;
 1480: }
 1481: 
 1482: 
 1483: 
 1484: 
 1485: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1486:                                               double &t, double& tIntersect) {
 1487: 
 1488:    double closest_intersect_t = 1e10;
 1489:    bool found_intersection = false;
 1490: 
 1491: double minDelta = 1e10;
 1492: double btt1, btt2;
 1493:    for (int i = 0; i < i34; i++) {
 1494: 
 1495:       Side *side2 = sides[i];
 1496: 
 1497:       // (x3,y3)-(x4,y4) is the element side line
 1498:       const Point2 x3 = side2->n1->p2();
 1499:       const Point2 x4 = side2->n2->p2();
 1500: 
 1501:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1502:       const double delta = cross(x2 - x1, x3 - x4);
 1503: 
 1504:       if (delta != 0.0) {
 1505: 
 1506:          const double delta1 = cross(x3 - x1, x3 - x4);
 1507:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1508: 
 1509:          // Solves the two linear equations for tt1 and tt2
 1510:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1511:          const double tt2 = delta2/delta;
 1512: 
 1513: if (abs(delta) < minDelta) {
 1514:    minDelta = abs(delta);
 1515:    btt1 = tt1;
 1516:    btt2 = tt2;
 1517: }
 1518: double small = 1e-7;
 1519:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1520:             closest_intersect_t = min(closest_intersect_t, tt1);
 1521:             side = side2;
 1522:             nextElement = side->otherElem(this);
 1523:             t = tt2;
 1524:             tIntersect = max(small, min(tt1, 1.0-small));
 1525:             found_intersection = true;
 1526:          }
 1527:       
 1528:       }
 1529: 
 1530: 
 1531:    }
 1532: 
 1533:    if (!found_intersection) {
 1534:       
 1535:       printf("ZZ No intersection found:\n"
 1536:            "Element %p\n"
 1537:            "in = %d\n"
 1538:            "minDelta = %e\n"
 1539:            "tt1 = %e, tt2 = %e\n"
 1540:            "segment: (%f, %f)-(%f, %f)\n"
 1541:            "Vertices:\n"
 1542:          //   "  Nodes nextElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n"
 1543:            "  Nodes curElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n",
 1544:            nextElement,
 1545:            (btt1 >= -small && btt2 >= -small && btt2 <= 1.0 + small && btt1 <= 1.0 + small),
 1546:            minDelta,
 1547:            btt1, btt2,
 1548:            x1.x, x1.y,
 1549:            x2.x, x2.y,
 1550:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1551:          //   nextElement->nodes[1]->p.x, nextElement->nodes[1]->p.y,
 1552:          //   nextElement->nodes[2]->p.x, nextElement->nodes[2]->p.y,
 1553:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1554:            nodes[0]->p.x, nodes[0]->p.y,
 1555:            nodes[1]->p.x, nodes[1]->p.y,
 1556:            nodes[2]->p.x, nodes[2]->p.y,
 1557:            nodes[0]->p.x, nodes[0]->p.y);
 1558: 
 1559:    }
 1560: 
 1561:    // assert(found_intersection && "No intersection found");
 1562: 
 1563:    // found_intersection should always be true, since we checked all the sides.  
 1564:    return found_intersection;
 1565: }
 1566: 
 1567: 
 1568: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1569:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1570: 
 1571:    printf("Tracking segment goes out of water at element %d\n", curElem->idx);
 1572: 
 1573:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1574:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1575:    // curElement.
 1576: 
 1577:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1578:    // And uses this velocity instead to continue the tracking.
 1579: 
 1580:    // computes the intersection point in cartesian coordinates
 1581:    Point2 intersection = nextSide->p_t(tt);
 1582: 
 1583:    // Nudges the point to the barycenter of the element. 
 1584:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1585:    // next segment intersects the element sides.  
 1586:    curElem->nudgeToBarycenter(intersection);
 1587: 
 1588:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1589:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1590:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1591:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1592: 
 1593:    // If the side is an open boundary, the tangential velocity is zero.
 1594:    if (nextSide->isBnd()) vtan = 0.0;
 1595: 
 1596:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1597:    const double us = vtan*nextSide->t().x;
 1598:    const double vs = vtan*nextSide->t().y;
 1599:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1600: 
 1601:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1602:    const double len2 = length(intersection - toPoint2(xt));
 1603:    const double vel2 = u_int.x*u_int.x + u_int.y*u_int.y;        
 1604:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 1605:    else            dt = 0.0;
 1606: 
 1607:    // The end of this tracking segment is now the intersection point.
 1608:    xt = {intersection.x, intersection.y, zint};
 1609: printf("BBB u_int = %f,%f,%f\n", us, vs, ws);   
 1610:    u_int = {us, vs, ws};
 1611:    
 1612: }
 1613: 
 1614: /**
 1615:  * Tracks a particle through elements and vertical levels in the mesh.
 1616:  * 
 1617:  * @param x0,y0,z0     Starting position coordinates
 1618:  * @param xt,yt,zt     Target position coordinates
 1619:  * @param dtb          Time step for tracking
 1620:  * @param uuint,vvint,wwint Initial velocity components
 1621:  * @param nextElem     Starting/resulting element index
 1622:  * 
 1623:  * @return Status code of type trackExitCodes
 1624:  * 
 1625:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1626:  * of the details are different. The idea is that the code requires less branches and is better fit
 1627:  * for GPU execution.
 1628:  * 
 1629:  * The main ideas here are:
 1630:  * - The starting point is expected to be in the starting element.
 1631:  * - The end point is guaranteed to be inside an element.
 1632:  * - since the starting point is inside the element, there are only two cases: 
 1633:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1634:  *     (b) it does not and (xt,yt) is already in the starting element.
 1635:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1636:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1637:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1638:  * - tt1 can be positive or negative. We only consider the positive values.
 1639:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1640:  * - The next intersection will occur at the smallest positive tt1.
 1641:  * - This intersection will be the next (x0,y0) position.
 1642:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1643:  *   of getting stuck in a loop.
 1644:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1645:  *   was found.
 1646:  */
 1647: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1648:                                                        Element *&nextElem, int &jlev, double &dt) {
 1649: 
 1650:    // First thing is to check if the target point is inside the element. If it is there is nothing
 1651:    // else to do.
 1652: 
 1653:    if (containsPoint(toPoint2(xt))) {
 1654:       nextElem->interpolateVelocities(xt, u_int);
 1655:       return true;
 1656:    }
 1657: 
 1658:    Side *side = nullptr;
 1659: 
 1660:    // 1. Initial checks
 1661:    // Verify starting element is valid (wet)
 1662:    assert(!nextElem->isDry && "Starting element is dry");
 1663: 
 1664:    // Checks if track has a zero length.
 1665:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1666:    // assert(len2 > 0.0 && "Zero length track"); 
 1667:    
 1668:    const int MAX_ITERATIONS = 1000;
 1669:    
 1670:    double t;
 1671:    Side *nextSide = nullptr;
 1672:    double tIntersect = 1e10;
 1673:    double zint = x0.z;
 1674: 
 1675:    // Horizontal tracking loop
 1676:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1677:    // (x0,y0) is inside the element but the target point is not.
 1678: Element *tmpElem = nextElem;
 1679:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1680: 
 1681:    if (!found_intersection) {
 1682:       printf("No intersection found:\n"
 1683:            "Elements %d, %d\n"
 1684:            "Side %d\n"
 1685:            "segment: (%f, %f),(%f, %f)\n"
 1686:            "triangle node indices: %d, %d, %d\n"
 1687:            "triangle: (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n",
 1688:            IDX(tmpElem), IDX(nextElem),
 1689:            IDX(nextSide),
 1690:            x0.x, x0.y,
 1691:            xt.x, xt.y,
 1692:            tmpElem->nodes[0]->idx, tmpElem->nodes[1]->idx, tmpElem->nodes[2]->idx,
 1693:            tmpElem->nodes[0]->p.x, tmpElem->nodes[0]->p.y,
 1694:            tmpElem->nodes[1]->p.x, tmpElem->nodes[1]->p.y,
 1695:            tmpElem->nodes[2]->p.x, tmpElem->nodes[2]->p.y,
 1696:            tmpElem->nodes[0]->p.x, tmpElem->nodes[0]->p.y);
 1697:    }
 1698:    assert(found_intersection && "No intersection found at %d");
 1699: 
 1700:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1701: 
 1702:    // if the tracking segment goes out of water (either dry or edge boundary)
 1703:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1704: 
 1705: 
 1706:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1707:       nextElem = this;
 1708:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1709:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1710:       return true;    
 1711:    }
 1712: 
 1713: 
 1714:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1715:    int iterations = 0;
 1716:    while (iterations < MAX_ITERATIONS) {
 1717:       iterations++;
 1718:       
 1719:       Element *curElem = nextElem;
 1720: 
 1721:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1722: 
 1723:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1724: 
 1725:       // If we are already in the target element, we are done.
 1726:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1727:       if (!found_intersection) break;
 1728: 
 1729: 
 1730: 
 1731:       // if the tracking segment goes out of water (either dry or edge boundary).
 1732:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1733: 
 1734:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1735: 
 1736:          nextElem = curElem;
 1737: 
 1738: 
 1739:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1740:          // In this case, the caller (btrack) needs to take into account the remaining time.
 1741:          return true;
 1742:       }
 1743:       
 1744:       // Update position and element for next iteration
 1745:       side = nextSide;
 1746: 
 1747:    }
 1748: 
 1749:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 1750: 
 1751:  
 1752:    // Interpolate velocities at the final position. This is a conceptually simple step,
 1753:    // but the function is not simple, because it has to search for the vertical level containing zt.
 1754:    nextElem->interpolateVelocities(xt, u_int);
 1755: 
 1756: 
 1757:    return true;
 1758: }
 1759: 
 1760: 
 1761: 
 1762: 
 1763: __inline__ __device__ double Element::computeSignedArea(void) const {
 1764:    // Compute the area of the element
 1765: 
 1766:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 1767: 
 1768:    // In the quad case we need to add the area of the other triangle.
 1769:    if (isQuad()) {
 1770:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1771:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 1772:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1773:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 1774:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 1775:          Error("Negative area found in quad element");
 1776:       }
 1777:       res += ar1;
 1778:    }
 1779: 
 1780:    return res;
 1781: }
 1782: 
 1783: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 1784:    // In boundary sides, the element 1 is nullptr
 1785:    return side->elems[1] == nullptr; 
 1786: }
 1787: 
 1788: 
 1789: 
 1790: /**
 1791:    Compute the shape coordinates of the point (xt,yt) in the element.
 1792:    @param xt (input): x-coordinate of the point
 1793:    @param shpCoords (output): shape coordinates of the point
 1794:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 1795:    @return true if the point is inside the element, false otherwise
 1796: **/
 1797: __device__ bool Element::computeShapeCoords(Point2 xt, double shpCoords[4],
 1798:                                             bool fixNegshpCoord) const {
 1799: 
 1800:    // Compute the shape coordinates of the point xt in the element.
 1801:    if (i34==3) {
 1802:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 1803:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 1804:       // and in this case, the pt will be nudged into the element
 1805:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 1806:       // from the local frame, so use additional check.
 1807: 
 1808:       Point2 x0, x1, x2;
 1809: 
 1810:       if constexpr(ics==1) {
 1811:          x0 = nodes[0]->p2();
 1812:          x1 = nodes[1]->p2();
 1813:          x2 = nodes[2]->p2();
 1814:       }
 1815:       else // lat/lon
 1816:       {
 1817:          Error("Not implemented yet");
 1818: #ifdef ICS2
 1819:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 1820:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 1821:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 1822: #endif
 1823:       }
 1824: 
 1825:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 1826:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 1827:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 1828:       shpCoords[3] = 0.0;
 1829:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 1830: 
 1831:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 1832:       // then we fix the negative shape coordinates.
 1833:       if (fixNegshpCoord && tmpmin<=0.0) {
 1834: 
 1835:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 1836:          // keeping the sum of the shape coordinates equal to 1.
 1837:          // I have tested and compared the new algorithm with the old one, and they give
 1838:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 1839:          // The new algorithm should be faster since it is branchless.
 1840:          const double a = - tmpmin + 1.0e-2;  // XXX it used to be 1.0e-4 in the comments of the original code
 1841:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 1842:          
 1843:          shpCoords[0] = (shpCoords[0] + a)*b;
 1844:          shpCoords[1] = (shpCoords[1] + a)*b;
 1845:          shpCoords[2] = (shpCoords[2] + a)*b;          
 1846: 
 1847:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 1848:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 1849:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 1850:          }
 1851: 
 1852:          // Update the point coordinates for the new shape coordinates
 1853:          double xcoords[3] = {x0.x, x1.x, x2.x};
 1854:          double ycoords[3] = {x0.y, x1.y, x2.y};
 1855:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 1856: 
 1857:       }
 1858: 
 1859:       // Check if the point is inside the element
 1860:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 1861:    }
 1862:    else {
 1863:       Error("Not implemented yet");
 1864: #ifdef QUADS
 1865:       // Reproject pt in eframe of nel for ics=2
 1866:       if constexpr(ics==1) {
 1867:          xn2 = xt; 
 1868:          yn2 = yt;
 1869:       }
 1870:       else {
 1871:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 1872:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 1873:       }
 1874: 
 1875:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 1876: #endif
 1877:    }
 1878: 
 1879: }
 1880: 
 1881: 
 1882: /**  Interpolate velocities at a given point (xt,yt,zt)
 1883: 
 1884:    @param xt, yt, zt: coordinates of the point to interpolate
 1885:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 1886: 
 1887:    This is done in four steps:
 1888: 
 1889:    1. Find the shape coordinates for the final position in the element.
 1890:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 1891:    3. Perform a *binary search* to find the vertical level containing zt. It will have to interpolate the 
 1892:       z levels at xt, yt at each step.   
 1893:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 1894:       horizontally and vertically.
 1895: **/
 1896: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) {
 1897:    // Interpolate the velocities at the point xt. 
 1898:    // This function works the same for triangular and quadrilateral elements.
 1899:    double shpCoord[4];
 1900: 
 1901: 
 1902:    // First step is to compute the shape coordinates of (xt,yt)
 1903:    computeShapeCoords(toVector2(xt), shpCoord, false);
 1904:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 1905: 
 1906:    // Second step is to find the level that contains zt
 1907:    // Uses a binary search to find the level
 1908:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 1909:    int L = kbe;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 1910:    int R = nvrt - 1;
 1911: 
 1912:    // Get the z coordinates at the nodes of the element at the levels L and R
 1913:    double zLAtNodes[4], zRAtNodes[4];
 1914:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 1915:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 1916: 
 1917:    double zL = interpolate(shpCoord, zLAtNodes);
 1918:    double zR = interpolate(shpCoord, zRAtNodes);
 1919:    
 1920:    // Interpolates vertically the velocities
 1921:    double wght1, wght2;
 1922:    if (xt.z<=zL) {
 1923:       wght1 = 1.0;
 1924:       wght2 = 0.0;
 1925:    }
 1926:    else if (xt.z>=zR) {
 1927:       wght1 = 0.0;
 1928:       wght2 = 1.0;
 1929:    }
 1930:    else {
 1931:       // Perform a binary search to find the levels between L and R that contain xt.z
 1932:       while (R - L > 1) {
 1933:          int M = (L + R) / 2;
 1934: 
 1935:          double zMAtNodes[4];
 1936:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 1937:          double zM = interpolate(shpCoord, zMAtNodes);
 1938:          if (zM < xt.z) 
 1939:          {
 1940:             L = M;
 1941:             zL = zM;
 1942:          }
 1943:          else 
 1944:          {
 1945:             R = M;
 1946:             zR = zM;
 1947:          }
 1948:       }
 1949:       assert(L == R-1);
 1950:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 1951: 
 1952:       wght2 = (xt.z - zL)/(zR - zL);
 1953:       wght1 = 1.0 - wght2;
 1954:    }
 1955: // printf("$$$ wght1 = %f, wght2 = %f, zt = %f, zL = %f, zR = %f\n", wght1, wght2, zt, zL, zR);
 1956: // printf("$$$ shpCoord = %f, %f, %f, %f\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 1957:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 1958:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 1959: 
 1960:    // Neither of the interpolated velocities should be NaN
 1961:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 1962: 
 1963: }
 1964: 
 1965: 
 1966: 
 1967: __inline__ __device__ double Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 1968: __inline__ __device__ double Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 1969: __inline__ __device__ Point2 Side::p_t(double t) const { return {x(t), y(t)}; }
 1970: __inline__ __device__ int    Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 1971: __inline__ __device__ double Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 1972: __inline__ __device__ double Side::depth(void)   const { return 0.5*(n1->depth + n2->depth); }
 1973: 
 1974: __inline__ __device__ double Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 1975: __inline__ __device__ double Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 1976: __inline__ __device__ double Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 1977: 
 1978: 
 1979: __inline__ __device__ double Side::Cd(void)      const { if constexpr(nchi != 0) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 1980: 
 1981: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 1982: 
 1983: /**
 1984:  * This method performs backtracking from the side center until a time -dt back in time 
 1985:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 1986:  * intermediate point.
 1987:  *
 1988:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 1989:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 1990:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 1991:  * remaining time.
 1992:  * 
 1993:  * NOTE: Runge-Kutta is not implemented yet. XXX
 1994:  * 
 1995:  * @param uuint, vvint, wwint: Velocities at the final point
 1996:  * @param jlev: Level at which the backtracking is performed
 1997:  * @param dt, dtbk: Tracking timesteps
 1998:  * @return: True if the backtracking was successful, false otherwise
 1999:  */
 2000: __inline__ __device__ bool Side::btrack(
 2001:       int jlev,
 2002:       double dt,            // Tracking time
 2003:       double dtbk,          // Tracking timestep
 2004:       Vector3 &u_int
 2005: ) const {
 2006: 
 2007:    // Start from side center
 2008:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2009:  
 2010: 
 2011:    double time_rm = dt; // Remaining time
 2012: 
 2013: 
 2014:    // // Initialize outputs XXX
 2015:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2016:    //    sclr[i] = 0.0;
 2017:    // }
 2018: 
 2019: 
 2020:    // Initial velocities
 2021:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 2022: 
 2023: // printf("YY 1, u_int = %f,%f\n", u_int.x, u_int.y);
 2024: 
 2025:    // Find the element that is in the direction opposite to the velocity
 2026:    Element* curElem = findElementTowards({u_int.x, u_int.y});
 2027: // printf("YY 2, curElem = %p\n", curElem);
 2028:    const int MAX_ITERATIONS = 1000; 
 2029:    Element* nextElem = curElem;
 2030:    int iter = 0;
 2031:    while(true) {
 2032:       // Calculate timestep
 2033:       double dtb = min(dtbk, time_rm);
 2034: 
 2035:       // Next point in the backtracking curve
 2036:       Point3 xt = x0 - dtb*u_int;
 2037: // printf("YY 3, dtb = %f, curElem = %p, u_int = %f,%f,%f\n", dtb, curElem, u_int.x, u_int.y, u_int.z);
 2038:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb);
 2039: // printf("YY 4, found = %d\n", found);
 2040:       assert(found && "Backtracking failed in btrack");
 2041: // printf("<>T = %f, %f %f %f\n", time_rm - dtb, xt, yt, zt);
 2042:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2043:                       // then time_rm needs to be increased by the unused time.
 2044:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2045: 
 2046:       // The current point becomes the next segment's starting point.
 2047:       x0 = xt;
 2048:  
 2049:       curElem = nextElem;
 2050: 
 2051:       iter++;
 2052:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2053:    }
 2054: 
 2055: 
 2056: }
 2057: 
 2058: 
