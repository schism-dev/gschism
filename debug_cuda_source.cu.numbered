  314: struct Element {
  315: 
  316:    // Geometry information
  317:    int idx;               // Index of the element
  318:    int i34;               // Number of sides for the element 
  319:    Side *sides[4];        // Sides of the element
  320:    Node *nodes[4];        // Nodes of the element
  321:    Element *nghbElems[4]; // Neighbors of the element
  322: 
  323:    
  324:    double area;               // Area of the element
  325:    double ssign[4];           // Sign associated with each side of an element
  326:    double radius;             // Element equivalent radii
  327: 
  328:    double wind_angle;         // Wind rotation angle
  329: 
  330:    Frame frame;
  331: 
  332:    Vector2 gradPhi[4];       // Derivatives of shape functions
  333: 
  334:    int idry;                  // True if the element is dry
  335:    int kbe;                   // Bottom index of the element
  336: 
  337:    Vector3 center;            // Element center coordinates
  338:    double xlon_el, ylat_el;   // Element center lat/lon coordinates in _degrees_
  339:    double depth;              // Depth at element (min of all nodes)
  340:    double z[nvrt];            // z-coord  (local frame - vertical up)
  341: 
  342:    // Physical information
  343:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  344: 
  345:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  346:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  347: 
  348:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  349: 
  350:    double vsource;            // Volumetric source/sink term [m^3/s]
  351: 
  352: 
  353:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  354:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  355: 
  356:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  357:    __inline__ __device__ int nodeLocalIdx(Node *node) const { 
  358:       int res = (nodes[0] == node) ? 0 : ((nodes[1] == node) ? 1 : ((nodes[2] == node) ? 2 : 3)); 
  359:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  360:       return res;
  361:    }
  362: 
  363:    __inline__ __device__ double z_prism(int k) const { return 0.5*(z[k+1] + z[k]); }
  364:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  365: 
  366:    __inline__ __device__ double computeSignedArea(void) const;
  367: 
  368:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  369:       // Nudges the point (x,y) to the barycenter of the element
  370:       p = (1-eps)*p + eps*toVector2(center);
  371:    }
  372: 
  373:    __device__ bool computeShapeCoords(Point2 xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  374: 
  375:    __device__ Vector2 grad(double *a) const
  376:    {
  377:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  378:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  379:       if (isQuad()) {
  380:          gx += a[3]*gradPhi[3].x;
  381:          gy += a[3]*gradPhi[3].y;
  382:       }
  383:       return {gx, gy};
  384:    }
  385: 
  386:    __device__ void setFrame(void) {
  387: 
  388:       double ar1, ar2;
  389:       computeLonLat(center, ar1, ar2);
  390: 
  391:       frame.update(ar1, ar2);        
  392:     }
  393: 
  394:    __device__ bool findNextIntersection(Point2 x2, Side *&side, Element *&nextElement, double &t, 
  395:                                         double& tIntersect);
  396:    __device__ bool findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement, double &t, 
  397:                                         double& tIntersect);
  398: 
  399:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  400:       // Check if the point (xt,yt) is inside the element
  401:       double shpCoords[4];
  402:       bool res = computeShapeCoords(xt, shpCoords, false);
  403:       return res;
  404:    }
  405: 
  406:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4])
  407:    {
  408:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  409:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  410:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  411:       
  412:    }
  413: 
  414:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int);
  415: 
  416:    // ------------------------------------------------------------------------------------------------
  417:    // These are functions that work on all nodes of the element.
  418:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  419:    //
  420:    // An example of how to use these functions is:
  421:    //   
  422:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  423:    // 
  424:    // Where L is the level at which the field is to be interpolated. The field can be either
  425:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  426:    // There are different versions of getNodalValues for each of these cases.
  427: 
  428:    template<typename T>
  429:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  430:       // Get the values of the field at the nodes of the element
  431:       res[0] = nodes[0]->*field;
  432:       res[1] = nodes[1]->*field;
  433:       res[2] = nodes[2]->*field;
  434:       if (isQuad()) res[3] = nodes[3]->*field;
  435:       else          res[3] = T();
  436:    }
  437: 
  438:    template<typename T>
  439:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  440:       // Get the values of the field at the nodes of the element
  441:       res[0] = (nodes[0]->*field)[level];
  442:       res[1] = (nodes[1]->*field)[level];
  443:       res[2] = (nodes[2]->*field)[level];
  444:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  445:       else          res[3] = T();
  446:    }    
  447: 
  448:    template<typename T>
  449:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  450:       // Get the values of the func at the nodes of the element
  451:       res[0] = (nodes[0]->*func)(level);
  452:       res[1] = (nodes[1]->*func)(level);
  453:       res[2] = (nodes[2]->*func)(level);
  454:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  455:       else          res[3] = T();  // This is 0.0 or a zero vector
  456: 
  457:    }      
  458: 
  459: 
  460:    __device__ double interpolate(int level, const double shapeCoords[4], double (Node::*func)(int) const) const {
  461:       double values[4];
  462:       getNodalValues(level, func, values);
  463: 
  464:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  465:    }
  466: 
  467:    template<typename T>
  468:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  469:       T values[4];
  470:       getNodalValues(field, values);
  471:       
  472:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  473:    }
  474: 
  475: 
  476:    template<typename T>
  477:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  478:       T values[4];
  479:       getNodalValues(level, field, values);
  480: 
  481:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  482:    }
  483: 
  484:    template<typename T>
  485:    __device__ T mean(T Node::* field) const {
  486:       T values[4];
  487:       getNodalValues(field, values);
  488:       
  489:       return (values[0] + values[1] + values[2] + values[3])/i34;
  490:    }
  491: 
  492:    // __device__ double mean(double (Node::*func)(int) const) const {
  493:    //    double values[4];
  494:    //    getNodalValues(level, func, values);
  495:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  496:    // }
  497:    // ------------------------------------------------------------------------------------------------
