 2172: __host__ __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2173: 
 2174: __device__ double Node::compZCoord(int k) const {
 2175:    // Computes the z coordinate at level k.
 2176:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2177:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2178:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2179:    // used 
 2180:    
 2181:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2182:       
 2183:    if (isDry)  return 0.0;
 2184: 
 2185:    if constexpr(ivcor == 2) {
 2186: 
 2187:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2188:       const int kz = mesh->kz;
 2189: 
 2190:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2191:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2192:       // once per time step/node.
 2193:       // CHECK: updateZCoordData
 2194:       if (k == kz)               return -hmod2;
 2195:       else if (k == nvrt-1)      return eta2;
 2196:       else if (k == kb)          return -depth;
 2197:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2198:       else if (k > kz) {
 2199:          const int ksig = k - kz + 1;
 2200: 
 2201:          if (hmod2 <= mesh->h_c) {
 2202:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2203:          } 
 2204:          else if (eta2 <= - mesh->h_c - (depth - mesh->h_c) * mesh->theta_f/mesh->sinh_theta_f) {
 2205:             printf("Please choose larger h_c: %f %f\n", eta2, mesh->h_c);
 2206:             Error("ZCOOR: invalid h_c\n");
 2207:          } 
 2208:          else {
 2209:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2210:                          mesh->h_c * mesh->sigma[ksig] + 
 2211:                          (hmod2 - mesh->h_c) * mesh->cs[ksig];
 2212:          }
 2213:       } else { 
 2214:          Error("ZCOOR: invalid level or coordinate system\n");
 2215:       }
 2216: 
 2217:    }
 2218:    else if constexpr(ivcor == 1) {
 2219:       if (k == kb) return -depth;
 2220:       else if (k == nvrt-1) return eta2;
 2221:       else if (k >= kb) {
 2222:             return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2223:       }
 2224:    }
 2225:    
 2226:    printf("ZCOOR: invalid level or coordinate system\n");
 2227:    return 0.0;
 2228: }
