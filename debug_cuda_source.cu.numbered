 4980: __global__ void getStructSizes(int* sizes)  {
 4981:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 4982:       sizes[0] = (int)sizeof(Node);
 4983:       sizes[1] = (int)sizeof(Element);
 4984:       sizes[2] = (int)sizeof(Side);
 4985:       sizes[3] = (int)sizeof(NodeBoundary);
 4986:       sizes[4] = (int)sizeof(SideBoundary);
 4987:       sizes[5] = (int)sizeof(BoundarySegment);
 4988: }
