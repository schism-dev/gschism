 2976: extern "C" {
 2977: 
 2978:    __global__ void scaleGravity(double loadtide_coef) {
 2979: 
 2980:       printf("scaleGravity: i = %d, np = %d\n", threadIdx.x + blockIdx.x * blockDim.x,mesh->np);
 2981:       NODE(node);
 2982: 
 2983:       // SAL option: scale gravity
 2984:       if constexpr(iloadtide==2) {  // simple const
 2985:          node->grav2 = grav*(1.0 - loadtide_coef);
 2986: 
 2987:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 2988:         
 2989:           const double depth = max(node->depth, 0.0);
 2990:           const double tmp1 = sqrt(depth);
 2991:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 2992:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 2993:                              2.6969e-13*depth*depth*depth*tmp1;
 2994:           
 2995:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 2996:           
 2997: 
 2998: 
 2999:           node->grav2 = grav*(1.0 - beta_bar);
 3000: 
 3001:       } else {  // iloadtide=0,1
 3002:         node->grav2=grav;
 3003: 
 3004:       }
 3005: 
 3006:       printf("scaleGravity: node(%d)->grav2 = %f\n", node->idx, node->grav2);
 3007:    }
 3008: 
