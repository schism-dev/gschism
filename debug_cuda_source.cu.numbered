  803: struct Node {
  804: 
  805:    // Geometry information
  806:    int idx;        // Index of the node
  807:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
  808:    int numNodes;   // Number of nodes neighbors of this node
  809: 
  810:    Element **elements; // Array of pointers to the elements that share this node
  811:    int numElements;   // Number of elements that share this node
  812: 
  813:    Point3 p;
  814:    Vector3 u2[nvrt];
  815:    double znl[nvrt];
  816:    double lon, lat;
  817:    double fun_lat[ntip]; // XXXXX CHECK IF THIS MAKES SENSE
  818:    double depth;
  819: 
  820:    int kb;       // Bottom index of the node
  821: 
  822:    bool isDry;     // True if the node is dry
  823: 
  824:    int iadv;     // Advection flag
  825: 
  826:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
  827: 
  828:    // Physical information
  829:    Tracers tr_nd0[nvrt]; // Initial tracer conc. at nodes
  830: 
  831:    double rho[nvrt];     // Density
  832: 
  833:    double eta1; // Elevation at nodes at previous timestep
  834:    double eta2; // Elevation at nodes at current timestep
  835: 
  836:    double ETP;  // Earth Tidal Potential
  837: 
  838:    
  839:    double pr;    // Air pressure
  840:    double grav2; // Gravity 
  841:    
  842:    Vector2 dav;  // Depth averaged velocity
  843: 
  844:    Vector2 tau; // Wind stress vector
  845: 
  846:    // Vegetation parameters
  847:    double veg_h;
  848:    double veg_nv;
  849:    double veg_di;
  850:    double veg_Cd;
  851:    double veg_h_unbent;
  852:    double veg_di_unbent;
  853:    double veg_nv_unbent;
  854:    double veg_alpha_vert_mean;
  855:    double veg_alpha0;
  856:    double veg_alpha3D[nvrt];
  857: 
  858:    // Bottom drag parameters
  859:    double Cd;       // Bottom drag coefficient
  860:    double rough;    // Bottom roughness length
  861:    Vector2 tau_bot; // Bottom stress vector
  862: 
  863:    double bdef1; // Bottom deformation at previous timestep
  864:    double bdef2; // Bottom deformation at current timestep
  865: 
  866:    double qel; // RHS
  867:    double coeffDiag; // Diagonal coefficient of the matrix
  868:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
  869: 
  870:    // Meteorological forcing
  871:    Vector2 u_air;
  872:    double p_air;
  873:    double t_air;
  874:    double q_air;
  875:    double wind_angle;  // Wind rotation angle
  876: 
  877:    __host__ __device__ void setWind(Vector2 &u) {
  878:    // Sets the wind vector taking into account the wind rotation angle
  879:    
  880:       const double dir = atan2(-u.x,-u.y);
  881:       const double speed = length(u);
  882: 
  883:       // Calculate new u and v components with added rotation angle
  884:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
  885:    }
  886: 
  887:    __host__ __device__ Point2 p2(void) const { return {p.x, p.y}; }
  888: 
  889:    __host__ __device__ double sigmaTransitionDepth(void) const;
  890: 
  891:    __inline__ __device__ double Dz(int k) const { return znl[k] - znl[k-1]; }
  892:    __inline__ __device__ double htot(void) const { return eta2 + depth; }
  893:    __inline__ __device__ double zTopCanopy(void) const { return znl[kb] + veg_h; } 
  894: 
  895:    __device__ void clearMatrixRow(void) {
  896:       // Clear the matrix row for this node
  897:       coeffDiag = 0.0;
  898:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
  899: 
  900:    }
  901: 
  902:    __device__ void addToSparseMatrix(Node const *node, double value) {
  903:       // Add the value to the sparse matrix for this node
  904:       
  905:       if (node == this) {
  906:          coeffDiag += value;
  907:       } else {
  908:          // Search (linearly)the index of the node in the array of nodes
  909:          // XXX: This is not efficient, see if we can improve this
  910:          int i;
  911:          for (i = 0; i < numNodes; i++) {
  912:             if (nodes[i] == node) {
  913:                break;
  914:             }
  915:          }
  916:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
  917:          coeffMatrix[i] += value;
  918:       }
  919:    }
  920: 
  921: #ifdef BACKTRACKING
  922:    __device__ void updateZCoordData() {
  923:    // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
  924: 
  925:       // Check if node is wet
  926:       isDry = (depth + eta2 <= h0);  // XXX Check if we are doing this elsewhere
  927: 
  928:       if (idry) return;
  929: 
  930:       if constexpr(ivcor == 2) {  // SZ coordinates
  931:          
  932:          // Compute bottom level index
  933:          if (depth <= mesh->h_s) {
  934:                kb = mesh->nzlevels;
  935:          } else {
  936:                kb = -1;
  937:                for (int i = 0; i < mesh->kz-1; i++) {
  938:                   if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
  939:                      kb = i;
  940:                      break;
  941:                   }
  942:                }
  943:          }
  944:       } 
  945:       else if (ivcor == 1) {  // Localized sigma
  946:          // Do nothing
  947:       }
  948: 
  949:    }
  950: #endif   
  951: 
  952:    __device__ double compZCoord(int k) const;
  953: 
  954: 
  955: 
  956: };
