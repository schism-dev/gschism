   57: // VECTOR/POINT operations ---------------------------------------------------------------------------
   58: 
   59: using Vector2 = double2; 
   60: using Vector3 = double3;
   61: using Point2  = double2;
   62: using Point3  = double3;
   63: 
   64: __device__ __host__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
   65:     return make_double2(a.x + b.x, a.y + b.y);
   66: }
   67: 
   68: __device__ __host__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
   69:     a.x += b.x;
   70:     a.y += b.y;
   71:     return a;
   72: }
   73: 
   74: __device__ __host__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
   75:     return make_double2(a.x - b.x, a.y - b.y);
   76: }
   77: 
   78: __device__ __host__ __forceinline__ double2 operator*(const double2& v, double s) {
   79:     return make_double2(v.x * s, v.y * s);
   80: }
   81: 
   82: __device__ __host__ __forceinline__ double2 operator*(double s, const double2& v) {
   83:     return v * s;  // reuse the previous operator
   84: }
   85: 
   86: __device__ __host__ __forceinline__ double2 operator/(const double2& v, double s) {
   87:     return make_double2(v.x / s, v.y / s);
   88: }
   89: 
   90: __device__ __host__ __forceinline__ double length(const double2& v) {
   91:     return sqrt(v.x*v.x + v.y*v.y);
   92: }
   93: 
   94: __device__ __host__ __forceinline__ double dot(const double2& v, const double2& w) {
   95:     return v.x*w.x + v.y*w.y;
   96: }
   97: 
   98: __device__ __host__ __forceinline__ double cross(const double2& v, const double2& w) {
   99:     return v.x*w.y - v.y*w.x;
  100: }
  101: 
  102: __device__ __host__ __forceinline__ double3 operator+(const double3& a, const double3& b) {
  103:     return make_double3(a.x + b.x, a.y + b.y, a.z + b.z);
  104: }
  105: 
  106: __device__ __host__ __forceinline__ double3 operator+=(double3& a, const double3& b) {
  107:     a.x += b.x;
  108:     a.y += b.y;
  109:     a.z += b.z;
  110:     return a;
  111: }
  112: 
  113: __device__ __host__ __forceinline__ double3 operator-(const double3& a, const double3& b) {
  114:     return make_double3(a.x - b.x, a.y - b.y, a.z - b.z);
  115: }
  116: 
  117: __device__ __host__ __forceinline__ double3 operator*(const double3& v, double s) {
  118:     return make_double3(v.x * s, v.y * s, v.z * s);
  119: }
  120: 
  121: __device__ __host__ __forceinline__ double3 operator*(double s, const double3& v) {
  122:     return v * s;
  123: }
  124: 
  125: __device__ __host__ __forceinline__ double3 operator/(const double3& v, double s) {
  126:     return make_double3(v.x / s, v.y / s, v.z / s);
  127: }
  128: 
  129: __device__ __host__ __forceinline__ double dot(const double3& v, const double3& w) {
  130:     return v.x*w.x + v.y*w.y + v.z*w.z;
  131: }
  132: 
  133: __device__ __host__ __forceinline__ Vector2 toVector2(const double3& v) {
  134:     return make_double2(v.x, v.y);
  135: }
  136: 
  137: __device__ __host__ __forceinline__ double3 toVector3(const double2& v, double w) {
  138:     return make_double3(v.x, v.y, w);
  139: }
  140: 
  141: __device__ __host__ __forceinline__ Point2 toPoint2(const double3& p) {
  142:     return make_double2(p.x, p.y);
  143: }
  144: 
  145: __device__ __host__ __forceinline__ Point3 toPoint3(const double2& p, double z) {
  146:     return make_double3(p.x, p.y, z);
  147: }
