 1717: 
 1718: __inline__ __device__ double Element::computeSignedArea(void) const {
 1719:    // Compute the area of the element
 1720: 
 1721:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 1722: 
 1723:    // In the quad case we need to add the area of the other triangle.
 1724:    if (isQuad()) {
 1725:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1726:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 1727:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1728:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 1729:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 1730:          Error("Negative area found in quad element");
 1731:       }
 1732:       res += ar1;
 1733:    }
 1734: 
 1735:    return res;
 1736: }
 1737: 
 1738: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 1739:    // In boundary sides, the element 1 is nullptr
 1740:    return side->elems[1] == nullptr; 
 1741: }
 1742: 
 1743: 
 1744: 
 1745: /**
 1746:    Compute the shape coordinates of the point (xt,yt) in the element.
 1747:    @param xt (input): x-coordinate of the point
 1748:    @param shpCoords (output): shape coordinates of the point
 1749:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 1750:    @return true if the point is inside the element, false otherwise
 1751: **/
 1752: __device__ bool Element::computeShapeCoords(Point2 xt, double shpCoords[4],
 1753:                                             bool fixNegshpCoord) const {
 1754: 
 1755:    // Compute the shape coordinates of the point xt in the element.
 1756:    if (i34==3) {
 1757:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 1758:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 1759:       // and in this case, the pt will be nudged into the element
 1760:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 1761:       // from the local frame, so use additional check.
 1762: 
 1763:       Point2 x0, x1, x2;
 1764: 
 1765:       if constexpr(ics==1) {
 1766:          x0 = nodes[0]->p2();
 1767:          x1 = nodes[1]->p2();
 1768:          x2 = nodes[2]->p2();
 1769:       }
 1770:       else // lat/lon
 1771:       {
 1772:          Error("Not implemented yet");
 1773: #ifdef ICS2
 1774:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 1775:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 1776:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 1777: #endif
 1778:       }
 1779: 
 1780:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 1781:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 1782:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 1783:       shpCoords[3] = 0.0;
 1784:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 1785: 
 1786:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 1787:       // then we fix the negative shape coordinates.
 1788:       if (fixNegshpCoord && tmpmin<=0.0) {
 1789: 
 1790:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 1791:          // keeping the sum of the shape coordinates equal to 1.
 1792:          // I have tested and compared the new algorithm with the old one, and they give
 1793:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 1794:          // The new algorithm should be faster since it is branchless.
 1795:          const double a = - tmpmin + 1.0e-2;  // XXX it used to be 1.0e-4 in the comments of the original code
 1796:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 1797:          
 1798:          shpCoords[0] = (shpCoords[0] + a)*b;
 1799:          shpCoords[1] = (shpCoords[1] + a)*b;
 1800:          shpCoords[2] = (shpCoords[2] + a)*b;          
 1801: 
 1802:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 1803:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 1804:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 1805:          }
 1806: 
 1807:          // Update the point coordinates for the new shape coordinates
 1808:          double xcoords[3] = {x0.x, x1.x, x2.x};
 1809:          double ycoords[3] = {x0.y, x1.y, x2.y};
 1810:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 1811: 
 1812:       }
 1813: 
 1814:       // Check if the point is inside the element
 1815:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 1816:    }
 1817:    else {
 1818:       Error("Not implemented yet");
 1819: #ifdef QUADS
 1820:       // Reproject pt in eframe of nel for ics=2
 1821:       if constexpr(ics==1) {
 1822:          xn2 = xt; 
 1823:          yn2 = yt;
 1824:       }
 1825:       else {
 1826:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 1827:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 1828:       }
 1829: 
 1830:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 1831: #endif
 1832:    }
 1833: 
 1834: }
 1835: 
 1836: 
 1837: /**  Interpolate velocities at a given point (xt,yt,zt)
 1838: 
 1839:    @param xt, yt, zt: coordinates of the point to interpolate
 1840:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 1841: 
 1842:    This is done in four steps:
 1843: 
 1844:    1. Find the shape coordinates for the final position in the element.
 1845:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 1846:    3. Perform a *binary search* to find the vertical level containing zt. It will have to interpolate the 
 1847:       z levels at xt, yt at each step.   
 1848:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 1849:       horizontally and vertically.
 1850: **/
 1851: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) {
 1852:    // Interpolate the velocities at the point xt. 
 1853:    // This function works the same for triangular and quadrilateral elements.
 1854:    double shpCoord[4];
 1855: 
 1856: 
 1857:    // First step is to compute the shape coordinates of (xt,yt)
 1858:    computeShapeCoords(toVector2(xt), shpCoord, false);
 1859:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 1860: 
 1861:    // Second step is to find the level that contains zt
 1862:    // Uses a binary search to find the level
 1863:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 1864:    int L = kbe;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 1865:    int R = nvrt - 1;
 1866: 
 1867:    // Get the z coordinates at the nodes of the element at the levels L and R
 1868:    double zLAtNodes[4], zRAtNodes[4];
 1869:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 1870:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 1871: 
 1872:    double zL = interpolate(shpCoord, zLAtNodes);
 1873:    double zR = interpolate(shpCoord, zRAtNodes);
 1874:    
 1875:    // Interpolates vertically the velocities
 1876:    double wght1, wght2;
 1877:    if (xt.z<=zL) {
 1878:       wght1 = 1.0;
 1879:       wght2 = 0.0;
 1880:    }
 1881:    else if (xt.z>=zR) {
 1882:       wght1 = 0.0;
 1883:       wght2 = 1.0;
 1884:    }
 1885:    else {
 1886:       // Perform a binary search to find the levels between L and R that contain xt.z
 1887:       while (R - L > 1) {
 1888:          int M = (L + R) / 2;
 1889: 
 1890:          double zMAtNodes[4];
 1891:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 1892:          double zM = interpolate(shpCoord, zMAtNodes);
 1893:          if (zM < xt.z) 
 1894:          {
 1895:             L = M;
 1896:             zL = zM;
 1897:          }
 1898:          else 
 1899:          {
 1900:             R = M;
 1901:             zR = zM;
 1902:          }
 1903:       }
 1904:       assert(L == R-1);
 1905:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 1906: 
 1907:       wght2 = (xt.z - zL)/(zR - zL);
 1908:       wght1 = 1.0 - wght2;
 1909:    }
 1910: // printf("$$$ wght1 = %f, wght2 = %f, zt = %f, zL = %f, zR = %f\n", wght1, wght2, zt, zL, zR);
 1911: // printf("$$$ shpCoord = %f, %f, %f, %f\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 1912:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 1913:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 1914: 
 1915:    // Neither of the interpolated velocities should be NaN
 1916:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 1917: 
 1918: }
 1919: 
 1920: 
 1921: 
 1922: __inline__ __device__ double Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 1923: __inline__ __device__ double Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 1924: __inline__ __device__ Point2 Side::p_t(double t) const { return {x(t), y(t)}; }
 1925: __inline__ __device__ int    Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 1926: __inline__ __device__ double Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 1927: __inline__ __device__ double Side::depth(void)   const { return 0.5*(n1->depth + n2->depth); }
 1928: 
 1929: __inline__ __device__ double Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 1930: __inline__ __device__ double Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 1931: __inline__ __device__ double Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 1932: 
 1933: 
 1934: __inline__ __device__ double Side::Cd(void)      const { if constexpr(nchi != 0) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 1935: 
 1936: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 1937: 
 1938: /**
 1939:  * This method performs backtracking from the side center until a time -dt back in time 
 1940:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 1941:  * intermediate point.
 1942:  *
 1943:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 1944:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 1945:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 1946:  * remaining time.
 1947:  * 
 1948:  * NOTE: Runge-Kutta is not implemented yet. XXX
 1949:  * 
 1950:  * @param uuint, vvint, wwint: Velocities at the final point
 1951:  * @param jlev: Level at which the backtracking is performed
 1952:  * @param dt, dtbk: Tracking timesteps
 1953:  * @return: True if the backtracking was successful, false otherwise
 1954:  */
 1955: __inline__ __device__ bool Side::btrack(
 1956:       int jlev,
 1957:       double dt,            // Tracking time
 1958:       double dtbk,          // Tracking timestep
 1959:       Vector3 &u_int
 1960: ) const {
 1961: 
 1962:    // Start from side center
 1963:    Point3 x0 = {center.x, center.y, zc[jlev]};
 1964:  
 1965: 
 1966:    double time_rm = dt; // Remaining time
 1967: 
 1968: 
 1969:    // // Initialize outputs XXX
 1970:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 1971:    //    sclr[i] = 0.0;
 1972:    // }
 1973: 
 1974: 
 1975:    // Initial velocities
 1976:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 1977: 
 1978:    // Find the element that is in the direction opposite to the velocity
 1979:    Element* curElem = findElementTowards({u_int.x, u_int.y});
 1980: 
 1981: 
 1982:    const int MAX_ITERATIONS = 1000; 
 1983:    Element* nextElem = curElem;
 1984:    int iter = 0;
 1985:    while(true) {
 1986:       // Calculate timestep
 1987:       double dtb = min(dtbk, time_rm);
 1988: 
 1989:       // Next point in the backtracking curve
 1990:       Point3 xt = x0 - dtb*u_int;
 1991: 
 1992:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb);
 1993:       assert(found && "Backtracking failed in btrack");
 1994: // printf("<>T = %f, %f %f %f\n", time_rm - dtb, xt, yt, zt);
 1995:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 1996:                       // then time_rm needs to be increased by the unused time.
 1997: 
 1998: 
 1999:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2000: 
 2001:       // The current point becomes the next segment's starting point.
 2002:       x0 = xt;
 2003:  
 2004:       curElem = nextElem;
 2005: 
 2006:       iter++;
 2007:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2008:    }
 2009: 
 2010: 
 2011: }
 2012: 
 2013: 
 2014: 
 2015: // /**
 2016: //    For a point (x1,y1) inside the element and a line segment (x1,y1)-(x2,y2), find the intersection point 
 2017: //    (xIntersect,yIntersect) and the side (intersectingSide) that it intersects.
 2018: 
 2019: //    Inputs:
 2020: //    @param x1, y1: point inside the element
 2021: //    @param x2, y2: other end of the line segment
 2022: 
 2023: //    Outputs:
 2024: //    @param intersectingSide:  side that intersects the line segment
 2025: //    @param nextElement: element that contains the intersection point
 2026: //    @param xIntersect, yIntersect: intersection point  
 2027: 
 2028: //    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 2029: //    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 2030: //    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 2031: 
 2032: //    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 2033: //    (Delta) being zero.
 2034: 
 2035: //    The intersection point happens when:
 2036: //    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 2037: //    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 2038:    
 2039: //    Assumption: the 4 points (including those of the side segment) are different.
 2040: //    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 2041: //    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 2042: //    If true, (xIntersect,yIntersect) is the intersection.				
 2043: //    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 2044: // **/
 2045: // __inline__ __device__ bool Element::findPathIntersection(double x1, double y1, double x2, double y2, 
 2046: //                                                          Side& intersectingSide, Element& nextElement,
 2047: //                                                          double& xIntersect, double& yIntersect) {
 2048: //    for (int i = 0; i < i34; i++) {
 2049: //       const double x3 = nodes[i]->x;
 2050: //       const double y3 = nodes[i]->y;
 2051: //       const double x4 = nodes[nxq(i+1)]->x;
 2052: //       const double y4 = nodes[nxq(i+1)]->y;
 2053: 
 2054: //       const Side& side = sides[i];
 2055: 
 2056: //       xIntersect=-1.e25;
 2057: //       yIntersect=-1.e25;
 2058: 
 2059: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 2060: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 2061: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 2062: 
 2063: //       if (delta != 0.0) {
 2064: //          // Solves the two linear equations for tt1 and tt2
 2065: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2066: //          const double tt2 = delta2/delta;
 2067: 
 2068: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 2069: //          // Similarly, we use tt2 to compute the intersection point.
 2070: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 2071: //             xIntersect = x3 + (x4 - x3)*tt2;
 2072: //             yIntersect = y3 + (y4 - y3)*tt2;
 2073: 
 2074: //             intersectingSide = side;
 2075: //             nextElement = nghbElems[i];
 2076: 
 2077: //             return true;
 2078: //          }
 2079:       
 2080: //       }
 2081: //       else {
 2082: //          // The two segments are parallel
 2083: //          return false;
 2084: //       }
 2085: 
 2086: //    }
 2087: 
 2088: //    return false;
 2089: 
 2090: // }
