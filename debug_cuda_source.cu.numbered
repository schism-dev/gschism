 3262:    __global__ void computeElevationBoundaryConditions(double time) {
 3263:       // Compute elevation essential boundary conditions 
 3264: 
 3265:       NODE_BND(nodeBnd); // Each boundary node.
 3266: 
 3267:       const Node *node = nodeBnd->node;
 3268:       const int iettype = nodeBnd->iettype;
 3269: 
 3270:       double eic = 0.0;
 3271:       if (nramp_elev==1) eic = nodeBnd->etaic;
 3272:       else               eic = 0.0;
 3273: 
 3274:       const double r_eic = (1.0 - ramp)*eic; 
 3275:       const double r_eth = ramp*nodeBnd->eth;
 3276:       double eta1_bar = r_eic;
 3277: 
 3278:       // Compute tide elevation
 3279:       if (iettype == 3 || iettype == 5) {
 3280:         
 3281:          // XXX IMPLEMENT TIDE THINGS
 3282:          assert(false && "Tide elevation not implemented");
 3283:          // for (int jfr=0; jfr<nbfr; jfr++) { // For all tide frequencies
 3284:          //    const int ncyc = int(amig[jfr]*time/(2.0*pi));
 3285:          //    const double arg = amig[jfr]*time - 2.0*pi*ncyc + face[jfr] - efa[i,j,jfr];
 3286:          //    eta1_bar += ramp*ff[jfr]*emo[i,j,jfr]*cos(arg);
 3287:          // } // for jfr
 3288:       } // if iettype
 3289: 
 3290:       switch (iettype) {
 3291:          case 1:
 3292:          case 2:
 3293:             nodeBnd->elbc = r_eth + r_eic;
 3294:             break;
 3295:          case 3:
 3296:             nodeBnd->elbc = eta1_bar + r_eic;
 3297:             break;
 3298:          case 4:
 3299:             nodeBnd->elbc = r_eth + r_eic;
 3300:             break;
 3301:          case 5:
 3302:             nodeBnd->elbc = r_eth + eta1_bar + r_eic;
 3303:             break;
 3304:       } // switch
 3305: 
 3306: 
 3307:       //Add inverse barometric effects
 3308:       if (iettype != 0 && inv_atm_bnd == 1) {
 3309:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 3310:       }
 3311: 
 3312:    }
 3313: 
 3314:    __global__ void computeVerticallyIntegratedVelocity(void) {
 3315: 
 3316:       SIDE(side);
 3317: 
 3318: 
 3319:       side->U = {0.0, 0.0}; 
 3320:          
 3321:       if(side->isDry) return;
 3322: 
 3323:       const Node *node1 = side->n1;
 3324:       const Node *node2 = side->n2;
 3325: 
 3326:       // Vertically integrated velocity U (in ll if ics=2)
 3327:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 3328:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 3329:       }
 3330: 
 3331:    }
 3332: 
 3333:    __global__ void computeBottomDragVegetation(void) {
 3334:       // UNFINISHED. CHECK THIS:
 3335:       // How many kernels are needed? Why so many for loops?
 3336:       // Is the loop on sides needed?
 3337: 
 3338:       NODE(node);
 3339: 
 3340:       const int    kb      = node->kb;
 3341:       const double htot    = node->htot();
 3342:       const double rough   = node->rough;
 3343: 
 3344: 
 3345:       if (node->isDry) {
 3346:          // Default values for dry nodes
 3347:          node->veg_alpha_vert_mean = node->veg_alpha0;
 3348:          /// XXX CHECK INDICES
 3349:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 3350:       }
 3351: 
 3352:       // Compute bottom drag Cd
 3353:       //--------------------------------
 3354: 
 3355:       // nchi = {-1, 0, 1} is the type of bottom drag.
 3356:       if (nchi==1) {
 3357: 
 3358:          bool ltmp = false; // for WBL iteration
 3359: 
 3360:          // Cdmax=-1 !max. Cd at node for this process (info only)
 3361:          // Drag at nodes
 3362:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 3363:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 3364:         
 3365:          const double rough = node->rough;
 3366:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3367:          if (node->rough == 0.0) {
 3368:             node->Cd = 0.0;
 3369: 
 3370:          } else { //roughness >0 
 3371:             
 3372:             const double bthick_ori = node->znl[kb + 1] - node->znl[kb];  // thickness of bottom bnd layer
 3373:             const double bthick = max(dzb_min, bthick_ori);
 3374: 
 3375:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 3376: 
 3377:             double tmp = 1.0/(2.5*log(bthick/rough));
 3378:             node->Cd = tmp*tmp;
 3379: 
 3380:          } // if rough
 3381: 
 3382: 
 3383:          // RECOVER THIS: XXX
 3384:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 3385:          // Output warning for WBL if iteration didn't converge
 3386: 
 3387: 
 3388:       } // nchi==1
 3389: 
 3390:       //   Bottom stress in m^2/s^2
 3391:       if (node->rho[kb + 1] >= -98.0)
 3392:       {
 3393:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 3394:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 3395:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 3396:          // !sediment erosion: this part needs more documentation
 3397:       }
 3398: 
 3399:     
 3400:       // Compute vegetation parameters
 3401:       //--------------------------------
 3402: 
 3403:       // SAV constants
 3404:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 3405:       constexpr double veg_cfpsi = 0.16;
 3406: 
 3407:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 3408:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 3409: 
 3410:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 3411:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 3412:          int kbin = 0; // bin index
 3413:          for (int k = kb; k < nvrt; k++) {
 3414:             // Computes node height above the bottom level
 3415:             const double tmp_h = node->znl[k] - node->znl[kb]; // >=0
 3416:             assert(false && "Vertical variation of vegetation not implemented");
 3417: 
 3418:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 3419:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 3420:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 3421:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 3422:             // } else {
 3423:             //    // Find the bin at which the current vertical level is
 3424:             //    while (kbin<nbins_veg_vert) {
 3425:             //       const double zn = node->znl[kbin];
 3426:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 3427:             //          break;
 3428:             //       } // if
 3429:             //       kbin++;
 3430:             //    } // while
 3431:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 3432: 
 3433:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 3434:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 3435:                
 3436:             //    // Linear interpolation of the vegetation parameters
 3437:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 3438:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 3439:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 3440:             // } // if rl10
 3441: 
 3442:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 3443: 
 3444:          } // for k
 3445: 
 3446: 
 3447:       } else { // Ganthy (iveg=2)
 3448:       //  Modify canopy height, diameter, and density
 3449: 
 3450:          // Make sure there is vegetation on this node
 3451:          if (node->veg_h_unbent > 0.0) {
 3452:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 3453: 
 3454:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 3455:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 3456:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 3457: 
 3458:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 3459:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 3460:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 3461:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 3462:          } // if veg_h_unbent
 3463: 
 3464:          for (int k = 0; k < nvrt; k++) {
 3465:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 3466:          } // for k
 3467:       
 3468: 
 3469:       } // if iveg
 3470:      
 3471:          
 3472: 
 3473:       // Compute vertical mean of veg_alpha3D
 3474:       if (iveg != 0) {
 3475:          const double ztop = node->zTopCanopy(); // Top of the canopy
 3476:          double sum1=0.0;
 3477:          double sum2=0.0;
 3478:          // Integrate over each level under the canopy...
 3479:          for (int k=kb; k<nvrt-1 && node->znl[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 3480:             const double Dz = node->Dz(k);
 3481: 
 3482:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 3483:             sum2 += Dz;
 3484: 
 3485:          } // for k
 3486: 
 3487:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 3488:          else             node->veg_alpha_vert_mean = sum1/sum2;
 3489: 
 3490:       } // if iveg
 3491: 
 3492:       printf("computeBottomDragVegetation: nodeIdx = %d, node->veg_alpha_vert_mean = %f\n", node->idx, node->veg_alpha_vert_mean);
 3493: 
 3494:    }
 3495: 
 3496:    __global__ void computeVegetationAndDragParameters(void) {
 3497:       // Computes the vegetation and drag model parameters:
 3498:       // chi, \tilde\chi, beta, \breve{H}
 3499:       
 3500:       SIDE(side);
 3501: 
 3502:       const double htot = side->htot();
 3503:       const int    kb   = side->kb;
 3504: 
 3505:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 3506: 
 3507:       const double veg_h     = side->veg_h();
 3508:       const double veg_nv    = side->veg_nv();
 3509:       const double veg_c     = side->veg_c();
 3510:       const double veg_beta  = side->veg_beta;
 3511:       const double veg_alpha = side->veg_alpha_vert_mean();
 3512: 
 3513:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 3514:       // Velocity magnitude at the bottom level
 3515:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 3516:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 3517:       side->chi2 = side->Cd()*vmag1;
 3518:       side->chi  = side->chi2;
 3519:       if constexpr(iveg != 0) {
 3520:          const Node *n1 = side->n1;
 3521:          const Node *n2 = side->n2;
 3522:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 3523:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 3524:       }
 3525: 
 3526:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 3527: 
 3528:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 3529:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 3530:       double magUa = 0.0;
 3531:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 3532:          // 3D wet side with veg...
 3533: 
 3534:          double magUa = 0.0;
 3535:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 3536:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 3537: 
 3538:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 3539:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 3540:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 3541: 
 3542:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 3543:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 3544: 
 3545:                // Velocity magnitude at the bottom (l) of the level
 3546:                const double ul = length(side->u2[k]);
 3547: 
 3548:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 3549:                magUa += Dz*0.5*(uh + ul);
 3550: 
 3551:             } // if HasVegetation
 3552:          } // for k
 3553:          const double ua = magUa/min(htot, veg_h); // Vertical average
 3554: 
 3555:          // Computes beta, used for computing the stress term at the top of the canopy.      
 3556:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 3557:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 3558:             const double zCpy = side->zTopCanopy();
 3559:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 3560:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 3561:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 3562:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 3563:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 3564:          } // if isSubmerged
 3565:       } // if iveg   
 3566: 
 3567:       // Computes the friction modified depth, \breve{H} in notes
 3568:       if (side->is2D()) { // 2D
 3569: 
 3570:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 3571:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 3572: 
 3573:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 3574: 
 3575:          side->hhat = htot*htot/fricH; 
 3576: 
 3577:       } else { // 3D
 3578:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 3579: 
 3580:          if constexpr(iveg != 0) {
 3581:             
 3582:             if (side->isSubmerged()) { 
 3583:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 3584:                side->hhat -= veg_c*Hhat_alpha;
 3585: 
 3586:             } else { // Emergent
 3587:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 3588:             }
 3589:          } // if iveg
 3590: 
 3591:          // Enforce positivity for 3D model
 3592:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 3593:       } // if 3D
 3594: 
 3595:       printf("computeVegetationAndDragParameters: sideIdx = %d, side->htot = %f, side->hhat = %f\n", side->idx, side->htot(), side->hhat);
 3596: 
 3597:         
 3598:    }
 3599: 
 3600: 
 3601: 
 3602:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 3603:    // Computes the density gradient between two elements, e1 and e2.
 3604:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 3605:    // zero in the direction normal to the side. 
 3606:    // 
 3607:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 3608:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 3609:    //
 3610:    // Input:
 3611:    //    e1: Element
 3612:    //    e2: Neighbor element (or nullptr if boundary)
 3613:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 3614:    //    k: Index of the half-level at which the density is interpolated
 3615:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 3616:    // 
 3617:    // Output:
 3618:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 3619:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 3620: 
 3621:       if (e2 == nullptr || e2->isDry) {
 3622:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 3623: 
 3624:          Side *side = e1->sides[j];
 3625:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 3626:                  
 3627:          if constexpr(ics == 1) {
 3628:             vec = side->n; // Normal vector to the side
 3629:          } else {
 3630:             // IMPLEMENT THIS XXXXXX
 3631:             // !replace with xel, yel?
 3632:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 3633:             //      &eframe(:,:,i),xn1,yn1,tmp)
 3634:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 3635:             //      &eframe(:,:,i),xn2,yn2,tmp)
 3636:          } //ics
 3637:                    
 3638:          diffRho = 0.0;
 3639: 
 3640:       } else { //internal and wet
 3641:          if constexpr(ics==1) {
 3642:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 3643: 
 3644:             // Vector from e1 to e2
 3645:             vec = toVector2(e2->center - e1->center);
 3646: 
 3647:          } else { 
 3648:             // IMPLEMENT THIS XXXXXX
 3649:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 3650:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 3651:             //                   alow(j)=xctr2
 3652:             //                   bdia(j)=yctr2
 3653:          } // ics
 3654: 
 3655:          diffRho = rho2 - e1->demeanedDensity(k);
 3656:       }
 3657: 
 3658:    }
 3659: 
 3660:    __global__ void computeDensityCubicSplines(void) {
 3661:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 3662: 
 3663:       ELEM(elem);
 3664: 
 3665:       if (elem->isDry) return;
 3666: 
 3667:       const int kb = elem->kb;
 3668: 
 3669:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 3670:       if (elem->is2D()) {
 3671:          // In the 2D case, the density is constant at the prism level. 
 3672:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 3673:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 3674:       } else { //3D
 3675: 
 3676:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 3677:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 3678:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 3679:          ///// XXXX CHECK INDICES!!!!!
 3680:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 3681:       } // 2D/3D
 3682: 
 3683:    }
 3684: } // extern "C"
 3685: 
 3686: 
 3687: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 3688: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 3689: 
 3690:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 3691: 
 3692:    const int kb  = elem->kb;
 3693:    const int kb2 = elem2->kb;
 3694: 
 3695:    // z-coordinate of prism of elem
 3696:    const double zp = elem->z_prism(k);
 3697: 
 3698:    double rho = 0.0;
 3699: 
 3700:    if (elem2->is2D()) {
 3701:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 3702: 
 3703:    } else {  // 3D
 3704: 
 3705:       // eta_min may be < zmax
 3706:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 3707:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 3708: 
 3709:       // (Extrapolate density below bottom, we will fix it later)
 3710:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 3711:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 3712:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 3713:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 3714:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 3715:    } // 2D/3D
 3716:      
 3717: 
 3718:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 3719:    // Now we need to fix it.
 3720:    if (elem->z[k] < elem2->z[kb2]) {
 3721:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 3722: 
 3723:       // There are two methods to adjust the density at the bottom of the element.
 3724:       // iunder_deep=0: 
 3725:       const double depth1 = abs(elem->z[kb]); // larger depth
 3726: 
 3727:       if (iunder_deep==0) {
 3728: 
 3729:          const double weight = max(0.0, min(1.0, (depth1 - h1_bcc)/(h2_bcc - h1_bcc))); // weight
 3730: 
 3731:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 3732: 
 3733:       } else { // iunder_deep != 0
 3734: 
 3735:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 3736: 
 3737:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 3738: 
 3739:          //   Demeaned density at the same z coordinate as
 3740:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 3741:          }
 3742: 
 3743:       } // if iunder_deep
 3744:    } // if elem->z[kb] < elem2->z[kb]
 3745: 
 3746:    return rho;
 3747: }
 3748: 
 3749: 
 3750: extern "C" {
 3751:    __global__ void computeDensityGradient(void) {
 3752: 
 3753:          // Compute the horizontal density gradient at each element.
 3754:       // It works in two steps:
 3755:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 3756:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 3757:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 3758:       //             gradRho.r1 = rho1 - rho0
 3759:       //             gradRho.r2 = rho2 - rho0
 3760:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 3761:       // 
 3762:       //  NOTE: We use de-meaned densities.
 3763: 
 3764:       ELEM(elem);
 3765: 
 3766:       if (elem->isDry) return;
 3767: 
 3768:       const int kb  = elem->kb;
 3769:       const int i34 = elem->i34;
 3770: 
 3771:       for (int k = kb + 1; k < nvrt; k++) {
 3772:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 3773:          //             gradRho.r1 = rho1 - rho0
 3774:          //             gradRho.r2 = rho2 - rho0
 3775:          int icount = 0;
 3776:          double sumRx = 0.0;
 3777:          double sumRy = 0.0;
 3778:          for (int j1=0; j1<i34; j1++) { 
 3779: 
 3780:             const int j2 = elem->nxq(j1 + 1);
 3781: 
 3782:             // Pairs of consecutive neighbor elements of elem
 3783:             const Element *e1 = elem->nghbElems[j1];
 3784:             const Element *e2 = elem->nghbElems[j2];
 3785: 
 3786:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 3787:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 3788:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 3789: 
 3790:             // Compute the density difference and the vector from elem to e1 and e2
 3791:             // getRhoDiffAndVec takes into account boundaries/dry elements
 3792:             double diffRho1, diffRho2;
 3793:             Vector2 vec1, vec2;
 3794:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 3795:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 3796: 
 3797:             const double rl1 = length(vec1);
 3798:             const double rl2 = length(vec2);
 3799:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 3800: 
 3801:             const double delta = cross(vec1, vec2);
 3802:             const double sintheta = abs(delta)/(rl1*rl2);
 3803: 
 3804:             // To avoid problems, avoid elements with small angle between vectors
 3805:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 3806:             const bool validEq = (sintheta > sin_one_deg);
 3807: 
 3808:             if (validEq) {
 3809:                // Solve the system of equations to get the density gradient at elem
 3810:                icount++;
 3811:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 3812:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 3813:                sumRx += Rx;
 3814:                sumRy += Ry;
 3815:             }
 3816:          } // for j1
 3817: 
 3818:          // Compute the average density gradient at elem
 3819:          if (icount==0) {
 3820:            // Bad mesh quality; bail out with 0 b-cc
 3821:            elem->gradRho[k] = {0.0, 0.0};
 3822:          } else {
 3823:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 3824:          }
 3825: 
 3826:       } // for k
 3827: 
 3828:    }
 3829: 
 3830:    __global__ void computeBaroclinicTerm(void) {
 3831:    // Computes the baroclinic term at sides (at half levels).
 3832:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 3833:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 3834: 
 3835:       SIDE(side);
 3836: 
 3837:       if (side->isDry) return;
 3838: 
 3839:       const Element *e1 = side->elems[0];
 3840:       const Element *e2 = side->elems[1];      
 3841:       const int kb = side->kb;
 3842:       
 3843:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 3844: 
 3845:       // interpolates vertically the density gradient of the two elements at the half level/
 3846: 
 3847:       // Starts the integration at the surface and goes down to the bottom
 3848:       int k1 = nvrt - 1;
 3849:       int k2 = nvrt - 1;
 3850: 
 3851:       side->bcc[nvrt-1] = {0.0, 0.0};
 3852:       for (int k = nvrt-1; k >= kb; k--) {
 3853:       // For each prism level (from surface to bottom)...
 3854: 
 3855:          // For both elements, interpolate density gradient at the side's half level.
 3856:          // The gradient at the side is the average of the gradients at the elements.
 3857:          // w1, w2 are used to take into account boundary sides, with just one element.
 3858:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 3859:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 3860:          const double wsum = w1 + w2;
 3861:          w1 = w1/wsum;
 3862:          w2 = w2/wsum;
 3863:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 3864: 
 3865:          // Linear interpolation of both elements' density gradient at the shared side's level.
 3866:          Vector2 gradRho = {0.0, 0.0};
 3867:          if (e1 != nullptr && k > kb) {
 3868:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 3869:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 3870:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 3871:             
 3872:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 3873:          }      
 3874:          if (e2 != nullptr && k > kb) {
 3875:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 3876:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 3877:             
 3878:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 3879:          }
 3880: 
 3881:          if constexpr(ics==2) {
 3882:             // IMPLEMENT THIS XXXXXX
 3883:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 3884:             // swild(1)=tmp1
 3885:             // swild(2)=tmp2
 3886:          }
 3887:          
 3888:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 3889:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 3890:          // CHECK INDICES!!! XXX
 3891:          const double grav3 = 0.5*(side->n1->grav2 + side->n2->grav2);
 3892:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 3893:       } // for
 3894: 
 3895:    }
 3896: 
 3897: } // extern "C"
 3898: 
 3899: #ifdef DONTCOMPILE
 3900: __device__ void computeVerticalAdvection(void) {
 3901:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 3902: 
 3903:    sdbt(1:2,:,:)=0.d0
 3904: 
 3905:    const Side *side = FROM kernel;
 3906: 
 3907:    if(side->isDry) return;
 3908: 
 3909:    // If side is wet...
 3910: 
 3911: 
 3912:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 3913:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 3914:    double ws[nvrt] = {} // w @ side
 3915:    int icount = 0;
 3916:    for (int j=0; j<2; j++) {
 3917:       const Element *elem = side->elements[j];
 3918:        
 3919:       if(elem != nullptr) {
 3920:          icount++;
 3921:          for (int k=0; k<nvrt; k++) {
 3922:             ws[k] = ws[k] + elem->w[k];
 3923:          }
 3924:       }
 3925:    }  // for j
 3926: 
 3927:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 3928:    ws = ws/icount;
 3929: 
 3930:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 3931:    // Splines allow for a smooth transition between vertical levels.
 3932:    // Splines have continuity restrictions at the internal knots, but
 3933:    // we have to provide the 1st derivatives at the endpoints.
 3934:    const int kbs = side->kbs; 
 3935:    
 3936:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3937:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3938:    initCubicSpline(kbs, nvrt, side, ws, up)
 3939: 
 3940:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3941:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3942:    initCubicSpline(kbs, nvrt, side, ws, vp)
 3943: 
 3944:    // Total advection (average onto side)
 3945:    const Node *node1 = side->nodes[0];
 3946:    const Node *node2 = side->nodes[1];
 3947:    for (int k=kbs(i); k<nvrt; k++) {
 3948: 
 3949:       if constexpr(ics==1) {
 3950:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 3951:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 3952:       } else {
 3953:          // XXX IMPLEMENT THIS
 3954:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 3955:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 3956:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 3957:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 3958:       }  // if ics
 3959: 
 3960: 
 3961:    }
 3962: }
 3963: #endif
 3964: 
 3965: 
 3966: extern "C" {
 3967:    __global__ void computeElemAverageGhat(void) {
 3968:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 3969: 
 3970:       ELEM(elem);
 3971:       
 3972:       elem->ghat1= {0.0, 0.0};  
 3973: 
 3974:       if constexpr(ihydraulics != 0) {
 3975:          if (nhtblocks > 0 && elem->isblock) return;
 3976:       }
 3977: 
 3978:       if (elem->isDry) return;
 3979: 
 3980:       // Wet elements.
 3981:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 3982:       // tidal potential, horizontal diffusion, and baroclinic etc
 3983:       // Remember to update both fb and F 
 3984:       // If ics=2, ghat1 are in eframe (ll)
 3985:       // cff1-3: coefficients for 2D/3D
 3986:       Vector2 gradEta = {0.0, 0.0};  // \nabla \eta
 3987:       Vector2 gradPr  = {0.0, 0.0};  // \nabla pressure
 3988:       Vector2 gradETP = {0.0, 0.0};  // \nabla etp
 3989: 
 3990:       double av_cff1 = 0.0;  // av. for cff1
 3991:       double av_cff2 = 0.0;  // av. for cff2
 3992:       double av_cff3 = 0.0;  // av. for cff3
 3993:       double av_df = 0.0;  // av. for H^\alpha / H
 3994:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 3995:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 3996: 
 3997:       const int i34 = elem->i34;
 3998:       const int kb = elem->kb;
 3999: 
 4000:       for (int j=1; j<i34; j++) {
 4001:          // For each node and side in the element...
 4002: 
 4003:          const Node *node = elem->nodes[j];
 4004:          const Side *side = elem->sides[j];
 4005: 
 4006:          const double chi      = side->chi;
 4007:          const double veg_c2   = side->veg_c2;
 4008:          const double veg_beta = side->veg_beta;
 4009:          const double veg_h    = side->veg_h();
 4010:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 4011: 
 4012:          // Node - const in elem
 4013:          gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 4014:          gradPr  += node->pr  *elem->gradPhi[j];
 4015: 
 4016:          if (elem->depth >= tip_dp) {
 4017:            gradETP += node->ETP*elem->gradPhi[j];
 4018:          }
 4019: 
 4020:          
 4021:          const double htot  = side->htot();        // Total depth at the side
 4022:          const double zctr2 = side->zTopCanopy();  
 4023: 
 4024:          double cff1; 
 4025:          double cff2; 
 4026:          double cff3;   
 4027:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 4028:          // coefficients applied to 2D/3D case 
 4029:             cff1 = side->hhat/htot;
 4030:             cff2 = 0.0;
 4031:             cff3 = 0.0;
 4032:          } else { //3D
 4033:             //Init for no-veg case
 4034:             cff1 = 1.0;
 4035:             cff2 = 1.0;
 4036:             cff3 = 0.0;
 4037: 
 4038:             if constexpr(iveg != 0) {
 4039:                // Computes coefficients used with vegetation terms G1, G2
 4040:                // cff1, cff3 are used for the first two terms in G1, G2:
 4041:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 4042:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 4043:                // In general, cff1*Ustar - cff3*Ustar_alpha
 4044:                if(veg_h < 0.99*htot) { // submergent vegetation
 4045:                   cff1=1;
 4046:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 4047:                   cff3 = veg_c;
 4048: 
 4049:                } else { // emergent vegetation
 4050:                   cff1 = 1.0/(1.0 + veg_c2);
 4051:                   cff2 = cff1;
 4052:                   cff3 = 0.0;
 4053: 
 4054:                }
 4055:             } // if iveg
 4056:          } //  2D/3D
 4057: 
 4058:          av_cff1 += cff1/i34;
 4059:          av_cff2 += cff2/i34;
 4060:          av_cff3 += cff3/i34;
 4061:          av_cff2_chi += cff2*chi/i34;
 4062:          av_cff3_chi += cff3*chi/i34;
 4063:          av_df += min(htot, veg_h)/(htot*i34);
 4064: 
 4065: 
 4066:          // btrack values: U^\star, U^{\star\alpha}
 4067:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 4068:          Vector2 Ustar       = {0.0, 0.0}; 
 4069:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 4070:          for (int k = side->kb; k < nvrt; k++) {
 4071:             if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 4072:                Ustar += side->btu[nvrt]*side->Dz(k);
 4073: 
 4074:             } else { //3D
 4075:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 4076:                Ustar += w2;
 4077: 
 4078:                if constexpr(iveg != 0) {
 4079:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 4080:                        const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k)); // For the top of the canopy, ratio of the level that is below the canopy
 4081:                        Ustar_alpha += zrat*w2; // XXXX
 4082:                    }
 4083:                }  // if iveg
 4084:             }  //2/3D
 4085:          }  //k
 4086:          
 4087: 
 4088:          // Add btrack & surface stress terms to \breve{G} first
 4089:          if constexpr(ics==1) {
 4090:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 4091:          } else {
 4092:             // XXX IMPLEMENT THIS
 4093:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 4094:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 4095:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 4096:          }  // if ics
 4097: 
 4098:          // Surface and bottom stress terms
 4099:          if constexpr(ics==1) {
 4100:             const Vector2 tau    = side->tau();
 4101:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 4102: 
 4103:             // Term for surface and bottom stress
 4104:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 4105:          } else {
 4106:             // XXX IMPLEMENT THIS
 4107:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 4108:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 4109:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 4110:             // tau_x=(vn1+tt1)/2.d0
 4111:             // tau_y=(vn2+ss1)/2.d0
 4112:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 4113:          }  // if ics
 4114: 
 4115:          
 4116: 
 4117:          // All terms in F,F^\alpha,f_b except baroclinic
 4118:          // F, f_b: all explicit terms excluding vegetation 
 4119:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 4120:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 4121:          const double coriolis = side->coriolis;
 4122:          Vector2 F  =  coriolis*side->U;  // F_x
 4123:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 4124:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 4125: 
 4126:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 4127:             
 4128:             for (int k = side->kb; k < nvrt; k++) {
 4129:                if (zctr2 > side->zc[k-1]) {
 4130:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 4131:                    const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 4132:                    Fa +=  coriolis*w2*zrat;
 4133:                } // if zctr2
 4134:             } // k
 4135:          } // iveg
 4136: 
 4137:          // Integrate horizontal viscosity force vertically
 4138:          for (int k=side->kb + 1; k<nvrt; k++) {
 4139:             const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.0; 
 4140: 
 4141:             F += levelHorVisc;
 4142: 
 4143:             // Vegetation term
 4144:             if constexpr(iveg!=0) {
 4145:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 4146:                   const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 4147:                   Fa += levelHorVisc*zrat;
 4148:                } 
 4149:             } // if iveg
 4150:          } // for k
 4151: 
 4152:          fb += side->d2uv[side->kb];
 4153: 
 4154: 
 4155:          // Add to ghat1
 4156:          if constexpr(ics==2) {
 4157:             // XXX IMPLEMENT THIS
 4158:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4159:             // bigf1=vn1; bigf2=vn2
 4160:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4161:             // botf1=vn1; botf2=vn2
 4162:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4163:             // bigfa1=vn1; bigfa2=vn2
 4164:          } // if ics
 4165: 
 4166:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 4167:       } // for j (nodes and sides)
 4168: 
 4169:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 4170:          
 4171:       // Finish off terms in F, F^\alpha and f_b
 4172:       const double grav3 = elem->mean(&Node::grav2);
 4173:       const Vector2 fb = grav3*gradETP - gradPr/rho0; //const in each elem
 4174: 
 4175: 
 4176:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 4177:       for (int j=1; j<i34; j++) { 
 4178:          // For each side in the element...
 4179:          const Side *side = elem->sides[j];
 4180:          const double chi = side->chi;
 4181: 
 4182:          const double htot = side->htot();
 4183:          const double veg_h = side->veg_h();
 4184:          const Vector2 F  = htot*fb;
 4185:          const Vector2 Fa = min(htot, veg_h)*fb;
 4186: 
 4187:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 4188:       } // for j
 4189: 
 4190:       //botf1 etc are already in elem frame
 4191:       elem->ghat1 += tmp/i34;
 4192: 
 4193:       // Baroclinic force
 4194:       if constexpr(ibc==0) {
 4195:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 4196: 
 4197:          Vector2 Fa = {0.0, 0.0};
 4198:          Vector2 intGradRho = {0.0, 0.0};
 4199:          
 4200:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 4201:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 4202:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 4203: 
 4204:             // \in F [m^2/s/s]
 4205:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 4206:          }
 4207: 
 4208:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 4209:          const Vector2 F = av_df*Fa; //approx
 4210:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 4211: 
 4212:       } // if ibc
 4213: 
 4214:    }
 4215: 
 4216: } // extern "C"
 4217: 
 4218: 
 4219: 
 4220: #ifdef DONTCOMPILE
 4221: __global__ void checkMassConservation(Tracers* sumtr) {
 4222: 
 4223:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 4224: 
 4225:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 4226: 
 4227:    Element *elem = &(mesh->localElemData[i]);
 4228: 
 4229:    // Skip dry elements
 4230:    if (elem->isDry) return;
 4231: 
 4232:    // Local sum array for this thread
 4233:    double localSum[N_TRACERS] = {0.0};
 4234: 
 4235:    // Sum over vertical levels for this element
 4236:    const int kbe = elem->kbe;
 4237:    const double area = elem->area;
 4238: 
 4239:    for (int k = kbe; k < nvrt; k++) {
 4240:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 4241:       
 4242:       // Accumulate tracer mass
 4243:       for (int tr = 0; tr < N_TRACERS; tr++) {
 4244:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 4245:       }
 4246:    }
 4247: 
 4248:    
 4249: 
 4250:    //  This function returns per element sums. A reduction must be done on the host side.
 4251: }
 4252: 
 4253: 
 4254: __global__ void transport(void) {
 4255: 
 4256:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 4257: 
 4258:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 4259: 
 4260:    Element *elem = &(mesh->localElemData[ie]);
 4261: 
 4262:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 4263: 
 4264:                for (int m=0; m<ntr; m++) {
 4265:                   for (int k=kbe(ie); k<nvrt; k++) {
 4266:                      // Calculate each polynomial's weight 
 4267:                      wm=0.d0; sum1=0.d0; 
 4268:                      wm1=0.d0; wm2=0.d0; 
 4269:                      for (int i=0; i<elem->nweno2; i++) {
 4270:                   
 4271:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4272:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4273:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4274:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4275:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4276:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 4277:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 4278:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 4279:                      // -----------------Hu and Shu (1999)'s method----------------
 4280:                      b4=b1+b2+b3
 4281: 
 4282: //Error: add PRODUCTION CPP
 4283: #ifdef DEBUG
 4284:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 4285:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 4286:                     call parallel_abort(errmsg)
 4287:                   }
 4288: #endif
 4289: 
 4290:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 4291:                   // !----test-------------- 
 4292:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 4293:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 4294:                   // !wm(i)=wm1(i)*wm2(i)
 4295:                   // !---------------------- 
 4296:                   sum1=sum1+wm(i)
 4297:                 } // end for i
 4298: 
 4299:                 wm=wm/sum1
 4300: 
 4301:                 for (int j=0; j<elem->i34; j++) {
 4302: 
 4303:                   const Side *side  = elem->sides[j];
 4304:                   const Node *node1 = side->n1;
 4305:                   const Node *node2 = side->n2;
 4306: 
 4307:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 4308:                      trsd=0.d0
 4309:                      for (int kk=0; kk<nquad; kk++) {
 4310:                         for (int i=0; i<elem->nweno2; i++) {
 4311:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4312:                         } // end for i   
 4313:                      } // end for kk
 4314:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 4315:                   } // outward flux
 4316:                } // end for j=1,i34(ie) ! side
 4317:             }
 4318:          }
 4319:               
 4320: 
 4321: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 4322: //             //   calculate each polynomial's weight 
 4323: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 4324: //                 wm=0.d0; sum1=0.d0
 4325: //                 do i=1,nweno1(ie) !for each polynomial
 4326: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4327: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4328: //                   b1=b1*b1+b2*b2 !smoothness indicator
 4329: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 4330: //                   wm(i)=b2
 4331: //                   sum1=sum1+b2
 4332: //                   !wm(i)=1.d0
 4333: //                   !sum1=sum1+1.d0
 4334: 
 4335: // // Error: PRODUCTION
 4336: // #ifdef DEBUG
 4337: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 4338: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 4339: //                     call parallel_abort(errmsg)
 4340: //                   endif
