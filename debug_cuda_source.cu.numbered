 3324:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3325: 
 3326:       NODE_BND(nodeBnd);
 3327: 
 3328:       Node *node = nodeBnd->node;
 3329: 
 3330:       node->ETP = 0.0;
 3331: 
 3332:       for (int j=0; j<ntip; j++) {
 3333: 
 3334:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3335:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3336:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3337: 
 3338:          if constexpr(iloadtide==1) { // loading tide
 3339:             assert(false && "Loading tide not implemented");
 3340:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3341:          }
 3342:          
 3343:       }
 3344:       
 3345:    }
