 3465:    __global__ void computeBottomDragVegetation(void) {
 3466:       // UNFINISHED. CHECK THIS:
 3467:       // How many kernels are needed? Why so many for loops?
 3468:       // Is the loop on sides needed?
 3469: 
 3470:       NODE(node);
 3471: 
 3472:       const int    kb      = node->kb;
 3473:       const double htot    = node->htot();
 3474:       const double rough   = node->rough;
 3475: 
 3476: 
 3477:       if (node->isDry) {
 3478:          // Default values for dry nodes
 3479:          node->veg_alpha_vert_mean = node->veg_alpha0;
 3480:          /// XXX CHECK INDICES
 3481:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 3482:       }
 3483: 
 3484:       // Compute bottom drag Cd
 3485:       //--------------------------------
 3486: 
 3487:       // nchi = {-1, 0, 1} is the type of bottom drag.
 3488:       if (nchi==1) {
 3489: 
 3490:          bool ltmp = false; // for WBL iteration
 3491: 
 3492:          // Cdmax=-1 !max. Cd at node for this process (info only)
 3493:          // Drag at nodes
 3494:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 3495:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 3496:         
 3497:          const double rough = node->rough;
 3498:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3499:          if (node->rough == 0.0) {
 3500:             node->Cd = 0.0;
 3501: 
 3502:          } else { //roughness >0 
 3503:             
 3504:             const double bthick_ori = node->znl[kb + 1] - node->znl[kb];  // thickness of bottom bnd layer
 3505:             const double bthick = max(dzb_min, bthick_ori);
 3506: 
 3507:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 3508: 
 3509:             double tmp = 1.0/(2.5*log(bthick/rough));
 3510:             node->Cd = tmp*tmp;
 3511: 
 3512:          } // if rough
 3513: 
 3514: 
 3515:          // RECOVER THIS: XXX
 3516:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 3517:          // Output warning for WBL if iteration didn't converge
 3518: 
 3519: 
 3520:       } // nchi==1
 3521: 
 3522:       //   Bottom stress in m^2/s^2
 3523:       if (node->rho[kb + 1] >= -98.0)
 3524:       {
 3525:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 3526:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 3527:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 3528:          // !sediment erosion: this part needs more documentation
 3529:       }
 3530: 
 3531:     
 3532:       // Compute vegetation parameters
 3533:       //--------------------------------
 3534: 
 3535:       // SAV constants
 3536:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 3537:       constexpr double veg_cfpsi = 0.16;
 3538: 
 3539:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 3540:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 3541: 
 3542:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 3543:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 3544:          int kbin = 0; // bin index
 3545:          for (int k = kb; k < nvrt; k++) {
 3546:             // Computes node height above the bottom level
 3547:             const double tmp_h = node->znl[k] - node->znl[kb]; // >=0
 3548:             assert(false && "Vertical variation of vegetation not implemented");
 3549: 
 3550:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 3551:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 3552:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 3553:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 3554:             // } else {
 3555:             //    // Find the bin at which the current vertical level is
 3556:             //    while (kbin<nbins_veg_vert) {
 3557:             //       const double zn = node->znl[kbin];
 3558:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 3559:             //          break;
 3560:             //       } // if
 3561:             //       kbin++;
 3562:             //    } // while
 3563:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 3564: 
 3565:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 3566:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 3567:                
 3568:             //    // Linear interpolation of the vegetation parameters
 3569:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 3570:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 3571:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 3572:             // } // if rl10
 3573: 
 3574:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 3575: 
 3576:          } // for k
 3577: 
 3578: 
 3579:       } else { // Ganthy (iveg=2)
 3580:       //  Modify canopy height, diameter, and density
 3581: 
 3582:          // Make sure there is vegetation on this node
 3583:          if (node->veg_h_unbent > 0.0) {
 3584:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 3585: 
 3586:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 3587:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 3588:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 3589: 
 3590:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 3591:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 3592:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 3593:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 3594:          } // if veg_h_unbent
 3595: 
 3596:          for (int k = 0; k < nvrt; k++) {
 3597:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 3598:          } // for k
 3599:       
 3600: 
 3601:       } // if iveg
 3602:      
 3603:          
 3604: 
 3605:       // Compute vertical mean of veg_alpha3D
 3606:       if (iveg != 0) {
 3607:          const double ztop = node->zTopCanopy(); // Top of the canopy
 3608:          double sum1=0.0;
 3609:          double sum2=0.0;
 3610:          // Integrate over each level under the canopy...
 3611:          for (int k=kb; k<nvrt-1 && node->znl[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 3612:             const double Dz = node->Dz(k);
 3613: 
 3614:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 3615:             sum2 += Dz;
 3616: 
 3617:          } // for k
 3618: 
 3619:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 3620:          else             node->veg_alpha_vert_mean = sum1/sum2;
 3621: 
 3622:       } // if iveg
 3623: 
 3624:       printf("computeBottomDragVegetation: nodeIdx = %d, node->veg_alpha_vert_mean = %f\n", node->idx, node->veg_alpha_vert_mean);
 3625: 
 3626:    }
 3627: 
 3628:    __global__ void computeVegetationAndDragParameters(void) {
 3629:       // Computes the vegetation and drag model parameters:
 3630:       // chi, \tilde\chi, beta, \breve{H}
 3631:       
 3632:       SIDE(side);
 3633: 
 3634:       const double htot = side->htot();
 3635:       const int    kb   = side->kb;
 3636: 
 3637:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 3638: 
 3639:       const double veg_h     = side->veg_h();
 3640:       const double veg_nv    = side->veg_nv();
 3641:       const double veg_c     = side->veg_c();
 3642:       const double veg_beta  = side->veg_beta;
 3643:       const double veg_alpha = side->veg_alpha_vert_mean();
 3644: 
 3645:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 3646:       // Velocity magnitude at the bottom level
 3647:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 3648:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 3649:       side->chi2 = side->Cd()*vmag1;
 3650:       side->chi  = side->chi2;
 3651:       if constexpr(iveg != 0) {
 3652:          const Node *n1 = side->n1;
 3653:          const Node *n2 = side->n2;
 3654:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 3655:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 3656:       }
 3657: 
 3658:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 3659: 
 3660:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 3661:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 3662:       double magUa = 0.0;
 3663:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 3664:          // 3D wet side with veg...
 3665: 
 3666:          double magUa = 0.0;
 3667:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 3668:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 3669: 
 3670:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 3671:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 3672:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 3673: 
 3674:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 3675:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 3676: 
 3677:                // Velocity magnitude at the bottom (l) of the level
 3678:                const double ul = length(side->u2[k]);
 3679: 
 3680:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 3681:                magUa += Dz*0.5*(uh + ul);
 3682: 
 3683:             } // if HasVegetation
 3684:          } // for k
 3685:          const double ua = magUa/min(htot, veg_h); // Vertical average
 3686: 
 3687:          // Computes beta, used for computing the stress term at the top of the canopy.      
 3688:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 3689:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 3690:             const double zCpy = side->zTopCanopy();
 3691:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 3692:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 3693:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 3694:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 3695:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 3696:          } // if isSubmerged
 3697:       } // if iveg   
 3698: 
 3699:       // Computes the friction modified depth, \breve{H} in notes
 3700:       if (side->is2D()) { // 2D
 3701: 
 3702:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 3703:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 3704: 
 3705:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 3706: 
 3707:          side->hhat = htot*htot/fricH; 
 3708: 
 3709:       } else { // 3D
 3710:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 3711: 
 3712:          if constexpr(iveg != 0) {
 3713:             
 3714:             if (side->isSubmerged()) { 
 3715:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 3716:                side->hhat -= veg_c*Hhat_alpha;
 3717: 
 3718:             } else { // Emergent
 3719:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 3720:             }
 3721:          } // if iveg
 3722: 
 3723:          // Enforce positivity for 3D model
 3724:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 3725:       } // if 3D
 3726: 
 3727:       printf("computeVegetationAndDragParameters: sideIdx = %d, side->htot = %f, side->hhat = %f\n", side->idx, side->htot(), side->hhat);
 3728: 
 3729:         
 3730:    }
 3731: 
 3732: 
 3733: 
 3734:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 3735:    // Computes the density gradient between two elements, e1 and e2.
 3736:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 3737:    // zero in the direction normal to the side. 
 3738:    // 
 3739:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 3740:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 3741:    //
 3742:    // Input:
 3743:    //    e1: Element
 3744:    //    e2: Neighbor element (or nullptr if boundary)
 3745:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 3746:    //    k: Index of the half-level at which the density is interpolated
 3747:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 3748:    // 
 3749:    // Output:
 3750:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 3751:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 3752: 
 3753:       if (e2 == nullptr || e2->isDry) {
 3754:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 3755: 
 3756:          Side *side = e1->sides[j];
 3757:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 3758:                  
 3759:          if constexpr(ics == 1) {
 3760:             vec = side->n; // Normal vector to the side
 3761:          } else {
 3762:             // IMPLEMENT THIS XXXXXX
 3763:             // !replace with xel, yel?
 3764:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 3765:             //      &eframe(:,:,i),xn1,yn1,tmp)
 3766:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 3767:             //      &eframe(:,:,i),xn2,yn2,tmp)
 3768:          } //ics
 3769:                    
 3770:          diffRho = 0.0;
 3771: 
 3772:       } else { //internal and wet
 3773:          if constexpr(ics==1) {
 3774:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 3775: 
 3776:             // Vector from e1 to e2
 3777:             vec = toVector2(e2->center - e1->center);
 3778: 
 3779:          } else { 
 3780:             // IMPLEMENT THIS XXXXXX
 3781:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 3782:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 3783:             //                   alow(j)=xctr2
 3784:             //                   bdia(j)=yctr2
 3785:          } // ics
 3786: 
 3787:          diffRho = rho2 - e1->demeanedDensity(k);
 3788:       }
 3789: 
 3790:    }
 3791: 
 3792:    __global__ void computeDensityCubicSplines(void) {
 3793:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 3794: 
 3795:       ELEM(elem);
 3796: 
 3797:       if (elem->isDry) return;
 3798: 
 3799:       const int kb = elem->kb;
 3800: 
 3801:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 3802:       if (elem->is2D()) {
 3803:          // In the 2D case, the density is constant at the prism level. 
 3804:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 3805:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 3806:       } else { //3D
 3807: 
 3808:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 3809:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 3810:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 3811:          ///// XXXX CHECK INDICES!!!!!
 3812:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 3813:       } // 2D/3D
 3814: 
 3815:    }
 3816: } // extern "C"
 3817: 
 3818: 
 3819: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 3820: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 3821: 
 3822:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 3823: 
 3824:    const int kb  = elem->kb;
 3825:    const int kb2 = elem2->kb;
 3826: 
 3827:    // z-coordinate of prism of elem
 3828:    const double zp = elem->z_prism(k);
 3829: 
 3830:    double rho = 0.0;
 3831: 
 3832:    if (elem2->is2D()) {
 3833:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 3834: 
 3835:    } else {  // 3D
 3836: 
 3837:       // eta_min may be < zmax
 3838:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 3839:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 3840: 
 3841:       // (Extrapolate density below bottom, we will fix it later)
 3842:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 3843:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 3844:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 3845:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 3846:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 3847:    } // 2D/3D
 3848:      
 3849: 
 3850:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 3851:    // Now we need to fix it.
 3852:    if (elem->z[k] < elem2->z[kb2]) {
 3853:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 3854: 
 3855:       // There are two methods to adjust the density at the bottom of the element.
 3856:       // iunder_deep=0: 
 3857:       const double depth1 = abs(elem->z[kb]); // larger depth
 3858: 
 3859:       if (iunder_deep==0) {
 3860: 
 3861:          const double weight = max(0.0, min(1.0, (depth1 - h1_bcc)/(h2_bcc - h1_bcc))); // weight
 3862: 
 3863:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 3864: 
 3865:       } else { // iunder_deep != 0
 3866: 
 3867:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 3868: 
 3869:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 3870: 
 3871:          //   Demeaned density at the same z coordinate as
 3872:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 3873:          }
 3874: 
 3875:       } // if iunder_deep
 3876:    } // if elem->z[kb] < elem2->z[kb]
 3877: 
 3878:    return rho;
 3879: }
 3880: 
 3881: 
 3882: extern "C" {
 3883:    __global__ void computeDensityGradient(void) {
 3884: 
 3885:          // Compute the horizontal density gradient at each element.
 3886:       // It works in two steps:
 3887:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 3888:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 3889:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 3890:       //             gradRho.r1 = rho1 - rho0
 3891:       //             gradRho.r2 = rho2 - rho0
 3892:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 3893:       // 
 3894:       //  NOTE: We use de-meaned densities.
 3895: 
 3896:       ELEM(elem);
 3897: 
 3898:       if (elem->isDry) return;
 3899: 
 3900:       const int kb  = elem->kb;
 3901:       const int i34 = elem->i34;
 3902: 
 3903:       for (int k = kb + 1; k < nvrt; k++) {
 3904:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 3905:          //             gradRho.r1 = rho1 - rho0
 3906:          //             gradRho.r2 = rho2 - rho0
 3907:          int icount = 0;
 3908:          double sumRx = 0.0;
 3909:          double sumRy = 0.0;
 3910:          for (int j1=0; j1<i34; j1++) { 
 3911: 
 3912:             const int j2 = elem->nxq(j1 + 1);
 3913: 
 3914:             // Pairs of consecutive neighbor elements of elem
 3915:             const Element *e1 = elem->nghbElems[j1];
 3916:             const Element *e2 = elem->nghbElems[j2];
 3917: 
 3918:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 3919:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 3920:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 3921: 
 3922:             // Compute the density difference and the vector from elem to e1 and e2
 3923:             // getRhoDiffAndVec takes into account boundaries/dry elements
 3924:             double diffRho1, diffRho2;
 3925:             Vector2 vec1, vec2;
 3926:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 3927:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 3928: 
 3929:             const double rl1 = length(vec1);
 3930:             const double rl2 = length(vec2);
 3931:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 3932: 
 3933:             const double delta = cross(vec1, vec2);
 3934:             const double sintheta = abs(delta)/(rl1*rl2);
 3935: 
 3936:             // To avoid problems, avoid elements with small angle between vectors
 3937:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 3938:             const bool validEq = (sintheta > sin_one_deg);
 3939: 
 3940:             if (validEq) {
 3941:                // Solve the system of equations to get the density gradient at elem
 3942:                icount++;
 3943:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 3944:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 3945:                sumRx += Rx;
 3946:                sumRy += Ry;
 3947:             }
 3948:          } // for j1
 3949: 
 3950:          // Compute the average density gradient at elem
 3951:          if (icount==0) {
 3952:            // Bad mesh quality; bail out with 0 b-cc
 3953:            elem->gradRho[k] = {0.0, 0.0};
 3954:          } else {
 3955:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 3956:          }
 3957: 
 3958:       } // for k
 3959: 
 3960:    }
 3961: 
 3962:    __global__ void computeBaroclinicTerm(void) {
 3963:    // Computes the baroclinic term at sides (at half levels).
 3964:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 3965:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 3966: 
 3967:       SIDE(side);
 3968: 
 3969:       if (side->isDry) return;
 3970: 
 3971:       const Element *e1 = side->elems[0];
 3972:       const Element *e2 = side->elems[1];      
 3973:       const int kb = side->kb;
 3974:       
 3975:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 3976: 
 3977:       // interpolates vertically the density gradient of the two elements at the half level/
 3978: 
 3979:       // Starts the integration at the surface and goes down to the bottom
 3980:       int k1 = nvrt - 1;
 3981:       int k2 = nvrt - 1;
 3982: 
 3983:       side->bcc[nvrt-1] = {0.0, 0.0};
 3984:       for (int k = nvrt-1; k >= kb; k--) {
 3985:       // For each prism level (from surface to bottom)...
 3986: 
 3987:          // For both elements, interpolate density gradient at the side's half level.
 3988:          // The gradient at the side is the average of the gradients at the elements.
 3989:          // w1, w2 are used to take into account boundary sides, with just one element.
 3990:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 3991:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 3992:          const double wsum = w1 + w2;
 3993:          w1 = w1/wsum;
 3994:          w2 = w2/wsum;
 3995:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 3996: 
 3997:          // Linear interpolation of both elements' density gradient at the shared side's level.
 3998:          Vector2 gradRho = {0.0, 0.0};
 3999:          if (e1 != nullptr && k > kb) {
 4000:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 4001:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 4002:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 4003:             
 4004:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 4005:          }      
 4006:          if (e2 != nullptr && k > kb) {
 4007:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4008:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4009:             
 4010:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4011:          }
 4012: 
 4013:          if constexpr(ics==2) {
 4014:             // IMPLEMENT THIS XXXXXX
 4015:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4016:             // swild(1)=tmp1
 4017:             // swild(2)=tmp2
 4018:          }
 4019:          
 4020:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4021:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4022:          // CHECK INDICES!!! XXX
 4023:          const double grav3 = 0.5*(side->n1->grav2 + side->n2->grav2);
 4024:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4025:       } // for
 4026: 
 4027:    }
 4028: 
 4029: } // extern "C"
 4030: 
 4031: #ifdef DONTCOMPILE
 4032: __device__ void computeVerticalAdvection(void) {
 4033:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 4034: 
 4035:    sdbt(1:2,:,:)=0.d0
 4036: 
 4037:    const Side *side = FROM kernel;
 4038: 
 4039:    if(side->isDry) return;
 4040: 
 4041:    // If side is wet...
 4042: 
 4043: 
 4044:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 4045:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 4046:    double ws[nvrt] = {} // w @ side
 4047:    int icount = 0;
 4048:    for (int j=0; j<2; j++) {
 4049:       const Element *elem = side->elements[j];
 4050:        
 4051:       if(elem != nullptr) {
 4052:          icount++;
 4053:          for (int k=0; k<nvrt; k++) {
 4054:             ws[k] = ws[k] + elem->w[k];
 4055:          }
 4056:       }
 4057:    }  // for j
 4058: 
 4059:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 4060:    ws = ws/icount;
 4061: 
 4062:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 4063:    // Splines allow for a smooth transition between vertical levels.
 4064:    // Splines have continuity restrictions at the internal knots, but
 4065:    // we have to provide the 1st derivatives at the endpoints.
 4066:    const int kbs = side->kbs; 
 4067:    
 4068:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 4069:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 4070:    initCubicSpline(kbs, nvrt, side, ws, up)
 4071: 
 4072:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 4073:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 4074:    initCubicSpline(kbs, nvrt, side, ws, vp)
 4075: 
 4076:    // Total advection (average onto side)
 4077:    const Node *node1 = side->nodes[0];
 4078:    const Node *node2 = side->nodes[1];
 4079:    for (int k=kbs(i); k<nvrt; k++) {
 4080: 
 4081:       if constexpr(ics==1) {
 4082:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 4083:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 4084:       } else {
 4085:          // XXX IMPLEMENT THIS
 4086:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 4087:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 4088:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 4089:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 4090:       }  // if ics
 4091: 
 4092: 
 4093:    }
 4094: }
 4095: #endif
 4096: 
 4097: 
 4098: extern "C" {
 4099:    __global__ void computeElemAverageGhat(void) {
 4100:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 4101: 
 4102:       ELEM(elem);
 4103:       
 4104:       elem->ghat1= {0.0, 0.0};  
 4105: 
 4106:       if constexpr(ihydraulics != 0) {
 4107:          if (nhtblocks > 0 && elem->isblock) return;
 4108:       }
 4109: 
 4110:       if (elem->isDry) return;
 4111: 
 4112:       // Wet elements.
 4113:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 4114:       // tidal potential, horizontal diffusion, and baroclinic etc
 4115:       // Remember to update both fb and F 
 4116:       // If ics=2, ghat1 are in eframe (ll)
 4117:       // cff1-3: coefficients for 2D/3D
 4118:       Vector2 gradEta = {0.0, 0.0};  // \nabla \eta
 4119:       Vector2 gradPr  = {0.0, 0.0};  // \nabla pressure
 4120:       Vector2 gradETP = {0.0, 0.0};  // \nabla etp
 4121: 
 4122:       double av_cff1 = 0.0;  // av. for cff1
 4123:       double av_cff2 = 0.0;  // av. for cff2
 4124:       double av_cff3 = 0.0;  // av. for cff3
 4125:       double av_df = 0.0;  // av. for H^\alpha / H
 4126:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 4127:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 4128: 
 4129:       const int i34 = elem->i34;
 4130:       const int kb = elem->kb;
 4131: 
 4132:       for (int j=1; j<i34; j++) {
 4133:          // For each node and side in the element...
 4134: 
 4135:          const Node *node = elem->nodes[j];
 4136:          const Side *side = elem->sides[j];
 4137: 
 4138:          const double chi      = side->chi;
 4139:          const double veg_c2   = side->veg_c2;
 4140:          const double veg_beta = side->veg_beta;
 4141:          const double veg_h    = side->veg_h();
 4142:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 4143: 
 4144:          // Node - const in elem
 4145:          gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 4146:          gradPr  += node->pr  *elem->gradPhi[j];
 4147: 
 4148:          if (elem->depth >= tip_dp) {
 4149:            gradETP += node->ETP*elem->gradPhi[j];
 4150:          }
 4151: 
 4152:          
 4153:          const double htot  = side->htot();        // Total depth at the side
 4154:          const double zctr2 = side->zTopCanopy();  
 4155: 
 4156:          double cff1; 
 4157:          double cff2; 
 4158:          double cff3;   
 4159:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 4160:          // coefficients applied to 2D/3D case 
 4161:             cff1 = side->hhat/htot;
 4162:             cff2 = 0.0;
 4163:             cff3 = 0.0;
 4164:          } else { //3D
 4165:             //Init for no-veg case
 4166:             cff1 = 1.0;
 4167:             cff2 = 1.0;
 4168:             cff3 = 0.0;
 4169: 
 4170:             if constexpr(iveg != 0) {
 4171:                // Computes coefficients used with vegetation terms G1, G2
 4172:                // cff1, cff3 are used for the first two terms in G1, G2:
 4173:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 4174:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 4175:                // In general, cff1*Ustar - cff3*Ustar_alpha
 4176:                if(veg_h < 0.99*htot) { // submergent vegetation
 4177:                   cff1=1;
 4178:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 4179:                   cff3 = veg_c;
 4180: 
 4181:                } else { // emergent vegetation
 4182:                   cff1 = 1.0/(1.0 + veg_c2);
 4183:                   cff2 = cff1;
 4184:                   cff3 = 0.0;
 4185: 
 4186:                }
 4187:             } // if iveg
 4188:          } //  2D/3D
 4189: 
 4190:          av_cff1 += cff1/i34;
 4191:          av_cff2 += cff2/i34;
 4192:          av_cff3 += cff3/i34;
 4193:          av_cff2_chi += cff2*chi/i34;
 4194:          av_cff3_chi += cff3*chi/i34;
 4195:          av_df += min(htot, veg_h)/(htot*i34);
 4196: 
 4197: 
 4198:          // btrack values: U^\star, U^{\star\alpha}
 4199:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 4200:          Vector2 Ustar       = {0.0, 0.0}; 
 4201:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 4202:          for (int k = side->kb; k < nvrt; k++) {
 4203:             if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 4204:                Ustar += side->btu[nvrt]*side->Dz(k);
 4205: 
 4206:             } else { //3D
 4207:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 4208:                Ustar += w2;
 4209: 
 4210:                if constexpr(iveg != 0) {
 4211:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 4212:                        const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k)); // For the top of the canopy, ratio of the level that is below the canopy
 4213:                        Ustar_alpha += zrat*w2; // XXXX
 4214:                    }
 4215:                }  // if iveg
 4216:             }  //2/3D
 4217:          }  //k
 4218:          
 4219: 
 4220:          // Add btrack & surface stress terms to \breve{G} first
 4221:          if constexpr(ics==1) {
 4222:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 4223:          } else {
 4224:             // XXX IMPLEMENT THIS
 4225:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 4226:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 4227:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 4228:          }  // if ics
 4229: 
 4230:          // Surface and bottom stress terms
 4231:          if constexpr(ics==1) {
 4232:             const Vector2 tau    = side->tau();
 4233:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 4234: 
 4235:             // Term for surface and bottom stress
 4236:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 4237:          } else {
 4238:             // XXX IMPLEMENT THIS
 4239:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 4240:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 4241:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 4242:             // tau_x=(vn1+tt1)/2.d0
 4243:             // tau_y=(vn2+ss1)/2.d0
 4244:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 4245:          }  // if ics
 4246: 
 4247:          
 4248: 
 4249:          // All terms in F,F^\alpha,f_b except baroclinic
 4250:          // F, f_b: all explicit terms excluding vegetation 
 4251:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 4252:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 4253:          const double coriolis = side->coriolis;
 4254:          Vector2 F  =  coriolis*side->U;  // F_x
 4255:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 4256:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 4257: 
 4258:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 4259:             
 4260:             for (int k = side->kb; k < nvrt; k++) {
 4261:                if (zctr2 > side->zc[k-1]) {
 4262:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 4263:                    const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 4264:                    Fa +=  coriolis*w2*zrat;
 4265:                } // if zctr2
 4266:             } // k
 4267:          } // iveg
 4268: 
 4269:          // Integrate horizontal viscosity force vertically
 4270:          for (int k=side->kb + 1; k<nvrt; k++) {
 4271:             const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.0; 
 4272: 
 4273:             F += levelHorVisc;
 4274: 
 4275:             // Vegetation term
 4276:             if constexpr(iveg!=0) {
 4277:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 4278:                   const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 4279:                   Fa += levelHorVisc*zrat;
 4280:                } 
 4281:             } // if iveg
 4282:          } // for k
 4283: 
 4284:          fb += side->d2uv[side->kb];
 4285: 
 4286: 
 4287:          // Add to ghat1
 4288:          if constexpr(ics==2) {
 4289:             // XXX IMPLEMENT THIS
 4290:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4291:             // bigf1=vn1; bigf2=vn2
 4292:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4293:             // botf1=vn1; botf2=vn2
 4294:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4295:             // bigfa1=vn1; bigfa2=vn2
 4296:          } // if ics
 4297: 
 4298:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 4299:       } // for j (nodes and sides)
 4300: 
 4301:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 4302:          
 4303:       // Finish off terms in F, F^\alpha and f_b
 4304:       const double grav3 = elem->mean(&Node::grav2);
 4305:       const Vector2 fb = grav3*gradETP - gradPr/rho0; //const in each elem
 4306: 
 4307: 
 4308:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 4309:       for (int j=1; j<i34; j++) { 
 4310:          // For each side in the element...
 4311:          const Side *side = elem->sides[j];
 4312:          const double chi = side->chi;
 4313: 
 4314:          const double htot = side->htot();
 4315:          const double veg_h = side->veg_h();
 4316:          const Vector2 F  = htot*fb;
 4317:          const Vector2 Fa = min(htot, veg_h)*fb;
 4318: 
 4319:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 4320:       } // for j
 4321: 
 4322:       //botf1 etc are already in elem frame
 4323:       elem->ghat1 += tmp/i34;
 4324: 
 4325:       // Baroclinic force
 4326:       if constexpr(ibc==0) {
 4327:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 4328: 
 4329:          Vector2 Fa = {0.0, 0.0};
 4330:          Vector2 intGradRho = {0.0, 0.0};
 4331:          
 4332:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 4333:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 4334:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 4335: 
 4336:             // \in F [m^2/s/s]
 4337:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 4338:          }
 4339: 
 4340:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 4341:          const Vector2 F = av_df*Fa; //approx
 4342:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 4343: 
 4344:       } // if ibc
 4345: 
 4346:    }
 4347: 
 4348: } // extern "C"
 4349: 
 4350: 
 4351: 
 4352: #ifdef DONTCOMPILE
 4353: __global__ void checkMassConservation(Tracers* sumtr) {
 4354: 
 4355:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 4356: 
 4357:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 4358: 
 4359:    Element *elem = &(mesh->localElemData[i]);
 4360: 
 4361:    // Skip dry elements
 4362:    if (elem->isDry) return;
 4363: 
 4364:    // Local sum array for this thread
 4365:    double localSum[N_TRACERS] = {0.0};
 4366: 
 4367:    // Sum over vertical levels for this element
 4368:    const int kbe = elem->kbe;
 4369:    const double area = elem->area;
 4370: 
 4371:    for (int k = kbe; k < nvrt; k++) {
 4372:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 4373:       
 4374:       // Accumulate tracer mass
 4375:       for (int tr = 0; tr < N_TRACERS; tr++) {
 4376:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 4377:       }
 4378:    }
 4379: 
 4380:    
 4381: 
 4382:    //  This function returns per element sums. A reduction must be done on the host side.
 4383: }
 4384: 
 4385: 
 4386: __global__ void transport(void) {
 4387: 
 4388:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 4389: 
 4390:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 4391: 
 4392:    Element *elem = &(mesh->localElemData[ie]);
 4393: 
 4394:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 4395: 
 4396:                for (int m=0; m<ntr; m++) {
 4397:                   for (int k=kbe(ie); k<nvrt; k++) {
 4398:                      // Calculate each polynomial's weight 
 4399:                      wm=0.d0; sum1=0.d0; 
 4400:                      wm1=0.d0; wm2=0.d0; 
 4401:                      for (int i=0; i<elem->nweno2; i++) {
 4402:                   
 4403:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4404:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4405:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4406:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4407:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4408:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 4409:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 4410:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 4411:                      // -----------------Hu and Shu (1999)'s method----------------
 4412:                      b4=b1+b2+b3
 4413: 
 4414: //Error: add PRODUCTION CPP
 4415: #ifdef DEBUG
 4416:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 4417:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 4418:                     call parallel_abort(errmsg)
 4419:                   }
 4420: #endif
 4421: 
 4422:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 4423:                   // !----test-------------- 
 4424:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 4425:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 4426:                   // !wm(i)=wm1(i)*wm2(i)
 4427:                   // !---------------------- 
 4428:                   sum1=sum1+wm(i)
 4429:                 } // end for i
 4430: 
 4431:                 wm=wm/sum1
 4432: 
 4433:                 for (int j=0; j<elem->i34; j++) {
 4434: 
 4435:                   const Side *side  = elem->sides[j];
 4436:                   const Node *node1 = side->n1;
 4437:                   const Node *node2 = side->n2;
 4438: 
 4439:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 4440:                      trsd=0.d0
 4441:                      for (int kk=0; kk<nquad; kk++) {
 4442:                         for (int i=0; i<elem->nweno2; i++) {
 4443:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4444:                         } // end for i   
 4445:                      } // end for kk
 4446:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 4447:                   } // outward flux
 4448:                } // end for j=1,i34(ie) ! side
 4449:             }
 4450:          }
 4451:               
 4452: 
 4453: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 4454: //             //   calculate each polynomial's weight 
 4455: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 4456: //                 wm=0.d0; sum1=0.d0
 4457: //                 do i=1,nweno1(ie) !for each polynomial
 4458: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4459: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4460: //                   b1=b1*b1+b2*b2 !smoothness indicator
 4461: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 4462: //                   wm(i)=b2
 4463: //                   sum1=sum1+b2
 4464: //                   !wm(i)=1.d0
 4465: //                   !sum1=sum1+1.d0
 4466: 
 4467: // // Error: PRODUCTION
 4468: // #ifdef DEBUG
 4469: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 4470: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 4471: //                     call parallel_abort(errmsg)
 4472: //                   endif
 4473: // #endif
 4474: 
 4475: //                 enddo !i
 4476: //                 wm=wm/sum1 !final weight
 4477: 
 4478:                 for (int j=0; j<elem->i34; j++) { // side
 4479:                   const Side *side = elem->sides[j];
 4480:                   const Node *node1 = side->n1;
 4481:                   const Node *node2 = side->n2;
 4482: 
 4483:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 4484:                     trsd=0.d0
 4485:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 4486:                       for (int i=0; i<elem->nweno1; i++) {
 4487:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 4488:                       }
 4489:                     enddo //kk
 4490:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 4491:                   } // outward flux
 4492:                 } // end for j=1,i34(ie) ! side
 4493:               } // end for k; ntr 
 4494: 
 4495:             else !simple upwind method
 4496:               do j=1,i34(ie)
 4497:                 jsj=elside(j,ie)
 4498:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 4499:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 4500:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 4501:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 4502:                   endif
 4503:                 enddo  !vertical layers
 4504:               enddo !j=1,i34(ie) ! side
 4505:             endif !order of accuracy
 4506: 
 4507:          //  enddo !ie
 4508: // !$OMP     end do
