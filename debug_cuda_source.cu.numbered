 5069: 
 5070: __global__ void computeMatrixProductAndDotProducts() {
 5071:    // Computes A*p, r'Mr and p'Ap
 5072: 
 5073:    // 1) shared buffer: first half for rMr, second for pAp
 5074:    __shared__ double sdata[2*BLOCK_SIZE];
 5075:    double* s_rMr = sdata;
 5076:    double* s_pAp = sdata + BLOCK_SIZE;
 5077: 
 5078:    // 2) get your node pointer
 5079:    NODE(node);  
 5080:    const int tid = threadIdx.x;
 5081: 
 5082:    const double diag = node->coeffDiag;
 5083:    const double r    = node->mR;
 5084:    const double p    = node->mP;  
 5085: 
 5086:    // apply preconditioner on the fly:
 5087:    const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 5088: 
 5089:    // 4) compute Ap = A.p
 5090:    double Ap = node->coeffDiag * node->mP;
 5091:    for (int j = 0; j < node->numNodes; ++j) {
 5092:       const Node *nbNode = node->nodes[j];
 5093:       Ap += node->coeffMatrix[j] * nbNode->mP;
 5094: 
 5095:    }
 5096:    node->mAp = Ap;
 5097:     
 5098: 
 5099:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 5100:    const double l_rMr = r*Mr;  // r'Mr
 5101:    const double l_pAp = p*Ap;  // p'Ap
 5102: 
 5103:    // 6) write into shared mem
 5104:    s_rMr[tid] = l_rMr;
 5105:    s_pAp[tid] = l_pAp;
 5106: 
 5107: 
 5108:    __syncthreads();
 5109: 
 5110:    // 7) block-wide tree reduction
 5111:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 5112:       if (tid < stride)  s_pAp[tid] += s_pAp[tid + stride];
 5113:       __syncthreads();
 5114:    }
 5115: 
 5116:    // 8) thread 0 atomically accumulates into the globals
 5117:    // XXX: This is slower than it needs to be, but it is simple and works
 5118:    if (tid == 0) atomicAdd(pAp, s_pAp[0]);
 5119: 
 5120: 
 5121: 
 5122: }
 5123: 
 5124: 
 5125: __global__ void updateSolutionAndDotProducts(void) {
 5126:     extern __shared__ double s_rMr[BLOCK_SIZE];       
 5127: 
 5128: 
 5129:     // get node & bounds-check:
 5130:     NODE(node);
 5131:     const int tid = threadIdx.x;
 5132: 
 5133: 
 5134:     // Compute alpha
 5135:     const double alpha = (*rMr_old)/(*pAp);
 5136: 
 5137:     // load scalars
 5138:     const double diag = node->coeffDiag;
 5139:     const double p    = node->mP;
 5140:     const double Ap   = node->mAp;
 5141:     const double x    = node->mX;
 5142:     const double r    = node->mR;
 5143:     
 5144:     assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 5145: 
 5146:     // 1) update solution & residual
 5147:     const double x_new = x + alpha*p;
 5148:     const double r_new = r - alpha*Ap;
 5149:     node->mX = x_new;
 5150:     node->mR = r_new;
 5151: 
 5152:     // 2) apply Jacobi preconditioner on the fly
 5153:     const double Mr_new = r_new/diag;
 5154: 
 5155: 
 5156:     // 3) local contributions for the two dot-products
 5157:     const double l_rMr = r_new*Mr_new;  // r'M^-1r
 5158: 
 5159:     // 4) write into shared-mem
 5160:     s_rMr[tid] = l_rMr;
 5161: 
 5162:     __syncthreads();
 5163: 
 5164: 
 5165:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 5166:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 5167:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 5168:         __syncthreads();
 5169:     }
 5170: 
 5171:     // 6) thread 0 atomically folds into the global accumulators
 5172:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 5173: 
 5174: 
 5175: }
 5176: 
 5177: 
 5178: __global__ void updateSearchDirection() {
 5179:     NODE(node);
 5180: 
 5181:     // recompute z on-the-fly
 5182:     const double z = node->mR / node->coeffDiag;
 5183:     const double p = node->mP;
 5184: 
 5185:     const double beta = (*rMr_new)/(*rMr_old);
 5186: 
 5187: // printf("ZZZ updateSearchDirection: beta = %f\n", beta);
 5188: 
 5189:     // p =z + beta*p
 5190:     node->mP = z + beta*p;
 5191: 
 5192: }
 5193: 
 5194: __global__ void initializePreconditionedResidual(double *scalars) {
 5195: 
 5196:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 5197: 
 5198:     NODE(node);
 5199:     const int tid = threadIdx.x;
 5200:     // For the first iteration:
 5201:     // 1. Initial solution x = 0 (already set)
 5202:     // 2. Initial residual r = b (stored in qel)
 5203:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 5204: 
 5205: // XXX we should use the guess solution here    
 5206: 
 5207:     // Set initial residual r = b (from qel)
 5208:     node->mR = node->qel;
 5209: 
 5210:     // Compute z = M^-1 * r (preconditioned residual)
 5211:     const double z = node->mR / node->coeffDiag;
 5212: 
 5213:     // Set initial search direction p = z
 5214:     node->mP = z;
 5215: 
 5216:     // Initialize other variables needed for CG
 5217:     node->mX = 0.0;  // Initial solution
 5218:     node->mAp = 0.0; // Will be computed in first iteration
 5219: 
 5220:     // These point to a cupy array in the host code
 5221:     rMr_old = scalars + 0;
 5222:     rMr_new = scalars + 1;
 5223:     pAp     = scalars + 2;
 5224: 
 5225:     // Computes the first r'Mr (reduction)
 5226:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 5227: 
 5228:     // 4) write into shared-mem
 5229:     s_rMr[tid] = l_rMr;
 5230: 
 5231:     __syncthreads();
 5232: 
 5233: 
 5234:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 5235:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 5236:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 5237:         __syncthreads();
 5238:     }
 5239: 
 5240:     // 6) thread 0 atomically folds into the global accumulators
 5241:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 5242: 
 5243:     *rMr_old = 0.0;
 5244:     *pAp = 0.0;
 5245: }
