 2092: /**
 2093:  * This method performs backtracking from the side center until a time -dt back in time 
 2094:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2095:  * intermediate point.
 2096:  *
 2097:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2098:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2099:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2100:  * remaining time.
 2101:  * 
 2102:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2103:  * 
 2104:  * @param uuint, vvint, wwint: Velocities at the final point
 2105:  * @param jlev: Level at which the backtracking is performed
 2106:  * @param dt, dtbk: Tracking timesteps
 2107:  * @return: True if the backtracking was successful, false otherwise
 2108:  */
 2109: __inline__ __device__ bool Side::btrack(
 2110:       int jlev,
 2111:       double dt,            // Tracking time
 2112:       double dtbk,          // Tracking timestep
 2113:       Vector3 &u_int
 2114: ) const {
 2115: 
 2116:    // Start from side center
 2117:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2118:  
 2119: 
 2120:    double time_rm = dt; // Remaining time
 2121: 
 2122: 
 2123:    // // Initialize outputs XXX
 2124:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2125:    //    sclr[i] = 0.0;
 2126:    // }
 2127: 
 2128: 
 2129:    // Initial velocities
 2130:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 2131: 
 2132: // printf("YY 1, u_int = %f,%f\n", u_int.x, u_int.y);
 2133: 
 2134:    // Find the element that is in the direction opposite to the velocity
 2135:    Element* curElem = findElementTowards({u_int.x, u_int.y});
 2136: // printf("YY 2, curElem = %p\n", curElem);
 2137:    const int MAX_ITERATIONS = 1000; 
 2138:    Element* nextElem = curElem;
 2139:    int iter = 0;
 2140:    while(true) {
 2141:       // Calculate timestep
 2142:       double dtb = min(dtbk, time_rm);
 2143: 
 2144:       // Next point in the backtracking curve
 2145:       Point3 xt = x0 - dtb*u_int;
 2146: // printf("YY 3, dtb = %f, curElem = %p, u_int = %f,%f,%f\n", dtb, curElem, u_int.x, u_int.y, u_int.z);
 2147:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb);
 2148: // printf("YY 4, found = %d\n", found);
 2149:       assert(found && "Backtracking failed in btrack");
 2150: // printf("<>T = %f, %f %f %f\n", time_rm - dtb, xt, yt, zt);
 2151:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2152:                       // then time_rm needs to be increased by the unused time.
 2153:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2154: 
 2155:       // The current point becomes the next segment's starting point.
 2156:       x0 = xt;
 2157:  
 2158:       curElem = nextElem;
 2159: 
 2160:       iter++;
 2161:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2162:    }
 2163: 
 2164: 
 2165: }
 2166: 
 2167: 
