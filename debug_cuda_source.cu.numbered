 1050:       printf("npgb = %d, negb = %d, nsgb = %d, nseg = %d\n", npgb, negb, nsgb, nseg);
 1051:       printf("np = %d, ne = %d, ns = %d\n", np, ne, ns);
 1052:       printf("max_np = %d, max_ne = %d, max_ns = %d\n", max_np, max_ne, max_ns);
 1053:       printf("nvrt = %d, kz = %d\n", nvrt, kz);
 1054:       printf("elemsPtr = %p, elems = %p\n", *elems, elemsMem);
 1055:       
 1056:       sinh_theta_f = sinh(theta_f);
