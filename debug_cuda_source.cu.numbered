 4945: extern "C"
 4946:                                  
 4947:   __global__ void populateMesh(int *i34, int *elnode, int *elside,
 4948:                    double *node_coords, double *wind_rotate_angle, 
 4949:                    int *isdel, int *isidenode, int *isbnd,
 4950:                    int *nond, int *nlnd, int *iond, int *ilnd,
 4951:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4952:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4953:                    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4954:                    int *localNodeIndices, int *localElemIndices, int *localSideIndices,
 4955:                    int *localNodePart,    int *localElemPart,    int *localSidePart) {
 4956: 
 4957:     mesh->populateMesh(i34, elnode, elside, node_coords, wind_rotate_angle, 
 4958:                        isdel, isidenode, isbnd,
 4959:                        nond, nlnd, iond, ilnd,
 4960:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 4961:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 4962:                        globalNodeIndices, globalElemIndices, globalSideIndices,
 4963:                        localNodeIndices, localElemIndices, localSideIndices,
 4964:                        localNodePart, localElemPart, localSidePart);
 4965:   }
