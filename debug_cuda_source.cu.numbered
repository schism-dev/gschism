 1968: //       const Side& side = sides[i];
 1969: 
 1970: //       xIntersect=-1.e25;
 1971: //       yIntersect=-1.e25;
 1972: 
 1973: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 1974: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 1975: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 1976: 
 1977: //       if (delta != 0.0) {
 1978: //          // Solves the two linear equations for tt1 and tt2
 1979: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1980: //          const double tt2 = delta2/delta;
 1981: 
 1982: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 1983: //          // Similarly, we use tt2 to compute the intersection point.
 1984: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 1985: //             xIntersect = x3 + (x4 - x3)*tt2;
 1986: //             yIntersect = y3 + (y4 - y3)*tt2;
 1987: 
 1988: //             intersectingSide = side;
 1989: //             nextElement = nghbElems[i];
 1990: 
 1991: //             return true;
 1992: //          }
 1993:       
 1994: //       }
 1995: //       else {
 1996: //          // The two segments are parallel
 1997: //          return false;
 1998: //       }
 1999: 
 2000: //    }
 2001: 
 2002: //    return false;
