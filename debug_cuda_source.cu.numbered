 2903: __device__ void computeVerticallyIntegratedVelocity(void) {
 2904: 
 2905:    Side *side = SIDE_PTR;
 2906: 
 2907:    side->U = {0.0, 0.0}; 
 2908:       
 2909:    if(side->idry) return;
 2910: 
 2911:    const Node *node1 = side->n1;
 2912:    const Node *node2 = side->n2;
 2913: 
 2914:    // Vertically integrated velocity U (in ll if ics=2)
 2915:    for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 2916:       side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 2917:    }
 2918: 
 2919: }
