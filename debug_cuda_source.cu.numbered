 1153: /**
 1154:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1155:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1156:    If the segment is completely inside the element, then it returns true.
 1157: 
 1158:    This function assumes:
 1159:    - The initial point is on a side of the element. 
 1160:    - Its position is given by parameter t in the range [0,1].
 1161:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1162:       intersects the element (elements are convex).
 1163: 
 1164:    To find the intersection point, this function does the following:
 1165:    - it finds the intersection of the line segment with all the element side lines,
 1166:       except for the one that contains the initial point.
 1167:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1168:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1169:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1170:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1171:       track segment is almost parallel to the element side line.
 1172: 
 1173:    Inputs:
 1174:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1175:    @param x2, y2: other end of the line segment
 1176: 
 1177:    Outputs:
 1178:    @param side:  side that intersects the line segment (input and output)
 1179:    @param nextElement (output): element that contains the intersection point
 1180:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1181:    @param zint (input/output): Vertical coordinate of the intersection point
 1182: 
 1183:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1184:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1185:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1186: 
 1187:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1188:    (Delta) being zero.
 1189: 
 1190:    The intersection2 point happens when:
 1191:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1192:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1193:    
 1194:    Assumption: the 4 points (including those of the side segment) are different.
 1195:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1196:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1197:    If true, (xIntersect,yIntersect) is the intersection.				
 1198:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1199: **/
 1200: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1201:                                               double &t, double& tIntersect) {
 1202: 
 1203:    double closest_intersect_t = 1e10;
 1204:    bool found_intersection = false;
 1205: 
 1206:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1207:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1208:    const Point2 x1 = side->point(t);
 1209:    
 1210: 
 1211:    Side *nextSide = nullptr;
 1212: 
 1213:    for (int i = 0; i < i34; i++) {
 1214: 
 1215:       // Element's i-th side 
 1216:       Side *side2 = sides[i];
 1217: 
 1218:       // Skip the side that contains the initial point
 1219:       if (side2 == side) continue;
 1220: 
 1221:       // (x3,y3)-(x4,y4) is the element side line
 1222:       const Point2 x3 = side2->n1->p2();
 1223:       const Point2 x4 = side2->n2->p2();
 1224: 
 1225:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1226:       const double delta = cross(x2 - x1, x3 - x4);
 1227: 
 1228:       if (delta != 0.0) {
 1229: 
 1230:          const double delta1 = cross(x3 - x1, x3 - x4);
 1231:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1232: 
 1233:          // Solves the two linear equations for tt1 and tt2
 1234:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1235:          const double tt2 = delta2/delta;
 1236: 
 1237:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1238:             closest_intersect_t = min(closest_intersect_t, tt1);
 1239:             nextSide = side2;
 1240: 
 1241:             nextElement = nextSide->otherElem(this);
 1242:             tIntersect = max(small, min(tt1, 1.0-small));
 1243:             t = tt2;
 1244: 
 1245:             found_intersection = true;
 1246:          }
 1247:       
 1248:       }
 1249: 
 1250:    }
 1251: 
 1252: 
 1253:    // found_intersection should always be true, since we checked all the sides.  
 1254:    side = nextSide;
 1255: // if (found_intersection) {
 1256: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1257: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1258: // }   
 1259:    return found_intersection;
 1260: }
 1261: 
 1262: 
 1263: 
 1264: 
 1265: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1266:                                               double &t, double& tIntersect) {
 1267: 
 1268:    double closest_intersect_t = 1e10;
 1269:    bool found_intersection = false;
 1270: 
 1271:    for (int i = 0; i < i34; i++) {
 1272: 
 1273:       Side *side2 = sides[i];
 1274: 
 1275:       // (x3,y3)-(x4,y4) is the element side line
 1276:       const Point2 x3 = side2->n1->p2();
 1277:       const Point2 x4 = side2->n2->p2();
 1278: 
 1279:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1280:       const double delta = cross(x2 - x1, x3 - x4);
 1281: 
 1282:       if (delta != 0.0) {
 1283: 
 1284:          const double delta1 = cross(x3 - x1, x3 - x4);
 1285:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1286: 
 1287:          // Solves the two linear equations for tt1 and tt2
 1288:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1289:          const double tt2 = delta2/delta;
 1290: 
 1291:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1292:             closest_intersect_t = min(closest_intersect_t, tt1);
 1293:             side = side2;
 1294:             nextElement = side->otherElem(this);
 1295:             t = tt2;
 1296:             tIntersect = max(small, min(tt1, 1.0-small));
 1297:             found_intersection = true;
 1298:          }
 1299:       
 1300:       }
 1301: 
 1302:    }
 1303: 
 1304: // if (found_intersection) {
 1305: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1306: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1307: // }
 1308: 
 1309:    // found_intersection should always be true, since we checked all the sides.  
 1310:    return found_intersection;
 1311: }
 1312: 
 1313: 
 1314: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1315:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1316: 
 1317:    printf("Tracking segment goes out of water at element %d\n", curElem->idx);
 1318: 
 1319:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1320:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1321:    // curElement.
 1322: 
 1323:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1324:    // And uses this velocity instead to continue the tracking.
 1325: 
 1326:    // computes the intersection point in cartesian coordinates
 1327:    Point2 intersection = nextSide->p_t(tt);
 1328: 
 1329:    // Nudges the point to the barycenter of the element. 
 1330:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1331:    // next segment intersects the element sides.  
 1332:    curElem->nudgeToBarycenter(intersection);
 1333: 
 1334:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1335:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1336:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1337:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1338: 
 1339:    // If the side is an open boundary, the tangential velocity is zero.
 1340:    if (nextSide->isBnd()) vtan = 0.0;
 1341: 
 1342:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1343:    const double us = vtan*nextSide->t().x;
 1344:    const double vs = vtan*nextSide->t().y;
 1345:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1346: 
 1347:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1348:    const double len2 = length(intersection - toPoint2(xt));
 1349:    const double vel2 = u_int.x*u_int.x + u_int.y*u_int.y;        
 1350:    assert(vel2 > 0.0 && "Zero velocity found");
 1351:    dt = dt - sqrt(len2/vel2); 
 1352: 
 1353:    // The end of this tracking segment is now the intersection point.
 1354:    xt = {intersection.x, intersection.y, zint};
 1355:    
 1356:    u_int = {us, vs, ws};
 1357:    
 1358: }
 1359: 
 1360: /**
 1361:  * Tracks a particle through elements and vertical levels in the mesh.
 1362:  * 
 1363:  * @param x0,y0,z0     Starting position coordinates
 1364:  * @param xt,yt,zt     Target position coordinates
 1365:  * @param dtb          Time step for tracking
 1366:  * @param uuint,vvint,wwint Initial velocity components
 1367:  * @param nextElem     Starting/resulting element index
 1368:  * 
 1369:  * @return Status code of type trackExitCodes
 1370:  * 
 1371:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1372:  * of the details are different. The idea is that the code requires less branches and is better fit
 1373:  * for GPU execution.
 1374:  * 
 1375:  * The main ideas here are:
 1376:  * - The starting point is expected to be in the starting element.
 1377:  * - The end point is guaranteed to be inside an element.
 1378:  * - since the starting point is inside the element, there are only two cases: 
 1379:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1380:  *     (b) it does not and (xt,yt) is already in the starting element.
 1381:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1382:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1383:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1384:  * - tt1 can be positive or negative. We only consider the positive values.
 1385:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1386:  * - The next intersection will occur at the smallest positive tt1.
 1387:  * - This intersection will be the next (x0,y0) position.
 1388:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1389:  *   of getting stuck in a loop.
 1390:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1391:  *   was found.
 1392:  */
 1393: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1394:                                                        Element *&nextElem, int &jlev, double &dt) {
 1395: 
 1396:    // First thing is to check if the target point is inside the element. If it is there is nothing
 1397:    // else to do.
 1398:    if (containsPoint(toPoint2(xt))) {
 1399:       nextElem->interpolateVelocities(xt, u_int);
 1400:       return true;
 1401:    }
 1402: 
 1403:    Side *side = nullptr;
 1404: 
 1405:    // 1. Initial checks
 1406:    // Verify starting element is valid (wet)
 1407:    assert(!nextElem->idry && "Starting element is dry");
 1408: 
 1409:    // Checks if track has a zero length.
 1410:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1411:    assert(len2 > 0.0 && "Zero length track"); 
 1412:    
 1413: 
 1414:    const int MAX_ITERATIONS = 1000;
 1415:    
 1416:    double t;
 1417:    Side *nextSide = nullptr;
 1418:    double tIntersect = 1e10;
 1419:    double zint = x0.z;
 1420: 
 1421:    // Horizontal tracking loop
 1422:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1423:    // (x0,y0) is inside the element but the target point is not.
 1424:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1425:    assert(found_intersection && "No intersection found");
 1426: 
 1427:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1428: 
 1429:    // if the tracking segment goes out of water (either dry or edge boundary)
 1430:    if (isEdgeBoundary(nextSide) || (nextElem->idry)) {
 1431:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1432:       nextElem = this;
 1433:       
 1434:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1435:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1436:       return true;    
 1437:       }
 1438: 
 1439:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1440:    int iterations = 0;
 1441:    while (iterations < MAX_ITERATIONS) {
 1442:       iterations++;
 1443:       
 1444:       Element *curElem = nextElem;
 1445: 
 1446:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1447:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1448: 
 1449:       // If we are already in the target element, we are done.
 1450:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1451:       if (!found_intersection) break;
 1452: 
 1453: 
 1454:   
 1455:       // if the tracking segment goes out of water (either dry or edge boundary).
 1456:       if (curElem->isEdgeBoundary(nextSide) || (nextElem->idry)) {
 1457: 
 1458:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1459: 
 1460:          nextElem = curElem;
 1461: 
 1462:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1463:          // In this case, the caller (btrack) needs to take into account the remaining time.
 1464:          return true;
 1465:       }
 1466:       
 1467:       // Update position and element for next iteration
 1468:       side = nextSide;
 1469: 
 1470:    }
 1471: 
 1472: 
 1473:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 1474: 
 1475:  
 1476:    // Interpolate velocities at the final position. This is a conceptually simple step,
 1477:    // but the function is not simple, because it has to search for the vertical level containing zt.
 1478:    nextElem->interpolateVelocities(xt, u_int);
 1479: 
 1480: 
 1481:    return true;
 1482: }
 1483: 
 1484: 
 1485: 
 1486: 
 1487: __inline__ __device__ double Element::computeSignedArea(void) const {
 1488:    // Compute the area of the element
 1489: 
 1490:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 1491: 
 1492:    // In the quad case we need to add the area of the other triangle.
 1493:    if (isQuad()) {
 1494:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1495:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 1496:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1497:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 1498:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 1499:          Error("Negative area found in quad element");
 1500:       }
 1501:       res += ar1;
 1502:    }
 1503: 
 1504:    return res;
 1505: }
 1506: 
 1507: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 1508:    // In boundary sides, the element 1 is nullptr
 1509:    return side->elems[1] == nullptr; 
 1510: }
 1511: 
 1512: /**
 1513:    Compute the shape coordinates of the point (xt,yt) in the element.
 1514:    @param xt (input): x-coordinate of the point
 1515:    @param shpCoords (output): shape coordinates of the point
 1516:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 1517:    @return true if the point is inside the element, false otherwise
 1518: **/
 1519: __device__ bool Element::computeShapeCoords(Point2 xt, double shpCoords[4],
 1520:                                             bool fixNegshpCoord) const {
 1521: 
 1522:    // Compute the shape coordinates of the point xt in the element.
 1523:    if (i34==3) {
 1524:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 1525:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 1526:       // and in this case, the pt will be nudged into the element
 1527:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 1528:       // from the local frame, so use additional check.
 1529: 
 1530:       Point2 x0, x1, x2;
 1531: 
 1532:       if constexpr(ics==1) {
 1533:          x0 = nodes[0]->p2();
 1534:          x1 = nodes[1]->p2();
 1535:          x2 = nodes[2]->p2();
 1536:       }
 1537:       else // lat/lon
 1538:       {
 1539:          Error("Not implemented yet");
 1540: #ifdef ICS2
 1541:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 1542:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 1543:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 1544: #endif
 1545:       }
 1546: 
 1547:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 1548:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 1549:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 1550:       shpCoords[3] = 0.0;
 1551:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 1552: 
 1553:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 1554:       // then we fix the negative shape coordinates.
 1555:       if (fixNegshpCoord && tmpmin<=0.0) {
 1556: 
 1557:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 1558:          // keeping the sum of the shape coordinates equal to 1.
 1559:          // I have tested and compared the new algorithm with the old one, and they give
 1560:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 1561:          // The new algorithm should be faster since it is branchless.
 1562:          const double a = - tmpmin + 1.0e-2;  // XXX it used to be 1.0e-4 in the comments of the original code
 1563:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 1564:          
 1565:          shpCoords[0] = (shpCoords[0] + a)*b;
 1566:          shpCoords[1] = (shpCoords[1] + a)*b;
 1567:          shpCoords[2] = (shpCoords[2] + a)*b;          
 1568: 
 1569:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 1570:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 1571:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 1572:          }
 1573: 
 1574:          // Update the point coordinates for the new shape coordinates
 1575:          double xcoords[3] = {x0.x, x1.x, x2.x};
 1576:          double ycoords[3] = {x0.y, x1.y, x2.y};
 1577:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 1578: 
 1579:       }
 1580: 
 1581:       // Check if the point is inside the element
 1582:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 1583:    }
 1584:    else {
 1585:       Error("Not implemented yet");
 1586: #ifdef QUADS
 1587:       // Reproject pt in eframe of nel for ics=2
 1588:       if constexpr(ics==1) {
 1589:          xn2 = xt; 
 1590:          yn2 = yt;
 1591:       }
 1592:       else {
 1593:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 1594:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 1595:       }
 1596: 
 1597:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 1598: #endif
 1599:    }
 1600: 
 1601: }
 1602: 
 1603: 
 1604: /**  Interpolate velocities at a given point (xt,yt,zt)
 1605: 
 1606:    @param xt, yt, zt: coordinates of the point to interpolate
 1607:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 1608: 
 1609:    This is done in four steps:
 1610: 
 1611:    1. Find the shape coordinates for the final position in the element.
 1612:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 1613:    3. Perform a *binary search* to find the vertical level containing zt. It will have to interpolate the 
 1614:       z levels at xt, yt at each step.   
 1615:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 1616:       horizontally and vertically.
 1617: **/
 1618: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) {
 1619:    // Interpolate the velocities at the point xt. 
 1620:    // This function works the same for triangular and quadrilateral elements.
 1621:    double shpCoord[4];
 1622: 
 1623: 
 1624:    // First step is to compute the shape coordinates of (xt,yt)
 1625:    computeShapeCoords(toVector2(xt), shpCoord, false);
 1626:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 1627: 
 1628:    // Second step is to find the level that contains zt
 1629:    // Uses a binary search to find the level
 1630:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 1631:    int L = kbe;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 1632:    int R = nvrt - 1;
 1633: 
 1634:    // Get the z coordinates at the nodes of the element at the levels L and R
 1635:    double zLAtNodes[4], zRAtNodes[4];
 1636:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 1637:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 1638: 
 1639:    double zL = interpolate(shpCoord, zLAtNodes);
 1640:    double zR = interpolate(shpCoord, zRAtNodes);
 1641:    
 1642:    // Interpolates vertically the velocities
 1643:    double wght1, wght2;
 1644:    if (xt.z<=zL) {
 1645:       wght1 = 1.0;
 1646:       wght2 = 0.0;
 1647:    }
 1648:    else if (xt.z>=zR) {
 1649:       wght1 = 0.0;
 1650:       wght2 = 1.0;
 1651:    }
 1652:    else {
 1653:       // Perform a binary search to find the levels between L and R that contain xt.z
 1654:       while (R - L > 1) {
 1655:          int M = (L + R) / 2;
 1656: 
 1657:          double zMAtNodes[4];
 1658:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 1659:          double zM = interpolate(shpCoord, zMAtNodes);
 1660:          if (zM < xt.z) 
 1661:          {
 1662:             L = M;
 1663:             zL = zM;
 1664:          }
 1665:          else 
 1666:          {
 1667:             R = M;
 1668:             zR = zM;
 1669:          }
 1670:       }
 1671:       assert(L == R-1);
 1672:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 1673: 
 1674:       wght2 = (xt.z - zL)/(zR - zL);
 1675:       wght1 = 1.0 - wght2;
 1676:    }
 1677: // printf("$$$ wght1 = %f, wght2 = %f, zt = %f, zL = %f, zR = %f\n", wght1, wght2, zt, zL, zR);
 1678: // printf("$$$ shpCoord = %f, %f, %f, %f\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 1679:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 1680:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 1681: 
 1682:    // Neither of the interpolated velocities should be NaN
 1683:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 1684: 
 1685: }
