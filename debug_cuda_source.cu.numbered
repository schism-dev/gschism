  247: 
  248: 
  249: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  250:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  251:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  252: }
  253: 
  254: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  255:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  256:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  257: }
  258: 
  259: 
  260: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  261:    x3 = y1*z2 - y2*z1;
  262:    y3 = x2*z1 - x1*z2;
  263:    z3 = x1*y2 - x2*y1;
  264: }
  265: 
  266: 
  267: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  268: // Given a 3D global point (may not be on surface of earth), find its longitude and latitude in radians
  269: 
  270:    const double radius2 = dot(p, p);
  271:    assert(radius2 != 0.0     && "computeLonLat: radius = 0");
  272:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  273: 
  274:    rlon = atan2(p.y, p.x); // (-pi,pi]
  275: 
  276:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  277:       rlat = asin(p.z/sqrt(radius2));
  278:    } else {
  279:       rlat = asin(p.z/rearth_pole);
  280:    }
  281:   
  282: }
  283: 
  284: __inline__ __device__ void Error(const char* msg) {
  285:    printf("Error: %s\n", msg);
  286:    assert(false);
  287: }
