   69: // VECTOR/POINT operations ---------------------------------------------------------------------------
   70: 
   71: using Vector2 = double2; 
   72: using Vector3 = double3;
   73: using Point2  = double2;
   74: using Point3  = double3;
   75: 
   76: __device__ __host__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
   77:     return make_double2(a.x + b.x, a.y + b.y);
   78: }
   79: 
   80: __device__ __host__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
   81:     a.x += b.x;
   82:     a.y += b.y;
   83:     return a;
   84: }
   85: 
   86: __device__ __host__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
   87:     return make_double2(a.x - b.x, a.y - b.y);
   88: }
   89: 
   90: __device__ __host__ __forceinline__ double2 operator*(const double2& v, const double s) {
   91:     return make_double2(v.x * s, v.y * s);
   92: }
   93: 
   94: __device__ __host__ __forceinline__ double2 operator*(const double s, const double2& v) {
   95:     return v * s;  // reuse the previous operator
   96: }
   97: 
   98: __device__ __host__ __forceinline__ double2 operator/(const double2& v, double s) {
   99:     return make_double2(v.x / s, v.y / s);
  100: }
  101: 
  102: __device__ __host__ __forceinline__ double length(const double2& v) {
  103:     return sqrt(v.x*v.x + v.y*v.y);
  104: }
  105: 
  106: __device__ __host__ __forceinline__ double dot(const double2& v, const double2& w) {
  107:     return v.x*w.x + v.y*w.y;
  108: }
  109: 
  110: __device__ __host__ __forceinline__ double cross(const double2& v, const double2& w) {
  111:     return v.x*w.y - v.y*w.x;
  112: }
  113: 
  114: __device__ __host__ __forceinline__ double3 operator+(const double3& a, const double3& b) {
  115:     return make_double3(a.x + b.x, a.y + b.y, a.z + b.z);
  116: }
  117: 
  118: __device__ __host__ __forceinline__ double3 operator+=(double3& a, const double3& b) {
  119:     a.x += b.x;
  120:     a.y += b.y;
  121:     a.z += b.z;
  122:     return a;
  123: }
  124: 
  125: __device__ __host__ __forceinline__ double3 operator-(const double3& a, const double3& b) {
  126:     return make_double3(a.x - b.x, a.y - b.y, a.z - b.z);
  127: }
  128: 
  129: __device__ __host__ __forceinline__ double3 operator*(const double3& v, double s) {
  130:     return make_double3(v.x * s, v.y * s, v.z * s);
  131: }
  132: 
  133: __device__ __host__ __forceinline__ double3 operator*(double s, const double3& v) {
  134:     return v * s;
  135: }
  136: 
  137: __device__ __host__ __forceinline__ double3 operator/(const double3& v, double s) {
  138:     return make_double3(v.x / s, v.y / s, v.z / s);
  139: }
  140: 
  141: __device__ __host__ __forceinline__ double dot(const double3& v, const double3& w) {
  142:     return v.x*w.x + v.y*w.y + v.z*w.z;
  143: }
  144: 
  145: __device__ __host__ __forceinline__ Vector2 toVector2(const double3& v) {
  146:     return make_double2(v.x, v.y);
  147: }
  148: 
  149: __device__ __host__ __forceinline__ double3 toVector3(const double2& v, double w) {
  150:     return make_double3(v.x, v.y, w);
  151: }
  152: 
  153: __device__ __host__ __forceinline__ Point2 toPoint2(const double3& p) {
  154:     return make_double2(p.x, p.y);
  155: }
  156: 
  157: __device__ __host__ __forceinline__ Point3 toPoint3(const double2& p, double z) {
  158:     return make_double3(p.x, p.y, z);
  159: }
