 1115: // Helper functions for computing the local node index at a given offset from another.
 1116: __device__ __inline__ int nxq(int offset, int index, int size) {
 1117:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1118:    // to the index to make it positive
 1119:    assert(index + offset + 16*size >= 0);
 1120:    return (index + offset + 16*size) % size;  
 1121: }
 1122: 
 1123: __device__ __inline__ int nxq(int index, int size) {
 1124:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1125:    // to the index to make it positive
 1126:    assert(index + 16*size >= 0);
 1127:    return (index + 16*size) % size; 
 1128: }
