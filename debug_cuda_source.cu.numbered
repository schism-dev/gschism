 2471: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 2472:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 2473:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 2474:    // 
 2475:    // This kernel is called for all nodes.
 2476: 
 2477: 
 2478:    NODE(node1);
 2479: 
 2480: 
 2481:    node1->clearMatrixRow();
 2482:    node1->qel = 0.0;
 2483: 
 2484:    // THIS IS FOR STRUCTURES XXX
 2485:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 2486: 
 2487:    
 2488:    for (int j=0; j<node1->numElements; j++) {
 2489:       // For each element connected to the node...
 2490: 
 2491:       Element *elem = node1->elements[j];
 2492: 
 2493:       // Compute the average gravity
 2494:       const double grav3 = elem->mean(&Node::grav2);
 2495: 
 2496:       // Look at the documentation for the description of the terms in the following integrals
 2497: 
 2498:       // Integral I_1 
 2499:       // \bar{\breve{H}} 
 2500:       const double hhatb = elem->mean(&Side::hhat);        
 2501: 
 2502:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 2503: 
 2504:       const int id1 = elem->nodeLocalIdx(node1); 
 2505:       const double area = elem->area;
 2506: 
 2507:       if (elem->isTri()) {
 2508: 
 2509:          // To clarify the notation in this section: 
 2510:          //   i standtimes for the node under consideration (node1)
 2511:          //   j (node2) and k (node3) are the other nodes of the triangle.
 2512:          const int id2 = elem->nxq(1 + id1);
 2513:          const int id3 = elem->nxq(2 + id1);
 2514:          Node *node2 = elem->nodes[id2];
 2515:          Node *node3 = elem->nodes[id3];
 2516: 
 2517:          const Point2 x1 = node1->p2();
 2518:          const Point2 x2 = node2->p2();
 2519:          const Point2 x3 = node3->p2();
 2520: 
 2521:          // integral of phi_i*phi_j
 2522:          const double ipp_ii = (1.0/6.0 )*area;
 2523:          const double ipp_ij = (1.0/12.0)*area;
 2524:          const double ipp_ik = (1.0/12.0)*area;
 2525: 
 2526:          // integral of [(grad phi_i) * (grad phi_j)]
 2527:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 2528:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 2529:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 2530: 
 2531:          // Computes the different components of integral I_1 of each node with respect to node i.
 2532:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 2533:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 2534:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 2535: 
 2536:          node1->addToSparseMatrix(node1, I1_ii);
 2537:          node1->addToSparseMatrix(node2, I1_ij); 
 2538:          node1->addToSparseMatrix(node3, I1_ik);
 2539: 
 2540:          printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 2541:      
 2542:       }
 2543:       else { // Quad
 2544:          // XXX IMPLEMENT THIS
 2545:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2546:       } 
 2547: 
 2548:  
 2549:       // Integral I_4
 2550:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 2551:       // Where
 2552:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 2553: 
 2554:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 2555:       // of U over the element.
 2556:       Vector2 Umean = {0.0, 0.0};
 2557:       for (int m=0; m<elem->i34; m++) {      
 2558:          const Side *side = elem->sides[m];
 2559: 
 2560:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 2561:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 2562:       }
 2563:       Umean = Umean/elem->i34;
 2564: 
 2565:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 2566: 
 2567:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 2568:       const double I_4_1 = dot(gradPhi_1, Umean);
 2569: 
 2570:       // Integral of \nabla\phi_i \cdot \pmb{E}
 2571:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 2572:      
 2573:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);
 2574:       
 2575: 
 2576:       // Additional terms 
 2577:       double vnorm = 0.0;
 2578:       if (imm == 2)  { // Pre-compute vnorm on the element
 2579:          Vector3 ubed;
 2580:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 2581: 
 2582:          Vector3 gradP(0.0, 0.0, 1.0);
 2583:          for (int m=0; m < elem->i34; m++) {
 2584:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 2585:            gradP += toVector3(gradP_2D, 0.0);
 2586:          }   
 2587:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 2588:       } // imm==2
 2589: 
 2590:       if (elem->isTri()) {
 2591:          for (int l=0; l<3; l++) {
 2592:            double fac;
 2593: 
 2594:            Node *node = elem->nodes[l];
 2595: 
 2596:            (node == node1)? fac=2.0 : fac=1.0;
 2597: 
 2598:            if (imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 2599:            else        node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 2600:            
 2601:          }
 2602: 
 2603:          if (!elem->isDry) {
 2604:            const Vector2 gradEta = elem->nodes[0]->eta2*elem->gradPhi[0] +
 2605:                                    elem->nodes[1]->eta2*elem->gradPhi[1] +
 2606:                                    elem->nodes[2]->eta2*elem->gradPhi[2];
 2607: 
 2608:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 2609:          }
 2610: 
 2611:       } // isTri
 2612:       else { // isQuad
 2613:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2614:          // for (int l=0; l<4; l++) {
 2615:          //   const Node *node = elem->nodes[l];
 2616: 
 2617:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 2618:          //   else        tmp2 = node->bdef2 - node->bdef1;
 2619: 
 2620:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 2621:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 2622:          // }
 2623: 
 2624:       } // isQuad
 2625: 
 2626: 
 2627:       node1->qel += (dt/elem->i34)*elem->vsource;
 2628:       
 2629: 
 2630:    } // for all elements connected to the node
 2631:    
 2632: 
 2633: 
 2634:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 2635:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 2636:    NodeBoundary *nodeBnd = node1->nodeBnd;
 2637:    if (nodeBnd != nullptr)  { 
 2638:       // If it is an open boundary node...
 2639: 
 2640:       // At least one open bnd side, maybe two
 2641:       for (int l=0; l<2; l++) { 
 2642: 
 2643:          // Gets each of the sides sharing the node. 
 2644:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 2645: 
 2646:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 2647: 
 2648:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 2649: 
 2650: 
 2651:          if (sideBnd != nullptr) {
 2652:             // If the side is on a boundary...
 2653: 
 2654:             // Get the boundary segment
 2655:             const BoundarySegment *sideSegment = sideBnd->segment;
 2656:             const Side *side = sideBnd->side;
 2657: 
 2658:             // Integral I_3
 2659:             if (sideSegment->ifltype != 0) {
 2660:             // Natural or Flather b.c.
 2661: 
 2662:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 2663:                // especially for Flather b.c.
 2664:                double ri3 = 0.0;
 2665:                if (!side->isDry) {
 2666:                   // If the side is not dry
 2667:                   
 2668:                   // Computes the side flux of (uth, vth)
 2669:                   double Vn = 0.0;
 2670:                   for (int k = side->kb; k<nvrt-1; k++) {
 2671:                      // uth, vth in lat/lon frame if ics=2
 2672:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 2673:                      const double vn1 = dot(side->uth[k  ], side->n); // outer normal
 2674:                      const double vn2 = dot(side->uth[k+1], side->n);
 2675: 
 2676:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 2677:                   }
 2678: 
 2679:                   ri3 = 0.5*side->length*Vn;
 2680:                }
 2681: 
 2682:                if (sideSegment->ifltype == -1) { // Flather 1
 2683: 
 2684:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 2685:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 2686: 
 2687:                   const double con0 = (1.0/6.0)*side->length*sqrt(grav*side->depth()); // For coefficient matrix
 2688:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 2689:                   
 2690:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 2691:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 2692: 
 2693:                } 
 2694:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 2695:                   // Reset ri3
 2696:                   ri3 = 0.0;
 2697: 
 2698:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 2699: 
 2700:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 2701: 
 2702:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 2703:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 2704: 
 2705:                   const double con0 = (1.0/6.0)*side->length*tmp*thetai*dt;
 2706:                   node1->addToSparseMatrix(node1, con0*2.0);
 2707:                   node1->addToSparseMatrix(node2, con0);
 2708: 
 2709:                } // if Flather or Discharge
 2710: 
 2711:                node1->qel -= thetai*dt*ri3;
 2712: 
 2713:             } // I_3
 2714:           
 2715: 
 2716:             // Integral I_5
 2717:             if(!side->isDry) {
 2718: 
 2719:                const double Unbar = dot(side->U, side->n);
 2720: 
 2721:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->length*Unbar;
 2722:                
 2723:             } // I_5
 2724: 
 2725:          } // if is boundary side
 2726: 
 2727:       } // for l
 2728: 
 2729:    } // if isbnd
 2730: 
 2731: }
 2732: 
 2733: 
 2734: extern "C" {
 2735:    __global__ void backtrackAllNodes(void) {
 2736: 
 2737:       // max/min # of sub-divisions
 2738:       const int ndelt_max = max(1.0, dt/dtb_min);
 2739:       const int ndelt_min = max(1.0, dt/dtb_max); 
 2740: 
 2741:       // Removed all references to swild98 XXX
 2742:       // swild98=0.d0 !init
 2743: 
 2744:       SIDE(side);
 2745: 
 2746:       const int kb = side->kb;
 2747: 
 2748:       // Initialize btrack velocities to the actual velocities at the side 
 2749:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 2750: 
 2751: 
 2752: 
 2753:       if (side->isDry) return;
 2754: 
 2755:       // Checks that at least one element is not dry
 2756:       const Element *elem1 = side->elems[0];
 2757:       const Element *elem2 = side->elems[1];
 2758: 
 2759:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 2760:       
 2761:       // XXXXXX
 2762:       // !swild_tmp to store global coord. of the starting side
 2763:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 2764:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 2765:       // !Use sframe2 
 2766:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 2767: 
 2768: 
 2769:       for (int k = kb; k < nvrt; k++) {
 2770:       //  Initialize (xt,yt,zt), nnel and vel.
 2771:       //  For ics=2, the coordinates are in local frames
 2772:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 2773: 
 2774: 
 2775:          const int iadvf = side->iadv();  // Advection flag
 2776: 
 2777:          Point3 xt;
 2778:          if constexpr(ics==1) {
 2779:             xt = side->center3D(k); 
 2780:          }
 2781:          else // lat/lon; in side lat/lon frame
 2782:          {
 2783:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 2784:          // XXX IMPLEMENT THIS
 2785:       //          xt=0.d0
 2786:       //          yt=0.d0
 2787:       //          !centroid coord. for nudging
 2788:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 2789:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 2790:          }  // ics
 2791: 
 2792: 
 2793:          // Velocity at the side (in ll frame for ics, same vertical direction)
 2794:          // XXX IS THIS NECESSARY?
 2795:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 2796: 
 2797:          // If on land or open boundary...
 2798:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 2799:          
 2800:          const double vmag = length(toVector2(u_int));
 2801: 
 2802:          if (vmag <= velmin_btrack) {
 2803:             // No activity 
 2804: 
 2805:             side->btu[k] = side->u2[k];
 2806:             
 2807:          } else {  // do btrack
 2808: 
 2809:           
 2810:             // Compute number of sub-divisions based on local gradients 
 2811:             // XXX IS THIS NECESSARY?
 2812:             double suma = 0.0;
 2813:             int icount = 0;
 2814:             for (int ii=0; ii<2; ii++) {
 2815: 
 2816:                const Element *elem = side->elems[ii];
 2817:                  
 2818:                if (elem == nullptr) continue;
 2819: 
 2820:                icount++;
 2821: 
 2822:                // Not strictly along z; in ll frame for ics=2
 2823: 
 2824:                double utmp[4];
 2825:                double vtmp[4];
 2826:                for (int jj = 0; jj < elem->i34; jj++) {
 2827: 
 2828:                   const Node *node = elem->nodes[jj];
 2829: 
 2830:                   if constexpr(ics==1) {
 2831:                      utmp[jj] = node->u2[k].x;
 2832:                      vtmp[jj] = node->u2[k].y;  
 2833:                   } else {
 2834:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 2835:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 2836:                   }
 2837:                } // for jj
 2838: 
 2839:                const Vector2 grad_u = elem->grad(utmp); 
 2840:                const Vector2 grad_v = elem->grad(vtmp);
 2841: 
 2842:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 2843:             } // for ii
 2844: 
 2845:             assert(icount > 0 && "Impossible 77");
 2846: 
 2847:             // '4' is somewhat arbitrary
 2848:             const int ndelt = max(ndelt_min, min(ndelt_max, int(suma/icount)*4)); // >=1
 2849:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 2850:          
 2851: 
 2852:             Vector3 u_int = {0.0, 0.0, 0.0};
 2853:             printf("XXbacktrackAllNodes: side->idx = %d, kb = %d, nvrt = %d\n", side->idx, kb, nvrt);
 2854:             side->btrack(k, dt, dtbk, u_int);
 2855: 
 2856:             printf("backtrackAllNodes: side->idx = %d, u_int = %f,%f\n", side->idx, u_int.x, u_int.y);
 2857: 
 2858:                
 2859:          } // if vmag (do backtrack)
 2860: 
 2861:       } // for j=jmin,nvrt-1
 2862: 
 2863:    }
 2864: } // extern "C"
 2865: 
 2866: template<int nc>
 2867: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 2868: 
 2869: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 2870: //
 2871: // a,b,c,r: input vectors and are not modified by this program.
 2872: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 2873: // r is the r.h.s.
 2874: // n: actual rank of the system.
 2875: // rows in u() and r();
 2876: // u: output with nc columns (transposed to rows)
 2877: // gam: a working array.
 2878: //
 2879: // NOTES:
 2880: // This is a template function that allows for different numbers of columns in the rhs vector.
 2881: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 2882: 
 2883:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 2884:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 2885: 
 2886:    double bet = b[0];
 2887:    if constexpr (nc == 1) {
 2888:       u[0] = rhs[0]/bet;
 2889:    } else {
 2890:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 2891:    }
 2892: 
 2893:    for (int j = 1; j < n; j++) {
 2894:       gam[j] = c[j-1]/bet;
 2895:       bet = b[j] - a[j]*gam[j];
 2896: 
 2897:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 2898: 
 2899:       if constexpr (nc == 1) {
 2900:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 2901:       } else {
 2902:          for (int k = 0; k < nc; k++) {
 2903:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 2904:          }
 2905:       }
 2906:    }
 2907: 
 2908:    // Back-substitution
 2909:    for (int j=n-1; j>=1; j--) {
 2910:       if constexpr (nc == 1) {
 2911:          u[j] = u[j] - gam[j+1]*u[j-1];
 2912:       } else {
 2913:          for (int k = 0; k < nc; k++) {
 2914:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 2915:          }
 2916:       }
 2917:    }
 2918: }
 2919: 
 2920: 
 2921: 
 2922: 
 2923: // Helper function that contains the core algorithm
 2924: template<typename XAccessor, typename YAccessor>
 2925: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 2926:                                     double  yp_top, double  yp_bot, 
 2927:                                     CubicSpline &spline) {
 2928:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 2929:    // 
 2930:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 2931:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 2932:    //
 2933:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 2934:    // 
 2935:    // Inputs: 
 2936:    //            n: dimension for x etc; # of data pts (>=2);
 2937:    //            getX, getY: functions to access x,y coordinates
 2938:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 2939:    //     Output: 
 2940:    //            spline (CubicSpline): spline structure with x,y,y',y''
 2941: 
 2942:    const int n = k2 - k1 + 1;
 2943:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 2944: 
 2945:    // Allocate memory for the splines
 2946:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 2947:    spline.x   = new double[n];
 2948:    spline.y   = new double[n];
 2949:    spline.yp  = new double[n];
 2950:    spline.ypp = new double[n];
 2951: 
 2952:    for (int k=k1; k<=k2; k++) {
 2953:       spline.x[k] = getX(k);
 2954:       spline.y[k] = getY(k);
 2955:    }
 2956: 
 2957:    // This is to simplify expressions later
 2958:    double *x = spline.x;
 2959:    double *y = spline.y;
 2960: 
 2961:    double *a = nullptr;
 2962:    double *b = nullptr;
 2963:    double *c = nullptr;
 2964:    double *gam = nullptr;
 2965:    double *rhs = nullptr;
 2966:    
 2967: 
 2968:       a = new double[n];   // Lower diagonal
 2969:       b = new double[n];   // Diagonal
 2970:       c = new double[n];   // Upper diagonal
 2971:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 2972:       rhs = new double[n]; // Right-hand side
 2973: 
 2974:    for (int k=k1; k<=k2; k++) {
 2975:       if (k == k1) {
 2976:          // Bottom level
 2977:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 2978:          b[k] = (x[k+1] - x[k])/3.0;
 2979:          c[k] = b[k]/2.0;
 2980:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 2981:       } else if (k == n - 1) {
 2982:          // Top level (surface)
 2983:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 2984:          b[k] = (x[k] - x[k-1])/3.0;
 2985:          a[k] = b[k]/2.0;
 2986:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 2987:       } else {
 2988:          // Intermediate levels
 2989:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 2990:          b[k] = (x[k+1] - x[k-1])/3.0;
 2991:          a[k] = (x[k  ] - x[k-1])/6.0;
 2992:          c[k] = (x[k+1] - x[k  ])/6.0;
 2993:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 2994:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 2995:       }
 2996:    }
 2997: 
 2998:    // Solve the tridiagonal system
 2999:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3000:    
 3001:    spline.yp[k1] = yp_bot;
 3002:    spline.yp[k2] = yp_top;
 3003: 
 3004:    // Compute rest of 1st derivatives using the splines
 3005:    for (int k=k1+1; k<k2; k++) {
 3006:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3007:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3008:    }
 3009:    
 3010:    delete[] a;
 3011:    delete[] b;
 3012:    delete[] c;
 3013:    delete[] gam;
 3014:    delete[] rhs;
 3015: 
 3016: }
 3017: 
 3018: // Array version
 3019: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3020:                                 double y_top, double y_bot, 
 3021:                                 CubicSpline &spline) {
 3022:    auto getX = [x] (int k) { return x[k]; };
 3023:    auto getY = [y] (int k) { return y[k]; };
 3024:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3025: }
 3026: 
 3027: // Lambda version - allows custom access patterns
 3028: template<typename XFunc, typename YFunc>
 3029: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3030:                                 double y_top, double y_bot,
 3031:                                 CubicSpline &spline) {
 3032:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3033: }
 3034: 
 3035: 
 3036: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 3037: {
 3038:    assert("Not implemented");
 3039: 
 3040:    return 0.0;
 3041: }
