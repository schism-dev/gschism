 1176:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1177:       // Compute the different time ramps used in the code 
 1178:       // This function is performed by just one thread
 1179: 
 1180:       if constexpr(ibc == 0) {
 1181:          if (drampbc > 0.0) {
 1182:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1183:          } else {
 1184:             rampbc = 1.0;
 1185:          }
 1186: 
 1187:          if (nws != 0 && drampwind > 0.0) {
 1188:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1189:          } else {
 1190:             rampwind = 1.0;
 1191:          }
 1192:       }
 1193: 
 1194:       if (drampwafo > 0.0) {
 1195:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1196:       } else {
 1197:          rampwafo = 1.0;
 1198:       }
 1199: 
 1200:       // For source/sinks
 1201:       if (if_source && dramp_ss > 0.0) {
 1202:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1203:       } else {
 1204:          ramp_ss = 1.0;
 1205:       }
 1206: 
 1207:       if (dramp > 0.0) {
 1208:          ramp = tanh(2.0*time/86400.0/dramp);
 1209:       } else {
 1210:          ramp = 1.0;
 1211:       }
 1212: 
 1213:       printf("computeTimeRamps: i = %d, nws = %d, if_source = %d, drampbc = %f, drampwind = %f, drampwafo = %f, dramp_ss = %f, dramp = %f\n", 
 1214:              threadIdx.x + blockIdx.x * blockDim.x, nws, if_source, drampbc, drampwind, drampwafo, dramp_ss, dramp);
 1215:    }
