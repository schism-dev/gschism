 1646: //       const double y4 = nodes[nxq(i+1)]->y;
 1647: 
 1648: //       const Side& side = sides[i];
 1649: 
 1650: //       xIntersect=-1.e25;
 1651: //       yIntersect=-1.e25;
 1652: 
 1653: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 1654: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 1655: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 1656: 
 1657: //       if (delta != 0.0) {
 1658: //          // Solves the two linear equations for tt1 and tt2
 1659: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
