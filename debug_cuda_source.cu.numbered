  763: struct Side {
  764: 
  765:    // Geometry information
  766:    int idx;               // Index of the side
  767:    Node *n1, *n2;
  768:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  769: 
  770:    double length;         // Length of the side. Used to be called distj; but I think this name is less clear now.
  771:    Vector2 center;        // Location of side center. 
  772:    double zc[nvrt];       // Side center z-coord at each vertical level
  773: 
  774:    Frame frame;
  775: 
  776:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  777:                           // this is nullptr
  778:    
  779:    int kb;                // Bottom index of the side
  780:    bool isDry;             // True if the side is dry
  781:  
  782:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  783: 
  784:    // Physical information
  785:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  786:    double  w2[nvrt];            // Vertical velocity at each vertical level
  787:    Vector2 btu[nvrt];           // Back-tracked velocity
  788:    Vector2 uth[nvrt];           // "Time history" velocity
  789:    Vector2 U;                   // Vertically averaged velocity vector  
  790: 
  791:    Vector2 d2uv[nvrt];          // divergence of (nu*grad u) XXX COMPUTE!!
  792: 
  793:    Vector2 bcc[nvrt];           // Baroclinic term
  794: 
  795:    double hhat;                 // \breve{H} in notes
  796: 
  797:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
  798: 
  799:    double coriolis;             // Coriolis parameter
  800: 
  801:    // Vegetation parameters
  802:    double veg_c2;
  803:    double veg_beta;
  804: 
  805:    // Bottom drag parameters.
  806:    double chi;
  807:    double chi2;
  808: 
  809:    __inline__ __device__ double x(double t) const;
  810:    __inline__ __device__ double y(double t) const;
  811:    __inline__ __device__ Point2 p_t(double t) const;
  812: 
  813:    __inline__ __device__ Point3 center3D(int k) const { return {center.x, center.y, zc[k]}; }
  814:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
  815:    __inline__ __device__ double Dz(int k)       const { return zc[k] - zc[k-1]; }
  816: 
  817:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
  818: 
  819:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
  820: 
  821:    __inline__ __device__ int iadv(void) const;
  822: 
  823:    __inline__ __device__ double eta2(void) const;
  824:    __inline__ __device__ double depth(void) const;
  825:    __inline__ __device__ double htot(void) const { return eta2() + depth(); }
  826: 
  827:    __inline__ __device__ double veg_h(void)  const;
  828:    __inline__ __device__ double veg_nv(void) const;
  829:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
  830:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
  831: 
  832:    __inline__ __device__ double Cd(void) const;
  833: 
  834:    __inline__ __device__ Vector2 tau(void) const;
  835: 
  836:    __inline__ __device__ double zb(void) const { return zc[kb]; }
  837:    
  838: 
  839:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
  840:    __inline__ __device__ double zLevelVegRatio(int k) const { 
  841:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
  842:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
  843:    } 
  844:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
  845:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot(); }
  846:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 1; }
  847:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 1; }
  848: 
  849:    // Get valid starting element (for backtracking)
  850:    __inline__ __device__ Element* getStartElement() {
  851:       return elems[0] ? elems[0] : elems[1];
  852:    }
  853: 
  854:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
  855:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
  856: 
  857:       // If one of the elements is null, return the other one
  858:       if      (elems[0] == nullptr) return elems[1];
  859:       else if (elems[1] == nullptr) return elems[0];
  860: 
  861: 
  862:       // Dot product of the negative velocity vector with the side normal vector
  863:       const double dot_prod1 = -dot(u, n);
  864:       
  865:       // Vector from side center to element 0 centroid
  866:       const Vector2 v2 = toVector2(elems[0]->center) - center;
  867: 
  868:       // Dot product of the vector with the side normal vector
  869:       const double dot_prod2 = dot(v2, n);
  870: 
  871:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
  872:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
  873: 
  874:       if (dot_prod1*dot_prod2 > 0.0) return elems[0];
  875:       else                           return elems[1];
  876: 
  877:  
  878:    }
  879: 
  880:    __forceinline__ __device__ Element* otherElem(const Element* elem) {
  881:       // Given an element, returns the other element that shares this side
  882:       return (elems[0] == elem) ? elems[1] : elems[0];
  883:    }
  884: 
  885:    __forceinline__ __device__ Node* otherNode(Node* node) {
  886:       // Given a node, returns the other node that shares this side
  887:       return (n1 == node) ? n2 : n1;
  888:    }
  889:  
  890:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
  891: 
  892: 
  893: 
  894: 
  895: };
  896: 
  897: 
  898: // This struct is used to store the boundary information for a node.
  899: struct NodeBoundary {   
  900:    BoundarySegment *segment;
  901:    Node *node;
  902:    
  903:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
  904:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
  905: 
  906:    double etaic;  // Elevation at nodes used for essential boundary conditions
  907:    double elbc;   // Elevation boundary condition
  908:    int iettype;   // Type of elevation boundary condition
  909:    double eth;    // Elevation time history
  910: 
  911:    bool isEssentialBC;
  912:    double bcValue;
  913: 
  914:    // Arrays for harmonic constituents (if needed)
  915:    double emo[nbfr];  // Elevation amplitude
  916:    double efa[nbfr];  // Elevation phase
  917:    double umo[nbfr];  // U-velocity amplitude
  918:    double ufa[nbfr];  // U-velocity phase
  919:    double vmo[nbfr];  // V-velocity amplitude
  920:    double vfa[nbfr];  // V-velocity phase 
  921: 
  922:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
  923:       assert(index == 0 || index == 1); 
  924:       return (index == 0) ? sideBnd1 : sideBnd2; 
  925:    }
  926: 
  927: 
  928: };
