    9: constexpr int imm = 0;         // Option to pre-compute vnorm on the element
   10: constexpr int iveg = 0;        // Vegetation option, 0: no vegetation, 1: vegetation
   11: constexpr int ihhat = 1;       // Option to limit \hat{H} to enhance stability for large friction in shallow area
