 1081: // Helper functions for computing the local node index at a given offset from another.
 1082: __device__ __inline__ int nxq(int offset, int index, int size) {
 1083:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1084:    // to the index to make it positive
 1085:    assert(index + offset + 16*size >= 0);
 1086:    return (index + offset + 16*size) % size;  
 1087: }
 1088: 
 1089: __device__ __inline__ int nxq(int index, int size) {
 1090:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1091:    // to the index to make it positive
 1092:    assert(index + 16*size >= 0);
 1093:    return (index + 16*size) % size; 
 1094: }
