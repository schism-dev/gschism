 1901: 
 1902: __host__ __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 1903: 
 1904: __device__ double Node::compZCoord(int k) const {
 1905:    // Computes the z coordinate at level k.
 1906:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 1907:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 1908:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 1909:    // used 
 1910:    
 1911:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 1912:       
 1913:    if (idry) {
 1914:       return 0.0;
 1915:    }
 1916: 
 1917:    if constexpr(ivcor == 2) {
 1918: 
 1919:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 1920:       const int kz = mesh->kz;
 1921: 
 1922:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 1923:       // The FORTAN code computes it every time this function is called, but it should be done only 
 1924:       // once per time step/node.
 1925:       // CHECK: updateZCoordData
 1926:       if (k == kz)               return -hmod2;
 1927:       else if (k == nvrt-1)      return eta2;
 1928:       else if (k == kb)          return -depth;
 1929:       else if (k < kz && k >= 0) return mesh->ztot[k];
 1930:       else if (k > kz) {
 1931:          const int ksig = k - kz + 1;
 1932: 
 1933:          if (hmod2 <= mesh->h_c) {
 1934:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 1935:          } 
 1936:          else if (eta2 <= - mesh->h_c - (depth - mesh->h_c) * mesh->theta_f/mesh->sinh_theta_f) {
 1937:             printf("Please choose larger h_c: %f %f\n", eta2, mesh->h_c);
 1938:             Error("ZCOOR: invalid h_c\n");
 1939:          } 
 1940:          else {
 1941:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 1942:                          mesh->h_c * mesh->sigma[ksig] + 
 1943:                          (hmod2 - mesh->h_c) * mesh->cs[ksig];
 1944:          }
 1945:       } else { 
 1946:          Error("ZCOOR: invalid level or coordinate system\n");
 1947:       }
 1948: 
 1949:    }
 1950:    else if constexpr(ivcor == 1) {
 1951:       if (k == kb) return -depth;
 1952:       else if (k == nvrt-1) return eta2;
 1953:       else if (k >= kb) {
 1954:             return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 1955:       }
 1956:    }
 1957:    
 1958:    printf("ZCOOR: invalid level or coordinate system\n");
 1959:    return 0.0;
 1960: }
