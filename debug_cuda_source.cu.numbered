 5045: __global__ void printMatrix(void) {
 5046: 
 5047: 
 5048:    // Let only one thread per block print at a time 
 5049: 
 5050:    if (threadIdx.x == 0) {
 5051:       for (int ithread = 0; ithread < blockDim.x; ithread++) {
 5052:          const int idx_node = ithread + blockIdx.x * blockDim.x;
 5053:          if (idx_node >= mesh->np) return;
 5054:          const Node *node = mesh->localNodeData + idx_node;
 5055:          printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 5056:          for (int j = 0; j < node->numNodes; j++) {
 5057:             Node* nbNode = node->nodes[j];
 5058:             if (node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 5059:          }
 5060:          printf("]\n");
 5061: 
 5062:       }
 5063:    }
 5064: 
 5065: 
 5066: 
 5067: }
