  914: class Mesh {
  915:    public:  
  916: 
  917:    int partNum; // Partition number for this mesh.
  918: 
  919:    // Pointers to each GPU's local memory (size is the number of partitions).
  920:    const Node**    nodes;  
  921:    const Element** elems;  
  922:    const Side**    sides;  
  923:    
  924:    // Local memory
  925:    Node*    localNodeData; 
  926:    Element* localElemData;
  927:    Side*    localSideData; 
  928: 
  929:    NodeBoundary *localNodeBoundaryMem; // Array of objects with the boundary information of each node
  930:    SideBoundary *localSideBoundaryMem; // Array of objects with the boundary information of each side
  931:    BoundarySegment *localSegmentMem;   // Array of objects with the boundary segments
  932:    
  933:    const int npgb;  // Global number of horizontal nodes
  934:    const int negb;  // Global number of elements
  935:    const int nsgb;  // Global number of sides
  936: 
  937:    const int np;   // Local number of horizontal nodes 
  938:    const int ne;   // Local number of elements
  939:    const int ns;   // Local number of sides
  940: 
  941:    const int max_np; // Maximum number of horizontal nodes per partition (shared by all partitions)
  942:    const int max_ne; // Maximum number of elements per partition (shared by all partitions)
  943:    const int max_ns; // Maximum number of sides per partition (shared by all partitions)
  944: 
  945:   
  946:    // Additional topology information
  947:    Node    **nodeNeighNodes; // Array of pointers to the nodes neighbors of each node
  948:    Element **nodeNeighElems; // Array of pointers to the elements neighbors of each node
  949: 
  950: 
  951: 
  952:    // Vertical coordinate system
  953:    // Sigma levels
  954:    double h_s; 
  955:    double h_c; 
  956:    int    kz;
  957:    double theta_b;
  958:    double theta_f, sinh_theta_f;
  959:    double *sigma_lcl;
  960:    double *sigma;
  961:    double *ztot;
  962:    double *cs;
  963:    double *dcs;
  964: 
  965:    // // Get's the pointer to the node using the array of global pointers to nodes
  966:    // __device__ const Node *getGlobalNode(int jn) {
  967:    //    const int idx = jn / max_np; // Get the index of the partition that contains the node
  968:    //    return nodes[idx] + idx;
  969:    // }
  970: 
  971:    // // Get's the pointer to the element using the array of global pointers to elements
  972:    // __device__ const Element *getGlobalElem(int je) {
  973:    //    const int idx = je / max_ne; // Get the index of the partition that contains the element
  974:    //    return elems[idx] + idx;
  975:    // }
  976: 
  977:    // // Get's the pointer to the side using the array of global pointers to sides
  978:    // __device__ const Side *getGlobalSide(int js) {
  979:    //    const int idx = js / max_ns; // Get the index of the partition that contains the side
  980:    //    return sides[idx] + idx;
  981:    // }
  982: 
  983:    // // Get's the global index of local node idx
  984:    // __device__ int getGlobalNodeIndex(int idx) {
  985:    //    return idx + partNum * max_np;
  986:    // }
  987: 
  988:    // // Get's the global index of local element idx
  989:    // __device__ int getGlobalElemIndex(int idx) {
  990:    //    return idx + partNum * max_ne;
  991:    // }
  992: 
  993:    // // Get's the global index of local side idx
  994:    // __device__ int getGlobalSideIndex(int idx) {
  995:    //    return idx + partNum * max_ns;
  996:    // }  
  997: 
  998:    __device__ Mesh(int partNum,
  999:                    int npgb, int negb, int nsgb, 
 1000:                    int np, int ne, int ns, int nvrt, int kz,
 1001:                    int max_np, int max_ne, int max_ns, int nseg,
 1002:                    const Node **nodesPtr, const Element **elemsPtr, const Side **sidesPtr,
 1003:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 1004:                    Node    **localNodeNeighNodesMem,
 1005:                    Element **localNodeNeighElemsMem,
 1006:                    NodeBoundary *localNodeBoundaryMem,
 1007:                    SideBoundary *localSideBoundaryMem,
 1008:                    BoundarySegment *localSegmentMem,
 1009:                    double h_s, double theta_b, double theta_f, double *sigma_lcl, double *sigma, double *ztot,
 1010:                    double *cs, double *dcs
 1011:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 1012:                        np(np), ne(ne), ns(ns),
 1013:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
 1014:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
 1015:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
 1016:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
 1017:                        localNodeBoundaryMem(localNodeBoundaryMem), localSideBoundaryMem(localSideBoundaryMem),
 1018:                        localSegmentMem(localSegmentMem),
 1019:                        h_s(h_s), theta_b(theta_b), theta_f(theta_f), sigma_lcl(sigma_lcl), sigma(sigma), ztot(ztot),
 1020:                        cs(cs), dcs(dcs)
