 3673:    __global__ void computeVerticallyIntegratedVelocity(void) {
 3674: 
 3675:       SIDE(side);
 3676: 
 3677: 
 3678:       side->U = {0.0, 0.0}; 
 3679:          
 3680:       if(side->isDry) return;
 3681: 
 3682:       const Node *node1 = side->n1;
 3683:       const Node *node2 = side->n2;
 3684: 
 3685:       // Vertically integrated velocity U (in ll if ics=2)
 3686:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 3687:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 3688:       }
 3689: 
 3690:    }
 3691: 
 3692:    __global__ void computeBottomDragVegetation(void) {
 3693:       // UNFINISHED. CHECK THIS:
 3694:       // How many kernels are needed? Why so many for loops?
 3695:       // Is the loop on sides needed?
 3696: 
 3697:       NODE(node);
 3698: 
 3699:       const int    kb      = node->kb;
 3700:       const double htot    = node->htot2();
 3701:       const double rough   = node->rough;
 3702: 
 3703: 
 3704:       if (node->isDry) {
 3705:          // Default values for dry nodes
 3706:          node->veg_alpha_vert_mean = node->veg_alpha0;
 3707:          /// XXX CHECK INDICES
 3708:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 3709:       }
 3710: 
 3711:       // Compute bottom drag Cd
 3712:       //--------------------------------
 3713: 
 3714:       // nchi = {-1, 0, 1} is the type of bottom drag.
 3715:       if (nchi==1) {
 3716: 
 3717:          bool ltmp = false; // for WBL iteration
 3718: 
 3719:          // Cdmax=-1 !max. Cd at node for this process (info only)
 3720:          // Drag at nodes
 3721:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 3722:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 3723:         
 3724:          const double rough = node->rough;
 3725:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3726:          if (node->rough == 0.0) {
 3727:             node->Cd = 0.0;
 3728: 
 3729:          } else { //roughness >0 
 3730:             
 3731:             const double bthick_ori = node->znl[kb + 1] - node->znl[kb];  // thickness of bottom bnd layer
 3732:             const double bthick = max(dzb_min, bthick_ori);
 3733: 
 3734:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 3735: 
 3736:             double tmp = 1.0/(2.5*log(bthick/rough));
 3737:             node->Cd = tmp*tmp;
 3738: 
 3739:          } // if rough
 3740: 
 3741: 
 3742:          // RECOVER THIS: XXX
 3743:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 3744:          // Output warning for WBL if iteration didn't converge
 3745: 
 3746: 
 3747:       } // nchi==1
 3748: 
 3749:       //   Bottom stress in m^2/s^2
 3750:       if (node->rho[kb + 1] >= -98.0)
 3751:       {
 3752:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 3753:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 3754:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 3755:          // !sediment erosion: this part needs more documentation
 3756:       }
 3757: 
 3758:     
 3759:       // Compute vegetation parameters
 3760:       //--------------------------------
 3761: 
 3762:       // SAV constants
 3763:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 3764:       constexpr double veg_cfpsi = 0.16;
 3765: 
 3766:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 3767:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 3768: 
 3769:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 3770:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 3771:          int kbin = 0; // bin index
 3772:          for (int k = kb; k < nvrt; k++) {
 3773:             // Computes node height above the bottom level
 3774:             const double tmp_h = node->znl[k] - node->znl[kb]; // >=0
 3775:             assert(false && "Vertical variation of vegetation not implemented");
 3776: 
 3777:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 3778:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 3779:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 3780:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 3781:             // } else {
 3782:             //    // Find the bin at which the current vertical level is
 3783:             //    while (kbin<nbins_veg_vert) {
 3784:             //       const double zn = node->znl[kbin];
 3785:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 3786:             //          break;
 3787:             //       } // if
 3788:             //       kbin++;
 3789:             //    } // while
 3790:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 3791: 
 3792:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 3793:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 3794:                
 3795:             //    // Linear interpolation of the vegetation parameters
 3796:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 3797:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 3798:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 3799:             // } // if rl10
 3800: 
 3801:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 3802: 
 3803:          } // for k
 3804: 
 3805: 
 3806:       } else { // Ganthy (iveg=2)
 3807:       //  Modify canopy height, diameter, and density
 3808: 
 3809:          // Make sure there is vegetation on this node
 3810:          if (node->veg_h_unbent > 0.0) {
 3811:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 3812: 
 3813:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 3814:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 3815:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 3816: 
 3817:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 3818:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 3819:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 3820:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 3821:          } // if veg_h_unbent
 3822: 
 3823:          for (int k = 0; k < nvrt; k++) {
 3824:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 3825:          } // for k
 3826:       
 3827: 
 3828:       } // if iveg
 3829:      
 3830:          
 3831: 
 3832:       // Compute vertical mean of veg_alpha3D
 3833:       if (iveg != 0) {
 3834:          const double ztop = node->zTopCanopy(); // Top of the canopy
 3835:          double sum1=0.0;
 3836:          double sum2=0.0;
 3837:          // Integrate over each level under the canopy...
 3838:          for (int k=kb; k<nvrt-1 && node->znl[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 3839:             const double Dz = node->Dz(k);
 3840: 
 3841:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 3842:             sum2 += Dz;
 3843: 
 3844:          } // for k
 3845: 
 3846:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 3847:          else             node->veg_alpha_vert_mean = sum1/sum2;
 3848: 
 3849:       } // if iveg
 3850: 
 3851:       printf("computeBottomDragVegetation: nodeIdx = %d, node->veg_alpha_vert_mean = %f\n", node->idx, node->veg_alpha_vert_mean);
 3852: 
 3853:    }
 3854: 
 3855:    __global__ void computeVegetationAndDragParameters(void) {
 3856:       // Computes the vegetation and drag model parameters:
 3857:       // chi, \tilde\chi, beta, \breve{H}
 3858:       
 3859:       SIDE(side);
 3860: 
 3861:       const double htot = side->htot2();
 3862:       const int    kb   = side->kb;
 3863: 
 3864:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 3865: 
 3866:       const double veg_h     = side->veg_h();
 3867:       const double veg_nv    = side->veg_nv();
 3868:       const double veg_c     = side->veg_c();
 3869:       const double veg_beta  = side->veg_beta;
 3870:       const double veg_alpha = side->veg_alpha_vert_mean();
 3871: 
 3872:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 3873:       // Velocity magnitude at the bottom level
 3874:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 3875:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 3876:       side->chi2 = side->Cd()*vmag1;
 3877:       side->chi  = side->chi2;
 3878:       if constexpr(iveg != 0) {
 3879:          const Node *n1 = side->n1;
 3880:          const Node *n2 = side->n2;
 3881:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 3882:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 3883:       }
 3884: 
 3885:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 3886: 
 3887:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 3888:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 3889:       double magUa = 0.0;
 3890:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 3891:          // 3D wet side with veg...
 3892: 
 3893:          double magUa = 0.0;
 3894:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 3895:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 3896: 
 3897:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 3898:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 3899:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 3900: 
 3901:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 3902:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 3903: 
 3904:                // Velocity magnitude at the bottom (l) of the level
 3905:                const double ul = length(side->u2[k]);
 3906: 
 3907:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 3908:                magUa += Dz*0.5*(uh + ul);
 3909: 
 3910:             } // if HasVegetation
 3911:          } // for k
 3912:          const double ua = magUa/min(htot, veg_h); // Vertical average
 3913: 
 3914:          // Computes beta, used for computing the stress term at the top of the canopy.      
 3915:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 3916:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 3917:             const double zCpy = side->zTopCanopy();
 3918:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 3919:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 3920:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 3921:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 3922:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 3923:          } // if isSubmerged
 3924:       } // if iveg   
 3925: 
 3926:       // Computes the friction modified depth, \breve{H} in notes
 3927:       if (side->is2D()) { // 2D
 3928: 
 3929:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 3930:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 3931: 
 3932:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 3933: 
 3934:          side->hhat = htot*htot/fricH; 
 3935: 
 3936:       } else { // 3D
 3937:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 3938: 
 3939:          if constexpr(iveg != 0) {
 3940:             
 3941:             if (side->isSubmerged()) { 
 3942:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 3943:                side->hhat -= veg_c*Hhat_alpha;
 3944: 
 3945:             } else { // Emergent
 3946:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 3947:             }
 3948:          } // if iveg
 3949: 
 3950:          // Enforce positivity for 3D model
 3951:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 3952:       } // if 3D
 3953: 
 3954:       printf("computeVegetationAndDragParameters: sideIdx = %d, side->htot = %f, side->hhat = %f\n", side->idx, side->htot2(), side->hhat);
 3955: 
 3956:         
 3957:    }
 3958: 
 3959: 
 3960: 
 3961:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 3962:    // Computes the density gradient between two elements, e1 and e2.
 3963:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 3964:    // zero in the direction normal to the side. 
 3965:    // 
 3966:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 3967:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 3968:    //
 3969:    // Input:
 3970:    //    e1: Element
 3971:    //    e2: Neighbor element (or nullptr if boundary)
 3972:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 3973:    //    k: Index of the half-level at which the density is interpolated
 3974:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 3975:    // 
 3976:    // Output:
 3977:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 3978:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 3979: 
 3980:       if (e2 == nullptr || e2->isDry) {
 3981:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 3982: 
 3983:          Side *side = e1->sides[j];
 3984:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 3985:                  
 3986:          if constexpr(ics == 1) {
 3987:             vec = side->n; // Normal vector to the side
 3988:          } else {
 3989:             // IMPLEMENT THIS XXXXXX
 3990:             // !replace with xel, yel?
 3991:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 3992:             //      &eframe(:,:,i),xn1,yn1,tmp)
 3993:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 3994:             //      &eframe(:,:,i),xn2,yn2,tmp)
 3995:          } //ics
 3996:                    
 3997:          diffRho = 0.0;
 3998: 
 3999:       } else { //internal and wet
 4000:          if constexpr(ics==1) {
 4001:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4002: 
 4003:             // Vector from e1 to e2
 4004:             vec = toVector2(e2->center - e1->center);
 4005: 
 4006:          } else { 
 4007:             // IMPLEMENT THIS XXXXXX
 4008:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4009:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4010:             //                   alow(j)=xctr2
 4011:             //                   bdia(j)=yctr2
 4012:          } // ics
 4013: 
 4014:          diffRho = rho2 - e1->demeanedDensity(k);
 4015:       }
 4016: 
 4017:    }
 4018: 
 4019:    __global__ void computeDensityCubicSplines(void) {
 4020:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4021: 
 4022:       ELEM(elem);
 4023: 
 4024:       if (elem->isDry) return;
 4025: 
 4026:       const int kb = elem->kb;
 4027: 
 4028:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4029:       if (elem->is2D()) {
 4030:          // In the 2D case, the density is constant at the prism level. 
 4031:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4032:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4033:       } else { //3D
 4034: 
 4035:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4036:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4037:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4038:          ///// XXXX CHECK INDICES!!!!!
 4039:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4040:       } // 2D/3D
 4041: 
 4042:    }
 4043: } // extern "C"
 4044: 
 4045: 
 4046: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4047: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4048: 
 4049:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4050: 
 4051:    const int kb  = elem->kb;
 4052:    const int kb2 = elem2->kb;
 4053: 
 4054:    // z-coordinate of prism of elem
 4055:    const double zp = elem->z_prism(k);
 4056: 
 4057:    double rho = 0.0;
 4058: 
 4059:    if (elem2->is2D()) {
 4060:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4061: 
 4062:    } else {  // 3D
 4063: 
 4064:       // eta_min may be < zmax
 4065:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4066:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4067: 
 4068:       // (Extrapolate density below bottom, we will fix it later)
 4069:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4070:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4071:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4072:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4073:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4074:    } // 2D/3D
 4075:      
 4076: 
 4077:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4078:    // Now we need to fix it.
 4079:    if (elem->z[k] < elem2->z[kb2]) {
 4080:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4081: 
 4082:       // There are two methods to adjust the density at the bottom of the element.
 4083:       // iunder_deep=0: 
 4084:       const double depth1 = abs(elem->z[kb]); // larger depth
 4085: 
 4086:       if (iunder_deep==0) {
 4087: 
 4088:          const double weight = max(0.0, min(1.0, (depth1 - h1_bcc)/(h2_bcc - h1_bcc))); // weight
 4089: 
 4090:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4091: 
 4092:       } else { // iunder_deep != 0
 4093: 
 4094:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4095: 
 4096:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4097: 
 4098:          //   Demeaned density at the same z coordinate as
 4099:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4100:          }
 4101: 
 4102:       } // if iunder_deep
 4103:    } // if elem->z[kb] < elem2->z[kb]
 4104: 
 4105:    return rho;
 4106: }
 4107: 
 4108: 
 4109: extern "C" {
 4110:    __global__ void computeDensityGradient(void) {
 4111: 
 4112:          // Compute the horizontal density gradient at each element.
 4113:       // It works in two steps:
 4114:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4115:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4116:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4117:       //             gradRho.r1 = rho1 - rho0
 4118:       //             gradRho.r2 = rho2 - rho0
 4119:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4120:       // 
 4121:       //  NOTE: We use de-meaned densities.
 4122: 
 4123:       ELEM(elem);
 4124: 
 4125:       if (elem->isDry) return;
 4126: 
 4127:       const int kb  = elem->kb;
 4128:       const int i34 = elem->i34;
 4129: 
 4130:       for (int k = kb + 1; k < nvrt; k++) {
 4131:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 4132:          //             gradRho.r1 = rho1 - rho0
 4133:          //             gradRho.r2 = rho2 - rho0
 4134:          int icount = 0;
 4135:          double sumRx = 0.0;
 4136:          double sumRy = 0.0;
 4137:          for (int j1=0; j1<i34; j1++) { 
 4138: 
 4139:             const int j2 = elem->nxq(j1 + 1);
 4140: 
 4141:             // Pairs of consecutive neighbor elements of elem
 4142:             const Element *e1 = elem->nghbElems[j1];
 4143:             const Element *e2 = elem->nghbElems[j2];
 4144: 
 4145:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 4146:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 4147:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 4148: 
 4149:             // Compute the density difference and the vector from elem to e1 and e2
 4150:             // getRhoDiffAndVec takes into account boundaries/dry elements
 4151:             double diffRho1, diffRho2;
 4152:             Vector2 vec1, vec2;
 4153:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 4154:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 4155: 
 4156:             const double rl1 = length(vec1);
 4157:             const double rl2 = length(vec2);
 4158:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 4159: 
 4160:             const double delta = cross(vec1, vec2);
 4161:             const double sintheta = abs(delta)/(rl1*rl2);
 4162: 
 4163:             // To avoid problems, avoid elements with small angle between vectors
 4164:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 4165:             const bool validEq = (sintheta > sin_one_deg);
 4166: 
 4167:             if (validEq) {
 4168:                // Solve the system of equations to get the density gradient at elem
 4169:                icount++;
 4170:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 4171:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 4172:                sumRx += Rx;
 4173:                sumRy += Ry;
 4174:             }
 4175:          } // for j1
 4176: 
 4177:          // Compute the average density gradient at elem
 4178:          if (icount==0) {
 4179:            // Bad mesh quality; bail out with 0 b-cc
 4180:            elem->gradRho[k] = {0.0, 0.0};
 4181:          } else {
 4182:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 4183:          }
 4184: 
 4185:       } // for k
 4186: 
 4187:    }
 4188: 
 4189:    __global__ void computeBaroclinicTerm(void) {
 4190:    // Computes the baroclinic term at sides (at half levels).
 4191:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 4192:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 4193: 
 4194:       SIDE(side);
 4195: 
 4196:       if (side->isDry) return;
 4197: 
 4198:       const Element *e1 = side->elems[0];
 4199:       const Element *e2 = side->elems[1];      
 4200:       const int kb = side->kb;
 4201:       
 4202:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 4203: 
 4204:       // interpolates vertically the density gradient of the two elements at the half level/
 4205: 
 4206:       // Starts the integration at the surface and goes down to the bottom
 4207:       int k1 = nvrt - 1;
 4208:       int k2 = nvrt - 1;
 4209: 
 4210:       side->bcc[nvrt-1] = {0.0, 0.0};
 4211:       for (int k = nvrt-1; k >= kb; k--) {
 4212:       // For each prism level (from surface to bottom)...
 4213: 
 4214:          // For both elements, interpolate density gradient at the side's half level.
 4215:          // The gradient at the side is the average of the gradients at the elements.
 4216:          // w1, w2 are used to take into account boundary sides, with just one element.
 4217:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 4218:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 4219:          const double wsum = w1 + w2;
 4220:          w1 = w1/wsum;
 4221:          w2 = w2/wsum;
 4222:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 4223: 
 4224:          // Linear interpolation of both elements' density gradient at the shared side's level.
 4225:          Vector2 gradRho = {0.0, 0.0};
 4226:          if (e1 != nullptr && k > kb) {
 4227:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 4228:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 4229:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 4230:             
 4231:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 4232:          }      
 4233:          if (e2 != nullptr && k > kb) {
 4234:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4235:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4236:             
 4237:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4238:          }
 4239: 
 4240:          if constexpr(ics==2) {
 4241:             // IMPLEMENT THIS XXXXXX
 4242:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4243:             // swild(1)=tmp1
 4244:             // swild(2)=tmp2
 4245:          }
 4246:          
 4247:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4248:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4249:          // CHECK INDICES!!! XXX
 4250:          const double grav3 = side->grav3();
 4251:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4252:       } // for
 4253: 
 4254:    }
 4255: 
 4256: 
 4257: 
 4258:    __global__ void computeHorGradientAtSide(void) {
 4259: 
 4260:       // Compute the horizontal density gradient at each element.
 4261:       // It works in two steps:
 4262:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4263:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4264:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4265:       //             gradRho.r1 = rho1 - rho0
 4266:       //             gradRho.r2 = rho2 - rho0
 4267:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4268:       // 
 4269:       //  NOTE: We use de-meaned densities.
 4270: 
 4271:       SIDE(side);
 4272: 
 4273:       if (side->isDry) return;
 4274: 
 4275:       // Computes the gradient of the variables at the side center.
 4276:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 4277:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 4278:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 4279: 
 4280:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 4281:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 4282:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 4283:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 4284: 
 4285: 
 4286:       printf("gradEta1: %e, %e, gradEta2: %e, %e, gradETP: %e, %e, gradPr: %e, %e\n", 
 4287:          side->gradEta1.x, side->gradEta1.y, 
 4288:          side->gradEta2.x, side->gradEta2.y, 
 4289:          side->gradETP.x, side->gradETP.y, 
 4290:          side->gradPr.x, side->gradPr.y);
 4291: 
 4292: 
 4293:    }
 4294: 
 4295: 
 4296:    __global__ void solveMomentumEquations(void) {
 4297: 
 4298:       SIDE(side);
 4299: 
 4300:       if (side->isDry) 
 4301:       {
 4302:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 4303: 
 4304:          return;
 4305:       }
 4306: 
 4307:       const int kb = side->kb;
 4308: 
 4309:       const double veg_h = side->veg_h();
 4310:       const double grav3 = side->grav3();
 4311: 
 4312:       if (side->is2D()) {
 4313:          // Warning: Do not use htot2, which is updated.
 4314:          const double htot = side->htot1();
 4315:          const double hhat = side->hhat;
 4316: 
 4317:          assert(hhat > 0.0 && htot > 0.0 && "Impossible dry 55:");
 4318: 
 4319:          Vector2 tau2 = {0.0, 0.0};
 4320:           
 4321:          if constexpr(ics==1) {
 4322:             tau2 = side->tau();
 4323: 
 4324:          } else {
 4325:             assert(false && "Not implemented: ics == 2");
 4326:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4327:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4328:             // taux2=(vn1+tt1)*0.5d0
 4329:             // tauy2=(vn2+ss1)*0.5d0
 4330:          } // if ics         
 4331: 
 4332:          // hat_gam has units of m/s
 4333: 
 4334:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 4335:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 4336:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 - thetai*side->gradEta2));
 4337: 
 4338:          hat_gam += dt*side->d2uv[nvrt-1];  // XXXX compute d2uv
 4339: 
 4340:          for (int k=0; k<nvrt; k++) {
 4341:             side->u2[k] = hat_gam*hhat/htot;
 4342: 
 4343:             // Limits the velocity components to their maximum values
 4344:             side->u2[k].x = max(-rmaxvel1, min(rmaxvel1, side->u2[k].x));
 4345:             side->u2[k].y = max(-rmaxvel2, min(rmaxvel2, side->u2[k].y));
 4346:          }
 4347: 
 4348:       }
 4349: 
 4350: 
 4351:    }
 4352: } // extern "C"
 4353: 
 4354: #ifdef DONTCOMPILE
 4355: __device__ void computeVerticalAdvection(void) {
 4356:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 4357: 
 4358:    sdbt(1:2,:,:)=0.d0
 4359: 
 4360:    const Side *side = FROM kernel;
 4361: 
 4362:    if(side->isDry) return;
 4363: 
 4364:    // If side is wet...
 4365: 
 4366: 
 4367:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 4368:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 4369:    double ws[nvrt] = {} // w @ side
 4370:    int icount = 0;
 4371:    for (int j=0; j<2; j++) {
 4372:       const Element *elem = side->elements[j];
 4373:        
 4374:       if(elem != nullptr) {
 4375:          icount++;
 4376:          for (int k=0; k<nvrt; k++) {
 4377:             ws[k] = ws[k] + elem->w[k];
 4378:          }
 4379:       }
 4380:    }  // for j
 4381: 
 4382:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 4383:    ws = ws/icount;
 4384: 
 4385:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 4386:    // Splines allow for a smooth transition between vertical levels.
 4387:    // Splines have continuity restrictions at the internal knots, but
 4388:    // we have to provide the 1st derivatives at the endpoints.
 4389:    const int kbs = side->kbs; 
 4390:    
 4391:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 4392:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 4393:    initCubicSpline(kbs, nvrt, side, ws, up)
 4394: 
 4395:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 4396:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 4397:    initCubicSpline(kbs, nvrt, side, ws, vp)
 4398: 
 4399:    // Total advection (average onto side)
 4400:    const Node *node1 = side->nodes[0];
 4401:    const Node *node2 = side->nodes[1];
 4402:    for (int k=kbs(i); k<nvrt; k++) {
 4403: 
 4404:       if constexpr(ics==1) {
 4405:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 4406:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 4407:       } else {
 4408:          // XXX IMPLEMENT THIS
 4409:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 4410:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 4411:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 4412:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 4413:       }  // if ics
 4414: 
 4415: 
 4416:    }
 4417: }
 4418: #endif
 4419: 
 4420: 
 4421: extern "C" {
 4422:    __global__ void computeElemAverageGhat(void) {
 4423:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 4424: 
 4425:       ELEM(elem);
 4426:       
 4427:       elem->ghat1= {0.0, 0.0};  
 4428: 
 4429:       if constexpr(ihydraulics != 0) {
 4430:          if (nhtblocks > 0 && elem->isblock) return;
 4431:       }
 4432: 
 4433:       if (elem->isDry) return;
 4434: 
 4435:       // Wet elements.
 4436:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 4437:       // tidal potential, horizontal diffusion, and baroclinic etc
 4438:       // Remember to update both fb and F 
 4439:       // If ics=2, ghat1 are in eframe (ll)
 4440:       // cff1-3: coefficients for 2D/3D
 4441:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 4442:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 4443:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 4444: 
 4445:       double av_cff1 = 0.0;  // av. for cff1
 4446:       double av_cff2 = 0.0;  // av. for cff2
 4447:       double av_cff3 = 0.0;  // av. for cff3
 4448:       double av_df = 0.0;  // av. for H^\alpha / H
 4449:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 4450:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 4451: 
 4452:       const int i34 = elem->i34;
 4453:       const int kb = elem->kb;
 4454: 
 4455:       for (int j=1; j<i34; j++) {
 4456:          // For each node and side in the element...
 4457: 
 4458:          const Node *node = elem->nodes[j];
 4459:          const Side *side = elem->sides[j];
 4460: 
 4461:          const double chi      = side->chi;
 4462:          const double veg_c2   = side->veg_c2;
 4463:          const double veg_beta = side->veg_beta;
 4464:          const double veg_h    = side->veg_h();
 4465:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 4466: 
 4467:          // Node - const in elem
 4468:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 4469:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 4470: 
 4471:          if (elem->depth >= tip_dp) {
 4472:            elem->gradETP += node->ETP*elem->gradPhi[j];
 4473:          }
 4474: 
 4475:          
 4476:          const double htot  = side->htot2();        // Total depth at the side
 4477:          const double zctr2 = side->zTopCanopy();  
 4478: 
 4479:          double cff1; 
 4480:          double cff2; 
 4481:          double cff3;   
 4482:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 4483:          // coefficients applied to 2D/3D case 
 4484:             cff1 = side->hhat/htot;
 4485:             cff2 = 0.0;
 4486:             cff3 = 0.0;
 4487:          } else { //3D
 4488:             //Init for no-veg case
 4489:             cff1 = 1.0;
 4490:             cff2 = 1.0;
 4491:             cff3 = 0.0;
 4492: 
 4493:             if constexpr(iveg != 0) {
 4494:                // Computes coefficients used with vegetation terms G1, G2
 4495:                // cff1, cff3 are used for the first two terms in G1, G2:
 4496:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 4497:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 4498:                // In general, cff1*Ustar - cff3*Ustar_alpha
 4499:                if(veg_h < 0.99*htot) { // submergent vegetation
 4500:                   cff1=1;
 4501:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 4502:                   cff3 = veg_c;
 4503: 
 4504:                } else { // emergent vegetation
 4505:                   cff1 = 1.0/(1.0 + veg_c2);
 4506:                   cff2 = cff1;
 4507:                   cff3 = 0.0;
 4508: 
 4509:                }
 4510:             } // if iveg
 4511:          } //  2D/3D
 4512: 
 4513:          av_cff1 += cff1/i34;
 4514:          av_cff2 += cff2/i34;
 4515:          av_cff3 += cff3/i34;
 4516:          av_cff2_chi += cff2*chi/i34;
 4517:          av_cff3_chi += cff3*chi/i34;
 4518:          av_df += min(htot, veg_h)/(htot*i34);
 4519: 
 4520: 
 4521:          // btrack values: U^\star, U^{\star\alpha}
 4522:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 4523:          Vector2 Ustar       = {0.0, 0.0}; 
 4524:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 4525: 
 4526:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 4527:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 4528:          } else { //3D
 4529:             for (int k = side->kb; k < nvrt; k++) {
 4530:             
 4531:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 4532:                Ustar += w2;
 4533: 
 4534:                if constexpr(iveg != 0) {
 4535:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 4536:                        const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k)); // For the top of the canopy, ratio of the level that is below the canopy
 4537:                        Ustar_alpha += zrat*w2; // XXXX
 4538:                    }
 4539:                }  // if iveg
 4540:             }  // for k
 4541:          }  //2D/3D
 4542:          
 4543: 
 4544:          // Add btrack & surface stress terms to \breve{G} first
 4545:          if constexpr(ics==1) {
 4546:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 4547:          } else {
 4548:             // XXX IMPLEMENT THIS
 4549:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 4550:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 4551:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 4552:          }  // if ics
 4553: 
 4554:          // Surface and bottom stress terms
 4555:          if constexpr(ics==1) {
 4556:             const Vector2 tau    = side->tau();
 4557:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 4558: 
 4559:             // Term for surface and bottom stress
 4560:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 4561:          } else {
 4562:             // XXX IMPLEMENT THIS
 4563:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 4564:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 4565:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 4566:             // tau_x=(vn1+tt1)/2.d0
 4567:             // tau_y=(vn2+ss1)/2.d0
 4568:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 4569:          }  // if ics
 4570: 
 4571:          
 4572: 
 4573:          // All terms in F,F^\alpha,f_b except baroclinic
 4574:          // F, f_b: all explicit terms excluding vegetation 
 4575:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 4576:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 4577:          const double coriolis = side->coriolis;
 4578:          Vector2 F  =  coriolis*side->U;  // F_x
 4579:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 4580:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 4581: 
 4582:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 4583:             
 4584:             for (int k = side->kb; k < nvrt; k++) {
 4585:                if (zctr2 > side->zc[k-1]) {
 4586:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 4587:                    const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 4588:                    Fa +=  coriolis*w2*zrat;
 4589:                } // if zctr2
 4590:             } // k
 4591:          } // iveg
 4592: 
 4593:          // Integrate horizontal viscosity force vertically
 4594:          for (int k=side->kb + 1; k<nvrt; k++) {
 4595:             const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.0; 
 4596: 
 4597:             F += levelHorVisc;
 4598: 
 4599:             // Vegetation term
 4600:             if constexpr(iveg!=0) {
 4601:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 4602:                   const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 4603:                   Fa += levelHorVisc*zrat;
 4604:                } 
 4605:             } // if iveg
 4606:          } // for k
 4607: 
 4608:          fb += side->d2uv[side->kb];
 4609: 
 4610: 
 4611:          // Add to ghat1
 4612:          if constexpr(ics==2) {
 4613:             // XXX IMPLEMENT THIS
 4614:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4615:             // bigf1=vn1; bigf2=vn2
 4616:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4617:             // botf1=vn1; botf2=vn2
 4618:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4619:             // bigfa1=vn1; bigfa2=vn2
 4620:          } // if ics
 4621: 
 4622:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 4623:       } // for j (nodes and sides)
 4624: 
 4625:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 4626:          
 4627:       // Finish off terms in F, F^\alpha and f_b
 4628:       const double grav3 = elem->mean(&Node::grav2);
 4629:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 4630: 
 4631: 
 4632:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 4633:       for (int j=1; j<i34; j++) { 
 4634:          // For each side in the element...
 4635:          const Side *side = elem->sides[j];
 4636:          const double chi = side->chi;
 4637: 
 4638:          const double htot = side->htot2();
 4639:          const double veg_h = side->veg_h();
 4640:          const Vector2 F  = htot*fb;
 4641:          const Vector2 Fa = min(htot, veg_h)*fb;
 4642: 
 4643:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 4644:       } // for j
 4645: printf("$$$ tmp = %.15g, %.15g\n", tmp.x, tmp.y);
 4646:       //botf1 etc are already in elem frame
 4647:       elem->ghat1 += tmp/i34;
 4648: 
 4649:       // Baroclinic force
 4650:       if constexpr(ibc==0) {
 4651:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 4652: 
 4653:          Vector2 Fa = {0.0, 0.0};
 4654:          Vector2 intGradRho = {0.0, 0.0};
 4655:          
 4656:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 4657:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 4658:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 4659: 
 4660:             // \in F [m^2/s/s]
 4661:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 4662:          }
 4663: 
 4664:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 4665:          const Vector2 F = av_df*Fa; //approx
 4666:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 4667: 
 4668:       } // if ibc
 4669: 
 4670: 
 4671: 
 4672:    }
 4673: 
 4674: } // extern "C"
 4675: 
 4676: 
 4677: 
 4678: #ifdef DONTCOMPILE
 4679: __global__ void checkMassConservation(Tracers* sumtr) {
 4680: 
 4681:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 4682: 
 4683:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 4684: 
 4685:    Element *elem = &(mesh->localElemData[i]);
 4686: 
 4687:    // Skip dry elements
 4688:    if (elem->isDry) return;
 4689: 
 4690:    // Local sum array for this thread
 4691:    double localSum[N_TRACERS] = {0.0};
 4692: 
 4693:    // Sum over vertical levels for this element
 4694:    const int kbe = elem->kbe;
 4695:    const double area = elem->area;
 4696: 
 4697:    for (int k = kbe; k < nvrt; k++) {
 4698:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 4699:       
 4700:       // Accumulate tracer mass
 4701:       for (int tr = 0; tr < N_TRACERS; tr++) {
 4702:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 4703:       }
 4704:    }
 4705: 
 4706:    
 4707: 
 4708:    //  This function returns per element sums. A reduction must be done on the host side.
 4709: }
 4710: 
 4711: 
 4712: __global__ void transport(void) {
 4713: 
 4714:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 4715: 
 4716:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 4717: 
 4718:    Element *elem = &(mesh->localElemData[ie]);
 4719: 
 4720:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 4721: 
 4722:                for (int m=0; m<ntr; m++) {
 4723:                   for (int k=kbe(ie); k<nvrt; k++) {
 4724:                      // Calculate each polynomial's weight 
 4725:                      wm=0.d0; sum1=0.d0; 
 4726:                      wm1=0.d0; wm2=0.d0; 
 4727:                      for (int i=0; i<elem->nweno2; i++) {
 4728:                   
 4729:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4730:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4731:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4732:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4733:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4734:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 4735:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 4736:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 4737:                      // -----------------Hu and Shu (1999)'s method----------------
 4738:                      b4=b1+b2+b3
 4739: 
 4740: //Error: add PRODUCTION CPP
 4741: #ifdef DEBUG
 4742:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 4743:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 4744:                     call parallel_abort(errmsg)
 4745:                   }
 4746: #endif
 4747: 
 4748:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 4749:                   // !----test-------------- 
 4750:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 4751:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 4752:                   // !wm(i)=wm1(i)*wm2(i)
 4753:                   // !---------------------- 
 4754:                   sum1=sum1+wm(i)
 4755:                 } // end for i
 4756: 
 4757:                 wm=wm/sum1
 4758: 
 4759:                 for (int j=0; j<elem->i34; j++) {
 4760: 
 4761:                   const Side *side  = elem->sides[j];
 4762:                   const Node *node1 = side->n1;
 4763:                   const Node *node2 = side->n2;
 4764: 
 4765:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 4766:                      trsd=0.d0
 4767:                      for (int kk=0; kk<nquad; kk++) {
 4768:                         for (int i=0; i<elem->nweno2; i++) {
 4769:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4770:                         } // end for i   
 4771:                      } // end for kk
 4772:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 4773:                   } // outward flux
 4774:                } // end for j=1,i34(ie) ! side
 4775:             }
 4776:          }
 4777:               
 4778: 
 4779: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 4780: //             //   calculate each polynomial's weight 
 4781: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 4782: //                 wm=0.d0; sum1=0.d0
 4783: //                 do i=1,nweno1(ie) !for each polynomial
 4784: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4785: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4786: //                   b1=b1*b1+b2*b2 !smoothness indicator
 4787: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 4788: //                   wm(i)=b2
 4789: //                   sum1=sum1+b2
 4790: //                   !wm(i)=1.d0
 4791: //                   !sum1=sum1+1.d0
 4792: 
 4793: // // Error: PRODUCTION
