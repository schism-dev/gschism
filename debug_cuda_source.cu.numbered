 3506:    __global__ void computeElevationBoundaryConditions(double time, int nbfr, double *amig, double *ff, double *emo, double *efa, double *face) {
 3507:       // Compute elevation essential boundary conditions 
 3508: 
 3509:       NODE_BND(nodeBnd); // Each boundary node.
 3510: 
 3511:       const Node *node = nodeBnd->node;
 3512:       const int iettype = nodeBnd->iettype;
 3513: 
 3514:       double eic = 0.0;
 3515:       if (nramp_elev==1) eic = nodeBnd->etaic;
 3516:       else               eic = 0.0;
 3517: 
 3518:       const double r_eic = (1.0 - ramp)*eic; 
 3519:       const double r_eth = ramp*nodeBnd->eth;
 3520:       double eta1_bar = r_eic;
 3521: 
 3522: printf("++++>> node[%d]->iettype = %d\n", node->idx, iettype);
 3523:       // Compute tide elevation
 3524:       if (iettype == 3 || iettype == 5) {   
 3525: 
 3526:          if constexpr(iloadtide==1) { // loading tide
 3527:             assert(false && "Loading tide not implemented");
 3528:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3529:          }
 3530:          
 3531:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 3532:             printf("++++>> jfr = %d\n", jfr);
 3533:             // const int ncyc = int(amig[jfr]*time/(2.0*pi));
 3534:             // const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa[i, j, jfr];
 3535:             // eta1_bar += ramp*ff[jfr]*emo[i,j,jfr]*cos(arg);
 3536:          } // for jfr
 3537: 
 3538:       } // if iettype
 3539: 
 3540:       switch (iettype) {
 3541:          case 1:
 3542:          case 2:
 3543:             nodeBnd->elbc = r_eth + r_eic;
 3544:             break;
 3545:          case 3:
 3546:             nodeBnd->elbc = eta1_bar + r_eic;
 3547:             break;
 3548:          case 4:
 3549:             nodeBnd->elbc = r_eth + r_eic;
 3550:             break;
 3551:          case 5:
 3552:             nodeBnd->elbc = r_eth + eta1_bar + r_eic;
 3553:             break;
 3554:       } // switch
 3555: 
 3556: 
 3557:       //Add inverse barometric effects
 3558:       if (iettype != 0 && inv_atm_bnd == 1) {
 3559:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 3560:       }
 3561: 
 3562:    }
 3563: 
 3564: 
 3565:    __global__ void setEssentialBC(void) {
 3566:       // Set essential boundary conditions 
 3567:       NODE(node); // Each boundary node
 3568:       NodeBoundary *nodeBnd = node->nodeBnd;
 3569: printf("node idx = %d, nodeBnd = %p, essentialBC = %d\n", node->idx, nodeBnd, nodeBnd ? nodeBnd->isEssentialBC : -1);
 3570:       
 3571: // nodeBnd->isEssentialBC = true;      
 3572:       // Check if this node has essential BC
 3573:       if (nodeBnd && nodeBnd->isEssentialBC) {
 3574:          // Verify BC value is valid
 3575:          assert(nodeBnd->bcValue >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 3576: 
 3577:          printf("XX node IDX = %d, nodeBnd->isEssentialBC = %d\n", node->idx, nodeBnd->isEssentialBC);
 3578:          
 3579:          // Set diagonal to 1 and zero off-diagonals
 3580:          node->coeffDiag = 1.0;
 3581:          printf("ZZZZZZZ node->coeffDiag = %16.9f\n", node->coeffDiag);
 3582: 
 3583:          for (int j = 0; j < node->numNodes; j++) {
 3584:                node->coeffMatrix[j] = 0.0;
 3585:                printf("YY node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 3586:          }
 3587:          
 3588:          // Set solution and RHS to BC value
 3589:          node->mX  = nodeBnd->bcValue;
 3590:          node->qel = nodeBnd->bcValue;
 3591: printf("{{{{ node->mX = %f, node->qel = %f\n", node->mX, node->qel);         
 3592:       } else {
 3593:          // Not an essential BC node
 3594:          // Modify RHS for neighbors with essential BCs
 3595:          for (int j = 0; j < node->numNodes; j++) {
 3596:                Node* nbNode = node->nodes[j];
 3597:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 3598:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 3599:                   // Verify neighbor's BC value
 3600:                   assert(nbNodeBnd->bcValue >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 3601: 
 3602:                   // Subtract contribution to RHS
 3603:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->bcValue;
 3604:                   node->coeffMatrix[j] = 0.0;  
 3605:                   printf("ZZ node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 3606:                }
 3607:          }
 3608:       }
 3609:    }
 3610: 
 3611: 
 3612:    __global__ void updateElevation(void) {
 3613:       NODE(node);
 3614: 
 3615:       node->eta2 = node->mX;
 3616: printf("node[%d]->eta2 = %f\n", node->idx, node->eta2);
 3617:    }
