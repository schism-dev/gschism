 3005:    __global__ void scaleGravity(double loadtide_coef) {
 3006: 
 3007:       printf("scaleGravity: i = %d, np = %d\n", threadIdx.x + blockIdx.x * blockDim.x,mesh->np);
 3008:       NODE(node);
 3009: 
 3010:       // SAL option: scale gravity
 3011:       if constexpr(iloadtide==2) {  // simple const
 3012:          node->grav2 = grav*(1.0 - loadtide_coef);
 3013: 
 3014:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3015:         
 3016:           const double depth = max(node->depth, 0.0);
 3017:           const double tmp1 = sqrt(depth);
 3018:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3019:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3020:                              2.6969e-13*depth*depth*depth*tmp1;
 3021:           
 3022:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3023:           
 3024: 
 3025: 
 3026:           node->grav2 = grav*(1.0 - beta_bar);
 3027: 
 3028:       } else {  // iloadtide=0,1
 3029:         node->grav2=grav;
 3030: 
 3031:       }
 3032: 
 3033:       printf("scaleGravity: node(%d)->grav2 = %f\n", node->idx, node->grav2);
 3034:    }
