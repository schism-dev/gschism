  620: 
  621: struct Side {
  622: 
  623:    // Geometry information
  624:    int idx;               // Index of the side
  625:    Node *n1, *n2;
  626:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  627: 
  628:    double length;         // Length of the side. Used to be called distj; but I think this name is less clear now.
  629:    Vector2 center;        // Location of side center. 
  630:    double zc[nvrt];       // Side center z-coord at each vertical level
  631:    double depth;          // Depth at side center
  632: 
  633:    Frame frame;
  634: 
  635:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  636:                           // this is nullptr
  637:    
  638:    int kb;                // Bottom index of the side
  639:    bool idry;             // True if the side is dry
  640:  
  641:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  642: 
  643:    // Physical information
  644:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  645:    double  w2[nvrt];            // Vertical velocity at each vertical level
  646:    Vector2 btu[nvrt];           // Back-tracked velocity
  647:    Vector2 uth[nvrt];           // "Time history" velocity
  648:    Vector2 U;                   // Vertically averaged velocity vector  
  649: 
  650:    Vector2 bcc[nvrt];           // Baroclinic term
  651: 
  652:    double hhat;                 // \breve{H} in notes
  653: 
  654:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
  655: 
  656:    double coriolis;             // Coriolis parameter
  657: 
  658:    // Vegetation parameters
  659:    double veg_c2;
  660:    double veg_beta;
  661: 
  662:    // Bottom drag parameters.
  663:    double chi;
  664:    double chi2;
  665: 
  666:    __inline__ __device__ double x(double t) const;
  667:    __inline__ __device__ double y(double t) const;
  668:    __inline__ __device__ Point2 p_t(double t) const;
  669: 
  670:    __inline__ __device__ Point3 center3D(int k) const { return {center.x, center.y, zc[k]}; }
  671:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
  672:    __inline__ __device__ double Dz(int k)       const { return zc[k] - zc[k-1]; }
  673: 
  674:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
  675: 
  676:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
  677: 
  678:    __inline__ __device__ int iadv(void) const;
  679: 
  680:    __inline__ __device__ double eta2(void) const;
  681:    __inline__ __device__ double htot(void) const { return eta2() + depth; }
  682: 
  683:    __inline__ __device__ double veg_h(void)  const;
  684:    __inline__ __device__ double veg_nv(void) const;
  685:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
  686:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
  687: 
  688:    __inline__ __device__ double Cd(void) const;
  689: 
  690:    __inline__ __device__ Vector2 tau(void) const;
  691: 
  692:    __inline__ __device__ double zb(void) const { return zc[kb]; }
  693:    
  694: 
  695:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
  696:    __inline__ __device__ double zLevelVegRatio(int k) const { 
  697:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
  698:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
  699:    } 
  700:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
  701:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot(); }
  702:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 1; }
  703:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 1; }
  704: 
  705:    // Get valid starting element (for backtracking)
  706:    __inline__ __device__ Element* getStartElement() {
  707:       return elems[0] ? elems[0] : elems[1];
  708:    }
  709: 
  710:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
  711:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
  712: 
  713:       // If one of the elements is null, return the other one
  714:       if      (elems[0] == nullptr) return elems[1];
  715:       else if (elems[1] == nullptr) return elems[0];
  716: 
  717: 
  718:       // Dot product of the negative velocity vector with the side normal vector
  719:       const double dot_prod1 = -dot(u, n);
  720:       
  721:       // Vector from side center to element 0 centroid
  722:       const Vector2 v2 = toVector2(elems[0]->center) - center;
  723: 
  724:       // Dot product of the vector with the side normal vector
  725:       const double dot_prod2 = dot(v2, n);
  726: 
  727:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
  728:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
  729: 
  730:       if (dot_prod1*dot_prod2 > 0.0) return elems[0];
  731:       else                           return elems[1];
  732: 
  733:  
  734:    }
  735: 
  736:    __forceinline__ __device__ Element* otherElem(const Element* elem) {
  737:       // Given an element, returns the other element that shares this side
  738:       return (elems[0] == elem) ? elems[1] : elems[0];
  739:    }
  740: 
  741:    __forceinline__ __device__ Node* otherNode(Node* node) {
  742:       // Given a node, returns the other node that shares this side
  743:       return (n1 == node) ? n2 : n1;
  744:    }
  745:  
  746:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, double* sclr,
  747:                                      Vector3 &u_int) const;
  748: 
  749: 
  750: 
  751: 
  752: };
  753: 
