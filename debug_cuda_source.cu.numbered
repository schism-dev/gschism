 2953: __device__ void computeBottomDragVegetation(void) {
 2954:    // UNFINISHED. CHECK THIS:
 2955:    // How many kernels are needed? Why so many for loops?
 2956:    // Is the loop on sides needed?
 2957: 
 2958:    NODE(node);
 2959: 
 2960:    const int    kb      = node->kb;
 2961:    const double htot    = node->htot();
 2962:    const double rough   = node->rough;
 2963: 
 2964: 
 2965:    if (node->idry) {
 2966:       // Default values for dry nodes
 2967:       node->veg_alpha_vert_mean = node->veg_alpha0;
 2968:       /// XXX CHECK INDICES
 2969:       if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 2970:    }
 2971: 
 2972:    // Compute bottom drag Cd
 2973:    //--------------------------------
 2974: 
 2975:    // nchi = {-1, 0, 1} is the type of bottom drag.
 2976:    if (nchi==1) {
 2977: 
 2978:       bool ltmp = false; // for WBL iteration
 2979: 
 2980:       // Cdmax=-1 !max. Cd at node for this process (info only)
 2981:       // Drag at nodes
 2982: /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 2983: // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 2984:      
 2985:       const double rough = node->rough;
 2986:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 2987:       if (node->rough == 0.0) {
 2988:          node->Cd = 0.0;
 2989: 
 2990:       } else { //roughness >0 
 2991:          
 2992:          const double bthick_ori = node->znl[kb + 1] - node->znl[kb];  // thickness of bottom bnd layer
 2993:          const double bthick = max(dzb_min, bthick_ori);
 2994: 
 2995:          assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 2996: 
 2997:          double tmp = 1.0/(2.5*log(bthick/rough));
 2998:          node->Cd = tmp*tmp;
 2999: 
 3000:       } // if rough
 3001: 
 3002: 
 3003:       // RECOVER THIS: XXX
 3004:       // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 3005:       // Output warning for WBL if iteration didn't converge
 3006: 
 3007: 
 3008:    } // nchi==1
 3009: 
 3010:    //   Bottom stress in m^2/s^2
 3011:    if (node->rho[kb + 1] >= -98.0)
 3012:    {
 3013:       const double mag_u = length(toVector2(node->u2[kb + 1]));
 3014:       node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 3015:       // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 3016:       // !sediment erosion: this part needs more documentation
 3017:    }
 3018: 
 3019:  
 3020:    // Compute vegetation parameters
 3021:    //--------------------------------
 3022: 
 3023:    // SAV constants
 3024:    constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 3025:    constexpr double veg_cfpsi = 0.16;
 3026: 
 3027:    // Add vertical variation to veg_alpha and compute vertical mean etc.
 3028:    if constexpr(iveg == 1) { //  Vertical variation specified by functions
 3029: 
 3030:       // Compute the vegetation "density" \alpha = D*N*Cd/2
 3031:       // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 3032:       int kbin = 0; // bin index
 3033:       for (int k = kb; k < nvrt; k++) {
 3034:          // Computes node height above the bottom level
 3035:          const double tmp_h = node->znl[k] - node->znl[kb]; // >=0
 3036:          assert(true && "Vertical variation of vegetation not implemented");
 3037: 
 3038:          // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 3039:          //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 3040:          //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 3041:          //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 3042:          // } else {
 3043:          //    // Find the bin at which the current vertical level is
 3044:          //    while (kbin<nbins_veg_vert) {
 3045:          //       const double zn = node->znl[kbin];
 3046:          //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 3047:          //          break;
 3048:          //       } // if
 3049:          //       kbin++;
 3050:          //    } // while
 3051:          //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 3052: 
 3053:          //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 3054:          //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 3055:             
 3056:          //    // Linear interpolation of the vegetation parameters
 3057:          //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 3058:          //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 3059:          //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 3060:          // } // if rl10
 3061: 
 3062:          // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 3063: 
 3064:       } // for k
 3065: 
 3066: 
 3067:    } else { // Ganthy (iveg=2)
 3068:    //  Modify canopy height, diameter, and density
 3069: 
 3070:       // Make sure there is vegetation on this node
 3071:       if (node->veg_h_unbent > 0.0) {
 3072:          const double wtmp2 = length(node->dav)*100.0; // cm/s
 3073: 
 3074:          node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 3075:                                 0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 3076:          node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 3077: 
 3078:          const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 3079:          node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 3080:          const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 3081:          node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 3082:       } // if veg_h_unbent
 3083: 
 3084:       for (int k = 0; k < nvrt; k++) {
 3085:          node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 3086:       } // for k
 3087:    
 3088: 
 3089:    } // if iveg
 3090:   
 3091:       
 3092: 
 3093:    // Compute vertical mean of veg_alpha3D
 3094:    if (iveg != 0) {
 3095:       const double ztop = node->zTopCanopy(); // Top of the canopy
 3096:       double sum1=0.0;
 3097:       double sum2=0.0;
 3098:       // Integrate over each level under the canopy...
 3099:       for (int k=kb; k<nvrt-1 && node->znl[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 3100:          const double Dz = node->Dz(k);
 3101: 
 3102:          sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 3103:          sum2 += Dz;
 3104: 
 3105:       } // for k
 3106: 
 3107:       if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 3108:       else             node->veg_alpha_vert_mean = sum1/sum2;
 3109: 
 3110:    } // if iveg
 3111: 
 3112: }
 3113: 
 3114: __device__ void computeVegetationAndDragParameters(void) {
 3115:    // Computes the vegetation and drag model parameters:
 3116:    // chi, \tilde\chi, beta, \breve{H}
 3117:    
 3118:    SIDE(side);
 3119: 
 3120:    const double htot = side->htot();
 3121:    const int    kb   = side->kb;
 3122: 
 3123:    assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 3124: 
 3125:    const double veg_h     = side->veg_h();
 3126:    const double veg_nv    = side->veg_nv();
 3127:    const double veg_c     = side->veg_c();
 3128:    const double veg_beta  = side->veg_beta;
 3129:    const double veg_alpha = side->veg_alpha_vert_mean();
 3130: 
 3131:    // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 3132:    // Velocity magnitude at the bottom level
 3133:    // XXXX Check if we have add -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 3134:    assert(true && "Must use backtracked velocity");
 3135:    const double vmag1 = length(side->u2[kb + 1]); //BACKTRACKED VELOCITY
 3136:    side->chi2 = side->Cd()*vmag1;
 3137:    side->chi  = side->chi2;
 3138:    if constexpr(iveg != 0) {
 3139:       const Node *n1 = side->n1;
 3140:       const Node *n2 = side->n2;
 3141:       const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 3142:       side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 3143:    }
 3144: 
 3145:    // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 3146: 
 3147:    // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 3148:    // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 3149:    double magUa = 0.0;
 3150:    if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 3151:       // 3D wet side with veg...
 3152: 
 3153:       double magUa = 0.0;
 3154:       for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 3155:          if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 3156: 
 3157:             // Velocity magnitude must be computed at the center of each level to perform the integration.
 3158:             // The tricky part is to compute that velocity at the level that may be partially submerged.
 3159:             const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 3160: 
 3161:             // Velocity magnitude at the top (h) of the level (may be partially submerged)
 3162:             const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 3163: 
 3164:             // Velocity magnitude at the bottom (l) of the level
 3165:             const double ul = length(side->u2[k]);
 3166: 
 3167:             const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 3168:             magUa += Dz*0.5*(uh + ul);
 3169: 
 3170:          } // if HasVegetation
 3171:       } // for k
 3172:       const double ua = magUa/min(htot, veg_h); // Vertical average
 3173: 
 3174:       // Computes beta, used for computing the stress term at the top of the canopy.      
 3175:       side->veg_c2 = veg_alpha*dt*ua; // >=0
 3176:       if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 3177:          const double zCpy = side->zTopCanopy();
 3178:          const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 3179:          const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 3180:          const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 3181:          const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 3182:          side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 3183:       } // if isSubmerged
 3184:    } // if iveg   
 3185: 
 3186:    // Computes the friction modified depth, \breve{H} in notes
 3187:    if (side->is2D()) { // 2D
 3188: 
 3189:       double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 3190:       if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 3191: 
 3192:       assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 3193: 
 3194:       side->hhat = htot*htot/fricH; 
 3195: 
 3196:    } else { // 3D
 3197:       side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 3198: 
 3199:       if constexpr(iveg != 0) {
 3200:          
 3201:          if (side->isSubmerged()) { 
 3202:             const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 3203:             side->hhat -= veg_c*Hhat_alpha;
 3204: 
 3205:          } else { // Emergent
 3206:             side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 3207:          }
 3208:       } // if iveg
 3209: 
 3210:       // Enforce positivity for 3D model
 3211:       if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 3212:    } // if 3D
 3213: 
 3214:      
 3215: }
 3216: 
 3217: 
 3218: 
 3219: __device__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 3220: // Computes the density gradient between two elements, e1 and e2.
 3221: // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 3222: // zero in the direction normal to the side. 
 3223: // 
 3224: // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 3225: // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 3226: //
 3227: // Input:
 3228: //    e1: Element
 3229: //    e2: Neighbor element (or nullptr if boundary)
 3230: //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 3231: //    k: Index of the half-level at which the density is interpolated
 3232: //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 3233: // 
 3234: // Output:
 3235: //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 3236: //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 3237: 
 3238:    if (e2 == nullptr || e2->idry) {
 3239:       // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 3240: 
 3241:       Side *side = e1->sides[j];
 3242:       assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->idry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 3243:               
 3244:       if constexpr(ics == 1) {
 3245:          vec = side->n; // Normal vector to the side
 3246:       } else {
 3247:          // IMPLEMENT THIS XXXXXX
 3248:          // !replace with xel, yel?
 3249:          //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 3250:          //      &eframe(:,:,i),xn1,yn1,tmp)
 3251:          //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 3252:          //      &eframe(:,:,i),xn2,yn2,tmp)
 3253:       } //ics
 3254:                 
 3255:       diffRho = 0.0;
 3256: 
 3257:    } else { //internal and wet
 3258:       if constexpr(ics==1) {
 3259:          assert(e2 != nullptr || e2->idry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 3260: 
 3261:          // Vector from e1 to e2
 3262:          vec = toVector2(e2->center - e1->center);
 3263: 
 3264:       } else { 
 3265:          // IMPLEMENT THIS XXXXXX
 3266:          //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 3267:          //      &eframe(:,:,i),xctr2,yctr2,tmp)
 3268:          //                   alow(j)=xctr2
 3269:          //                   bdia(j)=yctr2
 3270:       } // ics
 3271: 
 3272:       diffRho = rho2 - e1->demeanedDensity(k);
 3273:    }
 3274: 
 3275: }
 3276: 
 3277: __device__ void computeDensityCubicSplines(void) {
 3278:    // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 3279: 
 3280:    ELEM(elem);
 3281: 
 3282:    if (elem->idry) return;
 3283: 
 3284:    const int kb = elem->kb;
 3285: 
 3286:    // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 3287:    if (elem->is2D()) {
 3288:       // In the 2D case, the density is constant at the prism level. 
 3289:       // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 3290:       elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 3291:    } else { //3D
 3292: 
 3293:       // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 3294:       auto getX = [elem] (int k) { return elem->z_prism(k); };
 3295:       auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 3296:       ///// XXXX CHECK INDICES!!!!!
 3297:       initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 3298:    } // 2D/3D
 3299: 
 3300: }
 3301: 
 3302: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 3303: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 3304: 
 3305:    if (elem2 == nullptr || elem2->idry) return 0.0;
 3306: 
 3307:    const int kb  = elem->kb;
 3308:    const int kb2 = elem2->kb;
 3309: 
 3310:    // z-coordinate of prism of elem
 3311:    const double zp = elem->z_prism(k);
 3312: 
 3313:    double rho = 0.0;
 3314: 
 3315:    if (elem2->is2D()) {
 3316:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 3317: 
 3318:    } else {  // 3D
 3319: 
 3320:       // eta_min may be < zmax
 3321:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 3322:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 3323: 
 3324:       // (Extrapolate density below bottom, we will fix it later)
 3325:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 3326:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 3327:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 3328:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 3329:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 3330:    } // 2D/3D
 3331:      
 3332: 
 3333:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 3334:    // Now we need to fix it.
 3335:    if (elem->z[k] < elem2->z[kb2]) {
 3336:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 3337: 
 3338:       // There are two methods to adjust the density at the bottom of the element.
 3339:       // iunder_deep=0: 
 3340:       const double depth1 = abs(elem->z[kb]); // larger depth
 3341: 
 3342:       if (iunder_deep==0) {
 3343: 
 3344:          const double weight = max(0.0, min(1.0, (depth1 - h1_bcc)/(h2_bcc - h1_bcc))); // weight
 3345: 
 3346:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 3347: 
 3348:       } else { // iunder_deep != 0
 3349: 
 3350:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 3351: 
 3352:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 3353: 
 3354:          //   Demeaned density at the same z coordinate as
 3355:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 3356:          }
 3357: 
 3358:       } // if iunder_deep
 3359:    } // if elem->z[kb] < elem2->z[kb]
 3360: 
 3361:    return rho;
 3362: }
 3363: 
 3364: __device__ void computeDensityGradient(void) {
 3365: 
 3366:    // Compute the horizontal density gradient at each element.
 3367:    // It works in two steps:
 3368:    // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 3369:    // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 3370:    //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 3371:    //             gradRho.r1 = rho1 - rho0
 3372:    //             gradRho.r2 = rho2 - rho0
 3373:    //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 3374:    // 
 3375:    //  NOTE: We use de-meaned densities.
 3376: 
 3377:    ELEM(elem);
 3378: 
 3379:    if (elem->idry) return;
 3380: 
 3381:    const int kb  = elem->kb;
 3382:    const int i34 = elem->i34;
 3383: 
 3384:    for (int k = kb + 1; k < nvrt; k++) {
 3385:       // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 3386:       //             gradRho.r1 = rho1 - rho0
 3387:       //             gradRho.r2 = rho2 - rho0
 3388:       int icount = 0;
 3389:       double sumRx = 0.0;
 3390:       double sumRy = 0.0;
 3391:       for (int j1=0; j1<i34; j1++) { 
 3392: 
 3393:          const int j2 = elem->nxq(j1 + 1);
 3394: 
 3395:          // Pairs of consecutive neighbor elements of elem
 3396:          const Element *e1 = elem->nghbElems[j1];
 3397:          const Element *e2 = elem->nghbElems[j2];
 3398: 
 3399:          // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 3400:          const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 3401:          const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 3402: 
 3403:          // Compute the density difference and the vector from elem to e1 and e2
 3404:          // getRhoDiffAndVec takes into account boundaries/dry elements
 3405:          double diffRho1, diffRho2;
 3406:          Vector2 vec1, vec2;
 3407:          getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 3408:          getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 3409: 
 3410:          const double rl1 = length(vec1);
 3411:          const double rl2 = length(vec2);
 3412:          assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 3413: 
 3414:          const double delta = cross(vec1, vec2);
 3415:          const double sintheta = abs(delta)/(rl1*rl2);
 3416: 
 3417:          // To avoid problems, avoid elements with small angle between vectors
 3418:          constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 3419:          const bool validEq = (sintheta > sin_one_deg);
 3420: 
 3421:          if (validEq) {
 3422:             // Solve the system of equations to get the density gradient at elem
 3423:             icount++;
 3424:             const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 3425:             const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 3426:             sumRx += Rx;
 3427:             sumRy += Ry;
 3428:          }
 3429:       } // for j1
 3430: 
 3431:       // Compute the average density gradient at elem
 3432:       if (icount==0) {
 3433:         // Bad mesh quality; bail out with 0 b-cc
 3434:         elem->gradRho[k] = {0.0, 0.0};
 3435:       } else {
 3436:         elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 3437:       }
 3438: 
 3439:    } // for k
 3440: 
 3441: }
 3442: 
 3443: __device__ void computeBaroclinicTerm(double rampbc) {
 3444: // Computes the baroclinic term at sides (at half levels).
 3445: // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 3446: // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 3447: 
 3448:    SIDE(side);
 3449: 
 3450:    if (side->idry == 1) return;
 3451: 
 3452:    const Element *e1 = side->elems[0];
 3453:    const Element *e2 = side->elems[1];      
 3454:    const int kb = side->kb;
 3455:    
 3456:    assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 3457: 
 3458:    // interpolates vertically the density gradient of the two elements at the half level/
 3459: 
 3460:    // Starts the integration at the surface and goes down to the bottom
 3461:    int k1 = nvrt - 1;
 3462:    int k2 = nvrt - 1;
 3463: 
 3464:    side->bcc[nvrt-1] = {0.0, 0.0};
 3465:    for (int k = nvrt-1; k >= kb; k--) {
 3466:    // For each prism level (from surface to bottom)...
 3467: 
 3468:       // For both elements, interpolate density gradient at the side's half level.
 3469:       // The gradient at the side is the average of the gradients at the elements.
 3470:       // w1, w2 are used to take into account boundary sides, with just one element.
 3471:       double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 3472:       double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 3473:       w1 = w1/(w1 + w2);
 3474:       w2 = w2/(w1 + w2);
 3475: 
 3476:       assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 3477: 
 3478:       // Linear interpolation of both elements' density gradient at the shared side's level.
 3479:       Vector2 gradRho = {0.0, 0.0};
 3480:       if (e1 != nullptr && k > kb) {
 3481:          // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 3482:          k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 3483:          const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 3484:          
 3485:          gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 3486:       }      
 3487:       if (e2 != nullptr && k > kb) {
 3488:          k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 3489:          const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 3490:          
 3491:          gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 3492:       }
 3493: 
 3494:       if constexpr(ics==2) {
 3495:          // IMPLEMENT THIS XXXXXX
 3496:          // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 3497:          // swild(1)=tmp1
 3498:          // swild(2)=tmp2
 3499:       }
 3500:       
 3501:       // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 3502:       // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 3503:       // CHECK INDICES!!! XXX
 3504:       const double grav3 = 0.5*(side->n1->grav2 + side->n2->grav2);
 3505:       side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 3506:    } // for
 3507: 
 3508: }
 3509: 
 3510: #ifdef DONTCOMPILE
 3511: __device__ void computeVerticalAdvection(void) {
 3512:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 3513: 
 3514:    sdbt(1:2,:,:)=0.d0
 3515: 
 3516:    const Side *side = FROM kernel;
 3517: 
 3518:    if(side->idry) return;
 3519: 
 3520:    // If side is wet...
 3521: 
 3522: 
 3523:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 3524:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 3525:    double ws[nvrt] = {} // w @ side
 3526:    int icount = 0;
 3527:    for (int j=0; j<2; j++) {
 3528:       const Element *elem = side->elements[j];
 3529:        
 3530:       if(elem != nullptr) {
 3531:          icount++;
 3532:          for (int k=0; k<nvrt; k++) {
 3533:             ws[k] = ws[k] + elem->w[k];
 3534:          }
 3535:       }
 3536:    }  // for j
 3537: 
 3538:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 3539:    ws = ws/icount;
 3540: 
 3541:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 3542:    // Splines allow for a smooth transition between vertical levels.
 3543:    // Splines have continuity restrictions at the internal knots, but
 3544:    // we have to provide the 1st derivatives at the endpoints.
 3545:    const int kbs = side->kbs; 
 3546:    
 3547:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3548:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3549:    initCubicSpline(kbs, nvrt, side, ws, up)
 3550: 
 3551:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3552:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3553:    initCubicSpline(kbs, nvrt, side, ws, vp)
 3554: 
 3555:    // Total advection (average onto side)
 3556:    const Node *node1 = side->nodes[0];
 3557:    const Node *node2 = side->nodes[1];
 3558:    for (int k=kbs(i); k<nvrt; k++) {
 3559: 
 3560:       if constexpr(ics==1) {
 3561:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 3562:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 3563:       } else {
 3564:          // XXX IMPLEMENT THIS
 3565:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 3566:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 3567:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 3568:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 3569:       }  // if ics
 3570: 
 3571: 
 3572:    }
 3573: }
 3574: #endif
 3575: 
 3576: __device__ void computeElemAverageGhat(double rampbc) {
 3577: // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 3578: 
 3579:    ELEM(elem);
 3580:    
 3581:    elem->ghat1= {0.0, 0.0};  
 3582: 
 3583:    if constexpr(ihydraulics != 0) {
 3584:       if (nhtblocks > 0 && elem->isblock) return;
 3585:    }
 3586: 
 3587:    if (elem->idry == 1) return;
 3588: 
 3589:    // Wet elements.
 3590:    // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 3591:    // tidal potential, horizontal diffusion, and baroclinic etc
 3592:    // Remember to update both fb and F 
 3593:    // If ics=2, ghat1 are in eframe (ll)
 3594:    // cff1-3: coefficients for 2D/3D
 3595:    Vector2 gradEta = {0.0, 0.0};  // \nabla \eta
 3596:    Vector2 gradPr  = {0.0, 0.0};  // \nabla pressure
 3597:    Vector2 gradEtp = {0.0, 0.0};  // \nabla etp
 3598: 
 3599:    double av_cff1 = 0.0;  // av. for cff1
 3600:    double av_cff2 = 0.0;  // av. for cff2
 3601:    double av_cff3 = 0.0;  // av. for cff3
 3602:    double av_df = 0.0;  // av. for H^\alpha / H
 3603:    double av_cff2_chi = 0.0;  // av. for cff2*chi
 3604:    double av_cff3_chi = 0.0;  // av. for cff3*chi
 3605: 
 3606:    const int i34 = elem->i34;
 3607:    const int kb = elem->kb;
 3608: 
 3609:    for (int j=1; j<i34; j++) {
 3610:       // For each node and side in the element...
 3611: 
 3612:       const Node *node = elem->nodes[j];
 3613:       const Side *side = elem->sides[j];
 3614: 
 3615:       const double chi      = side->chi;
 3616:       const double veg_c2   = side->veg_c2;
 3617:       const double veg_beta = side->veg_beta;
 3618:       const double veg_h    = side->veg_h();
 3619:       const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 3620: 
 3621:       // Node - const in elem
 3622:       gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 3623:       gradPr  += node->pr  *elem->gradPhi[j];
 3624: 
 3625:       if (elem->depth >= tip_dp) {
 3626:         gradEtp += node->etp*elem->gradPhi[j];
 3627:       }
 3628: 
 3629:       
 3630:       const double htot  = side->htot();        // Total depth at the side
 3631:       const double zctr2 = side->zTopCanopy();  
 3632: 
 3633:       double cff1; 
 3634:       double cff2; 
 3635:       double cff3;   
 3636:       if (side->is2D()) {  // XXX Check indices, it used to have a +1
 3637:       // coefficients applied to 2D/3D case 
 3638:          cff1 = side->hhat/htot;
 3639:          cff2 = 0.0;
 3640:          cff3 = 0.0;
 3641:       } else { //3D
 3642:          //Init for no-veg case
 3643:          cff1 = 1.0;
 3644:          cff2 = 1.0;
 3645:          cff3 = 0.0;
 3646: 
 3647:          if constexpr(iveg != 0) {
 3648:             // Computes coefficients used with vegetation terms G1, G2
 3649:             // cff1, cff3 are used for the first two terms in G1, G2:
 3650:             // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 3651:             // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 3652:             // In general, cff1*Ustar - cff3*Ustar_alpha
 3653:             if(veg_h < 0.99*htot) { // submergent vegetation
 3654:                cff1=1;
 3655:                cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 3656:                cff3 = veg_c;
 3657: 
 3658:             } else { // emergent vegetation
 3659:                cff1 = 1.0/(1.0 + veg_c2);
 3660:                cff2 = cff1;
 3661:                cff3 = 0.0;
 3662: 
 3663:             }
 3664:          } // if iveg
 3665:       } //  2D/3D
 3666: 
 3667:       av_cff1 += cff1/i34;
 3668:       av_cff2 += cff2/i34;
 3669:       av_cff3 += cff3/i34;
 3670:       av_cff2_chi += cff2*chi/i34;
 3671:       av_cff3_chi += cff3*chi/i34;
 3672:       av_df += min(htot, veg_h)/(htot*i34);
 3673: 
 3674: 
 3675:       // btrack values: U^\star, U^{\star\alpha}
 3676:       // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 3677:       Vector2 Ustar       = {0.0, 0.0}; 
 3678:       Vector2 Ustar_alpha = {0.0, 0.0}; 
 3679:       for (int k = side->kb; k < nvrt; k++) {
 3680:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 3681:             Ustar += side->btu[nvrt]*side->Dz(k);
 3682: 
 3683:          } else { //3D
 3684:             Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 3685:             Ustar += w2;
 3686: 
 3687:             if constexpr(iveg != 0) {
 3688:                 if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 3689:                     const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k)); // For the top of the canopy, ratio of the level that is below the canopy
 3690:                     Ustar_alpha += zrat*w2; // XXXX
 3691:                 }
 3692:             }  // if iveg
 3693:          }  //2/3D
 3694:       }  //k
 3695:       
 3696: 
 3697:       // Add btrack & surface stress terms to \breve{G} first
 3698:       if constexpr(ics==1) {
 3699:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 3700:       } else {
 3701:          // XXX IMPLEMENT THIS
 3702:          // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 3703:          // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 3704:          // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 3705:       }  // if ics
 3706: 
 3707:       // Surface and bottom stress terms
 3708:       if constexpr(ics==1) {
 3709:          const Vector2 tau    = side->tau();
 3710:          const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 3711: 
 3712:          // Term for surface and bottom stress
 3713:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 3714:       } else {
 3715:          // XXX IMPLEMENT THIS
 3716:          // n1=isidenode(1,isd); n2=isidenode(2,isd)
 3717:          // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 3718:          // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 3719:          // tau_x=(vn1+tt1)/2.d0
 3720:          // tau_y=(vn2+ss1)/2.d0
 3721:          // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 3722:       }  // if ics
 3723: 
 3724:       
 3725: 
 3726:       // All terms in F,F^\alpha,f_b except baroclinic
 3727:       // F, f_b: all explicit terms excluding vegetation 
 3728:       // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 3729:       // Only need to calculate F^\alpha for 3D sides (but init=0) 
 3730:       const double coriolis = side->coriolis;
 3731:       Vector2 F  =  coriolis*side->U;  // F_x
 3732:       Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 3733:       Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 3734: 
 3735:       if (iveg != 0 && nvrt > side->kb) {  // 3D
 3736:          
 3737:          for (int k = side->kb; k < nvrt; k++) {
 3738:             if (zctr2 > side->zc[k-1]) {
 3739:                 const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 3740:                 const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 3741:                 Fa +=  coriolis*w2*zrat;
 3742:             } // if zctr2
 3743:          } // k
 3744:       } // iveg
 3745: 
 3746:       // Integrate horizontal viscosity force vertically
 3747:       for (int k=side->kb + 1; k<nvrt; k++) {
 3748:          const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.0; 
 3749: 
 3750:          F += levelHorVisc;
 3751: 
 3752:          // Vegetation term
 3753:          if constexpr(iveg!=0) {
 3754:             if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 3755:                const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 3756:                Fa += levelHorVisc*zrat;
 3757:             } 
 3758:          } // if iveg
 3759:       } // for k
 3760: 
 3761:       fb += side->d2uv[side->kb];
 3762: 
 3763: 
 3764:       // Add to ghat1
 3765:       if constexpr(ics==2) {
 3766:          // XXX IMPLEMENT THIS
 3767:          // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 3768:          // bigf1=vn1; bigf2=vn2
 3769:          // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 3770:          // botf1=vn1; botf2=vn2
 3771:          // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 3772:          // bigfa1=vn1; bigfa2=vn2
 3773:       } // if ics
 3774: 
 3775:       elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 3776:    } // for j (nodes and sides)
 3777: 
 3778:    elem->ghat1 = (1.0/i34)*elem->ghat1;
 3779:       
 3780:    // Finish off terms in F, F^\alpha and f_b
 3781:    const double grav3 = elem->mean(&Node::grav2);
 3782:    const Vector2 fb = grav3*gradEtp - gradPr/rho0; //const in each elem
 3783: 
 3784: 
 3785:    Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 3786:    for (int j=1; j<i34; j++) { 
 3787:       // For each side in the element...
 3788:       const Side *side = elem->sides[j];
 3789:       const double chi = side->chi;
 3790: 
 3791:       const double htot = side->htot();
 3792:       const double veg_h = side->veg_h();
 3793:       const Vector2 F  = htot*fb;
 3794:       const Vector2 Fa = min(htot, veg_h)*fb;
 3795: 
 3796:       tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 3797:    } // for j
 3798: 
 3799:    //botf1 etc are already in elem frame
 3800:    elem->ghat1 += tmp/i34;
 3801: 
 3802:    // Baroclinic force
 3803:    if constexpr(ibc==0) {
 3804:       assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 3805: 
 3806:       Vector2 Fa = {0.0, 0.0};
 3807:       Vector2 intGradRho = {0.0, 0.0};
 3808:       
 3809:       // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 3810:       for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 3811:          intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 3812: 
 3813:          // \in F [m^2/s/s]
 3814:          Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 3815:       }
 3816: 
 3817:       const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 3818:       const Vector2 F = av_df*Fa; //approx
 3819:       elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 3820: 
 3821:    } // if ibc
 3822: 
 3823: }
 3824: 
 3825: 
 3826: 
 3827: #ifdef DONTCOMPILE
 3828: __global__ void checkMassConservation(Tracers* sumtr) {
 3829: 
 3830:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 3831: 
 3832:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 3833: 
 3834:    Element *elem = &(mesh->localElemData[i]);
 3835: 
 3836:    // Skip dry elements
 3837:    if (elem->idry) return;
 3838: 
 3839:    // Local sum array for this thread
 3840:    double localSum[N_TRACERS] = {0.0};
 3841: 
 3842:    // Sum over vertical levels for this element
 3843:    const int kbe = elem->kbe;
 3844:    const double area = elem->area;
 3845: 
 3846:    for (int k = kbe; k < nvrt; k++) {
 3847:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 3848:       
 3849:       // Accumulate tracer mass
 3850:       for (int tr = 0; tr < N_TRACERS; tr++) {
 3851:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 3852:       }
 3853:    }
 3854: 
 3855:    
 3856: 
 3857:    //  This function returns per element sums. A reduction must be done on the host side.
 3858: }
 3859: 
 3860: 
 3861: __global__ void transport(void) {
 3862: 
 3863:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 3864: 
 3865:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 3866: 
 3867:    Element *elem = &(mesh->localElemData[ie]);
 3868: 
 3869:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 3870: 
 3871:                for (int m=0; m<ntr; m++) {
 3872:                   for (int k=kbe(ie); k<nvrt; k++) {
 3873:                      // Calculate each polynomial's weight 
 3874:                      wm=0.d0; sum1=0.d0; 
 3875:                      wm1=0.d0; wm2=0.d0; 
 3876:                      for (int i=0; i<elem->nweno2; i++) {
 3877:                   
 3878:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3879:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3880:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3881:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3882:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3883:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 3884:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 3885:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 3886:                      // -----------------Hu and Shu (1999)'s method----------------
 3887:                      b4=b1+b2+b3
 3888: 
 3889: //Error: add PRODUCTION CPP
 3890: #ifdef DEBUG
 3891:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 3892:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 3893:                     call parallel_abort(errmsg)
 3894:                   }
 3895: #endif
 3896: 
 3897:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 3898:                   // !----test-------------- 
 3899:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 3900:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 3901:                   // !wm(i)=wm1(i)*wm2(i)
 3902:                   // !---------------------- 
 3903:                   sum1=sum1+wm(i)
 3904:                 } // end for i
 3905: 
 3906:                 wm=wm/sum1
 3907: 
 3908:                 for (int j=0; j<elem->i34; j++) {
 3909: 
 3910:                   const Side *side  = elem->sides[j];
 3911:                   const Node *node1 = side->n1;
 3912:                   const Node *node2 = side->n2;
 3913: 
 3914:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 3915:                      trsd=0.d0
 3916:                      for (int kk=0; kk<nquad; kk++) {
 3917:                         for (int i=0; i<elem->nweno2; i++) {
 3918:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3919:                         } // end for i   
 3920:                      } // end for kk
 3921:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 3922:                   } // outward flux
 3923:                } // end for j=1,i34(ie) ! side
 3924:             }
 3925:          }
 3926:               
 3927: 
 3928: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 3929: //             //   calculate each polynomial's weight 
 3930: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 3931: //                 wm=0.d0; sum1=0.d0
 3932: //                 do i=1,nweno1(ie) !for each polynomial
 3933: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 3934: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 3935: //                   b1=b1*b1+b2*b2 !smoothness indicator
 3936: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 3937: //                   wm(i)=b2
 3938: //                   sum1=sum1+b2
 3939: //                   !wm(i)=1.d0
 3940: //                   !sum1=sum1+1.d0
