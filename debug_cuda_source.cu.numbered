  948: }; // End of Mesh class
  949: 
  950: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
  951:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
  952: }
  953: 
  954: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
  955:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
  956: }   
  957: 
  958: __device__ __inline__ double min3(double a, double b, double c) {
  959:    return min(a, min(b, c));
  960: }
  961: 
  962: __device__ __inline__ double min4(double a, double b, double c, double d) {
  963:    return min(a, min(b, min(c, d)));
  964: }
  965: 
  966: 
  967: // Helper functions for computing the local node index at a given offset from another.
  968: __device__ __inline__ int nxq(int offset, int index, int size) {
  969:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
  970:    // to the index to make it positive
  971:    assert(index + offset + 16*size >= 0);
  972:    return (index + offset + 16*size) % size;  
  973: }
  974: 
  975: __device__ __inline__ int nxq(int index, int size) {
  976:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
  977:    // to the index to make it positive
  978:    assert(index + 16*size >= 0);
  979:    return (index + 16*size) % size; 
  980: }
  981: 
