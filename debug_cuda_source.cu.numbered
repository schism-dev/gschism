   37: constexpr double pi = 3.14159265358979323846;
   38: 
   39: constexpr double rearth_eq   = 6378206.4; // [m] 
   40: constexpr double rearth_pole = 6378206.4; // [m]
   41: constexpr double grav        = 9.81;      // [m/s^2]
   42: constexpr double omega_e     = 7.292e-5;  // [1/s]
   43: 
   44: constexpr double thetai = 0.6;
   45: 
   46: constexpr double rho0 = 1000.0; // [kg/m^3]
   47: constexpr double dtb_min = 0.1; //XXXX
   48: constexpr double dtb_max = 1000.0; //XXXX
   49: constexpr double velmin_btrack = 0.01; //XXXX
