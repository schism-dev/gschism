  394: 
  395: struct Element {
  396: 
  397:    // Geometry information
  398:    int idx;               // Index of the element
  399:    int i34;               // Number of sides for the element 
  400:    Side *sides[4];        // Sides of the element
  401:    Node *nodes[4];        // Nodes of the element
  402:    Element *nghbElems[4]; // Neighbors of the element
  403: 
  404:    int kb;                    // Bottom index of the element
  405:    double area;               // Area of the element
  406:    double ssign[4];           // Sign associated with each side of an element
  407:    double radius;             // Element equivalent radii
  408: 
  409:    Frame frame;
  410: 
  411:    Vector2 gradPhi[4];       // Derivatives of shape functions
  412:    Vector2 gradEta[nvrt];    // Gradient of free surface elevation
  413: 
  414:    bool isDry;                  // True if the element is dry
  415:    int kbe;                   // Bottom index of the element
  416: 
  417:    Vector3 center;            // Element center coordinates
  418:    double xlon_el, ylat_el;   // Element center lat/lon coordinates in _degrees_
  419:    double depth;              // Depth at element (min of all nodes)
  420:    double z[nvrt];            // z-coord  (local frame - vertical up)
  421: 
  422:    // Physical information
  423:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  424: 
  425:    static const bool isblock = false;              // Always false
  426: 
  427:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  428:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  429: 
  430:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  431: 
  432:    
  433: 
  434:    double vsource;            // Volumetric source/sink term [m^3/s]
  435: 
  436:    double rho[nvrt];          // Density at each prism center
  437:    double rho_mean[nvrt];     // Mean density at each prism center
  438:    CubicSpline rho_spl;
  439:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  440:    double rho_z[nvrt];        // First derivative of density at each prism center
  441:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  442: 
  443:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  444: 
  445:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  446:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  447: 
  448:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 1; }
  449:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 1; }
  450: 
  451:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  452:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  453:       // Find the local index of the node in the element (0,1,2,3)
  454:       int res = __ffs((nodes[0] == node) | 
  455:                      ((nodes[1] == node) << 1) | 
  456:                      ((nodes[2] == node) << 2) | 
  457:                      ((nodes[3] == node) << 3)) - 1;
  458:       
  459:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  460:       return res;
  461:    }
  462: 
  463:    __inline__ __device__ int findLevel(double z1, int k) const {
  464:       // Starting at index k, find sequentially the level that contains z
  465: 
  466:       // if z is already betweeen z[k] and z[k+1], return k
  467:       if (z1 >= z[k] && z1 < z[k+1]) return k;
  468:       else if (z1 < z[k]) { 
  469:          // Search for increasing levels
  470:          for (int kk = k; kk < nvrt - 1; kk++) {
  471:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  472:          }
  473:          return nvrt - 1;
  474:       }
  475:       else {
  476:          // Search for decreasing levels
  477:          for (int kk = k; kk > 0; kk--) {
  478:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  479:          }
  480:          return 0;
  481:       }
  482:    }
  483: 
  484:    __inline__ __device__ double z_prism(int k) const { return 0.5*(z[k+1] + z[k]); }
  485:    __inline__ __device__ double Dz(int k)      const { return z[k+1] - z[k]; }
  486: 
  487:    // Check if the element is dry using the more up-to-date elevation.
  488:    __inline__ __device__ bool isDry2(void) const;
  489: 
  490:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  491: 
  492:    __inline__ __device__ double computeSignedArea(void) const;
  493: 
  494:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  495:       // Nudges the point (x,y) to the barycenter of the element
  496:       p = (1-eps)*p + eps*toVector2(center);
  497:    }
  498: 
  499:    __device__ bool computeShapeCoords(Point2 xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  500: 
  501:    __device__ Vector2 grad(double *a) const
  502:    {
  503:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  504:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  505:       if (isQuad()) {
  506:          gx += a[3]*gradPhi[3].x;
  507:          gy += a[3]*gradPhi[3].y;
  508:       }
  509:       return {gx, gy};
  510:    }
  511: 
  512:    __device__ Vector2 grad(double Node::* field) const
  513:    {
  514:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  515:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  516:       if (isQuad()) {
  517:          gx += (nodes[3]->*field)*gradPhi[3].x;
  518:          gy += (nodes[3]->*field)*gradPhi[3].y;
  519:       }
  520:       return {gx, gy};
  521:    }
  522: 
  523:    __device__ void setFrame(void) {
  524: 
  525:       double ar1, ar2;
  526:       computeLonLat(center, ar1, ar2);
  527: 
  528:       frame.update(ar1, ar2);        
  529:     }
  530: 
  531:    __device__ bool findNextIntersection(Point2 x2, Side *&side, Element *&nextElement, double &t, 
  532:                                         double& tIntersect);
  533:    __device__ bool findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement, double &t, 
  534:                                         double& tIntersect);
  535: 
  536:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  537:       // Check if the point (xt,yt) is inside the element
  538:       double shpCoords[4];
  539:       bool res = computeShapeCoords(xt, shpCoords, false);
  540:       return res;
  541:    }
  542: 
  543:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  544:    {
  545:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  546:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  547:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  548:       
  549:    }
  550: 
  551:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int) const;
  552: 
  553:    // ------------------------------------------------------------------------------------------------
  554:    // These are functions that work on all nodes of the element.
  555:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  556:    //
  557:    // An example of how to use these functions is:
  558:    //   
  559:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  560:    // 
  561:    // Where L is the level at which the field is to be interpolated. The field can be either
  562:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  563:    // There are different versions of getNodalValues for each of these cases.
  564: 
  565:    template<typename T>
  566:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  567:       // Get the values of the field at the nodes of the element
  568:       res[0] = nodes[0]->*field;
  569:       res[1] = nodes[1]->*field;
  570:       res[2] = nodes[2]->*field;
  571:       if (isQuad()) res[3] = nodes[3]->*field;
  572:       else          res[3] = T();
  573:    }
  574: 
  575:    template<typename T>
  576:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  577:       // Get the values of the field at the nodes of the element
  578:       res[0] = (nodes[0]->*field)[level];
  579:       res[1] = (nodes[1]->*field)[level];
  580:       res[2] = (nodes[2]->*field)[level];
  581:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  582:       else          res[3] = T();
  583:    }    
  584: 
  585:    template<typename T>
  586:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  587:       // Get the values of the func at the nodes of the element
  588:       res[0] = (nodes[0]->*func)(level);
  589:       res[1] = (nodes[1]->*func)(level);
  590:       res[2] = (nodes[2]->*func)(level);
  591:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  592:       else          res[3] = T();  // This is 0.0 or a zero vector
  593: 
  594:    }      
  595: 
  596:    template<typename T>
  597:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  598:       // Get the values of the field at the nodes of the element
  599:       res[0] = sides[0]->*field;
  600:       res[1] = sides[1]->*field;
  601:       res[2] = sides[2]->*field;
  602:       if (isQuad()) res[3] = sides[3]->*field;
  603:       else          res[3] = T();
  604:    }
  605: 
  606:    template<typename T>
  607:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  608:       // Get the values of the field at the nodes of the element
  609:       res[0] = (sides[0]->*field)[level];
  610:       res[1] = (sides[1]->*field)[level];
  611:       res[2] = (sides[2]->*field)[level];
  612:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  613:       else          res[3] = T();
  614:    }    
  615: 
  616:    template<typename T>
  617:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  618:       // Get the values of the func at the nodes of the element
  619:       res[0] = (sides[0]->*func)(level);
  620:       res[1] = (sides[1]->*func)(level);
  621:       res[2] = (sides[2]->*func)(level);
  622:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  623:       else          res[3] = T();  // This is 0.0 or a zero vector
  624: 
  625:    }      
  626: 
  627: 
  628:    __device__ double interpolate(int level, const double shapeCoords[4], double (Node::*func)(int) const) const {
  629:       double values[4];
  630:       getNodalValues(level, func, values);
  631: 
  632:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  633:    }
  634: 
  635:    template<typename T>
  636:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  637:       T values[4];
  638:       getNodalValues(field, values);
  639:       
  640:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  641:    }
  642: 
  643: 
  644:    template<typename T>
  645:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  646:       T values[4];
  647:       getNodalValues(level, field, values);
  648: 
  649:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  650:    }
  651: 
  652:    template<typename T>
  653:    __device__ T mean(T Node::* field) const {
  654:       T values[4];
  655:       getNodalValues(field, values);
  656: 
  657:       return (values[0] + values[1] + values[2] + values[3])/i34;
  658:    }
  659: 
  660:    template<typename T>
  661:    __device__ T mean(T Side::* field) const {
  662:       T values[4];
  663:       getSideValues(field, values);
  664:       
  665:       return (values[0] + values[1] + values[2] + values[3])/i34;
  666:    }   
  667: 
  668:    // __device__ double mean(double (Node::*func)(int) const) const {
  669:    //    double values[4];
  670:    //    getNodalValues(level, func, values);
  671:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  672:    // }
  673:    // ------------------------------------------------------------------------------------------------
  674: 
  675:    __device__ bool globalToLocal(double xt, double yt, double &xlocal, double &ylocal) const {
  676:       // Convert global coordinates to local coordinates
  677:       printf("NOT IMPLEMENTED: globalToLocal\n");
  678:       return true;
  679:    }
  680: 
  681:    __inline__ __device__ bool localToGlobal(double xlocal, double ylocal, double &xt, double &yt) const {
  682:       // Convert local coordinates to global coordinates
  683:       printf("NOT IMPLEMENTED: localToGlobal\n");
  684:       return true;
  685:    }
  686: 
  687:    __device__ void trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
  688:                                        double &dt, Point3 &xt, double zint, Vector3 &u_int);
  689:     
  690:    __device__ bool trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
  691:                                                  Element *&nextElem, int &jlev, double &dt);
  692: 
  693: };
