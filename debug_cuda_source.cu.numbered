 2347: 
 2348: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2349:                 double *node_coords, double *wind_rotate_angle, 
 2350:                 int *isdel, int *isidenode, int *isbnd,
 2351:                 int *nond, int *nlnd, int *iond, int *ilnd,
 2352:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2353:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2354:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2355:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2356:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 2357:                 double *emo, double *efa, 
 2358:                 double *umo, double *ufa, 
 2359:                 double *vmo, double *vfa) {
 2360: 
 2361:    printf("Populating mesh for partition %d\n", partNum);
 2362: 
 2363:    // Horizontal grid
 2364:    printf("Processing %d nodes\n", np);    
 2365: 
 2366: 
 2367:    int idxNodeBoundary = 0;  
 2368:    for (int i = 0; i < np; i++)
 2369:    {
 2370:       Node &node = localNodeData[i];
 2371: 
 2372:       node.idx = i;
 2373: 
 2374:       const int idxNodeStart = nodeNeighNodesStart[i];
 2375:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2376:       node.numNodes = idxNodeEnd - idxNodeStart;
 2377:       node.nodes = nodeNeighNodes + idxNodeStart;
 2378:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2379: 
 2380: 
 2381: 
 2382:       const int idxElemStart = nodeNeighElemsStart[i];
 2383:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2384:       node.numElements = idxElemEnd - idxElemStart;
 2385:       node.elements = nodeNeighElems + idxElemStart;
 2386: 
 2387: 
 2388:       
 2389:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2390:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2391:          const int partNode = localNodePart[idxNodeGlobal]; 
 2392:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2393: 
 2394: 
 2395:          Node *node_ptr = nodes[partNode] + idxNode;
 2396:          
 2397:          nodeNeighNodes[idx] = node_ptr;
 2398:       }
 2399: 
 2400:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2401:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2402:          const int partElem = localElemPart[idxElemGlobal];
 2403:          const int idxElem  = localElemIndices[idxElemGlobal];
 2404: 
 2405:          Element *elem_ptr = elems[partElem] + idxElem;
 2406: 
 2407:          nodeNeighElems[idx] = elem_ptr;
 2408:       }      
 2409: 
 2410: 
 2411:       node.wind_angle = wind_rotate_angle[i];
 2412: 
 2413:       // Element **elements; // pointer to the elements connected to this node
 2414:       // int numElements;   // number of elements shared by this node
 2415: 
 2416:       node.p.x   = node_coords[i * 3];
 2417:       node.p.y   = node_coords[i * 3 + 1];
 2418:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2419:       node.depth = node_coords[i * 3 + 2];
 2420: 
 2421: 
 2422: 
 2423:       // Links the node to the boundary information
 2424:       if (isbnd[i] >= 0) {
 2425:        
 2426:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2427:          node.nodeBnd->node = &node;
 2428: 
 2429:          if (isbnd[i]>0) {
 2430: 
 2431:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2432:             node.nodeBnd->segment->ifltype = isbnd[i];
 2433: 
 2434:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2435:             node.nodeBnd->segment->clen  = nan("1");
 2436:             node.nodeBnd->segment->carea = nan("1");
 2437: 
 2438:          }
 2439:          else {
 2440:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2441:          }
 2442:          
 2443:          idxNodeBoundary++;
 2444:       }
 2445:       else {
 2446:          node.nodeBnd = nullptr;
 2447:       }
 2448: 
 2449: // XXXX
 2450: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2451: constexpr double rot_per = 3000.0;
 2452: constexpr double rot_f = 0.0*2.0*pi/rot_per;
 2453: for (int k = 0; k < nvrt; k++) {node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0};}
 2454: // XXXXX
 2455:    }
 2456: 
 2457:    nbp = idxNodeBoundary;
 2458: 
 2459:    printf("Processing %d sides\n", ns);
 2460:    int idxSideBoundary = 0;
 2461:    for (int i = 0; i < ns; i++)
 2462:    {
 2463:       Side &side = localSideData[i];
 2464:       side.idx = i;
 2465:       // finding the pointer to the nodes that form the side
 2466:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2467:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2468: 
 2469:       const int locidx_n1 = localNodeIndices[idx_n1];
 2470:       const int locidx_n2 = localNodeIndices[idx_n2];
 2471:       const int part_n1 =   localNodePart[idx_n1];
 2472:       const int part_n2 =   localNodePart[idx_n2];
 2473: 
 2474:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2475:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2476: 
 2477:       // Normal vector to the side
 2478:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2479:       const double norm = sqrt(dot(side.n, side.n));
 2480:       side.n = side.n/norm;
 2481: 
 2482:       // Side boundary type
 2483:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 2484:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 2485:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2486:       
 2487:       if (n1bnd != nullptr || n2bnd != nullptr) 
 2488:       {
 2489:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2490:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2491:          else                  side.sideBnd->segment = n2bnd->segment;
 2492:          side.sideBnd->side = &side;
 2493:          idxSideBoundary++;
 2494:       }
 2495:       else side.sideBnd = nullptr;
 2496: 
 2497:       // finding the pointer to the elements that share the side
 2498:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2499:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2500: 
 2501:       if (idx_e1 > -1) {
 2502:          const int locidx_e1 = localElemIndices[idx_e1];
 2503:          const int part_e1 =  localElemPart[idx_e1];
 2504:          side.elems[0] = elems[part_e1] + locidx_e1;
 2505:          // printf("s@@ part_e1 = %d, locidx_e1 = %d, elems[part_e1] = %p\n", part_e1, locidx_e1, elems[part_e1]);
 2506:          // // printf("s-- side.elems[0] = %p idx = %d i34 = %d (x,y,z) = (%f,%f,%f) size = %d\n", side.elems[0], side.elems[0]->idx, side.elems[0]->i34, side.elems[0]->center.x, side.elems[0]->center.y, side.elems[0]->center.z, sizeof(Element));
 2507:          // printf("o-- elems = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2508:       }
 2509:       else {
 2510:          side.elems[0] = nullptr;
 2511:       }
 2512: 
 2513:       if (idx_e2 > -1) {
 2514:          const int locidx_e2 = localElemIndices[idx_e2];
 2515:          const int part_e2 =  localElemPart[idx_e2];
 2516:          side.elems[1] = elems[part_e2] + locidx_e2;
 2517:       }
 2518:       else {
 2519:          side.elems[1] = nullptr;
 2520:       }
 2521: 
 2522: 
 2523: 
 2524:       // Compute the center of the side
 2525:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2526: 
 2527: // XXXX
 2528: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2529: constexpr double rot_per=3000.0;
 2530: constexpr double rot_f=0.0*2.0*pi/rot_per;
 2531: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2532: // XXXXX      
 2533: 
 2534:       // Compute the z level at the center of the side
 2535:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->znl[k] + side.n2->znl[k]);
 2536: 
 2537:       // Compute the length of the side
 2538:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2539:       side.length = sqrt(dot(vLen, vLen));
 2540: 
 2541:    }
 2542: 
 2543:    printf("Processing %d elements\n", ne);
 2544:    for (int i = 0; i < ne; i++)
 2545:    {
 2546:       Element &elem = localElemData[i];
 2547:       elem.idx = i;
 2548:       for (int j = 0; j < i34[i]; j++) {
 2549:          const int idxNode = elnode[i*4 + j];  
 2550:          const int idxSide = elside[i*4 + j];
 2551:          
 2552:          elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 2553:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2554: 
 2555: 
 2556: 
 2557:          // Find the neighboring element  
 2558:          if (elem.sides[j]->elems[0] == &elem) {
 2559:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2560:          }
 2561:          else {
 2562:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2563:          }
 2564:          
 2565:       }
 2566: 
 2567:       elem.i34 = i34[i];
 2568: 
 2569: // printf("elem = %p, elem.i34 = %d\n", &elem, elem.i34);
 2570: 
 2571:       // Compute the centroid of the element and its depth
 2572:       Vector2 center = {0.0, 0.0};
 2573:       elem.depth = 0.0;
 2574:       for (int j = 0; j < i34[i]; j++) {
 2575:          center += elem.nodes[j]->p2()/i34[i];
 2576:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2577:       }
 2578:       elem.center.x = center.x;
 2579:       elem.center.y = center.y;
 2580: 
 2581:       // printf("elem = %p, i34 = %d, center = (%f,%f,%f)\n", &elem, elem.i34, elem.center.x, elem.center.y, elem.depth);
 2582:       
 2583:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2584:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2585: 
 2586:       elem.area = elem.computeSignedArea(); 
 2587:       elem.radius = sqrt(elem.area)/pi; 
 2588:       
 2589:       // Determines which way the normal vector to each side is oriented.
 2590:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2591:       for (int j = 0; j < i34[i]; j++)  
 2592:       {
 2593:          if (elem.sides[j]->elems[0] == &elem) {
 2594:             elem.ssign[j] =  1.0;
 2595:          }
 2596:          else {
 2597:             elem.ssign[j] = -1.0;
 2598:          }
 2599: 
 2600:       }
 2601: 
 2602:       // Derivatives of shape functions
 2603:       //  For ics=2, this is done inside element/ll frame XXX
 2604:       //  For quads, the derivative is evaluated at centroid
 2605:       const int i34 = elem.i34;
 2606:       for (int j = 0; j < i34; j++) {
 2607:          const double area = elem.area;
 2608:          const int id2 = elem.nxq(1 + j);
 2609:          const int id3 = elem.nxq(2 + j);
 2610:          const int id4 = elem.nxq(3 + j);
 2611:          if (elem.isTri()) {
 2612:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2613:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2614:             // da1/dx = (y1 - y2)/(2*area)
 2615:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2616:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2617:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2618:          }
 2619:          else  { // Quad; evaluate at centroid
 2620:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2621:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2622:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2623:          } // if Tri
 2624: 
 2625:       } // for j
 2626: 
 2627:    }
 2628: 
 2629: 
 2630:    // Processing the boundary nodes
 2631:    int idx = 0;
 2632:    for (int iseg = 0; iseg < nope; iseg++) {
 2633:       for (int ilnd = 0; ilnd < nlnd[iseg]; ilnd++) {
 2634: 
 2635:          NodeBoundary *nodeBnd = &localNodeBoundaryMem[idx];
 2636: 
 2637:          nodeBnd->isEssentialBC = true;
 2638: nodeBnd->iettype = 3;
 2639:          nodeBnd->elbc = 0.0;
 2640: 
 2641:          for (int jfr = 0; jfr < nbfr; jfr++) {
 2642:             nodeBnd->efa[jfr] = efa[jfr + iseg*nbfr];
 2643:             nodeBnd->emo[jfr] = emo[jfr + iseg*nbfr];
 2644:             nodeBnd->umo[jfr] = umo[jfr + iseg*nbfr];
 2645:             nodeBnd->ufa[jfr] = ufa[jfr + iseg*nbfr];
 2646:             nodeBnd->vmo[jfr] = vmo[jfr + iseg*nbfr];
 2647:             nodeBnd->vfa[jfr] = vfa[jfr + iseg*nbfr];
 2648: printf("nodeBnd->efa[%d] = %f, nodeBnd->emo[%d] = %f, nodeBnd->umo[%d] = %f, nodeBnd->ufa[%d] = %f, nodeBnd->vmo[%d] = %f, nodeBnd->vfa[%d] = %f\n", jfr, nodeBnd->efa[jfr], jfr, nodeBnd->emo[jfr], jfr, nodeBnd->umo[jfr], jfr, nodeBnd->ufa[jfr], jfr, nodeBnd->vmo[jfr], jfr, nodeBnd->vfa[jfr]);
 2649:          }
 2650: 
 2651:          idx++;
 2652:       }
 2653: 
 2654:    }
 2655: 
 2656: }
 2657: 
 2658: 
 2659: 
 2660: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 2661:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 2662:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 2663:    // 
 2664:    // This kernel is called for all nodes.
 2665: 
 2666: 
 2667:    NODE(node1);
 2668: 
 2669: 
 2670:    node1->clearMatrixRow();
 2671:    node1->qel = 0.0;
 2672: 
 2673:    // THIS IS FOR STRUCTURES XXX
 2674:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 2675: 
 2676:    
 2677:    for (int j=0; j<node1->numElements; j++) {
 2678:       // For each element connected to the node...
 2679: 
 2680:       Element *elem = node1->elements[j];
 2681: 
 2682:       // Compute the average gravity
 2683:       printf("UUU Node::grav2 = %f, %f, %f\n", elem->nodes[0]->grav2, elem->nodes[1]->grav2, elem->nodes[2]->grav2);
 2684:       const double grav3 = elem->mean(&Node::grav2);
 2685: 
 2686:       // Look at the documentation for the description of the terms in the following integrals
 2687: 
 2688:       // Integral I_1 
 2689:       // \bar{\breve{H}} 
 2690:       const double hhatb = elem->mean(&Side::hhat);        
 2691: 
 2692: 
 2693:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 2694: 
 2695:       const int id1 = elem->nodeLocalIdx(node1); 
 2696:       const double area = elem->area;
 2697: 
 2698:       if (elem->isTri()) {
 2699: 
 2700:          // To clarify the notation in this section: 
 2701:          //   i stands for the node under consideration (node1)
 2702:          //   j (node2) and k (node3) are the other nodes of the triangle.
 2703:          const int id2 = elem->nxq(1 + id1);
 2704:          const int id3 = elem->nxq(2 + id1);
 2705:          Node *node2 = elem->nodes[id2];
 2706:          Node *node3 = elem->nodes[id3];
 2707: 
 2708:          const Point2 x1 = node1->p2();
 2709:          const Point2 x2 = node2->p2();
 2710:          const Point2 x3 = node3->p2();
 2711: 
 2712:          // integral of phi_i*phi_j
 2713:          const double ipp_ii = (1.0/6.0 )*area;
 2714:          const double ipp_ij = (1.0/12.0)*area;
 2715:          const double ipp_ik = (1.0/12.0)*area;
 2716: 
 2717:          // integral of [(grad phi_i) * (grad phi_j)]
 2718:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 2719:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 2720:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 2721: 
 2722:          // Computes the different components of integral I_1 of each node with respect to node i.
 2723:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 2724:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 2725:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 2726: 
 2727: if (j==node1->numElements-1) {
 2728: printf("grav3 = %f, thetai = %f, dt = %f, hhatb = %f, area = %f, dot1= %f, dot2 = %f, dot3 = %f\n", grav3, thetai, dt, hhatb, area, dot(x3-x2, x3-x2), dot(x3-x2, x1-x3), dot(x1-x3, x1-x3));
 2729: printf("node idx = %d, x1 = %f, %f, x2 = %f, %f, x3 = %f, %f\n", node1->idx, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y);
 2730: printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 2731: }
 2732: 
 2733:          node1->addToSparseMatrix(node1, I1_ii);
 2734:          node1->addToSparseMatrix(node2, I1_ij); 
 2735:          node1->addToSparseMatrix(node3, I1_ik);
 2736: 
 2737: if (j==node1->numElements-1) printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 2738:      
 2739:       }
 2740:       else { // Quad
 2741:          // XXX IMPLEMENT THIS
 2742:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2743:       } 
 2744: 
 2745:  
 2746:       // Integral I_4
 2747:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 2748:       // Where
 2749:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 2750: 
 2751:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 2752:       // of U over the element.
 2753:       Vector2 Umean = {0.0, 0.0};
 2754:       for (int m=0; m<elem->i34; m++) {      
 2755:          const Side *side = elem->sides[m];
 2756: 
 2757:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 2758:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 2759:       }
 2760:       Umean = Umean/elem->i34;
 2761: 
 2762:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 2763: 
 2764:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 2765:       const double I_4_1 = dot(gradPhi_1, Umean);
 2766: 
 2767:       // Integral of \nabla\phi_i \cdot \pmb{E}
 2768:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 2769:      
 2770:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 2771: if (j==node1->numElements-1) printf("MMMMmm  idx_node = %d, I_4_1 = %.15g, I_4_2 = %.15g, node1->qel = %.15g, gradPhi_1 = %.15g, %.15g, elem->ghat1 = %.15g, %.15g\n", node1->idx, I_4_1, I_4_2, node1->qel, gradPhi_1.x, gradPhi_1.y, elem->ghat1.x, elem->ghat1.y);
 2772: 
 2773:       // Additional terms 
 2774:       double vnorm = 0.0;
 2775:       if (imm == 2)  { // Pre-compute vnorm on the element
 2776:          Vector3 ubed;
 2777:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 2778: 
 2779:          Vector3 gradP = {0.0, 0.0, 1.0};
 2780:          for (int m=0; m < elem->i34; m++) {
 2781:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 2782:            gradP += toVector3(gradP_2D, 0.0);
 2783:          }   
 2784:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 2785:       } // imm==2
 2786: 
 2787:       if (elem->isTri()) {
 2788:          for (int l=0; l<3; l++) {
 2789:            double fac;
 2790: 
 2791:            Node *node = elem->nodes[l];
 2792: 
 2793:            (node == node1)? fac=2.0 : fac=1.0;
 2794: 
 2795:            if (imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 2796:            else        node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 2797:            
 2798:          }
 2799: 
 2800: 
 2801:          if (!elem->isDry) {
 2802:            const Vector2 gradEta = elem->nodes[0]->eta2*elem->gradPhi[0] +
 2803:                                    elem->nodes[1]->eta2*elem->gradPhi[1] +
 2804:                                    elem->nodes[2]->eta2*elem->gradPhi[2];
 2805: 
 2806:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 2807:          }
 2808: if (j==node1->numElements-1) printf("&&& node1->qel = %f\n", node1->qel, node1->eta2);
 2809: 
 2810:       } // isTri
 2811:       else { // isQuad
 2812:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2813:          // for (int l=0; l<4; l++) {
 2814:          //   const Node *node = elem->nodes[l];
 2815: 
 2816:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 2817:          //   else        tmp2 = node->bdef2 - node->bdef1;
 2818: 
 2819:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 2820:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 2821:          // }
 2822: 
 2823:       } // isQuad
 2824: 
 2825: 
 2826:       node1->qel += (dt/elem->i34)*elem->vsource;
 2827:       
 2828: 
 2829:    } // for all elements connected to the node
 2830:    
 2831: 
 2832: 
 2833:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 2834:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 2835:    NodeBoundary *nodeBnd = node1->nodeBnd;
 2836:    if (nodeBnd != nullptr)  { 
 2837:       // If it is an open boundary node...
 2838: 
 2839:       // At least one open bnd side, maybe two
 2840:       for (int l=0; l<2; l++) { 
 2841: 
 2842:          // Gets each of the sides sharing the node. 
 2843:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 2844: 
 2845:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 2846: 
 2847:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 2848: 
 2849: 
 2850:          if (sideBnd != nullptr) {
 2851:             // If the side is on a boundary...
 2852: 
 2853:             // Get the boundary segment
 2854:             const BoundarySegment *sideSegment = sideBnd->segment;
 2855:             const Side *side = sideBnd->side;
 2856: 
 2857:             // Integral I_3
 2858:             if (sideSegment->ifltype != 0) {
 2859:             // Natural or Flather b.c.
 2860: 
 2861:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 2862:                // especially for Flather b.c.
 2863:                double ri3 = 0.0;
 2864:                if (!side->isDry) {
 2865:                   // If the side is not dry
 2866:                   
 2867:                   // Computes the side flux of (uth, vth)
 2868:                   double Vn = 0.0;
 2869:                   for (int k = side->kb; k<nvrt-1; k++) {
 2870:                      // uth, vth in lat/lon frame if ics=2
 2871:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 2872:                      const double vn1 = dot(side->uth[k  ], side->n); // outer normal
 2873:                      const double vn2 = dot(side->uth[k+1], side->n);
 2874: 
 2875:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 2876:                   }
 2877: 
 2878:                   ri3 = 0.5*side->length*Vn;
 2879:                }
 2880: 
 2881:                if (sideSegment->ifltype == -1) { // Flather 1
 2882: 
 2883:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 2884:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 2885: 
 2886:                   const double con0 = (1.0/6.0)*side->length*sqrt(grav*side->depth()); // For coefficient matrix
 2887:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 2888:                   
 2889:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 2890:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 2891: 
 2892:                } 
 2893:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 2894:                   // Reset ri3
 2895:                   ri3 = 0.0;
 2896: 
 2897:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 2898: 
 2899:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 2900: 
 2901:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 2902:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 2903: 
 2904:                   const double con0 = (1.0/6.0)*side->length*tmp*thetai*dt;
 2905:                   node1->addToSparseMatrix(node1, con0*2.0);
 2906:                   node1->addToSparseMatrix(node2, con0);
 2907: 
 2908:                } // if Flather or Discharge
 2909: 
 2910:                node1->qel -= thetai*dt*ri3;
 2911: 
 2912:             } // I_3
 2913:           
 2914: 
 2915:             // Integral I_5
 2916:             if(!side->isDry) {
 2917: 
 2918:                const double Unbar = dot(side->U, side->n);
 2919: 
 2920:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->length*Unbar;
 2921:                
 2922:             } // I_5
 2923: 
 2924:          } // if is boundary side
 2925: 
 2926:       } // for l
 2927: 
 2928:    } // if isbnd
 2929: 
 2930: 
 2931:    printf("44444444 idx_node = %d, node1->qel = %f\n", node1->idx, node1->qel);
 2932: 
 2933: }
 2934: 
 2935: 
 2936: extern "C" {
 2937:    __global__ void backtrackAllNodes(void) {
 2938: 
 2939:       // max/min # of sub-divisions
 2940:       const int ndelt_max = max(1.0, dt/dtb_min);
 2941:       const int ndelt_min = max(1.0, dt/dtb_max); 
 2942: 
 2943:       // Removed all references to swild98 XXX
 2944:       // swild98=0.d0 !init
 2945: 
 2946: 
 2947:       SIDE(side);
 2948: 
 2949:       const int kb = side->kb;
 2950: 
 2951:       printf("backtrackAllNodes: side->idx = %d, nvrt = %d\n", side->idx, nvrt);
 2952: 
 2953:       // Initialize btrack velocities to the actual velocities at the side 
 2954:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 2955: 
 2956: 
 2957:       if (side->isDry) return;
 2958: 
 2959: 
 2960:       // Checks that at least one element is not dry
 2961:       const Element *elem1 = side->elems[0];
 2962:       const Element *elem2 = side->elems[1];
 2963: 
 2964: 
 2965:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 2966:       
 2967:       // XXXXXX
 2968:       // !swild_tmp to store global coord. of the starting side
 2969:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 2970:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 2971:       // !Use sframe2 
 2972:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 2973: 
 2974: 
 2975:       for (int k = kb; k < nvrt; k++) {
 2976:       //  Initialize (xt,yt,zt), nnel and vel.
 2977:       //  For ics=2, the coordinates are in local frames
 2978:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 2979: 
 2980: 
 2981:          const int iadvf = side->iadv();  // Advection flag
 2982: 
 2983:          Point3 xt;
 2984:          if constexpr(ics==1) {
 2985:             xt = side->center3D(k); 
 2986:          }
 2987:          else // lat/lon; in side lat/lon frame
 2988:          {
 2989:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 2990:          // XXX IMPLEMENT THIS
 2991:       //          xt=0.d0
 2992:       //          yt=0.d0
 2993:       //          !centroid coord. for nudging
 2994:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 2995:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 2996:          }  // ics
 2997: 
 2998: 
 2999:          // Velocity at the side (in ll frame for ics, same vertical direction)
 3000:          // XXX IS THIS NECESSARY?
 3001:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 3002: 
 3003:          // If on land or open boundary...
 3004:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3005:          
 3006:          const double vmag = length(toVector2(u_int));
 3007: 
 3008:          if (vmag <= velmin_btrack) {
 3009:             // No activity 
 3010: 
 3011:             side->btu[k] = side->u2[k];
 3012: 
 3013:             
 3014:          } else {  // do btrack
 3015: 
 3016:           
 3017:             // Compute number of sub-divisions based on local gradients 
 3018:             // XXX IS THIS NECESSARY?
 3019:             double suma = 0.0;
 3020:             int icount = 0;
 3021:             for (int ii=0; ii<2; ii++) {
 3022: 
 3023:                const Element *elem = side->elems[ii];
 3024:                  
 3025:                if (elem == nullptr) continue;
 3026: 
 3027:                icount++;
 3028: 
 3029:                // Not strictly along z; in ll frame for ics=2
 3030: 
 3031:                double utmp[4];
 3032:                double vtmp[4];
 3033:                for (int jj = 0; jj < elem->i34; jj++) {
 3034: 
 3035:                   const Node *node = elem->nodes[jj];
 3036: 
 3037:                   if constexpr(ics==1) {
 3038:                      utmp[jj] = node->u2[k].x;
 3039:                      vtmp[jj] = node->u2[k].y;  
 3040:                   } else {
 3041:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3042:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3043:                   }
 3044:                } // for jj
 3045: 
 3046:                const Vector2 grad_u = elem->grad2(utmp); 
 3047:                const Vector2 grad_v = elem->grad2(vtmp);
 3048: 
 3049:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3050:             } // for ii
 3051: 
 3052:             assert(icount > 0 && "Impossible 77");
 3053: 
 3054:             // '4' is somewhat arbitrary
 3055:             const int ndelt = max(ndelt_min, min(ndelt_max, int(suma/icount)*4)); // >=1
 3056: 
 3057:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3058:          
 3059: 
 3060:             Vector3 u_int = {0.0, 0.0, 0.0};
 3061: 
 3062:             side->btrack(k, dt, dtbk, u_int);
 3063: 
 3064:                
 3065:          } // if vmag (do backtrack)
 3066: 
 3067:       } // for j=jmin,nvrt-1
 3068: 
 3069:    }
 3070: } // extern "C"
 3071: 
 3072: template<int nc>
 3073: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3074: 
 3075: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3076: //
 3077: // a,b,c,r: input vectors and are not modified by this program.
 3078: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3079: // r is the r.h.s.
 3080: // n: actual rank of the system.
 3081: // rows in u() and r();
 3082: // u: output with nc columns (transposed to rows)
 3083: // gam: a working array.
 3084: //
 3085: // NOTES:
 3086: // This is a template function that allows for different numbers of columns in the rhs vector.
 3087: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3088: 
 3089:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3090:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3091: 
 3092:    double bet = b[0];
 3093:    if constexpr (nc == 1) {
 3094:       u[0] = rhs[0]/bet;
 3095:    } else {
 3096:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 3097:    }
 3098: 
 3099:    for (int j = 1; j < n; j++) {
 3100:       gam[j] = c[j-1]/bet;
 3101:       bet = b[j] - a[j]*gam[j];
 3102: 
 3103:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3104: 
 3105:       if constexpr (nc == 1) {
 3106:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3107:       } else {
 3108:          for (int k = 0; k < nc; k++) {
 3109:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 3110:          }
 3111:       }
 3112:    }
 3113: 
 3114:    // Back-substitution
 3115:    for (int j=n-1; j>=1; j--) {
 3116:       if constexpr (nc == 1) {
 3117:          u[j] = u[j] - gam[j+1]*u[j-1];
 3118:       } else {
 3119:          for (int k = 0; k < nc; k++) {
 3120:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 3121:          }
 3122:       }
 3123:    }
 3124: }
 3125: 
 3126: 
 3127: 
 3128: 
 3129: // Helper function that contains the core algorithm
 3130: template<typename XAccessor, typename YAccessor>
 3131: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3132:                                     double  yp_top, double  yp_bot, 
 3133:                                     CubicSpline &spline) {
 3134:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3135:    // 
 3136:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3137:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3138:    //
 3139:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3140:    // 
 3141:    // Inputs: 
 3142:    //            n: dimension for x etc; # of data pts (>=2);
 3143:    //            getX, getY: functions to access x,y coordinates
 3144:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3145:    //     Output: 
 3146:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3147: 
 3148:    const int n = k2 - k1 + 1;
 3149:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3150: 
 3151:    // Allocate memory for the splines
 3152:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3153:    spline.x   = new double[n];
 3154:    spline.y   = new double[n];
 3155:    spline.yp  = new double[n];
 3156:    spline.ypp = new double[n];
 3157: 
 3158:    for (int k=k1; k<=k2; k++) {
 3159:       spline.x[k] = getX(k);
 3160:       spline.y[k] = getY(k);
 3161:    }
 3162: 
 3163:    // This is to simplify expressions later
 3164:    double *x = spline.x;
 3165:    double *y = spline.y;
 3166: 
 3167:    double *a = nullptr;
 3168:    double *b = nullptr;
 3169:    double *c = nullptr;
 3170:    double *gam = nullptr;
 3171:    double *rhs = nullptr;
 3172:    
 3173: 
 3174:       a = new double[n];   // Lower diagonal
 3175:       b = new double[n];   // Diagonal
 3176:       c = new double[n];   // Upper diagonal
 3177:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3178:       rhs = new double[n]; // Right-hand side
 3179: 
 3180:    for (int k=k1; k<=k2; k++) {
 3181:       if (k == k1) {
 3182:          // Bottom level
 3183:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3184:          b[k] = (x[k+1] - x[k])/3.0;
 3185:          c[k] = b[k]/2.0;
 3186:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3187:       } else if (k == n - 1) {
 3188:          // Top level (surface)
 3189:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3190:          b[k] = (x[k] - x[k-1])/3.0;
 3191:          a[k] = b[k]/2.0;
 3192:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3193:       } else {
 3194:          // Intermediate levels
 3195:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3196:          b[k] = (x[k+1] - x[k-1])/3.0;
 3197:          a[k] = (x[k  ] - x[k-1])/6.0;
 3198:          c[k] = (x[k+1] - x[k  ])/6.0;
 3199:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3200:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3201:       }
 3202:    }
 3203: 
 3204:    // Solve the tridiagonal system
 3205:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3206:    
 3207:    spline.yp[k1] = yp_bot;
 3208:    spline.yp[k2] = yp_top;
 3209: 
 3210:    // Compute rest of 1st derivatives using the splines
 3211:    for (int k=k1+1; k<k2; k++) {
 3212:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3213:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3214:    }
 3215:    
 3216:    delete[] a;
 3217:    delete[] b;
 3218:    delete[] c;
 3219:    delete[] gam;
 3220:    delete[] rhs;
 3221: 
 3222: }
 3223: 
 3224: // Array version
 3225: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3226:                                 double y_top, double y_bot, 
 3227:                                 CubicSpline &spline) {
 3228:    auto getX = [x] (int k) { return x[k]; };
 3229:    auto getY = [y] (int k) { return y[k]; };
 3230:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3231: }
 3232: 
 3233: // Lambda version - allows custom access patterns
 3234: template<typename XFunc, typename YFunc>
 3235: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3236:                                 double y_top, double y_bot,
 3237:                                 CubicSpline &spline) {
 3238:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3239: }
 3240: 
 3241: 
 3242: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 3243: {
 3244:    assert("Not implemented");
 3245: 
 3246:    return 0.0;
 3247: }
