 3179:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3180: 
 3181:       NODE_BND(nodeBnd);
 3182: 
 3183:       Node *node = nodeBnd->node;
 3184: 
 3185:       printf("computeTidalPotential: nodeIdx = %d, ntip = %d\n", node->idx, ntip);
 3186:       node->ETP = 0.0;
 3187: 
 3188:       for (int j=0; j<ntip; j++) {
 3189: 
 3190:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3191:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3192:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3193: 
 3194:          if constexpr(iloadtide==1) { // loading tide
 3195:             assert(false && "Loading tide not implemented");
 3196:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3197:          }
 3198:          
 3199:       }
 3200:       
 3201:    }
