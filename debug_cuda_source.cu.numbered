 5133: __global__ void getStructSizes(int* sizes)  {
 5134:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 5135:       sizes[0] = (int)sizeof(Node);
 5136:       sizes[1] = (int)sizeof(Element);
 5137:       sizes[2] = (int)sizeof(Side);
 5138:       sizes[3] = (int)sizeof(NodeBoundary);
 5139:       sizes[4] = (int)sizeof(SideBoundary);
 5140:       sizes[5] = (int)sizeof(BoundarySegment);
 5141: }
