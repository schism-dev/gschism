 1963: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 1964:                 double *node_coords, double *wind_rotate_angle, 
 1965:                 int *isdel, int *isidenode, int *isbnd,
 1966:                 int *nond, int *nlnd, int *iond, int *ilnd,
 1967:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 1968:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 1969:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 1970:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 1971:                 int *localNodePart,     int *localElemPart,     int *localSidePart) {
 1972: 
 1973:    printf("Populating mesh for partition %d, %d, %d\n", partNum, nond, nlnd);
 1974: 
 1975:    // Horizontal grid
 1976:    printf("Processing %d nodes\n", np);    
 1977:    int idxNodeBoundary = 0;  
 1978:    for (int i = 0; i < np; i++)
 1979:    {
 1980:       Node &node = localNodeData[i];
 1981: 
 1982:       const int idxStart = nodeNeighNodesStart[i];
 1983:       const int idxEnd   = nodeNeighNodesStart[i+1];
 1984:       node.numNodes = idxEnd - idxStart;
 1985:       node.nodes = (Node **)(nodeNeighNodes + idxStart*sizeof(Node *));
 1986:       node.idx = i;
 1987: 
 1988:       for (int idx = idxStart; idx < idxEnd; idx++) {
 1989:          int idxNode = nodeNeighNodesIndices[idx];
 1990:          Node *node_ptr = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 1991: 
 1992:          nodeNeighNodes[idxNode] = node_ptr;
 1993:          node.nodes = &(nodeNeighNodes[idxNode]);
 1994:       }
 1995: 
 1996:       // Element **elements; // pointer to the elements connected to this node
 1997:       // int numElements;   // number of elements shared by this node
 1998: 
 1999:       node.p.x = node_coords[i * 3];
 2000:       node.p.y = node_coords[i * 3 + 1];
 2001:       node.p.z = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2002:       node.depth = node_coords[i * 3 + 2];
 2003: 
 2004:       // Links the node to the boundary information
 2005:       if (isbnd[i] >= 0) {
 2006:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2007:          if (isbnd[i]>0) {
 2008: 
 2009:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2010:             node.nodeBnd->segment->ifltype = isbnd[i];
 2011: 
 2012:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2013:             node.nodeBnd->segment->clen  = nan("1");
 2014:             node.nodeBnd->segment->carea = nan("1");
 2015: 
 2016:          }
 2017:          else {
 2018:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2019:          }
 2020:          
 2021:          idxNodeBoundary++;
 2022:       }
 2023:       else {
 2024:          node.nodeBnd = nullptr;
 2025:       }
 2026: 
 2027: // XXXX
 2028: constexpr double rot_per = 3000.0;
 2029: constexpr double rot_f = 2.0*pi/rot_per;
 2030: for (int k = 0; k < nvrt; k++) {node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0};}
 2031: // XXXXX
 2032:    }
 2033: 
 2034:    nbp = idxNodeBoundary;
 2035: 
 2036:    printf("Processing %d sides\n", ns);
 2037:    int idxSideBoundary = 0;
 2038:    for (int i = 0; i < ns; i++)
 2039:    {
 2040:       Side &side = localSideData[i];
 2041:       side.idx = i;
 2042:       // finding the pointer to the nodes that form the side
 2043:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2044:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2045: 
 2046:       const int locidx_n1 = localNodeIndices[idx_n1];
 2047:       const int locidx_n2 = localNodeIndices[idx_n2];
 2048:       const int part_n1 =   localNodePart[idx_n1];
 2049:       const int part_n2 =   localNodePart[idx_n2];
 2050: 
 2051:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2052:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2053: 
 2054:       // Normal vector to the side
 2055:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2056:       const double norm = sqrt(dot(side.n, side.n));
 2057:       side.n = side.n/norm;
 2058: 
 2059:       // Side boundary type
 2060:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 2061:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 2062:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2063:       
 2064:       if (n1bnd != nullptr || n2bnd != nullptr) 
 2065:       {
 2066:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2067:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2068:          else                  side.sideBnd->segment = n2bnd->segment;
 2069:          side.sideBnd->side = &side;
 2070:          idxSideBoundary++;
 2071:       }
 2072:       else side.sideBnd = nullptr;
 2073: 
 2074:       // finding the pointer to the elements that share the side
 2075:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2076:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2077: 
 2078:       if (idx_e1 > -1) {
 2079:          const int locidx_e1 = localElemIndices[idx_e1];
 2080:          const int part_e1 =  localElemPart[idx_e1];
 2081:          side.elems[0] = (Element *)&(elems[part_e1][locidx_e1]);
 2082:       }
 2083:       else {
 2084:          side.elems[0] = nullptr;
 2085:       }
 2086: 
 2087:       if (idx_e2 > -1) {
 2088:          const int locidx_e2 = localElemIndices[idx_e2];
 2089:          const int part_e2 =  localElemPart[idx_e2];
 2090:          side.elems[1] = (Element *)&(elems[part_e2][locidx_e2]);
 2091:       }
 2092:       else {
 2093:          side.elems[1] = nullptr;
 2094:       }
 2095: 
 2096: 
 2097: 
 2098:       // Compute the center of the side
 2099:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2100: 
 2101: // XXXX
 2102: constexpr double rot_per=3000.0;
 2103: constexpr double rot_f=2.0*pi/rot_per;
 2104: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2105: // XXXXX      
 2106: 
 2107:       // Compute the z level at the center of the side
 2108:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->znl[k] + side.n2->znl[k]);
 2109: 
 2110:       // Compute the length of the side
 2111:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2112:       side.length = sqrt(dot(vLen, vLen));
 2113: 
 2114:    }
 2115: 
 2116:    printf("Processing %d elements\n", ne);
 2117:    for (int i = 0; i < ne; i++)
 2118:    {
 2119:       Element &elem = localElemData[i];
 2120:       elem.idx = i;
 2121:       for (int j = 0; j < i34[i]; j++) {
 2122:          const int idxNode = elnode[i*4 + j];  
 2123:          const int idxSide = elside[i*4 + j];
 2124:          
 2125:          elem.nodes[j] = (Node *)&(nodes[localElemPart[idxNode]][localElemIndices[idxNode]]);
 2126:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2127: 
 2128:          // Find the neighboring element  
 2129:          if (elem.sides[j]->elems[0] == &elem) {
 2130:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2131:          }
 2132:          else {
 2133:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2134:          }
 2135:       }
 2136: 
 2137:       
 2138: 
 2139:       elem.i34 = i34[i];
 2140:       elem.wind_angle = wind_rotate_angle[i];
 2141: 
 2142:       // Compute the centroid of the element and its depth
 2143:       Vector2 center = {0.0, 0.0};
 2144:       elem.depth = 0.0;
 2145:       for (int j = 0; j < i34[i]; j++) {
 2146:          center += elem.nodes[j]->p2()/i34[i];
 2147:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2148:       }
 2149:       elem.center.x = center.x;
 2150:       elem.center.y = center.y;
 2151:       
 2152:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2153:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2154: 
 2155:       elem.area = elem.computeSignedArea(); 
 2156:       elem.radius = sqrt(elem.area)/pi; 
 2157:       
 2158:       // Determines which way the normal vector to each side is oriented.
 2159:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2160:       for (int j = 0; j < i34[i]; j++)  
 2161:       {
 2162:          if (elem.sides[j]->elems[0] == &elem) {
 2163:             elem.ssign[j] =  1.0;
 2164:          }
 2165:          else {
 2166:             elem.ssign[j] = -1.0;
 2167:          }
 2168: 
 2169:       }
 2170: 
 2171:       // Derivatives of shape functions
 2172:       //  For ics=2, this is done inside element/ll frame XXX
 2173:       //  For quads, the derivative is evaluated at centroid
 2174:       const int i34 = elem.i34;
 2175:       for (int j = 0; j < i34; j++) {
 2176:          const double area = elem.area;
 2177:          const int id2 = elem.nxq(1 + j);
 2178:          const int id3 = elem.nxq(2 + j);
 2179:          const int id4 = elem.nxq(3 + j);
 2180:          if (elem.isTri()) {
 2181:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2182:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2183:             // da1/dx = (y1 - y2)/(2*area)
 2184:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2185:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2186:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2187:          }
 2188:          else  { // Quad; evaluate at centroid
 2189:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2190:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2191:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2192:          } // if Tri
 2193: 
 2194:       } // for j
 2195: 
 2196:    }
 2197: 
 2198: 
 2199: 
 2200:    
 2201: }
 2202: 
 2203: 
 2204: __global__ void setupCoefficientMatrixAndRHS(double time) {
 2205: // Setup coefficient matrix, sparsem, for the shallow water wave equation
 2206: // No elevation essential b.c. are imposed yet but other b.c. is imposed
 2207: // 
 2208: // This kernel is called for all nodes.
 2209: 
 2210:    int in = 1; //XXX blockIdx.x * blockDim.x + threadIdx.x;
 2211: 
 2212:    Node *node1 = &(mesh->localNodeData[in]);
 2213: 
 2214: 
 2215:    node1->clearMatrixRow();
 2216:    node1->qel = 0.0;
 2217: 
 2218:    // THIS IS FOR STRUCTURES XXX
 2219:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 2220: 
 2221: 
 2222:    for (int j=0; j<node1->numElements; j++) {
 2223:       // For each element connected to the node...
 2224: 
 2225:       Element *elem = node1->elements[j];
 2226: 
 2227: 
 2228:       // Compute the average gravity
 2229:       const double grav3 = elem->mean(&Node::grav2);
 2230: 
 2231:       // Look at the documentation for the description of the terms in the following integrals
 2232: 
 2233:       // Integral I_1 
 2234:       // \bar{\breve{H}} 
 2235:       const double hhatb = elem->mean(&Side::hhat);        
 2236: 
 2237:       assert((hhatb >= 0.0 || ihh != 1) && "Invalid hhat");
 2238: 
 2239:       const int id1 = elem->nodeLocalIdx(node1); 
 2240:       const double area = elem->area;
 2241: 
 2242:       if (elem->isTri()) {
 2243: 
 2244:          // To clarify the notation in this section: 
 2245:          //   i standtimes for the node under consideration (node1)
 2246:          //   j (node2) and k (node3) are the other nodes of the triangle.
 2247:          const int id2 = elem->nxq(1 + id1);
 2248:          const int id3 = elem->nxq(2 + id1);
 2249:          Node *node2 = elem->nodes[id2];
 2250:          Node *node3 = elem->nodes[id3];
 2251: 
 2252:          const Point2 x1 = node1->p2();
 2253:          const Point2 x2 = node2->p2();
 2254:          const Point2 x3 = node3->p2();
 2255: 
 2256:          // integral of phi_i*phi_j
 2257:          const double ipp_ii = (1.0/6.0 )*area;
 2258:          const double ipp_ij = (1.0/12.0)*area;
 2259:          const double ipp_ik = (1.0/12.0)*area;
 2260: 
 2261:          // integral of [(grad phi_i) * (grad phi_j)]
 2262:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 2263:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 2264:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 2265: 
 2266:          // Computes the different components of integral I_1 of each node with respect to node i.
 2267:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 2268:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 2269:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 2270: 
 2271:          node1->addToSparseMatrix(node1, I1_ii);
 2272:          node1->addToSparseMatrix(node2, I1_ij); 
 2273:          node1->addToSparseMatrix(node3, I1_ik);
 2274:      
 2275:       }
 2276:       else { // Quad
 2277:          // XXX IMPLEMENT THIS
 2278:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2279:       } 
 2280: 
 2281:  
 2282:       // Integral I_4
 2283:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 2284:       // Where
 2285:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 2286: 
 2287:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 2288:       // of U over the element.
 2289:       Vector2 Umean = {0.0, 0.0};
 2290:       for (int m=0; m<elem->i34; m++) {      
 2291:          const Side *side = elem->sides[m];
 2292: 
 2293:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 2294:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 2295:       }
 2296:       Umean = Umean/elem->i34;
 2297: 
 2298:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 2299: 
 2300:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 2301:       const double I_4_1 = dot(gradPhi_1, Umean);
 2302: 
 2303:       // Integral of \nabla\phi_i \cdot \pmb{E}
 2304:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 2305:      
 2306:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);
 2307:       
 2308: 
 2309:       // Additional terms 
 2310:       double vnorm = 0.0;
 2311:       if (imm == 2)  { // Pre-compute vnorm on the element
 2312:          Vector3 ubed;
 2313:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 2314: 
 2315:          Vector3 gradP(0.0, 0.0, 1.0);
 2316:          for (int m=0; m < elem->i34; m++) {
 2317:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 2318:            gradP += toVector3(gradP_2D, 0.0);
 2319:          }   
 2320:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 2321:       } // imm==2
 2322: 
 2323:       if (elem->isTri()) {
 2324:          for (int l=0; l<3; l++) {
 2325:            double fac;
 2326: 
 2327:            Node *node = elem->nodes[l];
 2328: 
 2329:            (node == node1)? fac=2.0 : fac=1.0;
 2330: 
 2331:            if (imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 2332:            else        node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 2333:            
 2334:          }
 2335: 
 2336:          if (elem->idry == 0) {
 2337:            const Vector2 gradEta = elem->nodes[0]->eta2*elem->gradPhi[0] +
 2338:                                    elem->nodes[1]->eta2*elem->gradPhi[1] +
 2339:                                    elem->nodes[2]->eta2*elem->gradPhi[2];
 2340: 
 2341:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 2342:          }
 2343: 
 2344:       } // isTri
 2345:       else { // isQuad
 2346:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2347:          // for (int l=0; l<4; l++) {
 2348:          //   const Node *node = elem->nodes[l];
 2349: 
 2350:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 2351:          //   else        tmp2 = node->bdef2 - node->bdef1;
 2352: 
 2353:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 2354:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 2355:          // }
 2356: 
 2357:       } // isQuad
 2358: 
 2359: 
 2360: 
 2361:       node1->qel += (dt/elem->i34)*elem->vsource;
 2362: 
 2363:    } // for all elements connected to the node
 2364:    
 2365: 
 2366: 
 2367:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 2368:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 2369:    NodeBoundary *nodeBnd = node1->nodeBnd;
 2370:    if (nodeBnd != nullptr)  { 
 2371:       // If it is an open boundary node...
 2372: 
 2373:       // At least one open bnd side, maybe two
 2374:       for (int l=0; l<2; l++) { 
 2375: 
 2376:          // Gets each of the sides sharing the node. 
 2377:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 2378: 
 2379:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 2380: 
 2381:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 2382: 
 2383: 
 2384:          if (sideBnd != nullptr) {
 2385:             // If the side is on a boundary...
 2386: 
 2387:             // Get the boundary segment
 2388:             const BoundarySegment *sideSegment = sideBnd->segment;
 2389:             const Side *side = sideBnd->side;
 2390: 
 2391:             // Integral I_3
 2392:             if (sideSegment->ifltype != 0) {
 2393:             // Natural or Flather b.c.
 2394: 
 2395:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 2396:                // especially for Flather b.c.
 2397:                double ri3 = 0.0;
 2398:                if (side->idry != 1) {
 2399:                   // If the side is not dry
 2400:                   
 2401:                   // Computes the side flux of (uth, vth)
 2402:                   double Vn = 0.0;
 2403:                   for (int k = side->kb; k<nvrt-1; k++) {
 2404:                      // uth, vth in lat/lon frame if ics=2
 2405:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 2406:                      const double vn1 = dot(side->uth[k  ], side->n); // outer normal
 2407:                      const double vn2 = dot(side->uth[k+1], side->n);
 2408: 
 2409:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 2410:                   }
 2411: 
 2412:                   ri3 = 0.5*side->length*Vn;
 2413:                }
 2414: 
 2415:                if (sideSegment->ifltype == -1) { // Flather 1
 2416: 
 2417:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 2418:                   assert(side->depth > 0.0 && "Negative depth at Flather boundary");
 2419: 
 2420:                   const double con0 = (1.0/6.0)*side->length*sqrt(grav*side->depth); // For coefficient matrix
 2421:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 2422:                   
 2423:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 2424:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 2425: 
 2426:                } 
 2427:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 2428:                   // Reset ri3
 2429:                   ri3 = 0.0;
 2430: 
 2431:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 2432: 
 2433:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 2434: 
 2435:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 2436:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 2437: 
 2438:                   const double con0 = (1.0/6.0)*side->length*tmp*thetai*dt;
 2439:                   node1->addToSparseMatrix(node1, con0*2.0);
 2440:                   node1->addToSparseMatrix(node2, con0);
 2441: 
 2442:                } // if Flather or Discharge
 2443: 
 2444:                node1->qel -= thetai*dt*ri3;
 2445: 
 2446:             } // I_3
 2447:           
 2448: 
 2449:             // Integral I_5
 2450:             if(side->idry != 1) {
 2451: 
 2452:                const double Unbar = dot(side->U, side->n);
 2453: 
 2454:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->length*Unbar;
 2455:                
 2456:             } // I_5
 2457: 
 2458:          } // if is boundary side
 2459: 
 2460:       } // for l
 2461: 
 2462:    } // if isbnd
 2463: 
 2464: }
 2465: 
 2466: 
 2467: 
 2468: __device__ void backtrackAllNodes(void) {
 2469: 
 2470:    // max/min # of sub-divisions
 2471:    const int ndelt_max = max(1.0, dt/dtb_min);
 2472:    const int ndelt_min = max(1.0, dt/dtb_max); 
 2473: 
 2474:    // Removed all references to swild98 XXX
 2475:    // swild98=0.d0 !init
 2476: 
 2477:    SIDE(side);
 2478: 
 2479:    if (side - mesh->localSideData >= mesh->ns) return;
 2480: 
 2481:    const int kb = side->kb;
 2482:    for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 2483: 
 2484:    if (side->idry == 1) return;
 2485: 
 2486:    // Checks that at least one element is not dry
 2487:    const Element *elem1 = side->elems[0];
 2488:    const Element *elem2 = side->elems[1];
 2489:    assert ((elem1 != nullptr && !(elem1->idry)) || (elem2 != nullptr && !(elem2->idry)) && "backtrackAllNodes: non dry side without two dry elements.");
 2490: 
 2491:    // XXXXXX
 2492:    // !swild_tmp to store global coord. of the starting side
 2493:    // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 2494:    // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 2495:    // !Use sframe2 
 2496:    // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 2497: 
 2498: 
 2499:    for (int k = kb; k < nvrt; k++) {
 2500:    //  Initialize (xt,yt,zt), nnel and vel.
 2501:    //  For ics=2, the coordinates are in local frames
 2502:    //  Caution! nnel must be initialized inside this loop as it is updated inside.
 2503: 
 2504: 
 2505:       const int iadvf = side->iadv();  // Advection flag
 2506: 
 2507:       Point3 xt;
 2508:       if constexpr(ics==1) {
 2509:          xt = side->center3D(k); 
 2510:       }
 2511:       else // lat/lon; in side lat/lon frame
 2512:       {
 2513:       // XXX IMPLEMENT THIS
 2514:    //          xt=0.d0
 2515:    //          yt=0.d0
 2516:    //          !centroid coord. for nudging
 2517:    //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 2518:    //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 2519:       }  // ics
 2520: 
 2521: 
 2522:       // Velocity at the side (in ll frame for ics, same vertical direction)
 2523:       // XXX IS THIS NECESSARY?
 2524:       Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 2525: 
 2526:       // If on land or open boundary...
 2527:       const bool ifl_bnd =  (side->sideBnd != nullptr);
 2528:       
 2529:       const double vmag = length(toVector2(u_int));
 2530: 
 2531:       if (vmag <= velmin_btrack) {
 2532:          // No activity 
 2533: 
 2534:          side->btu[k] = side->u2[k];
 2535: 
 2536: 
 2537:       } else {  // do btrack
 2538: 
 2539:          // Compute number of sub-divisions based on local gradients 
 2540:          // XXX IS THIS NECESSARY?
 2541:          double suma = 0.0;
 2542:          int icount = 0;
 2543:          for (int ii=0; ii<2; ii++) {
 2544: 
 2545:             const Element *elem = side->elems[ii];
 2546:               
 2547:             if (elem == nullptr) continue;
 2548: 
 2549:             icount++;
 2550: 
 2551:             // Not strictly along z; in ll frame for ics=2
 2552: 
 2553:             double utmp[4];
 2554:             double vtmp[4];
 2555:             for (int jj = 0; jj < elem->i34; jj++) {
 2556: 
 2557:                const Node *node = elem->nodes[jj];
 2558: 
 2559:                if constexpr(ics==1) {
 2560:                   utmp[jj] = node->u2[k].x;
 2561:                   vtmp[jj] = node->u2[k].y;  
 2562:                } else {
 2563:                   // XXX IMPLEMENT THIS
 2564:                   // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 2565:                }
 2566:             } // for jj
 2567: 
 2568:             const Vector2 grad_u = elem->grad(utmp); 
 2569:             const Vector2 grad_v = elem->grad(vtmp);
 2570: 
 2571:             suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 2572:          } // for ii
 2573: 
 2574:          assert(icount > 0 && "Impossible 77");
 2575: 
 2576:          // '4' is somewhat arbitrary
 2577:          const int ndelt = max(ndelt_min, min(ndelt_max, int(suma/icount)*4)); // >=1
 2578:          const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 2579: 
 2580: 
 2581:          // Perturb starting pt to avoid underflow 
 2582:          // XXX I don't think this is needed with the current implementation
 2583:          // eps=btrack_nudge
 2584:          // if constexpr(ics==1) {
 2585:          //    xt=(1.d0-eps)*xt+eps*xctr(nnel)
 2586:          //    yt=(1.d0-eps)*yt+eps*yctr(nnel)
 2587:          // } else { //lat/lon
 2588:          //    xt=(1.d0-eps)*xt+eps*xctr2
 2589:          //    yt=(1.d0-eps)*yt+eps*yctr2
 2590:          // } // ics
 2591: 
 2592:       
 2593:          // call btrack(l,ipsgb,ifl_bnd,j,iadvf,swild_tmp,swild10_tmp, dtbk,time_rm,time_rm2,uuint,vvint,wwint,nnel,jlev,xt,yt,zt,swild3,ltmp)
 2594: 
 2595:             
 2596:       } // if vmag (do backtrack)
 2597: 
 2598:    } // for j=jmin,nvrt-1
 2599: 
 2600: }
 2601: 
 2602: template<int nc>
 2603: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 2604: 
 2605: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 2606: //
 2607: // a,b,c,r: input vectors and are not modified by this program.
 2608: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 2609: // r is the r.h.s.
 2610: // n: actual rank of the system.
 2611: // rows in u() and r();
 2612: // u: output with nc columns (transposed to rows)
 2613: // gam: a working array.
 2614: //
 2615: // NOTES:
 2616: // This is a template function that allows for different numbers of columns in the rhs vector.
 2617: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 2618: 
 2619:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 2620:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 2621: 
 2622:    double bet = b[0];
 2623:    if constexpr (nc == 1) {
 2624:       u[0] = rhs[0]/bet;
 2625:    } else {
 2626:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 2627:    }
 2628: 
 2629:    for (int j = 1; j < n; j++) {
 2630:       gam[j] = c[j-1]/bet;
 2631:       bet = b[j] - a[j]*gam[j];
 2632: 
 2633:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 2634: 
 2635:       if constexpr (nc == 1) {
 2636:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 2637:       } else {
 2638:          for (int k = 0; k < nc; k++) {
 2639:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 2640:          }
 2641:       }
 2642:    }
 2643: 
 2644:    // Back-substitution
 2645:    for (int j=n-1; j>=1; j--) {
 2646:       if constexpr (nc == 1) {
 2647:          u[j] = u[j] - gam[j+1]*u[j-1];
 2648:       } else {
 2649:          for (int k = 0; k < nc; k++) {
 2650:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 2651:          }
 2652:       }
 2653:    }
 2654: }
 2655: 
 2656: 
 2657: 
 2658: 
 2659: // Helper function that contains the core algorithm
 2660: template<typename XAccessor, typename YAccessor>
 2661: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 2662:                                     double  yp_top, double  yp_bot, 
 2663:                                     CubicSpline &spline) {
 2664:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 2665:    // 
 2666:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 2667:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 2668:    //
 2669:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 2670:    // 
 2671:    // Inputs: 
 2672:    //            n: dimension for x etc; # of data pts (>=2);
 2673:    //            getX, getY: functions to access x,y coordinates
 2674:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 2675:    //     Output: 
 2676:    //            spline (CubicSpline): spline structure with x,y,y',y''
 2677: 
 2678:    const int n = k2 - k1 + 1;
 2679:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 2680: 
 2681:    // Allocate memory for the splines
 2682:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 2683:    spline.x   = new double[n];
 2684:    spline.y   = new double[n];
 2685:    spline.yp  = new double[n];
 2686:    spline.ypp = new double[n];
 2687: 
 2688:    for (int k=k1; k<=k2; k++) {
 2689:       spline.x[k] = getX(k);
 2690:       spline.y[k] = getY(k);
 2691:    }
 2692: 
 2693:    // This is to simplify expressions later
 2694:    double *x = spline.x;
 2695:    double *y = spline.y;
 2696: 
 2697:    double *a = nullptr;
 2698:    double *b = nullptr;
 2699:    double *c = nullptr;
 2700:    double *gam = nullptr;
 2701:    double *rhs = nullptr;
 2702:    
 2703: 
 2704:       a = new double[n];   // Lower diagonal
 2705:       b = new double[n];   // Diagonal
 2706:       c = new double[n];   // Upper diagonal
 2707:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 2708:       rhs = new double[n]; // Right-hand side
 2709: 
 2710:    for (int k=k1; k<=k2; k++) {
 2711:       if (k == k1) {
 2712:          // Bottom level
 2713:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 2714:          b[k] = (x[k+1] - x[k])/3.0;
 2715:          c[k] = b[k]/2.0;
 2716:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 2717:       } else if (k == n - 1) {
 2718:          // Top level (surface)
 2719:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 2720:          b[k] = (x[k] - x[k-1])/3.0;
 2721:          a[k] = b[k]/2.0;
 2722:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 2723:       } else {
 2724:          // Intermediate levels
 2725:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 2726:          b[k] = (x[k+1] - x[k-1])/3.0;
 2727:          a[k] = (x[k  ] - x[k-1])/6.0;
 2728:          c[k] = (x[k+1] - x[k  ])/6.0;
 2729:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 2730:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 2731:       }
 2732:    }
 2733: 
 2734:    // Solve the tridiagonal system
 2735:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 2736:    
 2737:    spline.yp[k1] = yp_bot;
 2738:    spline.yp[k2] = yp_top;
 2739: 
 2740:    // Compute rest of 1st derivatives using the splines
 2741:    for (int k=k1+1; k<k2; k++) {
 2742:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 2743:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 2744:    }
 2745:    
 2746:    delete[] a;
 2747:    delete[] b;
 2748:    delete[] c;
 2749:    delete[] gam;
 2750:    delete[] rhs;
 2751: 
 2752: }
 2753: 
 2754: // Array version
 2755: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 2756:                                 double y_top, double y_bot, 
 2757:                                 CubicSpline &spline) {
 2758:    auto getX = [x] (int k) { return x[k]; };
 2759:    auto getY = [y] (int k) { return y[k]; };
 2760:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 2761: }
 2762: 
 2763: // Lambda version - allows custom access patterns
 2764: template<typename XFunc, typename YFunc>
 2765: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 2766:                                 double y_top, double y_bot,
 2767:                                 CubicSpline &spline) {
 2768:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 2769: }
