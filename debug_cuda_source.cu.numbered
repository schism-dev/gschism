  730: struct Node {
  731: 
  732:    // Geometry information
  733:    int idx;        // Index of the node
  734:    Node **nodes;   // pointer to the nodes that are neighbors of this node (there is no guarantee that they are connected)
  735:    int numNodes;   // number of nodes neighbors of this node
  736: 
  737:    Element **elements; // pointer to the elements that share this node
  738:    int numElements;   // number of elements that share this node
  739: 
  740:    Point3 p;
  741:    Vector3 u2[nvrt];
  742:    double znl[nvrt];
  743:    double lon, lat;
  744:    double depth;
  745: 
  746:    int kb;       // Bottom index of the node
  747: 
  748:    int idry;     // True if the node is dry
  749: 
  750:    int iadv;     // Advection flag
  751: 
  752:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
  753: 
  754:    // Physical information
  755:    Tracers tr_nd0[nvrt]; // Initial tracer conc. at nodes
  756: 
  757:    double rho[nvrt];     // Density
  758: 
  759:    double eta1; // Elevation at nodes at previous timestep
  760:    double eta2; // Elevation at nodes at current timestep
  761: 
  762:    
  763:    double pr;    // Air pressure
  764:    double grav2; // Gravity 
  765:    
  766:    Vector2 dav;  // Depth averaged velocity
  767: 
  768:    Vector2 tau; // Wind stress vector
  769: 
  770:    // Vegetation parameters
  771:    double veg_h;
  772:    double veg_nv;
  773:    double veg_di;
  774:    double veg_Cd;
  775:    double veg_h_unbent;
  776:    double veg_di_unbent;
  777:    double veg_nv_unbent;
  778:    double veg_alpha_vert_mean;
  779:    double veg_alpha0;
  780:    double veg_alpha3D[nvrt];
  781: 
  782:    // Bottom drag parameters
  783:    double Cd;       // Bottom drag coefficient
  784:    double rough;    // Bottom roughness length
  785:    Vector2 tau_bot; // Bottom stress vector
  786: 
  787:    double bdef1; // Bottom deformation at previous timestep
  788:    double bdef2; // Bottom deformation at current timestep
  789: 
  790:    double qel; // RHS
  791: 
  792:    __host__ __device__ Point2 p2(void) const { return {p.x, p.y}; }
  793: 
  794:    __host__ __device__ double sigmaTransitionDepth(void) const;
  795: 
  796:    __inline__ __device__ double Dz(int k) const { return znl[k] - znl[k-1]; }
  797:    __inline__ __device__ double htot(void) const { return eta2 + depth; }
  798:    __inline__ __device__ double zTopCanopy(void) const { return znl[kb] + veg_h; } 
  799: 
  800:    __device__ void clearMatrixRow(void) {
  801:       // Clear the matrix row for this node
  802:       printf("NOT IMPLEMENTED: clearMatrixRow\n");
  803:    }
  804: 
  805:    __device__ void addToSparseMatrix(Node const *node, double value) {
  806:       // Add the value to the sparse matrix for this node
  807:       printf("NOT IMPLEMENTED: addToSparseMatrix\n");
  808:    }
  809: 
  810: #ifdef BACKTRACKING
  811:    __device__ void updateZCoordData() {
  812:    // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
  813: 
  814:       // Check if node is wet
  815:       idry = (depth + eta2 <= h0);  // XXX Check if we are doing this elsewhere
  816: 
  817:       if (idry) return;
  818: 
  819:       if constexpr(ivcor == 2) {  // SZ coordinates
  820:          
  821:          // Compute bottom level index
  822:          if (depth <= mesh->h_s) {
  823:                kb = mesh->nzlevels;
  824:          } else {
  825:                kb = -1;
  826:                for (int i = 0; i < mesh->kz-1; i++) {
  827:                   if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
  828:                      kb = i;
  829:                      break;
  830:                   }
  831:                }
  832:          }
  833:       } 
  834:       else if (ivcor == 1) {  // Localized sigma
  835:          // Do nothing
  836:       }
  837: 
  838:    }
  839: #endif   
  840: 
  841:    __device__ double compZCoord(int k) const;
  842: 
  843: 
  844: 
  845: };
