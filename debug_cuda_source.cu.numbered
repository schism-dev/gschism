 2934: __device__ void computeVerticallyIntegratedVelocity(void) {
 2935: 
 2936:    SIDE(side);
 2937: 
 2938:    side->U = {0.0, 0.0}; 
 2939:       
 2940:    if(side->idry) return;
 2941: 
 2942:    const Node *node1 = side->n1;
 2943:    const Node *node2 = side->n2;
 2944: 
 2945:    // Vertically integrated velocity U (in ll if ics=2)
 2946:    for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 2947:       side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 2948:    }
 2949: 
 2950: }
