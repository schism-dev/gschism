 1252:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1253:       // Compute the different time ramps used in the code 
 1254:       // This function is performed by just one thread
 1255: 
 1256:       if constexpr(ibc == 0) {
 1257:          if (drampbc > 0.0) {
 1258:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1259:          } else {
 1260:             rampbc = 1.0;
 1261:          }
 1262: 
 1263:          if (nws != 0 && drampwind > 0.0) {
 1264:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1265:          } else {
 1266:             rampwind = 1.0;
 1267:          }
 1268:       }
 1269: 
 1270:       if (drampwafo > 0.0) {
 1271:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1272:       } else {
 1273:          rampwafo = 1.0;
 1274:       }
 1275: 
 1276:       // For source/sinks
 1277:       if (if_source && dramp_ss > 0.0) {
 1278:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1279:       } else {
 1280:          ramp_ss = 1.0;
 1281:       }
 1282: 
 1283:       if (dramp > 0.0) {
 1284:          ramp = tanh(2.0*time/86400.0/dramp);
 1285:       } else {
 1286:          ramp = 1.0;
 1287:       }
 1288: 
 1289:       printf("computeTimeRamps: i = %d, time = %f, nws = %d, if_source = %d, ramp = %f, drampbc = %f, drampwind = %f, drampwafo = %f, dramp_ss = %f, dramp = %f\n", 
 1290:              threadIdx.x + blockIdx.x * blockDim.x, time, nws, if_source, ramp, drampbc, drampwind, drampwafo, dramp_ss, dramp);
 1291:    }
