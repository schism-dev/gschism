 2771: __device__ void computeBottomDragVegetation(void) {
 2772:    // UNFINISHED. CHECK THIS:
 2773:    // How many kernels are needed? Why so many for loops?
 2774:    // Is the loop on sides needed?
 2775: 
 2776:    Node *node = FROM kernel;
 2777: 
 2778:    const int    kb      = node->kb;
 2779:    const double htot    = node->htot();
 2780:    const double rough   = node->rough;
 2781: 
 2782: 
 2783:    if (node->idry) {
 2784:       // Default values for dry nodes
 2785:       node->veg_alpha_vert_mean = node->veg_alpha0;
 2786:       /// XXX CHECK INDICES
 2787:       if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 2788:    }
 2789: 
 2790:    // Compute bottom drag Cd
 2791:    //--------------------------------
 2792: 
 2793:    // nchi = {-1, 0, 1} is the type of bottom drag.
 2794:    if (nchi==1) {
 2795: 
 2796:       bool ltmp = false; // for WBL iteration
 2797: 
 2798:       // Cdmax=-1 !max. Cd at node for this process (info only)
 2799:       // Drag at nodes
 2800: /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 2801: // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 2802:      
 2803:       const double rough = node->rough;
 2804:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 2805:       if (node->rough == 0.0) {
 2806:          node->Cd = 0.0;
 2807: 
 2808:       } else { //roughness >0 
 2809:          
 2810:          const double bthick_ori = node->znl[kb + 1] - node->znl[kb];  // thickness of bottom bnd layer
 2811:          const double bthick = max(dzb_min, bthick_ori);
 2812: 
 2813:          assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 2814: 
 2815:          double tmp = 1.0/(2.5*log(bthick/rough));
 2816:          node->Cd = tmp*tmp;
 2817: 
 2818:       } // if rough
 2819: 
 2820: 
 2821:       // RECOVER THIS: XXX
 2822:       // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 2823:       // Output warning for WBL if iteration didn't converge
 2824: 
 2825: 
 2826:    } // nchi==1
 2827: 
 2828:    //   Bottom stress in m^2/s^2
 2829:    if (node->rho[kb + 1] >= -98.0)
 2830:    {
 2831:       const double mag_u = length(toVector2(node->u2[kb + 1]));
 2832:       node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 2833:       // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 2834:       // !sediment erosion: this part needs more documentation
 2835:    }
 2836: 
 2837:  
 2838:    // Compute vegetation parameters
 2839:    //--------------------------------
 2840: 
 2841:    // SAV constants
 2842:    constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 2843:    constexpr double veg_cfpsi = 0.16;
 2844: 
 2845:    // Add vertical variation to veg_alpha and compute vertical mean etc.
 2846:    if constexpr(iveg == 1) { //  Vertical variation specified by functions
 2847: 
 2848:       // Compute the vegetation "density" \alpha = D*N*Cd/2
 2849:       // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 2850:       int kbin = 0; // bin index
 2851:       for (int k=nkb; k<nvrt; k++) {
 2852:          // Computes node height above the bottom level
 2853:          const double tmp_h = node->znl[k] - node->znl[kb]; // >=0
 2854:          
 2855:          if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 2856:             cff1 = veg_vert_scale_cd[nbins_veg_vert];
 2857:             cff2 = veg_vert_scale_N [nbins_veg_vert];
 2858:             cff3 = veg_vert_scale_D [nbins_veg_vert];
 2859:          } else {
 2860:             // Find the bin at which the current vertical level is
 2861:             while (kbin<nbins_veg_vert) {
 2862:                const double zn = node->znl[kbin];
 2863:                if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 2864:                   break;
 2865:                } // if
 2866:                kbin++;
 2867:             } // while
 2868:             assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 2869: 
 2870:             // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 2871:             const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 2872:             
 2873:             // Linear interpolation of the vegetation parameters
 2874:             cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 2875:             cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 2876:             cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 2877:          } // if rl10
 2878: 
 2879:          node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 2880: 
 2881:       } // for k
 2882: 
 2883: 
 2884:    } else { // Ganthy (iveg=2)
 2885:    //  Modify canopy height, diameter, and density
 2886: 
 2887:       // Make sure there is vegetation on this node
 2888:       if (node->veg_h_unbent > 0.0) {
 2889:          const double wtmp2 = length(node->dav)*100.0; // cm/s
 2890: 
 2891:          node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 2892:                                 0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 2893:          node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 2894: 
 2895:          const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 2896:          node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 2897:          const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 2898:          node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 2899:       } // if veg_h_unbent
 2900:       veg_alpha3D(:,i) = 0.5d0*veg_di(i)*veg_nv(i)*veg_cd(i)
 2901:    
 2902: 
 2903:    } // if iveg
 2904:   
 2905:       
 2906: 
 2907:    // Compute vertical mean of veg_alpha3D
 2908:    if (iveg != 0) {
 2909:       const double ztop = node->zTopCanopy(); // Top of the canopy
 2910:       double sum1=0.0;
 2911:       double sum2=0.0;
 2912:       // Integrate over each level under the canopy...
 2913:       for (int k=kb; k<nvrt-1 && node->znl[k+1] <= zztop; k++) { /// XXX CHECK INDICES
 2914:          const double Dz = node->Dz(k);
 2915: 
 2916:          sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 2917:          sum2 += Dz;
 2918: 
 2919:       } // for k
 2920: 
 2921:       if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 2922:       else             node->veg_alpha_vert_mean = sum1/sum2;
 2923: 
 2924:    } // if iveg
 2925: 
 2926: }
 2927: 
 2928: __device__ void computeVegetationAndDragParameters(void) {
 2929:    // Computes the vegetation and drag model parameters:
 2930:    // chi, \tilde\chi, beta, \breve{H}
 2931:    
 2932:    Side *side = FROM kernel;
 2933: 
 2934:    const double htot = side->htot();
 2935:    const double kb   = side->kb;
 2936: 
 2937:    assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 2938: 
 2939:    const double veg_h    = side->veg_h();
 2940:    const double veg_nv   = side->veg_nv();
 2941:    const double veg_c    = side->veg_c();
 2942:    const double veg_beta = side->veg_beta();
 2943: 
 2944:    // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 2945:    // Velocity magnitude at the bottom level
 2946:    // XXXX Check if we have add -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 2947:    const double vmag1 = length(side->u2[kb + 1]) BACKTRACKED VELOCITY
 2948:    side->chi2 = side->Cd*vmag1 
 2949:    side->chi  = side->chi2
 2950:    if constexpr(iveg != 0) {
 2951:       const Node *n1 = side->n1;
 2952:       const Node *n2 = side->n2;
 2953:       const double veg_alpha_bot = 0.5*(n1->veg_alpha3D(n1->kb) + n2->veg_alpha3D(n2->kb));
 2954:       side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt)
 2955:    }
 2956: 
 2957:    // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 2958: 
 2959:    // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 2960:    // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 2961:    double magUa = 0.0;
 2962:    if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 2963:       // 3D wet side with veg...
 2964: 
 2965:       for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 2966:          if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 2967: 
 2968:             // Velocity magnitude must be computed at the center of each level to perform the integration.
 2969:             // The tricky part is to compute that velocity at the level that may be partially submerged.
 2970:             const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 2971: 
 2972:             // Velocity magnitude at the top (h) of the level (may be partially submerged)
 2973:             const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 2974: 
 2975:             // Velocity magnitude at the bottom (l) of the level
 2976:             const double ul = length(side->u2[k]);
 2977: 
 2978:             const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 2979:             magUa += Dz*0.5*(uh + ul);
 2980: 
 2981:          } // if HasVegetation
 2982:       } // for k
 2983:       const double ua = magUa/min(htot, veg_h); // Vertical average
 2984: 
 2985:       // Computes beta, used for computing the stress term at the top of the canopy.
 2986:       const double veg_alpha = side->veg_alpha_vert_mean();
 2987:       side->veg_c2 = side->veg_alpha*dt*ua; // >=0
 2988:       if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 2989:          const double zCpy = side->zTopCanopy();
 2990:          const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 2991:          const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 2992:          const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I))
 2993:          const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 2994:          side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 2995:       } // if isSubmerged
 2996:    } // if iveg   
 2997: 
 2998:    // Computes the friction modified depth, \breve{H} in notes
 2999:    if (side->is2D()) { // 2D
 3000: 
 3001:       double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 3002:       if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 3003: 
 3004:       assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 3005: 
 3006:       side->hhat = htot*htot/fricH; 
 3007: 
 3008:    else { // 3D
 3009:       side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 3010: 
 3011:       if constexpr(iveg != 0) {
 3012:          
 3013:          if (side->isSubmerged()) { 
 3014:             const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 3015:             side->hhat -= veg_c*Hhat_alpha;
 3016: 
 3017:          } else { // Emergent
 3018:             side->hhat = side->hhat/(1.0 + veg_c2); // veg_c2 = alpha*|u|*dt
 3019:          }
 3020:       } // if iveg
 3021: 
 3022:       // Enforce positivity for 3D model
 3023:       if (ihhat == 1) side->hhat = max(0.0, side->hhat)
 3024:    } // if 3D
 3025: 
 3026:      
 3027: }
 3028: 
 3029: 
 3030: 
 3031: __device__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 *vec, double *diffRho) {
 3032: // Computes the density gradient between two elements, e1 and e2.
 3033: // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 3034: // zero in the direction normal to the side. 
 3035: // 
 3036: // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 3037: // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 3038: //
 3039: // Input:
 3040: //    e1: Element
 3041: //    e2: Neighbor element (or nullptr if boundary)
 3042: //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 3043: //    k: Index of the half-level at which the density is interpolated
 3044: //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 3045: // 
 3046: // Output:
 3047: //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 3048: //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 3049: 
 3050:    if (e2 == nullptr || e2->idry) {
 3051:       // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 3052: 
 3053:       Side *side = e1->sides[j];
 3054:       assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->idry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 3055:               
 3056:       if constexpr(ics==1) {
 3057:          vec = side->n(); // Normal vector to the side
 3058:       } else {
 3059:          // IMPLEMENT THIS XXXXXX
 3060:          // !replace with xel, yel?
 3061:          //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 3062:          //      &eframe(:,:,i),xn1,yn1,tmp)
 3063:          //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 3064:          //      &eframe(:,:,i),xn2,yn2,tmp)
 3065:       } //ics
 3066:                 
 3067:       diffRho = 0.0;
 3068: 
 3069:    } else { //internal and wet
 3070:       if constexpr(ics==1) {
 3071:          assert(e2 != nullptr || e2->idry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 3072: 
 3073:          // Vector from e1 to e2
 3074:          vec = toVector2(e2->center - e1->center);
 3075: 
 3076:       } else { 
 3077:          // IMPLEMENT THIS XXXXXX
 3078:          //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 3079:          //      &eframe(:,:,i),xctr2,yctr2,tmp)
 3080:          //                   alow(j)=xctr2
 3081:          //                   bdia(j)=yctr2
 3082:       } // ics
 3083: 
 3084:       diffRho = rho2 - e1->demeanedDensity(k);
 3085:    }
 3086: 
 3087: }
 3088: 
 3089: __device__ void computeDensityCubicSplines(void) {
 3090:    // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 3091: 
 3092:    if (elem->idry) return;
 3093: 
 3094:    const int kb = elem->kb;
 3095: 
 3096:    // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 3097:    if (elem->is2D()) {
 3098:       // In the 2D case, the density is constant at the prism level. 
 3099:       // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 3100:       elem->rho_z[nvrt-1] = elem->rho[nvrt-1] - elem->rho_mean[nvrt-1]
 3101:    } else { //3D
 3102: 
 3103:       // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 3104:       auto getX = [zp             ] __forceinline__ (int k) { return elem->z_prism(k); };
 3105:       auto getY = [elem,k,rho_mean] __forceinline__ (int k) { return elem->rho[k] - elem->rho_mean[k]; };
 3106:       ///// XXXX CHECK INDICES!!!!!
 3107:       initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_zz, elem->rho_z);
 3108:    } // 2D/3D
 3109: 
 3110: }
 3111: 
 3112: __device__ double interpolateDensityAtHalfLevel(Element *elem, Element *elem2, int k, double &rho) {
 3113: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 3114: 
 3115:    if (elem2 == nullptr || elem2->idry) return 0.0;
 3116: 
 3117:    const int kb  = elem->kb;
 3118:    const int kb2 = elem2->kb;
 3119: 
 3120:    // z-coordinate of prism of elem
 3121:    const double zp = elem->z_prism(k);
 3122: 
 3123:    if (elem2->is2D()) {
 3124:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 3125: 
 3126:    } else {  // 3D
 3127: 
 3128:       // eta_min may be < zmax
 3129:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1])
 3130:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]) ;
 3131: 
 3132:       // (Extrapolate density below bottom, we will fix it later)
 3133:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 3134:       rho = evalCubicSpline(zp, elem->rho_z, elem->rho_zz, elem->demeanedDensity(k), extrapolate = true);
 3135:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 3136:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 3137:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 3138:    } // 2D/3D
 3139:      
 3140: 
 3141:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 3142:    // Now we need to fix it.
 3143:    if (elem->z[k] < elem2->z[kb2]) {
 3144:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 3145: 
 3146:       // There are two methods to adjust the density at the bottom of the element.
 3147:       // iunder_deep=0: 
 3148:       const double depth1 = abs(elem->z[kb]); // larger depth
 3149: 
 3150:       if (iunder_deep==0) {
 3151: 
 3152:          const double weight = max(0.0, min(1.0, (depth1 - elem->h1_bcc)/(elem->h2_bcc - elem->h1_bcc))); // weight
 3153: 
 3154:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k)
 3155: 
 3156:       } else { // iunder_deep != 0
 3157: 
 3158:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]) // Change??? XXX Was like this in the original code
 3159: 
 3160:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 3161: 
 3162:          //   Demeaned density at the same z coordinate as
 3163:                rho = elem->demeanedDensity(k) // would make cupp() below=0
 3164:             }
 3165:          } // if tmp0>=
 3166:       } // if iunder_deep
 3167:    } // if elem->z[kb] < elem2->z[kb]
 3168: }
 3169: 
 3170: __device__ void computeDensityGradient(void) {
 3171: 
 3172:    // Compute the horizontal density gradient at each element.
 3173:    // It works in two steps:
 3174:    // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 3175:    // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 3176:    //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 3177:    //             gradRho.r1 = rho1 - rho0
 3178:    //             gradRho.r2 = rho2 - rho0
 3179:    //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 3180:    // 
 3181:    //  NOTE: We use de-meaned densities.
 3182: 
 3183:    Element *elem = FROM kernel;
 3184: 
 3185:    if (elem->idry) return;
 3186: 
 3187:    const int kb  = elem->kb;
 3188:    const int i34 = elem->i34;
 3189: 
 3190:    for (int k = kb + 1; k < nvrt; k++) {
 3191:       // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 3192:       //             gradRho.r1 = rho1 - rho0
 3193:       //             gradRho.r2 = rho2 - rho0
 3194:       icount=0
 3195:       double sumRx = 0.0;
 3196:       double sumRy = 0.0;
 3197:       for (int j1=0; j1<i34; j1++) { 
 3198: 
 3199:          const int j2 = elem->nxq(j1 + 1);
 3200: 
 3201:          // Pairs of consecutive neighbor elements of elem
 3202:          const Element *e1 = elem->elements[j1];
 3203:          const Element *e2 = elem->elements[j2];
 3204: 
 3205:          // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 3206:          const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 3207:          const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 3208: 
 3209:          // Compute the density difference and the vector from elem to e1 and e2
 3210:          // getRhoDiffAndVec takes into account boundaries/dry elements
 3211:          double diffRho1, diffRho2;
 3212:          Vector2 vec1, vec2;
 3213:          getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 3214:          getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 3215: 
 3216:          const double rl1 = length(vec1);
 3217:          const double rl2 = length(vec2);
 3218:          assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 3219: 
 3220:          const double delta = cross(vec1, vec2);
 3221:          const double sintheta = abs(delta)/(rl1*rl2);
 3222: 
 3223:          // To avoid problems, avoid elements with small angle between vectors
 3224:          constexpr double sin_one_deg = sin(pi/180.0); // use 1 degree as threshold for well-conditioned system
 3225:          const bool validEq = (sintheta > sin_one_deg);
 3226: 
 3227:          if (validEq) {
 3228:             // Solve the system of equations to get the density gradient at elem
 3229:             icount++;
 3230:             const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 3231:             const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 3232:             sumRx += Rx;
 3233:             sumRy += Ry;
 3234:          }
 3235:       } // for j1
 3236: 
 3237:       // Compute the average density gradient at elem
 3238:       if (icount==0) {
 3239:         // Bad mesh quality; bail out with 0 b-cc
 3240:         elem->gradRho[k] = {0.0, 0.0};
 3241:       } else {
 3242:         elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 3243:       }
 3244: 
 3245:    } // for k
 3246: 
 3247: }
 3248: 
 3249: __device__ void computeBaroclinicTerm(double rampbc) {
 3250: // Computes the baroclinic term at sides (at half levels).
 3251: // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 3252: // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 3253: 
 3254:    Side *side = FROM kernel;
 3255: 
 3256:    if (side->idry == 1) return;
 3257: 
 3258:    const Element *e1 = side->elements[0];
 3259:    const Element *e2 = side->elements[1];      
 3260:    const int kb = side->kb;
 3261:    
 3262:    assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 3263: 
 3264:    // interpolates vertically the density gradient of the two elements at the half level/
 3265: 
 3266:    // Starts the integration at the surface and goes down to the bottom
 3267:    int k1 = nvrt - 1;
 3268:    int k2 = nvrt - 1;
 3269: 
 3270:    side->bcc[nvrt-1] = {0.0, 0.0};
 3271:    for (int k = nvrt-1; k >= side->kbs; k--) {
 3272:    // For each prism level (from surface to bottom)...
 3273: 
 3274:       // For both elements, interpolate density gradient at the side's half level.
 3275:       // The gradient at the side is the average of the gradients at the elements.
 3276:       // w1, w2 are used to take into account boundary sides, with just one element.
 3277:       double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 3278:       double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 3279:       w1 = w1/(w1 + w2);
 3280:       w2 = w2/(w1 + w2);
 3281: 
 3282:       assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 3283: 
 3284:       // Linear interpolation of both elements' density gradient at the shared side's level.
 3285:       Vector2 gradRho = {0.0, 0.0};
 3286:       if (e1 != nullptr && k > kb) {
 3287:          // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 3288:          k1 = e1->findLevel(side->z[k], k1); // finds the index at the half level starting the search at k1
 3289:          const double zrat = (side->z[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 3290:          
 3291:          gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 3292:       }      
 3293:       if (e2 != nullptr && k > kb) {
 3294:          k2 = e2->findLevel(side->z[k], k2); // finds the index at the half level starting the search at k2
 3295:          const double zrat = (side->z[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 3296:          
 3297:          gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 3298:       }
 3299: 
 3300:       if constexpr(ics==2) {
 3301:          // IMPLEMENT THIS XXXXXX
 3302:          // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 3303:          // swild(1)=tmp1
 3304:          // swild(2)=tmp2
 3305:       }
 3306:       
 3307:       // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 3308:       // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 3309:       // CHECK INDICES!!! XXX
 3310:       const double grav3 = 0.5*(side->n1->grav2 + side->n2->grav2);
 3311:       side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 3312:    } // for
 3313: 
 3314: }
 3315: 
 3316: #ifdef DONTCOMPILE
 3317: __device__ void computeVerticalAdvection(void) {
 3318:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 3319: 
 3320:    sdbt(1:2,:,:)=0.d0
 3321: 
 3322:    const Side *side = FROM kernel;
 3323: 
 3324:    if(side->idry) return;
 3325: 
 3326:    // If side is wet...
 3327: 
 3328: 
 3329:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 3330:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 3331:    double ws[nvrt] = {} // w @ side
 3332:    int icount = 0;
 3333:    for (int j=0; j<2; j++) {
 3334:       const Element *elem = side->elements[j];
 3335:        
 3336:       if(elem != nullptr) {
 3337:          icount++;
 3338:          for (int k=0; k<nvrt; k++) {
 3339:             ws[k] = ws[k] + elem->w[k];
 3340:          }
 3341:       }
 3342:    }  // for j
 3343: 
 3344:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 3345:    ws = ws/icount;
 3346: 
 3347:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 3348:    // Splines allow for a smooth transition between vertical levels.
 3349:    // Splines have continuity restrictions at the internal knots, but
 3350:    // we have to provide the 1st derivatives at the endpoints.
 3351:    const int kbs = side->kbs; 
 3352:    
 3353:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3354:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3355:    initCubicSpline(kbs, nvrt, side, ws, up)
 3356: 
 3357:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3358:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3359:    initCubicSpline(kbs, nvrt, side, ws, vp)
 3360: 
 3361:    // Total advection (average onto side)
 3362:    const Node *node1 = side->nodes[0];
 3363:    const Node *node2 = side->nodes[1];
 3364:    for (int k=kbs(i); k<nvrt; k++) {
 3365: 
 3366:       if constexpr(ics==1) {
 3367:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 3368:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 3369:       } else {
 3370:          // XXX IMPLEMENT THIS
 3371:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 3372:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 3373:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 3374:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 3375:       }  // if ics
 3376: 
 3377: 
 3378:    }
 3379: }
 3380: #endif
 3381: 
 3382: __device__ void computeElemAverageGhat(void) {
 3383: // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 3384: 
 3385:    Element *elem = FROM kernel;
 3386:    
 3387:    elem->ghat1= {0.0, 0.0};  
 3388: 
 3389:    if constexpr(ihydraulics != 0) {
 3390:       if (nhtblocks > 0 && (elem->isblock > 0)) return;
 3391:    }
 3392: 
 3393:    if (elem->idry == 1) return;
 3394: 
 3395:    // Wet elements.
 3396:    // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 3397:    // tidal potential, horizontal diffusion, and baroclinic etc
 3398:    // Remember to update both fb and F 
 3399:    // If ics=2, ghat1 are in eframe (ll)
 3400:    // cff1-3: coefficients for 2D/3D
 3401:    Vector2 gradEta = {0.0, 0.0};  // \nabla \eta
 3402:    Vector2 gradPr  = {0.0, 0.0};  // \nabla pressure
 3403:    Vector2 gradEtp = {0.0, 0.0};  // \nabla etp
 3404: 
 3405:    double av_cff1 = 0.0;  // av. for cff1
 3406:    double av_cff2 = 0.0;  // av. for cff2
 3407:    double av_cff3 = 0.0;  // av. for cff3
 3408:    double av_df = 0.0;  // av. for H^\alpha / H
 3409:    double av_cff2_chi = 0.0;  // av. for cff2*chi
 3410:    double av_cff3_chi = 0.0;  // av. for cff3*chi
 3411: 
 3412:    const int i34 = elem->i34;
 3413: 
 3414:    for (int j=1; j<i34; j++) {
 3415:       // For each node and side in the element...
 3416: 
 3417:       const Node *node = elem->nodes[j];
 3418:       const Side *side = elem->sides[j];
 3419: 
 3420:       const double chi      = side->chi;
 3421:       const double veg_c2   = side->veg_c2;
 3422:       const double veg_beta = side->veg_beta;
 3423:       const double veg_h    = side->veg_h();
 3424:       const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 3425: 
 3426:       // Node - const in elem
 3427:       gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 3428:       gradPr  += node->pr  *elem->gradPhi[j];
 3429: 
 3430:       if (elem->depth >= tip_dp) {
 3431:         gradEtp += node->etp*elem->gradPhi[j];
 3432:       }
 3433: 
 3434:       
 3435:       const double htot  = side->htot();        // Total depth at the side
 3436:       const double zctr2 = side->zTopCanopy();  
 3437: 
 3438:       double cff1; 
 3439:       double cff2; 
 3440:       double cff3;   
 3441:       if (side->is2D()) {  // XXX Check indices, it used to have a +1
 3442:       // coefficients applied to 2D/3D case 
 3443:          cff1 = side->hhat/htot;
 3444:          cff2 = 0.0;
 3445:          cff3 = 0.0;
 3446:       } else { //3D
 3447:          //Init for no-veg case
 3448:          cff1 = 1.0;
 3449:          cff2 = 1.0;
 3450:          cff3 = 0.0;
 3451: 
 3452:          if constexpr(iveg != 0) {
 3453:             // Computes coefficients used with vegetation terms G1, G2
 3454:             // cff1, cff3 are used for the first two terms in G1, G2:
 3455:             // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 3456:             // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 3457:             // In general, cff1*Ustar - cff3*Ustar_alpha
 3458:             if(veg_h < 0.99*htot) { // submergent vegetation
 3459:                cff1=1;
 3460:                cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 3461:                cff3 = veg_c;
 3462: 
 3463:             } else { // emergent vegetation
 3464:                cff1 = 1.0/(1.0 + veg_c2);
 3465:                cff2 = cff1;
 3466:                cff3 = 0.0;
 3467: 
 3468:             }
 3469:          } // if iveg
 3470:       } //  2D/3D
 3471: 
 3472:       av_cff1 += cff1/i34;
 3473:       av_cff2 += cff2/i34;
 3474:       av_cff3 += cff3/i34;
 3475:       av_cff2_chi += cff2*chi/i34;
 3476:       av_cff3_chi += cff3*chi/i34;
 3477:       av_df += min(htot, veg_h)/(htot*i34);
 3478: 
 3479: 
 3480:       // btrack values: U^\star, U^{\star\alpha}
 3481:       // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 3482:       Vector2 Ustar       = {0.0, 0.0}; 
 3483:       Vector2 Ustar_alpha = {0.0, 0.0}; 
 3484:       for (int k = side->kb; k < nvrt; k++) {
 3485:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 3486:             Ustar += side->bt[nvrt]*side->Dz(k);
 3487: 
 3488:          } else { //3D
 3489:             Vector2 w2 = (side->bt[k] + side->bt[k-1])/2.0*side->Dz(k);
 3490:             Ustar += w2;
 3491: 
 3492:             if constexpr(iveg != 0) {
 3493:                 if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 3494:                     const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k)); // For the top of the canopy, ratio of the level that is below the canopy
 3495:                     Ustar_alpha += zrat*w2; // XXXX
 3496:                 }
 3497:             }  // if iveg
 3498:          }  //2/3D
 3499:       }  //k
 3500:       
 3501: 
 3502:       // Add btrack & surface stress terms to \breve{G} first
 3503:       if constexpr(ics==1) {
 3504:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 3505:       } else {
 3506:          // XXX IMPLEMENT THIS
 3507:          // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 3508:          // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 3509:          // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 3510:       }  // if ics
 3511: 
 3512:       // Surface and bottom stress terms
 3513:       if constexpr(ics==1) {
 3514:          const Vector2 tau    = side->tau();
 3515:          const Vector2 ubstar = side->sdbt[side->kb+1]; // XXX CHECK INDICES
 3516:       } else {
 3517:          // XXX IMPLEMENT THIS
 3518:          // n1=isidenode(1,isd); n2=isidenode(2,isd)
 3519:          // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 3520:          // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 3521:          // tau_x=(vn1+tt1)/2.d0
 3522:          // tau_y=(vn2+ss1)/2.d0
 3523:          // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 3524:       }  // if ics
 3525: 
 3526:       // Term for surface and bottom stress
 3527:       elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 3528: 
 3529:       // All terms in F,F^\alpha,f_b except baroclinic
 3530:       // F, f_b: all explicit terms excluding vegetation 
 3531:       // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 3532:       // Only need to calculate F^\alpha for 3D sides (but init=0) 
 3533:       const double coriolis = side->cori;
 3534:       const Vector2 F  =  coriolis*side->U;  // F_x
 3535:       const Vector2 fb =  coriolis*side->u2;  // f_b_x
 3536:       Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 3537: 
 3538:       if (iveg != 0 && nvrt > side->kb) {  // 3D
 3539:          
 3540:          for (int k = side->kb; k < nvrt; k++) {
 3541:             if (zctr2 > side->z[k-1]) {
 3542:                 const Vector2 w2 = side->Dz[k]*(side->u2[k] + side->u2[k-1])/2.0;
 3543:                 const double zrat = min(1.0, (zctr2 - side->z[k-1])/side->Dz[k]);
 3544:                 Fa +=  coriolis*w2*zrat;
 3545:             } // if zctr2
 3546:          } // k
 3547:       } // iveg
 3548: 
 3549:       // Integrate horizontal viscosity vertically
 3550:       for (int k=side->kb; k<nvrt; k++) {
 3551:          const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.d0 // (d2uv(1,k,isd)+d2uv(1,k-1,isd))/2
 3552: 
 3553:          F += w2;
 3554: 
 3555:          // Vegetation term
 3556:          if constexpr(iveg!=0) {
 3557:             if (nvrt > side->kbs + 1 && zctr2 > side->z[k-1]) { // 3D
 3558:                const double zrat = min(1.0, (zctr2 - side->z[k-1])/side->Dz(k));
 3559:                Fa += w2*zrat;
 3560:             } 
 3561:          } // if iveg
 3562:       } // for k
 3563: 
 3564:       fb += side->d2uv[side->kb];
 3565: 
 3566: 
 3567:       // Add to ghat1
 3568:       if constexpr(ics==2) {
 3569:          // XXX IMPLEMENT THIS
 3570:          // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 3571:          // bigf1=vn1; bigf2=vn2
 3572:          // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 3573:          // botf1=vn1; botf2=vn2
 3574:          // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 3575:          // bigfa1=vn1; bigfa2=vn2
 3576:       } // if ics
 3577: 
 3578:       elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 3579:    } // for j (nodes and sides)
 3580: 
 3581:    elem->ghat1 = (1.0/i34)*elem->ghat1;
 3582:       
 3583:    // Finish off terms in F, F^\alpha and f_b
 3584:    const double grav3 = elem->mean(Element::grav2)
 3585:    const Vector2 fb = grav3*gradP - gradPr/rho0 //const in each elem
 3586: 
 3587: 
 3588:    Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 3589:    for (int j=1; j<i34; j++) { 
 3590:       // For each side in the element...
 3591:       const Side *side = elem->sides[j];
 3592: 
 3593:       const double htot = side->htot();
 3594:       const double F  = htot*fb;
 3595:       const double Fa = min(htot, veg_h)*fb;
 3596: 
 3597:       tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 3598:    } // for j
 3599: 
 3600:    //botf1 etc are already in elem frame
 3601:    elem->ghat1 += tmp/i34;
 3602: 
 3603:    // Baroclinic force
 3604:    if constexpr(ibc==0) {
 3605:       assert(elem->nodes[0]->rho >= -98.d0 && elem->nodes[1]->rho >= -98.d0 && elem->nodes[2]->rho >= -98.d0 && "computeElemAverageGhat1: Impossible dry");
 3606: 
 3607:       Vector2 Fa = {0.0, 0.0};
 3608:       Vector2 intGradRho = {0.0, 0.0};
 3609:       
 3610:       // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 3611:       for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 3612:          intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 3613: 
 3614:          // \in F [m^2/s/s]
 3615:          Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 3616:       }
 3617: 
 3618:       const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 3619:       const Vector2 F = av_df*Fa; //approx
 3620:       elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 3621: 
 3622:    } // if ibc
 3623: 
 3624: }
 3625: 
 3626: 
 3627: 
 3628: #ifdef DONTCOMPILE
 3629: __global__ void checkMassConservation(Tracers* sumtr) {
 3630: 
 3631:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 3632: 
 3633:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 3634: 
 3635:    Element *elem = &(mesh->localElemData[i]);
 3636: 
 3637:    // Skip dry elements
 3638:    if (elem->idry) return;
 3639: 
 3640:    // Local sum array for this thread
 3641:    double localSum[N_TRACERS] = {0.0};
 3642: 
 3643:    // Sum over vertical levels for this element
 3644:    const int kbe = elem->kbe;
 3645:    const double area = elem->area;
 3646: 
 3647:    for (int k = kbe; k < nvrt; k++) {
 3648:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 3649:       
 3650:       // Accumulate tracer mass
 3651:       for (int tr = 0; tr < N_TRACERS; tr++) {
 3652:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 3653:       }
 3654:    }
 3655: 
 3656:    
 3657: 
 3658:    //  This function returns per element sums. A reduction must be done on the host side.
 3659: }
 3660: 
 3661: 
 3662: __global__ void transport(void) {
 3663: 
 3664:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 3665: 
 3666:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 3667: 
 3668:    Element *elem = &(mesh->localElemData[ie]);
 3669: 
 3670:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 3671: 
 3672:                for (int m=0; m<ntr; m++) {
 3673:                   for (int k=kbe(ie); k<nvrt; k++) {
 3674:                      // Calculate each polynomial's weight 
 3675:                      wm=0.d0; sum1=0.d0; 
 3676:                      wm1=0.d0; wm2=0.d0; 
 3677:                      for (int i=0; i<elem->nweno2; i++) {
 3678:                   
 3679:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3680:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3681:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3682:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3683:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3684:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 3685:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 3686:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 3687:                      // -----------------Hu and Shu (1999)'s method----------------
 3688:                      b4=b1+b2+b3
 3689: 
 3690: //Error: add PRODUCTION CPP
 3691: #ifdef DEBUG
 3692:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 3693:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 3694:                     call parallel_abort(errmsg)
 3695:                   }
 3696: #endif
 3697: 
 3698:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 3699:                   // !----test-------------- 
 3700:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 3701:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 3702:                   // !wm(i)=wm1(i)*wm2(i)
 3703:                   // !---------------------- 
 3704:                   sum1=sum1+wm(i)
 3705:                 } // end for i
 3706: 
 3707:                 wm=wm/sum1
 3708: 
 3709:                 for (int j=0; j<elem->i34; j++) {
 3710: 
 3711:                   const Side *side  = elem->sides[j];
 3712:                   const Node *node1 = side->n1;
 3713:                   const Node *node2 = side->n2;
 3714: 
 3715:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 3716:                      trsd=0.d0
 3717:                      for (int kk=0; kk<nquad; kk++) {
 3718:                         for (int i=0; i<elem->nweno2; i++) {
 3719:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3720:                         } // end for i   
 3721:                      } // end for kk
 3722:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 3723:                   } // outward flux
 3724:                } // end for j=1,i34(ie) ! side
 3725:             }
 3726:          }
 3727:               
 3728: 
 3729: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 3730: //             //   calculate each polynomial's weight 
 3731: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 3732: //                 wm=0.d0; sum1=0.d0
 3733: //                 do i=1,nweno1(ie) !for each polynomial
 3734: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 3735: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 3736: //                   b1=b1*b1+b2*b2 !smoothness indicator
 3737: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 3738: //                   wm(i)=b2
 3739: //                   sum1=sum1+b2
 3740: //                   !wm(i)=1.d0
 3741: //                   !sum1=sum1+1.d0
 3742: 
 3743: // // Error: PRODUCTION
 3744: // #ifdef DEBUG
 3745: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 3746: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 3747: //                     call parallel_abort(errmsg)
 3748: //                   endif
 3749: // #endif
 3750: 
 3751: //                 enddo !i
 3752: //                 wm=wm/sum1 !final weight
 3753: 
 3754:                 for (int j=0; j<elem->i34; j++) { // side
 3755:                   const Side *side = elem->sides[j];
 3756:                   const Node *node1 = side->n1;
 3757:                   const Node *node2 = side->n2;
 3758: 
 3759:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 3760:                     trsd=0.d0
 3761:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 3762:                       for (int i=0; i<elem->nweno1; i++) {
 3763:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 3764:                       }
 3765:                     enddo //kk
 3766:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 3767:                   } // outward flux
 3768:                 } // end for j=1,i34(ie) ! side
 3769:               } // end for k; ntr 
 3770: 
 3771:             else !simple upwind method
 3772:               do j=1,i34(ie)
 3773:                 jsj=elside(j,ie)
 3774:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 3775:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 3776:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 3777:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 3778:                   endif
 3779:                 enddo  !vertical layers
 3780:               enddo !j=1,i34(ie) ! side
 3781:             endif !order of accuracy
 3782: 
 3783:          //  enddo !ie
 3784: // !$OMP     end do
 3785: 
 3786: // !$OMP     master
 3787: //           !message passing
 3788: //           if (nproc>1) then
 3789: //             !make a copy of side concentrations
 3790: //             trsd_tmp0=trsd_tmp 
 3791: 
 3792: //             !this exchange routine swaps interface concentration between two partitions
 3793: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 3794: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 3795: 
 3796: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 3797: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 3798: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 3799: 
 3800: 
 3801: //             !This obtains final values for interface sides
 3802: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 3803: //       :    endif !nproc>1
 3804: //           !message passing end
 3805: // !$OMP     end master
 3806: // !$OMP     barrier
 3807: 
 3808: 
 3809: // !         Do advection; conc @ dry elem will not be changed
 3810: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 3811: // !$OMP     do reduction(+: h_mass_in)
 3812: //           do i=1,ne
 3813: //             if(idry_e(i)==1) cycle
 3814: 
 3815: 
 3816: // !           Wet elements with 3 wet nodes
 3817: //             do k=kbe(i)+1,nvrt
 3818: 
 3819: 
 3820: //               bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 3821: //               dtb_by_bigv = dtb/bigv
 3822:     
 3823: // !             Advective flux
 3824: //               if (ntd_weno==1 .or. itd_weno==1) then
 3825: //                 adv_tr(1:ntr)=trel_tmp(1:ntr,k,i) 
 3826: //               else
 3827: //                 adv_tr(1:ntr)=(1.d0-rk_coef(itd_weno))*trel_tmp0(1:ntr,k,i)+rk_coef(itd_weno)*trel_tmp(1:ntr,k,i) 
 3828: //               endif
 3829: 
 3830: //               !psum=0.d0 !sum of modified fluxes for all inflow bnds
 3831: //               do j=1,i34(i)
 3832: //                 jsj=elside(j,i) !side
 3833: //                 iweno=.true. !use weno reconstruction as default
 3834: //                 iel=ic3(j,i) !neighboring elem
