  581: struct Side {
  582: 
  583:    // Geometry information
  584:    int idx;               // Index of the side
  585:    Node *n1, *n2;
  586:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  587: 
  588:    double length;         // Length of the side. Used to be called distj; but I think this name is less clear now.
  589:    Vector2 center;        // Location of side center. 
  590:    double zc[nvrt];       // Side center z-coord at each vertical level
  591:    double depth;          // Depth at side center
  592: 
  593:    Frame frame;
  594: 
  595:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  596:                           // this is nullptr
  597:    
  598:    int kb;                // Bottom index of the side
  599:    bool idry;             // True if the side is dry
  600:  
  601:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  602: 
  603:    // Physical information
  604:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  605:    double  w2[nvrt];            // Vertical velocity at each vertical level
  606:    Vector2 btu[nvrt];           // Back-tracked velocity
  607:    Vector2 uth[nvrt];           // "Time history" velocity
  608:    Vector2 U;                   // Vertically averaged velocity vector   
  609: 
  610:    double hhat;                 // \breve{H} in notes
  611: 
  612:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
  613: 
  614:    // Vegetation parameters
  615:    double veg_c2;
  616:    double veg_beta;
  617: 
  618:    // Bottom drag parameters.
  619:    double chi;
  620:    double chi2;
  621: 
  622:    __inline__ __device__ double x(double t) const;
  623:    __inline__ __device__ double y(double t) const;
  624:    __inline__ __device__ Point2 p_t(double t) const;
  625: 
  626:    __inline__ __device__ Point3 center3D(int k) const { return {center.x, center.y, zc[k]}; }
  627:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
  628:    __inline__ __device__ double Dz(int k)       const { return zc[k] - zc[k-1]; }
  629: 
  630:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
  631: 
  632:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
  633: 
  634:    __inline__ __device__ int iadv(void) const;
  635: 
  636:    __inline__ __device__ double eta2(void) const;
  637:    __inline__ __device__ double htot(void) const { return eta2() + depth; }
  638: 
  639:    __inline__ __device__ double veg_h(void)  const;
  640:    __inline__ __device__ double veg_nv(void) const;
  641:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
  642:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
  643: 
  644:    __inline__ __device__ double Cd(void) const;
  645: 
  646:    __inline__ __device__ Vector2 tau(void) const;
  647: 
  648:    __inline__ __device__ double zb(void) const { return zc[kb]; }
  649:    
  650: 
  651:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
  652:    __inline__ __device__ double zLevelVegRatio(int k) const { 
  653:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
  654:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
  655:    } 
  656:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
  657:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot(); }
  658:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 1; }
  659:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 1; }
  660: 
  661:    // Get valid starting element (for backtracking)
  662:    __inline__ __device__ Element* getStartElement() {
  663:       return elems[0] ? elems[0] : elems[1];
  664:    }
  665: 
  666:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
  667:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
  668: 
  669:       // If one of the elements is null, return the other one
  670:       if      (elems[0] == nullptr) return elems[1];
  671:       else if (elems[1] == nullptr) return elems[0];
  672: 
  673: 
  674:       // Dot product of the negative velocity vector with the side normal vector
  675:       const double dot_prod1 = -dot(u, n);
  676:       
  677:       // Vector from side center to element 0 centroid
  678:       const Vector2 v2 = toVector2(elems[0]->center) - center;
  679: 
  680:       // Dot product of the vector with the side normal vector
  681:       const double dot_prod2 = dot(v2, n);
  682: 
  683:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
  684:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
  685: 
  686:       if (dot_prod1*dot_prod2 > 0.0) return elems[0];
  687:       else                           return elems[1];
  688: 
  689:  
  690:    }
  691: 
  692:    __forceinline__ __device__ Element* otherElem(const Element* elem) {
  693:       // Given an element, returns the other element that shares this side
  694:       return (elems[0] == elem) ? elems[1] : elems[0];
  695:    }
  696: 
  697:    __forceinline__ __device__ Node* otherNode(Node* node) {
  698:       // Given a node, returns the other node that shares this side
  699:       return (n1 == node) ? n2 : n1;
  700:    }
  701:  
  702:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, double* sclr,
  703:                                      Vector3 &u_int) const;
  704: 
  705: 
  706: 
  707: 
  708: };
  709: 
  710: 
  711: // This struct is used to store the boundary information for a node.
  712: struct NodeBoundary {   
  713:    BoundarySegment *segment;
  714:    Node *node;
  715:    
  716:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
  717:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
  718: 
  719:    double etaic;  // Elevation at nodes used for essential boundary conditions
  720:    double elbc;   // Elevation boundary condition
  721:    int iettype;   // Type of elevation boundary condition
  722:    double eth;    // Elevation time history
  723: 
  724:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
  725:       assert(index == 0 || index == 1); 
  726:       return (index == 0) ? sideBnd1 : sideBnd2; 
  727:    }
  728: };
