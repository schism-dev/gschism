  995:    //    return nodes[idx] + idx;
  996:    // }
  997: 
  998:    // // Get's the pointer to the element using the array of global pointers to elements
  999:    // __device__ const Element *getGlobalElem(int je) {
 1000:    //    const int idx = je / max_ne; // Get the index of the partition that contains the element
 1001:    //    return elems[idx] + idx;
 1002:    // }
 1003: 
 1004:    // // Get's the pointer to the side using the array of global pointers to sides
 1005:    // __device__ const Side *getGlobalSide(int js) {
 1006:    //    const int idx = js / max_ns; // Get the index of the partition that contains the side
 1007:    //    return sides[idx] + idx;
 1008:    // }
