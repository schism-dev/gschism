  165: 
  166: 
  167: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  168:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  169:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  170: }
  171: 
  172: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  173:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  174:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  175: }
  176: 
  177: 
  178: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  179:    x3 = y1*z2 - y2*z1;
  180:    y3 = x2*z1 - x1*z2;
  181:    z3 = x1*y2 - x2*y1;
  182: }
  183: 
  184: 
  185: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  186: // Given a 3D global point (may not be on surface of earth), find its longitude and latitude in radians
  187: 
  188:    const double radius2 = dot(p, p);
  189:    assert(radius2 != 0.0     && "computeLonLat: radius = 0");
  190:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  191: 
  192:    rlon = atan2(p.y, p.x); // (-pi,pi]
  193: 
  194:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  195:       rlat = asin(p.z/sqrt(radius2));
  196:    } else {
  197:       rlat = asin(p.z/rearth_pole);
  198:    }
  199:   
  200: }
  201: 
  202: __inline__ __device__ void Error(const char* msg) {
  203:    printf("Error: %s\n", msg);
  204:    assert(false);
  205: }
