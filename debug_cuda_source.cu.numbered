 1237: __device__ __inline__ double min3(double a, double b, double c) {
 1238:    return min(a, min(b, c));
 1239: }
 1240: 
 1241: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1242:    return min(a, min(b, min(c, d)));
 1243: }
