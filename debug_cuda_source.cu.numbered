  207: struct Tracers {
  208:     double tracer[N_TRACERS];
  209: };
  210: 
  211: 
  212: 
  213: struct Frame {
  214:    double _t[9]; // t stands for tensor.
  215: 
  216:    // Access the tensor in Fortran order
  217:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  218: 
  219:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  220: 
  221:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  222: 
  223:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  224:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  225:       sincos(ar2, &sin_ar2, &cos_ar2);
  226: 
  227:       t(0,0) = -sin_ar1;
  228:       t(1,0) =  cos_ar1;
  229:       t(2,0) =  0.0;
  230:       t(0,1) = -cos_ar1*sin_ar2;
  231:       t(1,1) = -sin_ar1*sin_ar2;
  232: 
  233:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  234: 
  235:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  236:       assert (ar4!=0.0 && "GRID: ar4=0");
  237: 
  238:       const double ar4_inv = 1.0/ar4;
  239:       t(0,1) = t(0,1)*ar4_inv;
  240:       t(1,1) = t(1,1)*ar4_inv;
  241:       t(2,1) = t(2,1)*ar4_inv;
  242: 
  243:       // The third vector is the cross product of the first two
  244:       crossProduct(t(0,0), t(1,0), t(2,0), 
  245:                    t(0,1), t(1,1), t(2,1), 
  246:                    t(0,2), t(1,2), t(2,2));
  247:    }
  248: 
  249: 
  250:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  251:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  252:    // Inputs:
  253:    //        vec0: vel. in this frame;
  254:    //        frameout: Output frame;
  255:    // Output: 
  256:    //        vec1: vel. in new frame  
  257: 
  258:       auto const fo = frameout;
  259:       Vector2 vec1;
  260: 
  261:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  262:       // of t and fo.t are the same.
  263:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  264:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  265: 
  266:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  267:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  268: 
  269:       return vec1;
  270:    }
  271: 
  272:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  273:       // Transform a vector from global to local frame
  274:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  275:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  276:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  277:    }
  278: 
  279:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  280:       // Transform a vector from local to global frame
  281:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  282:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  283:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  284:    }   
  285: 
  286:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  287:    // Tranforms a point from global to local frame     
  288:       G2L(pi - origin0, po);
  289:    }
  290: 
  291:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  292:    // Transforms a point from local to global frame      
  293:       L2G(pi, po);
  294:       po = po + origin0;
  295:    }
  296: 
  297: };
