 1024: // Helper functions for computing the local node index at a given offset from another.
 1025: __device__ __inline__ int nxq(int offset, int index, int size) {
 1026:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1027:    // to the index to make it positive
 1028:    assert(index + offset + 16*size >= 0);
 1029:    return (index + offset + 16*size) % size;  
 1030: }
 1031: 
 1032: __device__ __inline__ int nxq(int index, int size) {
 1033:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1034:    // to the index to make it positive
 1035:    assert(index + 16*size >= 0);
 1036:    return (index + 16*size) % size; 
 1037: }
