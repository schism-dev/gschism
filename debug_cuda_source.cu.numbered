 1903: 
 1904: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 1905: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 1906: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 1907: 
 1908: //       if (delta != 0.0) {
 1909: //          // Solves the two linear equations for tt1 and tt2
 1910: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1911: //          const double tt2 = delta2/delta;
