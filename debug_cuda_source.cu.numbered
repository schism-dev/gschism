  339: struct Element {
  340: 
  341:    // Geometry information
  342:    int idx;               // Index of the element
  343:    int i34;               // Number of sides for the element 
  344:    Side *sides[4];        // Sides of the element
  345:    Node *nodes[4];        // Nodes of the element
  346:    Element *nghbElems[4]; // Neighbors of the element
  347: 
  348:    int kb;                    // Bottom index of the element
  349:    double area;               // Area of the element
  350:    double ssign[4];           // Sign associated with each side of an element
  351:    double radius;             // Element equivalent radii
  352: 
  353:    double wind_angle;         // Wind rotation angle
  354: 
  355:    Frame frame;
  356: 
  357:    Vector2 gradPhi[4];       // Derivatives of shape functions
  358:    Vector2 gradEta[nvrt];    // Gradient of free surface elevation
  359: 
  360:    int idry;                  // True if the element is dry
  361:    int kbe;                   // Bottom index of the element
  362: 
  363:    Vector3 center;            // Element center coordinates
  364:    double xlon_el, ylat_el;   // Element center lat/lon coordinates in _degrees_
  365:    double depth;              // Depth at element (min of all nodes)
  366:    double z[nvrt];            // z-coord  (local frame - vertical up)
  367: 
  368:    // Physical information
  369:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  370: 
  371:    static const bool isblock = false;              // Always false
  372: 
  373:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  374:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  375: 
  376:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  377: 
  378:    
  379: 
  380:    double vsource;            // Volumetric source/sink term [m^3/s]
  381: 
  382:    double rho[nvrt];          // Density at each prism center
  383:    double rho_mean[nvrt];     // Mean density at each prism center
  384:    CubicSpline rho_spl;
  385:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  386:    double rho_z[nvrt];        // First derivative of density at each prism center
  387:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  388: 
  389:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  390: 
  391:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  392:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  393: 
  394:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 1; }
  395:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 1; }
  396: 
  397:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  398:    __inline__ __device__ int nodeLocalIdx(Node *node) const { 
  399:       int res = (nodes[0] == node) ? 0 : ((nodes[1] == node) ? 1 : ((nodes[2] == node) ? 2 : 3)); 
  400:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  401:       return res;
  402:    }
  403: 
  404:    __inline__ __device__ int findLevel(double z1, int k) const {
  405:       // Starting at index k, find sequentially the level that contains z
  406: 
  407:       // if z is already betweeen z[k] and z[k+1], return k
  408:       if (z1 >= z[k] && z1 < z[k+1]) return k;
  409:       else if (z1 < z[k]) { 
  410:          // Search for increasing levels
  411:          for (int kk = k; kk < nvrt - 1; kk++) {
  412:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  413:          }
  414:          return nvrt - 1;
  415:       }
  416:       else {
  417:          // Search for decreasing levels
  418:          for (int kk = k; kk > 0; kk--) {
  419:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  420:          }
  421:          return 0;
  422:       }
  423:    }
  424: 
  425:    __inline__ __device__ double z_prism(int k) const { return 0.5*(z[k+1] + z[k]); }
  426:    __inline__ __device__ double Dz(int k)      const { return z[k+1] - z[k]; }
  427: 
  428:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  429: 
  430:    __inline__ __device__ double computeSignedArea(void) const;
  431: 
  432:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  433:       // Nudges the point (x,y) to the barycenter of the element
  434:       p = (1-eps)*p + eps*toVector2(center);
  435:    }
  436: 
  437:    __device__ bool computeShapeCoords(Point2 xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  438: 
  439:    __device__ Vector2 grad(double *a) const
  440:    {
  441:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  442:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  443:       if (isQuad()) {
  444:          gx += a[3]*gradPhi[3].x;
  445:          gy += a[3]*gradPhi[3].y;
  446:       }
  447:       return {gx, gy};
  448:    }
  449: 
  450:    __device__ void setFrame(void) {
  451: 
  452:       double ar1, ar2;
  453:       computeLonLat(center, ar1, ar2);
  454: 
  455:       frame.update(ar1, ar2);        
  456:     }
  457: 
  458:    __device__ bool findNextIntersection(Point2 x2, Side *&side, Element *&nextElement, double &t, 
  459:                                         double& tIntersect);
  460:    __device__ bool findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement, double &t, 
  461:                                         double& tIntersect);
  462: 
  463:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  464:       // Check if the point (xt,yt) is inside the element
  465:       double shpCoords[4];
  466:       bool res = computeShapeCoords(xt, shpCoords, false);
  467:       return res;
  468:    }
  469: 
  470:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4])
  471:    {
  472:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  473:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  474:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  475:       
  476:    }
  477: 
  478:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int);
  479: 
  480:    // ------------------------------------------------------------------------------------------------
  481:    // These are functions that work on all nodes of the element.
  482:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  483:    //
  484:    // An example of how to use these functions is:
  485:    //   
  486:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  487:    // 
  488:    // Where L is the level at which the field is to be interpolated. The field can be either
  489:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  490:    // There are different versions of getNodalValues for each of these cases.
  491: 
  492:    template<typename T>
  493:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  494:       // Get the values of the field at the nodes of the element
  495:       res[0] = nodes[0]->*field;
  496:       res[1] = nodes[1]->*field;
  497:       res[2] = nodes[2]->*field;
  498:       if (isQuad()) res[3] = nodes[3]->*field;
  499:       else          res[3] = T();
  500:    }
  501: 
  502:    template<typename T>
  503:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  504:       // Get the values of the field at the nodes of the element
  505:       res[0] = (nodes[0]->*field)[level];
  506:       res[1] = (nodes[1]->*field)[level];
  507:       res[2] = (nodes[2]->*field)[level];
  508:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  509:       else          res[3] = T();
  510:    }    
  511: 
  512:    template<typename T>
  513:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  514:       // Get the values of the func at the nodes of the element
  515:       res[0] = (nodes[0]->*func)(level);
  516:       res[1] = (nodes[1]->*func)(level);
  517:       res[2] = (nodes[2]->*func)(level);
  518:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  519:       else          res[3] = T();  // This is 0.0 or a zero vector
  520: 
  521:    }      
  522: 
  523:    template<typename T>
  524:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  525:       // Get the values of the field at the nodes of the element
  526:       res[0] = sides[0]->*field;
  527:       res[1] = sides[1]->*field;
  528:       res[2] = sides[2]->*field;
  529:       if (isQuad()) res[3] = sides[3]->*field;
  530:       else          res[3] = T();
  531:    }
  532: 
  533:    template<typename T>
  534:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  535:       // Get the values of the field at the nodes of the element
  536:       res[0] = (sides[0]->*field)[level];
  537:       res[1] = (sides[1]->*field)[level];
  538:       res[2] = (sides[2]->*field)[level];
  539:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  540:       else          res[3] = T();
  541:    }    
  542: 
  543:    template<typename T>
  544:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  545:       // Get the values of the func at the nodes of the element
  546:       res[0] = (sides[0]->*func)(level);
  547:       res[1] = (sides[1]->*func)(level);
  548:       res[2] = (sides[2]->*func)(level);
  549:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  550:       else          res[3] = T();  // This is 0.0 or a zero vector
  551: 
  552:    }      
  553: 
  554: 
  555:    __device__ double interpolate(int level, const double shapeCoords[4], double (Node::*func)(int) const) const {
  556:       double values[4];
  557:       getNodalValues(level, func, values);
  558: 
  559:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  560:    }
  561: 
  562:    template<typename T>
  563:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  564:       T values[4];
  565:       getNodalValues(field, values);
  566:       
  567:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  568:    }
  569: 
  570: 
  571:    template<typename T>
  572:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  573:       T values[4];
  574:       getNodalValues(level, field, values);
  575: 
  576:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  577:    }
  578: 
  579:    template<typename T>
  580:    __device__ T mean(T Node::* field) const {
  581:       T values[4];
  582:       getNodalValues(field, values);
  583: 
  584:       return (values[0] + values[1] + values[2] + values[3])/i34;
  585:    }
  586: 
  587:    template<typename T>
  588:    __device__ T mean(T Side::* field) const {
  589:       T values[4];
  590:       getSideValues(field, values);
  591:       
  592:       return (values[0] + values[1] + values[2] + values[3])/i34;
  593:    }   
  594: 
  595:    // __device__ double mean(double (Node::*func)(int) const) const {
  596:    //    double values[4];
  597:    //    getNodalValues(level, func, values);
  598:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  599:    // }
  600:    // ------------------------------------------------------------------------------------------------
  601: 
  602:    __device__ bool globalToLocal(double xt, double yt, double &xlocal, double &ylocal) const {
  603:       // Convert global coordinates to local coordinates
  604:       printf("NOT IMPLEMENTED: globalToLocal\n");
  605:       return true;
  606:    }
  607: 
  608:    __inline__ __device__ bool localToGlobal(double xlocal, double ylocal, double &xt, double &yt) const {
  609:       // Convert local coordinates to global coordinates
  610:       printf("NOT IMPLEMENTED: localToGlobal\n");
  611:       return true;
  612:    }
  613: 
  614:    __device__ void trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
  615:                                        double &dt, Point3 &xt, double zint, Vector3 &u_int);
  616:     
  617:    __device__ bool trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
  618:                                                  Element *&nextElem, int &jlev, double &dt);
  619: 
  620: };
