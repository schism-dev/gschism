  898: // This struct is used to store the boundary information for a node.
  899: struct NodeBoundary {   
  900:    BoundarySegment *segment;
  901:    Node *node;
  902:    
  903:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
  904:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
  905: 
  906:    double etaic;  // Elevation at nodes used for essential boundary conditions
  907:    double elbc;   // Elevation boundary condition
  908:    int iettype;   // Type of elevation boundary condition
  909:    double eth;    // Elevation time history
  910: 
  911:    bool isEssentialBC;
  912: 
  913: 
  914:    // Arrays for harmonic constituents (if needed)
  915:    double emo[nbfr];  // Elevation amplitude
  916:    double efa[nbfr];  // Elevation phase
  917:    double umo[nbfr];  // U-velocity amplitude
  918:    double ufa[nbfr];  // U-velocity phase
  919:    double vmo[nbfr];  // V-velocity amplitude
  920:    double vfa[nbfr];  // V-velocity phase 
  921: 
  922:    
  923:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
  924:       assert(index == 0 || index == 1); 
  925:       return (index == 0) ? sideBnd1 : sideBnd2; 
  926:    }
  927: 
  928: 
  929: };
