 3207:    __global__ void computeElevationBoundaryConditions(double ramp, double time) {
 3208:       // Compute elevation essential boundary conditions 
 3209: 
 3210:       NODE_BND(nodeBnd); // Each boundary node.
 3211: 
 3212:       const Node *node = nodeBnd->node;
 3213:       const int iettype = nodeBnd->iettype;
 3214: 
 3215:       double eic = 0.0;
 3216:       if (nramp_elev==1) eic = nodeBnd->etaic;
 3217:       else               eic = 0.0;
 3218: 
 3219:       const double r_eic = (1.0 - ramp)*eic; 
 3220:       const double r_eth = ramp*nodeBnd->eth;
 3221:       double eta1_bar = r_eic;
 3222: 
 3223:       // Compute tide elevation
 3224:       if (iettype == 3 || iettype == 5) {
 3225:         
 3226:          // XXX IMPLEMENT TIDE THINGS
 3227:          assert(true && "Tide elevation not implemented");
 3228:          // for (int jfr=0; jfr<nbfr; jfr++) { // For all tide frequencies
 3229:          //    const int ncyc = int(amig[jfr]*time/(2.0*pi));
 3230:          //    const double arg = amig[jfr]*time - 2.0*pi*ncyc + face[jfr] - efa[i,j,jfr];
 3231:          //    eta1_bar += ramp*ff[jfr]*emo[i,j,jfr]*cos(arg);
 3232:          // } // for jfr
 3233:       } // if iettype
 3234: 
 3235:       switch (iettype) {
 3236:          case 1:
 3237:          case 2:
 3238:             nodeBnd->elbc = r_eth + r_eic;
 3239:             break;
 3240:          case 3:
 3241:             nodeBnd->elbc = eta1_bar + r_eic;
 3242:             break;
 3243:          case 4:
 3244:             nodeBnd->elbc = r_eth + r_eic;
 3245:             break;
 3246:          case 5:
 3247:             nodeBnd->elbc = r_eth + eta1_bar + r_eic;
 3248:             break;
 3249:       } // switch
 3250: 
 3251: 
 3252:       //Add inverse barometric effects
 3253:       if (iettype != 0 && inv_atm_bnd == 1) {
 3254:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 3255:       }
 3256: 
 3257:    }
 3258: 
 3259:    __device__ void computeVerticallyIntegratedVelocity(void) {
 3260: 
 3261:       SIDE(side);
 3262: 
 3263:       side->U = {0.0, 0.0}; 
 3264:          
 3265:       if(side->isDry) return;
 3266: 
 3267:       const Node *node1 = side->n1;
 3268:       const Node *node2 = side->n2;
 3269: 
 3270:       // Vertically integrated velocity U (in ll if ics=2)
 3271:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 3272:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 3273:       }
 3274: 
 3275:    }
 3276: 
 3277:    __global__ void computeBottomDragVegetation(void) {
 3278:       // UNFINISHED. CHECK THIS:
 3279:       // How many kernels are needed? Why so many for loops?
 3280:       // Is the loop on sides needed?
 3281: 
 3282:       NODE(node);
 3283: 
 3284:       const int    kb      = node->kb;
 3285:       const double htot    = node->htot();
 3286:       const double rough   = node->rough;
 3287: 
 3288: 
 3289:       if (node->isDry) {
 3290:          // Default values for dry nodes
 3291:          node->veg_alpha_vert_mean = node->veg_alpha0;
 3292:          /// XXX CHECK INDICES
 3293:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 3294:       }
 3295: 
 3296:       // Compute bottom drag Cd
 3297:       //--------------------------------
 3298: 
 3299:       // nchi = {-1, 0, 1} is the type of bottom drag.
 3300:       if (nchi==1) {
 3301: 
 3302:          bool ltmp = false; // for WBL iteration
 3303: 
 3304:          // Cdmax=-1 !max. Cd at node for this process (info only)
 3305:          // Drag at nodes
 3306:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 3307:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 3308:         
 3309:          const double rough = node->rough;
 3310:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3311:          if (node->rough == 0.0) {
 3312:             node->Cd = 0.0;
 3313: 
 3314:          } else { //roughness >0 
 3315:             
 3316:             const double bthick_ori = node->znl[kb + 1] - node->znl[kb];  // thickness of bottom bnd layer
 3317:             const double bthick = max(dzb_min, bthick_ori);
 3318: 
 3319:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 3320: 
 3321:             double tmp = 1.0/(2.5*log(bthick/rough));
 3322:             node->Cd = tmp*tmp;
 3323: 
 3324:          } // if rough
 3325: 
 3326: 
 3327:          // RECOVER THIS: XXX
 3328:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 3329:          // Output warning for WBL if iteration didn't converge
 3330: 
 3331: 
 3332:       } // nchi==1
 3333: 
 3334:       //   Bottom stress in m^2/s^2
 3335:       if (node->rho[kb + 1] >= -98.0)
 3336:       {
 3337:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 3338:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 3339:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 3340:          // !sediment erosion: this part needs more documentation
 3341:       }
 3342: 
 3343:     
 3344:       // Compute vegetation parameters
 3345:       //--------------------------------
 3346: 
 3347:       // SAV constants
 3348:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 3349:       constexpr double veg_cfpsi = 0.16;
 3350: 
 3351:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 3352:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 3353: 
 3354:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 3355:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 3356:          int kbin = 0; // bin index
 3357:          for (int k = kb; k < nvrt; k++) {
 3358:             // Computes node height above the bottom level
 3359:             const double tmp_h = node->znl[k] - node->znl[kb]; // >=0
 3360:             assert(true && "Vertical variation of vegetation not implemented");
 3361: 
 3362:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 3363:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 3364:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 3365:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 3366:             // } else {
 3367:             //    // Find the bin at which the current vertical level is
 3368:             //    while (kbin<nbins_veg_vert) {
 3369:             //       const double zn = node->znl[kbin];
 3370:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 3371:             //          break;
 3372:             //       } // if
 3373:             //       kbin++;
 3374:             //    } // while
 3375:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 3376: 
 3377:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 3378:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 3379:                
 3380:             //    // Linear interpolation of the vegetation parameters
 3381:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 3382:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 3383:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 3384:             // } // if rl10
 3385: 
 3386:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 3387: 
 3388:          } // for k
 3389: 
 3390: 
 3391:       } else { // Ganthy (iveg=2)
 3392:       //  Modify canopy height, diameter, and density
 3393: 
 3394:          // Make sure there is vegetation on this node
 3395:          if (node->veg_h_unbent > 0.0) {
 3396:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 3397: 
 3398:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 3399:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 3400:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 3401: 
 3402:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 3403:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 3404:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 3405:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 3406:          } // if veg_h_unbent
 3407: 
 3408:          for (int k = 0; k < nvrt; k++) {
 3409:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 3410:          } // for k
 3411:       
 3412: 
 3413:       } // if iveg
 3414:      
 3415:          
 3416: 
 3417:       // Compute vertical mean of veg_alpha3D
 3418:       if (iveg != 0) {
 3419:          const double ztop = node->zTopCanopy(); // Top of the canopy
 3420:          double sum1=0.0;
 3421:          double sum2=0.0;
 3422:          // Integrate over each level under the canopy...
 3423:          for (int k=kb; k<nvrt-1 && node->znl[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 3424:             const double Dz = node->Dz(k);
 3425: 
 3426:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 3427:             sum2 += Dz;
 3428: 
 3429:          } // for k
 3430: 
 3431:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 3432:          else             node->veg_alpha_vert_mean = sum1/sum2;
 3433: 
 3434:       } // if iveg
 3435: 
 3436:       printf("computeBottomDragVegetation: nodeIdx = %d, node->veg_alpha_vert_mean = %f\n", node->idx, node->veg_alpha_vert_mean);
 3437: 
 3438:    }
 3439: 
 3440:    __global__ void computeVegetationAndDragParameters(void) {
 3441:       // Computes the vegetation and drag model parameters:
 3442:       // chi, \tilde\chi, beta, \breve{H}
 3443:       
 3444:       SIDE(side);
 3445: 
 3446:       const double htot = side->htot();
 3447:       const int    kb   = side->kb;
 3448: 
 3449:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 3450: 
 3451:       const double veg_h     = side->veg_h();
 3452:       const double veg_nv    = side->veg_nv();
 3453:       const double veg_c     = side->veg_c();
 3454:       const double veg_beta  = side->veg_beta;
 3455:       const double veg_alpha = side->veg_alpha_vert_mean();
 3456: 
 3457:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 3458:       // Velocity magnitude at the bottom level
 3459:       // XXXX Check if we have add -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 3460:       assert(true && "Must use backtracked velocity");
 3461:       const double vmag1 = length(side->u2[kb + 1]); //BACKTRACKED VELOCITY
 3462:       side->chi2 = side->Cd()*vmag1;
 3463:       side->chi  = side->chi2;
 3464:       if constexpr(iveg != 0) {
 3465:          const Node *n1 = side->n1;
 3466:          const Node *n2 = side->n2;
 3467:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 3468:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 3469:       }
 3470: 
 3471:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 3472: 
 3473:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 3474:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 3475:       double magUa = 0.0;
 3476:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 3477:          // 3D wet side with veg...
 3478: 
 3479:          double magUa = 0.0;
 3480:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 3481:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 3482: 
 3483:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 3484:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 3485:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 3486: 
 3487:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 3488:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 3489: 
 3490:                // Velocity magnitude at the bottom (l) of the level
 3491:                const double ul = length(side->u2[k]);
 3492: 
 3493:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 3494:                magUa += Dz*0.5*(uh + ul);
 3495: 
 3496:             } // if HasVegetation
 3497:          } // for k
 3498:          const double ua = magUa/min(htot, veg_h); // Vertical average
 3499: 
 3500:          // Computes beta, used for computing the stress term at the top of the canopy.      
 3501:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 3502:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 3503:             const double zCpy = side->zTopCanopy();
 3504:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 3505:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 3506:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 3507:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 3508:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 3509:          } // if isSubmerged
 3510:       } // if iveg   
 3511: 
 3512:       // Computes the friction modified depth, \breve{H} in notes
 3513:       if (side->is2D()) { // 2D
 3514: 
 3515:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 3516:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 3517: 
 3518:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 3519: 
 3520:          side->hhat = htot*htot/fricH; 
 3521: 
 3522:       } else { // 3D
 3523:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 3524: 
 3525:          if constexpr(iveg != 0) {
 3526:             
 3527:             if (side->isSubmerged()) { 
 3528:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 3529:                side->hhat -= veg_c*Hhat_alpha;
 3530: 
 3531:             } else { // Emergent
 3532:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 3533:             }
 3534:          } // if iveg
 3535: 
 3536:          // Enforce positivity for 3D model
 3537:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 3538:       } // if 3D
 3539: 
 3540:         
 3541:    }
 3542: 
 3543: 
 3544: 
 3545:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 3546:    // Computes the density gradient between two elements, e1 and e2.
 3547:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 3548:    // zero in the direction normal to the side. 
 3549:    // 
 3550:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 3551:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 3552:    //
 3553:    // Input:
 3554:    //    e1: Element
 3555:    //    e2: Neighbor element (or nullptr if boundary)
 3556:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 3557:    //    k: Index of the half-level at which the density is interpolated
 3558:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 3559:    // 
 3560:    // Output:
 3561:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 3562:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 3563: 
 3564:       if (e2 == nullptr || e2->isDry) {
 3565:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 3566: 
 3567:          Side *side = e1->sides[j];
 3568:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 3569:                  
 3570:          if constexpr(ics == 1) {
 3571:             vec = side->n; // Normal vector to the side
 3572:          } else {
 3573:             // IMPLEMENT THIS XXXXXX
 3574:             // !replace with xel, yel?
 3575:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 3576:             //      &eframe(:,:,i),xn1,yn1,tmp)
 3577:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 3578:             //      &eframe(:,:,i),xn2,yn2,tmp)
 3579:          } //ics
 3580:                    
 3581:          diffRho = 0.0;
 3582: 
 3583:       } else { //internal and wet
 3584:          if constexpr(ics==1) {
 3585:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 3586: 
 3587:             // Vector from e1 to e2
 3588:             vec = toVector2(e2->center - e1->center);
 3589: 
 3590:          } else { 
 3591:             // IMPLEMENT THIS XXXXXX
 3592:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 3593:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 3594:             //                   alow(j)=xctr2
 3595:             //                   bdia(j)=yctr2
 3596:          } // ics
 3597: 
 3598:          diffRho = rho2 - e1->demeanedDensity(k);
 3599:       }
 3600: 
 3601:    }
 3602: 
 3603:    __global__ void computeDensityCubicSplines(void) {
 3604:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 3605: 
 3606:       ELEM(elem);
 3607: 
 3608:       if (elem->isDry) return;
 3609: 
 3610:       const int kb = elem->kb;
 3611: 
 3612:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 3613:       if (elem->is2D()) {
 3614:          // In the 2D case, the density is constant at the prism level. 
 3615:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 3616:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 3617:       } else { //3D
 3618: 
 3619:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 3620:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 3621:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 3622:          ///// XXXX CHECK INDICES!!!!!
 3623:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 3624:       } // 2D/3D
 3625: 
 3626:    }
 3627: } // extern "C"
 3628: 
 3629: 
 3630: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 3631: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 3632: 
 3633:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 3634: 
 3635:    const int kb  = elem->kb;
 3636:    const int kb2 = elem2->kb;
 3637: 
 3638:    // z-coordinate of prism of elem
 3639:    const double zp = elem->z_prism(k);
 3640: 
 3641:    double rho = 0.0;
 3642: 
 3643:    if (elem2->is2D()) {
 3644:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 3645: 
 3646:    } else {  // 3D
 3647: 
 3648:       // eta_min may be < zmax
 3649:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 3650:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 3651: 
 3652:       // (Extrapolate density below bottom, we will fix it later)
 3653:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 3654:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 3655:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 3656:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 3657:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 3658:    } // 2D/3D
 3659:      
 3660: 
 3661:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 3662:    // Now we need to fix it.
 3663:    if (elem->z[k] < elem2->z[kb2]) {
 3664:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 3665: 
 3666:       // There are two methods to adjust the density at the bottom of the element.
 3667:       // iunder_deep=0: 
 3668:       const double depth1 = abs(elem->z[kb]); // larger depth
 3669: 
 3670:       if (iunder_deep==0) {
 3671: 
 3672:          const double weight = max(0.0, min(1.0, (depth1 - h1_bcc)/(h2_bcc - h1_bcc))); // weight
 3673: 
 3674:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 3675: 
 3676:       } else { // iunder_deep != 0
 3677: 
 3678:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 3679: 
 3680:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 3681: 
 3682:          //   Demeaned density at the same z coordinate as
 3683:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 3684:          }
 3685: 
 3686:       } // if iunder_deep
 3687:    } // if elem->z[kb] < elem2->z[kb]
 3688: 
 3689:    return rho;
 3690: }
 3691: 
 3692: 
 3693: extern "C" {
 3694:    __global__ void computeDensityGradient(void) {
 3695: 
 3696:          // Compute the horizontal density gradient at each element.
 3697:       // It works in two steps:
 3698:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 3699:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 3700:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 3701:       //             gradRho.r1 = rho1 - rho0
 3702:       //             gradRho.r2 = rho2 - rho0
 3703:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 3704:       // 
 3705:       //  NOTE: We use de-meaned densities.
 3706: 
 3707:       ELEM(elem);
 3708: 
 3709:       if (elem->isDry) return;
 3710: 
 3711:       const int kb  = elem->kb;
 3712:       const int i34 = elem->i34;
 3713: 
 3714:       for (int k = kb + 1; k < nvrt; k++) {
 3715:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 3716:          //             gradRho.r1 = rho1 - rho0
 3717:          //             gradRho.r2 = rho2 - rho0
 3718:          int icount = 0;
 3719:          double sumRx = 0.0;
 3720:          double sumRy = 0.0;
 3721:          for (int j1=0; j1<i34; j1++) { 
 3722: 
 3723:             const int j2 = elem->nxq(j1 + 1);
 3724: 
 3725:             // Pairs of consecutive neighbor elements of elem
 3726:             const Element *e1 = elem->nghbElems[j1];
 3727:             const Element *e2 = elem->nghbElems[j2];
 3728: 
 3729:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 3730:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 3731:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 3732: 
 3733:             // Compute the density difference and the vector from elem to e1 and e2
 3734:             // getRhoDiffAndVec takes into account boundaries/dry elements
 3735:             double diffRho1, diffRho2;
 3736:             Vector2 vec1, vec2;
 3737:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 3738:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 3739: 
 3740:             const double rl1 = length(vec1);
 3741:             const double rl2 = length(vec2);
 3742:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 3743: 
 3744:             const double delta = cross(vec1, vec2);
 3745:             const double sintheta = abs(delta)/(rl1*rl2);
 3746: 
 3747:             // To avoid problems, avoid elements with small angle between vectors
 3748:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 3749:             const bool validEq = (sintheta > sin_one_deg);
 3750: 
 3751:             if (validEq) {
 3752:                // Solve the system of equations to get the density gradient at elem
 3753:                icount++;
 3754:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 3755:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 3756:                sumRx += Rx;
 3757:                sumRy += Ry;
 3758:             }
 3759:          } // for j1
 3760: 
 3761:          // Compute the average density gradient at elem
 3762:          if (icount==0) {
 3763:            // Bad mesh quality; bail out with 0 b-cc
 3764:            elem->gradRho[k] = {0.0, 0.0};
 3765:          } else {
 3766:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 3767:          }
 3768: 
 3769:       } // for k
 3770: 
 3771:    }
 3772: 
 3773:    __global__ void computeBaroclinicTerm(double rampbc) {
 3774:    // Computes the baroclinic term at sides (at half levels).
 3775:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 3776:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 3777: 
 3778:       SIDE(side);
 3779: 
 3780:       if (side->isDry) return;
 3781: 
 3782:       const Element *e1 = side->elems[0];
 3783:       const Element *e2 = side->elems[1];      
 3784:       const int kb = side->kb;
 3785:       
 3786:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 3787: 
 3788:       // interpolates vertically the density gradient of the two elements at the half level/
 3789: 
 3790:       // Starts the integration at the surface and goes down to the bottom
 3791:       int k1 = nvrt - 1;
 3792:       int k2 = nvrt - 1;
 3793: 
 3794:       side->bcc[nvrt-1] = {0.0, 0.0};
 3795:       for (int k = nvrt-1; k >= kb; k--) {
 3796:       // For each prism level (from surface to bottom)...
 3797: 
 3798:          // For both elements, interpolate density gradient at the side's half level.
 3799:          // The gradient at the side is the average of the gradients at the elements.
 3800:          // w1, w2 are used to take into account boundary sides, with just one element.
 3801:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 3802:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 3803:          w1 = w1/(w1 + w2);
 3804:          w2 = w2/(w1 + w2);
 3805: 
 3806:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 3807: 
 3808:          // Linear interpolation of both elements' density gradient at the shared side's level.
 3809:          Vector2 gradRho = {0.0, 0.0};
 3810:          if (e1 != nullptr && k > kb) {
 3811:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 3812:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 3813:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 3814:             
 3815:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 3816:          }      
 3817:          if (e2 != nullptr && k > kb) {
 3818:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 3819:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 3820:             
 3821:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 3822:          }
 3823: 
 3824:          if constexpr(ics==2) {
 3825:             // IMPLEMENT THIS XXXXXX
 3826:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 3827:             // swild(1)=tmp1
 3828:             // swild(2)=tmp2
 3829:          }
 3830:          
 3831:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 3832:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 3833:          // CHECK INDICES!!! XXX
 3834:          const double grav3 = 0.5*(side->n1->grav2 + side->n2->grav2);
 3835:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 3836:       } // for
 3837: 
 3838:    }
 3839: 
 3840: } // extern "C"
 3841: 
 3842: #ifdef DONTCOMPILE
 3843: __device__ void computeVerticalAdvection(void) {
 3844:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 3845: 
 3846:    sdbt(1:2,:,:)=0.d0
 3847: 
 3848:    const Side *side = FROM kernel;
 3849: 
 3850:    if(side->isDry) return;
 3851: 
 3852:    // If side is wet...
 3853: 
 3854: 
 3855:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 3856:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 3857:    double ws[nvrt] = {} // w @ side
 3858:    int icount = 0;
 3859:    for (int j=0; j<2; j++) {
 3860:       const Element *elem = side->elements[j];
 3861:        
 3862:       if(elem != nullptr) {
 3863:          icount++;
 3864:          for (int k=0; k<nvrt; k++) {
 3865:             ws[k] = ws[k] + elem->w[k];
 3866:          }
 3867:       }
 3868:    }  // for j
 3869: 
 3870:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 3871:    ws = ws/icount;
 3872: 
 3873:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 3874:    // Splines allow for a smooth transition between vertical levels.
 3875:    // Splines have continuity restrictions at the internal knots, but
 3876:    // we have to provide the 1st derivatives at the endpoints.
 3877:    const int kbs = side->kbs; 
 3878:    
 3879:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3880:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3881:    initCubicSpline(kbs, nvrt, side, ws, up)
 3882: 
 3883:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3884:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3885:    initCubicSpline(kbs, nvrt, side, ws, vp)
 3886: 
 3887:    // Total advection (average onto side)
 3888:    const Node *node1 = side->nodes[0];
 3889:    const Node *node2 = side->nodes[1];
 3890:    for (int k=kbs(i); k<nvrt; k++) {
 3891: 
 3892:       if constexpr(ics==1) {
 3893:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 3894:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 3895:       } else {
 3896:          // XXX IMPLEMENT THIS
 3897:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 3898:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 3899:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 3900:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 3901:       }  // if ics
 3902: 
 3903: 
 3904:    }
 3905: }
 3906: #endif
 3907: 
 3908: 
 3909: extern "C" {
 3910:    __global__ void computeElemAverageGhat(double rampbc) {
 3911:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 3912: 
 3913:       ELEM(elem);
 3914:       
 3915:       elem->ghat1= {0.0, 0.0};  
 3916: 
 3917:       if constexpr(ihydraulics != 0) {
 3918:          if (nhtblocks > 0 && elem->isblock) return;
 3919:       }
 3920: 
 3921:       if (elem->isDry) return;
 3922: 
 3923:       // Wet elements.
 3924:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 3925:       // tidal potential, horizontal diffusion, and baroclinic etc
 3926:       // Remember to update both fb and F 
 3927:       // If ics=2, ghat1 are in eframe (ll)
 3928:       // cff1-3: coefficients for 2D/3D
 3929:       Vector2 gradEta = {0.0, 0.0};  // \nabla \eta
 3930:       Vector2 gradPr  = {0.0, 0.0};  // \nabla pressure
 3931:       Vector2 gradETP = {0.0, 0.0};  // \nabla etp
 3932: 
 3933:       double av_cff1 = 0.0;  // av. for cff1
 3934:       double av_cff2 = 0.0;  // av. for cff2
 3935:       double av_cff3 = 0.0;  // av. for cff3
 3936:       double av_df = 0.0;  // av. for H^\alpha / H
 3937:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 3938:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 3939: 
 3940:       const int i34 = elem->i34;
 3941:       const int kb = elem->kb;
 3942: 
 3943:       for (int j=1; j<i34; j++) {
 3944:          // For each node and side in the element...
 3945: 
 3946:          const Node *node = elem->nodes[j];
 3947:          const Side *side = elem->sides[j];
 3948: 
 3949:          const double chi      = side->chi;
 3950:          const double veg_c2   = side->veg_c2;
 3951:          const double veg_beta = side->veg_beta;
 3952:          const double veg_h    = side->veg_h();
 3953:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 3954: 
 3955:          // Node - const in elem
 3956:          gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 3957:          gradPr  += node->pr  *elem->gradPhi[j];
 3958: 
 3959:          if (elem->depth >= tip_dp) {
 3960:            gradETP += node->ETP*elem->gradPhi[j];
 3961:          }
 3962: 
 3963:          
 3964:          const double htot  = side->htot();        // Total depth at the side
 3965:          const double zctr2 = side->zTopCanopy();  
 3966: 
 3967:          double cff1; 
 3968:          double cff2; 
 3969:          double cff3;   
 3970:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 3971:          // coefficients applied to 2D/3D case 
 3972:             cff1 = side->hhat/htot;
 3973:             cff2 = 0.0;
 3974:             cff3 = 0.0;
 3975:          } else { //3D
 3976:             //Init for no-veg case
 3977:             cff1 = 1.0;
 3978:             cff2 = 1.0;
 3979:             cff3 = 0.0;
 3980: 
 3981:             if constexpr(iveg != 0) {
 3982:                // Computes coefficients used with vegetation terms G1, G2
 3983:                // cff1, cff3 are used for the first two terms in G1, G2:
 3984:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 3985:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 3986:                // In general, cff1*Ustar - cff3*Ustar_alpha
 3987:                if(veg_h < 0.99*htot) { // submergent vegetation
 3988:                   cff1=1;
 3989:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 3990:                   cff3 = veg_c;
 3991: 
 3992:                } else { // emergent vegetation
 3993:                   cff1 = 1.0/(1.0 + veg_c2);
 3994:                   cff2 = cff1;
 3995:                   cff3 = 0.0;
 3996: 
 3997:                }
 3998:             } // if iveg
 3999:          } //  2D/3D
 4000: 
 4001:          av_cff1 += cff1/i34;
 4002:          av_cff2 += cff2/i34;
 4003:          av_cff3 += cff3/i34;
 4004:          av_cff2_chi += cff2*chi/i34;
 4005:          av_cff3_chi += cff3*chi/i34;
 4006:          av_df += min(htot, veg_h)/(htot*i34);
 4007: 
 4008: 
 4009:          // btrack values: U^\star, U^{\star\alpha}
 4010:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 4011:          Vector2 Ustar       = {0.0, 0.0}; 
 4012:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 4013:          for (int k = side->kb; k < nvrt; k++) {
 4014:             if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 4015:                Ustar += side->btu[nvrt]*side->Dz(k);
 4016: 
 4017:             } else { //3D
 4018:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 4019:                Ustar += w2;
 4020: 
 4021:                if constexpr(iveg != 0) {
 4022:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 4023:                        const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k)); // For the top of the canopy, ratio of the level that is below the canopy
 4024:                        Ustar_alpha += zrat*w2; // XXXX
 4025:                    }
 4026:                }  // if iveg
 4027:             }  //2/3D
 4028:          }  //k
 4029:          
 4030: 
 4031:          // Add btrack & surface stress terms to \breve{G} first
 4032:          if constexpr(ics==1) {
 4033:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 4034:          } else {
 4035:             // XXX IMPLEMENT THIS
 4036:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 4037:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 4038:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 4039:          }  // if ics
 4040: 
 4041:          // Surface and bottom stress terms
 4042:          if constexpr(ics==1) {
 4043:             const Vector2 tau    = side->tau();
 4044:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 4045: 
 4046:             // Term for surface and bottom stress
 4047:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 4048:          } else {
 4049:             // XXX IMPLEMENT THIS
 4050:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 4051:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 4052:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 4053:             // tau_x=(vn1+tt1)/2.d0
 4054:             // tau_y=(vn2+ss1)/2.d0
 4055:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 4056:          }  // if ics
 4057: 
 4058:          
 4059: 
 4060:          // All terms in F,F^\alpha,f_b except baroclinic
 4061:          // F, f_b: all explicit terms excluding vegetation 
 4062:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 4063:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 4064:          const double coriolis = side->coriolis;
 4065:          Vector2 F  =  coriolis*side->U;  // F_x
 4066:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 4067:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 4068: 
 4069:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 4070:             
 4071:             for (int k = side->kb; k < nvrt; k++) {
 4072:                if (zctr2 > side->zc[k-1]) {
 4073:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 4074:                    const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 4075:                    Fa +=  coriolis*w2*zrat;
 4076:                } // if zctr2
 4077:             } // k
 4078:          } // iveg
 4079: 
 4080:          // Integrate horizontal viscosity force vertically
 4081:          for (int k=side->kb + 1; k<nvrt; k++) {
 4082:             const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.0; 
 4083: 
 4084:             F += levelHorVisc;
 4085: 
 4086:             // Vegetation term
 4087:             if constexpr(iveg!=0) {
 4088:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 4089:                   const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 4090:                   Fa += levelHorVisc*zrat;
 4091:                } 
 4092:             } // if iveg
 4093:          } // for k
 4094: 
 4095:          fb += side->d2uv[side->kb];
 4096: 
 4097: 
 4098:          // Add to ghat1
 4099:          if constexpr(ics==2) {
 4100:             // XXX IMPLEMENT THIS
 4101:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4102:             // bigf1=vn1; bigf2=vn2
 4103:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4104:             // botf1=vn1; botf2=vn2
 4105:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4106:             // bigfa1=vn1; bigfa2=vn2
 4107:          } // if ics
 4108: 
 4109:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 4110:       } // for j (nodes and sides)
 4111: 
 4112:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 4113:          
 4114:       // Finish off terms in F, F^\alpha and f_b
 4115:       const double grav3 = elem->mean(&Node::grav2);
 4116:       const Vector2 fb = grav3*gradETP - gradPr/rho0; //const in each elem
 4117: 
 4118: 
 4119:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 4120:       for (int j=1; j<i34; j++) { 
 4121:          // For each side in the element...
 4122:          const Side *side = elem->sides[j];
 4123:          const double chi = side->chi;
 4124: 
 4125:          const double htot = side->htot();
 4126:          const double veg_h = side->veg_h();
 4127:          const Vector2 F  = htot*fb;
 4128:          const Vector2 Fa = min(htot, veg_h)*fb;
 4129: 
 4130:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 4131:       } // for j
 4132: 
 4133:       //botf1 etc are already in elem frame
 4134:       elem->ghat1 += tmp/i34;
 4135: 
 4136:       // Baroclinic force
 4137:       if constexpr(ibc==0) {
 4138:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 4139: 
 4140:          Vector2 Fa = {0.0, 0.0};
 4141:          Vector2 intGradRho = {0.0, 0.0};
 4142:          
 4143:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 4144:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 4145:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 4146: 
 4147:             // \in F [m^2/s/s]
 4148:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 4149:          }
 4150: 
 4151:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 4152:          const Vector2 F = av_df*Fa; //approx
 4153:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 4154: 
 4155:       } // if ibc
 4156: 
 4157:    }
 4158: 
 4159: } // extern "C"
 4160: 
 4161: 
 4162: 
 4163: #ifdef DONTCOMPILE
 4164: __global__ void checkMassConservation(Tracers* sumtr) {
 4165: 
 4166:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 4167: 
 4168:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 4169: 
 4170:    Element *elem = &(mesh->localElemData[i]);
 4171: 
 4172:    // Skip dry elements
 4173:    if (elem->isDry) return;
 4174: 
 4175:    // Local sum array for this thread
 4176:    double localSum[N_TRACERS] = {0.0};
 4177: 
 4178:    // Sum over vertical levels for this element
 4179:    const int kbe = elem->kbe;
 4180:    const double area = elem->area;
 4181: 
 4182:    for (int k = kbe; k < nvrt; k++) {
 4183:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 4184:       
 4185:       // Accumulate tracer mass
 4186:       for (int tr = 0; tr < N_TRACERS; tr++) {
 4187:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 4188:       }
 4189:    }
 4190: 
 4191:    
 4192: 
 4193:    //  This function returns per element sums. A reduction must be done on the host side.
 4194: }
 4195: 
 4196: 
 4197: __global__ void transport(void) {
 4198: 
 4199:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 4200: 
 4201:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 4202: 
 4203:    Element *elem = &(mesh->localElemData[ie]);
 4204: 
 4205:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 4206: 
 4207:                for (int m=0; m<ntr; m++) {
 4208:                   for (int k=kbe(ie); k<nvrt; k++) {
 4209:                      // Calculate each polynomial's weight 
 4210:                      wm=0.d0; sum1=0.d0; 
 4211:                      wm1=0.d0; wm2=0.d0; 
 4212:                      for (int i=0; i<elem->nweno2; i++) {
 4213:                   
 4214:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4215:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4216:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4217:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4218:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4219:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 4220:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 4221:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 4222:                      // -----------------Hu and Shu (1999)'s method----------------
 4223:                      b4=b1+b2+b3
 4224: 
 4225: //Error: add PRODUCTION CPP
 4226: #ifdef DEBUG
 4227:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 4228:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 4229:                     call parallel_abort(errmsg)
 4230:                   }
 4231: #endif
 4232: 
 4233:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 4234:                   // !----test-------------- 
 4235:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 4236:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 4237:                   // !wm(i)=wm1(i)*wm2(i)
 4238:                   // !---------------------- 
 4239:                   sum1=sum1+wm(i)
 4240:                 } // end for i
 4241: 
 4242:                 wm=wm/sum1
 4243: 
 4244:                 for (int j=0; j<elem->i34; j++) {
 4245: 
 4246:                   const Side *side  = elem->sides[j];
 4247:                   const Node *node1 = side->n1;
 4248:                   const Node *node2 = side->n2;
 4249: 
 4250:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 4251:                      trsd=0.d0
 4252:                      for (int kk=0; kk<nquad; kk++) {
 4253:                         for (int i=0; i<elem->nweno2; i++) {
 4254:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4255:                         } // end for i   
 4256:                      } // end for kk
 4257:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 4258:                   } // outward flux
 4259:                } // end for j=1,i34(ie) ! side
 4260:             }
 4261:          }
 4262:               
 4263: 
 4264: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 4265: //             //   calculate each polynomial's weight 
 4266: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 4267: //                 wm=0.d0; sum1=0.d0
 4268: //                 do i=1,nweno1(ie) !for each polynomial
 4269: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4270: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4271: //                   b1=b1*b1+b2*b2 !smoothness indicator
 4272: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 4273: //                   wm(i)=b2
 4274: //                   sum1=sum1+b2
 4275: //                   !wm(i)=1.d0
 4276: //                   !sum1=sum1+1.d0
 4277: 
 4278: // // Error: PRODUCTION
 4279: // #ifdef DEBUG
 4280: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 4281: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 4282: //                     call parallel_abort(errmsg)
 4283: //                   endif
 4284: // #endif
 4285: 
 4286: //                 enddo !i
 4287: //                 wm=wm/sum1 !final weight
 4288: 
 4289:                 for (int j=0; j<elem->i34; j++) { // side
 4290:                   const Side *side = elem->sides[j];
 4291:                   const Node *node1 = side->n1;
 4292:                   const Node *node2 = side->n2;
 4293: 
 4294:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 4295:                     trsd=0.d0
 4296:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 4297:                       for (int i=0; i<elem->nweno1; i++) {
 4298:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 4299:                       }
 4300:                     enddo //kk
 4301:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 4302:                   } // outward flux
 4303:                 } // end for j=1,i34(ie) ! side
 4304:               } // end for k; ntr 
 4305: 
 4306:             else !simple upwind method
 4307:               do j=1,i34(ie)
 4308:                 jsj=elside(j,ie)
 4309:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 4310:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 4311:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 4312:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 4313:                   endif
 4314:                 enddo  !vertical layers
 4315:               enddo !j=1,i34(ie) ! side
 4316:             endif !order of accuracy
 4317: 
 4318:          //  enddo !ie
 4319: // !$OMP     end do
