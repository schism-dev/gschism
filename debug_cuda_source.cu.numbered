 1762: __host__ __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 1763: 
 1764: __device__ double Node::compZCoord(int k) const {
 1765:    // Computes the z coordinate at level k.
 1766:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 1767:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 1768:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 1769:    // used 
 1770:    
 1771:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 1772:       
 1773:    if (idry) {
 1774:       return 0.0;
 1775:    }
 1776: 
 1777:    if constexpr(ivcor == 2) {
 1778: 
 1779:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 1780:       const int kz = mesh->kz;
 1781: 
 1782:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 1783:       // The FORTAN code computes it every time this function is called, but it should be done only 
 1784:       // once per time step/node.
 1785:       // CHECK: updateZCoordData
 1786:       if (k == kz)               return -hmod2;
 1787:       else if (k == nvrt-1)      return eta2;
 1788:       else if (k == kb)          return -depth;
 1789:       else if (k < kz && k >= 0) return mesh->ztot[k];
 1790:       else if (k > kz) {
 1791:          const int ksig = k - kz + 1;
 1792: 
 1793:          if (hmod2 <= mesh->h_c) {
 1794:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 1795:          } 
 1796:          else if (eta2 <= - mesh->h_c - (depth - mesh->h_c) * mesh->theta_f/mesh->sinh_theta_f) {
 1797:             printf("Please choose larger h_c: %f %f\n", eta2, mesh->h_c);
 1798:             Error("ZCOOR: invalid h_c\n");
 1799:          } 
 1800:          else {
 1801:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 1802:                          mesh->h_c * mesh->sigma[ksig] + 
 1803:                          (hmod2 - mesh->h_c) * mesh->cs[ksig];
 1804:          }
 1805:       } else { 
 1806:          Error("ZCOOR: invalid level or coordinate system\n");
 1807:       }
 1808: 
 1809:    }
 1810:    else if constexpr(ivcor == 1) {
 1811:       if (k == kb) return -depth;
 1812:       else if (k == nvrt-1) return eta2;
 1813:       else if (k >= kb) {
 1814:             return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 1815:       }
 1816:    }
 1817:    
 1818:    printf("ZCOOR: invalid level or coordinate system\n");
 1819:    return 0.0;
 1820: }
 1821: 
 1822: 
 1823: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 1824:                 double *node_coords, double *wind_rotate_angle, 
 1825:                 int *isdel, int *isidenode, int *isbnd,
 1826:                 int *nond, int *nlnd, int *iond, int *ilnd,
 1827:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 1828:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 1829:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 1830:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 1831:                 int *localNodePart,     int *localElemPart,     int *localSidePart) {
 1832: 
 1833:    printf("Populating mesh for partition %d, %d, %d\n", partNum, nond, nlnd);
 1834: 
 1835:    // Horizontal grid
 1836:    printf("Processing %d nodes\n", np);      
 1837:    for (int i = 0; i < np; i++)
 1838:    {
 1839:       Node &node = localNodeData[i];
 1840: 
 1841:       const int idxStart = nodeNeighNodesStart[i];
 1842:       const int idxEnd   = nodeNeighNodesStart[i+1];
 1843:       node.numNodes = idxEnd - idxStart;
 1844:       node.nodes = (Node **)(nodeNeighNodes + idxStart*sizeof(Node *));
 1845:       node.idx = i;
 1846: 
 1847:       for (int idx = idxStart; idx < idxEnd; idx++) {
 1848:          int idxNode = nodeNeighNodesIndices[idx];
 1849:          Node *node_ptr = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 1850: 
 1851:          nodeNeighNodes[idxNode] = node_ptr;
 1852:          node.nodes = &(nodeNeighNodes[idxNode]);
 1853:       }
 1854: 
 1855:       // Element **elements; // pointer to the elements connected to this node
 1856:       // int numElements;   // number of elements shared by this node
 1857: 
 1858:       node.p.x = node_coords[i * 3];
 1859:       node.p.y = node_coords[i * 3 + 1];
 1860:       node.p.z = node_coords[i * 3 + 2];  // XXX this is probably wrong
 1861:       node.depth = node_coords[i * 3 + 2];
 1862: 
 1863:       // Links the node to the boundary information
 1864:       int idxNodeBoundary = 0;
 1865:       if (isbnd[i] >= 0) {
 1866:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 1867:          if (isbnd[i]>0) {
 1868: 
 1869:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 1870:             node.nodeBnd->segment->ifltype = isbnd[i];
 1871: 
 1872:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 1873:             node.nodeBnd->segment->clen  = nan("1");
 1874:             node.nodeBnd->segment->carea = nan("1");
 1875: 
 1876:          }
 1877:          else {
 1878:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 1879:          }
 1880:          
 1881:          idxNodeBoundary++;
 1882:       }
 1883:       else {
 1884:          node.nodeBnd = nullptr;
 1885:       }
 1886: 
 1887: // XXXX
 1888: constexpr double rot_per = 3000.0;
 1889: constexpr double rot_f = 2.0*pi/rot_per;
 1890: for (int k = 0; k < nvrt; k++) {node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0};}
 1891: // XXXXX
 1892:    }
 1893: 
 1894:    printf("Processing %d sides\n", ns);
 1895:    int idxSideBoundary = 0;
 1896:    for (int i = 0; i < ns; i++)
 1897:    {
 1898:       Side &side = localSideData[i];
 1899:       side.idx = i;
 1900:       // finding the pointer to the nodes that form the side
 1901:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 1902:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 1903: 
 1904:       const int locidx_n1 = localNodeIndices[idx_n1];
 1905:       const int locidx_n2 = localNodeIndices[idx_n2];
 1906:       const int part_n1 =   localNodePart[idx_n1];
 1907:       const int part_n2 =   localNodePart[idx_n2];
 1908: 
 1909:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 1910:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 1911: 
 1912:       // Normal vector to the side
 1913:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 1914:       const double norm = sqrt(dot(side.n, side.n));
 1915:       side.n = side.n/norm;
 1916: 
 1917:       // Side boundary type
 1918:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 1919:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 1920:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 1921:       
 1922:       if (n1bnd != nullptr || n2bnd != nullptr) 
 1923:       {
 1924:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 1925:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 1926:          else                  side.sideBnd->segment = n2bnd->segment;
 1927:          side.sideBnd->side = &side;
 1928:          idxSideBoundary++;
 1929:       }
 1930:       else side.sideBnd = nullptr;
 1931: 
 1932:       // finding the pointer to the elements that share the side
 1933:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 1934:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 1935: 
 1936:       if (idx_e1 > -1) {
 1937:          const int locidx_e1 = localElemIndices[idx_e1];
 1938:          const int part_e1 =  localElemPart[idx_e1];
 1939:          side.elems[0] = (Element *)&(elems[part_e1][locidx_e1]);
 1940:       }
 1941:       else {
 1942:          side.elems[0] = nullptr;
 1943:       }
 1944: 
 1945:       if (idx_e2 > -1) {
 1946:          const int locidx_e2 = localElemIndices[idx_e2];
 1947:          const int part_e2 =  localElemPart[idx_e2];
 1948:          side.elems[1] = (Element *)&(elems[part_e2][locidx_e2]);
 1949:       }
 1950:       else {
 1951:          side.elems[1] = nullptr;
 1952:       }
 1953: 
 1954: 
 1955: 
 1956:       // Compute the center of the side
 1957:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 1958: 
 1959: // XXXX
 1960: constexpr double rot_per=3000.0;
 1961: constexpr double rot_f=2.0*pi/rot_per;
 1962: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 1963: // XXXXX      
 1964: 
 1965:       // Compute the z level at the center of the side
 1966:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->znl[k] + side.n2->znl[k]);
 1967: 
 1968:       // Compute the length of the side
 1969:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 1970:       side.length = sqrt(dot(vLen, vLen));
 1971: 
 1972:    }
 1973: 
 1974:    printf("Processing %d elements\n", ne);
 1975:    for (int i = 0; i < ne; i++)
 1976:    {
 1977:       Element &elem = localElemData[i];
 1978:       elem.idx = i;
 1979:       for (int j = 0; j < i34[i]; j++) {
 1980:          const int idxNode = elnode[i*4 + j];  
 1981:          const int idxSide = elside[i*4 + j];
 1982:          
 1983:          elem.nodes[j] = (Node *)&(nodes[localElemPart[idxNode]][localElemIndices[idxNode]]);
 1984:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 1985: 
 1986:          // Find the neighboring element  
 1987:          if (elem.sides[j]->elems[0] == &elem) {
 1988:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 1989:          }
 1990:          else {
 1991:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 1992:          }
 1993:       }
 1994: 
 1995:       
 1996: 
 1997:       elem.i34 = i34[i];
 1998:       elem.wind_angle = wind_rotate_angle[i];
 1999: 
 2000:       // Compute the centroid of the element and its depth
 2001:       Vector2 center = {0.0, 0.0};
 2002:       elem.depth = 0.0;
 2003:       for (int j = 0; j < i34[i]; j++) {
 2004:          center += elem.nodes[j]->p2()/i34[i];
 2005:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2006:       }
 2007:       elem.center.x = center.x;
 2008:       elem.center.y = center.y;
 2009:       
 2010:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2011:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2012: 
 2013:       elem.area = elem.computeSignedArea(); 
 2014:       elem.radius = sqrt(elem.area)/pi; 
 2015:       
 2016:       // Determines which way the normal vector to each side is oriented.
 2017:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2018:       for (int j = 0; j < i34[i]; j++)  
 2019:       {
 2020:          if (elem.sides[j]->elems[0] == &elem) {
 2021:             elem.ssign[j] =  1.0;
 2022:          }
 2023:          else {
 2024:             elem.ssign[j] = -1.0;
 2025:          }
 2026: 
 2027:       }
 2028: 
 2029:       // Derivatives of shape functions
 2030:       //  For ics=2, this is done inside element/ll frame XXX
 2031:       //  For quads, the derivative is evaluated at centroid
 2032:       const int i34 = elem.i34;
 2033:       for (int j = 0; j < i34; j++) {
 2034:          const double area = elem.area;
 2035:          const int id2 = elem.nxq(1 + j);
 2036:          const int id3 = elem.nxq(2 + j);
 2037:          const int id4 = elem.nxq(3 + j);
 2038:          if (elem.isTri()) {
 2039:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2040:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2041:             // da1/dx = (y1 - y2)/(2*area)
 2042:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2043:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2044:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2045:          }
 2046:          else  { // Quad; evaluate at centroid
 2047:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2048:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2049:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2050:          } // if Tri
 2051: 
 2052:       } // for j
 2053: 
 2054:    }
 2055: 
 2056: 
 2057: 
 2058:    
 2059: }
 2060: 
 2061: 
 2062: __global__ void setupCoefficientMatrixAndRHS(double time) {
 2063: // Setup coefficient matrix, sparsem, for the shallow water wave equation
 2064: // No elevation essential b.c. are imposed yet but other b.c. is imposed
 2065: // 
 2066: // This kernel is called for all nodes.
 2067: 
 2068:    int in = 1; //XXX blockIdx.x * blockDim.x + threadIdx.x;
 2069: 
 2070:    Node *node1 = &(mesh->localNodeData[in]);
 2071: 
 2072: 
 2073:    node1->clearMatrixRow();
 2074:    node1->qel = 0.0;
 2075: 
 2076:    // THIS IS FOR STRUCTURES XXX
 2077:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 2078: 
 2079: 
 2080:    for (int j=0; j<node1->numElements; j++) {
 2081:       // For each element connected to the node...
 2082: 
 2083:       Element *elem = node1->elements[j];
 2084: 
 2085: 
 2086:       // Compute the average gravity
 2087:       const double grav3 = elem->mean(&Node::grav2);
 2088: 
 2089:       // Look at the documentation for the description of the terms in the following integrals
 2090: 
 2091:       // Integral I_1 
 2092:       // \bar{\breve{H}} 
 2093:       const double hhatb = elem->mean(&Node::hhat);        
 2094: 
 2095:       assert((hhatb >= 0.0 || ihh != 1) && "Invalid hhat");
 2096: 
 2097:       const int id1 = elem->nodeLocalIdx(node1); 
 2098:       const double area = elem->area;
 2099: 
 2100:       if (elem->isTri()) {
 2101: 
 2102:          // To clarify the notation in this section: 
 2103:          //   i standtimes for the node under consideration (node1)
 2104:          //   j (node2) and k (node3) are the other nodes of the triangle.
 2105:          const int id2 = elem->nxq(1 + id1);
 2106:          const int id3 = elem->nxq(2 + id1);
 2107:          Node *node2 = elem->nodes[id2];
 2108:          Node *node3 = elem->nodes[id3];
 2109: 
 2110:          const Point2 x1 = node1->p2();
 2111:          const Point2 x2 = node2->p2();
 2112:          const Point2 x3 = node3->p2();
 2113: 
 2114:          // integral of phi_i*phi_j
 2115:          const double ipp_ii = (1.0/6.0 )*area;
 2116:          const double ipp_ij = (1.0/12.0)*area;
 2117:          const double ipp_ik = (1.0/12.0)*area;
 2118: 
 2119:          // integral of [(grad phi_i) * (grad phi_j)]
 2120:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 2121:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 2122:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 2123: 
 2124:          // Computes the different components of integral I_1 of each node with respect to node i.
 2125:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 2126:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 2127:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 2128: 
 2129:          node1->addToSparseMatrix(node1, I1_ii);
 2130:          node1->addToSparseMatrix(node2, I1_ij); 
 2131:          node1->addToSparseMatrix(node3, I1_ik);
 2132:      
 2133:       }
 2134:       else { // Quad
 2135:          // XXX IMPLEMENT THIS
 2136:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2137:       } 
 2138: 
 2139:  
 2140:       // Integral I_4
 2141:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 2142:       // Where
 2143:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 2144: 
 2145:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 2146:       // of U over the element.
 2147:       Vector2 Umean = {0.0, 0.0};
 2148:       for (int m=0; m<elem->i34; m++) {      
 2149:          const Side *side = elem->sides[m];
 2150: 
 2151:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 2152:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 2153:       }
 2154:       Umean = Umean/elem->i34;
 2155: 
 2156:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 2157: 
 2158:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 2159:       const double I_4_1 = dot(gradPhi_1, Umean);
 2160: 
 2161:       // Integral of \nabla\phi_i \cdot \pmb{E}
 2162:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 2163:      
 2164:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);
 2165:       
 2166: 
 2167:       // Additional terms 
 2168:       double vnorm = 0.0;
 2169:       if (imm == 2)  { // Pre-compute vnorm on the element
 2170:          Vector3 ubed;
 2171:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 2172: 
 2173:          Vector3 gradP(0.0, 0.0, 1.0);
 2174:          for (int m=0; m < elem->i34; m++) {
 2175:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 2176:            gradP += toVector3(gradP_2D, 0.0);
 2177:          }   
 2178:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 2179:       } // imm==2
 2180: 
 2181:       if (elem->isTri()) {
 2182:          for (int l=0; l<3; l++) {
 2183:            double fac;
 2184: 
 2185:            Node *node = elem->nodes[l];
 2186: 
 2187:            (node == node1)? fac=2.0 : fac=1.0;
 2188: 
 2189:            if (imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 2190:            else        node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 2191:            
 2192:          }
 2193: 
 2194:          if (elem->idry == 0) {
 2195:            const Vector2 gradEta = elem->nodes[0]->eta2*elem->gradPhi[0] +
 2196:                                    elem->nodes[1]->eta2*elem->gradPhi[1] +
 2197:                                    elem->nodes[2]->eta2*elem->gradPhi[2];
 2198: 
 2199:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 2200:          }
 2201: 
 2202:       } // isTri
 2203:       else { // isQuad
 2204:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2205:          // for (int l=0; l<4; l++) {
 2206:          //   const Node *node = elem->nodes[l];
 2207: 
 2208:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 2209:          //   else        tmp2 = node->bdef2 - node->bdef1;
 2210: 
 2211:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 2212:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 2213:          // }
 2214: 
 2215:       } // isQuad
 2216: 
 2217: 
 2218: 
 2219:       node1->qel += (dt/elem->i34)*elem->vsource;
 2220: 
 2221:    } // for all elements connected to the node
 2222:    
 2223: 
 2224: 
 2225:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 2226:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 2227:    NodeBoundary *nodeBnd = node1->nodeBnd;
 2228:    if (nodeBnd != nullptr)  { 
 2229:       // If it is an open boundary node...
 2230: 
 2231:       // At least one open bnd side, maybe two
 2232:       for (int l=0; l<2; l++) { 
 2233: 
 2234:          // Gets each of the sides sharing the node. 
 2235:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 2236: 
 2237:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 2238: 
 2239:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 2240: 
 2241: 
 2242:          if (sideBnd != nullptr) {
 2243:             // If the side is on a boundary...
 2244: 
 2245:             // Get the boundary segment
 2246:             const BoundarySegment *sideSegment = sideBnd->segment;
 2247:             const Side *side = sideBnd->side;
 2248: 
 2249:             // Integral I_3
 2250:             if (sideSegment->ifltype != 0) {
 2251:             // Natural or Flather b.c.
 2252: 
 2253:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 2254:                // especially for Flather b.c.
 2255:                double ri3 = 0.0;
 2256:                if (side->idry != 1) {
 2257:                   // If the side is not dry
 2258:                   
 2259:                   // Computes the side flux of (uth, vth)
 2260:                   double Vn = 0.0;
 2261:                   for (int k = side->kb; k<nvrt-1; k++) {
 2262:                      // uth, vth in lat/lon frame if ics=2
 2263:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 2264:                      const double vn1 = dot(side->uth[k  ], side->n); // outer normal
 2265:                      const double vn2 = dot(side->uth[k+1], side->n);
 2266: 
 2267:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 2268:                   }
 2269: 
 2270:                   ri3 = 0.5*side->length*Vn;
 2271:                }
 2272: 
 2273:                if (sideSegment->ifltype == -1) { // Flather 1
 2274: 
 2275:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 2276:                   assert(side->depth > 0.0 && "Negative depth at Flather boundary");
 2277: 
 2278:                   const double con0 = (1.0/6.0)*side->length*sqrt(grav*side->depth); // For coefficient matrix
 2279:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 2280:                   
 2281:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 2282:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 2283: 
 2284:                } 
 2285:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 2286:                   // Reset ri3
 2287:                   ri3 = 0.0;
 2288: 
 2289:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 2290: 
 2291:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 2292: 
 2293:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 2294:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 2295: 
 2296:                   const double con0 = (1.0/6.0)*side->length*tmp*thetai*dt;
 2297:                   node1->addToSparseMatrix(node1, con0*2.0);
 2298:                   node1->addToSparseMatrix(node2, con0);
 2299: 
 2300:                } // if Flather or Discharge
 2301: 
 2302:                node1->qel -= thetai*dt*ri3;
 2303: 
 2304:             } // I_3
 2305:           
 2306: 
 2307:             // Integral I_5
 2308:             if(side->idry != 1) {
 2309: 
 2310:                const double Unbar = dot(side->U, side->n);
 2311: 
 2312:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->length*Unbar;
 2313:                
 2314:             } // I_5
 2315: 
 2316:          } // if is boundary side
 2317: 
 2318:       } // for l
 2319: 
 2320:    } // if isbnd
 2321: 
 2322: }
 2323: 
 2324: 
 2325: 
 2326: __device__ void backtrackAllNodes(void) {
 2327: 
 2328:    // max/min # of sub-divisions
 2329:    const int ndelt_max = max(1.0, dt/dtb_min);
 2330:    const int ndelt_min = max(1.0, dt/dtb_max); 
 2331: 
 2332:    // Removed all references to swild98 XXX
 2333:    // swild98=0.d0 !init
 2334: 
 2335:    Side *side = FROM kernel;
 2336: 
 2337:    const int kb = side->kb;
 2338:    for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 2339: 
 2340:    if (side->idry == 1) return;
 2341: 
 2342:    // Checks that at least one element is not dry
 2343:    const Element *elem1 = side->elems[0];
 2344:    const Element *elem2 = side->elems[1];
 2345:    assert ((elem1 != nullptr && !(elem1->idry)) || (elem2 != nullptr && !(elem2->idry)) && "backtrackAllNodes: non dry side without two dry elements.");
 2346: 
 2347:    // XXXXXX
 2348:    // !swild_tmp to store global coord. of the starting side
 2349:    // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 2350:    // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 2351:    // !Use sframe2 
 2352:    // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 2353: 
 2354: 
 2355:    for (int k = kb; k < nvrt; k++) {
 2356:    //  Initialize (xt,yt,zt), nnel and vel.
 2357:    //  For ics=2, the coordinates are in local frames
 2358:    //  Caution! nnel must be initialized inside this loop as it is updated inside.
 2359: 
 2360: 
 2361:       const int iadvf = side->iadv();  // Advection flag
 2362: 
 2363:       Point3 xt;
 2364:       if constexpr(ics==1) {
 2365:          xt = side->center3D(k); 
 2366:       }
 2367:       else // lat/lon; in side lat/lon frame
 2368:       {
 2369:       // XXX IMPLEMENT THIS
 2370:    //          xt=0.d0
 2371:    //          yt=0.d0
 2372:    //          !centroid coord. for nudging
 2373:    //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 2374:    //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 2375:       }  // ics
 2376: 
 2377: 
 2378:       // Velocity at the side (in ll frame for ics, same vertical direction)
 2379:       // XXX IS THIS NECESSARY?
 2380:       Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 2381: 
 2382:       // If on land or open boundary...
 2383:       const bool ifl_bnd =  (side->sideBnd != nullptr);
 2384:       
 2385:       const double vmag = length(toVector2(u_int));
 2386: 
 2387:       if (vmag <= velmin_btrack) {
 2388:          // No activity 
 2389: 
 2390:          side->btu[k] = side->u2[k];
 2391: 
 2392: 
 2393:       } else {  // do btrack
 2394: 
 2395:          // Compute number of sub-divisions based on local gradients 
 2396:          // XXX IS THIS NECESSARY?
 2397:          double suma = 0.0;
 2398:          int icount = 0;
 2399:          for (int ii=0; ii<2; ii++) {
 2400: 
 2401:             const Element *elem = side->elems[ii];
 2402:               
 2403:             if (elem == nullptr) continue;
 2404: 
 2405:             icount++;
 2406: 
 2407:             // Not strictly along z; in ll frame for ics=2
 2408: 
 2409:             double utmp[4];
 2410:             double vtmp[4];
 2411:             for (int jj = 0; jj < elem->i34; jj++) {
 2412: 
 2413:                const Node *node = elem->nodes[jj];
 2414: 
 2415:                if constexpr(ics==1) {
 2416:                   utmp[jj] = node->u2[k].x;
 2417:                   vtmp[jj] = node->u2[k].y;  
 2418:                } else {
 2419:                   // XXX IMPLEMENT THIS
 2420:                   // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 2421:                }
 2422:             } // for jj
 2423: 
 2424:             const Vector2 grad_u = elem->grad(utmp); 
 2425:             const Vector2 grad_v = elem->grad(vtmp);
 2426: 
 2427:             suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 2428:          } // for ii
 2429: 
 2430:          assert(icount > 0 && "Impossible 77");
 2431: 
 2432:          // '4' is somewhat arbitrary
 2433:          const int ndelt = max(ndelt_min, min(ndelt_max, int(suma/icount)*4)); // >=1
 2434:          const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 2435: 
 2436: 
 2437:          // Perturb starting pt to avoid underflow 
 2438:          // XXX I don't think this is needed with the current implementation
 2439:          // eps=btrack_nudge
 2440:          // if constexpr(ics==1) {
 2441:          //    xt=(1.d0-eps)*xt+eps*xctr(nnel)
 2442:          //    yt=(1.d0-eps)*yt+eps*yctr(nnel)
 2443:          // } else { //lat/lon
 2444:          //    xt=(1.d0-eps)*xt+eps*xctr2
 2445:          //    yt=(1.d0-eps)*yt+eps*yctr2
 2446:          // } // ics
 2447: 
 2448:       
 2449:          // call btrack(l,ipsgb,ifl_bnd,j,iadvf,swild_tmp,swild10_tmp, dtbk,time_rm,time_rm2,uuint,vvint,wwint,nnel,jlev,xt,yt,zt,swild3,ltmp)
 2450: 
 2451:             
 2452:       } // if vmag (do backtrack)
 2453: 
 2454:    } // for j=jmin,nvrt-1
 2455: 
 2456: }
 2457: 
 2458: template<int nc>
 2459: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 2460: 
 2461: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 2462: //
 2463: // a,b,c,r: input vectors and are not modified by this program.
 2464: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 2465: // r is the r.h.s.
 2466: // n: actual rank of the system.
 2467: // rows in u() and r();
 2468: // u: output with nc columns (transposed to rows)
 2469: // gam: a working array.
 2470: //
 2471: // NOTES:
 2472: // This is a template function that allows for different numbers of columns in the rhs vector.
 2473: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 2474: 
 2475:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 2476:    assert(nc <= nvec   && "TRIDAG: Increase number of columns");
 2477:    assert(b[0] != 0.d0 && "TRIDAG: b[0]=0");
 2478: 
 2479:    double bet = b[0];
 2480:    if constexpr (nc == 1) {
 2481:       u[0] = rhs[0]/bet;
 2482:    } else {
 2483:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 2484:    }
 2485: 
 2486:    for (int j = 1; j < n; j++) {
 2487:       gam[j] = c[j-1]/bet;
 2488:       bet = b[j] - a[j]*gam[j];
 2489: 
 2490:       assert (bet!=0.d0 && "TRIDIAGONAL SOLVER: bet=0");
 2491: 
 2492:       if constexpr (nc == 1) {
 2493:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 2494:       } else {
 2495:          for (int k = 0; k < nc; k++) {
 2496:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 2497:          }
 2498:       }
 2499:    }
 2500: 
 2501:    // Back-substitution
 2502:    for (int j=n-1; j>=1; j--) {
 2503:       if constexpr (nc == 1) {
 2504:          u[j] = u[j] - gam[j+1]*u[j-1];
 2505:       } else {
 2506:          for (int k = 0; k < nc; k++) {
 2507:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 2508:          }
 2509:       }
 2510:    }
 2511: }
 2512: 
 2513: 
 2514: // Helper function that contains the core algorithm
 2515: template<typename XAccessor, typename YAccessor>
 2516: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 2517:                                            double yp_top, double yp_bot, 
 2518:                                            double *yp_out, double *ypp_out) {
 2519:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 2520:    // 
 2521:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 2522:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 2523:    //
 2524:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 2525:    // 
 2526:    // Inputs: 
 2527:    //            n: dimension for x etc; # of data pts (>=2);
 2528:    //            getX, getY: functions to access x,y coordinates
 2529:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 2530:    //     Output: 
 2531:    //            ypp[n]: 2nd derivatives used in interpolation.
 2532:    //             yp[n]: 1st derivatives 
 2533: 
 2534:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 2535: 
 2536:    const int n = k2 - k1 + 1;
 2537:    double a[n];   // Lower diagonal
 2538:    double b[n];   // Diagonal
 2539:    double c[n];   // Upper diagonal
 2540:    double gam[n]; // Gamma, used by the tridiagonal solver
 2541:    double rhs[n]; // Right-hand side
 2542: 
 2543:    for (int k=k1; k<=k2; k++) {
 2544:       if (k == k1) {
 2545:          // Bottom level
 2546:          assert(getX(k+1) - getX(k) != 0.0 && "CUBIC SPLINE: bottom problem");
 2547:          b[k] = (getX(k+1) - getX(k))/3.0;
 2548:          c[k] = b[k]/2.0;
 2549:          rhs[k] = (getY(k+1) - getY(k))/(getX(k+1) - getX(k)) - yp_bot;
 2550:       } else if (k == n - 1) {
 2551:          // Top level (surface)
 2552:          assert(getX(k) - getX(k-1) != 0.0 && "CUBIC SPLINE: surface problem");
 2553:          b[k] = (getX(k) - getX(k-1))/3.0;
 2554:          a[k] = b[k]/2.0;
 2555:          rhs[k] = -(getY(k) - getY(k-1))/(getX(k) - getX(k-1)) + yp_top;
 2556:       } else {
 2557:          // Intermediate levels
 2558:          assert(getX(k) - getX(k-1) != 0.0 && getX(k+1) - getX(k) != 0.0 && "CUBIC SPLINE: middle problem");
 2559:          b[k] = (getX(k+1) - getX(k-1))/3.0;
 2560:          a[k] = (getX(k  ) - getX(k-1))/6.0;
 2561:          c[k] = (getX(k+1) - getX(k  ))/6.0;
 2562:          rhs[k] = (getY(k+1) - getY(k  ))/(getX(k+1) - getX(k  )) - 
 2563:                   (getY(k  ) - getY(k-1))/(getX(k  ) - getX(k-1));
 2564:       }
 2565:    }
 2566: 
 2567:    // Solve the tridiagonal system
 2568:    tridag_sch<1>(n, a, b, c, rhs, ypp_out, gam);
 2569:     
 2570:    yp_out[k1] = yp_bot;
 2571:    yp_out[k2] = yp_top;
 2572: 
 2573:    // Compute rest of 1st derivatives using the splines
 2574:    for (int k=k1+1; k<k2; k++) {
 2575:       yp_out[k] = (getY(k+1) - getY(k))/(getX(k+1) - getX(k)) - 
 2576:                   (getX(k+1) - getX(k))/6.0*(2.0*ypp_out[k] + ypp_out[k+1]);
 2577:    }
 2578: }
 2579: 
 2580: // Array version
 2581: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 2582:                                 double y_top, double y_bot, 
 2583:                                 double *yp_out, double *ypp_out) {
 2584:    auto getX = [x] (int k) { return x[k]; };
 2585:    auto getY = [y] (int k) { return y[k]; };
 2586:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, yp_out, ypp_out);
 2587: }
 2588: 
 2589: // Lambda version - allows custom access patterns
 2590: template<typename XFunc, typename YFunc>
 2591: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 2592:                                        double y_top, double y_bot,
 2593:                                        double *yp_out, double *ypp_out) {
 2594:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, yp_out, ypp_out);
 2595: }
