 1090: // Helper functions for computing the local node index at a given offset from another.
 1091: __device__ __inline__ int nxq(int offset, int index, int size) {
 1092:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1093:    // to the index to make it positive
 1094:    assert(index + offset + 16*size >= 0);
 1095:    return (index + offset + 16*size) % size;  
 1096: }
 1097: 
 1098: __device__ __inline__ int nxq(int index, int size) {
 1099:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1100:    // to the index to make it positive
 1101:    assert(index + 16*size >= 0);
 1102:    return (index + 16*size) % size; 
 1103: }
