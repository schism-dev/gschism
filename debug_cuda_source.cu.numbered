 3620:    __global__ void computeVerticallyIntegratedVelocity(void) {
 3621: 
 3622:       SIDE(side);
 3623: 
 3624: 
 3625:       side->U = {0.0, 0.0}; 
 3626:          
 3627:       if(side->isDry) return;
 3628: 
 3629:       const Node *node1 = side->n1;
 3630:       const Node *node2 = side->n2;
 3631: 
 3632:       // Vertically integrated velocity U (in ll if ics=2)
 3633:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 3634:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 3635:       }
 3636: 
 3637:    }
 3638: 
 3639:    __global__ void computeBottomDragVegetation(void) {
 3640:       // UNFINISHED. CHECK THIS:
 3641:       // How many kernels are needed? Why so many for loops?
 3642:       // Is the loop on sides needed?
 3643: 
 3644:       NODE(node);
 3645: 
 3646:       const int    kb      = node->kb;
 3647:       const double htot    = node->htot();
 3648:       const double rough   = node->rough;
 3649: 
 3650: 
 3651:       if (node->isDry) {
 3652:          // Default values for dry nodes
 3653:          node->veg_alpha_vert_mean = node->veg_alpha0;
 3654:          /// XXX CHECK INDICES
 3655:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 3656:       }
 3657: 
 3658:       // Compute bottom drag Cd
 3659:       //--------------------------------
 3660: 
 3661:       // nchi = {-1, 0, 1} is the type of bottom drag.
 3662:       if (nchi==1) {
 3663: 
 3664:          bool ltmp = false; // for WBL iteration
 3665: 
 3666:          // Cdmax=-1 !max. Cd at node for this process (info only)
 3667:          // Drag at nodes
 3668:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 3669:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 3670:         
 3671:          const double rough = node->rough;
 3672:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3673:          if (node->rough == 0.0) {
 3674:             node->Cd = 0.0;
 3675: 
 3676:          } else { //roughness >0 
 3677:             
 3678:             const double bthick_ori = node->znl[kb + 1] - node->znl[kb];  // thickness of bottom bnd layer
 3679:             const double bthick = max(dzb_min, bthick_ori);
 3680: 
 3681:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 3682: 
 3683:             double tmp = 1.0/(2.5*log(bthick/rough));
 3684:             node->Cd = tmp*tmp;
 3685: 
 3686:          } // if rough
 3687: 
 3688: 
 3689:          // RECOVER THIS: XXX
 3690:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 3691:          // Output warning for WBL if iteration didn't converge
 3692: 
 3693: 
 3694:       } // nchi==1
 3695: 
 3696:       //   Bottom stress in m^2/s^2
 3697:       if (node->rho[kb + 1] >= -98.0)
 3698:       {
 3699:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 3700:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 3701:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 3702:          // !sediment erosion: this part needs more documentation
 3703:       }
 3704: 
 3705:     
 3706:       // Compute vegetation parameters
 3707:       //--------------------------------
 3708: 
 3709:       // SAV constants
 3710:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 3711:       constexpr double veg_cfpsi = 0.16;
 3712: 
 3713:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 3714:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 3715: 
 3716:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 3717:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 3718:          int kbin = 0; // bin index
 3719:          for (int k = kb; k < nvrt; k++) {
 3720:             // Computes node height above the bottom level
 3721:             const double tmp_h = node->znl[k] - node->znl[kb]; // >=0
 3722:             assert(false && "Vertical variation of vegetation not implemented");
 3723: 
 3724:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 3725:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 3726:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 3727:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 3728:             // } else {
 3729:             //    // Find the bin at which the current vertical level is
 3730:             //    while (kbin<nbins_veg_vert) {
 3731:             //       const double zn = node->znl[kbin];
 3732:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 3733:             //          break;
 3734:             //       } // if
 3735:             //       kbin++;
 3736:             //    } // while
 3737:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 3738: 
 3739:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 3740:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 3741:                
 3742:             //    // Linear interpolation of the vegetation parameters
 3743:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 3744:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 3745:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 3746:             // } // if rl10
 3747: 
 3748:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 3749: 
 3750:          } // for k
 3751: 
 3752: 
 3753:       } else { // Ganthy (iveg=2)
 3754:       //  Modify canopy height, diameter, and density
 3755: 
 3756:          // Make sure there is vegetation on this node
 3757:          if (node->veg_h_unbent > 0.0) {
 3758:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 3759: 
 3760:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 3761:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 3762:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 3763: 
 3764:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 3765:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 3766:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 3767:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 3768:          } // if veg_h_unbent
 3769: 
 3770:          for (int k = 0; k < nvrt; k++) {
 3771:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 3772:          } // for k
 3773:       
 3774: 
 3775:       } // if iveg
 3776:      
 3777:          
 3778: 
 3779:       // Compute vertical mean of veg_alpha3D
 3780:       if (iveg != 0) {
 3781:          const double ztop = node->zTopCanopy(); // Top of the canopy
 3782:          double sum1=0.0;
 3783:          double sum2=0.0;
 3784:          // Integrate over each level under the canopy...
 3785:          for (int k=kb; k<nvrt-1 && node->znl[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 3786:             const double Dz = node->Dz(k);
 3787: 
 3788:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 3789:             sum2 += Dz;
 3790: 
 3791:          } // for k
 3792: 
 3793:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 3794:          else             node->veg_alpha_vert_mean = sum1/sum2;
 3795: 
 3796:       } // if iveg
 3797: 
 3798:       printf("computeBottomDragVegetation: nodeIdx = %d, node->veg_alpha_vert_mean = %f\n", node->idx, node->veg_alpha_vert_mean);
 3799: 
 3800:    }
 3801: 
 3802:    __global__ void computeVegetationAndDragParameters(void) {
 3803:       // Computes the vegetation and drag model parameters:
 3804:       // chi, \tilde\chi, beta, \breve{H}
 3805:       
 3806:       SIDE(side);
 3807: 
 3808:       const double htot = side->htot();
 3809:       const int    kb   = side->kb;
 3810: 
 3811:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 3812: 
 3813:       const double veg_h     = side->veg_h();
 3814:       const double veg_nv    = side->veg_nv();
 3815:       const double veg_c     = side->veg_c();
 3816:       const double veg_beta  = side->veg_beta;
 3817:       const double veg_alpha = side->veg_alpha_vert_mean();
 3818: 
 3819:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 3820:       // Velocity magnitude at the bottom level
 3821:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 3822:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 3823:       side->chi2 = side->Cd()*vmag1;
 3824:       side->chi  = side->chi2;
 3825:       if constexpr(iveg != 0) {
 3826:          const Node *n1 = side->n1;
 3827:          const Node *n2 = side->n2;
 3828:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 3829:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 3830:       }
 3831: 
 3832:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 3833: 
 3834:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 3835:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 3836:       double magUa = 0.0;
 3837:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 3838:          // 3D wet side with veg...
 3839: 
 3840:          double magUa = 0.0;
 3841:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 3842:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 3843: 
 3844:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 3845:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 3846:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 3847: 
 3848:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 3849:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 3850: 
 3851:                // Velocity magnitude at the bottom (l) of the level
 3852:                const double ul = length(side->u2[k]);
 3853: 
 3854:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 3855:                magUa += Dz*0.5*(uh + ul);
 3856: 
 3857:             } // if HasVegetation
 3858:          } // for k
 3859:          const double ua = magUa/min(htot, veg_h); // Vertical average
 3860: 
 3861:          // Computes beta, used for computing the stress term at the top of the canopy.      
 3862:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 3863:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 3864:             const double zCpy = side->zTopCanopy();
 3865:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 3866:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 3867:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 3868:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 3869:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 3870:          } // if isSubmerged
 3871:       } // if iveg   
 3872: 
 3873:       // Computes the friction modified depth, \breve{H} in notes
 3874:       if (side->is2D()) { // 2D
 3875: 
 3876:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 3877:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 3878: 
 3879:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 3880: 
 3881:          side->hhat = htot*htot/fricH; 
 3882: 
 3883:       } else { // 3D
 3884:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 3885: 
 3886:          if constexpr(iveg != 0) {
 3887:             
 3888:             if (side->isSubmerged()) { 
 3889:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 3890:                side->hhat -= veg_c*Hhat_alpha;
 3891: 
 3892:             } else { // Emergent
 3893:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 3894:             }
 3895:          } // if iveg
 3896: 
 3897:          // Enforce positivity for 3D model
 3898:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 3899:       } // if 3D
 3900: 
 3901:       printf("computeVegetationAndDragParameters: sideIdx = %d, side->htot = %f, side->hhat = %f\n", side->idx, side->htot(), side->hhat);
 3902: 
 3903:         
 3904:    }
 3905: 
 3906: 
 3907: 
 3908:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 3909:    // Computes the density gradient between two elements, e1 and e2.
 3910:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 3911:    // zero in the direction normal to the side. 
 3912:    // 
 3913:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 3914:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 3915:    //
 3916:    // Input:
 3917:    //    e1: Element
 3918:    //    e2: Neighbor element (or nullptr if boundary)
 3919:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 3920:    //    k: Index of the half-level at which the density is interpolated
 3921:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 3922:    // 
 3923:    // Output:
 3924:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 3925:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 3926: 
 3927:       if (e2 == nullptr || e2->isDry) {
 3928:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 3929: 
 3930:          Side *side = e1->sides[j];
 3931:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 3932:                  
 3933:          if constexpr(ics == 1) {
 3934:             vec = side->n; // Normal vector to the side
 3935:          } else {
 3936:             // IMPLEMENT THIS XXXXXX
 3937:             // !replace with xel, yel?
 3938:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 3939:             //      &eframe(:,:,i),xn1,yn1,tmp)
 3940:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 3941:             //      &eframe(:,:,i),xn2,yn2,tmp)
 3942:          } //ics
 3943:                    
 3944:          diffRho = 0.0;
 3945: 
 3946:       } else { //internal and wet
 3947:          if constexpr(ics==1) {
 3948:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 3949: 
 3950:             // Vector from e1 to e2
 3951:             vec = toVector2(e2->center - e1->center);
 3952: 
 3953:          } else { 
 3954:             // IMPLEMENT THIS XXXXXX
 3955:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 3956:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 3957:             //                   alow(j)=xctr2
 3958:             //                   bdia(j)=yctr2
 3959:          } // ics
 3960: 
 3961:          diffRho = rho2 - e1->demeanedDensity(k);
 3962:       }
 3963: 
 3964:    }
 3965: 
 3966:    __global__ void computeDensityCubicSplines(void) {
 3967:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 3968: 
 3969:       ELEM(elem);
 3970: 
 3971:       if (elem->isDry) return;
 3972: 
 3973:       const int kb = elem->kb;
 3974: 
 3975:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 3976:       if (elem->is2D()) {
 3977:          // In the 2D case, the density is constant at the prism level. 
 3978:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 3979:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 3980:       } else { //3D
 3981: 
 3982:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 3983:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 3984:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 3985:          ///// XXXX CHECK INDICES!!!!!
 3986:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 3987:       } // 2D/3D
 3988: 
 3989:    }
 3990: } // extern "C"
 3991: 
 3992: 
 3993: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 3994: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 3995: 
 3996:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 3997: 
 3998:    const int kb  = elem->kb;
 3999:    const int kb2 = elem2->kb;
 4000: 
 4001:    // z-coordinate of prism of elem
 4002:    const double zp = elem->z_prism(k);
 4003: 
 4004:    double rho = 0.0;
 4005: 
 4006:    if (elem2->is2D()) {
 4007:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4008: 
 4009:    } else {  // 3D
 4010: 
 4011:       // eta_min may be < zmax
 4012:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4013:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4014: 
 4015:       // (Extrapolate density below bottom, we will fix it later)
 4016:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4017:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4018:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4019:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4020:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4021:    } // 2D/3D
 4022:      
 4023: 
 4024:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4025:    // Now we need to fix it.
 4026:    if (elem->z[k] < elem2->z[kb2]) {
 4027:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4028: 
 4029:       // There are two methods to adjust the density at the bottom of the element.
 4030:       // iunder_deep=0: 
 4031:       const double depth1 = abs(elem->z[kb]); // larger depth
 4032: 
 4033:       if (iunder_deep==0) {
 4034: 
 4035:          const double weight = max(0.0, min(1.0, (depth1 - h1_bcc)/(h2_bcc - h1_bcc))); // weight
 4036: 
 4037:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4038: 
 4039:       } else { // iunder_deep != 0
 4040: 
 4041:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4042: 
 4043:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4044: 
 4045:          //   Demeaned density at the same z coordinate as
 4046:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4047:          }
 4048: 
 4049:       } // if iunder_deep
 4050:    } // if elem->z[kb] < elem2->z[kb]
 4051: 
 4052:    return rho;
 4053: }
 4054: 
 4055: 
 4056: extern "C" {
 4057:    __global__ void computeDensityGradient(void) {
 4058: 
 4059:          // Compute the horizontal density gradient at each element.
 4060:       // It works in two steps:
 4061:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4062:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4063:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4064:       //             gradRho.r1 = rho1 - rho0
 4065:       //             gradRho.r2 = rho2 - rho0
 4066:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4067:       // 
 4068:       //  NOTE: We use de-meaned densities.
 4069: 
 4070:       ELEM(elem);
 4071: 
 4072:       if (elem->isDry) return;
 4073: 
 4074:       const int kb  = elem->kb;
 4075:       const int i34 = elem->i34;
 4076: 
 4077:       for (int k = kb + 1; k < nvrt; k++) {
 4078:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 4079:          //             gradRho.r1 = rho1 - rho0
 4080:          //             gradRho.r2 = rho2 - rho0
 4081:          int icount = 0;
 4082:          double sumRx = 0.0;
 4083:          double sumRy = 0.0;
 4084:          for (int j1=0; j1<i34; j1++) { 
 4085: 
 4086:             const int j2 = elem->nxq(j1 + 1);
 4087: 
 4088:             // Pairs of consecutive neighbor elements of elem
 4089:             const Element *e1 = elem->nghbElems[j1];
 4090:             const Element *e2 = elem->nghbElems[j2];
 4091: 
 4092:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 4093:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 4094:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 4095: 
 4096:             // Compute the density difference and the vector from elem to e1 and e2
 4097:             // getRhoDiffAndVec takes into account boundaries/dry elements
 4098:             double diffRho1, diffRho2;
 4099:             Vector2 vec1, vec2;
 4100:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 4101:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 4102: 
 4103:             const double rl1 = length(vec1);
 4104:             const double rl2 = length(vec2);
 4105:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 4106: 
 4107:             const double delta = cross(vec1, vec2);
 4108:             const double sintheta = abs(delta)/(rl1*rl2);
 4109: 
 4110:             // To avoid problems, avoid elements with small angle between vectors
 4111:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 4112:             const bool validEq = (sintheta > sin_one_deg);
 4113: 
 4114:             if (validEq) {
 4115:                // Solve the system of equations to get the density gradient at elem
 4116:                icount++;
 4117:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 4118:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 4119:                sumRx += Rx;
 4120:                sumRy += Ry;
 4121:             }
 4122:          } // for j1
 4123: 
 4124:          // Compute the average density gradient at elem
 4125:          if (icount==0) {
 4126:            // Bad mesh quality; bail out with 0 b-cc
 4127:            elem->gradRho[k] = {0.0, 0.0};
 4128:          } else {
 4129:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 4130:          }
 4131: 
 4132:       } // for k
 4133: 
 4134:    }
 4135: 
 4136:    __global__ void computeBaroclinicTerm(void) {
 4137:    // Computes the baroclinic term at sides (at half levels).
 4138:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 4139:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 4140: 
 4141:       SIDE(side);
 4142: 
 4143:       if (side->isDry) return;
 4144: 
 4145:       const Element *e1 = side->elems[0];
 4146:       const Element *e2 = side->elems[1];      
 4147:       const int kb = side->kb;
 4148:       
 4149:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 4150: 
 4151:       // interpolates vertically the density gradient of the two elements at the half level/
 4152: 
 4153:       // Starts the integration at the surface and goes down to the bottom
 4154:       int k1 = nvrt - 1;
 4155:       int k2 = nvrt - 1;
 4156: 
 4157:       side->bcc[nvrt-1] = {0.0, 0.0};
 4158:       for (int k = nvrt-1; k >= kb; k--) {
 4159:       // For each prism level (from surface to bottom)...
 4160: 
 4161:          // For both elements, interpolate density gradient at the side's half level.
 4162:          // The gradient at the side is the average of the gradients at the elements.
 4163:          // w1, w2 are used to take into account boundary sides, with just one element.
 4164:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 4165:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 4166:          const double wsum = w1 + w2;
 4167:          w1 = w1/wsum;
 4168:          w2 = w2/wsum;
 4169:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 4170: 
 4171:          // Linear interpolation of both elements' density gradient at the shared side's level.
 4172:          Vector2 gradRho = {0.0, 0.0};
 4173:          if (e1 != nullptr && k > kb) {
 4174:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 4175:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 4176:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 4177:             
 4178:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 4179:          }      
 4180:          if (e2 != nullptr && k > kb) {
 4181:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4182:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4183:             
 4184:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4185:          }
 4186: 
 4187:          if constexpr(ics==2) {
 4188:             // IMPLEMENT THIS XXXXXX
 4189:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4190:             // swild(1)=tmp1
 4191:             // swild(2)=tmp2
 4192:          }
 4193:          
 4194:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4195:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4196:          // CHECK INDICES!!! XXX
 4197:          const double grav3 = 0.5*(side->n1->grav2 + side->n2->grav2);
 4198:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4199:       } // for
 4200: 
 4201:    }
 4202: 
 4203: } // extern "C"
 4204: 
 4205: #ifdef DONTCOMPILE
 4206: __device__ void computeVerticalAdvection(void) {
 4207:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 4208: 
 4209:    sdbt(1:2,:,:)=0.d0
 4210: 
 4211:    const Side *side = FROM kernel;
 4212: 
 4213:    if(side->isDry) return;
 4214: 
 4215:    // If side is wet...
 4216: 
 4217: 
 4218:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 4219:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 4220:    double ws[nvrt] = {} // w @ side
 4221:    int icount = 0;
 4222:    for (int j=0; j<2; j++) {
 4223:       const Element *elem = side->elements[j];
 4224:        
 4225:       if(elem != nullptr) {
 4226:          icount++;
 4227:          for (int k=0; k<nvrt; k++) {
 4228:             ws[k] = ws[k] + elem->w[k];
 4229:          }
 4230:       }
 4231:    }  // for j
 4232: 
 4233:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 4234:    ws = ws/icount;
 4235: 
 4236:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 4237:    // Splines allow for a smooth transition between vertical levels.
 4238:    // Splines have continuity restrictions at the internal knots, but
 4239:    // we have to provide the 1st derivatives at the endpoints.
 4240:    const int kbs = side->kbs; 
 4241:    
 4242:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 4243:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 4244:    initCubicSpline(kbs, nvrt, side, ws, up)
 4245: 
 4246:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 4247:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 4248:    initCubicSpline(kbs, nvrt, side, ws, vp)
 4249: 
 4250:    // Total advection (average onto side)
 4251:    const Node *node1 = side->nodes[0];
 4252:    const Node *node2 = side->nodes[1];
 4253:    for (int k=kbs(i); k<nvrt; k++) {
 4254: 
 4255:       if constexpr(ics==1) {
 4256:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 4257:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 4258:       } else {
 4259:          // XXX IMPLEMENT THIS
 4260:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 4261:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 4262:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 4263:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 4264:       }  // if ics
 4265: 
 4266: 
 4267:    }
 4268: }
 4269: #endif
