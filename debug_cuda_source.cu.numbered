  289: struct Tracers {
  290:     double tracer[N_TRACERS];
  291: };
  292: 
  293: 
  294: 
  295: struct Frame {
  296:    double _t[9]; // t stands for tensor.
  297: 
  298:    // Access the tensor in Fortran order
  299:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  300: 
  301:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  302: 
  303:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  304: 
  305:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  306:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  307:       sincos(ar2, &sin_ar2, &cos_ar2);
  308: 
  309:       t(0,0) = -sin_ar1;
  310:       t(1,0) =  cos_ar1;
  311:       t(2,0) =  0.0;
  312:       t(0,1) = -cos_ar1*sin_ar2;
  313:       t(1,1) = -sin_ar1*sin_ar2;
  314: 
  315:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  316: 
  317:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  318:       assert (ar4!=0.0 && "GRID: ar4=0");
  319: 
  320:       const double ar4_inv = 1.0/ar4;
  321:       t(0,1) = t(0,1)*ar4_inv;
  322:       t(1,1) = t(1,1)*ar4_inv;
  323:       t(2,1) = t(2,1)*ar4_inv;
  324: 
  325:       // The third vector is the cross product of the first two
  326:       crossProduct(t(0,0), t(1,0), t(2,0), 
  327:                    t(0,1), t(1,1), t(2,1), 
  328:                    t(0,2), t(1,2), t(2,2));
  329:    }
  330: 
  331: 
  332:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  333:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  334:    // Inputs:
  335:    //        vec0: vel. in this frame;
  336:    //        frameout: Output frame;
  337:    // Output: 
  338:    //        vec1: vel. in new frame  
  339: 
  340:       auto const fo = frameout;
  341:       Vector2 vec1;
  342: 
  343:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  344:       // of t and fo.t are the same.
  345:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  346:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  347: 
  348:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  349:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  350: 
  351:       return vec1;
  352:    }
  353: 
  354:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  355:       // Transform a vector from global to local frame
  356:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  357:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  358:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  359:    }
  360: 
  361:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  362:       // Transform a vector from local to global frame
  363:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  364:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  365:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  366:    }   
  367: 
  368:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  369:    // Tranforms a point from global to local frame     
  370:       G2L(pi - origin0, po);
  371:    }
  372: 
  373:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  374:    // Transforms a point from local to global frame      
  375:       L2G(pi, po);
  376:       po = po + origin0;
  377:    }
  378: 
  379: };
