 1903: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 1904: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 1905: 
 1906: //       if (delta != 0.0) {
