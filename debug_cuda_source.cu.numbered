 5035: __global__ void getStructSizes(int* sizes)  {
 5036:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 5037:       sizes[0] = (int)sizeof(Node);
 5038:       sizes[1] = (int)sizeof(Element);
 5039:       sizes[2] = (int)sizeof(Side);
 5040:       sizes[3] = (int)sizeof(NodeBoundary);
 5041:       sizes[4] = (int)sizeof(SideBoundary);
 5042:       sizes[5] = (int)sizeof(BoundarySegment);
 5043: }
