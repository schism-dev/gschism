 3940:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 3941:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 3942:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 3943:                   endif
 3944:                 enddo  !vertical layers
 3945:               enddo !j=1,i34(ie) ! side
