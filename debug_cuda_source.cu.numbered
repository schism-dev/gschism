 1015: __device__ __inline__ double min3(double a, double b, double c) {
 1016:    return min(a, min(b, c));
 1017: }
 1018: 
 1019: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1020:    return min(a, min(b, min(c, d)));
 1021: }
