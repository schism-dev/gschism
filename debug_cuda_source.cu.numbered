 1131:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1132:       // Compute the different time ramps used in the code 
 1133:       // This function is performed by just one thread
 1134: 
 1135:       if constexpr(ibc == 0) {
 1136:          if (drampbc > 0.0) {
 1137:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1138:          } else {
 1139:             rampbc = 1.0;
 1140:          }
 1141: 
 1142:          if (nws != 0 && drampwind > 0.0) {
 1143:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1144:          } else {
 1145:             rampwind = 1.0;
 1146:          }
 1147:       }
 1148: 
 1149:       if (drampwafo > 0.0) {
 1150:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1151:       } else {
 1152:          rampwafo = 1.0;
 1153:       }
 1154: 
 1155:       // For source/sinks
 1156:       if (if_source && dramp_ss > 0.0) {
 1157:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1158:       } else {
 1159:          ramp_ss = 1.0;
 1160:       }
 1161: 
 1162:       if (dramp > 0.0) {
 1163:          ramp = tanh(2.0*time/86400.0/dramp);
 1164:       } else {
 1165:          ramp = 1.0;
 1166:       }
 1167:    }
