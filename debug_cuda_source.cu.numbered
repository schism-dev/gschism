 2700: __device__ void computeElevationBoundaryConditions(double ramp, double time) {
 2701:    // Compute elevation essential boundary conditions 
 2702: 
 2703:    // In case of border node on >1 bnd with imposed elevation, the bnd with largest segment # prevails.
 2704: 
 2705:    const Node *node = FROM kernel; // A boundary node
 2706:    NodeBoundary *nodeBnd = node->nodeBnd;
 2707:    const int iettype = nodeBnd->iettype;
 2708: 
 2709:    double eic = 0.0;
 2710:    if (nramp_elev==1) eic = nodeBnd->etaic;
 2711:    else               eic = 0.0;
 2712: 
 2713:    const double r_eic = (1.0 - ramp)*eic; 
 2714:    const double r_eth = ramp*nodeBnd->eth;
 2715:    double eta1_bar = r_eic;
 2716: 
 2717:    // Compute tide elevation
 2718:    if (iettype == 3 || iettype == 5) {
 2719:      
 2720:       // XXX IMPLEMENT TIDE THINGS
 2721:       for (int jfr=0; jfr<nbfr; jfr++) { // For all tide frequencies
 2722:          const int ncyc = int(amig[jfr]*time/(2.0*pi));
 2723:          const double arg = amig[jfr]*time - 2.0*pi*ncyc + face[jfr] - efa[i,j,jfr];
 2724:          eta1_bar += ramp*ff[jfr]*emo[i,j,jfr]*cos(arg);
 2725:       } // for jfr
 2726:    } // if iettype
 2727: 
 2728:    switch (iettype) {
 2729:       case 1:
 2730:       case 2:
 2731:          nodeBnd->elbc = r_eth + r_eic;
 2732:          break;
 2733:       case 3:
 2734:          nodeBnd->elbc = eta1_bar + r_eic;
 2735:          break;
 2736:       case 4:
 2737:          nodeBnd->elbc = r_eth + r_eic;
 2738:          break;
 2739:       case 5:
 2740:          nodeBnd->elbc = r_eth + eta1_bar + r_eic;
 2741:          break;
 2742:    } // switch
 2743: 
 2744: 
 2745:    //Add inverse barometric effects
 2746:    if (iettype != 0 && inv_atm_bnd == 1) {
 2747:       nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 2748:    }
 2749: 
 2750: }
