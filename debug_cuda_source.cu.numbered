  256: // Polynomial class
  257: template<int grade>
  258: struct Polynomial {
  259:     // Static assertion to give a clear error message at compile time
  260:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  261: };
  262: 
  263: 
  264: // Explicit specialization for grade 4
  265: template<>
  266: struct Polynomial<4> {
  267:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  268: 
  269:    // Constructor from coefficients
  270:    __device__ __host__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  271: 
  272:    __device__ __host__ __forceinline__ double eval(double x) const {
  273:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  274:    }
  275: };
