 3048:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3049: 
 3050:       NODE_BND(nodeBnd);
 3051: 
 3052:       Node *node = nodeBnd->node;
 3053: 
 3054:       printf("computeTidalPotential: nodeIdx = %d, ntip = %d\n", node->idx, ntip);
 3055:       node->ETP = 0.0;
 3056: 
 3057:       for (int j=0; j<ntip; j++) {
 3058: 
 3059:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3060:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3061:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3062: 
 3063:          if constexpr(iloadtide==1) { // loading tide
 3064:             assert(false && "Loading tide not implemented");
 3065:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3066:          }
 3067:          
 3068:       }
 3069:       
 3070:    }
