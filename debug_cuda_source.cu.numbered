 1141: 
 1142: /**
 1143:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1144:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1145:    If the segment is completely inside the element, then it returns true.
 1146: 
 1147:    This function assumes:
 1148:    - The initial point is on a side of the element. 
 1149:    - Its position is given by parameter t in the range [0,1].
 1150:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1151:       intersects the element (elements are convex).
 1152: 
 1153:    To find the intersection point, this function does the following:
 1154:    - it finds the intersection of the line segment with all the element side lines,
 1155:       except for the one that contains the initial point.
 1156:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1157:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1158:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1159:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1160:       track segment is almost parallel to the element side line.
 1161: 
 1162:    Inputs:
 1163:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1164:    @param x2, y2: other end of the line segment
 1165: 
 1166:    Outputs:
 1167:    @param side:  side that intersects the line segment (input and output)
 1168:    @param nextElement (output): element that contains the intersection point
 1169:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1170:    @param zint (input/output): Vertical coordinate of the intersection point
 1171: 
 1172:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1173:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1174:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1175: 
 1176:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1177:    (Delta) being zero.
 1178: 
 1179:    The intersection2 point happens when:
 1180:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1181:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1182:    
 1183:    Assumption: the 4 points (including those of the side segment) are different.
 1184:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1185:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1186:    If true, (xIntersect,yIntersect) is the intersection.				
 1187:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1188: **/
 1189: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1190:                                               double &t, double& tIntersect) {
 1191: 
 1192:    double closest_intersect_t = 1e10;
 1193:    bool found_intersection = false;
 1194: 
 1195:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1196:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1197:    const Point2 x1 = side->point(t);
 1198:    
 1199: 
 1200:    Side *nextSide = nullptr;
 1201: 
 1202:    for (int i = 0; i < i34; i++) {
 1203: 
 1204:       // Element's i-th side 
 1205:       Side *side2 = sides[i];
 1206: 
 1207:       // Skip the side that contains the initial point
 1208:       if (side2 == side) continue;
 1209: 
 1210:       // (x3,y3)-(x4,y4) is the element side line
 1211:       const Point2 x3 = side2->n1->p2();
 1212:       const Point2 x4 = side2->n2->p2();
 1213: 
 1214:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1215:       const double delta = cross(x2 - x1, x3 - x4);
 1216: 
 1217:       if (delta != 0.0) {
 1218: 
 1219:          const double delta1 = cross(x3 - x1, x3 - x4);
 1220:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1221: 
 1222:          // Solves the two linear equations for tt1 and tt2
 1223:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1224:          const double tt2 = delta2/delta;
 1225: 
 1226:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1227:             closest_intersect_t = min(closest_intersect_t, tt1);
 1228:             nextSide = side2;
 1229: 
 1230:             nextElement = nextSide->otherElem(this);
 1231:             tIntersect = max(small, min(tt1, 1.0-small));
 1232:             t = tt2;
 1233: 
 1234:             found_intersection = true;
 1235:          }
 1236:       
 1237:       }
 1238: 
 1239:    }
 1240: 
 1241: 
 1242:    // found_intersection should always be true, since we checked all the sides.  
 1243:    side = nextSide;
 1244: // if (found_intersection) {
 1245: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1246: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1247: // }   
 1248:    return found_intersection;
 1249: }
 1250: 
 1251: 
 1252: 
 1253: 
 1254: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1255:                                               double &t, double& tIntersect) {
 1256: 
 1257:    double closest_intersect_t = 1e10;
 1258:    bool found_intersection = false;
 1259: 
 1260:    for (int i = 0; i < i34; i++) {
 1261: 
 1262:       Side *side2 = sides[i];
 1263: 
 1264:       // (x3,y3)-(x4,y4) is the element side line
 1265:       const Point2 x3 = side2->n1->p2();
 1266:       const Point2 x4 = side2->n2->p2();
 1267: 
 1268:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1269:       const double delta = cross(x2 - x1, x3 - x4);
 1270: 
 1271:       if (delta != 0.0) {
 1272: 
 1273:          const double delta1 = cross(x3 - x1, x3 - x4);
 1274:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1275: 
 1276:          // Solves the two linear equations for tt1 and tt2
 1277:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1278:          const double tt2 = delta2/delta;
 1279: 
 1280:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1281:             closest_intersect_t = min(closest_intersect_t, tt1);
 1282:             side = side2;
 1283:             nextElement = side->otherElem(this);
 1284:             t = tt2;
 1285:             tIntersect = max(small, min(tt1, 1.0-small));
 1286:             found_intersection = true;
 1287:          }
 1288:       
 1289:       }
 1290: 
 1291:    }
 1292: 
 1293: // if (found_intersection) {
 1294: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1295: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1296: // }
 1297: 
 1298:    // found_intersection should always be true, since we checked all the sides.  
 1299:    return found_intersection;
 1300: }
 1301: 
 1302: 
 1303: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1304:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1305: 
 1306:    printf("Tracking segment goes out of water at element %d\n", curElem->idx);
 1307: 
 1308:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1309:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1310:    // curElement.
 1311: 
 1312:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1313:    // And uses this velocity instead to continue the tracking.
 1314: 
 1315:    // computes the intersection point in cartesian coordinates
 1316:    Point2 intersection = nextSide->p_t(tt);
 1317: 
 1318:    // Nudges the point to the barycenter of the element. 
 1319:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1320:    // next segment intersects the element sides.  
 1321:    curElem->nudgeToBarycenter(intersection);
 1322: 
 1323:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1324:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1325:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1326:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1327: 
 1328:    // If the side is an open boundary, the tangential velocity is zero.
 1329:    if (nextSide->isBnd()) vtan = 0.0;
 1330: 
 1331:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1332:    const double us = vtan*nextSide->t().x;
 1333:    const double vs = vtan*nextSide->t().y;
 1334:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1335: 
 1336:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1337:    const double len2 = length(intersection - toPoint2(xt));
 1338:    const double vel2 = u_int.x*u_int.x + u_int.y*u_int.y;        
 1339:    assert(vel2 > 0.0 && "Zero velocity found");
 1340:    dt = dt - sqrt(len2/vel2); 
 1341: 
 1342:    // The end of this tracking segment is now the intersection point.
 1343:    xt = {intersection.x, intersection.y, zint};
 1344:    
 1345:    u_int = {us, vs, ws};
 1346:    
 1347: }
 1348: 
 1349: /**
 1350:  * Tracks a particle through elements and vertical levels in the mesh.
 1351:  * 
 1352:  * @param x0,y0,z0     Starting position coordinates
 1353:  * @param xt,yt,zt     Target position coordinates
 1354:  * @param dtb          Time step for tracking
 1355:  * @param uuint,vvint,wwint Initial velocity components
 1356:  * @param nextElem     Starting/resulting element index
 1357:  * 
 1358:  * @return Status code of type trackExitCodes
 1359:  * 
 1360:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1361:  * of the details are different. The idea is that the code requires less branches and is better fit
 1362:  * for GPU execution.
 1363:  * 
 1364:  * The main ideas here are:
 1365:  * - The starting point is expected to be in the starting element.
 1366:  * - The end point is guaranteed to be inside an element.
 1367:  * - since the starting point is inside the element, there are only two cases: 
 1368:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1369:  *     (b) it does not and (xt,yt) is already in the starting element.
 1370:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1371:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1372:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1373:  * - tt1 can be positive or negative. We only consider the positive values.
 1374:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1375:  * - The next intersection will occur at the smallest positive tt1.
 1376:  * - This intersection will be the next (x0,y0) position.
 1377:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1378:  *   of getting stuck in a loop.
 1379:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1380:  *   was found.
 1381:  */
 1382: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1383:                                                        Element *&nextElem, int &jlev, double &dt) {
 1384: // printf("trackThroughElementsAndLevels: x0=%f, y0=%f, xt=%f, yt=%f\n", x0, y0, xt, yt);
 1385:    // First thing is to check if the target point is inside the element. If it is there is nothing
 1386:    // else to do.
 1387:    if (containsPoint(toPoint2(xt))) {
 1388:       nextElem->interpolateVelocities(xt, u_int);
 1389:       return true;
 1390:    }
 1391: 
 1392:    Side *side = nullptr;
 1393: 
 1394:    // 1. Initial checks
 1395:    // Verify starting element is valid (wet)
 1396:    assert(!nextElem->idry && "Starting element is dry");
 1397: 
 1398:    // Checks if track has a zero length.
 1399:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1400:    assert(len2 > 0.0 && "Zero length track"); 
 1401:    
 1402: 
 1403:    const int MAX_ITERATIONS = 1000;
 1404:    
 1405:    double t;
 1406:    Side *nextSide = nullptr;
 1407:    double tIntersect = 1e10;
 1408:    double zint = x0.z;
 1409: 
 1410:    // Horizontal tracking loop
 1411:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1412:    // (x0,y0) is inside the element but the target point is not.
 1413:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1414:    assert(found_intersection && "No intersection found");
 1415: 
 1416:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1417: 
 1418:    // if the tracking segment goes out of water (either dry or edge boundary)
 1419:    if (isEdgeBoundary(nextSide) || (nextElem->idry)) {
 1420:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1421:       nextElem = this;
 1422:       
 1423:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1424:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1425:       return true;    
 1426:       }
 1427: 
 1428:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1429:    int iterations = 0;
 1430:    while (iterations < MAX_ITERATIONS) {
 1431:       iterations++;
 1432:       
 1433:       Element *curElem = nextElem;
 1434: 
 1435:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1436:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1437: 
 1438:       // If we are already in the target element, we are done.
 1439:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1440:       if (!found_intersection) break;
 1441: 
 1442: 
 1443:   
 1444:       // if the tracking segment goes out of water (either dry or edge boundary).
 1445:       if (curElem->isEdgeBoundary(nextSide) || (nextElem->idry)) {
 1446: 
 1447:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1448: 
 1449:          nextElem = curElem;
 1450: 
 1451:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1452:          // In this case, the caller (btrack) needs to take into account the remaining time.
 1453:          return true;
 1454:       }
 1455:       
 1456:       // Update position and element for next iteration
 1457:       side = nextSide;
 1458: 
 1459:    }
 1460: 
 1461: 
 1462:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 1463: 
 1464:  
 1465:    // Interpolate velocities at the final position. This is a conceptually simple step,
 1466:    // but the function is not simple, because it has to search for the vertical level containing zt.
 1467:    nextElem->interpolateVelocities(xt, u_int);
 1468: 
 1469: 
 1470:    return true;
 1471: }
 1472: 
 1473: 
 1474: 
 1475: 
 1476: __inline__ __device__ double Element::computeSignedArea(void) const {
 1477:    // Compute the area of the element
 1478: 
 1479:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 1480: 
 1481:    // In the quad case we need to add the area of the other triangle.
 1482:    if (isQuad()) {
 1483:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1484:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 1485:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1486:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 1487:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 1488:          Error("Negative area found in quad element");
 1489:       }
 1490:       res += ar1;
 1491:    }
 1492: 
 1493:    return res;
 1494: }
 1495: 
 1496: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 1497:    // In boundary sides, the element 1 is nullptr
 1498:    return side->elems[1] == nullptr; 
 1499: }
 1500: 
 1501: /**
 1502:    Compute the shape coordinates of the point (xt,yt) in the element.
 1503:    @param xt (input): x-coordinate of the point
 1504:    @param shpCoords (output): shape coordinates of the point
 1505:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 1506:    @return true if the point is inside the element, false otherwise
 1507: **/
 1508: __device__ bool Element::computeShapeCoords(Point2 xt, double shpCoords[4],
 1509:                                             bool fixNegshpCoord) const {
 1510: 
 1511:    // Compute the shape coordinates of the point xt in the element.
 1512:    if (i34==3) {
 1513:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 1514:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 1515:       // and in this case, the pt will be nudged into the element
 1516:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 1517:       // from the local frame, so use additional check.
 1518: 
 1519:       Point2 x0, x1, x2;
 1520: 
 1521:       if constexpr(ics==1) {
 1522:          x0 = nodes[0]->p2();
 1523:          x1 = nodes[1]->p2();
 1524:          x2 = nodes[2]->p2();
 1525:       }
 1526:       else // lat/lon
 1527:       {
 1528:          Error("Not implemented yet");
 1529: #ifdef ICS2
 1530:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 1531:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 1532:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 1533: #endif
 1534:       }
 1535: 
 1536:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 1537:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 1538:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 1539:       shpCoords[3] = 0.0;
 1540:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 1541: 
 1542:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 1543:       // then we fix the negative shape coordinates.
 1544:       if (fixNegshpCoord && tmpmin<=0.0) {
 1545: 
 1546:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 1547:          // keeping the sum of the shape coordinates equal to 1.
 1548:          // I have tested and compared the new algorithm with the old one, and they give
 1549:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 1550:          // The new algorithm should be faster since it is branchless.
 1551:          const double a = - tmpmin + 1.0e-2;  // XXX it used to be 1.0e-4 in the comments of the original code
 1552:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 1553:          
 1554:          shpCoords[0] = (shpCoords[0] + a)*b;
 1555:          shpCoords[1] = (shpCoords[1] + a)*b;
 1556:          shpCoords[2] = (shpCoords[2] + a)*b;          
 1557: 
 1558:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 1559:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 1560:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 1561:          }
 1562: 
 1563:          // Update the point coordinates for the new shape coordinates
 1564:          double xcoords[3] = {x0.x, x1.x, x2.x};
 1565:          double ycoords[3] = {x0.y, x1.y, x2.y};
 1566:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 1567: 
 1568:       }
 1569: 
 1570:       // Check if the point is inside the element
 1571:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 1572:    }
 1573:    else {
 1574:       Error("Not implemented yet");
 1575: #ifdef QUADS
 1576:       // Reproject pt in eframe of nel for ics=2
 1577:       if constexpr(ics==1) {
 1578:          xn2 = xt; 
 1579:          yn2 = yt;
 1580:       }
 1581:       else {
 1582:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 1583:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 1584:       }
 1585: 
 1586:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 1587: #endif
 1588:    }
 1589: 
 1590: }
 1591: 
 1592: 
 1593: /**  Interpolate velocities at a given point (xt,yt,zt)
 1594: 
 1595:    @param xt, yt, zt: coordinates of the point to interpolate
 1596:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 1597: 
 1598:    This is done in four steps:
 1599: 
 1600:    1. Find the shape coordinates for the final position in the element.
 1601:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 1602:    3. Perform a *binary search* to find the vertical level containing zt. It will have to interpolate the 
 1603:       z levels at xt, yt at each step.   
 1604:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 1605:       horizontally and vertically.
 1606: **/
 1607: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) {
 1608:    // Interpolate the velocities at the point xt. 
 1609:    // This function works the same for triangular and quadrilateral elements.
 1610:    double shpCoord[4];
 1611: 
 1612: 
 1613:    // First step is to compute the shape coordinates of (xt,yt)
 1614:    computeShapeCoords(toVector2(xt), shpCoord, false);
 1615:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 1616: 
 1617:    // Second step is to find the level that contains zt
 1618:    // Uses a binary search to find the level
 1619:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 1620:    int L = kbe;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 1621:    int R = nvrt - 1;
 1622: 
 1623:    // Get the z coordinates at the nodes of the element at the levels L and R
 1624:    double zLAtNodes[4], zRAtNodes[4];
 1625:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 1626:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 1627: 
 1628:    double zL = interpolate(shpCoord, zLAtNodes);
 1629:    double zR = interpolate(shpCoord, zRAtNodes);
 1630:    
 1631:    // Interpolates vertically the velocities
 1632:    double wght1, wght2;
 1633:    if (xt.z<=zL) {
 1634:       wght1 = 1.0;
 1635:       wght2 = 0.0;
 1636:    }
 1637:    else if (xt.z>=zR) {
 1638:       wght1 = 0.0;
 1639:       wght2 = 1.0;
 1640:    }
 1641:    else {
 1642:       // Perform a binary search to find the levels between L and R that contain xt.z
 1643:       while (R - L > 1) {
 1644:          int M = (L + R) / 2;
 1645: 
 1646:          double zMAtNodes[4];
 1647:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 1648:          double zM = interpolate(shpCoord, zMAtNodes);
 1649:          if (zM < xt.z) 
 1650:          {
 1651:             L = M;
 1652:             zL = zM;
 1653:          }
 1654:          else 
 1655:          {
 1656:             R = M;
 1657:             zR = zM;
 1658:          }
 1659:       }
 1660:       assert(L == R-1);
 1661:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 1662: 
 1663:       wght2 = (xt.z - zL)/(zR - zL);
 1664:       wght1 = 1.0 - wght2;
 1665:    }
 1666: // printf("$$$ wght1 = %f, wght2 = %f, zt = %f, zL = %f, zR = %f\n", wght1, wght2, zt, zL, zR);
 1667: // printf("$$$ shpCoord = %f, %f, %f, %f\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 1668:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 1669:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 1670: 
 1671:    // Neither of the interpolated velocities should be NaN
 1672:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 1673: 
 1674: }
