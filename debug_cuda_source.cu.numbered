 4529: #ifdef DONTCOMPILE
 4530: __global__ void checkMassConservation(Tracers* sumtr) {
 4531: 
 4532:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 4533: 
 4534:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 4535: 
 4536:    Element *elem = &(mesh->localElemData[i]);
 4537: 
 4538:    // Skip dry elements
 4539:    if (elem->isDry) return;
 4540: 
 4541:    // Local sum array for this thread
 4542:    double localSum[N_TRACERS] = {0.0};
 4543: 
 4544:    // Sum over vertical levels for this element
 4545:    const int kbe = elem->kbe;
 4546:    const double area = elem->area;
 4547: 
 4548:    for (int k = kbe; k < nvrt; k++) {
 4549:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 4550:       
 4551:       // Accumulate tracer mass
 4552:       for (int tr = 0; tr < N_TRACERS; tr++) {
 4553:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 4554:       }
 4555:    }
 4556: 
 4557:    
 4558: 
 4559:    //  This function returns per element sums. A reduction must be done on the host side.
 4560: }
 4561: 
 4562: 
 4563: __global__ void transport(void) {
 4564: 
 4565:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 4566: 
 4567:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 4568: 
 4569:    Element *elem = &(mesh->localElemData[ie]);
 4570: 
 4571:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 4572: 
 4573:                for (int m=0; m<ntr; m++) {
 4574:                   for (int k=kbe(ie); k<nvrt; k++) {
 4575:                      // Calculate each polynomial's weight 
 4576:                      wm=0.d0; sum1=0.d0; 
 4577:                      wm1=0.d0; wm2=0.d0; 
 4578:                      for (int i=0; i<elem->nweno2; i++) {
 4579:                   
 4580:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4581:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4582:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4583:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4584:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4585:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 4586:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 4587:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 4588:                      // -----------------Hu and Shu (1999)'s method----------------
 4589:                      b4=b1+b2+b3
 4590: 
 4591: //Error: add PRODUCTION CPP
 4592: #ifdef DEBUG
 4593:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 4594:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 4595:                     call parallel_abort(errmsg)
 4596:                   }
 4597: #endif
 4598: 
 4599:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 4600:                   // !----test-------------- 
 4601:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 4602:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 4603:                   // !wm(i)=wm1(i)*wm2(i)
 4604:                   // !---------------------- 
 4605:                   sum1=sum1+wm(i)
 4606:                 } // end for i
 4607: 
 4608:                 wm=wm/sum1
 4609: 
 4610:                 for (int j=0; j<elem->i34; j++) {
 4611: 
 4612:                   const Side *side  = elem->sides[j];
 4613:                   const Node *node1 = side->n1;
 4614:                   const Node *node2 = side->n2;
 4615: 
 4616:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 4617:                      trsd=0.d0
 4618:                      for (int kk=0; kk<nquad; kk++) {
 4619:                         for (int i=0; i<elem->nweno2; i++) {
 4620:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4621:                         } // end for i   
 4622:                      } // end for kk
 4623:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 4624:                   } // outward flux
 4625:                } // end for j=1,i34(ie) ! side
 4626:             }
 4627:          }
 4628:               
 4629: 
 4630: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 4631: //             //   calculate each polynomial's weight 
 4632: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 4633: //                 wm=0.d0; sum1=0.d0
 4634: //                 do i=1,nweno1(ie) !for each polynomial
 4635: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4636: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4637: //                   b1=b1*b1+b2*b2 !smoothness indicator
 4638: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 4639: //                   wm(i)=b2
 4640: //                   sum1=sum1+b2
 4641: //                   !wm(i)=1.d0
 4642: //                   !sum1=sum1+1.d0
 4643: 
 4644: // // Error: PRODUCTION
 4645: // #ifdef DEBUG
 4646: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 4647: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 4648: //                     call parallel_abort(errmsg)
 4649: //                   endif
 4650: // #endif
 4651: 
 4652: //                 enddo !i
 4653: //                 wm=wm/sum1 !final weight
 4654: 
 4655:                 for (int j=0; j<elem->i34; j++) { // side
 4656:                   const Side *side = elem->sides[j];
 4657:                   const Node *node1 = side->n1;
 4658:                   const Node *node2 = side->n2;
 4659: 
 4660:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 4661:                     trsd=0.d0
 4662:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 4663:                       for (int i=0; i<elem->nweno1; i++) {
 4664:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 4665:                       }
 4666:                     enddo //kk
 4667:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 4668:                   } // outward flux
 4669:                 } // end for j=1,i34(ie) ! side
 4670:               } // end for k; ntr 
 4671: 
 4672:             else !simple upwind method
 4673:               do j=1,i34(ie)
 4674:                 jsj=elside(j,ie)
 4675:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 4676:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 4677:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 4678:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 4679:                   endif
 4680:                 enddo  !vertical layers
 4681:               enddo !j=1,i34(ie) ! side
 4682:             endif !order of accuracy
 4683: 
 4684:          //  enddo !ie
 4685: // !$OMP     end do
 4686: 
