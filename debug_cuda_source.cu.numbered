 1978: __host__ __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 1979: 
 1980: __device__ double Node::compZCoord(int k) const {
 1981:    // Computes the z coordinate at level k.
 1982:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 1983:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 1984:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 1985:    // used 
 1986:    
 1987:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 1988:       
 1989:    if (idry) {
 1990:       return 0.0;
 1991:    }
 1992: 
 1993:    if constexpr(ivcor == 2) {
 1994: 
 1995:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 1996:       const int kz = mesh->kz;
 1997: 
 1998:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 1999:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2000:       // once per time step/node.
 2001:       // CHECK: updateZCoordData
 2002:       if (k == kz)               return -hmod2;
 2003:       else if (k == nvrt-1)      return eta2;
 2004:       else if (k == kb)          return -depth;
 2005:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2006:       else if (k > kz) {
 2007:          const int ksig = k - kz + 1;
 2008: 
 2009:          if (hmod2 <= mesh->h_c) {
 2010:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2011:          } 
 2012:          else if (eta2 <= - mesh->h_c - (depth - mesh->h_c) * mesh->theta_f/mesh->sinh_theta_f) {
 2013:             printf("Please choose larger h_c: %f %f\n", eta2, mesh->h_c);
 2014:             Error("ZCOOR: invalid h_c\n");
 2015:          } 
 2016:          else {
 2017:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2018:                          mesh->h_c * mesh->sigma[ksig] + 
 2019:                          (hmod2 - mesh->h_c) * mesh->cs[ksig];
 2020:          }
 2021:       } else { 
 2022:          Error("ZCOOR: invalid level or coordinate system\n");
 2023:       }
 2024: 
 2025:    }
 2026:    else if constexpr(ivcor == 1) {
 2027:       if (k == kb) return -depth;
 2028:       else if (k == nvrt-1) return eta2;
 2029:       else if (k >= kb) {
 2030:             return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2031:       }
 2032:    }
 2033:    
 2034:    printf("ZCOOR: invalid level or coordinate system\n");
 2035:    return 0.0;
 2036: }
 2037: 
 2038: 
 2039: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2040:                 double *node_coords, double *wind_rotate_angle, 
 2041:                 int *isdel, int *isidenode, int *isbnd,
 2042:                 int *nond, int *nlnd, int *iond, int *ilnd,
 2043:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2044:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2045:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2046:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2047:                 int *localNodePart,     int *localElemPart,     int *localSidePart) {
 2048: 
 2049:    printf("Populating mesh for partition %d, %d, %d\n", partNum, nond, nlnd);
 2050: 
 2051:    // Horizontal grid
 2052:    printf("Processing %d nodes\n", np);    
 2053:    int idxNodeBoundary = 0;  
 2054:    for (int i = 0; i < np; i++)
 2055:    {
 2056:       Node &node = localNodeData[i];
 2057: 
 2058:       const int idxStart = nodeNeighNodesStart[i];
 2059:       const int idxEnd   = nodeNeighNodesStart[i+1];
 2060:       node.numNodes = idxEnd - idxStart;
 2061:       node.nodes = (Node **)(nodeNeighNodes + idxStart*sizeof(Node *));
 2062:       node.idx = i;
 2063: 
 2064:       for (int idx = idxStart; idx < idxEnd; idx++) {
 2065:          int idxNode = nodeNeighNodesIndices[idx];
 2066:          Node *node_ptr = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 2067: 
 2068:          nodeNeighNodes[idxNode] = node_ptr;
 2069:          node.nodes = &(nodeNeighNodes[idxNode]);
 2070:       }
 2071: 
 2072:       // Element **elements; // pointer to the elements connected to this node
 2073:       // int numElements;   // number of elements shared by this node
 2074: 
 2075:       node.p.x = node_coords[i * 3];
 2076:       node.p.y = node_coords[i * 3 + 1];
 2077:       node.p.z = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2078:       node.depth = node_coords[i * 3 + 2];
 2079: 
 2080:       // Links the node to the boundary information
 2081:       if (isbnd[i] >= 0) {
 2082:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2083:          if (isbnd[i]>0) {
 2084: 
 2085:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2086:             node.nodeBnd->segment->ifltype = isbnd[i];
 2087: 
 2088:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2089:             node.nodeBnd->segment->clen  = nan("1");
 2090:             node.nodeBnd->segment->carea = nan("1");
 2091: 
 2092:          }
 2093:          else {
 2094:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2095:          }
 2096:          
 2097:          idxNodeBoundary++;
 2098:       }
 2099:       else {
 2100:          node.nodeBnd = nullptr;
 2101:       }
 2102: 
 2103: // XXXX
 2104: constexpr double rot_per = 3000.0;
 2105: constexpr double rot_f = 2.0*pi/rot_per;
 2106: for (int k = 0; k < nvrt; k++) {node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0};}
 2107: // XXXXX
 2108:    }
 2109: 
 2110:    nbp = idxNodeBoundary;
 2111: 
 2112:    printf("Processing %d sides\n", ns);
 2113:    int idxSideBoundary = 0;
 2114:    for (int i = 0; i < ns; i++)
 2115:    {
 2116:       Side &side = localSideData[i];
 2117:       side.idx = i;
 2118:       // finding the pointer to the nodes that form the side
 2119:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2120:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2121: 
 2122:       const int locidx_n1 = localNodeIndices[idx_n1];
 2123:       const int locidx_n2 = localNodeIndices[idx_n2];
 2124:       const int part_n1 =   localNodePart[idx_n1];
 2125:       const int part_n2 =   localNodePart[idx_n2];
 2126: 
 2127:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2128:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2129: 
 2130:       // Normal vector to the side
 2131:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2132:       const double norm = sqrt(dot(side.n, side.n));
 2133:       side.n = side.n/norm;
 2134: 
 2135:       // Side boundary type
 2136:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 2137:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 2138:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2139:       
 2140:       if (n1bnd != nullptr || n2bnd != nullptr) 
 2141:       {
 2142:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2143:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2144:          else                  side.sideBnd->segment = n2bnd->segment;
 2145:          side.sideBnd->side = &side;
 2146:          idxSideBoundary++;
 2147:       }
 2148:       else side.sideBnd = nullptr;
 2149: 
 2150:       // finding the pointer to the elements that share the side
 2151:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2152:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2153: 
 2154:       if (idx_e1 > -1) {
 2155:          const int locidx_e1 = localElemIndices[idx_e1];
 2156:          const int part_e1 =  localElemPart[idx_e1];
 2157:          side.elems[0] = (Element *)&(elems[part_e1][locidx_e1]);
 2158:       }
 2159:       else {
 2160:          side.elems[0] = nullptr;
 2161:       }
 2162: 
 2163:       if (idx_e2 > -1) {
 2164:          const int locidx_e2 = localElemIndices[idx_e2];
 2165:          const int part_e2 =  localElemPart[idx_e2];
 2166:          side.elems[1] = (Element *)&(elems[part_e2][locidx_e2]);
 2167:       }
 2168:       else {
 2169:          side.elems[1] = nullptr;
 2170:       }
 2171: 
 2172: 
 2173: 
 2174:       // Compute the center of the side
 2175:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2176: 
 2177: // XXXX
 2178: constexpr double rot_per=3000.0;
 2179: constexpr double rot_f=2.0*pi/rot_per;
 2180: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2181: // XXXXX      
 2182: 
 2183:       // Compute the z level at the center of the side
 2184:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->znl[k] + side.n2->znl[k]);
 2185: 
 2186:       // Compute the length of the side
 2187:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2188:       side.length = sqrt(dot(vLen, vLen));
 2189: 
 2190:    }
 2191: 
 2192:    printf("Processing %d elements\n", ne);
 2193:    for (int i = 0; i < ne; i++)
 2194:    {
 2195:       Element &elem = localElemData[i];
 2196:       elem.idx = i;
 2197:       for (int j = 0; j < i34[i]; j++) {
 2198:          const int idxNode = elnode[i*4 + j];  
 2199:          const int idxSide = elside[i*4 + j];
 2200:          
 2201:          elem.nodes[j] = (Node *)&(nodes[localElemPart[idxNode]][localElemIndices[idxNode]]);
 2202:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2203: 
 2204:          // Find the neighboring element  
 2205:          if (elem.sides[j]->elems[0] == &elem) {
 2206:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2207:          }
 2208:          else {
 2209:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2210:          }
 2211:       }
 2212: 
 2213:       
 2214: 
 2215:       elem.i34 = i34[i];
 2216:       elem.wind_angle = wind_rotate_angle[i];
 2217: 
 2218:       // Compute the centroid of the element and its depth
 2219:       Vector2 center = {0.0, 0.0};
 2220:       elem.depth = 0.0;
 2221:       for (int j = 0; j < i34[i]; j++) {
 2222:          center += elem.nodes[j]->p2()/i34[i];
 2223:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2224:       }
 2225:       elem.center.x = center.x;
 2226:       elem.center.y = center.y;
 2227:       
 2228:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2229:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2230: 
 2231:       elem.area = elem.computeSignedArea(); 
 2232:       elem.radius = sqrt(elem.area)/pi; 
 2233:       
 2234:       // Determines which way the normal vector to each side is oriented.
 2235:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2236:       for (int j = 0; j < i34[i]; j++)  
 2237:       {
 2238:          if (elem.sides[j]->elems[0] == &elem) {
 2239:             elem.ssign[j] =  1.0;
 2240:          }
 2241:          else {
 2242:             elem.ssign[j] = -1.0;
 2243:          }
 2244: 
 2245:       }
 2246: 
 2247:       // Derivatives of shape functions
 2248:       //  For ics=2, this is done inside element/ll frame XXX
 2249:       //  For quads, the derivative is evaluated at centroid
 2250:       const int i34 = elem.i34;
 2251:       for (int j = 0; j < i34; j++) {
 2252:          const double area = elem.area;
 2253:          const int id2 = elem.nxq(1 + j);
 2254:          const int id3 = elem.nxq(2 + j);
 2255:          const int id4 = elem.nxq(3 + j);
 2256:          if (elem.isTri()) {
 2257:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2258:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2259:             // da1/dx = (y1 - y2)/(2*area)
 2260:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2261:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2262:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2263:          }
 2264:          else  { // Quad; evaluate at centroid
 2265:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2266:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2267:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2268:          } // if Tri
 2269: 
 2270:       } // for j
 2271: 
 2272:    }
 2273: 
 2274: 
 2275: 
 2276:    
 2277: }
 2278: 
 2279: 
 2280: __global__ void setupCoefficientMatrixAndRHS(double time) {
 2281: // Setup coefficient matrix, sparsem, for the shallow water wave equation
 2282: // No elevation essential b.c. are imposed yet but other b.c. is imposed
 2283: // 
 2284: // This kernel is called for all nodes.
 2285: 
 2286:    int in = 1; //XXX blockIdx.x * blockDim.x + threadIdx.x;
 2287: 
 2288:    Node *node1 = &(mesh->localNodeData[in]);
 2289: 
 2290: 
 2291:    node1->clearMatrixRow();
 2292:    node1->qel = 0.0;
 2293: 
 2294:    // THIS IS FOR STRUCTURES XXX
 2295:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 2296: 
 2297: 
 2298:    for (int j=0; j<node1->numElements; j++) {
 2299:       // For each element connected to the node...
 2300: 
 2301:       Element *elem = node1->elements[j];
 2302: 
 2303: 
 2304:       // Compute the average gravity
 2305:       const double grav3 = elem->mean(&Node::grav2);
 2306: 
 2307:       // Look at the documentation for the description of the terms in the following integrals
 2308: 
 2309:       // Integral I_1 
 2310:       // \bar{\breve{H}} 
 2311:       const double hhatb = elem->mean(&Side::hhat);        
 2312: 
 2313:       assert((hhatb >= 0.0 || ihh != 1) && "Invalid hhat");
 2314: 
 2315:       const int id1 = elem->nodeLocalIdx(node1); 
 2316:       const double area = elem->area;
 2317: 
 2318:       if (elem->isTri()) {
 2319: 
 2320:          // To clarify the notation in this section: 
 2321:          //   i standtimes for the node under consideration (node1)
 2322:          //   j (node2) and k (node3) are the other nodes of the triangle.
 2323:          const int id2 = elem->nxq(1 + id1);
 2324:          const int id3 = elem->nxq(2 + id1);
 2325:          Node *node2 = elem->nodes[id2];
 2326:          Node *node3 = elem->nodes[id3];
 2327: 
 2328:          const Point2 x1 = node1->p2();
 2329:          const Point2 x2 = node2->p2();
 2330:          const Point2 x3 = node3->p2();
 2331: 
 2332:          // integral of phi_i*phi_j
 2333:          const double ipp_ii = (1.0/6.0 )*area;
 2334:          const double ipp_ij = (1.0/12.0)*area;
 2335:          const double ipp_ik = (1.0/12.0)*area;
 2336: 
 2337:          // integral of [(grad phi_i) * (grad phi_j)]
 2338:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 2339:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 2340:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 2341: 
 2342:          // Computes the different components of integral I_1 of each node with respect to node i.
 2343:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 2344:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 2345:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 2346: 
 2347:          node1->addToSparseMatrix(node1, I1_ii);
 2348:          node1->addToSparseMatrix(node2, I1_ij); 
 2349:          node1->addToSparseMatrix(node3, I1_ik);
 2350:      
 2351:       }
 2352:       else { // Quad
 2353:          // XXX IMPLEMENT THIS
 2354:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2355:       } 
 2356: 
 2357:  
 2358:       // Integral I_4
 2359:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 2360:       // Where
 2361:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 2362: 
 2363:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 2364:       // of U over the element.
 2365:       Vector2 Umean = {0.0, 0.0};
 2366:       for (int m=0; m<elem->i34; m++) {      
 2367:          const Side *side = elem->sides[m];
 2368: 
 2369:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 2370:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 2371:       }
 2372:       Umean = Umean/elem->i34;
 2373: 
 2374:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 2375: 
 2376:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 2377:       const double I_4_1 = dot(gradPhi_1, Umean);
 2378: 
 2379:       // Integral of \nabla\phi_i \cdot \pmb{E}
 2380:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 2381:      
 2382:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);
 2383:       
 2384: 
 2385:       // Additional terms 
 2386:       double vnorm = 0.0;
 2387:       if (imm == 2)  { // Pre-compute vnorm on the element
 2388:          Vector3 ubed;
 2389:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 2390: 
 2391:          Vector3 gradP(0.0, 0.0, 1.0);
 2392:          for (int m=0; m < elem->i34; m++) {
 2393:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 2394:            gradP += toVector3(gradP_2D, 0.0);
 2395:          }   
 2396:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 2397:       } // imm==2
 2398: 
 2399:       if (elem->isTri()) {
 2400:          for (int l=0; l<3; l++) {
 2401:            double fac;
 2402: 
 2403:            Node *node = elem->nodes[l];
 2404: 
 2405:            (node == node1)? fac=2.0 : fac=1.0;
 2406: 
 2407:            if (imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 2408:            else        node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 2409:            
 2410:          }
 2411: 
 2412:          if (elem->idry == 0) {
 2413:            const Vector2 gradEta = elem->nodes[0]->eta2*elem->gradPhi[0] +
 2414:                                    elem->nodes[1]->eta2*elem->gradPhi[1] +
 2415:                                    elem->nodes[2]->eta2*elem->gradPhi[2];
 2416: 
 2417:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 2418:          }
 2419: 
 2420:       } // isTri
 2421:       else { // isQuad
 2422:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2423:          // for (int l=0; l<4; l++) {
 2424:          //   const Node *node = elem->nodes[l];
 2425: 
 2426:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 2427:          //   else        tmp2 = node->bdef2 - node->bdef1;
 2428: 
 2429:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 2430:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 2431:          // }
 2432: 
 2433:       } // isQuad
 2434: 
 2435: 
 2436: 
 2437:       node1->qel += (dt/elem->i34)*elem->vsource;
 2438: 
 2439:    } // for all elements connected to the node
 2440:    
 2441: 
 2442: 
 2443:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 2444:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 2445:    NodeBoundary *nodeBnd = node1->nodeBnd;
 2446:    if (nodeBnd != nullptr)  { 
 2447:       // If it is an open boundary node...
 2448: 
 2449:       // At least one open bnd side, maybe two
 2450:       for (int l=0; l<2; l++) { 
 2451: 
 2452:          // Gets each of the sides sharing the node. 
 2453:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 2454: 
 2455:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 2456: 
 2457:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 2458: 
 2459: 
 2460:          if (sideBnd != nullptr) {
 2461:             // If the side is on a boundary...
 2462: 
 2463:             // Get the boundary segment
 2464:             const BoundarySegment *sideSegment = sideBnd->segment;
 2465:             const Side *side = sideBnd->side;
 2466: 
 2467:             // Integral I_3
 2468:             if (sideSegment->ifltype != 0) {
 2469:             // Natural or Flather b.c.
 2470: 
 2471:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 2472:                // especially for Flather b.c.
 2473:                double ri3 = 0.0;
 2474:                if (side->idry != 1) {
 2475:                   // If the side is not dry
 2476:                   
 2477:                   // Computes the side flux of (uth, vth)
 2478:                   double Vn = 0.0;
 2479:                   for (int k = side->kb; k<nvrt-1; k++) {
 2480:                      // uth, vth in lat/lon frame if ics=2
 2481:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 2482:                      const double vn1 = dot(side->uth[k  ], side->n); // outer normal
 2483:                      const double vn2 = dot(side->uth[k+1], side->n);
 2484: 
 2485:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 2486:                   }
 2487: 
 2488:                   ri3 = 0.5*side->length*Vn;
 2489:                }
 2490: 
 2491:                if (sideSegment->ifltype == -1) { // Flather 1
 2492: 
 2493:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 2494:                   assert(side->depth > 0.0 && "Negative depth at Flather boundary");
 2495: 
 2496:                   const double con0 = (1.0/6.0)*side->length*sqrt(grav*side->depth); // For coefficient matrix
 2497:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 2498:                   
 2499:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 2500:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 2501: 
 2502:                } 
 2503:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 2504:                   // Reset ri3
 2505:                   ri3 = 0.0;
 2506: 
 2507:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 2508: 
 2509:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 2510: 
 2511:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 2512:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 2513: 
 2514:                   const double con0 = (1.0/6.0)*side->length*tmp*thetai*dt;
 2515:                   node1->addToSparseMatrix(node1, con0*2.0);
 2516:                   node1->addToSparseMatrix(node2, con0);
 2517: 
 2518:                } // if Flather or Discharge
 2519: 
 2520:                node1->qel -= thetai*dt*ri3;
 2521: 
 2522:             } // I_3
 2523:           
 2524: 
 2525:             // Integral I_5
 2526:             if(side->idry != 1) {
 2527: 
 2528:                const double Unbar = dot(side->U, side->n);
 2529: 
 2530:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->length*Unbar;
 2531:                
 2532:             } // I_5
 2533: 
 2534:          } // if is boundary side
 2535: 
 2536:       } // for l
 2537: 
 2538:    } // if isbnd
 2539: 
 2540: }
 2541: 
 2542: 
 2543: extern "C" {
 2544:    __global__ void backtrackAllNodes(void) {
 2545: 
 2546:       // max/min # of sub-divisions
 2547:       const int ndelt_max = max(1.0, dt/dtb_min);
 2548:       const int ndelt_min = max(1.0, dt/dtb_max); 
 2549: 
 2550:       // Removed all references to swild98 XXX
 2551:       // swild98=0.d0 !init
 2552: 
 2553:       SIDE(side);
 2554: 
 2555:       if (side - mesh->localSideData >= mesh->ns) return;
 2556: 
 2557:       const int kb = side->kb;
 2558: 
 2559:       // Initialize btrack velocities to the actual velocities at the side 
 2560:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 2561: 
 2562:       if (side->idry == 1) return;
 2563: 
 2564:       // Checks that at least one element is not dry
 2565:       const Element *elem1 = side->elems[0];
 2566:       const Element *elem2 = side->elems[1];
 2567:       assert ((elem1 != nullptr && !(elem1->idry)) || (elem2 != nullptr && !(elem2->idry)) && "backtrackAllNodes: non dry side without two dry elements.");
 2568: 
 2569:       // XXXXXX
 2570:       // !swild_tmp to store global coord. of the starting side
 2571:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 2572:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 2573:       // !Use sframe2 
 2574:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 2575: 
 2576: 
 2577:       for (int k = kb; k < nvrt; k++) {
 2578:       //  Initialize (xt,yt,zt), nnel and vel.
 2579:       //  For ics=2, the coordinates are in local frames
 2580:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 2581: 
 2582: 
 2583:          const int iadvf = side->iadv();  // Advection flag
 2584: 
 2585:          Point3 xt;
 2586:          if constexpr(ics==1) {
 2587:             xt = side->center3D(k); 
 2588:          }
 2589:          else // lat/lon; in side lat/lon frame
 2590:          {
 2591:          // XXX IMPLEMENT THIS
 2592:       //          xt=0.d0
 2593:       //          yt=0.d0
 2594:       //          !centroid coord. for nudging
 2595:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 2596:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 2597:          }  // ics
 2598: 
 2599: 
 2600:          // Velocity at the side (in ll frame for ics, same vertical direction)
 2601:          // XXX IS THIS NECESSARY?
 2602:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 2603: 
 2604:          // If on land or open boundary...
 2605:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 2606:          
 2607:          const double vmag = length(toVector2(u_int));
 2608: 
 2609:          if (vmag <= velmin_btrack) {
 2610:             // No activity 
 2611: 
 2612:             side->btu[k] = side->u2[k];
 2613: 
 2614: 
 2615:          } else {  // do btrack
 2616: 
 2617:             // Compute number of sub-divisions based on local gradients 
 2618:             // XXX IS THIS NECESSARY?
 2619:             double suma = 0.0;
 2620:             int icount = 0;
 2621:             for (int ii=0; ii<2; ii++) {
 2622: 
 2623:                const Element *elem = side->elems[ii];
 2624:                  
 2625:                if (elem == nullptr) continue;
 2626: 
 2627:                icount++;
 2628: 
 2629:                // Not strictly along z; in ll frame for ics=2
 2630: 
 2631:                double utmp[4];
 2632:                double vtmp[4];
 2633:                for (int jj = 0; jj < elem->i34; jj++) {
 2634: 
 2635:                   const Node *node = elem->nodes[jj];
 2636: 
 2637:                   if constexpr(ics==1) {
 2638:                      utmp[jj] = node->u2[k].x;
 2639:                      vtmp[jj] = node->u2[k].y;  
 2640:                   } else {
 2641:                      // XXX IMPLEMENT THIS
 2642:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 2643:                   }
 2644:                } // for jj
 2645: 
 2646:                const Vector2 grad_u = elem->grad(utmp); 
 2647:                const Vector2 grad_v = elem->grad(vtmp);
 2648: 
 2649:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 2650:             } // for ii
 2651: 
 2652:             assert(icount > 0 && "Impossible 77");
 2653: 
 2654:             // '4' is somewhat arbitrary
 2655:             const int ndelt = max(ndelt_min, min(ndelt_max, int(suma/icount)*4)); // >=1
 2656:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 2657: 
 2658: 
 2659:             // Perturb starting pt to avoid underflow 
 2660:             // XXX I don't think this is needed with the current implementation
 2661:             // eps=btrack_nudge
 2662:             // if constexpr(ics==1) {
 2663:             //    xt=(1.d0-eps)*xt+eps*xctr(nnel)
 2664:             //    yt=(1.d0-eps)*yt+eps*yctr(nnel)
 2665:             // } else { //lat/lon
 2666:             //    xt=(1.d0-eps)*xt+eps*xctr2
 2667:             //    yt=(1.d0-eps)*yt+eps*yctr2
 2668:             // } // ics
 2669: 
 2670:          
 2671:             // call btrack(l,ipsgb,ifl_bnd,j,iadvf,swild_tmp,swild10_tmp, dtbk,time_rm,time_rm2,uuint,vvint,wwint,nnel,jlev,xt,yt,zt,swild3,ltmp)
 2672: 
 2673:                
 2674:          } // if vmag (do backtrack)
 2675: 
 2676:       } // for j=jmin,nvrt-1
 2677: 
 2678:    }
 2679: } // extern "C"
 2680: 
 2681: template<int nc>
 2682: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 2683: 
 2684: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 2685: //
 2686: // a,b,c,r: input vectors and are not modified by this program.
 2687: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 2688: // r is the r.h.s.
 2689: // n: actual rank of the system.
 2690: // rows in u() and r();
 2691: // u: output with nc columns (transposed to rows)
 2692: // gam: a working array.
 2693: //
 2694: // NOTES:
 2695: // This is a template function that allows for different numbers of columns in the rhs vector.
 2696: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 2697: 
 2698:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 2699:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 2700: 
 2701:    double bet = b[0];
 2702:    if constexpr (nc == 1) {
 2703:       u[0] = rhs[0]/bet;
 2704:    } else {
 2705:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 2706:    }
 2707: 
 2708:    for (int j = 1; j < n; j++) {
 2709:       gam[j] = c[j-1]/bet;
 2710:       bet = b[j] - a[j]*gam[j];
 2711: 
 2712:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 2713: 
 2714:       if constexpr (nc == 1) {
 2715:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 2716:       } else {
 2717:          for (int k = 0; k < nc; k++) {
 2718:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 2719:          }
 2720:       }
 2721:    }
 2722: 
 2723:    // Back-substitution
 2724:    for (int j=n-1; j>=1; j--) {
 2725:       if constexpr (nc == 1) {
 2726:          u[j] = u[j] - gam[j+1]*u[j-1];
 2727:       } else {
 2728:          for (int k = 0; k < nc; k++) {
 2729:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 2730:          }
 2731:       }
 2732:    }
 2733: }
 2734: 
 2735: 
 2736: 
 2737: 
 2738: // Helper function that contains the core algorithm
 2739: template<typename XAccessor, typename YAccessor>
 2740: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 2741:                                     double  yp_top, double  yp_bot, 
 2742:                                     CubicSpline &spline) {
 2743:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 2744:    // 
 2745:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 2746:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 2747:    //
 2748:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 2749:    // 
 2750:    // Inputs: 
 2751:    //            n: dimension for x etc; # of data pts (>=2);
 2752:    //            getX, getY: functions to access x,y coordinates
 2753:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 2754:    //     Output: 
 2755:    //            spline (CubicSpline): spline structure with x,y,y',y''
 2756: 
 2757:    const int n = k2 - k1 + 1;
 2758:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 2759: 
 2760:    // Allocate memory for the splines
 2761:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 2762:    spline.x   = new double[n];
 2763:    spline.y   = new double[n];
 2764:    spline.yp  = new double[n];
 2765:    spline.ypp = new double[n];
 2766: 
 2767:    for (int k=k1; k<=k2; k++) {
 2768:       spline.x[k] = getX(k);
 2769:       spline.y[k] = getY(k);
 2770:    }
 2771: 
 2772:    // This is to simplify expressions later
 2773:    double *x = spline.x;
 2774:    double *y = spline.y;
 2775: 
 2776:    double *a = nullptr;
 2777:    double *b = nullptr;
 2778:    double *c = nullptr;
 2779:    double *gam = nullptr;
 2780:    double *rhs = nullptr;
 2781:    
 2782: 
 2783:       a = new double[n];   // Lower diagonal
 2784:       b = new double[n];   // Diagonal
 2785:       c = new double[n];   // Upper diagonal
 2786:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 2787:       rhs = new double[n]; // Right-hand side
 2788: 
 2789:    for (int k=k1; k<=k2; k++) {
 2790:       if (k == k1) {
 2791:          // Bottom level
 2792:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 2793:          b[k] = (x[k+1] - x[k])/3.0;
 2794:          c[k] = b[k]/2.0;
 2795:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 2796:       } else if (k == n - 1) {
 2797:          // Top level (surface)
 2798:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 2799:          b[k] = (x[k] - x[k-1])/3.0;
 2800:          a[k] = b[k]/2.0;
 2801:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 2802:       } else {
 2803:          // Intermediate levels
 2804:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 2805:          b[k] = (x[k+1] - x[k-1])/3.0;
 2806:          a[k] = (x[k  ] - x[k-1])/6.0;
 2807:          c[k] = (x[k+1] - x[k  ])/6.0;
 2808:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 2809:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 2810:       }
 2811:    }
 2812: 
 2813:    // Solve the tridiagonal system
 2814:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 2815:    
 2816:    spline.yp[k1] = yp_bot;
 2817:    spline.yp[k2] = yp_top;
 2818: 
 2819:    // Compute rest of 1st derivatives using the splines
 2820:    for (int k=k1+1; k<k2; k++) {
 2821:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 2822:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 2823:    }
 2824:    
 2825:    delete[] a;
 2826:    delete[] b;
 2827:    delete[] c;
 2828:    delete[] gam;
 2829:    delete[] rhs;
 2830: 
 2831: }
 2832: 
 2833: // Array version
 2834: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 2835:                                 double y_top, double y_bot, 
 2836:                                 CubicSpline &spline) {
 2837:    auto getX = [x] (int k) { return x[k]; };
 2838:    auto getY = [y] (int k) { return y[k]; };
 2839:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 2840: }
 2841: 
 2842: // Lambda version - allows custom access patterns
 2843: template<typename XFunc, typename YFunc>
 2844: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 2845:                                 double y_top, double y_bot,
 2846:                                 CubicSpline &spline) {
 2847:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 2848: }
 2849: 
 2850: 
 2851: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 2852: {
 2853:    assert("Not implemented");
 2854: 
 2855:    return 0.0;
 2856: }
