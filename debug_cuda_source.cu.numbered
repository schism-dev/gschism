 2910: 
 2911: __device__ void computeBottomDragVegetation(void) {
 2912:    // UNFINISHED. CHECK THIS:
 2913:    // How many kernels are needed? Why so many for loops?
 2914:    // Is the loop on sides needed?
 2915: 
 2916:    Node *node = NODE_PTR;
 2917: 
 2918:    const int    kb      = node->kb;
 2919:    const double htot    = node->htot();
 2920:    const double rough   = node->rough;
 2921: 
 2922: 
 2923:    if (node->idry) {
 2924:       // Default values for dry nodes
 2925:       node->veg_alpha_vert_mean = node->veg_alpha0;
 2926:       /// XXX CHECK INDICES
 2927:       if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 2928:    }
 2929: 
 2930:    // Compute bottom drag Cd
 2931:    //--------------------------------
 2932: 
 2933:    // nchi = {-1, 0, 1} is the type of bottom drag.
 2934:    if (nchi==1) {
 2935: 
 2936:       bool ltmp = false; // for WBL iteration
 2937: 
 2938:       // Cdmax=-1 !max. Cd at node for this process (info only)
 2939:       // Drag at nodes
 2940: /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 2941: // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 2942:      
 2943:       const double rough = node->rough;
 2944:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 2945:       if (node->rough == 0.0) {
 2946:          node->Cd = 0.0;
 2947: 
 2948:       } else { //roughness >0 
 2949:          
 2950:          const double bthick_ori = node->znl[kb + 1] - node->znl[kb];  // thickness of bottom bnd layer
 2951:          const double bthick = max(dzb_min, bthick_ori);
 2952: 
 2953:          assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 2954: 
 2955:          double tmp = 1.0/(2.5*log(bthick/rough));
 2956:          node->Cd = tmp*tmp;
 2957: 
 2958:       } // if rough
 2959: 
 2960: 
 2961:       // RECOVER THIS: XXX
 2962:       // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 2963:       // Output warning for WBL if iteration didn't converge
 2964: 
 2965: 
 2966:    } // nchi==1
 2967: 
 2968:    //   Bottom stress in m^2/s^2
 2969:    if (node->rho[kb + 1] >= -98.0)
 2970:    {
 2971:       const double mag_u = length(toVector2(node->u2[kb + 1]));
 2972:       node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 2973:       // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 2974:       // !sediment erosion: this part needs more documentation
 2975:    }
 2976: 
 2977:  
 2978:    // Compute vegetation parameters
 2979:    //--------------------------------
 2980: 
 2981:    // SAV constants
 2982:    constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 2983:    constexpr double veg_cfpsi = 0.16;
 2984: 
 2985:    // Add vertical variation to veg_alpha and compute vertical mean etc.
 2986:    if constexpr(iveg == 1) { //  Vertical variation specified by functions
 2987: 
 2988:       // Compute the vegetation "density" \alpha = D*N*Cd/2
 2989:       // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 2990:       int kbin = 0; // bin index
 2991:       for (int k = kb; k < nvrt; k++) {
 2992:          // Computes node height above the bottom level
 2993:          const double tmp_h = node->znl[k] - node->znl[kb]; // >=0
 2994:          assert(true && "Vertical variation of vegetation not implemented");
 2995: 
 2996:          // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 2997:          //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 2998:          //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 2999:          //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 3000:          // } else {
 3001:          //    // Find the bin at which the current vertical level is
 3002:          //    while (kbin<nbins_veg_vert) {
 3003:          //       const double zn = node->znl[kbin];
 3004:          //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 3005:          //          break;
 3006:          //       } // if
 3007:          //       kbin++;
 3008:          //    } // while
 3009:          //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 3010: 
 3011:          //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 3012:          //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 3013:             
 3014:          //    // Linear interpolation of the vegetation parameters
 3015:          //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 3016:          //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 3017:          //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 3018:          // } // if rl10
 3019: 
 3020:          // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 3021: 
 3022:       } // for k
 3023: 
 3024: 
 3025:    } else { // Ganthy (iveg=2)
 3026:    //  Modify canopy height, diameter, and density
 3027: 
 3028:       // Make sure there is vegetation on this node
 3029:       if (node->veg_h_unbent > 0.0) {
 3030:          const double wtmp2 = length(node->dav)*100.0; // cm/s
 3031: 
 3032:          node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 3033:                                 0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 3034:          node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 3035: 
 3036:          const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 3037:          node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 3038:          const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 3039:          node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 3040:       } // if veg_h_unbent
 3041: 
 3042:       for (int k = 0; k < nvrt; k++) {
 3043:          node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 3044:       } // for k
 3045:    
 3046: 
 3047:    } // if iveg
 3048:   
 3049:       
 3050: 
 3051:    // Compute vertical mean of veg_alpha3D
 3052:    if (iveg != 0) {
 3053:       const double ztop = node->zTopCanopy(); // Top of the canopy
 3054:       double sum1=0.0;
 3055:       double sum2=0.0;
 3056:       // Integrate over each level under the canopy...
 3057:       for (int k=kb; k<nvrt-1 && node->znl[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 3058:          const double Dz = node->Dz(k);
 3059: 
 3060:          sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 3061:          sum2 += Dz;
 3062: 
 3063:       } // for k
 3064: 
 3065:       if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 3066:       else             node->veg_alpha_vert_mean = sum1/sum2;
 3067: 
 3068:    } // if iveg
 3069: 
 3070: }
 3071: 
 3072: __device__ void computeVegetationAndDragParameters(void) {
 3073:    // Computes the vegetation and drag model parameters:
 3074:    // chi, \tilde\chi, beta, \breve{H}
 3075:    
 3076:    Side *side = SIDE_PTR;
 3077: 
 3078:    const double htot = side->htot();
 3079:    const int    kb   = side->kb;
 3080: 
 3081:    assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 3082: 
 3083:    const double veg_h     = side->veg_h();
 3084:    const double veg_nv    = side->veg_nv();
 3085:    const double veg_c     = side->veg_c();
 3086:    const double veg_beta  = side->veg_beta;
 3087:    const double veg_alpha = side->veg_alpha_vert_mean();
 3088: 
 3089:    // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 3090:    // Velocity magnitude at the bottom level
 3091:    // XXXX Check if we have add -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 3092:    assert(true && "Must use backtracked velocity");
 3093:    const double vmag1 = length(side->u2[kb + 1]); //BACKTRACKED VELOCITY
 3094:    side->chi2 = side->Cd()*vmag1;
 3095:    side->chi  = side->chi2;
 3096:    if constexpr(iveg != 0) {
 3097:       const Node *n1 = side->n1;
 3098:       const Node *n2 = side->n2;
 3099:       const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 3100:       side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 3101:    }
 3102: 
 3103:    // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 3104: 
 3105:    // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 3106:    // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 3107:    double magUa = 0.0;
 3108:    if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 3109:       // 3D wet side with veg...
 3110: 
 3111:       double magUa = 0.0;
 3112:       for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 3113:          if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 3114: 
 3115:             // Velocity magnitude must be computed at the center of each level to perform the integration.
 3116:             // The tricky part is to compute that velocity at the level that may be partially submerged.
 3117:             const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 3118: 
 3119:             // Velocity magnitude at the top (h) of the level (may be partially submerged)
 3120:             const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 3121: 
 3122:             // Velocity magnitude at the bottom (l) of the level
 3123:             const double ul = length(side->u2[k]);
 3124: 
 3125:             const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 3126:             magUa += Dz*0.5*(uh + ul);
 3127: 
 3128:          } // if HasVegetation
 3129:       } // for k
 3130:       const double ua = magUa/min(htot, veg_h); // Vertical average
 3131: 
 3132:       // Computes beta, used for computing the stress term at the top of the canopy.      
 3133:       side->veg_c2 = veg_alpha*dt*ua; // >=0
 3134:       if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 3135:          const double zCpy = side->zTopCanopy();
 3136:          const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 3137:          const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 3138:          const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 3139:          const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 3140:          side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 3141:       } // if isSubmerged
 3142:    } // if iveg   
 3143: 
 3144:    // Computes the friction modified depth, \breve{H} in notes
 3145:    if (side->is2D()) { // 2D
 3146: 
 3147:       double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 3148:       if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 3149: 
 3150:       assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 3151: 
 3152:       side->hhat = htot*htot/fricH; 
 3153: 
 3154:    } else { // 3D
 3155:       side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 3156: 
 3157:       if constexpr(iveg != 0) {
 3158:          
 3159:          if (side->isSubmerged()) { 
 3160:             const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 3161:             side->hhat -= veg_c*Hhat_alpha;
 3162: 
 3163:          } else { // Emergent
 3164:             side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 3165:          }
 3166:       } // if iveg
 3167: 
 3168:       // Enforce positivity for 3D model
 3169:       if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 3170:    } // if 3D
 3171: 
 3172:      
 3173: }
 3174: 
 3175: 
 3176: 
 3177: __device__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 3178: // Computes the density gradient between two elements, e1 and e2.
 3179: // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 3180: // zero in the direction normal to the side. 
 3181: // 
 3182: // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 3183: // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 3184: //
 3185: // Input:
 3186: //    e1: Element
 3187: //    e2: Neighbor element (or nullptr if boundary)
 3188: //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 3189: //    k: Index of the half-level at which the density is interpolated
 3190: //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 3191: // 
 3192: // Output:
 3193: //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 3194: //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 3195: 
 3196:    if (e2 == nullptr || e2->idry) {
 3197:       // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 3198: 
 3199:       Side *side = e1->sides[j];
 3200:       assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->idry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 3201:               
 3202:       if constexpr(ics == 1) {
 3203:          vec = side->n; // Normal vector to the side
 3204:       } else {
 3205:          // IMPLEMENT THIS XXXXXX
 3206:          // !replace with xel, yel?
 3207:          //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 3208:          //      &eframe(:,:,i),xn1,yn1,tmp)
 3209:          //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 3210:          //      &eframe(:,:,i),xn2,yn2,tmp)
 3211:       } //ics
 3212:                 
 3213:       diffRho = 0.0;
 3214: 
 3215:    } else { //internal and wet
 3216:       if constexpr(ics==1) {
 3217:          assert(e2 != nullptr || e2->idry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 3218: 
 3219:          // Vector from e1 to e2
 3220:          vec = toVector2(e2->center - e1->center);
 3221: 
 3222:       } else { 
 3223:          // IMPLEMENT THIS XXXXXX
 3224:          //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 3225:          //      &eframe(:,:,i),xctr2,yctr2,tmp)
 3226:          //                   alow(j)=xctr2
 3227:          //                   bdia(j)=yctr2
 3228:       } // ics
 3229: 
 3230:       diffRho = rho2 - e1->demeanedDensity(k);
 3231:    }
 3232: 
 3233: }
 3234: 
 3235: __device__ void computeDensityCubicSplines(void) {
 3236:    // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 3237: 
 3238:    Element *elem = ELEM_PTR;
 3239:    if (elem->idry) return;
 3240: 
 3241:    const int kb = elem->kb;
 3242: 
 3243:    // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 3244:    if (elem->is2D()) {
 3245:       // In the 2D case, the density is constant at the prism level. 
 3246:       // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 3247:       elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 3248:    } else { //3D
 3249: 
 3250:       // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 3251:       auto getX = [elem] (int k) { return elem->z_prism(k); };
 3252:       auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 3253:       ///// XXXX CHECK INDICES!!!!!
 3254:       initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_zz, elem->rho_z);
 3255:    } // 2D/3D
 3256: 
 3257: }
 3258: 
 3259: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 3260: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 3261: 
 3262:    if (elem2 == nullptr || elem2->idry) return 0.0;
 3263: 
 3264:    const int kb  = elem->kb;
 3265:    const int kb2 = elem2->kb;
 3266: 
 3267:    // z-coordinate of prism of elem
 3268:    const double zp = elem->z_prism(k);
 3269: 
 3270:    double rho = 0.0;
 3271: 
 3272:    if (elem2->is2D()) {
 3273:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 3274: 
 3275:    } else {  // 3D
 3276: 
 3277:       // eta_min may be < zmax
 3278:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 3279:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 3280: 
 3281:       // (Extrapolate density below bottom, we will fix it later)
 3282:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 3283:       rho = evalCubicSpline(zp, elem->rho_z, elem->rho_zz, elem->demeanedDensity(k), extrapolate = true);
 3284:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 3285:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 3286:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 3287:    } // 2D/3D
 3288:      
 3289: 
 3290:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 3291:    // Now we need to fix it.
 3292:    if (elem->z[k] < elem2->z[kb2]) {
 3293:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 3294: 
 3295:       // There are two methods to adjust the density at the bottom of the element.
 3296:       // iunder_deep=0: 
 3297:       const double depth1 = abs(elem->z[kb]); // larger depth
 3298: 
 3299:       if (iunder_deep==0) {
 3300: 
 3301:          const double weight = max(0.0, min(1.0, (depth1 - h1_bcc)/(h2_bcc - h1_bcc))); // weight
 3302: 
 3303:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 3304: 
 3305:       } else { // iunder_deep != 0
 3306: 
 3307:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 3308: 
 3309:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 3310: 
 3311:          //   Demeaned density at the same z coordinate as
 3312:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 3313:          }
 3314: 
 3315:       } // if iunder_deep
 3316:    } // if elem->z[kb] < elem2->z[kb]
 3317: 
 3318:    return rho;
 3319: }
 3320: 
 3321: __device__ void computeDensityGradient(void) {
 3322: 
 3323:    // Compute the horizontal density gradient at each element.
 3324:    // It works in two steps:
 3325:    // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 3326:    // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 3327:    //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 3328:    //             gradRho.r1 = rho1 - rho0
 3329:    //             gradRho.r2 = rho2 - rho0
 3330:    //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 3331:    // 
 3332:    //  NOTE: We use de-meaned densities.
 3333: 
 3334:    Element *elem = ELEM_PTR;
 3335: 
 3336:    if (elem->idry) return;
 3337: 
 3338:    const int kb  = elem->kb;
 3339:    const int i34 = elem->i34;
 3340: 
 3341:    for (int k = kb + 1; k < nvrt; k++) {
 3342:       // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 3343:       //             gradRho.r1 = rho1 - rho0
 3344:       //             gradRho.r2 = rho2 - rho0
 3345:       int icount = 0;
 3346:       double sumRx = 0.0;
 3347:       double sumRy = 0.0;
 3348:       for (int j1=0; j1<i34; j1++) { 
 3349: 
 3350:          const int j2 = elem->nxq(j1 + 1);
 3351: 
 3352:          // Pairs of consecutive neighbor elements of elem
 3353:          const Element *e1 = elem->nghbElems[j1];
 3354:          const Element *e2 = elem->nghbElems[j2];
 3355: 
 3356:          // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 3357:          const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 3358:          const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 3359: 
 3360:          // Compute the density difference and the vector from elem to e1 and e2
 3361:          // getRhoDiffAndVec takes into account boundaries/dry elements
 3362:          double diffRho1, diffRho2;
 3363:          Vector2 vec1, vec2;
 3364:          getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 3365:          getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 3366: 
 3367:          const double rl1 = length(vec1);
 3368:          const double rl2 = length(vec2);
 3369:          assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 3370: 
 3371:          const double delta = cross(vec1, vec2);
 3372:          const double sintheta = abs(delta)/(rl1*rl2);
 3373: 
 3374:          // To avoid problems, avoid elements with small angle between vectors
 3375:          constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 3376:          const bool validEq = (sintheta > sin_one_deg);
 3377: 
 3378:          if (validEq) {
 3379:             // Solve the system of equations to get the density gradient at elem
 3380:             icount++;
 3381:             const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 3382:             const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 3383:             sumRx += Rx;
 3384:             sumRy += Ry;
 3385:          }
 3386:       } // for j1
 3387: 
 3388:       // Compute the average density gradient at elem
 3389:       if (icount==0) {
 3390:         // Bad mesh quality; bail out with 0 b-cc
 3391:         elem->gradRho[k] = {0.0, 0.0};
 3392:       } else {
 3393:         elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 3394:       }
 3395: 
 3396:    } // for k
 3397: 
 3398: }
 3399: 
 3400: __device__ void computeBaroclinicTerm(double rampbc) {
 3401: // Computes the baroclinic term at sides (at half levels).
 3402: // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 3403: // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 3404: 
 3405:    Side *side = SIDE_PTR;
 3406: 
 3407:    if (side->idry == 1) return;
 3408: 
 3409:    const Element *e1 = side->elems[0];
 3410:    const Element *e2 = side->elems[1];      
 3411:    const int kb = side->kb;
 3412:    
 3413:    assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 3414: 
 3415:    // interpolates vertically the density gradient of the two elements at the half level/
 3416: 
 3417:    // Starts the integration at the surface and goes down to the bottom
 3418:    int k1 = nvrt - 1;
 3419:    int k2 = nvrt - 1;
 3420: 
 3421:    side->bcc[nvrt-1] = {0.0, 0.0};
 3422:    for (int k = nvrt-1; k >= kb; k--) {
 3423:    // For each prism level (from surface to bottom)...
 3424: 
 3425:       // For both elements, interpolate density gradient at the side's half level.
 3426:       // The gradient at the side is the average of the gradients at the elements.
 3427:       // w1, w2 are used to take into account boundary sides, with just one element.
 3428:       double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 3429:       double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 3430:       w1 = w1/(w1 + w2);
 3431:       w2 = w2/(w1 + w2);
 3432: 
 3433:       assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 3434: 
 3435:       // Linear interpolation of both elements' density gradient at the shared side's level.
 3436:       Vector2 gradRho = {0.0, 0.0};
 3437:       if (e1 != nullptr && k > kb) {
 3438:          // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 3439:          k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 3440:          const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 3441:          
 3442:          gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 3443:       }      
 3444:       if (e2 != nullptr && k > kb) {
 3445:          k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 3446:          const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 3447:          
 3448:          gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 3449:       }
 3450: 
 3451:       if constexpr(ics==2) {
 3452:          // IMPLEMENT THIS XXXXXX
 3453:          // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 3454:          // swild(1)=tmp1
 3455:          // swild(2)=tmp2
 3456:       }
 3457:       
 3458:       // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 3459:       // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 3460:       // CHECK INDICES!!! XXX
 3461:       const double grav3 = 0.5*(side->n1->grav2 + side->n2->grav2);
 3462:       side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 3463:    } // for
 3464: 
 3465: }
 3466: 
 3467: #ifdef DONTCOMPILE
 3468: __device__ void computeVerticalAdvection(void) {
 3469:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 3470: 
 3471:    sdbt(1:2,:,:)=0.d0
 3472: 
 3473:    const Side *side = FROM kernel;
 3474: 
 3475:    if(side->idry) return;
 3476: 
 3477:    // If side is wet...
 3478: 
 3479: 
 3480:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 3481:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 3482:    double ws[nvrt] = {} // w @ side
 3483:    int icount = 0;
 3484:    for (int j=0; j<2; j++) {
 3485:       const Element *elem = side->elements[j];
 3486:        
 3487:       if(elem != nullptr) {
 3488:          icount++;
 3489:          for (int k=0; k<nvrt; k++) {
 3490:             ws[k] = ws[k] + elem->w[k];
 3491:          }
 3492:       }
 3493:    }  // for j
 3494: 
 3495:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 3496:    ws = ws/icount;
 3497: 
 3498:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 3499:    // Splines allow for a smooth transition between vertical levels.
 3500:    // Splines have continuity restrictions at the internal knots, but
 3501:    // we have to provide the 1st derivatives at the endpoints.
 3502:    const int kbs = side->kbs; 
 3503:    
 3504:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3505:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3506:    initCubicSpline(kbs, nvrt, side, ws, up)
 3507: 
 3508:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3509:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3510:    initCubicSpline(kbs, nvrt, side, ws, vp)
 3511: 
 3512:    // Total advection (average onto side)
 3513:    const Node *node1 = side->nodes[0];
 3514:    const Node *node2 = side->nodes[1];
 3515:    for (int k=kbs(i); k<nvrt; k++) {
 3516: 
 3517:       if constexpr(ics==1) {
 3518:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 3519:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 3520:       } else {
 3521:          // XXX IMPLEMENT THIS
 3522:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 3523:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 3524:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 3525:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 3526:       }  // if ics
 3527: 
 3528: 
 3529:    }
 3530: }
 3531: #endif
 3532: 
 3533: __device__ void computeElemAverageGhat(void) {
 3534: // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 3535: 
 3536:    Element *elem = ELEM_PTR;
 3537:    
 3538:    elem->ghat1= {0.0, 0.0};  
 3539: 
 3540:    if constexpr(ihydraulics != 0) {
 3541:       if (nhtblocks > 0 && elem->isblock) return;
 3542:    }
 3543: 
 3544:    if (elem->idry == 1) return;
 3545: 
 3546:    // Wet elements.
 3547:    // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 3548:    // tidal potential, horizontal diffusion, and baroclinic etc
 3549:    // Remember to update both fb and F 
 3550:    // If ics=2, ghat1 are in eframe (ll)
 3551:    // cff1-3: coefficients for 2D/3D
 3552:    Vector2 gradEta = {0.0, 0.0};  // \nabla \eta
 3553:    Vector2 gradPr  = {0.0, 0.0};  // \nabla pressure
 3554:    Vector2 gradEtp = {0.0, 0.0};  // \nabla etp
 3555: 
 3556:    double av_cff1 = 0.0;  // av. for cff1
 3557:    double av_cff2 = 0.0;  // av. for cff2
 3558:    double av_cff3 = 0.0;  // av. for cff3
 3559:    double av_df = 0.0;  // av. for H^\alpha / H
 3560:    double av_cff2_chi = 0.0;  // av. for cff2*chi
 3561:    double av_cff3_chi = 0.0;  // av. for cff3*chi
 3562: 
 3563:    const int i34 = elem->i34;
 3564:    const int kb = elem->kb;
 3565: 
 3566:    for (int j=1; j<i34; j++) {
 3567:       // For each node and side in the element...
 3568: 
 3569:       const Node *node = elem->nodes[j];
 3570:       const Side *side = elem->sides[j];
 3571: 
 3572:       const double chi      = side->chi;
 3573:       const double veg_c2   = side->veg_c2;
 3574:       const double veg_beta = side->veg_beta;
 3575:       const double veg_h    = side->veg_h();
 3576:       const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 3577: 
 3578:       // Node - const in elem
 3579:       gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 3580:       gradPr  += node->pr  *elem->gradPhi[j];
 3581: 
 3582:       if (elem->depth >= tip_dp) {
 3583:         gradEtp += node->etp*elem->gradPhi[j];
 3584:       }
 3585: 
 3586:       
 3587:       const double htot  = side->htot();        // Total depth at the side
 3588:       const double zctr2 = side->zTopCanopy();  
 3589: 
 3590:       double cff1; 
 3591:       double cff2; 
 3592:       double cff3;   
 3593:       if (side->is2D()) {  // XXX Check indices, it used to have a +1
 3594:       // coefficients applied to 2D/3D case 
 3595:          cff1 = side->hhat/htot;
 3596:          cff2 = 0.0;
 3597:          cff3 = 0.0;
 3598:       } else { //3D
 3599:          //Init for no-veg case
 3600:          cff1 = 1.0;
 3601:          cff2 = 1.0;
 3602:          cff3 = 0.0;
 3603: 
 3604:          if constexpr(iveg != 0) {
 3605:             // Computes coefficients used with vegetation terms G1, G2
 3606:             // cff1, cff3 are used for the first two terms in G1, G2:
 3607:             // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 3608:             // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 3609:             // In general, cff1*Ustar - cff3*Ustar_alpha
 3610:             if(veg_h < 0.99*htot) { // submergent vegetation
 3611:                cff1=1;
 3612:                cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 3613:                cff3 = veg_c;
 3614: 
 3615:             } else { // emergent vegetation
 3616:                cff1 = 1.0/(1.0 + veg_c2);
 3617:                cff2 = cff1;
 3618:                cff3 = 0.0;
 3619: 
 3620:             }
 3621:          } // if iveg
 3622:       } //  2D/3D
 3623: 
 3624:       av_cff1 += cff1/i34;
 3625:       av_cff2 += cff2/i34;
 3626:       av_cff3 += cff3/i34;
 3627:       av_cff2_chi += cff2*chi/i34;
 3628:       av_cff3_chi += cff3*chi/i34;
 3629:       av_df += min(htot, veg_h)/(htot*i34);
 3630: 
 3631: 
 3632:       // btrack values: U^\star, U^{\star\alpha}
 3633:       // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 3634:       Vector2 Ustar       = {0.0, 0.0}; 
 3635:       Vector2 Ustar_alpha = {0.0, 0.0}; 
 3636:       for (int k = side->kb; k < nvrt; k++) {
 3637:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 3638:             Ustar += side->btu[nvrt]*side->Dz(k);
 3639: 
 3640:          } else { //3D
 3641:             Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 3642:             Ustar += w2;
 3643: 
 3644:             if constexpr(iveg != 0) {
 3645:                 if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 3646:                     const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k)); // For the top of the canopy, ratio of the level that is below the canopy
 3647:                     Ustar_alpha += zrat*w2; // XXXX
 3648:                 }
 3649:             }  // if iveg
 3650:          }  //2/3D
 3651:       }  //k
 3652:       
 3653: 
 3654:       // Add btrack & surface stress terms to \breve{G} first
 3655:       if constexpr(ics==1) {
 3656:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 3657:       } else {
 3658:          // XXX IMPLEMENT THIS
 3659:          // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 3660:          // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 3661:          // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 3662:       }  // if ics
 3663: 
 3664:       // Surface and bottom stress terms
 3665:       if constexpr(ics==1) {
 3666:          const Vector2 tau    = side->tau();
 3667:          const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 3668:       } else {
 3669:          // XXX IMPLEMENT THIS
 3670:          // n1=isidenode(1,isd); n2=isidenode(2,isd)
 3671:          // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 3672:          // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 3673:          // tau_x=(vn1+tt1)/2.d0
 3674:          // tau_y=(vn2+ss1)/2.d0
 3675:          // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 3676:       }  // if ics
 3677: 
 3678:       // Term for surface and bottom stress
 3679:       elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 3680: 
 3681:       // All terms in F,F^\alpha,f_b except baroclinic
 3682:       // F, f_b: all explicit terms excluding vegetation 
 3683:       // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 3684:       // Only need to calculate F^\alpha for 3D sides (but init=0) 
 3685:       const double coriolis = side->coriolis;
 3686:       const Vector2 F  =  coriolis*side->U;  // F_x
 3687:       const Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 3688:       Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 3689: 
 3690:       if (iveg != 0 && nvrt > side->kb) {  // 3D
 3691:          
 3692:          for (int k = side->kb; k < nvrt; k++) {
 3693:             if (zctr2 > side->zc[k-1]) {
 3694:                 const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 3695:                 const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 3696:                 Fa +=  coriolis*w2*zrat;
 3697:             } // if zctr2
 3698:          } // k
 3699:       } // iveg
 3700: 
 3701:       // Integrate horizontal viscosity vertically
 3702:       for (int k=side->kb; k<nvrt; k++) {
 3703:          const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.0; // (d2uv(1,k,isd)+d2uv(1,k-1,isd))/2
 3704: 
 3705:          F += w2;
 3706: 
 3707:          // Vegetation term
 3708:          if constexpr(iveg!=0) {
 3709:             if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 3710:                const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 3711:                Fa += w2*zrat;
 3712:             } 
 3713:          } // if iveg
 3714:       } // for k
 3715: 
 3716:       fb += side->d2uv[side->kb];
 3717: 
 3718: 
 3719:       // Add to ghat1
 3720:       if constexpr(ics==2) {
 3721:          // XXX IMPLEMENT THIS
 3722:          // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 3723:          // bigf1=vn1; bigf2=vn2
 3724:          // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 3725:          // botf1=vn1; botf2=vn2
 3726:          // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 3727:          // bigfa1=vn1; bigfa2=vn2
 3728:       } // if ics
 3729: 
 3730:       elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 3731:    } // for j (nodes and sides)
 3732: 
 3733:    elem->ghat1 = (1.0/i34)*elem->ghat1;
 3734:       
 3735:    // Finish off terms in F, F^\alpha and f_b
 3736:    const double grav3 = elem->mean(Element::grav2);
 3737:    const Vector2 fb = grav3*gradP - gradPr/rho0; //const in each elem
 3738: 
 3739: 
 3740:    Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 3741:    for (int j=1; j<i34; j++) { 
 3742:       // For each side in the element...
 3743:       const Side *side = elem->sides[j];
 3744: 
 3745:       const double htot = side->htot();
 3746:       const Vector2 F  = htot*fb;
 3747:       const Vector2 Fa = min(htot, veg_h)*fb;
 3748: 
 3749:       tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 3750:    } // for j
 3751: 
 3752:    //botf1 etc are already in elem frame
 3753:    elem->ghat1 += tmp/i34;
 3754: 
 3755:    // Baroclinic force
 3756:    if constexpr(ibc==0) {
 3757:       assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 3758: 
 3759:       Vector2 Fa = {0.0, 0.0};
 3760:       Vector2 intGradRho = {0.0, 0.0};
 3761:       
 3762:       // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 3763:       for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 3764:          intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 3765: 
 3766:          // \in F [m^2/s/s]
 3767:          Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 3768:       }
 3769: 
 3770:       const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 3771:       const Vector2 F = av_df*Fa; //approx
 3772:       elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 3773: 
 3774:    } // if ibc
 3775: 
 3776: }
 3777: 
 3778: 
 3779: 
 3780: #ifdef DONTCOMPILE
 3781: __global__ void checkMassConservation(Tracers* sumtr) {
 3782: 
 3783:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 3784: 
 3785:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 3786: 
 3787:    Element *elem = &(mesh->localElemData[i]);
 3788: 
 3789:    // Skip dry elements
 3790:    if (elem->idry) return;
 3791: 
 3792:    // Local sum array for this thread
 3793:    double localSum[N_TRACERS] = {0.0};
 3794: 
 3795:    // Sum over vertical levels for this element
 3796:    const int kbe = elem->kbe;
 3797:    const double area = elem->area;
 3798: 
 3799:    for (int k = kbe; k < nvrt; k++) {
 3800:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 3801:       
 3802:       // Accumulate tracer mass
 3803:       for (int tr = 0; tr < N_TRACERS; tr++) {
 3804:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 3805:       }
 3806:    }
 3807: 
 3808:    
 3809: 
 3810:    //  This function returns per element sums. A reduction must be done on the host side.
 3811: }
 3812: 
 3813: 
 3814: __global__ void transport(void) {
 3815: 
 3816:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 3817: 
 3818:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 3819: 
 3820:    Element *elem = &(mesh->localElemData[ie]);
 3821: 
 3822:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 3823: 
 3824:                for (int m=0; m<ntr; m++) {
 3825:                   for (int k=kbe(ie); k<nvrt; k++) {
 3826:                      // Calculate each polynomial's weight 
 3827:                      wm=0.d0; sum1=0.d0; 
 3828:                      wm1=0.d0; wm2=0.d0; 
 3829:                      for (int i=0; i<elem->nweno2; i++) {
 3830:                   
 3831:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3832:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3833:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3834:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3835:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3836:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 3837:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 3838:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 3839:                      // -----------------Hu and Shu (1999)'s method----------------
 3840:                      b4=b1+b2+b3
 3841: 
 3842: //Error: add PRODUCTION CPP
 3843: #ifdef DEBUG
 3844:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 3845:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 3846:                     call parallel_abort(errmsg)
 3847:                   }
 3848: #endif
 3849: 
 3850:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 3851:                   // !----test-------------- 
 3852:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 3853:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
