 4813: __global__ void printMatrix(void) {
 4814: 
 4815: 
 4816:    // Let only one thread per block print at a time 
 4817: 
 4818:    if (threadIdx.x == 0) {
 4819:       for (int ithread = 0; ithread < blockDim.x; ithread++) {
 4820:          const int idx_node = ithread + blockIdx.x * blockDim.x;
 4821:          if (idx_node >= mesh->np) return;
 4822: 
 4823:          printf("idx_node = %d\n", idx_node);
 4824:          const Node *node = mesh->localNodeData + idx_node;
 4825:          printf("node = %p,  numNodes = %d\n", node, node->numNodes);
 4826: 
 4827:          for (int j = 0; j < node->numNodes; j++) {
 4828:             Node* nbNode = node->nodes[j];
 4829:             printf("%d:%g ", nbNode->idx, node->coeffMatrix[j]);
 4830:          }
 4831: 
 4832:          printf("] diag=%g\n", node->coeffDiag);
 4833:       }
 4834:    }
 4835: 
 4836: 
 4837: 
 4838: }
