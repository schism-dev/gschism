  710: struct Side {
  711: 
  712:    // Geometry information
  713:    int idx;               // Index of the side
  714:    Node *n1, *n2;
  715:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  716: 
  717:    double length;         // Length of the side. Used to be called distj; but I think this name is less clear now.
  718:    Vector2 center;        // Location of side center. 
  719:    double zc[nvrt];       // Side center z-coord at each vertical level
  720: 
  721:    Frame frame;
  722: 
  723:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  724:                           // this is nullptr
  725:    
  726:    int kb;                // Bottom index of the side
  727:    bool isDry;             // True if the side is dry
  728:  
  729:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  730: 
  731:    // Physical information
  732:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  733:    double  w2[nvrt];            // Vertical velocity at each vertical level
  734:    Vector2 btu[nvrt];           // Back-tracked velocity
  735:    Vector2 uth[nvrt];           // "Time history" velocity
  736:    Vector2 U;                   // Vertically averaged velocity vector  
  737: 
  738:    Vector2 d2uv[nvrt];          // divergence of (nu*grad u) XXX COMPUTE!!
  739: 
  740:    Vector2 bcc[nvrt];           // Baroclinic term
  741: 
  742:    double hhat;                 // \breve{H} in notes
  743: 
  744:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
  745: 
  746:    double coriolis;             // Coriolis parameter
  747: 
  748:    // Vegetation parameters
  749:    double veg_c2;
  750:    double veg_beta;
  751: 
  752:    // Bottom drag parameters.
  753:    double chi;
  754:    double chi2;
  755: 
  756:    __inline__ __device__ double x(double t) const;
  757:    __inline__ __device__ double y(double t) const;
  758:    __inline__ __device__ Point2 p_t(double t) const;
  759: 
  760:    __inline__ __device__ Point3 center3D(int k) const { return {center.x, center.y, zc[k]}; }
  761:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
  762:    __inline__ __device__ double Dz(int k)       const { return zc[k] - zc[k-1]; }
  763: 
  764:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
  765: 
  766:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
  767: 
  768:    __inline__ __device__ int iadv(void) const;
  769: 
  770:    __inline__ __device__ double eta2(void) const;
  771:    __inline__ __device__ double depth(void) const;
  772:    __inline__ __device__ double htot(void) const { return eta2() + depth(); }
  773: 
  774:    __inline__ __device__ double veg_h(void)  const;
  775:    __inline__ __device__ double veg_nv(void) const;
  776:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
  777:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
  778: 
  779:    __inline__ __device__ double Cd(void) const;
  780: 
  781:    __inline__ __device__ Vector2 tau(void) const;
  782: 
  783:    __inline__ __device__ double zb(void) const { return zc[kb]; }
  784:    
  785: 
  786:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
  787:    __inline__ __device__ double zLevelVegRatio(int k) const { 
  788:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
  789:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
  790:    } 
  791:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
  792:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot(); }
  793:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 1; }
  794:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 1; }
  795: 
  796:    // Get valid starting element (for backtracking)
  797:    __inline__ __device__ Element* getStartElement() {
  798:       return elems[0] ? elems[0] : elems[1];
  799:    }
  800: 
  801:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
  802:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
  803: 
  804:       // If one of the elements is null, return the other one
  805:       if      (elems[0] == nullptr) return elems[1];
  806:       else if (elems[1] == nullptr) return elems[0];
  807: 
  808: 
  809:       // Dot product of the negative velocity vector with the side normal vector
  810:       const double dot_prod1 = -dot(u, n);
  811:       
  812:       // Vector from side center to element 0 centroid
  813:       const Vector2 v2 = toVector2(elems[0]->center) - center;
  814: 
  815:       // Dot product of the vector with the side normal vector
  816:       const double dot_prod2 = dot(v2, n);
  817: 
  818:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
  819:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
  820: 
  821:       if (dot_prod1*dot_prod2 > 0.0) return elems[0];
  822:       else                           return elems[1];
  823: 
  824:  
  825:    }
  826: 
  827:    __forceinline__ __device__ Element* otherElem(const Element* elem) {
  828:       // Given an element, returns the other element that shares this side
  829:       return (elems[0] == elem) ? elems[1] : elems[0];
  830:    }
  831: 
  832:    __forceinline__ __device__ Node* otherNode(Node* node) {
  833:       // Given a node, returns the other node that shares this side
  834:       return (n1 == node) ? n2 : n1;
  835:    }
  836:  
  837:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
  838: 
  839: 
  840: 
  841: 
  842: };
  843: 
  844: 
  845: // This struct is used to store the boundary information for a node.
  846: struct NodeBoundary {   
  847:    BoundarySegment *segment;
  848:    Node *node;
  849:    
  850:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
  851:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
  852: 
  853:    double etaic;  // Elevation at nodes used for essential boundary conditions
  854:    double elbc;   // Elevation boundary condition
  855:    int iettype;   // Type of elevation boundary condition
  856:    double eth;    // Elevation time history
  857: 
  858:    bool isEssentialBC;
  859: 
  860: 
  861:    // Arrays for harmonic constituents (if needed)
  862:    double emo[nbfr];  // Elevation amplitude
  863:    double efa[nbfr];  // Elevation phase
  864:    double umo[nbfr];  // U-velocity amplitude
  865:    double ufa[nbfr];  // U-velocity phase
  866:    double vmo[nbfr];  // V-velocity amplitude
  867:    double vfa[nbfr];  // V-velocity phase 
  868: 
  869:    
  870:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
  871:       assert(index == 0 || index == 1); 
  872:       return (index == 0) ? sideBnd1 : sideBnd2; 
  873:    }
  874: 
  875: 
  876: };
  877: 
  878: struct Node {
  879: 
  880:    // Geometry information
  881:    int idx;        // Index of the node
  882:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
  883:    int numNodes;   // Number of nodes neighbors of this node
  884: 
  885:    Element **elements; // Array of pointers to the elements that share this node
  886:    int numElements;   // Number of elements that share this node
  887: 
  888:    Point3 p;
  889:    Vector3 u2[nvrt];
  890:    double znl[nvrt];
  891:    double lon, lat;
  892:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
  893:    double depth;
  894: 
  895:    int kb;       // Bottom index of the node
  896: 
  897:    bool isDry;     // True if the node is dry
  898: 
  899:    int iadv;     // Advection flag
  900: 
  901:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
  902: 
  903:    // Physical information
  904:    Tracers tr_nd0[nvrt]; // Initial tracer conc. at nodes
  905: 
  906:    double rho[nvrt];     // Density
  907: 
  908:    double eta1; // Elevation at nodes at previous timestep
  909:    double eta2; // Elevation at nodes at current timestep
  910: 
  911:    double ETP;  // Earth Tidal Potential
  912: 
  913:    
  914:    double pr;    // Air pressure
  915:    double grav2; // Gravity 
  916:    
  917:    Vector2 dav;  // Depth averaged velocity
  918: 
  919:    Vector2 tau; // Wind stress vector
  920: 
  921:    // Vegetation parameters
  922:    double veg_h;
  923:    double veg_nv;
  924:    double veg_di;
  925:    double veg_Cd;
  926:    double veg_h_unbent;
  927:    double veg_di_unbent;
  928:    double veg_nv_unbent;
  929:    double veg_alpha_vert_mean;
  930:    double veg_alpha0;
  931:    double veg_alpha3D[nvrt];
  932: 
  933:    // Bottom drag parameters
  934:    double Cd;       // Bottom drag coefficient
  935:    double rough;    // Bottom roughness length
  936:    Vector2 tau_bot; // Bottom stress vector
  937: 
  938:    double bdef1; // Bottom deformation at previous timestep
  939:    double bdef2; // Bottom deformation at current timestep
  940: 
  941:    double qel; // RHS
  942:    double coeffDiag; // Diagonal coefficient of the matrix
  943:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
  944: 
  945:    double mP; // Search direction for conjugate gradient method
  946:    double mR; // Residual for conjugate gradient method
  947:    double mAp; // Product of matrix and search direction for conjugate gradient method
  948:    double mX; // Solution for conjugate gradient method
  949: 
  950:    // Meteorological forcing
  951:    Vector2 u_air;
  952:    double p_air;
  953:    double t_air;
  954:    double q_air;
  955:    double wind_angle;  // Wind rotation angle
  956: 
  957:    __host__ __device__ void setWind(Vector2 &u) {
  958:    // Sets the wind vector taking into account the wind rotation angle
  959:    
  960:       const double dir = atan2(-u.x,-u.y);
  961:       const double speed = length(u);
  962: 
  963:       // Calculate new u and v components with added rotation angle
  964:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
  965:    }
  966: 
  967:    __host__ __device__ Point2 p2(void) const { return {p.x, p.y}; }
  968: 
  969:    __host__ __device__ double sigmaTransitionDepth(void) const;
  970: 
  971:    __inline__ __device__ double Dz(int k) const { return znl[k] - znl[k-1]; }
  972:    __inline__ __device__ double htot(void) const { return eta2 + depth; }
  973:    __inline__ __device__ double zTopCanopy(void) const { return znl[kb] + veg_h; } 
  974: 
  975:    __device__ void clearMatrixRow(void) {
  976:       // Clear the matrix row for this node
  977:       coeffDiag = 0.0;
  978:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
  979: 
  980:    }
  981: 
  982:    __device__ void addToSparseMatrix(Node const *node, double value) {
  983:       // Add the value to the sparse matrix for this node
  984:       
  985:       if (node == this) {
  986:          coeffDiag += value;
  987: printf("addToSparseMatrix: node == this, value = %f\n", coeffDiag);         
  988:       } else {
  989:          // Search (linearly)the index of the node in the array of nodes
  990:          // XXX: This is not efficient, see if we can improve this
  991:          int i;
  992:          for (i = 0; i < numNodes; i++) {
  993:             if (nodes[i] == node) {
  994:                break;
  995:             }
  996:          }
  997:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
  998:          coeffMatrix[i] += value;
  999:       }
 1000:    }
 1001: 
 1002: #ifdef BACKTRACKING
 1003:    __device__ void updateZCoordData() {
 1004:    // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 1005: 
 1006:       // Check if node is wet
 1007:       isDry = (depth + eta2 <= h0);  // XXX Check if we are doing this elsewhere
 1008: 
 1009:       if (idry) return;
 1010: 
 1011:       if constexpr(ivcor == 2) {  // SZ coordinates
 1012:          
 1013:          // Compute bottom level index
 1014:          if (depth <= mesh->h_s) {
 1015:                kb = mesh->nzlevels;
 1016:          } else {
 1017:                kb = -1;
 1018:                for (int i = 0; i < mesh->kz-1; i++) {
 1019:                   if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 1020:                      kb = i;
 1021:                      break;
 1022:                   }
 1023:                }
 1024:          }
 1025:       } 
 1026:       else if (ivcor == 1) {  // Localized sigma
 1027:          // Do nothing
 1028:       }
 1029: 
