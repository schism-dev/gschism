 3301:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3302: 
 3303:       NODE_BND(nodeBnd);
 3304: 
 3305:       Node *node = nodeBnd->node;
 3306: 
 3307:       node->ETP = 0.0;
 3308: 
 3309:       for (int j=0; j<ntip; j++) {
 3310: 
 3311:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3312:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3313:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3314: 
 3315:          if constexpr(iloadtide==1) { // loading tide
 3316:             assert(false && "Loading tide not implemented");
 3317:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3318:          }
 3319:          
 3320:       }
 3321:       
 3322:    }
