  694:    double vobc2;   // Velocity coefficient 2
  695: 
  696:    // Tracer boundary conditions
  697:    // double trobc[natrm];    // Tracer boundary condition nudging factor
  698:    // int  itrtype[natrm];    // Tracer boundary condition type
  699: 
  700:    
  701: };
