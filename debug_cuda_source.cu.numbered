 1359: 
 1360: /**
 1361:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1362:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1363:    If the segment is completely inside the element, then it returns true.
 1364: 
 1365:    This function assumes:
 1366:    - The initial point is on a side of the element. 
 1367:    - Its position is given by parameter t in the range [0,1].
 1368:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1369:       intersects the element (elements are convex).
 1370: 
 1371:    To find the intersection point, this function does the following:
 1372:    - it finds the intersection of the line segment with all the element side lines,
 1373:       except for the one that contains the initial point.
 1374:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1375:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1376:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1377:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1378:       track segment is almost parallel to the element side line.
 1379: 
 1380:    Inputs:
 1381:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1382:    @param x2, y2: other end of the line segment
 1383: 
 1384:    Outputs:
 1385:    @param side:  side that intersects the line segment (input and output)
 1386:    @param nextElement (output): element that contains the intersection point
 1387:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1388:    @param zint (input/output): Vertical coordinate of the intersection point
 1389: 
 1390:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1391:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1392:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1393: 
 1394:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1395:    (Delta) being zero.
 1396: 
 1397:    The intersection2 point happens when:
 1398:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1399:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1400:    
 1401:    Assumption: the 4 points (including those of the side segment) are different.
 1402:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1403:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1404:    If true, (xIntersect,yIntersect) is the intersection.				
 1405:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1406: **/
 1407: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1408:                                               double &t, double& tIntersect) {
 1409: 
 1410:    double closest_intersect_t = 1e10;
 1411:    bool found_intersection = false;
 1412: 
 1413:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1414:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1415:    const Point2 x1 = side->point(t);
 1416:    
 1417: 
 1418:    Side *nextSide = nullptr;
 1419: 
 1420:    for (int i = 0; i < i34; i++) {
 1421: 
 1422:       // Element's i-th side 
 1423:       Side *side2 = sides[i];
 1424: 
 1425:       // Skip the side that contains the initial point
 1426:       if (side2 == side) continue;
 1427: 
 1428:       // (x3,y3)-(x4,y4) is the element side line
 1429:       const Point2 x3 = side2->n1->p2();
 1430:       const Point2 x4 = side2->n2->p2();
 1431: 
 1432:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1433:       const double delta = cross(x2 - x1, x3 - x4);
 1434: 
 1435:       if (delta != 0.0) {
 1436: 
 1437:          const double delta1 = cross(x3 - x1, x3 - x4);
 1438:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1439: 
 1440:          // Solves the two linear equations for tt1 and tt2
 1441:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1442:          const double tt2 = delta2/delta;
 1443: 
 1444:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1445:             closest_intersect_t = min(closest_intersect_t, tt1);
 1446:             nextSide = side2;
 1447: 
 1448:             nextElement = nextSide->otherElem(this);
 1449:             tIntersect = max(small, min(tt1, 1.0-small));
 1450:             t = tt2;
 1451: 
 1452:             found_intersection = true;
 1453:          }
 1454:       
 1455:       }
 1456: 
 1457:    }
 1458: 
 1459: 
 1460:    // found_intersection should always be true, since we checked all the sides.  
 1461:    side = nextSide;
 1462: // if (found_intersection) {
 1463: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1464: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1465: // }   
 1466:    if (!found_intersection) {
 1467:       // Check if the segment is parallel to the initial side
 1468:       printf("XXX %f\n", dot(x2 - x1, side->n1->p2() - side->n2->p2()));
 1469:       if (abs(dot(x2 - x1, side->n1->p2() - side->n2->p2())) < small) {
 1470:          assert(false && "Segment is parallel to the initial side");
 1471:          found_intersection = true;
 1472:          nextElement = side->otherElem(this);
 1473:          tIntersect = t;
 1474:          t = 0.0;
 1475:          found_intersection = true;
 1476:       }
 1477:    }
 1478:    return found_intersection;
 1479: }
 1480: 
 1481: 
 1482: 
 1483: 
 1484: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1485:                                               double &t, double& tIntersect) {
 1486: 
 1487:    double closest_intersect_t = 1e10;
 1488:    bool found_intersection = false;
 1489: 
 1490: double minDelta = 1e10;
 1491: double btt1, btt2;
 1492:    for (int i = 0; i < i34; i++) {
 1493: 
 1494:       Side *side2 = sides[i];
 1495: 
 1496:       // (x3,y3)-(x4,y4) is the element side line
 1497:       const Point2 x3 = side2->n1->p2();
 1498:       const Point2 x4 = side2->n2->p2();
 1499: 
 1500:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1501:       const double delta = cross(x2 - x1, x3 - x4);
 1502: 
 1503:       if (delta != 0.0) {
 1504: 
 1505:          const double delta1 = cross(x3 - x1, x3 - x4);
 1506:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1507: 
 1508:          // Solves the two linear equations for tt1 and tt2
 1509:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1510:          const double tt2 = delta2/delta;
 1511: 
 1512: if (abs(delta) < minDelta) {
 1513:    minDelta = abs(delta);
 1514:    btt1 = tt1;
 1515:    btt2 = tt2;
 1516: }
 1517: double small = 1e-7;
 1518:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1519:             closest_intersect_t = min(closest_intersect_t, tt1);
 1520:             side = side2;
 1521:             nextElement = side->otherElem(this);
 1522:             t = tt2;
 1523:             tIntersect = max(small, min(tt1, 1.0-small));
 1524:             found_intersection = true;
 1525:          }
 1526:       
 1527:       }
 1528: 
 1529: 
 1530:    }
 1531: 
 1532:    if (!found_intersection) {
 1533:       printf("ZZZ %p\n", nextElement);
 1534:       
 1535:       printf("ZZ No intersection found:\n"
 1536:            "Element %p\n"
 1537:            "in = %d\n"
 1538:            "minDelta = %e\n"
 1539:            "tt1 = %e, tt2 = %e\n"
 1540:            "segment: (%f, %f)-(%f, %f)\n"
 1541:            "Vertices:\n"
 1542:          //   "  Nodes nextElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n"
 1543:            "  Nodes curElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n",
 1544:            nextElement,
 1545:            (btt1 >= -small && btt2 >= -small && btt2 <= 1.0 + small && btt1 <= 1.0 + small),
 1546:            minDelta,
 1547:            btt1, btt2,
 1548:            x1.x, x1.y,
 1549:            x2.x, x2.y,
 1550:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1551:          //   nextElement->nodes[1]->p.x, nextElement->nodes[1]->p.y,
 1552:          //   nextElement->nodes[2]->p.x, nextElement->nodes[2]->p.y,
 1553:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1554:            nodes[0]->p.x, nodes[0]->p.y,
 1555:            nodes[1]->p.x, nodes[1]->p.y,
 1556:            nodes[2]->p.x, nodes[2]->p.y,
 1557:            nodes[0]->p.x, nodes[0]->p.y);
 1558:            printf("ZZZ\n");
 1559:    }
 1560: 
 1561:    // assert(found_intersection && "No intersection found");
 1562: 
 1563:    // found_intersection should always be true, since we checked all the sides.  
 1564:    return found_intersection;
 1565: }
 1566: 
 1567: 
 1568: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1569:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1570: 
 1571:    printf("Tracking segment goes out of water at element %d\n", curElem->idx);
 1572: 
 1573:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1574:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1575:    // curElement.
 1576: 
 1577:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1578:    // And uses this velocity instead to continue the tracking.
 1579: 
 1580:    // computes the intersection point in cartesian coordinates
 1581:    Point2 intersection = nextSide->p_t(tt);
 1582: 
 1583:    // Nudges the point to the barycenter of the element. 
 1584:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1585:    // next segment intersects the element sides.  
 1586:    curElem->nudgeToBarycenter(intersection);
 1587: 
 1588:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1589:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1590:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1591:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1592: 
 1593:    // If the side is an open boundary, the tangential velocity is zero.
 1594:    if (nextSide->isBnd()) vtan = 0.0;
 1595: 
 1596:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1597:    const double us = vtan*nextSide->t().x;
 1598:    const double vs = vtan*nextSide->t().y;
 1599:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1600: 
 1601:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1602:    const double len2 = length(intersection - toPoint2(xt));
 1603:    const double vel2 = u_int.x*u_int.x + u_int.y*u_int.y;        
 1604:    assert(vel2 > 0.0 && "Zero velocity found");
 1605:    dt = dt - sqrt(len2/vel2); 
 1606: 
 1607:    // The end of this tracking segment is now the intersection point.
 1608:    xt = {intersection.x, intersection.y, zint};
 1609:    
 1610:    u_int = {us, vs, ws};
 1611:    
 1612: }
 1613: 
 1614: /**
 1615:  * Tracks a particle through elements and vertical levels in the mesh.
 1616:  * 
 1617:  * @param x0,y0,z0     Starting position coordinates
 1618:  * @param xt,yt,zt     Target position coordinates
 1619:  * @param dtb          Time step for tracking
 1620:  * @param uuint,vvint,wwint Initial velocity components
 1621:  * @param nextElem     Starting/resulting element index
 1622:  * 
 1623:  * @return Status code of type trackExitCodes
 1624:  * 
 1625:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1626:  * of the details are different. The idea is that the code requires less branches and is better fit
 1627:  * for GPU execution.
 1628:  * 
 1629:  * The main ideas here are:
 1630:  * - The starting point is expected to be in the starting element.
 1631:  * - The end point is guaranteed to be inside an element.
 1632:  * - since the starting point is inside the element, there are only two cases: 
 1633:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1634:  *     (b) it does not and (xt,yt) is already in the starting element.
 1635:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1636:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1637:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1638:  * - tt1 can be positive or negative. We only consider the positive values.
 1639:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1640:  * - The next intersection will occur at the smallest positive tt1.
 1641:  * - This intersection will be the next (x0,y0) position.
 1642:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1643:  *   of getting stuck in a loop.
 1644:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1645:  *   was found.
 1646:  */
 1647: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1648:                                                        Element *&nextElem, int &jlev, double &dt) {
 1649: 
 1650:    // First thing is to check if the target point is inside the element. If it is there is nothing
 1651:    // else to do.
 1652:    if (containsPoint(toPoint2(xt))) {
 1653:       nextElem->interpolateVelocities(xt, u_int);
 1654:       return true;
 1655:    }
 1656: 
 1657:    Side *side = nullptr;
 1658: 
 1659:    // 1. Initial checks
 1660:    // Verify starting element is valid (wet)
 1661:    assert(!nextElem->isDry && "Starting element is dry");
 1662: 
 1663:    // Checks if track has a zero length.
 1664:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1665:    assert(len2 > 0.0 && "Zero length track"); 
 1666:    
 1667:    const int MAX_ITERATIONS = 1000;
 1668:    
 1669:    double t;
 1670:    Side *nextSide = nullptr;
 1671:    double tIntersect = 1e10;
 1672:    double zint = x0.z;
 1673: 
 1674:    // Horizontal tracking loop
 1675:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1676:    // (x0,y0) is inside the element but the target point is not.
 1677:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1678: 
 1679:    if (!found_intersection) {
 1680:       printf("No intersection found:\n"
 1681:            "Element %d\n"
 1682:            "Start point: (%f, %f)\n"
 1683:            "Target point: (%f, %f)\n"
 1684:            "Vertices:\n"
 1685:            "  Node 0: (%f, %f)\n"
 1686:            "  Node 1: (%f, %f)\n"
 1687:            "  Node 2: (%f, %f)\n",
 1688:            nextElem->idx,
 1689:            x0.x, x0.y,
 1690:            xt.x, xt.y,
 1691:            nextElem->nodes[0]->p.x, nextElem->nodes[0]->p.y,
 1692:            nextElem->nodes[1]->p.x, nextElem->nodes[1]->p.y,
 1693:            nextElem->nodes[2]->p.x, nextElem->nodes[2]->p.y);
 1694:    }
 1695:    assert(found_intersection && "No intersection found at %d");
 1696: 
 1697:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1698: 
 1699:    // if the tracking segment goes out of water (either dry or edge boundary)
 1700:    if (isEdgeBoundary(nextSide) || (nextElem->isDry)) {
 1701: 
 1702: 
 1703:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1704:       nextElem = this;
 1705:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1706:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1707:       return true;    
 1708:    }
 1709: 
 1710:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1711:    int iterations = 0;
 1712:    while (iterations < MAX_ITERATIONS) {
 1713:       iterations++;
 1714:       
 1715:       Element *curElem = nextElem;
 1716: 
 1717:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1718:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1719: 
 1720:       // If we are already in the target element, we are done.
 1721:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1722:       if (!found_intersection) break;
 1723: 
 1724: 
 1725:   
 1726:       // if the tracking segment goes out of water (either dry or edge boundary).
 1727:       if (curElem->isEdgeBoundary(nextSide) || (nextElem->isDry)) {
 1728: 
 1729:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1730: 
 1731:          nextElem = curElem;
 1732:          printf("MMMM, nextElem = %p\n", nextElem);
 1733:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1734:          // In this case, the caller (btrack) needs to take into account the remaining time.
 1735:          return true;
 1736:       }
 1737:       
 1738:       // Update position and element for next iteration
 1739:       side = nextSide;
 1740: 
 1741:    }
 1742: 
 1743:    printf("LLLL, iterations = %d\n", iterations);
 1744:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 1745: 
 1746:  
 1747:    // Interpolate velocities at the final position. This is a conceptually simple step,
 1748:    // but the function is not simple, because it has to search for the vertical level containing zt.
 1749:    nextElem->interpolateVelocities(xt, u_int);
 1750: 
 1751: 
 1752:    return true;
 1753: }
 1754: 
 1755: 
 1756: 
 1757: 
 1758: __inline__ __device__ double Element::computeSignedArea(void) const {
 1759:    // Compute the area of the element
 1760: 
 1761:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 1762: 
 1763:    // In the quad case we need to add the area of the other triangle.
 1764:    if (isQuad()) {
 1765:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1766:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 1767:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1768:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 1769:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 1770:          Error("Negative area found in quad element");
 1771:       }
 1772:       res += ar1;
 1773:    }
 1774: 
 1775:    return res;
 1776: }
 1777: 
 1778: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 1779:    // In boundary sides, the element 1 is nullptr
 1780:    return side->elems[1] == nullptr; 
 1781: }
 1782: 
 1783: 
 1784: 
 1785: /**
 1786:    Compute the shape coordinates of the point (xt,yt) in the element.
 1787:    @param xt (input): x-coordinate of the point
 1788:    @param shpCoords (output): shape coordinates of the point
 1789:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 1790:    @return true if the point is inside the element, false otherwise
 1791: **/
 1792: __device__ bool Element::computeShapeCoords(Point2 xt, double shpCoords[4],
 1793:                                             bool fixNegshpCoord) const {
 1794: 
 1795:    // Compute the shape coordinates of the point xt in the element.
 1796:    if (i34==3) {
 1797:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 1798:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 1799:       // and in this case, the pt will be nudged into the element
 1800:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 1801:       // from the local frame, so use additional check.
 1802: 
 1803:       Point2 x0, x1, x2;
 1804: 
 1805:       if constexpr(ics==1) {
 1806:          x0 = nodes[0]->p2();
 1807:          x1 = nodes[1]->p2();
 1808:          x2 = nodes[2]->p2();
 1809:       }
 1810:       else // lat/lon
 1811:       {
 1812:          Error("Not implemented yet");
 1813: #ifdef ICS2
 1814:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 1815:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 1816:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 1817: #endif
 1818:       }
 1819: 
 1820:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 1821:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 1822:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 1823:       shpCoords[3] = 0.0;
 1824:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 1825: 
 1826:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 1827:       // then we fix the negative shape coordinates.
 1828:       if (fixNegshpCoord && tmpmin<=0.0) {
 1829: 
 1830:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 1831:          // keeping the sum of the shape coordinates equal to 1.
 1832:          // I have tested and compared the new algorithm with the old one, and they give
 1833:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 1834:          // The new algorithm should be faster since it is branchless.
 1835:          const double a = - tmpmin + 1.0e-2;  // XXX it used to be 1.0e-4 in the comments of the original code
 1836:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 1837:          
 1838:          shpCoords[0] = (shpCoords[0] + a)*b;
 1839:          shpCoords[1] = (shpCoords[1] + a)*b;
 1840:          shpCoords[2] = (shpCoords[2] + a)*b;          
 1841: 
 1842:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 1843:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 1844:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 1845:          }
 1846: 
 1847:          // Update the point coordinates for the new shape coordinates
 1848:          double xcoords[3] = {x0.x, x1.x, x2.x};
 1849:          double ycoords[3] = {x0.y, x1.y, x2.y};
 1850:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 1851: 
 1852:       }
 1853: 
 1854:       // Check if the point is inside the element
 1855:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 1856:    }
 1857:    else {
 1858:       Error("Not implemented yet");
 1859: #ifdef QUADS
 1860:       // Reproject pt in eframe of nel for ics=2
 1861:       if constexpr(ics==1) {
 1862:          xn2 = xt; 
 1863:          yn2 = yt;
 1864:       }
 1865:       else {
 1866:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 1867:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 1868:       }
 1869: 
 1870:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 1871: #endif
 1872:    }
 1873: 
 1874: }
 1875: 
 1876: 
 1877: /**  Interpolate velocities at a given point (xt,yt,zt)
 1878: 
 1879:    @param xt, yt, zt: coordinates of the point to interpolate
 1880:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 1881: 
 1882:    This is done in four steps:
 1883: 
 1884:    1. Find the shape coordinates for the final position in the element.
 1885:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 1886:    3. Perform a *binary search* to find the vertical level containing zt. It will have to interpolate the 
 1887:       z levels at xt, yt at each step.   
 1888:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 1889:       horizontally and vertically.
 1890: **/
 1891: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) {
 1892:    // Interpolate the velocities at the point xt. 
 1893:    // This function works the same for triangular and quadrilateral elements.
 1894:    double shpCoord[4];
 1895: 
 1896: 
 1897:    // First step is to compute the shape coordinates of (xt,yt)
 1898:    computeShapeCoords(toVector2(xt), shpCoord, false);
 1899:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 1900: 
 1901:    // Second step is to find the level that contains zt
 1902:    // Uses a binary search to find the level
 1903:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 1904:    int L = kbe;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 1905:    int R = nvrt - 1;
 1906: 
 1907:    // Get the z coordinates at the nodes of the element at the levels L and R
 1908:    double zLAtNodes[4], zRAtNodes[4];
 1909:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 1910:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 1911: 
 1912:    double zL = interpolate(shpCoord, zLAtNodes);
 1913:    double zR = interpolate(shpCoord, zRAtNodes);
 1914:    
 1915:    // Interpolates vertically the velocities
 1916:    double wght1, wght2;
 1917:    if (xt.z<=zL) {
 1918:       wght1 = 1.0;
 1919:       wght2 = 0.0;
 1920:    }
 1921:    else if (xt.z>=zR) {
 1922:       wght1 = 0.0;
 1923:       wght2 = 1.0;
 1924:    }
 1925:    else {
 1926:       // Perform a binary search to find the levels between L and R that contain xt.z
 1927:       while (R - L > 1) {
 1928:          int M = (L + R) / 2;
 1929: 
 1930:          double zMAtNodes[4];
 1931:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 1932:          double zM = interpolate(shpCoord, zMAtNodes);
 1933:          if (zM < xt.z) 
 1934:          {
 1935:             L = M;
 1936:             zL = zM;
 1937:          }
 1938:          else 
 1939:          {
 1940:             R = M;
 1941:             zR = zM;
 1942:          }
 1943:       }
 1944:       assert(L == R-1);
 1945:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 1946: 
 1947:       wght2 = (xt.z - zL)/(zR - zL);
 1948:       wght1 = 1.0 - wght2;
 1949:    }
 1950: // printf("$$$ wght1 = %f, wght2 = %f, zt = %f, zL = %f, zR = %f\n", wght1, wght2, zt, zL, zR);
 1951: // printf("$$$ shpCoord = %f, %f, %f, %f\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 1952:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 1953:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 1954: 
 1955:    // Neither of the interpolated velocities should be NaN
 1956:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 1957: 
 1958: }
 1959: 
 1960: 
 1961: 
 1962: __inline__ __device__ double Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 1963: __inline__ __device__ double Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 1964: __inline__ __device__ Point2 Side::p_t(double t) const { return {x(t), y(t)}; }
 1965: __inline__ __device__ int    Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 1966: __inline__ __device__ double Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 1967: __inline__ __device__ double Side::depth(void)   const { return 0.5*(n1->depth + n2->depth); }
 1968: 
 1969: __inline__ __device__ double Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 1970: __inline__ __device__ double Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 1971: __inline__ __device__ double Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 1972: 
 1973: 
 1974: __inline__ __device__ double Side::Cd(void)      const { if constexpr(nchi != 0) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 1975: 
 1976: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 1977: 
 1978: /**
 1979:  * This method performs backtracking from the side center until a time -dt back in time 
 1980:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 1981:  * intermediate point.
 1982:  *
 1983:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 1984:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 1985:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 1986:  * remaining time.
 1987:  * 
 1988:  * NOTE: Runge-Kutta is not implemented yet. XXX
 1989:  * 
 1990:  * @param uuint, vvint, wwint: Velocities at the final point
 1991:  * @param jlev: Level at which the backtracking is performed
 1992:  * @param dt, dtbk: Tracking timesteps
 1993:  * @return: True if the backtracking was successful, false otherwise
 1994:  */
 1995: __inline__ __device__ bool Side::btrack(
 1996:       int jlev,
 1997:       double dt,            // Tracking time
 1998:       double dtbk,          // Tracking timestep
 1999:       Vector3 &u_int
 2000: ) const {
 2001: 
 2002:    // Start from side center
 2003:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2004:  
 2005: 
 2006:    double time_rm = dt; // Remaining time
 2007: 
 2008: 
 2009:    // // Initialize outputs XXX
 2010:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2011:    //    sclr[i] = 0.0;
 2012:    // }
 2013: 
 2014: 
 2015:    // Initial velocities
 2016:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 2017: 
 2018: 
 2019:    // Find the element that is in the direction opposite to the velocity
 2020:    Element* curElem = findElementTowards({u_int.x, u_int.y});
 2021: 
 2022:    const int MAX_ITERATIONS = 1000; 
 2023:    Element* nextElem = curElem;
 2024:    int iter = 0;
 2025:    while(true) {
 2026:       // Calculate timestep
 2027:       double dtb = min(dtbk, time_rm);
 2028: 
 2029:       // Next point in the backtracking curve
 2030:       Point3 xt = x0 - dtb*u_int;
 2031: 
 2032:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb);
 2033:       assert(found && "Backtracking failed in btrack");
 2034: // printf("<>T = %f, %f %f %f\n", time_rm - dtb, xt, yt, zt);
 2035:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2036:                       // then time_rm needs to be increased by the unused time.
 2037:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2038: 
 2039:       // The current point becomes the next segment's starting point.
 2040:       x0 = xt;
 2041:  
 2042:       curElem = nextElem;
 2043: 
 2044:       iter++;
 2045:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2046:    }
 2047: 
 2048: 
 2049: }
