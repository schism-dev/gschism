 3337:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3338: 
 3339:       NODE_BND(nodeBnd);
 3340: 
 3341:       Node *node = nodeBnd->node;
 3342: 
 3343:       node->ETP = 0.0;
 3344: 
 3345:       for (int j=0; j<ntip; j++) {
 3346: 
 3347:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3348:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3349:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3350: 
 3351:          if constexpr(iloadtide==1) { // loading tide
 3352:             assert(false && "Loading tide not implemented");
 3353:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3354:          }
 3355:          
 3356:       }
 3357:       
 3358:    }
