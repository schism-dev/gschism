 1891: __host__ __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 1892: 
 1893: __device__ double Node::compZCoord(int k) const {
 1894:    // Computes the z coordinate at level k.
 1895:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 1896:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 1897:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 1898:    // used 
 1899:    
 1900:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 1901:       
 1902:    if (idry) {
 1903:       return 0.0;
 1904:    }
 1905: 
 1906:    if constexpr(ivcor == 2) {
 1907: 
 1908:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 1909:       const int kz = mesh->kz;
 1910: 
 1911:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 1912:       // The FORTAN code computes it every time this function is called, but it should be done only 
 1913:       // once per time step/node.
 1914:       // CHECK: updateZCoordData
 1915:       if (k == kz)               return -hmod2;
 1916:       else if (k == nvrt-1)      return eta2;
 1917:       else if (k == kb)          return -depth;
 1918:       else if (k < kz && k >= 0) return mesh->ztot[k];
 1919:       else if (k > kz) {
 1920:          const int ksig = k - kz + 1;
 1921: 
 1922:          if (hmod2 <= mesh->h_c) {
 1923:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 1924:          } 
 1925:          else if (eta2 <= - mesh->h_c - (depth - mesh->h_c) * mesh->theta_f/mesh->sinh_theta_f) {
 1926:             printf("Please choose larger h_c: %f %f\n", eta2, mesh->h_c);
 1927:             Error("ZCOOR: invalid h_c\n");
 1928:          } 
 1929:          else {
 1930:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 1931:                          mesh->h_c * mesh->sigma[ksig] + 
 1932:                          (hmod2 - mesh->h_c) * mesh->cs[ksig];
 1933:          }
 1934:       } else { 
 1935:          Error("ZCOOR: invalid level or coordinate system\n");
 1936:       }
 1937: 
 1938:    }
 1939:    else if constexpr(ivcor == 1) {
 1940:       if (k == kb) return -depth;
 1941:       else if (k == nvrt-1) return eta2;
 1942:       else if (k >= kb) {
 1943:             return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 1944:       }
 1945:    }
 1946:    
 1947:    printf("ZCOOR: invalid level or coordinate system\n");
 1948:    return 0.0;
 1949: }
