  863:                        localSegmentMem(localSegmentMem),
  864:                        h_s(h_s), theta_b(theta_b), theta_f(theta_f), sigma_lcl(sigma_lcl), sigma(sigma), ztot(ztot),
  865:                        cs(cs), dcs(dcs)
  866:    {
