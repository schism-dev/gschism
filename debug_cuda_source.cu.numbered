 1151:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1152:       // Compute the different time ramps used in the code 
 1153:       // This function is performed by just one thread
 1154: 
 1155:       if constexpr(ibc == 0) {
 1156:          if (drampbc > 0.0) {
 1157:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1158:          } else {
 1159:             rampbc = 1.0;
 1160:          }
 1161: 
 1162:          if (nws != 0 && drampwind > 0.0) {
 1163:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1164:          } else {
 1165:             rampwind = 1.0;
 1166:          }
 1167:       }
 1168: 
 1169:       if (drampwafo > 0.0) {
 1170:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1171:       } else {
 1172:          rampwafo = 1.0;
 1173:       }
 1174: 
 1175:       // For source/sinks
 1176:       if (if_source && dramp_ss > 0.0) {
 1177:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1178:       } else {
 1179:          ramp_ss = 1.0;
 1180:       }
 1181: 
 1182:       if (dramp > 0.0) {
 1183:          ramp = tanh(2.0*time/86400.0/dramp);
 1184:       } else {
 1185:          ramp = 1.0;
 1186:       }
 1187: 
 1188:       printf("computeTimeRamps: i = %d, nws = %d, if_source = %d, drampbc = %f, drampwind = %f, drampwafo = %f, dramp_ss = %f, dramp = %f\n", 
 1189:              threadIdx.x + blockIdx.x * blockDim.x, nws, if_source, drampbc, drampwind, drampwafo, dramp_ss, dramp);
 1190:    }
