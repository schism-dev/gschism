  862: // This struct is used to store the boundary information for a node.
  863: struct NodeBoundary {   
  864:    BoundarySegment *segment;
  865:    Node *node;
  866:    
  867:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
  868:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
  869: 
  870:    double etaic;  // Elevation at nodes used for essential boundary conditions
  871:    double elbc;   // Elevation boundary condition
  872:    int iettype;   // Type of elevation boundary condition
  873:    double eth;    // Elevation time history
  874: 
  875:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
  876:       assert(index == 0 || index == 1); 
  877:       return (index == 0) ? sideBnd1 : sideBnd2; 
  878:    }
  879: };
  880: 
  881: struct Node {
  882: 
  883:    // Geometry information
  884:    int idx;        // Index of the node
  885:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
  886:    int numNodes;   // Number of nodes neighbors of this node
  887: 
  888:    Element **elements; // Array of pointers to the elements that share this node
  889:    int numElements;   // Number of elements that share this node
  890: 
  891:    Point3 p;
  892:    Vector3 u2[nvrt];
  893:    double znl[nvrt];
  894:    double lon, lat;
  895:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
  896:    double depth;
  897: 
  898:    int kb;       // Bottom index of the node
  899: 
  900:    bool isDry;     // True if the node is dry
  901: 
  902:    int iadv;     // Advection flag
  903: 
  904:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
  905: 
  906:    // Physical information
  907:    Tracers tr_nd0[nvrt]; // Initial tracer conc. at nodes
  908: 
  909:    double rho[nvrt];     // Density
  910: 
  911:    double eta1; // Elevation at nodes at previous timestep
  912:    double eta2; // Elevation at nodes at current timestep
  913: 
  914:    double ETP;  // Earth Tidal Potential
  915: 
  916:    
  917:    double pr;    // Air pressure
  918:    double grav2; // Gravity 
  919:    
  920:    Vector2 dav;  // Depth averaged velocity
  921: 
  922:    Vector2 tau; // Wind stress vector
  923: 
  924:    // Vegetation parameters
  925:    double veg_h;
  926:    double veg_nv;
  927:    double veg_di;
  928:    double veg_Cd;
  929:    double veg_h_unbent;
  930:    double veg_di_unbent;
  931:    double veg_nv_unbent;
  932:    double veg_alpha_vert_mean;
  933:    double veg_alpha0;
  934:    double veg_alpha3D[nvrt];
  935: 
  936:    // Bottom drag parameters
  937:    double Cd;       // Bottom drag coefficient
  938:    double rough;    // Bottom roughness length
  939:    Vector2 tau_bot; // Bottom stress vector
  940: 
  941:    double bdef1; // Bottom deformation at previous timestep
  942:    double bdef2; // Bottom deformation at current timestep
  943: 
  944:    double qel; // RHS
  945:    double coeffDiag; // Diagonal coefficient of the matrix
  946:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
  947: 
  948:    double mP; // Search direction for conjugate gradient method
  949:    double mR; // Residual for conjugate gradient method
  950:    double mAp; // Product of matrix and search direction for conjugate gradient method
  951:    double mX; // Solution for conjugate gradient method
  952: 
  953:    // Meteorological forcing
  954:    Vector2 u_air;
  955:    double p_air;
  956:    double t_air;
  957:    double q_air;
  958:    double wind_angle;  // Wind rotation angle
  959: 
  960:    __host__ __device__ void setWind(Vector2 &u) {
  961:    // Sets the wind vector taking into account the wind rotation angle
  962:    
  963:       const double dir = atan2(-u.x,-u.y);
  964:       const double speed = length(u);
  965: 
  966:       // Calculate new u and v components with added rotation angle
  967:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
  968:    }
  969: 
  970:    __host__ __device__ Point2 p2(void) const { return {p.x, p.y}; }
  971: 
  972:    __host__ __device__ double sigmaTransitionDepth(void) const;
  973: 
  974:    __inline__ __device__ double Dz(int k) const { return znl[k] - znl[k-1]; }
  975:    __inline__ __device__ double htot(void) const { return eta2 + depth; }
  976:    __inline__ __device__ double zTopCanopy(void) const { return znl[kb] + veg_h; } 
  977: 
  978:    __device__ void clearMatrixRow(void) {
  979:       // Clear the matrix row for this node
  980:       coeffDiag = 0.0;
  981:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
  982: 
  983:    }
  984: 
  985:    __device__ void addToSparseMatrix(Node const *node, double value) {
  986:       // Add the value to the sparse matrix for this node
  987:       
  988:       if (node == this) {
  989:          coeffDiag += value;
  990:       } else {
  991:          // Search (linearly)the index of the node in the array of nodes
  992:          // XXX: This is not efficient, see if we can improve this
  993:          int i;
  994:          for (i = 0; i < numNodes; i++) {
  995:             if (nodes[i] == node) {
  996:                break;
  997:             }
  998:          }
  999:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1000:          coeffMatrix[i] += value;
 1001:       }
 1002:    }
 1003: 
 1004: #ifdef BACKTRACKING
 1005:    __device__ void updateZCoordData() {
 1006:    // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 1007: 
 1008:       // Check if node is wet
 1009:       isDry = (depth + eta2 <= h0);  // XXX Check if we are doing this elsewhere
 1010: 
 1011:       if (idry) return;
 1012: 
 1013:       if constexpr(ivcor == 2) {  // SZ coordinates
 1014:          
 1015:          // Compute bottom level index
 1016:          if (depth <= mesh->h_s) {
 1017:                kb = mesh->nzlevels;
 1018:          } else {
 1019:                kb = -1;
 1020:                for (int i = 0; i < mesh->kz-1; i++) {
 1021:                   if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 1022:                      kb = i;
 1023:                      break;
 1024:                   }
 1025:                }
 1026:          }
 1027:       } 
 1028:       else if (ivcor == 1) {  // Localized sigma
 1029:          // Do nothing
 1030:       }
 1031: 
 1032:    }
 1033: #endif   
 1034: 
 1035:    __device__ double compZCoord(int k) const;
 1036: 
 1037: 
 1038: 
 1039: };
