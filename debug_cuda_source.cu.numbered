 1099: // Helper functions for computing the local node index at a given offset from another.
 1100: __device__ __inline__ int nxq(int offset, int index, int size) {
 1101:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1102:    // to the index to make it positive
 1103:    assert(index + offset + 16*size >= 0);
 1104:    return (index + offset + 16*size) % size;  
 1105: }
 1106: 
 1107: __device__ __inline__ int nxq(int index, int size) {
 1108:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1109:    // to the index to make it positive
 1110:    assert(index + 16*size >= 0);
 1111:    return (index + 16*size) % size; 
 1112: }
