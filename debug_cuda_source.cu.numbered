 2288: __host__ __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2289: 
 2290: __device__ double Node::compZCoord(int k) const {
 2291:    // Computes the z coordinate at level k.
 2292:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2293:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2294:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2295:    // used 
 2296:    
 2297:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2298:       
 2299:    if (isDry)  return 0.0;
 2300: 
 2301:    if constexpr(ivcor == 2) {
 2302: 
 2303:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2304:       const int kz = mesh->kz;
 2305: 
 2306:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2307:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2308:       // once per time step/node.
 2309:       // CHECK: updateZCoordData
 2310: 
 2311:       if (k == kz)               return -hmod2;
 2312:       else if (k == nvrt-1)      return eta2;
 2313:       else if (k == kb)          return -depth;
 2314:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2315:       else if (k > kz) {
 2316:          const int ksig = k - kz + 1;
 2317: 
 2318:          if (hmod2 <= mesh->h_c) {
 2319:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2320:          } 
 2321:          else if (eta2 <= - mesh->h_c - (depth - mesh->h_c) * mesh->theta_f/mesh->sinh_theta_f) {
 2322:             printf("Please choose larger h_c: %f %f\n", eta2, mesh->h_c);
 2323:             Error("ZCOOR: invalid h_c\n");
 2324:          } 
 2325:          else {
 2326:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2327:                          mesh->h_c * mesh->sigma[ksig] + 
 2328:                          (hmod2 - mesh->h_c) * mesh->cs[ksig];
 2329:          }
 2330:       } else { 
 2331:          Error("ZCOOR: invalid level or coordinate system\n");
 2332:       }
 2333: 
 2334:    }
 2335:    else if constexpr(ivcor == 1) {
 2336:       if (k == kb) return -depth;
 2337:       else if (k == nvrt-1) return eta2;
 2338:       else if (k >= kb) {
 2339:             return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2340:       }
 2341:    }
 2342:    
 2343:    printf("ZCOOR: invalid level or coordinate system\n");
 2344:    return 0.0;
 2345: }
