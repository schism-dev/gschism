 3225:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3226: 
 3227:       NODE_BND(nodeBnd);
 3228: 
 3229:       Node *node = nodeBnd->node;
 3230: 
 3231:       node->ETP = 0.0;
 3232: 
 3233:       for (int j=0; j<ntip; j++) {
 3234: 
 3235:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3236:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3237:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3238: 
 3239:          if constexpr(iloadtide==1) { // loading tide
 3240:             assert(false && "Loading tide not implemented");
 3241:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3242:          }
 3243:          
 3244:       }
 3245:       
 3246:    }
