  249: // Polynomial class
  250: template<int grade>
  251: struct Polynomial {
  252:     // Static assertion to give a clear error message at compile time
  253:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  254: };
  255: 
  256: 
  257: // Explicit specialization for grade 4
  258: template<>
  259: struct Polynomial<4> {
  260:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  261: 
  262:    // Constructor from coefficients
  263:    __device__ __host__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  264: 
  265:    __device__ __host__ __forceinline__ double eval(double x) const {
  266:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  267:    }
  268: };
