 3217: extern "C" {
 3218: 
 3219:    __global__ void scaleGravity(double loadtide_coef) {
 3220: 
 3221: 
 3222:       NODE(node);
 3223: 
 3224:       // SAL option: scale gravity
 3225:       if constexpr(iloadtide==2) {  // simple const
 3226:          node->grav2 = grav*(1.0 - loadtide_coef);
 3227: 
 3228:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3229:         
 3230:           const double depth = max(node->depth, 0.0);
 3231:           const double tmp1 = sqrt(depth);
 3232:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3233:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3234:                              2.6969e-13*depth*depth*depth*tmp1;
 3235:           
 3236:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3237:           
 3238: 
 3239: 
 3240:           node->grav2 = grav*(1.0 - beta_bar);
 3241: 
 3242:       } else {  // iloadtide=0,1
 3243:         node->grav2=grav;
 3244: 
 3245:       }
 3246: 
 3247:       printf("scaleGravity: node(%d)->grav2 = %f\n", node->idx, node->grav2);
 3248:    }
 3249: 
