  798: struct Node {
  799: 
  800:    // Geometry information
  801:    int idx;        // Index of the node
  802:    Node **nodes;   // pointer to the nodes that are neighbors of this node (there is no guarantee that they are connected)
  803:    int numNodes;   // number of nodes neighbors of this node
  804: 
  805:    Element **elements; // pointer to the elements that share this node
  806:    int numElements;   // number of elements that share this node
  807: 
  808:    Point3 p;
  809:    Vector3 u2[nvrt];
  810:    double znl[nvrt];
  811:    double lon, lat;
  812:    double fun_lat[ntip]; // XXXXX CHECK IF THIS MAKES SENSE
  813:    double depth;
  814: 
  815:    int kb;       // Bottom index of the node
  816: 
  817:    bool isDry;     // True if the node is dry
  818: 
  819:    int iadv;     // Advection flag
  820: 
  821:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
  822: 
  823:    // Physical information
  824:    Tracers tr_nd0[nvrt]; // Initial tracer conc. at nodes
  825: 
  826:    double rho[nvrt];     // Density
  827: 
  828:    double eta1; // Elevation at nodes at previous timestep
  829:    double eta2; // Elevation at nodes at current timestep
  830: 
  831:    double ETP;  // Earth Tidal Potential
  832: 
  833:    
  834:    double pr;    // Air pressure
  835:    double grav2; // Gravity 
  836:    
  837:    Vector2 dav;  // Depth averaged velocity
  838: 
  839:    Vector2 tau; // Wind stress vector
  840: 
  841:    // Vegetation parameters
  842:    double veg_h;
  843:    double veg_nv;
  844:    double veg_di;
  845:    double veg_Cd;
  846:    double veg_h_unbent;
  847:    double veg_di_unbent;
  848:    double veg_nv_unbent;
  849:    double veg_alpha_vert_mean;
  850:    double veg_alpha0;
  851:    double veg_alpha3D[nvrt];
  852: 
  853:    // Bottom drag parameters
  854:    double Cd;       // Bottom drag coefficient
  855:    double rough;    // Bottom roughness length
  856:    Vector2 tau_bot; // Bottom stress vector
  857: 
  858:    double bdef1; // Bottom deformation at previous timestep
  859:    double bdef2; // Bottom deformation at current timestep
  860: 
  861:    double qel; // RHS
  862: 
  863:    // Meteorological forcing
  864:    Vector2 u_air;
  865:    double p_air;
  866:    double t_air;
  867:    double q_air;
  868:    double wind_angle;  // Wind rotation angle
  869: 
  870:    __host__ __device__ void setWind(Vector2 &u) {
  871:    // Sets the wind vector taking into account the wind rotation angle
  872:    
  873:       const double dir = atan2(-u.x,-u.y);
  874:       const double speed = length(u);
  875: 
  876:       // Calculate new u and v components with added rotation angle
  877:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
  878:    }
  879: 
  880:    __host__ __device__ Point2 p2(void) const { return {p.x, p.y}; }
  881: 
  882:    __host__ __device__ double sigmaTransitionDepth(void) const;
  883: 
  884:    __inline__ __device__ double Dz(int k) const { return znl[k] - znl[k-1]; }
  885:    __inline__ __device__ double htot(void) const { return eta2 + depth; }
  886:    __inline__ __device__ double zTopCanopy(void) const { return znl[kb] + veg_h; } 
  887: 
  888:    __device__ void clearMatrixRow(void) {
  889:       // Clear the matrix row for this node
  890:       printf("NOT IMPLEMENTED: clearMatrixRow\n");
  891:    }
  892: 
  893:    __device__ void addToSparseMatrix(Node const *node, double value) {
  894:       // Add the value to the sparse matrix for this node
  895:       printf("NOT IMPLEMENTED: addToSparseMatrix\n");
  896:    }
  897: 
  898: #ifdef BACKTRACKING
  899:    __device__ void updateZCoordData() {
  900:    // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
  901: 
  902:       // Check if node is wet
  903:       isDry = (depth + eta2 <= h0);  // XXX Check if we are doing this elsewhere
  904: 
  905:       if (idry) return;
  906: 
  907:       if constexpr(ivcor == 2) {  // SZ coordinates
  908:          
  909:          // Compute bottom level index
  910:          if (depth <= mesh->h_s) {
  911:                kb = mesh->nzlevels;
  912:          } else {
  913:                kb = -1;
  914:                for (int i = 0; i < mesh->kz-1; i++) {
  915:                   if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
  916:                      kb = i;
  917:                      break;
  918:                   }
  919:                }
  920:          }
  921:       } 
  922:       else if (ivcor == 1) {  // Localized sigma
  923:          // Do nothing
  924:       }
  925: 
  926:    }
  927: #endif   
  928: 
  929:    __device__ double compZCoord(int k) const;
  930: 
  931: 
  932: 
  933: };
