 3386:    __global__ void computeElevationBoundaryConditions(double time) {
 3387:       // Compute elevation essential boundary conditions 
 3388: 
 3389:       NODE_BND(nodeBnd); // Each boundary node.
 3390: 
 3391:       const Node *node = nodeBnd->node;
 3392:       const int iettype = nodeBnd->iettype;
 3393: 
 3394:       double eic = 0.0;
 3395:       if (nramp_elev==1) eic = nodeBnd->etaic;
 3396:       else               eic = 0.0;
 3397: 
 3398:       const double r_eic = (1.0 - ramp)*eic; 
 3399:       const double r_eth = ramp*nodeBnd->eth;
 3400:       double eta1_bar = r_eic;
 3401: 
 3402:       // Compute tide elevation
 3403:       if (iettype == 3 || iettype == 5) {
 3404:         
 3405:          // XXX IMPLEMENT TIDE THINGS
 3406:          assert(false && "Tide elevation not implemented");
 3407:          // for (int jfr=0; jfr<nbfr; jfr++) { // For all tide frequencies
 3408:          //    const int ncyc = int(amig[jfr]*time/(2.0*pi));
 3409:          //    const double arg = amig[jfr]*time - 2.0*pi*ncyc + face[jfr] - efa[i,j,jfr];
 3410:          //    eta1_bar += ramp*ff[jfr]*emo[i,j,jfr]*cos(arg);
 3411:          // } // for jfr
 3412:       } // if iettype
 3413: 
 3414:       switch (iettype) {
 3415:          case 1:
 3416:          case 2:
 3417:             nodeBnd->elbc = r_eth + r_eic;
 3418:             break;
 3419:          case 3:
 3420:             nodeBnd->elbc = eta1_bar + r_eic;
 3421:             break;
 3422:          case 4:
 3423:             nodeBnd->elbc = r_eth + r_eic;
 3424:             break;
 3425:          case 5:
 3426:             nodeBnd->elbc = r_eth + eta1_bar + r_eic;
 3427:             break;
 3428:       } // switch
 3429: 
 3430: 
 3431:       //Add inverse barometric effects
 3432:       if (iettype != 0 && inv_atm_bnd == 1) {
 3433:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 3434:       }
 3435: 
 3436:    }
 3437: 
 3438:    __global__ void computeVerticallyIntegratedVelocity(void) {
 3439: 
 3440:       SIDE(side);
 3441: 
 3442: 
 3443:       side->U = {0.0, 0.0}; 
 3444:          
 3445:       if(side->isDry) return;
 3446: 
 3447:       const Node *node1 = side->n1;
 3448:       const Node *node2 = side->n2;
 3449: 
 3450:       // Vertically integrated velocity U (in ll if ics=2)
 3451:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 3452:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 3453:       }
 3454: 
 3455:    }
 3456: 
 3457:    __global__ void computeBottomDragVegetation(void) {
 3458:       // UNFINISHED. CHECK THIS:
 3459:       // How many kernels are needed? Why so many for loops?
 3460:       // Is the loop on sides needed?
 3461: 
 3462:       NODE(node);
 3463: 
 3464:       const int    kb      = node->kb;
 3465:       const double htot    = node->htot();
 3466:       const double rough   = node->rough;
 3467: 
 3468: 
 3469:       if (node->isDry) {
 3470:          // Default values for dry nodes
 3471:          node->veg_alpha_vert_mean = node->veg_alpha0;
 3472:          /// XXX CHECK INDICES
 3473:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 3474:       }
 3475: 
 3476:       // Compute bottom drag Cd
 3477:       //--------------------------------
 3478: 
 3479:       // nchi = {-1, 0, 1} is the type of bottom drag.
 3480:       if (nchi==1) {
 3481: 
 3482:          bool ltmp = false; // for WBL iteration
 3483: 
 3484:          // Cdmax=-1 !max. Cd at node for this process (info only)
 3485:          // Drag at nodes
 3486:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 3487:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 3488:         
 3489:          const double rough = node->rough;
 3490:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3491:          if (node->rough == 0.0) {
 3492:             node->Cd = 0.0;
 3493: 
 3494:          } else { //roughness >0 
 3495:             
 3496:             const double bthick_ori = node->znl[kb + 1] - node->znl[kb];  // thickness of bottom bnd layer
 3497:             const double bthick = max(dzb_min, bthick_ori);
 3498: 
 3499:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 3500: 
 3501:             double tmp = 1.0/(2.5*log(bthick/rough));
 3502:             node->Cd = tmp*tmp;
 3503: 
 3504:          } // if rough
 3505: 
 3506: 
 3507:          // RECOVER THIS: XXX
 3508:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 3509:          // Output warning for WBL if iteration didn't converge
 3510: 
 3511: 
 3512:       } // nchi==1
 3513: 
 3514:       //   Bottom stress in m^2/s^2
 3515:       if (node->rho[kb + 1] >= -98.0)
 3516:       {
 3517:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 3518:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 3519:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 3520:          // !sediment erosion: this part needs more documentation
 3521:       }
 3522: 
 3523:     
 3524:       // Compute vegetation parameters
 3525:       //--------------------------------
 3526: 
 3527:       // SAV constants
 3528:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 3529:       constexpr double veg_cfpsi = 0.16;
 3530: 
 3531:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 3532:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 3533: 
 3534:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 3535:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 3536:          int kbin = 0; // bin index
 3537:          for (int k = kb; k < nvrt; k++) {
 3538:             // Computes node height above the bottom level
 3539:             const double tmp_h = node->znl[k] - node->znl[kb]; // >=0
 3540:             assert(false && "Vertical variation of vegetation not implemented");
 3541: 
 3542:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 3543:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 3544:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 3545:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 3546:             // } else {
 3547:             //    // Find the bin at which the current vertical level is
 3548:             //    while (kbin<nbins_veg_vert) {
 3549:             //       const double zn = node->znl[kbin];
 3550:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 3551:             //          break;
 3552:             //       } // if
 3553:             //       kbin++;
 3554:             //    } // while
 3555:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 3556: 
 3557:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 3558:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 3559:                
 3560:             //    // Linear interpolation of the vegetation parameters
 3561:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 3562:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 3563:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 3564:             // } // if rl10
 3565: 
 3566:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 3567: 
 3568:          } // for k
 3569: 
 3570: 
 3571:       } else { // Ganthy (iveg=2)
 3572:       //  Modify canopy height, diameter, and density
 3573: 
 3574:          // Make sure there is vegetation on this node
 3575:          if (node->veg_h_unbent > 0.0) {
 3576:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 3577: 
 3578:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 3579:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 3580:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 3581: 
 3582:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 3583:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 3584:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 3585:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 3586:          } // if veg_h_unbent
 3587: 
 3588:          for (int k = 0; k < nvrt; k++) {
 3589:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 3590:          } // for k
 3591:       
 3592: 
 3593:       } // if iveg
 3594:      
 3595:          
 3596: 
 3597:       // Compute vertical mean of veg_alpha3D
 3598:       if (iveg != 0) {
 3599:          const double ztop = node->zTopCanopy(); // Top of the canopy
 3600:          double sum1=0.0;
 3601:          double sum2=0.0;
 3602:          // Integrate over each level under the canopy...
 3603:          for (int k=kb; k<nvrt-1 && node->znl[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 3604:             const double Dz = node->Dz(k);
 3605: 
 3606:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 3607:             sum2 += Dz;
 3608: 
 3609:          } // for k
 3610: 
 3611:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 3612:          else             node->veg_alpha_vert_mean = sum1/sum2;
 3613: 
 3614:       } // if iveg
 3615: 
 3616:       printf("computeBottomDragVegetation: nodeIdx = %d, node->veg_alpha_vert_mean = %f\n", node->idx, node->veg_alpha_vert_mean);
 3617: 
 3618:    }
 3619: 
 3620:    __global__ void computeVegetationAndDragParameters(void) {
 3621:       // Computes the vegetation and drag model parameters:
 3622:       // chi, \tilde\chi, beta, \breve{H}
 3623:       
 3624:       SIDE(side);
 3625: 
 3626:       const double htot = side->htot();
 3627:       const int    kb   = side->kb;
 3628: 
 3629:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 3630: 
 3631:       const double veg_h     = side->veg_h();
 3632:       const double veg_nv    = side->veg_nv();
 3633:       const double veg_c     = side->veg_c();
 3634:       const double veg_beta  = side->veg_beta;
 3635:       const double veg_alpha = side->veg_alpha_vert_mean();
 3636: 
 3637:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 3638:       // Velocity magnitude at the bottom level
 3639:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 3640:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 3641:       side->chi2 = side->Cd()*vmag1;
 3642:       side->chi  = side->chi2;
 3643:       if constexpr(iveg != 0) {
 3644:          const Node *n1 = side->n1;
 3645:          const Node *n2 = side->n2;
 3646:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 3647:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 3648:       }
 3649: 
 3650:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 3651: 
 3652:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 3653:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 3654:       double magUa = 0.0;
 3655:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 3656:          // 3D wet side with veg...
 3657: 
 3658:          double magUa = 0.0;
 3659:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 3660:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 3661: 
 3662:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 3663:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 3664:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 3665: 
 3666:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 3667:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 3668: 
 3669:                // Velocity magnitude at the bottom (l) of the level
 3670:                const double ul = length(side->u2[k]);
 3671: 
 3672:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 3673:                magUa += Dz*0.5*(uh + ul);
 3674: 
 3675:             } // if HasVegetation
 3676:          } // for k
 3677:          const double ua = magUa/min(htot, veg_h); // Vertical average
 3678: 
 3679:          // Computes beta, used for computing the stress term at the top of the canopy.      
 3680:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 3681:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 3682:             const double zCpy = side->zTopCanopy();
 3683:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 3684:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 3685:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 3686:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 3687:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 3688:          } // if isSubmerged
 3689:       } // if iveg   
 3690: 
 3691:       // Computes the friction modified depth, \breve{H} in notes
 3692:       if (side->is2D()) { // 2D
 3693: 
 3694:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 3695:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 3696: 
 3697:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 3698: 
 3699:          side->hhat = htot*htot/fricH; 
 3700: 
 3701:       } else { // 3D
 3702:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 3703: 
 3704:          if constexpr(iveg != 0) {
 3705:             
 3706:             if (side->isSubmerged()) { 
 3707:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 3708:                side->hhat -= veg_c*Hhat_alpha;
 3709: 
 3710:             } else { // Emergent
 3711:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 3712:             }
 3713:          } // if iveg
 3714: 
 3715:          // Enforce positivity for 3D model
 3716:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 3717:       } // if 3D
 3718: 
 3719:       printf("computeVegetationAndDragParameters: sideIdx = %d, side->htot = %f, side->hhat = %f\n", side->idx, side->htot(), side->hhat);
 3720: 
 3721:         
 3722:    }
 3723: 
 3724: 
 3725: 
 3726:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 3727:    // Computes the density gradient between two elements, e1 and e2.
 3728:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 3729:    // zero in the direction normal to the side. 
 3730:    // 
 3731:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 3732:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 3733:    //
 3734:    // Input:
 3735:    //    e1: Element
 3736:    //    e2: Neighbor element (or nullptr if boundary)
 3737:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 3738:    //    k: Index of the half-level at which the density is interpolated
 3739:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 3740:    // 
 3741:    // Output:
 3742:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 3743:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 3744: 
 3745:       if (e2 == nullptr || e2->isDry) {
 3746:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 3747: 
 3748:          Side *side = e1->sides[j];
 3749:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 3750:                  
 3751:          if constexpr(ics == 1) {
 3752:             vec = side->n; // Normal vector to the side
 3753:          } else {
 3754:             // IMPLEMENT THIS XXXXXX
 3755:             // !replace with xel, yel?
 3756:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 3757:             //      &eframe(:,:,i),xn1,yn1,tmp)
 3758:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 3759:             //      &eframe(:,:,i),xn2,yn2,tmp)
 3760:          } //ics
 3761:                    
 3762:          diffRho = 0.0;
 3763: 
 3764:       } else { //internal and wet
 3765:          if constexpr(ics==1) {
 3766:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 3767: 
 3768:             // Vector from e1 to e2
 3769:             vec = toVector2(e2->center - e1->center);
 3770: 
 3771:          } else { 
 3772:             // IMPLEMENT THIS XXXXXX
 3773:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 3774:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 3775:             //                   alow(j)=xctr2
 3776:             //                   bdia(j)=yctr2
 3777:          } // ics
 3778: 
 3779:          diffRho = rho2 - e1->demeanedDensity(k);
 3780:       }
 3781: 
 3782:    }
 3783: 
 3784:    __global__ void computeDensityCubicSplines(void) {
 3785:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 3786: 
 3787:       ELEM(elem);
 3788: 
 3789:       if (elem->isDry) return;
 3790: 
 3791:       const int kb = elem->kb;
 3792: 
 3793:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 3794:       if (elem->is2D()) {
 3795:          // In the 2D case, the density is constant at the prism level. 
 3796:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 3797:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 3798:       } else { //3D
 3799: 
 3800:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 3801:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 3802:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 3803:          ///// XXXX CHECK INDICES!!!!!
 3804:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 3805:       } // 2D/3D
 3806: 
 3807:    }
 3808: } // extern "C"
 3809: 
 3810: 
 3811: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 3812: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 3813: 
 3814:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 3815: 
 3816:    const int kb  = elem->kb;
 3817:    const int kb2 = elem2->kb;
 3818: 
 3819:    // z-coordinate of prism of elem
 3820:    const double zp = elem->z_prism(k);
 3821: 
 3822:    double rho = 0.0;
 3823: 
 3824:    if (elem2->is2D()) {
 3825:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 3826: 
 3827:    } else {  // 3D
 3828: 
 3829:       // eta_min may be < zmax
 3830:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 3831:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 3832: 
 3833:       // (Extrapolate density below bottom, we will fix it later)
 3834:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 3835:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 3836:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 3837:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 3838:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 3839:    } // 2D/3D
 3840:      
 3841: 
 3842:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 3843:    // Now we need to fix it.
 3844:    if (elem->z[k] < elem2->z[kb2]) {
 3845:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 3846: 
 3847:       // There are two methods to adjust the density at the bottom of the element.
 3848:       // iunder_deep=0: 
 3849:       const double depth1 = abs(elem->z[kb]); // larger depth
 3850: 
 3851:       if (iunder_deep==0) {
 3852: 
 3853:          const double weight = max(0.0, min(1.0, (depth1 - h1_bcc)/(h2_bcc - h1_bcc))); // weight
 3854: 
 3855:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 3856: 
 3857:       } else { // iunder_deep != 0
 3858: 
 3859:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 3860: 
 3861:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 3862: 
 3863:          //   Demeaned density at the same z coordinate as
 3864:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 3865:          }
 3866: 
 3867:       } // if iunder_deep
 3868:    } // if elem->z[kb] < elem2->z[kb]
 3869: 
 3870:    return rho;
 3871: }
 3872: 
 3873: 
 3874: extern "C" {
 3875:    __global__ void computeDensityGradient(void) {
 3876: 
 3877:          // Compute the horizontal density gradient at each element.
 3878:       // It works in two steps:
 3879:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 3880:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 3881:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 3882:       //             gradRho.r1 = rho1 - rho0
 3883:       //             gradRho.r2 = rho2 - rho0
 3884:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 3885:       // 
 3886:       //  NOTE: We use de-meaned densities.
 3887: 
 3888:       ELEM(elem);
 3889: 
 3890:       if (elem->isDry) return;
 3891: 
 3892:       const int kb  = elem->kb;
 3893:       const int i34 = elem->i34;
 3894: 
 3895:       for (int k = kb + 1; k < nvrt; k++) {
 3896:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 3897:          //             gradRho.r1 = rho1 - rho0
 3898:          //             gradRho.r2 = rho2 - rho0
 3899:          int icount = 0;
 3900:          double sumRx = 0.0;
 3901:          double sumRy = 0.0;
 3902:          for (int j1=0; j1<i34; j1++) { 
 3903: 
 3904:             const int j2 = elem->nxq(j1 + 1);
 3905: 
 3906:             // Pairs of consecutive neighbor elements of elem
 3907:             const Element *e1 = elem->nghbElems[j1];
 3908:             const Element *e2 = elem->nghbElems[j2];
 3909: 
 3910:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 3911:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 3912:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 3913: 
 3914:             // Compute the density difference and the vector from elem to e1 and e2
 3915:             // getRhoDiffAndVec takes into account boundaries/dry elements
 3916:             double diffRho1, diffRho2;
 3917:             Vector2 vec1, vec2;
 3918:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 3919:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 3920: 
 3921:             const double rl1 = length(vec1);
 3922:             const double rl2 = length(vec2);
 3923:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 3924: 
 3925:             const double delta = cross(vec1, vec2);
 3926:             const double sintheta = abs(delta)/(rl1*rl2);
 3927: 
 3928:             // To avoid problems, avoid elements with small angle between vectors
 3929:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 3930:             const bool validEq = (sintheta > sin_one_deg);
 3931: 
 3932:             if (validEq) {
 3933:                // Solve the system of equations to get the density gradient at elem
 3934:                icount++;
 3935:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 3936:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 3937:                sumRx += Rx;
 3938:                sumRy += Ry;
 3939:             }
 3940:          } // for j1
 3941: 
 3942:          // Compute the average density gradient at elem
 3943:          if (icount==0) {
 3944:            // Bad mesh quality; bail out with 0 b-cc
 3945:            elem->gradRho[k] = {0.0, 0.0};
 3946:          } else {
 3947:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 3948:          }
 3949: 
 3950:       } // for k
 3951: 
 3952:    }
 3953: 
 3954:    __global__ void computeBaroclinicTerm(void) {
 3955:    // Computes the baroclinic term at sides (at half levels).
 3956:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 3957:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 3958: 
 3959:       SIDE(side);
 3960: 
 3961:       if (side->isDry) return;
 3962: 
 3963:       const Element *e1 = side->elems[0];
 3964:       const Element *e2 = side->elems[1];      
 3965:       const int kb = side->kb;
 3966:       
 3967:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 3968: 
 3969:       // interpolates vertically the density gradient of the two elements at the half level/
 3970: 
 3971:       // Starts the integration at the surface and goes down to the bottom
 3972:       int k1 = nvrt - 1;
 3973:       int k2 = nvrt - 1;
 3974: 
 3975:       side->bcc[nvrt-1] = {0.0, 0.0};
 3976:       for (int k = nvrt-1; k >= kb; k--) {
 3977:       // For each prism level (from surface to bottom)...
 3978: 
 3979:          // For both elements, interpolate density gradient at the side's half level.
 3980:          // The gradient at the side is the average of the gradients at the elements.
 3981:          // w1, w2 are used to take into account boundary sides, with just one element.
 3982:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 3983:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 3984:          const double wsum = w1 + w2;
 3985:          w1 = w1/wsum;
 3986:          w2 = w2/wsum;
 3987:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 3988: 
 3989:          // Linear interpolation of both elements' density gradient at the shared side's level.
 3990:          Vector2 gradRho = {0.0, 0.0};
 3991:          if (e1 != nullptr && k > kb) {
 3992:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 3993:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 3994:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 3995:             
 3996:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 3997:          }      
 3998:          if (e2 != nullptr && k > kb) {
 3999:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4000:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4001:             
 4002:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4003:          }
 4004: 
 4005:          if constexpr(ics==2) {
 4006:             // IMPLEMENT THIS XXXXXX
 4007:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4008:             // swild(1)=tmp1
 4009:             // swild(2)=tmp2
 4010:          }
 4011:          
 4012:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4013:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4014:          // CHECK INDICES!!! XXX
 4015:          const double grav3 = 0.5*(side->n1->grav2 + side->n2->grav2);
 4016:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4017:       } // for
 4018: 
 4019:    }
 4020: 
 4021: } // extern "C"
 4022: 
 4023: #ifdef DONTCOMPILE
 4024: __device__ void computeVerticalAdvection(void) {
 4025:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 4026: 
 4027:    sdbt(1:2,:,:)=0.d0
 4028: 
 4029:    const Side *side = FROM kernel;
 4030: 
 4031:    if(side->isDry) return;
 4032: 
 4033:    // If side is wet...
 4034: 
 4035: 
 4036:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 4037:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 4038:    double ws[nvrt] = {} // w @ side
 4039:    int icount = 0;
 4040:    for (int j=0; j<2; j++) {
 4041:       const Element *elem = side->elements[j];
 4042:        
 4043:       if(elem != nullptr) {
 4044:          icount++;
 4045:          for (int k=0; k<nvrt; k++) {
 4046:             ws[k] = ws[k] + elem->w[k];
 4047:          }
 4048:       }
 4049:    }  // for j
 4050: 
 4051:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 4052:    ws = ws/icount;
 4053: 
 4054:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 4055:    // Splines allow for a smooth transition between vertical levels.
 4056:    // Splines have continuity restrictions at the internal knots, but
 4057:    // we have to provide the 1st derivatives at the endpoints.
 4058:    const int kbs = side->kbs; 
 4059:    
 4060:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 4061:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 4062:    initCubicSpline(kbs, nvrt, side, ws, up)
 4063: 
 4064:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 4065:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 4066:    initCubicSpline(kbs, nvrt, side, ws, vp)
 4067: 
 4068:    // Total advection (average onto side)
 4069:    const Node *node1 = side->nodes[0];
 4070:    const Node *node2 = side->nodes[1];
 4071:    for (int k=kbs(i); k<nvrt; k++) {
 4072: 
 4073:       if constexpr(ics==1) {
 4074:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 4075:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 4076:       } else {
 4077:          // XXX IMPLEMENT THIS
 4078:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 4079:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 4080:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 4081:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 4082:       }  // if ics
 4083: 
 4084: 
 4085:    }
 4086: }
 4087: #endif
 4088: 
 4089: 
 4090: extern "C" {
 4091:    __global__ void computeElemAverageGhat(void) {
 4092:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 4093: 
 4094:       ELEM(elem);
 4095:       
 4096:       elem->ghat1= {0.0, 0.0};  
 4097: 
 4098:       if constexpr(ihydraulics != 0) {
 4099:          if (nhtblocks > 0 && elem->isblock) return;
 4100:       }
 4101: 
 4102:       if (elem->isDry) return;
 4103: 
 4104:       // Wet elements.
 4105:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 4106:       // tidal potential, horizontal diffusion, and baroclinic etc
 4107:       // Remember to update both fb and F 
 4108:       // If ics=2, ghat1 are in eframe (ll)
 4109:       // cff1-3: coefficients for 2D/3D
 4110:       Vector2 gradEta = {0.0, 0.0};  // \nabla \eta
 4111:       Vector2 gradPr  = {0.0, 0.0};  // \nabla pressure
 4112:       Vector2 gradETP = {0.0, 0.0};  // \nabla etp
 4113: 
 4114:       double av_cff1 = 0.0;  // av. for cff1
 4115:       double av_cff2 = 0.0;  // av. for cff2
 4116:       double av_cff3 = 0.0;  // av. for cff3
 4117:       double av_df = 0.0;  // av. for H^\alpha / H
 4118:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 4119:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 4120: 
 4121:       const int i34 = elem->i34;
 4122:       const int kb = elem->kb;
 4123: 
 4124:       for (int j=1; j<i34; j++) {
 4125:          // For each node and side in the element...
 4126: 
 4127:          const Node *node = elem->nodes[j];
 4128:          const Side *side = elem->sides[j];
 4129: 
 4130:          const double chi      = side->chi;
 4131:          const double veg_c2   = side->veg_c2;
 4132:          const double veg_beta = side->veg_beta;
 4133:          const double veg_h    = side->veg_h();
 4134:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 4135: 
 4136:          // Node - const in elem
 4137:          gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 4138:          gradPr  += node->pr  *elem->gradPhi[j];
 4139: 
 4140:          if (elem->depth >= tip_dp) {
 4141:            gradETP += node->ETP*elem->gradPhi[j];
 4142:          }
 4143: 
 4144:          
 4145:          const double htot  = side->htot();        // Total depth at the side
 4146:          const double zctr2 = side->zTopCanopy();  
 4147: 
 4148:          double cff1; 
 4149:          double cff2; 
 4150:          double cff3;   
 4151:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 4152:          // coefficients applied to 2D/3D case 
 4153:             cff1 = side->hhat/htot;
 4154:             cff2 = 0.0;
 4155:             cff3 = 0.0;
 4156:          } else { //3D
 4157:             //Init for no-veg case
 4158:             cff1 = 1.0;
 4159:             cff2 = 1.0;
 4160:             cff3 = 0.0;
 4161: 
 4162:             if constexpr(iveg != 0) {
 4163:                // Computes coefficients used with vegetation terms G1, G2
 4164:                // cff1, cff3 are used for the first two terms in G1, G2:
 4165:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 4166:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 4167:                // In general, cff1*Ustar - cff3*Ustar_alpha
 4168:                if(veg_h < 0.99*htot) { // submergent vegetation
 4169:                   cff1=1;
 4170:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 4171:                   cff3 = veg_c;
 4172: 
 4173:                } else { // emergent vegetation
 4174:                   cff1 = 1.0/(1.0 + veg_c2);
 4175:                   cff2 = cff1;
 4176:                   cff3 = 0.0;
 4177: 
 4178:                }
 4179:             } // if iveg
 4180:          } //  2D/3D
 4181: 
 4182:          av_cff1 += cff1/i34;
 4183:          av_cff2 += cff2/i34;
 4184:          av_cff3 += cff3/i34;
 4185:          av_cff2_chi += cff2*chi/i34;
 4186:          av_cff3_chi += cff3*chi/i34;
 4187:          av_df += min(htot, veg_h)/(htot*i34);
 4188: 
 4189: 
 4190:          // btrack values: U^\star, U^{\star\alpha}
 4191:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 4192:          Vector2 Ustar       = {0.0, 0.0}; 
 4193:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 4194:          for (int k = side->kb; k < nvrt; k++) {
 4195:             if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 4196:                Ustar += side->btu[nvrt]*side->Dz(k);
 4197: 
 4198:             } else { //3D
 4199:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 4200:                Ustar += w2;
 4201: 
 4202:                if constexpr(iveg != 0) {
 4203:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 4204:                        const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k)); // For the top of the canopy, ratio of the level that is below the canopy
 4205:                        Ustar_alpha += zrat*w2; // XXXX
 4206:                    }
 4207:                }  // if iveg
 4208:             }  //2/3D
 4209:          }  //k
 4210:          
 4211: 
 4212:          // Add btrack & surface stress terms to \breve{G} first
 4213:          if constexpr(ics==1) {
 4214:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 4215:          } else {
 4216:             // XXX IMPLEMENT THIS
 4217:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 4218:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 4219:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 4220:          }  // if ics
 4221: 
 4222:          // Surface and bottom stress terms
 4223:          if constexpr(ics==1) {
 4224:             const Vector2 tau    = side->tau();
 4225:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 4226: 
 4227:             // Term for surface and bottom stress
 4228:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 4229:          } else {
 4230:             // XXX IMPLEMENT THIS
 4231:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 4232:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 4233:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 4234:             // tau_x=(vn1+tt1)/2.d0
 4235:             // tau_y=(vn2+ss1)/2.d0
 4236:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 4237:          }  // if ics
 4238: 
 4239:          
 4240: 
 4241:          // All terms in F,F^\alpha,f_b except baroclinic
 4242:          // F, f_b: all explicit terms excluding vegetation 
 4243:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 4244:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 4245:          const double coriolis = side->coriolis;
 4246:          Vector2 F  =  coriolis*side->U;  // F_x
 4247:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 4248:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 4249: 
 4250:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 4251:             
 4252:             for (int k = side->kb; k < nvrt; k++) {
 4253:                if (zctr2 > side->zc[k-1]) {
 4254:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 4255:                    const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 4256:                    Fa +=  coriolis*w2*zrat;
 4257:                } // if zctr2
 4258:             } // k
 4259:          } // iveg
 4260: 
 4261:          // Integrate horizontal viscosity force vertically
 4262:          for (int k=side->kb + 1; k<nvrt; k++) {
 4263:             const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.0; 
 4264: 
 4265:             F += levelHorVisc;
 4266: 
 4267:             // Vegetation term
 4268:             if constexpr(iveg!=0) {
 4269:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 4270:                   const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 4271:                   Fa += levelHorVisc*zrat;
 4272:                } 
 4273:             } // if iveg
 4274:          } // for k
 4275: 
 4276:          fb += side->d2uv[side->kb];
 4277: 
 4278: 
 4279:          // Add to ghat1
 4280:          if constexpr(ics==2) {
 4281:             // XXX IMPLEMENT THIS
 4282:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4283:             // bigf1=vn1; bigf2=vn2
 4284:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4285:             // botf1=vn1; botf2=vn2
 4286:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4287:             // bigfa1=vn1; bigfa2=vn2
 4288:          } // if ics
 4289: 
 4290:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 4291:       } // for j (nodes and sides)
 4292: 
 4293:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 4294:          
 4295:       // Finish off terms in F, F^\alpha and f_b
 4296:       const double grav3 = elem->mean(&Node::grav2);
 4297:       const Vector2 fb = grav3*gradETP - gradPr/rho0; //const in each elem
 4298: 
 4299: 
 4300:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 4301:       for (int j=1; j<i34; j++) { 
 4302:          // For each side in the element...
 4303:          const Side *side = elem->sides[j];
 4304:          const double chi = side->chi;
 4305: 
 4306:          const double htot = side->htot();
 4307:          const double veg_h = side->veg_h();
 4308:          const Vector2 F  = htot*fb;
 4309:          const Vector2 Fa = min(htot, veg_h)*fb;
 4310: 
 4311:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 4312:       } // for j
 4313: 
 4314:       //botf1 etc are already in elem frame
 4315:       elem->ghat1 += tmp/i34;
 4316: 
 4317:       // Baroclinic force
 4318:       if constexpr(ibc==0) {
 4319:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 4320: 
 4321:          Vector2 Fa = {0.0, 0.0};
 4322:          Vector2 intGradRho = {0.0, 0.0};
 4323:          
 4324:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 4325:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 4326:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 4327: 
 4328:             // \in F [m^2/s/s]
 4329:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 4330:          }
 4331: 
 4332:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 4333:          const Vector2 F = av_df*Fa; //approx
 4334:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 4335: 
 4336:       } // if ibc
 4337: 
 4338:    }
 4339: 
 4340: } // extern "C"
 4341: 
 4342: 
 4343: 
 4344: #ifdef DONTCOMPILE
 4345: __global__ void checkMassConservation(Tracers* sumtr) {
 4346: 
 4347:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 4348: 
 4349:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 4350: 
 4351:    Element *elem = &(mesh->localElemData[i]);
 4352: 
 4353:    // Skip dry elements
 4354:    if (elem->isDry) return;
 4355: 
 4356:    // Local sum array for this thread
 4357:    double localSum[N_TRACERS] = {0.0};
 4358: 
 4359:    // Sum over vertical levels for this element
 4360:    const int kbe = elem->kbe;
 4361:    const double area = elem->area;
 4362: 
 4363:    for (int k = kbe; k < nvrt; k++) {
 4364:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 4365:       
 4366:       // Accumulate tracer mass
 4367:       for (int tr = 0; tr < N_TRACERS; tr++) {
 4368:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 4369:       }
 4370:    }
 4371: 
 4372:    
 4373: 
 4374:    //  This function returns per element sums. A reduction must be done on the host side.
 4375: }
 4376: 
 4377: 
 4378: __global__ void transport(void) {
 4379: 
 4380:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 4381: 
 4382:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 4383: 
 4384:    Element *elem = &(mesh->localElemData[ie]);
 4385: 
 4386:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 4387: 
 4388:                for (int m=0; m<ntr; m++) {
 4389:                   for (int k=kbe(ie); k<nvrt; k++) {
 4390:                      // Calculate each polynomial's weight 
 4391:                      wm=0.d0; sum1=0.d0; 
 4392:                      wm1=0.d0; wm2=0.d0; 
 4393:                      for (int i=0; i<elem->nweno2; i++) {
 4394:                   
 4395:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4396:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4397:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4398:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4399:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4400:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 4401:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 4402:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 4403:                      // -----------------Hu and Shu (1999)'s method----------------
 4404:                      b4=b1+b2+b3
 4405: 
 4406: //Error: add PRODUCTION CPP
 4407: #ifdef DEBUG
 4408:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 4409:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 4410:                     call parallel_abort(errmsg)
 4411:                   }
 4412: #endif
 4413: 
 4414:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 4415:                   // !----test-------------- 
 4416:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 4417:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 4418:                   // !wm(i)=wm1(i)*wm2(i)
 4419:                   // !---------------------- 
 4420:                   sum1=sum1+wm(i)
 4421:                 } // end for i
 4422: 
 4423:                 wm=wm/sum1
 4424: 
 4425:                 for (int j=0; j<elem->i34; j++) {
 4426: 
 4427:                   const Side *side  = elem->sides[j];
 4428:                   const Node *node1 = side->n1;
 4429:                   const Node *node2 = side->n2;
 4430: 
 4431:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 4432:                      trsd=0.d0
 4433:                      for (int kk=0; kk<nquad; kk++) {
 4434:                         for (int i=0; i<elem->nweno2; i++) {
 4435:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4436:                         } // end for i   
 4437:                      } // end for kk
 4438:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 4439:                   } // outward flux
 4440:                } // end for j=1,i34(ie) ! side
 4441:             }
 4442:          }
 4443:               
 4444: 
 4445: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 4446: //             //   calculate each polynomial's weight 
 4447: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 4448: //                 wm=0.d0; sum1=0.d0
 4449: //                 do i=1,nweno1(ie) !for each polynomial
 4450: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4451: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4452: //                   b1=b1*b1+b2*b2 !smoothness indicator
 4453: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 4454: //                   wm(i)=b2
 4455: //                   sum1=sum1+b2
 4456: //                   !wm(i)=1.d0
 4457: //                   !sum1=sum1+1.d0
 4458: 
 4459: // // Error: PRODUCTION
 4460: // #ifdef DEBUG
 4461: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 4462: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 4463: //                     call parallel_abort(errmsg)
 4464: //                   endif
 4465: // #endif
 4466: 
 4467: //                 enddo !i
 4468: //                 wm=wm/sum1 !final weight
 4469: 
 4470:                 for (int j=0; j<elem->i34; j++) { // side
 4471:                   const Side *side = elem->sides[j];
 4472:                   const Node *node1 = side->n1;
 4473:                   const Node *node2 = side->n2;
 4474: 
 4475:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 4476:                     trsd=0.d0
 4477:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 4478:                       for (int i=0; i<elem->nweno1; i++) {
 4479:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 4480:                       }
 4481:                     enddo //kk
 4482:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 4483:                   } // outward flux
 4484:                 } // end for j=1,i34(ie) ! side
 4485:               } // end for k; ntr 
 4486: 
 4487:             else !simple upwind method
 4488:               do j=1,i34(ie)
 4489:                 jsj=elside(j,ie)
 4490:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 4491:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 4492:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 4493:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 4494:                   endif
 4495:                 enddo  !vertical layers
 4496:               enddo !j=1,i34(ie) ! side
 4497:             endif !order of accuracy
 4498: 
 4499:          //  enddo !ie
 4500: // !$OMP     end do
 4501: 
 4502: // !$OMP     master
 4503: //           !message passing
 4504: //           if (nproc>1) then
 4505: //             !make a copy of side concentrations
 4506: //             trsd_tmp0=trsd_tmp 
