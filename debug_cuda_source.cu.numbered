 1746: 
 1747: //       const Side& side = sides[i];
 1748: 
 1749: //       xIntersect=-1.e25;
 1750: //       yIntersect=-1.e25;
 1751: 
 1752: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 1753: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 1754: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 1755: 
 1756: //       if (delta != 0.0) {
 1757: //          // Solves the two linear equations for tt1 and tt2
 1758: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
