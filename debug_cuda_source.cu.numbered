 1873: __host__ __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 1874: 
 1875: __device__ double Node::compZCoord(int k) const {
 1876:    // Computes the z coordinate at level k.
 1877:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 1878:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 1879:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 1880:    // used 
 1881:    
 1882:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 1883:       
 1884:    if (idry) {
 1885:       return 0.0;
 1886:    }
 1887: 
 1888:    if constexpr(ivcor == 2) {
 1889: 
 1890:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 1891:       const int kz = mesh->kz;
 1892: 
 1893:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 1894:       // The FORTAN code computes it every time this function is called, but it should be done only 
 1895:       // once per time step/node.
 1896:       // CHECK: updateZCoordData
 1897:       if (k == kz)               return -hmod2;
 1898:       else if (k == nvrt-1)      return eta2;
 1899:       else if (k == kb)          return -depth;
 1900:       else if (k < kz && k >= 0) return mesh->ztot[k];
 1901:       else if (k > kz) {
 1902:          const int ksig = k - kz + 1;
 1903: 
 1904:          if (hmod2 <= mesh->h_c) {
 1905:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 1906:          } 
 1907:          else if (eta2 <= - mesh->h_c - (depth - mesh->h_c) * mesh->theta_f/mesh->sinh_theta_f) {
 1908:             printf("Please choose larger h_c: %f %f\n", eta2, mesh->h_c);
 1909:             Error("ZCOOR: invalid h_c\n");
 1910:          } 
 1911:          else {
 1912:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 1913:                          mesh->h_c * mesh->sigma[ksig] + 
 1914:                          (hmod2 - mesh->h_c) * mesh->cs[ksig];
 1915:          }
 1916:       } else { 
 1917:          Error("ZCOOR: invalid level or coordinate system\n");
 1918:       }
 1919: 
 1920:    }
 1921:    else if constexpr(ivcor == 1) {
 1922:       if (k == kb) return -depth;
 1923:       else if (k == nvrt-1) return eta2;
 1924:       else if (k >= kb) {
 1925:             return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 1926:       }
 1927:    }
 1928:    
 1929:    printf("ZCOOR: invalid level or coordinate system\n");
 1930:    return 0.0;
 1931: }
 1932: 
 1933: 
 1934: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 1935:                 double *node_coords, double *wind_rotate_angle, 
 1936:                 int *isdel, int *isidenode, int *isbnd,
 1937:                 int *nond, int *nlnd, int *iond, int *ilnd,
 1938:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 1939:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 1940:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 1941:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 1942:                 int *localNodePart,     int *localElemPart,     int *localSidePart) {
 1943: 
 1944:    printf("Populating mesh for partition %d, %d, %d\n", partNum, nond, nlnd);
 1945: 
 1946:    // Horizontal grid
 1947:    printf("Processing %d nodes\n", np);      
 1948:    for (int i = 0; i < np; i++)
 1949:    {
 1950:       Node &node = localNodeData[i];
 1951: 
 1952:       const int idxStart = nodeNeighNodesStart[i];
 1953:       const int idxEnd   = nodeNeighNodesStart[i+1];
 1954:       node.numNodes = idxEnd - idxStart;
 1955:       node.nodes = (Node **)(nodeNeighNodes + idxStart*sizeof(Node *));
 1956:       node.idx = i;
 1957: 
 1958:       for (int idx = idxStart; idx < idxEnd; idx++) {
 1959:          int idxNode = nodeNeighNodesIndices[idx];
 1960:          Node *node_ptr = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 1961: 
 1962:          nodeNeighNodes[idxNode] = node_ptr;
 1963:          node.nodes = &(nodeNeighNodes[idxNode]);
 1964:       }
 1965: 
 1966:       // Element **elements; // pointer to the elements connected to this node
 1967:       // int numElements;   // number of elements shared by this node
 1968: 
 1969:       node.p.x = node_coords[i * 3];
 1970:       node.p.y = node_coords[i * 3 + 1];
 1971:       node.p.z = node_coords[i * 3 + 2];  // XXX this is probably wrong
 1972:       node.depth = node_coords[i * 3 + 2];
 1973: 
 1974:       // Links the node to the boundary information
 1975:       int idxNodeBoundary = 0;
 1976:       if (isbnd[i] >= 0) {
 1977:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 1978:          if (isbnd[i]>0) {
 1979: 
 1980:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 1981:             node.nodeBnd->segment->ifltype = isbnd[i];
 1982: 
 1983:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 1984:             node.nodeBnd->segment->clen  = nan("1");
 1985:             node.nodeBnd->segment->carea = nan("1");
 1986: 
 1987:          }
 1988:          else {
 1989:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 1990:          }
 1991:          
 1992:          idxNodeBoundary++;
 1993:       }
 1994:       else {
 1995:          node.nodeBnd = nullptr;
 1996:       }
 1997: 
 1998: // XXXX
 1999: constexpr double rot_per = 3000.0;
 2000: constexpr double rot_f = 2.0*pi/rot_per;
 2001: for (int k = 0; k < nvrt; k++) {node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0};}
 2002: // XXXXX
 2003:    }
 2004: 
 2005:    printf("Processing %d sides\n", ns);
 2006:    int idxSideBoundary = 0;
 2007:    for (int i = 0; i < ns; i++)
 2008:    {
 2009:       Side &side = localSideData[i];
 2010:       side.idx = i;
 2011:       // finding the pointer to the nodes that form the side
 2012:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2013:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2014: 
 2015:       const int locidx_n1 = localNodeIndices[idx_n1];
 2016:       const int locidx_n2 = localNodeIndices[idx_n2];
 2017:       const int part_n1 =   localNodePart[idx_n1];
 2018:       const int part_n2 =   localNodePart[idx_n2];
 2019: 
 2020:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2021:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2022: 
 2023:       // Normal vector to the side
 2024:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2025:       const double norm = sqrt(dot(side.n, side.n));
 2026:       side.n = side.n/norm;
 2027: 
 2028:       // Side boundary type
 2029:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 2030:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 2031:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2032:       
 2033:       if (n1bnd != nullptr || n2bnd != nullptr) 
 2034:       {
 2035:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2036:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2037:          else                  side.sideBnd->segment = n2bnd->segment;
 2038:          side.sideBnd->side = &side;
 2039:          idxSideBoundary++;
 2040:       }
 2041:       else side.sideBnd = nullptr;
 2042: 
 2043:       // finding the pointer to the elements that share the side
 2044:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2045:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2046: 
 2047:       if (idx_e1 > -1) {
 2048:          const int locidx_e1 = localElemIndices[idx_e1];
 2049:          const int part_e1 =  localElemPart[idx_e1];
 2050:          side.elems[0] = (Element *)&(elems[part_e1][locidx_e1]);
 2051:       }
 2052:       else {
 2053:          side.elems[0] = nullptr;
 2054:       }
 2055: 
 2056:       if (idx_e2 > -1) {
 2057:          const int locidx_e2 = localElemIndices[idx_e2];
 2058:          const int part_e2 =  localElemPart[idx_e2];
 2059:          side.elems[1] = (Element *)&(elems[part_e2][locidx_e2]);
 2060:       }
 2061:       else {
 2062:          side.elems[1] = nullptr;
 2063:       }
 2064: 
 2065: 
 2066: 
 2067:       // Compute the center of the side
 2068:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2069: 
 2070: // XXXX
 2071: constexpr double rot_per=3000.0;
 2072: constexpr double rot_f=2.0*pi/rot_per;
 2073: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2074: // XXXXX      
 2075: 
 2076:       // Compute the z level at the center of the side
 2077:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->znl[k] + side.n2->znl[k]);
 2078: 
 2079:       // Compute the length of the side
 2080:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2081:       side.length = sqrt(dot(vLen, vLen));
 2082: 
 2083:    }
 2084: 
 2085:    printf("Processing %d elements\n", ne);
 2086:    for (int i = 0; i < ne; i++)
 2087:    {
 2088:       Element &elem = localElemData[i];
 2089:       elem.idx = i;
 2090:       for (int j = 0; j < i34[i]; j++) {
 2091:          const int idxNode = elnode[i*4 + j];  
 2092:          const int idxSide = elside[i*4 + j];
 2093:          
 2094:          elem.nodes[j] = (Node *)&(nodes[localElemPart[idxNode]][localElemIndices[idxNode]]);
 2095:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2096: 
 2097:          // Find the neighboring element  
 2098:          if (elem.sides[j]->elems[0] == &elem) {
 2099:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2100:          }
 2101:          else {
 2102:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2103:          }
 2104:       }
 2105: 
 2106:       
 2107: 
 2108:       elem.i34 = i34[i];
 2109:       elem.wind_angle = wind_rotate_angle[i];
 2110: 
 2111:       // Compute the centroid of the element and its depth
 2112:       Vector2 center = {0.0, 0.0};
 2113:       elem.depth = 0.0;
 2114:       for (int j = 0; j < i34[i]; j++) {
 2115:          center += elem.nodes[j]->p2()/i34[i];
 2116:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2117:       }
 2118:       elem.center.x = center.x;
 2119:       elem.center.y = center.y;
 2120:       
 2121:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2122:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2123: 
 2124:       elem.area = elem.computeSignedArea(); 
 2125:       elem.radius = sqrt(elem.area)/pi; 
 2126:       
 2127:       // Determines which way the normal vector to each side is oriented.
 2128:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2129:       for (int j = 0; j < i34[i]; j++)  
 2130:       {
 2131:          if (elem.sides[j]->elems[0] == &elem) {
 2132:             elem.ssign[j] =  1.0;
 2133:          }
 2134:          else {
 2135:             elem.ssign[j] = -1.0;
 2136:          }
 2137: 
 2138:       }
 2139: 
 2140:       // Derivatives of shape functions
 2141:       //  For ics=2, this is done inside element/ll frame XXX
 2142:       //  For quads, the derivative is evaluated at centroid
 2143:       const int i34 = elem.i34;
 2144:       for (int j = 0; j < i34; j++) {
 2145:          const double area = elem.area;
 2146:          const int id2 = elem.nxq(1 + j);
 2147:          const int id3 = elem.nxq(2 + j);
 2148:          const int id4 = elem.nxq(3 + j);
 2149:          if (elem.isTri()) {
 2150:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2151:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2152:             // da1/dx = (y1 - y2)/(2*area)
 2153:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2154:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2155:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2156:          }
 2157:          else  { // Quad; evaluate at centroid
 2158:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2159:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2160:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2161:          } // if Tri
 2162: 
 2163:       } // for j
 2164: 
 2165:    }
 2166: 
 2167: 
 2168: 
 2169:    
 2170: }
 2171: 
 2172: 
 2173: __global__ void setupCoefficientMatrixAndRHS(double time) {
 2174: // Setup coefficient matrix, sparsem, for the shallow water wave equation
 2175: // No elevation essential b.c. are imposed yet but other b.c. is imposed
 2176: // 
 2177: // This kernel is called for all nodes.
 2178: 
 2179:    int in = 1; //XXX blockIdx.x * blockDim.x + threadIdx.x;
 2180: 
 2181:    Node *node1 = &(mesh->localNodeData[in]);
 2182: 
 2183: 
 2184:    node1->clearMatrixRow();
 2185:    node1->qel = 0.0;
 2186: 
 2187:    // THIS IS FOR STRUCTURES XXX
 2188:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 2189: 
 2190: 
 2191:    for (int j=0; j<node1->numElements; j++) {
 2192:       // For each element connected to the node...
 2193: 
 2194:       Element *elem = node1->elements[j];
 2195: 
 2196: 
 2197:       // Compute the average gravity
 2198:       const double grav3 = elem->mean(&Node::grav2);
 2199: 
 2200:       // Look at the documentation for the description of the terms in the following integrals
 2201: 
 2202:       // Integral I_1 
 2203:       // \bar{\breve{H}} 
 2204:       const double hhatb = elem->mean(&Side::hhat);        
 2205: 
 2206:       assert((hhatb >= 0.0 || ihh != 1) && "Invalid hhat");
 2207: 
 2208:       const int id1 = elem->nodeLocalIdx(node1); 
 2209:       const double area = elem->area;
 2210: 
 2211:       if (elem->isTri()) {
 2212: 
 2213:          // To clarify the notation in this section: 
 2214:          //   i standtimes for the node under consideration (node1)
 2215:          //   j (node2) and k (node3) are the other nodes of the triangle.
 2216:          const int id2 = elem->nxq(1 + id1);
 2217:          const int id3 = elem->nxq(2 + id1);
 2218:          Node *node2 = elem->nodes[id2];
 2219:          Node *node3 = elem->nodes[id3];
 2220: 
 2221:          const Point2 x1 = node1->p2();
 2222:          const Point2 x2 = node2->p2();
 2223:          const Point2 x3 = node3->p2();
 2224: 
 2225:          // integral of phi_i*phi_j
 2226:          const double ipp_ii = (1.0/6.0 )*area;
 2227:          const double ipp_ij = (1.0/12.0)*area;
 2228:          const double ipp_ik = (1.0/12.0)*area;
 2229: 
 2230:          // integral of [(grad phi_i) * (grad phi_j)]
 2231:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 2232:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 2233:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 2234: 
 2235:          // Computes the different components of integral I_1 of each node with respect to node i.
 2236:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 2237:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 2238:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 2239: 
 2240:          node1->addToSparseMatrix(node1, I1_ii);
 2241:          node1->addToSparseMatrix(node2, I1_ij); 
 2242:          node1->addToSparseMatrix(node3, I1_ik);
 2243:      
 2244:       }
 2245:       else { // Quad
 2246:          // XXX IMPLEMENT THIS
 2247:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2248:       } 
 2249: 
 2250:  
 2251:       // Integral I_4
 2252:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 2253:       // Where
 2254:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 2255: 
 2256:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 2257:       // of U over the element.
 2258:       Vector2 Umean = {0.0, 0.0};
 2259:       for (int m=0; m<elem->i34; m++) {      
 2260:          const Side *side = elem->sides[m];
 2261: 
 2262:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 2263:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 2264:       }
 2265:       Umean = Umean/elem->i34;
 2266: 
 2267:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 2268: 
 2269:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 2270:       const double I_4_1 = dot(gradPhi_1, Umean);
 2271: 
 2272:       // Integral of \nabla\phi_i \cdot \pmb{E}
 2273:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 2274:      
 2275:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);
 2276:       
 2277: 
 2278:       // Additional terms 
 2279:       double vnorm = 0.0;
 2280:       if (imm == 2)  { // Pre-compute vnorm on the element
 2281:          Vector3 ubed;
 2282:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 2283: 
 2284:          Vector3 gradP(0.0, 0.0, 1.0);
 2285:          for (int m=0; m < elem->i34; m++) {
 2286:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 2287:            gradP += toVector3(gradP_2D, 0.0);
 2288:          }   
 2289:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 2290:       } // imm==2
 2291: 
 2292:       if (elem->isTri()) {
 2293:          for (int l=0; l<3; l++) {
 2294:            double fac;
 2295: 
 2296:            Node *node = elem->nodes[l];
 2297: 
 2298:            (node == node1)? fac=2.0 : fac=1.0;
 2299: 
 2300:            if (imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 2301:            else        node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 2302:            
 2303:          }
 2304: 
 2305:          if (elem->idry == 0) {
 2306:            const Vector2 gradEta = elem->nodes[0]->eta2*elem->gradPhi[0] +
 2307:                                    elem->nodes[1]->eta2*elem->gradPhi[1] +
 2308:                                    elem->nodes[2]->eta2*elem->gradPhi[2];
 2309: 
 2310:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 2311:          }
 2312: 
 2313:       } // isTri
 2314:       else { // isQuad
 2315:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2316:          // for (int l=0; l<4; l++) {
 2317:          //   const Node *node = elem->nodes[l];
 2318: 
 2319:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 2320:          //   else        tmp2 = node->bdef2 - node->bdef1;
 2321: 
 2322:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 2323:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 2324:          // }
 2325: 
 2326:       } // isQuad
 2327: 
 2328: 
 2329: 
 2330:       node1->qel += (dt/elem->i34)*elem->vsource;
 2331: 
 2332:    } // for all elements connected to the node
 2333:    
 2334: 
 2335: 
 2336:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 2337:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 2338:    NodeBoundary *nodeBnd = node1->nodeBnd;
 2339:    if (nodeBnd != nullptr)  { 
 2340:       // If it is an open boundary node...
 2341: 
 2342:       // At least one open bnd side, maybe two
 2343:       for (int l=0; l<2; l++) { 
 2344: 
 2345:          // Gets each of the sides sharing the node. 
 2346:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 2347: 
 2348:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 2349: 
 2350:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 2351: 
 2352: 
 2353:          if (sideBnd != nullptr) {
 2354:             // If the side is on a boundary...
 2355: 
 2356:             // Get the boundary segment
 2357:             const BoundarySegment *sideSegment = sideBnd->segment;
 2358:             const Side *side = sideBnd->side;
 2359: 
 2360:             // Integral I_3
 2361:             if (sideSegment->ifltype != 0) {
 2362:             // Natural or Flather b.c.
 2363: 
 2364:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 2365:                // especially for Flather b.c.
 2366:                double ri3 = 0.0;
 2367:                if (side->idry != 1) {
 2368:                   // If the side is not dry
 2369:                   
 2370:                   // Computes the side flux of (uth, vth)
 2371:                   double Vn = 0.0;
 2372:                   for (int k = side->kb; k<nvrt-1; k++) {
 2373:                      // uth, vth in lat/lon frame if ics=2
 2374:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 2375:                      const double vn1 = dot(side->uth[k  ], side->n); // outer normal
 2376:                      const double vn2 = dot(side->uth[k+1], side->n);
 2377: 
 2378:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 2379:                   }
 2380: 
 2381:                   ri3 = 0.5*side->length*Vn;
 2382:                }
 2383: 
 2384:                if (sideSegment->ifltype == -1) { // Flather 1
 2385: 
 2386:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 2387:                   assert(side->depth > 0.0 && "Negative depth at Flather boundary");
 2388: 
 2389:                   const double con0 = (1.0/6.0)*side->length*sqrt(grav*side->depth); // For coefficient matrix
 2390:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 2391:                   
 2392:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 2393:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 2394: 
 2395:                } 
 2396:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 2397:                   // Reset ri3
 2398:                   ri3 = 0.0;
 2399: 
 2400:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 2401: 
 2402:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 2403: 
 2404:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 2405:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 2406: 
 2407:                   const double con0 = (1.0/6.0)*side->length*tmp*thetai*dt;
 2408:                   node1->addToSparseMatrix(node1, con0*2.0);
 2409:                   node1->addToSparseMatrix(node2, con0);
 2410: 
 2411:                } // if Flather or Discharge
 2412: 
 2413:                node1->qel -= thetai*dt*ri3;
 2414: 
 2415:             } // I_3
 2416:           
 2417: 
 2418:             // Integral I_5
 2419:             if(side->idry != 1) {
 2420: 
 2421:                const double Unbar = dot(side->U, side->n);
 2422: 
 2423:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->length*Unbar;
 2424:                
 2425:             } // I_5
 2426: 
 2427:          } // if is boundary side
 2428: 
 2429:       } // for l
 2430: 
 2431:    } // if isbnd
 2432: 
 2433: }
 2434: 
 2435: 
 2436: 
 2437: __device__ void backtrackAllNodes(void) {
 2438: 
 2439:    // max/min # of sub-divisions
 2440:    const int ndelt_max = max(1.0, dt/dtb_min);
 2441:    const int ndelt_min = max(1.0, dt/dtb_max); 
 2442: 
 2443:    // Removed all references to swild98 XXX
 2444:    // swild98=0.d0 !init
 2445: 
 2446:    Side *side = SIDE_PTR;
 2447: 
 2448:    const int kb = side->kb;
 2449:    for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 2450: 
 2451:    if (side->idry == 1) return;
 2452: 
 2453:    // Checks that at least one element is not dry
 2454:    const Element *elem1 = side->elems[0];
 2455:    const Element *elem2 = side->elems[1];
 2456:    assert ((elem1 != nullptr && !(elem1->idry)) || (elem2 != nullptr && !(elem2->idry)) && "backtrackAllNodes: non dry side without two dry elements.");
 2457: 
 2458:    // XXXXXX
 2459:    // !swild_tmp to store global coord. of the starting side
 2460:    // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 2461:    // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 2462:    // !Use sframe2 
 2463:    // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 2464: 
 2465: 
 2466:    for (int k = kb; k < nvrt; k++) {
 2467:    //  Initialize (xt,yt,zt), nnel and vel.
 2468:    //  For ics=2, the coordinates are in local frames
 2469:    //  Caution! nnel must be initialized inside this loop as it is updated inside.
 2470: 
 2471: 
 2472:       const int iadvf = side->iadv();  // Advection flag
 2473: 
 2474:       Point3 xt;
 2475:       if constexpr(ics==1) {
 2476:          xt = side->center3D(k); 
 2477:       }
 2478:       else // lat/lon; in side lat/lon frame
 2479:       {
 2480:       // XXX IMPLEMENT THIS
 2481:    //          xt=0.d0
 2482:    //          yt=0.d0
 2483:    //          !centroid coord. for nudging
 2484:    //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 2485:    //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 2486:       }  // ics
 2487: 
 2488: 
 2489:       // Velocity at the side (in ll frame for ics, same vertical direction)
 2490:       // XXX IS THIS NECESSARY?
 2491:       Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 2492: 
 2493:       // If on land or open boundary...
 2494:       const bool ifl_bnd =  (side->sideBnd != nullptr);
 2495:       
 2496:       const double vmag = length(toVector2(u_int));
 2497: 
 2498:       if (vmag <= velmin_btrack) {
 2499:          // No activity 
 2500: 
 2501:          side->btu[k] = side->u2[k];
 2502: 
 2503: 
 2504:       } else {  // do btrack
 2505: 
 2506:          // Compute number of sub-divisions based on local gradients 
 2507:          // XXX IS THIS NECESSARY?
 2508:          double suma = 0.0;
 2509:          int icount = 0;
 2510:          for (int ii=0; ii<2; ii++) {
 2511: 
 2512:             const Element *elem = side->elems[ii];
 2513:               
 2514:             if (elem == nullptr) continue;
 2515: 
 2516:             icount++;
 2517: 
 2518:             // Not strictly along z; in ll frame for ics=2
 2519: 
 2520:             double utmp[4];
 2521:             double vtmp[4];
 2522:             for (int jj = 0; jj < elem->i34; jj++) {
 2523: 
 2524:                const Node *node = elem->nodes[jj];
 2525: 
 2526:                if constexpr(ics==1) {
 2527:                   utmp[jj] = node->u2[k].x;
 2528:                   vtmp[jj] = node->u2[k].y;  
 2529:                } else {
 2530:                   // XXX IMPLEMENT THIS
 2531:                   // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 2532:                }
 2533:             } // for jj
 2534: 
 2535:             const Vector2 grad_u = elem->grad(utmp); 
 2536:             const Vector2 grad_v = elem->grad(vtmp);
 2537: 
 2538:             suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 2539:          } // for ii
 2540: 
 2541:          assert(icount > 0 && "Impossible 77");
 2542: 
 2543:          // '4' is somewhat arbitrary
 2544:          const int ndelt = max(ndelt_min, min(ndelt_max, int(suma/icount)*4)); // >=1
 2545:          const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 2546: 
 2547: 
 2548:          // Perturb starting pt to avoid underflow 
 2549:          // XXX I don't think this is needed with the current implementation
 2550:          // eps=btrack_nudge
 2551:          // if constexpr(ics==1) {
 2552:          //    xt=(1.d0-eps)*xt+eps*xctr(nnel)
 2553:          //    yt=(1.d0-eps)*yt+eps*yctr(nnel)
 2554:          // } else { //lat/lon
 2555:          //    xt=(1.d0-eps)*xt+eps*xctr2
 2556:          //    yt=(1.d0-eps)*yt+eps*yctr2
 2557:          // } // ics
 2558: 
 2559:       
 2560:          // call btrack(l,ipsgb,ifl_bnd,j,iadvf,swild_tmp,swild10_tmp, dtbk,time_rm,time_rm2,uuint,vvint,wwint,nnel,jlev,xt,yt,zt,swild3,ltmp)
 2561: 
 2562:             
 2563:       } // if vmag (do backtrack)
 2564: 
 2565:    } // for j=jmin,nvrt-1
 2566: 
 2567: }
 2568: 
 2569: template<int nc>
 2570: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 2571: 
 2572: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 2573: //
 2574: // a,b,c,r: input vectors and are not modified by this program.
 2575: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 2576: // r is the r.h.s.
 2577: // n: actual rank of the system.
 2578: // rows in u() and r();
 2579: // u: output with nc columns (transposed to rows)
 2580: // gam: a working array.
 2581: //
 2582: // NOTES:
 2583: // This is a template function that allows for different numbers of columns in the rhs vector.
 2584: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 2585: 
 2586:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 2587:    assert(nc <= nvec   && "TRIDAG: Increase number of columns");
 2588:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 2589: 
 2590:    double bet = b[0];
 2591:    if constexpr (nc == 1) {
 2592:       u[0] = rhs[0]/bet;
 2593:    } else {
 2594:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 2595:    }
 2596: 
 2597:    for (int j = 1; j < n; j++) {
 2598:       gam[j] = c[j-1]/bet;
 2599:       bet = b[j] - a[j]*gam[j];
 2600: 
 2601:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 2602: 
 2603:       if constexpr (nc == 1) {
 2604:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 2605:       } else {
 2606:          for (int k = 0; k < nc; k++) {
 2607:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 2608:          }
 2609:       }
 2610:    }
 2611: 
 2612:    // Back-substitution
 2613:    for (int j=n-1; j>=1; j--) {
 2614:       if constexpr (nc == 1) {
 2615:          u[j] = u[j] - gam[j+1]*u[j-1];
 2616:       } else {
 2617:          for (int k = 0; k < nc; k++) {
 2618:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 2619:          }
 2620:       }
 2621:    }
 2622: }
 2623: 
 2624: 
 2625: struct CubicSpline { 
 2626:    double *x;
 2627:    double *y;
 2628:    double *yp;
 2629:    double *ypp;
 2630: };
 2631: 
 2632: // Helper function that contains the core algorithm
 2633: template<typename XAccessor, typename YAccessor>
 2634: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 2635:                                     double  yp_top, double  yp_bot, 
 2636:                                     CubicSpline &spline) {
 2637:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 2638:    // 
 2639:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 2640:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 2641:    //
 2642:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 2643:    // 
 2644:    // Inputs: 
 2645:    //            n: dimension for x etc; # of data pts (>=2);
 2646:    //            getX, getY: functions to access x,y coordinates
 2647:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 2648:    //     Output: 
 2649:    //            ypp[n]: 2nd derivatives used in interpolation.
 2650:    //             yp[n]: 1st derivatives 
 2651: 
 2652: 
 2653:    const int n = k2 - k1 + 1;
 2654:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 2655: 
 2656:    double *a = nullptr;
 2657:    double *b = nullptr;
 2658:    double *c = nullptr;
 2659:    double *gam = nullptr;
 2660:    double *rhs = nullptr;
 2661:    
 2662:    try {
 2663:        a = new double[n];   // Lower diagonal
 2664:        b = new double[n];   // Diagonal
 2665:        c = new double[n];   // Upper diagonal
 2666:        gam = new double[n]; // Gamma, used by the tridiagonal solver
 2667:        rhs = new double[n]; // Right-hand side
 2668: 
 2669:       for (int k=k1; k<=k2; k++) {
 2670:          if (k == k1) {
 2671:             // Bottom level
 2672:             assert(getX(k+1) - getX(k) != 0.0 && "CUBIC SPLINE: bottom problem");
 2673:             b[k] = (getX(k+1) - getX(k))/3.0;
 2674:             c[k] = b[k]/2.0;
 2675:             rhs[k] = (getY(k+1) - getY(k))/(getX(k+1) - getX(k)) - yp_bot;
 2676:          } else if (k == n - 1) {
 2677:             // Top level (surface)
 2678:             assert(getX(k) - getX(k-1) != 0.0 && "CUBIC SPLINE: surface problem");
 2679:             b[k] = (getX(k) - getX(k-1))/3.0;
 2680:             a[k] = b[k]/2.0;
 2681:             rhs[k] = -(getY(k) - getY(k-1))/(getX(k) - getX(k-1)) + yp_top;
 2682:          } else {
 2683:             // Intermediate levels
 2684:             assert(getX(k) - getX(k-1) != 0.0 && getX(k+1) - getX(k) != 0.0 && "CUBIC SPLINE: middle problem");
 2685:             b[k] = (getX(k+1) - getX(k-1))/3.0;
 2686:             a[k] = (getX(k  ) - getX(k-1))/6.0;
 2687:             c[k] = (getX(k+1) - getX(k  ))/6.0;
 2688:             rhs[k] = (getY(k+1) - getY(k  ))/(getX(k+1) - getX(k  )) - 
 2689:                      (getY(k  ) - getY(k-1))/(getX(k  ) - getX(k-1));
 2690:          }
 2691:       }
 2692: 
 2693:       // Solve the tridiagonal system
 2694:       tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 2695:       
 2696:       spline.yp[k1] = yp_bot;
 2697:       spline.yp[k2] = yp_top;
 2698: 
 2699:        // Compute rest of 1st derivatives using the splines
 2700:        for (int k=k1+1; k<k2; k++) {
 2701:            spline.yp[k] = (getY(k+1) - getY(k))/(getX(k+1) - getX(k)) - 
 2702:                           (getX(k+1) - getX(k))/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 2703:        }
 2704:    }
 2705:    finally {
 2706:        delete[] a;
 2707:        delete[] b;
 2708:        delete[] c;
 2709:        delete[] gam;
 2710:        delete[] rhs;
 2711:    }
 2712: }
 2713: 
 2714: // Array version
 2715: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 2716:                                 double y_top, double y_bot, 
 2717:                                 double *yp_out, double *ypp_out) {
 2718:    auto getX = [x] (int k) { return x[k]; };
 2719:    auto getY = [y] (int k) { return y[k]; };
 2720:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, yp_out, ypp_out);
 2721: }
 2722: 
 2723: // Lambda version - allows custom access patterns
 2724: template<typename XFunc, typename YFunc>
 2725: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 2726:                                        double y_top, double y_bot,
 2727:                                        double *yp_out, double *ypp_out) {
 2728:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, yp_out, ypp_out);
 2729: }
