 1686: /**
 1687:  * This method performs backtracking from the side center until a time -dt back in time 
 1688:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 1689:  * intermediate point.
 1690:  *
 1691:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 1692:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 1693:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 1694:  * remaining time.
 1695:  * 
 1696:  * NOTE: Runge-Kutta is not implemented yet. XXX
 1697:  * 
 1698:  * @param uuint, vvint, wwint: Velocities at the final point
 1699:  * @param jlev: Level at which the backtracking is performed
 1700:  * @param dt, dtbk: Tracking timesteps
 1701:  * @param sclr: Array for backtracked values
 1702:  * @return: True if the backtracking was successful, false otherwise
 1703:  */
 1704: __inline__ __device__ bool Side::btrack(
 1705:       int jlev,
 1706:       double dt,            // Tracking time
 1707:       double dtbk,          // Tracking timestep
 1708:       double* sclr,         // Array for backtracked values
 1709:       Vector3 &u_int
 1710: ) const {
 1711: 
 1712:    // Start from side center
 1713:    Point3 x0 = {center.x, center.y, zc[jlev]};
 1714:  
 1715: 
 1716:    double time_rm = dt; // Remaining time
 1717: 
 1718: 
 1719:    // // Initialize outputs
 1720:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 1721:    //    sclr[i] = 0.0;
 1722:    // }
 1723: 
 1724: 
 1725:    // Initial velocities
 1726:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 1727: 
 1728:    // Find the element that is in the direction opposite to the velocity
 1729:    Element* curElem = findElementTowards({u_int.x, u_int.y});
 1730: 
 1731: printf("$$$  %d, %d, %.5f, %.5f\n",  curElem->idx,idx, x0.x, x0.y)   ;
 1732:    const int MAX_ITERATIONS = 100000; // XXX 1000
 1733:    Element* nextElem = curElem;
 1734:    int iter = 0;
 1735:    while(true) {
 1736:       // Calculate timestep
 1737:       double dtb = min(dtbk, time_rm);
 1738: 
 1739:       // Next point in the backtracking curve
 1740:       Point3 xt = x0 - dtb*u_int;
 1741: 
 1742:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb);
 1743:       assert(found && "Backtracking failed in btrack");
 1744: // printf("<>T = %f, %f %f %f\n", time_rm - dtb, xt, yt, zt);
 1745:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 1746:                       // then time_rm needs to be increased by the unused time.
 1747: 
 1748: 
 1749:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 1750: 
 1751:       // The current point becomes the next segment's starting point.
 1752:       x0 = xt;
 1753:  
 1754:       curElem = nextElem;
 1755: 
 1756:       iter++;
 1757:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 1758:    }
 1759: 
 1760: 
 1761: }
 1762: 
 1763: 
