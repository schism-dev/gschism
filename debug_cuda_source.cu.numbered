 1229: // Helper functions for computing the local node index at a given offset from another.
 1230: __device__ __inline__ int nxq(int offset, int index, int size) {
 1231:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1232:    // to the index to make it positive
 1233:    assert(index + offset + 16*size >= 0);
 1234:    return (index + offset + 16*size) % size;  
 1235: }
 1236: 
 1237: __device__ __inline__ int nxq(int index, int size) {
 1238:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1239:    // to the index to make it positive
 1240:    assert(index + 16*size >= 0);
 1241:    return (index + 16*size) % size; 
 1242: }
