 1951: 
 1952: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 1953:                 double *node_coords, double *wind_rotate_angle, 
 1954:                 int *isdel, int *isidenode, int *isbnd,
 1955:                 int *nond, int *nlnd, int *iond, int *ilnd,
 1956:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 1957:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 1958:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 1959:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 1960:                 int *localNodePart,     int *localElemPart,     int *localSidePart) {
 1961: 
 1962:    printf("Populating mesh for partition %d, %d, %d\n", partNum, nond, nlnd);
 1963: 
 1964:    // Horizontal grid
 1965:    printf("Processing %d nodes\n", np);      
 1966:    for (int i = 0; i < np; i++)
 1967:    {
 1968:       Node &node = localNodeData[i];
 1969: 
 1970:       const int idxStart = nodeNeighNodesStart[i];
 1971:       const int idxEnd   = nodeNeighNodesStart[i+1];
 1972:       node.numNodes = idxEnd - idxStart;
 1973:       node.nodes = (Node **)(nodeNeighNodes + idxStart*sizeof(Node *));
 1974:       node.idx = i;
 1975: 
 1976:       for (int idx = idxStart; idx < idxEnd; idx++) {
 1977:          int idxNode = nodeNeighNodesIndices[idx];
 1978:          Node *node_ptr = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 1979: 
 1980:          nodeNeighNodes[idxNode] = node_ptr;
 1981:          node.nodes = &(nodeNeighNodes[idxNode]);
 1982:       }
 1983: 
 1984:       // Element **elements; // pointer to the elements connected to this node
 1985:       // int numElements;   // number of elements shared by this node
 1986: 
 1987:       node.p.x = node_coords[i * 3];
 1988:       node.p.y = node_coords[i * 3 + 1];
 1989:       node.p.z = node_coords[i * 3 + 2];  // XXX this is probably wrong
 1990:       node.depth = node_coords[i * 3 + 2];
 1991: 
 1992:       // Links the node to the boundary information
 1993:       int idxNodeBoundary = 0;
 1994:       if (isbnd[i] >= 0) {
 1995:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 1996:          if (isbnd[i]>0) {
 1997: 
 1998:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 1999:             node.nodeBnd->segment->ifltype = isbnd[i];
 2000: 
 2001:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2002:             node.nodeBnd->segment->clen  = nan("1");
 2003:             node.nodeBnd->segment->carea = nan("1");
 2004: 
 2005:          }
 2006:          else {
 2007:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2008:          }
 2009:          
 2010:          idxNodeBoundary++;
 2011:       }
 2012:       else {
 2013:          node.nodeBnd = nullptr;
 2014:       }
 2015: 
 2016: // XXXX
 2017: constexpr double rot_per = 3000.0;
 2018: constexpr double rot_f = 2.0*pi/rot_per;
 2019: for (int k = 0; k < nvrt; k++) {node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0};}
 2020: // XXXXX
 2021:    }
 2022: 
 2023:    printf("Processing %d sides\n", ns);
 2024:    int idxSideBoundary = 0;
 2025:    for (int i = 0; i < ns; i++)
 2026:    {
 2027:       Side &side = localSideData[i];
 2028:       side.idx = i;
 2029:       // finding the pointer to the nodes that form the side
 2030:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2031:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2032: 
 2033:       const int locidx_n1 = localNodeIndices[idx_n1];
 2034:       const int locidx_n2 = localNodeIndices[idx_n2];
 2035:       const int part_n1 =   localNodePart[idx_n1];
 2036:       const int part_n2 =   localNodePart[idx_n2];
 2037: 
 2038:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2039:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2040: 
 2041:       // Normal vector to the side
 2042:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2043:       const double norm = sqrt(dot(side.n, side.n));
 2044:       side.n = side.n/norm;
 2045: 
 2046:       // Side boundary type
 2047:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 2048:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 2049:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2050:       
 2051:       if (n1bnd != nullptr || n2bnd != nullptr) 
 2052:       {
 2053:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2054:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2055:          else                  side.sideBnd->segment = n2bnd->segment;
 2056:          side.sideBnd->side = &side;
 2057:          idxSideBoundary++;
 2058:       }
 2059:       else side.sideBnd = nullptr;
 2060: 
 2061:       // finding the pointer to the elements that share the side
 2062:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2063:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2064: 
 2065:       if (idx_e1 > -1) {
 2066:          const int locidx_e1 = localElemIndices[idx_e1];
 2067:          const int part_e1 =  localElemPart[idx_e1];
 2068:          side.elems[0] = (Element *)&(elems[part_e1][locidx_e1]);
 2069:       }
 2070:       else {
 2071:          side.elems[0] = nullptr;
 2072:       }
 2073: 
 2074:       if (idx_e2 > -1) {
 2075:          const int locidx_e2 = localElemIndices[idx_e2];
 2076:          const int part_e2 =  localElemPart[idx_e2];
 2077:          side.elems[1] = (Element *)&(elems[part_e2][locidx_e2]);
 2078:       }
 2079:       else {
 2080:          side.elems[1] = nullptr;
 2081:       }
 2082: 
 2083: 
 2084: 
 2085:       // Compute the center of the side
 2086:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2087: 
 2088: // XXXX
 2089: constexpr double rot_per=3000.0;
 2090: constexpr double rot_f=2.0*pi/rot_per;
 2091: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2092: // XXXXX      
 2093: 
 2094:       // Compute the z level at the center of the side
 2095:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->znl[k] + side.n2->znl[k]);
 2096: 
 2097:       // Compute the length of the side
 2098:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2099:       side.length = sqrt(dot(vLen, vLen));
 2100: 
 2101:    }
 2102: 
 2103:    printf("Processing %d elements\n", ne);
 2104:    for (int i = 0; i < ne; i++)
 2105:    {
 2106:       Element &elem = localElemData[i];
 2107:       elem.idx = i;
 2108:       for (int j = 0; j < i34[i]; j++) {
 2109:          const int idxNode = elnode[i*4 + j];  
 2110:          const int idxSide = elside[i*4 + j];
 2111:          
 2112:          elem.nodes[j] = (Node *)&(nodes[localElemPart[idxNode]][localElemIndices[idxNode]]);
 2113:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2114: 
 2115:          // Find the neighboring element  
 2116:          if (elem.sides[j]->elems[0] == &elem) {
 2117:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2118:          }
 2119:          else {
 2120:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2121:          }
 2122:       }
 2123: 
 2124:       
 2125: 
 2126:       elem.i34 = i34[i];
 2127:       elem.wind_angle = wind_rotate_angle[i];
 2128: 
 2129:       // Compute the centroid of the element and its depth
 2130:       Vector2 center = {0.0, 0.0};
 2131:       elem.depth = 0.0;
 2132:       for (int j = 0; j < i34[i]; j++) {
 2133:          center += elem.nodes[j]->p2()/i34[i];
 2134:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2135:       }
 2136:       elem.center.x = center.x;
 2137:       elem.center.y = center.y;
 2138:       
 2139:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2140:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2141: 
 2142:       elem.area = elem.computeSignedArea(); 
 2143:       elem.radius = sqrt(elem.area)/pi; 
 2144:       
 2145:       // Determines which way the normal vector to each side is oriented.
 2146:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2147:       for (int j = 0; j < i34[i]; j++)  
 2148:       {
 2149:          if (elem.sides[j]->elems[0] == &elem) {
 2150:             elem.ssign[j] =  1.0;
 2151:          }
 2152:          else {
 2153:             elem.ssign[j] = -1.0;
 2154:          }
 2155: 
 2156:       }
 2157: 
 2158:       // Derivatives of shape functions
 2159:       //  For ics=2, this is done inside element/ll frame XXX
 2160:       //  For quads, the derivative is evaluated at centroid
 2161:       const int i34 = elem.i34;
 2162:       for (int j = 0; j < i34; j++) {
 2163:          const double area = elem.area;
 2164:          const int id2 = elem.nxq(1 + j);
 2165:          const int id3 = elem.nxq(2 + j);
 2166:          const int id4 = elem.nxq(3 + j);
 2167:          if (elem.isTri()) {
 2168:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2169:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2170:             // da1/dx = (y1 - y2)/(2*area)
 2171:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2172:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2173:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2174:          }
 2175:          else  { // Quad; evaluate at centroid
 2176:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2177:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2178:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2179:          } // if Tri
 2180: 
 2181:       } // for j
 2182: 
 2183:    }
 2184: 
 2185: 
 2186: 
 2187:    
 2188: }
 2189: 
 2190: 
 2191: __global__ void setupCoefficientMatrixAndRHS(double time) {
 2192: // Setup coefficient matrix, sparsem, for the shallow water wave equation
 2193: // No elevation essential b.c. are imposed yet but other b.c. is imposed
 2194: // 
 2195: // This kernel is called for all nodes.
 2196: 
 2197:    int in = 1; //XXX blockIdx.x * blockDim.x + threadIdx.x;
 2198: 
 2199:    Node *node1 = &(mesh->localNodeData[in]);
 2200: 
 2201: 
 2202:    node1->clearMatrixRow();
 2203:    node1->qel = 0.0;
 2204: 
 2205:    // THIS IS FOR STRUCTURES XXX
 2206:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 2207: 
 2208: 
 2209:    for (int j=0; j<node1->numElements; j++) {
 2210:       // For each element connected to the node...
 2211: 
 2212:       Element *elem = node1->elements[j];
 2213: 
 2214: 
 2215:       // Compute the average gravity
 2216:       const double grav3 = elem->mean(&Node::grav2);
 2217: 
 2218:       // Look at the documentation for the description of the terms in the following integrals
 2219: 
 2220:       // Integral I_1 
 2221:       // \bar{\breve{H}} 
 2222:       const double hhatb = elem->mean(&Side::hhat);        
 2223: 
 2224:       assert((hhatb >= 0.0 || ihh != 1) && "Invalid hhat");
 2225: 
 2226:       const int id1 = elem->nodeLocalIdx(node1); 
 2227:       const double area = elem->area;
 2228: 
 2229:       if (elem->isTri()) {
 2230: 
 2231:          // To clarify the notation in this section: 
 2232:          //   i standtimes for the node under consideration (node1)
 2233:          //   j (node2) and k (node3) are the other nodes of the triangle.
 2234:          const int id2 = elem->nxq(1 + id1);
 2235:          const int id3 = elem->nxq(2 + id1);
 2236:          Node *node2 = elem->nodes[id2];
 2237:          Node *node3 = elem->nodes[id3];
 2238: 
 2239:          const Point2 x1 = node1->p2();
 2240:          const Point2 x2 = node2->p2();
 2241:          const Point2 x3 = node3->p2();
 2242: 
 2243:          // integral of phi_i*phi_j
 2244:          const double ipp_ii = (1.0/6.0 )*area;
 2245:          const double ipp_ij = (1.0/12.0)*area;
 2246:          const double ipp_ik = (1.0/12.0)*area;
 2247: 
 2248:          // integral of [(grad phi_i) * (grad phi_j)]
 2249:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 2250:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 2251:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 2252: 
 2253:          // Computes the different components of integral I_1 of each node with respect to node i.
 2254:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 2255:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 2256:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 2257: 
 2258:          node1->addToSparseMatrix(node1, I1_ii);
 2259:          node1->addToSparseMatrix(node2, I1_ij); 
 2260:          node1->addToSparseMatrix(node3, I1_ik);
 2261:      
 2262:       }
 2263:       else { // Quad
 2264:          // XXX IMPLEMENT THIS
 2265:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2266:       } 
 2267: 
 2268:  
 2269:       // Integral I_4
 2270:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 2271:       // Where
 2272:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 2273: 
 2274:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 2275:       // of U over the element.
 2276:       Vector2 Umean = {0.0, 0.0};
 2277:       for (int m=0; m<elem->i34; m++) {      
 2278:          const Side *side = elem->sides[m];
 2279: 
 2280:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 2281:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 2282:       }
 2283:       Umean = Umean/elem->i34;
 2284: 
 2285:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 2286: 
 2287:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 2288:       const double I_4_1 = dot(gradPhi_1, Umean);
 2289: 
 2290:       // Integral of \nabla\phi_i \cdot \pmb{E}
 2291:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 2292:      
 2293:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);
 2294:       
 2295: 
 2296:       // Additional terms 
 2297:       double vnorm = 0.0;
 2298:       if (imm == 2)  { // Pre-compute vnorm on the element
 2299:          Vector3 ubed;
 2300:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 2301: 
 2302:          Vector3 gradP(0.0, 0.0, 1.0);
 2303:          for (int m=0; m < elem->i34; m++) {
 2304:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 2305:            gradP += toVector3(gradP_2D, 0.0);
 2306:          }   
 2307:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 2308:       } // imm==2
 2309: 
 2310:       if (elem->isTri()) {
 2311:          for (int l=0; l<3; l++) {
 2312:            double fac;
 2313: 
 2314:            Node *node = elem->nodes[l];
 2315: 
 2316:            (node == node1)? fac=2.0 : fac=1.0;
 2317: 
 2318:            if (imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 2319:            else        node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 2320:            
 2321:          }
 2322: 
 2323:          if (elem->idry == 0) {
 2324:            const Vector2 gradEta = elem->nodes[0]->eta2*elem->gradPhi[0] +
 2325:                                    elem->nodes[1]->eta2*elem->gradPhi[1] +
 2326:                                    elem->nodes[2]->eta2*elem->gradPhi[2];
 2327: 
 2328:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 2329:          }
 2330: 
 2331:       } // isTri
 2332:       else { // isQuad
 2333:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2334:          // for (int l=0; l<4; l++) {
 2335:          //   const Node *node = elem->nodes[l];
 2336: 
 2337:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 2338:          //   else        tmp2 = node->bdef2 - node->bdef1;
 2339: 
 2340:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 2341:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 2342:          // }
 2343: 
 2344:       } // isQuad
 2345: 
 2346: 
 2347: 
 2348:       node1->qel += (dt/elem->i34)*elem->vsource;
 2349: 
 2350:    } // for all elements connected to the node
 2351:    
 2352: 
 2353: 
 2354:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 2355:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 2356:    NodeBoundary *nodeBnd = node1->nodeBnd;
 2357:    if (nodeBnd != nullptr)  { 
 2358:       // If it is an open boundary node...
 2359: 
 2360:       // At least one open bnd side, maybe two
 2361:       for (int l=0; l<2; l++) { 
 2362: 
 2363:          // Gets each of the sides sharing the node. 
 2364:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 2365: 
 2366:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 2367: 
 2368:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 2369: 
 2370: 
 2371:          if (sideBnd != nullptr) {
 2372:             // If the side is on a boundary...
 2373: 
 2374:             // Get the boundary segment
 2375:             const BoundarySegment *sideSegment = sideBnd->segment;
 2376:             const Side *side = sideBnd->side;
 2377: 
 2378:             // Integral I_3
 2379:             if (sideSegment->ifltype != 0) {
 2380:             // Natural or Flather b.c.
 2381: 
 2382:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 2383:                // especially for Flather b.c.
 2384:                double ri3 = 0.0;
 2385:                if (side->idry != 1) {
 2386:                   // If the side is not dry
 2387:                   
 2388:                   // Computes the side flux of (uth, vth)
 2389:                   double Vn = 0.0;
 2390:                   for (int k = side->kb; k<nvrt-1; k++) {
 2391:                      // uth, vth in lat/lon frame if ics=2
 2392:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 2393:                      const double vn1 = dot(side->uth[k  ], side->n); // outer normal
 2394:                      const double vn2 = dot(side->uth[k+1], side->n);
 2395: 
 2396:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 2397:                   }
 2398: 
 2399:                   ri3 = 0.5*side->length*Vn;
 2400:                }
 2401: 
 2402:                if (sideSegment->ifltype == -1) { // Flather 1
 2403: 
 2404:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 2405:                   assert(side->depth > 0.0 && "Negative depth at Flather boundary");
 2406: 
 2407:                   const double con0 = (1.0/6.0)*side->length*sqrt(grav*side->depth); // For coefficient matrix
 2408:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 2409:                   
 2410:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 2411:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 2412: 
 2413:                } 
 2414:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 2415:                   // Reset ri3
 2416:                   ri3 = 0.0;
 2417: 
 2418:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 2419: 
 2420:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 2421: 
 2422:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 2423:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 2424: 
 2425:                   const double con0 = (1.0/6.0)*side->length*tmp*thetai*dt;
 2426:                   node1->addToSparseMatrix(node1, con0*2.0);
 2427:                   node1->addToSparseMatrix(node2, con0);
 2428: 
 2429:                } // if Flather or Discharge
 2430: 
 2431:                node1->qel -= thetai*dt*ri3;
 2432: 
 2433:             } // I_3
 2434:           
 2435: 
 2436:             // Integral I_5
 2437:             if(side->idry != 1) {
 2438: 
 2439:                const double Unbar = dot(side->U, side->n);
 2440: 
 2441:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->length*Unbar;
 2442:                
 2443:             } // I_5
 2444: 
 2445:          } // if is boundary side
 2446: 
 2447:       } // for l
 2448: 
 2449:    } // if isbnd
 2450: 
 2451: }
 2452: 
 2453: 
 2454: 
 2455: __device__ void backtrackAllNodes(void) {
 2456: 
 2457:    // max/min # of sub-divisions
 2458:    const int ndelt_max = max(1.0, dt/dtb_min);
 2459:    const int ndelt_min = max(1.0, dt/dtb_max); 
 2460: 
 2461:    // Removed all references to swild98 XXX
 2462:    // swild98=0.d0 !init
 2463: 
 2464:    Side *side = SIDE_PTR;
 2465: 
 2466:    const int kb = side->kb;
 2467:    for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 2468: 
 2469:    if (side->idry == 1) return;
 2470: 
 2471:    // Checks that at least one element is not dry
 2472:    const Element *elem1 = side->elems[0];
 2473:    const Element *elem2 = side->elems[1];
 2474:    assert ((elem1 != nullptr && !(elem1->idry)) || (elem2 != nullptr && !(elem2->idry)) && "backtrackAllNodes: non dry side without two dry elements.");
 2475: 
 2476:    // XXXXXX
 2477:    // !swild_tmp to store global coord. of the starting side
 2478:    // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 2479:    // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 2480:    // !Use sframe2 
 2481:    // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 2482: 
 2483: 
 2484:    for (int k = kb; k < nvrt; k++) {
 2485:    //  Initialize (xt,yt,zt), nnel and vel.
 2486:    //  For ics=2, the coordinates are in local frames
 2487:    //  Caution! nnel must be initialized inside this loop as it is updated inside.
 2488: 
 2489: 
 2490:       const int iadvf = side->iadv();  // Advection flag
 2491: 
 2492:       Point3 xt;
 2493:       if constexpr(ics==1) {
 2494:          xt = side->center3D(k); 
 2495:       }
 2496:       else // lat/lon; in side lat/lon frame
 2497:       {
 2498:       // XXX IMPLEMENT THIS
 2499:    //          xt=0.d0
 2500:    //          yt=0.d0
 2501:    //          !centroid coord. for nudging
 2502:    //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 2503:    //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 2504:       }  // ics
 2505: 
 2506: 
 2507:       // Velocity at the side (in ll frame for ics, same vertical direction)
 2508:       // XXX IS THIS NECESSARY?
 2509:       Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 2510: 
 2511:       // If on land or open boundary...
 2512:       const bool ifl_bnd =  (side->sideBnd != nullptr);
 2513:       
 2514:       const double vmag = length(toVector2(u_int));
 2515: 
 2516:       if (vmag <= velmin_btrack) {
 2517:          // No activity 
 2518: 
 2519:          side->btu[k] = side->u2[k];
 2520: 
 2521: 
 2522:       } else {  // do btrack
 2523: 
 2524:          // Compute number of sub-divisions based on local gradients 
 2525:          // XXX IS THIS NECESSARY?
 2526:          double suma = 0.0;
 2527:          int icount = 0;
 2528:          for (int ii=0; ii<2; ii++) {
 2529: 
 2530:             const Element *elem = side->elems[ii];
 2531:               
 2532:             if (elem == nullptr) continue;
 2533: 
 2534:             icount++;
 2535: 
 2536:             // Not strictly along z; in ll frame for ics=2
 2537: 
 2538:             double utmp[4];
 2539:             double vtmp[4];
 2540:             for (int jj = 0; jj < elem->i34; jj++) {
 2541: 
 2542:                const Node *node = elem->nodes[jj];
 2543: 
 2544:                if constexpr(ics==1) {
 2545:                   utmp[jj] = node->u2[k].x;
 2546:                   vtmp[jj] = node->u2[k].y;  
 2547:                } else {
 2548:                   // XXX IMPLEMENT THIS
 2549:                   // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 2550:                }
 2551:             } // for jj
 2552: 
 2553:             const Vector2 grad_u = elem->grad(utmp); 
 2554:             const Vector2 grad_v = elem->grad(vtmp);
 2555: 
 2556:             suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 2557:          } // for ii
 2558: 
 2559:          assert(icount > 0 && "Impossible 77");
 2560: 
 2561:          // '4' is somewhat arbitrary
 2562:          const int ndelt = max(ndelt_min, min(ndelt_max, int(suma/icount)*4)); // >=1
 2563:          const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 2564: 
 2565: 
 2566:          // Perturb starting pt to avoid underflow 
 2567:          // XXX I don't think this is needed with the current implementation
 2568:          // eps=btrack_nudge
 2569:          // if constexpr(ics==1) {
 2570:          //    xt=(1.d0-eps)*xt+eps*xctr(nnel)
 2571:          //    yt=(1.d0-eps)*yt+eps*yctr(nnel)
 2572:          // } else { //lat/lon
 2573:          //    xt=(1.d0-eps)*xt+eps*xctr2
 2574:          //    yt=(1.d0-eps)*yt+eps*yctr2
 2575:          // } // ics
 2576: 
 2577:       
 2578:          // call btrack(l,ipsgb,ifl_bnd,j,iadvf,swild_tmp,swild10_tmp, dtbk,time_rm,time_rm2,uuint,vvint,wwint,nnel,jlev,xt,yt,zt,swild3,ltmp)
 2579: 
 2580:             
 2581:       } // if vmag (do backtrack)
 2582: 
 2583:    } // for j=jmin,nvrt-1
 2584: 
 2585: }
 2586: 
 2587: template<int nc>
 2588: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 2589: 
 2590: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 2591: //
 2592: // a,b,c,r: input vectors and are not modified by this program.
 2593: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 2594: // r is the r.h.s.
 2595: // n: actual rank of the system.
 2596: // rows in u() and r();
 2597: // u: output with nc columns (transposed to rows)
 2598: // gam: a working array.
 2599: //
 2600: // NOTES:
 2601: // This is a template function that allows for different numbers of columns in the rhs vector.
 2602: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 2603: 
 2604:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 2605:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 2606: 
 2607:    double bet = b[0];
 2608:    if constexpr (nc == 1) {
 2609:       u[0] = rhs[0]/bet;
 2610:    } else {
 2611:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 2612:    }
 2613: 
 2614:    for (int j = 1; j < n; j++) {
 2615:       gam[j] = c[j-1]/bet;
 2616:       bet = b[j] - a[j]*gam[j];
 2617: 
 2618:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 2619: 
 2620:       if constexpr (nc == 1) {
 2621:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 2622:       } else {
 2623:          for (int k = 0; k < nc; k++) {
 2624:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 2625:          }
 2626:       }
 2627:    }
 2628: 
 2629:    // Back-substitution
 2630:    for (int j=n-1; j>=1; j--) {
 2631:       if constexpr (nc == 1) {
 2632:          u[j] = u[j] - gam[j+1]*u[j-1];
 2633:       } else {
 2634:          for (int k = 0; k < nc; k++) {
 2635:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 2636:          }
 2637:       }
 2638:    }
 2639: }
 2640: 
 2641: 
 2642: 
 2643: 
 2644: // Helper function that contains the core algorithm
 2645: template<typename XAccessor, typename YAccessor>
 2646: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 2647:                                     double  yp_top, double  yp_bot, 
 2648:                                     CubicSpline &spline) {
 2649:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 2650:    // 
 2651:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 2652:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 2653:    //
 2654:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 2655:    // 
 2656:    // Inputs: 
 2657:    //            n: dimension for x etc; # of data pts (>=2);
 2658:    //            getX, getY: functions to access x,y coordinates
 2659:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 2660:    //     Output: 
 2661:    //            spline (CubicSpline): spline structure with x,y,y',y''
 2662: 
 2663:    const int n = k2 - k1 + 1;
 2664:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 2665: 
 2666:    // Allocate memory for the splines
 2667:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 2668:    spline.x   = new double[n];
 2669:    spline.y   = new double[n];
 2670:    spline.yp  = new double[n];
 2671:    spline.ypp = new double[n];
 2672: 
 2673:    for (int k=k1; k<=k2; k++) {
 2674:       spline.x[k] = getX(k);
 2675:       spline.y[k] = getY(k);
 2676:    }
 2677: 
 2678:    // This is to simplify expressions later
 2679:    double *x = spline.x;
 2680:    double *y = spline.y;
 2681: 
 2682:    double *a = nullptr;
 2683:    double *b = nullptr;
 2684:    double *c = nullptr;
 2685:    double *gam = nullptr;
 2686:    double *rhs = nullptr;
 2687:    
 2688: 
 2689:       a = new double[n];   // Lower diagonal
 2690:       b = new double[n];   // Diagonal
 2691:       c = new double[n];   // Upper diagonal
 2692:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 2693:       rhs = new double[n]; // Right-hand side
 2694: 
 2695:    for (int k=k1; k<=k2; k++) {
 2696:       if (k == k1) {
 2697:          // Bottom level
 2698:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 2699:          b[k] = (x[k+1] - x[k])/3.0;
 2700:          c[k] = b[k]/2.0;
 2701:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 2702:       } else if (k == n - 1) {
 2703:          // Top level (surface)
 2704:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 2705:          b[k] = (x[k] - x[k-1])/3.0;
 2706:          a[k] = b[k]/2.0;
 2707:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 2708:       } else {
 2709:          // Intermediate levels
 2710:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 2711:          b[k] = (x[k+1] - x[k-1])/3.0;
 2712:          a[k] = (x[k  ] - x[k-1])/6.0;
 2713:          c[k] = (x[k+1] - x[k  ])/6.0;
 2714:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 2715:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 2716:       }
 2717:    }
 2718: 
 2719:    // Solve the tridiagonal system
 2720:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 2721:    
 2722:    spline.yp[k1] = yp_bot;
 2723:    spline.yp[k2] = yp_top;
 2724: 
 2725:    // Compute rest of 1st derivatives using the splines
 2726:    for (int k=k1+1; k<k2; k++) {
 2727:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 2728:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 2729:    }
 2730:    
 2731:    delete[] a;
 2732:    delete[] b;
 2733:    delete[] c;
 2734:    delete[] gam;
 2735:    delete[] rhs;
 2736: 
 2737: }
 2738: 
 2739: // Array version
 2740: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 2741:                                 double y_top, double y_bot, 
 2742:                                 CubicSpline &spline) {
 2743:    auto getX = [x] (int k) { return x[k]; };
 2744:    auto getY = [y] (int k) { return y[k]; };
 2745:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 2746: }
 2747: 
 2748: // Lambda version - allows custom access patterns
 2749: template<typename XFunc, typename YFunc>
 2750: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 2751:                                 double y_top, double y_bot,
 2752:                                 CubicSpline &spline) {
 2753:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 2754: }
