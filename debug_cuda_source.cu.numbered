  729:    double rough;    // Bottom roughness length
  730:    Vector2 tau_bot; // Bottom stress vector
  731: 
  732:    double bdef1; // Bottom deformation at previous timestep
  733:    double bdef2; // Bottom deformation at current timestep
  734: 
  735:    double qel; // RHS
