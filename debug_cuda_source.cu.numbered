  923: class Mesh {
  924:    public:  
  925: 
  926:    int partNum; // Partition number for this mesh.
  927: 
  928:    // Pointers to each GPU's local memory (size is the number of partitions).
  929:    const Node**    nodes;  
  930:    const Element** elems;  
  931:    const Side**    sides;  
  932:    
  933:    // Local memory
  934:    Node*    localNodeData; 
  935:    Element* localElemData;
  936:    Side*    localSideData; 
  937: 
  938:    NodeBoundary *localNodeBoundaryMem; // Array of objects with the boundary information of each node
  939:    SideBoundary *localSideBoundaryMem; // Array of objects with the boundary information of each side
  940:    BoundarySegment *localSegmentMem;   // Array of objects with the boundary segments
  941:    
  942:    const int npgb;  // Global number of horizontal nodes
  943:    const int negb;  // Global number of elements
  944:    const int nsgb;  // Global number of sides
  945: 
  946:    const int np;   // Local number of horizontal nodes 
  947:    const int ne;   // Local number of elements
  948:    const int ns;   // Local number of sides
  949: 
  950:    int nbp;  // Local number of boundary nodes
  951: 
  952:    const int max_np; // Maximum number of horizontal nodes per partition (shared by all partitions)
  953:    const int max_ne; // Maximum number of elements per partition (shared by all partitions)
  954:    const int max_ns; // Maximum number of sides per partition (shared by all partitions)
  955: 
  956:   
  957:    // Additional topology information
  958:    Node    **nodeNeighNodes; // Array of pointers to the nodes neighbors of each node
  959:    Element **nodeNeighElems; // Array of pointers to the elements neighbors of each node
  960: 
  961: 
  962: 
  963:    // Vertical coordinate system
  964:    // Sigma levels
  965:    double h_s; 
  966:    double h_c; 
  967:    int    kz;
  968:    double theta_b;
  969:    double theta_f, sinh_theta_f;
  970:    double *sigma_lcl;
  971:    double *sigma;
  972:    double *ztot;
  973:    double *cs;
  974:    double *dcs;
  975: 
  976:    // // Get's the pointer to the node using the array of global pointers to nodes
  977:    // __device__ const Node *getGlobalNode(int jn) {
