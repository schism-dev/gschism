 3060:    __global__ void scaleGravity(double loadtide_coef) {
 3061: 
 3062: 
 3063:       NODE(node);
 3064: 
 3065:       // SAL option: scale gravity
 3066:       if constexpr(iloadtide==2) {  // simple const
 3067:          node->grav2 = grav*(1.0 - loadtide_coef);
 3068: 
 3069:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3070:         
 3071:           const double depth = max(node->depth, 0.0);
 3072:           const double tmp1 = sqrt(depth);
 3073:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3074:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3075:                              2.6969e-13*depth*depth*depth*tmp1;
 3076:           
 3077:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3078:           
 3079: 
 3080: 
 3081:           node->grav2 = grav*(1.0 - beta_bar);
 3082: 
 3083:       } else {  // iloadtide=0,1
 3084:         node->grav2=grav;
 3085: 
 3086:       }
 3087: 
 3088:       printf("scaleGravity: node(%d)->grav2 = %f\n", node->idx, node->grav2);
 3089:    }
 3090: 
