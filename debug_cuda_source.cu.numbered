 4886: __global__ void printMatrix(void) {
 4887: 
 4888: 
 4889:    // Let only one thread per block print at a time 
 4890: 
 4891:    if (threadIdx.x == 0) {
 4892:       for (int ithread = 0; ithread < blockDim.x; ithread++) {
 4893:          const int idx_node = ithread + blockIdx.x * blockDim.x;
 4894:          if (idx_node >= mesh->np) return;
 4895:          const Node *node = mesh->localNodeData + idx_node;
 4896:          printf("idx_node = %d [%d] diag=%lf14, [", idx_node, node->numNodes, node->coeffDiag);
 4897:          for (int j = 0; j < node->numNodes; j++) {
 4898:             Node* nbNode = node->nodes[j];
 4899:             if (node->coeffMatrix[j] != 0.0) printf("%d:%f14,  ", nbNode->idx, node->coeffMatrix[j]);
 4900:          }
 4901:          printf("]\n");
 4902: 
 4903:       }
 4904:    }
 4905: 
 4906: 
 4907: 
 4908: }
