  954:    NodeBoundary *localNodeBoundaryMem; // Array of objects with the boundary information of each node
  955:    SideBoundary *localSideBoundaryMem; // Array of objects with the boundary information of each side
  956:    BoundarySegment *localSegmentMem;   // Array of objects with the boundary segments
  957:    
  958:    const int npgb;  // Global number of horizontal nodes
  959:    const int negb;  // Global number of elements
  960:    const int nsgb;  // Global number of sides
  961: 
  962:    const int np;   // Local number of horizontal nodes 
  963:    const int ne;   // Local number of elements
  964:    const int ns;   // Local number of sides
  965: 
  966:    int nbp;  // Local number of boundary nodes
  967: 
  968:    const int max_np; // Maximum number of horizontal nodes per partition (shared by all partitions)
  969:    const int max_ne; // Maximum number of elements per partition (shared by all partitions)
  970:    const int max_ns; // Maximum number of sides per partition (shared by all partitions)
  971: 
  972:   
  973:    // Additional topology information
  974:    Node    **nodeNeighNodes; // Array of pointers to the nodes neighbors of each node
  975:    Element **nodeNeighElems; // Array of pointers to the elements neighbors of each node
  976: 
  977: 
  978: 
  979:    // Vertical coordinate system
  980:    // Sigma levels
  981:    double h_s; 
  982:    double h_c; 
  983:    int    kz;
  984:    double theta_b;
  985:    double theta_f, sinh_theta_f;
  986:    double *sigma_lcl;
  987:    double *sigma;
  988:    double *ztot;
  989:    double *cs;
  990:    double *dcs;
  991: 
  992:    // // Get's the pointer to the node using the array of global pointers to nodes
  993:    // __device__ const Node *getGlobalNode(int jn) {
