 3813: //                       h_mass_in(:)=h_mass_in(:)-trel_tmp(1:ntr,k,i)*flux_adv_hface(k,jsj)*dtb
 3814: //                     endif
 3815: 
 3816: //                     cycle
 3817: //                   endif
 3818: 
 3819: //                   !Open bnd side with inflow (must be wet elem) or k<kbs(jsj)+1
 3820: //                   iweno=.false.  !reset to upwind
 3821: //                   ibnd=isbs(jsj) !global bnd #
 3822: //                   !Find node indices on bnd segment for the 2 nodes (for type 4 b.c.)
 3823: //                   nwild(1:2)=0
 3824: //                   do ll=1,2 !nodes
