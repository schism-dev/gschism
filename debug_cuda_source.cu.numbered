 3176:    __global__ void computeElevationBoundaryConditions(double ramp, double time) {
 3177:       // Compute elevation essential boundary conditions 
 3178: 
 3179:       NODE_BND(nodeBnd); // Each boundary node.
 3180: 
 3181:       const Node *node = nodeBnd->node;
 3182:       const int iettype = nodeBnd->iettype;
 3183: 
 3184:       double eic = 0.0;
 3185:       if (nramp_elev==1) eic = nodeBnd->etaic;
 3186:       else               eic = 0.0;
 3187: 
 3188:       const double r_eic = (1.0 - ramp)*eic; 
 3189:       const double r_eth = ramp*nodeBnd->eth;
 3190:       double eta1_bar = r_eic;
 3191: 
 3192:       // Compute tide elevation
 3193:       if (iettype == 3 || iettype == 5) {
 3194:         
 3195:          // XXX IMPLEMENT TIDE THINGS
 3196:          assert(true && "Tide elevation not implemented");
 3197:          // for (int jfr=0; jfr<nbfr; jfr++) { // For all tide frequencies
 3198:          //    const int ncyc = int(amig[jfr]*time/(2.0*pi));
 3199:          //    const double arg = amig[jfr]*time - 2.0*pi*ncyc + face[jfr] - efa[i,j,jfr];
 3200:          //    eta1_bar += ramp*ff[jfr]*emo[i,j,jfr]*cos(arg);
 3201:          // } // for jfr
 3202:       } // if iettype
 3203: 
 3204:       switch (iettype) {
 3205:          case 1:
 3206:          case 2:
 3207:             nodeBnd->elbc = r_eth + r_eic;
 3208:             break;
 3209:          case 3:
 3210:             nodeBnd->elbc = eta1_bar + r_eic;
 3211:             break;
 3212:          case 4:
 3213:             nodeBnd->elbc = r_eth + r_eic;
 3214:             break;
 3215:          case 5:
 3216:             nodeBnd->elbc = r_eth + eta1_bar + r_eic;
 3217:             break;
 3218:       } // switch
 3219: 
 3220: 
 3221:       //Add inverse barometric effects
 3222:       if (iettype != 0 && inv_atm_bnd == 1) {
 3223:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 3224:       }
 3225: 
 3226:    }
 3227: 
 3228:    __device__ void computeVerticallyIntegratedVelocity(void) {
 3229: 
 3230:       SIDE(side);
 3231: 
 3232:       side->U = {0.0, 0.0}; 
 3233:          
 3234:       if(side->idry) return;
 3235: 
 3236:       const Node *node1 = side->n1;
 3237:       const Node *node2 = side->n2;
 3238: 
 3239:       // Vertically integrated velocity U (in ll if ics=2)
 3240:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 3241:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 3242:       }
 3243: 
 3244:    }
 3245: 
 3246:    __global__ void computeBottomDragVegetation(void) {
 3247:       // UNFINISHED. CHECK THIS:
 3248:       // How many kernels are needed? Why so many for loops?
 3249:       // Is the loop on sides needed?
 3250: 
 3251:       NODE(node);
 3252: 
 3253:       const int    kb      = node->kb;
 3254:       const double htot    = node->htot();
 3255:       const double rough   = node->rough;
 3256: 
 3257: 
 3258:       if (node->idry) {
 3259:          // Default values for dry nodes
 3260:          node->veg_alpha_vert_mean = node->veg_alpha0;
 3261:          /// XXX CHECK INDICES
 3262:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 3263:       }
 3264: 
 3265:       // Compute bottom drag Cd
 3266:       //--------------------------------
 3267: 
 3268:       // nchi = {-1, 0, 1} is the type of bottom drag.
 3269:       if (nchi==1) {
 3270: 
 3271:          bool ltmp = false; // for WBL iteration
 3272: 
 3273:          // Cdmax=-1 !max. Cd at node for this process (info only)
 3274:          // Drag at nodes
 3275:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 3276:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 3277:         
 3278:          const double rough = node->rough;
 3279:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3280:          if (node->rough == 0.0) {
 3281:             node->Cd = 0.0;
 3282: 
 3283:          } else { //roughness >0 
 3284:             
 3285:             const double bthick_ori = node->znl[kb + 1] - node->znl[kb];  // thickness of bottom bnd layer
 3286:             const double bthick = max(dzb_min, bthick_ori);
 3287: 
 3288:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 3289: 
 3290:             double tmp = 1.0/(2.5*log(bthick/rough));
 3291:             node->Cd = tmp*tmp;
 3292: 
 3293:          } // if rough
 3294: 
 3295: 
 3296:          // RECOVER THIS: XXX
 3297:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 3298:          // Output warning for WBL if iteration didn't converge
 3299: 
 3300: 
 3301:       } // nchi==1
 3302: 
 3303:       //   Bottom stress in m^2/s^2
 3304:       if (node->rho[kb + 1] >= -98.0)
 3305:       {
 3306:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 3307:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 3308:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 3309:          // !sediment erosion: this part needs more documentation
 3310:       }
 3311: 
 3312:     
 3313:       // Compute vegetation parameters
 3314:       //--------------------------------
 3315: 
 3316:       // SAV constants
 3317:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 3318:       constexpr double veg_cfpsi = 0.16;
 3319: 
 3320:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 3321:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 3322: 
 3323:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 3324:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 3325:          int kbin = 0; // bin index
 3326:          for (int k = kb; k < nvrt; k++) {
 3327:             // Computes node height above the bottom level
 3328:             const double tmp_h = node->znl[k] - node->znl[kb]; // >=0
 3329:             assert(true && "Vertical variation of vegetation not implemented");
 3330: 
 3331:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 3332:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 3333:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 3334:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 3335:             // } else {
 3336:             //    // Find the bin at which the current vertical level is
 3337:             //    while (kbin<nbins_veg_vert) {
 3338:             //       const double zn = node->znl[kbin];
 3339:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 3340:             //          break;
 3341:             //       } // if
 3342:             //       kbin++;
 3343:             //    } // while
 3344:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 3345: 
 3346:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 3347:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 3348:                
 3349:             //    // Linear interpolation of the vegetation parameters
 3350:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 3351:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 3352:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 3353:             // } // if rl10
 3354: 
 3355:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 3356: 
 3357:          } // for k
 3358: 
 3359: 
 3360:       } else { // Ganthy (iveg=2)
 3361:       //  Modify canopy height, diameter, and density
 3362: 
 3363:          // Make sure there is vegetation on this node
 3364:          if (node->veg_h_unbent > 0.0) {
 3365:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 3366: 
 3367:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 3368:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 3369:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 3370: 
 3371:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 3372:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 3373:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 3374:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 3375:          } // if veg_h_unbent
 3376: 
 3377:          for (int k = 0; k < nvrt; k++) {
 3378:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 3379:          } // for k
 3380:       
 3381: 
 3382:       } // if iveg
 3383:      
 3384:          
 3385: 
 3386:       // Compute vertical mean of veg_alpha3D
 3387:       if (iveg != 0) {
 3388:          const double ztop = node->zTopCanopy(); // Top of the canopy
 3389:          double sum1=0.0;
 3390:          double sum2=0.0;
 3391:          // Integrate over each level under the canopy...
 3392:          for (int k=kb; k<nvrt-1 && node->znl[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 3393:             const double Dz = node->Dz(k);
 3394: 
 3395:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 3396:             sum2 += Dz;
 3397: 
 3398:          } // for k
 3399: 
 3400:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 3401:          else             node->veg_alpha_vert_mean = sum1/sum2;
 3402: 
 3403:       } // if iveg
 3404: 
 3405:    }
 3406: 
 3407:    __global__ void computeVegetationAndDragParameters(void) {
 3408:       // Computes the vegetation and drag model parameters:
 3409:       // chi, \tilde\chi, beta, \breve{H}
 3410:       
 3411:       SIDE(side);
 3412: 
 3413:       const double htot = side->htot();
 3414:       const int    kb   = side->kb;
 3415: 
 3416:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 3417: 
 3418:       const double veg_h     = side->veg_h();
 3419:       const double veg_nv    = side->veg_nv();
 3420:       const double veg_c     = side->veg_c();
 3421:       const double veg_beta  = side->veg_beta;
 3422:       const double veg_alpha = side->veg_alpha_vert_mean();
 3423: 
 3424:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 3425:       // Velocity magnitude at the bottom level
 3426:       // XXXX Check if we have add -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 3427:       assert(true && "Must use backtracked velocity");
 3428:       const double vmag1 = length(side->u2[kb + 1]); //BACKTRACKED VELOCITY
 3429:       side->chi2 = side->Cd()*vmag1;
 3430:       side->chi  = side->chi2;
 3431:       if constexpr(iveg != 0) {
 3432:          const Node *n1 = side->n1;
 3433:          const Node *n2 = side->n2;
 3434:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 3435:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 3436:       }
 3437: 
 3438:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 3439: 
 3440:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 3441:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 3442:       double magUa = 0.0;
 3443:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 3444:          // 3D wet side with veg...
 3445: 
 3446:          double magUa = 0.0;
 3447:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 3448:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 3449: 
 3450:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 3451:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 3452:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 3453: 
 3454:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 3455:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 3456: 
 3457:                // Velocity magnitude at the bottom (l) of the level
 3458:                const double ul = length(side->u2[k]);
 3459: 
 3460:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 3461:                magUa += Dz*0.5*(uh + ul);
 3462: 
 3463:             } // if HasVegetation
 3464:          } // for k
 3465:          const double ua = magUa/min(htot, veg_h); // Vertical average
 3466: 
 3467:          // Computes beta, used for computing the stress term at the top of the canopy.      
 3468:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 3469:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 3470:             const double zCpy = side->zTopCanopy();
 3471:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 3472:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 3473:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 3474:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 3475:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 3476:          } // if isSubmerged
 3477:       } // if iveg   
 3478: 
 3479:       // Computes the friction modified depth, \breve{H} in notes
 3480:       if (side->is2D()) { // 2D
 3481: 
 3482:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 3483:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 3484: 
 3485:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 3486: 
 3487:          side->hhat = htot*htot/fricH; 
 3488: 
 3489:       } else { // 3D
 3490:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 3491: 
 3492:          if constexpr(iveg != 0) {
 3493:             
 3494:             if (side->isSubmerged()) { 
 3495:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 3496:                side->hhat -= veg_c*Hhat_alpha;
 3497: 
 3498:             } else { // Emergent
 3499:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 3500:             }
 3501:          } // if iveg
 3502: 
 3503:          // Enforce positivity for 3D model
 3504:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 3505:       } // if 3D
 3506: 
 3507:         
 3508:    }
 3509: 
 3510: 
 3511: 
 3512:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 3513:    // Computes the density gradient between two elements, e1 and e2.
 3514:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 3515:    // zero in the direction normal to the side. 
 3516:    // 
 3517:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 3518:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 3519:    //
 3520:    // Input:
 3521:    //    e1: Element
 3522:    //    e2: Neighbor element (or nullptr if boundary)
 3523:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 3524:    //    k: Index of the half-level at which the density is interpolated
 3525:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 3526:    // 
 3527:    // Output:
 3528:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 3529:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 3530: 
 3531:       if (e2 == nullptr || e2->idry) {
 3532:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 3533: 
 3534:          Side *side = e1->sides[j];
 3535:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->idry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 3536:                  
 3537:          if constexpr(ics == 1) {
 3538:             vec = side->n; // Normal vector to the side
 3539:          } else {
 3540:             // IMPLEMENT THIS XXXXXX
 3541:             // !replace with xel, yel?
 3542:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 3543:             //      &eframe(:,:,i),xn1,yn1,tmp)
 3544:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 3545:             //      &eframe(:,:,i),xn2,yn2,tmp)
 3546:          } //ics
 3547:                    
 3548:          diffRho = 0.0;
 3549: 
 3550:       } else { //internal and wet
 3551:          if constexpr(ics==1) {
 3552:             assert(e2 != nullptr || e2->idry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 3553: 
 3554:             // Vector from e1 to e2
 3555:             vec = toVector2(e2->center - e1->center);
 3556: 
 3557:          } else { 
 3558:             // IMPLEMENT THIS XXXXXX
 3559:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 3560:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 3561:             //                   alow(j)=xctr2
 3562:             //                   bdia(j)=yctr2
 3563:          } // ics
 3564: 
 3565:          diffRho = rho2 - e1->demeanedDensity(k);
 3566:       }
 3567: 
 3568:    }
 3569: 
 3570:    __global__ void computeDensityCubicSplines(void) {
 3571:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 3572: 
 3573:       ELEM(elem);
 3574: 
 3575:       if (elem->idry) return;
 3576: 
 3577:       const int kb = elem->kb;
 3578: 
 3579:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 3580:       if (elem->is2D()) {
 3581:          // In the 2D case, the density is constant at the prism level. 
 3582:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 3583:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 3584:       } else { //3D
 3585: 
 3586:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 3587:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 3588:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 3589:          ///// XXXX CHECK INDICES!!!!!
 3590:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 3591:       } // 2D/3D
 3592: 
 3593:    }
 3594: } // extern "C"
 3595: 
 3596: 
 3597: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 3598: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 3599: 
 3600:    if (elem2 == nullptr || elem2->idry) return 0.0;
 3601: 
 3602:    const int kb  = elem->kb;
 3603:    const int kb2 = elem2->kb;
 3604: 
 3605:    // z-coordinate of prism of elem
 3606:    const double zp = elem->z_prism(k);
 3607: 
 3608:    double rho = 0.0;
 3609: 
 3610:    if (elem2->is2D()) {
 3611:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 3612: 
 3613:    } else {  // 3D
 3614: 
 3615:       // eta_min may be < zmax
 3616:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 3617:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 3618: 
 3619:       // (Extrapolate density below bottom, we will fix it later)
 3620:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 3621:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 3622:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 3623:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 3624:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 3625:    } // 2D/3D
 3626:      
 3627: 
 3628:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 3629:    // Now we need to fix it.
 3630:    if (elem->z[k] < elem2->z[kb2]) {
 3631:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 3632: 
 3633:       // There are two methods to adjust the density at the bottom of the element.
 3634:       // iunder_deep=0: 
 3635:       const double depth1 = abs(elem->z[kb]); // larger depth
 3636: 
 3637:       if (iunder_deep==0) {
 3638: 
 3639:          const double weight = max(0.0, min(1.0, (depth1 - h1_bcc)/(h2_bcc - h1_bcc))); // weight
 3640: 
 3641:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 3642: 
 3643:       } else { // iunder_deep != 0
 3644: 
 3645:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 3646: 
 3647:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 3648: 
 3649:          //   Demeaned density at the same z coordinate as
 3650:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 3651:          }
 3652: 
 3653:       } // if iunder_deep
 3654:    } // if elem->z[kb] < elem2->z[kb]
 3655: 
 3656:    return rho;
 3657: }
 3658: 
 3659: 
 3660: extern "C" {
 3661:    __global__ void computeDensityGradient(void) {
 3662: 
 3663:          // Compute the horizontal density gradient at each element.
 3664:       // It works in two steps:
 3665:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 3666:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 3667:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 3668:       //             gradRho.r1 = rho1 - rho0
 3669:       //             gradRho.r2 = rho2 - rho0
 3670:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 3671:       // 
 3672:       //  NOTE: We use de-meaned densities.
 3673: 
 3674:       ELEM(elem);
 3675: 
 3676:       if (elem->idry) return;
 3677: 
 3678:       const int kb  = elem->kb;
 3679:       const int i34 = elem->i34;
 3680: 
 3681:       for (int k = kb + 1; k < nvrt; k++) {
 3682:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 3683:          //             gradRho.r1 = rho1 - rho0
 3684:          //             gradRho.r2 = rho2 - rho0
 3685:          int icount = 0;
 3686:          double sumRx = 0.0;
 3687:          double sumRy = 0.0;
 3688:          for (int j1=0; j1<i34; j1++) { 
 3689: 
 3690:             const int j2 = elem->nxq(j1 + 1);
 3691: 
 3692:             // Pairs of consecutive neighbor elements of elem
 3693:             const Element *e1 = elem->nghbElems[j1];
 3694:             const Element *e2 = elem->nghbElems[j2];
 3695: 
 3696:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 3697:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 3698:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 3699: 
 3700:             // Compute the density difference and the vector from elem to e1 and e2
 3701:             // getRhoDiffAndVec takes into account boundaries/dry elements
 3702:             double diffRho1, diffRho2;
 3703:             Vector2 vec1, vec2;
 3704:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 3705:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 3706: 
 3707:             const double rl1 = length(vec1);
 3708:             const double rl2 = length(vec2);
 3709:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 3710: 
 3711:             const double delta = cross(vec1, vec2);
 3712:             const double sintheta = abs(delta)/(rl1*rl2);
 3713: 
 3714:             // To avoid problems, avoid elements with small angle between vectors
 3715:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 3716:             const bool validEq = (sintheta > sin_one_deg);
 3717: 
 3718:             if (validEq) {
 3719:                // Solve the system of equations to get the density gradient at elem
 3720:                icount++;
 3721:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 3722:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 3723:                sumRx += Rx;
 3724:                sumRy += Ry;
 3725:             }
 3726:          } // for j1
 3727: 
 3728:          // Compute the average density gradient at elem
 3729:          if (icount==0) {
 3730:            // Bad mesh quality; bail out with 0 b-cc
 3731:            elem->gradRho[k] = {0.0, 0.0};
 3732:          } else {
 3733:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 3734:          }
 3735: 
 3736:       } // for k
 3737: 
 3738:    }
 3739: 
 3740:    __global__ void computeBaroclinicTerm(double rampbc) {
 3741:    // Computes the baroclinic term at sides (at half levels).
 3742:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 3743:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 3744: 
 3745:       SIDE(side);
 3746: 
 3747:       if (side->idry == 1) return;
 3748: 
 3749:       const Element *e1 = side->elems[0];
 3750:       const Element *e2 = side->elems[1];      
 3751:       const int kb = side->kb;
 3752:       
 3753:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 3754: 
 3755:       // interpolates vertically the density gradient of the two elements at the half level/
 3756: 
 3757:       // Starts the integration at the surface and goes down to the bottom
 3758:       int k1 = nvrt - 1;
 3759:       int k2 = nvrt - 1;
 3760: 
 3761:       side->bcc[nvrt-1] = {0.0, 0.0};
 3762:       for (int k = nvrt-1; k >= kb; k--) {
 3763:       // For each prism level (from surface to bottom)...
 3764: 
 3765:          // For both elements, interpolate density gradient at the side's half level.
 3766:          // The gradient at the side is the average of the gradients at the elements.
 3767:          // w1, w2 are used to take into account boundary sides, with just one element.
 3768:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 3769:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 3770:          w1 = w1/(w1 + w2);
 3771:          w2 = w2/(w1 + w2);
 3772: 
 3773:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 3774: 
 3775:          // Linear interpolation of both elements' density gradient at the shared side's level.
 3776:          Vector2 gradRho = {0.0, 0.0};
 3777:          if (e1 != nullptr && k > kb) {
 3778:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 3779:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 3780:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 3781:             
 3782:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 3783:          }      
 3784:          if (e2 != nullptr && k > kb) {
 3785:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 3786:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 3787:             
 3788:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 3789:          }
 3790: 
 3791:          if constexpr(ics==2) {
 3792:             // IMPLEMENT THIS XXXXXX
 3793:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 3794:             // swild(1)=tmp1
 3795:             // swild(2)=tmp2
 3796:          }
 3797:          
 3798:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 3799:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 3800:          // CHECK INDICES!!! XXX
 3801:          const double grav3 = 0.5*(side->n1->grav2 + side->n2->grav2);
 3802:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 3803:       } // for
 3804: 
 3805:    }
 3806: 
 3807: } // extern "C"
 3808: 
 3809: #ifdef DONTCOMPILE
 3810: __device__ void computeVerticalAdvection(void) {
 3811:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 3812: 
 3813:    sdbt(1:2,:,:)=0.d0
 3814: 
 3815:    const Side *side = FROM kernel;
 3816: 
 3817:    if(side->idry) return;
 3818: 
 3819:    // If side is wet...
 3820: 
 3821: 
 3822:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 3823:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 3824:    double ws[nvrt] = {} // w @ side
 3825:    int icount = 0;
 3826:    for (int j=0; j<2; j++) {
 3827:       const Element *elem = side->elements[j];
 3828:        
 3829:       if(elem != nullptr) {
 3830:          icount++;
 3831:          for (int k=0; k<nvrt; k++) {
 3832:             ws[k] = ws[k] + elem->w[k];
 3833:          }
 3834:       }
 3835:    }  // for j
 3836: 
 3837:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 3838:    ws = ws/icount;
 3839: 
 3840:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 3841:    // Splines allow for a smooth transition between vertical levels.
 3842:    // Splines have continuity restrictions at the internal knots, but
 3843:    // we have to provide the 1st derivatives at the endpoints.
 3844:    const int kbs = side->kbs; 
 3845:    
 3846:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3847:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3848:    initCubicSpline(kbs, nvrt, side, ws, up)
 3849: 
 3850:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3851:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3852:    initCubicSpline(kbs, nvrt, side, ws, vp)
 3853: 
 3854:    // Total advection (average onto side)
 3855:    const Node *node1 = side->nodes[0];
 3856:    const Node *node2 = side->nodes[1];
 3857:    for (int k=kbs(i); k<nvrt; k++) {
 3858: 
 3859:       if constexpr(ics==1) {
 3860:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 3861:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 3862:       } else {
 3863:          // XXX IMPLEMENT THIS
 3864:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 3865:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 3866:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 3867:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 3868:       }  // if ics
 3869: 
 3870: 
 3871:    }
 3872: }
 3873: #endif
 3874: 
 3875: 
 3876: extern "C" {
 3877:    __global__ void computeElemAverageGhat(double rampbc) {
 3878:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 3879: 
 3880:       ELEM(elem);
 3881:       
 3882:       elem->ghat1= {0.0, 0.0};  
 3883: 
 3884:       if constexpr(ihydraulics != 0) {
 3885:          if (nhtblocks > 0 && elem->isblock) return;
 3886:       }
 3887: 
 3888:       if (elem->idry == 1) return;
 3889: 
 3890:       // Wet elements.
 3891:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 3892:       // tidal potential, horizontal diffusion, and baroclinic etc
 3893:       // Remember to update both fb and F 
 3894:       // If ics=2, ghat1 are in eframe (ll)
 3895:       // cff1-3: coefficients for 2D/3D
 3896:       Vector2 gradEta = {0.0, 0.0};  // \nabla \eta
 3897:       Vector2 gradPr  = {0.0, 0.0};  // \nabla pressure
 3898:       Vector2 gradETP = {0.0, 0.0};  // \nabla etp
 3899: 
 3900:       double av_cff1 = 0.0;  // av. for cff1
 3901:       double av_cff2 = 0.0;  // av. for cff2
 3902:       double av_cff3 = 0.0;  // av. for cff3
 3903:       double av_df = 0.0;  // av. for H^\alpha / H
 3904:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 3905:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 3906: 
 3907:       const int i34 = elem->i34;
 3908:       const int kb = elem->kb;
 3909: 
 3910:       for (int j=1; j<i34; j++) {
 3911:          // For each node and side in the element...
 3912: 
 3913:          const Node *node = elem->nodes[j];
 3914:          const Side *side = elem->sides[j];
 3915: 
 3916:          const double chi      = side->chi;
 3917:          const double veg_c2   = side->veg_c2;
 3918:          const double veg_beta = side->veg_beta;
 3919:          const double veg_h    = side->veg_h();
 3920:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 3921: 
 3922:          // Node - const in elem
 3923:          gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 3924:          gradPr  += node->pr  *elem->gradPhi[j];
 3925: 
 3926:          if (elem->depth >= tip_dp) {
 3927:            gradETP += node->ETP*elem->gradPhi[j];
 3928:          }
 3929: 
 3930:          
 3931:          const double htot  = side->htot();        // Total depth at the side
 3932:          const double zctr2 = side->zTopCanopy();  
 3933: 
 3934:          double cff1; 
 3935:          double cff2; 
 3936:          double cff3;   
 3937:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 3938:          // coefficients applied to 2D/3D case 
 3939:             cff1 = side->hhat/htot;
 3940:             cff2 = 0.0;
 3941:             cff3 = 0.0;
 3942:          } else { //3D
 3943:             //Init for no-veg case
 3944:             cff1 = 1.0;
 3945:             cff2 = 1.0;
 3946:             cff3 = 0.0;
 3947: 
 3948:             if constexpr(iveg != 0) {
 3949:                // Computes coefficients used with vegetation terms G1, G2
 3950:                // cff1, cff3 are used for the first two terms in G1, G2:
 3951:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 3952:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 3953:                // In general, cff1*Ustar - cff3*Ustar_alpha
 3954:                if(veg_h < 0.99*htot) { // submergent vegetation
 3955:                   cff1=1;
 3956:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 3957:                   cff3 = veg_c;
 3958: 
 3959:                } else { // emergent vegetation
 3960:                   cff1 = 1.0/(1.0 + veg_c2);
 3961:                   cff2 = cff1;
 3962:                   cff3 = 0.0;
 3963: 
 3964:                }
 3965:             } // if iveg
 3966:          } //  2D/3D
 3967: 
 3968:          av_cff1 += cff1/i34;
 3969:          av_cff2 += cff2/i34;
 3970:          av_cff3 += cff3/i34;
 3971:          av_cff2_chi += cff2*chi/i34;
 3972:          av_cff3_chi += cff3*chi/i34;
 3973:          av_df += min(htot, veg_h)/(htot*i34);
 3974: 
 3975: 
 3976:          // btrack values: U^\star, U^{\star\alpha}
 3977:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 3978:          Vector2 Ustar       = {0.0, 0.0}; 
 3979:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 3980:          for (int k = side->kb; k < nvrt; k++) {
 3981:             if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 3982:                Ustar += side->btu[nvrt]*side->Dz(k);
 3983: 
 3984:             } else { //3D
 3985:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 3986:                Ustar += w2;
 3987: 
 3988:                if constexpr(iveg != 0) {
 3989:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 3990:                        const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k)); // For the top of the canopy, ratio of the level that is below the canopy
 3991:                        Ustar_alpha += zrat*w2; // XXXX
 3992:                    }
 3993:                }  // if iveg
 3994:             }  //2/3D
 3995:          }  //k
 3996:          
 3997: 
 3998:          // Add btrack & surface stress terms to \breve{G} first
 3999:          if constexpr(ics==1) {
 4000:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 4001:          } else {
 4002:             // XXX IMPLEMENT THIS
 4003:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 4004:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 4005:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 4006:          }  // if ics
 4007: 
 4008:          // Surface and bottom stress terms
 4009:          if constexpr(ics==1) {
 4010:             const Vector2 tau    = side->tau();
 4011:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 4012: 
 4013:             // Term for surface and bottom stress
 4014:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 4015:          } else {
 4016:             // XXX IMPLEMENT THIS
 4017:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 4018:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 4019:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 4020:             // tau_x=(vn1+tt1)/2.d0
 4021:             // tau_y=(vn2+ss1)/2.d0
 4022:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 4023:          }  // if ics
 4024: 
 4025:          
 4026: 
 4027:          // All terms in F,F^\alpha,f_b except baroclinic
 4028:          // F, f_b: all explicit terms excluding vegetation 
 4029:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 4030:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 4031:          const double coriolis = side->coriolis;
 4032:          Vector2 F  =  coriolis*side->U;  // F_x
 4033:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 4034:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 4035: 
 4036:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 4037:             
 4038:             for (int k = side->kb; k < nvrt; k++) {
 4039:                if (zctr2 > side->zc[k-1]) {
 4040:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 4041:                    const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 4042:                    Fa +=  coriolis*w2*zrat;
 4043:                } // if zctr2
 4044:             } // k
 4045:          } // iveg
 4046: 
 4047:          // Integrate horizontal viscosity force vertically
 4048:          for (int k=side->kb + 1; k<nvrt; k++) {
 4049:             const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.0; 
 4050: 
 4051:             F += levelHorVisc;
 4052: 
 4053:             // Vegetation term
 4054:             if constexpr(iveg!=0) {
 4055:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 4056:                   const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k));
 4057:                   Fa += levelHorVisc*zrat;
 4058:                } 
 4059:             } // if iveg
 4060:          } // for k
 4061: 
 4062:          fb += side->d2uv[side->kb];
 4063: 
 4064: 
 4065:          // Add to ghat1
 4066:          if constexpr(ics==2) {
 4067:             // XXX IMPLEMENT THIS
 4068:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4069:             // bigf1=vn1; bigf2=vn2
 4070:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4071:             // botf1=vn1; botf2=vn2
 4072:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 4073:             // bigfa1=vn1; bigfa2=vn2
 4074:          } // if ics
 4075: 
 4076:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 4077:       } // for j (nodes and sides)
 4078: 
 4079:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 4080:          
 4081:       // Finish off terms in F, F^\alpha and f_b
 4082:       const double grav3 = elem->mean(&Node::grav2);
 4083:       const Vector2 fb = grav3*gradETP - gradPr/rho0; //const in each elem
 4084: 
 4085: 
 4086:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 4087:       for (int j=1; j<i34; j++) { 
 4088:          // For each side in the element...
 4089:          const Side *side = elem->sides[j];
 4090:          const double chi = side->chi;
 4091: 
 4092:          const double htot = side->htot();
 4093:          const double veg_h = side->veg_h();
 4094:          const Vector2 F  = htot*fb;
 4095:          const Vector2 Fa = min(htot, veg_h)*fb;
 4096: 
 4097:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 4098:       } // for j
 4099: 
 4100:       //botf1 etc are already in elem frame
 4101:       elem->ghat1 += tmp/i34;
 4102: 
 4103:       // Baroclinic force
 4104:       if constexpr(ibc==0) {
 4105:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 4106: 
 4107:          Vector2 Fa = {0.0, 0.0};
 4108:          Vector2 intGradRho = {0.0, 0.0};
 4109:          
 4110:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 4111:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 4112:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 4113: 
 4114:             // \in F [m^2/s/s]
 4115:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 4116:          }
 4117: 
 4118:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 4119:          const Vector2 F = av_df*Fa; //approx
 4120:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 4121: 
 4122:       } // if ibc
 4123: 
 4124:    }
 4125: 
 4126: } // extern "C"
 4127: 
 4128: 
 4129: 
 4130: #ifdef DONTCOMPILE
 4131: __global__ void checkMassConservation(Tracers* sumtr) {
 4132: 
 4133:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 4134: 
 4135:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 4136: 
 4137:    Element *elem = &(mesh->localElemData[i]);
 4138: 
 4139:    // Skip dry elements
 4140:    if (elem->idry) return;
 4141: 
 4142:    // Local sum array for this thread
 4143:    double localSum[N_TRACERS] = {0.0};
 4144: 
 4145:    // Sum over vertical levels for this element
 4146:    const int kbe = elem->kbe;
 4147:    const double area = elem->area;
 4148: 
 4149:    for (int k = kbe; k < nvrt; k++) {
 4150:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 4151:       
 4152:       // Accumulate tracer mass
 4153:       for (int tr = 0; tr < N_TRACERS; tr++) {
 4154:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 4155:       }
 4156:    }
 4157: 
 4158:    
 4159: 
 4160:    //  This function returns per element sums. A reduction must be done on the host side.
 4161: }
 4162: 
 4163: 
 4164: __global__ void transport(void) {
 4165: 
 4166:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 4167: 
 4168:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 4169: 
 4170:    Element *elem = &(mesh->localElemData[ie]);
 4171: 
 4172:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 4173: 
 4174:                for (int m=0; m<ntr; m++) {
 4175:                   for (int k=kbe(ie); k<nvrt; k++) {
 4176:                      // Calculate each polynomial's weight 
 4177:                      wm=0.d0; sum1=0.d0; 
 4178:                      wm1=0.d0; wm2=0.d0; 
 4179:                      for (int i=0; i<elem->nweno2; i++) {
 4180:                   
 4181:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4182:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4183:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4184:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4185:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4186:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 4187:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 4188:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 4189:                      // -----------------Hu and Shu (1999)'s method----------------
 4190:                      b4=b1+b2+b3
 4191: 
 4192: //Error: add PRODUCTION CPP
 4193: #ifdef DEBUG
 4194:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 4195:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 4196:                     call parallel_abort(errmsg)
 4197:                   }
 4198: #endif
 4199: 
 4200:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 4201:                   // !----test-------------- 
 4202:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 4203:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 4204:                   // !wm(i)=wm1(i)*wm2(i)
 4205:                   // !---------------------- 
 4206:                   sum1=sum1+wm(i)
 4207:                 } // end for i
 4208: 
 4209:                 wm=wm/sum1
 4210: 
 4211:                 for (int j=0; j<elem->i34; j++) {
 4212: 
 4213:                   const Side *side  = elem->sides[j];
 4214:                   const Node *node1 = side->n1;
 4215:                   const Node *node2 = side->n2;
 4216: 
 4217:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 4218:                      trsd=0.d0
 4219:                      for (int kk=0; kk<nquad; kk++) {
 4220:                         for (int i=0; i<elem->nweno2; i++) {
 4221:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 4222:                         } // end for i   
 4223:                      } // end for kk
 4224:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 4225:                   } // outward flux
 4226:                } // end for j=1,i34(ie) ! side
 4227:             }
 4228:          }
 4229:               
 4230: 
 4231: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 4232: //             //   calculate each polynomial's weight 
 4233: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 4234: //                 wm=0.d0; sum1=0.d0
 4235: //                 do i=1,nweno1(ie) !for each polynomial
 4236: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4237: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 4238: //                   b1=b1*b1+b2*b2 !smoothness indicator
 4239: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 4240: //                   wm(i)=b2
 4241: //                   sum1=sum1+b2
 4242: //                   !wm(i)=1.d0
 4243: //                   !sum1=sum1+1.d0
 4244: 
 4245: // // Error: PRODUCTION
 4246: // #ifdef DEBUG
 4247: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 4248: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 4249: //                     call parallel_abort(errmsg)
 4250: //                   endif
 4251: // #endif
 4252: 
 4253: //                 enddo !i
 4254: //                 wm=wm/sum1 !final weight
 4255: 
 4256:                 for (int j=0; j<elem->i34; j++) { // side
 4257:                   const Side *side = elem->sides[j];
 4258:                   const Node *node1 = side->n1;
 4259:                   const Node *node2 = side->n2;
 4260: 
 4261:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 4262:                     trsd=0.d0
 4263:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 4264:                       for (int i=0; i<elem->nweno1; i++) {
 4265:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 4266:                       }
 4267:                     enddo //kk
 4268:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 4269:                   } // outward flux
 4270:                 } // end for j=1,i34(ie) ! side
 4271:               } // end for k; ntr 
 4272: 
 4273:             else !simple upwind method
 4274:               do j=1,i34(ie)
 4275:                 jsj=elside(j,ie)
 4276:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 4277:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 4278:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 4279:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 4280:                   endif
 4281:                 enddo  !vertical layers
 4282:               enddo !j=1,i34(ie) ! side
 4283:             endif !order of accuracy
 4284: 
 4285:          //  enddo !ie
 4286: // !$OMP     end do
 4287: 
 4288: // !$OMP     master
 4289: //           !message passing
 4290: //           if (nproc>1) then
 4291: //             !make a copy of side concentrations
 4292: //             trsd_tmp0=trsd_tmp 
 4293: 
 4294: //             !this exchange routine swaps interface concentration between two partitions
 4295: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 4296: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 4297: 
 4298: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 4299: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 4300: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 4301: 
 4302: 
 4303: //             !This obtains final values for interface sides
 4304: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 4305: //       :    endif !nproc>1
 4306: //           !message passing end
 4307: // !$OMP     end master
 4308: // !$OMP     barrier
 4309: 
 4310: 
 4311: // !         Do advection; conc @ dry elem will not be changed
 4312: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 4313: // !$OMP     do reduction(+: h_mass_in)
 4314: //           do i=1,ne
 4315: //             if(idry_e(i)==1) cycle
 4316: 
 4317: 
 4318: // !           Wet elements with 3 wet nodes
 4319: //             do k=kbe(i)+1,nvrt
 4320: 
 4321: 
 4322: //               bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 4323: //               dtb_by_bigv = dtb/bigv
 4324:     
 4325: // !             Advective flux
 4326: //               if (ntd_weno==1 .or. itd_weno==1) then
 4327: //                 adv_tr(1:ntr)=trel_tmp(1:ntr,k,i) 
 4328: //               else
 4329: //                 adv_tr(1:ntr)=(1.d0-rk_coef(itd_weno))*trel_tmp0(1:ntr,k,i)+rk_coef(itd_weno)*trel_tmp(1:ntr,k,i) 
 4330: //               endif
 4331: 
 4332: //               !psum=0.d0 !sum of modified fluxes for all inflow bnds
 4333: //               do j=1,i34(i)
 4334: //                 jsj=elside(j,i) !side
 4335: //                 iweno=.true. !use weno reconstruction as default
 4336: //                 iel=ic3(j,i) !neighboring elem
 4337: 
 4338: //                 if(iel/=0) then
 4339: //                   if(idry_e(iel)==1) cycle
 4340: //                   trel_tmp_outside(:)=trel_tmp(:,k,iel)
