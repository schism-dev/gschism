  877:    __device__ Mesh(int partNum,
  878:                    int npgb, int negb, int nsgb, 
  879:                    int np, int ne, int ns, int nvrt, int kz,
  880:                    int max_np, int max_ne, int max_ns, int nseg,
  881:                    const Node **nodesPtr, const Element **elemsPtr, const Side **sidesPtr,
  882:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
  883:                    Node    **localNodeNeighNodesMem,
  884:                    Element **localNodeNeighElemsMem,
  885:                    NodeBoundary *localNodeBoundaryMem,
  886:                    SideBoundary *localSideBoundaryMem,
  887:                    BoundarySegment *localSegmentMem,
  888:                    double h_s, double theta_b, double theta_f, double *sigma_lcl, double *sigma, double *ztot,
