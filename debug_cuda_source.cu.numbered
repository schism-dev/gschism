 3015: 
 3016:    __global__ void scaleGravity(double loadtide_coef) {
 3017: 
 3018:       printf("scaleGravity: i = %d, np = %d\n", threadIdx.x + blockIdx.x * blockDim.x,mesh->np);
 3019:       NODE(node);
 3020: 
 3021:       // SAL option: scale gravity
 3022:       if constexpr(iloadtide==2) {  // simple const
 3023:          node->grav2 = grav*(1.0 - loadtide_coef);
 3024: 
 3025:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3026:         
 3027:           const double depth = max(node->depth, 0.0);
 3028:           const double tmp1 = sqrt(depth);
 3029:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3030:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3031:                              2.6969e-13*depth*depth*depth*tmp1;
 3032:           
 3033:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3034:           
 3035: 
 3036: 
 3037:           node->grav2 = grav*(1.0 - beta_bar);
 3038: 
 3039:       } else {  // iloadtide=0,1
 3040:         node->grav2=grav;
 3041: 
 3042:       }
 3043: 
 3044:       printf("scaleGravity: node(%d)->grav2 = %f\n", node->idx, node->grav2);
 3045:    }
