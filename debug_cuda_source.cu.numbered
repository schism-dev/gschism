 4914: extern "C"
 4915:                                  
 4916:   __global__ void populateMesh(int *i34, int *elnode, int *elside,
 4917:                    double *node_coords, double *wind_rotate_angle, 
 4918:                    int *isdel, int *isidenode, int *isbnd,
 4919:                    int *nond, int *nlnd, int *iond, int *ilnd,
 4920:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4921:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4922:                    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4923:                    int *localNodeIndices, int *localElemIndices, int *localSideIndices,
 4924:                    int *localNodePart,    int *localElemPart,    int *localSidePart,
 4925:                    double *emo, double *efa, 
 4926:                    double *umo, double *ufa, 
 4927:                    double *vmo, double *vfa) {
 4928: 
 4929:     mesh->populateMesh(i34, elnode, elside, node_coords, wind_rotate_angle, 
 4930:                        isdel, isidenode, isbnd,
 4931:                        nond, nlnd, iond, ilnd,
 4932:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 4933:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 4934:                        globalNodeIndices, globalElemIndices, globalSideIndices,
 4935:                        localNodeIndices, localElemIndices, localSideIndices,
 4936:                        localNodePart, localElemPart, localSidePart,
 4937:                        emo, efa, umo, ufa, vmo, vfa);
 4938:   }
