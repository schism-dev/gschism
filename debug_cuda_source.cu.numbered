 4356:                       }
 4357:                     enddo //kk
 4358:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 4359:                   } // outward flux
 4360:                 } // end for j=1,i34(ie) ! side
 4361:               } // end for k; ntr 
