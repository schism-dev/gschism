  930: struct Node {
  931: 
  932:    // Geometry information
  933:    int idx;        // Index of the node
  934:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
  935:    int numNodes;   // Number of nodes neighbors of this node
  936: 
  937:    Element **elements; // Array of pointers to the elements that share this node
  938:    int numElements;   // Number of elements that share this node
  939: 
  940:    Point3 p;
  941:    Vector3 u2[nvrt];
  942:    double znl[nvrt];
  943:    double lon, lat;
  944:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
  945:    double depth;
  946: 
  947:    int kb;       // Bottom index of the node
  948: 
  949:    bool isDry;     // True if the node is dry
  950: 
  951:    int iadv;     // Advection flag
  952: 
  953:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
  954: 
  955:    // Physical information
  956:    Tracers tr_nd0[nvrt]; // Initial tracer conc. at nodes
  957: 
  958:    double rho[nvrt];     // Density
  959: 
  960:    double eta1; // Elevation at nodes at previous timestep
  961:    double eta2; // Elevation at nodes at current timestep
  962: 
  963:    double ETP;  // Earth Tidal Potential
  964: 
  965:    
  966:    double pr;    // Air pressure
  967:    double grav2; // Gravity 
  968:    
  969:    Vector2 dav;  // Depth averaged velocity
  970: 
  971:    Vector2 tau; // Wind stress vector
  972: 
  973:    // Vegetation parameters
  974:    double veg_h;
  975:    double veg_nv;
  976:    double veg_di;
  977:    double veg_Cd;
  978:    double veg_h_unbent;
  979:    double veg_di_unbent;
  980:    double veg_nv_unbent;
  981:    double veg_alpha_vert_mean;
  982:    double veg_alpha0;
  983:    double veg_alpha3D[nvrt];
  984: 
  985:    // Bottom drag parameters
  986:    double Cd;       // Bottom drag coefficient
  987:    double rough;    // Bottom roughness length
  988:    Vector2 tau_bot; // Bottom stress vector
  989: 
  990:    double bdef1; // Bottom deformation at previous timestep
  991:    double bdef2; // Bottom deformation at current timestep
  992: 
  993:    double qel; // RHS
  994:    double coeffDiag; // Diagonal coefficient of the matrix
  995:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
  996: 
  997:    double mP; // Search direction for conjugate gradient method
  998:    double mR; // Residual for conjugate gradient method
  999:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1000:    double mX; // Solution for conjugate gradient method
 1001: 
 1002:    // Meteorological forcing
 1003:    Vector2 u_air;
 1004:    double p_air;
 1005:    double t_air;
 1006:    double q_air;
 1007:    double wind_angle;  // Wind rotation angle
 1008: 
 1009:    __host__ __device__ void setWind(Vector2 &u) {
 1010:    // Sets the wind vector taking into account the wind rotation angle
 1011:    
 1012:       const double dir = atan2(-u.x,-u.y);
 1013:       const double speed = length(u);
 1014: 
 1015:       // Calculate new u and v components with added rotation angle
 1016:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1017:    }
 1018: 
 1019:    __host__ __device__ Point2 p2(void) const { return {p.x, p.y}; }
 1020: 
 1021:    __host__ __device__ double sigmaTransitionDepth(void) const;
 1022: 
 1023:    __inline__ __device__ double Dz(int k) const { return znl[k] - znl[k-1]; }
 1024:    __inline__ __device__ double htot(void) const { return eta2 + depth; }
 1025:    __inline__ __device__ double zTopCanopy(void) const { return znl[kb] + veg_h; } 
 1026: 
 1027:    __device__ void clearMatrixRow(void) {
 1028:       // Clear the matrix row for this node
 1029:       coeffDiag = 0.0;
 1030:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1031: 
 1032:    }
 1033: 
 1034:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1035:       // Add the value to the sparse matrix for this node
 1036:       
 1037:       if (node == this) {
 1038:          coeffDiag += value;
 1039: printf("addToSparseMatrix: node == this, value = %f\n", coeffDiag);         
 1040:       } else {
 1041:          // Search (linearly)the index of the node in the array of nodes
 1042:          // XXX: This is not efficient, see if we can improve this
 1043:          int i;
 1044:          for (i = 0; i < numNodes; i++) {
 1045:             if (nodes[i] == node) {
 1046:                break;
 1047:             }
 1048:          }
 1049:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1050:          coeffMatrix[i] += value;
 1051:       }
 1052:    }
 1053: 
 1054: #ifdef BACKTRACKING
 1055:    __device__ void updateZCoordData() {
 1056:    // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 1057: 
 1058:       // Check if node is wet
 1059:       isDry = (depth + eta2 <= h0);  // XXX Check if we are doing this elsewhere
 1060: 
 1061:       if (idry) return;
 1062: 
 1063:       if constexpr(ivcor == 2) {  // SZ coordinates
 1064:          
 1065:          // Compute bottom level index
 1066:          if (depth <= mesh->h_s) {
 1067:                kb = mesh->nzlevels;
 1068:          } else {
 1069:                kb = -1;
 1070:                for (int i = 0; i < mesh->kz-1; i++) {
 1071:                   if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 1072:                      kb = i;
 1073:                      break;
 1074:                   }
 1075:                }
 1076:          }
 1077:       } 
 1078:       else if (ivcor == 1) {  // Localized sigma
 1079:          // Do nothing
 1080:       }
 1081: 
 1082:    }
 1083: #endif   
