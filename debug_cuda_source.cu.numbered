  426: struct Element {
  427: 
  428:    // Geometry information
  429:    int idx;               // Index of the element
  430:    int i34;               // Number of sides for the element 
  431:    Side *sides[4];        // Sides of the element
  432:    Node *nodes[4];        // Nodes of the element
  433:    Element *nghbElems[4]; // Neighbors of the element
  434: 
  435:    int kb;                    // Bottom index of the element
  436:    double area;               // Area of the element
  437:    double ssign[4];           // Sign associated with each side of an element
  438:    double radius;             // Element equivalent radii
  439: 
  440:    Frame frame;
  441: 
  442:    Vector2 gradPhi[4];       // Derivatives of shape functions
  443:    Vector2 gradEta[nvrt];    // Gradient of free surface elevation
  444: 
  445:    bool isDry;                  // True if the element is dry
  446:    int kbe;                   // Bottom index of the element
  447: 
  448:    Vector3 center;            // Element center coordinates
  449:    double xlon_el, ylat_el;   // Element center lat/lon coordinates in _degrees_
  450:    double depth;              // Depth at element (min of all nodes)
  451:    double z[nvrt];            // z-coord  (local frame - vertical up)
  452: 
  453:    // Physical information
  454:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  455: 
  456:    static const bool isblock = false;              // Always false
  457: 
  458:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  459:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  460: 
  461:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  462: 
  463:    
  464: 
  465:    double vsource;            // Volumetric source/sink term [m^3/s]
  466: 
  467:    double rho[nvrt];          // Density at each prism center
  468:    double rho_mean[nvrt];     // Mean density at each prism center
  469:    CubicSpline rho_spl;
  470:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  471:    double rho_z[nvrt];        // First derivative of density at each prism center
  472:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  473: 
  474:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  475: 
  476:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  477:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  478: 
  479:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 1; }
  480:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 1; }
  481: 
  482:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  483:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  484:       // Find the local index of the node in the element (0,1,2,3)
  485:       int res = __ffs((nodes[0] == node) | 
  486:                      ((nodes[1] == node) << 1) | 
  487:                      ((nodes[2] == node) << 2) | 
  488:                      ((nodes[3] == node) << 3)) - 1;
  489:       
  490:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  491:       return res;
  492:    }
  493: 
  494:    __inline__ __device__ int findLevel(double z1, int k) const {
  495:       // Starting at index k, find sequentially the level that contains z
  496: 
  497:       // if z is already betweeen z[k] and z[k+1], return k
  498:       if (z1 >= z[k] && z1 < z[k+1]) return k;
  499:       else if (z1 < z[k]) { 
  500:          // Search for increasing levels
  501:          for (int kk = k; kk < nvrt - 1; kk++) {
  502:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  503:          }
  504:          return nvrt - 1;
  505:       }
  506:       else {
  507:          // Search for decreasing levels
  508:          for (int kk = k; kk > 0; kk--) {
  509:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  510:          }
  511:          return 0;
  512:       }
  513:    }
  514: 
  515:    __inline__ __device__ double z_prism(int k) const { return 0.5*(z[k+1] + z[k]); }
  516:    __inline__ __device__ double Dz(int k)      const { return z[k+1] - z[k]; }
  517: 
  518:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  519: 
  520:    __inline__ __device__ double computeSignedArea(void) const;
  521: 
  522:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  523:       // Nudges the point (x,y) to the barycenter of the element
  524:       p = (1-eps)*p + eps*toVector2(center);
  525:    }
  526: 
  527:    __device__ bool computeShapeCoords(Point2 xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  528: 
  529:    __device__ Vector2 grad(double *a) const
  530:    {
  531:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  532:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  533:       if (isQuad()) {
  534:          gx += a[3]*gradPhi[3].x;
  535:          gy += a[3]*gradPhi[3].y;
  536:       }
  537:       return {gx, gy};
  538:    }
  539: 
  540:    __device__ void setFrame(void) {
  541: 
  542:       double ar1, ar2;
  543:       computeLonLat(center, ar1, ar2);
  544: 
  545:       frame.update(ar1, ar2);        
  546:     }
  547: 
  548:    __device__ bool findNextIntersection(Point2 x2, Side *&side, Element *&nextElement, double &t, 
  549:                                         double& tIntersect);
  550:    __device__ bool findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement, double &t, 
  551:                                         double& tIntersect);
  552: 
  553:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  554:       // Check if the point (xt,yt) is inside the element
  555:       double shpCoords[4];
  556:       bool res = computeShapeCoords(xt, shpCoords, false);
  557:       return res;
  558:    }
  559: 
  560:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4])
  561:    {
  562:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  563:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  564:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  565:       
  566:    }
  567: 
  568:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int);
  569: 
  570:    // ------------------------------------------------------------------------------------------------
  571:    // These are functions that work on all nodes of the element.
  572:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  573:    //
  574:    // An example of how to use these functions is:
  575:    //   
  576:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  577:    // 
  578:    // Where L is the level at which the field is to be interpolated. The field can be either
  579:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  580:    // There are different versions of getNodalValues for each of these cases.
  581: 
  582:    template<typename T>
  583:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  584:       // Get the values of the field at the nodes of the element
  585:       res[0] = nodes[0]->*field;
  586:       res[1] = nodes[1]->*field;
  587:       res[2] = nodes[2]->*field;
  588:       if (isQuad()) res[3] = nodes[3]->*field;
  589:       else          res[3] = T();
  590:    }
  591: 
  592:    template<typename T>
  593:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  594:       // Get the values of the field at the nodes of the element
  595:       res[0] = (nodes[0]->*field)[level];
  596:       res[1] = (nodes[1]->*field)[level];
  597:       res[2] = (nodes[2]->*field)[level];
  598:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  599:       else          res[3] = T();
  600:    }    
  601: 
  602:    template<typename T>
  603:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  604:       // Get the values of the func at the nodes of the element
  605:       res[0] = (nodes[0]->*func)(level);
  606:       res[1] = (nodes[1]->*func)(level);
  607:       res[2] = (nodes[2]->*func)(level);
  608:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  609:       else          res[3] = T();  // This is 0.0 or a zero vector
  610: 
  611:    }      
  612: 
  613:    template<typename T>
  614:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  615:       // Get the values of the field at the nodes of the element
  616:       res[0] = sides[0]->*field;
  617:       res[1] = sides[1]->*field;
  618:       res[2] = sides[2]->*field;
  619:       if (isQuad()) res[3] = sides[3]->*field;
  620:       else          res[3] = T();
  621:    }
  622: 
  623:    template<typename T>
  624:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  625:       // Get the values of the field at the nodes of the element
  626:       res[0] = (sides[0]->*field)[level];
  627:       res[1] = (sides[1]->*field)[level];
  628:       res[2] = (sides[2]->*field)[level];
  629:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  630:       else          res[3] = T();
  631:    }    
  632: 
  633:    template<typename T>
  634:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  635:       // Get the values of the func at the nodes of the element
  636:       res[0] = (sides[0]->*func)(level);
  637:       res[1] = (sides[1]->*func)(level);
  638:       res[2] = (sides[2]->*func)(level);
  639:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  640:       else          res[3] = T();  // This is 0.0 or a zero vector
  641: 
  642:    }      
  643: 
  644: 
  645:    __device__ double interpolate(int level, const double shapeCoords[4], double (Node::*func)(int) const) const {
  646:       double values[4];
  647:       getNodalValues(level, func, values);
  648: 
  649:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  650:    }
  651: 
  652:    template<typename T>
  653:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  654:       T values[4];
  655:       getNodalValues(field, values);
  656:       
  657:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  658:    }
  659: 
  660: 
  661:    template<typename T>
  662:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  663:       T values[4];
  664:       getNodalValues(level, field, values);
  665: 
  666:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  667:    }
  668: 
  669:    template<typename T>
  670:    __device__ T mean(T Node::* field) const {
  671:       T values[4];
  672:       getNodalValues(field, values);
  673: 
  674:       return (values[0] + values[1] + values[2] + values[3])/i34;
  675:    }
  676: 
  677:    template<typename T>
  678:    __device__ T mean(T Side::* field) const {
  679:       T values[4];
  680:       getSideValues(field, values);
  681:       
  682:       return (values[0] + values[1] + values[2] + values[3])/i34;
  683:    }   
  684: 
  685:    // __device__ double mean(double (Node::*func)(int) const) const {
  686:    //    double values[4];
  687:    //    getNodalValues(level, func, values);
  688:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  689:    // }
  690:    // ------------------------------------------------------------------------------------------------
  691: 
  692:    __device__ bool globalToLocal(double xt, double yt, double &xlocal, double &ylocal) const {
  693:       // Convert global coordinates to local coordinates
  694:       printf("NOT IMPLEMENTED: globalToLocal\n");
  695:       return true;
  696:    }
  697: 
  698:    __inline__ __device__ bool localToGlobal(double xlocal, double ylocal, double &xt, double &yt) const {
  699:       // Convert local coordinates to global coordinates
  700:       printf("NOT IMPLEMENTED: localToGlobal\n");
  701:       return true;
  702:    }
  703: 
  704:    __device__ void trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
  705:                                        double &dt, Point3 &xt, double zint, Vector3 &u_int);
  706:     
  707:    __device__ bool trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
  708:                                                  Element *&nextElem, int &jlev, double &dt);
  709: 
  710: };
