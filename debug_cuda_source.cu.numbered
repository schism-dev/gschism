  933: 
  934:    __device__ Mesh(int partNum,
  935:                    int npgb, int negb, int nsgb, 
  936:                    int np, int ne, int ns, int nvrt, int kz,
  937:                    int max_np, int max_ne, int max_ns, int nseg,
  938:                    const Node **nodesPtr, const Element **elemsPtr, const Side **sidesPtr,
  939:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
  940:                    Node    **localNodeNeighNodesMem,
  941:                    Element **localNodeNeighElemsMem,
  942:                    NodeBoundary *localNodeBoundaryMem,
  943:                    SideBoundary *localSideBoundaryMem,
  944:                    BoundarySegment *localSegmentMem,
  945:                    double h_s, double theta_b, double theta_f, double *sigma_lcl, double *sigma, double *ztot,
  946:                    double *cs, double *dcs
  947:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
  948:                        np(np), ne(ne), ns(ns),
  949:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
  950:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
  951:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
  952:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
  953:                        localNodeBoundaryMem(localNodeBoundaryMem), localSideBoundaryMem(localSideBoundaryMem),
  954:                        localSegmentMem(localSegmentMem),
  955:                        h_s(h_s), theta_b(theta_b), theta_f(theta_f), sigma_lcl(sigma_lcl), sigma(sigma), ztot(ztot),
  956:                        cs(cs), dcs(dcs)
  957:    {
