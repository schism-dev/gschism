  911:    NodeBoundary *localNodeBoundaryMem; // Array of objects with the boundary information of each node
  912:    SideBoundary *localSideBoundaryMem; // Array of objects with the boundary information of each side
  913:    BoundarySegment *localSegmentMem;   // Array of objects with the boundary segments
  914:    
  915:    const int npgb;  // Global number of horizontal nodes
  916:    const int negb;  // Global number of elements
  917:    const int nsgb;  // Global number of sides
  918: 
  919:    const int np;   // Local number of horizontal nodes 
  920:    const int ne;   // Local number of elements
  921:    const int ns;   // Local number of sides
  922: 
  923:    const int max_np; // Maximum number of horizontal nodes per partition (shared by all partitions)
  924:    const int max_ne; // Maximum number of elements per partition (shared by all partitions)
  925:    const int max_ns; // Maximum number of sides per partition (shared by all partitions)
  926: 
  927:   
  928:    // Additional topology information
  929:    Node    **nodeNeighNodes; // Array of pointers to the nodes neighbors of each node
  930:    Element **nodeNeighElems; // Array of pointers to the elements neighbors of each node
  931: 
  932: 
  933: 
  934:    // Vertical coordinate system
  935:    // Sigma levels
  936:    double h_s; 
  937:    double h_c; 
  938:    int    kz;
  939:    double theta_b;
  940:    double theta_f, sinh_theta_f;
  941:    double *sigma_lcl;
  942:    double *sigma;
  943:    double *ztot;
  944:    double *cs;
  945:    double *dcs;
  946: 
  947:    // // Get's the pointer to the node using the array of global pointers to nodes
