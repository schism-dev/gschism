 4987: 
 4988: __global__ void computeMatrixProductAndDotProducts() {
 4989:    // Computes A*p, r'Mr and p'Ap
 4990: 
 4991:    // 1) shared buffer: first half for rMr, second for pAp
 4992:    __shared__ double sdata[2*BLOCK_SIZE];
 4993:    double* s_rMr = sdata;
 4994:    double* s_pAp = sdata + BLOCK_SIZE;
 4995: 
 4996:    // 2) get your node pointer
 4997:    NODE(node);  
 4998:    const int tid = threadIdx.x;
 4999: 
 5000:    const double diag = node->coeffDiag;
 5001:    const double r    = node->mR;
 5002:    const double p    = node->mP;  
 5003: 
 5004:    // apply preconditioner on the fly:
 5005:    const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 5006: 
 5007:    // 4) compute Ap = A.p
 5008:    double Ap = node->coeffDiag * node->mP;
 5009:    for (int j = 0; j < node->numNodes; ++j) {
 5010:       const Node *nbNode = node->nodes[j];
 5011:       Ap += node->coeffMatrix[j] * nbNode->mP;
 5012: 
 5013:    }
 5014:    node->mAp = Ap;
 5015:     
 5016: 
 5017:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 5018:    const double l_rMr = r*Mr;  // r'Mr
 5019:    const double l_pAp = p*Ap;  // p'Ap
 5020: 
 5021:    // 6) write into shared mem
 5022:    s_rMr[tid] = l_rMr;
 5023:    s_pAp[tid] = l_pAp;
 5024: 
 5025: 
 5026:    __syncthreads();
 5027: 
 5028:    // 7) block-wide tree reduction
 5029:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 5030:       if (tid < stride)  s_pAp[tid] += s_pAp[tid + stride];
 5031:       __syncthreads();
 5032:    }
 5033: 
 5034:    // 8) thread 0 atomically accumulates into the globals
 5035:    // XXX: This is slower than it needs to be, but it is simple and works
 5036:    if (tid == 0) atomicAdd(pAp, s_pAp[0]);
 5037: 
 5038: 
 5039: 
 5040: }
 5041: 
 5042: 
 5043: __global__ void updateSolutionAndDotProducts(void) {
 5044:     extern __shared__ double s_rMr[BLOCK_SIZE];       
 5045: 
 5046: 
 5047:     // get node & bounds-check:
 5048:     NODE(node);
 5049:     const int tid = threadIdx.x;
 5050: 
 5051: 
 5052:     // Compute alpha
 5053:     const double alpha = (*rMr_old)/(*pAp);
 5054: 
 5055:     // load scalars
 5056:     const double diag = node->coeffDiag;
 5057:     const double p    = node->mP;
 5058:     const double Ap   = node->mAp;
 5059:     const double x    = node->mX;
 5060:     const double r    = node->mR;
 5061:     
 5062:     assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 5063: 
 5064:     // 1) update solution & residual
 5065:     const double x_new = x + alpha*p;
 5066:     const double r_new = r - alpha*Ap;
 5067:     node->mX = x_new;
 5068:     node->mR = r_new;
 5069: 
 5070:     // 2) apply Jacobi preconditioner on the fly
 5071:     const double Mr_new = r_new/diag;
 5072: 
 5073: 
 5074:     // 3) local contributions for the two dot-products
 5075:     const double l_rMr = r_new*Mr_new;  // r'M^-1r
 5076: 
 5077:     // 4) write into shared-mem
 5078:     s_rMr[tid] = l_rMr;
 5079: 
 5080:     __syncthreads();
 5081: 
 5082: 
 5083:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 5084:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 5085:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 5086:         __syncthreads();
 5087:     }
 5088: 
 5089:     // 6) thread 0 atomically folds into the global accumulators
 5090:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 5091: 
 5092: 
 5093: }
 5094: 
 5095: 
 5096: __global__ void updateSearchDirection() {
 5097:     NODE(node);
 5098: 
 5099:     // recompute z on-the-fly
 5100:     const double z = node->mR / node->coeffDiag;
 5101:     const double p = node->mP;
 5102: 
 5103:     const double beta = (*rMr_new)/(*rMr_old);
 5104: 
 5105: // printf("ZZZ updateSearchDirection: beta = %f\n", beta);
 5106: 
 5107:     // p =z + beta*p
 5108:     node->mP = z + beta*p;
 5109: 
 5110: }
 5111: 
 5112: __global__ void initializePreconditionedResidual(double *scalars) {
 5113: 
 5114:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 5115: 
 5116:     NODE(node);
 5117:     const int tid = threadIdx.x;
 5118:     // For the first iteration:
 5119:     // 1. Initial solution x = 0 (already set)
 5120:     // 2. Initial residual r = b (stored in qel)
 5121:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 5122: 
 5123: // XXX we should use the guess solution here    
 5124: 
 5125:     // Set initial residual r = b (from qel)
 5126:     node->mR = node->qel;
 5127: 
 5128:     // Compute z = M^-1 * r (preconditioned residual)
 5129:     const double z = node->mR / node->coeffDiag;
 5130: 
 5131:     // Set initial search direction p = z
 5132:     node->mP = z;
 5133: 
 5134:     // Initialize other variables needed for CG
 5135:     node->mX = 0.0;  // Initial solution
 5136:     node->mAp = 0.0; // Will be computed in first iteration
 5137: 
 5138:     // These point to a cupy array in the host code
 5139:     rMr_old = scalars + 0;
 5140:     rMr_new = scalars + 1;
 5141:     pAp     = scalars + 2;
 5142: 
 5143:     // Computes the first r'Mr (reduction)
 5144:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 5145: 
 5146:     // 4) write into shared-mem
 5147:     s_rMr[tid] = l_rMr;
 5148: 
 5149:     __syncthreads();
 5150: 
 5151: 
 5152:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 5153:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 5154:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 5155:         __syncthreads();
 5156:     }
 5157: 
 5158:     // 6) thread 0 atomically folds into the global accumulators
 5159:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 5160: 
 5161:     *rMr_old = 0.0;
 5162:     *pAp = 0.0;
 5163: }
