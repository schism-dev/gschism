 2058: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2059:                 double *node_coords, double *wind_rotate_angle, 
 2060:                 int *isdel, int *isidenode, int *isbnd,
 2061:                 int *nond, int *nlnd, int *iond, int *ilnd,
 2062:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2063:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2064:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2065:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2066:                 int *localNodePart,     int *localElemPart,     int *localSidePart) {
 2067: 
 2068:    printf("Populating mesh for partition %d, %d, %d\n", partNum, nond, nlnd);
 2069: 
 2070:    printf("XXX elemsPtr = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2071: 
 2072:    // Horizontal grid
 2073:    printf("Processing %d nodes\n", np);    
 2074:    int idxNodeBoundary = 0;  
 2075:    for (int i = 0; i < np; i++)
 2076:    {
 2077:       Node &node = localNodeData[i];
 2078: 
 2079:       const int idxStart = nodeNeighNodesStart[i];
 2080:       const int idxEnd   = nodeNeighNodesStart[i+1];
 2081:       node.numNodes = idxEnd - idxStart;
 2082:       node.nodes = (Node **)(nodeNeighNodes + idxStart*sizeof(Node *));
 2083:       node.idx = i;
 2084: 
 2085:       // for (int idx = idxStart; idx < idxEnd; idx++) {
 2086:       //    int idxNode = nodeNeighNodesIndices[idx];
 2087:       //    Node *node_ptr = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 2088: 
 2089:       //    nodeNeighNodes[idxNode] = node_ptr;
 2090:       //    node.nodes = &(nodeNeighNodes[idxNode]);
 2091: 
 2092:       //    node_ptr->wind_angle = wind_rotate_angle[i];
 2093:       // }
 2094: 
 2095:       // Element **elements; // pointer to the elements connected to this node
 2096:       // int numElements;   // number of elements shared by this node
 2097: 
 2098:       node.p.x   = node_coords[i * 3];
 2099:       node.p.y   = node_coords[i * 3 + 1];
 2100:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2101:       node.depth = node_coords[i * 3 + 2];
 2102: 
 2103:       printf("ZZ elemsPtr = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2104: 
 2105:       // Links the node to the boundary information
 2106:       if (isbnd[i] >= 0) {
 2107:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2108:          if (isbnd[i]>0) {
 2109: 
 2110:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2111:             node.nodeBnd->segment->ifltype = isbnd[i];
 2112: 
 2113:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2114:             node.nodeBnd->segment->clen  = nan("1");
 2115:             node.nodeBnd->segment->carea = nan("1");
 2116: 
 2117:          }
 2118:          else {
 2119:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2120:          }
 2121:          
 2122:          idxNodeBoundary++;
 2123:       }
 2124:       else {
 2125:          node.nodeBnd = nullptr;
 2126:       }
 2127: 
 2128: // XXXX
 2129: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2130: constexpr double rot_per = 3000.0;
 2131: constexpr double rot_f = 2.0*pi/rot_per;
 2132: for (int k = 0; k < nvrt; k++) {node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0};}
 2133: // XXXXX
 2134:    }
 2135: 
 2136:    nbp = idxNodeBoundary;
 2137: 
 2138:    printf("YY elemsPtr = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2139:    printf("Processing %d sides\n", ns);
 2140:    int idxSideBoundary = 0;
 2141:    for (int i = 0; i < ns; i++)
 2142:    {
 2143:       Side &side = localSideData[i];
 2144:       side.idx = i;
 2145:       // finding the pointer to the nodes that form the side
 2146:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2147:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2148: 
 2149:       const int locidx_n1 = localNodeIndices[idx_n1];
 2150:       const int locidx_n2 = localNodeIndices[idx_n2];
 2151:       const int part_n1 =   localNodePart[idx_n1];
 2152:       const int part_n2 =   localNodePart[idx_n2];
 2153: 
 2154:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2155:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2156: 
 2157:       // Normal vector to the side
 2158:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2159:       const double norm = sqrt(dot(side.n, side.n));
 2160:       side.n = side.n/norm;
 2161: 
 2162:       // Side boundary type
 2163:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 2164:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 2165:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2166:       
 2167:       if (n1bnd != nullptr || n2bnd != nullptr) 
 2168:       {
 2169:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2170:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2171:          else                  side.sideBnd->segment = n2bnd->segment;
 2172:          side.sideBnd->side = &side;
 2173:          idxSideBoundary++;
 2174:       }
 2175:       else side.sideBnd = nullptr;
 2176: 
 2177:       // finding the pointer to the elements that share the side
 2178:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2179:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2180: 
 2181:       if (idx_e1 > -1) {
 2182:          const int locidx_e1 = localElemIndices[idx_e1];
 2183:          const int part_e1 =  localElemPart[idx_e1];
 2184:          side.elems[0] = elems[part_e1] + locidx_e1;
 2185:          printf("s@@ part_e1 = %d, locidx_e1 = %d, elems[part_e1] = %p\n", part_e1, locidx_e1, elems[part_e1]);
 2186:          // printf("s-- side.elems[0] = %p idx = %d i34 = %d (x,y,z) = (%f,%f,%f) size = %d\n", side.elems[0], side.elems[0]->idx, side.elems[0]->i34, side.elems[0]->center.x, side.elems[0]->center.y, side.elems[0]->center.z, sizeof(Element));
 2187:          printf("o-- elems = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2188:       }
 2189:       else {
 2190:          side.elems[0] = nullptr;
 2191:       }
 2192: 
 2193:       if (idx_e2 > -1) {
 2194:          const int locidx_e2 = localElemIndices[idx_e2];
 2195:          const int part_e2 =  localElemPart[idx_e2];
 2196:          side.elems[1] = elems[part_e2] + locidx_e2;
 2197:       }
 2198:       else {
 2199:          side.elems[1] = nullptr;
 2200:       }
 2201: 
 2202: 
 2203: 
 2204:       // Compute the center of the side
 2205:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2206: 
 2207: // XXXX
 2208: constexpr double rot_per=3000.0;
 2209: constexpr double rot_f=2.0*pi/rot_per;
 2210: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2211: // XXXXX      
 2212: 
 2213:       // Compute the z level at the center of the side
 2214:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->znl[k] + side.n2->znl[k]);
 2215: 
 2216:       // Compute the length of the side
 2217:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2218:       side.length = sqrt(dot(vLen, vLen));
 2219: 
 2220:    }
 2221: 
 2222:    printf("Processing %d elements\n", ne);
 2223:    for (int i = 0; i < ne; i++)
 2224:    {
 2225:       Element &elem = localElemData[i];
 2226:       elem.idx = i;
 2227:       for (int j = 0; j < i34[i]; j++) {
 2228:          const int idxNode = elnode[i*4 + j];  
 2229:          const int idxSide = elside[i*4 + j];
 2230:          
 2231:          elem.nodes[j] = (Node *)&(nodes[localElemPart[idxNode]][localElemIndices[idxNode]]);
 2232:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2233: 
 2234:          // Find the neighboring element  
 2235:          if (elem.sides[j]->elems[0] == &elem) {
 2236:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2237:          }
 2238:          else {
 2239:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2240:          }
 2241:       }
 2242: 
 2243:       
 2244: 
 2245:       elem.i34 = i34[i];
 2246: 
 2247: // printf("elem = %p, elem.i34 = %d\n", &elem, elem.i34);
 2248: 
 2249:       // Compute the centroid of the element and its depth
 2250:       Vector2 center = {0.0, 0.0};
 2251:       elem.depth = 0.0;
 2252:       for (int j = 0; j < i34[i]; j++) {
 2253:          center += elem.nodes[j]->p2()/i34[i];
 2254:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2255:       }
 2256:       elem.center.x = center.x;
 2257:       elem.center.y = center.y;
 2258: 
 2259:       printf("elem = %p, i34 = %d, center = (%f,%f,%f)\n", &elem, elem.i34, elem.center.x, elem.center.y, elem.depth);
 2260:       
 2261:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2262:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2263: 
 2264:       elem.area = elem.computeSignedArea(); 
 2265:       elem.radius = sqrt(elem.area)/pi; 
 2266:       
 2267:       // Determines which way the normal vector to each side is oriented.
 2268:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2269:       for (int j = 0; j < i34[i]; j++)  
 2270:       {
 2271:          if (elem.sides[j]->elems[0] == &elem) {
 2272:             elem.ssign[j] =  1.0;
 2273:          }
 2274:          else {
 2275:             elem.ssign[j] = -1.0;
 2276:          }
 2277: 
 2278:       }
 2279: 
 2280:       // Derivatives of shape functions
 2281:       //  For ics=2, this is done inside element/ll frame XXX
 2282:       //  For quads, the derivative is evaluated at centroid
 2283:       const int i34 = elem.i34;
 2284:       for (int j = 0; j < i34; j++) {
 2285:          const double area = elem.area;
 2286:          const int id2 = elem.nxq(1 + j);
 2287:          const int id3 = elem.nxq(2 + j);
 2288:          const int id4 = elem.nxq(3 + j);
 2289:          if (elem.isTri()) {
 2290:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2291:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2292:             // da1/dx = (y1 - y2)/(2*area)
 2293:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2294:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2295:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2296:          }
 2297:          else  { // Quad; evaluate at centroid
 2298:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2299:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2300:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2301:          } // if Tri
 2302: 
 2303:       } // for j
 2304: 
 2305:    }
 2306: 
 2307: 
 2308: 
 2309:    
 2310: }
