 3147:    __global__ void scaleGravity(double loadtide_coef) {
 3148: 
 3149: 
 3150:       NODE(node);
 3151: 
 3152:       // SAL option: scale gravity
 3153:       if constexpr(iloadtide==2) {  // simple const
 3154:          node->grav2 = grav*(1.0 - loadtide_coef);
 3155: 
 3156:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3157:         
 3158:           const double depth = max(node->depth, 0.0);
 3159:           const double tmp1 = sqrt(depth);
 3160:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3161:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3162:                              2.6969e-13*depth*depth*depth*tmp1;
 3163:           
 3164:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3165:           
 3166: 
 3167: 
 3168:           node->grav2 = grav*(1.0 - beta_bar);
 3169: 
 3170:       } else {  // iloadtide=0,1
 3171:         node->grav2=grav;
 3172: 
 3173:       }
 3174: 
 3175:       printf("scaleGravity: node(%d)->grav2 = %f\n", node->idx, node->grav2);
 3176:    }
