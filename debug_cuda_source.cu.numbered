  499:    __device__ bool globalToLocal(double xt, double yt, double &xlocal, double &ylocal) const {
  500:       // Convert global coordinates to local coordinates
  501:       printf("NOT IMPLEMENTED: globalToLocal\n");
  502:       return true;
