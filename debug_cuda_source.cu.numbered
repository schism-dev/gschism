 1078: /**
 1079:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1080:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1081:    If the segment is completely inside the element, then it returns true.
 1082: 
 1083:    This function assumes:
 1084:    - The initial point is on a side of the element. 
 1085:    - Its position is given by parameter t in the range [0,1].
 1086:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1087:       intersects the element (elements are convex).
 1088: 
 1089:    To find the intersection point, this function does the following:
 1090:    - it finds the intersection of the line segment with all the element side lines,
 1091:       except for the one that contains the initial point.
 1092:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1093:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1094:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1095:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1096:       track segment is almost parallel to the element side line.
 1097: 
 1098:    Inputs:
 1099:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1100:    @param x2, y2: other end of the line segment
 1101: 
 1102:    Outputs:
 1103:    @param side:  side that intersects the line segment (input and output)
 1104:    @param nextElement (output): element that contains the intersection point
 1105:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1106:    @param zint (input/output): Vertical coordinate of the intersection point
 1107: 
 1108:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1109:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1110:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1111: 
 1112:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1113:    (Delta) being zero.
 1114: 
 1115:    The intersection2 point happens when:
 1116:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1117:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1118:    
 1119:    Assumption: the 4 points (including those of the side segment) are different.
 1120:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1121:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1122:    If true, (xIntersect,yIntersect) is the intersection.				
 1123:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1124: **/
 1125: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1126:                                               double &t, double& tIntersect) {
 1127: 
 1128:    double closest_intersect_t = 1e10;
 1129:    bool found_intersection = false;
 1130: 
 1131:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1132:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1133:    const Point2 x1 = side->point(t);
 1134:    
 1135: 
 1136:    Side *nextSide = nullptr;
 1137: 
 1138:    for (int i = 0; i < i34; i++) {
 1139: 
 1140:       // Element's i-th side 
 1141:       Side *side2 = sides[i];
 1142: 
 1143:       // Skip the side that contains the initial point
 1144:       if (side2 == side) continue;
 1145: 
 1146:       // (x3,y3)-(x4,y4) is the element side line
 1147:       const Point2 x3 = side2->n1->p2();
 1148:       const Point2 x4 = side2->n2->p2();
 1149: 
 1150:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1151:       const double delta = cross(x2 - x1, x3 - x4);
 1152: 
 1153:       if (delta != 0.0) {
 1154: 
 1155:          const double delta1 = cross(x3 - x1, x3 - x4);
 1156:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1157: 
 1158:          // Solves the two linear equations for tt1 and tt2
 1159:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1160:          const double tt2 = delta2/delta;
 1161: 
 1162:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1163:             closest_intersect_t = min(closest_intersect_t, tt1);
 1164:             nextSide = side2;
 1165: 
 1166:             nextElement = nextSide->otherElem(this);
 1167:             tIntersect = max(small, min(tt1, 1.0-small));
 1168:             t = tt2;
 1169: 
 1170:             found_intersection = true;
 1171:          }
 1172:       
 1173:       }
 1174: 
 1175:    }
 1176: 
 1177: 
 1178:    // found_intersection should always be true, since we checked all the sides.  
 1179:    side = nextSide;
 1180: // if (found_intersection) {
 1181: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1182: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1183: // }   
 1184:    return found_intersection;
 1185: }
 1186: 
 1187: 
 1188: 
 1189: 
 1190: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1191:                                               double &t, double& tIntersect) {
 1192: 
 1193:    double closest_intersect_t = 1e10;
 1194:    bool found_intersection = false;
 1195: 
 1196:    for (int i = 0; i < i34; i++) {
 1197: 
 1198:       Side *side2 = sides[i];
 1199: 
 1200:       // (x3,y3)-(x4,y4) is the element side line
 1201:       const Point2 x3 = side2->n1->p2();
 1202:       const Point2 x4 = side2->n2->p2();
 1203: 
 1204:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1205:       const double delta = cross(x2 - x1, x3 - x4);
 1206: 
 1207:       if (delta != 0.0) {
 1208: 
 1209:          const double delta1 = cross(x3 - x1, x3 - x4);
 1210:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1211: 
 1212:          // Solves the two linear equations for tt1 and tt2
 1213:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1214:          const double tt2 = delta2/delta;
 1215: 
 1216:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1217:             closest_intersect_t = min(closest_intersect_t, tt1);
 1218:             side = side2;
 1219:             nextElement = side->otherElem(this);
 1220:             t = tt2;
 1221:             tIntersect = max(small, min(tt1, 1.0-small));
 1222:             found_intersection = true;
 1223:          }
 1224:       
 1225:       }
 1226: 
 1227:    }
 1228: 
 1229: // if (found_intersection) {
 1230: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1231: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1232: // }
 1233: 
 1234:    // found_intersection should always be true, since we checked all the sides.  
 1235:    return found_intersection;
 1236: }
 1237: 
 1238: 
 1239: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1240:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1241: 
 1242:    printf("Tracking segment goes out of water at element %d\n", curElem->idx);
 1243: 
 1244:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1245:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1246:    // curElement.
 1247: 
 1248:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1249:    // And uses this velocity instead to continue the tracking.
 1250: 
 1251:    // computes the intersection point in cartesian coordinates
 1252:    Point2 intersection = nextSide->p_t(tt);
 1253: 
 1254:    // Nudges the point to the barycenter of the element. 
 1255:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1256:    // next segment intersects the element sides.  
 1257:    curElem->nudgeToBarycenter(intersection);
 1258: 
 1259:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1260:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1261:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1262:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1263: 
 1264:    // If the side is an open boundary, the tangential velocity is zero.
 1265:    if (nextSide->isBnd()) vtan = 0.0;
 1266: 
 1267:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1268:    const double us = vtan*nextSide->t().x;
 1269:    const double vs = vtan*nextSide->t().y;
 1270:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1271: 
 1272:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1273:    const double len2 = length(intersection - toPoint2(xt));
 1274:    const double vel2 = u_int.x*u_int.x + u_int.y*u_int.y;        
 1275:    assert(vel2 > 0.0 && "Zero velocity found");
 1276:    dt = dt - sqrt(len2/vel2); 
 1277: 
 1278:    // The end of this tracking segment is now the intersection point.
 1279:    xt = {intersection.x, intersection.y, zint};
 1280:    
 1281:    u_int = {us, vs, ws};
 1282:    
 1283: }
 1284: 
 1285: /**
 1286:  * Tracks a particle through elements and vertical levels in the mesh.
 1287:  * 
 1288:  * @param x0,y0,z0     Starting position coordinates
 1289:  * @param xt,yt,zt     Target position coordinates
 1290:  * @param dtb          Time step for tracking
 1291:  * @param uuint,vvint,wwint Initial velocity components
 1292:  * @param nextElem     Starting/resulting element index
 1293:  * 
 1294:  * @return Status code of type trackExitCodes
 1295:  * 
 1296:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1297:  * of the details are different. The idea is that the code requires less branches and is better fit
 1298:  * for GPU execution.
 1299:  * 
 1300:  * The main ideas here are:
 1301:  * - The starting point is expected to be in the starting element.
 1302:  * - The end point is guaranteed to be inside an element.
 1303:  * - since the starting point is inside the element, there are only two cases: 
 1304:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1305:  *     (b) it does not and (xt,yt) is already in the starting element.
 1306:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1307:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1308:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1309:  * - tt1 can be positive or negative. We only consider the positive values.
 1310:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1311:  * - The next intersection will occur at the smallest positive tt1.
 1312:  * - This intersection will be the next (x0,y0) position.
 1313:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1314:  *   of getting stuck in a loop.
 1315:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1316:  *   was found.
 1317:  */
 1318: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1319:                                                        Element *&nextElem, int &jlev, double &dt) {
 1320: // printf("trackThroughElementsAndLevels: x0=%f, y0=%f, xt=%f, yt=%f\n", x0, y0, xt, yt);
 1321:    // First thing is to check if the target point is inside the element. If it is there is nothing
 1322:    // else to do.
 1323:    if (containsPoint(toPoint2(xt))) {
 1324:       nextElem->interpolateVelocities(xt, u_int);
 1325:       return true;
 1326:    }
 1327: 
 1328:    Side *side = nullptr;
 1329: 
 1330:    // 1. Initial checks
 1331:    // Verify starting element is valid (wet)
 1332:    assert(!nextElem->idry && "Starting element is dry");
 1333: 
 1334:    // Checks if track has a zero length.
 1335:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1336:    assert(len2 > 0.0 && "Zero length track"); 
 1337:    
 1338: 
 1339:    const int MAX_ITERATIONS = 1000;
 1340:    
 1341:    double t;
 1342:    Side *nextSide = nullptr;
 1343:    double tIntersect = 1e10;
 1344:    double zint = x0.z;
 1345: 
 1346:    // Horizontal tracking loop
 1347:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1348:    // (x0,y0) is inside the element but the target point is not.
 1349:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1350:    assert(found_intersection && "No intersection found");
 1351: 
 1352:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1353: 
 1354:    // if the tracking segment goes out of water (either dry or edge boundary)
 1355:    if (isEdgeBoundary(nextSide) || (nextElem->idry)) {
 1356:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1357:       nextElem = this;
 1358:       
 1359:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1360:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1361:       return true;    
 1362:       }
 1363: 
 1364:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1365:    int iterations = 0;
 1366:    while (iterations < MAX_ITERATIONS) {
 1367:       iterations++;
 1368:       
 1369:       Element *curElem = nextElem;
 1370: 
 1371:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1372:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1373: 
 1374:       // If we are already in the target element, we are done.
 1375:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1376:       if (!found_intersection) break;
 1377: 
 1378: 
 1379:   
 1380:       // if the tracking segment goes out of water (either dry or edge boundary).
 1381:       if (curElem->isEdgeBoundary(nextSide) || (nextElem->idry)) {
 1382: 
 1383:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1384: 
 1385:          nextElem = curElem;
 1386: 
 1387:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1388:          // In this case, the caller (btrack) needs to take into account the remaining time.
 1389:          return true;
 1390:       }
 1391:       
 1392:       // Update position and element for next iteration
 1393:       side = nextSide;
 1394: 
 1395:    }
 1396: 
 1397: 
 1398:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 1399: 
 1400:  
 1401:    // Interpolate velocities at the final position. This is a conceptually simple step,
 1402:    // but the function is not simple, because it has to search for the vertical level containing zt.
 1403:    nextElem->interpolateVelocities(xt, u_int);
 1404: 
 1405: 
 1406:    return true;
 1407: }
 1408: 
 1409: 
 1410: 
 1411: 
 1412: __inline__ __device__ double Element::computeSignedArea(void) const {
 1413:    // Compute the area of the element
 1414: 
 1415:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 1416: 
 1417:    // In the quad case we need to add the area of the other triangle.
 1418:    if (isQuad()) {
 1419:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1420:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 1421:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1422:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 1423:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 1424:          Error("Negative area found in quad element");
 1425:       }
 1426:       res += ar1;
 1427:    }
 1428: 
 1429:    return res;
 1430: }
 1431: 
 1432: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 1433:    // In boundary sides, the element 1 is nullptr
 1434:    return side->elems[1] == nullptr; 
 1435: }
 1436: 
 1437: /**
 1438:    Compute the shape coordinates of the point (xt,yt) in the element.
 1439:    @param xt (input): x-coordinate of the point
 1440:    @param shpCoords (output): shape coordinates of the point
 1441:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 1442:    @return true if the point is inside the element, false otherwise
 1443: **/
 1444: __device__ bool Element::computeShapeCoords(Point2 xt, double shpCoords[4],
 1445:                                             bool fixNegshpCoord) const {
 1446: 
 1447:    // Compute the shape coordinates of the point xt in the element.
 1448:    if (i34==3) {
 1449:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 1450:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 1451:       // and in this case, the pt will be nudged into the element
 1452:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 1453:       // from the local frame, so use additional check.
 1454: 
 1455:       Point2 x0, x1, x2;
 1456: 
 1457:       if constexpr(ics==1) {
 1458:          x0 = nodes[0]->p2();
 1459:          x1 = nodes[1]->p2();
 1460:          x2 = nodes[2]->p2();
 1461:       }
 1462:       else // lat/lon
 1463:       {
 1464:          Error("Not implemented yet");
 1465: #ifdef ICS2
 1466:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 1467:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 1468:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 1469: #endif
 1470:       }
 1471: 
 1472:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 1473:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 1474:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 1475:       shpCoords[3] = 0.0;
 1476:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 1477: 
 1478:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 1479:       // then we fix the negative shape coordinates.
 1480:       if (fixNegshpCoord && tmpmin<=0.0) {
 1481: 
 1482:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 1483:          // keeping the sum of the shape coordinates equal to 1.
 1484:          // I have tested and compared the new algorithm with the old one, and they give
 1485:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 1486:          // The new algorithm should be faster since it is branchless.
 1487:          const double a = - tmpmin + 1.0e-2;  // XXX it used to be 1.0e-4 in the comments of the original code
 1488:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 1489:          
 1490:          shpCoords[0] = (shpCoords[0] + a)*b;
 1491:          shpCoords[1] = (shpCoords[1] + a)*b;
 1492:          shpCoords[2] = (shpCoords[2] + a)*b;          
 1493: 
 1494:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 1495:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 1496:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 1497:          }
 1498: 
 1499:          // Update the point coordinates for the new shape coordinates
 1500:          double xcoords[3] = {x0.x, x1.x, x2.x};
 1501:          double ycoords[3] = {x0.y, x1.y, x2.y};
 1502:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 1503: 
 1504:       }
 1505: 
 1506:       // Check if the point is inside the element
 1507:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 1508:    }
 1509:    else {
 1510:       Error("Not implemented yet");
 1511: #ifdef QUADS
 1512:       // Reproject pt in eframe of nel for ics=2
 1513:       if constexpr(ics==1) {
 1514:          xn2 = xt; 
 1515:          yn2 = yt;
 1516:       }
 1517:       else {
 1518:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 1519:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 1520:       }
 1521: 
 1522:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 1523: #endif
 1524:    }
 1525: 
 1526: }
 1527: 
 1528: 
 1529: /**  Interpolate velocities at a given point (xt,yt,zt)
 1530: 
 1531:    @param xt, yt, zt: coordinates of the point to interpolate
 1532:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 1533: 
 1534:    This is done in four steps:
 1535: 
 1536:    1. Find the shape coordinates for the final position in the element.
 1537:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 1538:    3. Perform a *binary search* to find the vertical level containing zt. It will have to interpolate the 
 1539:       z levels at xt, yt at each step.   
 1540:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 1541:       horizontally and vertically.
 1542: **/
 1543: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) {
 1544:    // Interpolate the velocities at the point xt. 
 1545:    // This function works the same for triangular and quadrilateral elements.
 1546:    double shpCoord[4];
 1547: 
 1548: 
 1549:    // First step is to compute the shape coordinates of (xt,yt)
 1550:    computeShapeCoords(toVector2(xt), shpCoord, false);
 1551:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 1552: 
 1553:    // Second step is to find the level that contains zt
 1554:    // Uses a binary search to find the level
 1555:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 1556:    int L = kbe;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 1557:    int R = nvrt - 1;
 1558: 
 1559:    // Get the z coordinates at the nodes of the element at the levels L and R
 1560:    double zLAtNodes[4], zRAtNodes[4];
 1561:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 1562:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 1563: 
 1564:    double zL = interpolate(shpCoord, zLAtNodes);
 1565:    double zR = interpolate(shpCoord, zRAtNodes);
 1566:    
 1567:    // Interpolates vertically the velocities
 1568:    double wght1, wght2;
 1569:    if (xt.z<=zL) {
 1570:       wght1 = 1.0;
 1571:       wght2 = 0.0;
 1572:    }
 1573:    else if (xt.z>=zR) {
 1574:       wght1 = 0.0;
 1575:       wght2 = 1.0;
 1576:    }
 1577:    else {
 1578:       // Perform a binary search to find the levels between L and R that contain xt.z
 1579:       while (R - L > 1) {
 1580:          int M = (L + R) / 2;
 1581: 
 1582:          double zMAtNodes[4];
 1583:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 1584:          double zM = interpolate(shpCoord, zMAtNodes);
 1585:          if (zM < xt.z) 
 1586:          {
 1587:             L = M;
 1588:             zL = zM;
 1589:          }
 1590:          else 
 1591:          {
 1592:             R = M;
 1593:             zR = zM;
 1594:          }
 1595:       }
 1596:       assert(L == R-1);
 1597:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 1598: 
 1599:       wght2 = (xt.z - zL)/(zR - zL);
 1600:       wght1 = 1.0 - wght2;
 1601:    }
 1602: // printf("$$$ wght1 = %f, wght2 = %f, zt = %f, zL = %f, zR = %f\n", wght1, wght2, zt, zL, zR);
 1603: // printf("$$$ shpCoord = %f, %f, %f, %f\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 1604:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 1605:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 1606: 
 1607:    // Neither of the interpolated velocities should be NaN
 1608:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 1609: 
 1610: }
