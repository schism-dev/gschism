  779: // This struct is used to store the boundary information for a node.
  780: struct NodeBoundary {   
  781:    BoundarySegment *segment;
  782:    Node *node;
  783:    
  784:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
  785:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
  786: 
  787:    double etaic;  // Elevation at nodes used for essential boundary conditions
  788:    double elbc;   // Elevation boundary condition
  789:    int iettype;   // Type of elevation boundary condition
  790:    double eth;    // Elevation time history
  791: 
  792:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
  793:       assert(index == 0 || index == 1); 
  794:       return (index == 0) ? sideBnd1 : sideBnd2; 
  795:    }
  796: };
