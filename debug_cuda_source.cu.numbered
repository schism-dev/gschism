  504: 
  505:    __inline__ __device__ bool localToGlobal(double xlocal, double ylocal, double &xt, double &yt) const {
  506:       // Convert local coordinates to global coordinates
  507:       printf("NOT IMPLEMENTED: localToGlobal\n");
  508:       return true;
