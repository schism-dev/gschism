 1268:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1269:       // Compute the different time ramps used in the code 
 1270:       // This function is performed by just one thread
 1271: 
 1272:       if constexpr(ibc == 0) {
 1273:          if (drampbc > 0.0) {
 1274:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1275:          } else {
 1276:             rampbc = 1.0;
 1277:          }
 1278: 
 1279:          if (nws != 0 && drampwind > 0.0) {
 1280:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1281:          } else {
 1282:             rampwind = 1.0;
 1283:          }
 1284:       }
 1285: 
 1286:       if (drampwafo > 0.0) {
 1287:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1288:       } else {
 1289:          rampwafo = 1.0;
 1290:       }
 1291: 
 1292:       // For source/sinks
 1293:       if (if_source && dramp_ss > 0.0) {
 1294:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1295:       } else {
 1296:          ramp_ss = 1.0;
 1297:       }
 1298: 
 1299:       if (dramp > 0.0) {
 1300:          ramp = tanh(2.0*time/86400.0/dramp);
 1301:       } else {
 1302:          ramp = 1.0;
 1303:       }
 1304: 
 1305:       printf("computeTimeRamps: i = %d, time = %f, nws = %d, if_source = %d, ramp = %f, drampbc = %f, drampwind = %f, drampwafo = %f, dramp_ss = %f, dramp = %f\n", 
 1306:              threadIdx.x + blockIdx.x * blockDim.x, time, nws, if_source, ramp, drampbc, drampwind, drampwafo, dramp_ss, dramp);
 1307:    }
