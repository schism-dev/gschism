  986:    // }
  987: 
  988:    // // Get's the pointer to the side using the array of global pointers to sides
  989:    // __device__ const Side *getGlobalSide(int js) {
  990:    //    const int idx = js / max_ns; // Get the index of the partition that contains the side
  991:    //    return sides[idx] + idx;
  992:    // }
  993: 
  994:    // // Get's the global index of local node idx
  995:    // __device__ int getGlobalNodeIndex(int idx) {
  996:    //    return idx + partNum * max_np;
  997:    // }
  998: 
  999:    // // Get's the global index of local element idx
 1000:    // __device__ int getGlobalElemIndex(int idx) {
 1001:    //    return idx + partNum * max_ne;
 1002:    // }
 1003: 
 1004:    // // Get's the global index of local side idx
 1005:    // __device__ int getGlobalSideIndex(int idx) {
 1006:    //    return idx + partNum * max_ns;
 1007:    // }  
 1008: 
 1009:    __device__ Mesh(int partNum,
 1010:                    int npgb, int negb, int nsgb, 
 1011:                    int np, int ne, int ns, int nvrt, int kz,
 1012:                    int max_np, int max_ne, int max_ns, int nseg,
 1013:                    const Node **nodesPtr, const Element **elemsPtr, const Side **sidesPtr,
 1014:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 1015:                    Node    **localNodeNeighNodesMem,
 1016:                    Element **localNodeNeighElemsMem,
 1017:                    NodeBoundary *localNodeBoundaryMem,
 1018:                    SideBoundary *localSideBoundaryMem,
 1019:                    BoundarySegment *localSegmentMem,
 1020:                    double h_s, double theta_b, double theta_f, double *sigma_lcl, double *sigma, double *ztot,
 1021:                    double *cs, double *dcs
 1022:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 1023:                        np(np), ne(ne), ns(ns),
 1024:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
 1025:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
 1026:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
 1027:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
 1028:                        localNodeBoundaryMem(localNodeBoundaryMem), localSideBoundaryMem(localSideBoundaryMem),
 1029:                        localSegmentMem(localSegmentMem),
 1030:                        h_s(h_s), theta_b(theta_b), theta_f(theta_f), sigma_lcl(sigma_lcl), sigma(sigma), ztot(ztot),
 1031:                        cs(cs), dcs(dcs)
 1032:    {
