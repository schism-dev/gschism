 5143: __global__ void printMatrix(void) {
 5144: 
 5145: 
 5146:    // Let only one thread per block print at a time 
 5147: 
 5148:    if (threadIdx.x == 0) {
 5149:       for (int ithread = 0; ithread < blockDim.x; ithread++) {
 5150:          const int idx_node = ithread + blockIdx.x * blockDim.x;
 5151:          if (idx_node >= mesh->np) return;
 5152:          const Node *node = mesh->localNodeData + idx_node;
 5153:          printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 5154:          for (int j = 0; j < node->numNodes; j++) {
 5155:             Node* nbNode = node->nodes[j];
 5156:             if (node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 5157:          }
 5158:          printf("]\n");
 5159: 
 5160:       }
 5161:    }
 5162: 
 5163: 
 5164: 
 5165: }
 5166: 
 5167: 
 5168: __global__ void computeMatrixProductAndDotProducts() {
 5169:    // Computes A*p, r'Mr and p'Ap
 5170: 
 5171:    // 1) shared buffer: first half for rMr, second for pAp
 5172:    __shared__ double sdata[2*BLOCK_SIZE];
 5173:    double* s_rMr = sdata;
 5174:    double* s_pAp = sdata + BLOCK_SIZE;
 5175: 
 5176:    s_rMr[threadIdx.x] = 0.0;
 5177:    s_pAp[threadIdx.x] = 0.0;
 5178: 
 5179:    // 2) get your node pointer
 5180:    NODE(node);  
 5181:    const int tid = threadIdx.x;
 5182: 
 5183:    const double diag = node->coeffDiag;
 5184:    const double r    = node->mR;
 5185:    const double p    = node->mP;  
 5186: 
 5187:    // apply preconditioner on the fly:
 5188:    const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 5189: 
 5190:    // 4) compute Ap = A.p
 5191:    double Ap = node->coeffDiag * node->mP;
 5192:    for (int j = 0; j < node->numNodes; ++j) {
 5193:       const Node *nbNode = node->nodes[j];
 5194:       Ap += node->coeffMatrix[j] * nbNode->mP;
 5195: 
 5196:    }
 5197:    node->mAp = Ap;
 5198:     
 5199: 
 5200:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 5201:    const double l_rMr = r*Mr;  // r'Mr
 5202:    const double l_pAp = p*Ap;  // p'Ap
 5203: 
 5204:    // 6) write into shared mem
 5205:    s_rMr[tid] = l_rMr;
 5206:    s_pAp[tid] = l_pAp;
 5207: 
 5208:    __syncthreads();
 5209: 
 5210:    // 7) block-wide tree reduction
 5211:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 5212:       if (tid < stride)  s_pAp[tid] += s_pAp[tid + stride];
 5213:       __syncthreads();
 5214:    }
 5215: 
 5216:    // 8) thread 0 atomically accumulates into the globals
 5217:    // XXX: This is slower than it needs to be, but it is simple and works
 5218:    if (tid == 0) atomicAdd(pAp, s_pAp[0]);
 5219: 
 5220: 
 5221: }
 5222: 
 5223: 
 5224: __global__ void updateSolutionAndDotProducts(void) {
 5225:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 5226: 
 5227:    s_rMr[threadIdx.x] = 0.0;
 5228: 
 5229: 
 5230:    // get node & bounds-check:
 5231:    NODE(node);
 5232:    const int tid = threadIdx.x;
 5233: 
 5234: 
 5235:    // Compute alpha
 5236:    const double alpha = (*rMr_old)/(*pAp);
 5237: 
 5238:    // load scalars
 5239:    const double diag = node->coeffDiag;
 5240:    const double p    = node->mP;
 5241:    const double Ap   = node->mAp;
 5242:    const double x    = node->mX;
 5243:    const double r    = node->mR;
 5244:    
 5245:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 5246: 
 5247:    // 1) update solution & residual
 5248:    const double x_new = x + alpha*p;
 5249:    const double r_new = r - alpha*Ap;
 5250:    node->mX = x_new;
 5251:    node->mR = r_new;
 5252: 
 5253:    // 2) apply Jacobi preconditioner on the fly
 5254:    const double Mr_new = r_new/diag;
 5255: 
 5256: 
 5257:    // 3) local contributions for the two dot-products
 5258:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 5259: 
 5260:    // 4) write into shared-mem
 5261:    s_rMr[tid] = l_rMr;
 5262: 
 5263:    __syncthreads();
 5264: 
 5265: 
 5266:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 5267:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 5268:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 5269:       __syncthreads();
 5270:    }
 5271: 
 5272:    // 6) thread 0 atomically folds into the global accumulators
 5273:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 5274: 
 5275: 
 5276: }
 5277: 
 5278: 
 5279: __global__ void updateSearchDirection() {
 5280:     NODE(node);
 5281: 
 5282:     // recompute z on-the-fly
 5283:     const double z = node->mR / node->coeffDiag;
 5284:     const double p = node->mP;
 5285: 
 5286:     const double beta = (*rMr_new)/(*rMr_old);
 5287: 
 5288: // printf("ZZZ updateSearchDirection: beta = %f\n", beta);
 5289: 
 5290:     // p =z + beta*p
 5291:     node->mP = z + beta*p;
 5292: 
 5293: }
 5294: 
 5295: __global__ void initializePreconditionedResidual(double *scalars) {
 5296: 
 5297:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 5298: 
 5299:     s_rMr[threadIdx.x] = 0.0;
 5300: 
 5301:     NODE(node);
 5302:     const int tid = threadIdx.x;
 5303:     // For the first iteration:
 5304:     // 1. Initial solution x = 0 (already set)
 5305:     // 2. Initial residual r = b (stored in qel)
 5306:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 5307: 
 5308: // XXX we should use the guess solution here    
 5309: 
 5310:     // Set initial residual r = b (from qel)
 5311:     node->mR = node->qel;
 5312: 
 5313:     // Compute z = M^-1 * r (preconditioned residual)
 5314:     const double z = node->mR / node->coeffDiag;
 5315: 
 5316:     // Set initial search direction p = z
 5317:     node->mP = z;
 5318: 
 5319:     // Initialize other variables needed for CG
 5320:     node->mX = 0.0;  // Initial solution
 5321:     node->mAp = 0.0; // Will be computed in first iteration
 5322: 
 5323:     // These point to a cupy array in the host code
 5324:     rMr_old = scalars + 0;
 5325:     rMr_new = scalars + 1;
 5326:     pAp     = scalars + 2;
 5327: 
 5328:     // Computes the first r'Mr (reduction)
 5329:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 5330: 
 5331:     // 4) write into shared-mem
 5332:     s_rMr[tid] = l_rMr;
 5333: 
 5334:     __syncthreads();
 5335: 
 5336: 
 5337:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 5338:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 5339:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 5340:         __syncthreads();
 5341:     }
 5342: 
 5343:     // 6) thread 0 atomically folds into the global accumulators
 5344:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 5345: 
 5346:     *rMr_old = 0.0;
 5347:     *pAp = 0.0;
 5348: }
