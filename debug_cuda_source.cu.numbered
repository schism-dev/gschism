 1613: 
 1614: __inline__ __device__ double Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 1615: __inline__ __device__ double Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 1616: __inline__ __device__ Point2 Side::p_t(double t) const { return {x(t), y(t)}; }
 1617: __inline__ __device__ int    Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 1618: __inline__ __device__ double Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 1619: 
 1620: __inline__ __device__ double Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 1621: __inline__ __device__ double Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 1622: __inline__ __device__ double Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 1623: 
 1624: 
 1625: __inline__ __device__ double Side::Cd(void)      const { if constexpr(nchi != 0) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 1626: 
 1627: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 1628: 
 1629: /**
 1630:  * This method performs backtracking from the side center until a time -dt back in time 
 1631:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 1632:  * intermediate point.
 1633:  *
 1634:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 1635:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 1636:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 1637:  * remaining time.
 1638:  * 
 1639:  * NOTE: Runge-Kutta is not implemented yet. XXX
 1640:  * 
 1641:  * @param uuint, vvint, wwint: Velocities at the final point
 1642:  * @param jlev: Level at which the backtracking is performed
 1643:  * @param dt, dtbk: Tracking timesteps
 1644:  * @param sclr: Array for backtracked values
 1645:  * @return: True if the backtracking was successful, false otherwise
 1646:  */
 1647: __inline__ __device__ bool Side::btrack(
 1648:       int jlev,
 1649:       double dt,            // Tracking time
 1650:       double dtbk,          // Tracking timestep
 1651:       double* sclr,         // Array for backtracked values
 1652:       Vector3 &u_int
 1653: ) const {
 1654: 
 1655:    // Start from side center
 1656:    Point3 x0 = {center.x, center.y, zc[jlev]};
 1657:  
 1658: 
 1659:    double time_rm = dt; // Remaining time
 1660: 
 1661: 
 1662:    // // Initialize outputs
 1663:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 1664:    //    sclr[i] = 0.0;
 1665:    // }
 1666: 
 1667: 
 1668:    // Initial velocities
 1669:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 1670: 
 1671:    // Find the element that is in the direction opposite to the velocity
 1672:    Element* curElem = findElementTowards({u_int.x, u_int.y});
 1673: 
 1674: printf("$$$  %d, %d, %.5f, %.5f\n",  curElem->idx,idx, x0.x, x0.y)   ;
 1675:    const int MAX_ITERATIONS = 100000; // XXX 1000
 1676:    Element* nextElem = curElem;
 1677:    int iter = 0;
 1678:    while(true) {
 1679:       // Calculate timestep
 1680:       double dtb = min(dtbk, time_rm);
 1681: 
 1682:       // Next point in the backtracking curve
 1683:       Point3 xt = x0 - dtb*u_int;
 1684: 
 1685:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb);
 1686:       assert(found && "Backtracking failed in btrack");
 1687: // printf("<>T = %f, %f %f %f\n", time_rm - dtb, xt, yt, zt);
 1688:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 1689:                       // then time_rm needs to be increased by the unused time.
 1690: 
 1691: 
 1692:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 1693: 
 1694:       // The current point becomes the next segment's starting point.
 1695:       x0 = xt;
 1696:  
 1697:       curElem = nextElem;
 1698: 
 1699:       iter++;
 1700:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 1701:    }
 1702: 
 1703: 
 1704: }
