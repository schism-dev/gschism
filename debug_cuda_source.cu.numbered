 1528: 
 1529: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1530:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1531: 
 1532:    printf("Tracking segment goes out of water at element %d\n", curElem->idx);
 1533:    
 1534:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1535:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1536:    // curElement.
 1537: 
 1538:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1539:    // And uses this velocity instead to continue the tracking.
 1540: 
 1541:    // computes the intersection point in cartesian coordinates
 1542:    Point2 intersection = nextSide->p_t(tt);
 1543: 
 1544:    // Nudges the point to the barycenter of the element. 
 1545:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1546:    // next segment intersects the element sides.  
 1547:    curElem->nudgeToBarycenter(intersection);
 1548: 
 1549:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1550:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1551:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1552:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1553: 
 1554:    // If the side is an open boundary, the tangential velocity is zero.
 1555:    if (nextSide->isBnd()) vtan = 0.0;
 1556: 
 1557:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1558:    const double us = vtan*nextSide->t().x;
 1559:    const double vs = vtan*nextSide->t().y;
 1560:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1561: 
 1562:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1563:    const double len2 = length(intersection - toPoint2(xt));
 1564:    const double vel2 = u_int.x*u_int.x + u_int.y*u_int.y;        
 1565:    assert(vel2 > 0.0 && "Zero velocity found");
 1566:    dt = dt - sqrt(len2/vel2); 
 1567: 
 1568:    // The end of this tracking segment is now the intersection point.
 1569:    xt = {intersection.x, intersection.y, zint};
 1570:    
 1571:    u_int = {us, vs, ws};
 1572:    
 1573: }
 1574: 
 1575: /**
 1576:  * Tracks a particle through elements and vertical levels in the mesh.
 1577:  * 
 1578:  * @param x0,y0,z0     Starting position coordinates
 1579:  * @param xt,yt,zt     Target position coordinates
 1580:  * @param dtb          Time step for tracking
 1581:  * @param uuint,vvint,wwint Initial velocity components
 1582:  * @param nextElem     Starting/resulting element index
 1583:  * 
 1584:  * @return Status code of type trackExitCodes
 1585:  * 
 1586:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1587:  * of the details are different. The idea is that the code requires less branches and is better fit
 1588:  * for GPU execution.
 1589:  * 
 1590:  * The main ideas here are:
 1591:  * - The starting point is expected to be in the starting element.
 1592:  * - The end point is guaranteed to be inside an element.
 1593:  * - since the starting point is inside the element, there are only two cases: 
 1594:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1595:  *     (b) it does not and (xt,yt) is already in the starting element.
 1596:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1597:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1598:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1599:  * - tt1 can be positive or negative. We only consider the positive values.
 1600:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1601:  * - The next intersection will occur at the smallest positive tt1.
 1602:  * - This intersection will be the next (x0,y0) position.
 1603:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1604:  *   of getting stuck in a loop.
 1605:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1606:  *   was found.
 1607:  */
 1608: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1609:                                                        Element *&nextElem, int &jlev, double &dt) {
 1610: 
 1611:    // First thing is to check if the target point is inside the element. If it is there is nothing
 1612:    // else to do.
 1613:    if (containsPoint(toPoint2(xt))) {
 1614:       nextElem->interpolateVelocities(xt, u_int);
 1615:       return true;
 1616:    }
 1617: 
 1618:    Side *side = nullptr;
 1619: 
 1620:    // 1. Initial checks
 1621:    // Verify starting element is valid (wet)
 1622:    assert(!nextElem->isDry && "Starting element is dry");
 1623: 
 1624:    // Checks if track has a zero length.
 1625:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1626:    assert(len2 > 0.0 && "Zero length track"); 
 1627:    
 1628: 
 1629:    const int MAX_ITERATIONS = 1000;
 1630:    
 1631:    double t;
 1632:    Side *nextSide = nullptr;
 1633:    double tIntersect = 1e10;
 1634:    double zint = x0.z;
 1635: 
 1636:    // Horizontal tracking loop
 1637:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1638:    // (x0,y0) is inside the element but the target point is not.
 1639:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1640:    if (!found_intersection) {
 1641:       printf("No intersection found:\n"
 1642:            "Element %d\n"
 1643:            "Start point: (%f, %f)\n"
 1644:            "Target point: (%f, %f)\n"
 1645:            "Vertices:\n"
 1646:            "  Node 0: (%f, %f)\n"
 1647:            "  Node 1: (%f, %f)\n"
 1648:            "  Node 2: (%f, %f)\n",
 1649:            nextElem->idx,
 1650:            x0.x, x0.y,
 1651:            xt.x, xt.y,
 1652:            nextElem->nodes[0]->p.x, nextElem->nodes[0]->p.y,
 1653:            nextElem->nodes[1]->p.x, nextElem->nodes[1]->p.y,
 1654:            nextElem->nodes[2]->p.x, nextElem->nodes[2]->p.y);
 1655:    }
 1656:    assert(found_intersection && "No intersection found at %d");
 1657: 
 1658:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1659: 
 1660:    // if the tracking segment goes out of water (either dry or edge boundary)
 1661:    if (isEdgeBoundary(nextSide) || (nextElem->isDry)) {
 1662:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1663:       nextElem = this;
 1664:       
 1665:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1666:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1667:       return true;    
 1668:       }
 1669: 
 1670:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1671:    int iterations = 0;
 1672:    while (iterations < MAX_ITERATIONS) {
 1673:       iterations++;
 1674:       
 1675:       Element *curElem = nextElem;
 1676: 
 1677:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1678:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1679: 
 1680:       // If we are already in the target element, we are done.
 1681:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1682:       if (!found_intersection) break;
 1683: 
 1684: 
 1685:   
 1686:       // if the tracking segment goes out of water (either dry or edge boundary).
 1687:       if (curElem->isEdgeBoundary(nextSide) || (nextElem->isDry)) {
 1688: 
 1689:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1690: 
 1691:          nextElem = curElem;
 1692: 
 1693:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1694:          // In this case, the caller (btrack) needs to take into account the remaining time.
 1695:          return true;
 1696:       }
 1697:       
 1698:       // Update position and element for next iteration
 1699:       side = nextSide;
 1700: 
 1701:    }
 1702: 
 1703: 
 1704:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 1705: 
 1706:  
 1707:    // Interpolate velocities at the final position. This is a conceptually simple step,
 1708:    // but the function is not simple, because it has to search for the vertical level containing zt.
 1709:    nextElem->interpolateVelocities(xt, u_int);
 1710: 
 1711: 
 1712:    return true;
 1713: }
 1714: 
