 4990: __global__ void printMatrix(void) {
 4991: 
 4992: 
 4993:    // Let only one thread per block print at a time 
 4994: 
 4995:    if (threadIdx.x == 0) {
 4996:       for (int ithread = 0; ithread < blockDim.x; ithread++) {
 4997:          const int idx_node = ithread + blockIdx.x * blockDim.x;
 4998:          if (idx_node >= mesh->np) return;
 4999:          const Node *node = mesh->localNodeData + idx_node;
 5000:          printf("idx_node = %d [%d] diag=%lf14, [", idx_node, node->numNodes, node->coeffDiag);
 5001:          for (int j = 0; j < node->numNodes; j++) {
 5002:             Node* nbNode = node->nodes[j];
 5003:             if (node->coeffMatrix[j] != 0.0) printf("%d:%f14,  ", nbNode->idx, node->coeffMatrix[j]);
 5004:          }
 5005:          printf("]\n");
 5006: 
 5007:       }
 5008:    }
 5009: 
 5010: 
 5011: 
 5012: }
 5013: 
 5014: 
 5015: __global__ void computeMatrixProductAndDotProducts() {
 5016:    // Computes A*p, r'Mr and p'Ap
 5017: 
 5018:    // 1) shared buffer: first half for rMr, second for pAp
 5019:    __shared__ double sdata[2*BLOCK_SIZE];
 5020:    double* s_rMr = sdata;
 5021:    double* s_pAp = sdata + BLOCK_SIZE;
 5022: 
 5023:    // 2) get your node pointer
 5024:    NODE(node);  
 5025:    const int tid = threadIdx.x;
 5026: 
 5027:    const double diag = node->coeffDiag;
 5028:    const double r    = node->mR;
 5029:    const double p    = node->mP;  
 5030: 
 5031:    // apply preconditioner on the fly:
 5032:    const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 5033: 
 5034: 
 5035:    // 4) compute Ap = A.p
 5036:    double Ap = node->coeffDiag * node->mP;
 5037:    for (int j = 0; j < node->numNodes; ++j) {
 5038:       const Node *nbNode = node->nodes[j];
 5039:       Ap += node->coeffMatrix[j] * nbNode->mP;
 5040: 
 5041:    }
 5042:    node->mAp = Ap;
 5043:     
 5044: 
 5045:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 5046:    const double l_rMr = r*Mr;  // r'Mr
 5047:    const double l_pAp = p*Ap;  // p'Ap
 5048: 
 5049:    // 6) write into shared mem
 5050:    s_rMr[tid] = l_rMr;
 5051:    s_pAp[tid] = l_pAp;
 5052: 
 5053: 
 5054:    __syncthreads();
 5055: 
 5056:    // 7) block-wide tree reduction
 5057:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 5058:       if (tid < stride)  s_pAp[tid] += s_pAp[tid + stride];
 5059:       __syncthreads();
 5060:    }
 5061: 
 5062:    // 8) thread 0 atomically accumulates into the globals
 5063:    // XXX: This is slower than it needs to be, but it is simple and works
 5064:    if (tid == 0) atomicAdd(pAp, s_pAp[0]);
 5065: 
 5066: 
 5067: 
 5068: }
 5069: 
 5070: 
 5071: __global__ void updateSolutionAndDotProducts(void) {
 5072:     extern __shared__ double s_rMr[BLOCK_SIZE];       
 5073: 
 5074: 
 5075:     // get node & bounds-check:
 5076:     NODE(node);
 5077:     const int tid = threadIdx.x;
 5078: 
 5079: 
 5080: 
 5081:     // Compute alpha
 5082:     const double alpha = (*rMr_old)/(*pAp);
 5083: 
 5084:     // load scalars
 5085:     const double diag = node->coeffDiag;
 5086:     const double p    = node->mP;
 5087:     const double Ap   = node->mAp;
 5088:     const double x    = node->mX;
 5089:     const double r    = node->mR;
 5090:     
 5091:     assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 5092: 
 5093:     // 1) update solution & residual
 5094:     const double x_new = x + alpha*p;
 5095:     const double r_new = r - alpha*Ap;
 5096:     node->mX = x_new;
 5097:     node->mR = r_new;
 5098: 
 5099:     // 2) apply Jacobi preconditioner on the fly
 5100:     const double Mr_new = r_new/diag;
 5101: 
 5102:     // 3) local contributions for the two dot-products
 5103:     const double l_rMr = r_new*Mr_new;  // r'M^-1r
 5104: 
 5105:     // 4) write into shared-mem
 5106:     s_rMr[tid] = l_rMr;
 5107: 
 5108:     __syncthreads();
 5109: 
 5110: 
 5111:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 5112:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 5113:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 5114:         __syncthreads();
 5115:     }
 5116: 
 5117:     // 6) thread 0 atomically folds into the global accumulators
 5118:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 5119: 
 5120: 
 5121: }
 5122: 
 5123: 
 5124: __global__ void updateSearchDirection() {
 5125:     NODE(node);
 5126: 
 5127:     // recompute z on-the-fly
 5128: // printf("updateSearchDirection: node = %d, coeffDiag = %f, rMr_old = %f, rMr_new = %f\n", node, node->coeffDiag, rMr_old, rMr_new);
 5129:     const double z = node->mR / node->coeffDiag;
 5130:     const double p = node->mP;
 5131: 
 5132:     const double beta = (*rMr_new)/(*rMr_old);
 5133: 
 5134: // printf("ZZZ updateSearchDirection: beta = %f\n", beta);
 5135: 
 5136:     // p =z + beta*p
 5137:     node->mP = z + beta*p;
 5138: 
 5139: }
 5140: 
 5141: __global__ void initializePreconditionedResidual(double *scalars) {
 5142: 
 5143:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 5144: 
 5145:     NODE(node);
 5146:     const int tid = threadIdx.x;
 5147:     // For the first iteration:
 5148:     // 1. Initial solution x = 0 (already set)
 5149:     // 2. Initial residual r = b (stored in qel)
 5150:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 5151: 
 5152: // XXX we should use the guess solution here    
 5153: 
 5154:     // Set initial residual r = b (from qel)
 5155:     node->mR = node->qel;
 5156: 
 5157:     // Compute z = M^-1 * r (preconditioned residual)
 5158:     const double z = node->mR / node->coeffDiag;
 5159: 
 5160:     // Set initial search direction p = z
 5161:     node->mP = z;
 5162: 
 5163:     // Initialize other variables needed for CG
 5164:     node->mX = 0.0;  // Initial solution
 5165:     node->mAp = 0.0; // Will be computed in first iteration
 5166: 
 5167:     // These point to a cupy array in the host code
 5168:     rMr_old = scalars + 0;
 5169:     rMr_new = scalars + 1;
 5170:     pAp     = scalars + 2;
 5171: 
 5172:     // Computes the first r'Mr (reduction)
 5173:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 5174: 
 5175:     // 4) write into shared-mem
 5176:     s_rMr[tid] = l_rMr;
 5177: 
 5178:     __syncthreads();
 5179: 
 5180: 
 5181:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 5182:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 5183:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 5184:         __syncthreads();
 5185:     }
 5186: 
 5187:     // 6) thread 0 atomically folds into the global accumulators
 5188:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 5189: 
 5190:     *rMr_old = 0.0;
 5191:     *pAp = 0.0;
 5192: }
