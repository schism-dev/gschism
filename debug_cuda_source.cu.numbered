 1120: // Helper functions for computing the local node index at a given offset from another.
 1121: __device__ __inline__ int nxq(int offset, int index, int size) {
 1122:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1123:    // to the index to make it positive
 1124:    assert(index + offset + 16*size >= 0);
 1125:    return (index + offset + 16*size) % size;  
 1126: }
 1127: 
 1128: __device__ __inline__ int nxq(int index, int size) {
 1129:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1130:    // to the index to make it positive
 1131:    assert(index + 16*size >= 0);
 1132:    return (index + 16*size) % size; 
 1133: }
