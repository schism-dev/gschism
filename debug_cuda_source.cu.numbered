  172: // ------------------------------------------------------------------------------------------------
  173: 
  174: 
  175: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  176:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  177:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  178: }
  179: 
  180: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  181:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  182:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  183: }
  184: 
  185: 
  186: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  187:    x3 = y1*z2 - y2*z1;
  188:    y3 = x2*z1 - x1*z2;
  189:    z3 = x1*y2 - x2*y1;
  190: }
  191: 
  192: 
  193: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  194: // Given a 3D global point (may not be on surface of earth), find its longitude and latitude in radians
  195: 
  196:    const double radius2 = dot(p, p);
  197:    assert(radius2 != 0.0     && "computeLonLat: radius = 0");
  198:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  199: 
  200:    rlon = atan2(p.y, p.x); // (-pi,pi]
  201: 
  202:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  203:       rlat = asin(p.z/sqrt(radius2));
  204:    } else {
  205:       rlat = asin(p.z/rearth_pole);
  206:    }
  207:   
  208: }
  209: 
  210: __inline__ __device__ void Error(const char* msg) {
  211:    printf("Error: %s\n", msg);
  212:    assert(false);
  213: }
  214: 
  215: struct Tracers {
  216:     double tracer[N_TRACERS];
  217: };
  218: 
  219: 
  220: 
  221: struct Frame {
  222:    double _t[9]; // t stands for tensor.
  223: 
  224:    // Access the tensor in Fortran order
  225:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  226: 
  227:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  228: 
  229:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  230: 
  231:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  232:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  233:       sincos(ar2, &sin_ar2, &cos_ar2);
  234: 
  235:       t(0,0) = -sin_ar1;
  236:       t(1,0) =  cos_ar1;
  237:       t(2,0) =  0.0;
  238:       t(0,1) = -cos_ar1*sin_ar2;
  239:       t(1,1) = -sin_ar1*sin_ar2;
  240: 
  241:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  242: 
  243:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  244:       assert (ar4!=0.0 && "GRID: ar4=0");
  245: 
  246:       const double ar4_inv = 1.0/ar4;
  247:       t(0,1) = t(0,1)*ar4_inv;
  248:       t(1,1) = t(1,1)*ar4_inv;
  249:       t(2,1) = t(2,1)*ar4_inv;
  250: 
  251:       // The third vector is the cross product of the first two
  252:       crossProduct(t(0,0), t(1,0), t(2,0), 
  253:                    t(0,1), t(1,1), t(2,1), 
  254:                    t(0,2), t(1,2), t(2,2));
  255:    }
  256: 
  257: 
  258:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  259:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  260:    // Inputs:
  261:    //        vec0: vel. in this frame;
  262:    //        frameout: Output frame;
  263:    // Output: 
  264:    //        vec1: vel. in new frame  
  265: 
  266:       auto const fo = frameout;
  267:       Vector2 vec1;
  268: 
  269:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  270:       // of t and fo.t are the same.
  271:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  272:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  273: 
  274:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  275:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  276: 
  277:       return vec1;
  278:    }
  279: 
  280:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  281:       // Transform a vector from global to local frame
  282:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  283:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  284:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  285:    }
  286: 
  287:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  288:       // Transform a vector from local to global frame
  289:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  290:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  291:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  292:    }   
  293: 
  294:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  295:    // Tranforms a point from global to local frame     
  296:       G2L(pi - origin0, po);
  297:    }
  298: 
  299:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  300:    // Transforms a point from local to global frame      
  301:       L2G(pi, po);
  302:       po = po + origin0;
  303:    }
  304: 
  305: };
