 2965: // //
 2966: 
 2967: //    assert(k1 >= 0 && k2 < nvrt && "vertLinearInterp: k1 or k2 out of bounds");
 2968: //    assert(k1 <= k2 && "vertLinearInterp: k1 > k2");
 2969:    
 2970: //    ibelow = 0;
 2971: 
