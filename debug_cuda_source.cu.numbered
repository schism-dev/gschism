  515: 
  516: struct Side {
  517: 
  518:    // Geometry information
  519:    int idx;               // Index of the side
  520:    Node *n1, *n2;
  521:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  522: 
  523:    double length;         // Length of the side. Used to be called distj; but I think this name is less clear now.
  524:    Vector2 center;        // Location of side center. 
  525:    double zc[nvrt];       // Side center z-coord at each vertical level
  526:    double depth;          // Depth at side center
  527: 
  528:    Frame frame;
  529: 
  530:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  531:                           // this is nullptr
  532: 
  533:    
  534:    int kb;                // Bottom index of the side
  535:    bool idry;             // True if the side is dry
  536:  
  537:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  538: 
  539:    // Physical information
  540:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  541:    double  w2[nvrt];            // Vertical velocity at each vertical level
  542:    Vector2 btu[nvrt];           // Back-tracked velocity
  543:    Vector2 uth[nvrt];           // "Time history" velocity
  544:    Vector2 U;                   // Vertically averaged velocity vector   
  545: 
  546:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
  547: 
  548:    double veg_c2;
  549: 
  550:    __inline__ __device__ double x(double t) const;
  551:    __inline__ __device__ double y(double t) const;
  552:    __inline__ __device__ Point2 p_t(double t) const;
  553: 
  554:    __inline__ __device__ Point3 center3D(int k) const { return {center.x, center.y, zc[k]}; }
  555:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
  556:    __inline__ __device__ double Dz(int k)       const { return zc[k] - zc[k-1]; }
  557: 
  558:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
  559: 
  560:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
  561: 
  562:    __inline__ __device__ int iadv(void) const;
  563: 
  564:    __inline__ __device__ double eta2(void) const;
  565:    __inline__ __device__ double htot(void) const { return eta2() + depth; }
  566: 
  567:    __inline__ __device__ double veg_h(void) const;
  568:    __inline__ __device__ double veg_nv(void) const;
  569:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
  570: 
  571:    __inline__ __device__ double Cd(void) const;
  572: 
  573:    __inline__ __device__ Vector2 tau(void) const;
  574: 
  575:    __inline__ __device__ double zb(void) const { return zc[kb]; }
  576:    
  577: 
  578:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
  579:    __inline__ __device__ double zLevelVegRatio(int k) const { 
  580:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
  581:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
  582:    } 
  583:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
  584:    __inline__ __device__ bool isSubmerged(int k) const { return veg_h() < 0.99*htot(); }
  585:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 1; }
  586:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 1; }
  587: 
  588:    // Get valid starting element (for backtracking)
  589:    __inline__ __device__ Element* getStartElement() {
  590:       return elems[0] ? elems[0] : elems[1];
  591:    }
  592: 
  593:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
  594:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
  595: 
  596:       // If one of the elements is null, return the other one
  597:       if      (elems[0] == nullptr) return elems[1];
  598:       else if (elems[1] == nullptr) return elems[0];
  599: 
  600: 
  601:       // Dot product of the negative velocity vector with the side normal vector
  602:       const double dot_prod1 = -dot(u, n);
  603:       
  604:       // Vector from side center to element 0 centroid
  605:       const Vector2 v2 = toVector2(elems[0]->center) - center;
  606: 
  607:       // Dot product of the vector with the side normal vector
  608:       const double dot_prod2 = dot(v2, n);
  609: 
  610:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
  611:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
  612: 
  613:       if (dot_prod1*dot_prod2 > 0.0) return elems[0];
  614:       else                           return elems[1];
  615: 
  616:  
  617:    }
  618: 
  619:    __forceinline__ __device__ Element* otherElement(Element* elem) {
  620:       // Given an element, returns the other element that shares this side
  621:       return (elems[0] == elem) ? elems[1] : elems[0];
  622:    }
  623: 
  624:    __forceinline__ __device__ Node* otherNode(Node* node) {
  625:       // Given a node, returns the other node that shares this side
  626:       return (n1 == node) ? n2 : n1;
  627:    }
  628:  
  629:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, double* sclr,
  630:                                      Vector3 &u_int) const;
  631: 
  632: 
  633: 
  634: 
  635: };
  636: 
