  486:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int);
  487: 
  488:    // ------------------------------------------------------------------------------------------------
  489:    // These are functions that work on all nodes of the element.
  490:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  491:    //
  492:    // An example of how to use these functions is:
  493:    //   
  494:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  495:    // 
  496:    // Where L is the level at which the field is to be interpolated. The field can be either
  497:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  498:    // There are different versions of getNodalValues for each of these cases.
  499: 
  500:    template<typename T>
  501:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  502:       // Get the values of the field at the nodes of the element
  503:       res[0] = nodes[0]->*field;
  504:       res[1] = nodes[1]->*field;
  505:       res[2] = nodes[2]->*field;
  506:       if (isQuad()) res[3] = nodes[3]->*field;
  507:       else          res[3] = T();
  508:    }
  509: 
  510:    template<typename T>
  511:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  512:       // Get the values of the field at the nodes of the element
  513:       res[0] = (nodes[0]->*field)[level];
  514:       res[1] = (nodes[1]->*field)[level];
  515:       res[2] = (nodes[2]->*field)[level];
  516:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  517:       else          res[3] = T();
  518:    }    
  519: 
  520:    template<typename T>
  521:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  522:       // Get the values of the func at the nodes of the element
  523:       res[0] = (nodes[0]->*func)(level);
  524:       res[1] = (nodes[1]->*func)(level);
  525:       res[2] = (nodes[2]->*func)(level);
  526:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  527:       else          res[3] = T();  // This is 0.0 or a zero vector
  528: 
  529:    }      
  530: 
  531:    template<typename T>
  532:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  533:       // Get the values of the field at the nodes of the element
  534:       res[0] = sides[0]->*field;
  535:       res[1] = sides[1]->*field;
  536:       res[2] = sides[2]->*field;
  537:       if (isQuad()) res[3] = sides[3]->*field;
  538:       else          res[3] = T();
  539:    }
  540: 
  541:    template<typename T>
  542:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  543:       // Get the values of the field at the nodes of the element
  544:       res[0] = (sides[0]->*field)[level];
  545:       res[1] = (sides[1]->*field)[level];
  546:       res[2] = (sides[2]->*field)[level];
  547:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  548:       else          res[3] = T();
  549:    }    
  550: 
  551:    template<typename T>
  552:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  553:       // Get the values of the func at the nodes of the element
  554:       res[0] = (sides[0]->*func)(level);
  555:       res[1] = (sides[1]->*func)(level);
  556:       res[2] = (sides[2]->*func)(level);
  557:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  558:       else          res[3] = T();  // This is 0.0 or a zero vector
  559: 
  560:    }      
  561: 
  562: 
  563:    __device__ double interpolate(int level, const double shapeCoords[4], double (Node::*func)(int) const) const {
  564:       double values[4];
  565:       getNodalValues(level, func, values);
  566: 
  567:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  568:    }
  569: 
  570:    template<typename T>
  571:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  572:       T values[4];
  573:       getNodalValues(field, values);
  574:       
  575:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  576:    }
  577: 
  578: 
  579:    template<typename T>
  580:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  581:       T values[4];
  582:       getNodalValues(level, field, values);
  583: 
  584:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  585:    }
  586: 
  587:    template<typename T>
  588:    __device__ T mean(T Node::* field) const {
  589:       T values[4];
  590:       getNodalValues(field, values);
  591: 
  592:       return (values[0] + values[1] + values[2] + values[3])/i34;
  593:    }
  594: 
  595:    template<typename T>
  596:    __device__ T mean(T Side::* field) const {
  597:       T values[4];
  598:       getSideValues(field, values);
  599:       
  600:       return (values[0] + values[1] + values[2] + values[3])/i34;
  601:    }   
  602: 
  603:    // __device__ double mean(double (Node::*func)(int) const) const {
  604:    //    double values[4];
  605:    //    getNodalValues(level, func, values);
  606:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  607:    // }
  608:    // ------------------------------------------------------------------------------------------------
  609: 
  610:    __device__ bool globalToLocal(double xt, double yt, double &xlocal, double &ylocal) const {
  611:       // Convert global coordinates to local coordinates
  612:       printf("NOT IMPLEMENTED: globalToLocal\n");
  613:       return true;
  614:    }
  615: 
  616:    __inline__ __device__ bool localToGlobal(double xlocal, double ylocal, double &xt, double &yt) const {
  617:       // Convert local coordinates to global coordinates
  618:       printf("NOT IMPLEMENTED: localToGlobal\n");
  619:       return true;
  620:    }
  621: 
  622:    __device__ void trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
  623:                                        double &dt, Point3 &xt, double zint, Vector3 &u_int);
  624:     
  625:    __device__ bool trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
  626:                                                  Element *&nextElem, int &jlev, double &dt);
  627: 
  628: };
