 2882: __device__ void computeElevationBoundaryConditions(double ramp, double time) {
 2883:    // Compute elevation essential boundary conditions 
 2884: 
 2885:    NODE_BND(nodeBnd); // Each boundary node.
 2886: 
 2887:    const Node *node = nodeBnd->node;
 2888:    const int iettype = nodeBnd->iettype;
 2889: 
 2890:    double eic = 0.0;
 2891:    if (nramp_elev==1) eic = nodeBnd->etaic;
 2892:    else               eic = 0.0;
 2893: 
 2894:    const double r_eic = (1.0 - ramp)*eic; 
 2895:    const double r_eth = ramp*nodeBnd->eth;
 2896:    double eta1_bar = r_eic;
 2897: 
 2898:    // Compute tide elevation
 2899:    if (iettype == 3 || iettype == 5) {
 2900:      
 2901:       // XXX IMPLEMENT TIDE THINGS
 2902:       assert(true && "Tide elevation not implemented");
 2903:       // for (int jfr=0; jfr<nbfr; jfr++) { // For all tide frequencies
 2904:       //    const int ncyc = int(amig[jfr]*time/(2.0*pi));
 2905:       //    const double arg = amig[jfr]*time - 2.0*pi*ncyc + face[jfr] - efa[i,j,jfr];
 2906:       //    eta1_bar += ramp*ff[jfr]*emo[i,j,jfr]*cos(arg);
 2907:       // } // for jfr
 2908:    } // if iettype
 2909: 
 2910:    switch (iettype) {
 2911:       case 1:
 2912:       case 2:
 2913:          nodeBnd->elbc = r_eth + r_eic;
 2914:          break;
 2915:       case 3:
 2916:          nodeBnd->elbc = eta1_bar + r_eic;
 2917:          break;
 2918:       case 4:
 2919:          nodeBnd->elbc = r_eth + r_eic;
 2920:          break;
 2921:       case 5:
 2922:          nodeBnd->elbc = r_eth + eta1_bar + r_eic;
 2923:          break;
 2924:    } // switch
 2925: 
 2926: 
 2927:    //Add inverse barometric effects
 2928:    if (iettype != 0 && inv_atm_bnd == 1) {
 2929:       nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 2930:    }
 2931: 
 2932: }
