 1826: 
 1827: __host__ __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 1828: 
 1829: __device__ double Node::compZCoord(int k) const {
 1830:    // Computes the z coordinate at level k.
 1831:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 1832:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 1833:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 1834:    // used 
 1835:    
 1836:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 1837:       
 1838:    if (idry) {
 1839:       return 0.0;
 1840:    }
 1841: 
 1842:    if constexpr(ivcor == 2) {
 1843: 
 1844:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 1845:       const int kz = mesh->kz;
 1846: 
 1847:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 1848:       // The FORTAN code computes it every time this function is called, but it should be done only 
 1849:       // once per time step/node.
 1850:       // CHECK: updateZCoordData
 1851:       if (k == kz)               return -hmod2;
 1852:       else if (k == nvrt-1)      return eta2;
 1853:       else if (k == kb)          return -depth;
 1854:       else if (k < kz && k >= 0) return mesh->ztot[k];
 1855:       else if (k > kz) {
 1856:          const int ksig = k - kz + 1;
 1857: 
 1858:          if (hmod2 <= mesh->h_c) {
 1859:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 1860:          } 
 1861:          else if (eta2 <= - mesh->h_c - (depth - mesh->h_c) * mesh->theta_f/mesh->sinh_theta_f) {
 1862:             printf("Please choose larger h_c: %f %f\n", eta2, mesh->h_c);
 1863:             Error("ZCOOR: invalid h_c\n");
 1864:          } 
 1865:          else {
 1866:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 1867:                          mesh->h_c * mesh->sigma[ksig] + 
 1868:                          (hmod2 - mesh->h_c) * mesh->cs[ksig];
 1869:          }
 1870:       } else { 
 1871:          Error("ZCOOR: invalid level or coordinate system\n");
 1872:       }
 1873: 
 1874:    }
 1875:    else if constexpr(ivcor == 1) {
 1876:       if (k == kb) return -depth;
 1877:       else if (k == nvrt-1) return eta2;
 1878:       else if (k >= kb) {
 1879:             return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 1880:       }
 1881:    }
 1882:    
 1883:    printf("ZCOOR: invalid level or coordinate system\n");
 1884:    return 0.0;
 1885: }
