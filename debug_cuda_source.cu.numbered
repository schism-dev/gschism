  276: // Polynomial class
  277: template<int grade>
  278: struct Polynomial {
  279:     // Static assertion to give a clear error message at compile time
  280:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  281: };
  282: 
  283: 
  284: // Explicit specialization for grade 4
  285: template<>
  286: struct Polynomial<4> {
  287:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  288: 
  289:    // Constructor from coefficients
  290:    __device__ __host__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  291: 
  292:    __device__ __host__ __forceinline__ double eval(double x) const {
  293:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  294:    }
  295: };
