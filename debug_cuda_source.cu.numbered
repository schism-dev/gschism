 2892: __device__ void computeVerticallyIntegratedVelocity(void) {
 2893: 
 2894:    Side *side = SIDE_PTR;
 2895: 
 2896:    side->U = {0.0, 0.0}; 
 2897:       
 2898:    if(side->idry) return;
 2899: 
 2900:    const Node *node1 = side->n1;
 2901:    const Node *node2 = side->n2;
 2902: 
 2903:    // Vertically integrated velocity U (in ll if ics=2)
 2904:    for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 2905:       side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 2906:    }
 2907: 
 2908: }
