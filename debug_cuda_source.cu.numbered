 1250: 
 1251: /**
 1252:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1253:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1254:    If the segment is completely inside the element, then it returns true.
 1255: 
 1256:    This function assumes:
 1257:    - The initial point is on a side of the element. 
 1258:    - Its position is given by parameter t in the range [0,1].
 1259:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1260:       intersects the element (elements are convex).
 1261: 
 1262:    To find the intersection point, this function does the following:
 1263:    - it finds the intersection of the line segment with all the element side lines,
 1264:       except for the one that contains the initial point.
 1265:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1266:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1267:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1268:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1269:       track segment is almost parallel to the element side line.
 1270: 
 1271:    Inputs:
 1272:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1273:    @param x2, y2: other end of the line segment
 1274: 
 1275:    Outputs:
 1276:    @param side:  side that intersects the line segment (input and output)
 1277:    @param nextElement (output): element that contains the intersection point
 1278:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1279:    @param zint (input/output): Vertical coordinate of the intersection point
 1280: 
 1281:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1282:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1283:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1284: 
 1285:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1286:    (Delta) being zero.
 1287: 
 1288:    The intersection2 point happens when:
 1289:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1290:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1291:    
 1292:    Assumption: the 4 points (including those of the side segment) are different.
 1293:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1294:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1295:    If true, (xIntersect,yIntersect) is the intersection.				
 1296:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1297: **/
 1298: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1299:                                               double &t, double& tIntersect) {
 1300: 
 1301:    double closest_intersect_t = 1e10;
 1302:    bool found_intersection = false;
 1303: 
 1304:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1305:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1306:    const Point2 x1 = side->point(t);
 1307:    
 1308: 
 1309:    Side *nextSide = nullptr;
 1310: 
 1311:    for (int i = 0; i < i34; i++) {
 1312: 
 1313:       // Element's i-th side 
 1314:       Side *side2 = sides[i];
 1315: 
 1316:       // Skip the side that contains the initial point
 1317:       if (side2 == side) continue;
 1318: 
 1319:       // (x3,y3)-(x4,y4) is the element side line
 1320:       const Point2 x3 = side2->n1->p2();
 1321:       const Point2 x4 = side2->n2->p2();
 1322: 
 1323:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1324:       const double delta = cross(x2 - x1, x3 - x4);
 1325: 
 1326:       if (delta != 0.0) {
 1327: 
 1328:          const double delta1 = cross(x3 - x1, x3 - x4);
 1329:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1330: 
 1331:          // Solves the two linear equations for tt1 and tt2
 1332:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1333:          const double tt2 = delta2/delta;
 1334: 
 1335:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1336:             closest_intersect_t = min(closest_intersect_t, tt1);
 1337:             nextSide = side2;
 1338: 
 1339:             nextElement = nextSide->otherElem(this);
 1340:             tIntersect = max(small, min(tt1, 1.0-small));
 1341:             t = tt2;
 1342: 
 1343:             found_intersection = true;
 1344:          }
 1345:       
 1346:       }
 1347: 
 1348:    }
 1349: 
 1350: 
 1351:    // found_intersection should always be true, since we checked all the sides.  
 1352:    side = nextSide;
 1353: // if (found_intersection) {
 1354: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1355: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1356: // }   
 1357:    return found_intersection;
 1358: }
 1359: 
 1360: 
 1361: 
 1362: 
 1363: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1364:                                               double &t, double& tIntersect) {
 1365: 
 1366:    double closest_intersect_t = 1e10;
 1367:    bool found_intersection = false;
 1368: 
 1369:    for (int i = 0; i < i34; i++) {
 1370: 
 1371:       Side *side2 = sides[i];
 1372: 
 1373:       // (x3,y3)-(x4,y4) is the element side line
 1374:       const Point2 x3 = side2->n1->p2();
 1375:       const Point2 x4 = side2->n2->p2();
 1376: 
 1377:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1378:       const double delta = cross(x2 - x1, x3 - x4);
 1379: 
 1380:       if (delta != 0.0) {
 1381: 
 1382:          const double delta1 = cross(x3 - x1, x3 - x4);
 1383:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1384: 
 1385:          // Solves the two linear equations for tt1 and tt2
 1386:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1387:          const double tt2 = delta2/delta;
 1388: 
 1389:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1390:             closest_intersect_t = min(closest_intersect_t, tt1);
 1391:             side = side2;
 1392:             nextElement = side->otherElem(this);
 1393:             t = tt2;
 1394:             tIntersect = max(small, min(tt1, 1.0-small));
 1395:             found_intersection = true;
 1396:          }
 1397:       
 1398:       }
 1399: 
 1400:    }
 1401: 
 1402: // if (found_intersection) {
 1403: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1404: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1405: // }
 1406: 
 1407:    // found_intersection should always be true, since we checked all the sides.  
 1408:    return found_intersection;
 1409: }
 1410: 
 1411: 
 1412: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1413:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1414: 
 1415:    printf("Tracking segment goes out of water at element %d\n", curElem->idx);
 1416: 
 1417:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1418:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1419:    // curElement.
 1420: 
 1421:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1422:    // And uses this velocity instead to continue the tracking.
 1423: 
 1424:    // computes the intersection point in cartesian coordinates
 1425:    Point2 intersection = nextSide->p_t(tt);
 1426: 
 1427:    // Nudges the point to the barycenter of the element. 
 1428:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1429:    // next segment intersects the element sides.  
 1430:    curElem->nudgeToBarycenter(intersection);
 1431: 
 1432:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1433:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1434:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1435:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1436: 
 1437:    // If the side is an open boundary, the tangential velocity is zero.
 1438:    if (nextSide->isBnd()) vtan = 0.0;
 1439: 
 1440:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1441:    const double us = vtan*nextSide->t().x;
 1442:    const double vs = vtan*nextSide->t().y;
 1443:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1444: 
 1445:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1446:    const double len2 = length(intersection - toPoint2(xt));
 1447:    const double vel2 = u_int.x*u_int.x + u_int.y*u_int.y;        
 1448:    assert(vel2 > 0.0 && "Zero velocity found");
 1449:    dt = dt - sqrt(len2/vel2); 
 1450: 
 1451:    // The end of this tracking segment is now the intersection point.
 1452:    xt = {intersection.x, intersection.y, zint};
 1453:    
 1454:    u_int = {us, vs, ws};
 1455:    
 1456: }
 1457: 
 1458: /**
 1459:  * Tracks a particle through elements and vertical levels in the mesh.
 1460:  * 
 1461:  * @param x0,y0,z0     Starting position coordinates
 1462:  * @param xt,yt,zt     Target position coordinates
 1463:  * @param dtb          Time step for tracking
 1464:  * @param uuint,vvint,wwint Initial velocity components
 1465:  * @param nextElem     Starting/resulting element index
 1466:  * 
 1467:  * @return Status code of type trackExitCodes
 1468:  * 
 1469:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1470:  * of the details are different. The idea is that the code requires less branches and is better fit
 1471:  * for GPU execution.
 1472:  * 
 1473:  * The main ideas here are:
 1474:  * - The starting point is expected to be in the starting element.
 1475:  * - The end point is guaranteed to be inside an element.
 1476:  * - since the starting point is inside the element, there are only two cases: 
 1477:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1478:  *     (b) it does not and (xt,yt) is already in the starting element.
 1479:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1480:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1481:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1482:  * - tt1 can be positive or negative. We only consider the positive values.
 1483:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1484:  * - The next intersection will occur at the smallest positive tt1.
 1485:  * - This intersection will be the next (x0,y0) position.
 1486:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1487:  *   of getting stuck in a loop.
 1488:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1489:  *   was found.
 1490:  */
 1491: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1492:                                                        Element *&nextElem, int &jlev, double &dt) {
 1493: 
 1494:    // First thing is to check if the target point is inside the element. If it is there is nothing
 1495:    // else to do.
 1496:    if (containsPoint(toPoint2(xt))) {
 1497:       nextElem->interpolateVelocities(xt, u_int);
 1498:       return true;
 1499:    }
 1500: 
 1501:    Side *side = nullptr;
 1502: 
 1503:    // 1. Initial checks
 1504:    // Verify starting element is valid (wet)
 1505:    assert(!nextElem->isDry && "Starting element is dry");
 1506: 
 1507:    // Checks if track has a zero length.
 1508:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1509:    assert(len2 > 0.0 && "Zero length track"); 
 1510:    
 1511: 
 1512:    const int MAX_ITERATIONS = 1000;
 1513:    
 1514:    double t;
 1515:    Side *nextSide = nullptr;
 1516:    double tIntersect = 1e10;
 1517:    double zint = x0.z;
 1518: 
 1519:    // Horizontal tracking loop
 1520:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1521:    // (x0,y0) is inside the element but the target point is not.
 1522:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1523:    assert(found_intersection && "No intersection found");
 1524: 
 1525:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1526: 
 1527:    // if the tracking segment goes out of water (either dry or edge boundary)
 1528:    if (isEdgeBoundary(nextSide) || (nextElem->isDry)) {
 1529:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1530:       nextElem = this;
 1531:       
 1532:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1533:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1534:       return true;    
 1535:       }
 1536: 
 1537:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1538:    int iterations = 0;
 1539:    while (iterations < MAX_ITERATIONS) {
 1540:       iterations++;
 1541:       
 1542:       Element *curElem = nextElem;
 1543: 
 1544:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1545:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1546: 
 1547:       // If we are already in the target element, we are done.
 1548:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1549:       if (!found_intersection) break;
 1550: 
 1551: 
 1552:   
 1553:       // if the tracking segment goes out of water (either dry or edge boundary).
 1554:       if (curElem->isEdgeBoundary(nextSide) || (nextElem->isDry)) {
 1555: 
 1556:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1557: 
 1558:          nextElem = curElem;
 1559: 
 1560:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1561:          // In this case, the caller (btrack) needs to take into account the remaining time.
 1562:          return true;
 1563:       }
 1564:       
 1565:       // Update position and element for next iteration
 1566:       side = nextSide;
 1567: 
 1568:    }
 1569: 
 1570: 
 1571:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 1572: 
 1573:  
 1574:    // Interpolate velocities at the final position. This is a conceptually simple step,
 1575:    // but the function is not simple, because it has to search for the vertical level containing zt.
 1576:    nextElem->interpolateVelocities(xt, u_int);
 1577: 
 1578: 
 1579:    return true;
 1580: }
