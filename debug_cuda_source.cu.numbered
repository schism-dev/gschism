 3947:                       }
 3948:                     enddo //kk
 3949:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 3950:                   } // outward flux
 3951:                 } // end for j=1,i34(ie) ! side
 3952:               } // end for k; ntr 
