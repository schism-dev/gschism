 4876: __global__ void getStructSizes(int* sizes)  {
 4877:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 4878:       sizes[0] = (int)sizeof(Node);
 4879:       sizes[1] = (int)sizeof(Element);
 4880:       sizes[2] = (int)sizeof(Side);
