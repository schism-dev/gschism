   25: constexpr int nvrt = 54; // Number of vertical levels
   26: constexpr int nzlev = 5; // Number of z levels (in contrast to sigma levels)
   27: constexpr int nsiglev = nvrt - nzlev + 1; // Number of sigma levels (in contrast to z levels)
