 2697: template<int nc>
 2698: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 2699: 
 2700: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 2701: //
 2702: // a,b,c,r: input vectors and are not modified by this program.
 2703: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 2704: // r is the r.h.s.
 2705: // n: actual rank of the system.
 2706: // rows in u() and r();
 2707: // u: output with nc columns (transposed to rows)
 2708: // gam: a working array.
 2709: //
 2710: // NOTES:
 2711: // This is a template function that allows for different numbers of columns in the rhs vector.
 2712: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 2713: 
 2714:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 2715:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 2716: 
 2717:    double bet = b[0];
 2718:    if constexpr (nc == 1) {
 2719:       u[0] = rhs[0]/bet;
 2720:    } else {
 2721:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 2722:    }
 2723: 
 2724:    for (int j = 1; j < n; j++) {
 2725:       gam[j] = c[j-1]/bet;
 2726:       bet = b[j] - a[j]*gam[j];
 2727: 
 2728:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 2729: 
 2730:       if constexpr (nc == 1) {
 2731:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 2732:       } else {
 2733:          for (int k = 0; k < nc; k++) {
 2734:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 2735:          }
 2736:       }
 2737:    }
 2738: 
 2739:    // Back-substitution
 2740:    for (int j=n-1; j>=1; j--) {
 2741:       if constexpr (nc == 1) {
 2742:          u[j] = u[j] - gam[j+1]*u[j-1];
 2743:       } else {
 2744:          for (int k = 0; k < nc; k++) {
 2745:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 2746:          }
 2747:       }
 2748:    }
 2749: }
 2750: 
 2751: 
 2752: 
 2753: 
 2754: // Helper function that contains the core algorithm
 2755: template<typename XAccessor, typename YAccessor>
 2756: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 2757:                                     double  yp_top, double  yp_bot, 
 2758:                                     CubicSpline &spline) {
 2759:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 2760:    // 
 2761:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 2762:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 2763:    //
 2764:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 2765:    // 
 2766:    // Inputs: 
 2767:    //            n: dimension for x etc; # of data pts (>=2);
 2768:    //            getX, getY: functions to access x,y coordinates
 2769:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 2770:    //     Output: 
 2771:    //            spline (CubicSpline): spline structure with x,y,y',y''
 2772: 
 2773:    const int n = k2 - k1 + 1;
 2774:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 2775: 
 2776:    // Allocate memory for the splines
 2777:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 2778:    spline.x   = new double[n];
 2779:    spline.y   = new double[n];
 2780:    spline.yp  = new double[n];
 2781:    spline.ypp = new double[n];
 2782: 
 2783:    for (int k=k1; k<=k2; k++) {
 2784:       spline.x[k] = getX(k);
 2785:       spline.y[k] = getY(k);
 2786:    }
 2787: 
 2788:    // This is to simplify expressions later
 2789:    double *x = spline.x;
 2790:    double *y = spline.y;
 2791: 
 2792:    double *a = nullptr;
 2793:    double *b = nullptr;
 2794:    double *c = nullptr;
 2795:    double *gam = nullptr;
 2796:    double *rhs = nullptr;
 2797:    
 2798: 
 2799:       a = new double[n];   // Lower diagonal
 2800:       b = new double[n];   // Diagonal
 2801:       c = new double[n];   // Upper diagonal
 2802:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 2803:       rhs = new double[n]; // Right-hand side
 2804: 
 2805:    for (int k=k1; k<=k2; k++) {
 2806:       if (k == k1) {
 2807:          // Bottom level
 2808:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 2809:          b[k] = (x[k+1] - x[k])/3.0;
 2810:          c[k] = b[k]/2.0;
 2811:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 2812:       } else if (k == n - 1) {
 2813:          // Top level (surface)
 2814:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 2815:          b[k] = (x[k] - x[k-1])/3.0;
 2816:          a[k] = b[k]/2.0;
 2817:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 2818:       } else {
 2819:          // Intermediate levels
 2820:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 2821:          b[k] = (x[k+1] - x[k-1])/3.0;
 2822:          a[k] = (x[k  ] - x[k-1])/6.0;
 2823:          c[k] = (x[k+1] - x[k  ])/6.0;
 2824:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 2825:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 2826:       }
 2827:    }
 2828: 
 2829:    // Solve the tridiagonal system
 2830:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 2831:    
 2832:    spline.yp[k1] = yp_bot;
 2833:    spline.yp[k2] = yp_top;
 2834: 
 2835:    // Compute rest of 1st derivatives using the splines
 2836:    for (int k=k1+1; k<k2; k++) {
 2837:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 2838:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 2839:    }
 2840:    
 2841:    delete[] a;
 2842:    delete[] b;
 2843:    delete[] c;
 2844:    delete[] gam;
 2845:    delete[] rhs;
 2846: 
 2847: }
 2848: 
 2849: // Array version
 2850: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 2851:                                 double y_top, double y_bot, 
 2852:                                 CubicSpline &spline) {
 2853:    auto getX = [x] (int k) { return x[k]; };
 2854:    auto getY = [y] (int k) { return y[k]; };
 2855:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 2856: }
 2857: 
 2858: // Lambda version - allows custom access patterns
 2859: template<typename XFunc, typename YFunc>
 2860: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 2861:                                 double y_top, double y_bot,
 2862:                                 CubicSpline &spline) {
 2863:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 2864: }
