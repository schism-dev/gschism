 1693: /**
 1694:  * This method performs backtracking from the side center until a time -dt back in time 
 1695:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 1696:  * intermediate point.
 1697:  *
 1698:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 1699:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 1700:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 1701:  * remaining time.
 1702:  * 
 1703:  * NOTE: Runge-Kutta is not implemented yet. XXX
 1704:  * 
 1705:  * @param uuint, vvint, wwint: Velocities at the final point
 1706:  * @param jlev: Level at which the backtracking is performed
 1707:  * @param dt, dtbk: Tracking timesteps
 1708:  * @param sclr: Array for backtracked values
 1709:  * @return: True if the backtracking was successful, false otherwise
 1710:  */
 1711: __inline__ __device__ bool Side::btrack(
 1712:       int jlev,
 1713:       double dt,            // Tracking time
 1714:       double dtbk,          // Tracking timestep
 1715:       double* sclr,         // Array for backtracked values
 1716:       Vector3 &u_int
 1717: ) const {
 1718: 
 1719:    // Start from side center
 1720:    Point3 x0 = {center.x, center.y, zc[jlev]};
 1721:  
 1722: 
 1723:    double time_rm = dt; // Remaining time
 1724: 
 1725: 
 1726:    // // Initialize outputs
 1727:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 1728:    //    sclr[i] = 0.0;
 1729:    // }
 1730: 
 1731: 
 1732:    // Initial velocities
 1733:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 1734: 
 1735:    // Find the element that is in the direction opposite to the velocity
 1736:    Element* curElem = findElementTowards({u_int.x, u_int.y});
 1737: 
 1738: printf("$$$  %d, %d, %.5f, %.5f\n",  curElem->idx,idx, x0.x, x0.y)   ;
 1739:    const int MAX_ITERATIONS = 100000; // XXX 1000
 1740:    Element* nextElem = curElem;
 1741:    int iter = 0;
 1742:    while(true) {
 1743:       // Calculate timestep
 1744:       double dtb = min(dtbk, time_rm);
 1745: 
 1746:       // Next point in the backtracking curve
 1747:       Point3 xt = x0 - dtb*u_int;
 1748: 
 1749:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb);
 1750:       assert(found && "Backtracking failed in btrack");
 1751: // printf("<>T = %f, %f %f %f\n", time_rm - dtb, xt, yt, zt);
 1752:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 1753:                       // then time_rm needs to be increased by the unused time.
 1754: 
 1755: 
 1756:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 1757: 
 1758:       // The current point becomes the next segment's starting point.
 1759:       x0 = xt;
 1760:  
 1761:       curElem = nextElem;
 1762: 
 1763:       iter++;
 1764:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 1765:    }
 1766: 
 1767: 
 1768: }
 1769: 
