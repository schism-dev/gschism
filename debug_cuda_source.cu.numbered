  907: class Mesh {
  908:    public:  
  909: 
  910:    int partNum; // Partition number for this mesh.
  911: 
  912:    // Pointers to each GPU's local memory (size is the number of partitions).
  913:    const Node**    nodes;  
  914:    const Element** elems;  
  915:    const Side**    sides;  
  916:    
  917:    // Local memory
  918:    Node*    localNodeData; 
  919:    Element* localElemData;
  920:    Side*    localSideData; 
  921: 
  922:    NodeBoundary *localNodeBoundaryMem; // Array of objects with the boundary information of each node
  923:    SideBoundary *localSideBoundaryMem; // Array of objects with the boundary information of each side
  924:    BoundarySegment *localSegmentMem;   // Array of objects with the boundary segments
  925:    
  926:    const int npgb;  // Global number of horizontal nodes
  927:    const int negb;  // Global number of elements
  928:    const int nsgb;  // Global number of sides
  929: 
  930:    const int np;   // Local number of horizontal nodes 
  931:    const int ne;   // Local number of elements
  932:    const int ns;   // Local number of sides
  933: 
  934:    const int max_np; // Maximum number of horizontal nodes per partition (shared by all partitions)
  935:    const int max_ne; // Maximum number of elements per partition (shared by all partitions)
  936:    const int max_ns; // Maximum number of sides per partition (shared by all partitions)
  937: 
  938:   
  939:    // Additional topology information
  940:    Node    **nodeNeighNodes; // Array of pointers to the nodes neighbors of each node
  941:    Element **nodeNeighElems; // Array of pointers to the elements neighbors of each node
  942: 
  943: 
  944: 
  945:    // Vertical coordinate system
  946:    // Sigma levels
  947:    double h_s; 
  948:    double h_c; 
  949:    int    kz;
  950:    double theta_b;
  951:    double theta_f, sinh_theta_f;
  952:    double *sigma_lcl;
  953:    double *sigma;
  954:    double *ztot;
  955:    double *cs;
  956:    double *dcs;
  957: 
  958:    // // Get's the pointer to the node using the array of global pointers to nodes
  959:    // __device__ const Node *getGlobalNode(int jn) {
  960:    //    const int idx = jn / max_np; // Get the index of the partition that contains the node
  961:    //    return nodes[idx] + idx;
  962:    // }
