  348: struct Element {
  349: 
  350:    // Geometry information
  351:    int idx;               // Index of the element
  352:    int i34;               // Number of sides for the element 
  353:    Side *sides[4];        // Sides of the element
  354:    Node *nodes[4];        // Nodes of the element
  355:    Element *nghbElems[4]; // Neighbors of the element
  356: 
  357:    int kb;                    // Bottom index of the element
  358:    double area;               // Area of the element
  359:    double ssign[4];           // Sign associated with each side of an element
  360:    double radius;             // Element equivalent radii
  361: 
  362:    double wind_angle;         // Wind rotation angle
  363: 
  364:    Frame frame;
  365: 
  366:    Vector2 gradPhi[4];       // Derivatives of shape functions
  367:    Vector2 gradEta[nvrt];    // Gradient of free surface elevation
  368: 
  369:    int idry;                  // True if the element is dry
  370:    int kbe;                   // Bottom index of the element
  371: 
  372:    Vector3 center;            // Element center coordinates
  373:    double xlon_el, ylat_el;   // Element center lat/lon coordinates in _degrees_
  374:    double depth;              // Depth at element (min of all nodes)
  375:    double z[nvrt];            // z-coord  (local frame - vertical up)
  376: 
  377:    // Physical information
  378:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  379: 
  380:    static const bool isblock = false;              // Always false
  381: 
  382:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  383:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  384: 
  385:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  386: 
  387:    
  388: 
  389:    double vsource;            // Volumetric source/sink term [m^3/s]
  390: 
  391:    double rho[nvrt];          // Density at each prism center
  392:    double rho_mean[nvrt];     // Mean density at each prism center
  393:    CubicSpline rho_spl;
  394:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  395:    double rho_z[nvrt];        // First derivative of density at each prism center
  396:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  397: 
  398:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  399: 
  400:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  401:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  402: 
  403:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 1; }
  404:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 1; }
  405: 
  406:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  407:    __inline__ __device__ int nodeLocalIdx(Node *node) const { 
  408:       int res = (nodes[0] == node) ? 0 : ((nodes[1] == node) ? 1 : ((nodes[2] == node) ? 2 : 3)); 
  409:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  410:       return res;
  411:    }
  412: 
  413:    __inline__ __device__ int findLevel(double z1, int k) const {
  414:       // Starting at index k, find sequentially the level that contains z
  415: 
  416:       // if z is already betweeen z[k] and z[k+1], return k
  417:       if (z1 >= z[k] && z1 < z[k+1]) return k;
  418:       else if (z1 < z[k]) { 
  419:          // Search for increasing levels
  420:          for (int kk = k; kk < nvrt - 1; kk++) {
  421:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  422:          }
  423:          return nvrt - 1;
  424:       }
  425:       else {
  426:          // Search for decreasing levels
  427:          for (int kk = k; kk > 0; kk--) {
  428:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  429:          }
  430:          return 0;
  431:       }
  432:    }
  433: 
  434:    __inline__ __device__ double z_prism(int k) const { return 0.5*(z[k+1] + z[k]); }
  435:    __inline__ __device__ double Dz(int k)      const { return z[k+1] - z[k]; }
  436: 
  437:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  438: 
  439:    __inline__ __device__ double computeSignedArea(void) const;
  440: 
  441:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  442:       // Nudges the point (x,y) to the barycenter of the element
  443:       p = (1-eps)*p + eps*toVector2(center);
  444:    }
  445: 
  446:    __device__ bool computeShapeCoords(Point2 xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  447: 
  448:    __device__ Vector2 grad(double *a) const
  449:    {
  450:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  451:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  452:       if (isQuad()) {
  453:          gx += a[3]*gradPhi[3].x;
  454:          gy += a[3]*gradPhi[3].y;
  455:       }
  456:       return {gx, gy};
  457:    }
  458: 
  459:    __device__ void setFrame(void) {
  460: 
  461:       double ar1, ar2;
  462:       computeLonLat(center, ar1, ar2);
  463: 
  464:       frame.update(ar1, ar2);        
  465:     }
  466: 
  467:    __device__ bool findNextIntersection(Point2 x2, Side *&side, Element *&nextElement, double &t, 
  468:                                         double& tIntersect);
  469:    __device__ bool findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement, double &t, 
  470:                                         double& tIntersect);
  471: 
  472:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  473:       // Check if the point (xt,yt) is inside the element
  474:       double shpCoords[4];
  475:       bool res = computeShapeCoords(xt, shpCoords, false);
  476:       return res;
  477:    }
  478: 
  479:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4])
  480:    {
  481:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  482:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  483:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  484:       
  485:    }
  486: 
  487:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int);
  488: 
  489:    // ------------------------------------------------------------------------------------------------
  490:    // These are functions that work on all nodes of the element.
  491:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  492:    //
  493:    // An example of how to use these functions is:
  494:    //   
  495:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  496:    // 
  497:    // Where L is the level at which the field is to be interpolated. The field can be either
  498:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  499:    // There are different versions of getNodalValues for each of these cases.
  500: 
  501:    template<typename T>
  502:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  503:       // Get the values of the field at the nodes of the element
  504:       res[0] = nodes[0]->*field;
  505:       res[1] = nodes[1]->*field;
  506:       res[2] = nodes[2]->*field;
  507:       if (isQuad()) res[3] = nodes[3]->*field;
  508:       else          res[3] = T();
  509:    }
  510: 
  511:    template<typename T>
  512:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  513:       // Get the values of the field at the nodes of the element
  514:       res[0] = (nodes[0]->*field)[level];
  515:       res[1] = (nodes[1]->*field)[level];
  516:       res[2] = (nodes[2]->*field)[level];
  517:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  518:       else          res[3] = T();
  519:    }    
  520: 
  521:    template<typename T>
  522:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  523:       // Get the values of the func at the nodes of the element
  524:       res[0] = (nodes[0]->*func)(level);
  525:       res[1] = (nodes[1]->*func)(level);
  526:       res[2] = (nodes[2]->*func)(level);
  527:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  528:       else          res[3] = T();  // This is 0.0 or a zero vector
  529: 
  530:    }      
  531: 
  532:    template<typename T>
  533:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  534:       // Get the values of the field at the nodes of the element
  535:       res[0] = sides[0]->*field;
  536:       res[1] = sides[1]->*field;
  537:       res[2] = sides[2]->*field;
  538:       if (isQuad()) res[3] = sides[3]->*field;
  539:       else          res[3] = T();
  540:    }
  541: 
  542:    template<typename T>
  543:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  544:       // Get the values of the field at the nodes of the element
  545:       res[0] = (sides[0]->*field)[level];
  546:       res[1] = (sides[1]->*field)[level];
  547:       res[2] = (sides[2]->*field)[level];
  548:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  549:       else          res[3] = T();
  550:    }    
  551: 
  552:    template<typename T>
  553:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  554:       // Get the values of the func at the nodes of the element
  555:       res[0] = (sides[0]->*func)(level);
  556:       res[1] = (sides[1]->*func)(level);
  557:       res[2] = (sides[2]->*func)(level);
  558:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  559:       else          res[3] = T();  // This is 0.0 or a zero vector
  560: 
  561:    }      
  562: 
  563: 
  564:    __device__ double interpolate(int level, const double shapeCoords[4], double (Node::*func)(int) const) const {
  565:       double values[4];
  566:       getNodalValues(level, func, values);
  567: 
  568:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  569:    }
  570: 
  571:    template<typename T>
  572:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  573:       T values[4];
  574:       getNodalValues(field, values);
  575:       
  576:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  577:    }
  578: 
  579: 
  580:    template<typename T>
  581:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  582:       T values[4];
  583:       getNodalValues(level, field, values);
  584: 
  585:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  586:    }
  587: 
  588:    template<typename T>
  589:    __device__ T mean(T Node::* field) const {
  590:       T values[4];
  591:       getNodalValues(field, values);
  592: 
  593:       return (values[0] + values[1] + values[2] + values[3])/i34;
  594:    }
  595: 
  596:    template<typename T>
  597:    __device__ T mean(T Side::* field) const {
  598:       T values[4];
  599:       getSideValues(field, values);
  600:       
  601:       return (values[0] + values[1] + values[2] + values[3])/i34;
  602:    }   
  603: 
  604:    // __device__ double mean(double (Node::*func)(int) const) const {
  605:    //    double values[4];
  606:    //    getNodalValues(level, func, values);
  607:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  608:    // }
  609:    // ------------------------------------------------------------------------------------------------
  610: 
  611:    __device__ bool globalToLocal(double xt, double yt, double &xlocal, double &ylocal) const {
  612:       // Convert global coordinates to local coordinates
  613:       printf("NOT IMPLEMENTED: globalToLocal\n");
  614:       return true;
  615:    }
  616: 
  617:    __inline__ __device__ bool localToGlobal(double xlocal, double ylocal, double &xt, double &yt) const {
  618:       // Convert local coordinates to global coordinates
  619:       printf("NOT IMPLEMENTED: localToGlobal\n");
  620:       return true;
  621:    }
  622: 
  623:    __device__ void trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
  624:                                        double &dt, Point3 &xt, double zint, Vector3 &u_int);
  625:     
  626:    __device__ bool trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
  627:                                                  Element *&nextElem, int &jlev, double &dt);
  628: 
  629: };
