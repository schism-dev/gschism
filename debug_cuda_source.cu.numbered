  752: struct Side {
  753: 
  754:    // Geometry information
  755:    int idx;               // Index of the side
  756:    Node *n1, *n2;
  757:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  758: 
  759:    double length;         // Length of the side. Used to be called distj; but I think this name is less clear now.
  760:    Vector2 center;        // Location of side center. 
  761:    double zc[nvrt];       // Side center z-coord at each vertical level
  762: 
  763:    Frame frame;
  764: 
  765:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  766:                           // this is nullptr
  767:    
  768:    int kb;                // Bottom index of the side
  769:    bool isDry;             // True if the side is dry
  770:  
  771:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  772: 
  773:    // Physical information
  774:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  775:    double  w2[nvrt];            // Vertical velocity at each vertical level
  776:    Vector2 btu[nvrt];           // Back-tracked velocity
  777:    Vector2 uth[nvrt];           // "Time history" velocity
  778:    Vector2 U;                   // Vertically averaged velocity vector  
  779: 
  780:    Vector2 d2uv[nvrt];          // divergence of (nu*grad u) XXX COMPUTE!!
  781: 
  782:    Vector2 bcc[nvrt];           // Baroclinic term
  783: 
  784:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
  785:    Vector2 gradEta2;             // Gradient of elevation at current timestep
  786:    Vector2 gradPr;              // Gradient of pressure
  787:    Vector2 gradETP;             // Gradient of Earth Tidal Potential
  788: 
  789: 
  790:    double hhat;                 // \breve{H} in notes
  791: 
  792:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
  793: 
  794:    double coriolis;             // Coriolis parameter
  795: 
  796:    // Vegetation parameters
  797:    double veg_c2;
  798:    double veg_beta;
  799: 
  800:    // Bottom drag parameters.
  801:    double chi;
  802:    double chi2;
  803: 
  804:    __inline__ __device__ double x(double t) const;
  805:    __inline__ __device__ double y(double t) const;
  806:    __inline__ __device__ Point2 p_t(double t) const;
  807: 
  808:    __inline__ __device__ Point3 center3D(int k) const { return {center.x, center.y, zc[k]}; }
  809:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
  810:    __inline__ __device__ double Dz(int k)       const { return zc[k] - zc[k-1]; }
  811: 
  812:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
  813: 
  814:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
  815: 
  816:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
  817: 
  818:    __inline__ __device__ int iadv(void) const;
  819: 
  820:    __inline__ __device__ double grav3(void) const;
  821:    
  822:    __inline__ __device__ double eta2(void) const;
  823:    __inline__ __device__ double depth(void) const;
  824:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
  825:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
  826: 
  827:    __inline__ __device__ double veg_h(void)  const;
  828:    __inline__ __device__ double veg_nv(void) const;
  829:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
  830:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
  831: 
  832:    __inline__ __device__ double Cd(void) const;
  833: 
  834:    __inline__ __device__ Vector2 tau(void) const;
  835: 
  836:    __inline__ __device__ double zb(void) const { return zc[kb]; }
  837:    
  838: 
  839:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
  840:    __inline__ __device__ double zLevelVegRatio(int k) const { 
  841:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
  842:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
  843:    } 
  844:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
  845:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
  846:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 1; }
  847:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 1; }
  848: 
  849:    // Get valid starting element (for backtracking)
  850:    __inline__ __device__ Element* getStartElement() {
  851:       return elems[0] ? elems[0] : elems[1];
  852:    }
  853: 
  854:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
  855:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
  856: 
  857:       // If one of the elements is null, return the other one
  858:       if      (elems[0] == nullptr) return elems[1];
  859:       else if (elems[1] == nullptr) return elems[0];
  860: 
  861: 
  862:       // Dot product of the negative velocity vector with the side normal vector
  863:       const double dot_prod1 = -dot(u, n);
  864:       
  865:       // Vector from side center to element 0 centroid
  866:       const Vector2 v2 = toVector2(elems[0]->center) - center;
  867: 
  868:       // Dot product of the vector with the side normal vector
  869:       const double dot_prod2 = dot(v2, n);
  870: 
  871:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
  872:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
  873: 
  874:       if (dot_prod1*dot_prod2 > 0.0) return elems[0];
  875:       else                           return elems[1];
  876: 
  877:  
  878:    }
  879: 
  880:    __forceinline__ __device__ Element* otherElem(const Element* elem) {
  881:       // Given an element, returns the other element that shares this side
  882:       return (elems[0] == elem) ? elems[1] : elems[0];
  883:    }
  884: 
  885:    __forceinline__ __device__ Node* otherNode(Node* node) {
  886:       // Given a node, returns the other node that shares this side
  887:       return (n1 == node) ? n2 : n1;
  888:    }
  889:  
  890:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
  891: 
  892: 
  893: 
  894: 
  895: };
  896: 
