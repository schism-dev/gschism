  307: struct Element {
  308: 
  309:    // Geometry information
  310:    int idx;               // Index of the element
  311:    int i34;               // Number of sides for the element 
  312:    Side *sides[4];        // Sides of the element
  313:    Node *nodes[4];        // Nodes of the element
  314:    Element *nghbElems[4]; // Neighbors of the element
  315: 
  316:    
  317:    double area;               // Area of the element
  318:    double ssign[4];           // Sign associated with each side of an element
  319:    double radius;             // Element equivalent radii
  320: 
  321:    double wind_angle;         // Wind rotation angle
  322: 
  323:    Frame frame;
  324: 
  325:    Vector2 gradPhi[4];       // Derivatives of shape functions
  326: 
  327:    int idry;                  // True if the element is dry
  328:    int kbe;                   // Bottom index of the element
  329: 
  330:    Vector3 center;            // Element center coordinates
  331:    double xlon_el, ylat_el;   // Element center lat/lon coordinates in _degrees_
  332:    double depth;              // Depth at element (min of all nodes)
  333:    double z[nvrt];            // z-coord  (local frame - vertical up)
  334: 
  335:    // Physical information
  336:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  337: 
  338:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  339:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  340: 
  341:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  342: 
  343:    double vsource;            // Volumetric source/sink term [m^3/s]
  344: 
  345: 
  346:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  347:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  348: 
  349:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  350:    __inline__ __device__ int nodeLocalIdx(Node *node) const { 
  351:       int res = (nodes[0] == node) ? 0 : ((nodes[1] == node) ? 1 : ((nodes[2] == node) ? 2 : 3)); 
  352:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  353:       return res;
  354:    }
  355: 
  356:    __inline__ __device__ double z_prism(int k) const { return 0.5*(z[k+1] + z[k]); }
  357:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  358: 
  359:    __inline__ __device__ double computeSignedArea(void) const;
  360: 
  361:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  362:       // Nudges the point (x,y) to the barycenter of the element
  363:       p = (1-eps)*p + eps*toVector2(center);
  364:    }
  365: 
  366:    __device__ bool computeShapeCoords(Point2 xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  367: 
  368:    __device__ void setFrame(void) {
  369: 
  370:       double ar1, ar2;
  371:       computeLonLat(center, ar1, ar2);
  372: 
  373:       frame.update(ar1, ar2);        
  374:     }
  375: 
  376:    __device__ bool findNextIntersection(Point2 x2, Side *&side, Element *&nextElement, double &t, 
  377:                                         double& tIntersect);
  378:    __device__ bool findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement, double &t, 
  379:                                         double& tIntersect);
  380: 
  381:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  382:       // Check if the point (xt,yt) is inside the element
  383:       double shpCoords[4];
  384:       bool res = computeShapeCoords(xt, shpCoords, false);
  385:       return res;
  386:    }
  387: 
  388:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4])
  389:    {
  390:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  391:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  392:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  393:       
  394:    }
  395: 
  396:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int);
  397: 
  398:    // ------------------------------------------------------------------------------------------------
  399:    // These are functions that work on all nodes of the element.
  400:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  401:    //
  402:    // An example of how to use these functions is:
  403:    //   
  404:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  405:    // 
  406:    // Where L is the level at which the field is to be interpolated. The field can be either
  407:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  408:    // There are different versions of getNodalValues for each of these cases.
  409: 
  410:    template<typename T>
  411:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  412:       // Get the values of the field at the nodes of the element
  413:       res[0] = nodes[0]->*field;
  414:       res[1] = nodes[1]->*field;
  415:       res[2] = nodes[2]->*field;
  416:       if (isQuad()) res[3] = nodes[3]->*field;
  417:       else          res[3] = T();
  418:    }
  419: 
  420:    template<typename T>
  421:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  422:       // Get the values of the field at the nodes of the element
  423:       res[0] = (nodes[0]->*field)[level];
  424:       res[1] = (nodes[1]->*field)[level];
  425:       res[2] = (nodes[2]->*field)[level];
  426:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  427:       else          res[3] = T();
  428:    }    
  429: 
  430:    template<typename T>
  431:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  432:       // Get the values of the func at the nodes of the element
  433:       res[0] = (nodes[0]->*func)(level);
  434:       res[1] = (nodes[1]->*func)(level);
  435:       res[2] = (nodes[2]->*func)(level);
  436:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  437:       else          res[3] = T();  // This is 0.0 or a zero vector
  438: 
  439:    }      
  440: 
  441: 
  442:    __device__ double interpolate(int level, const double shapeCoords[4], double (Node::*func)(int) const) const {
  443:       double values[4];
  444:       getNodalValues(level, func, values);
  445: 
  446:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  447:    }
  448: 
  449:    template<typename T>
  450:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  451:       T values[4];
  452:       getNodalValues(field, values);
  453:       
  454:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  455:    }
  456: 
  457: 
  458:    template<typename T>
  459:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  460:       T values[4];
  461:       getNodalValues(level, field, values);
  462: 
  463:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  464:    }
  465: 
  466:    template<typename T>
  467:    __device__ T mean(T Node::* field) const {
  468:       T values[4];
  469:       getNodalValues(field, values);
  470:       
  471:       return (values[0] + values[1] + values[2] + values[3])/i34;
  472:    }
