 3303: extern "C" {
 3304: 
 3305:    __global__ void scaleGravity(double loadtide_coef) {
 3306: 
 3307: 
 3308:       NODE(node);
 3309: 
 3310:       // SAL option: scale gravity
 3311:       if constexpr(iloadtide==2) {  // simple const
 3312:          node->grav2 = grav*(1.0 - loadtide_coef);
 3313: 
 3314:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3315:         
 3316:           const double depth = max(node->depth, 0.0);
 3317:           const double tmp1 = sqrt(depth);
 3318:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3319:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3320:                              2.6969e-13*depth*depth*depth*tmp1;
 3321:           
 3322:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3323:           
 3324: 
 3325: 
 3326:           node->grav2 = grav*(1.0 - beta_bar);
 3327: 
 3328:       } else {  // iloadtide=0,1
 3329:         node->grav2=grav;
 3330: 
 3331:       }
 3332: 
 3333:       printf("scaleGravity: node(%d)->grav2 = %f\n", node->idx, node->grav2);
 3334:    }
 3335: 
