  172: // VECTOR/POINT operations ---------------------------------------------------------------------------
  173: 
  174: using Vector2 = double2; 
  175: using Vector3 = double3;
  176: using Point2  = double2;
  177: using Point3  = double3;
  178: 
  179: __device__ __host__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
  180:     return make_double2(a.x + b.x, a.y + b.y);
  181: }
  182: 
  183: __device__ __host__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
  184:     a.x += b.x;
  185:     a.y += b.y;
  186:     return a;
  187: }
  188: 
  189: __device__ __host__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
  190:     return make_double2(a.x - b.x, a.y - b.y);
  191: }
  192: 
  193: __device__ __host__ __forceinline__ double2 operator-=(double2& a, const double2& b) {
  194:     a.x -= b.x;
  195:     a.y -= b.y;
  196:     return a;
  197: }
  198: 
  199: __device__ __host__ __forceinline__ double2 operator*(const double2& v, const double s) {
  200:     return make_double2(v.x * s, v.y * s);
  201: }
  202: 
  203: __device__ __host__ __forceinline__ double2 operator*(const double s, const double2& v) {
  204:     return v * s;  // reuse the previous operator
  205: }
  206: 
  207: __device__ __host__ __forceinline__ double2 operator/(const double2& v, double s) {
  208:     return make_double2(v.x / s, v.y / s);
  209: }
  210: 
  211: __device__ __host__ __forceinline__ double length(const double2& v) {
  212:     return sqrt(v.x*v.x + v.y*v.y);
  213: }
  214: 
  215: __device__ __host__ __forceinline__ double2 normalize(const double2& v) {
  216:     return v / length(v);
  217: }
  218: 
  219: __device__ __host__ __forceinline__ double dot(const double2& v, const double2& w) {
  220:     return v.x*w.x + v.y*w.y;
  221: }
  222: 
  223: __device__ __host__ __forceinline__ double cross(const double2& v, const double2& w) {
  224:     return v.x*w.y - v.y*w.x;
  225: }
  226: 
  227: __device__ __host__ __forceinline__ double3 operator+(const double3& a, const double3& b) {
  228:     return make_double3(a.x + b.x, a.y + b.y, a.z + b.z);
  229: }
  230: 
  231: __device__ __host__ __forceinline__ double3 operator+=(double3& a, const double3& b) {
  232:     a.x += b.x;
  233:     a.y += b.y;
  234:     a.z += b.z;
  235:     return a;
  236: }
  237: 
  238: __device__ __host__ __forceinline__ double3 operator-(const double3& a, const double3& b) {
  239:     return make_double3(a.x - b.x, a.y - b.y, a.z - b.z);
  240: }
  241: 
  242: __device__ __host__ __forceinline__ double3 operator*(const double3& v, double s) {
  243:     return make_double3(v.x * s, v.y * s, v.z * s);
  244: }
  245: 
  246: __device__ __host__ __forceinline__ double3 operator*(double s, const double3& v) {
  247:     return v * s;
  248: }
  249: 
  250: __device__ __host__ __forceinline__ double3 operator/(const double3& v, double s) {
  251:     return make_double3(v.x / s, v.y / s, v.z / s);
  252: }
  253: 
  254: __device__ __host__ __forceinline__ double dot(const double3& v, const double3& w) {
  255:     return v.x*w.x + v.y*w.y + v.z*w.z;
  256: }
  257: 
  258: __device__ __host__ __forceinline__ Vector2 toVector2(const double3& v) {
  259:     return make_double2(v.x, v.y);
  260: }
  261: 
  262: __device__ __host__ __forceinline__ double3 toVector3(const double2& v, double w) {
  263:     return make_double3(v.x, v.y, w);
  264: }
  265: 
  266: __device__ __host__ __forceinline__ Point2 toPoint2(const double3& p) {
  267:     return make_double2(p.x, p.y);
  268: }
  269: 
  270: __device__ __host__ __forceinline__ Point3 toPoint3(const double2& p, double z) {
  271:     return make_double3(p.x, p.y, z);
  272: }
