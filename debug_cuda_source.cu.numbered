 1796: //       yIntersect=-1.e25;
 1797: 
 1798: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 1799: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 1800: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 1801: 
 1802: //       if (delta != 0.0) {
 1803: //          // Solves the two linear equations for tt1 and tt2
