 1728: __host__ __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 1729: 
 1730: __device__ double Node::compZCoord(int k) const {
 1731:    // Computes the z coordinate at level k.
 1732:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 1733:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 1734:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 1735:    // used 
 1736:    
 1737:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 1738:       
 1739:    if (idry) {
 1740:       return 0.0;
 1741:    }
 1742: 
 1743:    if constexpr(ivcor == 2) {
 1744: 
 1745:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 1746:       const int kz = mesh->kz;
 1747: 
 1748:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 1749:       // The FORTAN code computes it every time this function is called, but it should be done only 
 1750:       // once per time step/node.
 1751:       // CHECK: updateZCoordData
 1752:       if (k == kz)               return -hmod2;
 1753:       else if (k == nvrt-1)      return eta2;
 1754:       else if (k == kb)          return -depth;
 1755:       else if (k < kz && k >= 0) return mesh->ztot[k];
 1756:       else if (k > kz) {
 1757:          const int ksig = k - kz + 1;
 1758: 
 1759:          if (hmod2 <= mesh->h_c) {
 1760:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 1761:          } 
 1762:          else if (eta2 <= - mesh->h_c - (depth - mesh->h_c) * mesh->theta_f/mesh->sinh_theta_f) {
 1763:             printf("Please choose larger h_c: %f %f\n", eta2, mesh->h_c);
 1764:             Error("ZCOOR: invalid h_c\n");
 1765:          } 
 1766:          else {
 1767:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 1768:                          mesh->h_c * mesh->sigma[ksig] + 
 1769:                          (hmod2 - mesh->h_c) * mesh->cs[ksig];
 1770:          }
 1771:       } else { 
 1772:          Error("ZCOOR: invalid level or coordinate system\n");
 1773:       }
 1774: 
 1775:    }
 1776:    else if constexpr(ivcor == 1) {
 1777:       if (k == kb) return -depth;
 1778:       else if (k == nvrt-1) return eta2;
 1779:       else if (k >= kb) {
 1780:             return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 1781:       }
 1782:    }
 1783:    
 1784:    printf("ZCOOR: invalid level or coordinate system\n");
 1785:    return 0.0;
 1786: }
 1787: 
 1788: 
 1789: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 1790:                 double *node_coords, double *wind_rotate_angle, 
 1791:                 int *isdel, int *isidenode, int *isbnd,
 1792:                 int *nond, int *nlnd, int *iond, int *ilnd,
 1793:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 1794:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 1795:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 1796:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 1797:                 int *localNodePart,     int *localElemPart,     int *localSidePart) {
 1798: 
 1799:    printf("Populating mesh for partition %d, %d, %d\n", partNum, nond, nlnd);
 1800: 
 1801:    // Horizontal grid
 1802:    printf("Processing %d nodes\n", np);      
 1803:    for (int i = 0; i < np; i++)
 1804:    {
 1805:       Node &node = localNodeData[i];
 1806: 
 1807:       const int idxStart = nodeNeighNodesStart[i];
 1808:       const int idxEnd   = nodeNeighNodesStart[i+1];
 1809:       node.numNodes = idxEnd - idxStart;
 1810:       node.nodes = (Node **)(nodeNeighNodes + idxStart*sizeof(Node *));
 1811:       node.idx = i;
 1812: 
 1813:       for (int idx = idxStart; idx < idxEnd; idx++) {
 1814:          int idxNode = nodeNeighNodesIndices[idx];
 1815:          Node *node_ptr = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 1816: 
 1817:          nodeNeighNodes[idxNode] = node_ptr;
 1818:          node.nodes = &(nodeNeighNodes[idxNode]);
 1819:       }
 1820: 
 1821:       // Element **elements; // pointer to the elements connected to this node
 1822:       // int numElements;   // number of elements shared by this node
 1823: 
 1824:       node.p.x = node_coords[i * 3];
 1825:       node.p.y = node_coords[i * 3 + 1];
 1826:       node.p.z = node_coords[i * 3 + 2];  // XXX this is probably wrong
 1827:       node.depth = node_coords[i * 3 + 2];
 1828: 
 1829:       // Links the node to the boundary information
 1830:       int idxNodeBoundary = 0;
 1831:       if (isbnd[i] >= 0) {
 1832:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 1833:          if (isbnd[i]>0) {
 1834: 
 1835:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 1836:             node.nodeBnd->segment->ifltype = isbnd[i];
 1837: 
 1838:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 1839:             node.nodeBnd->segment->clen  = nan("1");
 1840:             node.nodeBnd->segment->carea = nan("1");
 1841: 
 1842:          }
 1843:          else {
 1844:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 1845:          }
 1846:          
 1847:          idxNodeBoundary++;
 1848:       }
 1849:       else {
 1850:          node.nodeBnd = nullptr;
 1851:       }
 1852: 
 1853: // XXXX
 1854: constexpr double rot_per = 3000.0;
 1855: constexpr double rot_f = 2.0*pi/rot_per;
 1856: for (int k = 0; k < nvrt; k++) {node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0};}
 1857: // XXXXX
 1858:    }
 1859: 
 1860:    printf("Processing %d sides\n", ns);
 1861:    int idxSideBoundary = 0;
 1862:    for (int i = 0; i < ns; i++)
 1863:    {
 1864:       Side &side = localSideData[i];
 1865:       side.idx = i;
 1866:       // finding the pointer to the nodes that form the side
 1867:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 1868:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 1869: 
 1870:       const int locidx_n1 = localNodeIndices[idx_n1];
 1871:       const int locidx_n2 = localNodeIndices[idx_n2];
 1872:       const int part_n1 =   localNodePart[idx_n1];
 1873:       const int part_n2 =   localNodePart[idx_n2];
 1874: 
 1875:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 1876:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 1877: 
 1878:       // Normal vector to the side
 1879:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 1880:       const double norm = sqrt(dot(side.n, side.n));
 1881:       side.n = side.n/norm;
 1882: 
 1883:       // Side boundary type
 1884:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 1885:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 1886:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 1887:       
 1888:       if (n1bnd != nullptr || n2bnd != nullptr) 
 1889:       {
 1890:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 1891:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 1892:          else                  side.sideBnd->segment = n2bnd->segment;
 1893:          side.sideBnd->side = &side;
 1894:          idxSideBoundary++;
 1895:       }
 1896:       else side.sideBnd = nullptr;
 1897: 
 1898:       // finding the pointer to the elements that share the side
 1899:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 1900:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 1901: 
 1902:       if (idx_e1 > -1) {
 1903:          const int locidx_e1 = localElemIndices[idx_e1];
 1904:          const int part_e1 =  localElemPart[idx_e1];
 1905:          side.elems[0] = (Element *)&(elems[part_e1][locidx_e1]);
 1906:       }
 1907:       else {
 1908:          side.elems[0] = nullptr;
 1909:       }
 1910: 
 1911:       if (idx_e2 > -1) {
 1912:          const int locidx_e2 = localElemIndices[idx_e2];
 1913:          const int part_e2 =  localElemPart[idx_e2];
 1914:          side.elems[1] = (Element *)&(elems[part_e2][locidx_e2]);
 1915:       }
 1916:       else {
 1917:          side.elems[1] = nullptr;
 1918:       }
 1919: 
 1920: 
 1921: 
 1922:       // Compute the center of the side
 1923:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 1924: 
 1925: // XXXX
 1926: constexpr double rot_per=3000.0;
 1927: constexpr double rot_f=2.0*pi/rot_per;
 1928: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 1929: // XXXXX      
 1930: 
 1931:       // Compute the z level at the center of the side
 1932:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->znl[k] + side.n2->znl[k]);
 1933: 
 1934:       // Compute the length of the side
 1935:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 1936:       side.length = sqrt(dot(vLen, vLen));
 1937: 
 1938:    }
 1939: 
 1940:    printf("Processing %d elements\n", ne);
 1941:    for (int i = 0; i < ne; i++)
 1942:    {
 1943:       Element &elem = localElemData[i];
 1944:       elem.idx = i;
 1945:       for (int j = 0; j < i34[i]; j++) {
 1946:          const int idxNode = elnode[i*4 + j];  
 1947:          const int idxSide = elside[i*4 + j];
 1948:          
 1949:          elem.nodes[j] = (Node *)&(nodes[localElemPart[idxNode]][localElemIndices[idxNode]]);
 1950:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 1951: 
 1952:          // Find the neighboring element  
 1953:          if (elem.sides[j]->elems[0] == &elem) {
 1954:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 1955:          }
 1956:          else {
 1957:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 1958:          }
 1959:       }
 1960: 
 1961:       
 1962: 
 1963:       elem.i34 = i34[i];
 1964:       elem.wind_angle = wind_rotate_angle[i];
 1965: 
 1966:       // Compute the centroid of the element and its depth
 1967:       Vector2 center = {0.0, 0.0};
 1968:       elem.depth = 0.0;
 1969:       for (int j = 0; j < i34[i]; j++) {
 1970:          center += elem.nodes[j]->p2()/i34[i];
 1971:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 1972:       }
 1973:       elem.center.x = center.x;
 1974:       elem.center.y = center.y;
 1975:       
 1976:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 1977:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 1978: 
 1979:       elem.area = elem.computeSignedArea(); 
 1980:       elem.radius = sqrt(elem.area)/pi; 
 1981:       
 1982:       // Determines which way the normal vector to each side is oriented.
 1983:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 1984:       for (int j = 0; j < i34[i]; j++)  
 1985:       {
 1986:          if (elem.sides[j]->elems[0] == &elem) {
 1987:             elem.ssign[j] =  1.0;
 1988:          }
 1989:          else {
 1990:             elem.ssign[j] = -1.0;
 1991:          }
 1992: 
 1993:       }
 1994: 
 1995:       // Derivatives of shape functions
 1996:       //  For ics=2, this is done inside element/ll frame XXX
 1997:       //  For quads, the derivative is evaluated at centroid
 1998:       const int i34 = elem.i34;
 1999:       for (int j = 0; j < i34; j++) {
 2000:          const double area = elem.area;
 2001:          const int id2 = elem.nxq(1 + j);
 2002:          const int id3 = elem.nxq(2 + j);
 2003:          const int id4 = elem.nxq(3 + j);
 2004:          if (elem.isTri()) {
 2005:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2006:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2007:             // da1/dx = (y1 - y2)/(2*area)
 2008:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2009:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2010:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2011:          }
 2012:          else  { // Quad; evaluate at centroid
 2013:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2014:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2015:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2016:          } // if Tri
 2017: 
 2018:       } // for j
 2019: 
 2020:    }
 2021: 
 2022: 
 2023: 
 2024:    
 2025: }
 2026: 
 2027: 
 2028: __global__ void setupCoefficientMatrixAndRHS(double time) {
 2029: // Setup coefficient matrix, sparsem, for the shallow water wave equation
 2030: // No elevation essential b.c. are imposed yet but other b.c. is imposed
 2031: // 
 2032: // This kernel is called for all nodes.
 2033: 
 2034:    int in = 1; //XXX blockIdx.x * blockDim.x + threadIdx.x;
 2035: 
 2036:    Node *node1 = &(mesh->localNodeData[in]);
 2037: 
 2038: 
 2039:    node1->clearMatrixRow();
 2040:    node1->qel = 0.0;
 2041: 
 2042:    // THIS IS FOR STRUCTURES XXX
 2043:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 2044: 
 2045: 
 2046:    for (int j=0; j<node1->numElements; j++) {
 2047:       // For each element connected to the node...
 2048: 
 2049:       Element *elem = node1->elements[j];
 2050: 
 2051: 
 2052:       // Compute the average gravity
 2053:       const double grav3 = elem->mean(&Node::grav2);
 2054: 
 2055:       // Look at the documentation for the description of the terms in the following integrals
 2056: 
 2057:       // Integral I_1 
 2058:       // \bar{\breve{H}} 
 2059:       const double hhatb = elem->mean(&Node::hhat);        
 2060: 
 2061:       assert((hhatb >= 0.0 || ihh != 1) && "Invalid hhat");
 2062: 
 2063:       const int id1 = elem->nodeLocalIdx(node1); 
 2064:       const double area = elem->area;
 2065: 
 2066:       if (elem->isTri()) {
 2067: 
 2068:          // To clarify the notation in this section: 
 2069:          //   i standtimes for the node under consideration (node1)
 2070:          //   j (node2) and k (node3) are the other nodes of the triangle.
 2071:          const int id2 = elem->nxq(1 + id1);
 2072:          const int id3 = elem->nxq(2 + id1);
 2073:          Node *node2 = elem->nodes[id2];
 2074:          Node *node3 = elem->nodes[id3];
 2075: 
 2076:          const Point2 x1 = node1->p2();
 2077:          const Point2 x2 = node2->p2();
 2078:          const Point2 x3 = node3->p2();
 2079: 
 2080:          // integral of phi_i*phi_j
 2081:          const double ipp_ii = (1.0/6.0 )*area;
 2082:          const double ipp_ij = (1.0/12.0)*area;
 2083:          const double ipp_ik = (1.0/12.0)*area;
 2084: 
 2085:          // integral of [(grad phi_i) * (grad phi_j)]
 2086:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 2087:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 2088:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 2089: 
 2090:          // Computes the different components of integral I_1 of each node with respect to node i.
 2091:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 2092:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 2093:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 2094: 
 2095:          node1->addToSparseMatrix(node1, I1_ii);
 2096:          node1->addToSparseMatrix(node2, I1_ij); 
 2097:          node1->addToSparseMatrix(node3, I1_ik);
 2098:      
 2099:       }
 2100:       else { // Quad
 2101:          // XXX IMPLEMENT THIS
 2102:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2103:       } 
 2104: 
 2105:  
 2106:       // Integral I_4
 2107:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 2108:       // Where
 2109:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 2110: 
 2111:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 2112:       // of U over the element.
 2113:       Vector2 Umean = {0.0, 0.0};
 2114:       for (int m=0; m<elem->i34; m++) {      
 2115:          const Side *side = elem->sides[m];
 2116: 
 2117:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 2118:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 2119:       }
 2120:       Umean = Umean/elem->i34;
 2121: 
 2122:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 2123: 
 2124:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 2125:       const double I_4_1 = dot(gradPhi_1, Umean);
 2126: 
 2127:       // Integral of \nabla\phi_i \cdot \pmb{E}
 2128:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 2129:      
 2130:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);
 2131:       
 2132: 
 2133:       // Additional terms 
 2134:       double vnorm = 0.0;
 2135:       if (imm == 2)  { // Pre-compute vnorm on the element
 2136:          Vector3 ubed;
 2137:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 2138: 
 2139:          Vector3 gradP(0.0, 0.0, 1.0);
 2140:          for (int m=0; m < elem->i34; m++) {
 2141:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 2142:            gradP += toVector3(gradP_2D, 0.0);
 2143:          }   
 2144:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 2145:       } // imm==2
 2146: 
 2147:       if (elem->isTri()) {
 2148:          for (int l=0; l<3; l++) {
 2149:            double fac;
 2150: 
 2151:            Node *node = elem->nodes[l];
 2152: 
 2153:            (node == node1)? fac=2.0 : fac=1.0;
 2154: 
 2155:            if (imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 2156:            else        node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 2157:            
 2158:          }
 2159: 
 2160:          if (elem->idry == 0) {
 2161:            const Vector2 gradEta = elem->nodes[0]->eta2*elem->gradPhi[0] +
 2162:                                    elem->nodes[1]->eta2*elem->gradPhi[1] +
 2163:                                    elem->nodes[2]->eta2*elem->gradPhi[2];
 2164: 
 2165:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 2166:          }
 2167: 
 2168:       } // isTri
 2169:       else { // isQuad
 2170:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2171:          // for (int l=0; l<4; l++) {
 2172:          //   const Node *node = elem->nodes[l];
 2173: 
 2174:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 2175:          //   else        tmp2 = node->bdef2 - node->bdef1;
 2176: 
 2177:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 2178:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 2179:          // }
 2180: 
 2181:       } // isQuad
 2182: 
 2183: 
 2184: 
 2185:       node1->qel += (dt/elem->i34)*elem->vsource;
 2186: 
 2187:    } // for all elements connected to the node
 2188:    
 2189: 
 2190: 
 2191:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 2192:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 2193:    NodeBoundary *nodeBnd = node1->nodeBnd;
 2194:    if (nodeBnd != nullptr)  { 
 2195:       // If it is an open boundary node...
 2196: 
 2197:       // At least one open bnd side, maybe two
 2198:       for (int l=0; l<2; l++) { 
 2199: 
 2200:          // Gets each of the sides sharing the node. 
 2201:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 2202: 
 2203:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 2204: 
 2205:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 2206: 
 2207: 
 2208:          if (sideBnd != nullptr) {
 2209:             // If the side is on a boundary...
 2210: 
 2211:             // Get the boundary segment
 2212:             const BoundarySegment *sideSegment = sideBnd->segment;
 2213:             const Side *side = sideBnd->side;
 2214: 
 2215:             // Integral I_3
 2216:             if (sideSegment->ifltype != 0) {
 2217:             // Natural or Flather b.c.
 2218: 
 2219:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 2220:                // especially for Flather b.c.
 2221:                double ri3 = 0.0;
 2222:                if (side->idry != 1) {
 2223:                   // If the side is not dry
 2224:                   
 2225:                   // Computes the side flux of (uth, vth)
 2226:                   double Vn = 0.0;
 2227:                   for (int k = side->kb; k<nvrt-1; k++) {
 2228:                      // uth, vth in lat/lon frame if ics=2
 2229:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 2230:                      const double vn1 = dot(side->uth[k  ], side->n); // outer normal
 2231:                      const double vn2 = dot(side->uth[k+1], side->n);
 2232: 
 2233:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 2234:                   }
 2235: 
 2236:                   ri3 = 0.5*side->length*Vn;
 2237:                }
 2238: 
 2239:                if (sideSegment->ifltype == -1) { // Flather 1
 2240: 
 2241:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 2242:                   assert(side->depth > 0.0 && "Negative depth at Flather boundary");
 2243: 
 2244:                   const double con0 = (1.0/6.0)*side->length*sqrt(grav*side->depth); // For coefficient matrix
 2245:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 2246:                   
 2247:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 2248:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 2249: 
 2250:                } 
 2251:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 2252:                   // Reset ri3
 2253:                   ri3 = 0.0;
 2254: 
 2255:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 2256: 
 2257:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 2258: 
 2259:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 2260:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 2261: 
 2262:                   const double con0 = (1.0/6.0)*side->length*tmp*thetai*dt;
 2263:                   node1->addToSparseMatrix(node1, con0*2.0);
 2264:                   node1->addToSparseMatrix(node2, con0);
 2265: 
 2266:                } // if Flather or Discharge
 2267: 
 2268:                node1->qel -= thetai*dt*ri3;
 2269: 
 2270:             } // I_3
 2271:           
 2272: 
 2273:             // Integral I_5
 2274:             if(side->idry != 1) {
 2275: 
 2276:                const double Unbar = dot(side->U, side->n);
 2277: 
 2278:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->length*Unbar;
 2279:                
 2280:             } // I_5
 2281: 
 2282:          } // if is boundary side
 2283: 
 2284:       } // for l
 2285: 
 2286:    } // if isbnd
 2287: 
 2288: }
 2289: 
 2290: 
