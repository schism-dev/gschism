 2011:     
 2012: //     // Get starting element
 2013: //     Element* startElement = side->getStartElement();
 2014:     
 2015: //     // Do backtracking
 2016: //     double xt, yt, zt;  // Final positions
 2017: //     bool exitedDomain = startElement->backtrack(
 2018: //         x0, y0, z0,
 2019: //         dt,
 2020: //         xt, yt, zt
 2021: //     );
 2022:     
 2023: //     // Store results
 2024: //     results[sid].finalPos = {xt, yt, zt};
