   78: // VECTOR/POINT operations ---------------------------------------------------------------------------
   79: 
   80: using Vector2 = double2; 
   81: using Vector3 = double3;
   82: using Point2  = double2;
   83: using Point3  = double3;
   84: 
   85: __device__ __host__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
   86:     return make_double2(a.x + b.x, a.y + b.y);
   87: }
   88: 
   89: __device__ __host__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
   90:     a.x += b.x;
   91:     a.y += b.y;
   92:     return a;
   93: }
   94: 
   95: __device__ __host__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
   96:     return make_double2(a.x - b.x, a.y - b.y);
   97: }
   98: 
   99: __device__ __host__ __forceinline__ double2 operator-=(double2& a, const double2& b) {
  100:     a.x -= b.x;
  101:     a.y -= b.y;
  102:     return a;
  103: }
  104: 
  105: __device__ __host__ __forceinline__ double2 operator*(const double2& v, const double s) {
  106:     return make_double2(v.x * s, v.y * s);
  107: }
  108: 
  109: __device__ __host__ __forceinline__ double2 operator*(const double s, const double2& v) {
  110:     return v * s;  // reuse the previous operator
  111: }
  112: 
  113: __device__ __host__ __forceinline__ double2 operator/(const double2& v, double s) {
  114:     return make_double2(v.x / s, v.y / s);
  115: }
  116: 
  117: __device__ __host__ __forceinline__ double length(const double2& v) {
  118:     return sqrt(v.x*v.x + v.y*v.y);
  119: }
  120: 
  121: __device__ __host__ __forceinline__ double dot(const double2& v, const double2& w) {
  122:     return v.x*w.x + v.y*w.y;
  123: }
  124: 
  125: __device__ __host__ __forceinline__ double cross(const double2& v, const double2& w) {
  126:     return v.x*w.y - v.y*w.x;
  127: }
  128: 
  129: __device__ __host__ __forceinline__ double3 operator+(const double3& a, const double3& b) {
  130:     return make_double3(a.x + b.x, a.y + b.y, a.z + b.z);
  131: }
  132: 
  133: __device__ __host__ __forceinline__ double3 operator+=(double3& a, const double3& b) {
  134:     a.x += b.x;
  135:     a.y += b.y;
  136:     a.z += b.z;
  137:     return a;
  138: }
  139: 
  140: __device__ __host__ __forceinline__ double3 operator-(const double3& a, const double3& b) {
  141:     return make_double3(a.x - b.x, a.y - b.y, a.z - b.z);
  142: }
  143: 
  144: __device__ __host__ __forceinline__ double3 operator*(const double3& v, double s) {
  145:     return make_double3(v.x * s, v.y * s, v.z * s);
  146: }
  147: 
  148: __device__ __host__ __forceinline__ double3 operator*(double s, const double3& v) {
  149:     return v * s;
  150: }
  151: 
  152: __device__ __host__ __forceinline__ double3 operator/(const double3& v, double s) {
  153:     return make_double3(v.x / s, v.y / s, v.z / s);
  154: }
  155: 
  156: __device__ __host__ __forceinline__ double dot(const double3& v, const double3& w) {
  157:     return v.x*w.x + v.y*w.y + v.z*w.z;
  158: }
  159: 
  160: __device__ __host__ __forceinline__ Vector2 toVector2(const double3& v) {
  161:     return make_double2(v.x, v.y);
  162: }
  163: 
  164: __device__ __host__ __forceinline__ double3 toVector3(const double2& v, double w) {
  165:     return make_double3(v.x, v.y, w);
  166: }
  167: 
  168: __device__ __host__ __forceinline__ Point2 toPoint2(const double3& p) {
  169:     return make_double2(p.x, p.y);
  170: }
  171: 
  172: __device__ __host__ __forceinline__ Point3 toPoint3(const double2& p, double z) {
  173:     return make_double3(p.x, p.y, z);
  174: }
