  799: struct Node {
  800: 
  801:    // Geometry information
  802:    int idx;        // Index of the node
  803:    Node **nodes;   // pointer to the nodes that are neighbors of this node (there is no guarantee that they are connected)
  804:    int numNodes;   // number of nodes neighbors of this node
  805: 
  806:    Element **elements; // pointer to the elements that share this node
  807:    int numElements;   // number of elements that share this node
  808: 
  809:    Point3 p;
  810:    Vector3 u2[nvrt];
  811:    double znl[nvrt];
  812:    double lon, lat;
  813:    double fun_lat[ntip]; // XXXXX CHECK IF THIS MAKES SENSE
  814:    double depth;
  815: 
  816:    int kb;       // Bottom index of the node
  817: 
  818:    bool isDry;     // True if the node is dry
  819: 
  820:    int iadv;     // Advection flag
  821: 
  822:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
  823: 
  824:    // Physical information
  825:    Tracers tr_nd0[nvrt]; // Initial tracer conc. at nodes
  826: 
  827:    double rho[nvrt];     // Density
  828: 
  829:    double eta1; // Elevation at nodes at previous timestep
  830:    double eta2; // Elevation at nodes at current timestep
  831: 
  832:    double ETP;  // Earth Tidal Potential
  833: 
  834:    
  835:    double pr;    // Air pressure
  836:    double grav2; // Gravity 
  837:    
  838:    Vector2 dav;  // Depth averaged velocity
  839: 
  840:    Vector2 tau; // Wind stress vector
  841: 
  842:    // Vegetation parameters
  843:    double veg_h;
  844:    double veg_nv;
  845:    double veg_di;
  846:    double veg_Cd;
  847:    double veg_h_unbent;
  848:    double veg_di_unbent;
  849:    double veg_nv_unbent;
  850:    double veg_alpha_vert_mean;
  851:    double veg_alpha0;
  852:    double veg_alpha3D[nvrt];
  853: 
  854:    // Bottom drag parameters
  855:    double Cd;       // Bottom drag coefficient
  856:    double rough;    // Bottom roughness length
  857:    Vector2 tau_bot; // Bottom stress vector
  858: 
  859:    double bdef1; // Bottom deformation at previous timestep
  860:    double bdef2; // Bottom deformation at current timestep
  861: 
  862:    double qel; // RHS
  863:    double coeffDiag; // Diagonal coefficient of the matrix
  864:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
  865: 
  866:    // Meteorological forcing
  867:    Vector2 u_air;
  868:    double p_air;
  869:    double t_air;
  870:    double q_air;
  871:    double wind_angle;  // Wind rotation angle
  872: 
  873:    __host__ __device__ void setWind(Vector2 &u) {
  874:    // Sets the wind vector taking into account the wind rotation angle
  875:    
  876:       const double dir = atan2(-u.x,-u.y);
  877:       const double speed = length(u);
  878: 
  879:       // Calculate new u and v components with added rotation angle
  880:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
  881:    }
  882: 
  883:    __host__ __device__ Point2 p2(void) const { return {p.x, p.y}; }
  884: 
  885:    __host__ __device__ double sigmaTransitionDepth(void) const;
  886: 
  887:    __inline__ __device__ double Dz(int k) const { return znl[k] - znl[k-1]; }
  888:    __inline__ __device__ double htot(void) const { return eta2 + depth; }
  889:    __inline__ __device__ double zTopCanopy(void) const { return znl[kb] + veg_h; } 
  890: 
  891:    __device__ void clearMatrixRow(void) {
  892:       // Clear the matrix row for this node
  893:       coeffDiag = 0.0;
  894:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
  895: 
  896:    }
  897: 
  898:    __device__ void addToSparseMatrix(Node const *node, double value) {
  899:       // Add the value to the sparse matrix for this node
  900:       printf("NOT IMPLEMENTED: addToSparseMatrix\n");
  901:    }
  902: 
  903: #ifdef BACKTRACKING
  904:    __device__ void updateZCoordData() {
  905:    // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
  906: 
  907:       // Check if node is wet
  908:       isDry = (depth + eta2 <= h0);  // XXX Check if we are doing this elsewhere
  909: 
  910:       if (idry) return;
  911: 
  912:       if constexpr(ivcor == 2) {  // SZ coordinates
  913:          
  914:          // Compute bottom level index
  915:          if (depth <= mesh->h_s) {
  916:                kb = mesh->nzlevels;
  917:          } else {
  918:                kb = -1;
  919:                for (int i = 0; i < mesh->kz-1; i++) {
  920:                   if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
  921:                      kb = i;
  922:                      break;
  923:                   }
  924:                }
  925:          }
  926:       } 
  927:       else if (ivcor == 1) {  // Localized sigma
  928:          // Do nothing
  929:       }
  930: 
  931:    }
  932: #endif   
  933: 
  934:    __device__ double compZCoord(int k) const;
  935: 
  936: 
  937: 
  938: };
