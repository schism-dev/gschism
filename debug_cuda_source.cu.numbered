 1129:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1130:       // Compute the different time ramps used in the code 
 1131:       // This function is performed by just one thread
 1132: 
 1133:       if constexpr(ibc == 0) {
 1134:          if (drampbc > 0.0) {
 1135:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1136:          } else {
 1137:             rampbc = 1.0;
 1138:          }
 1139: 
 1140:          if (nws != 0 && drampwind > 0.0) {
 1141:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1142:          } else {
 1143:             rampwind = 1.0;
 1144:          }
 1145:       }
 1146: 
 1147:       if (drampwafo > 0.0) {
 1148:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1149:       } else {
 1150:          rampwafo = 1.0;
 1151:       }
 1152: 
 1153:       // For source/sinks
 1154:       if (if_source && dramp_ss > 0.0) {
 1155:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1156:       } else {
 1157:          ramp_ss = 1.0;
 1158:       }
 1159: 
 1160:       if (dramp > 0.0) {
 1161:          ramp = tanh(2.0*time/86400.0/dramp);
 1162:       } else {
 1163:          ramp = 1.0;
 1164:       }
 1165:    }
