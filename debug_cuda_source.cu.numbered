  297: // ------------------------------------------------------------------------------------------------
  298: 
  299: 
  300: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  301:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  302:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  303: }
  304: 
  305: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  306:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  307:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  308: }
  309: 
  310: 
  311: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  312:    x3 = y1*z2 - y2*z1;
  313:    y3 = x2*z1 - x1*z2;
  314:    z3 = x1*y2 - x2*y1;
  315: }
  316: 
  317: 
  318: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  319: // Given a 3D global point (may not be on surface of earth), find its longitude and latitude in radians
  320: 
  321:    const double radius2 = dot(p, p);
  322:    assert(radius2 != 0.0     && "computeLonLat: radius = 0");
  323:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  324: 
  325:    rlon = atan2(p.y, p.x); // (-pi,pi]
  326: 
  327:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  328:       rlat = asin(p.z/sqrt(radius2));
  329:    } else {
  330:       rlat = asin(p.z/rearth_pole);
  331:    }
  332:   
  333: }
  334: 
  335: __inline__ __device__ void Error(const char* msg) {
  336:    printf("Error: %s\n", msg);
  337:    assert(false);
  338: }
  339: 
  340: struct Tracers {
  341:     double tracer[N_TRACERS];
  342: };
  343: 
  344: 
  345: 
  346: struct Frame {
  347:    double _t[9]; // t stands for tensor.
  348: 
  349:    // Access the tensor in Fortran order
  350:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  351: 
  352:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  353: 
  354:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  355: 
  356:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  357:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  358:       sincos(ar2, &sin_ar2, &cos_ar2);
  359: 
  360:       t(0,0) = -sin_ar1;
  361:       t(1,0) =  cos_ar1;
  362:       t(2,0) =  0.0;
  363:       t(0,1) = -cos_ar1*sin_ar2;
  364:       t(1,1) = -sin_ar1*sin_ar2;
  365: 
  366:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  367: 
  368:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  369:       assert (ar4!=0.0 && "GRID: ar4=0");
  370: 
  371:       const double ar4_inv = 1.0/ar4;
  372:       t(0,1) = t(0,1)*ar4_inv;
  373:       t(1,1) = t(1,1)*ar4_inv;
  374:       t(2,1) = t(2,1)*ar4_inv;
  375: 
  376:       // The third vector is the cross product of the first two
  377:       crossProduct(t(0,0), t(1,0), t(2,0), 
  378:                    t(0,1), t(1,1), t(2,1), 
  379:                    t(0,2), t(1,2), t(2,2));
  380:    }
  381: 
  382: 
  383:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  384:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  385:    // Inputs:
  386:    //        vec0: vel. in this frame;
  387:    //        frameout: Output frame;
  388:    // Output: 
  389:    //        vec1: vel. in new frame  
  390: 
  391:       auto const fo = frameout;
  392:       Vector2 vec1;
  393: 
  394:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  395:       // of t and fo.t are the same.
  396:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  397:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  398: 
  399:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  400:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  401: 
  402:       return vec1;
  403:    }
  404: 
  405:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  406:       // Transform a vector from global to local frame
  407:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  408:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  409:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  410:    }
  411: 
  412:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  413:       // Transform a vector from local to global frame
  414:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  415:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  416:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  417:    }   
  418: 
  419:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  420:    // Tranforms a point from global to local frame     
  421:       G2L(pi - origin0, po);
  422:    }
  423: 
  424:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  425:    // Transforms a point from local to global frame      
  426:       L2G(pi, po);
  427:       po = po + origin0;
  428:    }
  429: 
  430: };
