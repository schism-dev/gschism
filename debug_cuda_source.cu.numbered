 1283: // Helper functions for computing the local node index at a given offset from another.
 1284: __device__ __inline__ int nxq(int offset, int index, int size) {
 1285:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1286:    // to the index to make it positive
 1287:    assert(index + offset + 16*size >= 0);
 1288:    return (index + offset + 16*size) % size;  
 1289: }
 1290: 
 1291: __device__ __inline__ int nxq(int index, int size) {
 1292:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1293:    // to the index to make it positive
 1294:    assert(index + 16*size >= 0);
 1295:    return (index + 16*size) % size; 
 1296: }
