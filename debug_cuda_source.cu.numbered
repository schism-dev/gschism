  861: // This struct is used to store the boundary information for a node.
  862: struct NodeBoundary {   
  863:    BoundarySegment *segment;
  864:    Node *node;
  865:    
  866:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
  867:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
  868: 
  869:    double etaic;  // Elevation at nodes used for essential boundary conditions
  870:    double elbc;   // Elevation boundary condition
  871:    int iettype;   // Type of elevation boundary condition
  872:    double eth;    // Elevation time history
  873: 
  874:    bool isEssentialBC;
  875: 
  876: 
  877:    // Arrays for harmonic constituents (if needed)
  878:    double emo[nbfr];  // Elevation amplitude
  879:    double efa[nbfr];  // Elevation phase
  880:    double umo[nbfr];  // U-velocity amplitude
  881:    double ufa[nbfr];  // U-velocity phase
  882:    double vmo[nbfr];  // V-velocity amplitude
  883:    double vfa[nbfr];  // V-velocity phase 
  884: 
  885:    
  886:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
  887:       assert(index == 0 || index == 1); 
  888:       return (index == 0) ? sideBnd1 : sideBnd2; 
  889:    }
  890: 
  891: 
  892: };
  893: 
  894: struct Node {
  895: 
  896:    // Geometry information
  897:    int idx;        // Index of the node
  898:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
  899:    int numNodes;   // Number of nodes neighbors of this node
  900: 
  901:    Element **elements; // Array of pointers to the elements that share this node
  902:    int numElements;   // Number of elements that share this node
  903: 
  904:    Point3 p;
  905:    Vector3 u2[nvrt];
  906:    double znl[nvrt];
  907:    double lon, lat;
  908:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
  909:    double depth;
  910: 
  911:    int kb;       // Bottom index of the node
  912: 
  913:    bool isDry;     // True if the node is dry
  914: 
  915:    int iadv;     // Advection flag
  916: 
  917:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
  918: 
  919:    // Physical information
  920:    Tracers tr_nd0[nvrt]; // Initial tracer conc. at nodes
  921: 
  922:    double rho[nvrt];     // Density
  923: 
  924:    double eta1; // Elevation at nodes at previous timestep
  925:    double eta2; // Elevation at nodes at current timestep
  926: 
  927:    double ETP;  // Earth Tidal Potential
  928: 
  929:    
  930:    double pr;    // Air pressure
  931:    double grav2; // Gravity 
  932:    
  933:    Vector2 dav;  // Depth averaged velocity
  934: 
  935:    Vector2 tau; // Wind stress vector
  936: 
  937:    // Vegetation parameters
  938:    double veg_h;
  939:    double veg_nv;
  940:    double veg_di;
  941:    double veg_Cd;
  942:    double veg_h_unbent;
  943:    double veg_di_unbent;
  944:    double veg_nv_unbent;
  945:    double veg_alpha_vert_mean;
  946:    double veg_alpha0;
  947:    double veg_alpha3D[nvrt];
  948: 
  949:    // Bottom drag parameters
  950:    double Cd;       // Bottom drag coefficient
  951:    double rough;    // Bottom roughness length
  952:    Vector2 tau_bot; // Bottom stress vector
  953: 
  954:    double bdef1; // Bottom deformation at previous timestep
  955:    double bdef2; // Bottom deformation at current timestep
  956: 
  957:    double qel; // RHS
  958:    double coeffDiag; // Diagonal coefficient of the matrix
  959:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
  960: 
  961:    double mP; // Search direction for conjugate gradient method
  962:    double mR; // Residual for conjugate gradient method
  963:    double mAp; // Product of matrix and search direction for conjugate gradient method
  964:    double mX; // Solution for conjugate gradient method
  965: 
  966:    // Meteorological forcing
  967:    Vector2 u_air;
  968:    double p_air;
  969:    double t_air;
  970:    double q_air;
  971:    double wind_angle;  // Wind rotation angle
  972: 
  973:    __host__ __device__ void setWind(Vector2 &u) {
  974:    // Sets the wind vector taking into account the wind rotation angle
  975:    
  976:       const double dir = atan2(-u.x,-u.y);
  977:       const double speed = length(u);
  978: 
  979:       // Calculate new u and v components with added rotation angle
  980:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
  981:    }
  982: 
  983:    __host__ __device__ Point2 p2(void) const { return {p.x, p.y}; }
  984: 
  985:    __host__ __device__ double sigmaTransitionDepth(void) const;
  986: 
  987:    __inline__ __device__ double Dz(int k) const { return znl[k] - znl[k-1]; }
  988:    __inline__ __device__ double htot(void) const { return eta2 + depth; }
  989:    __inline__ __device__ double zTopCanopy(void) const { return znl[kb] + veg_h; } 
  990: 
  991:    __device__ void clearMatrixRow(void) {
  992:       // Clear the matrix row for this node
  993:       coeffDiag = 0.0;
  994:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
  995: 
  996:    }
  997: 
  998:    __device__ void addToSparseMatrix(Node const *node, double value) {
  999:       // Add the value to the sparse matrix for this node
 1000:       
 1001:       if (node == this) {
 1002:          coeffDiag += value;
 1003: printf("addToSparseMatrix: node == this, value = %f\n", coeffDiag);         
 1004:       } else {
 1005:          // Search (linearly)the index of the node in the array of nodes
 1006:          // XXX: This is not efficient, see if we can improve this
 1007:          int i;
 1008:          for (i = 0; i < numNodes; i++) {
 1009:             if (nodes[i] == node) {
 1010:                break;
 1011:             }
 1012:          }
 1013:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1014:          coeffMatrix[i] += value;
 1015:       }
 1016:    }
 1017: 
 1018: #ifdef BACKTRACKING
 1019:    __device__ void updateZCoordData() {
 1020:    // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 1021: 
 1022:       // Check if node is wet
 1023:       isDry = (depth + eta2 <= h0);  // XXX Check if we are doing this elsewhere
 1024: 
 1025:       if (idry) return;
 1026: 
 1027:       if constexpr(ivcor == 2) {  // SZ coordinates
 1028:          
 1029:          // Compute bottom level index
 1030:          if (depth <= mesh->h_s) {
 1031:                kb = mesh->nzlevels;
 1032:          } else {
 1033:                kb = -1;
 1034:                for (int i = 0; i < mesh->kz-1; i++) {
 1035:                   if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 1036:                      kb = i;
 1037:                      break;
 1038:                   }
 1039:                }
 1040:          }
 1041:       } 
 1042:       else if (ivcor == 1) {  // Localized sigma
 1043:          // Do nothing
 1044:       }
 1045: 
 1046:    }
 1047: #endif   
