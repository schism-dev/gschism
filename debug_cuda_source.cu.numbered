 2752: __device__ void computeVerticallyIntegratedVelocity(void) {
 2753: 
 2754:    Side *side = FROM kernel;
 2755: 
 2756:    side->U = {0.0, 0.0}; 
 2757:       
 2758:    if(side->idry) return;
 2759: 
 2760:    const Node *node1 = side->n1;
 2761:    const Node *node2 = side->n2;
 2762: 
 2763:    // Vertically integrated velocity U (in ll if ics=2)
 2764:    for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 2765:       side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 2766:    }
 2767: 
 2768: }
