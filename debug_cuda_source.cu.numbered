   33: constexpr double h1_bcc   = 50.0;  // Parameters for under-deep methods
   34: constexpr double h2_bcc   = 100.0; 
   35: constexpr double hw_depth = 1.0e6; 
   36: constexpr double hw_ratio = 0.5;
