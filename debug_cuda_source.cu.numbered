 3470:    __global__ void computeElevationBoundaryConditions(double time) {
 3471:       // Compute elevation essential boundary conditions 
 3472: 
 3473:       NODE_BND(nodeBnd); // Each boundary node.
 3474: 
 3475:       const Node *node = nodeBnd->node;
 3476:       const int iettype = nodeBnd->iettype;
 3477: 
 3478:       double eic = 0.0;
 3479:       if (nramp_elev==1) eic = nodeBnd->etaic;
 3480:       else               eic = 0.0;
 3481: 
 3482:       const double r_eic = (1.0 - ramp)*eic; 
 3483:       const double r_eth = ramp*nodeBnd->eth;
 3484:       double eta1_bar = r_eic;
 3485: 
 3486: printf("++++>> node[%d]->iettype = %d\n", node->idx, iettype);
 3487:       // Compute tide elevation
 3488:       if (iettype == 3 || iettype == 5) {   
 3489: 
 3490:          if constexpr(iloadtide==1) { // loading tide
 3491:             assert(false && "Loading tide not implemented");
 3492:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3493:          }
 3494:          
 3495:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 3496: 
 3497:             const double efa  = nodeBnd->efa[jfr]; 
 3498:             const double emo  = nodeBnd->emo[jfr]; 
 3499: 
 3500:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 3501:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 3502:             eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 3503: 
 3504:  printf("++++>> jfr = %d, ramp = %f, node->idx = %d, amig = %f, face = %f, ff = %f, efa = %f, emo = %f, arg = %f, eta1_bar = %f\n", jfr, ramp, node->idx, amig[jfr], face[jfr], ff[jfr], efa, emo, arg, eta1_bar);            
 3505:          } // for jfr
 3506: 
 3507:       } // if iettype
 3508: 
 3509:       switch (iettype) {
 3510:          case 1:
 3511:          case 2:
 3512:             nodeBnd->elbc = r_eth + r_eic;
 3513:             break;
 3514:          case 3:
 3515:             nodeBnd->elbc = eta1_bar + r_eic;
 3516:             break;
 3517:          case 4:
 3518:             nodeBnd->elbc = r_eth + r_eic;
 3519:             break;
 3520:          case 5:
 3521:             nodeBnd->elbc = r_eth + eta1_bar + r_eic;
 3522:             break;
 3523:       } // switch
 3524: 
 3525: 
 3526:       //Add inverse barometric effects
 3527:       if (iettype != 0 && inv_atm_bnd == 1) {
 3528:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 3529:       }
 3530: printf("++++>> nodeBnd->elbc = %f\n", nodeBnd->elbc);
 3531:    }
 3532: 
 3533: 
 3534:    __global__ void setEssentialBC(void) {
 3535:       // Set essential boundary conditions 
 3536:       NODE(node); // Each boundary node
 3537:       NodeBoundary *nodeBnd = node->nodeBnd;
 3538: printf("node idx = %d, nodeBnd = %p, essentialBC = %d\n", node->idx, nodeBnd, nodeBnd ? nodeBnd->isEssentialBC : -1);
 3539:       
 3540: // nodeBnd->isEssentialBC = true;      
 3541:       // Check if this node has essential BC
 3542:       if (nodeBnd && nodeBnd->isEssentialBC) {
 3543:          // Verify BC value is valid
 3544:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 3545: 
 3546:          printf("XX node IDX = %d, nodeBnd->isEssentialBC = %d\n", node->idx, nodeBnd->isEssentialBC);
 3547:          
 3548:          // Set diagonal to 1 and zero off-diagonals
 3549:          node->coeffDiag = 1.0;
 3550:          printf("ZZZZZZZ node->coeffDiag = %16.9f\n", node->coeffDiag);
 3551: 
 3552:          for (int j = 0; j < node->numNodes; j++) {
 3553:                node->coeffMatrix[j] = 0.0;
 3554:                printf("YY node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 3555:          }
 3556:          
 3557:          // Set solution and RHS to BC value
 3558:          node->mX  = nodeBnd->elbc;
 3559:          node->qel = nodeBnd->elbc;
 3560: printf("{{{{ node->mX = %f, node->qel = %f\n", node->mX, node->qel);         
 3561:       } else {
 3562:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 3563: 
 3564:          for (int j = 0; j < node->numNodes; j++) {
 3565:                Node* nbNode = node->nodes[j];
 3566:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 3567:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 3568:                   // Verify neighbor's BC value
 3569:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 3570: 
 3571:                   // Subtract contribution to RHS
 3572:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 3573:                   node->coeffMatrix[j] = 0.0;  
 3574:                   printf("ZZ node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 3575:                }
 3576:          }
 3577:       }
 3578:    }
 3579: 
 3580: 
 3581:    __global__ void updateElevation(void) {
 3582:       NODE(node);
 3583: 
 3584:       node->eta2 = node->mX;
 3585: printf("node[%d]->eta2 = %f\n", node->idx, node->eta2);
 3586:    }
