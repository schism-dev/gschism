  773: // This struct is used to store the boundary information for a node.
  774: struct NodeBoundary {   
  775:    BoundarySegment *segment;
  776:    Node *node;
  777:    
  778:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
  779:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
  780: 
  781:    double etaic;  // Elevation at nodes used for essential boundary conditions
  782:    double elbc;   // Elevation boundary condition
  783:    int iettype;   // Type of elevation boundary condition
  784:    double eth;    // Elevation time history
  785: 
  786:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
  787:       assert(index == 0 || index == 1); 
  788:       return (index == 0) ? sideBnd1 : sideBnd2; 
  789:    }
  790: };
