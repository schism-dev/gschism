 1944: 
 1945: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 1946:                 double *node_coords, double *wind_rotate_angle, 
 1947:                 int *isdel, int *isidenode, int *isbnd,
 1948:                 int *nond, int *nlnd, int *iond, int *ilnd,
 1949:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 1950:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 1951:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 1952:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 1953:                 int *localNodePart,     int *localElemPart,     int *localSidePart) {
 1954: 
 1955:    printf("Populating mesh for partition %d, %d, %d\n", partNum, nond, nlnd);
 1956: 
 1957:    // Horizontal grid
 1958:    printf("Processing %d nodes\n", np);      
 1959:    for (int i = 0; i < np; i++)
 1960:    {
 1961:       Node &node = localNodeData[i];
 1962: 
 1963:       const int idxStart = nodeNeighNodesStart[i];
 1964:       const int idxEnd   = nodeNeighNodesStart[i+1];
 1965:       node.numNodes = idxEnd - idxStart;
 1966:       node.nodes = (Node **)(nodeNeighNodes + idxStart*sizeof(Node *));
 1967:       node.idx = i;
 1968: 
 1969:       for (int idx = idxStart; idx < idxEnd; idx++) {
 1970:          int idxNode = nodeNeighNodesIndices[idx];
 1971:          Node *node_ptr = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 1972: 
 1973:          nodeNeighNodes[idxNode] = node_ptr;
 1974:          node.nodes = &(nodeNeighNodes[idxNode]);
 1975:       }
 1976: 
 1977:       // Element **elements; // pointer to the elements connected to this node
 1978:       // int numElements;   // number of elements shared by this node
 1979: 
 1980:       node.p.x = node_coords[i * 3];
 1981:       node.p.y = node_coords[i * 3 + 1];
 1982:       node.p.z = node_coords[i * 3 + 2];  // XXX this is probably wrong
 1983:       node.depth = node_coords[i * 3 + 2];
 1984: 
 1985:       // Links the node to the boundary information
 1986:       int idxNodeBoundary = 0;
 1987:       if (isbnd[i] >= 0) {
 1988:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 1989:          if (isbnd[i]>0) {
 1990: 
 1991:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 1992:             node.nodeBnd->segment->ifltype = isbnd[i];
 1993: 
 1994:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 1995:             node.nodeBnd->segment->clen  = nan("1");
 1996:             node.nodeBnd->segment->carea = nan("1");
 1997: 
 1998:          }
 1999:          else {
 2000:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2001:          }
 2002:          
 2003:          idxNodeBoundary++;
 2004:       }
 2005:       else {
 2006:          node.nodeBnd = nullptr;
 2007:       }
 2008: 
 2009: // XXXX
 2010: constexpr double rot_per = 3000.0;
 2011: constexpr double rot_f = 2.0*pi/rot_per;
 2012: for (int k = 0; k < nvrt; k++) {node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0};}
 2013: // XXXXX
 2014:    }
 2015: 
 2016:    printf("Processing %d sides\n", ns);
 2017:    int idxSideBoundary = 0;
 2018:    for (int i = 0; i < ns; i++)
 2019:    {
 2020:       Side &side = localSideData[i];
 2021:       side.idx = i;
 2022:       // finding the pointer to the nodes that form the side
 2023:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2024:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2025: 
 2026:       const int locidx_n1 = localNodeIndices[idx_n1];
 2027:       const int locidx_n2 = localNodeIndices[idx_n2];
 2028:       const int part_n1 =   localNodePart[idx_n1];
 2029:       const int part_n2 =   localNodePart[idx_n2];
 2030: 
 2031:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2032:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2033: 
 2034:       // Normal vector to the side
 2035:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2036:       const double norm = sqrt(dot(side.n, side.n));
 2037:       side.n = side.n/norm;
 2038: 
 2039:       // Side boundary type
 2040:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 2041:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 2042:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2043:       
 2044:       if (n1bnd != nullptr || n2bnd != nullptr) 
 2045:       {
 2046:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2047:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2048:          else                  side.sideBnd->segment = n2bnd->segment;
 2049:          side.sideBnd->side = &side;
 2050:          idxSideBoundary++;
 2051:       }
 2052:       else side.sideBnd = nullptr;
 2053: 
 2054:       // finding the pointer to the elements that share the side
 2055:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2056:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2057: 
 2058:       if (idx_e1 > -1) {
 2059:          const int locidx_e1 = localElemIndices[idx_e1];
 2060:          const int part_e1 =  localElemPart[idx_e1];
 2061:          side.elems[0] = (Element *)&(elems[part_e1][locidx_e1]);
 2062:       }
 2063:       else {
 2064:          side.elems[0] = nullptr;
 2065:       }
 2066: 
 2067:       if (idx_e2 > -1) {
 2068:          const int locidx_e2 = localElemIndices[idx_e2];
 2069:          const int part_e2 =  localElemPart[idx_e2];
 2070:          side.elems[1] = (Element *)&(elems[part_e2][locidx_e2]);
 2071:       }
 2072:       else {
 2073:          side.elems[1] = nullptr;
 2074:       }
 2075: 
 2076: 
 2077: 
 2078:       // Compute the center of the side
 2079:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2080: 
 2081: // XXXX
 2082: constexpr double rot_per=3000.0;
 2083: constexpr double rot_f=2.0*pi/rot_per;
 2084: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2085: // XXXXX      
 2086: 
 2087:       // Compute the z level at the center of the side
 2088:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->znl[k] + side.n2->znl[k]);
 2089: 
 2090:       // Compute the length of the side
 2091:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2092:       side.length = sqrt(dot(vLen, vLen));
 2093: 
 2094:    }
 2095: 
 2096:    printf("Processing %d elements\n", ne);
 2097:    for (int i = 0; i < ne; i++)
 2098:    {
 2099:       Element &elem = localElemData[i];
 2100:       elem.idx = i;
 2101:       for (int j = 0; j < i34[i]; j++) {
 2102:          const int idxNode = elnode[i*4 + j];  
 2103:          const int idxSide = elside[i*4 + j];
 2104:          
 2105:          elem.nodes[j] = (Node *)&(nodes[localElemPart[idxNode]][localElemIndices[idxNode]]);
 2106:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2107: 
 2108:          // Find the neighboring element  
 2109:          if (elem.sides[j]->elems[0] == &elem) {
 2110:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2111:          }
 2112:          else {
 2113:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2114:          }
 2115:       }
 2116: 
 2117:       
 2118: 
 2119:       elem.i34 = i34[i];
 2120:       elem.wind_angle = wind_rotate_angle[i];
 2121: 
 2122:       // Compute the centroid of the element and its depth
 2123:       Vector2 center = {0.0, 0.0};
 2124:       elem.depth = 0.0;
 2125:       for (int j = 0; j < i34[i]; j++) {
 2126:          center += elem.nodes[j]->p2()/i34[i];
 2127:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2128:       }
 2129:       elem.center.x = center.x;
 2130:       elem.center.y = center.y;
 2131:       
 2132:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2133:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2134: 
 2135:       elem.area = elem.computeSignedArea(); 
 2136:       elem.radius = sqrt(elem.area)/pi; 
 2137:       
 2138:       // Determines which way the normal vector to each side is oriented.
 2139:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2140:       for (int j = 0; j < i34[i]; j++)  
 2141:       {
 2142:          if (elem.sides[j]->elems[0] == &elem) {
 2143:             elem.ssign[j] =  1.0;
 2144:          }
 2145:          else {
 2146:             elem.ssign[j] = -1.0;
 2147:          }
 2148: 
 2149:       }
 2150: 
 2151:       // Derivatives of shape functions
 2152:       //  For ics=2, this is done inside element/ll frame XXX
 2153:       //  For quads, the derivative is evaluated at centroid
 2154:       const int i34 = elem.i34;
 2155:       for (int j = 0; j < i34; j++) {
 2156:          const double area = elem.area;
 2157:          const int id2 = elem.nxq(1 + j);
 2158:          const int id3 = elem.nxq(2 + j);
 2159:          const int id4 = elem.nxq(3 + j);
 2160:          if (elem.isTri()) {
 2161:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2162:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2163:             // da1/dx = (y1 - y2)/(2*area)
 2164:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2165:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2166:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2167:          }
 2168:          else  { // Quad; evaluate at centroid
 2169:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2170:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2171:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2172:          } // if Tri
 2173: 
 2174:       } // for j
 2175: 
 2176:    }
 2177: 
 2178: 
 2179: 
 2180:    
 2181: }
 2182: 
 2183: 
 2184: __global__ void setupCoefficientMatrixAndRHS(double time) {
 2185: // Setup coefficient matrix, sparsem, for the shallow water wave equation
 2186: // No elevation essential b.c. are imposed yet but other b.c. is imposed
 2187: // 
 2188: // This kernel is called for all nodes.
 2189: 
 2190:    int in = 1; //XXX blockIdx.x * blockDim.x + threadIdx.x;
 2191: 
 2192:    Node *node1 = &(mesh->localNodeData[in]);
 2193: 
 2194: 
 2195:    node1->clearMatrixRow();
 2196:    node1->qel = 0.0;
 2197: 
 2198:    // THIS IS FOR STRUCTURES XXX
 2199:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 2200: 
 2201: 
 2202:    for (int j=0; j<node1->numElements; j++) {
 2203:       // For each element connected to the node...
 2204: 
 2205:       Element *elem = node1->elements[j];
 2206: 
 2207: 
 2208:       // Compute the average gravity
 2209:       const double grav3 = elem->mean(&Node::grav2);
 2210: 
 2211:       // Look at the documentation for the description of the terms in the following integrals
 2212: 
 2213:       // Integral I_1 
 2214:       // \bar{\breve{H}} 
 2215:       const double hhatb = elem->mean(&Side::hhat);        
 2216: 
 2217:       assert((hhatb >= 0.0 || ihh != 1) && "Invalid hhat");
 2218: 
 2219:       const int id1 = elem->nodeLocalIdx(node1); 
 2220:       const double area = elem->area;
 2221: 
 2222:       if (elem->isTri()) {
 2223: 
 2224:          // To clarify the notation in this section: 
 2225:          //   i standtimes for the node under consideration (node1)
 2226:          //   j (node2) and k (node3) are the other nodes of the triangle.
 2227:          const int id2 = elem->nxq(1 + id1);
 2228:          const int id3 = elem->nxq(2 + id1);
 2229:          Node *node2 = elem->nodes[id2];
 2230:          Node *node3 = elem->nodes[id3];
 2231: 
 2232:          const Point2 x1 = node1->p2();
 2233:          const Point2 x2 = node2->p2();
 2234:          const Point2 x3 = node3->p2();
 2235: 
 2236:          // integral of phi_i*phi_j
 2237:          const double ipp_ii = (1.0/6.0 )*area;
 2238:          const double ipp_ij = (1.0/12.0)*area;
 2239:          const double ipp_ik = (1.0/12.0)*area;
 2240: 
 2241:          // integral of [(grad phi_i) * (grad phi_j)]
 2242:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 2243:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 2244:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 2245: 
 2246:          // Computes the different components of integral I_1 of each node with respect to node i.
 2247:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 2248:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 2249:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 2250: 
 2251:          node1->addToSparseMatrix(node1, I1_ii);
 2252:          node1->addToSparseMatrix(node2, I1_ij); 
 2253:          node1->addToSparseMatrix(node3, I1_ik);
 2254:      
 2255:       }
 2256:       else { // Quad
 2257:          // XXX IMPLEMENT THIS
 2258:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2259:       } 
 2260: 
 2261:  
 2262:       // Integral I_4
 2263:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 2264:       // Where
 2265:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 2266: 
 2267:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 2268:       // of U over the element.
 2269:       Vector2 Umean = {0.0, 0.0};
 2270:       for (int m=0; m<elem->i34; m++) {      
 2271:          const Side *side = elem->sides[m];
 2272: 
 2273:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 2274:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 2275:       }
 2276:       Umean = Umean/elem->i34;
 2277: 
 2278:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 2279: 
 2280:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 2281:       const double I_4_1 = dot(gradPhi_1, Umean);
 2282: 
 2283:       // Integral of \nabla\phi_i \cdot \pmb{E}
 2284:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 2285:      
 2286:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);
 2287:       
 2288: 
 2289:       // Additional terms 
 2290:       double vnorm = 0.0;
 2291:       if (imm == 2)  { // Pre-compute vnorm on the element
 2292:          Vector3 ubed;
 2293:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 2294: 
 2295:          Vector3 gradP(0.0, 0.0, 1.0);
 2296:          for (int m=0; m < elem->i34; m++) {
 2297:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 2298:            gradP += toVector3(gradP_2D, 0.0);
 2299:          }   
 2300:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 2301:       } // imm==2
 2302: 
 2303:       if (elem->isTri()) {
 2304:          for (int l=0; l<3; l++) {
 2305:            double fac;
 2306: 
 2307:            Node *node = elem->nodes[l];
 2308: 
 2309:            (node == node1)? fac=2.0 : fac=1.0;
 2310: 
 2311:            if (imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 2312:            else        node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 2313:            
 2314:          }
 2315: 
 2316:          if (elem->idry == 0) {
 2317:            const Vector2 gradEta = elem->nodes[0]->eta2*elem->gradPhi[0] +
 2318:                                    elem->nodes[1]->eta2*elem->gradPhi[1] +
 2319:                                    elem->nodes[2]->eta2*elem->gradPhi[2];
 2320: 
 2321:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 2322:          }
 2323: 
 2324:       } // isTri
 2325:       else { // isQuad
 2326:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2327:          // for (int l=0; l<4; l++) {
 2328:          //   const Node *node = elem->nodes[l];
 2329: 
 2330:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 2331:          //   else        tmp2 = node->bdef2 - node->bdef1;
 2332: 
 2333:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 2334:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 2335:          // }
 2336: 
 2337:       } // isQuad
 2338: 
 2339: 
 2340: 
 2341:       node1->qel += (dt/elem->i34)*elem->vsource;
 2342: 
 2343:    } // for all elements connected to the node
 2344:    
 2345: 
 2346: 
 2347:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 2348:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 2349:    NodeBoundary *nodeBnd = node1->nodeBnd;
 2350:    if (nodeBnd != nullptr)  { 
 2351:       // If it is an open boundary node...
 2352: 
 2353:       // At least one open bnd side, maybe two
 2354:       for (int l=0; l<2; l++) { 
 2355: 
 2356:          // Gets each of the sides sharing the node. 
 2357:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 2358: 
 2359:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 2360: 
 2361:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 2362: 
 2363: 
 2364:          if (sideBnd != nullptr) {
 2365:             // If the side is on a boundary...
 2366: 
 2367:             // Get the boundary segment
 2368:             const BoundarySegment *sideSegment = sideBnd->segment;
 2369:             const Side *side = sideBnd->side;
 2370: 
 2371:             // Integral I_3
 2372:             if (sideSegment->ifltype != 0) {
 2373:             // Natural or Flather b.c.
 2374: 
 2375:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 2376:                // especially for Flather b.c.
 2377:                double ri3 = 0.0;
 2378:                if (side->idry != 1) {
 2379:                   // If the side is not dry
 2380:                   
 2381:                   // Computes the side flux of (uth, vth)
 2382:                   double Vn = 0.0;
 2383:                   for (int k = side->kb; k<nvrt-1; k++) {
 2384:                      // uth, vth in lat/lon frame if ics=2
 2385:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 2386:                      const double vn1 = dot(side->uth[k  ], side->n); // outer normal
 2387:                      const double vn2 = dot(side->uth[k+1], side->n);
 2388: 
 2389:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 2390:                   }
 2391: 
 2392:                   ri3 = 0.5*side->length*Vn;
 2393:                }
 2394: 
 2395:                if (sideSegment->ifltype == -1) { // Flather 1
 2396: 
 2397:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 2398:                   assert(side->depth > 0.0 && "Negative depth at Flather boundary");
 2399: 
 2400:                   const double con0 = (1.0/6.0)*side->length*sqrt(grav*side->depth); // For coefficient matrix
 2401:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 2402:                   
 2403:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 2404:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 2405: 
 2406:                } 
 2407:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 2408:                   // Reset ri3
 2409:                   ri3 = 0.0;
 2410: 
 2411:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 2412: 
 2413:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 2414: 
 2415:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 2416:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 2417: 
 2418:                   const double con0 = (1.0/6.0)*side->length*tmp*thetai*dt;
 2419:                   node1->addToSparseMatrix(node1, con0*2.0);
 2420:                   node1->addToSparseMatrix(node2, con0);
 2421: 
 2422:                } // if Flather or Discharge
 2423: 
 2424:                node1->qel -= thetai*dt*ri3;
 2425: 
 2426:             } // I_3
 2427:           
 2428: 
 2429:             // Integral I_5
 2430:             if(side->idry != 1) {
 2431: 
 2432:                const double Unbar = dot(side->U, side->n);
 2433: 
 2434:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->length*Unbar;
 2435:                
 2436:             } // I_5
 2437: 
 2438:          } // if is boundary side
 2439: 
 2440:       } // for l
 2441: 
 2442:    } // if isbnd
 2443: 
 2444: }
 2445: 
 2446: 
 2447: 
 2448: __device__ void backtrackAllNodes(void) {
 2449: 
 2450:    // max/min # of sub-divisions
 2451:    const int ndelt_max = max(1.0, dt/dtb_min);
 2452:    const int ndelt_min = max(1.0, dt/dtb_max); 
 2453: 
 2454:    // Removed all references to swild98 XXX
 2455:    // swild98=0.d0 !init
 2456: 
 2457:    Side *side = SIDE_PTR;
 2458: 
 2459:    const int kb = side->kb;
 2460:    for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 2461: 
 2462:    if (side->idry == 1) return;
 2463: 
 2464:    // Checks that at least one element is not dry
 2465:    const Element *elem1 = side->elems[0];
 2466:    const Element *elem2 = side->elems[1];
 2467:    assert ((elem1 != nullptr && !(elem1->idry)) || (elem2 != nullptr && !(elem2->idry)) && "backtrackAllNodes: non dry side without two dry elements.");
 2468: 
 2469:    // XXXXXX
 2470:    // !swild_tmp to store global coord. of the starting side
 2471:    // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 2472:    // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 2473:    // !Use sframe2 
 2474:    // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 2475: 
 2476: 
 2477:    for (int k = kb; k < nvrt; k++) {
 2478:    //  Initialize (xt,yt,zt), nnel and vel.
 2479:    //  For ics=2, the coordinates are in local frames
 2480:    //  Caution! nnel must be initialized inside this loop as it is updated inside.
 2481: 
 2482: 
 2483:       const int iadvf = side->iadv();  // Advection flag
 2484: 
 2485:       Point3 xt;
 2486:       if constexpr(ics==1) {
 2487:          xt = side->center3D(k); 
 2488:       }
 2489:       else // lat/lon; in side lat/lon frame
 2490:       {
 2491:       // XXX IMPLEMENT THIS
 2492:    //          xt=0.d0
 2493:    //          yt=0.d0
 2494:    //          !centroid coord. for nudging
 2495:    //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 2496:    //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 2497:       }  // ics
 2498: 
 2499: 
 2500:       // Velocity at the side (in ll frame for ics, same vertical direction)
 2501:       // XXX IS THIS NECESSARY?
 2502:       Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 2503: 
 2504:       // If on land or open boundary...
 2505:       const bool ifl_bnd =  (side->sideBnd != nullptr);
 2506:       
 2507:       const double vmag = length(toVector2(u_int));
 2508: 
 2509:       if (vmag <= velmin_btrack) {
 2510:          // No activity 
 2511: 
 2512:          side->btu[k] = side->u2[k];
 2513: 
 2514: 
 2515:       } else {  // do btrack
 2516: 
 2517:          // Compute number of sub-divisions based on local gradients 
 2518:          // XXX IS THIS NECESSARY?
 2519:          double suma = 0.0;
 2520:          int icount = 0;
 2521:          for (int ii=0; ii<2; ii++) {
 2522: 
 2523:             const Element *elem = side->elems[ii];
 2524:               
 2525:             if (elem == nullptr) continue;
 2526: 
 2527:             icount++;
 2528: 
 2529:             // Not strictly along z; in ll frame for ics=2
 2530: 
 2531:             double utmp[4];
 2532:             double vtmp[4];
 2533:             for (int jj = 0; jj < elem->i34; jj++) {
 2534: 
 2535:                const Node *node = elem->nodes[jj];
 2536: 
 2537:                if constexpr(ics==1) {
 2538:                   utmp[jj] = node->u2[k].x;
 2539:                   vtmp[jj] = node->u2[k].y;  
 2540:                } else {
 2541:                   // XXX IMPLEMENT THIS
 2542:                   // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 2543:                }
 2544:             } // for jj
 2545: 
 2546:             const Vector2 grad_u = elem->grad(utmp); 
 2547:             const Vector2 grad_v = elem->grad(vtmp);
 2548: 
 2549:             suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 2550:          } // for ii
 2551: 
 2552:          assert(icount > 0 && "Impossible 77");
 2553: 
 2554:          // '4' is somewhat arbitrary
 2555:          const int ndelt = max(ndelt_min, min(ndelt_max, int(suma/icount)*4)); // >=1
 2556:          const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 2557: 
 2558: 
 2559:          // Perturb starting pt to avoid underflow 
 2560:          // XXX I don't think this is needed with the current implementation
 2561:          // eps=btrack_nudge
 2562:          // if constexpr(ics==1) {
 2563:          //    xt=(1.d0-eps)*xt+eps*xctr(nnel)
 2564:          //    yt=(1.d0-eps)*yt+eps*yctr(nnel)
 2565:          // } else { //lat/lon
 2566:          //    xt=(1.d0-eps)*xt+eps*xctr2
 2567:          //    yt=(1.d0-eps)*yt+eps*yctr2
 2568:          // } // ics
 2569: 
 2570:       
 2571:          // call btrack(l,ipsgb,ifl_bnd,j,iadvf,swild_tmp,swild10_tmp, dtbk,time_rm,time_rm2,uuint,vvint,wwint,nnel,jlev,xt,yt,zt,swild3,ltmp)
 2572: 
 2573:             
 2574:       } // if vmag (do backtrack)
 2575: 
 2576:    } // for j=jmin,nvrt-1
 2577: 
 2578: }
 2579: 
 2580: template<int nc>
 2581: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 2582: 
 2583: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 2584: //
 2585: // a,b,c,r: input vectors and are not modified by this program.
 2586: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 2587: // r is the r.h.s.
 2588: // n: actual rank of the system.
 2589: // rows in u() and r();
 2590: // u: output with nc columns (transposed to rows)
 2591: // gam: a working array.
 2592: //
 2593: // NOTES:
 2594: // This is a template function that allows for different numbers of columns in the rhs vector.
 2595: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 2596: 
 2597:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 2598:    assert(nc <= nvec   && "TRIDAG: Increase number of columns");
 2599:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 2600: 
 2601:    double bet = b[0];
 2602:    if constexpr (nc == 1) {
 2603:       u[0] = rhs[0]/bet;
 2604:    } else {
 2605:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 2606:    }
 2607: 
 2608:    for (int j = 1; j < n; j++) {
 2609:       gam[j] = c[j-1]/bet;
 2610:       bet = b[j] - a[j]*gam[j];
 2611: 
 2612:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 2613: 
 2614:       if constexpr (nc == 1) {
 2615:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 2616:       } else {
 2617:          for (int k = 0; k < nc; k++) {
 2618:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 2619:          }
 2620:       }
 2621:    }
 2622: 
 2623:    // Back-substitution
 2624:    for (int j=n-1; j>=1; j--) {
 2625:       if constexpr (nc == 1) {
 2626:          u[j] = u[j] - gam[j+1]*u[j-1];
 2627:       } else {
 2628:          for (int k = 0; k < nc; k++) {
 2629:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 2630:          }
 2631:       }
 2632:    }
 2633: }
 2634: 
 2635: 
 2636: struct CubicSpline { 
 2637:    double *x;
 2638:    double *y;
 2639:    double *yp;
 2640:    double *ypp;
 2641: };
 2642: 
 2643: // Helper function that contains the core algorithm
 2644: template<typename XAccessor, typename YAccessor>
 2645: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 2646:                                     double  yp_top, double  yp_bot, 
 2647:                                     CubicSpline &spline) {
 2648:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 2649:    // 
 2650:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 2651:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 2652:    //
 2653:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 2654:    // 
 2655:    // Inputs: 
 2656:    //            n: dimension for x etc; # of data pts (>=2);
 2657:    //            getX, getY: functions to access x,y coordinates
 2658:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 2659:    //     Output: 
 2660:    //            ypp[n]: 2nd derivatives used in interpolation.
 2661:    //             yp[n]: 1st derivatives 
 2662: 
 2663: 
 2664:    const int n = k2 - k1 + 1;
 2665:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 2666: 
 2667:    double *a = nullptr;
 2668:    double *b = nullptr;
 2669:    double *c = nullptr;
 2670:    double *gam = nullptr;
 2671:    double *rhs = nullptr;
 2672:    
 2673:    try {
 2674:        a = new double[n];   // Lower diagonal
 2675:        b = new double[n];   // Diagonal
 2676:        c = new double[n];   // Upper diagonal
 2677:        gam = new double[n]; // Gamma, used by the tridiagonal solver
 2678:        rhs = new double[n]; // Right-hand side
 2679: 
 2680:       for (int k=k1; k<=k2; k++) {
 2681:          if (k == k1) {
 2682:             // Bottom level
 2683:             assert(getX(k+1) - getX(k) != 0.0 && "CUBIC SPLINE: bottom problem");
 2684:             b[k] = (getX(k+1) - getX(k))/3.0;
 2685:             c[k] = b[k]/2.0;
 2686:             rhs[k] = (getY(k+1) - getY(k))/(getX(k+1) - getX(k)) - yp_bot;
 2687:          } else if (k == n - 1) {
 2688:             // Top level (surface)
 2689:             assert(getX(k) - getX(k-1) != 0.0 && "CUBIC SPLINE: surface problem");
 2690:             b[k] = (getX(k) - getX(k-1))/3.0;
 2691:             a[k] = b[k]/2.0;
 2692:             rhs[k] = -(getY(k) - getY(k-1))/(getX(k) - getX(k-1)) + yp_top;
 2693:          } else {
 2694:             // Intermediate levels
 2695:             assert(getX(k) - getX(k-1) != 0.0 && getX(k+1) - getX(k) != 0.0 && "CUBIC SPLINE: middle problem");
 2696:             b[k] = (getX(k+1) - getX(k-1))/3.0;
 2697:             a[k] = (getX(k  ) - getX(k-1))/6.0;
 2698:             c[k] = (getX(k+1) - getX(k  ))/6.0;
 2699:             rhs[k] = (getY(k+1) - getY(k  ))/(getX(k+1) - getX(k  )) - 
 2700:                      (getY(k  ) - getY(k-1))/(getX(k  ) - getX(k-1));
 2701:          }
 2702:       }
 2703: 
 2704:       // Solve the tridiagonal system
 2705:       tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 2706:       
 2707:       spline.yp[k1] = yp_bot;
 2708:       spline.yp[k2] = yp_top;
 2709: 
 2710:        // Compute rest of 1st derivatives using the splines
 2711:        for (int k=k1+1; k<k2; k++) {
 2712:            spline.yp[k] = (getY(k+1) - getY(k))/(getX(k+1) - getX(k)) - 
 2713:                           (getX(k+1) - getX(k))/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 2714:        }
 2715:    }
 2716:    finally {
 2717:        delete[] a;
 2718:        delete[] b;
 2719:        delete[] c;
 2720:        delete[] gam;
 2721:        delete[] rhs;
 2722:    }
 2723: }
 2724: 
 2725: // Array version
 2726: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 2727:                                 double y_top, double y_bot, 
 2728:                                 CubicSpline &spline) {
 2729:    auto getX = [x] (int k) { return x[k]; };
 2730:    auto getY = [y] (int k) { return y[k]; };
 2731:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, &spline);
 2732: }
 2733: 
 2734: // Lambda version - allows custom access patterns
 2735: template<typename XFunc, typename YFunc>
 2736: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 2737:                                 double y_top, double y_bot,
 2738:                                 CubicSpline &spline) {
 2739:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 2740: }
