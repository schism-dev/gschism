 4363:             else !simple upwind method
 4364:               do j=1,i34(ie)
 4365:                 jsj=elside(j,ie)
 4366:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 4367:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 4368:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 4369:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 4370:                   endif
 4371:                 enddo  !vertical layers
 4372:               enddo !j=1,i34(ie) ! side
 4373:             endif !order of accuracy
