  172: 
  173: 
  174: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  175:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  176:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  177: }
  178: 
  179: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  180:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  181:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  182: }
  183: 
  184: 
  185: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  186:    x3 = y1*z2 - y2*z1;
  187:    y3 = x2*z1 - x1*z2;
  188:    z3 = x1*y2 - x2*y1;
  189: }
  190: 
  191: 
  192: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  193: // Given a 3D global point (may not be on surface of earth), find its longitude and latitude in radians
  194: 
  195:    const double radius2 = dot(p, p);
  196:    assert(radius2 != 0.0     && "computeLonLat: radius = 0");
  197:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  198: 
  199:    rlon = atan2(p.y, p.x); // (-pi,pi]
  200: 
  201:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  202:       rlat = asin(p.z/sqrt(radius2));
  203:    } else {
  204:       rlat = asin(p.z/rearth_pole);
  205:    }
  206:   
  207: }
  208: 
  209: __inline__ __device__ void Error(const char* msg) {
  210:    printf("Error: %s\n", msg);
  211:    assert(false);
  212: }
  213: 
  214: struct Tracers {
  215:     double tracer[N_TRACERS];
  216: };
  217: 
  218: 
  219: 
  220: struct Frame {
  221:    double _t[9]; // t stands for tensor.
  222: 
  223:    // Access the tensor in Fortran order
  224:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  225: 
  226:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  227: 
  228:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  229: 
  230:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  231:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  232:       sincos(ar2, &sin_ar2, &cos_ar2);
  233: 
  234:       t(0,0) = -sin_ar1;
  235:       t(1,0) =  cos_ar1;
  236:       t(2,0) =  0.0;
  237:       t(0,1) = -cos_ar1*sin_ar2;
  238:       t(1,1) = -sin_ar1*sin_ar2;
  239: 
  240:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  241: 
  242:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  243:       assert (ar4!=0.0 && "GRID: ar4=0");
  244: 
  245:       const double ar4_inv = 1.0/ar4;
  246:       t(0,1) = t(0,1)*ar4_inv;
  247:       t(1,1) = t(1,1)*ar4_inv;
  248:       t(2,1) = t(2,1)*ar4_inv;
  249: 
  250:       // The third vector is the cross product of the first two
  251:       crossProduct(t(0,0), t(1,0), t(2,0), 
  252:                    t(0,1), t(1,1), t(2,1), 
  253:                    t(0,2), t(1,2), t(2,2));
  254:    }
  255: 
  256: 
  257:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  258:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  259:    // Inputs:
  260:    //        vec0: vel. in this frame;
  261:    //        frameout: Output frame;
  262:    // Output: 
  263:    //        vec1: vel. in new frame  
  264: 
  265:       auto const fo = frameout;
  266:       Vector2 vec1;
  267: 
  268:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  269:       // of t and fo.t are the same.
  270:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  271:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  272: 
  273:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  274:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  275: 
  276:       return vec1;
  277:    }
  278: 
  279:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  280:       // Transform a vector from global to local frame
  281:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  282:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  283:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  284:    }
  285: 
  286:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  287:       // Transform a vector from local to global frame
  288:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  289:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  290:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  291:    }   
  292: 
  293:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  294:    // Tranforms a point from global to local frame     
  295:       G2L(pi - origin0, po);
  296:    }
  297: 
  298:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  299:    // Transforms a point from local to global frame      
  300:       L2G(pi, po);
  301:       po = po + origin0;
  302:    }
  303: 
  304: };
