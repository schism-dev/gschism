 2835: 
 2836: __device__ void computeBottomDragVegetation(void) {
 2837:    // UNFINISHED. CHECK THIS:
 2838:    // How many kernels are needed? Why so many for loops?
 2839:    // Is the loop on sides needed?
 2840: 
 2841:    Node *node = NODE_PTR;
 2842: 
 2843:    const int    kb      = node->kb;
 2844:    const double htot    = node->htot();
 2845:    const double rough   = node->rough;
 2846: 
 2847: 
 2848:    if (node->idry) {
 2849:       // Default values for dry nodes
 2850:       node->veg_alpha_vert_mean = node->veg_alpha0;
 2851:       /// XXX CHECK INDICES
 2852:       if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 2853:    }
 2854: 
 2855:    // Compute bottom drag Cd
 2856:    //--------------------------------
 2857: 
 2858:    // nchi = {-1, 0, 1} is the type of bottom drag.
 2859:    if (nchi==1) {
 2860: 
 2861:       bool ltmp = false; // for WBL iteration
 2862: 
 2863:       // Cdmax=-1 !max. Cd at node for this process (info only)
 2864:       // Drag at nodes
 2865: /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 2866: // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 2867:      
 2868:       const double rough = node->rough;
 2869:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 2870:       if (node->rough == 0.0) {
 2871:          node->Cd = 0.0;
 2872: 
 2873:       } else { //roughness >0 
 2874:          
 2875:          const double bthick_ori = node->znl[kb + 1] - node->znl[kb];  // thickness of bottom bnd layer
 2876:          const double bthick = max(dzb_min, bthick_ori);
 2877: 
 2878:          assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 2879: 
 2880:          double tmp = 1.0/(2.5*log(bthick/rough));
 2881:          node->Cd = tmp*tmp;
 2882: 
 2883:       } // if rough
 2884: 
 2885: 
 2886:       // RECOVER THIS: XXX
 2887:       // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 2888:       // Output warning for WBL if iteration didn't converge
 2889: 
 2890: 
 2891:    } // nchi==1
 2892: 
 2893:    //   Bottom stress in m^2/s^2
 2894:    if (node->rho[kb + 1] >= -98.0)
 2895:    {
 2896:       const double mag_u = length(toVector2(node->u2[kb + 1]));
 2897:       node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 2898:       // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 2899:       // !sediment erosion: this part needs more documentation
 2900:    }
 2901: 
 2902:  
 2903:    // Compute vegetation parameters
 2904:    //--------------------------------
 2905: 
 2906:    // SAV constants
 2907:    constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 2908:    constexpr double veg_cfpsi = 0.16;
 2909: 
 2910:    // Add vertical variation to veg_alpha and compute vertical mean etc.
 2911:    if constexpr(iveg == 1) { //  Vertical variation specified by functions
 2912: 
 2913:       // Compute the vegetation "density" \alpha = D*N*Cd/2
 2914:       // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 2915:       int kbin = 0; // bin index
 2916:       for (int k = kb; k < nvrt; k++) {
 2917:          // Computes node height above the bottom level
 2918:          const double tmp_h = node->znl[k] - node->znl[kb]; // >=0
 2919:          assert(true && "Vertical variation of vegetation not implemented");
 2920: 
 2921:          // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 2922:          //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 2923:          //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 2924:          //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 2925:          // } else {
 2926:          //    // Find the bin at which the current vertical level is
 2927:          //    while (kbin<nbins_veg_vert) {
 2928:          //       const double zn = node->znl[kbin];
 2929:          //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 2930:          //          break;
 2931:          //       } // if
 2932:          //       kbin++;
 2933:          //    } // while
 2934:          //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 2935: 
 2936:          //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 2937:          //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 2938:             
 2939:          //    // Linear interpolation of the vegetation parameters
 2940:          //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 2941:          //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 2942:          //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 2943:          // } // if rl10
 2944: 
 2945:          // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 2946: 
 2947:       } // for k
 2948: 
 2949: 
 2950:    } else { // Ganthy (iveg=2)
 2951:    //  Modify canopy height, diameter, and density
 2952: 
 2953:       // Make sure there is vegetation on this node
 2954:       if (node->veg_h_unbent > 0.0) {
 2955:          const double wtmp2 = length(node->dav)*100.0; // cm/s
 2956: 
 2957:          node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 2958:                                 0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 2959:          node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 2960: 
 2961:          const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 2962:          node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 2963:          const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 2964:          node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 2965:       } // if veg_h_unbent
 2966: 
 2967:       for (int k = 0; k < nvrt; k++) {
 2968:          node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 2969:       } // for k
 2970:    
 2971: 
 2972:    } // if iveg
 2973:   
 2974:       
 2975: 
 2976:    // Compute vertical mean of veg_alpha3D
 2977:    if (iveg != 0) {
 2978:       const double ztop = node->zTopCanopy(); // Top of the canopy
 2979:       double sum1=0.0;
 2980:       double sum2=0.0;
 2981:       // Integrate over each level under the canopy...
 2982:       for (int k=kb; k<nvrt-1 && node->znl[k+1] <= zztop; k++) { /// XXX CHECK INDICES
 2983:          const double Dz = node->Dz(k);
 2984: 
 2985:          sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 2986:          sum2 += Dz;
 2987: 
 2988:       } // for k
 2989: 
 2990:       if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 2991:       else             node->veg_alpha_vert_mean = sum1/sum2;
 2992: 
 2993:    } // if iveg
 2994: 
 2995: }
 2996: 
 2997: __device__ void computeVegetationAndDragParameters(void) {
 2998:    // Computes the vegetation and drag model parameters:
 2999:    // chi, \tilde\chi, beta, \breve{H}
 3000:    
 3001:    Side *side = SIDE_PTR;
 3002: 
 3003:    const double htot = side->htot();
 3004:    const int    kb   = side->kb;
 3005: 
 3006:    assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 3007: 
 3008:    const double veg_h     = side->veg_h();
 3009:    const double veg_nv    = side->veg_nv();
 3010:    const double veg_c     = side->veg_c();
 3011:    const double veg_beta  = side->veg_beta;
 3012:    const double veg_alpha = side->veg_alpha_vert_mean();
 3013: 
 3014:    // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 3015:    // Velocity magnitude at the bottom level
 3016:    // XXXX Check if we have add -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 3017:    assert(true && "Must use backtracked velocity");
 3018:    const double vmag1 = length(side->u2[kb + 1]); //BACKTRACKED VELOCITY
 3019:    side->chi2 = side->Cd()*vmag1;
 3020:    side->chi  = side->chi2;
 3021:    if constexpr(iveg != 0) {
 3022:       const Node *n1 = side->n1;
 3023:       const Node *n2 = side->n2;
 3024:       const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 3025:       side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 3026:    }
 3027: 
 3028:    // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 3029: 
 3030:    // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 3031:    // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 3032:    double magUa = 0.0;
 3033:    if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 3034:       // 3D wet side with veg...
 3035: 
 3036:       double magUa = 0.0;
 3037:       for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 3038:          if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 3039: 
 3040:             // Velocity magnitude must be computed at the center of each level to perform the integration.
 3041:             // The tricky part is to compute that velocity at the level that may be partially submerged.
 3042:             const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 3043: 
 3044:             // Velocity magnitude at the top (h) of the level (may be partially submerged)
 3045:             const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 3046: 
 3047:             // Velocity magnitude at the bottom (l) of the level
 3048:             const double ul = length(side->u2[k]);
 3049: 
 3050:             const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 3051:             magUa += Dz*0.5*(uh + ul);
 3052: 
 3053:          } // if HasVegetation
 3054:       } // for k
 3055:       const double ua = magUa/min(htot, veg_h); // Vertical average
 3056: 
 3057:       // Computes beta, used for computing the stress term at the top of the canopy.      
 3058:       side->veg_c2 = veg_alpha*dt*ua; // >=0
 3059:       if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 3060:          const double zCpy = side->zTopCanopy();
 3061:          const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 3062:          const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 3063:          const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 3064:          const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 3065:          side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 3066:       } // if isSubmerged
 3067:    } // if iveg   
 3068: 
 3069:    // Computes the friction modified depth, \breve{H} in notes
 3070:    if (side->is2D()) { // 2D
 3071: 
 3072:       double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 3073:       if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 3074: 
 3075:       assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 3076: 
 3077:       side->hhat = htot*htot/fricH; 
 3078: 
 3079:    } else { // 3D
 3080:       side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 3081: 
 3082:       if constexpr(iveg != 0) {
 3083:          
 3084:          if (side->isSubmerged()) { 
 3085:             const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 3086:             side->hhat -= veg_c*Hhat_alpha;
 3087: 
 3088:          } else { // Emergent
 3089:             side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 3090:          }
 3091:       } // if iveg
 3092: 
 3093:       // Enforce positivity for 3D model
 3094:       if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 3095:    } // if 3D
 3096: 
 3097:      
 3098: }
 3099: 
 3100: 
 3101: 
 3102: __device__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 3103: // Computes the density gradient between two elements, e1 and e2.
 3104: // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 3105: // zero in the direction normal to the side. 
 3106: // 
 3107: // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 3108: // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 3109: //
 3110: // Input:
 3111: //    e1: Element
 3112: //    e2: Neighbor element (or nullptr if boundary)
 3113: //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 3114: //    k: Index of the half-level at which the density is interpolated
 3115: //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 3116: // 
 3117: // Output:
 3118: //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 3119: //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 3120: 
 3121:    if (e2 == nullptr || e2->idry) {
 3122:       // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 3123: 
 3124:       Side *side = e1->sides[j];
 3125:       assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->idry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 3126:               
 3127:       if constexpr(ics == 1) {
 3128:          vec = side->n; // Normal vector to the side
 3129:       } else {
 3130:          // IMPLEMENT THIS XXXXXX
 3131:          // !replace with xel, yel?
 3132:          //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 3133:          //      &eframe(:,:,i),xn1,yn1,tmp)
 3134:          //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 3135:          //      &eframe(:,:,i),xn2,yn2,tmp)
 3136:       } //ics
 3137:                 
 3138:       diffRho = 0.0;
 3139: 
 3140:    } else { //internal and wet
 3141:       if constexpr(ics==1) {
 3142:          assert(e2 != nullptr || e2->idry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 3143: 
 3144:          // Vector from e1 to e2
 3145:          vec = toVector2(e2->center - e1->center);
 3146: 
 3147:       } else { 
 3148:          // IMPLEMENT THIS XXXXXX
 3149:          //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 3150:          //      &eframe(:,:,i),xctr2,yctr2,tmp)
 3151:          //                   alow(j)=xctr2
 3152:          //                   bdia(j)=yctr2
 3153:       } // ics
 3154: 
 3155:       diffRho = rho2 - e1->demeanedDensity(k);
 3156:    }
 3157: 
 3158: }
 3159: 
 3160: __device__ void computeDensityCubicSplines(void) {
 3161:    // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 3162: 
 3163:    Element *elem = ELEM_PTR;
 3164:    if (elem->idry) return;
 3165: 
 3166:    const int kb = elem->kb;
 3167: 
 3168:    // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 3169:    if (elem->is2D()) {
 3170:       // In the 2D case, the density is constant at the prism level. 
 3171:       // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 3172:       elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 3173:    } else { //3D
 3174: 
 3175:       // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 3176:       auto getX = [elem] (int k) { return elem->z_prism(k); };
 3177:       auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 3178:       ///// XXXX CHECK INDICES!!!!!
 3179:       initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_zz, elem->rho_z);
 3180:    } // 2D/3D
 3181: 
 3182: }
 3183: 
 3184: __device__ double interpolateDensityAtHalfLevel(Element *elem, Element *elem2, int k, double &rho) {
 3185: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 3186: 
 3187:    if (elem2 == nullptr || elem2->idry) return 0.0;
 3188: 
 3189:    const int kb  = elem->kb;
 3190:    const int kb2 = elem2->kb;
 3191: 
 3192:    // z-coordinate of prism of elem
 3193:    const double zp = elem->z_prism(k);
 3194: 
 3195:    if (elem2->is2D()) {
 3196:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 3197: 
 3198:    } else {  // 3D
 3199: 
 3200:       // eta_min may be < zmax
 3201:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 3202:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 3203: 
 3204:       // (Extrapolate density below bottom, we will fix it later)
 3205:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 3206:       rho = evalCubicSpline(zp, elem->rho_z, elem->rho_zz, elem->demeanedDensity(k), extrapolate = true);
 3207:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 3208:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 3209:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 3210:    } // 2D/3D
 3211:      
 3212: 
 3213:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 3214:    // Now we need to fix it.
 3215:    if (elem->z[k] < elem2->z[kb2]) {
 3216:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 3217: 
 3218:       // There are two methods to adjust the density at the bottom of the element.
 3219:       // iunder_deep=0: 
 3220:       const double depth1 = abs(elem->z[kb]); // larger depth
 3221: 
 3222:       if (iunder_deep==0) {
 3223: 
 3224:          const double weight = max(0.0, min(1.0, (depth1 - elem->h1_bcc)/(elem->h2_bcc - elem->h1_bcc))); // weight
 3225: 
 3226:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 3227: 
 3228:       } else { // iunder_deep != 0
 3229: 
 3230:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 3231: 
 3232:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 3233: 
 3234:          //   Demeaned density at the same z coordinate as
 3235:                rho = elem->demeanedDensity(k) // would make cupp() below=0
 3236:          }
 3237: 
 3238:       } // if iunder_deep
 3239:    } // if elem->z[kb] < elem2->z[kb]
 3240: }
 3241: 
 3242: __device__ void computeDensityGradient(void) {
 3243: 
 3244:    // Compute the horizontal density gradient at each element.
 3245:    // It works in two steps:
 3246:    // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 3247:    // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 3248:    //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 3249:    //             gradRho.r1 = rho1 - rho0
 3250:    //             gradRho.r2 = rho2 - rho0
 3251:    //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 3252:    // 
 3253:    //  NOTE: We use de-meaned densities.
 3254: 
 3255:    Element *elem = ELEM_PTR;
 3256: 
 3257:    if (elem->idry) return;
 3258: 
 3259:    const int kb  = elem->kb;
 3260:    const int i34 = elem->i34;
 3261: 
 3262:    for (int k = kb + 1; k < nvrt; k++) {
 3263:       // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 3264:       //             gradRho.r1 = rho1 - rho0
 3265:       //             gradRho.r2 = rho2 - rho0
 3266:       int icount = 0;
 3267:       double sumRx = 0.0;
 3268:       double sumRy = 0.0;
 3269:       for (int j1=0; j1<i34; j1++) { 
 3270: 
 3271:          const int j2 = elem->nxq(j1 + 1);
 3272: 
 3273:          // Pairs of consecutive neighbor elements of elem
 3274:          const Element *e1 = elem->elems[j1];
 3275:          const Element *e2 = elem->elems[j2];
 3276: 
 3277:          // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 3278:          const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 3279:          const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 3280: 
 3281:          // Compute the density difference and the vector from elem to e1 and e2
 3282:          // getRhoDiffAndVec takes into account boundaries/dry elements
 3283:          double diffRho1, diffRho2;
 3284:          Vector2 vec1, vec2;
 3285:          getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 3286:          getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 3287: 
 3288:          const double rl1 = length(vec1);
 3289:          const double rl2 = length(vec2);
 3290:          assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 3291: 
 3292:          const double delta = cross(vec1, vec2);
 3293:          const double sintheta = abs(delta)/(rl1*rl2);
 3294: 
 3295:          // To avoid problems, avoid elements with small angle between vectors
 3296:          constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 3297:          const bool validEq = (sintheta > sin_one_deg);
 3298: 
 3299:          if (validEq) {
 3300:             // Solve the system of equations to get the density gradient at elem
 3301:             icount++;
 3302:             const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 3303:             const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 3304:             sumRx += Rx;
 3305:             sumRy += Ry;
 3306:          }
 3307:       } // for j1
 3308: 
 3309:       // Compute the average density gradient at elem
 3310:       if (icount==0) {
 3311:         // Bad mesh quality; bail out with 0 b-cc
 3312:         elem->gradRho[k] = {0.0, 0.0};
 3313:       } else {
 3314:         elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 3315:       }
 3316: 
 3317:    } // for k
 3318: 
 3319: }
 3320: 
 3321: __device__ void computeBaroclinicTerm(double rampbc) {
 3322: // Computes the baroclinic term at sides (at half levels).
 3323: // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 3324: // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 3325: 
 3326:    Side *side = SIDE_PTR;
 3327: 
 3328:    if (side->idry == 1) return;
 3329: 
 3330:    const Element *e1 = side->elements[0];
 3331:    const Element *e2 = side->elements[1];      
 3332:    const int kb = side->kb;
 3333:    
 3334:    assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 3335: 
 3336:    // interpolates vertically the density gradient of the two elements at the half level/
 3337: 
 3338:    // Starts the integration at the surface and goes down to the bottom
 3339:    int k1 = nvrt - 1;
 3340:    int k2 = nvrt - 1;
 3341: 
 3342:    side->bcc[nvrt-1] = {0.0, 0.0};
 3343:    for (int k = nvrt-1; k >= side->kbs; k--) {
 3344:    // For each prism level (from surface to bottom)...
 3345: 
 3346:       // For both elements, interpolate density gradient at the side's half level.
 3347:       // The gradient at the side is the average of the gradients at the elements.
 3348:       // w1, w2 are used to take into account boundary sides, with just one element.
 3349:       double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 3350:       double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 3351:       w1 = w1/(w1 + w2);
 3352:       w2 = w2/(w1 + w2);
 3353: 
 3354:       assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 3355: 
 3356:       // Linear interpolation of both elements' density gradient at the shared side's level.
 3357:       Vector2 gradRho = {0.0, 0.0};
 3358:       if (e1 != nullptr && k > kb) {
 3359:          // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 3360:          k1 = e1->findLevel(side->z[k], k1); // finds the index at the half level starting the search at k1
 3361:          const double zrat = (side->z[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 3362:          
 3363:          gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 3364:       }      
 3365:       if (e2 != nullptr && k > kb) {
 3366:          k2 = e2->findLevel(side->z[k], k2); // finds the index at the half level starting the search at k2
 3367:          const double zrat = (side->z[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 3368:          
 3369:          gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 3370:       }
 3371: 
 3372:       if constexpr(ics==2) {
 3373:          // IMPLEMENT THIS XXXXXX
 3374:          // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 3375:          // swild(1)=tmp1
 3376:          // swild(2)=tmp2
 3377:       }
 3378:       
 3379:       // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 3380:       // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 3381:       // CHECK INDICES!!! XXX
 3382:       const double grav3 = 0.5*(side->n1->grav2 + side->n2->grav2);
 3383:       side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 3384:    } // for
 3385: 
 3386: }
 3387: 
 3388: #ifdef DONTCOMPILE
 3389: __device__ void computeVerticalAdvection(void) {
 3390:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 3391: 
 3392:    sdbt(1:2,:,:)=0.d0
 3393: 
 3394:    const Side *side = FROM kernel;
 3395: 
 3396:    if(side->idry) return;
 3397: 
 3398:    // If side is wet...
 3399: 
 3400: 
 3401:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 3402:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 3403:    double ws[nvrt] = {} // w @ side
 3404:    int icount = 0;
 3405:    for (int j=0; j<2; j++) {
 3406:       const Element *elem = side->elements[j];
 3407:        
 3408:       if(elem != nullptr) {
 3409:          icount++;
 3410:          for (int k=0; k<nvrt; k++) {
 3411:             ws[k] = ws[k] + elem->w[k];
 3412:          }
 3413:       }
 3414:    }  // for j
 3415: 
 3416:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 3417:    ws = ws/icount;
 3418: 
 3419:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 3420:    // Splines allow for a smooth transition between vertical levels.
 3421:    // Splines have continuity restrictions at the internal knots, but
 3422:    // we have to provide the 1st derivatives at the endpoints.
 3423:    const int kbs = side->kbs; 
 3424:    
 3425:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3426:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3427:    initCubicSpline(kbs, nvrt, side, ws, up)
 3428: 
 3429:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 3430:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 3431:    initCubicSpline(kbs, nvrt, side, ws, vp)
 3432: 
 3433:    // Total advection (average onto side)
 3434:    const Node *node1 = side->nodes[0];
 3435:    const Node *node2 = side->nodes[1];
 3436:    for (int k=kbs(i); k<nvrt; k++) {
 3437: 
 3438:       if constexpr(ics==1) {
 3439:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 3440:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 3441:       } else {
 3442:          // XXX IMPLEMENT THIS
 3443:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 3444:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 3445:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 3446:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 3447:       }  // if ics
 3448: 
 3449: 
 3450:    }
 3451: }
 3452: #endif
 3453: 
 3454: __device__ void computeElemAverageGhat(void) {
 3455: // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 3456: 
 3457:    Element *elem = ELEM_PTR;
 3458:    
 3459:    elem->ghat1= {0.0, 0.0};  
 3460: 
 3461:    if constexpr(ihydraulics != 0) {
 3462:       if (nhtblocks > 0 && (elem->isblock > 0)) return;
 3463:    }
 3464: 
 3465:    if (elem->idry == 1) return;
 3466: 
 3467:    // Wet elements.
 3468:    // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 3469:    // tidal potential, horizontal diffusion, and baroclinic etc
 3470:    // Remember to update both fb and F 
 3471:    // If ics=2, ghat1 are in eframe (ll)
 3472:    // cff1-3: coefficients for 2D/3D
 3473:    Vector2 gradEta = {0.0, 0.0};  // \nabla \eta
 3474:    Vector2 gradPr  = {0.0, 0.0};  // \nabla pressure
 3475:    Vector2 gradEtp = {0.0, 0.0};  // \nabla etp
 3476: 
 3477:    double av_cff1 = 0.0;  // av. for cff1
 3478:    double av_cff2 = 0.0;  // av. for cff2
 3479:    double av_cff3 = 0.0;  // av. for cff3
 3480:    double av_df = 0.0;  // av. for H^\alpha / H
 3481:    double av_cff2_chi = 0.0;  // av. for cff2*chi
 3482:    double av_cff3_chi = 0.0;  // av. for cff3*chi
 3483: 
 3484:    const int i34 = elem->i34;
 3485: 
 3486:    for (int j=1; j<i34; j++) {
 3487:       // For each node and side in the element...
 3488: 
 3489:       const Node *node = elem->nodes[j];
 3490:       const Side *side = elem->sides[j];
 3491: 
 3492:       const double chi      = side->chi;
 3493:       const double veg_c2   = side->veg_c2;
 3494:       const double veg_beta = side->veg_beta;
 3495:       const double veg_h    = side->veg_h();
 3496:       const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 3497: 
 3498:       // Node - const in elem
 3499:       gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 3500:       gradPr  += node->pr  *elem->gradPhi[j];
 3501: 
 3502:       if (elem->depth >= tip_dp) {
 3503:         gradEtp += node->etp*elem->gradPhi[j];
 3504:       }
 3505: 
 3506:       
 3507:       const double htot  = side->htot();        // Total depth at the side
 3508:       const double zctr2 = side->zTopCanopy();  
 3509: 
 3510:       double cff1; 
 3511:       double cff2; 
 3512:       double cff3;   
 3513:       if (side->is2D()) {  // XXX Check indices, it used to have a +1
 3514:       // coefficients applied to 2D/3D case 
 3515:          cff1 = side->hhat/htot;
 3516:          cff2 = 0.0;
 3517:          cff3 = 0.0;
 3518:       } else { //3D
 3519:          //Init for no-veg case
 3520:          cff1 = 1.0;
 3521:          cff2 = 1.0;
 3522:          cff3 = 0.0;
 3523: 
 3524:          if constexpr(iveg != 0) {
 3525:             // Computes coefficients used with vegetation terms G1, G2
 3526:             // cff1, cff3 are used for the first two terms in G1, G2:
 3527:             // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 3528:             // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 3529:             // In general, cff1*Ustar - cff3*Ustar_alpha
 3530:             if(veg_h < 0.99*htot) { // submergent vegetation
 3531:                cff1=1;
 3532:                cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 3533:                cff3 = veg_c;
 3534: 
 3535:             } else { // emergent vegetation
 3536:                cff1 = 1.0/(1.0 + veg_c2);
 3537:                cff2 = cff1;
 3538:                cff3 = 0.0;
 3539: 
 3540:             }
 3541:          } // if iveg
 3542:       } //  2D/3D
 3543: 
 3544:       av_cff1 += cff1/i34;
 3545:       av_cff2 += cff2/i34;
 3546:       av_cff3 += cff3/i34;
 3547:       av_cff2_chi += cff2*chi/i34;
 3548:       av_cff3_chi += cff3*chi/i34;
 3549:       av_df += min(htot, veg_h)/(htot*i34);
 3550: 
 3551: 
 3552:       // btrack values: U^\star, U^{\star\alpha}
 3553:       // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 3554:       Vector2 Ustar       = {0.0, 0.0}; 
 3555:       Vector2 Ustar_alpha = {0.0, 0.0}; 
 3556:       for (int k = side->kb; k < nvrt; k++) {
 3557:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 3558:             Ustar += side->bt[nvrt]*side->Dz(k);
 3559: 
 3560:          } else { //3D
 3561:             Vector2 w2 = (side->bt[k] + side->bt[k-1])/2.0*side->Dz(k);
 3562:             Ustar += w2;
 3563: 
 3564:             if constexpr(iveg != 0) {
 3565:                 if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 3566:                     const double zrat = min(1.0, (zctr2 - side->zc[k-1])/side->Dz(k)); // For the top of the canopy, ratio of the level that is below the canopy
 3567:                     Ustar_alpha += zrat*w2; // XXXX
 3568:                 }
 3569:             }  // if iveg
 3570:          }  //2/3D
 3571:       }  //k
 3572:       
 3573: 
 3574:       // Add btrack & surface stress terms to \breve{G} first
 3575:       if constexpr(ics==1) {
 3576:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 3577:       } else {
 3578:          // XXX IMPLEMENT THIS
 3579:          // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 3580:          // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 3581:          // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 3582:       }  // if ics
 3583: 
 3584:       // Surface and bottom stress terms
 3585:       if constexpr(ics==1) {
 3586:          const Vector2 tau    = side->tau();
 3587:          const Vector2 ubstar = side->sdbt[side->kb+1]; // XXX CHECK INDICES
 3588:       } else {
 3589:          // XXX IMPLEMENT THIS
 3590:          // n1=isidenode(1,isd); n2=isidenode(2,isd)
 3591:          // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 3592:          // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 3593:          // tau_x=(vn1+tt1)/2.d0
 3594:          // tau_y=(vn2+ss1)/2.d0
 3595:          // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 3596:       }  // if ics
 3597: 
 3598:       // Term for surface and bottom stress
 3599:       elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 3600: 
 3601:       // All terms in F,F^\alpha,f_b except baroclinic
 3602:       // F, f_b: all explicit terms excluding vegetation 
 3603:       // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 3604:       // Only need to calculate F^\alpha for 3D sides (but init=0) 
 3605:       const double coriolis = side->cori;
 3606:       const Vector2 F  =  coriolis*side->U;  // F_x
 3607:       const Vector2 fb =  coriolis*side->u2;  // f_b_x
 3608:       Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 3609: 
 3610:       if (iveg != 0 && nvrt > side->kb) {  // 3D
 3611:          
 3612:          for (int k = side->kb; k < nvrt; k++) {
 3613:             if (zctr2 > side->z[k-1]) {
 3614:                 const Vector2 w2 = side->Dz[k]*(side->u2[k] + side->u2[k-1])/2.0;
 3615:                 const double zrat = min(1.0, (zctr2 - side->z[k-1])/side->Dz[k]);
 3616:                 Fa +=  coriolis*w2*zrat;
 3617:             } // if zctr2
 3618:          } // k
 3619:       } // iveg
 3620: 
 3621:       // Integrate horizontal viscosity vertically
 3622:       for (int k=side->kb; k<nvrt; k++) {
 3623:          const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.d0 // (d2uv(1,k,isd)+d2uv(1,k-1,isd))/2
 3624: 
 3625:          F += w2;
 3626: 
 3627:          // Vegetation term
 3628:          if constexpr(iveg!=0) {
 3629:             if (nvrt > side->kbs + 1 && zctr2 > side->z[k-1]) { // 3D
 3630:                const double zrat = min(1.0, (zctr2 - side->z[k-1])/side->Dz(k));
 3631:                Fa += w2*zrat;
 3632:             } 
 3633:          } // if iveg
 3634:       } // for k
 3635: 
 3636:       fb += side->d2uv[side->kb];
 3637: 
 3638: 
 3639:       // Add to ghat1
 3640:       if constexpr(ics==2) {
 3641:          // XXX IMPLEMENT THIS
 3642:          // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 3643:          // bigf1=vn1; bigf2=vn2
 3644:          // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 3645:          // botf1=vn1; botf2=vn2
 3646:          // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 3647:          // bigfa1=vn1; bigfa2=vn2
 3648:       } // if ics
 3649: 
 3650:       elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 3651:    } // for j (nodes and sides)
 3652: 
 3653:    elem->ghat1 = (1.0/i34)*elem->ghat1;
 3654:       
 3655:    // Finish off terms in F, F^\alpha and f_b
 3656:    const double grav3 = elem->mean(Element::grav2)
 3657:    const Vector2 fb = grav3*gradP - gradPr/rho0 //const in each elem
 3658: 
 3659: 
 3660:    Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 3661:    for (int j=1; j<i34; j++) { 
 3662:       // For each side in the element...
 3663:       const Side *side = elem->sides[j];
 3664: 
 3665:       const double htot = side->htot();
 3666:       const double F  = htot*fb;
 3667:       const double Fa = min(htot, veg_h)*fb;
 3668: 
 3669:       tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 3670:    } // for j
 3671: 
 3672:    //botf1 etc are already in elem frame
 3673:    elem->ghat1 += tmp/i34;
 3674: 
 3675:    // Baroclinic force
 3676:    if constexpr(ibc==0) {
 3677:       assert(elem->nodes[0]->rho >= -98.d0 && elem->nodes[1]->rho >= -98.d0 && elem->nodes[2]->rho >= -98.d0 && "computeElemAverageGhat1: Impossible dry");
 3678: 
 3679:       Vector2 Fa = {0.0, 0.0};
 3680:       Vector2 intGradRho = {0.0, 0.0};
 3681:       
 3682:       // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 3683:       for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 3684:          intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 3685: 
 3686:          // \in F [m^2/s/s]
 3687:          Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 3688:       }
 3689: 
 3690:       const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 3691:       const Vector2 F = av_df*Fa; //approx
 3692:       elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 3693: 
 3694:    } // if ibc
 3695: 
 3696: }
 3697: 
 3698: 
 3699: 
 3700: #ifdef DONTCOMPILE
 3701: __global__ void checkMassConservation(Tracers* sumtr) {
 3702: 
 3703:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 3704: 
 3705:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 3706: 
 3707:    Element *elem = &(mesh->localElemData[i]);
 3708: 
 3709:    // Skip dry elements
 3710:    if (elem->idry) return;
 3711: 
 3712:    // Local sum array for this thread
 3713:    double localSum[N_TRACERS] = {0.0};
 3714: 
 3715:    // Sum over vertical levels for this element
 3716:    const int kbe = elem->kbe;
 3717:    const double area = elem->area;
 3718: 
 3719:    for (int k = kbe; k < nvrt; k++) {
 3720:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 3721:       
 3722:       // Accumulate tracer mass
 3723:       for (int tr = 0; tr < N_TRACERS; tr++) {
 3724:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 3725:       }
 3726:    }
 3727: 
 3728:    
 3729: 
 3730:    //  This function returns per element sums. A reduction must be done on the host side.
 3731: }
 3732: 
 3733: 
 3734: __global__ void transport(void) {
 3735: 
 3736:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 3737: 
 3738:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 3739: 
 3740:    Element *elem = &(mesh->localElemData[ie]);
 3741: 
 3742:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 3743: 
 3744:                for (int m=0; m<ntr; m++) {
 3745:                   for (int k=kbe(ie); k<nvrt; k++) {
 3746:                      // Calculate each polynomial's weight 
 3747:                      wm=0.d0; sum1=0.d0; 
 3748:                      wm1=0.d0; wm2=0.d0; 
 3749:                      for (int i=0; i<elem->nweno2; i++) {
 3750:                   
 3751:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3752:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3753:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3754:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3755:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3756:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 3757:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 3758:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 3759:                      // -----------------Hu and Shu (1999)'s method----------------
 3760:                      b4=b1+b2+b3
 3761: 
 3762: //Error: add PRODUCTION CPP
 3763: #ifdef DEBUG
 3764:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 3765:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 3766:                     call parallel_abort(errmsg)
 3767:                   }
 3768: #endif
 3769: 
 3770:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 3771:                   // !----test-------------- 
 3772:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 3773:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 3774:                   // !wm(i)=wm1(i)*wm2(i)
 3775:                   // !---------------------- 
 3776:                   sum1=sum1+wm(i)
 3777:                 } // end for i
 3778: 
 3779:                 wm=wm/sum1
 3780: 
 3781:                 for (int j=0; j<elem->i34; j++) {
 3782: 
 3783:                   const Side *side  = elem->sides[j];
 3784:                   const Node *node1 = side->n1;
 3785:                   const Node *node2 = side->n2;
 3786: 
 3787:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 3788:                      trsd=0.d0
 3789:                      for (int kk=0; kk<nquad; kk++) {
 3790:                         for (int i=0; i<elem->nweno2; i++) {
 3791:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 3792:                         } // end for i   
 3793:                      } // end for kk
 3794:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 3795:                   } // outward flux
 3796:                } // end for j=1,i34(ie) ! side
 3797:             }
 3798:          }
 3799:               
 3800: 
 3801: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 3802: //             //   calculate each polynomial's weight 
 3803: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 3804: //                 wm=0.d0; sum1=0.d0
 3805: //                 do i=1,nweno1(ie) !for each polynomial
 3806: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 3807: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 3808: //                   b1=b1*b1+b2*b2 !smoothness indicator
 3809: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 3810: //                   wm(i)=b2
 3811: //                   sum1=sum1+b2
 3812: //                   !wm(i)=1.d0
 3813: //                   !sum1=sum1+1.d0
 3814: 
 3815: // // Error: PRODUCTION
 3816: // #ifdef DEBUG
 3817: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 3818: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 3819: //                     call parallel_abort(errmsg)
 3820: //                   endif
 3821: // #endif
 3822: 
 3823: //                 enddo !i
 3824: //                 wm=wm/sum1 !final weight
 3825: 
 3826:                 for (int j=0; j<elem->i34; j++) { // side
 3827:                   const Side *side = elem->sides[j];
 3828:                   const Node *node1 = side->n1;
 3829:                   const Node *node2 = side->n2;
 3830: 
 3831:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 3832:                     trsd=0.d0
 3833:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 3834:                       for (int i=0; i<elem->nweno1; i++) {
 3835:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 3836:                       }
 3837:                     enddo //kk
 3838:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 3839:                   } // outward flux
 3840:                 } // end for j=1,i34(ie) ! side
 3841:               } // end for k; ntr 
 3842: 
 3843:             else !simple upwind method
 3844:               do j=1,i34(ie)
 3845:                 jsj=elside(j,ie)
 3846:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 3847:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 3848:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 3849:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 3850:                   endif
 3851:                 enddo  !vertical layers
 3852:               enddo !j=1,i34(ie) ! side
 3853:             endif !order of accuracy
