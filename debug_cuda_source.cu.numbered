 2919: __device__ void computeVerticallyIntegratedVelocity(void) {
 2920: 
 2921:    Side *side = SIDE_PTR;
 2922: 
 2923:    side->U = {0.0, 0.0}; 
 2924:       
 2925:    if(side->idry) return;
 2926: 
 2927:    const Node *node1 = side->n1;
 2928:    const Node *node2 = side->n2;
 2929: 
 2930:    // Vertically integrated velocity U (in ll if ics=2)
 2931:    for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 2932:       side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 2933:    }
 2934: 
 2935: }
