 1353: 
 1354: /**
 1355:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1356:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1357:    If the segment is completely inside the element, then it returns true.
 1358: 
 1359:    This function assumes:
 1360:    - The initial point is on a side of the element. 
 1361:    - Its position is given by parameter t in the range [0,1].
 1362:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1363:       intersects the element (elements are convex).
 1364: 
 1365:    To find the intersection point, this function does the following:
 1366:    - it finds the intersection of the line segment with all the element side lines,
 1367:       except for the one that contains the initial point.
 1368:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1369:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1370:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1371:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1372:       track segment is almost parallel to the element side line.
 1373: 
 1374:    Inputs:
 1375:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1376:    @param x2, y2: other end of the line segment
 1377: 
 1378:    Outputs:
 1379:    @param side:  side that intersects the line segment (input and output)
 1380:    @param nextElement (output): element that contains the intersection point
 1381:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1382:    @param zint (input/output): Vertical coordinate of the intersection point
 1383: 
 1384:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1385:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1386:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1387: 
 1388:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1389:    (Delta) being zero.
 1390: 
 1391:    The intersection2 point happens when:
 1392:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1393:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1394:    
 1395:    Assumption: the 4 points (including those of the side segment) are different.
 1396:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1397:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1398:    If true, (xIntersect,yIntersect) is the intersection.				
 1399:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1400: **/
 1401: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1402:                                               double &t, double& tIntersect) {
 1403: 
 1404:    double closest_intersect_t = 1e10;
 1405:    bool found_intersection = false;
 1406: 
 1407:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1408:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1409:    const Point2 x1 = side->point(t);
 1410:    
 1411: 
 1412:    Side *nextSide = nullptr;
 1413:    for (int i = 0; i < i34; i++) {
 1414: 
 1415:       // Element's i-th side 
 1416:       Side *side2 = sides[i];
 1417: 
 1418:       // Skip the side that contains the initial point
 1419:       if (side2 == side) continue;
 1420: 
 1421:       // (x3,y3)-(x4,y4) is the element side line
 1422:       const Point2 x3 = side2->n1->p2();
 1423:       const Point2 x4 = side2->n2->p2();
 1424: 
 1425:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1426:       const double delta = cross(x2 - x1, x3 - x4);
 1427: 
 1428:       if (delta != 0.0) {
 1429: 
 1430:          const double delta1 = cross(x3 - x1, x3 - x4);
 1431:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1432: 
 1433:          // Solves the two linear equations for tt1 and tt2
 1434:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1435:          const double tt2 = delta2/delta;
 1436: 
 1437:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1438:             closest_intersect_t = min(closest_intersect_t, tt1);
 1439:             nextSide = side2;
 1440: 
 1441:             nextElement = nextSide->otherElem(this);
 1442:             tIntersect = max(small, min(tt1, 1.0-small));
 1443:             t = tt2;
 1444: 
 1445:             found_intersection = true;
 1446:          }
 1447:       
 1448:       }
 1449: 
 1450:    }
 1451:    
 1452: printf("AAA 1, found_intersection = %d, nextSide = %p, nextElement = %p\n", found_intersection, nextSide, nextElement);
 1453: 
 1454: 
 1455:    // found_intersection should always be true, since we checked all the sides.  
 1456:    side = nextSide;
 1457: // if (found_intersection) {
 1458: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1459: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1460: // }   
 1461:    // if (!found_intersection) {
 1462:    //    // Check if the segment is parallel to the initial side
 1463:    //    printf("XXX segment: side = %p\n", side);
 1464:    //    printf("XXX %f\n", dot(x2 - x1, side->n1->p2() - side->n2->p2()));
 1465:    //    if (abs(dot(x2 - x1, side->n1->p2() - side->n2->p2())) < small) {
 1466:    //       assert(false && "Segment is parallel to the initial side");
 1467:    //       found_intersection = true;
 1468:    //       nextElement = side->otherElem(this);
 1469:    //       tIntersect = t;
 1470:    //       t = 0.0;
 1471:    //       found_intersection = true;
 1472:    //    }
 1473:    // }
 1474:    return found_intersection;
 1475: }
 1476: 
 1477: 
 1478: 
 1479: 
 1480: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1481:                                               double &t, double& tIntersect) {
 1482: 
 1483:    double closest_intersect_t = 1e10;
 1484:    bool found_intersection = false;
 1485: 
 1486: double minDelta = 1e10; 
 1487: double btt1, btt2;
 1488:    for (int i = 0; i < i34; i++) {
 1489: 
 1490:       Side *side2 = sides[i];
 1491: 
 1492:       // (x3,y3)-(x4,y4) is the element side line
 1493:       const Point2 x3 = side2->n1->p2();
 1494:       const Point2 x4 = side2->n2->p2();
 1495: 
 1496:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1497:       const double delta = cross(x2 - x1, x3 - x4);
 1498: 
 1499:       if (abs(delta) > 0) {
 1500: 
 1501:          const double delta1 = cross(x3 - x1, x3 - x4);
 1502:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1503: 
 1504:          // Solves the two linear equations for tt1 and tt2
 1505:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1506:          const double tt2 = delta2/delta;
 1507: 
 1508: if (abs(delta) < minDelta) {
 1509:    minDelta = abs(delta);
 1510:    btt1 = tt1;
 1511:    btt2 = tt2;
 1512: }
 1513: double small = 1e-7;
 1514:          printf("RRRRRR tt1 = %e, tt2 = %e\n", tt1, tt2);
 1515:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1516:             closest_intersect_t = min(closest_intersect_t, tt1);
 1517:             side = side2;
 1518:             nextElement = side->otherElem(this);
 1519:             t = tt2;
 1520:             tIntersect = max(small, min(tt1, 1.0-small));
 1521:             found_intersection = true;
 1522:          }
 1523:       
 1524:       }
 1525:       else {  // parallel segments
 1526:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1527:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1528: 
 1529:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1530: 
 1531:          // const double dist = dot(x1 - x3, side2->n);
 1532:          // if (abs(dist) < small*length(x3 - x4)) {
 1533:          //    const double2 unitarySide = normalize(x4 - x3);
 1534:          //    const double len = dot(x2 - x1, unitarySide);
 1535:          //    t = t + len;
 1536:          //    t = max(0.0, min(t, 1.0));
 1537:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1538: 
 1539: 
 1540:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1541:          //    // t = tt2;
 1542:          //    found_intersection = true;
 1543:          // }
 1544:       }
 1545: 
 1546: 
 1547:    }
 1548: 
 1549:    if (!found_intersection) {
 1550:       
 1551:       printf("ZZ No intersection found:\n"
 1552:            "Element %d\n"
 1553:            "in = %d\n"
 1554:            "minDelta = %e\n"
 1555:            "tt1 = %e, tt2 = %e\n"
 1556:            "segment: (%f, %f)-(%f, %f)\n"
 1557:            "Vertices:\n"
 1558:          //   "  Nodes nextElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n"
 1559:            "  Nodes curElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n",
 1560:            IDX(nextElement),
 1561:            (btt1 >= -small && btt2 >= -small && btt2 <= 1.0 + small && btt1 <= 1.0 + small),
 1562:            minDelta,
 1563:            btt1, btt2,
 1564:            x1.x, x1.y,
 1565:            x2.x, x2.y,
 1566:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1567:          //   nextElement->nodes[1]->p.x, nextElement->nodes[1]->p.y,
 1568:          //   nextElement->nodes[2]->p.x, nextElement->nodes[2]->p.y,
 1569:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1570:            nodes[0]->p.x, nodes[0]->p.y,
 1571:            nodes[1]->p.x, nodes[1]->p.y,
 1572:            nodes[2]->p.x, nodes[2]->p.y,
 1573:            nodes[0]->p.x, nodes[0]->p.y);
 1574: 
 1575:    }
 1576: 
 1577:    // assert(found_intersection && "No intersection found");
 1578: 
 1579:    // found_intersection should always be true, since we checked all the sides.  
 1580:    return found_intersection;
 1581: }
 1582: 
 1583: 
 1584: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1585:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1586: 
 1587:    printf("Tracking segment goes out of water at element %d\n", curElem->idx);
 1588: 
 1589:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1590:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1591:    // curElement.
 1592: 
 1593:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1594:    // And uses this velocity instead to continue the tracking.
 1595: 
 1596:    // computes the intersection point in cartesian coordinates
 1597:    Point2 intersection = nextSide->p_t(tt);
 1598: 
 1599:    // Nudges the point to the barycenter of the element. 
 1600:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1601:    // next segment intersects the element sides.  
 1602:    curElem->nudgeToBarycenter(intersection);
 1603: 
 1604:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1605:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1606:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1607:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1608: 
 1609:    // If the side is an open boundary, the tangential velocity is zero.
 1610:    if (nextSide->isBnd()) vtan = 0.0;
 1611: 
 1612:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1613:    const double us = vtan*nextSide->t().x;
 1614:    const double vs = vtan*nextSide->t().y;
 1615:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1616: 
 1617:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1618:    const double len2 = length(intersection - toPoint2(xt));
 1619:    const double vel2 = u_int.x*u_int.x + u_int.y*u_int.y;        
 1620:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 1621:    else            dt = 0.0;
 1622: 
 1623:    // The end of this tracking segment is now the intersection point.
 1624:    xt = {intersection.x, intersection.y, zint};
 1625: printf("BBB u_int = %f,%f,%f\n", us, vs, ws);   
 1626:    u_int = {us, vs, ws};
 1627:    
 1628: }
 1629: 
 1630: /**
 1631:  * Tracks a particle through elements and vertical levels in the mesh.
 1632:  * 
 1633:  * @param x0,y0,z0     Starting position coordinates
 1634:  * @param xt,yt,zt     Target position coordinates
 1635:  * @param dtb          Time step for tracking
 1636:  * @param uuint,vvint,wwint Initial velocity components
 1637:  * @param nextElem     Starting/resulting element index
 1638:  * 
 1639:  * @return Status code of type trackExitCodes
 1640:  * 
 1641:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1642:  * of the details are different. The idea is that the code requires less branches and is better fit
 1643:  * for GPU execution.
 1644:  * 
 1645:  * The main ideas here are:
 1646:  * - The starting point is expected to be in the starting element.
 1647:  * - The end point is guaranteed to be inside an element.
 1648:  * - since the starting point is inside the element, there are only two cases: 
 1649:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1650:  *     (b) it does not and (xt,yt) is already in the starting element.
 1651:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1652:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1653:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1654:  * - tt1 can be positive or negative. We only consider the positive values.
 1655:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1656:  * - The next intersection will occur at the smallest positive tt1.
 1657:  * - This intersection will be the next (x0,y0) position.
 1658:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1659:  *   of getting stuck in a loop.
 1660:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1661:  *   was found.
 1662:  */
 1663: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1664:                                                        Element *&nextElem, int &jlev, double &dt) {
 1665: 
 1666:    // First thing is to check if the target point is inside the element. If it is there is nothing
 1667:    // else to do.
 1668: 
 1669:    const Element *curElem = nextElem;
 1670:    if (containsPoint(toPoint2(xt))) {
 1671:       curElem->interpolateVelocities(xt, u_int);
 1672:       return true;
 1673:    }
 1674: 
 1675:    Side *side = nullptr;
 1676: 
 1677:    // 1. Initial checks
 1678:    // Verify starting element is valid (wet)
 1679:    assert(!curElem->isDry && "Starting element is dry");
 1680: 
 1681:    // Checks if track has a zero length.
 1682:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1683:    // assert(len2 > 0.0 && "Zero length track"); 
 1684:    
 1685:    const int MAX_ITERATIONS = 1000;
 1686:    
 1687:    double t;
 1688:    Side *nextSide = nullptr;
 1689:    double tIntersect = 1e10;
 1690:    double zint = x0.z;
 1691: 
 1692:    // Horizontal tracking loop
 1693:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1694:    // (x0,y0) is inside the element but the target point is not.
 1695: 
 1696:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1697: 
 1698:    if (!found_intersection) {
 1699: double shpCoords_0[4];
 1700: double shpCoords_t[4];
 1701: computeShapeCoords(toPoint2(x0), shpCoords_0, false);
 1702: computeShapeCoords(toPoint2(xt), shpCoords_t, false);
 1703:       printf("No intersection found (containsPoint = %d, %d [%.17g, %.17g, %.17g] [%.17g, %.17g, %.17g]):\n"
 1704:            "Elements %d, %d\n"
 1705:            "Side %d\n"
 1706:            "segment: (%f, %f),(%f, %f)\n"
 1707:            "triangle node indices: %d, %d, %d\n"
 1708:            "triangle: (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n",
 1709:            containsPoint(toPoint2(x0)), containsPoint(toPoint2(xt)),
 1710:            shpCoords_0[0], shpCoords_0[1], shpCoords_0[2],
 1711:            shpCoords_t[0], shpCoords_t[1], shpCoords_t[2],
 1712:            IDX(curElem), IDX(nextElem),
 1713:            IDX(nextSide),
 1714:            x0.x, x0.y,
 1715:            xt.x, xt.y,
 1716:            curElem->nodes[0]->idx, curElem->nodes[1]->idx, curElem->nodes[2]->idx,
 1717:            curElem->nodes[0]->p.x, curElem->nodes[0]->p.y,
 1718:            curElem->nodes[1]->p.x, curElem->nodes[1]->p.y,
 1719:            curElem->nodes[2]->p.x, curElem->nodes[2]->p.y,
 1720:            curElem->nodes[0]->p.x, curElem->nodes[0]->p.y);
 1721:    }
 1722:    assert(found_intersection && "No intersection found at %d");
 1723: 
 1724:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1725: 
 1726:    // if the tracking segment goes out of water (either dry or edge boundary)
 1727:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1728: 
 1729: 
 1730:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1731:       nextElem = this;
 1732:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1733:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1734:       return true;    
 1735:    }
 1736: 
 1737: 
 1738:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1739:    int iterations = 0;
 1740:    while (iterations < MAX_ITERATIONS) {
 1741:       iterations++;
 1742:       
 1743:       Element *curElem = nextElem;
 1744: 
 1745:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1746: 
 1747:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1748: 
 1749:       // If we are already in the target element, we are done.
 1750:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1751:       if (!found_intersection) break;
 1752: 
 1753: 
 1754: 
 1755:       // if the tracking segment goes out of water (either dry or edge boundary).
 1756:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1757: 
 1758:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1759: 
 1760:          nextElem = curElem;
 1761: 
 1762: 
 1763:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1764:          // In this case, the caller (btrack) needs to take into account the remaining time.
 1765:          return true;
 1766:       }
 1767:       
 1768:       // Update position and element for next iteration
 1769:       side = nextSide;
 1770: 
 1771:    }
 1772: 
 1773:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 1774: 
 1775:  
 1776:    // Interpolate velocities at the final position. This is a conceptually simple step,
 1777:    // but the function is not simple, because it has to search for the vertical level containing zt.
 1778:    nextElem->interpolateVelocities(xt, u_int);
 1779: 
 1780: 
 1781:    return true;
 1782: }
 1783: 
 1784: 
 1785: 
 1786: 
 1787: __inline__ __device__ double Element::computeSignedArea(void) const {
 1788:    // Compute the area of the element
 1789: 
 1790:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 1791: 
 1792:    // In the quad case we need to add the area of the other triangle.
 1793:    if (isQuad()) {
 1794:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1795:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 1796:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1797:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 1798:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 1799:          Error("Negative area found in quad element");
 1800:       }
 1801:       res += ar1;
 1802:    }
 1803: 
 1804:    return res;
 1805: }
 1806: 
 1807: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 1808:    // In boundary sides, the element 1 is nullptr
 1809:    return side->elems[1] == nullptr; 
 1810: }
 1811: 
 1812: 
 1813: 
 1814: /**
 1815:    Compute the shape coordinates of the point (xt,yt) in the element.
 1816:    @param xt (input): x-coordinate of the point
 1817:    @param shpCoords (output): shape coordinates of the point
 1818:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 1819:    @return true if the point is inside the element, false otherwise
 1820: **/
 1821: __device__ bool Element::computeShapeCoords(Point2 xt, double shpCoords[4],
 1822:                                             bool fixNegshpCoord) const {
 1823: 
 1824:    // Compute the shape coordinates of the point xt in the element.
 1825:    if (i34==3) {
 1826:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 1827:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 1828:       // and in this case, the pt will be nudged into the element
 1829:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 1830:       // from the local frame, so use additional check.
 1831: 
 1832:       Point2 x0, x1, x2;
 1833: 
 1834:       if constexpr(ics==1) {
 1835:          x0 = nodes[0]->p2();
 1836:          x1 = nodes[1]->p2();
 1837:          x2 = nodes[2]->p2();
 1838:       }
 1839:       else // lat/lon
 1840:       {
 1841:          Error("Not implemented yet");
 1842: #ifdef ICS2
 1843:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 1844:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 1845:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 1846: #endif
 1847:       }
 1848: 
 1849:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 1850:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 1851:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 1852:       shpCoords[3] = 0.0;
 1853:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 1854: 
 1855:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 1856:       // then we fix the negative shape coordinates.
 1857:       if (fixNegshpCoord && tmpmin<=0.0) {
 1858: 
 1859:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 1860:          // keeping the sum of the shape coordinates equal to 1.
 1861:          // I have tested and compared the new algorithm with the old one, and they give
 1862:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 1863:          // The new algorithm should be faster since it is branchless.
 1864:          const double a = - tmpmin + 1.0e-2;  // XXX it used to be 1.0e-4 in the comments of the original code
 1865:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 1866:          
 1867:          shpCoords[0] = (shpCoords[0] + a)*b;
 1868:          shpCoords[1] = (shpCoords[1] + a)*b;
 1869:          shpCoords[2] = (shpCoords[2] + a)*b;          
 1870: 
 1871:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 1872:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 1873:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 1874:          }
 1875: 
 1876:          // Update the point coordinates for the new shape coordinates
 1877:          double xcoords[3] = {x0.x, x1.x, x2.x};
 1878:          double ycoords[3] = {x0.y, x1.y, x2.y};
 1879:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 1880: 
 1881:       }
 1882: 
 1883:       // Check if the point is inside the element
 1884:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 1885:    }
 1886:    else {
 1887:       Error("Not implemented yet");
 1888: #ifdef QUADS
 1889:       // Reproject pt in eframe of nel for ics=2
 1890:       if constexpr(ics==1) {
 1891:          xn2 = xt; 
 1892:          yn2 = yt;
 1893:       }
 1894:       else {
 1895:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 1896:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 1897:       }
 1898: 
 1899:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 1900: #endif
 1901:    }
 1902: 
 1903:    return false;  // Never reached
 1904: 
 1905: }
 1906: 
 1907: 
 1908: /**  Interpolate velocities at a given point (xt,yt,zt)
 1909: 
 1910:    @param xt, yt, zt: coordinates of the point to interpolate
 1911:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 1912: 
 1913:    This is done in four steps:
 1914: 
 1915:    1. Find the shape coordinates for the final position in the element.
 1916:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 1917:    3. Perform a *binary search* to find the vertical level containing zt. It will have to interpolate the 
 1918:       z levels at xt, yt at each step.   
 1919:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 1920:       horizontally and vertically.
 1921: **/
 1922: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 1923:    // Interpolate the velocities at the point xt. 
 1924:    // This function works the same for triangular and quadrilateral elements.
 1925:    double shpCoord[4];
 1926: 
 1927: 
 1928:    // First step is to compute the shape coordinates of (xt,yt)
 1929:    computeShapeCoords(toVector2(xt), shpCoord, false);
 1930:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 1931: 
 1932:    // Second step is to find the level that contains zt
 1933:    // Uses a binary search to find the level
 1934:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 1935:    int L = kbe;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 1936:    int R = nvrt - 1;
 1937: 
 1938:    // Get the z coordinates at the nodes of the element at the levels L and R
 1939:    double zLAtNodes[4], zRAtNodes[4];
 1940:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 1941:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 1942: 
 1943:    double zL = interpolate(shpCoord, zLAtNodes);
 1944:    double zR = interpolate(shpCoord, zRAtNodes);
 1945:    
 1946:    // Interpolates vertically the velocities
 1947:    double wght1, wght2;
 1948:    if (xt.z<=zL) {
 1949:       wght1 = 1.0;
 1950:       wght2 = 0.0;
 1951:    }
 1952:    else if (xt.z>=zR) {
 1953:       wght1 = 0.0;
 1954:       wght2 = 1.0;
 1955:    }
 1956:    else {
 1957:       // Perform a binary search to find the levels between L and R that contain xt.z
 1958:       while (R - L > 1) {
 1959:          int M = (L + R) / 2;
 1960: 
 1961:          double zMAtNodes[4];
 1962:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 1963:          double zM = interpolate(shpCoord, zMAtNodes);
 1964:          if (zM < xt.z) 
 1965:          {
 1966:             L = M;
 1967:             zL = zM;
 1968:          }
 1969:          else 
 1970:          {
 1971:             R = M;
 1972:             zR = zM;
 1973:          }
 1974:       }
 1975:       assert(L == R-1);
 1976:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 1977: 
 1978:       wght2 = (xt.z - zL)/(zR - zL);
 1979:       wght1 = 1.0 - wght2;
 1980:    }
 1981: // printf("$$$ wght1 = %f, wght2 = %f, zt = %f, zL = %f, zR = %f\n", wght1, wght2, zt, zL, zR);
 1982: // printf("$$$ shpCoord = %f, %f, %f, %f\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 1983:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 1984:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 1985: 
 1986:    // Neither of the interpolated velocities should be NaN
 1987:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 1988: 
 1989: }
 1990: 
 1991: 
 1992: 
 1993: __inline__ __device__ double Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 1994: __inline__ __device__ double Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 1995: __inline__ __device__ Point2 Side::p_t(double t) const { return {x(t), y(t)}; }
 1996: __inline__ __device__ int    Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 1997: __inline__ __device__ double Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 1998: __inline__ __device__ double Side::depth(void)   const { return 0.5*(n1->depth + n2->depth); }
 1999: 
 2000: __inline__ __device__ double Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 2001: __inline__ __device__ double Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 2002: __inline__ __device__ double Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 2003: 
 2004: 
 2005: __inline__ __device__ double Side::Cd(void)      const { if constexpr(nchi != 0) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 2006: 
 2007: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 2008: 
 2009: /**
 2010:  * This method performs backtracking from the side center until a time -dt back in time 
 2011:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2012:  * intermediate point.
 2013:  *
 2014:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2015:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2016:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2017:  * remaining time.
 2018:  * 
 2019:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2020:  * 
 2021:  * @param uuint, vvint, wwint: Velocities at the final point
 2022:  * @param jlev: Level at which the backtracking is performed
 2023:  * @param dt, dtbk: Tracking timesteps
 2024:  * @return: True if the backtracking was successful, false otherwise
 2025:  */
 2026: __inline__ __device__ bool Side::btrack(
 2027:       int jlev,
 2028:       double dt,            // Tracking time
 2029:       double dtbk,          // Tracking timestep
 2030:       Vector3 &u_int
 2031: ) const {
 2032: 
 2033:    // Start from side center
 2034:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2035:  
 2036: 
 2037:    double time_rm = dt; // Remaining time
 2038: 
 2039: 
 2040:    // // Initialize outputs XXX
 2041:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2042:    //    sclr[i] = 0.0;
 2043:    // }
 2044: 
 2045: 
 2046:    // Initial velocities
 2047:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 2048: 
 2049: // printf("YY 1, u_int = %f,%f\n", u_int.x, u_int.y);
 2050: 
 2051:    // Find the element that is in the direction opposite to the velocity
 2052:    Element* curElem = findElementTowards({u_int.x, u_int.y});
 2053: // printf("YY 2, curElem = %p\n", curElem);
 2054:    const int MAX_ITERATIONS = 1000; 
 2055:    Element* nextElem = curElem;
 2056:    int iter = 0;
 2057:    while(true) {
 2058:       // Calculate timestep
 2059:       double dtb = min(dtbk, time_rm);
 2060: 
 2061:       // Next point in the backtracking curve
 2062:       Point3 xt = x0 - dtb*u_int;
 2063: // printf("YY 3, dtb = %f, curElem = %p, u_int = %f,%f,%f\n", dtb, curElem, u_int.x, u_int.y, u_int.z);
 2064:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb);
 2065: // printf("YY 4, found = %d\n", found);
 2066:       assert(found && "Backtracking failed in btrack");
 2067: // printf("<>T = %f, %f %f %f\n", time_rm - dtb, xt, yt, zt);
 2068:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2069:                       // then time_rm needs to be increased by the unused time.
 2070:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2071: 
 2072:       // The current point becomes the next segment's starting point.
 2073:       x0 = xt;
 2074:  
 2075:       curElem = nextElem;
 2076: 
 2077:       iter++;
 2078:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2079:    }
 2080: 
 2081: 
 2082: }
 2083: 
