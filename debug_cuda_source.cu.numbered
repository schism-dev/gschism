 3612:    __global__ void computeVerticallyIntegratedVelocity(void) {
 3613: 
 3614:       SIDE(side);
 3615: 
 3616: 
 3617:       side->U = {0.0, 0.0}; 
 3618:          
 3619:       if(side->isDry) return;
 3620: 
 3621:       const Node *node1 = side->n1;
 3622:       const Node *node2 = side->n2;
 3623: 
 3624:       // Vertically integrated velocity U (in ll if ics=2)
 3625:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 3626:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 3627:       }
 3628: 
 3629:    }
 3630: 
 3631:    __global__ void computeBottomDragVegetation(void) {
 3632:       // UNFINISHED. CHECK THIS:
 3633:       // How many kernels are needed? Why so many for loops?
 3634:       // Is the loop on sides needed?
 3635: 
 3636:       NODE(node);
 3637: 
 3638:       const int    kb      = node->kb;
 3639:       const double htot    = node->htot();
 3640:       const double rough   = node->rough;
 3641: 
 3642: 
 3643:       if (node->isDry) {
 3644:          // Default values for dry nodes
 3645:          node->veg_alpha_vert_mean = node->veg_alpha0;
 3646:          /// XXX CHECK INDICES
 3647:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 3648:       }
 3649: 
 3650:       // Compute bottom drag Cd
 3651:       //--------------------------------
 3652: 
 3653:       // nchi = {-1, 0, 1} is the type of bottom drag.
 3654:       if (nchi==1) {
 3655: 
 3656:          bool ltmp = false; // for WBL iteration
 3657: 
 3658:          // Cdmax=-1 !max. Cd at node for this process (info only)
 3659:          // Drag at nodes
 3660:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 3661:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 3662:         
 3663:          const double rough = node->rough;
 3664:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3665:          if (node->rough == 0.0) {
 3666:             node->Cd = 0.0;
 3667: 
 3668:          } else { //roughness >0 
 3669:             
 3670:             const double bthick_ori = node->znl[kb + 1] - node->znl[kb];  // thickness of bottom bnd layer
 3671:             const double bthick = max(dzb_min, bthick_ori);
 3672: 
 3673:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 3674: 
 3675:             double tmp = 1.0/(2.5*log(bthick/rough));
 3676:             node->Cd = tmp*tmp;
 3677: 
 3678:          } // if rough
 3679: 
 3680: 
 3681:          // RECOVER THIS: XXX
 3682:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 3683:          // Output warning for WBL if iteration didn't converge
 3684: 
 3685: 
 3686:       } // nchi==1
 3687: 
 3688:       //   Bottom stress in m^2/s^2
 3689:       if (node->rho[kb + 1] >= -98.0)
 3690:       {
 3691:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 3692:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 3693:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 3694:          // !sediment erosion: this part needs more documentation
 3695:       }
 3696: 
 3697:     
 3698:       // Compute vegetation parameters
 3699:       //--------------------------------
 3700: 
 3701:       // SAV constants
 3702:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 3703:       constexpr double veg_cfpsi = 0.16;
 3704: 
 3705:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 3706:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 3707: 
 3708:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 3709:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 3710:          int kbin = 0; // bin index
 3711:          for (int k = kb; k < nvrt; k++) {
 3712:             // Computes node height above the bottom level
 3713:             const double tmp_h = node->znl[k] - node->znl[kb]; // >=0
 3714:             assert(false && "Vertical variation of vegetation not implemented");
 3715: 
 3716:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 3717:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 3718:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 3719:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 3720:             // } else {
 3721:             //    // Find the bin at which the current vertical level is
 3722:             //    while (kbin<nbins_veg_vert) {
 3723:             //       const double zn = node->znl[kbin];
 3724:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 3725:             //          break;
 3726:             //       } // if
 3727:             //       kbin++;
 3728:             //    } // while
 3729:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 3730: 
 3731:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 3732:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 3733:                
 3734:             //    // Linear interpolation of the vegetation parameters
 3735:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 3736:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 3737:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 3738:             // } // if rl10
 3739: 
 3740:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 3741: 
 3742:          } // for k
 3743: 
 3744: 
 3745:       } else { // Ganthy (iveg=2)
 3746:       //  Modify canopy height, diameter, and density
 3747: 
 3748:          // Make sure there is vegetation on this node
 3749:          if (node->veg_h_unbent > 0.0) {
 3750:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 3751: 
 3752:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 3753:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 3754:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 3755: 
 3756:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 3757:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 3758:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 3759:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 3760:          } // if veg_h_unbent
 3761: 
 3762:          for (int k = 0; k < nvrt; k++) {
 3763:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 3764:          } // for k
 3765:       
 3766: 
 3767:       } // if iveg
 3768:      
 3769:          
 3770: 
 3771:       // Compute vertical mean of veg_alpha3D
 3772:       if (iveg != 0) {
 3773:          const double ztop = node->zTopCanopy(); // Top of the canopy
 3774:          double sum1=0.0;
 3775:          double sum2=0.0;
 3776:          // Integrate over each level under the canopy...
 3777:          for (int k=kb; k<nvrt-1 && node->znl[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 3778:             const double Dz = node->Dz(k);
 3779: 
 3780:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 3781:             sum2 += Dz;
 3782: 
 3783:          } // for k
 3784: 
 3785:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 3786:          else             node->veg_alpha_vert_mean = sum1/sum2;
 3787: 
 3788:       } // if iveg
 3789: 
 3790:       printf("computeBottomDragVegetation: nodeIdx = %d, node->veg_alpha_vert_mean = %f\n", node->idx, node->veg_alpha_vert_mean);
 3791: 
 3792:    }
 3793: 
 3794:    __global__ void computeVegetationAndDragParameters(void) {
 3795:       // Computes the vegetation and drag model parameters:
 3796:       // chi, \tilde\chi, beta, \breve{H}
 3797:       
 3798:       SIDE(side);
 3799: 
 3800:       const double htot = side->htot();
 3801:       const int    kb   = side->kb;
 3802: 
 3803:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 3804: 
 3805:       const double veg_h     = side->veg_h();
 3806:       const double veg_nv    = side->veg_nv();
 3807:       const double veg_c     = side->veg_c();
 3808:       const double veg_beta  = side->veg_beta;
 3809:       const double veg_alpha = side->veg_alpha_vert_mean();
 3810: 
 3811:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 3812:       // Velocity magnitude at the bottom level
 3813:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 3814:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 3815:       side->chi2 = side->Cd()*vmag1;
 3816:       side->chi  = side->chi2;
 3817:       if constexpr(iveg != 0) {
 3818:          const Node *n1 = side->n1;
 3819:          const Node *n2 = side->n2;
 3820:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 3821:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 3822:       }
 3823: 
 3824:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 3825: 
 3826:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 3827:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 3828:       double magUa = 0.0;
 3829:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 3830:          // 3D wet side with veg...
 3831: 
 3832:          double magUa = 0.0;
 3833:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 3834:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 3835: 
 3836:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 3837:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 3838:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 3839: 
 3840:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 3841:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 3842: 
 3843:                // Velocity magnitude at the bottom (l) of the level
 3844:                const double ul = length(side->u2[k]);
 3845: 
 3846:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 3847:                magUa += Dz*0.5*(uh + ul);
 3848: 
 3849:             } // if HasVegetation
 3850:          } // for k
 3851:          const double ua = magUa/min(htot, veg_h); // Vertical average
 3852: 
 3853:          // Computes beta, used for computing the stress term at the top of the canopy.      
 3854:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 3855:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 3856:             const double zCpy = side->zTopCanopy();
 3857:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 3858:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 3859:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 3860:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 3861:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 3862:          } // if isSubmerged
 3863:       } // if iveg   
 3864: 
 3865:       // Computes the friction modified depth, \breve{H} in notes
 3866:       if (side->is2D()) { // 2D
 3867: 
 3868:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 3869:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 3870: 
 3871:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 3872: 
 3873:          side->hhat = htot*htot/fricH; 
 3874: 
 3875:       } else { // 3D
 3876:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 3877: 
 3878:          if constexpr(iveg != 0) {
 3879:             
 3880:             if (side->isSubmerged()) { 
 3881:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 3882:                side->hhat -= veg_c*Hhat_alpha;
 3883: 
 3884:             } else { // Emergent
 3885:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 3886:             }
 3887:          } // if iveg
 3888: 
 3889:          // Enforce positivity for 3D model
 3890:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 3891:       } // if 3D
 3892: 
 3893:       printf("computeVegetationAndDragParameters: sideIdx = %d, side->htot = %f, side->hhat = %f\n", side->idx, side->htot(), side->hhat);
 3894: 
 3895:         
 3896:    }
 3897: 
 3898: 
 3899: 
 3900:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 3901:    // Computes the density gradient between two elements, e1 and e2.
 3902:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 3903:    // zero in the direction normal to the side. 
 3904:    // 
 3905:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 3906:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 3907:    //
 3908:    // Input:
 3909:    //    e1: Element
 3910:    //    e2: Neighbor element (or nullptr if boundary)
 3911:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 3912:    //    k: Index of the half-level at which the density is interpolated
 3913:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 3914:    // 
 3915:    // Output:
 3916:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 3917:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 3918: 
 3919:       if (e2 == nullptr || e2->isDry) {
 3920:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 3921: 
 3922:          Side *side = e1->sides[j];
 3923:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 3924:                  
 3925:          if constexpr(ics == 1) {
 3926:             vec = side->n; // Normal vector to the side
 3927:          } else {
 3928:             // IMPLEMENT THIS XXXXXX
 3929:             // !replace with xel, yel?
 3930:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 3931:             //      &eframe(:,:,i),xn1,yn1,tmp)
 3932:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 3933:             //      &eframe(:,:,i),xn2,yn2,tmp)
 3934:          } //ics
 3935:                    
 3936:          diffRho = 0.0;
 3937: 
 3938:       } else { //internal and wet
 3939:          if constexpr(ics==1) {
 3940:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 3941: 
 3942:             // Vector from e1 to e2
 3943:             vec = toVector2(e2->center - e1->center);
 3944: 
 3945:          } else { 
 3946:             // IMPLEMENT THIS XXXXXX
 3947:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 3948:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 3949:             //                   alow(j)=xctr2
 3950:             //                   bdia(j)=yctr2
 3951:          } // ics
 3952: 
 3953:          diffRho = rho2 - e1->demeanedDensity(k);
 3954:       }
 3955: 
 3956:    }
 3957: 
 3958:    __global__ void computeDensityCubicSplines(void) {
 3959:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 3960: 
 3961:       ELEM(elem);
 3962: 
 3963:       if (elem->isDry) return;
 3964: 
 3965:       const int kb = elem->kb;
 3966: 
 3967:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 3968:       if (elem->is2D()) {
 3969:          // In the 2D case, the density is constant at the prism level. 
 3970:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 3971:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 3972:       } else { //3D
 3973: 
 3974:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 3975:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 3976:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 3977:          ///// XXXX CHECK INDICES!!!!!
 3978:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 3979:       } // 2D/3D
 3980: 
 3981:    }
 3982: } // extern "C"
 3983: 
 3984: 
 3985: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 3986: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 3987: 
 3988:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 3989: 
 3990:    const int kb  = elem->kb;
 3991:    const int kb2 = elem2->kb;
 3992: 
 3993:    // z-coordinate of prism of elem
 3994:    const double zp = elem->z_prism(k);
 3995: 
 3996:    double rho = 0.0;
 3997: 
 3998:    if (elem2->is2D()) {
 3999:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4000: 
 4001:    } else {  // 3D
 4002: 
 4003:       // eta_min may be < zmax
 4004:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4005:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4006: 
 4007:       // (Extrapolate density below bottom, we will fix it later)
 4008:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4009:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4010:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4011:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4012:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4013:    } // 2D/3D
 4014:      
 4015: 
 4016:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4017:    // Now we need to fix it.
 4018:    if (elem->z[k] < elem2->z[kb2]) {
 4019:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4020: 
 4021:       // There are two methods to adjust the density at the bottom of the element.
 4022:       // iunder_deep=0: 
 4023:       const double depth1 = abs(elem->z[kb]); // larger depth
 4024: 
 4025:       if (iunder_deep==0) {
 4026: 
 4027:          const double weight = max(0.0, min(1.0, (depth1 - h1_bcc)/(h2_bcc - h1_bcc))); // weight
 4028: 
 4029:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4030: 
 4031:       } else { // iunder_deep != 0
 4032: 
 4033:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4034: 
 4035:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4036: 
 4037:          //   Demeaned density at the same z coordinate as
 4038:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4039:          }
 4040: 
 4041:       } // if iunder_deep
 4042:    } // if elem->z[kb] < elem2->z[kb]
 4043: 
 4044:    return rho;
 4045: }
 4046: 
 4047: 
 4048: extern "C" {
 4049:    __global__ void computeDensityGradient(void) {
 4050: 
 4051:          // Compute the horizontal density gradient at each element.
 4052:       // It works in two steps:
 4053:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4054:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4055:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4056:       //             gradRho.r1 = rho1 - rho0
 4057:       //             gradRho.r2 = rho2 - rho0
 4058:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4059:       // 
 4060:       //  NOTE: We use de-meaned densities.
 4061: 
 4062:       ELEM(elem);
 4063: 
 4064:       if (elem->isDry) return;
 4065: 
 4066:       const int kb  = elem->kb;
 4067:       const int i34 = elem->i34;
 4068: 
 4069:       for (int k = kb + 1; k < nvrt; k++) {
 4070:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 4071:          //             gradRho.r1 = rho1 - rho0
 4072:          //             gradRho.r2 = rho2 - rho0
 4073:          int icount = 0;
 4074:          double sumRx = 0.0;
 4075:          double sumRy = 0.0;
 4076:          for (int j1=0; j1<i34; j1++) { 
 4077: 
 4078:             const int j2 = elem->nxq(j1 + 1);
 4079: 
 4080:             // Pairs of consecutive neighbor elements of elem
 4081:             const Element *e1 = elem->nghbElems[j1];
 4082:             const Element *e2 = elem->nghbElems[j2];
 4083: 
 4084:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 4085:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 4086:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 4087: 
 4088:             // Compute the density difference and the vector from elem to e1 and e2
 4089:             // getRhoDiffAndVec takes into account boundaries/dry elements
 4090:             double diffRho1, diffRho2;
 4091:             Vector2 vec1, vec2;
 4092:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 4093:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 4094: 
 4095:             const double rl1 = length(vec1);
 4096:             const double rl2 = length(vec2);
 4097:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 4098: 
 4099:             const double delta = cross(vec1, vec2);
 4100:             const double sintheta = abs(delta)/(rl1*rl2);
 4101: 
 4102:             // To avoid problems, avoid elements with small angle between vectors
 4103:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 4104:             const bool validEq = (sintheta > sin_one_deg);
 4105: 
 4106:             if (validEq) {
 4107:                // Solve the system of equations to get the density gradient at elem
 4108:                icount++;
 4109:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 4110:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 4111:                sumRx += Rx;
 4112:                sumRy += Ry;
 4113:             }
 4114:          } // for j1
 4115: 
 4116:          // Compute the average density gradient at elem
 4117:          if (icount==0) {
 4118:            // Bad mesh quality; bail out with 0 b-cc
 4119:            elem->gradRho[k] = {0.0, 0.0};
 4120:          } else {
 4121:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 4122:          }
 4123: 
 4124:       } // for k
 4125: 
 4126:    }
 4127: 
 4128:    __global__ void computeBaroclinicTerm(void) {
 4129:    // Computes the baroclinic term at sides (at half levels).
 4130:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 4131:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 4132: 
 4133:       SIDE(side);
 4134: 
 4135:       if (side->isDry) return;
 4136: 
 4137:       const Element *e1 = side->elems[0];
 4138:       const Element *e2 = side->elems[1];      
 4139:       const int kb = side->kb;
 4140:       
 4141:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 4142: 
 4143:       // interpolates vertically the density gradient of the two elements at the half level/
 4144: 
 4145:       // Starts the integration at the surface and goes down to the bottom
 4146:       int k1 = nvrt - 1;
 4147:       int k2 = nvrt - 1;
 4148: 
 4149:       side->bcc[nvrt-1] = {0.0, 0.0};
 4150:       for (int k = nvrt-1; k >= kb; k--) {
 4151:       // For each prism level (from surface to bottom)...
 4152: 
 4153:          // For both elements, interpolate density gradient at the side's half level.
 4154:          // The gradient at the side is the average of the gradients at the elements.
 4155:          // w1, w2 are used to take into account boundary sides, with just one element.
 4156:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 4157:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 4158:          const double wsum = w1 + w2;
 4159:          w1 = w1/wsum;
 4160:          w2 = w2/wsum;
 4161:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 4162: 
 4163:          // Linear interpolation of both elements' density gradient at the shared side's level.
 4164:          Vector2 gradRho = {0.0, 0.0};
 4165:          if (e1 != nullptr && k > kb) {
 4166:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 4167:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 4168:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 4169:             
 4170:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 4171:          }      
 4172:          if (e2 != nullptr && k > kb) {
 4173:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4174:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4175:             
 4176:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4177:          }
 4178: 
 4179:          if constexpr(ics==2) {
 4180:             // IMPLEMENT THIS XXXXXX
 4181:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4182:             // swild(1)=tmp1
 4183:             // swild(2)=tmp2
 4184:          }
 4185:          
 4186:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4187:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4188:          // CHECK INDICES!!! XXX
 4189:          const double grav3 = 0.5*(side->n1->grav2 + side->n2->grav2);
 4190:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4191:       } // for
 4192: 
 4193:    }
 4194: 
 4195: 
 4196: 
 4197:    __global__ void computeHorGradientAtSide(void) {
 4198: 
 4199:       // Compute the horizontal density gradient at each element.
 4200:       // It works in two steps:
 4201:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4202:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4203:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4204:       //             gradRho.r1 = rho1 - rho0
 4205:       //             gradRho.r2 = rho2 - rho0
 4206:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4207:       // 
 4208:       //  NOTE: We use de-meaned densities.
 4209: 
 4210:       SIDE(side);
 4211: 
 4212:       if (side->isDry) return;
 4213: 
 4214:       Vector2 gradEta1 = {0.0, 0.0};
 4215:       Vector2 gradEta2 = {0.0, 0.0};
 4216:       Vector2 gradETP  = {0.0, 0.0};   
 4217:       Vector2 gradPr   = {0.0, 0.0};
 4218: 
 4219:       // These are used to compute the average of the gradients.
 4220:       int icount1 = 0;
 4221:       int icount2 = 0;
 4222:       int icount3 = 0;
 4223: 
 4224:       // For both elements that share the side... (or, maybe just one)
 4225:       for (int ie = 0; ie < 2; ie++) {
 4226:          const Element *elem = side->elems[ie];
 4227:          if (elem != nullptr) {
 4228:             if (!(elem->isDry2())) {
 4229:                gradEta2 += elem->grad(Node::eta2);
 4230:                icount2++;
 4231:             }
 4232:             if (!(elem->isDry)) {
 4233: 
 4234:                if (elem->depth >= tip_dp) {
 4235:                   icount3++;
 4236:                   gradETP  += elem->grad(Node::ETP);
 4237:                }
 4238:                icount1++;                  
 4239:                gradEta1 += elem->grad(Node::eta1); 
 4240:                gradPr   += elem->grad(Node::pr);
 4241:             }
 4242:          }
 4243:       }
 4244: 
 4245: 
 4246:       if constexpr(ics == 2) {
 4247:          // XXX IMPLEMENT THIS
 4248:          assert(false && "computeHorGradientAtSide: ics = 2 not implemented");
 4249:       }
 4250: 
 4251:    }
 4252: 
 4253: 
 4254: } // extern "C"
 4255: 
 4256: #ifdef DONTCOMPILE
 4257: __device__ void computeVerticalAdvection(void) {
 4258:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 4259: 
 4260:    sdbt(1:2,:,:)=0.d0
 4261: 
 4262:    const Side *side = FROM kernel;
 4263: 
 4264:    if(side->isDry) return;
 4265: 
 4266:    // If side is wet...
 4267: 
 4268: 
 4269:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 4270:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 4271:    double ws[nvrt] = {} // w @ side
 4272:    int icount = 0;
 4273:    for (int j=0; j<2; j++) {
 4274:       const Element *elem = side->elements[j];
 4275:        
 4276:       if(elem != nullptr) {
 4277:          icount++;
 4278:          for (int k=0; k<nvrt; k++) {
 4279:             ws[k] = ws[k] + elem->w[k];
 4280:          }
 4281:       }
 4282:    }  // for j
 4283: 
 4284:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 4285:    ws = ws/icount;
 4286: 
 4287:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 4288:    // Splines allow for a smooth transition between vertical levels.
 4289:    // Splines have continuity restrictions at the internal knots, but
 4290:    // we have to provide the 1st derivatives at the endpoints.
 4291:    const int kbs = side->kbs; 
 4292:    
 4293:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 4294:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 4295:    initCubicSpline(kbs, nvrt, side, ws, up)
 4296: 
 4297:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 4298:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 4299:    initCubicSpline(kbs, nvrt, side, ws, vp)
 4300: 
 4301:    // Total advection (average onto side)
 4302:    const Node *node1 = side->nodes[0];
 4303:    const Node *node2 = side->nodes[1];
 4304:    for (int k=kbs(i); k<nvrt; k++) {
 4305: 
 4306:       if constexpr(ics==1) {
 4307:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 4308:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 4309:       } else {
 4310:          // XXX IMPLEMENT THIS
 4311:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 4312:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 4313:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 4314:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 4315:       }  // if ics
 4316: 
 4317: 
 4318:    }
 4319: }
 4320: #endif
