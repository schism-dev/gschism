 1259:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1260:       // Compute the different time ramps used in the code 
 1261:       // This function is performed by just one thread
 1262: 
 1263:       if constexpr(ibc == 0) {
 1264:          if (drampbc > 0.0) {
 1265:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1266:          } else {
 1267:             rampbc = 1.0;
 1268:          }
 1269: 
 1270:          if (nws != 0 && drampwind > 0.0) {
 1271:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1272:          } else {
 1273:             rampwind = 1.0;
 1274:          }
 1275:       }
 1276: 
 1277:       if (drampwafo > 0.0) {
 1278:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1279:       } else {
 1280:          rampwafo = 1.0;
 1281:       }
 1282: 
 1283:       // For source/sinks
 1284:       if (if_source && dramp_ss > 0.0) {
 1285:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1286:       } else {
 1287:          ramp_ss = 1.0;
 1288:       }
 1289: 
 1290:       if (dramp > 0.0) {
 1291:          ramp = tanh(2.0*time/86400.0/dramp);
 1292:       } else {
 1293:          ramp = 1.0;
 1294:       }
 1295: 
 1296:       printf("computeTimeRamps: i = %d, nws = %d, if_source = %d, drampbc = %f, drampwind = %f, drampwafo = %f, dramp_ss = %f, dramp = %f\n", 
 1297:              threadIdx.x + blockIdx.x * blockDim.x, nws, if_source, drampbc, drampwind, drampwafo, dramp_ss, dramp);
 1298:    }
