 1051:       printf("npgb = %d, negb = %d, nsgb = %d, nseg = %d\n", npgb, negb, nsgb, nseg);
 1052:       printf("np = %d, ne = %d, ns = %d\n", np, ne, ns);
 1053:       printf("max_np = %d, max_ne = %d, max_ns = %d\n", max_np, max_ne, max_ns);
 1054:       printf("nvrt = %d, kz = %d\n", nvrt, kz);
 1055:       printf("elemsPtr = %p, elems = %p\n", *elems, elemsMem);
 1056:       
