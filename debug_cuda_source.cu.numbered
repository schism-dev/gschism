 1006: __device__ __forceinline__ void update_bdef(double time, double x0, double y0, double &dep, Vector3 &vel) {
 1007:    // For imm=2, user needs to update bottom depth and velocity
 1008: 
 1009:    dep = min(1.0, 7.0 - (x0 + time));
 1010:    vel = { -1.0, 0.0, 0.0 };
 1011: 
 1012: }
 1013: 
 1014: 
 1015: /**
 1016:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1017:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1018:    If the segment is completely inside the element, then it returns true.
 1019: 
 1020:    This function assumes:
 1021:    - The initial point is on a side of the element. 
 1022:    - Its position is given by parameter t in the range [0,1].
 1023:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1024:       intersects the element (elements are convex).
 1025: 
 1026:    To find the intersection point, this function does the following:
 1027:    - it finds the intersection of the line segment with all the element side lines,
 1028:       except for the one that contains the initial point.
 1029:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1030:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1031:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1032:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1033:       track segment is almost parallel to the element side line.
 1034: 
 1035:    Inputs:
 1036:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1037:    @param x2, y2: other end of the line segment
 1038: 
 1039:    Outputs:
 1040:    @param side:  side that intersects the line segment (input and output)
 1041:    @param nextElement (output): element that contains the intersection point
 1042:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1043:    @param zint (input/output): Vertical coordinate of the intersection point
 1044: 
 1045:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1046:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1047:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1048: 
 1049:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1050:    (Delta) being zero.
 1051: 
 1052:    The intersection2 point happens when:
 1053:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1054:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1055:    
 1056:    Assumption: the 4 points (including those of the side segment) are different.
 1057:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1058:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1059:    If true, (xIntersect,yIntersect) is the intersection.				
 1060:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1061: **/
 1062: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1063:                                               double &t, double& tIntersect) {
 1064: 
 1065:    double closest_intersect_t = 1e10;
 1066:    bool found_intersection = false;
 1067: 
 1068:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1069:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1070:    const Point2 x1 = side->point(t);
 1071:    
 1072: 
 1073:    Side *nextSide = nullptr;
 1074: 
 1075:    for (int i = 0; i < i34; i++) {
 1076: 
 1077:       // Element's i-th side 
 1078:       Side *side2 = sides[i];
 1079: 
 1080:       // Skip the side that contains the initial point
 1081:       if (side2 == side) continue;
 1082: 
 1083:       // (x3,y3)-(x4,y4) is the element side line
 1084:       const Point2 x3 = side2->n1->p2();
 1085:       const Point2 x4 = side2->n2->p2();
 1086: 
 1087:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1088:       const double delta = cross(x2 - x1, x3 - x4);
 1089: 
 1090:       if (delta != 0.0) {
 1091: 
 1092:          const double delta1 = cross(x3 - x1, x3 - x4);
 1093:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1094: 
 1095:          // Solves the two linear equations for tt1 and tt2
 1096:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1097:          const double tt2 = delta2/delta;
 1098: 
 1099:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1100:             closest_intersect_t = min(closest_intersect_t, tt1);
 1101:             nextSide = side2;
 1102: 
 1103:             nextElement = nextSide->otherElement(this);
 1104:             tIntersect = max(small, min(tt1, 1.0-small));
 1105:             t = tt2;
 1106: 
 1107:             found_intersection = true;
 1108:          }
 1109:       
 1110:       }
 1111: 
 1112:    }
 1113: 
 1114: 
 1115:    // found_intersection should always be true, since we checked all the sides.  
 1116:    side = nextSide;
 1117: // if (found_intersection) {
 1118: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1119: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1120: // }   
 1121:    return found_intersection;
 1122: }
 1123: 
 1124: 
 1125: 
 1126: 
 1127: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1128:                                               double &t, double& tIntersect) {
 1129: 
 1130:    double closest_intersect_t = 1e10;
 1131:    bool found_intersection = false;
 1132: 
 1133:    for (int i = 0; i < i34; i++) {
 1134: 
 1135:       Side *side2 = sides[i];
 1136: 
 1137:       // (x3,y3)-(x4,y4) is the element side line
 1138:       const Point2 x3 = side2->n1->p2();
 1139:       const Point2 x4 = side2->n2->p2();
 1140: 
 1141:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1142:       const double delta = cross(x2 - x1, x3 - x4);
 1143: 
 1144:       if (delta != 0.0) {
 1145: 
 1146:          const double delta1 = cross(x3 - x1, x3 - x4);
 1147:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1148: 
 1149:          // Solves the two linear equations for tt1 and tt2
 1150:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1151:          const double tt2 = delta2/delta;
 1152: 
 1153:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1154:             closest_intersect_t = min(closest_intersect_t, tt1);
 1155:             side = side2;
 1156:             nextElement = side->otherElement(this);
 1157:             t = tt2;
 1158:             tIntersect = max(small, min(tt1, 1.0-small));
 1159:             found_intersection = true;
 1160:          }
 1161:       
 1162:       }
 1163: 
 1164:    }
 1165: 
 1166: // if (found_intersection) {
 1167: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1168: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1169: // }
 1170: 
 1171:    // found_intersection should always be true, since we checked all the sides.  
 1172:    return found_intersection;
 1173: }
 1174: 
 1175: 
 1176: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1177:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1178: 
 1179:    printf("Tracking segment goes out of water at element %d\n", curElem->idx);
 1180: 
 1181:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1182:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1183:    // curElement.
 1184: 
 1185:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1186:    // And uses this velocity instead to continue the tracking.
 1187: 
 1188:    // computes the intersection point in cartesian coordinates
 1189:    Point2 intersection = nextSide->p_t(tt);
 1190: 
 1191:    // Nudges the point to the barycenter of the element. 
 1192:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1193:    // next segment intersects the element sides.  
 1194:    curElem->nudgeToBarycenter(intersection);
 1195: 
 1196:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1197:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1198:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1199:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1200: 
 1201:    // If the side is an open boundary, the tangential velocity is zero.
 1202:    if (nextSide->isBnd()) vtan = 0.0;
 1203: 
 1204:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1205:    const double us = vtan*nextSide->t().x;
 1206:    const double vs = vtan*nextSide->t().y;
 1207:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1208: 
 1209:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1210:    const double len2 = length(intersection - toPoint2(xt));
 1211:    const double vel2 = u_int.x*u_int.x + u_int.y*u_int.y;        
 1212:    assert(vel2 > 0.0 && "Zero velocity found");
 1213:    dt = dt - sqrt(len2/vel2); 
 1214: 
 1215:    // The end of this tracking segment is now the intersection point.
 1216:    xt = {intersection.x, intersection.y, zint};
 1217:    
 1218:    u_int = {us, vs, ws};
 1219:    
 1220: }
 1221: 
 1222: /**
 1223:  * Tracks a particle through elements and vertical levels in the mesh.
 1224:  * 
 1225:  * @param x0,y0,z0     Starting position coordinates
 1226:  * @param xt,yt,zt     Target position coordinates
 1227:  * @param dtb          Time step for tracking
 1228:  * @param uuint,vvint,wwint Initial velocity components
 1229:  * @param nextElem     Starting/resulting element index
 1230:  * 
 1231:  * @return Status code of type trackExitCodes
 1232:  * 
 1233:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1234:  * of the details are different. The idea is that the code requires less branches and is better fit
 1235:  * for GPU execution.
 1236:  * 
 1237:  * The main ideas here are:
 1238:  * - The starting point is expected to be in the starting element.
 1239:  * - The end point is guaranteed to be inside an element.
 1240:  * - since the starting point is inside the element, there are only two cases: 
 1241:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1242:  *     (b) it does not and (xt,yt) is already in the starting element.
 1243:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1244:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1245:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1246:  * - tt1 can be positive or negative. We only consider the positive values.
 1247:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1248:  * - The next intersection will occur at the smallest positive tt1.
 1249:  * - This intersection will be the next (x0,y0) position.
 1250:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1251:  *   of getting stuck in a loop.
 1252:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1253:  *   was found.
 1254:  */
 1255: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1256:                                                        Element *&nextElem, int &jlev, double &dt) {
 1257: // printf("trackThroughElementsAndLevels: x0=%f, y0=%f, xt=%f, yt=%f\n", x0, y0, xt, yt);
 1258:    // First thing is to check if the target point is inside the element. If it is there is nothing
 1259:    // else to do.
 1260:    if (containsPoint(toPoint2(xt))) {
 1261:       nextElem->interpolateVelocities(xt, u_int);
 1262:       return true;
 1263:    }
 1264: 
 1265:    Side *side = nullptr;
 1266: 
 1267:    // 1. Initial checks
 1268:    // Verify starting element is valid (wet)
 1269:    assert(!nextElem->idry && "Starting element is dry");
 1270: 
 1271:    // Checks if track has a zero length.
 1272:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1273:    assert(len2 > 0.0 && "Zero length track"); 
 1274:    
 1275: 
 1276:    const int MAX_ITERATIONS = 1000;
 1277:    
 1278:    double t;
 1279:    Side *nextSide = nullptr;
 1280:    double tIntersect = 1e10;
 1281:    double zint = x0.z;
 1282: 
 1283:    // Horizontal tracking loop
 1284:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1285:    // (x0,y0) is inside the element but the target point is not.
 1286:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1287:    assert(found_intersection && "No intersection found");
 1288: 
 1289:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1290: 
 1291:    // if the tracking segment goes out of water (either dry or edge boundary)
 1292:    if (isEdgeBoundary(nextSide) || (nextElem->idry)) {
 1293:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1294:       nextElem = this;
 1295:       
 1296:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1297:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1298:       return true;    
 1299:       }
 1300: 
 1301:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1302:    int iterations = 0;
 1303:    while (iterations < MAX_ITERATIONS) {
 1304:       iterations++;
 1305:       
 1306:       Element *curElem = nextElem;
 1307: 
 1308:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1309:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1310: 
 1311:       // If we are already in the target element, we are done.
 1312:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1313:       if (!found_intersection) break;
 1314: 
 1315: 
 1316:   
 1317:       // if the tracking segment goes out of water (either dry or edge boundary).
 1318:       if (curElem->isEdgeBoundary(nextSide) || (nextElem->idry)) {
 1319: 
 1320:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1321: 
 1322:          nextElem = curElem;
 1323: 
 1324:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1325:          // In this case, the caller (btrack) needs to take into account the remaining time.
 1326:          return true;
 1327:       }
 1328:       
 1329:       // Update position and element for next iteration
 1330:       side = nextSide;
 1331: 
 1332:    }
 1333: 
 1334: 
 1335:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 1336: 
 1337:  
 1338:    // Interpolate velocities at the final position. This is a conceptually simple step,
 1339:    // but the function is not simple, because it has to search for the vertical level containing zt.
 1340:    nextElem->interpolateVelocities(xt, u_int);
 1341: 
 1342: 
 1343:    return true;
 1344: }
 1345: 
 1346: 
 1347: 
 1348: 
 1349: __inline__ __device__ double Element::computeSignedArea(void) const {
 1350:    // Compute the area of the element
 1351: 
 1352:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 1353: 
 1354:    // In the quad case we need to add the area of the other triangle.
 1355:    if (isQuad()) {
 1356:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1357:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 1358:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1359:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 1360:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 1361:          Error("Negative area found in quad element");
 1362:       }
 1363:       res += ar1;
 1364:    }
 1365: 
 1366:    return res;
 1367: }
 1368: 
 1369: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 1370:    // In boundary sides, the element 1 is nullptr
 1371:    return side->elems[1] == nullptr; 
 1372: }
 1373: 
 1374: /**
 1375:    Compute the shape coordinates of the point (xt,yt) in the element.
 1376:    @param xt (input): x-coordinate of the point
 1377:    @param shpCoords (output): shape coordinates of the point
 1378:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 1379:    @return true if the point is inside the element, false otherwise
 1380: **/
 1381: __device__ bool Element::computeShapeCoords(Point2 xt, double shpCoords[4],
 1382:                                             bool fixNegshpCoord) const {
 1383: 
 1384:    // Compute the shape coordinates of the point xt in the element.
 1385:    if (i34==3) {
 1386:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 1387:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 1388:       // and in this case, the pt will be nudged into the element
 1389:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 1390:       // from the local frame, so use additional check.
 1391: 
 1392:       Point2 x0, x1, x2;
 1393: 
 1394:       if constexpr(ics==1) {
 1395:          x0 = nodes[0]->p2();
 1396:          x1 = nodes[1]->p2();
 1397:          x2 = nodes[2]->p2();
 1398:       }
 1399:       else // lat/lon
 1400:       {
 1401:          Error("Not implemented yet");
 1402: #ifdef ICS2
 1403:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 1404:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 1405:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 1406: #endif
 1407:       }
 1408: 
 1409:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 1410:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 1411:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 1412:       shpCoords[3] = 0.0;
 1413:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 1414: 
 1415:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 1416:       // then we fix the negative shape coordinates.
 1417:       if (fixNegshpCoord && tmpmin<=0.0) {
 1418: 
 1419:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 1420:          // keeping the sum of the shape coordinates equal to 1.
 1421:          // I have tested and compared the new algorithm with the old one, and they give
 1422:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 1423:          // The new algorithm should be faster since it is branchless.
 1424:          const double a = - tmpmin + 1.0e-2;  // XXX it used to be 1.0e-4 in the comments of the original code
 1425:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 1426:          
 1427:          shpCoords[0] = (shpCoords[0] + a)*b;
 1428:          shpCoords[1] = (shpCoords[1] + a)*b;
 1429:          shpCoords[2] = (shpCoords[2] + a)*b;          
 1430: 
 1431:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 1432:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 1433:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 1434:          }
 1435: 
 1436:          // Update the point coordinates for the new shape coordinates
 1437:          double xcoords[3] = {x0.x, x1.x, x2.x};
 1438:          double ycoords[3] = {x0.y, x1.y, x2.y};
 1439:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 1440: 
 1441:       }
 1442: 
 1443:       // Check if the point is inside the element
 1444:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 1445:    }
 1446:    else {
 1447:       Error("Not implemented yet");
 1448: #ifdef QUADS
 1449:       // Reproject pt in eframe of nel for ics=2
 1450:       if constexpr(ics==1) {
 1451:          xn2 = xt; 
 1452:          yn2 = yt;
 1453:       }
 1454:       else {
 1455:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 1456:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 1457:       }
 1458: 
 1459:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 1460: #endif
 1461:    }
 1462: 
 1463: }
 1464: 
 1465: 
 1466: /**  Interpolate velocities at a given point (xt,yt,zt)
 1467: 
 1468:    @param xt, yt, zt: coordinates of the point to interpolate
 1469:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 1470: 
 1471:    This is done in four steps:
 1472: 
 1473:    1. Find the shape coordinates for the final position in the element.
 1474:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 1475:    3. Perform a *binary search* to find the vertical level containing zt. It will have to interpolate the 
 1476:       z levels at xt, yt at each step.   
 1477:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 1478:       horizontally and vertically.
 1479: **/
 1480: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) {
 1481:    // Interpolate the velocities at the point xt. 
 1482:    // This function works the same for triangular and quadrilateral elements.
 1483:    double shpCoord[4];
 1484: 
 1485: 
 1486:    // First step is to compute the shape coordinates of (xt,yt)
 1487:    computeShapeCoords(toVector2(xt), shpCoord, false);
 1488:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 1489: 
 1490:    // Second step is to find the level that contains zt
 1491:    // Uses a binary search to find the level
 1492:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 1493:    int L = kbe;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 1494:    int R = nvrt - 1;
 1495: 
 1496:    // Get the z coordinates at the nodes of the element at the levels L and R
 1497:    double zLAtNodes[4], zRAtNodes[4];
 1498:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 1499:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 1500: 
 1501:    double zL = interpolate(shpCoord, zLAtNodes);
 1502:    double zR = interpolate(shpCoord, zRAtNodes);
 1503:    
 1504:    // Interpolates vertically the velocities
 1505:    double wght1, wght2;
 1506:    if (xt.z<=zL) {
 1507:       wght1 = 1.0;
 1508:       wght2 = 0.0;
 1509:    }
 1510:    else if (xt.z>=zR) {
 1511:       wght1 = 0.0;
 1512:       wght2 = 1.0;
 1513:    }
 1514:    else {
 1515:       // Perform a binary search to find the levels between L and R that contain xt.z
 1516:       while (R - L > 1) {
 1517:          int M = (L + R) / 2;
 1518: 
 1519:          double zMAtNodes[4];
 1520:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 1521:          double zM = interpolate(shpCoord, zMAtNodes);
 1522:          if (zM < xt.z) 
 1523:          {
 1524:             L = M;
 1525:             zL = zM;
 1526:          }
 1527:          else 
 1528:          {
 1529:             R = M;
 1530:             zR = zM;
 1531:          }
 1532:       }
 1533:       assert(L == R-1);
 1534:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 1535: 
 1536:       wght2 = (xt.z - zL)/(zR - zL);
 1537:       wght1 = 1.0 - wght2;
 1538:    }
 1539: // printf("$$$ wght1 = %f, wght2 = %f, zt = %f, zL = %f, zR = %f\n", wght1, wght2, zt, zL, zR);
 1540: // printf("$$$ shpCoord = %f, %f, %f, %f\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 1541:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 1542:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 1543: 
 1544:    // Neither of the interpolated velocities should be NaN
 1545:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 1546: 
 1547: }
