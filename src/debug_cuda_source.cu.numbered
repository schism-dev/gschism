 1451: // Helper functions for computing the local node index at a given offset from another.
 1452: __device__ __inline__ int nxq(int offset, int index, int size) {
 1453:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1454:    // to the index to make it positive
 1455:    assert(index + offset + 16*size >= 0);
 1456:    return (index + offset + 16*size) % size;  
 1457: }
 1458: 
 1459: __device__ __inline__ int nxq(int index, int size) {
 1460:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1461:    // to the index to make it positive
 1462:    assert(index + 16*size >= 0);
 1463:    return (index + 16*size) % size; 
 1464: }
