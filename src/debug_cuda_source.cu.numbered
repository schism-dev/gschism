 8628: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8629:    // Get the value of a variable from an side
 8630:    // varName is the name of the variable to get
 8631:    // var is the array to store the value
 8632:    // k is the vertical level index of the variable to get
 8633:    SIDE_BND(sideBnd);   
 8634: 
 8635:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8636:    if (sideBnd->segment->isLand) idx = -7;
 8637: 
 8638:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8639:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8640: 
 8641: }
