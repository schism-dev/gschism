 6429: #ifdef DONTCOMPILE
 6430: __device__ void computeVerticalAdvection(void) {
 6431:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6432: 
 6433:    sdbt(1:2,:,:)=0.d0
 6434: 
 6435:    const Side *side = FROM kernel;
 6436: 
 6437:    if(side->isDry) return;
 6438: 
 6439:    // If side is wet...
 6440: 
 6441: 
 6442:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6443:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6444:    double ws[nvrt] = {} // w @ side
 6445:    int icount = 0;
 6446:    for (int j=0; j<2; j++) {
 6447:       const Element *elem = side->elements[j];
 6448:        
 6449:       if(elem != nullptr) {
 6450:          icount++;
 6451:          for (int k=0; k<nvrt; k++) {
 6452:             ws[k] = ws[k] + elem->w[k];
 6453:          }
 6454:       }
 6455:    }  // for j
 6456: 
 6457:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6458:    ws = ws/icount;
 6459: 
 6460:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6461:    // Splines allow for a smooth transition between vertical levels.
 6462:    // Splines have continuity restrictions at the internal knots, but
 6463:    // we have to provide the 1st derivatives at the endpoints.
 6464:    const int kbs = side->kbs; 
 6465:    
 6466:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6467:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6468:    initCubicSpline(kbs, nvrt, side, ws, up)
 6469: 
 6470:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6471:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6472:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6473: 
 6474:    // Total advection (average onto side)
 6475:    const Node *node1 = side->nodes[0];
 6476:    const Node *node2 = side->nodes[1];
 6477:    for (int k=kbs(i); k<nvrt; k++) {
 6478: 
 6479:       if constexpr(ics==1) {
 6480:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6481:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6482:       } else {
 6483:          // XXX IMPLEMENT THIS
 6484:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6485:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6486:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6487:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6488:       }  // if ics
 6489: 
 6490: 
 6491:    }
 6492: }
 6493: #endif
 6494: 
 6495: 
 6496: extern "C" {
 6497:    __global__ void computeElemAverageGhat(void) {
 6498:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6499: 
 6500:       ELEM(elem);
 6501:       
 6502:       elem->ghat1= {0.0, 0.0};  
 6503: 
 6504:       if constexpr(ihydraulics != 0) {
 6505:          if (nhtblocks > 0 && elem->isblock) return;
 6506:       }
 6507: 
 6508:       if (elem->isDry) return;
 6509: 
 6510:       // Wet elements.
 6511:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6512:       // tidal potential, horizontal diffusion, and baroclinic etc
 6513:       // Remember to update both fb and F 
 6514:       // If ics=2, ghat1 are in eframe (ll)
 6515:       // cff1-3: coefficients for 2D/3D
 6516:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6517:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6518:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6519: 
 6520:       double av_cff1 = 0.0;  // av. for cff1
 6521:       double av_cff2 = 0.0;  // av. for cff2
 6522:       double av_cff3 = 0.0;  // av. for cff3
 6523:       double av_df = 0.0;  // av. for H^\alpha / H
 6524:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6525:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6526: 
 6527:       const int i34 = elem->i34;
 6528:       const int kb = elem->kb;
 6529: 
 6530:       for (int j=1; j<i34; j++) {
 6531:          // For each node and side in the element...
 6532: 
 6533:          const Node *node = elem->nodes[j];
 6534:          const Side *side = elem->sides[j];
 6535: 
 6536:          const double chi      = side->chi;
 6537:          const double veg_c2   = side->veg_c2;
 6538:          const double veg_beta = side->veg_beta;
 6539:          const double veg_h    = side->veg_h();
 6540:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6541: 
 6542:          // Node - const in elem
 6543:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6544:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6545: 
 6546:          if (elem->depth >= tip_dp) {
 6547:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6548:          }
 6549: 
 6550:          
 6551:          const double htot  = side->htot2();        // Total depth at the side
 6552:          const double zctr2 = side->zTopCanopy();  
 6553: 
 6554:          double cff1; 
 6555:          double cff2; 
 6556:          double cff3;   
 6557:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6558:          // coefficients applied to 2D/3D case 
 6559:             cff1 = side->hhat/htot;
 6560:             cff2 = 0.0;
 6561:             cff3 = 0.0;
 6562:          } else { //3D
 6563:             //Init for no-veg case
 6564:             cff1 = 1.0;
 6565:             cff2 = 1.0;
 6566:             cff3 = 0.0;
 6567: 
 6568:             if constexpr(iveg != 0) {
 6569:                // Computes coefficients used with vegetation terms G1, G2
 6570:                // cff1, cff3 are used for the first two terms in G1, G2:
 6571:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6572:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6573:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6574:                if(veg_h < 0.99*htot) { // submergent vegetation
 6575:                   cff1=1;
 6576:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6577:                   cff3 = veg_c;
 6578: 
 6579:                } else { // emergent vegetation
 6580:                   cff1 = 1.0/(1.0 + veg_c2);
 6581:                   cff2 = cff1;
 6582:                   cff3 = 0.0;
 6583: 
 6584:                }
 6585:             } // if iveg
 6586:          } //  2D/3D
 6587: 
 6588:          av_cff1 += cff1/i34;
 6589:          av_cff2 += cff2/i34;
 6590:          av_cff3 += cff3/i34;
 6591:          av_cff2_chi += cff2*chi/i34;
 6592:          av_cff3_chi += cff3*chi/i34;
 6593:          av_df += min(htot, veg_h)/(htot*i34);
 6594: 
 6595: 
 6596:          // btrack values: U^\star, U^{\star\alpha}
 6597:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6598:          Vector2 Ustar       = {0.0, 0.0}; 
 6599:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6600: 
 6601:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6602:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6603:          } else { //3D
 6604:             for (int k = side->kb; k < nvrt; k++) {
 6605:             
 6606:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6607:                Ustar += w2;
 6608: 
 6609:                if constexpr(iveg != 0) {
 6610:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6611:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6612:                        Ustar_alpha += zrat*w2; // XXXX
 6613:                    }
 6614:                }  // if iveg
 6615:             }  // for k
 6616:          }  //2D/3D
 6617:          
 6618: 
 6619:          // Add btrack & surface stress terms to \breve{G} first
 6620:          if constexpr(ics==1) {
 6621:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6622:          } else {
 6623:             // XXX IMPLEMENT THIS
 6624:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6625:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6626:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6627:          }  // if ics
 6628: 
 6629:          // Surface and bottom stress terms
 6630:          if constexpr(ics==1) {
 6631:             const Vector2 tau    = side->tau();
 6632:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6633: 
 6634:             // Term for surface and bottom stress
 6635:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6636:          } else {
 6637:             // XXX IMPLEMENT THIS
 6638:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6639:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6640:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6641:             // tau_x=(vn1+tt1)/2.d0
 6642:             // tau_y=(vn2+ss1)/2.d0
 6643:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6644:          }  // if ics
 6645: 
 6646:          
 6647: 
 6648:          // All terms in F,F^\alpha,f_b except baroclinic
 6649:          // F, f_b: all explicit terms excluding vegetation 
 6650:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6651:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6652:          const double coriolis = side->coriolis;
 6653:          Vector2 F  =  coriolis*side->U;  // F_x
 6654:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6655:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6656: 
 6657:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6658:             
 6659:             for (int k = side->kb; k < nvrt; k++) {
 6660:                if (zctr2 > side->zc[k-1]) {
 6661:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6662:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6663:                    Fa +=  coriolis*w2*zrat;
 6664:                } // if zctr2
 6665:             } // k
 6666:          } // iveg
 6667: 
 6668:          // Integrate horizontal viscosity force vertically
 6669:          for (int k=side->kb + 1; k<nvrt; k++) {
 6670:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6671: 
 6672:             F += levelHorVisc;
 6673: 
 6674:             // Vegetation term
 6675:             if constexpr(iveg!=0) {
 6676:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6677:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6678:                   Fa += levelHorVisc*zrat;
 6679:                } 
 6680:             } // if iveg
 6681:          } // for k
 6682: 
 6683:          fb += side->nuGradU[side->kb];
 6684: 
 6685:          // Add to ghat1
 6686:          if constexpr(ics==2) {
 6687:             // XXX IMPLEMENT THIS
 6688:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6689:             // bigf1=vn1; bigf2=vn2
 6690:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6691:             // botf1=vn1; botf2=vn2
 6692:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6693:             // bigfa1=vn1; bigfa2=vn2
 6694:          } // if ics
 6695: 
 6696:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6697:       } // for j (nodes and sides)
 6698: 
 6699:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6700:          
 6701:       // Finish off terms in F, F^\alpha and f_b
 6702:       const double grav3 = elem->mean(&Node::grav2);
 6703:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6704: 
 6705: 
 6706:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6707:       for (int j=1; j<i34; j++) { 
 6708:          // For each side in the element...
 6709:          const Side *side = elem->sides[j];
 6710:          const double chi = side->chi;
 6711: 
 6712:          const double htot = side->htot2();
 6713:          const double veg_h = side->veg_h();
 6714:          const Vector2 F  = htot*fb;
 6715:          const Vector2 Fa = min(htot, veg_h)*fb;
 6716: 
 6717:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6718:       } // for j
 6719: printf("$$$ tmp = %.15g, %.15g\n", tmp.x, tmp.y);
 6720:       //botf1 etc are already in elem frame
 6721:       elem->ghat1 += tmp/i34;
 6722: 
 6723:       // Baroclinic force
 6724:       if constexpr(ibc==0) {
 6725:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6726: 
 6727:          Vector2 Fa = {0.0, 0.0};
 6728:          Vector2 intGradRho = {0.0, 0.0};
 6729:          
 6730:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6731:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6732:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6733: 
 6734:             // \in F [m^2/s/s]
 6735:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6736:          }
 6737: 
 6738:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6739:          const Vector2 F = av_df*Fa; //approx
 6740:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6741: 
 6742:       } // if ibc
 6743: 
 6744: 
 6745: 
 6746:    }
 6747: 
 6748: } // extern "C"
 6749: 
 6750: 
 6751: 
 6752: #ifdef DONTCOMPILE
 6753: __global__ void checkMassConservation(Tracers* sumtr) {
 6754: 
 6755:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6756: 
 6757:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6758: 
 6759:    Element *elem = &(mesh->localElemData[i]);
 6760: 
 6761:    // Skip dry elements
 6762:    if (elem->isDry) return;
 6763: 
 6764:    // Local sum array for this thread
 6765:    double localSum[N_TRACERS] = {0.0};
 6766: 
 6767:    // Sum over vertical levels for this element
 6768:    const int kbe = elem->kbe;
 6769:    const double area = elem->area;
 6770: 
 6771:    for (int k = kbe; k < nvrt; k++) {
 6772:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6773:       
 6774:       // Accumulate tracer mass
 6775:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6776:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6777:       }
 6778:    }
 6779: 
 6780:    
 6781: 
 6782:    //  This function returns per element sums. A reduction must be done on the host side.
 6783: }
 6784: 
 6785: 
 6786: __global__ void transport(void) {
 6787: 
 6788:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6789: 
 6790:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6791: 
 6792:    Element *elem = &(mesh->localElemData[ie]);
 6793: 
 6794:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6795: 
 6796:                for (int m=0; m<ntr; m++) {
 6797:                   for (int k=kbe(ie); k<nvrt; k++) {
 6798:                      // Calculate each polynomial's weight 
 6799:                      wm=0.d0; sum1=0.d0; 
 6800:                      wm1=0.d0; wm2=0.d0; 
 6801:                      for (int i=0; i<elem->nweno2; i++) {
 6802:                   
 6803:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6804:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6805:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6806:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6807:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6808:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6809:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6810:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6811:                      // -----------------Hu and Shu (1999)'s method----------------
 6812:                      b4=b1+b2+b3
 6813: 
 6814: //Error: add PRODUCTION CPP
 6815: #ifdef DEBUG
 6816:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6817:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6818:                     call parallel_abort(errmsg)
 6819:                   }
 6820: #endif
 6821: 
 6822:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6823:                   // !----test-------------- 
 6824:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6825:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6826:                   // !wm(i)=wm1(i)*wm2(i)
 6827:                   // !---------------------- 
 6828:                   sum1=sum1+wm(i)
 6829:                 } // end for i
 6830: 
 6831:                 wm=wm/sum1
 6832: 
 6833:                 for (int j=0; j<elem->i34; j++) {
 6834: 
 6835:                   const Side *side  = elem->sides[j];
 6836:                   const Node *node1 = side->n1;
 6837:                   const Node *node2 = side->n2;
 6838: 
 6839:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6840:                      trsd=0.d0
 6841:                      for (int kk=0; kk<nquad; kk++) {
 6842:                         for (int i=0; i<elem->nweno2; i++) {
 6843:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6844:                         } // end for i   
 6845:                      } // end for kk
 6846:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6847:                   } // outward flux
 6848:                } // end for j=1,i34(ie) ! side
 6849:             }
 6850:          }
 6851:               
 6852: 
 6853: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6854: //             //   calculate each polynomial's weight 
 6855: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6856: //                 wm=0.d0; sum1=0.d0
 6857: //                 do i=1,nweno1(ie) !for each polynomial
 6858: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6859: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6860: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6861: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6862: //                   wm(i)=b2
 6863: //                   sum1=sum1+b2
 6864: //                   !wm(i)=1.d0
 6865: //                   !sum1=sum1+1.d0
 6866: 
 6867: // // Error: PRODUCTION
 6868: // #ifdef DEBUG
 6869: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6870: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6871: //                     call parallel_abort(errmsg)
 6872: //                   endif
 6873: // #endif
 6874: 
 6875: //                 enddo !i
 6876: //                 wm=wm/sum1 !final weight
 6877: 
 6878:                 for (int j=0; j<elem->i34; j++) { // side
 6879:                   const Side *side = elem->sides[j];
 6880:                   const Node *node1 = side->n1;
 6881:                   const Node *node2 = side->n2;
 6882: 
 6883:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6884:                     trsd=0.d0
 6885:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6886:                       for (int i=0; i<elem->nweno1; i++) {
 6887:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6888:                       }
 6889:                     enddo //kk
 6890:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6891:                   } // outward flux
 6892:                 } // end for j=1,i34(ie) ! side
 6893:               } // end for k; ntr 
 6894: 
 6895:             else !simple upwind method
 6896:               do j=1,i34(ie)
 6897:                 jsj=elside(j,ie)
 6898:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6899:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6900:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6901:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6902:                   endif
 6903:                 enddo  !vertical layers
 6904:               enddo !j=1,i34(ie) ! side
 6905:             endif !order of accuracy
 6906: 
 6907:          //  enddo !ie
 6908: // !$OMP     end do
