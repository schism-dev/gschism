  278: // Simple math functions ---------------------------------------------------------------------------
  279: 
  280: __device__ __forceinline__ void solveQuadratic(double A, double B, double C, double &x1, double &x2) {
  281: // Solves the quadratic equation A*x^2 + B*x + C = 0 and returns the two solutions in x1 and x2.
  282: // Outputs:
  283: //        x1: first solution
  284: //        x2: second solution
  285: 
  286:        // Use float-specific absolute value for speed on GPU
  287:     const double absA = fabs(A);
  288:     const double absB = fabs(B);
  289: 
  290:     // 1. Near-linear case: a is effectively 0.
  291:     // We use a small epsilon to prevent division by zero and handle degenerate quads.
  292:     // This branch is almost never taken, so it won't hurt performance.
  293:     if (absA < 1e-14 * (absB + 1e-30)) {
  294:         const double x = -C / B;
  295:         x1 = x;
  296:         x2 = x;
  297:         return;  // Degenerate case: A = 0.
  298:     }
  299: 
  300:    const double delta = max(0.0, B*B - 4.0*A*C);
  301: 
  302:    assert(delta >= 0.0 && "solveQuadratic: negative discriminant");
  303:    const double s = sqrt(delta);
  304: 
  305:    // Numerically stable quadratic roots:
  306:    // q = -0.5*(B + sign(B)*sqrt(delta))
  307:    const double q = -0.5 * (B + copysign(s, B));
  308: 
  309:    x1 = q/A;
  310:    x2 = (fabs(q) > 1e-30) ? (C/q) : x1;   // Moving predicate.
  311: 
  312: }
