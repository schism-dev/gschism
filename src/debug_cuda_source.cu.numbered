  998: struct BoundarySegment {
  999: 
 1000:    bool isLand;
 1001: 
 1002:    double clen;  // Length of the boundary segment
 1003:    double carea; // Area of the boundary segment
 1004: 
 1005:    int ifltype;  // Type of flow boundary condition
