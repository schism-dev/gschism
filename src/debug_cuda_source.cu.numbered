 2094: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2095: // return;   
 2096:    // Lock the mutex
 2097:    lock(&debugPlotMutex);
 2098:  
 2099:    bool ok = true;
 2100:    if (debugPlotIdx == nullptr) ok = false;
 2101:    if (*debugPlotIdx >= 1000000) ok = false;
 2102:    if (ok) {
 2103:       debugPlot[(*debugPlotIdx) + 0*1000000] = x1.x;
 2104:       debugPlot[(*debugPlotIdx) + 1*1000000] = x1.y;
 2105:       debugPlot[(*debugPlotIdx) + 2*1000000] = x2.x;
 2106:       debugPlot[(*debugPlotIdx) + 3*1000000] = x2.y;
 2107:       debugPlot[(*debugPlotIdx) + 4*1000000] = (double)color;
 2108:       debugPlot[(*debugPlotIdx) + 5*1000000] = (double)(((int)(unsigned char)marker & 0xFF) | ((dashLen & 0xFF) << 8) | ((width & 0xFF) << 16));
 2109:       debugPlot[(*debugPlotIdx) + 6*1000000] = (double)label;
 2110:       (*debugPlotIdx)++;
 2111:    }
 2112: 
 2113:    __threadfence();               // ensure all above writes are visible
 2114:    // Unlock the mutex
 2115:    unlock(&debugPlotMutex);
 2116: 
 2117: }
 2118: 
 2119: __device__ void addDebugPlot(Vector2 x1, Vector2 x2, unsigned int color = 0xA0A0A0, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2120:    addDebugPlot(toPoint3(x1, 0.0), toPoint3(x2, 0.0), color, marker, width, dashLen, label);
 2121: }
