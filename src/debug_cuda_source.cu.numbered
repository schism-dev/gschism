 9823: extern "C" __global__ void getNodeVar(int varCode, void *res, int k) {
 9824:    // Packed local order into res. Caller allocates sizePart * nbytes.
 9825:    NODE(node);
 9826: 
 9827:    switch (varCode) {
 9828:       case (int)VarCode::outputCoords: {
 9829:          const Point2 coords = node->outputCoords();
 9830:          double *out = (double *)((char *)res + idx_node * 16);
 9831:          out[0] = coords.x;
 9832:          out[1] = coords.y;
 9833:          break;
 9834:       }
 9835:       case (int)VarCode::depth:
 9836:          *(double *)((char *)res + idx_node * 8) = node->depth;
 9837:          break;
 9838:       case (int)VarCode::kb:
 9839:          *(int *)((char *)res + idx_node * 4) = (int)node->kb;
 9840:          break;
 9841:       case (int)VarCode::eta:
 9842:          *(double *)((char *)res + idx_node * 8) = node->eta2;
 9843:          break;
 9844:       case (int)VarCode::u_air: {
 9845:          double *out = (double *)((char *)res + idx_node * 16);
 9846:          out[0] = node->u_air.x;
 9847:          out[1] = node->u_air.y;
 9848:          break;
 9849:       }
 9850:       case (int)VarCode::isdry:
 9851:          *(int *)((char *)res + idx_node * 4) = (int)node->isDry;
 9852:          break;
 9853:       case (int)VarCode::u: {
 9854:          double *out = (double *)((char *)res + idx_node * nvrt * 16);
 9855:          if (k >= 0) {
 9856:             out[0] = node->u2[k].x;
 9857:             out[1] = node->u2[k].y;
 9858:          } else {
 9859:             for (int lev = 0; lev < nvrt; lev++) {
 9860:                out[lev*2    ] = node->u2[lev].x;
 9861:                out[lev*2 + 1] = node->u2[lev].y;
 9862:             }
 9863:          }
 9864:          break;
 9865:       }
 9866:       case (int)VarCode::z: {
 9867:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9868:          if (k >= 0)
 9869:             out[0] = node->z[k];
 9870:          else
 9871:             for (int lev = 0; lev < nvrt; lev++)
 9872:                out[lev] = node->z[lev];
 9873:          break;
 9874:       }
 9875:       case (int)VarCode::w: {
 9876:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9877:          if (k >= 0)
 9878:             out[0] = node->w2[k];
 9879:          else
 9880:             for (int lev = 0; lev < nvrt; lev++)
 9881:                out[lev] = node->w2[lev];
 9882:          break;
 9883:       }
 9884:       case (int)VarCode::dfh: {
 9885:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9886:          if (k >= 0)
 9887:             out[0] = node->dfh[k];
 9888:          else
 9889:             for (int lev = 0; lev < nvrt; lev++)
 9890:                out[lev] = node->dfh[lev];
 9891:          break;
 9892:       }
 9893:       case (int)VarCode::dfv: {
 9894:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9895:          if (k >= 0)
 9896:             out[0] = node->dfv[k];
 9897:          else
 9898:             for (int lev = 0; lev < nvrt; lev++)
 9899:                out[lev] = node->dfv[lev];
 9900:          break;
 9901:       }
 9902:       case (int)VarCode::tke: {
 9903:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9904:          if (k >= 0)
 9905:             out[0] = getTKE(node->turb, k);
 9906:          else
 9907:             for (int lev = 0; lev < nvrt; lev++)
 9908:                out[lev] = getTKE(node->turb, lev);
 9909:          break;
 9910:       }
 9911:       case (int)VarCode::mxl: {
 9912:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9913:          if (k >= 0)
 9914:             out[0] = getMXL(node->turb, k);
 9915:          else
 9916:             for (int lev = 0; lev < nvrt; lev++)
 9917:                out[lev] = getMXL(node->turb, lev);
 9918:          break;
 9919:       }
 9920:       case (int)VarCode::temp: {
 9921:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9922:          if (k >= 0)
 9923:             out[0] = node->tracers[k].tracer[0];
 9924:          else
 9925:             for (int lev = 0; lev < nvrt; lev++)
 9926:                out[lev] = node->tracers[lev].tracer[0];
 9927:          break;
 9928:       }
 9929:       case (int)VarCode::salt: {
 9930:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9931:          if (k >= 0)
 9932:             out[0] = node->tracers[k].tracer[1];
 9933:          else
 9934:             for (int lev = 0; lev < nvrt; lev++)
 9935:                out[lev] = node->tracers[lev].tracer[1];
 9936:          break;
 9937:       }
 9938:    }
 9939: }
 9940: 
 9941: 
 9942: extern "C" __global__ void getSideVar(int varCode, void *res, int k) {
 9943:    SIDE(side);
 9944: 
 9945:    switch (varCode) {
 9946:       case (int)VarCode::outputCoords: {
 9947:          const Point2 coords = side->outputCoords();
 9948:          double *out = (double *)((char *)res + idx_side * 16);
 9949:          out[0] = coords.x;
 9950:          out[1] = coords.y;
 9951:          break;
 9952:       }
 9953:       case (int)VarCode::n1:
 9954:          *(uintptr_t *)((char *)res + idx_side * 8) = (uintptr_t)((side->n1 != nullptr) ? side->n1->idx + 1 : -1);
 9955:          break;
 9956:       case (int)VarCode::n2:
 9957:          *(uintptr_t *)((char *)res + idx_side * 8) = (uintptr_t)((side->n2 != nullptr) ? side->n2->idx + 1 : -1);
 9958:          break;
 9959:       case (int)VarCode::isdry:
 9960:          *(int *)((char *)res + idx_side * 4) = (int)side->isDry;
 9961:          break;
 9962:    }
 9963: }
 9964: 
 9965: 
 9966: extern "C" __global__ void getElementVar(int varCode, void *res, int k) {
 9967:    ELEM(elem);
 9968: 
 9969:    switch (varCode) {
 9970:       case (int)VarCode::outputCoords: {
 9971:          const Point2 coords = elem->outputCoords();
 9972:          double *out = (double *)((char *)res + idx_elem * 16);
 9973:          out[0] = coords.x;
 9974:          out[1] = coords.y;
 9975:          break;
 9976:       }
 9977:       case (int)VarCode::FaceIndices: {
 9978:          uintptr_t *out = (uintptr_t *)((char *)res + idx_elem * 32);
 9979:          for (int j = 0; j < 4; j++)
 9980:             out[j] = (j < elem->i34 && elem->nodes[j]) ? elem->nodes[j]->idx + 1 : -1;
 9981:          break;
 9982:       }
 9983:       case (int)VarCode::isdry:
 9984:          *(int *)((char *)res + idx_elem * 4) = (int)elem->isDry;
 9985:          break;
 9986:       case (int)VarCode::w: {
 9987:          double *out = (double *)((char *)res + idx_elem * nvrt * 8);
 9988:          if (k >= 0)
 9989:             out[0] = elem->w[k];
 9990:          else
 9991:             for (int lev = 0; lev < nvrt; lev++)
 9992:                out[lev] = elem->w[lev];
 9993:          break;
 9994:       }
 9995:    }
 9996: }
 9997: 
 9998: 
 9999: 
