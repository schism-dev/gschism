 7298: __global__ void printMatrix(void) {
 7299: 
 7300: 
 7301:    // Let only one thread per block print at a time 
 7302: 
 7303:    if (threadIdx.x == 0) {
 7304:       for (int ithread = 0; ithread < blockDim.x; ithread++) {
 7305:          const int idx_node = ithread + blockIdx.x * blockDim.x;
 7306:          if (idx_node >= mesh->np) return;
 7307:          const Node *node = mesh->localNodeData + idx_node;
 7308:          printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7309:          for (int j = 0; j < node->numNodes; j++) {
 7310:             Node* nbNode = node->nodes[j];
 7311:             if (node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7312:          }
 7313:          printf("]\n");
 7314: 
 7315:       }
 7316:    }
 7317: 
 7318: 
 7319: 
 7320: }
 7321: 
 7322: 
 7323: __global__ void computeMatrixProductAndDotProducts() {
 7324:    // Computes A*p, r'Mr and p'Ap
 7325: 
 7326:    // 1) shared buffer: first half for rMr, second for pAp
 7327:    __shared__ double sdata[2*BLOCK_SIZE];
 7328:    double* s_rMr = sdata;
 7329:    double* s_pAp = sdata + BLOCK_SIZE;
 7330: 
 7331:    s_rMr[threadIdx.x] = 0.0;
 7332:    s_pAp[threadIdx.x] = 0.0;
 7333: 
 7334:    // 2) get your node pointer
 7335:    NODE(node);  
 7336:    const int tid = threadIdx.x;
 7337: 
 7338:    const double diag = node->coeffDiag;
 7339:    const double r    = node->mR;
 7340:    const double p    = node->mP;  
 7341: 
 7342:    // apply preconditioner on the fly:
 7343:    const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7344: 
 7345:    // 4) compute Ap = A.p
 7346:    double Ap = node->coeffDiag * node->mP;
 7347:    for (int j = 0; j < node->numNodes; ++j) {
 7348:       const Node *nbNode = node->nodes[j];
 7349:       Ap += node->coeffMatrix[j] * nbNode->mP;
 7350: 
 7351:    }
 7352:    node->mAp = Ap;
 7353:     
 7354: 
 7355:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 7356:    const double l_rMr = r*Mr;  // r'Mr
 7357:    const double l_pAp = p*Ap;  // p'Ap
 7358: 
 7359:    // 6) write into shared mem
 7360:    s_rMr[tid] = l_rMr;
 7361:    s_pAp[tid] = l_pAp;
 7362: 
 7363:    __syncthreads();
 7364: 
 7365:    // 7) block-wide tree reduction
 7366:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7367:       if (tid < stride)  s_pAp[tid] += s_pAp[tid + stride];
 7368:       __syncthreads();
 7369:    }
 7370: 
 7371:    // 8) thread 0 atomically accumulates into the globals
 7372:    // XXX: This is slower than it needs to be, but it is simple and works
 7373:    if (tid == 0) atomicAdd(pAp, s_pAp[0]);
 7374: 
 7375: 
 7376: }
 7377: 
 7378: 
 7379: __global__ void updateSolutionAndDotProducts(void) {
 7380:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7381: 
 7382:    s_rMr[threadIdx.x] = 0.0;
 7383: 
 7384: 
 7385:    // get node & bounds-check:
 7386:    NODE(node);
 7387:    const int tid = threadIdx.x;
 7388: 
 7389: 
 7390:    // Compute alpha
 7391:    const double alpha = (*rMr_old)/(*pAp);
 7392: 
 7393:    // load scalars
 7394:    const double diag = node->coeffDiag;
 7395:    const double p    = node->mP;
 7396:    const double Ap   = node->mAp;
 7397:    const double x    = node->mX;
 7398:    const double r    = node->mR;
 7399:    
 7400:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7401: 
 7402:    // 1) update solution & residual
 7403:    const double x_new = x + alpha*p;
 7404:    const double r_new = r - alpha*Ap;
 7405:    node->mX = x_new;
 7406:    node->mR = r_new;
 7407: 
 7408:    // 2) apply Jacobi preconditioner on the fly
 7409:    const double Mr_new = r_new/diag;
 7410: 
 7411: 
 7412:    // 3) local contributions for the two dot-products
 7413:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7414: 
 7415:    // 4) write into shared-mem
 7416:    s_rMr[tid] = l_rMr;
 7417: 
 7418:    __syncthreads();
 7419: 
 7420: 
 7421:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7422:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7423:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7424:       __syncthreads();
 7425:    }
 7426: 
 7427:    // 6) thread 0 atomically folds into the global accumulators
 7428:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7429: 
 7430: 
 7431: }
 7432: 
 7433: 
 7434: __global__ void updateSearchDirection() {
 7435:     NODE(node);
 7436: 
 7437:     // recompute z on-the-fly
 7438:     const double z = node->mR / node->coeffDiag;
 7439:     const double p = node->mP;
 7440: 
 7441:     const double beta = (*rMr_new)/(*rMr_old);
 7442: 
 7443: // printf("ZZZ updateSearchDirection: beta = %f\n", beta);
 7444: 
 7445:     // p =z + beta*p
 7446:     node->mP = z + beta*p;
 7447: 
 7448: }
 7449: 
 7450: __global__ void initializePreconditionedResidual(double *scalars) {
 7451: 
 7452:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 7453: 
 7454:     s_rMr[threadIdx.x] = 0.0;
 7455: 
 7456:     NODE(node);
 7457:     const int tid = threadIdx.x;
 7458:     // For the first iteration:
 7459:     // 1. Initial solution x = 0 (already set)
 7460:     // 2. Initial residual r = b (stored in qel)
 7461:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7462: 
 7463: // XXX we should use the guess solution here    
 7464: 
 7465:     // Set initial residual r = b (from qel)
 7466:     node->mR = node->qel;
 7467: 
 7468:     // Compute z = M^-1 * r (preconditioned residual)
 7469:     const double z = node->mR / node->coeffDiag;
 7470: 
 7471:     // Set initial search direction p = z
 7472:     node->mP = z;
 7473: 
 7474:     // Initialize other variables needed for CG
 7475:     node->mX = 0.0;  // Initial solution
 7476:     node->mAp = 0.0; // Will be computed in first iteration
 7477: 
 7478:     // These point to a cupy array in the host code
 7479:     rMr_old = scalars + 0;
 7480:     rMr_new = scalars + 1;
 7481:     pAp     = scalars + 2;
 7482: 
 7483:     // Computes the first r'Mr (reduction)
 7484:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7485: 
 7486:     // 4) write into shared-mem
 7487:     s_rMr[tid] = l_rMr;
 7488: 
 7489:     __syncthreads();
 7490: 
 7491: 
 7492:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7493:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7494:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7495:         __syncthreads();
 7496:     }
 7497: 
 7498:     // 6) thread 0 atomically folds into the global accumulators
 7499:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7500: 
 7501:     *rMr_old = 0.0;
 7502:     *pAp = 0.0;
 7503: }
 7504: 
 7505: 
 7506: 
 7507: 
 7508: extern "C" __global__ void getElementVar(int varCode, double *var, int k = -1) {
 7509:    // Get the value of a variable from an element
 7510:    // varName is the name of the variable to get
 7511:    // var is the array to store the value
 7512:    // k is the vertical level index of the variable to get
 7513: 
 7514:    ELEM(elem);
 7515:    
 7516:    int idx = elem->idx;
 7517:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7518: 
 7519:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7520:    if      (varCode == (int)VarCode::w && k >= 0)       var[idx] = elem->w[k];
 7521:    else if (varCode == (int)VarCode::z && k >= 0)       var[idx] = elem->z[k];
 7522:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = elem->center.x;
 7523:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = elem->center.y;
 7524:    else if (varCode == (int)VarCode::area && k == -1)   var[idx] = elem->area;
 7525:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = elem->depth;
 7526:    else if (varCode == (int)VarCode::radius && k == -1) var[idx] = elem->radius;
 7527:    else if (varCode == (int)VarCode::xlon && k == -1)   var[idx] = elem->xlon;
 7528:    else if (varCode == (int)VarCode::ylat && k == -1)   var[idx] = elem->ylat;
 7529:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(elem->kb);
 7530:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7531:       
 7532:    
 7533: }
 7534: 
 7535: 
 7536: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7537:    // Get the value of a variable from an node
 7538:    // varName is the name of the variable to get
 7539:    // var is the array to store the value
 7540:    // k is the vertical level index of the variable to get
 7541: 
 7542:    NODE(node);
 7543:    
 7544:    int idx = node->idx;
 7545:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7546: 
 7547:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7548:    
 7549:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7550:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7551:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = node->p.y;
 7552:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7553:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7554:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7555:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;   
 7556:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7557:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7558:    else if (varCode == (int)VarCode::v && k >= 0)       var[idx] = node->u2[k].y;
 7559:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->u2[k].z;
 7560:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7561:       
 7562:    
 7563: }
 7564: 
 7565: 
 7566: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7567:    // Get the value of a variable from an side
 7568:    // varName is the name of the variable to get
 7569:    // var is the array to store the value
 7570:    // k is the vertical level index of the variable to get
 7571:    SIDE(side);
 7572:    
 7573:    int idx = side->idx;
 7574:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7575: 
 7576:    printf("getSideVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7577:    
 7578:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 7579:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 7580:    else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 7581:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 7582:    else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 7583:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 7584:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 7585:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 7586:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 7587:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 7588:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 7589:    else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 7590:    else if (varCode == (int)VarCode::bccx && k >= 0)     var[idx] = side->bcc[k].x;
 7591:    else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 7592:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7593:    else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7594:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7595:    else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7596:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 7597:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->isLand:0.0;
 7598:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7599: }
