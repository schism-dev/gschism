 5624:    __global__ void zeroNodalVelocities(void) {
 5625:       NODE(node);
 5626: 
 5627:       for (int k = 0; k < nvrt; k++) {
 5628:          node->u2[k]   = {0.0, 0.0, 0.0};
 5629:          node->utmp[k] = {0.0, 0.0};
 5630:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5631:       }
 5632:    }
 5633: 
 5634:    __global__ void computeNodalVerticalVelocities1(void) {
 5635:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5636:    // Adds the element's vertical velocity times the element's area.
 5637:       ELEM(elem);
 5638: 
 5639:       for (int j = 0; j < elem->i34; j++) {
 5640:          Node *node = elem->nodes[j];
 5641: 
 5642:          for (int k = node->kb; k < nvrt; k++) {
 5643:             atomicAdd(&(node->u2[k].z), elem->w[k]*elem->area);
 5644:          }
 5645:          atomicAdd(&(node->tmp.d), elem->area);
 5646:       }
 5647:    }
 5648: 
 5649:    __global__ void computeNodalVerticalVelocities2(void) {
 5650:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5651:    // Divides by the total area of the elements sharing the    node.
 5652:       NODE(node);
 5653: printf("node->idx = %d, node->tmp.d = %e, node->u2[k].z = %e\n", node->idx, node->tmp.d, node->u2[0].z);
 5654:       for (int k = node->kb; k < nvrt; k++) node->u2[k].z = node->u2[k].z / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5655:    }
