 8104: extern "C" __global__ void getElementVar(int varCode, bool is3D, double *var1, double *var2, int *ivar1, int *ivar2, int k = -1, int j = -1) {
 8105:    // Get the value of a variable from an element
 8106:    // varName is the name of the variable to get
 8107:    // var is the array to store the value
 8108:    // k is the vertical level index of the variable to get
 8109: 
 8110:    ELEM(elem);
 8111:    
 8112:    int idx = elem->idx;
 8113:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8114: 
 8115:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8116:    if      (varCode == (int)VarCode::w)       { var1[idx] = elem->w[k];}
 8117:    else if (varCode == (int)VarCode::z)       { var1[idx] = elem->z[k];}
 8118:    else if (varCode == (int)VarCode::x)       { var1[idx] = elem->center.x; var2[idx] = elem->center.x;}
 8119:    else if (varCode == (int)VarCode::area)    { var1[idx] = elem->area;}
 8120:    else if (varCode == (int)VarCode::depth)   { var1[idx] = elem->depth;}
 8121:    else if (varCode == (int)VarCode::radius)  { var1[idx] = elem->radius;}
 8122:    else if (varCode == (int)VarCode::lonlat)  { var1[idx] = elem->xlon;     var2[idx] = elem->ylat;}
 8123:    else if (varCode == (int)VarCode::ghat)    { var1[idx] = elem->ghat1.x;  var2[idx] = elem->ghat1.y;}
 8124:    else if (varCode == (int)VarCode::kb)      { ivar1[idx] = elem->kb;}
 8125:    else if (varCode == (int)VarCode::ssign && j > -1)  {ivar1[idx] = elem->ssign[j];}
 8126:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 8127:       
 8128:    
 8129: }
 8130: 
 8131: 
 8132: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 8133:    // Get the value of a variable from an node
 8134:    // varName is the name of the variable to get
 8135:    // var is the array to store the value
 8136:    // k is the vertical level index of the variable to get
 8137: 
 8138:    NODE(node);
 8139:    
 8140:    int idx = node->idx;
 8141:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8142: 
 8143:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8144:    
 8145:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 8146:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 8147:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 8148:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 8149:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 8150:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 8151:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;  
 8152:    else if (varCode == (int)VarCode::isdry && k == -1)  var[idx] = node->isDry?1.0:0.0;
 8153:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 8154:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 8155:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 8156:    
 8157:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 8158:       
 8159:    
 8160: }
 8161: 
 8162: 
 8163: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 8164:    // Get the value of a variable from an side
 8165:    // varName is the name of the variable to get
 8166:    // var is the array to store the value
 8167:    // k is the vertical level index of the variable to get
 8168:    SIDE(side);
 8169:    
 8170:    int idx = side->idx;
 8171:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8172: 
 8173:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 8174:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 8175:    // else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 8176:    else if (varCode == (int)VarCode::isdry && k == -1)   var[idx] = side->isDry?1.0:0.0;
 8177:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 8178:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 8179:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 8180:    // else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 8181:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 8182:    // else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 8183:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 8184:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 8185:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 8186:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 8187:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 8188:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 8189:    // else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 8190:    else if (varCode == (int)VarCode::bcc && k >= 0)     var[idx] = side->bcc[k].x;
 8191:    // else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 8192:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 8193:    // else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 8194:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 8195:    // else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 8196:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 8197:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 8198:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 8199:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 8200:    // else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 8201:    // else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 8202:    // else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 8203:    // else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 8204:    // else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 8205:    // else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 8206:    // else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 8207:    // else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 8208:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 8209: }
 8210: 
 8211: 
 8212: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8213:    // Get the value of a variable from an side
 8214:    // varName is the name of the variable to get
 8215:    // var is the array to store the value
 8216:    // k is the vertical level index of the variable to get
 8217:    SIDE_BND(sideBnd);   
 8218: 
 8219:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8220:    if (sideBnd->segment->isLand) idx = -7;
 8221: 
 8222:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8223:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8224: 
 8225: }
