 5722: 
 5723: 
 5724: 
 5725:    __global__ void solverCopyResult(double* x) {
 5726:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 5727:       NODE(node);
 5728:       const int idx = node->idx;
 5729: 
 5730:       node->mX = x[idx];
 5731:    }
 5732: 
 5733: 
 5734:    __global__ void rollUpElevation(void) {
 5735: 
 5736:       NODE(node);
 5737: 
 5738:       node->eta1 = node->eta2;
 5739: 
 5740:    }
 5741: 
 5742: 
 5743:    __global__ void backtrackAllNodes(void) {
 5744: 
 5745:       // max/min # of sub-divisions
 5746:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 5747:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 5748: 
 5749:       SIDE(side);
 5750: 
 5751:       const int kb = side->kb;
 5752: 
 5753: 
 5754:       // Initialize btrack velocities to the actual velocities at the side 
 5755:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 5756:   
 5757:       if (side->isDry) return;
 5758:      
 5759: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 5760: 
 5761:       // Checks that at least one element is not dry
 5762:       const Element *elem1 = side->elems[0];
 5763:       const Element *elem2 = side->elems[1];
 5764: 
 5765: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 5766: 
 5767:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 5768:       
 5769:       // XXXXXX
 5770:       // !swild_tmp to store global coord. of the starting side
 5771:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 5772:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 5773:       // !Use sframe2 
 5774:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 5775: 
 5776: 
 5777:       for (int k = kb; k < nvrt; k++) {
 5778:       //  For ics=2, the coordinates are all in the side's local frame
 5779: 
 5780:          const int iadvf = side->iadv();  // Advection flag   
 5781:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 5782: 
 5783:          const double vmag2 = norm2(side->u2[k]);
 5784: 
 5785:          if (vmag2 <= velmin_btrack_sq) {  
 5786:             // No activity 
 5787: 
 5788:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 5789:             
 5790:          } else {  // do btrack
 5791: 
 5792:             // Compute number of sub-divisions based on local gradients of the velocity field
 5793: 
 5794:             // XXX IS THIS NECESSARY?
 5795:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 5796:             double suma = 0.0;
 5797:             int icount = 0;
 5798:             #pragma unroll
 5799:             for (int l=0; l<2; l++) {
 5800:             // For each element sharing the side...
 5801: 
 5802:                const Element *elem = side->elems[l];
 5803:                  
 5804:                if (elem == nullptr) continue;
 5805: 
 5806:                icount++;
 5807: 
 5808:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 5809:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 5810:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 5811: 
 5812:                double utmp[4];
 5813:                double vtmp[4];
 5814:                #pragma unroll
 5815:                for (int j = 0; j < elem->i34; j++) {
 5816: 
 5817:                   const Node *node = elem->nodes[j];
 5818: 
 5819:                   if constexpr(ics==1) {
 5820:                      utmp[j] = node->u2[k].x;
 5821:                      vtmp[j] = node->u2[k].y;  
 5822: 
 5823:                   } else {
 5824:                      // 'Project' the velocity from the node frame to the element frame
 5825:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 5826:                      utmp[j] = tmp_u2.x;
 5827:                      vtmp[j] = tmp_u2.y;
 5828: 
 5829:                   }
 5830:                } // for j
 5831: 
 5832:                const Vector2 grad_u = elem->grad2(utmp); 
 5833:                const Vector2 grad_v = elem->grad2(vtmp);
 5834:    
 5835:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 5836:             } // for l
 5837: 
 5838:             assert(icount > 0 && "Impossible 77");
 5839: 
 5840:             // '4' is somewhat arbitrary
 5841:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 5842: 
 5843:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 5844:             Vector3 u_int = {0.0, 0.0, 0.0};
 5845: 
 5846:             side->btrack(k, dt, dtbk, u_int);
 5847: 
 5848: 
 5849:             side->btu[k] = {u_int.x, u_int.y};
 5850:                
 5851:          } // if vmag (do backtrack)
 5852: 
 5853: 
 5854:       } // for k=kb,nvrt-1
 5855: 
 5856:    }
 5857: 
 5858: } // extern "C"
 5859: 
 5860: template<int nc>
 5861: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 5862: 
 5863: // Solves a tridiagonal system. Adapted from Numerical Recipes in FORTRAN (pp.43).
 5864: //
 5865: // Although this is a general function, it is used only for equations on vertical levels.
 5866: // nc is the number of components in each unknown: 1 for a scalar, 2 for Vector2.
 5867: // It is not really for nc independent RHS vectors. We only use it for scalar and Vector2.
 5868: // Vector2 is stored as adjacent (x, y), so index of level j, component l is j*nc + l.
 5869: //
 5870: // a, b, c, rhs: inputs, not modified. gam: work array of length n.
 5871: // a, b, c are the three diagonals (b = main). a[0] and c[n-1] are unused.
 5872: // n: rank of the system (number of vertical levels in the 3D momentum solve).
 5873: // rhs, u: length n*nc, packed C order (n levels, nc components per level).
 5874: 
 5875:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 5876:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 5877: 
 5878:    double bet = b[0];
 5879:    if constexpr (nc == 1) {
 5880:       u[0] = rhs[0]/bet;
 5881:    } else {
 5882:       #pragma unroll
 5883:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 5884:    }
 5885: 
 5886:    for (int j = 1; j < n; j++) {
 5887:       gam[j] = c[j - 1]/bet;
 5888:       bet = b[j] - a[j]*gam[j];
 5889: 
 5890:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 5891: 
 5892:       if constexpr (nc == 1) {
 5893:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 5894:       } else {
 5895:          #pragma unroll
 5896:          for (int l = 0; l < nc; l++) {
 5897:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 5898:          }
 5899:       }
 5900:    }
 5901: 
 5902:    // Back-substitution
 5903:    for (int j = n - 2; j >= 0; j--) {
 5904:       if constexpr (nc == 1) {
 5905:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 5906:       } else {
 5907:          for (int l = 0; l < nc; l++) {
 5908:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 5909:          }
 5910:       }
 5911:    }
 5912: }
 5913: 
 5914: 
 5915: 
 5916: // Helper function that contains the core algorithm
 5917: template<typename XAccessor, typename YAccessor>
 5918: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 5919:                                     double  yp_top, double  yp_bot, 
 5920:                                     CubicSpline &spline) {
 5921:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 5922:    // 
 5923:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 5924:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 5925:    //
 5926:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 5927:    // 
 5928:    // Inputs: 
 5929:    //            n: dimension for x etc; # of data pts (>=2);
 5930:    //            getX, getY: functions to access x,y coordinates
 5931:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 5932:    //     Output: 
 5933:    //            spline (CubicSpline): spline structure with x,y,y',y''
 5934: 
 5935:    const int n = k2 - k1 + 1;
 5936:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 5937: 
 5938:    // Allocate memory for the splines
 5939:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 5940:    spline.x   = new double[n];
 5941:    spline.y   = new double[n];
 5942:    spline.yp  = new double[n];
 5943:    spline.ypp = new double[n];
 5944: 
 5945:    for (int k=k1; k<=k2; k++) {
 5946:       spline.x[k] = getX(k);
 5947:       spline.y[k] = getY(k);
 5948:    }
 5949: 
 5950:    // This is to simplify expressions later
 5951:    double *x = spline.x;
 5952:    double *y = spline.y;
 5953: 
 5954:    double *a = nullptr;
 5955:    double *b = nullptr;
 5956:    double *c = nullptr;
 5957:    double *gam = nullptr;
 5958:    double *rhs = nullptr;
 5959:    
 5960: 
 5961:       a = new double[n];   // Lower diagonal
 5962:       b = new double[n];   // Diagonal
 5963:       c = new double[n];   // Upper diagonal
 5964:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 5965:       rhs = new double[n]; // Right-hand side
 5966: 
 5967:    for (int k=k1; k<=k2; k++) {
 5968:       if (k == k1) {
 5969:          // Bottom level
 5970:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 5971:          b[k] = (x[k+1] - x[k])/3.0;
 5972:          c[k] = b[k]/2.0;
 5973:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 5974:       } else if (k == n - 1) {
 5975:          // Top level (surface)
 5976:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 5977:          b[k] = (x[k] - x[k-1])/3.0;
 5978:          a[k] = b[k]/2.0;
 5979:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 5980:       } else {
 5981:          // Intermediate levels
 5982:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 5983:          b[k] = (x[k+1] - x[k-1])/3.0;
 5984:          a[k] = (x[k  ] - x[k-1])/6.0;
 5985:          c[k] = (x[k+1] - x[k  ])/6.0;
 5986:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 5987:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 5988:       }
 5989:    }
 5990: 
 5991:    // Solve the tridiagonal system
 5992:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 5993:    
 5994:    spline.yp[k1] = yp_bot;
 5995:    spline.yp[k2] = yp_top;
 5996: 
 5997:    // Compute rest of 1st derivatives using the splines
 5998:    for (int k=k1+1; k<k2; k++) {
 5999:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 6000:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 6001:    }
 6002:    
 6003:    delete[] a;
 6004:    delete[] b;
 6005:    delete[] c;
 6006:    delete[] gam;
 6007:    delete[] rhs;
 6008: 
 6009: }
 6010: 
 6011: // Array version
 6012: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 6013:                                 double y_top, double y_bot, 
 6014:                                 CubicSpline &spline) {
 6015:    auto getX = [x] (int k) { return x[k]; };
 6016:    auto getY = [y] (int k) { return y[k]; };
 6017:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 6018: }
 6019: 
 6020: // Lambda version - allows custom access patterns
 6021: template<typename XFunc, typename YFunc>
 6022: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 6023:                                 double y_top, double y_bot,
 6024:                                 CubicSpline &spline) {
 6025:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 6026: }
