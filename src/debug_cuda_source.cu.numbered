 7519:       //    *sizeType = sizeof(Vector2);
 7520:       //    break;   
 7521:       case (int)VarCode::hhat:
 7522:          *offset = (int)((char*)&sides[0].hhat - (char*)sides);
 7523:          *sizeType = sizeof(Vector2);
 7524:          break;      
 7525:       case (int)VarCode::chi:
 7526:          *offset = (int)((char*)&sides[0].chi - (char*)sides);
 7527:          *sizeType = sizeof(double);
 7528:          break;
 7529:       case (int)VarCode::n1:
 7530:          *offset = (int)((char*)&sides[0].n1 - (char*)sides);
 7531:          *sizeType = sizeof(Node);
 7532:          break;
 7533:       case (int)VarCode::n2:
 7534:          *offset = (int)((char*)&sides[0].n2 - (char*)sides);
 7535:          *sizeType = sizeof(Node);
 7536:          break;                   
 7537:       default:
 7538:          *offset = -1;
 7539:    }
 7540: }
