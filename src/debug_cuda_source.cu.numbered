 1210: // This struct is used to store the boundary information for a node.
 1211: struct NodeBoundary {   
 1212:    int idx;
 1213:    BoundarySegment *segment;
 1214:    Node *node;
 1215:    
 1216:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1217:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1218: 
 1219:    bool isLand;
 1220: 
 1221:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1222:    double elbc;   // Elevation boundary condition
 1223:    double eth;    // Elevation time history
 1224: 
 1225:    double eta_mean; // Mean elevation at nodes
 1226: 
 1227:    bool isEssentialBC;
 1228: 
 1229:    Vector2 uth[nvrt];  // "Time history" velocity
 1230: 
 1231:    // Arrays for harmonic constituents (if needed)
 1232:    double  emo[nbfr];  // Elevation amplitude
 1233:    double  efa[nbfr];  // Elevation phase
 1234:    Vector2 umo[nbfr];  // velocity amplitude
 1235:    Vector2 ufa[nbfr];  // velocity phase
 1236: 
 1237: 
 1238:    NodeBoundary(void) {
 1239:       isLand = false;
 1240:    }
 1241:    NodeBoundary(bool _isLand) {
 1242:       isLand = _isLand;
 1243:    }
 1244: 
 1245:    
 1246:    __forceinline__ __device__ int numSidesForAverage() const {
 1247:    // Returns the number of sides that are connected to the node and have the same segment.
 1248:    // This is used to compute the average velocity at the node for open boundary nodes.
 1249:       int res = 0;
 1250:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1251:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1252: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1253:       return res;
 1254:    }
 1255: 
 1256: 
 1257:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1258:       assert(index == 0 || index == 1); 
 1259:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1260:    }
 1261: 
 1262: 
 1263: };
