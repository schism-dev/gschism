 3813:    __global__ void computeVerticallyIntegratedVelocity(void) {
 3814: 
 3815:       SIDE(side);
 3816: 
 3817: 
 3818:       side->U = {0.0, 0.0}; 
 3819:          
 3820:       if(side->isDry) return;
 3821: 
 3822:       const Node *node1 = side->n1;
 3823:       const Node *node2 = side->n2;
 3824: 
 3825:       // Vertically integrated velocity U (in ll if ics=2)
 3826:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 3827:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 3828:       }
 3829: 
 3830:    }
 3831: 
 3832:    __global__ void computeBottomDragVegetation(void) {
 3833:       // UNFINISHED. CHECK THIS:
 3834:       // How many kernels are needed? Why so many for loops?
 3835:       // Is the loop on sides needed?
 3836: 
 3837:       NODE(node);
 3838: 
 3839:       const int    kb      = node->kb;
 3840:       const double htot    = node->htot2();
 3841:       const double rough   = node->rough;
 3842: 
 3843: 
 3844:       if (node->isDry) {
 3845:          // Default values for dry nodes
 3846:          node->veg_alpha_vert_mean = node->veg_alpha0;
 3847:          /// XXX CHECK INDICES
 3848:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 3849:       }
 3850: 
 3851:       // Compute bottom drag Cd
 3852:       //--------------------------------
 3853: 
 3854:       // nchi = {-1, 0, 1} is the type of bottom drag.
 3855:       if (nchi==1) {
 3856: 
 3857:          bool ltmp = false; // for WBL iteration
 3858: 
 3859:          // Cdmax=-1 !max. Cd at node for this process (info only)
 3860:          // Drag at nodes
 3861:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 3862:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 3863:         
 3864:          const double rough = node->rough;
 3865:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3866:          if (node->rough == 0.0) {
 3867:             node->Cd = 0.0;
 3868: 
 3869:          } else { //roughness >0 
 3870:             
 3871:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 3872:             const double bthick = max(dzb_min, bthick_ori);
 3873: 
 3874:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 3875: 
 3876:             double tmp = 1.0/(2.5*log(bthick/rough));
 3877:             node->Cd = tmp*tmp;
 3878: 
 3879:          } // if rough
 3880: 
 3881: 
 3882:          // RECOVER THIS: XXX
 3883:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 3884:          // Output warning for WBL if iteration didn't converge
 3885: 
 3886: 
 3887:       } // nchi==1
 3888: 
 3889:       //   Bottom stress in m^2/s^2
 3890:       if (node->rho[kb + 1] >= -98.0)
 3891:       {
 3892:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 3893:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 3894:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 3895:          // !sediment erosion: this part needs more documentation
 3896:       }
 3897: 
 3898:     
 3899:       // Compute vegetation parameters
 3900:       //--------------------------------
 3901: 
 3902:       // SAV constants
 3903:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 3904:       constexpr double veg_cfpsi = 0.16;
 3905: 
 3906:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 3907:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 3908: 
 3909:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 3910:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 3911:          int kbin = 0; // bin index
 3912:          for (int k = kb; k < nvrt; k++) {
 3913:             // Computes node height above the bottom level
 3914:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 3915:             assert(false && "Vertical variation of vegetation not implemented");
 3916: 
 3917:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 3918:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 3919:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 3920:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 3921:             // } else {
 3922:             //    // Find the bin at which the current vertical level is
 3923:             //    while (kbin<nbins_veg_vert) {
 3924:             //       const double zn = node->z[kbin];
 3925:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 3926:             //          break;
 3927:             //       } // if
 3928:             //       kbin++;
 3929:             //    } // while
 3930:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 3931: 
 3932:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 3933:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 3934:                
 3935:             //    // Linear interpolation of the vegetation parameters
 3936:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 3937:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 3938:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 3939:             // } // if rl10
 3940: 
 3941:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 3942: 
 3943:          } // for k
 3944: 
 3945: 
 3946:       } else { // Ganthy (iveg=2)
 3947:       //  Modify canopy height, diameter, and density
 3948: 
 3949:          // Make sure there is vegetation on this node
 3950:          if (node->veg_h_unbent > 0.0) {
 3951:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 3952: 
 3953:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 3954:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 3955:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 3956: 
 3957:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 3958:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 3959:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 3960:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 3961:          } // if veg_h_unbent
 3962: 
 3963:          for (int k = 0; k < nvrt; k++) {
 3964:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 3965:          } // for k
 3966:       
 3967: 
 3968:       } // if iveg
 3969:      
 3970:          
 3971: 
 3972:       // Compute vertical mean of veg_alpha3D
 3973:       if (iveg != 0) {
 3974:          const double ztop = node->zTopCanopy(); // Top of the canopy
 3975:          double sum1=0.0;
 3976:          double sum2=0.0;
 3977:          // Integrate over each level under the canopy...
 3978:          for (int k=kb; k<nvrt-1 && node->z[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 3979:             const double Dz = node->Dz(k);
 3980: 
 3981:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 3982:             sum2 += Dz;
 3983: 
 3984:          } // for k
 3985: 
 3986:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 3987:          else             node->veg_alpha_vert_mean = sum1/sum2;
 3988: 
 3989:       } // if iveg
 3990: 
 3991:       printf("computeBottomDragVegetation: nodeIdx = %d, node->veg_alpha_vert_mean = %f\n", node->idx, node->veg_alpha_vert_mean);
 3992: 
 3993:    }
 3994: 
 3995:    __global__ void computeVegetationAndDragParameters(void) {
 3996:       // Computes the vegetation and drag model parameters:
 3997:       // chi, \tilde\chi, beta, \breve{H}
 3998:       
 3999:       SIDE(side);
 4000: 
 4001:       const double htot = side->htot2();
 4002:       const int    kb   = side->kb;
 4003: 
 4004:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4005: 
 4006:       const double veg_h     = side->veg_h();
 4007:       const double veg_nv    = side->veg_nv();
 4008:       const double veg_c     = side->veg_c();
 4009:       const double veg_beta  = side->veg_beta;
 4010:       const double veg_alpha = side->veg_alpha_vert_mean();
 4011: 
 4012:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4013:       // Velocity magnitude at the bottom level
 4014:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4015:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4016:       side->chi2 = side->Cd()*vmag1;
 4017:       side->chi  = side->chi2;
 4018:       if constexpr(iveg != 0) {
 4019:          const Node *n1 = side->n1;
 4020:          const Node *n2 = side->n2;
 4021:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4022:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4023:       }
 4024: 
 4025:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4026: 
 4027:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4028:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4029:       double magUa = 0.0;
 4030:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4031:          // 3D wet side with veg...
 4032: 
 4033:          double magUa = 0.0;
 4034:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4035:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4036: 
 4037:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4038:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4039:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4040: 
 4041:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4042:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4043: 
 4044:                // Velocity magnitude at the bottom (l) of the level
 4045:                const double ul = length(side->u2[k]);
 4046: 
 4047:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4048:                magUa += Dz*0.5*(uh + ul);
 4049: 
 4050:             } // if HasVegetation
 4051:          } // for k
 4052:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4053: 
 4054:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4055:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4056:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4057:             const double zCpy = side->zTopCanopy();
 4058:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4059:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4060:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4061:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4062:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4063:          } // if isSubmerged
 4064:       } // if iveg   
 4065: 
 4066:       // Computes the friction modified depth, \breve{H} in notes
 4067:       if (side->is2D()) { // 2D
 4068: 
 4069:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4070:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4071: 
 4072:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4073: 
 4074:          side->hhat = htot*htot/fricH; 
 4075: 
 4076:       } else { // 3D
 4077:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4078: 
 4079:          if constexpr(iveg != 0) {
 4080:             
 4081:             if (side->isSubmerged()) { 
 4082:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4083:                side->hhat -= veg_c*Hhat_alpha;
 4084: 
 4085:             } else { // Emergent
 4086:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4087:             }
 4088:          } // if iveg
 4089: 
 4090:          // Enforce positivity for 3D model
 4091:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4092:       } // if 3D
 4093: 
 4094:       printf("computeVegetationAndDragParameters: sideIdx = %d, side->htot = %f, side->hhat = %f\n", side->idx, side->htot2(), side->hhat);
 4095: 
 4096:         
 4097:    }
 4098: 
 4099: 
 4100: 
 4101:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4102:    // Computes the density gradient between two elements, e1 and e2.
 4103:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4104:    // zero in the direction normal to the side. 
 4105:    // 
 4106:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4107:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4108:    //
 4109:    // Input:
 4110:    //    e1: Element
 4111:    //    e2: Neighbor element (or nullptr if boundary)
 4112:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4113:    //    k: Index of the half-level at which the density is interpolated
 4114:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4115:    // 
 4116:    // Output:
 4117:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4118:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4119: 
 4120:       if (e2 == nullptr || e2->isDry) {
 4121:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4122: 
 4123:          Side *side = e1->sides[j];
 4124:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4125:                  
 4126:          if constexpr(ics == 1) {
 4127:             vec = side->n; // Normal vector to the side
 4128:          } else {
 4129:             // IMPLEMENT THIS XXXXXX
 4130:             // !replace with xel, yel?
 4131:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4132:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4133:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4134:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4135:          } //ics
 4136:                    
 4137:          diffRho = 0.0;
 4138: 
 4139:       } else { //internal and wet
 4140:          if constexpr(ics==1) {
 4141:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4142: 
 4143:             // Vector from e1 to e2
 4144:             vec = toVector2(e2->center - e1->center);
 4145: 
 4146:          } else { 
 4147:             // IMPLEMENT THIS XXXXXX
 4148:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4149:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4150:             //                   alow(j)=xctr2
 4151:             //                   bdia(j)=yctr2
 4152:          } // ics
 4153: 
 4154:          diffRho = rho2 - e1->demeanedDensity(k);
 4155:       }
 4156: 
 4157:    }
 4158: 
 4159:    __global__ void computeDensityCubicSplines(void) {
 4160:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4161: 
 4162:       ELEM(elem);
 4163: 
 4164:       if (elem->isDry) return;
 4165: 
 4166:       const int kb = elem->kb;
 4167: 
 4168:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4169:       if (elem->is2D()) {
 4170:          // In the 2D case, the density is constant at the prism level. 
 4171:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4172:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4173:       } else { //3D
 4174: 
 4175:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4176:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4177:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4178:          ///// XXXX CHECK INDICES!!!!!
 4179:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4180:       } // 2D/3D
 4181: 
 4182:    }
 4183: } // extern "C"
 4184: 
 4185: 
 4186: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4187: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4188: 
 4189:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4190: 
 4191:    const int kb  = elem->kb;
 4192:    const int kb2 = elem2->kb;
 4193: 
 4194:    // z-coordinate of prism of elem
 4195:    const double zp = elem->z_prism(k);
 4196: 
 4197:    double rho = 0.0;
 4198: 
 4199:    if (elem2->is2D()) {
 4200:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4201: 
 4202:    } else {  // 3D
 4203: 
 4204:       // eta_min may be < zmax
 4205:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4206:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4207: 
 4208:       // (Extrapolate density below bottom, we will fix it later)
 4209:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4210:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4211:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4212:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4213:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4214:    } // 2D/3D
 4215:      
 4216: 
 4217:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4218:    // Now we need to fix it.
 4219:    if (elem->z[k] < elem2->z[kb2]) {
 4220:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4221: 
 4222:       // There are two methods to adjust the density at the bottom of the element.
 4223:       // iunder_deep=0: 
 4224:       const double depth1 = abs(elem->z[kb]); // larger depth
 4225: 
 4226:       if (iunder_deep==0) {
 4227: 
 4228:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4229: 
 4230:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4231: 
 4232:       } else { // iunder_deep != 0
 4233: 
 4234:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4235: 
 4236:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4237: 
 4238:          //   Demeaned density at the same z coordinate as
 4239:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4240:          }
 4241: 
 4242:       } // if iunder_deep
 4243:    } // if elem->z[kb] < elem2->z[kb]
 4244: 
 4245:    return rho;
 4246: }
 4247: 
 4248: 
 4249: extern "C" {
 4250:    __global__ void computeDensityGradient(void) {
 4251: 
 4252:          // Compute the horizontal density gradient at each element.
 4253:       // It works in two steps:
 4254:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4255:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4256:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4257:       //             gradRho.r1 = rho1 - rho0
 4258:       //             gradRho.r2 = rho2 - rho0
 4259:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4260:       // 
 4261:       //  NOTE: We use de-meaned densities.
 4262: 
 4263:       ELEM(elem);
 4264: 
 4265:       if (elem->isDry) return;
 4266: 
 4267:       const int kb  = elem->kb;
 4268:       const int i34 = elem->i34;
 4269: 
 4270:       for (int k = kb + 1; k < nvrt; k++) {
 4271:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 4272:          //             gradRho.r1 = rho1 - rho0
 4273:          //             gradRho.r2 = rho2 - rho0
 4274:          int icount = 0;
 4275:          double sumRx = 0.0;
 4276:          double sumRy = 0.0;
 4277:          for (int j1=0; j1<i34; j1++) { 
 4278: 
 4279:             const int j2 = elem->nxq(j1 + 1);
 4280: 
 4281:             // Pairs of consecutive neighbor elements of elem
 4282:             const Element *e1 = elem->nghbElems[j1];
 4283:             const Element *e2 = elem->nghbElems[j2];
 4284: 
 4285:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 4286:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 4287:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 4288: 
 4289:             // Compute the density difference and the vector from elem to e1 and e2
 4290:             // getRhoDiffAndVec takes into account boundaries/dry elements
 4291:             double diffRho1, diffRho2;
 4292:             Vector2 vec1, vec2;
 4293:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 4294:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 4295: 
 4296:             const double rl1 = length(vec1);
 4297:             const double rl2 = length(vec2);
 4298:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 4299: 
 4300:             const double delta = cross(vec1, vec2);
 4301:             const double sintheta = abs(delta)/(rl1*rl2);
 4302: 
 4303:             // To avoid problems, avoid elements with small angle between vectors
 4304:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 4305:             const bool validEq = (sintheta > sin_one_deg);
 4306: 
 4307:             if (validEq) {
 4308:                // Solve the system of equations to get the density gradient at elem
 4309:                icount++;
 4310:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 4311:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 4312:                sumRx += Rx;
 4313:                sumRy += Ry;
 4314:             }
 4315:          } // for j1
 4316: 
 4317:          // Compute the average density gradient at elem
 4318:          if (icount==0) {
 4319:            // Bad mesh quality; bail out with 0 b-cc
 4320:            elem->gradRho[k] = {0.0, 0.0};
 4321:          } else {
 4322:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 4323:          }
 4324: 
 4325:       } // for k
 4326: 
 4327:    }
 4328: 
 4329:    __global__ void computeBaroclinicTerm(void) {
 4330:    // Computes the baroclinic term at sides (at half levels).
 4331:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 4332:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 4333: 
 4334:       SIDE(side);
 4335: 
 4336:       if (side->isDry) return;
 4337: 
 4338:       const Element *e1 = side->elems[0];
 4339:       const Element *e2 = side->elems[1];      
 4340:       const int kb = side->kb;
 4341:       
 4342:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 4343: 
 4344:       // interpolates vertically the density gradient of the two elements at the half level/
 4345: 
 4346:       // Starts the integration at the surface and goes down to the bottom
 4347:       int k1 = nvrt - 1;
 4348:       int k2 = nvrt - 1;
 4349: 
 4350:       side->bcc[nvrt-1] = {0.0, 0.0};
 4351:       for (int k = nvrt-1; k >= kb; k--) {
 4352:       // For each prism level (from surface to bottom)...
 4353: 
 4354:          // For both elements, interpolate density gradient at the side's half level.
 4355:          // The gradient at the side is the average of the gradients at the elements.
 4356:          // w1, w2 are used to take into account boundary sides, with just one element.
 4357:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 4358:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 4359:          const double wsum = w1 + w2;
 4360:          w1 = w1/wsum;
 4361:          w2 = w2/wsum;
 4362:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 4363: 
 4364:          // Linear interpolation of both elements' density gradient at the shared side's level.
 4365:          Vector2 gradRho = {0.0, 0.0};
 4366:          if (e1 != nullptr && k > kb) {
 4367:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 4368:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 4369:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 4370:             
 4371:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 4372:          }      
 4373:          if (e2 != nullptr && k > kb) {
 4374:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4375:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4376:             
 4377:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4378:          }
 4379: 
 4380:          if constexpr(ics==2) {
 4381:             // IMPLEMENT THIS XXXXXX
 4382:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4383:             // swild(1)=tmp1
 4384:             // swild(2)=tmp2
 4385:          }
 4386:          
 4387:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4388:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4389:          // CHECK INDICES!!! XXX
 4390:          const double grav3 = side->grav3();
 4391:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4392:       } // for
 4393: 
 4394:    }
 4395: 
 4396: 
 4397: 
 4398:    __global__ void computeHorGradientAtSide(void) {
 4399: 
 4400:       // Compute the horizontal density gradient at each element.
 4401:       // It works in two steps:
 4402:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4403:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4404:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4405:       //             gradRho.r1 = rho1 - rho0
 4406:       //             gradRho.r2 = rho2 - rho0
 4407:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4408:       // 
 4409:       //  NOTE: We use de-meaned densities.
 4410: 
 4411:       SIDE(side);
 4412: 
 4413:       if (side->isDry) return;
 4414: 
 4415:       // Computes the gradient of the variables at the side center.
 4416:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 4417:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 4418:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 4419: 
 4420:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 4421:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 4422:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 4423:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 4424: 
 4425: 
 4426:       printf("gradEta1: %e, %e, gradEta2: %e, %e, gradETP: %e, %e, gradPr: %e, %e\n", 
 4427:          side->gradEta1.x, side->gradEta1.y, 
 4428:          side->gradEta2.x, side->gradEta2.y, 
 4429:          side->gradETP.x, side->gradETP.y, 
 4430:          side->gradPr.x, side->gradPr.y);
 4431: 
 4432: 
 4433:    }
 4434: 
 4435: 
 4436:    __global__ void solveMomentumEquations(double time) {
 4437: 
 4438:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 4439:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 4440: 
 4441:       SIDE(side);
 4442: 
 4443:       if (side->isDry) 
 4444:       {
 4445:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 4446: 
 4447:          return;
 4448:       }
 4449: 
 4450:       const Node *n1 = side->n1;
 4451:       const Node *n2 = side->n2;
 4452: 
 4453:       const int kb = side->kb;
 4454: 
 4455:       const double veg_h = side->veg_h();
 4456:       const double grav3 = side->grav3();
 4457: 
 4458: printf("###>>>#side->is2D() = %d\n", side->is2D());
 4459:       if (side->is2D()) {
 4460:          // Warning: Do not use htot2, which is updated.
 4461:          const double htot = side->htot1();
 4462:          const double hhat = side->hhat;
 4463: 
 4464:          assert(hhat > 0.0 && htot > 0.0 && "Impossible dry 55:");
 4465: 
 4466:          Vector2 tau2 = {0.0, 0.0};
 4467:           
 4468:          if constexpr(ics==1) {
 4469:             tau2 = side->tau();
 4470: 
 4471:          } else {
 4472:             assert(false && "Not implemented: ics == 2");
 4473:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4474:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4475:             // taux2=(vn1+tt1)*0.5d0
 4476:             // tauy2=(vn2+ss1)*0.5d0
 4477:          } // if ics         
 4478: 
 4479:          // hat_gam has units of m/s
 4480: 
 4481:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 4482: 
 4483:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 4484:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 - thetai*side->gradEta2));
 4485: 
 4486:          hat_gam += dt*side->d2uv[nvrt-1];  // XXXX compute d2uv
 4487: 
 4488:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvel1, rmaxvel1);
 4489:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvel2, rmaxvel2);
 4490: 
 4491:          for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 4492: 
 4493: printf("###>>>#side->u2[%d] = %e, %e\n", nvrt-1, side->u2[nvrt-1].x, side->u2[nvrt-1].y);
 4494: 
 4495:       }
 4496:       else { // 3D
 4497: 
 4498:          // For 3D it is necessary to solve an implicit tridiagonal system.
 4499:          // 
 4500:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 4501:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 4502:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 4503:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 4504:          // k+1 and k.
 4505: 
 4506: 
 4507:          // // Define layer thickness & viscosity
 4508:          // for (int k=kb + 1; k<nvrt; k++) {
 4509:          //    const double dzz = side->Dz(k - 1);
 4510: 
 4511:          //    assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4512: 
 4513:          //    // Vertical viscosity at the face center
 4514:          //    dfz(k) = 0.25*(n1->dfv[k] + n2->dfv[k] + n1->dfv[k-1] + n2->dfv[k-1]);
 4515:         
 4516:          // }
 4517: 
 4518: 
 4519:          const int ndim = nvrt - kb;
 4520:          const double zTopCanopy = side->zTopCanopy();
 4521: 
 4522:          // Initialize the tridiagonal system
 4523:          for (int k = kb + 1; k<nvrt; k++) {
 4524:             
 4525:             const int kin = k - kb;
 4526: 
 4527:             // Vertical viscosity at the face center
 4528:             const double dfz = 0.25*(side->dfv(k) + side->dfv(k + 1));
 4529:             const double dzz = side->Dz(k);
 4530: 
 4531:             printf("k: %d, side->zc[0]: %e, side->n1->z[0]: %e, side->n2->z[0]: %e, dzz: %e, dfz: %e\n",k, side->zc[0], side->n1->z[0], side->n2->z[0], dzz, dfz);
 4532:             printf("k: %d, side->zc[1]: %e, side->n1->z[1]: %e, side->n2->z[1]: %e, dzz: %e, dfz: %e\n",k, side->zc[1], side->n1->z[1], side->n2->z[1], dzz, dfz);
 4533:             assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4534: 
 4535:             alow[kin] = 0.0;
 4536:             cupp[kin] = 0.0;
 4537:             bdia[kin] = 0.0;
 4538: 
 4539:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 4540:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 4541: 
 4542:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 4543:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 4544:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 4545: 
 4546:             // First part: layers k, k+1
 4547:             if (k < nvrt - 1) {
 4548:                              
 4549:                if constexpr(iveg != 0) {
 4550: 
 4551:                   // If there is vegetation at this level...
 4552:                   if (zTopCanopy > side->zc[k]) {
 4553:                      // If the canopy is above the k layer...
 4554:                      
 4555:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 4556:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 4557:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 4558:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 4559: 
 4560:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 4561:                      const double vmag2 = length(ut2);
 4562:                      const double vmag1 = length(side->u2[k]);
 4563:                      const double vmag = 0.5*(vmag1 + vmag2);
 4564:                      
 4565:                      // Computes the vegetation alpha at the face center
 4566:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 4567: 
 4568:                      cff1 += veg_alpha_sd*dt*vmag;
 4569: 
 4570:                   } // if (zTopCanopy
 4571:                } // if iveg
 4572: 
 4573:                const double tmp = dt*dfz/dzz;
 4574:                cupp[kin] += cff1*dzz/6.0 - tmp;
 4575:                bdia[kin] += cff1*dzz/3.0 + tmp;
 4576: printf("####cff1 = %f, dzz = %f, tmp = %f, cupp[%d] = %f, bdia[%d] = %f\n", cff1, dzz, tmp, cupp[kin], kin, bdia[kin]);               
 4577:             }
 4578: 
 4579: 
 4580:             // Second part: layers k-1, k
 4581:             if (k > kb + 1) {
 4582: 
 4583:                double cff1 = 1.0; //init \bar{c^k}
 4584: 
 4585:                if constexpr(iveg != 0) {
 4586:                   // If there is vegetation at this level...
 4587:                   if (zTopCanopy > side->zc[k-1]) {
 4588:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 4589:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 4590: 
 4591:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 4592: 
 4593:                      const double vmag2 = length(ut2);
 4594:                      const double vmag1 = length(side->u2[k-1]);
 4595:                      const double vmag = 0.5*(vmag1 + vmag2);
 4596: 
 4597:                      // Computes the vegetation alpha at the face center
 4598:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 4599:                      cff1 += veg_alpha_sd*dt*vmag;
 4600:                   } // if zTopCanopy
 4601: 
 4602:                } // if iveg
 4603: 
 4604:                const double tmp = dt*dfz/dzz;
 4605:                alow[kin] += cff1*dzz/6.0 - tmp;
 4606:                bdia[kin] += cff1*dzz/3.0 + tmp;
 4607: printf("####cff1 = %f, dzz = %f, tmp = %f, alow[%d] = %f, bdia[%d] = %f\n", cff1, dzz, tmp, alow[kin], kin, bdia[kin]);               
 4608:             } else { // Bottom boundary
 4609:                // This occurs at the bottom, where the bottom drag is applied.
 4610: 
 4611:                bdia[kin] += dt*side->chi2;
 4612: printf("####3 k = %d, kb + 1 = %d, nvrt - 1 = %d, chi2 = %f, alow[%d] = %f, bdia[%d] = %f\n", k, kb + 1, nvrt - 1, side->chi2, kin, alow[kin], kin, bdia[kin]);               
 4613:             } // if (k > kb + 1)
 4614: 
 4615: 
 4616: 
 4617:          } // for (int k
 4618: 
 4619: 
 4620: 
 4621:          // Computes the RHS.
 4622:          // -----------------
 4623: 
 4624:          //	BC to be imposed at the end.
 4625: 
 4626:          const Vector2 gradETP  = side->gradETP;
 4627:          const Vector2 gradPr   = side->gradPr;
 4628:          const Vector2 gradEta1 = side->gradEta1;
 4629:          const Vector2 gradEta2 = side->gradEta2;
 4630: 
 4631:          const Vector2 *btu = side->btu;
 4632:          const Vector2 *u2  = side->u2;
 4633:          const double coriolis = side->coriolis;
 4634:          const Vector2 *d2uv = side->d2uv;
 4635: 
 4636: 
 4637:          for (int k = kb + 1; k<nvrt; k++) {
 4638:             const int kin = k - kb;
 4639: 
 4640:             const double dz_0 = side->Dz(k);
 4641:             const double dz_1 = side->Dz(k+1);  
 4642: 
 4643:             rrhs[kin] = {0.0, 0.0};
 4644:             double dz = 0.0;
 4645: 
 4646:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 4647:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 4648:             if (k < nvrt  ) dz += 0.5*dz_1;
 4649:             if (k > kb + 1) dz += 0.5*dz_0;
 4650: 
 4651:             // Elevation gradient, atmospheric pressure and tidal potential
 4652:             rrhs[kin] = -dz*dt*(grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0);
 4653: 
 4654:             // Coriolis, advection, wind stress, and horizontal viscosity
 4655:             if (k < nvrt - 1) {
 4656: 
 4657: 
 4658:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 4659:                                           (dt*coriolis)*rot90(2.0*u2[k] + u2[k + 1]) + 
 4660:                                           dt*(2.0*d2uv[k] + d2uv[k + 1]));
 4661: 
 4662:                //diff stress tensors 1006
 4663:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 4664:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 4665:                   assert(false && "Not implemented: itur == 5");
 4666:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 4667:                }
 4668: 
 4669:             } else { // k=nvrt
 4670:                Vector2 tau2 = {0.0, 0.0};
 4671:                if constexpr(ics==1) {
 4672:                   tau2 = side->tau();
 4673:                } else {
 4674:                   assert(false && "Not implemented: ics == 2");
 4675:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4676:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4677:                   // taux2=(vn1+tt1)*0.5d0
 4678:                   // tauy2=(vn2+ss1)*0.5d0
 4679:                } // if ics
 4680: 
 4681:                rrhs[kin] += dt*tau2;
 4682: 
 4683:             } // if k<nvrt
 4684: 
 4685:             if (k > kb + 1) {
 4686:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k - 1] + 
 4687:                                        (dt*coriolis)*rot90(2.0*u2[k] + u2[k - 1]) + 
 4688:                                        dt*(2.0*d2uv[k] + d2uv[k - 1]));
 4689: 
 4690: 
 4691:                // diff stress tensors 1006
 4692:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 4693:                   assert(false && "Not implemented: itur == 5");
 4694:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 4695:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 4696:                }
 4697: 
 4698:             } // if k>kbs + 1
 4699: 
 4700:             // Baroclinic
 4701:             Vector2 *bcc = side->bcc;
 4702:             if constexpr(ibc == 0) {
 4703:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 4704:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 4705: 
 4706:             } // if ibc==0
 4707: 
 4708: 
 4709:          } // k=kb + 1,nvrt
 4710: 
 4711:    printf("#### bdia[0] = %f, bdia[1] = %f, bdia[2] = %f, bdia[3] = %f\n", bdia[0], bdia[1], bdia[2], bdia[3]);         
 4712:    // tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4713:          tridag_sch<2>(nvrt, alow, bdia, cupp, (double *)rrhs, (double *)u, (double *)gam);
 4714: 
 4715:          for (int k=kb + 1; k<nvrt; k++) {
 4716:             const int kin = k - kb;
 4717: 
 4718:             // Velocity is always clamped to maximum values
 4719:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvel1, rmaxvel1), clamp(soln[kin].y, -rmaxvel2, rmaxvel2));
 4720:          } // k
 4721: 
 4722:       } // if side->is2D()
 4723:       
 4724: 
 4725:       // Impose velocity boundary conditions at the bottom
 4726:       if constexpr(imm == 2) { //no slip
 4727:          double dep;
 4728:          Vector2 vel;
 4729: 
 4730:          assert(false && "Not implemented: imm == 2");
 4731:          //update_bdef(time, x0, y0, dep, vel);
 4732:          // side->u2[kb] = vel;
 4733: 
 4734:       } else {
 4735:          if (side->Cd() == 0.0) {
 4736:             side->u2[kb] = side->u2[kb + 1];
 4737:          } else if (nvrt > kb + 1) { // 3D no slip bottom
 4738:             side->u2[kb] = {0.0, 0.0};
 4739:          }
 4740:           
 4741:       } // if imm
 4742: 
 4743:       // XXX aren't we undoing what was done here: for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 4744:       for (int k=0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 4745:       
 4746: 
 4747:    }
 4748: 
 4749: 
 4750:    __device__ void applyMomentumBC(void) {
 4751: 
 4752:       SIDE_BND(side_bnd);
 4753: 
 4754:       Side *side = side_bnd->side;
 4755:       const BoundarySegment *segment = side_bnd->segment;
 4756:       const Node *n1 = side->n1;
 4757:       const Node *n2 = side->n2;
 4758: 
 4759:       // REMEMEBER, this is a trick, segment can be a pointer or (-1, -2)
 4760:       const bool isLand     = (segment == (BoundarySegment *)landSegment);
 4761:       const bool isInternal = (segment == (BoundarySegment *)internalSegment);
 4762: 
 4763:       assert(!isInternal && "applyMomentumBC: Shouldn't be an internal side");
 4764:       const int kb = side->kb;
 4765: 
 4766:       if (!isLand && segment->ifltype != 0) {
 4767:          const Vector2 *uth = side->uth;
 4768: 
 4769:          for (int k=kb; k < nvrt; k++) {
 4770:             assert(segment->ifltype == -2 || (uth[k].x >= -98 && uth[k].y >= -98) && "Momentum BC: Side has no velocity boundary conditions");
 4771: 
 4772:             Vector2 uth = side->uth[k];
 4773: 
 4774:             if (segment->ifltype == -1) {
 4775:                // Flather 1
 4776: 
 4777:                const double depth = side->depth();
 4778: 
 4779:                assert(n1->nodeBnd->eta_mean >= -98 && n2->nodeBnd->eta_mean >= -98 && "Flather bnd elevation not assigned");
 4780:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 4781: 
 4782:                const double vnorm = sqrt(grav/depth)*(side->eta2() - side->etaMeanBnd()) + dot(uth, side->n);
 4783: 
 4784:                side->u2[k] = vnorm*side->n;
 4785: 
 4786:             } else if (segment->ifltype == -2) { // Discharge
 4787: 
 4788: 
 4789:                const double eta1 = side->eta1();
 4790:                const double eta2 = side->eta2();
 4791:                const double htot = side->htot2();
 4792: 
 4793:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 4794:                assert(false && "Not implemented: Discharge bc");
 4795:                // const double dischrg = discharge(eta1);
 4796:                const double dischrg = 0.0; // XXX REMOVE
 4797:                
 4798: 
 4799:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 4800: 
 4801:                const double vnorm = dischrg*eta2/htot;
 4802: 
 4803:                side->u2[k] = vnorm*side->n;
 4804: 
 4805: 
 4806:             }
 4807:             else if (segment->ifltype == -4 || segment->ifltype == -5) { // 3D radiation
 4808:                const double vnorm = dot(side->u2[k], side->n);
 4809: 
 4810:                double rat;
 4811:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 4812:                else              rat = segment->vobc2; // outgoing
 4813: 
 4814:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*uth;
 4815:             }
 4816:             else { // not Flather or 3D radiation
 4817:                side->u2[k] = uth;
 4818: 
 4819:             } // if (segment->ifltype...
 4820: 
 4821:          }
 4822: 
 4823:       }
 4824:       else if (isLand) { // land bnd
 4825:          if constexpr(islip == 0) { // free slip
 4826:             for (int k=kb; k < nvrt; k++) {
 4827:                double vnorm = 0.0; // for most cases
 4828:                const double vtan = dot(side->u2[k], side->t());
 4829:                side->u2[k] = vtan*side->t() - vnorm*side->n;
 4830:             }
 4831: 
 4832:          } else { // no slip
 4833:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 4834: 
 4835:          }
 4836:       } // if (side segment type...
 4837: 
 4838:       
 4839: 
 4840: 
 4841: 
 4842:    }
 4843: 
 4844: 
 4845:    __device__ void shapiroFilter1(void) {
 4846:       // First step of the Shapiro filter (normally used if indvel<=0)
 4847:       // Computes the filtered values and stores them in bcc (as a temporary array).
 4848: 
 4849:       if constexpr(ishapiro == 0) return;
 4850: 
 4851:       SIDE(side);
 4852: 
 4853:       const bool isInternal = (side->sideBnd->segment == (BoundarySegment *)internalSegment);
 4854: 
 4855:       if (side->isDry || isInternal ) return;
 4856: 
 4857:       const int kb = side->kb;
 4858: 
 4859:       for (int mm = 1; mm <= niter_shap; mm++) {
 4860: 
 4861: 
 4862:          // Internal wet sides
 4863:          for (int k = kb + 1; k < nvrt; k++) {
 4864:             // WARNING: reusing bcc as a temporary array to store the suru values.
 4865:             side->bcc[k] = {0.0, 0.0};
 4866:             Vector2 suru = {0.0, 0.0};
 4867: 
 4868:             for (int j=0; j<4; j++) {
 4869: 
 4870:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 4871:                
 4872:                int kin = k;
 4873:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 4874:                
 4875:                if constexpr(ics==1) {
 4876:                   suru += side->u2[kin];
 4877:                } else {
 4878:                   assert(false && "Not implemented: ics == 2");
 4879:                   // Vector2 vn1, vn2;
 4880:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 4881:                   // suru=suru+vn1;
 4882:                   // surv=surv+vn2;
 4883:                }
 4884:             }
 4885: 
 4886:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 4887: 
 4888:          }
 4889:       }
 4890:    }
 4891: 
 4892:    __device__ void shapiroFilter2(void) {
 4893:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 4894: 
 4895:       if constexpr(ishapiro == 0) return;
 4896: 
 4897:       SIDE(side);
 4898: 
 4899:       const bool isInternal = (side->sideBnd->segment == (BoundarySegment *)internalSegment);
 4900: 
 4901:       if (side->isDry || isInternal ) return;
 4902: 
 4903:       const int kb = side->kb;
 4904: 
 4905:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 4906: 
 4907:       if (side->is2D()) {
 4908:          side->u2[kb] = side->u2[nvrt - 1];
 4909:          
 4910:       } else {
 4911:          // 3D
 4912:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 4913:          
 4914:       }
 4915: 
 4916:    }
 4917: 
 4918: 
 4919:    __global__ void ul0UpdateZCoords(void) {
 4920:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 4921:       
 4922:       NODE(node);      
 4923: 
 4924:       if (node->isDry2()) { 
 4925: 
 4926:          assert((ivcor != 2) && (node->depth < mesh->h_s) && "Deep depth dry");
 4927: 
 4928:          if constexpr(ivcor != 1) node->kb = 0;
 4929: 
 4930:       } else {
 4931: 
 4932:          node->updateKb();
 4933:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 4934: for (int k = node->kb; k < nvrt; k++) printf("k = %d, node->kb = %d, node->z[k] = %f\n", k, node->kb, node->z[k]);
 4935: 
 4936:       } // if wet or dry
 4937: 
 4938:       // We use the temp.b field to store the previous state of isDry.
 4939:       node->tmp.b = node->isDry;
 4940: 
 4941:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 4942:       node->isDry = true;
 4943: 
 4944:    }
 4945: 
 4946:    __global__ void ul0ComputeDryElementsAndNodes(void)
 4947:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 4948:    {
 4949:       ELEM(elem);
 4950: 
 4951:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 4952: 
 4953:       // All the nodes of a wet element are wet.
 4954:       if (!elem->isDry) {
 4955:          elem->nodes[0]->isDry = false;
 4956:          elem->nodes[1]->isDry = false;
 4957:          elem->nodes[2]->isDry = false;
 4958:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 4959: 
 4960:       }
 4961: 
 4962: 
 4963:       elem->kb = 0;
 4964: 
 4965:       if (elem->isDry) return;
 4966: 
 4967:       // Wet
 4968:       const Node *n1 = elem->nodes[0];
 4969:       const Node *n2 = elem->nodes[1];
 4970:       const Node *n3 = elem->nodes[2];  
 4971:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 4972: 
 4973:    //    if(elem->isDry2()) {
 4974:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 4975:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 4976:    //        call parallel_abort(errmsg)
 4977:    //    }
 4978: 
 4979: 
 4980:       // Computes element's kb as the minimum of the nodes' kb.
 4981:       const int kb1 = n1->kb;
 4982:       const int kb2 = n2->kb;
 4983:       const int kb3 = n3->kb;
 4984:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 4985: 
 4986: printf("kb1 = %d, kb2 = %d, kb3 = %d, kb4 = %d\n", kb1, kb2, kb3, kb4);
 4987: 
 4988:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 4989: 
 4990: 
 4991:       // Computes the element z as the mean of the nodes z.
 4992:       for (int k = elem->kb; k < nvrt; k++) {
 4993: 
 4994:          // Compute the element z as the mean of the nodes z.
 4995:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 4996:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 4997:          elem->z[k] /= elem->i34;
 4998: 
 4999:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5000:       }
 5001:                   
 5002:    }
 5003: 
 5004:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5005:    {
 5006:       NODE(node);
 5007:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5008: 
 5009:       if (it == iths) return;
 5010: 
 5011: 
 5012:       if(!node->isDry && node->tmp.b) { // rewetted
 5013:          for (int k=0; k < nvrt; k++) {
 5014: 
 5015:             Vector3 utmp={0.0, 0.0, 0.0};
 5016: 
 5017:             double ttmp=0.0;
 5018:             double stmp=0.0;
 5019:             int icount=0;
 5020:             for (int j = 0; j < node->numNodes; j++) {
 5021: 
 5022: 
 5023:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5024:                if (!node->isDry) { // all indices extended
 5025:                   icount++;
 5026: 
 5027:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5028:                   utmp += node->u2[k];
 5029:                   
 5030:                   ttmp += node->tracers[k].tracer[0]; 
 5031:                   stmp += node->tracers[k].tracer[1]; 
 5032:                }
 5033:             }
 5034: 
 5035:             if(icount > 0) {
 5036:                const double inv_icount = 1.0/icount;
 5037:                node->u2[k]     = inv_icount*utmp;
 5038:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5039:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5040:             }
 5041:          }
 5042:       }
 5043:    }
 5044: 
 5045: 
 5046:    __global__ void ul0UpdateSides(int it, int iths) {
 5047: 
 5048:       SIDE(side);
 5049: 
 5050:       // A side is wet if and only if at least one of its elements is wet.
 5051:       const bool isWet = !side->elems[0]->isDry || (!side->isBnd2() && !side->elems[1]->isDry);
 5052: 
 5053:       const Node *n1 = side->n1;
 5054:       const Node *n2 = side->n2;
 5055:       const int kb1 = n1->kb;
 5056:       const int kb2 = n2->kb;
 5057: 
 5058:       side->kb = 0; // dry
 5059: 
 5060:       if (isWet) {
 5061: 
 5062:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5063: 
 5064:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5065: 
 5066:          side->kb = min(kb1, kb2);
 5067: 
 5068:          for (int k = side->kb; k < nvrt; k++) {
 5069:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5070: 
 5071:          
 5072:             assert((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0) && "Weird side (3)");
 5073: 
 5074:             // Compute velocity for re-wetted sides 
 5075:             if ((it != iths) && (side->isDry && isWet)) {
 5076:             
 5077:                Vector2 utmp={0.0, 0.0};
 5078: 
 5079:                int icount=0;
 5080: 
 5081:                // For all the sides on the two elements that share this side
 5082:                for (int j=0; j < 2; j++) {
 5083:                   const Element *elem = side->elems[j];
 5084:                   if (elem == nullptr) continue;
 5085: 
 5086:                   for (int jj=0; jj < elem->i34; jj++) {
 5087:                      const Side *nSide = elem->sides[jj];
 5088:                      if (nSide->isDry) continue;
 5089: 
 5090:                      icount++;
 5091:                      utmp += nSide->u2[k];                     
 5092:                   }
 5093:                }
 5094:                   
 5095:                assert(icount > 0 && "No wet sides around this side");
 5096:                if (icount > 0)  side->u2[k] = utmp/icount;
 5097:                   
 5098:             } // if ((it != iths) && (side->isDry && isWet))
 5099: 
 5100:          } // for k
 5101: 
 5102:       } // if isWet
 5103:    
 5104:       side->isDry = !isWet;
 5105: 
 5106:    }
 5107: 
