 3521: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3522:    if constexpr(ics == 1) {
 3523:       return center;
 3524: 
 3525:    } else {
 3526:       const Point2 p0 = n1->outputCoords();
 3527:       const Point2 p1 = n2->outputCoords();
 3528:       return (1.0/2.0)*(p0 + p1);
 3529: 
 3530:    }
 3531: }
 3532: 
 3533: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3534: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3535: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3536: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3537: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3538: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3539: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3540: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3541: // Computes the gradient of the field at the side center.
 3542:    Vector2 grad = {0.0, 0.0};
 3543:    int count = 0;
 3544: 
 3545:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3546:    // as the average of the gradients at each element.
 3547:    // First element
 3548:    if (elems[0] != nullptr && condition(elems[0])) {
 3549:       Vector2 elemGrad = elems[0]->grad2(field);
 3550: 
 3551:       // For ics=2, projects the element gradient from its frame to the side frame
 3552:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3553: 
 3554:       grad += elemGrad;
 3555: 
 3556:       count++;
 3557:    }
 3558: 
 3559:    // Second element
 3560:    if (elems[1] != nullptr && condition(elems[1])) {
 3561: 
 3562:       Vector2 elemGrad = elems[1]->grad2(field);
 3563: 
 3564:       // For ics=2, projects the element gradient from its frame to the side frame
 3565:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3566: 
 3567:       grad += elemGrad;
 3568: 
 3569:       count++;
 3570:    }
 3571: 
 3572:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3573:    if (count > 0) {
 3574:       grad = grad*(1.0/count);
 3575:    }
 3576:    
 3577:    return grad;
 3578: }
 3579: 
 3580: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 3581: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 3582: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 3583: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 3584: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 3585: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 3586: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 3587: 
 3588: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 3589: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 3590: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 3591: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 3592: 
 3593: 
 3594: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3595: 
 3596: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3597:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3598:    if constexpr(ics == 1) { 
 3599:       return 0.5*(n1->tau + n2->tau);
 3600: 
 3601:    } else {
 3602:       // Project the tau from the node frames to the side frame
 3603:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3604:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3605: 
 3606:       return 0.5*(stau1 + stau2);
 3607:    }
 3608: }
 3609: 
 3610: /**
 3611:  * This method performs backtracking from the side center until a time -dt back in time 
 3612:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3613:  * intermediate point.
 3614:  *
 3615:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3616:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3617:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3618:  * remaining time.
 3619:  * 
 3620:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3621:  * 
 3622:  * @param uuint, vvint, wwint: Velocities at the final point
 3623:  * @param jlev: Level at which the backtracking is performed
 3624:  * @param dt, dtbk: Tracking timesteps
 3625:   */
 3626: __inline__ __device__ void Side::btrack(
 3627:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3628:       double dt,            // Tracking time
 3629:       double dtbk,          // Tracking timestep
 3630:       Vector3 &u_int        // Velocities at the initial point
 3631: ) const {
 3632: 
 3633:    // Start from side center
 3634:    Point3 x0;
 3635: 
 3636:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3637:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3638: 
 3639:  
 3640:    double time_rm = dt; // Remaining time
 3641:    double time_rm_1 = 1e10;
 3642:    double time_rm_2 = 2e10;
 3643:    double time_rm_3 = 3e10;
 3644: 
 3645: 
 3646:    // Initial velocities
 3647:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3648: 
 3649:    // Find a non dry element for starting the backtracking. At this point there should be at least one.
 3650:    Element* curElem = (!elems[0]->isDry) ? elems[0] : elems[1];  // elems[0] is always non-null 
 3651: 
 3652:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3653: 
 3654: // showPoints(x0, x0, jlev, this, 0xFF0000u, 'x', 1, 0, 0);
 3655: 
 3656: 
 3657:    constexpr int MAX_ITERATIONS = 100; 
 3658:    int iter = 0;
 3659:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3660:    while(true) {
 3661: 
 3662:       // Calculate timestep
 3663:       const double dtb = min(dtbk, time_rm);
 3664: 
 3665:       // Next point in the backtracking curve
 3666:       xt = x0 - dtb*u_int;
 3667: 
 3668:       double t, s; // parameters for the line segments p0pt and p1p2
 3669:       Side *lastCrossSide = nullptr;
 3670:       const bool found = celestialWalk(curElem, x0, xt, this, lastCrossSide, jlev);
 3671: 
 3672: 
 3673:       if (time_rm_3 <= time_rm) {
 3674:       // If backtracking gets stuck, we stop the backtracking and use the velocity at the last x0.
 3675:          xt = x0;
 3676:          break;
 3677:       }
 3678: 
 3679: 
 3680:       if (!found) {
 3681:       // This means that the walk reached a boundary or a dry element.
 3682: 
 3683:          assert(lastCrossSide!=nullptr && "lastCrossSide is nullptr");
 3684: 
 3685:          // Finds the point at the boundary where the line segment x0xt intersects.
 3686:          // Here we will assume that it does intersect the boundary segment, even if in some cases,
 3687:          // due to floating point errors, it does not exactly intersect.
 3688:          // We call p1 and p2 the 2D points of the boundary segment. p0, pt are the 2D versions of x0 and xt.
 3689:          // v1 is the vector from p0 to pt, v2 is the vector from p1 to p2.
 3690:          // To compute the intersection point we start with the parametric equations.
 3691:          // p1 + t*v2 = p0 + s*v1,    t, s in [0,1]
 3692:          // We cross-prouct by v1 to cancel the s term:
 3693:          // cross(v2, v1)*t = cross(p0 - p1, v1)
 3694:          // t = cross(p0 - p1, v1) / cross(v2, v1)
 3695: 
 3696:          // Side coordinates in the origSide frame.
 3697:          const Point2 p1 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n1->p, lastCrossSide->n1->gz)));
 3698:          const Point2 p2 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n2->p, lastCrossSide->n2->gz)));
 3699: 
 3700:          Point2  p0 = {x0.x, x0.y};
 3701:          Point2  pt = {xt.x, xt.y};
 3702: 
 3703:          const Vector2 v1 = pt - p0;
 3704:          const Vector2 v2 = p2 - p1;
 3705: 
 3706: 
 3707: 
 3708:          // We are assuming intersection, so we clamp t to the range [0,1].
 3709:          const double denom = cross(v2, v1);
 3710:          
 3711: 
 3712: 
 3713: 
 3714:          if (abs(denom) < small) {
 3715:             // small denominators are fairly common. They occur when the line segment x0xt 
 3716:             // is parallel to the boundary segment. This occurs after a "collision" with the
 3717:             // boundary, where the backtracking curve startt sliding along the boundary.
 3718:             // In this case, we simply assume that the two lines are very close to each other
 3719:             // and simply compute the closest point to xt (s = 1.0) on the boundary segment (clamped to p1p2)
 3720:             t = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3721:             if (t<0.0000000001) t = 0.0;
 3722:             if (t>0.9999999999) t = 1.0;
 3723: 
 3724:             // s = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3725:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3726: 
 3727:          }
 3728:          else {
 3729:             
 3730:             t = clamp(cross(p0 - p1, v1) / denom, 0.0, 1.0);
 3731:             if (t<0.0000000001) t = 0.0; // XXXXX use constants
 3732:             if (t>0.9999999999) t = 1.0;
 3733:             // From the originaL equation we can solve for s:
 3734:             // p1 + t*v2 = p0 + s*v1    =>   s*v1 = p1 + t*v2 - p0 
 3735:             // Computing the dot product by v1, we get:
 3736:             // s = dot((p1 + t*v2 - p0), v1) / dot(v1, v1)
 3737:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3738:             if (s<0.0000000001) s = 0.0; // XXXXX use constants
 3739: 
 3740:          }
 3741: 
 3742:          assert(curElem!=nullptr && !curElem->isDry && "curElem is nullptr or dry");
 3743: 
 3744: 
 3745:          // We update the new target point to be right at the intersection point,
 3746:          // and the remaining time must include the time we haven't "used".
 3747:          time_rm -= s*dtb;
 3748:          xt = toPoint3(p1 + t*v2, x0.z + s*(xt.z - x0.z)); // I use p1,p2 to compute the intersection point to ensure that it is on the boundary, but the z-coordinate is the same as x0.z
 3749: 
 3750: 
 3751:          // If it is an open boundary, just exits the loop. No sliding along the boundary is performed.
 3752:          if (lastCrossSide->sideBnd!=nullptr && !lastCrossSide->sideBnd->segment->isLand) break;
 3753: 
 3754:          // If it is not an open boundary, the velocity for the next step is computed by interpolating the velocities at the intersection point.
 3755:          // but extracting only the component along the tangent vector v2.
 3756:          Vector2 tangent = normalize(v2);
 3757:          const Vector3 u = curElem->interpolateVelocities(xt, this);
 3758: 
 3759:          const Vector2 u2D = make_double2(u.x, u.y);
 3760:          u_int = toVector3(dot(u2D, tangent)*tangent, u.z);
 3761: 
 3762: 
 3763:       } else {
 3764: 
 3765:          assert(curElem!=nullptr && !curElem->isDry && "Final element is dry or boundary side");
 3766: 
 3767:          time_rm -= dtb; 
 3768: 
 3769:          u_int = curElem->interpolateVelocities(xt, this);
 3770: 
 3771:       }
 3772: 
 3773:       if (time_rm <= 0.0) break; 
 3774: 
 3775:       // If the velocity is too small, we stop the backtracking
 3776:       const double vmag2 = norm2(toVector2(u_int));
 3777:       if (vmag2 <= velmin_btrack_sq)  {
 3778:          time_rm = 0.0; 
 3779:          return; 
 3780:       }
 3781: 
 3782:       // The current point becomes the next segment's starting point.
 3783:       x0 = xt;
 3784:  
 3785:       iter++;
 3786: 
 3787: // XXXXXXXXXXXXXXXXX
 3788: if (iter == 38) {printf("*****iter = %d, time_rm = %.17f\n", iter, time_rm); return;}
 3789:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3790: 
 3791:       assert(time_rm_3 > time_rm && "time_rm is not decreasing");
 3792:       time_rm_3 = time_rm_2;
 3793:       time_rm_2 = time_rm_1;
 3794:       time_rm_1 = time_rm;
 3795:    }
 3796: 
 3797:    assert(curElem != nullptr && "Final element is nullptr");
 3798:    assert(!curElem->isDry && "Final element is dry");
 3799:    
 3800: 
 3801: 
 3802:    // Interpolate the velocities at the final point with respect to the current side frame
 3803:    u_int = curElem->interpolateVelocities(xt, this);
 3804: 
 3805: 
 3806: }
 3807: 
 3808: 
 3809: 
 3810: __device__ __forceinline__ int Node::localIndex() const {
 3811:    // Returns the local index of the node in the partition
 3812:    // Local index is just the offset from the start of the partition's node memory
 3813:    return int(this - mesh->nodes[part]);
 3814: }
