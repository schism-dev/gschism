 1034: 
 1035:    template<typename T>
 1036:    __device__ __forceinline__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const;
 1037: 
 1038:    
 1039:    __forceinline__ __device__ void projectNodeVectorsToElementFrame(Vector2 *v) const;
 1040:    __forceinline__ __device__ void projectSideVectorsToElementFrame(Vector2 *v) const;
 1041: 
 1042: 
 1043:    template<typename T>
 1044:    __device__ __forceinline__ T interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const;
 1045: 
 1046:    template<typename T>
 1047:    __device__ __forceinline__ T interpolate(const double shapeCoords[4], T Node::* field) const;
 1048: 
 1049:    template<typename T>
 1050:    __device__ __forceinline__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const;
 1051: 
