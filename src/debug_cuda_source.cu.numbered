 3984: 
 3985: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3986:    // Computes the z coordinate at level k.
 3987:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3988:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3989:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3990:    // used 
 3991: 
 3992:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3993:    
 3994:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3995: 
 3996:    if (isDry2()) return 0.0;  
 3997: 
 3998:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3999: 
 4000:    if constexpr(ivcor == 2) {
 4001: 
 4002:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 4003:       const double h_c = mesh->h_c;
 4004:       const double theta_f = mesh->theta_f;
 4005:       const double sinh_theta_f = mesh->sinh_theta_f;
 4006: 
 4007: 
 4008:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 4009:       // The FORTAN code computes it every time this function is called, but it should be done only 
 4010:       // once per time step/node. XXXX
 4011:       // CHECK: updateZCoordData
 4012: 
 4013:       //  To simplify comparisons, I define index versions of count variables.
 4014:       if      (k == ivrt)     return eta2; 
 4015:       else if (k == izlev)    return -hmod2;
 4016:       else if (k == kb)       return -depth;
 4017:       else if (k < izlev)     return mesh->ztot[k];
 4018:       else if (k > izlev) {
 4019:          const int ksig = k - izlev;
 4020: 
 4021:          if (hmod2 <= h_c) {
 4022:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 4023: 
 4024:          } 
 4025:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 4026:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 4027:             assert(false && "compZCoord: invalid h_c\n");
 4028:          } 
 4029:          else {
 4030:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 4031:                    h_c * mesh->sigma[ksig] + 
 4032:                    (hmod2 - h_c) * mesh->cs[ksig];
 4033:          }
 4034:       } else { 
 4035:          assert(false && "compZCoord: invalid level or coordinate system\n");
 4036:       }
 4037: 
 4038:    }
 4039:    else {  // if constexpr(ivcor == 1)
 4040:       if (k <= kb)        return -depth; 
 4041:       else if (k == ivrt) return eta2;
 4042:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 4043: 
 4044:    }
 4045:    
 4046:    assert(false && "compZCoord: invalid level or coordinate system\n");
 4047:    return 0.0;
 4048: }
 4049: 
 4050: 
 4051: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 4052:    // Computes the bottom drag Cd based on the selected nchi
 4053: 
 4054:    if constexpr(nchi == 0) {
 4055:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 4056:       Cd = drag;  // Read from drag file
 4057: 
 4058:    } else if constexpr(nchi == 1) {
 4059:       // 
 4060: 
 4061:       bool ltmp = false; // for WBL iteration
 4062: 
 4063:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4064:       if (isDry || (rough == 0.0)) {
 4065:          Cd = 0.0;
 4066: 
 4067:       } else { //roughness >0 
 4068:          
 4069:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 4070: 
 4071:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 4072: 
 4073:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 4074: 
 4075:       } // if rough
 4076: 
 4077:    } else if constexpr(nchi == -1) {
 4078:    // Manning 
 4079:  
 4080:       const double htot = max(hmin_man, htot2()); 
 4081:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 4082: 
 4083:    } else {
 4084:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 4085:       
 4086:    } // if nchi
 4087: 
 4088: }
 4089: 
 4090: 
 4091: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 4092:    // Checks if a side in on the boundary
 4093:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 4094: 
 4095:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 4096:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 4097: 
 4098:    // Indices of the nodes that form the side
 4099:    //
 4100:    // NOTE: This function is slow. It's to be called from "populate" functions, not from the main loop.
 4101:    const int n1 = side.n1->idx;
 4102:    const int n2 = side.n2->idx;
 4103:    isLand = false;
 4104:    
 4105: 
 4106:    // Check if the side is on a land boundary
 4107:    for (int i = 0; i < nland; i++) {
 4108:       for (int j = 0; j < nlnd[i] - 1; j++) {
 4109:          // Consecutive nodes in the land boundary segment
 4110:          const int b1 = ilnd[i + j*nland];
 4111:          const int b2 = ilnd[i + (j + 1)*nland];
 4112: 
 4113:          assert(b1 != -1 && b2 != -1);
 4114: 
 4115:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 4116:             
 4117:             isLand = true;
 4118:             return i;
 4119:          }
 4120:       }
 4121:    }
 4122: 
 4123:    // Check if the side is on an open boundary
 4124:    for (int i = 0; i < nope; i++) {
 4125:       for (int j = 0; j < nond[i] - 1; j++) {
 4126:          // Consecutive nodes in the open boundary segment
 4127:          const int b1 = iond[i + j*nope];
 4128:          const int b2 = iond[i + (j + 1)*nope];
 4129: 
 4130:          assert(b1 != -1 && b2 != -1);
 4131: 
 4132:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 4133:             isLand = false;
 4134:             return i;
 4135:          }
 4136:       }
 4137:    }
 4138: 
 4139: 
 4140:    return -1;
 4141: }
 4142: 
 4143: 
 4144: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 4145:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4146:                                     double *wind_rotate_angle, 
 4147:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4148:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4149:                                     int16_t *nodePermutationSort, double *crs_data,
 4150:                                     int *localNodeNeighNodesStart, int *localNodeNeighElemsStart, 
 4151:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4152:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4153:                                     int *localNodePart,     int *localElemPart,     int *localSidePart, 
 4154:                                     double *drag, double *roughness, double *rmanning, 
 4155:                                     double *diffmin, double *diffmax,
 4156:                                     double *temp, double *salt,
 4157:                                     int *kb, double *localSigma) {
 4158: 
 4159:    NODE(pnode);  
 4160:    const int i = idx_node;
 4161:    const int iglobal = globalNodeIndices[i];
 4162:    Node &node(*pnode);
 4163: 
 4164:    node.idx = iglobal;
 4165:    node.part = localNodePart[iglobal];
 4166: 
 4167:    // It is important to differentiate between the global and local "start" indices because they
 4168:    // play different, but related, roles in this code. The global "start" indices are used
 4169:    // for the CSR-like indexing of the node and element neighbor arrays in the "global"
 4170:    // (unpartitioned) mesh. The local "start" indices are used for the CSR-like indexing of the 
 4171:    // node and element neighbor arrays in the "local" (partitioned) mesh.
 4172:    const int idxNodeStart = nodeNeighNodesStart[iglobal];
 4173:    const int idxNodeEnd   = nodeNeighNodesStart[iglobal + 1];
 4174:    const int idxNodeLocalStart = localNodeNeighNodesStart[i];
 4175:    node.numNodes = idxNodeEnd - idxNodeStart;
 4176:    node.nodes = nodeNeighNodes + idxNodeLocalStart;
 4177: 
 4178:    const int rowStart = idxNodeLocalStart + i; // +i is to account for the diagonal element.
 4179:    node.coeffRow = crs_data + rowStart; 
 4180: 
 4181:    node.csrSlot = nodePermutationSort + idxNodeLocalStart;
 4182: 
 4183: 
 4184: 
 4185:    const int idxElemStart = nodeNeighElemsStart[iglobal];
 4186:    const int idxElemEnd   = nodeNeighElemsStart[iglobal + 1]; 
 4187:    const int idxElemLocalStart = localNodeNeighElemsStart[i];
 4188:    node.numElements = idxElemEnd - idxElemStart;
 4189:    node.elements = nodeNeighElems + idxElemLocalStart;
 4190: 
 4191: 
 4192:    for (int idx = idxNodeStart, idxLocal = idxNodeLocalStart; idx < idxNodeEnd; idx++, idxLocal++) {
 4193:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 4194:       const int partNode = localNodePart[idxNodeGlobal]; 
 4195:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 4196: 
 4197:       Node *node_ptr = nodes[partNode] + idxNode;
 4198:       
 4199:       nodeNeighNodes[idxLocal] = node_ptr;
 4200:    }
 4201: 
 4202: 
 4203:    for (int idx = idxElemStart, idxLocal = idxElemLocalStart; idx < idxElemEnd; idx++, idxLocal++) {
 4204:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 4205:       const int partElem = localElemPart[idxElemGlobal];
 4206:       const int idxElem  = localElemIndices[idxElemGlobal];
 4207: 
 4208:       Element *elem_ptr = elems[partElem] + idxElem;
 4209: 
 4210:       nodeNeighElems[idxLocal] = elem_ptr;
 4211:    }      
 4212: 
 4213:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 4214:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 4215: 
 4216:    sincosf(-(float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 4217: 
 4218:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 4219:    if constexpr(ics == 1) {
 4220:       node.p.x   = node_coords[i * 3];
 4221:       node.p.y   = node_coords[i * 3 + 1];
 4222:       node.gz = 0.0;
 4223: 
 4224:       if (use_ll) {                                    // <-- add
 4225:          node.lon = node_coords_ll[i * 2    ]*deg2rad; // <-- add
 4226:          node.lat = node_coords_ll[i * 2 + 1]*deg2rad; // <-- add
 4227:       }  
 4228: 
 4229:    } else {
 4230:       const double lon = deg2rad*node_coords[i * 3];
 4231:       const double lat = deg2rad*node_coords[i * 3 + 1];
 4232: 
 4233:       Point3 p = computeXYZfromLatLon(lat, lon);
 4234:       node.p = toVector2(p);
 4235:       node.gz = p.z;
 4236:       node.lon = lon;
 4237:       node.lat = lat;
 4238: 
 4239:       #ifdef USE_FRAMES
 4240:       node.setFrame(lat, lon);
 4241:       #endif
 4242: 
 4243: 
 4244:    }
 4245: 
 4246:    node.depth = node_coords[i * 3 + 2];
 4247: 
 4248:    node.numSides = 0;
 4249: 
 4250:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 4251:    if      constexpr(nchi ==  0) node.drag     = drag[iglobal];
 4252:    else if constexpr(nchi ==  1) node.rough    = roughness[iglobal];
 4253:    else if constexpr(nchi == -1) node.rmanning = rmanning[iglobal];
 4254:    else assert(false && "populateNodes: selected nchi not implemented.");
 4255: 
 4256:    // Populate the diffmin and diffmax values read from the files.
 4257:    // (Only used for GLS, GOTM, and SedimentMix.)
 4258:    node.turb.setDiffLimits(diffmin[iglobal], diffmax[iglobal]);
 4259: 
 4260:    // Cold-start T,S: vertically homogeneous nodal I.C. (temp.ic/salt.ic or barotropic constants).
 4261:    // tr0 keeps the initial field (e.g. type-3 open BC); tracers is the working nodal state.
 4262:    {
 4263:       const double t0 = temp[iglobal];
 4264:       const double s0 = salt[iglobal];
 4265:       for (int k = 0; k < nvrt; k++) {
 4266:          node.tr0[k].tracer[0]     = t0;
 4267:          node.tr0[k].tracer[1]     = s0;
 4268:          node.tracers[k].tracer[0] = t0;
 4269:          node.tracers[k].tracer[1] = s0;
 4270:       }
 4271:    }
 4272: 
 4273:    if constexpr(ivcor == 1) 
 4274:    {  
 4275:       node.kb = kb[iglobal];
 4276: 
 4277:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + iglobal*nvrt];
 4278:    }
 4279: 
 4280:    for (int k = 0; k < nvrt; k++) {
 4281:       node.rho[k] = rho0;
 4282:       node.z[k] = -1e20;
 4283:    }
 4284: 
 4285:    // Initialize the turbulence model including the vertical viscosity/diffusivity
 4286:    node.turb.init(&node);
 4287: 
 4288:    
 4289:    // Links the node to the boundary information
 4290:    if (isbnd[iglobal] >= 0) {
 4291:      
 4292:       // Get the index of the node boundary
 4293:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 4294: 
 4295:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 4296:       node.nodeBnd->node = &node;
 4297: 
 4298:       node.nodeBnd->sideBnd1 = nullptr;
 4299:       node.nodeBnd->sideBnd2 = nullptr;
 4300: 
 4301:       if (isbnd[iglobal]>=0) {
 4302: 
 4303:          node.nodeBnd->segment = &(localSegmentMem[isbnd[iglobal]]);
 4304:          
 4305:          node.nodeBnd->segment->ifltype = 0; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 4306:          node.nodeBnd->segment->iettype = 0; // XXXXXXXXX
 4307: 
 4308:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 4309:          node.nodeBnd->segment->clen  = nan("1");
 4310:          node.nodeBnd->segment->carea = nan("1");
 4311: 
 4312:       }
 4313:    } else {
 4314: 
 4315:       node.nodeBnd = nullptr; // For internal nodes
 4316: 
 4317:       if (isbnd[iglobal] == landSegment) {
 4318:          node.nodeBnd = landBoundaryNode;
 4319:          node.nodeBnd->segment = landBoundarySegment;
 4320:       }
 4321:       
 4322:    }
 4323:    
 4324:    // XXXX GAUSSIAN HILL VELOCITIES
 4325:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4326:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4327:          constexpr double rot_per = 3000.0;
 4328:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 4329:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 4330:       // XXXXX
 4331:    #endif
 4332: 
 4333: }
 4334: 
 4335: __device__ void Mesh::populateNodes2(int *localNodeNeighNodesStart, int *crs_indices, int *crs_indptr) {
 4336:    
 4337:    NODE(node);
 4338:    const int localIdx = idx_node;
 4339: 
 4340: 
 4341:    // Computes csrSlot, the array of indices/slots of the neighbor nodes in the CRS matrix.
 4342:    int16_t *csrSlot = node->csrSlot;  
 4343: 
 4344:    // Simply count the number of nodes with a smaller global index than the current node.
 4345:    // It accounts for the diagonal element.
 4346:    // packedIndex is a special type of global index in which nodes are counted in the order as the
 4347:    // local index, but taking into account all the partitions (in order).
 4348:    for (int i = 0; i < node->numNodes; ++i) {
 4349:       const int col = node->nodes[i]->packedIndex();
 4350:       int16_t idx = 0;
 4351: 
 4352:       //Takes care of the diagonal element.
 4353:       if (node->packedIndex() < col) ++idx;          
 4354: 
 4355:       for (int j = 0; j < node->numNodes; ++j) if (node->nodes[j]->packedIndex() < col) ++idx;
 4356:       csrSlot[i] = idx;
 4357:    }
 4358: 
 4359:    // Find the diagonal element in the CRS matrix.
 4360:    int16_t idxDiag = 0;
 4361:    for (int j = 0; j < node->numNodes; ++j)
 4362:       if (node->nodes[j]->packedIndex() < node->packedIndex()) ++idxDiag;
 4363: 
 4364:    node->coeffDiag = &(node->coeffRow[idxDiag]);
 4365: 
 4366:    // Fills the CRS indices and indptr arrays for the cupyz's crs matrix in the solver.
 4367:    const int idxNodeLocalStart = localNodeNeighNodesStart[localIdx];
 4368: 
 4369:    const int rowStart = idxNodeLocalStart + localIdx;  // +i is to account for the diagonal element.
 4370:    const int rowNNZ = node->numNodes + 1;        // +1 is to account for the diagonal element.
 4371:    crs_indptr[localIdx] = rowStart;
 4372: 
 4373:    // Fills crs_indices array using the per-partition indexing.
 4374:    const int d = (int)(node->coeffDiag - node->coeffRow);
 4375:    crs_indices[rowStart + d] = node->packedIndex();  
 4376:    for (int j = 0; j < node->numNodes; ++j) {
 4377:       Node *nb = node->nodes[j];
 4378:       crs_indices[rowStart + node->csrSlot[j]] = nb->packedIndex();
 4379:    }
 4380: 
 4381: 
 4382: }
 4383: 
 4384: 
 4385: 
 4386: 
 4387: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 4388:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4389:                                     double *wind_rotate_angle,   
 4390:                                     int *isdel, int *isidenode, int *isbnd,
 4391:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4392:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4393:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4394:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4395:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4396:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 4397:                                     double *drag, double *roughness) {
 4398: 
 4399: 
 4400:    SIDE(pside);
 4401:    Side &side(*pside);
 4402:    const int i = idx_side;
 4403:    const int iglobal = globalSideIndices[i];
 4404:    side.idx = iglobal;  
 4405:    
 4406:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 4407:    const double fc   = 2.0*omega_e*sin(sfea0);
 4408:    const double beta = 2.0*omega_e*cos(sfea0);
 4409: 
 4410:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 4411: 
 4412:    // finding the pointer to the nodes that form the side
 4413:    const int idx_n1 = isidenode[iglobal*2];
 4414:    const int idx_n2 = isidenode[iglobal*2 + 1];
 4415: 
 4416: // if (i % 100 == 0) printf("populateSides: iglobal = %d, idx_n1 = %d, idx_n2 = %d\n", iglobal, idx_n1, idx_n2);
 4417: 
 4418:    const int locidx_n1 = localNodeIndices[idx_n1];
 4419:    const int locidx_n2 = localNodeIndices[idx_n2];
 4420:    const int part_n1 =   localNodePart[idx_n1];
 4421:    const int part_n2 =   localNodePart[idx_n2];
 4422: 
 4423: // if (i % 100 == 0) printf("populateSides: i = %d, part_n1 = %d, part_n2 = %d, locidx_n1 = %d, locidx_n2 = %d\n", i, part_n1, part_n2, locidx_n1, locidx_n2);
 4424: // if (i % 100 == 0) printf("populateSides: i = %d, nodes[part_n1] = %p, nodes[part_n2] = %p\n", i, mesh->nodes[part_n1], mesh->nodes[part_n2]);
 4425: 
 4426:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 4427:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 4428: 
 4429: // if (i % 100 == 0) printf("populateSides: 1, i = %d, side.n1 = %p, side.n2 = %p\n", i, side.n1, side.n2);
 4430: 
 4431:    // Counts the number of sides connected to each node
 4432:    atomicAddInt16Unsafe(&side.n1->numSides, 1);  // Unsafe here means that it doesn't check for overflow. This function is defined in this file.
 4433:    atomicAddInt16Unsafe(&side.n2->numSides, 1);
 4434: 
 4435:    // Side boundary type
 4436:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 4437:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 4438: // if (i == 0) printf("populateSides: 2\n");
 4439: 
 4440:    if (n1bnd != nullptr && n2bnd != nullptr) 
 4441:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 4442:    {
 4443:       bool isLand = false;
 4444:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 4445:       
 4446:       if (isbs > -1) {
 4447:          // assert(isLand || isbs>=0);
 4448:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 4449: 
 4450:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 4451: 
 4452:          if   (isLand) side.sideBnd->segment = landBoundarySegment;
 4453:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 4454: 
 4455:          assert (isLand == side.sideBnd->segment->isLand);
 4456:          
 4457:          side.sideBnd->side = &side;
 4458: 
 4459:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4460:          n1bnd->linkSideBoundary(side.sideBnd);
 4461:          n2bnd->linkSideBoundary(side.sideBnd);
 4462: 
 4463:       }
 4464:       else {
 4465:          side.sideBnd = nullptr;
 4466:       }
 4467:    }
 4468:    else 
 4469:    {
 4470:       side.sideBnd = nullptr;
 4471:    }
 4472: 
 4473: // if (i % 100 == 0) printf("populateSides: 3, i = %d\n", i);
 4474: 
 4475:    // finding the pointer to the elements that share the side
 4476:    const int idx_e1 = isdel[iglobal*2];
 4477:    const int idx_e2 = isdel[iglobal*2 + 1];
 4478: 
 4479:    if (idx_e1 > -1) {
 4480:       const int locidx_e1 = localElemIndices[idx_e1];
 4481:       const int part_e1 =  localElemPart[idx_e1];
 4482:       side.elems[0] = elems[part_e1] + locidx_e1;
 4483: 
 4484:    }
 4485:    else {
 4486:       side.elems[0] = nullptr;
 4487:    }
 4488: 
 4489: // if (i % 100 == 0) printf("populateSides: 4, i = %d\n", i);
 4490: 
 4491:    if (idx_e2 > -1) {
 4492:       const int locidx_e2 = localElemIndices[idx_e2];
 4493:       const int part_e2 =  localElemPart[idx_e2];
 4494:       side.elems[1] = elems[part_e2] + locidx_e2;
 4495:    }
 4496:    else {
 4497:       side.elems[1] = nullptr;
 4498:    }
 4499: 
 4500: // if (i % 100 == 0) printf("populateSides: 5, i = %d\n", i);
 4501: 
 4502:    if (side.elems[1] == nullptr && side.sideBnd == nullptr) {
 4503:       
 4504:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 4505:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 4506:       printf("Side %d has no elements and no boundary. Types = %p, %p\n", i, n1bnd, n2bnd);
 4507:          
 4508:       // printf("idx_e1: %d, idx_e2: %d\n", idx_e1, idx_e2);
 4509:       // printf("elems[0]: %p, elems[1]: %p\n", side.elems[0], side.elems[1]);
 4510:       // printf("sideBnd: %p\n", side.sideBnd);
 4511:       // assert(false && "Side has no elements and no boundary");
 4512:    }
 4513:    // assert(side.elems[1] != nullptr || side.sideBnd != nullptr);
 4514: 
 4515:    // Compute the center of the side
 4516:    side.center = 0.5*(side.n1->p + side.n2->p);
 4517: 
 4518:    #ifdef USE_FRAMES
 4519:    side.setFrame();
 4520:    #endif
 4521: 
 4522: // if (i % 100 == 0) printf("populateSides: 6, i = %d\n", i);
 4523: 
 4524:    // Normal, unitary vector to the side
 4525:    if constexpr(ics == 1) {
 4526:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4527:       side.n = normalize(side.n);
 4528:    }
 4529:    else {
 4530:       // Unit side vector in 3D cartesian coordinates
 4531:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4532: 
 4533:       nSide = normalize(nSide);
 4534: 
 4535:       // Its cross product with the unit local z-axis vector (nUp) is the
 4536:       // normal vector we are looking for.
 4537:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4538: 
 4539:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4540:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4541:       side.n = -normalize(n2D); 
 4542: 
 4543:    }
 4544: 
 4545: // if (i % 100 == 0) printf("populateSides: 7, i = %d\n", i);
 4546: 
 4547:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4548:    side.shapiro = shapiro0;
 4549: 
 4550:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4551:    // XXXX
 4552:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4553:    constexpr double rot_per=3000.0;
 4554:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4555:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4556:    // XXXXX      
 4557:    #endif
 4558:    // Compute the z level at the center of the side
 4559:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4560:    
 4561:    // Compute the length of the side
 4562:    side.len = length(toPoint3(side.n2->p, side.n2->gz) - toPoint3(side.n1->p, side.n1->gz));
 4563: 
 4564: // if (i % 100 == 0) printf("populateSides: 8, i = %d\n", i);
 4565: 
 4566:    // Compute the Coriolis coefficient
 4567: 
 4568:    if constexpr(ncor == -1 || ncor == 0) {
 4569:       side.coriolis = coricoef;
 4570:    }
 4571:    else {
 4572:       const double sphi = side.lat();  // Latitude at the center of the side
 4573: 
 4574:       assert(use_ll && "use_ll must be true when ncor > 0");
 4575: 
 4576:       if constexpr(ics == 1) {
 4577:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4578:       }
 4579:       else { // ics == 2
 4580:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4581:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4582:       }
 4583: 
 4584:    }
 4585: 
 4586: // if (i % 100 == 0) printf("populateSides: 9, i = %d\n", i);
 4587: 
 4588: }
 4589: 
 4590: 
 4591: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4592:    double *node_coords, double *node_coords_ll, bool use_ll,
 4593:    double *wind_rotate_angle,   
 4594:    int *isdel, int *isidenode, int *isbnd,
 4595:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4596:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4597:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4598:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4599:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4600:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4601:    double *drag, double *roughness) {
 4602: 
 4603:    ELEM(pelem);
 4604:    Element &elem(*pelem);
 4605:    const int i = idx_elem;
 4606: 
 4607:    elem.idx = i;
 4608: 
 4609:    for (int j = 0; j < i34[i]; j++) {
 4610:       const int idxNode = elnode[i*4 + j];  
 4611:       const int idxSide = elside[i*4 + j];
 4612:       
 4613:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4614:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4615: 
 4616:       // Find the neighboring element  
 4617:       if (elem.sides[j]->elems[0] == &elem) {
 4618:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4619:       }
 4620:       else {
 4621:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4622:       }
 4623:       
 4624:    }
 4625: 
 4626:    elem.i34 = i34[i];
 4627: 
 4628:    // Compute the barycenter of the element and its depth
 4629:    elem.center = {0.0, 0.0};
 4630:    elem.depth = 1e10;
 4631:    for (int j = 0; j < i34[i]; j++) {
 4632: 
 4633:       elem.center += elem.nodes[j]->p/i34[i];
 4634:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4635:    }
 4636: 
 4637:    #ifdef USE_FRAMES
 4638:    elem.setFrame();
 4639:    #endif
 4640: 
 4641:    elem.area = elem.computeSignedArea(); 
 4642:    elem.radius = sqrt(elem.area)/pi; 
 4643:    
 4644:    // Determines which way the normal vector to each side is oriented.
 4645:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4646:    for (int j = 0; j < i34[i]; j++)  
 4647:    {
 4648:       if (elem.sides[j]->elems[0] == &elem) {
 4649:          elem.ssign[j] =  1.0;
 4650:       }
 4651:       else {
 4652:          elem.ssign[j] = -1.0;
 4653:       }
 4654: 
 4655:    }
 4656: 
 4657:   
 4658: 
 4659:    // Derivatives of shape functions
 4660:    //  For ics=2, this is done in the element frame
 4661:    //  For quads, the derivative is evaluated at centroid
 4662:    for (int j = 0; j < elem.i34; j++) {
 4663:       const double area = elem.area;
 4664:       const int id2 = elem.nxq(1 + j);
 4665:       const int id3 = elem.nxq(2 + j);
 4666:       const int id4 = elem.nxq(3 + j);
 4667:       if (elem.isTri()) {
 4668:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4669:          // phi_0 = (x2 - x0)^(x - x0)/((x2 - x0)^(x1 - x0)), where ^ is the cross product
 4670:          // phi_0 = (x2 - x0)^(x - x0)/(2*area)
 4671:          // dphi_0/dx = (x2.y - x0.y)/(2*area)
 4672:          // dphi_0/dy = (x0.x - x2.x)/(2*area)
 4673:          // And so on for the other shape functions.
 4674: 
 4675:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4676:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4677:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4678: 
 4679:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4680:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4681: 
 4682:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4683: 
 4684:       }
 4685:       else  { // Quad, the derivatives are evaluated at the centroid
 4686: 
 4687:          // The derivation is complicated, but it starts by defining the shape functions in terms of the local coordinates (eta, xi).
 4688:          // phi_0 = (1 + eta*eta_n(0))*(1 + xi*xi_n(0))/4
 4689:          // ...
 4690:          // and then the derivatives are computed at the centroid (eta = 0, xi = 0)
 4691: 
 4692:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4693:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4694:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4695: 
 4696:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4697:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4698: 
 4699:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4700: 
 4701:       } // if Tri/Quad
 4702: 
 4703:    } // for j   
 4704: 
 4705:    // Initial element tracers: average surrounding nodal I.C. (levels k and k-1)
 4706:    // For level k: average of node values at k and k-1 over the element nodes.
 4707:    // Level 0 copies level 1 (Fortran tr_el(:,1)=tr_el(:,2)).
 4708:    const double inv = 1.0 / (2.0 * elem.i34);
 4709:    for (int k = 1; k < nvrt; k++) {
 4710:       Tracers sum = {};
 4711:       for (int j = 0; j < elem.i34; j++) {
 4712:          const Node *nd = elem.nodes[j];
 4713:          for (int itr = 0; itr < ntracers; itr++)
 4714:             sum.tracer[itr] += nd->tr0[k].tracer[itr] + nd->tr0[k - 1].tracer[itr];
 4715:       }
 4716:       for (int itr = 0; itr < ntracers; itr++)
 4717:          elem.tracers[k].tracer[itr] = inv * sum.tracer[itr];
 4718:    }
 4719:    elem.tracers[0] = elem.tracers[1];
 4720: 
 4721: }
 4722: 
 4723: 
 4724: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4725:                                             double *emo, double *efa, 
 4726:                                             double *umo, double *ufa, 
 4727:                                             double *vmo, double *vfa,
 4728:                                             int *ifltype, int *iettype, 
 4729:                                             double *qthcon, double *eth) {
 4730: 
 4731:    NODE_BND(nodeBnd);
 4732:    const int idx = idx_node_bnd;    
 4733: 
 4734:    nodeBnd->idx = idx;
 4735: 
 4736:    // Need to find the segment index and the index of the node on the segment
 4737:    int idxNode = -1;
 4738:    int iseg, i;
 4739:    for (iseg = 0; iseg < nope; iseg++) {
 4740:       // for each segment...
 4741:       for (i = 0; i < nond[iseg]; i++) {
 4742:          idxNode = iond[iseg + i*nope];
 4743:          if (idxNode == nodeBnd->node->idx) 
 4744:          {
 4745:             // This is done for every segment that the node is part of, overwriting the previous values.
 4746:             // The result is that the segment with the highest index is the one that is used.
 4747:             nodeBnd->isEssentialBC = (iettype[iseg] != 0);
 4748:             nodeBnd->elbc = 0.0;
 4749: 
 4750:             // XXXXXX This may make more sense in populateBoundarySides.
 4751:             nodeBnd->segment->ifltype = ifltype[iseg];
 4752:             nodeBnd->segment->iettype = iettype[iseg];
 4753:             nodeBnd->segment->qthcon  = qthcon[iseg];
 4754:             nodeBnd->segment->eth     = eth[iseg];
 4755:             nodeBnd->eth     = eth[iseg]; // XXXXXXX Is this always needed? ot only for certain ietype?
 4756:             nodeBnd->segment->idx = iseg;
 4757: 
 4758:             for (int jfr = 0; jfr < nbfr; jfr++) {
 4759: 
 4760:                const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4761: 
 4762:                nodeBnd->efa[jfr] = efa[idx2];
 4763:                nodeBnd->emo[jfr] = emo[idx2];
 4764: 
 4765:             }
 4766:          }         
 4767:       }
 4768:    }
 4769: 
 4770: 
 4771:    assert(iseg <= nope && "iseg is out of bounds");
 4772: 
 4773: 
 4774: 
 4775: 
 4776:         
 4777: 
 4778: }
 4779: 
 4780: __device__ void Mesh::populateBoundarySides(int *nond, int *iond,
 4781:                                             double *emo, double *efa, 
 4782:                                             double *umo, double *ufa, 
 4783:                                             double *vmo, double *vfa,
 4784:                                             int *ifltype, int *iettype, double *qthcon) {
 4785: 
 4786:    SIDE_BND(sideBnd);
 4787: 
 4788:    const Side *side = sideBnd->side;
 4789: 
 4790: 
 4791:    // Indices of the nodes on the side 
 4792:    const int n1 = side->n1->idx;
 4793:    const int n2 = side->n2->idx;
 4794: 
 4795:    const int iseg = sideBnd->segment->idx;
 4796: 
 4797:    // Find the index of the side in the segment data array.
 4798:    for (int i = 0; i < nond[iseg] - 1; i++) {
 4799: 
 4800:       // Indices of the nodes at both ends of the side (obtained from the boundary node list)
 4801:       const int b1 = iond[iseg + i*nope];
 4802:       const int b2 = iond[iseg + (i + 1)*nope];
 4803: 
 4804:       // Find the side that connects the two nodes by comparing the indices of the nodes at both ends of the side (computed from 
 4805:       // the boundary node list) with the indices of the nodes at the ends of the side (obtained from the side structure).
 4806:       if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 4807: 
 4808:          for (int jfr = 0; jfr < nbfr; jfr++) {
 4809:          // For each tidal component...
 4810: 
 4811:             const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4812: 
 4813:             // velocity magnitude at both ends of the side (1,2)            
 4814:             const double umo1 = umo[idx2];
 4815:             const double vmo1 = vmo[idx2];
 4816:             const double umo2 = umo[idx2 + nope];
 4817:             const double vmo2 = vmo[idx2 + nope];
 4818: 
 4819:             // velocity phases at both ends of the side (1,2)
 4820:             const double ufa1 = ufa[idx2];
 4821:             const double vfa1 = vfa[idx2];
 4822:             const double ufa2 = ufa[idx2 + nope];
 4823:             const double vfa2 = vfa[idx2 + nope];
 4824: 
 4825:             // These expressions compute the amplitude and phase of the velocity components at the center of the side.
 4826:             // The expressions replicate SCHISM by computing equivalent amplitude and phase for the velocity components at the center of the side.
 4827:             // Equivalent to SCHISM: average of the two reconstructed node tides
 4828:             //   0.5 * (a1*cos(theta - phi1) + a2*cos(theta - phi2))
 4829:             // with theta = amig*t + face. Folded here into one (umo, ufa) per
 4830:             // frequency so the step only does ramp*ff*umo*cos(theta - ufa).
 4831:             // Fortran keeps both (a, phi) on the nodes and averages after the
 4832:             // cosines; the result is the same.
 4833:             sideBnd->umo[jfr] = {0.5*sqrt(pow<2>(umo1) + pow<2>(umo2) + 2*umo1*umo2*cos(ufa1 - ufa2)), 0.5*sqrt(pow<2>(vmo1) + pow<2>(vmo2) + 2*vmo1*vmo2*cos(vfa1 - vfa2))};
 4834:             sideBnd->ufa[jfr] = {atan2(umo1*sin(ufa1) + umo2*sin(ufa2), umo1*cos(ufa1) + umo2*cos(ufa2)), atan2(vmo1*sin(vfa1) + vmo2*sin(vfa2), vmo1*cos(vfa1) + vmo2*cos(vfa2))};
 4835: 
 4836:          } // for jfr
 4837: 
 4838:       }
 4839:    }
 4840: 
 4841: 
 4842: }
 4843: 
 4844: __device__ void Mesh::populateBoundarySideLinks(void) {
 4845: 
 4846:    SIDE_BND(sideBnd);
 4847: 
 4848:    const Side *side = sideBnd->side;
 4849: 
 4850:    // We assume that the leftSide is the side s that has s->n2 == side->n1
 4851:    // and the rightSide is the side s that has s->n1 == side->n2
 4852:    for (int i = 0; i < mesh->nbs; i++) {
 4853: 
 4854:       Side *s = &mesh->localSideData[i];
 4855: 
 4856:       if (s == side) continue;  // Do not link the side to itself
 4857:    
 4858:       if (s->n1 == side->n2) sideBnd->leftSide  = s;
 4859:       if (s->n2 == side->n1) sideBnd->rightSide = s;
 4860:    }
 4861: 
 4862:   
 4863: }
