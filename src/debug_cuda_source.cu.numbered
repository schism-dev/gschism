 3850:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3851: 
 3852:       NODE_BND(nodeBnd);
 3853: 
 3854:       Node *node = nodeBnd->node;
 3855: 
 3856:       node->ETP = 0.0;
 3857: 
 3858:       for (int j=0; j<ntip; j++) {
 3859: 
 3860:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3861:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3862:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3863: 
 3864:          if constexpr(iloadtide==1) { // loading tide
 3865:             assert(false && "Loading tide not implemented");
 3866:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3867:          }
 3868:          
 3869:       }
 3870:       
 3871:    }
