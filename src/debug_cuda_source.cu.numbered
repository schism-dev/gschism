 1112: 
 1113:    // "Local" horizontal coordinates at the nodes. They are computed from the 3D global node coordinates. For ics == 1 and 2
 1114:    // Local is in quotes because for ics == 1, the coordinates are unchanged. It just means that in these coordinates, the element is horizontal.
 1115:    __device__ __forceinline__ Point2 getLocalHorizontalNodePosition(int idxNode) const;
 1116:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2, 
 1117:                                                                        const Vector3& c, const Frame<ics>& dstFrame,int idx = 0) const;
 1118:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2, int idx = 0) const;
 1119:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3,
 1120:                                                                        const Vector3& c, const Frame<ics>& dstFrame) const;
 1121:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const;
 1122: 
 1123: 
 1124:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idxNode = 0,1,2,3)
 1125:    __device__ __forceinline__ Point2 GaussPoint(int idxNode) const {
 1126:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
 1127:        assert(idxNode >= 0 && idxNode < 4 && "GaussPoint: idxNode out of range");
 1128:        const double eta = (idxNode & 1) ? +g : -g;
 1129:        const double xi  = (idxNode & 2) ? +g : -g;
 1130:        return {eta, xi};
 1131:    }  
 1132: 
 1133: 
 1134: 
 1135:    // Shape function Phi at a given point p = (eta,xi), idxNode = node index 0,1,2,3
 1136:    __device__ __forceinline__ double Phi_quad(int idxNode, Point2 p) const {
 1137:       return 0.25*(1.0 + p.x*eta_n(idxNode))*(1.0 + p.y*xi_n(idxNode));
 1138:    }
 1139: 
 1140:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi)
 1141:    __device__ __forceinline__ double dPhi_dxi_quad(int idxNode, Point2 p) const {
 1142:       return 0.25*xi_n(idxNode)*(1.0 + p.x*eta_n(idxNode));
 1143:    }   
 1144: 
 1145:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
 1146:    __device__ __forceinline__ double dPhi_deta_quad(int idxNode, Point2 p) const {
 1147:       return 0.25*(1.0 + p.y*xi_n(idxNode))*eta_n(idxNode);
 1148:    }      
 1149:    
 1150:    __inline__ __device__ double detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
 1151: 
 1152:    __inline__ __device__ double detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
 1153: 
 1154:    __inline__ __device__ double detJ_quad(Point2 p, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const 
 1155:          { return (1.0/4.0)*area + detJ_eta_quad(x0, x1, x2, x3)*p.x+ detJ_xi_quad(x0, x1, x2, x3)*p.y; }
 1156: 
