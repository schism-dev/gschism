 2513:    const double w2 = 1.0 - w1;
 2514:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2515:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2516: 
 2517:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
