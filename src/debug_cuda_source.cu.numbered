 7587: extern "C" __global__ void getElementVar(int varCode, bool is3D, double *var1, double *var2, int *ivar1, int *ivar2, int k = -1, int j = -1) {
 7588:    // Get the value of a variable from an element
 7589:    // varName is the name of the variable to get
 7590:    // var is the array to store the value
 7591:    // k is the vertical level index of the variable to get
 7592: 
 7593:    ELEM(elem);
 7594:    
 7595:    int idx = elem->idx;
 7596:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7597: 
 7598:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7599:    if      (varCode == (int)VarCode::w)       { var1[idx] = elem->w[k];}
 7600:    else if (varCode == (int)VarCode::z)       { var1[idx] = elem->z[k];}
 7601:    else if (varCode == (int)VarCode::x)       { var1[idx] = elem->center.x; var2[idx] = elem->center.x;}
 7602:    else if (varCode == (int)VarCode::area)    { var1[idx] = elem->area;}
 7603:    else if (varCode == (int)VarCode::depth)   { var1[idx] = elem->depth;}
 7604:    else if (varCode == (int)VarCode::radius)  { var1[idx] = elem->radius;}
 7605:    else if (varCode == (int)VarCode::lonlat)  { var1[idx] = elem->xlon;     var2[idx] = elem->ylat;}
 7606:    else if (varCode == (int)VarCode::ghat)    { var1[idx] = elem->ghat1.x;  var2[idx] = elem->ghat1.y;}
 7607:    else if (varCode == (int)VarCode::kb)      { ivar1[idx] = elem->kb;}
 7608:    else if (varCode == (int)VarCode::ssign && j > -1)  {ivar1[idx] = elem->ssign[j];}
 7609:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7610:       
 7611:    
 7612: }
 7613: 
 7614: 
 7615: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7616:    // Get the value of a variable from an node
 7617:    // varName is the name of the variable to get
 7618:    // var is the array to store the value
 7619:    // k is the vertical level index of the variable to get
 7620: 
 7621:    NODE(node);
 7622:    
 7623:    int idx = node->idx;
 7624:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7625: 
 7626:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7627:    
 7628:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7629:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7630:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7631:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 7632:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7633:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7634:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;  
 7635:    else if (varCode == (int)VarCode::isdry && k == -1)  var[idx] = node->isDry?1.0:0.0;
 7636:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7637:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7638:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 7639:    
 7640:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7641:       
 7642:    
 7643: }
 7644: 
 7645: 
 7646: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7647:    // Get the value of a variable from an side
 7648:    // varName is the name of the variable to get
 7649:    // var is the array to store the value
 7650:    // k is the vertical level index of the variable to get
 7651:    SIDE(side);
 7652:    
 7653:    int idx = side->idx;
 7654:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7655: 
 7656:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 7657:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 7658:    // else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 7659:    else if (varCode == (int)VarCode::isdry && k == -1)   var[idx] = side->isDry?1.0:0.0;
 7660:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 7661:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 7662:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 7663:    // else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 7664:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 7665:    // else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 7666:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 7667:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 7668:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 7669:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 7670:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 7671:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 7672:    // else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 7673:    else if (varCode == (int)VarCode::bcc && k >= 0)      var[idx] = side->bcc[k].x;
 7674:    // else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 7675:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7676:    // else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7677:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7678:    // else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7679:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 7680:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 7681:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 7682:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 7683:    else if (varCode == (int)VarCode::chi  && k == -1)    var[idx] = side->chi;
 7684:    // else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 7685:    // else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 7686:    // else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 7687:    // else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 7688:    // else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 7689:    // else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 7690:    // else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 7691:    // else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 7692:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7693: }
 7694: 
 7695: 
 7696: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 7697:    // Get the value of a variable from an side
 7698:    // varName is the name of the variable to get
 7699:    // var is the array to store the value
 7700:    // k is the vertical level index of the variable to get
 7701:    SIDE_BND(sideBnd);   
 7702: 
 7703:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 7704:    if (sideBnd->segment->isLand) idx = -7;
 7705: 
 7706:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 7707:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 7708: 
 7709: }
