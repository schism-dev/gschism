 7427: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7428:    Element *elems = mesh->localElemData;
 7429: 
 7430:    *addr = elems;
 7431:    *sizeElement = sizeof(Element);
 7432:    switch (varCode) {
 7433:       case (int)VarCode::z:
 7434:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7435:          *sizeType = sizeof(double);
 7436:          break;
 7437:       case (int)VarCode::x:
 7438:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7439:          *sizeType = sizeof(Vector2);
 7440:          break;
 7441:       case (int)VarCode::area:
 7442:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7443:          *sizeType = sizeof(double);
 7444:          break;
 7445:       case (int)VarCode::depth:
 7446:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7447:          *sizeType = sizeof(double);
 7448:          break;
 7449:       case (int)VarCode::radius:
 7450:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7451:          *sizeType = sizeof(double);
 7452:          break;
 7453:       case (int)VarCode::lonlat:
 7454:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 7455:          *sizeType = sizeof(double);
 7456:          break;
 7457:       case (int)VarCode::ghat:
 7458:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7459:          *sizeType = sizeof(Vector2);
 7460:          break;
 7461:       case (int)VarCode::kb:
 7462:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 7463:          *sizeType = sizeof(int);
 7464:          break;
 7465:       case (int)VarCode::isdry:
 7466:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 7467:          *sizeType = sizeof(int);
 7468:          break;            
 7469:       case (int)VarCode::w:
 7470:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 7471:          *sizeType = sizeof(double);
 7472:          break;
 7473:       case (int)VarCode::FaceIndices:
 7474:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 7475:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 7476:          *sizeType = sizeof(Node);
 7477:          break;
 7478:       default:
 7479:          *offset = -1;
 7480:    }
 7481: }
