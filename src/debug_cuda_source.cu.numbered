 8097: __global__ void getStructSizes(int* sizes)  {
 8098:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 8099:       sizes[0] = (int)sizeof(Node);
 8100:       sizes[1] = (int)sizeof(Element);
 8101:       sizes[2] = (int)sizeof(Side);
 8102:       sizes[3] = (int)sizeof(NodeBoundary);
 8103:       sizes[4] = (int)sizeof(SideBoundary);
 8104:       sizes[5] = (int)sizeof(BoundarySegment);
 8105: }
