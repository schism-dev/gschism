 3291: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3292:    if constexpr(ics == 1) {
 3293:       return center;
 3294: 
 3295:    } else {
 3296:       const Point2 p0 = n1->outputCoords();
 3297:       const Point2 p1 = n2->outputCoords();
 3298:       return (1.0/2.0)*(p0 + p1);
 3299: 
 3300:    }
 3301: }
 3302: 
 3303: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3304: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3305: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3306: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3307: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3308: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3309: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3310: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3311: // Computes the gradient of the field at the side center.
 3312:    Vector2 grad = {0.0, 0.0};
 3313:    int count = 0;
 3314: 
 3315:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3316:    // as the average of the gradients at each element.
 3317:    // First element
 3318:    if (elems[0] != nullptr && condition(elems[0])) {
 3319:       Vector2 elemGrad = elems[0]->grad2(field);
 3320: 
 3321:       // For ics=2, projects the element gradient from its frame to the side frame
 3322:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3323: 
 3324:       grad += elemGrad;
 3325: 
 3326:       count++;
 3327:    }
 3328: 
 3329:    // Second element
 3330:    if (elems[1] != nullptr && condition(elems[1])) {
 3331: 
 3332:       Vector2 elemGrad = elems[1]->grad2(field);
 3333: 
 3334:       // For ics=2, projects the element gradient from its frame to the side frame
 3335:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3336: 
 3337:       grad += elemGrad;
 3338: 
 3339:       count++;
 3340:    }
 3341: 
 3342:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3343:    if (count > 0) {
 3344:       grad = grad*(1.0/count);
 3345:    }
 3346:    
 3347:    return grad;
 3348: }
