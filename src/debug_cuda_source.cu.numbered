 1629: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1630:    // Computes the 3D normal vector to the element at level k
 1631:    // Returns the normal vector and the area of the element
 1632: 
 1633:       if (isTri()) {
 1634:          // For triangles...
 1635: 
 1636:          // Gets the normal vector to the element (with a length equal to twice the area)
 1637:          if constexpr(ics==1) {
 1638:             const int kb0 = max(k, nodes[0]->kb);
 1639:             const int kb1 = max(k, nodes[1]->kb);
 1640:             const int kb2 = max(k, nodes[2]->kb);
 1641: 
 1642:             const Vector3 n20 = nodes[2]->p3(k) - nodes[0]->p3(k);
 1643:             const Vector3 n10 = nodes[1]->p3(k) - nodes[0]->p3(k);
 1644:             
 1645:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1646:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1647:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1648:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1649: 
 1650:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1651:             area3D = 0.5*len;
 1652: 
 1653:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1654: 
 1655:             return {nx/len, ny/len, nz/len};
 1656: 
 1657:            
 1658:          }
 1659:          else {  // lat/lon
 1660:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1661: 
 1662:          } // if ics
 1663:       }
 1664:       else {
 1665:          // For quads...
 1666: 
 1667:          assert(false && "Element normal vector: quads not yet implemented");
 1668: 
 1669: 
 1670:       }
 1671:    }
 1672: 
 1673: /**
 1674:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1675:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1676:    If the segment is completely inside the element, then it returns true.
 1677: 
 1678:    This function assumes:
 1679:    - The initial point is on a side of the element. 
 1680:    - Its position is given by parameter t in the range [0,1].
 1681:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1682:       intersects the element (elements are convex).
 1683: 
 1684:    To find the intersection point, this function does the following:
 1685:    - it finds the intersection of the line segment with all the element side lines,
 1686:       except for the one that contains the initial point.
 1687:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1688:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1689:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1690:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1691:       track segment is almost parallel to the element side line.
 1692: 
 1693:    Inputs:
 1694:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1695:    @param x2, y2: other end of the line segment
 1696: 
 1697:    Outputs:
 1698:    @param side:  side that intersects the line segment (input and output)
 1699:    @param nextElement (output): element that contains the intersection point
 1700:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1701:    @param zint (input/output): Vertical coordinate of the intersection point
 1702: 
 1703:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1704:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1705:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1706: 
 1707:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1708:    (Delta) being zero.
 1709: 
 1710:    The intersection2 point happens when:
 1711:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1712:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1713:    
 1714:    Assumption: the 4 points (including those of the side segment) are different.
 1715:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1716:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1717:    If true, (xIntersect,yIntersect) is the intersection.				
 1718:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1719: **/
 1720: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1721:                                               double &t, double& tIntersect) {
 1722: 
 1723:    double closest_intersect_t = 1e10;
 1724:    bool found_intersection = false;
 1725: 
 1726:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1727:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1728:    const Point2 x1 = side->point(t);
 1729:    
 1730: 
 1731:    Side *nextSide = nullptr;
 1732:    for (int i = 0; i < i34; i++) {
 1733: 
 1734:       // Element's i-th side 
 1735:       Side *side2 = sides[i];
 1736: 
 1737:       // Skip the side that contains the initial point
 1738:       if (side2 == side) continue;
 1739: 
 1740:       // (x3,y3)-(x4,y4) is the element side line
 1741:       const Point2 x3 = side2->n1->p2();
 1742:       const Point2 x4 = side2->n2->p2();
 1743: 
 1744:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1745:       const double delta = cross(x2 - x1, x3 - x4);
 1746: 
 1747:       if (delta != 0.0) {
 1748: 
 1749:          const double delta1 = cross(x3 - x1, x3 - x4);
 1750:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1751: 
 1752:          // Solves the two linear equations for tt1 and tt2
 1753:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1754:          const double tt2 = delta2/delta;
 1755: 
 1756:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1757:             closest_intersect_t = min(closest_intersect_t, tt1);
 1758:             nextSide = side2;
 1759: 
 1760:             nextElement = nextSide->otherElem(this);
 1761:             tIntersect = max(small, min(tt1, 1.0-small));
 1762:             t = tt2;
 1763: 
 1764:             found_intersection = true;
 1765:          }
 1766:       
 1767:       }
 1768: 
 1769:    }
 1770: 
 1771:    // found_intersection should always be true, since we checked all the sides.  
 1772:    side = nextSide;
 1773: 
 1774:    return found_intersection;
 1775: }
 1776: 
 1777: 
 1778: 
 1779: 
 1780: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1781:                                               double &t, double& tIntersect) {
 1782: 
 1783:    double closest_intersect_t = 1e10;
 1784:    bool found_intersection = false;
 1785: 
 1786:    for (int i = 0; i < i34; i++) {
 1787: 
 1788:       Side *side2 = sides[i];
 1789: 
 1790:       // (x3,y3)-(x4,y4) is the element side line
 1791:       const Point2 x3 = side2->n1->p2();
 1792:       const Point2 x4 = side2->n2->p2();
 1793: 
 1794:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1795:       const double delta = cross(x2 - x1, x3 - x4);
 1796: 
 1797:       if (abs(delta) > 0) {
 1798: 
 1799:          const double delta1 = cross(x3 - x1, x3 - x4);
 1800:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1801: 
 1802:          // Solves the two linear equations for tt1 and tt2
 1803:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1804:          const double tt2 = delta2/delta;
 1805: 
 1806:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1807:             closest_intersect_t = min(closest_intersect_t, tt1);
 1808:             side = side2;
 1809:             nextElement = side->otherElem(this);
 1810:             t = tt2;
 1811:             tIntersect = max(small, min(tt1, 1.0-small));
 1812:             found_intersection = true;
 1813:          }
 1814:       
 1815:       }
 1816:       else {  // parallel segments
 1817:          assert(false && "Parallel segments");
 1818:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1819:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1820: 
 1821:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1822: 
 1823:          // const double dist = dot(x1 - x3, side2->n);
 1824:          // if (abs(dist) < small*length(x3 - x4)) {
 1825:          //    const double2 unitarySide = normalize(x4 - x3);
 1826:          //    const double len = dot(x2 - x1, unitarySide);
 1827:          //    t = t + len;
 1828:          //    t = max(0.0, min(t, 1.0));
 1829:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1830: 
 1831: 
 1832:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1833:          //    // t = tt2;
 1834:          //    found_intersection = true;
 1835:          // }
 1836:       }
 1837: 
 1838: 
 1839:    }
 1840: 
 1841:       
 1842:    assert(found_intersection && "No intersection found");
 1843: 
 1844:    // found_intersection should always be true, since we checked all the sides.  
 1845:    return found_intersection;
 1846: }
 1847: 
 1848: 
 1849: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1850:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1851: 
 1852:    printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 1853: 
 1854:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1855:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1856:    // curElement.
 1857: 
 1858:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1859:    // And uses this velocity instead to continue the tracking.
 1860: 
 1861:    // computes the intersection point in cartesian coordinates
 1862:    Point2 intersection = nextSide->p_t(tt);
 1863: 
 1864:    // Nudges the point to the barycenter of the element. 
 1865:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1866:    // next segment intersects the element sides.  
 1867:    curElem->nudgeToBarycenter(intersection);
 1868: 
 1869:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1870:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1871:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1872:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1873: 
 1874:    // If the side is an open boundary, the tangential velocity is zero.
 1875:    if (nextSide->isBnd()) vtan = 0.0;
 1876: 
 1877:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1878:    const double us = vtan*nextSide->t().x;
 1879:    const double vs = vtan*nextSide->t().y;
 1880:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1881: 
 1882:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1883:    const double len2 = norm2(intersection - toPoint2(xt));
 1884:    const double vel2 = dot(u_int, u_int);        
 1885:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 1886:    else            dt = 0.0;
 1887: 
 1888:    // The end of this tracking segment is now the intersection point.
 1889:    xt = {intersection.x, intersection.y, zint};
 1890: 
 1891:    u_int = {us, vs, ws};
 1892:    
 1893: }
 1894: 
 1895: /**
 1896:  * Tracks a particle through elements and vertical levels in the mesh.
 1897:  * 
 1898:  * @param x0,y0,z0     Starting position coordinates
 1899:  * @param xt,yt,zt     Target position coordinates
 1900:  * @param dtb          Time step for tracking
 1901:  * @param uuint,vvint,wwint Initial velocity components
 1902:  * @param nextElem     Starting/resulting element index
 1903:  * 
 1904:  * @return Status code of type trackExitCodes
 1905:  * 
 1906:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1907:  * of the details are different. The idea is that the code requires less branches and is better fit
 1908:  * for GPU execution.
 1909:  * 
 1910:  * The main ideas here are:
 1911:  * - The starting point is expected to be in the starting element.
 1912:  * - The end point is guaranteed to be inside an element.
 1913:  * - since the starting point is inside the element, there are only two cases: 
 1914:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1915:  *     (b) it does not and (xt,yt) is already in the starting element.
 1916:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1917:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1918:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1919:  * - tt1 can be positive or negative. We only consider the positive values.
 1920:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1921:  * - The next intersection will occur at the smallest positive tt1.
 1922:  * - This intersection will be the next (x0,y0) position.
 1923:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1924:  *   of getting stuck in a loop.
 1925:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1926:  *   was found.
 1927:  */
 1928: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1929:                                                        Element *&nextElem, int &jlev, double &dt,
 1930:                                                        const Side *origSide) {
 1931: 
 1932: 
 1933: 
 1934:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 1935:    // else to do.
 1936:    // If it is, nudges the point to be inside the element.
 1937:    const Element *curElem = nextElem;
 1938:    if (containsPoint(toPoint2(xt), true)) {
 1939: 
 1940:       curElem->interpolateVelocities(xt, u_int);
 1941: 
 1942: addDebugPlot(x0, xt);
 1943:       return true;
 1944:    }
 1945: 
 1946:    Side *side = nullptr;
 1947: 
 1948:    // 1. Initial checks
 1949:    // Verify starting element is valid (wet)
 1950:    assert(!curElem->isDry && "Starting element is dry");
 1951: 
 1952:    // Checks if track has a zero length.
 1953:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1954:    // assert(len2 > 0.0 && "Zero length track"); 
 1955:    
 1956:    const int MAX_ITERATIONS = 1000;
 1957:    
 1958:    double t;
 1959:    Side *nextSide = nullptr;
 1960:    double tIntersect = 1e10;
 1961:    double zint = x0.z;
 1962: 
 1963:    // Horizontal tracking loop
 1964:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1965:    // (x0,y0) is inside the element but the target point is not.
 1966: 
 1967:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1968: 
 1969:    assert(found_intersection && "No intersection found at %d");
 1970: 
 1971:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1972: 
 1973:    // if the tracking segment goes out of water (either dry or edge boundary)
 1974:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1975: 
 1976: addDebugPlot(x0, xt, 0x00A0FF);
 1977:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1978: addDebugPlot(x0, xt, 0x00A0FF);      
 1979: 
 1980:       nextElem = this;
 1981:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1982:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1983:       return true;    
 1984:    }
 1985: 
 1986: 
 1987:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1988:    int iterations = 0;
 1989:    while (iterations < MAX_ITERATIONS) {
 1990:       iterations++;
 1991:       
 1992:       Element *curElem = nextElem;
 1993: 
 1994:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1995: addDebugPlot(x0, xt);
 1996:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1997: 
 1998:       // If we are already in the target element, we are done.
 1999:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 2000:       if (!found_intersection) break;
 2001: 
 2002: 
 2003: 
 2004:       // if the tracking segment goes out of water (either dry or edge boundary).
 2005:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2006: addDebugPlot(x0, xt, 0x00A0FF);
 2007:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 2008: addDebugPlot(x0, xt, 0x00A0FF);   
 2009:          nextElem = curElem;
 2010: 
 2011:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 2012:          // In this case, the caller (btrack) needs to take into account the remaining time.
 2013:          return true;
 2014:       }
 2015:       
 2016:       // Update position and element for next iteration
 2017:       side = nextSide;
 2018: 
 2019:    }
 2020: 
 2021:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 2022: 
 2023:  
 2024:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2025:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2026: addDebugPlot(x0, xt);   
 2027:    nextElem->interpolateVelocities(xt, u_int); 
 2028: 
 2029:    return true;
 2030: }
 2031: 
 2032: 
 2033: __inline__ __device__ double Element::computeSignedArea(void) const {
 2034:    // Compute the area of the element
 2035: 
 2036:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 2037: 
 2038:    // In the quad case we need to add the area of the other triangle.
 2039:    if (isQuad()) {
 2040:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2041:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 2042:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2043:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 2044:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 2045:          Error("Negative area found in quad element");
 2046:       }
 2047:       res += ar1;
 2048:    }
 2049: 
 2050:    return res;
 2051: }
 2052: 
 2053: 
 2054: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2055:                                                                 (nodes[1]->isDry2()) ||
 2056:                                                                 (nodes[2]->isDry2()) ||
 2057:                                                                 (i34==4 && nodes[3]->isDry2());
 2058: }
 2059: 
 2060: 
 2061: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2062:    // In boundary sides, the element 1 is nullptr
 2063:    return side->elems[1] == nullptr; 
 2064: }
 2065: 
 2066: 
 2067: 
 2068: /**
 2069:    Compute the shape coordinates of the point (xt,yt) in the element.
 2070:    @param xt (input): x-coordinate of the point
 2071:    @param shpCoords (output): shape coordinates of the point
 2072:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2073:    @return true if the point is inside the element, false otherwise
 2074: **/
 2075: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2076:                                             bool fixNegshpCoord) const {
 2077: 
 2078:    // Compute the shape coordinates of the point xt in the element.
 2079:    if (i34==3) {
 2080:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2081:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2082:       // and in this case, the pt will be nudged into the element
 2083:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2084:       // from the local frame, so use additional check.
 2085: 
 2086:       Point2 x0, x1, x2;
 2087: 
 2088:       if constexpr(ics==1) {
 2089:          x0 = nodes[0]->p2();
 2090:          x1 = nodes[1]->p2();
 2091:          x2 = nodes[2]->p2();
 2092:       }
 2093:       else // lat/lon
 2094:       {
 2095:          Error("Not implemented yet");
 2096: #ifdef ICS2
 2097:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2098:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2099:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2100: #endif
 2101:       }
 2102: 
 2103:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2104:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2105:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2106:       shpCoords[3] = 0.0;
 2107:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2108: 
 2109:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2110:       // then we fix the negative shape coordinates.
 2111:       if (fixNegshpCoord && tmpmin<=0.0) {
 2112: 
 2113:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2114:          // keeping the sum of the shape coordinates equal to 1.
 2115:          // I have tested and compared the new algorithm with the old one, and they give
 2116:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2117:          // The new algorithm should be faster since it is branchless.
 2118:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2119:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2120:          
 2121:          shpCoords[0] = (shpCoords[0] + a)*b;
 2122:          shpCoords[1] = (shpCoords[1] + a)*b;
 2123:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2124: 
 2125:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2126:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2127:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2128:          }
 2129: 
 2130:          // Update the point coordinates for the new shape coordinates
 2131:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2132:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2133:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2134: 
 2135:       }
 2136: 
 2137:       // Check if the point is inside the element
 2138:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2139:    }
 2140:    else {
 2141:       Error("Not implemented yet");
 2142: #ifdef QUADS
 2143:       // Reproject pt in eframe of nel for ics=2
 2144:       if constexpr(ics==1) {
 2145:          xn2 = xt; 
 2146:          yn2 = yt;
 2147:       }
 2148:       else {
 2149:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2150:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2151:       }
 2152: 
 2153:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2154: #endif
 2155:    }
 2156: 
 2157:    return false;  // Never reached
 2158: 
 2159: }
 2160: 
 2161: 
 2162: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2163: // Convert shape coordinates to cartesian coordinates
 2164: 
 2165:    if (i34 == 3) {
 2166:       // Triangular element
 2167:       double xcoords[3] = {nodes[0]->p2().x, nodes[1]->p2().x, nodes[2]->p2().x};
 2168:       double ycoords[3] = {nodes[0]->p2().y, nodes[1]->p2().y, nodes[2]->p2().y};
 2169:    }
 2170:    else {
 2171:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2172:    }
 2173: 
 2174: }
