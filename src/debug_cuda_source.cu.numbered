 3854: extern "C" {
 3855: 
 3856:    __global__ void scaleGravity(double loadtide_coef) {
 3857: 
 3858: 
 3859:       NODE(node);
 3860: 
 3861:       // SAL option: scale gravity
 3862:       if constexpr(iloadtide==2) {  // simple const
 3863:          node->grav2 = grav*(1.0 - loadtide_coef);
 3864: 
 3865:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3866:         
 3867:           const double depth = max(node->depth, 0.0);
 3868:           const double tmp1 = sqrt(depth);
 3869:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3870:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3871:                              2.6969e-13*depth*depth*depth*tmp1;
 3872:           
 3873:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3874:           
 3875: 
 3876: 
 3877:           node->grav2 = grav*(1.0 - beta_bar);
 3878: 
 3879:       } else {  // iloadtide=0,1
 3880:         node->grav2=grav;
 3881: 
 3882:       }
 3883: 
 3884:       printf("scaleGravity: node(%d)->grav2 = %f\n", node->idx, node->grav2);
 3885:    }
