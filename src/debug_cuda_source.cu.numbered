 9924:       case (int)VarCode::isdry:
 9925:          *offset = (int)((char*)&sides[0].isDry - (char*)sides);
 9926:          *sizeType = sizeof(int);
 9927:          break;            
 9928:       // case (int)VarCode::w:
 9929:       //    *offset = (int)((char*)&sides[0].w2 - (char*)sides);
 9930:       //    *sizeType = sizeof(double);
 9931:       //    break;
 9932:       case (int)VarCode::u:
 9933:          *offset = (int)((char*)&sides[0].u2[0].x - (char*)sides);
 9934:          *sizeType = sizeof(Vector2);
 9935:          break;   
 9936:       case (int)VarCode::btu:
 9937:          *offset = (int)((char*)&sides[0].btu[0].x - (char*)sides);
 9938:          *sizeType = sizeof(Vector2);
 9939:          break;          
 9940:       case (int)VarCode::U:
 9941:          *offset = (int)((char*)&sides[0].U.x - (char*)sides);
 9942:          *sizeType = sizeof(Vector2);
 9943:          break;
 9944:       case (int)VarCode::gradETP:
