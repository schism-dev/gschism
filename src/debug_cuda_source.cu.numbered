 4640:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4641: 
 4642:       SIDE(side);
 4643: 
 4644: 
 4645:       side->U = {0.0, 0.0}; 
 4646:          
 4647:       if(side->isDry) return;
 4648: 
 4649:       const Node *node1 = side->n1;
 4650:       const Node *node2 = side->n2;
 4651: 
 4652:       // Vertically integrated velocity U (in ll if ics=2)
 4653:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4654:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  
 4655:       }
 4656: 
 4657:    }
 4658: 
 4659:    __global__ void computeBottomDragVegetation(void) {
 4660:       // UNFINISHED. CHECK THIS:
 4661:       // How many kernels are needed? Why so many for loops?
 4662:       // Is the loop on sides needed?
 4663: 
 4664:       NODE(node);
 4665: 
 4666: 
 4667:       const int    kb      = node->kb;
 4668:       const double htot    = node->htot2(); 
 4669:       const double rough   = node->rough;
 4670: 
 4671:       
 4672:       if (node->isDry) {
 4673:          // Default values for dry nodes
 4674:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4675:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4676: 
 4677:          return;
 4678:        
 4679:       }
 4680: 
 4681:       // Compute bottom drag Cd
 4682:       //--------------------------------
 4683: 
 4684:       // nchi = {-1, 0, 1} is the type of bottom drag.
 4685:       if constexpr(nchi == 1) {
 4686: 
 4687:          bool ltmp = false; // for WBL iteration
 4688: 
 4689:          // Cdmax=-1 !max. Cd at node for this process (info only)
 4690:          // Drag at nodes
 4691:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)   XXXXXXXXXXXX
 4692:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 4693:         
 4694:          const double rough = node->rough;
 4695:         
 4696:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4697:          if (node->rough == 0.0) {
 4698:             node->Cd = 0.0;
 4699: 
 4700:          } else { //roughness >0 
 4701:           
 4702:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 4703:             const double bthick = max(dzb_min, bthick_ori);
 4704: 
 4705:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 4706: 
 4707:             double tmp = 1.0/(2.5*log(bthick/rough));
 4708:             node->Cd = tmp*tmp;
 4709: 
 4710:          } // if rough
 4711: 
 4712: 
 4713:          // RECOVER THIS: XXX
 4714:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 4715:          // Output warning for WBL if iteration didn't converge
 4716: 
 4717: 
 4718:       } // nchi==1
 4719: 
 4720: 
 4721:       //   Bottom stress in m^2/s^2
 4722:       if (node->rho[kb + 1] >= -98.0)
 4723:       {
 4724:          const double mag_u = length(node->u2[kb + 1]);
 4725:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 4726: 
 4727:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4728:          // !sediment erosion: this part needs more documentation
 4729:       }
 4730:     
 4731: 
 4732: 
 4733:       // Compute vegetation parameters
 4734:       //--------------------------------
 4735: 
 4736:       // SAV constants
 4737:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4738:       constexpr double veg_cfpsi = 0.16;
 4739: 
 4740:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4741:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4742: 
 4743:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4744:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4745:          int kbin = 0; // bin index
 4746:          for (int k = kb; k < nvrt; k++) {
 4747:             // Computes node height above the bottom level
 4748:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4749:             assert(false && "Vertical variation of vegetation not implemented");
 4750: 
 4751:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4752:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4753:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4754:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4755:             // } else {
 4756:             //    // Find the bin at which the current vertical level is
 4757:             //    while (kbin<nbins_veg_vert) {
 4758:             //       const double zn = node->z[kbin];
 4759:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4760:             //          break;
 4761:             //       } // if
 4762:             //       kbin++;
 4763:             //    } // while
 4764:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4765: 
 4766:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4767:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4768:                
 4769:             //    // Linear interpolation of the vegetation parameters
 4770:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4771:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4772:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4773:             // } // if rl10
 4774: 
 4775:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4776: 
 4777:          } // for k
 4778: 
 4779: 
 4780:       } else { // Ganthy (iveg==2)
 4781:       //  Modify canopy height, diameter, and density
 4782: 
 4783:          // Make sure there is vegetation on this node
 4784:          if (node->veg_h_unbent > 0.0) {
 4785:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4786: 
 4787:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4788:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4789:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4790: 
 4791:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4792:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4793:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4794:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4795:          } // if veg_h_unbent
 4796: 
 4797:          for (int k = 0; k < nvrt; k++) {
 4798:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4799:          } // for k
 4800:       
 4801: 
 4802:       } // if iveg
 4803:      
 4804: 
 4805:       // Compute vertical mean of veg_alpha3D
 4806:       if (iveg != 0) {
 4807:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4808:          double sum1=0.0;
 4809:          double sum2=0.0;
 4810:          // Integrate over each level under the canopy...
 4811:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 4812:             const double Dz = node->Dz(k);
 4813: 
 4814:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 4815:             sum2 += Dz;
 4816: 
 4817:          } // for k
 4818:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4819:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4820: 
 4821:       } // if iveg
 4822: 
 4823:    }
 4824: 
 4825:    __global__ void computeVegetationAndDragParameters(void) {
 4826:       // Computes the vegetation and drag model parameters:
 4827:       // chi, \tilde\chi, beta, \breve{H}
 4828:       
 4829:       SIDE(side);
 4830: 
 4831:       if (side->isDry) return;
 4832: 
 4833:       const double htot = side->htot2();
 4834:       const int    kb   = side->kb;
 4835: 
 4836:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4837: 
 4838:       const double veg_h     = side->veg_h();
 4839:       const double veg_nv    = side->veg_nv();
 4840:       const double veg_c     = side->veg_c();
 4841:       const double veg_beta  = side->veg_beta;
 4842:       const double veg_alpha = side->veg_alpha_vert_mean();
 4843: 
 4844:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4845:       // Velocity magnitude at the bottom level
 4846:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4847:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4848:       side->chi2 = side->Cd()*vmag1;
 4849:       side->chi  = side->chi2;
 4850:       if constexpr(iveg != 0) {
 4851:          const Node *n1 = side->n1;
 4852:          const Node *n2 = side->n2;
 4853:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4854:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4855:       }
 4856: 
 4857:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4858: 
 4859:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4860:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4861:       double magUa = 0.0;
 4862:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4863:          // 3D wet side with veg...
 4864: 
 4865:          double magUa = 0.0;
 4866:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4867:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4868: 
 4869:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4870:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4871:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4872: 
 4873:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4874:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4875: 
 4876:                // Velocity magnitude at the bottom (l) of the level
 4877:                const double ul = length(side->u2[k]);
 4878: 
 4879:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4880:                magUa += Dz*0.5*(uh + ul);
 4881: 
 4882:             } // if HasVegetation
 4883:          } // for k
 4884:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4885: 
 4886:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4887:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4888:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4889:             const double zCpy = side->zTopCanopy();
 4890:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4891:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4892:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4893:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4894:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4895:          } // if isSubmerged
 4896:       } // if iveg   
 4897: 
 4898:       // Computes the friction modified depth, \breve{H} in notes
 4899:       if (side->is2D()) { // 2D
 4900: 
 4901:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4902:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4903: 
 4904:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4905: 
 4906:          side->hhat = htot*htot/fricH; 
 4907: 
 4908:       } else { // 3D
 4909:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4910: 
 4911:          if constexpr(iveg != 0) {
 4912:             
 4913:             if (side->isSubmerged()) { 
 4914:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4915:                side->hhat -= veg_c*Hhat_alpha;
 4916: 
 4917:             } else { // Emergent
 4918:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4919:             }
 4920:          } // if iveg
 4921: 
 4922:          // Enforce positivity for 3D model
 4923:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4924:       } // if 3D
 4925: 
 4926:    }
 4927: 
 4928: 
 4929: 
 4930:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4931:    // Computes the density gradient between two elements, e1 and e2.
 4932:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4933:    // zero in the direction normal to the side. 
 4934:    // 
 4935:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4936:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4937:    //
 4938:    // Input:
 4939:    //    e1: Element
 4940:    //    e2: Neighbor element (or nullptr if boundary)
 4941:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4942:    //    k: Index of the half-level at which the density is interpolated
 4943:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4944:    // 
 4945:    // Output:
 4946:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4947:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4948: 
 4949:       if (e2 == nullptr || e2->isDry) {
 4950:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4951: 
 4952:          Side *side = e1->sides[j];
 4953:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4954:                  
 4955:          if constexpr(ics == 1) {
 4956:             vec = side->n; // Normal vector to the side
 4957:          } else {
 4958:             // IMPLEMENT THIS XXXXXX
 4959:             // !replace with xel, yel?
 4960:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4961:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4962:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4963:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4964:          } //ics
 4965:                    
 4966:          diffRho = 0.0;
 4967: 
 4968:       } else { //internal and wet
 4969:          if constexpr(ics==1) {
 4970:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4971: 
 4972:             // Vector from e1 to e2
 4973:             vec = e2->center - e1->center;
 4974: 
 4975:          } else { 
 4976:             // IMPLEMENT THIS XXXXXX
 4977:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4978:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4979:             //                   alow(j)=xctr2
 4980:             //                   bdia(j)=yctr2
 4981:          } // ics
 4982: 
 4983:          diffRho = rho2 - e1->demeanedDensity(k);
 4984:       }
 4985: 
 4986:    }
 4987: 
 4988:    __global__ void computeDensityCubicSplines(void) {
 4989:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4990: 
 4991:       ELEM(elem);
 4992: 
 4993:       if (elem->isDry) return;
 4994: 
 4995:       const int kb = elem->kb;
 4996: 
 4997:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4998:       if (elem->is2D()) {
 4999:          // In the 2D case, the density is constant at the prism level. 
 5000:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5001:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5002:       } else { //3D
 5003: 
 5004:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5005:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5006:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5007:          ///// XXXX CHECK INDICES!!!!!
 5008:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5009:       } // 2D/3D
 5010: 
 5011:    }
 5012: } // extern "C"
 5013: 
 5014: 
 5015: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5016: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5017: 
 5018:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5019: 
 5020:    const int kb  = elem->kb;
 5021:    const int kb2 = elem2->kb;
 5022: 
 5023:    // z-coordinate of prism of elem
 5024:    const double zp = elem->z_prism(k);
 5025: 
 5026:    double rho = 0.0;
 5027: 
 5028:    if (elem2->is2D()) {
 5029:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5030: 
 5031:    } else {  // 3D
 5032: 
 5033:       // eta_min may be < zmax
 5034:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5035:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5036: 
 5037:       // (Extrapolate density below bottom, we will fix it later)
 5038:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5039:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5040:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5041:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5042:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5043:    } // 2D/3D
 5044:      
 5045: 
 5046:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5047:    // Now we need to fix it.
 5048:    if (elem->z[k] < elem2->z[kb2]) {
 5049:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5050: 
 5051:       // There are two methods to adjust the density at the bottom of the element.
 5052:       // iunder_deep=0: 
 5053:       const double depth1 = abs(elem->z[kb]); // larger depth
 5054: 
 5055:       if (iunder_deep==0) {
 5056: 
 5057:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5058: 
 5059:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5060: 
 5061:       } else { // iunder_deep != 0
 5062: 
 5063:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5064: 
 5065:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5066: 
 5067:          //   Demeaned density at the same z coordinate as
 5068:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5069:          }
 5070: 
 5071:       } // if iunder_deep
 5072:    } // if elem->z[kb] < elem2->z[kb]
 5073: 
 5074:    return rho;
 5075: }
 5076: 
 5077: 
 5078: extern "C" {
 5079:    __global__ void computeDensityGradient(void) {
 5080: 
 5081:       if constexpr(ibc != 0) return;
 5082: 
 5083:          // Compute the horizontal density gradient at each element.
 5084:       // It works in two steps:
 5085:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5086:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5087:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5088:       //             gradRho.r1 = rho1 - rho0
 5089:       //             gradRho.r2 = rho2 - rho0
 5090:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5091:       // 
 5092:       //  NOTE: We use de-meaned densities.
 5093: 
 5094:       ELEM(elem);
 5095: 
 5096:       if (elem->isDry) return;
 5097: 
 5098:       const int kb  = elem->kb;
 5099:       const int i34 = elem->i34;
 5100: 
 5101:       for (int k = kb + 1; k < nvrt; k++) {
 5102:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5103:          //             gradRho.r1 = rho1 - rho0
 5104:          //             gradRho.r2 = rho2 - rho0
 5105:          int icount = 0;
 5106:          double sumRx = 0.0;
 5107:          double sumRy = 0.0;
 5108:          for (int j1=0; j1<i34; j1++) { 
 5109: 
 5110:             const int j2 = elem->nxq(j1 + 1);
 5111: 
 5112:             // Pairs of consecutive neighbor elements of elem
 5113:             const Element *e1 = elem->nghbElems[j1];
 5114:             const Element *e2 = elem->nghbElems[j2];
 5115: 
 5116:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5117:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5118:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5119: 
 5120:             // Compute the density difference and the vector from elem to e1 and e2
 5121:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5122:             double diffRho1, diffRho2;
 5123:             Vector2 vec1, vec2;
 5124:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5125:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5126: 
 5127:             const double rl1 = length(vec1);
 5128:             const double rl2 = length(vec2);
 5129:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5130: 
 5131:             const double delta = cross(vec1, vec2);
 5132:             const double sintheta = abs(delta)/(rl1*rl2);
 5133: 
 5134:             // To avoid problems, avoid elements with small angle between vectors
 5135:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5136:             const bool validEq = (sintheta > sin_one_deg);
 5137: 
 5138:             if (validEq) {
 5139:                // Solve the system of equations to get the density gradient at elem
 5140:                icount++;
 5141:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5142:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5143:                sumRx += Rx;
 5144:                sumRy += Ry;
 5145:             }
 5146:          } // for j1
 5147: 
 5148:          // Compute the average density gradient at elem
 5149:          if (icount==0) {
 5150:            // Bad mesh quality; bail out with 0 b-cc
 5151:            elem->gradRho[k] = {0.0, 0.0};
 5152:          } else {
 5153:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5154:          }
 5155: 
 5156:       } // for k
 5157: 
 5158:    }
 5159: 
 5160:    __global__ void computeBaroclinicTerm(void) {
 5161:    // Computes the baroclinic term at sides (at half levels).
 5162:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5163:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5164: 
 5165:       if (ibc == 1) return;
 5166: 
 5167:       SIDE(side);
 5168: 
 5169:       if (side->isDry) return;
 5170: 
 5171:       const Element *e1 = side->elems[0];
 5172:       const Element *e2 = side->elems[1];      
 5173:       const int kb = side->kb;
 5174:       
 5175:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5176: 
 5177:       // interpolates vertically the density gradient of the two elements at the half level/
 5178: 
 5179:       int k1 = max(kb, nvrt / 2);
 5180:       int k2 = max(kb, nvrt / 2);
 5181: 
 5182:       // Starts the integration at the surface and goes down to the bottom
 5183:       side->bcc[nvrt-1] = {0.0, 0.0};
 5184:       for (int k = nvrt - 2; k >= kb; k--) {
 5185:       // For each prism level (from surface to bottom)...
 5186: 
 5187:          // For both elements, interpolate density gradient at the side's half level.
 5188:          // The gradient at the side is the average of the gradients at the elements.
 5189:          // w1, w2 are used to take into account boundary sides, with just one element.
 5190:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5191:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5192:          const double wsum = w1 + w2;
 5193:          w1 = w1/wsum;
 5194:          w2 = w2/wsum;
 5195:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5196: 
 5197:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5198:          Vector2 gradRho = {0.0, 0.0};
 5199:          if (e1 != nullptr && k > kb) {
 5200:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5201:             
 5202:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5203:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5204:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5205: printf("###### k1 = %d, side->idx = %d, zc[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, zrat = %.16f\n",
 5206:       k1, side->idx, k, side->zc[k], k1, e1->z[k1], k1 + 1, e1->z[k1 + 1], e1->gradRho[k1].x, e1->gradRho[k1].y, zrat);            
 5207:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5208:          }      
 5209:          if (e2 != nullptr && k > kb) {
 5210:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5211:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5212:             
 5213:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5214:          }
 5215: 
 5216:          if constexpr(ics==2) {
 5217:             assert(false && "Not implemented: ics == 2");
 5218:             // IMPLEMENT THIS XXXXXX
 5219:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5220:             // swild(1)=tmp1
 5221:             // swild(2)=tmp2
 5222:          }
 5223:          
 5224:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5225:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5226:          // CHECK INDICES!!! XXX
 5227:          const double grav3 = side->grav3();
 5228:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5229: 
 5230:       } // for
 5231: 
 5232:    }
 5233: 
 5234: 
 5235: 
 5236:    __global__ void computeHorGradientAtSide(void) {
 5237: 
 5238:       // Compute the horizontal density gradient at each element.
 5239:       // It works in two steps:
 5240:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5241:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5242:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5243:       //             gradRho.r1 = rho1 - rho0
 5244:       //             gradRho.r2 = rho2 - rho0
 5245:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5246:       // 
 5247:       //  NOTE: We use de-meaned densities.
 5248: 
 5249:       SIDE(side);
 5250: 
 5251: // printf("side->isDry: %d\n", side->isDry);
 5252:       if (side->isDry) return;
 5253: 
 5254:       // Computes the gradient of the variables at the side center.
 5255:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5256:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5257:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 5258: 
 5259:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5260:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5261:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5262:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5263: 
 5264: 
 5265:    }
 5266: 
 5267: 
 5268:    __global__ void solveMomentumEquations(double time) {
 5269: 
 5270:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5271:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5272: 
 5273:       SIDE(side);
 5274: 
 5275:       if (side->isDry) 
 5276:       {
 5277:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 5278: 
 5279:          return;
 5280:       }
 5281: 
 5282:       const Node *n1 = side->n1;
 5283:       const Node *n2 = side->n2;
 5284: 
 5285:       const int kb = side->kb;
 5286: 
 5287:       const double veg_h = side->veg_h();
 5288:       const double grav3 = side->grav3();
 5289: 
 5290:       if (side->is2D()) {
 5291:          // Warning: Do not use htot2, which is updated.
 5292:          const double htot = side->htot1();
 5293:          const double hhat = side->hhat;
 5294: 
 5295:          // assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5296: 
 5297:          Vector2 tau2 = {0.0, 0.0};
 5298:           
 5299:          if constexpr(ics==1) {
 5300:             tau2 = side->tau();
 5301: 
 5302:          } else {
 5303:             assert(false && "Not implemented: ics == 2");
 5304:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5305:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5306:             // taux2=(vn1+tt1)*0.5d0
 5307:             // tauy2=(vn2+ss1)*0.5d0
 5308:          } // if ics         
 5309: 
 5310:          // hat_gam has units of m/s
 5311: 
 5312:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5313: 
 5314:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5315:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5316: 
 5317:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5318: 
 5319: 
 5320:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 5321:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 5322: 
 5323:          for (int k = 0; k < nvrt; k++) side->u2[k] = {ux, uy};
 5324: 
 5325:       }
 5326:       else { // 3D
 5327: 
 5328:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5329:          // 
 5330:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5331:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5332:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5333:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5334:          // k+1 and k.
 5335: 
 5336: 
 5337:          const int ndim = nvrt - kb;
 5338:          const double zTopCanopy = side->zTopCanopy();
 5339: 
 5340:          // Initialize the tridiagonal system
 5341:          for (int k = kb + 1; k < nvrt; k++) {
 5342:             
 5343:             const int kin = k - (kb + 1);
 5344: 
 5345:             // Vertical viscosity at the face center
 5346:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); ///XXXXX
 5347:  
 5348:             alow[kin] = 0.0;
 5349:             cupp[kin] = 0.0;
 5350:             bdia[kin] = 0.0;
 5351: 
 5352:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5353:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5354: 
 5355:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5356:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5357:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5358: 
 5359:             // First part: layers k, k+1
 5360:             if (k < nvrt - 1) {
 5361:                              
 5362:                if constexpr(iveg != 0) {
 5363: 
 5364:                   // If there is vegetation at this level...
 5365:                   if (zTopCanopy > side->zc[k]) {
 5366:                      // If the canopy is above the k layer...
 5367:                      
 5368:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5369:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5370:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5371:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5372: 
 5373:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5374:                      const double vmag2 = length(ut2);
 5375:                      const double vmag1 = length(side->u2[k]);
 5376:                      const double vmag = 0.5*(vmag1 + vmag2);
 5377:                      
 5378:                      // Computes the vegetation alpha at the face center
 5379:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5380: 
 5381:                      cff1 += veg_alpha_sd*dt*vmag;
 5382: 
 5383:                   } // if (zTopCanopy
 5384:                } // if iveg
 5385: 
 5386:                const double dzz = side->Dz(k + 1);
 5387:                const double tmp = dt*dfz/dzz;
 5388:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5389: 
 5390:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5391:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5392:             }
 5393: 
 5394: 
 5395:             // Second part: layers k-1, k
 5396:             if (k > kb + 1) {
 5397: 
 5398:                double cff1 = 1.0; //init \bar{c^k}
 5399: 
 5400:                if constexpr(iveg != 0) {
 5401:                   // If there is vegetation at this level...
 5402:                   if (zTopCanopy > side->zc[k-1]) {
 5403:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5404:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5405: 
 5406:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5407: 
 5408:                      const double vmag2 = length(ut2);
 5409:                      const double vmag1 = length(side->u2[k-1]);
 5410:                      const double vmag = 0.5*(vmag1 + vmag2);
 5411: 
 5412:                      // Computes the vegetation alpha at the face center
 5413:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5414:                      cff1 += veg_alpha_sd*dt*vmag;
 5415:                   } // if zTopCanopy
 5416: 
 5417:                } // if iveg
 5418: 
 5419:                const double dzz = side->Dz(k);
 5420:                const double tmp = dt*dfz/dzz;
 5421:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5422: 
 5423:                alow[kin] += cff1*dzz/6.0 - tmp;
 5424:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5425: 
 5426:             } else { // Bottom boundary
 5427:                // This occurs at the bottom, where the bottom drag is applied.
 5428: 
 5429:                bdia[kin] += dt*side->chi2; // XXXX
 5430: 
 5431:             } // if (k > kb + 1)
 5432: 
 5433: 
 5434:          } // for (int k
 5435: 
 5436: 
 5437: 
 5438:          // Computes the RHS.
 5439:          // -----------------
 5440: 
 5441:          //	BC to be imposed at the end.
 5442: 
 5443:          const Vector2 gradETP  = side->gradETP;
 5444:          const Vector2 gradPr   = side->gradPr;
 5445:          const Vector2 gradEta1 = side->gradEta1;
 5446:          const Vector2 gradEta2 = side->gradEta2;
 5447: 
 5448:          const Vector2 *btu = side->btu;
 5449:          const Vector2 *u2  = side->u2;
 5450:          const double coriolis = side->coriolis;
 5451:          const Vector2 *nuGradU = side->nuGradU;
 5452: 
 5453: 
 5454:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5455: 
 5456:          for (int k = kb + 1; k < nvrt; k++) {
 5457:             const int kin = k - kb - 1;
 5458: 
 5459:             const double dz_0 = side->Dz(k);
 5460:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5461: 
 5462:             rrhs[kin] = {0.0, 0.0};
 5463:             double dz = 0.0;
 5464: 
 5465:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5466:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5467:             if (k < nvrt  ) dz += dz_1;
 5468:             if (k > kb + 1) dz += dz_0;
 5469: 
 5470:             // Elevation gradient, atmospheric pressure and tidal potential
 5471:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5472: 
 5473:             // Coriolis, advection, wind stress, and horizontal viscosity
 5474:             if (k < nvrt - 1) {
 5475: 
 5476: 
 5477:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5478:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5479:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5480:                                                 
 5481: 
 5482:                //diff stress tensors 1006
 5483:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5484:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5485:                   assert(false && "Not implemented: itur == 5");
 5486:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5487:                }
 5488: 
 5489:             } else { // k == nvrt - 1 SURFACE
 5490:                Vector2 tau2 = {0.0, 0.0};
 5491:                if constexpr(ics==1) {
 5492:                   tau2 = side->tau();
 5493:       
 5494:                } else {
 5495:                   assert(false && "Not implemented: ics == 2");
 5496:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5497:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5498:                   // taux2=(vn1+tt1)*0.5d0
 5499:                   // tauy2=(vn2+ss1)*0.5d0
 5500:                } // if ics
 5501: 
 5502:                rrhs[kin] += dt*tau2;
 5503: 
 5504:             } // if k<nvrt
 5505: 
 5506:             if (k > kb + 1) {
 5507:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5508:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5509:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5510: 
 5511:                // diff stress tensors 1006
 5512:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5513:                   assert(false && "Not implemented: itur == 5");
 5514:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5515:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5516:                }
 5517: 
 5518:             } // if k>kbs + 1
 5519: 
 5520:             // Baroclinic
 5521:             Vector2 *bcc = side->bcc;
 5522:             if constexpr(ibc == 0) {
 5523:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5524:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5525: 
 5526:             } // if ibc==0
 5527: 
 5528:          } // k=kb + 1,nvrt
 5529: 
 5530: 
 5531:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5532: 
 5533:          for (int k = kb + 1; k < nvrt; k++) {  // YYYYYYYYY can be kb 
 5534:             const int kin = k - kb - 1;
 5535: 
 5536:             // Velocity is always clamped to maximum values
 5537:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5538:          } // k
 5539: 
 5540:       } // if side->is2D()
 5541:       
 5542: 
 5543:       // Impose velocity boundary condition at the bottom
 5544:       if constexpr(imm == 2) { // 3D bed deformation model
 5545:          double dep;
 5546:          Vector2 vel;
 5547: 
 5548:          assert(false && "Not implemented: imm == 2");
 5549:          //update_bdef(time, x0, y0, dep, vel);
 5550:          // side->u2[kb] = vel;
 5551: 
 5552:       } else { // imm = 0 or 1
 5553:          if (side->Cd() == 0.0) {
 5554:             side->u2[kb] = side->u2[kb + 1];
 5555: 
 5556:          } else if (side->is3D()) { // 3D no slip bottom   
 5557:             side->u2[kb] = {0.0, 0.0};
 5558:          }
 5559:           
 5560:       } // if imm
 5561: 
 5562:       // The velocities below the bottom level are set to zero
 5563:       for (int k = 0; k <= kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5564: 
 5565: 
 5566:    }
 5567: 
 5568: 
 5569:    __global__ void applyMomentumBC(void) {
 5570: 
 5571:       SIDE_BND(sideBnd);
 5572: 
 5573:       Side *side = sideBnd->side;
 5574:       const BoundarySegment *segment = sideBnd->segment;
 5575:       const Node *n1 = side->n1;
 5576:       const Node *n2 = side->n2;
 5577: 
 5578:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5579: 
 5580:       const bool isLand = segment->isLand;
 5581:       const int ifltype = segment->ifltype;
 5582: 
 5583:       const int kb = side->kb;
 5584: 
 5585:       if (!isLand && ifltype != 0) {
 5586:          const Vector2 *ubc = sideBnd->ubc;
 5587:   
 5588:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5589:             
 5590:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5591:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5592: 
 5593:             if (ifltype == -1) {
 5594:                // Flather 1
 5595: 
 5596:                const double depth = side->depth();
 5597: 
 5598:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5599: 
 5600:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5601: 
 5602:                side->u2[k] = vnorm*side->n;
 5603: 
 5604:             } else if (ifltype == -2) { // Discharge
 5605: 
 5606:                const double eta1 = side->eta1();
 5607:                const double eta2 = side->eta2();
 5608:                const double htot = side->htot2();
 5609: 
 5610:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5611:                assert(false && "Not implemented: Discharge bc");
 5612:                // const double dischrg = discharge(eta1);
 5613:                const double dischrg = 0.0; // XXX REMOVE
 5614:                
 5615: 
 5616:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5617: 
 5618:                const double vnorm = dischrg*eta2/htot;
 5619: 
 5620:                side->u2[k] = vnorm*side->n;
 5621: 
 5622:             }
 5623:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5624:                const double vnorm = dot(side->u2[k], side->n);
 5625: 
 5626:                double rat;
 5627:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5628:                else              rat = segment->vobc2; // outgoing
 5629: 
 5630:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5631: 
 5632:             }
 5633:             else { // not Flather or 3D radiation
 5634:                side->u2[k] = ubc[k];
 5635: 
 5636:             } // if (segment->ifltype...
 5637: 
 5638:          }
 5639: 
 5640:       }
 5641:       else if (isLand) { // if it is land boundary side
 5642: 
 5643:          if constexpr(islip == 0) { // free slip
 5644: 
 5645:             for (int k = kb; k < nvrt; k++) {
 5646: 
 5647:                const Vector2 t = side->t();
 5648:                const Vector2 n = side->n;
 5649: 
 5650:                double vnorm = 0.0; // for most cases
 5651:                const double vtan = dot(side->u2[k], t);
 5652:                
 5653:                side->u2[k] = vtan*t - vnorm*n;
 5654: 
 5655:             }
 5656: 
 5657:          } else { // no slip
 5658:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5659: 
 5660:          }
 5661:       } // if (side segment type...
 5662: 
 5663:    
 5664: 
 5665:    }
 5666: 
 5667: 
 5668:    __global__ void shapiroFilter1(void) {
 5669:       // First step of the Shapiro filter (normally used if indvel<=0)
 5670:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5671: 
 5672:       SIDE(side);
 5673: 
 5674:       // Only internal wet sides are processed
 5675:       if (side->isDry || !(side->isInternal())) return;
 5676: 
 5677:       const int kb = side->kb;
 5678: 
 5679:       for (int mm = 0; mm < niter_shap; mm++) {
 5680: 
 5681:          for (int k = kb + 1; k < nvrt; k++) {
 5682:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5683:             Vector2 suru = {0.0, 0.0};
 5684: 
 5685:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5686: 
 5687:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5688: 
 5689:                int kin = k;
 5690:                if (!(nSide->isDry)) kin = max(k, kb + 1);
 5691:                
 5692:                if constexpr(ics==1) {
 5693:                   suru += nSide->u2[kin];
 5694: 
 5695:                } else {
 5696:                   assert(false && "Not implemented: ics == 2");
 5697:                   // Vector2 vn1, vn2;
 5698:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5699:                   // suru=suru+vn1;
 5700:                   // surv=surv+vn2;
 5701:                }
 5702:             }
 5703: 
 5704: 
 5705:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5706: 
 5707:          }
 5708:       }
 5709:    }
 5710: 
 5711:    __global__ void shapiroFilter2(void) {
 5712:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5713: 
 5714:       SIDE(side);
 5715: 
 5716:       if (side->isDry || !(side->isInternal())) return;
 5717: 
 5718:       const int kb = side->kb;
 5719: 
 5720:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5721: 
 5722:       if (side->is2D()) {
 5723:          side->u2[kb + 1] = side->bcc[kb + 1];
 5724:          side->u2[kb    ] = side->u2 [nvrt - 1];
 5725: 
 5726:       } else {
 5727:          // 3D
 5728:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5729:          
 5730:       }
 5731: 
 5732:    }
 5733: 
 5734: 
 5735:    __global__ void ul0UpdateZCoords(void) {
 5736:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5737:       
 5738:       NODE(node);      
 5739: 
 5740: 
 5741:       if (node->isDry2()) { 
 5742: 
 5743:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 5744: 
 5745:          if constexpr(ivcor != 1) node->kb = 0;
 5746: 
 5747:       } else {
 5748: 
 5749:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 5750:          node->updateKb();
 5751: 
 5752:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5753: 
 5754:       }
 5755: 
 5756:       // We use the temp.b field to store the previous state of isDry.
 5757:       node->tmp.b = node->isDry;
 5758: 
 5759:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5760:       node->isDry = true;
 5761: 
 5762:    }
 5763: 
 5764:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5765:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5766:    {
 5767:       ELEM(elem);
 5768: 
 5769:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5770: 
 5771:       // All the nodes of a wet element are wet.
 5772:       if (!elem->isDry) {
 5773:          elem->nodes[0]->isDry = false;
 5774:          elem->nodes[1]->isDry = false;
 5775:          elem->nodes[2]->isDry = false;
 5776:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 5777: 
 5778:       }
 5779: 
 5780: 
 5781:       elem->kb = 0;
 5782: 
 5783:       if (elem->isDry) return;
 5784: 
 5785:       // Wet
 5786:       const Node *n1 = elem->nodes[0];
 5787:       const Node *n2 = elem->nodes[1];
 5788:       const Node *n3 = elem->nodes[2];  
 5789:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5790: 
 5791:    //    if(elem->isDry2()) { // XXXX
 5792:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5793:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5794:    //        call parallel_abort(errmsg)
 5795:    //    }
 5796: 
 5797: 
 5798:       // Computes element's kb as the minimum of the nodes' kb.
 5799:       const int kb1 = n1->kb;
 5800:       const int kb2 = n2->kb;
 5801:       const int kb3 = n3->kb;
 5802:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5803: 
 5804: 
 5805:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5806: 
 5807: 
 5808:       // Computes the element z as the mean of the nodes z.
 5809:       for (int k = elem->kb; k < nvrt; k++) {
 5810: 
 5811:          // Compute the element z as the mean of the nodes z.
 5812:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5813:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5814:          elem->z[k] /= elem->i34;
 5815: 
 5816:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5817:       }
 5818:                   
 5819:    }
 5820: 
 5821:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5822:    {
 5823:       NODE(node);
 5824:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5825: 
 5826:       if (it == iths) return;
 5827: 
 5828: 
 5829:       if(!node->isDry && node->tmp.b) { // rewetted
 5830:          for (int k=0; k < nvrt; k++) {
 5831: 
 5832:             Vector3 utmp={0.0, 0.0, 0.0};
 5833: 
 5834:             double ttmp=0.0;
 5835:             double stmp=0.0;
 5836:             int icount=0;
 5837:             for (int j = 0; j < node->numNodes; j++) {
 5838: 
 5839: 
 5840:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5841:                if (!node->isDry) { // all indices extended
 5842:                   icount++;
 5843: 
 5844:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5845:                   utmp += node->uvw2(k);
 5846:                   
 5847:                   ttmp += node->tracers[k].tracer[0]; 
 5848:                   stmp += node->tracers[k].tracer[1]; 
 5849:                }
 5850:             }
 5851: 
 5852:             if(icount > 0) {
 5853:                const double inv_icount = 1.0/icount;
 5854:                node->u2[k]     = {inv_icount*utmp.x, inv_icount*utmp.y};
 5855:                node->w2[k]     = inv_icount*utmp.z;
 5856:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5857:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5858:             }
 5859:          }
 5860:       }
 5861:    }
 5862: 
 5863: 
 5864:    __global__ void ul0UpdateSides(int it, int iths) {
 5865: 
 5866:       SIDE(side);
 5867: 
 5868:       // A side is wet if and only if at least one of its elements is wet.
 5869:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5870:  
 5871:       const Node *n1 = side->n1;
 5872:       const Node *n2 = side->n2;
 5873:      
 5874:       const int kb1 = n1->kb;
 5875:       const int kb2 = n2->kb;
 5876: 
 5877:       side->kb = 0; // dry
 5878: 
 5879:       if (isWet) {
 5880: 
 5881:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5882: 
 5883:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5884: 
 5885:          side->kb = min(kb1, kb2);
 5886: 
 5887:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 5888: 
 5889:          for (int k = side->kb; k < nvrt; k++) {
 5890:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5891: 
 5892:          
 5893:             assert(((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0)) && "Weird side (3)");
 5894: 
 5895:             // Compute velocity for re-wetted sides 
 5896:             if ((it != iths) && (side->isDry && isWet)) {
 5897:             
 5898:                Vector2 utmp={0.0, 0.0};
 5899: 
 5900:                int icount=0;
 5901: 
 5902:                // For all the sides on the two elements that share this side
 5903:                for (int j=0; j < 2; j++) {
 5904:                   const Element *elem = side->elems[j];
 5905:                   if (elem == nullptr) continue;
 5906: 
 5907:                   for (int jj=0; jj < elem->i34; jj++) {
 5908:                      const Side *nSide = elem->sides[jj];
 5909:                      if (nSide->isDry) continue;
 5910: 
 5911:                      icount++;
 5912:                      utmp += nSide->u2[k];                     
 5913:                   }
 5914:                }
 5915:                   
 5916:                assert(icount > 0 && "No wet sides around this side");
 5917:                if (icount > 0)  side->u2[k] = utmp/icount;
 5918:                   
 5919:             } // if ((it != iths) && (side->isDry && isWet))
 5920: 
 5921:          } // for k
 5922: 
 5923:       } // if isWet
 5924:    
 5925:       side->isDry = !isWet;
 5926: 
 5927:    }
 5928: 
 5929: 
 5930:    __global__ void zeroNodalVelocities(void) {
 5931:       NODE(node);
 5932: 
 5933:       for (int k = 0; k < nvrt; k++) {
 5934:          node->u2[k]   = {0.0, 0.0};
 5935:          node->w2[k]   = 0.0;
 5936:          node->utmp[k] = {0.0, 0.0};
 5937:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5938:       }
 5939:    }
 5940: 
 5941:  
 5942: 
 5943:    __global__ void computeNodalVerticalVelocities1(void) {
 5944:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5945:    // Adds the element's vertical velocity times the element's area.
 5946:       ELEM(elem);
 5947: 
 5948:       for (int j = 0; j < elem->i34; j++) {
 5949:          Node *node = elem->nodes[j];
 5950: 
 5951:          for (int k = node->kb; k < nvrt; k++) {
 5952:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 5953:          }
 5954:          atomicAdd(&(node->tmp.d), elem->area);
 5955:       }
 5956:    }
 5957: 
 5958:    __global__ void computeNodalVerticalVelocities2(void) {
 5959:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5960:    // Divides by the total area of the elements sharing the    node.
 5961:       NODE(node);
 5962: 
 5963:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5964:    }
 5965: 
 5966: 
 5967:    __global__ void computeNodalHorizontalVelocities1(void) {
 5968:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 5969:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 5970: 
 5971:       ELEM(elem);
 5972: 
 5973:       const int kb = elem->kb;
 5974:       const bool isTri = elem->isTri();
 5975: 
 5976:       if constexpr(indvel <= 0) {
 5977:          // Assuming discontinoius hvel.
 5978: 
 5979: 
 5980:          if (isTri) { // For triangles
 5981:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 5982:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 5983: 
 5984:             for (int j = 0; j < 3; j++) {
 5985:                // For every node of the triangle...
 5986:                Node *node = elem->nodes[j];
 5987: 
 5988:                const Side *s1 = elem->sides[j];
 5989:                const Side *s2 = elem->sides[(j + 1) % 3];
 5990:                const Side *s3 = elem->sides[(j + 2) % 3];
 5991: 
 5992:                const int numElements = node->numElements;
 5993:                const double inv_numElements = 1.0/numElements;
 5994: 
 5995:                for (int k = kb; k < nvrt; k++)  {
 5996:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated at the node   
 5997:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 5998:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 5999:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 6000:                   atomicAdd(&(node->utmp[k].x), inv_numElements * u.x);
 6001:                   atomicAdd(&(node->utmp[k].y), inv_numElements * u.y);
 6002: 
 6003:                }
 6004: 
 6005:             }
 6006:          }
 6007:          else { // For quads
 6008:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6009: 
 6010:          }
 6011: 
 6012:       }
 6013:       
 6014:    }
 6015: 
 6016: 
 6017:    __global__ void computeNodalHorizontalVelocities2(void) {
 6018:       NODE(node);
 6019: 
 6020:       for (int k = 0; k < nvrt; k++) {
 6021:          node->u2[k] = node->utmp[k];
 6022:          node->w2[k] = node->w2[k];
 6023:       }
 6024:       
 6025:    }   
 6026: 
 6027:    __global__ void computeNodalHorizontalVelocitiesOLD(void) {
 6028:    // XXXX I'm not sure where I got this function from. 
 6029:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 6030:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 6031:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 6032:    // It uses the utmp array as a temporary array to store the velocities.
 6033: 
 6034:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 6035: 
 6036:       SIDE(side);
 6037: 
 6038:       const int kb = side->kb;
 6039: 
 6040:       Node *n1 = side->n1;
 6041:       Node *n2 = side->n2;
 6042: 
 6043:       for (int k = kb; k < nvrt; k++) {
 6044: 
 6045:          // Cast the u2 vector into a Vector2 
 6046:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&(n1->utmp[k]));
 6047:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&(n2->utmp[k]));
 6048: 
 6049:          n1_u2 = side->u2[k]/n1->numSides;
 6050:          n2_u2 = side->u2[k]/n2->numSides;
 6051: 
 6052:       }
 6053: 
 6054: 
 6055:    }
 6056: 
 6057:    __global__ void resetVelocityOpenBndNodes(void) {
 6058:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6059: 
 6060:       NODE_BND(nodebnd);
 6061: 
 6062:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6063:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }
 6064:       }
 6065: 
 6066:    }
 6067: 
 6068: 
 6069:    __global__ void setVelocityOpenBndNodes(void) {
 6070:    // For open boundary nodes sets their velocity to the imposed values.
 6071: 
 6072:       SIDE_BND(sidebnd);
 6073: 
 6074:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6075:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6076:          // to its segment to the average of the side velocity.
 6077: 
 6078:          for (int k = 0; k < nvrt; k++) {
 6079:             Node *n1 = sidebnd->side->n1;
 6080:             Node *n2 = sidebnd->side->n2;
 6081: 
 6082: 
 6083:             Vector2 n1_u2(n1->u2[k]);
 6084:             Vector2 n2_u2(n2->u2[k]);
 6085: 
 6086:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6087:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6088:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6089:             }
 6090:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6091:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6092:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6093:             }
 6094: 
 6095:          }
 6096: 
 6097:       }
 6098: 
 6099:    }
 6100: 
 6101: 
 6102:    __global__ void computeVerticalVelocity(void) {
 6103:       // Computes the vertical velocity at the (2D) element's centroid.
 6104:       // In this function we will be considering volumetric elements, with side faces and a 
 6105:       // bottom and a top face. We will call them SFs, BF and TF.
 6106:       // It computes the flux coming from BF and the SFs.
 6107:       // If the bed is moving, it takes that into account.
 6108:       // Since water is incompressible, the integral of the velocity times the normal vector
 6109:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6110:       // and the BF is equal to the flux going out from the TF.
 6111:       // TF = - BF - sum(SFs).
 6112:       // It then computes the horizontal velocity at the center of TF.
 6113:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6114:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6115:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6116: 
 6117:       ELEM(elem);
 6118: 
 6119:       if (elem->isDry) return;
 6120: 
 6121:       const int kb = elem->kb;
 6122:       const bool isTri = elem->isTri();
 6123: 
 6124:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6125: 
 6126:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6127:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6128:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6129: 
 6130:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6131: 
 6132:       double area3D;
 6133: 
 6134:       // Bottom face flux
 6135:       double bottomFlux = 0.0;
 6136:       Vector2 u2meanBottom = {0.0, 0.0};
 6137:       const Vector2 gradh = elem->grad2(&Node::depth);
 6138:       if constexpr(imm==2) {
 6139:          Vector3 ubed;
 6140: 
 6141:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6142:          // updateBDEF(ubed);
 6143:      
 6144:          // const double bflux0 = dot(ubed, elem_n1);
 6145: 
 6146:          // elem->w[kb] += ubed.z;
 6147:       }
 6148:       else {
 6149:          Vector2 umean;
 6150:          if constexpr(ics == 1) {
 6151:             u2meanBottom = elem->mean(kb, &Side::u2);
 6152:          }
 6153:          else {
 6154:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6155:          }
 6156: 
 6157:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6158:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6159: 
 6160:          bottomFlux = - dot(gradh, u2meanBottom);
 6161:       } // if imm
 6162: 
 6163:       // Compute w for kb+1 to nvrt-1
 6164:       for (int l = kb; l < nvrt - 1; l++) {
 6165: 
 6166:          // normal vector to the top face of the "volumetric" element (3D)
 6167:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6168: 
 6169:          // Compute the total flux at the sides
 6170:          double sideFlux = 0.0;
 6171:          Vector2 u2top = {0.0, 0.0};
 6172:          for (int j = 0; j < elem->i34; j++) {
 6173:             const Side *side = elem->sides[j];
 6174: 
 6175:             const double sideArea = side->area(l);
 6176:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6177:             const double sign = elem->ssign[j]; 
 6178: 
 6179:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6180:          }
 6181:          
 6182:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6183:          //velocities at the centers of the sides
 6184:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6185: 
 6186:          // The flx at the top ace can be computed from the other flows.
 6187:          const double topFlux = - sideFlux - bottomFlux;
 6188:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6189: 
 6190:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6191: 
 6192:          elem_n1 = elem_n2;
 6193: 
 6194:          bottomFlux = - topFlux;
 6195:       }
 6196:    }  
 6197: 
 6198: 
 6199: 
 6200: 
 6201: 
