 2234:    __forceinline__ __device__ void Element::projectNodeVectorsToElementFrame(Vector2 *v) const {
 2235:    // Project the vectors from the node frame to the element frame
 2236: 
 2237:  
 2238:       v[0] = nodes[0]->frame.projHorVec(v[0], frame);
 2239:       v[1] = nodes[1]->frame.projHorVec(v[1], frame);
 2240:       v[2] = nodes[2]->frame.projHorVec(v[2], frame);
 2241:       if (isQuad()) v[3] = nodes[3]->frame.projHorVec(v[3], frame);
 2242:       else          v[3] = Vector2();
 2243:    }
 2244: 
 2245:    __forceinline__ __device__ void Element::projectSideVectorsToElementFrame(Vector2 *v) const {
 2246:    // Project the vectors from the side frame to the element frame
 2247: 
 2248:       v[0] = sides[0]->frame.projHorVec(v[0], frame);
 2249:       v[1] = sides[1]->frame.projHorVec(v[1], frame);
 2250:       v[2] = sides[2]->frame.projHorVec(v[2], frame);
 2251:       if (isQuad()) v[3] = sides[3]->frame.projHorVec(v[3], frame);
 2252:       else          v[3] = Vector2();
 2253:    }
