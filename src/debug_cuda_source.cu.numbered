 8141: __global__ void printMatrix(bool full) {
 8142:    // Debugging: print the matrix
 8143: 
 8144:    const int size = mesh->np;
 8145:    double sum = 0.0;
 8146:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8147:       const Node *node = mesh->localNodeData + idx_node;
 8148:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 8149:       for (int j = 0; j < node->numNodes; j++) {
 8150:          Node* nbNode = node->nodes[j];
 8151:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 8152:          sum += node->coeffMatrix[j];
 8153:       }
 8154:       if (full) printf("]\n");
 8155: 
 8156: 
 8157:    }
 8158:    if (!full) printf("sum=%lf\n", sum);
 8159: }
