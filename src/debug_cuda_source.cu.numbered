 1969: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 1970: // return;   
 1971:    // Lock the mutex
 1972:    lock(&debugPlotMutex);
 1973:  
 1974:    bool ok = true;
 1975:    if (debugPlotIdx == nullptr) ok = false;
 1976:    if (*debugPlotIdx >= 1000000) ok = false;
 1977:    if (ok) {
 1978:       debugPlot[(*debugPlotIdx) + 0*1000000] = x1.x;
 1979:       debugPlot[(*debugPlotIdx) + 1*1000000] = x1.y;
 1980:       debugPlot[(*debugPlotIdx) + 2*1000000] = x2.x;
 1981:       debugPlot[(*debugPlotIdx) + 3*1000000] = x2.y;
 1982:       debugPlot[(*debugPlotIdx) + 4*1000000] = (double)color;
 1983:       debugPlot[(*debugPlotIdx) + 5*1000000] = (double)(((int)(unsigned char)marker & 0xFF) | ((dashLen & 0xFF) << 8) | ((width & 0xFF) << 16));
 1984:       debugPlot[(*debugPlotIdx) + 6*1000000] = (double)label;
 1985:       (*debugPlotIdx)++;
 1986:    }
 1987: 
 1988:    __threadfence();               // ensure all above writes are visible
 1989:    // Unlock the mutex
 1990:    unlock(&debugPlotMutex);
 1991: 
 1992: }
 1993: 
 1994: __device__ void addDebugPlot(Vector2 x1, Vector2 x2, unsigned int color = 0xA0A0A0, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 1995:    addDebugPlot(toPoint3(x1, 0.0), toPoint3(x2, 0.0), color, marker, width, dashLen, label);
 1996: }
