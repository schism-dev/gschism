 9995: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 9996:    Element *elems = mesh->localElemData;
 9997: 
 9998:    *addr = elems;
 9999:    *sizeElement = sizeof(Element);
10000:    switch (varCode) {
10001:       case (int)VarCode::z:
10002:          *offset = (int)((char*)&elems[0].z - (char*)elems);
10003:          *sizeType = sizeof(double);
10004:          break;
10005:       case (int)VarCode::x:
10006:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
10007:          *sizeType = sizeof(Vector2);
10008:          break;
10009:       case (int)VarCode::gradETP:
10010:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
10011:          *sizeType = sizeof(Vector2);
10012:          break;
10013:       case (int)VarCode::area:
10014:          *offset = (int)((char*)&elems[0].area - (char*)elems);
10015:          *sizeType = sizeof(double);
10016:          break;
10017:       case (int)VarCode::depth:
10018:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
10019:          *sizeType = sizeof(double);
10020:          break;
10021:       case (int)VarCode::radius:
10022:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
10023:          *sizeType = sizeof(double);
10024:          break;
10025:       case (int)VarCode::ghat:
10026:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
10027:          *sizeType = sizeof(Vector2);
10028:          break;
10029:       case (int)VarCode::kb:
10030:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
10031:          *sizeType = sizeof(int);
10032:          break;
10033:       case (int)VarCode::isdry:
10034:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
10035:          *sizeType = sizeof(int);
10036:          break;            
10037:       case (int)VarCode::w:
10038:          *offset = (int)((char*)&elems[0].w - (char*)elems);
10039:          *sizeType = sizeof(double);
10040:          break;
10041:       case (int)VarCode::FaceIndices:
10042:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
10043:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
10044:          *sizeType = sizeof(Node);
10045:          break;
10046:       default:
10047:          *offset = -1;
10048:    }
10049: }
