  899:    
  900:    // Elevation boundary condition
  901:    int iettype;  // Type of elevation boundary condition
  902:    double eth;   // Elevation time history
  903: 
  904:    // Flow boundary condition
  905:    double qthcon;  // Flow time history constant
  906:    double vobc1;   // Velocity coefficient 1
  907:    double vobc2;   // Velocity coefficient 2
  908: 
  909:    // Tracer boundary conditions
  910:    // double trobc[natrm];    // Tracer boundary condition nudging factor
  911:    // int  itrtype[natrm];    // Tracer boundary condition type
  912: 
  913:    BoundarySegment(bool _isLand) {
  914:       isLand = _isLand;
  915:       clen = 0.0;
  916:       carea = 0.0;
  917:       ifltype = 0;
  918:       iettype = 0;
  919:       eth = 0.0;
  920:    }
  921: 
