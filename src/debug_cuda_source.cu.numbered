 3726: 
 3727: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3728:    // Computes the z coordinate at level k.
 3729:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3730:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3731:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3732:    // used 
 3733: 
 3734:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3735:    
 3736:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3737: 
 3738:    if (isDry2()) return 0.0;  
 3739: 
 3740:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3741: 
 3742:    if constexpr(ivcor == 2) {
 3743: 
 3744:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3745:       const double h_c = mesh->h_c;
 3746:       const double theta_f = mesh->theta_f;
 3747:       const double sinh_theta_f = mesh->sinh_theta_f;
 3748: 
 3749: 
 3750:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3751:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3752:       // once per time step/node. XXXX
 3753:       // CHECK: updateZCoordData
 3754: 
 3755:       //  To simplify comparisons, I define index versions of count variables.
 3756:       if      (k == ivrt)     return eta2; 
 3757:       else if (k == izlev)    return -hmod2;
 3758:       else if (k == kb)       return -depth;
 3759:       else if (k < izlev)     return mesh->ztot[k];
 3760:       else if (k > izlev) {
 3761:          const int ksig = k - izlev;
 3762: 
 3763:          if (hmod2 <= h_c) {
 3764:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3765: 
 3766:          } 
 3767:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3768:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3769:             assert(false && "compZCoord: invalid h_c\n");
 3770:          } 
 3771:          else {
 3772:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3773:                    h_c * mesh->sigma[ksig] + 
 3774:                    (hmod2 - h_c) * mesh->cs[ksig];
 3775:          }
 3776:       } else { 
 3777:          assert(false && "compZCoord: invalid level or coordinate system\n");
 3778:       }
 3779: 
 3780:    }
 3781:    else {  // if constexpr(ivcor == 1)
 3782:       if (k <= kb)        return -depth; 
 3783:       else if (k == ivrt) return eta2;
 3784:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3785: 
 3786:    }
 3787:    
 3788:    assert(false && "compZCoord: invalid level or coordinate system\n");
 3789:    return 0.0;
 3790: }
 3791: 
 3792: 
 3793: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3794:    // Computes the bottom drag Cd based on the selected nchi
 3795: 
 3796:    if constexpr(nchi == 0) {
 3797:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3798:       Cd = drag;  // Read from drag file
 3799: 
 3800:    } else if constexpr(nchi == 1) {
 3801:       // 
 3802: 
 3803:       bool ltmp = false; // for WBL iteration
 3804: 
 3805:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3806:       if (isDry || (rough == 0.0)) {
 3807:          Cd = 0.0;
 3808: 
 3809:       } else { //roughness >0 
 3810:          
 3811:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3812: 
 3813:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3814: 
 3815:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3816: 
 3817:       } // if rough
 3818: 
 3819:    } else if constexpr(nchi == -1) {
 3820:    // Manning 
 3821:  
 3822:       const double htot = max(hmin_man, htot2()); 
 3823:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3824: 
 3825:    } else {
 3826:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3827:       
 3828:    } // if nchi
 3829: 
 3830: }
 3831: 
 3832: 
 3833: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3834:    // Checks if a side in on the boundary
 3835:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3836: 
 3837:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3838:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3839: 
 3840:    // Indices of the nodes that form the side
 3841:    const int n1 = side.n1->idx;
 3842:    const int n2 = side.n2->idx;
 3843:    isLand = false;
 3844:    
 3845: 
 3846:    // Check if the side is on a land boundary
 3847:    for (int i = 0; i < nland; i++) {
 3848:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3849:          // Consecutive nodes in the land boundary segment
 3850:          const int b1 = ilnd[i + j*nland];
 3851:          const int b2 = ilnd[i + (j + 1)*nland];
 3852: 
 3853:          assert(b1 != -1 && b2 != -1);
 3854: 
 3855:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3856:             
 3857:             isLand = true;
 3858:             return i;
 3859:          }
 3860:       }
 3861:    }
 3862: 
 3863:    // Check if the side is on an open boundary
 3864:    for (int i = 0; i < nope; i++) {
 3865:       for (int j = 0; j < nond[i] - 1; j++) {
 3866:          // Consecutive nodes in the open boundary segment
 3867:          const int b1 = iond[i + j*nope];
 3868:          const int b2 = iond[i + (j + 1)*nope];
 3869: 
 3870:          assert(b1 != -1 && b2 != -1);
 3871: 
 3872:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3873:             isLand = false;
 3874:             return i;
 3875:          }
 3876:       }
 3877:    }
 3878: 
 3879:    return -1;
 3880: }
 3881: 
 3882: 
 3883: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3884:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3885:                                     double *wind_rotate_angle, 
 3886:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3887:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3888:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3889:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3890:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 3891: 
 3892:    NODE(pnode);  
 3893:    const int i = idx_node;
 3894:    Node &node(*pnode);
 3895: 
 3896:    node.idx = i;
 3897: 
 3898:    const int idxNodeStart = nodeNeighNodesStart[i];
 3899:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3900:    node.numNodes = idxNodeEnd - idxNodeStart;
 3901:    node.nodes = nodeNeighNodes + idxNodeStart;
 3902:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3903: 
 3904: 
 3905: 
 3906:    const int idxElemStart = nodeNeighElemsStart[i];
 3907:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3908:    node.numElements = idxElemEnd - idxElemStart;
 3909:    node.elements = nodeNeighElems + idxElemStart;
 3910: 
 3911: 
 3912:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3913:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3914:       const int partNode = localNodePart[idxNodeGlobal]; 
 3915:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3916: 
 3917:       Node *node_ptr = nodes[partNode] + idxNode;
 3918:       
 3919:       nodeNeighNodes[idx] = node_ptr;
 3920:    }
 3921: 
 3922: 
 3923:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3924:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3925:       const int partElem = localElemPart[idxElemGlobal];
 3926:       const int idxElem  = localElemIndices[idxElemGlobal];
 3927: 
 3928:       Element *elem_ptr = elems[partElem] + idxElem;
 3929: 
 3930:       nodeNeighElems[idx] = elem_ptr;
 3931:    }      
 3932: 
 3933:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 3934:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 3935:    sincosf((float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 3936: 
 3937:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 3938:    if constexpr(ics == 1) {
 3939:       node.p.x   = node_coords[i * 3];
 3940:       node.p.y   = node_coords[i * 3 + 1];
 3941:       node.gz = 0.0;
 3942: 
 3943:    } else {
 3944:       const double lon = deg2rad*node_coords[i * 3];
 3945:       const double lat = deg2rad*node_coords[i * 3 + 1];
 3946: 
 3947:       Point3 p = computeXYZfromLatLon(lat, lon);
 3948:       node.p = toVector2(p);
 3949:       node.gz = p.z;
 3950:       node.lon = lon;
 3951:       node.lat = lat;
 3952: 
 3953:       #ifdef USE_FRAMES
 3954:       node.setFrame(lat, lon);
 3955:       #endif
 3956: 
 3957: 
 3958:    }
 3959: 
 3960:    node.depth = node_coords[i * 3 + 2];
 3961: 
 3962:    node.numSides = 0;
 3963: 
 3964:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3965:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3966:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3967:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3968:    else assert(false && "populateNodes: selected nchi not implemented.");
 3969:    
 3970:    if constexpr(ivcor == 1) 
 3971:    {  
 3972:       node.kb = kb[i];
 3973:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + i*nvrt];
 3974:    }
 3975: 
 3976:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3977:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3978:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3979: 
 3980:    
 3981:    // Links the node to the boundary information
 3982:    if (isbnd[i] >= 0) {
 3983:      
 3984:       // Get the index of the node boundary
 3985:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3986: 
 3987:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3988:       node.nodeBnd->node = &node;
 3989: 
 3990:       node.nodeBnd->sideBnd1 = nullptr;
 3991:       node.nodeBnd->sideBnd2 = nullptr;
 3992: 
 3993:       if (isbnd[i]>=0) {
 3994: 
 3995:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3996:          
 3997:          node.nodeBnd->segment->ifltype = 0 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3998:          node.nodeBnd->segment->iettype = 0; // XXXXXXXXX
 3999: 
 4000:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 4001:          node.nodeBnd->segment->clen  = nan("1");
 4002:          node.nodeBnd->segment->carea = nan("1");
 4003: 
 4004:       }
 4005:    } else {
 4006: 
 4007:       node.nodeBnd = nullptr; // For internal nodes
 4008: 
 4009:       if (isbnd[i] == landSegment) {
 4010:          node.nodeBnd = &landBoundaryNode;
 4011:          node.nodeBnd->segment = &landBoundarySegment;
 4012:       }
 4013:       
 4014:    }
 4015:    
 4016:    // XXXX GAUSSIAN HILL VELOCITIES
 4017:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4018:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4019:          constexpr double rot_per = 3000.0;
 4020:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 4021:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 4022:       // XXXXX
 4023:    #endif
 4024: 
 4025: }
 4026: 
 4027: 
 4028: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 4029:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4030:                                     double *wind_rotate_angle,   
 4031:                                     int *isdel, int *isidenode, int *isbnd,
 4032:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4033:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4034:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4035:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4036:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4037:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 4038:                                     double *drag, double *roughness) {
 4039: 
 4040: 
 4041:    SIDE(pside);
 4042:    Side &side(*pside);
 4043:    const int i = idx_side;
 4044: 
 4045:    side.idx = i;  
 4046:    
 4047:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 4048:    const double fc   = 2.0*omega_e*sin(sfea0);
 4049:    const double beta = 2.0*omega_e*cos(sfea0);
 4050: 
 4051:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 4052: 
 4053:    // finding the pointer to the nodes that form the side
 4054:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 4055:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 4056: 
 4057:    const int locidx_n1 = localNodeIndices[idx_n1];
 4058:    const int locidx_n2 = localNodeIndices[idx_n2];
 4059:    const int part_n1 =   localNodePart[idx_n1];
 4060:    const int part_n2 =   localNodePart[idx_n2];
 4061: 
 4062:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 4063:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 4064: 
 4065: 
 4066:    // Counts the number of sides connected to each node
 4067:    side.n1->numSides++;
 4068:    side.n2->numSides++;
 4069: 
 4070:    // Side boundary type
 4071:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 4072:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 4073: 
 4074:    if (n1bnd != nullptr && n2bnd != nullptr) 
 4075:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 4076:    {
 4077:       bool isLand = false;
 4078:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 4079:       
 4080:       if (isbs > -1) {
 4081:          // assert(isLand || isbs>=0);
 4082:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 4083: 
 4084:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 4085: 
 4086:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 4087:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 4088: 
 4089:          assert (isLand == side.sideBnd->segment->isLand);
 4090: 
 4091:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4092:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 4093:          else                            n1bnd->sideBnd2 = side.sideBnd;
 4094: 
 4095:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 4096:          else                            n2bnd->sideBnd2 = side.sideBnd;
 4097:          
 4098:          side.sideBnd->side = &side;
 4099: 
 4100:       }
 4101:       else {
 4102:          side.sideBnd = nullptr;
 4103:       }
 4104:    }
 4105:    else 
 4106:    {
 4107:       side.sideBnd = nullptr;
 4108:    }
 4109: 
 4110: 
 4111:    // finding the pointer to the elements that share the side
 4112:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 4113:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 4114: 
 4115:    if (idx_e1 > -1) {
 4116:       const int locidx_e1 = localElemIndices[idx_e1];
 4117:       const int part_e1 =  localElemPart[idx_e1];
 4118:       side.elems[0] = elems[part_e1] + locidx_e1;
 4119: 
 4120:    }
 4121:    else {
 4122:       side.elems[0] = nullptr;
 4123:    }
 4124: 
 4125:    if (idx_e2 > -1) {
 4126:       const int locidx_e2 = localElemIndices[idx_e2];
 4127:       const int part_e2 =  localElemPart[idx_e2];
 4128:       side.elems[1] = elems[part_e2] + locidx_e2;
 4129:    }
 4130:    else {
 4131:       side.elems[1] = nullptr;
 4132:    }
 4133: 
 4134:    // Compute the center of the side
 4135:    side.center = 0.5*(side.n1->p + side.n2->p);
 4136: 
 4137:    #ifdef USE_FRAMES
 4138:    side.setFrame();
 4139:    #endif
 4140: 
 4141:    // Normal, unitary vector to the side
 4142:    if constexpr(ics == 1) {
 4143:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4144:       side.n = normalize(side.n);
 4145:    }
 4146:    else {
 4147:       // Unit side vector in 3D cartesian coordinates
 4148:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4149:       nSide = normalize(nSide);
 4150: 
 4151:       // It cross product with the unit local z-axis vector (nUp) is the
 4152:       // normal vector we are looking for.
 4153:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4154: 
 4155:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4156:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4157:       side.n = normalize(n2D);      
 4158: 
 4159:    }
 4160: 
 4161:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4162:    side.shapiro = shapiro0;
 4163: 
 4164:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4165:    // XXXX
 4166:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4167:    constexpr double rot_per=3000.0;
 4168:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4169:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4170:    // XXXXX      
 4171:    #endif
 4172:    // Compute the z level at the center of the side
 4173:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4174:    
 4175:    // Compute the length of the side
 4176:    const Vector2 vLen = side.n2->p - side.n1->p;
 4177:    side.len = sqrt(dot(vLen, vLen));
 4178: 
 4179: 
 4180:    // Compute the Coriolis coefficient
 4181: 
 4182:    if constexpr(ncor == -1 || ncor == 0) {
 4183:       side.coriolis = coricoef;
 4184:    }
 4185:    else {
 4186:       const double sphi = side.lat();  // Latitude at the center of the side
 4187: 
 4188:       assert(use_ll && "use_ll must be true when ncor > 0");
 4189: 
 4190:       if constexpr(ics == 1) {
 4191:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4192:       }
 4193:       else { // ics == 2
 4194:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4195:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4196:       }
 4197: 
 4198:    }
 4199: 
 4200: }
 4201: 
 4202: 
 4203: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4204:    double *node_coords, double *node_coords_ll, bool use_ll,
 4205:    double *wind_rotate_angle,   
 4206:    int *isdel, int *isidenode, int *isbnd,
 4207:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4208:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4209:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4210:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4211:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4212:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4213:    double *drag, double *roughness) {
 4214: 
 4215:    ELEM(pelem);
 4216:    Element &elem(*pelem);
 4217:    const int i = idx_elem;
 4218: 
 4219:    elem.idx = i;
 4220: 
 4221:    for (int j = 0; j < i34[i]; j++) {
 4222:       const int idxNode = elnode[i*4 + j];  
 4223:       const int idxSide = elside[i*4 + j];
 4224:       
 4225:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4226:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4227: 
 4228:       // Find the neighboring element  
 4229:       if (elem.sides[j]->elems[0] == &elem) {
 4230:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4231:       }
 4232:       else {
 4233:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4234:       }
 4235:       
 4236:    }
 4237: 
 4238:    elem.i34 = i34[i];
 4239: 
 4240:    // Compute the barycenter of the element and its depth
 4241:    elem.center = {0.0, 0.0};
 4242:    elem.depth = 1e10;
 4243:    for (int j = 0; j < i34[i]; j++) {
 4244: 
 4245:       elem.center += elem.nodes[j]->p/i34[i];
 4246:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4247:    }
 4248: 
 4249:    #ifdef USE_FRAMES
 4250:    elem.setFrame();
 4251:    #endif
 4252: 
 4253:    elem.area = elem.computeSignedArea(); 
 4254:    elem.radius = sqrt(elem.area)/pi; 
 4255:    
 4256:    // Determines which way the normal vector to each side is oriented.
 4257:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4258:    for (int j = 0; j < i34[i]; j++)  
 4259:    {
 4260:       if (elem.sides[j]->elems[0] == &elem) {
 4261:          elem.ssign[j] =  1.0;
 4262:       }
 4263:       else {
 4264:          elem.ssign[j] = -1.0;
 4265:       }
 4266: 
 4267:    }
 4268: 
 4269:   
 4270: 
 4271:    // Derivatives of shape functions
 4272:    //  For ics=2, this is done in the element frame
 4273:    //  For quads, the derivative is evaluated at centroid
 4274:    for (int j = 0; j < elem.i34; j++) {
 4275:       const double area = elem.area;
 4276:       const int id2 = elem.nxq(1 + j);
 4277:       const int id3 = elem.nxq(2 + j);
 4278:       const int id4 = elem.nxq(3 + j);
 4279:       if (elem.isTri()) {
 4280:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4281:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 4282:          // da1/dx = (y1 - y2)/(2*area)
 4283: 
 4284:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4285:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4286:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4287: 
 4288:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4289:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4290: 
 4291:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4292: 
 4293:       }
 4294:       else  { // Quad; evaluate at centroid
 4295: 
 4296:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4297:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4298:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4299: 
 4300:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4301:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4302: 
 4303:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4304:       } // if Tri
 4305: 
 4306:    } // for j   
 4307:    
 4308:    
 4309: 
 4310: }
 4311: 
 4312: 
 4313: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4314:                                             double *emo, double *efa, 
 4315:                                             double *umo, double *ufa, 
 4316:                                             double *vmo, double *vfa,
 4317:                                             int *ifltype, int *iettype) {
 4318: 
 4319:    NODE_BND(nodeBnd);
 4320:    const int idx = idx_node_bnd;    
 4321: 
 4322:    nodeBnd->idx = idx;
 4323: 
 4324:    // Need to find the segment index and the index of the node on the segment
 4325:    int idxNode = -1;
 4326:    int iseg, i;
 4327:    for (iseg = 0; iseg < nope; iseg++) {
 4328:       // for each segment...
 4329:       for (i = 0; i < nond[iseg]; i++) {
 4330:          idxNode = iond[iseg + i*nope];
 4331:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 4332:          
 4333:       }
 4334:    }
 4335: 
 4336:    assert(iseg < nope && "iseg is out of bounds");
 4337: 
 4338: found: // Jumped here when the node was found
 4339: 
 4340:    nodeBnd->isEssentialBC = true;
 4341:    nodeBnd->elbc = 0.0;
 4342: 
 4343:    nodeBnd->segment->ifltype = ifltype[iseg];
 4344:    nodeBnd->segment->iettype = iettype[iseg];
 4345: 
 4346:    for (int jfr = 0; jfr < nbfr; jfr++) {
 4347: 
 4348:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 4349:       nodeBnd->efa[jfr] = efa[idx2];
 4350:       nodeBnd->emo[jfr] = emo[idx2];
 4351:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 4352:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 4353: 
 4354:    }
 4355:         
 4356: 
 4357: }
