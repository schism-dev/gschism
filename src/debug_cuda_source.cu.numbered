 3524:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3525: 
 3526:       NODE_BND(nodeBnd);
 3527: 
 3528:       Node *node = nodeBnd->node;
 3529: 
 3530:       node->ETP = 0.0;
 3531: 
 3532:       for (int j=0; j<ntip; j++) {
 3533: 
 3534:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3535:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3536:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3537: 
 3538:          if constexpr(iloadtide==1) { // loading tide
 3539:             assert(false && "Loading tide not implemented");
 3540:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3541:          }
 3542:          
 3543:       }
 3544:       
 3545:    }
