 3492:    __global__ void scaleGravity(double loadtide_coef) {
 3493: 
 3494: 
 3495:       NODE(node);
 3496: 
 3497:       // SAL option: scale gravity
 3498:       if constexpr(iloadtide==2) {  // simple const
 3499:          node->grav2 = grav*(1.0 - loadtide_coef);
 3500: 
 3501:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3502:         
 3503:           const double depth = max(node->depth, 0.0);
 3504:           const double tmp1 = sqrt(depth);
 3505:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3506:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3507:                              2.6969e-13*depth*depth*depth*tmp1;
 3508:           
 3509:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3510:           
 3511: 
 3512: 
 3513:           node->grav2 = grav*(1.0 - beta_bar);
 3514: 
 3515:       } else {  // iloadtide=0,1
 3516:         node->grav2=grav;
 3517: 
 3518:       }
 3519: 
 3520:       printf("scaleGravity: node(%d)->grav2 = %f\n", node->idx, node->grav2);
 3521:    }
