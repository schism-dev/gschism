 6465:                                  
 6466:   __global__ void populateMesh(int *i34, int *elnode, int *elside,
 6467:                    double *node_coords, double *wind_rotate_angle, 
 6468:                    int *isdel, int *isidenode, int *isbnd,
 6469:                    int *nond, int *nlnd, int *iond, int *ilnd,
 6470:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 6471:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 6472:                    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 6473:                    int *localNodeIndices, int *localElemIndices, int *localSideIndices,
 6474:                    int *localNodePart,    int *localElemPart,    int *localSidePart,
 6475:                    double *emo, double *efa, 
 6476:                    double *umo, double *ufa, 
 6477:                    double *vmo, double *vfa) {
 6478: 
 6479:     mesh->populateMesh(i34, elnode, elside, node_coords, wind_rotate_angle, 
 6480:                        isdel, isidenode, isbnd,
 6481:                        nond, nlnd, iond, ilnd,
 6482:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 6483:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 6484:                        globalNodeIndices, globalElemIndices, globalSideIndices,
 6485:                        localNodeIndices, localElemIndices, localSideIndices,
 6486:                        localNodePart, localElemPart, localSidePart,
 6487:                        emo, efa, umo, ufa, vmo, vfa);
 6488:   }
