 4334: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 4335:                 double *node_coords, double *node_coords_ll, bool use_ll,
 4336:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 4337:                 int *isdel, int *isidenode, int *isbnd,
 4338:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 4339:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4340:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4341:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4342:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4343:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 4344:                 double *drag, double *roughness,
 4345:                 double *emo, double *efa, 
 4346:                 double *umo, double *ufa, 
 4347:                 double *vmo, double *vfa) {
 4348: 
 4349:    printf("Populating mesh for partition %d\n", partNum);
 4350: 
 4351:    // XXXXXX THIS function does almost nothing. 
 4352: 
 4353:    nbs = *sharedIdxSideBoundary + 1;
 4354:    nbp = *sharedIdxNodeBoundary + 1;
 4355: 
 4356:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 4357: 
 4358: }
