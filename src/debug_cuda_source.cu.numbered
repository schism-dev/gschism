 2624: 
 2625: 
 2626: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2627: 
 2628: 
 2629: __device__ void Node::updateKb(void) {
 2630: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2631: 
 2632:    if constexpr(ivcor == 1) return;
 2633: 
 2634: 
 2635:    // Check if node is wet
 2636:    const bool isDry = (htot2() <= h0);  // XXX Check if we are doing this elsewhere
 2637: 
 2638:    if (isDry) return;
 2639: 
 2640:    if constexpr(ivcor == 2) {  // SZ coordinates
 2641:       
 2642:       // Compute bottom level index
 2643:       if (depth <= mesh->h_s) {
 2644:          kb = mesh->kz - 1;
 2645:       } else {
 2646:          kb = -1;
 2647:          int L = 0;
 2648:          int R = mesh->kz - 2;  // We check up to kz-2 since we access i+1
 2649:          
 2650:          while (L <= R) {
 2651:             int M = (R + L) / 2;
 2652: 
 2653:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2654:             
 2655:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2656:                R = M;
 2657:             } else {
 2658:                L = M;
 2659:             }
 2660: 
 2661:             if (R - L == 1) {
 2662:                kb = L;
 2663:                break;
 2664:             }
 2665:          }
 2666:       }
 2667:    } 
 2668: }
 2669: 
 2670: 
 2671: __device__ double Node::compZCoord(int k) const {
 2672:    // Computes the z coordinate at level k.
 2673:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2674:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2675:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2676:    // used 
 2677:    
 2678:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2679:       
 2680:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2681: 
 2682:    if constexpr(ivcor == 2) {
 2683: 
 2684:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2685:       const int kz = mesh->kz;
 2686:       const double h_c = mesh->h_c;
 2687:       const double theta_f = mesh->theta_f;
 2688:       const double sinh_theta_f = mesh->sinh_theta_f;
 2689: 
 2690:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2691:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2692:       // once per time step/node.
 2693:       // CHECK: updateZCoordData
 2694: 
 2695:       if      (k == nvrt-1)      { return eta2; }
 2696:       else if (k == kz)          return -hmod2;
 2697:       else if (k == kb)          return -depth;
 2698:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2699:       else if (k > kz) {
 2700:          const int ksig = k - kz + 1;
 2701: 
 2702:          if (hmod2 <= h_c) {
 2703:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2704:          } 
 2705:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2706:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2707:             assert(false && "ZCOOR: invalid h_c\n");
 2708:          } 
 2709:          else {
 2710:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2711:                          h_c * mesh->sigma[ksig] + 
 2712:                          (hmod2 - h_c) * mesh->cs[ksig];
 2713:          }
 2714:       } else { 
 2715:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2716:       }
 2717: 
 2718:    }
 2719:    else if constexpr(ivcor == 1) {
 2720:       if (k == kb) return -depth;
 2721:       else if (k == nvrt-1) return eta2;
 2722:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2723:    }
 2724:    
 2725:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2726:    return 0.0;
 2727: }
 2728: 
 2729: 
 2730: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2731:    // Checks if a side in on the boundary
 2732:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2733: 
 2734:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2735:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2736: 
 2737:    // Indices of the nodes that form the side
 2738:    const int n1 = side.n1->idx;
 2739:    const int n2 = side.n2->idx;
 2740: 
 2741:    // Check if the side is on a land boundary
 2742:    for (int i = 0; i < nland; i++) {
 2743:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2744:          // Consecutive nodes in the land boundary segment
 2745:          const int b1 = ilnd[i*mnlnd + j];
 2746:          const int b2 = ilnd[i*mnlnd + j + 1];
 2747: 
 2748:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2749:             isLand = true;
 2750:             return i;
 2751:          }
 2752:       }
 2753:    }
 2754: 
 2755:    // Check if the side is on an open boundary
 2756:    for (int i = 0; i < nope; i++) {
 2757:       for (int j = 0; j < nond[i] - 1; j++) {
 2758:          // Consecutive nodes in the open boundary segment
 2759:          const int b1 = iond[i*mnond + j];
 2760:          const int b2 = iond[i*mnond + j + 1];
 2761: 
 2762:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2763:             isLand = false;
 2764:             return i;
 2765:          }
 2766:       }
 2767:    }
 2768:    return -1;
 2769: }
 2770: 
 2771: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2772:                 double *node_coords, double *wind_rotate_angle, 
 2773:                 int *isdel, int *isidenode, int *isbnd,
 2774:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 2775:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2776:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2777:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2778:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2779:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 2780:                 double *emo, double *efa, 
 2781:                 double *umo, double *ufa, 
 2782:                 double *vmo, double *vfa) {
 2783: 
 2784:    printf("Populating mesh for partition %d\n", partNum);
 2785: 
 2786:    // Horizontal grid
 2787:    printf("Processing %d nodes\n", np);    
 2788: 
 2789: 
 2790:    int idxNodeBoundary = 0;  
 2791:    for (int i = 0; i < np; i++)
 2792:    {
 2793:       Node &node = localNodeData[i];
 2794: 
 2795:       node.idx = i;
 2796: 
 2797:       const int idxNodeStart = nodeNeighNodesStart[i];
 2798:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2799:       node.numNodes = idxNodeEnd - idxNodeStart;
 2800:       node.nodes = nodeNeighNodes + idxNodeStart;
 2801:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2802: 
 2803: 
 2804: 
 2805:       const int idxElemStart = nodeNeighElemsStart[i];
 2806:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2807:       node.numElements = idxElemEnd - idxElemStart;
 2808:       node.elements = nodeNeighElems + idxElemStart;
 2809: 
 2810: 
 2811:       
 2812:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2813:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2814:          const int partNode = localNodePart[idxNodeGlobal]; 
 2815:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2816: 
 2817: 
 2818:          Node *node_ptr = nodes[partNode] + idxNode;
 2819:          
 2820:          nodeNeighNodes[idx] = node_ptr;
 2821:       }
 2822: 
 2823:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2824:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2825:          const int partElem = localElemPart[idxElemGlobal];
 2826:          const int idxElem  = localElemIndices[idxElemGlobal];
 2827: 
 2828:          Element *elem_ptr = elems[partElem] + idxElem;
 2829: 
 2830:          nodeNeighElems[idx] = elem_ptr;
 2831:       }      
 2832: 
 2833: 
 2834:       node.wind_angle = wind_rotate_angle[i];
 2835: 
 2836:       // Element **elements; // pointer to the elements connected to this node
 2837:       // int numElements;   // number of elements shared by this node
 2838: 
 2839:       node.p.x   = node_coords[i * 3];
 2840:       node.p.y   = node_coords[i * 3 + 1];
 2841:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2842:       node.depth = node_coords[i * 3 + 2];
 2843: 
 2844:       node.numSides = 0;
 2845: 
 2846: printf("EEEEEE idx = %d, isbnd[i] = %d, node.nodeBnd = %p\n", i, isbnd[i], node.nodeBnd);
 2847:       // Links the node to the boundary information
 2848:       if (isbnd[i] >= 0) {
 2849:        
 2850:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2851:          node.nodeBnd->node = &node;
 2852: 
 2853:          node.nodeBnd->sideBnd1 = nullptr;
 2854:          node.nodeBnd->sideBnd2 = nullptr;
 2855: 
 2856:          if (isbnd[i]>=0) {
 2857: 
 2858:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2859:             
 2860:             node.nodeBnd->segment->ifltype = (isbnd[i]==0)?3:0;
 2861:             node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 2862: 
 2863:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2864:             node.nodeBnd->segment->clen  = nan("1");
 2865:             node.nodeBnd->segment->carea = nan("1");
 2866: 
 2867:          }
 2868: //          else {
 2869: //             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2870: // printf("EEEEEPP isbnd[i] = %d, node.nodeBnd->segment = %p\n", isbnd[i], node.nodeBnd->segment);            
 2871: //          }
 2872:          
 2873:          idxNodeBoundary++;
 2874: printf("EEEEEEhhhh idx = %d, isbnd[i] = %d, idxNodeBoundary = %d\n", i, isbnd[i], idxNodeBoundary);         
 2875:       }
 2876:       else {
 2877:          node.nodeBnd = nullptr; // For internal nodes
 2878: printf("EEEEEQQ isbnd[i] = %d, node.nodeBnd = %p\n", isbnd[i], node.nodeBnd); 
 2879:          if (isbnd[i] == landSegment) {
 2880:             node.nodeBnd = &landBoundaryNode;
 2881:             node.nodeBnd->segment = &landBoundarySegment;
 2882:          }
 2883:          // node.nodeBnd->node = &node;
 2884:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2885:          // // node.nodeBnd = nullptr;
 2886:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2887:         
 2888:       }
 2889: 
 2890:       // XXXX GAUSSIAN HILL VELOCITIES
 2891: #ifdef GAUSSIAN_HILL_VELOCITIES
 2892:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2893:          constexpr double rot_per = 3000.0;
 2894:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 2895:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0}; }
 2896:       // XXXXX
 2897: #endif
 2898:    }
 2899: 
 2900:    nbp = idxNodeBoundary;
 2901: 
 2902:    printf("Processing %d sides\n", ns);
 2903:    int idxSideBoundary = 0;
 2904:    for (int i = 0; i < ns; i++)
 2905:    {
 2906:       Side &side = localSideData[i];
 2907:       side.idx = i;
 2908:       // finding the pointer to the nodes that form the side
 2909:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2910:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2911: 
 2912:       const int locidx_n1 = localNodeIndices[idx_n1];
 2913:       const int locidx_n2 = localNodeIndices[idx_n2];
 2914:       const int part_n1 =   localNodePart[idx_n1];
 2915:       const int part_n2 =   localNodePart[idx_n2];
 2916: 
 2917:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2918:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2919: 
 2920:       // Counts the number of sides connected to each node
 2921:       side.n1->numSides++;
 2922:       side.n2->numSides++;
 2923: 
 2924:       // Normal, unitary vector to the side
 2925:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2926:       side.n = normalize(side.n);
 2927: 
 2928:       // Side boundary type
 2929:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 2930:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 2931: 
 2932:       if (n1bnd != nullptr && n2bnd != nullptr) 
 2933:       // If both nodes are on the boundary, then the side may be on the boundary
 2934:       {
 2935:          bool isLand = false;
 2936:          int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 2937: 
 2938:          if (isbs > -1) {
 2939:             side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2940:             if      ( isLand) side.sideBnd->segment = &landBoundarySegment;
 2941:             else if (!isLand) side.sideBnd->segment = &(localSegmentMem[isbs]);
 2942: 
 2943:             // Links each node boundary to the side boundary using the first available side boundary pointer
 2944:             if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 2945:             else                            n1bnd->sideBnd2 = side.sideBnd;
 2946: 
 2947:             if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 2948:             else                            n2bnd->sideBnd2 = side.sideBnd;
 2949:           
 2950:             side.sideBnd->side = &side;
 2951:             idxSideBoundary++;
 2952: 
 2953:             printf("Here1.5: %d, isbs = %d, isLand = %d, side.sideBnd = %p\n", i, isbs, isLand, side.sideBnd);
 2954:          }
 2955:          
 2956: 
 2957:       // }
 2958:       // 
 2959: 
 2960: 
 2961: 
 2962: 
 2963: //       // XXXX YYYY NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2964: // printf("Here2: %d, idxSideBoundary = %d, side.n1->idx = %d, side.n2->idx = %d\n", i, idxSideBoundary, side.n1->idx, side.n2->idx);      
 2965: //       if (n1bnd != nullptr || n2bnd != nullptr) 
 2966: //       {
 2967: // printf("Here2.5: %d, idxSideBoundary = %d\n", i, idxSideBoundary);           
 2968: //          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2969: // printf("Here2.6: %d, side.sideBnd = %p, n1bnd = %p, n2bnd = %p\n", i, side.sideBnd, n1bnd, n2bnd);           
 2970: // // printf("Here2.7: %d, side.sideBnd->segment = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", i, side.sideBnd->segment, n1bnd->segment, n2bnd->segment);      
 2971: // if (side.sideBnd->segment == nullptr) continue;
 2972: //          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2973: //          else                  side.sideBnd->segment = n2bnd->segment;
 2974: //          side.sideBnd->side = &side;
 2975: //          idxSideBoundary++;
 2976: // printf("EERRREEEE side.sideBnd = %p, n1bnd = %p, n2bnd = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", side.sideBnd, n1bnd, n2bnd, n1bnd->segment, n2bnd->segment);
 2977:       }
 2978:       else side.sideBnd = nullptr;
 2979: 
 2980:       nbs = idxSideBoundary;
 2981: // printf("Here3: %d", i);
 2982:       // finding the pointer to the elements that share the side
 2983:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2984:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2985: 
 2986:       if (idx_e1 > -1) {
 2987:          const int locidx_e1 = localElemIndices[idx_e1];
 2988:          const int part_e1 =  localElemPart[idx_e1];
 2989:          side.elems[0] = elems[part_e1] + locidx_e1;
 2990: 
 2991:       }
 2992:       else {
 2993:          side.elems[0] = nullptr;
 2994:       }
 2995: // printf("Here4: %d", i);
 2996:       if (idx_e2 > -1) {
 2997:          const int locidx_e2 = localElemIndices[idx_e2];
 2998:          const int part_e2 =  localElemPart[idx_e2];
 2999:          side.elems[1] = elems[part_e2] + locidx_e2;
 3000:       }
 3001:       else {
 3002:          side.elems[1] = nullptr;
 3003:       }
 3004: // printf("Here5: %d", i);
 3005: 
 3006: 
 3007:       // Compute the center of the side
 3008:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 3009: 
 3010:       assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3011:       side.shapiro = shapiro0;
 3012: 
 3013: #ifdef GAUSSIAN_HILL_VELOCITIES
 3014: // XXXX
 3015: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3016: constexpr double rot_per=3000.0;
 3017: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3018: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3019: // XXXXX      
 3020: #endif
 3021:       // Compute the z level at the center of the side
 3022:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3023: 
 3024:       // Compute the length of the side
 3025:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 3026:       side.len = sqrt(dot(vLen, vLen));
 3027: 
 3028:    }
 3029: 
 3030:    printf("Processing %d elements\n", ne);
 3031:    for (int i = 0; i < ne; i++)
 3032:    {
 3033:       Element &elem = localElemData[i];
 3034:       elem.idx = i;
 3035:       for (int j = 0; j < i34[i]; j++) {
 3036:          const int idxNode = elnode[i*4 + j];  
 3037:          const int idxSide = elside[i*4 + j];
 3038:          
 3039:          elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3040:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3041: 
 3042: 
 3043: 
 3044:          // Find the neighboring element  
 3045:          if (elem.sides[j]->elems[0] == &elem) {
 3046:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 3047:          }
 3048:          else {
 3049:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 3050:          }
 3051:          
 3052:       }
 3053: 
 3054:       elem.i34 = i34[i];
 3055: 
 3056: // printf("elem = %p, elem.i34 = %d\n", &elem, elem.i34);
 3057: 
 3058:       // Compute the centroid of the element and its depth
 3059:       Vector2 center = {0.0, 0.0};
 3060:       elem.depth = 0.0;
 3061:       for (int j = 0; j < i34[i]; j++) {
 3062:          center += elem.nodes[j]->p2()/i34[i];
 3063:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 3064:       }
 3065:       elem.center.x = center.x;
 3066:       elem.center.y = center.y;
 3067: 
 3068:       // printf("elem = %p, i34 = %d, center = (%f,%f,%f)\n", &elem, elem.i34, elem.center.x, elem.center.y, elem.depth);
 3069:       
 3070:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3071:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3072: 
 3073:       elem.area = elem.computeSignedArea(); 
 3074:       elem.radius = sqrt(elem.area)/pi; 
 3075:       
 3076:       // Determines which way the normal vector to each side is oriented.
 3077:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3078:       for (int j = 0; j < i34[i]; j++)  
 3079:       {
 3080:          if (elem.sides[j]->elems[0] == &elem) {
 3081:             elem.ssign[j] =  1.0;
 3082:          }
 3083:          else {
 3084:             elem.ssign[j] = -1.0;
 3085:          }
 3086: 
 3087:       }
 3088: 
 3089:       // Derivatives of shape functions
 3090:       //  For ics=2, this is done inside element/ll frame XXX
 3091:       //  For quads, the derivative is evaluated at centroid
 3092:       const int i34 = elem.i34;
 3093:       for (int j = 0; j < i34; j++) {
 3094:          const double area = elem.area;
 3095:          const int id2 = elem.nxq(1 + j);
 3096:          const int id3 = elem.nxq(2 + j);
 3097:          const int id4 = elem.nxq(3 + j);
 3098:          if (elem.isTri()) {
 3099:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3100:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3101:             // da1/dx = (y1 - y2)/(2*area)
 3102:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3103:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3104:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3105:          }
 3106:          else  { // Quad; evaluate at centroid
 3107:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3108:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3109:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3110:          } // if Tri
 3111: 
 3112:       } // for j
 3113: 
 3114:    }
 3115: 
 3116: 
 3117:    // Processing the boundary nodes
 3118:    int idx = 0;
 3119:    for (int iseg = 0; iseg < nope; iseg++) {
 3120:       // for each segment...
 3121:       
 3122:       for (int ind = 0; ind < nlnd[iseg]; ind++) {
 3123:          // for each node on the segment...
 3124: 
 3125:          NodeBoundary *nodeBnd = &localNodeBoundaryMem[idx];
 3126: 
 3127:          nodeBnd->isEssentialBC = true;
 3128: ////nodeBnd->iettype = 3; // XXXXXXXXX
 3129:          nodeBnd->elbc = 0.0;
 3130: 
 3131:          for (int jfr = 0; jfr < nbfr; jfr++) {
 3132: 
 3133:             const int idx = iseg*mnond*nbfr + ind*nbfr + jfr;
 3134:             nodeBnd->efa[jfr] = efa[idx];
 3135:             nodeBnd->emo[jfr] = emo[idx];
 3136:             nodeBnd->umo[jfr] = {umo[idx], vmo[idx]};
 3137:             nodeBnd->ufa[jfr] = {ufa[idx], vfa[idx]};
 3138: 
 3139:          }
 3140: 
 3141:          idx++;
 3142:       }
 3143: 
 3144:    }
 3145: 
 3146: }
