 2584: /**
 2585:  * This method performs backtracking from the side center until a time -dt back in time 
 2586:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2587:  * intermediate point.
 2588:  *
 2589:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2590:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2591:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2592:  * remaining time.
 2593:  * 
 2594:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2595:  * 
 2596:  * @param uuint, vvint, wwint: Velocities at the final point
 2597:  * @param jlev: Level at which the backtracking is performed
 2598:  * @param dt, dtbk: Tracking timesteps
 2599:  * @return: True if the backtracking was successful, false otherwise
 2600:  */
 2601: __inline__ __device__ bool Side::btrack(
 2602:       int jlev,
 2603:       double dt,            // Tracking time
 2604:       double dtbk,          // Tracking timestep
 2605:       Vector3 &u_int        // Velocities at the initial point
 2606: ) const {
 2607: 
 2608:    // Start from side center
 2609:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2610: 
 2611:  
 2612:    double time_rm = dt; // Remaining time
 2613: 
 2614: 
 2615:    // // Initialize outputs XXX
 2616:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2617:    //    sclr[i] = 0.0;
 2618:    // }
 2619: 
 2620: 
 2621:    // Initial velocities
 2622:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->w2[jlev] + n2->w2[jlev])};
 2623: 
 2624:    // Find the element that is in the direction opposite to the velocity
 2625:    Element* curElem = findElementTowards(toVector2(u_int));
 2626: 
 2627: 
 2628:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2629:    if (curElem == nullptr) {
 2630:       // Make velocity parallel to the side
 2631:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2632:       // u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2633:       curElem = otherElem(curElem);
 2634:       
 2635:    }
 2636: 
 2637: // Nudges it towards the circumcenter
 2638: // printf("0{{jlev = %d}} side->idx = %d, x0 = %.15e,%.15e,%.15e\n", jlev, idx, x0.x, x0.y, x0.z);
 2639: Vector2 xcirc = {(curElem->nodes[0]->p.x + curElem->nodes[1]->p.x + curElem->nodes[2]->p.x)/3.0,
 2640:                  (curElem->nodes[0]->p.y + curElem->nodes[1]->p.y + curElem->nodes[2]->p.y)/3.0};
 2641: const double eps = 9.013e-3;                 
 2642: x0.x = xcirc.x*eps + (1 - eps)*x0.x;
 2643: x0.y = xcirc.y*eps + (1 - eps)*x0.y;
 2644: 
 2645: 
 2646: 
 2647:    const int MAX_ITERATIONS = 1000; 
 2648:    Element* nextElem = curElem;
 2649:    int iter = 0;
 2650:    while(true) {
 2651: 
 2652:       // Calculate timestep
 2653:       double dtb = min(dtbk, time_rm);
 2654: 
 2655:       // Next point in the backtracking curve
 2656:       Point3 xt = x0 - dtb*u_int;
 2657:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, this);
 2658:       assert(found && "Backtracking failed in btrack");
 2659: 
 2660:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2661: 
 2662:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2663:                       // then time_rm needs to be increased by the unused time.
 2664: 
 2665:       // If the velocity is too small, we stop the backtracking
 2666:       const double vmag = length(toVector2(u_int));
 2667:       if (vmag <= velmin_btrack) break;
 2668: 
 2669:       // The current point becomes the next segment's starting point.
 2670:       x0 = xt;
 2671:  
 2672:       curElem = nextElem;
 2673: 
 2674:       iter++;
 2675:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2676:    }
 2677: 
 2678: 
 2679: }
 2680: 
 2681: 
