 5209: // __device__ void vertLinearInterp(double zt, int k1, int k2, double *za, double *s_in, double *s_out, int *ibelow) {
 5210: // //     Routine to do vertical linear interpolation in z
 5211: // //     Inputs:
 5212: // //
 5213: // //       k1,k2: lower and upper limits for za, s_in 
 5214: // //       zt: desired interpolation level
 5215: // //       za[0:nvrt-1]: z-coordinates for s_in (must be in ascending order)
 5216: // //       s_in[0:nvrt-1]: values to be interpolated from; dimensions must match driving program
 5217: // //     Outputs:
 5218: // //       s_out: interpolated value @ z=zt (bottom value if ibelow=1). Constant extrapolation
 5219: // //                   is used below bottom or above surface.
 5220: // //       ibelow: flag indicating if zt is below za(k1)
 5221: // //
 5222: 
 5223: //    assert(k1 >= 0 && k2 < nvrt && "vertLinearInterp: k1 or k2 out of bounds");
 5224: //    assert(k1 <= k2 && "vertLinearInterp: k1 > k2");
 5225:    
 5226: //    ibelow = 0;
 5227: 
 5228: //    if (zt < za[k1]) {
 5229: //       // Below bottom
