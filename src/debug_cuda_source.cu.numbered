 2763: 
 2764: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2765: 
 2766: 
 2767: __device__ void Node::updateKb(void) {
 2768: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2769: 
 2770:    if constexpr(ivcor == 1) return;
 2771: 
 2772: 
 2773:    if (isDry2()) return;
 2774: 
 2775:    if constexpr(ivcor == 2) {  // SZ coordinates
 2776:       
 2777:       // Compute bottom level index
 2778:       if (depth <= mesh->h_s) {
 2779:          kb = izlev;
 2780:          
 2781:       } else {
 2782:          kb = -1;
 2783:          int L = 0;
 2784:          int R = nzlev; 
 2785:          
 2786:          while (L <= R) {
 2787:             int M = (R + L) / 2;
 2788: 
 2789: // printf("L = %d, R = %d, M = %d, depth = %f, ztot[L] = %f, ztot[R] = %f, ztot[M] = %f\n", L, R, M, depth, mesh->ztot[L], mesh->ztot[R], mesh->ztot[M]);
 2790:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2791:             
 2792:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2793:                R = M;
 2794:             } else {
 2795:                L = M;
 2796:             }
 2797: 
 2798:             if (R - L == 1) {
 2799:                kb = L;
 2800:                break;
 2801:             }
 2802:          }
 2803:       }
 2804:    } 
 2805: }
 2806: 
 2807: 
 2808: __device__ __inline__ void Node::updateZCoordData(void) {
 2809: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2810: 
 2811:    if (isDry2()) {
 2812:       kb = -1;
 2813:       return;
 2814:    }
 2815: 
 2816:    if constexpr(ivcor == 2) {  // SZ coordinates
 2817:       
 2818:       // Compute bottom level index
 2819:       if (depth <= mesh->h_s) {
 2820:             kb = izlev;
 2821: 
 2822:       } else {
 2823:          kb = -1;
 2824:          for (int i = 0; i < nzlev; i++) {
 2825:             // XXX Use binary search
 2826:             if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 2827:                kb = i;
 2828:                break;
 2829:             }
 2830:          }
 2831:       }
 2832:    } 
 2833:    else if (ivcor == 1) {  // Localized sigma
 2834:       // Do nothing
 2835:    }
 2836: 
 2837: }
 2838: 
 2839: __device__ double Node::compZCoord(int k) const {
 2840:    // Computes the z coordinate at level k.
 2841:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2842:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2843:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2844:    // used 
 2845:    
 2846:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2847: 
 2848:    if (isDry2()) return 0.0;
 2849: // if (htot2() <= h0) printf("idx = %d, htot2() = %f, h0 = %f\n", idx, htot2(), h0); XXX
 2850: // if (htot2() <= h0) return 0.0; // XXX
 2851:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2852: 
 2853:    if constexpr(ivcor == 2) {
 2854: 
 2855:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2856:       const double h_c = mesh->h_c;
 2857:       const double theta_f = mesh->theta_f;
 2858:       const double sinh_theta_f = mesh->sinh_theta_f;
 2859: 
 2860:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2861:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2862:       // once per time step/node.
 2863:       // CHECK: updateZCoordData
 2864: 
 2865:       //  To simplify comparisons, I define index versions of count variables.
 2866:       if      (k == ivrt)           return eta2; 
 2867:       else if (k == izlev)          return -hmod2;
 2868:       else if (k == kb)             return -depth;
 2869:       else if (k < izlev && k >= 0) return mesh->ztot[k];
 2870:       else if (k > izlev) {
 2871:          const int ksig = k - izlev;
 2872: 
 2873:          if (hmod2 <= h_c) {
 2874: // printf("mesh->sigma[ksig] * (hmod2 + eta2) + eta2 = %e\n", mesh->sigma[ksig] * (hmod2 + eta2) + eta2);            
 2875:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2876:          } 
 2877:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2878:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2879:             assert(false && "ZCOOR: invalid h_c\n");
 2880:          } 
 2881:          else {
 2882: // printf("eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig] = %e\n", eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig]);
 2883:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2884:                          h_c * mesh->sigma[ksig] + 
 2885:                          (hmod2 - h_c) * mesh->cs[ksig];
 2886:          }
 2887:       } else { 
 2888:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2889:       }
 2890: 
 2891:    }
 2892:    else if constexpr(ivcor == 1) {
 2893:       if (k == kb) return -depth;
 2894:       else if (k == nvrt-1) return eta2;
 2895:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2896:    }
 2897:    
 2898:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2899:    return 0.0;
 2900: }
 2901: 
 2902: 
 2903: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2904:    // Checks if a side in on the boundary
 2905:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2906: 
 2907:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2908:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2909: 
 2910:    // Indices of the nodes that form the side
 2911:    const int n1 = side.n1->idx;
 2912:    const int n2 = side.n2->idx;
 2913:    isLand = false;
 2914:    
 2915: if (n1 == 10) printf("nland = %d, nope = %d, ilnd[0] = %d, ilnd[1*nland] = %d, ilnd[2*nland] = %d, ilnd[3*nland] = %d\n", nland, nope, ilnd[0], ilnd[1*nland], ilnd[2*nland], ilnd[3*nland]);
 2916:    // Check if the side is on a land boundary
 2917:    for (int i = 0; i < nland; i++) {
 2918:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2919:          // Consecutive nodes in the land boundary segment
 2920:          const int b1 = ilnd[i + j*nland];
 2921:          const int b2 = ilnd[i + (j + 1)*nland];
 2922: 
 2923:          assert(b1 != -1 && b2 != -1);
 2924: 
 2925:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2926:             
 2927:             isLand = true;
 2928:             return i;
 2929:          }
 2930:       }
 2931:    }
 2932: 
 2933:    // Check if the side is on an open boundary
 2934:    for (int i = 0; i < nope; i++) {
 2935:       for (int j = 0; j < nond[i] - 1; j++) {
 2936:          // Consecutive nodes in the open boundary segment
 2937:          const int b1 = iond[i + j*nope];
 2938:          const int b2 = iond[i + (j + 1)*nope];
 2939: 
 2940:          assert(b1 != -1 && b2 != -1);
 2941: 
 2942:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2943:             isLand = false;
 2944:             return i;
 2945:          }
 2946:       }
 2947:    }
 2948: // printf("side.idx = %d, n1 = %d, n2 = %d\n", side.idx, n1, n2);             
 2949:    return -1;
 2950: }
 2951: 
 2952: 
 2953: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 2954:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 2955:                                     double *wind_rotate_angle, 
 2956:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2957:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2958:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2959:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 2960:                                     double *drag, double *roughness) {
 2961: 
 2962:    NODE(pnode);  
 2963:    const int i = idx_node;
 2964:    Node &node(*pnode);
 2965: 
 2966:    node.idx = i;
 2967: 
 2968:    const int idxNodeStart = nodeNeighNodesStart[i];
 2969:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2970:    node.numNodes = idxNodeEnd - idxNodeStart;
 2971:    node.nodes = nodeNeighNodes + idxNodeStart;
 2972:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2973: 
 2974: 
 2975: 
 2976:    const int idxElemStart = nodeNeighElemsStart[i];
 2977:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2978:    node.numElements = idxElemEnd - idxElemStart;
 2979:    node.elements = nodeNeighElems + idxElemStart;
 2980: 
 2981:    
 2982:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2983:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2984:       const int partNode = localNodePart[idxNodeGlobal]; 
 2985:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 2986: 
 2987:       Node *node_ptr = nodes[partNode] + idxNode;
 2988:       
 2989:       nodeNeighNodes[idx] = node_ptr;
 2990:    }
 2991: 
 2992: 
 2993:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2994:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2995:       const int partElem = localElemPart[idxElemGlobal];
 2996:       const int idxElem  = localElemIndices[idxElemGlobal];
 2997: 
 2998:       Element *elem_ptr = elems[partElem] + idxElem;
 2999: 
 3000:       nodeNeighElems[idx] = elem_ptr;
 3001:    }      
 3002: 
 3003: // printf("NODE i = %d, node = %p, node.numNodes = %d\n", node.idx, &node, node.numNodes);      
 3004: 
 3005:    node.wind_angle = wind_rotate_angle[i];
 3006: 
 3007: 
 3008:    node.p.x   = node_coords[i * 3];
 3009:    node.p.y   = node_coords[i * 3 + 1];
 3010:    node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 3011:    node.depth = node_coords[i * 3 + 2];
 3012: 
 3013:    node.numSides = 0;
 3014: 
 3015:    node.Cd = drag[i];
 3016:    node.rough = roughness[i];
 3017:    
 3018:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3019: 
 3020:    // Links the node to the boundary information
 3021:    if (isbnd[i] >= 0) {
 3022: 
 3023:      
 3024:       // Get the index of the node boundary
 3025:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3026: 
 3027:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3028:       node.nodeBnd->node = &node;
 3029: 
 3030:       node.nodeBnd->sideBnd1 = nullptr;
 3031:       node.nodeBnd->sideBnd2 = nullptr;
 3032: 
 3033:       if (isbnd[i]>=0) {
 3034: 
 3035:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3036:          
 3037:          node.nodeBnd->segment->ifltype = (isbnd[i]==0)?3:0;
 3038:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3039: 
 3040:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3041:          node.nodeBnd->segment->clen  = nan("1");
 3042:          node.nodeBnd->segment->carea = nan("1");
 3043: 
 3044:       }
 3045: //          else {  XXXXXX
 3046: //             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3047: // printf("EEEEEPP isbnd[i] = %d, node.nodeBnd->segment = %p\n", isbnd[i], node.nodeBnd->segment);            
 3048: //          }
 3049:       
 3050: 
 3051:    }
 3052:    else {
 3053: 
 3054:       node.nodeBnd = nullptr; // For internal nodes
 3055: 
 3056:       if (isbnd[i] == landSegment) {
 3057:          node.nodeBnd = &landBoundaryNode;
 3058:          node.nodeBnd->segment = &landBoundarySegment;
 3059:       }
 3060:       // node.nodeBnd->node = &node;
 3061:       // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3062:       // // node.nodeBnd = nullptr;
 3063:       // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3064:       
 3065:    }
 3066: 
 3067:    // XXXX GAUSSIAN HILL VELOCITIES
 3068: #ifdef GAUSSIAN_HILL_VELOCITIES
 3069:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3070:       constexpr double rot_per = 3000.0;
 3071:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3072:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3073:    // XXXXX
 3074: #endif
 3075: 
 3076: }
 3077: 
 3078: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3079:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3080:                                     double *wind_rotate_angle,   
 3081:                                     int *isdel, int *isidenode, int *isbnd,
 3082:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3083:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3084:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3085:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3086:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3087:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3088:                                     double *drag, double *roughness) {
 3089: 
 3090: 
 3091:    SIDE(pside);
 3092:    Side &side(*pside);
 3093:    const int i = idx_side;
 3094: 
 3095:    side.idx = i;  
 3096:    
 3097:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3098:    const double fc   = 2.0*omega_e*sin(sfea0);
 3099:    const double beta = 2.0*omega_e*cos(sfea0);
 3100: 
 3101:    // finding the pointer to the nodes that form the side
 3102:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3103:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3104: 
 3105:    const int locidx_n1 = localNodeIndices[idx_n1];
 3106:    const int locidx_n2 = localNodeIndices[idx_n2];
 3107:    const int part_n1 =   localNodePart[idx_n1];
 3108:    const int part_n2 =   localNodePart[idx_n2];
 3109: 
 3110:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3111:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3112: 
 3113:    // Counts the number of sides connected to each node
 3114:    side.n1->numSides++;
 3115:    side.n2->numSides++;
 3116: 
 3117:    // Normal, unitary vector to the side
 3118:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3119:    side.n = normalize(side.n);
 3120: 
 3121:    // Side boundary type
 3122:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3123:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3124: 
 3125:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3126:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3127:    {
 3128:       bool isLand = false;
 3129:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3130:       
 3131:       if (isbs > -1) {
 3132:          // assert(isLand || isbs>=0);
 3133:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3134: 
 3135:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3136:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3137:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3138: 
 3139:          assert (isLand == side.sideBnd->segment->isLand);
 3140: 
 3141:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3142:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3143:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3144: 
 3145:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3146:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3147:          
 3148:          side.sideBnd->side = &side;
 3149: 
 3150:       }
 3151:       else {
 3152:          side.sideBnd = nullptr;
 3153:       }
 3154:    }
 3155:    else 
 3156:    {
 3157:       side.sideBnd = nullptr;
 3158:    }
 3159: 
 3160: 
 3161:    // finding the pointer to the elements that share the side
 3162:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3163:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3164: 
 3165:    if (idx_e1 > -1) {
 3166:       const int locidx_e1 = localElemIndices[idx_e1];
 3167:       const int part_e1 =  localElemPart[idx_e1];
 3168:       side.elems[0] = elems[part_e1] + locidx_e1;
 3169: 
 3170:    }
 3171:    else {
 3172:       side.elems[0] = nullptr;
 3173:    }
 3174: 
 3175:    if (idx_e2 > -1) {
 3176:       const int locidx_e2 = localElemIndices[idx_e2];
 3177:       const int part_e2 =  localElemPart[idx_e2];
 3178:       side.elems[1] = elems[part_e2] + locidx_e2;
 3179:    }
 3180:    else {
 3181:       side.elems[1] = nullptr;
 3182:    }
 3183: 
 3184:    // Compute the center of the side
 3185:    side.center = 0.5*(side.n1->p2() + side.n2->p2());
 3186: 
 3187:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3188:    side.shapiro = shapiro0;
 3189: 
 3190: #ifdef GAUSSIAN_HILL_VELOCITIES
 3191: // XXXX
 3192: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3193: constexpr double rot_per=3000.0;
 3194: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3195: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3196: // XXXXX      
 3197: #endif
 3198:    // Compute the z level at the center of the side
 3199:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3200: 
 3201:    // Compute the length of the side
 3202:    const Vector2 vLen = side.n2->p2() - side.n1->p2();
 3203:    side.len = sqrt(dot(vLen, vLen));
 3204: 
 3205: 
 3206:    // Compute the Coriolis coefficient
 3207: 
 3208:    if constexpr(ncor == -1 || ncor == 0) {
 3209:       side.coriolis = coricoef;
 3210:    }
 3211:    else {
 3212:       const double sphi = side.lat();  // Latitude at the center of the side
 3213: 
 3214:       if constexpr(ics == 1) {
 3215:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3216:       }
 3217:       else {
 3218:          side.coriolis = 2.0*omega_e*sin(sphi);
 3219:       }
 3220:    }
 3221: }
 3222: 
 3223: 
 3224: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3225:    double *node_coords, double *node_coords_ll, bool use_ll,
 3226:    double *wind_rotate_angle,   
 3227:    int *isdel, int *isidenode, int *isbnd,
 3228:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3229:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3230:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3231:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3232:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3233:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3234:    double *drag, double *roughness) {
 3235: 
 3236:    ELEM(pelem);
 3237:    Element &elem(*pelem);
 3238:    const int i = idx_elem;
 3239:    
 3240:    elem.idx = i;
 3241: 
 3242:    for (int j = 0; j < i34[i]; j++) {
 3243:       const int idxNode = elnode[i*4 + j];  
 3244:       const int idxSide = elside[i*4 + j];
 3245:       
 3246:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3247:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3248: 
 3249: 
 3250:       // Find the neighboring element  
 3251:       if (elem.sides[j]->elems[0] == &elem) {
 3252:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3253:       }
 3254:       else {
 3255:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3256:       }
 3257:       
 3258:    }
 3259: 
 3260:    elem.i34 = i34[i];
 3261: 
 3262:    // Compute the centroid of the element and its depth
 3263:    Vector2 center = {0.0, 0.0};
 3264:    elem.depth = 0.0;
 3265:    for (int j = 0; j < i34[i]; j++) {
 3266:       center += elem.nodes[j]->p2()/i34[i];
 3267:       elem.depth  += elem.nodes[j]->p.z/i34[i];
 3268:    }
 3269:    elem.center = center;
 3270: 
 3271:    
 3272:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3273:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3274: 
 3275:    elem.area = elem.computeSignedArea(); 
 3276:    elem.radius = sqrt(elem.area)/pi; 
 3277:    
 3278:    // Determines which way the normal vector to each side is oriented.
 3279:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3280:    for (int j = 0; j < i34[i]; j++)  
 3281:    {
 3282:       if (elem.sides[j]->elems[0] == &elem) {
 3283:          elem.ssign[j] =  1.0;
 3284:       }
 3285:       else {
 3286:          elem.ssign[j] = -1.0;
 3287:       }
 3288: 
 3289:    }
 3290: 
 3291:    // Derivatives of shape functions
 3292:    //  For ics=2, this is done inside element/ll frame XXX
 3293:    //  For quads, the derivative is evaluated at centroid
 3294:    for (int j = 0; j < elem.i34; j++) {
 3295:       const double area = elem.area;
 3296:       const int id2 = elem.nxq(1 + j);
 3297:       const int id3 = elem.nxq(2 + j);
 3298:       const int id4 = elem.nxq(3 + j);
 3299:       if (elem.isTri()) {
 3300:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3301:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3302:          // da1/dx = (y1 - y2)/(2*area)
 3303:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3304:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3305:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3306:       }
 3307:       else  { // Quad; evaluate at centroid
 3308:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3309:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3310:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3311:       } // if Tri
 3312: 
 3313:    } // for j   
 3314:    
 3315:    
 3316: 
 3317: }
 3318: 
 3319: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3320:                                             double *emo, double *efa, 
 3321:                                             double *umo, double *ufa, 
 3322:                                             double *vmo, double *vfa) {
 3323: 
 3324: 
 3325:    NODE_BND(nodeBnd);
 3326:    const int idx = idx_node_bnd;    
 3327: 
 3328:    nodeBnd->idx = idx;
 3329: 
 3330:    // Need to find the segment index and the index of the node on the segment
 3331:    int idxNode = -1;
 3332:    int iseg, i;
 3333:    for (iseg = 0; iseg < nope; iseg++) {
 3334:       // for each segment...
 3335:       for (i = 0; i < nond[iseg]; i++) {
 3336:          idxNode = iond[iseg + i*nope];
 3337:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3338:          
 3339:       }
 3340:    }
 3341: 
 3342:    assert(iseg < nope && "iseg is out of bounds");
 3343: 
 3344: found: // Jumped here when the node was found
 3345: 
 3346:    nodeBnd->isEssentialBC = true;
 3347:    nodeBnd->elbc = 0.0;
 3348: 
 3349:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3350: 
 3351:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX
 3352:       nodeBnd->efa[jfr] = efa[idx2];
 3353:       nodeBnd->emo[jfr] = emo[idx2];
 3354:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3355:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3356: 
 3357:    }
 3358:         
 3359: 
 3360: }
 3361: 
