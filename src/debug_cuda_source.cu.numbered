 1904: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o', int label = -1) {
 1905: // return;   
 1906:    // Lock the mutex
 1907:    lock(&debugPlotMutex);
 1908:  
 1909:    bool ok = true;
 1910:    if (debugPlotIdx == nullptr) ok = false;
 1911:    if (*debugPlotIdx >= 10000) ok = false;
 1912:    if (ok) {
 1913:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1914:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1915:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1916:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1917:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1918:       debugPlot[(*debugPlotIdx) + 5*10000] = (double)marker;
 1919:       debugPlot[(*debugPlotIdx) + 6*10000] = (double)label;
 1920:       (*debugPlotIdx)++;
 1921:    }
 1922: 
 1923:    __threadfence();               // ensure all above writes are visible
 1924:    // Unlock the mutex
 1925:    unlock(&debugPlotMutex);
 1926: 
 1927: }
