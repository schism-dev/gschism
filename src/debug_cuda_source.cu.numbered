 1477:       printf("npgb = %d, negb = %d, nsgb = %d, nseg = %d\n", npgb, negb, nsgb, nseg);
 1478:       printf("np = %d, ne = %d, ns = %d\n", np, ne, ns);
 1479:       printf("max_np = %d, max_ne = %d, max_ns = %d\n", max_np, max_ne, max_ns);
 1480:  
 1481:       printf("elemsPtr = %p, elems = %p\n", *elems, elemsMem);
 1482:       
 1483:       sinh_theta_f = sinh(theta_f);
 1484: 
 1485:    }
