 8292: #ifdef OLD_PCG_SOLVER
 8293: __global__ void computeMatrixProductAndDotProducts() {
 8294:    // Computes A*p, r'Mr and p'Ap
 8295: 
 8296:    // 1) shared buffer: first half for rMr, second for pAp
 8297:    __shared__ double sdata[2*BLOCK_SIZE];
 8298:    double* s_rMr = sdata;
 8299:    double* s_pAp = sdata + BLOCK_SIZE;
 8300: 
 8301:    const int tid = threadIdx.x;
 8302: 
 8303:    double l_pAp = 0.0;
 8304: 
 8305:    s_rMr[tid] = 0.0;
 8306:    s_pAp[tid] = 0.0;
 8307: 
 8308:    // 2) get your node pointer
 8309:    // NODE(node);   
 8310:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 8311:    Node *node = &(mesh->localNodeData[idx_node]); 
 8312:       if (idx_node < mesh->np) {
 8313: 
 8314:       const double diag = node->coeffDiag;
 8315:       const double r    = node->mR;
 8316:       const double p    = node->mP;  
 8317: 
 8318:       // apply preconditioner on the fly:
 8319:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 8320: 
 8321:       // 4) compute Ap = A.p
 8322:       double Ap = node->coeffDiag * node->mP;
 8323:       for (int j = 0; j < node->numNodes; ++j) {
 8324:          const Node *nbNode = node->nodes[j];
 8325:          Ap += node->coeffMatrix[j] * nbNode->mP;
 8326: 
 8327:       }
 8328: 
 8329:       node->mAp = Ap;
 8330:       
 8331: 
 8332:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 8333:       // const double l_rMr = r*Mr;  // r'Mr
 8334:       l_pAp = p*Ap;  // p'Ap
 8335: 
 8336: 
 8337:    }
 8338: 
 8339:    // 6) write into shared mem
 8340:    // s_rMr[tid] = l_rMr;
 8341:    s_pAp[tid] = l_pAp;
 8342: 
 8343:    __syncthreads();
 8344: 
 8345:    // 7) block-wide tree reduction
 8346:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8347:       if (tid < stride)  {
 8348:          s_pAp[tid] += s_pAp[tid + stride];
 8349:       }
 8350:       __syncthreads();
 8351:    }
 8352: 
 8353:    // 8) thread 0 atomically accumulates into the globals
 8354:    // XXX: This is slower than it needs to be, but it is simple and works
 8355:    if (tid == 0) {
 8356:       atomicAdd(pAp, s_pAp[0]);
 8357:    }
 8358: 
 8359: 
 8360: }
 8361: 
 8362: 
 8363: __global__ void updateSolutionAndDotProducts(void) {
 8364:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 8365: 
 8366:    const int tid = threadIdx.x;
 8367: 
 8368:    s_rMr[tid] = 0.0;
 8369: 
 8370:    // get node & bounds-check:
 8371:    NODE(node);
 8372: 
 8373:    
 8374:    // Compute alpha
 8375:    const double alpha = (*rMr_old)/(*pAp); 
 8376: 
 8377: 
 8378:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 8379: 
 8380: 
 8381:    // load scalars
 8382:    const double diag = node->coeffDiag;
 8383:    const double p    = node->mP;
 8384:    const double Ap   = node->mAp;
 8385:    const double x    = node->mX;
 8386:    const double r    = node->mR;
 8387:    
 8388:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 8389: 
 8390:    // 1) update solution & residual
 8391:    const double x_new = x + alpha*p;
 8392:    const double r_new = r - alpha*Ap;
 8393:    node->mX = x_new;
 8394:    node->mR = r_new;
 8395: 
 8396:    // 2) apply Jacobi preconditioner on the fly
 8397:    const double Mr_new = r_new/diag;
 8398: 
 8399: 
 8400:    // 3) local contributions for the two dot-products
 8401:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 8402: 
 8403:    // 4) write into shared-mem
 8404:    s_rMr[tid] = l_rMr;
 8405: 
 8406:    __syncthreads();
 8407: 
 8408: 
 8409:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8410:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8411:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8412:       __syncthreads();
 8413:    }
 8414: 
 8415:    // 6) thread 0 atomically folds into the global accumulators
 8416:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 8417: 
 8418: 
 8419: }
 8420: 
 8421: 
 8422: __global__ void updateSearchDirection() {
 8423: 
 8424:     NODE(node);
 8425: 
 8426:     // recompute z on-the-fly
 8427:     const double z = node->mR / node->coeffDiag;
 8428:     const double p = node->mP;
 8429: 
 8430:     const double beta = (*rMr_new)/(*rMr_old);
 8431: 
 8432: 
 8433:     // p =z + beta*p
 8434:     node->mP = z + beta*p;
 8435: 
 8436: }
 8437: 
 8438: __global__ void initializeScalars(double *scalars) {
 8439: 
 8440:    // These point to a cupy array in the host code
 8441:    rMr_old = scalars + 0;
 8442:    rMr_new = scalars + 1;
 8443:    pAp     = scalars + 2;
 8444: }
 8445: 
 8446: __global__ void initializePreconditionedResidual(void) {
 8447: 
 8448:     __shared__ double s_rMr[BLOCK_SIZE];  
 8449: 
 8450:     s_rMr[threadIdx.x] = 0.0;
 8451: 
 8452:     NODE_ALL(node, valid);
 8453:     const int tid = threadIdx.x;
 8454:     // For the first iteration:
 8455:     // 1. Initial solution x = 0 (already set)
 8456:     // 2. Initial residual r = b (stored in qel)
 8457:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 8458: 
 8459: // XXX we should use the guess solution here    
 8460: 
 8461:     double l_rMr = 0.0;
 8462:     if (valid) {
 8463:       // Set initial residual r = b (from qel)
 8464:       node->mR = node->qel;
 8465: 
 8466:       // Compute z = M^-1 * r (preconditioned residual)
 8467:       const double z = node->mR / node->coeffDiag;
 8468: 
 8469:       // Set initial search direction p = z
 8470:       node->mP = z;
 8471: 
 8472:       // Initialize other variables needed for CG
 8473:       node->mX = 0.0;  // Initial solution
 8474:       node->mAp = 0.0; // Will be computed in first iteration
 8475: 
 8476: 
 8477:       // Computes the first r'Mr (reduction)
 8478:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 8479:     }
 8480:     // 4) write into shared-mem
 8481:     s_rMr[tid] = l_rMr;
 8482: 
 8483:     __syncthreads();
 8484: 
 8485: 
 8486:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8487:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8488:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8489:         __syncthreads();
 8490:     }
 8491: 
 8492:     // 6) thread 0 atomically folds into the global accumulators
 8493:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 8494: 
 8495:     *rMr_old = 0.0;
 8496:     *pAp = 0.0;
 8497: }
 8498: #endif
 8499: 
 8500: extern "C" __global__ void getElementVarFunc(int varCode, double *res) {
 8501: 
 8502:    ELEM(elem);
 8503: 
 8504:    switch (varCode) {
 8505:       case (int)VarCode::outputCoords:
 8506:          const Point2 coords = elem->outputCoords();
 8507:          res[elem->idx*2    ] = coords.x;
 8508:          res[elem->idx*2 + 1] = coords.y;
 8509:          break;
 8510:    }
 8511: }
