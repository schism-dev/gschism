 1703: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000) {
 1704:    return;
 1705:    // Lock the mutex
 1706:    lock(&debugPlotMutex);
 1707:  
 1708:    bool ok = true;
 1709:    if (debugPlotIdx == nullptr) ok = false;
 1710:    if (*debugPlotIdx >= 10000) ok = false;
 1711:    if (ok) {
 1712:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1713:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1714:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1715:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1716:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1717:       (*debugPlotIdx)++;
 1718:    }
 1719: 
 1720:    __threadfence();               // ensure all above writes are visible
 1721:    // Unlock the mutex
 1722:    unlock(&debugPlotMutex);
 1723: 
 1724: }
 1725: 
 1726: __device__ void addDebugPlot(Vector2 x1, Vector2 x2, unsigned int color = 0xFF0000) {
 1727:    addDebugPlot(toPoint3(x1, 0.0), toPoint3(x2, 0.0), color);
 1728: }
