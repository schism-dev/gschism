 1381: struct Side {
 1382: 
 1383:    // Geometry information
 1384:    int idx;               // Index of the side
 1385:    Node *n1, *n2;
 1386:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
 1387: 
 1388:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
 1389:    Vector2 center;        // Location of side center. 
 1390:    double zc[nvrt];       // Side center z-coord at each vertical level
 1391: 
 1392:    Frame<ics> frame;
 1393:    
 1394:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
 1395:                           // this is nullptr
 1396:    
 1397:    int16_t kb;            // Bottom index of the side
 1398:    bool isDry;            // True if the side is dry
 1399:  
 1400:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1401: 
 1402:    Tracers tracers[nvrt]; // Tracer concentrations at nodes
 1403: 
 1404:    // Physical information
 1405:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1406:    Vector2 btu[nvrt];           // Back-tracked velocity
 1407:    Vector2 U;                   // Vertically averaged velocity vector  
 1408: 
 1409:    Vector2 nuGradU[nvrt];          // nu*grad u
 1410: 
 1411:    Vector2 bcc[nvrt];           // Baroclinic term
 1412:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1413: 
 1414:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1415:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1416:    Vector2 gradPr;               // Gradient of pressure
 1417:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1418: 
 1419: 
 1420:    double hhat;                 // \breve{H} in notes
 1421: 
 1422:    double shapiro;
 1423: 
 1424:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1425: 
 1426:    double coriolis;             // Coriolis parameter
 1427: 
 1428:    // Vegetation parameters
 1429:    double veg_c2;
 1430:    double veg_beta;
 1431: 
 1432:    // Bottom drag parameters.
 1433:    double chi;
 1434:    double chi2;
 1435: 
 1436:    __inline__ __device__ Point2 outputCoords(void) const;
 1437: 
 1438:    __inline__ __device__ double x(double t) const;
 1439:    __inline__ __device__ double y(double t) const;
 1440:    __inline__ __device__ double z(double t) const;
 1441:    __inline__ __device__ double lon(void) const;
 1442:    __inline__ __device__ double lat(void) const;
 1443:    __inline__ __device__ Point2 p2_t(double t) const;
 1444: 
 1445:    __device__ void setFrame(void) {
 1446:       if constexpr(ics == 1) return;
 1447: 
 1448:       double lat, lon;
 1449:       const Point3 p = toPoint3(center, centerZ());
 1450: 
 1451:       // Compute the latitude and longitude of the element center
 1452:       computeLatLon(p, lat, lon);
 1453: 
 1454:       frame.update(lat, lon);        
 1455:    }
 1456:    
 1457: 
 1458:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1459:    // If ics == 2, convert the global point to the local frame of the side
 1460:       
 1461:       if constexpr (ics == 1) {
 1462:          return p;
 1463:       } else {
 1464:          const Point3 c = {center.x, center.y, centerZ()};
 1465:          const Point3 local = frame.G2L(p - c);
 1466:          return local;
 1467:       }
 1468:    }
 1469: 
 1470:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1471:       if constexpr (ics == 1) {
 1472:          return p;
 1473:       } else {
 1474:          const Point3 c = {center.x, center.y, centerZ()};
 1475:          return c + frame.L2G(p);
 1476:       }
 1477:    }
 1478: 
 1479: 
 1480:    __device__ __forceinline__ Vector2 projectToLocalFrame(Vector2 const& v, Frame<ics> const& v_frame) const {
 1481:       if constexpr(ics == 1) return v;
 1482:       else return v_frame.projHorVec(v, frame);
 1483:    }
 1484: 
 1485:    __inline__ __device__ double centerZ(void)      const;
 1486:    __inline__ __device__ Point3 center3D(int k)    const { assert(false); assert(k < nvrt); return {center.x, center.y, zc[k]}; }  // USED??? CONSISTENT?? XXXXX
 1487:    __inline__ __device__ double Dz(int k)          const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1488:    __inline__ __device__ double area(int k)        const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1489:    __inline__ __device__ double areaClamped(int k) const { assert(k < nvrt - 1); return len*(zc[max(k + 1, kb)] - zc[max(k, kb)]); }
 1490: 
 1491:    __inline__ __device__ Side* neigh(int index) const { 
 1492:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1493:       assert(index >= 0 && index < 4); 
 1494:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1495: 
 1496:       const int ielem = index & 1;           // 0 or 1
 1497:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1498: 
 1499:       const Element* elem = elems[ielem];
 1500: 
 1501:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1502: 
 1503:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1504: 
 1505:    }
 1506: 
 1507:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1508: 
 1509:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1510: 
 1511:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1512:    __inline__ __device__ bool isOpenBnd(void) const { return isBnd() && sideBnd->segment->ifltype == 0; } // True if the side is an open boundary side
 1513:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1514:    __inline__ __device__ int iadv(void) const;
 1515: 
 1516:    __inline__ __device__ double grav3(void) const;
 1517:    
 1518:    __inline__ __device__ double eta2(void) const;
 1519:    __inline__ __device__ double eta1(void) const;
 1520:    __inline__ __device__ double w2(int k) const;
 1521:    __inline__ __device__ Vector2 u2Bottom(int dummy = 0) const { return u2[kb]; }  // XXXX dummy argument to satisfy the template in mean()
 1522:    __inline__ __device__ double depth(void) const;
 1523:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1524:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1525: 
 1526:    __inline__ __device__ double dfv(int k) const;
 1527: 
 1528:    __inline__ __device__ double veg_h(void)  const;
 1529:    __inline__ __device__ double veg_nv(void) const;
 1530:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1531:    __inline__ __device__ double veg_alpha3D(int k) const;
 1532:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1533: 
 1534:    __inline__ __device__ double Cd(void) const;
 1535: 
 1536:    __inline__ __device__ Vector2 tau(void) const;
 1537: 
 1538:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1539:    
 1540: 
 1541:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1542:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1543:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1544:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1545:    } 
 1546:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1547:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1548:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1549:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1550: 
 1551:    // Get valid starting element (for backtracking)
 1552:    __inline__ __device__ Element* getStartElement() {
 1553:       return elems[0] ? elems[0] : elems[1];
 1554:    }
 1555: 
 1556:    
 1557:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1558:       // Given an element, returns the other element that shares this side
 1559:       return (elems[0] == elem) ? elems[1] : elems[0];
 1560:    }
 1561: 
 1562:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1563:       // Given a node, returns the other node that shares this side
 1564:       return (n1 == node) ? n2 : n1;
 1565:    }
 1566:  
 1567:    __inline__ __device__ void btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1568: 
 1569: 
 1570: 
 1571: 
 1572: };
 1573: 
 1574: 
 1575: // This struct is used to store the boundary information for a node.
 1576: struct NodeBoundary {   
 1577:    int idx;
 1578:    BoundarySegment *segment;
 1579:    Node *node;
 1580:    
 1581:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1582:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1583: 
 1584:    bool isLand;
 1585: 
 1586:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1587:    double elbc;   // Elevation boundary condition
 1588:    double eth;    // Elevation time history
 1589: 
 1590:    double eta_mean; // Mean elevation at nodes
 1591: 
 1592:    bool isEssentialBC;
 1593: 
 1594:    Vector2 uth[nvrt];  // "Time history" velocity
 1595: 
 1596:    // Arrays for harmonic constituents (if needed)
 1597:    double  emo[nbfr];  // Elevation amplitude
 1598:    double  efa[nbfr];  // Elevation phase
 1599:    Vector2 umo[nbfr];  // velocity amplitude
 1600:    Vector2 ufa[nbfr];  // velocity phase
 1601: 
 1602: 
 1603:    NodeBoundary(void) {
 1604:       isLand = false;
 1605:    }
 1606:    NodeBoundary(bool _isLand) {
 1607:       isLand = _isLand;
 1608:    }
 1609: 
 1610:    
 1611:    __forceinline__ __device__ int numSidesForAverage() const {
 1612:    // Returns the number of sides that are connected to the node and have the same segment.
 1613:    // This is used to compute the average velocity at the node for open boundary nodes.
 1614:       int res = 0;
 1615:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1616:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1617: // printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1618:       return res;
 1619:    }
 1620: 
 1621: 
 1622:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1623:       assert(index == 0 || index == 1); 
 1624:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1625:    }
 1626: 
 1627:    __forceinline__ __device__ void linkSideBoundary(SideBoundary *sb) {
 1628:       if (isLand) return;  // land never uses these links
 1629: 
 1630:       SideBoundary *nullSideBoundary = nullptr;
 1631:       uintptr_t null = (uintptr_t)nullSideBoundary;
 1632: 
 1633:       if (atomicCAS((uintptr_t *)&sideBnd1, null, (uintptr_t)sb) == null) return;
 1634:       if (atomicCAS((uintptr_t *)&sideBnd2, null, (uintptr_t)sb) == null) return;
 1635: 
 1636:       // both slots taken. OK if this side was already linked
 1637:       assert(sideBnd1 == sb || sideBnd2 == sb);
 1638:    }
 1639: 
 1640: 
 1641: };
 1642: 
 1643: struct Node {
 1644: 
 1645:    // Geometry information
 1646:    int idx;            // Global index of the node
 1647:    int16_t part;       // Partition of the node
 1648: 
 1649:    Node **nodes;       // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1650:    int16_t numNodes;   // Number of nodes neighbors of this node
 1651: 
 1652:    Element **elements; // Array of pointers to the elements that share this node
 1653:    int16_t numElements;// Number of elements that share this node
 1654: 
 1655:    int16_t numSides;   // Number of sides that are connected to this node
 1656: 
 1657: 
 1658:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1659:    double gz;          // Global vertical coordinate at the node.
 1660:    Vector2 u2[nvrt];
 1661:    double  w2[nvrt];
 1662:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1663:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1664:    double lon, lat;
 1665:    double depth;
 1666: 
 1667:    Frame<ics> frame;
 1668: 
 1669:    LocalSigma<ivcor> localSigma;  
 1670: 
 1671:    int16_t kb;     // Bottom index of the node
 1672: 
 1673:    bool isDry;     // True if the node is dry
 1674: 
 1675:    int16_t iadv;   // Advection flag
 1676: 
 1677:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1678:                           // this is nullptr
 1679: 
 1680:    TempVar tmp; // Temporary variable to store different types of variables
 1681: 
 1682:    // Physical information
 1683:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1684:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1685: 
 1686:    double rho[nvrt];     // Density
 1687:    double dfv[nvrt];     // Vertical viscosity
 1688:    double dfh[nvrt];     // Horizontal viscosity  XXXX (does it need to exist when transport is not enabled?)
 1689: 
 1690:    Turbulence<turbulenceModel> turb;
 1691: 
 1692:    double eta1; // Elevation at nodes at previous timestep
 1693:    double eta2; // Elevation at nodes at current timestep
 1694: 
 1695:    double ETP;  // Earth Tidal Potential
 1696: 
 1697:    double pr;    // Air pressure
 1698:    double grav2; // Gravity 
 1699:    
 1700:    Vector2 dav;  // Depth averaged velocity
 1701: 
 1702:    Vector2 tau; // Wind stress vector
 1703: 
 1704:    // Vegetation parameters
 1705:    double veg_h;
 1706:    double veg_nv;
 1707:    double veg_di;
 1708:    double veg_Cd;
 1709:    double veg_h_unbent;
 1710:    double veg_di_unbent;
 1711:    double veg_nv_unbent;
 1712:    double veg_alpha_vert_mean;
 1713:    double veg_alpha0;
 1714:    double veg_alpha3D[nvrt];
 1715: 
 1716:    // Bottom drag parameters
 1717:    double Cd;       // Bottom drag coefficient   
 1718: 
 1719:    // These three are mutually exclusive
 1720:    union {
 1721:       double rmanning; // Bottom Manning's coefficient
 1722:       double rough;    // Bottom roughness length
 1723:       double drag;     // Bottom drag coefficient
 1724:    };
 1725:    Vector2 tau_bot; // Bottom stress vector
 1726: 
 1727:    // XXXX REMOVE FOR IMM>0???
 1728:    double bdef1 = 0.0; // Bottom deformation at previous timestep
 1729:    double bdef2 = 0.0; // Bottom deformation at current timestep
 1730: 
 1731:    
 1732:    double qel; // RHS
 1733:    double *coeffDiag;    // Pointer to the diagonal coefficient of the matrix
 1734:    double *coeffRow;     // Pointer to the coefficients of the row of the CRS matrix for this node.
 1735:    int16_t *csrSlot;     // csrSlot[i], is the slot/index of nodes[i] entry the CRS matrix row for this node.
 1736:                          // The index of the diagonal element is coeffDiag - coeffRow.   
 1737: 
 1738:    double mX; // Solution of the FEM system
 1739: 
 1740:    // Meteorological forcing
 1741:    Vector2 u_air;
 1742:    double p_air;  // XXXX is this the same as pr?
 1743:    double t_air;
 1744:    double q_air;
 1745:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1746: 
 1747: 
 1748: 
 1749:    __device__ __forceinline__ int localIndex() const;
 1750:    __device__ __forceinline__ int packedIndex() const;
 1751: 
 1752: 
 1753:    __device__ void setWind(Vector2 &u) {
 1754:    // Sets the wind vector taking into account the mesh angle
 1755:    
 1756:       const double speed = length(u);
 1757: 
 1758:       // Rotate wind vector to the node frame
 1759:       u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1760: 
 1761:       // Sets the surface stress vector due to wind.
 1762:       if constexpr(nws == 0) {
 1763:          tau = {0.0, 0.0};
 1764: 
 1765:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1766:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1767: 
 1768:       } else {
 1769: 
 1770:          double dragcoef;
 1771: 
 1772:          if constexpr(iwind_form == -1) {
 1773:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1774:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1775: 
 1776:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1777:             tau = cff*u_air;
 1778:  
 1779:          } else if constexpr(iwind_form == 1) {
 1780:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1781:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1782: 
 1783:             dragcoef = max(dragcoef, 4.0e-4);
 1784:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1785:             tau = cff*u_air;
 1786: 
 1787:          } else {
 1788:             tau = {0.0, 0.0};
 1789:          }
 1790:       }
 1791:    }
 1792: 
 1793: 
 1794:    __device__ void setFrame(double lat, double lon) {
 1795:       if constexpr(ics == 1) return;
 1796: 
 1797:       frame.update(lat, lon);        
 1798:     }
 1799: 
 1800:    //__device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1801: 
 1802:    __device__ double sigmaTransitionDepth(void) const;
 1803: 
 1804:    __device__ double computeETP(int idxTidalPotential, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const;
 1805: 
 1806:    __inline__ __device__ Point2 outputCoords(void) const {
 1807:       if constexpr(ics == 1)  return p;
 1808:       else                    return {rad2deg*lon, rad2deg*lat};
 1809:    }
 1810: 
 1811:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1812:    // If ics == 2, convert the global point to the local frame
 1813:       
 1814:       if constexpr (ics == 1) {
 1815:          return p;
 1816:       } else {
 1817:          const Point3 c = {p.x, p.y, gz};
 1818:          const Point3 local = frame.G2L(p - c);
 1819:          return local;
 1820:       }
 1821:    }
 1822: 
 1823:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1824:    // If ics == 2, convert the global point to the local frame
 1825:       
 1826:       if constexpr (ics == 1) {
 1827:          return p;
 1828:       } else {
 1829:          const Point3 c = {p.x, p.y, gz};
 1830:          return c + frame.L2G(p);
 1831:       }
 1832:    }
 1833: 
 1834:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1835:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1836:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1837:    
 1838:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1839: 
 1840:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1841:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1842:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }   
 1843: 
 1844:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1845:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1846: 
 1847:    __device__ __forceinline__ void clearMatrixRow(void) {
 1848:       // Clear the matrix row for this node
 1849: 
 1850:       for (int i = 0; i <= numNodes; i++) coeffRow[i] = 0.0;
 1851: 
 1852:    }
 1853: 
 1854:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1855:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1856:       
 1857:       if (node == this) {
 1858:          *coeffDiag += value;
 1859:          return;
 1860:       }
 1861: 
 1862:       int i;
 1863:       for (i = 0; i < numNodes; i++) {
 1864:          if (nodes[i] == node) break;
 1865:       }
 1866: 
 1867:       assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1868:       coeffRow[csrSlot[i]] += value;
 1869:    }
 1870: 
 1871: 
 1872:    __device__ __inline__ void updateZCoordData(void);
 1873: 
 1874:    __device__ __forceinline__ double compZCoord(int k) const;
 1875: 
 1876:    __device__ void updateKb(void);
 1877: 
 1878:    __device__ __forceinline__ void computeBottomDragCd(void);
 1879: 
 1880: 
 1881: 
 1882: };
