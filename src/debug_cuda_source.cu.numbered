 7725: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7726:    Element *elems = mesh->localElemData;
 7727: 
 7728:    *addr = elems;
 7729:    *sizeElement = sizeof(Element);
 7730:    switch (varCode) {
 7731:       case (int)VarCode::z:
 7732:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7733:          *sizeType = sizeof(double);
 7734:          break;
 7735:       case (int)VarCode::x:
 7736:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7737:          *sizeType = sizeof(Vector2);
 7738:          break;
 7739:       case (int)VarCode::area:
 7740:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7741:          *sizeType = sizeof(double);
 7742:          break;
 7743:       case (int)VarCode::depth:
 7744:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7745:          *sizeType = sizeof(double);
 7746:          break;
 7747:       case (int)VarCode::radius:
 7748:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7749:          *sizeType = sizeof(double);
 7750:          break;
 7751:       case (int)VarCode::lonlat:
 7752:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 7753:          *sizeType = sizeof(double);
 7754:          break;
 7755:       case (int)VarCode::ghat:
 7756:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7757:          *sizeType = sizeof(Vector2);
 7758:          break;
 7759:       case (int)VarCode::kb:
 7760:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 7761:          *sizeType = sizeof(int);
 7762:          break;
 7763:       case (int)VarCode::isdry:
 7764:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 7765:          *sizeType = sizeof(int);
 7766:          break;            
 7767:       case (int)VarCode::w:
 7768:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 7769:          *sizeType = sizeof(double);
 7770:          break;
 7771:       case (int)VarCode::FaceIndices:
 7772:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 7773:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 7774:          *sizeType = sizeof(Node);
 7775:          break;
 7776:       default:
 7777:          *offset = -1;
 7778:    }
 7779: }
