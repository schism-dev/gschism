 6902: //           !message passing
 6903: //           if (nproc>1) then
 6904: //             !make a copy of side concentrations
 6905: //             trsd_tmp0=trsd_tmp 
 6906: 
 6907: //             !this exchange routine swaps interface concentration between two partitions
 6908: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
