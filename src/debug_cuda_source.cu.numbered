 6477: extern "C"
 6478:                                  
 6479:   __global__ void populateMesh(int *i34, int *elnode, int *elside,
 6480:                    double *node_coords, double *wind_rotate_angle, 
 6481:                    int *isdel, int *isidenode, int *isbnd,
 6482:                    int *nond, int *nlnd, int *iond, int *ilnd,
 6483:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 6484:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 6485:                    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 6486:                    int *localNodeIndices, int *localElemIndices, int *localSideIndices,
 6487:                    int *localNodePart,    int *localElemPart,    int *localSidePart,
 6488:                    double *emo, double *efa, 
 6489:                    double *umo, double *ufa, 
 6490:                    double *vmo, double *vfa) {
 6491: 
 6492:     mesh->populateMesh(i34, elnode, elside, node_coords, wind_rotate_angle, 
 6493:                        isdel, isidenode, isbnd,
 6494:                        nond, nlnd, iond, ilnd,
 6495:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 6496:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 6497:                        globalNodeIndices, globalElemIndices, globalSideIndices,
 6498:                        localNodeIndices, localElemIndices, localSideIndices,
 6499:                        localNodePart, localElemPart, localSidePart,
 6500:                        emo, efa, umo, ufa, vmo, vfa);
 6501:   }
