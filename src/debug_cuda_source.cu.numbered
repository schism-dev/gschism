 1839: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1840:    // Computes the 3D normal vector to the element at level k
 1841:    // Returns the normal vector and the area of the element
 1842: 
 1843:       if (isTri()) {
 1844:          // For triangles...
 1845: 
 1846:          // Gets the normal vector to the element (with a length equal to twice the area)
 1847:          if constexpr(ics==1) {
 1848:             const int kb0 = max(k, nodes[0]->kb);
 1849:             const int kb1 = max(k, nodes[1]->kb);
 1850:             const int kb2 = max(k, nodes[2]->kb);
 1851: 
 1852:             const Vector3 n20 = nodes[2]->p3D(k) - nodes[0]->p3D(k);
 1853:             const Vector3 n10 = nodes[1]->p3D(k) - nodes[0]->p3D(k);
 1854:             
 1855:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1856:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1857:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1858:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1859: 
 1860:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1861:             area3D = 0.5*len;
 1862: 
 1863:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1864: 
 1865:             return {nx/len, ny/len, nz/len};
 1866: 
 1867:            
 1868:          }
 1869:          else {  // lat/lon
 1870:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1871:             return {0.0, 0.0, 0.0};
 1872: 
 1873:          } // if ics
 1874:       }
 1875:       else {
 1876:          // For quads...
 1877: 
 1878:          assert(false && "Element normal vector: quads not yet implemented");
 1879:          return {0.0, 0.0, 0.0};
 1880: 
 1881: 
 1882:       }
 1883:    }
 1884: 
 1885: /**
 1886:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1887:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1888:    If the segment is completely inside the element, then it returns true.
 1889: 
 1890:    This function assumes:
 1891:    - The initial point is on a side of the element. 
 1892:    - Its position is given by parameter t in the range [0,1].
 1893:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1894:       intersects the element (elements are convex).
 1895: 
 1896:    To find the intersection point, this function does the following:
 1897:    - it finds the intersection of the line segment with all the element side lines,
 1898:       except for the one that contains the initial point.
 1899:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1900:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1901:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1902:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1903:       track segment is almost parallel to the element side line.
 1904: 
 1905:    Inputs:
 1906:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1907:    @param x2, y2: other end of the line segment
 1908: 
 1909:    Outputs:
 1910:    @param side:  side that intersects the line segment (input and output)
 1911:    @param nextElement (output): element that contains the intersection point
 1912:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1913:    @param zint (input/output): Vertical coordinate of the intersection point
 1914: 
 1915:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1916:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1917:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1918: 
 1919:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1920:    (Delta) being zero.
 1921: 
 1922:    The intersection2 point happens when:
 1923:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1924:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1925:    
 1926:    Assumption: the 4 points (including those of the side segment) are different.
 1927:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1928:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1929:    If true, (xIntersect,yIntersect) is the intersection.				
 1930:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1931: **/
 1932: 
 1933: 
 1934: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1935:                                               double &t, double& tIntersect) {
 1936:    assert( containsPoint(x1) && "Starting point is not inside the element");                                    
 1937:    assert(!containsPoint(x2) && "Ending point is not outside the element");
 1938: 
 1939:    double closest_intersect_t = 1e10;
 1940:    bool found_intersection = false;
 1941: 
 1942:    for (int i = 0; i < i34; i++) {
 1943: 
 1944:       Side *side2 = sides[i];
 1945: 
 1946:       // (x3,y3)-(x4,y4) is the element side line
 1947:       const Point2 x3 = side2->n1->p;
 1948:       const Point2 x4 = side2->n2->p;
 1949: 
 1950:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1951:       const double delta = cross(x2 - x1, x3 - x4);
 1952: 
 1953:       if (abs(delta) > 0) {
 1954: 
 1955:          const double delta1 = cross(x3 - x1, x3 - x4);
 1956:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1957: 
 1958:          // Solves the two linear equations for tt1 and tt2
 1959:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1960:          const double tt2 = delta2/delta;
 1961: 
 1962:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1963:             closest_intersect_t = min(closest_intersect_t, tt1);
 1964:             side = side2;
 1965:             nextElement = side->otherElem(this);
 1966:             t =          clamp(tt2, small, 1.0-small);
 1967:             tIntersect = clamp(tt1, small, 1.0-small);
 1968:             found_intersection = true;
 1969:          }
 1970: 
 1971:       
 1972:       }
 1973:       else {  // parallel segments
 1974: 
 1975:          continue; 
 1976:          assert(false && "Parallel segments should not happen under the new code");
 1977:          // In this case, we check if they are colinear. if they are, we compute the intersection point as:
 1978:          // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1979: 
 1980:          // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1981:          const double dist = dot(x1 - x3, side2->n);
 1982:          if (abs(dist) < small*length(x3 - x4)) {
 1983:             const double2 unitarySide = normalize(x4 - x3);
 1984:             const double len = dot(x2 - x1, unitarySide);
 1985:             t = t + len;
 1986:             t = max(0.0, min(t, 1.0));
 1987:             printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1988: 
 1989: 
 1990:             // tIntersect = max(small, min(tt1, 1.0-small));
 1991:             // t = tt2;
 1992:             found_intersection = true;
 1993:          }
 1994:       }
 1995: 
 1996: 
 1997:    }
 1998: 
 1999: 
 2000:    assert(found_intersection && "No intersection found");
 2001: 
 2002:    // found_intersection should always be true, since we checked all the sides.  
 2003:    return found_intersection;
 2004: }
 2005: 
 2006: 
 2007: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 2008:                                              Point3 &xt, double zint, Vector3 &u_int) {
 2009: 
 2010:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 2011:    // Instead, we nudge the intersection point to the barycenter of the current element, and nextElement becomes
 2012:    // curElement.
 2013: 
 2014:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 2015:    // And uses this velocity instead to continue the tracking.
 2016: 
 2017:    // computes the intersection point in cartesian coordinates
 2018:    Point2 intersection = nextSide->p_t(tt);  // XXXX I don't think this is necessary. THE intersection is already computed in findNextIntersection.
 2019: 
 2020:    // Nudges the point to the barycenter of the element. 
 2021:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 2022:    // next segment intersects the element sides. 
 2023:    // TODO: curElem->nudgeToBarycenter(intersection);  REMEMBER!!! RECOVER??? XXX KKKKK
 2024: 
 2025: 
 2026:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 2027:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 2028:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 2029:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 2030: 
 2031:    // If the side is an open boundary, the tangential velocity is set to zero.
 2032:    if (nextSide->isBnd()) vtan = 0.0;
 2033: 
 2034:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 2035:    const double us = vtan*nextSide->t().x;
 2036:    const double vs = vtan*nextSide->t().y;
 2037:    const double ws = nextSide->w2(jlev); 
 2038: 
 2039:    u_int = {us, vs, ws};
 2040: 
 2041:    // The end of this tracking segment is now the intersection point.
 2042:    xt = {intersection.x, intersection.y, zint};
 2043:    
 2044: }
 2045: 
 2046: /**
 2047:  * Tracks a particle through elements and vertical levels in the mesh.
 2048:  * 
 2049:  * @param x0,y0,z0     Starting position coordinates
 2050:  * @param xt,yt,zt     Target position coordinates
 2051:  * @param dtb          Time step for tracking
 2052:  * @param u_int        Initial velocity components
 2053:  * @param nextElem     Starting/resulting element index
 2054:  * 
 2055:  * @return Status code of type trackExitCodes
 2056:  * 
 2057:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2058:  * of the details are different. The idea is that the code requires less branches and is better fit
 2059:  * for GPU execution.
 2060:  * 
 2061:  * The main ideas here are:
 2062:  * - The starting point is expected to be in the starting element.
 2063:  * - since the starting point is inside the element, there are only two cases: 
 2064:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2065:  *     (b) it does not and (xt,yt) is already in the starting element.
 2066:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2067:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2068:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2069:  * - tt1 can be positive or negative. We only consider the positive values.
 2070:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2071:  * - The next intersection will occur at the smallest positive tt1.
 2072:  * - This intersection will be the next (x0,y0) position.
 2073:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2074:  *   of getting stuck in a loop.
 2075:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2076:  *   was found.
 2077:  * - Notice that curElement is the current element, while this is the element for which the first call to this function was made.
 2078:  */
 2079: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2080:                                                        Element *&nextElem, int &jlev, double &dt, double time_rm,
 2081:                                                        const Side *origSide) {
 2082:                                                             
 2083:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2084:    // else to do. This means that the full step occurred within the current element.
 2085:    assert(!isDry && "Starting element is dry");
 2086:    assert(containsPoint(toPoint2(x0)) && "Starting point is not inside the element");
 2087: 
 2088:    if (containsPoint(toPoint2(xt), true)) {  // The "true" means that, if the point is very close to the boundary, it is nudged to be definitely inside the element.
 2089: 
 2090:       assert(containsPoint(toPoint2(xt)) && "Target point is not inside the element");
 2091:       assert(!isDry && "Target point is inside a dry element");
 2092: 
 2093:       interpolateVelocities(xt, u_int);
 2094: 
 2095:       nextElem = this;
 2096: 
 2097: // if (jlev==10) addDebugPlot(x0, xt, 0x00FF00); // green
 2098:       return true;
 2099:    }
 2100: 
 2101: 
 2102:    
 2103: 
 2104:    assert(norm2(toVector2(xt - x0)) > 0.0 && "Zero length track"); 
 2105:    
 2106:    double t;
 2107:    Side *nextSide = nullptr;
 2108:    double tIntersect = 1e10;
 2109: 
 2110: 
 2111:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2112:    // (x0,y0) is inside the element but the target point is not.
 2113:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2114:    assert(found_intersection && "No intersection found at %d");
 2115: 
 2116:    Point2 xtmp = nextSide->p_t(t); // moves the target point to the intersection point
 2117: 
 2118:    // If the next element is not dry, nudge it to the barycenter to ensure that the point is inside the element.
 2119:    if (nextElem != nullptr && !nextElem->isDry) {
 2120:       assert(nextElem->containsPoint(xtmp) && "Intersection point is not inside the next element");
 2121:       nextElem->nudgeToBarycenter(xtmp);
 2122:    }
 2123: 
 2124:    const double zint = (1 - tIntersect)*x0.z + tIntersect*xt.z;
 2125:    xt = {xtmp.x, xtmp.y, zint};
 2126: 
 2127:    // if the tracking segment goes out of water (either dry or edge boundary)
 2128:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2129: 
 2130: 
 2131:       trackGoesOutOfWater(nextSide, this, t, jlev, xt, zint, u_int);
 2132: 
 2133:       assert(this->containsPoint(toPoint2(xt)) && "Target point is not inside the current element");
 2134:       // When this happens, the backtracking stops.
 2135:       // dt = time_rm;  LLLLLL KKKK XXXX
 2136:       dt *= tIntersect;
 2137: 
 2138:       // In this case, the next element is again the current element.
 2139:       nextElem = this;
 2140: 
 2141: // printf("trackGoesOutOfWater: side->idx = %d, dt = %.17f, time_rm = %.17f, u_int = (%.17f, %.17f, %.17f)\n", nextSide->idx, dt, time_rm, u_int.x, u_int.y, u_int.z);
 2142: 
 2143:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2144:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2145:       return true;    
 2146:    }
 2147: 
 2148: 
 2149:    assert(nextElem->containsPoint(toPoint2(xt)) && "Target point is not inside the next element");
 2150:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2151:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2152: 
 2153:    
 2154:    dt *= tIntersect; // reduces the time step to the time it takes to reach the intersection
 2155: 
 2156:    nextElem->interpolateVelocities(xt, u_int); 
 2157: 
 2158:    assert(nextElem != this && "Next element is the same as the current element");
 2159: 
 2160:    return true;
 2161: }
 2162: 
 2163: 
 2164: __inline__ __device__ double Element::computeSignedArea(void) const {
 2165:    // Compute the area of the element
 2166: 
 2167:    double res = signedArea(nodes[0]->p, nodes[1]->p, nodes[2]->p);
 2168: 
 2169:    // In the quad case we need to add the area of the other triangle.
 2170:    if (isQuad()) {
 2171:       double ar1 = signedArea(nodes[0]->p, nodes[2]->p, nodes[3]->p);
 2172:       double ar2 = signedArea(nodes[0]->p, nodes[1]->p, nodes[3]->p);
 2173:       double ar3 = signedArea(nodes[1]->p, nodes[2]->p, nodes[3]->p);
 2174:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2175: 
 2176:       res += ar1;
 2177:    }
 2178: 
 2179:    return res;
 2180: }
 2181: 
 2182: 
 2183: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2184:                                                                 (nodes[1]->isDry2()) ||
 2185:                                                                 (nodes[2]->isDry2()) ||
 2186:                                                                 (i34==4 && nodes[3]->isDry2());
 2187: }
 2188: 
 2189: __inline__ __device__ double Element::detJ_eta(void) const {
 2190:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2191:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2192: }
 2193: 
 2194: __inline__ __device__ double Element::detJ_xi(void) const {
 2195:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2196:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2197: }
 2198: 
 2199: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2200:    // In boundary sides, the element 1 is nullptr
 2201:    return side->elems[1] == nullptr; 
 2202: }
 2203: 
 2204: 
 2205: 
 2206: /**
 2207:    Compute the shape coordinates of the point (xt,yt) in the element.
 2208:    @param xt (input): x-coordinate of the point
 2209:    @param shpCoords (output): shape coordinates of the point
 2210:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2211:    @return true if the point is inside the element, false otherwise
 2212: **/
 2213: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord) const {
 2214: 
 2215:    // Compute the shape coordinates of the point xt in the element.
 2216:    if (i34==3) {
 2217:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2218:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2219:       // and in this case, the pt will be nudged into the element
 2220:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2221:       // from the local frame, so use additional check.
 2222: 
 2223:       Point2 x0, x1, x2;
 2224: 
 2225:       if constexpr(ics==1) {
 2226:          x0 = nodes[0]->p;
 2227:          x1 = nodes[1]->p;
 2228:          x2 = nodes[2]->p;
 2229:       }
 2230:       else // lat/lon
 2231:       {
 2232:          Error("Not implemented yet");
 2233:          // globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2234:          // globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2235:          // globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2236:       }
 2237: 
 2238:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2239:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2240:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2241:       shpCoords[3] = 0.0;
 2242: 
 2243:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2244:       const bool res = (tmpmin >= -small);  
 2245:       
 2246:       // If the point is not inside the element (with a small tolerance), we do not need to fix the negative shape coordinates.
 2247:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2248: 
 2249:       
 2250:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2251:       // then we fix the negative shape coordinates.
 2252:       if ((tmpmin < 0) && fix) {
 2253: 
 2254:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2255:          // keeping the sum of the shape coordinates equal to 1.
 2256:          // I have tested and compared the new algorithm with the old one, and they give
 2257:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2258:          // The new algorithm should be faster since it is branchless.
 2259:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 2260:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2261:          
 2262:          shpCoords[0] = (shpCoords[0] + a)*b;
 2263:          shpCoords[1] = (shpCoords[1] + a)*b;
 2264:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2265: 
 2266:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2267:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 2268:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 2269: 
 2270:          // Update the point coordinates for the new shape coordinates
 2271:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2272:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2273:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2274: 
 2275:       }
 2276: 
 2277:       // Check if the point is inside the element
 2278:       return res;      
 2279:    }
 2280:    else {
 2281:       Error("Not implemented yet");
 2282: #ifdef QUADS
 2283:       // Reproject pt in eframe of nel for ics=2
 2284:       if constexpr(ics==1) {
 2285:          xn2 = xt; 
 2286:          yn2 = yt;
 2287:       }
 2288:       else {
 2289:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2290:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2291:       }
 2292: 
 2293:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2294: #endif
 2295:    }
 2296: 
 2297:    assert(false && "computeShapeCoords: should never reach this point");
 2298:    return false;  // Never reached
 2299: 
 2300: }
 2301: 
 2302: 
 2303: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2304: // Convert shape coordinates to cartesian coordinates
 2305: 
 2306:    if (i34 == 3) {
 2307:       // Triangular element
 2308:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2309:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2310:    }
 2311:    else {
 2312:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2313:    }
 2314: 
 2315: }
 2316: 
 2317: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2318:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2319:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2320:    // The formula for the integral is:
 2321:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2322: 
 2323:    printf("intPhiPhi: TEST\n");
 2324: 
 2325:    const Node *n0 = nodes[0];
 2326:    const Node *n1 = nodes[1];
 2327:    const Node *n2 = nodes[2];
 2328:    const Node *n3 = nodes[3];
 2329: 
 2330:    const Vector2 p0 = n0->p;
 2331:    const Vector2 p1 = n1->p;
 2332:    const Vector2 p2 = n2->p;
 2333:    const Vector2 p3 = n3->p;
 2334: 
 2335:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2336:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2337:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2338:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2339: 
 2340:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2341: }
 2342:    
 2343: 
 2344: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2345:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2346:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2347:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2348:    // The formula is also based on the identity:
 2349:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2350:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2351: 
 2352:    printf("intGradPhiGradPhi: TEST\n");   
 2353: 
 2354:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2355: 
 2356:    const double x0 = nodes[0]->p.x;
 2357:    const double y0 = nodes[0]->p.y;
 2358:    const double x1 = nodes[1]->p.x;
 2359:    const double y1 = nodes[1]->p.y;
 2360:    const double x2 = nodes[2]->p.x;
 2361:    const double y2 = nodes[2]->p.y;
 2362:    const double x3 = nodes[3]->p.x;
 2363:    const double y3 = nodes[3]->p.y;
 2364: 
 2365:    double res = 0.0;
 2366:    
 2367:    // Quadrature points in xi and eta coordinates
 2368:    #pragma unroll
 2369:    for (int i = 0; i < 4; i++) {
 2370:       // For each quadrature point...
 2371: 
 2372:       const Point2 p = GaussPoint(i);
 2373:       const double eta = p.x;
 2374:       const double xi  = p.y;
 2375: 
 2376:       // Jacobian entries at the Gauss point p
 2377:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2378:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2379:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2380:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2381: 
 2382:       const double detJ = jacobianDet(p);
 2383:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2384: 
 2385:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2386:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2387:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2388:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2389:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2390: 
 2391:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2392:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2393:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2394:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2395:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2396: 
 2397:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2398:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2399:    }
 2400: 
 2401:    return res;
 2402: }
 2403: 
 2404: 
 2405: /**  Interpolate velocities at a given point (xt,yt,zt)
 2406: 
 2407:    @param xt, yt, zt: coordinates of the point to interpolate
 2408:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2409: 
 2410:    This is done in four steps:
 2411: 
 2412:    1. Find the shape coordinates for the final position in the element.
 2413:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2414:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2415:       z levels at xt, yt at each step.   
 2416:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2417:       horizontally and vertically.
 2418: **/
 2419: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2420:    // Interpolate the velocities at the point xt. 
 2421:    // This function works the same for triangular and quadrilateral elements.
 2422:    double shpCoord[4];
 2423: 
 2424:    // First step is to compute the shape coordinates of (xt,yt)
 2425:    computeShapeCoords(toVector2(xt), shpCoord, fiOnlyInside);
 2426: 
 2427:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2428: 
 2429:    // Second step is to find the level that contains zt
 2430:    // Uses a binary search to find the level
 2431:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2432:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2433:    int R = nvrt - 1;
 2434: 
 2435:    // Get the z coordinates at the nodes of the element at the levels L and R
 2436:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 2437:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2438:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2439: 
 2440:    double zL = interpolate(shpCoord, zLAtNodes);
 2441:    double zR = interpolate(shpCoord, zRAtNodes);
 2442:    
 2443:    // Interpolates vertically the velocities
 2444:    double wght1, wght2;
 2445:    if (xt.z<=zL) {
 2446:       wght1 = 1.0;
 2447:       wght2 = 0.0;
 2448:       xt.z = zL;
 2449:    }
 2450:    else if (xt.z>=zR) {
 2451:       wght1 = 0.0;
 2452:       wght2 = 1.0;
 2453:       xt.z = zR;
 2454:    }
 2455:    else {
 2456:       // Perform a binary search to find the levels between L and R that contain xt.z
 2457:       while (R - L > 1) {
 2458:          int M = (L + R) / 2.0;
 2459: 
 2460:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2461:          double zM = interpolate(shpCoord, zMAtNodes);
 2462:          if (zM < xt.z) 
 2463:          {
 2464:             L = M;
 2465:             zL = zM;
 2466:          }
 2467:          else 
 2468:          {
 2469:             R = M;
 2470:             zR = zM;
 2471:          }
 2472:       }
 2473:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 2474:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2475: 
 2476:       wght2 = (xt.z - zL)/(zR - zL);
 2477:       wght1 = 1.0 - wght2;
 2478: 
 2479:    }
 2480: 
 2481: 
 2482:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2483:    u_int = wght1*interpolate(L, shpCoord, &Node::uvw2) + wght2*interpolate(R, shpCoord, &Node::uvw2);
 2484: 
 2485:    // Neither of the interpolated velocities should be NaN
 2486:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2487: 
 2488: }
 2489: 
 2490: 
 2491: 
 2492: 
 2493: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2494: 
 2495:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2496:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2497:    const Node *n1 = side->n1;
 2498:    const Node *n2 = side->n2;
 2499: 
 2500:    bool n1_match = (n1->nodeBnd->segment == segment);
 2501:    bool n2_match = (n2->nodeBnd->segment == segment);
 2502: 
 2503:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2504:    if (n1_match && n2_match) {
 2505:       return 0.5;
 2506:    } else if (n1_match) {
 2507:       return 1.0;
 2508:    } else if (n2_match) {
 2509:       return 0.0;
 2510:    }
 2511: 
 2512:    return 0.0;
 2513: }
 2514: 
 2515: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2516: 
 2517: 
 2518: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2519: 
 2520:    const double w1 = getBoundaryArrayValueWeight();
 2521:    const double w2 = 1.0 - w1;
 2522:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2523:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2524: 
 2525:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2526: }
 2527: 
 2528: 
 2529: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2530:    const double w1 = getBoundaryArrayValueWeight();
 2531:    const double w2 = 1.0 - w1;
 2532:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2533:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2534: 
 2535:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2536: 
 2537: }
