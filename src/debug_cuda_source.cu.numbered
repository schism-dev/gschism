 1397: struct BTPoint {
 1398:    Point3 x;
 1399:    // double pad1;
 1400:    Vector3 u;  // Velocity interpolated at the current point. It is not necessarily the one used to compute the next point (because sliding along a side is allowed)
 1401:    // double pad2;
 1402:    double dt;
 1403:    double  t; // Parametric value of the point on the side when type is btSide. This is not a time!!!
 1404: 
 1405:    Element *elem;
 1406:    Side    *side;
 1407:    Node    *node;
 1408: 
 1409:    enum class BTPointType {btElement, btSide, btNode};
 1410:    BTPointType type;
 1411:    // Constructor for creating a BTPoint
 1412:    __device__ BTPoint(Point3 x_, BTPointType type_, Element *elem_ = nullptr, Side *side_ = nullptr, Node *node_ = nullptr, double t_ = 0.0, double dt_ = 0.0, Vector3 u_ = {0.0, 0.0, 0.0})
 1413:       : x(x_), u(u_), dt(dt_), type(type_), elem(elem_), side(side_), node(node_), t(t_) {}
 1414: };
