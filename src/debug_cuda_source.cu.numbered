 1772: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1773:    // Computes the 3D normal vector to the element at level k
 1774:    // Returns the normal vector and the area of the element
 1775: 
 1776:       if (isTri()) {
 1777:          // For triangles...
 1778: 
 1779:          // Gets the normal vector to the element (with a length equal to twice the area)
 1780:          if constexpr(ics==1) {
 1781:             const int kb0 = max(k, nodes[0]->kb);
 1782:             const int kb1 = max(k, nodes[1]->kb);
 1783:             const int kb2 = max(k, nodes[2]->kb);
 1784: 
 1785:             const Vector3 n20 = nodes[2]->p3D(k) - nodes[0]->p3D(k);
 1786:             const Vector3 n10 = nodes[1]->p3D(k) - nodes[0]->p3D(k);
 1787:             
 1788:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1789:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1790:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1791:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1792: 
 1793:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1794:             area3D = 0.5*len;
 1795: 
 1796:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1797: 
 1798:             return {nx/len, ny/len, nz/len};
 1799: 
 1800:            
 1801:          }
 1802:          else {  // lat/lon
 1803:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1804:             return {0.0, 0.0, 0.0};
 1805: 
 1806:          } // if ics
 1807:       }
 1808:       else {
 1809:          // For quads...
 1810: 
 1811:          assert(false && "Element normal vector: quads not yet implemented");
 1812:          return {0.0, 0.0, 0.0};
 1813: 
 1814: 
 1815:       }
 1816:    }
 1817: 
 1818: /**
 1819:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1820:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1821:    If the segment is completely inside the element, then it returns true.
 1822: 
 1823:    This function assumes:
 1824:    - The initial point is on a side of the element. 
 1825:    - Its position is given by parameter t in the range [0,1].
 1826:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1827:       intersects the element (elements are convex).
 1828: 
 1829:    To find the intersection point, this function does the following:
 1830:    - it finds the intersection of the line segment with all the element side lines,
 1831:       except for the one that contains the initial point.
 1832:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1833:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1834:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1835:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1836:       track segment is almost parallel to the element side line.
 1837: 
 1838:    Inputs:
 1839:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1840:    @param x2, y2: other end of the line segment
 1841: 
 1842:    Outputs:
 1843:    @param side:  side that intersects the line segment (input and output)
 1844:    @param nextElement (output): element that contains the intersection point
 1845:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1846:    @param zint (input/output): Vertical coordinate of the intersection point
 1847: 
 1848:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1849:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1850:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1851: 
 1852:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1853:    (Delta) being zero.
 1854: 
 1855:    The intersection2 point happens when:
 1856:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1857:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1858:    
 1859:    Assumption: the 4 points (including those of the side segment) are different.
 1860:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1861:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1862:    If true, (xIntersect,yIntersect) is the intersection.				
 1863:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1864: **/
 1865: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1866:                                               double &t, double& tIntersect) {
 1867: 
 1868:    double closest_intersect_t = 1e10;
 1869:    bool found_intersection = false;
 1870: 
 1871:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1872:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1873:    const Point2 x1 = side->point(t);
 1874:    
 1875: 
 1876:    Side *nextSide = nullptr;
 1877:    for (int i = 0; i < i34; i++) {
 1878: 
 1879:       // Element's i-th side 
 1880:       Side *side2 = sides[i];
 1881: 
 1882:       // Skip the side that contains the initial point
 1883:       if (side2 == side) continue;
 1884: 
 1885:       // (x3,y3)-(x4,y4) is the element side line
 1886:       const Point2 x3 = side2->n1->p;
 1887:       const Point2 x4 = side2->n2->p;
 1888: 
 1889:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1890:       const double delta = cross(x2 - x1, x3 - x4);
 1891: 
 1892:       if (delta != 0.0) {
 1893: 
 1894:          const double delta1 = cross(x3 - x1, x3 - x4);
 1895:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1896: 
 1897:          // Solves the two linear equations for tt1 and tt2
 1898:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1899:          const double tt2 = delta2/delta;
 1900: 
 1901:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1902:             closest_intersect_t = min(closest_intersect_t, tt1);
 1903:             nextSide = side2;
 1904: 
 1905:             nextElement = nextSide->otherElem(this);
 1906:             tIntersect = max(small, min(tt1, 1.0-small));
 1907:             t = tt2;
 1908: 
 1909:             found_intersection = true;
 1910:          }
 1911:       
 1912:       }
 1913: 
 1914:    }
 1915: 
 1916:    // found_intersection should always be true, since we checked all the sides.  
 1917:    side = nextSide;
 1918: 
 1919:    return found_intersection;
 1920: }
 1921: 
 1922: 
 1923: 
 1924: 
 1925: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1926:                                               double &t, double& tIntersect) {
 1927: 
 1928:    double closest_intersect_t = 1e10;
 1929:    bool found_intersection = false;
 1930: 
 1931:    for (int i = 0; i < i34; i++) {
 1932: 
 1933:       Side *side2 = sides[i];
 1934: 
 1935:       // (x3,y3)-(x4,y4) is the element side line
 1936:       const Point2 x3 = side2->n1->p;
 1937:       const Point2 x4 = side2->n2->p;
 1938: 
 1939:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1940:       const double delta = cross(x2 - x1, x3 - x4);
 1941: 
 1942:       if (abs(delta) > 0) {
 1943: 
 1944:          const double delta1 = cross(x3 - x1, x3 - x4);
 1945:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1946: 
 1947:          // Solves the two linear equations for tt1 and tt2
 1948:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1949:          const double tt2 = delta2/delta;
 1950: 
 1951:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1952:             closest_intersect_t = min(closest_intersect_t, tt1);
 1953:             side = side2;
 1954:             nextElement = side->otherElem(this);
 1955:             t = tt2;
 1956:             tIntersect = max(small, min(tt1, 1.0-small));
 1957:             found_intersection = true;
 1958:          }
 1959:       
 1960:       }
 1961:       else {  // parallel segments
 1962: printf("@@@@@@@ZZZ@@@@@@@@@ Parallel segments\n");
 1963: t = 0.0;
 1964: tIntersect = 0.0;
 1965: side = side2;
 1966: nextElement = this;
 1967: return true; //XXXXXXXXXXXXX    KKKKKK
 1968: 
 1969: 
 1970:          assert(false && "Parallel segments");
 1971:          // // In this case, we check if they are colinear. if they are, we compute the intersection point as:
 1972:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1973: 
 1974:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1975: 
 1976:          // const double dist = dot(x1 - x3, side2->n);
 1977:          // if (abs(dist) < small*length(x3 - x4)) {
 1978:          //    const double2 unitarySide = normalize(x4 - x3);
 1979:          //    const double len = dot(x2 - x1, unitarySide);
 1980:          //    t = t + len;
 1981:          //    t = max(0.0, min(t, 1.0));
 1982:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1983: 
 1984: 
 1985:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1986:          //    // t = tt2;
 1987:          //    found_intersection = true;
 1988:          // }
 1989:       }
 1990: 
 1991: 
 1992:    }
 1993: 
 1994:       
 1995:    assert(found_intersection && "No intersection found");
 1996: 
 1997:    // found_intersection should always be true, since we checked all the sides.  
 1998:    return found_intersection;
 1999: }
