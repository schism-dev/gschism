 3983: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3984:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3985:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3986: 
 3987: 
 3988:    NODE(node1);
 3989: 
 3990:    node1->clearMatrixRow();
 3991:    node1->qel = 0.0;
 3992: 
 3993:    // THIS IS FOR STRUCTURES XXX
 3994:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3995: 
 3996:    
 3997:    for (int j=0; j<node1->numElements; j++) {
 3998:       // For each element connected to the node...
 3999: 
 4000:       Element *elem = node1->elements[j];
 4001: 
 4002: 
 4003: 
 4004:       // Compute the average gravity
 4005:       const double grav3 = elem->mean(&Node::grav2);
 4006: 
 4007:       // Look at the documentation for the description of the terms in the following integrals
 4008: 
 4009:       // Integral I_1 
 4010:       // \bar{\breve{H}} 
 4011:       const double hhatb = elem->mean(&Side::hhat);        
 4012: 
 4013:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 4014: 
 4015:       const int id1 = elem->nodeLocalIdx(node1); 
 4016:       const double area = elem->area;
 4017: 
 4018:       if (elem->isTri()) {
 4019: 
 4020:          // To clarify the notation in this section: 
 4021:          //   i stands for the node under consideration (node1)
 4022:          //   j (node2) and k (node3) are the other nodes of the triangle.
 4023:          const int id2 = elem->nxq(1 + id1);
 4024:          const int id3 = elem->nxq(2 + id1);
 4025:          Node *node2 = elem->nodes[id2];
 4026:          Node *node3 = elem->nodes[id3];
 4027: 
 4028:          const Point2 x1 = node1->p;
 4029:          const Point2 x2 = node2->p;
 4030:          const Point2 x3 = node3->p;
 4031: 
 4032:          // integral of phi_i*phi_j
 4033:          const double ipp_ii = (1.0/6.0 )*area;
 4034:          const double ipp_ij = (1.0/12.0)*area;
 4035:          const double ipp_ik = (1.0/12.0)*area;
 4036: 
 4037:          // integral of [(grad phi_i) * (grad phi_j)]
 4038:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 4039:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 4040:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 4041: 
 4042:          // Computes the different components of integral I_1 of each node with respect to node i.
 4043:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4044:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4045:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4046: 
 4047:          node1->addToSparseMatrix(node1, I1_ii);
 4048:          node1->addToSparseMatrix(node2, I1_ij); 
 4049:          node1->addToSparseMatrix(node3, I1_ik);
 4050: 
 4051:       }
 4052:       else { // Quad
 4053:          // XXX IMPLEMENT THIS
 4054:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 4055: 
 4056:          // To clarify the notation in this section: 
 4057:          //   i stands for the node under consideration (node1)
 4058:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 4059:          const int id2 = elem->nxq(1 + id1);
 4060:          const int id3 = elem->nxq(2 + id1);
 4061:          const int id4 = elem->nxq(3 + id1);
 4062:          Node *node2 = elem->nodes[id2];
 4063:          Node *node3 = elem->nodes[id3];
 4064:          Node *node4 = elem->nodes[id4];         
 4065: 
 4066:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 4067:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 4068:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 4069:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 4070:          const double ipp_il = elem->intPhiPhi(id1, id4);
 4071: 
 4072:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 4073:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 4074:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 4075:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 4076:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 4077: 
 4078:          // Computes the different components of integral I_1 of each node with respect to node i.
 4079:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4080:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4081:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4082:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 4083: 
 4084:          node1->addToSparseMatrix(node1, I1_ii);
 4085:          node1->addToSparseMatrix(node2, I1_ij); 
 4086:          node1->addToSparseMatrix(node3, I1_ik);
 4087:          node1->addToSparseMatrix(node4, I1_il);
 4088:   
 4089:       } 
 4090: 
 4091:  
 4092:       // Integral I_4
 4093:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 4094:       // Where
 4095:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 4096: 
 4097:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 4098:       // of U over the element.
 4099:       Vector2 U = {0.0, 0.0};
 4100:       for (int m=0; m < elem->i34; m++) {      
 4101:          const Side *side = elem->sides[m];
 4102: 
 4103:          if constexpr(ics == 1) U += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 4104:          else                   U += side->frame.project_hvec(side->U, elem->frame);
 4105:       }
 4106:       U = U/elem->i34;
 4107: 
 4108: 
 4109:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 4110: 
 4111: 
 4112:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 4113:       const double I_4_1 = dot(gradPhi_1, U);
 4114: 
 4115: 
 4116:       // Integral of \nabla\phi_i \cdot \pmb{E}
 4117:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 4118: 
 4119:      
 4120:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 4121: 
 4122:       // Additional terms 
 4123:       double vnorm = 0.0;
 4124:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 4125:          Vector3 ubed = {0.0, 0.0, 0.0};
 4126:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 4127: 
 4128:          Vector3 gradP = {0.0, 0.0, 1.0};
 4129:          for (int m=0; m < elem->i34; m++) {
 4130:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 4131:            gradP += toVector3(gradP_2D, 0.0);
 4132:          }   
 4133:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 4134:       } // imm==2
 4135: 
 4136:       if (elem->isTri()) {
 4137:          for (int l=0; l<3; l++) {
 4138: 
 4139:             Node *node = elem->nodes[l];
 4140: 
 4141:             double fac = (node == node1) ? 2.0 : 1.0;
 4142:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 4143:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 4144:            
 4145:          }
 4146: 
 4147: 
 4148:          if (!elem->isDry) {
 4149:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 4150: 
 4151:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 4152: 
 4153:          }
 4154: 
 4155:       } // isTri
 4156:       else { // isQuad
 4157:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 4158:          // for (int l=0; l<4; l++) {
 4159:          //   const Node *node = elem->nodes[l];
 4160: 
 4161:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 4162:          //   else        tmp2 = node->bdef2 - node->bdef1;
 4163: 
 4164:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 4165:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 4166:          // }
 4167: 
 4168:       } // isQuad
 4169: 
 4170: 
 4171:      node1->qel += (dt/elem->i34)*elem->vsource;
 4172:       
 4173: 
 4174:    } // for all elements connected to the node
 4175:    
 4176: 
 4177:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 4178:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 4179:    NodeBoundary *nodeBnd = node1->nodeBnd;
 4180:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 4181:       // If it is an open boundary node...
 4182: 
 4183:       // At least one open bnd side, maybe two
 4184:       for (int l=0; l<2; l++) { 
 4185: 
 4186:          // Gets each of the sides sharing the node. 
 4187:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 4188: 
 4189:        
 4190: 
 4191:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 4192:          if (sideBnd != nullptr) {
 4193:             // If the side is on a boundary...
 4194: 
 4195:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 4196: 
 4197:             // Get the boundary segment
 4198:             const BoundarySegment *sideSegment = sideBnd->segment;
 4199:             const Side *side = sideBnd->side;
 4200: 
 4201:             // Integral I_3
 4202:             if (sideSegment->ifltype != 0) {
 4203:             // Natural or Flather b.c.
 4204: 
 4205:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4206:                // especially for Flather b.c.
 4207:                double ri3 = 0.0;
 4208:                if (!side->isDry) {
 4209:                   // If the side is not dry
 4210:                   
 4211:                   // Computes the side flux of (uth, vth)
 4212:                   double Vn = 0.0;
 4213:                   for (int k = side->kb; k < nvrt - 1; k++) {
 4214:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4215:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4216: 
 4217:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 4218:                   }
 4219: 
 4220:                   ri3 = 0.5*side->len*Vn;
 4221:                }
 4222: 
 4223:                if (sideSegment->ifltype == -1) { // Flather 1
 4224: 
 4225:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4226:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4227: 
 4228:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4229:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4230:                   
 4231:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4232:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4233: 
 4234:                } 
 4235:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4236:                   // Reset ri3
 4237:                   ri3 = 0.0;
 4238: 
 4239:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4240: 
 4241:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4242: 
 4243:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4244:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4245: 
 4246:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4247:                   node1->addToSparseMatrix(node1, con0*2.0);
 4248:                   node1->addToSparseMatrix(node2, con0);
 4249: 
 4250:                } // if Flather or Discharge
 4251: 
 4252:                node1->qel -= thetai*dt*ri3;
 4253: 
 4254: 
 4255:             } // I_3
 4256:           
 4257: 
 4258:             // Integral I_5
 4259:             if(!side->isDry) {
 4260: 
 4261:                const double Unbar = dot(side->U, side->n);
 4262:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 4263: 
 4264:             } // I_5
 4265: 
 4266:          } // if is boundary side
 4267: 
 4268:       } // for l
 4269: 
 4270:    } // if isbnd
 4271: 
 4272: 
 4273: }
 4274: 
 4275: 
 4276: 
 4277: extern "C" {
 4278:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 4279:                                   int* indices, int* indptr) {
 4280: 
 4281:       NODE(node);
 4282:       
 4283:       const int idx = node->idx;
 4284:       
 4285:       // Computes the index in the nzz array      
 4286:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 4287: 
 4288: 
 4289:       indptr[idx] = nzzIdx;
 4290:       indices[nzzIdx] = idx;
 4291: 
 4292:       data_d[nzzIdx]    = node->coeffDiag;
 4293: 
 4294:       b_d[idx] = node->qel;
 4295: 
 4296:       for (int k = 0; k < node->numNodes; ++k) {
 4297:          const Node* nb = node->nodes[k];
 4298: 
 4299:          const int j = nb->idx;
 4300: 
 4301:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 4302: 
 4303:          indices[nzzIdx + k + 1] = j;
 4304:       }
 4305: 
 4306:  
 4307:    }
 4308: 
 4309: 
 4310: 
 4311:    __global__ void solverCopyResult(double* x) {
 4312:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 4313:       NODE(node);
 4314:       const int idx = node->idx;
 4315: 
 4316:       node->mX = x[idx];
 4317:    }
 4318: 
 4319: 
 4320:    __global__ void rollUpElevation(void) {
 4321: 
 4322:       NODE(node);
 4323: 
 4324:       node->eta1 = node->eta2;
 4325: 
 4326:    }
 4327: 
 4328: 
 4329:    __global__ void backtrackAllNodes(void) {
 4330: 
 4331:       // max/min # of sub-divisions
 4332:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4333:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4334: 
 4335: 
 4336:       SIDE(side);
 4337: 
 4338:       const int kb = side->kb;
 4339: 
 4340: 
 4341:       // Initialize btrack velocities to the actual velocities at the side 
 4342:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4343: 
 4344:   
 4345: 
 4346:       if (side->isDry) return;
 4347:       
 4348: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4349: 
 4350:       // Checks that at least one element is not dry
 4351:       const Element *elem1 = side->elems[0];
 4352:       const Element *elem2 = side->elems[1];
 4353: 
 4354: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4355: 
 4356:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4357:       
 4358:       // XXXXXX
 4359:       // !swild_tmp to store global coord. of the starting side
 4360:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4361:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4362:       // !Use sframe2 
 4363:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4364: 
 4365: 
 4366:       for (int k = kb; k < nvrt; k++) {
 4367:       //  Initialize (xt,yt,zt), nnel and vel.
 4368:       //  For ics=2, the coordinates are in local frames
 4369:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 4370: 
 4371: 
 4372:          const int iadvf = side->iadv();  // Advection flag   
 4373:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4374: 
 4375:          Point3 xt;
 4376:          if constexpr(ics==1) {
 4377:             xt = side->center3D(k); 
 4378:          }
 4379:          else // lat/lon; in side lat/lon frame
 4380:          {
 4381:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 4382:          // XXX IMPLEMENT THIS
 4383:       //          xt=0.d0
 4384:       //          yt=0.d0
 4385:       //          !centroid coord. for nudging
 4386:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 4387:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 4388:          }  // ics
 4389: 
 4390: 
 4391: 
 4392:          // If on land or open boundary...
 4393:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 4394:          
 4395:          const double vmag = length(side->u2[k]);
 4396: 
 4397:          if (vmag <= velmin_btrack) {
 4398:             // No activity 
 4399: 
 4400:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4401: // addDebugPlot(side->center, side->center, 0x00000F, '+');     
 4402: 
 4403: 
 4404:             
 4405:          } else {  // do btrack
 4406: 
 4407:             // Compute number of sub-divisions based on local gradients of the velocity field
 4408: 
 4409:             // XXX IS THIS NECESSARY?
 4410:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4411:             double suma = 0.0;
 4412:             int icount = 0;
 4413:             for (int l=0; l<2; l++) {
 4414:             // For each element sharing the side...
 4415: 
 4416:                const Element *elem = side->elems[l];
 4417:                  
 4418:                if (elem == nullptr) continue;
 4419: 
 4420:                icount++;
 4421: 
 4422:                // Not strictly along z; in ll frame for ics=2
 4423: 
 4424:                ShapeCoords utmp, vtmp;
 4425:                for (int j = 0; j < elem->i34; j++) {
 4426: 
 4427:                   const Node *node = elem->nodes[j];
 4428: 
 4429:                   if constexpr(ics==1) {
 4430:                      utmp[j] = node->u2[k].x;
 4431:                      vtmp[j] = node->u2[k].y;  
 4432:                   } else {
 4433:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 4434:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(j),vtmp0(j))
 4435:                   }
 4436:                } // for j
 4437: 
 4438:                const Vector2 grad_u = elem->grad2(utmp); 
 4439:                const Vector2 grad_v = elem->grad2(vtmp);
 4440: 
 4441:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4442:             } // for ii
 4443: 
 4444:             assert(icount > 0 && "Impossible 77");
 4445: 
 4446:             // '4' is somewhat arbitrary
 4447:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4448: 
 4449:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4450: 
 4451:             Vector3 u_int = {0.0, 0.0, 0.0};
 4452: 
 4453:             
 4454:             side->btu[k] = side->btrack(k, dt, dtbk);
 4455: 
 4456:                
 4457:          } // if vmag (do backtrack)
 4458: 
 4459: 
 4460:       } // for k=kb,nvrt-1
 4461: 
 4462:    }
 4463: 
 4464: } // extern "C"
 4465: 
 4466: template<int nc>
 4467: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4468: 
 4469: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4470: //
 4471: // a,b,c,rhs: input vectors and are not modified by this program.
 4472: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4473: // rhs is the r.h.s.
 4474: // n: actual rank of the system.
 4475: // rows in u() and rhs();
 4476: // u: output with nc columns (transposed to rows)
 4477: // gam: a working array.
 4478: //
 4479: // NOTES:
 4480: // This is a template function that allows for different numbers of columns in the rhs vector.
 4481: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4482: 
 4483:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4484:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4485: 
 4486:    double bet = b[0];
 4487:    if constexpr (nc == 1) {
 4488:       u[0] = rhs[0]/bet;
 4489:    } else {
 4490:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4491:    }
 4492: 
 4493:    for (int j = 1; j < n; j++) {
 4494:       gam[j] = c[j - 1]/bet;
 4495:       bet = b[j] - a[j]*gam[j];
 4496: 
 4497:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4498: 
 4499:       if constexpr (nc == 1) {
 4500:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4501:       } else {
 4502:          for (int l = 0; l < nc; l++) {
 4503:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4504:          }
 4505:       }
 4506:    }
 4507: 
 4508:    // Back-substitution
 4509:    for (int j = n - 2; j >= 0; j--) {
 4510:       if constexpr (nc == 1) {
 4511:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4512:       } else {
 4513:          for (int l = 0; l < nc; l++) {
 4514:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4515:          }
 4516:       }
 4517:    }
 4518: }
 4519: 
 4520: 
 4521: 
 4522: // Helper function that contains the core algorithm
 4523: template<typename XAccessor, typename YAccessor>
 4524: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4525:                                     double  yp_top, double  yp_bot, 
 4526:                                     CubicSpline &spline) {
 4527:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4528:    // 
 4529:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4530:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4531:    //
 4532:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4533:    // 
 4534:    // Inputs: 
 4535:    //            n: dimension for x etc; # of data pts (>=2);
 4536:    //            getX, getY: functions to access x,y coordinates
 4537:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4538:    //     Output: 
 4539:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4540: 
 4541:    const int n = k2 - k1 + 1;
 4542:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4543: 
 4544:    // Allocate memory for the splines
 4545:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4546:    spline.x   = new double[n];
 4547:    spline.y   = new double[n];
 4548:    spline.yp  = new double[n];
 4549:    spline.ypp = new double[n];
 4550: 
 4551:    for (int k=k1; k<=k2; k++) {
 4552:       spline.x[k] = getX(k);
 4553:       spline.y[k] = getY(k);
 4554:    }
 4555: 
 4556:    // This is to simplify expressions later
 4557:    double *x = spline.x;
 4558:    double *y = spline.y;
 4559: 
 4560:    double *a = nullptr;
 4561:    double *b = nullptr;
 4562:    double *c = nullptr;
 4563:    double *gam = nullptr;
 4564:    double *rhs = nullptr;
 4565:    
 4566: 
 4567:       a = new double[n];   // Lower diagonal
 4568:       b = new double[n];   // Diagonal
 4569:       c = new double[n];   // Upper diagonal
 4570:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4571:       rhs = new double[n]; // Right-hand side
 4572: 
 4573:    for (int k=k1; k<=k2; k++) {
 4574:       if (k == k1) {
 4575:          // Bottom level
 4576:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4577:          b[k] = (x[k+1] - x[k])/3.0;
 4578:          c[k] = b[k]/2.0;
 4579:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4580:       } else if (k == n - 1) {
 4581:          // Top level (surface)
 4582:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4583:          b[k] = (x[k] - x[k-1])/3.0;
 4584:          a[k] = b[k]/2.0;
 4585:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4586:       } else {
 4587:          // Intermediate levels
 4588:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4589:          b[k] = (x[k+1] - x[k-1])/3.0;
 4590:          a[k] = (x[k  ] - x[k-1])/6.0;
 4591:          c[k] = (x[k+1] - x[k  ])/6.0;
 4592:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4593:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4594:       }
 4595:    }
 4596: 
 4597:    // Solve the tridiagonal system
 4598:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4599:    
 4600:    spline.yp[k1] = yp_bot;
 4601:    spline.yp[k2] = yp_top;
 4602: 
 4603:    // Compute rest of 1st derivatives using the splines
 4604:    for (int k=k1+1; k<k2; k++) {
 4605:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4606:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4607:    }
 4608:    
 4609:    delete[] a;
 4610:    delete[] b;
 4611:    delete[] c;
 4612:    delete[] gam;
 4613:    delete[] rhs;
 4614: 
 4615: }
 4616: 
 4617: // Array version
 4618: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4619:                                 double y_top, double y_bot, 
 4620:                                 CubicSpline &spline) {
 4621:    auto getX = [x] (int k) { return x[k]; };
 4622:    auto getY = [y] (int k) { return y[k]; };
 4623:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4624: }
 4625: 
 4626: // Lambda version - allows custom access patterns
 4627: template<typename XFunc, typename YFunc>
 4628: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4629:                                 double y_top, double y_bot,
 4630:                                 CubicSpline &spline) {
 4631:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4632: }
