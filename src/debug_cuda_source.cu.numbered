 5692: #ifdef DONTCOMPILE
 5693: __device__ void computeVerticalAdvection(void) {
 5694:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 5695: 
 5696:    sdbt(1:2,:,:)=0.d0
 5697: 
 5698:    const Side *side = FROM kernel;
 5699: 
 5700:    if(side->isDry) return;
 5701: 
 5702:    // If side is wet...
 5703: 
 5704: 
 5705:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 5706:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 5707:    double ws[nvrt] = {} // w @ side
 5708:    int icount = 0;
 5709:    for (int j=0; j<2; j++) {
 5710:       const Element *elem = side->elements[j];
 5711:        
 5712:       if(elem != nullptr) {
 5713:          icount++;
 5714:          for (int k=0; k<nvrt; k++) {
 5715:             ws[k] = ws[k] + elem->w[k];
 5716:          }
 5717:       }
 5718:    }  // for j
 5719: 
 5720:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 5721:    ws = ws/icount;
 5722: 
 5723:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 5724:    // Splines allow for a smooth transition between vertical levels.
 5725:    // Splines have continuity restrictions at the internal knots, but
 5726:    // we have to provide the 1st derivatives at the endpoints.
 5727:    const int kbs = side->kbs; 
 5728:    
 5729:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 5730:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 5731:    initCubicSpline(kbs, nvrt, side, ws, up)
 5732: 
 5733:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 5734:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 5735:    initCubicSpline(kbs, nvrt, side, ws, vp)
 5736: 
 5737:    // Total advection (average onto side)
 5738:    const Node *node1 = side->nodes[0];
 5739:    const Node *node2 = side->nodes[1];
 5740:    for (int k=kbs(i); k<nvrt; k++) {
 5741: 
 5742:       if constexpr(ics==1) {
 5743:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 5744:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 5745:       } else {
 5746:          // XXX IMPLEMENT THIS
 5747:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 5748:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 5749:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 5750:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 5751:       }  // if ics
 5752: 
 5753: 
 5754:    }
 5755: }
 5756: #endif
 5757: 
 5758: 
 5759: extern "C" {
 5760:    __global__ void computeElemAverageGhat(void) {
 5761:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 5762: 
 5763:       ELEM(elem);
 5764:       
 5765:       elem->ghat1= {0.0, 0.0};  
 5766: 
 5767:       if constexpr(ihydraulics != 0) {
 5768:          if (nhtblocks > 0 && elem->isblock) return;
 5769:       }
 5770: 
 5771:       if (elem->isDry) return;
 5772: 
 5773:       // Wet elements.
 5774:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 5775:       // tidal potential, horizontal diffusion, and baroclinic etc
 5776:       // Remember to update both fb and F 
 5777:       // If ics=2, ghat1 are in eframe (ll)
 5778:       // cff1-3: coefficients for 2D/3D
 5779:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 5780:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 5781:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 5782: 
 5783:       double av_cff1 = 0.0;  // av. for cff1
 5784:       double av_cff2 = 0.0;  // av. for cff2
 5785:       double av_cff3 = 0.0;  // av. for cff3
 5786:       double av_df = 0.0;  // av. for H^\alpha / H
 5787:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 5788:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 5789: 
 5790:       const int i34 = elem->i34;
 5791:       const int kb = elem->kb;
 5792: 
 5793:       for (int j=1; j<i34; j++) {
 5794:          // For each node and side in the element...
 5795: 
 5796:          const Node *node = elem->nodes[j];
 5797:          const Side *side = elem->sides[j];
 5798: 
 5799:          const double chi      = side->chi;
 5800:          const double veg_c2   = side->veg_c2;
 5801:          const double veg_beta = side->veg_beta;
 5802:          const double veg_h    = side->veg_h();
 5803:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 5804: 
 5805:          // Node - const in elem
 5806:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 5807:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 5808: 
 5809:          if (elem->depth >= tip_dp) {
 5810:            elem->gradETP += node->ETP*elem->gradPhi[j];
 5811:          }
 5812: 
 5813:          
 5814:          const double htot  = side->htot2();        // Total depth at the side
 5815:          const double zctr2 = side->zTopCanopy();  
 5816: 
 5817:          double cff1; 
 5818:          double cff2; 
 5819:          double cff3;   
 5820:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 5821:          // coefficients applied to 2D/3D case 
 5822:             cff1 = side->hhat/htot;
 5823:             cff2 = 0.0;
 5824:             cff3 = 0.0;
 5825:          } else { //3D
 5826:             //Init for no-veg case
 5827:             cff1 = 1.0;
 5828:             cff2 = 1.0;
 5829:             cff3 = 0.0;
 5830: 
 5831:             if constexpr(iveg != 0) {
 5832:                // Computes coefficients used with vegetation terms G1, G2
 5833:                // cff1, cff3 are used for the first two terms in G1, G2:
 5834:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 5835:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 5836:                // In general, cff1*Ustar - cff3*Ustar_alpha
 5837:                if(veg_h < 0.99*htot) { // submergent vegetation
 5838:                   cff1=1;
 5839:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 5840:                   cff3 = veg_c;
 5841: 
 5842:                } else { // emergent vegetation
 5843:                   cff1 = 1.0/(1.0 + veg_c2);
 5844:                   cff2 = cff1;
 5845:                   cff3 = 0.0;
 5846: 
 5847:                }
 5848:             } // if iveg
 5849:          } //  2D/3D
 5850: 
 5851:          av_cff1 += cff1/i34;
 5852:          av_cff2 += cff2/i34;
 5853:          av_cff3 += cff3/i34;
 5854:          av_cff2_chi += cff2*chi/i34;
 5855:          av_cff3_chi += cff3*chi/i34;
 5856:          av_df += min(htot, veg_h)/(htot*i34);
 5857: 
 5858: 
 5859:          // btrack values: U^\star, U^{\star\alpha}
 5860:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 5861:          Vector2 Ustar       = {0.0, 0.0}; 
 5862:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 5863: 
 5864:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 5865:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 5866:          } else { //3D
 5867:             for (int k = side->kb; k < nvrt; k++) {
 5868:             
 5869:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 5870:                Ustar += w2;
 5871: 
 5872:                if constexpr(iveg != 0) {
 5873:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 5874:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 5875:                        Ustar_alpha += zrat*w2; // XXXX
 5876:                    }
 5877:                }  // if iveg
 5878:             }  // for k
 5879:          }  //2D/3D
 5880:          
 5881: 
 5882:          // Add btrack & surface stress terms to \breve{G} first
 5883:          if constexpr(ics==1) {
 5884:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 5885:          } else {
 5886:             // XXX IMPLEMENT THIS
 5887:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 5888:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 5889:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 5890:          }  // if ics
 5891: 
 5892:          // Surface and bottom stress terms
 5893:          if constexpr(ics==1) {
 5894:             const Vector2 tau    = side->tau();
 5895:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 5896: 
 5897:             // Term for surface and bottom stress
 5898:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 5899:          } else {
 5900:             // XXX IMPLEMENT THIS
 5901:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 5902:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 5903:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 5904:             // tau_x=(vn1+tt1)/2.d0
 5905:             // tau_y=(vn2+ss1)/2.d0
 5906:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 5907:          }  // if ics
 5908: 
 5909:          
 5910: 
 5911:          // All terms in F,F^\alpha,f_b except baroclinic
 5912:          // F, f_b: all explicit terms excluding vegetation 
 5913:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 5914:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 5915:          const double coriolis = side->coriolis;
 5916:          Vector2 F  =  coriolis*side->U;  // F_x
 5917:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 5918:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 5919: 
 5920:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 5921:             
 5922:             for (int k = side->kb; k < nvrt; k++) {
 5923:                if (zctr2 > side->zc[k-1]) {
 5924:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 5925:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 5926:                    Fa +=  coriolis*w2*zrat;
 5927:                } // if zctr2
 5928:             } // k
 5929:          } // iveg
 5930: 
 5931:          // Integrate horizontal viscosity force vertically
 5932:          for (int k=side->kb + 1; k<nvrt; k++) {
 5933:             const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.0; 
 5934: 
 5935:             F += levelHorVisc;
 5936: 
 5937:             // Vegetation term
 5938:             if constexpr(iveg!=0) {
 5939:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 5940:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 5941:                   Fa += levelHorVisc*zrat;
 5942:                } 
 5943:             } // if iveg
 5944:          } // for k
 5945: 
 5946:          fb += side->d2uv[side->kb];
 5947: 
 5948: 
 5949:          // Add to ghat1
 5950:          if constexpr(ics==2) {
 5951:             // XXX IMPLEMENT THIS
 5952:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 5953:             // bigf1=vn1; bigf2=vn2
 5954:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 5955:             // botf1=vn1; botf2=vn2
 5956:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 5957:             // bigfa1=vn1; bigfa2=vn2
 5958:          } // if ics
 5959: 
 5960:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 5961:       } // for j (nodes and sides)
 5962: 
 5963:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 5964:          
 5965:       // Finish off terms in F, F^\alpha and f_b
 5966:       const double grav3 = elem->mean(&Node::grav2);
 5967:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 5968: 
 5969: 
 5970:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 5971:       for (int j=1; j<i34; j++) { 
 5972:          // For each side in the element...
 5973:          const Side *side = elem->sides[j];
 5974:          const double chi = side->chi;
 5975: 
 5976:          const double htot = side->htot2();
 5977:          const double veg_h = side->veg_h();
 5978:          const Vector2 F  = htot*fb;
 5979:          const Vector2 Fa = min(htot, veg_h)*fb;
 5980: 
 5981:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 5982:       } // for j
 5983: printf("$$$ tmp = %.15g, %.15g\n", tmp.x, tmp.y);
 5984:       //botf1 etc are already in elem frame
 5985:       elem->ghat1 += tmp/i34;
 5986: 
 5987:       // Baroclinic force
 5988:       if constexpr(ibc==0) {
 5989:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 5990: 
 5991:          Vector2 Fa = {0.0, 0.0};
 5992:          Vector2 intGradRho = {0.0, 0.0};
 5993:          
 5994:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 5995:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 5996:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 5997: 
 5998:             // \in F [m^2/s/s]
 5999:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6000:          }
 6001: 
 6002:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6003:          const Vector2 F = av_df*Fa; //approx
 6004:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6005: 
 6006:       } // if ibc
 6007: 
 6008: 
 6009: 
 6010:    }
 6011: 
 6012: } // extern "C"
 6013: 
 6014: 
 6015: 
 6016: #ifdef DONTCOMPILE
 6017: __global__ void checkMassConservation(Tracers* sumtr) {
 6018: 
 6019:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6020: 
 6021:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6022: 
 6023:    Element *elem = &(mesh->localElemData[i]);
 6024: 
 6025:    // Skip dry elements
 6026:    if (elem->isDry) return;
 6027: 
 6028:    // Local sum array for this thread
 6029:    double localSum[N_TRACERS] = {0.0};
 6030: 
 6031:    // Sum over vertical levels for this element
 6032:    const int kbe = elem->kbe;
 6033:    const double area = elem->area;
 6034: 
 6035:    for (int k = kbe; k < nvrt; k++) {
 6036:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6037:       
 6038:       // Accumulate tracer mass
 6039:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6040:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6041:       }
 6042:    }
 6043: 
 6044:    
 6045: 
 6046:    //  This function returns per element sums. A reduction must be done on the host side.
 6047: }
 6048: 
 6049: 
 6050: __global__ void transport(void) {
 6051: 
 6052:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6053: 
 6054:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6055: 
 6056:    Element *elem = &(mesh->localElemData[ie]);
 6057: 
 6058:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6059: 
 6060:                for (int m=0; m<ntr; m++) {
 6061:                   for (int k=kbe(ie); k<nvrt; k++) {
 6062:                      // Calculate each polynomial's weight 
 6063:                      wm=0.d0; sum1=0.d0; 
 6064:                      wm1=0.d0; wm2=0.d0; 
 6065:                      for (int i=0; i<elem->nweno2; i++) {
 6066:                   
 6067:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6068:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6069:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6070:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6071:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6072:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6073:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6074:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6075:                      // -----------------Hu and Shu (1999)'s method----------------
 6076:                      b4=b1+b2+b3
 6077: 
 6078: //Error: add PRODUCTION CPP
 6079: #ifdef DEBUG
 6080:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6081:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6082:                     call parallel_abort(errmsg)
 6083:                   }
 6084: #endif
 6085: 
 6086:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6087:                   // !----test-------------- 
 6088:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6089:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6090:                   // !wm(i)=wm1(i)*wm2(i)
 6091:                   // !---------------------- 
 6092:                   sum1=sum1+wm(i)
 6093:                 } // end for i
 6094: 
 6095:                 wm=wm/sum1
 6096: 
 6097:                 for (int j=0; j<elem->i34; j++) {
 6098: 
 6099:                   const Side *side  = elem->sides[j];
 6100:                   const Node *node1 = side->n1;
 6101:                   const Node *node2 = side->n2;
 6102: 
 6103:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6104:                      trsd=0.d0
 6105:                      for (int kk=0; kk<nquad; kk++) {
 6106:                         for (int i=0; i<elem->nweno2; i++) {
 6107:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6108:                         } // end for i   
 6109:                      } // end for kk
 6110:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6111:                   } // outward flux
 6112:                } // end for j=1,i34(ie) ! side
 6113:             }
 6114:          }
 6115:               
 6116: 
 6117: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6118: //             //   calculate each polynomial's weight 
 6119: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6120: //                 wm=0.d0; sum1=0.d0
 6121: //                 do i=1,nweno1(ie) !for each polynomial
 6122: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6123: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6124: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6125: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6126: //                   wm(i)=b2
 6127: //                   sum1=sum1+b2
 6128: //                   !wm(i)=1.d0
 6129: //                   !sum1=sum1+1.d0
 6130: 
 6131: // // Error: PRODUCTION
 6132: // #ifdef DEBUG
 6133: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6134: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6135: //                     call parallel_abort(errmsg)
 6136: //                   endif
 6137: // #endif
 6138: 
 6139: //                 enddo !i
 6140: //                 wm=wm/sum1 !final weight
 6141: 
 6142:                 for (int j=0; j<elem->i34; j++) { // side
 6143:                   const Side *side = elem->sides[j];
 6144:                   const Node *node1 = side->n1;
 6145:                   const Node *node2 = side->n2;
 6146: 
 6147:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6148:                     trsd=0.d0
 6149:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6150:                       for (int i=0; i<elem->nweno1; i++) {
 6151:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6152:                       }
 6153:                     enddo //kk
 6154:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6155:                   } // outward flux
 6156:                 } // end for j=1,i34(ie) ! side
 6157:               } // end for k; ntr 
 6158: 
 6159:             else !simple upwind method
 6160:               do j=1,i34(ie)
 6161:                 jsj=elside(j,ie)
 6162:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6163:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6164:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6165:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6166:                   endif
 6167:                 enddo  !vertical layers
 6168:               enddo !j=1,i34(ie) ! side
 6169:             endif !order of accuracy
 6170: 
 6171:          //  enddo !ie
 6172: // !$OMP     end do
 6173: 
