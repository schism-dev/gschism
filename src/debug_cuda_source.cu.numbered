 2796: 
 2797: __device__ double Node::compZCoord(int k) const {
 2798:    // Computes the z coordinate at level k.
 2799:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2800:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2801:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2802:    // used 
 2803: 
 2804:    assert(k >= 0 && k < nvrt && "ZCOOR: invalid level\n");
 2805:    
 2806:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2807: 
 2808:    if (isDry2()) return 0.0;  // XXXX I used to return 0.0
 2809: 
 2810:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2811: 
 2812:    if constexpr(ivcor == 2) {
 2813: 
 2814:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2815:       const double h_c = mesh->h_c;
 2816:       const double theta_f = mesh->theta_f;
 2817:       const double sinh_theta_f = mesh->sinh_theta_f;
 2818: 
 2819: 
 2820:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2821:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2822:       // once per time step/node.
 2823:       // CHECK: updateZCoordData
 2824: 
 2825:       //  To simplify comparisons, I define index versions of count variables.
 2826:       if      (k == ivrt)     return eta2; 
 2827:       else if (k == izlev)    return -hmod2;
 2828:       else if (k == kb)       return -depth;
 2829:       else if (k < izlev)     return mesh->ztot[k];
 2830:       else if (k > izlev) {
 2831:          const int ksig = k - izlev;
 2832: 
 2833:          if (hmod2 <= h_c) {
 2834:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2835: 
 2836:          } 
 2837:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 2838:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2839:             assert(false && "ZCOOR: invalid h_c\n");
 2840:          } 
 2841:          else {
 2842:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2843:                    h_c * mesh->sigma[ksig] + 
 2844:                    (hmod2 - h_c) * mesh->cs[ksig];
 2845:          }
 2846:       } else { 
 2847:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2848:       }
 2849: 
 2850:    }
 2851:    else if constexpr(ivcor == 1) {
 2852:       if (k == kb) return -depth;
 2853:       else if (k == nvrt-1) return eta2;
 2854:       else if (k > kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2855:    }
 2856:    
 2857:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2858:    return 0.0;
 2859: }
 2860: 
 2861: 
 2862: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 2863:    // Computes the bottom drag Cd based on the selected nchi
 2864: 
 2865:    if constexpr(nchi == 0) {
 2866:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 2867:       Cd = drag;  // Read from drag file
 2868: 
 2869:    } else if constexpr(nchi == 1) {
 2870:       // 
 2871: 
 2872:       bool ltmp = false; // for WBL iteration
 2873: 
 2874:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 2875:       if (isDry || (rough == 0.0)) {
 2876:          Cd = 0.0;
 2877: 
 2878:       } else { //roughness >0 
 2879:          
 2880:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 2881: 
 2882:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 2883: 
 2884:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 2885: 
 2886:       } // if rough
 2887: 
 2888:    } else if constexpr(nchi == -1) {
 2889:    // Manning 
 2890:  
 2891:       const double htot = max(hmin_man, htot2()); 
 2892:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 2893: 
 2894:    } else {
 2895:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 2896:       
 2897:    } // if nchi
 2898: 
 2899: }
 2900: 
 2901: 
 2902: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2903:    // Checks if a side in on the boundary
 2904:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2905: 
 2906:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2907:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2908: 
 2909:    // Indices of the nodes that form the side
 2910:    const int n1 = side.n1->idx;
 2911:    const int n2 = side.n2->idx;
 2912:    isLand = false;
 2913:    
 2914: 
 2915:    // Check if the side is on a land boundary
 2916:    for (int i = 0; i < nland; i++) {
 2917:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2918:          // Consecutive nodes in the land boundary segment
 2919:          const int b1 = ilnd[i + j*nland];
 2920:          const int b2 = ilnd[i + (j + 1)*nland];
 2921: 
 2922:          assert(b1 != -1 && b2 != -1);
 2923: 
 2924:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2925:             
 2926:             isLand = true;
 2927:             return i;
 2928:          }
 2929:       }
 2930:    }
 2931: 
 2932:    // Check if the side is on an open boundary
 2933:    for (int i = 0; i < nope; i++) {
 2934:       for (int j = 0; j < nond[i] - 1; j++) {
 2935:          // Consecutive nodes in the open boundary segment
 2936:          const int b1 = iond[i + j*nope];
 2937:          const int b2 = iond[i + (j + 1)*nope];
 2938: 
 2939:          assert(b1 != -1 && b2 != -1);
 2940: 
 2941:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2942:             isLand = false;
 2943:             return i;
 2944:          }
 2945:       }
 2946:    }
 2947: 
 2948:    return -1;
 2949: }
 2950: 
 2951: 
 2952: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 2953:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 2954:                                     double *wind_rotate_angle, 
 2955:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2956:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2957:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2958:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 2959:                                     double *drag, double *roughness, double *rmanning) {
 2960: 
 2961:    NODE(pnode);  
 2962:    const int i = idx_node;
 2963:    Node &node(*pnode);
 2964: 
 2965:    node.idx = i;
 2966: 
 2967:    const int idxNodeStart = nodeNeighNodesStart[i];
 2968:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2969:    node.numNodes = idxNodeEnd - idxNodeStart;
 2970:    node.nodes = nodeNeighNodes + idxNodeStart;
 2971:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2972: 
 2973: 
 2974: 
 2975:    const int idxElemStart = nodeNeighElemsStart[i];
 2976:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2977:    node.numElements = idxElemEnd - idxElemStart;
 2978:    node.elements = nodeNeighElems + idxElemStart;
 2979: 
 2980: 
 2981:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2982:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2983:       const int partNode = localNodePart[idxNodeGlobal]; 
 2984:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 2985: 
 2986:       Node *node_ptr = nodes[partNode] + idxNode;
 2987:       
 2988:       nodeNeighNodes[idx] = node_ptr;
 2989:    }
 2990: 
 2991: 
 2992:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2993:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2994:       const int partElem = localElemPart[idxElemGlobal];
 2995:       const int idxElem  = localElemIndices[idxElemGlobal];
 2996: 
 2997:       Element *elem_ptr = elems[partElem] + idxElem;
 2998: 
 2999:       nodeNeighElems[idx] = elem_ptr;
 3000:    }      
 3001: 
 3002:    node.wind_angle = wind_rotate_angle[i];
 3003: 
 3004: 
 3005:    node.p.x   = node_coords[i * 3];
 3006:    node.p.y   = node_coords[i * 3 + 1];
 3007:    node.depth = node_coords[i * 3 + 2];
 3008: 
 3009:    if (use_ll) {
 3010:    node.lon = node_coords_ll[i * 2    ]*deg2rad;
 3011:    node.lat = node_coords_ll[i * 2 + 1]*deg2rad;
 3012:    }
 3013: 
 3014: 
 3015:    node.numSides = 0;
 3016: 
 3017:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3018:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3019:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3020:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3021:    else assert(false && "populateNodes: selected nchi not implemented.");
 3022:    
 3023:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3024:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3025:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3026: 
 3027:    
 3028:    // Links the node to the boundary information
 3029:    if (isbnd[i] >= 0) {
 3030:      
 3031:       // Get the index of the node boundary
 3032:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3033: 
 3034:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3035:       node.nodeBnd->node = &node;
 3036: 
 3037:       node.nodeBnd->sideBnd1 = nullptr;
 3038:       node.nodeBnd->sideBnd2 = nullptr;
 3039: 
 3040:       if (isbnd[i]>=0) {
 3041: 
 3042:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3043:          
 3044:          node.nodeBnd->segment->ifltype = 3 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3045:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3046: 
 3047:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3048:          node.nodeBnd->segment->clen  = nan("1");
 3049:          node.nodeBnd->segment->carea = nan("1");
 3050: 
 3051:       }
 3052:    } else {
 3053: 
 3054:       node.nodeBnd = nullptr; // For internal nodes
 3055: 
 3056:       if (isbnd[i] == landSegment) {
 3057:          node.nodeBnd = &landBoundaryNode;
 3058:          node.nodeBnd->segment = &landBoundarySegment;
 3059:       }
 3060:       
 3061:    }
 3062:    
 3063:    // XXXX GAUSSIAN HILL VELOCITIES
 3064: #ifdef GAUSSIAN_HILL_VELOCITIES
 3065:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3066:       constexpr double rot_per = 3000.0;
 3067:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3068:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3069:    // XXXXX
 3070: #endif
 3071: 
 3072: }
 3073: 
 3074: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3075:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3076:                                     double *wind_rotate_angle,   
 3077:                                     int *isdel, int *isidenode, int *isbnd,
 3078:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3079:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3080:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3081:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3082:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3083:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3084:                                     double *drag, double *roughness) {
 3085: 
 3086: 
 3087:    SIDE(pside);
 3088:    Side &side(*pside);
 3089:    const int i = idx_side;
 3090: 
 3091:    side.idx = i;  
 3092:    
 3093:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3094:    const double fc   = 2.0*omega_e*sin(sfea0);
 3095:    const double beta = 2.0*omega_e*cos(sfea0);
 3096: 
 3097:    // finding the pointer to the nodes that form the side
 3098:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3099:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3100: 
 3101:    const int locidx_n1 = localNodeIndices[idx_n1];
 3102:    const int locidx_n2 = localNodeIndices[idx_n2];
 3103:    const int part_n1 =   localNodePart[idx_n1];
 3104:    const int part_n2 =   localNodePart[idx_n2];
 3105: 
 3106:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3107:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3108: 
 3109:    // Counts the number of sides connected to each node
 3110:    side.n1->numSides++;
 3111:    side.n2->numSides++;
 3112: 
 3113:    // Normal, unitary vector to the side
 3114:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3115:    side.n = normalize(side.n);
 3116: 
 3117:    // Side boundary type
 3118:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3119:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3120: 
 3121:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3122:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3123:    {
 3124:       bool isLand = false;
 3125:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3126:       
 3127:       if (isbs > -1) {
 3128:          // assert(isLand || isbs>=0);
 3129:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3130: 
 3131:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3132: 
 3133:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3134:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3135: 
 3136:          assert (isLand == side.sideBnd->segment->isLand);
 3137: 
 3138:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3139:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3140:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3141: 
 3142:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3143:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3144:          
 3145:          side.sideBnd->side = &side;
 3146: 
 3147:       }
 3148:       else {
 3149:          side.sideBnd = nullptr;
 3150:       }
 3151:    }
 3152:    else 
 3153:    {
 3154:       side.sideBnd = nullptr;
 3155:    }
 3156: 
 3157: 
 3158:    // finding the pointer to the elements that share the side
 3159:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3160:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3161: 
 3162:    if (idx_e1 > -1) {
 3163:       const int locidx_e1 = localElemIndices[idx_e1];
 3164:       const int part_e1 =  localElemPart[idx_e1];
 3165:       side.elems[0] = elems[part_e1] + locidx_e1;
 3166: 
 3167:    }
 3168:    else {
 3169:       side.elems[0] = nullptr;
 3170:    }
 3171: 
 3172:    if (idx_e2 > -1) {
 3173:       const int locidx_e2 = localElemIndices[idx_e2];
 3174:       const int part_e2 =  localElemPart[idx_e2];
 3175:       side.elems[1] = elems[part_e2] + locidx_e2;
 3176:    }
 3177:    else {
 3178:       side.elems[1] = nullptr;
 3179:    }
 3180: 
 3181:    // Compute the center of the side
 3182:    side.center = 0.5*(side.n1->p + side.n2->p);
 3183: 
 3184:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3185:    side.shapiro = shapiro0;
 3186: 
 3187: #ifdef GAUSSIAN_HILL_VELOCITIES
 3188: // XXXX
 3189: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3190: constexpr double rot_per=3000.0;
 3191: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3192: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3193: // XXXXX      
 3194: #endif
 3195:    // Compute the z level at the center of the side
 3196:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3197:    
 3198:    // Compute the length of the side
 3199:    const Vector2 vLen = side.n2->p - side.n1->p;
 3200:    side.len = sqrt(dot(vLen, vLen));
 3201: 
 3202: 
 3203:    // Compute the Coriolis coefficient
 3204: 
 3205:    if constexpr(ncor == -1 || ncor == 0) {
 3206:       side.coriolis = coricoef;
 3207:    }
 3208:    else {
 3209:       const double sphi = side.lat();  // Latitude at the center of the side
 3210: 
 3211: // XXXXXX ERROR WHEN use_ll is false??????
 3212:       if constexpr(ics == 1) {
 3213:          // XXXXXXX
 3214:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3215:       }
 3216:       else {
 3217:          side.coriolis = 2.0*omega_e*sin(sphi);
 3218:       }
 3219: 
 3220:    }
 3221: }
 3222: 
 3223: 
 3224: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3225:    double *node_coords, double *node_coords_ll, bool use_ll,
 3226:    double *wind_rotate_angle,   
 3227:    int *isdel, int *isidenode, int *isbnd,
 3228:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3229:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3230:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3231:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3232:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3233:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3234:    double *drag, double *roughness) {
 3235: 
 3236:    ELEM(pelem);
 3237:    Element &elem(*pelem);
 3238:    const int i = idx_elem;
 3239: 
 3240:    elem.idx = i;
 3241: 
 3242:    for (int j = 0; j < i34[i]; j++) {
 3243:       const int idxNode = elnode[i*4 + j];  
 3244:       const int idxSide = elside[i*4 + j];
 3245:       
 3246:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3247:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3248: 
 3249:       // Find the neighboring element  
 3250:       if (elem.sides[j]->elems[0] == &elem) {
 3251:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3252:       }
 3253:       else {
 3254:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3255:       }
 3256:       
 3257:    }
 3258: 
 3259:    elem.i34 = i34[i];
 3260: 
 3261:    // Compute the barycenter of the element and its depth
 3262:    elem.center = {0.0, 0.0};
 3263:    elem.depth = 0.0;
 3264:    for (int j = 0; j < i34[i]; j++) {
 3265: 
 3266:       elem.center += elem.nodes[j]->p/i34[i];
 3267:       elem.depth  += elem.nodes[j]->depth/i34[i];
 3268:    }
 3269: 
 3270: 
 3271:    
 3272:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3273:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3274: 
 3275:    elem.area = elem.computeSignedArea(); 
 3276:    elem.radius = sqrt(elem.area)/pi; 
 3277:    
 3278:    // Determines which way the normal vector to each side is oriented.
 3279:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3280:    for (int j = 0; j < i34[i]; j++)  
 3281:    {
 3282:       if (elem.sides[j]->elems[0] == &elem) {
 3283:          elem.ssign[j] =  1.0;
 3284:       }
 3285:       else {
 3286:          elem.ssign[j] = -1.0;
 3287:       }
 3288: 
 3289:    }
 3290: 
 3291:    // Derivatives of shape functions
 3292:    //  For ics=2, this is done inside element/ll frame XXX
 3293:    //  For quads, the derivative is evaluated at centroid
 3294:    for (int j = 0; j < elem.i34; j++) {
 3295:       const double area = elem.area;
 3296:       const int id2 = elem.nxq(1 + j);
 3297:       const int id3 = elem.nxq(2 + j);
 3298:       const int id4 = elem.nxq(3 + j);
 3299:       if (elem.isTri()) {
 3300:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3301:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3302:          // da1/dx = (y1 - y2)/(2*area)
 3303:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3304:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3305:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3306:       }
 3307:       else  { // Quad; evaluate at centroid
 3308:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3309:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3310:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3311:       } // if Tri
 3312: 
 3313:    } // for j   
 3314:    
 3315:    
 3316: 
 3317: }
 3318: 
 3319: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3320:                                             double *emo, double *efa, 
 3321:                                             double *umo, double *ufa, 
 3322:                                             double *vmo, double *vfa) {
 3323: 
 3324: 
 3325:    NODE_BND(nodeBnd);
 3326:    const int idx = idx_node_bnd;    
 3327: 
 3328:    nodeBnd->idx = idx;
 3329: 
 3330:    // Need to find the segment index and the index of the node on the segment
 3331:    int idxNode = -1;
 3332:    int iseg, i;
 3333:    for (iseg = 0; iseg < nope; iseg++) {
 3334:       // for each segment...
 3335:       for (i = 0; i < nond[iseg]; i++) {
 3336:          idxNode = iond[iseg + i*nope];
 3337:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3338:          
 3339:       }
 3340:    }
 3341: 
 3342:    assert(iseg < nope && "iseg is out of bounds");
 3343: 
 3344: found: // Jumped here when the node was found
 3345: 
 3346:    nodeBnd->isEssentialBC = true;
 3347:    nodeBnd->elbc = 0.0;
 3348: 
 3349:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3350: 
 3351:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 3352:       nodeBnd->efa[jfr] = efa[idx2];
 3353:       nodeBnd->emo[jfr] = emo[idx2];
 3354:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3355:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3356: 
 3357:    }
 3358:         
 3359: 
 3360: }
