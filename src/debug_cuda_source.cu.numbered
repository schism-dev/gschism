 2252: // /**
 2253: //    For a point (x1,y1) inside the element and a line segment (x1,y1)-(x2,y2), find the intersection point 
 2254: //    (xIntersect,yIntersect) and the side (intersectingSide) that it intersects.
 2255: 
 2256: //    Inputs:
 2257: //    @param x1, y1: point inside the element
 2258: //    @param x2, y2: other end of the line segment
 2259: 
 2260: //    Outputs:
 2261: //    @param intersectingSide:  side that intersects the line segment
 2262: //    @param nextElement: element that contains the intersection point
 2263: //    @param xIntersect, yIntersect: intersection point  
