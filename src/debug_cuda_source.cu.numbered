 5995: extern "C" {
 5996: 
 5997:    __global__ void scaleGravity(double loadtide_coef) {
 5998: 
 5999: 
 6000:       NODE(node);
 6001: 
 6002:       // SAL option: scale gravity
 6003:       if constexpr(iloadtide==2) {  // simple const
 6004:          node->grav2 = grav*(1.0 - loadtide_coef);
 6005: 
 6006:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 6007:         
 6008:           const double depth = max(node->depth, 0.0);
 6009:           const double tmp1 = sqrt(depth);
 6010:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 6011:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 6012:                              2.6969e-13*depth*depth*depth*tmp1;
 6013:           
 6014:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 6015:           
 6016: 
 6017: 
 6018:           node->grav2 = grav*(1.0 - beta_bar);
 6019: 
 6020:       } else {  // iloadtide=0,1
 6021:           node->grav2 = grav;
 6022: 
 6023:       }
 6024: 
 6025:    }
 6026: 
 6027: 
 6028:    __global__ void setWinds(double *xWind, double *yWind, double *pressAir) {
 6029:       NODE(node);
 6030: 
 6031:       const int idx = node->idx;
 6032:       Vector2 wind = {xWind[idx], yWind[idx]};
 6033: 
 6034:       if constexpr(nws != 0 && iwindoff != 0) {
 6035:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 6036:       }
 6037: 
 6038:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 6039:       node->setWind(wind);
 6040: 
 6041:       node->pr = pressAir[idx];
 6042:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 6043: 
 6044:    }
