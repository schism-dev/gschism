 7091:       const Node *node = mesh->localNodeData + idx_node;
 7092:       res[idx_node*size + idx_node] = node->coeffDiag;
 7093:       for (int j = 0; j < node->numNodes; j++) {
 7094:          Node* nbNode = node->nodes[j];
 7095:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7096:       }
 7097: 
 7098:    }
 7099:    
 7100: }
