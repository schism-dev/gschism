 8044: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 8045:    Element *elems = mesh->localElemData;
 8046: 
 8047:    *addr = elems;
 8048:    *sizeElement = sizeof(Element);
 8049:    switch (varCode) {
 8050:       case (int)VarCode::z:
 8051:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 8052:          *sizeType = sizeof(double);
 8053:          break;
 8054:       case (int)VarCode::x:
 8055:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 8056:          *sizeType = sizeof(Vector2);
 8057:          break;
 8058:       case (int)VarCode::area:
 8059:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 8060:          *sizeType = sizeof(double);
 8061:          break;
 8062:       case (int)VarCode::depth:
 8063:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 8064:          *sizeType = sizeof(double);
 8065:          break;
 8066:       case (int)VarCode::radius:
 8067:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 8068:          *sizeType = sizeof(double);
 8069:          break;
 8070:       case (int)VarCode::lonlat:
 8071:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 8072:          *sizeType = sizeof(double);
 8073:          break;
 8074:       case (int)VarCode::ghat:
 8075:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 8076:          *sizeType = sizeof(Vector2);
 8077:          break;
 8078:       case (int)VarCode::kb:
 8079:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 8080:          *sizeType = sizeof(int);
 8081:          break;
 8082:       case (int)VarCode::isdry:
 8083:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 8084:          *sizeType = sizeof(int);
 8085:          break;            
 8086:       case (int)VarCode::w:
 8087:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 8088:          *sizeType = sizeof(double);
 8089:          break;
 8090:       case (int)VarCode::FaceIndices:
 8091:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 8092:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 8093:          *sizeType = sizeof(Node);
 8094:          break;
 8095:       default:
 8096:          *offset = -1;
 8097:    }
 8098: }
