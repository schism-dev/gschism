 5758: 
 5759:    __global__ void computeVerticallyIntegratedVelocity(void) {
 5760: 
 5761:       SIDE(side);
 5762: 
 5763:       side->U = {0.0, 0.0}; 
 5764:          
 5765:       if(side->isDry) return;
 5766: 
 5767:       // Vertically integrated velocity U
 5768:       for (int k = side->kb; k < nvrt - 1; k++) { 
 5769:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 5770:          side->U += side->Dz(k + 1)*uc;  
 5771:       }
 5772: 
 5773:    }
 5774: 
 5775:    __global__ void computeBottomDragVegetation(void) {
 5776:       // UNFINISHED. CHECK THIS:
 5777:       // How many kernels are needed? Why so many for loops?
 5778:       // Is the loop on sides needed?
 5779: 
 5780:       NODE(node);
 5781: 
 5782: 
 5783:       const int    kb      = node->kb;
 5784:       const double htot    = node->htot2(); 
 5785:       
 5786:       if (node->isDry) {
 5787:          // Default values for dry nodes
 5788:          node->veg_alpha_vert_mean = node->veg_alpha0;
 5789:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 5790: 
 5791:          return;
 5792:        
 5793:       }
 5794: 
 5795:       // Computes bottom drag Cd based on the selected nchi
 5796:       node->computeBottomDragCd();
 5797:       
 5798: 
 5799: 
 5800:       //   Bottom stress in m^2/s^2
 5801:       if (node->rho[kb + 1] >= -98.0)
 5802:       {
 5803:          const double mag_u = length(node->u2[kb + 1]);
 5804:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5805: 
 5806:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5807:          // !sediment erosion: this part needs more documentation
 5808:       }
 5809:     
 5810: 
 5811: 
 5812:       // Compute vegetation parameters
 5813:       //--------------------------------
 5814: 
 5815:       // SAV constants
 5816:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5817:       constexpr double veg_cfpsi = 0.16;
 5818: 
 5819:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5820:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5821: 
 5822:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5823:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5824:          int kbin = 0; // bin index
 5825:          for (int k = kb; k < nvrt; k++) {
 5826:             // Computes node height above the bottom level
 5827:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5828:             assert(false && "Vertical variation of vegetation not implemented");
 5829: 
 5830:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5831:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5832:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5833:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5834:             // } else {
 5835:             //    // Find the bin at which the current vertical level is
 5836:             //    while (kbin<nbins_veg_vert) {
 5837:             //       const double zn = node->z[kbin];
 5838:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5839:             //          break;
 5840:             //       } // if
 5841:             //       kbin++;
 5842:             //    } // while
 5843:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5844: 
 5845:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5846:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5847:                
 5848:             //    // Linear interpolation of the vegetation parameters
 5849:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5850:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5851:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5852:             // } // if rl10
 5853: 
 5854:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5855: 
 5856:          } // for k
 5857: 
 5858: 
 5859:       } else { // Ganthy (iveg==2)
 5860:       //  Modify canopy height, diameter, and density
 5861: 
 5862:          // Make sure there is vegetation on this node
 5863:          if (node->veg_h_unbent > 0.0) {
 5864:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5865: 
 5866:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5867:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5868:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5869: 
 5870:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5871:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5872:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5873:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5874:          } // if veg_h_unbent
 5875: 
 5876:          for (int k = 0; k < nvrt; k++) {
 5877:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5878:          } // for k
 5879:       
 5880: 
 5881:       } // if iveg
 5882:      
 5883: 
 5884:       // Compute vertical mean of veg_alpha3D
 5885:       if (iveg != 0) {
 5886:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5887:          double sum1=0.0;
 5888:          double sum2=0.0;
 5889:          // Integrate over each level under the canopy...
 5890:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5891:             const double Dz = node->Dz(k);
 5892: 
 5893:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5894:             sum2 += Dz;
 5895: 
 5896:          } // for k
 5897:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5898:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5899: 
 5900:       } // if iveg
 5901: 
 5902:    }
 5903: 
 5904:    __global__ void computeVegetationAndDragParameters(void) {
 5905:       // Computes the vegetation and drag model parameters:
 5906:       // chi, \tilde\chi, beta, \breve{H}
 5907:       
 5908:       SIDE(side);
 5909: 
 5910:       side->hhat = 0.0;
 5911:       side->chi2 = 0.0;
 5912:       side->chi = 0.0;
 5913:       side->veg_c2 = 0.0;
 5914:       side->veg_beta = 0.0;
 5915: 
 5916:       if (side->isDry) return;
 5917: 
 5918:       const double htot = side->htot2();
 5919:       const int    kb   = side->kb;
 5920: 
 5921:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5922: 
 5923:       const double veg_h     = side->veg_h();
 5924:       const double veg_nv    = side->veg_nv();
 5925:       const double veg_c     = side->veg_c();
 5926:       const double veg_beta  = side->veg_beta;
 5927:       const double veg_alpha = side->veg_alpha_vert_mean();
 5928: 
 5929:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX recommended to change names, chi->chitilde, chi2->chi
 5930:       // Velocity magnitude at the bottom level
 5931:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0 - dt*swild2(k,1) to u2 (I think this only pertains to iupwind_mom \= 0)
 5932:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 5933:       side->chi2 = side->Cd()*vmag1;
 5934:       side->chi  = side->chi2;
 5935: 
 5936:       if constexpr(iveg != 0) {
 5937:          const Node *n1 = side->n1;
 5938:          const Node *n2 = side->n2;
 5939:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5940:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5941:       }
 5942: 
 5943:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5944: 
 5945:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5946:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5947:       double magUa = 0.0;
 5948:       if constexpr(iveg != 0) {
 5949:          if (side->is3D() && veg_h > 0.0) {
 5950:             // 3D wet side with veg...
 5951: 
 5952:             double magUa = 0.0;
 5953:             for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5954:                if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5955: 
 5956:                   // Velocity magnitude must be computed at the center of each level to perform the integration.
 5957:                   // The tricky part is to compute that velocity at the level that may be partially submerged.
 5958:                   const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5959: 
 5960:                   // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5961:                   const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5962: 
 5963:                   // Velocity magnitude at the bottom (l) of the level
 5964:                   const double ul = length(side->u2[k]);
 5965: 
 5966:                   const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5967:                   magUa += Dz*0.5*(uh + ul);
 5968: 
 5969:                } // if HasVegetation
 5970:             } // for k
 5971:             const double ua = magUa/min(htot, veg_h); // Vertical average
 5972: 
 5973:             // Computes beta, used for computing the stress term at the top of the canopy.      
 5974:             side->veg_c2 = veg_alpha*dt*ua; // >=0
 5975:             if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5976:                const double zCpy = side->zTopCanopy();
 5977:                const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5978:                const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5979:                const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5980:                const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5981:                side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5982:             } // if isSubmerged
 5983:          } // if is3D
 5984:       } // if iveg   
 5985: 
 5986:       // Computes the friction modified depth, \breve{H} in notes
 5987:       if (side->is2D()) { // 2D
 5988: 
 5989:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5990:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5991: 
 5992:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5993: 
 5994:          side->hhat = htot*htot/fricH; 
 5995: 
 5996:       } else { // 3D
 5997:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 5998: 
 5999:          if constexpr(iveg != 0) {
 6000:             
 6001:             if (side->isSubmerged()) { 
 6002:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 6003:                side->hhat -= veg_c*Hhat_alpha;
 6004: 
 6005:             } else { // Emergent
 6006:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 6007:             }
 6008:          } // if iveg
 6009: 
 6010:          // Enforce positivity for 3D model
 6011:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 6012:       } // if 3D
 6013: 
 6014:    }
 6015: 
 6016: 
 6017: 
 6018:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 6019:    // Computes the density gradient between two elements, e1 and e2.
 6020:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 6021:    // zero in the direction normal to the side. 
 6022:    // 
 6023:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 6024:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 6025:    //
 6026:    // Input:
 6027:    //    e1: Element
 6028:    //    e2: Neighbor element (or nullptr if boundary)
 6029:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 6030:    //    k: Index of the half-level at which the density is interpolated
 6031:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 6032:    // 
 6033:    // Output:
 6034:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 6035:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 6036: 
 6037:       if (e2 == nullptr || e2->isDry) {
 6038:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 6039: 
 6040:          Side *side = e1->sides[j];
 6041:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 6042:                  
 6043:          if constexpr(ics == 1) {
 6044:             vec = side->n; // Normal vector to the side
 6045:          } else {
 6046:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6047:             // IMPLEMENT THIS XXXXXX
 6048:             // !replace with xel, yel?
 6049:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 6050:             //      &eframe(:,:,i),xn1,yn1,tmp)
 6051:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 6052:             //      &eframe(:,:,i),xn2,yn2,tmp)
 6053:          } //ics
 6054:                    
 6055:          diffRho = 0.0;
 6056: 
 6057:       } else { //internal and wet
 6058:          if constexpr(ics==1) {
 6059:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 6060: 
 6061:             // Vector from e1 to e2
 6062:             vec = e2->center - e1->center;
 6063: 
 6064:          } else { 
 6065:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6066:             // Remember that elem->center is in global coordinates
 6067:             // IMPLEMENT THIS XXXXXX
 6068:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 6069:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 6070:             //                   alow(j)=xctr2
 6071:             //                   bdia(j)=yctr2
 6072:          } // ics
 6073: 
 6074:          diffRho = rho2 - e1->demeanedDensity(k);
 6075:       }
 6076: 
 6077:    }
 6078: 
 6079:    __global__ void computeDensityCubicSplines(void) {
 6080:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 6081: 
 6082:       ELEM(elem);
 6083: 
 6084:       if (elem->isDry) return;
 6085: 
 6086:       const int kb = elem->kb;
 6087: 
 6088:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 6089:       if (elem->is2D()) {
 6090:          // In the 2D case, the density is constant at the prism level. 
 6091:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 6092:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 6093:       } else { //3D
 6094: 
 6095:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 6096:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 6097:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 6098:          ///// XXXX CHECK INDICES!!!!!
 6099:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 6100:       } // 2D/3D
 6101: 
 6102:    }
 6103: } // extern "C"
 6104: 
 6105: 
 6106: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 6107: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 6108: 
 6109:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 6110: 
 6111:    const int kb  = elem->kb;
 6112:    const int kb2 = elem2->kb;
 6113: 
 6114:    // z-coordinate of prism of elem
 6115:    const double zp = elem->z_prism(k);
 6116: 
 6117:    double rho = 0.0;
 6118: 
 6119:    if (elem2->is2D()) {
 6120:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 6121: 
 6122:    } else {  // 3D
 6123: 
 6124:       // eta_min may be < zmax
 6125:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 6126:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 6127: 
 6128:       // (Extrapolate density below bottom, we will fix it later)
 6129:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 6130:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 6131:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 6132:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 6133:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 6134:    } // 2D/3D
 6135:      
 6136: 
 6137:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 6138:    // Now we need to fix it.
 6139:    if (elem->z[k] < elem2->z[kb2]) {
 6140:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 6141: 
 6142:       // There are two methods to adjust the density at the bottom of the element.
 6143:       // iunder_deep=0: 
 6144:       const double depth1 = abs(elem->z[kb]); // larger depth
 6145: 
 6146:       if (iunder_deep==0) {
 6147: 
 6148:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 6149: 
 6150:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 6151: 
 6152:       } else { // iunder_deep != 0
 6153: 
 6154:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 6155: 
 6156:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 6157: 
 6158:          //   Demeaned density at the same z coordinate as
 6159:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 6160:          }
 6161: 
 6162:       } // if iunder_deep
 6163:    } // if elem->z[kb] < elem2->z[kb]
 6164: 
 6165:    return rho;
 6166: }
 6167: 
 6168: 
 6169: extern "C" {
 6170:    __global__ void computeDensityGradient(void) {
 6171: 
 6172:       assert(ibc == 1 && "baroclinic formulation is not implemented yet: ibc != 0");
 6173:       if constexpr(ibc != 0) return;
 6174: 
 6175:          // Compute the horizontal density gradient at each element.
 6176:       // It works in two steps:
 6177:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6178:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6179:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6180:       //             gradRho.r1 = rho1 - rho0
 6181:       //             gradRho.r2 = rho2 - rho0
 6182:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6183:       // 
 6184:       //  NOTE: We use de-meaned densities.
 6185: 
 6186:       ELEM(elem);
 6187: 
 6188:       if (elem->isDry) return;
 6189: 
 6190:       const int kb  = elem->kb;
 6191:       const int i34 = elem->i34;
 6192: 
 6193:       for (int k = kb + 1; k < nvrt; k++) {
 6194:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 6195:          //             gradRho.r1 = rho1 - rho0
 6196:          //             gradRho.r2 = rho2 - rho0
 6197:          int icount = 0;
 6198:          double sumRx = 0.0;
 6199:          double sumRy = 0.0;
 6200:          for (int j1=0; j1<i34; j1++) { 
 6201: 
 6202:             const int j2 = elem->nxq(j1 + 1);
 6203: 
 6204:             // Pairs of consecutive neighbor elements of elem
 6205:             const Element *e1 = elem->nghbElems[j1];
 6206:             const Element *e2 = elem->nghbElems[j2];
 6207: 
 6208:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 6209:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 6210:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 6211: 
 6212:             // Compute the density difference and the vector from elem to e1 and e2
 6213:             // getRhoDiffAndVec takes into account boundaries/dry elements
 6214:             double diffRho1, diffRho2;
 6215:             Vector2 vec1, vec2;
 6216:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 6217:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 6218: 
 6219:             const double rl1 = length(vec1);
 6220:             const double rl2 = length(vec2);
 6221:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 6222: 
 6223:             const double delta = cross(vec1, vec2);
 6224:             const double sintheta = abs(delta)/(rl1*rl2);
 6225: 
 6226:             // To avoid problems, avoid elements with small angle between vectors
 6227:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 6228:             const bool validEq = (sintheta > sin_one_deg);
 6229: 
 6230:             if (validEq) {
 6231:                // Solve the system of equations to get the density gradient at elem
 6232:                icount++;
 6233:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 6234:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 6235:                sumRx += Rx;
 6236:                sumRy += Ry;
 6237:             }
 6238:          } // for j1
 6239: 
 6240:          // Compute the average density gradient at elem
 6241:          if (icount==0) {
 6242:            // Bad mesh quality; bail out with 0 b-cc
 6243:            elem->gradRho[k] = {0.0, 0.0};
 6244:          } else {
 6245:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 6246:          }
 6247: 
 6248:       } // for k
 6249: 
 6250:    }
 6251: 
 6252:    __global__ void computeBaroclinicTerm(void) {
 6253:    // Computes the baroclinic term at sides (at half levels).
 6254:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 6255:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 6256: 
 6257:       if (ibc == 1) return;
 6258: 
 6259:       SIDE(side);
 6260: 
 6261:       if (side->isDry) return;
 6262: 
 6263:       const Element *e1 = side->elems[0];
 6264:       const Element *e2 = side->elems[1]; 
 6265:       const int kb = side->kb;
 6266:       
 6267:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 6268: 
 6269:       // interpolates vertically the density gradient of the two elements at the half level/
 6270: 
 6271:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 6272:       int k2 = max(kb, nvrt / 2);
 6273: 
 6274:       // Starts the integration at the surface and goes down to the bottom
 6275:       side->bcc[nvrt-1] = {0.0, 0.0};
 6276:       for (int k = nvrt - 2; k >= kb; k--) {
 6277:       // For each prism level (from surface to bottom)...
 6278: 
 6279:          // For both elements, interpolate density gradient at the side's half level.
 6280:          // The gradient at the side is the average of the gradients at the elements.
 6281:          // w1, w2 are used to take into account boundary sides, with just one element.
 6282:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 6283:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 6284:          const double wsum = w1 + w2;
 6285:          w1 = w1/wsum;
 6286:          w2 = w2/wsum;
 6287:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 6288: 
 6289:          // Linear interpolation of both elements' density gradient at the shared side's level.
 6290:          Vector2 gradRho = {0.0, 0.0};
 6291:          if (e1 != nullptr && k > kb) {
 6292:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 6293:             
 6294:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 6295:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 6296:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6297: 
 6298:             // Grad(rho) vertically interpolated at the side's half level
 6299:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 6300: 
 6301:             // Projects the element density gradient to the side frame if needed.
 6302:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 6303: 
 6304:             // Adds the contribution of the density gradient at the side's half level
 6305:             gradRho += gradRho1*w1;
 6306:          }      
 6307:          if (e2 != nullptr && k > kb) {
 6308:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 6309:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 6310:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6311:             
 6312:             // Grad(rho) vertically interpolated at the side's half level
 6313:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 6314: 
 6315:             // Projects the element density gradient to the side frame if needed.
 6316:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 6317: 
 6318:             // Adds the contribution of the density gradient at the side's half level
 6319:             gradRho += gradRho2*w2;
 6320:          }
 6321: 
 6322:          
 6323:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 6324:          // multiplied by -rampbc*(g/rho0) 
 6325:          const double grav3 = side->grav3();
 6326:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 6327: 
 6328:       } // for
 6329: 
 6330:    }
 6331: 
 6332: 
 6333: 
 6334:    __global__ void computeHorGradientAtSide(void) {
 6335: 
 6336:       // Compute the horizontal density gradient at each element.
 6337:       // It works in two steps:
 6338:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6339:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6340:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6341:       //             gradRho.r1 = rho1 - rho0
 6342:       //             gradRho.r2 = rho2 - rho0
 6343:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6344:       // 
 6345:       //  NOTE: We use de-meaned densities.
 6346: 
 6347:       SIDE(side);
 6348: 
 6349: 
 6350:       if (side->isDry) return;
 6351: 
 6352:       // Computes the gradient of the variables at the side center.
 6353:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 6354:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 6355:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 6356: 
 6357:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 6358:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 6359:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 6360:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 6361: 
 6362:    }
 6363: 
 6364: 
 6365:    __global__ void solveMomentumEquations(double time) {
 6366: 
 6367:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 6368:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 6369: 
 6370:       SIDE(side);
 6371: 
 6372:       if (side->isDry) 
 6373:       {
 6374:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 6375: 
 6376:          return;
 6377:       }
 6378: 
 6379:       const Node *n1 = side->n1;
 6380:       const Node *n2 = side->n2;
 6381: 
 6382:       const int kb = side->kb;
 6383: 
 6384:       const double veg_h = side->veg_h();
 6385:       const double grav3 = side->grav3();
 6386: 
 6387:       if (side->is2D()) {
 6388:          // Remember: Do not use htot2, which is updated.
 6389:          const double htot = side->htot1();
 6390:          const double hhat = side->hhat;
 6391: 
 6392:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 6393: 
 6394:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6395:          const Vector2 tau2 = side->tau();
 6396: 
 6397:          // hat_gam has units of m/s
 6398: 
 6399:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 6400:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 6401:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 6402: 
 6403:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 6404: 
 6405: 
 6406:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 6407: 
 6408:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 6409: 
 6410:       }
 6411:       else { // 3D
 6412: 
 6413:          // For 3D it is necessary to solve an implicit tridiagonal system.
 6414:          // 
 6415:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 6416:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 6417:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 6418:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 6419:          // k+1 and k.
 6420: 
 6421: 
 6422:          const int ndim = nvrt - kb;
 6423:          const double zTopCanopy = side->zTopCanopy();
 6424: 
 6425:          // Initialize the tridiagonal system
 6426:          for (int k = kb + 1; k < nvrt; k++) {
 6427:             
 6428:             const int kin = k - (kb + 1);
 6429: 
 6430:             // Vertical viscosity at the face center
 6431:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 6432: 
 6433:  
 6434:             alow[kin] = 0.0;
 6435:             cupp[kin] = 0.0;
 6436:             bdia[kin] = 0.0;
 6437: 
 6438:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 6439:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 6440: 
 6441:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 6442:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 6443:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 6444: 
 6445:             // First part: layers k, k+1
 6446:             if (k < nvrt - 1) {
 6447:                              
 6448:                if constexpr(iveg != 0) {
 6449: 
 6450:                   // If there is vegetation at this level...
 6451:                   if (zTopCanopy > side->zc[k]) {
 6452:                      // If the canopy is above the k layer...
 6453:                      
 6454:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 6455:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 6456:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 6457:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 6458: 
 6459:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 6460:                      const double vmag2 = length(ut2);
 6461:                      const double vmag1 = length(side->u2[k]);
 6462:                      const double vmag = 0.5*(vmag1 + vmag2);
 6463:                      
 6464:                      // Computes the vegetation alpha at the face center
 6465:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 6466: 
 6467:                      cff1 += veg_alpha_sd*dt*vmag;
 6468: 
 6469:                   } // if (zTopCanopy
 6470:                } // if iveg
 6471: 
 6472:                const double dzz = side->Dz(k + 1);
 6473:                const double tmp = dt*dfz/dzz;
 6474:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6475: 
 6476:                cupp[kin] += cff1*dzz/6.0 - tmp;
 6477:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6478:             }
 6479: 
 6480: 
 6481:             // Second part: layers k-1, k
 6482:             if (k > kb + 1) {
 6483: 
 6484:                double cff1 = 1.0; //init \bar{c^k}
 6485: 
 6486:                if constexpr(iveg != 0) {
 6487:                   // If there is vegetation at this level...
 6488:                   if (zTopCanopy > side->zc[k-1]) {
 6489:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 6490:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 6491: 
 6492:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 6493: 
 6494:                      const double vmag2 = length(ut2);
 6495:                      const double vmag1 = length(side->u2[k-1]);
 6496:                      const double vmag = 0.5*(vmag1 + vmag2);
 6497: 
 6498:                      // Computes the vegetation alpha at the face center
 6499:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 6500:                      cff1 += veg_alpha_sd*dt*vmag;
 6501:                   } // if zTopCanopy
 6502: 
 6503:                } // if iveg
 6504: 
 6505:                const double dzz = side->Dz(k);
 6506:                const double tmp = dt*dfz/dzz;
 6507:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6508: 
 6509:                alow[kin] += cff1*dzz/6.0 - tmp;
 6510:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6511: 
 6512:             } else { // Bottom boundary
 6513:                // This occurs at the bottom, where the bottom drag is applied.
 6514: 
 6515:                bdia[kin] += dt*side->chi2; // XXXX
 6516: 
 6517:             } // if (k > kb + 1)
 6518: 
 6519: 
 6520:          } // for (int k
 6521: 
 6522: 
 6523: 
 6524:          // Computes the RHS.
 6525:          // -----------------
 6526: 
 6527:          //	BC to be imposed at the end.
 6528: 
 6529:          const Vector2 gradETP  = side->gradETP;
 6530:          const Vector2 gradPr   = side->gradPr;
 6531:          const Vector2 gradEta1 = side->gradEta1;
 6532:          const Vector2 gradEta2 = side->gradEta2;
 6533: 
 6534:          const Vector2 *btu = side->btu;
 6535:          const Vector2 *u2  = side->u2;
 6536:          const double coriolis = side->coriolis;
 6537:          const Vector2 *nuGradU = side->nuGradU;
 6538: 
 6539:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 6540:          for (int k = kb + 1; k < nvrt; k++) {
 6541:             const int kin = k - kb - 1;
 6542: 
 6543:             const double dz_0 = side->Dz(k);
 6544:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 6545: 
 6546:             rrhs[kin] = {0.0, 0.0};
 6547:             double dz = 0.0;
 6548: 
 6549:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 6550:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 6551:             if (k < nvrt  ) dz += dz_1;
 6552:             if (k > kb + 1) dz += dz_0;
 6553: 
 6554:             // Elevation gradient, atmospheric pressure and tidal potential
 6555:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 6556: 
 6557:             // Coriolis, advection, wind stress, and horizontal viscosity
 6558:             if (k < nvrt - 1) {
 6559: 
 6560: 
 6561:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 6562:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 6563:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 6564:                                                 
 6565: 
 6566:                //diff stress tensors 1006
 6567:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 6568:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 6569:                   assert(false && "Not implemented: itur == 5");
 6570:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 6571:                }
 6572:                // else assert(false && "itur # Not implemented");
 6573: 
 6574:             } else { // k == nvrt - 1 SURFACE
 6575:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6576:                const Vector2 tau2 = side->tau();
 6577: 
 6578:                rrhs[kin] += dt*tau2;          
 6579: 
 6580:             } // if k<nvrt
 6581: 
 6582: 
 6583:             if (k > kb + 1) {
 6584:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 6585:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 6586:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 6587: 
 6588:                // diff stress tensors 1006
 6589:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 6590:                   assert(false && "Not implemented: itur == 5");
 6591:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 6592:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 6593:                }
 6594:                // else assert(false && "itur # Not implemented");
 6595: 
 6596: 
 6597:             } // if k>kbs + 1
 6598: 
 6599:             // Baroclinic
 6600:             Vector2 *bcc = side->bcc;
 6601:             if constexpr(ibc == 0) {
 6602:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 6603:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 6604: 
 6605:             } // if ibc==0
 6606: 
 6607:          } // k=kb + 1,nvrt
 6608: 
 6609: 
 6610:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 6611: 
 6612:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 6613:             const int kin = k - kb - 1;
 6614:    
 6615:             // Velocity is always clamped to maximum values
 6616:             side->u2[k] = clampVelocity(soln[kin]);
 6617:          } // k
 6618: 
 6619:       } // if side->is2D()
 6620:       
 6621: 
 6622:       // Impose velocity boundary condition at the bottom
 6623:       if constexpr(imm == 2) { // 3D bed deformation model
 6624:          double dep;
 6625:          Vector2 vel;
 6626: 
 6627:          assert(false && "Not implemented: imm == 2");
 6628:          //update_bdef(time, x0, y0, dep, vel);
 6629:          // side->u2[kb] = vel;
 6630: 
 6631:       } else { // imm = 0 or 1
 6632:          if (side->Cd() == 0.0) {
 6633:             side->u2[kb] = side->u2[kb + 1];
 6634: 
 6635:          } else if (side->is3D()) { // 3D no slip bottom   
 6636:             side->u2[kb] = {0.0, 0.0};
 6637: 
 6638:          }
 6639:           
 6640:       } // if imm
 6641: 
 6642:       // The velocities below the bottom level are set to zero
 6643:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 6644: 
 6645: 
 6646:    }
 6647: 
 6648: 
 6649:    __global__ void applyMomentumBC(void) {
 6650: 
 6651:       SIDE_BND(sideBnd);
 6652: 
 6653:       Side *side = sideBnd->side;
 6654:       const BoundarySegment *segment = sideBnd->segment;
 6655:       const Node *n1 = side->n1;
 6656:       const Node *n2 = side->n2;
 6657: 
 6658:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 6659: 
 6660:       const bool isLand = segment->isLand;
 6661:       const int ifltype = segment->ifltype;
 6662: 
 6663:       const int kb = side->kb;
 6664: 
 6665: 
 6666:       if (!isLand && ifltype != 0) {
 6667:          const Vector2 *ubc = sideBnd->ubc;
 6668:   
 6669:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 6670:             
 6671:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 6672:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 6673: 
 6674:             if (ifltype == -1) {
 6675:                // Flather 1
 6676: 
 6677:                const double depth = side->depth();
 6678: 
 6679:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 6680: 
 6681:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 6682: 
 6683:                side->u2[k] = vnorm*side->n;
 6684: 
 6685:             } else if (ifltype == -2) { // Discharge
 6686: 
 6687:                const double eta1 = side->eta1();
 6688:                const double eta2 = side->eta2();
 6689:                const double htot = side->htot2();
 6690: 
 6691:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 6692:                assert(false && "Not implemented: Discharge bc");
 6693:                // const double dischrg = discharge(eta1);
 6694:                const double dischrg = 0.0; // XXX REMOVE
 6695:                
 6696: 
 6697:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 6698: 
 6699:                const double vnorm = dischrg*eta2/htot;
 6700: 
 6701:                side->u2[k] = vnorm*side->n;
 6702: 
 6703:             }
 6704:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 6705:                const double vnorm = dot(side->u2[k], side->n);
 6706: 
 6707:                double rat;
 6708:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 6709:                else              rat = segment->vobc2; // outgoing
 6710: 
 6711:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 6712: 
 6713:             }
 6714:             else { // not Flather or 3D radiation
 6715:                side->u2[k] = ubc[k];
 6716: 
 6717:             } // if (segment->ifltype...
 6718: 
 6719:          }
 6720: 
 6721:       }
 6722:       else if (isLand) { // if it is land boundary side
 6723: 
 6724:          if constexpr(islip == 0) { // free slip
 6725: 
 6726:             for (int k = kb; k < nvrt; k++) {
 6727: 
 6728:                const Vector2 t = side->t();
 6729:                const Vector2 n = side->n;
 6730: 
 6731:                double vnorm = 0.0; // for most cases
 6732:                const double vtan = dot(side->u2[k], t);
 6733:                
 6734:                side->u2[k] = vtan*t - vnorm*n;
 6735: 
 6736:             }
 6737: 
 6738:          } else { // no slip
 6739:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 6740: 
 6741:          }
 6742:       } // if (side segment type...
 6743: 
 6744:    }
 6745: 
 6746: 
 6747:    __global__ void shapiroFilter1(void) {
 6748:       // First step of the Shapiro filter (normally used if indvel<=0)
 6749:       // Computes the filtered values and stores them in bcc (as a temporary array).
 6750: 
 6751:       SIDE(side);
 6752: 
 6753:       // Only internal wet sides are processed
 6754:       if (side->isDry || !(side->isInternal())) return;
 6755: 
 6756:       const int kb = side->kb;
 6757: 
 6758:       for (int mm = 0; mm < niter_shap; mm++) {
 6759: 
 6760:          for (int k = kb + 1; k < nvrt; k++) {
 6761:             // WARNING: reusing bcc as a temporary array to store the suru values.
 6762:             Vector2 suru = {0.0, 0.0};
 6763: 
 6764:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 6765: 
 6766:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 6767: 
 6768:                int kin = k;
 6769:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 6770:                
 6771:                // Get the velocity at the neighbor's side.
 6772:                Vector2 nSideU2 = nSide->u2[kin];
 6773: 
 6774:                // Projects the velocity to the current side frame if needed.
 6775:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 6776: 
 6777:                suru += nSideU2;
 6778:             }
 6779: 
 6780:             // Reusing bcc as a temporary array to store the suru values.
 6781:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 6782: 
 6783:          }
 6784:       }
 6785:    }
 6786: 
 6787:    __global__ void shapiroFilter2(void) {
 6788:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6789: 
 6790:       SIDE(side);
 6791: 
 6792: 
 6793:       if (side->isDry || !(side->isInternal())) return;
 6794: 
 6795:       const int kb = side->kb;
 6796: 
 6797:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6798: 
 6799:       if (side->is2D()) {
 6800:          side->u2[kb + 1] = side->bcc[kb + 1];
 6801:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6802: 
 6803:       } else {
 6804:          // 3D
 6805:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6806:          
 6807:       }
 6808: 
 6809:    }
 6810: 
 6811: 
 6812:    __global__ void ul0UpdateZCoords(void) {
 6813:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6814:       
 6815:       NODE(node);      
 6816: 
 6817: 
 6818:       if (false) { //node->isDry) { XXXXXXX
 6819: 
 6820:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6821: 
 6822:          if constexpr(ivcor != 1) node->kb = 0;
 6823: 
 6824:       } else {
 6825: 
 6826:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6827:          node->updateKb();
 6828: 
 6829:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6830: 
 6831:       }
 6832: 
 6833:       // We use the temp.b field to store the previous state of isDry.
 6834:       node->tmp.b = node->isDry;
 6835: 
 6836:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6837:       node->isDry = true;
 6838: 
 6839:    }
 6840: 
 6841:    __global__ void ul0ComputeDryElements(void)
 6842:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6843:    {
 6844:       ELEM(elem);
 6845: 
 6846:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6847: 
 6848:       elem->kb = 0;
 6849: 
 6850:       if (elem->isDry) return;
 6851: 
 6852: 
 6853:    //    if(elem->isDry2()) { // XXXX
 6854:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6855:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6856:    //        call parallel_abort(errmsg)
 6857:    //    }
 6858: 
 6859:       const Node *n1 = elem->nodes[0];
 6860:       const Node *n2 = elem->nodes[1];
 6861:       const Node *n3 = elem->nodes[2];  
 6862:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6863: 
 6864:       // Computes element's kb as the minimum of the nodes' kb.
 6865:       const int kb1 = n1->kb;
 6866:       const int kb2 = n2->kb;
 6867:       const int kb3 = n3->kb;
 6868:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 6869: 
 6870: 
 6871:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6872: 
 6873: 
 6874:       // Computes the element z as the mean of the nodes z.
 6875:       for (int k = elem->kb; k < nvrt; k++) {
 6876: 
 6877:          // Compute the element z as the mean of the nodes z.
 6878:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6879:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6880:          elem->z[k] /= elem->i34;
 6881: 
 6882:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 6883:       }
 6884:                   
 6885:    }
 6886: 
 6887:    __global__ void ul0ComputeDryNodes(void)
 6888:    // Updates node's isDry based on the elements' isDry. 
 6889:    {
 6890:       NODE(node);
 6891: 
 6892:       node->isDry = true;
 6893: 
 6894:       // A node is wet if at least one of the elements sharing it is wet.
 6895:       for (int j = 0; j < node->numElements; j++) {
 6896:          const Element *elem = node->elements[j];
 6897:          if (!elem->isDry) {
 6898:             node->isDry = false;
 6899:             break;
 6900:          }
 6901:       }
 6902: 
 6903:        
 6904:    }
 6905: 
 6906: 
 6907:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6908:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6909:    // node->tmp.b is true if the node was previously dry.
 6910:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6911:    {
 6912:       NODE(node);
 6913:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6914: 
 6915:       // Avoid this the first time step.
 6916:       if (it == iths) return;  
 6917: 
 6918:       const bool wasDry = node->tmp.b;
 6919: 
 6920: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6921: 
 6922:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 6923: 
 6924:          for (int k=0; k < nvrt; k++) {
 6925: 
 6926:             Vector3 utmp={0.0, 0.0, 0.0};
 6927: 
 6928:             double ttmp=0.0;
 6929:             double stmp=0.0;
 6930:             int icount=0;
 6931:             for (int j = 0; j < node->numNodes; j++) {
 6932: 
 6933:                const Node *nbrNode = node->nodes[j];
 6934:                
 6935:                const bool wasNbrDry = nbrNode->tmp.b;
 6936: 
 6937:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 6938:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 6939: 
 6940:                   icount++;
 6941: 
 6942:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6943:                   utmp += nbrNode->uvw2(k);
 6944:                   
 6945:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 6946:                   stmp += nbrNode->tracers[k].tracer[1]; 
 6947:                }
 6948:             }
 6949: 
 6950:             if (icount > 0) {
 6951:                const double inv_icount = 1.0/icount;
 6952:                utmp = inv_icount*utmp;
 6953:                node->u2[k]     = {utmp.x, utmp.y};
 6954:                node->w2[k]     = utmp.z;
 6955:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6956:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6957:             } else {
 6958:                node->u2[k] = {0.0, 0.0};
 6959:                node->w2[k] = 0.0;
 6960:                // Initialize tracers to 0.0??? XXXXX
 6961:             }
 6962:          }
 6963:       }
 6964:    }
 6965: 
 6966:   
 6967:    
 6968: 
 6969: 
 6970:    __global__ void ul0UpdateSides(int it, int iths) {
 6971:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 6972:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 6973:    // The dryness of the sides is updated in ul0UpdateSides2.
 6974: 
 6975:       SIDE(side);
 6976: 
 6977:       // A side is wet if and only if at least one of its elements is wet.
 6978:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6979:  
 6980:       const Node *n1 = side->n1;
 6981:       const Node *n2 = side->n2;
 6982:      
 6983:       const int kb1 = n1->kb;
 6984:       const int kb2 = n2->kb;
 6985: 
 6986:       side->kb = 0; // default when dry
 6987: 
 6988:       if (isWet) {
 6989: 
 6990:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6991: 
 6992:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6993: 
 6994:          side->kb = min(kb1, kb2);
 6995: 
 6996:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6997: 
 6998:          for (int k = side->kb; k < nvrt; k++) {
 6999:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 7000: 
 7001:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 7002: 
 7003:             // Compute velocity for re-wetted sides 
 7004:             if ((it != iths) && (side->isDry && isWet)) {
 7005: 
 7006:                Vector2 utmp={0.0, 0.0};
 7007: 
 7008:                int icount=0;
 7009: 
 7010:                // For all the sides on the two elements that share this side
 7011:                for (int j = 0; j < 2; j++) {
 7012:                   const Element *elem = side->elems[j];
 7013:                   if (elem == nullptr) continue;
 7014: 
 7015:                   for (int jj=0; jj < elem->i34; jj++) {
 7016:                      const Side *nSide = elem->sides[jj];
 7017:                      if (nSide->isDry) continue;
 7018: 
 7019:                      icount++;
 7020:                      utmp += nSide->u2[k];  
 7021:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 7022:                   }
 7023:                }
 7024:                   
 7025:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 7026:                if (icount > 0)  side->u2[k] = utmp/icount;
 7027:                else             side->u2[k] = {0.0, 0.0};
 7028:                   
 7029:             } // if ((it != iths) && (side->isDry && isWet))
 7030: 
 7031:          } // for k
 7032: 
 7033:       } // if isWet 
 7034:       
 7035: 
 7036: 
 7037:    }
 7038: 
 7039:    __global__ void ul0UpdateSides2(void) {
 7040:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 7041:    
 7042:          SIDE(side);
 7043:    
 7044:          const Element *e1 = side->elems[0];
 7045:          const Element *e2 = side->elems[1];
 7046: 
 7047:          // A side is wet if and only if at least one of its elements is wet.
 7048:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 7049: 
 7050:          // Update the side's dryness
 7051:          side->isDry = !isWet;
 7052: 
 7053:    }
 7054: 
 7055: 
 7056:    __global__ void zeroNodalVelocities(void) {
 7057:       NODE(node);
 7058: 
 7059:       for (int k = 0; k < nvrt; k++) {
 7060:          node->u2[k]   = {0.0, 0.0};
 7061:          node->w2[k]   = 0.0;
 7062:          node->utmp[k] = {0.0, 0.0};         
 7063:       }
 7064:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 7065:    }
 7066:  
 7067: 
 7068:    __global__ void computeNodalVerticalVelocities1(void) {
 7069:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7070:    // Adds the element's vertical velocity times the element's area.
 7071:       ELEM(elem);
 7072: 
 7073:       for (int j = 0; j < elem->i34; j++) {
 7074:          Node *node = elem->nodes[j];
 7075: 
 7076:          for (int k = node->kb; k < nvrt; k++) {
 7077:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 7078:          }
 7079:          atomicAdd(&(node->tmp.d), elem->area);
 7080:       }
 7081:    }
 7082: 
 7083:    __global__ void computeNodalVerticalVelocities2(void) {
 7084:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7085:    // Divides by the total area of the elements sharing the    node.
 7086:       NODE(node);
 7087: 
 7088: 
 7089:       const double invArea = 1.0 / node->tmp.d;
 7090:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = invArea*node->w2[k];  // node->tmp.d contains the total area of the elements sharing the node
 7091: 
 7092:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 7093:    }
 7094: 
 7095: 
 7096:    __global__ void computeNodalHorizontalVelocities1(void) {
 7097: 
 7098:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 7099: 
 7100:       ELEM(elem);
 7101: 
 7102:       if (elem->isDry) return;
 7103: 
 7104:       const int kb = elem->kb;
 7105:       const bool isTri = elem->isTri();
 7106: 
 7107:       if constexpr(indvel <= 0) {
 7108:          // Assuming discontinous hvel.
 7109: 
 7110:          if (isTri) { // For triangles
 7111:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 7112:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 7113:             #pragma unroll
 7114:             for (int j = 0; j < 3; j++) {
 7115:                // For every node of the triangle...
 7116:                Node *node = elem->nodes[j];
 7117: 
 7118:                if (node->isDry) continue;
 7119: 
 7120:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 7121:                const Side *s2 = elem->sides[(j + 1) % 3];
 7122:                const Side *s3 = elem->sides[(j + 2) % 3];
 7123: 
 7124:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 7125: 
 7126:                atomicAdd(&(node->tmp.i), 1);
 7127: 
 7128:                for (int k = kb; k < nvrt; k++)  {
 7129:                   Vector2 s1u2 = s1->u2[k];
 7130:                   Vector2 s2u2 = s2->u2[k];
 7131:                   Vector2 s3u2 = s3->u2[k];
 7132: 
 7133:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 7134:                   if constexpr(ics == 2) {
 7135:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 7136:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 7137:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 7138:                   }
 7139: 
 7140:                   Vector2 u = s2u2 + s3u2 - s1u2; // u extrapolated linearly at node j.   
 7141:                   u = clampVelocity(u);
 7142:                   atomicAdd(&(node->utmp[k].x), u.x);
 7143:                   atomicAdd(&(node->utmp[k].y), u.y);
 7144: 
 7145:                }
 7146: 
 7147:             }
 7148:          }
 7149:          else { // For quads
 7150: 
 7151: 
 7152:             // Compute the bilinear coordinates of the center of each diagonal.
 7153:             double xi, eta;
 7154:             double shp13[4], shp24[4];
 7155:             Point2 x0, x1, x2, x3;
 7156:             elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 7157:             const Point2 p13 = 0.5 * (x0 + x2);   // Center of sides 1 & 3
 7158:             const Point2 p24 = 0.5 * (x1 + x3);   // Center of sides 2 & 4
 7159: 
 7160:             elem->inverseBilinearQuad(p13, xi, eta, shp13);
 7161:             elem->inverseBilinearQuad(p24, xi, eta, shp24);
 7162: 
 7163: 
 7164: 
 7165: 
 7166:             for (int k = kb; k < nvrt; k++) {
 7167: 
 7168:                //Each quad is split into two triangles. For each triangle we extrapolate as we did for triangles.
 7169:                Vector2 sideU[4];
 7170:                #pragma unroll
 7171:                for (int j = 0; j < 4; j++) {
 7172:                   Vector2 u = elem->sides[j]->u2[k];
 7173:                   if constexpr(ics == 2) u = elem->sides[j]->frame.projHorVec(u, elem->frame);
 7174:                   sideU[j] = u;
 7175:                }
 7176: 
 7177:                Vector2 ud1 = shp13[0]*sideU[0] + shp13[1]*sideU[1] + shp13[2]*sideU[2] + shp13[3]*sideU[3];
 7178:                Vector2 ud2 = shp24[0]*sideU[0] + shp24[1]*sideU[1] + shp24[2]*sideU[2] + shp24[3]*sideU[3];
 7179: 
 7180:                Vector2 ufg0 = clampVelocity(sideU[2] + sideU[3] - ud2);  // node 1: sides 3,4
 7181:                Vector2 ufg1 = clampVelocity(sideU[0] + sideU[3] - ud1);  // node 2: sides 1,4
 7182:                Vector2 ufg2 = clampVelocity(sideU[0] + sideU[1] - ud2);  // node 3: sides 1,2
 7183:                Vector2 ufg3 = clampVelocity(sideU[1] + sideU[2] - ud1);  // node 4: sides 2,3
 7184:                const Vector2 ufg[4] = {ufg0, ufg1, ufg2, ufg3};
 7185:                #pragma unroll
 7186:                for (int j = 0; j < 4; j++) {
 7187:                   Node *node = elem->nodes[j];
 7188:                   if (node->isDry) continue;
 7189: 
 7190:                   if (k == kb) atomicAdd(&(node->tmp.i), 1);
 7191:                   atomicAdd(&(node->utmp[k].x), ufg[j].x);
 7192:                   atomicAdd(&(node->utmp[k].y), ufg[j].y);
 7193:                }
 7194:             }
 7195: 
 7196:          }
 7197: 
 7198:       }
 7199:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 7200:       
 7201:    }
 7202: 
 7203: 
 7204:    __global__ void computeNodalHorizontalVelocities2(void) {
 7205:       NODE(node);
 7206: 
 7207:       const int nodeCount = node->tmp.i;
 7208: 
 7209:       if (nodeCount == 0) 
 7210:       {
 7211:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 7212:          return;
 7213:       }
 7214: 
 7215:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 7216:       
 7217:       const int kb = node->kb;
 7218: 
 7219:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 7220:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 7221:       
 7222:       
 7223:    }   
 7224: 
 7225:  
 7226: 
 7227:    __global__ void resetVelocityOpenBndNodes(void) {
 7228:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 7229: 
 7230:       NODE_BND(nodebnd);
 7231: printf("DDDDDDDDDD\n");  // XXXXXXX
 7232:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 7233:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 7234:       }
 7235: 
 7236:    }
 7237: 
 7238: 
 7239:    __global__ void setVelocityOpenBndNodes(void) {
 7240:    // For open boundary nodes sets their velocity to the imposed values.
 7241: 
 7242:       SIDE_BND(sidebnd);
 7243: 
 7244:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 7245:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 7246:          // to its segment to the average of the side velocity.
 7247: 
 7248:          for (int k = 0; k < nvrt; k++) {
 7249:             Node *n1 = sidebnd->side->n1;
 7250:             Node *n2 = sidebnd->side->n2;
 7251: 
 7252: 
 7253:             Vector2 n1_u2(n1->u2[k]);
 7254:             Vector2 n2_u2(n2->u2[k]);
 7255: 
 7256:             if (n1->nodeBnd->segment == sidebnd->segment) {
 7257:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 7258:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 7259:             }
 7260:             if (n2->nodeBnd->segment == sidebnd->segment) {
 7261:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 7262:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 7263:             }
 7264: 
 7265:          }
 7266: 
 7267:       }
 7268: 
 7269:    }
 7270: 
 7271: 
 7272:    __global__ void computeVerticalVelocity(void) {
 7273:       // Computes the vertical velocity at the (2D) element's centroid.
 7274:       // In this function we will be considering volumetric elements, with side faces and a 
 7275:       // bottom and a top face. We will call them SFs, BF and TF.
 7276:       // It computes the flux coming from BF and the SFs.
 7277:       // If the bed is moving, it takes that into account.
 7278:       // Since water is incompressible, the integral of the velocity times the normal vector
 7279:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 7280:       // and the BF is equal to the flux going out from the TF.
 7281:       // TF = - BF - sum(SFs).
 7282:       // It then computes the horizontal velocity at the center of TF.
 7283:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 7284:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 7285:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 7286: 
 7287:       ELEM(elem);
 7288: 
 7289:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 7290: 
 7291:       if (elem->isDry) return;
 7292: 
 7293:       const int kb = elem->kb;
 7294:       const bool isTri = elem->isTri();
 7295: 
 7296:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 7297: 
 7298:       // Compute the bottom velocity
 7299:       if constexpr(imm != 0) {
 7300:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 7301:       }
 7302: 
 7303: 
 7304:       double bottomArea3D;
 7305:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 7306: 
 7307:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 7308: 
 7309:       double topArea3D;
 7310: 
 7311:       // Bottom face flux
 7312:       double bottomFlux = 0.0;
 7313:       Vector2 u2meanBottom = {0.0, 0.0};
 7314:       const Vector2 gradh = elem->grad2(&Node::depth);
 7315:       if constexpr(imm==2) {
 7316:          Vector3 ubed;
 7317: 
 7318:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 7319:          // updateBDEF(ubed);
 7320:      
 7321:          // const double bflux0 = dot(ubed, elem_bottom_n);
 7322: 
 7323:          // elem->w[kb] += ubed.z;
 7324:       }
 7325:       else {
 7326: 
 7327:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 7328:   
 7329:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 7330:          // in the direction of motion.
 7331:          const double bottomW = - dot(gradh, u2meanBottom);  
 7332:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 7333: 
 7334:          // VElocity associated to the bed deformation
 7335:          double bedVelocity = 0.0;
 7336:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 7337: 
 7338:          elem->w[kb] = bedVelocity + bottomW; 
 7339: 
 7340:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 7341:          
 7342:       } // if imm
 7343: 
 7344:       // Compute w for kb+1 to nvrt-1
 7345:       for (int l = kb; l < nvrt - 1; l++) {
 7346: 
 7347:          // normal vector to the top face of the "volumetric" element (3D)
 7348:          Vector3 elem_top_n = elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 7349: 
 7350:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 7351:          assert(elem_top_n.z > 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 7352: 
 7353:          // Compute the total flux at the sides
 7354:          double sideFlux = 0.0;
 7355: 
 7356:          for (int j = 0; j < elem->i34; j++) {
 7357:             const Side *side = elem->sides[j];
 7358:             const int kbs = side->kb;
 7359:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 7360:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 7361:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 7362: 
 7363:             // The area is "clamped" meaning that it takes kb into account.
 7364:             const double sideArea = side->areaClamped(l);
 7365: 
 7366:             const double sign = elem->ssign[j]; 
 7367: 
 7368:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 7369:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 7370:          }
 7371:          
 7372:          // Compute the horizontal velocity at the center of the top face as an average of the 
 7373:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 7374:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 7375: 
 7376:          // The flux at the top ace can be computed from the other flows.
 7377:          // All fluxes are in directions into the prism.
 7378:          const double topFlux = - sideFlux - bottomFlux;
 7379: 
 7380:          // Flux at the top face due to the horizontal velocities only
 7381:          // topFlux = topHorizontalFlux + topVerticalFlux
 7382:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 7383: 
 7384:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + sideFlux + bottomFlux = 0, so:
 7385:          const double topVerticalFlux = topFlux - topHorizontalFlux;  
 7386: 
 7387:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 7388: 
 7389:          bottomFlux = -topFlux;
 7390:          
 7391:       }
 7392: 
 7393:    }  
 7394: 
 7395: 
 7396: 
 7397: 
 7398: 
 7399: 
 7400: 
 7401: // !===============================================================================
 7402: // !===============================================================================
 7403: 
 7404: } // extern "C"
 7405: 
 7406: #ifdef DONTCOMPILE
 7407: __device__ void computeVerticalAdvection(void) {
 7408:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 7409: 
 7410:    sdbt(1:2,:,:)=0.d0
 7411: 
 7412:    const Side *side = FROM kernel;
 7413: 
 7414:    if(side->isDry) return;
 7415: 
 7416:    // If side is wet...
 7417: 
 7418: 
 7419:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 7420:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 7421:    double ws[nvrt] = {} // w @ side
 7422:    int icount = 0;
 7423:    for (int j=0; j<2; j++) {
 7424:       const Element *elem = side->elements[j];
 7425:        
 7426:       if(elem != nullptr) {
 7427:          icount++;
 7428:          for (int k=0; k<nvrt; k++) {
 7429:             ws[k] = ws[k] + elem->w[k];
 7430:          }
 7431:       }
 7432:    }  // for j
 7433: 
 7434:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 7435:    ws = ws/icount;
 7436: 
 7437:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 7438:    // Splines allow for a smooth transition between vertical levels.
 7439:    // Splines have continuity restrictions at the internal knots, but
 7440:    // we have to provide the 1st derivatives at the endpoints.
 7441:    const int kbs = side->kbs; 
 7442:    
 7443:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7444:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7445:    initCubicSpline(kbs, nvrt, side, ws, up)
 7446: 
 7447:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7448:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7449:    initCubicSpline(kbs, nvrt, side, ws, vp)
 7450: 
 7451:    // Total advection (average onto side)
 7452:    const Node *node1 = side->nodes[0];
 7453:    const Node *node2 = side->nodes[1];
 7454:    for (int k=kbs(i); k<nvrt; k++) {
 7455: 
 7456:       Vector2 bcc1 = node1->bcc[k];
 7457:       Vector2 bcc2 = node2->bcc[k];
 7458:       if constexpr(ics == 2) {
 7459:          // Project the velocities from the node frames to the side frame
 7460:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 7461:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 7462:       }
 7463: 
 7464:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 7465:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 7466: 
 7467:    }
 7468: }
 7469: #endif
 7470: 
 7471: 
 7472: extern "C" {
 7473:    __global__ void computeElemAverageGhat(void) {
 7474:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 7475: 
 7476:       ELEM(elem);
 7477:       
 7478:       elem->ghat1= {0.0, 0.0};  
 7479: 
 7480:       if constexpr(ihydraulics != 0) {
 7481:          if (nhtblocks > 0 && elem->isblock) return;
 7482:       }
 7483: 
 7484:       
 7485:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 7486:       // cff1-3: coefficients for 2D/3D
 7487: 
 7488:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7489:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7490:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 7491: 
 7492:       if (elem->isDry) return;
 7493: 
 7494:       // Average of the coefficients
 7495:       double av_cff1 = 0.0;  // av. for cff1
 7496:       double av_cff2 = 0.0;  // av. for cff2
 7497:       double av_cff3 = 0.0;  // av. for cff3
 7498:       double av_df = 0.0;  // av. for H^\alpha / H
 7499:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7500:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7501: 
 7502:       const int i34 = elem->i34;
 7503:       const int kb  = elem->kb;
 7504: 
 7505:       for (int j=0; j<i34; j++) {
 7506:          // For each node and side in the element...
 7507: 
 7508:          const Node *node = elem->nodes[j];
 7509:          const Side *side = elem->sides[j];
 7510: 
 7511:          const double chi      = side->chi;
 7512:          const double veg_c2   = side->veg_c2;
 7513:          const double veg_beta = side->veg_beta;
 7514:          const double veg_h    = side->veg_h();
 7515:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7516: 
 7517:          const Vector2 gradPhi = elem->gradPhi[j];
 7518: 
 7519:          // Node - const in elem
 7520:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 7521:          elem->gradPr  += node->pr  *gradPhi;
 7522: 
 7523:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 7524: 
 7525:         
 7526:          const double htot  = side->htot2();        // Total depth at the side
 7527:          const double zctr2 = side->zTopCanopy();  
 7528: 
 7529:          double cff1; 
 7530:          double cff2; 
 7531:          double cff3;   
 7532:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7533:          // coefficients applied to 2D/3D case 
 7534:             cff1 = side->hhat/htot;
 7535:             cff2 = 0.0;
 7536:             cff3 = 0.0;
 7537:          } else { //3D
 7538:             //Init for no-veg case
 7539:             cff1 = 1.0;
 7540:             cff2 = 1.0;
 7541:             cff3 = 0.0;
 7542: 
 7543:             if constexpr(iveg != 0) {
 7544:                // Computes coefficients used with vegetation terms G1, G2
 7545:                // cff1, cff3 are used for the first two terms in G1, G2:
 7546:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7547:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7548:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7549:                if(veg_h < 0.99*htot) { // submergent vegetation
 7550:                   cff1 = 1.0;
 7551:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7552:                   cff3 = veg_c;
 7553: 
 7554:                } else { // emergent vegetation
 7555:                   cff1 = 1.0/(1.0 + veg_c2);
 7556:                   cff2 = cff1;
 7557:                   cff3 = 0.0;
 7558: 
 7559:                }
 7560:             } // if iveg
 7561:          } //  2D/3D
 7562: 
 7563:          av_cff1 += cff1/i34;
 7564:          av_cff2 += cff2/i34;
 7565:          av_cff3 += cff3/i34;
 7566:          av_cff2_chi += cff2*chi/i34;
 7567:          av_cff3_chi += cff3*chi/i34;
 7568:          av_df += min(htot, veg_h)/(htot*i34);
 7569: 
 7570: 
 7571:          // btrack values: U^\star, U^{\star\alpha}
 7572:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7573:          Vector2 Ustar       = {0.0, 0.0}; 
 7574:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7575: 
 7576:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7577:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7578:          } else { //3D
 7579:             for (int k = side->kb + 1; k < nvrt; k++) {
 7580:             
 7581:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7582:                Ustar += w2;
 7583: 
 7584:                if constexpr(iveg != 0) {
 7585:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7586:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7587:                        Ustar_alpha += zrat*w2; // XXXX
 7588:                    }
 7589:                }  // if iveg
 7590:             }  // for k
 7591:          }  //2D/3D
 7592: 
 7593:          // If needed, project the side velocities to the element frame
 7594:          if constexpr(ics==2) {
 7595:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 7596:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 7597:          }
 7598:         
 7599: 
 7600:          // Add btrack & surface stress terms to \breve{G} first
 7601:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7602: 
 7603: 
 7604:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 7605:          Vector2 tau    = side->tau();  
 7606:          Vector2 ubstar = side->btu[side->kb + 1];  
 7607: 
 7608:          // If needed, project tau and ubstar to the element frame
 7609:          if constexpr(ics==2) {
 7610:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 7611:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 7612:          }
 7613: 
 7614:          // Term for surface and bottom stress
 7615:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7616: 
 7617: 
 7618:          // All terms in F,F^\alpha,f_b except baroclinic
 7619:          // F, f_b: all explicit terms excluding vegetation 
 7620:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7621:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7622:          const double coriolis = side->coriolis;
 7623:          Vector2 F  =  coriolis*side->U;  // F_x
 7624:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7625:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7626: 
 7627:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7628:             
 7629:             for (int k = side->kb; k < nvrt; k++) {
 7630:                if (zctr2 > side->zc[k-1]) {
 7631:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7632:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7633:                    Fa +=  coriolis*w2*zrat;
 7634:                } // if zctr2
 7635:             } // k
 7636:          } // iveg
 7637: 
 7638:          // Integrate horizontal viscosity force vertically
 7639:          for (int k=side->kb + 1; k<nvrt; k++) {
 7640:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7641: 
 7642:             F += levelHorVisc;
 7643: 
 7644:             // Vegetation term
 7645:             if constexpr(iveg!=0) {
 7646:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7647:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7648:                   Fa += levelHorVisc*zrat;
 7649:                } 
 7650:             } // if iveg
 7651:          } // for k
 7652: 
 7653:          // Get nu*grad(U) at the side's bottom level
 7654:          Vector2 nuGradU = side->nuGradU[side->kb];
 7655: 
 7656:          fb += nuGradU;
 7657: 
 7658:          // If needed, project vectorsF, fb and Fa to the element frame
 7659:          if constexpr(ics==2) {
 7660:             F    = side->frame.projHorVec(F,    elem->frame);
 7661:             fb   = side->frame.projHorVec(fb,   elem->frame);
 7662:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 7663:          } // if ics
 7664: 
 7665:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7666:       } // for j (nodes and sides)
 7667: 
 7668:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7669: 
 7670: 
 7671:       // Finish off terms in F, F^\alpha and f_b
 7672:       const double grav3 = elem->mean(&Node::grav2);
 7673:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7674:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7675:       for (int j=0; j<i34; j++) { 
 7676:          // For each side in the element...
 7677:          const Side *side = elem->sides[j];
 7678:          const double chi = side->chi;
 7679: 
 7680:          const double htot = side->htot2();
 7681:          const double veg_h = side->veg_h();
 7682:          const Vector2 F  = htot*fb;
 7683:          const Vector2 Fa = min(htot, veg_h)*fb;
 7684: 
 7685:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7686:       } // for j
 7687: 
 7688:       // tmp is already in elem frame
 7689:       elem->ghat1 += tmp/i34;
 7690: 
 7691:       // Baroclinic force
 7692:       if constexpr(ibc==0) {
 7693:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7694: 
 7695:          Vector2 Fa = {0.0, 0.0};
 7696:          Vector2 intGradRho = {0.0, 0.0};
 7697:          
 7698:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 7699:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 7700:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7701: 
 7702:             // \in F [m^2/s/s]
 7703:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7704:          }
 7705: 
 7706:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7707:          const Vector2 F = av_df*Fa; //approx
 7708:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7709: 
 7710:       } // if ibc
 7711: 
 7712: 
 7713: 
 7714:    }
 7715: 
 7716: } // extern "C"
 7717: 
 7718: 
 7719: 
 7720: #ifdef DONTCOMPILE
 7721: __global__ void checkMassConservation(Tracers* sumtr) {
 7722: 
 7723:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7724: 
 7725:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7726: 
 7727:    Element *elem = &(mesh->localElemData[i]);
 7728: 
 7729:    // Skip dry elements
 7730:    if (elem->isDry) return;
 7731: 
 7732:    // Local sum array for this thread
 7733:    double localSum[N_TRACERS] = {0.0};
 7734: 
 7735:    // Sum over vertical levels for this element
 7736:    const int kbe = elem->kbe;
 7737:    const double area = elem->area;
 7738: 
 7739:    for (int k = kbe; k < nvrt; k++) {
 7740:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7741:       
 7742:       // Accumulate tracer mass
 7743:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7744:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7745:       }
 7746:    }
 7747: 
 7748:    //  This function returns per element sums. A reduction must be done on the host side.
 7749: }
 7750: 
 7751: 
 7752: __global__ void transport(void) {
 7753: 
 7754:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7755: 
 7756:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7757: 
 7758:    Element *elem = &(mesh->localElemData[ie]);
 7759: 
 7760:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7761: 
 7762:                for (int m=0; m<ntr; m++) {
 7763:                   for (int k=kbe(ie); k<nvrt; k++) {
 7764:                      // Calculate each polynomial's weight 
 7765:                      wm=0.d0; sum1=0.d0; 
 7766:                      wm1=0.d0; wm2=0.d0; 
 7767:                      for (int i=0; i<elem->nweno2; i++) {
 7768:                   
 7769:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7770:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7771:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7772:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7773:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7774:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7775:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7776:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7777:                      // -----------------Hu and Shu (1999)'s method----------------
 7778:                      b4=b1+b2+b3
 7779: 
 7780: //Error: add PRODUCTION CPP
 7781: #ifdef DEBUG
 7782:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7783:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7784:                     call parallel_abort(errmsg)
 7785:                   }
 7786: #endif
 7787: 
 7788:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7789:                   // !----test-------------- 
 7790:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7791:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7792:                   // !wm(i)=wm1(i)*wm2(i)
 7793:                   // !---------------------- 
 7794:                   sum1=sum1+wm(i)
 7795:                 } // end for i
 7796: 
 7797:                 wm=wm/sum1
 7798: 
 7799:                 for (int j=0; j<elem->i34; j++) {
 7800: 
 7801:                   const Side *side  = elem->sides[j];
 7802:                   const Node *node1 = side->n1;
 7803:                   const Node *node2 = side->n2;
 7804: 
 7805:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7806:                      trsd=0.d0
 7807:                      for (int kk=0; kk<nquad; kk++) {
 7808:                         for (int i=0; i<elem->nweno2; i++) {
 7809:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7810:                         } // end for i   
 7811:                      } // end for kk
 7812:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7813:                   } // outward flux
 7814:                } // end for j=1,i34(ie) ! side
 7815:             }
 7816:          }
 7817:               
 7818: 
 7819: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7820: //             //   calculate each polynomial's weight 
 7821: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7822: //                 wm=0.d0; sum1=0.d0
 7823: //                 do i=1,nweno1(ie) !for each polynomial
 7824: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7825: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7826: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7827: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7828: //                   wm(i)=b2
 7829: //                   sum1=sum1+b2
 7830: //                   !wm(i)=1.d0
 7831: //                   !sum1=sum1+1.d0
 7832: 
 7833: // // Error: PRODUCTION
 7834: // #ifdef DEBUG
 7835: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7836: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7837: //                     call parallel_abort(errmsg)
 7838: //                   endif
 7839: // #endif
 7840: 
 7841: //                 enddo !i
 7842: //                 wm=wm/sum1 !final weight
 7843: 
 7844:                 for (int j=0; j<elem->i34; j++) { // side
 7845:                   const Side *side = elem->sides[j];
 7846:                   const Node *node1 = side->n1;
 7847:                   const Node *node2 = side->n2;
 7848: 
 7849:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7850:                     trsd=0.d0
 7851:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7852:                       for (int i=0; i<elem->nweno1; i++) {
 7853:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7854:                       }
 7855:                     enddo //kk
 7856:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7857:                   } // outward flux
 7858:                 } // end for j=1,i34(ie) ! side
 7859:               } // end for k; ntr 
 7860: 
 7861:             else !simple upwind method
 7862:               do j=1,i34(ie)
 7863:                 jsj=elside(j,ie)
 7864:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7865:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7866:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7867:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7868:                   endif
 7869:                 enddo  !vertical layers
 7870:               enddo !j=1,i34(ie) ! side
 7871:             endif !order of accuracy
 7872: 
 7873:          //  enddo !ie
 7874: // !$OMP     end do
 7875: 
 7876: // !$OMP     master
 7877: //           !message passing
 7878: //           if (nproc>1) then
 7879: //             !make a copy of side concentrations
 7880: //             trsd_tmp0=trsd_tmp 
 7881: 
 7882: //             !this exchange routine swaps interface concentration between two partitions
 7883: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 7884: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 7885: 
 7886: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 7887: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 7888: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 7889: 
