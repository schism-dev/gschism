 9222:                 for (int j=0; j<elem->i34; j++) { // side
 9223:                   const Side *side = elem->sides[j];
 9224:                   const Node *node1 = side->n1;
 9225:                   const Node *node2 = side->n2;
 9226: 
 9227:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 9228:                     trsd=0.d0
 9229:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 9230:                       for (int i=0; i<elem->nweno1; i++) {
 9231:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 9232:                       }
 9233:                     enddo //kk
 9234:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 9235:                   } // outward flux
 9236:                 } // end for j=1,i34(ie) ! side
 9237:               } // end for k; ntr 
