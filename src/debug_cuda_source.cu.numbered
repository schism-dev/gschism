 7227: __global__ void printMatrix(void) {
 7228: 
 7229: 
 7230:    // Let only one thread per block print at a time 
 7231: 
 7232:    if (threadIdx.x == 0) {
 7233:       for (int ithread = 0; ithread < blockDim.x; ithread++) {
 7234:          const int idx_node = ithread + blockIdx.x * blockDim.x;
 7235:          if (idx_node >= mesh->np) return;
 7236:          const Node *node = mesh->localNodeData + idx_node;
 7237:          printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7238:          for (int j = 0; j < node->numNodes; j++) {
 7239:             Node* nbNode = node->nodes[j];
 7240:             if (node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7241:          }
 7242:          printf("]\n");
 7243: 
 7244:       }
 7245:    }
 7246: 
 7247: 
 7248: 
 7249: }
