 2755: 
 2756: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2757: 
 2758: 
 2759: __device__ void Node::updateKb(void) {
 2760: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2761: 
 2762:    if constexpr(ivcor == 1) return;
 2763: 
 2764: 
 2765:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 2766: 
 2767:    if constexpr(ivcor == 2) {  // SZ coordinates
 2768:       
 2769:       // Compute bottom level index
 2770:       if (depth <= mesh->h_s) {
 2771:          kb = izlev;   
 2772:          
 2773:       } else {
 2774:          kb = -1;
 2775:          int L = 0;
 2776:          int R = nzlev; 
 2777:          
 2778:          while (L <= R) {
 2779:             int M = (R + L) / 2;
 2780: 
 2781: 
 2782:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2783:             
 2784:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2785:                R = M;
 2786:             } else {
 2787:                L = M;
 2788:             }
 2789: 
 2790:             if (R - L == 1) {
 2791:                kb = L;
 2792:                break;
 2793:             }
 2794:          }
 2795: 
 2796:          // Checks that the binary search was successful
 2797:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 2798:        
 2799:       }
 2800:    } 
 2801: }
 2802: 
 2803: 
 2804: __device__ __inline__ void Node::updateZCoordData(void) {
 2805: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2806: 
 2807:    // assert(!isDry2() && "updateZCoordData: node is dry");
 2808:    // if (isDry2()) {
 2809:    //    kb = -1;  // XXXXXXXX KKKKK
 2810:    //    return;
 2811:    // }
 2812: 
 2813: 
 2814:    if constexpr(ivcor == 2) {  // SZ coordinates
 2815:       
 2816:       // Compute bottom level index
 2817:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 2818:    } 
 2819:    else if (ivcor == 1) {  // Localized sigma
 2820:       // Do nothing
 2821:    }
 2822: 
 2823: 
 2824: }
 2825: 
 2826: 
 2827: __device__ double Node::compZCoord(int k) const {
 2828:    // Computes the z coordinate at level k.
 2829:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2830:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2831:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2832:    // used 
 2833: 
 2834:    assert(k >= 0 && k < nvrt && "ZCOOR: invalid level\n");
 2835:    
 2836:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2837: 
 2838:    if (isDry2()) return 0.0;  // XXXX I used to return 0.0
 2839: 
 2840:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2841: 
 2842:    if constexpr(ivcor == 2) {
 2843: 
 2844:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2845:       const double h_c = mesh->h_c;
 2846:       const double theta_f = mesh->theta_f;
 2847:       const double sinh_theta_f = mesh->sinh_theta_f;
 2848: 
 2849: 
 2850:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2851:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2852:       // once per time step/node.
 2853:       // CHECK: updateZCoordData
 2854: 
 2855:       //  To simplify comparisons, I define index versions of count variables.
 2856:       if      (k == ivrt)     return eta2; 
 2857:       else if (k == izlev)    return -hmod2;
 2858:       else if (k == kb)       return -depth;
 2859:       else if (k < izlev)     return mesh->ztot[k];
 2860:       else if (k > izlev) {
 2861:          const int ksig = k - izlev;
 2862: 
 2863:          if (hmod2 <= h_c) {
 2864:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2865: 
 2866:          } 
 2867:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 2868:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2869:             assert(false && "ZCOOR: invalid h_c\n");
 2870:          } 
 2871:          else {
 2872:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2873:                    h_c * mesh->sigma[ksig] + 
 2874:                    (hmod2 - h_c) * mesh->cs[ksig];
 2875:          }
 2876:       } else { 
 2877:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2878:       }
 2879: 
 2880:    }
 2881:    else if constexpr(ivcor == 1) {
 2882:       if (k == kb) return -depth;
 2883:       else if (k == nvrt-1) return eta2;
 2884:       else if (k > kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2885:    }
 2886:    
 2887:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2888:    return 0.0;
 2889: }
 2890: 
 2891: 
 2892: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 2893:    // Computes the bottom drag Cd based on the selected nchi
 2894: 
 2895:    if constexpr(nchi == 0) {
 2896:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 2897:       Cd = drag;  // Read from drag file
 2898: 
 2899:    } else if constexpr(nchi == 1) {
 2900:       // 
 2901: 
 2902:       bool ltmp = false; // for WBL iteration
 2903: 
 2904:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 2905:       if (isDry || (rough == 0.0)) {
 2906:          Cd = 0.0;
 2907: 
 2908:       } else { //roughness >0 
 2909:          
 2910:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 2911: 
 2912:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 2913: 
 2914:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 2915: 
 2916:       } // if rough
 2917: 
 2918:    } else if constexpr(nchi == -1) {
 2919:    // Manning 
 2920:  
 2921:       const double htot = max(hmin_man, htot2()); 
 2922:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 2923: 
 2924:    } else {
 2925:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 2926:       
 2927:    } // if nchi
 2928: 
 2929: }
 2930: 
 2931: 
 2932: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2933:    // Checks if a side in on the boundary
 2934:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2935: 
 2936:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2937:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2938: 
 2939:    // Indices of the nodes that form the side
 2940:    const int n1 = side.n1->idx;
 2941:    const int n2 = side.n2->idx;
 2942:    isLand = false;
 2943:    
 2944: 
 2945:    // Check if the side is on a land boundary
 2946:    for (int i = 0; i < nland; i++) {
 2947:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2948:          // Consecutive nodes in the land boundary segment
 2949:          const int b1 = ilnd[i + j*nland];
 2950:          const int b2 = ilnd[i + (j + 1)*nland];
 2951: 
 2952:          assert(b1 != -1 && b2 != -1);
 2953: 
 2954:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2955:             
 2956:             isLand = true;
 2957:             return i;
 2958:          }
 2959:       }
 2960:    }
 2961: 
 2962:    // Check if the side is on an open boundary
 2963:    for (int i = 0; i < nope; i++) {
 2964:       for (int j = 0; j < nond[i] - 1; j++) {
 2965:          // Consecutive nodes in the open boundary segment
 2966:          const int b1 = iond[i + j*nope];
 2967:          const int b2 = iond[i + (j + 1)*nope];
 2968: 
 2969:          assert(b1 != -1 && b2 != -1);
 2970: 
 2971:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2972:             isLand = false;
 2973:             return i;
 2974:          }
 2975:       }
 2976:    }
 2977: 
 2978:    return -1;
 2979: }
 2980: 
 2981: 
 2982: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 2983:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 2984:                                     double *wind_rotate_angle, 
 2985:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2986:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2987:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2988:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 2989:                                     double *drag, double *roughness, double *rmanning) {
 2990: 
 2991:    NODE(pnode);  
 2992:    const int i = idx_node;
 2993:    Node &node(*pnode);
 2994: 
 2995:    node.idx = i;
 2996: 
 2997:    const int idxNodeStart = nodeNeighNodesStart[i];
 2998:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2999:    node.numNodes = idxNodeEnd - idxNodeStart;
 3000:    node.nodes = nodeNeighNodes + idxNodeStart;
 3001:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3002: 
 3003: 
 3004: 
 3005:    const int idxElemStart = nodeNeighElemsStart[i];
 3006:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3007:    node.numElements = idxElemEnd - idxElemStart;
 3008:    node.elements = nodeNeighElems + idxElemStart;
 3009: 
 3010: 
 3011:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3012:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3013:       const int partNode = localNodePart[idxNodeGlobal]; 
 3014:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3015: 
 3016:       Node *node_ptr = nodes[partNode] + idxNode;
 3017:       
 3018:       nodeNeighNodes[idx] = node_ptr;
 3019:    }
 3020: 
 3021: 
 3022:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3023:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3024:       const int partElem = localElemPart[idxElemGlobal];
 3025:       const int idxElem  = localElemIndices[idxElemGlobal];
 3026: 
 3027:       Element *elem_ptr = elems[partElem] + idxElem;
 3028: 
 3029:       nodeNeighElems[idx] = elem_ptr;
 3030:    }      
 3031: 
 3032:    node.wind_angle = wind_rotate_angle[i];
 3033: 
 3034: 
 3035:    node.p.x   = node_coords[i * 3];
 3036:    node.p.y   = node_coords[i * 3 + 1];
 3037:    node.depth = node_coords[i * 3 + 2];
 3038: 
 3039:    if (use_ll) {
 3040:    node.lon = node_coords_ll[i * 2    ]*deg2rad;
 3041:    node.lat = node_coords_ll[i * 2 + 1]*deg2rad;
 3042:    }
 3043: 
 3044: 
 3045:    node.numSides = 0;
 3046: 
 3047:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3048:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3049:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3050:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3051:    else assert(false && "populateNodes: selected nchi not implemented.");
 3052:    
 3053:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3054:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3055:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3056: 
 3057:    
 3058:    // Links the node to the boundary information
 3059:    if (isbnd[i] >= 0) {
 3060:      
 3061:       // Get the index of the node boundary
 3062:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3063: 
 3064:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3065:       node.nodeBnd->node = &node;
 3066: 
 3067:       node.nodeBnd->sideBnd1 = nullptr;
 3068:       node.nodeBnd->sideBnd2 = nullptr;
 3069: 
 3070:       if (isbnd[i]>=0) {
 3071: 
 3072:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3073:          
 3074:          node.nodeBnd->segment->ifltype = 3 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3075:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3076: 
 3077:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3078:          node.nodeBnd->segment->clen  = nan("1");
 3079:          node.nodeBnd->segment->carea = nan("1");
 3080: 
 3081:       }
 3082:    } else {
 3083: 
 3084:       node.nodeBnd = nullptr; // For internal nodes
 3085: 
 3086:       if (isbnd[i] == landSegment) {
 3087:          node.nodeBnd = &landBoundaryNode;
 3088:          node.nodeBnd->segment = &landBoundarySegment;
 3089:       }
 3090:       
 3091:    }
 3092:    
 3093:    // XXXX GAUSSIAN HILL VELOCITIES
 3094: #ifdef GAUSSIAN_HILL_VELOCITIES
 3095:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3096:       constexpr double rot_per = 3000.0;
 3097:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3098:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3099:    // XXXXX
 3100: #endif
 3101: 
 3102: }
 3103: 
 3104: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3105:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3106:                                     double *wind_rotate_angle,   
 3107:                                     int *isdel, int *isidenode, int *isbnd,
 3108:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3109:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3110:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3111:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3112:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3113:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3114:                                     double *drag, double *roughness) {
 3115: 
 3116: 
 3117:    SIDE(pside);
 3118:    Side &side(*pside);
 3119:    const int i = idx_side;
 3120: 
 3121:    side.idx = i;  
 3122:    
 3123:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3124:    const double fc   = 2.0*omega_e*sin(sfea0);
 3125:    const double beta = 2.0*omega_e*cos(sfea0);
 3126: 
 3127:    // finding the pointer to the nodes that form the side
 3128:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3129:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3130: 
 3131:    const int locidx_n1 = localNodeIndices[idx_n1];
 3132:    const int locidx_n2 = localNodeIndices[idx_n2];
 3133:    const int part_n1 =   localNodePart[idx_n1];
 3134:    const int part_n2 =   localNodePart[idx_n2];
 3135: 
 3136:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3137:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3138: 
 3139:    // Counts the number of sides connected to each node
 3140:    side.n1->numSides++;
 3141:    side.n2->numSides++;
 3142: 
 3143:    // Normal, unitary vector to the side
 3144:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3145:    side.n = normalize(side.n);
 3146: 
 3147:    // Side boundary type
 3148:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3149:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3150: 
 3151:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3152:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3153:    {
 3154:       bool isLand = false;
 3155:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3156:       
 3157:       if (isbs > -1) {
 3158:          // assert(isLand || isbs>=0);
 3159:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3160: 
 3161:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3162: 
 3163:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3164:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3165: 
 3166:          assert (isLand == side.sideBnd->segment->isLand);
 3167: 
 3168:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3169:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3170:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3171: 
 3172:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3173:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3174:          
 3175:          side.sideBnd->side = &side;
 3176: 
 3177:       }
 3178:       else {
 3179:          side.sideBnd = nullptr;
 3180:       }
 3181:    }
 3182:    else 
 3183:    {
 3184:       side.sideBnd = nullptr;
 3185:    }
 3186: 
 3187: 
 3188:    // finding the pointer to the elements that share the side
 3189:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3190:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3191: 
 3192:    if (idx_e1 > -1) {
 3193:       const int locidx_e1 = localElemIndices[idx_e1];
 3194:       const int part_e1 =  localElemPart[idx_e1];
 3195:       side.elems[0] = elems[part_e1] + locidx_e1;
 3196: 
 3197:    }
 3198:    else {
 3199:       side.elems[0] = nullptr;
 3200:    }
 3201: 
 3202:    if (idx_e2 > -1) {
 3203:       const int locidx_e2 = localElemIndices[idx_e2];
 3204:       const int part_e2 =  localElemPart[idx_e2];
 3205:       side.elems[1] = elems[part_e2] + locidx_e2;
 3206:    }
 3207:    else {
 3208:       side.elems[1] = nullptr;
 3209:    }
 3210: 
 3211:    // Compute the center of the side
 3212:    side.center = 0.5*(side.n1->p + side.n2->p);
 3213: 
 3214:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3215:    side.shapiro = shapiro0;
 3216: 
 3217: #ifdef GAUSSIAN_HILL_VELOCITIES
 3218: // XXXX
 3219: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3220: constexpr double rot_per=3000.0;
 3221: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3222: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3223: // XXXXX      
 3224: #endif
 3225:    // Compute the z level at the center of the side
 3226:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3227:    
 3228:    // Compute the length of the side
 3229:    const Vector2 vLen = side.n2->p - side.n1->p;
 3230:    side.len = sqrt(dot(vLen, vLen));
 3231: 
 3232: 
 3233:    // Compute the Coriolis coefficient
 3234: 
 3235:    if constexpr(ncor == -1 || ncor == 0) {
 3236:       side.coriolis = coricoef;
 3237:    }
 3238:    else {
 3239:       const double sphi = side.lat();  // Latitude at the center of the side
 3240: 
 3241: // XXXXXX ERROR WHEN use_ll is false??????
 3242:       if constexpr(ics == 1) {
 3243:          // XXXXXXX
 3244:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3245:       }
 3246:       else {
 3247:          side.coriolis = 2.0*omega_e*sin(sphi);
 3248:       }
 3249: 
 3250:    }
 3251: }
 3252: 
 3253: 
 3254: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3255:    double *node_coords, double *node_coords_ll, bool use_ll,
 3256:    double *wind_rotate_angle,   
 3257:    int *isdel, int *isidenode, int *isbnd,
 3258:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3259:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3260:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3261:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3262:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3263:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3264:    double *drag, double *roughness) {
 3265: 
 3266:    ELEM(pelem);
 3267:    Element &elem(*pelem);
 3268:    const int i = idx_elem;
 3269: 
 3270:    elem.idx = i;
 3271: 
 3272:    for (int j = 0; j < i34[i]; j++) {
 3273:       const int idxNode = elnode[i*4 + j];  
 3274:       const int idxSide = elside[i*4 + j];
 3275:       
 3276:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3277:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3278: 
 3279:       // Find the neighboring element  
 3280:       if (elem.sides[j]->elems[0] == &elem) {
 3281:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3282:       }
 3283:       else {
 3284:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3285:       }
 3286:       
 3287:    }
 3288: 
 3289:    elem.i34 = i34[i];
 3290: 
 3291:    // Compute the barycenter of the element and its depth
 3292:    elem.center = {0.0, 0.0};
 3293:    elem.depth = 0.0;
 3294:    for (int j = 0; j < i34[i]; j++) {
 3295: 
 3296:       elem.center += elem.nodes[j]->p/i34[i];
 3297:       elem.depth  += elem.nodes[j]->depth/i34[i];
 3298:    }
 3299: 
 3300: 
 3301:    
 3302:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3303:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3304: 
 3305:    elem.area = elem.computeSignedArea(); 
 3306:    elem.radius = sqrt(elem.area)/pi; 
 3307:    
 3308:    // Determines which way the normal vector to each side is oriented.
 3309:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3310:    for (int j = 0; j < i34[i]; j++)  
 3311:    {
 3312:       if (elem.sides[j]->elems[0] == &elem) {
 3313:          elem.ssign[j] =  1.0;
 3314:       }
 3315:       else {
 3316:          elem.ssign[j] = -1.0;
 3317:       }
 3318: 
 3319:    }
 3320: 
 3321:    // Derivatives of shape functions
 3322:    //  For ics=2, this is done inside element/ll frame XXX
 3323:    //  For quads, the derivative is evaluated at centroid
 3324:    for (int j = 0; j < elem.i34; j++) {
 3325:       const double area = elem.area;
 3326:       const int id2 = elem.nxq(1 + j);
 3327:       const int id3 = elem.nxq(2 + j);
 3328:       const int id4 = elem.nxq(3 + j);
 3329:       if (elem.isTri()) {
 3330:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3331:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3332:          // da1/dx = (y1 - y2)/(2*area)
 3333:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3334:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3335:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3336:       }
 3337:       else  { // Quad; evaluate at centroid
 3338:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3339:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3340:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3341:       } // if Tri
 3342: 
 3343:    } // for j   
 3344:    
 3345:    
 3346: 
 3347: }
 3348: 
 3349: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3350:                                             double *emo, double *efa, 
 3351:                                             double *umo, double *ufa, 
 3352:                                             double *vmo, double *vfa) {
 3353: 
 3354: 
 3355:    NODE_BND(nodeBnd);
 3356:    const int idx = idx_node_bnd;    
 3357: 
 3358:    nodeBnd->idx = idx;
 3359: 
 3360:    // Need to find the segment index and the index of the node on the segment
 3361:    int idxNode = -1;
 3362:    int iseg, i;
 3363:    for (iseg = 0; iseg < nope; iseg++) {
 3364:       // for each segment...
 3365:       for (i = 0; i < nond[iseg]; i++) {
 3366:          idxNode = iond[iseg + i*nope];
 3367:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3368:          
 3369:       }
 3370:    }
 3371: 
 3372:    assert(iseg < nope && "iseg is out of bounds");
 3373: 
 3374: found: // Jumped here when the node was found
 3375: 
 3376:    nodeBnd->isEssentialBC = true;
 3377:    nodeBnd->elbc = 0.0;
 3378: 
 3379:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3380: 
 3381:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 3382:       nodeBnd->efa[jfr] = efa[idx2];
 3383:       nodeBnd->emo[jfr] = emo[idx2];
 3384:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3385:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3386: 
 3387:    }
 3388:         
 3389: 
 3390: }
 3391: 
 3392: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 3393:                 double *node_coords, double *node_coords_ll, bool use_ll,
 3394:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 3395:                 int *isdel, int *isidenode, int *isbnd,
 3396:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 3397:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3398:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3399:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3400:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3401:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 3402:                 double *drag, double *roughness,
 3403:                 double *emo, double *efa, 
 3404:                 double *umo, double *ufa, 
 3405:                 double *vmo, double *vfa) {
 3406: 
 3407:    printf("Populating mesh for partition %d\n", partNum);
 3408: 
 3409:    // XXXXXX THIS function does almost nothing. 
 3410: 
 3411:    nbs = *sharedIdxSideBoundary + 1;
 3412:    nbp = *sharedIdxNodeBoundary + 1;
 3413: 
 3414:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 3415: 
 3416: }
 3417: 
 3418: 
 3419: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3420:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3421:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3422: 
 3423: 
 3424:    NODE(node1);
 3425: 
 3426:    node1->clearMatrixRow();
 3427:    node1->qel = 0.0;
 3428: 
 3429:    // THIS IS FOR STRUCTURES XXX
 3430:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3431: 
 3432:    
 3433:    for (int j=0; j<node1->numElements; j++) {
 3434:       // For each element connected to the node...
 3435: 
 3436:       Element *elem = node1->elements[j];
 3437: 
 3438: 
 3439: 
 3440:       // Compute the average gravity
 3441:       const double grav3 = elem->mean(&Node::grav2);
 3442: 
 3443:       // Look at the documentation for the description of the terms in the following integrals
 3444: 
 3445:       // Integral I_1 
 3446:       // \bar{\breve{H}} 
 3447:       const double hhatb = elem->mean(&Side::hhat);        
 3448: 
 3449:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3450: 
 3451:       const int id1 = elem->nodeLocalIdx(node1); 
 3452:       const double area = elem->area;
 3453: 
 3454:       if (elem->isTri()) {
 3455: 
 3456:          // To clarify the notation in this section: 
 3457:          //   i stands for the node under consideration (node1)
 3458:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3459:          const int id2 = elem->nxq(1 + id1);
 3460:          const int id3 = elem->nxq(2 + id1);
 3461:          Node *node2 = elem->nodes[id2];
 3462:          Node *node3 = elem->nodes[id3];
 3463: 
 3464:          const Point2 x1 = node1->p;
 3465:          const Point2 x2 = node2->p;
 3466:          const Point2 x3 = node3->p;
 3467: 
 3468:          // integral of phi_i*phi_j
 3469:          const double ipp_ii = (1.0/6.0 )*area;
 3470:          const double ipp_ij = (1.0/12.0)*area;
 3471:          const double ipp_ik = (1.0/12.0)*area;
 3472: 
 3473:          // integral of [(grad phi_i) * (grad phi_j)]
 3474:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3475:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3476:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3477: 
 3478:          // Computes the different components of integral I_1 of each node with respect to node i.
 3479:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3480:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3481:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3482: 
 3483:          node1->addToSparseMatrix(node1, I1_ii);
 3484:          node1->addToSparseMatrix(node2, I1_ij); 
 3485:          node1->addToSparseMatrix(node3, I1_ik);
 3486: 
 3487:       }
 3488:       else { // Quad
 3489:          // XXX IMPLEMENT THIS
 3490:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3491: 
 3492:          // To clarify the notation in this section: 
 3493:          //   i stands for the node under consideration (node1)
 3494:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3495:          const int id2 = elem->nxq(1 + id1);
 3496:          const int id3 = elem->nxq(2 + id1);
 3497:          const int id4 = elem->nxq(3 + id1);
 3498:          Node *node2 = elem->nodes[id2];
 3499:          Node *node3 = elem->nodes[id3];
 3500:          Node *node4 = elem->nodes[id4];         
 3501: 
 3502:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3503:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3504:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3505:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3506:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3507: 
 3508:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3509:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3510:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3511:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3512:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3513: 
 3514:          // Computes the different components of integral I_1 of each node with respect to node i.
 3515:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3516:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3517:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3518:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3519: 
 3520:          node1->addToSparseMatrix(node1, I1_ii);
 3521:          node1->addToSparseMatrix(node2, I1_ij); 
 3522:          node1->addToSparseMatrix(node3, I1_ik);
 3523:          node1->addToSparseMatrix(node4, I1_il);
 3524:   
 3525:       } 
 3526: 
 3527:  
 3528:       // Integral I_4
 3529:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3530:       // Where
 3531:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3532: 
 3533:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3534:       // of U over the element.
 3535:       Vector2 U = {0.0, 0.0};
 3536:       for (int m=0; m < elem->i34; m++) {      
 3537:          const Side *side = elem->sides[m];
 3538: 
 3539:          if constexpr(ics == 1) U += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3540:          else                   U += side->frame.project_hvec(side->U, elem->frame);
 3541:       }
 3542:       U = U/elem->i34;
 3543: 
 3544: 
 3545:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3546: 
 3547: 
 3548:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3549:       const double I_4_1 = dot(gradPhi_1, U);
 3550: 
 3551: 
 3552:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3553:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3554: 
 3555:      
 3556:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3557: 
 3558:       // Additional terms 
 3559:       double vnorm = 0.0;
 3560:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3561:          Vector3 ubed = {0.0, 0.0, 0.0};
 3562:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3563: 
 3564:          Vector3 gradP = {0.0, 0.0, 1.0};
 3565:          for (int m=0; m < elem->i34; m++) {
 3566:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3567:            gradP += toVector3(gradP_2D, 0.0);
 3568:          }   
 3569:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3570:       } // imm==2
 3571: 
 3572:       if (elem->isTri()) {
 3573:          for (int l=0; l<3; l++) {
 3574: 
 3575:             Node *node = elem->nodes[l];
 3576: 
 3577:             double fac = (node == node1) ? 2.0 : 1.0;
 3578:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3579:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3580:            
 3581:          }
 3582: 
 3583: 
 3584:          if (!elem->isDry) {
 3585:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3586: 
 3587:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3588: 
 3589:          }
 3590: 
 3591:       } // isTri
 3592:       else { // isQuad
 3593:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3594:          // for (int l=0; l<4; l++) {
 3595:          //   const Node *node = elem->nodes[l];
 3596: 
 3597:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3598:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3599: 
 3600:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3601:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3602:          // }
 3603: 
 3604:       } // isQuad
 3605: 
 3606: 
 3607:      node1->qel += (dt/elem->i34)*elem->vsource;
 3608:       
 3609: 
 3610:    } // for all elements connected to the node
 3611:    
 3612: 
 3613:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3614:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 3615:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3616:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3617:       // If it is an open boundary node...
 3618: 
 3619:       // At least one open bnd side, maybe two
 3620:       for (int l=0; l<2; l++) { 
 3621: 
 3622:          // Gets each of the sides sharing the node. 
 3623:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3624: 
 3625:        
 3626: 
 3627:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3628:          if (sideBnd != nullptr) {
 3629:             // If the side is on a boundary...
 3630: 
 3631:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3632: 
 3633:             // Get the boundary segment
 3634:             const BoundarySegment *sideSegment = sideBnd->segment;
 3635:             const Side *side = sideBnd->side;
 3636: 
 3637:             // Integral I_3
 3638:             if (sideSegment->ifltype != 0) {
 3639:             // Natural or Flather b.c.
 3640: 
 3641:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3642:                // especially for Flather b.c.
 3643:                double ri3 = 0.0;
 3644:                if (!side->isDry) {
 3645:                   // If the side is not dry
 3646:                   
 3647:                   // Computes the side flux of (uth, vth)
 3648:                   double Vn = 0.0;
 3649:                   for (int k = side->kb; k < nvrt - 1; k++) {
 3650:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3651:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3652: 
 3653:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 3654:                   }
 3655: 
 3656:                   ri3 = 0.5*side->len*Vn;
 3657:                }
 3658: 
 3659:                if (sideSegment->ifltype == -1) { // Flather 1
 3660: 
 3661:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3662:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3663: 
 3664:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3665:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3666:                   
 3667:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3668:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3669: 
 3670:                } 
 3671:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3672:                   // Reset ri3
 3673:                   ri3 = 0.0;
 3674: 
 3675:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3676: 
 3677:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3678: 
 3679:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3680:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3681: 
 3682:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3683:                   node1->addToSparseMatrix(node1, con0*2.0);
 3684:                   node1->addToSparseMatrix(node2, con0);
 3685: 
 3686:                } // if Flather or Discharge
 3687: 
 3688:                node1->qel -= thetai*dt*ri3;
 3689: 
 3690: 
 3691:             } // I_3
 3692:           
 3693: 
 3694:             // Integral I_5
 3695:             if(!side->isDry) {
 3696: 
 3697:                const double Unbar = dot(side->U, side->n);
 3698:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3699: 
 3700:             } // I_5
 3701: 
 3702:          } // if is boundary side
 3703: 
 3704:       } // for l
 3705: 
 3706:    } // if isbnd
 3707: 
 3708: 
 3709: }
 3710: 
