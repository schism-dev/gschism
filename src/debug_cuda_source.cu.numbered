  958: struct Side {
  959: 
  960:    // Geometry information
  961:    int idx;               // Index of the side
  962:    Node *n1, *n2;
  963:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  964: 
  965:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
  966:    Vector2 center;        // Location of side center. 
  967:    double zc[nvrt];       // Side center z-coord at each vertical level
  968: 
  969:    Frame frame;
  970: 
  971:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  972:                           // this is nullptr
  973:    
  974:    int kb;                // Bottom index of the side
  975:    bool isDry;            // True if the side is dry
  976:  
  977:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  978: 
  979:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
  980: 
  981:    // Physical information
  982:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  983:    double  w2[nvrt];            // Vertical velocity at each vertical level
  984:    Vector2 btu[nvrt];           // Back-tracked velocity
  985:    Vector2 U;                   // Vertically averaged velocity vector  
  986: 
  987:    Vector2 nuGradU[nvrt];          // nu*grad u
  988: 
  989:    Vector2 bcc[nvrt];           // Baroclinic term
  990:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
  991: 
  992:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
  993:    Vector2 gradEta2;             // Gradient of elevation at current timestep
  994:    Vector2 gradPr;               // Gradient of pressure
  995:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
  996: 
  997: 
  998:    double hhat;                 // \breve{H} in notes
  999: 
 1000:    double shapiro;
 1001: 
 1002:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1003: 
 1004:    double coriolis;             // Coriolis parameter
 1005: 
 1006:    // Vegetation parameters
 1007:    double veg_c2;
 1008:    double veg_beta;
 1009: 
 1010:    // Bottom drag parameters.
 1011:    double chi;
 1012:    double chi2;
 1013: 
 1014:    __inline__ __device__ double x(double t) const;
 1015:    __inline__ __device__ double y(double t) const;
 1016:    __inline__ __device__ double lon(void) const;
 1017:    __inline__ __device__ double lat(void) const;
 1018:    __inline__ __device__ Point2 p_t(double t) const;
 1019: 
 1020:    __inline__ __device__ Point3 center3D(int k) const { assert(k < nvrt); return {center.x, center.y, zc[k]}; }
 1021:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
 1022:    __inline__ __device__ double Dz(int k)       const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1023:    __inline__ __device__ double area(int k)     const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1024: 
 1025:    __inline__ __device__ Side* neigh(int index) const { 
 1026:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1027:       assert(index >= 0 && index < 4); 
 1028:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1029: 
 1030:       const int ielem = index & 1;           // 0 or 1
 1031:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1032: 
 1033:       const Element* elem = elems[ielem];
 1034: 
 1035:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1036: 
 1037:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1038: 
 1039:    }
 1040: 
 1041:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1042: 
 1043:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1044: 
 1045:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1046:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1047:    __inline__ __device__ int iadv(void) const;
 1048: 
 1049:    __inline__ __device__ double grav3(void) const;
 1050:    
 1051:    __inline__ __device__ double eta2(void) const;
 1052:    __inline__ __device__ double eta1(void) const;
 1053:    __inline__ __device__ double depth(void) const;
 1054:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1055:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1056: 
 1057:    __inline__ __device__ double dfv(int k) const;
 1058: 
 1059:    __inline__ __device__ double veg_h(void)  const;
 1060:    __inline__ __device__ double veg_nv(void) const;
 1061:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1062:    __inline__ __device__ double veg_alpha3D(int k) const;
 1063:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1064: 
 1065:    __inline__ __device__ double Cd(void) const;
 1066: 
 1067:    __inline__ __device__ Vector2 tau(void) const;
 1068: 
 1069:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1070:    
 1071: 
 1072:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1073:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1074:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1075:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1076:    } 
 1077:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1078:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1079:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1080:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1081: 
 1082:    // Get valid starting element (for backtracking)
 1083:    __inline__ __device__ Element* getStartElement() {
 1084:       return elems[0] ? elems[0] : elems[1];
 1085:    }
 1086: 
 1087:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
 1088:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
 1089: 
 1090:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
 1091: 
 1092:       // Dot product of the negative velocity vector with the side normal vector
 1093:       const double dot_prod1 = -dot(u, n);
 1094: 
 1095:       // Vector from side center to element 0 centroid
 1096:       const Vector2 v2 = elems[0]->center - center;
 1097: 
 1098:       // Dot product of the vector with the side normal vector
 1099:       const double dot_prod2 = dot(v2, n);
 1100: 
 1101:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
 1102:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
 1103: 
 1104:       const bool isDry0 = elems[0]==nullptr || elems[0]->isDry;
 1105:       const bool isDry1 = elems[1]==nullptr || elems[1]->isDry;
 1106:       if (dot_prod1*dot_prod2 > 0.0) return !isDry0 ? elems[0] : nullptr;
 1107:       else                           return !isDry1 ? elems[1] : nullptr;
 1108: 
 1109:  
 1110:    }
 1111: 
 1112:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1113:       // Given an element, returns the other element that shares this side
 1114:       return (elems[0] == elem) ? elems[1] : elems[0];
 1115:    }
 1116: 
 1117:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1118:       // Given a node, returns the other node that shares this side
 1119:       return (n1 == node) ? n2 : n1;
 1120:    }
 1121:  
 1122:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1123: 
 1124: 
 1125: 
 1126: 
 1127: };
