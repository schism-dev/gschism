 1173: // This struct is used to store the boundary information for a node.
 1174: struct NodeBoundary {   
 1175:    int idx;
 1176:    BoundarySegment *segment;
 1177:    Node *node;
 1178:    
 1179:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1180:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1181: 
 1182:    bool isLand;
 1183: 
 1184:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1185:    double elbc;   // Elevation boundary condition
 1186:    double eth;    // Elevation time history
 1187: 
 1188:    double eta_mean; // Mean elevation at nodes
 1189: 
 1190:    bool isEssentialBC;
 1191: 
 1192:    Vector2 uth[nvrt];  // "Time history" velocity
 1193: 
 1194:    // Arrays for harmonic constituents (if needed)
 1195:    double  emo[nbfr];  // Elevation amplitude
 1196:    double  efa[nbfr];  // Elevation phase
 1197:    Vector2 umo[nbfr];  // velocity amplitude
 1198:    Vector2 ufa[nbfr];  // velocity phase
 1199: 
 1200: 
 1201:    NodeBoundary(void) {
 1202:       isLand = false;
 1203:    }
 1204:    NodeBoundary(bool _isLand) {
 1205:       isLand = _isLand;
 1206:    }
 1207: 
 1208:    
 1209:    __forceinline__ __device__ int numSidesForAverage() const {
 1210:    // Returns the number of sides that are connected to the node and have the same segment.
 1211:    // This is used to compute the average velocity at the node for open boundary nodes.
 1212:       int res = 0;
 1213:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1214:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1215: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1216:       return res;
 1217:    }
 1218: 
 1219: 
 1220:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1221:       assert(index == 0 || index == 1); 
 1222:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1223:    }
 1224: 
 1225: 
 1226: };
