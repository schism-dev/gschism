 3713: extern "C" {
 3714:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 3715:                                   int* indices, int* indptr) {
 3716: 
 3717:       NODE(node);
 3718:       
 3719:       const int idx = node->idx;
 3720:       
 3721:       // Computes the index in the nzz array      
 3722:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 3723: 
 3724: 
 3725:       indptr[idx] = nzzIdx;
 3726:       indices[nzzIdx] = idx;
 3727: 
 3728:       data_d[nzzIdx]    = node->coeffDiag;
 3729: 
 3730:       b_d[idx] = node->qel;
 3731: 
 3732:       for (int k = 0; k < node->numNodes; ++k) {
 3733:          const Node* nb = node->nodes[k];
 3734: 
 3735:          const int j = nb->idx;
 3736: 
 3737:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 3738: 
 3739:          indices[nzzIdx + k + 1] = j;
 3740:       }
 3741: 
 3742:  
 3743:    }
 3744: 
