 2842: __device__ __inline__ void Node::updateZCoordData(void) {
 2843: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2844: 
 2845:    // assert(!isDry2() && "updateZCoordData: node is dry");
 2846:    // if (isDry2()) {
 2847:    //    kb = -1;  // XXXXXXXX KKKKK
 2848:    //    return;
 2849:    // }
 2850: 
 2851: 
 2852:    if constexpr(ivcor == 2) {  // SZ coordinates
 2853:       
 2854:       // Compute bottom level index
 2855:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 2856:    } 
 2857:    else if (ivcor == 1) {  // Localized sigma
 2858:       // Do nothing
 2859:    }
 2860: 
 2861: 
 2862: }
