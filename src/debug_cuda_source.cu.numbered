 4466:    __global__ void computeFlowBcVelocities(double time) {
 4467: 
 4468:       SIDE_BND(sideBnd);
 4469: 
 4470:       const Side *side = sideBnd->side;
 4471:  
 4472:       const bool isDry = side->isDry;
 4473:       const bool isLand = sideBnd->segment->isLand;
 4474: 
 4475:    
 4476:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4477: 
 4478:       if (isDry || isLand) return;
 4479: 
 4480:       // For wet sides in open boundaries...
 4481:       const Vector2 n = side->n;
 4482:       const BoundarySegment *segment = sideBnd->segment;
 4483: 
 4484:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4485: 
 4486:       const int ifltype = segment->ifltype;
 4487: 
 4488:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4489:       const Vector2 r_nuth0 = r_uth0*n;
 4490: 
 4491: 
 4492:       if (ifltype == 1 || ifltype == 2) {
 4493:       
 4494:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4495: 
 4496:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4497:          
 4498:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4499:          
 4500:       } else if (ifltype == -1) { // Flather 1
 4501: 
 4502:          for (int k = 0; k < nvrt; k++) {
 4503: 
 4504:             // uth is the normal vel.; no ramp up
 4505:             const double uth = sideBnd->nuth(k);
 4506:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4507: 
 4508:             sideBnd->ubc[k] += uth*n;
 4509:          }
 4510: 
 4511:       } else if (ifltype == 3 || ifltype == 5) {
 4512:          // vnth0=0 !normal vel.
 4513: 
 4514:          Vector2 r_u1_bar = {0.0, 0.0};
 4515:          // Computes the contribution to the velocity from all tide frequencies
 4516:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4517: 
 4518:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4519:             const Vector2 umo  = sideBnd->umo(jfr); 
 4520: 
 4521:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4522:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4523:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4524:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4525:          }
 4526: 
 4527: 
 4528:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4529: 
 4530:       } // if (ifltype = 3 || ifltype == 5
 4531: 
 4532: 
 4533: 
 4534:    }
 4535: 
 4536:    __global__ void computeElevationBoundaryConditions(double time) {
 4537:       // Compute elevation essential boundary conditions 
 4538: 
 4539:       NODE_BND(nodeBnd); // Each boundary node.
 4540: 
 4541:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4542: 
 4543:       const Node *node = nodeBnd->node;
 4544:       const BoundarySegment *segment = nodeBnd->segment;
 4545:       const int iettype = segment->iettype;
 4546:       
 4547: 
 4548:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4549:       double eic = 0.0;
 4550:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4551:       else                 eic = 0.0;
 4552: 
 4553:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4554:       const double r_eth = ramp*nodeBnd->eth;
 4555:       double r_eta1_bar = 0.0;
 4556: 
 4557: 
 4558:       // Compute tide elevation
 4559:       if (iettype == 3 || iettype == 5) {   
 4560: 
 4561:          if constexpr(iloadtide==1) { // loading tide
 4562:             assert(false && "Loading tide not implemented");
 4563:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4564:          }
 4565:          
 4566:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4567: 
 4568:             const double efa  = nodeBnd->efa[jfr]; 
 4569:             const double emo  = nodeBnd->emo[jfr]; 
 4570: 
 4571:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4572:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4573:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4574: 
 4575:          } // for jfr
 4576: 
 4577:       } // if iettype
 4578: 
 4579:       switch (iettype) {
 4580:          case 1:
 4581:          case 2:
 4582:          case 4:
 4583:             nodeBnd->elbc = r_eic + r_eth;
 4584:             break;
 4585:          case 3:
 4586:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4587:             break;
 4588:          case 5:
 4589:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4590:             break;
 4591:       } // switch
 4592: 
 4593: 
 4594:       //Add inverse barometric effects
 4595:       if (iettype != 0 && inv_atm_bnd == 1) {
 4596:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4597:       }
 4598: 
 4599:    }
 4600: 
 4601: 
 4602:    __global__ void computeHorizontalViscosity(void) { 
 4603: 
 4604:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4605: 
 4606:       SIDE(side);
 4607: 
 4608:       if (side->isDry) return;
 4609: 
 4610:       for (int k = 0; k < nvrt; k++) {
 4611:          side->nuGradU[k] = {0.0, 0.0};
 4612:       }
 4613: 
 4614:       if constexpr(ihorcon == 1) {
 4615:          for (int k = side->kb; k < nvrt - 1; k++) {
 4616:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4617:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 4618:             // By Zhang and Baptista.
 4619: 
 4620:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4621:             // This is a standard discretization of the Laplacian operator.
 4622:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4623:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4624:             // Gamma is hvis_coef0 in the code.
 4625:             // The value of gamma needs to be < 0.5.
 4626: 
 4627:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4628:             // side under consideration in each of the two possible elements that share the side.
 4629:             Vector2 sumU = {0.0, 0.0};
 4630:             for (int l = 0; l < 2; l++) {
 4631:                const Element *elem = side->elems[l];
 4632: 
 4633:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4634: 
 4635:                // Find the local index of the side in the element
 4636:                const int idxSide = elem->sideLocalIdx(side);
 4637:                // Find the two sides that are connected to the side under consideration
 4638:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4639:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4640: 
 4641:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4642: 
 4643:             }
 4644: 
 4645:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4646:    
 4647:          }
 4648:       }
 4649:       else if constexpr(ihorcon == 2) {
 4650:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4651:       }
 4652: 
 4653: 
 4654:    }
 4655: 
 4656: 
 4657:    __global__ void setEssentialBC(void) {
 4658:       // Set essential boundary conditions 
 4659:       NODE(node); // Each boundary node
 4660:       NodeBoundary *nodeBnd = node->nodeBnd;
 4661:       
 4662: // nodeBnd->isEssentialBC = true;      
 4663:       // Check if this node has essential BC
 4664:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4665:          // Verify BC value is valid
 4666:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4667: 
 4668:        
 4669:          // Set diagonal to 1 and zero off-diagonals
 4670:          node->coeffDiag = 1.0;
 4671: 
 4672:          for (int j = 0; j < node->numNodes; j++) {
 4673:                node->coeffMatrix[j] = 0.0;
 4674:          }
 4675:          
 4676:          // Set solution and RHS to BC value
 4677:          node->mX  = nodeBnd->elbc;
 4678:          node->qel = nodeBnd->elbc;
 4679: 
 4680:       } else {
 4681:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4682: 
 4683:          for (int j = 0; j < node->numNodes; j++) {
 4684:                Node* nbNode = node->nodes[j];
 4685:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4686:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4687:                   // Verify neighbor's BC value
 4688:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4689: 
 4690:                   // Subtract contribution to RHS
 4691:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4692:                   node->coeffMatrix[j] = 0.0;  
 4693:                }
 4694:          }
 4695:       }
 4696:    }
 4697: 
 4698: 
 4699:    __global__ void updateElevation(void) {
 4700:       NODE(node);
 4701: 
 4702:       node->eta2 = node->mX;
 4703: 
 4704:       node->updateZCoordData();
 4705:    }
