 9909: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 9910:    // Get the value of a variable from an side
 9911:    // varName is the name of the variable to get
 9912:    // var is the array to store the value
 9913:    // k is the vertical level index of the variable to get
 9914:    SIDE_BND(sideBnd);   
 9915: 
 9916:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 9917:    if (sideBnd->segment->isLand) idx = -7;
 9918: 
 9919:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 9920:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 9921: 
 9922: }
