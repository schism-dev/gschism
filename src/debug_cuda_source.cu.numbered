 3979: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3980:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3981:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3982: 
 3983: 
 3984:    NODE(node1);
 3985: 
 3986:    node1->clearMatrixRow();
 3987:    node1->qel = 0.0;
 3988: 
 3989:    // THIS IS FOR STRUCTURES XXX
 3990:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3991: 
 3992:    
 3993:    for (int j=0; j<node1->numElements; j++) {
 3994:       // For each element connected to the node...
 3995: 
 3996:       Element *elem = node1->elements[j];
 3997: 
 3998: 
 3999: 
 4000:       // Compute the average gravity
 4001:       const double grav3 = elem->mean(&Node::grav2);
 4002: 
 4003:       // Look at the documentation for the description of the terms in the following integrals
 4004: 
 4005:       // Integral I_1 
 4006:       // \bar{\breve{H}} 
 4007:       const double hhatb = elem->mean(&Side::hhat);        
 4008: 
 4009:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 4010: 
 4011:       const int id1 = elem->nodeLocalIdx(node1); 
 4012:       const double area = elem->area;
 4013: 
 4014:       if (elem->isTri()) {
 4015: 
 4016:          // To clarify the notation in this section: 
 4017:          //   i stands for the node under consideration (node1)
 4018:          //   j (node2) and k (node3) are the other nodes of the triangle.
 4019:          const int id2 = elem->nxq(1 + id1);
 4020:          const int id3 = elem->nxq(2 + id1);
 4021:          Node *node2 = elem->nodes[id2];
 4022:          Node *node3 = elem->nodes[id3];
 4023: 
 4024:          Point2 x1, x2, x3;
 4025:          elem->getLocalHorizontalNodePositionsTri(x1, x2, x3, id1);
 4026: 
 4027: 
 4028:          // integral of phi_i*phi_j
 4029:          const double ipp_ii = (1.0/6.0 )*area;
 4030:          const double ipp_ij = (1.0/12.0)*area;
 4031:          const double ipp_ik = (1.0/12.0)*area;
 4032: 
 4033:          // integral of [(grad phi_i) * (grad phi_j)]
 4034:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 4035:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 4036:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 4037: 
 4038:          // Computes the different components of integral I_1 of each node with respect to node i.
 4039:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4040:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4041:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4042: 
 4043:          node1->addToSparseMatrix(node1, I1_ii);
 4044:          node1->addToSparseMatrix(node2, I1_ij); 
 4045:          node1->addToSparseMatrix(node3, I1_ik);
 4046: 
 4047:       }
 4048:       else { // Quad
 4049:          // XXX IMPLEMENT THIS
 4050:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 4051: 
 4052:          // To clarify the notation in this section: 
 4053:          //   i stands for the node under consideration (node1)
 4054:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 4055:          const int id2 = elem->nxq(1 + id1);
 4056:          const int id3 = elem->nxq(2 + id1);
 4057:          const int id4 = elem->nxq(3 + id1);
 4058:          Node *node2 = elem->nodes[id2];
 4059:          Node *node3 = elem->nodes[id3];
 4060:          Node *node4 = elem->nodes[id4];         
 4061: 
 4062:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 4063:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 4064:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 4065:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 4066:          const double ipp_il = elem->intPhiPhi(id1, id4);
 4067: 
 4068:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 4069:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 4070:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 4071:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 4072:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 4073: 
 4074:          // Computes the different components of integral I_1 of each node with respect to node i.
 4075:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4076:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4077:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4078:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 4079: 
 4080:          node1->addToSparseMatrix(node1, I1_ii);
 4081:          node1->addToSparseMatrix(node2, I1_ij); 
 4082:          node1->addToSparseMatrix(node3, I1_ik);
 4083:          node1->addToSparseMatrix(node4, I1_il);
 4084:   
 4085:       } 
 4086: 
 4087:  
 4088:       // Integral I_4
 4089:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 4090:       // Where
 4091:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 4092: 
 4093:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 4094:       // of U over the element.
 4095:       Vector2 U = {0.0, 0.0};
 4096:       for (int m=0; m < elem->i34; m++) {      
 4097:          const Side *side = elem->sides[m];
 4098: 
 4099:          if constexpr(ics == 1) U += side->U; 
 4100:          else                   U += side->frame.projHorVec(side->U, elem->frame);  // In global coordinates, we must project the side velocity to the element frame
 4101: 
 4102:       }
 4103:       U = U/elem->i34;
 4104: 
 4105: 
 4106:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 4107: 
 4108: 
 4109:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 4110:       const double I_4_1 = dot(gradPhi_1, U);
 4111: 
 4112: 
 4113:       // Integral of \nabla\phi_i \cdot \pmb{E}
 4114:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 4115: 
 4116:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 4117: 
 4118:       // Additional terms 
 4119:       double vnorm = 0.0;
 4120:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 4121:          Vector3 ubed = {0.0, 0.0, 0.0};
 4122:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 4123: 
 4124:          Vector3 gradP = {0.0, 0.0, 1.0};
 4125:          for (int m=0; m < elem->i34; m++) {
 4126:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 4127:            gradP += toVector3(gradP_2D, 0.0);
 4128:          }   
 4129:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 4130:       } // imm==2
 4131: 
 4132:       if (elem->isTri()) {
 4133:          for (int l=0; l<3; l++) {
 4134: 
 4135:             Node *node = elem->nodes[l];
 4136: 
 4137:             double fac = (node == node1) ? 2.0 : 1.0;
 4138:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 4139:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 4140:            
 4141:          }
 4142: 
 4143: 
 4144:          if (!elem->isDry) {
 4145:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 4146: 
 4147:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 4148: 
 4149:          }
 4150: 
 4151:       } // isTri
 4152:       else { // isQuad
 4153:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 4154:          // for (int l=0; l<4; l++) {
 4155:          //   const Node *node = elem->nodes[l];
 4156: 
 4157:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 4158:          //   else        tmp2 = node->bdef2 - node->bdef1;
 4159: 
 4160:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 4161:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 4162:          // }
 4163: 
 4164:       } // isQuad
 4165: 
 4166: 
 4167:      node1->qel += (dt/elem->i34)*elem->vsource;
 4168:       
 4169: 
 4170:    } // for all elements connected to the node
 4171:    
 4172: 
 4173:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 4174:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 4175:    NodeBoundary *nodeBnd = node1->nodeBnd;
 4176:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 4177:       // If it is an open boundary node...
 4178: 
 4179:       // At least one open bnd side, maybe two
 4180:       for (int l=0; l<2; l++) { 
 4181: 
 4182:          // Gets each of the sides sharing the node. 
 4183:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 4184: 
 4185:        
 4186: 
 4187:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 4188:          if (sideBnd != nullptr) {
 4189:             // If the side is on a boundary...
 4190: 
 4191:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 4192: 
 4193:             // Get the boundary segment
 4194:             const BoundarySegment *sideSegment = sideBnd->segment;
 4195:             const Side *side = sideBnd->side;
 4196: 
 4197:             // Integral I_3
 4198:             if (sideSegment->ifltype != 0) {
 4199:             // Natural or Flather b.c.
 4200: 
 4201:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4202:                // especially for Flather b.c.
 4203:                double ri3 = 0.0;
 4204:                if (!side->isDry) {
 4205:                   // If the side is not dry
 4206:                   
 4207:                   // Computes the side flux of (uth, vth)
 4208:                   double Vn = 0.0;
 4209:                   for (int k = side->kb; k < nvrt - 1; k++) {
 4210:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4211:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4212: 
 4213:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 4214:                   }
 4215: 
 4216:                   ri3 = 0.5*side->len*Vn;
 4217:                }
 4218: 
 4219:                if (sideSegment->ifltype == -1) { // Flather 1
 4220: 
 4221:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4222:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4223: 
 4224:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4225:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4226:                   
 4227:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4228:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4229: 
 4230:                } 
 4231:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4232:                   // Reset ri3
 4233:                   ri3 = 0.0;
 4234: 
 4235:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4236: 
 4237:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4238: 
 4239:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4240:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4241: 
 4242:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4243:                   node1->addToSparseMatrix(node1, con0*2.0);
 4244:                   node1->addToSparseMatrix(node2, con0);
 4245: 
 4246:                } // if Flather or Discharge
 4247: 
 4248:                node1->qel -= thetai*dt*ri3;
 4249: 
 4250: 
 4251:             } // I_3
 4252:           
 4253: 
 4254:             // Integral I_5
 4255:             if(!side->isDry) {
 4256: 
 4257:                const double Unbar = dot(side->U, side->n);
 4258:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 4259: 
 4260:             } // I_5
 4261: 
 4262:          } // if is boundary side
 4263: 
 4264:       } // for l
 4265: 
 4266:    } // if isbnd
 4267: 
 4268: 
 4269: }
 4270: 
 4271: 
 4272: 
 4273: extern "C" {
 4274:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 4275:                                   int* indices, int* indptr) {
 4276: 
 4277:       NODE(node);
 4278:       
 4279:       const int idx = node->idx;
 4280:       
 4281:       // Computes the index in the nzz array      
 4282:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 4283: 
 4284: 
 4285:       indptr[idx] = nzzIdx;
 4286:       indices[nzzIdx] = idx;
 4287: 
 4288:       data_d[nzzIdx]    = node->coeffDiag;
 4289: 
 4290:       b_d[idx] = node->qel;
 4291: 
 4292:       for (int k = 0; k < node->numNodes; ++k) {
 4293:          const Node* nb = node->nodes[k];
 4294: 
 4295:          const int j = nb->idx;
 4296: 
 4297:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 4298: 
 4299:          indices[nzzIdx + k + 1] = j;
 4300:       }
 4301: 
 4302:  
 4303:    }
 4304: 
 4305: 
 4306: 
 4307:    __global__ void solverCopyResult(double* x) {
 4308:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 4309:       NODE(node);
 4310:       const int idx = node->idx;
 4311: 
 4312:       node->mX = x[idx];
 4313:    }
 4314: 
 4315: 
 4316:    __global__ void rollUpElevation(void) {
 4317: 
 4318:       NODE(node);
 4319: 
 4320:       node->eta1 = node->eta2;
 4321: 
 4322:    }
 4323: 
 4324: 
 4325:    __global__ void backtrackAllNodes(void) {
 4326: 
 4327:       // max/min # of sub-divisions
 4328:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4329:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4330: 
 4331: 
 4332:       SIDE(side);
 4333: 
 4334:       const int kb = side->kb;
 4335: 
 4336: 
 4337:       // Initialize btrack velocities to the actual velocities at the side 
 4338:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4339: 
 4340:   
 4341: 
 4342:       if (side->isDry) return;
 4343:      
 4344: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4345: 
 4346:       // Checks that at least one element is not dry
 4347:       const Element *elem1 = side->elems[0];
 4348:       const Element *elem2 = side->elems[1];
 4349: 
 4350: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4351: 
 4352:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4353:       
 4354:       // XXXXXX
 4355:       // !swild_tmp to store global coord. of the starting side
 4356:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4357:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4358:       // !Use sframe2 
 4359:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4360: 
 4361: 
 4362:       for (int k = kb; k < nvrt; k++) {
 4363:       //  Initialize (xt,yt,zt), nnel and vel.
 4364:       //  For ics=2, the coordinates are all in the side's local frame
 4365:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 4366: 
 4367:          const int iadvf = side->iadv();  // Advection flag   
 4368:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4369: 
 4370:          // If on land or open boundary...
 4371:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 4372:          
 4373:          const double vmag = length(side->u2[k]);
 4374: 
 4375:          if (vmag <= velmin_btrack) {
 4376:             // No activity 
 4377: 
 4378:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4379: // addDebugPlot(side->center, side->center, 0x00000F, '+');     
 4380: 
 4381:             
 4382:          } else {  // do btrack
 4383: 
 4384:             // Compute number of sub-divisions based on local gradients of the velocity field
 4385: 
 4386:             // XXX IS THIS NECESSARY?
 4387:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4388:             double suma = 0.0;
 4389:             int icount = 0;
 4390:             for (int l=0; l<2; l++) {
 4391:             // For each element sharing the side...
 4392: 
 4393:                const Element *elem = side->elems[l];
 4394:                  
 4395:                if (elem == nullptr) continue;
 4396: 
 4397:                icount++;
 4398: 
 4399:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 4400:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 4401:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 4402: 
 4403:                double utmp[4];
 4404:                double vtmp[4];
 4405:                for (int j = 0; j < elem->i34; j++) {
 4406: 
 4407:                   const Node *node = elem->nodes[j];
 4408: 
 4409:                   if constexpr(ics==1) {
 4410:                      utmp[j] = node->u2[k].x;
 4411:                      vtmp[j] = node->u2[k].y;  
 4412: 
 4413:                   } else {
 4414:                      // 'Project' the velocity from the node frame to the element frame
 4415:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 4416:                      utmp[j] = tmp_u2.x;
 4417:                      vtmp[j] = tmp_u2.y;
 4418: 
 4419:                   }
 4420:                } // for j
 4421: 
 4422:                const Vector2 grad_u = elem->grad2(utmp); 
 4423:                const Vector2 grad_v = elem->grad2(vtmp);
 4424:    
 4425:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4426:             } // for ii
 4427: 
 4428:             assert(icount > 0 && "Impossible 77");
 4429: 
 4430:             // '4' is somewhat arbitrary
 4431:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4432:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4433:             Vector3 u_int = {0.0, 0.0, 0.0};
 4434: 
 4435:             bool res =side->btrack(k, dt, dtbk, u_int);
 4436: 
 4437:             side->btu[k] = toVector2(u_int);
 4438:                
 4439:          } // if vmag (do backtrack)
 4440: 
 4441: 
 4442:       } // for k=kb,nvrt-1
 4443: 
 4444:    }
 4445: 
 4446: } // extern "C"
 4447: 
 4448: template<int nc>
 4449: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4450: 
 4451: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4452: //
 4453: // a,b,c,rhs: input vectors and are not modified by this program.
 4454: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4455: // rhs is the r.h.s.
 4456: // n: actual rank of the system.
 4457: // rows in u() and rhs();
 4458: // u: output with nc columns (transposed to rows)
 4459: // gam: a working array.
 4460: //
 4461: // NOTES:
 4462: // This is a template function that allows for different numbers of columns in the rhs vector.
 4463: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4464: 
 4465:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4466:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4467: 
 4468:    double bet = b[0];
 4469:    if constexpr (nc == 1) {
 4470:       u[0] = rhs[0]/bet;
 4471:    } else {
 4472:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4473:    }
 4474: 
 4475:    for (int j = 1; j < n; j++) {
 4476:       gam[j] = c[j - 1]/bet;
 4477:       bet = b[j] - a[j]*gam[j];
 4478: 
 4479:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4480: 
 4481:       if constexpr (nc == 1) {
 4482:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4483:       } else {
 4484:          for (int l = 0; l < nc; l++) {
 4485:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4486:          }
 4487:       }
 4488:    }
 4489: 
 4490:    // Back-substitution
 4491:    for (int j = n - 2; j >= 0; j--) {
 4492:       if constexpr (nc == 1) {
 4493:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4494:       } else {
 4495:          for (int l = 0; l < nc; l++) {
 4496:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4497:          }
 4498:       }
 4499:    }
 4500: }
 4501: 
 4502: 
 4503: 
 4504: // Helper function that contains the core algorithm
 4505: template<typename XAccessor, typename YAccessor>
 4506: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4507:                                     double  yp_top, double  yp_bot, 
 4508:                                     CubicSpline &spline) {
 4509:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4510:    // 
 4511:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4512:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4513:    //
 4514:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4515:    // 
 4516:    // Inputs: 
 4517:    //            n: dimension for x etc; # of data pts (>=2);
 4518:    //            getX, getY: functions to access x,y coordinates
 4519:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4520:    //     Output: 
 4521:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4522: 
 4523:    const int n = k2 - k1 + 1;
 4524:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4525: 
 4526:    // Allocate memory for the splines
 4527:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4528:    spline.x   = new double[n];
 4529:    spline.y   = new double[n];
 4530:    spline.yp  = new double[n];
 4531:    spline.ypp = new double[n];
 4532: 
 4533:    for (int k=k1; k<=k2; k++) {
 4534:       spline.x[k] = getX(k);
 4535:       spline.y[k] = getY(k);
 4536:    }
 4537: 
 4538:    // This is to simplify expressions later
 4539:    double *x = spline.x;
 4540:    double *y = spline.y;
 4541: 
 4542:    double *a = nullptr;
 4543:    double *b = nullptr;
 4544:    double *c = nullptr;
 4545:    double *gam = nullptr;
 4546:    double *rhs = nullptr;
 4547:    
 4548: 
 4549:       a = new double[n];   // Lower diagonal
 4550:       b = new double[n];   // Diagonal
 4551:       c = new double[n];   // Upper diagonal
 4552:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4553:       rhs = new double[n]; // Right-hand side
 4554: 
 4555:    for (int k=k1; k<=k2; k++) {
 4556:       if (k == k1) {
 4557:          // Bottom level
 4558:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4559:          b[k] = (x[k+1] - x[k])/3.0;
 4560:          c[k] = b[k]/2.0;
 4561:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4562:       } else if (k == n - 1) {
 4563:          // Top level (surface)
 4564:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4565:          b[k] = (x[k] - x[k-1])/3.0;
 4566:          a[k] = b[k]/2.0;
 4567:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4568:       } else {
 4569:          // Intermediate levels
 4570:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4571:          b[k] = (x[k+1] - x[k-1])/3.0;
 4572:          a[k] = (x[k  ] - x[k-1])/6.0;
 4573:          c[k] = (x[k+1] - x[k  ])/6.0;
 4574:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4575:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4576:       }
 4577:    }
 4578: 
 4579:    // Solve the tridiagonal system
 4580:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4581:    
 4582:    spline.yp[k1] = yp_bot;
 4583:    spline.yp[k2] = yp_top;
 4584: 
 4585:    // Compute rest of 1st derivatives using the splines
 4586:    for (int k=k1+1; k<k2; k++) {
 4587:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4588:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4589:    }
 4590:    
 4591:    delete[] a;
 4592:    delete[] b;
 4593:    delete[] c;
 4594:    delete[] gam;
 4595:    delete[] rhs;
 4596: 
 4597: }
 4598: 
 4599: // Array version
 4600: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4601:                                 double y_top, double y_bot, 
 4602:                                 CubicSpline &spline) {
 4603:    auto getX = [x] (int k) { return x[k]; };
 4604:    auto getY = [y] (int k) { return y[k]; };
 4605:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4606: }
 4607: 
 4608: // Lambda version - allows custom access patterns
 4609: template<typename XFunc, typename YFunc>
 4610: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4611:                                 double y_top, double y_bot,
 4612:                                 CubicSpline &spline) {
 4613:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4614: }
