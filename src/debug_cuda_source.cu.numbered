 7691: __global__ void getStructSizes(int* sizes)  {
 7692:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 7693:       sizes[0] = (int)sizeof(Node);
 7694:       sizes[1] = (int)sizeof(Element);
 7695:       sizes[2] = (int)sizeof(Side);
 7696:       sizes[3] = (int)sizeof(NodeBoundary);
 7697:       sizes[4] = (int)sizeof(SideBoundary);
 7698:       sizes[5] = (int)sizeof(BoundarySegment);
 7699: }
