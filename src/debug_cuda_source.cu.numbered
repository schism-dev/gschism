 2111: 
 2112:    template<typename T>
 2113:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 2114:       // Get the values of the field at the nodes of the element
 2115:       res[0] = nodes[0]->*field;
 2116:       res[1] = nodes[1]->*field;
 2117:       res[2] = nodes[2]->*field;
 2118:       if (isQuad()) res[3] = nodes[3]->*field;
 2119:       else          res[3] = T();
 2120:    }
 2121: 
 2122:    template<typename T>
 2123:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 2124: 
 2125:       assert(level < nvrt && "Level is out of range");
 2126:       // Get the values of the field at the nodes of the element
 2127:       res[0] = (nodes[0]->*field)[max(level, nodes[0]->kb)];
 2128:       res[1] = (nodes[1]->*field)[max(level, nodes[1]->kb)];
 2129:       res[2] = (nodes[2]->*field)[max(level, nodes[2]->kb)];
 2130:       if (isQuad()) res[3] = (nodes[3]->*field)[max(level, nodes[3]->kb)];
 2131:       else          res[3] = T();
 2132:    }    
 2133: 
 2134:    template<typename T>
 2135:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
 2136: 
 2137:       assert(level < nvrt && "Level is out of range");
 2138: 
 2139:       // Get the values of the func at the nodes of the element
 2140:       res[0] = (nodes[0]->*func)(max(level, nodes[0]->kb));
 2141:       res[1] = (nodes[1]->*func)(max(level, nodes[1]->kb));
 2142:       res[2] = (nodes[2]->*func)(max(level, nodes[2]->kb));
 2143:       if (isQuad()) res[3] = (nodes[3]->*func)(max(level, nodes[3]->kb));
 2144:       else          res[3] = T();  // This is 0.0 or a zero vector
 2145: 
 2146:    }      
