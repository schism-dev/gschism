 4744: extern "C" {
 4745: 
 4746:    __global__ void scaleGravity(double loadtide_coef) {
 4747: 
 4748: 
 4749:       NODE(node);
 4750: 
 4751:       // SAL option: scale gravity
 4752:       if constexpr(iloadtide==2) {  // simple const
 4753:          node->grav2 = grav*(1.0 - loadtide_coef);
 4754: 
 4755:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4756:         
 4757:           const double depth = max(node->depth, 0.0);
 4758:           const double tmp1 = sqrt(depth);
 4759:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4760:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4761:                              2.6969e-13*depth*depth*depth*tmp1;
 4762:           
 4763:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4764:           
 4765: 
 4766: 
 4767:           node->grav2 = grav*(1.0 - beta_bar);
 4768: 
 4769:       } else {  // iloadtide=0,1
 4770:           node->grav2 = grav;
 4771: 
 4772:       }
 4773: 
 4774:    }
 4775: 
 4776: 
 4777:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4778: 
 4779:       NODE_BND(nodeBnd);
 4780: 
 4781:       Node *node = nodeBnd->node;
 4782: 
 4783:       node->ETP = 0.0;
 4784: 
 4785:       for (int j=0; j<ntip; j++) {
 4786: 
 4787:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4788:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4789:    
 4790:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4791: 
 4792:          if constexpr(iloadtide==1) { // loading tide
 4793:             assert(false && "Loading tide not implemented");
 4794:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4795:          }
 4796:          
 4797:       }
 4798:       
 4799:    }
