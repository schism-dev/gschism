  974: 
  975: struct Element {
  976: 
  977:    // Geometry information
  978:    int idx;                   // Index of the element
  979:    int16_t i34;               // Number of sides for the element 
  980:    Side *sides[4];            // Sides of the element
  981:    Node *nodes[4];            // Nodes of the element
  982:    Element *nghbElems[4];     // Neighbors of the element
  983: 
  984:    int16_t kb;                // Bottom index of the element
  985:    double area;               // Area of the element
  986:    double ssign[4];           // Sign associated with each side of an element
  987:    double radius;             // Element equivalent radii
  988: 
  989:    Frame<ics> frame;
  990: 
  991:    Vector2 gradPhi[4];        // Derivatives of shape functions
  992:    Vector2 gradEta;           // Gradient of free surface elevation
  993:    Vector2 gradPr;            // Gradient of pressure    
  994:    Vector2 gradETP;           // Gradient of Earth Tidal Potential    XXXXX Really used?
  995: 
  996:    bool isDry;                // True if the element is dry
  997: 
  998:    Point2 center;            // Element center coordinates (global coordinates)
  999: 
 1000:    double depth;              // Depth at element (min of all nodes)
 1001:    double z[nvrt];            // z-coord  (local frame - vertical up)
 1002: 
 1003:    // Physical information
 1004:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
 1005: 
 1006:    static const bool isblock = false;              // Always false
 1007: 
 1008:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
 1009:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
 1010: 
 1011:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
 1012:    
 1013: 
 1014:    double vsource;            // Volumetric source/sink term [m^3/s]
 1015: 
 1016:    double rho[nvrt];          // Density at each prism center
 1017:    double rho_mean[nvrt];     // Mean density at each prism center
 1018:    CubicSpline rho_spl;
 1019:    double rho_zz[nvrt];       // Second derivative of density at each prism center
 1020:    double rho_z[nvrt];        // First derivative of density at each prism center
 1021:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
 1022:    
 1023: 
 1024:    __inline__ __device__ Point2 outputCoords(void) const;
 1025: 
 1026:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }  
 1027: 
 1028:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1029:    // If ics == 2, convert the global point to the local frame of the element
 1030:       
 1031:       if constexpr (ics == 1) {
 1032:          return p;
 1033:       } else {
 1034:          const Point3 c = {center.x, center.y, centerZ()};
 1035:          return frame.G2L(p - c);
 1036:       }
 1037:    }
 1038: 
 1039:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1040:    // If ics == 2, convert the local point to a global point
 1041:       
 1042:       if constexpr (ics == 1) {
 1043:          return p;
 1044:       } else {
 1045:          const Point3 c = {center.x, center.y, centerZ()};
 1046:          return c + frame.L2G(p);
 1047:       }
 1048:    }
 1049: 
 1050:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
 1051:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
 1052: 
 1053:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
 1054:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
 1055: 
 1056:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
 1057:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
 1058:       // Find the local index of the node in the element (0,1,2,3)
 1059:       int res = __ffs((nodes[0] == node) | 
 1060:                      ((nodes[1] == node) << 1) | 
 1061:                      ((nodes[2] == node) << 2) | 
 1062:                      ((nodes[3] == node) << 3)) - 1;
 1063:       
 1064:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
 1065:       return res;  
 1066:    }
 1067: 
 1068:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
 1069:       // Find the local index of the side in the element (0,1,2,3)
 1070:       int res = __ffs((sides[0] == side) | 
 1071:                      ((sides[1] == side) << 1) | 
 1072:                      ((sides[2] == side) << 2) | 
 1073:                      ((sides[3] == side) << 3)) - 1;
 1074:       
 1075:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
 1076:       return res;
 1077:    }
 1078: 
 1079:    __inline__ __device__ int findLevel(double z1, int k) const {
 1080:       // Starting at index k, find sequentially the level that contains z
 1081: 
 1082:       // For testing purposes, forgets k and performs a full search.
 1083:       for (k = kb; k < nvrt - 1; k++) {
 1084:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
 1085:       }
 1086:       return nvrt - 2;
 1087: 
 1088: 
 1089:       // if z is already betweeen z[k] and z[k+1], return k
 1090:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
 1091:       else if (z1 <  z[k]) { 
 1092:          // Search for increasing levels
 1093:          for (int kk = k; kk < nvrt - 1; kk++) {
 1094:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
 1095:          }
 1096:          return nvrt - 1;
 1097:       }
 1098:       else {
 1099:          // Search for decreasing levels
 1100:          for (int kk = k; kk >= kb; kk--) {
 1101:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
 1102:          }
 1103:          return 0;
 1104:       }
 1105:    }
 1106: 
 1107:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
 1108:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
 1109: 
