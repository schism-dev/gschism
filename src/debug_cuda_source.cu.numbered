 1908: 
 1909: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1910:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1911: 
 1912:    printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 1913: 
 1914:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1915:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1916:    // curElement.
 1917: 
 1918:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1919:    // And uses this velocity instead to continue the tracking.
 1920: 
 1921:    // computes the intersection point in cartesian coordinates
 1922:    Point2 intersection = nextSide->p_t(tt);
 1923: 
 1924:    // Nudges the point to the barycenter of the element. 
 1925:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1926:    // next segment intersects the element sides.  
 1927:    curElem->nudgeToBarycenter(intersection);
 1928: 
 1929:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1930:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1931:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1932:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1933: 
 1934:    // If the side is an open boundary, the tangential velocity is zero.
 1935:    if (nextSide->isBnd()) vtan = 0.0;
 1936: 
 1937:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1938:    const double us = vtan*nextSide->t().x;
 1939:    const double vs = vtan*nextSide->t().y;
 1940:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1941: 
 1942:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1943:    const double len2 = norm2(intersection - toPoint2(xt));
 1944:    const double vel2 = dot(u_int, u_int);        
 1945:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 1946:    else            dt = 0.0;
 1947: 
 1948:    // The end of this tracking segment is now the intersection point.
 1949:    xt = {intersection.x, intersection.y, zint};
 1950: printf("BBB u_int = %f,%f,%f\n", us, vs, ws);   
 1951:    u_int = {us, vs, ws};
 1952:    
 1953: }
 1954: 
 1955: /**
 1956:  * Tracks a particle through elements and vertical levels in the mesh.
 1957:  * 
 1958:  * @param x0,y0,z0     Starting position coordinates
 1959:  * @param xt,yt,zt     Target position coordinates
 1960:  * @param dtb          Time step for tracking
 1961:  * @param uuint,vvint,wwint Initial velocity components
 1962:  * @param nextElem     Starting/resulting element index
 1963:  * 
 1964:  * @return Status code of type trackExitCodes
 1965:  * 
 1966:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1967:  * of the details are different. The idea is that the code requires less branches and is better fit
 1968:  * for GPU execution.
 1969:  * 
 1970:  * The main ideas here are:
 1971:  * - The starting point is expected to be in the starting element.
 1972:  * - The end point is guaranteed to be inside an element.
 1973:  * - since the starting point is inside the element, there are only two cases: 
 1974:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1975:  *     (b) it does not and (xt,yt) is already in the starting element.
 1976:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1977:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1978:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1979:  * - tt1 can be positive or negative. We only consider the positive values.
 1980:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1981:  * - The next intersection will occur at the smallest positive tt1.
 1982:  * - This intersection will be the next (x0,y0) position.
 1983:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1984:  *   of getting stuck in a loop.
 1985:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1986:  *   was found.
 1987:  */
 1988: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1989:                                                        Element *&nextElem, int &jlev, double &dt,
 1990:                                                        const Side *origSide) {
 1991: 
 1992: 
 1993:    if (origSide->idx == 7) {
 1994:       printf("AAAA&&&& origSide->idx = %d, u_int = %f,%f,%f, x0 = %f,%f,%f, xt = %f,%f,%f\n", origSide->idx, u_int.x, u_int.y, u_int.z, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z);
 1995:    }
 1996:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 1997:    // else to do.
 1998:    // If it is, nudges the point to be inside the element.
 1999:    const Element *curElem = nextElem;
 2000:    if (containsPoint(toPoint2(xt), true)) {
 2001: 
 2002:       curElem->interpolateVelocities(xt, u_int);
 2003: addDebugPlot(x0, xt);
 2004:       return true;
 2005:    }
 2006: 
 2007:    Side *side = nullptr;
 2008: 
 2009:    // 1. Initial checks
 2010:    // Verify starting element is valid (wet)
 2011:    assert(!curElem->isDry && "Starting element is dry");
 2012: 
 2013:    // Checks if track has a zero length.
 2014:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 2015:    // assert(len2 > 0.0 && "Zero length track"); 
 2016:    
 2017:    const int MAX_ITERATIONS = 1000;
 2018:    
 2019:    double t;
 2020:    Side *nextSide = nullptr;
 2021:    double tIntersect = 1e10;
 2022:    double zint = x0.z;
 2023: 
 2024:    // Horizontal tracking loop
 2025:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2026:    // (x0,y0) is inside the element but the target point is not.
 2027: 
 2028:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2029: 
 2030:    assert(found_intersection && "No intersection found at %d");
 2031: 
 2032:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2033: 
 2034:    // if the tracking segment goes out of water (either dry or edge boundary)
 2035:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2036: 
 2037: addDebugPlot(x0, xt, 0x00A0FF);
 2038: printf("BBBXXXX going out of water\n");
 2039:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 2040: addDebugPlot(x0, xt, 0x00A0FF);      
 2041: 
 2042:       nextElem = this;
 2043:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2044:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2045:       return true;    
 2046:    }
 2047: 
 2048: 
 2049:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 2050:    int iterations = 0;
 2051:    while (iterations < MAX_ITERATIONS) {
 2052:       iterations++;
 2053: printf("BBBXXXX iterations = %d\n", iterations);      
 2054:       
 2055:       Element *curElem = nextElem;
 2056: 
 2057:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2058: addDebugPlot(x0, xt);
 2059:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2060: 
 2061:       // If we are already in the target element, we are done.
 2062:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 2063:       if (!found_intersection) break;
 2064: 
 2065: 
 2066: 
 2067:       // if the tracking segment goes out of water (either dry or edge boundary).
 2068:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2069: addDebugPlot(x0, xt, 0x00A0FF);
 2070: printf("BBBXXXX going out of water\n");
 2071:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 2072: addDebugPlot(x0, xt, 0x00A0FF);   
 2073:          nextElem = curElem;
 2074: 
 2075:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 2076:          // In this case, the caller (btrack) needs to take into account the remaining time.
 2077:          return true;
 2078:       }
 2079:       
 2080:       // Update position and element for next iteration
 2081:       side = nextSide;
 2082: 
 2083:    }
 2084: 
 2085:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 2086: 
 2087:  
 2088:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2089:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2090: addDebugPlot(x0, xt);   
 2091: printf("MMMMMM nextElem->idx = %d, u_int = %f,%f,%f\n", nextElem->idx, u_int.x, u_int.y, u_int.z);
 2092:    nextElem->interpolateVelocities(xt, u_int); 
 2093: printf("MMMMMM2 nextElem->idx = %d, u_int = %f,%f,%f\n", nextElem->idx, u_int.x, u_int.y, u_int.z);
 2094: 
 2095:    return true;
 2096: }
 2097: 
 2098: 
 2099: __inline__ __device__ double Element::computeSignedArea(void) const {
 2100:    // Compute the area of the element
 2101: 
 2102:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 2103: 
 2104:    // In the quad case we need to add the area of the other triangle.
 2105:    if (isQuad()) {
 2106:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2107:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 2108:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2109:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 2110:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 2111:          Error("Negative area found in quad element");
 2112:       }
 2113:       res += ar1;
 2114:    }
 2115: 
 2116:    return res;
 2117: }
 2118: 
 2119: 
 2120: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2121:                                                                 (nodes[1]->isDry2()) ||
 2122:                                                                 (nodes[2]->isDry2()) ||
 2123:                                                                 (i34==4 && nodes[3]->isDry2());
 2124: }
