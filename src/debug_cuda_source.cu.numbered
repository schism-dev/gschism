 1051: struct Element {
 1052: 
 1053:    // Geometry information
 1054:    int idx;                   // Index of the element
 1055:    int16_t i34;               // Number of sides for the element 
 1056:    Side *sides[4];            // Sides of the element
 1057:    Node *nodes[4];            // Nodes of the element
 1058:    Element *nghbElems[4];     // Neighbors of the element
 1059: 
 1060:    int16_t kb;                // Bottom index of the element
 1061:    double area;               // Area of the element
 1062:    double ssign[4];           // Sign associated with each side of an element
 1063:    double radius;             // Element equivalent radii
 1064: 
 1065:    Frame<ics> frame;
 1066: 
 1067:    Vector2 gradPhi[4];        // Derivatives of shape functions
 1068:    Vector2 gradEta;           // Gradient of free surface elevation
 1069:    Vector2 gradPr;            // Gradient of pressure    
 1070:    Vector2 gradETP;           // Gradient of Earth Tidal Potential    XXXXX Really used?
 1071: 
 1072:    bool isDry;                // True if the element is dry
 1073: 
 1074:    Point2 center;            // Element center coordinates (global coordinates)
 1075: 
 1076:    double depth;              // Depth at element (min of all nodes)
 1077:    double z[nvrt];            // z-coord  (local frame - vertical up)
 1078: 
 1079:    // Physical information
 1080:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
 1081:    TransportElem<transportModel> transport; // Transport model 
 1082: 
 1083:    static const bool isblock = false;              // Always false
 1084: 
 1085:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
 1086:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
 1087: 
 1088:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
 1089:    
 1090: 
 1091:    double vsource;            // Volumetric source/sink term [m^3/s]
 1092: 
 1093:    double rho[nvrt];          // Density at each prism center
 1094:    double rho_mean[nvrt];     // Mean density at each prism center
 1095:    CubicSpline rho_spl;
 1096:    double rho_zz[nvrt];       // Second derivative of density at each prism center
 1097:    double rho_z[nvrt];        // First derivative of density at each prism center
 1098:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
 1099:    
 1100: 
 1101:    __inline__ __device__ Point2 outputCoords(void) const;
 1102: 
 1103:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }  
 1104: 
 1105:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1106:    // If ics == 2, convert the global point to the local frame of the element
 1107:       
 1108:       if constexpr (ics == 1) {
 1109:          return p;
 1110:       } else {
 1111:          const Point3 c = {center.x, center.y, centerZ()};
 1112:          return frame.G2L(p - c);
 1113:       }
 1114:    }
 1115: 
 1116:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1117:    // If ics == 2, convert the local point to a global point
 1118:       
 1119:       if constexpr (ics == 1) {
 1120:          return p;
 1121:       } else {
 1122:          const Point3 c = {center.x, center.y, centerZ()};
 1123:          return c + frame.L2G(p);
 1124:       }
 1125:    }
 1126: 
 1127:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
 1128:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
 1129: 
 1130:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
 1131:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
 1132: 
 1133:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
 1134:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
 1135:       // Find the local index of the node in the element (0,1,2,3)
 1136:       int res = __ffs((nodes[0] == node) | 
 1137:                      ((nodes[1] == node) << 1) | 
 1138:                      ((nodes[2] == node) << 2) | 
 1139:                      ((nodes[3] == node) << 3)) - 1;
 1140:       
 1141:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
 1142:       return res;  
 1143:    }
 1144: 
 1145:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
 1146:       // Find the local index of the side in the element (0,1,2,3)
 1147:       int res = __ffs((sides[0] == side) | 
 1148:                      ((sides[1] == side) << 1) | 
 1149:                      ((sides[2] == side) << 2) | 
 1150:                      ((sides[3] == side) << 3)) - 1;
 1151:       
 1152:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
 1153:       return res;
 1154:    }
 1155: 
 1156:    __inline__ __device__ int findLevel(double z1, int k) const {
 1157:       // Starting at index k, find sequentially the level that contains z
 1158: 
 1159:       // For testing purposes, forgets k and performs a full search.
 1160:       for (k = kb; k < nvrt - 1; k++) {
 1161:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
 1162:       }
 1163:       return nvrt - 2;
 1164: 
 1165: 
 1166:       // if z is already betweeen z[k] and z[k+1], return k
 1167:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
 1168:       else if (z1 <  z[k]) { 
 1169:          // Search for increasing levels
 1170:          for (int kk = k; kk < nvrt - 1; kk++) {
 1171:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
 1172:          }
 1173:          return nvrt - 1;
 1174:       }
 1175:       else {
 1176:          // Search for decreasing levels
 1177:          for (int kk = k; kk >= kb; kk--) {
 1178:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
 1179:          }
 1180:          return 0;
 1181:       }
 1182:    }
 1183: 
 1184:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
 1185:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
 1186:    __inline__ __device__ double volume(int k)  const { assert(k < nvrt - 1); return area * Dz(k); }
 1187: 
 1188: 
 1189:    __device__ __forceinline__ double centerZ(void) const;
 1190: 
 1191:    // "Local" horizontal coordinates at the nodes. They are computed from the 3D global node coordinates. For ics == 1 and 2
 1192:    // Local is in quotes because for ics == 1, the coordinates are unchanged. It just means that in these coordinates, the element is horizontal.
 1193:    __device__ __forceinline__ Point2 getLocalHorizontalNodePosition(int idxNode) const;
 1194:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2, 
 1195:                                                                        const Vector3& c, const Frame<ics>& dstFrame,int idx = 0) const;
 1196:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2, int idx = 0) const;
 1197:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3,
 1198:                                                                        const Vector3& c, const Frame<ics>& dstFrame) const;
 1199:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const;
 1200: 
 1201: 
 1202:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idxNode = 0,1,2,3)
 1203:    __device__ __forceinline__ Point2 GaussPoint(int idxNode) const {
 1204:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
 1205:        assert(idxNode >= 0 && idxNode < 4 && "GaussPoint: idxNode out of range");
 1206:        const double eta = (idxNode & 1) ? +g : -g;
 1207:        const double xi  = (idxNode & 2) ? +g : -g;
 1208:        return {eta, xi};
 1209:    }  
 1210: 
 1211: 
 1212: 
 1213:    // Shape function Phi at a given point p = (eta,xi), idxNode = node index 0,1,2,3
 1214:    __device__ __forceinline__ double Phi_quad(int idxNode, Point2 p) const {
 1215:       return 0.25*(1.0 + p.x*eta_n(idxNode))*(1.0 + p.y*xi_n(idxNode));
 1216:    }
 1217: 
 1218:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi)
 1219:    __device__ __forceinline__ double dPhi_dxi_quad(int idxNode, Point2 p) const {
 1220:       return 0.25*xi_n(idxNode)*(1.0 + p.x*eta_n(idxNode));
 1221:    }   
 1222: 
 1223:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
 1224:    __device__ __forceinline__ double dPhi_deta_quad(int idxNode, Point2 p) const {
 1225:       return 0.25*(1.0 + p.y*xi_n(idxNode))*eta_n(idxNode);
 1226:    }      
 1227:    
 1228:    __inline__ __device__ double detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
 1229: 
 1230:    __inline__ __device__ double detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
 1231: 
 1232:    __inline__ __device__ double detJ_quad(Point2 p, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const 
 1233:          { return (1.0/4.0)*area + detJ_eta_quad(x0, x1, x2, x3)*p.x+ detJ_xi_quad(x0, x1, x2, x3)*p.y; }
 1234: 
