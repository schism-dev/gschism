 1805:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1806:       // Compute the different time ramps used in the code 
 1807:       // This function is performed by just one thread
 1808: 
 1809:       rampbc = 1.0;
 1810:       if constexpr(ibc == 0) {
 1811:          if (drampbc > 0.0) {
 1812:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1813:          } else {
 1814:             rampbc = 1.0;
 1815:          }
 1816:       }
 1817: 
 1818:       if (nws != 0) {
 1819:          if (drampwind > 0.0) {
 1820:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1821:          } else {
 1822:             rampwind = 1.0;
 1823:          }
 1824:       }
 1825: 
 1826:       if (drampwafo > 0.0) {
 1827:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1828:       } else {
 1829:          rampwafo = 1.0;
 1830:       }
 1831: 
 1832:       // For source/sinks
 1833:       if (if_source && dramp_ss > 0.0) {
 1834:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1835:       } else {
 1836:          ramp_ss = 1.0;
 1837:       }
 1838: 
 1839:       if (dramp > 0.0) {
 1840:          ramp = tanh(2.0*time/86400.0/dramp);
 1841:       } else {
 1842:          ramp = 1.0;
 1843:       }
 1844: 
 1845: 
 1846:    }
