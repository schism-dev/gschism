 3699: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3700:    // Computes the z coordinate at level k.
 3701:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3702:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3703:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3704:    // used 
 3705: 
 3706:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3707:    
 3708:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3709: 
 3710:    if (isDry2()) return 0.0;  
 3711: 
 3712:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3713: 
 3714:    if constexpr(ivcor == 2) {
 3715: 
 3716:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3717:       const double h_c = mesh->h_c;
 3718:       const double theta_f = mesh->theta_f;
 3719:       const double sinh_theta_f = mesh->sinh_theta_f;
 3720: 
 3721: 
 3722:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3723:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3724:       // once per time step/node. XXXX
 3725:       // CHECK: updateZCoordData
 3726: 
 3727:       //  To simplify comparisons, I define index versions of count variables.
 3728:       if      (k == ivrt)     return eta2; 
 3729:       else if (k == izlev)    return -hmod2;
 3730:       else if (k == kb)       return -depth;
 3731:       else if (k < izlev)     return mesh->ztot[k];
 3732:       else if (k > izlev) {
 3733:          const int ksig = k - izlev;
 3734: 
 3735:          if (hmod2 <= h_c) {
 3736:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3737: 
 3738:          } 
 3739:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3740:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3741:             assert(false && "compZCoord: invalid h_c\n");
 3742:          } 
 3743:          else {
 3744:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3745:                    h_c * mesh->sigma[ksig] + 
 3746:                    (hmod2 - h_c) * mesh->cs[ksig];
 3747:          }
 3748:       } else { 
 3749:          assert(false && "compZCoord: invalid level or coordinate system\n");
 3750:       }
 3751: 
 3752:    }
 3753:    else {  // if constexpr(ivcor == 1)
 3754:       if (k <= kb)        return -depth; 
 3755:       else if (k == ivrt) return eta2;
 3756:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3757: 
 3758:    }
 3759:    
 3760:    assert(false && "compZCoord: invalid level or coordinate system\n");
 3761:    return 0.0;
 3762: }
 3763: 
 3764: 
 3765: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3766:    // Computes the bottom drag Cd based on the selected nchi
 3767: 
 3768:    if constexpr(nchi == 0) {
 3769:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3770:       Cd = drag;  // Read from drag file
 3771: 
 3772:    } else if constexpr(nchi == 1) {
 3773:       // 
 3774: 
 3775:       bool ltmp = false; // for WBL iteration
 3776: 
 3777:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3778:       if (isDry || (rough == 0.0)) {
 3779:          Cd = 0.0;
 3780: 
 3781:       } else { //roughness >0 
 3782:          
 3783:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3784: 
 3785:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3786: 
 3787:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3788: 
 3789:       } // if rough
 3790: 
 3791:    } else if constexpr(nchi == -1) {
 3792:    // Manning 
 3793:  
 3794:       const double htot = max(hmin_man, htot2()); 
 3795:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3796: 
 3797:    } else {
 3798:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3799:       
 3800:    } // if nchi
 3801: 
 3802: }
 3803: 
 3804: 
 3805: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3806:    // Checks if a side in on the boundary
 3807:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3808: 
 3809:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3810:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3811: 
 3812:    // Indices of the nodes that form the side
 3813:    //
 3814:    // NOTE: This function is slow. It's to be called from "populate" functions, not from the main loop.
 3815:    const int n1 = side.n1->idx;
 3816:    const int n2 = side.n2->idx;
 3817:    isLand = false;
 3818:    
 3819: 
 3820:    // Check if the side is on a land boundary
 3821:    for (int i = 0; i < nland; i++) {
 3822:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3823:          // Consecutive nodes in the land boundary segment
 3824:          const int b1 = ilnd[i + j*nland];
 3825:          const int b2 = ilnd[i + (j + 1)*nland];
 3826: 
 3827:          assert(b1 != -1 && b2 != -1);
 3828: 
 3829:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3830:             
 3831:             isLand = true;
 3832:             return i;
 3833:          }
 3834:       }
 3835:    }
 3836: 
 3837:    // Check if the side is on an open boundary
 3838:    for (int i = 0; i < nope; i++) {
 3839:       for (int j = 0; j < nond[i] - 1; j++) {
 3840:          // Consecutive nodes in the open boundary segment
 3841:          const int b1 = iond[i + j*nope];
 3842:          const int b2 = iond[i + (j + 1)*nope];
 3843: 
 3844:          assert(b1 != -1 && b2 != -1);
 3845: 
 3846:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3847:             isLand = false;
 3848:             return i;
 3849:          }
 3850:       }
 3851:    }
 3852: 
 3853:    return -1;
 3854: }
 3855: 
 3856: 
 3857: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3858:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3859:                                     double *wind_rotate_angle, 
 3860:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3861:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3862:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3863:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3864:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 3865: 
 3866:    NODE(pnode);  
 3867:    const int i = idx_node;
 3868:    Node &node(*pnode);
 3869: 
 3870:    node.idx = i;
 3871: 
 3872:    const int idxNodeStart = nodeNeighNodesStart[i];
 3873:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3874:    node.numNodes = idxNodeEnd - idxNodeStart;
 3875:    node.nodes = nodeNeighNodes + idxNodeStart;
 3876:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3877: 
 3878: 
 3879: 
 3880:    const int idxElemStart = nodeNeighElemsStart[i];
 3881:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3882:    node.numElements = idxElemEnd - idxElemStart;
 3883:    node.elements = nodeNeighElems + idxElemStart;
 3884: 
 3885: 
 3886:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3887:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3888:       const int partNode = localNodePart[idxNodeGlobal]; 
 3889:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3890: 
 3891:       Node *node_ptr = nodes[partNode] + idxNode;
 3892:       
 3893:       nodeNeighNodes[idx] = node_ptr;
 3894:    }
 3895: 
 3896: 
 3897:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3898:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3899:       const int partElem = localElemPart[idxElemGlobal];
 3900:       const int idxElem  = localElemIndices[idxElemGlobal];
 3901: 
 3902:       Element *elem_ptr = elems[partElem] + idxElem;
 3903: 
 3904:       nodeNeighElems[idx] = elem_ptr;
 3905:    }      
 3906: 
 3907:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 3908:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 3909: 
 3910:    sincosf(-(float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 3911: 
 3912:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 3913:    if constexpr(ics == 1) {
 3914:       node.p.x   = node_coords[i * 3];
 3915:       node.p.y   = node_coords[i * 3 + 1];
 3916:       node.gz = 0.0;
 3917: 
 3918:       if (use_ll) {                                    // <-- add
 3919:          node.lon = node_coords_ll[i * 2    ]*deg2rad; // <-- add
 3920:          node.lat = node_coords_ll[i * 2 + 1]*deg2rad; // <-- add
 3921:       }  
 3922: 
 3923:    } else {
 3924:       const double lon = deg2rad*node_coords[i * 3];
 3925:       const double lat = deg2rad*node_coords[i * 3 + 1];
 3926: 
 3927:       Point3 p = computeXYZfromLatLon(lat, lon);
 3928:       node.p = toVector2(p);
 3929:       node.gz = p.z;
 3930:       node.lon = lon;
 3931:       node.lat = lat;
 3932: 
 3933:       #ifdef USE_FRAMES
 3934:       node.setFrame(lat, lon);
 3935:       #endif
 3936: 
 3937: 
 3938:    }
 3939: 
 3940:    node.depth = node_coords[i * 3 + 2];
 3941: 
 3942:    node.numSides = 0;
 3943: 
 3944:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3945:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3946:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3947:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3948:    else assert(false && "populateNodes: selected nchi not implemented.");
 3949:    
 3950:    if constexpr(ivcor == 1) 
 3951:    {  
 3952:       node.kb = kb[i];
 3953: 
 3954:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + i*nvrt];
 3955:    }
 3956: 
 3957:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3958:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3959:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3960: 
 3961:    
 3962:    // Links the node to the boundary information
 3963:    if (isbnd[i] >= 0) {
 3964:      
 3965:       // Get the index of the node boundary
 3966:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3967: 
 3968:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3969:       node.nodeBnd->node = &node;
 3970: 
 3971:       node.nodeBnd->sideBnd1 = nullptr;
 3972:       node.nodeBnd->sideBnd2 = nullptr;
 3973: 
 3974:       if (isbnd[i]>=0) {
 3975: 
 3976:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3977:          
 3978:          node.nodeBnd->segment->ifltype = 0; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3979:          node.nodeBnd->segment->iettype = 0; // XXXXXXXXX
 3980: 
 3981:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3982:          node.nodeBnd->segment->clen  = nan("1");
 3983:          node.nodeBnd->segment->carea = nan("1");
 3984: 
 3985:       }
 3986:    } else {
 3987: 
 3988:       node.nodeBnd = nullptr; // For internal nodes
 3989: 
 3990:       if (isbnd[i] == landSegment) {
 3991:          node.nodeBnd = &landBoundaryNode;
 3992:          node.nodeBnd->segment = &landBoundarySegment;
 3993:       }
 3994:       
 3995:    }
 3996:    
 3997:    // XXXX GAUSSIAN HILL VELOCITIES
 3998:    #ifdef GAUSSIAN_HILL_VELOCITIES
 3999:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4000:          constexpr double rot_per = 3000.0;
 4001:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 4002:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 4003:       // XXXXX
 4004:    #endif
 4005: 
 4006: }
 4007: 
 4008: 
 4009: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 4010:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4011:                                     double *wind_rotate_angle,   
 4012:                                     int *isdel, int *isidenode, int *isbnd,
 4013:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4014:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4015:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4016:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4017:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4018:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 4019:                                     double *drag, double *roughness) {
 4020: 
 4021: 
 4022:    SIDE(pside);
 4023:    Side &side(*pside);
 4024:    const int i = idx_side;
 4025: 
 4026:    side.idx = i;  
 4027:    
 4028:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 4029:    const double fc   = 2.0*omega_e*sin(sfea0);
 4030:    const double beta = 2.0*omega_e*cos(sfea0);
 4031: 
 4032:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 4033: 
 4034:    // finding the pointer to the nodes that form the side
 4035:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 4036:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 4037: 
 4038:    const int locidx_n1 = localNodeIndices[idx_n1];
 4039:    const int locidx_n2 = localNodeIndices[idx_n2];
 4040:    const int part_n1 =   localNodePart[idx_n1];
 4041:    const int part_n2 =   localNodePart[idx_n2];
 4042: 
 4043:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 4044:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 4045: 
 4046: 
 4047:    // Counts the number of sides connected to each node
 4048:    side.n1->numSides++;
 4049:    side.n2->numSides++;
 4050: 
 4051:    // Side boundary type
 4052:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 4053:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 4054: 
 4055:    if (n1bnd != nullptr && n2bnd != nullptr) 
 4056:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 4057:    {
 4058:       bool isLand = false;
 4059:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 4060:       
 4061:       if (isbs > -1) {
 4062:          // assert(isLand || isbs>=0);
 4063:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 4064: 
 4065:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 4066: 
 4067:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 4068:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 4069: 
 4070:          assert (isLand == side.sideBnd->segment->isLand);
 4071: 
 4072:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4073:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 4074:          else                            n1bnd->sideBnd2 = side.sideBnd;
 4075: 
 4076:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 4077:          else                            n2bnd->sideBnd2 = side.sideBnd;
 4078:          
 4079:          side.sideBnd->side = &side;
 4080: 
 4081:       }
 4082:       else {
 4083:          side.sideBnd = nullptr;
 4084:       }
 4085:    }
 4086:    else 
 4087:    {
 4088:       side.sideBnd = nullptr;
 4089:    }
 4090: 
 4091: 
 4092:    // finding the pointer to the elements that share the side
 4093:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 4094:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 4095: 
 4096:    if (idx_e1 > -1) {
 4097:       const int locidx_e1 = localElemIndices[idx_e1];
 4098:       const int part_e1 =  localElemPart[idx_e1];
 4099:       side.elems[0] = elems[part_e1] + locidx_e1;
 4100: 
 4101:    }
 4102:    else {
 4103:       side.elems[0] = nullptr;
 4104:    }
 4105: 
 4106:    if (idx_e2 > -1) {
 4107:       const int locidx_e2 = localElemIndices[idx_e2];
 4108:       const int part_e2 =  localElemPart[idx_e2];
 4109:       side.elems[1] = elems[part_e2] + locidx_e2;
 4110:    }
 4111:    else {
 4112:       side.elems[1] = nullptr;
 4113:    }
 4114:    if (side.elems[1] == nullptr && side.sideBnd == nullptr) {
 4115:       
 4116:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 4117:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 4118:       printf("Side %d has no elements and no boundary. Types = %p, %p\n", i, n1bnd, n2bnd);
 4119:          
 4120:       // printf("idx_e1: %d, idx_e2: %d\n", idx_e1, idx_e2);
 4121:       // printf("elems[0]: %p, elems[1]: %p\n", side.elems[0], side.elems[1]);
 4122:       // printf("sideBnd: %p\n", side.sideBnd);
 4123:       // assert(false && "Side has no elements and no boundary");
 4124:    }
 4125:    // assert(side.elems[1] != nullptr || side.sideBnd != nullptr);
 4126: 
 4127:    // Compute the center of the side
 4128:    side.center = 0.5*(side.n1->p + side.n2->p);
 4129: 
 4130:    #ifdef USE_FRAMES
 4131:    side.setFrame();
 4132:    #endif
 4133: 
 4134:    // Normal, unitary vector to the side
 4135:    if constexpr(ics == 1) {
 4136:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4137:       side.n = normalize(side.n);
 4138:    }
 4139:    else {
 4140:       // Unit side vector in 3D cartesian coordinates
 4141:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4142: 
 4143:       nSide = normalize(nSide);
 4144: 
 4145:       // Its cross product with the unit local z-axis vector (nUp) is the
 4146:       // normal vector we are looking for.
 4147:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4148: 
 4149:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4150:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4151:       side.n = -normalize(n2D); 
 4152: 
 4153:    }
 4154: 
 4155:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4156:    side.shapiro = shapiro0;
 4157: 
 4158:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4159:    // XXXX
 4160:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4161:    constexpr double rot_per=3000.0;
 4162:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4163:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4164:    // XXXXX      
 4165:    #endif
 4166:    // Compute the z level at the center of the side
 4167:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4168:    
 4169:    // Compute the length of the side
 4170:    side.len = length(toPoint3(side.n2->p, side.n2->gz) - toPoint3(side.n1->p, side.n1->gz));
 4171: 
 4172: 
 4173:    // Compute the Coriolis coefficient
 4174: 
 4175:    if constexpr(ncor == -1 || ncor == 0) {
 4176:       side.coriolis = coricoef;
 4177:    }
 4178:    else {
 4179:       const double sphi = side.lat();  // Latitude at the center of the side
 4180: 
 4181:       assert(use_ll && "use_ll must be true when ncor > 0");
 4182: 
 4183:       if constexpr(ics == 1) {
 4184:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4185:       }
 4186:       else { // ics == 2
 4187:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4188:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4189:       }
 4190: 
 4191:    }
 4192: 
 4193: }
 4194: 
 4195: 
 4196: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4197:    double *node_coords, double *node_coords_ll, bool use_ll,
 4198:    double *wind_rotate_angle,   
 4199:    int *isdel, int *isidenode, int *isbnd,
 4200:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4201:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4202:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4203:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4204:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4205:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4206:    double *drag, double *roughness) {
 4207: 
 4208:    ELEM(pelem);
 4209:    Element &elem(*pelem);
 4210:    const int i = idx_elem;
 4211: 
 4212:    elem.idx = i;
 4213: 
 4214:    for (int j = 0; j < i34[i]; j++) {
 4215:       const int idxNode = elnode[i*4 + j];  
 4216:       const int idxSide = elside[i*4 + j];
 4217:       
 4218:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4219:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4220: 
 4221:       // Find the neighboring element  
 4222:       if (elem.sides[j]->elems[0] == &elem) {
 4223:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4224:       }
 4225:       else {
 4226:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4227:       }
 4228:       
 4229:    }
 4230: 
 4231:    elem.i34 = i34[i];
 4232: 
 4233:    // Compute the barycenter of the element and its depth
 4234:    elem.center = {0.0, 0.0};
 4235:    elem.depth = 1e10;
 4236:    for (int j = 0; j < i34[i]; j++) {
 4237: 
 4238:       elem.center += elem.nodes[j]->p/i34[i];
 4239:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4240:    }
 4241: 
 4242:    #ifdef USE_FRAMES
 4243:    elem.setFrame();
 4244:    #endif
 4245: 
 4246:    elem.area = elem.computeSignedArea(); 
 4247:    elem.radius = sqrt(elem.area)/pi; 
 4248:    
 4249:    // Determines which way the normal vector to each side is oriented.
 4250:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4251:    for (int j = 0; j < i34[i]; j++)  
 4252:    {
 4253:       if (elem.sides[j]->elems[0] == &elem) {
 4254:          elem.ssign[j] =  1.0;
 4255:       }
 4256:       else {
 4257:          elem.ssign[j] = -1.0;
 4258:       }
 4259: 
 4260:    }
 4261: 
 4262:   
 4263: 
 4264:    // Derivatives of shape functions
 4265:    //  For ics=2, this is done in the element frame
 4266:    //  For quads, the derivative is evaluated at centroid
 4267:    for (int j = 0; j < elem.i34; j++) {
 4268:       const double area = elem.area;
 4269:       const int id2 = elem.nxq(1 + j);
 4270:       const int id3 = elem.nxq(2 + j);
 4271:       const int id4 = elem.nxq(3 + j);
 4272:       if (elem.isTri()) {
 4273:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4274:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 4275:          // da1/dx = (y1 - y2)/(2*area)
 4276: 
 4277:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4278:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4279:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4280: 
 4281:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4282:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4283: 
 4284:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4285: 
 4286:       }
 4287:       else  { // Quad; evaluate at centroid
 4288: 
 4289:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4290:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4291:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4292: 
 4293:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4294:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4295: 
 4296:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4297:       } // if Tri
 4298: 
 4299:    } // for j   
 4300:    
 4301:    
 4302: 
 4303: }
 4304: 
 4305: 
 4306: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4307:                                             double *emo, double *efa, 
 4308:                                             double *umo, double *ufa, 
 4309:                                             double *vmo, double *vfa,
 4310:                                             int *ifltype, int *iettype) {
 4311: 
 4312:    NODE_BND(nodeBnd);
 4313:    const int idx = idx_node_bnd;    
 4314: 
 4315:    nodeBnd->idx = idx;
 4316: 
 4317:    // Need to find the segment index and the index of the node on the segment
 4318:    int idxNode = -1;
 4319:    int iseg, i;
 4320:    for (iseg = 0; iseg < nope; iseg++) {
 4321:       // for each segment...
 4322:       for (i = 0; i < nond[iseg]; i++) {
 4323:          idxNode = iond[iseg + i*nope];
 4324:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 4325:          
 4326:       }
 4327:    }
 4328: 
 4329:    assert(iseg < nope && "iseg is out of bounds");
 4330: 
 4331: found: // Jumped here when the node was found
 4332: 
 4333:    nodeBnd->isEssentialBC = true;
 4334:    nodeBnd->elbc = 0.0;
 4335: 
 4336:    nodeBnd->segment->ifltype = ifltype[iseg];
 4337:    nodeBnd->segment->iettype = iettype[iseg];
 4338: 
 4339:    for (int jfr = 0; jfr < nbfr; jfr++) {
 4340: 
 4341:       const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4342: 
 4343:       nodeBnd->efa[jfr] = efa[idx2];
 4344:       nodeBnd->emo[jfr] = emo[idx2];
 4345:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 4346:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 4347: 
 4348:    }
 4349:         
 4350: 
 4351: }
 4352: 
 4353: __device__ void Mesh::populateBoundarySideLinks(void) {
 4354: 
 4355:    SIDE_BND(sideBnd);
 4356: 
 4357:    const Side *side = sideBnd->side;
 4358: 
 4359:    // We assume that the leftSide is the side s that has s->n2 == side->n1
 4360:    // and the rightSide is the side s that has s->n1 == side->n2
 4361:    for (int i = 0; i < mesh->nbs; i++) {
 4362: 
 4363:       Side *s = &mesh->localSideData[i];
 4364: 
 4365:       if (s == side) continue;  // Do not link the side to itself
 4366:    
 4367:       if (s->n1 == side->n2) sideBnd->leftSide  = s;
 4368:       if (s->n2 == side->n1) sideBnd->rightSide = s;
 4369:    }
 4370:    
 4371: }
