 7504: 
 7505:    switch (varCode) {
 7506:       case (int)VarCode::depth:
 7507:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 7508:          *sizeType = sizeof(double);
 7509:          break;
 7510:       case (int)VarCode::eta:
 7511:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 7512:          *sizeType = sizeof(double);
 7513:          break;
 7514:       case (int)VarCode::x:
 7515:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 7516:          *sizeType = sizeof(Vector2);
 7517:          break;
 7518:       case (int)VarCode::z:
 7519:          *offset = (int)((char*)&nodes[0].z[0] - (char*)nodes);
 7520:          *sizeType = sizeof(double);
 7521:          break;
 7522:       case (int)VarCode::kb:
 7523:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 7524:          *sizeType = sizeof(int);
 7525:          break;
 7526:       case (int)VarCode::isdry:
 7527:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 7528:          *sizeType = sizeof(int);
 7529:          break;         
 7530:       case (int)VarCode::w:
 7531:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 7532:          *sizeType = sizeof(double);
 7533:          break;
 7534:       case (int)VarCode::u:
 7535:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 7536:          *sizeType = sizeof(Vector2);
 7537:          break;         
 7538:       default:
 7539:          *offset = -1;    
 7540:    }  
 7541:    
 7542: }
