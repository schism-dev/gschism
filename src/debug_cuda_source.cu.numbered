 7147: __global__ void printMatrix(void) {
 7148: 
 7149: 
 7150:    // Let only one thread per block print at a time 
 7151: 
 7152:    if (threadIdx.x == 0) {
 7153:       for (int ithread = 0; ithread < blockDim.x; ithread++) {
 7154:          const int idx_node = ithread + blockIdx.x * blockDim.x;
 7155:          if (idx_node >= mesh->np) return;
 7156:          const Node *node = mesh->localNodeData + idx_node;
 7157:          printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7158:          for (int j = 0; j < node->numNodes; j++) {
 7159:             Node* nbNode = node->nodes[j];
 7160:             if (node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7161:          }
 7162:          printf("]\n");
 7163: 
 7164:       }
 7165:    }
 7166: 
 7167: 
 7168: 
 7169: }
