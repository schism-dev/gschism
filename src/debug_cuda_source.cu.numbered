 2844: __device__ void Node::updateKb(void) {
 2845: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2846: 
 2847:    if constexpr(ivcor == 1) return;
 2848: 
 2849: 
 2850:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 2851: 
 2852:    if constexpr(ivcor == 2) {  // SZ coordinates
 2853:       
 2854:       // Compute bottom level index
 2855:       if (depth <= mesh->h_s) {
 2856:          kb = izlev;   
 2857:          
 2858:       } else {
 2859:          kb = -1;
 2860:          int L = 0;
 2861:          int R = nzlev; 
 2862:          
 2863:          while (L <= R) {
 2864:             int M = (R + L) / 2;
 2865: 
 2866: 
 2867:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2868:             
 2869:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2870:                R = M;
 2871:             } else {
 2872:                L = M;
 2873:             }
 2874: 
 2875:             if (R - L == 1) {
 2876:                kb = L;
 2877:                break;
 2878:             }
 2879:          }
 2880: 
 2881:          // Checks that the binary search was successful
 2882:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 2883:        
 2884:       }
 2885:    } 
 2886: }
 2887: 
 2888: 
 2889: __device__ __inline__ void Node::updateZCoordData(void) {
 2890: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2891: 
 2892:    // assert(!isDry2() && "updateZCoordData: node is dry");
 2893:    // if (isDry2()) {
 2894:    //    kb = -1;  // XXXXXXXX KKKKK
 2895:    //    return;
 2896:    // }
 2897: 
 2898: 
 2899:    if constexpr(ivcor == 2) {  // SZ coordinates
 2900:       
 2901:       // Compute bottom level index
 2902:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 2903:    } 
 2904:    else if (ivcor == 1) {  // Localized sigma
 2905:       // Do nothing
 2906:    }
 2907: 
 2908: 
 2909: }
 2910: 
 2911: 
 2912: __device__ double Node::compZCoord(int k) const {
 2913:    // Computes the z coordinate at level k.
 2914:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2915:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2916:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2917:    // used 
 2918:    
 2919:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2920: 
 2921:    if (isDry2()) return -depth;  // XXXX I used to return 0.0
 2922: 
 2923:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2924: 
 2925:    if constexpr(ivcor == 2) {
 2926: 
 2927:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2928:       const double h_c = mesh->h_c;
 2929:       const double theta_f = mesh->theta_f;
 2930:       const double sinh_theta_f = mesh->sinh_theta_f;
 2931: 
 2932:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2933:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2934:       // once per time step/node.
 2935:       // CHECK: updateZCoordData
 2936: 
 2937:       //  To simplify comparisons, I define index versions of count variables.
 2938:       if      (k == ivrt)           return eta2; 
 2939:       else if (k == izlev)          return -hmod2;
 2940:       else if (k == kb)             return -depth;
 2941:       else if (k < izlev && k >= 0) return mesh->ztot[k];
 2942:       else if (k > izlev) {
 2943:          const int ksig = k - izlev;
 2944: 
 2945:          if (hmod2 <= h_c) {
 2946:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2947: 
 2948:          } 
 2949:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2950:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2951:             assert(false && "ZCOOR: invalid h_c\n");
 2952:          } 
 2953:          else {
 2954:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2955:                          h_c * mesh->sigma[ksig] + 
 2956:                          (hmod2 - h_c) * mesh->cs[ksig];
 2957:          }
 2958:       } else { 
 2959:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2960:       }
 2961: 
 2962:    }
 2963:    else if constexpr(ivcor == 1) {
 2964:       if (k == kb) return -depth;
 2965:       else if (k == nvrt-1) return eta2;
 2966:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2967:    }
 2968:    
 2969:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2970:    return 0.0;
 2971: }
 2972: 
 2973: 
 2974: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 2975:    // Computes the bottom drag Cd based on the selected nchi
 2976: 
 2977:    if constexpr(nchi == 0) {
 2978:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 2979:       Cd = drag;  // Read from drag file
 2980: 
 2981:    } else if constexpr(nchi == 1) {
 2982:       // 
 2983: 
 2984:       bool ltmp = false; // for WBL iteration
 2985: 
 2986:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 2987:       if (isDry || (rough == 0.0)) {
 2988:          Cd = 0.0;
 2989: 
 2990:       } else { //roughness >0 
 2991:          
 2992:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 2993: 
 2994:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 2995: 
 2996:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 2997: 
 2998:       } // if rough
 2999: 
 3000:    } else if constexpr(nchi == -1) {
 3001:    // Manning 
 3002:  
 3003:       const double htot = max(hmin_man, htot2()); 
 3004:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3005: 
 3006:    } else {
 3007:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3008:       
 3009:    } // if nchi
 3010: }
 3011: 
 3012: 
 3013: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3014:    // Checks if a side in on the boundary
 3015:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3016: 
 3017:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3018:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3019: 
 3020:    // Indices of the nodes that form the side
 3021:    const int n1 = side.n1->idx;
 3022:    const int n2 = side.n2->idx;
 3023:    isLand = false;
 3024:    
 3025: 
 3026:    // Check if the side is on a land boundary
 3027:    for (int i = 0; i < nland; i++) {
 3028:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3029:          // Consecutive nodes in the land boundary segment
 3030:          const int b1 = ilnd[i + j*nland];
 3031:          const int b2 = ilnd[i + (j + 1)*nland];
 3032: 
 3033:          assert(b1 != -1 && b2 != -1);
 3034: 
 3035:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3036:             
 3037:             isLand = true;
 3038:             return i;
 3039:          }
 3040:       }
 3041:    }
 3042: 
 3043:    // Check if the side is on an open boundary
 3044:    for (int i = 0; i < nope; i++) {
 3045:       for (int j = 0; j < nond[i] - 1; j++) {
 3046:          // Consecutive nodes in the open boundary segment
 3047:          const int b1 = iond[i + j*nope];
 3048:          const int b2 = iond[i + (j + 1)*nope];
 3049: 
 3050:          assert(b1 != -1 && b2 != -1);
 3051: 
 3052:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3053:             isLand = false;
 3054:             return i;
 3055:          }
 3056:       }
 3057:    }
 3058: 
 3059:    return -1;
 3060: }
 3061: 
 3062: 
 3063: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3064:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3065:                                     double *wind_rotate_angle, 
 3066:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3067:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3068:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3069:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3070:                                     double *drag, double *roughness, double *rmanning) {
 3071: 
 3072:    NODE(pnode);  
 3073:    const int i = idx_node;
 3074:    Node &node(*pnode);
 3075: 
 3076:    node.idx = i;
 3077: 
 3078:    const int idxNodeStart = nodeNeighNodesStart[i];
 3079:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3080:    node.numNodes = idxNodeEnd - idxNodeStart;
 3081:    node.nodes = nodeNeighNodes + idxNodeStart;
 3082:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3083: 
 3084: 
 3085: 
 3086:    const int idxElemStart = nodeNeighElemsStart[i];
 3087:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3088:    node.numElements = idxElemEnd - idxElemStart;
 3089:    node.elements = nodeNeighElems + idxElemStart;
 3090: 
 3091: 
 3092:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3093:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3094:       const int partNode = localNodePart[idxNodeGlobal]; 
 3095:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3096: 
 3097:       Node *node_ptr = nodes[partNode] + idxNode;
 3098:       
 3099:       nodeNeighNodes[idx] = node_ptr;
 3100:    }
 3101: 
 3102: 
 3103:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3104:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3105:       const int partElem = localElemPart[idxElemGlobal];
 3106:       const int idxElem  = localElemIndices[idxElemGlobal];
 3107: 
 3108:       Element *elem_ptr = elems[partElem] + idxElem;
 3109: 
 3110:       nodeNeighElems[idx] = elem_ptr;
 3111:    }      
 3112: 
 3113:    node.wind_angle = wind_rotate_angle[i];
 3114: 
 3115: 
 3116:    node.p.x   = node_coords[i * 3];
 3117:    node.p.y   = node_coords[i * 3 + 1];
 3118:    node.depth = node_coords[i * 3 + 2];
 3119: 
 3120:    if (use_ll) {
 3121:    node.lon = node_coords_ll[i * 2    ]*deg2rad;
 3122:    node.lat = node_coords_ll[i * 2 + 1]*deg2rad;
 3123:    }
 3124: 
 3125: 
 3126:    node.numSides = 0;
 3127: 
 3128:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3129:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3130:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3131:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3132:    else assert(false && "populateNodes: selected nchi not implemented.");
 3133:    
 3134:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3135:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3136:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3137: 
 3138:    
 3139:    // Links the node to the boundary information
 3140:    if (isbnd[i] >= 0) {
 3141:      
 3142:       // Get the index of the node boundary
 3143:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3144: 
 3145:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3146:       node.nodeBnd->node = &node;
 3147: 
 3148:       node.nodeBnd->sideBnd1 = nullptr;
 3149:       node.nodeBnd->sideBnd2 = nullptr;
 3150: 
 3151:       if (isbnd[i]>=0) {
 3152: 
 3153:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3154:          
 3155:          node.nodeBnd->segment->ifltype = 0 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3156: // printf("(isbnd[i]==0)?3:0 = %d\n", (isbnd[i]==0)?3:0);         
 3157:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3158: 
 3159:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3160:          node.nodeBnd->segment->clen  = nan("1");
 3161:          node.nodeBnd->segment->carea = nan("1");
 3162: 
 3163:       }
 3164:    } else {
 3165: 
 3166:       node.nodeBnd = nullptr; // For internal nodes
 3167: 
 3168:       if (isbnd[i] == landSegment) {
 3169:          node.nodeBnd = &landBoundaryNode;
 3170:          node.nodeBnd->segment = &landBoundarySegment;
 3171:       }
 3172:       
 3173:    }
 3174:    
 3175:    // XXXX GAUSSIAN HILL VELOCITIES
 3176: #ifdef GAUSSIAN_HILL_VELOCITIES
 3177:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3178:       constexpr double rot_per = 3000.0;
 3179:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3180:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3181:    // XXXXX
 3182: #endif
 3183: 
 3184: }
 3185: 
 3186: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3187:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3188:                                     double *wind_rotate_angle,   
 3189:                                     int *isdel, int *isidenode, int *isbnd,
 3190:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3191:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3192:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3193:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3194:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3195:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3196:                                     double *drag, double *roughness) {
 3197: 
 3198: 
 3199:    SIDE(pside);
 3200:    Side &side(*pside);
 3201:    const int i = idx_side;
 3202: 
 3203:    side.idx = i;  
 3204:    
 3205:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3206:    const double fc   = 2.0*omega_e*sin(sfea0);
 3207:    const double beta = 2.0*omega_e*cos(sfea0);
 3208: 
 3209:    // finding the pointer to the nodes that form the side
 3210:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3211:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3212: 
 3213:    const int locidx_n1 = localNodeIndices[idx_n1];
 3214:    const int locidx_n2 = localNodeIndices[idx_n2];
 3215:    const int part_n1 =   localNodePart[idx_n1];
 3216:    const int part_n2 =   localNodePart[idx_n2];
 3217: 
 3218:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3219:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3220: 
 3221:    // Counts the number of sides connected to each node
 3222:    side.n1->numSides++;
 3223:    side.n2->numSides++;
 3224: 
 3225:    // Normal, unitary vector to the side
 3226:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3227:    side.n = normalize(side.n);
 3228: 
 3229:    // Side boundary type
 3230:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3231:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3232: 
 3233:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3234:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3235:    {
 3236:       bool isLand = false;
 3237:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3238:       
 3239:       if (isbs > -1) {
 3240:          // assert(isLand || isbs>=0);
 3241:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3242: 
 3243:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3244: 
 3245:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3246:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3247: 
 3248:          assert (isLand == side.sideBnd->segment->isLand);
 3249: 
 3250:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3251:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3252:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3253: 
 3254:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3255:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3256:          
 3257:          side.sideBnd->side = &side;
 3258: 
 3259:       }
 3260:       else {
 3261:          side.sideBnd = nullptr;
 3262:       }
 3263:    }
 3264:    else 
 3265:    {
 3266:       side.sideBnd = nullptr;
 3267:    }
 3268: 
 3269: 
 3270:    // finding the pointer to the elements that share the side
 3271:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3272:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3273: 
 3274:    if (idx_e1 > -1) {
 3275:       const int locidx_e1 = localElemIndices[idx_e1];
 3276:       const int part_e1 =  localElemPart[idx_e1];
 3277:       side.elems[0] = elems[part_e1] + locidx_e1;
 3278: 
 3279:    }
 3280:    else {
 3281:       side.elems[0] = nullptr;
 3282:    }
 3283: 
 3284:    if (idx_e2 > -1) {
 3285:       const int locidx_e2 = localElemIndices[idx_e2];
 3286:       const int part_e2 =  localElemPart[idx_e2];
 3287:       side.elems[1] = elems[part_e2] + locidx_e2;
 3288:    }
 3289:    else {
 3290:       side.elems[1] = nullptr;
 3291:    }
 3292: 
 3293:    // Compute the center of the side
 3294:    side.center = 0.5*(side.n1->p + side.n2->p);
 3295: 
 3296:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3297:    side.shapiro = shapiro0;
 3298: 
 3299: #ifdef GAUSSIAN_HILL_VELOCITIES
 3300: // XXXX
 3301: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3302: constexpr double rot_per=3000.0;
 3303: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3304: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3305: // XXXXX      
 3306: #endif
 3307:    // Compute the z level at the center of the side
 3308:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3309:    
 3310:    // Compute the length of the side
 3311:    const Vector2 vLen = side.n2->p - side.n1->p;
 3312:    side.len = sqrt(dot(vLen, vLen));
 3313: 
 3314: 
 3315:    // Compute the Coriolis coefficient
 3316: 
 3317:    if constexpr(ncor == -1 || ncor == 0) {
 3318:       side.coriolis = coricoef;
 3319:    }
 3320:    else {
 3321:       const double sphi = side.lat();  // Latitude at the center of the side
 3322: 
 3323: // XXXXXX ERROR WHEN use_ll is false??????
 3324:       if constexpr(ics == 1) {
 3325:          // XXXXXXX
 3326:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3327:       }
 3328:       else {
 3329:          side.coriolis = 2.0*omega_e*sin(sphi);
 3330:       }
 3331: 
 3332:    }
 3333: }
 3334: 
 3335: 
 3336: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3337:    double *node_coords, double *node_coords_ll, bool use_ll,
 3338:    double *wind_rotate_angle,   
 3339:    int *isdel, int *isidenode, int *isbnd,
 3340:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3341:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3342:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3343:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3344:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3345:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3346:    double *drag, double *roughness) {
 3347: 
 3348:    ELEM(pelem);
 3349:    Element &elem(*pelem);
 3350:    const int i = idx_elem;
 3351: 
 3352:    elem.idx = i;
 3353: 
 3354:    for (int j = 0; j < i34[i]; j++) {
 3355:       const int idxNode = elnode[i*4 + j];  
 3356:       const int idxSide = elside[i*4 + j];
 3357:       
 3358:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3359:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3360: 
 3361:       // Find the neighboring element  
 3362:       if (elem.sides[j]->elems[0] == &elem) {
 3363:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3364:       }
 3365:       else {
 3366:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3367:       }
 3368:       
 3369:    }
 3370: 
 3371:    elem.i34 = i34[i];
 3372: 
 3373:    // Compute the barycenter of the element and its depth
 3374:    elem.center = {0.0, 0.0};
 3375:    elem.depth = 0.0;
 3376:    for (int j = 0; j < i34[i]; j++) {
 3377: 
 3378:       elem.center += elem.nodes[j]->p/i34[i];
 3379:       elem.depth  += elem.nodes[j]->depth/i34[i];
 3380:    }
 3381: 
 3382: 
 3383:    
 3384:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3385:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3386: 
 3387:    elem.area = elem.computeSignedArea(); 
 3388:    elem.radius = sqrt(elem.area)/pi; 
 3389:    
 3390:    // Determines which way the normal vector to each side is oriented.
 3391:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3392:    for (int j = 0; j < i34[i]; j++)  
 3393:    {
 3394:       if (elem.sides[j]->elems[0] == &elem) {
 3395:          elem.ssign[j] =  1.0;
 3396:       }
 3397:       else {
 3398:          elem.ssign[j] = -1.0;
 3399:       }
 3400: 
 3401:    }
 3402: 
 3403:    // Derivatives of shape functions
 3404:    //  For ics=2, this is done inside element/ll frame XXX
 3405:    //  For quads, the derivative is evaluated at centroid
 3406:    for (int j = 0; j < elem.i34; j++) {
 3407:       const double area = elem.area;
 3408:       const int id2 = elem.nxq(1 + j);
 3409:       const int id3 = elem.nxq(2 + j);
 3410:       const int id4 = elem.nxq(3 + j);
 3411:       if (elem.isTri()) {
 3412:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3413:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3414:          // da1/dx = (y1 - y2)/(2*area)
 3415:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3416:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3417:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3418:       }
 3419:       else  { // Quad; evaluate at centroid
 3420:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3421:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3422:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3423:       } // if Tri
 3424: 
 3425:    } // for j   
 3426:    
 3427:    
 3428: 
 3429: }
