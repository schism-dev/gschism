 2179:    __forceinline__ __device__ void Element::projectNodeVectorsToElementFrame(Vector2 *v) const {
 2180:    // Project the vectors from the node frame to the element frame
 2181: 
 2182:  
 2183:       v[0] = nodes[0]->frame.projHorVec(v[0], frame);
 2184:       v[1] = nodes[1]->frame.projHorVec(v[1], frame);
 2185:       v[2] = nodes[2]->frame.projHorVec(v[2], frame);
 2186:       if (isQuad()) v[3] = nodes[3]->frame.projHorVec(v[3], frame);
 2187:       else          v[3] = Vector2();
 2188:    }
 2189: 
 2190:    __forceinline__ __device__ void Element::projectSideVectorsToElementFrame(Vector2 *v) const {
 2191:    // Project the vectors from the side frame to the element frame
 2192: 
 2193:       v[0] = sides[0]->frame.projHorVec(v[0], frame);
 2194:       v[1] = sides[1]->frame.projHorVec(v[1], frame);
 2195:       v[2] = sides[2]->frame.projHorVec(v[2], frame);
 2196:       if (isQuad()) v[3] = sides[3]->frame.projHorVec(v[3], frame);
 2197:       else          v[3] = Vector2();
 2198:    }
