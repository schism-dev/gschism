 1431: 
 1432: // Helper functions for computing the local node index at a given offset from another.
 1433: __device__ __inline__ int nxq(int offset, int index, int size) {
 1434:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1435:    // to the index to make it positive
 1436:    assert(index + offset + 16*size >= 0);
 1437:    return (index + offset + 16*size) % size;  
 1438: }
 1439: 
 1440: __device__ __inline__ int nxq(int index, int size) {
 1441:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1442:    // to the index to make it positive
 1443:    assert(index + 16*size >= 0);
 1444:    return (index + 16*size) % size; 
 1445: }
