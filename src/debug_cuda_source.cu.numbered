 7499:       case (int)VarCode::kb:
 7500:          *offset = (int)((char*)&sides[0].kb - (char*)sides);
 7501:          *sizeType = sizeof(int);
 7502:          break;
 7503:       case (int)VarCode::isdry:
 7504:          *offset = (int)((char*)&sides[0].isDry - (char*)sides);
 7505:          *sizeType = sizeof(int);
 7506:          break;            
 7507:       // case (int)VarCode::w:
 7508:       //    *offset = (int)((char*)&sides[0].w2 - (char*)sides);
 7509:       //    *sizeType = sizeof(double);
 7510:       //    break;
 7511:       case (int)VarCode::u:
 7512:          *offset = (int)((char*)&sides[0].u2[0].x - (char*)sides);
 7513:          *sizeType = sizeof(Vector2);
 7514:          break;   
 7515:       case (int)VarCode::btu:
 7516:          *offset = (int)((char*)&sides[0].btu[0].x - (char*)sides);
 7517:          *sizeType = sizeof(Vector2);
 7518:          break;          
 7519:       case (int)VarCode::U:
 7520:          *offset = (int)((char*)&sides[0].U.x - (char*)sides);
 7521:          *sizeType = sizeof(Vector2);
 7522:          break;
 7523:       // case (int)VarCode::ghat:
 7524:       //    *offset = (int)((char*)&sides[0].ghat.x - (char*)sides);
 7525:       //    *sizeType = sizeof(Vector2);
 7526:       //    break;   
 7527:       case (int)VarCode::hhat:
 7528:          *offset = (int)((char*)&sides[0].hhat - (char*)sides);
 7529:          *sizeType = sizeof(Vector2);
 7530:          break;      
 7531:       case (int)VarCode::chi:
 7532:          *offset = (int)((char*)&sides[0].chi - (char*)sides);
 7533:          *sizeType = sizeof(double);
 7534:          break;
 7535:       case (int)VarCode::n1:
 7536:          *offset = (int)((char*)&sides[0].n1 - (char*)sides);
 7537:          *sizeType = sizeof(Node);
 7538:          break;
 7539:       case (int)VarCode::n2:
 7540:          *offset = (int)((char*)&sides[0].n2 - (char*)sides);
 7541:          *sizeType = sizeof(Node);
 7542:          break;                   
 7543:       default:
 7544:          *offset = -1;
 7545:    }
 7546: }
