10320: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
10321:    // Get the value of a variable from an side
10322:    // varName is the name of the variable to get
10323:    // var is the array to store the value
10324:    // k is the vertical level index of the variable to get
10325:    SIDE_BND(sideBnd);   
10326: 
10327:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
10328:    if (sideBnd->segment->isLand) idx = -7;
10329: 
10330:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
10331:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
10332: 
10333: }
