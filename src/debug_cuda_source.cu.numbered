 7738: extern "C" __global__ void getElementVar(int varCode, bool is3D, double *var1, double *var2, int *ivar1, int *ivar2, int k = -1, int j = -1) {
 7739:    // Get the value of a variable from an element
 7740:    // varName is the name of the variable to get
 7741:    // var is the array to store the value
 7742:    // k is the vertical level index of the variable to get
 7743: 
 7744:    ELEM(elem);
 7745:    
 7746:    int idx = elem->idx;
 7747:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7748: 
 7749:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7750:    if      (varCode == (int)VarCode::w)       { var1[idx] = elem->w[k];}
 7751:    else if (varCode == (int)VarCode::z)       { var1[idx] = elem->z[k];}
 7752:    else if (varCode == (int)VarCode::x)       { var1[idx] = elem->center.x; var2[idx] = elem->center.x;}
 7753:    else if (varCode == (int)VarCode::area)    { var1[idx] = elem->area;}
 7754:    else if (varCode == (int)VarCode::depth)   { var1[idx] = elem->depth;}
 7755:    else if (varCode == (int)VarCode::radius)  { var1[idx] = elem->radius;}
 7756:    else if (varCode == (int)VarCode::lonlat)  { var1[idx] = elem->xlon;     var2[idx] = elem->ylat;}
 7757:    else if (varCode == (int)VarCode::ghat)    { var1[idx] = elem->ghat1.x;  var2[idx] = elem->ghat1.y;}
 7758:    else if (varCode == (int)VarCode::kb)      { ivar1[idx] = elem->kb;}
 7759:    else if (varCode == (int)VarCode::ssign && j > -1)  {ivar1[idx] = elem->ssign[j];}
 7760:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7761:       
 7762:    
 7763: }
 7764: 
 7765: 
 7766: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7767:    // Get the value of a variable from an node
 7768:    // varName is the name of the variable to get
 7769:    // var is the array to store the value
 7770:    // k is the vertical level index of the variable to get
 7771: 
 7772:    NODE(node);
 7773:    
 7774:    int idx = node->idx;
 7775:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7776: 
 7777:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7778:    
 7779:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7780:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7781:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7782:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 7783:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7784:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7785:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;  
 7786:    else if (varCode == (int)VarCode::isdry && k == -1)  var[idx] = node->isDry?1.0:0.0;
 7787:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7788:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7789:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 7790:    
 7791:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7792:       
 7793:    
 7794: }
 7795: 
 7796: 
 7797: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7798:    // Get the value of a variable from an side
 7799:    // varName is the name of the variable to get
 7800:    // var is the array to store the value
 7801:    // k is the vertical level index of the variable to get
 7802:    SIDE(side);
 7803:    
 7804:    int idx = side->idx;
 7805:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7806: 
 7807:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 7808:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 7809:    // else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 7810:    else if (varCode == (int)VarCode::isdry && k == -1)   var[idx] = side->isDry?1.0:0.0;
 7811:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 7812:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 7813:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 7814:    // else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 7815:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 7816:    // else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 7817:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 7818:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 7819:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 7820:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 7821:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 7822:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 7823:    // else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 7824:    else if (varCode == (int)VarCode::bcc && k >= 0)      var[idx] = side->bcc[k].x;
 7825:    // else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 7826:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7827:    // else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7828:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7829:    // else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7830:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 7831:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 7832:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 7833:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 7834:    else if (varCode == (int)VarCode::chi  && k == -1)    var[idx] = side->chi;
 7835:    // else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 7836:    // else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 7837:    // else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 7838:    // else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 7839:    // else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 7840:    // else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 7841:    // else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 7842:    // else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 7843:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7844: }
 7845: 
 7846: 
 7847: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 7848:    // Get the value of a variable from an side
 7849:    // varName is the name of the variable to get
 7850:    // var is the array to store the value
 7851:    // k is the vertical level index of the variable to get
 7852:    SIDE_BND(sideBnd);   
 7853: 
 7854:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 7855:    if (sideBnd->segment->isLand) idx = -7;
 7856: 
 7857:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 7858:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 7859: 
 7860: }
