 1267:    __device__ __forceinline__ Vector2 grad2(double *a) const
 1268:    {
 1269:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
 1270:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
 1271:       if (isQuad()) {
 1272:          gx += a[3]*gradPhi[3].x;
 1273:          gy += a[3]*gradPhi[3].y;
 1274:       }
 1275:       return {gx, gy};
 1276:    }
 1277: 
 1278:    __device__ __forceinline__ Vector2 grad2(double Node::* field) const
 1279:    {
 1280:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
 1281:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
 1282:       if (isQuad()) {
 1283:          gx += (nodes[3]->*field)*gradPhi[3].x;
 1284:          gy += (nodes[3]->*field)*gradPhi[3].y;
 1285:       }
 1286:       return {gx, gy};
 1287:    }
 1288: 
 1289:    __device__ __forceinline__ Vector3 n(int k, double &area3D) const;
 1290:    __device__ __forceinline__ Vector3 n(int k) const {
 1291:       double area3D;
 1292:       return n(k, area3D);
 1293:     }
