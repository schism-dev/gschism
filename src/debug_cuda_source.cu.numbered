 8119: __global__ void printMatrix(bool full) {
 8120:    // Debugging: print the matrix
 8121: 
 8122:    const int size = mesh->np;
 8123:    double sum = 0.0;
 8124:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8125:       const Node *node = mesh->localNodeData + idx_node;
 8126:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 8127:       for (int j = 0; j < node->numNodes; j++) {
 8128:          Node* nbNode = node->nodes[j];
 8129:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 8130:          sum += node->coeffMatrix[j];
 8131:       }
 8132:       if (full) printf("]\n");
 8133: 
 8134: 
 8135:    }
 8136:    if (!full) printf("sum=%lf\n", sum);
 8137: }
