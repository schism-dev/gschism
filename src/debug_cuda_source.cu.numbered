 1586:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1587:       // Compute the different time ramps used in the code 
 1588:       // This function is performed by just one thread
 1589: 
 1590:       if constexpr(ibc == 0) {
 1591:          if (drampbc > 0.0) {
 1592:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1593:          } else {
 1594:             rampbc = 1.0;
 1595:          }
 1596: 
 1597:          if (nws != 0 && drampwind > 0.0) {
 1598:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1599:          } else {
 1600:             rampwind = 1.0;
 1601:          }
 1602:       }
 1603: 
 1604:       if (drampwafo > 0.0) {
 1605:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1606:       } else {
 1607:          rampwafo = 1.0;
 1608:       }
 1609: 
 1610:       // For source/sinks
 1611:       if (if_source && dramp_ss > 0.0) {
 1612:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1613:       } else {
 1614:          ramp_ss = 1.0;
 1615:       }
 1616: 
 1617:       if (dramp > 0.0) {
 1618:          ramp = tanh(2.0*time/86400.0/dramp);
 1619:       } else {
 1620:          ramp = 1.0;
 1621:       }
 1622: 
 1623:    }
