 7289: __global__ void printMatrix(bool full) {
 7290:    // Debugging: print the matrix
 7291: 
 7292:    const int size = mesh->np;
 7293:    double sum = 0.0;
 7294:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7295:       const Node *node = mesh->localNodeData + idx_node;
 7296:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7297:       for (int j = 0; j < node->numNodes; j++) {
 7298:          Node* nbNode = node->nodes[j];
 7299:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7300:          sum += node->coeffMatrix[j];
 7301:       }
 7302:       if (full) printf("]\n");
 7303: 
 7304: 
 7305:    }
 7306:    if (!full) printf("sum=%lf\n", sum);
 7307: }
