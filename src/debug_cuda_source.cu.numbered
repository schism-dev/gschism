 3746: 
 3747:    __global__ void solverCopyResult(double* x) {
 3748:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 3749:       NODE(node);
 3750:       const int idx = node->idx;
 3751: 
 3752:       node->mX = x[idx];
 3753:    }
 3754: 
 3755: 
 3756:    __global__ void rollUpElevation(void) {
 3757: 
 3758:       NODE(node);
 3759: 
 3760:       node->eta1 = node->eta2;
 3761: 
 3762:    }
 3763: 
 3764: 
 3765:    __global__ void backtrackAllNodes(void) {
 3766: 
 3767:       // max/min # of sub-divisions
 3768:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 3769:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 3770: 
 3771: 
 3772:       SIDE(side);
 3773: 
 3774:       const int kb = side->kb;
 3775: 
 3776: 
 3777:       // Initialize btrack velocities to the actual velocities at the side 
 3778:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3779: 
 3780:   
 3781: 
 3782:       if (side->isDry) return;
 3783:       
 3784: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 3785: 
 3786:       // Checks that at least one element is not dry
 3787:       const Element *elem1 = side->elems[0];
 3788:       const Element *elem2 = side->elems[1];
 3789: 
 3790: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 3791: 
 3792:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3793:       
 3794:       // XXXXXX
 3795:       // !swild_tmp to store global coord. of the starting side
 3796:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3797:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3798:       // !Use sframe2 
 3799:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3800: 
 3801: 
 3802:       for (int k = kb; k < nvrt; k++) {
 3803:       //  Initialize (xt,yt,zt), nnel and vel.
 3804:       //  For ics=2, the coordinates are in local frames
 3805:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3806: 
 3807: 
 3808:          const int iadvf = side->iadv();  // Advection flag   
 3809:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 3810: 
 3811:          Point3 xt;
 3812:          if constexpr(ics==1) {
 3813:             xt = side->center3D(k); 
 3814:          }
 3815:          else // lat/lon; in side lat/lon frame
 3816:          {
 3817:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3818:          // XXX IMPLEMENT THIS
 3819:       //          xt=0.d0
 3820:       //          yt=0.d0
 3821:       //          !centroid coord. for nudging
 3822:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3823:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3824:          }  // ics
 3825: 
 3826: 
 3827: 
 3828:          // If on land or open boundary...
 3829:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3830:          
 3831:          const double vmag = length(side->u2[k]);
 3832: 
 3833:          if (vmag <= velmin_btrack) {
 3834:             // No activity 
 3835: 
 3836:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 3837: // addDebugPlot(side->center, side->center, 0x00000F, '+');     
 3838: 
 3839: 
 3840:             
 3841:          } else {  // do btrack
 3842: 
 3843:             // Compute number of sub-divisions based on local gradients of the velocity field
 3844: 
 3845:             // XXX IS THIS NECESSARY?
 3846:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 3847:             double suma = 0.0;
 3848:             int icount = 0;
 3849:             for (int l=0; l<2; l++) {
 3850:             // For each element sharing the side...
 3851: 
 3852:                const Element *elem = side->elems[l];
 3853:                  
 3854:                if (elem == nullptr) continue;
 3855: 
 3856:                icount++;
 3857: 
 3858:                // Not strictly along z; in ll frame for ics=2
 3859: 
 3860:                double utmp[4];
 3861:                double vtmp[4];
 3862:                for (int j = 0; j < elem->i34; j++) {
 3863: 
 3864:                   const Node *node = elem->nodes[j];
 3865: 
 3866:                   if constexpr(ics==1) {
 3867:                      utmp[j] = node->u2[k].x;
 3868:                      vtmp[j] = node->u2[k].y;  
 3869:                   } else {
 3870:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3871:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(j),vtmp0(j))
 3872:                   }
 3873:                } // for j
 3874: 
 3875:                const Vector2 grad_u = elem->grad2(utmp); 
 3876:                const Vector2 grad_v = elem->grad2(vtmp);
 3877: 
 3878:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3879:             } // for ii
 3880: 
 3881:             assert(icount > 0 && "Impossible 77");
 3882: 
 3883:             // '4' is somewhat arbitrary
 3884:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3885: 
 3886:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3887: 
 3888:             Vector3 u_int = {0.0, 0.0, 0.0};
 3889: 
 3890:             bool res =side->btrack(k, dt, dtbk, u_int);
 3891: 
 3892:             side->btu[k] = toVector2(u_int);
 3893:                
 3894:          } // if vmag (do backtrack)
 3895: 
 3896: 
 3897:       } // for k=kb,nvrt-1
 3898: 
 3899:    }
 3900: 
 3901: } // extern "C"
 3902: 
 3903: template<int nc>
 3904: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3905: 
 3906: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3907: //
 3908: // a,b,c,rhs: input vectors and are not modified by this program.
 3909: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3910: // rhs is the r.h.s.
 3911: // n: actual rank of the system.
 3912: // rows in u() and rhs();
 3913: // u: output with nc columns (transposed to rows)
 3914: // gam: a working array.
 3915: //
 3916: // NOTES:
 3917: // This is a template function that allows for different numbers of columns in the rhs vector.
 3918: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3919: 
 3920:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3921:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3922: 
 3923:    double bet = b[0];
 3924:    if constexpr (nc == 1) {
 3925:       u[0] = rhs[0]/bet;
 3926:    } else {
 3927:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 3928:    }
 3929: 
 3930:    for (int j = 1; j < n; j++) {
 3931:       gam[j] = c[j - 1]/bet;
 3932:       bet = b[j] - a[j]*gam[j];
 3933: 
 3934:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3935: 
 3936:       if constexpr (nc == 1) {
 3937:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3938:       } else {
 3939:          for (int l = 0; l < nc; l++) {
 3940:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 3941:          }
 3942:       }
 3943:    }
 3944: 
 3945:    // Back-substitution
 3946:    for (int j = n - 2; j >= 0; j--) {
 3947:       if constexpr (nc == 1) {
 3948:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 3949:       } else {
 3950:          for (int l = 0; l < nc; l++) {
 3951:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 3952:          }
 3953:       }
 3954:    }
 3955: }
 3956: 
 3957: 
 3958: 
 3959: // Helper function that contains the core algorithm
 3960: template<typename XAccessor, typename YAccessor>
 3961: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3962:                                     double  yp_top, double  yp_bot, 
 3963:                                     CubicSpline &spline) {
 3964:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3965:    // 
 3966:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3967:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3968:    //
 3969:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3970:    // 
 3971:    // Inputs: 
 3972:    //            n: dimension for x etc; # of data pts (>=2);
 3973:    //            getX, getY: functions to access x,y coordinates
 3974:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3975:    //     Output: 
 3976:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3977: 
 3978:    const int n = k2 - k1 + 1;
 3979:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3980: 
 3981:    // Allocate memory for the splines
 3982:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3983:    spline.x   = new double[n];
 3984:    spline.y   = new double[n];
 3985:    spline.yp  = new double[n];
 3986:    spline.ypp = new double[n];
 3987: 
 3988:    for (int k=k1; k<=k2; k++) {
 3989:       spline.x[k] = getX(k);
 3990:       spline.y[k] = getY(k);
 3991:    }
 3992: 
 3993:    // This is to simplify expressions later
 3994:    double *x = spline.x;
 3995:    double *y = spline.y;
 3996: 
 3997:    double *a = nullptr;
 3998:    double *b = nullptr;
 3999:    double *c = nullptr;
 4000:    double *gam = nullptr;
 4001:    double *rhs = nullptr;
 4002:    
 4003: 
 4004:       a = new double[n];   // Lower diagonal
 4005:       b = new double[n];   // Diagonal
 4006:       c = new double[n];   // Upper diagonal
 4007:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4008:       rhs = new double[n]; // Right-hand side
 4009: 
 4010:    for (int k=k1; k<=k2; k++) {
 4011:       if (k == k1) {
 4012:          // Bottom level
 4013:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4014:          b[k] = (x[k+1] - x[k])/3.0;
 4015:          c[k] = b[k]/2.0;
 4016:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4017:       } else if (k == n - 1) {
 4018:          // Top level (surface)
 4019:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4020:          b[k] = (x[k] - x[k-1])/3.0;
 4021:          a[k] = b[k]/2.0;
 4022:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4023:       } else {
 4024:          // Intermediate levels
 4025:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4026:          b[k] = (x[k+1] - x[k-1])/3.0;
 4027:          a[k] = (x[k  ] - x[k-1])/6.0;
 4028:          c[k] = (x[k+1] - x[k  ])/6.0;
 4029:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4030:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4031:       }
 4032:    }
 4033: 
 4034:    // Solve the tridiagonal system
 4035:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4036:    
 4037:    spline.yp[k1] = yp_bot;
 4038:    spline.yp[k2] = yp_top;
 4039: 
 4040:    // Compute rest of 1st derivatives using the splines
 4041:    for (int k=k1+1; k<k2; k++) {
 4042:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4043:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4044:    }
 4045:    
 4046:    delete[] a;
 4047:    delete[] b;
 4048:    delete[] c;
 4049:    delete[] gam;
 4050:    delete[] rhs;
 4051: 
 4052: }
 4053: 
 4054: // Array version
 4055: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4056:                                 double y_top, double y_bot, 
 4057:                                 CubicSpline &spline) {
 4058:    auto getX = [x] (int k) { return x[k]; };
 4059:    auto getY = [y] (int k) { return y[k]; };
 4060:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4061: }
 4062: 
 4063: // Lambda version - allows custom access patterns
 4064: template<typename XFunc, typename YFunc>
 4065: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4066:                                 double y_top, double y_bot,
 4067:                                 CubicSpline &spline) {
 4068:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4069: }
 4070: 
 4071: 
 4072: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 4073: {
 4074:    assert("Not implemented");
 4075: 
 4076:    return 0.0;
 4077: }
