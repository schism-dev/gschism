 4266:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4267: 
 4268:       SIDE(side);
 4269: 
 4270: 
 4271:       side->U = {0.0, 0.0}; 
 4272:          
 4273:       if(side->isDry) return;
 4274: 
 4275:       const Node *node1 = side->n1;
 4276:       const Node *node2 = side->n2;
 4277: 
 4278:       // Vertically integrated velocity U (in ll if ics=2)
 4279:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 4280:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 4281:       }
 4282: 
 4283:    }
 4284: 
 4285:    __global__ void computeBottomDragVegetation(void) {
 4286:       // UNFINISHED. CHECK THIS:
 4287:       // How many kernels are needed? Why so many for loops?
 4288:       // Is the loop on sides needed?
 4289: 
 4290:       NODE(node);
 4291: 
 4292:       const int    kb      = node->kb;
 4293:       const double htot    = node->htot2();
 4294:       const double rough   = node->rough;
 4295: 
 4296: 
 4297:       if (node->isDry) {
 4298:          // Default values for dry nodes
 4299:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4300:          /// XXX CHECK INDICES
 4301:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4302:       }
 4303: 
 4304:       // Compute bottom drag Cd
 4305:       //--------------------------------
 4306: 
 4307:       // nchi = {-1, 0, 1} is the type of bottom drag.
 4308:       if constexpr(nchi == 1) {
 4309: 
 4310:          bool ltmp = false; // for WBL iteration
 4311: 
 4312:          // Cdmax=-1 !max. Cd at node for this process (info only)
 4313:          // Drag at nodes
 4314:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)   XXXXXXXXXXXX
 4315:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 4316:         
 4317:          const double rough = node->rough;
 4318:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4319:          if (node->rough == 0.0) {
 4320:             node->Cd = 0.0;
 4321: 
 4322:          } else { //roughness >0 
 4323:             
 4324:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 4325:             const double bthick = max(dzb_min, bthick_ori);
 4326: 
 4327:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 4328: 
 4329:             double tmp = 1.0/(2.5*log(bthick/rough));
 4330:             node->Cd = tmp*tmp;
 4331: 
 4332:          } // if rough
 4333: 
 4334: 
 4335:          // RECOVER THIS: XXX
 4336:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 4337:          // Output warning for WBL if iteration didn't converge
 4338: 
 4339: 
 4340:       } // nchi==1
 4341: 
 4342:       //   Bottom stress in m^2/s^2
 4343:       if (node->rho[kb + 1] >= -98.0)
 4344:       {
 4345:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 4346:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 4347: 
 4348:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4349:          // !sediment erosion: this part needs more documentation
 4350:       }
 4351: 
 4352:     
 4353:       // Compute vegetation parameters
 4354:       //--------------------------------
 4355: 
 4356:       // SAV constants
 4357:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4358:       constexpr double veg_cfpsi = 0.16;
 4359: 
 4360:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4361:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4362: 
 4363:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4364:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4365:          int kbin = 0; // bin index
 4366:          for (int k = kb; k < nvrt; k++) {
 4367:             // Computes node height above the bottom level
 4368:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4369:             assert(false && "Vertical variation of vegetation not implemented");
 4370: 
 4371:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4372:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4373:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4374:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4375:             // } else {
 4376:             //    // Find the bin at which the current vertical level is
 4377:             //    while (kbin<nbins_veg_vert) {
 4378:             //       const double zn = node->z[kbin];
 4379:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4380:             //          break;
 4381:             //       } // if
 4382:             //       kbin++;
 4383:             //    } // while
 4384:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4385: 
 4386:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4387:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4388:                
 4389:             //    // Linear interpolation of the vegetation parameters
 4390:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4391:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4392:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4393:             // } // if rl10
 4394: 
 4395:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4396: 
 4397:          } // for k
 4398: 
 4399: 
 4400:       } else { // Ganthy (iveg=2)
 4401:       //  Modify canopy height, diameter, and density
 4402: 
 4403:          // Make sure there is vegetation on this node
 4404:          if (node->veg_h_unbent > 0.0) {
 4405:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4406: 
 4407:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4408:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4409:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4410: 
 4411:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4412:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4413:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4414:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4415:          } // if veg_h_unbent
 4416: 
 4417:          for (int k = 0; k < nvrt; k++) {
 4418:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4419:          } // for k
 4420:       
 4421: 
 4422:       } // if iveg
 4423:      
 4424:          
 4425: 
 4426:       // Compute vertical mean of veg_alpha3D
 4427:       if (iveg != 0) {
 4428:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4429:          double sum1=0.0;
 4430:          double sum2=0.0;
 4431:          // Integrate over each level under the canopy...
 4432:          for (int k=kb; k<nvrt-1 && node->z[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 4433:             const double Dz = node->Dz(k);
 4434: 
 4435:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 4436:             sum2 += Dz;
 4437: 
 4438:          } // for k
 4439: 
 4440:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4441:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4442: 
 4443:       } // if iveg
 4444: 
 4445:    }
 4446: 
 4447:    __global__ void computeVegetationAndDragParameters(void) {
 4448:       // Computes the vegetation and drag model parameters:
 4449:       // chi, \tilde\chi, beta, \breve{H}
 4450:       
 4451:       SIDE(side);
 4452: 
 4453:       const double htot = side->htot2();
 4454:       const int    kb   = side->kb;
 4455: 
 4456:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4457: 
 4458:       const double veg_h     = side->veg_h();
 4459:       const double veg_nv    = side->veg_nv();
 4460:       const double veg_c     = side->veg_c();
 4461:       const double veg_beta  = side->veg_beta;
 4462:       const double veg_alpha = side->veg_alpha_vert_mean();
 4463: 
 4464:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4465:       // Velocity magnitude at the bottom level
 4466:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4467:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4468:       side->chi2 = side->Cd()*vmag1;
 4469:       side->chi  = side->chi2;
 4470:       if constexpr(iveg != 0) {
 4471:          const Node *n1 = side->n1;
 4472:          const Node *n2 = side->n2;
 4473:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4474:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4475:       }
 4476: 
 4477:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4478: 
 4479:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4480:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4481:       double magUa = 0.0;
 4482:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4483:          // 3D wet side with veg...
 4484: 
 4485:          double magUa = 0.0;
 4486:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4487:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4488: 
 4489:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4490:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4491:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4492: 
 4493:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4494:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4495: 
 4496:                // Velocity magnitude at the bottom (l) of the level
 4497:                const double ul = length(side->u2[k]);
 4498: 
 4499:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4500:                magUa += Dz*0.5*(uh + ul);
 4501: 
 4502:             } // if HasVegetation
 4503:          } // for k
 4504:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4505: 
 4506:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4507:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4508:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4509:             const double zCpy = side->zTopCanopy();
 4510:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4511:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4512:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4513:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4514:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4515:          } // if isSubmerged
 4516:       } // if iveg   
 4517: 
 4518:       // Computes the friction modified depth, \breve{H} in notes
 4519:       if (side->is2D()) { // 2D
 4520: 
 4521:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4522:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4523: 
 4524:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4525: 
 4526:          side->hhat = htot*htot/fricH; 
 4527: 
 4528:       } else { // 3D
 4529:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4530: 
 4531:          if constexpr(iveg != 0) {
 4532:             
 4533:             if (side->isSubmerged()) { 
 4534:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4535:                side->hhat -= veg_c*Hhat_alpha;
 4536: 
 4537:             } else { // Emergent
 4538:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4539:             }
 4540:          } // if iveg
 4541: 
 4542:          // Enforce positivity for 3D model
 4543:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4544:       } // if 3D
 4545: 
 4546:    }
 4547: 
 4548: 
 4549: 
 4550:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4551:    // Computes the density gradient between two elements, e1 and e2.
 4552:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4553:    // zero in the direction normal to the side. 
 4554:    // 
 4555:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4556:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4557:    //
 4558:    // Input:
 4559:    //    e1: Element
 4560:    //    e2: Neighbor element (or nullptr if boundary)
 4561:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4562:    //    k: Index of the half-level at which the density is interpolated
 4563:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4564:    // 
 4565:    // Output:
 4566:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4567:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4568: 
 4569:       if (e2 == nullptr || e2->isDry) {
 4570:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4571: 
 4572:          Side *side = e1->sides[j];
 4573:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4574:                  
 4575:          if constexpr(ics == 1) {
 4576:             vec = side->n; // Normal vector to the side
 4577:          } else {
 4578:             // IMPLEMENT THIS XXXXXX
 4579:             // !replace with xel, yel?
 4580:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4581:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4582:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4583:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4584:          } //ics
 4585:                    
 4586:          diffRho = 0.0;
 4587: 
 4588:       } else { //internal and wet
 4589:          if constexpr(ics==1) {
 4590:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4591: 
 4592:             // Vector from e1 to e2
 4593:             vec = toVector2(e2->center - e1->center);
 4594: 
 4595:          } else { 
 4596:             // IMPLEMENT THIS XXXXXX
 4597:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4598:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4599:             //                   alow(j)=xctr2
 4600:             //                   bdia(j)=yctr2
 4601:          } // ics
 4602: 
 4603:          diffRho = rho2 - e1->demeanedDensity(k);
 4604:       }
 4605: 
 4606:    }
 4607: 
 4608:    __global__ void computeDensityCubicSplines(void) {
 4609:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4610: 
 4611:       ELEM(elem);
 4612: 
 4613:       if (elem->isDry) return;
 4614: 
 4615:       const int kb = elem->kb;
 4616: 
 4617:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4618:       if (elem->is2D()) {
 4619:          // In the 2D case, the density is constant at the prism level. 
 4620:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4621:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4622:       } else { //3D
 4623: 
 4624:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4625:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4626:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4627:          ///// XXXX CHECK INDICES!!!!!
 4628:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4629:       } // 2D/3D
 4630: 
 4631:    }
 4632: } // extern "C"
 4633: 
 4634: 
 4635: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4636: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4637: 
 4638:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4639: 
 4640:    const int kb  = elem->kb;
 4641:    const int kb2 = elem2->kb;
 4642: 
 4643:    // z-coordinate of prism of elem
 4644:    const double zp = elem->z_prism(k);
 4645: 
 4646:    double rho = 0.0;
 4647: 
 4648:    if (elem2->is2D()) {
 4649:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4650: 
 4651:    } else {  // 3D
 4652: 
 4653:       // eta_min may be < zmax
 4654:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4655:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4656: 
 4657:       // (Extrapolate density below bottom, we will fix it later)
 4658:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4659:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4660:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4661:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4662:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4663:    } // 2D/3D
 4664:      
 4665: 
 4666:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4667:    // Now we need to fix it.
 4668:    if (elem->z[k] < elem2->z[kb2]) {
 4669:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4670: 
 4671:       // There are two methods to adjust the density at the bottom of the element.
 4672:       // iunder_deep=0: 
 4673:       const double depth1 = abs(elem->z[kb]); // larger depth
 4674: 
 4675:       if (iunder_deep==0) {
 4676: 
 4677:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4678: 
 4679:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4680: 
 4681:       } else { // iunder_deep != 0
 4682: 
 4683:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4684: 
 4685:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4686: 
 4687:          //   Demeaned density at the same z coordinate as
 4688:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4689:          }
 4690: 
 4691:       } // if iunder_deep
 4692:    } // if elem->z[kb] < elem2->z[kb]
 4693: 
 4694:    return rho;
 4695: }
 4696: 
 4697: 
 4698: extern "C" {
 4699:    __global__ void computeDensityGradient(void) {
 4700: 
 4701:          // Compute the horizontal density gradient at each element.
 4702:       // It works in two steps:
 4703:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4704:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4705:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4706:       //             gradRho.r1 = rho1 - rho0
 4707:       //             gradRho.r2 = rho2 - rho0
 4708:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4709:       // 
 4710:       //  NOTE: We use de-meaned densities.
 4711: 
 4712:       ELEM(elem);
 4713: 
 4714:       if (elem->isDry) return;
 4715: 
 4716:       const int kb  = elem->kb;
 4717:       const int i34 = elem->i34;
 4718: 
 4719:       for (int k = kb + 1; k < nvrt; k++) {
 4720:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 4721:          //             gradRho.r1 = rho1 - rho0
 4722:          //             gradRho.r2 = rho2 - rho0
 4723:          int icount = 0;
 4724:          double sumRx = 0.0;
 4725:          double sumRy = 0.0;
 4726:          for (int j1=0; j1<i34; j1++) { 
 4727: 
 4728:             const int j2 = elem->nxq(j1 + 1);
 4729: 
 4730:             // Pairs of consecutive neighbor elements of elem
 4731:             const Element *e1 = elem->nghbElems[j1];
 4732:             const Element *e2 = elem->nghbElems[j2];
 4733: 
 4734:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 4735:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 4736:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 4737: 
 4738:             // Compute the density difference and the vector from elem to e1 and e2
 4739:             // getRhoDiffAndVec takes into account boundaries/dry elements
 4740:             double diffRho1, diffRho2;
 4741:             Vector2 vec1, vec2;
 4742:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 4743:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 4744: 
 4745:             const double rl1 = length(vec1);
 4746:             const double rl2 = length(vec2);
 4747:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 4748: 
 4749:             const double delta = cross(vec1, vec2);
 4750:             const double sintheta = abs(delta)/(rl1*rl2);
 4751: 
 4752:             // To avoid problems, avoid elements with small angle between vectors
 4753:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 4754:             const bool validEq = (sintheta > sin_one_deg);
 4755: 
 4756:             if (validEq) {
 4757:                // Solve the system of equations to get the density gradient at elem
 4758:                icount++;
 4759:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 4760:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 4761:                sumRx += Rx;
 4762:                sumRy += Ry;
 4763:             }
 4764:          } // for j1
 4765: 
 4766:          // Compute the average density gradient at elem
 4767:          if (icount==0) {
 4768:            // Bad mesh quality; bail out with 0 b-cc
 4769:            elem->gradRho[k] = {0.0, 0.0};
 4770:          } else {
 4771:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 4772:          }
 4773: 
 4774:       } // for k
 4775: 
 4776:    }
 4777: 
 4778:    __global__ void computeBaroclinicTerm(void) {
 4779:    // Computes the baroclinic term at sides (at half levels).
 4780:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 4781:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 4782: 
 4783:       SIDE(side);
 4784: 
 4785:       if (side->isDry) return;
 4786: 
 4787:       const Element *e1 = side->elems[0];
 4788:       const Element *e2 = side->elems[1];      
 4789:       const int kb = side->kb;
 4790:       
 4791:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 4792: 
 4793:       // interpolates vertically the density gradient of the two elements at the half level/
 4794: 
 4795:       // Starts the integration at the surface and goes down to the bottom
 4796:       int k1 = nvrt - 1;
 4797:       int k2 = nvrt - 1;
 4798: 
 4799:       side->bcc[nvrt-1] = {0.0, 0.0};
 4800:       for (int k = nvrt-2; k >= kb; k--) {
 4801:       // For each prism level (from surface to bottom)...
 4802: 
 4803:          // For both elements, interpolate density gradient at the side's half level.
 4804:          // The gradient at the side is the average of the gradients at the elements.
 4805:          // w1, w2 are used to take into account boundary sides, with just one element.
 4806:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 4807:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 4808:          const double wsum = w1 + w2;
 4809:          w1 = w1/wsum;
 4810:          w2 = w2/wsum;
 4811:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 4812: 
 4813:          // Linear interpolation of both elements' density gradient at the shared side's level.
 4814:          Vector2 gradRho = {0.0, 0.0};
 4815:          if (e1 != nullptr && k > kb) {
 4816:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 4817:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 4818:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 4819:             
 4820:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 4821:          }      
 4822:          if (e2 != nullptr && k > kb) {
 4823:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4824:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4825:             
 4826:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4827:          }
 4828: 
 4829:          if constexpr(ics==2) {
 4830:             // IMPLEMENT THIS XXXXXX
 4831:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4832:             // swild(1)=tmp1
 4833:             // swild(2)=tmp2
 4834:          }
 4835:          
 4836:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4837:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4838:          // CHECK INDICES!!! XXX
 4839:          const double grav3 = side->grav3();
 4840:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4841: 
 4842:       } // for
 4843: 
 4844:    }
 4845: 
 4846: 
 4847: 
 4848:    __global__ void computeHorGradientAtSide(void) {
 4849: 
 4850:       // Compute the horizontal density gradient at each element.
 4851:       // It works in two steps:
 4852:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4853:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4854:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4855:       //             gradRho.r1 = rho1 - rho0
 4856:       //             gradRho.r2 = rho2 - rho0
 4857:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4858:       // 
 4859:       //  NOTE: We use de-meaned densities.
 4860: 
 4861:       SIDE(side);
 4862: 
 4863: // printf("side->isDry: %d\n", side->isDry);
 4864:       if (side->isDry) return;
 4865: 
 4866:       // Computes the gradient of the variables at the side center.
 4867:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 4868:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 4869:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 4870: 
 4871:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 4872:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 4873:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 4874:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 4875: // printf("gradEta1: %.15f, %.15f\n", side->gradEta1.x, side->gradEta1.y);
 4876: // printf("gradEta2: %.15f, %.15f\n", side->gradEta2.x, side->gradEta2.y);
 4877: // printf("gradETP: %.15f, %.15f\n", side->gradETP.x, side->gradETP.y);
 4878: // printf("gradPr: %.15f, %.15f\n", side->gradPr.x, side->gradPr.y);
 4879: 
 4880: 
 4881:    }
 4882: 
 4883: 
 4884:    __global__ void solveMomentumEquations(double time) {
 4885: 
 4886:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 4887:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 4888: 
 4889:       SIDE(side);
 4890: 
 4891:       if (side->isDry) 
 4892:       {
 4893:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 4894: 
 4895:          return;
 4896:       }
 4897: 
 4898:       const Node *n1 = side->n1;
 4899:       const Node *n2 = side->n2;
 4900: 
 4901:       const int kb = side->kb;
 4902: 
 4903:       const double veg_h = side->veg_h();
 4904:       const double grav3 = side->grav3();
 4905: 
 4906:       if (side->is2D()) {
 4907:          // Warning: Do not use htot2, which is updated.
 4908:          const double htot = side->htot1();
 4909:          const double hhat = side->hhat;
 4910: 
 4911:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 4912: 
 4913:          Vector2 tau2 = {0.0, 0.0};
 4914:           
 4915:          if constexpr(ics==1) {
 4916:             tau2 = side->tau();
 4917: 
 4918:          } else {
 4919:             assert(false && "Not implemented: ics == 2");
 4920:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4921:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4922:             // taux2=(vn1+tt1)*0.5d0
 4923:             // tauy2=(vn2+ss1)*0.5d0
 4924:          } // if ics         
 4925: 
 4926:          // hat_gam has units of m/s
 4927: 
 4928:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 4929: 
 4930:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 4931:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 4932: 
 4933:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 4934: 
 4935: if (abs(hat_gam.x*hhat/htot) > rmaxvelx) printf("hat_gam.x*hhat/htot = %.16f, hat_gam.x = %.16f, hhat = %.16f, htot = %.16f\n", hat_gam.x*hhat/htot, hat_gam.x, hhat, htot);
 4936:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 4937:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 4938: 
 4939:          for (int k = 0; k < nvrt; k++) side->u2[k] = {ux, uy};
 4940: 
 4941: 
 4942:       }
 4943:       else { // 3D
 4944: 
 4945:          // For 3D it is necessary to solve an implicit tridiagonal system.
 4946:          // 
 4947:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 4948:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 4949:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 4950:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 4951:          // k+1 and k.
 4952: 
 4953: 
 4954:    
 4955: 
 4956: 
 4957:          const int ndim = nvrt - kb;
 4958:          const double zTopCanopy = side->zTopCanopy();
 4959: 
 4960:          // Initialize the tridiagonal system
 4961:          for (int k = kb + 1; k < nvrt; k++) {
 4962:             
 4963:             const int kin = k - (kb + 1);
 4964: 
 4965:             // Vertical viscosity at the face center
 4966:             const double dfz = 1e-6; //0.25*(side->dfv(k) + side->dfv(k + 1));
 4967:            
 4968: 
 4969:             alow[kin] = 0.0;
 4970:             cupp[kin] = 0.0;
 4971:             bdia[kin] = 0.0;
 4972: 
 4973:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 4974:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 4975: 
 4976:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 4977:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 4978:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 4979: 
 4980:             // First part: layers k, k+1
 4981:             if (k < nvrt - 1) {
 4982:                              
 4983:                if constexpr(iveg != 0) {
 4984: 
 4985:                   // If there is vegetation at this level...
 4986:                   if (zTopCanopy > side->zc[k]) {
 4987:                      // If the canopy is above the k layer...
 4988:                      
 4989:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 4990:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 4991:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 4992:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 4993: 
 4994:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 4995:                      const double vmag2 = length(ut2);
 4996:                      const double vmag1 = length(side->u2[k]);
 4997:                      const double vmag = 0.5*(vmag1 + vmag2);
 4998:                      
 4999:                      // Computes the vegetation alpha at the face center
 5000:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5001: 
 5002:                      cff1 += veg_alpha_sd*dt*vmag;
 5003: 
 5004:                   } // if (zTopCanopy
 5005:                } // if iveg
 5006: 
 5007:                const double dzz = side->Dz(k + 1);
 5008:                const double tmp = dt*dfz/dzz;
 5009:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5010: 
 5011:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5012:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5013:             }
 5014: 
 5015: 
 5016:             // Second part: layers k-1, k
 5017:             if (k > kb + 1) {
 5018: 
 5019:                double cff1 = 1.0; //init \bar{c^k}
 5020: 
 5021:                if constexpr(iveg != 0) {
 5022:                   // If there is vegetation at this level...
 5023:                   if (zTopCanopy > side->zc[k-1]) {
 5024:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5025:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5026: 
 5027:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5028: 
 5029:                      const double vmag2 = length(ut2);
 5030:                      const double vmag1 = length(side->u2[k-1]);
 5031:                      const double vmag = 0.5*(vmag1 + vmag2);
 5032: 
 5033:                      // Computes the vegetation alpha at the face center
 5034:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5035:                      cff1 += veg_alpha_sd*dt*vmag;
 5036:                   } // if zTopCanopy
 5037: 
 5038:                } // if iveg
 5039: 
 5040:                const double dzz = side->Dz(k);
 5041:                const double tmp = dt*dfz/dzz;
 5042:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5043: 
 5044:                alow[kin] += cff1*dzz/6.0 - tmp;
 5045:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5046: 
 5047:             } else { // Bottom boundary
 5048:                // This occurs at the bottom, where the bottom drag is applied.
 5049: 
 5050:                bdia[kin] += dt*side->chi2;
 5051: 
 5052:             } // if (k > kb + 1)
 5053: 
 5054: 
 5055: 
 5056:          } // for (int k
 5057: 
 5058: 
 5059: 
 5060:          // Computes the RHS.
 5061:          // -----------------
 5062: 
 5063:          //	BC to be imposed at the end.
 5064: 
 5065:          const Vector2 gradETP  = side->gradETP;
 5066:          const Vector2 gradPr   = side->gradPr;
 5067:          const Vector2 gradEta1 = side->gradEta1;
 5068:          const Vector2 gradEta2 = side->gradEta2;
 5069: 
 5070:          const Vector2 *btu = side->btu;
 5071:          const Vector2 *u2  = side->u2;
 5072:          const double coriolis = side->coriolis;
 5073:          const Vector2 *nuGradU = side->nuGradU;
 5074: 
 5075: 
 5076:          for (int k = kb + 1; k < nvrt; k++) {
 5077:             const int kin = k - kb - 1;
 5078: 
 5079:             const double dz_0 = side->Dz(k);
 5080:             const double dz_1 = side->Dz(k+1);  
 5081: 
 5082:             rrhs[kin] = {0.0, 0.0};
 5083:             double dz = 0.0;
 5084: 
 5085:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5086:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5087:             if (k < nvrt  ) dz += 0.5*dz_1;
 5088:             if (k > kb + 1) dz += 0.5*dz_0;
 5089: 
 5090:             // Elevation gradient, atmospheric pressure and tidal potential
 5091:             rrhs[kin] = -dz*dt*(grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0);
 5092:       
 5093: 
 5094:             // Coriolis, advection, wind stress, and horizontal viscosity
 5095:             if (k < nvrt - 1) {
 5096: 
 5097: 
 5098:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5099:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5100:                                             0.0*nuGradU[k] + nuGradU[k + 1]));
 5101:                                                 
 5102: 
 5103:                //diff stress tensors 1006
 5104:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5105:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5106:                   assert(false && "Not implemented: itur == 5");
 5107:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5108:                }
 5109: 
 5110:             } else { // k = nvrt - 1
 5111:                Vector2 tau2 = {0.0, 0.0};
 5112:                if constexpr(ics==1) {
 5113:                   tau2 = side->tau();
 5114:                } else {
 5115:                   assert(false && "Not implemented: ics == 2");
 5116:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5117:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5118:                   // taux2=(vn1+tt1)*0.5d0
 5119:                   // tauy2=(vn2+ss1)*0.5d0
 5120:                } // if ics
 5121: 
 5122:                rrhs[kin] += dt*tau2;
 5123: 
 5124:             } // if k<nvrt
 5125: 
 5126:             if (k > kb + 1) {
 5127:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5128:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5129:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5130: 
 5131:                // diff stress tensors 1006
 5132:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5133:                   assert(false && "Not implemented: itur == 5");
 5134:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5135:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5136:                }
 5137: 
 5138:             } // if k>kbs + 1
 5139: 
 5140:             // Baroclinic
 5141:             Vector2 *bcc = side->bcc;
 5142:             if constexpr(ibc == 0) {
 5143:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5144:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5145: 
 5146:             } // if ibc==0
 5147: 
 5148:          } // k=kb + 1,nvrt
 5149: 
 5150: 
 5151: if (side->idx == 21) for (int k=0; k<nvrt; k++) printf("AAAAAA kb = %d, alow[%d] = %.16f, bdia[%d] = %.16f, cupp[%d] = %.16f, rrhs[%d] = %.16f, %.16f\n", kb, k, alow[k], k, bdia[k], k, cupp[k], k, rrhs[k].x, rrhs[k].y);   
 5152:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5153: for (int k=nvrt-kb-1; k < nvrt; k++) { soln[k] = {0.0, 0.0}; side->u2[k] = {0.0, 0.0}; }
 5154: if (side->idx == 21) for (int k=0; k<nvrt; k++) printf("BBBB kb = %d, soln[%d] = %.16f, %.16f\n", kb, k, soln[k].x, soln[k].y);   
 5155: 
 5156: // for (int k=0; k<nvrt; k++) soln[k] = u[k];
 5157:          for (int k = kb + 1; k < nvrt; k++) {
 5158:             const int kin = k - kb - 1;
 5159: 
 5160:             // Velocity is always clamped to maximum values
 5161:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5162:          } // k
 5163: if (side->idx == 21) for (int k=0; k<nvrt; k++) printf("BBBBBB soln[%d] = %.16f\n", k, soln[k].x, soln[k].y);   
 5164:       } // if side->is2D()
 5165:       
 5166: 
 5167:       // Impose velocity boundary condition at the bottom
 5168:       if constexpr(imm == 2) { // 3D bed deformation model
 5169:          double dep;
 5170:          Vector2 vel;
 5171: 
 5172:          assert(false && "Not implemented: imm == 2");
 5173:          //update_bdef(time, x0, y0, dep, vel);
 5174:          // side->u2[kb] = vel;
 5175: 
 5176:       } else { // imm = 0 or 1
 5177:          if (side->Cd() == 0.0) {
 5178:             side->u2[kb] = side->u2[kb + 1];
 5179:          } else if (nvrt - 1 > kb + 1) { // 3D no slip bottom   XXXXX use is3D()?
 5180: // printf("XXXXXXXXX computeFlowBcVelocities: 3D no slip bottom, side idx = %d\n", side->idx);
 5181:             side->u2[kb] = {0.0, 0.0};
 5182:          }
 5183:           
 5184:       } // if imm
 5185: 
 5186:       // The velocities below the bottom level are set to zero
 5187:       for (int k=0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5188: 
 5189: 
 5190:    }
 5191: 
 5192: 
 5193:    __global__ void applyMomentumBC(void) {
 5194: 
 5195:       SIDE_BND(sideBnd);
 5196: 
 5197:       Side *side = sideBnd->side;
 5198:       const BoundarySegment *segment = sideBnd->segment;
 5199:       const Node *n1 = side->n1;
 5200:       const Node *n2 = side->n2;
 5201: 
 5202:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5203: 
 5204:       // REMEMEBER, this is a trick, segment can be a pointer or (-1, -2)
 5205:       const bool isLand = segment->isLand;
 5206:       const int ifltype = segment->ifltype;
 5207: 
 5208:       const int kb = side->kb;
 5209: 
 5210:       if (!isLand && ifltype != 0) {
 5211:          const Vector2 *ubc = sideBnd->ubc;
 5212:   
 5213:          for (int k = kb; k < nvrt; k++) {
 5214:             
 5215:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5216:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5217: 
 5218:             if (ifltype == -1) {
 5219:                // Flather 1
 5220: 
 5221:                const double depth = side->depth();
 5222: 
 5223:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5224: 
 5225:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5226: 
 5227:                side->u2[k] = vnorm*side->n;
 5228: 
 5229:             } else if (ifltype == -2) { // Discharge
 5230: 
 5231:                const double eta1 = side->eta1();
 5232:                const double eta2 = side->eta2();
 5233:                const double htot = side->htot2();
 5234: 
 5235:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5236:                assert(false && "Not implemented: Discharge bc");
 5237:                // const double dischrg = discharge(eta1);
 5238:                const double dischrg = 0.0; // XXX REMOVE
 5239:                
 5240: 
 5241:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5242: 
 5243:                const double vnorm = dischrg*eta2/htot;
 5244: 
 5245:                side->u2[k] = vnorm*side->n;
 5246: 
 5247: 
 5248:             }
 5249:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5250:                const double vnorm = dot(side->u2[k], side->n);
 5251: 
 5252:                double rat;
 5253:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5254:                else              rat = segment->vobc2; // outgoing
 5255: 
 5256:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5257:             }
 5258:             else { // not Flather or 3D radiation
 5259:                side->u2[k] = ubc[k];
 5260: 
 5261:             } // if (segment->ifltype...
 5262: 
 5263:          }
 5264: 
 5265:       }
 5266:       else if (isLand) { // if it is land boundary side
 5267: 
 5268:          if constexpr(islip == 0) { // free slip
 5269: 
 5270:             for (int k=kb; k < nvrt; k++) {
 5271: 
 5272:                const Vector2 t = side->t();
 5273:                const Vector2 n = side->n;
 5274: 
 5275:                double vnorm = 0.0; // for most cases
 5276:                const double vtan = dot(side->u2[k], t);
 5277:                
 5278:                side->u2[k] = vtan*t - vnorm*n;
 5279: 
 5280:             }
 5281: 
 5282:          } else { // no slip
 5283:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5284: 
 5285:          }
 5286:       } // if (side segment type...
 5287: 
 5288:    
 5289: 
 5290:    }
 5291: 
 5292: 
 5293:    __global__ void shapiroFilter1(void) {
 5294:       // First step of the Shapiro filter (normally used if indvel<=0)
 5295:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5296: 
 5297:       SIDE(side);
 5298: 
 5299:       // Only internal wet sides are processed
 5300:       if (side->isDry || !(side->isInternal())) return;
 5301: 
 5302:       const int kb = side->kb;
 5303: 
 5304:       for (int mm = 1; mm <= niter_shap; mm++) {
 5305: 
 5306:          for (int k = kb + 1; k < nvrt; k++) {
 5307:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5308:             side->bcc[k] = {0.0, 0.0};
 5309:             Vector2 suru = {0.0, 0.0};
 5310: 
 5311:             for (int j=0; j<4; j++) { // 4 neighbors per side
 5312: 
 5313:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5314: 
 5315:                int kin = k;
 5316:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5317:                
 5318:                if constexpr(ics==1) {
 5319:                   suru += nSide->u2[kin];
 5320: 
 5321:                } else {
 5322:                   assert(false && "Not implemented: ics == 2");
 5323:                   // Vector2 vn1, vn2;
 5324:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5325:                   // suru=suru+vn1;
 5326:                   // surv=surv+vn2;
 5327:                }
 5328:             }
 5329: 
 5330: 
 5331:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5332: 
 5333:          }
 5334:       }
 5335:    }
 5336: 
 5337:    __global__ void shapiroFilter2(void) {
 5338:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5339: 
 5340:       SIDE(side);
 5341: 
 5342: // side->u2[1] = {10.0,-10.0}; 
 5343: // side->u2[0] = {10.0,-10.0};
 5344: // return;      
 5345: 
 5346:       if (side->isDry || !(side->isInternal())) return;
 5347: 
 5348:       const int kb = side->kb;
 5349: 
 5350:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5351: 
 5352:       if (side->is2D()) {
 5353:          // side->u2[kb] = side->u2[nvrt - 1];
 5354:          side->u2[kb + 1] = side->bcc[kb + 1];
 5355:          side->u2[kb    ] = side->u2 [nvrt - 1];
 5356: 
 5357:       } else {
 5358:          // 3D
 5359:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5360:          
 5361:       }
 5362: 
 5363:    }
 5364: 
 5365: 
 5366:    __global__ void ul0UpdateZCoords(void) {
 5367:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5368:       
 5369:       NODE(node);      
 5370: 
 5371: 
 5372:       if (node->isDry2()) { 
 5373: 
 5374:          assert((ivcor != 2) && (node->depth < mesh->h_s) && "Deep depth dry");
 5375: 
 5376:          if constexpr(ivcor != 1) node->kb = 0;
 5377: 
 5378:       } else {
 5379: 
 5380:          node->updateKb();
 5381:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5382: 
 5383:       }
 5384: 
 5385:       // We use the temp.b field to store the previous state of isDry.
 5386:       node->tmp.b = node->isDry;
 5387: 
 5388:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5389:       node->isDry = true;
 5390: 
 5391:    }
 5392: 
 5393:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5394:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5395:    {
 5396:       ELEM(elem);
 5397: 
 5398:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5399: 
 5400:       // All the nodes of a wet element are wet.
 5401:       if (!elem->isDry) {
 5402:          elem->nodes[0]->isDry = false;
 5403:          elem->nodes[1]->isDry = false;
 5404:          elem->nodes[2]->isDry = false;
 5405:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 5406: 
 5407:       }
 5408: 
 5409: 
 5410:       elem->kb = 0;
 5411: 
 5412:       if (elem->isDry) return;
 5413: 
 5414:       // Wet
 5415:       const Node *n1 = elem->nodes[0];
 5416:       const Node *n2 = elem->nodes[1];
 5417:       const Node *n3 = elem->nodes[2];  
 5418:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5419: 
 5420:    //    if(elem->isDry2()) {
 5421:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5422:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5423:    //        call parallel_abort(errmsg)
 5424:    //    }
 5425: 
 5426: 
 5427:       // Computes element's kb as the minimum of the nodes' kb.
 5428:       const int kb1 = n1->kb;
 5429:       const int kb2 = n2->kb;
 5430:       const int kb3 = n3->kb;
 5431:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5432: 
 5433: 
 5434:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5435: 
 5436: 
 5437:       // Computes the element z as the mean of the nodes z.
 5438:       for (int k = elem->kb; k < nvrt; k++) {
 5439: 
 5440:          // Compute the element z as the mean of the nodes z.
 5441:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5442:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5443:          elem->z[k] /= elem->i34;
 5444: 
 5445:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5446:       }
 5447:                   
 5448:    }
 5449: 
 5450:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5451:    {
 5452:       NODE(node);
 5453:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5454: 
 5455:       if (it == iths) return;
 5456: 
 5457: 
 5458:       if(!node->isDry && node->tmp.b) { // rewetted
 5459:          for (int k=0; k < nvrt; k++) {
 5460: 
 5461:             Vector3 utmp={0.0, 0.0, 0.0};
 5462: 
 5463:             double ttmp=0.0;
 5464:             double stmp=0.0;
 5465:             int icount=0;
 5466:             for (int j = 0; j < node->numNodes; j++) {
 5467: 
 5468: 
 5469:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5470:                if (!node->isDry) { // all indices extended
 5471:                   icount++;
 5472: 
 5473:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5474:                   utmp += node->u2[k];
 5475:                   
 5476:                   ttmp += node->tracers[k].tracer[0]; 
 5477:                   stmp += node->tracers[k].tracer[1]; 
 5478:                }
 5479:             }
 5480: 
 5481:             if(icount > 0) {
 5482:                const double inv_icount = 1.0/icount;
 5483:                node->u2[k]     = inv_icount*utmp;
 5484:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5485:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5486:             }
 5487:          }
 5488:       }
 5489:    }
 5490: 
 5491: 
 5492:    __global__ void ul0UpdateSides(int it, int iths) {
 5493: 
 5494:       SIDE(side);
 5495: 
 5496:       // A side is wet if and only if at least one of its elements is wet.
 5497:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5498: 
 5499:       const Node *n1 = side->n1;
 5500:       const Node *n2 = side->n2;
 5501:       const int kb1 = n1->kb;
 5502:       const int kb2 = n2->kb;
 5503: 
 5504:       side->kb = 0; // dry
 5505: 
 5506:       if (isWet) {
 5507: 
 5508:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5509: 
 5510:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5511: 
 5512:          side->kb = min(kb1, kb2);
 5513: 
 5514:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 5515: 
 5516:          for (int k = side->kb; k < nvrt; k++) {
 5517:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5518: 
 5519:          
 5520:             assert((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0) && "Weird side (3)");
 5521: 
 5522:             // Compute velocity for re-wetted sides 
 5523:             if ((it != iths) && (side->isDry && isWet)) {
 5524:             
 5525:                Vector2 utmp={0.0, 0.0};
 5526: 
 5527:                int icount=0;
 5528: 
 5529:                // For all the sides on the two elements that share this side
 5530:                for (int j=0; j < 2; j++) {
 5531:                   const Element *elem = side->elems[j];
 5532:                   if (elem == nullptr) continue;
 5533: 
 5534:                   for (int jj=0; jj < elem->i34; jj++) {
 5535:                      const Side *nSide = elem->sides[jj];
 5536:                      if (nSide->isDry) continue;
 5537: 
 5538:                      icount++;
 5539:                      utmp += nSide->u2[k];                     
 5540:                   }
 5541:                }
 5542:                   
 5543:                assert(icount > 0 && "No wet sides around this side");
 5544:                if (icount > 0)  side->u2[k] = utmp/icount;
 5545:                   
 5546:             } // if ((it != iths) && (side->isDry && isWet))
 5547: 
 5548:          } // for k
 5549: 
 5550:       } // if isWet
 5551:    
 5552:       side->isDry = !isWet;
 5553: 
 5554:    }
 5555: 
 5556: 
 5557:    __global__ void zeroNodalVelocities(void) {
 5558:       NODE(node);
 5559: 
 5560:       for (int k = 0; k < nvrt; k++) {
 5561:          node->u2[k]   = {0.0, 0.0, 0.0};
 5562:          node->utmp[k] = {0.0, 0.0};
 5563:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5564:       }
 5565:    }
 5566: 
 5567:    __global__ void computeNodalVerticalVelocities1(void) {
 5568:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5569:    // Adds the element's vertical velocity times the element's area.
 5570:       ELEM(elem);
 5571: 
 5572:       for (int j = 0; j < elem->i34; j++) {
 5573:          Node *node = elem->nodes[j];
 5574: 
 5575:          for (int k = node->kb; k < nvrt; k++) {
 5576:             atomicAdd(&(node->u2[k].z), elem->w[k]*elem->area);
 5577:          }
 5578:          atomicAdd(&(node->tmp.d), elem->area);
 5579:       }
 5580:    }
 5581: 
 5582:    __global__ void computeNodalVerticalVelocities2(void) {
 5583:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5584:    // Divides by the total area of the elements sharing the    node.
 5585:       NODE(node);
 5586: 
 5587:       for (int k = node->kb; k < nvrt; k++) node->u2[k].z = node->u2[k].z / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5588:    }
 5589: 
 5590: 
 5591:    __global__ void computeNodalHorizontalVelocities1(void) {
 5592:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 5593:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 5594: 
 5595:       ELEM(elem);
 5596: 
 5597:       const int kb = elem->kb;
 5598:       const bool isTri = elem->isTri();
 5599: 
 5600:       if constexpr(indvel <= 0) {
 5601:          // Assuming discontinoius hvel.
 5602: 
 5603: 
 5604:          if (isTri) { // For triangles
 5605:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 5606:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 5607: 
 5608:             for (int j = 0; j < 3; j++) {
 5609:                // For every node of the triangle...
 5610:                Node *node = elem->nodes[j];
 5611: 
 5612:                const Side *s1 = elem->sides[j];
 5613:                const Side *s2 = elem->sides[(j + 1) % 3];
 5614:                const Side *s3 = elem->sides[(j + 2) % 3];
 5615: 
 5616:                const int numElements = node->numElements;
 5617:                const double inv_numElements = 1.0/numElements;
 5618: 
 5619:                for (int k = kb; k < nvrt; k++)  {
 5620:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated at the node   
 5621:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 5622:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 5623:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 5624:                   atomicAdd(&(node->utmp[k].x), inv_numElements * u.x);
 5625:                   atomicAdd(&(node->utmp[k].y), inv_numElements * u.y);
 5626: 
 5627:                }
 5628: 
 5629:             }
 5630:          }
 5631:          else { // For quads
 5632:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 5633: 
 5634:          }
 5635: 
 5636:       }
 5637:       
 5638:    }
 5639: 
 5640: 
 5641:    __global__ void computeNodalHorizontalVelocities2(void) {
 5642:       NODE(node);
 5643: 
 5644:       for (int k = 0; k < nvrt; k++) {
 5645:          node->u2[k] = toVector3(node->utmp[k], node->u2[k].z);
 5646:       }
 5647:       
 5648:    }   
 5649: 
 5650:    __global__ void computeNodalHorizontalVelocitiesOLD(void) {
 5651:    // XXXX I'm not sure where I got this function from. 
 5652:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 5653:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 5654:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 5655:    // It uses the utmp array as a temporary array to store the velocities.
 5656: 
 5657:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 5658: 
 5659:       SIDE(side);
 5660: 
 5661:       const int kb = side->kb;
 5662: 
 5663:       Node *n1 = side->n1;
 5664:       Node *n2 = side->n2;
 5665: 
 5666:       for (int k = kb; k < nvrt; k++) {
 5667: 
 5668:          // Cast the u2 vector into a Vector2 
 5669:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&(n1->utmp[k]));
 5670:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&(n2->utmp[k]));
 5671: 
 5672:          n1_u2 = side->u2[k]/n1->numSides;
 5673:          n2_u2 = side->u2[k]/n2->numSides;
 5674: 
 5675:       }
 5676: 
 5677: 
 5678:    }
 5679: 
 5680:    __global__ void resetVelocityOpenBndNodes(void) {
 5681:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 5682: 
 5683:       NODE_BND(nodebnd);
 5684: 
 5685:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 5686:          for (int k = 0; k < nvrt; k++) nodebnd->node->u2[k] = {0.0, 0.0, 0.0};
 5687:       }
 5688: 
 5689:    }
 5690: 
 5691: 
 5692:    __global__ void setVelocityOpenBndNodes(void) {
 5693:    // For open boundary nodes sets their velocity to the imposed values.
 5694: 
 5695:       SIDE_BND(sidebnd);
 5696: 
 5697:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 5698:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 5699:          // to its segment to the average of the side velocity.
 5700: 
 5701:          for (int k = 0; k < nvrt; k++) {
 5702:             Node *n1 = sidebnd->side->n1;
 5703:             Node *n2 = sidebnd->side->n2;
 5704: 
 5705:             // Cast the u2 vector into a Vector2 
 5706:             Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&n1->u2[k]);
 5707:             Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&n2->u2[k]);
 5708: 
 5709:             if (n1->nodeBnd->segment == sidebnd->segment) {
 5710:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 5711:             }
 5712:             if (n2->nodeBnd->segment == sidebnd->segment) {
 5713:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 5714:             }
 5715: 
 5716:          }
 5717:       }
 5718: 
 5719:    }
 5720: 
 5721: 
 5722:    __global__ void computeVerticalVelocity(void) {
 5723:       // Computes the vertical velocity at the (2D) element's centroid.
 5724:       // In this function we will be considering volumetric elements, with side faces and a 
 5725:       // bottom and a top face. We will call them SFs, BF and TF.
 5726:       // It computes the flux coming from BF and the SFs.
 5727:       // If the bed is moving, it takes that into account.
 5728:       // Since water is incompressible, the integral of the velocity times the normal vector
 5729:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 5730:       // and the BF is equal to the flux going out from the TF.
 5731:       // TF = - BF - sum(SFs).
 5732:       // It then computes the horizontal velocity at the center of TF.
 5733:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 5734:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 5735:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 5736: 
 5737:       ELEM(elem);
 5738: 
 5739:       if (elem->isDry) return;
 5740: 
 5741:       const int kb = elem->kb;
 5742:       const bool isTri = elem->isTri();
 5743: 
 5744:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 5745: 
 5746:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 5747:       const double av_bdef1 = elem->mean(&Node::bdef1);
 5748:       const double av_bdef2 = elem->mean(&Node::bdef2);
 5749: 
 5750:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 5751: 
 5752:       double area3D;
 5753: 
 5754:       // Bottom face flux
 5755:       double bottomFlux = 0.0;
 5756:       Vector2 u2meanBottom = {0.0, 0.0};
 5757:       const Vector2 gradh = elem->grad2(&Node::depth);
 5758:       if constexpr(imm==2) {
 5759:          Vector3 ubed;
 5760: 
 5761:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 5762:          // updateBDEF(ubed);
 5763:      
 5764:          // const double bflux0 = dot(ubed, elem_n1);
 5765: 
 5766:          // elem->w[kb] += ubed.z;
 5767:       }
 5768:       else {
 5769:          Vector2 umean;
 5770:          if constexpr(ics == 1) {
 5771:             u2meanBottom = elem->mean(kb, &Side::u2);
 5772:          }
 5773:          else {
 5774:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 5775:          }
 5776: 
 5777:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 5778:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 5779: 
 5780:          bottomFlux = - dot(gradh, u2meanBottom);
 5781:       } // if imm
 5782: 
 5783:       // Compute w for kb+1 to nvrt-1
 5784:       for (int l = kb; l < nvrt - 1; l++) {
 5785: 
 5786:          // normal vector to the top face of the "volumetric" element (3D)
 5787:          Vector3 elem_n2 = elem->n(l + 1, area3D); 
 5788: 
 5789:          // Compute the total flux at the sides
 5790:          double sideFlux = 0.0;
 5791:          Vector2 u2top = {0.0, 0.0};
 5792:          for (int j = 0; j < elem->i34; j++) {
 5793:             const Side *side = elem->sides[j];
 5794: 
 5795:             const double sideArea = side->area(l);
 5796:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 5797:             const double sign = elem->ssign[j]; 
 5798: 
 5799:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 5800:          }
 5801:          
 5802:          // Compute the horizontal velocity at the center of the top face as an average of the 
 5803:          //velocities at the centers of the sides
 5804:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 5805: 
 5806:          // The flx at the top ace can be computed from the other flows.
 5807:          const double topFlux = - sideFlux - bottomFlux;
 5808:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 5809: 
 5810:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 5811: 
 5812:          elem_n1 = elem_n2;
 5813: 
 5814:          bottomFlux = - topFlux;
 5815:       }
 5816:    }  
 5817: 
