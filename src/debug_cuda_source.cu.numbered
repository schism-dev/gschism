 1749: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1750:    // Computes the 3D normal vector to the element at level k
 1751:    // Returns the normal vector and the area of the element
 1752: 
 1753:       if (isTri()) {
 1754:          // For triangles...
 1755: 
 1756:          // Gets the normal vector to the element (with a length equal to twice the area)
 1757:          if constexpr(ics==1) {
 1758:             const int kb0 = max(k, nodes[0]->kb);
 1759:             const int kb1 = max(k, nodes[1]->kb);
 1760:             const int kb2 = max(k, nodes[2]->kb);
 1761: 
 1762:             const Vector3 n20 = nodes[2]->p3D(k) - nodes[0]->p3D(k);
 1763:             const Vector3 n10 = nodes[1]->p3D(k) - nodes[0]->p3D(k);
 1764:             
 1765:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1766:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1767:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1768:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1769: 
 1770:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1771:             area3D = 0.5*len;
 1772: 
 1773:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1774: 
 1775:             return {nx/len, ny/len, nz/len};
 1776: 
 1777:            
 1778:          }
 1779:          else {  // lat/lon
 1780:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1781: 
 1782:          } // if ics
 1783:       }
 1784:       else {
 1785:          // For quads...
 1786: 
 1787:          assert(false && "Element normal vector: quads not yet implemented");
 1788: 
 1789: 
 1790:       }
 1791:    }
 1792: 
 1793: /**
 1794:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1795:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1796:    If the segment is completely inside the element, then it returns true.
 1797: 
 1798:    This function assumes:
 1799:    - The initial point is on a side of the element. 
 1800:    - Its position is given by parameter t in the range [0,1].
 1801:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1802:       intersects the element (elements are convex).
 1803: 
 1804:    To find the intersection point, this function does the following:
 1805:    - it finds the intersection of the line segment with all the element side lines,
 1806:       except for the one that contains the initial point.
 1807:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1808:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1809:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1810:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1811:       track segment is almost parallel to the element side line.
 1812: 
 1813:    Inputs:
 1814:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1815:    @param x2, y2: other end of the line segment
 1816: 
 1817:    Outputs:
 1818:    @param side:  side that intersects the line segment (input and output)
 1819:    @param nextElement (output): element that contains the intersection point
 1820:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1821:    @param zint (input/output): Vertical coordinate of the intersection point
 1822: 
 1823:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1824:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1825:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1826: 
 1827:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1828:    (Delta) being zero.
 1829: 
 1830:    The intersection2 point happens when:
 1831:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1832:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1833:    
 1834:    Assumption: the 4 points (including those of the side segment) are different.
 1835:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1836:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1837:    If true, (xIntersect,yIntersect) is the intersection.				
 1838:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1839: **/
 1840: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1841:                                               double &t, double& tIntersect) {
 1842: 
 1843:    double closest_intersect_t = 1e10;
 1844:    bool found_intersection = false;
 1845: 
 1846:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1847:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1848:    const Point2 x1 = side->point(t);
 1849:    
 1850: 
 1851:    Side *nextSide = nullptr;
 1852:    for (int i = 0; i < i34; i++) {
 1853: 
 1854:       // Element's i-th side 
 1855:       Side *side2 = sides[i];
 1856: 
 1857:       // Skip the side that contains the initial point
 1858:       if (side2 == side) continue;
 1859: 
 1860:       // (x3,y3)-(x4,y4) is the element side line
 1861:       const Point2 x3 = side2->n1->p;
 1862:       const Point2 x4 = side2->n2->p;
 1863: 
 1864:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1865:       const double delta = cross(x2 - x1, x3 - x4);
 1866: 
 1867:       if (delta != 0.0) {
 1868: 
 1869:          const double delta1 = cross(x3 - x1, x3 - x4);
 1870:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1871: 
 1872:          // Solves the two linear equations for tt1 and tt2
 1873:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1874:          const double tt2 = delta2/delta;
 1875: 
 1876:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1877:             closest_intersect_t = min(closest_intersect_t, tt1);
 1878:             nextSide = side2;
 1879: 
 1880:             nextElement = nextSide->otherElem(this);
 1881:             tIntersect = max(small, min(tt1, 1.0-small));
 1882:             t = tt2;
 1883: 
 1884:             found_intersection = true;
 1885:          }
 1886:       
 1887:       }
 1888: 
 1889:    }
 1890: 
 1891:    // found_intersection should always be true, since we checked all the sides.  
 1892:    side = nextSide;
 1893: 
 1894:    return found_intersection;
 1895: }
 1896: 
 1897: 
 1898: 
 1899: 
 1900: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1901:                                               double &t, double& tIntersect) {
 1902: 
 1903:    double closest_intersect_t = 1e10;
 1904:    bool found_intersection = false;
 1905: 
 1906:    for (int i = 0; i < i34; i++) {
 1907: 
 1908:       Side *side2 = sides[i];
 1909: 
 1910:       // (x3,y3)-(x4,y4) is the element side line
 1911:       const Point2 x3 = side2->n1->p;
 1912:       const Point2 x4 = side2->n2->p;
 1913: 
 1914:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1915:       const double delta = cross(x2 - x1, x3 - x4);
 1916: 
 1917:       if (abs(delta) > 0) {
 1918: 
 1919:          const double delta1 = cross(x3 - x1, x3 - x4);
 1920:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1921: 
 1922:          // Solves the two linear equations for tt1 and tt2
 1923:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1924:          const double tt2 = delta2/delta;
 1925: 
 1926:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1927:             closest_intersect_t = min(closest_intersect_t, tt1);
 1928:             side = side2;
 1929:             nextElement = side->otherElem(this);
 1930:             t = tt2;
 1931:             tIntersect = max(small, min(tt1, 1.0-small));
 1932:             found_intersection = true;
 1933:          }
 1934:       
 1935:       }
 1936:       else {  // parallel segments
 1937:          assert(false && "Parallel segments");
 1938:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1939:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1940: 
 1941:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1942: 
 1943:          // const double dist = dot(x1 - x3, side2->n);
 1944:          // if (abs(dist) < small*length(x3 - x4)) {
 1945:          //    const double2 unitarySide = normalize(x4 - x3);
 1946:          //    const double len = dot(x2 - x1, unitarySide);
 1947:          //    t = t + len;
 1948:          //    t = max(0.0, min(t, 1.0));
 1949:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1950: 
 1951: 
 1952:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1953:          //    // t = tt2;
 1954:          //    found_intersection = true;
 1955:          // }
 1956:       }
 1957: 
 1958: 
 1959:    }
 1960: 
 1961:       
 1962:    assert(found_intersection && "No intersection found");
 1963: 
 1964:    // found_intersection should always be true, since we checked all the sides.  
 1965:    return found_intersection;
 1966: }
 1967: 
 1968: 
 1969: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1970:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1971: 
 1972:    printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 1973: 
 1974:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1975:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1976:    // curElement.
 1977: 
 1978:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1979:    // And uses this velocity instead to continue the tracking.
 1980: 
 1981:    // computes the intersection point in cartesian coordinates
 1982:    Point2 intersection = nextSide->p_t(tt);
 1983: 
 1984:    // Nudges the point to the barycenter of the element. 
 1985:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1986:    // next segment intersects the element sides.  
 1987:    curElem->nudgeToBarycenter(intersection);
 1988: 
 1989:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1990:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1991:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1992:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1993: 
 1994:    // If the side is an open boundary, the tangential velocity is zero.
 1995:    if (nextSide->isBnd()) vtan = 0.0;
 1996: 
 1997:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1998:    const double us = vtan*nextSide->t().x;
 1999:    const double vs = vtan*nextSide->t().y;
 2000:    const double ws = 0.5*(nextSide->n1->w2[jlev] + nextSide->n2->w2[jlev]);
 2001: 
 2002:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 2003:    const double len2 = norm2(intersection - toPoint2(xt));
 2004:    const double vel2 = dot(u_int, u_int);        
 2005:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 2006:    else            dt = 0.0;
 2007: 
 2008:    // The end of this tracking segment is now the intersection point.
 2009:    xt = {intersection.x, intersection.y, zint};
 2010: 
 2011:    u_int = {us, vs, ws};
 2012:    
 2013: }
 2014: 
 2015: /**
 2016:  * Tracks a particle through elements and vertical levels in the mesh.
 2017:  * 
 2018:  * @param x0,y0,z0     Starting position coordinates
 2019:  * @param xt,yt,zt     Target position coordinates
 2020:  * @param dtb          Time step for tracking
 2021:  * @param uuint,vvint,wwint Initial velocity components
 2022:  * @param nextElem     Starting/resulting element index
 2023:  * 
 2024:  * @return Status code of type trackExitCodes
 2025:  * 
 2026:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2027:  * of the details are different. The idea is that the code requires less branches and is better fit
 2028:  * for GPU execution.
 2029:  * 
 2030:  * The main ideas here are:
 2031:  * - The starting point is expected to be in the starting element.
 2032:  * - The end point is guaranteed to be inside an element.
 2033:  * - since the starting point is inside the element, there are only two cases: 
 2034:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2035:  *     (b) it does not and (xt,yt) is already in the starting element.
 2036:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2037:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2038:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2039:  * - tt1 can be positive or negative. We only consider the positive values.
 2040:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2041:  * - The next intersection will occur at the smallest positive tt1.
 2042:  * - This intersection will be the next (x0,y0) position.
 2043:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2044:  *   of getting stuck in a loop.
 2045:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2046:  *   was found.
 2047:  */
 2048: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2049:                                                        Element *&nextElem, int &jlev, double &dt,
 2050:                                                        const Side *origSide) {
 2051: 
 2052: 
 2053: 
 2054:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2055:    // else to do.
 2056:    // If it is, nudges the point to be inside the element.
 2057:    const Element *curElem = nextElem;
 2058:    if (containsPoint(toPoint2(xt), true)) {
 2059: 
 2060:       curElem->interpolateVelocities(xt, u_int);
 2061: 
 2062: addDebugPlot(x0, xt);
 2063:       return true;
 2064:    }
 2065: 
 2066:    Side *side = nullptr;
 2067: 
 2068:    // 1. Initial checks
 2069:    // Verify starting element is valid (wet)
 2070:    assert(!curElem->isDry && "Starting element is dry");
 2071: 
 2072:    // Checks if track has a zero length.
 2073:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 2074:    // assert(len2 > 0.0 && "Zero length track"); 
 2075:    
 2076:    const int MAX_ITERATIONS = 1000;
 2077:    
 2078:    double t;
 2079:    Side *nextSide = nullptr;
 2080:    double tIntersect = 1e10;
 2081:    double zint = x0.z;
 2082: 
 2083:    // Horizontal tracking loop
 2084:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2085:    // (x0,y0) is inside the element but the target point is not.
 2086: 
 2087:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2088: 
 2089:    assert(found_intersection && "No intersection found at %d");
 2090: 
 2091:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2092: 
 2093:    // if the tracking segment goes out of water (either dry or edge boundary)
 2094:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2095: 
 2096: addDebugPlot(x0, xt, 0x00A0FF);
 2097:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 2098: addDebugPlot(x0, xt, 0x00A0FF);      
 2099: 
 2100:       nextElem = this;
 2101:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2102:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2103:       return true;    
 2104:    }
 2105: 
 2106: 
 2107:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 2108:    int iterations = 0;
 2109:    while (iterations < MAX_ITERATIONS) {
 2110:       iterations++;
 2111:       
 2112:       Element *curElem = nextElem;
 2113: 
 2114:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2115: addDebugPlot(x0, xt);
 2116:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2117: 
 2118:       // If we are already in the target element, we are done.
 2119:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 2120:       if (!found_intersection) break;
 2121: 
 2122: 
 2123: 
 2124:       // if the tracking segment goes out of water (either dry or edge boundary).
 2125:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2126: addDebugPlot(x0, xt, 0x00A0FF);
 2127:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 2128: addDebugPlot(x0, xt, 0x00A0FF);   
 2129:          nextElem = curElem;
 2130: 
 2131:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 2132:          // In this case, the caller (btrack) needs to take into account the remaining time.
 2133:          return true;
 2134:       }
 2135:       
 2136:       // Update position and element for next iteration
 2137:       side = nextSide;
 2138: 
 2139:    }
 2140: 
 2141:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 2142: 
 2143:  
 2144:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2145:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2146: addDebugPlot(x0, xt);   
 2147:    nextElem->interpolateVelocities(xt, u_int); 
 2148: 
 2149:    return true;
 2150: }
 2151: 
 2152: 
 2153: __inline__ __device__ double Element::computeSignedArea(void) const {
 2154:    // Compute the area of the element
 2155: 
 2156:    double res = signedArea(nodes[0]->p, nodes[1]->p, nodes[2]->p);
 2157: 
 2158:    // In the quad case we need to add the area of the other triangle.
 2159:    if (isQuad()) {
 2160:       double ar1 = signedArea(nodes[0]->p, nodes[2]->p, nodes[3]->p);
 2161:       double ar2 = signedArea(nodes[0]->p, nodes[1]->p, nodes[3]->p);
 2162:       double ar3 = signedArea(nodes[1]->p, nodes[2]->p, nodes[3]->p);
 2163:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2164: 
 2165:       res += ar1;
 2166:    }
 2167: 
 2168:    return res;
 2169: }
 2170: 
 2171: 
 2172: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2173:                                                                 (nodes[1]->isDry2()) ||
 2174:                                                                 (nodes[2]->isDry2()) ||
 2175:                                                                 (i34==4 && nodes[3]->isDry2());
 2176: }
 2177: 
 2178: __inline__ __device__ double Element::detJ_eta(void) const {
 2179:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2180:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2181: }
 2182: 
 2183: __inline__ __device__ double Element::detJ_xi(void) const {
 2184:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2185:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2186: }
 2187: 
 2188: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2189:    // In boundary sides, the element 1 is nullptr
 2190:    return side->elems[1] == nullptr; 
 2191: }
 2192: 
 2193: 
 2194: 
 2195: /**
 2196:    Compute the shape coordinates of the point (xt,yt) in the element.
 2197:    @param xt (input): x-coordinate of the point
 2198:    @param shpCoords (output): shape coordinates of the point
 2199:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2200:    @return true if the point is inside the element, false otherwise
 2201: **/
 2202: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2203:                                             bool fixNegshpCoord) const {
 2204: 
 2205:    // Compute the shape coordinates of the point xt in the element.
 2206:    if (i34==3) {
 2207:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2208:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2209:       // and in this case, the pt will be nudged into the element
 2210:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2211:       // from the local frame, so use additional check.
 2212: 
 2213:       Point2 x0, x1, x2;
 2214: 
 2215:       if constexpr(ics==1) {
 2216:          x0 = nodes[0]->p;
 2217:          x1 = nodes[1]->p;
 2218:          x2 = nodes[2]->p;
 2219:       }
 2220:       else // lat/lon
 2221:       {
 2222:          Error("Not implemented yet");
 2223: #ifdef ICS2
 2224:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2225:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2226:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2227: #endif
 2228:       }
 2229: 
 2230:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2231:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2232:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2233:       shpCoords[3] = 0.0;
 2234:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2235: 
 2236:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2237:       // then we fix the negative shape coordinates.
 2238:       if (fixNegshpCoord && tmpmin<=0.0) {
 2239: 
 2240:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2241:          // keeping the sum of the shape coordinates equal to 1.
 2242:          // I have tested and compared the new algorithm with the old one, and they give
 2243:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2244:          // The new algorithm should be faster since it is branchless.
 2245:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2246:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2247:          
 2248:          shpCoords[0] = (shpCoords[0] + a)*b;
 2249:          shpCoords[1] = (shpCoords[1] + a)*b;
 2250:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2251: 
 2252:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2253:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2254:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2255:          }
 2256: 
 2257:          // Update the point coordinates for the new shape coordinates
 2258:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2259:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2260:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2261: 
 2262:       }
 2263: 
 2264:       // Check if the point is inside the element
 2265:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2266:    }
 2267:    else {
 2268:       Error("Not implemented yet");
 2269: #ifdef QUADS
 2270:       // Reproject pt in eframe of nel for ics=2
 2271:       if constexpr(ics==1) {
 2272:          xn2 = xt; 
 2273:          yn2 = yt;
 2274:       }
 2275:       else {
 2276:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2277:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2278:       }
 2279: 
 2280:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2281: #endif
 2282:    }
 2283: 
 2284:    return false;  // Never reached
 2285: 
 2286: }
 2287: 
 2288: 
 2289: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2290: // Convert shape coordinates to cartesian coordinates
 2291: 
 2292:    if (i34 == 3) {
 2293:       // Triangular element
 2294:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2295:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2296:    }
 2297:    else {
 2298:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2299:    }
 2300: 
 2301: }
 2302: 
 2303: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2304:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2305:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2306:    // The formula for the integral is:
 2307:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2308: 
 2309:    printf("intPhiPhi: TEST\n");
 2310: 
 2311:    const Node *n0 = nodes[0];
 2312:    const Node *n1 = nodes[1];
 2313:    const Node *n2 = nodes[2];
 2314:    const Node *n3 = nodes[3];
 2315: 
 2316:    const Vector2 p0 = n0->p;
 2317:    const Vector2 p1 = n1->p;
 2318:    const Vector2 p2 = n2->p;
 2319:    const Vector2 p3 = n3->p;
 2320: 
 2321:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2322:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2323:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2324:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2325: 
 2326:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2327: }
 2328:    
 2329: 
 2330: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2331:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2332:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2333:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2334:    // The formula is also based on the identity:
 2335:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2336:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2337: 
 2338:    printf("intGradPhiGradPhi: TEST\n");   
 2339: 
 2340:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2341: 
 2342:    const double x0 = nodes[0]->p.x;
 2343:    const double y0 = nodes[0]->p.y;
 2344:    const double x1 = nodes[1]->p.x;
 2345:    const double y1 = nodes[1]->p.y;
 2346:    const double x2 = nodes[2]->p.x;
 2347:    const double y2 = nodes[2]->p.y;
 2348:    const double x3 = nodes[3]->p.x;
 2349:    const double y3 = nodes[3]->p.y;
 2350: 
 2351:    double res = 0.0;
 2352:    
 2353:    // Quadrature points in xi and eta coordinates
 2354:    #pragma unroll
 2355:    for (int i = 0; i < 4; i++) {
 2356:       // For each quadrature point...
 2357: 
 2358:       const Point2 p = GaussPoint(i);
 2359:       const double eta = p.x;
 2360:       const double xi  = p.y;
 2361: 
 2362:       // Jacobian entries at the Gauss point p
 2363:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2364:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2365:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2366:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2367: 
 2368:       const double detJ = jacobianDet(p);
 2369:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2370: 
 2371:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2372:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2373:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2374:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2375:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2376: 
 2377:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2378:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2379:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2380:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2381:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2382: 
 2383:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2384:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2385:    }
 2386: 
 2387:    return res;
 2388: }
 2389: 
 2390: 
 2391: /**  Interpolate velocities at a given point (xt,yt,zt)
 2392: 
 2393:    @param xt, yt, zt: coordinates of the point to interpolate
 2394:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2395: 
 2396:    This is done in four steps:
 2397: 
 2398:    1. Find the shape coordinates for the final position in the element.
 2399:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2400:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2401:       z levels at xt, yt at each step.   
 2402:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2403:       horizontally and vertically.
 2404: **/
 2405: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2406:    // Interpolate the velocities at the point xt. 
 2407:    // This function works the same for triangular and quadrilateral elements.
 2408:    double shpCoord[4];
 2409: 
 2410:    // First step is to compute the shape coordinates of (xt,yt)
 2411:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2412:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2413: 
 2414:    // Second step is to find the level that contains zt
 2415:    // Uses a binary search to find the level
 2416:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2417:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2418:    int R = nvrt - 1;
 2419: 
 2420:    // Get the z coordinates at the nodes of the element at the levels L and R
 2421:    double zLAtNodes[4], zRAtNodes[4];
 2422:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2423:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2424: 
 2425:    double zL = interpolate(shpCoord, zLAtNodes);
 2426:    double zR = interpolate(shpCoord, zRAtNodes);
 2427:    
 2428:    // Interpolates vertically the velocities
 2429:    double wght1, wght2;
 2430:    if (xt.z<=zL) {
 2431:       wght1 = 1.0;
 2432:       wght2 = 0.0;
 2433:    }
 2434:    else if (xt.z>=zR) {
 2435:       wght1 = 0.0;
 2436:       wght2 = 1.0;
 2437:    }
 2438:    else {
 2439:       // Perform a binary search to find the levels between L and R that contain xt.z
 2440:       while (R - L > 1) {
 2441:          int M = (L + R) / 2;
 2442: 
 2443:          double zMAtNodes[4];
 2444:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2445:          double zM = interpolate(shpCoord, zMAtNodes);
 2446:          if (zM < xt.z) 
 2447:          {
 2448:             L = M;
 2449:             zL = zM;
 2450:          }
 2451:          else 
 2452:          {
 2453:             R = M;
 2454:             zR = zM;
 2455:          }
 2456:       }
 2457:       assert(L == R-1);
 2458:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2459: 
 2460:       wght2 = (xt.z - zL)/(zR - zL);
 2461:       wght1 = 1.0 - wght2;
 2462:    }
 2463: 
 2464:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2465:    u_int = wght1*interpolate(L, shpCoord, &Node::uvw2) + wght2*interpolate(R, shpCoord, &Node::uvw2);
 2466: 
 2467:    // Neither of the interpolated velocities should be NaN
 2468:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2469: 
 2470: }
 2471: 
 2472: 
 2473: 
 2474: 
 2475: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2476: 
 2477:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2478:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2479:    const Node *n1 = side->n1;
 2480:    const Node *n2 = side->n2;
 2481: 
 2482:    bool n1_match = (n1->nodeBnd->segment == segment);
 2483:    bool n2_match = (n2->nodeBnd->segment == segment);
 2484: 
 2485:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2486:    if (n1_match && n2_match) {
 2487:       return 0.5;
 2488:    } else if (n1_match) {
 2489:       return 1.0;
 2490:    } else if (n2_match) {
 2491:       return 0.0;
 2492:    }
 2493: 
 2494:    return 0.0;
 2495: }
 2496: 
 2497: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
