  826:    
  827:    // Elevation boundary condition
  828:    int iettype;  // Type of elevation boundary condition
  829:    double eth;   // Elevation time history
  830: 
  831:    // Flow boundary condition
  832:    double qthcon;  // Flow time history constant
  833:    double vobc1;   // Velocity coefficient 1
  834:    double vobc2;   // Velocity coefficient 2
  835: 
  836:    // Tracer boundary conditions
  837:    // double trobc[natrm];    // Tracer boundary condition nudging factor
  838:    // int  itrtype[natrm];    // Tracer boundary condition type
  839: 
  840:    BoundarySegment(bool _isLand) {
  841:       isLand = _isLand;
  842:       clen = 0.0;
  843:       carea = 0.0;
  844:       ifltype = 0;
  845:       iettype = 0;
  846:       eth = 0.0;
  847:    }
  848: 
  849:    BoundarySegment(void) {
  850:       isLand = false;
  851:       clen = 0.0;
  852:       carea = 0.0;
  853:       ifltype = 0;
  854:       iettype = 0;
  855:       eth = 0.0;
  856:    }
  857: 
  858:    
  859: };
