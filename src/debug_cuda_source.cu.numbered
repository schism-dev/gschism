 2038: 
 2039: __inline__ __device__ Point2 Element::outputCoords(void) const {
 2040:    if constexpr(ics == 1)  {
 2041:       return center;
 2042: 
 2043:    } else {
 2044:       const Point2 p0 = nodes[0]->outputCoords();
 2045:       const Point2 p1 = nodes[1]->outputCoords();
 2046:       const Point2 p2 = nodes[2]->outputCoords();
 2047: 
 2048:       if (isTri()) {
 2049:          return (1.0/3.0)*(p0 + p1 + p2);
 2050: 
 2051:       } else {
 2052:          const Point2 p3 = nodes[3]->outputCoords();
 2053:          return (1.0/4.0)*(p0 + p1 + p2 + p3);
 2054:       }
 2055: 
 2056:    }
 2057: }
