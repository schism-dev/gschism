 2533: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2534:    // Returns the value of the normal component of the velocity at the side center
 2535:    const double w1 = getBoundaryArrayValueWeight();
 2536:    const double w2 = 1.0 - w1;
 2537:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2538:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2539: 
 2540:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2541: }
