 2346: 
 2347: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2348: 
 2349:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2350:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2351:    const Node *n1 = side->n1;
 2352:    const Node *n2 = side->n2;
 2353: 
 2354:    bool n1_match = (n1->nodeBnd->segment == segment);
 2355:    bool n2_match = (n2->nodeBnd->segment == segment);
 2356: 
 2357:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2358:    if (n1_match && n2_match) {
 2359:       return 0.5;
 2360:    } else if (n1_match) {
 2361:       return 1.0;
 2362:    } else if (n2_match) {
 2363:       return 0.0;
 2364:    }
 2365:    return 0.0;
 2366: }
 2367: 
 2368: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2369: 
 2370: 
 2371: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2372: 
 2373:    const double w1 = getBoundaryArrayValueWeight();
 2374:    const double w2 = 1.0 - w1;
 2375:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2376:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2377: 
 2378:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2379: }
 2380: 
 2381: 
 2382: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2383:    const double w1 = getBoundaryArrayValueWeight();
 2384:    const double w2 = 1.0 - w1;
 2385:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2386:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2387: 
 2388:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2389: }
 2390: 
 2391: 
 2392: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2393:    // Returns the value of the velocity at the side center
 2394:    const double w1 = getBoundaryArrayValueWeight();
 2395:    const double w2 = 1.0 - w1;
 2396:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2397:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2398: 
 2399:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2400: }
 2401: 
 2402: 
 2403: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2404:    // Returns the value of the normal component of the velocity at the side center
 2405:    const double w1 = getBoundaryArrayValueWeight();
 2406:    const double w2 = 1.0 - w1;
 2407:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2408:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2409: 
 2410:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2411: }
