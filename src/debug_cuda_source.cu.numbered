 3451: // //                   is used below bottom or above surface.
 3452: // //       ibelow: flag indicating if zt is below za(k1)
 3453: // //
 3454: 
 3455: //    assert(k1 >= 0 && k2 < nvrt && "vertLinearInterp: k1 or k2 out of bounds");
 3456: //    assert(k1 <= k2 && "vertLinearInterp: k1 > k2");
 3457:    
 3458: //    ibelow = 0;
 3459: 
 3460: //    if (zt < za[k1]) {
 3461: //       // Below bottom
 3462: //       ibelow = 1;
 3463: //       s_out = s_in[k1];
 3464: 
 3465: //    } else if(zt>=za[k2]) {
 3466: //       // Above surface
 3467: //       s_out = s_in[k2];
 3468: 
 3469: //    } else {
 3470: //       // Normal case (between bottom and surface)
 3471:       
