 2343: 
 2344: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2345: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2346: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2347: // Only when ics == 2, the origin is at the element center.
 2348: 
 2349:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2350: 
 2351:    const Node *node = nodes[idxNode];
 2352: 
 2353:    if constexpr(ics==1) {
 2354:       return node->p;
 2355: 
 2356:    } else {
 2357:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2358: 
 2359:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2360: 
 2361:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2362:    }
 2363: 
 2364: }
 2365: 
 2366: 
 2367: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2368: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2369: 
 2370:    const int id1 = idx;
 2371:    const int id2 = nxq(1 + id1);
 2372:    const int id3 = nxq(2 + id1);
 2373: 
 2374:    if constexpr(ics==1) {
 2375:       x0 = nodes[id1]->p;
 2376:       x1 = nodes[id2]->p;
 2377:       x2 = nodes[id3]->p;
 2378: 
 2379:    } else {
 2380:       const Frame dstFrame = frame;  // I'm writing it this way in case I need to change the frame to another one later.
 2381: 
 2382:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2383: 
 2384:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2385:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2386:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2387: 
 2388:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2389:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2390:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2391: 
 2392:    }
 2393: 
 2394: }
 2395: 
 2396: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const {
 2397: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2398: 
 2399:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2400: 
 2401: 
 2402: 
 2403:    if constexpr(ics==1) {
 2404:       x0 = nodes[0]->p;
 2405:       x1 = nodes[1]->p;
 2406:       x2 = nodes[2]->p;  
 2407:       x3 = nodes[3]->p;
 2408: 
 2409:    } else {
 2410:       const Frame dstFrame = frame;  // I'm writing it this way in case I need to change the frame to another one later.
 2411: 
 2412:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2413: 
 2414:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2415:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2416:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2417:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2418: 
 2419:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2420:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2421:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2422:       x3 = toVector2(dstFrame.G2L(p3 - c));
 2423:    }
 2424: 
 2425: }
 2426: 
 2427: 
 2428: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2429: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2430: // Returns the normal vector and the area of the element at this level
 2431:    
 2432:    double nx, ny, nz;
 2433: 
 2434:    if (isTri()) {
 2435:       // For triangles...
 2436: 
 2437:       // Indices of the nodes at level k, taking care of not going below the bed
 2438:       const int k0 = max(k, nodes[0]->kb);
 2439:       const int k1 = max(k, nodes[1]->kb);
 2440:       const int k2 = max(k, nodes[2]->kb);
 2441: 
 2442:       // Gets the element frame coordinates of the nodes at level k
 2443:       Point3 x0, x1, x2;
 2444:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2445:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2446:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2447:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2448: 
 2449:       } else {  // ics == 2
 2450:          Point2 h0, h1, h2;
 2451: 
 2452:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2453: 
 2454:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2455:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2456:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2457:       }
 2458: 
 2459:       const Vector3 n20 = x2 - x0;
 2460:       const Vector3 n10 = x1 - x0; 
 2461: 
 2462:       // Computes the cross product of vectors n20 and n10. 
 2463:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2464:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2465:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2466: 
 2467:   
 2468:    }
 2469:    else {
 2470:       // For quads...
 2471:       Point2 h0, h1, h2, h3;
 2472: 
 2473:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2474: 
 2475:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2476:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2477:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k] - nodes[0]->z[k]);
 2478:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k] - nodes[1]->z[k]);
 2479: 
 2480:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2481:       nx = n20.y*n31.z - n20.z*n31.y;
 2482:       ny = n20.z*n31.x - n20.x*n31.z;
 2483:       nz = n20.x*n31.y - n20.y*n31.x;
 2484: 
 2485:    }
 2486: 
 2487:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2488:    area3D = 0.5*len;
 2489: 
 2490:    const double inv_len = 1.0/len;
 2491: 
 2492:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2493: 
 2494: }
 2495: 
 2496: 
 2497: // Helper functions to get the 2D local node position for the Celestial walk
 2498: __device__ __forceinline__ Point2 Element::getLocalNodePosition(int idx, const Side* origSide) const {
 2499:    const int idx2 = (isTri() && idx == 3) ? 2 : idx;
 2500:    const Node *node = getNodeInOrder(idx2);
 2501: 
 2502:    double z = 0.0;
 2503:    if constexpr(ics == 2) z = node->gz;
 2504:    
 2505:    Point3 p = toPoint3(node->p, z);
 2506: 
 2507:    return toPoint2(origSide->toLocalFrame(p));
 2508: }
 2509: 
 2510: __device__ __forceinline__ Node *Element::getNodeInOrder(int idx) const {
 2511:    return (ssign[idx] > 0) ? sides[idx]->n1 : sides[idx]->n2;
 2512: }
 2513: 
 2514: __device__ __forceinline__ void Element::computePredicates(const Point2 x0, const Point2& xt, double &fac, const Side* origSide,
 2515:                                 Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector, int jlev) const
 2516: // Computes the three per-side predicates needed for the celestial walk
 2517: // (Kuijper, Ermolaev, Devillers, JCGT 7(3), 2018, arXiv:1710.01620).
 2518: //
 2519: // xt is in local frame coordinates for origSide if ics == 2.
 2520: //
 2521: // All work is done unconditionally on 4 sides to keep CUDA threads uniform.
 2522: // For triangles, side 3 is a sentinel: getNode(3) returns getNode(2), making
 2523: // corners[3] == corners[2] and s3 == (0, 0). Predicates that would be
 2524: // meaningless on triangles are masked to a safe value (see comments below).
 2525: {
 2526:    // Project all 4 corner positions once into the local 2D frame.
 2527:    // For triangles, C[3] == C[2] (no garbage, but geometrically degenerate).
 2528:    // getLocalNodePosition only transforms/projects if ics == 2.
 2529:    const Point2 C[4] = {getLocalNodePosition(0, origSide), 
 2530:                         getLocalNodePosition(1, origSide), 
 2531:                         getLocalNodePosition(2, origSide), 
 2532:                         getLocalNodePosition(3, origSide)};
 2533: 
 2534:    // Computes the maximum distance from the starting point to the farthest element node projected on the segment x0xt.
 2535:    // This has nothing to do with the original celestial walk. It is used in the Leaded Celestial 
 2536:    //Walk algorithm to find a point on the segment x0xt that is as close as possible to the starting point,
 2537:    // But still farther towards the target point from the current point.
 2538:    const Vector2 vt0 = xt - x0;
 2539:    double maxProjDist = max(dot(vt0, C[0] - x0), dot(vt0, C[1] - x0));
 2540:    maxProjDist = max(maxProjDist, dot(vt0, C[2] - x0)); 
 2541:    maxProjDist = isQuad() ? max(maxProjDist, dot(vt0, C[3] - x0)) : maxProjDist;
 2542: 
 2543:    fac = max(1.00001*fac, min(1.0, (maxProjDist/dot(vt0, vt0))*1.00001));
 2544:    const Vector2 ixt = x0 + (xt - x0)*fac;
 2545: 
 2546: 
 2547: // if (origSide->idx == 2860848 && jlev == 46) {
 2548: // showPoints(toPoint3(x0,0.0), toPoint3(xt,0.0), jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2549: // showPoints(toPoint3(ixt,0.0), toPoint3(ixt,0.0), jlev, origSide, 0x00FF00u, 'o', 1, 0, 0);
 2550: // printf("this->idx = %d, origSide->idx = %d, ixt = (%.17f, %.17f), x0 = (%.17f, %.17f), xt = (%.17f, %.17f), fac = %.17f\n", this->idx, origSide->idx, ixt.x, ixt.y, x0.x, x0.y, xt.x, xt.y, fac);
 2551: // }
 2552:    // Side I goes from corners[I] to corners[nxq(I+1)] in CCW perimeter order.
 2553:    // (Note: with corners built from getNode in CCW order, no ssign factor is needed
 2554:    //  here the orientation is baked into the corners array.)
 2555:    const int i3 = nxq(3);
 2556:    const Vector2 s0 = C[ 1] - C[ 0];
 2557:    const Vector2 s1 = C[ 2] - C[ 1];
 2558:    const Vector2 s2 = C[i3] - C[ 2];
 2559:    const Vector2 s3 = C[ 0] - C[i3];
 2560:    
 2561:    // Side I goes from C[I] to C[nxq(I+1)] in CCW perimeter order.
 2562:    // The corners array is built from getNode in CCW order, so the orientation
 2563:    // is already correct and no ssign factor is needed in the formulas below.
 2564:    //
 2565:    // i3 = nxq(3): the index of the corner after side 2.
 2566:    //   Triangle: i3 == 0 (the closing corner of the triangle).
 2567:    //   Quad:     i3 == 3.
 2568:    //
 2569:    // The four side direction vectors. For triangles, s3 == (0, 0) since
 2570:    // C[i3] == C[0] (the perimeter has already closed by side 2).
 2571:    isLeft.set(0,  cross(s0, ixt - C[ 0]) > -small);
 2572:    isLeft.set(1,  cross(s1, ixt - C[ 1]) > -small);
 2573:    isLeft.set(2,  cross(s2, ixt - C[ 2]) > -small);
 2574:    isLeft.set(3, (cross(s3, ixt - C[i3]) > -small) || isTri());  
 2575: 
 2576: // printf("idx = %d, cross(s0, xt - C[ 0] ) = %.17f, cross(s1, xt - C[ 1] ) = %.17f, cross(s2, xt - C[ 2] ) = %.17f, cross(s3, xt - C[i3] ) = %.17f\n", idx, cross(s0, xt - C[ 0] ), cross(s1, xt - C[ 1] ), cross(s2, xt - C[ 2] ), cross(s3, xt - C[i3] ));
 2577: 
 2578:    // For triangles, the corner after side 2 is the closing corner where
 2579:    // side 2 meets side 0 (not side 3, which doesn't exist). The "next side
 2580:    // tangent" used by isObtuse and isBisector at that corner is therefore
 2581:    // s0 for triangles, s3 for quads.
 2582:    const Vector2 s3_tri = isTri() ? s0 : s3;
 2583: 
 2584:    // isObtuse.b[I]: true iff the internal face angle at the corner after
 2585:    // side I is obtuse. Equivalent to dot of consecutive side directions > 0
 2586:    // (acute "turn angle" along the perimeter = obtuse internal angle).
 2587:    //
 2588:    // isObtuse.b[3] for triangles: dot(s3, s0) = dot(0, s0) = 0, so the
 2589:    // result is false naturally. No sentinel needed.
 2590:    isObtuse.set(0, dot(s0, s1) > 0.0);
 2591:    isObtuse.set(1, dot(s1, s2) > 0.0);
 2592:    isObtuse.set(2, dot(s2, s3_tri) > 0.0);  // triangle: closes back to s0
 2593:    isObtuse.set(3, dot(s3, s0) > 0.0);  // Always false for triangles (s3=(0,0))
 2594: 
 2595:    // isBisector.b[I]: at the corner after side I, this tests whether xt is
 2596:    // on the "exit through side I" half of the corner cone, separated by the
 2597:    // approximate angular bisector of the celestial walk. The bisector is
 2598:    // perpendicular to the chord across the corner; the test is the sign of
 2599:    // (xt - corner_vertex) projected onto that chord.
 2600:    //
 2601:    // isBisector.b[3] is always masked out by isLeft.b[3] = true for triangles
 2602:    // (the validity rule sets valid_3 = false), so its computed value for
 2603:    // triangles doesn't matter. No sentinel needed.
 2604:    isBisector.set(0, dot(ixt - C[ 1], s0 + s1) < 0.0);
 2605:    isBisector.set(1, dot(ixt - C[ 2], s1 + s2) < 0.0);
 2606:    isBisector.set(2, dot(ixt - C[i3], s2 + s3_tri) < 0.0);
 2607:    isBisector.set(3, dot(ixt - C[ 0], s3 + s0) < 0.0);   
 2608: 
 2609: }
 2610: 
 2611: 
 2612: __inline__ __device__ double Element::computeSignedArea(void) const {
 2613:    // Compute the area of the element
 2614: 
 2615:    Point2 x0, x1, x2, x3;
 2616:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2617: 
 2618: 
 2619:    double res = signedArea(x0, x1, x2);
 2620: 
 2621:    // In the quad case we need to add the area of the other triangle.
 2622:    if (isQuad()) {
 2623:       x3 = getLocalHorizontalNodePosition(3);
 2624:       double ar1 = signedArea(x0, x2, x3);
 2625:       double ar2 = signedArea(x0, x1, x3);
 2626:       double ar3 = signedArea(x1, x2, x3);
 2627:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2628: 
 2629:       res += ar1;
 2630: 
 2631:    }
 2632: 
 2633:    return res;
 2634: }
 2635: 
 2636: 
 2637: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2638:                                                                 (nodes[1]->isDry2()) ||
 2639:                                                                 (nodes[2]->isDry2()) ||
 2640:                                                                 (isQuad() && nodes[3]->isDry2());
 2641: }
 2642: 
 2643: __inline__ __device__ double Element::detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2644:    return (1.0/8.0)*((x1.x - x0.x)*(x2.y - x3.y) - (x2.x - x3.x)*(x1.y - x0.y));
 2645: }
 2646: 
 2647: __inline__ __device__ double Element::detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2648:    return (1.0/8.0)*((x2.x - x1.x)*(x3.y - x0.y) - (x3.x - x0.x)*(x2.y - x1.y));
 2649: }
 2650: 
 2651: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2652:    // In boundary sides, the element 1 is nullptr
 2653:    return side->elems[1] == nullptr; 
 2654: }
 2655: 
 2656: __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const {
 2657:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 2658:    // For ics == 2, this function uses local frame coordinates.
 2659: 
 2660:    assert(isQuad());
 2661: 
 2662:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 2663:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 2664:    // where vxi, veta, vb are vectors and c is the center of the element.
 2665: 
 2666:    Point2 p0, p1, p2, p3;
 2667: 
 2668:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 2669: 
 2670:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 2671:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 2672:    // vectors vxi and veta connect the centers of opposite sides
 2673:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 2674:    // vb is zero for parallelogram elements.
 2675:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 2676: 
 2677:    //  The bilinear mapping is:
 2678:    //      P(s,t) = C + s*U + t*V + s*t*W
 2679:    //
 2680:    //  where:
 2681:    //    C = centroid (average of four vertices)
 2682:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 2683:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 2684:    //    W = bilinear correction; measures deviation from parallelogram
 2685:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 2686:    //        W = 0 for parallelogram elements.
 2687:    //
 2688:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 2689:    //
 2690:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 2691:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 2692:    //
 2693:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 2694:    //
 2695:    //  Geometrically, (L) projects everything onto the direction
 2696:    //  perpendicular to W, where the mapping is purely affine.
 2697:    //
 2698:    //  The dot product with nb retains the nonlinear term:
 2699:    //
 2700:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 2701:    //
 2702:    //  Geometrically, (Q) projects onto the W direction, where
 2703:    //  the nonlinearity lives.
 2704:    //
 2705:    //  We solve (L) for whichever variable has the larger coefficient
 2706:    //  (better conditioned back-substitution), substitute into (Q),
 2707:    //  and get a scalar quadratic in the other variable.
 2708:    // ================================================================
 2709: 
 2710:    // ---- Basis vectors ----
 2711:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 2712:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 2713:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 2714:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 2715:    // W: nonlinear correction. Difference between quad and parallelogram.
 2716:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 2717:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 2718: 
 2719:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 2720:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 2721:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 2722:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 2723:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 2724: 
 2725:    // ---- nb: direction parallel to W, L1-normalized ----
 2726:    // We don't need a unit vector -- just a well-scaled direction parallel
 2727:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 2728:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 2729:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 2730:    //
 2731:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 2732:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 2733:    // and the quadratic solver takes its linear path (a ~ 0).
 2734:    const double wlen1 = fabs(vb.x) + fabs(vb.y) + 1e-30;
 2735:    const double inv_wlen = 1.0 / wlen1;
 2736:    const Vector2 nb = vb * inv_wlen;
 2737: 
 2738:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 2739:    // cross(nb, .) projects onto the direction PERPENDICULAR to W.
 2740:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 2741:    // What remains is a pure affine relationship between xi and eta.
 2742:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 2743:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 2744:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 2745: 
 2746:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 2747:    // dot(nb, .) projects onto the W direction, where the nonlinearity lives.
 2748:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 2749:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 2750:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 2751:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 2752:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 2753: 
 2754:    // ---- Solve: pick the better-conditioned variable from (L) ----
 2755:    // Back-substitute from (L) dividing by the LARGER coefficient,
 2756:    // minimizing round-off amplification.
 2757:    //
 2758:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 2759:    // that uses predicated moves.
 2760:    //
 2761:    // if (fabs(Ls) > fabs(Lt)) {
 2762:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 2763:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 2764:    //    // Substitute into (Q), multiply by Ls, group by eta:
 2765:    //    const double A = -Qw * Lt;
 2766:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 2767:    //    const double C =  Qs * Lp - Qp * Ls;
 2768: 
 2769:    //    double eta1, eta2;
 2770:    //    solveQuadratic(A, B, C, eta1, eta2);
 2771: 
 2772:    //    // Pick root with smaller |eta| (domain centered at 0).
 2773:    //    // Ternary-> predicated move, no branch divergence.
 2774:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 2775: 
 2776:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 2777:    //    xi = (Lp - Lt * eta) / Ls;
 2778: 
 2779:    // } else {
 2780:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 2781:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 2782:    //    // Substitute into (Q), multiply by Lt, group by xi:
 2783:    //    const double A = -Qw * Ls;
 2784:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 2785:    //    const double C =  Qt * Lp - Qp * Lt;
 2786: 
 2787:    //    double xi1, xi2;
 2788:    //    solveQuadratic(A, B, C, xi1, xi2);
 2789: 
 2790:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 2791: 
 2792:    //    eta = (Lp - Ls * xi) / Lt;
 2793:    // }
 2794:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 2795:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 2796:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 2797:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 2798:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 2799: 
 2800:    // Quadratic:  A*r^2 + B*r + C = 0
 2801:    // (same formula for both cases, just with swapped coefficients)
 2802:    const double A = -Qw * Lb;
 2803:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 2804:    const double C =  Qa * Lp - Qp * La;
 2805: 
 2806:    double r1, r2;
 2807:    solveQuadratic(A, B, C, r1, r2);
 2808: 
 2809:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 2810:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 2811: 
 2812:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 2813:    const double other = (Lp - Lb * r) / La;
 2814: 
 2815:    // Assign to (xi, eta) depending on which variable the quadratic solved
 2816:    xi  = solve_s ? r     : other;
 2817:    eta = solve_s ? other : r;
 2818: 
 2819: 
 2820:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 2821:    xi  = clamp(xi,  -1.0, 1.0);
 2822:    eta = clamp(eta, -1.0, 1.0);
 2823: 
 2824:    // ---- Shape functions ----
 2825:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 2826:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 2827:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 2828:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 2829:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 2830:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 2831:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 2832:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 2833: 
 2834:    return true;
 2835: }
 2836: 
 2837: /**
 2838:    Compute the shape coordinates of the point (xt,yt) in the element.
 2839:    @param xt (input): x-coordinate of the point
 2840:    @param shpCoords (output): shape coordinates of the point
 2841:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2842:    @return true if the point is inside the element, false otherwise
 2843: **/
 2844: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 2845: 
 2846:    // Compute the shape coordinates of the point xt in the element.
 2847:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 2848:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 2849:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 2850:    // from the local frame, so use additional check.
 2851: 
 2852: 
 2853: 
 2854:    if (isTri()) { // Triangular element
 2855: 
 2856:       // Horizontal local node coordinates. 
 2857:       // Point2 x0, x1, x2;
 2858:       // getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2859: 
 2860: // XXXXX REWRITE THIS, maybe creating an overloaded version of getLocalHorizontalNodePositionsTri that takes a Side as an argument?
 2861: Point2 x0 = nodes[0]->p;
 2862: Point2 x1 = nodes[1]->p;
 2863: Point2 x2 = nodes[2]->p;
 2864: 
 2865: if constexpr(ics == 2) {
 2866: const Point3 p0 = toPoint3(x0, nodes[0]->gz);
 2867: const Point3 p1 = toPoint3(x1, nodes[1]->gz);
 2868: const Point3 p2 = toPoint3(x2, nodes[2]->gz);
 2869: x0 = toPoint2(origSide->toLocalFrame(p0));
 2870: x1 = toPoint2(origSide->toLocalFrame(p1));
 2871: x2 = toPoint2(origSide->toLocalFrame(p2));
 2872: }
 2873: 
 2874:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2875:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2876:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2877:       shpCoords[3] = 0.0;
 2878: 
 2879: 
 2880:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2881:       const bool res = (tmpmin >= -small);  
 2882:       
 2883:       // When to fix the negative shape coordinates?
 2884:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2885: 
 2886:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2887:       // then we fix the negative shape coordinates.
 2888:       if ((tmpmin < 0) && fix) {
 2889: 
 2890:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2891:          // keeping the sum of the shape coordinates equal to 1.
 2892:          // I have tested and compared the new algorithm with the old one, and they give
 2893:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2894:          // The new algorithm should be faster since it is branchless.
 2895:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 2896:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2897: 
 2898:          shpCoords[0] = (shpCoords[0] + a)*b;
 2899:          shpCoords[1] = (shpCoords[1] + a)*b;
 2900:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2901: 
 2902:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2903:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 2904:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 2905: 
 2906:          // Update the point coordinates for the new shape coordinates
 2907:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2908:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2909: 
 2910:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2911: 
 2912:       }
 2913: 
 2914:       // Return true if the point is inside the element
 2915:       return res;      
 2916:    }
 2917:    else {
 2918:       assert(isQuad() && "computeShapeCoords");
 2919: 
 2920:       // Horizontal local node coordinates. 
 2921:       // Point2 x0, x1, x2, x3;
 2922:       // getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 2923: Point2 x0 = nodes[0]->p;
 2924: Point2 x1 = nodes[1]->p;
 2925: Point2 x2 = nodes[2]->p;
 2926: Point2 x3 = nodes[3]->p;
 2927: 
 2928: if constexpr(ics == 2) {
 2929: const Point3 p0 = toPoint3(x0, nodes[0]->gz);
 2930: const Point3 p1 = toPoint3(x1, nodes[1]->gz);
 2931: const Point3 p2 = toPoint3(x2, nodes[2]->gz);
 2932: const Point3 p3 = toPoint3(x3, nodes[3]->gz);
 2933: x0 = toPoint2(origSide->toLocalFrame(p0));
 2934: x1 = toPoint2(origSide->toLocalFrame(p1));
 2935: x2 = toPoint2(origSide->toLocalFrame(p2));
 2936: x3 = toPoint2(origSide->toLocalFrame(p3));
 2937: }
 2938: 
 2939: 
 2940:       const double a0 = signedArea(x0, x1, xt);
 2941:       const double a1 = signedArea(x1, x2, xt);
 2942:       const double a2 = signedArea(x2, x3, xt);
 2943:       const double a3 = signedArea(x3, x0, xt);
 2944: 
 2945:       const double minArea = min4(a0, a1, a2, a3);
 2946:       
 2947:       const bool res = (minArea > -small*area);
 2948: 
 2949:       // When to fix the negative shape coordinates?
 2950:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2951: 
 2952:       double xi, eta;    
 2953: 
 2954:       // Converts the point xt to the element frame coordinates and then to bilinear+shape coordinates.
 2955: Point2 xt_elem = xt;
 2956: if constexpr(ics == 2) {
 2957:    assert(origSide != nullptr);
 2958:    // 1) side local (horizontal) -> global 3D
 2959:    const Point3 p_global =
 2960:       toPoint3(origSide->center, origSide->centerZ())
 2961:       + origSide->frame.L2G(toPoint3(xt, 0.0));
 2962:    // 2) global -> element local horizontal
 2963:    xt_elem = toVector2(toLocalFrame(p_global));
 2964: }
 2965:       inverseBilinearQuad(xt_elem, xi, eta, shpCoords);
 2966: 
 2967:       if (fix) {
 2968:          double xn[4] = {x0.x, x1.x, x2.x, x3.x};
 2969:          double yn[4] = {x0.y, x1.y, x2.y, x3.y};
 2970:          xt.x = interpolate(shpCoords, xn);
 2971:          xt.y = interpolate(shpCoords, yn);
 2972:       }
 2973: 
 2974:       return res;
 2975:    }
 2976: 
 2977: 
 2978:    assert(false && "computeShapeCoords: should never reach this point");
 2979:    return false;  // Never reached
 2980: 
 2981: }
 2982: 
 2983: 
 2984: __device__ __forceinline__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2985: // Convert shape coordinates to cartesian coordinates
 2986: 
 2987:    if (isTri()) {
 2988:       // Triangular element
 2989: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 2990:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2991:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2992:    }
 2993:    else {
 2994:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2995:    }
 2996: 
 2997: }
