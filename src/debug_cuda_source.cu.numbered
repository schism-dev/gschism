 4453:    //          do j=1,nond_global(k)
 4454:    //            icount2=icount2+1
 4455:    //            if(icount2>nnode_fl) call parallel_abort('STEP: wrong counting vel')
 4456: 
 4457:    //            uthnd(1:nvrt,j,k)=(1.d0-rat)*ath2(1,1:nvrt,icount2,1,2)+rat*ath2(1,1:nvrt,icount2,2,2) !ll frame if ics=2
 4458:    //            vthnd(1:nvrt,j,k)=(1.d0-rat)*ath2(2,1:nvrt,icount2,1,2)+rat*ath2(2,1:nvrt,icount2,2,2)
 4459:    //          enddo !j
 4460:    //        endif
 4461:    //      enddo !k
 4462:    //    endif !nfltype2
 4463:    }
 4464: 
 4465: 
 4466:    __global__ void computeFlowBcVelocities(double time) {
 4467: 
 4468:       SIDE_BND(sideBnd);
 4469: 
 4470:       const Side *side = sideBnd->side;
 4471:  
 4472:       const bool isDry = side->isDry;
 4473:       const bool isLand = sideBnd->segment->isLand;
 4474: 
 4475:    
 4476:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4477: 
 4478:       if (isDry || isLand) return;
 4479: 
 4480:       // For wet sides in open boundaries...
 4481:       const Vector2 n = side->n;
 4482:       const BoundarySegment *segment = sideBnd->segment;
 4483: 
 4484:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4485: 
 4486:       const int ifltype = segment->ifltype;
 4487: 
 4488:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4489:       const Vector2 r_nuth0 = r_uth0*n;
 4490: 
 4491: 
 4492:       if (ifltype == 1 || ifltype == 2) {
 4493:       
 4494:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4495: 
 4496:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4497:          
 4498:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4499:          
 4500:       } else if (ifltype == -1) { // Flather 1
 4501: 
 4502:          for (int k = 0; k < nvrt; k++) {
 4503: 
 4504:             // uth is the normal vel.; no ramp up
 4505:             const double uth = sideBnd->nuth(k);
 4506:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4507: 
 4508:             sideBnd->ubc[k] += uth*n;
 4509:          }
 4510: 
 4511:       } else if (ifltype == 3 || ifltype == 5) {
 4512:          // vnth0=0 !normal vel.
 4513: 
 4514:          Vector2 r_u1_bar = {0.0, 0.0};
 4515:          // Computes the contribution to the velocity from all tide frequencies
 4516:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4517: 
 4518:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4519:             const Vector2 umo  = sideBnd->umo(jfr); 
 4520: 
 4521:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4522:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4523:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4524:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4525: 
 4526:          }
 4527: 
 4528: 
 4529:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4530: 
 4531:       } // if (ifltype = 3 || ifltype == 5
 4532: 
 4533: 
 4534: 
 4535:    }
 4536: 
 4537:    __global__ void computeElevationBoundaryConditions(double time) {
 4538:       // Compute elevation essential boundary conditions 
 4539: 
 4540:       NODE_BND(nodeBnd); // Each boundary node.
 4541: 
 4542:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4543: 
 4544:       const Node *node = nodeBnd->node;
 4545:       const BoundarySegment *segment = nodeBnd->segment;
 4546:       const int iettype = segment->iettype;
 4547:       
 4548: 
 4549:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4550:       double eic = 0.0;
 4551:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4552:       else                 eic = 0.0;
 4553: 
 4554:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4555:       const double r_eth = ramp*nodeBnd->eth;
 4556:       double r_eta1_bar = 0.0;
 4557: 
 4558: 
 4559:       // Compute tide elevation
 4560:       if (iettype == 3 || iettype == 5) {   
 4561: 
 4562:          if constexpr(iloadtide==1) { // loading tide
 4563:             assert(false && "Loading tide not implemented");
 4564:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4565:          }
 4566:          
 4567:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4568: 
 4569:             const double efa  = nodeBnd->efa[jfr]; 
 4570:             const double emo  = nodeBnd->emo[jfr]; 
 4571: 
 4572:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4573:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4574:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4575: 
 4576:          } // for jfr
 4577: 
 4578:       } // if iettype
 4579: 
 4580:       switch (iettype) {
 4581:          case 1:
 4582:          case 2:
 4583:          case 4:
 4584:             nodeBnd->elbc = r_eic + r_eth;
 4585:             break;
 4586:          case 3:
 4587:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4588:             break;
 4589:          case 5:
 4590:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4591:             break;
 4592:       } // switch
 4593: 
 4594: 
 4595:       //Add inverse barometric effects
 4596:       if (iettype != 0 && inv_atm_bnd == 1) {
 4597:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4598:       }
 4599: 
 4600:    }
 4601: 
 4602: 
 4603:    __global__ void computeHorizontalViscosity(void) { 
 4604: 
 4605:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4606: 
 4607:       SIDE(side);
 4608: 
 4609:       if (side->isDry) return;
 4610: 
 4611:       for (int k = 0; k < nvrt; k++) {
 4612:          side->nuGradU[k] = {0.0, 0.0};
 4613:       }
 4614: 
 4615:       if constexpr(ihorcon == 1) {
 4616:          for (int k = side->kb; k < nvrt - 1; k++) {
 4617:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4618:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 4619:             // By Zhang and Baptista.
 4620: 
 4621:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4622:             // This is a standard discretization of the Laplacian operator.
 4623:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4624:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4625:             // Gamma is hvis_coef0 in the code.
 4626:             // The value of gamma needs to be < 0.5.
 4627: 
 4628:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4629:             // side under consideration in each of the two possible elements that share the side.
 4630:             Vector2 sumU = {0.0, 0.0};
 4631:             for (int l = 0; l < 2; l++) {
 4632:                const Element *elem = side->elems[l];
 4633: 
 4634:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4635: 
 4636:                // Find the local index of the side in the element
 4637:                const int idxSide = elem->sideLocalIdx(side);
 4638: 
 4639:                // Find the two sides that are connected to the side under consideration
 4640:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 4641:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 4642: 
 4643:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4644: 
 4645:             }
 4646: 
 4647:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4648: 
 4649:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 4650:    
 4651:          }
 4652:       }
 4653:       else if constexpr(ihorcon == 2) {
 4654:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4655:       }
 4656: 
 4657: 
 4658:    }
 4659: 
 4660: 
 4661:    __global__ void setEssentialBC(void) {
 4662:       // Set essential boundary conditions 
 4663:       NODE(node); // Each boundary node
 4664:       NodeBoundary *nodeBnd = node->nodeBnd;
 4665:       
 4666:  
 4667:       // Check if this node has essential BC
 4668:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4669:          // Verify BC value is valid
 4670:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4671: 
 4672:        
 4673:          // Set diagonal to 1 and zero off-diagonals
 4674:          node->coeffDiag = 1.0;
 4675: 
 4676:          for (int j = 0; j < node->numNodes; j++) {
 4677:                node->coeffMatrix[j] = 0.0;
 4678:          }
 4679:          
 4680:          // Set solution and RHS to BC value
 4681:          node->mX  = nodeBnd->elbc;
 4682:          node->qel = nodeBnd->elbc;
 4683: 
 4684:       } else {
 4685:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4686: 
 4687:          for (int j = 0; j < node->numNodes; j++) {
 4688:                Node* nbNode = node->nodes[j];
 4689:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4690:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4691:                   // Verify neighbor's BC value
 4692:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4693: 
 4694:                   // Subtract contribution to RHS
 4695:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4696:                   node->coeffMatrix[j] = 0.0;  
 4697:                }
 4698:          }
 4699:       }
 4700:    }
 4701: 
 4702: 
 4703:    __global__ void updateElevation(void) {
 4704:       NODE(node);
 4705: 
 4706: 
 4707:       node->eta2 = node->mX;
 4708: 
 4709:       node->updateZCoordData();
 4710:    }
