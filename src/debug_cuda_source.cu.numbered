 2158: 
 2159: 
 2160: /**
 2161:    Compute the shape coordinates of the point (xt,yt) in the element.
 2162:    @param xt (input): x-coordinate of the point
 2163:    @param shpCoords (output): shape coordinates of the point
 2164:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2165:    @return true if the point is inside the element, false otherwise
 2166: **/
 2167: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], bool fixNegshpCoord) const {
 2168: 
 2169:    // Compute the shape coordinates of the point xt in the element.
 2170:    if (i34==3) {
 2171:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2172:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2173:       // and in this case, the pt will be nudged into the element
 2174:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2175:       // from the local frame, so use additional check.
 2176: 
 2177:       Point2 x0, x1, x2;
 2178: 
 2179:       if constexpr(ics==1) {
 2180:          x0 = nodes[0]->p;
 2181:          x1 = nodes[1]->p;
 2182:          x2 = nodes[2]->p;
 2183:       }
 2184:       else // lat/lon
 2185:       {
 2186:          Error("Not implemented yet");
 2187:          // globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2188:          // globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2189:          // globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2190:       }
 2191: 
 2192:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2193:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2194:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2195:       shpCoords[3] = 0.0;
 2196: 
 2197:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2198:       const bool res = (tmpmin >= -small);  
 2199:       
 2200:       // If the point is not inside the element, we do not need to fix the negative shape coordinates.
 2201:       fixNegshpCoord = fixNegshpCoord && res;
 2202: 
 2203:       
 2204:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2205:       // then we fix the negative shape coordinates.
 2206:       if ((tmpmin < 0) && fixNegshpCoord) {
 2207: 
 2208:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2209:          // keeping the sum of the shape coordinates equal to 1.
 2210:          // I have tested and compared the new algorithm with the old one, and they give
 2211:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2212:          // The new algorithm should be faster since it is branchless.
 2213:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 2214:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2215:          
 2216:          shpCoords[0] = (shpCoords[0] + a)*b;
 2217:          shpCoords[1] = (shpCoords[1] + a)*b;
 2218:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2219: 
 2220:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2221:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2222:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2223:          }
 2224: 
 2225:          // Update the point coordinates for the new shape coordinates
 2226:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2227:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2228:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2229: 
 2230:       }
 2231: 
 2232:       // Check if the point is inside the element
 2233:       return res;      
 2234:    }
 2235:    else {
 2236:       Error("Not implemented yet");
 2237: #ifdef QUADS
 2238:       // Reproject pt in eframe of nel for ics=2
 2239:       if constexpr(ics==1) {
 2240:          xn2 = xt; 
 2241:          yn2 = yt;
 2242:       }
 2243:       else {
 2244:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2245:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2246:       }
 2247: 
 2248:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2249: #endif
 2250:    }
 2251: 
 2252:    assert(false && "computeShapeCoords: should never reach this point");
 2253:    return false;  // Never reached
 2254: 
 2255: }
 2256: 
 2257: 
 2258: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2259: // Convert shape coordinates to cartesian coordinates
 2260: 
 2261:    if (i34 == 3) {
 2262:       // Triangular element
 2263:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2264:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2265:    }
 2266:    else {
 2267:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2268:    }
 2269: 
 2270: }
 2271: 
 2272: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2273:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2274:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2275:    // The formula for the integral is:
 2276:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2277: 
 2278:    printf("intPhiPhi: TEST\n");
 2279: 
 2280:    const Node *n0 = nodes[0];
 2281:    const Node *n1 = nodes[1];
 2282:    const Node *n2 = nodes[2];
 2283:    const Node *n3 = nodes[3];
 2284: 
 2285:    const Vector2 p0 = n0->p;
 2286:    const Vector2 p1 = n1->p;
 2287:    const Vector2 p2 = n2->p;
 2288:    const Vector2 p3 = n3->p;
 2289: 
 2290:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2291:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2292:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2293:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2294: 
 2295:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2296: }
 2297:    
 2298: 
 2299: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2300:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2301:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2302:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2303:    // The formula is also based on the identity:
 2304:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2305:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2306: 
 2307:    printf("intGradPhiGradPhi: TEST\n");   
 2308: 
 2309:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2310: 
 2311:    const double x0 = nodes[0]->p.x;
 2312:    const double y0 = nodes[0]->p.y;
 2313:    const double x1 = nodes[1]->p.x;
 2314:    const double y1 = nodes[1]->p.y;
 2315:    const double x2 = nodes[2]->p.x;
 2316:    const double y2 = nodes[2]->p.y;
 2317:    const double x3 = nodes[3]->p.x;
 2318:    const double y3 = nodes[3]->p.y;
 2319: 
 2320:    double res = 0.0;
 2321:    
 2322:    // Quadrature points in xi and eta coordinates
 2323:    #pragma unroll
 2324:    for (int i = 0; i < 4; i++) {
 2325:       // For each quadrature point...
 2326: 
 2327:       const Point2 p = GaussPoint(i);
 2328:       const double eta = p.x;
 2329:       const double xi  = p.y;
 2330: 
 2331:       // Jacobian entries at the Gauss point p
 2332:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2333:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2334:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2335:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2336: 
 2337:       const double detJ = jacobianDet(p);
 2338:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2339: 
 2340:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2341:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2342:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2343:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2344:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2345: 
 2346:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2347:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2348:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2349:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2350:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2351: 
 2352:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2353:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2354:    }
 2355: 
 2356:    return res;
 2357: }
 2358: 
 2359: 
 2360: /**  Interpolate velocities at a given point (xt,yt,zt)
 2361: 
 2362:    @param xt, yt, zt: coordinates of the point to interpolate
 2363:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2364: 
 2365:    This is done in four steps:
 2366: 
 2367:    1. Find the shape coordinates for the final position in the element.
 2368:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2369:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2370:       z levels at xt, yt at each step.   
 2371:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2372:       horizontally and vertically.
 2373: **/
 2374: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2375:    // Interpolate the velocities at the point xt. 
 2376:    // This function works the same for triangular and quadrilateral elements.
 2377:    double shpCoord[4];
 2378: 
 2379:    // First step is to compute the shape coordinates of (xt,yt)
 2380:    computeShapeCoords(toVector2(xt), shpCoord, true);
 2381: 
 2382:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2383: 
 2384:    // Second step is to find the level that contains zt
 2385:    // Uses a binary search to find the level
 2386:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2387:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2388:    int R = nvrt - 1;
 2389: 
 2390:    // Get the z coordinates at the nodes of the element at the levels L and R
 2391:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 2392:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2393:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2394: 
 2395:    double zL = interpolate(shpCoord, zLAtNodes);
 2396:    double zR = interpolate(shpCoord, zRAtNodes);
 2397:    
 2398:    // Interpolates vertically the velocities
 2399:    double wght1, wght2;
 2400:    if (xt.z<=zL) {
 2401:       wght1 = 1.0;
 2402:       wght2 = 0.0;
 2403:       xt.z = zL;
 2404:    }
 2405:    else if (xt.z>=zR) {
 2406:       wght1 = 0.0;
 2407:       wght2 = 1.0;
 2408:       xt.z = zR;
 2409:    }
 2410:    else {
 2411:       // Perform a binary search to find the levels between L and R that contain xt.z
 2412:       while (R - L > 1) {
 2413:          int M = (L + R) / 2.0;
 2414: 
 2415:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2416:          double zM = interpolate(shpCoord, zMAtNodes);
 2417:          if (zM < xt.z) 
 2418:          {
 2419:             L = M;
 2420:             zL = zM;
 2421:          }
 2422:          else 
 2423:          {
 2424:             R = M;
 2425:             zR = zM;
 2426:          }
 2427:       }
 2428:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 2429:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2430: 
 2431:       wght2 = (xt.z - zL)/(zR - zL);
 2432:       wght1 = 1.0 - wght2;
 2433: 
 2434:    }
 2435: 
 2436: 
 2437:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2438:    u_int = wght1*interpolate(L, shpCoord, &Node::uvw2) + wght2*interpolate(R, shpCoord, &Node::uvw2);
 2439: 
 2440:    // Neither of the interpolated velocities should be NaN
 2441:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2442: 
 2443: }
 2444: 
 2445: 
 2446: 
 2447: 
 2448: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2449: 
 2450:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2451:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2452:    const Node *n1 = side->n1;
 2453:    const Node *n2 = side->n2;
 2454: 
 2455:    bool n1_match = (n1->nodeBnd->segment == segment);
 2456:    bool n2_match = (n2->nodeBnd->segment == segment);
 2457: 
 2458:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2459:    if (n1_match && n2_match) {
 2460:       return 0.5;
 2461:    } else if (n1_match) {
 2462:       return 1.0;
 2463:    } else if (n2_match) {
 2464:       return 0.0;
 2465:    }
 2466: 
 2467:    return 0.0;
 2468: }
 2469: 
 2470: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2471: 
 2472: 
 2473: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2474: 
 2475:    const double w1 = getBoundaryArrayValueWeight();
 2476:    const double w2 = 1.0 - w1;
 2477:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2478:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2479: 
 2480:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2481: }
 2482: 
 2483: 
 2484: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2485:    const double w1 = getBoundaryArrayValueWeight();
 2486:    const double w2 = 1.0 - w1;
 2487:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2488:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2489: 
 2490:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2491: 
 2492: }
 2493: 
 2494: 
 2495: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2496:    // Returns the value of the velocity at the side center
 2497:    const double w1 = getBoundaryArrayValueWeight();
 2498:    const double w2 = 1.0 - w1;
 2499:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2500:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2501: 
 2502:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2503: }
 2504: 
 2505: 
 2506: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2507:    // Returns the value of the normal component of the velocity at the side center
 2508:    const double w1 = getBoundaryArrayValueWeight();
 2509:    const double w2 = 1.0 - w1;
 2510:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2511:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2512: 
 2513:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2514: }
 2515: 
 2516: 
 2517: 
 2518: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2519: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2520: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 2521: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 2522: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2523: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2524:    Vector2 grad = {0.0, 0.0};
 2525:    int count = 0;
 2526: 
 2527:    if constexpr(ics == 2) assert(false && "grad2: ics = 2 not implemented");
 2528: 
 2529:    // First element
 2530:    if (elems[0] != nullptr && condition(elems[0])) {
 2531:       grad += elems[0]->grad2(field);
 2532:       count++;
 2533:    }
 2534: 
 2535:    // Second element
 2536:    if (elems[1] != nullptr && condition(elems[1])) {
 2537:       grad += elems[1]->grad2(field);
 2538:       count++;
 2539:    }
 2540: 
 2541:    if (count > 0) {
 2542:       grad = grad*(1.0/count);
 2543:    }
 2544:    
 2545:    return grad;
 2546: }
 2547: 
 2548: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 2549: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 2550: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 2551: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 2552: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 2553: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 2554: 
 2555: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 2556: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 2557: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 2558: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
