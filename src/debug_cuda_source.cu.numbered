 1425:                    int max_np, int max_ne, int max_ns, int nseg,
 1426:                    Node **nodesPtr, Element **elemsPtr, Side **sidesPtr,
 1427:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 1428:                    Node    **localNodeNeighNodesMem,
