 8027:          break;
 8028:       // case (int)VarCode::depth:
 8029:       //    *offset = (int)((char*)&sides[0].depth - (char*)sides);
 8030:       //    *sizeType = sizeof(double);
 8031:       //    break;         
 8032:       case (int)VarCode::x:
 8033:          *offset = (int)((char*)&sides[0].center.x - (char*)sides);
 8034:          *sizeType = sizeof(Vector2);
 8035:          break;
 8036:       case (int)VarCode::len:
 8037:          *offset = (int)((char*)&sides[0].len - (char*)sides);
 8038:          *sizeType = sizeof(double);
 8039:          break;
 8040:       case (int)VarCode::kb:
 8041:          *offset = (int)((char*)&sides[0].kb - (char*)sides);
 8042:          *sizeType = sizeof(int);
 8043:          break;
 8044:       case (int)VarCode::isdry:
 8045:          *offset = (int)((char*)&sides[0].isDry - (char*)sides);
 8046:          *sizeType = sizeof(int);
 8047:          break;            
 8048:       case (int)VarCode::w:
 8049:          *offset = (int)((char*)&sides[0].w2 - (char*)sides);
 8050:          *sizeType = sizeof(double);
 8051:          break;
 8052:       case (int)VarCode::u:
 8053:          *offset = (int)((char*)&sides[0].u2[0].x - (char*)sides);
 8054:          *sizeType = sizeof(Vector2);
 8055:          break;   
 8056:       case (int)VarCode::n1:
 8057:          *offset = (int)((char*)&sides[0].n1 - (char*)sides);
 8058:          *sizeType = sizeof(Node);
 8059:          break;
 8060:       case (int)VarCode::n2:
 8061:          *offset = (int)((char*)&sides[0].n2 - (char*)sides);
 8062:          *sizeType = sizeof(Node);
 8063:          break;                   
 8064:       default:
 8065:          *offset = -1;
 8066:    }
 8067: }
