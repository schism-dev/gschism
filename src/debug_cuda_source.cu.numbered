  561: 
  562: // ----------------------------- Frames -----------------------------
  563: 
  564: // Frames are used to transform vectors between different coordinate systems.
  565: // They are templated in such a way that when ics==1, they have (most likely) no overhead.
  566: template<int ICS>
  567: struct Frame {};
  568: 
  569: template<>
  570: struct Frame<1> {
  571:    __forceinline__ __device__ void update(double, double) {}
  572:    __forceinline__ __device__ Vector3 G2L(Vector3 vi) const { return vi; }
  573:    __forceinline__ __device__ Vector3 L2G(Vector3 vi) const { return vi; }
  574:    __forceinline__ __device__ Vector2 projHorVec(Vector2 v, const Frame<1>&) const { return v; }
  575:    __forceinline__ __device__ Vector3 nUp(void)         const { return {0.0, 0.0, 0.0}; }
  576:    __forceinline__ __device__ Vector3 nZonal(void)      const { return {0.0, 0.0, 0.0}; }
  577:    __forceinline__ __device__ Vector3 nMeridional(void) const { return {0.0, 0.0, 0.0}; }
  578: };
  579: 
  580: template<>
  581: struct Frame<2> {
  582:    // Column 0 (East):  (-sin_lon, cos_lon, 0)              - store 2 values, t20=0 implicit
  583:    // Column 1 (North): Normalized oblate ellipsoid vector  - store 3 values
  584:    // Column 2 (Up):    cross(col0, col1)                   - recomputed on demand
  585:     double t00, t10;        // col0 (t20=0 implicit)
  586:     double t01, t11, t21;   // col1
  587: 
  588:    __device__ void update(double lat, double lon) { // XXX use lat, lon instead of ar1, ar2?
  589: 
  590:       assert(lat >= -pi/2.0 && lat <= pi/2.0 && "GRID: lat out of range");
  591:       assert(lon >= -pi     && lon <= pi     && "GRID: lon out of range");
  592: 
  593:       double sin_lon, cos_lon, sin_lat, cos_lat;
  594:       sincos(lon, &sin_lon, &cos_lon); // These functions are faster than sin(ar1) and cos(ar1).
  595:       sincos(lat, &sin_lat, &cos_lat);
  596: 
  597:       t00 = -sin_lon;
  598:       t10 =  cos_lon;
  599:       t01 = -cos_lon*sin_lat;
  600:       t11 = -sin_lon*sin_lat;
  601:       t21 = (rearth_pole/rearth_eq)*cos_lat;
  602: 
  603:       const double col1_norm = sqrt(t01*t01 + t11*t11 + t21*t21);
  604:       assert (col1_norm != 0.0 && "GRID: col1_norm=0");
  605: 
  606:       const double col1_norm_inv = 1.0/col1_norm;
  607:       t01 = t01*col1_norm_inv;
  608:       t11 = t11*col1_norm_inv;
  609:       t21 = t21*col1_norm_inv;
  610: 
  611:       // The 3rd column (col2) is the cross product of the first two and is computed when needed.
  612: 
  613: 
  614:    }
  615: 
  616:    __forceinline__ __device__ void print(void) const {
  617:       printf("frame = [%.16f, %.16f, %.16f, %.16f, %.16f]\n", t00, t10, t01, t11, t21);
  618:    }
  619: 
  620:    __forceinline__ __device__ void getCol2(double &t02, double &t12, double &t22) const {
  621:       // cross(col0, col1), with t20=0 implicitly:
  622:       // |  i       j       k   |
  623:       // | t00     t10      0   |
  624:       // | t01     t11     t21  |
  625:       t02 =  t10*t21;
  626:       t12 = -t00*t21;
  627:       t22 =  t00*t11 - t10*t01;
  628:    }
  629: 
  630: 
  631:    __forceinline__ __device__ Vector2 projHorVec(Vector2 const &vec0, Frame<2> const &frameout) const {
  632:    // Transforms a horizontal vector from one frame to another and projects it to the new local horizontal plane.
  633:    // Inputs:
  634:    //        vec0: vel. in this frame;
  635:    //        frameout: Output frame;
  636:    // Output: 
  637:    //        vel. in new frame  
  638:    //
  639:    // Projects a horizontal vector from frame 1 (this) to frame 2 (frameout),
  640:    // discarding the z-component of the result to keep only the local horizontal
  641:    // plane of frame 2.
  642:    //
  643:    // Since F1 and F2 are global-to-local rotation matrices, transforming from
  644:    // frame 1 to frame 2 requires F2 * F1^{-1} = F2 * F1^T, as rotation matrices
  645:    // are orthogonal. This product is computed as dot products between columns of
  646:    // F1 and columns of F2, which is equivalent to multiplying rows of F1^T by
  647:    // columns of F2.// 
  648: 
  649:       auto const fo = frameout; // Just an alias for the output frame.
  650:       Vector2 res;
  651: 
  652:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  653:       // of t and fo.t are the same.
  654:       const double d00 = t00*fo.t00 + t10*fo.t10;
  655:       const double d10 = t01*fo.t00 + t11*fo.t10;
  656: 
  657:       const double d01 = t00*fo.t01 + t10*fo.t11;
  658:       const double d11 = t01*fo.t01 + t11*fo.t11 + t21*fo.t21;
  659: 
  660:       res.x = vec0.x * d00 + vec0.y * d10;
  661:       res.y = vec0.x * d01 + vec0.y * d11;
  662: 
  663:       return res;
  664:    }
  665: 
  666:    __forceinline__ __device__ Vector3 G2L(Vector3 const &vi) const {
  667:       Vector3 vo;
  668:       double t02, t12, t22;
  669: 
  670:       // Compute the 3rd column of the frame tensor
  671:       getCol2(t02, t12, t22);
  672: 
  673:       vo.x = vi.x*t00 + vi.y*t10;
  674:       vo.y = vi.x*t01 + vi.y*t11 + vi.z*t21;
  675:       vo.z = vi.x*t02 + vi.y*t12 + vi.z*t22;
  676: 
  677:       return vo;
  678:    
  679:    }
  680: 
  681:    __forceinline__ __device__ Vector3 L2G(Vector3 const &vi) const {
  682:       Vector3 vo;
  683:       double t02, t12, t22;
  684: 
  685:    // Compute the 3rd column of the frame tensor
  686:       getCol2(t02, t12, t22);
  687: 
  688:       // F * vi (non-transposed, so we use rows of F)
  689:       vo.x = vi.x*t00 + vi.y*t01 + vi.z*t02;
  690:       vo.y = vi.x*t10 + vi.y*t11 + vi.z*t12;
  691:       vo.z =            vi.y*t21 + vi.z*t22;  // t20=0 term dropped
  692: 
  693:       return vo;
  694:    }
  695: 
  696:    // Unit vectors that define the local frame
  697:    __forceinline__ __device__ Vector3 nUp(void) const {
  698:       // Column 2 = cross(column0, column1)
  699:       return { t10*t21, -t00*t21, t00*t11 - t10*t01 };
  700:    }
  701: 
  702:    __forceinline__ __device__ Vector3 nZonal(void) const {
  703:       // Column 0
  704:       return { t00, t10, 0.0 };
  705:    }
  706: 
  707:    __forceinline__ __device__ Vector3 nMeridional(void) const {
  708:       // Column 1
  709:       return { t01, t11, t21 };
  710:    }
  711: 
  712: };
