 7844: //                         adv_tr(jj)=adv_tr(jj)-tmp !reset to previous value
 7845: //                         if(ssign(j,i)*flux_adv_hface(k,jsj)<0.d0) then  !inflow 
 7846: //                           adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*abs(flux_adv_hface(k,jsj))*(trel_tmp_outside(jj)-trel_tmp(jj,k,i))
 7847: //                         endif
 7848: //                       endif
 7849: //                       !when ntd_weno=1, reduces to: adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*( ssign(j,i)*(flux_adv_hface(k,jsj))*(trel_tmp(jj,k,i)-trsd_tmp(jj,k,jsj)) )
 7850: //                     enddo
 7851: //                   else !upwind
