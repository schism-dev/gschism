 1895: 
 1896: /**
 1897:  * Find the element that contains the target point.
 1898:  * 
 1899:  * @param x0,y0,z0     Starting position coordinates
 1900:  * @param xt,yt,zt     Target position coordinates
 1901:  * @param dtb          Time step for tracking
 1902:  * @param u_int        Initial velocity components
 1903:  * @param nextElem     Starting/resulting element index
 1904:  * 
 1905:  * @return Status code of type trackExitCodes
 1906:  * 
 1907:  * Uses the Leaded Celestial Walk algorithm to find the element that contains the target point.
 1908:  * This is a variant of the Celestial Walk algorithm that goes from element A containing the starting 
 1909:  * point x0 (in one side) to element B containing the target point xt. To enforce that the next element is
 1910:  * as close the the segment AB as possible, the next point at each iteration is computed
 1911:  * along segment AB, but just after the current element.
 1912:  */
 1913: int stackSize = 0;
 1914: 
 1915: __device__ __forceinline__ bool celestialWalk(Element *&curElem, Point3 x0, Point3 &xt, const Side *origSide, Side *&lastCrossSide, int jlev) {
 1916: 
 1917:    constexpr int MAX_ITERATIONS = 200;
 1918: 
 1919:    int iter = 0;
 1920:    while (iter < MAX_ITERATIONS) {
 1921:       iter++;
 1922: if (iter > 20) printf("XXX iter = %d, x0 = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f)\n", iter, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z);
 1923:       Bool4 isLeft, isObtuse, isBisector;
 1924:       curElem->computePredicates(toPoint2(x0), toPoint2(xt), origSide, isLeft, isObtuse, isBisector);
 1925: showPoints(x0, xt, jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 1926:       Bool4 isValid = !isLeft & (!isObtuse | isBisector); // bitwise operation are overloaded
 1927: 
 1928:       if (isValid.none()) 
 1929:       // Inside the element if none of the edges is a valid continuation
 1930:       {
 1931:          // Just returns true and the element (curElem) is unchanged).
 1932:          return true;
 1933:       }
 1934:       else { // Outside the element
 1935: 
 1936:          // Outside this element. Pick the first valid exit side and cross.
 1937:          lastCrossSide = curElem->sides[isValid.firstOne()];
 1938:          Element *prevElem = curElem;
 1939:          curElem = lastCrossSide->otherElem(curElem);
 1940: const Point3 p1 = origSide->toLocalFrame(toPoint3(lastCrossSide->n1->p, lastCrossSide->n1->gz));
 1941: const Point3 p2 = origSide->toLocalFrame(toPoint3(lastCrossSide->n2->p, lastCrossSide->n2->gz));
 1942: showPoints(p1, p2, jlev, origSide, 0x0000FFu, 'o', 1, 0, 0);         
 1943: 
 1944:          // If it crosses into a dry element or a boundary element, return false. This means that the track will now move 
 1945:          // along the boundary.
 1946:          if (curElem == nullptr || curElem->isDry) {
 1947:          
 1948:             curElem = prevElem;
 1949:             return false;
 1950:          }
 1951:          
 1952:       }
 1953: 
 1954:    }
 1955: 
 1956:    assert(false && "Leaded Celestial Walk algorithm did not find the target point in the allowed number of iterations");
 1957: }
