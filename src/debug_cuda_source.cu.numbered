 2706: 
 2707: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2708: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2709: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2710: // Only when ics == 2, the origin is at the element center.
 2711: 
 2712:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2713: 
 2714:    const Node *node = nodes[idxNode];
 2715: 
 2716:    if constexpr(ics==1) {
 2717:       return node->p;
 2718: 
 2719:    } else {
 2720:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2721: 
 2722:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2723: 
 2724:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2725:    }
 2726: 
 2727: }
 2728: 
 2729: 
 2730: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, 
 2731:                                                                             const Vector3& c, const Frame<ics>& dstFrame, int idx) const {
 2732: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2733: 
 2734:    const int id1 = idx;
 2735:    const int id2 = nxq(1 + id1);
 2736:    const int id3 = nxq(2 + id1);
 2737: 
 2738:    if constexpr(ics==1) {
 2739:       x0 = nodes[id1]->p;
 2740:       x1 = nodes[id2]->p;
 2741:       x2 = nodes[id3]->p;
 2742: 
 2743:    } else {
 2744: 
 2745:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2746:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2747:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2748: 
 2749:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2750:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2751:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2752: 
 2753:    }
 2754: 
 2755: }
 2756: 
 2757: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2758:    getLocalHorizontalNodePositionsTri(x0, x1, x2, {center.x, center.y, centerZ()}, frame, idx);
 2759: }
 2760: 
 2761: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2762:             Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3,
 2763:             const Vector3& c, const Frame<ics>& dstFrame) const {
 2764: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2765: 
 2766:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2767: 
 2768: 
 2769: 
 2770:    if constexpr(ics==1) {
 2771:       x0 = nodes[0]->p;
 2772:       x1 = nodes[1]->p;
 2773:       x2 = nodes[2]->p;  
 2774:       x3 = nodes[3]->p;
 2775: 
 2776:    } else {
 2777: 
 2778:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2779:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2780:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2781:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2782: 
 2783:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2784:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2785:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2786:       x3 = toVector2(dstFrame.G2L(p3 - c));
 2787:    }
 2788: 
 2789: }
 2790: 
 2791: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2792:    Point2& x0, Point2& x1, Point2& x2, Point2& x3) const
 2793: {
 2794:    getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, {center.x, center.y, centerZ()}, frame);
 2795: }
 2796: 
 2797: 
 2798: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2799: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2800: // Returns the normal vector and the area of the element at this level
 2801:    
 2802:    double nx, ny, nz;
 2803: 
 2804:    if (isTri()) {
 2805:       // For triangles...
 2806: 
 2807:       // Indices of the nodes at level k, taking care of not going below the bed
 2808:       const int k0 = max(k, nodes[0]->kb);
 2809:       const int k1 = max(k, nodes[1]->kb);
 2810:       const int k2 = max(k, nodes[2]->kb);
 2811: 
 2812:       // Gets the element frame coordinates of the nodes at level k
 2813:       Point3 x0, x1, x2;
 2814:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2815:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2816:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2817:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2818: 
 2819:       } else {  // ics == 2
 2820:          Point2 h0, h1, h2;
 2821: 
 2822:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2823: 
 2824:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2825:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2826:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2827:       }
 2828: 
 2829:       const Vector3 n20 = x2 - x0;
 2830:       const Vector3 n10 = x1 - x0; 
 2831: 
 2832:       // Computes the cross product of vectors n20 and n10. 
 2833:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2834:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2835:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2836: 
 2837:   
 2838:    }
 2839:    else {
 2840:       // For quads...
 2841:       Point2 h0, h1, h2, h3;
 2842: 
 2843:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2844: 
 2845:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2846:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2847:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k] - nodes[0]->z[k]);
 2848:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k] - nodes[1]->z[k]);
 2849: 
 2850:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2851:       nx = n20.y*n31.z - n20.z*n31.y;
 2852:       ny = n20.z*n31.x - n20.x*n31.z;
 2853:       nz = n20.x*n31.y - n20.y*n31.x;
 2854: 
 2855:    }
 2856: 
 2857:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2858:    area3D = 0.5*len;
 2859: 
 2860:    const double inv_len = 1.0/len;
 2861: 
 2862:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2863: 
 2864: }
 2865: 
 2866: 
 2867: // Helper functions to get the 2D local node position for the Celestial walk
 2868: __device__ __forceinline__ Point2 Element::getLocalNodePosition(int idx, const Side* origSide) const {
 2869:    const int idx2 = (isTri() && idx == 3) ? 2 : idx;
 2870:    const Node *node = getNodeInOrder(idx2);
 2871: 
 2872:    double z = 0.0;
 2873:    if constexpr(ics == 2) z = node->gz;
 2874:    
 2875:    Point3 p = toPoint3(node->p, z);
 2876: 
 2877:    return toPoint2(origSide->toLocalFrame(p));
 2878: }
 2879: 
 2880: __device__ __forceinline__ Node *Element::getNodeInOrder(int idx) const {
 2881:    return (ssign[idx] > 0) ? sides[idx]->n1 : sides[idx]->n2;
 2882: }
 2883: 
 2884: __device__ __forceinline__ void Element::computePredicates(const Point2 x0, const Point2& xt, double &fac, const Side* origSide,
 2885:                                 Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector, int jlev) const
 2886: // Computes the three per-side predicates needed for the celestial walk
 2887: // (Kuijper, Ermolaev, Devillers, JCGT 7(3), 2018, arXiv:1710.01620).
 2888: //
 2889: // xt is in local frame coordinates for origSide if ics == 2.
 2890: //
 2891: // All work is done unconditionally on 4 sides to keep CUDA threads uniform.
 2892: // For triangles, side 3 is a sentinel: getNode(3) returns getNode(2), making
 2893: // corners[3] == corners[2] and s3 == (0, 0). Predicates that would be
 2894: // meaningless on triangles are masked to a safe value (see comments below).
 2895: {
 2896:    // Project all 4 corner positions once into the local 2D frame.
 2897:    // For triangles, C[3] == C[2] (no garbage, but geometrically degenerate).
 2898:    // getLocalNodePosition only transforms/projects if ics == 2.
 2899:    const Point2 C[4] = {getLocalNodePosition(0, origSide), 
 2900:                         getLocalNodePosition(1, origSide), 
 2901:                         getLocalNodePosition(2, origSide), 
 2902:                         getLocalNodePosition(3, origSide)};
 2903: 
 2904:    // Computes the maximum distance from the starting point to the farthest element node projected on the segment x0xt.
 2905:    // This has nothing to do with the original celestial walk. It is used in the Leaded Celestial 
 2906:    //Walk algorithm to find a point on the segment x0xt that is as close as possible to the starting point,
 2907:    // But still farther towards the target point from the current point.
 2908:    const Vector2 vt0 = xt - x0;
 2909:    double maxProjDist = max(dot(vt0, C[0] - x0), dot(vt0, C[1] - x0));
 2910:    maxProjDist = max(maxProjDist, dot(vt0, C[2] - x0)); 
 2911:    maxProjDist = isQuad() ? max(maxProjDist, dot(vt0, C[3] - x0)) : maxProjDist;
 2912: 
 2913:    fac = max(1.00001*fac, min(1.0, (maxProjDist/dot(vt0, vt0))*1.00001));
 2914:    const Vector2 ixt = x0 + (xt - x0)*fac;
 2915: 
 2916: 
 2917: // if (origSide->idx == 2860848 && jlev == 46) {
 2918: // showPoints(toPoint3(x0,0.0), toPoint3(xt,0.0), jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2919: // showPoints(toPoint3(ixt,0.0), toPoint3(ixt,0.0), jlev, origSide, 0x00FF00u, 'o', 1, 0, 0);
 2920: // printf("this->idx = %d, origSide->idx = %d, ixt = (%.17f, %.17f), x0 = (%.17f, %.17f), xt = (%.17f, %.17f), fac = %.17f\n", this->idx, origSide->idx, ixt.x, ixt.y, x0.x, x0.y, xt.x, xt.y, fac);
 2921: // }
 2922:    // Side I goes from corners[I] to corners[nxq(I+1)] in CCW perimeter order.
 2923:    // (Note: with corners built from getNode in CCW order, no ssign factor is needed
 2924:    //  here the orientation is baked into the corners array.)
 2925:    const int i3 = nxq(3);
 2926:    const Vector2 s0 = C[ 1] - C[ 0];
 2927:    const Vector2 s1 = C[ 2] - C[ 1];
 2928:    const Vector2 s2 = C[i3] - C[ 2];
 2929:    const Vector2 s3 = C[ 0] - C[i3];
 2930:    
 2931:    // Side I goes from C[I] to C[nxq(I+1)] in CCW perimeter order.
 2932:    // The corners array is built from getNode in CCW order, so the orientation
 2933:    // is already correct and no ssign factor is needed in the formulas below.
 2934:    //
 2935:    // i3 = nxq(3): the index of the corner after side 2.
 2936:    //   Triangle: i3 == 0 (the closing corner of the triangle).
 2937:    //   Quad:     i3 == 3.
 2938:    //
 2939:    // The four side direction vectors. For triangles, s3 == (0, 0) since
 2940:    // C[i3] == C[0] (the perimeter has already closed by side 2).
 2941:    isLeft.set(0,  cross(s0, ixt - C[ 0]) > -small);
 2942:    isLeft.set(1,  cross(s1, ixt - C[ 1]) > -small);
 2943:    isLeft.set(2,  cross(s2, ixt - C[ 2]) > -small);
 2944:    isLeft.set(3, (cross(s3, ixt - C[i3]) > -small) || isTri());  
 2945: 
 2946: // printf("idx = %d, cross(s0, xt - C[ 0] ) = %.17f, cross(s1, xt - C[ 1] ) = %.17f, cross(s2, xt - C[ 2] ) = %.17f, cross(s3, xt - C[i3] ) = %.17f\n", idx, cross(s0, xt - C[ 0] ), cross(s1, xt - C[ 1] ), cross(s2, xt - C[ 2] ), cross(s3, xt - C[i3] ));
 2947: 
 2948:    // For triangles, the corner after side 2 is the closing corner where
 2949:    // side 2 meets side 0 (not side 3, which doesn't exist). The "next side
 2950:    // tangent" used by isObtuse and isBisector at that corner is therefore
 2951:    // s0 for triangles, s3 for quads.
 2952:    const Vector2 s3_tri = isTri() ? s0 : s3;
 2953: 
 2954:    // isObtuse.b[I]: true iff the internal face angle at the corner after
 2955:    // side I is obtuse. Equivalent to dot of consecutive side directions > 0
 2956:    // (acute "turn angle" along the perimeter = obtuse internal angle).
 2957:    //
 2958:    // isObtuse.b[3] for triangles: dot(s3, s0) = dot(0, s0) = 0, so the
 2959:    // result is false naturally. No sentinel needed.
 2960:    isObtuse.set(0, dot(s0, s1) > 0.0);
 2961:    isObtuse.set(1, dot(s1, s2) > 0.0);
 2962:    isObtuse.set(2, dot(s2, s3_tri) > 0.0);  // triangle: closes back to s0
 2963:    isObtuse.set(3, dot(s3, s0) > 0.0);  // Always false for triangles (s3=(0,0))
 2964: 
 2965:    // isBisector.b[I]: at the corner after side I, this tests whether xt is
 2966:    // on the "exit through side I" half of the corner cone, separated by the
 2967:    // approximate angular bisector of the celestial walk. The bisector is
 2968:    // perpendicular to the chord across the corner; the test is the sign of
 2969:    // (xt - corner_vertex) projected onto that chord.
 2970:    //
 2971:    // isBisector.b[3] is always masked out by isLeft.b[3] = true for triangles
 2972:    // (the validity rule sets valid_3 = false), so its computed value for
 2973:    // triangles doesn't matter. No sentinel needed.
 2974:    isBisector.set(0, dot(ixt - C[ 1], s0 + s1) < 0.0);
 2975:    isBisector.set(1, dot(ixt - C[ 2], s1 + s2) < 0.0);
 2976:    isBisector.set(2, dot(ixt - C[i3], s2 + s3_tri) < 0.0);
 2977:    isBisector.set(3, dot(ixt - C[ 0], s3 + s0) < 0.0);   
 2978: 
 2979: }
 2980: 
 2981: 
 2982: __inline__ __device__ double Element::computeSignedArea(void) const {
 2983:    // Compute the area of the element
 2984: 
 2985:    Point2 x0, x1, x2, x3;
 2986:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2987: 
 2988: 
 2989:    double res = signedArea(x0, x1, x2);
 2990: 
 2991:    // In the quad case we need to add the area of the other triangle.
 2992:    if (isQuad()) {
 2993:       x3 = getLocalHorizontalNodePosition(3);
 2994:       double ar1 = signedArea(x0, x2, x3);
 2995:       double ar2 = signedArea(x0, x1, x3);
 2996:       double ar3 = signedArea(x1, x2, x3);
 2997:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2998: 
 2999:       res += ar1;
 3000: 
 3001:    }
 3002: 
 3003:    return res;
 3004: }
 3005: 
 3006: 
 3007: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 3008:                                                                 (nodes[1]->isDry2()) ||
 3009:                                                                 (nodes[2]->isDry2()) ||
 3010:                                                                 (isQuad() && nodes[3]->isDry2());
 3011: }
 3012: 
 3013: __inline__ __device__ double Element::detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3014:    return (1.0/8.0)*((x1.x - x0.x)*(x2.y - x3.y) - (x2.x - x3.x)*(x1.y - x0.y));
 3015: }
 3016: 
 3017: __inline__ __device__ double Element::detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3018:    return (1.0/8.0)*((x2.x - x1.x)*(x3.y - x0.y) - (x3.x - x0.x)*(x2.y - x1.y));
 3019: }
 3020: 
 3021: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 3022:    // In boundary sides, the element 1 is nullptr
 3023:    return side->elems[1] == nullptr; 
 3024: }
 3025: 
 3026: __forceinline__ __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const {
 3027:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 3028:    // For ics == 2, this function uses local frame coordinates.
 3029: 
 3030:    assert(isQuad());
 3031: 
 3032:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 3033:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 3034:    // where vxi, veta, vb are vectors and c is the center of the element.
 3035: 
 3036:    Point2 p0, p1, p2, p3;
 3037: 
 3038:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 3039: 
 3040:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 3041:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 3042:    // vectors vxi and veta connect the centers of opposite sides
 3043:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 3044:    // vb is zero for parallelogram elements.
 3045:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 3046: 
 3047:    //  The bilinear mapping is:
 3048:    //      P(s,t) = C + s*U + t*V + s*t*W
 3049:    //
 3050:    //  where:
 3051:    //    C = centroid (average of four vertices)
 3052:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 3053:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 3054:    //    W = bilinear correction; measures deviation from parallelogram
 3055:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 3056:    //        W = 0 for parallelogram elements.
 3057:    //
 3058:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 3059:    //
 3060:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 3061:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 3062:    //
 3063:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 3064:    //
 3065:    //  Geometrically, (L) projects everything onto the direction
 3066:    //  perpendicular to W, where the mapping is purely affine.
 3067:    //
 3068:    //  The dot product with nb retains the nonlinear term:
 3069:    //
 3070:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 3071:    //
 3072:    //  Geometrically, (Q) projects onto the W direction, where
 3073:    //  the nonlinearity lives.
 3074:    //
 3075:    //  We solve (L) for whichever variable has the larger coefficient
 3076:    //  (better conditioned back-substitution), substitute into (Q),
 3077:    //  and get a scalar quadratic in the other variable.
 3078:    // ================================================================
 3079: 
 3080:    // ---- Basis vectors ----
 3081:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 3082:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 3083:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 3084:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 3085:    // W: nonlinear correction. Difference between quad and parallelogram.
 3086:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 3087:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 3088: 
 3089:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 3090:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 3091:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 3092:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 3093:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 3094: 
 3095:    // ---- nb: direction parallel to W, L1-normalized ----
 3096:    // We don't need a unit vector -- just a well-scaled direction parallel
 3097:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 3098:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 3099:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 3100:    //
 3101:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 3102:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 3103:    // and the quadratic solver takes its linear path (a ~ 0).
 3104:    const double wlen1 = fabs(vb.x) + fabs(vb.y) + 1e-30;
 3105:    const double inv_wlen = 1.0 / wlen1;
 3106:    const Vector2 nb = vb * inv_wlen;
 3107: 
 3108:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 3109:    // cross(nb, .) projects onto the direction PERPENDICULAR to W.
 3110:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 3111:    // What remains is a pure affine relationship between xi and eta.
 3112:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 3113:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 3114:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 3115: 
 3116:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 3117:    // dot(nb, .) projects onto the W direction, where the nonlinearity lives.
 3118:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 3119:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 3120:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 3121:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 3122:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 3123: 
 3124:    // ---- Solve: pick the better-conditioned variable from (L) ----
 3125:    // Back-substitute from (L) dividing by the LARGER coefficient,
 3126:    // minimizing round-off amplification.
 3127:    //
 3128:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 3129:    // that uses predicated moves.
 3130:    //
 3131:    // if (fabs(Ls) > fabs(Lt)) {
 3132:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 3133:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 3134:    //    // Substitute into (Q), multiply by Ls, group by eta:
 3135:    //    const double A = -Qw * Lt;
 3136:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 3137:    //    const double C =  Qs * Lp - Qp * Ls;
 3138: 
 3139:    //    double eta1, eta2;
 3140:    //    solveQuadratic(A, B, C, eta1, eta2);
 3141: 
 3142:    //    // Pick root with smaller |eta| (domain centered at 0).
 3143:    //    // Ternary-> predicated move, no branch divergence.
 3144:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 3145: 
 3146:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 3147:    //    xi = (Lp - Lt * eta) / Ls;
 3148: 
 3149:    // } else {
 3150:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 3151:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 3152:    //    // Substitute into (Q), multiply by Lt, group by xi:
 3153:    //    const double A = -Qw * Ls;
 3154:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 3155:    //    const double C =  Qt * Lp - Qp * Lt;
 3156: 
 3157:    //    double xi1, xi2;
 3158:    //    solveQuadratic(A, B, C, xi1, xi2);
 3159: 
 3160:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 3161: 
 3162:    //    eta = (Lp - Ls * xi) / Lt;
 3163:    // }
 3164:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 3165:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 3166:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 3167:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 3168:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 3169: 
 3170:    // Quadratic:  A*r^2 + B*r + C = 0
 3171:    // (same formula for both cases, just with swapped coefficients)
 3172:    const double A = -Qw * Lb;
 3173:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 3174:    const double C =  Qa * Lp - Qp * La;
 3175: 
 3176:    double r1, r2;
 3177:    solveQuadratic(A, B, C, r1, r2);
 3178: 
 3179:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 3180:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 3181: 
 3182:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 3183:    const double other = (Lp - Lb * r) / La;
 3184: 
 3185:    // Assign to (xi, eta) depending on which variable the quadratic solved
 3186:    xi  = solve_s ? r     : other;
 3187:    eta = solve_s ? other : r;
 3188: 
 3189: 
 3190:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 3191:    xi  = clamp(xi,  -1.0, 1.0);
 3192:    eta = clamp(eta, -1.0, 1.0);
 3193: 
 3194:    // ---- Shape functions ----
 3195:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 3196:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 3197:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 3198:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 3199:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 3200:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 3201:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 3202:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 3203: 
 3204:    return true;
 3205: }
 3206: 
 3207: /**
 3208:    Compute the shape coordinates of the point (xt,yt) in the element.
 3209:    @param xt (input): x-coordinate of the point
 3210:    @param shpCoords (output): shape coordinates of the point
 3211:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 3212:    @return true if the point is inside the element, false otherwise
 3213: **/
 3214: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 3215: 
 3216:    // Compute the shape coordinates of the point xt in the element.
 3217:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 3218:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 3219:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 3220:    // from the local frame, so use additional check.
 3221: 
 3222: 
 3223:    Point3 origSideCenter = toPoint3(origSide->center, origSide->centerZ());
 3224: 
 3225:    if (isTri()) { // Triangular element
 3226: 
 3227:       // Horizontal local node coordinates. 
 3228:       Point2 x0, x1, x2;
 3229:       getLocalHorizontalNodePositionsTri(x0, x1, x2, origSideCenter, origSide->frame);
 3230: 
 3231:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 3232:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 3233:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 3234:       shpCoords[3] = 0.0;
 3235: 
 3236:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 3237:       const bool res = (tmpmin >= -small);  
 3238:       
 3239:       // When to fix the negative shape coordinates?
 3240:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 3241: 
 3242:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 3243:       // then we fix the negative shape coordinates.
 3244:       if ((tmpmin < 0) && fix) {
 3245: 
 3246:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 3247:          // keeping the sum of the shape coordinates equal to 1.
 3248:          // I have tested and compared the new algorithm with the old one, and they give
 3249:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 3250:          // The new algorithm should be faster since it is branchless.
 3251:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 3252:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 3253: 
 3254:          shpCoords[0] = (shpCoords[0] + a)*b;
 3255:          shpCoords[1] = (shpCoords[1] + a)*b;
 3256:          shpCoords[2] = (shpCoords[2] + a)*b;          
 3257: 
 3258:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 3259:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 3260:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 3261: 
 3262:          // Update the point coordinates for the new shape coordinates
 3263:          double xcoords[3] = {x0.x, x1.x, x2.x};
 3264:          double ycoords[3] = {x0.y, x1.y, x2.y};
 3265: 
 3266:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 3267: 
 3268:       }
 3269: 
 3270:       // Return true if the point is inside the element
 3271:       return res;      
 3272:    }
 3273:    else {
 3274:       assert(isQuad() && "computeShapeCoords");
 3275: 
 3276:       // Horizontal local node coordinates with respect to the original side.
 3277:       Point2 x0, x1, x2, x3;
 3278:       getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, origSideCenter, origSide->frame);
 3279: 
 3280:       const double a0 = signedArea(x0, x1, xt);
 3281:       const double a1 = signedArea(x1, x2, xt);
 3282:       const double a2 = signedArea(x2, x3, xt);
 3283:       const double a3 = signedArea(x3, x0, xt);
 3284: 
 3285:       const double minArea = min4(a0, a1, a2, a3);
 3286:       
 3287:       const bool res = (minArea > -small*area);
 3288: 
 3289:       // When to fix the negative shape coordinates?
 3290:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 3291: 
 3292:       double xi, eta;    
 3293: 
 3294:       // Converts the point xt to the element frame coordinates and then to bilinear+shape coordinates.
 3295:       // Does nothing if ics == 1.
 3296:       assert(origSide != nullptr);
 3297:       Point2 xt_elem = toPoint2(toLocalFrame(origSide->toGlobal(toPoint3(xt, 0.0))));
 3298: 
 3299:       inverseBilinearQuad(xt_elem, xi, eta, shpCoords);
 3300: 
 3301:       if (fix) {
 3302:          double xn[4] = {x0.x, x1.x, x2.x, x3.x};
 3303:          double yn[4] = {x0.y, x1.y, x2.y, x3.y};
 3304:          xt.x = interpolate(shpCoords, xn);
 3305:          xt.y = interpolate(shpCoords, yn);
 3306:       }
 3307: 
 3308:       return res;
 3309:    }
 3310: 
 3311: 
 3312:    assert(false && "computeShapeCoords: should never reach this point");
 3313:    return false;  // Never reached
 3314: 
 3315: }
 3316: 
 3317: 
 3318: __device__ __forceinline__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 3319: // Convert shape coordinates to cartesian coordinates
 3320: 
 3321:    if (isTri()) {
 3322:       // Triangular element
 3323: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 3324:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 3325:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 3326:    }
 3327:    else {
 3328:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 3329:    }
 3330: 
 3331: }
 3332: 
 3333: 
 3334: 
 3335: __device__ __forceinline__ double Element::intPhiPhiTri(int i, int j) const {
 3336:    // return \int \phi_i*\phi_j dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3337:    
 3338:    return ((i == j) ? (2.0/12.0) : (1.0/12.0))*area;
 3339: }
 3340: 
 3341: __device__ __forceinline__ double Element::intGradPhiGradPhiTri(int i, int j) const {
 3342:    // return \int (grad phi_i).(grad phi_j) dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3343:    // gradPhi[i] is constant over a linear triangle, so the integral is area * dot(gradPhi[i], gradPhi[j]).
 3344:    assert(isTri() && i >= 0 && j >= 0 && i < 3 && j < 3);
 3345:    return area * dot(gradPhi[i], gradPhi[j]);
 3346: }
 3347: 
 3348: __device__ __forceinline__ double Element::intPhiPhiQuad(int i, int j, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3349:    // return \int \phi_i*\phi_j dA for quads, where phi_i and phi_j are the shape functions of the nodes i and j.
 3350:    // The integral can be computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 3351:    // The formula for the integral is:
 3352:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 3353:    
 3354:    const double xi_term  = 1.0 + (xi_n(i) * xi_n(j))/3.0;
 3355:    const double eta_term = 1.0 + (eta_n(i)*eta_n(j))/3.0;
 3356:    const double eta_sum  = eta_n(i) + eta_n(j);
 3357:    const double xi_sum   = xi_n(i)  + xi_n(j);
 3358: 
 3359:    const double detJ_xi  = detJ_xi_quad (x0, x1, x2, x3);  // XXXXX put the 8 inside the function??? xi derivative of the Jacobian determinant
 3360:    const double detJ_eta = detJ_eta_quad(x0, x1, x2, x3);  // eta derivative of the Jacobian determinant
 3361: 
 3362: 
 3363:    return (1.0/16.0)*area*xi_term*eta_term + (1.0/12.0)*(detJ_eta*xi_term*eta_sum + detJ_xi*eta_term*xi_sum);
 3364: }
 3365:    
 3366: 
 3367: __device__ __forceinline__ double Element::intGradPhiGradPhiQuad(int i1, int i2, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3368:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3369:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 3370:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 3371:    // The formula is also based on the identity:
 3372:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 3373:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 3374: 
 3375:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: bad ranges");
 3376: 
 3377: 
 3378: 
 3379:    double res = 0.0;
 3380:    
 3381:    // Quadrature points in xi and eta coordinates
 3382:    #pragma unroll
 3383:    for (int i = 0; i < 4; i++) {
 3384:       // For each quadrature point...
 3385: 
 3386:       const Point2 p = GaussPoint(i);  // Quadrature point in (eta,xi) coordinates
 3387:       const double eta = p.x;
 3388:       const double xi  = p.y;
 3389: 
 3390:       // Jacobian entries at the Gauss point p
 3391:       const double dx_dxi  = 0.25 * ( (x1.x + x2.x - x0.x - x3.x) + eta*(x0.x + x2.x - x1.x - x3.x) );
 3392:       const double dx_deta = 0.25 * ( (x2.x + x3.x - x0.x - x1.x) + xi *(x0.x + x2.x - x1.x - x3.x) );
 3393:       const double dy_dxi  = 0.25 * ( (x1.y + x2.y - x0.y - x3.y) + eta*(x0.y + x2.y - x1.y - x3.y) );
 3394:       const double dy_deta = 0.25 * ( (x2.y + x3.y - x0.y - x1.y) + xi *(x0.y + x2.y - x1.y - x3.y) );      
 3395: 
 3396:       const double detJ = detJ_quad(p, x0, x1, x2, x3);
 3397:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3398: 
 3399:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3400:       const double dPhi_dxi_1  = dPhi_dxi_quad (i1, p);
 3401:       const double dPhi_deta_1 = dPhi_deta_quad(i1, p);
 3402:       const double dPhi_dxi_2  = dPhi_dxi_quad (i2, p);
 3403:       const double dPhi_deta_2 = dPhi_deta_quad(i2, p);
 3404: 
 3405:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3406:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3407:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3408:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3409:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3410: 
 3411:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3412:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3413:    }
 3414: 
 3415:    return res;
 3416: }
 3417: 
 3418: 
 3419: /**  Interpolate velocities at a given point (xt,yt,zt)
 3420: 
 3421:    @param xt, yt, zt: coordinates of the point to interpolate
 3422:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3423: 
 3424:    This is done in four steps:
 3425: 
 3426:    1. Find the shape coordinates for the final position in the element.
 3427:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3428:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3429:       z levels at xt, yt at each step.   
 3430:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3431:       horizontally and vertically.
 3432: **/
 3433: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3434:    // Interpolate the velocities at the point xt. 
 3435:    // This function works the same for triangular and quadrilateral elements.
 3436:    double shpCoord[4];
 3437:    Vector3 u_int;
 3438: 
 3439: 
 3440:    // First step is to compute the shape coordinates of (xt,yt)
 3441: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3442:    computeShapeCoords(toVector2(xt), shpCoord, fiAnywhere, origSide);
 3443: 
 3444:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 3445: 
 3446:    // Second step is to find the level that contains zt
 3447:    // Uses a binary search to find the level
 3448:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3449:    // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3450:    int L = kb - 1; // In some cases, the bottom level of the element is 1 more than the bottom level of the node XXXX (Check)
 3451:    int R = nvrt - 1;
 3452: 
 3453:    // Get the z coordinates at the nodes of the element at the levels L and R
 3454:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3455:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3456:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3457: 
 3458: 
 3459:    double zL = interpolate(shpCoord, zLAtNodes);
 3460:    double zR = interpolate(shpCoord, zRAtNodes);
 3461: 
 3462:    // Interpolates vertically the velocities
 3463:    double wght1, wght2;
 3464:    if (xt.z <= zL) {
 3465:       wght1 = 1.0;
 3466:       wght2 = 0.0;
 3467:       xt.z = zL;
 3468:    }
 3469:    else if (xt.z >= zR) {
 3470:       wght1 = 0.0;
 3471:       wght2 = 1.0;
 3472:       xt.z = zR;
 3473:    }
 3474:    else {
 3475:       // Perform a binary search to find the levels between L and R that contain xt.z
 3476:       while (R - L > 1) {
 3477:          int M = (L + R) / 2.0;
 3478: 
 3479:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3480:          double zM = interpolate(shpCoord, zMAtNodes);
 3481:          if (zM < xt.z) 
 3482:          {
 3483:             L = M;
 3484:             zL = zM;
 3485:          }
 3486:          else 
 3487:          {
 3488:             R = M;
 3489:             zR = zM;
 3490:          }
 3491:       }
 3492:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3493:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3494: 
 3495:       wght2 = (xt.z - zL)/(zR - zL);
 3496:       wght1 = 1.0 - wght2;
 3497: 
 3498:    }
 3499: // printf("XXYYX element %d, L = %d, R = %d, zL = %.17f, zR = %.17f, xt.z = %.17f, wght1 = %.17f, wght2 = %.17f\n", idx, L, R, zL, zR, xt.z, wght1, wght2);
 3500: // printf("HEREEEEEE 3, wght1 = %.17f, wght2 = %.17f, shpCoord = (%.17f, %.17f, %.17f, %.17f)\n", wght1, wght2, shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 3501:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3502:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3503:    Vector2 uv = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3504:    double w   = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3505: 
 3506:    // Project the velocity from the local frame to the origSide frame
 3507:    if constexpr(ics == 2) uv = frame.projHorVec(uv, origSide->frame);
 3508:    u_int = {uv.x, uv.y, w};
 3509: 
 3510:    // Neither of the interpolated velocities should be NaN
 3511:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3512: 
 3513:    return u_int;
 3514: 
 3515: }
 3516: 
 3517: 
 3518: 
 3519: 
 3520: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3521: 
 3522:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3523:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3524:    const Node *n1 = side->n1;
 3525:    const Node *n2 = side->n2;
 3526: 
 3527:    bool n1_match = (n1->nodeBnd->segment == segment);
 3528:    bool n2_match = (n2->nodeBnd->segment == segment);
 3529: 
 3530:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3531:    if (n1_match && n2_match) {
 3532:       return 0.5;
 3533:    } else if (n1_match) {
 3534:       return 1.0;
 3535:    } else if (n2_match) {
 3536:       return 0.0;
 3537:    }
 3538: 
 3539:    return 0.0;
 3540: }
 3541: 
 3542: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3543: 
 3544: 
 3545: 
 3546: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 3547:    // Returns the value of the velocity at the side center
 3548:    const double w1 = getBoundaryArrayValueWeight();
 3549:    const double w2 = 1.0 - w1;
 3550:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3551:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3552: 
 3553:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 3554: }
 3555: 
 3556: 
 3557: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 3558:    // Returns the value of the normal component of the velocity at the side center
 3559:    const double w1 = getBoundaryArrayValueWeight();
 3560:    const double w2 = 1.0 - w1;
 3561:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3562:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3563: 
 3564:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 3565: }
