 4210: template<int nc>
 4211: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4212: 
 4213: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4214: //
 4215: // a,b,c,rhs: input vectors and are not modified by this program.
 4216: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4217: // rhs is the r.h.s.
 4218: // n: actual rank of the system.
 4219: // rows in u() and rhs();
 4220: // u: output with nc columns (transposed to rows)
 4221: // gam: a working array.
 4222: //
 4223: // NOTES:
 4224: // This is a template function that allows for different numbers of columns in the rhs vector.
 4225: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4226: 
 4227:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4228:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4229: 
 4230:    double bet = b[0];
 4231:    if constexpr (nc == 1) {
 4232:       u[0] = rhs[0]/bet;
 4233:    } else {
 4234:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4235:    }
 4236: 
 4237:    for (int j = 1; j < n; j++) {
 4238:       gam[j] = c[j - 1]/bet;
 4239:       bet = b[j] - a[j]*gam[j];
 4240: 
 4241:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4242: 
 4243:       if constexpr (nc == 1) {
 4244:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4245:       } else {
 4246:          for (int l = 0; l < nc; l++) {
 4247:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4248:          }
 4249:       }
 4250:    }
 4251: 
 4252:    // Back-substitution
 4253:    for (int j = n - 2; j >= 0; j--) {
 4254:       if constexpr (nc == 1) {
 4255:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4256:       } else {
 4257:          for (int l = 0; l < nc; l++) {
 4258:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4259:          }
 4260:       }
 4261:    }
 4262: }
 4263: 
 4264: 
 4265: 
 4266: // Helper function that contains the core algorithm
 4267: template<typename XAccessor, typename YAccessor>
 4268: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4269:                                     double  yp_top, double  yp_bot, 
 4270:                                     CubicSpline &spline) {
 4271:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4272:    // 
 4273:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4274:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4275:    //
 4276:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4277:    // 
 4278:    // Inputs: 
 4279:    //            n: dimension for x etc; # of data pts (>=2);
 4280:    //            getX, getY: functions to access x,y coordinates
 4281:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4282:    //     Output: 
 4283:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4284: 
 4285:    const int n = k2 - k1 + 1;
 4286:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4287: 
 4288:    // Allocate memory for the splines
 4289:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4290:    spline.x   = new double[n];
 4291:    spline.y   = new double[n];
 4292:    spline.yp  = new double[n];
 4293:    spline.ypp = new double[n];
 4294: 
 4295:    for (int k=k1; k<=k2; k++) {
 4296:       spline.x[k] = getX(k);
 4297:       spline.y[k] = getY(k);
 4298:    }
 4299: 
 4300:    // This is to simplify expressions later
 4301:    double *x = spline.x;
 4302:    double *y = spline.y;
 4303: 
 4304:    double *a = nullptr;
 4305:    double *b = nullptr;
 4306:    double *c = nullptr;
 4307:    double *gam = nullptr;
 4308:    double *rhs = nullptr;
 4309:    
 4310: 
 4311:       a = new double[n];   // Lower diagonal
 4312:       b = new double[n];   // Diagonal
 4313:       c = new double[n];   // Upper diagonal
 4314:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4315:       rhs = new double[n]; // Right-hand side
 4316: 
 4317:    for (int k=k1; k<=k2; k++) {
 4318:       if (k == k1) {
 4319:          // Bottom level
 4320:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4321:          b[k] = (x[k+1] - x[k])/3.0;
 4322:          c[k] = b[k]/2.0;
 4323:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4324:       } else if (k == n - 1) {
 4325:          // Top level (surface)
 4326:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4327:          b[k] = (x[k] - x[k-1])/3.0;
 4328:          a[k] = b[k]/2.0;
 4329:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4330:       } else {
 4331:          // Intermediate levels
 4332:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4333:          b[k] = (x[k+1] - x[k-1])/3.0;
 4334:          a[k] = (x[k  ] - x[k-1])/6.0;
 4335:          c[k] = (x[k+1] - x[k  ])/6.0;
 4336:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4337:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4338:       }
 4339:    }
 4340: 
 4341:    // Solve the tridiagonal system
 4342:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4343:    
 4344:    spline.yp[k1] = yp_bot;
 4345:    spline.yp[k2] = yp_top;
 4346: 
 4347:    // Compute rest of 1st derivatives using the splines
 4348:    for (int k=k1+1; k<k2; k++) {
 4349:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4350:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4351:    }
 4352:    
 4353:    delete[] a;
 4354:    delete[] b;
 4355:    delete[] c;
 4356:    delete[] gam;
 4357:    delete[] rhs;
 4358: 
 4359: }
 4360: 
 4361: // Array version
 4362: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4363:                                 double y_top, double y_bot, 
 4364:                                 CubicSpline &spline) {
 4365:    auto getX = [x] (int k) { return x[k]; };
 4366:    auto getY = [y] (int k) { return y[k]; };
 4367:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4368: }
 4369: 
 4370: // Lambda version - allows custom access patterns
 4371: template<typename XFunc, typename YFunc>
 4372: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4373:                                 double y_top, double y_bot,
 4374:                                 CubicSpline &spline) {
 4375:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4376: }
 4377: 
 4378: 
 4379: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 4380: {
 4381:    assert("Not implemented");
 4382: 
 4383:    return 0.0;
 4384: }
 4385: 
 4386: // __device__ void vertLinearInterp(int nc, double zt, int k1, int k2, double *za, double *s_in, double *s_out, int *ibelow) {
 4387: // //     Routine to do vertical linear interpolation in z
