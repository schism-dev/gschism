  292: 
  293: 
  294: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  295:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  296:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  297: }
  298: 
  299: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  300:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  301:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  302: }
  303: 
  304: 
  305: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  306:    x3 = y1*z2 - y2*z1;
  307:    y3 = x2*z1 - x1*z2;
  308:    z3 = x1*y2 - x2*y1;
  309: }
  310: 
  311: 
  312: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  313: // Given a 3D global point (may not be on surface of earth), find its longitude and latitude in radians
  314: 
  315:    const double radius2 = dot(p, p);
  316:    assert(radius2 != 0.0     && "computeLonLat: radius = 0");
  317:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  318: 
  319:    rlon = atan2(p.y, p.x); // (-pi,pi]
  320: 
  321:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  322:       rlat = asin(p.z/sqrt(radius2));
  323:    } else {
  324:       rlat = asin(p.z/rearth_pole);
  325:    }
  326:   
  327: }
  328: 
  329: __inline__ __device__ void Error(const char* msg) {
  330:    printf("Error: %s\n", msg);
  331:    assert(false);
  332: }
