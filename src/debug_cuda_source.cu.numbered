 1290:    __device__ void setFrame(void) {
 1291:       if constexpr(ics == 1) return;
 1292: 
 1293:       double lat, lon;
 1294:       const Point3 p = toPoint3(center, centerZ());
 1295: 
 1296:       // Compute the latitude and longitude of the element center
 1297:       computeLatLon(p, lat, lon);
 1298: 
 1299:       frame.update(lat, lon);        
 1300:    }
