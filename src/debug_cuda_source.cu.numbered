 2074:    template<typename T>
 2075:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 2076:       // Get the values of the field at the nodes of the element
 2077:       res[0] = nodes[0]->*field;
 2078:       res[1] = nodes[1]->*field;
 2079:       res[2] = nodes[2]->*field;
 2080:       if (isQuad()) res[3] = nodes[3]->*field;
 2081:       else          res[3] = T();
 2082:    }
