 1905: 
 1906: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1907:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1908: 
 1909:    printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 1910: 
 1911:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1912:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1913:    // curElement.
 1914: 
 1915:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1916:    // And uses this velocity instead to continue the tracking.
 1917: 
 1918:    // computes the intersection point in cartesian coordinates
 1919:    Point2 intersection = nextSide->p_t(tt);
 1920: 
 1921:    // Nudges the point to the barycenter of the element. 
 1922:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1923:    // next segment intersects the element sides.  
 1924:    curElem->nudgeToBarycenter(intersection);
 1925: 
 1926:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1927:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1928:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1929:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1930: 
 1931:    // If the side is an open boundary, the tangential velocity is zero.
 1932:    if (nextSide->isBnd()) vtan = 0.0;
 1933: 
 1934:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1935:    const double us = vtan*nextSide->t().x;
 1936:    const double vs = vtan*nextSide->t().y;
 1937:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1938: 
 1939:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1940:    const double len2 = norm2(intersection - toPoint2(xt));
 1941:    const double vel2 = dot(u_int, u_int);        
 1942:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 1943:    else            dt = 0.0;
 1944: 
 1945:    // The end of this tracking segment is now the intersection point.
 1946:    xt = {intersection.x, intersection.y, zint};
 1947: printf("BBB u_int = %f,%f,%f\n", us, vs, ws);   
 1948:    u_int = {us, vs, ws};
 1949:    
 1950: }
 1951: 
 1952: /**
 1953:  * Tracks a particle through elements and vertical levels in the mesh.
 1954:  * 
 1955:  * @param x0,y0,z0     Starting position coordinates
 1956:  * @param xt,yt,zt     Target position coordinates
 1957:  * @param dtb          Time step for tracking
 1958:  * @param uuint,vvint,wwint Initial velocity components
 1959:  * @param nextElem     Starting/resulting element index
 1960:  * 
 1961:  * @return Status code of type trackExitCodes
 1962:  * 
 1963:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1964:  * of the details are different. The idea is that the code requires less branches and is better fit
 1965:  * for GPU execution.
 1966:  * 
 1967:  * The main ideas here are:
 1968:  * - The starting point is expected to be in the starting element.
 1969:  * - The end point is guaranteed to be inside an element.
 1970:  * - since the starting point is inside the element, there are only two cases: 
 1971:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1972:  *     (b) it does not and (xt,yt) is already in the starting element.
 1973:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1974:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1975:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1976:  * - tt1 can be positive or negative. We only consider the positive values.
 1977:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1978:  * - The next intersection will occur at the smallest positive tt1.
 1979:  * - This intersection will be the next (x0,y0) position.
 1980:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1981:  *   of getting stuck in a loop.
 1982:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1983:  *   was found.
 1984:  */
 1985: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1986:                                                        Element *&nextElem, int &jlev, double &dt) {
 1987: 
 1988: 
 1989:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 1990:    // else to do.
 1991:    // If it is, nudges the point to be inside the element.
 1992:    const Element *curElem = nextElem;
 1993:    if (containsPoint(toPoint2(xt), true)) {
 1994: 
 1995:       // curElem->interpolateVelocities(xt, u_int);
 1996: addDebugPlot(x0, xt);
 1997:       return true;
 1998:    }
 1999: 
 2000:    Side *side = nullptr;
 2001: 
 2002:    // 1. Initial checks
 2003:    // Verify starting element is valid (wet)
 2004:    assert(!curElem->isDry && "Starting element is dry");
 2005: 
 2006:    // Checks if track has a zero length.
 2007:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 2008:    // assert(len2 > 0.0 && "Zero length track"); 
 2009:    
 2010:    const int MAX_ITERATIONS = 1000;
 2011:    
 2012:    double t;
 2013:    Side *nextSide = nullptr;
 2014:    double tIntersect = 1e10;
 2015:    double zint = x0.z;
 2016: 
 2017:    // Horizontal tracking loop
 2018:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2019:    // (x0,y0) is inside the element but the target point is not.
 2020: 
 2021:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2022: 
 2023:    assert(found_intersection && "No intersection found at %d");
 2024: 
 2025:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2026: 
 2027:    // if the tracking segment goes out of water (either dry or edge boundary)
 2028:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2029: 
 2030: 
 2031:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 2032: addDebugPlot(x0, xt);      
 2033: 
 2034:       nextElem = this;
 2035:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2036:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2037:       return true;    
 2038:    }
 2039: 
 2040: 
 2041:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 2042:    int iterations = 0;
 2043:    while (iterations < MAX_ITERATIONS) {
 2044:       iterations++;
 2045: printf("BBBXXXX iterations = %d\n", iterations);      
 2046:       
 2047:       Element *curElem = nextElem;
 2048: 
 2049:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2050: addDebugPlot(x0, xt);
 2051:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2052: 
 2053:       // If we are already in the target element, we are done.
 2054:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 2055:       if (!found_intersection) break;
 2056: 
 2057: 
 2058: 
 2059:       // if the tracking segment goes out of water (either dry or edge boundary).
 2060:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2061: 
 2062:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 2063: addDebugPlot(x0, xt);
 2064:          nextElem = curElem;
 2065: 
 2066:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 2067:          // In this case, the caller (btrack) needs to take into account the remaining time.
 2068:          return true;
 2069:       }
 2070:       
 2071:       // Update position and element for next iteration
 2072:       side = nextSide;
 2073: 
 2074:    }
 2075: 
 2076:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 2077: 
 2078:  
 2079:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2080:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2081: addDebugPlot(x0, xt);   
 2082:    // nextElem->interpolateVelocities(xt, u_int); XXXXX
 2083: 
 2084: 
 2085:    return true;
 2086: }
 2087: 
 2088: 
 2089: __inline__ __device__ double Element::computeSignedArea(void) const {
 2090:    // Compute the area of the element
 2091: 
 2092:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 2093: 
 2094:    // In the quad case we need to add the area of the other triangle.
 2095:    if (isQuad()) {
 2096:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2097:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 2098:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2099:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 2100:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 2101:          Error("Negative area found in quad element");
 2102:       }
 2103:       res += ar1;
 2104:    }
 2105: 
 2106:    return res;
 2107: }
 2108: 
 2109: 
 2110: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2111:                                                                 (nodes[1]->isDry2()) ||
 2112:                                                                 (nodes[2]->isDry2()) ||
 2113:                                                                 (i34==4 && nodes[3]->isDry2());
 2114: }
