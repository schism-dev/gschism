 1199: struct Node {
 1200: 
 1201:    // Geometry information
 1202:    int idx;        // Index of the node
 1203:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1204:    int numNodes;   // Number of nodes neighbors of this node
 1205: 
 1206:    Element **elements; // Array of pointers to the elements that share this node
 1207:    int numElements;    // Number of elements that share this node
 1208: 
 1209:    int numSides;       // Number of sides that are connected to this node
 1210: 
 1211:    Point2 p;
 1212:    Vector2 u2[nvrt];
 1213:    double  w2[nvrt];
 1214:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1215:    double z[nvrt];
 1216:    double lon, lat;
 1217:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1218:    double depth;
 1219: 
 1220:    int kb;       // Bottom index of the node
 1221: 
 1222:    bool isDry;     // True if the node is dry
 1223: 
 1224:    int iadv;     // Advection flag
 1225: 
 1226:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1227:                           // this is nullptr
 1228: 
 1229:    TempVar tmp; // Temporary variable to store different types of variables
 1230: 
 1231:    // Physical information
 1232:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1233:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1234: 
 1235:    double rho[nvrt];     // Density
 1236:    double dfv[nvrt];     // Vertical viscosity
 1237: 
 1238:    double eta1; // Elevation at nodes at previous timestep
 1239:    double eta2; // Elevation at nodes at current timestep
 1240: 
 1241:    double ETP;  // Earth Tidal Potential
 1242: 
 1243:    double pr;    // Air pressure
 1244:    double grav2; // Gravity 
 1245:    
 1246:    Vector2 dav;  // Depth averaged velocity
 1247: 
 1248:    Vector2 tau; // Wind stress vector
 1249: 
 1250:    // Vegetation parameters
 1251:    double veg_h;
 1252:    double veg_nv;
 1253:    double veg_di;
 1254:    double veg_Cd;
 1255:    double veg_h_unbent;
 1256:    double veg_di_unbent;
 1257:    double veg_nv_unbent;
 1258:    double veg_alpha_vert_mean;
 1259:    double veg_alpha0;
 1260:    double veg_alpha3D[nvrt];
 1261: 
 1262:    // Bottom drag parameters
 1263:    double Cd;       // Bottom drag coefficient   
 1264: 
 1265:    // These three are mutually exclusive
 1266:    union {
 1267:       double rmanning; // Bottom Manning's coefficient
 1268:       double rough;    // Bottom roughness length
 1269:       double drag;     // Bottom drag coefficient
 1270:    };
 1271:    Vector2 tau_bot; // Bottom stress vector
 1272: 
 1273:    double bdef1; // Bottom deformation at previous timestep
 1274:    double bdef2; // Bottom deformation at current timestep
 1275: 
 1276:    double qel; // RHS
 1277:    double coeffDiag; // Diagonal coefficient of the matrix
 1278:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1279: 
 1280:    double mP; // Search direction for conjugate gradient method
 1281:    double mR; // Residual for conjugate gradient method
 1282:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1283:    double mX; // Solution for conjugate gradient method
 1284: 
 1285:    // Meteorological forcing
 1286:    Vector2 u_air;
 1287:    double p_air;
 1288:    double t_air;
 1289:    double q_air;
 1290:    double wind_angle;  // Wind rotation angle
 1291: 
 1292:    __device__ void setWind(Vector2 &u) {
 1293:    // Sets the wind vector taking into account the wind rotation angle
 1294:    
 1295:       const double dir = atan2(-u.x,-u.y);
 1296:       const double speed = length(u);
 1297: 
 1298:       // Calculate new u and v components with added rotation angle
 1299:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1300:    }
 1301: 
 1302: 
 1303:    __device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }
 1304: 
 1305:    __device__ double sigmaTransitionDepth(void) const;
 1306: 
 1307:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1308:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1309:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1310:    
 1311:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1312: 
 1313:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1314: 
 1315:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1316:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1317: 
 1318:    __device__ __forceinline__ void clearMatrixRow(void) {
 1319:       // Clear the matrix row for this node
 1320: 
 1321: 
 1322:       coeffDiag = 0.0;
 1323: 
 1324:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1325: 
 1326:    }
 1327: 
 1328:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1329:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1330:       
 1331:       if (node == this) {
 1332:          coeffDiag += value;
 1333:      
 1334:       } else {
 1335:          // Search (linearly)the index of the node in the array of nodes
 1336:          // XXX: This is not efficient, see if we can improve this
 1337:          int i;
 1338:          for (i = 0; i < numNodes; i++) {
 1339:             if (nodes[i] == node) {
 1340:                break;
 1341:             }
 1342:          }
 1343:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1344:          coeffMatrix[i] += value;
 1345:       }
 1346:    }
 1347: 
 1348: 
 1349:    __device__ __inline__ void updateZCoordData(void);
 1350: 
 1351:    __device__ double compZCoord(int k) const;
 1352: 
 1353:    __device__ void updateKb(void);
 1354: 
 1355:    __device__ __forceinline__ void computeBottomDragCd(void);
 1356: 
 1357: 
 1358: 
 1359: };
