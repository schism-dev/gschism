  312: // Polynomial class
  313: template<int grade>
  314: struct Polynomial {
  315:     // Static assertion to give a clear error message at compile time
  316:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  317: };
  318: 
  319: 
  320: // Explicit specialization for grade 4
  321: template<>
  322: struct Polynomial<4> {
  323:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  324: 
  325:    // Constructor from coefficients
  326:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  327: 
  328:    __device__ __forceinline__ double eval(double x) const {
  329:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  330:    }
  331: };
