 1457:                    SideBoundary *localSideBoundaryMem,
 1458:                    BoundarySegment *localSegmentMem,
 1459:                    double h_c, double h_s, double theta_b, double theta_f, double *sigma_lcl, double *sigma, double *ztot,
 1460:                    double *cs, double *dcs
 1461:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
