 2324: __device__ void lock(int *mutex) {
 2325:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 2326: }
 2327: 
 2328: __device__ void unlock(int *mutex) {
 2329:     atomicExch(mutex, 0);
 2330: }
