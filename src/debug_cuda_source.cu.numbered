 2505: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2506:    const double w1 = getBoundaryArrayValueWeight();
 2507:    const double w2 = 1.0 - w1;
 2508:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2509:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2510: 
 2511:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
