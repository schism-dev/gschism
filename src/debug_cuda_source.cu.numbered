 1163: // This struct is used to store the boundary information for a node.
 1164: struct NodeBoundary {   
 1165:    int idx;
 1166:    BoundarySegment *segment;
 1167:    Node *node;
 1168:    
 1169:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1170:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1171: 
 1172:    bool isLand;
 1173: 
 1174:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1175:    double elbc;   // Elevation boundary condition
 1176:    double eth;    // Elevation time history
 1177: 
 1178:    double eta_mean; // Mean elevation at nodes
 1179: 
 1180:    bool isEssentialBC;
 1181: 
 1182:    Vector2 uth[nvrt];  // "Time history" velocity
 1183: 
 1184:    // Arrays for harmonic constituents (if needed)
 1185:    double  emo[nbfr];  // Elevation amplitude
 1186:    double  efa[nbfr];  // Elevation phase
 1187:    Vector2 umo[nbfr];  // velocity amplitude
 1188:    Vector2 ufa[nbfr];  // velocity phase
 1189: 
 1190: 
 1191:    NodeBoundary(void) {
 1192:       isLand = false;
 1193:    }
 1194:    NodeBoundary(bool _isLand) {
 1195:       isLand = _isLand;
 1196:    }
 1197: 
 1198:    
 1199:    __forceinline__ __device__ int numSidesForAverage() const {
 1200:    // Returns the number of sides that are connected to the node and have the same segment.
 1201:    // This is used to compute the average velocity at the node for open boundary nodes.
 1202:       int res = 0;
 1203:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1204:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1205: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1206:       return res;
 1207:    }
 1208: 
 1209: 
 1210:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1211:       assert(index == 0 || index == 1); 
 1212:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1213:    }
 1214: 
 1215: 
 1216: };
