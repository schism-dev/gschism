  627:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  628:       // Check if the point (xt,yt) is inside the element
  629:       double shpCoords[4];
  630: 
  631:       bool res = computeShapeCoords(xt, shpCoords, false);
  632: 
  633:       return res;
  634:    }
  635: 
  636:    __inline__ __device__ bool containsPoint(Vector2 &xt, bool fixCoords) const { 
  637:       // Check if the point (xt,yt) is inside the element
  638:       double shpCoords[4];
  639: 
  640:       Vector2 tmp_xt = xt;
  641:       bool res = computeShapeCoords(tmp_xt, shpCoords, fixCoords);
  642: 
  643:       if (fixCoords && res) xt = tmp_xt;
  644: 
  645:       return res;
  646:    }
  647: 
  648:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  649:    {
  650:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  651:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  652:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  653:       
  654:    }
  655: 
  656:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int) const;
  657: 
  658:    // ------------------------------------------------------------------------------------------------
  659:    // These are functions that work on all nodes of the element.
  660:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  661:    //
  662:    // An example of how to use these functions is:
  663:    //   
  664:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  665:    // 
  666:    // Where L is the level at which the field is to be interpolated. The field can be either
  667:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  668:    // There are different versions of getNodalValues for each of these cases.
  669: 
  670:    template<typename T>
  671:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  672:       // Get the values of the field at the nodes of the element
  673:       res[0] = nodes[0]->*field;
  674:       res[1] = nodes[1]->*field;
  675:       res[2] = nodes[2]->*field;
  676:       if (isQuad()) res[3] = nodes[3]->*field;
  677:       else          res[3] = T();
  678:    }
  679: 
  680:    template<typename T>
  681:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  682:       // Get the values of the field at the nodes of the element
  683:       res[0] = (nodes[0]->*field)[level];
  684:       res[1] = (nodes[1]->*field)[level];
  685:       res[2] = (nodes[2]->*field)[level];
  686:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  687:       else          res[3] = T();
  688:    }    
  689: 
  690:    template<typename T>
  691:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  692:       // Get the values of the func at the nodes of the element
  693:       res[0] = (nodes[0]->*func)(level);
  694:       res[1] = (nodes[1]->*func)(level);
  695:       res[2] = (nodes[2]->*func)(level);
  696:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  697:       else          res[3] = T();  // This is 0.0 or a zero vector
  698: 
  699:    }      
  700: 
  701:    template<typename T>
  702:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  703:       // Get the values of the field at the nodes of the element
  704:       res[0] = sides[0]->*field;
  705:       res[1] = sides[1]->*field;
  706:       res[2] = sides[2]->*field;
  707:       if (isQuad()) res[3] = sides[3]->*field;
  708:       else          res[3] = T();
  709:    }
  710: 
  711:    template<typename T>
  712:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  713:       // Get the values of the field at the nodes of the element
  714:       res[0] = (sides[0]->*field)[level];
  715:       res[1] = (sides[1]->*field)[level];
  716:       res[2] = (sides[2]->*field)[level];
  717:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  718:       else          res[3] = T();
  719:    }    
  720: 
  721:    template<typename T>
  722:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  723:       // Get the values of the func at the nodes of the element
  724:       res[0] = (sides[0]->*func)(level);
  725:       res[1] = (sides[1]->*func)(level);
  726:       res[2] = (sides[2]->*func)(level);
  727:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  728:       else          res[3] = T();  // This is 0.0 or a zero vector
  729: 
  730:    }      
  731: 
  732: 
  733:    __device__ double interpolate(int level, const double shapeCoords[4], double (Node::*func)(int) const) const {
  734:       double values[4];
  735:       getNodalValues(level, func, values);
  736: 
  737:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  738:    }
  739: 
  740:    template<typename T>
  741:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  742:       T values[4];
  743:       getNodalValues(field, values);
  744:       
  745:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  746:    }
  747: 
  748: 
  749:    template<typename T>
  750:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  751:       T values[4];
  752:       getNodalValues(level, field, values);
  753: 
  754:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  755:    }
  756: 
  757:    template<typename T>
  758:    __device__ T mean(T Node::* field) const {
  759:       T values[4];
  760:       getNodalValues(field, values);
  761: 
  762:       return (values[0] + values[1] + values[2] + values[3])/i34;
  763:    }
  764: 
  765:    template<typename T>
  766:    __device__ T mean(T Side::* field) const {
  767:       T values[4];
  768:       getSideValues(field, values);
  769:       
  770:       return (values[0] + values[1] + values[2] + values[3])/i34;
  771:    }   
  772: 
  773:    template<typename T>
  774:    __device__ T mean(int level, T (Node::* field)[nvrt]) const {
  775:       T values[4];
  776:       getNodalValues(level, field, values);
  777: 
  778:       return (values[0] + values[1] + values[2] + values[3])/i34;
  779:    }
  780: 
  781:    template<typename T>
  782:    __device__ T mean(int level, T (Side::* field)[nvrt]) const {
  783:       T values[4];
  784:       getSideValues(level, field, values);
  785:       
  786:       return (values[0] + values[1] + values[2] + values[3])/i34;
  787:    }   
  788: 
  789:    // __device__ double mean(double (Node::*func)(int) const) const {
