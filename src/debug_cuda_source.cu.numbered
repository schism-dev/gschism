 3459: 
 3460: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3461:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3462:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3463: 
 3464: 
 3465:    NODE(node1);
 3466: 
 3467:    node1->clearMatrixRow();
 3468:    node1->qel = 0.0;
 3469: 
 3470:    // THIS IS FOR STRUCTURES XXX
 3471:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3472: 
 3473:    
 3474:    for (int j=0; j<node1->numElements; j++) {
 3475:       // For each element connected to the node...
 3476: 
 3477:       Element *elem = node1->elements[j];
 3478: 
 3479: 
 3480: 
 3481:       // Compute the average gravity
 3482:       const double grav3 = elem->mean(&Node::grav2);
 3483: 
 3484:       // Look at the documentation for the description of the terms in the following integrals
 3485: 
 3486:       // Integral I_1 
 3487:       // \bar{\breve{H}} 
 3488:       const double hhatb = elem->mean(&Side::hhat);        
 3489: 
 3490:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3491: 
 3492:       const int id1 = elem->nodeLocalIdx(node1); 
 3493:       const double area = elem->area;
 3494: 
 3495:       if (elem->isTri()) {
 3496: 
 3497:          // To clarify the notation in this section: 
 3498:          //   i stands for the node under consideration (node1)
 3499:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3500:          const int id2 = elem->nxq(1 + id1);
 3501:          const int id3 = elem->nxq(2 + id1);
 3502:          Node *node2 = elem->nodes[id2];
 3503:          Node *node3 = elem->nodes[id3];
 3504: 
 3505:          const Point2 x1 = node1->p;
 3506:          const Point2 x2 = node2->p;
 3507:          const Point2 x3 = node3->p;
 3508: 
 3509:          // integral of phi_i*phi_j
 3510:          const double ipp_ii = (1.0/6.0 )*area;
 3511:          const double ipp_ij = (1.0/12.0)*area;
 3512:          const double ipp_ik = (1.0/12.0)*area;
 3513: 
 3514:          // integral of [(grad phi_i) * (grad phi_j)]
 3515:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3516:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3517:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3518: 
 3519:          // Computes the different components of integral I_1 of each node with respect to node i.
 3520:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3521:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3522:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3523: 
 3524:          node1->addToSparseMatrix(node1, I1_ii);
 3525:          node1->addToSparseMatrix(node2, I1_ij); 
 3526:          node1->addToSparseMatrix(node3, I1_ik);
 3527: 
 3528:       }
 3529:       else { // Quad
 3530:          // XXX IMPLEMENT THIS
 3531:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3532: 
 3533:          // To clarify the notation in this section: 
 3534:          //   i stands for the node under consideration (node1)
 3535:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3536:          const int id2 = elem->nxq(1 + id1);
 3537:          const int id3 = elem->nxq(2 + id1);
 3538:          const int id4 = elem->nxq(3 + id1);
 3539:          Node *node2 = elem->nodes[id2];
 3540:          Node *node3 = elem->nodes[id3];
 3541:          Node *node4 = elem->nodes[id4];         
 3542: 
 3543:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3544:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3545:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3546:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3547:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3548: 
 3549:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3550:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3551:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3552:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3553:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3554: 
 3555:          // Computes the different components of integral I_1 of each node with respect to node i.
 3556:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3557:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3558:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3559:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3560: 
 3561:          node1->addToSparseMatrix(node1, I1_ii);
 3562:          node1->addToSparseMatrix(node2, I1_ij); 
 3563:          node1->addToSparseMatrix(node3, I1_ik);
 3564:          node1->addToSparseMatrix(node4, I1_il);
 3565:   
 3566:       } 
 3567: 
 3568:  
 3569:       // Integral I_4
 3570:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3571:       // Where
 3572:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3573: 
 3574:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3575:       // of U over the element.
 3576:       Vector2 U = {0.0, 0.0};
 3577:       for (int m=0; m < elem->i34; m++) {      
 3578:          const Side *side = elem->sides[m];
 3579: 
 3580:          if constexpr(ics == 1) U += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3581:          else                   U += side->frame.project_hvec(side->U, elem->frame);
 3582:       }
 3583:       U = U/elem->i34;
 3584: 
 3585: 
 3586:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3587: 
 3588: 
 3589:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3590:       const double I_4_1 = dot(gradPhi_1, U);
 3591: 
 3592: 
 3593:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3594:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3595: 
 3596:      
 3597:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3598: 
 3599:       // Additional terms 
 3600:       double vnorm = 0.0;
 3601:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3602:          Vector3 ubed = {0.0, 0.0, 0.0};
 3603:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3604: 
 3605:          Vector3 gradP = {0.0, 0.0, 1.0};
 3606:          for (int m=0; m < elem->i34; m++) {
 3607:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3608:            gradP += toVector3(gradP_2D, 0.0);
 3609:          }   
 3610:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3611:       } // imm==2
 3612: 
 3613:       if (elem->isTri()) {
 3614:          for (int l=0; l<3; l++) {
 3615: 
 3616:             Node *node = elem->nodes[l];
 3617: 
 3618:             double fac = (node == node1) ? 2.0 : 1.0;
 3619:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3620:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3621:            
 3622:          }
 3623: 
 3624: 
 3625:          if (!elem->isDry) {
 3626:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3627: 
 3628:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3629: 
 3630:          }
 3631: 
 3632:       } // isTri
 3633:       else { // isQuad
 3634:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3635:          // for (int l=0; l<4; l++) {
 3636:          //   const Node *node = elem->nodes[l];
 3637: 
 3638:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3639:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3640: 
 3641:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3642:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3643:          // }
 3644: 
 3645:       } // isQuad
 3646: 
 3647: 
 3648:      node1->qel += (dt/elem->i34)*elem->vsource;
 3649:       
 3650: 
 3651:    } // for all elements connected to the node
 3652:    
 3653: 
 3654:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3655:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 3656:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3657:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3658:       // If it is an open boundary node...
 3659: 
 3660:       // At least one open bnd side, maybe two
 3661:       for (int l=0; l<2; l++) { 
 3662: 
 3663:          // Gets each of the sides sharing the node. 
 3664:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3665: 
 3666:        
 3667: 
 3668:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3669:          if (sideBnd != nullptr) {
 3670:             // If the side is on a boundary...
 3671: 
 3672:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3673: 
 3674:             // Get the boundary segment
 3675:             const BoundarySegment *sideSegment = sideBnd->segment;
 3676:             const Side *side = sideBnd->side;
 3677: 
 3678:             // Integral I_3
 3679:             if (sideSegment->ifltype != 0) {
 3680:             // Natural or Flather b.c.
 3681: 
 3682:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3683:                // especially for Flather b.c.
 3684:                double ri3 = 0.0;
 3685:                if (!side->isDry) {
 3686:                   // If the side is not dry
 3687:                   
 3688:                   // Computes the side flux of (uth, vth)
 3689:                   double Vn = 0.0;
 3690:                   for (int k = side->kb; k < nvrt - 1; k++) {
 3691:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3692:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3693: 
 3694:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 3695:                   }
 3696: 
 3697:                   ri3 = 0.5*side->len*Vn;
 3698:                }
 3699: 
 3700:                if (sideSegment->ifltype == -1) { // Flather 1
 3701: 
 3702:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3703:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3704: 
 3705:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3706:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3707:                   
 3708:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3709:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3710: 
 3711:                } 
 3712:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3713:                   // Reset ri3
 3714:                   ri3 = 0.0;
 3715: 
 3716:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3717: 
 3718:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3719: 
 3720:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3721:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3722: 
 3723:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3724:                   node1->addToSparseMatrix(node1, con0*2.0);
 3725:                   node1->addToSparseMatrix(node2, con0);
 3726: 
 3727:                } // if Flather or Discharge
 3728: 
 3729:                node1->qel -= thetai*dt*ri3;
 3730: 
 3731: 
 3732:             } // I_3
 3733:           
 3734: 
 3735:             // Integral I_5
 3736:             if(!side->isDry) {
 3737: 
 3738:                const double Unbar = dot(side->U, side->n);
 3739:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3740: 
 3741:             } // I_5
 3742: 
 3743:          } // if is boundary side
 3744: 
 3745:       } // for l
 3746: 
 3747:    } // if isbnd
 3748: 
 3749: 
 3750: }
 3751: 
 3752: 
 3753: 
 3754: extern "C" {
 3755:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 3756:                                   int* indices, int* indptr) {
 3757: 
 3758:       NODE(node);
 3759:       
 3760:       const int idx = node->idx;
 3761:       
 3762:       // Computes the index in the nzz array      
 3763:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 3764: 
 3765: 
 3766:       indptr[idx] = nzzIdx;
 3767:       indices[nzzIdx] = idx;
 3768: 
 3769:       data_d[nzzIdx]    = node->coeffDiag;
 3770: 
 3771:       b_d[idx] = node->qel;
 3772: 
 3773:       for (int k = 0; k < node->numNodes; ++k) {
 3774:          const Node* nb = node->nodes[k];
 3775: 
 3776:          const int j = nb->idx;
 3777: 
 3778:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 3779: 
 3780:          indices[nzzIdx + k + 1] = j;
 3781:       }
 3782: 
 3783:  
 3784:    }
 3785: 
 3786: 
 3787: 
 3788:    __global__ void solverCopyResult(double* x) {
 3789:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 3790:       NODE(node);
 3791:       const int idx = node->idx;
 3792: 
 3793:       node->mX = x[idx];
 3794:    }
 3795: 
 3796: 
 3797:    __global__ void rollUpElevation(void) {
 3798: 
 3799:       NODE(node);
 3800: 
 3801:       node->eta1 = node->eta2;
 3802: 
 3803:    }
 3804: 
 3805: 
 3806:    __global__ void backtrackAllNodes(void) {
 3807: 
 3808:       // max/min # of sub-divisions
 3809:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 3810:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 3811: 
 3812: 
 3813:       SIDE(side);
 3814: 
 3815:       const int kb = side->kb;
 3816: 
 3817: 
 3818:       // Initialize btrack velocities to the actual velocities at the side 
 3819:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3820: 
 3821:   
 3822: 
 3823:       if (side->isDry) return;
 3824:       
 3825: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 3826: 
 3827:       // Checks that at least one element is not dry
 3828:       const Element *elem1 = side->elems[0];
 3829:       const Element *elem2 = side->elems[1];
 3830: 
 3831: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 3832: 
 3833:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3834:       
 3835:       // XXXXXX
 3836:       // !swild_tmp to store global coord. of the starting side
 3837:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3838:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3839:       // !Use sframe2 
 3840:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3841: 
 3842: 
 3843:       for (int k = kb; k < nvrt; k++) {
 3844:       //  Initialize (xt,yt,zt), nnel and vel.
 3845:       //  For ics=2, the coordinates are in local frames
 3846:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3847: 
 3848: 
 3849:          const int iadvf = side->iadv();  // Advection flag   
 3850:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 3851: 
 3852:          Point3 xt;
 3853:          if constexpr(ics==1) {
 3854:             xt = side->center3D(k); 
 3855:          }
 3856:          else // lat/lon; in side lat/lon frame
 3857:          {
 3858:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3859:          // XXX IMPLEMENT THIS
 3860:       //          xt=0.d0
 3861:       //          yt=0.d0
 3862:       //          !centroid coord. for nudging
 3863:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3864:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3865:          }  // ics
 3866: 
 3867: 
 3868: 
 3869:          // If on land or open boundary...
 3870:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3871:          
 3872:          const double vmag = length(side->u2[k]);
 3873: 
 3874:          if (vmag <= velmin_btrack) {
 3875:             // No activity 
 3876: 
 3877:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 3878: // addDebugPlot(side->center, side->center, 0x00000F, '+');     
 3879: 
 3880: 
 3881:             
 3882:          } else {  // do btrack
 3883: 
 3884:             // Compute number of sub-divisions based on local gradients of the velocity field
 3885: 
 3886:             // XXX IS THIS NECESSARY?
 3887:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 3888:             double suma = 0.0;
 3889:             int icount = 0;
 3890:             for (int l=0; l<2; l++) {
 3891:             // For each element sharing the side...
 3892: 
 3893:                const Element *elem = side->elems[l];
 3894:                  
 3895:                if (elem == nullptr) continue;
 3896: 
 3897:                icount++;
 3898: 
 3899:                // Not strictly along z; in ll frame for ics=2
 3900: 
 3901:                double utmp[4];
 3902:                double vtmp[4];
 3903:                for (int j = 0; j < elem->i34; j++) {
 3904: 
 3905:                   const Node *node = elem->nodes[j];
 3906: 
 3907:                   if constexpr(ics==1) {
 3908:                      utmp[j] = node->u2[k].x;
 3909:                      vtmp[j] = node->u2[k].y;  
 3910:                   } else {
 3911:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3912:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(j),vtmp0(j))
 3913:                   }
 3914:                } // for j
 3915: 
 3916:                const Vector2 grad_u = elem->grad2(utmp); 
 3917:                const Vector2 grad_v = elem->grad2(vtmp);
 3918: 
 3919:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3920:             } // for ii
 3921: 
 3922:             assert(icount > 0 && "Impossible 77");
 3923: 
 3924:             // '4' is somewhat arbitrary
 3925:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3926: 
 3927:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3928: 
 3929:             Vector3 u_int = {0.0, 0.0, 0.0};
 3930: 
 3931:             bool res =side->btrack(k, dt, dtbk, u_int);
 3932: 
 3933:             side->btu[k] = toVector2(u_int);
 3934:                
 3935:          } // if vmag (do backtrack)
 3936: 
 3937: 
 3938:       } // for k=kb,nvrt-1
 3939: 
 3940:    }
 3941: 
 3942: } // extern "C"
 3943: 
 3944: template<int nc>
 3945: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3946: 
 3947: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3948: //
 3949: // a,b,c,rhs: input vectors and are not modified by this program.
 3950: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3951: // rhs is the r.h.s.
 3952: // n: actual rank of the system.
 3953: // rows in u() and rhs();
 3954: // u: output with nc columns (transposed to rows)
 3955: // gam: a working array.
 3956: //
 3957: // NOTES:
 3958: // This is a template function that allows for different numbers of columns in the rhs vector.
 3959: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3960: 
 3961:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3962:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3963: 
 3964:    double bet = b[0];
 3965:    if constexpr (nc == 1) {
 3966:       u[0] = rhs[0]/bet;
 3967:    } else {
 3968:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 3969:    }
 3970: 
 3971:    for (int j = 1; j < n; j++) {
 3972:       gam[j] = c[j - 1]/bet;
 3973:       bet = b[j] - a[j]*gam[j];
 3974: 
 3975:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3976: 
 3977:       if constexpr (nc == 1) {
 3978:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3979:       } else {
 3980:          for (int l = 0; l < nc; l++) {
 3981:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 3982:          }
 3983:       }
 3984:    }
 3985: 
 3986:    // Back-substitution
 3987:    for (int j = n - 2; j >= 0; j--) {
 3988:       if constexpr (nc == 1) {
 3989:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 3990:       } else {
 3991:          for (int l = 0; l < nc; l++) {
 3992:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 3993:          }
 3994:       }
 3995:    }
 3996: }
 3997: 
 3998: 
 3999: 
 4000: // Helper function that contains the core algorithm
 4001: template<typename XAccessor, typename YAccessor>
 4002: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4003:                                     double  yp_top, double  yp_bot, 
 4004:                                     CubicSpline &spline) {
 4005:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4006:    // 
 4007:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4008:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4009:    //
 4010:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4011:    // 
 4012:    // Inputs: 
 4013:    //            n: dimension for x etc; # of data pts (>=2);
 4014:    //            getX, getY: functions to access x,y coordinates
 4015:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4016:    //     Output: 
 4017:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4018: 
 4019:    const int n = k2 - k1 + 1;
 4020:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4021: 
 4022:    // Allocate memory for the splines
 4023:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4024:    spline.x   = new double[n];
 4025:    spline.y   = new double[n];
 4026:    spline.yp  = new double[n];
 4027:    spline.ypp = new double[n];
 4028: 
 4029:    for (int k=k1; k<=k2; k++) {
 4030:       spline.x[k] = getX(k);
 4031:       spline.y[k] = getY(k);
 4032:    }
 4033: 
 4034:    // This is to simplify expressions later
 4035:    double *x = spline.x;
 4036:    double *y = spline.y;
 4037: 
 4038:    double *a = nullptr;
 4039:    double *b = nullptr;
 4040:    double *c = nullptr;
 4041:    double *gam = nullptr;
 4042:    double *rhs = nullptr;
 4043:    
 4044: 
 4045:       a = new double[n];   // Lower diagonal
 4046:       b = new double[n];   // Diagonal
 4047:       c = new double[n];   // Upper diagonal
 4048:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4049:       rhs = new double[n]; // Right-hand side
 4050: 
 4051:    for (int k=k1; k<=k2; k++) {
 4052:       if (k == k1) {
 4053:          // Bottom level
 4054:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4055:          b[k] = (x[k+1] - x[k])/3.0;
 4056:          c[k] = b[k]/2.0;
 4057:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4058:       } else if (k == n - 1) {
 4059:          // Top level (surface)
 4060:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4061:          b[k] = (x[k] - x[k-1])/3.0;
 4062:          a[k] = b[k]/2.0;
 4063:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4064:       } else {
 4065:          // Intermediate levels
 4066:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4067:          b[k] = (x[k+1] - x[k-1])/3.0;
 4068:          a[k] = (x[k  ] - x[k-1])/6.0;
 4069:          c[k] = (x[k+1] - x[k  ])/6.0;
 4070:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4071:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4072:       }
 4073:    }
 4074: 
 4075:    // Solve the tridiagonal system
 4076:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4077:    
 4078:    spline.yp[k1] = yp_bot;
 4079:    spline.yp[k2] = yp_top;
 4080: 
 4081:    // Compute rest of 1st derivatives using the splines
 4082:    for (int k=k1+1; k<k2; k++) {
 4083:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4084:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4085:    }
 4086:    
 4087:    delete[] a;
 4088:    delete[] b;
 4089:    delete[] c;
 4090:    delete[] gam;
 4091:    delete[] rhs;
 4092: 
 4093: }
 4094: 
 4095: // Array version
 4096: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4097:                                 double y_top, double y_bot, 
 4098:                                 CubicSpline &spline) {
 4099:    auto getX = [x] (int k) { return x[k]; };
 4100:    auto getY = [y] (int k) { return y[k]; };
 4101:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4102: }
 4103: 
 4104: // Lambda version - allows custom access patterns
 4105: template<typename XFunc, typename YFunc>
 4106: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4107:                                 double y_top, double y_bot,
 4108:                                 CubicSpline &spline) {
 4109:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4110: }
