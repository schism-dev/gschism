 9322: extern "C" __global__ void getElementVar(int varCode, void *res, int k) {
 9323:    ELEM(elem);
 9324: 
 9325:    switch (varCode) {
 9326:       case (int)VarCode::outputCoords: {
 9327:          const Point2 coords = elem->outputCoords();
 9328:          double *out = (double *)((char *)res + idx_elem * 16);
 9329:          out[0] = coords.x;
 9330:          out[1] = coords.y;
 9331:          break;
 9332:       }
 9333:       case (int)VarCode::FaceIndices: {
 9334:          uintptr_t *out = (uintptr_t *)((char *)res + idx_elem * 32);
 9335:          for (int j = 0; j < 4; j++)
 9336:             out[j] = (j < elem->i34 && elem->nodes[j]) ? elem->nodes[j]->idx + 1 : -1;
 9337:          break;
 9338:       }
 9339:       case (int)VarCode::isdry:
 9340:          *(int *)((char *)res + idx_elem * 4) = (int)elem->isDry;
 9341:          break;
 9342:       case (int)VarCode::w: {
 9343:          double *out = (double *)((char *)res + idx_elem * nvrt * 8);
 9344:          if (k >= 0)
 9345:             out[0] = elem->w[k];
 9346:          else
 9347:             for (int lev = 0; lev < nvrt; lev++)
 9348:                out[lev] = elem->w[lev];
 9349:          break;
 9350:       }
 9351:    }
 9352: }
