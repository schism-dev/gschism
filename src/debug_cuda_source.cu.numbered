 8022:       // case (int)VarCode::depth:
 8023:       //    *offset = (int)((char*)&sides[0].depth - (char*)sides);
 8024:       //    *sizeType = sizeof(double);
 8025:       //    break;         
 8026:       case (int)VarCode::x:
