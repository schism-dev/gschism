 2562: 
 2563: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2564: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2565: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 2566: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 2567: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2568: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2569:    Vector2 grad = {0.0, 0.0};
 2570:    int count = 0;
 2571: 
 2572:    if constexpr(ics == 2) assert(false && "grad2: ics = 2 not implemented");
 2573: 
 2574:    // First element
 2575:    if (elems[0] != nullptr && condition(elems[0])) {
 2576:       grad += elems[0]->grad2(field);
 2577:       count++;
 2578:    }
 2579: 
 2580:    // Second element
 2581:    if (elems[1] != nullptr && condition(elems[1])) {
 2582:       grad += elems[1]->grad2(field);
 2583:       count++;
 2584:    }
 2585: 
 2586:    if (count > 0) {
 2587:       grad = grad*(1.0/count);
 2588:    }
 2589:    
 2590:    return grad;
 2591: }
