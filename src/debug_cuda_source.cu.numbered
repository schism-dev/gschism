 2305: /**
 2306:  * Find the element that contains the target point.
 2307:  * 
 2308:  * @param x0,y0,z0     Starting position coordinates
 2309:  * @param xt,yt,zt     Target position coordinates
 2310:  * @param dtb          Time step for tracking
 2311:  * @param u_int        Initial velocity components
 2312:  * @param nextElem     Starting/resulting element index
 2313:  * 
 2314:  * @return Status code of type trackExitCodes
 2315:  * 
 2316:  * Uses the Leaded Celestial Walk algorithm to find the element that contains the target point.
 2317:  * This is a variant of the Celestial Walk algorithm that goes from element A containing the starting 
 2318:  * point x0 (in one side) to element B containing the target point xt. To enforce that the next element is
 2319:  * as close the the segment AB as possible, the next point at each iteration is computed
 2320:  * along segment AB, but just after the current element.
 2321:  */
 2322: 
 2323: 
 2324: __device__ __forceinline__ bool celestialWalk(Element *&curElem, Point3 x0, Point3 &xt, const Side *origSide, Side *&lastCrossSide, int jlev) {
 2325: 
 2326:    constexpr int MAX_ITERATIONS = 40;
 2327: 
 2328:    int iter = 0;
 2329:    double fac = 0.00001;
 2330:    while (iter < MAX_ITERATIONS) {
 2331:       iter++;
 2332: 
 2333:       Bool4 isLeft, isObtuse, isBisector;
 2334:       curElem->computePredicates(toPoint2(x0), toPoint2(xt), fac, origSide, isLeft, isObtuse, isBisector, jlev);
 2335: // showPoints(x0, xt, jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2336:       Bool4 isValid = !isLeft & (!isObtuse | isBisector); // bitwise operation are overloaded
 2337: 
 2338: 
 2339:       if (isValid.none()) 
 2340:       // Inside the element if none of the edges is a valid continuation
 2341:       {
 2342:          // Just returns true and the element (curElem) is unchanged).
 2343:          // This means that the algorithm has found the element that contains the target point.
 2344:          return true;
 2345:       }
 2346:       else { // Outside the element
 2347: 
 2348:          // Outside this element. Pick the first valid exit side and cross.
 2349:          lastCrossSide = curElem->sides[isValid.firstOne()];
 2350:          Element *prevElem = curElem;
 2351:          curElem = lastCrossSide->otherElem(curElem);
 2352: 
 2353:          // If it crosses into a dry element or a boundary element, return false. This means that the track will now move 
 2354:          // along the boundary.
 2355:          if (curElem == nullptr || curElem->isDry) {
 2356:          
 2357:             curElem = prevElem;
 2358:             return false;
 2359:          }
 2360:          
 2361:       }
 2362: 
 2363:    }
 2364: 
 2365:   assert(false && "Leaded Celestial Walk: exceeded max iterations");
 2366: }
 2367: 
