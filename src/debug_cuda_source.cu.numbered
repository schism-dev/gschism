 1590: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000) {
 1591:    // Lock the mutex
 1592:    lock(&debugPlotMutex);
 1593:  
 1594:    bool ok = true;
 1595:    if (debugPlotIdx == nullptr) ok = false;
 1596:    if (*debugPlotIdx >= 10000) ok = false;
 1597:    if (ok) {
 1598:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1599:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1600:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1601:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1602:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1603:       (*debugPlotIdx)++;
 1604:    }
 1605: 
 1606:    __threadfence();               // ensure all above writes are visible
 1607:    // Unlock the mutex
 1608:    unlock(&debugPlotMutex);
 1609: 
 1610: }
 1611: 
 1612: __device__ void addDebugPlot(Vector2 x1, Vector2 x2, unsigned int color = 0xFF0000) {
 1613:    addDebugPlot(toPoint3(x1, 0.0), toPoint3(x2, 0.0), color);
 1614: }
