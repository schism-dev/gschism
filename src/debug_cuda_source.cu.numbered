 3584: 
 3585: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3586:    if constexpr(ics == 1) {
 3587:       return center;
 3588: 
 3589:    } else {
 3590:       const Point2 p0 = n1->outputCoords();
 3591:       const Point2 p1 = n2->outputCoords();
 3592:       return (1.0/2.0)*(p0 + p1);
 3593: 
 3594:    }
 3595: }
 3596: 
 3597: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3598: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3599: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3600: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3601: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3602: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3603: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3604: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3605: // Computes the gradient of the field at the side center.
 3606:    Vector2 grad = {0.0, 0.0};
 3607:    int count = 0;
 3608: 
 3609:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3610:    // as the average of the gradients at each element.
 3611:    // First element
 3612:    if (elems[0] != nullptr && condition(elems[0])) {
 3613:       Vector2 elemGrad = elems[0]->grad2(field);
 3614: 
 3615:       // For ics=2, projects the element gradient from its frame to the side frame
 3616:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3617: 
 3618:       grad += elemGrad;
 3619: 
 3620:       count++;
 3621:    }
 3622: 
 3623:    // Second element
 3624:    if (elems[1] != nullptr && condition(elems[1])) {
 3625: 
 3626:       Vector2 elemGrad = elems[1]->grad2(field);
 3627: 
 3628:       // For ics=2, projects the element gradient from its frame to the side frame
 3629:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3630: 
 3631:       grad += elemGrad;
 3632: 
 3633:       count++;
 3634:    }
 3635: 
 3636:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3637:    if (count > 0) {
 3638:       grad = grad*(1.0/count);
 3639:    }
 3640:    
 3641:    return grad;
 3642: }
 3643: 
 3644: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 3645: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 3646: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 3647: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 3648: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 3649: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 3650: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 3651: 
 3652: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 3653: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 3654: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 3655: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 3656: 
 3657: 
 3658: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3659: 
 3660: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3661:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3662:    if constexpr(ics == 1) { 
 3663:       return 0.5*(n1->tau + n2->tau);
 3664: 
 3665:    } else {
 3666:       // Project the tau from the node frames to the side frame
 3667:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3668:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3669: 
 3670:       return 0.5*(stau1 + stau2);
 3671:    }
 3672: }
 3673: 
 3674: /**
 3675:  * This method performs backtracking from the side center until a time -dt back in time 
 3676:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3677:  * intermediate point.
 3678:  *
 3679:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3680:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3681:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3682:  * remaining time.
 3683:  * 
 3684:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3685:  * 
 3686:  * @param uuint, vvint, wwint: Velocities at the final point
 3687:  * @param jlev: Level at which the backtracking is performed
 3688:  * @param dt, dtbk: Tracking timesteps
 3689:   */
 3690: __inline__ __device__ void Side::btrack(
 3691:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3692:       double dt,            // Tracking time
 3693:       double dtbk,          // Tracking timestep
 3694:       Vector3 &u_int        // Velocities at the initial point
 3695: ) const {
 3696: 
 3697:    // Start from side center
 3698:    Point3 x0;
 3699: 
 3700:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3701:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3702: 
 3703:  
 3704:    double time_rm = dt; // Remaining time
 3705:    double time_rm_1 = 1e10;
 3706:    double time_rm_2 = 2e10;
 3707:    double time_rm_3 = 3e10;
 3708: 
 3709: 
 3710:    // Initial velocities
 3711:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3712: 
 3713:    // Find a non dry element for starting the backtracking. At this point there should be at least one.
 3714:    Element* curElem = (!elems[0]->isDry) ? elems[0] : elems[1];  // elems[0] is always non-null 
 3715: 
 3716:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3717: 
 3718: // showPoints(x0, x0, jlev, this, 0xFF0000u, 'x', 1, 0, 0);
 3719: 
 3720: 
 3721:    constexpr int MAX_ITERATIONS = 100; 
 3722:    int iter = 0;
 3723:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3724:    while(true) {
 3725: 
 3726:       // Calculate timestep
 3727:       const double dtb = min(dtbk, time_rm);
 3728: 
 3729:       // Next point in the backtracking curve
 3730:       xt = x0 - dtb*u_int;
 3731: 
 3732:       double t, s; // parameters for the line segments p0pt and p1p2
 3733:       Side *lastCrossSide = nullptr;
 3734:       const bool found = celestialWalk(curElem, x0, xt, this, lastCrossSide, jlev);
 3735: 
 3736: 
 3737:       if (time_rm_3 <= time_rm) {
 3738:       // If backtracking gets stuck, we stop the backtracking and use the velocity at the last x0.
 3739:          xt = x0;
 3740:          break;
 3741:       }
 3742: 
 3743: 
 3744:       if (!found) {
 3745:       // This means that the walk reached a boundary or a dry element.
 3746: 
 3747:          assert(lastCrossSide!=nullptr && "lastCrossSide is nullptr");
 3748: 
 3749:          // Finds the point at the boundary where the line segment x0xt intersects.
 3750:          // Here we will assume that it does intersect the boundary segment, even if in some cases,
 3751:          // due to floating point errors, it does not exactly intersect.
 3752:          // We call p1 and p2 the 2D points of the boundary segment. p0, pt are the 2D versions of x0 and xt.
 3753:          // v1 is the vector from p0 to pt, v2 is the vector from p1 to p2.
 3754:          // To compute the intersection point we start with the parametric equations.
 3755:          // p1 + t*v2 = p0 + s*v1,    t, s in [0,1]
 3756:          // We cross-prouct by v1 to cancel the s term:
 3757:          // cross(v2, v1)*t = cross(p0 - p1, v1)
 3758:          // t = cross(p0 - p1, v1) / cross(v2, v1)
 3759: 
 3760:          // Side coordinates in the origSide frame.
 3761:          const Point2 p1 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n1->p, lastCrossSide->n1->gz)));
 3762:          const Point2 p2 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n2->p, lastCrossSide->n2->gz)));
 3763: 
 3764:          Point2  p0 = {x0.x, x0.y};
 3765:          Point2  pt = {xt.x, xt.y};
 3766: 
 3767:          const Vector2 v1 = pt - p0;
 3768:          const Vector2 v2 = p2 - p1;
 3769: 
 3770: 
 3771: 
 3772:          // We are assuming intersection, so we clamp t to the range [0,1].
 3773:          const double denom = cross(v2, v1);
 3774:          
 3775: 
 3776: 
 3777: 
 3778:          if (abs(denom) < small) {
 3779:             // small denominators are fairly common. They occur when the line segment x0xt 
 3780:             // is parallel to the boundary segment. This occurs after a "collision" with the
 3781:             // boundary, where the backtracking curve startt sliding along the boundary.
 3782:             // In this case, we simply assume that the two lines are very close to each other
 3783:             // and simply compute the closest point to xt (s = 1.0) on the boundary segment (clamped to p1p2)
 3784:             t = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3785:             if (t<0.0000000001) t = 0.0;
 3786:             if (t>0.9999999999) t = 1.0;
 3787: 
 3788:             // s = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3789:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3790: 
 3791:          }
 3792:          else {
 3793:             
 3794:             t = clamp(cross(p0 - p1, v1) / denom, 0.0, 1.0);
 3795:             if (t<0.0000000001) t = 0.0; // XXXXX use constants
 3796:             if (t>0.9999999999) t = 1.0;
 3797:             // From the originaL equation we can solve for s:
 3798:             // p1 + t*v2 = p0 + s*v1    =>   s*v1 = p1 + t*v2 - p0 
 3799:             // Computing the dot product by v1, we get:
 3800:             // s = dot((p1 + t*v2 - p0), v1) / dot(v1, v1)
 3801:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3802:             if (s<0.0000000001) s = 0.0; // XXXXX use constants
 3803: 
 3804:          }
 3805: 
 3806:          assert(curElem!=nullptr && !curElem->isDry && "curElem is nullptr or dry");
 3807: 
 3808: 
 3809:          // We update the new target point to be right at the intersection point,
 3810:          // and the remaining time must include the time we haven't "used".
 3811:          time_rm -= s*dtb;
 3812:          xt = toPoint3(p1 + t*v2, x0.z + s*(xt.z - x0.z)); // I use p1,p2 to compute the intersection point to ensure that it is on the boundary, but the z-coordinate is the same as x0.z
 3813: 
 3814: 
 3815:          // If it is an open boundary, just exits the loop. No sliding along the boundary is performed.
 3816:          if (lastCrossSide->sideBnd!=nullptr && !lastCrossSide->sideBnd->segment->isLand) break;
 3817: 
 3818:          // If it is not an open boundary, the velocity for the next step is computed by interpolating the velocities at the intersection point.
 3819:          // but extracting only the component along the tangent vector v2.
 3820:          Vector2 tangent = normalize(v2);
 3821:          const Vector3 u = curElem->interpolateVelocities(xt, this);
 3822: 
 3823:          const Vector2 u2D = make_double2(u.x, u.y);
 3824:          u_int = toVector3(dot(u2D, tangent)*tangent, u.z);
 3825: 
 3826: 
 3827:       } else {
 3828: 
 3829:          assert(curElem!=nullptr && !curElem->isDry && "Final element is dry or boundary side");
 3830: 
 3831:          time_rm -= dtb; 
 3832: 
 3833:          u_int = curElem->interpolateVelocities(xt, this);
 3834: 
 3835:       }
 3836: 
 3837:       if (time_rm <= 0.0) break; 
 3838: 
 3839:       // If the velocity is too small, we stop the backtracking
 3840:       const double vmag2 = norm2(toVector2(u_int));
 3841:       if (vmag2 <= velmin_btrack_sq)  {
 3842:          time_rm = 0.0; 
 3843:          return; 
 3844:       }
 3845: 
 3846:       // The current point becomes the next segment's starting point.
 3847:       x0 = xt;
 3848:  
 3849:       iter++;
 3850: 
 3851: // XXXXXXXXXXXXXXXXX
 3852: if (iter == 38) {printf("*****iter = %d, time_rm = %.17f\n", iter, time_rm); return;}
 3853:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3854: 
 3855:       assert(time_rm_3 > time_rm && "time_rm is not decreasing");
 3856:       time_rm_3 = time_rm_2;
 3857:       time_rm_2 = time_rm_1;
 3858:       time_rm_1 = time_rm;
 3859:    }
 3860: 
 3861:    assert(curElem != nullptr && "Final element is nullptr");
 3862:    assert(!curElem->isDry && "Final element is dry");
 3863:    
 3864: 
 3865: 
 3866:    // Interpolate the velocities at the final point with respect to the current side frame
 3867:    u_int = curElem->interpolateVelocities(xt, this);
 3868: 
 3869: 
 3870: }
 3871: 
 3872: 
 3873: 
 3874: __device__ __forceinline__ int Node::localIndex() const {
 3875:    // Returns the local index of the node in the partition
 3876:    // Local index is just the offset from the start of the partition's node memory
 3877:    return int(this - mesh->nodes[part]);
 3878: }
