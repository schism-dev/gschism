 7500:          break;            
 7501:       // case (int)VarCode::w:
 7502:       //    *offset = (int)((char*)&sides[0].w2 - (char*)sides);
 7503:       //    *sizeType = sizeof(double);
 7504:       //    break;
 7505:       case (int)VarCode::u:
 7506:          *offset = (int)((char*)&sides[0].u2[0].x - (char*)sides);
 7507:          *sizeType = sizeof(Vector2);
 7508:          break;   
 7509:       case (int)VarCode::btu:
 7510:          *offset = (int)((char*)&sides[0].btu[0].x - (char*)sides);
 7511:          *sizeType = sizeof(Vector2);
 7512:          break;          
 7513:       case (int)VarCode::U:
 7514:          *offset = (int)((char*)&sides[0].U.x - (char*)sides);
 7515:          *sizeType = sizeof(Vector2);
 7516:          break;
 7517:       // case (int)VarCode::ghat:
