 6485:    __global__ void resetBoundaryAreas(void) {
 6486:       // Reset boundary areas and lengths for each segment.
 6487: 
 6488:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 6489:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 6490:       SIDE_BND(sideBnd);
 6491: 
 6492:       BoundarySegment *segment = sideBnd->segment;
 6493: 
 6494:       segment->carea = 0.0;
 6495:       segment->clen = 0.0;
 6496:  
 6497:    }
 6498: 
 6499:    __global__ void computeBoundaryAreas(void) {
 6500:    // Calculation of cross-section areas and lengths for flow b.c.
 6501: 
 6502:       SIDE_BND(sideBnd);
 6503: 
 6504:       const Side *side = sideBnd->side;
 6505:       BoundarySegment *segment = sideBnd->segment;
 6506: 
 6507:       if (segment->ifltype != 0) {
 6508: 
 6509:          const Node *n1 = side->n1;
 6510:          const Node *n2 = side->n2;
 6511: 
 6512:          const double htot = side->htot2();
 6513: 
 6514:          if (!side->isDry) {
 6515:             atomicAdd(&segment->carea, htot*side->len);
 6516:             atomicAdd(&segment->clen, side->len);
 6517:          }
 6518:       }
 6519: 
 6520:    }
 6521: 
 6522: 
 6523:    __global__ void computeFlowBcVelocities(double time) {
 6524: 
 6525:       SIDE_BND(sideBnd);
 6526: 
 6527:       const Side *side = sideBnd->side;
 6528:  
 6529:       const bool isDry = side->isDry;
 6530:       const bool isLand = sideBnd->segment->isLand;
 6531: 
 6532:    
 6533:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 6534: 
 6535:       if (isDry || isLand) return;
 6536: 
 6537:       // For wet sides in open boundaries...
 6538:       const Vector2 n = side->n;
 6539:       const BoundarySegment *segment = sideBnd->segment;
 6540: 
 6541:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 6542: 
 6543:       const int ifltype = segment->ifltype;
 6544: 
 6545:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 6546:       const Vector2 r_nuth0 = r_uth0*n;
 6547: 
 6548: 
 6549:       if (ifltype == 1 || ifltype == 2) {
 6550:       
 6551:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 6552: 
 6553:          const double unth0 = segment->qthcon*ramp/segment->carea;
 6554: printf("unth0: %f, qthcon: %f, ramp: %f, carea: %f\n", unth0, segment->qthcon, ramp, segment->carea);         
 6555:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 6556:          
 6557:       } else if (ifltype == -1) { // Flather 1
 6558: 
 6559:          for (int k = 0; k < nvrt; k++) {
 6560: 
 6561:             // uth is the normal vel.; no ramp up
 6562:             const double uth = sideBnd->nuth(k);
 6563:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 6564: 
 6565:             sideBnd->ubc[k] += uth*n;
 6566:          }
 6567: 
 6568:       } else if (ifltype == 3 || ifltype == 5) {
 6569:          // vnth0=0 !normal vel.
 6570: 
 6571:          Vector2 r_u1_bar = {0.0, 0.0};
 6572:          // Computes the contribution to the velocity from all tide frequencies
 6573:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 6574: 
 6575:             const Vector2 ufa  = sideBnd->ufa[jfr]; 
 6576:             const Vector2 umo  = sideBnd->umo[jfr]; 
 6577: 
 6578:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 6579:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 6580:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 6581:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 6582: 
 6583:          }
 6584: 
 6585: 
 6586:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 6587: 
 6588:       } // if (ifltype = 3 || ifltype == 5
 6589: 
 6590: 
 6591: 
 6592:    }
 6593: 
 6594:    __global__ void computeElevationBoundaryConditions(double time) {
 6595:       // Compute elevation essential boundary conditions 
 6596: 
 6597:       NODE_BND(nodeBnd); // Each boundary node.
 6598: 
 6599:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 6600: 
 6601:       const Node *node = nodeBnd->node;
 6602:       const BoundarySegment *segment = nodeBnd->segment;
 6603:       const int iettype = segment->iettype;
 6604:       
 6605: 
 6606:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 6607:       double eic = 0.0;
 6608:       if (nramp_elev == 1) eic = nodeBnd->etaic;  // XXXX is etaic ever set?  
 6609:       else                 eic = 0.0;
 6610: 
 6611:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 6612:       const double r_eth = ramp*nodeBnd->eth;
 6613:       double r_eta1_bar = 0.0;
 6614: 
 6615:       // Compute tide elevation
 6616:       if (iettype == 3 || iettype == 5) {   
 6617: 
 6618:          if constexpr(iloadtide==1) { // loading tide
 6619:             assert(false && "Loading tide not implemented");
 6620:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 6621:          }
 6622:          
 6623:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 6624: 
 6625:             const double efa  = nodeBnd->efa[jfr]; 
 6626:             const double emo  = nodeBnd->emo[jfr]; 
 6627: 
 6628:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 6629:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 6630:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 6631: 
 6632: 
 6633:          } // for jfr
 6634: 
 6635:       } // if iettype
 6636: 
 6637:       switch (iettype) {
 6638:          case 1:
 6639:          case 2:
 6640:          case 4:
 6641:             nodeBnd->elbc = r_eic + r_eth;
 6642:             break;
 6643:          case 3:
 6644:             nodeBnd->elbc = r_eic + r_eta1_bar;
 6645:             break;
 6646:          case 5:
 6647:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 6648:             break;
 6649:       } // switch
 6650: 
 6651: 
 6652:       //Add inverse barometric effects
 6653:       if (iettype != 0 && inv_atm_bnd == 1) {
 6654:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 6655:       }
 6656: 
 6657:    }
 6658: 
 6659: 
 6660:    __global__ void computeHorizontalViscosity(void) { 
 6661: 
 6662:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 6663: 
 6664:       SIDE(side);
 6665: 
 6666:       if (side->isDry) return;
 6667: 
 6668:       for (int k = 0; k < nvrt; k++) {
 6669:          side->nuGradU[k] = {0.0, 0.0};
 6670:       }
 6671: 
 6672:       if constexpr(ihorcon == 1) {
 6673:          for (int k = side->kb; k < nvrt - 1; k++) {
 6674:             // Computes the Laplacian by using the simplified formula presented in the paper:
 6675:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 6676:             // By Zhang and Baptista.
 6677: 
 6678:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 6679:             // This is a standard discretization of the Laplacian operator.
 6680:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 6681:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 6682:             // Gamma is hvis_coef0 in the code.
 6683:             // The value of gamma needs to be < 0.5.
 6684: 
 6685:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 6686:             // side under consideration in each of the two possible elements that share the side.
 6687:             Vector2 sumU = {0.0, 0.0};
 6688:             for (int l = 0; l < 2; l++) {
 6689:                const Element *elem = side->elems[l];
 6690: 
 6691:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 6692: 
 6693:                // Find the local index of the side in the element
 6694:                const int idxSide = elem->sideLocalIdx(side);
 6695: 
 6696:                // Find the two sides that are connected to the side under consideration
 6697:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 6698:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 6699: 
 6700:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 6701: 
 6702:             }
 6703: 
 6704:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 6705: 
 6706:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 6707:    
 6708:          }
 6709:       }
 6710:       else if constexpr(ihorcon == 2) {
 6711:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 6712:       }
 6713: 
 6714: 
 6715:    }
 6716: 
 6717: 
 6718:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 6719: 
 6720:       // Set essential boundary conditions 
 6721:       NODE(node); // Each boundary node
 6722:       NodeBoundary *nodeBnd = node->nodeBnd;
 6723:       
 6724:  
 6725:       // Check if this node has essential BC
 6726:       if (nodeBnd && nodeBnd->isEssentialBC) {
 6727: 
 6728:          // Verify BC value is valid
 6729:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 6730: 
 6731:        
 6732:          // Set diagonal to 1 and zero off-diagonals
 6733:          for (int j = 0; j <= node->numNodes; j++) {
 6734:                node->coeffRow[j] = 0.0;
 6735:          }
 6736: 
 6737:          *(node->coeffDiag) = 1.0;
 6738: 
 6739: 
 6740:          // Set solution and RHS to BC value
 6741:          node->mX  = nodeBnd->elbc;
 6742:          node->qel = nodeBnd->elbc;
 6743: 
 6744:       } else {
 6745:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 6746: 
 6747:          for (int j = 0; j < node->numNodes; j++) {
 6748:                const Node* nbNode = node->nodes[j];
 6749:    	         assert(nbNode != nullptr && "setEssentialBC: nbNode is nullptr");
 6750: 
 6751:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 6752: 
 6753:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 6754:                   // Verify neighbor's BC value
 6755:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 6756: 
 6757:                   // Subtract contribution to RHS
 6758:                   node->qel -= node->coeffRow[node->csrSlot[j]]*nbNodeBnd->elbc;
 6759:                   node->coeffRow[node->csrSlot[j]] = 0.0;  
 6760:                }
 6761:          }
 6762: // printf("setEssentialBC: node->qel = nodeBnd->elbc - node->coeffMatrix[j]*nbNodeBnd->elbc\n");
 6763:       }
 6764:    }
