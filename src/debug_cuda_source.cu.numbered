 1034: struct Element {
 1035: 
 1036:    // Geometry information
 1037:    int idx;                   // Index of the element
 1038:    int16_t i34;               // Number of sides for the element 
 1039:    Side *sides[4];            // Sides of the element
 1040:    Node *nodes[4];            // Nodes of the element
 1041:    Element *nghbElems[4];     // Neighbors of the element
 1042: 
 1043:    int16_t kb;                // Bottom index of the element
 1044:    double area;               // Area of the element
 1045:    double ssign[4];           // Sign associated with each side of an element
 1046:    double radius;             // Element equivalent radii
 1047: 
 1048:    Frame<ics> frame;
 1049: 
 1050:    Vector2 gradPhi[4];        // Derivatives of shape functions
 1051:    Vector2 gradEta;           // Gradient of free surface elevation
 1052:    Vector2 gradPr;            // Gradient of pressure    
 1053:    Vector2 gradETP;           // Gradient of Earth Tidal Potential    XXXXX Really used?
 1054: 
 1055:    bool isDry;                // True if the element is dry
 1056: 
 1057:    Point2 center;            // Element center coordinates (global coordinates)
 1058: 
 1059:    double depth;              // Depth at element (min of all nodes)
 1060:    double z[nvrt];            // z-coord  (local frame - vertical up)
 1061: 
 1062:    // Physical information
 1063:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
 1064:    TransportElem<transportModel> transport; // Transport model 
 1065: 
 1066:    static const bool isblock = false;              // Always false
 1067: 
 1068:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
 1069:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
 1070: 
 1071:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
 1072:    
 1073: 
 1074:    double vsource;            // Volumetric source/sink term [m^3/s]
 1075: 
 1076:    double rho[nvrt];          // Density at each prism center
 1077:    double rho_mean[nvrt];     // Mean density at each prism center
 1078:    CubicSpline rho_spl;
 1079:    double rho_zz[nvrt];       // Second derivative of density at each prism center
 1080:    double rho_z[nvrt];        // First derivative of density at each prism center
 1081:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
 1082:    
 1083: 
 1084:    __inline__ __device__ Point2 outputCoords(void) const;
 1085: 
 1086:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }  
 1087: 
 1088:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1089:    // If ics == 2, convert the global point to the local frame of the element
 1090:       
 1091:       if constexpr (ics == 1) {
 1092:          return p;
 1093:       } else {
 1094:          const Point3 c = {center.x, center.y, centerZ()};
 1095:          return frame.G2L(p - c);
 1096:       }
 1097:    }
 1098: 
 1099:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1100:    // If ics == 2, convert the local point to a global point
 1101:       
 1102:       if constexpr (ics == 1) {
 1103:          return p;
 1104:       } else {
 1105:          const Point3 c = {center.x, center.y, centerZ()};
 1106:          return c + frame.L2G(p);
 1107:       }
 1108:    }
 1109: 
 1110:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
 1111:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
 1112: 
 1113:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
 1114:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
 1115: 
 1116:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
 1117:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
 1118:       // Find the local index of the node in the element (0,1,2,3)
 1119:       int res = __ffs((nodes[0] == node) | 
 1120:                      ((nodes[1] == node) << 1) | 
 1121:                      ((nodes[2] == node) << 2) | 
 1122:                      ((nodes[3] == node) << 3)) - 1;
 1123:       
 1124:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
 1125:       return res;  
 1126:    }
 1127: 
 1128:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
 1129:       // Find the local index of the side in the element (0,1,2,3)
 1130:       int res = __ffs((sides[0] == side) | 
 1131:                      ((sides[1] == side) << 1) | 
 1132:                      ((sides[2] == side) << 2) | 
 1133:                      ((sides[3] == side) << 3)) - 1;
 1134:       
 1135:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
 1136:       return res;
 1137:    }
 1138: 
 1139:    __inline__ __device__ int findLevel(double z1, int k) const {
 1140:       // Starting at index k, find sequentially the level that contains z
 1141: 
 1142:       // For testing purposes, forgets k and performs a full search.
 1143:       for (k = kb; k < nvrt - 1; k++) {
 1144:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
 1145:       }
 1146:       return nvrt - 2;
 1147: 
 1148: 
 1149:       // if z is already betweeen z[k] and z[k+1], return k
 1150:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
 1151:       else if (z1 <  z[k]) { 
 1152:          // Search for increasing levels
 1153:          for (int kk = k; kk < nvrt - 1; kk++) {
 1154:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
 1155:          }
 1156:          return nvrt - 1;
 1157:       }
 1158:       else {
 1159:          // Search for decreasing levels
 1160:          for (int kk = k; kk >= kb; kk--) {
 1161:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
 1162:          }
 1163:          return 0;
 1164:       }
 1165:    }
 1166: 
 1167:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
 1168:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
 1169:    __inline__ __device__ double volume(int k)  const { assert(k < nvrt - 1); return area * Dz(k); }
 1170: 
 1171: 
 1172:    __device__ __forceinline__ double centerZ(void) const;
 1173: 
 1174:    // "Local" horizontal coordinates at the nodes. They are computed from the 3D global node coordinates. For ics == 1 and 2
 1175:    // Local is in quotes because for ics == 1, the coordinates are unchanged. It just means that in these coordinates, the element is horizontal.
 1176:    __device__ __forceinline__ Point2 getLocalHorizontalNodePosition(int idxNode) const;
 1177:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2, 
 1178:                                                                        const Vector3& c, const Frame<ics>& dstFrame,int idx = 0) const;
 1179:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2, int idx = 0) const;
 1180:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3,
 1181:                                                                        const Vector3& c, const Frame<ics>& dstFrame) const;
 1182:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const;
 1183: 
 1184: 
 1185:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idxNode = 0,1,2,3)
 1186:    __device__ __forceinline__ Point2 GaussPoint(int idxNode) const {
 1187:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
 1188:        assert(idxNode >= 0 && idxNode < 4 && "GaussPoint: idxNode out of range");
 1189:        const double eta = (idxNode & 1) ? +g : -g;
 1190:        const double xi  = (idxNode & 2) ? +g : -g;
 1191:        return {eta, xi};
 1192:    }  
 1193: 
 1194: 
 1195: 
 1196:    // Shape function Phi at a given point p = (eta,xi), idxNode = node index 0,1,2,3
 1197:    __device__ __forceinline__ double Phi_quad(int idxNode, Point2 p) const {
 1198:       return 0.25*(1.0 + p.x*eta_n(idxNode))*(1.0 + p.y*xi_n(idxNode));
 1199:    }
 1200: 
 1201:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi)
 1202:    __device__ __forceinline__ double dPhi_dxi_quad(int idxNode, Point2 p) const {
 1203:       return 0.25*xi_n(idxNode)*(1.0 + p.x*eta_n(idxNode));
 1204:    }   
 1205: 
 1206:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
 1207:    __device__ __forceinline__ double dPhi_deta_quad(int idxNode, Point2 p) const {
 1208:       return 0.25*(1.0 + p.y*xi_n(idxNode))*eta_n(idxNode);
 1209:    }      
 1210:    
 1211:    __inline__ __device__ double detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
 1212: 
 1213:    __inline__ __device__ double detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
 1214: 
 1215:    __inline__ __device__ double detJ_quad(Point2 p, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const 
 1216:          { return (1.0/4.0)*area + detJ_eta_quad(x0, x1, x2, x3)*p.x+ detJ_xi_quad(x0, x1, x2, x3)*p.y; }
