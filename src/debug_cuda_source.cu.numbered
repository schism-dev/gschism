 3821: __device__ __forceinline__ int Node::localIndex() const {
 3822:    // Returns the local index of the node in the partition
 3823:    // Local index is just the offset from the start of the partition's node memory
 3824:    return int(this - mesh->nodes[part]);
 3825: }
 3826: 
 3827: 
 3828: __device__ __forceinline__ int Node::packedIndex() const {
 3829:    // Returns the packed index of the node
 3830:    // Packed index is the index of the partition-block matrices and vectors.
 3831:    return nodeOffsetPerPartition[part] + localIndex();
 3832: }
