  472: 
  473: __forceinline__ __device__ void computeLatLon(Point3 const &p, double &rlat, double &rlon) {
  474: // Given a 3D global point (may not be on the surface of the Earth), find its longitude and latitude in radians
  475: //
  476: 
  477:    const double radius2 = dot(p, p);
  478:    const double radius = sqrt(radius2);
  479:  
  480:    assert(radius != 0.0      && "computeLatLon: radius = 0");
  481:    assert(p.z*p.z <= radius2 && "computeLatLon: p.z <= radius");
  482: 
  483:    rlon = atan2(p.y, p.x); // (-pi,pi]
  484: 
  485:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  486:       rlat = asin(p.z/radius);
  487:    } else {
  488:       rlat = asin(p.z/rearth_pole);
  489:    }
  490:   
  491: }
  492: 
  493: 
  494: __forceinline__ __device__ Point3 computeXYZfromLatLon(double lat, double lon) {
  495: // Compute the 3D Cartesian coordinates from the latitude and longitude
  496: // Inputs:
  497: //        lat: latitude in radians
  498: //        lon: longitude in radians
  499: // Output:
  500: //        x, y, z: 3D Cartesian coordinates
  501: 
  502:    double sin_lat, cos_lat, sin_lon, cos_lon;
  503: 
  504:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeXYZfromLatLon: lat out of range");
  505:    assert(lon >= -pi     && lon <= pi &&     "computeXYZfromLatLon: lon out of range");
  506: 
  507:    sincos(lat, &sin_lat, &cos_lat);
  508:    sincos(lon, &sin_lon, &cos_lon);
  509: 
  510:    const double x = rearth_eq*cos_lat*cos_lon;
  511:    const double y = rearth_eq*cos_lat*sin_lon;
  512:    const double z = rearth_pole*sin_lat;
  513: 
  514:    return make_double3(x, y, z);
  515: }
