 2389: __device__ void lock(int *mutex) {
 2390:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 2391: }
 2392: 
 2393: __device__ void unlock(int *mutex) {
 2394:     atomicExch(mutex, 0);
 2395: }
