 5589: 
 5590:    __global__ void solverCopyResult(double* x) {
 5591:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 5592:       NODE(node);
 5593:       const int idx = node->idx;
 5594: 
 5595:       node->mX = x[idx];
