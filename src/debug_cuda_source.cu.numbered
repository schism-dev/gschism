10140: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
10141:    Node *nodes = mesh->localNodeData;
10142: 
10143:    *addr = nodes;
10144:    *sizeNode = sizeof(Node);
10145: 
10146:    switch (varCode) {
10147:       case (int)VarCode::depth:
10148:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
10149:          *sizeType = sizeof(double);
10150:          break;
10151:       case (int)VarCode::eta:
10152:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
10153:          *sizeType = sizeof(double);
10154:          break;
10155:       case (int)VarCode::x:
10156:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
10157:          *sizeType = sizeof(Vector2);
10158:          break;
10159:       case (int)VarCode::z:
10160:          *offset = (int)((char*)&nodes[0].z - (char*)nodes);
10161:          *sizeType = sizeof(double);
10162:          break;
10163:       case (int)VarCode::kb:
10164:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
10165:          *sizeType = sizeof(int);
10166:          break;
10167:       case (int)VarCode::isdry:
10168:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
10169:          *sizeType = sizeof(int);
10170:          break;         
10171:       case (int)VarCode::w:
10172:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
10173:          *sizeType = sizeof(double);
10174:          break;
10175:       case (int)VarCode::u:
10176:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
10177:          *sizeType = sizeof(Vector2);
10178:          break;  
10179:       case (int)VarCode::u_air:
10180:          *offset = (int)((char*)&nodes[0].u_air - (char*)nodes);
10181:          *sizeType = sizeof(Vector2);
10182:          break;
10183:       default:
10184:          *offset = -1;    
10185:    }  
10186:    
10187: }
