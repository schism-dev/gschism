 4020:    __global__ void computeFlowBcVelocities(double time) {
 4021: 
 4022:       SIDE_BND(sideBnd);
 4023: 
 4024:       const Side *side = sideBnd->side;
 4025:  
 4026:       const bool isDry = side->isDry;
 4027: 
 4028:       if (isDry) {
 4029:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4030:          return;
 4031:       }
 4032: 
 4033:       // For wet sides in open boundaries...
 4034:       const Vector2 n = side->n;
 4035:       const BoundarySegment *segment = sideBnd->segment;
 4036: 
 4037:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4038: 
 4039:       const int ifltype = segment->ifltype;
 4040:       const int iettype = segment->iettype;
 4041: 
 4042:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4043:       const Vector2 r_nuth0 = r_uth0*n;
 4044: 
 4045:       Vector2 r_uth    = {0.0, 0.0};    // r_ stands for ramp-up
 4046:       Vector2 r_u1_bar = {0.0, 0.0};
 4047: printf("ZZZ4  idx = %d, ifltype = %d, r_nuth0 = %f, %f\n", sideBnd->side->idx, ifltype, r_nuth0.x, r_nuth0.y);
 4048:       for (int k = 0; k < nvrt; k++) {
 4049:          if (ifltype == 1 || ifltype == 2) {
 4050:          
 4051:             assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4052: 
 4053:             const double unth0 = segment->qthcon*ramp/segment->carea;
 4054:             
 4055:             r_uth = unth0*n;  // This case has no ramp-up
 4056:             
 4057:          } else if (ifltype == -1) { // Flather 1
 4058: 
 4059:             // uth is the normal vel.; no ramp up
 4060:             const double uth = sideBnd->nuth(k);
 4061:             r_uth = uth*n;
 4062:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4063: 
 4064: 
 4065:          } else if (ifltype == 3 || ifltype == 5) {
 4066:             // vnth0=0 !normal vel.
 4067: 
 4068: printf("ZZZ3  idx = %d, jfr = %d, ifltype = %d, r_uth = %f, %f\n", sideBnd->side->idx, nbfr, ifltype, r_uth.x, r_uth.y);
 4069:             // Computes the contribution to the velocity from all tide frequencies
 4070:             for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4071: 
 4072:                const Vector2 ufa  = sideBnd->ufa(jfr); 
 4073:                const Vector2 umo  = sideBnd->umo(jfr); 
 4074: 
 4075:                const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4076:                const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4077:                const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4078:                r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4079: printf("ZZZ2  idx = %d, jfr = %d, argx = %f, argy = %f, umo = %f, %f, ufa = %f, %f, ramp = %f, ff = %f\n", sideBnd->side->idx, jfr, argx, argy, umo.x, umo.y, ufa.x, ufa.y, ramp, ff[jfr]);               
 4080:             }
 4081: 
 4082:          } // if (ifltype = 3 || ifltype == 5
 4083: 
 4084: 
 4085:          switch (iettype) {
 4086:             case 1:
 4087:             case 2:
 4088:             case 4:
 4089:                sideBnd->ubc[k] = r_uth;
 4090:                break;
 4091:             case 3:
 4092:                sideBnd->ubc[k] = r_u1_bar;
 4093:                break;
 4094:             case 5:
 4095:                sideBnd->ubc[k] = r_uth + r_u1_bar;
 4096:                break;
 4097:          } // switch
 4098: 
 4099: printf("ZZZ  idx = %d, iettype = %d, r_u1_bar = %f, %f, sideBnd->ubc[%d] = %f, %f\n", sideBnd->side->idx, iettype, r_u1_bar.x, r_u1_bar.y, k, sideBnd->ubc[k].x, sideBnd->ubc[k].y);
 4100:       } // for k
 4101:    }
 4102: 
 4103:    __global__ void computeElevationBoundaryConditions(double time) {
 4104:       // Compute elevation essential boundary conditions 
 4105: 
 4106:       NODE_BND(nodeBnd); // Each boundary node.
 4107: 
 4108:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4109: 
 4110:       const Node *node = nodeBnd->node;
 4111:       const BoundarySegment *segment = nodeBnd->segment;
 4112:       const int iettype = segment->iettype;
 4113:       
 4114: 
 4115:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4116:       double eic = 0.0;
 4117:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4118:       else                 eic = 0.0;
 4119: 
 4120:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4121:       const double r_eth = ramp*nodeBnd->eth;
 4122:       double r_eta1_bar = 0.0;
 4123: 
 4124: 
 4125:       // Compute tide elevation
 4126:       if (iettype == 3 || iettype == 5) {   
 4127: 
 4128:          if constexpr(iloadtide==1) { // loading tide
 4129:             assert(false && "Loading tide not implemented");
 4130:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4131:          }
 4132:          
 4133:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4134: 
 4135:             const double efa  = nodeBnd->efa[jfr]; 
 4136:             const double emo  = nodeBnd->emo[jfr]; 
 4137: 
 4138:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4139:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4140:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4141: 
 4142:          } // for jfr
 4143: 
 4144:       } // if iettype
 4145: 
 4146:       switch (iettype) {
 4147:          case 1:
 4148:          case 2:
 4149:          case 4:
 4150:             nodeBnd->elbc = r_eic + r_eth;
 4151:             break;
 4152:          case 3:
 4153:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4154:             break;
 4155:          case 5:
 4156:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4157:             break;
 4158:       } // switch
 4159: 
 4160: 
 4161:       //Add inverse barometric effects
 4162:       if (iettype != 0 && inv_atm_bnd == 1) {
 4163:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4164:       }
 4165: printf("++++>> nodeBnd->elbc = %f\n", nodeBnd->elbc);
 4166:    }
 4167: 
 4168: 
 4169:    __global__ void setEssentialBC(void) {
 4170:       // Set essential boundary conditions 
 4171:       NODE(node); // Each boundary node
 4172:       NodeBoundary *nodeBnd = node->nodeBnd;
 4173: printf("node idx = %d, nodeBnd = %p, essentialBC = %d\n", node->idx, nodeBnd, nodeBnd ? nodeBnd->isEssentialBC : -1);
 4174:       
 4175: // nodeBnd->isEssentialBC = true;      
 4176:       // Check if this node has essential BC
 4177:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4178:          // Verify BC value is valid
 4179:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4180: 
 4181:          printf("XX node IDX = %d, nodeBnd->isEssentialBC = %d\n", node->idx, nodeBnd->isEssentialBC);
 4182:          
 4183:          // Set diagonal to 1 and zero off-diagonals
 4184:          node->coeffDiag = 1.0;
 4185:          printf("ZZZZZZZ node->coeffDiag = %16.9f\n", node->coeffDiag);
 4186: 
 4187:          for (int j = 0; j < node->numNodes; j++) {
 4188:                node->coeffMatrix[j] = 0.0;
 4189:                printf("YY node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 4190:          }
 4191:          
 4192:          // Set solution and RHS to BC value
 4193:          node->mX  = nodeBnd->elbc;
 4194:          node->qel = nodeBnd->elbc;
 4195: printf("{{{{ node->mX = %f, node->qel = %f\n", node->mX, node->qel);         
 4196:       } else {
 4197:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4198: 
 4199:          for (int j = 0; j < node->numNodes; j++) {
 4200:                Node* nbNode = node->nodes[j];
 4201:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4202:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4203:                   // Verify neighbor's BC value
 4204:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4205: 
 4206:                   // Subtract contribution to RHS
 4207:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4208:                   node->coeffMatrix[j] = 0.0;  
 4209:                   printf("ZZ node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 4210:                }
 4211:          }
 4212:       }
 4213:    }
 4214: 
 4215: 
 4216:    __global__ void updateElevation(void) {
 4217:       NODE(node);
 4218: 
 4219:       node->eta2 = node->mX;
 4220: printf("node[%d]->eta2 = %f, qel = %f\n", node->idx, node->eta2, node->qel);
 4221:    }
