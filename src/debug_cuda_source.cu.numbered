  715:      // computeLonLat(center, ar1, ar2); XXXX
  716: 
  717:       frame.update(ar1, ar2);        
  718:     }
  719: 
  720:    __device__ bool findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement, double &t, 
  721:                                         double& tIntersect);
  722: 
  723:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  724:       // Check if the point (xt,yt) is inside the element
  725:       double shpCoords[4];
  726: 
  727:       bool res = computeShapeCoords(xt, shpCoords, fiNo);
  728: 
  729:       return res;
  730:    }
  731: 
  732:    __inline__ __device__ bool containsPoint(Vector2 &xt, bool fixCoords) const { 
  733:       // Check if the point (xt,yt) is inside the element.
  734:       // If fixCoords is true, and *the point is inside the element*, the point is nudged to be inside the element.
  735:       double shpCoords[4];
  736: 
  737:       Vector2 tmp_xt = xt;
  738:       const EFixIf fixIfCoords = fixCoords ? fiOnlyInside : fiNo;
  739:       bool res = computeShapeCoords(tmp_xt, shpCoords, fixIfCoords);
  740: 
  741:       if (fixCoords && res) xt = tmp_xt;
  742: 
  743:       return res;
  744:    }
  745: 
  746:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  747:    {
  748:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  749:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  750:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  751:       
  752:    }
  753: 
  754:    __device__ Vector3 interpolateVelocities(Point3 xt) const;
  755: 
  756:    // ------------------------------------------------------------------------------------------------
  757:    // These are functions that work on all nodes of the element.
  758:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  759:    //
  760:    // An example of how to use these functions is:
  761:    //   
  762:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  763:    // 
  764:    // Where L is the level at which the field is to be interpolated. The field can be either
  765:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  766:    // There are different versions of getNodalValues for each of these cases.
  767: 
  768:    template<typename T>
  769:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  770:       // Get the values of the field at the nodes of the element
  771:       res[0] = nodes[0]->*field;
  772:       res[1] = nodes[1]->*field;
  773:       res[2] = nodes[2]->*field;
  774:       if (isQuad()) res[3] = nodes[3]->*field;
  775:       else          res[3] = T();
  776:    }
  777: 
  778:    template<typename T>
  779:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  780:       // Get the values of the field at the nodes of the element
  781:       res[0] = (nodes[0]->*field)[level];
  782:       res[1] = (nodes[1]->*field)[level];
  783:       res[2] = (nodes[2]->*field)[level];
  784:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  785:       else          res[3] = T();
  786:    }    
  787: 
  788:    template<typename T>
  789:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  790:       // Get the values of the func at the nodes of the element
  791:       res[0] = (nodes[0]->*func)(level);
  792:       res[1] = (nodes[1]->*func)(level);
  793:       res[2] = (nodes[2]->*func)(level);
  794:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  795:       else          res[3] = T();  // This is 0.0 or a zero vector
  796: 
  797:    }      
  798: 
  799:    template<typename T>
  800:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  801:       // Get the values of the field at the nodes of the element
  802:       res[0] = sides[0]->*field;
  803:       res[1] = sides[1]->*field;
  804:       res[2] = sides[2]->*field;
  805:       if (isQuad()) res[3] = sides[3]->*field;
  806:       else          res[3] = T();
  807:    }
  808: 
  809:    template<typename T>
  810:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  811:       // Get the values of the field at the nodes of the element
  812:       res[0] = (sides[0]->*field)[level];
  813:       res[1] = (sides[1]->*field)[level];
  814:       res[2] = (sides[2]->*field)[level];
  815:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  816:       else          res[3] = T();
  817:    }    
  818: 
  819:    template<typename T>
  820:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  821:       // Get the values of the func at the nodes of the element
  822:       res[0] = (sides[0]->*func)(level);
  823:       res[1] = (sides[1]->*func)(level);
  824:       res[2] = (sides[2]->*func)(level);
  825:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  826:       else          res[3] = T();  // This is 0.0 or a zero vector
  827: 
  828:    }      
  829: 
  830:    template<typename T>
  831:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
  832:       T values[4];
  833:       getNodalValues(level, func, values);
  834: 
  835:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  836:    }
  837: 
  838:    template<typename T>
  839:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  840:       T values[4];
  841:       getNodalValues(field, values);
  842:       
  843:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  844:    }
  845: 
  846: 
  847:    template<typename T>
  848:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  849:       T values[4];
  850:       getNodalValues(level, field, values);
  851: 
  852:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  853:    }
  854: 
  855:    template<typename T>
  856:    __device__ T mean(T Node::* field) const {
  857:       T values[4];
  858:       getNodalValues(field, values);
  859: 
  860:       assert(i34 == 4 || values[3] == T() && "mean: values[3] is not zero with i34 == 4");
  861: 
  862:       return (values[0] + values[1] + values[2] + values[3])/i34;
  863:    }
  864: 
  865:    template<typename T>
  866:    __device__ T mean(T Side::* field) const {
  867:       T values[4];
  868:       getSideValues(field, values);
  869:       
  870:       assert((i34 == 4) || (values[3] == T()) && "mean: values[3] is not zero with i34 == 4");
  871: 
  872:       return (values[0] + values[1] + values[2] + values[3])/i34;
  873:    }   
  874: 
  875:    template<typename T>
  876:    __device__ T mean(int level, T (Node::* field)[nvrt]) const {
  877:       T values[4];
  878:       getNodalValues(level, field, values);
  879: 
  880:       assert((i34 == 4) || (values[3] == T()) && "mean: values[3] is not zero with i34 == 4");
  881: 
  882:       return (values[0] + values[1] + values[2] + values[3])/i34;
  883:    }
  884: 
  885:    template<typename T>
  886:    __device__ T mean(int level, T (Side::* field)[nvrt]) const {
  887:       T values[4];
  888:       getSideValues(level, field, values);
  889:       
  890:       // assert((i34 == 4) || (values[3] == T()) && "mean: values[3] is not zero with i34 == 4");
  891: 
  892:       return (values[0] + values[1] + values[2] + values[3])/i34;
  893:    }   
  894: 
  895:    // __device__ double mean(double (Node::*func)(int) const) const {
  896:    //    double values[4];
  897:    //    getNodalValues(level, func, values);
  898:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  899:    // }
  900:    // ------------------------------------------------------------------------------------------------
  901: 
  902:    __device__ bool globalToLocal(double xt, double yt, double &xlocal, double &ylocal) const {
  903:       // Convert global coordinates to local coordinates
