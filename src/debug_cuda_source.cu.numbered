 8951: extern "C" __global__ void populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 8952:    double *node_coords, double *node_coords_ll, bool use_ll, double *wind_rotate_angle, 
 8953:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
