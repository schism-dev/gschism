  873:    __device__ Vector2 grad2(double *a) const
  874:    {
  875:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  876:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  877:       if (isQuad()) {
  878:          gx += a[3]*gradPhi[3].x;
  879:          gy += a[3]*gradPhi[3].y;
  880:       }
  881:       return {gx, gy};
  882:    }
  883: 
  884:    __device__ Vector2 grad2(double Node::* field) const
  885:    {
  886:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  887:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  888:       if (isQuad()) {
  889:          gx += (nodes[3]->*field)*gradPhi[3].x;
  890:          gy += (nodes[3]->*field)*gradPhi[3].y;
  891:       }
  892:       return {gx, gy};
  893:    }
