 3500: 
 3501: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3502:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3503:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3504: 
 3505: 
 3506:    NODE(node1);
 3507: 
 3508:    node1->clearMatrixRow();
 3509:    node1->qel = 0.0;
 3510: 
 3511:    // THIS IS FOR STRUCTURES XXX
 3512:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3513: 
 3514:    
 3515:    for (int j=0; j<node1->numElements; j++) {
 3516:       // For each element connected to the node...
 3517: 
 3518:       Element *elem = node1->elements[j];
 3519: 
 3520: // if (elem->isDry) continue;  /// XXXX KKKKKK NOT IN THE ORIGINAL CODE
 3521: 
 3522: 
 3523:       // Compute the average gravity
 3524:       const double grav3 = elem->mean(&Node::grav2);
 3525: 
 3526:       // Look at the documentation for the description of the terms in the following integrals
 3527: 
 3528:       // Integral I_1 
 3529:       // \bar{\breve{H}} 
 3530:       const double hhatb = elem->mean(&Side::hhat);        
 3531: 
 3532:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3533: 
 3534:       const int id1 = elem->nodeLocalIdx(node1); 
 3535:       const double area = elem->area;
 3536: 
 3537:       if (elem->isTri()) {
 3538: 
 3539:          // To clarify the notation in this section: 
 3540:          //   i stands for the node under consideration (node1)
 3541:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3542:          const int id2 = elem->nxq(1 + id1);
 3543:          const int id3 = elem->nxq(2 + id1);
 3544:          Node *node2 = elem->nodes[id2];
 3545:          Node *node3 = elem->nodes[id3];
 3546: 
 3547:          const Point2 x1 = node1->p;
 3548:          const Point2 x2 = node2->p;
 3549:          const Point2 x3 = node3->p;
 3550: 
 3551:          // integral of phi_i*phi_j
 3552:          const double ipp_ii = (1.0/6.0 )*area;
 3553:          const double ipp_ij = (1.0/12.0)*area;
 3554:          const double ipp_ik = (1.0/12.0)*area;
 3555: 
 3556:          // integral of [(grad phi_i) * (grad phi_j)]
 3557:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3558:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3559:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3560: 
 3561:          // Computes the different components of integral I_1 of each node with respect to node i.
 3562:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3563:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3564:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3565: 
 3566:          node1->addToSparseMatrix(node1, I1_ii);
 3567:          node1->addToSparseMatrix(node2, I1_ij); 
 3568:          node1->addToSparseMatrix(node3, I1_ik);
 3569: 
 3570:       }
 3571:       else { // Quad
 3572:          // XXX IMPLEMENT THIS
 3573:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3574: 
 3575:          // To clarify the notation in this section: 
 3576:          //   i stands for the node under consideration (node1)
 3577:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3578:          const int id2 = elem->nxq(1 + id1);
 3579:          const int id3 = elem->nxq(2 + id1);
 3580:          const int id4 = elem->nxq(3 + id1);
 3581:          Node *node2 = elem->nodes[id2];
 3582:          Node *node3 = elem->nodes[id3];
 3583:          Node *node4 = elem->nodes[id4];         
 3584: 
 3585:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3586:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3587:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3588:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3589:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3590: 
 3591:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3592:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3593:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3594:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3595:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3596: 
 3597:          // Computes the different components of integral I_1 of each node with respect to node i.
 3598:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3599:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3600:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3601:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3602: 
 3603:          node1->addToSparseMatrix(node1, I1_ii);
 3604:          node1->addToSparseMatrix(node2, I1_ij); 
 3605:          node1->addToSparseMatrix(node3, I1_ik);
 3606:          node1->addToSparseMatrix(node4, I1_il);
 3607:   
 3608:       } 
 3609: 
 3610:  
 3611:       // Integral I_4
 3612:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3613:       // Where
 3614:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3615: 
 3616:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3617:       // of U over the element.
 3618:       Vector2 U = {0.0, 0.0};
 3619:       for (int m=0; m < elem->i34; m++) {      
 3620:          const Side *side = elem->sides[m];
 3621: 
 3622:          if constexpr(ics == 1) U += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3623:          else                   U += side->frame.project_hvec(side->U, elem->frame);
 3624:       }
 3625:       U = U/elem->i34;
 3626: 
 3627: 
 3628:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3629: 
 3630: 
 3631:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3632:       const double I_4_1 = dot(gradPhi_1, U);
 3633: 
 3634: 
 3635:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3636:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3637: if (node1->idx == 441) printf("AAAAAA: node1->idx = %d, elem->idx = %d,elem->isDry = %d, I_4_1 = %.17g, I_4_2 = %.17g\n", node1->idx, elem->idx, elem->isDry, I_4_1, I_4_2);
 3638:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3639: 
 3640:       // Additional terms 
 3641:       double vnorm = 0.0;
 3642:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3643:          Vector3 ubed = {0.0, 0.0, 0.0};
 3644:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3645: 
 3646:          Vector3 gradP = {0.0, 0.0, 1.0};
 3647:          for (int m=0; m < elem->i34; m++) {
 3648:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3649:            gradP += toVector3(gradP_2D, 0.0);
 3650:          }   
 3651:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3652:       } // imm==2
 3653: 
 3654:       if (elem->isTri()) {
 3655:          for (int l=0; l<3; l++) {
 3656: 
 3657:             Node *node = elem->nodes[l];
 3658: 
 3659:             double fac = (node == node1) ? 2.0 : 1.0;
 3660:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3661:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3662:            
 3663:          }
 3664: 
 3665: 
 3666:          if (!elem->isDry) {
 3667:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3668: 
 3669:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3670: 
 3671:          }
 3672: 
 3673:       } // isTri
 3674:       else { // isQuad
 3675:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3676:          // for (int l=0; l<4; l++) {
 3677:          //   const Node *node = elem->nodes[l];
 3678: 
 3679:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3680:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3681: 
 3682:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3683:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3684:          // }
 3685: 
 3686:       } // isQuad
 3687: 
 3688: 
 3689:      node1->qel += (dt/elem->i34)*elem->vsource;
 3690:       
 3691: 
 3692:    } // for all elements connected to the node
 3693:    
 3694: 
 3695:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3696:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 3697:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3698:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3699:       // If it is an open boundary node...
 3700: 
 3701:       // At least one open bnd side, maybe two
 3702:       for (int l=0; l<2; l++) { 
 3703: 
 3704:          // Gets each of the sides sharing the node. 
 3705:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3706: 
 3707:        
 3708: 
 3709:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3710:          if (sideBnd != nullptr) {
 3711:             // If the side is on a boundary...
 3712: 
 3713:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3714: 
 3715:             // Get the boundary segment
 3716:             const BoundarySegment *sideSegment = sideBnd->segment;
 3717:             const Side *side = sideBnd->side;
 3718: 
 3719:             // Integral I_3
 3720:             if (sideSegment->ifltype != 0) {
 3721:             // Natural or Flather b.c.
 3722: 
 3723:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3724:                // especially for Flather b.c.
 3725:                double ri3 = 0.0;
 3726:                if (!side->isDry) {
 3727:                   // If the side is not dry
 3728:                   
 3729:                   // Computes the side flux of (uth, vth)
 3730:                   double Vn = 0.0;
 3731:                   for (int k = side->kb; k < nvrt - 1; k++) {
 3732:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3733:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3734: 
 3735:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 3736:                   }
 3737: 
 3738:                   ri3 = 0.5*side->len*Vn;
 3739:                }
 3740: 
 3741:                if (sideSegment->ifltype == -1) { // Flather 1
 3742: 
 3743:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3744:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3745: 
 3746:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3747:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3748:                   
 3749:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3750:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3751: 
 3752:                } 
 3753:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3754:                   // Reset ri3
 3755:                   ri3 = 0.0;
 3756: 
 3757:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3758: 
 3759:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3760: 
 3761:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3762:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3763: 
 3764:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3765:                   node1->addToSparseMatrix(node1, con0*2.0);
 3766:                   node1->addToSparseMatrix(node2, con0);
 3767: 
 3768:                } // if Flather or Discharge
 3769: 
 3770:                node1->qel -= thetai*dt*ri3;
 3771: 
 3772: 
 3773:             } // I_3
 3774:           
 3775: 
 3776:             // Integral I_5
 3777:             if(!side->isDry) {
 3778: 
 3779:                const double Unbar = dot(side->U, side->n);
 3780:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3781: 
 3782:             } // I_5
 3783: 
 3784:          } // if is boundary side
 3785: 
 3786:       } // for l
 3787: 
 3788:    } // if isbnd
 3789: 
 3790: 
 3791: }
 3792: 
 3793: 
 3794: 
 3795: extern "C" {
 3796:    __global__ void setupCGSolvers(double* diag_d, double* data_d, double* b_d, 
 3797:                                   float*  diag_f, float*  data_f, float*  b_f, 
 3798:                                   int* indices, int* indptr) {
 3799: 
 3800:       NODE(node);
 3801:       
 3802:       const int idx = node->idx;
 3803:       
 3804:       // Computes the index in the nzz array      
 3805:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 3806: 
 3807: 
 3808:       indptr[idx] = nzzIdx;
 3809:       indices[nzzIdx] = idx;
 3810: 
 3811:       data_d[nzzIdx]    = node->coeffDiag;
 3812:       data_f[nzzIdx]    = (float)node->coeffDiag;
 3813: 
 3814:       diag_d[idx] = 1.0/node->coeffDiag;
 3815:       diag_f[idx] = (float)(1.0/node->coeffDiag);
 3816: 
 3817:       b_d[idx] = node->qel;
 3818:       b_f[idx] = (float)node->qel;
 3819: 
 3820:       for (int k = 0; k < node->numNodes; ++k) {
 3821:          const Node* nb = node->nodes[k];
 3822: 
 3823:          const int j = nb->idx;
 3824: 
 3825:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 3826:          data_f[nzzIdx + k + 1]    = (float)node->coeffMatrix[k];
 3827: 
 3828:          indices[nzzIdx + k + 1] = j;
 3829:       }
 3830: 
 3831: 
 3832:    }
 3833: 
 3834: 
 3835: 
 3836:    __global__ void solverCopyResult(double* x) {
 3837:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 3838:       NODE(node);
 3839:       const int idx = node->idx;
 3840: 
 3841:       node->mX = x[idx];
 3842:    }
 3843: 
 3844: 
 3845:    __global__ void rollUpElevation(void) {
 3846: 
 3847:       NODE(node);
 3848: 
 3849:       node->eta1 = node->eta2;
 3850: 
 3851:    }
 3852: 
 3853: 
 3854:    __global__ void backtrackAllNodes(void) {
 3855: 
 3856:       // max/min # of sub-divisions
 3857:       const int ndelt_max = max(1.0, dt/dtb_min);
 3858:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3859: 
 3860:       // Removed all references to swild98 XXX
 3861:       // swild98=0.d0 !init
 3862: 
 3863: 
 3864:       SIDE(side);
 3865: 
 3866:       const int kb = side->kb;
 3867: 
 3868: 
 3869:       // Initialize btrack velocities to the actual velocities at the side 
 3870:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3871: 
 3872:   
 3873: 
 3874:       // if (side->isDry) return;
 3875:       
 3876: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 3877: 
 3878:       // Checks that at least one element is not dry
 3879:       const Element *elem1 = side->elems[0];
 3880:       const Element *elem2 = side->elems[1];
 3881: 
 3882: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 3883: 
 3884:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3885:       
 3886:       // XXXXXX
 3887:       // !swild_tmp to store global coord. of the starting side
 3888:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3889:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3890:       // !Use sframe2 
 3891:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3892: 
 3893: 
 3894:       for (int k = kb; k < nvrt; k++) {
 3895:       //  Initialize (xt,yt,zt), nnel and vel.
 3896:       //  For ics=2, the coordinates are in local frames
 3897:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3898: 
 3899: 
 3900:          const int iadvf = side->iadv();  // Advection flag   
 3901:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 3902: 
 3903:          Point3 xt;
 3904:          if constexpr(ics==1) {
 3905:             xt = side->center3D(k); 
 3906:          }
 3907:          else // lat/lon; in side lat/lon frame
 3908:          {
 3909:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3910:          // XXX IMPLEMENT THIS
 3911:       //          xt=0.d0
 3912:       //          yt=0.d0
 3913:       //          !centroid coord. for nudging
 3914:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3915:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3916:          }  // ics
 3917: 
 3918: 
 3919: 
 3920:          // If on land or open boundary...
 3921:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3922:          
 3923:          const double vmag = length(side->u2[k]);
 3924: 
 3925:          if (vmag <= velmin_btrack) {
 3926:             // No activity 
 3927: 
 3928:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 3929: // addDebugPlot(side->center, side->center, 0x00000F, '+');            
 3930:             
 3931:          } else {  // do btrack
 3932: 
 3933:             // Compute number of sub-divisions based on local gradients 
 3934:             // XXX IS THIS NECESSARY?
 3935:             double suma = 0.0;
 3936:             int icount = 0;
 3937:             for (int ii=0; ii<2; ii++) {
 3938: 
 3939:                const Element *elem = side->elems[ii];
 3940:                  
 3941:                if (elem == nullptr) continue;
 3942: 
 3943:                icount++;
 3944: 
 3945:                // Not strictly along z; in ll frame for ics=2
 3946: 
 3947:                double utmp[4];
 3948:                double vtmp[4];
 3949:                for (int jj = 0; jj < elem->i34; jj++) {
 3950: 
 3951:                   const Node *node = elem->nodes[jj];
 3952: 
 3953:                   if constexpr(ics==1) {
 3954:                      utmp[jj] = node->u2[k].x;
 3955:                      vtmp[jj] = node->u2[k].y;  
 3956:                   } else {
 3957:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3958:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3959:                   }
 3960:                } // for jj
 3961: 
 3962:                const Vector2 grad_u = elem->grad2(utmp); 
 3963:                const Vector2 grad_v = elem->grad2(vtmp);
 3964: 
 3965:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3966:             } // for ii
 3967: 
 3968:             assert(icount > 0 && "Impossible 77");
 3969: 
 3970:             // '4' is somewhat arbitrary
 3971:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3972: 
 3973:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3974: 
 3975:             if (dtbk < 1e-5 || dt < 1e-5) {
 3976:                printf("^^^^^^^dtbk = %.17f, dt = %.17f, ndelt = %i\n", dtbk, dt, ndelt);
 3977: 
 3978:             }
 3979:          
 3980: 
 3981:             Vector3 u_int = {0.0, 0.0, 0.0};
 3982: 
 3983:             side->btrack(k, dt, dtbk, u_int);
 3984: if (side->idx == 1149 && k == 1) printf("$$$$$$$$EEEE>>>> u_int = %.17g, %.17g, %.17g\n", u_int.x, u_int.y, u_int.z);            
 3985:             side->btu[k] = toVector2(u_int);
 3986:                
 3987:          } // if vmag (do backtrack)
 3988: 
 3989:       } // for k=kb,nvrt-1
 3990: 
 3991:    }
 3992: 
 3993: } // extern "C"
 3994: 
 3995: template<int nc>
 3996: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3997: 
 3998: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3999: //
 4000: // a,b,c,rhs: input vectors and are not modified by this program.
 4001: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4002: // rhs is the r.h.s.
 4003: // n: actual rank of the system.
 4004: // rows in u() and rhs();
 4005: // u: output with nc columns (transposed to rows)
 4006: // gam: a working array.
 4007: //
 4008: // NOTES:
 4009: // This is a template function that allows for different numbers of columns in the rhs vector.
 4010: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4011: 
 4012:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4013:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4014: 
 4015:    double bet = b[0];
 4016:    if constexpr (nc == 1) {
 4017:       u[0] = rhs[0]/bet;
 4018:    } else {
 4019:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4020:    }
 4021: 
 4022:    for (int j = 1; j < n; j++) {
 4023:       gam[j] = c[j - 1]/bet;
 4024:       bet = b[j] - a[j]*gam[j];
 4025: 
 4026:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4027: 
 4028:       if constexpr (nc == 1) {
 4029:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4030:       } else {
 4031:          for (int l = 0; l < nc; l++) {
 4032:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4033:          }
 4034:       }
 4035:    }
 4036: 
 4037:    // Back-substitution
 4038:    for (int j = n - 2; j >= 0; j--) {
 4039:       if constexpr (nc == 1) {
 4040:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4041:       } else {
 4042:          for (int l = 0; l < nc; l++) {
 4043:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4044:          }
 4045:       }
 4046:    }
 4047: }
 4048: 
 4049: 
 4050: 
 4051: // Helper function that contains the core algorithm
 4052: template<typename XAccessor, typename YAccessor>
 4053: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4054:                                     double  yp_top, double  yp_bot, 
 4055:                                     CubicSpline &spline) {
 4056:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4057:    // 
 4058:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4059:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4060:    //
 4061:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4062:    // 
 4063:    // Inputs: 
 4064:    //            n: dimension for x etc; # of data pts (>=2);
 4065:    //            getX, getY: functions to access x,y coordinates
 4066:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4067:    //     Output: 
 4068:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4069: 
 4070:    const int n = k2 - k1 + 1;
 4071:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4072: 
 4073:    // Allocate memory for the splines
 4074:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4075:    spline.x   = new double[n];
 4076:    spline.y   = new double[n];
 4077:    spline.yp  = new double[n];
 4078:    spline.ypp = new double[n];
 4079: 
 4080:    for (int k=k1; k<=k2; k++) {
 4081:       spline.x[k] = getX(k);
 4082:       spline.y[k] = getY(k);
 4083:    }
 4084: 
 4085:    // This is to simplify expressions later
 4086:    double *x = spline.x;
 4087:    double *y = spline.y;
 4088: 
 4089:    double *a = nullptr;
 4090:    double *b = nullptr;
 4091:    double *c = nullptr;
 4092:    double *gam = nullptr;
 4093:    double *rhs = nullptr;
 4094:    
 4095: 
 4096:       a = new double[n];   // Lower diagonal
 4097:       b = new double[n];   // Diagonal
 4098:       c = new double[n];   // Upper diagonal
 4099:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4100:       rhs = new double[n]; // Right-hand side
 4101: 
 4102:    for (int k=k1; k<=k2; k++) {
 4103:       if (k == k1) {
 4104:          // Bottom level
 4105:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4106:          b[k] = (x[k+1] - x[k])/3.0;
 4107:          c[k] = b[k]/2.0;
 4108:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4109:       } else if (k == n - 1) {
 4110:          // Top level (surface)
 4111:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4112:          b[k] = (x[k] - x[k-1])/3.0;
 4113:          a[k] = b[k]/2.0;
 4114:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4115:       } else {
 4116:          // Intermediate levels
 4117:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4118:          b[k] = (x[k+1] - x[k-1])/3.0;
 4119:          a[k] = (x[k  ] - x[k-1])/6.0;
 4120:          c[k] = (x[k+1] - x[k  ])/6.0;
 4121:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4122:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4123:       }
 4124:    }
 4125: 
 4126:    // Solve the tridiagonal system
 4127:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4128:    
 4129:    spline.yp[k1] = yp_bot;
 4130:    spline.yp[k2] = yp_top;
 4131: 
 4132:    // Compute rest of 1st derivatives using the splines
 4133:    for (int k=k1+1; k<k2; k++) {
 4134:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4135:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4136:    }
 4137:    
 4138:    delete[] a;
 4139:    delete[] b;
 4140:    delete[] c;
 4141:    delete[] gam;
 4142:    delete[] rhs;
 4143: 
 4144: }
 4145: 
 4146: // Array version
 4147: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4148:                                 double y_top, double y_bot, 
 4149:                                 CubicSpline &spline) {
 4150:    auto getX = [x] (int k) { return x[k]; };
 4151:    auto getY = [y] (int k) { return y[k]; };
 4152:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4153: }
 4154: 
 4155: // Lambda version - allows custom access patterns
 4156: template<typename XFunc, typename YFunc>
 4157: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4158:                                 double y_top, double y_bot,
 4159:                                 CubicSpline &spline) {
 4160:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4161: }
