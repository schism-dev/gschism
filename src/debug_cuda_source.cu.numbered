 3770: 
 3771:    __global__ void scaleGravity(double loadtide_coef) {
 3772: 
 3773: 
 3774:       NODE(node);
 3775: 
 3776:       // SAL option: scale gravity
 3777:       if constexpr(iloadtide==2) {  // simple const
 3778:          node->grav2 = grav*(1.0 - loadtide_coef);
 3779: 
 3780:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3781:         
 3782:           const double depth = max(node->depth, 0.0);
 3783:           const double tmp1 = sqrt(depth);
 3784:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3785:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3786:                              2.6969e-13*depth*depth*depth*tmp1;
 3787:           
 3788:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3789:           
 3790: 
 3791: 
 3792:           node->grav2 = grav*(1.0 - beta_bar);
 3793: 
 3794:       } else {  // iloadtide=0,1
 3795:         node->grav2=grav;
 3796: 
 3797:       }
 3798: 
 3799:    }
