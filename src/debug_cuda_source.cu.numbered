 9040: __global__ void getStructSizes(int* sizes)  {
 9041:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 9042:       printf(">>>>>*** C++ 3 getStructSizes, sizes = %p\n", sizes);
 9043:       sizes[0] = (int)sizeof(Node);
 9044:       sizes[1] = (int)sizeof(Element);
 9045:       sizes[2] = (int)sizeof(Side);
 9046:       sizes[3] = (int)sizeof(NodeBoundary);
 9047:       sizes[4] = (int)sizeof(SideBoundary);
 9048:       sizes[5] = (int)sizeof(BoundarySegment);
 9049: }
