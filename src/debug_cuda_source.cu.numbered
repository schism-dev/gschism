 2365: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2 + n2->grav2); }
 2366: __inline__ __device__ int     Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 2367: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 2368: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1 + n2->eta1); }
 2369: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth + n2->depth); } 
 2370: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 2371: 
 2372: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 2373: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 2374: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 2375: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
