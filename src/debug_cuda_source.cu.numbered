  629:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  630:       // Check if the point (xt,yt) is inside the element
  631:       double shpCoords[4];
  632: 
  633:       bool res = computeShapeCoords(xt, shpCoords, false);
  634: 
  635:       return res;
  636:    }
  637: 
  638:    __inline__ __device__ bool containsPoint(Vector2 &xt, bool fixCoords) const { 
  639:       // Check if the point (xt,yt) is inside the element
  640:       double shpCoords[4];
  641: 
  642:       Vector2 tmp_xt = xt;
  643:       bool res = computeShapeCoords(tmp_xt, shpCoords, fixCoords);
  644: 
  645:       if (fixCoords && res) xt = tmp_xt;
  646: 
  647:       return res;
  648:    }
  649: 
  650:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  651:    {
  652:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  653:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  654:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  655:       
  656:    }
  657: 
  658:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int) const;
  659: 
  660:    // ------------------------------------------------------------------------------------------------
  661:    // These are functions that work on all nodes of the element.
  662:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  663:    //
  664:    // An example of how to use these functions is:
  665:    //   
  666:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  667:    // 
  668:    // Where L is the level at which the field is to be interpolated. The field can be either
  669:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  670:    // There are different versions of getNodalValues for each of these cases.
  671: 
  672:    template<typename T>
  673:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  674:       // Get the values of the field at the nodes of the element
  675:       res[0] = nodes[0]->*field;
  676:       res[1] = nodes[1]->*field;
  677:       res[2] = nodes[2]->*field;
  678:       if (isQuad()) res[3] = nodes[3]->*field;
  679:       else          res[3] = T();
  680:    }
  681: 
  682:    template<typename T>
  683:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  684:       // Get the values of the field at the nodes of the element
  685:       res[0] = (nodes[0]->*field)[level];
  686:       res[1] = (nodes[1]->*field)[level];
  687:       res[2] = (nodes[2]->*field)[level];
  688:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  689:       else          res[3] = T();
  690:    }    
  691: 
  692:    template<typename T>
  693:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  694:       // Get the values of the func at the nodes of the element
  695:       res[0] = (nodes[0]->*func)(level);
  696:       res[1] = (nodes[1]->*func)(level);
  697:       res[2] = (nodes[2]->*func)(level);
  698:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  699:       else          res[3] = T();  // This is 0.0 or a zero vector
  700: 
  701:    }      
  702: 
  703:    template<typename T>
  704:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  705:       // Get the values of the field at the nodes of the element
  706:       res[0] = sides[0]->*field;
  707:       res[1] = sides[1]->*field;
  708:       res[2] = sides[2]->*field;
  709:       if (isQuad()) res[3] = sides[3]->*field;
  710:       else          res[3] = T();
  711:    }
  712: 
  713:    template<typename T>
  714:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  715:       // Get the values of the field at the nodes of the element
  716:       res[0] = (sides[0]->*field)[level];
  717:       res[1] = (sides[1]->*field)[level];
  718:       res[2] = (sides[2]->*field)[level];
  719:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  720:       else          res[3] = T();
  721:    }    
  722: 
  723:    template<typename T>
  724:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  725:       // Get the values of the func at the nodes of the element
  726:       res[0] = (sides[0]->*func)(level);
  727:       res[1] = (sides[1]->*func)(level);
  728:       res[2] = (sides[2]->*func)(level);
  729:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  730:       else          res[3] = T();  // This is 0.0 or a zero vector
  731: 
  732:    }      
  733: 
  734: 
  735:    __device__ double interpolate(int level, const double shapeCoords[4], double (Node::*func)(int) const) const {
  736:       double values[4];
  737:       getNodalValues(level, func, values);
  738: 
  739:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  740:    }
  741: 
  742:    template<typename T>
  743:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  744:       T values[4];
  745:       getNodalValues(field, values);
  746:       
  747:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  748:    }
  749: 
  750: 
  751:    template<typename T>
  752:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  753:       T values[4];
  754:       getNodalValues(level, field, values);
  755: 
  756:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  757:    }
  758: 
  759:    template<typename T>
  760:    __device__ T mean(T Node::* field) const {
  761:       T values[4];
  762:       getNodalValues(field, values);
  763: 
  764:       return (values[0] + values[1] + values[2] + values[3])/i34;
  765:    }
  766: 
  767:    template<typename T>
  768:    __device__ T mean(T Side::* field) const {
  769:       T values[4];
  770:       getSideValues(field, values);
  771:       
  772:       return (values[0] + values[1] + values[2] + values[3])/i34;
  773:    }   
  774: 
  775:    template<typename T>
  776:    __device__ T mean(int level, T (Node::* field)[nvrt]) const {
  777:       T values[4];
  778:       getNodalValues(level, field, values);
  779: 
  780:       return (values[0] + values[1] + values[2] + values[3])/i34;
  781:    }
  782: 
  783:    template<typename T>
  784:    __device__ T mean(int level, T (Side::* field)[nvrt]) const {
  785:       T values[4];
  786:       getSideValues(level, field, values);
  787:       
  788:       return (values[0] + values[1] + values[2] + values[3])/i34;
  789:    }   
  790: 
  791:    // __device__ double mean(double (Node::*func)(int) const) const {
  792:    //    double values[4];
  793:    //    getNodalValues(level, func, values);
  794:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  795:    // }
