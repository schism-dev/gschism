 5468:    __global__ void resetBoundaryAreas(void) {
 5469:       // Reset boundary areas and lengths for each segment.
 5470: 
 5471:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 5472:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 5473:       SIDE_BND(sideBnd);
 5474: 
 5475:       BoundarySegment *segment = sideBnd->segment;
 5476: 
 5477:       segment->carea = 0.0;
 5478:       segment->clen = 0.0;
 5479:  
 5480:    }
 5481: 
 5482:    __global__ void computeBoundaryAreas(void) {
 5483:    // Calculation of cross-section areas and lengths for flow b.c.
 5484: 
 5485:       SIDE_BND(sideBnd);
 5486: 
 5487:       const Side *side = sideBnd->side;
 5488:       BoundarySegment *segment = sideBnd->segment;
 5489: 
 5490:       if (segment->ifltype != 0) {
 5491: 
 5492:          const Node *n1 = side->n1;
 5493:          const Node *n2 = side->n2;
 5494: 
 5495:          const double htot = side->htot2();
 5496: 
 5497:          if (!side->isDry) {
 5498:             atomicAdd(&segment->carea, htot*side->len);
 5499:             atomicAdd(&segment->clen, side->len);
 5500:          }
 5501:       }
 5502: 
 5503:    }
 5504: 
 5505: 
 5506:    __global__ void computeFlowBcVelocities(double time) {
 5507: 
 5508:       SIDE_BND(sideBnd);
 5509: 
 5510:       const Side *side = sideBnd->side;
 5511:  
 5512:       const bool isDry = side->isDry;
 5513:       const bool isLand = sideBnd->segment->isLand;
 5514: 
 5515:    
 5516:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 5517: 
 5518:       if (isDry || isLand) return;
 5519: 
 5520:       // For wet sides in open boundaries...
 5521:       const Vector2 n = side->n;
 5522:       const BoundarySegment *segment = sideBnd->segment;
 5523: 
 5524:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 5525: 
 5526:       const int ifltype = segment->ifltype;
 5527: 
 5528:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 5529:       const Vector2 r_nuth0 = r_uth0*n;
 5530: 
 5531: 
 5532:       if (ifltype == 1 || ifltype == 2) {
 5533:       
 5534:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 5535: 
 5536:          const double unth0 = segment->qthcon*ramp/segment->carea;
 5537:          
 5538:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 5539:          
 5540:       } else if (ifltype == -1) { // Flather 1
 5541: 
 5542:          for (int k = 0; k < nvrt; k++) {
 5543: 
 5544:             // uth is the normal vel.; no ramp up
 5545:             const double uth = sideBnd->nuth(k);
 5546:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 5547: 
 5548:             sideBnd->ubc[k] += uth*n;
 5549:          }
 5550: 
 5551:       } else if (ifltype == 3 || ifltype == 5) {
 5552:          // vnth0=0 !normal vel.
 5553: 
 5554:          Vector2 r_u1_bar = {0.0, 0.0};
 5555:          // Computes the contribution to the velocity from all tide frequencies
 5556:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5557: 
 5558:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 5559:             const Vector2 umo  = sideBnd->umo(jfr); 
 5560: 
 5561:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5562:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 5563:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 5564:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 5565: 
 5566:          }
 5567: 
 5568: 
 5569:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 5570: 
 5571:       } // if (ifltype = 3 || ifltype == 5
 5572: 
 5573: 
 5574: 
 5575:    }
 5576: 
 5577:    __global__ void computeElevationBoundaryConditions(double time) {
 5578:       // Compute elevation essential boundary conditions 
 5579: 
 5580:       NODE_BND(nodeBnd); // Each boundary node.
 5581: 
 5582:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 5583: 
 5584:       const Node *node = nodeBnd->node;
 5585:       const BoundarySegment *segment = nodeBnd->segment;
 5586:       const int iettype = segment->iettype;
 5587:       
 5588: 
 5589:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 5590:       double eic = 0.0;
 5591:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 5592:       else                 eic = 0.0;
 5593: 
 5594:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 5595:       const double r_eth = ramp*nodeBnd->eth;
 5596:       double r_eta1_bar = 0.0;
 5597: 
 5598: 
 5599:       // Compute tide elevation
 5600:       if (iettype == 3 || iettype == 5) {   
 5601: 
 5602:          if constexpr(iloadtide==1) { // loading tide
 5603:             assert(false && "Loading tide not implemented");
 5604:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5605:          }
 5606:          
 5607:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5608: 
 5609:             const double efa  = nodeBnd->efa[jfr]; 
 5610:             const double emo  = nodeBnd->emo[jfr]; 
 5611: 
 5612:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5613:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 5614:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 5615: 
 5616:          } // for jfr
 5617: 
 5618:       } // if iettype
 5619: 
 5620:       switch (iettype) {
 5621:          case 1:
 5622:          case 2:
 5623:          case 4:
 5624:             nodeBnd->elbc = r_eic + r_eth;
 5625:             break;
 5626:          case 3:
 5627:             nodeBnd->elbc = r_eic + r_eta1_bar;
 5628:             break;
 5629:          case 5:
 5630:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 5631:             break;
 5632:       } // switch
 5633: 
 5634: 
 5635:       //Add inverse barometric effects
 5636:       if (iettype != 0 && inv_atm_bnd == 1) {
 5637:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 5638:       }
 5639: 
 5640:    }
 5641: 
 5642: 
 5643:    __global__ void computeHorizontalViscosity(void) { 
 5644: 
 5645:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 5646: 
 5647:       SIDE(side);
 5648: 
 5649:       if (side->isDry) return;
 5650: 
 5651:       for (int k = 0; k < nvrt; k++) {
 5652:          side->nuGradU[k] = {0.0, 0.0};
 5653:       }
 5654: 
 5655:       if constexpr(ihorcon == 1) {
 5656:          for (int k = side->kb; k < nvrt - 1; k++) {
 5657:             // Computes the Laplacian by using the simplified formula presented in the paper:
 5658:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 5659:             // By Zhang and Baptista.
 5660: 
 5661:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 5662:             // This is a standard discretization of the Laplacian operator.
 5663:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 5664:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 5665:             // Gamma is hvis_coef0 in the code.
 5666:             // The value of gamma needs to be < 0.5.
 5667: 
 5668:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 5669:             // side under consideration in each of the two possible elements that share the side.
 5670:             Vector2 sumU = {0.0, 0.0};
 5671:             for (int l = 0; l < 2; l++) {
 5672:                const Element *elem = side->elems[l];
 5673: 
 5674:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 5675: 
 5676:                // Find the local index of the side in the element
 5677:                const int idxSide = elem->sideLocalIdx(side);
 5678: 
 5679:                // Find the two sides that are connected to the side under consideration
 5680:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 5681:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 5682: 
 5683:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 5684: 
 5685:             }
 5686: 
 5687:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 5688: 
 5689:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 5690:    
 5691:          }
 5692:       }
 5693:       else if constexpr(ihorcon == 2) {
 5694:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 5695:       }
 5696: 
 5697: 
 5698:    }
 5699: 
 5700: 
 5701:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 5702:       // Set essential boundary conditions 
 5703:       NODE(node); // Each boundary node
 5704:       NodeBoundary *nodeBnd = node->nodeBnd;
 5705:       
 5706:  
 5707:       // Check if this node has essential BC
 5708:       if (nodeBnd && nodeBnd->isEssentialBC) {
 5709:          // Verify BC value is valid
 5710:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5711: 
 5712:        
 5713:          // Set diagonal to 1 and zero off-diagonals
 5714:          node->coeffDiag = 1.0;
 5715: 
 5716:          for (int j = 0; j < node->numNodes; j++) {
 5717:                node->coeffMatrix[j] = 0.0;
 5718:          }
 5719:          
 5720:          // Set solution and RHS to BC value
 5721:          node->mX  = nodeBnd->elbc;
 5722:          node->qel = nodeBnd->elbc;
 5723: 
 5724:       } else {
 5725:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 5726: 
 5727:          for (int j = 0; j < node->numNodes; j++) {
 5728:                Node* nbNode = node->nodes[j];
 5729:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 5730:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 5731:                   // Verify neighbor's BC value
 5732:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5733: 
 5734:                   // Subtract contribution to RHS
 5735:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 5736:                   node->coeffMatrix[j] = 0.0;  
 5737:                }
 5738:          }
 5739:       }
 5740:    }
 5741: 
 5742: 
 5743:    __global__ void updateElevation(void) {
 5744:       NODE(node);
 5745: 
 5746: 
 5747:       node->eta2 = node->mX;
 5748: 
 5749:       node->updateZCoordData();
 5750:    }
 5751: 
 5752: 
 5753:    __global__ void computeVerticallyIntegratedVelocity(void) {
 5754: 
 5755:       SIDE(side);
 5756: 
 5757:       side->U = {0.0, 0.0}; 
 5758:          
 5759:       if(side->isDry) return;
 5760: 
 5761:       // Vertically integrated velocity U
 5762:       for (int k = side->kb; k < nvrt - 1; k++) { 
 5763:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 5764:          side->U += side->Dz(k + 1)*uc;  
 5765:       }
 5766: 
 5767:    }
 5768: 
 5769:    __global__ void computeBottomDragVegetation(void) {
 5770:       // UNFINISHED. CHECK THIS:
 5771:       // How many kernels are needed? Why so many for loops?
 5772:       // Is the loop on sides needed?
 5773: 
 5774:       NODE(node);
 5775: 
 5776: 
 5777:       const int    kb      = node->kb;
 5778:       const double htot    = node->htot2(); 
 5779:       
 5780:       if (node->isDry) {
 5781:          // Default values for dry nodes
 5782:          node->veg_alpha_vert_mean = node->veg_alpha0;
 5783:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 5784: 
 5785:          return;
 5786:        
 5787:       }
 5788: 
 5789:       // Computes bottom drag Cd based on the selected nchi
 5790:       node->computeBottomDragCd();
 5791:       
 5792: 
 5793: 
 5794:       //   Bottom stress in m^2/s^2
 5795:       if (node->rho[kb + 1] >= -98.0)
 5796:       {
 5797:          const double mag_u = length(node->u2[kb + 1]);
 5798:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5799: 
 5800:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5801:          // !sediment erosion: this part needs more documentation
 5802:       }
 5803:     
 5804: 
 5805: 
 5806:       // Compute vegetation parameters
 5807:       //--------------------------------
 5808: 
 5809:       // SAV constants
 5810:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5811:       constexpr double veg_cfpsi = 0.16;
 5812: 
 5813:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5814:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5815: 
 5816:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5817:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5818:          int kbin = 0; // bin index
 5819:          for (int k = kb; k < nvrt; k++) {
 5820:             // Computes node height above the bottom level
 5821:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5822:             assert(false && "Vertical variation of vegetation not implemented");
 5823: 
 5824:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5825:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5826:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5827:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5828:             // } else {
 5829:             //    // Find the bin at which the current vertical level is
 5830:             //    while (kbin<nbins_veg_vert) {
 5831:             //       const double zn = node->z[kbin];
 5832:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5833:             //          break;
 5834:             //       } // if
 5835:             //       kbin++;
 5836:             //    } // while
 5837:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5838: 
 5839:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5840:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5841:                
 5842:             //    // Linear interpolation of the vegetation parameters
 5843:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5844:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5845:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5846:             // } // if rl10
 5847: 
 5848:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5849: 
 5850:          } // for k
 5851: 
 5852: 
 5853:       } else { // Ganthy (iveg==2)
 5854:       //  Modify canopy height, diameter, and density
 5855: 
 5856:          // Make sure there is vegetation on this node
 5857:          if (node->veg_h_unbent > 0.0) {
 5858:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5859: 
 5860:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5861:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5862:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5863: 
 5864:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5865:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5866:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5867:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5868:          } // if veg_h_unbent
 5869: 
 5870:          for (int k = 0; k < nvrt; k++) {
 5871:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5872:          } // for k
 5873:       
 5874: 
 5875:       } // if iveg
 5876:      
 5877: 
 5878:       // Compute vertical mean of veg_alpha3D
 5879:       if (iveg != 0) {
 5880:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5881:          double sum1=0.0;
 5882:          double sum2=0.0;
 5883:          // Integrate over each level under the canopy...
 5884:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5885:             const double Dz = node->Dz(k);
 5886: 
 5887:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5888:             sum2 += Dz;
 5889: 
 5890:          } // for k
 5891:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5892:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5893: 
 5894:       } // if iveg
 5895: 
 5896:    }
 5897: 
 5898:    __global__ void computeVegetationAndDragParameters(void) {
 5899:       // Computes the vegetation and drag model parameters:
 5900:       // chi, \tilde\chi, beta, \breve{H}
 5901:       
 5902:       SIDE(side);
 5903: 
 5904:       side->hhat = 0.0;
 5905:       side->chi2 = 0.0;
 5906:       side->chi = 0.0;
 5907:       side->veg_c2 = 0.0;
 5908:       side->veg_beta = 0.0;
 5909: 
 5910:       if (side->isDry) return;
 5911: 
 5912:       const double htot = side->htot2();
 5913:       const int    kb   = side->kb;
 5914: 
 5915:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5916: 
 5917:       const double veg_h     = side->veg_h();
 5918:       const double veg_nv    = side->veg_nv();
 5919:       const double veg_c     = side->veg_c();
 5920:       const double veg_beta  = side->veg_beta;
 5921:       const double veg_alpha = side->veg_alpha_vert_mean();
 5922: 
 5923:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 5924:       // Velocity magnitude at the bottom level
 5925:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 5926:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 5927:       side->chi2 = side->Cd()*vmag1;
 5928:       side->chi  = side->chi2;
 5929:       if constexpr(iveg != 0) {
 5930:          const Node *n1 = side->n1;
 5931:          const Node *n2 = side->n2;
 5932:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5933:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5934:       }
 5935: 
 5936:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5937: 
 5938:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5939:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5940:       double magUa = 0.0;
 5941:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 5942:          // 3D wet side with veg...
 5943: 
 5944:          double magUa = 0.0;
 5945:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5946:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5947: 
 5948:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 5949:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 5950:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5951: 
 5952:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5953:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5954: 
 5955:                // Velocity magnitude at the bottom (l) of the level
 5956:                const double ul = length(side->u2[k]);
 5957: 
 5958:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5959:                magUa += Dz*0.5*(uh + ul);
 5960: 
 5961:             } // if HasVegetation
 5962:          } // for k
 5963:          const double ua = magUa/min(htot, veg_h); // Vertical average
 5964: 
 5965:          // Computes beta, used for computing the stress term at the top of the canopy.      
 5966:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 5967:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5968:             const double zCpy = side->zTopCanopy();
 5969:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5970:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5971:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5972:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5973:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5974:          } // if isSubmerged
 5975:       } // if iveg   
 5976: 
 5977:       // Computes the friction modified depth, \breve{H} in notes
 5978:       if (side->is2D()) { // 2D
 5979: 
 5980:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5981:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5982: 
 5983:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5984: 
 5985:          side->hhat = htot*htot/fricH; 
 5986: 
 5987:       } else { // 3D
 5988:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 5989: 
 5990:          if constexpr(iveg != 0) {
 5991:             
 5992:             if (side->isSubmerged()) { 
 5993:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5994:                side->hhat -= veg_c*Hhat_alpha;
 5995: 
 5996:             } else { // Emergent
 5997:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5998:             }
 5999:          } // if iveg
 6000: 
 6001:          // Enforce positivity for 3D model
 6002:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 6003:       } // if 3D
 6004: 
 6005:    }
 6006: 
 6007: 
 6008: 
 6009:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 6010:    // Computes the density gradient between two elements, e1 and e2.
 6011:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 6012:    // zero in the direction normal to the side. 
 6013:    // 
 6014:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 6015:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 6016:    //
 6017:    // Input:
 6018:    //    e1: Element
 6019:    //    e2: Neighbor element (or nullptr if boundary)
 6020:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 6021:    //    k: Index of the half-level at which the density is interpolated
 6022:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 6023:    // 
 6024:    // Output:
 6025:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 6026:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 6027: 
 6028:       if (e2 == nullptr || e2->isDry) {
 6029:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 6030: 
 6031:          Side *side = e1->sides[j];
 6032:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 6033:                  
 6034:          if constexpr(ics == 1) {
 6035:             vec = side->n; // Normal vector to the side
 6036:          } else {
 6037:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6038:             // IMPLEMENT THIS XXXXXX
 6039:             // !replace with xel, yel?
 6040:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 6041:             //      &eframe(:,:,i),xn1,yn1,tmp)
 6042:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 6043:             //      &eframe(:,:,i),xn2,yn2,tmp)
 6044:          } //ics
 6045:                    
 6046:          diffRho = 0.0;
 6047: 
 6048:       } else { //internal and wet
 6049:          if constexpr(ics==1) {
 6050:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 6051: 
 6052:             // Vector from e1 to e2
 6053:             vec = e2->center - e1->center;
 6054: 
 6055:          } else { 
 6056:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6057:             // Remember that elem->center is in global coordinates
 6058:             // IMPLEMENT THIS XXXXXX
 6059:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 6060:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 6061:             //                   alow(j)=xctr2
 6062:             //                   bdia(j)=yctr2
 6063:          } // ics
 6064: 
 6065:          diffRho = rho2 - e1->demeanedDensity(k);
 6066:       }
 6067: 
 6068:    }
 6069: 
 6070:    __global__ void computeDensityCubicSplines(void) {
 6071:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 6072: 
 6073:       ELEM(elem);
 6074: 
 6075:       if (elem->isDry) return;
 6076: 
 6077:       const int kb = elem->kb;
 6078: 
 6079:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 6080:       if (elem->is2D()) {
 6081:          // In the 2D case, the density is constant at the prism level. 
 6082:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 6083:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 6084:       } else { //3D
 6085: 
 6086:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 6087:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 6088:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 6089:          ///// XXXX CHECK INDICES!!!!!
 6090:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 6091:       } // 2D/3D
 6092: 
 6093:    }
 6094: } // extern "C"
 6095: 
 6096: 
 6097: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 6098: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 6099: 
 6100:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 6101: 
 6102:    const int kb  = elem->kb;
 6103:    const int kb2 = elem2->kb;
 6104: 
 6105:    // z-coordinate of prism of elem
 6106:    const double zp = elem->z_prism(k);
 6107: 
 6108:    double rho = 0.0;
 6109: 
 6110:    if (elem2->is2D()) {
 6111:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 6112: 
 6113:    } else {  // 3D
 6114: 
 6115:       // eta_min may be < zmax
 6116:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 6117:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 6118: 
 6119:       // (Extrapolate density below bottom, we will fix it later)
 6120:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 6121:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 6122:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 6123:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 6124:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 6125:    } // 2D/3D
 6126:      
 6127: 
 6128:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 6129:    // Now we need to fix it.
 6130:    if (elem->z[k] < elem2->z[kb2]) {
 6131:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 6132: 
 6133:       // There are two methods to adjust the density at the bottom of the element.
 6134:       // iunder_deep=0: 
 6135:       const double depth1 = abs(elem->z[kb]); // larger depth
 6136: 
 6137:       if (iunder_deep==0) {
 6138: 
 6139:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 6140: 
 6141:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 6142: 
 6143:       } else { // iunder_deep != 0
 6144: 
 6145:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 6146: 
 6147:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 6148: 
 6149:          //   Demeaned density at the same z coordinate as
 6150:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 6151:          }
 6152: 
 6153:       } // if iunder_deep
 6154:    } // if elem->z[kb] < elem2->z[kb]
 6155: 
 6156:    return rho;
 6157: }
 6158: 
 6159: 
 6160: extern "C" {
 6161:    __global__ void computeDensityGradient(void) {
 6162: 
 6163:       if constexpr(ibc != 0) return;
 6164: 
 6165:          // Compute the horizontal density gradient at each element.
 6166:       // It works in two steps:
 6167:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6168:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6169:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6170:       //             gradRho.r1 = rho1 - rho0
 6171:       //             gradRho.r2 = rho2 - rho0
 6172:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6173:       // 
 6174:       //  NOTE: We use de-meaned densities.
 6175: 
 6176:       ELEM(elem);
 6177: 
 6178:       if (elem->isDry) return;
 6179: 
 6180:       const int kb  = elem->kb;
 6181:       const int i34 = elem->i34;
 6182: 
 6183:       for (int k = kb + 1; k < nvrt; k++) {
 6184:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 6185:          //             gradRho.r1 = rho1 - rho0
 6186:          //             gradRho.r2 = rho2 - rho0
 6187:          int icount = 0;
 6188:          double sumRx = 0.0;
 6189:          double sumRy = 0.0;
 6190:          for (int j1=0; j1<i34; j1++) { 
 6191: 
 6192:             const int j2 = elem->nxq(j1 + 1);
 6193: 
 6194:             // Pairs of consecutive neighbor elements of elem
 6195:             const Element *e1 = elem->nghbElems[j1];
 6196:             const Element *e2 = elem->nghbElems[j2];
 6197: 
 6198:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 6199:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 6200:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 6201: 
 6202:             // Compute the density difference and the vector from elem to e1 and e2
 6203:             // getRhoDiffAndVec takes into account boundaries/dry elements
 6204:             double diffRho1, diffRho2;
 6205:             Vector2 vec1, vec2;
 6206:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 6207:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 6208: 
 6209:             const double rl1 = length(vec1);
 6210:             const double rl2 = length(vec2);
 6211:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 6212: 
 6213:             const double delta = cross(vec1, vec2);
 6214:             const double sintheta = abs(delta)/(rl1*rl2);
 6215: 
 6216:             // To avoid problems, avoid elements with small angle between vectors
 6217:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 6218:             const bool validEq = (sintheta > sin_one_deg);
 6219: 
 6220:             if (validEq) {
 6221:                // Solve the system of equations to get the density gradient at elem
 6222:                icount++;
 6223:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 6224:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 6225:                sumRx += Rx;
 6226:                sumRy += Ry;
 6227:             }
 6228:          } // for j1
 6229: 
 6230:          // Compute the average density gradient at elem
 6231:          if (icount==0) {
 6232:            // Bad mesh quality; bail out with 0 b-cc
 6233:            elem->gradRho[k] = {0.0, 0.0};
 6234:          } else {
 6235:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 6236:          }
 6237: 
 6238:       } // for k
 6239: 
 6240:    }
 6241: 
 6242:    __global__ void computeBaroclinicTerm(void) {
 6243:    // Computes the baroclinic term at sides (at half levels).
 6244:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 6245:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 6246: 
 6247:       if (ibc == 1) return;
 6248: 
 6249:       SIDE(side);
 6250: 
 6251:       if (side->isDry) return;
 6252: 
 6253:       const Element *e1 = side->elems[0];
 6254:       const Element *e2 = side->elems[1]; 
 6255:       const int kb = side->kb;
 6256:       
 6257:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 6258: 
 6259:       // interpolates vertically the density gradient of the two elements at the half level/
 6260: 
 6261:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 6262:       int k2 = max(kb, nvrt / 2);
 6263: 
 6264:       // Starts the integration at the surface and goes down to the bottom
 6265:       side->bcc[nvrt-1] = {0.0, 0.0};
 6266:       for (int k = nvrt - 2; k >= kb; k--) {
 6267:       // For each prism level (from surface to bottom)...
 6268: 
 6269:          // For both elements, interpolate density gradient at the side's half level.
 6270:          // The gradient at the side is the average of the gradients at the elements.
 6271:          // w1, w2 are used to take into account boundary sides, with just one element.
 6272:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 6273:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 6274:          const double wsum = w1 + w2;
 6275:          w1 = w1/wsum;
 6276:          w2 = w2/wsum;
 6277:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 6278: 
 6279:          // Linear interpolation of both elements' density gradient at the shared side's level.
 6280:          Vector2 gradRho = {0.0, 0.0};
 6281:          if (e1 != nullptr && k > kb) {
 6282:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 6283:             
 6284:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 6285:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 6286:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6287: 
 6288:             // Grad(rho) vertically interpolated at the side's half level
 6289:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 6290: 
 6291:             // Projects the element density gradient to the side frame if needed.
 6292:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 6293: 
 6294:             // Adds the contribution of the density gradient at the side's half level
 6295:             gradRho += gradRho1*w1;
 6296:          }      
 6297:          if (e2 != nullptr && k > kb) {
 6298:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 6299:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 6300:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6301:             
 6302:             // Grad(rho) vertically interpolated at the side's half level
 6303:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 6304: 
 6305:             // Projects the element density gradient to the side frame if needed.
 6306:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 6307: 
 6308:             // Adds the contribution of the density gradient at the side's half level
 6309:             gradRho += gradRho2*w2;
 6310:          }
 6311: 
 6312:          
 6313:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 6314:          // multiplied by -rampbc*(g/rho0) 
 6315:          const double grav3 = side->grav3();
 6316:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 6317: 
 6318:       } // for
 6319: 
 6320:    }
 6321: 
 6322: 
 6323: 
 6324:    __global__ void computeHorGradientAtSide(void) {
 6325: 
 6326:       // Compute the horizontal density gradient at each element.
 6327:       // It works in two steps:
 6328:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6329:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6330:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6331:       //             gradRho.r1 = rho1 - rho0
 6332:       //             gradRho.r2 = rho2 - rho0
 6333:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6334:       // 
 6335:       //  NOTE: We use de-meaned densities.
 6336: 
 6337:       SIDE(side);
 6338: 
 6339: 
 6340:       if (side->isDry) return;
 6341: 
 6342:       // Computes the gradient of the variables at the side center.
 6343:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 6344:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 6345:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 6346: 
 6347:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 6348:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 6349:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 6350:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 6351: 
 6352:    }
 6353: 
 6354: 
 6355:    __global__ void solveMomentumEquations(double time) {
 6356: 
 6357:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 6358:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 6359: 
 6360:       SIDE(side);
 6361: 
 6362:       if (side->isDry) 
 6363:       {
 6364:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 6365: 
 6366:          return;
 6367:       }
 6368: 
 6369:       const Node *n1 = side->n1;
 6370:       const Node *n2 = side->n2;
 6371: 
 6372:       const int kb = side->kb;
 6373: 
 6374:       const double veg_h = side->veg_h();
 6375:       const double grav3 = side->grav3();
 6376: 
 6377:       if (side->is2D()) {
 6378:          // Remember: Do not use htot2, which is updated.
 6379:          const double htot = side->htot1();
 6380:          const double hhat = side->hhat;
 6381: 
 6382:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 6383: 
 6384:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6385:          const Vector2 tau2 = side->tau();
 6386: 
 6387:          // hat_gam has units of m/s
 6388: 
 6389:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 6390:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 6391:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 6392: 
 6393:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 6394: 
 6395: 
 6396:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 6397: 
 6398:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 6399: 
 6400:       }
 6401:       else { // 3D
 6402: 
 6403:          // For 3D it is necessary to solve an implicit tridiagonal system.
 6404:          // 
 6405:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 6406:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 6407:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 6408:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 6409:          // k+1 and k.
 6410: 
 6411: 
 6412:          const int ndim = nvrt - kb;
 6413:          const double zTopCanopy = side->zTopCanopy();
 6414: 
 6415:          // Initialize the tridiagonal system
 6416:          for (int k = kb + 1; k < nvrt; k++) {
 6417:             
 6418:             const int kin = k - (kb + 1);
 6419: 
 6420:             // Vertical viscosity at the face center
 6421:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 6422: 
 6423:  
 6424:             alow[kin] = 0.0;
 6425:             cupp[kin] = 0.0;
 6426:             bdia[kin] = 0.0;
 6427: 
 6428:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 6429:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 6430: 
 6431:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 6432:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 6433:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 6434: 
 6435:             // First part: layers k, k+1
 6436:             if (k < nvrt - 1) {
 6437:                              
 6438:                if constexpr(iveg != 0) {
 6439: 
 6440:                   // If there is vegetation at this level...
 6441:                   if (zTopCanopy > side->zc[k]) {
 6442:                      // If the canopy is above the k layer...
 6443:                      
 6444:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 6445:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 6446:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 6447:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 6448: 
 6449:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 6450:                      const double vmag2 = length(ut2);
 6451:                      const double vmag1 = length(side->u2[k]);
 6452:                      const double vmag = 0.5*(vmag1 + vmag2);
 6453:                      
 6454:                      // Computes the vegetation alpha at the face center
 6455:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 6456: 
 6457:                      cff1 += veg_alpha_sd*dt*vmag;
 6458: 
 6459:                   } // if (zTopCanopy
 6460:                } // if iveg
 6461: 
 6462:                const double dzz = side->Dz(k + 1);
 6463:                const double tmp = dt*dfz/dzz;
 6464:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6465: 
 6466:                cupp[kin] += cff1*dzz/6.0 - tmp;
 6467:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6468:             }
 6469: 
 6470: 
 6471:             // Second part: layers k-1, k
 6472:             if (k > kb + 1) {
 6473: 
 6474:                double cff1 = 1.0; //init \bar{c^k}
 6475: 
 6476:                if constexpr(iveg != 0) {
 6477:                   // If there is vegetation at this level...
 6478:                   if (zTopCanopy > side->zc[k-1]) {
 6479:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 6480:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 6481: 
 6482:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 6483: 
 6484:                      const double vmag2 = length(ut2);
 6485:                      const double vmag1 = length(side->u2[k-1]);
 6486:                      const double vmag = 0.5*(vmag1 + vmag2);
 6487: 
 6488:                      // Computes the vegetation alpha at the face center
 6489:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 6490:                      cff1 += veg_alpha_sd*dt*vmag;
 6491:                   } // if zTopCanopy
 6492: 
 6493:                } // if iveg
 6494: 
 6495:                const double dzz = side->Dz(k);
 6496:                const double tmp = dt*dfz/dzz;
 6497:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6498: 
 6499:                alow[kin] += cff1*dzz/6.0 - tmp;
 6500:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6501: 
 6502:             } else { // Bottom boundary
 6503:                // This occurs at the bottom, where the bottom drag is applied.
 6504: 
 6505:                bdia[kin] += dt*side->chi2; // XXXX
 6506: 
 6507:             } // if (k > kb + 1)
 6508: 
 6509: 
 6510:          } // for (int k
 6511: 
 6512: 
 6513: 
 6514:          // Computes the RHS.
 6515:          // -----------------
 6516: 
 6517:          //	BC to be imposed at the end.
 6518: 
 6519:          const Vector2 gradETP  = side->gradETP;
 6520:          const Vector2 gradPr   = side->gradPr;
 6521:          const Vector2 gradEta1 = side->gradEta1;
 6522:          const Vector2 gradEta2 = side->gradEta2;
 6523: 
 6524:          const Vector2 *btu = side->btu;
 6525:          const Vector2 *u2  = side->u2;
 6526:          const double coriolis = side->coriolis;
 6527:          const Vector2 *nuGradU = side->nuGradU;
 6528: 
 6529:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 6530:          for (int k = kb + 1; k < nvrt; k++) {
 6531:             const int kin = k - kb - 1;
 6532: 
 6533:             const double dz_0 = side->Dz(k);
 6534:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 6535: 
 6536:             rrhs[kin] = {0.0, 0.0};
 6537:             double dz = 0.0;
 6538: 
 6539:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 6540:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 6541:             if (k < nvrt  ) dz += dz_1;
 6542:             if (k > kb + 1) dz += dz_0;
 6543: 
 6544:             // Elevation gradient, atmospheric pressure and tidal potential
 6545:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 6546: 
 6547:             // Coriolis, advection, wind stress, and horizontal viscosity
 6548:             if (k < nvrt - 1) {
 6549: 
 6550: 
 6551:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 6552:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 6553:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 6554:                                                 
 6555: 
 6556:                //diff stress tensors 1006
 6557:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 6558:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 6559:                   assert(false && "Not implemented: itur == 5");
 6560:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 6561:                }
 6562:                // else assert(false && "itur # Not implemented");
 6563: 
 6564:             } else { // k == nvrt - 1 SURFACE
 6565:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6566:                const Vector2 tau2 = side->tau();
 6567: 
 6568:                rrhs[kin] += dt*tau2;          
 6569: 
 6570:             } // if k<nvrt
 6571: 
 6572: 
 6573:             if (k > kb + 1) {
 6574:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 6575:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 6576:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 6577: 
 6578:                // diff stress tensors 1006
 6579:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 6580:                   assert(false && "Not implemented: itur == 5");
 6581:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 6582:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 6583:                }
 6584:                // else assert(false && "itur # Not implemented");
 6585: 
 6586: 
 6587:             } // if k>kbs + 1
 6588: 
 6589:             // Baroclinic
 6590:             Vector2 *bcc = side->bcc;
 6591:             if constexpr(ibc == 0) {
 6592:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 6593:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 6594: 
 6595:             } // if ibc==0
 6596: 
 6597:          } // k=kb + 1,nvrt
 6598: 
 6599: 
 6600:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 6601: 
 6602:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 6603:             const int kin = k - kb - 1;
 6604:    
 6605:             // Velocity is always clamped to maximum values
 6606:             side->u2[k] = clampVelocity(soln[kin]);
 6607:          } // k
 6608: 
 6609:       } // if side->is2D()
 6610:       
 6611: 
 6612:       // Impose velocity boundary condition at the bottom
 6613:       if constexpr(imm == 2) { // 3D bed deformation model
 6614:          double dep;
 6615:          Vector2 vel;
 6616: 
 6617:          assert(false && "Not implemented: imm == 2");
 6618:          //update_bdef(time, x0, y0, dep, vel);
 6619:          // side->u2[kb] = vel;
 6620: 
 6621:       } else { // imm = 0 or 1
 6622:          if (side->Cd() == 0.0) {
 6623:             side->u2[kb] = side->u2[kb + 1];
 6624: 
 6625:          } else if (side->is3D()) { // 3D no slip bottom   
 6626:             side->u2[kb] = {0.0, 0.0};
 6627: 
 6628:          }
 6629:           
 6630:       } // if imm
 6631: 
 6632:       // The velocities below the bottom level are set to zero
 6633:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 6634: 
 6635: 
 6636:    }
 6637: 
 6638: 
 6639:    __global__ void applyMomentumBC(void) {
 6640: 
 6641:       SIDE_BND(sideBnd);
 6642: 
 6643:       Side *side = sideBnd->side;
 6644:       const BoundarySegment *segment = sideBnd->segment;
 6645:       const Node *n1 = side->n1;
 6646:       const Node *n2 = side->n2;
 6647: 
 6648:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 6649: 
 6650:       const bool isLand = segment->isLand;
 6651:       const int ifltype = segment->ifltype;
 6652: 
 6653:       const int kb = side->kb;
 6654: 
 6655: 
 6656:       if (!isLand && ifltype != 0) {
 6657:          const Vector2 *ubc = sideBnd->ubc;
 6658:   
 6659:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 6660:             
 6661:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 6662:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 6663: 
 6664:             if (ifltype == -1) {
 6665:                // Flather 1
 6666: 
 6667:                const double depth = side->depth();
 6668: 
 6669:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 6670: 
 6671:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 6672: 
 6673:                side->u2[k] = vnorm*side->n;
 6674: 
 6675:             } else if (ifltype == -2) { // Discharge
 6676: 
 6677:                const double eta1 = side->eta1();
 6678:                const double eta2 = side->eta2();
 6679:                const double htot = side->htot2();
 6680: 
 6681:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 6682:                assert(false && "Not implemented: Discharge bc");
 6683:                // const double dischrg = discharge(eta1);
 6684:                const double dischrg = 0.0; // XXX REMOVE
 6685:                
 6686: 
 6687:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 6688: 
 6689:                const double vnorm = dischrg*eta2/htot;
 6690: 
 6691:                side->u2[k] = vnorm*side->n;
 6692: 
 6693:             }
 6694:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 6695:                const double vnorm = dot(side->u2[k], side->n);
 6696: 
 6697:                double rat;
 6698:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 6699:                else              rat = segment->vobc2; // outgoing
 6700: 
 6701:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 6702: 
 6703:             }
 6704:             else { // not Flather or 3D radiation
 6705:                side->u2[k] = ubc[k];
 6706: 
 6707:             } // if (segment->ifltype...
 6708: 
 6709:          }
 6710: 
 6711:       }
 6712:       else if (isLand) { // if it is land boundary side
 6713: 
 6714:          if constexpr(islip == 0) { // free slip
 6715: 
 6716:             for (int k = kb; k < nvrt; k++) {
 6717: 
 6718:                const Vector2 t = side->t();
 6719:                const Vector2 n = side->n;
 6720: 
 6721:                double vnorm = 0.0; // for most cases
 6722:                const double vtan = dot(side->u2[k], t);
 6723:                
 6724:                side->u2[k] = vtan*t - vnorm*n;
 6725: 
 6726:             }
 6727: 
 6728:          } else { // no slip
 6729:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 6730: 
 6731:          }
 6732:       } // if (side segment type...
 6733: 
 6734:    
 6735: 
 6736:    }
 6737: 
 6738: 
 6739:    __global__ void shapiroFilter1(void) {
 6740:       // First step of the Shapiro filter (normally used if indvel<=0)
 6741:       // Computes the filtered values and stores them in bcc (as a temporary array).
 6742: 
 6743:       SIDE(side);
 6744: 
 6745:       // Only internal wet sides are processed
 6746:       if (side->isDry || !(side->isInternal())) return;
 6747: 
 6748:       const int kb = side->kb;
 6749: 
 6750:       for (int mm = 0; mm < niter_shap; mm++) {
 6751: 
 6752:          for (int k = kb + 1; k < nvrt; k++) {
 6753:             // WARNING: reusing bcc as a temporary array to store the suru values.
 6754:             Vector2 suru = {0.0, 0.0};
 6755: 
 6756:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 6757: 
 6758:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 6759: 
 6760:                int kin = k;
 6761:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 6762:                
 6763:                // Get the velocity at the neighbor's side.
 6764:                Vector2 nSideU2 = nSide->u2[kin];
 6765: 
 6766:                // Projects the velocity to the current side frame if needed.
 6767:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 6768: 
 6769:                suru += nSideU2;
 6770:             }
 6771: 
 6772:             // Reusing bcc as a temporary array to store the suru values.
 6773:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 6774: 
 6775:          }
 6776:       }
 6777:    }
 6778: 
 6779:    __global__ void shapiroFilter2(void) {
 6780:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6781: 
 6782:       SIDE(side);
 6783: 
 6784: 
 6785:       if (side->isDry || !(side->isInternal())) return;
 6786: 
 6787:       const int kb = side->kb;
 6788: 
 6789:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6790: 
 6791:       if (side->is2D()) {
 6792:          side->u2[kb + 1] = side->bcc[kb + 1];
 6793:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6794: 
 6795:       } else {
 6796:          // 3D
 6797:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6798:          
 6799:       }
 6800: 
 6801:    }
 6802: 
 6803: 
 6804:    __global__ void ul0UpdateZCoords(void) {
 6805:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6806:       
 6807:       NODE(node);      
 6808: 
 6809: 
 6810:       if (false) { //node->isDry) { XXXXXXX
 6811: 
 6812:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6813: 
 6814:          if constexpr(ivcor != 1) node->kb = 0;
 6815: 
 6816:       } else {
 6817: 
 6818:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6819:          node->updateKb();
 6820: 
 6821:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6822: 
 6823:       }
 6824: 
 6825:       // We use the temp.b field to store the previous state of isDry.
 6826:       node->tmp.b = node->isDry;
 6827: 
 6828:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6829:       node->isDry = true;
 6830: 
 6831:    }
 6832: 
 6833:    __global__ void ul0ComputeDryElements(void)
 6834:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6835:    {
 6836:       ELEM(elem);
 6837: 
 6838:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6839: 
 6840:       elem->kb = 0;
 6841: 
 6842:       if (elem->isDry) return;
 6843: 
 6844: 
 6845:    //    if(elem->isDry2()) { // XXXX
 6846:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6847:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6848:    //        call parallel_abort(errmsg)
 6849:    //    }
 6850: 
 6851:       const Node *n1 = elem->nodes[0];
 6852:       const Node *n2 = elem->nodes[1];
 6853:       const Node *n3 = elem->nodes[2];  
 6854:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6855: 
 6856:       // Computes element's kb as the minimum of the nodes' kb.
 6857:       const int kb1 = n1->kb;
 6858:       const int kb2 = n2->kb;
 6859:       const int kb3 = n3->kb;
 6860:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 6861: 
 6862: 
 6863:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6864: 
 6865: 
 6866:       // Computes the element z as the mean of the nodes z.
 6867:       for (int k = elem->kb; k < nvrt; k++) {
 6868: 
 6869:          // Compute the element z as the mean of the nodes z.
 6870:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6871:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6872:          elem->z[k] /= elem->i34;
 6873: 
 6874:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 6875:       }
 6876:                   
 6877:    }
 6878: 
 6879:    __global__ void ul0ComputeDryNodes(void)
 6880:    // Updates node's isDry based on the elements' isDry. 
 6881:    {
 6882:       NODE(node);
 6883: 
 6884:       node->isDry = true;
 6885: 
 6886:       // A node is wet if at least one of the elements sharing it is wet.
 6887:       for (int j = 0; j < node->numElements; j++) {
 6888:          const Element *elem = node->elements[j];
 6889:          if (!elem->isDry) {
 6890:             node->isDry = false;
 6891:             break;
 6892:          }
 6893:       }
 6894: 
 6895:        
 6896:    }
 6897: 
 6898: 
 6899:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6900:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6901:    // node->tmp.b is true if the node was previously dry.
 6902:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6903:    {
 6904:       NODE(node);
 6905:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6906: 
 6907:       // Avoid this the first time step.
 6908:       if (it == iths) return;  
 6909: 
 6910:       const bool wasDry = node->tmp.b;
 6911: 
 6912: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6913: 
 6914:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 6915: 
 6916:          for (int k=0; k < nvrt; k++) {
 6917: 
 6918:             Vector3 utmp={0.0, 0.0, 0.0};
 6919: 
 6920:             double ttmp=0.0;
 6921:             double stmp=0.0;
 6922:             int icount=0;
 6923:             for (int j = 0; j < node->numNodes; j++) {
 6924: 
 6925:                const Node *nbrNode = node->nodes[j];
 6926:                
 6927:                const bool wasNbrDry = nbrNode->tmp.b;
 6928: 
 6929:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 6930:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 6931: 
 6932:                   icount++;
 6933: 
 6934:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6935:                   utmp += nbrNode->uvw2(k);
 6936:                   
 6937:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 6938:                   stmp += nbrNode->tracers[k].tracer[1]; 
 6939:                }
 6940:             }
 6941: 
 6942:             if (icount > 0) {
 6943:                const double inv_icount = 1.0/icount;
 6944:                utmp = inv_icount*utmp;
 6945:                node->u2[k]     = {utmp.x, utmp.y};
 6946:                node->w2[k]     = utmp.z;
 6947:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6948:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6949:             } else {
 6950:                node->u2[k] = {0.0, 0.0};
 6951:                node->w2[k] = 0.0;
 6952:                // Initialize tracers to 0.0??? XXXXX
 6953:             }
 6954:          }
 6955:       }
 6956:    }
 6957: 
 6958:   
 6959:    
 6960: 
 6961: 
 6962:    __global__ void ul0UpdateSides(int it, int iths) {
 6963:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 6964:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 6965:    // The dryness of the sides is updated in ul0UpdateSides2.
 6966: 
 6967:       SIDE(side);
 6968: 
 6969:       // A side is wet if and only if at least one of its elements is wet.
 6970:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6971:  
 6972:       const Node *n1 = side->n1;
 6973:       const Node *n2 = side->n2;
 6974:      
 6975:       const int kb1 = n1->kb;
 6976:       const int kb2 = n2->kb;
 6977: 
 6978:       side->kb = 0; // default when dry
 6979: 
 6980:       if (isWet) {
 6981: 
 6982:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6983: 
 6984:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6985: 
 6986:          side->kb = min(kb1, kb2);
 6987: 
 6988:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6989: 
 6990:          for (int k = side->kb; k < nvrt; k++) {
 6991:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6992: 
 6993:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 6994: 
 6995:             // Compute velocity for re-wetted sides 
 6996:             if ((it != iths) && (side->isDry && isWet)) {
 6997: 
 6998:                Vector2 utmp={0.0, 0.0};
 6999: 
 7000:                int icount=0;
 7001: 
 7002:                // For all the sides on the two elements that share this side
 7003:                for (int j = 0; j < 2; j++) {
 7004:                   const Element *elem = side->elems[j];
 7005:                   if (elem == nullptr) continue;
 7006: 
 7007:                   for (int jj=0; jj < elem->i34; jj++) {
 7008:                      const Side *nSide = elem->sides[jj];
 7009:                      if (nSide->isDry) continue;
 7010: 
 7011:                      icount++;
 7012:                      utmp += nSide->u2[k];  
 7013:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 7014:                   }
 7015:                }
 7016:                   
 7017:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 7018:                if (icount > 0)  side->u2[k] = utmp/icount;
 7019:                else             side->u2[k] = {0.0, 0.0};
 7020:                   
 7021:             } // if ((it != iths) && (side->isDry && isWet))
 7022: 
 7023:          } // for k
 7024: 
 7025:       } // if isWet 
 7026:       
 7027: 
 7028: 
 7029:    }
 7030: 
 7031:    __global__ void ul0UpdateSides2(void) {
 7032:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 7033:    
 7034:          SIDE(side);
 7035:    
 7036:          const Element *e1 = side->elems[0];
 7037:          const Element *e2 = side->elems[1];
 7038: 
 7039:          // A side is wet if and only if at least one of its elements is wet.
 7040:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 7041: 
 7042:          // Update the side's dryness
 7043:          side->isDry = !isWet;
 7044: 
 7045:    }
 7046: 
 7047: 
 7048:    __global__ void zeroNodalVelocities(void) {
 7049:       NODE(node);
 7050: 
 7051:       for (int k = 0; k < nvrt; k++) {
 7052:          node->u2[k]   = {0.0, 0.0};
 7053:          node->w2[k]   = 0.0;
 7054:          node->utmp[k] = {0.0, 0.0};         
 7055:       }
 7056:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 7057:    }
 7058:  
 7059: 
 7060:    __global__ void computeNodalVerticalVelocities1(void) {
 7061:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7062:    // Adds the element's vertical velocity times the element's area.
 7063:       ELEM(elem);
 7064: 
 7065:       for (int j = 0; j < elem->i34; j++) {
 7066:          Node *node = elem->nodes[j];
 7067: 
 7068:          for (int k = node->kb; k < nvrt; k++) {
 7069:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 7070:          }
 7071:          atomicAdd(&(node->tmp.d), elem->area);
 7072:       }
 7073:    }
 7074: 
 7075:    __global__ void computeNodalVerticalVelocities2(void) {
 7076:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7077:    // Divides by the total area of the elements sharing the    node.
 7078:       NODE(node);
 7079: 
 7080:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 7081: 
 7082:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 7083:    }
 7084: 
 7085: 
 7086:    __global__ void computeNodalHorizontalVelocities1(void) {
 7087: 
 7088:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 7089: 
 7090:       ELEM(elem);
 7091: 
 7092:       if (elem->isDry) return;
 7093: 
 7094:       const int kb = elem->kb;
 7095:       const bool isTri = elem->isTri();
 7096: 
 7097:       if constexpr(indvel <= 0) {
 7098:          // Assuming discontinous hvel.
 7099: 
 7100:          if (isTri) { // For triangles
 7101:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 7102:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 7103: 
 7104:             for (int j = 0; j < 3; j++) {
 7105:                // For every node of the triangle...
 7106:                Node *node = elem->nodes[j];
 7107: 
 7108:                if (node->isDry) continue;
 7109: 
 7110:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 7111:                const Side *s2 = elem->sides[(j + 1) % 3];
 7112:                const Side *s3 = elem->sides[(j + 2) % 3];
 7113: 
 7114:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 7115: 
 7116:                atomicAdd(&(node->tmp.i), 1);
 7117: 
 7118:                for (int k = kb; k < nvrt; k++)  {
 7119:                   Vector2 s1u2 = s1->u2[k];
 7120:                   Vector2 s2u2 = s2->u2[k];
 7121:                   Vector2 s3u2 = s3->u2[k];
 7122: 
 7123:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 7124:                   if constexpr(ics == 2) {
 7125:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 7126:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 7127:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 7128:                   }
 7129: 
 7130:                   Vector2 u = s2u2 + s3u2 - s1u2; // u interpolated linearly at node j.   
 7131:                   u = clampVelocity(u);
 7132:                   atomicAdd(&(node->utmp[k].x), u.x);
 7133:                   atomicAdd(&(node->utmp[k].y), u.y);
 7134: 
 7135:                }
 7136: 
 7137:             }
 7138:          }
 7139:          else { // For quads
 7140:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 7141: 
 7142:          }
 7143: 
 7144:       }
 7145:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 7146:       
 7147:    }
 7148: 
 7149: 
 7150:    __global__ void computeNodalHorizontalVelocities2(void) {
 7151:       NODE(node);
 7152: 
 7153:       const int nodeCount = node->tmp.i;
 7154: 
 7155:       if (nodeCount == 0) 
 7156:       {
 7157:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 7158:          return;
 7159:       }
 7160: 
 7161:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 7162:       
 7163:       const int kb = node->kb;
 7164: 
 7165:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 7166:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 7167:       
 7168:       
 7169:    }   
 7170: 
 7171:  
 7172: 
 7173:    __global__ void resetVelocityOpenBndNodes(void) {
 7174:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 7175: 
 7176:       NODE_BND(nodebnd);
 7177: 
 7178:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 7179:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 7180:       }
 7181: 
 7182:    }
 7183: 
 7184: 
 7185:    __global__ void setVelocityOpenBndNodes(void) {
 7186:    // For open boundary nodes sets their velocity to the imposed values.
 7187: 
 7188:       SIDE_BND(sidebnd);
 7189: 
 7190:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 7191:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 7192:          // to its segment to the average of the side velocity.
 7193: 
 7194:          for (int k = 0; k < nvrt; k++) {
 7195:             Node *n1 = sidebnd->side->n1;
 7196:             Node *n2 = sidebnd->side->n2;
 7197: 
 7198: 
 7199:             Vector2 n1_u2(n1->u2[k]);
 7200:             Vector2 n2_u2(n2->u2[k]);
 7201: 
 7202:             if (n1->nodeBnd->segment == sidebnd->segment) {
 7203:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 7204:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 7205:             }
 7206:             if (n2->nodeBnd->segment == sidebnd->segment) {
 7207:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 7208:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 7209:             }
 7210: 
 7211:          }
 7212: 
 7213:       }
 7214: 
 7215:    }
 7216: 
 7217: 
 7218:    __global__ void computeVerticalVelocity(void) {
 7219:       // Computes the vertical velocity at the (2D) element's centroid.
 7220:       // In this function we will be considering volumetric elements, with side faces and a 
 7221:       // bottom and a top face. We will call them SFs, BF and TF.
 7222:       // It computes the flux coming from BF and the SFs.
 7223:       // If the bed is moving, it takes that into account.
 7224:       // Since water is incompressible, the integral of the velocity times the normal vector
 7225:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 7226:       // and the BF is equal to the flux going out from the TF.
 7227:       // TF = - BF - sum(SFs).
 7228:       // It then computes the horizontal velocity at the center of TF.
 7229:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 7230:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 7231:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 7232: 
 7233:       ELEM(elem);
 7234: 
 7235:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 7236: 
 7237:       if (elem->isDry) return;
 7238: 
 7239:       const int kb = elem->kb;
 7240:       const bool isTri = elem->isTri();
 7241: 
 7242:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 7243: 
 7244:       // Compute the bottom velocity
 7245:       if constexpr(imm != 0) {
 7246:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 7247:       }
 7248: 
 7249: 
 7250:       double bottomArea3D;
 7251:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 7252: 
 7253:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 7254: 
 7255:       double topArea3D;
 7256: 
 7257:       // Bottom face flux
 7258:       double bottomFlux = 0.0;
 7259:       Vector2 u2meanBottom = {0.0, 0.0};
 7260:       const Vector2 gradh = elem->grad2(&Node::depth);
 7261:       if constexpr(imm==2) {
 7262:          Vector3 ubed;
 7263: 
 7264:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 7265:          // updateBDEF(ubed);
 7266:      
 7267:          // const double bflux0 = dot(ubed, elem_bottom_n);
 7268: 
 7269:          // elem->w[kb] += ubed.z;
 7270:       }
 7271:       else {
 7272: 
 7273: 
 7274:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 7275:   
 7276:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 7277:          // in the direction of motion.
 7278:          const double bottomW = - dot(gradh, u2meanBottom);  
 7279:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 7280: 
 7281:          // VElocity associated to the bed deformation
 7282:          double bedVelocity = 0.0;
 7283:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 7284: 
 7285:          elem->w[kb] = bedVelocity + bottomW; 
 7286: 
 7287:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 7288:          
 7289:       } // if imm
 7290: 
 7291:       // Compute w for kb+1 to nvrt-1
 7292:       for (int l = kb; l < nvrt - 1; l++) {
 7293: 
 7294:          // normal vector to the top face of the "volumetric" element (3D)
 7295:          Vector3 elem_top_n = -elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 7296: 
 7297:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 7298:          assert(elem_top_n.z < 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 7299: 
 7300:          // Compute the total flux at the sides
 7301:          double sideFlux = 0.0;
 7302: 
 7303:          for (int j = 0; j < elem->i34; j++) {
 7304:             const Side *side = elem->sides[j];
 7305:             const int kbs = side->kb;
 7306:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 7307:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 7308:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 7309: 
 7310:             // The area is "clamped" meaning that it takes kb into account.
 7311:             const double sideArea = side->areaClamped(l);
 7312: 
 7313:             const double sign = elem->ssign[j]; 
 7314: 
 7315:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 7316:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 7317:          }
 7318:          
 7319:          // Compute the horizontal velocity at the center of the top face as an average of the 
 7320:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 7321:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 7322: 
 7323:          // The flux at the top ace can be computed from the other flows.
 7324:          // All fluxes are in directions into the prism.
 7325:          const double topFlux = - sideFlux - bottomFlux;
 7326: 
 7327:          // Flux at the top face due to the horizontal velocities only
 7328:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 7329: 
 7330:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + bottomFlux = 0, so:
 7331:          const double topVerticalFlux = -sideFlux - topHorizontalFlux - bottomFlux;  
 7332: 
 7333:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 7334: 
 7335:          bottomFlux = -topFlux;
 7336:       }
 7337:    }  
 7338: 
 7339: 
 7340: 
 7341: 
 7342: 
 7343: 
 7344: 
 7345: // !===============================================================================
 7346: // !===============================================================================
 7347: 
 7348: } // extern "C"
 7349: 
 7350: #ifdef DONTCOMPILE
 7351: __device__ void computeVerticalAdvection(void) {
 7352:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 7353: 
 7354:    sdbt(1:2,:,:)=0.d0
 7355: 
 7356:    const Side *side = FROM kernel;
 7357: 
 7358:    if(side->isDry) return;
 7359: 
 7360:    // If side is wet...
 7361: 
 7362: 
 7363:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 7364:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 7365:    double ws[nvrt] = {} // w @ side
 7366:    int icount = 0;
 7367:    for (int j=0; j<2; j++) {
 7368:       const Element *elem = side->elements[j];
 7369:        
 7370:       if(elem != nullptr) {
 7371:          icount++;
 7372:          for (int k=0; k<nvrt; k++) {
 7373:             ws[k] = ws[k] + elem->w[k];
 7374:          }
 7375:       }
 7376:    }  // for j
 7377: 
 7378:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 7379:    ws = ws/icount;
 7380: 
 7381:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 7382:    // Splines allow for a smooth transition between vertical levels.
 7383:    // Splines have continuity restrictions at the internal knots, but
 7384:    // we have to provide the 1st derivatives at the endpoints.
 7385:    const int kbs = side->kbs; 
 7386:    
 7387:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7388:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7389:    initCubicSpline(kbs, nvrt, side, ws, up)
 7390: 
 7391:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7392:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7393:    initCubicSpline(kbs, nvrt, side, ws, vp)
 7394: 
 7395:    // Total advection (average onto side)
 7396:    const Node *node1 = side->nodes[0];
 7397:    const Node *node2 = side->nodes[1];
 7398:    for (int k=kbs(i); k<nvrt; k++) {
 7399: 
 7400:       Vector2 bcc1 = node1->bcc[k];
 7401:       Vector2 bcc2 = node2->bcc[k];
 7402:       if constexpr(ics == 2) {
 7403:          // Project the velocities from the node frames to the side frame
 7404:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 7405:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 7406:       }
 7407: 
 7408:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 7409:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 7410: 
 7411:    }
 7412: }
 7413: #endif
 7414: 
 7415: 
 7416: extern "C" {
 7417:    __global__ void computeElemAverageGhat(void) {
 7418:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 7419: 
 7420:       ELEM(elem);
 7421:       
 7422:       elem->ghat1= {0.0, 0.0};  
 7423: 
 7424:       if constexpr(ihydraulics != 0) {
 7425:          if (nhtblocks > 0 && elem->isblock) return;
 7426:       }
 7427: 
 7428:       
 7429:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 7430:       // cff1-3: coefficients for 2D/3D
 7431: 
 7432:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7433:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7434:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 7435: 
 7436:       if (elem->isDry) return;
 7437: 
 7438:       // Average of the coefficients
 7439:       double av_cff1 = 0.0;  // av. for cff1
 7440:       double av_cff2 = 0.0;  // av. for cff2
 7441:       double av_cff3 = 0.0;  // av. for cff3
 7442:       double av_df = 0.0;  // av. for H^\alpha / H
 7443:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7444:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7445: 
 7446:       const int i34 = elem->i34;
 7447:       const int kb  = elem->kb;
 7448: 
 7449:       for (int j=0; j<i34; j++) {
 7450:          // For each node and side in the element...
 7451: 
 7452:          const Node *node = elem->nodes[j];
 7453:          const Side *side = elem->sides[j];
 7454: 
 7455:          const double chi      = side->chi;
 7456:          const double veg_c2   = side->veg_c2;
 7457:          const double veg_beta = side->veg_beta;
 7458:          const double veg_h    = side->veg_h();
 7459:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7460: 
 7461:          const Vector2 gradPhi = elem->gradPhi[j];
 7462: 
 7463:          // Node - const in elem
 7464:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 7465:          elem->gradPr  += node->pr  *gradPhi;
 7466: 
 7467:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 7468: 
 7469:         
 7470:          const double htot  = side->htot2();        // Total depth at the side
 7471:          const double zctr2 = side->zTopCanopy();  
 7472: 
 7473:          double cff1; 
 7474:          double cff2; 
 7475:          double cff3;   
 7476:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7477:          // coefficients applied to 2D/3D case 
 7478:             cff1 = side->hhat/htot;
 7479:             cff2 = 0.0;
 7480:             cff3 = 0.0;
 7481:          } else { //3D
 7482:             //Init for no-veg case
 7483:             cff1 = 1.0;
 7484:             cff2 = 1.0;
 7485:             cff3 = 0.0;
 7486: 
 7487:             if constexpr(iveg != 0) {
 7488:                // Computes coefficients used with vegetation terms G1, G2
 7489:                // cff1, cff3 are used for the first two terms in G1, G2:
 7490:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7491:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7492:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7493:                if(veg_h < 0.99*htot) { // submergent vegetation
 7494:                   cff1 = 1.0;
 7495:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7496:                   cff3 = veg_c;
 7497: 
 7498:                } else { // emergent vegetation
 7499:                   cff1 = 1.0/(1.0 + veg_c2);
 7500:                   cff2 = cff1;
 7501:                   cff3 = 0.0;
 7502: 
 7503:                }
 7504:             } // if iveg
 7505:          } //  2D/3D
 7506: 
 7507:          av_cff1 += cff1/i34;
 7508:          av_cff2 += cff2/i34;
 7509:          av_cff3 += cff3/i34;
 7510:          av_cff2_chi += cff2*chi/i34;
 7511:          av_cff3_chi += cff3*chi/i34;
 7512:          av_df += min(htot, veg_h)/(htot*i34);
 7513: 
 7514: 
 7515:          // btrack values: U^\star, U^{\star\alpha}
 7516:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7517:          Vector2 Ustar       = {0.0, 0.0}; 
 7518:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7519: 
 7520:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7521:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7522:          } else { //3D
 7523:             for (int k = side->kb + 1; k < nvrt; k++) {
 7524:             
 7525:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7526:                Ustar += w2;
 7527: 
 7528:                if constexpr(iveg != 0) {
 7529:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7530:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7531:                        Ustar_alpha += zrat*w2; // XXXX
 7532:                    }
 7533:                }  // if iveg
 7534:             }  // for k
 7535:          }  //2D/3D
 7536: 
 7537:          // If needed, project the side velocities to the element frame
 7538:          if constexpr(ics==2) {
 7539:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 7540:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 7541:          }
 7542:         
 7543: 
 7544:          // Add btrack & surface stress terms to \breve{G} first
 7545:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7546: 
 7547: 
 7548:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 7549:          Vector2 tau    = side->tau();  
 7550:          Vector2 ubstar = side->btu[side->kb + 1];  
 7551: 
 7552:          // If needed, project tau and ubstar to the element frame
 7553:          if constexpr(ics==2) {
 7554:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 7555:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 7556:          }
 7557: 
 7558:          // Term for surface and bottom stress
 7559:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7560: 
 7561: 
 7562:          // All terms in F,F^\alpha,f_b except baroclinic
 7563:          // F, f_b: all explicit terms excluding vegetation 
 7564:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7565:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7566:          const double coriolis = side->coriolis;
 7567:          Vector2 F  =  coriolis*side->U;  // F_x
 7568:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7569:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7570: 
 7571:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7572:             
 7573:             for (int k = side->kb; k < nvrt; k++) {
 7574:                if (zctr2 > side->zc[k-1]) {
 7575:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7576:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7577:                    Fa +=  coriolis*w2*zrat;
 7578:                } // if zctr2
 7579:             } // k
 7580:          } // iveg
 7581: 
 7582:          // Integrate horizontal viscosity force vertically
 7583:          for (int k=side->kb + 1; k<nvrt; k++) {
 7584:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7585: 
 7586:             F += levelHorVisc;
 7587: 
 7588:             // Vegetation term
 7589:             if constexpr(iveg!=0) {
 7590:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7591:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7592:                   Fa += levelHorVisc*zrat;
 7593:                } 
 7594:             } // if iveg
 7595:          } // for k
 7596: 
 7597:          // Get nu*grad(U) at the side's bottom level
 7598:          Vector2 nuGradU = side->nuGradU[side->kb];
 7599: 
 7600:          fb += nuGradU;
 7601: 
 7602:          // If needed, project vectorsF, fb and Fa to the element frame
 7603:          if constexpr(ics==2) {
 7604:             F    = side->frame.projHorVec(F,    elem->frame);
 7605:             fb   = side->frame.projHorVec(fb,   elem->frame);
 7606:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 7607:          } // if ics
 7608: 
 7609:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7610:       } // for j (nodes and sides)
 7611: 
 7612:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7613: 
 7614: 
 7615:       // Finish off terms in F, F^\alpha and f_b
 7616:       const double grav3 = elem->mean(&Node::grav2);
 7617:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7618:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7619:       for (int j=0; j<i34; j++) { 
 7620:          // For each side in the element...
 7621:          const Side *side = elem->sides[j];
 7622:          const double chi = side->chi;
 7623: 
 7624:          const double htot = side->htot2();
 7625:          const double veg_h = side->veg_h();
 7626:          const Vector2 F  = htot*fb;
 7627:          const Vector2 Fa = min(htot, veg_h)*fb;
 7628: 
 7629:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7630:       } // for j
 7631: 
 7632:       // tmp is already in elem frame
 7633:       elem->ghat1 += tmp/i34;
 7634: 
 7635:       // Baroclinic force
 7636:       if constexpr(ibc==0) {
 7637:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7638: 
 7639:          Vector2 Fa = {0.0, 0.0};
 7640:          Vector2 intGradRho = {0.0, 0.0};
 7641:          
 7642:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 7643:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 7644:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7645: 
 7646:             // \in F [m^2/s/s]
 7647:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7648:          }
 7649: 
 7650:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7651:          const Vector2 F = av_df*Fa; //approx
 7652:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7653: 
 7654:       } // if ibc
 7655: 
 7656: 
 7657: 
 7658:    }
 7659: 
 7660: } // extern "C"
 7661: 
 7662: 
 7663: 
 7664: #ifdef DONTCOMPILE
 7665: __global__ void checkMassConservation(Tracers* sumtr) {
 7666: 
 7667:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7668: 
 7669:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7670: 
 7671:    Element *elem = &(mesh->localElemData[i]);
 7672: 
 7673:    // Skip dry elements
 7674:    if (elem->isDry) return;
 7675: 
 7676:    // Local sum array for this thread
 7677:    double localSum[N_TRACERS] = {0.0};
 7678: 
 7679:    // Sum over vertical levels for this element
 7680:    const int kbe = elem->kbe;
 7681:    const double area = elem->area;
 7682: 
 7683:    for (int k = kbe; k < nvrt; k++) {
 7684:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7685:       
 7686:       // Accumulate tracer mass
 7687:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7688:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7689:       }
 7690:    }
 7691: 
 7692:    //  This function returns per element sums. A reduction must be done on the host side.
 7693: }
 7694: 
 7695: 
 7696: __global__ void transport(void) {
 7697: 
 7698:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7699: 
 7700:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7701: 
 7702:    Element *elem = &(mesh->localElemData[ie]);
 7703: 
 7704:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7705: 
 7706:                for (int m=0; m<ntr; m++) {
 7707:                   for (int k=kbe(ie); k<nvrt; k++) {
 7708:                      // Calculate each polynomial's weight 
 7709:                      wm=0.d0; sum1=0.d0; 
 7710:                      wm1=0.d0; wm2=0.d0; 
 7711:                      for (int i=0; i<elem->nweno2; i++) {
 7712:                   
 7713:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7714:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7715:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7716:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7717:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7718:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7719:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7720:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7721:                      // -----------------Hu and Shu (1999)'s method----------------
 7722:                      b4=b1+b2+b3
 7723: 
 7724: //Error: add PRODUCTION CPP
 7725: #ifdef DEBUG
 7726:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7727:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7728:                     call parallel_abort(errmsg)
 7729:                   }
 7730: #endif
 7731: 
 7732:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7733:                   // !----test-------------- 
 7734:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7735:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7736:                   // !wm(i)=wm1(i)*wm2(i)
 7737:                   // !---------------------- 
 7738:                   sum1=sum1+wm(i)
 7739:                 } // end for i
 7740: 
 7741:                 wm=wm/sum1
 7742: 
 7743:                 for (int j=0; j<elem->i34; j++) {
 7744: 
 7745:                   const Side *side  = elem->sides[j];
 7746:                   const Node *node1 = side->n1;
 7747:                   const Node *node2 = side->n2;
 7748: 
 7749:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7750:                      trsd=0.d0
 7751:                      for (int kk=0; kk<nquad; kk++) {
 7752:                         for (int i=0; i<elem->nweno2; i++) {
 7753:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7754:                         } // end for i   
 7755:                      } // end for kk
 7756:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7757:                   } // outward flux
 7758:                } // end for j=1,i34(ie) ! side
 7759:             }
 7760:          }
 7761:               
 7762: 
 7763: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7764: //             //   calculate each polynomial's weight 
 7765: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7766: //                 wm=0.d0; sum1=0.d0
 7767: //                 do i=1,nweno1(ie) !for each polynomial
 7768: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7769: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7770: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7771: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7772: //                   wm(i)=b2
 7773: //                   sum1=sum1+b2
 7774: //                   !wm(i)=1.d0
