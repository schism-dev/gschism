 2593: 
 2594: __device__ void findNextPoint(BTPoint &curPoint, double dtbk);
 2595: __device__ void DEAL_WITH_POINT_INTERSECTING_SIDE(BTPoint &curPoint, Point3 &xt, const Side *excludeSide1, const Side *excludeSide2); 
 2596: __device__ void DEAL_WITH_POINT_INTERSECTING_SIDE2(BTPoint &curPoint, Point3 &xt, const Side *excludeSide1, const Side *excludeSide2); 
 2597: __device__ void DEAL_WITH_POINT_MOVING_OUTSIDE_SIDE(BTPoint &curPoint, Point3 &xt);
 2598: __device__ void DEAL_WITH_POINT_MOVING_ALONG_SIDE(BTPoint &curPoint, Point3 &xt);
 2599: __device__ void DEAL_WITH_POINT_MOVING_OUTSIDE_NODE(BTPoint &curPoint, Point3 &xt);
 2600: 
 2601: 
 2602: 
 2603: 
 2604: /**
 2605:  * This function performs backtracking from startPoint until a time -dt back in time from the current time. 
 2606:  * The backtracking is performed using the velocities (u,v,w) at each intermediate point (except at open and land boundaries)
 2607:  *
 2608:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2609:  * a maximum length of dtbk*vel_step, where vel_step is the module of the velocity at that step and dtbk is 
 2610:  * the timestep (of the backtracking). The actual length of the segment can be shorter if the backtracking intersects a side or a node.
 2611:  * 
 2612:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2613:  * 
 2614:  * @param startPoint: Starting point of the backtracking
 2615:  * @param klev: Level at which the backtracking is performed
 2616:  * @param dt: Tracking time
 2617:  * @param dtbk: Tracking timestep
 2618:  
 2619:  */
 2620:  __inline__ __device__ void backtrackFromPoint(BTPoint &bkPoint, double dt, double dtbk) {
 2621: 
 2622:    const int MAX_ITERATIONS = 1000; 
 2623: 
 2624:    double remainingTime = dt; 
 2625: 
 2626:    int iter = 0;
 2627: 
 2628:    while (remainingTime > 0.0) {
 2629:     
 2630:       
 2631:       iter++;
 2632: 
 2633:       // If the velocity is too small, we stop the backtracking
 2634:       if (length(bkPoint.u) <= velmin_btrack) break;
 2635:       
 2636:       assert(iter < MAX_ITERATIONS && "Max iterations reached in backtrackFromPoint");
 2637: 
 2638: 
 2639:       // Finds the next point in the backtracking curve. updates bkPoint.
 2640:       findNextPoint(bkPoint, min(dtbk, remainingTime));
 2641: 
 2642: 
 2643: 
 2644:       remainingTime -= bkPoint.dt;
 2645:    } 
 2646: 
 2647: }
 2648: 
 2649: /**
 2650:  * Finds the next point in the backtracking curve from the current point.
 2651:  * 
 2652:  * @param curPoint      Current backtracking point (input/output - will be updated to next point)
 2653:  * @param dtbk          Maximum timestep for this segment
 2654:  * 
 2655:  * The function handles three cases based on curPoint.type:
 2656:  * - btElement: Point is in element interior
 2657:  * - btSide: Point is on a side
 2658:  * - btNode: Point is at a node
 2659:  * 
 2660:  * The actual timestep may be less than dtbk if an intersection is found.
 2661:  *
 2662:  * For this algorithms, the interior of an element is defined as the 'skinny' element whose shape coordinates are larger than small. A point that is not in the interior
 2663:  * of an element is either outside the mesh, or on a side or node.
 2664:  */
 2665:  __device__ void findNextPoint(BTPoint &curPoint, double dtbk) {
 2666: 
 2667:    const Point3 x0 = curPoint.x;
 2668:    const Vector3 u = curPoint.u;
 2669: 
 2670: DEBUG_INFO();
 2671:    
 2672:    // Calculate target point (backward in time)
 2673:    Point3 xt = x0 - dtbk*u;
 2674: // printf("ZZZZ curPoint.side = %p, curPoint.elem = %p, curPoint.node = %p, curPoint.type = %d\n", curPoint.side, curPoint.elem, curPoint.node, curPoint.type);
 2675:    // The current point always 'belongs' to an element (even if it is a node or a side, in which case it is one of the elements sharing the node or the side).
 2676:    // This element is used to interpolate the velocity.
 2677:    const Element *elem = curPoint.elem;  
 2678:    assert(elem != nullptr && "elem is nullptr in findNextPoint");
 2679: 
 2680:    curPoint.dt = dtbk;
 2681: 
 2682: // printf("BBBBB curPoint.type = %d, elem->idx = %d\n", curPoint.type, elem->idx);   
 2683:  
 2684:    // How the next point is found depends on the type of the current point:
 2685:    switch (curPoint.type) {
 2686:       
 2687:       case BTPoint::BTPointType::btElement: {  // Starting from element interior...
 2688: DEBUG_INFO();
 2689: 
 2690:          // When starting from the interior of an element, the next point is either in the interior of the same element, or it will intersect a side or a node.
 2691: // printf("4 elem = %p\n", elem);      
 2692: ShapeCoords shpCoord;   
 2693: elem->computeShapeCoords(toVector2(xt), shpCoord); // XXXX
 2694: DEBUG_INFO();
 2695:          // If the target point is still inside the 'skinny' element, the next point is in the element interior
 2696:          if (elem->containsPoint2(toPoint2(xt))) {
 2697:             // Still inside element -> next point is in element interior
 2698:             // In this case, the next point is in the interior of the same element.
 2699:             curPoint.x = xt;
 2700:             curPoint.dt = dtbk;
 2701:             // The rest of fields of curPoint do not change in this case (except for u, which is computed at the end)
 2702:             addDebugPlot(x0, xt, 0xDF401F, '+');            
 2703: 
 2704:          } else {
 2705:             // Target point is outside -> An intersection with element boundary is *guaranteed*.
 2706:             // In this case, the next point is on a side or a node.
 2707: // printf("AAxxA3\n");            
 2708:             DEAL_WITH_POINT_INTERSECTING_SIDE2(curPoint, xt, nullptr, nullptr);
 2709: // printf("AAxxA4  elem->idx = %d\n", curPoint.elem->idx);            
 2710:             addDebugPlot(x0, xt, 0x1FF01F, 'o');            
 2711:  
 2712:          }
 2713: DEBUG_INFO();
 2714: 
 2715:       }
 2716: 
 2717:       break;
 2718:       
 2719: 
 2720:       case BTPoint::BTPointType::btSide: {  // Starting from a side...
 2721:       
 2722: DEBUG_INFO();
 2723:          // In this case there are four main possibilities:
 2724:          // - xt is in the interior of one of the elements sharing the side.
 2725:          // - x0xt intersects the sides of one of the elements sharing the side (not including the shared side).
 2726:          // - x0xt is collinear with the shared side.
 2727:          // - xt is outside the mesh.
 2728: 
 2729:          const Side *side = curPoint.side;
 2730: 
 2731:          assert(!(side->isDry) && "Side is dry");
 2732: 
 2733:          Element *e1 = side->elems[0];
 2734:          Element *e2 = side->elems[1];
 2735: 
 2736:          assert((e1 != nullptr && !e1->isDry) || (e2 != nullptr && !e2->isDry) && "Side has no wet elements");
 2737: 
 2738:          // e2 can be nullptr if the side is a boundary side.
 2739:          const bool isInsideE1 =  e1 != nullptr && !e1->isDry && e1->containsPoint2(toPoint2(xt));
 2740:          const bool isInsideE2 = (e2 != nullptr && !e2->isDry && !isInsideE1) ? e2->containsPoint2(toPoint2(xt)) : false;
 2741:               
 2742: DEBUG_INFO();   
 2743: 
 2744:          // Check if it is inside one of the elements
 2745:          if (isInsideE1 || isInsideE2) {
 2746:             // If it is inside one of the elements, the next point is in the interior of an element.
 2747:             
 2748:             Element *nextElem = isInsideE1?e1:e2;
 2749: DEBUG_INFO();
 2750:             assert(!(nextElem->isDry) && "Element is dry"); // XXXX 
 2751:             // The new current point will be the target point
 2752:             curPoint.x = xt;
 2753:             curPoint.type = BTPoint::BTPointType::btElement;
 2754:             curPoint.elem = nextElem;
 2755: assert(nextElem!=nullptr && !nextElem->isDry && "EEEE3");
 2756:             curPoint.side = nullptr;
 2757:             curPoint.node = nullptr;
 2758:             curPoint.t = 0.0; 
 2759:             curPoint.dt = dtbk;
 2760: DEBUG_INFO();            
 2761: 
 2762:          } else {  // Point xt is not inside one of the elements sharing the side...
 2763: DEBUG_INFO(); 
 2764:             // The element is either along the current side or intersects the sides of one of the elements sharing the side.
 2765: 
 2766:             // Checks if x0xt is collinear with the side in a consistent way.
 2767:             const double lenSide = side->len;
 2768:             const Vector2 v2 = toPoint2(xt) - toPoint2(x0);
 2769:             const double lenX0Xt = length(v2);
 2770:             bool isAlongSide = false;
 2771: DEBUG_INFO();
 2772:             if (lenSide > lenX0Xt) { // if x0xt is shorter than the side...
 2773: DEBUG_INFO();
 2774:                isAlongSide = side->containsPoint(toPoint2(xt));
 2775:             }
 2776:             else { // if x0xt is longer than the side...
 2777: DEBUG_INFO();
 2778:                // Computes a smaller collinear segment that starts at x0 and has length lenSide. The end point of this segment must be on the side.
 2779:                const Point2 xtmp = toPoint2(x0) + v2*lenSide/lenX0Xt;
 2780:                isAlongSide = side->containsPoint(xtmp);
 2781: DEBUG_INFO();
 2782: 
 2783:             }
 2784: DEBUG_INFO(); 
 2785:             if (isAlongSide) {
 2786:                // x0xt is contained in the same side x0 is on.
 2787:                DEAL_WITH_POINT_MOVING_ALONG_SIDE(curPoint, xt);
 2788: 
 2789: addDebugPlot(x0, curPoint.x, 0x1FF01F, '+');
 2790:             } else {
 2791: 
 2792:                // Gets the element that is in the direction opposite to the velocity vector (remember that we are backtracking)
 2793:                Element *nextElem = side->findElementTowards(toVector2(u));
 2794:              
 2795:                
 2796: 
 2797:                if (nextElem == nullptr || nextElem->isDry) {
 2798:                   // The segment goes out of water.
 2799:                   DEAL_WITH_POINT_MOVING_OUTSIDE_SIDE(curPoint, xt);
 2800:                   
 2801:                } else {
 2802:                   // x0xt intersects another side of the element.
 2803:                   
 2804:                   curPoint.elem = nextElem;
 2805:                   assert(curPoint.elem != nullptr && "curPoint.elem is nullptr in DEAL_WITH_POINT_INTERSECTING_SIDE");
 2806: 
 2807:                   // This is a situation we know how to handle. 
 2808:                   printf("DDD2, nextElem = %p, nextElem->isDry = %d\n", nextElem, nextElem->isDry);                              
 2809:                   DEAL_WITH_POINT_INTERSECTING_SIDE(curPoint, xt, side, nullptr);
 2810:                   printf("DDD3\n");
 2811:                }
 2812: 
 2813:             }
 2814:          
 2815:          }
 2816: 
 2817:       }
 2818: DEBUG_INFO();
 2819: addDebugPlot(x0, xt, 0x4FD01F, '+');        
 2820: DEBUG_INFO();
 2821:       break;
 2822:       
 2823:       case BTPoint::BTPointType::btNode: {  // Starting from a node...
 2824: DEBUG_INFO();
 2825:          const Node *node = curPoint.node;
 2826: 
 2827:          printf("btNode, node = %p\n", node);         
 2828:          
 2829:          // Check if the xt is inside one of the elements sharing the node
 2830:          for (int i = 0; i < node->numElements; i++) {
 2831:             Element *e = node->elements[i];
 2832: 
 2833:             
 2834:             if (e->containsSegment(node, toPoint2(xt))) {
 2835:                // This means that x0xt is contained in the element (in the sense that the wedge formed by the node and its adjacent sides includes the segment x0xt). 
 2836:                // This is in a 'fat' sense, meaning that it covers the cases where x0xt is actually along one of these sides.
 2837: 
 2838:                
 2839:                if (e->isDry) {
 2840: printf("AAA1, curPoint.elem = %p, e = %p, curPoint.elem->isDry = %d\n", curPoint.elem, e, curPoint.elem->isDry);                  
 2841:                   DEAL_WITH_POINT_MOVING_OUTSIDE_NODE(curPoint, xt);
 2842:                   return;
 2843: 
 2844:                }
 2845: 
 2846:                if (e->containsPoint2(toPoint2(xt))) {
 2847:                   // xt is contained in the element
 2848:                   curPoint.x = xt;
 2849:                   curPoint.dt = dtbk;
 2850:                   curPoint.type = BTPoint::BTPointType::btElement;
 2851:                   curPoint.elem = e;
 2852: assert(e !=nullptr && !e->isDry && "EEEE1");                  
 2853:                   curPoint.side = nullptr;
 2854:                   curPoint.node = nullptr;
 2855:                   return;
 2856: 
 2857:                } else {
 2858:                   // xt must intersect one of the opposite sides of the element
 2859:                   int idxSide1, idxSide2;
 2860:                   e->getSidesContainingNode(node, idxSide1, idxSide2);
 2861:                   const Side *side1 = e->sides[idxSide1];
 2862:                   const Side *side2 = e->sides[idxSide2];
 2863:                   curPoint.elem = e;
 2864: assert(e !=nullptr && !e->isDry && "EEEE2");
 2865:                   printf("DDD3a\n");                              
 2866:                   DEAL_WITH_POINT_INTERSECTING_SIDE(curPoint, xt, side1, side2);
 2867:                   printf("DDD3b\n");                              
 2868:                   return;
 2869:                }
 2870:                   
 2871:             } 
 2872:             
 2873: 
 2874:          } 
 2875: printf("AAA2aaaa\n");         
 2876: if (curPoint.node != nullptr) printf("AAA2 curPoint.node.idx = %d, node.p = %.17f, %.17f\n", curPoint.node->idx, curPoint.node->p.x, curPoint.node->p.y);                  
 2877: else printf("AAA2 curPoint.node = nullptr\n");                  
 2878:          // computes the maximal contiguous block of wet elements containing curPoint.elem.
 2879:          DEAL_WITH_POINT_MOVING_OUTSIDE_NODE(curPoint, xt);    
 2880: DEBUG_INFO();         
 2881:       }
 2882: 
 2883:    } // switch
 2884: DEBUG_INFO();
 2885: // if (curPoint.elem == 0) curPoint.elem = curPoint.side->elems[0];
 2886: // if (curPoint.side != nullptr && curPoint.side->idx == 5) printf("6 curPoint.type = %d, curPoint.elem = %p\n", curPoint.type, curPoint.elem);
 2887: if (curPoint.elem->idx == 16191) printf("6 curPoint.elem = %p, type = %d, dtbk = %.17f, curPoint.elem = %p, curPoint.side = %p\n", curPoint.elem, curPoint.type, curPoint.dt, curPoint.elem, curPoint.side);
 2888: if (curPoint.elem == nullptr) printf("XXXXXXXXXXXXX curPoint.side = %p\n", curPoint.side);
 2889:    // Interpolates the velocities at the next point
 2890:    assert(curPoint.elem != nullptr && "curPoint.elem is nullptr");
 2891:    curPoint.elem->interpolateVelocities(curPoint.x, curPoint.u);
 2892: if (curPoint.elem->idx == 16191) printf("6222 curPoint.elem = %p, type = %d\n", curPoint.elem, curPoint.type);
 2893: DEBUG_INFO();
 2894: }
 2895: 
 2896: __device__ void DEAL_WITH_POINT_INTERSECTING_SIDE(BTPoint &curPoint, Point3 &xt, const Side *excludeSide1, const Side *excludeSide2) {
 2897:    // This function deals with the case where the segment x0xt intersects a side of the element that is not one of the two sides to exclude.
 2898: // if (it>=115) printf("ZZZZZ1 curPoint.type = %d, curPoint.elem.idx = %d, curPoint.side = %p\n", curPoint.type, curPoint.elem->idx, curPoint.side);
 2899: Element *oldelem = curPoint.elem;
 2900:    Side *intersectSide = nullptr;
 2901:    Element *nextElem = nullptr;
 2902:    double t, tIntersect;
 2903: 
 2904:    const Point2 x1 = toPoint2(curPoint.x);
 2905:    const Point2 x2 = toPoint2(xt);
 2906:    const Element *elem = curPoint.elem;
 2907: 
 2908:    assert(elem != nullptr && "elem is nullptr in DEAL_WITH_POINT_INTERSECTING_SIDE");
 2909: 
 2910:    // assert( elem->containsPoint2(x1) && "Starting point is not inside the element");                                    
 2911:    assert(!elem->containsPoint2(x2) && "Ending point is not outside the element");
 2912: 
 2913:    double closest_intersect_t = 1e10;
 2914:    bool found_intersection = false;
 2915:    double tt1, tt2, last_tt2 = 77777777.0; // XXXXXX
 2916:    for (int i = 0; i < elem->i34; i++) {
 2917: 
 2918:       Side *side = elem->sides[i];
 2919: 
 2920: assert(side != nullptr && "side is nullptr in DEAL_WITH_POINT_INTERSECTING_SIDE");
 2921: 
 2922:       if (excludeSide1 == side || excludeSide2 == side) continue;
 2923: 
 2924:       // (x3,y3)-(x4,y4) is the element side line
 2925:       const Point2 x3 = side->n1->p;
 2926:       const Point2 x4 = side->n2->p;
 2927: 
 2928:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 2929:       const double delta = cross(x2 - x1, x3 - x4);
 2930: 
 2931:       if (abs(delta) > 0) {
 2932: 
 2933:          const double delta1 = cross(x3 - x1, x3 - x4);
 2934:          const double delta2 = cross(x2 - x1, x3 - x1); 
 2935: 
 2936:          // Solves the two linear equations for tt1 and tt2
 2937:          tt1 = delta1/delta; // delta is not zero, so we can divide
 2938:          tt2 = delta2/delta;
 2939: 
 2940:          // Computes a distance to interval [0,1]
 2941:          const double distTo01 = max3(0.0, -tt1, tt1 - 1.0);
 2942: 
 2943:          if (closest_intersect_t > distTo01) {
 2944:             intersectSide = side;
 2945:             closest_intersect_t = distTo01;
 2946:             nextElem = side->otherElem(elem);
 2947:             found_intersection = true;
 2948:             last_tt2 = tt2;
 2949:          }
 2950: 
 2951:       }
 2952: 
 2953:    } // for
 2954: printf("ZZZZZ3 found_intersection = %d, closest_intersect_t = %.16f, last_tt2 = %.16f, elem->idx = %d, curPoint.x = %.16f, %.16f\n", found_intersection, closest_intersect_t, last_tt2, elem->idx, curPoint.x.x, curPoint.x.y);
 2955:    assert(found_intersection && "No intersection found in DEAL_WITH_POINT_INTERSECTING_SIDE");
 2956:    assert(intersectSide != nullptr && "intersectSide is nullptr in DEAL_WITH_POINT_INTERSECTING_SIDE");
 2957:    
 2958: 
 2959: 
 2960:    // if (nextElem == nullptr) printf("LLLL intersectSide->elems[0]->isDry = %d\n", intersectSide->elems[0]->isDry);
 2961: 
 2962:    // if (nextElem == nullptr && intersectSide->elems[1] != nullptr) printf("LLLL intersectSide->elems[1]->isDry = %d\n", intersectSide->elems[1]->isDry);
 2963:    if (nextElem == nullptr) nextElem = intersectSide->elems[0];  // elems[0] is never nullptr. This is done in case the element is not set yet.
 2964:    assert(nextElem != nullptr && "nextElem is nullptr in DEAL_WITH_POINT_INTERSECTING_SIDE");
 2965: 
 2966:    
 2967:    if (last_tt2 < geometricEpsilon) {
 2968:       curPoint.type = BTPoint::BTPointType::btNode;
 2969:       curPoint.node = intersectSide->n1;
 2970:       curPoint.side = intersectSide;
 2971:       curPoint.t = 0.0; 
 2972: 
 2973:    }
 2974:    else if (last_tt2 > 1.0 - geometricEpsilon) {
 2975:       curPoint.type = BTPoint::BTPointType::btNode;
 2976:       curPoint.node = intersectSide->n2;
 2977:       curPoint.side = intersectSide;
 2978:       curPoint.t = 1.0; 
 2979:       
 2980:    }
 2981:    else {
 2982:       curPoint.type = BTPoint::BTPointType::btSide;
 2983:       curPoint.side = intersectSide;
 2984:       curPoint.node = nullptr;
 2985:       curPoint.t = last_tt2;
 2986:    }
 2987: 
 2988:    curPoint.elem = nextElem;
 2989:    curPoint.dt = curPoint.dt*closest_intersect_t;
 2990:    toPoint2(curPoint.x) = intersectSide->p_t(curPoint.t);
 2991:    curPoint.x.z = (1.0 - closest_intersect_t)*curPoint.x.z + closest_intersect_t*xt.z;
 2992: if (it>=115) printf("ZZZZZ2 curPoint.type = %d, oldelem.idx = %d, newelem.idx = %d, IDX(curPoint.side) = %d IDX(curPoint.side->n1) = %d IDX(curPoint.side->n2) = %d\n", curPoint.type, oldelem->idx, nextElem->idx, curPoint.side->idx, curPoint.side->n1->idx, curPoint.side->n2->idx);
 2993: 
 2994: }
