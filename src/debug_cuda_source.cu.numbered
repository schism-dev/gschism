 1880: 
 1881: __inline__ __device__ Point2 Element::outputCoords(void) const {
 1882:    if constexpr(ics == 1)  {
 1883:       return center;
 1884: 
 1885:    } else {
 1886:       const Point2 p0 = nodes[0]->outputCoords();
 1887:       const Point2 p1 = nodes[1]->outputCoords();
 1888:       const Point2 p2 = nodes[2]->outputCoords();
 1889: 
 1890:       if (isTri()) {
 1891:          return (1.0/3.0)*(p0 + p1 + p2);
 1892: 
 1893:       } else {
 1894:          const Point2 p3 = nodes[3]->outputCoords();
 1895:          return (1.0/4.0)*(p0 + p1 + p2 + p3);
 1896:       }
 1897: 
 1898:    }
 1899: }
 1900: 
 1901: __device__ __forceinline__ double Element::centerZ(void) const { 
 1902: // Z coordinate of the element center in the global cartesian coordinates.
 1903: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 1904: 
 1905:    if constexpr(ics==1) { 
 1906:       return 0.0; 
 1907:    } else { 
 1908:       if (isTri()) {
 1909:          return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz); 
 1910:       } else {
 1911:          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz); 
 1912:       }
 1913: 
 1914:    } 
 1915: }
