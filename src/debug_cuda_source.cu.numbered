 1710: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000) {
 1711:    return;
 1712:    // Lock the mutex
 1713:    lock(&debugPlotMutex);
 1714:  
 1715:    bool ok = true;
 1716:    if (debugPlotIdx == nullptr) ok = false;
 1717:    if (*debugPlotIdx >= 10000) ok = false;
 1718:    if (ok) {
 1719:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1720:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1721:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1722:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1723:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1724:       (*debugPlotIdx)++;
 1725:    }
 1726: 
 1727:    __threadfence();               // ensure all above writes are visible
 1728:    // Unlock the mutex
 1729:    unlock(&debugPlotMutex);
 1730: 
 1731: }
