 4495: //       // Now l1 and l2 are adjacent levels and zt is between them
 4496: 
 4497: //       assert(za[l2] - za[l1] > 0.0 && "vertLinearInterp: za[l2] - za[l1] <= 0");
 4498: 
 4499: //       const double zrat = (zt - za[l1])/(za[l2] - za[l1]);
 4500: //       s_out = s_in[l1]*(1.0 - zrat) + s_in[l2]*zrat;
 4501: //    }
