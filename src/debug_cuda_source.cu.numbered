 2131: 
 2132: 
 2133: /**
 2134:    Compute the shape coordinates of the point (xt,yt) in the element.
 2135:    @param xt (input): x-coordinate of the point
 2136:    @param shpCoords (output): shape coordinates of the point
 2137:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2138:    @return true if the point is inside the element, false otherwise
 2139: **/
 2140: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2141:                                             bool fixNegshpCoord) const {
 2142: 
 2143:    // Compute the shape coordinates of the point xt in the element.
 2144:    if (i34==3) {
 2145:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2146:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2147:       // and in this case, the pt will be nudged into the element
 2148:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2149:       // from the local frame, so use additional check.
 2150: 
 2151:       Point2 x0, x1, x2;
 2152: 
 2153:       if constexpr(ics==1) {
 2154:          x0 = nodes[0]->p2();
 2155:          x1 = nodes[1]->p2();
 2156:          x2 = nodes[2]->p2();
 2157:       }
 2158:       else // lat/lon
 2159:       {
 2160:          Error("Not implemented yet");
 2161: #ifdef ICS2
 2162:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2163:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2164:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2165: #endif
 2166:       }
 2167: 
 2168:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2169:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2170:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2171:       shpCoords[3] = 0.0;
 2172:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2173: 
 2174:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2175:       // then we fix the negative shape coordinates.
 2176:       if (fixNegshpCoord && tmpmin<=0.0) {
 2177: 
 2178:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2179:          // keeping the sum of the shape coordinates equal to 1.
 2180:          // I have tested and compared the new algorithm with the old one, and they give
 2181:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2182:          // The new algorithm should be faster since it is branchless.
 2183:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2184:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2185:          
 2186:          shpCoords[0] = (shpCoords[0] + a)*b;
 2187:          shpCoords[1] = (shpCoords[1] + a)*b;
 2188:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2189: 
 2190:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2191:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2192:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2193:          }
 2194: 
 2195:          // Update the point coordinates for the new shape coordinates
 2196:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2197:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2198:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2199: 
 2200:       }
 2201: 
 2202:       // Check if the point is inside the element
 2203:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2204:    }
 2205:    else {
 2206:       Error("Not implemented yet");
 2207: #ifdef QUADS
 2208:       // Reproject pt in eframe of nel for ics=2
 2209:       if constexpr(ics==1) {
 2210:          xn2 = xt; 
 2211:          yn2 = yt;
 2212:       }
 2213:       else {
 2214:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2215:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2216:       }
 2217: 
 2218:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2219: #endif
 2220:    }
 2221: 
 2222:    return false;  // Never reached
 2223: 
 2224: }
 2225: 
 2226: 
 2227: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2228: // Convert shape coordinates to cartesian coordinates
 2229: 
 2230:    if (i34 == 3) {
 2231:       // Triangular element
 2232:       double xcoords[3] = {nodes[0]->p2().x, nodes[1]->p2().x, nodes[2]->p2().x};
 2233:       double ycoords[3] = {nodes[0]->p2().y, nodes[1]->p2().y, nodes[2]->p2().y};
 2234:    }
 2235:    else {
 2236:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2237:    }
 2238: 
 2239: }
 2240: 
 2241: 
 2242: /**  Interpolate velocities at a given point (xt,yt,zt)
 2243: 
 2244:    @param xt, yt, zt: coordinates of the point to interpolate
 2245:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2246: 
 2247:    This is done in four steps:
 2248: 
 2249:    1. Find the shape coordinates for the final position in the element.
 2250:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2251:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2252:       z levels at xt, yt at each step.   
 2253:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2254:       horizontally and vertically.
 2255: **/
 2256: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2257:    // Interpolate the velocities at the point xt. 
 2258:    // This function works the same for triangular and quadrilateral elements.
 2259:    double shpCoord[4];
 2260: 
 2261: printf(" ___BBB02____ idx = %d, u_int = %.17g,%.17g,%.17g, u1 = %.17g,%.17g,%.17g, u2 = %.17g,%.17g,%.17g, u3 = %.17g,%.17g,%.17g\n", idx, u_int.x, u_int.y, u_int.z, nodes[0]->u2[0].x, nodes[0]->u2[0].y, nodes[0]->u2[0].z, nodes[1]->u2[0].x, nodes[1]->u2[0].y, nodes[1]->u2[0].z, nodes[2]->u2[0].x, nodes[2]->u2[0].y, nodes[2]->u2[0].z);         
 2262:    // First step is to compute the shape coordinates of (xt,yt)
 2263:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2264:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2265: 
 2266:    // Second step is to find the level that contains zt
 2267:    // Uses a binary search to find the level
 2268:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2269:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2270:    int R = nvrt - 1;
 2271: 
 2272:    // Get the z coordinates at the nodes of the element at the levels L and R
 2273:    double zLAtNodes[4], zRAtNodes[4];
 2274:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2275:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2276: 
 2277:    double zL = interpolate(shpCoord, zLAtNodes);
 2278:    double zR = interpolate(shpCoord, zRAtNodes);
 2279:    
 2280:    // Interpolates vertically the velocities
 2281:    double wght1, wght2;
 2282:    if (xt.z<=zL) {
 2283:       wght1 = 1.0;
 2284:       wght2 = 0.0;
 2285:    }
 2286:    else if (xt.z>=zR) {
 2287:       wght1 = 0.0;
 2288:       wght2 = 1.0;
 2289:    }
 2290:    else {
 2291:       // Perform a binary search to find the levels between L and R that contain xt.z
 2292:       while (R - L > 1) {
 2293:          int M = (L + R) / 2;
 2294: 
 2295:          double zMAtNodes[4];
 2296:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2297:          double zM = interpolate(shpCoord, zMAtNodes);
 2298:          if (zM < xt.z) 
 2299:          {
 2300:             L = M;
 2301:             zL = zM;
 2302:          }
 2303:          else 
 2304:          {
 2305:             R = M;
 2306:             zR = zM;
 2307:          }
 2308:       }
 2309:       assert(L == R-1);
 2310:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2311: 
 2312:       wght2 = (xt.z - zL)/(zR - zL);
 2313:       wght1 = 1.0 - wght2;
 2314:    }
 2315: 
 2316:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2317:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 2318: 
 2319: if (idx==2) {
 2320: Vector3 u1 = wght1*interpolate(L, shpCoord, &Node::u2);
 2321: Vector3 u2 = wght2*interpolate(R, shpCoord, &Node::u2);
 2322: printf("L = %d, R = %d, Element = %d\n", L, R, idx);
 2323: printf("shpCoord = %.17g,%.17g,%.17g,%.17g\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 2324: // printf("node1 (%.17g,%.17g), node2 (%.17g,%.17g,%), node3 (%.17g,%.17g)\n", nodes[0]->p2().x, nodes[0]->p2().y, nodes[1]->p2().x, nodes[1]->p2().y, nodes[2]->p2().x, nodes[2]->p2().y);
 2325: printf("element = %d, idx = %d, u_n1 = %.17g,%.17g,%.17g\n", idx, nodes[0]->idx, nodes[0]->u2[L].x, nodes[0]->u2[L].y, nodes[0]->u2[L].z);
 2326: printf("element = %d, idx = %d, u_n2 = %.17g,%.17g,%.17g\n", idx, nodes[1]->idx, nodes[1]->u2[L].x, nodes[1]->u2[L].y, nodes[1]->u2[L].z);
 2327: printf("element = %d, idx = %d, u_n3 = %.17g,%.17g,%.17g\n", idx, nodes[2]->idx, nodes[2]->u2[L].x, nodes[2]->u2[L].y, nodes[2]->u2[L].z);
 2328: printf("element = %d, idx = %d, u_n1 = %.17g,%.17g,%.17g\n", idx, nodes[0]->idx, nodes[0]->u2[R].x, nodes[0]->u2[R].y, nodes[0]->u2[R].z);
 2329: printf("element = %d, idx = %d, u_n2 = %.17g,%.17g,%.17g\n", idx, nodes[1]->idx, nodes[1]->u2[R].x, nodes[1]->u2[R].y, nodes[1]->u2[R].z);
 2330: printf("element = %d, idx = %d, u_n3 = %.17g,%.17g,%.17g\n", idx, nodes[2]->idx, nodes[2]->u2[R].x, nodes[2]->u2[R].y, nodes[2]->u2[R].z);
 2331: printf("element = %d, idx = %d, u_int = %.17g,%.17g,%.17g\n", idx, u_int.x, u_int.y, u_int.z);   
 2332: printf("u1 = %.17g,%.17g,%.17g\n", u1.x, u1.y, u1.z);   
 2333: printf("u2 = %.17g,%.17g,%.17g\n", u2.x, u2.y, u2.z);   
 2334: if(!(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z))) {u_int = {0.0, 0.0, 0.0}; return;}
 2335: }
 2336: 
 2337:    // Neither of the interpolated velocities should be NaN
 2338:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2339: 
 2340: }
 2341: 
 2342: 
 2343: 
 2344: 
 2345: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2346: 
 2347:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2348:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2349:    const Node *n1 = side->n1;
 2350:    const Node *n2 = side->n2;
 2351: 
 2352:    bool n1_match = (n1->nodeBnd->segment == segment);
 2353:    bool n2_match = (n2->nodeBnd->segment == segment);
 2354: 
 2355:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2356:    if (n1_match && n2_match) {
 2357:       return 0.5;
 2358:    } else if (n1_match) {
 2359:       return 1.0;
 2360:    } else if (n2_match) {
 2361:       return 0.0;
 2362:    }
 2363:    return 0.0;
 2364: }
 2365: 
 2366: 
 2367: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2368: 
 2369:    const double w1 = getBoundaryArrayValueWeight();
 2370:    const double w2 = 1.0 - w1;
 2371:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2372:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2373: 
 2374:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2375: }
 2376: 
 2377: 
 2378: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2379:    const double w1 = getBoundaryArrayValueWeight();
 2380:    const double w2 = 1.0 - w1;
 2381:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2382:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2383: 
 2384:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2385: }
 2386: 
 2387: 
 2388: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2389:    // Returns the value of the velocity at the side center
 2390:    const double w1 = getBoundaryArrayValueWeight();
 2391:    const double w2 = 1.0 - w1;
 2392:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2393:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2394: 
 2395:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2396: }
 2397: 
 2398: 
 2399: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2400:    // Returns the value of the normal component of the velocity at the side center
 2401:    const double w1 = getBoundaryArrayValueWeight();
 2402:    const double w2 = 1.0 - w1;
 2403:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2404:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2405: 
 2406:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2407: }
