  447: // Polynomial class
  448: template<int grade>
  449: struct Polynomial {
  450:     // Static assertion to give a clear error message at compile time
  451:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  452: };
  453: 
  454: 
  455: // Explicit specialization for grade 4
  456: template<>
  457: struct Polynomial<4> {
  458:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  459: 
  460:    // Constructor from coefficients
  461:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  462: 
  463:    __device__ __forceinline__ double eval(double x) const {
  464:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  465:    }
  466: };
