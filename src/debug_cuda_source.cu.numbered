 2143: __device__ __inline__ double min3(double a, double b, double c) {
 2144:    return min(a, min(b, c));
 2145: }
 2146: 
 2147: __device__ __inline__ double max3(double a, double b, double c) {
 2148:    return max(a, max(b, c));
 2149: }
 2150: 
 2151: __device__ __inline__ double min4(double a, double b, double c, double d) {
 2152:    return min(a, min(b, min(c, d)));
 2153: }
