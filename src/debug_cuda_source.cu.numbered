 4538:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4539: 
 4540:       NODE_BND(nodeBnd);
 4541: 
 4542:       Node *node = nodeBnd->node;
 4543: 
 4544:       node->ETP = 0.0;
 4545: 
 4546:       for (int j=0; j<ntip; j++) {
 4547: 
 4548:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4549:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4550:    
 4551:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4552: 
 4553:          if constexpr(iloadtide==1) { // loading tide
 4554:             assert(false && "Loading tide not implemented");
 4555:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4556:          }
 4557:          
 4558:       }
 4559:       
 4560:    }
