 1373: // Helper functions for computing the local node index at a given offset from another.
 1374: __device__ __inline__ int nxq(int offset, int index, int size) {
 1375:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1376:    // to the index to make it positive
 1377:    assert(index + offset + 16*size >= 0);
 1378:    return (index + offset + 16*size) % size;  
 1379: }
 1380: 
 1381: __device__ __inline__ int nxq(int index, int size) {
 1382:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1383:    // to the index to make it positive
 1384:    assert(index + 16*size >= 0);
 1385:    return (index + 16*size) % size; 
 1386: }
