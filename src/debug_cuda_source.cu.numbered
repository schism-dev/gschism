  950:    __device__ void setFrame(void) {
  951:       if constexpr(ics == 1) return;
  952: 
  953:       double lat, lon;
  954:       const Point3 p = toPoint3(center, centerZ());
  955: 
  956:       // Compute the latitude and longitude of the element center
  957:       computeLatLon(p, lat, lon);
  958: 
  959:       frame.update(lat, lon);        
  960:    }
