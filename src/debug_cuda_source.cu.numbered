 7975: 
 7976: __global__ void computeMatrixProductAndDotProducts() {
 7977:    // Computes A*p, r'Mr and p'Ap
 7978: 
 7979:    // 1) shared buffer: first half for rMr, second for pAp
 7980:    __shared__ double sdata[2*BLOCK_SIZE];
 7981:    double* s_rMr = sdata;
 7982:    double* s_pAp = sdata + BLOCK_SIZE;
 7983: 
 7984:    const int tid = threadIdx.x;
 7985: 
 7986:    double l_pAp = 0.0;
 7987: 
 7988:    s_rMr[tid] = 0.0;
 7989:    s_pAp[tid] = 0.0;
 7990: 
 7991:    // 2) get your node pointer
 7992:    // NODE(node);   
 7993:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7994:    Node *node = &(mesh->localNodeData[idx_node]); 
 7995:       if (idx_node < mesh->np) {
 7996: 
 7997:       const double diag = node->coeffDiag;
 7998:       const double r    = node->mR;
 7999:       const double p    = node->mP;  
 8000: 
 8001:       // apply preconditioner on the fly:
 8002:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 8003: 
 8004:       // 4) compute Ap = A.p
 8005:       double Ap = node->coeffDiag * node->mP;
 8006:       for (int j = 0; j < node->numNodes; ++j) {
 8007:          const Node *nbNode = node->nodes[j];
 8008:          Ap += node->coeffMatrix[j] * nbNode->mP;
 8009: 
 8010:       }
 8011: 
 8012:       node->mAp = Ap;
 8013:       
 8014: 
 8015:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 8016:       // const double l_rMr = r*Mr;  // r'Mr
 8017:       l_pAp = p*Ap;  // p'Ap
 8018: 
 8019: 
 8020:    }
 8021: 
 8022:    // 6) write into shared mem
 8023:    // s_rMr[tid] = l_rMr;
 8024:    s_pAp[tid] = l_pAp;
 8025: 
 8026:    __syncthreads();
 8027: 
 8028:    // 7) block-wide tree reduction
 8029:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8030:       if (tid < stride)  {
 8031:          s_pAp[tid] += s_pAp[tid + stride];
 8032:       }
 8033:       __syncthreads();
 8034:    }
 8035: 
 8036:    // 8) thread 0 atomically accumulates into the globals
 8037:    // XXX: This is slower than it needs to be, but it is simple and works
 8038:    if (tid == 0) {
 8039:       atomicAdd(pAp, s_pAp[0]);
 8040:    }
 8041: 
 8042: 
 8043: }
 8044: 
 8045: 
 8046: __global__ void updateSolutionAndDotProducts(void) {
 8047:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 8048: 
 8049:    const int tid = threadIdx.x;
 8050: 
 8051:    s_rMr[tid] = 0.0;
 8052: 
 8053:    // get node & bounds-check:
 8054:    NODE(node);
 8055: 
 8056:    
 8057:    // Compute alpha
 8058:    const double alpha = (*rMr_old)/(*pAp); 
 8059: 
 8060: 
 8061:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 8062: 
 8063: 
 8064:    // load scalars
 8065:    const double diag = node->coeffDiag;
 8066:    const double p    = node->mP;
 8067:    const double Ap   = node->mAp;
 8068:    const double x    = node->mX;
 8069:    const double r    = node->mR;
 8070:    
 8071:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 8072: 
 8073:    // 1) update solution & residual
 8074:    const double x_new = x + alpha*p;
 8075:    const double r_new = r - alpha*Ap;
 8076:    node->mX = x_new;
 8077:    node->mR = r_new;
 8078: 
 8079:    // 2) apply Jacobi preconditioner on the fly
 8080:    const double Mr_new = r_new/diag;
 8081: 
 8082: 
 8083:    // 3) local contributions for the two dot-products
 8084:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 8085: 
 8086:    // 4) write into shared-mem
 8087:    s_rMr[tid] = l_rMr;
 8088: 
 8089:    __syncthreads();
 8090: 
 8091: 
 8092:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8093:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8094:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8095:       __syncthreads();
 8096:    }
 8097: 
 8098:    // 6) thread 0 atomically folds into the global accumulators
 8099:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 8100: 
 8101: 
 8102: }
 8103: 
 8104: 
 8105: __global__ void updateSearchDirection() {
 8106: 
 8107:     NODE(node);
 8108: 
 8109:     // recompute z on-the-fly
 8110:     const double z = node->mR / node->coeffDiag;
 8111:     const double p = node->mP;
 8112: 
 8113:     const double beta = (*rMr_new)/(*rMr_old);
 8114: 
 8115: 
 8116:     // p =z + beta*p
 8117:     node->mP = z + beta*p;
 8118: 
 8119: }
 8120: 
 8121: __global__ void initializeScalars(double *scalars) {
 8122: 
 8123:    // These point to a cupy array in the host code
 8124:    rMr_old = scalars + 0;
 8125:    rMr_new = scalars + 1;
 8126:    pAp     = scalars + 2;
 8127: }
 8128: 
 8129: __global__ void initializePreconditionedResidual(void) {
 8130: 
 8131:     __shared__ double s_rMr[BLOCK_SIZE];  
 8132: 
 8133:     s_rMr[threadIdx.x] = 0.0;
 8134: 
 8135:     NODE_ALL(node, valid);
 8136:     const int tid = threadIdx.x;
 8137:     // For the first iteration:
 8138:     // 1. Initial solution x = 0 (already set)
 8139:     // 2. Initial residual r = b (stored in qel)
 8140:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 8141: 
 8142: // XXX we should use the guess solution here    
 8143: 
 8144:     double l_rMr = 0.0;
 8145:     if (valid) {
 8146:       // Set initial residual r = b (from qel)
 8147:       node->mR = node->qel;
 8148: 
 8149:       // Compute z = M^-1 * r (preconditioned residual)
 8150:       const double z = node->mR / node->coeffDiag;
 8151: 
 8152:       // Set initial search direction p = z
 8153:       node->mP = z;
 8154: 
 8155:       // Initialize other variables needed for CG
 8156:       node->mX = 0.0;  // Initial solution
 8157:       node->mAp = 0.0; // Will be computed in first iteration
 8158: 
 8159: 
 8160:       // Computes the first r'Mr (reduction)
 8161:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 8162:     }
 8163:     // 4) write into shared-mem
 8164:     s_rMr[tid] = l_rMr;
 8165: 
 8166:     __syncthreads();
 8167: 
 8168: 
 8169:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8170:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8171:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8172:         __syncthreads();
 8173:     }
 8174: 
 8175:     // 6) thread 0 atomically folds into the global accumulators
 8176:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 8177: 
 8178:     *rMr_old = 0.0;
 8179:     *pAp = 0.0;
 8180: }
 8181: 
 8182: 
 8183: extern "C" __global__ void getElementVarFunc(int varCode, double *res) {
 8184: 
 8185:    ELEM(elem);
 8186: 
 8187:    switch (varCode) {
 8188:       case (int)VarCode::outputCoords:
 8189:          const Point2 coords = elem->outputCoords();
 8190:          res[elem->idx*2    ] = coords.x;
 8191:          res[elem->idx*2 + 1] = coords.y;
 8192:          break;
 8193:    }
 8194: }
