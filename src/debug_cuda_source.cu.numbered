 2247: 
 2248: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2249: 
 2250:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2251:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2252:    const Node *n1 = side->n1;
 2253:    const Node *n2 = side->n2;
 2254: 
 2255:    bool n1_match = (n1->nodeBnd->segment == segment);
 2256:    bool n2_match = (n2->nodeBnd->segment == segment);
 2257: 
 2258:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2259:    if (n1_match && n2_match) {
 2260:       return 0.5;
 2261:    } else if (n1_match) {
 2262:       return 1.0;
 2263:    } else if (n2_match) {
 2264:       return 0.0;
 2265:    }
 2266:    return 0.0;
 2267: }
 2268: 
 2269: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2270: 
 2271: 
 2272: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2273: 
 2274:    const double w1 = getBoundaryArrayValueWeight();
 2275:    const double w2 = 1.0 - w1;
 2276:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2277:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2278: 
 2279:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2280: }
 2281: 
 2282: 
 2283: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2284:    const double w1 = getBoundaryArrayValueWeight();
 2285:    const double w2 = 1.0 - w1;
 2286:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2287:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2288: 
 2289:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2290: }
