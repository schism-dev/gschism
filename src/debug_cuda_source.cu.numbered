 2117:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 2118:       // Compute the different time ramps used in the code 
 2119:       // This function is performed by just one thread
 2120: 
 2121:       rampbc = 1.0;
 2122:       if constexpr(ibc == 0) {
 2123:          if (drampbc > 0.0) {
 2124:             rampbc = tanh(2.0*time/86400.0/drampbc);
 2125:          } else {
 2126:             rampbc = 1.0;
 2127:          }
 2128:       }
 2129: 
 2130:       if (nws != 0) {
 2131:          if (drampwind > 0.0) {
 2132:             rampwind = tanh(2.0*time/86400.0/drampwind);
 2133:          } else {
 2134:             rampwind = 1.0;
 2135:          }
 2136:       }
 2137: 
 2138:       if (drampwafo > 0.0) {
 2139:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 2140:       } else {
 2141:          rampwafo = 1.0;
 2142:       }
 2143: 
 2144:       // For source/sinks
 2145:       if (if_source && dramp_ss > 0.0) {
 2146:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 2147:       } else {
 2148:          ramp_ss = 1.0;
 2149:       }
 2150: 
 2151:       if (dramp > 0.0) {
 2152:          ramp = tanh(2.0*time/86400.0/dramp);
 2153:       } else {
 2154:          ramp = 1.0;
 2155:       }
 2156: 
 2157: 
 2158:    }
