 3801: extern "C" {
 3802:    __global__ void rollUpElevation(void) {
 3803: 
 3804:       NODE(node);
 3805: 
 3806:       node->eta1 = node->eta2;
 3807: 
 3808:    }
 3809: 
 3810: 
 3811:    __global__ void backtrackAllNodes(void) {
 3812: 
 3813:       // max/min # of sub-divisions
 3814:       const int ndelt_max = max(1.0, dt/dtb_min);
 3815:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3816: 
 3817:       // Removed all references to swild98 XXX
 3818:       // swild98=0.d0 !init
 3819: 
 3820: 
 3821:       SIDE(side);
 3822: 
 3823:       const int kb = side->kb;
 3824: 
 3825: 
 3826:       // Initialize btrack velocities to the actual velocities at the side 
 3827:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3828: 
 3829:       if (side->isDry) return;
 3830: 
 3831: 
 3832:       // Checks that at least one element is not dry
 3833:       const Element *elem1 = side->elems[0];
 3834:       const Element *elem2 = side->elems[1];
 3835: 
 3836: 
 3837:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3838:       
 3839:       // XXXXXX
 3840:       // !swild_tmp to store global coord. of the starting side
 3841:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3842:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3843:       // !Use sframe2 
 3844:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3845: 
 3846: 
 3847:       for (int k = kb; k < nvrt; k++) {
 3848:       //  Initialize (xt,yt,zt), nnel and vel.
 3849:       //  For ics=2, the coordinates are in local frames
 3850:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3851: 
 3852: 
 3853:          const int iadvf = side->iadv();  // Advection flag
 3854: 
 3855:          Point3 xt;
 3856:          if constexpr(ics==1) {
 3857:             xt = side->center3D(k); 
 3858:          }
 3859:          else // lat/lon; in side lat/lon frame
 3860:          {
 3861:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3862:          // XXX IMPLEMENT THIS
 3863:       //          xt=0.d0
 3864:       //          yt=0.d0
 3865:       //          !centroid coord. for nudging
 3866:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3867:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3868:          }  // ics
 3869: 
 3870: 
 3871: 
 3872:          // If on land or open boundary...
 3873:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3874:          
 3875:          const double vmag = length(side->u2[k]);
 3876: 
 3877:          if (vmag <= velmin_btrack) {
 3878:             // No activity 
 3879: 
 3880:             side->btu[k] = side->u2[k];
 3881:             
 3882:          } else {  // do btrack
 3883: 
 3884:             // Compute number of sub-divisions based on local gradients 
 3885:             // XXX IS THIS NECESSARY?
 3886:             double suma = 0.0;
 3887:             int icount = 0;
 3888:             for (int ii=0; ii<2; ii++) {
 3889: 
 3890:                const Element *elem = side->elems[ii];
 3891:                  
 3892:                if (elem == nullptr) continue;
 3893: 
 3894:                icount++;
 3895: 
 3896:                // Not strictly along z; in ll frame for ics=2
 3897: 
 3898:                double utmp[4];
 3899:                double vtmp[4];
 3900:                for (int jj = 0; jj < elem->i34; jj++) {
 3901: 
 3902:                   const Node *node = elem->nodes[jj];
 3903: 
 3904:                   if constexpr(ics==1) {
 3905:                      utmp[jj] = node->u2[k].x;
 3906:                      vtmp[jj] = node->u2[k].y;  
 3907:                   } else {
 3908:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3909:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3910:                   }
 3911:                } // for jj
 3912: 
 3913:                const Vector2 grad_u = elem->grad2(utmp); 
 3914:                const Vector2 grad_v = elem->grad2(vtmp);
 3915: 
 3916:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3917:             } // for ii
 3918: 
 3919:             assert(icount > 0 && "Impossible 77");
 3920: 
 3921:             // '4' is somewhat arbitrary
 3922:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3923: 
 3924:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3925:          
 3926: 
 3927:             Vector3 u_int = {0.0, 0.0, 0.0};
 3928: 
 3929:             side->btrack(k, dt, dtbk, u_int);
 3930:             side->btu[k] = toVector2(u_int);
 3931:                
 3932:          } // if vmag (do backtrack)
 3933: 
 3934:       } // for k=kb,nvrt-1
 3935: 
 3936:    }
 3937: 
 3938: } // extern "C"
 3939: 
 3940: template<int nc>
 3941: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3942: 
 3943: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3944: //
 3945: // a,b,c,rhs: input vectors and are not modified by this program.
 3946: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3947: // rhs is the r.h.s.
 3948: // n: actual rank of the system.
 3949: // rows in u() and rhs();
 3950: // u: output with nc columns (transposed to rows)
 3951: // gam: a working array.
 3952: //
 3953: // NOTES:
 3954: // This is a template function that allows for different numbers of columns in the rhs vector.
 3955: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3956: 
 3957:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3958:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3959: 
 3960:    double bet = b[0];
 3961:    if constexpr (nc == 1) {
 3962:       u[0] = rhs[0]/bet;
 3963:    } else {
 3964:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 3965:    }
 3966: 
 3967:    for (int j = 1; j < n; j++) {
 3968:       gam[j] = c[j - 1]/bet;
 3969:       bet = b[j] - a[j]*gam[j];
 3970: 
 3971:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3972: 
 3973:       if constexpr (nc == 1) {
 3974:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3975:       } else {
 3976:          for (int l = 0; l < nc; l++) {
 3977:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 3978:          }
 3979:       }
 3980:    }
 3981: 
 3982:    // Back-substitution
 3983:    for (int j = n - 2; j >= 0; j--) {
 3984:       if constexpr (nc == 1) {
 3985:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 3986:       } else {
 3987:          for (int l = 0; l < nc; l++) {
 3988:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 3989:          }
 3990:       }
 3991:    }
 3992: }
 3993: 
 3994: 
 3995: 
 3996: // Helper function that contains the core algorithm
 3997: template<typename XAccessor, typename YAccessor>
 3998: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3999:                                     double  yp_top, double  yp_bot, 
 4000:                                     CubicSpline &spline) {
 4001:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4002:    // 
 4003:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4004:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4005:    //
 4006:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4007:    // 
 4008:    // Inputs: 
 4009:    //            n: dimension for x etc; # of data pts (>=2);
 4010:    //            getX, getY: functions to access x,y coordinates
 4011:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4012:    //     Output: 
 4013:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4014: 
 4015:    const int n = k2 - k1 + 1;
 4016:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4017: 
 4018:    // Allocate memory for the splines
 4019:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4020:    spline.x   = new double[n];
 4021:    spline.y   = new double[n];
 4022:    spline.yp  = new double[n];
 4023:    spline.ypp = new double[n];
 4024: 
 4025:    for (int k=k1; k<=k2; k++) {
 4026:       spline.x[k] = getX(k);
 4027:       spline.y[k] = getY(k);
 4028:    }
 4029: 
 4030:    // This is to simplify expressions later
 4031:    double *x = spline.x;
 4032:    double *y = spline.y;
 4033: 
 4034:    double *a = nullptr;
 4035:    double *b = nullptr;
 4036:    double *c = nullptr;
 4037:    double *gam = nullptr;
 4038:    double *rhs = nullptr;
 4039:    
 4040: 
 4041:       a = new double[n];   // Lower diagonal
 4042:       b = new double[n];   // Diagonal
 4043:       c = new double[n];   // Upper diagonal
 4044:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4045:       rhs = new double[n]; // Right-hand side
 4046: 
 4047:    for (int k=k1; k<=k2; k++) {
 4048:       if (k == k1) {
 4049:          // Bottom level
 4050:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4051:          b[k] = (x[k+1] - x[k])/3.0;
 4052:          c[k] = b[k]/2.0;
 4053:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4054:       } else if (k == n - 1) {
 4055:          // Top level (surface)
 4056:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4057:          b[k] = (x[k] - x[k-1])/3.0;
 4058:          a[k] = b[k]/2.0;
 4059:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4060:       } else {
 4061:          // Intermediate levels
 4062:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4063:          b[k] = (x[k+1] - x[k-1])/3.0;
 4064:          a[k] = (x[k  ] - x[k-1])/6.0;
 4065:          c[k] = (x[k+1] - x[k  ])/6.0;
 4066:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4067:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4068:       }
 4069:    }
 4070: 
 4071:    // Solve the tridiagonal system
 4072:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4073:    
 4074:    spline.yp[k1] = yp_bot;
 4075:    spline.yp[k2] = yp_top;
 4076: 
 4077:    // Compute rest of 1st derivatives using the splines
 4078:    for (int k=k1+1; k<k2; k++) {
 4079:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4080:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4081:    }
 4082:    
 4083:    delete[] a;
 4084:    delete[] b;
 4085:    delete[] c;
 4086:    delete[] gam;
 4087:    delete[] rhs;
 4088: 
 4089: }
 4090: 
 4091: // Array version
 4092: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4093:                                 double y_top, double y_bot, 
 4094:                                 CubicSpline &spline) {
 4095:    auto getX = [x] (int k) { return x[k]; };
 4096:    auto getY = [y] (int k) { return y[k]; };
 4097:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4098: }
 4099: 
 4100: // Lambda version - allows custom access patterns
 4101: template<typename XFunc, typename YFunc>
 4102: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4103:                                 double y_top, double y_bot,
 4104:                                 CubicSpline &spline) {
 4105:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4106: }
