 3834: 
 3835: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3836: 
 3837: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3838: 
 3839:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3840:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3841: 
 3842:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3843:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3844: 
 3845:    double fun_lat = 0.0;
 3846:    switch (jspc[idxComp]) {
 3847:       case 0:
 3848:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3849:          break;
 3850:       case 1:
 3851:          fun_lat = sin(2.0*lat);
 3852:          break;
 3853:       case 2:
 3854:          fun_lat = pow<2>(cos(lat));
 3855:          break;
 3856:       default:
 3857:          assert(false && "computeETP: invalid jspc");
 3858:    }
 3859:    
 3860:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3861: 
 3862: }
 3863: 
 3864: __device__ void Node::updateKb(void) {
 3865: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3866: 
 3867:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3868: 
 3869: 
 3870:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3871: 
 3872:    if constexpr(ivcor == 2) {  // SZ coordinates
 3873:       
 3874:       // Compute bottom level index
 3875:       if (depth <= mesh->h_s) {
 3876:          kb = izlev;   
 3877:          
 3878:       } else {
 3879:          kb = -1;
 3880:          int L = 0;
 3881:          int R = nzlev; 
 3882:          
 3883:          while (L <= R) {
 3884:             int M = (R + L) / 2;
 3885: 
 3886: 
 3887:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3888:             
 3889:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3890:                R = M;
 3891:             } else {
 3892:                L = M;
 3893:             }
 3894: 
 3895:             if (R - L == 1) {
 3896:                kb = L;
 3897:                break;
 3898:             }
 3899:          }
 3900: 
 3901:          // Checks that the binary search was successful
 3902:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3903:        
 3904:       }
 3905:    } 
 3906: }
 3907: 
