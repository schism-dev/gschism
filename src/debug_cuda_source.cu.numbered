 2550: /**
 2551:  * This method performs backtracking from the side center until a time -dt back in time 
 2552:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2553:  * intermediate point.
 2554:  *
 2555:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2556:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2557:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2558:  * remaining time.
 2559:  * 
 2560:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2561:  * 
 2562:  * @param uuint, vvint, wwint: Velocities at the final point
 2563:  * @param jlev: Level at which the backtracking is performed
 2564:  * @param dt, dtbk: Tracking timesteps
 2565:  * @return: True if the backtracking was successful, false otherwise
 2566:  */
 2567: __inline__ __device__ bool Side::btrack(
 2568:       int jlev,
 2569:       double dt,            // Tracking time
 2570:       double dtbk,          // Tracking timestep
 2571:       Vector3 &u_int        // Velocities at the initial point
 2572: ) const {
 2573: 
 2574:    // Start from side center
 2575:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2576: double dt0 = dt; // XXXXX
 2577: Point3 x00 = x0;
 2578: const int oriJlev = jlev;
 2579:  
 2580:    double time_rm = dt; // Remaining time
 2581: 
 2582: 
 2583: 
 2584: 
 2585:    // Initial velocities
 2586:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->w2[jlev] + n2->w2[jlev])};
 2587: 
 2588:    // Find the element that is in the direction opposite to the velocity
 2589:    Element* curElem = findElementTowards(toVector2(u_int));
 2590: 
 2591: 
 2592:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2593:    if (curElem == nullptr) {
 2594:       // Make velocity parallel to the side
 2595:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2596:       // u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2597:       curElem = otherElem(curElem);
 2598: 
 2599:    }
 2600: 
 2601:    if (curElem == nullptr || curElem->isDry) { 
 2602:       // This means that the starting side is shared by dry elements (or one dry and one boundary side).
 2603:       u_int = {0.0, 0.0, 0.0}; 
 2604:       return true;
 2605:    }
 2606: 
 2607:    // Nudges it towards the barycenter
 2608:    curElem->nudgeToBarycenter(toPoint2(x0)); // XXXX Necessary?
 2609: 
 2610: 
 2611:    const int MAX_ITERATIONS = 1000; 
 2612:    Element* nextElem = nullptr;
 2613:    int iter = 0;
 2614: assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 2615:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 2616:    while(true) {
 2617: 
 2618:       // Calculate timestep
 2619:       double dtb = min(dtbk, time_rm);
 2620: 
 2621:       // Next point in the backtracking curve
 2622:       xt = x0 - dtb*u_int;
 2623: 
 2624:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, time_rm, this);
 2625:       assert(found && "Backtracking failed in btrack");
 2626: 
 2627: 
 2628:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2629:                       // then time_rm needs to be increased by the unused time.
 2630: 
 2631:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0                      
 2632: 
 2633:       // If the velocity is too small, we stop the backtracking
 2634:       const double vmag = length(toVector2(u_int));
 2635:       if (vmag <= velmin_btrack) break;
 2636: 
 2637:       // The current point becomes the next segment's starting point.
 2638:       x0 = xt;
 2639:  
 2640:       curElem = nextElem;
 2641: 
 2642:       iter++;
 2643: 
 2644:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2645:    }
 2646: 
 2647:    // Interpolate the velocities at the final point
 2648:    curElem->interpolateVelocities(xt, u_int);
 2649: 
 2650: 
 2651: }
 2652: 
 2653: 
