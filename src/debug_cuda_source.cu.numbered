 3559:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3560: 
 3561:       NODE_BND(nodeBnd);
 3562: 
 3563:       Node *node = nodeBnd->node;
 3564: 
 3565:       node->ETP = 0.0;
 3566: 
 3567:       for (int j=0; j<ntip; j++) {
 3568: 
 3569:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3570:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3571:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3572: 
 3573:          if constexpr(iloadtide==1) { // loading tide
 3574:             assert(false && "Loading tide not implemented");
 3575:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3576:          }
 3577:          
 3578:       }
 3579:       
 3580:    }
