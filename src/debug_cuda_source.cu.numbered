 5362:    __global__ void setWinds(double *xWind, double *yWind, double *pressAir) {
 5363:       NODE(node);
 5364: 
 5365:       const int idx = node->idx;
 5366:       Vector2 wind = {xWind[idx], yWind[idx]};
 5367: 
 5368:       if constexpr(nws != 0 && iwindoff != 0) {
 5369:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 5370:       }
 5371: 
 5372:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 5373:       node->setWind(wind);
 5374: 
 5375:       node->pr = pressAir[idx];
 5376:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 5377: 
 5378:    }
