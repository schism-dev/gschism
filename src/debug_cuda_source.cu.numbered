 4094:    __global__ void computeBottomDragVegetation(void) {
 4095:       // UNFINISHED. CHECK THIS:
 4096:       // How many kernels are needed? Why so many for loops?
 4097:       // Is the loop on sides needed?
 4098: 
 4099:       NODE(node);
 4100: 
 4101:       const int    kb      = node->kb;
 4102:       const double htot    = node->htot2();
 4103:       const double rough   = node->rough;
 4104: 
 4105: 
 4106:       if (node->isDry) {
 4107:          // Default values for dry nodes
 4108:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4109:          /// XXX CHECK INDICES
 4110:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4111:       }
 4112: 
 4113:       // Compute bottom drag Cd
 4114:       //--------------------------------
 4115: 
 4116:       // nchi = {-1, 0, 1} is the type of bottom drag.
 4117:       if (nchi==1) {
 4118: 
 4119:          bool ltmp = false; // for WBL iteration
 4120: 
 4121:          // Cdmax=-1 !max. Cd at node for this process (info only)
 4122:          // Drag at nodes
 4123:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 4124:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 4125:         
 4126:          const double rough = node->rough;
 4127:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4128:          if (node->rough == 0.0) {
 4129:             node->Cd = 0.0;
 4130: 
 4131:          } else { //roughness >0 
 4132:             
 4133:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 4134:             const double bthick = max(dzb_min, bthick_ori);
 4135: 
 4136:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 4137: 
 4138:             double tmp = 1.0/(2.5*log(bthick/rough));
 4139:             node->Cd = tmp*tmp;
 4140: 
 4141:          } // if rough
 4142: 
 4143: 
 4144:          // RECOVER THIS: XXX
 4145:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 4146:          // Output warning for WBL if iteration didn't converge
 4147: 
 4148: 
 4149:       } // nchi==1
 4150: 
 4151:       //   Bottom stress in m^2/s^2
 4152:       if (node->rho[kb + 1] >= -98.0)
 4153:       {
 4154:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 4155:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 4156:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4157:          // !sediment erosion: this part needs more documentation
 4158:       }
 4159: 
 4160:     
 4161:       // Compute vegetation parameters
 4162:       //--------------------------------
 4163: 
 4164:       // SAV constants
 4165:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4166:       constexpr double veg_cfpsi = 0.16;
 4167: 
 4168:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4169:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4170: 
 4171:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4172:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4173:          int kbin = 0; // bin index
 4174:          for (int k = kb; k < nvrt; k++) {
 4175:             // Computes node height above the bottom level
 4176:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4177:             assert(false && "Vertical variation of vegetation not implemented");
 4178: 
 4179:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4180:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4181:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4182:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4183:             // } else {
 4184:             //    // Find the bin at which the current vertical level is
 4185:             //    while (kbin<nbins_veg_vert) {
 4186:             //       const double zn = node->z[kbin];
 4187:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4188:             //          break;
 4189:             //       } // if
 4190:             //       kbin++;
 4191:             //    } // while
 4192:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4193: 
 4194:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4195:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4196:                
 4197:             //    // Linear interpolation of the vegetation parameters
 4198:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4199:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4200:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4201:             // } // if rl10
 4202: 
 4203:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4204: 
 4205:          } // for k
 4206: 
 4207: 
 4208:       } else { // Ganthy (iveg=2)
 4209:       //  Modify canopy height, diameter, and density
 4210: 
 4211:          // Make sure there is vegetation on this node
 4212:          if (node->veg_h_unbent > 0.0) {
 4213:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4214: 
 4215:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4216:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4217:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4218: 
 4219:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4220:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4221:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4222:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4223:          } // if veg_h_unbent
 4224: 
 4225:          for (int k = 0; k < nvrt; k++) {
 4226:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4227:          } // for k
 4228:       
 4229: 
 4230:       } // if iveg
 4231:      
 4232:          
 4233: 
 4234:       // Compute vertical mean of veg_alpha3D
 4235:       if (iveg != 0) {
 4236:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4237:          double sum1=0.0;
 4238:          double sum2=0.0;
 4239:          // Integrate over each level under the canopy...
 4240:          for (int k=kb; k<nvrt-1 && node->z[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 4241:             const double Dz = node->Dz(k);
 4242: 
 4243:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 4244:             sum2 += Dz;
 4245: 
 4246:          } // for k
 4247: 
 4248:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4249:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4250: 
 4251:       } // if iveg
 4252: 
 4253:       printf("computeBottomDragVegetation: nodeIdx = %d, node->veg_alpha_vert_mean = %f\n", node->idx, node->veg_alpha_vert_mean);
 4254: 
 4255:    }
 4256: 
 4257:    __global__ void computeVegetationAndDragParameters(void) {
 4258:       // Computes the vegetation and drag model parameters:
 4259:       // chi, \tilde\chi, beta, \breve{H}
 4260:       
 4261:       SIDE(side);
 4262: 
 4263:       const double htot = side->htot2();
 4264:       const int    kb   = side->kb;
 4265: 
 4266:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4267: 
 4268:       const double veg_h     = side->veg_h();
 4269:       const double veg_nv    = side->veg_nv();
 4270:       const double veg_c     = side->veg_c();
 4271:       const double veg_beta  = side->veg_beta;
 4272:       const double veg_alpha = side->veg_alpha_vert_mean();
 4273: 
 4274:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4275:       // Velocity magnitude at the bottom level
 4276:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4277:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4278:       side->chi2 = side->Cd()*vmag1;
 4279:       side->chi  = side->chi2;
 4280:       if constexpr(iveg != 0) {
 4281:          const Node *n1 = side->n1;
 4282:          const Node *n2 = side->n2;
 4283:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4284:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4285:       }
 4286: 
 4287:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4288: 
 4289:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4290:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4291:       double magUa = 0.0;
 4292:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4293:          // 3D wet side with veg...
 4294: 
 4295:          double magUa = 0.0;
 4296:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4297:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4298: 
 4299:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4300:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4301:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4302: 
 4303:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4304:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4305: 
 4306:                // Velocity magnitude at the bottom (l) of the level
 4307:                const double ul = length(side->u2[k]);
 4308: 
 4309:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4310:                magUa += Dz*0.5*(uh + ul);
 4311: 
 4312:             } // if HasVegetation
 4313:          } // for k
 4314:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4315: 
 4316:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4317:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4318:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4319:             const double zCpy = side->zTopCanopy();
 4320:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4321:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4322:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4323:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4324:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4325:          } // if isSubmerged
 4326:       } // if iveg   
 4327: 
 4328:       // Computes the friction modified depth, \breve{H} in notes
 4329:       if (side->is2D()) { // 2D
 4330: 
 4331:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4332:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4333: 
 4334:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4335: 
 4336:          side->hhat = htot*htot/fricH; 
 4337: 
 4338:       } else { // 3D
 4339:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4340: 
 4341:          if constexpr(iveg != 0) {
 4342:             
 4343:             if (side->isSubmerged()) { 
 4344:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4345:                side->hhat -= veg_c*Hhat_alpha;
 4346: 
 4347:             } else { // Emergent
 4348:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4349:             }
 4350:          } // if iveg
 4351: 
 4352:          // Enforce positivity for 3D model
 4353:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4354:       } // if 3D
 4355: 
 4356:       printf("computeVegetationAndDragParameters: sideIdx = %d, side->htot = %f, side->hhat = %f\n", side->idx, side->htot2(), side->hhat);
 4357: 
 4358:         
 4359:    }
 4360: 
 4361: 
 4362: 
 4363:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4364:    // Computes the density gradient between two elements, e1 and e2.
 4365:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4366:    // zero in the direction normal to the side. 
 4367:    // 
 4368:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4369:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4370:    //
 4371:    // Input:
 4372:    //    e1: Element
 4373:    //    e2: Neighbor element (or nullptr if boundary)
 4374:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4375:    //    k: Index of the half-level at which the density is interpolated
 4376:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4377:    // 
 4378:    // Output:
 4379:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4380:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4381: 
 4382:       if (e2 == nullptr || e2->isDry) {
 4383:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4384: 
 4385:          Side *side = e1->sides[j];
 4386:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4387:                  
 4388:          if constexpr(ics == 1) {
 4389:             vec = side->n; // Normal vector to the side
 4390:          } else {
 4391:             // IMPLEMENT THIS XXXXXX
 4392:             // !replace with xel, yel?
 4393:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4394:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4395:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4396:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4397:          } //ics
 4398:                    
 4399:          diffRho = 0.0;
 4400: 
 4401:       } else { //internal and wet
 4402:          if constexpr(ics==1) {
 4403:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4404: 
 4405:             // Vector from e1 to e2
 4406:             vec = toVector2(e2->center - e1->center);
 4407: 
 4408:          } else { 
 4409:             // IMPLEMENT THIS XXXXXX
 4410:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4411:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4412:             //                   alow(j)=xctr2
 4413:             //                   bdia(j)=yctr2
 4414:          } // ics
 4415: 
 4416:          diffRho = rho2 - e1->demeanedDensity(k);
 4417:       }
 4418: 
 4419:    }
 4420: 
 4421:    __global__ void computeDensityCubicSplines(void) {
 4422:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4423: 
 4424:       ELEM(elem);
 4425: 
 4426:       if (elem->isDry) return;
 4427: 
 4428:       const int kb = elem->kb;
 4429: 
 4430:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4431:       if (elem->is2D()) {
 4432:          // In the 2D case, the density is constant at the prism level. 
 4433:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4434:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4435:       } else { //3D
 4436: 
 4437:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4438:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4439:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4440:          ///// XXXX CHECK INDICES!!!!!
 4441:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4442:       } // 2D/3D
 4443: 
 4444:    }
 4445: } // extern "C"
 4446: 
 4447: 
 4448: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4449: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4450: 
 4451:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4452: 
 4453:    const int kb  = elem->kb;
 4454:    const int kb2 = elem2->kb;
 4455: 
 4456:    // z-coordinate of prism of elem
 4457:    const double zp = elem->z_prism(k);
 4458: 
 4459:    double rho = 0.0;
 4460: 
 4461:    if (elem2->is2D()) {
 4462:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4463: 
 4464:    } else {  // 3D
 4465: 
 4466:       // eta_min may be < zmax
 4467:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4468:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4469: 
 4470:       // (Extrapolate density below bottom, we will fix it later)
 4471:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4472:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4473:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4474:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4475:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4476:    } // 2D/3D
 4477:      
 4478: 
 4479:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4480:    // Now we need to fix it.
 4481:    if (elem->z[k] < elem2->z[kb2]) {
 4482:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4483: 
 4484:       // There are two methods to adjust the density at the bottom of the element.
 4485:       // iunder_deep=0: 
 4486:       const double depth1 = abs(elem->z[kb]); // larger depth
 4487: 
 4488:       if (iunder_deep==0) {
 4489: 
 4490:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4491: 
 4492:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4493: 
 4494:       } else { // iunder_deep != 0
 4495: 
 4496:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4497: 
 4498:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4499: 
 4500:          //   Demeaned density at the same z coordinate as
 4501:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4502:          }
 4503: 
 4504:       } // if iunder_deep
 4505:    } // if elem->z[kb] < elem2->z[kb]
 4506: 
 4507:    return rho;
 4508: }
 4509: 
 4510: 
 4511: extern "C" {
 4512:    __global__ void computeDensityGradient(void) {
 4513: 
 4514:          // Compute the horizontal density gradient at each element.
 4515:       // It works in two steps:
 4516:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4517:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4518:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4519:       //             gradRho.r1 = rho1 - rho0
 4520:       //             gradRho.r2 = rho2 - rho0
 4521:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4522:       // 
 4523:       //  NOTE: We use de-meaned densities.
 4524: 
 4525:       ELEM(elem);
 4526: 
 4527:       if (elem->isDry) return;
 4528: 
 4529:       const int kb  = elem->kb;
 4530:       const int i34 = elem->i34;
 4531: 
 4532:       for (int k = kb + 1; k < nvrt; k++) {
 4533:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 4534:          //             gradRho.r1 = rho1 - rho0
 4535:          //             gradRho.r2 = rho2 - rho0
 4536:          int icount = 0;
 4537:          double sumRx = 0.0;
 4538:          double sumRy = 0.0;
 4539:          for (int j1=0; j1<i34; j1++) { 
 4540: 
 4541:             const int j2 = elem->nxq(j1 + 1);
 4542: 
 4543:             // Pairs of consecutive neighbor elements of elem
 4544:             const Element *e1 = elem->nghbElems[j1];
 4545:             const Element *e2 = elem->nghbElems[j2];
 4546: 
 4547:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 4548:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 4549:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 4550: 
 4551:             // Compute the density difference and the vector from elem to e1 and e2
 4552:             // getRhoDiffAndVec takes into account boundaries/dry elements
 4553:             double diffRho1, diffRho2;
 4554:             Vector2 vec1, vec2;
 4555:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 4556:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 4557: 
 4558:             const double rl1 = length(vec1);
 4559:             const double rl2 = length(vec2);
 4560:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 4561: 
 4562:             const double delta = cross(vec1, vec2);
 4563:             const double sintheta = abs(delta)/(rl1*rl2);
 4564: 
 4565:             // To avoid problems, avoid elements with small angle between vectors
 4566:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 4567:             const bool validEq = (sintheta > sin_one_deg);
 4568: 
 4569:             if (validEq) {
 4570:                // Solve the system of equations to get the density gradient at elem
 4571:                icount++;
 4572:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 4573:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 4574:                sumRx += Rx;
 4575:                sumRy += Ry;
 4576:             }
 4577:          } // for j1
 4578: 
 4579:          // Compute the average density gradient at elem
 4580:          if (icount==0) {
 4581:            // Bad mesh quality; bail out with 0 b-cc
 4582:            elem->gradRho[k] = {0.0, 0.0};
 4583:          } else {
 4584:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 4585:          }
 4586: 
 4587:       } // for k
 4588: 
 4589:    }
 4590: 
 4591:    __global__ void computeBaroclinicTerm(void) {
 4592:    // Computes the baroclinic term at sides (at half levels).
 4593:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 4594:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 4595: 
 4596:       SIDE(side);
 4597: 
 4598:       if (side->isDry) return;
 4599: 
 4600:       const Element *e1 = side->elems[0];
 4601:       const Element *e2 = side->elems[1];      
 4602:       const int kb = side->kb;
 4603:       
 4604:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 4605: 
 4606:       // interpolates vertically the density gradient of the two elements at the half level/
 4607: 
 4608:       // Starts the integration at the surface and goes down to the bottom
 4609:       int k1 = nvrt - 1;
 4610:       int k2 = nvrt - 1;
 4611: 
 4612:       side->bcc[nvrt-1] = {0.0, 0.0};
 4613:       for (int k = nvrt-2; k >= kb; k--) {
 4614:       // For each prism level (from surface to bottom)...
 4615: 
 4616:          // For both elements, interpolate density gradient at the side's half level.
 4617:          // The gradient at the side is the average of the gradients at the elements.
 4618:          // w1, w2 are used to take into account boundary sides, with just one element.
 4619:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 4620:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 4621:          const double wsum = w1 + w2;
 4622:          w1 = w1/wsum;
 4623:          w2 = w2/wsum;
 4624:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 4625: 
 4626:          // Linear interpolation of both elements' density gradient at the shared side's level.
 4627:          Vector2 gradRho = {0.0, 0.0};
 4628:          if (e1 != nullptr && k > kb) {
 4629:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 4630:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 4631:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 4632:             
 4633:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 4634:          }      
 4635:          if (e2 != nullptr && k > kb) {
 4636:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4637:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4638:             
 4639:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4640:          }
 4641: 
 4642:          if constexpr(ics==2) {
 4643:             // IMPLEMENT THIS XXXXXX
 4644:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4645:             // swild(1)=tmp1
 4646:             // swild(2)=tmp2
 4647:          }
 4648:          
 4649:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4650:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4651:          // CHECK INDICES!!! XXX
 4652:          const double grav3 = side->grav3();
 4653:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4654: printf(">>>side->bcc[%d] = %e, %e, rampbc: %e, grav3: %e, rho0: %e, side->Dz(k + 1): %e, gradRho: %e, %e\n", k, side->bcc[k].x, side->bcc[k].y, rampbc, grav3, rho0, side->Dz(k + 1), gradRho.x, gradRho.y);
 4655: 
 4656:       } // for
 4657: 
 4658:    }
 4659: 
 4660: 
 4661: 
 4662:    __global__ void computeHorGradientAtSide(void) {
 4663: 
 4664:       // Compute the horizontal density gradient at each element.
 4665:       // It works in two steps:
 4666:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4667:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4668:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4669:       //             gradRho.r1 = rho1 - rho0
 4670:       //             gradRho.r2 = rho2 - rho0
 4671:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4672:       // 
 4673:       //  NOTE: We use de-meaned densities.
 4674: 
 4675:       SIDE(side);
 4676: 
 4677:       if (side->isDry) return;
 4678: 
 4679:       // Computes the gradient of the variables at the side center.
 4680:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 4681:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 4682:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 4683: 
 4684:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 4685:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 4686:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 4687:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 4688: 
 4689: 
 4690:       printf("gradEta1: %e, %e, gradEta2: %e, %e, gradETP: %e, %e, gradPr: %e, %e\n", 
 4691:          side->gradEta1.x, side->gradEta1.y, 
 4692:          side->gradEta2.x, side->gradEta2.y, 
 4693:          side->gradETP.x, side->gradETP.y, 
 4694:          side->gradPr.x, side->gradPr.y);
 4695: 
 4696: 
 4697:    }
 4698: 
 4699: 
 4700:    __global__ void solveMomentumEquations(double time) {
 4701: 
 4702:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 4703:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 4704: 
 4705:       SIDE(side);
 4706: 
 4707:       if (side->isDry) 
 4708:       {
 4709:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 4710: 
 4711:          return;
 4712:       }
 4713: 
 4714:       const Node *n1 = side->n1;
 4715:       const Node *n2 = side->n2;
 4716: 
 4717:       const int kb = side->kb;
 4718: 
 4719:       const double veg_h = side->veg_h();
 4720:       const double grav3 = side->grav3();
 4721: 
 4722: printf("###>>>#side->is2D() = %d\n", side->is2D());
 4723:       if (side->is2D()) {
 4724:          // Warning: Do not use htot2, which is updated.
 4725:          const double htot = side->htot1();
 4726:          const double hhat = side->hhat;
 4727: 
 4728:          assert(hhat > 0.0 && htot > 0.0 && "Impossible dry 55:");
 4729: 
 4730:          Vector2 tau2 = {0.0, 0.0};
 4731:           
 4732:          if constexpr(ics==1) {
 4733:             tau2 = side->tau();
 4734: 
 4735:          } else {
 4736:             assert(false && "Not implemented: ics == 2");
 4737:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4738:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4739:             // taux2=(vn1+tt1)*0.5d0
 4740:             // tauy2=(vn2+ss1)*0.5d0
 4741:          } // if ics         
 4742: 
 4743:          // hat_gam has units of m/s
 4744: 
 4745:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 4746: 
 4747:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 4748:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 - thetai*side->gradEta2));
 4749: 
 4750:          hat_gam += dt*side->d2uv[nvrt-1];  // XXXX compute d2uv
 4751: 
 4752:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvel1, rmaxvel1);
 4753:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvel2, rmaxvel2);
 4754: 
 4755:          for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 4756: 
 4757: printf("###>>>#side->u2[0] = %e, %e, side->u2[1] = %e, %e\n", side->u2[0].x, side->u2[0].y, side->u2[1].x, side->u2[1].y);
 4758: 
 4759:       }
 4760:       else { // 3D
 4761: 
 4762:          // For 3D it is necessary to solve an implicit tridiagonal system.
 4763:          // 
 4764:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 4765:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 4766:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 4767:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 4768:          // k+1 and k.
 4769: 
 4770: 
 4771:          // // Define layer thickness & viscosity
 4772:          // for (int k=kb + 1; k<nvrt; k++) {
 4773:          //    const double dzz = side->Dz(k - 1);
 4774: 
 4775:          //    assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4776: 
 4777:          //    // Vertical viscosity at the face center
 4778:          //    dfz(k) = 0.25*(n1->dfv[k] + n2->dfv[k] + n1->dfv[k-1] + n2->dfv[k-1]);
 4779:         
 4780:          // }
 4781: 
 4782: 
 4783:          const int ndim = nvrt - kb;
 4784:          const double zTopCanopy = side->zTopCanopy();
 4785: 
 4786:          // Initialize the tridiagonal system
 4787:          for (int k = kb + 1; k<nvrt; k++) {
 4788:             
 4789:             const int kin = k - kb;
 4790: 
 4791:             // Vertical viscosity at the face center
 4792:             const double dfz = 0.25*(side->dfv(k) + side->dfv(k + 1));
 4793:             const double dzz = side->Dz(k);
 4794: 
 4795:             printf("k: %d, side->zc[0]: %e, side->n1->z[0]: %e, side->n2->z[0]: %e, dzz: %e, dfz: %e\n",k, side->zc[0], side->n1->z[0], side->n2->z[0], dzz, dfz);
 4796:             printf("k: %d, side->zc[1]: %e, side->n1->z[1]: %e, side->n2->z[1]: %e, dzz: %e, dfz: %e\n",k, side->zc[1], side->n1->z[1], side->n2->z[1], dzz, dfz);
 4797:             assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4798: 
 4799:             alow[kin] = 0.0;
 4800:             cupp[kin] = 0.0;
 4801:             bdia[kin] = 0.0;
 4802: 
 4803:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 4804:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 4805: 
 4806:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 4807:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 4808:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 4809: 
 4810:             // First part: layers k, k+1
 4811:             if (k < nvrt - 1) {
 4812:                              
 4813:                if constexpr(iveg != 0) {
 4814: 
 4815:                   // If there is vegetation at this level...
 4816:                   if (zTopCanopy > side->zc[k]) {
 4817:                      // If the canopy is above the k layer...
 4818:                      
 4819:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 4820:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 4821:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 4822:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 4823: 
 4824:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 4825:                      const double vmag2 = length(ut2);
 4826:                      const double vmag1 = length(side->u2[k]);
 4827:                      const double vmag = 0.5*(vmag1 + vmag2);
 4828:                      
 4829:                      // Computes the vegetation alpha at the face center
 4830:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 4831: 
 4832:                      cff1 += veg_alpha_sd*dt*vmag;
 4833: 
 4834:                   } // if (zTopCanopy
 4835:                } // if iveg
 4836: 
 4837:                const double tmp = dt*dfz/dzz;
 4838:                cupp[kin] += cff1*dzz/6.0 - tmp;
 4839:                bdia[kin] += cff1*dzz/3.0 + tmp;
 4840: printf("####cff1 = %f, dzz = %f, tmp = %f, cupp[%d] = %f, bdia[%d] = %f\n", cff1, dzz, tmp, cupp[kin], kin, bdia[kin]);               
 4841:             }
 4842: 
 4843: 
 4844:             // Second part: layers k-1, k
 4845:             if (k > kb + 1) {
 4846: 
 4847:                double cff1 = 1.0; //init \bar{c^k}
 4848: 
 4849:                if constexpr(iveg != 0) {
 4850:                   // If there is vegetation at this level...
 4851:                   if (zTopCanopy > side->zc[k-1]) {
 4852:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 4853:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 4854: 
 4855:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 4856: 
 4857:                      const double vmag2 = length(ut2);
 4858:                      const double vmag1 = length(side->u2[k-1]);
 4859:                      const double vmag = 0.5*(vmag1 + vmag2);
 4860: 
 4861:                      // Computes the vegetation alpha at the face center
 4862:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 4863:                      cff1 += veg_alpha_sd*dt*vmag;
 4864:                   } // if zTopCanopy
 4865: 
 4866:                } // if iveg
 4867: 
 4868:                const double tmp = dt*dfz/dzz;
 4869:                alow[kin] += cff1*dzz/6.0 - tmp;
 4870:                bdia[kin] += cff1*dzz/3.0 + tmp;
 4871: printf("####cff1 = %f, dzz = %f, tmp = %f, alow[%d] = %f, bdia[%d] = %f\n", cff1, dzz, tmp, alow[kin], kin, bdia[kin]);               
 4872:             } else { // Bottom boundary
 4873:                // This occurs at the bottom, where the bottom drag is applied.
 4874: 
 4875:                bdia[kin] += dt*side->chi2;
 4876: printf("####3 k = %d, kb + 1 = %d, nvrt - 1 = %d, chi2 = %f, alow[%d] = %f, bdia[%d] = %f\n", k, kb + 1, nvrt - 1, side->chi2, kin, alow[kin], kin, bdia[kin]);               
 4877:             } // if (k > kb + 1)
 4878: 
 4879: 
 4880: 
 4881:          } // for (int k
 4882: 
 4883: 
 4884: 
 4885:          // Computes the RHS.
 4886:          // -----------------
 4887: 
 4888:          //	BC to be imposed at the end.
 4889: 
 4890:          const Vector2 gradETP  = side->gradETP;
 4891:          const Vector2 gradPr   = side->gradPr;
 4892:          const Vector2 gradEta1 = side->gradEta1;
 4893:          const Vector2 gradEta2 = side->gradEta2;
 4894: 
 4895:          const Vector2 *btu = side->btu;
 4896:          const Vector2 *u2  = side->u2;
 4897:          const double coriolis = side->coriolis;
 4898:          const Vector2 *d2uv = side->d2uv;
 4899: 
 4900: 
 4901:          for (int k = kb + 1; k<nvrt; k++) {
 4902:             const int kin = k - kb;
 4903: 
 4904:             const double dz_0 = side->Dz(k);
 4905:             const double dz_1 = side->Dz(k+1);  
 4906: 
 4907:             rrhs[kin] = {0.0, 0.0};
 4908:             double dz = 0.0;
 4909: 
 4910:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 4911:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 4912:             if (k < nvrt  ) dz += 0.5*dz_1;
 4913:             if (k > kb + 1) dz += 0.5*dz_0;
 4914: 
 4915:             // Elevation gradient, atmospheric pressure and tidal potential
 4916:             rrhs[kin] = -dz*dt*(grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0);
 4917: 
 4918:             // Coriolis, advection, wind stress, and horizontal viscosity
 4919:             if (k < nvrt - 1) {
 4920: 
 4921: 
 4922:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 4923:                                           (dt*coriolis)*rot90(2.0*u2[k] + u2[k + 1]) + 
 4924:                                           dt*(2.0*d2uv[k] + d2uv[k + 1]));
 4925: 
 4926:                //diff stress tensors 1006
 4927:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 4928:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 4929:                   assert(false && "Not implemented: itur == 5");
 4930:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 4931:                }
 4932: 
 4933:             } else { // k=nvrt
 4934:                Vector2 tau2 = {0.0, 0.0};
 4935:                if constexpr(ics==1) {
 4936:                   tau2 = side->tau();
 4937:                } else {
 4938:                   assert(false && "Not implemented: ics == 2");
 4939:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4940:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4941:                   // taux2=(vn1+tt1)*0.5d0
 4942:                   // tauy2=(vn2+ss1)*0.5d0
 4943:                } // if ics
 4944: 
 4945:                rrhs[kin] += dt*tau2;
 4946: 
 4947:             } // if k<nvrt
 4948: 
 4949:             if (k > kb + 1) {
 4950:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 4951:                                        (dt*coriolis)*rot90(2.0*u2[k] + u2[k - 1]) + 
 4952:                                        dt*(2.0*d2uv[k] + d2uv[k - 1]));
 4953: 
 4954: 
 4955:                // diff stress tensors 1006
 4956:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 4957:                   assert(false && "Not implemented: itur == 5");
 4958:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 4959:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 4960:                }
 4961: 
 4962:             } // if k>kbs + 1
 4963: 
 4964:             // Baroclinic
 4965:             Vector2 *bcc = side->bcc;
 4966:             if constexpr(ibc == 0) {
 4967:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 4968:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 4969: 
 4970:             } // if ibc==0
 4971: 
 4972: 
 4973:          } // k=kb + 1,nvrt
 4974: 
 4975:    printf("#### bdia[0] = %f, bdia[1] = %f, bdia[2] = %f, bdia[3] = %f\n", bdia[0], bdia[1], bdia[2], bdia[3]);         
 4976:    // tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4977:          tridag_sch<2>(nvrt, alow, bdia, cupp, (double *)rrhs, (double *)u, (double *)gam);
 4978: 
 4979:          for (int k=kb + 1; k<nvrt; k++) {
 4980:             const int kin = k - kb;
 4981: 
 4982:             // Velocity is always clamped to maximum values
 4983:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvel1, rmaxvel1), clamp(soln[kin].y, -rmaxvel2, rmaxvel2));
 4984:          } // k
 4985: 
 4986:       } // if side->is2D()
 4987:       
 4988: 
 4989:       // Impose velocity boundary conditions at the bottom
 4990:       if constexpr(imm == 2) { // 3D bed deformation model
 4991:          double dep;
 4992:          Vector2 vel;
 4993: 
 4994:          assert(false && "Not implemented: imm == 2");
 4995:          //update_bdef(time, x0, y0, dep, vel);
 4996:          // side->u2[kb] = vel;
 4997: 
 4998:       } else { // imm = 0 or 1
 4999:          if (side->Cd() == 0.0) {
 5000:             side->u2[kb] = side->u2[kb + 1];
 5001:          } else if (nvrt > kb + 1) { // 3D no slip bottom
 5002:             side->u2[kb] = {0.0, 0.0};
 5003:          }
 5004:           
 5005:       } // if imm
 5006: 
 5007:       // XXX aren't we undoing what was done here: for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 5008:       for (int k=0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 5009:       
 5010: 
 5011:    }
 5012: 
 5013: 
 5014:    __device__ void applyMomentumBC(void) {
 5015: 
 5016:       SIDE_BND(sideBnd);
 5017: 
 5018:       Side *side = sideBnd->side;
 5019:       const BoundarySegment *segment = sideBnd->segment;
 5020:       const Node *n1 = side->n1;
 5021:       const Node *n2 = side->n2;
 5022: 
 5023:       // REMEMEBER, this is a trick, segment can be a pointer or (-1, -2)
 5024:       const bool isLand     = (segment == (BoundarySegment *)landSegment);
 5025:       const bool isInternal = (segment == (BoundarySegment *)internalSegment);
 5026: 
 5027:       assert(!isInternal && "applyMomentumBC: Shouldn't be an internal side");
 5028:       const int kb = side->kb;
 5029: 
 5030:       if (!isLand && segment->ifltype != 0) {
 5031:          const Vector2 *ubc = sideBnd->ubc;
 5032: 
 5033:          for (int k=kb; k < nvrt; k++) {
 5034:             
 5035:             assert(segment->ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5036:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5037: 
 5038:             if (segment->ifltype == -1) {
 5039:                // Flather 1
 5040: 
 5041:                const double depth = side->depth();
 5042: 
 5043:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5044: 
 5045:                const double vnorm = sqrt(grav/depth)*(side->eta2() - side->etaMeanBnd()) + dot(ubc[k], side->n);
 5046: 
 5047:                side->u2[k] = vnorm*side->n;
 5048: 
 5049:             } else if (segment->ifltype == -2) { // Discharge
 5050: 
 5051: 
 5052:                const double eta1 = side->eta1();
 5053:                const double eta2 = side->eta2();
 5054:                const double htot = side->htot2();
 5055: 
 5056:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5057:                assert(false && "Not implemented: Discharge bc");
 5058:                // const double dischrg = discharge(eta1);
 5059:                const double dischrg = 0.0; // XXX REMOVE
 5060:                
 5061: 
 5062:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5063: 
 5064:                const double vnorm = dischrg*eta2/htot;
 5065: 
 5066:                side->u2[k] = vnorm*side->n;
 5067: 
 5068: 
 5069:             }
 5070:             else if (segment->ifltype == -4 || segment->ifltype == -5) { // 3D radiation
 5071:                const double vnorm = dot(side->u2[k], side->n);
 5072: 
 5073:                double rat;
 5074:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5075:                else              rat = segment->vobc2; // outgoing
 5076: 
 5077:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5078:             }
 5079:             else { // not Flather or 3D radiation
 5080:                side->u2[k] = ubc[k];
 5081: 
 5082:             } // if (segment->ifltype...
 5083: 
 5084:          }
 5085: 
 5086:       }
 5087:       else if (isLand) { // land bnd
 5088:          if constexpr(islip == 0) { // free slip
 5089:             for (int k=kb; k < nvrt; k++) {
 5090:                double vnorm = 0.0; // for most cases
 5091:                const double vtan = dot(side->u2[k], side->t());
 5092:                side->u2[k] = vtan*side->t() - vnorm*side->n;
 5093:             }
 5094: 
 5095:          } else { // no slip
 5096:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5097: 
 5098:          }
 5099:       } // if (side segment type...
 5100: 
 5101:       
 5102: 
 5103: 
 5104: 
 5105:    }
 5106: 
 5107: 
 5108:    __device__ void shapiroFilter1(void) {
 5109:       // First step of the Shapiro filter (normally used if indvel<=0)
 5110:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5111: 
 5112:       if constexpr(ishapiro == 0) return;
 5113: 
 5114:       SIDE(side);
 5115: 
 5116:       const bool isInternal = (side->sideBnd->segment == (BoundarySegment *)internalSegment);
 5117: 
 5118:       if (side->isDry || isInternal ) return;
 5119: 
 5120:       const int kb = side->kb;
 5121: 
 5122:       for (int mm = 1; mm <= niter_shap; mm++) {
 5123: 
 5124: 
 5125:          // Internal wet sides
 5126:          for (int k = kb + 1; k < nvrt; k++) {
 5127:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5128:             side->bcc[k] = {0.0, 0.0};
 5129:             Vector2 suru = {0.0, 0.0};
 5130: 
 5131:             for (int j=0; j<4; j++) {
 5132: 
 5133:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5134:                
 5135:                int kin = k;
 5136:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5137:                
 5138:                if constexpr(ics==1) {
 5139:                   suru += side->u2[kin];
 5140:                } else {
 5141:                   assert(false && "Not implemented: ics == 2");
 5142:                   // Vector2 vn1, vn2;
 5143:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5144:                   // suru=suru+vn1;
 5145:                   // surv=surv+vn2;
 5146:                }
 5147:             }
 5148: 
 5149:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5150: 
 5151:          }
 5152:       }
 5153:    }
 5154: 
 5155:    __device__ void shapiroFilter2(void) {
 5156:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5157: 
 5158:       if constexpr(ishapiro == 0) return;
 5159: 
 5160:       SIDE(side);
 5161: 
 5162:       const bool isInternal = (side->sideBnd->segment == (BoundarySegment *)internalSegment);
 5163: 
 5164:       if (side->isDry || isInternal ) return;
 5165: 
 5166:       const int kb = side->kb;
 5167: 
 5168:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5169: 
 5170:       if (side->is2D()) {
 5171:          side->u2[kb] = side->u2[nvrt - 1];
 5172:          
 5173:       } else {
 5174:          // 3D
 5175:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5176:          
 5177:       }
 5178: 
 5179:    }
 5180: 
 5181: 
 5182:    __global__ void ul0UpdateZCoords(void) {
 5183:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5184:       
 5185:       NODE(node);      
 5186: 
 5187:       if (node->isDry2()) { 
 5188: 
 5189:          assert((ivcor != 2) && (node->depth < mesh->h_s) && "Deep depth dry");
 5190: 
 5191:          if constexpr(ivcor != 1) node->kb = 0;
 5192: 
 5193:       } else {
 5194: 
 5195:          node->updateKb();
 5196:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5197: for (int k = node->kb; k < nvrt; k++) printf("k = %d, node->kb = %d, node->z[k] = %f\n", k, node->kb, node->z[k]);
 5198: 
 5199:       } // if wet or dry
 5200: 
 5201:       // We use the temp.b field to store the previous state of isDry.
 5202:       node->tmp.b = node->isDry;
 5203: 
 5204:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5205:       node->isDry = true;
 5206: 
 5207:    }
 5208: 
 5209:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5210:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5211:    {
 5212:       ELEM(elem);
 5213: 
 5214:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5215: 
 5216:       // All the nodes of a wet element are wet.
 5217:       if (!elem->isDry) {
 5218:          elem->nodes[0]->isDry = false;
 5219:          elem->nodes[1]->isDry = false;
 5220:          elem->nodes[2]->isDry = false;
 5221:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 5222: 
 5223:       }
 5224: 
 5225: 
 5226:       elem->kb = 0;
 5227: 
 5228:       if (elem->isDry) return;
 5229: 
 5230:       // Wet
 5231:       const Node *n1 = elem->nodes[0];
 5232:       const Node *n2 = elem->nodes[1];
 5233:       const Node *n3 = elem->nodes[2];  
 5234:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5235: 
 5236:    //    if(elem->isDry2()) {
 5237:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5238:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5239:    //        call parallel_abort(errmsg)
 5240:    //    }
 5241: 
 5242: 
 5243:       // Computes element's kb as the minimum of the nodes' kb.
 5244:       const int kb1 = n1->kb;
 5245:       const int kb2 = n2->kb;
 5246:       const int kb3 = n3->kb;
 5247:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5248: 
 5249: printf("kb1 = %d, kb2 = %d, kb3 = %d, kb4 = %d\n", kb1, kb2, kb3, kb4);
 5250: 
 5251:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5252: 
 5253: 
 5254:       // Computes the element z as the mean of the nodes z.
 5255:       for (int k = elem->kb; k < nvrt; k++) {
 5256: 
 5257:          // Compute the element z as the mean of the nodes z.
 5258:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5259:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5260:          elem->z[k] /= elem->i34;
 5261: 
 5262:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5263:       }
 5264:                   
 5265:    }
 5266: 
 5267:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5268:    {
 5269:       NODE(node);
 5270:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5271: 
 5272:       if (it == iths) return;
 5273: 
 5274: 
 5275:       if(!node->isDry && node->tmp.b) { // rewetted
 5276:          for (int k=0; k < nvrt; k++) {
 5277: 
 5278:             Vector3 utmp={0.0, 0.0, 0.0};
 5279: 
 5280:             double ttmp=0.0;
 5281:             double stmp=0.0;
 5282:             int icount=0;
 5283:             for (int j = 0; j < node->numNodes; j++) {
 5284: 
 5285: 
 5286:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5287:                if (!node->isDry) { // all indices extended
 5288:                   icount++;
 5289: 
 5290:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5291:                   utmp += node->u2[k];
 5292:                   
 5293:                   ttmp += node->tracers[k].tracer[0]; 
 5294:                   stmp += node->tracers[k].tracer[1]; 
 5295:                }
 5296:             }
 5297: 
 5298:             if(icount > 0) {
 5299:                const double inv_icount = 1.0/icount;
 5300:                node->u2[k]     = inv_icount*utmp;
 5301:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5302:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5303:             }
 5304:          }
 5305:       }
 5306:    }
 5307: 
 5308: 
 5309:    __global__ void ul0UpdateSides(int it, int iths) {
 5310: 
 5311:       SIDE(side);
 5312: 
 5313:       // A side is wet if and only if at least one of its elements is wet.
 5314:       const bool isWet = !side->elems[0]->isDry || (!side->isBnd2() && !side->elems[1]->isDry);
 5315: 
 5316:       const Node *n1 = side->n1;
 5317:       const Node *n2 = side->n2;
 5318:       const int kb1 = n1->kb;
 5319:       const int kb2 = n2->kb;
 5320: 
 5321:       side->kb = 0; // dry
 5322: 
 5323:       if (isWet) {
 5324: 
 5325:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5326: 
 5327:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5328: 
 5329:          side->kb = min(kb1, kb2);
 5330: 
 5331:          for (int k = side->kb; k < nvrt; k++) {
 5332:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5333: 
 5334:          
 5335:             assert((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0) && "Weird side (3)");
 5336: 
 5337:             // Compute velocity for re-wetted sides 
 5338:             if ((it != iths) && (side->isDry && isWet)) {
 5339:             
 5340:                Vector2 utmp={0.0, 0.0};
 5341: 
 5342:                int icount=0;
 5343: 
 5344:                // For all the sides on the two elements that share this side
 5345:                for (int j=0; j < 2; j++) {
 5346:                   const Element *elem = side->elems[j];
 5347:                   if (elem == nullptr) continue;
 5348: 
 5349:                   for (int jj=0; jj < elem->i34; jj++) {
 5350:                      const Side *nSide = elem->sides[jj];
 5351:                      if (nSide->isDry) continue;
 5352: 
 5353:                      icount++;
 5354:                      utmp += nSide->u2[k];                     
 5355:                   }
 5356:                }
 5357:                   
 5358:                assert(icount > 0 && "No wet sides around this side");
 5359:                if (icount > 0)  side->u2[k] = utmp/icount;
 5360:                   
 5361:             } // if ((it != iths) && (side->isDry && isWet))
 5362: 
 5363:          } // for k
 5364: 
 5365:       } // if isWet
 5366:    
 5367:       side->isDry = !isWet;
 5368: 
 5369:    }
 5370: 
 5371: 
 5372:    __global__ void zeroNodalVelocities(void) {
 5373:       NODE(node);
 5374: 
 5375:       for (int k = 0; k < nvrt; k++) {
 5376:          node->u2[k] = {0.0, 0.0, 0.0};
 5377:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5378:       }
 5379:    }
 5380: 
 5381:    __global__ void computeNodalVerticalVelocities1(void) {
 5382:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5383:    // Adds the element's vertical velocity times the element's area.
 5384:       ELEM(elem);
 5385: 
 5386:       for (int j = 0; j < elem->i34; j++) {
 5387:          Node *node = elem->nodes[j];
 5388: 
 5389:          for (int k = node->kb; k < nvrt; k++) {
 5390:             node->u2[k].z += elem->w[k]*elem->area;
 5391:             node->tmp.d += elem->area;
 5392:          }
 5393:       }
 5394:    }
 5395: 
 5396:    __global__ void computeNodalVerticalVelocities2(void) {
 5397:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5398:    // Divides by the total area of the elements sharing the    node.
 5399:       ELEM(elem);
 5400: 
 5401:       for (int j = 0; j < elem->i34; j++) {
 5402:          Node *node = elem->nodes[j];
 5403: 
 5404:          for (int k = node->kb; k < nvrt; k++) node->u2[k].z /= node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5405:       }
 5406:    }
 5407: 
 5408:    __global__ void computeNodalHorizontalVelocities(void) {
 5409:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 5410:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 5411:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 5412: 
 5413:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 5414: 
 5415:       SIDE(side);
 5416: 
 5417:       const int kb = side->kb;
 5418: 
 5419:       Node *n1 = side->n1;
 5420:       Node *n2 = side->n2;
 5421: 
 5422:       for (int k = kb; k < nvrt; k++) {
 5423: 
 5424:          // Cast the u2 vector into a Vector2 
 5425:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&n1->u2[k]);
 5426:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&n2->u2[k]);
 5427: 
 5428:          n1_u2 += side->u2[k]/n1->numSides;
 5429:          n2_u2 += side->u2[k]/n2->numSides;
 5430: 
 5431:       }
 5432: 
 5433: 
 5434:    }
 5435: 
 5436:    __global__ void resetVelocityOpenBndNodes(void) {
 5437:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 5438: 
 5439:       NODE_BND(nodebnd);
 5440: 
 5441:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 5442:          for (int k = 0; k < nvrt; k++) nodebnd->node->u2[k] = {0.0, 0.0, 0.0};
 5443:       }
 5444: 
 5445:    }
 5446: 
 5447: 
 5448:    __global__ void setVelocityOpenBndNodes(void) {
 5449:    // For open boundary nodes sets their velocity to the imposed values.
 5450: 
 5451:       SIDE_BND(sidebnd);
 5452: 
 5453:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 5454:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 5455:          // to its segment to the average of the side velocity.
 5456: 
 5457:          for (int k = 0; k < nvrt; k++) {
 5458:             Node *n1 = sidebnd->side->n1;
 5459:             Node *n2 = sidebnd->side->n2;
 5460: 
 5461:             // Cast the u2 vector into a Vector2 
 5462:             Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&n1->u2[k]);
 5463:             Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&n2->u2[k]);
 5464: 
 5465:             if (n1->nodeBnd->segment == sidebnd->segment) n1_u2 += sidebnd->side->u2[k]/n1->nodeBnd->numSidesForAverage();
 5466:             if (n2->nodeBnd->segment == sidebnd->segment) n2_u2 += sidebnd->side->u2[k]/n2->nodeBnd->numSidesForAverage();
 5467:          }
 5468:       }
 5469: 
 5470:    }
 5471: 
 5472: 
 5473:    __global__ void computeVerticalVelocity(void) {
 5474:       // Computes the vertical velocity at the (2D) element's centroid.
 5475:       // In this function we will be considering volumetric elements, with side faces and a 
 5476:       // bottom and a top face. We will call them SFs, BF and TF.
 5477:       // It computes the flux coming from BF and the SFs.
 5478:       // If the bed is moving, it takes that into account.
 5479:       // Since water is incompressible, the integral of the velocity times the normal vector
 5480:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 5481:       // and the BF is equal to the flux going out from the TF.
 5482:       // TF = - BF - sum(SFs).
 5483:       // It then computes the horizontal velocity at the center of TF.
 5484:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 5485:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 5486:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 5487: 
 5488:       ELEM(elem);
 5489: 
 5490:       if (elem->isDry) return;
 5491: 
 5492:       const int kb = elem->kb;
 5493:       const bool isTri = elem->isTri();
 5494: 
 5495:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 5496: 
 5497:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 5498:       const double av_bdef1 = elem->mean(&Node::bdef1);
 5499:       const double av_bdef2 = elem->mean(&Node::bdef2);
 5500: 
 5501:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 5502: 
 5503:       double area3D;
 5504: 
 5505:       // Bottom face flux
 5506:       double bottomFlux = 0.0;
 5507:       Vector2 u2meanBottom = {0.0, 0.0};
 5508:       const Vector2 gradh = elem->grad2(&Node::depth);
 5509:       if constexpr(imm==2) {
 5510:          Vector3 ubed;
 5511: 
 5512:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 5513:          // updateBDEF(ubed);
 5514:      
 5515:          // const double bflux0 = dot(ubed, elem_n1);
 5516: 
 5517:          // elem->w[kb] += ubed.z;
 5518:       }
 5519:       else {
 5520:          Vector2 umean;
 5521:          if constexpr(ics == 1) {
 5522:             u2meanBottom = elem->mean(kb, &Side::u2);
 5523:          }
 5524:          else {
 5525:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 5526:          }
 5527: 
 5528:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 5529:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 5530: 
 5531:          bottomFlux = - dot(gradh, u2meanBottom);
 5532:       } // if imm
 5533: 
 5534:       // Compute w for kb+1 to nvrt-1
 5535:       for (int l = kb; l < nvrt - 1; l++) {
 5536: 
 5537:          // normal vector to the top face of the "volumetric" element (3D)
 5538:          Vector3 elem_n2 = elem->n(l + 1, area3D); 
 5539: 
 5540:          // Compute the total flux at the sides
 5541:          double sideFlux = 0.0;
 5542:          Vector2 u2top = {0.0, 0.0};
 5543:          for (int j = 0; j < elem->i34; j++) {
 5544:             const Side *side = elem->sides[j];
 5545: 
 5546:             const double sideArea = side->area(l + 1);
 5547:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 5548:             const double sign = elem->ssign[j]; 
 5549: 
 5550:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 5551:          }
 5552:          
 5553:          // Compute the horizontal velocity at the center of the top face as an average of the 
 5554:          //velocities at the centers of the sides
 5555:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 5556: 
 5557:          // The flx at the top ace can be computed from the other flows.
 5558:          const double topFlux = - sideFlux - bottomFlux;
 5559:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 5560: 
 5561:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 5562: printf("sideFlux = %f, topHorizontalFlux = %f, bottomFlux = %f, area3D = %f, elem->w[%d] = %.16f, elem_n2.z = %f\n", sideFlux, topHorizontalFlux, bottomFlux, area3D, l + 1, elem->w[l + 1], elem_n2.z);
 5563:          elem_n1 = elem_n2;
 5564: 
 5565:          bottomFlux = - topFlux;
 5566:       }
 5567:    }  
 5568: 
 5569: 
 5570: 
 5571: 
 5572: 
