 1797: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o') {
 1798: // return;   
 1799:    // Lock the mutex
 1800:    lock(&debugPlotMutex);
 1801:  
 1802:    bool ok = true;
 1803:    if (debugPlotIdx == nullptr) ok = false;
 1804:    if (*debugPlotIdx >= 10000) ok = false;
 1805:    if (ok) {
 1806:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1807:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1808:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1809:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1810:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1811:       debugPlot[(*debugPlotIdx) + 5*10000] = (double)marker;
 1812:       (*debugPlotIdx)++;
 1813:    }
 1814: 
 1815:    __threadfence();               // ensure all above writes are visible
 1816:    // Unlock the mutex
 1817:    unlock(&debugPlotMutex);
 1818: 
 1819: }
