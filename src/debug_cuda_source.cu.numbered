 3353: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3354: 
 3355: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3356:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3357:    if constexpr(ics == 1) { 
 3358:       return 0.5*(n1->tau + n2->tau);
 3359: 
 3360:    } else {
 3361:       // Project the tau from the node frames to the side frame
 3362:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3363:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3364: 
 3365:       return 0.5*(stau1 + stau2);
 3366:    }
 3367: }
 3368: 
 3369: /**
 3370:  * This method performs backtracking from the side center until a time -dt back in time 
 3371:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3372:  * intermediate point.
 3373:  *
 3374:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3375:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3376:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3377:  * remaining time.
 3378:  * 
 3379:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3380:  * 
 3381:  * @param uuint, vvint, wwint: Velocities at the final point
 3382:  * @param jlev: Level at which the backtracking is performed
 3383:  * @param dt, dtbk: Tracking timesteps
 3384:   */
 3385: __inline__ __device__ void Side::btrack(
 3386:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3387:       double dt,            // Tracking time
 3388:       double dtbk,          // Tracking timestep
 3389:       Vector3 &u_int        // Velocities at the initial point
 3390: ) const {
 3391: 
 3392:    // Start from side center
 3393:    Point3 x0;
 3394: 
 3395:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3396:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3397: 
 3398:  
 3399:    double time_rm = dt; // Remaining time
 3400:    double time_rm_1 = 1e10;
 3401:    double time_rm_2 = 2e10;
 3402:    double time_rm_3 = 3e10;
 3403: 
 3404: 
 3405:    // Initial velocities
 3406:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3407: 
 3408:    // Find a non dry element for starting the backtracking. At this point there should be at least one.
 3409:    Element* curElem = (!elems[0]->isDry) ? elems[0] : elems[1];  // elems[0] is always non-null 
 3410: 
 3411:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3412: 
 3413: // showPoints(x0, x0, jlev, this, 0xFF0000u, 'x', 1, 0, 0);
 3414: 
 3415: 
 3416:    constexpr int MAX_ITERATIONS = 100; 
 3417:    int iter = 0;
 3418:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3419:    while(true) {
 3420: 
 3421:       // Calculate timestep
 3422:       const double dtb = min(dtbk, time_rm);
 3423: 
 3424: // if (iter >= 38) printf("AAAAA iter = %d, curElem->idx = %d, x0 = (%.17f, %.17f, %.17f), time_rm = %.17f, dtb = %.17f, dtbk = %.17f, u_int = (%.17f, %.17f, %.17f)\n", iter, curElem->idx, x0.x, x0.y, x0.z, time_rm, dtb, dtbk, u_int.x, u_int.y, u_int.z);
 3425: 
 3426:       // Next point in the backtracking curve
 3427:       xt = x0 - dtb*u_int;
 3428: // if (jlev == 48 && idx == 1603507)   showPoints(x0, xt, jlev, this, 0xFFFF00u, 'x', 1, 0, 0);
 3429: // // showPoints(x0, xt, jlev, this, 0xFF00FFu, 'o', 1, 15, iter);
 3430: // // if ((jlev==45)) printf("jlev = %d, iter = %d, x0 = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f)\n", jlev, iter, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z);
 3431: // if ((jlev==45))
 3432: // {
 3433: // // const Point3 p1 = toLocalFrame(x0);
 3434: // // const Point3 p2 = toLocalFrame(xt);
 3435: // // printf("jlev = %d, iter = %d, p1 = (%.17f, %.17f, %.17f), p2 = (%.17f, %.17f, %.17f)\n", jlev, iter, p1.x, p1.y, p1.z, p2.x, p2.y, p2.z);
 3436: // showPoints(x0, xt, jlev, this, 0x0000FFu, 'o', 1, 0, 0); 
 3437:     
 3438: // }
 3439: 
 3440:       double t, s; // parameters for the line segments p0pt and p1p2
 3441:       Side *lastCrossSide = nullptr;
 3442:       const bool found = celestialWalk(curElem, x0, xt, this, lastCrossSide, jlev);
 3443: 
 3444: 
 3445: // if (iter >= 38) printf("BBBBB idx = %d, jlev = %d, lastCrossSide->idx = %d, x0 = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f), iter = %d, curElem->idx = %d, time_rm = %.17f, dtb = %.17f, dtbk = %.17f, u_int = (%.17f, %.17f, %.17f)\n", idx, jlev, lastCrossSide->idx, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z, iter, curElem->idx, time_rm, dtb, dtbk, u_int.x, u_int.y, u_int.z);
 3446: 
 3447:       if (time_rm_3 <= time_rm) {
 3448:       // If backtracking gets stuck, we stop the backtracking and use the velocity at the last x0.
 3449:          xt = x0;
 3450:          break;
 3451:       }
 3452: 
 3453: 
 3454:       if (!found) {
 3455:       // This means that the walk reached a boundary or a dry element.
 3456: 
 3457:          assert(lastCrossSide!=nullptr && "lastCrossSide is nullptr");
 3458: 
 3459:          // Finds the point at the boundary where the line segment x0xt intersects.
 3460:          // Here we will assume that it does intersect the boundary segment, even if in some cases,
 3461:          // due to floating point errors, it does not exactly intersect.
 3462:          // We call p1 and p2 the 2D points of the boundary segment. p0, pt are the 2D versions of x0 and xt.
 3463:          // v1 is the vector from p0 to pt, v2 is the vector from p1 to p2.
 3464:          // To compute the intersection point we start with the parametric equations.
 3465:          // p1 + t*v2 = p0 + s*v1,    t, s in [0,1]
 3466:          // We cross-prouct by v1 to cancel the s term:
 3467:          // cross(v2, v1)*t = cross(p0 - p1, v1)
 3468:          // t = cross(p0 - p1, v1) / cross(v2, v1)
 3469: 
 3470:          // Side coordinates in the origSide frame.
 3471:          const Point2 p1 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n1->p, lastCrossSide->n1->gz)));
 3472:          const Point2 p2 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n2->p, lastCrossSide->n2->gz)));
 3473: 
 3474:          Point2  p0 = {x0.x, x0.y};
 3475:          Point2  pt = {xt.x, xt.y};
 3476: 
 3477:          const Vector2 v1 = pt - p0;
 3478:          const Vector2 v2 = p2 - p1;
 3479: 
 3480: 
 3481: 
 3482:          // We are assuming intersection, so we clamp t to the range [0,1].
 3483:          const double denom = cross(v2, v1);
 3484:          
 3485: 
 3486: 
 3487: 
 3488:          if (abs(denom) < small) {
 3489:             // small denominators are fairly common. They occur when the line segment x0xt 
 3490:             // is parallel to the boundary segment. This occurs after a "collision" with the
 3491:             // boundary, where the backtracking curve startt sliding along the boundary.
 3492:             // In this case, we simply assume that the two lines are very close to each other
 3493:             // and simply compute the closest point to xt (s = 1.0) on the boundary segment (clamped to p1p2)
 3494:             t = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3495:             if (t<0.0000000001) t = 0.0;
 3496:             if (t>0.9999999999) t = 1.0;
 3497: 
 3498:             // s = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3499:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3500: 
 3501:          }
 3502:          else {
 3503:             
 3504:             t = clamp(cross(p0 - p1, v1) / denom, 0.0, 1.0);
 3505:             if (t<0.0000000001) t = 0.0; // XXXXX use constants
 3506:             if (t>0.9999999999) t = 1.0;
 3507:             // From the originaL equation we can solve for s:
 3508:             // p1 + t*v2 = p0 + s*v1    =>   s*v1 = p1 + t*v2 - p0 
 3509:             // Computing the dot product by v1, we get:
 3510:             // s = dot((p1 + t*v2 - p0), v1) / dot(v1, v1)
 3511:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3512:             if (s<0.0000000001) s = 0.0; // XXXXX use constants
 3513: 
 3514:          }
 3515: 
 3516:          
 3517:          // else printf("AAAAAAA idx = %d, jlev = %d, t = %.17f, denom = %.17f\n", idx, jlev, t, denom);
 3518:          assert(curElem!=nullptr && !curElem->isDry && "curElem is nullptr or dry");
 3519: 
 3520: 
 3521: 
 3522:          // We update the new target point to be right at the intersection point,
 3523:          // and the remaining time must include the time we haven't "used".
 3524:          time_rm -= s*dtb;
 3525:          xt = toPoint3(p1 + t*v2, x0.z + s*(xt.z - x0.z)); // I use p1,p2 to compute the intersection point to ensure that it is on the boundary, but the z-coordinate is the same as x0.z
 3526: 
 3527: // Point3 xct = {curElem->center.x, curElem->center.y, curElem->centerZ()};
 3528: // xct = toLocalFrame(xct);
 3529: // xt = (1-0.00001)*xt + 0.00001*xct;
 3530:          // If it is an open boundary, just exits the loop. No sliding along the boundary is performed.
 3531:          if (lastCrossSide->sideBnd!=nullptr && !lastCrossSide->sideBnd->segment->isLand) break;
 3532: 
 3533:          // If it is not an open boundary, the velocity for the next step is computed by interpolating the velocities at the intersection point.
 3534:          // but extracting only the component along the tangent vector v2.
 3535:          Vector2 tangent = normalize(v2);
 3536:          const Vector3 u = curElem->interpolateVelocities(xt, this);
 3537: 
 3538:          const Vector2 u2D = make_double2(u.x, u.y);
 3539:          u_int = toVector3(dot(u2D, tangent)*tangent, u.z);
 3540: 
 3541: 
 3542:       } else {
 3543: 
 3544:          assert(curElem!=nullptr && !curElem->isDry && "Final element is dry or boundary side");
 3545: 
 3546:          time_rm -= dtb; 
 3547: 
 3548:          u_int = curElem->interpolateVelocities(xt, this);
 3549: 
 3550:       }
 3551: 
 3552:       if (time_rm <= 0.0) break; 
 3553: 
 3554:       // If the velocity is too small, we stop the backtracking
 3555:       const double vmag2 = norm2(toVector2(u_int));
 3556:       if (vmag2 <= velmin_btrack_sq)  {
 3557: 
 3558:          time_rm = 0.0; 
 3559:          return; 
 3560:       }
 3561: 
 3562:       // The current point becomes the next segment's starting point.
 3563:       x0 = xt;
 3564:  
 3565:       iter++;
 3566: 
 3567: 
 3568:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3569: 
 3570:       assert(time_rm_3 > time_rm && "time_rm is not decreasing");
 3571:       time_rm_3 = time_rm_2;
 3572:       time_rm_2 = time_rm_1;
 3573:       time_rm_1 = time_rm;
 3574:    }
 3575: 
 3576:    assert(curElem != nullptr && "Final element is nullptr");
 3577:    assert(!curElem->isDry && "Final element is dry");
 3578:    
 3579: 
 3580: 
 3581:    // Interpolate the velocities at the final point with respect to the current side frame
 3582:    u_int = curElem->interpolateVelocities(xt, this);
 3583: 
 3584: 
 3585: }
 3586: 
 3587: 
