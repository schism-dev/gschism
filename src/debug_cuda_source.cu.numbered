 7847: //                 !!upwind part
 7848: //                 !if(k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)<0) then !inflow
 7849: //                 !  do jj=1,ntr
 7850: //                 !    adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*abs(flux_adv_hface(k,jsj))*(trel_tmp_outside(jj)-trel_tmp(jj,k,i))
 7851: //                 !  enddo
 7852: //                 !endif
 7853: //                 !!weno correction
 7854: //                 !if (iweno) then
 7855: //                 !  if(k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)<0) then !inflow
 7856: //                 !    do jj=1,ntr
