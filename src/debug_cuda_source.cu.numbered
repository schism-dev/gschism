 2493: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2494: 
 2495:    const double w1 = getBoundaryArrayValueWeight();
 2496:    const double w2 = 1.0 - w1;
 2497:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2498:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2499: 
 2500:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2501: }
