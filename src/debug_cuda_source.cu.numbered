 7992:                                  
 7993:   __global__ void populateMesh(int *i34, int *elnode, int *elside,
 7994:                    double *node_coords, double *node_coords_ll, bool use_ll,
 7995:                    double *wind_rotate_angle,  int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 7996:                    int *isdel, int *isidenode, int *isbnd,
 7997:                    int *nond, int *nlnd, int *iond, int *ilnd, 
 7998:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 7999:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 8000:                    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 8001:                    int *localNodeIndices, int *localElemIndices, int *localSideIndices,
 8002:                    int *localNodePart,    int *localElemPart,    int *localSidePart,
 8003:                    double *drag, double *roughness,
 8004:                    double *emo, double *efa, 
 8005:                    double *umo, double *ufa, 
 8006:                    double *vmo, double *vfa) {
 8007: 
 8008:     mesh->populateMesh(i34, elnode, elside, node_coords, node_coords_ll, use_ll, wind_rotate_angle, 
 8009:                        sharedIdxNodeBoundary, sharedIdxSideBoundary,
 8010:                        isdel, isidenode, isbnd,
 8011:                        nond, nlnd, iond, ilnd, 
 8012:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 8013:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 8014:                        globalNodeIndices, globalElemIndices, globalSideIndices,
 8015:                        localNodeIndices, localElemIndices, localSideIndices,
 8016:                        localNodePart, localElemPart, localSidePart,
 8017:                        drag, roughness,
 8018:                        emo, efa, umo, ufa, vmo, vfa);  // XXXXX Remember to refactor this, removing the parameters that are not used.
 8019:   }
