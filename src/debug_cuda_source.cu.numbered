 7236: __global__ void getStructSizes(int* sizes)  {
 7237:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 7238:       sizes[0] = (int)sizeof(Node);
 7239:       sizes[1] = (int)sizeof(Element);
 7240:       sizes[2] = (int)sizeof(Side);
 7241:       sizes[3] = (int)sizeof(NodeBoundary);
 7242:       sizes[4] = (int)sizeof(SideBoundary);
 7243:       sizes[5] = (int)sizeof(BoundarySegment);
 7244: }
