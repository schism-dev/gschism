 3384: 
 3385: 
 3386:    // // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3387:    // const double fc   = 2.0*omega_e*sin(sfea0);
 3388:    // const double beta = 2.0*omega_e*cos(sfea0);
 3389: 
 3390:    nbs = *sharedIdxSideBoundary;
 3391:    nbp = *sharedIdxNodeBoundary;
 3392: 
 3393: return;
 3394: 
 3395:    int idxNodeBoundary = 0;  
 3396: // #ifdef popo      
 3397: //    for (int i = 0; i < np; i++)
 3398: //    {
 3399: // printf("NODE i = %d, np = %d\n", i, np);      
 3400: //       Node &node = localNodeData[i];
 3401: 
 3402: //       node.idx = i;
 3403: 
 3404: //       const int idxNodeStart = nodeNeighNodesStart[i];
 3405: //       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3406: //       node.numNodes = idxNodeEnd - idxNodeStart;
 3407: //       node.nodes = nodeNeighNodes + idxNodeStart;
 3408: //       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3409: 
 3410: 
 3411: 
 3412: //       const int idxElemStart = nodeNeighElemsStart[i];
 3413: //       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3414: //       node.numElements = idxElemEnd - idxElemStart;
 3415: //       node.elements = nodeNeighElems + idxElemStart;
 3416: 
 3417: 
 3418:       
 3419: //       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3420: //          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3421: //          const int partNode = localNodePart[idxNodeGlobal]; 
 3422: //          const int idxNode  = localNodeIndices[idxNodeGlobal];
 3423: 
 3424: 
 3425: //          Node *node_ptr = nodes[partNode] + idxNode;
 3426:          
 3427: //          nodeNeighNodes[idx] = node_ptr;
 3428: //       }
 3429: 
 3430: //       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3431: //          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3432: //          const int partElem = localElemPart[idxElemGlobal];
 3433: //          const int idxElem  = localElemIndices[idxElemGlobal];
 3434: 
 3435: //          Element *elem_ptr = elems[partElem] + idxElem;
 3436: 
 3437: //          nodeNeighElems[idx] = elem_ptr;
 3438: //       }      
 3439: 
 3440: 
 3441: //       node.wind_angle = wind_rotate_angle[i];
 3442: 
 3443: //       // Element **elements; // pointer to the elements connected to this node
 3444: //       // int numElements;   // number of elements shared by this node
 3445: 
 3446: //       node.p.x   = node_coords[i * 3];
 3447: //       node.p.y   = node_coords[i * 3 + 1];
 3448: //       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 3449: //       node.depth = node_coords[i * 3 + 2];
 3450: 
 3451: //       node.numSides = 0;
 3452: 
 3453: //       node.Cd = drag[i];
