 7171:    __global__ void resetVelocityOpenBndNodes(void) {
 7172:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 7173: 
 7174:       NODE_BND(nodebnd);
 7175: printf("DDDDDDDDDD\n");
 7176:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 7177:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 7178:       }
 7179: 
 7180:    }
