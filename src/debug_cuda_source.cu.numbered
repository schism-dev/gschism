 6872: //                 endif !iel
 6873: 
 6874: //                 !!upwind part
 6875: //                 !if(k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)<0) then !inflow
 6876: //                 !  do jj=1,ntr
 6877: //                 !    adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*abs(flux_adv_hface(k,jsj))*(trel_tmp_outside(jj)-trel_tmp(jj,k,i))
 6878: //                 !  enddo
 6879: //                 !endif
 6880: //                 !!weno correction
 6881: //                 !if (iweno) then
 6882: //                 !  if(k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)<0) then !inflow
 6883: //                 !    do jj=1,ntr
 6884: //                 !      adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*abs(flux_adv_hface(k,jsj))*(trsd_tmp(jj,k,jsj)-trel_tmp_outside(jj))
 6885: //                 !    enddo
 6886: //                 !  else if(k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)>=0) then !outflow
 6887: //                 !    do jj=1,ntr
 6888: //                 !      adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*abs(flux_adv_hface(k,jsj))*(trel_tmp(jj,k,i)-trsd_tmp(jj,k,jsj) )
 6889: //                 !    enddo
 6890: //                 !  endif !inflow or outflow
 6891: //                 !endif !if use weno
 6892: 
 6893: //                 !alternative formulation
 6894: //                 if (k>=kbs(jsj)+1) then
 6895: //                   if (iweno) then !weno
 6896: //                     do jj=1,ntr
 6897: //                       tmp=rk_coef(itd_weno)*dtb_by_bigv*( ssign(j,i)*(flux_adv_hface(k,jsj))*(trel_tmp(jj,k,i)-trsd_tmp(jj,k,jsj)) )
 6898: //                       adv_tr(jj)=adv_tr(jj)+tmp
 6899: //                       if (adv_tr(jj)<tr_min_max(1,jj) .or. adv_tr(jj)>tr_min_max(2,jj) ) then !reset to upwind
 6900: //                         adv_tr(jj)=adv_tr(jj)-tmp !reset to previous value
 6901: //                         if(ssign(j,i)*flux_adv_hface(k,jsj)<0.d0) then  !inflow 
 6902: //                           adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*abs(flux_adv_hface(k,jsj))*(trel_tmp_outside(jj)-trel_tmp(jj,k,i))
 6903: //                         endif
 6904: //                       endif
 6905: //                       !when ntd_weno=1, reduces to: adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*( ssign(j,i)*(flux_adv_hface(k,jsj))*(trel_tmp(jj,k,i)-trsd_tmp(jj,k,jsj)) )
 6906: //                     enddo
 6907: //                   else !upwind
 6908: //                     if(ssign(j,i)*flux_adv_hface(k,jsj)<0) then  !inflow 
 6909: //                       do jj=1,ntr
 6910: //                         adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*abs(flux_adv_hface(k,jsj))*(trel_tmp_outside(jj)-trel_tmp(jj,k,i))
 6911: //                       enddo
 6912: //                     endif
 6913: //                   endif !weno or upwind
 6914: //                 endif
 6915: 
 6916: //               enddo !j
 6917: 
 6918: //               tr_el(1:ntr,k,i)=adv_tr(1:ntr) 
 6919: //             enddo !k=kbe(i)+1,nvrt
 6920: 
 6921: //             !Overwrite with ELM value if enabled.
 6922: //             if(ielem_elm(i)/=0) then
