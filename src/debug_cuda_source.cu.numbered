  969: struct BoundarySegment {
  970: 
  971:    bool isLand;
  972: 
  973:    double clen;  // Length of the boundary segment
  974:    double carea; // Area of the boundary segment
  975: 
  976:    int ifltype;  // Type of flow boundary condition
  977:    
  978:    // Elevation boundary condition
  979:    int iettype;  // Type of elevation boundary condition
  980:    double eth;   // Elevation time history
  981: 
  982:    // Flow boundary condition
  983:    double qthcon;  // Flow time history constant
  984:    double vobc1;   // Velocity coefficient 1
  985:    double vobc2;   // Velocity coefficient 2
  986: 
  987:    // Tracer boundary conditions
  988:    // double trobc[natrm];    // Tracer boundary condition nudging factor
  989:    // int  itrtype[natrm];    // Tracer boundary condition type
  990: 
  991:    BoundarySegment(bool _isLand) {
  992:       isLand = _isLand;
  993:       clen = 0.0;
  994:       carea = 0.0;
  995:       ifltype = 0;
  996:       iettype = 0;
  997:       eth = 0.0;
  998:    }
  999: 
 1000:    BoundarySegment(void) {
 1001:       isLand = false;
 1002:       clen = 0.0;
 1003:       carea = 0.0;
 1004:       ifltype = 0;
 1005:       iettype = 0;
 1006:       eth = 0.0;
 1007:    }
