 2588: //       const double x4 = nodes[nxq(i+1)]->x;
 2589: //       const double y4 = nodes[nxq(i+1)]->y;
 2590: 
 2591: //       const Side& side = sides[i];
 2592: 
 2593: //       xIntersect=-1.e25;
 2594: //       yIntersect=-1.e25;
 2595: 
 2596: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 2597: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 2598: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 2599: 
 2600: //       if (delta != 0.0) {
 2601: //          // Solves the two linear equations for tt1 and tt2
 2602: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2603: //          const double tt2 = delta2/delta;
 2604: 
 2605: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 2606: //          // Similarly, we use tt2 to compute the intersection point.
 2607: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 2608: //             xIntersect = x3 + (x4 - x3)*tt2;
 2609: //             yIntersect = y3 + (y4 - y3)*tt2;
 2610: 
 2611: //             intersectingSide = side;
 2612: //             nextElement = nghbElems[i];
 2613: 
 2614: //             return true;
 2615: //          }
 2616:       
 2617: //       }
 2618: //       else {
 2619: //          // The two segments are parallel
 2620: //          return false;
 2621: //       }
 2622: 
 2623: //    }
