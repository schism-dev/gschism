  509:    Vector2 center;         // Element center coordinates
  510:    double xlon, ylat;         // Element center lat/lon coordinates in _degrees_
  511:    double depth;              // Depth at element (min of all nodes)
  512:    double z[nvrt];            // z-coord  (local frame - vertical up)
  513: 
  514:    // Physical information
  515:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  516: 
  517:    static const bool isblock = false;              // Always false
  518: 
  519:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  520:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  521: 
  522:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  523:    
  524: 
  525:    double vsource;            // Volumetric source/sink term [m^3/s]
  526: 
  527:    double rho[nvrt];          // Density at each prism center
  528:    double rho_mean[nvrt];     // Mean density at each prism center
  529:    CubicSpline rho_spl;
  530:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  531:    double rho_z[nvrt];        // First derivative of density at each prism center
  532:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  533:    
  534: 
  535:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  536: 
  537:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  538:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  539: 
  540:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  541:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  542: 
  543:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  544:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  545:       // Find the local index of the node in the element (0,1,2,3)
  546:       int res = __ffs((nodes[0] == node) | 
  547:                      ((nodes[1] == node) << 1) | 
  548:                      ((nodes[2] == node) << 2) | 
  549:                      ((nodes[3] == node) << 3)) - 1;
  550:       
  551:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  552:       return res;  
  553:    }
  554: 
  555:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  556:       // Find the local index of the side in the element (0,1,2,3)
  557:       int res = __ffs((sides[0] == side) | 
  558:                      ((sides[1] == side) << 1) | 
  559:                      ((sides[2] == side) << 2) | 
  560:                      ((sides[3] == side) << 3)) - 1;
  561:       
  562:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  563:       return res;
  564:    }
  565: 
  566: 
  567:    __inline__ __device__ int findLevel(double z1, int k) const {
  568:       // Starting at index k, find sequentially the level that contains z
  569: 
  570:       // For testing purposes, forgets k and performs a full search.
  571:       for (k = kb; k < nvrt - 1; k++) {
  572:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
  573:       }
  574:       return nvrt - 2;
  575: 
  576: 
  577:       // if z is already betweeen z[k] and z[k+1], return k
  578:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
  579:       else if (z1 <  z[k]) { 
  580:          // Search for increasing levels
  581:          for (int kk = k; kk < nvrt - 1; kk++) {
  582:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  583:          }
  584:          return nvrt - 1;
  585:       }
  586:       else {
  587:          // Search for decreasing levels
  588:          for (int kk = k; kk >= kb; kk--) {
  589:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  590:          }
  591:          return 0;
  592:       }
  593:    }
  594: 
  595:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
  596:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
  597: 
  598:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  599:    __device__ __forceinline__ Point2 GaussPoint(int idx) const {
  600:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
  601:        assert(idx >= 0 && idx < 4 && "GaussPoint: idx out of range");
  602:        const double eta = (idx & 1) ? +g : -g;
  603:        const double xi  = (idx & 2) ? +g : -g;
  604:        return {eta, xi};
  605:    }  
  606: 
  607:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  608:    __device__ __forceinline__ double etaSign(int idx) const {
  609:       // bit1: 0 -> -1, 1 -> +1
  610:       assert(idx >= 0 && idx < 4 && "etaSign: idx out of range");
  611:       return (idx & 2) ? 1.0 : -1.0;     // [-1,-1,+1,+1]
  612:    }
  613: 
  614:    __device__ __forceinline__ double xiSign(int idx) const {
  615:       // +1 if (bit0 XOR bit1), else -1
  616:       assert(idx >= 0 && idx < 4 && "xiSign: idx out of range");
  617:       return ((idx & 1) ^ (idx >> 1)) ? 1.0 : -1.0;   // [-1,+1,+1,-1]
  618: 
  619:    }
  620: 
  621:    // Shape function Phi_idx at a given point p = (eta,xi), idx = 0,1,2,3
  622:    __device__ __forceinline__ double Phi(int idx, Point2 p) const {
  623:       return 0.25*(1.0 + p.x*etaSign(idx))*(1.0 + p.y*xiSign(idx));
  624:    }
  625: 
  626:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi) 
  627:    __device__ __forceinline__ double dPhi_dxi(int idx, Point2 p) const {
  628:       return 0.25*xiSign(idx)*(1.0 + p.x*etaSign(idx));
  629:    }   
  630: 
  631:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
  632:    __device__ __forceinline__ double dPhi_deta(int idx, Point2 p) const {
  633:       return 0.25*(1.0 + p.y*xiSign(idx))*etaSign(idx);
  634:    }      
  635:    
  636:    __inline__ __device__ double detJ_eta(void) const;
  637: 
  638:    __inline__ __device__ double detJ_xi(void) const;
  639: 
  640:    __inline__ __device__ double jacobianDet(Point2 p) const { return area/4.0 + detJ_eta()*p.x + detJ_xi()*p.y; }
  641: 
  642:    // Check if the element is dry using the more up-to-date elevation.
  643:    __inline__ __device__ bool isDry2(void) const;
  644: 
  645:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  646: 
  647:    __inline__ __device__ double computeSignedArea(void) const;
  648: 
  649:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  650:       // Nudges the point (x,y) to the barycenter of the element
  651:       p = (1.0 - btrack_nudge)*p + btrack_nudge*center;
  652:    }
  653: 
  654:    __device__ bool computeShapeCoords(Point2 &xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  655:    
  656:    __device__ void shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const;
  657: 
  658:    __device__ double intPhiPhi(int i1, int i2) const;
  659: 
  660:    __device__ double intGradPhiGradPhi(int i1, int i2) const;
  661: 
  662:    __device__ Vector2 grad2(double *a) const
  663:    {
  664:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  665:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  666:       if (isQuad()) {
  667:          gx += a[3]*gradPhi[3].x;
  668:          gy += a[3]*gradPhi[3].y;
  669:       }
  670:       return {gx, gy};
  671:    }
  672: 
  673:    __device__ Vector2 grad2(double Node::* field) const
  674:    {
  675:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  676:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  677:       if (isQuad()) {
  678:          gx += (nodes[3]->*field)*gradPhi[3].x;
  679:          gy += (nodes[3]->*field)*gradPhi[3].y;
  680:       }
  681:       return {gx, gy};
  682:    }
  683: 
  684:    __device__ __forceinline__ Vector3 n(int k, double &area3D) const;
  685:    __device__ __forceinline__ Vector3 n(int k) const {
  686:       double area3D;
  687:       return n(k, area3D);
  688:     }
