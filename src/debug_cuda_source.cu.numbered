 7965: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 7966:    Node *nodes = mesh->localNodeData;
 7967: 
 7968:    *addr = nodes;
 7969:    *sizeNode = sizeof(Node);
 7970: 
 7971:    switch (varCode) {
 7972:       case (int)VarCode::depth:
 7973:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 7974:          *sizeType = sizeof(double);
 7975:          break;
 7976:       case (int)VarCode::eta:
 7977:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 7978:          *sizeType = sizeof(double);
 7979:          break;
 7980:       case (int)VarCode::x:
 7981:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 7982:          *sizeType = sizeof(Vector2);
 7983:          break;
 7984:       case (int)VarCode::z:
 7985:          *offset = (int)((char*)&nodes[0].z[0] - (char*)nodes);
 7986:          *sizeType = sizeof(double);
 7987:          break;
 7988:       case (int)VarCode::kb:
 7989:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 7990:          *sizeType = sizeof(int);
 7991:          break;
 7992:       case (int)VarCode::isdry:
 7993:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 7994:          *sizeType = sizeof(int);
 7995:          break;         
 7996:       case (int)VarCode::w:
 7997:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 7998:          *sizeType = sizeof(double);
 7999:          break;
 8000:       case (int)VarCode::u:
 8001:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 8002:          *sizeType = sizeof(Vector2);
 8003:          break;         
 8004:       default:
 8005:          *offset = -1;    
 8006:    }  
 8007:    
 8008: }
