 2285: __device__ inline void atomicAddInt16Unsafe(int16_t* address, int16_t val)
 2286: {
 2287:     uintptr_t p = (uintptr_t)address;
 2288:     assert((p & 1) == 0);
 2289: 
 2290:     unsigned int* base = (unsigned int*)(p & ~3);
 2291:     unsigned int addend = (p & 2) ? ((unsigned int)val << 16)
 2292:                                   :  (unsigned int)val;
 2293: 
 2294:     atomicAdd(base, addend);
 2295: }
