 9791: __global__ void printMatrix(bool full) {
 9792:    // Debugging: print the FEM matrix row for each local node
 9793: 
 9794:    const int size = mesh->np;
 9795:    double sum = 0.0;
 9796: 
 9797:    for (int idx_node = 0; idx_node < size; idx_node++) {
 9798:       const Node *node = mesh->localNodeData + idx_node;
 9799: 
 9800:       if (full)
 9801:          printf("idx_node = %d [%d] diag=%lf, [",
 9802:                 idx_node, node->numNodes, *(node->coeffDiag));
 9803: 
 9804:       // Full CSR row length = numNodes + 1 (includes diagonal)
 9805:       for (int k = 0; k < node->numNodes + 1; k++)
 9806:          sum += node->coeffRow[k];
 9807: 
 9808:       for (int j = 0; j < node->numNodes; j++) {
 9809:          const Node *nbNode = node->nodes[j];
 9810:          const double aij = node->coeffRow[node->csrSlot[j]];
 9811:          if (full && aij != 0.0)
 9812:             printf("%d:%f,  ", nbNode->idx, aij);
 9813:       }
 9814: 
 9815:       if (full) printf("]\n");
 9816:    }
 9817: 
 9818:    if (!full) printf("sum=%lf\n", sum);
 9819: }
