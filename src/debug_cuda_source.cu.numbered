  729:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int) const;
  730: 
  731:    // ------------------------------------------------------------------------------------------------
  732:    // These are functions that work on all nodes of the element.
  733:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  734:    //
  735:    // An example of how to use these functions is:
  736:    //   
  737:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  738:    // 
  739:    // Where L is the level at which the field is to be interpolated. The field can be either
  740:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  741:    // There are different versions of getNodalValues for each of these cases.
  742: 
  743:    template<typename T>
  744:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  745:       // Get the values of the field at the nodes of the element
  746:       res[0] = nodes[0]->*field;
  747:       res[1] = nodes[1]->*field;
  748:       res[2] = nodes[2]->*field;
  749:       if (isQuad()) res[3] = nodes[3]->*field;
  750:       else          res[3] = T();
  751:    }
  752: 
  753:    template<typename T>
  754:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  755:       // Get the values of the field at the nodes of the element
  756:       res[0] = (nodes[0]->*field)[level];
  757:       res[1] = (nodes[1]->*field)[level];
  758:       res[2] = (nodes[2]->*field)[level];
  759:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  760:       else          res[3] = T();
  761:    }    
  762: 
  763:    template<typename T>
  764:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  765:       // Get the values of the func at the nodes of the element
  766:       res[0] = (nodes[0]->*func)(level);
  767:       res[1] = (nodes[1]->*func)(level);
  768:       res[2] = (nodes[2]->*func)(level);
  769:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  770:       else          res[3] = T();  // This is 0.0 or a zero vector
  771: 
  772:    }      
  773: 
  774:    template<typename T>
  775:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  776:       // Get the values of the field at the nodes of the element
  777:       res[0] = sides[0]->*field;
  778:       res[1] = sides[1]->*field;
  779:       res[2] = sides[2]->*field;
  780:       if (isQuad()) res[3] = sides[3]->*field;
  781:       else          res[3] = T();
  782:    }
  783: 
  784:    template<typename T>
  785:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  786:       // Get the values of the field at the nodes of the element
  787:       res[0] = (sides[0]->*field)[level];
  788:       res[1] = (sides[1]->*field)[level];
  789:       res[2] = (sides[2]->*field)[level];
  790:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  791:       else          res[3] = T();
  792:    }    
  793: 
  794:    template<typename T>
  795:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  796:       // Get the values of the func at the nodes of the element
  797:       res[0] = (sides[0]->*func)(level);
  798:       res[1] = (sides[1]->*func)(level);
  799:       res[2] = (sides[2]->*func)(level);
  800:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  801:       else          res[3] = T();  // This is 0.0 or a zero vector
  802: 
  803:    }      
  804: 
  805:    template<typename T>
  806:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
  807:       T values[4];
  808:       getNodalValues(level, func, values);
  809: 
  810:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  811:    }
  812: 
  813:    template<typename T>
  814:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  815:       T values[4];
  816:       getNodalValues(field, values);
  817:       
  818:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  819:    }
  820: 
  821: 
  822:    template<typename T>
  823:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  824:       T values[4];
  825:       getNodalValues(level, field, values);
  826: 
  827:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  828:    }
  829: 
  830:    template<typename T>
  831:    __device__ T mean(T Node::* field) const {
  832:       T values[4];
  833:       getNodalValues(field, values);
  834: 
  835:       return (values[0] + values[1] + values[2] + values[3])/i34;
  836:    }
  837: 
  838:    template<typename T>
  839:    __device__ T mean(T Side::* field) const {
  840:       T values[4];
  841:       getSideValues(field, values);
  842:       
  843:       return (values[0] + values[1] + values[2] + values[3])/i34;
  844:    }   
  845: 
  846:    template<typename T>
  847:    __device__ T mean(int level, T (Node::* field)[nvrt]) const {
  848:       T values[4];
  849:       getNodalValues(level, field, values);
  850: 
  851:       return (values[0] + values[1] + values[2] + values[3])/i34;
  852:    }
  853: 
  854:    template<typename T>
  855:    __device__ T mean(int level, T (Side::* field)[nvrt]) const {
  856:       T values[4];
  857:       getSideValues(level, field, values);
  858:       
  859:       return (values[0] + values[1] + values[2] + values[3])/i34;
  860:    }   
  861: 
  862:    // __device__ double mean(double (Node::*func)(int) const) const {
  863:    //    double values[4];
  864:    //    getNodalValues(level, func, values);
  865:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  866:    // }
  867:    // ------------------------------------------------------------------------------------------------
  868: 
  869:    __device__ bool globalToLocal(double xt, double yt, double &xlocal, double &ylocal) const {
