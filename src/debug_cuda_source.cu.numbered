 6651: __global__ void getStructSizes(int* sizes)  {
 6652:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 6653:       sizes[0] = (int)sizeof(Node);
 6654:       sizes[1] = (int)sizeof(Element);
 6655:       sizes[2] = (int)sizeof(Side);
 6656:       sizes[3] = (int)sizeof(NodeBoundary);
 6657:       sizes[4] = (int)sizeof(SideBoundary);
 6658:       sizes[5] = (int)sizeof(BoundarySegment);
 6659: }
