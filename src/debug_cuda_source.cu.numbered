 8228: #ifdef OLD_PCG_SOLVER
 8229: __global__ void computeMatrixProductAndDotProducts() {
 8230:    // Computes A*p, r'Mr and p'Ap
 8231: 
 8232:    // 1) shared buffer: first half for rMr, second for pAp
 8233:    __shared__ double sdata[2*BLOCK_SIZE];
 8234:    double* s_rMr = sdata;
 8235:    double* s_pAp = sdata + BLOCK_SIZE;
 8236: 
 8237:    const int tid = threadIdx.x;
 8238: 
 8239:    double l_pAp = 0.0;
 8240: 
 8241:    s_rMr[tid] = 0.0;
 8242:    s_pAp[tid] = 0.0;
 8243: 
 8244:    // 2) get your node pointer
 8245:    // NODE(node);   
 8246:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 8247:    Node *node = &(mesh->localNodeData[idx_node]); 
 8248:       if (idx_node < mesh->np) {
 8249: 
 8250:       const double diag = node->coeffDiag;
 8251:       const double r    = node->mR;
 8252:       const double p    = node->mP;  
 8253: 
 8254:       // apply preconditioner on the fly:
 8255:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 8256: 
 8257:       // 4) compute Ap = A.p
 8258:       double Ap = node->coeffDiag * node->mP;
 8259:       for (int j = 0; j < node->numNodes; ++j) {
 8260:          const Node *nbNode = node->nodes[j];
 8261:          Ap += node->coeffMatrix[j] * nbNode->mP;
 8262: 
 8263:       }
 8264: 
 8265:       node->mAp = Ap;
 8266:       
 8267: 
 8268:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 8269:       // const double l_rMr = r*Mr;  // r'Mr
 8270:       l_pAp = p*Ap;  // p'Ap
 8271: 
 8272: 
 8273:    }
 8274: 
 8275:    // 6) write into shared mem
 8276:    // s_rMr[tid] = l_rMr;
 8277:    s_pAp[tid] = l_pAp;
 8278: 
 8279:    __syncthreads();
 8280: 
 8281:    // 7) block-wide tree reduction
 8282:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8283:       if (tid < stride)  {
 8284:          s_pAp[tid] += s_pAp[tid + stride];
 8285:       }
 8286:       __syncthreads();
 8287:    }
 8288: 
 8289:    // 8) thread 0 atomically accumulates into the globals
 8290:    // XXX: This is slower than it needs to be, but it is simple and works
 8291:    if (tid == 0) {
 8292:       atomicAdd(pAp, s_pAp[0]);
 8293:    }
 8294: 
 8295: 
 8296: }
 8297: 
 8298: 
 8299: __global__ void updateSolutionAndDotProducts(void) {
 8300:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 8301: 
 8302:    const int tid = threadIdx.x;
 8303: 
 8304:    s_rMr[tid] = 0.0;
 8305: 
 8306:    // get node & bounds-check:
 8307:    NODE(node);
 8308: 
 8309:    
 8310:    // Compute alpha
 8311:    const double alpha = (*rMr_old)/(*pAp); 
 8312: 
 8313: 
 8314:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 8315: 
 8316: 
 8317:    // load scalars
 8318:    const double diag = node->coeffDiag;
 8319:    const double p    = node->mP;
 8320:    const double Ap   = node->mAp;
 8321:    const double x    = node->mX;
 8322:    const double r    = node->mR;
 8323:    
 8324:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 8325: 
 8326:    // 1) update solution & residual
 8327:    const double x_new = x + alpha*p;
 8328:    const double r_new = r - alpha*Ap;
 8329:    node->mX = x_new;
 8330:    node->mR = r_new;
 8331: 
 8332:    // 2) apply Jacobi preconditioner on the fly
 8333:    const double Mr_new = r_new/diag;
 8334: 
 8335: 
 8336:    // 3) local contributions for the two dot-products
 8337:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 8338: 
 8339:    // 4) write into shared-mem
 8340:    s_rMr[tid] = l_rMr;
 8341: 
 8342:    __syncthreads();
 8343: 
 8344: 
 8345:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8346:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8347:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8348:       __syncthreads();
 8349:    }
 8350: 
 8351:    // 6) thread 0 atomically folds into the global accumulators
 8352:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 8353: 
 8354: 
 8355: }
 8356: 
 8357: 
 8358: __global__ void updateSearchDirection() {
 8359: 
 8360:     NODE(node);
 8361: 
 8362:     // recompute z on-the-fly
 8363:     const double z = node->mR / node->coeffDiag;
 8364:     const double p = node->mP;
 8365: 
 8366:     const double beta = (*rMr_new)/(*rMr_old);
 8367: 
 8368: 
 8369:     // p =z + beta*p
 8370:     node->mP = z + beta*p;
 8371: 
 8372: }
 8373: 
 8374: __global__ void initializeScalars(double *scalars) {
 8375: 
 8376:    // These point to a cupy array in the host code
 8377:    rMr_old = scalars + 0;
 8378:    rMr_new = scalars + 1;
 8379:    pAp     = scalars + 2;
 8380: }
 8381: 
 8382: __global__ void initializePreconditionedResidual(void) {
 8383: 
 8384:     __shared__ double s_rMr[BLOCK_SIZE];  
 8385: 
 8386:     s_rMr[threadIdx.x] = 0.0;
 8387: 
 8388:     NODE_ALL(node, valid);
 8389:     const int tid = threadIdx.x;
 8390:     // For the first iteration:
 8391:     // 1. Initial solution x = 0 (already set)
 8392:     // 2. Initial residual r = b (stored in qel)
 8393:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 8394: 
 8395: // XXX we should use the guess solution here    
 8396: 
 8397:     double l_rMr = 0.0;
 8398:     if (valid) {
 8399:       // Set initial residual r = b (from qel)
 8400:       node->mR = node->qel;
 8401: 
 8402:       // Compute z = M^-1 * r (preconditioned residual)
 8403:       const double z = node->mR / node->coeffDiag;
 8404: 
 8405:       // Set initial search direction p = z
 8406:       node->mP = z;
 8407: 
 8408:       // Initialize other variables needed for CG
 8409:       node->mX = 0.0;  // Initial solution
 8410:       node->mAp = 0.0; // Will be computed in first iteration
 8411: 
 8412: 
 8413:       // Computes the first r'Mr (reduction)
 8414:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 8415:     }
 8416:     // 4) write into shared-mem
 8417:     s_rMr[tid] = l_rMr;
 8418: 
 8419:     __syncthreads();
 8420: 
 8421: 
 8422:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8423:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8424:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8425:         __syncthreads();
 8426:     }
 8427: 
 8428:     // 6) thread 0 atomically folds into the global accumulators
 8429:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 8430: 
 8431:     *rMr_old = 0.0;
 8432:     *pAp = 0.0;
 8433: }
 8434: #endif
 8435: 
