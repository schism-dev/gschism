 2627:    template<typename T>
 2628:    __device__ __forceinline__ T Element::mean(T Node::* field) const {
 2629:       T values[4];
 2630:       getNodalValues(field, values);
 2631: 
 2632:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2633:       if constexpr (IsVector2<T>::value && ics == 2) {
 2634: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2635:          projectNodeVectorsToElementFrame(values);
 2636: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2637:       }
 2638: 
 2639:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2640:    }
 2641: 
 2642:    template<typename T>
 2643:    __device__ __forceinline__ T Element::mean(T Side::* field) const {
 2644:       T values[4];
 2645:       getSideValues(field, values);
 2646:       
 2647:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2648:       if constexpr (IsVector2<T>::value && ics == 2) {
 2649: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2650:          projectSideVectorsToElementFrame(values);
 2651: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2652:       }
 2653: 
 2654:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2655:    }   
