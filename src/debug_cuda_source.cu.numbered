 6488: __global__ void getStructSizes(int* sizes)  {
 6489:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 6490:       sizes[0] = (int)sizeof(Node);
 6491:       sizes[1] = (int)sizeof(Element);
 6492:       sizes[2] = (int)sizeof(Side);
 6493:       sizes[3] = (int)sizeof(NodeBoundary);
 6494:       sizes[4] = (int)sizeof(SideBoundary);
 6495:       sizes[5] = (int)sizeof(BoundarySegment);
 6496: }
