 1122: // This struct is used to store the boundary information for a node.
 1123: struct NodeBoundary {   
 1124:    BoundarySegment *segment;
 1125:    Node *node;
 1126:    
 1127:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1128:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1129: 
 1130:    bool isLand;
 1131: 
 1132:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1133:    double elbc;   // Elevation boundary condition
 1134:    double eth;    // Elevation time history
 1135: 
 1136:    double eta_mean; // Mean elevation at nodes
 1137: 
 1138:    bool isEssentialBC;
 1139: 
 1140:    Vector2 uth[nvrt];  // "Time history" velocity
 1141: 
 1142:    // Arrays for harmonic constituents (if needed)
 1143:    double  emo[nbfr];  // Elevation amplitude
 1144:    double  efa[nbfr];  // Elevation phase
 1145:    Vector2 umo[nbfr];  // velocity amplitude
 1146:    Vector2 ufa[nbfr];  // velocity phase
 1147: 
 1148: 
 1149:    NodeBoundary(void) {
 1150:       isLand = false;
 1151:    }
 1152:    NodeBoundary(bool _isLand) {
 1153:       isLand = _isLand;
 1154:    }
 1155: 
 1156:    
 1157:    __forceinline__ __device__ int numSidesForAverage() const {
 1158:    // Returns the number of sides that are connected to the node and have the same segment.
 1159:    // This is used to compute the average velocity at the node for open boundary nodes.
 1160:       int res = 0;
 1161:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1162:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1163: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1164:       return res;
 1165:    }
 1166: 
 1167: 
 1168:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1169:       assert(index == 0 || index == 1); 
 1170:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1171:    }
 1172: 
 1173: 
 1174: };
