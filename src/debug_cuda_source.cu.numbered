 3914: 
 3915: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3916:    // Computes the z coordinate at level k.
 3917:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3918:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3919:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3920:    // used 
 3921: 
 3922:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3923:    
 3924:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3925: 
 3926:    if (isDry2()) return 0.0;  
 3927: 
 3928:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3929: 
 3930:    if constexpr(ivcor == 2) {
 3931: 
 3932:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3933:       const double h_c = mesh->h_c;
 3934:       const double theta_f = mesh->theta_f;
 3935:       const double sinh_theta_f = mesh->sinh_theta_f;
 3936: 
 3937: 
 3938:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3939:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3940:       // once per time step/node. XXXX
 3941:       // CHECK: updateZCoordData
 3942: 
 3943:       //  To simplify comparisons, I define index versions of count variables.
 3944:       if      (k == ivrt)     return eta2; 
 3945:       else if (k == izlev)    return -hmod2;
 3946:       else if (k == kb)       return -depth;
 3947:       else if (k < izlev)     return mesh->ztot[k];
 3948:       else if (k > izlev) {
 3949:          const int ksig = k - izlev;
 3950: 
 3951:          if (hmod2 <= h_c) {
 3952:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3953: 
 3954:          } 
 3955:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3956:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3957:             assert(false && "compZCoord: invalid h_c\n");
 3958:          } 
 3959:          else {
 3960:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3961:                    h_c * mesh->sigma[ksig] + 
 3962:                    (hmod2 - h_c) * mesh->cs[ksig];
 3963:          }
 3964:       } else { 
 3965:          assert(false && "compZCoord: invalid level or coordinate system\n");
 3966:       }
 3967: 
 3968:    }
 3969:    else {  // if constexpr(ivcor == 1)
 3970:       if (k <= kb)        return -depth; 
 3971:       else if (k == ivrt) return eta2;
 3972:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3973: 
 3974:    }
 3975:    
 3976:    assert(false && "compZCoord: invalid level or coordinate system\n");
 3977:    return 0.0;
 3978: }
 3979: 
 3980: 
 3981: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3982:    // Computes the bottom drag Cd based on the selected nchi
 3983: 
 3984:    if constexpr(nchi == 0) {
 3985:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3986:       Cd = drag;  // Read from drag file
 3987: 
 3988:    } else if constexpr(nchi == 1) {
 3989:       // 
 3990: 
 3991:       bool ltmp = false; // for WBL iteration
 3992: 
 3993:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3994:       if (isDry || (rough == 0.0)) {
 3995:          Cd = 0.0;
 3996: 
 3997:       } else { //roughness >0 
 3998:          
 3999:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 4000: 
 4001:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 4002: 
 4003:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 4004: 
 4005:       } // if rough
 4006: 
 4007:    } else if constexpr(nchi == -1) {
 4008:    // Manning 
 4009:  
 4010:       const double htot = max(hmin_man, htot2()); 
 4011:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 4012: 
 4013:    } else {
 4014:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 4015:       
 4016:    } // if nchi
 4017: 
 4018: }
 4019: 
 4020: 
 4021: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 4022:    // Checks if a side in on the boundary
 4023:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 4024: 
 4025:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 4026:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 4027: 
 4028:    // Indices of the nodes that form the side
 4029:    //
 4030:    // NOTE: This function is slow. It's to be called from "populate" functions, not from the main loop.
 4031:    const int n1 = side.n1->idx;
 4032:    const int n2 = side.n2->idx;
 4033:    isLand = false;
 4034:    
 4035: 
 4036:    // Check if the side is on a land boundary
 4037:    for (int i = 0; i < nland; i++) {
 4038:       for (int j = 0; j < nlnd[i] - 1; j++) {
 4039:          // Consecutive nodes in the land boundary segment
 4040:          const int b1 = ilnd[i + j*nland];
 4041:          const int b2 = ilnd[i + (j + 1)*nland];
 4042: 
 4043:          assert(b1 != -1 && b2 != -1);
 4044: 
 4045:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 4046:             
 4047:             isLand = true;
 4048:             return i;
 4049:          }
 4050:       }
 4051:    }
 4052: 
 4053:    // Check if the side is on an open boundary
 4054:    for (int i = 0; i < nope; i++) {
 4055:       for (int j = 0; j < nond[i] - 1; j++) {
 4056:          // Consecutive nodes in the open boundary segment
 4057:          const int b1 = iond[i + j*nope];
 4058:          const int b2 = iond[i + (j + 1)*nope];
 4059: 
 4060:          assert(b1 != -1 && b2 != -1);
 4061: 
 4062:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 4063:             isLand = false;
 4064:             return i;
 4065:          }
 4066:       }
 4067:    }
 4068: 
 4069:    // Check that the nodes are not both on the boundary
 4070:    assert( (side.n1->nodeBnd == nullptr || side.n2->nodeBnd == nullptr)
 4071:         && "side not in ilnd/iond but both nodes are boundary" );
 4072: 
 4073:    return -1;
 4074: }
 4075: 
 4076: 
 4077: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 4078:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4079:                                     double *wind_rotate_angle, 
 4080:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4081:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4082:                                     int16_t *nodePermutationSort, double *crs_data,
 4083:                                     int *localNodeNeighNodesStart, int *localNodeNeighElemsStart, 
 4084:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4085:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4086:                                     int *localNodePart,     int *localElemPart,     int *localSidePart, 
 4087:                                     double *drag, double *roughness, double *rmanning, 
 4088:                                     double *diffmin, double *diffmax,
 4089:                                     int *kb, double *localSigma) {
 4090: 
 4091:    NODE(pnode);  
 4092:    const int i = idx_node;
 4093:    const int iglobal = globalNodeIndices[i];
 4094:    Node &node(*pnode);
 4095: 
 4096:    node.idx = iglobal;
 4097:    node.part = localNodePart[iglobal];
 4098: 
 4099:    // It is important to differentiate between the global and local "start" indices because they
 4100:    // play different, but related, roles in this code. The global "start" indices are used
 4101:    // for the CSR-like indexing of the node and element neighbor arrays in the "global"
 4102:    // (unpartitioned) mesh. The local "start" indices are used for the CSR-like indexing of the 
 4103:    // node and element neighbor arrays in the "local" (partitioned) mesh.
 4104:    const int idxNodeStart = nodeNeighNodesStart[iglobal];
 4105:    const int idxNodeEnd   = nodeNeighNodesStart[iglobal + 1];
 4106:    const int idxNodeLocalStart = localNodeNeighNodesStart[i];
 4107:    node.numNodes = idxNodeEnd - idxNodeStart;
 4108:    node.nodes = nodeNeighNodes + idxNodeLocalStart;
 4109: 
 4110:    const int rowStart = idxNodeLocalStart + i; // +i is to account for the diagonal element.
 4111:    node.coeffRow = crs_data + rowStart; 
 4112: 
 4113:    node.csrSlot = nodePermutationSort + idxNodeLocalStart;
 4114: 
 4115: 
 4116: 
 4117:    const int idxElemStart = nodeNeighElemsStart[iglobal];
 4118:    const int idxElemEnd   = nodeNeighElemsStart[iglobal + 1]; 
 4119:    const int idxElemLocalStart = localNodeNeighElemsStart[i];
 4120:    node.numElements = idxElemEnd - idxElemStart;
 4121:    node.elements = nodeNeighElems + idxElemLocalStart;
 4122: 
 4123: 
 4124:    for (int idx = idxNodeStart, idxLocal = idxNodeLocalStart; idx < idxNodeEnd; idx++, idxLocal++) {
 4125:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 4126:       const int partNode = localNodePart[idxNodeGlobal]; 
 4127:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 4128: 
 4129:       Node *node_ptr = nodes[partNode] + idxNode;
 4130:       
 4131:       nodeNeighNodes[idxLocal] = node_ptr;
 4132:    }
 4133: 
 4134: 
 4135:    for (int idx = idxElemStart, idxLocal = idxElemLocalStart; idx < idxElemEnd; idx++, idxLocal++) {
 4136:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 4137:       const int partElem = localElemPart[idxElemGlobal];
 4138:       const int idxElem  = localElemIndices[idxElemGlobal];
 4139: 
 4140:       Element *elem_ptr = elems[partElem] + idxElem;
 4141: 
 4142:       nodeNeighElems[idxLocal] = elem_ptr;
 4143:    }      
 4144: 
 4145:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 4146:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 4147: 
 4148:    sincosf(-(float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 4149: 
 4150:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 4151:    if constexpr(ics == 1) {
 4152:       node.p.x   = node_coords[i * 3];
 4153:       node.p.y   = node_coords[i * 3 + 1];
 4154:       node.gz = 0.0;
 4155: 
 4156:       if (use_ll) {                                    // <-- add
 4157:          node.lon = node_coords_ll[i * 2    ]*deg2rad; // <-- add
 4158:          node.lat = node_coords_ll[i * 2 + 1]*deg2rad; // <-- add
 4159:       }  
 4160: 
 4161:    } else {
 4162:       const double lon = deg2rad*node_coords[i * 3];
 4163:       const double lat = deg2rad*node_coords[i * 3 + 1];
 4164: 
 4165:       Point3 p = computeXYZfromLatLon(lat, lon);
 4166:       node.p = toVector2(p);
 4167:       node.gz = p.z;
 4168:       node.lon = lon;
 4169:       node.lat = lat;
 4170: 
 4171:       #ifdef USE_FRAMES
 4172:       node.setFrame(lat, lon);
 4173:       #endif
 4174: 
 4175: 
 4176:    }
 4177: 
 4178:    node.depth = node_coords[i * 3 + 2];
 4179: 
 4180:    node.numSides = 0;
 4181: 
 4182:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 4183:    if      constexpr(nchi ==  0) node.drag     = drag[iglobal];
 4184:    else if constexpr(nchi ==  1) node.rough    = roughness[iglobal];
 4185:    else if constexpr(nchi == -1) node.rmanning = rmanning[iglobal];
 4186:    else assert(false && "populateNodes: selected nchi not implemented.");
 4187: 
 4188:    // If the turbulence model is GLS, GOTM, or SedimentMix, then populate the diffmin and diffmax values read from the files.
 4189:    if constexpr (turbulenceModel == TurbulenceModel::GLS ||
 4190:                  turbulenceModel == TurbulenceModel::GOTM ||
 4191:                  turbulenceModel == TurbulenceModel::SedimentMix) {
 4192:       node.turb.diffmin = diffmin[iglobal];
 4193:       node.turb.diffmax = diffmax[iglobal];
 4194:    }
 4195: 
 4196:    if constexpr(ivcor == 1) 
 4197:    {  
 4198:       node.kb = kb[iglobal];
 4199: 
 4200:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + iglobal*nvrt];
 4201:    }
 4202: 
 4203:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 4204:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 4205:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 4206:    for (int k = 0; k < nvrt; k++) node.dfh[k] = dfh0;   // XXXX (does it need to exist when transport is not enabled?)
 4207: 
 4208:    
 4209:    // Links the node to the boundary information
 4210:    if (isbnd[iglobal] >= 0) {
 4211:      
 4212:       // Get the index of the node boundary
 4213:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 4214: 
 4215:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 4216:       node.nodeBnd->node = &node;
 4217: 
 4218:       node.nodeBnd->sideBnd1 = nullptr;
 4219:       node.nodeBnd->sideBnd2 = nullptr;
 4220: 
 4221:       if (isbnd[iglobal]>=0) {
 4222: 
 4223:          node.nodeBnd->segment = &(localSegmentMem[isbnd[iglobal]]);
 4224:          
 4225:          node.nodeBnd->segment->ifltype = 0; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 4226:          node.nodeBnd->segment->iettype = 0; // XXXXXXXXX
 4227: 
 4228:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 4229:          node.nodeBnd->segment->clen  = nan("1");
 4230:          node.nodeBnd->segment->carea = nan("1");
 4231: 
 4232:       }
 4233:    } else {
 4234: 
 4235:       node.nodeBnd = nullptr; // For internal nodes
 4236: 
 4237:       if (isbnd[iglobal] == landSegment) {
 4238:          node.nodeBnd = landBoundaryNode;
 4239:          node.nodeBnd->segment = landBoundarySegment;
 4240:       }
 4241:       
 4242:    }
 4243:    
 4244:    // XXXX GAUSSIAN HILL VELOCITIES
 4245:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4246:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4247:          constexpr double rot_per = 3000.0;
 4248:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 4249:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 4250:       // XXXXX
 4251:    #endif
 4252: 
 4253: }
 4254: 
 4255: __device__ void Mesh::populateNodes2(int *localNodeNeighNodesStart, int *crs_indices, int *crs_indptr) {
 4256:    
 4257:    NODE(node);
 4258:    const int localIdx = idx_node;
 4259: 
 4260: 
 4261:    // Computes csrSlot, the array of indices/slots of the neighbor nodes in the CRS matrix.
 4262:    int16_t *csrSlot = node->csrSlot;  
 4263: 
 4264:    // Simply count the number of nodes with a smaller global index than the current node.
 4265:    // It accounts for the diagonal element.
 4266:    // packedIndex is a special type of global index in which nodes are counted in the order as the
 4267:    // local index, but taking into account all the partitions (in order).
 4268:    for (int i = 0; i < node->numNodes; ++i) {
 4269:       const int col = node->nodes[i]->packedIndex();
 4270:       int16_t idx = 0;
 4271: 
 4272:       //Takes care of the diagonal element.
 4273:       if (node->packedIndex() < col) ++idx;          
 4274: 
 4275:       for (int j = 0; j < node->numNodes; ++j) if (node->nodes[j]->packedIndex() < col) ++idx;
 4276:       csrSlot[i] = idx;
 4277:    }
 4278: 
 4279:    // Find the diagonal element in the CRS matrix.
 4280:    int16_t idxDiag = 0;
 4281:    for (int j = 0; j < node->numNodes; ++j)
 4282:       if (node->nodes[j]->packedIndex() < node->packedIndex()) ++idxDiag;
 4283: 
 4284:    node->coeffDiag = &(node->coeffRow[idxDiag]);
 4285: 
 4286:    // Fills the CRS indices and indptr arrays for the cupyz's crs matrix in the solver.
 4287:    const int idxNodeLocalStart = localNodeNeighNodesStart[localIdx];
 4288: 
 4289:    const int rowStart = idxNodeLocalStart + localIdx;  // +i is to account for the diagonal element.
 4290:    const int rowNNZ = node->numNodes + 1;        // +1 is to account for the diagonal element.
 4291:    crs_indptr[localIdx] = rowStart;
 4292: 
 4293:    // Fills crs_indices array using the per-partition indexing.
 4294:    const int d = (int)(node->coeffDiag - node->coeffRow);
 4295:    crs_indices[rowStart + d] = node->packedIndex();  
 4296:    for (int j = 0; j < node->numNodes; ++j) {
 4297:       Node *nb = node->nodes[j];
 4298:       crs_indices[rowStart + node->csrSlot[j]] = nb->packedIndex();
 4299:    }
 4300: 
 4301: 
 4302: }
 4303: 
 4304: 
