 1334:    double eth;   // Elevation time history
 1335: 
 1336:    // Flow boundary condition
 1337:    double qthcon;  // Flow time history constant
 1338:    double vobc1;   // Velocity coefficient 1
 1339:    double vobc2;   // Velocity coefficient 2
 1340: 
 1341:    // Tracer boundary conditions
 1342:    // double trobc[natrm];    // Tracer boundary condition nudging factor
 1343:    // int  itrtype[natrm];    // Tracer boundary condition type
 1344: 
 1345:    BoundarySegment(bool _isLand) {
 1346:       isLand = _isLand;
 1347:       clen = 0.0;
 1348:       carea = 0.0;
 1349:       ifltype = 0;
 1350:       iettype = 0;
 1351:       eth = 0.0;
 1352:    }
 1353: 
