  850: 
  851: // ----------------------------- Frames -----------------------------
  852: 
  853: // Frames are used to transform vectors between different coordinate systems.
  854: // They are templated in such a way that when ics==1, they have (most likely) no overhead.
  855: template<int ICS>
  856: struct Frame {};
  857: 
  858: template<>
  859: struct Frame<1> {
  860:    __forceinline__ __device__ void update(double, double) {}
  861:    __forceinline__ __device__ Vector3 G2L(Vector3 vi) const { return vi; }
  862:    __forceinline__ __device__ Vector3 L2G(Vector3 vi) const { return vi; }
  863:    __forceinline__ __device__ Vector2 projHorVec(Vector2 v, const Frame<1>&) const { return v; }
  864:    __forceinline__ __device__ Vector3 nUp(void)         const { return {0.0, 0.0, 0.0}; }
  865:    __forceinline__ __device__ Vector3 nZonal(void)      const { return {0.0, 0.0, 0.0}; }
  866:    __forceinline__ __device__ Vector3 nMeridional(void) const { return {0.0, 0.0, 0.0}; }
  867: };
  868: 
  869: template<>
  870: struct Frame<2> {
  871:    // Column 0 (East):  (-sin_lon, cos_lon, 0)              - store 2 values, t20=0 implicit
  872:    // Column 1 (North): Normalized oblate ellipsoid vector  - store 3 values
  873:    // Column 2 (Up):    cross(col0, col1)                   - recomputed on demand
  874:     double t00, t10;        // col0 (t20=0 implicit)
  875:     double t01, t11, t21;   // col1
  876: 
  877:    __device__ void update(double lat, double lon) { // XXX use lat, lon instead of ar1, ar2?
  878: 
  879:       assert(lat >= -pi/2.0 && lat <= pi/2.0 && "GRID: lat out of range");
  880:       assert(lon >= -pi     && lon <= pi     && "GRID: lon out of range");
  881: 
  882:       double sin_lon, cos_lon, sin_lat, cos_lat;
  883:       sincos(lon, &sin_lon, &cos_lon); // These functions are faster than sin(ar1) and cos(ar1).
  884:       sincos(lat, &sin_lat, &cos_lat);
  885: 
  886:       t00 = -sin_lon;
  887:       t10 =  cos_lon;
  888:       t01 = -cos_lon*sin_lat;
  889:       t11 = -sin_lon*sin_lat;
  890:       t21 = (rearth_pole/rearth_eq)*cos_lat;
  891: 
  892:       const double col1_norm = sqrt(t01*t01 + t11*t11 + t21*t21);
  893:       assert (col1_norm != 0.0 && "GRID: col1_norm=0");
  894: 
  895:       const double col1_norm_inv = 1.0/col1_norm;
  896:       t01 = t01*col1_norm_inv;
  897:       t11 = t11*col1_norm_inv;
  898:       t21 = t21*col1_norm_inv;
  899: 
  900:       // The 3rd column (col2) is the cross product of the first two and is computed when needed.
  901: 
  902: 
  903:    }
  904: 
  905:    __forceinline__ __device__ void print(void) const {
  906:       printf("frame = [%.16f, %.16f, %.16f, %.16f, %.16f]\n", t00, t10, t01, t11, t21);
  907:    }
  908: 
  909:    __forceinline__ __device__ void getCol2(double &t02, double &t12, double &t22) const {
  910:       // cross(col0, col1), with t20=0 implicitly:
  911:       // |  i       j       k   |
  912:       // | t00     t10      0   |
  913:       // | t01     t11     t21  |
  914:       t02 =  t10*t21;
  915:       t12 = -t00*t21;
  916:       t22 =  t00*t11 - t10*t01;
  917:    }
  918: 
  919: 
  920:    __forceinline__ __device__ Vector2 projHorVec(Vector2 const &vec0, Frame<2> const &frameout) const {
  921:    // Transforms a horizontal vector from one frame to another and projects it to the new local horizontal plane.
  922:    // Inputs:
  923:    //        vec0: vel. in this frame;
  924:    //        frameout: Output frame;
  925:    // Output: 
  926:    //        vel. in new frame  
  927:    //
  928:    // Projects a horizontal vector from frame 1 (this) to frame 2 (frameout),
  929:    // discarding the z-component of the result to keep only the local horizontal
  930:    // plane of frame 2.
  931:    //
  932:    // Since F1 and F2 are global-to-local rotation matrices, transforming from
  933:    // frame 1 to frame 2 requires F2 * F1^{-1} = F2 * F1^T, as rotation matrices
  934:    // are orthogonal. This product is computed as dot products between columns of
  935:    // F1 and columns of F2, which is equivalent to multiplying rows of F1^T by
  936:    // columns of F2.// 
  937: 
  938:       auto const fo = frameout; // Just an alias for the output frame.
  939:       Vector2 res;
  940: 
  941:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  942:       // of t and fo.t are the same.
  943:       const double d00 = t00*fo.t00 + t10*fo.t10;
  944:       const double d10 = t01*fo.t00 + t11*fo.t10;
  945: 
  946:       const double d01 = t00*fo.t01 + t10*fo.t11;
  947:       const double d11 = t01*fo.t01 + t11*fo.t11 + t21*fo.t21;
  948: 
  949:       res.x = vec0.x * d00 + vec0.y * d10;
  950:       res.y = vec0.x * d01 + vec0.y * d11;
  951: 
  952:       return res;
  953:    }
  954: 
  955:    __forceinline__ __device__ Vector3 G2L(Vector3 const &vi) const {
  956:       Vector3 vo;
  957:       double t02, t12, t22;
  958: 
  959:       // Compute the 3rd column of the frame tensor
  960:       getCol2(t02, t12, t22);
  961: 
  962:       vo.x = vi.x*t00 + vi.y*t10;
  963:       vo.y = vi.x*t01 + vi.y*t11 + vi.z*t21;
  964:       vo.z = vi.x*t02 + vi.y*t12 + vi.z*t22;
  965: 
  966:       return vo;
  967:    
  968:    }
  969: 
  970:    __forceinline__ __device__ Vector3 L2G(Vector3 const &vi) const {
  971:       Vector3 vo;
  972:       double t02, t12, t22;
  973: 
  974:    // Compute the 3rd column of the frame tensor
  975:       getCol2(t02, t12, t22);
  976: 
  977:       // F * vi (non-transposed, so we use rows of F)
  978:       vo.x = vi.x*t00 + vi.y*t01 + vi.z*t02;
  979:       vo.y = vi.x*t10 + vi.y*t11 + vi.z*t12;
  980:       vo.z =            vi.y*t21 + vi.z*t22;  // t20=0 term dropped
  981: 
  982:       return vo;
  983:    }
  984: 
  985:    // Unit vectors that define the local frame
  986:    __forceinline__ __device__ Vector3 nUp(void) const {
  987:       // Column 2 = cross(column0, column1)
  988:       return { t10*t21, -t00*t21, t00*t11 - t10*t01 };
  989:    }
  990: 
  991:    __forceinline__ __device__ Vector3 nZonal(void) const {
  992:       // Column 0
  993:       return { t00, t10, 0.0 };
  994:    }
  995: 
  996:    __forceinline__ __device__ Vector3 nMeridional(void) const {
  997:       // Column 1
  998:       return { t01, t11, t21 };
  999:    }
 1000: 
 1001: };
