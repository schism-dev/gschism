 2620:    // computes the intersection point in local cartesian coordinates
 2621: //    Point3 intersection = origSide->toLocalFrame(nextSide->p3_t(tt));  // XXXX I don't think this is necessary. The intersection is already computed in findNextIntersection.
 2622: 
 2623: //    // Nudges the point to the barycenter of the element. 
 2624: //    // This ensures that the point is inside the element and hence, we will find an intersection if the
 2625: //    // next segment intersects the element sides. 
 2626: //    // TODO: curElem->nudgeToBarycenter(intersection);  REMEMBER!!! RECOVER??? XXX KKKKK
 2627: 
 2628: 
 2629: //    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 2630: //    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 2631: //    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 2632: //    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 2633: 
 2634: //    // If the side is an open boundary, the tangential velocity is set to zero.
 2635: //    if (nextSide->isBnd()) vtan = 0.0;
 2636: 
 2637: //    // The new velocity components are computed from the tangential velocity and the tangent vector.
 2638: //    const double us = vtan*nextSide->t().x;
 2639: //    const double vs = vtan*nextSide->t().y;
 2640: //    const double ws = nextSide->w2(jlev); 
 2641: 
 2642: //    u_int = {us, vs, ws};
 2643: 
 2644: //    // The end of this tracking segment is now the intersection point.
 2645: //    xt = {intersection.x, intersection.y, zint};
 2646: // // printf("trackGoesOutOfWater: intersection = (%.17f, %.17f, %.17f), zint = %.17f, u_int = (%.17f, %.17f, %.17f)\n", intersection.x, intersection.y, zint, u_int.x, u_int.y, u_int.z);
