 6838: 
 6839:    __global__ void computeVegetationAndDragParameters(void) {
 6840:       // Computes the vegetation and drag model parameters:
 6841:       // chi, \tilde\chi, beta, \breve{H}
 6842:       
 6843:       SIDE(side);
 6844: 
 6845:       side->hhat = 0.0;
 6846:       side->chi2 = 0.0;
 6847:       side->chi = 0.0;
 6848:       side->veg_c2 = 0.0;
 6849:       side->veg_beta = 0.0;
 6850: 
 6851:       if (side->isDry) return;
 6852: 
 6853:       const double htot = side->htot2();
 6854:       const int    kb   = side->kb;
 6855: 
 6856:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 6857: 
 6858:       const double veg_h     = side->veg_h();
 6859:       const double veg_nv    = side->veg_nv();
 6860:       const double veg_c     = side->veg_c();
 6861:       const double veg_beta  = side->veg_beta;
 6862:       const double veg_alpha = side->veg_alpha_vert_mean();
 6863: 
 6864:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX recommended to change names, chi->chitilde, chi2->chi
 6865:       // Velocity magnitude at the bottom level
 6866:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0 - dt*swild2(k,1) to u2 (I think this only pertains to iupwind_mom \= 0)
 6867:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 6868:       side->chi2 = side->Cd()*vmag1;
 6869:       side->chi  = side->chi2;
 6870: 
 6871:       if constexpr(iveg != 0) {
 6872:          const Node *n1 = side->n1;
 6873:          const Node *n2 = side->n2;
 6874:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 6875:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 6876:       }
 6877: 
 6878:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 6879: 
 6880:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 6881:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 6882:       double magUa = 0.0;
 6883:       if constexpr(iveg != 0) {
 6884:          if (side->is3D() && veg_h > 0.0) {
 6885:             // 3D wet side with veg...
 6886: 
 6887:             double magUa = 0.0;
 6888:             for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 6889:                if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 6890: 
 6891:                   // Velocity magnitude must be computed at the center of each level to perform the integration.
 6892:                   // The tricky part is to compute that velocity at the level that may be partially submerged.
 6893:                   const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 6894: 
 6895:                   // Velocity magnitude at the top (h) of the level (may be partially submerged)
 6896:                   const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 6897: 
 6898:                   // Velocity magnitude at the bottom (l) of the level
 6899:                   const double ul = length(side->u2[k]);
 6900: 
 6901:                   const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 6902:                   magUa += Dz*0.5*(uh + ul);
 6903: 
 6904:                } // if HasVegetation
 6905:             } // for k
 6906:             const double ua = magUa/min(htot, veg_h); // Vertical average
 6907: 
 6908:             // Computes beta, used for computing the stress term at the top of the canopy.      
 6909:             side->veg_c2 = veg_alpha*dt*ua; // >=0
 6910:             if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 6911:                const double zCpy = side->zTopCanopy();
 6912:                const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 6913:                const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 6914:                const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 6915:                const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 6916:                side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 6917:             } // if isSubmerged
 6918:          } // if is3D
 6919:       } // if iveg   
 6920: 
 6921:       // Computes the friction modified depth, \breve{H} in notes
 6922:       if (side->is2D()) { // 2D
 6923: 
 6924:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 6925:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 6926: 
 6927:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 6928: 
 6929:          side->hhat = htot*htot/fricH; 
 6930: 
 6931:       } else { // 3D
 6932:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 6933: 
 6934:          if constexpr(iveg != 0) {
 6935:             
 6936:             if (side->isSubmerged()) { 
 6937:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 6938:                side->hhat -= veg_c*Hhat_alpha;
 6939: 
 6940:             } else { // Emergent
 6941:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 6942:             }
 6943:          } // if iveg
 6944: 
 6945:          // Enforce positivity for 3D model
 6946:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 6947:       } // if 3D
 6948: 
 6949:    }
 6950: 
 6951: 
 6952: 
 6953:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 6954:    // Computes the density gradient between two elements, e1 and e2.
 6955:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 6956:    // zero in the direction normal to the side. 
 6957:    // 
 6958:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 6959:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 6960:    //
 6961:    // Input:
 6962:    //    e1: Element
 6963:    //    e2: Neighbor element (or nullptr if boundary)
 6964:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 6965:    //    k: Index of the half-level at which the density is interpolated
 6966:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 6967:    // 
 6968:    // Output:
 6969:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 6970:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 6971: 
 6972:       if (e2 == nullptr || e2->isDry) {
 6973:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 6974: 
 6975:          Side *side = e1->sides[j];
 6976:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 6977:                  
 6978:          if constexpr(ics == 1) {
 6979:             vec = side->n; // Normal vector to the side
 6980:          } else {
 6981:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6982:             // IMPLEMENT THIS XXXXXX
 6983:             // !replace with xel, yel?
 6984:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 6985:             //      &eframe(:,:,i),xn1,yn1,tmp)
 6986:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 6987:             //      &eframe(:,:,i),xn2,yn2,tmp)
 6988:          } //ics
 6989:                    
 6990:          diffRho = 0.0;
 6991: 
 6992:       } else { //internal and wet
 6993:          if constexpr(ics==1) {
 6994:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 6995: 
 6996:             // Vector from e1 to e2
 6997:             vec = e2->center - e1->center;
 6998: 
 6999:          } else { 
 7000:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 7001:             // Remember that elem->center is in global coordinates
 7002:             // IMPLEMENT THIS XXXXXX
 7003:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 7004:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 7005:             //                   alow(j)=xctr2
 7006:             //                   bdia(j)=yctr2
 7007:          } // ics
 7008: 
 7009:          diffRho = rho2 - e1->demeanedDensity(k);
 7010:       }
 7011: 
 7012:    }
 7013: 
 7014:    __global__ void computeDensityCubicSplines(void) {
 7015:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 7016: 
 7017:       ELEM(elem);
 7018: 
 7019:       if (elem->isDry) return;
 7020: 
 7021:       const int kb = elem->kb;
 7022: 
 7023:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 7024:       if (elem->is2D()) {
 7025:          // In the 2D case, the density is constant at the prism level. 
 7026:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 7027:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 7028:       } else { //3D
 7029: 
 7030:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 7031:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 7032:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 7033:          ///// XXXX CHECK INDICES!!!!!
 7034:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 7035:       } // 2D/3D
 7036: 
 7037:    }
 7038: } // extern "C"
 7039: 
 7040: 
 7041: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 7042: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 7043: 
 7044:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 7045: 
 7046:    const int kb  = elem->kb;
 7047:    const int kb2 = elem2->kb;
 7048: 
 7049:    // z-coordinate of prism of elem
 7050:    const double zp = elem->z_prism(k);
 7051: 
 7052:    double rho = 0.0;
 7053: 
 7054:    if (elem2->is2D()) {
 7055:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 7056: 
 7057:    } else {  // 3D
 7058: 
 7059:       // eta_min may be < zmax
 7060:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 7061:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 7062: 
 7063:       // (Extrapolate density below bottom, we will fix it later)
 7064:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 7065:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 7066:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 7067:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 7068:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 7069:    } // 2D/3D
 7070:      
 7071: 
 7072:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 7073:    // Now we need to fix it.
 7074:    if (elem->z[k] < elem2->z[kb2]) {
 7075:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 7076: 
 7077:       // There are two methods to adjust the density at the bottom of the element.
 7078:       // iunder_deep=0: 
 7079:       const double depth1 = abs(elem->z[kb]); // larger depth
 7080: 
 7081:       if (iunder_deep==0) {
 7082: 
 7083:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 7084: 
 7085:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 7086: 
 7087:       } else { // iunder_deep != 0
 7088: 
 7089:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 7090: 
 7091:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 7092: 
 7093:          //   Demeaned density at the same z coordinate as
 7094:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 7095:          }
 7096: 
 7097:       } // if iunder_deep
 7098:    } // if elem->z[kb] < elem2->z[kb]
 7099: 
 7100:    return rho;
 7101: }
 7102: 
 7103: 
 7104: extern "C" {
 7105:    __global__ void computeDensityGradient(void) {
 7106: 
 7107:       assert(ibc == 1 && "baroclinic formulation is not implemented yet: ibc != 0");
 7108:       if constexpr(ibc != 0) return;
 7109: 
 7110:          // Compute the horizontal density gradient at each element.
 7111:       // It works in two steps:
 7112:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 7113:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 7114:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 7115:       //             gradRho.r1 = rho1 - rho0
 7116:       //             gradRho.r2 = rho2 - rho0
 7117:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 7118:       // 
 7119:       //  NOTE: We use de-meaned densities.
 7120: 
 7121:       ELEM(elem);
 7122: 
 7123:       if (elem->isDry) return;
 7124: 
 7125:       const int kb  = elem->kb;
 7126:       const int i34 = elem->i34;
 7127: 
 7128:       for (int k = kb + 1; k < nvrt; k++) {
 7129:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 7130:          //             gradRho.r1 = rho1 - rho0
 7131:          //             gradRho.r2 = rho2 - rho0
 7132:          int icount = 0;
 7133:          double sumRx = 0.0;
 7134:          double sumRy = 0.0;
 7135:          for (int j1=0; j1<i34; j1++) { 
 7136: 
 7137:             const int j2 = elem->nxq(j1 + 1);
 7138: 
 7139:             // Pairs of consecutive neighbor elements of elem
 7140:             const Element *e1 = elem->nghbElems[j1];
 7141:             const Element *e2 = elem->nghbElems[j2];
 7142: 
 7143:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 7144:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 7145:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 7146: 
 7147:             // Compute the density difference and the vector from elem to e1 and e2
 7148:             // getRhoDiffAndVec takes into account boundaries/dry elements
 7149:             double diffRho1, diffRho2;
 7150:             Vector2 vec1, vec2;
 7151:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 7152:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 7153: 
 7154:             const double rl1 = length(vec1);
 7155:             const double rl2 = length(vec2);
 7156:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 7157: 
 7158:             const double delta = cross(vec1, vec2);
 7159:             const double sintheta = abs(delta)/(rl1*rl2);
 7160: 
 7161:             // To avoid problems, avoid elements with small angle between vectors
 7162:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 7163:             const bool validEq = (sintheta > sin_one_deg);
 7164: 
 7165:             if (validEq) {
 7166:                // Solve the system of equations to get the density gradient at elem
 7167:                icount++;
 7168:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 7169:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 7170:                sumRx += Rx;
 7171:                sumRy += Ry;
 7172:             }
 7173:          } // for j1
 7174: 
 7175:          // Compute the average density gradient at elem
 7176:          if (icount==0) {
 7177:            // Bad mesh quality; bail out with 0 b-cc
 7178:            elem->gradRho[k] = {0.0, 0.0};
 7179:          } else {
 7180:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 7181:          }
 7182: 
 7183:       } // for k
 7184: 
 7185:    }
 7186: 
 7187:    __global__ void computeBaroclinicTerm(void) {
 7188:    // Computes the baroclinic term at sides (at half levels).
 7189:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 7190:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 7191: 
 7192:       if (ibc == 1) return;
 7193: 
 7194:       SIDE(side);
 7195: 
 7196:       if (side->isDry) return;
 7197: 
 7198:       const Element *e1 = side->elems[0];
 7199:       const Element *e2 = side->elems[1]; 
 7200:       const int kb = side->kb;
 7201:       
 7202:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 7203: 
 7204:       // interpolates vertically the density gradient of the two elements at the half level/
 7205: 
 7206:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 7207:       int k2 = max(kb, nvrt / 2);
 7208: 
 7209:       // Starts the integration at the surface and goes down to the bottom
 7210:       side->bcc[nvrt-1] = {0.0, 0.0};
 7211:       for (int k = nvrt - 2; k >= kb; k--) {
 7212:       // For each prism level (from surface to bottom)...
 7213: 
 7214:          // For both elements, interpolate density gradient at the side's half level.
 7215:          // The gradient at the side is the average of the gradients at the elements.
 7216:          // w1, w2 are used to take into account boundary sides, with just one element.
 7217:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 7218:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 7219:          const double wsum = w1 + w2;
 7220:          w1 = w1/wsum;
 7221:          w2 = w2/wsum;
 7222:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 7223: 
 7224:          // Linear interpolation of both elements' density gradient at the shared side's level.
 7225:          Vector2 gradRho = {0.0, 0.0};
 7226:          if (e1 != nullptr && k > kb) {
 7227:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 7228:             
 7229:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 7230:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 7231:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 7232: 
 7233:             // Grad(rho) vertically interpolated at the side's half level
 7234:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 7235: 
 7236:             // Projects the element density gradient to the side frame if needed.
 7237:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 7238: 
 7239:             // Adds the contribution of the density gradient at the side's half level
 7240:             gradRho += gradRho1*w1;
 7241:          }      
 7242:          if (e2 != nullptr && k > kb) {
 7243:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 7244:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 7245:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 7246:             
 7247:             // Grad(rho) vertically interpolated at the side's half level
 7248:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 7249: 
 7250:             // Projects the element density gradient to the side frame if needed.
 7251:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 7252: 
 7253:             // Adds the contribution of the density gradient at the side's half level
 7254:             gradRho += gradRho2*w2;
 7255:          }
 7256: 
 7257:          
 7258:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 7259:          // multiplied by -rampbc*(g/rho0) 
 7260:          const double grav3 = side->grav3();
 7261:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 7262: 
 7263:       } // for
 7264: 
 7265:    }
 7266: 
 7267: 
 7268: 
 7269:    __global__ void computeHorGradientAtSide(void) {
 7270: 
 7271:       // Compute the horizontal density gradient at each element.
 7272:       // It works in two steps:
 7273:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 7274:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 7275:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 7276:       //             gradRho.r1 = rho1 - rho0
 7277:       //             gradRho.r2 = rho2 - rho0
 7278:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 7279:       // 
 7280:       //  NOTE: We use de-meaned densities.
 7281: 
 7282:       SIDE(side);
 7283: 
 7284: 
 7285:       if (side->isDry) return;
 7286: 
 7287:       // Computes the gradient of the variables at the side center.
 7288:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 7289:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 7290:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 7291: 
 7292:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 7293:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 7294:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 7295:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 7296: 
 7297:    }
 7298: 
 7299: 
 7300:    __global__ void solveMomentumEquations(double time) {
 7301: 
 7302:       double alow[nvrt], cupp[nvrt], bdia[nvrt]; // a = low, c = up, b = diag
 7303:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 7304: 
 7305:       SIDE(side);
 7306: 
 7307:       if (side->isDry) 
 7308:       {
 7309:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 7310: 
 7311:          return;
 7312:       }
 7313: 
 7314:       const Node *n1 = side->n1;
 7315:       const Node *n2 = side->n2;
 7316: 
 7317:       const int kb = side->kb;
 7318: 
 7319:       const double veg_h = side->veg_h();
 7320:       const double grav3 = side->grav3();
 7321: 
 7322:       if (side->is2D()) {
 7323:          // Remember: Do not use htot2, which is updated.
 7324:          const double htot = side->htot1();
 7325:          const double hhat = side->hhat;
 7326: 
 7327:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 7328: 
 7329:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 7330:          const Vector2 tau2 = side->tau();
 7331: 
 7332:          // hat_gam has units of m/s
 7333: 
 7334:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 7335:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 7336:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 7337: 
 7338:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 7339: 
 7340: 
 7341:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 7342: 
 7343:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 7344: 
 7345:       }
 7346:       else { // 3D
 7347: 
 7348:          // For 3D it is necessary to solve an implicit tridiagonal system.
 7349:          // 
 7350:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 7351:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 7352:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 7353:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 7354:          // k+1 and k.
 7355: 
 7356: 
 7357:          const int ndim = nvrt - kb;
 7358:          const double zTopCanopy = side->zTopCanopy();
 7359: 
 7360:          // Initialize the tridiagonal system
 7361:          for (int k = kb + 1; k < nvrt; k++) {
 7362:             
 7363:             const int kin = k - (kb + 1);
 7364: 
 7365:  
 7366:             alow[kin] = 0.0;
 7367:             cupp[kin] = 0.0;
 7368:             bdia[kin] = 0.0;
 7369: 
 7370:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 7371:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 7372: 
 7373:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 7374:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 7375:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 7376: 
 7377:             // First part: layers k, k+1
 7378:             if (k < nvrt - 1) {
 7379:                              
 7380:                if constexpr(iveg != 0) {
 7381: 
 7382:                   // If there is vegetation at this level...
 7383:                   if (zTopCanopy > side->zc[k]) {
 7384:                      // If the canopy is above the k layer...
 7385:                      
 7386:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 7387:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 7388:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 7389:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 7390: 
 7391:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 7392:                      const double vmag2 = length(ut2);
 7393:                      const double vmag1 = length(side->u2[k]);
 7394:                      const double vmag = 0.5*(vmag1 + vmag2);
 7395:                      
 7396:                      // Computes the vegetation alpha at the face center
 7397:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 7398: 
 7399:                      cff1 += veg_alpha_sd*dt*vmag;
 7400: 
 7401:                   } // if (zTopCanopy
 7402:                } // if iveg
 7403: 
 7404:                const double dzz = side->Dz(k + 1);
 7405:                const double dfz = 0.5*(side->dfv(k) + side->dfv(k + 1)); // Vertical viscosity at the face center
 7406:                const double tmp = dt*dfz/dzz;
 7407:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 7408: 
 7409:                cupp[kin] += cff1*dzz/6.0 - tmp;
 7410:                bdia[kin] += cff1*dzz/3.0 + tmp;
 7411:             }
 7412: 
 7413: 
 7414:             // Second part: layers k-1, k
 7415:             if (k > kb + 1) {
 7416: 
 7417:                double cff1 = 1.0; //init \bar{c^k}
 7418: 
 7419:                if constexpr(iveg != 0) {
 7420:                   // If there is vegetation at this level...
 7421:                   if (zTopCanopy > side->zc[k-1]) {
 7422:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 7423:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 7424: 
 7425:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 7426: 
 7427:                      const double vmag2 = length(ut2);
 7428:                      const double vmag1 = length(side->u2[k-1]);
 7429:                      const double vmag = 0.5*(vmag1 + vmag2);
 7430: 
 7431:                      // Computes the vegetation alpha at the face center
 7432:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 7433:                      cff1 += veg_alpha_sd*dt*vmag;
 7434:                   } // if zTopCanopy
 7435: 
 7436:                } // if iveg
 7437: 
 7438:                const double dzz = side->Dz(k);
 7439:                const double dfz = 0.5*(side->dfv(k) + side->dfv(k - 1)); // Vertical viscosity at the face center
 7440:                const double tmp = dt*dfz/dzz;
 7441:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 7442: 
 7443:                alow[kin] += cff1*dzz/6.0 - tmp;
 7444:                bdia[kin] += cff1*dzz/3.0 + tmp;
 7445: 
 7446:             } else { // Bottom boundary
 7447:                // This occurs at the bottom, where the bottom drag is applied.
 7448: 
 7449:                bdia[kin] += dt*side->chi2; // XXXX
 7450: 
 7451:             } // if (k > kb + 1)
 7452: 
 7453: 
 7454:          } // for (int k
 7455: 
 7456: 
 7457: 
 7458:          // Computes the RHS.
 7459:          // -----------------
 7460: 
 7461:          //	BC to be imposed at the end.
 7462: 
 7463:          const Vector2 gradETP  = side->gradETP;
 7464:          const Vector2 gradPr   = side->gradPr;
 7465:          const Vector2 gradEta1 = side->gradEta1;
 7466:          const Vector2 gradEta2 = side->gradEta2;
 7467: 
 7468:          const Vector2 *btu = side->btu;
 7469:          const Vector2 *u2  = side->u2;
 7470:          const double coriolis = side->coriolis;
 7471:          const Vector2 *nuGradU = side->nuGradU;
 7472: 
 7473:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 7474:          for (int k = kb + 1; k < nvrt; k++) {
 7475:             const int kin = k - kb - 1;
 7476: 
 7477:             const double dz_0 = side->Dz(k);
 7478:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 7479: 
 7480:             rrhs[kin] = {0.0, 0.0};
 7481:             double dz = 0.0;
 7482: 
 7483:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 7484:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 7485:             if (k < nvrt  ) dz += dz_1;
 7486:             if (k > kb + 1) dz += dz_0;
 7487: 
 7488:             // Elevation gradient, atmospheric pressure and tidal potential
 7489:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 7490: 
 7491:             // Coriolis, advection, wind stress, and horizontal viscosity
 7492:             if (k < nvrt - 1) {
 7493: 
 7494: 
 7495:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 7496:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 7497:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 7498:                                                 
 7499: 
 7500:                //diff stress tensors 1006
 7501:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 7502:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 7503:                   assert(false && "Not implemented: itur == 5");
 7504:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 7505:                }
 7506:                // else assert(false && "itur # Not implemented");
 7507: 
 7508:             } else { // k == nvrt - 1 SURFACE
 7509:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 7510:                const Vector2 tau2 = side->tau();
 7511: 
 7512:                rrhs[kin] += dt*tau2;          
 7513: 
 7514:             } // if k<nvrt
 7515: 
 7516: 
 7517:             if (k > kb + 1) {
 7518:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 7519:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 7520:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 7521: 
 7522:                // diff stress tensors 1006
 7523:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 7524:                   assert(false && "Not implemented: itur == 5");
 7525:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 7526:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 7527:                }
 7528:                // else assert(false && "itur # Not implemented");
 7529: 
 7530: 
 7531:             } // if k>kbs + 1
 7532: 
 7533:             // Baroclinic
 7534:             Vector2 *bcc = side->bcc;
 7535:             if constexpr(ibc == 0) {
 7536:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 7537:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 7538: 
 7539:             } // if ibc==0
 7540: 
 7541:          } // k=kb + 1,nvrt
 7542: 
 7543: 
 7544:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 7545: 
 7546:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 7547:             const int kin = k - kb - 1;
 7548:    
 7549:             // Velocity is always clamped to maximum values
 7550:             side->u2[k] = clampVelocity(soln[kin]);
 7551:          } // k
 7552: 
 7553:       } // if side->is2D()
 7554:       
 7555: 
 7556:       // Impose velocity boundary condition at the bottom
 7557:       if constexpr(imm == 2) { // 3D bed deformation model
 7558:          double dep;
 7559:          Vector2 vel;
 7560: 
 7561:          assert(false && "Not implemented: imm == 2");
 7562:          //update_bdef(time, x0, y0, dep, vel);
 7563:          // side->u2[kb] = vel;
 7564: 
 7565:       } else { // imm = 0 or 1
 7566:          if (side->Cd() == 0.0) {
 7567:             side->u2[kb] = side->u2[kb + 1];
 7568: 
 7569:          } else if (side->is3D()) { // 3D no slip bottom   
 7570:             side->u2[kb] = {0.0, 0.0};
 7571: 
 7572:          }
 7573:           
 7574:       } // if imm
 7575: 
 7576:       // The velocities below the bottom level are set to zero
 7577:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 7578: 
 7579: 
 7580:    }
 7581: 
 7582: 
 7583:    __global__ void applyMomentumBC(void) {
 7584: 
 7585:       SIDE_BND(sideBnd);
 7586: 
 7587:       Side *side = sideBnd->side;
 7588:       const BoundarySegment *segment = sideBnd->segment;
 7589:       const Node *n1 = side->n1;
 7590:       const Node *n2 = side->n2;
 7591: 
 7592:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 7593: 
 7594:       const bool isLand = segment->isLand;
 7595:       const int ifltype = segment->ifltype;
 7596: 
 7597:       const int kb = side->kb;
 7598: 
 7599: 
 7600:       if (!isLand && ifltype != 0) {
 7601:          const Vector2 *ubc = sideBnd->ubc;
 7602:   
 7603:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 7604:             
 7605:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 7606:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 7607: 
 7608:             if (ifltype == -1) {
 7609:                // Flather 1
 7610: 
 7611:                const double depth = side->depth();
 7612: 
 7613:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 7614: 
 7615:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 7616: 
 7617:                side->u2[k] = vnorm*side->n;
 7618: 
 7619:             } else if (ifltype == -2) { // Discharge
 7620: 
 7621:                const double eta1 = side->eta1();
 7622:                const double eta2 = side->eta2();
 7623:                const double htot = side->htot2();
 7624: 
 7625:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 7626:                assert(false && "Not implemented: Discharge bc");
 7627:                // const double dischrg = discharge(eta1);
 7628:                const double dischrg = 0.0; // XXX REMOVE
 7629:                
 7630: 
 7631:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 7632: 
 7633:                const double vnorm = dischrg*eta2/htot;
 7634: 
 7635:                side->u2[k] = vnorm*side->n;
 7636: 
 7637:             }
 7638:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 7639:                const double vnorm = dot(side->u2[k], side->n);
 7640: 
 7641:                double rat;
 7642:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 7643:                else              rat = segment->vobc2; // outgoing
 7644: 
 7645:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 7646: 
 7647:             }
 7648:             else { // not Flather or 3D radiation
 7649: if (ifltype == 2) printf("XXXXX ubc: %f, %f\n", ubc[k].x, ubc[k].y);
 7650:                side->u2[k] = ubc[k];
 7651: 
 7652:             } // if (segment->ifltype...
 7653: 
 7654:          }
 7655: 
 7656:       }
 7657:       else if (isLand) { // if it is land boundary side
 7658: 
 7659:          if constexpr(islip == 0) { // free slip
 7660: 
 7661:             for (int k = kb; k < nvrt; k++) {
 7662: 
 7663:                const Vector2 t = side->t();
 7664:                const Vector2 n = side->n;
 7665: 
 7666:                double vnorm = 0.0; // for most cases
 7667:                const double vtan = dot(side->u2[k], t);
 7668:                
 7669:                side->u2[k] = vtan*t - vnorm*n;
 7670: 
 7671:             }
 7672: 
 7673:          } else { // no slip
 7674:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 7675: 
 7676:          }
 7677:       } // if (side segment type...
 7678: 
 7679:    }
 7680: 
 7681: 
 7682:    __global__ void shapiroFilter1(void) {
 7683:       // First step of the Shapiro filter (normally used if indvel<=0)
 7684:       // Computes the filtered values and stores them in bcc (as a temporary array).
 7685: 
 7686:       SIDE(side);
 7687: 
 7688:       // Only internal wet sides are processed
 7689:       if (side->isDry || !(side->isInternal())) return;
 7690: 
 7691:       const int kb = side->kb;
 7692: 
 7693:       for (int mm = 0; mm < niter_shap; mm++) {
 7694: 
 7695:          for (int k = kb + 1; k < nvrt; k++) {
 7696:             // WARNING: reusing bcc as a temporary array to store the suru values.
 7697:             Vector2 suru = {0.0, 0.0};
 7698: 
 7699:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 7700: 
 7701:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 7702: 
 7703:                int kin = k;
 7704:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 7705:                
 7706:                // Get the velocity at the neighbor's side.
 7707:                Vector2 nSideU2 = nSide->u2[kin];
 7708: 
 7709:                // Projects the velocity to the current side frame if needed.
 7710:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 7711: 
 7712:                suru += nSideU2;
 7713:             }
 7714: 
 7715:             // Reusing bcc as a temporary array to store the suru values.
 7716:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 7717: 
 7718:          }
 7719:       }
 7720:    }
 7721: 
 7722:    __global__ void shapiroFilter2(void) {
 7723:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 7724: 
 7725:       SIDE(side);
 7726: 
 7727: 
 7728:       if (side->isDry || !(side->isInternal())) return;
 7729: 
 7730:       const int kb = side->kb;
 7731: 
 7732:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 7733: 
 7734:       if (side->is2D()) {
 7735:          side->u2[kb + 1] = side->bcc[kb + 1];
 7736:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 7737: 
 7738:       } else {
 7739:          // 3D
 7740:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 7741:          
 7742:       }
 7743: 
 7744:    }
 7745: 
 7746: 
 7747:    __global__ void ul0UpdateZCoords(void) {
 7748:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 7749:       
 7750:       NODE(node);      
 7751: 
 7752: 
 7753:       if (false) { //node->isDry) { XXXXXXX
 7754: 
 7755:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 7756: 
 7757:          if constexpr(ivcor != 1) node->kb = 0;
 7758: 
 7759:       } else {
 7760: 
 7761:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 7762:          node->updateKb();
 7763: 
 7764:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 7765: 
 7766:       }
 7767: 
 7768:       // We use the temp.b field to store the previous state of isDry.
 7769:       node->tmp.b = node->isDry;
 7770: 
 7771:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 7772:       node->isDry = true;
 7773: 
 7774:    }
 7775: 
 7776:    __global__ void ul0ComputeDryElements(void)
 7777:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 7778:    {
 7779:       ELEM(elem);
 7780: 
 7781:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 7782: 
 7783:       elem->kb = 0;
 7784: 
 7785:       if (elem->isDry) return;
 7786: 
 7787: 
 7788:    //    if(elem->isDry2()) { // XXXX
 7789:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 7790:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 7791:    //        call parallel_abort(errmsg)
 7792:    //    }
 7793: 
 7794:       const Node *n1 = elem->nodes[0];
 7795:       const Node *n2 = elem->nodes[1];
 7796:       const Node *n3 = elem->nodes[2];  
 7797:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 7798: 
 7799:       // Computes element's kb as the minimum of the nodes' kb.
 7800:       const int kb1 = n1->kb;
 7801:       const int kb2 = n2->kb;
 7802:       const int kb3 = n3->kb;
 7803:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 7804: 
 7805: 
 7806:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 7807: 
 7808: 
 7809:       // Computes the element z as the mean of the nodes z.
 7810:       for (int k = elem->kb; k < nvrt; k++) {
 7811: 
 7812:          // Compute the element z as the mean of the nodes z.
 7813:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 7814:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 7815:          elem->z[k] /= elem->i34;
 7816: 
 7817:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 7818:       }
 7819:                   
 7820:    }
 7821: 
 7822:    __global__ void ul0ComputeDryNodes(void)
 7823:    // Updates node's isDry based on the elements' isDry. 
 7824:    {
 7825:       NODE(node);
 7826: 
 7827:       node->isDry = true;
 7828: 
 7829:       // A node is wet if at least one of the elements sharing it is wet.
 7830:       for (int j = 0; j < node->numElements; j++) {
 7831:          const Element *elem = node->elements[j];
 7832:          if (!elem->isDry) {
 7833:             node->isDry = false;
 7834:             break;
 7835:          }
 7836:       }
 7837: 
 7838:        
 7839:    }
 7840: 
 7841: 
 7842:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 7843:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 7844:    // node->tmp.b is true if the node was previously dry.
 7845:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 7846:    {
 7847:       NODE(node);
 7848:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 7849: 
 7850:       // Avoid this the first time step.
 7851:       if (it == iths) return;  
 7852: 
 7853:       const bool wasDry = node->tmp.b;
 7854: 
 7855: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 7856: 
 7857:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 7858: 
 7859:          for (int k=0; k < nvrt; k++) {
 7860: 
 7861:             Vector3 utmp={0.0, 0.0, 0.0};
 7862: 
 7863:             double ttmp=0.0;
 7864:             double stmp=0.0;
 7865:             int icount=0;
 7866:             for (int j = 0; j < node->numNodes; j++) {
 7867: 
 7868:                const Node *nbrNode = node->nodes[j];
 7869:                
 7870:                const bool wasNbrDry = nbrNode->tmp.b;
 7871: 
 7872:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 7873:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 7874: 
 7875:                   icount++;
 7876: 
 7877:                   // Assume small element size in wet/dry zone so pframes are close to each other
 7878:                   utmp += nbrNode->uvw2(k);
 7879:                   
 7880:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 7881:                   stmp += nbrNode->tracers[k].tracer[1]; 
 7882:                }
 7883:             }
 7884: 
 7885:             if (icount > 0) {
 7886:                const double inv_icount = 1.0/icount;
 7887:                utmp = inv_icount*utmp;
 7888:                node->u2[k]     = {utmp.x, utmp.y};
 7889:                node->w2[k]     = utmp.z;
 7890:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 7891:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 7892:             } else {
 7893:                node->u2[k] = {0.0, 0.0};
 7894:                node->w2[k] = 0.0;
 7895:                // Initialize tracers to 0.0??? XXXXX
 7896:             }
 7897:          }
 7898:       }
 7899:    }
 7900: 
 7901:   
 7902:    
 7903: 
 7904: 
 7905:    __global__ void ul0UpdateSides(int it, int iths) {
 7906:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 7907:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 7908:    // The dryness of the sides is updated in ul0UpdateSides2.
 7909: 
 7910:       SIDE(side);
 7911: 
 7912:       // A side is wet if and only if at least one of its elements is wet.
 7913:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 7914:  
 7915:       const Node *n1 = side->n1;
 7916:       const Node *n2 = side->n2;
 7917:      
 7918:       const int kb1 = n1->kb;
 7919:       const int kb2 = n2->kb;
 7920: 
 7921:       side->kb = 0; // default when dry
 7922: 
 7923:       if (isWet) {
 7924: 
 7925:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 7926: 
 7927:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 7928: 
 7929:          side->kb = min(kb1, kb2);
 7930: 
 7931:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 7932: 
 7933:          for (int k = side->kb; k < nvrt; k++) {
 7934:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 7935: 
 7936:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 7937: 
 7938:             // Compute velocity for re-wetted sides 
 7939:             if ((it != iths) && (side->isDry && isWet)) {
 7940: 
 7941:                Vector2 utmp={0.0, 0.0};
 7942: 
 7943:                int icount=0;
 7944: 
 7945:                // For all the sides on the two elements that share this side
 7946:                for (int j = 0; j < 2; j++) {
 7947:                   const Element *elem = side->elems[j];
 7948:                   if (elem == nullptr) continue;
 7949: 
 7950:                   for (int jj=0; jj < elem->i34; jj++) {
 7951:                      const Side *nSide = elem->sides[jj];
 7952:                      if (nSide->isDry) continue;
 7953: 
 7954:                      icount++;
 7955:                      utmp += nSide->u2[k];  
 7956:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 7957:                   }
 7958:                }
 7959:                   
 7960:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 7961:                if (icount > 0)  side->u2[k] = utmp/icount;
 7962:                else             side->u2[k] = {0.0, 0.0};
 7963:                   
 7964:             } // if ((it != iths) && (side->isDry && isWet))
 7965: 
 7966:          } // for k
 7967: 
 7968:       } // if isWet 
 7969:       
 7970: 
 7971: 
 7972:    }
 7973: 
 7974:    __global__ void ul0UpdateSides2(void) {
 7975:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 7976:    
 7977:          SIDE(side);
 7978:    
 7979:          const Element *e1 = side->elems[0];
 7980:          const Element *e2 = side->elems[1];
 7981: 
 7982:          // A side is wet if and only if at least one of its elements is wet.
 7983:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 7984: 
 7985:          // Update the side's dryness
 7986:          side->isDry = !isWet;
 7987: 
 7988:    }
 7989: 
 7990: 
 7991:    __global__ void zeroNodalVelocities(void) {
 7992:       NODE(node);
 7993: 
 7994:       for (int k = 0; k < nvrt; k++) {
 7995:          node->u2[k]   = {0.0, 0.0};
 7996:          node->w2[k]   = 0.0;
 7997:          node->utmp[k] = {0.0, 0.0};         
 7998:       }
 7999:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 8000:    }
 8001:  
 8002: 
 8003:    __global__ void computeNodalVerticalVelocities1(void) {
 8004:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 8005:    // Adds the element's vertical velocity times the element's area.
 8006:       ELEM(elem);
 8007: 
 8008:       for (int j = 0; j < elem->i34; j++) {
 8009:          Node *node = elem->nodes[j];
 8010: 
 8011:          for (int k = node->kb; k < nvrt; k++) {
 8012:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 8013:          }
 8014:          atomicAdd(&(node->tmp.d), elem->area);
 8015:       }
 8016:    }
 8017: 
 8018:    __global__ void computeNodalVerticalVelocities2(void) {
 8019:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 8020:    // Divides by the total area of the elements sharing the    node.
 8021:       NODE(node);
 8022: 
 8023: 
 8024:       const double invArea = 1.0 / node->tmp.d;
 8025:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = invArea*node->w2[k];  // node->tmp.d contains the total area of the elements sharing the node
 8026: 
 8027:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 8028:    }
 8029: 
 8030: 
 8031:    __global__ void computeNodalHorizontalVelocities1(void) {
 8032: 
 8033:       assert(indvel <= 0 && "computeNodalHorizontalVelocities1 only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 8034: 
 8035:       ELEM(elem);
 8036: 
 8037:       if (elem->isDry) return;
 8038: 
 8039:       const int kb = elem->kb;
 8040:       const bool isTri = elem->isTri();
 8041: 
 8042:       if constexpr(indvel <= 0) {
 8043:          // Assuming discontinous hvel.
 8044: 
 8045:          if (isTri) { // For triangles
 8046:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 8047:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 8048:             #pragma unroll
 8049:             for (int j = 0; j < 3; j++) {
 8050:                // For every node of the triangle...
 8051:                Node *node = elem->nodes[j];
 8052: 
 8053:                if (node->isDry) continue;
 8054: 
 8055:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 8056:                const Side *s2 = elem->sides[(j + 1) % 3];
 8057:                const Side *s3 = elem->sides[(j + 2) % 3];
 8058: 
 8059:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 8060: 
 8061:                atomicAdd(&(node->tmp.i), 1);
 8062: 
 8063:                for (int k = kb; k < nvrt; k++)  {
 8064:                   Vector2 s1u2 = s1->u2[k];
 8065:                   Vector2 s2u2 = s2->u2[k];
 8066:                   Vector2 s3u2 = s3->u2[k];
 8067: 
 8068:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 8069:                   if constexpr(ics == 2) {
 8070:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 8071:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 8072:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 8073:                   }
 8074: 
 8075:                   Vector2 u = s2u2 + s3u2 - s1u2; // u extrapolated linearly at node j.   
 8076:                   u = clampVelocity(u);
 8077:                   atomicAdd(&(node->utmp[k].x), u.x);
 8078:                   atomicAdd(&(node->utmp[k].y), u.y);
 8079: 
 8080:                }
 8081: 
 8082:             }
 8083:          }
 8084:          else { // For quads
 8085: 
 8086: 
 8087:             // Compute the bilinear coordinates of the center of each diagonal.
 8088:             double xi, eta;
 8089:             double shp13[4], shp24[4];
 8090:             Point2 x0, x1, x2, x3;
 8091:             elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 8092:             const Point2 p13 = 0.5 * (x0 + x2);   // Center of sides 1 & 3
 8093:             const Point2 p24 = 0.5 * (x1 + x3);   // Center of sides 2 & 4
 8094: 
 8095:             elem->inverseBilinearQuad(p13, xi, eta, shp13);
 8096:             elem->inverseBilinearQuad(p24, xi, eta, shp24);
 8097: 
 8098: 
 8099: 
 8100: 
 8101:             for (int k = kb; k < nvrt; k++) {
 8102: 
 8103:                //Each quad is split into two triangles. For each triangle we extrapolate as we did for triangles.
 8104:                Vector2 sideU[4];
 8105:                #pragma unroll
 8106:                for (int j = 0; j < 4; j++) {
 8107:                   Vector2 u = elem->sides[j]->u2[k];
 8108:                   if constexpr(ics == 2) u = elem->sides[j]->frame.projHorVec(u, elem->frame);
 8109:                   sideU[j] = u;
 8110:                }
 8111: 
 8112:                Vector2 ud1 = shp13[0]*sideU[0] + shp13[1]*sideU[1] + shp13[2]*sideU[2] + shp13[3]*sideU[3];
 8113:                Vector2 ud2 = shp24[0]*sideU[0] + shp24[1]*sideU[1] + shp24[2]*sideU[2] + shp24[3]*sideU[3];
 8114: 
 8115:                Vector2 ufg0 = clampVelocity(sideU[2] + sideU[3] - ud2);  // node 1: sides 3,4
 8116:                Vector2 ufg1 = clampVelocity(sideU[0] + sideU[3] - ud1);  // node 2: sides 1,4
 8117:                Vector2 ufg2 = clampVelocity(sideU[0] + sideU[1] - ud2);  // node 3: sides 1,2
 8118:                Vector2 ufg3 = clampVelocity(sideU[1] + sideU[2] - ud1);  // node 4: sides 2,3
 8119:                const Vector2 ufg[4] = {ufg0, ufg1, ufg2, ufg3};
 8120:                #pragma unroll
 8121:                for (int j = 0; j < 4; j++) {
 8122:                   Node *node = elem->nodes[j];
 8123:                   if (node->isDry) continue;
 8124: 
 8125:                   if (k == kb) atomicAdd(&(node->tmp.i), 1);
 8126:                   atomicAdd(&(node->utmp[k].x), ufg[j].x);
 8127:                   atomicAdd(&(node->utmp[k].y), ufg[j].y);
 8128:                }
 8129:             }
 8130: 
 8131:          }
 8132: 
 8133:       }
 8134:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 8135:       
 8136:    }
 8137: 
 8138: 
 8139:    __global__ void computeNodalHorizontalVelocities2(void) {
 8140:       NODE(node);
 8141: 
 8142:       const int nodeCount = node->tmp.i;
 8143: 
 8144:       if (nodeCount == 0) 
 8145:       {
 8146:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 8147:          return;
 8148:       }
 8149: 
 8150:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 8151:       
 8152:       const int kb = node->kb;
 8153: 
 8154:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 8155:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 8156:       
 8157:       
 8158:    }   
 8159: 
 8160:  
 8161: 
 8162:    __global__ void resetVelocityOpenBndNodes(void) {
 8163:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 8164: 
 8165:       NODE_BND(nodebnd);
 8166: // printf("DDDDDDDDDD\n");  // XXXXXXX
 8167:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 8168:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 8169:       }
 8170: 
 8171:    }
 8172: 
 8173: 
 8174:    __global__ void setVelocityOpenBndNodes(void) {
 8175:    // For open boundary nodes sets their velocity to the imposed values.
 8176: 
 8177:       SIDE_BND(sidebnd);
 8178: 
 8179:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 8180:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 8181:          // to its segment to the average of the side velocity.
 8182: 
 8183:          for (int k = 0; k < nvrt; k++) {
 8184:             Node *n1 = sidebnd->side->n1;
 8185:             Node *n2 = sidebnd->side->n2;
 8186: 
 8187: 
 8188:             Vector2 &n1_u2 = n1->u2[k];
 8189:             Vector2 &n2_u2 = n2->u2[k];
 8190: 
 8191:             if (n1->nodeBnd->segment == sidebnd->segment) {
 8192:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 8193:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 8194:             }
 8195:             if (n2->nodeBnd->segment == sidebnd->segment) {
 8196:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 8197:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 8198:             }
 8199: 
 8200:          }
 8201: 
 8202:       }
 8203: 
 8204:    }
 8205: 
 8206: 
 8207:    __global__ void computeVerticalVelocity(void) {
 8208:       // Computes the vertical velocity at the (2D) element's centroid.
 8209:       // In this function we will be considering volumetric elements, with side faces and a 
 8210:       // bottom and a top face. We will call them SFs, BF and TF.
 8211:       // It computes the flux coming from BF and the SFs.
 8212:       // If the bed is moving, it takes that into account.
 8213:       // Since water is incompressible, the integral of the velocity times the normal vector
 8214:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 8215:       // and the BF is equal to the flux going out from the TF.
 8216:       // TF = - BF - sum(SFs).
 8217:       // It then computes the horizontal velocity at the center of TF.
 8218:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 8219:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 8220:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 8221: 
 8222:       ELEM(elem);
 8223: 
 8224:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 8225: 
 8226:       if (elem->isDry) return;
 8227: 
 8228:       const int kb = elem->kb;
 8229:       const bool isTri = elem->isTri();
 8230: 
 8231:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 8232: 
 8233:       // Compute the bottom velocity
 8234:       if constexpr(imm != 0) {
 8235:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 8236:       }
 8237: 
 8238: 
 8239:       double bottomArea3D;
 8240:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 8241: 
 8242:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 8243: 
 8244:       double topArea3D;
 8245: 
 8246:       // Bottom face flux
 8247:       double bottomFlux = 0.0;
 8248:       Vector2 u2meanBottom = {0.0, 0.0};
 8249:       const Vector2 gradh = elem->grad2(&Node::depth);
 8250:       if constexpr(imm==2) {
 8251:          Vector3 ubed;
 8252: 
 8253:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 8254:          // updateBDEF(ubed);
 8255:      
 8256:          // const double bflux0 = dot(ubed, elem_bottom_n);
 8257: 
 8258:          // elem->w[kb] += ubed.z;
 8259:       }
 8260:       else {
 8261: 
 8262:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 8263:   
 8264:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 8265:          // in the direction of motion.
 8266:          const double bottomW = - dot(gradh, u2meanBottom);  
 8267:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 8268: 
 8269:          // VElocity associated to the bed deformation
 8270:          double bedVelocity = 0.0;
 8271:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 8272: 
 8273:          elem->w[kb] = bedVelocity + bottomW; 
 8274: 
 8275:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 8276:          
 8277:       } // if imm
 8278: 
 8279:       // Compute w for kb+1 to nvrt-1
 8280:       for (int l = kb; l < nvrt - 1; l++) {
 8281: 
 8282:          // normal vector to the top face of the "volumetric" element (3D)
 8283:          Vector3 elem_top_n = elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 8284: 
 8285:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 8286:          assert(elem_top_n.z > 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 8287: 
 8288:          // Compute the total flux at the sides
 8289:          double sideFlux = 0.0;
 8290: 
 8291:          for (int j = 0; j < elem->i34; j++) {
 8292:             const Side *side = elem->sides[j];
 8293:             const int kbs = side->kb;
 8294:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 8295:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 8296:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 8297: 
 8298:             // The area is "clamped" meaning that it takes kb into account.
 8299:             const double sideArea = side->areaClamped(l + 1);
 8300: 
 8301:             const double sign = elem->ssign[j]; 
 8302: 
 8303:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 8304:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 8305:          }
 8306:          
 8307:          // Compute the horizontal velocity at the center of the top face as an average of the 
 8308:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 8309:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 8310: 
 8311:          // The flux at the top ace can be computed from the other flows.
 8312:          // All fluxes are in directions into the prism.
 8313:          const double topFlux = - sideFlux - bottomFlux;
 8314: 
 8315:          // Flux at the top face due to the horizontal velocities only
 8316:          // topFlux = topHorizontalFlux + topVerticalFlux
 8317:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 8318: 
 8319:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + sideFlux + bottomFlux = 0, so:
 8320:          const double topVerticalFlux = topFlux - topHorizontalFlux;  
 8321: 
 8322:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 8323: 
 8324:          bottomFlux = -topFlux;
 8325:          
 8326:       }
 8327: 
 8328:    }  
 8329: 
 8330: 
 8331: 
 8332: 
 8333: 
 8334: 
 8335: 
 8336: // !===============================================================================
 8337: // !===============================================================================
 8338: 
 8339: } // extern "C"
 8340: 
 8341: #ifdef DONTCOMPILE
 8342: __device__ void computeVerticalAdvection(void) {
 8343:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 8344: 
 8345:    sdbt(1:2,:,:)=0.d0
 8346: 
 8347:    const Side *side = FROM kernel;
 8348: 
 8349:    if(side->isDry) return;
 8350: 
 8351:    // If side is wet...
 8352: 
 8353: 
 8354:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 8355:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 8356:    double ws[nvrt] = {} // w @ side
 8357:    int icount = 0;
 8358:    for (int j=0; j<2; j++) {
 8359:       const Element *elem = side->elements[j];
 8360:        
 8361:       if(elem != nullptr) {
 8362:          icount++;
 8363:          for (int k=0; k<nvrt; k++) {
 8364:             ws[k] = ws[k] + elem->w[k];
 8365:          }
 8366:       }
 8367:    }  // for j
 8368: 
 8369:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 8370:    ws = ws/icount;
 8371: 
 8372:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 8373:    // Splines allow for a smooth transition between vertical levels.
 8374:    // Splines have continuity restrictions at the internal knots, but
 8375:    // we have to provide the 1st derivatives at the endpoints.
 8376:    const int kbs = side->kbs; 
 8377:    
 8378:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 8379:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 8380:    initCubicSpline(kbs, nvrt, side, ws, up)
 8381: 
 8382:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 8383:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 8384:    initCubicSpline(kbs, nvrt, side, ws, vp)
 8385: 
 8386:    // Total advection (average onto side)
 8387:    const Node *node1 = side->nodes[0];
 8388:    const Node *node2 = side->nodes[1];
 8389:    for (int k=kbs(i); k<nvrt; k++) {
 8390: 
 8391:       Vector2 bcc1 = node1->bcc[k];
 8392:       Vector2 bcc2 = node2->bcc[k];
 8393:       if constexpr(ics == 2) {
 8394:          // Project the velocities from the node frames to the side frame
 8395:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 8396:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 8397:       }
 8398: 
 8399:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 8400:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 8401: 
 8402:    }
 8403: }
 8404: #endif
 8405: 
 8406: 
 8407: extern "C" {
 8408:    __global__ void computeElemAverageGhat(void) {
 8409:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 8410: 
 8411:       ELEM(elem);
 8412:       
 8413:       elem->ghat1= {0.0, 0.0};  
 8414: 
 8415:       if constexpr(ihydraulics != 0) {
 8416:          if (nhtblocks > 0 && elem->isblock) return;
 8417:       }
 8418: 
 8419:       
 8420:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 8421:       // cff1-3: coefficients for 2D/3D
 8422: 
 8423:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 8424:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 8425:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 8426: 
 8427:       if (elem->isDry) return;
 8428: 
 8429:       // Average of the coefficients
 8430:       double av_cff1 = 0.0;  // av. for cff1
 8431:       double av_cff2 = 0.0;  // av. for cff2
 8432:       double av_cff3 = 0.0;  // av. for cff3
 8433:       double av_df = 0.0;  // av. for H^\alpha / H
 8434:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 8435:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 8436: 
 8437:       const int i34 = elem->i34;
 8438:       const int kb  = elem->kb;
 8439: 
 8440:       for (int j=0; j<i34; j++) {
 8441:          // For each node and side in the element...
 8442: 
 8443:          const Node *node = elem->nodes[j];
 8444:          const Side *side = elem->sides[j];
 8445: 
 8446:          const double chi      = side->chi;
 8447:          const double veg_c2   = side->veg_c2;
 8448:          const double veg_beta = side->veg_beta;
 8449:          const double veg_h    = side->veg_h();
 8450:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 8451: 
 8452:          const Vector2 gradPhi = elem->gradPhi[j];
 8453: 
 8454:          // Node - const in elem
 8455:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 8456:          elem->gradPr  += node->pr  *gradPhi;
 8457: 
 8458:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 8459: 
 8460:         
 8461:          const double htot  = side->htot2();        // Total depth at the side
 8462:          const double zctr2 = side->zTopCanopy();  
 8463: 
 8464:          double cff1; 
 8465:          double cff2; 
 8466:          double cff3;   
 8467:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 8468:          // coefficients applied to 2D/3D case 
 8469:             cff1 = side->hhat/htot;
 8470:             cff2 = 0.0;
 8471:             cff3 = 0.0;
 8472:          } else { //3D
 8473:             //Init for no-veg case
 8474:             cff1 = 1.0;
 8475:             cff2 = 1.0;
 8476:             cff3 = 0.0;
 8477: 
 8478:             if constexpr(iveg != 0) {
 8479:                // Computes coefficients used with vegetation terms G1, G2
 8480:                // cff1, cff3 are used for the first two terms in G1, G2:
 8481:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 8482:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 8483:                // In general, cff1*Ustar - cff3*Ustar_alpha
 8484:                if(veg_h < 0.99*htot) { // submergent vegetation
 8485:                   cff1 = 1.0;
 8486:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 8487:                   cff3 = veg_c;
 8488: 
 8489:                } else { // emergent vegetation
 8490:                   cff1 = 1.0/(1.0 + veg_c2);
 8491:                   cff2 = cff1;
 8492:                   cff3 = 0.0;
 8493: 
 8494:                }
 8495:             } // if iveg
 8496:          } //  2D/3D
 8497: 
 8498:          av_cff1 += cff1/i34;
 8499:          av_cff2 += cff2/i34;
 8500:          av_cff3 += cff3/i34;
 8501:          av_cff2_chi += cff2*chi/i34;
 8502:          av_cff3_chi += cff3*chi/i34;
 8503:          av_df += min(htot, veg_h)/(htot*i34);
 8504: 
 8505: 
 8506:          // btrack values: U^\star, U^{\star\alpha}
 8507:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 8508:          Vector2 Ustar       = {0.0, 0.0}; 
 8509:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 8510: 
 8511:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 8512:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 8513:          } else { //3D
 8514:             for (int k = side->kb + 1; k < nvrt; k++) {
 8515:             
 8516:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 8517:                Ustar += w2;
 8518: 
 8519:                if constexpr(iveg != 0) {
 8520:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 8521:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 8522:                        Ustar_alpha += zrat*w2; // XXXX
 8523:                    }
 8524:                }  // if iveg
 8525:             }  // for k
 8526:          }  //2D/3D
 8527: 
 8528:          // If needed, project the side velocities to the element frame
 8529:          if constexpr(ics==2) {
 8530:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 8531:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 8532:          }
 8533:         
 8534: 
 8535:          // Add btrack & surface stress terms to \breve{G} first
 8536:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 8537: 
 8538: 
 8539:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 8540:          Vector2 tau    = side->tau();  
 8541:          Vector2 ubstar = side->btu[side->kb + 1];  
 8542: 
 8543:          // If needed, project tau and ubstar to the element frame
 8544:          if constexpr(ics==2) {
 8545:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 8546:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 8547:          }
 8548: 
 8549:          // Term for surface and bottom stress
 8550:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 8551: 
 8552: 
 8553:          // All terms in F,F^\alpha,f_b except baroclinic
 8554:          // F, f_b: all explicit terms excluding vegetation 
 8555:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 8556:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 8557:          const double coriolis = side->coriolis;
 8558:          Vector2 F  =  coriolis*side->U;  // F_x
 8559:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 8560:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 8561: 
 8562:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 8563:             
 8564:             for (int k = side->kb; k < nvrt; k++) {
 8565:                if (zctr2 > side->zc[k-1]) {
 8566:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 8567:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 8568:                    Fa +=  coriolis*w2*zrat;
 8569:                } // if zctr2
 8570:             } // k
 8571:          } // iveg
 8572: 
 8573:          // Integrate horizontal viscosity force vertically
 8574:          for (int k=side->kb + 1; k<nvrt; k++) {
 8575:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 8576: 
 8577:             F += levelHorVisc;
 8578: 
 8579:             // Vegetation term
 8580:             if constexpr(iveg!=0) {
 8581:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 8582:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 8583:                   Fa += levelHorVisc*zrat;
 8584:                } 
 8585:             } // if iveg
 8586:          } // for k
 8587: 
 8588:          // Get nu*grad(U) at the side's bottom level
 8589:          Vector2 nuGradU = side->nuGradU[side->kb];
 8590: 
 8591:          fb += nuGradU;
 8592: 
 8593:          // If needed, project vectorsF, fb and Fa to the element frame
 8594:          if constexpr(ics==2) {
 8595:             F    = side->frame.projHorVec(F,    elem->frame);
 8596:             fb   = side->frame.projHorVec(fb,   elem->frame);
 8597:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 8598:          } // if ics
 8599: 
 8600:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 8601:       } // for j (nodes and sides)
 8602: 
 8603:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 8604: 
 8605: 
 8606:       // Finish off terms in F, F^\alpha and f_b
 8607:       const double grav3 = elem->mean(&Node::grav2);
 8608:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 8609:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 8610:       for (int j=0; j<i34; j++) { 
 8611:          // For each side in the element...
 8612:          const Side *side = elem->sides[j];
 8613:          const double chi = side->chi;
 8614: 
 8615:          const double htot = side->htot2();
 8616:          const double veg_h = side->veg_h();
 8617:          const Vector2 F  = htot*fb;
 8618:          const Vector2 Fa = min(htot, veg_h)*fb;
 8619: 
 8620:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 8621:       } // for j
 8622: 
 8623:       // tmp is already in elem frame
 8624:       elem->ghat1 += tmp/i34;
 8625: 
 8626:       // Baroclinic force
 8627:       if constexpr(ibc==0) {
 8628:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 8629: 
 8630:          Vector2 Fa = {0.0, 0.0};
 8631:          Vector2 intGradRho = {0.0, 0.0};
 8632:          
 8633:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 8634:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 8635:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 8636: 
 8637:             // \in F [m^2/s/s]
 8638:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 8639:          }
 8640: 
 8641:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 8642:          const Vector2 F = av_df*Fa; //approx
 8643:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 8644: 
 8645:       } // if ibc 
 8646: 
 8647: 
 8648: 
 8649:    } 
 8650: 
 8651: 
 8652: 
 8653: 
 8654: 
 8655: // ------------------------------------------------------------
 8656: // Transport
 8657: // ------------------------------------------------------------
 8658: 
 8659: __device__ bool TransportElem<TransportModel::Upwind>::use1stOrderUpwind(const Element *elem) const {
 8660:    if (itvd) {
 8661:       // Marked as such in tvd.prop: always 1st order upwind for this element
 8662:       return true;
 8663:    }
 8664: 
 8665:    // If any node of the element is shallow, use 1st order upwind
 8666:    for (int j = 0; j < elem->i34; j++) {
 8667:       if (elem->nodes[j]->htot2() < h_tvd) return true;
 8668:    }
 8669:    return false;
 8670: }
 8671: 
 8672: __device__ void TransportElem<TransportModel::Upwind>::savePrevTraces(const Element *elem) {
 8673:    for (int k = 0; k < nvrt; k++) prevTraces[k] = elem->tracers[k];
 8674: }
 8675: 
 8676: __device__ double TransportElem<TransportModel::Upwind>::maxPrismDt(const Element *elem, int k) const {
 8677:    if (inflow[k] == 0.0) return huge_double;
 8678:    return elem->volume(k - 1) / inflow[k] * (1.0 - 1.0e-6);
 8679: }
 8680: 
 8681: __global__ void computeHorizAdvecFluxes(void) {
 8682: 
 8683: 
 8684:    SIDE(side)
 8685: 
 8686:    auto &transport = side->transport;
 8687: 
 8688:    for (int k = 0; k < nvrt; k++) transport.Qh[k] = -1.0e34; // Sentinel value for dry sides.
 8689: 
 8690:    if (side->isDry) return;
 8691: 
 8692:    const bool isLand = (side->sideBnd!=nullptr && side->sideBnd->segment != nullptr && side->sideBnd->segment->isLand);
 8693:    const int kb = side->kb;
 8694: 
 8695:    for (int k = kb + 1; k < nvrt; k++) {
 8696:       if (isLand) {
 8697:          transport.Qh[k] = 0.0;
 8698: 
 8699:       } else {
 8700:          const Vector2 n = side->n; // normal vector to the side
 8701:          const double area = side->area(k); // Area of the side face.
 8702:          const double vnor1 = dot(n, side->u2[k]);
 8703:          const double vnor2 = dot(n, side->u2[k-1]);
 8704:          const double vnor_c = 0.5*(vnor1 + vnor2); // Normal velocity at the face center.
 8705: 
 8706:          transport.Qh[k] = area*vnor_c; 
 8707:       }
 8708: 
 8709:    }
 8710: 
 8711: }
 8712: 
 8713: __global__ void horizontalAdvectionPrepare(void) {
 8714: 
 8715:    // Horizontal advection kernel.
 8716:    // -------------------------------
 8717: 
 8718:    // In this model, equations are written in such a way that concentration at time t+1 are computed from
 8719:    // *differences* of concentrations at the cell underconsideration and concentrations upwind of it. 
 8720:    // (how upwind is determined depends on the scheme)
 8721:    // 
 8722:    // For the 1st order upwind scheme, "upwind concentration" at outflow faces is the concentration at the cell itself.
 8723:    // So only inflow faces contribute to the concentration change at the cell.
 8724: 
 8725:    // In the implementation, we do 1st order independently and then consider TVD as an additional update term computed as 
 8726:    // as a sum over all faces (inflow and outflow).
 8727: 
 8728: 
 8729:    // Compute total inflow and maximum allowed sub-time step
 8730:    ELEM(elem)
 8731: 
 8732:    const int kb = elem->kb;
 8733:    const int i34 = elem->i34;
 8734:    auto &transport = elem->transport;
 8735: 
 8736:    if (elem->isDry) return;
 8737: 
 8738:    // Snapshot current prism tracers for this substep (Update reads prevTraces).
 8739:    transport.savePrevTraces(elem);
 8740: 
 8741:    elem->transport.maxDt = huge_double;
 8742: 
 8743:    for (int k = 0; k < kb + 1; k++) elem->transport.inflow[k] = 0.0;
 8744: 
 8745:    for (int k = kb + 1; k < nvrt; k++) { // For each wet prism in the element...
 8746: 
 8747:       transport.inflow[k] = 0.0;
 8748: 
 8749:       for (int j = 0; j < i34; j++) { // For each side in the element...
 8750:          const Side *side = elem->sides[j];
 8751:          const auto &sideTransport = side->transport;
 8752:          const double ssign = elem->ssign[j];
 8753:          const int kbs = side->kb;
 8754: 
 8755:          if (k <= kbs) continue;
 8756: 
 8757:          // Get the element at the other end of side j.
 8758:          const Element *neighElem = side->otherElem(elem);
 8759:          if (neighElem == nullptr || neighElem->isDry) continue;
 8760: 
 8761:          const double faceQ = sideTransport.Qh[k];
 8762:          const bool inFlux = (ssign*faceQ) < 0.0; // true if the flux points into the element
 8763: 
 8764:          const BoundarySegment *boundarySegment = (side->sideBnd == nullptr) ? nullptr : side->sideBnd->segment;
 8765:          const bool isLand = (boundarySegment != nullptr && boundarySegment->isLand);
 8766: 
 8767:          // Count this side's flux only when water flows into the element, and the water is coming from somewhere 
 8768:          // real: either a wet neighboring element, or an open boundary.         
 8769:          if (isLand || !inFlux) continue;
 8770: 
 8771:          for (int itr = 0; itr < ntracers; itr++) {
 8772:             transport.inflow[k] += fabs(faceQ);  // Sum of all inflow fluxes at level k.
 8773:          }
 8774: 
 8775:       }
 8776:       
 8777:       // computes the minimum allowed sub-time step for the prism
 8778:       elem->transport.maxDt = min(elem->transport.maxDt, elem->transport.maxPrismDt(elem, k));
 8779:    }
 8780: 
 8781: }
 8782: 
 8783: __global__ void horizontalAdvectionUpdate(double dtb) {
 8784:    ELEM(elem);
 8785: 
 8786:    if (elem->isDry) return;
 8787: 
 8788:    const int kb = elem->kb;
 8789:    auto &transport = elem->transport;
 8790: 
 8791:    for (int k = kb + 1; k < nvrt; k++) {
 8792:       const double vol = elem->volume(k - 1);
 8793:       const double dtb_by_vol = dtb / vol;
 8794:       Tracers adv = transport.prevTraces[k];  // start from old C
 8795: 
 8796:       for (int j = 0; j < elem->i34; j++) {
 8797: 
 8798:          const Side *side = elem->sides[j];
 8799: 
 8800:          if (k <= side->kb) continue;
 8801: 
 8802:          const double faceQ = side->transport.Qh[k];
 8803:          const double sQ = elem->ssign[j] * faceQ;
 8804:          if (sQ >= 0.0) continue;  // outflow or zero: skip (upwind)
 8805: 
 8806:          // outside concentration
 8807:          Tracers Cout = adv;  // default: no change (e.g. land / same as interior)
 8808:          const Element *neigh = side->otherElem(elem);
 8809:          if (neigh != nullptr && !neigh->isDry) {
 8810:             Cout = neigh->transport.prevTraces[k];
 8811:          } else if (side->sideBnd != nullptr && !side->sideBnd->segment->isLand) {
 8812:             // XXXXXXXXXXXXX
 8813:             Cout.tracer[0] = 0.1;
 8814:             Cout.tracer[1] = 0.1;
 8815:          } else {
 8816:             continue;
 8817:          }
 8818: 
 8819:          const double coef = dtb_by_vol * fabs(faceQ);
 8820:          #pragma unroll 
 8821:          for (int itr = 0; itr < ntracers; itr++)
 8822:             adv.tracer[itr] += coef * (Cout.tracer[itr] - transport.prevTraces[k].tracer[itr]);
 8823:       }
 8824: 
 8825:       elem->tracers[k] = adv;
 8826:    }
 8827: 
 8828:    // extend below bottom
 8829:    for (int k = 0; k <= kb; k++)
 8830:       elem->tracers[k] = elem->tracers[kb + 1];
 8831: }
 8832: 
 8833: 
 8834: __global__ void nodalTracerUpdate(void) {
 8835:    NODE(node);
 8836:    if (node->isDry) return;
 8837: 
 8838:    for (int k = 0; k < nvrt; k++) {
 8839:       Tracers sum = {};
 8840:       double sumA = 0.0;
 8841: 
 8842:       for (int j = 0; j < node->numElements; j++) {
 8843:          const Element *elem = node->elements[j];
 8844:          if (elem->isDry || k <= elem->kb) continue;
 8845: 
 8846:          const double A = elem->area;
 8847:          for (int itr = 0; itr < ntracers; itr++)
 8848:             sum.tracer[itr] += A * elem->tracers[k].tracer[itr];
 8849:          sumA += A;
 8850:       }
 8851: 
 8852:       if (sumA == 0.0) continue;
 8853:       const double inv = 1.0 / sumA;
 8854:       for (int itr = 0; itr < ntracers; itr++)
 8855:          node->tracers[k].tracer[itr] = inv * sum.tracer[itr];
 8856:    }
 8857: }
 8858: 
 8859: 
 8860: __device__ __forceinline__ void atomicMinDouble(double *addr, double val) {
 8861:    unsigned long long *p = (unsigned long long *)addr;
 8862:    unsigned long long old = *p, assumed;
 8863:    do {
 8864:       assumed = old;
 8865:       old = atomicCAS(p, assumed,
 8866:          __double_as_longlong(fmin(val, __longlong_as_double(assumed))));
 8867:    } while (assumed != old);
 8868: }
 8869: 
 8870: __device__ __forceinline__ double blockMin(double v) {
 8871:    __shared__ double sh[32];
 8872:    const int lane = threadIdx.x & 31;
 8873:    const int warp = threadIdx.x >> 5;
 8874:    for (int o = 16; o > 0; o >>= 1)
 8875:       v = fmin(v, __shfl_down_sync(0xffffffffu, v, o));
 8876:    if (lane == 0) sh[warp] = v;
 8877:    __syncthreads();
 8878:    if (warp == 0) {
 8879:       const int nw = blockDim.x >> 5;
 8880:       v = (lane < nw) ? sh[lane] : huge_double;
 8881:       for (int o = 16; o > 0; o >>= 1)
 8882:          v = fmin(v, __shfl_down_sync(0xffffffffu, v, o));
 8883:    }
 8884:    return v;  // only lane 0 of warp 0 is the block min
 8885: }
 8886: 
 8887: extern "C" __global__ void minTransportDt(double *out) {
 8888:    const int idx = threadIdx.x + blockIdx.x * blockDim.x;
 8889:    double v = huge_double;
 8890:    if (idx < mesh->ne) {
 8891:       Element *elem = &mesh->localElemData[idx];
 8892:       if (!elem->isDry) v = elem->transport.maxDt;
 8893:    }
 8894:    __shared__ double sh[32];
 8895:    const int lane = threadIdx.x & 31;
 8896:    const int warp = threadIdx.x >> 5;
 8897:    for (int o = 16; o > 0; o >>= 1)
 8898:       v = fmin(v, __shfl_down_sync(0xffffffffu, v, o));
 8899:    if (lane == 0) sh[warp] = v;
 8900:    __syncthreads();
 8901:    if (warp == 0) {
 8902:       const int nw = (blockDim.x + 31) >> 5;
 8903:       v = (lane < nw) ? sh[lane] : huge_double;
 8904:       for (int o = 16; o > 0; o >>= 1)
 8905:          v = fmin(v, __shfl_down_sync(0xffffffffu, v, o));
 8906:       if (lane == 0) atomicMinDouble(out, v);
 8907:    }
 8908: }
