  823: struct BoundarySegment {
  824: 
  825:    bool isLand;
  826: 
  827:    double clen;  // Length of the boundary segment
  828:    double carea; // Area of the boundary segment
  829: 
  830:    int ifltype;  // Type of flow boundary condition
  831:    
  832:    // Elevation boundary condition
  833:    int iettype;  // Type of elevation boundary condition
  834:    double eth;   // Elevation time history
  835: 
  836:    // Flow boundary condition
  837:    double qthcon;  // Flow time history constant
  838:    double vobc1;   // Velocity coefficient 1
  839:    double vobc2;   // Velocity coefficient 2
  840: 
  841:    // Tracer boundary conditions
  842:    // double trobc[natrm];    // Tracer boundary condition nudging factor
  843:    // int  itrtype[natrm];    // Tracer boundary condition type
  844: 
  845:    BoundarySegment(bool _isLand) {
  846:       isLand = _isLand;
  847:       clen = 0.0;
  848:       carea = 0.0;
  849:       ifltype = 0;
  850:       iettype = 0;
  851:       eth = 0.0;
  852:    }
  853: 
  854:    BoundarySegment(void) {
  855:       isLand = false;
  856:       clen = 0.0;
  857:       carea = 0.0;
  858:       ifltype = 0;
  859:       iettype = 0;
  860:       eth = 0.0;
  861:    }
  862: 
  863:    
  864: };
