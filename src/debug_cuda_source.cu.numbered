 2856: __device__ __inline__ void Node::updateZCoordData(void) {
 2857: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2858: 
 2859:    // assert(!isDry2() && "updateZCoordData: node is dry");
 2860:    // if (isDry2()) {
 2861:    //    kb = -1;  // XXXXXXXX KKKKK
 2862:    //    return;
 2863:    // }
 2864: 
 2865: 
 2866:    if constexpr(ivcor == 2) {  // SZ coordinates
 2867:       
 2868:       // Compute bottom level index
 2869:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 2870:    } 
 2871:    else if (ivcor == 1) {  // Localized sigma
 2872:       // Do nothing
 2873:    }
 2874: 
 2875: 
 2876: }
 2877: 
 2878: 
 2879: __device__ double Node::compZCoord(int k) const {
 2880:    // Computes the z coordinate at level k.
 2881:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2882:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2883:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2884:    // used 
 2885:    
 2886:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2887: 
 2888:    if (isDry2()) return -depth;  // XXXX I used to return 0.0
 2889: 
 2890:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2891: 
 2892:    if constexpr(ivcor == 2) {
 2893: 
 2894:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2895:       const double h_c = mesh->h_c;
 2896:       const double theta_f = mesh->theta_f;
 2897:       const double sinh_theta_f = mesh->sinh_theta_f;
 2898: 
 2899:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2900:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2901:       // once per time step/node.
 2902:       // CHECK: updateZCoordData
 2903: 
 2904:       //  To simplify comparisons, I define index versions of count variables.
 2905:       if      (k == ivrt)           return eta2; 
 2906:       else if (k == izlev)          return -hmod2;
 2907:       else if (k == kb)             return -depth;
 2908:       else if (k < izlev && k >= 0) return mesh->ztot[k];
 2909:       else if (k > izlev) {
 2910:          const int ksig = k - izlev;
 2911: 
 2912:          if (hmod2 <= h_c) {
 2913: 
 2914:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2915:          } 
 2916:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2917:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2918:             assert(false && "ZCOOR: invalid h_c\n");
 2919:          } 
 2920:          else {
 2921:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2922:                          h_c * mesh->sigma[ksig] + 
 2923:                          (hmod2 - h_c) * mesh->cs[ksig];
 2924:          }
 2925:       } else { 
 2926:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2927:       }
 2928: 
 2929:    }
 2930:    else if constexpr(ivcor == 1) {
 2931:       if (k == kb) return -depth;
 2932:       else if (k == nvrt-1) return eta2;
 2933:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2934:    }
 2935:    
 2936:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2937:    return 0.0;
 2938: }
 2939: 
 2940: 
 2941: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 2942:    // Computes the bottom drag Cd based on the selected nchi
 2943: 
 2944:    if constexpr(nchi == 0) {
 2945:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 2946:       Cd = drag;  // Read from drag file
 2947: 
 2948:    } else if constexpr(nchi == 1) {
 2949:       // 
 2950: 
 2951:       bool ltmp = false; // for WBL iteration
 2952: 
 2953:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 2954:       if (isDry || (rough == 0.0)) {
 2955:          Cd = 0.0;
 2956: 
 2957:       } else { //roughness >0 
 2958:          
 2959:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 2960: 
 2961:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 2962: 
 2963:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 2964: 
 2965:       } // if rough
 2966: 
 2967:    } else if constexpr(nchi == -1) {
 2968:    // Manning 
 2969:  
 2970:       const double htot = max(hmin_man, htot2()); 
 2971:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 2972: 
 2973:    } else {
 2974:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 2975:       
 2976:    } // if nchi
 2977: }
 2978: 
 2979: 
 2980: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2981:    // Checks if a side in on the boundary
 2982:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2983: 
 2984:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2985:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2986: 
 2987:    // Indices of the nodes that form the side
 2988:    const int n1 = side.n1->idx;
 2989:    const int n2 = side.n2->idx;
 2990:    isLand = false;
 2991:    
 2992: 
 2993:    // Check if the side is on a land boundary
 2994:    for (int i = 0; i < nland; i++) {
 2995:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2996:          // Consecutive nodes in the land boundary segment
 2997:          const int b1 = ilnd[i + j*nland];
 2998:          const int b2 = ilnd[i + (j + 1)*nland];
 2999: 
 3000:          assert(b1 != -1 && b2 != -1);
 3001: 
 3002:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3003:             
 3004:             isLand = true;
 3005:             return i;
 3006:          }
 3007:       }
 3008:    }
 3009: 
 3010:    // Check if the side is on an open boundary
 3011:    for (int i = 0; i < nope; i++) {
 3012:       for (int j = 0; j < nond[i] - 1; j++) {
 3013:          // Consecutive nodes in the open boundary segment
 3014:          const int b1 = iond[i + j*nope];
 3015:          const int b2 = iond[i + (j + 1)*nope];
 3016: 
 3017:          assert(b1 != -1 && b2 != -1);
 3018: 
 3019:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3020:             isLand = false;
 3021:             return i;
 3022:          }
 3023:       }
 3024:    }
 3025: 
 3026:    return -1;
 3027: }
 3028: 
 3029: 
 3030: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3031:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3032:                                     double *wind_rotate_angle, 
 3033:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3034:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3035:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3036:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3037:                                     double *drag, double *roughness, double *rmanning) {
 3038: 
 3039:    NODE(pnode);  
 3040:    const int i = idx_node;
 3041:    Node &node(*pnode);
 3042: 
 3043:    node.idx = i;
 3044: 
 3045:    const int idxNodeStart = nodeNeighNodesStart[i];
 3046:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3047:    node.numNodes = idxNodeEnd - idxNodeStart;
 3048:    node.nodes = nodeNeighNodes + idxNodeStart;
 3049:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3050: 
 3051: 
 3052: 
 3053:    const int idxElemStart = nodeNeighElemsStart[i];
 3054:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3055:    node.numElements = idxElemEnd - idxElemStart;
 3056:    node.elements = nodeNeighElems + idxElemStart;
 3057: 
 3058: 
 3059:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3060:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3061:       const int partNode = localNodePart[idxNodeGlobal]; 
 3062:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3063: 
 3064:       Node *node_ptr = nodes[partNode] + idxNode;
 3065:       
 3066:       nodeNeighNodes[idx] = node_ptr;
 3067:    }
 3068: 
 3069: 
 3070:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3071:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3072:       const int partElem = localElemPart[idxElemGlobal];
 3073:       const int idxElem  = localElemIndices[idxElemGlobal];
 3074: 
 3075:       Element *elem_ptr = elems[partElem] + idxElem;
 3076: 
 3077:       nodeNeighElems[idx] = elem_ptr;
 3078:    }      
 3079: 
 3080:    node.wind_angle = wind_rotate_angle[i];
 3081: 
 3082: 
 3083:    node.p.x   = node_coords[i * 3];
 3084:    node.p.y   = node_coords[i * 3 + 1];
 3085:    node.depth = node_coords[i * 3 + 2];
 3086: 
 3087:    if (use_ll) {
 3088:    node.lon = node_coords_ll[i * 2    ]*deg2rad;
 3089:    node.lat = node_coords_ll[i * 2 + 1]*deg2rad;
 3090:    }
 3091: 
 3092: 
 3093:    node.numSides = 0;
 3094: 
 3095:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3096:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3097:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3098:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3099:    else assert(false && "populateNodes: selected nchi not implemented.");
 3100:    
 3101:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3102:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3103:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3104: 
 3105:    
 3106:    // Links the node to the boundary information
 3107:    if (isbnd[i] >= 0) {
 3108:      
 3109:       // Get the index of the node boundary
 3110:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3111: 
 3112:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3113:       node.nodeBnd->node = &node;
 3114: 
 3115:       node.nodeBnd->sideBnd1 = nullptr;
 3116:       node.nodeBnd->sideBnd2 = nullptr;
 3117: 
 3118:       if (isbnd[i]>=0) {
 3119: 
 3120:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3121:          
 3122:          node.nodeBnd->segment->ifltype = 0 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3123: // printf("(isbnd[i]==0)?3:0 = %d\n", (isbnd[i]==0)?3:0);         
 3124:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3125: 
 3126:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3127:          node.nodeBnd->segment->clen  = nan("1");
 3128:          node.nodeBnd->segment->carea = nan("1");
 3129: 
 3130:       }
 3131:    } else {
 3132: 
 3133:       node.nodeBnd = nullptr; // For internal nodes
 3134: 
 3135:       if (isbnd[i] == landSegment) {
 3136:          node.nodeBnd = &landBoundaryNode;
 3137:          node.nodeBnd->segment = &landBoundarySegment;
 3138:       }
 3139:       
 3140:    }
 3141:    
 3142:    // XXXX GAUSSIAN HILL VELOCITIES
 3143: #ifdef GAUSSIAN_HILL_VELOCITIES
 3144:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3145:       constexpr double rot_per = 3000.0;
 3146:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3147:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3148:    // XXXXX
 3149: #endif
 3150: 
 3151: }
 3152: 
 3153: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3154:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3155:                                     double *wind_rotate_angle,   
 3156:                                     int *isdel, int *isidenode, int *isbnd,
 3157:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3158:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3159:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3160:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3161:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3162:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3163:                                     double *drag, double *roughness) {
 3164: 
 3165: 
 3166:    SIDE(pside);
 3167:    Side &side(*pside);
 3168:    const int i = idx_side;
 3169: 
 3170:    side.idx = i;  
 3171:    
 3172:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3173:    const double fc   = 2.0*omega_e*sin(sfea0);
 3174:    const double beta = 2.0*omega_e*cos(sfea0);
 3175: 
 3176:    // finding the pointer to the nodes that form the side
 3177:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3178:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3179: 
 3180:    const int locidx_n1 = localNodeIndices[idx_n1];
 3181:    const int locidx_n2 = localNodeIndices[idx_n2];
 3182:    const int part_n1 =   localNodePart[idx_n1];
 3183:    const int part_n2 =   localNodePart[idx_n2];
 3184: 
 3185:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3186:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3187: 
 3188:    // Counts the number of sides connected to each node
 3189:    side.n1->numSides++;
 3190:    side.n2->numSides++;
 3191: 
 3192:    // Normal, unitary vector to the side
 3193:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3194:    side.n = normalize(side.n);
 3195: 
 3196:    // Side boundary type
 3197:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3198:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3199: 
 3200:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3201:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3202:    {
 3203:       bool isLand = false;
 3204:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3205:       
 3206:       if (isbs > -1) {
 3207:          // assert(isLand || isbs>=0);
 3208:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3209: 
 3210:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3211: 
 3212:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3213:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3214: 
 3215:          assert (isLand == side.sideBnd->segment->isLand);
 3216: 
 3217:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3218:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3219:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3220: 
 3221:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3222:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3223:          
 3224:          side.sideBnd->side = &side;
 3225: 
 3226:       }
 3227:       else {
 3228:          side.sideBnd = nullptr;
 3229:       }
 3230:    }
 3231:    else 
 3232:    {
 3233:       side.sideBnd = nullptr;
 3234:    }
 3235: 
 3236: 
 3237:    // finding the pointer to the elements that share the side
 3238:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3239:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3240: 
 3241:    if (idx_e1 > -1) {
 3242:       const int locidx_e1 = localElemIndices[idx_e1];
 3243:       const int part_e1 =  localElemPart[idx_e1];
 3244:       side.elems[0] = elems[part_e1] + locidx_e1;
 3245: 
 3246:    }
 3247:    else {
 3248:       side.elems[0] = nullptr;
 3249:    }
 3250: 
 3251:    if (idx_e2 > -1) {
 3252:       const int locidx_e2 = localElemIndices[idx_e2];
 3253:       const int part_e2 =  localElemPart[idx_e2];
 3254:       side.elems[1] = elems[part_e2] + locidx_e2;
 3255:    }
 3256:    else {
 3257:       side.elems[1] = nullptr;
 3258:    }
 3259: 
 3260:    // Compute the center of the side
 3261:    side.center = 0.5*(side.n1->p + side.n2->p);
 3262: 
 3263:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3264:    side.shapiro = shapiro0;
 3265: 
 3266: #ifdef GAUSSIAN_HILL_VELOCITIES
 3267: // XXXX
 3268: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3269: constexpr double rot_per=3000.0;
 3270: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3271: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3272: // XXXXX      
 3273: #endif
 3274:    // Compute the z level at the center of the side
 3275:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3276:    
 3277:    // Compute the length of the side
 3278:    const Vector2 vLen = side.n2->p - side.n1->p;
 3279:    side.len = sqrt(dot(vLen, vLen));
 3280: 
 3281: 
 3282:    // Compute the Coriolis coefficient
 3283: 
 3284:    if constexpr(ncor == -1 || ncor == 0) {
 3285:       side.coriolis = coricoef;
 3286:    }
 3287:    else {
 3288:       const double sphi = side.lat();  // Latitude at the center of the side
 3289: 
 3290: // XXXXXX ERROR WHEN use_ll is false??????
 3291:       if constexpr(ics == 1) {
 3292:          // XXXXXXX
 3293:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3294:       }
 3295:       else {
 3296:          side.coriolis = 2.0*omega_e*sin(sphi);
 3297:       }
 3298: 
 3299:    }
 3300: }
 3301: 
 3302: 
 3303: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3304:    double *node_coords, double *node_coords_ll, bool use_ll,
 3305:    double *wind_rotate_angle,   
 3306:    int *isdel, int *isidenode, int *isbnd,
 3307:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3308:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3309:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3310:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3311:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3312:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3313:    double *drag, double *roughness) {
 3314: 
 3315:    ELEM(pelem);
 3316:    Element &elem(*pelem);
 3317:    const int i = idx_elem;
 3318: 
 3319:    elem.idx = i;
 3320: 
 3321:    for (int j = 0; j < i34[i]; j++) {
 3322:       const int idxNode = elnode[i*4 + j];  
 3323:       const int idxSide = elside[i*4 + j];
 3324:       
 3325:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3326:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3327: 
 3328:       // Find the neighboring element  
 3329:       if (elem.sides[j]->elems[0] == &elem) {
 3330:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3331:       }
 3332:       else {
 3333:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3334:       }
 3335:       
 3336:    }
 3337: 
 3338:    elem.i34 = i34[i];
 3339: 
 3340:    // Compute the barycenter of the element and its depth
 3341:    elem.center = {0.0, 0.0};
 3342:    elem.depth = 0.0;
 3343:    for (int j = 0; j < i34[i]; j++) {
 3344: 
 3345:       elem.center += elem.nodes[j]->p/i34[i];
 3346:       elem.depth  += elem.nodes[j]->depth/i34[i];
 3347:    }
 3348: 
 3349: 
 3350:    
 3351:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3352:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3353: 
 3354:    elem.area = elem.computeSignedArea(); 
 3355:    elem.radius = sqrt(elem.area)/pi; 
 3356:    
 3357:    // Determines which way the normal vector to each side is oriented.
 3358:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3359:    for (int j = 0; j < i34[i]; j++)  
 3360:    {
 3361:       if (elem.sides[j]->elems[0] == &elem) {
 3362:          elem.ssign[j] =  1.0;
 3363:       }
 3364:       else {
 3365:          elem.ssign[j] = -1.0;
 3366:       }
 3367: 
 3368:    }
 3369: 
 3370:    // Derivatives of shape functions
 3371:    //  For ics=2, this is done inside element/ll frame XXX
 3372:    //  For quads, the derivative is evaluated at centroid
 3373:    for (int j = 0; j < elem.i34; j++) {
 3374:       const double area = elem.area;
 3375:       const int id2 = elem.nxq(1 + j);
 3376:       const int id3 = elem.nxq(2 + j);
 3377:       const int id4 = elem.nxq(3 + j);
 3378:       if (elem.isTri()) {
 3379:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3380:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3381:          // da1/dx = (y1 - y2)/(2*area)
 3382:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3383:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3384:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3385:       }
 3386:       else  { // Quad; evaluate at centroid
 3387:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3388:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3389:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3390:       } // if Tri
 3391: 
 3392:    } // for j   
 3393:    
 3394:    
 3395: 
 3396: }
 3397: 
 3398: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3399:                                             double *emo, double *efa, 
 3400:                                             double *umo, double *ufa, 
 3401:                                             double *vmo, double *vfa) {
 3402: 
 3403: 
 3404:    NODE_BND(nodeBnd);
 3405:    const int idx = idx_node_bnd;    
 3406: 
 3407:    nodeBnd->idx = idx;
 3408: 
 3409:    // Need to find the segment index and the index of the node on the segment
 3410:    int idxNode = -1;
 3411:    int iseg, i;
 3412:    for (iseg = 0; iseg < nope; iseg++) {
 3413:       // for each segment...
 3414:       for (i = 0; i < nond[iseg]; i++) {
 3415:          idxNode = iond[iseg + i*nope];
 3416:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3417:          
 3418:       }
 3419:    }
 3420: 
 3421:    assert(iseg < nope && "iseg is out of bounds");
 3422: 
 3423: found: // Jumped here when the node was found
 3424: 
 3425:    nodeBnd->isEssentialBC = true;
 3426:    nodeBnd->elbc = 0.0;
 3427: 
 3428:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3429: 
 3430:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 3431:       nodeBnd->efa[jfr] = efa[idx2];
 3432:       nodeBnd->emo[jfr] = emo[idx2];
 3433:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3434:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3435: 
 3436:    }
 3437:         
 3438: 
 3439: }
