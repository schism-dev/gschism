 5152:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 5153: 
 5154:       NODE(node);
 5155: 
 5156:       node->ETP = 0.0;
 5157: 
 5158:       if constexpr(ntip == 0) return;
 5159: 
 5160:       // For all tidal potential components
 5161:       for (int j=0; j<ntip; j++) {
 5162: 
 5163:          const double nodeETP = node->computeETP(j, time, tfreq, tamp, tnf, tear, jspc);
 5164: 
 5165:          node->ETP += nodeETP;
 5166: 
 5167:          if constexpr(iloadtide==1) { // loading tide
 5168:             assert(false && "Loading tide not implemented");
 5169:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5170:          }
 5171:          
 5172:       }
 5173: 
 5174:      
 5175:    }
