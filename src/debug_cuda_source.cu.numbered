 5244: extern "C" {
 5245: 
 5246:    __global__ void scaleGravity(double loadtide_coef) {
 5247: 
 5248: 
 5249:       NODE(node);
 5250: 
 5251:       // SAL option: scale gravity
 5252:       if constexpr(iloadtide==2) {  // simple const
 5253:          node->grav2 = grav*(1.0 - loadtide_coef);
 5254: 
 5255:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 5256:         
 5257:           const double depth = max(node->depth, 0.0);
 5258:           const double tmp1 = sqrt(depth);
 5259:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 5260:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 5261:                              2.6969e-13*depth*depth*depth*tmp1;
 5262:           
 5263:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 5264:           
 5265: 
 5266: 
 5267:           node->grav2 = grav*(1.0 - beta_bar);
 5268: 
 5269:       } else {  // iloadtide=0,1
 5270:           node->grav2 = grav;
 5271: 
 5272:       }
 5273: 
 5274:    }
 5275: 
 5276: 
 5277:    __global__ void setWinds(double *xWind, double *yWind, double *pressAir) {
 5278:       NODE(node);
 5279: 
 5280:       const int idx = node->idx;
 5281:       Vector2 wind = {xWind[idx], yWind[idx]};
 5282: 
 5283:       if constexpr(nws != 0 && iwindoff != 0) {
 5284:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 5285:       }
 5286: 
 5287:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 5288:       node->setWind(wind);
 5289: 
 5290:       node->pr = pressAir[idx];
 5291:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 5292: 
 5293:    }
