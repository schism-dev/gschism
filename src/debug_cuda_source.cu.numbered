 5329: extern "C" {
 5330: 
 5331:    __global__ void scaleGravity(double loadtide_coef) {
 5332: 
 5333: 
 5334:       NODE(node);
 5335: 
 5336:       // SAL option: scale gravity
 5337:       if constexpr(iloadtide==2) {  // simple const
 5338:          node->grav2 = grav*(1.0 - loadtide_coef);
 5339: 
 5340:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 5341:         
 5342:           const double depth = max(node->depth, 0.0);
 5343:           const double tmp1 = sqrt(depth);
 5344:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 5345:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 5346:                              2.6969e-13*depth*depth*depth*tmp1;
 5347:           
 5348:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 5349:           
 5350: 
 5351: 
 5352:           node->grav2 = grav*(1.0 - beta_bar);
 5353: 
 5354:       } else {  // iloadtide=0,1
 5355:           node->grav2 = grav;
 5356: 
 5357:       }
 5358: 
 5359:    }
 5360: 
