 7096:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7097:       const Node *node = mesh->localNodeData + idx_node;
 7098:       res[idx_node*size + idx_node] = node->coeffDiag;
 7099:       for (int j = 0; j < node->numNodes; j++) {
 7100:          Node* nbNode = node->nodes[j];
 7101:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7102:       }
 7103: 
 7104:    }
 7105:    
 7106: }
