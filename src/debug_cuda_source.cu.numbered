 7710: __global__ void getStructSizes(int* sizes)  {
 7711:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 7712:       sizes[0] = (int)sizeof(Node);
 7713:       sizes[1] = (int)sizeof(Element);
 7714:       sizes[2] = (int)sizeof(Side);
 7715:       sizes[3] = (int)sizeof(NodeBoundary);
 7716:       sizes[4] = (int)sizeof(SideBoundary);
 7717:       sizes[5] = (int)sizeof(BoundarySegment);
 7718: }
