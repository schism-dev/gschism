 5820: 
 5821:    __global__ void computeVerticallyIntegratedVelocity(void) {
 5822: 
 5823:       SIDE(side);
 5824: 
 5825:       side->U = {0.0, 0.0}; 
 5826:          
 5827:       if(side->isDry) return;
 5828: 
 5829:       // Vertically integrated velocity U
 5830:       for (int k = side->kb; k < nvrt - 1; k++) { 
 5831:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 5832:          side->U += side->Dz(k + 1)*uc;  
 5833:       }
 5834: 
 5835:    }
 5836: 
 5837:    __global__ void computeBottomDragVegetation(void) {
 5838:       // UNFINISHED. CHECK THIS:
 5839:       // How many kernels are needed? Why so many for loops?
 5840:       // Is the loop on sides needed?
 5841: 
 5842:       NODE(node);
 5843: 
 5844: 
 5845:       const int    kb      = node->kb;
 5846:       const double htot    = node->htot2(); 
 5847:       
 5848:       if (node->isDry) {
 5849:          // Default values for dry nodes
 5850:          node->veg_alpha_vert_mean = node->veg_alpha0;
 5851:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 5852: 
 5853:          return;
 5854:        
 5855:       }
 5856: 
 5857:       // Computes bottom drag Cd based on the selected nchi
 5858:       node->computeBottomDragCd();
 5859:       
 5860: 
 5861: 
 5862:       //   Bottom stress in m^2/s^2
 5863:       if (node->rho[kb + 1] >= -98.0)
 5864:       {
 5865:          const double mag_u = length(node->u2[kb + 1]);
 5866:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5867: 
 5868:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5869:          // !sediment erosion: this part needs more documentation
 5870:       }
 5871:     
 5872: 
 5873: 
 5874:       // Compute vegetation parameters
 5875:       //--------------------------------
 5876: 
 5877:       // SAV constants
 5878:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5879:       constexpr double veg_cfpsi = 0.16;
 5880: 
 5881:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5882:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5883: 
 5884:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5885:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5886:          int kbin = 0; // bin index
 5887:          for (int k = kb; k < nvrt; k++) {
 5888:             // Computes node height above the bottom level
 5889:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5890:             assert(false && "Vertical variation of vegetation not implemented");
 5891: 
 5892:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5893:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5894:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5895:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5896:             // } else {
 5897:             //    // Find the bin at which the current vertical level is
 5898:             //    while (kbin<nbins_veg_vert) {
 5899:             //       const double zn = node->z[kbin];
 5900:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5901:             //          break;
 5902:             //       } // if
 5903:             //       kbin++;
 5904:             //    } // while
 5905:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5906: 
 5907:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5908:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5909:                
 5910:             //    // Linear interpolation of the vegetation parameters
 5911:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5912:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5913:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5914:             // } // if rl10
 5915: 
 5916:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5917: 
 5918:          } // for k
 5919: 
 5920: 
 5921:       } else { // Ganthy (iveg==2)
 5922:       //  Modify canopy height, diameter, and density
 5923: 
 5924:          // Make sure there is vegetation on this node
 5925:          if (node->veg_h_unbent > 0.0) {
 5926:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5927: 
 5928:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5929:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5930:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5931: 
 5932:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5933:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5934:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5935:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5936:          } // if veg_h_unbent
 5937: 
 5938:          for (int k = 0; k < nvrt; k++) {
 5939:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5940:          } // for k
 5941:       
 5942: 
 5943:       } // if iveg
 5944:      
 5945: 
 5946:       // Compute vertical mean of veg_alpha3D
 5947:       if (iveg != 0) {
 5948:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5949:          double sum1=0.0;
 5950:          double sum2=0.0;
 5951:          // Integrate over each level under the canopy...
 5952:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5953:             const double Dz = node->Dz(k);
 5954: 
 5955:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5956:             sum2 += Dz;
 5957: 
 5958:          } // for k
 5959:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5960:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5961: 
 5962:       } // if iveg
 5963: 
 5964:    }
 5965: 
 5966:    __global__ void computeVegetationAndDragParameters(void) {
 5967:       // Computes the vegetation and drag model parameters:
 5968:       // chi, \tilde\chi, beta, \breve{H}
 5969:       
 5970:       SIDE(side);
 5971: 
 5972:       side->hhat = 0.0;
 5973:       side->chi2 = 0.0;
 5974:       side->chi = 0.0;
 5975:       side->veg_c2 = 0.0;
 5976:       side->veg_beta = 0.0;
 5977: 
 5978:       if (side->isDry) return;
 5979: 
 5980:       const double htot = side->htot2();
 5981:       const int    kb   = side->kb;
 5982: 
 5983:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5984: 
 5985:       const double veg_h     = side->veg_h();
 5986:       const double veg_nv    = side->veg_nv();
 5987:       const double veg_c     = side->veg_c();
 5988:       const double veg_beta  = side->veg_beta;
 5989:       const double veg_alpha = side->veg_alpha_vert_mean();
 5990: 
 5991:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 5992:       // Velocity magnitude at the bottom level
 5993:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 5994:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 5995:       side->chi2 = side->Cd()*vmag1;
 5996:       side->chi  = side->chi2;
 5997:       if constexpr(iveg != 0) {
 5998:          const Node *n1 = side->n1;
 5999:          const Node *n2 = side->n2;
 6000:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 6001:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 6002:       }
 6003: 
 6004:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 6005: 
 6006:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 6007:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 6008:       double magUa = 0.0;
 6009:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 6010:          // 3D wet side with veg...
 6011: 
 6012:          double magUa = 0.0;
 6013:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 6014:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 6015: 
 6016:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 6017:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 6018:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 6019: 
 6020:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 6021:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 6022: 
 6023:                // Velocity magnitude at the bottom (l) of the level
 6024:                const double ul = length(side->u2[k]);
 6025: 
 6026:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 6027:                magUa += Dz*0.5*(uh + ul);
 6028: 
 6029:             } // if HasVegetation
 6030:          } // for k
 6031:          const double ua = magUa/min(htot, veg_h); // Vertical average
 6032: 
 6033:          // Computes beta, used for computing the stress term at the top of the canopy.      
 6034:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 6035:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 6036:             const double zCpy = side->zTopCanopy();
 6037:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 6038:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 6039:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 6040:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 6041:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 6042:          } // if isSubmerged
 6043:       } // if iveg   
 6044: 
 6045:       // Computes the friction modified depth, \breve{H} in notes
 6046:       if (side->is2D()) { // 2D
 6047: 
 6048:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 6049:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 6050: 
 6051:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 6052: 
 6053:          side->hhat = htot*htot/fricH; 
 6054: 
 6055:       } else { // 3D
 6056:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 6057: 
 6058:          if constexpr(iveg != 0) {
 6059:             
 6060:             if (side->isSubmerged()) { 
 6061:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 6062:                side->hhat -= veg_c*Hhat_alpha;
 6063: 
 6064:             } else { // Emergent
 6065:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 6066:             }
 6067:          } // if iveg
 6068: 
 6069:          // Enforce positivity for 3D model
 6070:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 6071:       } // if 3D
 6072: 
 6073:    }
 6074: 
 6075: 
 6076: 
 6077:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 6078:    // Computes the density gradient between two elements, e1 and e2.
 6079:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 6080:    // zero in the direction normal to the side. 
 6081:    // 
 6082:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 6083:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 6084:    //
 6085:    // Input:
 6086:    //    e1: Element
 6087:    //    e2: Neighbor element (or nullptr if boundary)
 6088:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 6089:    //    k: Index of the half-level at which the density is interpolated
 6090:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 6091:    // 
 6092:    // Output:
 6093:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 6094:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 6095: 
 6096:       if (e2 == nullptr || e2->isDry) {
 6097:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 6098: 
 6099:          Side *side = e1->sides[j];
 6100:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 6101:                  
 6102:          if constexpr(ics == 1) {
 6103:             vec = side->n; // Normal vector to the side
 6104:          } else {
 6105:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6106:             // IMPLEMENT THIS XXXXXX
 6107:             // !replace with xel, yel?
 6108:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 6109:             //      &eframe(:,:,i),xn1,yn1,tmp)
 6110:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 6111:             //      &eframe(:,:,i),xn2,yn2,tmp)
 6112:          } //ics
 6113:                    
 6114:          diffRho = 0.0;
 6115: 
 6116:       } else { //internal and wet
 6117:          if constexpr(ics==1) {
 6118:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 6119: 
 6120:             // Vector from e1 to e2
 6121:             vec = e2->center - e1->center;
 6122: 
 6123:          } else { 
 6124:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6125:             // Remember that elem->center is in global coordinates
 6126:             // IMPLEMENT THIS XXXXXX
 6127:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 6128:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 6129:             //                   alow(j)=xctr2
 6130:             //                   bdia(j)=yctr2
 6131:          } // ics
 6132: 
 6133:          diffRho = rho2 - e1->demeanedDensity(k);
 6134:       }
 6135: 
 6136:    }
 6137: 
 6138:    __global__ void computeDensityCubicSplines(void) {
 6139:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 6140: 
 6141:       ELEM(elem);
 6142: 
 6143:       if (elem->isDry) return;
 6144: 
 6145:       const int kb = elem->kb;
 6146: 
 6147:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 6148:       if (elem->is2D()) {
 6149:          // In the 2D case, the density is constant at the prism level. 
 6150:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 6151:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 6152:       } else { //3D
 6153: 
 6154:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 6155:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 6156:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 6157:          ///// XXXX CHECK INDICES!!!!!
 6158:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 6159:       } // 2D/3D
 6160: 
 6161:    }
 6162: } // extern "C"
 6163: 
 6164: 
 6165: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 6166: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 6167: 
 6168:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 6169: 
 6170:    const int kb  = elem->kb;
 6171:    const int kb2 = elem2->kb;
 6172: 
 6173:    // z-coordinate of prism of elem
 6174:    const double zp = elem->z_prism(k);
 6175: 
 6176:    double rho = 0.0;
 6177: 
 6178:    if (elem2->is2D()) {
 6179:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 6180: 
 6181:    } else {  // 3D
 6182: 
 6183:       // eta_min may be < zmax
 6184:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 6185:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 6186: 
 6187:       // (Extrapolate density below bottom, we will fix it later)
 6188:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 6189:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 6190:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 6191:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 6192:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 6193:    } // 2D/3D
 6194:      
 6195: 
 6196:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 6197:    // Now we need to fix it.
 6198:    if (elem->z[k] < elem2->z[kb2]) {
 6199:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 6200: 
 6201:       // There are two methods to adjust the density at the bottom of the element.
 6202:       // iunder_deep=0: 
 6203:       const double depth1 = abs(elem->z[kb]); // larger depth
 6204: 
 6205:       if (iunder_deep==0) {
 6206: 
 6207:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 6208: 
 6209:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 6210: 
 6211:       } else { // iunder_deep != 0
 6212: 
 6213:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 6214: 
 6215:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 6216: 
 6217:          //   Demeaned density at the same z coordinate as
 6218:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 6219:          }
 6220: 
 6221:       } // if iunder_deep
 6222:    } // if elem->z[kb] < elem2->z[kb]
 6223: 
 6224:    return rho;
 6225: }
 6226: 
 6227: 
 6228: extern "C" {
 6229:    __global__ void computeDensityGradient(void) {
 6230: 
 6231:       if constexpr(ibc != 0) return;
 6232: 
 6233:          // Compute the horizontal density gradient at each element.
 6234:       // It works in two steps:
 6235:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6236:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6237:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6238:       //             gradRho.r1 = rho1 - rho0
 6239:       //             gradRho.r2 = rho2 - rho0
 6240:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6241:       // 
 6242:       //  NOTE: We use de-meaned densities.
 6243: 
 6244:       ELEM(elem);
 6245: 
 6246:       if (elem->isDry) return;
 6247: 
 6248:       const int kb  = elem->kb;
 6249:       const int i34 = elem->i34;
 6250: 
 6251:       for (int k = kb + 1; k < nvrt; k++) {
 6252:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 6253:          //             gradRho.r1 = rho1 - rho0
 6254:          //             gradRho.r2 = rho2 - rho0
 6255:          int icount = 0;
 6256:          double sumRx = 0.0;
 6257:          double sumRy = 0.0;
 6258:          for (int j1=0; j1<i34; j1++) { 
 6259: 
 6260:             const int j2 = elem->nxq(j1 + 1);
 6261: 
 6262:             // Pairs of consecutive neighbor elements of elem
 6263:             const Element *e1 = elem->nghbElems[j1];
 6264:             const Element *e2 = elem->nghbElems[j2];
 6265: 
 6266:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 6267:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 6268:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 6269: 
 6270:             // Compute the density difference and the vector from elem to e1 and e2
 6271:             // getRhoDiffAndVec takes into account boundaries/dry elements
 6272:             double diffRho1, diffRho2;
 6273:             Vector2 vec1, vec2;
 6274:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 6275:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 6276: 
 6277:             const double rl1 = length(vec1);
 6278:             const double rl2 = length(vec2);
 6279:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 6280: 
 6281:             const double delta = cross(vec1, vec2);
 6282:             const double sintheta = abs(delta)/(rl1*rl2);
 6283: 
 6284:             // To avoid problems, avoid elements with small angle between vectors
 6285:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 6286:             const bool validEq = (sintheta > sin_one_deg);
 6287: 
 6288:             if (validEq) {
 6289:                // Solve the system of equations to get the density gradient at elem
 6290:                icount++;
 6291:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 6292:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 6293:                sumRx += Rx;
 6294:                sumRy += Ry;
 6295:             }
 6296:          } // for j1
 6297: 
 6298:          // Compute the average density gradient at elem
 6299:          if (icount==0) {
 6300:            // Bad mesh quality; bail out with 0 b-cc
 6301:            elem->gradRho[k] = {0.0, 0.0};
 6302:          } else {
 6303:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 6304:          }
 6305: 
 6306:       } // for k
 6307: 
 6308:    }
 6309: 
 6310:    __global__ void computeBaroclinicTerm(void) {
 6311:    // Computes the baroclinic term at sides (at half levels).
 6312:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 6313:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 6314: 
 6315:       if (ibc == 1) return;
 6316: 
 6317:       SIDE(side);
 6318: 
 6319:       if (side->isDry) return;
 6320: 
 6321:       const Element *e1 = side->elems[0];
 6322:       const Element *e2 = side->elems[1]; 
 6323:       const int kb = side->kb;
 6324:       
 6325:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 6326: 
 6327:       // interpolates vertically the density gradient of the two elements at the half level/
 6328: 
 6329:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 6330:       int k2 = max(kb, nvrt / 2);
 6331: 
 6332:       // Starts the integration at the surface and goes down to the bottom
 6333:       side->bcc[nvrt-1] = {0.0, 0.0};
 6334:       for (int k = nvrt - 2; k >= kb; k--) {
 6335:       // For each prism level (from surface to bottom)...
 6336: 
 6337:          // For both elements, interpolate density gradient at the side's half level.
 6338:          // The gradient at the side is the average of the gradients at the elements.
 6339:          // w1, w2 are used to take into account boundary sides, with just one element.
 6340:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 6341:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 6342:          const double wsum = w1 + w2;
 6343:          w1 = w1/wsum;
 6344:          w2 = w2/wsum;
 6345:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 6346: 
 6347:          // Linear interpolation of both elements' density gradient at the shared side's level.
 6348:          Vector2 gradRho = {0.0, 0.0};
 6349:          if (e1 != nullptr && k > kb) {
 6350:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 6351:             
 6352:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 6353:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 6354:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6355: 
 6356:             // Grad(rho) vertically interpolated at the side's half level
 6357:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 6358: 
 6359:             // Projects the element density gradient to the side frame if needed.
 6360:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 6361: 
 6362:             // Adds the contribution of the density gradient at the side's half level
 6363:             gradRho += gradRho1*w1;
 6364:          }      
 6365:          if (e2 != nullptr && k > kb) {
 6366:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 6367:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 6368:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6369:             
 6370:             // Grad(rho) vertically interpolated at the side's half level
 6371:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 6372: 
 6373:             // Projects the element density gradient to the side frame if needed.
 6374:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 6375: 
 6376:             // Adds the contribution of the density gradient at the side's half level
 6377:             gradRho += gradRho2*w2;
 6378:          }
 6379: 
 6380:          
 6381:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 6382:          // multiplied by -rampbc*(g/rho0) 
 6383:          const double grav3 = side->grav3();
 6384:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 6385: 
 6386:       } // for
 6387: 
 6388:    }
 6389: 
 6390: 
 6391: 
 6392:    __global__ void computeHorGradientAtSide(void) {
 6393: 
 6394:       // Compute the horizontal density gradient at each element.
 6395:       // It works in two steps:
 6396:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6397:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6398:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6399:       //             gradRho.r1 = rho1 - rho0
 6400:       //             gradRho.r2 = rho2 - rho0
 6401:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6402:       // 
 6403:       //  NOTE: We use de-meaned densities.
 6404: 
 6405:       SIDE(side);
 6406: 
 6407: 
 6408:       if (side->isDry) return;
 6409: 
 6410:       // Computes the gradient of the variables at the side center.
 6411:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 6412:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 6413:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 6414: 
 6415:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 6416:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 6417:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 6418:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 6419: 
 6420:    }
 6421: 
 6422: 
 6423:    __global__ void solveMomentumEquations(double time) {
 6424: 
 6425:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 6426:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 6427: 
 6428:       SIDE(side);
 6429: 
 6430:       if (side->isDry) 
 6431:       {
 6432:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 6433: 
 6434:          return;
 6435:       }
 6436: 
 6437:       const Node *n1 = side->n1;
 6438:       const Node *n2 = side->n2;
 6439: 
 6440:       const int kb = side->kb;
 6441: 
 6442:       const double veg_h = side->veg_h();
 6443:       const double grav3 = side->grav3();
 6444: 
 6445:       if (side->is2D()) {
 6446:          // Remember: Do not use htot2, which is updated.
 6447:          const double htot = side->htot1();
 6448:          const double hhat = side->hhat;
 6449: 
 6450:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 6451: 
 6452:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6453:          const Vector2 tau2 = side->tau();
 6454: 
 6455:          // hat_gam has units of m/s
 6456: 
 6457:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 6458:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 6459:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 6460: 
 6461:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 6462: 
 6463: 
 6464:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 6465: 
 6466:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 6467: 
 6468:       }
 6469:       else { // 3D
 6470: 
 6471:          // For 3D it is necessary to solve an implicit tridiagonal system.
 6472:          // 
 6473:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 6474:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 6475:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 6476:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 6477:          // k+1 and k.
 6478: 
 6479: 
 6480:          const int ndim = nvrt - kb;
 6481:          const double zTopCanopy = side->zTopCanopy();
 6482: 
 6483:          // Initialize the tridiagonal system
 6484:          for (int k = kb + 1; k < nvrt; k++) {
 6485:             
 6486:             const int kin = k - (kb + 1);
 6487: 
 6488:             // Vertical viscosity at the face center
 6489:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 6490: 
 6491:  
 6492:             alow[kin] = 0.0;
 6493:             cupp[kin] = 0.0;
 6494:             bdia[kin] = 0.0;
 6495: 
 6496:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 6497:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 6498: 
 6499:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 6500:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 6501:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 6502: 
 6503:             // First part: layers k, k+1
 6504:             if (k < nvrt - 1) {
 6505:                              
 6506:                if constexpr(iveg != 0) {
 6507: 
 6508:                   // If there is vegetation at this level...
 6509:                   if (zTopCanopy > side->zc[k]) {
 6510:                      // If the canopy is above the k layer...
 6511:                      
 6512:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 6513:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 6514:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 6515:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 6516: 
 6517:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 6518:                      const double vmag2 = length(ut2);
 6519:                      const double vmag1 = length(side->u2[k]);
 6520:                      const double vmag = 0.5*(vmag1 + vmag2);
 6521:                      
 6522:                      // Computes the vegetation alpha at the face center
 6523:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 6524: 
 6525:                      cff1 += veg_alpha_sd*dt*vmag;
 6526: 
 6527:                   } // if (zTopCanopy
 6528:                } // if iveg
 6529: 
 6530:                const double dzz = side->Dz(k + 1);
 6531:                const double tmp = dt*dfz/dzz;
 6532:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6533: 
 6534:                cupp[kin] += cff1*dzz/6.0 - tmp;
 6535:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6536:             }
 6537: 
 6538: 
 6539:             // Second part: layers k-1, k
 6540:             if (k > kb + 1) {
 6541: 
 6542:                double cff1 = 1.0; //init \bar{c^k}
 6543: 
 6544:                if constexpr(iveg != 0) {
 6545:                   // If there is vegetation at this level...
 6546:                   if (zTopCanopy > side->zc[k-1]) {
 6547:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 6548:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 6549: 
 6550:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 6551: 
 6552:                      const double vmag2 = length(ut2);
 6553:                      const double vmag1 = length(side->u2[k-1]);
 6554:                      const double vmag = 0.5*(vmag1 + vmag2);
 6555: 
 6556:                      // Computes the vegetation alpha at the face center
 6557:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 6558:                      cff1 += veg_alpha_sd*dt*vmag;
 6559:                   } // if zTopCanopy
 6560: 
 6561:                } // if iveg
 6562: 
 6563:                const double dzz = side->Dz(k);
 6564:                const double tmp = dt*dfz/dzz;
 6565:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6566: 
 6567:                alow[kin] += cff1*dzz/6.0 - tmp;
 6568:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6569: 
 6570:             } else { // Bottom boundary
 6571:                // This occurs at the bottom, where the bottom drag is applied.
 6572: 
 6573:                bdia[kin] += dt*side->chi2; // XXXX
 6574: 
 6575:             } // if (k > kb + 1)
 6576: 
 6577: 
 6578:          } // for (int k
 6579: 
 6580: 
 6581: 
 6582:          // Computes the RHS.
 6583:          // -----------------
 6584: 
 6585:          //	BC to be imposed at the end.
 6586: 
 6587:          const Vector2 gradETP  = side->gradETP;
 6588:          const Vector2 gradPr   = side->gradPr;
 6589:          const Vector2 gradEta1 = side->gradEta1;
 6590:          const Vector2 gradEta2 = side->gradEta2;
 6591: 
 6592:          const Vector2 *btu = side->btu;
 6593:          const Vector2 *u2  = side->u2;
 6594:          const double coriolis = side->coriolis;
 6595:          const Vector2 *nuGradU = side->nuGradU;
 6596: 
 6597:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 6598:          for (int k = kb + 1; k < nvrt; k++) {
 6599:             const int kin = k - kb - 1;
 6600: 
 6601:             const double dz_0 = side->Dz(k);
 6602:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 6603: 
 6604:             rrhs[kin] = {0.0, 0.0};
 6605:             double dz = 0.0;
 6606: 
 6607:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 6608:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 6609:             if (k < nvrt  ) dz += dz_1;
 6610:             if (k > kb + 1) dz += dz_0;
 6611: 
 6612:             // Elevation gradient, atmospheric pressure and tidal potential
 6613:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 6614: 
 6615:             // Coriolis, advection, wind stress, and horizontal viscosity
 6616:             if (k < nvrt - 1) {
 6617: 
 6618: 
 6619:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 6620:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 6621:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 6622:                                                 
 6623: 
 6624:                //diff stress tensors 1006
 6625:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 6626:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 6627:                   assert(false && "Not implemented: itur == 5");
 6628:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 6629:                }
 6630:                // else assert(false && "itur # Not implemented");
 6631: 
 6632:             } else { // k == nvrt - 1 SURFACE
 6633:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6634:                const Vector2 tau2 = side->tau();
 6635: 
 6636:                rrhs[kin] += dt*tau2;          
 6637: 
 6638:             } // if k<nvrt
 6639: 
 6640: 
 6641:             if (k > kb + 1) {
 6642:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 6643:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 6644:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 6645: 
 6646:                // diff stress tensors 1006
 6647:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 6648:                   assert(false && "Not implemented: itur == 5");
 6649:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 6650:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 6651:                }
 6652:                // else assert(false && "itur # Not implemented");
 6653: 
 6654: 
 6655:             } // if k>kbs + 1
 6656: 
 6657:             // Baroclinic
 6658:             Vector2 *bcc = side->bcc;
 6659:             if constexpr(ibc == 0) {
 6660:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 6661:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 6662: 
 6663:             } // if ibc==0
 6664: 
 6665:          } // k=kb + 1,nvrt
 6666: 
 6667: 
 6668:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 6669: 
 6670:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 6671:             const int kin = k - kb - 1;
 6672:    
 6673:             // Velocity is always clamped to maximum values
 6674:             side->u2[k] = clampVelocity(soln[kin]);
 6675:          } // k
 6676: 
 6677:       } // if side->is2D()
 6678:       
 6679: 
 6680:       // Impose velocity boundary condition at the bottom
 6681:       if constexpr(imm == 2) { // 3D bed deformation model
 6682:          double dep;
 6683:          Vector2 vel;
 6684: 
 6685:          assert(false && "Not implemented: imm == 2");
 6686:          //update_bdef(time, x0, y0, dep, vel);
 6687:          // side->u2[kb] = vel;
 6688: 
 6689:       } else { // imm = 0 or 1
 6690:          if (side->Cd() == 0.0) {
 6691:             side->u2[kb] = side->u2[kb + 1];
 6692: 
 6693:          } else if (side->is3D()) { // 3D no slip bottom   
 6694:             side->u2[kb] = {0.0, 0.0};
 6695: 
 6696:          }
 6697:           
 6698:       } // if imm
 6699: 
 6700:       // The velocities below the bottom level are set to zero
 6701:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 6702: 
 6703: 
 6704:    }
 6705: 
 6706: 
 6707:    __global__ void applyMomentumBC(void) {
 6708: 
 6709:       SIDE_BND(sideBnd);
 6710: 
 6711:       Side *side = sideBnd->side;
 6712:       const BoundarySegment *segment = sideBnd->segment;
 6713:       const Node *n1 = side->n1;
 6714:       const Node *n2 = side->n2;
 6715: 
 6716:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 6717: 
 6718:       const bool isLand = segment->isLand;
 6719:       const int ifltype = segment->ifltype;
 6720: 
 6721:       const int kb = side->kb;
 6722: 
 6723: 
 6724:       if (!isLand && ifltype != 0) {
 6725:          const Vector2 *ubc = sideBnd->ubc;
 6726:   
 6727:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 6728:             
 6729:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 6730:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 6731: 
 6732:             if (ifltype == -1) {
 6733:                // Flather 1
 6734: 
 6735:                const double depth = side->depth();
 6736: 
 6737:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 6738: 
 6739:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 6740: 
 6741:                side->u2[k] = vnorm*side->n;
 6742: 
 6743:             } else if (ifltype == -2) { // Discharge
 6744: 
 6745:                const double eta1 = side->eta1();
 6746:                const double eta2 = side->eta2();
 6747:                const double htot = side->htot2();
 6748: 
 6749:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 6750:                assert(false && "Not implemented: Discharge bc");
 6751:                // const double dischrg = discharge(eta1);
 6752:                const double dischrg = 0.0; // XXX REMOVE
 6753:                
 6754: 
 6755:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 6756: 
 6757:                const double vnorm = dischrg*eta2/htot;
 6758: 
 6759:                side->u2[k] = vnorm*side->n;
 6760: 
 6761:             }
 6762:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 6763:                const double vnorm = dot(side->u2[k], side->n);
 6764: 
 6765:                double rat;
 6766:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 6767:                else              rat = segment->vobc2; // outgoing
 6768: 
 6769:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 6770: 
 6771:             }
 6772:             else { // not Flather or 3D radiation
 6773:                side->u2[k] = ubc[k];
 6774: 
 6775:             } // if (segment->ifltype...
 6776: 
 6777:          }
 6778: 
 6779:       }
 6780:       else if (isLand) { // if it is land boundary side
 6781: 
 6782:          if constexpr(islip == 0) { // free slip
 6783: 
 6784:             for (int k = kb; k < nvrt; k++) {
 6785: 
 6786:                const Vector2 t = side->t();
 6787:                const Vector2 n = side->n;
 6788: 
 6789:                double vnorm = 0.0; // for most cases
 6790:                const double vtan = dot(side->u2[k], t);
 6791:                
 6792:                side->u2[k] = vtan*t - vnorm*n;
 6793: 
 6794:             }
 6795: 
 6796:          } else { // no slip
 6797:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 6798: 
 6799:          }
 6800:       } // if (side segment type...
 6801: 
 6802:    
 6803: 
 6804:    }
 6805: 
 6806: 
 6807:    __global__ void shapiroFilter1(void) {
 6808:       // First step of the Shapiro filter (normally used if indvel<=0)
 6809:       // Computes the filtered values and stores them in bcc (as a temporary array).
 6810: 
 6811:       SIDE(side);
 6812: 
 6813:       // Only internal wet sides are processed
 6814:       if (side->isDry || !(side->isInternal())) return;
 6815: 
 6816:       const int kb = side->kb;
 6817: 
 6818:       for (int mm = 0; mm < niter_shap; mm++) {
 6819: 
 6820:          for (int k = kb + 1; k < nvrt; k++) {
 6821:             // WARNING: reusing bcc as a temporary array to store the suru values.
 6822:             Vector2 suru = {0.0, 0.0};
 6823: 
 6824:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 6825: 
 6826:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 6827: 
 6828:                int kin = k;
 6829:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 6830:                
 6831:                // Get the velocity at the neighbor's side.
 6832:                Vector2 nSideU2 = nSide->u2[kin];
 6833: 
 6834:                // Projects the velocity to the current side frame if needed.
 6835:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 6836: 
 6837:                suru += nSideU2;
 6838:             }
 6839: 
 6840:             // Reusing bcc as a temporary array to store the suru values.
 6841:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 6842: 
 6843:          }
 6844:       }
 6845:    }
 6846: 
 6847:    __global__ void shapiroFilter2(void) {
 6848:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6849: 
 6850:       SIDE(side);
 6851: 
 6852: 
 6853:       if (side->isDry || !(side->isInternal())) return;
 6854: 
 6855:       const int kb = side->kb;
 6856: 
 6857:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6858: 
 6859:       if (side->is2D()) {
 6860:          side->u2[kb + 1] = side->bcc[kb + 1];
 6861:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6862: 
 6863:       } else {
 6864:          // 3D
 6865:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6866:          
 6867:       }
 6868: 
 6869:    }
 6870: 
 6871: 
 6872:    __global__ void ul0UpdateZCoords(void) {
 6873:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6874:       
 6875:       NODE(node);      
 6876: 
 6877: 
 6878:       if (false) { //node->isDry) { XXXXXXX
 6879: 
 6880:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6881: 
 6882:          if constexpr(ivcor != 1) node->kb = 0;
 6883: 
 6884:       } else {
 6885: 
 6886:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6887:          node->updateKb();
 6888: 
 6889:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6890: 
 6891:       }
 6892: 
 6893:       // We use the temp.b field to store the previous state of isDry.
 6894:       node->tmp.b = node->isDry;
 6895: 
 6896:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6897:       node->isDry = true;
 6898: 
 6899:    }
 6900: 
 6901:    __global__ void ul0ComputeDryElements(void)
 6902:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6903:    {
 6904:       ELEM(elem);
 6905: 
 6906:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6907: 
 6908:       elem->kb = 0;
 6909: 
 6910:       if (elem->isDry) return;
 6911: 
 6912: 
 6913:    //    if(elem->isDry2()) { // XXXX
 6914:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6915:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6916:    //        call parallel_abort(errmsg)
 6917:    //    }
 6918: 
 6919:       const Node *n1 = elem->nodes[0];
 6920:       const Node *n2 = elem->nodes[1];
 6921:       const Node *n3 = elem->nodes[2];  
 6922:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6923: 
 6924:       // Computes element's kb as the minimum of the nodes' kb.
 6925:       const int kb1 = n1->kb;
 6926:       const int kb2 = n2->kb;
 6927:       const int kb3 = n3->kb;
 6928:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 6929: 
 6930: 
 6931:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6932: 
 6933: 
 6934:       // Computes the element z as the mean of the nodes z.
 6935:       for (int k = elem->kb; k < nvrt; k++) {
 6936: 
 6937:          // Compute the element z as the mean of the nodes z.
 6938:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6939:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6940:          elem->z[k] /= elem->i34;
 6941: 
 6942:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 6943:       }
 6944:                   
 6945:    }
 6946: 
 6947:    __global__ void ul0ComputeDryNodes(void)
 6948:    // Updates node's isDry based on the elements' isDry. 
 6949:    {
 6950:       NODE(node);
 6951: 
 6952:       node->isDry = true;
 6953: 
 6954:       // A node is wet if at least one of the elements sharing it is wet.
 6955:       for (int j = 0; j < node->numElements; j++) {
 6956:          const Element *elem = node->elements[j];
 6957:          if (!elem->isDry) {
 6958:             node->isDry = false;
 6959:             break;
 6960:          }
 6961:       }
 6962: 
 6963:        
 6964:    }
 6965: 
 6966: 
 6967:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6968:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6969:    // node->tmp.b is true if the node was previously dry.
 6970:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6971:    {
 6972:       NODE(node);
 6973:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6974: 
 6975:       // Avoid this the first time step.
 6976:       if (it == iths) return;  
 6977: 
 6978:       const bool wasDry = node->tmp.b;
 6979: 
 6980: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6981: 
 6982:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 6983: 
 6984:          for (int k=0; k < nvrt; k++) {
 6985: 
 6986:             Vector3 utmp={0.0, 0.0, 0.0};
 6987: 
 6988:             double ttmp=0.0;
 6989:             double stmp=0.0;
 6990:             int icount=0;
 6991:             for (int j = 0; j < node->numNodes; j++) {
 6992: 
 6993:                const Node *nbrNode = node->nodes[j];
 6994:                
 6995:                const bool wasNbrDry = nbrNode->tmp.b;
 6996: 
 6997:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 6998:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 6999: 
 7000:                   icount++;
 7001: 
 7002:                   // Assume small element size in wet/dry zone so pframes are close to each other
 7003:                   utmp += nbrNode->uvw2(k);
 7004:                   
 7005:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 7006:                   stmp += nbrNode->tracers[k].tracer[1]; 
 7007:                }
 7008:             }
 7009: 
 7010:             if (icount > 0) {
 7011:                const double inv_icount = 1.0/icount;
 7012:                utmp = inv_icount*utmp;
 7013:                node->u2[k]     = toVector2(utmp);
 7014:                node->w2[k]     = utmp.z;
 7015:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 7016:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 7017:             } else {
 7018:                node->u2[k] = {0.0, 0.0};
 7019:                node->w2[k] = 0.0;
 7020:                // Initialize tracers to 0.0??? XXXXX
 7021:             }
 7022:          }
 7023:       }
 7024:    }
 7025: 
 7026:   
 7027:    
 7028: 
 7029: 
 7030:    __global__ void ul0UpdateSides(int it, int iths) {
 7031:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 7032:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 7033:    // The dryness of the sides is updated in ul0UpdateSides2.
 7034: 
 7035:       SIDE(side);
 7036: 
 7037:       // A side is wet if and only if at least one of its elements is wet.
 7038:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 7039:  
 7040:       const Node *n1 = side->n1;
 7041:       const Node *n2 = side->n2;
 7042:      
 7043:       const int kb1 = n1->kb;
 7044:       const int kb2 = n2->kb;
 7045: 
 7046:       side->kb = 0; // default when dry
 7047: 
 7048:       if (isWet) {
 7049: 
 7050:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 7051: 
 7052:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 7053: 
 7054:          side->kb = min(kb1, kb2);
 7055: 
 7056:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 7057: 
 7058:          for (int k = side->kb; k < nvrt; k++) {
 7059:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 7060: 
 7061:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 7062: 
 7063:             // Compute velocity for re-wetted sides 
 7064:             if ((it != iths) && (side->isDry && isWet)) {
 7065: 
 7066:                Vector2 utmp={0.0, 0.0};
 7067: 
 7068:                int icount=0;
 7069: 
 7070:                // For all the sides on the two elements that share this side
 7071:                for (int j = 0; j < 2; j++) {
 7072:                   const Element *elem = side->elems[j];
 7073:                   if (elem == nullptr) continue;
 7074: 
 7075:                   for (int jj=0; jj < elem->i34; jj++) {
 7076:                      const Side *nSide = elem->sides[jj];
 7077:                      if (nSide->isDry) continue;
 7078: 
 7079:                      icount++;
 7080:                      utmp += nSide->u2[k];  
 7081:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 7082:                   }
 7083:                }
 7084:                   
 7085:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 7086:                if (icount > 0)  side->u2[k] = utmp/icount;
 7087:                else             side->u2[k] = {0.0, 0.0};
 7088:                   
 7089:             } // if ((it != iths) && (side->isDry && isWet))
 7090: 
 7091:          } // for k
 7092: 
 7093:       } // if isWet 
 7094:       
 7095: 
 7096: 
 7097:    }
 7098: 
 7099:    __global__ void ul0UpdateSides2(void) {
 7100:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 7101:    
 7102:          SIDE(side);
 7103:    
 7104:          const Element *e1 = side->elems[0];
 7105:          const Element *e2 = side->elems[1];
 7106: 
 7107:          // A side is wet if and only if at least one of its elements is wet.
 7108:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 7109: 
 7110:          // Update the side's dryness
 7111:          side->isDry = !isWet;
 7112: 
 7113:    }
 7114: 
 7115: 
 7116:    __global__ void zeroNodalVelocities(void) {
 7117:       NODE(node);
 7118: 
 7119:       for (int k = 0; k < nvrt; k++) {
 7120:          node->u2[k]   = {0.0, 0.0};
 7121:          node->w2[k]   = 0.0;
 7122:          node->utmp[k] = {0.0, 0.0};         
 7123:       }
 7124:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 7125:    }
 7126:  
 7127: 
 7128:    __global__ void computeNodalVerticalVelocities1(void) {
 7129:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7130:    // Adds the element's vertical velocity times the element's area.
 7131:       ELEM(elem);
 7132: 
 7133:       for (int j = 0; j < elem->i34; j++) {
 7134:          Node *node = elem->nodes[j];
 7135: 
 7136:          for (int k = node->kb; k < nvrt; k++) {
 7137:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 7138:          }
 7139:          atomicAdd(&(node->tmp.d), elem->area);
 7140:       }
 7141:    }
 7142: 
 7143:    __global__ void computeNodalVerticalVelocities2(void) {
 7144:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7145:    // Divides by the total area of the elements sharing the    node.
 7146:       NODE(node);
 7147: 
 7148:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 7149: 
 7150:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 7151:    }
 7152: 
 7153: 
 7154:    __global__ void computeNodalHorizontalVelocities1(void) {
 7155: 
 7156:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 7157: 
 7158:       ELEM(elem);
 7159: 
 7160:       if (elem->isDry) return;
 7161: 
 7162:       const int kb = elem->kb;
 7163:       const bool isTri = elem->isTri();
 7164: 
 7165:       if constexpr(indvel <= 0) {
 7166:          // Assuming discontinous hvel.
 7167: 
 7168:          if (isTri) { // For triangles
 7169:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 7170:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 7171: 
 7172:             for (int j = 0; j < 3; j++) {
 7173:                // For every node of the triangle...
 7174:                Node *node = elem->nodes[j];
 7175: 
 7176:                if (node->isDry) continue;
 7177: 
 7178:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 7179:                const Side *s2 = elem->sides[(j + 1) % 3];
 7180:                const Side *s3 = elem->sides[(j + 2) % 3];
 7181: 
 7182:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 7183: 
 7184:                atomicAdd(&(node->tmp.i), 1);
 7185: 
 7186:                for (int k = kb; k < nvrt; k++)  {
 7187:                   Vector2 s1u2 = s1->u2[k];
 7188:                   Vector2 s2u2 = s2->u2[k];
 7189:                   Vector2 s3u2 = s3->u2[k];
 7190: 
 7191:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 7192:                   if constexpr(ics == 2) {
 7193:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 7194:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 7195:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 7196:                   }
 7197: 
 7198:                   Vector2 u = s2u2 + s3u2 - s1u2; // u interpolated linearly at node j.   
 7199:                   u = clampVelocity(u);
 7200:                   atomicAdd(&(node->utmp[k].x), u.x);
 7201:                   atomicAdd(&(node->utmp[k].y), u.y);
 7202: 
 7203:                }
 7204: 
 7205:             }
 7206:          }
 7207:          else { // For quads
 7208:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 7209: 
 7210:          }
 7211: 
 7212:       }
 7213:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 7214:       
 7215:    }
 7216: 
 7217: 
 7218:    __global__ void computeNodalHorizontalVelocities2(void) {
 7219:       NODE(node);
 7220: 
 7221:       const int nodeCount = node->tmp.i;
 7222: 
 7223:       if (nodeCount == 0) 
 7224:       {
 7225:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 7226:          return;
 7227:       }
 7228: 
 7229:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 7230:       
 7231:       const int kb = node->kb;
 7232: 
 7233:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 7234:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 7235:       
 7236:       
 7237:    }   
 7238: 
 7239:  
