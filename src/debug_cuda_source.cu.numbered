 7600: extern "C" __global__ void getElementVar(int varCode, bool is3D, double *var1, double *var2, int *ivar1, int *ivar2, int k = -1, int j = -1) {
 7601:    // Get the value of a variable from an element
 7602:    // varName is the name of the variable to get
 7603:    // var is the array to store the value
 7604:    // k is the vertical level index of the variable to get
 7605: 
 7606:    ELEM(elem);
 7607:    
 7608:    int idx = elem->idx;
 7609:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7610: 
 7611:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7612:    if      (varCode == (int)VarCode::w)       { var1[idx] = elem->w[k];}
 7613:    else if (varCode == (int)VarCode::z)       { var1[idx] = elem->z[k];}
 7614:    else if (varCode == (int)VarCode::x)       { var1[idx] = elem->center.x; var2[idx] = elem->center.x;}
 7615:    else if (varCode == (int)VarCode::area)    { var1[idx] = elem->area;}
 7616:    else if (varCode == (int)VarCode::depth)   { var1[idx] = elem->depth;}
 7617:    else if (varCode == (int)VarCode::radius)  { var1[idx] = elem->radius;}
 7618:    else if (varCode == (int)VarCode::lonlat)  { var1[idx] = elem->xlon;     var2[idx] = elem->ylat;}
 7619:    else if (varCode == (int)VarCode::ghat)    { var1[idx] = elem->ghat1.x;  var2[idx] = elem->ghat1.y;}
 7620:    else if (varCode == (int)VarCode::kb)      { ivar1[idx] = elem->kb;}
 7621:    else if (varCode == (int)VarCode::ssign && j > -1)  {ivar1[idx] = elem->ssign[j];}
 7622:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7623:       
 7624:    
 7625: }
 7626: 
 7627: 
 7628: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7629:    // Get the value of a variable from an node
 7630:    // varName is the name of the variable to get
 7631:    // var is the array to store the value
 7632:    // k is the vertical level index of the variable to get
 7633: 
 7634:    NODE(node);
 7635:    
 7636:    int idx = node->idx;
 7637:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7638: 
 7639:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7640:    
 7641:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7642:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7643:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7644:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 7645:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7646:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7647:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;  
 7648:    else if (varCode == (int)VarCode::isdry && k == -1)  var[idx] = node->isDry?1.0:0.0;
 7649:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7650:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7651:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 7652:    
 7653:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7654:       
 7655:    
 7656: }
 7657: 
 7658: 
 7659: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7660:    // Get the value of a variable from an side
 7661:    // varName is the name of the variable to get
 7662:    // var is the array to store the value
 7663:    // k is the vertical level index of the variable to get
 7664:    SIDE(side);
 7665:    
 7666:    int idx = side->idx;
 7667:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7668: 
 7669:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 7670:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 7671:    // else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 7672:    else if (varCode == (int)VarCode::isdry && k == -1)   var[idx] = side->isDry?1.0:0.0;
 7673:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 7674:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 7675:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 7676:    // else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 7677:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 7678:    // else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 7679:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 7680:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 7681:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 7682:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 7683:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 7684:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 7685:    // else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 7686:    else if (varCode == (int)VarCode::bcc && k >= 0)      var[idx] = side->bcc[k].x;
 7687:    // else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 7688:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7689:    // else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7690:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7691:    // else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7692:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 7693:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 7694:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 7695:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 7696:    else if (varCode == (int)VarCode::chi  && k == -1)    var[idx] = side->chi;
 7697:    // else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 7698:    // else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 7699:    // else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 7700:    // else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 7701:    // else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 7702:    // else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 7703:    // else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 7704:    // else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 7705:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7706: }
 7707: 
 7708: 
 7709: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 7710:    // Get the value of a variable from an side
 7711:    // varName is the name of the variable to get
 7712:    // var is the array to store the value
 7713:    // k is the vertical level index of the variable to get
 7714:    SIDE_BND(sideBnd);   
 7715: 
 7716:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 7717:    if (sideBnd->segment->isLand) idx = -7;
 7718: 
 7719:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 7720:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 7721: 
 7722: }
