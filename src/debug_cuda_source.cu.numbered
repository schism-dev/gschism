 2482:    
 2483:    __forceinline__ __device__ void Element::projectNodeVectorsToElementFrame(Vector2 *v) const {
 2484:    // Project the vectors from the node frame to the element frame
 2485: 
 2486:  
 2487:       v[0] = nodes[0]->frame.projHorVec(v[0], frame);
 2488:       v[1] = nodes[1]->frame.projHorVec(v[1], frame);
 2489:       v[2] = nodes[2]->frame.projHorVec(v[2], frame);
 2490:       if (isQuad()) v[3] = nodes[3]->frame.projHorVec(v[3], frame);
 2491:       else          v[3] = Vector2();
 2492:    }
 2493: 
 2494:    __forceinline__ __device__ void Element::projectSideVectorsToElementFrame(Vector2 *v) const {
 2495:    // Project the vectors from the side frame to the element frame
 2496: 
 2497:       v[0] = sides[0]->frame.projHorVec(v[0], frame);
 2498:       v[1] = sides[1]->frame.projHorVec(v[1], frame);
 2499:       v[2] = sides[2]->frame.projHorVec(v[2], frame);
 2500:       if (isQuad()) v[3] = sides[3]->frame.projHorVec(v[3], frame);
 2501:       else          v[3] = Vector2();
 2502:    }
