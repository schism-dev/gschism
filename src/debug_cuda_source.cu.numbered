 3117: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 3118: // Convert shape coordinates to cartesian coordinates
 3119: 
 3120:    if (isTri()) {
 3121:       // Triangular element
 3122: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 3123:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 3124:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 3125:    }
 3126:    else {
 3127:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 3128:    }
 3129: 
 3130: }
