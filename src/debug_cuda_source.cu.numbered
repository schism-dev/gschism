 2338: 
 2339: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2340: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2341: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2342: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2343:    Vector2 grad = {0.0, 0.0};
 2344:    int count = 0;
 2345: 
 2346:    if constexpr(ics == 2) assert(false && "computeHorGradientAtSide: ics = 2 not implemented");
 2347: 
 2348:    // First element
 2349:    if (elems[0] != nullptr && condition(elems[0])) {
 2350:       grad += elems[0]->grad2(field);
 2351:       count++;
 2352:    }
 2353: 
 2354:    // Second element
 2355:    if (elems[1] != nullptr && condition(elems[1])) {
 2356:       grad += elems[1]->grad2(field);
 2357:       count++;
 2358:    }
 2359: 
 2360:    if (count > 0) {
 2361:       grad = grad/count;
 2362:    }
 2363:    
 2364:    return grad;
 2365: }
 2366: 
 2367: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2 + n2->grav2); }
 2368: __inline__ __device__ int     Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 2369: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 2370: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1 + n2->eta1); }
 2371: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth + n2->depth); } 
 2372: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 2373: 
 2374: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 2375: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 2376: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 2377: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 2378: 
 2379: 
 2380: __inline__ __device__ double  Side::Cd(void)      const { if constexpr(nchi != 0) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 2381: 
 2382: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 2383: 
 2384: /**
 2385:  * This method performs backtracking from the side center until a time -dt back in time 
 2386:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2387:  * intermediate point.
 2388:  *
 2389:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2390:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2391:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2392:  * remaining time.
 2393:  * 
 2394:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2395:  * 
 2396:  * @param uuint, vvint, wwint: Velocities at the final point
 2397:  * @param jlev: Level at which the backtracking is performed
 2398:  * @param dt, dtbk: Tracking timesteps
 2399:  * @return: True if the backtracking was successful, false otherwise
 2400:  */
 2401: __inline__ __device__ bool Side::btrack(
 2402:       int jlev,
 2403:       double dt,            // Tracking time
 2404:       double dtbk,          // Tracking timestep
 2405:       Vector3 &u_int        // Velocities at the initial point
 2406: ) const {
 2407: 
 2408:    // Start from side center
 2409:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2410:  
 2411: 
 2412:    double time_rm = dt; // Remaining time
 2413: 
 2414: 
 2415:    // // Initialize outputs XXX
 2416:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2417:    //    sclr[i] = 0.0;
 2418:    // }
 2419: 
 2420: 
 2421:    // Initial velocities
 2422:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 2423: 
 2424:    // Find the element that is in the direction opposite to the velocity
 2425:    Element* curElem = findElementTowards(toVector2(u_int));
 2426: 
 2427:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2428:    if (curElem == nullptr) {
 2429:       // Make velocity parallel to the side
 2430:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2431:       u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2432:       curElem = otherElem(curElem);
 2433:       
 2434:    }
 2435: 
 2436: 
 2437: 
 2438:    const int MAX_ITERATIONS = 1000; 
 2439:    Element* nextElem = curElem;
 2440:    int iter = 0;
 2441:    while(true) {
 2442: 
 2443:       // Calculate timestep
 2444:       double dtb = min(dtbk, time_rm);
 2445: 
 2446:       // Next point in the backtracking curve
 2447:       Point3 xt = x0 - dtb*u_int;
 2448: 
 2449:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, this);
 2450:       assert(found && "Backtracking failed in btrack");
 2451: 
 2452:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2453:                       // then time_rm needs to be increased by the unused time.
 2454:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2455: 
 2456:       // The current point becomes the next segment's starting point.
 2457:       x0 = xt;
 2458:  
 2459:       curElem = nextElem;
 2460: 
 2461:       iter++;
 2462:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2463:    }
 2464: 
 2465: 
 2466: }
 2467: 
 2468: 
