 6139: extern "C" {
 6140: 
 6141:    __global__ void scaleGravity(double loadtide_coef) {
 6142: 
 6143: 
 6144:       NODE(node);
 6145: 
 6146:       // SAL option: scale gravity
 6147:       if constexpr(iloadtide==2) {  // simple const
 6148:          node->grav2 = grav*(1.0 - loadtide_coef);
 6149: 
 6150:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 6151:         
 6152:           const double depth = max(node->depth, 0.0);
 6153:           const double tmp1 = sqrt(depth);
 6154:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 6155:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 6156:                              2.6969e-13*depth*depth*depth*tmp1;
 6157:           
 6158:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 6159:           
 6160: 
 6161: 
 6162:           node->grav2 = grav*(1.0 - beta_bar);
 6163: 
 6164:       } else {  // iloadtide=0,1
 6165:           node->grav2 = grav;
 6166: 
 6167:       }
 6168: 
 6169:    }
 6170: 
 6171: 
 6172:    __global__ void setWinds(double *xWind, double *yWind, double *pressAir) {
 6173:       NODE(node);
 6174: 
 6175:       const int idx = node->idx;
 6176:       Vector2 wind = {xWind[idx], yWind[idx]};
 6177: 
 6178:       if constexpr(nws != 0 && iwindoff != 0) {
 6179:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 6180:       }
 6181: 
 6182:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 6183:       node->setWind(wind);
 6184: 
 6185:       node->pr = pressAir[idx];
 6186:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 6187: 
 6188:    }
