 1508:                      double *node_coords, double *node_coords_ll, bool use_ll,
 1509:                      double *wind_rotate_angle,   
 1510:                      int *isdel, int *isidenode, int *isbnd,
 1511:                      int *nond, int *nlnd, int *iond, int *ilnd,                                  
 1512:                      int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 1513:                      int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 1514:                      int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
