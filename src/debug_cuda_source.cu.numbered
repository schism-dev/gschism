 2145:    template<typename T>
 2146:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
 2147:       T values[4];
 2148:       getNodalValues(level, field, values);
 2149:       
 2150:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2151:       if constexpr (IsVector2<T>::value && ics == 2) {
 2152: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2153:          projectNodeVectorsToElementFrame(values);
 2154: // printf("interpolate 4: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2155:       }
 2156: 
 2157:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2158:    }
