 1904: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 1905:                    Node *node = &(mesh->localNodeData[idx_node]); \
 1906:                    if (idx_node >= mesh->np) return;
 1907: 
 1908: #define NODE_ALL(node, valid) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x;       \
