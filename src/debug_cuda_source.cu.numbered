 2077: 
 2078: /**  Interpolate velocities at a given point (xt,yt,zt)
 2079: 
 2080:    @param xt, yt, zt: coordinates of the point to interpolate
 2081:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2082: 
 2083:    This is done in four steps:
 2084: 
 2085:    1. Find the shape coordinates for the final position in the element.
 2086:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2087:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2088:       z levels at xt, yt at each step.   
 2089:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2090:       horizontally and vertically.
 2091: **/
 2092: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2093:    // Interpolate the velocities at the point xt. 
 2094:    // This function works the same for triangular and quadrilateral elements.
 2095:    double shpCoord[4];
 2096: 
 2097: // printf(" ___BBB02____ idx = %d, u_int = %.17g,%.17g,%.17g, u1 = %.17g,%.17g,%.17g, u2 = %.17g,%.17g,%.17g, u3 = %.17g,%.17g,%.17g\n", idx, u_int.x, u_int.y, u_int.z, nodes[0]->u2[0].x, nodes[0]->u2[0].y, nodes[0]->u2[0].z, nodes[1]->u2[0].x, nodes[1]->u2[0].y, nodes[1]->u2[0].z, nodes[2]->u2[0].x, nodes[2]->u2[0].y, nodes[2]->u2[0].z);         
 2098:    // First step is to compute the shape coordinates of (xt,yt)
 2099:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2100:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2101: 
 2102:    // Second step is to find the level that contains zt
 2103:    // Uses a binary search to find the level
 2104:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2105:    int L = kbe;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2106:    int R = nvrt - 1;
 2107: 
 2108:    // Get the z coordinates at the nodes of the element at the levels L and R
 2109:    double zLAtNodes[4], zRAtNodes[4];
 2110:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2111:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2112: 
 2113:    double zL = interpolate(shpCoord, zLAtNodes);
 2114:    double zR = interpolate(shpCoord, zRAtNodes);
 2115:    
 2116:    // Interpolates vertically the velocities
 2117:    double wght1, wght2;
 2118:    if (xt.z<=zL) {
 2119:       wght1 = 1.0;
 2120:       wght2 = 0.0;
 2121:    }
 2122:    else if (xt.z>=zR) {
 2123:       wght1 = 0.0;
 2124:       wght2 = 1.0;
 2125:    }
 2126:    else {
 2127:       // Perform a binary search to find the levels between L and R that contain xt.z
 2128:       while (R - L > 1) {
 2129:          int M = (L + R) / 2;
 2130: 
 2131:          double zMAtNodes[4];
 2132:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2133:          double zM = interpolate(shpCoord, zMAtNodes);
 2134:          if (zM < xt.z) 
 2135:          {
 2136:             L = M;
 2137:             zL = zM;
 2138:          }
 2139:          else 
 2140:          {
 2141:             R = M;
 2142:             zR = zM;
 2143:          }
 2144:       }
 2145:       assert(L == R-1);
 2146:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2147: 
 2148:       wght2 = (xt.z - zL)/(zR - zL);
 2149:       wght1 = 1.0 - wght2;
 2150:    }
 2151: 
 2152:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2153:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 2154: 
 2155:    // Neither of the interpolated velocities should be NaN
 2156:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2157: 
 2158: }
 2159: 
