  272: // Simple math functions ---------------------------------------------------------------------------
  273: 
  274: __device__ __forceinline__ void solveQuadratic(double A, double B, double C, double &x1, double &x2) {
  275: // Solves the quadratic equation A*x^2 + B*x + C = 0 and returns the two solutions in x1 and x2.
  276: // Outputs:
  277: //        x1: first solution
  278: //        x2: second solution
  279: 
  280:        // Use float-specific absolute value for speed on GPU
  281:     const double absA = fabs(A);
  282:     const double absB = fabs(B);
  283: 
  284:     // 1. Near-linear case: a is effectively 0.
  285:     // We use a small epsilon to prevent division by zero and handle degenerate quads.
  286:     // This branch is almost never taken, so it won't hurt performance.
  287:     if (absA < 1e-14 * (absB + 1e-30)) {
  288:         const double x = -C / B;
  289:         x1 = x;
  290:         x2 = x;
  291:         return;  // Degenerate case: A = 0.
  292:     }
  293: 
  294:    const double delta = max(0.0, B*B - 4.0*A*C);
  295: 
  296:    assert(delta >= 0.0 && "solveQuadratic: negative discriminant");
  297:    const double s = sqrt(delta);
  298: 
  299:    // Numerically stable quadratic roots:
  300:    // q = -0.5*(B + sign(B)*sqrt(delta))
  301:    const double q = -0.5 * (B + copysign(s, B));
  302: 
  303:    x1 = q/A;
  304:    x2 = (fabs(q) > 1e-30) ? (C/q) : x1;   // Moving predicate.
  305: 
  306: }
