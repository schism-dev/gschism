  702:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  703:       // Check if the point (xt,yt) is inside the element
  704:       double shpCoords[4];
  705: 
  706:       bool res = computeShapeCoords(xt, shpCoords, false);
  707: 
  708:       return res;
  709:    }
  710: 
  711:    __inline__ __device__ bool containsPoint(Vector2 &xt, bool fixCoords) const { 
  712:       // Check if the point (xt,yt) is inside the element
  713:       double shpCoords[4];
  714: 
  715:       Vector2 tmp_xt = xt;
  716:       bool res = computeShapeCoords(tmp_xt, shpCoords, fixCoords);
  717: 
  718:       if (fixCoords && res) xt = tmp_xt;
  719: 
  720:       return res;
  721:    }
  722: 
  723:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  724:    {
  725:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  726:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  727:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  728:       
  729:    }
