  827:    // Where L is the level at which the field is to be interpolated. The field can be either
  828:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  829:    // There are different versions of getNodalValues for each of these cases.
  830: 
  831:    template<typename T>
