 4301:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4302: 
 4303:       SIDE(side);
 4304: 
 4305: 
 4306:       side->U = {0.0, 0.0}; 
 4307:          
 4308:       if(side->isDry) return;
 4309: 
 4310:       const Node *node1 = side->n1;
 4311:       const Node *node2 = side->n2;
 4312: 
 4313:       // Vertically integrated velocity U (in ll if ics=2)
 4314:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 4315:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 4316:       }
 4317: 
 4318:    }
 4319: 
 4320:    __global__ void computeBottomDragVegetation(void) {
 4321:       // UNFINISHED. CHECK THIS:
 4322:       // How many kernels are needed? Why so many for loops?
 4323:       // Is the loop on sides needed?
 4324: 
 4325:       NODE(node);
 4326: 
 4327:       const int    kb      = node->kb;
 4328:       const double htot    = node->htot2();
 4329:       const double rough   = node->rough;
 4330: 
 4331: 
 4332:       if (node->isDry) {
 4333:          // Default values for dry nodes
 4334:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4335:          /// XXX CHECK INDICES
 4336:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4337:       }
 4338: 
 4339:       // Compute bottom drag Cd
 4340:       //--------------------------------
 4341: 
 4342:       // nchi = {-1, 0, 1} is the type of bottom drag.
 4343:       if (nchi==1) {
 4344: 
 4345:          bool ltmp = false; // for WBL iteration
 4346: 
 4347:          // Cdmax=-1 !max. Cd at node for this process (info only)
 4348:          // Drag at nodes
 4349:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 4350:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 4351:         
 4352:          const double rough = node->rough;
 4353:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4354:          if (node->rough == 0.0) {
 4355:             node->Cd = 0.0;
 4356: 
 4357:          } else { //roughness >0 
 4358:             
 4359:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 4360:             const double bthick = max(dzb_min, bthick_ori);
 4361: 
 4362:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 4363: 
 4364:             double tmp = 1.0/(2.5*log(bthick/rough));
 4365:             node->Cd = tmp*tmp;
 4366: 
 4367:          } // if rough
 4368: 
 4369: 
 4370:          // RECOVER THIS: XXX
 4371:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 4372:          // Output warning for WBL if iteration didn't converge
 4373: 
 4374: 
 4375:       } // nchi==1
 4376: 
 4377:       //   Bottom stress in m^2/s^2
 4378:       if (node->rho[kb + 1] >= -98.0)
 4379:       {
 4380:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 4381:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 4382:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4383:          // !sediment erosion: this part needs more documentation
 4384:       }
 4385: 
 4386:     
 4387:       // Compute vegetation parameters
 4388:       //--------------------------------
 4389: 
 4390:       // SAV constants
 4391:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4392:       constexpr double veg_cfpsi = 0.16;
 4393: 
 4394:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4395:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4396: 
 4397:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4398:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4399:          int kbin = 0; // bin index
 4400:          for (int k = kb; k < nvrt; k++) {
 4401:             // Computes node height above the bottom level
 4402:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4403:             assert(false && "Vertical variation of vegetation not implemented");
 4404: 
 4405:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4406:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4407:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4408:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4409:             // } else {
 4410:             //    // Find the bin at which the current vertical level is
 4411:             //    while (kbin<nbins_veg_vert) {
 4412:             //       const double zn = node->z[kbin];
 4413:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4414:             //          break;
 4415:             //       } // if
 4416:             //       kbin++;
 4417:             //    } // while
 4418:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4419: 
 4420:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4421:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4422:                
 4423:             //    // Linear interpolation of the vegetation parameters
 4424:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4425:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4426:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4427:             // } // if rl10
 4428: 
 4429:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4430: 
 4431:          } // for k
 4432: 
 4433: 
 4434:       } else { // Ganthy (iveg=2)
 4435:       //  Modify canopy height, diameter, and density
 4436: 
 4437:          // Make sure there is vegetation on this node
 4438:          if (node->veg_h_unbent > 0.0) {
 4439:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4440: 
 4441:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4442:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4443:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4444: 
 4445:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4446:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4447:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4448:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4449:          } // if veg_h_unbent
 4450: 
 4451:          for (int k = 0; k < nvrt; k++) {
 4452:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4453:          } // for k
 4454:       
 4455: 
 4456:       } // if iveg
 4457:      
 4458:          
 4459: 
 4460:       // Compute vertical mean of veg_alpha3D
 4461:       if (iveg != 0) {
 4462:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4463:          double sum1=0.0;
 4464:          double sum2=0.0;
 4465:          // Integrate over each level under the canopy...
 4466:          for (int k=kb; k<nvrt-1 && node->z[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 4467:             const double Dz = node->Dz(k);
 4468: 
 4469:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 4470:             sum2 += Dz;
 4471: 
 4472:          } // for k
 4473: 
 4474:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4475:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4476: 
 4477:       } // if iveg
 4478: 
 4479:       printf("computeBottomDragVegetation: nodeIdx = %d, node->veg_alpha_vert_mean = %f\n", node->idx, node->veg_alpha_vert_mean);
 4480: 
 4481:    }
 4482: 
 4483:    __global__ void computeVegetationAndDragParameters(void) {
 4484:       // Computes the vegetation and drag model parameters:
 4485:       // chi, \tilde\chi, beta, \breve{H}
 4486:       
 4487:       SIDE(side);
 4488: 
 4489:       const double htot = side->htot2();
 4490:       const int    kb   = side->kb;
 4491: 
 4492:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4493: 
 4494:       const double veg_h     = side->veg_h();
 4495:       const double veg_nv    = side->veg_nv();
 4496:       const double veg_c     = side->veg_c();
 4497:       const double veg_beta  = side->veg_beta;
 4498:       const double veg_alpha = side->veg_alpha_vert_mean();
 4499: 
 4500:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4501:       // Velocity magnitude at the bottom level
 4502:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4503:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4504:       side->chi2 = side->Cd()*vmag1;
 4505:       side->chi  = side->chi2;
 4506:       if constexpr(iveg != 0) {
 4507:          const Node *n1 = side->n1;
 4508:          const Node *n2 = side->n2;
 4509:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4510:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4511:       }
 4512: 
 4513:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4514: 
 4515:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4516:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4517:       double magUa = 0.0;
 4518:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4519:          // 3D wet side with veg...
 4520: 
 4521:          double magUa = 0.0;
 4522:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4523:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4524: 
 4525:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4526:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4527:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4528: 
 4529:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4530:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4531: 
 4532:                // Velocity magnitude at the bottom (l) of the level
 4533:                const double ul = length(side->u2[k]);
 4534: 
 4535:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4536:                magUa += Dz*0.5*(uh + ul);
 4537: 
 4538:             } // if HasVegetation
 4539:          } // for k
 4540:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4541: 
 4542:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4543:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4544:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4545:             const double zCpy = side->zTopCanopy();
 4546:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4547:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4548:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4549:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4550:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4551:          } // if isSubmerged
 4552:       } // if iveg   
 4553: 
 4554:       // Computes the friction modified depth, \breve{H} in notes
 4555:       if (side->is2D()) { // 2D
 4556: 
 4557:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4558:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4559: 
 4560:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4561: 
 4562:          side->hhat = htot*htot/fricH; 
 4563: 
 4564:       } else { // 3D
 4565:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4566: 
 4567:          if constexpr(iveg != 0) {
 4568:             
 4569:             if (side->isSubmerged()) { 
 4570:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4571:                side->hhat -= veg_c*Hhat_alpha;
 4572: 
 4573:             } else { // Emergent
 4574:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4575:             }
 4576:          } // if iveg
 4577: 
 4578:          // Enforce positivity for 3D model
 4579:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4580:       } // if 3D
 4581: 
 4582:       printf("computeVegetationAndDragParameters: sideIdx = %d, side->htot = %f, side->hhat = %f\n", side->idx, side->htot2(), side->hhat);
 4583: 
 4584:         
 4585:    }
 4586: 
 4587: 
 4588: 
 4589:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4590:    // Computes the density gradient between two elements, e1 and e2.
 4591:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4592:    // zero in the direction normal to the side. 
 4593:    // 
 4594:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4595:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4596:    //
 4597:    // Input:
 4598:    //    e1: Element
 4599:    //    e2: Neighbor element (or nullptr if boundary)
 4600:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4601:    //    k: Index of the half-level at which the density is interpolated
 4602:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4603:    // 
 4604:    // Output:
 4605:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4606:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4607: 
 4608:       if (e2 == nullptr || e2->isDry) {
 4609:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4610: 
 4611:          Side *side = e1->sides[j];
 4612:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4613:                  
 4614:          if constexpr(ics == 1) {
 4615:             vec = side->n; // Normal vector to the side
 4616:          } else {
 4617:             // IMPLEMENT THIS XXXXXX
 4618:             // !replace with xel, yel?
 4619:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4620:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4621:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4622:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4623:          } //ics
 4624:                    
 4625:          diffRho = 0.0;
 4626: 
 4627:       } else { //internal and wet
 4628:          if constexpr(ics==1) {
 4629:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4630: 
 4631:             // Vector from e1 to e2
 4632:             vec = toVector2(e2->center - e1->center);
 4633: 
 4634:          } else { 
 4635:             // IMPLEMENT THIS XXXXXX
 4636:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4637:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4638:             //                   alow(j)=xctr2
 4639:             //                   bdia(j)=yctr2
 4640:          } // ics
 4641: 
 4642:          diffRho = rho2 - e1->demeanedDensity(k);
 4643:       }
 4644: 
 4645:    }
 4646: 
 4647:    __global__ void computeDensityCubicSplines(void) {
 4648:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4649: 
 4650:       ELEM(elem);
 4651: 
 4652:       if (elem->isDry) return;
 4653: 
 4654:       const int kb = elem->kb;
 4655: 
 4656:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4657:       if (elem->is2D()) {
 4658:          // In the 2D case, the density is constant at the prism level. 
 4659:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4660:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4661:       } else { //3D
 4662: 
 4663:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4664:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4665:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4666:          ///// XXXX CHECK INDICES!!!!!
 4667:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4668:       } // 2D/3D
 4669: 
 4670:    }
 4671: } // extern "C"
 4672: 
 4673: 
 4674: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4675: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4676: 
 4677:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4678: 
 4679:    const int kb  = elem->kb;
 4680:    const int kb2 = elem2->kb;
 4681: 
 4682:    // z-coordinate of prism of elem
 4683:    const double zp = elem->z_prism(k);
 4684: 
 4685:    double rho = 0.0;
 4686: 
 4687:    if (elem2->is2D()) {
 4688:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4689: 
 4690:    } else {  // 3D
 4691: 
 4692:       // eta_min may be < zmax
 4693:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4694:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4695: 
 4696:       // (Extrapolate density below bottom, we will fix it later)
 4697:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4698:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4699:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4700:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4701:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4702:    } // 2D/3D
 4703:      
 4704: 
 4705:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4706:    // Now we need to fix it.
 4707:    if (elem->z[k] < elem2->z[kb2]) {
 4708:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4709: 
 4710:       // There are two methods to adjust the density at the bottom of the element.
 4711:       // iunder_deep=0: 
 4712:       const double depth1 = abs(elem->z[kb]); // larger depth
 4713: 
 4714:       if (iunder_deep==0) {
 4715: 
 4716:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4717: 
 4718:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4719: 
 4720:       } else { // iunder_deep != 0
 4721: 
 4722:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4723: 
 4724:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4725: 
 4726:          //   Demeaned density at the same z coordinate as
 4727:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4728:          }
 4729: 
 4730:       } // if iunder_deep
 4731:    } // if elem->z[kb] < elem2->z[kb]
 4732: 
 4733:    return rho;
 4734: }
 4735: 
 4736: 
 4737: extern "C" {
 4738:    __global__ void computeDensityGradient(void) {
 4739: 
 4740:          // Compute the horizontal density gradient at each element.
 4741:       // It works in two steps:
 4742:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4743:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4744:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4745:       //             gradRho.r1 = rho1 - rho0
 4746:       //             gradRho.r2 = rho2 - rho0
 4747:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4748:       // 
 4749:       //  NOTE: We use de-meaned densities.
 4750: 
 4751:       ELEM(elem);
 4752: 
 4753:       if (elem->isDry) return;
 4754: 
 4755:       const int kb  = elem->kb;
 4756:       const int i34 = elem->i34;
 4757: 
 4758:       for (int k = kb + 1; k < nvrt; k++) {
 4759:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 4760:          //             gradRho.r1 = rho1 - rho0
 4761:          //             gradRho.r2 = rho2 - rho0
 4762:          int icount = 0;
 4763:          double sumRx = 0.0;
 4764:          double sumRy = 0.0;
 4765:          for (int j1=0; j1<i34; j1++) { 
 4766: 
 4767:             const int j2 = elem->nxq(j1 + 1);
 4768: 
 4769:             // Pairs of consecutive neighbor elements of elem
 4770:             const Element *e1 = elem->nghbElems[j1];
 4771:             const Element *e2 = elem->nghbElems[j2];
 4772: 
 4773:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 4774:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 4775:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 4776: 
 4777:             // Compute the density difference and the vector from elem to e1 and e2
 4778:             // getRhoDiffAndVec takes into account boundaries/dry elements
 4779:             double diffRho1, diffRho2;
 4780:             Vector2 vec1, vec2;
 4781:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 4782:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 4783: 
 4784:             const double rl1 = length(vec1);
 4785:             const double rl2 = length(vec2);
 4786:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 4787: 
 4788:             const double delta = cross(vec1, vec2);
 4789:             const double sintheta = abs(delta)/(rl1*rl2);
 4790: 
 4791:             // To avoid problems, avoid elements with small angle between vectors
 4792:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 4793:             const bool validEq = (sintheta > sin_one_deg);
 4794: 
 4795:             if (validEq) {
 4796:                // Solve the system of equations to get the density gradient at elem
 4797:                icount++;
 4798:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 4799:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 4800:                sumRx += Rx;
 4801:                sumRy += Ry;
 4802:             }
 4803:          } // for j1
 4804: 
 4805:          // Compute the average density gradient at elem
 4806:          if (icount==0) {
 4807:            // Bad mesh quality; bail out with 0 b-cc
 4808:            elem->gradRho[k] = {0.0, 0.0};
 4809:          } else {
 4810:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 4811:          }
 4812: 
 4813:       } // for k
 4814: 
 4815:    }
 4816: 
 4817:    __global__ void computeBaroclinicTerm(void) {
 4818:    // Computes the baroclinic term at sides (at half levels).
 4819:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 4820:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 4821: 
 4822:       SIDE(side);
 4823: 
 4824:       if (side->isDry) return;
 4825: 
 4826:       const Element *e1 = side->elems[0];
 4827:       const Element *e2 = side->elems[1];      
 4828:       const int kb = side->kb;
 4829:       
 4830:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 4831: 
 4832:       // interpolates vertically the density gradient of the two elements at the half level/
 4833: 
 4834:       // Starts the integration at the surface and goes down to the bottom
 4835:       int k1 = nvrt - 1;
 4836:       int k2 = nvrt - 1;
 4837: 
 4838:       side->bcc[nvrt-1] = {0.0, 0.0};
 4839:       for (int k = nvrt-2; k >= kb; k--) {
 4840:       // For each prism level (from surface to bottom)...
 4841: 
 4842:          // For both elements, interpolate density gradient at the side's half level.
 4843:          // The gradient at the side is the average of the gradients at the elements.
 4844:          // w1, w2 are used to take into account boundary sides, with just one element.
 4845:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 4846:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 4847:          const double wsum = w1 + w2;
 4848:          w1 = w1/wsum;
 4849:          w2 = w2/wsum;
 4850:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 4851: 
 4852:          // Linear interpolation of both elements' density gradient at the shared side's level.
 4853:          Vector2 gradRho = {0.0, 0.0};
 4854:          if (e1 != nullptr && k > kb) {
 4855:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 4856:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 4857:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 4858:             
 4859:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 4860:          }      
 4861:          if (e2 != nullptr && k > kb) {
 4862:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4863:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4864:             
 4865:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4866:          }
 4867: 
 4868:          if constexpr(ics==2) {
 4869:             // IMPLEMENT THIS XXXXXX
 4870:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4871:             // swild(1)=tmp1
 4872:             // swild(2)=tmp2
 4873:          }
 4874:          
 4875:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4876:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4877:          // CHECK INDICES!!! XXX
 4878:          const double grav3 = side->grav3();
 4879:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4880: printf(">>>side->bcc[%d] = %e, %e, rampbc: %e, grav3: %e, rho0: %e, side->Dz(k + 1): %e, gradRho: %e, %e\n", k, side->bcc[k].x, side->bcc[k].y, rampbc, grav3, rho0, side->Dz(k + 1), gradRho.x, gradRho.y);
 4881: 
 4882:       } // for
 4883: 
 4884:    }
 4885: 
 4886: 
 4887: 
 4888:    __global__ void computeHorGradientAtSide(void) {
 4889: 
 4890:       // Compute the horizontal density gradient at each element.
 4891:       // It works in two steps:
 4892:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4893:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4894:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4895:       //             gradRho.r1 = rho1 - rho0
 4896:       //             gradRho.r2 = rho2 - rho0
 4897:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4898:       // 
 4899:       //  NOTE: We use de-meaned densities.
 4900: 
 4901:       SIDE(side);
 4902: 
 4903:       if (side->isDry) return;
 4904: 
 4905:       // Computes the gradient of the variables at the side center.
 4906:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 4907:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 4908:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 4909: 
 4910:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 4911:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 4912:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 4913:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 4914: 
 4915: 
 4916:       printf("gradEta1: %e, %e, gradEta2: %e, %e, gradETP: %e, %e, gradPr: %e, %e\n", 
 4917:          side->gradEta1.x, side->gradEta1.y, 
 4918:          side->gradEta2.x, side->gradEta2.y, 
 4919:          side->gradETP.x, side->gradETP.y, 
 4920:          side->gradPr.x, side->gradPr.y);
 4921: 
 4922: 
 4923:    }
 4924: 
 4925: 
 4926:    __global__ void solveMomentumEquations(double time) {
 4927: 
 4928:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 4929:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 4930: 
 4931:       SIDE(side);
 4932: 
 4933:       if (side->isDry) 
 4934:       {
 4935:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 4936: 
 4937:          return;
 4938:       }
 4939: 
 4940:       const Node *n1 = side->n1;
 4941:       const Node *n2 = side->n2;
 4942: 
 4943:       const int kb = side->kb;
 4944: 
 4945:       const double veg_h = side->veg_h();
 4946:       const double grav3 = side->grav3();
 4947: 
 4948: printf("###>>>#side->is2D() = %d\n", side->is2D());
 4949:       if (side->is2D()) {
 4950:          // Warning: Do not use htot2, which is updated.
 4951:          const double htot = side->htot1();
 4952:          const double hhat = side->hhat;
 4953: printf("htot: %e, hhat: %e\n", htot, hhat);
 4954:          assert(hhat > 0.0 && htot > 0.0 && "Impossible dry 55:");
 4955: 
 4956:          Vector2 tau2 = {0.0, 0.0};
 4957:           
 4958:          if constexpr(ics==1) {
 4959:             tau2 = side->tau();
 4960: 
 4961:          } else {
 4962:             assert(false && "Not implemented: ics == 2");
 4963:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4964:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4965:             // taux2=(vn1+tt1)*0.5d0
 4966:             // tauy2=(vn2+ss1)*0.5d0
 4967:          } // if ics         
 4968: 
 4969:          // hat_gam has units of m/s
 4970: 
 4971:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 4972: 
 4973: printf("coriolisTerm: %e, %e\n", coriolisTerm.x, coriolisTerm.y);
 4974: 
 4975:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 4976:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 4977: 
 4978:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 4979: 
 4980:          const double ux = -clamp(hat_gam.x*hhat/htot, -rmaxvel1, rmaxvel1);
 4981:          const double uy = -clamp(hat_gam.y*hhat/htot, -rmaxvel2, rmaxvel2);
 4982: 
 4983:          for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 4984: 
 4985: printf("###>>>#side->u2[0] = %e, %e, side->u2[1] = %e, %e, hat_gam = %e, %e, hhat = %e, htot = %e\n", side->u2[0].x, side->u2[0].y, side->u2[1].x, side->u2[1].y, side->nuGradU[nvrt-1].x, side->nuGradU[nvrt-1].y, hhat, htot);
 4986: 
 4987:       }
 4988:       else { // 3D
 4989: 
 4990:          // For 3D it is necessary to solve an implicit tridiagonal system.
 4991:          // 
 4992:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 4993:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 4994:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 4995:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 4996:          // k+1 and k.
 4997: 
 4998: 
 4999:          // // Define layer thickness & viscosity
 5000:          // for (int k=kb + 1; k<nvrt; k++) {
 5001:          //    const double dzz = side->Dz(k - 1);
 5002: 
 5003:          //    assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5004: 
 5005:          //    // Vertical viscosity at the face center
 5006:          //    dfz(k) = 0.25*(n1->dfv[k] + n2->dfv[k] + n1->dfv[k-1] + n2->dfv[k-1]);
 5007:         
 5008:          // }
 5009: 
 5010: 
 5011:          const int ndim = nvrt - kb;
 5012:          const double zTopCanopy = side->zTopCanopy();
 5013: 
 5014:          // Initialize the tridiagonal system
 5015:          for (int k = kb + 1; k<nvrt; k++) {
 5016:             
 5017:             const int kin = k - kb;
 5018: 
 5019:             // Vertical viscosity at the face center
 5020:             const double dfz = 0.25*(side->dfv(k) + side->dfv(k + 1));
 5021:             const double dzz = side->Dz(k);
 5022: 
 5023:             printf("k: %d, side->zc[0]: %e, side->n1->z[0]: %e, side->n2->z[0]: %e, dzz: %e, dfz: %e\n",k, side->zc[0], side->n1->z[0], side->n2->z[0], dzz, dfz);
 5024:             printf("k: %d, side->zc[1]: %e, side->n1->z[1]: %e, side->n2->z[1]: %e, dzz: %e, dfz: %e\n",k, side->zc[1], side->n1->z[1], side->n2->z[1], dzz, dfz);
 5025:             assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5026: 
 5027:             alow[kin] = 0.0;
 5028:             cupp[kin] = 0.0;
 5029:             bdia[kin] = 0.0;
 5030: 
 5031:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5032:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5033: 
 5034:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5035:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5036:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5037: 
 5038:             // First part: layers k, k+1
 5039:             if (k < nvrt - 1) {
 5040:                              
 5041:                if constexpr(iveg != 0) {
 5042: 
 5043:                   // If there is vegetation at this level...
 5044:                   if (zTopCanopy > side->zc[k]) {
 5045:                      // If the canopy is above the k layer...
 5046:                      
 5047:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5048:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5049:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5050:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5051: 
 5052:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5053:                      const double vmag2 = length(ut2);
 5054:                      const double vmag1 = length(side->u2[k]);
 5055:                      const double vmag = 0.5*(vmag1 + vmag2);
 5056:                      
 5057:                      // Computes the vegetation alpha at the face center
 5058:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5059: 
 5060:                      cff1 += veg_alpha_sd*dt*vmag;
 5061: 
 5062:                   } // if (zTopCanopy
 5063:                } // if iveg
 5064: 
 5065:                const double tmp = dt*dfz/dzz;
 5066:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5067:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5068: printf("####cff1 = %f, dzz = %f, tmp = %f, cupp[%d] = %f, bdia[%d] = %f\n", cff1, dzz, tmp, cupp[kin], kin, bdia[kin]);               
 5069:             }
 5070: 
 5071: 
 5072:             // Second part: layers k-1, k
 5073:             if (k > kb + 1) {
 5074: 
 5075:                double cff1 = 1.0; //init \bar{c^k}
 5076: 
 5077:                if constexpr(iveg != 0) {
 5078:                   // If there is vegetation at this level...
 5079:                   if (zTopCanopy > side->zc[k-1]) {
 5080:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5081:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5082: 
 5083:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5084: 
 5085:                      const double vmag2 = length(ut2);
 5086:                      const double vmag1 = length(side->u2[k-1]);
 5087:                      const double vmag = 0.5*(vmag1 + vmag2);
 5088: 
 5089:                      // Computes the vegetation alpha at the face center
 5090:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5091:                      cff1 += veg_alpha_sd*dt*vmag;
 5092:                   } // if zTopCanopy
 5093: 
 5094:                } // if iveg
 5095: 
 5096:                const double tmp = dt*dfz/dzz;
 5097:                alow[kin] += cff1*dzz/6.0 - tmp;
 5098:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5099: printf("####cff1 = %f, dzz = %f, tmp = %f, alow[%d] = %f, bdia[%d] = %f\n", cff1, dzz, tmp, alow[kin], kin, bdia[kin]);               
 5100:             } else { // Bottom boundary
 5101:                // This occurs at the bottom, where the bottom drag is applied.
 5102: 
 5103:                bdia[kin] += dt*side->chi2;
 5104: printf("####3 k = %d, kb + 1 = %d, nvrt - 1 = %d, chi2 = %f, alow[%d] = %f, bdia[%d] = %f\n", k, kb + 1, nvrt - 1, side->chi2, kin, alow[kin], kin, bdia[kin]);               
 5105:             } // if (k > kb + 1)
 5106: 
 5107: 
 5108: 
 5109:          } // for (int k
 5110: 
 5111: 
 5112: 
 5113:          // Computes the RHS.
 5114:          // -----------------
 5115: 
 5116:          //	BC to be imposed at the end.
 5117: 
 5118:          const Vector2 gradETP  = side->gradETP;
 5119:          const Vector2 gradPr   = side->gradPr;
 5120:          const Vector2 gradEta1 = side->gradEta1;
 5121:          const Vector2 gradEta2 = side->gradEta2;
 5122: 
 5123:          const Vector2 *btu = side->btu;
 5124:          const Vector2 *u2  = side->u2;
 5125:          const double coriolis = side->coriolis;
 5126:          const Vector2 *nuGradU = side->nuGradU;
 5127: 
 5128: 
 5129:          for (int k = kb + 1; k<nvrt; k++) {
 5130:             const int kin = k - kb;
 5131: 
 5132:             const double dz_0 = side->Dz(k);
 5133:             const double dz_1 = side->Dz(k+1);  
 5134: 
 5135:             rrhs[kin] = {0.0, 0.0};
 5136:             double dz = 0.0;
 5137: 
 5138:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5139:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5140:             if (k < nvrt  ) dz += 0.5*dz_1;
 5141:             if (k > kb + 1) dz += 0.5*dz_0;
 5142: 
 5143:             // Elevation gradient, atmospheric pressure and tidal potential
 5144:             rrhs[kin] = -dz*dt*(grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0);
 5145: 
 5146:             // Coriolis, advection, wind stress, and horizontal viscosity
 5147:             if (k < nvrt - 1) {
 5148: 
 5149: 
 5150:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5151:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5152:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5153: 
 5154:                //diff stress tensors 1006
 5155:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5156:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5157:                   assert(false && "Not implemented: itur == 5");
 5158:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5159:                }
 5160: 
 5161:             } else { // k=nvrt
 5162:                Vector2 tau2 = {0.0, 0.0};
 5163:                if constexpr(ics==1) {
 5164:                   tau2 = side->tau();
 5165:                } else {
 5166:                   assert(false && "Not implemented: ics == 2");
 5167:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5168:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5169:                   // taux2=(vn1+tt1)*0.5d0
 5170:                   // tauy2=(vn2+ss1)*0.5d0
 5171:                } // if ics
 5172: 
 5173:                rrhs[kin] += dt*tau2;
 5174: 
 5175:             } // if k<nvrt
 5176: 
 5177:             if (k > kb + 1) {
 5178:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5179:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5180:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5181: 
 5182: 
 5183:                // diff stress tensors 1006
 5184:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5185:                   assert(false && "Not implemented: itur == 5");
 5186:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5187:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5188:                }
 5189: 
 5190:             } // if k>kbs + 1
 5191: 
 5192:             // Baroclinic
 5193:             Vector2 *bcc = side->bcc;
 5194:             if constexpr(ibc == 0) {
 5195:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5196:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5197: 
 5198:             } // if ibc==0
 5199: 
 5200: 
 5201:          } // k=kb + 1,nvrt
 5202: 
 5203:    printf("#### bdia[0] = %f, bdia[1] = %f, bdia[2] = %f, bdia[3] = %f\n", bdia[0], bdia[1], bdia[2], bdia[3]);         
 5204:    // tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 5205:          tridag_sch<2>(nvrt, alow, bdia, cupp, (double *)rrhs, (double *)u, (double *)gam);
 5206: 
 5207:          for (int k=kb + 1; k<nvrt; k++) {
 5208:             const int kin = k - kb;
 5209: 
 5210:             // Velocity is always clamped to maximum values
 5211:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvel1, rmaxvel1), clamp(soln[kin].y, -rmaxvel2, rmaxvel2));
 5212:          } // k
 5213: 
 5214:       } // if side->is2D()
 5215:       
 5216: 
 5217:       // Impose velocity boundary condition at the bottom
 5218:       if constexpr(imm == 2) { // 3D bed deformation model
 5219:          double dep;
 5220:          Vector2 vel;
 5221: 
 5222:          assert(false && "Not implemented: imm == 2");
 5223:          //update_bdef(time, x0, y0, dep, vel);
 5224:          // side->u2[kb] = vel;
 5225: 
 5226:       } else { // imm = 0 or 1
 5227:          if (side->Cd() == 0.0) {
 5228:             side->u2[kb] = side->u2[kb + 1];
 5229:          } else if (nvrt > kb + 1) { // 3D no slip bottom
 5230:             side->u2[kb] = {0.0, 0.0};
 5231:          }
 5232:           
 5233:       } // if imm
 5234: 
 5235:       // The velocities below the bottom level are set to zero
 5236:       for (int k=0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5237: 
 5238: 
 5239:    }
 5240: 
 5241: 
 5242:    __global__ void applyMomentumBC(void) {
 5243: 
 5244:       SIDE_BND(sideBnd);
 5245: 
 5246:       Side *side = sideBnd->side;
 5247:       const BoundarySegment *segment = sideBnd->segment;
 5248:       const Node *n1 = side->n1;
 5249:       const Node *n2 = side->n2;
 5250: 
 5251:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5252: 
 5253:       // REMEMEBER, this is a trick, segment can be a pointer or (-1, -2)
 5254:       const bool isLand = segment->isLand;
 5255:       const int ifltype = segment->ifltype;
 5256: 
 5257:       const int kb = side->kb;
 5258: 
 5259: printf("ifltype = %d, isLand = %d, segment = %d\n", ifltype, segment->isLand, segment);    
 5260:       if (!isLand && ifltype != 0) {
 5261:          const Vector2 *ubc = sideBnd->ubc;
 5262:   
 5263:          for (int k=kb; k < nvrt; k++) {
 5264:             
 5265:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5266:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5267: 
 5268:             if (ifltype == -1) {
 5269:                // Flather 1
 5270: 
 5271:                const double depth = side->depth();
 5272: 
 5273:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5274: 
 5275:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5276: 
 5277:                side->u2[k] = vnorm*side->n;
 5278: 
 5279:             } else if (ifltype == -2) { // Discharge
 5280: 
 5281:                const double eta1 = side->eta1();
 5282:                const double eta2 = side->eta2();
 5283:                const double htot = side->htot2();
 5284: 
 5285:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5286:                assert(false && "Not implemented: Discharge bc");
 5287:                // const double dischrg = discharge(eta1);
 5288:                const double dischrg = 0.0; // XXX REMOVE
 5289:                
 5290: 
 5291:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5292: 
 5293:                const double vnorm = dischrg*eta2/htot;
 5294: 
 5295:                side->u2[k] = vnorm*side->n;
 5296: 
 5297: 
 5298:             }
 5299:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5300:                const double vnorm = dot(side->u2[k], side->n);
 5301: 
 5302:                double rat;
 5303:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5304:                else              rat = segment->vobc2; // outgoing
 5305: 
 5306:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5307:             }
 5308:             else { // not Flather or 3D radiation
 5309:                side->u2[k] = ubc[k];
 5310: 
 5311:             } // if (segment->ifltype...
 5312: 
 5313:          }
 5314: 
 5315:       }
 5316:       else if (isLand) { // if it is land boundary side
 5317: 
 5318:          if constexpr(islip == 0) { // free slip
 5319:             for (int k=kb; k < nvrt; k++) {
 5320:                double vnorm = 0.0; // for most cases
 5321:                const double vtan = dot(side->u2[k], side->t());
 5322:                const Vector2 t = side->t();
 5323:                const Vector2 n = side->n;
 5324: printf("islip   = %d, k = %d, side->idx = %d, u2 = %f,%f, vtan*t - vnorm*n = %f,%f\n", islip, k, side->idx, side->u2[k].x, side->u2[k].y, (vtan*t - vnorm*n).x, (vtan*t - vnorm*n).y);      
 5325:                side->u2[k] = vtan*t - vnorm*n;
 5326: printf("islipXX = %d, k = %d, side->idx = %d, u2 = %f,%f, vtan*t - vnorm*n = %f,%f\n", islip, k, side->idx, side->u2[k].x, side->u2[k].y, (vtan*t - vnorm*n).x, (vtan*t - vnorm*n).y);                     
 5327:             }
 5328: 
 5329:          } else { // no slip
 5330:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5331: 
 5332:          }
 5333:       } // if (side segment type...
 5334: 
 5335:    
 5336: 
 5337:    }
 5338: 
 5339: 
 5340:    __device__ void shapiroFilter1(void) {
 5341:       // First step of the Shapiro filter (normally used if indvel<=0)
 5342:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5343: 
 5344:       if constexpr(ishapiro == 0) return;
 5345: 
 5346:       SIDE(side);
 5347: 
 5348:       const bool isInternal = (side->sideBnd->segment == (BoundarySegment *)internalSegment);
 5349: 
 5350:       if (side->isDry || isInternal ) return;
 5351: 
 5352:       const int kb = side->kb;
 5353: 
 5354:       for (int mm = 1; mm <= niter_shap; mm++) {
 5355: 
 5356: 
 5357:          // Internal wet sides
 5358:          for (int k = kb + 1; k < nvrt; k++) {
 5359:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5360:             side->bcc[k] = {0.0, 0.0};
 5361:             Vector2 suru = {0.0, 0.0};
 5362: 
 5363:             for (int j=0; j<4; j++) {
 5364: 
 5365:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5366:                
 5367:                int kin = k;
 5368:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5369:                
 5370:                if constexpr(ics==1) {
 5371:                   suru += side->u2[kin];
 5372:                } else {
 5373:                   assert(false && "Not implemented: ics == 2");
 5374:                   // Vector2 vn1, vn2;
 5375:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5376:                   // suru=suru+vn1;
 5377:                   // surv=surv+vn2;
 5378:                }
 5379:             }
 5380: 
 5381:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5382: 
 5383:          }
 5384:       }
 5385:    }
 5386: 
 5387:    __device__ void shapiroFilter2(void) {
 5388:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5389: 
 5390:       if constexpr(ishapiro == 0) return;
 5391: 
 5392:       SIDE(side);
 5393: 
 5394:       const bool isInternal = (side->sideBnd->segment == (BoundarySegment *)internalSegment);
 5395: 
 5396:       if (side->isDry || isInternal ) return;
 5397: 
 5398:       const int kb = side->kb;
 5399: 
 5400:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5401: 
 5402:       if (side->is2D()) {
 5403:          side->u2[kb] = side->u2[nvrt - 1];
 5404:          
 5405:       } else {
 5406:          // 3D
 5407:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5408:          
 5409:       }
 5410: 
 5411:    }
 5412: 
 5413: 
 5414:    __global__ void ul0UpdateZCoords(void) {
 5415:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5416:       
 5417:       NODE(node);      
 5418: 
 5419:       if (node->isDry2()) { 
 5420: 
 5421:          assert((ivcor != 2) && (node->depth < mesh->h_s) && "Deep depth dry");
 5422: 
 5423:          if constexpr(ivcor != 1) node->kb = 0;
 5424: 
 5425:       } else {
 5426: 
 5427:          node->updateKb();
 5428:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5429: for (int k = node->kb; k < nvrt; k++) printf("k = %d, node->kb = %d, node->z[k] = %f\n", k, node->kb, node->z[k]);
 5430: 
 5431:       } // if wet or dry
 5432: 
 5433:       // We use the temp.b field to store the previous state of isDry.
 5434:       node->tmp.b = node->isDry;
 5435: 
 5436:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5437:       node->isDry = true;
 5438: 
 5439:    }
 5440: 
 5441:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5442:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5443:    {
 5444:       ELEM(elem);
 5445: 
 5446:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5447: 
 5448:       // All the nodes of a wet element are wet.
 5449:       if (!elem->isDry) {
 5450:          elem->nodes[0]->isDry = false;
 5451:          elem->nodes[1]->isDry = false;
 5452:          elem->nodes[2]->isDry = false;
 5453:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 5454: 
 5455:       }
 5456: 
 5457: 
 5458:       elem->kb = 0;
 5459: 
 5460:       if (elem->isDry) return;
 5461: 
 5462:       // Wet
 5463:       const Node *n1 = elem->nodes[0];
 5464:       const Node *n2 = elem->nodes[1];
 5465:       const Node *n3 = elem->nodes[2];  
 5466:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5467: 
 5468:    //    if(elem->isDry2()) {
 5469:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5470:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5471:    //        call parallel_abort(errmsg)
 5472:    //    }
 5473: 
 5474: 
 5475:       // Computes element's kb as the minimum of the nodes' kb.
 5476:       const int kb1 = n1->kb;
 5477:       const int kb2 = n2->kb;
 5478:       const int kb3 = n3->kb;
 5479:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5480: 
 5481: printf("kb1 = %d, kb2 = %d, kb3 = %d, kb4 = %d\n", kb1, kb2, kb3, kb4);
 5482: 
 5483:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5484: 
 5485: 
 5486:       // Computes the element z as the mean of the nodes z.
 5487:       for (int k = elem->kb; k < nvrt; k++) {
 5488: 
 5489:          // Compute the element z as the mean of the nodes z.
 5490:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5491:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5492:          elem->z[k] /= elem->i34;
 5493: 
 5494:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5495:       }
 5496:                   
 5497:    }
 5498: 
 5499:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5500:    {
 5501:       NODE(node);
 5502:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5503: 
 5504:       if (it == iths) return;
 5505: 
 5506: 
 5507:       if(!node->isDry && node->tmp.b) { // rewetted
 5508:          for (int k=0; k < nvrt; k++) {
 5509: 
 5510:             Vector3 utmp={0.0, 0.0, 0.0};
 5511: 
 5512:             double ttmp=0.0;
 5513:             double stmp=0.0;
 5514:             int icount=0;
 5515:             for (int j = 0; j < node->numNodes; j++) {
 5516: 
 5517: 
 5518:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5519:                if (!node->isDry) { // all indices extended
 5520:                   icount++;
 5521: 
 5522:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5523:                   utmp += node->u2[k];
 5524:                   
 5525:                   ttmp += node->tracers[k].tracer[0]; 
 5526:                   stmp += node->tracers[k].tracer[1]; 
 5527:                }
 5528:             }
 5529: 
 5530:             if(icount > 0) {
 5531:                const double inv_icount = 1.0/icount;
 5532:                node->u2[k]     = inv_icount*utmp;
 5533:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5534:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5535:             }
 5536:          }
 5537:       }
 5538:    }
 5539: 
 5540: 
 5541:    __global__ void ul0UpdateSides(int it, int iths) {
 5542: 
 5543:       SIDE(side);
 5544: 
 5545:       // A side is wet if and only if at least one of its elements is wet.
 5546:       const bool isWet = !side->elems[0]->isDry || (!side->isBnd2() && !side->elems[1]->isDry);
 5547: 
 5548:       const Node *n1 = side->n1;
 5549:       const Node *n2 = side->n2;
 5550:       const int kb1 = n1->kb;
 5551:       const int kb2 = n2->kb;
 5552: 
 5553:       side->kb = 0; // dry
 5554: 
 5555:       if (isWet) {
 5556: 
 5557:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5558: 
 5559:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5560: 
 5561:          side->kb = min(kb1, kb2);
 5562: 
 5563:          for (int k = side->kb; k < nvrt; k++) {
 5564:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5565: 
 5566:          
 5567:             assert((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0) && "Weird side (3)");
 5568: 
 5569:             // Compute velocity for re-wetted sides 
 5570:             if ((it != iths) && (side->isDry && isWet)) {
 5571:             
 5572:                Vector2 utmp={0.0, 0.0};
 5573: 
 5574:                int icount=0;
 5575: 
 5576:                // For all the sides on the two elements that share this side
 5577:                for (int j=0; j < 2; j++) {
 5578:                   const Element *elem = side->elems[j];
 5579:                   if (elem == nullptr) continue;
 5580: 
 5581:                   for (int jj=0; jj < elem->i34; jj++) {
 5582:                      const Side *nSide = elem->sides[jj];
 5583:                      if (nSide->isDry) continue;
 5584: 
 5585:                      icount++;
 5586:                      utmp += nSide->u2[k];                     
 5587:                   }
 5588:                }
 5589:                   
 5590:                assert(icount > 0 && "No wet sides around this side");
 5591:                if (icount > 0)  side->u2[k] = utmp/icount;
 5592:                   
 5593:             } // if ((it != iths) && (side->isDry && isWet))
 5594: 
 5595:          } // for k
 5596: 
 5597:       } // if isWet
 5598:    
 5599:       side->isDry = !isWet;
 5600: 
 5601:    }
 5602: 
 5603: 
 5604:    __global__ void zeroNodalVelocities(void) {
 5605:       NODE(node);
 5606: 
 5607:       for (int k = 0; k < nvrt; k++) {
 5608:          node->u2[k] = {0.0, 0.0, 0.0};
 5609:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5610:       }
 5611:    }
 5612: 
 5613:    __global__ void computeNodalVerticalVelocities1(void) {
 5614:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5615:    // Adds the element's vertical velocity times the element's area.
 5616:       ELEM(elem);
 5617: 
 5618:       for (int j = 0; j < elem->i34; j++) {
 5619:          Node *node = elem->nodes[j];
 5620: 
 5621:          for (int k = node->kb; k < nvrt; k++) {
 5622:             node->u2[k].z += elem->w[k]*elem->area;
 5623:             node->tmp.d += elem->area;
 5624:          }
 5625:       }
 5626:    }
 5627: 
 5628:    __global__ void computeNodalVerticalVelocities2(void) {
 5629:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5630:    // Divides by the total area of the elements sharing the    node.
 5631:       ELEM(elem);
 5632: 
 5633:       for (int j = 0; j < elem->i34; j++) {
 5634:          Node *node = elem->nodes[j];
 5635: 
 5636:          for (int k = node->kb; k < nvrt; k++) node->u2[k].z /= node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5637:       }
 5638:    }
 5639: 
 5640:    __global__ void computeNodalHorizontalVelocities(void) {
 5641:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 5642:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 5643:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 5644: 
 5645:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 5646: 
 5647:       SIDE(side);
 5648: 
 5649:       const int kb = side->kb;
 5650: 
 5651:       Node *n1 = side->n1;
 5652:       Node *n2 = side->n2;
 5653: 
 5654:       for (int k = kb; k < nvrt; k++) {
 5655: 
 5656:          // Cast the u2 vector into a Vector2 
 5657:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&n1->u2[k]);
 5658:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&n2->u2[k]);
 5659: 
 5660:          n1_u2 += side->u2[k]/n1->numSides;
 5661:          n2_u2 += side->u2[k]/n2->numSides;
 5662: 
 5663:       }
 5664: 
 5665: 
 5666:    }
 5667: 
 5668:    __global__ void resetVelocityOpenBndNodes(void) {
 5669:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 5670: 
 5671:       NODE_BND(nodebnd);
 5672: 
 5673:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 5674:          for (int k = 0; k < nvrt; k++) nodebnd->node->u2[k] = {0.0, 0.0, 0.0};
 5675:       }
 5676: 
 5677:    }
 5678: 
 5679: 
 5680:    __global__ void setVelocityOpenBndNodes(void) {
 5681:    // For open boundary nodes sets their velocity to the imposed values.
 5682: 
 5683:       SIDE_BND(sidebnd);
 5684: 
 5685:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 5686:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 5687:          // to its segment to the average of the side velocity.
 5688: 
 5689:          for (int k = 0; k < nvrt; k++) {
 5690:             Node *n1 = sidebnd->side->n1;
 5691:             Node *n2 = sidebnd->side->n2;
 5692: 
 5693:             // Cast the u2 vector into a Vector2 
 5694:             Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&n1->u2[k]);
 5695:             Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&n2->u2[k]);
 5696: 
 5697:             if (n1->nodeBnd->segment == sidebnd->segment) n1_u2 += sidebnd->side->u2[k]/n1->nodeBnd->numSidesForAverage();
 5698:             if (n2->nodeBnd->segment == sidebnd->segment) n2_u2 += sidebnd->side->u2[k]/n2->nodeBnd->numSidesForAverage();
 5699:          }
 5700:       }
 5701: 
 5702:    }
 5703: 
 5704: 
 5705:    __global__ void computeVerticalVelocity(void) {
 5706:       // Computes the vertical velocity at the (2D) element's centroid.
 5707:       // In this function we will be considering volumetric elements, with side faces and a 
 5708:       // bottom and a top face. We will call them SFs, BF and TF.
 5709:       // It computes the flux coming from BF and the SFs.
 5710:       // If the bed is moving, it takes that into account.
 5711:       // Since water is incompressible, the integral of the velocity times the normal vector
 5712:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 5713:       // and the BF is equal to the flux going out from the TF.
 5714:       // TF = - BF - sum(SFs).
 5715:       // It then computes the horizontal velocity at the center of TF.
 5716:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 5717:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 5718:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 5719: 
 5720:       ELEM(elem);
 5721: 
 5722:       if (elem->isDry) return;
 5723: 
 5724:       const int kb = elem->kb;
 5725:       const bool isTri = elem->isTri();
 5726: 
 5727:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 5728: 
 5729:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 5730:       const double av_bdef1 = elem->mean(&Node::bdef1);
 5731:       const double av_bdef2 = elem->mean(&Node::bdef2);
 5732: 
 5733:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 5734: 
 5735:       double area3D;
 5736: 
 5737:       // Bottom face flux
 5738:       double bottomFlux = 0.0;
 5739:       Vector2 u2meanBottom = {0.0, 0.0};
 5740:       const Vector2 gradh = elem->grad2(&Node::depth);
 5741:       if constexpr(imm==2) {
 5742:          Vector3 ubed;
 5743: 
 5744:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 5745:          // updateBDEF(ubed);
 5746:      
 5747:          // const double bflux0 = dot(ubed, elem_n1);
 5748: 
 5749:          // elem->w[kb] += ubed.z;
 5750:       }
 5751:       else {
 5752:          Vector2 umean;
 5753:          if constexpr(ics == 1) {
 5754:             u2meanBottom = elem->mean(kb, &Side::u2);
 5755:          }
 5756:          else {
 5757:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 5758:          }
 5759: 
 5760:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 5761:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 5762: 
 5763:          bottomFlux = - dot(gradh, u2meanBottom);
 5764:       } // if imm
 5765: 
 5766:       // Compute w for kb+1 to nvrt-1
 5767:       for (int l = kb; l < nvrt - 1; l++) {
 5768: 
 5769:          // normal vector to the top face of the "volumetric" element (3D)
 5770:          Vector3 elem_n2 = elem->n(l + 1, area3D); 
 5771: 
 5772:          // Compute the total flux at the sides
 5773:          double sideFlux = 0.0;
 5774:          Vector2 u2top = {0.0, 0.0};
 5775:          for (int j = 0; j < elem->i34; j++) {
 5776:             const Side *side = elem->sides[j];
 5777: 
 5778:             const double sideArea = side->area(l + 1);
 5779:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 5780:             const double sign = elem->ssign[j]; 
 5781: 
 5782:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 5783:          }
 5784:          
 5785:          // Compute the horizontal velocity at the center of the top face as an average of the 
 5786:          //velocities at the centers of the sides
 5787:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 5788: 
 5789:          // The flx at the top ace can be computed from the other flows.
 5790:          const double topFlux = - sideFlux - bottomFlux;
 5791:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 5792: 
 5793:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 5794: printf("sideFlux = %f, topHorizontalFlux = %f, bottomFlux = %f, area3D = %f, elem->w[%d] = %.16f, elem_n2.z = %f\n", sideFlux, topHorizontalFlux, bottomFlux, area3D, l + 1, elem->w[l + 1], elem_n2.z);
 5795:          elem_n1 = elem_n2;
 5796: 
 5797:          bottomFlux = - topFlux;
 5798:       }
 5799:    }  
 5800: 
 5801: 
 5802: 
 5803: 
 5804: 
 5805: 
 5806: //    __device__ void updateLevels1(void) {
 5807: //       // Routine to update level indices and wetting and drying.
 5808: //       // Used when resolution is fine enough.
 5809: //       // ONLY WORKS WITH PURE TRIs
 5810: 
 5811: 
