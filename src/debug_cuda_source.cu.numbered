  183: struct Bool4 {
  184:    unsigned int m; // bit i = lane i
  185: 
  186:    __device__ __forceinline__ bool get(int i) const { return (m >> i) & 1u; }
  187:    __device__ __forceinline__ void set(int i, bool v) {m = (m & ~(1u << i)) | ((unsigned int)(v) << i); }
  188: 
  189:    __device__ __forceinline__ bool all(void) const { return m == 0x0F; }
  190:    __device__ __forceinline__ bool any(void) const { return m != 0; }
  191:    __device__ __forceinline__ bool none(void) const { return m == 0; }
  192:    __device__ __forceinline__ int firstOne(void) const { return __ffs(m) - 1; }
  193: 
  194: };
  195: 
  196: __device__ __forceinline__ Bool4 operator!(Bool4 x) { x.m = (~x.m) & 0x0F; return x; }
  197: __device__ __forceinline__ Bool4 operator&(Bool4 a, Bool4 b) { return Bool4{(unsigned int)(a.m & b.m)}; }
  198: __device__ __forceinline__ Bool4 operator|(Bool4 a, Bool4 b) { return Bool4{(unsigned int)(a.m | b.m)}; }
