 2077: __device__ __inline__ double min3(double a, double b, double c) {
 2078:    return min(a, min(b, c));
 2079: }
 2080: 
 2081: __device__ __inline__ double max3(double a, double b, double c) {
 2082:    return max(a, max(b, c));
 2083: }
 2084: 
 2085: __device__ __inline__ double min4(double a, double b, double c, double d) {
 2086:    return min(a, min(b, min(c, d)));
 2087: }
