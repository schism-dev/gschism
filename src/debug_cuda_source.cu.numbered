 2228:    
 2229:    __forceinline__ __device__ void Element::projectNodeVectorsToElementFrame(Vector2 *v) const {
 2230:    // Project the vectors from the node frame to the element frame
 2231: 
 2232:  
 2233:       v[0] = nodes[0]->frame.projHorVec(v[0], frame);
 2234:       v[1] = nodes[1]->frame.projHorVec(v[1], frame);
 2235:       v[2] = nodes[2]->frame.projHorVec(v[2], frame);
 2236:       if (isQuad()) v[3] = nodes[3]->frame.projHorVec(v[3], frame);
 2237:       else          v[3] = Vector2();
 2238:    }
 2239: 
 2240:    __forceinline__ __device__ void Element::projectSideVectorsToElementFrame(Vector2 *v) const {
 2241:    // Project the vectors from the side frame to the element frame
 2242: 
 2243:       v[0] = sides[0]->frame.projHorVec(v[0], frame);
 2244:       v[1] = sides[1]->frame.projHorVec(v[1], frame);
 2245:       v[2] = sides[2]->frame.projHorVec(v[2], frame);
 2246:       if (isQuad()) v[3] = sides[3]->frame.projHorVec(v[3], frame);
 2247:       else          v[3] = Vector2();
 2248:    }
