 8115: extern "C" __global__ void populateSides(int *i34, int *sharedIdxSideBoundary,
 8116:                                          double *node_coords, double *node_coords_ll, bool use_ll,
 8117:                                          double *wind_rotate_angle,   
 8118:                                          int *isdel, int *isidenode, int *isbnd,
 8119:                                          int *nond, int *nlnd, int *iond, int *ilnd,                                  
 8120:                                          int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 8121:                                          int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 8122:                                          int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 8123:                                          int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 8124:                                          int *localNodePart,     int *localElemPart,     int *localSidePart,
 8125:                                          double *drag, double *roughness) {
 8126:    mesh->populateSides(i34, sharedIdxSideBoundary,
 8127:                        node_coords, node_coords_ll, use_ll,
 8128:                        wind_rotate_angle,   
 8129:                        isdel, isidenode, isbnd,
 8130:                        nond, nlnd, iond, ilnd,                                  
 8131:                        nodeNeighNodesStart, nodeNeighNodesIndices, nodeNeighElemsStart, nodeNeighElemsIndices, globalNodeIndices, globalElemIndices, globalSideIndices, localNodeIndices, localElemIndices, localSideIndices, localNodePart, localElemPart, localSidePart, drag, roughness);                          
 8132: 
 8133: }
 8134: 
 8135: extern "C" __global__ void populateElements(int *i34, int *elnode, int *elside,
 8136:    double *node_coords, double *node_coords_ll, bool use_ll,
 8137:    double *wind_rotate_angle,   
 8138:    int *isdel, int *isidenode, int *isbnd,
 8139:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 8140:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 8141:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 8142:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 8143:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 8144:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 8145:    double *drag, double *roughness) {
 8146:    mesh->populateElements(i34, elnode, elside,
 8147:                           node_coords, node_coords_ll, use_ll,
 8148:                           wind_rotate_angle,   
 8149:                           isdel, isidenode, isbnd,
 8150:                           nond, nlnd, iond, ilnd,                                  
 8151:                           nodeNeighNodesStart, nodeNeighNodesIndices, nodeNeighElemsStart, nodeNeighElemsIndices, globalNodeIndices, globalElemIndices, globalSideIndices, localNodeIndices, localElemIndices, localSideIndices, localNodePart, localElemPart, localSidePart, drag, roughness);                          
 8152: 
 8153: } 
