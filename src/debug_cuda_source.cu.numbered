 3931: 
 3932: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3933:    // Computes the z coordinate at level k.
 3934:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3935:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3936:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3937:    // used 
 3938: 
 3939:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3940:    
 3941:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3942: 
 3943:    if (isDry2()) return 0.0;  
 3944: 
 3945:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3946: 
 3947:    if constexpr(ivcor == 2) {
 3948: 
 3949:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3950:       const double h_c = mesh->h_c;
 3951:       const double theta_f = mesh->theta_f;
 3952:       const double sinh_theta_f = mesh->sinh_theta_f;
 3953: 
 3954: 
 3955:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3956:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3957:       // once per time step/node. XXXX
 3958:       // CHECK: updateZCoordData
 3959: 
 3960:       //  To simplify comparisons, I define index versions of count variables.
 3961:       if      (k == ivrt)     return eta2; 
 3962:       else if (k == izlev)    return -hmod2;
 3963:       else if (k == kb)       return -depth;
 3964:       else if (k < izlev)     return mesh->ztot[k];
 3965:       else if (k > izlev) {
 3966:          const int ksig = k - izlev;
 3967: 
 3968:          if (hmod2 <= h_c) {
 3969:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3970: 
 3971:          } 
 3972:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3973:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3974:             assert(false && "compZCoord: invalid h_c\n");
 3975:          } 
 3976:          else {
 3977:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3978:                    h_c * mesh->sigma[ksig] + 
 3979:                    (hmod2 - h_c) * mesh->cs[ksig];
 3980:          }
 3981:       } else { 
 3982:          assert(false && "compZCoord: invalid level or coordinate system\n");
 3983:       }
 3984: 
 3985:    }
 3986:    else {  // if constexpr(ivcor == 1)
 3987:       if (k <= kb)        return -depth; 
 3988:       else if (k == ivrt) return eta2;
 3989:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3990: 
 3991:    }
 3992:    
 3993:    assert(false && "compZCoord: invalid level or coordinate system\n");
 3994:    return 0.0;
 3995: }
 3996: 
 3997: 
 3998: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3999:    // Computes the bottom drag Cd based on the selected nchi
 4000: 
 4001:    if constexpr(nchi == 0) {
 4002:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 4003:       Cd = drag;  // Read from drag file
 4004: 
 4005:    } else if constexpr(nchi == 1) {
 4006:       // 
 4007: 
 4008:       bool ltmp = false; // for WBL iteration
 4009: 
 4010:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4011:       if (isDry || (rough == 0.0)) {
 4012:          Cd = 0.0;
 4013: 
 4014:       } else { //roughness >0 
 4015:          
 4016:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 4017: 
 4018:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 4019: 
 4020:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 4021: 
 4022:       } // if rough
 4023: 
 4024:    } else if constexpr(nchi == -1) {
 4025:    // Manning 
 4026:  
 4027:       const double htot = max(hmin_man, htot2()); 
 4028:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 4029: 
 4030:    } else {
 4031:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 4032:       
 4033:    } // if nchi
 4034: 
 4035: }
 4036: 
 4037: 
 4038: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 4039:    // Checks if a side in on the boundary
 4040:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 4041: 
 4042:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 4043:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 4044: 
 4045:    // Indices of the nodes that form the side
 4046:    //
 4047:    // NOTE: This function is slow. It's to be called from "populate" functions, not from the main loop.
 4048:    const int n1 = side.n1->idx;
 4049:    const int n2 = side.n2->idx;
 4050:    isLand = false;
 4051:    
 4052: 
 4053:    // Check if the side is on a land boundary
 4054:    for (int i = 0; i < nland; i++) {
 4055:       for (int j = 0; j < nlnd[i] - 1; j++) {
 4056:          // Consecutive nodes in the land boundary segment
 4057:          const int b1 = ilnd[i + j*nland];
 4058:          const int b2 = ilnd[i + (j + 1)*nland];
 4059: 
 4060:          assert(b1 != -1 && b2 != -1);
 4061: 
 4062:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 4063:             
 4064:             isLand = true;
 4065:             return i;
 4066:          }
 4067:       }
 4068:    }
 4069: 
 4070:    // Check if the side is on an open boundary
 4071:    for (int i = 0; i < nope; i++) {
 4072:       for (int j = 0; j < nond[i] - 1; j++) {
 4073:          // Consecutive nodes in the open boundary segment
 4074:          const int b1 = iond[i + j*nope];
 4075:          const int b2 = iond[i + (j + 1)*nope];
 4076: 
 4077:          assert(b1 != -1 && b2 != -1);
 4078: 
 4079:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 4080:             isLand = false;
 4081:             return i;
 4082:          }
 4083:       }
 4084:    }
 4085: 
 4086:    // Check that the nodes are not both on the boundary
 4087:    assert( (side.n1->nodeBnd == nullptr || side.n2->nodeBnd == nullptr)
 4088:         && "side not in ilnd/iond but both nodes are boundary" );
 4089: 
 4090:    return -1;
 4091: }
 4092: 
 4093: 
 4094: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 4095:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4096:                                     double *wind_rotate_angle, 
 4097:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4098:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4099:                                     int16_t *nodePermutationSort, double *crs_data,
 4100:                                     int *localNodeNeighNodesStart, int *localNodeNeighElemsStart, 
 4101:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4102:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4103:                                     int *localNodePart,     int *localElemPart,     int *localSidePart, 
 4104:                                     double *drag, double *roughness, double *rmanning, 
 4105:                                     double *diffmin, double *diffmax,
 4106:                                     int *kb, double *localSigma) {
 4107: 
 4108:    NODE(pnode);  
 4109:    const int i = idx_node;
 4110:    const int iglobal = globalNodeIndices[i];
 4111:    Node &node(*pnode);
 4112: 
 4113:    node.idx = iglobal;
 4114:    node.part = localNodePart[iglobal];
 4115: 
 4116:    // It is important to differentiate between the global and local "start" indices because they
 4117:    // play different, but related, roles in this code. The global "start" indices are used
 4118:    // for the CSR-like indexing of the node and element neighbor arrays in the "global"
 4119:    // (unpartitioned) mesh. The local "start" indices are used for the CSR-like indexing of the 
 4120:    // node and element neighbor arrays in the "local" (partitioned) mesh.
 4121:    const int idxNodeStart = nodeNeighNodesStart[iglobal];
 4122:    const int idxNodeEnd   = nodeNeighNodesStart[iglobal + 1];
 4123:    const int idxNodeLocalStart = localNodeNeighNodesStart[i];
 4124:    node.numNodes = idxNodeEnd - idxNodeStart;
 4125:    node.nodes = nodeNeighNodes + idxNodeLocalStart;
 4126: 
 4127:    const int rowStart = idxNodeLocalStart + i; // +i is to account for the diagonal element.
 4128:    node.coeffRow = crs_data + rowStart; 
 4129: 
 4130:    node.csrSlot = nodePermutationSort + idxNodeLocalStart;
 4131: 
 4132: 
 4133: 
 4134:    const int idxElemStart = nodeNeighElemsStart[iglobal];
 4135:    const int idxElemEnd   = nodeNeighElemsStart[iglobal + 1]; 
 4136:    const int idxElemLocalStart = localNodeNeighElemsStart[i];
 4137:    node.numElements = idxElemEnd - idxElemStart;
 4138:    node.elements = nodeNeighElems + idxElemLocalStart;
 4139: 
 4140: 
 4141:    for (int idx = idxNodeStart, idxLocal = idxNodeLocalStart; idx < idxNodeEnd; idx++, idxLocal++) {
 4142:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 4143:       const int partNode = localNodePart[idxNodeGlobal]; 
 4144:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 4145: 
 4146:       Node *node_ptr = nodes[partNode] + idxNode;
 4147:       
 4148:       nodeNeighNodes[idxLocal] = node_ptr;
 4149:    }
 4150: 
 4151: 
 4152:    for (int idx = idxElemStart, idxLocal = idxElemLocalStart; idx < idxElemEnd; idx++, idxLocal++) {
 4153:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 4154:       const int partElem = localElemPart[idxElemGlobal];
 4155:       const int idxElem  = localElemIndices[idxElemGlobal];
 4156: 
 4157:       Element *elem_ptr = elems[partElem] + idxElem;
 4158: 
 4159:       nodeNeighElems[idxLocal] = elem_ptr;
 4160:    }      
 4161: 
 4162:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 4163:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 4164: 
 4165:    sincosf(-(float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 4166: 
 4167:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 4168:    if constexpr(ics == 1) {
 4169:       node.p.x   = node_coords[i * 3];
 4170:       node.p.y   = node_coords[i * 3 + 1];
 4171:       node.gz = 0.0;
 4172: 
 4173:       if (use_ll) {                                    // <-- add
 4174:          node.lon = node_coords_ll[i * 2    ]*deg2rad; // <-- add
 4175:          node.lat = node_coords_ll[i * 2 + 1]*deg2rad; // <-- add
 4176:       }  
 4177: 
 4178:    } else {
 4179:       const double lon = deg2rad*node_coords[i * 3];
 4180:       const double lat = deg2rad*node_coords[i * 3 + 1];
 4181: 
 4182:       Point3 p = computeXYZfromLatLon(lat, lon);
 4183:       node.p = toVector2(p);
 4184:       node.gz = p.z;
 4185:       node.lon = lon;
 4186:       node.lat = lat;
 4187: 
 4188:       #ifdef USE_FRAMES
 4189:       node.setFrame(lat, lon);
 4190:       #endif
 4191: 
 4192: 
 4193:    }
 4194: 
 4195:    node.depth = node_coords[i * 3 + 2];
 4196: 
 4197:    node.numSides = 0;
 4198: 
 4199:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 4200:    if      constexpr(nchi ==  0) node.drag     = drag[iglobal];
 4201:    else if constexpr(nchi ==  1) node.rough    = roughness[iglobal];
 4202:    else if constexpr(nchi == -1) node.rmanning = rmanning[iglobal];
 4203:    else assert(false && "populateNodes: selected nchi not implemented.");
 4204: 
 4205:    // Populate the diffmin and diffmax values read from the files.
 4206:    // (Only used for GLS, GOTM, and SedimentMix.)
 4207:    node.turb.setDiffLimits(diffmin[iglobal], diffmax[iglobal]);
 4208: 
 4209:    if constexpr(ivcor == 1) 
 4210:    {  
 4211:       node.kb = kb[iglobal];
 4212: 
 4213:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + iglobal*nvrt];
 4214:    }
 4215: 
 4216:    for (int k = 0; k < nvrt; k++) {
 4217:       node.rho[k] = rho0;
 4218:       node.z[k] = -1e20;
 4219:    }
 4220: 
 4221:    // Initialize the turbulence model including the vertical viscosity/diffusivity
 4222:    node.turb.init(&node);
 4223: 
 4224:    
 4225:    // Links the node to the boundary information
 4226:    if (isbnd[iglobal] >= 0) {
 4227:      
 4228:       // Get the index of the node boundary
 4229:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 4230: 
 4231:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 4232:       node.nodeBnd->node = &node;
 4233: 
 4234:       node.nodeBnd->sideBnd1 = nullptr;
 4235:       node.nodeBnd->sideBnd2 = nullptr;
 4236: 
 4237:       if (isbnd[iglobal]>=0) {
 4238: 
 4239:          node.nodeBnd->segment = &(localSegmentMem[isbnd[iglobal]]);
 4240:          
 4241:          node.nodeBnd->segment->ifltype = 0; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 4242:          node.nodeBnd->segment->iettype = 0; // XXXXXXXXX
 4243: 
 4244:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 4245:          node.nodeBnd->segment->clen  = nan("1");
 4246:          node.nodeBnd->segment->carea = nan("1");
 4247: 
 4248:       }
 4249:    } else {
 4250: 
 4251:       node.nodeBnd = nullptr; // For internal nodes
 4252: 
 4253:       if (isbnd[iglobal] == landSegment) {
 4254:          node.nodeBnd = landBoundaryNode;
 4255:          node.nodeBnd->segment = landBoundarySegment;
 4256:       }
 4257:       
 4258:    }
 4259:    
 4260:    // XXXX GAUSSIAN HILL VELOCITIES
 4261:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4262:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4263:          constexpr double rot_per = 3000.0;
 4264:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 4265:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 4266:       // XXXXX
 4267:    #endif
 4268: 
 4269: }
 4270: 
 4271: __device__ void Mesh::populateNodes2(int *localNodeNeighNodesStart, int *crs_indices, int *crs_indptr) {
 4272:    
 4273:    NODE(node);
 4274:    const int localIdx = idx_node;
 4275: 
 4276: 
 4277:    // Computes csrSlot, the array of indices/slots of the neighbor nodes in the CRS matrix.
 4278:    int16_t *csrSlot = node->csrSlot;  
 4279: 
 4280:    // Simply count the number of nodes with a smaller global index than the current node.
 4281:    // It accounts for the diagonal element.
 4282:    // packedIndex is a special type of global index in which nodes are counted in the order as the
 4283:    // local index, but taking into account all the partitions (in order).
 4284:    for (int i = 0; i < node->numNodes; ++i) {
 4285:       const int col = node->nodes[i]->packedIndex();
 4286:       int16_t idx = 0;
 4287: 
 4288:       //Takes care of the diagonal element.
 4289:       if (node->packedIndex() < col) ++idx;          
 4290: 
 4291:       for (int j = 0; j < node->numNodes; ++j) if (node->nodes[j]->packedIndex() < col) ++idx;
 4292:       csrSlot[i] = idx;
 4293:    }
 4294: 
 4295:    // Find the diagonal element in the CRS matrix.
 4296:    int16_t idxDiag = 0;
 4297:    for (int j = 0; j < node->numNodes; ++j)
 4298:       if (node->nodes[j]->packedIndex() < node->packedIndex()) ++idxDiag;
 4299: 
 4300:    node->coeffDiag = &(node->coeffRow[idxDiag]);
 4301: 
 4302:    // Fills the CRS indices and indptr arrays for the cupyz's crs matrix in the solver.
 4303:    const int idxNodeLocalStart = localNodeNeighNodesStart[localIdx];
 4304: 
 4305:    const int rowStart = idxNodeLocalStart + localIdx;  // +i is to account for the diagonal element.
 4306:    const int rowNNZ = node->numNodes + 1;        // +1 is to account for the diagonal element.
 4307:    crs_indptr[localIdx] = rowStart;
 4308: 
 4309:    // Fills crs_indices array using the per-partition indexing.
 4310:    const int d = (int)(node->coeffDiag - node->coeffRow);
 4311:    crs_indices[rowStart + d] = node->packedIndex();  
 4312:    for (int j = 0; j < node->numNodes; ++j) {
 4313:       Node *nb = node->nodes[j];
 4314:       crs_indices[rowStart + node->csrSlot[j]] = nb->packedIndex();
 4315:    }
 4316: 
 4317: 
 4318: }
 4319: 
 4320: 
 4321: 
 4322: 
 4323: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 4324:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4325:                                     double *wind_rotate_angle,   
 4326:                                     int *isdel, int *isidenode, int *isbnd,
 4327:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4328:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4329:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4330:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4331:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4332:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 4333:                                     double *drag, double *roughness) {
 4334: 
 4335: 
 4336:    SIDE(pside);
 4337:    Side &side(*pside);
 4338:    const int i = idx_side;
 4339:    const int iglobal = globalSideIndices[i];
 4340:    side.idx = iglobal;  
 4341:    
 4342:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 4343:    const double fc   = 2.0*omega_e*sin(sfea0);
 4344:    const double beta = 2.0*omega_e*cos(sfea0);
 4345: 
 4346:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 4347: 
 4348:    // finding the pointer to the nodes that form the side
 4349:    const int idx_n1 = isidenode[iglobal*2];
 4350:    const int idx_n2 = isidenode[iglobal*2 + 1];
 4351: 
 4352: // if (i % 100 == 0) printf("populateSides: iglobal = %d, idx_n1 = %d, idx_n2 = %d\n", iglobal, idx_n1, idx_n2);
 4353: 
 4354:    const int locidx_n1 = localNodeIndices[idx_n1];
 4355:    const int locidx_n2 = localNodeIndices[idx_n2];
 4356:    const int part_n1 =   localNodePart[idx_n1];
 4357:    const int part_n2 =   localNodePart[idx_n2];
 4358: 
 4359: // if (i % 100 == 0) printf("populateSides: i = %d, part_n1 = %d, part_n2 = %d, locidx_n1 = %d, locidx_n2 = %d\n", i, part_n1, part_n2, locidx_n1, locidx_n2);
 4360: // if (i % 100 == 0) printf("populateSides: i = %d, nodes[part_n1] = %p, nodes[part_n2] = %p\n", i, mesh->nodes[part_n1], mesh->nodes[part_n2]);
 4361: 
 4362:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 4363:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 4364: 
 4365: // if (i % 100 == 0) printf("populateSides: 1, i = %d, side.n1 = %p, side.n2 = %p\n", i, side.n1, side.n2);
 4366: 
 4367:    // Counts the number of sides connected to each node
 4368:    atomicAddInt16Unsafe(&side.n1->numSides, 1);  // Unsafe here means that it doesn't check for overflow. This function is defined in this file.
 4369:    atomicAddInt16Unsafe(&side.n2->numSides, 1);
 4370: 
 4371:    // Side boundary type
 4372:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 4373:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 4374: // if (i == 0) printf("populateSides: 2\n");
 4375: 
 4376:    if (n1bnd != nullptr && n2bnd != nullptr) 
 4377:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 4378:    {
 4379:       bool isLand = false;
 4380:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 4381:       
 4382:       if (isbs > -1) {
 4383:          // assert(isLand || isbs>=0);
 4384:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 4385: 
 4386:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 4387: 
 4388:          if   (isLand) side.sideBnd->segment = landBoundarySegment;
 4389:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 4390: 
 4391:          assert (isLand == side.sideBnd->segment->isLand);
 4392:          
 4393:          side.sideBnd->side = &side;
 4394: 
 4395:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4396:          n1bnd->linkSideBoundary(side.sideBnd);
 4397:          n2bnd->linkSideBoundary(side.sideBnd);
 4398: 
 4399:       }
 4400:       else {
 4401:          side.sideBnd = nullptr;
 4402:       }
 4403:    }
 4404:    else 
 4405:    {
 4406:       side.sideBnd = nullptr;
 4407:    }
 4408: 
 4409: // if (i % 100 == 0) printf("populateSides: 3, i = %d\n", i);
 4410: 
 4411:    // finding the pointer to the elements that share the side
 4412:    const int idx_e1 = isdel[iglobal*2];
 4413:    const int idx_e2 = isdel[iglobal*2 + 1];
 4414: 
 4415:    if (idx_e1 > -1) {
 4416:       const int locidx_e1 = localElemIndices[idx_e1];
 4417:       const int part_e1 =  localElemPart[idx_e1];
 4418:       side.elems[0] = elems[part_e1] + locidx_e1;
 4419: 
 4420:    }
 4421:    else {
 4422:       side.elems[0] = nullptr;
 4423:    }
 4424: 
 4425: // if (i % 100 == 0) printf("populateSides: 4, i = %d\n", i);
 4426: 
 4427:    if (idx_e2 > -1) {
 4428:       const int locidx_e2 = localElemIndices[idx_e2];
 4429:       const int part_e2 =  localElemPart[idx_e2];
 4430:       side.elems[1] = elems[part_e2] + locidx_e2;
 4431:    }
 4432:    else {
 4433:       side.elems[1] = nullptr;
 4434:    }
 4435: 
 4436: // if (i % 100 == 0) printf("populateSides: 5, i = %d\n", i);
 4437: 
 4438:    if (side.elems[1] == nullptr && side.sideBnd == nullptr) {
 4439:       
 4440:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 4441:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 4442:       printf("Side %d has no elements and no boundary. Types = %p, %p\n", i, n1bnd, n2bnd);
 4443:          
 4444:       // printf("idx_e1: %d, idx_e2: %d\n", idx_e1, idx_e2);
 4445:       // printf("elems[0]: %p, elems[1]: %p\n", side.elems[0], side.elems[1]);
 4446:       // printf("sideBnd: %p\n", side.sideBnd);
 4447:       // assert(false && "Side has no elements and no boundary");
 4448:    }
 4449:    // assert(side.elems[1] != nullptr || side.sideBnd != nullptr);
 4450: 
 4451:    // Compute the center of the side
 4452:    side.center = 0.5*(side.n1->p + side.n2->p);
 4453: 
 4454:    #ifdef USE_FRAMES
 4455:    side.setFrame();
 4456:    #endif
 4457: 
 4458: // if (i % 100 == 0) printf("populateSides: 6, i = %d\n", i);
 4459: 
 4460:    // Normal, unitary vector to the side
 4461:    if constexpr(ics == 1) {
 4462:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4463:       side.n = normalize(side.n);
 4464:    }
 4465:    else {
 4466:       // Unit side vector in 3D cartesian coordinates
 4467:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4468: 
 4469:       nSide = normalize(nSide);
 4470: 
 4471:       // Its cross product with the unit local z-axis vector (nUp) is the
 4472:       // normal vector we are looking for.
 4473:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4474: 
 4475:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4476:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4477:       side.n = -normalize(n2D); 
 4478: 
 4479:    }
 4480: 
 4481: // if (i % 100 == 0) printf("populateSides: 7, i = %d\n", i);
 4482: 
 4483:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4484:    side.shapiro = shapiro0;
 4485: 
 4486:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4487:    // XXXX
 4488:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4489:    constexpr double rot_per=3000.0;
 4490:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4491:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4492:    // XXXXX      
 4493:    #endif
 4494:    // Compute the z level at the center of the side
 4495:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4496:    
 4497:    // Compute the length of the side
 4498:    side.len = length(toPoint3(side.n2->p, side.n2->gz) - toPoint3(side.n1->p, side.n1->gz));
 4499: 
 4500: // if (i % 100 == 0) printf("populateSides: 8, i = %d\n", i);
 4501: 
 4502:    // Compute the Coriolis coefficient
 4503: 
 4504:    if constexpr(ncor == -1 || ncor == 0) {
 4505:       side.coriolis = coricoef;
 4506:    }
 4507:    else {
 4508:       const double sphi = side.lat();  // Latitude at the center of the side
 4509: 
 4510:       assert(use_ll && "use_ll must be true when ncor > 0");
 4511: 
 4512:       if constexpr(ics == 1) {
 4513:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4514:       }
 4515:       else { // ics == 2
 4516:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4517:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4518:       }
 4519: 
 4520:    }
 4521: 
 4522: // if (i % 100 == 0) printf("populateSides: 9, i = %d\n", i);
 4523: 
 4524: }
 4525: 
 4526: 
 4527: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4528:    double *node_coords, double *node_coords_ll, bool use_ll,
 4529:    double *wind_rotate_angle,   
 4530:    int *isdel, int *isidenode, int *isbnd,
 4531:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4532:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4533:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4534:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4535:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4536:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4537:    double *drag, double *roughness) {
 4538: 
 4539:    ELEM(pelem);
 4540:    Element &elem(*pelem);
 4541:    const int i = idx_elem;
 4542: 
 4543:    elem.idx = i;
 4544: 
 4545:    for (int j = 0; j < i34[i]; j++) {
 4546:       const int idxNode = elnode[i*4 + j];  
 4547:       const int idxSide = elside[i*4 + j];
 4548:       
 4549:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4550:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4551: 
 4552:       // Find the neighboring element  
 4553:       if (elem.sides[j]->elems[0] == &elem) {
 4554:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4555:       }
 4556:       else {
 4557:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4558:       }
 4559:       
 4560:    }
 4561: 
 4562:    elem.i34 = i34[i];
 4563: 
 4564:    // Compute the barycenter of the element and its depth
 4565:    elem.center = {0.0, 0.0};
 4566:    elem.depth = 1e10;
 4567:    for (int j = 0; j < i34[i]; j++) {
 4568: 
 4569:       elem.center += elem.nodes[j]->p/i34[i];
 4570:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4571:    }
 4572: 
 4573:    #ifdef USE_FRAMES
 4574:    elem.setFrame();
 4575:    #endif
 4576: 
 4577:    elem.area = elem.computeSignedArea(); 
 4578:    elem.radius = sqrt(elem.area)/pi; 
 4579:    
 4580:    // Determines which way the normal vector to each side is oriented.
 4581:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4582:    for (int j = 0; j < i34[i]; j++)  
 4583:    {
 4584:       if (elem.sides[j]->elems[0] == &elem) {
 4585:          elem.ssign[j] =  1.0;
 4586:       }
 4587:       else {
 4588:          elem.ssign[j] = -1.0;
 4589:       }
 4590: 
 4591:    }
 4592: 
 4593:   
 4594: 
 4595:    // Derivatives of shape functions
 4596:    //  For ics=2, this is done in the element frame
 4597:    //  For quads, the derivative is evaluated at centroid
 4598:    for (int j = 0; j < elem.i34; j++) {
 4599:       const double area = elem.area;
 4600:       const int id2 = elem.nxq(1 + j);
 4601:       const int id3 = elem.nxq(2 + j);
 4602:       const int id4 = elem.nxq(3 + j);
 4603:       if (elem.isTri()) {
 4604:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4605:          // phi_0 = (x2 - x0)^(x - x0)/((x2 - x0)^(x1 - x0)), where ^ is the cross product
 4606:          // phi_0 = (x2 - x0)^(x - x0)/(2*area)
 4607:          // dphi_0/dx = (x2.y - x0.y)/(2*area)
 4608:          // dphi_0/dy = (x0.x - x2.x)/(2*area)
 4609:          // And so on for the other shape functions.
 4610: 
 4611:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4612:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4613:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4614: 
 4615:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4616:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4617: 
 4618:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4619: 
 4620:       }
 4621:       else  { // Quad, the derivatives are evaluated at the centroid
 4622: 
 4623:          // The derivation is complicated, but it starts by defining the shape functions in terms of the local coordinates (eta, xi).
 4624:          // phi_0 = (1 + eta*eta_n(0))*(1 + xi*xi_n(0))/4
 4625:          // ...
 4626:          // and then the derivatives are computed at the centroid (eta = 0, xi = 0)
 4627: 
 4628:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4629:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4630:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4631: 
 4632:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4633:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4634: 
 4635:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4636: 
 4637:       } // if Tri/Quad
 4638: 
 4639:    } // for j   
 4640:    
 4641:    
 4642: 
 4643: }
 4644: 
 4645: 
 4646: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4647:                                             double *emo, double *efa, 
 4648:                                             double *umo, double *ufa, 
 4649:                                             double *vmo, double *vfa,
 4650:                                             int *ifltype, int *iettype, double *qthcon) {
 4651: 
 4652:    NODE_BND(nodeBnd);
 4653:    const int idx = idx_node_bnd;    
 4654: 
 4655:    nodeBnd->idx = idx;
 4656: 
 4657:    // Need to find the segment index and the index of the node on the segment
 4658:    int idxNode = -1;
 4659:    int iseg, i;
 4660:    for (iseg = 0; iseg < nope; iseg++) {
 4661:       // for each segment...
 4662:       for (i = 0; i < nond[iseg]; i++) {
 4663:          idxNode = iond[iseg + i*nope];
 4664:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 4665:          
 4666:       }
 4667:    }
 4668: 
 4669:    assert(iseg < nope && "iseg is out of bounds");
 4670: 
 4671: found: // Jumped here when the node was found
 4672: 
 4673:    nodeBnd->isEssentialBC = (iettype[iseg] != 0);
 4674:    nodeBnd->elbc = 0.0;
 4675: 
 4676:    nodeBnd->segment->ifltype = ifltype[iseg];
 4677:    nodeBnd->segment->iettype = iettype[iseg];
 4678:    nodeBnd->segment->qthcon  = qthcon[iseg];
 4679: 
 4680:    for (int jfr = 0; jfr < nbfr; jfr++) {
 4681: 
 4682:       const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4683: 
 4684:       nodeBnd->efa[jfr] = efa[idx2];
 4685:       nodeBnd->emo[jfr] = emo[idx2];
 4686:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 4687:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 4688: 
 4689:    }
 4690:         
 4691: 
 4692: }
 4693: 
 4694: __device__ void Mesh::populateBoundarySideLinks(void) {
 4695: 
 4696:    SIDE_BND(sideBnd);
 4697: 
 4698:    const Side *side = sideBnd->side;
 4699: 
 4700:    // We assume that the leftSide is the side s that has s->n2 == side->n1
 4701:    // and the rightSide is the side s that has s->n1 == side->n2
 4702:    for (int i = 0; i < mesh->nbs; i++) {
 4703: 
 4704:       Side *s = &mesh->localSideData[i];
 4705: 
 4706:       if (s == side) continue;  // Do not link the side to itself
 4707:    
 4708:       if (s->n1 == side->n2) sideBnd->leftSide  = s;
 4709:       if (s->n2 == side->n1) sideBnd->rightSide = s;
 4710:    }
 4711:    
 4712: }
 4713: 
 4714: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 4715:                 double *node_coords, double *node_coords_ll, bool use_ll,
 4716:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 4717:                 int *isdel, int *isidenode, int *isbnd,
 4718:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 4719:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4720:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4721:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4722:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4723:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 4724:                 double *drag, double *roughness,
 4725:                 double *emo, double *efa, 
 4726:                 double *umo, double *ufa, 
 4727:                 double *vmo, double *vfa) {
 4728: 
 4729:    printf("Populating mesh for partition %d\n", partNum);
 4730: 
 4731:    // XXXXXX THIS function does almost nothing. 
 4732: 
 4733:    nbs = *sharedIdxSideBoundary + 1;
 4734:    nbp = *sharedIdxNodeBoundary + 1;
 4735: 
 4736:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 4737: 
 4738: }
