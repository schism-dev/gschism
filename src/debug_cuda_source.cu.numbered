 6349: #ifdef DONTCOMPILE
 6350: __device__ void computeVerticalAdvection(void) {
 6351:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6352: 
 6353:    sdbt(1:2,:,:)=0.d0
 6354: 
 6355:    const Side *side = FROM kernel;
 6356: 
 6357:    if(side->isDry) return;
 6358: 
 6359:    // If side is wet...
 6360: 
 6361: 
 6362:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6363:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6364:    double ws[nvrt] = {} // w @ side
 6365:    int icount = 0;
 6366:    for (int j=0; j<2; j++) {
 6367:       const Element *elem = side->elements[j];
 6368:        
 6369:       if(elem != nullptr) {
 6370:          icount++;
 6371:          for (int k=0; k<nvrt; k++) {
 6372:             ws[k] = ws[k] + elem->w[k];
 6373:          }
 6374:       }
 6375:    }  // for j
 6376: 
 6377:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6378:    ws = ws/icount;
 6379: 
 6380:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6381:    // Splines allow for a smooth transition between vertical levels.
 6382:    // Splines have continuity restrictions at the internal knots, but
 6383:    // we have to provide the 1st derivatives at the endpoints.
 6384:    const int kbs = side->kbs; 
 6385:    
 6386:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6387:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6388:    initCubicSpline(kbs, nvrt, side, ws, up)
 6389: 
 6390:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6391:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6392:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6393: 
 6394:    // Total advection (average onto side)
 6395:    const Node *node1 = side->nodes[0];
 6396:    const Node *node2 = side->nodes[1];
 6397:    for (int k=kbs(i); k<nvrt; k++) {
 6398: 
 6399:       if constexpr(ics==1) {
 6400:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6401:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6402:       } else {
 6403:          // XXX IMPLEMENT THIS
 6404:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6405:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6406:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6407:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6408:       }  // if ics
 6409: 
 6410: 
 6411:    }
 6412: }
 6413: #endif
 6414: 
 6415: 
 6416: extern "C" {
 6417:    __global__ void computeElemAverageGhat(void) {
 6418:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6419: 
 6420:       ELEM(elem);
 6421:       
 6422:       elem->ghat1= {0.0, 0.0};  
 6423: 
 6424:       if constexpr(ihydraulics != 0) {
 6425:          if (nhtblocks > 0 && elem->isblock) return;
 6426:       }
 6427: 
 6428:       if (elem->isDry) return;
 6429: 
 6430:       // Wet elements.
 6431:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6432:       // tidal potential, horizontal diffusion, and baroclinic etc
 6433:       // Remember to update both fb and F 
 6434:       // If ics=2, ghat1 are in eframe (ll)
 6435:       // cff1-3: coefficients for 2D/3D
 6436:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6437:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6438:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6439: 
 6440:       double av_cff1 = 0.0;  // av. for cff1
 6441:       double av_cff2 = 0.0;  // av. for cff2
 6442:       double av_cff3 = 0.0;  // av. for cff3
 6443:       double av_df = 0.0;  // av. for H^\alpha / H
 6444:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6445:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6446: 
 6447:       const int i34 = elem->i34;
 6448:       const int kb = elem->kb;
 6449: 
 6450:       for (int j=0; j<i34; j++) {
 6451:          // For each node and side in the element...
 6452: 
 6453:          const Node *node = elem->nodes[j];
 6454:          const Side *side = elem->sides[j];
 6455: 
 6456:          const double chi      = side->chi;
 6457:          const double veg_c2   = side->veg_c2;
 6458:          const double veg_beta = side->veg_beta;
 6459:          const double veg_h    = side->veg_h();
 6460:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6461: 
 6462:          // Node - const in elem
 6463:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6464:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6465: 
 6466:          if (elem->depth >= tip_dp) {
 6467:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6468:          }
 6469: 
 6470:          
 6471:          const double htot  = side->htot2();        // Total depth at the side
 6472:          const double zctr2 = side->zTopCanopy();  
 6473: 
 6474:          double cff1; 
 6475:          double cff2; 
 6476:          double cff3;   
 6477:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6478:          // coefficients applied to 2D/3D case 
 6479:             cff1 = side->hhat/htot;
 6480:             cff2 = 0.0;
 6481:             cff3 = 0.0;
 6482:          } else { //3D
 6483:             //Init for no-veg case
 6484:             cff1 = 1.0;
 6485:             cff2 = 1.0;
 6486:             cff3 = 0.0;
 6487: 
 6488:             if constexpr(iveg != 0) {
 6489:                // Computes coefficients used with vegetation terms G1, G2
 6490:                // cff1, cff3 are used for the first two terms in G1, G2:
 6491:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6492:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6493:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6494:                if(veg_h < 0.99*htot) { // submergent vegetation
 6495:                   cff1=1;
 6496:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6497:                   cff3 = veg_c;
 6498: 
 6499:                } else { // emergent vegetation
 6500:                   cff1 = 1.0/(1.0 + veg_c2);
 6501:                   cff2 = cff1;
 6502:                   cff3 = 0.0;
 6503: 
 6504:                }
 6505:             } // if iveg
 6506:          } //  2D/3D
 6507: 
 6508:          av_cff1 += cff1/i34;
 6509:          av_cff2 += cff2/i34;
 6510:          av_cff3 += cff3/i34;
 6511:          av_cff2_chi += cff2*chi/i34;
 6512:          av_cff3_chi += cff3*chi/i34;
 6513:          av_df += min(htot, veg_h)/(htot*i34);
 6514: 
 6515: 
 6516:          // btrack values: U^\star, U^{\star\alpha}
 6517:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6518:          Vector2 Ustar       = {0.0, 0.0}; 
 6519:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6520: 
 6521:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6522:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6523:          } else { //3D
 6524:             for (int k = side->kb; k < nvrt; k++) {
 6525:             
 6526:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6527:                Ustar += w2;
 6528: 
 6529:                if constexpr(iveg != 0) {
 6530:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6531:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6532:                        Ustar_alpha += zrat*w2; // XXXX
 6533:                    }
 6534:                }  // if iveg
 6535:             }  // for k
 6536:          }  //2D/3D
 6537:          
 6538: 
 6539:          // Add btrack & surface stress terms to \breve{G} first
 6540:          if constexpr(ics==1) {
 6541: 
 6542:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6543: 
 6544:          } else {
 6545:             // XXX IMPLEMENT THIS
 6546:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6547:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6548:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6549:          }  // if ics
 6550: 
 6551:          // Surface and bottom stress terms
 6552:          if constexpr(ics==1) {
 6553:             const Vector2 tau    = side->tau();
 6554:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6555: 
 6556:             // Term for surface and bottom stress
 6557:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6558: 
 6559:          } else {
 6560:             assert(false && "computeElemAverageGhat: Not implemented");
 6561:             // XXX IMPLEMENT THIS
 6562:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6563:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6564:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6565:             // tau_x=(vn1+tt1)/2.d0
 6566:             // tau_y=(vn2+ss1)/2.d0
 6567:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6568:          }  // if ics
 6569: 
 6570:          
 6571: 
 6572:          // All terms in F,F^\alpha,f_b except baroclinic
 6573:          // F, f_b: all explicit terms excluding vegetation 
 6574:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6575:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6576:          const double coriolis = side->coriolis;
 6577:          Vector2 F  =  coriolis*side->U;  // F_x
 6578:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6579:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6580: 
 6581:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6582:             
 6583:             for (int k = side->kb; k < nvrt; k++) {
 6584:                if (zctr2 > side->zc[k-1]) {
 6585:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6586:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6587:                    Fa +=  coriolis*w2*zrat;
 6588:                } // if zctr2
 6589:             } // k
 6590:          } // iveg
 6591: 
 6592:          // Integrate horizontal viscosity force vertically
 6593:          for (int k=side->kb + 1; k<nvrt; k++) {
 6594:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6595: 
 6596:             F += levelHorVisc;
 6597: 
 6598:             // Vegetation term
 6599:             if constexpr(iveg!=0) {
 6600:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6601:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6602:                   Fa += levelHorVisc*zrat;
 6603:                } 
 6604:             } // if iveg
 6605:          } // for k
 6606: 
 6607:          fb += side->nuGradU[side->kb];
 6608: 
 6609:          // Add to ghat1
 6610:          if constexpr(ics==2) {
 6611:             // XXX IMPLEMENT THIS
 6612:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6613:             // bigf1=vn1; bigf2=vn2
 6614:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6615:             // botf1=vn1; botf2=vn2
 6616:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6617:             // bigfa1=vn1; bigfa2=vn2
 6618:          } // if ics
 6619: 
 6620:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6621:       } // for j (nodes and sides)
 6622: 
 6623:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6624:          
 6625:       // Finish off terms in F, F^\alpha and f_b
 6626:       const double grav3 = elem->mean(&Node::grav2);
 6627:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6628: 
 6629: 
 6630:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6631:       for (int j=1; j<i34; j++) { 
 6632:          // For each side in the element...
 6633:          const Side *side = elem->sides[j];
 6634:          const double chi = side->chi;
 6635: 
 6636:          const double htot = side->htot2();
 6637:          const double veg_h = side->veg_h();
 6638:          const Vector2 F  = htot*fb;
 6639:          const Vector2 Fa = min(htot, veg_h)*fb;
 6640: 
 6641:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6642:       } // for j
 6643: 
 6644:       //botf1 etc are already in elem frame
 6645:       elem->ghat1 += tmp/i34;
 6646: 
 6647:       // Baroclinic force
 6648:       if constexpr(ibc==0) {
 6649:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6650: 
 6651:          Vector2 Fa = {0.0, 0.0};
 6652:          Vector2 intGradRho = {0.0, 0.0};
 6653:          
 6654:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6655:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6656:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6657: 
 6658:             // \in F [m^2/s/s]
 6659:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6660:          }
 6661: 
 6662:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6663:          const Vector2 F = av_df*Fa; //approx
 6664:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6665: 
 6666:       } // if ibc
 6667: 
 6668: 
 6669: 
 6670:    }
 6671: 
 6672: } // extern "C"
 6673: 
 6674: 
 6675: 
 6676: #ifdef DONTCOMPILE
 6677: __global__ void checkMassConservation(Tracers* sumtr) {
 6678: 
 6679:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6680: 
 6681:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6682: 
 6683:    Element *elem = &(mesh->localElemData[i]);
 6684: 
 6685:    // Skip dry elements
 6686:    if (elem->isDry) return;
 6687: 
 6688:    // Local sum array for this thread
 6689:    double localSum[N_TRACERS] = {0.0};
 6690: 
 6691:    // Sum over vertical levels for this element
 6692:    const int kbe = elem->kbe;
 6693:    const double area = elem->area;
 6694: 
 6695:    for (int k = kbe; k < nvrt; k++) {
 6696:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6697:       
 6698:       // Accumulate tracer mass
 6699:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6700:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6701:       }
 6702:    }
 6703: 
 6704:    
 6705: 
 6706:    //  This function returns per element sums. A reduction must be done on the host side.
 6707: }
 6708: 
 6709: 
 6710: __global__ void transport(void) {
 6711: 
 6712:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6713: 
 6714:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6715: 
 6716:    Element *elem = &(mesh->localElemData[ie]);
 6717: 
 6718:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6719: 
 6720:                for (int m=0; m<ntr; m++) {
 6721:                   for (int k=kbe(ie); k<nvrt; k++) {
 6722:                      // Calculate each polynomial's weight 
 6723:                      wm=0.d0; sum1=0.d0; 
 6724:                      wm1=0.d0; wm2=0.d0; 
 6725:                      for (int i=0; i<elem->nweno2; i++) {
 6726:                   
 6727:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6728:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6729:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6730:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6731:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6732:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6733:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6734:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6735:                      // -----------------Hu and Shu (1999)'s method----------------
 6736:                      b4=b1+b2+b3
 6737: 
 6738: //Error: add PRODUCTION CPP
 6739: #ifdef DEBUG
 6740:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6741:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6742:                     call parallel_abort(errmsg)
 6743:                   }
 6744: #endif
 6745: 
 6746:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6747:                   // !----test-------------- 
 6748:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6749:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6750:                   // !wm(i)=wm1(i)*wm2(i)
 6751:                   // !---------------------- 
 6752:                   sum1=sum1+wm(i)
 6753:                 } // end for i
 6754: 
 6755:                 wm=wm/sum1
 6756: 
 6757:                 for (int j=0; j<elem->i34; j++) {
 6758: 
 6759:                   const Side *side  = elem->sides[j];
 6760:                   const Node *node1 = side->n1;
 6761:                   const Node *node2 = side->n2;
 6762: 
 6763:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6764:                      trsd=0.d0
 6765:                      for (int kk=0; kk<nquad; kk++) {
 6766:                         for (int i=0; i<elem->nweno2; i++) {
 6767:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6768:                         } // end for i   
 6769:                      } // end for kk
 6770:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6771:                   } // outward flux
 6772:                } // end for j=1,i34(ie) ! side
 6773:             }
 6774:          }
 6775:               
 6776: 
 6777: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6778: //             //   calculate each polynomial's weight 
 6779: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6780: //                 wm=0.d0; sum1=0.d0
 6781: //                 do i=1,nweno1(ie) !for each polynomial
 6782: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6783: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6784: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6785: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6786: //                   wm(i)=b2
 6787: //                   sum1=sum1+b2
 6788: //                   !wm(i)=1.d0
 6789: //                   !sum1=sum1+1.d0
 6790: 
 6791: // // Error: PRODUCTION
 6792: // #ifdef DEBUG
 6793: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6794: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6795: //                     call parallel_abort(errmsg)
 6796: //                   endif
 6797: // #endif
 6798: 
 6799: //                 enddo !i
 6800: //                 wm=wm/sum1 !final weight
 6801: 
 6802:                 for (int j=0; j<elem->i34; j++) { // side
 6803:                   const Side *side = elem->sides[j];
 6804:                   const Node *node1 = side->n1;
 6805:                   const Node *node2 = side->n2;
 6806: 
 6807:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6808:                     trsd=0.d0
 6809:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6810:                       for (int i=0; i<elem->nweno1; i++) {
 6811:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6812:                       }
 6813:                     enddo //kk
 6814:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6815:                   } // outward flux
 6816:                 } // end for j=1,i34(ie) ! side
 6817:               } // end for k; ntr 
 6818: 
 6819:             else !simple upwind method
 6820:               do j=1,i34(ie)
 6821:                 jsj=elside(j,ie)
 6822:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6823:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6824:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6825:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6826:                   endif
 6827:                 enddo  !vertical layers
 6828:               enddo !j=1,i34(ie) ! side
 6829:             endif !order of accuracy
 6830: 
 6831:          //  enddo !ie
 6832: // !$OMP     end do
 6833: 
 6834: // !$OMP     master
 6835: //           !message passing
 6836: //           if (nproc>1) then
 6837: //             !make a copy of side concentrations
 6838: //             trsd_tmp0=trsd_tmp 
