 2444: 
 2445: __inline__ __device__ Point2 Element::outputCoords(void) const {
 2446:    if constexpr(ics == 1)  {
 2447:       return center;
 2448: 
 2449:    } else {
 2450:       const Point2 p0 = nodes[0]->outputCoords();
 2451:       const Point2 p1 = nodes[1]->outputCoords();
 2452:       const Point2 p2 = nodes[2]->outputCoords();
 2453: 
 2454:       if (isTri()) {
 2455:          return (1.0/3.0)*(p0 + p1 + p2);
 2456: 
 2457:       } else {
 2458:          const Point2 p3 = nodes[3]->outputCoords();
 2459:          return (1.0/4.0)*(p0 + p1 + p2 + p3);
 2460:       }
 2461: 
 2462:    }
 2463: }
 2464: 
 2465: 
 2466: __device__ __forceinline__ double Element::centerZ(void) const { 
 2467: // Z coordinate of the element center in the global cartesian coordinates.
 2468: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 2469: 
 2470:    if constexpr(ics==1) { 
 2471:       return 0.0; 
 2472: 
 2473:    } else { 
 2474: 
 2475:       if (isTri())  return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz);
 2476:       else          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz);
 2477:    } 
 2478: }
