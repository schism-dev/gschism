 3569:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3570: 
 3571:       NODE_BND(nodeBnd);
 3572: 
 3573:       Node *node = nodeBnd->node;
 3574: 
 3575:       node->ETP = 0.0;
 3576: 
 3577:       for (int j=0; j<ntip; j++) {
 3578: 
 3579:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3580:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3581:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3582: 
 3583:          if constexpr(iloadtide==1) { // loading tide
 3584:             assert(false && "Loading tide not implemented");
 3585:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3586:          }
 3587:          
 3588:       }
 3589:       
 3590:    }
