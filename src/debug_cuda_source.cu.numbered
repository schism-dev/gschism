 5693: 
 5694:    __global__ void backtrackAllNodes(void) {
 5695: 
 5696:       // max/min # of sub-divisions
 5697:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 5698:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 5699: 
 5700:       SIDE(side);
 5701: 
 5702:       const int kb = side->kb;
 5703: 
 5704: 
 5705:       // Initialize btrack velocities to the actual velocities at the side 
 5706:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 5707:   
 5708:       if (side->isDry) return;
 5709:      
 5710: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 5711: 
 5712:       // Checks that at least one element is not dry
 5713:       const Element *elem1 = side->elems[0];
 5714:       const Element *elem2 = side->elems[1];
 5715: 
 5716: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 5717: 
 5718:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 5719:       
 5720:       // XXXXXX
 5721:       // !swild_tmp to store global coord. of the starting side
 5722:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 5723:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 5724:       // !Use sframe2 
 5725:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 5726: 
 5727: 
 5728:       for (int k = kb; k < nvrt; k++) {
 5729:       //  For ics=2, the coordinates are all in the side's local frame
 5730: 
 5731:          const int iadvf = side->iadv();  // Advection flag   
 5732:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 5733: 
 5734:          const double vmag2 = norm2(side->u2[k]);
 5735: 
 5736:          if (vmag2 <= velmin_btrack_sq) {  
 5737:             // No activity 
 5738: 
 5739:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 5740:             
 5741:          } else {  // do btrack
 5742: 
 5743:             // Compute number of sub-divisions based on local gradients of the velocity field
 5744: 
 5745:             // XXX IS THIS NECESSARY?
 5746:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 5747:             double suma = 0.0;
 5748:             int icount = 0;
 5749:             #pragma unroll
 5750:             for (int l=0; l<2; l++) {
 5751:             // For each element sharing the side...
 5752: 
 5753:                const Element *elem = side->elems[l];
 5754:                  
 5755:                if (elem == nullptr) continue;
 5756: 
 5757:                icount++;
 5758: 
 5759:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 5760:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 5761:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 5762: 
 5763:                double utmp[4];
 5764:                double vtmp[4];
 5765:                #pragma unroll
 5766:                for (int j = 0; j < elem->i34; j++) {
 5767: 
 5768:                   const Node *node = elem->nodes[j];
 5769: 
 5770:                   if constexpr(ics==1) {
 5771:                      utmp[j] = node->u2[k].x;
 5772:                      vtmp[j] = node->u2[k].y;  
 5773: 
 5774:                   } else {
 5775:                      // 'Project' the velocity from the node frame to the element frame
 5776:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 5777:                      utmp[j] = tmp_u2.x;
 5778:                      vtmp[j] = tmp_u2.y;
 5779: 
 5780:                   }
 5781:                } // for j
 5782: 
 5783:                const Vector2 grad_u = elem->grad2(utmp); 
 5784:                const Vector2 grad_v = elem->grad2(vtmp);
 5785:    
 5786:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 5787:             } // for l
 5788: 
 5789:             assert(icount > 0 && "Impossible 77");
 5790: 
 5791:             // '4' is somewhat arbitrary
 5792:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 5793: 
 5794:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 5795:             Vector3 u_int = {0.0, 0.0, 0.0};
 5796: 
 5797:             side->btrack(k, dt, dtbk, u_int);
 5798: 
 5799: 
 5800:             side->btu[k] = {u_int.x, u_int.y};
 5801:                
 5802:          } // if vmag (do backtrack)
 5803: 
 5804: 
 5805:       } // for k=kb,nvrt-1
 5806: 
 5807:    }
 5808: 
 5809: } // extern "C"
 5810: 
 5811: template<int nc>
 5812: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 5813: 
 5814: // Solves a tridiagonal system. Adapted from Numerical Recipes in FORTRAN (pp.43).
 5815: //
 5816: // Although this is a general function, it is used only for equations on vertical levels.
 5817: // nc is the number of components in each unknown: 1 for a scalar, 2 for Vector2.
 5818: // It is not really for nc independent RHS vectors. We only use it for scalar and Vector2.
 5819: // Vector2 is stored as adjacent (x, y), so index of level j, component l is j*nc + l.
 5820: //
 5821: // a, b, c, rhs: inputs, not modified. gam: work array of length n.
 5822: // a, b, c are the three diagonals (b = main). a[0] and c[n-1] are unused.
 5823: // n: rank of the system (number of vertical levels in the 3D momentum solve).
 5824: // rhs, u: length n*nc, packed C order (n levels, nc components per level).
 5825: 
 5826:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 5827:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 5828: 
 5829:    double bet = b[0];
 5830:    if constexpr (nc == 1) {
 5831:       u[0] = rhs[0]/bet;
 5832:    } else {
 5833:       #pragma unroll
 5834:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 5835:    }
 5836: 
 5837:    for (int j = 1; j < n; j++) {
 5838:       gam[j] = c[j - 1]/bet;
 5839:       bet = b[j] - a[j]*gam[j];
 5840: 
 5841:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 5842: 
 5843:       if constexpr (nc == 1) {
 5844:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 5845:       } else {
 5846:          #pragma unroll
 5847:          for (int l = 0; l < nc; l++) {
 5848:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 5849:          }
 5850:       }
 5851:    }
 5852: 
 5853:    // Back-substitution
 5854:    for (int j = n - 2; j >= 0; j--) {
 5855:       if constexpr (nc == 1) {
 5856:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 5857:       } else {
 5858:          for (int l = 0; l < nc; l++) {
 5859:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 5860:          }
 5861:       }
 5862:    }
 5863: }
 5864: 
 5865: 
 5866: 
 5867: // Helper function that contains the core algorithm
 5868: template<typename XAccessor, typename YAccessor>
 5869: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 5870:                                     double  yp_top, double  yp_bot, 
 5871:                                     CubicSpline &spline) {
 5872:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 5873:    // 
 5874:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 5875:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 5876:    //
 5877:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 5878:    // 
 5879:    // Inputs: 
 5880:    //            n: dimension for x etc; # of data pts (>=2);
 5881:    //            getX, getY: functions to access x,y coordinates
 5882:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 5883:    //     Output: 
 5884:    //            spline (CubicSpline): spline structure with x,y,y',y''
 5885: 
 5886:    const int n = k2 - k1 + 1;
 5887:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 5888: 
 5889:    // Allocate memory for the splines
 5890:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 5891:    spline.x   = new double[n];
 5892:    spline.y   = new double[n];
 5893:    spline.yp  = new double[n];
 5894:    spline.ypp = new double[n];
 5895: 
 5896:    for (int k=k1; k<=k2; k++) {
 5897:       spline.x[k] = getX(k);
 5898:       spline.y[k] = getY(k);
 5899:    }
 5900: 
 5901:    // This is to simplify expressions later
 5902:    double *x = spline.x;
 5903:    double *y = spline.y;
 5904: 
 5905:    double *a = nullptr;
 5906:    double *b = nullptr;
 5907:    double *c = nullptr;
 5908:    double *gam = nullptr;
 5909:    double *rhs = nullptr;
 5910:    
 5911: 
 5912:       a = new double[n];   // Lower diagonal
 5913:       b = new double[n];   // Diagonal
 5914:       c = new double[n];   // Upper diagonal
 5915:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 5916:       rhs = new double[n]; // Right-hand side
 5917: 
 5918:    for (int k=k1; k<=k2; k++) {
 5919:       if (k == k1) {
 5920:          // Bottom level
 5921:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 5922:          b[k] = (x[k+1] - x[k])/3.0;
 5923:          c[k] = b[k]/2.0;
 5924:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 5925:       } else if (k == n - 1) {
 5926:          // Top level (surface)
 5927:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 5928:          b[k] = (x[k] - x[k-1])/3.0;
 5929:          a[k] = b[k]/2.0;
 5930:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 5931:       } else {
 5932:          // Intermediate levels
 5933:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 5934:          b[k] = (x[k+1] - x[k-1])/3.0;
 5935:          a[k] = (x[k  ] - x[k-1])/6.0;
 5936:          c[k] = (x[k+1] - x[k  ])/6.0;
 5937:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 5938:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 5939:       }
 5940:    }
 5941: 
 5942:    // Solve the tridiagonal system
 5943:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 5944:    
 5945:    spline.yp[k1] = yp_bot;
 5946:    spline.yp[k2] = yp_top;
 5947: 
 5948:    // Compute rest of 1st derivatives using the splines
 5949:    for (int k=k1+1; k<k2; k++) {
 5950:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 5951:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 5952:    }
 5953:    
 5954:    delete[] a;
 5955:    delete[] b;
 5956:    delete[] c;
 5957:    delete[] gam;
 5958:    delete[] rhs;
 5959: 
 5960: }
 5961: 
 5962: // Array version
 5963: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 5964:                                 double y_top, double y_bot, 
 5965:                                 CubicSpline &spline) {
 5966:    auto getX = [x] (int k) { return x[k]; };
 5967:    auto getY = [y] (int k) { return y[k]; };
 5968:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5969: }
 5970: 
 5971: // Lambda version - allows custom access patterns
 5972: template<typename XFunc, typename YFunc>
 5973: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 5974:                                 double y_top, double y_bot,
 5975:                                 CubicSpline &spline) {
 5976:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5977: }
