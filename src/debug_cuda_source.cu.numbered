 1581: // This struct is used to store the boundary information for a node.
 1582: struct NodeBoundary {   
 1583:    int idx;
 1584:    BoundarySegment *segment;
 1585:    Node *node;
 1586:    
 1587:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1588:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1589: 
 1590:    bool isLand;
 1591: 
 1592:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1593:    double elbc;   // Elevation boundary condition
 1594:    double eth;    // Elevation time history
 1595: 
 1596:    double eta_mean; // Mean elevation at nodes
 1597: 
 1598:    bool isEssentialBC;
 1599: 
 1600:    Vector2 uth[nvrt];  // "Time history" velocity
 1601: 
 1602:    // Arrays for harmonic constituents (if needed)
 1603:    double  emo[nbfr];  // Elevation amplitude
 1604:    double  efa[nbfr];  // Elevation phase
 1605:    Vector2 umo[nbfr];  // velocity amplitude
 1606:    Vector2 ufa[nbfr];  // velocity phase
 1607: 
 1608: 
 1609:    NodeBoundary(void) {
 1610:       isLand = false;
 1611:    }
 1612:    NodeBoundary(bool _isLand) {
 1613:       isLand = _isLand;
 1614:    }
 1615: 
 1616:    
 1617:    __forceinline__ __device__ int numSidesForAverage() const {
 1618:    // Returns the number of sides that are connected to the node and have the same segment.
 1619:    // This is used to compute the average velocity at the node for open boundary nodes.
 1620:       int res = 0;
 1621:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1622:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1623: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1624:       return res;
 1625:    }
 1626: 
 1627: 
 1628:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1629:       assert(index == 0 || index == 1); 
 1630:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1631:    }
 1632: 
 1633:    __forceinline__ __device__ void linkSideBoundary(SideBoundary *sb) {
 1634:       if (isLand) return;  // land never uses these links
 1635: 
 1636:       SideBoundary *nullSideBoundary = nullptr;
 1637:       uintptr_t null = (uintptr_t)nullSideBoundary;
 1638: 
 1639:       if (atomicCAS((uintptr_t *)&sideBnd1, null, (uintptr_t)sb) == null) return;
 1640:       if (atomicCAS((uintptr_t *)&sideBnd2, null, (uintptr_t)sb) == null) return;
 1641: 
 1642:       // both slots taken. OK if this side was already linked
 1643:       assert(sideBnd1 == sb || sideBnd2 == sb);
 1644:    }
 1645: 
 1646: 
 1647: };
 1648: 
 1649: struct Node {
 1650: 
 1651:    // Geometry information
 1652:    int idx;            // Global index of the node
 1653:    int16_t part;       // Partition of the node
 1654: 
 1655:    Node **nodes;       // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1656:    int16_t numNodes;   // Number of nodes neighbors of this node
 1657: 
 1658:    Element **elements; // Array of pointers to the elements that share this node
 1659:    int16_t numElements;// Number of elements that share this node
 1660: 
 1661:    int16_t numSides;   // Number of sides that are connected to this node
 1662: 
 1663: 
 1664:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1665:    double gz;          // Global vertical coordinate at the node.
 1666:    Vector2 u2[nvrt];
 1667:    double  w2[nvrt];
 1668:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1669:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1670:    double lon, lat;
 1671:    double depth;
 1672: 
 1673:    Frame<ics> frame;
 1674: 
 1675:    LocalSigma<ivcor> localSigma;  
 1676: 
 1677:    int16_t kb;     // Bottom index of the node
 1678: 
 1679:    bool isDry;     // True if the node is dry
 1680: 
 1681:    int16_t iadv;   // Advection flag
 1682: 
 1683:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1684:                           // this is nullptr
 1685: 
 1686:    TempVar tmp; // Temporary variable to store different types of variables
 1687: 
 1688:    // Physical information
 1689:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1690:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1691: 
 1692:    double rho[nvrt];     // Density
 1693:    double dfv[nvrt];     // Vertical viscosity
 1694:    double dfh[nvrt];     // Horizontal viscosity  XXXX (does it need to exist when transport is not enabled?)
 1695: 
 1696:    Turbulence<turbulenceModel> turb;
 1697: 
 1698:    double eta1; // Elevation at nodes at previous timestep
 1699:    double eta2; // Elevation at nodes at current timestep
 1700: 
 1701:    double ETP;  // Earth Tidal Potential
 1702: 
 1703:    double pr;    // Air pressure
 1704:    double grav2; // Gravity 
 1705:    
 1706:    Vector2 dav;  // Depth averaged velocity
 1707: 
 1708:    Vector2 tau; // Wind stress vector
 1709: 
 1710:    // Vegetation parameters
 1711:    double veg_h;
 1712:    double veg_nv;
 1713:    double veg_di;
 1714:    double veg_Cd;
 1715:    double veg_h_unbent;
 1716:    double veg_di_unbent;
 1717:    double veg_nv_unbent;
 1718:    double veg_alpha_vert_mean;
 1719:    double veg_alpha0;
 1720:    double veg_alpha3D[nvrt];
 1721: 
 1722:    // Bottom drag parameters
 1723:    double Cd;       // Bottom drag coefficient   
 1724: 
 1725:    // These three are mutually exclusive
 1726:    union {
 1727:       double rmanning; // Bottom Manning's coefficient
 1728:       double rough;    // Bottom roughness length
 1729:       double drag;     // Bottom drag coefficient
 1730:    };
 1731:    Vector2 tau_bot; // Bottom stress vector
 1732: 
 1733:    // XXXX REMOVE FOR IMM>0???
 1734:    double bdef1 = 0.0; // Bottom deformation at previous timestep
 1735:    double bdef2 = 0.0; // Bottom deformation at current timestep
 1736: 
 1737:    
 1738:    double qel; // RHS
 1739:    double *coeffDiag;    // Pointer to the diagonal coefficient of the matrix
 1740:    double *coeffRow;     // Pointer to the coefficients of the row of the CRS matrix for this node.
 1741:    int16_t *csrSlot;     // csrSlot[i], is the slot/index of nodes[i] entry the CRS matrix row for this node.
 1742:                          // The index of the diagonal element is coeffDiag - coeffRow.   
 1743: 
 1744:    double mX; // Solution of the FEM system
 1745: 
 1746:    // Meteorological forcing
 1747:    Vector2 u_air;
 1748:    double p_air;  // XXXX is this the same as pr?
 1749:    double t_air;
 1750:    double q_air;
 1751:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1752: 
 1753: 
 1754: 
 1755:    __device__ __forceinline__ int localIndex() const;
 1756:    __device__ __forceinline__ int packedIndex() const;
 1757: 
 1758: 
 1759:    __device__ void setWind(Vector2 &u) {
 1760:    // Sets the wind vector taking into account the mesh angle
 1761:    
 1762:       const double speed = length(u);
 1763: 
 1764:       // Rotate wind vector to the node frame
 1765:       u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1766: 
 1767:       // Sets the surface stress vector due to wind.
 1768:       if constexpr(nws == 0) {
 1769:          tau = {0.0, 0.0};
 1770: 
 1771:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1772:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1773: 
 1774:       } else {
 1775: 
 1776:          double dragcoef;
 1777: 
 1778:          if constexpr(iwind_form == -1) {
 1779:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1780:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1781: 
 1782:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1783:             tau = cff*u_air;
 1784:  
 1785:          } else if constexpr(iwind_form == 1) {
 1786:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1787:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1788: 
 1789:             dragcoef = max(dragcoef, 4.0e-4);
 1790:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1791:             tau = cff*u_air;
 1792: 
 1793:          } else {
 1794:             tau = {0.0, 0.0};
 1795:          }
 1796:       }
 1797:    }
 1798: 
 1799: 
 1800:    __device__ void setFrame(double lat, double lon) {
 1801:       if constexpr(ics == 1) return;
 1802: 
 1803:       frame.update(lat, lon);        
 1804:     }
 1805: 
 1806:    //__device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1807: 
 1808:    __device__ double sigmaTransitionDepth(void) const;
 1809: 
 1810:    __device__ double computeETP(int idxTidalPotential, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const;
 1811: 
 1812:    __inline__ __device__ Point2 outputCoords(void) const {
 1813:       if constexpr(ics == 1)  return p;
 1814:       else                    return {rad2deg*lon, rad2deg*lat};
 1815:    }
 1816: 
 1817:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1818:    // If ics == 2, convert the global point to the local frame
 1819:       
 1820:       if constexpr (ics == 1) {
 1821:          return p;
 1822:       } else {
 1823:          const Point3 c = {p.x, p.y, gz};
 1824:          const Point3 local = frame.G2L(p - c);
 1825:          return local;
 1826:       }
 1827:    }
 1828: 
 1829:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1830:    // If ics == 2, convert the global point to the local frame
 1831:       
 1832:       if constexpr (ics == 1) {
 1833:          return p;
 1834:       } else {
 1835:          const Point3 c = {p.x, p.y, gz};
 1836:          return c + frame.L2G(p);
 1837:       }
 1838:    }
 1839: 
 1840:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1841:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1842:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1843:    
 1844:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1845: 
 1846:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1847:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1848:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }   
 1849: 
 1850:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1851:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1852: 
 1853:    __device__ __forceinline__ void clearMatrixRow(void) {
 1854:       // Clear the matrix row for this node
 1855: 
 1856:       for (int i = 0; i <= numNodes; i++) coeffRow[i] = 0.0;
 1857: 
 1858:    }
 1859: 
 1860:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1861:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1862:       
 1863:       if (node == this) {
 1864:          *coeffDiag += value;
 1865:          return;
 1866:       }
 1867: 
 1868:       int i;
 1869:       for (i = 0; i < numNodes; i++) {
 1870:          if (nodes[i] == node) break;
 1871:       }
 1872: 
 1873:       assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1874:       coeffRow[csrSlot[i]] += value;
 1875:    }
 1876: 
 1877: 
 1878:    __device__ __inline__ void updateZCoordData(void);
 1879: 
 1880:    __device__ __forceinline__ double compZCoord(int k) const;
 1881: 
 1882:    __device__ void updateKb(void);
 1883: 
 1884:    __device__ __forceinline__ void computeBottomDragCd(void);
 1885: 
 1886: 
 1887: 
 1888: };
