 2547: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2548: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2549: __inline__ __device__ double  Side::lon(void) const { return 0.5*(n1->lon + n2->lon); }
 2550: __inline__ __device__ double  Side::lat(void) const { return 0.5*(n1->lat + n2->lat); }
 2551: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2552: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2553:    Vector2 grad = {0.0, 0.0};
 2554:    int count = 0;
 2555: 
 2556:    if constexpr(ics == 2) assert(false && "grad2: ics = 2 not implemented");
 2557: 
 2558:    // First element
 2559:    if (elems[0] != nullptr && condition(elems[0])) {
 2560:       grad += elems[0]->grad2(field);
 2561:       count++;
 2562:    }
 2563: 
 2564:    // Second element
 2565:    if (elems[1] != nullptr && condition(elems[1])) {
 2566:       grad += elems[1]->grad2(field);
 2567:       count++;
 2568:    }
 2569: 
 2570:    if (count > 0) {
 2571:       grad = grad/count;
 2572:    }
 2573:    
 2574:    return grad;
 2575: }
