  454: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  455:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  456:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  457: }
  458: 
  459: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  460:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  461:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  462: }
