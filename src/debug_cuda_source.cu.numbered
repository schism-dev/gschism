 7196: __global__ void returnMatrix(double *res) {
 7197:    // Debugging: returns the matrix as a CuPy array
 7198: 
 7199:    const int size = mesh->np;
 7200:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7201:       const Node *node = mesh->localNodeData + idx_node;
 7202:       res[idx_node*size + idx_node] = node->coeffDiag;
 7203:       for (int j = 0; j < node->numNodes; j++) {
 7204:          Node* nbNode = node->nodes[j];
 7205:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7206:       }
 7207: 
 7208:    }
 7209:    
 7210: }
