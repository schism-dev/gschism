 4697:    __global__ void computeFlowBcVelocities(double time) {
 4698: 
 4699:       SIDE_BND(sideBnd);
 4700: 
 4701:       const Side *side = sideBnd->side;
 4702:  
 4703:       const bool isDry = side->isDry;
 4704:       const bool isLand = sideBnd->segment->isLand;
 4705: 
 4706:    
 4707:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4708: 
 4709:       if (isDry || isLand) return;
 4710: 
 4711:       // For wet sides in open boundaries...
 4712:       const Vector2 n = side->n;
 4713:       const BoundarySegment *segment = sideBnd->segment;
 4714: 
 4715:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4716: 
 4717:       const int ifltype = segment->ifltype;
 4718: 
 4719:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4720:       const Vector2 r_nuth0 = r_uth0*n;
 4721: 
 4722: 
 4723:       if (ifltype == 1 || ifltype == 2) {
 4724:       
 4725:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4726: 
 4727:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4728:          
 4729:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4730:          
 4731:       } else if (ifltype == -1) { // Flather 1
 4732: 
 4733:          for (int k = 0; k < nvrt; k++) {
 4734: 
 4735:             // uth is the normal vel.; no ramp up
 4736:             const double uth = sideBnd->nuth(k);
 4737:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4738: 
 4739:             sideBnd->ubc[k] += uth*n;
 4740:          }
 4741: 
 4742:       } else if (ifltype == 3 || ifltype == 5) {
 4743:          // vnth0=0 !normal vel.
 4744: 
 4745:          Vector2 r_u1_bar = {0.0, 0.0};
 4746:          // Computes the contribution to the velocity from all tide frequencies
 4747:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4748: 
 4749:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4750:             const Vector2 umo  = sideBnd->umo(jfr); 
 4751: 
 4752:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4753:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4754:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4755:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4756:          }
 4757: 
 4758: 
 4759:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4760: 
 4761:       } // if (ifltype = 3 || ifltype == 5
 4762: 
 4763: 
 4764: 
 4765:    }
 4766: 
 4767:    __global__ void computeElevationBoundaryConditions(double time) {
 4768:       // Compute elevation essential boundary conditions 
 4769: 
 4770:       NODE_BND(nodeBnd); // Each boundary node.
 4771: 
 4772:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4773: 
 4774:       const Node *node = nodeBnd->node;
 4775:       const BoundarySegment *segment = nodeBnd->segment;
 4776:       const int iettype = segment->iettype;
 4777:       
 4778: 
 4779:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4780:       double eic = 0.0;
 4781:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4782:       else                 eic = 0.0;
 4783: 
 4784:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4785:       const double r_eth = ramp*nodeBnd->eth;
 4786:       double r_eta1_bar = 0.0;
 4787: 
 4788: 
 4789:       // Compute tide elevation
 4790:       if (iettype == 3 || iettype == 5) {   
 4791: 
 4792:          if constexpr(iloadtide==1) { // loading tide
 4793:             assert(false && "Loading tide not implemented");
 4794:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4795:          }
 4796:          
 4797:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4798: 
 4799:             const double efa  = nodeBnd->efa[jfr]; 
 4800:             const double emo  = nodeBnd->emo[jfr]; 
 4801: 
 4802:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4803:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4804:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4805: 
 4806:          } // for jfr
 4807: 
 4808:       } // if iettype
 4809: 
 4810:       switch (iettype) {
 4811:          case 1:
 4812:          case 2:
 4813:          case 4:
 4814:             nodeBnd->elbc = r_eic + r_eth;
 4815:             break;
 4816:          case 3:
 4817:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4818:             break;
 4819:          case 5:
 4820:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4821:             break;
 4822:       } // switch
 4823: 
 4824: 
 4825:       //Add inverse barometric effects
 4826:       if (iettype != 0 && inv_atm_bnd == 1) {
 4827:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4828:       }
 4829: 
 4830:    }
 4831: 
 4832: 
 4833:    __global__ void computeHorizontalViscosity(void) { 
 4834: 
 4835:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4836: 
 4837:       SIDE(side);
 4838: 
 4839:       if (side->isDry) return;
 4840: 
 4841:       for (int k = 0; k < nvrt; k++) {
 4842:          side->nuGradU[k] = {0.0, 0.0};
 4843:       }
 4844: 
 4845:       if constexpr(ihorcon == 1) {
 4846:          for (int k = side->kb; k < nvrt - 1; k++) {
 4847:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4848:             // SELFE: A semi-implicit Eulerian–Lagrangian finite-element model for cross-scale ocean circulation
 4849:             // By Zhang and Baptista.
 4850: 
 4851:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4852:             // This is a standard discretization of the Laplacian operator.
 4853:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4854:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4855:             // Gamma is hvis_coef0 in the code.
 4856:             // The value of gamma needs to be < 0.5.
 4857: 
 4858:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4859:             // side under consideration in each of the two possible elements that share the side.
 4860:             Vector2 sumU = {0.0, 0.0};
 4861:             for (int l = 0; l < 2; l++) {
 4862:                const Element *elem = side->elems[l];
 4863: 
 4864:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4865: 
 4866:                // Find the local index of the side in the element
 4867:                const int idxSide = elem->sideLocalIdx(side);
 4868:                // Find the two sides that are connected to the side under consideration
 4869:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4870:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4871: 
 4872:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4873: 
 4874:             }
 4875: 
 4876:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4877:    
 4878:          }
 4879:       }
 4880:       else if constexpr(ihorcon == 2) {
 4881:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4882:       }
 4883: 
 4884: 
 4885:    }
 4886: 
 4887: 
 4888:    __global__ void setEssentialBC(void) {
 4889:       // Set essential boundary conditions 
 4890:       NODE(node); // Each boundary node
 4891:       NodeBoundary *nodeBnd = node->nodeBnd;
 4892:       
 4893: // nodeBnd->isEssentialBC = true;      
 4894:       // Check if this node has essential BC
 4895:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4896:          // Verify BC value is valid
 4897:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4898: 
 4899:        
 4900:          // Set diagonal to 1 and zero off-diagonals
 4901:          node->coeffDiag = 1.0;
 4902: 
 4903:          for (int j = 0; j < node->numNodes; j++) {
 4904:                node->coeffMatrix[j] = 0.0;
 4905:          }
 4906:          
 4907:          // Set solution and RHS to BC value
 4908:          node->mX  = nodeBnd->elbc;
 4909:          node->qel = nodeBnd->elbc;
 4910: // printf("bbbbb\n");
 4911:       } else {
 4912:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4913: // printf("aaaaaa\n");
 4914:          for (int j = 0; j < node->numNodes; j++) {
 4915:                Node* nbNode = node->nodes[j];
 4916:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4917:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4918:                   // Verify neighbor's BC value
 4919:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4920: 
 4921:                   // Subtract contribution to RHS
 4922:                   // node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4923:                   node->coeffMatrix[j] = 0.0;  
 4924:                }
 4925:          }
 4926:       }
 4927:    }
 4928: 
 4929: 
 4930:    __global__ void updateElevation(void) {
 4931:       NODE(node);
 4932: 
 4933:       node->eta2 = node->mX;
 4934: 
 4935:       node->updateZCoordData();
 4936:    }
 4937: 
 4938: 
 4939:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4940: 
 4941:       SIDE(side);
 4942: 
 4943: 
 4944:       side->U = {0.0, 0.0}; 
 4945:          
 4946:       if(side->isDry) return;
 4947: 
 4948:       const Node *node1 = side->n1;
 4949:       const Node *node2 = side->n2;
 4950: 
 4951:       // Vertically integrated velocity U (in ll if ics=2)
 4952:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4953:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  
 4954:       }
 4955: 
 4956:    }
 4957: 
 4958:    __global__ void computeBottomDragVegetation(void) {
 4959:       // UNFINISHED. CHECK THIS:
 4960:       // How many kernels are needed? Why so many for loops?
 4961:       // Is the loop on sides needed?
 4962: 
 4963:       NODE(node);
 4964: 
 4965: 
 4966:       const int    kb      = node->kb;
 4967:       const double htot    = node->htot2(); 
 4968:       const double rough   = node->rough;
 4969: 
 4970:       
 4971:       if (node->isDry) {
 4972:          // Default values for dry nodes
 4973:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4974:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4975: 
 4976:          return;
 4977:        
 4978:       }
 4979: 
 4980:       // Compute bottom drag Cd
 4981:       //--------------------------------
 4982: 
 4983:       // nchi = {-1, 0, 1} is the type of bottom drag.
 4984:       if constexpr(nchi == 1) {
 4985: 
 4986:          bool ltmp = false; // for WBL iteration
 4987: 
 4988:          // Cdmax=-1 !max. Cd at node for this process (info only)
 4989:          // Drag at nodes
 4990:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)   XXXXXXXXXXXX
 4991:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 4992:         
 4993:          const double rough = node->rough;
 4994:         
 4995:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4996:          if (node->rough == 0.0) {
 4997:             node->Cd = 0.0;
 4998: 
 4999:          } else { //roughness >0 
 5000:           
 5001:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 5002:             const double bthick = max(dzb_min, bthick_ori);
 5003: 
 5004:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 5005: 
 5006:             double tmp = 1.0/(2.5*log(bthick/rough));
 5007:             node->Cd = tmp*tmp;
 5008: 
 5009:          } // if rough
 5010: 
 5011: 
 5012:          // RECOVER THIS: XXX
 5013:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 5014:          // Output warning for WBL if iteration didn't converge
 5015: 
 5016: 
 5017:       } // nchi==1
 5018: 
 5019: 
 5020:       //   Bottom stress in m^2/s^2
 5021:       if (node->rho[kb + 1] >= -98.0)
 5022:       {
 5023:          const double mag_u = length(node->u2[kb + 1]);
 5024:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5025: 
 5026:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5027:          // !sediment erosion: this part needs more documentation
 5028:       }
 5029:     
 5030: 
 5031: 
 5032:       // Compute vegetation parameters
 5033:       //--------------------------------
 5034: 
 5035:       // SAV constants
 5036:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5037:       constexpr double veg_cfpsi = 0.16;
 5038: 
 5039:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5040:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5041: 
 5042:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5043:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5044:          int kbin = 0; // bin index
 5045:          for (int k = kb; k < nvrt; k++) {
 5046:             // Computes node height above the bottom level
 5047:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5048:             assert(false && "Vertical variation of vegetation not implemented");
 5049: 
 5050:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5051:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5052:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5053:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5054:             // } else {
 5055:             //    // Find the bin at which the current vertical level is
 5056:             //    while (kbin<nbins_veg_vert) {
 5057:             //       const double zn = node->z[kbin];
 5058:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5059:             //          break;
 5060:             //       } // if
 5061:             //       kbin++;
 5062:             //    } // while
 5063:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5064: 
 5065:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5066:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5067:                
 5068:             //    // Linear interpolation of the vegetation parameters
 5069:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5070:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5071:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5072:             // } // if rl10
 5073: 
 5074:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5075: 
 5076:          } // for k
 5077: 
 5078: 
 5079:       } else { // Ganthy (iveg==2)
 5080:       //  Modify canopy height, diameter, and density
 5081: 
 5082:          // Make sure there is vegetation on this node
 5083:          if (node->veg_h_unbent > 0.0) {
 5084:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5085: 
 5086:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5087:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5088:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5089: 
 5090:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5091:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5092:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5093:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5094:          } // if veg_h_unbent
 5095: 
 5096:          for (int k = 0; k < nvrt; k++) {
 5097:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5098:          } // for k
 5099:       
 5100: 
 5101:       } // if iveg
 5102:      
 5103: 
 5104:       // Compute vertical mean of veg_alpha3D
 5105:       if (iveg != 0) {
 5106:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5107:          double sum1=0.0;
 5108:          double sum2=0.0;
 5109:          // Integrate over each level under the canopy...
 5110:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5111:             const double Dz = node->Dz(k);
 5112: 
 5113:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5114:             sum2 += Dz;
 5115: 
 5116:          } // for k
 5117:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5118:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5119: 
 5120:       } // if iveg
 5121: 
 5122:    }
 5123: 
 5124:    __global__ void computeVegetationAndDragParameters(void) {
 5125:       // Computes the vegetation and drag model parameters:
 5126:       // chi, \tilde\chi, beta, \breve{H}
 5127:       
 5128:       SIDE(side);
 5129: 
 5130:       if (side->isDry) return;
 5131: 
 5132:       const double htot = side->htot2();
 5133:       const int    kb   = side->kb;
 5134: 
 5135:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5136: 
 5137:       const double veg_h     = side->veg_h();
 5138:       const double veg_nv    = side->veg_nv();
 5139:       const double veg_c     = side->veg_c();
 5140:       const double veg_beta  = side->veg_beta;
 5141:       const double veg_alpha = side->veg_alpha_vert_mean();
 5142: 
 5143:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 5144:       // Velocity magnitude at the bottom level
 5145:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 5146:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 5147:       side->chi2 = side->Cd()*vmag1;
 5148:       side->chi  = side->chi2;
 5149:       if constexpr(iveg != 0) {
 5150:          const Node *n1 = side->n1;
 5151:          const Node *n2 = side->n2;
 5152:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5153:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5154:       }
 5155: 
 5156:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5157: 
 5158:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5159:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5160:       double magUa = 0.0;
 5161:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 5162:          // 3D wet side with veg...
 5163: 
 5164:          double magUa = 0.0;
 5165:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5166:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5167: 
 5168:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 5169:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 5170:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5171: 
 5172:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5173:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5174: 
 5175:                // Velocity magnitude at the bottom (l) of the level
 5176:                const double ul = length(side->u2[k]);
 5177: 
 5178:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5179:                magUa += Dz*0.5*(uh + ul);
 5180: 
 5181:             } // if HasVegetation
 5182:          } // for k
 5183:          const double ua = magUa/min(htot, veg_h); // Vertical average
 5184: 
 5185:          // Computes beta, used for computing the stress term at the top of the canopy.      
 5186:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 5187:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5188:             const double zCpy = side->zTopCanopy();
 5189:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5190:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5191:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5192:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5193:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5194:          } // if isSubmerged
 5195:       } // if iveg   
 5196: 
 5197:       // Computes the friction modified depth, \breve{H} in notes
 5198:       if (side->is2D()) { // 2D
 5199: 
 5200:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5201:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5202: 
 5203:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5204: 
 5205:          side->hhat = htot*htot/fricH; 
 5206: 
 5207:       } else { // 3D
 5208:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 5209: 
 5210:          if constexpr(iveg != 0) {
 5211:             
 5212:             if (side->isSubmerged()) { 
 5213:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5214:                side->hhat -= veg_c*Hhat_alpha;
 5215: 
 5216:             } else { // Emergent
 5217:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5218:             }
 5219:          } // if iveg
 5220: 
 5221:          // Enforce positivity for 3D model
 5222:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 5223:       } // if 3D
 5224: 
 5225:    }
 5226: 
 5227: 
 5228: 
 5229:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5230:    // Computes the density gradient between two elements, e1 and e2.
 5231:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5232:    // zero in the direction normal to the side. 
 5233:    // 
 5234:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5235:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 5236:    //
 5237:    // Input:
 5238:    //    e1: Element
 5239:    //    e2: Neighbor element (or nullptr if boundary)
 5240:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 5241:    //    k: Index of the half-level at which the density is interpolated
 5242:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 5243:    // 
 5244:    // Output:
 5245:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 5246:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 5247: 
 5248:       if (e2 == nullptr || e2->isDry) {
 5249:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 5250: 
 5251:          Side *side = e1->sides[j];
 5252:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 5253:                  
 5254:          if constexpr(ics == 1) {
 5255:             vec = side->n; // Normal vector to the side
 5256:          } else {
 5257:             // IMPLEMENT THIS XXXXXX
 5258:             // !replace with xel, yel?
 5259:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5260:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5261:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5262:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5263:          } //ics
 5264:                    
 5265:          diffRho = 0.0;
 5266: 
 5267:       } else { //internal and wet
 5268:          if constexpr(ics==1) {
 5269:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5270: 
 5271:             // Vector from e1 to e2
 5272:             vec = e2->center - e1->center;
 5273: 
 5274:          } else { 
 5275:             // IMPLEMENT THIS XXXXXX
 5276:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5277:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5278:             //                   alow(j)=xctr2
 5279:             //                   bdia(j)=yctr2
 5280:          } // ics
 5281: 
 5282:          diffRho = rho2 - e1->demeanedDensity(k);
 5283:       }
 5284: 
 5285:    }
 5286: 
 5287:    __global__ void computeDensityCubicSplines(void) {
 5288:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5289: 
 5290:       ELEM(elem);
 5291: 
 5292:       if (elem->isDry) return;
 5293: 
 5294:       const int kb = elem->kb;
 5295: 
 5296:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5297:       if (elem->is2D()) {
 5298:          // In the 2D case, the density is constant at the prism level. 
 5299:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5300:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5301:       } else { //3D
 5302: 
 5303:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5304:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5305:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5306:          ///// XXXX CHECK INDICES!!!!!
 5307:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5308:       } // 2D/3D
 5309: 
 5310:    }
 5311: } // extern "C"
 5312: 
 5313: 
 5314: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5315: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5316: 
 5317:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5318: 
 5319:    const int kb  = elem->kb;
 5320:    const int kb2 = elem2->kb;
 5321: 
 5322:    // z-coordinate of prism of elem
 5323:    const double zp = elem->z_prism(k);
 5324: 
 5325:    double rho = 0.0;
 5326: 
 5327:    if (elem2->is2D()) {
 5328:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5329: 
 5330:    } else {  // 3D
 5331: 
 5332:       // eta_min may be < zmax
 5333:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5334:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5335: 
 5336:       // (Extrapolate density below bottom, we will fix it later)
 5337:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5338:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5339:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5340:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5341:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5342:    } // 2D/3D
 5343:      
 5344: 
 5345:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5346:    // Now we need to fix it.
 5347:    if (elem->z[k] < elem2->z[kb2]) {
 5348:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5349: 
 5350:       // There are two methods to adjust the density at the bottom of the element.
 5351:       // iunder_deep=0: 
 5352:       const double depth1 = abs(elem->z[kb]); // larger depth
 5353: 
 5354:       if (iunder_deep==0) {
 5355: 
 5356:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5357: 
 5358:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5359: 
 5360:       } else { // iunder_deep != 0
 5361: 
 5362:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5363: 
 5364:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5365: 
 5366:          //   Demeaned density at the same z coordinate as
 5367:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5368:          }
 5369: 
 5370:       } // if iunder_deep
 5371:    } // if elem->z[kb] < elem2->z[kb]
 5372: 
 5373:    return rho;
 5374: }
 5375: 
 5376: 
 5377: extern "C" {
 5378:    __global__ void computeDensityGradient(void) {
 5379: 
 5380:       if constexpr(ibc != 0) return;
 5381: 
 5382:          // Compute the horizontal density gradient at each element.
 5383:       // It works in two steps:
 5384:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5385:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5386:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5387:       //             gradRho.r1 = rho1 - rho0
 5388:       //             gradRho.r2 = rho2 - rho0
 5389:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5390:       // 
 5391:       //  NOTE: We use de-meaned densities.
 5392: 
 5393:       ELEM(elem);
 5394: 
 5395:       if (elem->isDry) return;
 5396: 
 5397:       const int kb  = elem->kb;
 5398:       const int i34 = elem->i34;
 5399: 
 5400:       for (int k = kb + 1; k < nvrt; k++) {
 5401:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5402:          //             gradRho.r1 = rho1 - rho0
 5403:          //             gradRho.r2 = rho2 - rho0
 5404:          int icount = 0;
 5405:          double sumRx = 0.0;
 5406:          double sumRy = 0.0;
 5407:          for (int j1=0; j1<i34; j1++) { 
 5408: 
 5409:             const int j2 = elem->nxq(j1 + 1);
 5410: 
 5411:             // Pairs of consecutive neighbor elements of elem
 5412:             const Element *e1 = elem->nghbElems[j1];
 5413:             const Element *e2 = elem->nghbElems[j2];
 5414: 
 5415:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5416:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5417:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5418: if (elem->idx == 21) printf("$$AAAXXXXXXXA$$$ rho1 = %.16f, rho2 = %.16f\n", rho1, rho2);            
 5419: 
 5420:             // Compute the density difference and the vector from elem to e1 and e2
 5421:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5422:             double diffRho1, diffRho2;
 5423:             Vector2 vec1, vec2;
 5424:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5425:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5426: 
 5427:             const double rl1 = length(vec1);
 5428:             const double rl2 = length(vec2);
 5429:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5430: 
 5431:             const double delta = cross(vec1, vec2);
 5432:             const double sintheta = abs(delta)/(rl1*rl2);
 5433: 
 5434:             // To avoid problems, avoid elements with small angle between vectors
 5435:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5436:             const bool validEq = (sintheta > sin_one_deg);
 5437: 
 5438:             if (validEq) {
 5439:                // Solve the system of equations to get the density gradient at elem
 5440:                icount++;
 5441:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5442:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5443:                sumRx += Rx;
 5444:                sumRy += Ry;
 5445:             }
 5446:          } // for j1
 5447: 
 5448:          // Compute the average density gradient at elem
 5449:          if (icount==0) {
 5450:            // Bad mesh quality; bail out with 0 b-cc
 5451:            elem->gradRho[k] = {0.0, 0.0};
 5452:          } else {
 5453:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5454:          }
 5455: 
 5456:       } // for k
 5457: 
 5458:    }
 5459: 
 5460:    __global__ void computeBaroclinicTerm(void) {
 5461:    // Computes the baroclinic term at sides (at half levels).
 5462:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5463:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5464: 
 5465:       if (ibc == 1) return;
 5466: 
 5467:       SIDE(side);
 5468: 
 5469:       if (side->isDry) return;
 5470: 
 5471:       const Element *e1 = side->elems[0];
 5472:       const Element *e2 = side->elems[1];      
 5473:       const int kb = side->kb;
 5474:       
 5475:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5476: 
 5477:       // interpolates vertically the density gradient of the two elements at the half level/
 5478: 
 5479:       int k1 = max(kb, nvrt / 2);
 5480:       int k2 = max(kb, nvrt / 2);
 5481: 
 5482:       // Starts the integration at the surface and goes down to the bottom
 5483:       side->bcc[nvrt-1] = {0.0, 0.0};
 5484:       for (int k = nvrt - 2; k >= kb; k--) {
 5485:       // For each prism level (from surface to bottom)...
 5486: 
 5487:          // For both elements, interpolate density gradient at the side's half level.
 5488:          // The gradient at the side is the average of the gradients at the elements.
 5489:          // w1, w2 are used to take into account boundary sides, with just one element.
 5490:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5491:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5492:          const double wsum = w1 + w2;
 5493:          w1 = w1/wsum;
 5494:          w2 = w2/wsum;
 5495:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5496: 
 5497:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5498:          Vector2 gradRho = {0.0, 0.0};
 5499:          if (e1 != nullptr && k > kb) {
 5500:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5501:             
 5502:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5503:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5504:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5505: printf("###### k1 = %d, side->idx = %d, zc[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, zrat = %.16f\n",
 5506:       k1, side->idx, k, side->zc[k], k1, e1->z[k1], k1 + 1, e1->z[k1 + 1], e1->gradRho[k1].x, e1->gradRho[k1].y, zrat);            
 5507:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5508:          }      
 5509:          if (e2 != nullptr && k > kb) {
 5510:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5511:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5512:             
 5513:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5514:          }
 5515: 
 5516:          if constexpr(ics==2) {
 5517:             assert(false && "Not implemented: ics == 2");
 5518:             // IMPLEMENT THIS XXXXXX
 5519:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5520:             // swild(1)=tmp1
 5521:             // swild(2)=tmp2
 5522:          }
 5523:          
 5524:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5525:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5526:          // CHECK INDICES!!! XXX
 5527:          const double grav3 = side->grav3();
 5528:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5529: 
 5530:       } // for
 5531: 
 5532:    }
 5533: 
 5534: 
 5535: 
 5536:    __global__ void computeHorGradientAtSide(void) {
 5537: 
 5538:       // Compute the horizontal density gradient at each element.
 5539:       // It works in two steps:
 5540:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5541:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5542:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5543:       //             gradRho.r1 = rho1 - rho0
 5544:       //             gradRho.r2 = rho2 - rho0
 5545:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5546:       // 
 5547:       //  NOTE: We use de-meaned densities.
 5548: 
 5549:       SIDE(side);
 5550: 
 5551: // printf("side->isDry: %d\n", side->isDry);
 5552:       if (side->isDry) return;
 5553: 
 5554:       // Computes the gradient of the variables at the side center.
 5555:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5556:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5557:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 5558: 
 5559:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5560:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5561:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5562:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5563: 
 5564: 
 5565:    }
 5566: 
 5567: 
 5568:    __global__ void solveMomentumEquations(double time) {
 5569: 
 5570:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5571:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5572: 
 5573:       SIDE(side);
 5574: 
 5575:       if (side->isDry) 
 5576:       {
 5577:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 5578: 
 5579:          return;
 5580:       }
 5581: 
 5582:       const Node *n1 = side->n1;
 5583:       const Node *n2 = side->n2;
 5584: 
 5585:       const int kb = side->kb;
 5586: 
 5587:       const double veg_h = side->veg_h();
 5588:       const double grav3 = side->grav3();
 5589: 
 5590:       if (side->is2D()) {
 5591:          // Warning: Do not use htot2, which is updated.
 5592:          const double htot = side->htot1();
 5593:          const double hhat = side->hhat;
 5594: 
 5595:          // assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5596: 
 5597:          Vector2 tau2 = {0.0, 0.0};
 5598:           
 5599:          if constexpr(ics==1) {
 5600:             tau2 = side->tau();
 5601: 
 5602:          } else {
 5603:             assert(false && "Not implemented: ics == 2");
 5604:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5605:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5606:             // taux2=(vn1+tt1)*0.5d0
 5607:             // tauy2=(vn2+ss1)*0.5d0
 5608:          } // if ics         
 5609: 
 5610:          // hat_gam has units of m/s
 5611: 
 5612:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5613: 
 5614:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5615:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5616: 
 5617:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5618: 
 5619: 
 5620:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 5621:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 5622: 
 5623:          for (int k = 0; k < nvrt; k++) side->u2[k] = {ux, uy};
 5624: 
 5625: 
 5626:       }
 5627:       else { // 3D
 5628: 
 5629:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5630:          // 
 5631:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5632:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5633:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5634:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5635:          // k+1 and k.
 5636: 
 5637: 
 5638:    
 5639: 
 5640: 
 5641:          const int ndim = nvrt - kb;
 5642:          const double zTopCanopy = side->zTopCanopy();
 5643: 
 5644:          // Initialize the tridiagonal system
 5645:          for (int k = kb + 1; k < nvrt; k++) {
 5646:             
 5647:             const int kin = k - (kb + 1);
 5648: 
 5649:             // Vertical viscosity at the face center
 5650:             const double dfz = 1e-6; //0.5*(side->dfv(k) + side->dfv(k + 1)); XXXXX
 5651:            
 5652: 
 5653:             alow[kin] = 0.0;
 5654:             cupp[kin] = 0.0;
 5655:             bdia[kin] = 0.0;
 5656: 
 5657:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5658:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5659: 
 5660:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5661:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5662:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5663: 
 5664:             // First part: layers k, k+1
 5665:             if (k < nvrt - 1) {
 5666:                              
 5667:                if constexpr(iveg != 0) {
 5668: 
 5669:                   // If there is vegetation at this level...
 5670:                   if (zTopCanopy > side->zc[k]) {
 5671:                      // If the canopy is above the k layer...
 5672:                      
 5673:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5674:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5675:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5676:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5677: 
 5678:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5679:                      const double vmag2 = length(ut2);
 5680:                      const double vmag1 = length(side->u2[k]);
 5681:                      const double vmag = 0.5*(vmag1 + vmag2);
 5682:                      
 5683:                      // Computes the vegetation alpha at the face center
 5684:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5685: 
 5686:                      cff1 += veg_alpha_sd*dt*vmag;
 5687: 
 5688:                   } // if (zTopCanopy
 5689:                } // if iveg
 5690: 
 5691:                const double dzz = side->Dz(k + 1);
 5692:                const double tmp = dt*dfz/dzz;
 5693:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5694: 
 5695:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5696:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5697:             }
 5698: 
 5699: 
 5700:             // Second part: layers k-1, k
 5701:             if (k > kb + 1) {
 5702: 
 5703:                double cff1 = 1.0; //init \bar{c^k}
 5704: 
 5705:                if constexpr(iveg != 0) {
 5706:                   // If there is vegetation at this level...
 5707:                   if (zTopCanopy > side->zc[k-1]) {
 5708:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5709:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5710: 
 5711:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5712: 
 5713:                      const double vmag2 = length(ut2);
 5714:                      const double vmag1 = length(side->u2[k-1]);
 5715:                      const double vmag = 0.5*(vmag1 + vmag2);
 5716: 
 5717:                      // Computes the vegetation alpha at the face center
 5718:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5719:                      cff1 += veg_alpha_sd*dt*vmag;
 5720:                   } // if zTopCanopy
 5721: 
 5722:                } // if iveg
 5723: 
 5724:                const double dzz = side->Dz(k);
 5725:                const double tmp = dt*dfz/dzz;
 5726:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5727: 
 5728:                alow[kin] += cff1*dzz/6.0 - tmp;
 5729:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5730: 
 5731:             } else { // Bottom boundary
 5732:                // This occurs at the bottom, where the bottom drag is applied.
 5733: 
 5734:                bdia[kin] += dt*side->chi2; // XXXX
 5735: 
 5736: 
 5737:             } // if (k > kb + 1)
 5738: 
 5739: 
 5740: 
 5741:          } // for (int k
 5742: 
 5743: 
 5744: 
 5745:          // Computes the RHS.
 5746:          // -----------------
 5747: 
 5748:          //	BC to be imposed at the end.
 5749: 
 5750:          const Vector2 gradETP  = side->gradETP;
 5751:          const Vector2 gradPr   = side->gradPr;
 5752:          const Vector2 gradEta1 = side->gradEta1;
 5753:          const Vector2 gradEta2 = side->gradEta2;
 5754: 
 5755:          const Vector2 *btu = side->btu;
 5756:          const Vector2 *u2  = side->u2;
 5757:          const double coriolis = side->coriolis;
 5758:          const Vector2 *nuGradU = side->nuGradU;
 5759: 
 5760: 
 5761:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5762: 
 5763:          for (int k = kb + 1; k < nvrt; k++) {
 5764:             const int kin = k - kb - 1;
 5765: 
 5766:             const double dz_0 = side->Dz(k);
 5767:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5768: 
 5769:             rrhs[kin] = {0.0, 0.0};
 5770:             double dz = 0.0;
 5771: 
 5772:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5773:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5774:             if (k < nvrt  ) dz += dz_1;
 5775:             if (k > kb + 1) dz += dz_0;
 5776: 
 5777:             // Elevation gradient, atmospheric pressure and tidal potential
 5778:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5779: 
 5780:             // Coriolis, advection, wind stress, and horizontal viscosity
 5781:             if (k < nvrt - 1) {
 5782: 
 5783: 
 5784:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5785:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5786:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5787:                                                 
 5788: // if (side->idx == 21) printf("$$BBBB$$$ dz_1 = %.16f, coriolis = %.16f, btu[%d] = %.16f, %.16f, u2[%d] = %.16f, %.16f, nuGradU[%d] = %.16f, %.16f\n", dz_1, coriolis, k, btu[k].x, btu[k].y, k, u2[k].x, u2[k].y, k, nuGradU[k].x, nuGradU[k].y);            
 5789:                //diff stress tensors 1006
 5790:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5791:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5792:                   assert(false && "Not implemented: itur == 5");
 5793:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5794:                }
 5795: 
 5796:             } else { // k == nvrt - 1 SURFACE
 5797:                Vector2 tau2 = {0.0, 0.0};
 5798:                if constexpr(ics==1) {
 5799:                   tau2 = side->tau();
 5800:       
 5801:                } else {
 5802:                   assert(false && "Not implemented: ics == 2");
 5803:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5804:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5805:                   // taux2=(vn1+tt1)*0.5d0
 5806:                   // tauy2=(vn2+ss1)*0.5d0
 5807:                } // if ics
 5808: 
 5809:                rrhs[kin] += dt*tau2;
 5810: 
 5811:             } // if k<nvrt
 5812: 
 5813:             if (k > kb + 1) {
 5814:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5815:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5816:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5817: 
 5818:                // diff stress tensors 1006
 5819:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5820:                   assert(false && "Not implemented: itur == 5");
 5821:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5822:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5823:                }
 5824: 
 5825:             } // if k>kbs + 1
 5826: 
 5827:             // Baroclinic
 5828:             Vector2 *bcc = side->bcc;
 5829:             if constexpr(ibc == 0) {
 5830:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5831:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5832: 
 5833:             } // if ibc==0
 5834: 
 5835:          } // k=kb + 1,nvrt
 5836: 
 5837: 
 5838:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5839: 
 5840:          for (int k = kb + 1; k < nvrt; k++) {  // YYYYYYYYY can be kb 
 5841:             const int kin = k - kb - 1;
 5842: 
 5843:             // Velocity is always clamped to maximum values
 5844:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5845:          } // k
 5846: 
 5847:       } // if side->is2D()
 5848:       
 5849: 
 5850:       // Impose velocity boundary condition at the bottom
 5851:       if constexpr(imm == 2) { // 3D bed deformation model
 5852:          double dep;
 5853:          Vector2 vel;
 5854: 
 5855:          assert(false && "Not implemented: imm == 2");
 5856:          //update_bdef(time, x0, y0, dep, vel);
 5857:          // side->u2[kb] = vel;
 5858: 
 5859:       } else { // imm = 0 or 1
 5860:          if (side->Cd() == 0.0) {
 5861:             side->u2[kb] = side->u2[kb + 1];
 5862: 
 5863:          } else if (side->is3D()) { // 3D no slip bottom   
 5864:             side->u2[kb] = {0.0, 0.0};
 5865:          }
 5866:           
 5867:       } // if imm
 5868: 
 5869:       // The velocities below the bottom level are set to zero
 5870:       for (int k = 0; k <= kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5871: 
 5872: 
 5873:    }
 5874: 
 5875: 
 5876:    __global__ void applyMomentumBC(void) {
 5877: 
 5878:       SIDE_BND(sideBnd);
 5879: 
 5880:       Side *side = sideBnd->side;
 5881:       const BoundarySegment *segment = sideBnd->segment;
 5882:       const Node *n1 = side->n1;
 5883:       const Node *n2 = side->n2;
 5884: 
 5885:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5886: 
 5887:       const bool isLand = segment->isLand;
 5888:       const int ifltype = segment->ifltype;
 5889: 
 5890:       const int kb = side->kb;
 5891: 
 5892:       if (!isLand && ifltype != 0) {
 5893:          const Vector2 *ubc = sideBnd->ubc;
 5894:   
 5895:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5896:             
 5897:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5898:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5899: 
 5900:             if (ifltype == -1) {
 5901:                // Flather 1
 5902: 
 5903:                const double depth = side->depth();
 5904: 
 5905:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5906: 
 5907:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5908: 
 5909:                side->u2[k] = vnorm*side->n;
 5910: 
 5911:             } else if (ifltype == -2) { // Discharge
 5912: 
 5913:                const double eta1 = side->eta1();
 5914:                const double eta2 = side->eta2();
 5915:                const double htot = side->htot2();
 5916: 
 5917:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5918:                assert(false && "Not implemented: Discharge bc");
 5919:                // const double dischrg = discharge(eta1);
 5920:                const double dischrg = 0.0; // XXX REMOVE
 5921:                
 5922: 
 5923:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5924: 
 5925:                const double vnorm = dischrg*eta2/htot;
 5926: 
 5927:                side->u2[k] = vnorm*side->n;
 5928: 
 5929:             }
 5930:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5931:                const double vnorm = dot(side->u2[k], side->n);
 5932: 
 5933:                double rat;
 5934:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5935:                else              rat = segment->vobc2; // outgoing
 5936: 
 5937:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5938: 
 5939:             }
 5940:             else { // not Flather or 3D radiation
 5941:                side->u2[k] = ubc[k];
 5942: 
 5943:             } // if (segment->ifltype...
 5944: 
 5945:          }
 5946: 
 5947:       }
 5948:       else if (isLand) { // if it is land boundary side
 5949: 
 5950:          if constexpr(islip == 0) { // free slip
 5951: 
 5952:             for (int k = kb; k < nvrt; k++) {
 5953: 
 5954:                const Vector2 t = side->t();
 5955:                const Vector2 n = side->n;
 5956: 
 5957:                double vnorm = 0.0; // for most cases
 5958:                const double vtan = dot(side->u2[k], t);
 5959:                
 5960:                side->u2[k] = vtan*t - vnorm*n;
 5961: 
 5962:             }
 5963: 
 5964:          } else { // no slip
 5965:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5966: 
 5967:          }
 5968:       } // if (side segment type...
 5969: 
 5970:    
 5971: 
 5972:    }
 5973: 
 5974: 
 5975:    __global__ void shapiroFilter1(void) {
 5976:       // First step of the Shapiro filter (normally used if indvel<=0)
 5977:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5978: 
 5979:       SIDE(side);
 5980: 
 5981:       // Only internal wet sides are processed
 5982:       if (side->isDry || !(side->isInternal())) return;
 5983: 
 5984:       const int kb = side->kb;
 5985: 
 5986:       for (int mm = 0; mm < niter_shap; mm++) {
 5987: 
 5988:          for (int k = kb + 1; k < nvrt; k++) {
 5989:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5990:             Vector2 suru = {0.0, 0.0};
 5991: 
 5992:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5993: 
 5994:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5995: 
 5996:                int kin = k;
 5997:                if (!(nSide->isDry)) kin = max(k, kb + 1);
 5998:                
 5999:                if constexpr(ics==1) {
 6000:                   suru += nSide->u2[kin];
 6001: 
 6002:                } else {
 6003:                   assert(false && "Not implemented: ics == 2");
 6004:                   // Vector2 vn1, vn2;
 6005:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 6006:                   // suru=suru+vn1;
 6007:                   // surv=surv+vn2;
 6008:                }
 6009:             }
 6010: 
 6011: 
 6012:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 6013: 
 6014:          }
 6015:       }
 6016:    }
 6017: 
 6018:    __global__ void shapiroFilter2(void) {
 6019:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6020: 
 6021:       SIDE(side);
 6022: 
 6023:       if (side->isDry || !(side->isInternal())) return;
 6024: 
 6025:       const int kb = side->kb;
 6026: 
 6027:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6028: 
 6029:       if (side->is2D()) {
 6030:          side->u2[kb + 1] = side->bcc[kb + 1];
 6031:          side->u2[kb    ] = side->u2 [nvrt - 1];
 6032: 
 6033:       } else {
 6034:          // 3D
 6035:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6036:          
 6037:       }
 6038: 
 6039:    }
 6040: 
 6041: 
 6042:    __global__ void ul0UpdateZCoords(void) {
 6043:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6044:       
 6045:       NODE(node);      
 6046: 
 6047: 
 6048:       if (node->isDry2()) { 
 6049: 
 6050:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6051: 
 6052:          if constexpr(ivcor != 1) node->kb = 0;
 6053: 
 6054:       } else {
 6055: 
 6056:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6057:          node->updateKb();
 6058: 
 6059:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6060: 
 6061:       }
 6062: 
 6063:       // We use the temp.b field to store the previous state of isDry.
 6064:       node->tmp.b = node->isDry;
 6065: 
 6066:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6067:       node->isDry = true;
 6068: 
 6069:    }
 6070: 
 6071:    __global__ void ul0ComputeDryElementsAndNodes(void)
 6072:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 6073:    {
 6074:       ELEM(elem);
 6075: 
 6076:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 6077: 
 6078:       // All the nodes of a wet element are wet.
 6079:       if (!elem->isDry) {
 6080:          elem->nodes[0]->isDry = false;
 6081:          elem->nodes[1]->isDry = false;
 6082:          elem->nodes[2]->isDry = false;
 6083:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 6084: 
 6085:       }
 6086: 
 6087: 
 6088:       elem->kb = 0;
 6089: 
 6090:       if (elem->isDry) return;
 6091: 
 6092:       // Wet
 6093:       const Node *n1 = elem->nodes[0];
 6094:       const Node *n2 = elem->nodes[1];
 6095:       const Node *n3 = elem->nodes[2];  
 6096:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 6097: 
 6098:    //    if(elem->isDry2()) {
 6099:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6100:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6101:    //        call parallel_abort(errmsg)
 6102:    //    }
 6103: 
 6104: 
 6105:       // Computes element's kb as the minimum of the nodes' kb.
 6106:       const int kb1 = n1->kb;
 6107:       const int kb2 = n2->kb;
 6108:       const int kb3 = n3->kb;
 6109:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 6110: 
 6111: 
 6112:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6113: 
 6114: 
 6115:       // Computes the element z as the mean of the nodes z.
 6116:       for (int k = elem->kb; k < nvrt; k++) {
 6117: 
 6118:          // Compute the element z as the mean of the nodes z.
 6119:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 6120:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6121:          elem->z[k] /= elem->i34;
 6122: 
 6123:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 6124:       }
 6125:                   
 6126:    }
 6127: 
 6128:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6129:    {
 6130:       NODE(node);
 6131:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6132: 
 6133:       if (it == iths) return;
 6134: 
 6135: 
 6136:       if(!node->isDry && node->tmp.b) { // rewetted
 6137:          for (int k=0; k < nvrt; k++) {
 6138: 
 6139:             Vector3 utmp={0.0, 0.0, 0.0};
 6140: 
 6141:             double ttmp=0.0;
 6142:             double stmp=0.0;
 6143:             int icount=0;
 6144:             for (int j = 0; j < node->numNodes; j++) {
 6145: 
 6146: 
 6147:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 6148:                if (!node->isDry) { // all indices extended
 6149:                   icount++;
 6150: 
 6151:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6152:                   utmp += node->uvw2(k);
 6153:                   
 6154:                   ttmp += node->tracers[k].tracer[0]; 
 6155:                   stmp += node->tracers[k].tracer[1]; 
 6156:                }
 6157:             }
 6158: 
 6159:             if(icount > 0) {
 6160:                const double inv_icount = 1.0/icount;
 6161:                node->u2[k]     = {inv_icount*utmp.x, inv_icount*utmp.y};
 6162:                node->w2[k]     = inv_icount*utmp.z;
 6163:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6164:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6165:             }
 6166:          }
 6167:       }
 6168:    }
 6169: 
 6170: 
 6171:    __global__ void ul0UpdateSides(int it, int iths) {
 6172: 
 6173:       SIDE(side);
 6174: 
 6175:       // A side is wet if and only if at least one of its elements is wet.
 6176:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6177: 
 6178:       const Node *n1 = side->n1;
 6179:       const Node *n2 = side->n2;
 6180:       const int kb1 = n1->kb;
 6181:       const int kb2 = n2->kb;
 6182: 
 6183:       side->kb = 0; // dry
 6184: 
 6185:       if (isWet) {
 6186: 
 6187:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6188: 
 6189:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6190: 
 6191:          side->kb = min(kb1, kb2);
 6192: 
 6193:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6194: 
 6195:          for (int k = side->kb; k < nvrt; k++) {
 6196:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6197: 
 6198:          
 6199:             assert(((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0)) && "Weird side (3)");
 6200: 
 6201:             // Compute velocity for re-wetted sides 
 6202:             if ((it != iths) && (side->isDry && isWet)) {
 6203:             
 6204:                Vector2 utmp={0.0, 0.0};
 6205: 
 6206:                int icount=0;
 6207: 
 6208:                // For all the sides on the two elements that share this side
 6209:                for (int j=0; j < 2; j++) {
 6210:                   const Element *elem = side->elems[j];
 6211:                   if (elem == nullptr) continue;
 6212: 
 6213:                   for (int jj=0; jj < elem->i34; jj++) {
 6214:                      const Side *nSide = elem->sides[jj];
 6215:                      if (nSide->isDry) continue;
 6216: 
 6217:                      icount++;
 6218:                      utmp += nSide->u2[k];                     
 6219:                   }
 6220:                }
 6221:                   
 6222:                assert(icount > 0 && "No wet sides around this side");
 6223:                if (icount > 0)  side->u2[k] = utmp/icount;
 6224:                   
 6225:             } // if ((it != iths) && (side->isDry && isWet))
 6226: 
 6227:          } // for k
 6228: 
 6229:       } // if isWet
 6230:    
 6231:       side->isDry = !isWet;
 6232: 
 6233:    }
 6234: 
 6235: 
 6236:    __global__ void zeroNodalVelocities(void) {
 6237:       NODE(node);
 6238: 
 6239:       for (int k = 0; k < nvrt; k++) {
 6240:          node->u2[k]   = {0.0, 0.0};
 6241:          node->w2[k]   = 0.0;
 6242:          node->utmp[k] = {0.0, 0.0};
 6243:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6244:       }
 6245:    }
 6246: 
 6247:  
 6248: 
 6249:    __global__ void computeNodalVerticalVelocities1(void) {
 6250:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6251:    // Adds the element's vertical velocity times the element's area.
 6252:       ELEM(elem);
 6253: 
 6254:       for (int j = 0; j < elem->i34; j++) {
 6255:          Node *node = elem->nodes[j];
 6256: 
 6257:          for (int k = node->kb; k < nvrt; k++) {
 6258:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6259:          }
 6260:          atomicAdd(&(node->tmp.d), elem->area);
 6261:       }
 6262:    }
 6263: 
 6264:    __global__ void computeNodalVerticalVelocities2(void) {
 6265:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6266:    // Divides by the total area of the elements sharing the    node.
 6267:       NODE(node);
 6268: 
 6269:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 6270:    }
 6271: 
 6272: 
 6273:    __global__ void computeNodalHorizontalVelocities1(void) {
 6274:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6275:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 6276: 
 6277:       ELEM(elem);
 6278: 
 6279:       const int kb = elem->kb;
 6280:       const bool isTri = elem->isTri();
 6281: 
 6282:       if constexpr(indvel <= 0) {
 6283:          // Assuming discontinoius hvel.
 6284: 
 6285: 
 6286:          if (isTri) { // For triangles
 6287:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6288:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6289: 
 6290:             for (int j = 0; j < 3; j++) {
 6291:                // For every node of the triangle...
 6292:                Node *node = elem->nodes[j];
 6293: 
 6294:                const Side *s1 = elem->sides[j];
 6295:                const Side *s2 = elem->sides[(j + 1) % 3];
 6296:                const Side *s3 = elem->sides[(j + 2) % 3];
 6297: 
 6298:                const int numElements = node->numElements;
 6299:                const double inv_numElements = 1.0/numElements;
 6300: 
 6301:                for (int k = kb; k < nvrt; k++)  {
 6302:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated at the node   
 6303:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 6304:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 6305:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 6306:                   atomicAdd(&(node->utmp[k].x), inv_numElements * u.x);
 6307:                   atomicAdd(&(node->utmp[k].y), inv_numElements * u.y);
 6308: 
 6309:                }
 6310: 
 6311:             }
 6312:          }
 6313:          else { // For quads
 6314:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6315: 
 6316:          }
 6317: 
 6318:       }
 6319:       
 6320:    }
 6321: 
 6322: 
 6323:    __global__ void computeNodalHorizontalVelocities2(void) {
 6324:       NODE(node);
 6325: 
 6326:       for (int k = 0; k < nvrt; k++) {
 6327:          node->u2[k] = node->utmp[k];
 6328:          node->w2[k] = node->w2[k];
 6329:       }
 6330:       
 6331:    }   
 6332: 
 6333:    __global__ void computeNodalHorizontalVelocitiesOLD(void) {
 6334:    // XXXX I'm not sure where I got this function from. 
 6335:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 6336:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 6337:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 6338:    // It uses the utmp array as a temporary array to store the velocities.
 6339: 
 6340:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 6341: 
 6342:       SIDE(side);
 6343: 
 6344:       const int kb = side->kb;
 6345: 
 6346:       Node *n1 = side->n1;
 6347:       Node *n2 = side->n2;
 6348: 
 6349:       for (int k = kb; k < nvrt; k++) {
 6350: 
 6351:          // Cast the u2 vector into a Vector2 
 6352:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&(n1->utmp[k]));
 6353:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&(n2->utmp[k]));
 6354: 
 6355:          n1_u2 = side->u2[k]/n1->numSides;
 6356:          n2_u2 = side->u2[k]/n2->numSides;
 6357: 
 6358:       }
 6359: 
 6360: 
 6361:    }
 6362: 
 6363:    __global__ void resetVelocityOpenBndNodes(void) {
 6364:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6365: 
 6366:       NODE_BND(nodebnd);
 6367: 
 6368:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6369:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }
 6370:       }
 6371: 
 6372:    }
 6373: 
 6374: 
 6375:    __global__ void setVelocityOpenBndNodes(void) {
 6376:    // For open boundary nodes sets their velocity to the imposed values.
 6377: 
 6378:       SIDE_BND(sidebnd);
 6379: 
 6380:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6381:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6382:          // to its segment to the average of the side velocity.
 6383: 
 6384:          for (int k = 0; k < nvrt; k++) {
 6385:             Node *n1 = sidebnd->side->n1;
 6386:             Node *n2 = sidebnd->side->n2;
 6387: 
 6388: 
 6389:             Vector2 n1_u2(n1->u2[k]);
 6390:             Vector2 n2_u2(n2->u2[k]);
 6391: 
 6392:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6393:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6394:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6395:             }
 6396:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6397:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6398:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6399:             }
 6400: 
 6401:          }
 6402: 
 6403:       }
 6404: 
 6405:    }
 6406: 
 6407: 
 6408:    __global__ void computeVerticalVelocity(void) {
 6409:       // Computes the vertical velocity at the (2D) element's centroid.
 6410:       // In this function we will be considering volumetric elements, with side faces and a 
 6411:       // bottom and a top face. We will call them SFs, BF and TF.
 6412:       // It computes the flux coming from BF and the SFs.
 6413:       // If the bed is moving, it takes that into account.
 6414:       // Since water is incompressible, the integral of the velocity times the normal vector
 6415:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6416:       // and the BF is equal to the flux going out from the TF.
 6417:       // TF = - BF - sum(SFs).
 6418:       // It then computes the horizontal velocity at the center of TF.
 6419:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6420:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6421:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6422: 
 6423:       ELEM(elem);
 6424: 
 6425:       if (elem->isDry) return;
 6426: 
 6427:       const int kb = elem->kb;
 6428:       const bool isTri = elem->isTri();
 6429: 
 6430:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6431: 
 6432:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6433:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6434:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6435: 
 6436:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6437: 
 6438:       double area3D;
 6439: 
 6440:       // Bottom face flux
 6441:       double bottomFlux = 0.0;
 6442:       Vector2 u2meanBottom = {0.0, 0.0};
 6443:       const Vector2 gradh = elem->grad2(&Node::depth);
 6444:       if constexpr(imm==2) {
 6445:          Vector3 ubed;
 6446: 
 6447:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6448:          // updateBDEF(ubed);
 6449:      
 6450:          // const double bflux0 = dot(ubed, elem_n1);
 6451: 
 6452:          // elem->w[kb] += ubed.z;
 6453:       }
 6454:       else {
 6455:          Vector2 umean;
 6456:          if constexpr(ics == 1) {
 6457:             u2meanBottom = elem->mean(kb, &Side::u2);
 6458:          }
 6459:          else {
 6460:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6461:          }
 6462: 
 6463:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6464:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6465: 
 6466:          bottomFlux = - dot(gradh, u2meanBottom);
 6467:       } // if imm
 6468: 
 6469:       // Compute w for kb+1 to nvrt-1
 6470:       for (int l = kb; l < nvrt - 1; l++) {
 6471: 
 6472:          // normal vector to the top face of the "volumetric" element (3D)
 6473:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6474: 
 6475:          // Compute the total flux at the sides
 6476:          double sideFlux = 0.0;
 6477:          Vector2 u2top = {0.0, 0.0};
 6478:          for (int j = 0; j < elem->i34; j++) {
 6479:             const Side *side = elem->sides[j];
 6480: 
 6481:             const double sideArea = side->area(l);
 6482:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6483:             const double sign = elem->ssign[j]; 
 6484: 
 6485:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6486:          }
 6487:          
 6488:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6489:          //velocities at the centers of the sides
 6490:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6491: 
 6492:          // The flx at the top ace can be computed from the other flows.
 6493:          const double topFlux = - sideFlux - bottomFlux;
 6494:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6495: 
 6496:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6497: 
 6498:          elem_n1 = elem_n2;
 6499: 
 6500:          bottomFlux = - topFlux;
 6501:       }
 6502:    }  
 6503: 
 6504: 
 6505: 
 6506: 
 6507: 
