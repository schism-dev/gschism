 7093: 
 7094:    __global__ void computeVerticalVelocity(void) {
 7095:       // Computes the vertical velocity at the (2D) element's centroid.
 7096:       // In this function we will be considering volumetric elements, with side faces and a 
 7097:       // bottom and a top face. We will call them SFs, BF and TF.
 7098:       // It computes the flux coming from BF and the SFs.
 7099:       // If the bed is moving, it takes that into account.
 7100:       // Since water is incompressible, the integral of the velocity times the normal vector
 7101:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 7102:       // and the BF is equal to the flux going out from the TF.
 7103:       // TF = - BF - sum(SFs).
 7104:       // It then computes the horizontal velocity at the center of TF.
 7105:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 7106:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 7107:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 7108: 
 7109:       ELEM(elem);
 7110: 
 7111:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 7112: 
 7113:       if (elem->isDry) return;
 7114: 
 7115:       const int kb = elem->kb;
 7116:       const bool isTri = elem->isTri();
 7117: 
 7118:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 7119: 
 7120:       // Compute the bottom velocity
 7121:       if constexpr(imm != 0) {
 7122:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 7123:       }
 7124: 
 7125: 
 7126:       double bottomArea3D;
 7127:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 7128: 
 7129:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 7130: 
 7131:       double topArea3D;
 7132: 
 7133:       // Bottom face flux
 7134:       double bottomFlux = 0.0;
 7135:       Vector2 u2meanBottom = {0.0, 0.0};
 7136:       const Vector2 gradh = elem->grad2(&Node::depth);
 7137:       if constexpr(imm==2) {
 7138:          Vector3 ubed;
 7139: 
 7140:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 7141:          // updateBDEF(ubed);
 7142:      
 7143:          // const double bflux0 = dot(ubed, elem_bottom_n);
 7144: 
 7145:          // elem->w[kb] += ubed.z;
 7146:       }
 7147:       else {
 7148: 
 7149:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 7150:   
 7151:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 7152:          // in the direction of motion.
 7153:          const double bottomW = - dot(gradh, u2meanBottom);  
 7154:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 7155: 
 7156:          // VElocity associated to the bed deformation
 7157:          double bedVelocity = 0.0;
 7158:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 7159: 
 7160:          elem->w[kb] = bedVelocity + bottomW; 
 7161: 
 7162:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 7163:          
 7164:       } // if imm
 7165: 
 7166:       // Compute w for kb+1 to nvrt-1
 7167:       for (int l = kb; l < nvrt - 1; l++) {
 7168: 
 7169:          // normal vector to the top face of the "volumetric" element (3D)
 7170:          Vector3 elem_top_n = elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 7171: 
 7172:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 7173:          assert(elem_top_n.z > 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 7174: 
 7175:          // Compute the total flux at the sides
 7176:          double sideFlux = 0.0;
 7177: 
 7178:          for (int j = 0; j < elem->i34; j++) {
 7179:             const Side *side = elem->sides[j];
 7180:             const int kbs = side->kb;
 7181:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 7182:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 7183:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 7184: 
 7185:             // The area is "clamped" meaning that it takes kb into account.
 7186:             const double sideArea = side->areaClamped(l);
 7187: 
 7188:             const double sign = elem->ssign[j]; 
 7189: 
 7190:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 7191:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 7192:          }
 7193:          
 7194:          // Compute the horizontal velocity at the center of the top face as an average of the 
 7195:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 7196:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 7197: 
 7198:          // The flux at the top ace can be computed from the other flows.
 7199:          // All fluxes are in directions into the prism.
 7200:          const double topFlux = - sideFlux - bottomFlux;
 7201: 
 7202:          // Flux at the top face due to the horizontal velocities only
 7203:          // topFlux = topHorizontalFlux + topVerticalFlux
 7204:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 7205: 
 7206:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + sideFlux + bottomFlux = 0, so:
 7207:          const double topVerticalFlux = topFlux - topHorizontalFlux;  
 7208: 
 7209:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 7210: 
 7211:          bottomFlux = -topFlux;
 7212:          
 7213:       }
 7214: 
 7215:    }  
 7216: 
 7217: 
 7218: 
 7219: 
 7220: 
 7221: 
 7222: 
 7223: // !===============================================================================
 7224: // !===============================================================================
 7225: 
 7226: } // extern "C"
 7227: 
 7228: #ifdef DONTCOMPILE
 7229: __device__ void computeVerticalAdvection(void) {
 7230:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 7231: 
 7232:    sdbt(1:2,:,:)=0.d0
 7233: 
 7234:    const Side *side = FROM kernel;
 7235: 
 7236:    if(side->isDry) return;
 7237: 
 7238:    // If side is wet...
 7239: 
 7240: 
 7241:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 7242:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 7243:    double ws[nvrt] = {} // w @ side
 7244:    int icount = 0;
 7245:    for (int j=0; j<2; j++) {
 7246:       const Element *elem = side->elements[j];
 7247:        
 7248:       if(elem != nullptr) {
 7249:          icount++;
 7250:          for (int k=0; k<nvrt; k++) {
 7251:             ws[k] = ws[k] + elem->w[k];
 7252:          }
 7253:       }
 7254:    }  // for j
 7255: 
 7256:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 7257:    ws = ws/icount;
 7258: 
 7259:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 7260:    // Splines allow for a smooth transition between vertical levels.
 7261:    // Splines have continuity restrictions at the internal knots, but
 7262:    // we have to provide the 1st derivatives at the endpoints.
 7263:    const int kbs = side->kbs; 
 7264:    
 7265:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7266:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7267:    initCubicSpline(kbs, nvrt, side, ws, up)
 7268: 
 7269:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7270:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7271:    initCubicSpline(kbs, nvrt, side, ws, vp)
 7272: 
 7273:    // Total advection (average onto side)
 7274:    const Node *node1 = side->nodes[0];
 7275:    const Node *node2 = side->nodes[1];
 7276:    for (int k=kbs(i); k<nvrt; k++) {
 7277: 
 7278:       Vector2 bcc1 = node1->bcc[k];
 7279:       Vector2 bcc2 = node2->bcc[k];
 7280:       if constexpr(ics == 2) {
 7281:          // Project the velocities from the node frames to the side frame
 7282:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 7283:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 7284:       }
 7285: 
 7286:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 7287:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 7288: 
 7289:    }
 7290: }
 7291: #endif
 7292: 
 7293: 
 7294: extern "C" {
 7295:    __global__ void computeElemAverageGhat(void) {
 7296:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 7297: 
 7298:       ELEM(elem);
 7299:       
 7300:       elem->ghat1= {0.0, 0.0};  
 7301: 
 7302:       if constexpr(ihydraulics != 0) {
 7303:          if (nhtblocks > 0 && elem->isblock) return;
 7304:       }
 7305: 
 7306:       
 7307:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 7308:       // cff1-3: coefficients for 2D/3D
 7309: 
 7310:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7311:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7312:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 7313: 
 7314:       if (elem->isDry) return;
 7315: 
 7316:       // Average of the coefficients
 7317:       double av_cff1 = 0.0;  // av. for cff1
 7318:       double av_cff2 = 0.0;  // av. for cff2
 7319:       double av_cff3 = 0.0;  // av. for cff3
 7320:       double av_df = 0.0;  // av. for H^\alpha / H
 7321:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7322:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7323: 
 7324:       const int i34 = elem->i34;
 7325:       const int kb  = elem->kb;
 7326: 
 7327:       for (int j=0; j<i34; j++) {
 7328:          // For each node and side in the element...
 7329: 
 7330:          const Node *node = elem->nodes[j];
 7331:          const Side *side = elem->sides[j];
 7332: 
 7333:          const double chi      = side->chi;
 7334:          const double veg_c2   = side->veg_c2;
 7335:          const double veg_beta = side->veg_beta;
 7336:          const double veg_h    = side->veg_h();
 7337:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7338: 
 7339:          const Vector2 gradPhi = elem->gradPhi[j];
 7340: 
 7341:          // Node - const in elem
 7342:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 7343:          elem->gradPr  += node->pr  *gradPhi;
 7344: 
 7345:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 7346: 
 7347:         
 7348:          const double htot  = side->htot2();        // Total depth at the side
 7349:          const double zctr2 = side->zTopCanopy();  
 7350: 
 7351:          double cff1; 
 7352:          double cff2; 
 7353:          double cff3;   
 7354:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7355:          // coefficients applied to 2D/3D case 
 7356:             cff1 = side->hhat/htot;
 7357:             cff2 = 0.0;
 7358:             cff3 = 0.0;
 7359:          } else { //3D
 7360:             //Init for no-veg case
 7361:             cff1 = 1.0;
 7362:             cff2 = 1.0;
 7363:             cff3 = 0.0;
 7364: 
 7365:             if constexpr(iveg != 0) {
 7366:                // Computes coefficients used with vegetation terms G1, G2
 7367:                // cff1, cff3 are used for the first two terms in G1, G2:
 7368:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7369:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7370:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7371:                if(veg_h < 0.99*htot) { // submergent vegetation
 7372:                   cff1 = 1.0;
 7373:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7374:                   cff3 = veg_c;
 7375: 
 7376:                } else { // emergent vegetation
 7377:                   cff1 = 1.0/(1.0 + veg_c2);
 7378:                   cff2 = cff1;
 7379:                   cff3 = 0.0;
 7380: 
 7381:                }
 7382:             } // if iveg
 7383:          } //  2D/3D
 7384: 
 7385:          av_cff1 += cff1/i34;
 7386:          av_cff2 += cff2/i34;
 7387:          av_cff3 += cff3/i34;
 7388:          av_cff2_chi += cff2*chi/i34;
 7389:          av_cff3_chi += cff3*chi/i34;
 7390:          av_df += min(htot, veg_h)/(htot*i34);
 7391: 
 7392: 
 7393:          // btrack values: U^\star, U^{\star\alpha}
 7394:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7395:          Vector2 Ustar       = {0.0, 0.0}; 
 7396:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7397: 
 7398:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7399:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7400:          } else { //3D
 7401:             for (int k = side->kb + 1; k < nvrt; k++) {
 7402:             
 7403:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7404:                Ustar += w2;
 7405: 
 7406:                if constexpr(iveg != 0) {
 7407:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7408:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7409:                        Ustar_alpha += zrat*w2; // XXXX
 7410:                    }
 7411:                }  // if iveg
 7412:             }  // for k
 7413:          }  //2D/3D
 7414: 
 7415:          // If needed, project the side velocities to the element frame
 7416:          if constexpr(ics==2) {
 7417:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 7418:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 7419:          }
 7420:         
 7421: 
 7422:          // Add btrack & surface stress terms to \breve{G} first
 7423:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7424: 
 7425: 
 7426:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 7427:          Vector2 tau    = side->tau();  
 7428:          Vector2 ubstar = side->btu[side->kb + 1];  
 7429: 
 7430:          // If needed, project tau and ubstar to the element frame
 7431:          if constexpr(ics==2) {
 7432:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 7433:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 7434:          }
 7435: 
 7436:          // Term for surface and bottom stress
 7437:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7438: 
 7439: 
 7440:          // All terms in F,F^\alpha,f_b except baroclinic
 7441:          // F, f_b: all explicit terms excluding vegetation 
 7442:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7443:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7444:          const double coriolis = side->coriolis;
 7445:          Vector2 F  =  coriolis*side->U;  // F_x
 7446:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7447:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7448: 
 7449:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7450:             
 7451:             for (int k = side->kb; k < nvrt; k++) {
 7452:                if (zctr2 > side->zc[k-1]) {
 7453:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7454:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7455:                    Fa +=  coriolis*w2*zrat;
 7456:                } // if zctr2
 7457:             } // k
 7458:          } // iveg
 7459: 
 7460:          // Integrate horizontal viscosity force vertically
 7461:          for (int k=side->kb + 1; k<nvrt; k++) {
 7462:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7463: 
 7464:             F += levelHorVisc;
 7465: 
 7466:             // Vegetation term
 7467:             if constexpr(iveg!=0) {
 7468:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7469:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7470:                   Fa += levelHorVisc*zrat;
 7471:                } 
 7472:             } // if iveg
 7473:          } // for k
 7474: 
 7475:          // Get nu*grad(U) at the side's bottom level
 7476:          Vector2 nuGradU = side->nuGradU[side->kb];
 7477: 
 7478:          fb += nuGradU;
 7479: 
 7480:          // If needed, project vectorsF, fb and Fa to the element frame
 7481:          if constexpr(ics==2) {
 7482:             F    = side->frame.projHorVec(F,    elem->frame);
 7483:             fb   = side->frame.projHorVec(fb,   elem->frame);
 7484:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 7485:          } // if ics
 7486: 
 7487:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7488:       } // for j (nodes and sides)
 7489: 
 7490:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7491: 
 7492: 
 7493:       // Finish off terms in F, F^\alpha and f_b
 7494:       const double grav3 = elem->mean(&Node::grav2);
 7495:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7496:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7497:       for (int j=0; j<i34; j++) { 
 7498:          // For each side in the element...
 7499:          const Side *side = elem->sides[j];
 7500:          const double chi = side->chi;
 7501: 
 7502:          const double htot = side->htot2();
 7503:          const double veg_h = side->veg_h();
 7504:          const Vector2 F  = htot*fb;
 7505:          const Vector2 Fa = min(htot, veg_h)*fb;
 7506: 
 7507:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7508:       } // for j
 7509: 
 7510:       // tmp is already in elem frame
 7511:       elem->ghat1 += tmp/i34;
 7512: 
 7513:       // Baroclinic force
 7514:       if constexpr(ibc==0) {
 7515:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7516: 
 7517:          Vector2 Fa = {0.0, 0.0};
 7518:          Vector2 intGradRho = {0.0, 0.0};
 7519:          
 7520:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 7521:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 7522:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7523: 
 7524:             // \in F [m^2/s/s]
 7525:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7526:          }
 7527: 
 7528:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7529:          const Vector2 F = av_df*Fa; //approx
 7530:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7531: 
 7532:       } // if ibc
 7533: 
 7534: 
 7535: 
 7536:    }
 7537: 
 7538: } // extern "C"
 7539: 
 7540: 
 7541: 
 7542: #ifdef DONTCOMPILE
 7543: __global__ void checkMassConservation(Tracers* sumtr) {
 7544: 
 7545:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7546: 
 7547:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7548: 
 7549:    Element *elem = &(mesh->localElemData[i]);
 7550: 
 7551:    // Skip dry elements
 7552:    if (elem->isDry) return;
 7553: 
 7554:    // Local sum array for this thread
 7555:    double localSum[N_TRACERS] = {0.0};
 7556: 
 7557:    // Sum over vertical levels for this element
 7558:    const int kbe = elem->kbe;
 7559:    const double area = elem->area;
 7560: 
 7561:    for (int k = kbe; k < nvrt; k++) {
 7562:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7563:       
 7564:       // Accumulate tracer mass
 7565:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7566:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7567:       }
 7568:    }
 7569: 
 7570:    //  This function returns per element sums. A reduction must be done on the host side.
 7571: }
 7572: 
 7573: 
 7574: __global__ void transport(void) {
 7575: 
 7576:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7577: 
 7578:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7579: 
 7580:    Element *elem = &(mesh->localElemData[ie]);
 7581: 
 7582:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7583: 
 7584:                for (int m=0; m<ntr; m++) {
 7585:                   for (int k=kbe(ie); k<nvrt; k++) {
 7586:                      // Calculate each polynomial's weight 
 7587:                      wm=0.d0; sum1=0.d0; 
 7588:                      wm1=0.d0; wm2=0.d0; 
 7589:                      for (int i=0; i<elem->nweno2; i++) {
 7590:                   
 7591:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7592:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7593:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7594:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7595:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7596:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7597:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7598:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7599:                      // -----------------Hu and Shu (1999)'s method----------------
 7600:                      b4=b1+b2+b3
 7601: 
 7602: //Error: add PRODUCTION CPP
 7603: #ifdef DEBUG
 7604:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7605:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7606:                     call parallel_abort(errmsg)
 7607:                   }
 7608: #endif
 7609: 
 7610:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7611:                   // !----test-------------- 
 7612:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7613:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7614:                   // !wm(i)=wm1(i)*wm2(i)
 7615:                   // !---------------------- 
 7616:                   sum1=sum1+wm(i)
 7617:                 } // end for i
 7618: 
 7619:                 wm=wm/sum1
 7620: 
 7621:                 for (int j=0; j<elem->i34; j++) {
 7622: 
 7623:                   const Side *side  = elem->sides[j];
 7624:                   const Node *node1 = side->n1;
 7625:                   const Node *node2 = side->n2;
 7626: 
 7627:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7628:                      trsd=0.d0
 7629:                      for (int kk=0; kk<nquad; kk++) {
 7630:                         for (int i=0; i<elem->nweno2; i++) {
 7631:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7632:                         } // end for i   
 7633:                      } // end for kk
 7634:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7635:                   } // outward flux
 7636:                } // end for j=1,i34(ie) ! side
 7637:             }
 7638:          }
 7639:               
 7640: 
 7641: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7642: //             //   calculate each polynomial's weight 
 7643: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7644: //                 wm=0.d0; sum1=0.d0
 7645: //                 do i=1,nweno1(ie) !for each polynomial
 7646: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7647: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7648: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7649: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7650: //                   wm(i)=b2
 7651: //                   sum1=sum1+b2
 7652: //                   !wm(i)=1.d0
 7653: //                   !sum1=sum1+1.d0
 7654: 
 7655: // // Error: PRODUCTION
 7656: // #ifdef DEBUG
 7657: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7658: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7659: //                     call parallel_abort(errmsg)
 7660: //                   endif
 7661: // #endif
 7662: 
 7663: //                 enddo !i
 7664: //                 wm=wm/sum1 !final weight
 7665: 
 7666:                 for (int j=0; j<elem->i34; j++) { // side
 7667:                   const Side *side = elem->sides[j];
 7668:                   const Node *node1 = side->n1;
 7669:                   const Node *node2 = side->n2;
 7670: 
 7671:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7672:                     trsd=0.d0
 7673:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7674:                       for (int i=0; i<elem->nweno1; i++) {
 7675:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7676:                       }
 7677:                     enddo //kk
 7678:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7679:                   } // outward flux
 7680:                 } // end for j=1,i34(ie) ! side
 7681:               } // end for k; ntr 
 7682: 
 7683:             else !simple upwind method
 7684:               do j=1,i34(ie)
 7685:                 jsj=elside(j,ie)
 7686:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7687:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7688:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7689:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7690:                   endif
 7691:                 enddo  !vertical layers
 7692:               enddo !j=1,i34(ie) ! side
 7693:             endif !order of accuracy
 7694: 
 7695:          //  enddo !ie
 7696: // !$OMP     end do
 7697: 
 7698: // !$OMP     master
 7699: //           !message passing
 7700: //           if (nproc>1) then
 7701: //             !make a copy of side concentrations
 7702: //             trsd_tmp0=trsd_tmp 
 7703: 
 7704: //             !this exchange routine swaps interface concentration between two partitions
 7705: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 7706: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 7707: 
 7708: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 7709: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 7710: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 7711: 
 7712: 
 7713: //             !This obtains final values for interface sides
 7714: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 7715: //       :    endif !nproc>1
 7716: //           !message passing end
 7717: // !$OMP     end master
 7718: // !$OMP     barrier
 7719: 
 7720: 
 7721: // !         Do advection; conc @ dry elem will not be changed
 7722: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 7723: // !$OMP     do reduction(+: h_mass_in)
 7724: //           do i=1,ne
 7725: //             if(idry_e(i)==1) cycle
 7726: 
 7727: 
 7728: // !           Wet elements with 3 wet nodes
 7729: //             do k=kbe(i)+1,nvrt
 7730: 
 7731: 
 7732: //               bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 7733: //               dtb_by_bigv = dtb/bigv
 7734:     
 7735: // !             Advective flux
 7736: //               if (ntd_weno==1 .or. itd_weno==1) then
 7737: //                 adv_tr(1:ntr)=trel_tmp(1:ntr,k,i) 
 7738: //               else
 7739: //                 adv_tr(1:ntr)=(1.d0-rk_coef(itd_weno))*trel_tmp0(1:ntr,k,i)+rk_coef(itd_weno)*trel_tmp(1:ntr,k,i) 
 7740: //               endif
 7741: 
 7742: //               !psum=0.d0 !sum of modified fluxes for all inflow bnds
 7743: //               do j=1,i34(i)
 7744: //                 jsj=elside(j,i) !side
 7745: //                 iweno=.true. !use weno reconstruction as default
 7746: //                 iel=ic3(j,i) !neighboring elem
 7747: 
 7748: //                 if(iel/=0) then
 7749: //                   if(idry_e(iel)==1) cycle
 7750: //                   trel_tmp_outside(:)=trel_tmp(:,k,iel)
 7751: //                   !reset to upwind; if Element i uses ELM, it will be overwritten by ELM value eventually
 7752: //                   if(iupwind_e(i)+iupwind_e(iel)>0) then
 7753: //                     iweno=.false.
 7754: //                   endif
 7755: //                 else !land or open bnd side
 7756: //                   !skip land bnd and outflowing open bnd, 
 7757: //                   !in this case iweno is not changed from initial value (.true.), but won't be used
 7758: //                   if(isbs(jsj)<=0.or.k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)>=0.d0) then
 7759: //                     !For outflow open bnd side, estimate mass in (open
 7760: //                     !side cannot be interface side)
 7761: //                     if(max_iadjust_mass_consv>0.and.isbs(jsj)>0) then !outflow @open bnd
 7762: //                       h_mass_in(:)=h_mass_in(:)-trel_tmp(1:ntr,k,i)*flux_adv_hface(k,jsj)*dtb
 7763: //                     endif
 7764: 
 7765: //                     cycle
 7766: //                   endif
 7767: 
 7768: //                   !Open bnd side with inflow (must be wet elem) or k<kbs(jsj)+1
 7769: //                   iweno=.false.  !reset to upwind
 7770: //                   ibnd=isbs(jsj) !global bnd #
 7771: //                   !Find node indices on bnd segment for the 2 nodes (for type 4 b.c.)
 7772: //                   nwild(1:2)=0
 7773: //                   do ll=1,2 !nodes
 7774: //                     ndo=isidenode(ll,jsj)
 7775: //                     do lll=1,2 !2 possible bnds
 7776: //                       if(isbnd(lll,ndo)==ibnd) then
 7777: //                         nwild(ll)=isbnd(-lll,ndo) !global index
 7778: //                         exit
 7779: //                       endif
 7780: //                     enddo !lll
 7781: //                   enddo !ll
 7782: //                   ind1=nwild(1); ind2=nwild(2);
 7783: 
 7784: //                   do jj=1,natrm
 7785: //                     if(ntrs(jj)<=0) cycle
 7786: 
 7787: //                     if(itrtype(jj,ibnd)==0) then !set to be same as interior (so cancel out below)
 7788: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7789: //                         trel_tmp_outside(ll)=trel_tmp(ll,k,i)
 7790: //                       enddo !ll
 7791: //                     else if(itrtype(jj,ibnd)==1.or.itrtype(jj,ibnd)==2) then
 7792: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7793: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)*trth(ll,1,1,ibnd)+(1-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 7794: //                       enddo !ll
 7795: //                     else if(itrtype(jj,ibnd)==3) then
 7796: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7797: //                         tmp=sum(tr_nd0(ll,k,elnode(1:i34(i),i))+tr_nd0(ll,k-1,elnode(1:i34(i),i)))/2.d0/real(i34(i),rkind)
 7798: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)*tmp+(1.d0-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 7799: //                       enddo !ll
 7800: //                     else if(itrtype(jj,ibnd)==4) then
 7801: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7802: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)* &
 7803: //        &(trth(ll,k,ind1,ibnd)+trth(ll,k,ind2,ibnd)+trth(ll,k-1,ind1,ibnd)+trth(ll,k-1,ind2,ibnd))/4.d0+ &
 7804: //        &(1.d0-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 7805: //                       enddo !ll
 7806: //                     else
 7807: //                       write(errmsg,*)'TRASNPORT: INVALID VALUE FOR ITRTYPE:',jj,ibnd
 7808: //   !'
 7809: //                       call parallel_abort(errmsg)
 7810: //                     endif !itrtype
 7811: 
 7812: //                   enddo !jj
 7813: 
 7814: //                   !Tally horizontal mass in for inflow case
 7815: //                   if(max_iadjust_mass_consv>0) h_mass_in(:)=h_mass_in(:)-trel_tmp_outside(1:ntr)*flux_adv_hface(k,jsj)*dtb
 7816: //                 endif !iel
 7817: 
 7818: //                 !!upwind part
 7819: //                 !if(k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)<0) then !inflow
 7820: //                 !  do jj=1,ntr
 7821: //                 !    adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*abs(flux_adv_hface(k,jsj))*(trel_tmp_outside(jj)-trel_tmp(jj,k,i))
 7822: //                 !  enddo
 7823: //                 !endif
 7824: //                 !!weno correction
 7825: //                 !if (iweno) then
 7826: //                 !  if(k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)<0) then !inflow
 7827: //                 !    do jj=1,ntr
 7828: //                 !      adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*abs(flux_adv_hface(k,jsj))*(trsd_tmp(jj,k,jsj)-trel_tmp_outside(jj))
 7829: //                 !    enddo
 7830: //                 !  else if(k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)>=0) then !outflow
 7831: //                 !    do jj=1,ntr
