 6745: #ifdef DONTCOMPILE
 6746: __device__ void computeVerticalAdvection(void) {
 6747:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6748: 
 6749:    sdbt(1:2,:,:)=0.d0
 6750: 
 6751:    const Side *side = FROM kernel;
 6752: 
 6753:    if(side->isDry) return;
 6754: 
 6755:    // If side is wet...
 6756: 
 6757: 
 6758:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6759:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6760:    double ws[nvrt] = {} // w @ side
 6761:    int icount = 0;
 6762:    for (int j=0; j<2; j++) {
 6763:       const Element *elem = side->elements[j];
 6764:        
 6765:       if(elem != nullptr) {
 6766:          icount++;
 6767:          for (int k=0; k<nvrt; k++) {
 6768:             ws[k] = ws[k] + elem->w[k];
 6769:          }
 6770:       }
 6771:    }  // for j
 6772: 
 6773:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6774:    ws = ws/icount;
 6775: 
 6776:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6777:    // Splines allow for a smooth transition between vertical levels.
 6778:    // Splines have continuity restrictions at the internal knots, but
 6779:    // we have to provide the 1st derivatives at the endpoints.
 6780:    const int kbs = side->kbs; 
 6781:    
 6782:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6783:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6784:    initCubicSpline(kbs, nvrt, side, ws, up)
 6785: 
 6786:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6787:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6788:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6789: 
 6790:    // Total advection (average onto side)
 6791:    const Node *node1 = side->nodes[0];
 6792:    const Node *node2 = side->nodes[1];
 6793:    for (int k=kbs(i); k<nvrt; k++) {
 6794: 
 6795:       if constexpr(ics==1) {
 6796:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6797:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6798:       } else {
 6799:          // XXX IMPLEMENT THIS
 6800:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6801:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6802:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6803:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6804:       }  // if ics
 6805: 
 6806: 
 6807:    }
 6808: }
 6809: #endif
 6810: 
 6811: 
 6812: extern "C" {
 6813:    __global__ void computeElemAverageGhat(void) {
 6814:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6815: 
 6816:       ELEM(elem);
 6817:       
 6818:       elem->ghat1= {0.0, 0.0};  
 6819: 
 6820:       if constexpr(ihydraulics != 0) {
 6821:          if (nhtblocks > 0 && elem->isblock) return;
 6822:       }
 6823: 
 6824:       if (elem->isDry) return;
 6825: 
 6826:       // Wet elements.
 6827:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6828:       // tidal potential, horizontal diffusion, and baroclinic etc
 6829:       // Remember to update both fb and F 
 6830:       // If ics=2, ghat1 are in eframe (ll)
 6831:       // cff1-3: coefficients for 2D/3D
 6832:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6833:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6834:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6835: 
 6836:       double av_cff1 = 0.0;  // av. for cff1
 6837:       double av_cff2 = 0.0;  // av. for cff2
 6838:       double av_cff3 = 0.0;  // av. for cff3
 6839:       double av_df = 0.0;  // av. for H^\alpha / H
 6840:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6841:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6842: 
 6843:       const int i34 = elem->i34;
 6844:       const int kb = elem->kb;
 6845: 
 6846:       for (int j=0; j<i34; j++) {
 6847:          // For each node and side in the element...
 6848: 
 6849:          const Node *node = elem->nodes[j];
 6850:          const Side *side = elem->sides[j];
 6851: 
 6852:          const double chi      = side->chi;
 6853:          const double veg_c2   = side->veg_c2;
 6854:          const double veg_beta = side->veg_beta;
 6855:          const double veg_h    = side->veg_h();
 6856:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6857: 
 6858:          // Node - const in elem
 6859:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6860:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6861: 
 6862:          if (elem->depth >= tip_dp) {
 6863:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6864:          }
 6865: 
 6866:          
 6867:          const double htot  = side->htot2();        // Total depth at the side
 6868:          const double zctr2 = side->zTopCanopy();  
 6869: 
 6870:          double cff1; 
 6871:          double cff2; 
 6872:          double cff3;   
 6873:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6874:          // coefficients applied to 2D/3D case 
 6875:             cff1 = side->hhat/htot;
 6876:             cff2 = 0.0;
 6877:             cff3 = 0.0;
 6878:          } else { //3D
 6879:             //Init for no-veg case
 6880:             cff1 = 1.0;
 6881:             cff2 = 1.0;
 6882:             cff3 = 0.0;
 6883: 
 6884:             if constexpr(iveg != 0) {
 6885:                // Computes coefficients used with vegetation terms G1, G2
 6886:                // cff1, cff3 are used for the first two terms in G1, G2:
 6887:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6888:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6889:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6890:                if(veg_h < 0.99*htot) { // submergent vegetation
 6891:                   cff1=1;
 6892:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6893:                   cff3 = veg_c;
 6894: 
 6895:                } else { // emergent vegetation
 6896:                   cff1 = 1.0/(1.0 + veg_c2);
 6897:                   cff2 = cff1;
 6898:                   cff3 = 0.0;
 6899: 
 6900:                }
 6901:             } // if iveg
 6902:          } //  2D/3D
 6903: 
 6904:          av_cff1 += cff1/i34;
 6905:          av_cff2 += cff2/i34;
 6906:          av_cff3 += cff3/i34;
 6907:          av_cff2_chi += cff2*chi/i34;
 6908:          av_cff3_chi += cff3*chi/i34;
 6909:          av_df += min(htot, veg_h)/(htot*i34);
 6910: 
 6911: 
 6912:          // btrack values: U^\star, U^{\star\alpha}
 6913:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6914:          Vector2 Ustar       = {0.0, 0.0}; 
 6915:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6916: 
 6917:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6918:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6919:          } else { //3D
 6920:             for (int k = side->kb; k < nvrt; k++) {
 6921:             
 6922:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6923:                Ustar += w2;
 6924: 
 6925:                if constexpr(iveg != 0) {
 6926:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6927:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6928:                        Ustar_alpha += zrat*w2; // XXXX
 6929:                    }
 6930:                }  // if iveg
 6931:             }  // for k
 6932:          }  //2D/3D
 6933:          
 6934: 
 6935:          // Add btrack & surface stress terms to \breve{G} first
 6936:          if constexpr(ics==1) {
 6937: 
 6938:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6939: 
 6940:          } else {
 6941:             // XXX IMPLEMENT THIS
 6942:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6943:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6944:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6945:          }  // if ics
 6946: 
 6947:          // Surface and bottom stress terms
 6948:          if constexpr(ics==1) {
 6949:             const Vector2 tau    = side->tau();
 6950:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6951: 
 6952:             // Term for surface and bottom stress
 6953:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6954: 
 6955:          } else {
 6956:             assert(false && "computeElemAverageGhat: Not implemented");
 6957:             // XXX IMPLEMENT THIS
 6958:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6959:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6960:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6961:             // tau_x=(vn1+tt1)/2.d0
 6962:             // tau_y=(vn2+ss1)/2.d0
 6963:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6964:          }  // if ics
 6965: 
 6966:          
 6967: 
 6968:          // All terms in F,F^\alpha,f_b except baroclinic
 6969:          // F, f_b: all explicit terms excluding vegetation 
 6970:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6971:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6972:          const double coriolis = side->coriolis;
 6973:          Vector2 F  =  coriolis*side->U;  // F_x
 6974:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6975:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6976: 
 6977:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6978:             
 6979:             for (int k = side->kb; k < nvrt; k++) {
 6980:                if (zctr2 > side->zc[k-1]) {
 6981:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6982:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6983:                    Fa +=  coriolis*w2*zrat;
 6984:                } // if zctr2
 6985:             } // k
 6986:          } // iveg
 6987: 
 6988:          // Integrate horizontal viscosity force vertically
 6989:          for (int k=side->kb + 1; k<nvrt; k++) {
 6990:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6991: 
 6992:             F += levelHorVisc;
 6993: 
 6994:             // Vegetation term
 6995:             if constexpr(iveg!=0) {
 6996:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6997:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6998:                   Fa += levelHorVisc*zrat;
 6999:                } 
 7000:             } // if iveg
 7001:          } // for k
 7002: 
 7003:          fb += side->nuGradU[side->kb];
 7004: 
 7005:          // Add to ghat1
 7006:          if constexpr(ics==2) {
 7007:             // XXX IMPLEMENT THIS
 7008:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7009:             // bigf1=vn1; bigf2=vn2
 7010:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7011:             // botf1=vn1; botf2=vn2
 7012:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7013:             // bigfa1=vn1; bigfa2=vn2
 7014:          } // if ics
 7015: 
 7016:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7017:       } // for j (nodes and sides)
 7018: 
 7019:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7020:          
 7021:       // Finish off terms in F, F^\alpha and f_b
 7022:       const double grav3 = elem->mean(&Node::grav2);
 7023:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7024: 
 7025: 
 7026:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7027:       for (int j=1; j<i34; j++) { 
 7028:          // For each side in the element...
 7029:          const Side *side = elem->sides[j];
 7030:          const double chi = side->chi;
 7031: 
 7032:          const double htot = side->htot2();
 7033:          const double veg_h = side->veg_h();
 7034:          const Vector2 F  = htot*fb;
 7035:          const Vector2 Fa = min(htot, veg_h)*fb;
 7036: 
 7037:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7038:       } // for j
 7039: 
 7040:       //botf1 etc are already in elem frame
 7041:       elem->ghat1 += tmp/i34;
 7042: 
 7043:       // Baroclinic force
 7044:       if constexpr(ibc==0) {
 7045:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7046: 
 7047:          Vector2 Fa = {0.0, 0.0};
 7048:          Vector2 intGradRho = {0.0, 0.0};
 7049:          
 7050:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 7051:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 7052:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7053: 
 7054:             // \in F [m^2/s/s]
 7055:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7056:          }
 7057: 
 7058:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7059:          const Vector2 F = av_df*Fa; //approx
 7060:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7061: 
 7062:       } // if ibc
 7063: 
 7064: 
 7065: 
 7066:    }
 7067: 
 7068: } // extern "C"
 7069: 
 7070: 
 7071: 
 7072: #ifdef DONTCOMPILE
 7073: __global__ void checkMassConservation(Tracers* sumtr) {
 7074: 
 7075:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7076: 
 7077:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7078: 
 7079:    Element *elem = &(mesh->localElemData[i]);
 7080: 
 7081:    // Skip dry elements
 7082:    if (elem->isDry) return;
 7083: 
 7084:    // Local sum array for this thread
 7085:    double localSum[N_TRACERS] = {0.0};
 7086: 
 7087:    // Sum over vertical levels for this element
 7088:    const int kbe = elem->kbe;
 7089:    const double area = elem->area;
 7090: 
 7091:    for (int k = kbe; k < nvrt; k++) {
 7092:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7093:       
 7094:       // Accumulate tracer mass
 7095:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7096:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7097:       }
 7098:    }
 7099: 
 7100:    //  This function returns per element sums. A reduction must be done on the host side.
 7101: }
 7102: 
 7103: 
 7104: __global__ void transport(void) {
 7105: 
 7106:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7107: 
 7108:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7109: 
 7110:    Element *elem = &(mesh->localElemData[ie]);
 7111: 
 7112:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7113: 
 7114:                for (int m=0; m<ntr; m++) {
 7115:                   for (int k=kbe(ie); k<nvrt; k++) {
 7116:                      // Calculate each polynomial's weight 
 7117:                      wm=0.d0; sum1=0.d0; 
 7118:                      wm1=0.d0; wm2=0.d0; 
 7119:                      for (int i=0; i<elem->nweno2; i++) {
 7120:                   
 7121:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7122:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7123:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7124:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7125:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7126:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7127:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7128:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7129:                      // -----------------Hu and Shu (1999)'s method----------------
 7130:                      b4=b1+b2+b3
 7131: 
 7132: //Error: add PRODUCTION CPP
 7133: #ifdef DEBUG
 7134:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7135:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7136:                     call parallel_abort(errmsg)
 7137:                   }
 7138: #endif
 7139: 
 7140:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7141:                   // !----test-------------- 
 7142:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7143:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7144:                   // !wm(i)=wm1(i)*wm2(i)
 7145:                   // !---------------------- 
 7146:                   sum1=sum1+wm(i)
 7147:                 } // end for i
 7148: 
 7149:                 wm=wm/sum1
 7150: 
 7151:                 for (int j=0; j<elem->i34; j++) {
 7152: 
 7153:                   const Side *side  = elem->sides[j];
 7154:                   const Node *node1 = side->n1;
 7155:                   const Node *node2 = side->n2;
 7156: 
 7157:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7158:                      trsd=0.d0
 7159:                      for (int kk=0; kk<nquad; kk++) {
 7160:                         for (int i=0; i<elem->nweno2; i++) {
 7161:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7162:                         } // end for i   
 7163:                      } // end for kk
 7164:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7165:                   } // outward flux
 7166:                } // end for j=1,i34(ie) ! side
 7167:             }
 7168:          }
 7169:               
 7170: 
 7171: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7172: //             //   calculate each polynomial's weight 
 7173: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7174: //                 wm=0.d0; sum1=0.d0
 7175: //                 do i=1,nweno1(ie) !for each polynomial
 7176: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7177: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7178: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7179: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7180: //                   wm(i)=b2
 7181: //                   sum1=sum1+b2
 7182: //                   !wm(i)=1.d0
 7183: //                   !sum1=sum1+1.d0
 7184: 
 7185: // // Error: PRODUCTION
 7186: // #ifdef DEBUG
 7187: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7188: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7189: //                     call parallel_abort(errmsg)
 7190: //                   endif
 7191: // #endif
 7192: 
 7193: //                 enddo !i
 7194: //                 wm=wm/sum1 !final weight
 7195: 
 7196:                 for (int j=0; j<elem->i34; j++) { // side
 7197:                   const Side *side = elem->sides[j];
 7198:                   const Node *node1 = side->n1;
 7199:                   const Node *node2 = side->n2;
 7200: 
 7201:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7202:                     trsd=0.d0
 7203:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7204:                       for (int i=0; i<elem->nweno1; i++) {
 7205:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7206:                       }
 7207:                     enddo //kk
 7208:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7209:                   } // outward flux
 7210:                 } // end for j=1,i34(ie) ! side
 7211:               } // end for k; ntr 
 7212: 
 7213:             else !simple upwind method
 7214:               do j=1,i34(ie)
 7215:                 jsj=elside(j,ie)
 7216:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7217:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7218:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7219:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7220:                   endif
 7221:                 enddo  !vertical layers
 7222:               enddo !j=1,i34(ie) ! side
 7223:             endif !order of accuracy
 7224: 
 7225:          //  enddo !ie
 7226: // !$OMP     end do
 7227: 
 7228: // !$OMP     master
 7229: //           !message passing
 7230: //           if (nproc>1) then
 7231: //             !make a copy of side concentrations
 7232: //             trsd_tmp0=trsd_tmp 
 7233: 
 7234: //             !this exchange routine swaps interface concentration between two partitions
 7235: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
