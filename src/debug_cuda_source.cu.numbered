  571: struct Element {
  572: 
  573:    // Geometry information
  574:    int idx;                   // Index of the element
  575:    int i34;                   // Number of sides for the element 
  576:    Side *sides[4];            // Sides of the element
  577:    Node *nodes[4];            // Nodes of the element
  578:    Element *nghbElems[4];     // Neighbors of the element
  579: 
  580:    int kb;                    // Bottom index of the element
  581:    double area;               // Area of the element
  582:    double ssign[4];           // Sign associated with each side of an element
  583:    double radius;             // Element equivalent radii
  584: 
  585:    #ifdef USE_FRAMES
  586:    Frame frame;
  587:    #endif
  588: 
  589:    Vector2 gradPhi[4];        // Derivatives of shape functions
  590:    Vector2 gradEta;           // Gradient of free surface elevation
  591:    Vector2 gradPr;            // Gradient of pressure    
  592:    Vector2 gradETP;           // Gradient of Earth Tidal Potential    XXXXX Really used?
  593: 
  594:    bool isDry;                // True if the element is dry
  595: 
  596:    Point2 center;            // Element center coordinates
  597: 
  598: 
  599:    double depth;              // Depth at element (min of all nodes)
  600:    double z[nvrt];            // z-coord  (local frame - vertical up)
  601: 
  602:    // Physical information
  603:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  604: 
  605:    static const bool isblock = false;              // Always false
  606: 
  607:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  608:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  609: 
  610:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  611:    
  612: 
  613:    double vsource;            // Volumetric source/sink term [m^3/s]
  614: 
  615:    double rho[nvrt];          // Density at each prism center
  616:    double rho_mean[nvrt];     // Mean density at each prism center
  617:    CubicSpline rho_spl;
  618:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  619:    double rho_z[nvrt];        // First derivative of density at each prism center
  620:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  621:    
  622: 
  623:    __inline__ __device__ Point2 outputCoords(void) const;
  624: 
  625:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  626: 
  627:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  628:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  629: 
  630:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  631:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  632: 
  633:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  634:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  635:       // Find the local index of the node in the element (0,1,2,3)
  636:       int res = __ffs((nodes[0] == node) | 
  637:                      ((nodes[1] == node) << 1) | 
  638:                      ((nodes[2] == node) << 2) | 
  639:                      ((nodes[3] == node) << 3)) - 1;
  640:       
  641:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  642:       return res;  
  643:    }
  644: 
  645:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  646:       // Find the local index of the side in the element (0,1,2,3)
  647:       int res = __ffs((sides[0] == side) | 
  648:                      ((sides[1] == side) << 1) | 
  649:                      ((sides[2] == side) << 2) | 
  650:                      ((sides[3] == side) << 3)) - 1;
  651:       
  652:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  653:       return res;
  654:    }
  655: 
  656:    __inline__ __device__ int findLevel(double z1, int k) const {
  657:       // Starting at index k, find sequentially the level that contains z
  658: 
  659:       // For testing purposes, forgets k and performs a full search.
  660:       for (k = kb; k < nvrt - 1; k++) {
  661:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
  662:       }
  663:       return nvrt - 2;
  664: 
  665: 
  666:       // if z is already betweeen z[k] and z[k+1], return k
  667:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
  668:       else if (z1 <  z[k]) { 
  669:          // Search for increasing levels
  670:          for (int kk = k; kk < nvrt - 1; kk++) {
  671:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  672:          }
  673:          return nvrt - 1;
  674:       }
  675:       else {
  676:          // Search for decreasing levels
  677:          for (int kk = k; kk >= kb; kk--) {
  678:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  679:          }
  680:          return 0;
  681:       }
  682:    }
  683: 
  684:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
  685:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
  686: 
  687: 
  688:    __device__ __forceinline__ double centerZ(void) const;
  689: 
  690:    // "Local" horizontal coordinates at the nodes. They are computed from the 3D global node coordinates. For ics == 1 and 2
  691:    // Local is in quotes because for ics == 1, the coordinates are unchanged. It just means that in these coordinates, the element is horizontal.
  692:    __device__ __forceinline__ Point2 getLocalHorizontalNodePosition(int idxNode) const;
  693:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2, int idx = 0) const;
  694:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const;
  695: 
  696: 
  697:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idxNode = 0,1,2,3)
  698:    __device__ __forceinline__ Point2 GaussPoint(int idxNode) const {
  699:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
  700:        assert(idxNode >= 0 && idxNode < 4 && "GaussPoint: idxNode out of range");
  701:        const double eta = (idxNode & 1) ? +g : -g;
  702:        const double xi  = (idxNode & 2) ? +g : -g;
  703:        return {eta, xi};
  704:    }  
  705: 
  706:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  707:    __device__ __forceinline__ double etaSign(int idxNode) const {
  708:       // bit1: 0 -> -1, 1 -> +1
  709:       assert(idxNode >= 0 && idxNode < 4 && "etaSign: idxNode out of range");
  710:       return (idxNode & 2) ? 1.0 : -1.0;     // [-1,-1,+1,+1]
  711:    }
  712: 
  713:    __device__ __forceinline__ double xiSign(int idxNode) const {
  714:       // +1 if (bit0 XOR bit1), else -1
  715:       assert(idxNode >= 0 && idxNode < 4 && "xiSign: idxNode out of range");
  716:       return ((idxNode & 1) ^ (idxNode >> 1)) ? 1.0 : -1.0;   // [-1,+1,+1,-1]
  717: 
  718:    }
  719: 
  720:    // Shape function Phi at a given point p = (eta,xi), idxNode = node index 0,1,2,3
  721:    __device__ __forceinline__ double Phi(int idxNode, Point2 p) const {
  722:       return 0.25*(1.0 + p.x*etaSign(idxNode))*(1.0 + p.y*xiSign(idxNode));
  723:    }
  724: 
  725:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi)
  726:    __device__ __forceinline__ double dPhi_dxi(int idxNode, Point2 p) const {
  727:       return 0.25*xiSign(idxNode)*(1.0 + p.x*etaSign(idxNode));
  728:    }   
  729: 
  730:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
  731:    __device__ __forceinline__ double dPhi_deta(int idxNode, Point2 p) const {
  732:       return 0.25*(1.0 + p.y*xiSign(idxNode))*etaSign(idxNode);
  733:    }      
  734:    
  735:    __inline__ __device__ double detJ_eta(void) const;
  736: 
  737:    __inline__ __device__ double detJ_xi(void) const;
  738: 
  739:    __inline__ __device__ double jacobianDet(Point2 p) const { return area/4.0 + detJ_eta()*p.x + detJ_xi()*p.y; }
  740: 
  741:    // Check if the element is dry using the more up-to-date elevation.
  742:    __inline__ __device__ bool isDry2(void) const;
  743: 
  744:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  745: 
  746:    __inline__ __device__ double computeSignedArea(void) const;
  747: 
  748:    __inline__ __device__ void nudgeToBarycenter(Point2 &p, const Side *origSide = nullptr) const;
