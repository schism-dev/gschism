 1859: __device__ void lock(int *mutex) {
 1860:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 1861: }
 1862: 
 1863: __device__ void unlock(int *mutex) {
 1864:     atomicExch(mutex, 0);
 1865: }
