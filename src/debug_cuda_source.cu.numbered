  992: struct Element {
  993: 
  994:    // Geometry information
  995:    int idx;                   // Index of the element
  996:    int16_t i34;               // Number of sides for the element 
  997:    Side *sides[4];            // Sides of the element
  998:    Node *nodes[4];            // Nodes of the element
  999:    Element *nghbElems[4];     // Neighbors of the element
 1000: 
 1001:    int16_t kb;                // Bottom index of the element
 1002:    double area;               // Area of the element
 1003:    double ssign[4];           // Sign associated with each side of an element
 1004:    double radius;             // Element equivalent radii
 1005: 
 1006:    Frame<ics> frame;
 1007: 
 1008:    Vector2 gradPhi[4];        // Derivatives of shape functions
 1009:    Vector2 gradEta;           // Gradient of free surface elevation
 1010:    Vector2 gradPr;            // Gradient of pressure    
 1011:    Vector2 gradETP;           // Gradient of Earth Tidal Potential    XXXXX Really used?
 1012: 
 1013:    bool isDry;                // True if the element is dry
 1014: 
 1015:    Point2 center;            // Element center coordinates (global coordinates)
 1016: 
 1017:    double depth;              // Depth at element (min of all nodes)
 1018:    double z[nvrt];            // z-coord  (local frame - vertical up)
 1019: 
 1020:    // Physical information
 1021:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
 1022: 
 1023:    static const bool isblock = false;              // Always false
 1024: 
 1025:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
 1026:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
 1027: 
 1028:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
 1029:    
 1030: 
 1031:    double vsource;            // Volumetric source/sink term [m^3/s]
 1032: 
 1033:    double rho[nvrt];          // Density at each prism center
 1034:    double rho_mean[nvrt];     // Mean density at each prism center
 1035:    CubicSpline rho_spl;
 1036:    double rho_zz[nvrt];       // Second derivative of density at each prism center
 1037:    double rho_z[nvrt];        // First derivative of density at each prism center
 1038:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
 1039:    
 1040: 
 1041:    __inline__ __device__ Point2 outputCoords(void) const;
 1042: 
 1043:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }  
 1044: 
 1045:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1046:    // If ics == 2, convert the global point to the local frame of the element
 1047:       
 1048:       if constexpr (ics == 1) {
 1049:          return p;
 1050:       } else {
 1051:          const Point3 c = {center.x, center.y, centerZ()};
 1052:          return frame.G2L(p - c);
 1053:       }
 1054:    }
 1055: 
 1056:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1057:    // If ics == 2, convert the local point to a global point
 1058:       
 1059:       if constexpr (ics == 1) {
 1060:          return p;
 1061:       } else {
 1062:          const Point3 c = {center.x, center.y, centerZ()};
 1063:          return c + frame.L2G(p);
 1064:       }
 1065:    }
 1066: 
 1067:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
 1068:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
 1069: 
 1070:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
 1071:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
 1072: 
 1073:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
 1074:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
 1075:       // Find the local index of the node in the element (0,1,2,3)
 1076:       int res = __ffs((nodes[0] == node) | 
 1077:                      ((nodes[1] == node) << 1) | 
 1078:                      ((nodes[2] == node) << 2) | 
 1079:                      ((nodes[3] == node) << 3)) - 1;
 1080:       
 1081:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
 1082:       return res;  
 1083:    }
 1084: 
 1085:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
 1086:       // Find the local index of the side in the element (0,1,2,3)
 1087:       int res = __ffs((sides[0] == side) | 
 1088:                      ((sides[1] == side) << 1) | 
 1089:                      ((sides[2] == side) << 2) | 
 1090:                      ((sides[3] == side) << 3)) - 1;
 1091:       
 1092:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
 1093:       return res;
 1094:    }
 1095: 
 1096:    __inline__ __device__ int findLevel(double z1, int k) const {
 1097:       // Starting at index k, find sequentially the level that contains z
 1098: 
 1099:       // For testing purposes, forgets k and performs a full search.
 1100:       for (k = kb; k < nvrt - 1; k++) {
 1101:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
 1102:       }
 1103:       return nvrt - 2;
 1104: 
 1105: 
 1106:       // if z is already betweeen z[k] and z[k+1], return k
 1107:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
 1108:       else if (z1 <  z[k]) { 
 1109:          // Search for increasing levels
 1110:          for (int kk = k; kk < nvrt - 1; kk++) {
 1111:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
 1112:          }
 1113:          return nvrt - 1;
 1114:       }
 1115:       else {
 1116:          // Search for decreasing levels
 1117:          for (int kk = k; kk >= kb; kk--) {
 1118:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
 1119:          }
 1120:          return 0;
 1121:       }
 1122:    }
 1123: 
 1124:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
 1125:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
