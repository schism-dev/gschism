 2529: 
 2530: __device__ double Node::compZCoord(int k) const {
 2531:    // Computes the z coordinate at level k.
 2532:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2533:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2534:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2535:    // used 
 2536:    
 2537:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2538:       
 2539:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2540: 
 2541:    if constexpr(ivcor == 2) {
 2542: 
 2543:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2544:       const int kz = mesh->kz;
 2545:       const double h_c = mesh->h_c;
 2546:       const double theta_f = mesh->theta_f;
 2547:       const double sinh_theta_f = mesh->sinh_theta_f;
 2548: 
 2549:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2550:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2551:       // once per time step/node.
 2552:       // CHECK: updateZCoordData
 2553: 
 2554:       if      (k == nvrt-1)      { return eta2; }
 2555:       else if (k == kz)          return -hmod2;
 2556:       else if (k == kb)          return -depth;
 2557:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2558:       else if (k > kz) {
 2559:          const int ksig = k - kz + 1;
 2560: 
 2561:          if (hmod2 <= h_c) {
 2562:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2563:          } 
 2564:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2565:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2566:             assert(false && "ZCOOR: invalid h_c\n");
 2567:          } 
 2568:          else {
 2569:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2570:                          h_c * mesh->sigma[ksig] + 
 2571:                          (hmod2 - h_c) * mesh->cs[ksig];
 2572:          }
 2573:       } else { 
 2574:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2575:       }
 2576: 
 2577:    }
 2578:    else if constexpr(ivcor == 1) {
 2579:       if (k == kb) return -depth;
 2580:       else if (k == nvrt-1) return eta2;
 2581:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2582:    }
 2583:    
 2584:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2585:    return 0.0;
 2586: }
 2587: 
 2588: 
 2589: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2590:                 double *node_coords, double *wind_rotate_angle, 
 2591:                 int *isdel, int *isidenode, int *isbnd,
 2592:                 int *nond, int *nlnd, int *iond, int *ilnd,
 2593:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2594:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2595:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2596:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2597:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 2598:                 double *emo, double *efa, 
 2599:                 double *umo, double *ufa, 
 2600:                 double *vmo, double *vfa) {
 2601: 
 2602:    printf("Populating mesh for partition %d\n", partNum);
 2603: 
 2604:    // Horizontal grid
 2605:    printf("Processing %d nodes\n", np);    
 2606: 
 2607: 
 2608:    int idxNodeBoundary = 0;  
 2609:    for (int i = 0; i < np; i++)
 2610:    {
 2611:       Node &node = localNodeData[i];
 2612: 
 2613:       node.idx = i;
 2614: 
 2615:       const int idxNodeStart = nodeNeighNodesStart[i];
 2616:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2617:       node.numNodes = idxNodeEnd - idxNodeStart;
 2618:       node.nodes = nodeNeighNodes + idxNodeStart;
 2619:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2620: 
 2621: 
 2622: 
 2623:       const int idxElemStart = nodeNeighElemsStart[i];
 2624:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2625:       node.numElements = idxElemEnd - idxElemStart;
 2626:       node.elements = nodeNeighElems + idxElemStart;
 2627: 
 2628: 
 2629:       
 2630:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2631:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2632:          const int partNode = localNodePart[idxNodeGlobal]; 
 2633:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2634: 
 2635: 
 2636:          Node *node_ptr = nodes[partNode] + idxNode;
 2637:          
 2638:          nodeNeighNodes[idx] = node_ptr;
 2639:       }
 2640: 
 2641:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2642:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2643:          const int partElem = localElemPart[idxElemGlobal];
 2644:          const int idxElem  = localElemIndices[idxElemGlobal];
 2645: 
 2646:          Element *elem_ptr = elems[partElem] + idxElem;
 2647: 
 2648:          nodeNeighElems[idx] = elem_ptr;
 2649:       }      
 2650: 
 2651: 
 2652:       node.wind_angle = wind_rotate_angle[i];
 2653: 
 2654:       // Element **elements; // pointer to the elements connected to this node
 2655:       // int numElements;   // number of elements shared by this node
 2656: 
 2657:       node.p.x   = node_coords[i * 3];
 2658:       node.p.y   = node_coords[i * 3 + 1];
 2659:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2660:       node.depth = node_coords[i * 3 + 2];
 2661: 
 2662:       node.numSides = 0;
 2663: 
 2664:       // Links the node to the boundary information
 2665:       if (isbnd[i] >= 0) {
 2666:        
 2667:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2668:          node.nodeBnd->node = &node;
 2669: 
 2670: 
 2671:          if (isbnd[i]>0) {
 2672: 
 2673:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2674:             node.nodeBnd->segment->ifltype = isbnd[i];
 2675: 
 2676:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2677:             node.nodeBnd->segment->clen  = nan("1");
 2678:             node.nodeBnd->segment->carea = nan("1");
 2679: 
 2680:          }
 2681:          else {
 2682:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2683:          }
 2684:          
 2685:          idxNodeBoundary++;
 2686:       }
 2687:       else {
 2688:          node.nodeBnd = nullptr;
 2689:       }
 2690: 
 2691:       // XXXX GAUSSIAN HILL VELOCITIES
 2692: #ifdef GAUSSIAN_HILL_VELOCITIES
 2693:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2694:          constexpr double rot_per = 3000.0;
 2695:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 2696:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0}; }
 2697:       // XXXXX
 2698: #endif
 2699:    }
 2700: 
 2701:    nbp = idxNodeBoundary;
 2702: 
 2703:    printf("Processing %d sides\n", ns);
 2704:    int idxSideBoundary = 0;
 2705:    for (int i = 0; i < ns; i++)
 2706:    {
 2707:       Side &side = localSideData[i];
 2708:       side.idx = i;
 2709:       // finding the pointer to the nodes that form the side
 2710:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2711:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2712: 
 2713:       const int locidx_n1 = localNodeIndices[idx_n1];
 2714:       const int locidx_n2 = localNodeIndices[idx_n2];
 2715:       const int part_n1 =   localNodePart[idx_n1];
 2716:       const int part_n2 =   localNodePart[idx_n2];
 2717: 
 2718:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2719:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2720: 
 2721:       // Counts the number of sides connected to each node
 2722:       side.n1->numSides++;
 2723:       side.n2->numSides++;
 2724: 
 2725:       // Normal, unitary vector to the side
 2726:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2727:       side.n = normalize(side.n);
 2728: 
 2729:       // Side boundary type
 2730:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 2731:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 2732:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2733:       
 2734:       if (n1bnd != nullptr || n2bnd != nullptr) 
 2735:       {
 2736:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2737:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2738:          else                  side.sideBnd->segment = n2bnd->segment;
 2739:          side.sideBnd->side = &side;
 2740:          idxSideBoundary++;
 2741:       }
 2742:       else side.sideBnd = nullptr;
 2743: 
 2744:       nbs = idxSideBoundary;
 2745: 
 2746:       // finding the pointer to the elements that share the side
 2747:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2748:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2749: 
 2750:       if (idx_e1 > -1) {
 2751:          const int locidx_e1 = localElemIndices[idx_e1];
 2752:          const int part_e1 =  localElemPart[idx_e1];
 2753:          side.elems[0] = elems[part_e1] + locidx_e1;
 2754: 
 2755:       }
 2756:       else {
 2757:          side.elems[0] = nullptr;
 2758:       }
 2759: 
 2760:       if (idx_e2 > -1) {
 2761:          const int locidx_e2 = localElemIndices[idx_e2];
 2762:          const int part_e2 =  localElemPart[idx_e2];
 2763:          side.elems[1] = elems[part_e2] + locidx_e2;
 2764:       }
 2765:       else {
 2766:          side.elems[1] = nullptr;
 2767:       }
 2768: 
 2769: 
 2770: 
 2771:       // Compute the center of the side
 2772:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2773: 
 2774: #ifdef GAUSSIAN_HILL_VELOCITIES
 2775: // XXXX
 2776: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2777: constexpr double rot_per=3000.0;
 2778: constexpr double rot_f=0.0*2.0*pi/rot_per;
 2779: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2780: // XXXXX      
 2781: #endif
 2782:       // Compute the z level at the center of the side
 2783:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 2784: 
 2785:       // Compute the length of the side
 2786:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2787:       side.len = sqrt(dot(vLen, vLen));
 2788: 
 2789:    }
 2790: 
 2791:    printf("Processing %d elements\n", ne);
 2792:    for (int i = 0; i < ne; i++)
 2793:    {
 2794:       Element &elem = localElemData[i];
 2795:       elem.idx = i;
 2796:       for (int j = 0; j < i34[i]; j++) {
 2797:          const int idxNode = elnode[i*4 + j];  
 2798:          const int idxSide = elside[i*4 + j];
 2799:          
 2800:          elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 2801:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2802: 
 2803: 
 2804: 
 2805:          // Find the neighboring element  
 2806:          if (elem.sides[j]->elems[0] == &elem) {
 2807:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2808:          }
 2809:          else {
 2810:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2811:          }
 2812:          
 2813:       }
 2814: 
 2815:       elem.i34 = i34[i];
 2816: 
 2817: // printf("elem = %p, elem.i34 = %d\n", &elem, elem.i34);
 2818: 
 2819:       // Compute the centroid of the element and its depth
 2820:       Vector2 center = {0.0, 0.0};
 2821:       elem.depth = 0.0;
 2822:       for (int j = 0; j < i34[i]; j++) {
 2823:          center += elem.nodes[j]->p2()/i34[i];
 2824:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2825:       }
 2826:       elem.center.x = center.x;
 2827:       elem.center.y = center.y;
 2828: 
 2829:       // printf("elem = %p, i34 = %d, center = (%f,%f,%f)\n", &elem, elem.i34, elem.center.x, elem.center.y, elem.depth);
 2830:       
 2831:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2832:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2833: 
 2834:       elem.area = elem.computeSignedArea(); 
 2835:       elem.radius = sqrt(elem.area)/pi; 
 2836:       
 2837:       // Determines which way the normal vector to each side is oriented.
 2838:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2839:       for (int j = 0; j < i34[i]; j++)  
 2840:       {
 2841:          if (elem.sides[j]->elems[0] == &elem) {
 2842:             elem.ssign[j] =  1.0;
 2843:          }
 2844:          else {
 2845:             elem.ssign[j] = -1.0;
 2846:          }
 2847: 
 2848:       }
 2849: 
 2850:       // Derivatives of shape functions
 2851:       //  For ics=2, this is done inside element/ll frame XXX
 2852:       //  For quads, the derivative is evaluated at centroid
 2853:       const int i34 = elem.i34;
 2854:       for (int j = 0; j < i34; j++) {
 2855:          const double area = elem.area;
 2856:          const int id2 = elem.nxq(1 + j);
 2857:          const int id3 = elem.nxq(2 + j);
 2858:          const int id4 = elem.nxq(3 + j);
 2859:          if (elem.isTri()) {
 2860:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2861:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2862:             // da1/dx = (y1 - y2)/(2*area)
 2863:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2864:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2865:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2866:          }
 2867:          else  { // Quad; evaluate at centroid
 2868:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2869:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2870:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2871:          } // if Tri
 2872: 
 2873:       } // for j
 2874: 
 2875:    }
 2876: 
 2877: 
 2878:    // Processing the boundary nodes
 2879:    int idx = 0;
 2880:    for (int iseg = 0; iseg < nope; iseg++) {
 2881:       for (int ilnd = 0; ilnd < nlnd[iseg]; ilnd++) {
 2882: 
 2883:          NodeBoundary *nodeBnd = &localNodeBoundaryMem[idx];
 2884: 
 2885:          nodeBnd->isEssentialBC = true;
 2886: nodeBnd->iettype = 3; // XXXXXXXXX
 2887:          nodeBnd->elbc = 0.0;
 2888: 
 2889:          for (int jfr = 0; jfr < nbfr; jfr++) {
 2890:             nodeBnd->efa[jfr] = efa[jfr + iseg*nbfr];
 2891:             nodeBnd->emo[jfr] = emo[jfr + iseg*nbfr];
 2892:             nodeBnd->umo[jfr] = umo[jfr + iseg*nbfr];
 2893:             nodeBnd->ufa[jfr] = ufa[jfr + iseg*nbfr];
 2894:             nodeBnd->vmo[jfr] = vmo[jfr + iseg*nbfr];
 2895:             nodeBnd->vfa[jfr] = vfa[jfr + iseg*nbfr];
 2896: 
 2897:          }
 2898: 
 2899:          idx++;
 2900:       }
 2901: 
 2902:    }
 2903: 
 2904: }
 2905: 
 2906: 
 2907: 
 2908: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 2909:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 2910:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 2911:    // 
 2912:    // This kernel is called for all nodes.
 2913: 
 2914: 
 2915:    NODE(node1);
 2916: 
 2917: 
 2918:    node1->clearMatrixRow();
 2919:    node1->qel = 0.0;
 2920: 
 2921:    // THIS IS FOR STRUCTURES XXX
 2922:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 2923: 
 2924:    
 2925:    for (int j=0; j<node1->numElements; j++) {
 2926:       // For each element connected to the node...
 2927: 
 2928:       Element *elem = node1->elements[j];
 2929: 
 2930:       // Compute the average gravity
 2931:       const double grav3 = elem->mean(&Node::grav2);
 2932: 
 2933:       // Look at the documentation for the description of the terms in the following integrals
 2934: 
 2935:       // Integral I_1 
 2936:       // \bar{\breve{H}} 
 2937:       const double hhatb = elem->mean(&Side::hhat);        
 2938: 
 2939: 
 2940:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 2941: 
 2942:       const int id1 = elem->nodeLocalIdx(node1); 
 2943:       const double area = elem->area;
 2944: 
 2945:       if (elem->isTri()) {
 2946: 
 2947:          // To clarify the notation in this section: 
 2948:          //   i stands for the node under consideration (node1)
 2949:          //   j (node2) and k (node3) are the other nodes of the triangle.
 2950:          const int id2 = elem->nxq(1 + id1);
 2951:          const int id3 = elem->nxq(2 + id1);
 2952:          Node *node2 = elem->nodes[id2];
 2953:          Node *node3 = elem->nodes[id3];
 2954: 
 2955:          const Point2 x1 = node1->p2();
 2956:          const Point2 x2 = node2->p2();
 2957:          const Point2 x3 = node3->p2();
 2958: 
 2959:          // integral of phi_i*phi_j
 2960:          const double ipp_ii = (1.0/6.0 )*area;
 2961:          const double ipp_ij = (1.0/12.0)*area;
 2962:          const double ipp_ik = (1.0/12.0)*area;
 2963: 
 2964:          // integral of [(grad phi_i) * (grad phi_j)]
 2965:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 2966:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 2967:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 2968: 
 2969:          // Computes the different components of integral I_1 of each node with respect to node i.
 2970:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 2971:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 2972:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 2973: 
 2974: if (j==node1->numElements-1) {
 2975: printf("grav3 = %f, thetai = %f, dt = %f, hhatb = %f, area = %f, dot1= %f, dot2 = %f, dot3 = %f\n", grav3, thetai, dt, hhatb, area, dot(x3-x2, x3-x2), dot(x3-x2, x1-x3), dot(x1-x3, x1-x3));
 2976: printf("node idx = %d, x1 = %f, %f, x2 = %f, %f, x3 = %f, %f\n", node1->idx, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y);
 2977: printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 2978: }
 2979: 
 2980:          node1->addToSparseMatrix(node1, I1_ii);
 2981:          node1->addToSparseMatrix(node2, I1_ij); 
 2982:          node1->addToSparseMatrix(node3, I1_ik);
 2983: 
 2984: if (j==node1->numElements-1) printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 2985:      
 2986:       }
 2987:       else { // Quad
 2988:          // XXX IMPLEMENT THIS
 2989:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2990:       } 
 2991: 
 2992:  
 2993:       // Integral I_4
 2994:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 2995:       // Where
 2996:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 2997: 
 2998:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 2999:       // of U over the element.
 3000:       Vector2 Umean = {0.0, 0.0};
 3001:       for (int m=0; m<elem->i34; m++) {      
 3002:          const Side *side = elem->sides[m];
 3003: 
 3004:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3005:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3006:       }
 3007:       Umean = Umean/elem->i34;
 3008: 
 3009:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3010: 
 3011:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3012:       const double I_4_1 = dot(gradPhi_1, Umean);
 3013: 
 3014:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3015:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3016:      
 3017:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3018: if (j==node1->numElements-1) printf("MMMMmm  idx_node = %d, I_4_1 = %.15g, I_4_2 = %.15g, node1->qel = %.15g, gradPhi_1 = %.15g, %.15g, elem->ghat1 = %.15g, %.15g\n", node1->idx, I_4_1, I_4_2, node1->qel, gradPhi_1.x, gradPhi_1.y, elem->ghat1.x, elem->ghat1.y);
 3019: 
 3020:       // Additional terms 
 3021:       double vnorm = 0.0;
 3022:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3023:          Vector3 ubed;
 3024:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3025: 
 3026:          Vector3 gradP = {0.0, 0.0, 1.0};
 3027:          for (int m=0; m < elem->i34; m++) {
 3028:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3029:            gradP += toVector3(gradP_2D, 0.0);
 3030:          }   
 3031:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3032:       } // imm==2
 3033: 
 3034:       if (elem->isTri()) {
 3035:          for (int l=0; l<3; l++) {
 3036:            double fac;
 3037: 
 3038:            Node *node = elem->nodes[l];
 3039: 
 3040:            (node == node1)? fac=2.0 : fac=1.0;
 3041: 
 3042:            if constexpr(imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3043:            else                 node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3044:            
 3045:          }
 3046: 
 3047: 
 3048:          if (!elem->isDry) {
 3049:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3050: 
 3051:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3052:          }
 3053: if (j==node1->numElements-1) printf("&&& node1->qel = %f\n", node1->qel, node1->eta2);
 3054: 
 3055:       } // isTri
 3056:       else { // isQuad
 3057:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3058:          // for (int l=0; l<4; l++) {
 3059:          //   const Node *node = elem->nodes[l];
 3060: 
 3061:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3062:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3063: 
 3064:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3065:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3066:          // }
 3067: 
 3068:       } // isQuad
 3069: 
 3070: 
 3071:       node1->qel += (dt/elem->i34)*elem->vsource;
 3072:       
 3073: 
 3074:    } // for all elements connected to the node
 3075:    
 3076: 
 3077: 
 3078:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3079:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3080:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3081:    if (nodeBnd != nullptr)  { 
 3082:       // If it is an open boundary node...
 3083: 
 3084:       // At least one open bnd side, maybe two
 3085:       for (int l=0; l<2; l++) { 
 3086: 
 3087:          // Gets each of the sides sharing the node. 
 3088:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3089: 
 3090:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 3091: 
 3092:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3093: 
 3094: 
 3095:          if (sideBnd != nullptr) {
 3096:             // If the side is on a boundary...
 3097: 
 3098:             // Get the boundary segment
 3099:             const BoundarySegment *sideSegment = sideBnd->segment;
 3100:             const Side *side = sideBnd->side;
 3101: 
 3102:             // Integral I_3
 3103:             if (sideSegment->ifltype != 0) {
 3104:             // Natural or Flather b.c.
 3105: 
 3106:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3107:                // especially for Flather b.c.
 3108:                double ri3 = 0.0;
 3109:                if (!side->isDry) {
 3110:                   // If the side is not dry
 3111:                   
 3112:                   // Computes the side flux of (uth, vth)
 3113:                   double Vn = 0.0;
 3114:                   for (int k = side->kb; k<nvrt-1; k++) {
 3115:                      // uth, vth in lat/lon frame if ics=2
 3116:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 3117:                      const double vn1 = dot(side->uth[k  ], side->n); // outer normal
 3118:                      const double vn2 = dot(side->uth[k+1], side->n);
 3119: 
 3120:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3121:                   }
 3122: 
 3123:                   ri3 = 0.5*side->len*Vn;
 3124:                }
 3125: 
 3126:                if (sideSegment->ifltype == -1) { // Flather 1
 3127: 
 3128:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3129:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3130: 
 3131:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3132:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3133:                   
 3134:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3135:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3136: 
 3137:                } 
 3138:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3139:                   // Reset ri3
 3140:                   ri3 = 0.0;
 3141: 
 3142:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3143: 
 3144:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3145: 
 3146:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3147:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3148: 
 3149:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3150:                   node1->addToSparseMatrix(node1, con0*2.0);
 3151:                   node1->addToSparseMatrix(node2, con0);
 3152: 
 3153:                } // if Flather or Discharge
 3154: 
 3155:                node1->qel -= thetai*dt*ri3;
 3156: 
 3157:             } // I_3
 3158:           
 3159: 
 3160:             // Integral I_5
 3161:             if(!side->isDry) {
 3162: 
 3163:                const double Unbar = dot(side->U, side->n);
 3164: 
 3165:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3166:                
 3167:             } // I_5
 3168: 
 3169:          } // if is boundary side
 3170: 
 3171:       } // for l
 3172: 
 3173:    } // if isbnd
 3174: 
 3175: 
 3176:    printf("44444444 idx_node = %d, node1->qel = %f\n", node1->idx, node1->qel);
 3177: 
 3178: }
 3179: 
