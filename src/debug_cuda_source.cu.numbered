 7261: 
 7262:    __global__ void setVelocityOpenBndNodes(void) {
 7263:    // For open boundary nodes sets their velocity to the imposed values.
 7264: 
 7265:       SIDE_BND(sidebnd);
 7266: 
 7267:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 7268:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 7269:          // to its segment to the average of the side velocity.
 7270: 
 7271:          for (int k = 0; k < nvrt; k++) {
 7272:             Node *n1 = sidebnd->side->n1;
 7273:             Node *n2 = sidebnd->side->n2;
 7274: 
 7275: 
 7276:             Vector2 n1_u2(n1->u2[k]);
 7277:             Vector2 n2_u2(n2->u2[k]);
 7278: 
 7279:             if (n1->nodeBnd->segment == sidebnd->segment) {
 7280:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 7281:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 7282:             }
 7283:             if (n2->nodeBnd->segment == sidebnd->segment) {
 7284:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 7285:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 7286:             }
 7287: 
 7288:          }
 7289: 
 7290:       }
 7291: 
 7292:    }
 7293: 
 7294: 
 7295:    __global__ void computeVerticalVelocity(void) {
 7296:       // Computes the vertical velocity at the (2D) element's centroid.
 7297:       // In this function we will be considering volumetric elements, with side faces and a 
 7298:       // bottom and a top face. We will call them SFs, BF and TF.
 7299:       // It computes the flux coming from BF and the SFs.
 7300:       // If the bed is moving, it takes that into account.
 7301:       // Since water is incompressible, the integral of the velocity times the normal vector
 7302:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 7303:       // and the BF is equal to the flux going out from the TF.
 7304:       // TF = - BF - sum(SFs).
 7305:       // It then computes the horizontal velocity at the center of TF.
 7306:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 7307:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 7308:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 7309: 
 7310:       ELEM(elem);
 7311: 
 7312:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 7313: 
 7314:       if (elem->isDry) return;
 7315: 
 7316:       const int kb = elem->kb;
 7317:       const bool isTri = elem->isTri();
 7318: 
 7319:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 7320: 
 7321:       // Compute the bottom velocity
 7322:       if constexpr(imm != 0) {
 7323:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 7324:       }
 7325: 
 7326: 
 7327:       double bottomArea3D;
 7328:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 7329: 
 7330:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 7331: 
 7332:       double topArea3D;
 7333: 
 7334:       // Bottom face flux
 7335:       double bottomFlux = 0.0;
 7336:       Vector2 u2meanBottom = {0.0, 0.0};
 7337:       const Vector2 gradh = elem->grad2(&Node::depth);
 7338:       if constexpr(imm==2) {
 7339:          Vector3 ubed;
 7340: 
 7341:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 7342:          // updateBDEF(ubed);
 7343:      
 7344:          // const double bflux0 = dot(ubed, elem_bottom_n);
 7345: 
 7346:          // elem->w[kb] += ubed.z;
 7347:       }
 7348:       else {
 7349: 
 7350:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 7351:   
 7352:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 7353:          // in the direction of motion.
 7354:          const double bottomW = - dot(gradh, u2meanBottom);  
 7355:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 7356: 
 7357:          // VElocity associated to the bed deformation
 7358:          double bedVelocity = 0.0;
 7359:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 7360: 
 7361:          elem->w[kb] = bedVelocity + bottomW; 
 7362: 
 7363:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 7364:          
 7365:       } // if imm
 7366: 
 7367:       // Compute w for kb+1 to nvrt-1
 7368:       for (int l = kb; l < nvrt - 1; l++) {
 7369: 
 7370:          // normal vector to the top face of the "volumetric" element (3D)
 7371:          Vector3 elem_top_n = elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 7372: 
 7373:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 7374:          assert(elem_top_n.z > 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 7375: 
 7376:          // Compute the total flux at the sides
 7377:          double sideFlux = 0.0;
 7378: 
 7379:          for (int j = 0; j < elem->i34; j++) {
 7380:             const Side *side = elem->sides[j];
 7381:             const int kbs = side->kb;
 7382:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 7383:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 7384:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 7385: 
 7386:             // The area is "clamped" meaning that it takes kb into account.
 7387:             const double sideArea = side->areaClamped(l);
 7388: 
 7389:             const double sign = elem->ssign[j]; 
 7390: 
 7391:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 7392:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 7393:          }
 7394:          
 7395:          // Compute the horizontal velocity at the center of the top face as an average of the 
 7396:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 7397:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 7398: 
 7399:          // The flux at the top ace can be computed from the other flows.
 7400:          // All fluxes are in directions into the prism.
 7401:          const double topFlux = - sideFlux - bottomFlux;
 7402: 
 7403:          // Flux at the top face due to the horizontal velocities only
 7404:          // topFlux = topHorizontalFlux + topVerticalFlux
 7405:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 7406: 
 7407:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + sideFlux + bottomFlux = 0, so:
 7408:          const double topVerticalFlux = topFlux - topHorizontalFlux;  
 7409: 
 7410:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 7411: 
 7412:          bottomFlux = -topFlux;
 7413:          
 7414:       }
 7415: 
 7416:    }  
 7417: 
 7418: 
 7419: 
 7420: 
 7421: 
 7422: 
 7423: 
 7424: // !===============================================================================
 7425: // !===============================================================================
 7426: 
 7427: } // extern "C"
 7428: 
 7429: #ifdef DONTCOMPILE
 7430: __device__ void computeVerticalAdvection(void) {
 7431:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 7432: 
 7433:    sdbt(1:2,:,:)=0.d0
 7434: 
 7435:    const Side *side = FROM kernel;
 7436: 
 7437:    if(side->isDry) return;
 7438: 
 7439:    // If side is wet...
 7440: 
 7441: 
 7442:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 7443:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 7444:    double ws[nvrt] = {} // w @ side
 7445:    int icount = 0;
 7446:    for (int j=0; j<2; j++) {
 7447:       const Element *elem = side->elements[j];
 7448:        
 7449:       if(elem != nullptr) {
 7450:          icount++;
 7451:          for (int k=0; k<nvrt; k++) {
 7452:             ws[k] = ws[k] + elem->w[k];
 7453:          }
 7454:       }
 7455:    }  // for j
 7456: 
 7457:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 7458:    ws = ws/icount;
 7459: 
 7460:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 7461:    // Splines allow for a smooth transition between vertical levels.
 7462:    // Splines have continuity restrictions at the internal knots, but
 7463:    // we have to provide the 1st derivatives at the endpoints.
 7464:    const int kbs = side->kbs; 
 7465:    
 7466:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7467:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7468:    initCubicSpline(kbs, nvrt, side, ws, up)
 7469: 
 7470:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7471:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7472:    initCubicSpline(kbs, nvrt, side, ws, vp)
 7473: 
 7474:    // Total advection (average onto side)
 7475:    const Node *node1 = side->nodes[0];
 7476:    const Node *node2 = side->nodes[1];
 7477:    for (int k=kbs(i); k<nvrt; k++) {
 7478: 
 7479:       Vector2 bcc1 = node1->bcc[k];
 7480:       Vector2 bcc2 = node2->bcc[k];
 7481:       if constexpr(ics == 2) {
 7482:          // Project the velocities from the node frames to the side frame
 7483:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 7484:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 7485:       }
 7486: 
 7487:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 7488:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 7489: 
 7490:    }
 7491: }
 7492: #endif
 7493: 
 7494: 
 7495: extern "C" {
 7496:    __global__ void computeElemAverageGhat(void) {
 7497:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 7498: 
 7499:       ELEM(elem);
 7500:       
 7501:       elem->ghat1= {0.0, 0.0};  
 7502: 
 7503:       if constexpr(ihydraulics != 0) {
 7504:          if (nhtblocks > 0 && elem->isblock) return;
 7505:       }
 7506: 
 7507:       
 7508:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 7509:       // cff1-3: coefficients for 2D/3D
 7510: 
 7511:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7512:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7513:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 7514: 
 7515:       if (elem->isDry) return;
 7516: 
 7517:       // Average of the coefficients
 7518:       double av_cff1 = 0.0;  // av. for cff1
 7519:       double av_cff2 = 0.0;  // av. for cff2
 7520:       double av_cff3 = 0.0;  // av. for cff3
 7521:       double av_df = 0.0;  // av. for H^\alpha / H
 7522:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7523:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7524: 
 7525:       const int i34 = elem->i34;
 7526:       const int kb  = elem->kb;
 7527: 
 7528:       for (int j=0; j<i34; j++) {
 7529:          // For each node and side in the element...
 7530: 
 7531:          const Node *node = elem->nodes[j];
 7532:          const Side *side = elem->sides[j];
 7533: 
 7534:          const double chi      = side->chi;
 7535:          const double veg_c2   = side->veg_c2;
 7536:          const double veg_beta = side->veg_beta;
 7537:          const double veg_h    = side->veg_h();
 7538:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7539: 
 7540:          const Vector2 gradPhi = elem->gradPhi[j];
 7541: 
 7542:          // Node - const in elem
 7543:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 7544:          elem->gradPr  += node->pr  *gradPhi;
 7545: 
 7546:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 7547: 
 7548:         
 7549:          const double htot  = side->htot2();        // Total depth at the side
 7550:          const double zctr2 = side->zTopCanopy();  
 7551: 
 7552:          double cff1; 
 7553:          double cff2; 
 7554:          double cff3;   
 7555:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7556:          // coefficients applied to 2D/3D case 
 7557:             cff1 = side->hhat/htot;
 7558:             cff2 = 0.0;
 7559:             cff3 = 0.0;
 7560:          } else { //3D
 7561:             //Init for no-veg case
 7562:             cff1 = 1.0;
 7563:             cff2 = 1.0;
 7564:             cff3 = 0.0;
 7565: 
 7566:             if constexpr(iveg != 0) {
 7567:                // Computes coefficients used with vegetation terms G1, G2
 7568:                // cff1, cff3 are used for the first two terms in G1, G2:
 7569:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7570:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7571:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7572:                if(veg_h < 0.99*htot) { // submergent vegetation
 7573:                   cff1 = 1.0;
 7574:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7575:                   cff3 = veg_c;
 7576: 
 7577:                } else { // emergent vegetation
 7578:                   cff1 = 1.0/(1.0 + veg_c2);
 7579:                   cff2 = cff1;
 7580:                   cff3 = 0.0;
 7581: 
 7582:                }
 7583:             } // if iveg
 7584:          } //  2D/3D
 7585: 
 7586:          av_cff1 += cff1/i34;
 7587:          av_cff2 += cff2/i34;
 7588:          av_cff3 += cff3/i34;
 7589:          av_cff2_chi += cff2*chi/i34;
 7590:          av_cff3_chi += cff3*chi/i34;
 7591:          av_df += min(htot, veg_h)/(htot*i34);
 7592: 
 7593: 
 7594:          // btrack values: U^\star, U^{\star\alpha}
 7595:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7596:          Vector2 Ustar       = {0.0, 0.0}; 
 7597:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7598: 
 7599:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7600:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7601:          } else { //3D
 7602:             for (int k = side->kb + 1; k < nvrt; k++) {
 7603:             
 7604:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7605:                Ustar += w2;
 7606: 
 7607:                if constexpr(iveg != 0) {
 7608:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7609:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7610:                        Ustar_alpha += zrat*w2; // XXXX
 7611:                    }
 7612:                }  // if iveg
 7613:             }  // for k
 7614:          }  //2D/3D
 7615: 
 7616:          // If needed, project the side velocities to the element frame
 7617:          if constexpr(ics==2) {
 7618:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 7619:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 7620:          }
 7621:         
 7622: 
 7623:          // Add btrack & surface stress terms to \breve{G} first
 7624:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7625: 
 7626: 
 7627:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 7628:          Vector2 tau    = side->tau();  
 7629:          Vector2 ubstar = side->btu[side->kb + 1];  
 7630: 
 7631:          // If needed, project tau and ubstar to the element frame
 7632:          if constexpr(ics==2) {
 7633:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 7634:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 7635:          }
 7636: 
 7637:          // Term for surface and bottom stress
 7638:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7639: 
 7640: 
 7641:          // All terms in F,F^\alpha,f_b except baroclinic
 7642:          // F, f_b: all explicit terms excluding vegetation 
 7643:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7644:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7645:          const double coriolis = side->coriolis;
 7646:          Vector2 F  =  coriolis*side->U;  // F_x
 7647:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7648:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7649: 
 7650:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7651:             
 7652:             for (int k = side->kb; k < nvrt; k++) {
 7653:                if (zctr2 > side->zc[k-1]) {
 7654:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7655:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7656:                    Fa +=  coriolis*w2*zrat;
 7657:                } // if zctr2
 7658:             } // k
 7659:          } // iveg
 7660: 
 7661:          // Integrate horizontal viscosity force vertically
 7662:          for (int k=side->kb + 1; k<nvrt; k++) {
 7663:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7664: 
 7665:             F += levelHorVisc;
 7666: 
 7667:             // Vegetation term
 7668:             if constexpr(iveg!=0) {
 7669:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7670:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7671:                   Fa += levelHorVisc*zrat;
 7672:                } 
 7673:             } // if iveg
 7674:          } // for k
 7675: 
 7676:          // Get nu*grad(U) at the side's bottom level
 7677:          Vector2 nuGradU = side->nuGradU[side->kb];
 7678: 
 7679:          fb += nuGradU;
 7680: 
 7681:          // If needed, project vectorsF, fb and Fa to the element frame
 7682:          if constexpr(ics==2) {
 7683:             F    = side->frame.projHorVec(F,    elem->frame);
 7684:             fb   = side->frame.projHorVec(fb,   elem->frame);
 7685:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 7686:          } // if ics
 7687: 
 7688:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7689:       } // for j (nodes and sides)
 7690: 
 7691:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7692: 
 7693: 
 7694:       // Finish off terms in F, F^\alpha and f_b
 7695:       const double grav3 = elem->mean(&Node::grav2);
 7696:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7697:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7698:       for (int j=0; j<i34; j++) { 
 7699:          // For each side in the element...
 7700:          const Side *side = elem->sides[j];
 7701:          const double chi = side->chi;
 7702: 
 7703:          const double htot = side->htot2();
 7704:          const double veg_h = side->veg_h();
 7705:          const Vector2 F  = htot*fb;
 7706:          const Vector2 Fa = min(htot, veg_h)*fb;
 7707: 
 7708:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7709:       } // for j
 7710: 
 7711:       // tmp is already in elem frame
 7712:       elem->ghat1 += tmp/i34;
 7713: 
 7714:       // Baroclinic force
 7715:       if constexpr(ibc==0) {
 7716:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7717: 
 7718:          Vector2 Fa = {0.0, 0.0};
 7719:          Vector2 intGradRho = {0.0, 0.0};
 7720:          
 7721:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 7722:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 7723:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7724: 
 7725:             // \in F [m^2/s/s]
 7726:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7727:          }
 7728: 
 7729:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7730:          const Vector2 F = av_df*Fa; //approx
 7731:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7732: 
 7733:       } // if ibc
 7734: 
 7735: 
 7736: 
 7737:    }
 7738: 
 7739: } // extern "C"
 7740: 
 7741: 
 7742: 
 7743: #ifdef DONTCOMPILE
 7744: __global__ void checkMassConservation(Tracers* sumtr) {
 7745: 
 7746:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7747: 
 7748:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7749: 
 7750:    Element *elem = &(mesh->localElemData[i]);
 7751: 
 7752:    // Skip dry elements
 7753:    if (elem->isDry) return;
 7754: 
 7755:    // Local sum array for this thread
 7756:    double localSum[N_TRACERS] = {0.0};
 7757: 
 7758:    // Sum over vertical levels for this element
 7759:    const int kbe = elem->kbe;
 7760:    const double area = elem->area;
 7761: 
 7762:    for (int k = kbe; k < nvrt; k++) {
 7763:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7764:       
 7765:       // Accumulate tracer mass
 7766:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7767:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7768:       }
 7769:    }
 7770: 
 7771:    //  This function returns per element sums. A reduction must be done on the host side.
 7772: }
 7773: 
 7774: 
 7775: __global__ void transport(void) {
 7776: 
 7777:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7778: 
 7779:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7780: 
 7781:    Element *elem = &(mesh->localElemData[ie]);
 7782: 
 7783:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7784: 
 7785:                for (int m=0; m<ntr; m++) {
 7786:                   for (int k=kbe(ie); k<nvrt; k++) {
 7787:                      // Calculate each polynomial's weight 
 7788:                      wm=0.d0; sum1=0.d0; 
 7789:                      wm1=0.d0; wm2=0.d0; 
 7790:                      for (int i=0; i<elem->nweno2; i++) {
 7791:                   
 7792:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7793:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7794:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7795:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7796:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7797:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7798:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7799:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7800:                      // -----------------Hu and Shu (1999)'s method----------------
 7801:                      b4=b1+b2+b3
 7802: 
 7803: //Error: add PRODUCTION CPP
 7804: #ifdef DEBUG
 7805:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7806:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7807:                     call parallel_abort(errmsg)
 7808:                   }
 7809: #endif
 7810: 
 7811:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7812:                   // !----test-------------- 
 7813:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7814:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7815:                   // !wm(i)=wm1(i)*wm2(i)
 7816:                   // !---------------------- 
 7817:                   sum1=sum1+wm(i)
 7818:                 } // end for i
 7819: 
 7820:                 wm=wm/sum1
 7821: 
 7822:                 for (int j=0; j<elem->i34; j++) {
 7823: 
 7824:                   const Side *side  = elem->sides[j];
 7825:                   const Node *node1 = side->n1;
 7826:                   const Node *node2 = side->n2;
 7827: 
 7828:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7829:                      trsd=0.d0
 7830:                      for (int kk=0; kk<nquad; kk++) {
 7831:                         for (int i=0; i<elem->nweno2; i++) {
 7832:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7833:                         } // end for i   
 7834:                      } // end for kk
 7835:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7836:                   } // outward flux
 7837:                } // end for j=1,i34(ie) ! side
 7838:             }
 7839:          }
 7840:               
 7841: 
 7842: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7843: //             //   calculate each polynomial's weight 
 7844: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7845: //                 wm=0.d0; sum1=0.d0
 7846: //                 do i=1,nweno1(ie) !for each polynomial
 7847: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7848: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7849: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7850: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7851: //                   wm(i)=b2
 7852: //                   sum1=sum1+b2
 7853: //                   !wm(i)=1.d0
 7854: //                   !sum1=sum1+1.d0
 7855: 
 7856: // // Error: PRODUCTION
 7857: // #ifdef DEBUG
 7858: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7859: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7860: //                     call parallel_abort(errmsg)
 7861: //                   endif
 7862: // #endif
 7863: 
 7864: //                 enddo !i
 7865: //                 wm=wm/sum1 !final weight
 7866: 
 7867:                 for (int j=0; j<elem->i34; j++) { // side
 7868:                   const Side *side = elem->sides[j];
 7869:                   const Node *node1 = side->n1;
 7870:                   const Node *node2 = side->n2;
 7871: 
 7872:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7873:                     trsd=0.d0
 7874:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7875:                       for (int i=0; i<elem->nweno1; i++) {
 7876:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7877:                       }
 7878:                     enddo //kk
 7879:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7880:                   } // outward flux
 7881:                 } // end for j=1,i34(ie) ! side
 7882:               } // end for k; ntr 
 7883: 
 7884:             else !simple upwind method
 7885:               do j=1,i34(ie)
 7886:                 jsj=elside(j,ie)
 7887:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7888:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7889:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7890:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7891:                   endif
 7892:                 enddo  !vertical layers
 7893:               enddo !j=1,i34(ie) ! side
 7894:             endif !order of accuracy
 7895: 
 7896:          //  enddo !ie
 7897: // !$OMP     end do
 7898: 
