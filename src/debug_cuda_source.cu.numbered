 7473: __global__ void printMatrix(bool full) {
 7474:    // Debugging: print the matrix
 7475: 
 7476:    const int size = mesh->np;
 7477:    double sum = 0.0;
 7478:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7479:       const Node *node = mesh->localNodeData + idx_node;
 7480:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7481:       for (int j = 0; j < node->numNodes; j++) {
 7482:          Node* nbNode = node->nodes[j];
 7483:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7484:          sum += node->coeffMatrix[j];
 7485:       }
 7486:       if (full) printf("]\n");
 7487: 
 7488: 
 7489:    }
 7490:    if (!full) printf("sum=%lf\n", sum);
 7491: }
