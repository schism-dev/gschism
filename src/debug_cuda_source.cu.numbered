 8721: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8722:    // Get the value of a variable from an side
 8723:    // varName is the name of the variable to get
 8724:    // var is the array to store the value
 8725:    // k is the vertical level index of the variable to get
 8726:    SIDE_BND(sideBnd);   
 8727: 
 8728:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8729:    if (sideBnd->segment->isLand) idx = -7;
 8730: 
 8731:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8732:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8733: 
 8734: }
