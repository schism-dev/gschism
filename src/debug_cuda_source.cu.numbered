 1506:    const int ns;   // Local number of sides
 1507: 
 1508:    int nbp;  // Local number of boundary nodes
 1509:    int nbs;  // Local number of boundary sides
 1510: 
 1511:    int nEntries;  // Total number of matrix elements
 1512: 
 1513:    const int max_np; // Maximum number of horizontal nodes per partition (shared by all partitions)
 1514:    const int max_ne; // Maximum number of elements per partition (shared by all partitions)
 1515:    const int max_ns; // Maximum number of sides per partition (shared by all partitions)
 1516: 
 1517:   
 1518:    // Additional topology information
 1519:    Node    **nodeNeighNodes; // Array of pointers to the nodes neighbors of each node
 1520:    Element **nodeNeighElems; // Array of pointers to the elements neighbors of each node
 1521: 
 1522:    BoundarySegment landBoundarySegment;
 1523:    NodeBoundary landBoundaryNode;
 1524: 
 1525:    // Vertical coordinate system
 1526:    // Sigma levels
 1527:    double h_s; 
 1528:    double h_c; 
 1529: 
 1530:    double theta_b;
 1531:    double theta_f, sinh_theta_f;
 1532:    double *sigma;  // There is a sigma_local on each node for the case ivcor=1
 1533:    double *ztot;
 1534:    double *cs;
 1535:    double *dcs;
 1536: 
 1537:    // // Get's the pointer to the node using the array of global pointers to nodes
 1538:    // __device__ const Node *getGlobalNode(int jn) {
 1539:    //    const int idx = jn / max_np; // Get the index of the partition that contains the node
 1540:    //    return nodes[idx] + idx;
 1541:    // }
 1542: 
 1543:    // // Get's the pointer to the element using the array of global pointers to elements
 1544:    // __device__ const Element *getGlobalElem(int je) {
 1545:    //    const int idx = je / max_ne; // Get the index of the partition that contains the element
 1546:    //    return elems[idx] + idx;
 1547:    // }
 1548: 
 1549:    // // Get's the pointer to the side using the array of global pointers to sides
