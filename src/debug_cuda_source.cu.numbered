  376: 
  377: struct Frame {
  378:    double _t[9]; // t stands for tensor.
  379: 
  380:    // Access the tensor in Fortran order
  381:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  382: 
  383:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  384: 
  385:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  386: 
  387:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  388:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  389:       sincos(ar2, &sin_ar2, &cos_ar2);
  390: 
  391:       t(0,0) = -sin_ar1;
  392:       t(1,0) =  cos_ar1;
  393:       t(2,0) =  0.0;
  394:       t(0,1) = -cos_ar1*sin_ar2;
  395:       t(1,1) = -sin_ar1*sin_ar2;
  396: 
  397:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  398: 
  399:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  400:       assert (ar4!=0.0 && "GRID: ar4=0");
  401: 
  402:       const double ar4_inv = 1.0/ar4;
  403:       t(0,1) = t(0,1)*ar4_inv;
  404:       t(1,1) = t(1,1)*ar4_inv;
  405:       t(2,1) = t(2,1)*ar4_inv;
  406: 
  407:       // The third vector is the cross product of the first two
  408:       crossProduct(t(0,0), t(1,0), t(2,0), 
  409:                    t(0,1), t(1,1), t(2,1), 
  410:                    t(0,2), t(1,2), t(2,2));
  411:    }
  412: 
  413: 
  414:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  415:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  416:    // Inputs:
  417:    //        vec0: vel. in this frame;
  418:    //        frameout: Output frame;
  419:    // Output: 
  420:    //        vec1: vel. in new frame  
  421: 
  422:       auto const fo = frameout;
  423:       Vector2 vec1;
  424: 
  425:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  426:       // of t and fo.t are the same.
  427:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  428:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  429: 
  430:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  431:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  432: 
  433:       return vec1;
  434:    }
  435: 
  436:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  437:       // Transform a vector from global to local frame
  438:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  439:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  440:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  441:    }
  442: 
  443:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  444:       // Transform a vector from local to global frame
  445:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  446:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  447:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  448:    }   
  449: 
  450:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  451:    // Tranforms a point from global to local frame     
  452:       G2L(pi - origin0, po);
  453:    }
  454: 
  455:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  456:    // Transforms a point from local to global frame      
  457:       L2G(pi, po);
  458:       po = po + origin0;
  459:    }
  460: 
  461: };
