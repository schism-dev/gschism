 2703: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 2704: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 2705: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 2706: 
 2707: //       if (delta != 0.0) {
 2708: //          // Solves the two linear equations for tt1 and tt2
 2709: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
