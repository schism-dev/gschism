 4310:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4311: 
 4312:       SIDE(side);
 4313: 
 4314: 
 4315:       side->U = {0.0, 0.0}; 
 4316:          
 4317:       if(side->isDry) return;
 4318: 
 4319:       const Node *node1 = side->n1;
 4320:       const Node *node2 = side->n2;
 4321: 
 4322:       // Vertically integrated velocity U (in ll if ics=2)
 4323:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 4324:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 4325:       }
 4326: 
 4327:    }
 4328: 
 4329:    __global__ void computeBottomDragVegetation(void) {
 4330:       // UNFINISHED. CHECK THIS:
 4331:       // How many kernels are needed? Why so many for loops?
 4332:       // Is the loop on sides needed?
 4333: 
 4334:       NODE(node);
 4335: 
 4336:       const int    kb      = node->kb;
 4337:       const double htot    = node->htot2();
 4338:       const double rough   = node->rough;
 4339: 
 4340: 
 4341:       if (node->isDry) {
 4342:          // Default values for dry nodes
 4343:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4344:          /// XXX CHECK INDICES
 4345:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4346:       }
 4347: 
 4348:       // Compute bottom drag Cd
 4349:       //--------------------------------
 4350: 
 4351:       // nchi = {-1, 0, 1} is the type of bottom drag.
 4352:       if (nchi==1) {
 4353: 
 4354:          bool ltmp = false; // for WBL iteration
 4355: 
 4356:          // Cdmax=-1 !max. Cd at node for this process (info only)
 4357:          // Drag at nodes
 4358:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 4359:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 4360:         
 4361:          const double rough = node->rough;
 4362:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4363:          if (node->rough == 0.0) {
 4364:             node->Cd = 0.0;
 4365: 
 4366:          } else { //roughness >0 
 4367:             
 4368:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 4369:             const double bthick = max(dzb_min, bthick_ori);
 4370: 
 4371:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 4372: 
 4373:             double tmp = 1.0/(2.5*log(bthick/rough));
 4374:             node->Cd = tmp*tmp;
 4375: 
 4376:          } // if rough
 4377: 
 4378: 
 4379:          // RECOVER THIS: XXX
 4380:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 4381:          // Output warning for WBL if iteration didn't converge
 4382: 
 4383: 
 4384:       } // nchi==1
 4385: 
 4386:       //   Bottom stress in m^2/s^2
 4387:       if (node->rho[kb + 1] >= -98.0)
 4388:       {
 4389:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 4390:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 4391:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4392:          // !sediment erosion: this part needs more documentation
 4393:       }
 4394: 
 4395:     
 4396:       // Compute vegetation parameters
 4397:       //--------------------------------
 4398: 
 4399:       // SAV constants
 4400:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4401:       constexpr double veg_cfpsi = 0.16;
 4402: 
 4403:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4404:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4405: 
 4406:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4407:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4408:          int kbin = 0; // bin index
 4409:          for (int k = kb; k < nvrt; k++) {
 4410:             // Computes node height above the bottom level
 4411:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4412:             assert(false && "Vertical variation of vegetation not implemented");
 4413: 
 4414:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4415:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4416:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4417:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4418:             // } else {
 4419:             //    // Find the bin at which the current vertical level is
 4420:             //    while (kbin<nbins_veg_vert) {
 4421:             //       const double zn = node->z[kbin];
 4422:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4423:             //          break;
 4424:             //       } // if
 4425:             //       kbin++;
 4426:             //    } // while
 4427:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4428: 
 4429:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4430:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4431:                
 4432:             //    // Linear interpolation of the vegetation parameters
 4433:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4434:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4435:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4436:             // } // if rl10
 4437: 
 4438:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4439: 
 4440:          } // for k
 4441: 
 4442: 
 4443:       } else { // Ganthy (iveg=2)
 4444:       //  Modify canopy height, diameter, and density
 4445: 
 4446:          // Make sure there is vegetation on this node
 4447:          if (node->veg_h_unbent > 0.0) {
 4448:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4449: 
 4450:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4451:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4452:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4453: 
 4454:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4455:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4456:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4457:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4458:          } // if veg_h_unbent
 4459: 
 4460:          for (int k = 0; k < nvrt; k++) {
 4461:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4462:          } // for k
 4463:       
 4464: 
 4465:       } // if iveg
 4466:      
 4467:          
 4468: 
 4469:       // Compute vertical mean of veg_alpha3D
 4470:       if (iveg != 0) {
 4471:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4472:          double sum1=0.0;
 4473:          double sum2=0.0;
 4474:          // Integrate over each level under the canopy...
 4475:          for (int k=kb; k<nvrt-1 && node->z[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 4476:             const double Dz = node->Dz(k);
 4477: 
 4478:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 4479:             sum2 += Dz;
 4480: 
 4481:          } // for k
 4482: 
 4483:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4484:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4485: 
 4486:       } // if iveg
 4487: 
 4488:       printf("computeBottomDragVegetation: nodeIdx = %d, node->veg_alpha_vert_mean = %f\n", node->idx, node->veg_alpha_vert_mean);
 4489: 
 4490:    }
 4491: 
 4492:    __global__ void computeVegetationAndDragParameters(void) {
 4493:       // Computes the vegetation and drag model parameters:
 4494:       // chi, \tilde\chi, beta, \breve{H}
 4495:       
 4496:       SIDE(side);
 4497: 
 4498:       const double htot = side->htot2();
 4499:       const int    kb   = side->kb;
 4500: 
 4501:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4502: 
 4503:       const double veg_h     = side->veg_h();
 4504:       const double veg_nv    = side->veg_nv();
 4505:       const double veg_c     = side->veg_c();
 4506:       const double veg_beta  = side->veg_beta;
 4507:       const double veg_alpha = side->veg_alpha_vert_mean();
 4508: 
 4509:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4510:       // Velocity magnitude at the bottom level
 4511:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4512:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4513:       side->chi2 = side->Cd()*vmag1;
 4514:       side->chi  = side->chi2;
 4515:       if constexpr(iveg != 0) {
 4516:          const Node *n1 = side->n1;
 4517:          const Node *n2 = side->n2;
 4518:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4519:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4520:       }
 4521: 
 4522:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4523: 
 4524:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4525:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4526:       double magUa = 0.0;
 4527:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4528:          // 3D wet side with veg...
 4529: 
 4530:          double magUa = 0.0;
 4531:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4532:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4533: 
 4534:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4535:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4536:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4537: 
 4538:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4539:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4540: 
 4541:                // Velocity magnitude at the bottom (l) of the level
 4542:                const double ul = length(side->u2[k]);
 4543: 
 4544:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4545:                magUa += Dz*0.5*(uh + ul);
 4546: 
 4547:             } // if HasVegetation
 4548:          } // for k
 4549:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4550: 
 4551:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4552:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4553:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4554:             const double zCpy = side->zTopCanopy();
 4555:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4556:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4557:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4558:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4559:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4560:          } // if isSubmerged
 4561:       } // if iveg   
 4562: 
 4563:       // Computes the friction modified depth, \breve{H} in notes
 4564:       if (side->is2D()) { // 2D
 4565: 
 4566:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4567:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4568: 
 4569:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4570: 
 4571:          side->hhat = htot*htot/fricH; 
 4572: 
 4573:       } else { // 3D
 4574:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4575: 
 4576:          if constexpr(iveg != 0) {
 4577:             
 4578:             if (side->isSubmerged()) { 
 4579:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4580:                side->hhat -= veg_c*Hhat_alpha;
 4581: 
 4582:             } else { // Emergent
 4583:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4584:             }
 4585:          } // if iveg
 4586: 
 4587:          // Enforce positivity for 3D model
 4588:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4589:       } // if 3D
 4590: 
 4591:       printf("computeVegetationAndDragParameters: sideIdx = %d, side->htot = %f, side->hhat = %f\n", side->idx, side->htot2(), side->hhat);
 4592: 
 4593:         
 4594:    }
 4595: 
 4596: 
 4597: 
 4598:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4599:    // Computes the density gradient between two elements, e1 and e2.
 4600:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4601:    // zero in the direction normal to the side. 
 4602:    // 
 4603:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4604:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4605:    //
 4606:    // Input:
 4607:    //    e1: Element
 4608:    //    e2: Neighbor element (or nullptr if boundary)
 4609:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4610:    //    k: Index of the half-level at which the density is interpolated
 4611:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4612:    // 
 4613:    // Output:
 4614:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4615:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4616: 
 4617:       if (e2 == nullptr || e2->isDry) {
 4618:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4619: 
 4620:          Side *side = e1->sides[j];
 4621:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4622:                  
 4623:          if constexpr(ics == 1) {
 4624:             vec = side->n; // Normal vector to the side
 4625:          } else {
 4626:             // IMPLEMENT THIS XXXXXX
 4627:             // !replace with xel, yel?
 4628:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4629:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4630:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4631:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4632:          } //ics
 4633:                    
 4634:          diffRho = 0.0;
 4635: 
 4636:       } else { //internal and wet
 4637:          if constexpr(ics==1) {
 4638:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4639: 
 4640:             // Vector from e1 to e2
 4641:             vec = toVector2(e2->center - e1->center);
 4642: 
 4643:          } else { 
 4644:             // IMPLEMENT THIS XXXXXX
 4645:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4646:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4647:             //                   alow(j)=xctr2
 4648:             //                   bdia(j)=yctr2
 4649:          } // ics
 4650: 
 4651:          diffRho = rho2 - e1->demeanedDensity(k);
 4652:       }
 4653: 
 4654:    }
 4655: 
 4656:    __global__ void computeDensityCubicSplines(void) {
 4657:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4658: 
 4659:       ELEM(elem);
 4660: 
 4661:       if (elem->isDry) return;
 4662: 
 4663:       const int kb = elem->kb;
 4664: 
 4665:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4666:       if (elem->is2D()) {
 4667:          // In the 2D case, the density is constant at the prism level. 
 4668:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4669:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4670:       } else { //3D
 4671: 
 4672:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4673:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4674:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4675:          ///// XXXX CHECK INDICES!!!!!
 4676:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4677:       } // 2D/3D
 4678: 
 4679:    }
 4680: } // extern "C"
 4681: 
 4682: 
 4683: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4684: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4685: 
 4686:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4687: 
 4688:    const int kb  = elem->kb;
 4689:    const int kb2 = elem2->kb;
 4690: 
 4691:    // z-coordinate of prism of elem
 4692:    const double zp = elem->z_prism(k);
 4693: 
 4694:    double rho = 0.0;
 4695: 
 4696:    if (elem2->is2D()) {
 4697:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4698: 
 4699:    } else {  // 3D
 4700: 
 4701:       // eta_min may be < zmax
 4702:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4703:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4704: 
 4705:       // (Extrapolate density below bottom, we will fix it later)
 4706:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4707:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4708:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4709:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4710:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4711:    } // 2D/3D
 4712:      
 4713: 
 4714:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4715:    // Now we need to fix it.
 4716:    if (elem->z[k] < elem2->z[kb2]) {
 4717:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4718: 
 4719:       // There are two methods to adjust the density at the bottom of the element.
 4720:       // iunder_deep=0: 
 4721:       const double depth1 = abs(elem->z[kb]); // larger depth
 4722: 
 4723:       if (iunder_deep==0) {
 4724: 
 4725:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4726: 
 4727:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4728: 
 4729:       } else { // iunder_deep != 0
 4730: 
 4731:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4732: 
 4733:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4734: 
 4735:          //   Demeaned density at the same z coordinate as
 4736:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4737:          }
 4738: 
 4739:       } // if iunder_deep
 4740:    } // if elem->z[kb] < elem2->z[kb]
 4741: 
 4742:    return rho;
 4743: }
 4744: 
 4745: 
 4746: extern "C" {
 4747:    __global__ void computeDensityGradient(void) {
 4748: 
 4749:          // Compute the horizontal density gradient at each element.
 4750:       // It works in two steps:
 4751:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4752:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4753:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4754:       //             gradRho.r1 = rho1 - rho0
 4755:       //             gradRho.r2 = rho2 - rho0
 4756:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4757:       // 
 4758:       //  NOTE: We use de-meaned densities.
 4759: 
 4760:       ELEM(elem);
 4761: 
 4762:       if (elem->isDry) return;
 4763: 
 4764:       const int kb  = elem->kb;
 4765:       const int i34 = elem->i34;
 4766: 
 4767:       for (int k = kb + 1; k < nvrt; k++) {
 4768:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 4769:          //             gradRho.r1 = rho1 - rho0
 4770:          //             gradRho.r2 = rho2 - rho0
 4771:          int icount = 0;
 4772:          double sumRx = 0.0;
 4773:          double sumRy = 0.0;
 4774:          for (int j1=0; j1<i34; j1++) { 
 4775: 
 4776:             const int j2 = elem->nxq(j1 + 1);
 4777: 
 4778:             // Pairs of consecutive neighbor elements of elem
 4779:             const Element *e1 = elem->nghbElems[j1];
 4780:             const Element *e2 = elem->nghbElems[j2];
 4781: 
 4782:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 4783:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 4784:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 4785: 
 4786:             // Compute the density difference and the vector from elem to e1 and e2
 4787:             // getRhoDiffAndVec takes into account boundaries/dry elements
 4788:             double diffRho1, diffRho2;
 4789:             Vector2 vec1, vec2;
 4790:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 4791:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 4792: 
 4793:             const double rl1 = length(vec1);
 4794:             const double rl2 = length(vec2);
 4795:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 4796: 
 4797:             const double delta = cross(vec1, vec2);
 4798:             const double sintheta = abs(delta)/(rl1*rl2);
 4799: 
 4800:             // To avoid problems, avoid elements with small angle between vectors
 4801:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 4802:             const bool validEq = (sintheta > sin_one_deg);
 4803: 
 4804:             if (validEq) {
 4805:                // Solve the system of equations to get the density gradient at elem
 4806:                icount++;
 4807:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 4808:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 4809:                sumRx += Rx;
 4810:                sumRy += Ry;
 4811:             }
 4812:          } // for j1
 4813: 
 4814:          // Compute the average density gradient at elem
 4815:          if (icount==0) {
 4816:            // Bad mesh quality; bail out with 0 b-cc
 4817:            elem->gradRho[k] = {0.0, 0.0};
 4818:          } else {
 4819:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 4820:          }
 4821: 
 4822:       } // for k
 4823: 
 4824:    }
 4825: 
 4826:    __global__ void computeBaroclinicTerm(void) {
 4827:    // Computes the baroclinic term at sides (at half levels).
 4828:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 4829:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 4830: 
 4831:       SIDE(side);
 4832: 
 4833:       if (side->isDry) return;
 4834: 
 4835:       const Element *e1 = side->elems[0];
 4836:       const Element *e2 = side->elems[1];      
 4837:       const int kb = side->kb;
 4838:       
 4839:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 4840: 
 4841:       // interpolates vertically the density gradient of the two elements at the half level/
 4842: 
 4843:       // Starts the integration at the surface and goes down to the bottom
 4844:       int k1 = nvrt - 1;
 4845:       int k2 = nvrt - 1;
 4846: 
 4847:       side->bcc[nvrt-1] = {0.0, 0.0};
 4848:       for (int k = nvrt-2; k >= kb; k--) {
 4849:       // For each prism level (from surface to bottom)...
 4850: 
 4851:          // For both elements, interpolate density gradient at the side's half level.
 4852:          // The gradient at the side is the average of the gradients at the elements.
 4853:          // w1, w2 are used to take into account boundary sides, with just one element.
 4854:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 4855:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 4856:          const double wsum = w1 + w2;
 4857:          w1 = w1/wsum;
 4858:          w2 = w2/wsum;
 4859:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 4860: 
 4861:          // Linear interpolation of both elements' density gradient at the shared side's level.
 4862:          Vector2 gradRho = {0.0, 0.0};
 4863:          if (e1 != nullptr && k > kb) {
 4864:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 4865:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 4866:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 4867:             
 4868:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 4869:          }      
 4870:          if (e2 != nullptr && k > kb) {
 4871:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4872:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4873:             
 4874:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4875:          }
 4876: 
 4877:          if constexpr(ics==2) {
 4878:             // IMPLEMENT THIS XXXXXX
 4879:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4880:             // swild(1)=tmp1
 4881:             // swild(2)=tmp2
 4882:          }
 4883:          
 4884:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4885:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4886:          // CHECK INDICES!!! XXX
 4887:          const double grav3 = side->grav3();
 4888:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4889: printf(">>>side->bcc[%d] = %e, %e, rampbc: %e, grav3: %e, rho0: %e, side->Dz(k + 1): %e, gradRho: %e, %e\n", k, side->bcc[k].x, side->bcc[k].y, rampbc, grav3, rho0, side->Dz(k + 1), gradRho.x, gradRho.y);
 4890: 
 4891:       } // for
 4892: 
 4893:    }
 4894: 
 4895: 
 4896: 
 4897:    __global__ void computeHorGradientAtSide(void) {
 4898: 
 4899:       // Compute the horizontal density gradient at each element.
 4900:       // It works in two steps:
 4901:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4902:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4903:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4904:       //             gradRho.r1 = rho1 - rho0
 4905:       //             gradRho.r2 = rho2 - rho0
 4906:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4907:       // 
 4908:       //  NOTE: We use de-meaned densities.
 4909: 
 4910:       SIDE(side);
 4911: 
 4912:       if (side->isDry) return;
 4913: 
 4914:       // Computes the gradient of the variables at the side center.
 4915:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 4916:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 4917:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 4918: 
 4919:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 4920:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 4921:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 4922:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 4923: 
 4924: 
 4925:       printf("gradEta1: %e, %e, gradEta2: %e, %e, gradETP: %e, %e, gradPr: %e, %e\n", 
 4926:          side->gradEta1.x, side->gradEta1.y, 
 4927:          side->gradEta2.x, side->gradEta2.y, 
 4928:          side->gradETP.x, side->gradETP.y, 
 4929:          side->gradPr.x, side->gradPr.y);
 4930: 
 4931: 
 4932:    }
 4933: 
 4934: 
 4935:    __global__ void solveMomentumEquations(double time) {
 4936: 
 4937:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 4938:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 4939: 
 4940:       SIDE(side);
 4941: 
 4942:       if (side->isDry) 
 4943:       {
 4944:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 4945: 
 4946:          return;
 4947:       }
 4948: 
 4949:       const Node *n1 = side->n1;
 4950:       const Node *n2 = side->n2;
 4951: 
 4952:       const int kb = side->kb;
 4953: 
 4954:       const double veg_h = side->veg_h();
 4955:       const double grav3 = side->grav3();
 4956: 
 4957: printf("###>>>#side->is2D() = %d\n", side->is2D());
 4958:       if (side->is2D()) {
 4959:          // Warning: Do not use htot2, which is updated.
 4960:          const double htot = side->htot1();
 4961:          const double hhat = side->hhat;
 4962: printf("htot: %e, hhat: %e\n", htot, hhat);
 4963:          assert(hhat > 0.0 && htot > 0.0 && "Impossible dry 55:");
 4964: 
 4965:          Vector2 tau2 = {0.0, 0.0};
 4966:           
 4967:          if constexpr(ics==1) {
 4968:             tau2 = side->tau();
 4969: 
 4970:          } else {
 4971:             assert(false && "Not implemented: ics == 2");
 4972:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4973:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4974:             // taux2=(vn1+tt1)*0.5d0
 4975:             // tauy2=(vn2+ss1)*0.5d0
 4976:          } // if ics         
 4977: 
 4978:          // hat_gam has units of m/s
 4979: 
 4980:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 4981: 
 4982: printf("coriolisTerm: %e, %e\n", coriolisTerm.x, coriolisTerm.y);
 4983: 
 4984:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 4985:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 4986: 
 4987:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 4988: 
 4989:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvel1, rmaxvel1);
 4990:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvel2, rmaxvel2);
 4991: 
 4992:          for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 4993: 
 4994: printf("###>>>#side->u2[0] = %e, %e, side->u2[1] = %e, %e, hat_gam = %e, %e, hhat = %e, htot = %e\n", side->u2[0].x, side->u2[0].y, side->u2[1].x, side->u2[1].y, side->nuGradU[nvrt-1].x, side->nuGradU[nvrt-1].y, hhat, htot);
 4995: 
 4996:       }
 4997:       else { // 3D
 4998: 
 4999:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5000:          // 
 5001:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5002:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5003:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5004:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5005:          // k+1 and k.
 5006: 
 5007: 
 5008:          // // Define layer thickness & viscosity
 5009:          // for (int k=kb + 1; k<nvrt; k++) {
 5010:          //    const double dzz = side->Dz(k - 1);
 5011: 
 5012:          //    assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5013: 
 5014:          //    // Vertical viscosity at the face center
 5015:          //    dfz(k) = 0.25*(n1->dfv[k] + n2->dfv[k] + n1->dfv[k-1] + n2->dfv[k-1]);
 5016:         
 5017:          // }
 5018: 
 5019: 
 5020:          const int ndim = nvrt - kb;
 5021:          const double zTopCanopy = side->zTopCanopy();
 5022: 
 5023:          // Initialize the tridiagonal system
 5024:          for (int k = kb + 1; k<nvrt; k++) {
 5025:             
 5026:             const int kin = k - kb;
 5027: 
 5028:             // Vertical viscosity at the face center
 5029:             const double dfz = 0.25*(side->dfv(k) + side->dfv(k + 1));
 5030:             const double dzz = side->Dz(k);
 5031: 
 5032:             printf("k: %d, side->zc[0]: %e, side->n1->z[0]: %e, side->n2->z[0]: %e, dzz: %e, dfz: %e\n",k, side->zc[0], side->n1->z[0], side->n2->z[0], dzz, dfz);
 5033:             printf("k: %d, side->zc[1]: %e, side->n1->z[1]: %e, side->n2->z[1]: %e, dzz: %e, dfz: %e\n",k, side->zc[1], side->n1->z[1], side->n2->z[1], dzz, dfz);
 5034:             assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5035: 
 5036:             alow[kin] = 0.0;
 5037:             cupp[kin] = 0.0;
 5038:             bdia[kin] = 0.0;
 5039: 
 5040:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5041:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5042: 
 5043:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5044:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5045:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5046: 
 5047:             // First part: layers k, k+1
 5048:             if (k < nvrt - 1) {
 5049:                              
 5050:                if constexpr(iveg != 0) {
 5051: 
 5052:                   // If there is vegetation at this level...
 5053:                   if (zTopCanopy > side->zc[k]) {
 5054:                      // If the canopy is above the k layer...
 5055:                      
 5056:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5057:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5058:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5059:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5060: 
 5061:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5062:                      const double vmag2 = length(ut2);
 5063:                      const double vmag1 = length(side->u2[k]);
 5064:                      const double vmag = 0.5*(vmag1 + vmag2);
 5065:                      
 5066:                      // Computes the vegetation alpha at the face center
 5067:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5068: 
 5069:                      cff1 += veg_alpha_sd*dt*vmag;
 5070: 
 5071:                   } // if (zTopCanopy
 5072:                } // if iveg
 5073: 
 5074:                const double tmp = dt*dfz/dzz;
 5075:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5076:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5077: printf("####cff1 = %f, dzz = %f, tmp = %f, cupp[%d] = %f, bdia[%d] = %f\n", cff1, dzz, tmp, cupp[kin], kin, bdia[kin]);               
 5078:             }
 5079: 
 5080: 
 5081:             // Second part: layers k-1, k
 5082:             if (k > kb + 1) {
 5083: 
 5084:                double cff1 = 1.0; //init \bar{c^k}
 5085: 
 5086:                if constexpr(iveg != 0) {
 5087:                   // If there is vegetation at this level...
 5088:                   if (zTopCanopy > side->zc[k-1]) {
 5089:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5090:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5091: 
 5092:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5093: 
 5094:                      const double vmag2 = length(ut2);
 5095:                      const double vmag1 = length(side->u2[k-1]);
 5096:                      const double vmag = 0.5*(vmag1 + vmag2);
 5097: 
 5098:                      // Computes the vegetation alpha at the face center
 5099:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5100:                      cff1 += veg_alpha_sd*dt*vmag;
 5101:                   } // if zTopCanopy
 5102: 
 5103:                } // if iveg
 5104: 
 5105:                const double tmp = dt*dfz/dzz;
 5106:                alow[kin] += cff1*dzz/6.0 - tmp;
 5107:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5108: printf("####cff1 = %f, dzz = %f, tmp = %f, alow[%d] = %f, bdia[%d] = %f\n", cff1, dzz, tmp, alow[kin], kin, bdia[kin]);               
 5109:             } else { // Bottom boundary
 5110:                // This occurs at the bottom, where the bottom drag is applied.
 5111: 
 5112:                bdia[kin] += dt*side->chi2;
 5113: printf("####3 k = %d, kb + 1 = %d, nvrt - 1 = %d, chi2 = %f, alow[%d] = %f, bdia[%d] = %f\n", k, kb + 1, nvrt - 1, side->chi2, kin, alow[kin], kin, bdia[kin]);               
 5114:             } // if (k > kb + 1)
 5115: 
 5116: 
 5117: 
 5118:          } // for (int k
 5119: 
 5120: 
 5121: 
 5122:          // Computes the RHS.
 5123:          // -----------------
 5124: 
 5125:          //	BC to be imposed at the end.
 5126: 
 5127:          const Vector2 gradETP  = side->gradETP;
 5128:          const Vector2 gradPr   = side->gradPr;
 5129:          const Vector2 gradEta1 = side->gradEta1;
 5130:          const Vector2 gradEta2 = side->gradEta2;
 5131: 
 5132:          const Vector2 *btu = side->btu;
 5133:          const Vector2 *u2  = side->u2;
 5134:          const double coriolis = side->coriolis;
 5135:          const Vector2 *nuGradU = side->nuGradU;
 5136: 
 5137: 
 5138:          for (int k = kb + 1; k<nvrt; k++) {
 5139:             const int kin = k - kb;
 5140: 
 5141:             const double dz_0 = side->Dz(k);
 5142:             const double dz_1 = side->Dz(k+1);  
 5143: 
 5144:             rrhs[kin] = {0.0, 0.0};
 5145:             double dz = 0.0;
 5146: 
 5147:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5148:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5149:             if (k < nvrt  ) dz += 0.5*dz_1;
 5150:             if (k > kb + 1) dz += 0.5*dz_0;
 5151: 
 5152:             // Elevation gradient, atmospheric pressure and tidal potential
 5153:             rrhs[kin] = -dz*dt*(grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0);
 5154: 
 5155:             // Coriolis, advection, wind stress, and horizontal viscosity
 5156:             if (k < nvrt - 1) {
 5157: 
 5158: 
 5159:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5160:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5161:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5162: 
 5163:                //diff stress tensors 1006
 5164:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5165:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5166:                   assert(false && "Not implemented: itur == 5");
 5167:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5168:                }
 5169: 
 5170:             } else { // k=nvrt
 5171:                Vector2 tau2 = {0.0, 0.0};
 5172:                if constexpr(ics==1) {
 5173:                   tau2 = side->tau();
 5174:                } else {
 5175:                   assert(false && "Not implemented: ics == 2");
 5176:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5177:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5178:                   // taux2=(vn1+tt1)*0.5d0
 5179:                   // tauy2=(vn2+ss1)*0.5d0
 5180:                } // if ics
 5181: 
 5182:                rrhs[kin] += dt*tau2;
 5183: 
 5184:             } // if k<nvrt
 5185: 
 5186:             if (k > kb + 1) {
 5187:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5188:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5189:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5190: 
 5191: 
 5192:                // diff stress tensors 1006
 5193:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5194:                   assert(false && "Not implemented: itur == 5");
 5195:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5196:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5197:                }
 5198: 
 5199:             } // if k>kbs + 1
 5200: 
 5201:             // Baroclinic
 5202:             Vector2 *bcc = side->bcc;
 5203:             if constexpr(ibc == 0) {
 5204:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5205:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5206: 
 5207:             } // if ibc==0
 5208: 
 5209: 
 5210:          } // k=kb + 1,nvrt
 5211: 
 5212: printf("#### bdia[0] = %f, bdia[1] = %f, bdia[2] = %f, bdia[3] = %f\n", bdia[0], bdia[1], bdia[2], bdia[3]);         
 5213:    // tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 5214:          tridag_sch<2>(nvrt, alow, bdia, cupp, (double *)rrhs, (double *)u, (double *)gam);
 5215: printf("::: u[0] = %e, u[1] = %e, u[2] = %e, u[3] = %e\n", u[0], u[1], u[2], u[3]);
 5216: 
 5217: 
 5218:          for (int k=kb + 1; k<nvrt; k++) {
 5219:             const int kin = k - kb;
 5220: 
 5221:             // Velocity is always clamped to maximum values
 5222:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvel1, rmaxvel1), clamp(soln[kin].y, -rmaxvel2, rmaxvel2));
 5223:          } // k
 5224: 
 5225:       } // if side->is2D()
 5226:       
 5227: 
 5228:       // Impose velocity boundary condition at the bottom
 5229:       if constexpr(imm == 2) { // 3D bed deformation model
 5230:          double dep;
 5231:          Vector2 vel;
 5232: 
 5233:          assert(false && "Not implemented: imm == 2");
 5234:          //update_bdef(time, x0, y0, dep, vel);
 5235:          // side->u2[kb] = vel;
 5236: 
 5237:       } else { // imm = 0 or 1
 5238:          if (side->Cd() == 0.0) {
 5239:             side->u2[kb] = side->u2[kb + 1];
 5240:          } else if (nvrt - 1 > kb + 1) { // 3D no slip bottom
 5241:             side->u2[kb] = {0.0, 0.0};
 5242:          }
 5243:           
 5244:       } // if imm
 5245: 
 5246:       // The velocities below the bottom level are set to zero
 5247:       for (int k=0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5248: 
 5249: 
 5250:    }
 5251: 
 5252: 
 5253:    __global__ void applyMomentumBC(void) {
 5254: 
 5255:       SIDE_BND(sideBnd);
 5256: 
 5257:       Side *side = sideBnd->side;
 5258:       const BoundarySegment *segment = sideBnd->segment;
 5259:       const Node *n1 = side->n1;
 5260:       const Node *n2 = side->n2;
 5261: 
 5262:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5263: 
 5264:       // REMEMEBER, this is a trick, segment can be a pointer or (-1, -2)
 5265:       const bool isLand = segment->isLand;
 5266:       const int ifltype = segment->ifltype;
 5267: 
 5268:       const int kb = side->kb;
 5269: 
 5270: printf("ifltype = %d, isLand = %d, segment = %d, ubc = %e,%e\n", ifltype, segment->isLand, segment, sideBnd->ubc[kb].x, sideBnd->ubc[kb].y);    
 5271:       if (!isLand && ifltype != 0) {
 5272:          const Vector2 *ubc = sideBnd->ubc;
 5273:   
 5274:          for (int k=kb; k < nvrt; k++) {
 5275:             
 5276:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5277:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5278: 
 5279:             if (ifltype == -1) {
 5280:                // Flather 1
 5281: 
 5282:                const double depth = side->depth();
 5283: 
 5284:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5285: 
 5286:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5287: 
 5288:                side->u2[k] = vnorm*side->n;
 5289: 
 5290:             } else if (ifltype == -2) { // Discharge
 5291: 
 5292:                const double eta1 = side->eta1();
 5293:                const double eta2 = side->eta2();
 5294:                const double htot = side->htot2();
 5295: 
 5296:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5297:                assert(false && "Not implemented: Discharge bc");
 5298:                // const double dischrg = discharge(eta1);
 5299:                const double dischrg = 0.0; // XXX REMOVE
 5300:                
 5301: 
 5302:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5303: 
 5304:                const double vnorm = dischrg*eta2/htot;
 5305: 
 5306:                side->u2[k] = vnorm*side->n;
 5307: 
 5308: 
 5309:             }
 5310:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5311:                const double vnorm = dot(side->u2[k], side->n);
 5312: 
 5313:                double rat;
 5314:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5315:                else              rat = segment->vobc2; // outgoing
 5316: 
 5317:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5318:             }
 5319:             else { // not Flather or 3D radiation
 5320:                side->u2[k] = ubc[k];
 5321: printf("****** idx = %d, k = %d, side->idx = %d, ubc = %e,%e\n", side->idx, k, side->idx, ubc[k].x, ubc[k].y);               
 5322: 
 5323:             } // if (segment->ifltype...
 5324: 
 5325:          }
 5326: 
 5327:       }
 5328:       else if (isLand) { // if it is land boundary side
 5329: 
 5330:          if constexpr(islip == 0) { // free slip
 5331:             for (int k=kb; k < nvrt; k++) {
 5332:                double vnorm = 0.0; // for most cases
 5333:                const double vtan = dot(side->u2[k], side->t());
 5334:                const Vector2 t = side->t();
 5335:                const Vector2 n = side->n;
 5336: printf("islip   = %d, k = %d, side->idx = %d, u2 = %f,%f, vtan*t - vnorm*n = %f,%f\n", islip, k, side->idx, side->u2[k].x, side->u2[k].y, (vtan*t - vnorm*n).x, (vtan*t - vnorm*n).y);      
 5337:                side->u2[k] = vtan*t - vnorm*n;
 5338: printf("islipXX = %d, k = %d, side->idx = %d, u2 = %f,%f, vtan*t - vnorm*n = %f,%f\n", islip, k, side->idx, side->u2[k].x, side->u2[k].y, (vtan*t - vnorm*n).x, (vtan*t - vnorm*n).y);                     
 5339:             }
 5340: 
 5341:          } else { // no slip
 5342:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5343: 
 5344:          }
 5345:       } // if (side segment type...
 5346: 
 5347:    
 5348: 
 5349:    }
 5350: 
 5351: 
 5352:    __global__ void shapiroFilter1(void) {
 5353:       // First step of the Shapiro filter (normally used if indvel<=0)
 5354:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5355: 
 5356:       SIDE(side);
 5357: 
 5358:       // Only internal wet sides are processed
 5359:       if (side->isDry || !(side->isInternal())) return;
 5360: 
 5361:       const int kb = side->kb;
 5362: 
 5363:       for (int mm = 1; mm <= niter_shap; mm++) {
 5364: 
 5365:          for (int k = kb + 1; k < nvrt; k++) {
 5366:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5367:             side->bcc[k] = {0.0, 0.0};
 5368:             Vector2 suru = {0.0, 0.0};
 5369: 
 5370:             for (int j=0; j<4; j++) { // 4 neighbors per side
 5371: 
 5372:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5373: printf("idx = %d, j = %d,nSide->idx = %d, nSide->u2[k] = %e,%e\n", side->idx, j, nSide->idx, nSide->u2[k].x, nSide->u2[k].y);
 5374: 
 5375:                int kin = k;
 5376:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5377:                
 5378:                if constexpr(ics==1) {
 5379:                   suru += nSide->u2[kin];
 5380: 
 5381:                } else {
 5382:                   assert(false && "Not implemented: ics == 2");
 5383:                   // Vector2 vn1, vn2;
 5384:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5385:                   // suru=suru+vn1;
 5386:                   // surv=surv+vn2;
 5387:                }
 5388:             }
 5389: 
 5390: 
 5391:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5392: printf("NNNN idx = %d, suru = %f,%f, side->u2[k] = %f,%f, side->bcc[k] = %f,%f\n", side->idx, suru.x, suru.y, side->u2[k].x, side->u2[k].y, side->bcc[k].x, side->bcc[k].y);            
 5393: 
 5394:          }
 5395:       }
 5396:    }
 5397: 
 5398:    __global__ void shapiroFilter2(void) {
 5399:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5400: 
 5401:       SIDE(side);
 5402: 
 5403:       if (side->isDry || !(side->isInternal())) return;
 5404: 
 5405:       const int kb = side->kb;
 5406: 
 5407:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5408: 
 5409:       if (side->is2D()) {
 5410:          // side->u2[kb] = side->u2[nvrt - 1];
 5411:          side->u2[kb + 1] = side->bcc[kb + 1];
 5412:          side->u2[kb    ] = side->u2 [nvrt - 1];
 5413: 
 5414:       } else {
 5415:          // 3D
 5416:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5417:          
 5418:       }
 5419: 
 5420:    }
 5421: 
 5422: 
 5423:    __global__ void ul0UpdateZCoords(void) {
 5424:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5425:       
 5426:       NODE(node);      
 5427: 
 5428:       if (node->isDry2()) { 
 5429: 
 5430:          assert((ivcor != 2) && (node->depth < mesh->h_s) && "Deep depth dry");
 5431: 
 5432:          if constexpr(ivcor != 1) node->kb = 0;
 5433: 
 5434:       } else {
 5435: 
 5436:          node->updateKb();
 5437:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5438: for (int k = node->kb; k < nvrt; k++) printf("k = %d, node->kb = %d, node->z[k] = %f\n", k, node->kb, node->z[k]);
 5439: 
 5440:       } // if wet or dry
 5441: 
 5442:       // We use the temp.b field to store the previous state of isDry.
 5443:       node->tmp.b = node->isDry;
 5444: 
 5445:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5446:       node->isDry = true;
 5447: 
 5448:    }
 5449: 
 5450:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5451:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5452:    {
 5453:       ELEM(elem);
 5454: 
 5455:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5456: 
 5457:       // All the nodes of a wet element are wet.
 5458:       if (!elem->isDry) {
 5459:          elem->nodes[0]->isDry = false;
 5460:          elem->nodes[1]->isDry = false;
 5461:          elem->nodes[2]->isDry = false;
 5462:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 5463: 
 5464:       }
 5465: 
 5466: 
 5467:       elem->kb = 0;
 5468: 
 5469:       if (elem->isDry) return;
 5470: 
 5471:       // Wet
 5472:       const Node *n1 = elem->nodes[0];
 5473:       const Node *n2 = elem->nodes[1];
 5474:       const Node *n3 = elem->nodes[2];  
 5475:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5476: 
 5477:    //    if(elem->isDry2()) {
 5478:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5479:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5480:    //        call parallel_abort(errmsg)
 5481:    //    }
 5482: 
 5483: 
 5484:       // Computes element's kb as the minimum of the nodes' kb.
 5485:       const int kb1 = n1->kb;
 5486:       const int kb2 = n2->kb;
 5487:       const int kb3 = n3->kb;
 5488:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5489: 
 5490: printf("kb1 = %d, kb2 = %d, kb3 = %d, kb4 = %d\n", kb1, kb2, kb3, kb4);
 5491: 
 5492:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5493: 
 5494: 
 5495:       // Computes the element z as the mean of the nodes z.
 5496:       for (int k = elem->kb; k < nvrt; k++) {
 5497: 
 5498:          // Compute the element z as the mean of the nodes z.
 5499:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5500:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5501:          elem->z[k] /= elem->i34;
 5502: 
 5503:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5504:       }
 5505:                   
 5506:    }
 5507: 
 5508:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5509:    {
 5510:       NODE(node);
 5511:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5512: 
 5513:       if (it == iths) return;
 5514: 
 5515: 
 5516:       if(!node->isDry && node->tmp.b) { // rewetted
 5517:          for (int k=0; k < nvrt; k++) {
 5518: 
 5519:             Vector3 utmp={0.0, 0.0, 0.0};
 5520: 
 5521:             double ttmp=0.0;
 5522:             double stmp=0.0;
 5523:             int icount=0;
 5524:             for (int j = 0; j < node->numNodes; j++) {
 5525: 
 5526: 
 5527:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5528:                if (!node->isDry) { // all indices extended
 5529:                   icount++;
 5530: 
 5531:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5532:                   utmp += node->u2[k];
 5533:                   
 5534:                   ttmp += node->tracers[k].tracer[0]; 
 5535:                   stmp += node->tracers[k].tracer[1]; 
 5536:                }
 5537:             }
 5538: 
 5539:             if(icount > 0) {
 5540:                const double inv_icount = 1.0/icount;
 5541:                node->u2[k]     = inv_icount*utmp;
 5542:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5543:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5544:             }
 5545:          }
 5546:       }
 5547:    }
 5548: 
 5549: 
 5550:    __global__ void ul0UpdateSides(int it, int iths) {
 5551: 
 5552:       SIDE(side);
 5553: 
 5554:       // A side is wet if and only if at least one of its elements is wet.
 5555:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5556: 
 5557:       const Node *n1 = side->n1;
 5558:       const Node *n2 = side->n2;
 5559:       const int kb1 = n1->kb;
 5560:       const int kb2 = n2->kb;
 5561: 
 5562:       side->kb = 0; // dry
 5563: 
 5564:       if (isWet) {
 5565: 
 5566:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5567: 
 5568:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5569: 
 5570:          side->kb = min(kb1, kb2);
 5571: 
 5572:          for (int k = side->kb; k < nvrt; k++) {
 5573:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5574: 
 5575:          
 5576:             assert((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0) && "Weird side (3)");
 5577: 
 5578:             // Compute velocity for re-wetted sides 
 5579:             if ((it != iths) && (side->isDry && isWet)) {
 5580:             
 5581:                Vector2 utmp={0.0, 0.0};
 5582: 
 5583:                int icount=0;
 5584: 
 5585:                // For all the sides on the two elements that share this side
 5586:                for (int j=0; j < 2; j++) {
 5587:                   const Element *elem = side->elems[j];
 5588:                   if (elem == nullptr) continue;
 5589: 
 5590:                   for (int jj=0; jj < elem->i34; jj++) {
 5591:                      const Side *nSide = elem->sides[jj];
 5592:                      if (nSide->isDry) continue;
 5593: 
 5594:                      icount++;
 5595:                      utmp += nSide->u2[k];                     
 5596:                   }
 5597:                }
 5598:                   
 5599:                assert(icount > 0 && "No wet sides around this side");
 5600:                if (icount > 0)  side->u2[k] = utmp/icount;
 5601:                   
 5602:             } // if ((it != iths) && (side->isDry && isWet))
 5603: 
 5604:          } // for k
 5605: 
 5606:       } // if isWet
 5607:    
 5608:       side->isDry = !isWet;
 5609: 
 5610:    }
 5611: 
 5612: 
 5613:    __global__ void zeroNodalVelocities(void) {
 5614:       NODE(node);
 5615: 
 5616:       for (int k = 0; k < nvrt; k++) {
 5617:          node->u2[k] = {0.0, 0.0, 0.0};
 5618:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5619:       }
 5620:    }
 5621: 
 5622:    __global__ void computeNodalVerticalVelocities1(void) {
 5623:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5624:    // Adds the element's vertical velocity times the element's area.
 5625:       ELEM(elem);
 5626: 
 5627:       for (int j = 0; j < elem->i34; j++) {
 5628:          Node *node = elem->nodes[j];
 5629: 
 5630:          for (int k = node->kb; k < nvrt; k++) {
 5631:             node->u2[k].z += elem->w[k]*elem->area;
 5632:             node->tmp.d += elem->area;
 5633:          }
 5634:       }
 5635:    }
 5636: 
 5637:    __global__ void computeNodalVerticalVelocities2(void) {
 5638:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5639:    // Divides by the total area of the elements sharing the    node.
 5640:       ELEM(elem);
 5641: 
 5642:       for (int j = 0; j < elem->i34; j++) {
 5643:          Node *node = elem->nodes[j];
 5644: 
 5645:          for (int k = node->kb; k < nvrt; k++) node->u2[k].z /= node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5646:       }
 5647:    }
 5648: 
 5649:    __global__ void computeNodalHorizontalVelocities(void) {
 5650:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 5651:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 5652:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 5653: 
 5654:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 5655: 
 5656:       SIDE(side);
 5657: 
 5658:       const int kb = side->kb;
 5659: 
 5660:       Node *n1 = side->n1;
 5661:       Node *n2 = side->n2;
 5662: 
 5663:       for (int k = kb; k < nvrt; k++) {
 5664: 
 5665:          // Cast the u2 vector into a Vector2 
 5666:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&n1->u2[k]);
 5667:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&n2->u2[k]);
 5668: 
 5669:          n1_u2 += side->u2[k]/n1->numSides;
 5670:          n2_u2 += side->u2[k]/n2->numSides;
 5671: 
 5672:       }
 5673: 
 5674: 
 5675:    }
 5676: 
 5677:    __global__ void resetVelocityOpenBndNodes(void) {
 5678:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 5679: 
 5680:       NODE_BND(nodebnd);
 5681: 
 5682:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 5683:          for (int k = 0; k < nvrt; k++) nodebnd->node->u2[k] = {0.0, 0.0, 0.0};
 5684:       }
 5685: 
 5686:    }
 5687: 
 5688: 
 5689:    __global__ void setVelocityOpenBndNodes(void) {
 5690:    // For open boundary nodes sets their velocity to the imposed values.
 5691: 
 5692:       SIDE_BND(sidebnd);
 5693: 
 5694:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 5695:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 5696:          // to its segment to the average of the side velocity.
 5697: 
 5698:          for (int k = 0; k < nvrt; k++) {
 5699:             Node *n1 = sidebnd->side->n1;
 5700:             Node *n2 = sidebnd->side->n2;
 5701: 
 5702:             // Cast the u2 vector into a Vector2 
 5703:             Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&n1->u2[k]);
 5704:             Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&n2->u2[k]);
 5705: 
 5706:             if (n1->nodeBnd->segment == sidebnd->segment) n1_u2 += sidebnd->side->u2[k]/n1->nodeBnd->numSidesForAverage();
 5707:             if (n2->nodeBnd->segment == sidebnd->segment) n2_u2 += sidebnd->side->u2[k]/n2->nodeBnd->numSidesForAverage();
 5708:          }
 5709:       }
 5710: 
 5711:    }
 5712: 
 5713: 
 5714:    __global__ void computeVerticalVelocity(void) {
 5715:       // Computes the vertical velocity at the (2D) element's centroid.
 5716:       // In this function we will be considering volumetric elements, with side faces and a 
 5717:       // bottom and a top face. We will call them SFs, BF and TF.
 5718:       // It computes the flux coming from BF and the SFs.
 5719:       // If the bed is moving, it takes that into account.
 5720:       // Since water is incompressible, the integral of the velocity times the normal vector
 5721:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 5722:       // and the BF is equal to the flux going out from the TF.
 5723:       // TF = - BF - sum(SFs).
 5724:       // It then computes the horizontal velocity at the center of TF.
 5725:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 5726:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 5727:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 5728: 
 5729:       ELEM(elem);
 5730: 
 5731:       if (elem->isDry) return;
 5732: 
 5733:       const int kb = elem->kb;
 5734:       const bool isTri = elem->isTri();
 5735: 
 5736:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 5737: 
 5738:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 5739:       const double av_bdef1 = elem->mean(&Node::bdef1);
 5740:       const double av_bdef2 = elem->mean(&Node::bdef2);
 5741: 
 5742:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 5743: 
 5744:       double area3D;
 5745: 
 5746:       // Bottom face flux
 5747:       double bottomFlux = 0.0;
 5748:       Vector2 u2meanBottom = {0.0, 0.0};
 5749:       const Vector2 gradh = elem->grad2(&Node::depth);
 5750:       if constexpr(imm==2) {
 5751:          Vector3 ubed;
 5752: 
 5753:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 5754:          // updateBDEF(ubed);
 5755:      
 5756:          // const double bflux0 = dot(ubed, elem_n1);
 5757: 
 5758:          // elem->w[kb] += ubed.z;
 5759:       }
 5760:       else {
 5761:          Vector2 umean;
 5762:          if constexpr(ics == 1) {
 5763:             u2meanBottom = elem->mean(kb, &Side::u2);
 5764:          }
 5765:          else {
 5766:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 5767:          }
 5768: 
 5769:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 5770:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 5771: 
 5772:          bottomFlux = - dot(gradh, u2meanBottom);
 5773:       } // if imm
 5774: 
 5775:       // Compute w for kb+1 to nvrt-1
 5776:       for (int l = kb; l < nvrt - 1; l++) {
 5777: 
 5778:          // normal vector to the top face of the "volumetric" element (3D)
 5779:          Vector3 elem_n2 = elem->n(l + 1, area3D); 
 5780: 
 5781:          // Compute the total flux at the sides
 5782:          double sideFlux = 0.0;
 5783:          Vector2 u2top = {0.0, 0.0};
 5784:          for (int j = 0; j < elem->i34; j++) {
 5785:             const Side *side = elem->sides[j];
 5786: 
 5787:             const double sideArea = side->area(l + 1);
 5788:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 5789:             const double sign = elem->ssign[j]; 
 5790: 
 5791:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 5792:          }
 5793:          
 5794:          // Compute the horizontal velocity at the center of the top face as an average of the 
 5795:          //velocities at the centers of the sides
 5796:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 5797: 
 5798:          // The flx at the top ace can be computed from the other flows.
 5799:          const double topFlux = - sideFlux - bottomFlux;
 5800:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 5801: 
 5802:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 5803: printf("sideFlux = %f, topHorizontalFlux = %f, bottomFlux = %f, area3D = %f, elem->w[%d] = %.16f, elem_n2.z = %f\n", sideFlux, topHorizontalFlux, bottomFlux, area3D, l + 1, elem->w[l + 1], elem_n2.z);
 5804:          elem_n1 = elem_n2;
 5805: 
 5806:          bottomFlux = - topFlux;
 5807:       }
 5808:    }  
