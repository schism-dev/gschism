 8337: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 8338:    Node *nodes = mesh->localNodeData;
 8339: 
 8340:    *addr = nodes;
 8341:    *sizeNode = sizeof(Node);
 8342: 
 8343:    switch (varCode) {
 8344:       case (int)VarCode::depth:
 8345:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 8346:          *sizeType = sizeof(double);
 8347:          break;
 8348:       case (int)VarCode::eta:
 8349:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 8350:          *sizeType = sizeof(double);
 8351:          break;
 8352:       case (int)VarCode::x:
 8353:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 8354:          *sizeType = sizeof(Vector2);
 8355:          break;
 8356:       case (int)VarCode::kb:
 8357:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 8358:          *sizeType = sizeof(int);
 8359:          break;
 8360:       case (int)VarCode::isdry:
 8361:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 8362:          *sizeType = sizeof(int);
 8363:          break;         
 8364:       case (int)VarCode::w:
 8365:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 8366:          *sizeType = sizeof(double);
 8367:          break;
 8368:       case (int)VarCode::u:
 8369:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 8370:          *sizeType = sizeof(Vector2);
 8371:          break;         
 8372:       default:
 8373:          *offset = -1;    
 8374:    }  
 8375:    
 8376: }
