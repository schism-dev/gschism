 2614: 
 2615: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2616: 
 2617: 
 2618: __device__ void Node::updateKb(void) {
 2619: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2620: 
 2621:    if constexpr(ivcor == 1) return;
 2622: 
 2623: 
 2624:    // Check if node is wet
 2625:    const bool isDry = (htot2() <= h0);  // XXX Check if we are doing this elsewhere
 2626: 
 2627:    if (isDry) return;
 2628: 
 2629:    if constexpr(ivcor == 2) {  // SZ coordinates
 2630:       
 2631:       // Compute bottom level index
 2632:       if (depth <= mesh->h_s) {
 2633:          kb = mesh->kz - 1;
 2634:       } else {
 2635:          kb = -1;
 2636:          int L = 0;
 2637:          int R = mesh->kz - 2;  // We check up to kz-2 since we access i+1
 2638:          
 2639:          while (L <= R) {
 2640:             int M = (R + L) / 2;
 2641: 
 2642:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2643:             
 2644:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2645:                R = M;
 2646:             } else {
 2647:                L = M;
 2648:             }
 2649: 
 2650:             if (R - L == 1) {
 2651:                kb = L;
 2652:                break;
 2653:             }
 2654:          }
 2655:       }
 2656:    } 
 2657: }
 2658: 
 2659: 
 2660: __device__ double Node::compZCoord(int k) const {
 2661:    // Computes the z coordinate at level k.
 2662:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2663:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2664:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2665:    // used 
 2666:    
 2667:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2668:       
 2669:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2670: 
 2671:    if constexpr(ivcor == 2) {
 2672: 
 2673:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2674:       const int kz = mesh->kz;
 2675:       const double h_c = mesh->h_c;
 2676:       const double theta_f = mesh->theta_f;
 2677:       const double sinh_theta_f = mesh->sinh_theta_f;
 2678: 
 2679:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2680:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2681:       // once per time step/node.
 2682:       // CHECK: updateZCoordData
 2683: 
 2684:       if      (k == nvrt-1)      { return eta2; }
 2685:       else if (k == kz)          return -hmod2;
 2686:       else if (k == kb)          return -depth;
 2687:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2688:       else if (k > kz) {
 2689:          const int ksig = k - kz + 1;
 2690: 
 2691:          if (hmod2 <= h_c) {
 2692:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2693:          } 
 2694:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2695:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2696:             assert(false && "ZCOOR: invalid h_c\n");
 2697:          } 
 2698:          else {
 2699:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2700:                          h_c * mesh->sigma[ksig] + 
 2701:                          (hmod2 - h_c) * mesh->cs[ksig];
 2702:          }
 2703:       } else { 
 2704:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2705:       }
 2706: 
 2707:    }
 2708:    else if constexpr(ivcor == 1) {
 2709:       if (k == kb) return -depth;
 2710:       else if (k == nvrt-1) return eta2;
 2711:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2712:    }
 2713:    
 2714:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2715:    return 0.0;
 2716: }
 2717: 
 2718: 
 2719: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2720:    // Checks if a side in on the boundary
 2721:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2722: 
 2723:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2724:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2725: 
 2726:    // Indices of the nodes that form the side
 2727:    const int n1 = side.n1->idx;
 2728:    const int n2 = side.n2->idx;
 2729: 
 2730:    // Check if the side is on a land boundary
 2731:    for (int i = 0; i < nland; i++) {
 2732:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2733:          // Consecutive nodes in the land boundary segment
 2734:          const int b1 = ilnd[i*mnlnd + j];
 2735:          const int b2 = ilnd[i*mnlnd + j + 1];
 2736: 
 2737:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2738:             isLand = true;
 2739:             return i;
 2740:          }
 2741:       }
 2742:    }
 2743: 
 2744:    // Check if the side is on an open boundary
 2745:    for (int i = 0; i < nope; i++) {
 2746:       for (int j = 0; j < nond[i] - 1; j++) {
 2747:          // Consecutive nodes in the open boundary segment
 2748:          const int b1 = iond[i*mnond + j];
 2749:          const int b2 = iond[i*mnond + j + 1];
 2750: 
 2751:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2752:             isLand = false;
 2753:             return i;
 2754:          }
 2755:       }
 2756:    }
 2757:    return -1;
 2758: }
