 4006: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 4007:                 double *node_coords, double *node_coords_ll, bool use_ll,
 4008:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 4009:                 int *isdel, int *isidenode, int *isbnd,
 4010:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 4011:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4012:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4013:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4014:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4015:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 4016:                 double *drag, double *roughness,
 4017:                 double *emo, double *efa, 
 4018:                 double *umo, double *ufa, 
 4019:                 double *vmo, double *vfa) {
 4020: 
 4021:    printf("Populating mesh for partition %d\n", partNum);
 4022: 
 4023:    // XXXXXX THIS function does almost nothing. 
 4024: 
 4025:    nbs = *sharedIdxSideBoundary + 1;
 4026:    nbp = *sharedIdxNodeBoundary + 1;
 4027: 
 4028:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 4029: 
 4030: }
