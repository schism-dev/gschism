 1323: 
 1324:    int ifltype;  // Type of flow boundary condition
 1325:    
 1326:    // Elevation boundary condition
 1327:    int iettype;  // Type of elevation boundary condition
 1328:    double eth;   // Elevation time history
 1329: 
 1330:    // Flow boundary condition
 1331:    double qthcon;  // Flow time history constant
 1332:    double vobc1;   // Velocity coefficient 1
 1333:    double vobc2;   // Velocity coefficient 2
 1334: 
 1335:    // Tracer boundary conditions
 1336:    // double trobc[natrm];    // Tracer boundary condition nudging factor
 1337:    // int  itrtype[natrm];    // Tracer boundary condition type
 1338: 
 1339:    BoundarySegment(bool _isLand) {
 1340:       isLand = _isLand;
 1341:       clen = 0.0;
 1342:       carea = 0.0;
 1343:       ifltype = 0;
 1344:       iettype = 0;
 1345:       eth = 0.0;
 1346:    }
 1347: 
 1348:    BoundarySegment(void) {
 1349:       isLand = false;
 1350:       clen = 0.0; 
 1351:       carea = 0.0;
 1352:       ifltype = 0;
 1353:       iettype = 0;
 1354:       eth = 0.0;
 1355:    }
 1356: 
