 1102: struct Node {
 1103: 
 1104:    // Geometry information
 1105:    int idx;        // Index of the node
 1106:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1107:    int numNodes;   // Number of nodes neighbors of this node
 1108: 
 1109:    Element **elements; // Array of pointers to the elements that share this node
 1110:    int numElements;    // Number of elements that share this node
 1111: 
 1112:    int numSides;       // Number of sides that are connected to this node
 1113: 
 1114:    Point3 p;
 1115:    Vector3 u2[nvrt];
 1116:    double z[nvrt];
 1117:    double lon, lat;
 1118:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1119:    double depth;
 1120: 
 1121:    int kb;       // Bottom index of the node
 1122: 
 1123:    bool isDry;     // True if the node is dry
 1124: 
 1125:    int iadv;     // Advection flag
 1126: 
 1127:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1128:                           // this is nullptr
 1129: 
 1130:    TempVar tmp; // Temporary variable to store different types of variables
 1131: 
 1132:    // Physical information
 1133:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1134:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1135: 
 1136:    double rho[nvrt];     // Density
 1137:    double dfv[nvrt];     // Vertical viscosity
 1138: 
 1139:    double eta1; // Elevation at nodes at previous timestep
 1140:    double eta2; // Elevation at nodes at current timestep
 1141: 
 1142:    double ETP;  // Earth Tidal Potential
 1143: 
 1144:    double pr;    // Air pressure
 1145:    double grav2; // Gravity 
 1146:    
 1147:    Vector2 dav;  // Depth averaged velocity
 1148: 
 1149:    Vector2 tau; // Wind stress vector
 1150: 
 1151:    // Vegetation parameters
 1152:    double veg_h;
 1153:    double veg_nv;
 1154:    double veg_di;
 1155:    double veg_Cd;
 1156:    double veg_h_unbent;
 1157:    double veg_di_unbent;
 1158:    double veg_nv_unbent;
 1159:    double veg_alpha_vert_mean;
 1160:    double veg_alpha0;
 1161:    double veg_alpha3D[nvrt];
 1162: 
 1163:    // Bottom drag parameters
 1164:    double Cd;       // Bottom drag coefficient
 1165:    double rough;    // Bottom roughness length
 1166:    Vector2 tau_bot; // Bottom stress vector
 1167: 
 1168:    double bdef1; // Bottom deformation at previous timestep
 1169:    double bdef2; // Bottom deformation at current timestep
 1170: 
 1171:    double qel; // RHS
 1172:    double coeffDiag; // Diagonal coefficient of the matrix
 1173:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1174: 
 1175:    double mP; // Search direction for conjugate gradient method
 1176:    double mR; // Residual for conjugate gradient method
 1177:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1178:    double mX; // Solution for conjugate gradient method
 1179: 
 1180:    // Meteorological forcing
 1181:    Vector2 u_air;
 1182:    double p_air;
 1183:    double t_air;
 1184:    double q_air;
 1185:    double wind_angle;  // Wind rotation angle
 1186: 
 1187:    __device__ void setWind(Vector2 &u) {
 1188:    // Sets the wind vector taking into account the wind rotation angle
 1189:    
 1190:       const double dir = atan2(-u.x,-u.y);
 1191:       const double speed = length(u);
 1192: 
 1193:       // Calculate new u and v components with added rotation angle
 1194:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1195:    }
 1196: 
 1197:    __device__ Point2 p2(void) const { return {p.x, p.y}; }
 1198:    __device__ Point3 p3(int k) const { return {p.x, p.y, z[k]}; }
 1199: 
 1200:    __device__ double sigmaTransitionDepth(void) const;
 1201: 
 1202:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1203:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1204:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1205: 
 1206:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1207: 
 1208:    __device__ void clearMatrixRow(void) {
 1209:       // Clear the matrix row for this node
 1210:       coeffDiag = 0.0;
 1211:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1212: 
 1213:    }
 1214: 
 1215:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1216:       // Add the value to the sparse matrix for this node
 1217:       
 1218:       if (node == this) {
 1219:          coeffDiag += value;
 1220: printf("addToSparseMatrix: node == this, value = %f\n", coeffDiag);         
 1221:       } else {
 1222:          // Search (linearly)the index of the node in the array of nodes
 1223:          // XXX: This is not efficient, see if we can improve this
 1224:          int i;
 1225:          for (i = 0; i < numNodes; i++) {
 1226:             if (nodes[i] == node) {
 1227:                break;
 1228:             }
 1229:          }
 1230:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1231:          coeffMatrix[i] += value;
 1232:       }
 1233:    }
 1234: 
 1235: #ifdef BACKTRACKING
 1236:    __device__ void updateZCoordData() {
 1237:    // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 1238: 
 1239:       // Check if node is wet
 1240:       isDry = (depth + eta2 <= h0);  // XXX Check if we are doing this elsewhere
 1241: 
 1242:       if (idry) return;
 1243: 
 1244:       if constexpr(ivcor == 2) {  // SZ coordinates
 1245:          
 1246:          // Compute bottom level index
 1247:          if (depth <= mesh->h_s) {
 1248:                kb = mesh->nzlevels;
 1249:          } else {
 1250:                kb = -1;
 1251:                for (int i = 0; i < mesh->kz-1; i++) {
 1252:                   if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 1253:                      kb = i;
 1254:                      break;
 1255:                   }
 1256:                }
 1257:          }
 1258:       } 
 1259:       else if (ivcor == 1) {  // Localized sigma
 1260:          // Do nothing
 1261:       }
 1262: 
 1263:    }
 1264: #endif   
 1265: 
 1266:    __device__ double compZCoord(int k) const;
 1267: 
 1268:    __device__ void updateKb(void);
 1269: 
 1270: 
 1271: 
 1272: };
