 1075: struct BoundarySegment {
 1076: 
 1077:    bool isLand;
 1078: 
 1079:    double clen;  // Length of the boundary segment
 1080:    double carea; // Area of the boundary segment
 1081: 
 1082:    int ifltype;  // Type of flow boundary condition
 1083:    
 1084:    // Elevation boundary condition
 1085:    int iettype;  // Type of elevation boundary condition
 1086:    double eth;   // Elevation time history
 1087: 
 1088:    // Flow boundary condition
 1089:    double qthcon;  // Flow time history constant
 1090:    double vobc1;   // Velocity coefficient 1
 1091:    double vobc2;   // Velocity coefficient 2
 1092: 
 1093:    // Tracer boundary conditions
 1094:    // double trobc[natrm];    // Tracer boundary condition nudging factor
 1095:    // int  itrtype[natrm];    // Tracer boundary condition type
 1096: 
 1097:    BoundarySegment(bool _isLand) {
 1098:       isLand = _isLand;
 1099:       clen = 0.0;
 1100:       carea = 0.0;
 1101:       ifltype = 0;
 1102:       iettype = 0;
 1103:       eth = 0.0;
 1104:    }
 1105: 
 1106:    BoundarySegment(void) {
 1107:       isLand = false;
 1108:       clen = 0.0; 
 1109:       carea = 0.0;
 1110:       ifltype = 0;
 1111:       iettype = 0;
 1112:       eth = 0.0;
 1113:    }
 1114: 
 1115:    
 1116: };
