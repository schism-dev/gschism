 3801: 
 3802: __device__ void Node::updateKb(void) {
 3803: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3804: 
 3805:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3806: 
 3807: 
 3808:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3809: 
 3810:    if constexpr(ivcor == 2) {  // SZ coordinates
 3811:       
 3812:       // Compute bottom level index
 3813:       if (depth <= mesh->h_s) {
 3814:          kb = izlev;   
 3815:          
 3816:       } else {
 3817:          kb = -1;
 3818:          int L = 0;
 3819:          int R = nzlev; 
 3820:          
 3821:          while (L <= R) {
 3822:             int M = (R + L) / 2;
 3823: 
 3824: 
 3825:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3826:             
 3827:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3828:                R = M;
 3829:             } else {
 3830:                L = M;
 3831:             }
 3832: 
 3833:             if (R - L == 1) {
 3834:                kb = L;
 3835:                break;
 3836:             }
 3837:          }
 3838: 
 3839:          // Checks that the binary search was successful
 3840:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3841:        
 3842:       }
 3843:    } 
 3844: }
