  197: // VECTOR/POINT operations ---------------------------------------------------------------------------
  198: 
  199: using Vector2 = double2; 
  200: using Vector3 = double4;
  201: using Point2  = double2;
  202: using Point3  = double4;
  203: 
  204: __device__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
  205:     return make_double2(a.x + b.x, a.y + b.y);
  206: }
  207: // using Vector2 = double2;  XXXX
  208: // using Vector3 = double4;
  209: __device__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
  210:     a.x += b.x;
  211:     a.y += b.y;
  212:     return a;
  213: }
  214: 
  215: __device__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
  216:     return make_double2(a.x - b.x, a.y - b.y);
  217: }
  218: 
  219: __device__ __forceinline__ double2 operator-=(double2& a, const double2& b) {
  220:     a.x -= b.x;
  221:     a.y -= b.y;
  222:     return a;
  223: }
  224: 
  225: __device__ __forceinline__ double2 operator*(const double2& v, const double s) {
  226:     return make_double2(v.x * s, v.y * s);
  227: }
  228: 
  229: __device__ __forceinline__ double2 operator*(const double s, const double2& v) {
  230:     return v * s;  // reuse the previous operator
  231: }
  232: 
  233: __device__ __forceinline__ double2 operator/(const double2& v, double s) {
  234:     return make_double2(v.x / s, v.y / s);
  235: }
  236: 
  237: __device__ __forceinline__ double norm2(const double2& v) {
  238:     return v.x*v.x + v.y*v.y;
  239: }
  240: 
  241: __device__ __forceinline__ double length(const double2& v) {
  242:     return sqrt(v.x*v.x + v.y*v.y);
  243: }
  244: 
  245: __device__ __forceinline__ double length(const double4& v) {
  246:    return sqrt(v.x*v.x + v.y*v.y + v.z*v.z);
  247: }
  248: 
  249: __device__ __forceinline__ double2 normalize(const double2& v) {
  250:     return v / length(v);
  251: }
  252: 
  253: __device__ __forceinline__ double dot(const double2& v, const double2& w) {
  254:     return v.x*w.x + v.y*w.y;
  255: }
  256: 
  257: 
  258: __device__ __forceinline__ double cross(const double2& v, const double2& w) {
  259:     return v.x*w.y - v.y*w.x;
  260: }
  261: 
  262: __device__ __forceinline__ double2 rot90(const double2& a) {
  263:     return make_double2(a.y, -a.x);
  264: }
  265: 
  266: __device__ __forceinline__ double4 operator+(const double4& a, const double4& b) {
  267:     return {a.x + b.x, a.y + b.y, a.z + b.z, a.w + b.w};
  268: }
  269: 
  270: __device__ __forceinline__ double4 operator+=(double4& a, const double4& b) {
  271:     a.x += b.x;
  272:     a.y += b.y;
  273:     a.z += b.z;
  274:     a.w += b.w;
  275:     return a;
  276: }
  277: 
  278: __device__ __forceinline__ double4 operator-(const double4& a, const double4& b) {
  279:     return {a.x - b.x, a.y - b.y, a.z - b.z, a.w - b.w};
  280: }
  281: 
  282: __device__ __forceinline__ double4 operator*(const double4& v, double s) {
  283:     return {v.x * s, v.y * s, v.z * s, v.w * s};
  284: }
  285: 
  286: __device__ __forceinline__ double4 operator*(double s, const double4& v) {
  287:     return v * s;
  288: }
  289: 
  290: __device__ __forceinline__ double4 operator/(const double4& v, double s) {
  291:     return {v.x / s, v.y / s, v.z / s, v.w / s};
  292: }
  293: 
  294: __device__ __forceinline__ double dot(const double4& v, const double4& w) {
  295:     return v.x*w.x + v.y*w.y + v.z*w.z + v.w*w.w;
  296: }
  297: 
  298: __device__ __forceinline__ double norm2(const double4& v) {
  299:     return v.x*v.x + v.y*v.y + v.z*v.z + v.w*v.w;
  300: }
  301: 
  302: __device__ __forceinline__ Vector2 toVector2(const double4& v) {
  303:     return make_double2(v.x, v.y);
  304: }
  305: 
  306: __device__ __forceinline__ Vector3 toVector3(const double2& v, double w) {
  307:     return {v.x, v.y, w, 0.0};
  308: }
  309: 
  310: __device__ __forceinline__ Point2 toPoint2(const double4& p) {
  311:     return make_double2(p.x, p.y);
  312: }
  313: 
  314: __device__ __forceinline__ Point3 toPoint3(const double2& p, double z) {
  315:     return {p.x, p.y, z, 0.0};
  316: }
  317: 
  318: __device__ __forceinline__ Vector2& toVector2(double4& v) {
  319: // check 16-byte alignment
  320:    assert((((unsigned long long)&v) & 0xFULL) == 0 && "double4 must be 16-byte aligned for Vector2 reinterpret_cast");
  321:    return *reinterpret_cast<Vector2*>(&v);
  322: }
  323: 
  324: 
  325: __device__ __forceinline__ Point2& toPoint2(double4& p) {
  326: 
  327:    assert((((unsigned long long)&p) & 0xFULL) == 0 && "double4 must be 16-byte aligned for Vector2 reinterpret_cast");
  328:    return *reinterpret_cast<Point2*>(&p);
  329: }
