 2276: // Convenience macros for accessing the objects in kernels.
 2277: 
 2278: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 2279:                    Side *side = &(mesh->localSideData[idx_side]); \
 2280:                    if (idx_side >= mesh->ns) return;
 2281: 
 2282: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 2283:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 2284:                    if (idx_elem >= mesh->ne) return;
 2285: 
 2286: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 2287:                    Node *node = &(mesh->localNodeData[idx_node]); \
 2288:                    if (idx_node >= mesh->np) return;
 2289: 
 2290: #define NODE_ALL(node, valid) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x;       \
 2291:                               Node *node = &(mesh->localNodeData[idx_node]); \
 2292:                               const bool valid = (idx_node < mesh->np);                   
 2293: 
 2294: 
 2295: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 2296:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 2297:                            if (idx_node_bnd >= mesh->nbp) return;
 2298: 
 2299: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 2300:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 2301:                            if (idx_side_bnd >= mesh->nbs) return;  
