 2541: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2542: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2543: __inline__ __device__ double  Side::lon(void) const { return 0.5*(n1->lon + n2->lon); }
 2544: __inline__ __device__ double  Side::lat(void) const { return 0.5*(n1->lat + n2->lat); }
 2545: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2546: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2547:    Vector2 grad = {0.0, 0.0};
 2548:    int count = 0;
 2549: 
 2550:    if constexpr(ics == 2) assert(false && "grad2: ics = 2 not implemented");
 2551: 
 2552:    // First element
 2553:    if (elems[0] != nullptr && condition(elems[0])) {
 2554:       grad += elems[0]->grad2(field);
 2555:       count++;
 2556:    }
 2557: 
 2558:    // Second element
 2559:    if (elems[1] != nullptr && condition(elems[1])) {
 2560:       grad += elems[1]->grad2(field);
 2561:       count++;
 2562:    }
 2563: 
 2564:    if (count > 0) {
 2565:       grad = grad/count;
 2566:    }
 2567:    
 2568:    return grad;
 2569: }
