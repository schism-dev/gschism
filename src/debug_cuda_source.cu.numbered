 1776: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1777:    // Computes the 3D normal vector to the element at level k
 1778:    // Returns the normal vector and the area of the element
 1779: 
 1780:       if (isTri()) {
 1781:          // For triangles...
 1782: 
 1783:          // Gets the normal vector to the element (with a length equal to twice the area)
 1784:          if constexpr(ics==1) {
 1785:             const int kb0 = max(k, nodes[0]->kb);
 1786:             const int kb1 = max(k, nodes[1]->kb);
 1787:             const int kb2 = max(k, nodes[2]->kb);
 1788: 
 1789:             const Vector3 n20 = nodes[2]->p3D(k) - nodes[0]->p3D(k);
 1790:             const Vector3 n10 = nodes[1]->p3D(k) - nodes[0]->p3D(k);
 1791:             
 1792:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1793:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1794:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1795:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1796: 
 1797:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1798:             area3D = 0.5*len;
 1799: 
 1800:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1801: 
 1802:             return {nx/len, ny/len, nz/len};
 1803: 
 1804:            
 1805:          }
 1806:          else {  // lat/lon
 1807:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1808:             return {0.0, 0.0, 0.0};
 1809: 
 1810:          } // if ics
 1811:       }
 1812:       else {
 1813:          // For quads...
 1814: 
 1815:          assert(false && "Element normal vector: quads not yet implemented");
 1816:          return {0.0, 0.0, 0.0};
 1817: 
 1818: 
 1819:       }
 1820:    }
 1821: 
 1822: /**
 1823:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1824:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1825:    If the segment is completely inside the element, then it returns true.
 1826: 
 1827:    This function assumes:
 1828:    - The initial point is on a side of the element. 
 1829:    - Its position is given by parameter t in the range [0,1].
 1830:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1831:       intersects the element (elements are convex).
 1832: 
 1833:    To find the intersection point, this function does the following:
 1834:    - it finds the intersection of the line segment with all the element side lines,
 1835:       except for the one that contains the initial point.
 1836:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1837:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1838:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1839:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1840:       track segment is almost parallel to the element side line.
 1841: 
 1842:    Inputs:
 1843:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1844:    @param x2, y2: other end of the line segment
 1845: 
 1846:    Outputs:
 1847:    @param side:  side that intersects the line segment (input and output)
 1848:    @param nextElement (output): element that contains the intersection point
 1849:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1850:    @param zint (input/output): Vertical coordinate of the intersection point
 1851: 
 1852:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1853:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1854:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1855: 
 1856:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1857:    (Delta) being zero.
 1858: 
 1859:    The intersection2 point happens when:
 1860:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1861:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1862:    
 1863:    Assumption: the 4 points (including those of the side segment) are different.
 1864:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1865:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1866:    If true, (xIntersect,yIntersect) is the intersection.				
 1867:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1868: **/
 1869: 
 1870: 
 1871: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1872:                                               double &t, double& tIntersect) {
 1873:    assert( containsPoint(x1) && "Starting point is not inside the element");                                    
 1874:    assert(!containsPoint(x2) && "Ending point is not outside the element");
 1875: 
 1876:    double closest_intersect_t = 1e10;
 1877:    bool found_intersection = false;
 1878: 
 1879:    for (int i = 0; i < i34; i++) {
 1880: 
 1881:       Side *side2 = sides[i];
 1882: 
 1883:       // (x3,y3)-(x4,y4) is the element side line
 1884:       const Point2 x3 = side2->n1->p;
 1885:       const Point2 x4 = side2->n2->p;
 1886: 
 1887:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1888:       const double delta = cross(x2 - x1, x3 - x4);
 1889: 
 1890:       if (abs(delta) > 0) {
 1891: 
 1892:          const double delta1 = cross(x3 - x1, x3 - x4);
 1893:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1894: 
 1895:          // Solves the two linear equations for tt1 and tt2
 1896:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1897:          const double tt2 = delta2/delta;
 1898: 
 1899:          if (tt1 >= -small2 && tt2 >= -small2 && tt2 <= 1.0 + small2 && tt1 <= 1.0 + small2) {
 1900:             closest_intersect_t = min(closest_intersect_t, tt1);
 1901:             side = side2;
 1902:             nextElement = side->otherElem(this);
 1903:             t = tt2;
 1904:             tIntersect = max(small, min(tt1, 1.0-small));
 1905:             found_intersection = true;
 1906:          }
 1907:       
 1908:       }
 1909:       else {  // parallel segments
 1910: 
 1911: printf("XXXXXXX Parallel segments !!!!!!!!!!!!!!!!!!!!!!\n");
 1912:          // In this case, we check if they are colinear. if they are, we compute the intersection point as:
 1913:          // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1914: 
 1915:          // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1916:          const double dist = dot(x1 - x3, side2->n);
 1917:          if (abs(dist) < small*length(x3 - x4)) {
 1918:             const double2 unitarySide = normalize(x4 - x3);
 1919:             const double len = dot(x2 - x1, unitarySide);
 1920:             t = t + len;
 1921:             t = max(0.0, min(t, 1.0));
 1922:             printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1923: 
 1924: 
 1925:             // tIntersect = max(small, min(tt1, 1.0-small));
 1926:             // t = tt2;
 1927:             found_intersection = true;
 1928:          }
 1929:       }
 1930: 
 1931: 
 1932:    }
 1933: 
 1934: if (!found_intersection) 
 1935: {
 1936:    printf("AAAAAAA %i  %i\n", nextElement->containsPoint(x1), nextElement->containsPoint(x2));
 1937:    printf("@@@()()@@@@YYYY@@@@@@@@@ No intersection found closest_intersect_t = %.17g, x1 = (%e,%e), x2 = (%e,%e)\n", closest_intersect_t, x1.x, x1.y, x2.x, x2.y);      
 1938:    
 1939: for (int i = 0; i < i34; i++) {
 1940: 
 1941:    Side *side2 = sides[i];
 1942: 
 1943:    // (x3,y3)-(x4,y4) is the element side line
 1944:    const Point2 x3 = side2->n1->p;
 1945:    const Point2 x4 = side2->n2->p;
 1946: 
 1947:    // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1948:    const double delta = cross(x2 - x1, x3 - x4);
 1949: 
 1950:    if (abs(delta) > 0) {
 1951: 
 1952:       const double delta1 = cross(x3 - x1, x3 - x4);
 1953:       const double delta2 = cross(x2 - x1, x3 - x1); 
 1954: 
 1955:       // Solves the two linear equations for tt1 and tt2
 1956:       const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1957:       const double tt2 = delta2/delta;
 1958: 
 1959: printf("CCCCCC i = %d, delta = %.17g, delta1 = %.17g, delta2 = %.17g, tt1 = %.17g, tt2 = %.17g\n", i, delta, delta1, delta2, tt1, tt2);      
 1960: 
 1961:       if ((tt1 >= -small2) && (tt2 >= -small2) && (tt2 <= 1.0 + small2) && (tt1 <= 1.0 + small2)) {
 1962:          closest_intersect_t = min(closest_intersect_t, tt1);
 1963:          side = side2;
 1964:          nextElement = side->otherElem(this);
 1965:          t = tt2;
 1966:          tIntersect = max(small, min(tt1, 1.0-small));
 1967:          found_intersection = true;
 1968:          printf("DDDDDD found_intersection = true, tt1 = %.17g, tt2 = %.17g\n", tt1, tt2);      
 1969:       }
 1970:    
 1971:    }
 1972: }
 1973: 
 1974: }
 1975:    assert(found_intersection && "No intersection found");
 1976: 
 1977:    // found_intersection should always be true, since we checked all the sides.  
 1978:    return found_intersection;
 1979: }
 1980: 
 1981: 
 1982: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1983:                                              Point3 &xt, double zint, Vector3 &u_int) {
 1984: 
 1985:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1986:    // Instead, we nudge the intersection point to the barycenter of the current element, and nextElement becomes
 1987:    // curElement.
 1988: 
 1989:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1990:    // And uses this velocity instead to continue the tracking.
 1991: 
 1992:    // computes the intersection point in cartesian coordinates
 1993:    Point2 intersection = nextSide->p_t(tt);  // XXXX I don't think this is necessary. THE intersection is already computed in findNextIntersection.
 1994: 
 1995:    // Nudges the point to the barycenter of the element. 
 1996:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1997:    // next segment intersects the element sides. 
 1998:    // TODO: curElem->nudgeToBarycenter(intersection);  REMEMBER!!! RECOVER??? XXX KKKKK
 1999: 
 2000: // double shpCoords[4];
 2001: // bool res = computeShapeCoords(intersection, shpCoords, false);
 2002: // printf("JJJJJ shpCoords = %.17g, %.17g, %.17g\n", shpCoords[0], shpCoords[1], shpCoords[2], shpCoords[3]);
 2003: 
 2004:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 2005:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 2006:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 2007:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 2008: 
 2009:    // If the side is an open boundary, the tangential velocity is set to zero.
 2010:    if (nextSide->isBnd()) vtan = 0.0;
 2011: 
 2012:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 2013:    const double us = vtan*nextSide->t().x;
 2014:    const double vs = vtan*nextSide->t().y;
 2015:    const double ws = 0.5*(nextSide->n1->w2[jlev] + nextSide->n2->w2[jlev]);  //  XXXX Why not use the side's velocity?
 2016: 
 2017:    
 2018: if ( this->idx == 765 && jlev==1) printf("******************************1 tt = %.17g, xt = %.17g, %.17g, %.17g, curElem->idx = %d, this->idx = %d\n", tt, xt.x, xt.y, xt.z, curElem->idx, this->idx);      
 2019:    // The end of this tracking segment is now the intersection point.
 2020:    xt = {intersection.x, intersection.y, zint};
 2021: 
 2022: if ( this->idx == 765 && jlev==1) printf("******************************2 tt = %.17g, xt = %.17g, %.17g, %.17g, curElem->idx = %d, this->idx = %d\n", tt, xt.x, xt.y, xt.z, curElem->idx, this->idx);      
 2023: 
 2024:    u_int = {us, vs, ws};
 2025: // printf("@@@@@@@XXXX@@@@@@@@@ idx = %d, us = %.17g, vs = %.17g, ws = %.17g, dt = %.17g\n", curElem->idx, us, vs, ws, dt);   
 2026:    
 2027: }
 2028: 
 2029: /**
 2030:  * Tracks a particle through elements and vertical levels in the mesh.
 2031:  * 
 2032:  * @param x0,y0,z0     Starting position coordinates
 2033:  * @param xt,yt,zt     Target position coordinates
 2034:  * @param dtb          Time step for tracking
 2035:  * @param u_int        Initial velocity components
 2036:  * @param nextElem     Starting/resulting element index
 2037:  * 
 2038:  * @return Status code of type trackExitCodes
 2039:  * 
 2040:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2041:  * of the details are different. The idea is that the code requires less branches and is better fit
 2042:  * for GPU execution.
 2043:  * 
 2044:  * The main ideas here are:
 2045:  * - The starting point is expected to be in the starting element.
 2046:  * - since the starting point is inside the element, there are only two cases: 
 2047:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2048:  *     (b) it does not and (xt,yt) is already in the starting element.
 2049:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2050:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2051:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2052:  * - tt1 can be positive or negative. We only consider the positive values.
 2053:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2054:  * - The next intersection will occur at the smallest positive tt1.
 2055:  * - This intersection will be the next (x0,y0) position.
 2056:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2057:  *   of getting stuck in a loop.
 2058:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2059:  *   was found.
 2060:  * - Notice that curElement is the current element, while this is the element for which the first call to this function was made.
 2061:  */
 2062: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2063:                                                        Element *&nextElem, int &jlev, double &dt, double time_rm,
 2064:                                                        const Side *origSide) {
 2065:                                                             
 2066:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2067:    // else to do. This means that the full step occurred within the current element.
 2068:    assert(!isDry && "Starting element is dry");
 2069:    if (containsPoint(toPoint2(xt), true)) {  // The "true" means that, if the point is very close to the boundary, it is nudged to be definitely inside the element.
 2070: 
 2071:       assert(containsPoint(toPoint2(xt)) && "Target point is not inside the element");
 2072:       assert(!isDry && "Target point is inside a dry element");
 2073: 
 2074:       interpolateVelocities(xt, u_int);
 2075: 
 2076:       nextElem = this;
 2077: 
 2078: // if (jlev==10) addDebugPlot(x0, xt, 0x00FF00); // green
 2079:       return true;
 2080:    }
 2081: 
 2082: if (!containsPoint(toPoint2(x0)))   
 2083: {
 2084:    double shpCoords[4];
 2085:    printf("XXXXXXXXXXXXXXXXXXXXXXXX Starting point is not inside the element x0 = %.17g, %.17g, %.17g\n", x0.x, x0.y, x0.z);
 2086:    computeShapeCoords(toPoint2(x0), shpCoords, false);
 2087:    printf("XXXXXXXXXXXXXXXXXXXXXXXX shpCoords = %.17g, %.17g, %.17g, %.17g\n", shpCoords[0], shpCoords[1], shpCoords[2], shpCoords[3]);
 2088:    computeShapeCoords(toPoint2(xt), shpCoords, true);
 2089:    printf("XXXXXXXXXXXXXXXXXXXXXXXX shpCoords = %.17g, %.17g, %.17g, %.17g\n", shpCoords[0], shpCoords[1], shpCoords[2], shpCoords[3]);
 2090:    // if (jlev==0)addDebugPlot(x0, xt, 0xFFAF00, 'x');  // yellow
 2091:    // if (jlev==10)addDebugPlot(x0, xt, 0xFFCF00, 'x');  // yellow
 2092:    return true;
 2093: }
 2094:    assert(containsPoint(toPoint2(x0)) && "XXXX Starting point is not inside the element");
 2095: 
 2096: 
 2097:    assert(norm2(toVector2(xt - x0)) > 0.0 && "Zero length track"); 
 2098:    
 2099:    // const int MAX_ITERATIONS = 1000;
 2100:    
 2101:    double t;
 2102:    Side *nextSide = nullptr;
 2103:    double tIntersect = 1e10;
 2104: 
 2105: 
 2106:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2107:    // (x0,y0) is inside the element but the target point is not.
 2108:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2109:    assert(found_intersection && "No intersection found at %d");
 2110: 
 2111:    dt *= tIntersect; // reduces the time step to the time it takes to reach the intersection
 2112:    Point2 xtmp = nextSide->p_t(t); // moves the target point to the intersection point
 2113: 
 2114:    // If the next element is not dry, nudge it to the barycenter to ensure that the point is inside the element.
 2115:    if (nextElem != nullptr && !nextElem->isDry) nextElem->nudgeToBarycenter(xtmp);
 2116:    
 2117: 
 2118:    const double zint = (1 - tIntersect)*x0.z + tIntersect*xt.z;
 2119:    xt = {xtmp.x, xtmp.y, zint};
 2120: 
 2121:    // if the tracking segment goes out of water (either dry or edge boundary)
 2122:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2123: 
 2124: if (idx == 765 && jlev == 1) printf("$$$$$$$$$$@@@@@$$$@6 curElem->idx = %d, jlev = %d, nextElem->idx = %d, isDry = %d, t = %.17g, tIntersect = %.17g dt = %.17g, nextSide->idx = %d\n", idx, jlev, nextElem->idx, nextElem->isDry, t, tIntersect, dt, nextSide->idx);   
 2125:       trackGoesOutOfWater(nextSide, this, t, jlev, xt, zint, u_int);
 2126: // if (jlev==10)addDebugPlot(x0, xt, 0x0000DF, '+');  // dark blue
 2127: 
 2128:       // When this happens, the backtracking stops.
 2129:       dt = time_rm;
 2130: 
 2131:       // In this cases, the next element is again the current element.
 2132:       nextElem = this;
 2133:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2134:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2135:       return true;    
 2136:    }
 2137: 
 2138: 
 2139: if (!nextElem->containsPoint(toPoint2(xt))) 
 2140: {
 2141:    printf("XXXXXXXXXXXXXXXXXXXXXXXX Target point is not inside the next element jlev = %d, x0 = %.17g, %.17g, %.17g, xt = %.17g, %.17g, %.17g\n", jlev, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z);
 2142: // if (jlev==10)addDebugPlot(x0, xt, 0xFFAF00, 'x');  // yellow
 2143:    return true;
 2144: }
 2145:    assert(nextElem->containsPoint(toPoint2(xt)) && "Target point is not inside the next element");
 2146:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2147:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2148: 
 2149:    nextElem->interpolateVelocities(xt, u_int); 
 2150: // if (jlev==10)addDebugPlot(x0, xt, 0xFF0000, 'x');  // red  
 2151: 
 2152:    assert(nextElem != this && "Next element is the same as the current element");
 2153: 
 2154:    return true;
 2155: }
 2156: 
 2157: 
 2158: __inline__ __device__ double Element::computeSignedArea(void) const {
 2159:    // Compute the area of the element
 2160: 
 2161:    double res = signedArea(nodes[0]->p, nodes[1]->p, nodes[2]->p);
 2162: 
 2163:    // In the quad case we need to add the area of the other triangle.
 2164:    if (isQuad()) {
 2165:       double ar1 = signedArea(nodes[0]->p, nodes[2]->p, nodes[3]->p);
 2166:       double ar2 = signedArea(nodes[0]->p, nodes[1]->p, nodes[3]->p);
 2167:       double ar3 = signedArea(nodes[1]->p, nodes[2]->p, nodes[3]->p);
 2168:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2169: 
 2170:       res += ar1;
 2171:    }
 2172: 
 2173:    return res;
 2174: }
 2175: 
 2176: 
 2177: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2178:                                                                 (nodes[1]->isDry2()) ||
 2179:                                                                 (nodes[2]->isDry2()) ||
 2180:                                                                 (i34==4 && nodes[3]->isDry2());
 2181: }
 2182: 
 2183: __inline__ __device__ double Element::detJ_eta(void) const {
 2184:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2185:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2186: }
 2187: 
 2188: __inline__ __device__ double Element::detJ_xi(void) const {
 2189:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2190:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2191: }
 2192: 
 2193: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2194:    // In boundary sides, the element 1 is nullptr
 2195:    return side->elems[1] == nullptr; 
 2196: }
