 2526: __inline__ __device__ Point2 Element::outputCoords(void) const {
 2527:    if constexpr(ics == 1)  {
 2528:       return center;
 2529: 
 2530:    } else {
 2531:       const Point2 p0 = nodes[0]->outputCoords();
 2532:       const Point2 p1 = nodes[1]->outputCoords();
 2533:       const Point2 p2 = nodes[2]->outputCoords();
 2534: 
 2535:       if (isTri()) {
 2536:          return (1.0/3.0)*(p0 + p1 + p2);
 2537: 
 2538:       } else {
 2539:          const Point2 p3 = nodes[3]->outputCoords();
 2540:          return (1.0/4.0)*(p0 + p1 + p2 + p3);
 2541:       }
 2542: 
 2543:    }
 2544: }
