 2267: // BEGIN INCLUDE: eqstate.h
 2268: 
 2269: // Equation of state (eqstate). Returns full density [kg/m^3].
 2270: //    T: temperature [C], S: salinity [PSU], z: depth of the point [m] (only used if ieos_pres=1)
 2271: // Branches are resolved at compile time from ieos_type/ieos_pres.
 2272: // T and S are clamped to [tempmin,tempmax] and [saltmin,saltmax] (UNESCO validity range), as in Fortran.
 2273: 
 2274: constexpr double tempmin = -2.0;  // [C]
 2275: constexpr double tempmax = 40.0;  // [C]
 2276: constexpr double saltmin =  0.0;  // [PSU]
 2277: constexpr double saltmax = 42.0;  // [PSU]
 2278: 
 2279: __inline__ __device__ double eqstate(double T, double S, const double z) {
 2280:    assert(T >= -98.0 && S >= -98.0 && "eqstate: impossible dry (T or S is a -99 sentinel)");
 2281: 
 2282:    T = fmax(tempmin, fmin(T, tempmax));
 2283:    S = fmax(saltmin, fmin(S, saltmax));
 2284: 
 2285:    if constexpr(ieos_type == 1) {
 2286:       return eos_b + eos_a*T;
 2287:    }
 2288:    else if constexpr(ieos_type == 0) {
 2289:       // UNESCO 1980 (Millero & Poisson 1981), one-atmosphere density
 2290:       const double sqrtS = sqrt(S);
 2291:       const double rhow = 999.842594 + T*(6.793952e-2 + T*(-9.095290e-3 + T*(1.001685e-4
 2292:                         + T*(-1.120083e-6 + T*6.536332e-9))));
 2293:       const double A    = 8.24493e-1 + T*(-4.0899e-3 + T*(7.6438e-5 + T*(-8.2467e-7 + T*5.3875e-9)));
 2294:       const double B    = -5.72466e-3 + T*(1.0227e-4 + T*(-1.6546e-6));
 2295:       const double rhoS = rhow + S*(A + B*sqrtS + 4.8314e-4*S);
 2296: 
 2297:       assert(rhoS >= 980.0 && "eqstate: weird density");
 2298: 
 2299:       if constexpr(ieos_pres == 0) {
 2300:          return rhoS;
 2301:       }
 2302:       else {
 2303:          // Secant bulk modulus K(S,T,p), p in bars
 2304:          const double p  = 1.0e-5*rho0*grav*fabs(z);
 2305:          const double Kw = 19652.21 + T*(148.4206 + T*(-2.327105 + T*(1.360477e-2 + T*(-5.155288e-5))));
 2306:          const double K0 = Kw + S*(54.6746 + T*(-0.603459 + T*(1.09987e-2 + T*(-6.1670e-5))))
 2307:                               + S*sqrtS*(7.944e-2 + T*(1.6483e-2 + T*(-5.3009e-4)));
 2308:          const double Ap = 3.239908 + T*(1.43713e-3 + T*(1.16092e-4 + T*(-5.77905e-7)))
 2309:                          + S*(2.2838e-3 + T*(-1.0981e-5 + T*(-1.6078e-6))) + 1.91075e-4*S*sqrtS;
 2310:          const double Bp = 8.50935e-5 + T*(-6.12293e-6 + T*5.2787e-8)
 2311:                          + S*(-9.9348e-7 + T*(2.0816e-8 + T*9.1697e-10));
 2312:          const double K  = K0 + p*(Ap + p*Bp);
 2313:          return rhoS/(1.0 - p/K);
 2314:       }
 2315:    }
 2316:    else {
 2317:       static_assert(ieos_type == 0 || ieos_type == 1, "eqstate: ieos_type not implemented");
 2318:    }
 2319: 
 2320: }
 2321: // END INCLUDE: eqstate.h
