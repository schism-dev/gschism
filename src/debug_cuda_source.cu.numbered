 2127: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2128: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2129: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2130: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2131:    Vector2 grad = {0.0, 0.0};
 2132:    int count = 0;
 2133: 
 2134:    if constexpr(ics == 2) assert(false && "computeHorGradientAtSide: ics = 2 not implemented");
 2135: 
 2136:    // First element
 2137:    if (elems[0] != nullptr && condition(elems[0])) {
 2138:       grad += elems[0]->grad2(field);
 2139:       count++;
 2140:    }
 2141: 
 2142:    // Second element
 2143:    if (elems[1] != nullptr && condition(elems[1])) {
 2144:       grad += elems[1]->grad2(field);
 2145:       count++;
 2146:    }
 2147: 
 2148:    if (count > 0) {
 2149:       grad = grad/count;
 2150:    }
 2151:    
 2152:    return grad;
 2153: }
