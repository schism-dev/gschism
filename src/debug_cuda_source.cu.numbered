 4633:    __global__ void computeBottomDragVegetation(void) {
 4634:       // UNFINISHED. CHECK THIS:
 4635:       // How many kernels are needed? Why so many for loops?
 4636:       // Is the loop on sides needed?
 4637: 
 4638:       NODE(node);
 4639: 
 4640: 
 4641:       const int    kb      = node->kb;
 4642:       const double htot    = node->htot2(); 
 4643:       
 4644:       if (node->isDry) {
 4645:          // Default values for dry nodes
 4646:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4647:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4648: 
 4649:          return;
 4650:        
 4651:       }
 4652: 
 4653:       // Computes bottom drag Cd based on the selected nchi
 4654:       node->computeBottomDragCd();
 4655:       
 4656: 
 4657: 
 4658:       //   Bottom stress in m^2/s^2
 4659:       if (node->rho[kb + 1] >= -98.0)
 4660:       {
 4661:          const double mag_u = length(node->u2[kb + 1]);
 4662:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 4663: 
 4664:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4665:          // !sediment erosion: this part needs more documentation
 4666:       }
 4667:     
 4668: 
 4669: 
 4670:       // Compute vegetation parameters
 4671:       //--------------------------------
 4672: 
 4673:       // SAV constants
 4674:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4675:       constexpr double veg_cfpsi = 0.16;
 4676: 
 4677:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4678:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4679: 
 4680:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4681:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4682:          int kbin = 0; // bin index
 4683:          for (int k = kb; k < nvrt; k++) {
 4684:             // Computes node height above the bottom level
 4685:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4686:             assert(false && "Vertical variation of vegetation not implemented");
 4687: 
 4688:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4689:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4690:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4691:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4692:             // } else {
 4693:             //    // Find the bin at which the current vertical level is
 4694:             //    while (kbin<nbins_veg_vert) {
 4695:             //       const double zn = node->z[kbin];
 4696:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4697:             //          break;
 4698:             //       } // if
 4699:             //       kbin++;
 4700:             //    } // while
 4701:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4702: 
 4703:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4704:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4705:                
 4706:             //    // Linear interpolation of the vegetation parameters
 4707:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4708:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4709:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4710:             // } // if rl10
 4711: 
 4712:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4713: 
 4714:          } // for k
 4715: 
 4716: 
 4717:       } else { // Ganthy (iveg==2)
 4718:       //  Modify canopy height, diameter, and density
 4719: 
 4720:          // Make sure there is vegetation on this node
 4721:          if (node->veg_h_unbent > 0.0) {
 4722:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4723: 
 4724:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4725:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4726:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4727: 
 4728:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4729:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4730:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4731:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4732:          } // if veg_h_unbent
 4733: 
 4734:          for (int k = 0; k < nvrt; k++) {
 4735:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4736:          } // for k
 4737:       
 4738: 
 4739:       } // if iveg
 4740:      
 4741: 
 4742:       // Compute vertical mean of veg_alpha3D
 4743:       if (iveg != 0) {
 4744:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4745:          double sum1=0.0;
 4746:          double sum2=0.0;
 4747:          // Integrate over each level under the canopy...
 4748:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 4749:             const double Dz = node->Dz(k);
 4750: 
 4751:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 4752:             sum2 += Dz;
 4753: 
 4754:          } // for k
 4755:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4756:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4757: 
 4758:       } // if iveg
 4759: 
 4760:    }
 4761: 
 4762:    __global__ void computeVegetationAndDragParameters(void) {
 4763:       // Computes the vegetation and drag model parameters:
 4764:       // chi, \tilde\chi, beta, \breve{H}
 4765:       
 4766:       SIDE(side);
 4767: 
 4768:       side->hhat = 0.0;
 4769:       side->chi2 = 0.0;
 4770:       side->chi = 0.0;
 4771:       side->veg_c2 = 0.0;
 4772:       side->veg_beta = 0.0;
 4773: 
 4774:       if (side->isDry) return;
 4775: 
 4776:       const double htot = side->htot2();
 4777:       const int    kb   = side->kb;
 4778: 
 4779:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4780: 
 4781:       const double veg_h     = side->veg_h();
 4782:       const double veg_nv    = side->veg_nv();
 4783:       const double veg_c     = side->veg_c();
 4784:       const double veg_beta  = side->veg_beta;
 4785:       const double veg_alpha = side->veg_alpha_vert_mean();
 4786: 
 4787:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4788:       // Velocity magnitude at the bottom level
 4789:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4790:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 4791:       side->chi2 = side->Cd()*vmag1;
 4792:       side->chi  = side->chi2;
 4793:       if constexpr(iveg != 0) {
 4794:          const Node *n1 = side->n1;
 4795:          const Node *n2 = side->n2;
 4796:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4797:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4798:       }
 4799: 
 4800:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4801: 
 4802:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4803:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4804:       double magUa = 0.0;
 4805:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4806:          // 3D wet side with veg...
 4807: 
 4808:          double magUa = 0.0;
 4809:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4810:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4811: 
 4812:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4813:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4814:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4815: 
 4816:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4817:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4818: 
 4819:                // Velocity magnitude at the bottom (l) of the level
 4820:                const double ul = length(side->u2[k]);
 4821: 
 4822:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4823:                magUa += Dz*0.5*(uh + ul);
 4824: 
 4825:             } // if HasVegetation
 4826:          } // for k
 4827:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4828: 
 4829:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4830:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4831:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4832:             const double zCpy = side->zTopCanopy();
 4833:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4834:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4835:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4836:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4837:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4838:          } // if isSubmerged
 4839:       } // if iveg   
 4840: 
 4841:       // Computes the friction modified depth, \breve{H} in notes
 4842:       if (side->is2D()) { // 2D
 4843: 
 4844:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4845:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4846: 
 4847:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4848: 
 4849:          side->hhat = htot*htot/fricH; 
 4850: 
 4851:       } else { // 3D
 4852:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 4853: 
 4854:          if constexpr(iveg != 0) {
 4855:             
 4856:             if (side->isSubmerged()) { 
 4857:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4858:                side->hhat -= veg_c*Hhat_alpha;
 4859: 
 4860:             } else { // Emergent
 4861:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4862:             }
 4863:          } // if iveg
 4864: 
 4865:          // Enforce positivity for 3D model
 4866:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 4867:       } // if 3D
 4868: 
 4869:    }
 4870: 
 4871: 
 4872: 
 4873:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4874:    // Computes the density gradient between two elements, e1 and e2.
 4875:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4876:    // zero in the direction normal to the side. 
 4877:    // 
 4878:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4879:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4880:    //
 4881:    // Input:
 4882:    //    e1: Element
 4883:    //    e2: Neighbor element (or nullptr if boundary)
 4884:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4885:    //    k: Index of the half-level at which the density is interpolated
 4886:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4887:    // 
 4888:    // Output:
 4889:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4890:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4891: 
 4892:       if (e2 == nullptr || e2->isDry) {
 4893:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4894: 
 4895:          Side *side = e1->sides[j];
 4896:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4897:                  
 4898:          if constexpr(ics == 1) {
 4899:             vec = side->n; // Normal vector to the side
 4900:          } else {
 4901:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 4902:             // IMPLEMENT THIS XXXXXX
 4903:             // !replace with xel, yel?
 4904:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4905:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4906:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4907:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4908:          } //ics
 4909:                    
 4910:          diffRho = 0.0;
 4911: 
 4912:       } else { //internal and wet
 4913:          if constexpr(ics==1) {
 4914:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4915: 
 4916:             // Vector from e1 to e2
 4917:             vec = e2->center - e1->center;
 4918: 
 4919:          } else { 
 4920:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 4921:             // IMPLEMENT THIS XXXXXX
 4922:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4923:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4924:             //                   alow(j)=xctr2
 4925:             //                   bdia(j)=yctr2
 4926:          } // ics
 4927: 
 4928:          diffRho = rho2 - e1->demeanedDensity(k);
 4929:       }
 4930: 
 4931:    }
 4932: 
 4933:    __global__ void computeDensityCubicSplines(void) {
 4934:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4935: 
 4936:       ELEM(elem);
 4937: 
 4938:       if (elem->isDry) return;
 4939: 
 4940:       const int kb = elem->kb;
 4941: 
 4942:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4943:       if (elem->is2D()) {
 4944:          // In the 2D case, the density is constant at the prism level. 
 4945:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4946:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4947:       } else { //3D
 4948: 
 4949:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4950:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4951:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4952:          ///// XXXX CHECK INDICES!!!!!
 4953:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4954:       } // 2D/3D
 4955: 
 4956:    }
 4957: } // extern "C"
 4958: 
 4959: 
 4960: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4961: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4962: 
 4963:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4964: 
 4965:    const int kb  = elem->kb;
 4966:    const int kb2 = elem2->kb;
 4967: 
 4968:    // z-coordinate of prism of elem
 4969:    const double zp = elem->z_prism(k);
 4970: 
 4971:    double rho = 0.0;
 4972: 
 4973:    if (elem2->is2D()) {
 4974:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4975: 
 4976:    } else {  // 3D
 4977: 
 4978:       // eta_min may be < zmax
 4979:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4980:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4981: 
 4982:       // (Extrapolate density below bottom, we will fix it later)
 4983:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4984:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4985:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4986:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4987:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4988:    } // 2D/3D
 4989:      
 4990: 
 4991:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4992:    // Now we need to fix it.
 4993:    if (elem->z[k] < elem2->z[kb2]) {
 4994:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4995: 
 4996:       // There are two methods to adjust the density at the bottom of the element.
 4997:       // iunder_deep=0: 
 4998:       const double depth1 = abs(elem->z[kb]); // larger depth
 4999: 
 5000:       if (iunder_deep==0) {
 5001: 
 5002:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5003: 
 5004:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5005: 
 5006:       } else { // iunder_deep != 0
 5007: 
 5008:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5009: 
 5010:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5011: 
 5012:          //   Demeaned density at the same z coordinate as
 5013:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5014:          }
 5015: 
 5016:       } // if iunder_deep
 5017:    } // if elem->z[kb] < elem2->z[kb]
 5018: 
 5019:    return rho;
 5020: }
 5021: 
 5022: 
 5023: extern "C" {
 5024:    __global__ void computeDensityGradient(void) {
 5025: 
 5026:       if constexpr(ibc != 0) return;
 5027: 
 5028:          // Compute the horizontal density gradient at each element.
 5029:       // It works in two steps:
 5030:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5031:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5032:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5033:       //             gradRho.r1 = rho1 - rho0
 5034:       //             gradRho.r2 = rho2 - rho0
 5035:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5036:       // 
 5037:       //  NOTE: We use de-meaned densities.
 5038: 
 5039:       ELEM(elem);
 5040: 
 5041:       if (elem->isDry) return;
 5042: 
 5043:       const int kb  = elem->kb;
 5044:       const int i34 = elem->i34;
 5045: 
 5046:       for (int k = kb + 1; k < nvrt; k++) {
 5047:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5048:          //             gradRho.r1 = rho1 - rho0
 5049:          //             gradRho.r2 = rho2 - rho0
 5050:          int icount = 0;
 5051:          double sumRx = 0.0;
 5052:          double sumRy = 0.0;
 5053:          for (int j1=0; j1<i34; j1++) { 
 5054: 
 5055:             const int j2 = elem->nxq(j1 + 1);
 5056: 
 5057:             // Pairs of consecutive neighbor elements of elem
 5058:             const Element *e1 = elem->nghbElems[j1];
 5059:             const Element *e2 = elem->nghbElems[j2];
 5060: 
 5061:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5062:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5063:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5064: 
 5065:             // Compute the density difference and the vector from elem to e1 and e2
 5066:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5067:             double diffRho1, diffRho2;
 5068:             Vector2 vec1, vec2;
 5069:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5070:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5071: 
 5072:             const double rl1 = length(vec1);
 5073:             const double rl2 = length(vec2);
 5074:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5075: 
 5076:             const double delta = cross(vec1, vec2);
 5077:             const double sintheta = abs(delta)/(rl1*rl2);
 5078: 
 5079:             // To avoid problems, avoid elements with small angle between vectors
 5080:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5081:             const bool validEq = (sintheta > sin_one_deg);
 5082: 
 5083:             if (validEq) {
 5084:                // Solve the system of equations to get the density gradient at elem
 5085:                icount++;
 5086:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5087:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5088:                sumRx += Rx;
 5089:                sumRy += Ry;
 5090:             }
 5091:          } // for j1
 5092: 
 5093:          // Compute the average density gradient at elem
 5094:          if (icount==0) {
 5095:            // Bad mesh quality; bail out with 0 b-cc
 5096:            elem->gradRho[k] = {0.0, 0.0};
 5097:          } else {
 5098:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5099:          }
 5100: 
 5101:       } // for k
 5102: 
 5103:    }
 5104: 
 5105:    __global__ void computeBaroclinicTerm(void) {
 5106:    // Computes the baroclinic term at sides (at half levels).
 5107:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5108:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5109: 
 5110:       if (ibc == 1) return;
 5111: 
 5112:       SIDE(side);
 5113: 
 5114:       if (side->isDry) return;
 5115: 
 5116:       const Element *e1 = side->elems[0];
 5117:       const Element *e2 = side->elems[1];      
 5118:       const int kb = side->kb;
 5119:       
 5120:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5121: 
 5122:       // interpolates vertically the density gradient of the two elements at the half level/
 5123: 
 5124:       int k1 = max(kb, nvrt / 2);
 5125:       int k2 = max(kb, nvrt / 2);
 5126: 
 5127:       // Starts the integration at the surface and goes down to the bottom
 5128:       side->bcc[nvrt-1] = {0.0, 0.0};
 5129:       for (int k = nvrt - 2; k >= kb; k--) {
 5130:       // For each prism level (from surface to bottom)...
 5131: 
 5132:          // For both elements, interpolate density gradient at the side's half level.
 5133:          // The gradient at the side is the average of the gradients at the elements.
 5134:          // w1, w2 are used to take into account boundary sides, with just one element.
 5135:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5136:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5137:          const double wsum = w1 + w2;
 5138:          w1 = w1/wsum;
 5139:          w2 = w2/wsum;
 5140:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5141: 
 5142:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5143:          Vector2 gradRho = {0.0, 0.0};
 5144:          if (e1 != nullptr && k > kb) {
 5145:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5146:             
 5147:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5148:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5149:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5150: 
 5151:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5152:          }      
 5153:          if (e2 != nullptr && k > kb) {
 5154:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5155:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5156:             
 5157:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5158:          }
 5159: 
 5160:          if constexpr(ics==2) {
 5161:             assert(false && "Not implemented: ics == 2");
 5162:             // IMPLEMENT THIS XXXXXX
 5163:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5164:             // swild(1)=tmp1
 5165:             // swild(2)=tmp2
 5166:          }
 5167:          
 5168:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5169:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5170:          // CHECK INDICES!!! XXX
 5171:          const double grav3 = side->grav3();
 5172:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5173: 
 5174:       } // for
 5175: 
 5176:    }
 5177: 
 5178: 
 5179: 
 5180:    __global__ void computeHorGradientAtSide(void) {
 5181: 
 5182:       // Compute the horizontal density gradient at each element.
 5183:       // It works in two steps:
 5184:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5185:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5186:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5187:       //             gradRho.r1 = rho1 - rho0
 5188:       //             gradRho.r2 = rho2 - rho0
 5189:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5190:       // 
 5191:       //  NOTE: We use de-meaned densities.
 5192: 
 5193:       SIDE(side);
 5194: 
 5195: 
 5196:       if (side->isDry) return;
 5197: 
 5198:       // Computes the gradient of the variables at the side center.
 5199:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5200:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5201:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 5202: 
 5203:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5204:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5205:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5206:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5207: 
 5208:    }
 5209: 
 5210: 
 5211:    __global__ void solveMomentumEquations(double time) {
 5212: 
 5213:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5214:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5215: 
 5216:       SIDE(side);
 5217: 
 5218:       if (side->isDry) 
 5219:       {
 5220:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 5221: 
 5222:          return;
 5223:       }
 5224: 
 5225:       const Node *n1 = side->n1;
 5226:       const Node *n2 = side->n2;
 5227: 
 5228:       const int kb = side->kb;
 5229: 
 5230:       const double veg_h = side->veg_h();
 5231:       const double grav3 = side->grav3();
 5232: 
 5233:       if (side->is2D()) {
 5234:          // Remember: Do not use htot2, which is updated.
 5235:          const double htot = side->htot1();
 5236:          const double hhat = side->hhat;
 5237: 
 5238:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5239: 
 5240:          Vector2 tau2 = {0.0, 0.0};
 5241:           
 5242:          if constexpr(ics==1) {
 5243:             tau2 = side->tau();
 5244: 
 5245:          } else {
 5246:             assert(false && "Not implemented: ics == 2");
 5247:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5248:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5249:             // taux2=(vn1+tt1)*0.5d0
 5250:             // tauy2=(vn2+ss1)*0.5d0
 5251:          } // if ics         
 5252: 
 5253:          // hat_gam has units of m/s
 5254: 
 5255:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5256:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5257:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5258: 
 5259:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5260: 
 5261: 
 5262:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 5263: 
 5264:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 5265: 
 5266:       }
 5267:       else { // 3D
 5268: 
 5269:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5270:          // 
 5271:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5272:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5273:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5274:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5275:          // k+1 and k.
 5276: 
 5277: 
 5278:          const int ndim = nvrt - kb;
 5279:          const double zTopCanopy = side->zTopCanopy();
 5280: 
 5281:          // Initialize the tridiagonal system
 5282:          for (int k = kb + 1; k < nvrt; k++) {
 5283:             
 5284:             const int kin = k - (kb + 1);
 5285: 
 5286:             // Vertical viscosity at the face center
 5287:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 5288: 
 5289:  
 5290:             alow[kin] = 0.0;
 5291:             cupp[kin] = 0.0;
 5292:             bdia[kin] = 0.0;
 5293: 
 5294:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5295:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5296: 
 5297:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5298:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5299:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5300: 
 5301:             // First part: layers k, k+1
 5302:             if (k < nvrt - 1) {
 5303:                              
 5304:                if constexpr(iveg != 0) {
 5305: 
 5306:                   // If there is vegetation at this level...
 5307:                   if (zTopCanopy > side->zc[k]) {
 5308:                      // If the canopy is above the k layer...
 5309:                      
 5310:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5311:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5312:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5313:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5314: 
 5315:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5316:                      const double vmag2 = length(ut2);
 5317:                      const double vmag1 = length(side->u2[k]);
 5318:                      const double vmag = 0.5*(vmag1 + vmag2);
 5319:                      
 5320:                      // Computes the vegetation alpha at the face center
 5321:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5322: 
 5323:                      cff1 += veg_alpha_sd*dt*vmag;
 5324: 
 5325:                   } // if (zTopCanopy
 5326:                } // if iveg
 5327: 
 5328:                const double dzz = side->Dz(k + 1);
 5329:                const double tmp = dt*dfz/dzz;
 5330:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5331: 
 5332:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5333:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5334:             }
 5335: 
 5336: 
 5337:             // Second part: layers k-1, k
 5338:             if (k > kb + 1) {
 5339: 
 5340:                double cff1 = 1.0; //init \bar{c^k}
 5341: 
 5342:                if constexpr(iveg != 0) {
 5343:                   // If there is vegetation at this level...
 5344:                   if (zTopCanopy > side->zc[k-1]) {
 5345:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5346:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5347: 
 5348:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5349: 
 5350:                      const double vmag2 = length(ut2);
 5351:                      const double vmag1 = length(side->u2[k-1]);
 5352:                      const double vmag = 0.5*(vmag1 + vmag2);
 5353: 
 5354:                      // Computes the vegetation alpha at the face center
 5355:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5356:                      cff1 += veg_alpha_sd*dt*vmag;
 5357:                   } // if zTopCanopy
 5358: 
 5359:                } // if iveg
 5360: 
 5361:                const double dzz = side->Dz(k);
 5362:                const double tmp = dt*dfz/dzz;
 5363:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5364: 
 5365:                alow[kin] += cff1*dzz/6.0 - tmp;
 5366:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5367: 
 5368:             } else { // Bottom boundary
 5369:                // This occurs at the bottom, where the bottom drag is applied.
 5370: 
 5371:                bdia[kin] += dt*side->chi2; // XXXX
 5372: 
 5373:             } // if (k > kb + 1)
 5374: 
 5375: 
 5376:          } // for (int k
 5377: 
 5378: 
 5379: 
 5380:          // Computes the RHS.
 5381:          // -----------------
 5382: 
 5383:          //	BC to be imposed at the end.
 5384: 
 5385:          const Vector2 gradETP  = side->gradETP;
 5386:          const Vector2 gradPr   = side->gradPr;
 5387:          const Vector2 gradEta1 = side->gradEta1;
 5388:          const Vector2 gradEta2 = side->gradEta2;
 5389: 
 5390:          const Vector2 *btu = side->btu;
 5391:          const Vector2 *u2  = side->u2;
 5392:          const double coriolis = side->coriolis;
 5393:          const Vector2 *nuGradU = side->nuGradU;
 5394: 
 5395: 
 5396:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5397:          for (int k = kb + 1; k < nvrt; k++) {
 5398:             const int kin = k - kb - 1;
 5399: 
 5400:             const double dz_0 = side->Dz(k);
 5401:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5402: 
 5403:             rrhs[kin] = {0.0, 0.0};
 5404:             double dz = 0.0;
 5405: 
 5406:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5407:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5408:             if (k < nvrt  ) dz += dz_1;
 5409:             if (k > kb + 1) dz += dz_0;
 5410: 
 5411:             // Elevation gradient, atmospheric pressure and tidal potential
 5412:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5413: 
 5414:             // Coriolis, advection, wind stress, and horizontal viscosity
 5415:             if (k < nvrt - 1) {
 5416: 
 5417: 
 5418:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5419:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5420:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5421:                                                 
 5422: 
 5423:                //diff stress tensors 1006
 5424:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5425:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5426:                   assert(false && "Not implemented: itur == 5");
 5427:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5428:                }
 5429:                // else assert(false && "itur # Not implemented");
 5430: 
 5431:             } else { // k == nvrt - 1 SURFACE
 5432:                Vector2 tau2 = {0.0, 0.0};
 5433:                if constexpr(ics==1) {
 5434:                   tau2 = side->tau();
 5435:       
 5436:                } else {
 5437:                   assert(false && "Not implemented: ics == 2");
 5438:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5439:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5440:                   // taux2=(vn1+tt1)*0.5d0
 5441:                   // tauy2=(vn2+ss1)*0.5d0
 5442:                } // if ics
 5443: 
 5444:                rrhs[kin] += dt*tau2;
 5445:           
 5446: 
 5447:             } // if k<nvrt
 5448: 
 5449: 
 5450:             if (k > kb + 1) {
 5451:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5452:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5453:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5454: 
 5455:                // diff stress tensors 1006
 5456:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5457:                   assert(false && "Not implemented: itur == 5");
 5458:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5459:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5460:                }
 5461:                // else assert(false && "itur # Not implemented");
 5462: 
 5463: 
 5464:             } // if k>kbs + 1
 5465: 
 5466:             // Baroclinic
 5467:             Vector2 *bcc = side->bcc;
 5468:             if constexpr(ibc == 0) {
 5469:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5470:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5471: 
 5472:             } // if ibc==0
 5473: 
 5474:          } // k=kb + 1,nvrt
 5475: 
 5476: 
 5477:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5478: 
 5479:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 5480:             const int kin = k - kb - 1;
 5481:    
 5482:             // Velocity is always clamped to maximum values
 5483:             side->u2[k] = clampVelocity(soln[kin]);
 5484:          } // k
 5485: 
 5486:       } // if side->is2D()
 5487:       
 5488: 
 5489:       // Impose velocity boundary condition at the bottom
 5490:       if constexpr(imm == 2) { // 3D bed deformation model
 5491:          double dep;
 5492:          Vector2 vel;
 5493: 
 5494:          assert(false && "Not implemented: imm == 2");
 5495:          //update_bdef(time, x0, y0, dep, vel);
 5496:          // side->u2[kb] = vel;
 5497: 
 5498:       } else { // imm = 0 or 1
 5499:          if (side->Cd() == 0.0) {
 5500:             side->u2[kb] = side->u2[kb + 1];
 5501: 
 5502:          } else if (side->is3D()) { // 3D no slip bottom   
 5503:             side->u2[kb] = {0.0, 0.0};
 5504: 
 5505:          }
 5506:           
 5507:       } // if imm
 5508: 
 5509:       // The velocities below the bottom level are set to zero
 5510:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 5511: 
 5512: 
 5513:    }
 5514: 
 5515: 
 5516:    __global__ void applyMomentumBC(void) {
 5517: 
 5518:       SIDE_BND(sideBnd);
 5519: 
 5520:       Side *side = sideBnd->side;
 5521:       const BoundarySegment *segment = sideBnd->segment;
 5522:       const Node *n1 = side->n1;
 5523:       const Node *n2 = side->n2;
 5524: 
 5525:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5526: 
 5527:       const bool isLand = segment->isLand;
 5528:       const int ifltype = segment->ifltype;
 5529: 
 5530:       const int kb = side->kb;
 5531: 
 5532: 
 5533:       if (!isLand && ifltype != 0) {
 5534:          const Vector2 *ubc = sideBnd->ubc;
 5535:   
 5536:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5537:             
 5538:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5539:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5540: 
 5541:             if (ifltype == -1) {
 5542:                // Flather 1
 5543: 
 5544:                const double depth = side->depth();
 5545: 
 5546:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5547: 
 5548:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5549: 
 5550:                side->u2[k] = vnorm*side->n;
 5551: 
 5552:             } else if (ifltype == -2) { // Discharge
 5553: 
 5554:                const double eta1 = side->eta1();
 5555:                const double eta2 = side->eta2();
 5556:                const double htot = side->htot2();
 5557: 
 5558:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5559:                assert(false && "Not implemented: Discharge bc");
 5560:                // const double dischrg = discharge(eta1);
 5561:                const double dischrg = 0.0; // XXX REMOVE
 5562:                
 5563: 
 5564:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5565: 
 5566:                const double vnorm = dischrg*eta2/htot;
 5567: 
 5568:                side->u2[k] = vnorm*side->n;
 5569: 
 5570:             }
 5571:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5572:                const double vnorm = dot(side->u2[k], side->n);
 5573: 
 5574:                double rat;
 5575:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5576:                else              rat = segment->vobc2; // outgoing
 5577: 
 5578:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5579: 
 5580:             }
 5581:             else { // not Flather or 3D radiation
 5582:                side->u2[k] = ubc[k];
 5583: 
 5584:             } // if (segment->ifltype...
 5585: 
 5586:          }
 5587: 
 5588:       }
 5589:       else if (isLand) { // if it is land boundary side
 5590: 
 5591:          if constexpr(islip == 0) { // free slip
 5592: 
 5593:             for (int k = kb; k < nvrt; k++) {
 5594: 
 5595:                const Vector2 t = side->t();
 5596:                const Vector2 n = side->n;
 5597: 
 5598:                double vnorm = 0.0; // for most cases
 5599:                const double vtan = dot(side->u2[k], t);
 5600:                
 5601:                side->u2[k] = vtan*t - vnorm*n;
 5602: 
 5603:             }
 5604: 
 5605:          } else { // no slip
 5606:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5607: 
 5608:          }
 5609:       } // if (side segment type...
 5610: 
 5611:    
 5612: 
 5613:    }
 5614: 
 5615: 
 5616:    __global__ void shapiroFilter1(void) {
 5617:       // First step of the Shapiro filter (normally used if indvel<=0)
 5618:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5619: 
 5620:       SIDE(side);
 5621: 
 5622:       // Only internal wet sides are processed
 5623:       if (side->isDry || !(side->isInternal())) return;
 5624: 
 5625:       const int kb = side->kb;
 5626: 
 5627:       for (int mm = 0; mm < niter_shap; mm++) {
 5628: 
 5629:          for (int k = kb + 1; k < nvrt; k++) {
 5630:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5631:             Vector2 suru = {0.0, 0.0};
 5632: 
 5633:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5634: 
 5635:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 5636: 
 5637:                int kin = k;
 5638:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5639:                
 5640:                if constexpr(ics==1) {
 5641:                   suru += nSide->u2[kin];
 5642: 
 5643:                } else {
 5644:                   assert(false && "Not implemented: ics == 2");
 5645:                   // Vector2 vn1, vn2;
 5646:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5647:                   // suru=suru+vn1;
 5648:                   // surv=surv+vn2;
 5649:                }
 5650:             }
 5651: 
 5652:             // Reusing bcc as a temporary array to store the suru values.
 5653:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5654: 
 5655:          }
 5656:       }
 5657:    }
 5658: 
 5659:    __global__ void shapiroFilter2(void) {
 5660:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5661: 
 5662:       SIDE(side);
 5663: 
 5664: 
 5665:       if (side->isDry || !(side->isInternal())) return;
 5666: 
 5667:       const int kb = side->kb;
 5668: 
 5669:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5670: 
 5671:       if (side->is2D()) {
 5672:          side->u2[kb + 1] = side->bcc[kb + 1];
 5673:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 5674: 
 5675:       } else {
 5676:          // 3D
 5677:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5678:          
 5679:       }
 5680: 
 5681:    }
 5682: 
 5683: 
 5684:    __global__ void ul0UpdateZCoords(void) {
 5685:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5686:       
 5687:       NODE(node);      
 5688: 
 5689: 
 5690:       if (false) { //node->isDry) { XXXXXXX
 5691: 
 5692:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 5693: 
 5694:          if constexpr(ivcor != 1) node->kb = 0;
 5695: 
 5696:       } else {
 5697: 
 5698:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 5699:          node->updateKb();
 5700: 
 5701:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5702: 
 5703:       }
 5704: 
 5705:       // We use the temp.b field to store the previous state of isDry.
 5706:       node->tmp.b = node->isDry;
 5707: 
 5708:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5709:       node->isDry = true;
 5710: 
 5711:    }
 5712: 
 5713:    __global__ void ul0ComputeDryElements(void)
 5714:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 5715:    {
 5716:       ELEM(elem);
 5717: 
 5718:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 5719: 
 5720:       elem->kb = 0;
 5721: 
 5722:       if (elem->isDry) return;
 5723: 
 5724: 
 5725:    //    if(elem->isDry2()) { // XXXX
 5726:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5727:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5728:    //        call parallel_abort(errmsg)
 5729:    //    }
 5730: 
 5731:       const Node *n1 = elem->nodes[0];
 5732:       const Node *n2 = elem->nodes[1];
 5733:       const Node *n3 = elem->nodes[2];  
 5734:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 5735: 
 5736:       // Computes element's kb as the minimum of the nodes' kb.
 5737:       const int kb1 = n1->kb;
 5738:       const int kb2 = n2->kb;
 5739:       const int kb3 = n3->kb;
 5740:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5741: 
 5742: 
 5743:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5744: 
 5745: 
 5746:       // Computes the element z as the mean of the nodes z.
 5747:       for (int k = elem->kb; k < nvrt; k++) {
 5748: 
 5749:          // Compute the element z as the mean of the nodes z.
 5750:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 5751:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5752:          elem->z[k] /= elem->i34;
 5753: 
 5754:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5755:       }
 5756:                   
 5757:    }
 5758: 
 5759:    __global__ void ul0ComputeDryNodes(void)
 5760:    // Updates node's isDry based on the elements' isDry. 
 5761:    {
 5762:       NODE(node);
 5763: 
 5764:       node->isDry = true;
 5765: 
 5766:       // A node is wet if at least one of the elements sharing it is wet.
 5767:       for (int j = 0; j < node->numElements; j++) {
 5768:          const Element *elem = node->elements[j];
 5769:          if (!elem->isDry) {
 5770:             node->isDry = false;
 5771:             break;
 5772:          }
 5773:       }
 5774: 
 5775:        
 5776:    }
 5777: 
 5778: 
 5779:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5780:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 5781:    // node->tmp.b is true if the node was previously dry.
 5782:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 5783:    {
 5784:       NODE(node);
 5785:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5786: 
 5787:       // Avoid this the first time step.
 5788:       if (it == iths) return;  
 5789: 
 5790:       const bool wasDry = node->tmp.b;
 5791: 
 5792: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 5793: 
 5794:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 5795: 
 5796:          for (int k=0; k < nvrt; k++) {
 5797: 
 5798:             Vector3 utmp={0.0, 0.0, 0.0};
 5799: 
 5800:             double ttmp=0.0;
 5801:             double stmp=0.0;
 5802:             int icount=0;
 5803:             for (int j = 0; j < node->numNodes; j++) {
 5804: 
 5805:                const Node *nbrNode = node->nodes[j];
 5806:                
 5807:                const bool wasNbrDry = nbrNode->tmp.b;
 5808: 
 5809:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 5810:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 5811: 
 5812:                   icount++;
 5813: 
 5814:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5815:                   utmp += nbrNode->uvw2(k);
 5816:                   
 5817:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 5818:                   stmp += nbrNode->tracers[k].tracer[1]; 
 5819:                }
 5820:             }
 5821: 
 5822:             if (icount > 0) {
 5823:                const double inv_icount = 1.0/icount;
 5824:                utmp = inv_icount*utmp;
 5825:                node->u2[k]     = toVector2(utmp);
 5826:                node->w2[k]     = utmp.z;
 5827:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5828:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5829:             } else {
 5830:                node->u2[k] = {0.0, 0.0};
 5831:                node->w2[k] = 0.0;
 5832:                // Initialize tracers to 0.0??? XXXXX
 5833:             }
 5834:          }
 5835:       }
 5836:    }
 5837: 
 5838:   
 5839:    
 5840: 
 5841: 
 5842:    __global__ void ul0UpdateSides(int it, int iths) {
 5843:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 5844:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 5845:    // The dryness of the sides is updated in ul0UpdateSides2.
 5846: 
 5847:       SIDE(side);
 5848: 
 5849:       // A side is wet if and only if at least one of its elements is wet.
 5850:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5851:  
 5852:       const Node *n1 = side->n1;
 5853:       const Node *n2 = side->n2;
 5854:      
 5855:       const int kb1 = n1->kb;
 5856:       const int kb2 = n2->kb;
 5857: 
 5858:       side->kb = 0; // default when dry
 5859: 
 5860:       if (isWet) {
 5861: 
 5862:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5863: 
 5864:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5865: 
 5866:          side->kb = min(kb1, kb2);
 5867: 
 5868:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 5869: 
 5870:          for (int k = side->kb; k < nvrt; k++) {
 5871:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5872: 
 5873:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 5874: 
 5875:             // Compute velocity for re-wetted sides 
 5876:             if ((it != iths) && (side->isDry && isWet)) {
 5877: 
 5878:                Vector2 utmp={0.0, 0.0};
 5879: 
 5880:                int icount=0;
 5881: 
 5882:                // For all the sides on the two elements that share this side
 5883:                for (int j = 0; j < 2; j++) {
 5884:                   const Element *elem = side->elems[j];
 5885:                   if (elem == nullptr) continue;
 5886: 
 5887:                   for (int jj=0; jj < elem->i34; jj++) {
 5888:                      const Side *nSide = elem->sides[jj];
 5889:                      if (nSide->isDry) continue;
 5890: 
 5891:                      icount++;
 5892:                      utmp += nSide->u2[k];  
 5893:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 5894:                   }
 5895:                }
 5896:                   
 5897:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 5898:                if (icount > 0)  side->u2[k] = utmp/icount;
 5899:                else             side->u2[k] = {0.0, 0.0};
 5900:                   
 5901:             } // if ((it != iths) && (side->isDry && isWet))
 5902: 
 5903:          } // for k
 5904: 
 5905:       } // if isWet 
 5906:       
 5907: 
 5908: 
 5909:    }
 5910: 
 5911:    __global__ void ul0UpdateSides2(void) {
 5912:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 5913:    
 5914:          SIDE(side);
 5915:    
 5916:          const Element *e1 = side->elems[0];
 5917:          const Element *e2 = side->elems[1];
 5918: 
 5919:          // A side is wet if and only if at least one of its elements is wet.
 5920:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 5921: 
 5922:          // Update the side's dryness
 5923:          side->isDry = !isWet;
 5924: 
 5925:    }
 5926: 
 5927: 
 5928:    __global__ void zeroNodalVelocities(void) {
 5929:       NODE(node);
 5930: 
 5931:       for (int k = 0; k < nvrt; k++) {
 5932:          node->u2[k]   = {0.0, 0.0};
 5933:          node->w2[k]   = 0.0;
 5934:          node->utmp[k] = {0.0, 0.0};
 5935:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5936:       }
 5937:    }
 5938:  
 5939: 
 5940:    __global__ void computeNodalVerticalVelocities1(void) {
 5941:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5942:    // Adds the element's vertical velocity times the element's area.
 5943:       ELEM(elem);
 5944: 
 5945:       for (int j = 0; j < elem->i34; j++) {
 5946:          Node *node = elem->nodes[j];
 5947: 
 5948:          for (int k = node->kb; k < nvrt; k++) {
 5949:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 5950:          }
 5951:          atomicAdd(&(node->tmp.d), elem->area);
 5952:       }
 5953:    }
 5954: 
 5955:    __global__ void computeNodalVerticalVelocities2(void) {
 5956:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5957:    // Divides by the total area of the elements sharing the    node.
 5958:       NODE(node);
 5959: 
 5960:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5961: 
 5962:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 5963:    }
 5964: 
 5965: 
 5966:    __global__ void computeNodalHorizontalVelocities1(void) {
 5967: 
 5968:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 5969:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 5970: 
 5971:       ELEM(elem);
 5972: 
 5973:       if (elem->isDry) return;
 5974: 
 5975:       const int kb = elem->kb;
 5976:       const bool isTri = elem->isTri();
 5977: 
 5978:       if constexpr(indvel <= 0) {
 5979:          // Assuming discontinous hvel.
 5980: 
 5981:          if (isTri) { // For triangles
 5982:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 5983:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 5984: 
 5985:             for (int j = 0; j < 3; j++) {
 5986:                // For every node of the triangle...
 5987:                Node *node = elem->nodes[j];
 5988: 
 5989:                if (node->isDry) continue;
 5990: 
 5991:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 5992:                const Side *s2 = elem->sides[(j + 1) % 3];
 5993:                const Side *s3 = elem->sides[(j + 2) % 3];
 5994: 
 5995:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 5996: 
 5997:                atomicAdd(&(node->tmp.i), 1);
 5998: 
 5999:                for (int k = kb; k < nvrt; k++)  {
 6000:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated linearly at node j.   
 6001:                   u = clampVelocity(u);
 6002:                   atomicAdd(&(node->utmp[k].x), u.x);
 6003:                   atomicAdd(&(node->utmp[k].y), u.y);
 6004: 
 6005:                }
 6006: 
 6007:             }
 6008:          }
 6009:          else { // For quads
 6010:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6011: 
 6012:          }
 6013: 
 6014:       }
 6015:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 6016:       
 6017:    }
 6018: 
 6019: 
 6020:    __global__ void computeNodalHorizontalVelocities2(void) {
 6021:       NODE(node);
 6022: 
 6023:       const int nodeCount = node->tmp.i;
 6024: 
 6025:       if (nodeCount == 0) 
 6026:       {
 6027:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 6028:          return;
 6029:       }
 6030: 
 6031:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 6032:       
 6033:       const int kb = node->kb;
 6034: 
 6035:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 6036:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 6037:       
 6038:       
 6039:    }   
 6040: 
 6041:  
 6042: 
 6043:    __global__ void resetVelocityOpenBndNodes(void) {
 6044:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6045: 
 6046:       NODE_BND(nodebnd);
 6047: 
 6048:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6049:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 6050:       }
 6051: 
 6052:    }
 6053: 
 6054: 
 6055:    __global__ void setVelocityOpenBndNodes(void) {
 6056:    // For open boundary nodes sets their velocity to the imposed values.
 6057: 
 6058:       SIDE_BND(sidebnd);
 6059: 
 6060:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6061:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6062:          // to its segment to the average of the side velocity.
 6063: 
 6064:          for (int k = 0; k < nvrt; k++) {
 6065:             Node *n1 = sidebnd->side->n1;
 6066:             Node *n2 = sidebnd->side->n2;
 6067: 
 6068: 
 6069:             Vector2 n1_u2(n1->u2[k]);
 6070:             Vector2 n2_u2(n2->u2[k]);
 6071: 
 6072:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6073:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6074:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6075:             }
 6076:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6077:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6078:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6079:             }
 6080: 
 6081:          }
 6082: 
 6083:       }
 6084: 
 6085:    }
 6086: 
 6087: 
 6088:    __global__ void computeVerticalVelocity(void) {
 6089:       // Computes the vertical velocity at the (2D) element's centroid.
 6090:       // In this function we will be considering volumetric elements, with side faces and a 
 6091:       // bottom and a top face. We will call them SFs, BF and TF.
 6092:       // It computes the flux coming from BF and the SFs.
 6093:       // If the bed is moving, it takes that into account.
 6094:       // Since water is incompressible, the integral of the velocity times the normal vector
 6095:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6096:       // and the BF is equal to the flux going out from the TF.
 6097:       // TF = - BF - sum(SFs).
 6098:       // It then computes the horizontal velocity at the center of TF.
 6099:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6100:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6101:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6102: 
 6103:       ELEM(elem);
 6104: 
 6105:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 6106: 
 6107:       if (elem->isDry) return;
 6108: 
 6109:       const int kb = elem->kb;
 6110:       const bool isTri = elem->isTri();
 6111: 
 6112:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6113: 
 6114:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6115:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6116:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6117: 
 6118:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6119: 
 6120:       double area3D;
 6121: 
 6122:       // Bottom face flux
 6123:       double bottomFlux = 0.0;
 6124:       Vector2 u2meanBottom = {0.0, 0.0};
 6125:       const Vector2 gradh = elem->grad2(&Node::depth);
 6126:       if constexpr(imm==2) {
 6127:          Vector3 ubed;
 6128: 
 6129:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6130:          // updateBDEF(ubed);
 6131:      
 6132:          // const double bflux0 = dot(ubed, elem_n1);
 6133: 
 6134:          // elem->w[kb] += ubed.z;
 6135:       }
 6136:       else {
 6137:          Vector2 umean;
 6138:          if constexpr(ics == 1) {
 6139:             u2meanBottom = elem->mean(kb, &Side::u2);
 6140:          }
 6141:          else {
 6142:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6143:          }
 6144: 
 6145:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6146:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6147: 
 6148:          bottomFlux = - dot(gradh, u2meanBottom);
 6149:       } // if imm
 6150: 
 6151:       // Compute w for kb+1 to nvrt-1
 6152:       for (int l = kb; l < nvrt - 1; l++) {
 6153: 
 6154:          // normal vector to the top face of the "volumetric" element (3D)
 6155:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6156: 
 6157:          // Compute the total flux at the sides
 6158:          double sideFlux = 0.0;
 6159: 
 6160:          for (int j = 0; j < elem->i34; j++) {
 6161:             const Side *side = elem->sides[j];
 6162: 
 6163:             const double sideArea = side->area(l);
 6164:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6165:             const double sign = elem->ssign[j]; 
 6166: 
 6167:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6168:          }
 6169:          
 6170:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6171:          //velocities at the centers of the sides
 6172:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6173: 
 6174:          // The flx at the top ace can be computed from the other flows.
 6175:          const double topFlux = - sideFlux - bottomFlux;
 6176:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6177: 
 6178:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6179: 
 6180:          elem_n1 = elem_n2;
 6181: 
 6182:          bottomFlux = - topFlux;
 6183:       }
 6184:    }  
 6185: 
 6186: 
 6187: 
 6188: 
 6189: 
 6190: 
 6191: 
 6192: // !===============================================================================
 6193: // !===============================================================================
 6194: 
 6195: } // extern "C"
 6196: 
 6197: #ifdef DONTCOMPILE
 6198: __device__ void computeVerticalAdvection(void) {
 6199:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6200: 
 6201:    sdbt(1:2,:,:)=0.d0
 6202: 
 6203:    const Side *side = FROM kernel;
 6204: 
 6205:    if(side->isDry) return;
 6206: 
 6207:    // If side is wet...
 6208: 
 6209: 
 6210:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6211:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6212:    double ws[nvrt] = {} // w @ side
 6213:    int icount = 0;
 6214:    for (int j=0; j<2; j++) {
 6215:       const Element *elem = side->elements[j];
 6216:        
 6217:       if(elem != nullptr) {
 6218:          icount++;
 6219:          for (int k=0; k<nvrt; k++) {
 6220:             ws[k] = ws[k] + elem->w[k];
 6221:          }
 6222:       }
 6223:    }  // for j
 6224: 
 6225:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6226:    ws = ws/icount;
 6227: 
 6228:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6229:    // Splines allow for a smooth transition between vertical levels.
 6230:    // Splines have continuity restrictions at the internal knots, but
 6231:    // we have to provide the 1st derivatives at the endpoints.
 6232:    const int kbs = side->kbs; 
 6233:    
 6234:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6235:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6236:    initCubicSpline(kbs, nvrt, side, ws, up)
 6237: 
 6238:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6239:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6240:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6241: 
 6242:    // Total advection (average onto side)
 6243:    const Node *node1 = side->nodes[0];
 6244:    const Node *node2 = side->nodes[1];
 6245:    for (int k=kbs(i); k<nvrt; k++) {
 6246: 
 6247:       if constexpr(ics==1) {
 6248:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6249:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6250:       } else {
 6251:          // XXX IMPLEMENT THIS
 6252:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6253:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6254:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6255:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6256:       }  // if ics
 6257: 
 6258: 
 6259:    }
 6260: }
 6261: #endif
 6262: 
 6263: 
 6264: extern "C" {
 6265:    __global__ void computeElemAverageGhat(void) {
 6266:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6267: 
 6268:       ELEM(elem);
 6269:       
 6270:       elem->ghat1= {0.0, 0.0};  
 6271: 
 6272:       if constexpr(ihydraulics != 0) {
 6273:          if (nhtblocks > 0 && elem->isblock) return;
 6274:       }
 6275: 
 6276: 
 6277: 
 6278:       
 6279:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6280:       // tidal potential, horizontal diffusion, and baroclinic etc
 6281:       // Remember to update both fb and F 
 6282:       // If ics=2, ghat1 are in eframe (ll)
 6283:       // cff1-3: coefficients for 2D/3D
 6284:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6285:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6286:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6287: 
 6288:       if (elem->isDry) return;
 6289: 
 6290:       double av_cff1 = 0.0;  // av. for cff1
 6291:       double av_cff2 = 0.0;  // av. for cff2
 6292:       double av_cff3 = 0.0;  // av. for cff3
 6293:       double av_df = 0.0;  // av. for H^\alpha / H
 6294:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6295:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6296: 
 6297:       const int i34 = elem->i34;
 6298:       const int kb = elem->kb;
 6299: 
 6300:       for (int j=0; j<i34; j++) {
 6301:          // For each node and side in the element...
 6302: 
 6303:          const Node *node = elem->nodes[j];
 6304:          const Side *side = elem->sides[j];
 6305: 
 6306:          const double chi      = side->chi;
 6307:          const double veg_c2   = side->veg_c2;
 6308:          const double veg_beta = side->veg_beta;
 6309:          const double veg_h    = side->veg_h();
 6310:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6311: 
 6312:          // Node - const in elem
 6313:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6314:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6315: 
 6316:          if (elem->depth >= tip_dp) {
 6317:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6318:          }
 6319: 
 6320:          
 6321:          const double htot  = side->htot2();        // Total depth at the side
 6322:          const double zctr2 = side->zTopCanopy();  
 6323: 
 6324:          double cff1; 
 6325:          double cff2; 
 6326:          double cff3;   
 6327:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6328:          // coefficients applied to 2D/3D case 
 6329:             cff1 = side->hhat/htot;
 6330:             cff2 = 0.0;
 6331:             cff3 = 0.0;
 6332:          } else { //3D
 6333:             //Init for no-veg case
 6334:             cff1 = 1.0;
 6335:             cff2 = 1.0;
 6336:             cff3 = 0.0;
 6337: 
 6338:             if constexpr(iveg != 0) {
 6339:                // Computes coefficients used with vegetation terms G1, G2
 6340:                // cff1, cff3 are used for the first two terms in G1, G2:
 6341:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6342:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6343:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6344:                if(veg_h < 0.99*htot) { // submergent vegetation
 6345:                   cff1=1;
 6346:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6347:                   cff3 = veg_c;
 6348: 
 6349:                } else { // emergent vegetation
 6350:                   cff1 = 1.0/(1.0 + veg_c2);
 6351:                   cff2 = cff1;
 6352:                   cff3 = 0.0;
 6353: 
 6354:                }
 6355:             } // if iveg
 6356:          } //  2D/3D
 6357: 
 6358:          av_cff1 += cff1/i34;
 6359:          av_cff2 += cff2/i34;
 6360:          av_cff3 += cff3/i34;
 6361:          av_cff2_chi += cff2*chi/i34;
 6362:          av_cff3_chi += cff3*chi/i34;
 6363:          av_df += min(htot, veg_h)/(htot*i34);
 6364: 
 6365: 
 6366:          // btrack values: U^\star, U^{\star\alpha}
 6367:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6368:          Vector2 Ustar       = {0.0, 0.0}; 
 6369:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6370: 
 6371:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6372:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6373:          } else { //3D
 6374:             for (int k = side->kb + 1; k < nvrt; k++) {
 6375:             
 6376:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6377:                Ustar += w2;
 6378: 
 6379:                if constexpr(iveg != 0) {
 6380:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6381:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6382:                        Ustar_alpha += zrat*w2; // XXXX
 6383:                    }
 6384:                }  // if iveg
 6385:             }  // for k
 6386:          }  //2D/3D
 6387:          
 6388: 
 6389:          // Add btrack & surface stress terms to \breve{G} first
 6390:          if constexpr(ics==1) {
 6391: 
 6392:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6393: 
 6394:          } else {
 6395:             assert(false && "computeElemAverageGhat: Not implemented");
 6396:             // XXX IMPLEMENT THIS
 6397:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6398:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6399:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6400:          }  // if ics
 6401: 
 6402:          // Surface and bottom stress terms
 6403:          if constexpr(ics==1) {
 6404:             const Vector2 tau    = side->tau();
 6405:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6406: 
 6407:             // Term for surface and bottom stress
 6408:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6409: 
 6410:          } else {
 6411:             assert(false && "computeElemAverageGhat: Not implemented");
 6412:             // XXX IMPLEMENT THIS
 6413:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6414:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6415:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6416:             // tau_x=(vn1+tt1)/2.d0
 6417:             // tau_y=(vn2+ss1)/2.d0
 6418:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6419:          }  // if ics
 6420: 
 6421:          
 6422: 
 6423:          // All terms in F,F^\alpha,f_b except baroclinic
 6424:          // F, f_b: all explicit terms excluding vegetation 
 6425:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6426:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6427:          const double coriolis = side->coriolis;
 6428:          Vector2 F  =  coriolis*side->U;  // F_x
 6429:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6430:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6431: 
 6432:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6433:             
 6434:             for (int k = side->kb; k < nvrt; k++) {
 6435:                if (zctr2 > side->zc[k-1]) {
 6436:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6437:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6438:                    Fa +=  coriolis*w2*zrat;
 6439:                } // if zctr2
 6440:             } // k
 6441:          } // iveg
 6442: 
 6443:          // Integrate horizontal viscosity force vertically
 6444:          for (int k=side->kb + 1; k<nvrt; k++) {
 6445:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6446: 
 6447:             F += levelHorVisc;
 6448: 
 6449:             // Vegetation term
 6450:             if constexpr(iveg!=0) {
 6451:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6452:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6453:                   Fa += levelHorVisc*zrat;
 6454:                } 
 6455:             } // if iveg
 6456:          } // for k
 6457: 
 6458:          fb += side->nuGradU[side->kb];
 6459: 
 6460:          // Add to ghat1
 6461:          if constexpr(ics==2) {
 6462:             assert(false && "computeElemAverageGhat: Not implemented");
 6463:             // XXX IMPLEMENT THIS
 6464:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6465:             // bigf1=vn1; bigf2=vn2
 6466:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6467:             // botf1=vn1; botf2=vn2
 6468:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6469:             // bigfa1=vn1; bigfa2=vn2
 6470:          } // if ics
 6471: 
 6472:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6473:       } // for j (nodes and sides)
 6474: 
 6475:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6476:          
 6477:       // Finish off terms in F, F^\alpha and f_b
 6478:       const double grav3 = elem->mean(&Node::grav2);
 6479:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6480: 
 6481: 
 6482:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6483:       for (int j=1; j<i34; j++) { 
 6484:          // For each side in the element...
 6485:          const Side *side = elem->sides[j];
 6486:          const double chi = side->chi;
 6487: 
 6488:          const double htot = side->htot2();
 6489:          const double veg_h = side->veg_h();
 6490:          const Vector2 F  = htot*fb;
 6491:          const Vector2 Fa = min(htot, veg_h)*fb;
 6492: 
 6493:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6494:       } // for j
 6495: 
 6496:       //botf1 etc are already in elem frame
 6497:       elem->ghat1 += tmp/i34;
 6498: 
 6499:       // Baroclinic force
 6500:       if constexpr(ibc==0) {
 6501:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6502: 
 6503:          Vector2 Fa = {0.0, 0.0};
 6504:          Vector2 intGradRho = {0.0, 0.0};
 6505:          
 6506:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6507:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6508:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6509: 
 6510:             // \in F [m^2/s/s]
 6511:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6512:          }
 6513: 
 6514:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6515:          const Vector2 F = av_df*Fa; //approx
 6516:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6517: 
 6518:       } // if ibc
 6519: 
 6520: 
 6521: 
 6522:    }
 6523: 
 6524: } // extern "C"
 6525: 
 6526: 
 6527: 
 6528: #ifdef DONTCOMPILE
 6529: __global__ void checkMassConservation(Tracers* sumtr) {
 6530: 
 6531:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6532: 
 6533:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6534: 
 6535:    Element *elem = &(mesh->localElemData[i]);
 6536: 
 6537:    // Skip dry elements
 6538:    if (elem->isDry) return;
 6539: 
 6540:    // Local sum array for this thread
 6541:    double localSum[N_TRACERS] = {0.0};
 6542: 
 6543:    // Sum over vertical levels for this element
 6544:    const int kbe = elem->kbe;
 6545:    const double area = elem->area;
 6546: 
 6547:    for (int k = kbe; k < nvrt; k++) {
 6548:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6549:       
 6550:       // Accumulate tracer mass
 6551:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6552:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6553:       }
 6554:    }
 6555: 
 6556:    //  This function returns per element sums. A reduction must be done on the host side.
 6557: }
 6558: 
 6559: 
 6560: __global__ void transport(void) {
 6561: 
 6562:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6563: 
 6564:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6565: 
 6566:    Element *elem = &(mesh->localElemData[ie]);
 6567: 
 6568:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6569: 
 6570:                for (int m=0; m<ntr; m++) {
 6571:                   for (int k=kbe(ie); k<nvrt; k++) {
 6572:                      // Calculate each polynomial's weight 
 6573:                      wm=0.d0; sum1=0.d0; 
 6574:                      wm1=0.d0; wm2=0.d0; 
 6575:                      for (int i=0; i<elem->nweno2; i++) {
 6576:                   
 6577:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6578:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6579:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6580:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6581:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6582:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6583:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6584:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6585:                      // -----------------Hu and Shu (1999)'s method----------------
 6586:                      b4=b1+b2+b3
 6587: 
 6588: //Error: add PRODUCTION CPP
 6589: #ifdef DEBUG
 6590:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6591:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6592:                     call parallel_abort(errmsg)
 6593:                   }
 6594: #endif
 6595: 
 6596:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6597:                   // !----test-------------- 
 6598:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6599:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6600:                   // !wm(i)=wm1(i)*wm2(i)
 6601:                   // !---------------------- 
 6602:                   sum1=sum1+wm(i)
 6603:                 } // end for i
 6604: 
 6605:                 wm=wm/sum1
 6606: 
 6607:                 for (int j=0; j<elem->i34; j++) {
 6608: 
 6609:                   const Side *side  = elem->sides[j];
 6610:                   const Node *node1 = side->n1;
 6611:                   const Node *node2 = side->n2;
 6612: 
 6613:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6614:                      trsd=0.d0
 6615:                      for (int kk=0; kk<nquad; kk++) {
 6616:                         for (int i=0; i<elem->nweno2; i++) {
 6617:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6618:                         } // end for i   
 6619:                      } // end for kk
 6620:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6621:                   } // outward flux
 6622:                } // end for j=1,i34(ie) ! side
 6623:             }
 6624:          }
 6625:               
 6626: 
 6627: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6628: //             //   calculate each polynomial's weight 
 6629: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6630: //                 wm=0.d0; sum1=0.d0
 6631: //                 do i=1,nweno1(ie) !for each polynomial
 6632: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6633: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6634: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6635: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6636: //                   wm(i)=b2
 6637: //                   sum1=sum1+b2
 6638: //                   !wm(i)=1.d0
 6639: //                   !sum1=sum1+1.d0
 6640: 
 6641: // // Error: PRODUCTION
 6642: // #ifdef DEBUG
 6643: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6644: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6645: //                     call parallel_abort(errmsg)
 6646: //                   endif
 6647: // #endif
 6648: 
 6649: //                 enddo !i
 6650: //                 wm=wm/sum1 !final weight
 6651: 
 6652:                 for (int j=0; j<elem->i34; j++) { // side
 6653:                   const Side *side = elem->sides[j];
 6654:                   const Node *node1 = side->n1;
 6655:                   const Node *node2 = side->n2;
 6656: 
 6657:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6658:                     trsd=0.d0
 6659:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6660:                       for (int i=0; i<elem->nweno1; i++) {
 6661:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6662:                       }
 6663:                     enddo //kk
 6664:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6665:                   } // outward flux
 6666:                 } // end for j=1,i34(ie) ! side
 6667:               } // end for k; ntr 
 6668: 
 6669:             else !simple upwind method
 6670:               do j=1,i34(ie)
 6671:                 jsj=elside(j,ie)
 6672:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6673:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6674:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6675:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6676:                   endif
 6677:                 enddo  !vertical layers
 6678:               enddo !j=1,i34(ie) ! side
 6679:             endif !order of accuracy
 6680: 
 6681:          //  enddo !ie
 6682: // !$OMP     end do
