 4421: // __device__ void vertLinearInterp(double zt, int k1, int k2, double *za, double *s_in, double *s_out, int *ibelow) {
 4422: // //     Routine to do vertical linear interpolation in z
 4423: // //     Inputs:
 4424: // //
 4425: // //       k1,k2: lower and upper limits for za, s_in 
