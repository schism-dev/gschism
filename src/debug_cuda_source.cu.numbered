 9610: 
 9611: 
 9612: __device__ __forceinline__ double fluxLim(double upwindRatio) {
 9613: // Flux limiter functions used in TVD schemes
 9614: 
 9615:    if constexpr (typeTVD == tvdSB)
 9616:       return max(0.0, max(min(1.0, 2.0*upwindRatio), min(2.0, upwindRatio)));
 9617:    else if constexpr (typeTVD == tvdVL)
 9618:       return (upwindRatio + abs(upwindRatio)) / (1.0 + abs(upwindRatio));
 9619:    else if constexpr (typeTVD == tvdMM)
 9620:       return max(0.0, min(1.0, upwindRatio));
 9621:    else if constexpr (typeTVD == tvdOS)
 9622:       return max(0.0, min(2.0, upwindRatio));
 9623:    else {
 9624:       assert(false && "TVD limiter not defined");
 9625:       return 0.0;
 9626:    }
 9627: }
 9628: 
 9629: 
 9630: #ifdef DONTCOMPILE
 9631: __global__ void checkMassConservation(Tracers* sumtr) {
 9632: 
 9633:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 9634: 
 9635:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 9636: 
 9637:    Element *elem = &(mesh->localElemData[i]);
 9638: 
 9639:    // Skip dry elements
 9640:    if (elem->isDry) return;
 9641: 
 9642:    // Local sum array for this thread
 9643:    double localSum[N_TRACERS] = {0.0};
 9644: 
 9645:    // Sum over vertical levels for this element
 9646:    const int kbe = elem->kbe;
 9647:    const double area = elem->area;
 9648: 
 9649:    for (int k = kbe; k < nvrt; k++) {
 9650:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 9651:       
 9652:       // Accumulate tracer mass
 9653:       for (int tr = 0; tr < N_TRACERS; tr++) {
 9654:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 9655:       }
 9656:    }
 9657: 
 9658:    //  This function returns per element sums. A reduction must be done on the host side.
 9659: }  
 9660: 
 9661: 
 9662: __global__ void transport(void) {
 9663: 
 9664:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 9665: 
 9666:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 9667: 
 9668:    Element *elem = &(mesh->localElemData[ie]);
 9669: 
 9670:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 9671: 
 9672:                for (int m=0; m<ntr; m++) {
 9673:                   for (int k=kbe(ie); k<nvrt; k++) {
 9674:                      // Calculate each polynomial's weight 
 9675:                      wm=0.d0; sum1=0.d0; 
 9676:                      wm1=0.d0; wm2=0.d0; 
 9677:                      for (int i=0; i<elem->nweno2; i++) {
 9678:                   
 9679:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 9680:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 9681:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 9682:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 9683:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 9684:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 9685:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 9686:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 9687:                      // -----------------Hu and Shu (1999)'s method----------------
 9688:                      b4=b1+b2+b3
 9689: 
 9690: //Error: add PRODUCTION CPP
 9691: #ifdef DEBUG
 9692:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 9693:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 9694:                     call parallel_abort(errmsg)
 9695:                   }
 9696: #endif
 9697: 
 9698:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 9699:                   // !----test-------------- 
 9700:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 9701:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 9702:                   // !wm(i)=wm1(i)*wm2(i)
 9703:                   // !---------------------- 
 9704:                   sum1=sum1+wm(i)
 9705:                 } // end for i
 9706: 
 9707:                 wm=wm/sum1
 9708: 
 9709:                 for (int j=0; j<elem->i34; j++) {
 9710: 
 9711:                   const Side *side  = elem->sides[j];
 9712:                   const Node *node1 = side->n1;
 9713:                   const Node *node2 = side->n2;
 9714: 
 9715:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 9716:                      trsd=0.d0
 9717:                      for (int kk=0; kk<nquad; kk++) {
 9718:                         for (int i=0; i<elem->nweno2; i++) {
 9719:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 9720:                         } // end for i   
 9721:                      } // end for kk
 9722:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 9723:                   } // outward flux
 9724:                } // end for j=1,i34(ie) ! side
 9725:             }
 9726:          }
 9727:               
 9728: 
 9729: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 9730: //             //   calculate each polynomial's weight 
 9731: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 9732: //                 wm=0.d0; sum1=0.d0
 9733: //                 do i=1,nweno1(ie) !for each polynomial
 9734: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 9735: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 9736: //                   b1=b1*b1+b2*b2 !smoothness indicator
 9737: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 9738: //                   wm(i)=b2
 9739: //                   sum1=sum1+b2
 9740: //                   !wm(i)=1.d0
 9741: //                   !sum1=sum1+1.d0
 9742: 
 9743: // // Error: PRODUCTION
 9744: // #ifdef DEBUG
 9745: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 9746: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 9747: //                     call parallel_abort(errmsg)
 9748: //                   endif
 9749: // #endif
 9750: 
 9751: //                 enddo !i
 9752: //                 wm=wm/sum1 !final weight
 9753: 
 9754:                 for (int j=0; j<elem->i34; j++) { // side
 9755:                   const Side *side = elem->sides[j];
 9756:                   const Node *node1 = side->n1;
 9757:                   const Node *node2 = side->n2;
 9758: 
 9759:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 9760:                     trsd=0.d0
 9761:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 9762:                       for (int i=0; i<elem->nweno1; i++) {
 9763:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 9764:                       }
 9765:                     enddo //kk
 9766:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 9767:                   } // outward flux
 9768:                 } // end for j=1,i34(ie) ! side
 9769:               } // end for k; ntr 
 9770: 
 9771:             else !simple upwind method
 9772:               do j=1,i34(ie)
 9773:                 jsj=elside(j,ie)
 9774:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 9775:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 9776:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 9777:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 9778:                   endif
 9779:                 enddo  !vertical layers
 9780:               enddo !j=1,i34(ie) ! side
 9781:             endif !order of accuracy
 9782: 
 9783:          //  enddo !ie
 9784: // !$OMP     end do
 9785: 
