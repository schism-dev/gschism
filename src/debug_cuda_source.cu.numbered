 1450: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1451:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1452: }
 1453: 
 1454: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1455:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1456: }   
 1457: 
 1458: __device__ __inline__ double min3(double a, double b, double c) {
 1459:    return min(a, min(b, c));
 1460: }
 1461: 
 1462: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1463:    return min(a, min(b, min(c, d)));
 1464: }
