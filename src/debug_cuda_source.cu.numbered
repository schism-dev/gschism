 4371: 
 4372: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 4373:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 4374:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 4375: 
 4376: 
 4377:    NODE(node1);
 4378: 
 4379:    node1->clearMatrixRow();
 4380:    node1->qel = 0.0;
 4381: 
 4382:    // THIS IS FOR STRUCTURES XXX
 4383:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 4384: 
 4385:    
 4386:    for (int j=0; j<node1->numElements; j++) {
 4387:       // For each element connected to the node...
 4388: 
 4389:       Point2 x0, x1, x2, x3; // Local horizontal node positions
 4390: 
 4391:       Element *elem = node1->elements[j];
 4392: 
 4393:       // Compute the average gravity
 4394:       const double grav3 = elem->mean(&Node::grav2);
 4395: 
 4396:       // Look at the documentation for the description of the terms in the following integrals
 4397: 
 4398:       // Integral I_1 
 4399:       // \bar{\breve{H}} 
 4400:       const double hhatb = elem->mean(&Side::hhat);        
 4401: 
 4402:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 4403: 
 4404:       const int id1 = elem->nodeLocalIdx(node1);  // Index of node1 in element->nodes[]
 4405:       const double area = elem->area;
 4406: 
 4407:       // Integral I_4
 4408:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 4409:       // Where
 4410:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 4411: 
 4412:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 4413:       // of U over the element.
 4414:       const Vector2 U = elem->mean(&Side::U);
 4415: 
 4416:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 4417: 
 4418:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 4419:       const double I_4_1 = dot(gradPhi_1, U);
 4420: 
 4421: 
 4422:       // Integral of \nabla\phi_i \cdot \pmb{E}
 4423:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 4424: 
 4425:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 4426: 
 4427: 
 4428:       // Normal component of the bed velocity
 4429:       double ubedNormalComp = 0.0;
 4430:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 4431:          Vector3 ubed = {0.0, 0.0, 0.0};
 4432:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 4433:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 4434: 
 4435:          // Computes a unit vector perpendicular to the bottom face. It is computed as the unit vector parallel to (grad(h), 1)
 4436:          const Vector2 gradDepth = elem->grad2(&Node::depth);
 4437:          const Vector3 N = normalize(toVector3(gradDepth, 1.0));
 4438: 
 4439:          // Computes the normal component of the bed velocity
 4440:          ubedNormalComp = dot(ubed, N);
 4441:       } // imm==2
 4442: 
 4443:       const double fricCoeff = grav3*thetai*(1.0 - thetai)*dt*dt*hhatb;
 4444: 
 4445:       if (elem->isTri()) {
 4446: 
 4447:          // To clarify the notation in this section: 
 4448:          //   In formulas, we use the following notation:
 4449:          //       i stands for the node under consideration (node1)
 4450:          //       j (node2) and k (node3) are the other nodes of the triangle.
 4451:          //   However, in the code, we use the following notation:
 4452:          //       id1 is the node under consideration (node1), id2, id3 are the local indices of the other nodes (node2, node3)
 4453:          const int id2 = elem->nxq(1 + id1);
 4454:          const int id3 = elem->nxq(2 + id1);
 4455:          Node *node2 = elem->nodes[id2];
 4456:          Node *node3 = elem->nodes[id3];
 4457: 
 4458:          elem->getLocalHorizontalNodePositionsTri(x0, x1, x2, id1);
 4459: 
 4460:          // integral of phi_i*phi_j
 4461:          const double ipp_ii = (1.0/6.0 )*area;
 4462:          const double ipp_ij = (1.0/12.0)*area;
 4463:          const double ipp_ik = (1.0/12.0)*area;
 4464: 
 4465:          // integral of [(grad phi_i) * (grad phi_j)]
 4466:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x2-x1, x2-x1);
 4467:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x2-x1, x0-x2);
 4468:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a.c = a.(a+b+c-c) = a.a + a.b
 4469: 
 4470:          // Computes the different components of integral I_1 of each node with respect to node i.
 4471:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4472:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4473:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4474: 
 4475:          node1->addToSparseMatrix(node1, I1_ii);
 4476:          node1->addToSparseMatrix(node2, I1_ij); 
 4477:          node1->addToSparseMatrix(node3, I1_ik);
 4478: 
 4479:          #pragma unroll
 4480:          for (int l=0; l<3; l++) {
 4481: 
 4482:             Node *node = elem->nodes[l];
 4483: 
 4484:             // Additional variation in eta due to bed deformation or vertical velocity
 4485:             double extraEta = 0.0;
 4486:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 4487:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1;
 4488: 
 4489: 
 4490:             const double ipp   = elem->intPhiPhiTri(id1, l);
 4491:             const double igpgp = elem->intGradPhiGradPhiTri(id1, l);
 4492: 
 4493:             const double isElemWet = elem->isDry ? 0.0 : 1.0;  // XXXXX I added this to replicate Fortran's code, but Joseph is going to check if it is needed.
 4494: 
 4495:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp*isElemWet;
 4496:            
 4497:          }
 4498: 
 4499: 
 4500:       }
 4501:       else { // Quad
 4502:          // To clarify the notation in this section: 
 4503:          //   In formulas, we use the following notation:
 4504:          //       i stands for the node under consideration (node1)
 4505:          //       j (node2), k (node3), l (node4) are the other nodes of the quad.
 4506:          //   However, in the code, we use the following notation:
 4507:          //       id1 is the node under consideration (node1), id2, id3, id4 are the local indices of the other nodes (node2, node3, node4)
 4508:          const int id2 = elem->nxq(1 + id1);
 4509:          const int id3 = elem->nxq(2 + id1);
 4510:          const int id4 = elem->nxq(3 + id1);
 4511:          Node *node2 = elem->nodes[id2];
 4512:          Node *node3 = elem->nodes[id3];
 4513:          Node *node4 = elem->nodes[id4];   
 4514:          
 4515:          elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 4516: 
 4517:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 4518:          const double ipp_ii = elem->intPhiPhiQuad(id1, id1, x0, x1, x2, x3);
 4519:          const double ipp_ij = elem->intPhiPhiQuad(id1, id2, x0, x1, x2, x3);
 4520:          const double ipp_ik = elem->intPhiPhiQuad(id1, id3, x0, x1, x2, x3);
 4521:          const double ipp_il = elem->intPhiPhiQuad(id1, id4, x0, x1, x2, x3);
 4522: 
 4523:          // integrals of (grad phi_i) * (grad phi_i), (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 4524:          const double igpgp_ii = elem->intGradPhiGradPhiQuad(id1, id1, x0, x1, x2, x3);
 4525:          const double igpgp_ij = elem->intGradPhiGradPhiQuad(id1, id2, x0, x1, x2, x3);
 4526:          const double igpgp_ik = elem->intGradPhiGradPhiQuad(id1, id3, x0, x1, x2, x3);
 4527:          const double igpgp_il = elem->intGradPhiGradPhiQuad(id1, id4, x0, x1, x2, x3);
 4528: 
 4529: 
 4530:          // Computes the different components of integral I_1 of each node with respect to node i.
 4531:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4532:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4533:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4534:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 4535: 
 4536:          node1->addToSparseMatrix(node1, I1_ii);
 4537:          node1->addToSparseMatrix(node2, I1_ij); 
 4538:          node1->addToSparseMatrix(node3, I1_ik);
 4539:          node1->addToSparseMatrix(node4, I1_il);
 4540:   
 4541:          #pragma unroll
 4542:          for (int l=0; l<4; l++) {
 4543: 
 4544:             const Node *node = elem->nodes[l];
 4545: 
 4546:             // Additional variation in eta due to bed deformation or vertical velocity
 4547:             double extraEta = 0.0;
 4548:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 4549:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1; 
 4550: 
 4551:             const double ipp = elem->intPhiPhiQuad(id1, l, x0, x1, x2, x3);
 4552:             const double igpgp = elem->intGradPhiGradPhiQuad(id1, l, x0, x1, x2, x3);
 4553:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp;
 4554: 
 4555:          }         
 4556:       } 
 4557: 
 4558: 
 4559:      node1->qel += (dt/elem->i34)*elem->vsource;
 4560:       
 4561: 
 4562:    } // for all elements connected to the node
 4563:    
 4564: 
 4565:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 4566:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 4567:    NodeBoundary *nodeBnd = node1->nodeBnd;
 4568:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 4569:    // If it is an open boundary node...
 4570: 
 4571:    // XXXXX DO THIS MORE NATURALLY IN A SideBnd kernel?
 4572: 
 4573:       // At least one open bnd side, maybe two
 4574:       for (int l=0; l<2; l++) { 
 4575: 
 4576:          // Gets each of the sides sharing the node. 
 4577:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 4578: 
 4579:     
 4580: 
 4581:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 4582:          if (sideBnd != nullptr) {
 4583:             // If the side is on a boundary...
 4584: 
 4585:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 4586: 
 4587:             // Get the boundary segment
 4588:             const BoundarySegment *sideSegment = sideBnd->segment;
 4589:             const Side *side = sideBnd->side;
 4590: 
 4591:             // Integral I_3
 4592:             if (sideSegment->ifltype != 0) {
 4593:             // Natural or Flather b.c.
 4594: 
 4595:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4596:                // especially for Flather b.c.
 4597:                double ri3 = 0.0;
 4598:                if (!side->isDry) {
 4599:                   // If the side is not dry
 4600:                   
 4601:                   // Computes the side flux of (uth, vth)
 4602:                   double Vn = 0.0;
 4603:                   for (int k = side->kb; k < nvrt - 1; k++) {
 4604:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4605:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4606: 
 4607:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 4608:                   }
 4609: 
 4610:                   ri3 = 0.5*side->len*Vn;
 4611:                }
 4612: 
 4613:                if (sideSegment->ifltype == -1) { // Flather 1
 4614: 
 4615:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4616:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4617: 
 4618:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4619:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4620:                   
 4621:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4622:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4623: 
 4624:                } 
 4625:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4626:                   // Reset ri3
 4627:                   ri3 = 0.0;
 4628: 
 4629:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4630:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 4631: 
 4632:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4633: 
 4634:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4635:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4636: 
 4637:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4638:                   node1->addToSparseMatrix(node1, con0*2.0);
 4639:                   node1->addToSparseMatrix(node2, con0);
 4640: 
 4641:                } // if Flather or Discharge
 4642: 
 4643:                node1->qel -= thetai*dt*ri3;  
 4644: 
 4645: 
 4646:             } // I_3
 4647:           
 4648: 
 4649:             // Integral I_5
 4650:             if(!side->isDry) {
 4651: 
 4652:                const double Unbar = dot(side->U, side->n);
 4653:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar; 
 4654: 
 4655:             } // I_5
 4656: 
 4657:          } // if is boundary side
 4658: 
 4659:       } // for l
 4660: 
 4661:    } // if isbnd
 4662: 
 4663: 
 4664: }
 4665: 
 4666: 
 4667: 
 4668: extern "C" {
 4669:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 4670:                                   int* indices, int* indptr) {
 4671: 
 4672:       NODE(node);
 4673:       
 4674:       const int idx = node->idx;
 4675:       
 4676:       // Computes the index in the nzz array      
 4677:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 4678: 
 4679: 
 4680:       indptr[idx] = nzzIdx;
 4681:       indices[nzzIdx] = idx;
 4682: 
 4683:       data_d[nzzIdx]    = node->coeffDiag;
 4684: 
 4685:       b_d[idx] = node->qel;
 4686: 
 4687:       for (int k = 0; k < node->numNodes; ++k) {
 4688:          const Node* nb = node->nodes[k];
 4689: 
 4690:          const int j = nb->idx;
 4691: 
 4692:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 4693: 
 4694:          indices[nzzIdx + k + 1] = j;
 4695:       }
 4696: 
 4697:  
 4698:    }
 4699: 
 4700: 
 4701: 
 4702:    __global__ void solverCopyResult(double* x) {
 4703:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 4704:       NODE(node);
 4705:       const int idx = node->idx;
 4706: 
 4707:       node->mX = x[idx];
 4708:    }
 4709: 
 4710: 
 4711:    __global__ void rollUpElevation(void) {
 4712: 
 4713:       NODE(node);
 4714: 
 4715:       node->eta1 = node->eta2;
 4716: 
 4717:    }
 4718: 
 4719: 
 4720:    __global__ void backtrackAllNodes(void) {
 4721: 
 4722:       // max/min # of sub-divisions
 4723:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4724:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4725: 
 4726:       SIDE(side);
 4727: 
 4728:       const int kb = side->kb;
 4729: 
 4730: 
 4731:       // Initialize btrack velocities to the actual velocities at the side 
 4732:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4733:   
 4734:       if (side->isDry) return;
 4735:      
 4736: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4737: 
 4738:       // Checks that at least one element is not dry
 4739:       const Element *elem1 = side->elems[0];
 4740:       const Element *elem2 = side->elems[1];
 4741: 
 4742: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4743: 
 4744:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4745:       
 4746:       // XXXXXX
 4747:       // !swild_tmp to store global coord. of the starting side
 4748:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4749:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4750:       // !Use sframe2 
 4751:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4752: 
 4753: 
 4754:       for (int k = kb; k < nvrt; k++) {
 4755:       //  For ics=2, the coordinates are all in the side's local frame
 4756: 
 4757:          const int iadvf = side->iadv();  // Advection flag   
 4758:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4759: 
 4760:          const double vmag2 = norm2(side->u2[k]);
 4761: 
 4762:          if (vmag2 <= velmin_btrack_sq) {  
 4763:             // No activity 
 4764: 
 4765:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4766:             
 4767:          } else {  // do btrack
 4768: 
 4769:             // Compute number of sub-divisions based on local gradients of the velocity field
 4770: 
 4771:             // XXX IS THIS NECESSARY?
 4772:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4773:             double suma = 0.0;
 4774:             int icount = 0;
 4775:             #pragma unroll
 4776:             for (int l=0; l<2; l++) {
 4777:             // For each element sharing the side...
 4778: 
 4779:                const Element *elem = side->elems[l];
 4780:                  
 4781:                if (elem == nullptr) continue;
 4782: 
 4783:                icount++;
 4784: 
 4785:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 4786:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 4787:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 4788: 
 4789:                double utmp[4];
 4790:                double vtmp[4];
 4791:                #pragma unroll
 4792:                for (int j = 0; j < elem->i34; j++) {
 4793: 
 4794:                   const Node *node = elem->nodes[j];
 4795: 
 4796:                   if constexpr(ics==1) {
 4797:                      utmp[j] = node->u2[k].x;
 4798:                      vtmp[j] = node->u2[k].y;  
 4799: 
 4800:                   } else {
 4801:                      // 'Project' the velocity from the node frame to the element frame
 4802:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 4803:                      utmp[j] = tmp_u2.x;
 4804:                      vtmp[j] = tmp_u2.y;
 4805: 
 4806:                   }
 4807:                } // for j
 4808: 
 4809:                const Vector2 grad_u = elem->grad2(utmp); 
 4810:                const Vector2 grad_v = elem->grad2(vtmp);
 4811:    
 4812:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4813:             } // for l
 4814: 
 4815:             assert(icount > 0 && "Impossible 77");
 4816: 
 4817:             // '4' is somewhat arbitrary
 4818:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4819: 
 4820:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4821:             Vector3 u_int = {0.0, 0.0, 0.0};
 4822: 
 4823:             side->btrack(k, dt, dtbk, u_int);
 4824: 
 4825: 
 4826:             side->btu[k] = {u_int.x, u_int.y};
 4827:                
 4828:          } // if vmag (do backtrack)
 4829: 
 4830: 
 4831:       } // for k=kb,nvrt-1
 4832: 
 4833:    }
 4834: 
 4835: } // extern "C"
 4836: 
 4837: template<int nc>
 4838: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4839: 
 4840: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4841: //
 4842: // a,b,c,rhs: input vectors and are not modified by this program.
 4843: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4844: // rhs is the r.h.s.
 4845: // n: actual rank of the system.
 4846: // rows in u() and rhs();
 4847: // u: output with nc columns (transposed to rows)
 4848: // gam: a working array.
 4849: //
 4850: // NOTES:
 4851: // This is a template function that allows for different numbers of columns in the rhs vector.
 4852: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4853: 
 4854:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4855:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4856: 
 4857:    double bet = b[0];
 4858:    if constexpr (nc == 1) {
 4859:       u[0] = rhs[0]/bet;
 4860:    } else {
 4861:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4862:    }
 4863: 
 4864:    for (int j = 1; j < n; j++) {
 4865:       gam[j] = c[j - 1]/bet;
 4866:       bet = b[j] - a[j]*gam[j];
 4867: 
 4868:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4869: 
 4870:       if constexpr (nc == 1) {
 4871:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4872:       } else {
 4873:          for (int l = 0; l < nc; l++) {
 4874:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4875:          }
 4876:       }
 4877:    }
 4878: 
 4879:    // Back-substitution
 4880:    for (int j = n - 2; j >= 0; j--) {
 4881:       if constexpr (nc == 1) {
 4882:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4883:       } else {
 4884:          for (int l = 0; l < nc; l++) {
 4885:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4886:          }
 4887:       }
 4888:    }
 4889: }
 4890: 
 4891: 
 4892: 
 4893: // Helper function that contains the core algorithm
 4894: template<typename XAccessor, typename YAccessor>
 4895: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4896:                                     double  yp_top, double  yp_bot, 
 4897:                                     CubicSpline &spline) {
 4898:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4899:    // 
 4900:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4901:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4902:    //
 4903:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4904:    // 
 4905:    // Inputs: 
 4906:    //            n: dimension for x etc; # of data pts (>=2);
 4907:    //            getX, getY: functions to access x,y coordinates
 4908:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4909:    //     Output: 
 4910:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4911: 
 4912:    const int n = k2 - k1 + 1;
 4913:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4914: 
 4915:    // Allocate memory for the splines
 4916:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4917:    spline.x   = new double[n];
 4918:    spline.y   = new double[n];
 4919:    spline.yp  = new double[n];
 4920:    spline.ypp = new double[n];
 4921: 
 4922:    for (int k=k1; k<=k2; k++) {
 4923:       spline.x[k] = getX(k);
 4924:       spline.y[k] = getY(k);
 4925:    }
 4926: 
 4927:    // This is to simplify expressions later
 4928:    double *x = spline.x;
 4929:    double *y = spline.y;
 4930: 
 4931:    double *a = nullptr;
 4932:    double *b = nullptr;
 4933:    double *c = nullptr;
 4934:    double *gam = nullptr;
 4935:    double *rhs = nullptr;
 4936:    
 4937: 
 4938:       a = new double[n];   // Lower diagonal
 4939:       b = new double[n];   // Diagonal
 4940:       c = new double[n];   // Upper diagonal
 4941:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4942:       rhs = new double[n]; // Right-hand side
 4943: 
 4944:    for (int k=k1; k<=k2; k++) {
 4945:       if (k == k1) {
 4946:          // Bottom level
 4947:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4948:          b[k] = (x[k+1] - x[k])/3.0;
 4949:          c[k] = b[k]/2.0;
 4950:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4951:       } else if (k == n - 1) {
 4952:          // Top level (surface)
 4953:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4954:          b[k] = (x[k] - x[k-1])/3.0;
 4955:          a[k] = b[k]/2.0;
 4956:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4957:       } else {
 4958:          // Intermediate levels
 4959:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4960:          b[k] = (x[k+1] - x[k-1])/3.0;
 4961:          a[k] = (x[k  ] - x[k-1])/6.0;
 4962:          c[k] = (x[k+1] - x[k  ])/6.0;
 4963:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4964:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4965:       }
 4966:    }
 4967: 
 4968:    // Solve the tridiagonal system
 4969:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4970:    
 4971:    spline.yp[k1] = yp_bot;
 4972:    spline.yp[k2] = yp_top;
 4973: 
 4974:    // Compute rest of 1st derivatives using the splines
 4975:    for (int k=k1+1; k<k2; k++) {
 4976:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4977:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4978:    }
 4979:    
 4980:    delete[] a;
 4981:    delete[] b;
 4982:    delete[] c;
 4983:    delete[] gam;
 4984:    delete[] rhs;
 4985: 
 4986: }
 4987: 
 4988: // Array version
 4989: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4990:                                 double y_top, double y_bot, 
 4991:                                 CubicSpline &spline) {
 4992:    auto getX = [x] (int k) { return x[k]; };
 4993:    auto getY = [y] (int k) { return y[k]; };
 4994:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4995: }
 4996: 
 4997: // Lambda version - allows custom access patterns
 4998: template<typename XFunc, typename YFunc>
 4999: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 5000:                                 double y_top, double y_bot,
 5001:                                 CubicSpline &spline) {
 5002:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5003: }
