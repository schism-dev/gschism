 1060: struct Node {
 1061: 
 1062:    // Geometry information
 1063:    int idx;        // Index of the node
 1064:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1065:    int numNodes;   // Number of nodes neighbors of this node
 1066: 
 1067:    Element **elements; // Array of pointers to the elements that share this node
 1068:    int numElements;    // Number of elements that share this node
 1069: 
 1070:    int numSides;       // Number of sides that are connected to this node
 1071: 
 1072:    Point3 p;
 1073:    Vector3 u2[nvrt];
 1074:    double z[nvrt];
 1075:    double lon, lat;
 1076:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1077:    double depth;
 1078: 
 1079:    int kb;       // Bottom index of the node
 1080: 
 1081:    bool isDry;     // True if the node is dry
 1082: 
 1083:    int iadv;     // Advection flag
 1084: 
 1085:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1086:                           // this is nullptr
 1087: 
 1088:    TempVar tmp; // Temporary variable to store different types of variables
 1089: 
 1090:    // Physical information
 1091:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1092:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1093: 
 1094:    double rho[nvrt];     // Density
 1095:    double dfv[nvrt];     // Vertical viscosity
 1096: 
 1097:    double eta1; // Elevation at nodes at previous timestep
 1098:    double eta2; // Elevation at nodes at current timestep
 1099: 
 1100:    double ETP;  // Earth Tidal Potential
 1101: 
 1102:    double pr;    // Air pressure
 1103:    double grav2; // Gravity 
 1104:    
 1105:    Vector2 dav;  // Depth averaged velocity
 1106: 
 1107:    Vector2 tau; // Wind stress vector
 1108: 
 1109:    // Vegetation parameters
 1110:    double veg_h;
 1111:    double veg_nv;
 1112:    double veg_di;
 1113:    double veg_Cd;
 1114:    double veg_h_unbent;
 1115:    double veg_di_unbent;
 1116:    double veg_nv_unbent;
 1117:    double veg_alpha_vert_mean;
 1118:    double veg_alpha0;
 1119:    double veg_alpha3D[nvrt];
 1120: 
 1121:    // Bottom drag parameters
 1122:    double Cd;       // Bottom drag coefficient
 1123:    double rough;    // Bottom roughness length
 1124:    Vector2 tau_bot; // Bottom stress vector
 1125: 
 1126:    double bdef1; // Bottom deformation at previous timestep
 1127:    double bdef2; // Bottom deformation at current timestep
 1128: 
 1129:    double qel; // RHS
 1130:    double coeffDiag; // Diagonal coefficient of the matrix
 1131:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1132: 
 1133:    double mP; // Search direction for conjugate gradient method
 1134:    double mR; // Residual for conjugate gradient method
 1135:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1136:    double mX; // Solution for conjugate gradient method
 1137: 
 1138:    // Meteorological forcing
 1139:    Vector2 u_air;
 1140:    double p_air;
 1141:    double t_air;
 1142:    double q_air;
 1143:    double wind_angle;  // Wind rotation angle
 1144: 
 1145:    __device__ void setWind(Vector2 &u) {
 1146:    // Sets the wind vector taking into account the wind rotation angle
 1147:    
 1148:       const double dir = atan2(-u.x,-u.y);
 1149:       const double speed = length(u);
 1150: 
 1151:       // Calculate new u and v components with added rotation angle
 1152:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1153:    }
 1154: 
 1155:    __device__ Point2 p2(void) const { return {p.x, p.y}; }
 1156:    __device__ Point3 p3(int k) const { return {p.x, p.y, z[k]}; }
 1157: 
 1158:    __device__ double sigmaTransitionDepth(void) const;
 1159: 
 1160:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1161:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1162:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1163: 
 1164:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1165: 
 1166:    __device__ void clearMatrixRow(void) {
 1167:       // Clear the matrix row for this node
 1168:       coeffDiag = 0.0;
 1169:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1170: 
 1171:    }
 1172: 
 1173:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1174:       // Add the value to the sparse matrix for this node
 1175:       
 1176:       if (node == this) {
 1177:          coeffDiag += value;
 1178: printf("addToSparseMatrix: node == this, value = %f\n", coeffDiag);         
 1179:       } else {
 1180:          // Search (linearly)the index of the node in the array of nodes
 1181:          // XXX: This is not efficient, see if we can improve this
 1182:          int i;
 1183:          for (i = 0; i < numNodes; i++) {
 1184:             if (nodes[i] == node) {
 1185:                break;
 1186:             }
 1187:          }
 1188:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1189:          coeffMatrix[i] += value;
 1190:       }
 1191:    }
 1192: 
 1193: #ifdef BACKTRACKING
 1194:    __device__ void updateZCoordData() {
 1195:    // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 1196: 
 1197:       // Check if node is wet
 1198:       isDry = (depth + eta2 <= h0);  // XXX Check if we are doing this elsewhere
 1199: 
 1200:       if (idry) return;
 1201: 
 1202:       if constexpr(ivcor == 2) {  // SZ coordinates
 1203:          
 1204:          // Compute bottom level index
 1205:          if (depth <= mesh->h_s) {
 1206:                kb = mesh->nzlevels;
 1207:          } else {
 1208:                kb = -1;
 1209:                for (int i = 0; i < mesh->kz-1; i++) {
 1210:                   if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 1211:                      kb = i;
 1212:                      break;
 1213:                   }
 1214:                }
 1215:          }
 1216:       } 
 1217:       else if (ivcor == 1) {  // Localized sigma
 1218:          // Do nothing
 1219:       }
 1220: 
 1221:    }
 1222: #endif   
 1223: 
 1224:    __device__ double compZCoord(int k) const;
 1225: 
 1226:    __device__ void updateKb(void);
 1227: 
 1228: 
 1229: 
 1230: };
