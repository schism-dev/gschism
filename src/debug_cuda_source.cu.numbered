 1607:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1608:       // Compute the different time ramps used in the code 
 1609:       // This function is performed by just one thread
 1610: 
 1611:       rampbc = 1.0;
 1612:       if constexpr(ibc == 0) {
 1613:          if (drampbc > 0.0) {
 1614:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1615:          } else {
 1616:             rampbc = 1.0;
 1617:          }
 1618:       }
 1619: 
 1620:       if (nws != 0) {
 1621:          if (drampwind > 0.0) {
 1622:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1623:          } else {
 1624:             rampwind = 1.0;
 1625:          }
 1626:       }
 1627: 
 1628:       if (drampwafo > 0.0) {
 1629:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1630:       } else {
 1631:          rampwafo = 1.0;
 1632:       }
 1633: 
 1634:       // For source/sinks
 1635:       if (if_source && dramp_ss > 0.0) {
 1636:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1637:       } else {
 1638:          ramp_ss = 1.0;
 1639:       }
 1640: 
 1641:       if (dramp > 0.0) {
 1642:          ramp = tanh(2.0*time/86400.0/dramp);
 1643:       } else {
 1644:          ramp = 1.0;
 1645:       }
 1646: 
 1647: 
 1648:    }
