 2605:    template<typename T>
 2606:    __device__ __forceinline__ T Element::mean(int level, T (Node::* field)[nvrt]) const {
 2607:       T values[4];
 2608:       getNodalValues(level, field, values);
 2609: 
 2610:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2611:       if constexpr (IsVector2<T>::value && ics == 2) {
 2612: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2613:          projectNodeVectorsToElementFrame(values);
 2614: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2615:       }
 2616: 
 2617:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2618:    }
