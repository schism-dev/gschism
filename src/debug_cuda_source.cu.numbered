 1517:    __device__ Mesh(int partNum,
 1518:                    int npgb, int negb, int nsgb, 
 1519:                    int np, int ne, int ns,
 1520:                    int max_np, int max_ne, int max_ns, int nseg,
 1521:                    Node **nodesPtr, Element **elemsPtr, Side **sidesPtr,
 1522:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 1523:                    Node    **localNodeNeighNodesMem,
