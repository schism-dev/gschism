  497: 
  498: // Polynomial class
  499: template<int grade>
  500: struct Polynomial {
  501:     // Static assertion to give a clear error message at compile time
  502:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  503: };
  504: 
  505: 
  506: // Explicit specialization for grade 4
  507: template<>
  508: struct Polynomial<4> {
  509:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  510: 
  511:    // Constructor from coefficients
  512:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  513: 
  514:    __device__ __forceinline__ double eval(double x) const {
  515:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  516:    }
  517: };
