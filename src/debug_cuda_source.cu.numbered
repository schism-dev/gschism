 7204: #ifdef DONTCOMPILE
 7205: __device__ void computeVerticalAdvection(void) {
 7206:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 7207: 
 7208:    sdbt(1:2,:,:)=0.d0
 7209: 
 7210:    const Side *side = FROM kernel;
 7211: 
 7212:    if(side->isDry) return;
 7213: 
 7214:    // If side is wet...
 7215: 
 7216: 
 7217:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 7218:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 7219:    double ws[nvrt] = {} // w @ side
 7220:    int icount = 0;
 7221:    for (int j=0; j<2; j++) {
 7222:       const Element *elem = side->elements[j];
 7223:        
 7224:       if(elem != nullptr) {
 7225:          icount++;
 7226:          for (int k=0; k<nvrt; k++) {
 7227:             ws[k] = ws[k] + elem->w[k];
 7228:          }
 7229:       }
 7230:    }  // for j
 7231: 
 7232:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 7233:    ws = ws/icount;
 7234: 
 7235:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 7236:    // Splines allow for a smooth transition between vertical levels.
 7237:    // Splines have continuity restrictions at the internal knots, but
 7238:    // we have to provide the 1st derivatives at the endpoints.
 7239:    const int kbs = side->kbs; 
 7240:    
 7241:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7242:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7243:    initCubicSpline(kbs, nvrt, side, ws, up)
 7244: 
 7245:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7246:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7247:    initCubicSpline(kbs, nvrt, side, ws, vp)
 7248: 
 7249:    // Total advection (average onto side)
 7250:    const Node *node1 = side->nodes[0];
 7251:    const Node *node2 = side->nodes[1];
 7252:    for (int k=kbs(i); k<nvrt; k++) {
 7253: 
 7254:       Vector2 bcc1 = node1->bcc[k];
 7255:       Vector2 bcc2 = node2->bcc[k];
 7256:       if constexpr(ics == 2) {
 7257:          // Project the velocities from the node frames to the side frame
 7258:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 7259:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 7260:       }
 7261: 
 7262:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 7263:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 7264: 
 7265:    }
 7266: }
 7267: #endif
 7268: 
 7269: 
 7270: extern "C" {
 7271:    __global__ void computeElemAverageGhat(void) {
 7272:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 7273: 
 7274:       ELEM(elem);
 7275:       
 7276:       elem->ghat1= {0.0, 0.0};  
 7277: 
 7278:       if constexpr(ihydraulics != 0) {
 7279:          if (nhtblocks > 0 && elem->isblock) return;
 7280:       }
 7281: 
 7282:       
 7283:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 7284:       // cff1-3: coefficients for 2D/3D
 7285: 
 7286:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7287:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7288:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 7289: 
 7290:       if (elem->isDry) return;
 7291: 
 7292:       // Average of the coefficients
 7293:       double av_cff1 = 0.0;  // av. for cff1
 7294:       double av_cff2 = 0.0;  // av. for cff2
 7295:       double av_cff3 = 0.0;  // av. for cff3
 7296:       double av_df = 0.0;  // av. for H^\alpha / H
 7297:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7298:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7299: 
 7300:       const int i34 = elem->i34;
 7301:       const int kb  = elem->kb;
 7302: 
 7303:       for (int j=0; j<i34; j++) {
 7304:          // For each node and side in the element...
 7305: 
 7306:          const Node *node = elem->nodes[j];
 7307:          const Side *side = elem->sides[j];
 7308: 
 7309:          const double chi      = side->chi;
 7310:          const double veg_c2   = side->veg_c2;
 7311:          const double veg_beta = side->veg_beta;
 7312:          const double veg_h    = side->veg_h();
 7313:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7314: 
 7315:          const Vector2 gradPhi = elem->gradPhi[j];
 7316: 
 7317:          // Node - const in elem
 7318:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 7319:          elem->gradPr  += node->pr  *gradPhi;
 7320: 
 7321:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 7322: 
 7323:         
 7324:          const double htot  = side->htot2();        // Total depth at the side
 7325:          const double zctr2 = side->zTopCanopy();  
 7326: 
 7327:          double cff1; 
 7328:          double cff2; 
 7329:          double cff3;   
 7330:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7331:          // coefficients applied to 2D/3D case 
 7332:             cff1 = side->hhat/htot;
 7333:             cff2 = 0.0;
 7334:             cff3 = 0.0;
 7335:          } else { //3D
 7336:             //Init for no-veg case
 7337:             cff1 = 1.0;
 7338:             cff2 = 1.0;
 7339:             cff3 = 0.0;
 7340: 
 7341:             if constexpr(iveg != 0) {
 7342:                // Computes coefficients used with vegetation terms G1, G2
 7343:                // cff1, cff3 are used for the first two terms in G1, G2:
 7344:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7345:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7346:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7347:                if(veg_h < 0.99*htot) { // submergent vegetation
 7348:                   cff1 = 1.0;
 7349:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7350:                   cff3 = veg_c;
 7351: 
 7352:                } else { // emergent vegetation
 7353:                   cff1 = 1.0/(1.0 + veg_c2);
 7354:                   cff2 = cff1;
 7355:                   cff3 = 0.0;
 7356: 
 7357:                }
 7358:             } // if iveg
 7359:          } //  2D/3D
 7360: 
 7361:          av_cff1 += cff1/i34;
 7362:          av_cff2 += cff2/i34;
 7363:          av_cff3 += cff3/i34;
 7364:          av_cff2_chi += cff2*chi/i34;
 7365:          av_cff3_chi += cff3*chi/i34;
 7366:          av_df += min(htot, veg_h)/(htot*i34);
 7367: 
 7368: 
 7369:          // btrack values: U^\star, U^{\star\alpha}
 7370:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7371:          Vector2 Ustar       = {0.0, 0.0}; 
 7372:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7373: 
 7374:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7375:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7376:          } else { //3D
 7377:             for (int k = side->kb + 1; k < nvrt; k++) {
 7378:             
 7379:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7380:                Ustar += w2;
 7381: 
 7382:                if constexpr(iveg != 0) {
 7383:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7384:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7385:                        Ustar_alpha += zrat*w2; // XXXX
 7386:                    }
 7387:                }  // if iveg
 7388:             }  // for k
 7389:          }  //2D/3D
 7390: 
 7391:          // If needed, project the side velocities to the element frame
 7392:          if constexpr(ics==2) {
 7393:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 7394:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 7395:          }
 7396:         
 7397: 
 7398:          // Add btrack & surface stress terms to \breve{G} first
 7399:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7400: 
 7401: 
 7402:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 7403:          Vector2 tau    = side->tau();  
 7404:          Vector2 ubstar = side->btu[side->kb + 1];  
 7405: 
 7406:          // If needed, project tau and ubstar to the element frame
 7407:          if constexpr(ics==2) {
 7408:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 7409:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 7410:          }
 7411: 
 7412:          // Term for surface and bottom stress
 7413:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7414: 
 7415: 
 7416:          // All terms in F,F^\alpha,f_b except baroclinic
 7417:          // F, f_b: all explicit terms excluding vegetation 
 7418:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7419:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7420:          const double coriolis = side->coriolis;
 7421:          Vector2 F  =  coriolis*side->U;  // F_x
 7422:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7423:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7424: 
 7425:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7426:             
 7427:             for (int k = side->kb; k < nvrt; k++) {
 7428:                if (zctr2 > side->zc[k-1]) {
 7429:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7430:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7431:                    Fa +=  coriolis*w2*zrat;
 7432:                } // if zctr2
 7433:             } // k
 7434:          } // iveg
 7435: 
 7436:          // Integrate horizontal viscosity force vertically
 7437:          for (int k=side->kb + 1; k<nvrt; k++) {
 7438:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7439: 
 7440:             F += levelHorVisc;
 7441: 
 7442:             // Vegetation term
 7443:             if constexpr(iveg!=0) {
 7444:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7445:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7446:                   Fa += levelHorVisc*zrat;
 7447:                } 
 7448:             } // if iveg
 7449:          } // for k
 7450: 
 7451:          // Get nu*grad(U) at the side's bottom level
 7452:          Vector2 nuGradU = side->nuGradU[side->kb];
 7453: 
 7454:          fb += nuGradU;
 7455: 
 7456:          // If needed, project vectorsF, fb and Fa to the element frame
 7457:          if constexpr(ics==2) {
 7458:             F    = side->frame.projHorVec(F,    elem->frame);
 7459:             fb   = side->frame.projHorVec(fb,   elem->frame);
 7460:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 7461:          } // if ics
 7462: 
 7463:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7464:       } // for j (nodes and sides)
 7465: 
 7466:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7467: 
 7468: 
 7469:       // Finish off terms in F, F^\alpha and f_b
 7470:       const double grav3 = elem->mean(&Node::grav2);
 7471:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7472:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7473:       for (int j=0; j<i34; j++) { 
 7474:          // For each side in the element...
 7475:          const Side *side = elem->sides[j];
 7476:          const double chi = side->chi;
 7477: 
 7478:          const double htot = side->htot2();
 7479:          const double veg_h = side->veg_h();
 7480:          const Vector2 F  = htot*fb;
 7481:          const Vector2 Fa = min(htot, veg_h)*fb;
 7482: 
 7483:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7484:       } // for j
 7485: 
 7486:       // tmp is already in elem frame
 7487:       elem->ghat1 += tmp/i34;
 7488: 
 7489:       // Baroclinic force
 7490:       if constexpr(ibc==0) {
 7491:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7492: 
 7493:          Vector2 Fa = {0.0, 0.0};
 7494:          Vector2 intGradRho = {0.0, 0.0};
 7495:          
 7496:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 7497:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 7498:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7499: 
 7500:             // \in F [m^2/s/s]
 7501:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7502:          }
 7503: 
 7504:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7505:          const Vector2 F = av_df*Fa; //approx
 7506:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7507: 
 7508:       } // if ibc
 7509: 
 7510: 
 7511: 
 7512:    }
 7513: 
 7514: } // extern "C"
 7515: 
 7516: 
 7517: 
 7518: #ifdef DONTCOMPILE
 7519: __global__ void checkMassConservation(Tracers* sumtr) {
 7520: 
 7521:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7522: 
 7523:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7524: 
 7525:    Element *elem = &(mesh->localElemData[i]);
 7526: 
 7527:    // Skip dry elements
 7528:    if (elem->isDry) return;
 7529: 
 7530:    // Local sum array for this thread
 7531:    double localSum[N_TRACERS] = {0.0};
 7532: 
 7533:    // Sum over vertical levels for this element
 7534:    const int kbe = elem->kbe;
 7535:    const double area = elem->area;
 7536: 
 7537:    for (int k = kbe; k < nvrt; k++) {
 7538:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7539:       
 7540:       // Accumulate tracer mass
 7541:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7542:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7543:       }
 7544:    }
 7545: 
 7546:    //  This function returns per element sums. A reduction must be done on the host side.
 7547: }
 7548: 
 7549: 
 7550: __global__ void transport(void) {
 7551: 
 7552:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7553: 
 7554:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7555: 
 7556:    Element *elem = &(mesh->localElemData[ie]);
 7557: 
 7558:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7559: 
 7560:                for (int m=0; m<ntr; m++) {
 7561:                   for (int k=kbe(ie); k<nvrt; k++) {
 7562:                      // Calculate each polynomial's weight 
 7563:                      wm=0.d0; sum1=0.d0; 
 7564:                      wm1=0.d0; wm2=0.d0; 
 7565:                      for (int i=0; i<elem->nweno2; i++) {
 7566:                   
 7567:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7568:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7569:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7570:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7571:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7572:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7573:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7574:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7575:                      // -----------------Hu and Shu (1999)'s method----------------
 7576:                      b4=b1+b2+b3
 7577: 
 7578: //Error: add PRODUCTION CPP
 7579: #ifdef DEBUG
 7580:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7581:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7582:                     call parallel_abort(errmsg)
 7583:                   }
 7584: #endif
 7585: 
 7586:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7587:                   // !----test-------------- 
 7588:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7589:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7590:                   // !wm(i)=wm1(i)*wm2(i)
 7591:                   // !---------------------- 
 7592:                   sum1=sum1+wm(i)
 7593:                 } // end for i
 7594: 
 7595:                 wm=wm/sum1
 7596: 
 7597:                 for (int j=0; j<elem->i34; j++) {
 7598: 
 7599:                   const Side *side  = elem->sides[j];
 7600:                   const Node *node1 = side->n1;
 7601:                   const Node *node2 = side->n2;
 7602: 
 7603:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7604:                      trsd=0.d0
 7605:                      for (int kk=0; kk<nquad; kk++) {
 7606:                         for (int i=0; i<elem->nweno2; i++) {
 7607:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7608:                         } // end for i   
 7609:                      } // end for kk
 7610:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7611:                   } // outward flux
 7612:                } // end for j=1,i34(ie) ! side
 7613:             }
 7614:          }
 7615:               
 7616: 
 7617: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7618: //             //   calculate each polynomial's weight 
 7619: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7620: //                 wm=0.d0; sum1=0.d0
 7621: //                 do i=1,nweno1(ie) !for each polynomial
 7622: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7623: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7624: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7625: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7626: //                   wm(i)=b2
 7627: //                   sum1=sum1+b2
 7628: //                   !wm(i)=1.d0
 7629: //                   !sum1=sum1+1.d0
 7630: 
 7631: // // Error: PRODUCTION
 7632: // #ifdef DEBUG
 7633: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7634: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7635: //                     call parallel_abort(errmsg)
 7636: //                   endif
 7637: // #endif
 7638: 
 7639: //                 enddo !i
 7640: //                 wm=wm/sum1 !final weight
 7641: 
 7642:                 for (int j=0; j<elem->i34; j++) { // side
 7643:                   const Side *side = elem->sides[j];
 7644:                   const Node *node1 = side->n1;
 7645:                   const Node *node2 = side->n2;
 7646: 
 7647:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7648:                     trsd=0.d0
 7649:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7650:                       for (int i=0; i<elem->nweno1; i++) {
 7651:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7652:                       }
 7653:                     enddo //kk
 7654:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7655:                   } // outward flux
 7656:                 } // end for j=1,i34(ie) ! side
 7657:               } // end for k; ntr 
 7658: 
 7659:             else !simple upwind method
 7660:               do j=1,i34(ie)
 7661:                 jsj=elside(j,ie)
 7662:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7663:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7664:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7665:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7666:                   endif
 7667:                 enddo  !vertical layers
 7668:               enddo !j=1,i34(ie) ! side
 7669:             endif !order of accuracy
 7670: 
 7671:          //  enddo !ie
 7672: // !$OMP     end do
 7673: 
 7674: // !$OMP     master
 7675: //           !message passing
 7676: //           if (nproc>1) then
 7677: //             !make a copy of side concentrations
 7678: //             trsd_tmp0=trsd_tmp 
 7679: 
 7680: //             !this exchange routine swaps interface concentration between two partitions
 7681: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 7682: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 7683: 
 7684: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 7685: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 7686: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 7687: 
 7688: 
 7689: //             !This obtains final values for interface sides
 7690: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 7691: //       :    endif !nproc>1
 7692: //           !message passing end
 7693: // !$OMP     end master
 7694: // !$OMP     barrier
 7695: 
 7696: 
 7697: // !         Do advection; conc @ dry elem will not be changed
 7698: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 7699: // !$OMP     do reduction(+: h_mass_in)
 7700: //           do i=1,ne
 7701: //             if(idry_e(i)==1) cycle
