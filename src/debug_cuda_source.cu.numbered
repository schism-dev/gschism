 2737: 
 2738: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2739: 
 2740: 
 2741: __device__ void Node::updateKb(void) {
 2742: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2743: 
 2744:    if constexpr(ivcor == 1) return;
 2745: 
 2746: 
 2747:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 2748: 
 2749:    if constexpr(ivcor == 2) {  // SZ coordinates
 2750:       
 2751:       // Compute bottom level index
 2752:       if (depth <= mesh->h_s) {
 2753:          kb = izlev;   
 2754:          
 2755:       } else {
 2756:          kb = -1;
 2757:          int L = 0;
 2758:          int R = nzlev; 
 2759:          
 2760:          while (L <= R) {
 2761:             int M = (R + L) / 2;
 2762: 
 2763: 
 2764:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2765:             
 2766:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2767:                R = M;
 2768:             } else {
 2769:                L = M;
 2770:             }
 2771: 
 2772:             if (R - L == 1) {
 2773:                kb = L;
 2774:                break;
 2775:             }
 2776:          }
 2777: 
 2778:          // Checks that the binary search was successful
 2779:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 2780:        
 2781:       }
 2782:    } 
 2783: }
