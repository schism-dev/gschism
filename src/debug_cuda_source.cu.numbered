 4616:    __global__ void computeFlowBcVelocities(double time) {
 4617: 
 4618:       SIDE_BND(sideBnd);
 4619: 
 4620:       const Side *side = sideBnd->side;
 4621:  
 4622:       const bool isDry = side->isDry;
 4623:       const bool isLand = sideBnd->segment->isLand;
 4624: 
 4625:    
 4626:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4627: 
 4628:       if (isDry || isLand) return;
 4629: 
 4630:       // For wet sides in open boundaries...
 4631:       const Vector2 n = side->n;
 4632:       const BoundarySegment *segment = sideBnd->segment;
 4633: 
 4634:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4635: 
 4636:       const int ifltype = segment->ifltype;
 4637: 
 4638:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4639:       const Vector2 r_nuth0 = r_uth0*n;
 4640: 
 4641: 
 4642:       if (ifltype == 1 || ifltype == 2) {
 4643:       
 4644:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4645: 
 4646:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4647:          
 4648:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4649:          
 4650:       } else if (ifltype == -1) { // Flather 1
 4651: 
 4652:          for (int k = 0; k < nvrt; k++) {
 4653: 
 4654:             // uth is the normal vel.; no ramp up
 4655:             const double uth = sideBnd->nuth(k);
 4656:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4657: 
 4658:             sideBnd->ubc[k] += uth*n;
 4659:          }
 4660: 
 4661:       } else if (ifltype == 3 || ifltype == 5) {
 4662:          // vnth0=0 !normal vel.
 4663: 
 4664:          Vector2 r_u1_bar = {0.0, 0.0};
 4665:          // Computes the contribution to the velocity from all tide frequencies
 4666:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4667: 
 4668:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4669:             const Vector2 umo  = sideBnd->umo(jfr); 
 4670: 
 4671:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4672:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4673:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4674:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4675: 
 4676:          }
 4677: 
 4678: 
 4679:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4680: 
 4681:       } // if (ifltype = 3 || ifltype == 5
 4682: 
 4683: 
 4684: 
 4685:    }
 4686: 
 4687:    __global__ void computeElevationBoundaryConditions(double time) {
 4688:       // Compute elevation essential boundary conditions 
 4689: 
 4690:       NODE_BND(nodeBnd); // Each boundary node.
 4691: 
 4692:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4693: 
 4694:       const Node *node = nodeBnd->node;
 4695:       const BoundarySegment *segment = nodeBnd->segment;
 4696:       const int iettype = segment->iettype;
 4697:       
 4698: 
 4699:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4700:       double eic = 0.0;
 4701:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4702:       else                 eic = 0.0;
 4703: 
 4704:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4705:       const double r_eth = ramp*nodeBnd->eth;
 4706:       double r_eta1_bar = 0.0;
 4707: 
 4708: 
 4709:       // Compute tide elevation
 4710:       if (iettype == 3 || iettype == 5) {   
 4711: 
 4712:          if constexpr(iloadtide==1) { // loading tide
 4713:             assert(false && "Loading tide not implemented");
 4714:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4715:          }
 4716:          
 4717:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4718: 
 4719:             const double efa  = nodeBnd->efa[jfr]; 
 4720:             const double emo  = nodeBnd->emo[jfr]; 
 4721: 
 4722:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4723:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4724:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4725: 
 4726:          } // for jfr
 4727: 
 4728:       } // if iettype
 4729: 
 4730:       switch (iettype) {
 4731:          case 1:
 4732:          case 2:
 4733:          case 4:
 4734:             nodeBnd->elbc = r_eic + r_eth;
 4735:             break;
 4736:          case 3:
 4737:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4738:             break;
 4739:          case 5:
 4740:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4741:             break;
 4742:       } // switch
 4743: 
 4744: 
 4745:       //Add inverse barometric effects
 4746:       if (iettype != 0 && inv_atm_bnd == 1) {
 4747:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4748:       }
 4749: 
 4750:    }
 4751: 
 4752: 
 4753:    __global__ void computeHorizontalViscosity(void) { 
 4754: 
 4755:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4756: 
 4757:       SIDE(side);
 4758: 
 4759:       if (side->isDry) return;
 4760: 
 4761:       for (int k = 0; k < nvrt; k++) {
 4762:          side->nuGradU[k] = {0.0, 0.0};
 4763:       }
 4764: 
 4765:       if constexpr(ihorcon == 1) {
 4766:          for (int k = side->kb; k < nvrt - 1; k++) {
 4767:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4768:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 4769:             // By Zhang and Baptista.
 4770: 
 4771:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4772:             // This is a standard discretization of the Laplacian operator.
 4773:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4774:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4775:             // Gamma is hvis_coef0 in the code.
 4776:             // The value of gamma needs to be < 0.5.
 4777: 
 4778:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4779:             // side under consideration in each of the two possible elements that share the side.
 4780:             Vector2 sumU = {0.0, 0.0};
 4781:             for (int l = 0; l < 2; l++) {
 4782:                const Element *elem = side->elems[l];
 4783: 
 4784:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4785: 
 4786:                // Find the local index of the side in the element
 4787:                const int idxSide = elem->sideLocalIdx(side);
 4788: 
 4789:                // Find the two sides that are connected to the side under consideration
 4790:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 4791:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 4792: 
 4793:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4794: 
 4795:             }
 4796: 
 4797:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4798: 
 4799:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 4800:    
 4801:          }
 4802:       }
 4803:       else if constexpr(ihorcon == 2) {
 4804:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4805:       }
 4806: 
 4807: 
 4808:    }
 4809: 
 4810: 
 4811:    __global__ void setEssentialBC(void) {
 4812:       // Set essential boundary conditions 
 4813:       NODE(node); // Each boundary node
 4814:       NodeBoundary *nodeBnd = node->nodeBnd;
 4815:       
 4816:  
 4817:       // Check if this node has essential BC
 4818:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4819:          // Verify BC value is valid
 4820:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4821: 
 4822:        
 4823:          // Set diagonal to 1 and zero off-diagonals
 4824:          node->coeffDiag = 1.0;
 4825: 
 4826:          for (int j = 0; j < node->numNodes; j++) {
 4827:                node->coeffMatrix[j] = 0.0;
 4828:          }
 4829:          
 4830:          // Set solution and RHS to BC value
 4831:          node->mX  = nodeBnd->elbc;
 4832:          node->qel = nodeBnd->elbc;
 4833: 
 4834:       } else {
 4835:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4836: 
 4837:          for (int j = 0; j < node->numNodes; j++) {
 4838:                Node* nbNode = node->nodes[j];
 4839:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4840:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4841:                   // Verify neighbor's BC value
 4842:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4843: 
 4844:                   // Subtract contribution to RHS
 4845:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4846:                   node->coeffMatrix[j] = 0.0;  
 4847:                }
 4848:          }
 4849:       }
 4850:    }
 4851: 
 4852: 
 4853:    __global__ void updateElevation(void) {
 4854:       NODE(node);
 4855: 
 4856: 
 4857:       node->eta2 = node->mX;
 4858: 
 4859:       node->updateZCoordData();
 4860:    }
 4861: 
 4862: 
 4863:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4864: 
 4865:       SIDE(side);
 4866: 
 4867:       side->U = {0.0, 0.0}; 
 4868:          
 4869:       if(side->isDry) return;
 4870: 
 4871:       // Vertically integrated velocity U
 4872:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4873:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 4874:          side->U += side->Dz(k + 1)*uc;  
 4875:       }
 4876: 
 4877:    }
 4878: 
 4879:    __global__ void computeBottomDragVegetation(void) {
 4880:       // UNFINISHED. CHECK THIS:
 4881:       // How many kernels are needed? Why so many for loops?
 4882:       // Is the loop on sides needed?
 4883: 
 4884:       NODE(node);
 4885: 
 4886: 
 4887:       const int    kb      = node->kb;
 4888:       const double htot    = node->htot2(); 
 4889:       
 4890:       if (node->isDry) {
 4891:          // Default values for dry nodes
 4892:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4893:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4894: 
 4895:          return;
 4896:        
 4897:       }
 4898: 
 4899:       // Computes bottom drag Cd based on the selected nchi
 4900:       node->computeBottomDragCd();
 4901:       
 4902: 
 4903: 
 4904:       //   Bottom stress in m^2/s^2
 4905:       if (node->rho[kb + 1] >= -98.0)
 4906:       {
 4907:          const double mag_u = length(node->u2[kb + 1]);
 4908:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 4909: 
 4910:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4911:          // !sediment erosion: this part needs more documentation
 4912:       }
 4913:     
 4914: 
 4915: 
 4916:       // Compute vegetation parameters
 4917:       //--------------------------------
 4918: 
 4919:       // SAV constants
 4920:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4921:       constexpr double veg_cfpsi = 0.16;
 4922: 
 4923:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4924:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4925: 
 4926:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4927:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4928:          int kbin = 0; // bin index
 4929:          for (int k = kb; k < nvrt; k++) {
 4930:             // Computes node height above the bottom level
 4931:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4932:             assert(false && "Vertical variation of vegetation not implemented");
 4933: 
 4934:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4935:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4936:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4937:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4938:             // } else {
 4939:             //    // Find the bin at which the current vertical level is
 4940:             //    while (kbin<nbins_veg_vert) {
 4941:             //       const double zn = node->z[kbin];
 4942:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4943:             //          break;
 4944:             //       } // if
 4945:             //       kbin++;
 4946:             //    } // while
 4947:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4948: 
 4949:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4950:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4951:                
 4952:             //    // Linear interpolation of the vegetation parameters
 4953:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4954:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4955:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4956:             // } // if rl10
 4957: 
 4958:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4959: 
 4960:          } // for k
 4961: 
 4962: 
 4963:       } else { // Ganthy (iveg==2)
 4964:       //  Modify canopy height, diameter, and density
 4965: 
 4966:          // Make sure there is vegetation on this node
 4967:          if (node->veg_h_unbent > 0.0) {
 4968:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4969: 
 4970:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4971:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4972:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4973: 
 4974:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4975:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4976:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4977:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4978:          } // if veg_h_unbent
 4979: 
 4980:          for (int k = 0; k < nvrt; k++) {
 4981:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4982:          } // for k
 4983:       
 4984: 
 4985:       } // if iveg
 4986:      
 4987: 
 4988:       // Compute vertical mean of veg_alpha3D
 4989:       if (iveg != 0) {
 4990:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4991:          double sum1=0.0;
 4992:          double sum2=0.0;
 4993:          // Integrate over each level under the canopy...
 4994:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 4995:             const double Dz = node->Dz(k);
 4996: 
 4997:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 4998:             sum2 += Dz;
 4999: 
 5000:          } // for k
 5001:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5002:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5003: 
 5004:       } // if iveg
 5005: 
 5006:    }
 5007: 
 5008:    __global__ void computeVegetationAndDragParameters(void) {
 5009:       // Computes the vegetation and drag model parameters:
 5010:       // chi, \tilde\chi, beta, \breve{H}
 5011:       
 5012:       SIDE(side);
 5013: 
 5014:       side->hhat = 0.0;
 5015:       side->chi2 = 0.0;
 5016:       side->chi = 0.0;
 5017:       side->veg_c2 = 0.0;
 5018:       side->veg_beta = 0.0;
 5019: 
 5020:       if (side->isDry) return;
 5021: 
 5022:       const double htot = side->htot2();
 5023:       const int    kb   = side->kb;
 5024: 
 5025:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5026: 
 5027:       const double veg_h     = side->veg_h();
 5028:       const double veg_nv    = side->veg_nv();
 5029:       const double veg_c     = side->veg_c();
 5030:       const double veg_beta  = side->veg_beta;
 5031:       const double veg_alpha = side->veg_alpha_vert_mean();
 5032: 
 5033:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 5034:       // Velocity magnitude at the bottom level
 5035:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 5036:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 5037:       side->chi2 = side->Cd()*vmag1;
 5038:       side->chi  = side->chi2;
 5039:       if constexpr(iveg != 0) {
 5040:          const Node *n1 = side->n1;
 5041:          const Node *n2 = side->n2;
 5042:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5043:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5044:       }
 5045: 
 5046:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5047: 
 5048:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5049:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5050:       double magUa = 0.0;
 5051:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 5052:          // 3D wet side with veg...
 5053: 
 5054:          double magUa = 0.0;
 5055:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5056:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5057: 
 5058:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 5059:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 5060:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5061: 
 5062:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5063:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5064: 
 5065:                // Velocity magnitude at the bottom (l) of the level
 5066:                const double ul = length(side->u2[k]);
 5067: 
 5068:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5069:                magUa += Dz*0.5*(uh + ul);
 5070: 
 5071:             } // if HasVegetation
 5072:          } // for k
 5073:          const double ua = magUa/min(htot, veg_h); // Vertical average
 5074: 
 5075:          // Computes beta, used for computing the stress term at the top of the canopy.      
 5076:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 5077:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5078:             const double zCpy = side->zTopCanopy();
 5079:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5080:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5081:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5082:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5083:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5084:          } // if isSubmerged
 5085:       } // if iveg   
 5086: 
 5087:       // Computes the friction modified depth, \breve{H} in notes
 5088:       if (side->is2D()) { // 2D
 5089: 
 5090:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5091:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5092: 
 5093:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5094: 
 5095:          side->hhat = htot*htot/fricH; 
 5096: 
 5097:       } else { // 3D
 5098:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 5099: 
 5100:          if constexpr(iveg != 0) {
 5101:             
 5102:             if (side->isSubmerged()) { 
 5103:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5104:                side->hhat -= veg_c*Hhat_alpha;
 5105: 
 5106:             } else { // Emergent
 5107:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5108:             }
 5109:          } // if iveg
 5110: 
 5111:          // Enforce positivity for 3D model
 5112:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 5113:       } // if 3D
 5114: 
 5115:    }
 5116: 
 5117: 
 5118: 
 5119:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5120:    // Computes the density gradient between two elements, e1 and e2.
 5121:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5122:    // zero in the direction normal to the side. 
 5123:    // 
 5124:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5125:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 5126:    //
 5127:    // Input:
 5128:    //    e1: Element
 5129:    //    e2: Neighbor element (or nullptr if boundary)
 5130:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 5131:    //    k: Index of the half-level at which the density is interpolated
 5132:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 5133:    // 
 5134:    // Output:
 5135:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 5136:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 5137: 
 5138:       if (e2 == nullptr || e2->isDry) {
 5139:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 5140: 
 5141:          Side *side = e1->sides[j];
 5142:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 5143:                  
 5144:          if constexpr(ics == 1) {
 5145:             vec = side->n; // Normal vector to the side
 5146:          } else {
 5147:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5148:             // IMPLEMENT THIS XXXXXX
 5149:             // !replace with xel, yel?
 5150:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5151:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5152:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5153:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5154:          } //ics
 5155:                    
 5156:          diffRho = 0.0;
 5157: 
 5158:       } else { //internal and wet
 5159:          if constexpr(ics==1) {
 5160:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5161: 
 5162:             // Vector from e1 to e2
 5163:             vec = e2->center - e1->center;
 5164: 
 5165:          } else { 
 5166:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5167:             // IMPLEMENT THIS XXXXXX
 5168:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5169:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5170:             //                   alow(j)=xctr2
 5171:             //                   bdia(j)=yctr2
 5172:          } // ics
 5173: 
 5174:          diffRho = rho2 - e1->demeanedDensity(k);
 5175:       }
 5176: 
 5177:    }
 5178: 
 5179:    __global__ void computeDensityCubicSplines(void) {
 5180:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5181: 
 5182:       ELEM(elem);
 5183: 
 5184:       if (elem->isDry) return;
 5185: 
 5186:       const int kb = elem->kb;
 5187: 
 5188:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5189:       if (elem->is2D()) {
 5190:          // In the 2D case, the density is constant at the prism level. 
 5191:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5192:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5193:       } else { //3D
 5194: 
 5195:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5196:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5197:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5198:          ///// XXXX CHECK INDICES!!!!!
 5199:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5200:       } // 2D/3D
 5201: 
 5202:    }
 5203: } // extern "C"
 5204: 
 5205: 
 5206: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5207: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5208: 
 5209:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5210: 
 5211:    const int kb  = elem->kb;
 5212:    const int kb2 = elem2->kb;
 5213: 
 5214:    // z-coordinate of prism of elem
 5215:    const double zp = elem->z_prism(k);
 5216: 
 5217:    double rho = 0.0;
 5218: 
 5219:    if (elem2->is2D()) {
 5220:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5221: 
 5222:    } else {  // 3D
 5223: 
 5224:       // eta_min may be < zmax
 5225:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5226:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5227: 
 5228:       // (Extrapolate density below bottom, we will fix it later)
 5229:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5230:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5231:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5232:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5233:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5234:    } // 2D/3D
 5235:      
 5236: 
 5237:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5238:    // Now we need to fix it.
 5239:    if (elem->z[k] < elem2->z[kb2]) {
 5240:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5241: 
 5242:       // There are two methods to adjust the density at the bottom of the element.
 5243:       // iunder_deep=0: 
 5244:       const double depth1 = abs(elem->z[kb]); // larger depth
 5245: 
 5246:       if (iunder_deep==0) {
 5247: 
 5248:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5249: 
 5250:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5251: 
 5252:       } else { // iunder_deep != 0
 5253: 
 5254:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5255: 
 5256:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5257: 
 5258:          //   Demeaned density at the same z coordinate as
 5259:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5260:          }
 5261: 
 5262:       } // if iunder_deep
 5263:    } // if elem->z[kb] < elem2->z[kb]
 5264: 
 5265:    return rho;
 5266: }
 5267: 
 5268: 
 5269: extern "C" {
 5270:    __global__ void computeDensityGradient(void) {
 5271: 
 5272:       if constexpr(ibc != 0) return;
 5273: 
 5274:          // Compute the horizontal density gradient at each element.
 5275:       // It works in two steps:
 5276:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5277:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5278:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5279:       //             gradRho.r1 = rho1 - rho0
 5280:       //             gradRho.r2 = rho2 - rho0
 5281:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5282:       // 
 5283:       //  NOTE: We use de-meaned densities.
 5284: 
 5285:       ELEM(elem);
 5286: 
 5287:       if (elem->isDry) return;
 5288: 
 5289:       const int kb  = elem->kb;
 5290:       const int i34 = elem->i34;
 5291: 
 5292:       for (int k = kb + 1; k < nvrt; k++) {
 5293:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5294:          //             gradRho.r1 = rho1 - rho0
 5295:          //             gradRho.r2 = rho2 - rho0
 5296:          int icount = 0;
 5297:          double sumRx = 0.0;
 5298:          double sumRy = 0.0;
 5299:          for (int j1=0; j1<i34; j1++) { 
 5300: 
 5301:             const int j2 = elem->nxq(j1 + 1);
 5302: 
 5303:             // Pairs of consecutive neighbor elements of elem
 5304:             const Element *e1 = elem->nghbElems[j1];
 5305:             const Element *e2 = elem->nghbElems[j2];
 5306: 
 5307:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5308:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5309:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5310: 
 5311:             // Compute the density difference and the vector from elem to e1 and e2
 5312:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5313:             double diffRho1, diffRho2;
 5314:             Vector2 vec1, vec2;
 5315:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5316:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5317: 
 5318:             const double rl1 = length(vec1);
 5319:             const double rl2 = length(vec2);
 5320:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5321: 
 5322:             const double delta = cross(vec1, vec2);
 5323:             const double sintheta = abs(delta)/(rl1*rl2);
 5324: 
 5325:             // To avoid problems, avoid elements with small angle between vectors
 5326:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5327:             const bool validEq = (sintheta > sin_one_deg);
 5328: 
 5329:             if (validEq) {
 5330:                // Solve the system of equations to get the density gradient at elem
 5331:                icount++;
 5332:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5333:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5334:                sumRx += Rx;
 5335:                sumRy += Ry;
 5336:             }
 5337:          } // for j1
 5338: 
 5339:          // Compute the average density gradient at elem
 5340:          if (icount==0) {
 5341:            // Bad mesh quality; bail out with 0 b-cc
 5342:            elem->gradRho[k] = {0.0, 0.0};
 5343:          } else {
 5344:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5345:          }
 5346: 
 5347:       } // for k
 5348: 
 5349:    }
 5350: 
 5351:    __global__ void computeBaroclinicTerm(void) {
 5352:    // Computes the baroclinic term at sides (at half levels).
 5353:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5354:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5355: 
 5356:       if (ibc == 1) return;
 5357: 
 5358:       SIDE(side);
 5359: 
 5360:       if (side->isDry) return;
 5361: 
 5362:       const Element *e1 = side->elems[0];
 5363:       const Element *e2 = side->elems[1]; 
 5364:       const int kb = side->kb;
 5365:       
 5366:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5367: 
 5368:       // interpolates vertically the density gradient of the two elements at the half level/
 5369: 
 5370:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 5371:       int k2 = max(kb, nvrt / 2);
 5372: 
 5373:       // Starts the integration at the surface and goes down to the bottom
 5374:       side->bcc[nvrt-1] = {0.0, 0.0};
 5375:       for (int k = nvrt - 2; k >= kb; k--) {
 5376:       // For each prism level (from surface to bottom)...
 5377: 
 5378:          // For both elements, interpolate density gradient at the side's half level.
 5379:          // The gradient at the side is the average of the gradients at the elements.
 5380:          // w1, w2 are used to take into account boundary sides, with just one element.
 5381:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5382:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5383:          const double wsum = w1 + w2;
 5384:          w1 = w1/wsum;
 5385:          w2 = w2/wsum;
 5386:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5387: 
 5388:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5389:          Vector2 gradRho = {0.0, 0.0};
 5390:          if (e1 != nullptr && k > kb) {
 5391:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5392:             
 5393:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5394:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5395:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5396: 
 5397:             // Grad(rho) vertically interpolated at the side's half level
 5398:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 5399: 
 5400:             // Projects the element density gradient to the side frame if needed.
 5401:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 5402: 
 5403:             // Adds the contribution of the density gradient at the side's half level
 5404:             gradRho += gradRho1*w1;
 5405:          }      
 5406:          if (e2 != nullptr && k > kb) {
 5407:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5408:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5409:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5410:             
 5411:             // Grad(rho) vertically interpolated at the side's half level
 5412:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 5413: 
 5414:             // Projects the element density gradient to the side frame if needed.
 5415:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 5416: 
 5417:             // Adds the contribution of the density gradient at the side's half level
 5418:             gradRho += gradRho2*w2;
 5419:          }
 5420: 
 5421:          
 5422:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5423:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5424:          // CHECK INDICES!!! XXX
 5425:          const double grav3 = side->grav3();
 5426:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5427: 
 5428:       } // for
 5429: 
 5430:    }
 5431: 
 5432: 
 5433: 
 5434:    __global__ void computeHorGradientAtSide(void) {
 5435: 
 5436:       // Compute the horizontal density gradient at each element.
 5437:       // It works in two steps:
 5438:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5439:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5440:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5441:       //             gradRho.r1 = rho1 - rho0
 5442:       //             gradRho.r2 = rho2 - rho0
 5443:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5444:       // 
 5445:       //  NOTE: We use de-meaned densities.
 5446: 
 5447:       SIDE(side);
 5448: 
 5449: 
 5450:       if (side->isDry) return;
 5451: 
 5452:       // Computes the gradient of the variables at the side center.
 5453:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5454:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5455:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 5456: 
 5457:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5458:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5459:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5460:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5461: 
 5462:    }
 5463: 
 5464: 
 5465:    __global__ void solveMomentumEquations(double time) {
 5466: 
 5467:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5468:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5469: 
 5470:       SIDE(side);
 5471: 
 5472:       if (side->isDry) 
 5473:       {
 5474:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 5475: 
 5476:          return;
 5477:       }
 5478: 
 5479:       const Node *n1 = side->n1;
 5480:       const Node *n2 = side->n2;
 5481: 
 5482:       const int kb = side->kb;
 5483: 
 5484:       const double veg_h = side->veg_h();
 5485:       const double grav3 = side->grav3();
 5486: 
 5487:       if (side->is2D()) {
 5488:          // Remember: Do not use htot2, which is updated.
 5489:          const double htot = side->htot1();
 5490:          const double hhat = side->hhat;
 5491: 
 5492:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5493: 
 5494:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 5495:          const Vector2 tau2 = side->tau();
 5496: 
 5497:          // hat_gam has units of m/s
 5498: 
 5499:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5500:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5501:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5502: 
 5503:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5504: 
 5505: 
 5506:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 5507: 
 5508:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 5509: 
 5510:       }
 5511:       else { // 3D
 5512: 
 5513:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5514:          // 
 5515:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5516:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5517:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5518:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5519:          // k+1 and k.
 5520: 
 5521: 
 5522:          const int ndim = nvrt - kb;
 5523:          const double zTopCanopy = side->zTopCanopy();
 5524: 
 5525:          // Initialize the tridiagonal system
 5526:          for (int k = kb + 1; k < nvrt; k++) {
 5527:             
 5528:             const int kin = k - (kb + 1);
 5529: 
 5530:             // Vertical viscosity at the face center
 5531:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 5532: 
 5533:  
 5534:             alow[kin] = 0.0;
 5535:             cupp[kin] = 0.0;
 5536:             bdia[kin] = 0.0;
 5537: 
 5538:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5539:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5540: 
 5541:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5542:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5543:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5544: 
 5545:             // First part: layers k, k+1
 5546:             if (k < nvrt - 1) {
 5547:                              
 5548:                if constexpr(iveg != 0) {
 5549: 
 5550:                   // If there is vegetation at this level...
 5551:                   if (zTopCanopy > side->zc[k]) {
 5552:                      // If the canopy is above the k layer...
 5553:                      
 5554:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5555:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5556:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5557:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5558: 
 5559:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5560:                      const double vmag2 = length(ut2);
 5561:                      const double vmag1 = length(side->u2[k]);
 5562:                      const double vmag = 0.5*(vmag1 + vmag2);
 5563:                      
 5564:                      // Computes the vegetation alpha at the face center
 5565:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5566: 
 5567:                      cff1 += veg_alpha_sd*dt*vmag;
 5568: 
 5569:                   } // if (zTopCanopy
 5570:                } // if iveg
 5571: 
 5572:                const double dzz = side->Dz(k + 1);
 5573:                const double tmp = dt*dfz/dzz;
 5574:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5575: 
 5576:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5577:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5578:             }
 5579: 
 5580: 
 5581:             // Second part: layers k-1, k
 5582:             if (k > kb + 1) {
 5583: 
 5584:                double cff1 = 1.0; //init \bar{c^k}
 5585: 
 5586:                if constexpr(iveg != 0) {
 5587:                   // If there is vegetation at this level...
 5588:                   if (zTopCanopy > side->zc[k-1]) {
 5589:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5590:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5591: 
 5592:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5593: 
 5594:                      const double vmag2 = length(ut2);
 5595:                      const double vmag1 = length(side->u2[k-1]);
 5596:                      const double vmag = 0.5*(vmag1 + vmag2);
 5597: 
 5598:                      // Computes the vegetation alpha at the face center
 5599:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5600:                      cff1 += veg_alpha_sd*dt*vmag;
 5601:                   } // if zTopCanopy
 5602: 
 5603:                } // if iveg
 5604: 
 5605:                const double dzz = side->Dz(k);
 5606:                const double tmp = dt*dfz/dzz;
 5607:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5608: 
 5609:                alow[kin] += cff1*dzz/6.0 - tmp;
 5610:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5611: 
 5612:             } else { // Bottom boundary
 5613:                // This occurs at the bottom, where the bottom drag is applied.
 5614: 
 5615:                bdia[kin] += dt*side->chi2; // XXXX
 5616: 
 5617:             } // if (k > kb + 1)
 5618: 
 5619: 
 5620:          } // for (int k
 5621: 
 5622: 
 5623: 
 5624:          // Computes the RHS.
 5625:          // -----------------
 5626: 
 5627:          //	BC to be imposed at the end.
 5628: 
 5629:          const Vector2 gradETP  = side->gradETP;
 5630:          const Vector2 gradPr   = side->gradPr;
 5631:          const Vector2 gradEta1 = side->gradEta1;
 5632:          const Vector2 gradEta2 = side->gradEta2;
 5633: 
 5634:          const Vector2 *btu = side->btu;
 5635:          const Vector2 *u2  = side->u2;
 5636:          const double coriolis = side->coriolis;
 5637:          const Vector2 *nuGradU = side->nuGradU;
 5638: 
 5639: 
 5640:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5641:          for (int k = kb + 1; k < nvrt; k++) {
 5642:             const int kin = k - kb - 1;
 5643: 
 5644:             const double dz_0 = side->Dz(k);
 5645:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5646: 
 5647:             rrhs[kin] = {0.0, 0.0};
 5648:             double dz = 0.0;
 5649: 
 5650:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5651:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5652:             if (k < nvrt  ) dz += dz_1;
 5653:             if (k > kb + 1) dz += dz_0;
 5654: 
 5655:             // Elevation gradient, atmospheric pressure and tidal potential
 5656:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5657: 
 5658:             // Coriolis, advection, wind stress, and horizontal viscosity
 5659:             if (k < nvrt - 1) {
 5660: 
 5661: 
 5662:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5663:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5664:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5665:                                                 
 5666: 
 5667:                //diff stress tensors 1006
 5668:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5669:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5670:                   assert(false && "Not implemented: itur == 5");
 5671:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5672:                }
 5673:                // else assert(false && "itur # Not implemented");
 5674: 
 5675:             } else { // k == nvrt - 1 SURFACE
 5676:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 5677:                const Vector2 tau2 = side->tau();
 5678: 
 5679:                rrhs[kin] += dt*tau2;          
 5680: 
 5681:             } // if k<nvrt
 5682: 
 5683: 
 5684:             if (k > kb + 1) {
 5685:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5686:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5687:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5688: 
 5689:                // diff stress tensors 1006
 5690:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5691:                   assert(false && "Not implemented: itur == 5");
 5692:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5693:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5694:                }
 5695:                // else assert(false && "itur # Not implemented");
 5696: 
 5697: 
 5698:             } // if k>kbs + 1
 5699: 
 5700:             // Baroclinic
 5701:             Vector2 *bcc = side->bcc;
 5702:             if constexpr(ibc == 0) {
 5703:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5704:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5705: 
 5706:             } // if ibc==0
 5707: 
 5708:          } // k=kb + 1,nvrt
 5709: 
 5710: 
 5711:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5712: 
 5713:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 5714:             const int kin = k - kb - 1;
 5715:    
 5716:             // Velocity is always clamped to maximum values
 5717:             side->u2[k] = clampVelocity(soln[kin]);
 5718:          } // k
 5719: 
 5720:       } // if side->is2D()
 5721:       
 5722: 
 5723:       // Impose velocity boundary condition at the bottom
 5724:       if constexpr(imm == 2) { // 3D bed deformation model
 5725:          double dep;
 5726:          Vector2 vel;
 5727: 
 5728:          assert(false && "Not implemented: imm == 2");
 5729:          //update_bdef(time, x0, y0, dep, vel);
 5730:          // side->u2[kb] = vel;
 5731: 
 5732:       } else { // imm = 0 or 1
 5733:          if (side->Cd() == 0.0) {
 5734:             side->u2[kb] = side->u2[kb + 1];
 5735: 
 5736:          } else if (side->is3D()) { // 3D no slip bottom   
 5737:             side->u2[kb] = {0.0, 0.0};
 5738: 
 5739:          }
 5740:           
 5741:       } // if imm
 5742: 
 5743:       // The velocities below the bottom level are set to zero
 5744:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 5745: 
 5746: 
 5747:    }
 5748: 
 5749: 
 5750:    __global__ void applyMomentumBC(void) {
 5751: 
 5752:       SIDE_BND(sideBnd);
 5753: 
 5754:       Side *side = sideBnd->side;
 5755:       const BoundarySegment *segment = sideBnd->segment;
 5756:       const Node *n1 = side->n1;
 5757:       const Node *n2 = side->n2;
 5758: 
 5759:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5760: 
 5761:       const bool isLand = segment->isLand;
 5762:       const int ifltype = segment->ifltype;
 5763: 
 5764:       const int kb = side->kb;
 5765: 
 5766: 
 5767:       if (!isLand && ifltype != 0) {
 5768:          const Vector2 *ubc = sideBnd->ubc;
 5769:   
 5770:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5771:             
 5772:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5773:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5774: 
 5775:             if (ifltype == -1) {
 5776:                // Flather 1
 5777: 
 5778:                const double depth = side->depth();
 5779: 
 5780:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5781: 
 5782:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5783: 
 5784:                side->u2[k] = vnorm*side->n;
 5785: 
 5786:             } else if (ifltype == -2) { // Discharge
 5787: 
 5788:                const double eta1 = side->eta1();
 5789:                const double eta2 = side->eta2();
 5790:                const double htot = side->htot2();
 5791: 
 5792:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5793:                assert(false && "Not implemented: Discharge bc");
 5794:                // const double dischrg = discharge(eta1);
 5795:                const double dischrg = 0.0; // XXX REMOVE
 5796:                
 5797: 
 5798:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5799: 
 5800:                const double vnorm = dischrg*eta2/htot;
 5801: 
 5802:                side->u2[k] = vnorm*side->n;
 5803: 
 5804:             }
 5805:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5806:                const double vnorm = dot(side->u2[k], side->n);
 5807: 
 5808:                double rat;
 5809:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5810:                else              rat = segment->vobc2; // outgoing
 5811: 
 5812:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5813: 
 5814:             }
 5815:             else { // not Flather or 3D radiation
 5816:                side->u2[k] = ubc[k];
 5817: 
 5818:             } // if (segment->ifltype...
 5819: 
 5820:          }
 5821: 
 5822:       }
 5823:       else if (isLand) { // if it is land boundary side
 5824: 
 5825:          if constexpr(islip == 0) { // free slip
 5826: 
 5827:             for (int k = kb; k < nvrt; k++) {
 5828: 
 5829:                const Vector2 t = side->t();
 5830:                const Vector2 n = side->n;
 5831: 
 5832:                double vnorm = 0.0; // for most cases
 5833:                const double vtan = dot(side->u2[k], t);
 5834:                
 5835:                side->u2[k] = vtan*t - vnorm*n;
 5836: 
 5837:             }
 5838: 
 5839:          } else { // no slip
 5840:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5841: 
 5842:          }
 5843:       } // if (side segment type...
 5844: 
 5845:    
 5846: 
 5847:    }
 5848: 
 5849: 
 5850:    __global__ void shapiroFilter1(void) {
 5851:       // First step of the Shapiro filter (normally used if indvel<=0)
 5852:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5853: 
 5854:       SIDE(side);
 5855: 
 5856:       // Only internal wet sides are processed
 5857:       if (side->isDry || !(side->isInternal())) return;
 5858: 
 5859:       const int kb = side->kb;
 5860: 
 5861:       for (int mm = 0; mm < niter_shap; mm++) {
 5862: 
 5863:          for (int k = kb + 1; k < nvrt; k++) {
 5864:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5865:             Vector2 suru = {0.0, 0.0};
 5866: 
 5867:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5868: 
 5869:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 5870: 
 5871:                int kin = k;
 5872:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5873:                
 5874:                // Get the velocity at the neighbor's side.
 5875:                Vector2 nSideU2 = nSide->u2[kin];
 5876: 
 5877:                // Projects the velocity to the current side frame if needed.
 5878:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 5879: 
 5880:                suru += nSideU2;
 5881:             }
 5882: 
 5883:             // Reusing bcc as a temporary array to store the suru values.
 5884:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5885: 
 5886:          }
 5887:       }
 5888:    }
 5889: 
 5890:    __global__ void shapiroFilter2(void) {
 5891:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5892: 
 5893:       SIDE(side);
 5894: 
 5895: 
 5896:       if (side->isDry || !(side->isInternal())) return;
 5897: 
 5898:       const int kb = side->kb;
 5899: 
 5900:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5901: 
 5902:       if (side->is2D()) {
 5903:          side->u2[kb + 1] = side->bcc[kb + 1];
 5904:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 5905: 
 5906:       } else {
 5907:          // 3D
 5908:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5909:          
 5910:       }
 5911: 
 5912:    }
 5913: 
 5914: 
 5915:    __global__ void ul0UpdateZCoords(void) {
 5916:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5917:       
 5918:       NODE(node);      
 5919: 
 5920: 
 5921:       if (false) { //node->isDry) { XXXXXXX
 5922: 
 5923:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 5924: 
 5925:          if constexpr(ivcor != 1) node->kb = 0;
 5926: 
 5927:       } else {
 5928: 
 5929:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 5930:          node->updateKb();
 5931: 
 5932:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5933: 
 5934:       }
 5935: 
 5936:       // We use the temp.b field to store the previous state of isDry.
 5937:       node->tmp.b = node->isDry;
 5938: 
 5939:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5940:       node->isDry = true;
 5941: 
 5942:    }
 5943: 
 5944:    __global__ void ul0ComputeDryElements(void)
 5945:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 5946:    {
 5947:       ELEM(elem);
 5948: 
 5949:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 5950: 
 5951:       elem->kb = 0;
 5952: 
 5953:       if (elem->isDry) return;
 5954: 
 5955: 
 5956:    //    if(elem->isDry2()) { // XXXX
 5957:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5958:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5959:    //        call parallel_abort(errmsg)
 5960:    //    }
 5961: 
 5962:       const Node *n1 = elem->nodes[0];
 5963:       const Node *n2 = elem->nodes[1];
 5964:       const Node *n3 = elem->nodes[2];  
 5965:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 5966: 
 5967:       // Computes element's kb as the minimum of the nodes' kb.
 5968:       const int kb1 = n1->kb;
 5969:       const int kb2 = n2->kb;
 5970:       const int kb3 = n3->kb;
 5971:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 5972: 
 5973: 
 5974:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5975: 
 5976: 
 5977:       // Computes the element z as the mean of the nodes z.
 5978:       for (int k = elem->kb; k < nvrt; k++) {
 5979: 
 5980:          // Compute the element z as the mean of the nodes z.
 5981:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 5982:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5983:          elem->z[k] /= elem->i34;
 5984: 
 5985: if (k>elem->kb && elem->z[k] <= elem->z[k-1]) printf("EEEE elem->isDry = %d, idx1 = %d, idx2 = %d, idx3 = %d, z1[k] = %f, z2[k] = %f, z3[k] = %f, z1[k-1] = %f, z2[k-1] = %f, z3[k-1] = %f, k = %d, kb = %d, kb1 = %d, kb2 = %d, kb3 = %d, kb4 = %d, z[k] = %f, z[k-1] = %f\n", elem->isDry, n1->idx, n2->idx, n3->idx, n1->z[max(k, kb1)], n2->z[max(k, kb2)], n3->z[max(k, kb3)], n1->z[max(k-1, kb1)], n2->z[max(k-1, kb2)], n3->z[max(k-1, kb3)],  k, elem->kb, kb1, kb2, kb3, kb4, elem->z[k], elem->z[k-1]);
 5986:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 5987:       }
 5988:                   
 5989:    }
 5990: 
 5991:    __global__ void ul0ComputeDryNodes(void)
 5992:    // Updates node's isDry based on the elements' isDry. 
 5993:    {
 5994:       NODE(node);
 5995: 
 5996:       node->isDry = true;
 5997: 
 5998:       // A node is wet if at least one of the elements sharing it is wet.
 5999:       for (int j = 0; j < node->numElements; j++) {
 6000:          const Element *elem = node->elements[j];
 6001:          if (!elem->isDry) {
 6002:             node->isDry = false;
 6003:             break;
 6004:          }
 6005:       }
 6006: 
 6007:        
 6008:    }
 6009: 
 6010: 
 6011:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6012:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6013:    // node->tmp.b is true if the node was previously dry.
 6014:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6015:    {
 6016:       NODE(node);
 6017:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6018: 
 6019:       // Avoid this the first time step.
 6020:       if (it == iths) return;  
 6021: 
 6022:       const bool wasDry = node->tmp.b;
 6023: 
 6024: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6025: 
 6026:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 6027: 
 6028:          for (int k=0; k < nvrt; k++) {
 6029: 
 6030:             Vector3 utmp={0.0, 0.0, 0.0};
 6031: 
 6032:             double ttmp=0.0;
 6033:             double stmp=0.0;
 6034:             int icount=0;
 6035:             for (int j = 0; j < node->numNodes; j++) {
 6036: 
 6037:                const Node *nbrNode = node->nodes[j];
 6038:                
 6039:                const bool wasNbrDry = nbrNode->tmp.b;
 6040: 
 6041:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 6042:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 6043: 
 6044:                   icount++;
 6045: 
 6046:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6047:                   utmp += nbrNode->uvw2(k);
 6048:                   
 6049:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 6050:                   stmp += nbrNode->tracers[k].tracer[1]; 
 6051:                }
 6052:             }
 6053: 
 6054:             if (icount > 0) {
 6055:                const double inv_icount = 1.0/icount;
 6056:                utmp = inv_icount*utmp;
 6057:                node->u2[k]     = toVector2(utmp);
 6058:                node->w2[k]     = utmp.z;
 6059:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6060:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6061:             } else {
 6062:                node->u2[k] = {0.0, 0.0};
 6063:                node->w2[k] = 0.0;
 6064:                // Initialize tracers to 0.0??? XXXXX
 6065:             }
 6066:          }
 6067:       }
 6068:    }
 6069: 
 6070:   
 6071:    
 6072: 
 6073: 
 6074:    __global__ void ul0UpdateSides(int it, int iths) {
 6075:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 6076:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 6077:    // The dryness of the sides is updated in ul0UpdateSides2.
 6078: 
 6079:       SIDE(side);
 6080: 
 6081:       // A side is wet if and only if at least one of its elements is wet.
 6082:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6083:  
 6084:       const Node *n1 = side->n1;
 6085:       const Node *n2 = side->n2;
 6086:      
 6087:       const int kb1 = n1->kb;
 6088:       const int kb2 = n2->kb;
 6089: 
 6090:       side->kb = 0; // default when dry
 6091: 
 6092:       if (isWet) {
 6093: 
 6094:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6095: 
 6096:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6097: 
 6098:          side->kb = min(kb1, kb2);
 6099: 
 6100:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6101: 
 6102:          for (int k = side->kb; k < nvrt; k++) {
 6103:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6104: 
 6105:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 6106: 
 6107:             // Compute velocity for re-wetted sides 
 6108:             if ((it != iths) && (side->isDry && isWet)) {
 6109: 
 6110:                Vector2 utmp={0.0, 0.0};
 6111: 
 6112:                int icount=0;
 6113: 
 6114:                // For all the sides on the two elements that share this side
 6115:                for (int j = 0; j < 2; j++) {
 6116:                   const Element *elem = side->elems[j];
 6117:                   if (elem == nullptr) continue;
 6118: 
 6119:                   for (int jj=0; jj < elem->i34; jj++) {
 6120:                      const Side *nSide = elem->sides[jj];
 6121:                      if (nSide->isDry) continue;
 6122: 
 6123:                      icount++;
 6124:                      utmp += nSide->u2[k];  
 6125:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 6126:                   }
 6127:                }
 6128:                   
 6129:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 6130:                if (icount > 0)  side->u2[k] = utmp/icount;
 6131:                else             side->u2[k] = {0.0, 0.0};
 6132:                   
 6133:             } // if ((it != iths) && (side->isDry && isWet))
 6134: 
 6135:          } // for k
 6136: 
 6137:       } // if isWet 
 6138:       
 6139: 
 6140: 
 6141:    }
 6142: 
 6143:    __global__ void ul0UpdateSides2(void) {
 6144:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 6145:    
 6146:          SIDE(side);
 6147:    
 6148:          const Element *e1 = side->elems[0];
 6149:          const Element *e2 = side->elems[1];
 6150: 
 6151:          // A side is wet if and only if at least one of its elements is wet.
 6152:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 6153: 
 6154:          // Update the side's dryness
 6155:          side->isDry = !isWet;
 6156: 
 6157:    }
