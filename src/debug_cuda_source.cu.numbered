 3824: extern "C" {
 3825:    __global__ void rollUpElevation(void) {
 3826: 
 3827:       NODE(node);
 3828: 
 3829:       node->eta1 = node->eta2;
 3830: 
 3831:    }
 3832: 
 3833: 
 3834:    __global__ void backtrackAllNodes(void) {
 3835: 
 3836:       // max/min # of sub-divisions
 3837:       const int ndelt_max = max(1.0, dt/dtb_min);
 3838:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3839: 
 3840:       // Removed all references to swild98 XXX
 3841:       // swild98=0.d0 !init
 3842: 
 3843: 
 3844:       SIDE(side);
 3845: 
 3846:       const int kb = side->kb;
 3847: 
 3848: 
 3849:       // Initialize btrack velocities to the actual velocities at the side 
 3850:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3851: 
 3852:       if (side->isDry) return;
 3853: 
 3854: 
 3855:       // Checks that at least one element is not dry
 3856:       const Element *elem1 = side->elems[0];
 3857:       const Element *elem2 = side->elems[1];
 3858: 
 3859: 
 3860:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3861:       
 3862:       // XXXXXX
 3863:       // !swild_tmp to store global coord. of the starting side
 3864:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3865:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3866:       // !Use sframe2 
 3867:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3868: 
 3869: 
 3870:       for (int k = kb; k < nvrt; k++) {
 3871:       //  Initialize (xt,yt,zt), nnel and vel.
 3872:       //  For ics=2, the coordinates are in local frames
 3873:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3874: 
 3875: 
 3876:          const int iadvf = side->iadv();  // Advection flag
 3877: 
 3878:          Point3 xt;
 3879:          if constexpr(ics==1) {
 3880:             xt = side->center3D(k); 
 3881:          }
 3882:          else // lat/lon; in side lat/lon frame
 3883:          {
 3884:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3885:          // XXX IMPLEMENT THIS
 3886:       //          xt=0.d0
 3887:       //          yt=0.d0
 3888:       //          !centroid coord. for nudging
 3889:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3890:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3891:          }  // ics
 3892: 
 3893: 
 3894: 
 3895:          // If on land or open boundary...
 3896:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3897:          
 3898:          const double vmag = length(side->u2[k]);
 3899: 
 3900:          if (vmag <= velmin_btrack) {
 3901:             // No activity 
 3902: 
 3903:             side->btu[k] = side->u2[k];
 3904:             
 3905:          } else {  // do btrack
 3906: 
 3907:             // Compute number of sub-divisions based on local gradients 
 3908:             // XXX IS THIS NECESSARY?
 3909:             double suma = 0.0;
 3910:             int icount = 0;
 3911:             for (int ii=0; ii<2; ii++) {
 3912: 
 3913:                const Element *elem = side->elems[ii];
 3914:                  
 3915:                if (elem == nullptr) continue;
 3916: 
 3917:                icount++;
 3918: 
 3919:                // Not strictly along z; in ll frame for ics=2
 3920: 
 3921:                double utmp[4];
 3922:                double vtmp[4];
 3923:                for (int jj = 0; jj < elem->i34; jj++) {
 3924: 
 3925:                   const Node *node = elem->nodes[jj];
 3926: 
 3927:                   if constexpr(ics==1) {
 3928:                      utmp[jj] = node->u2[k].x;
 3929:                      vtmp[jj] = node->u2[k].y;  
 3930:                   } else {
 3931:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3932:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3933:                   }
 3934:                } // for jj
 3935: 
 3936:                const Vector2 grad_u = elem->grad2(utmp); 
 3937:                const Vector2 grad_v = elem->grad2(vtmp);
 3938: 
 3939:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3940:             } // for ii
 3941: 
 3942:             assert(icount > 0 && "Impossible 77");
 3943: 
 3944:             // '4' is somewhat arbitrary
 3945:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3946: 
 3947:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3948:          
 3949: 
 3950:             Vector3 u_int = {0.0, 0.0, 0.0};
 3951: 
 3952:             side->btrack(k, dt, dtbk, u_int);
 3953:             side->btu[k] = toVector2(u_int);
 3954:                
 3955:          } // if vmag (do backtrack)
 3956: 
 3957:       } // for k=kb,nvrt-1
 3958: 
 3959:    }
 3960: 
 3961: } // extern "C"
 3962: 
 3963: template<int nc>
 3964: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3965: 
 3966: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3967: //
 3968: // a,b,c,rhs: input vectors and are not modified by this program.
 3969: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3970: // rhs is the r.h.s.
 3971: // n: actual rank of the system.
 3972: // rows in u() and rhs();
 3973: // u: output with nc columns (transposed to rows)
 3974: // gam: a working array.
 3975: //
 3976: // NOTES:
 3977: // This is a template function that allows for different numbers of columns in the rhs vector.
 3978: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3979: 
 3980:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3981:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3982: 
 3983:    double bet = b[0];
 3984:    if constexpr (nc == 1) {
 3985:       u[0] = rhs[0]/bet;
 3986:    } else {
 3987:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 3988:    }
 3989: 
 3990:    for (int j = 1; j < n; j++) {
 3991:       gam[j] = c[j - 1]/bet;
 3992:       bet = b[j] - a[j]*gam[j];
 3993: 
 3994:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3995: 
 3996:       if constexpr (nc == 1) {
 3997:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3998:       } else {
 3999:          for (int l = 0; l < nc; l++) {
 4000:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4001:          }
 4002:       }
 4003:    }
 4004: 
 4005:    // Back-substitution
 4006:    for (int j = n - 2; j >= 0; j--) {
 4007:       if constexpr (nc == 1) {
 4008:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4009:       } else {
 4010:          for (int l = 0; l < nc; l++) {
 4011:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4012:          }
 4013:       }
 4014:    }
 4015: }
 4016: 
 4017: 
 4018: 
 4019: // Helper function that contains the core algorithm
 4020: template<typename XAccessor, typename YAccessor>
 4021: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4022:                                     double  yp_top, double  yp_bot, 
 4023:                                     CubicSpline &spline) {
 4024:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4025:    // 
 4026:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4027:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4028:    //
 4029:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4030:    // 
 4031:    // Inputs: 
 4032:    //            n: dimension for x etc; # of data pts (>=2);
 4033:    //            getX, getY: functions to access x,y coordinates
 4034:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4035:    //     Output: 
 4036:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4037: 
 4038:    const int n = k2 - k1 + 1;
 4039:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4040: 
 4041:    // Allocate memory for the splines
 4042:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4043:    spline.x   = new double[n];
 4044:    spline.y   = new double[n];
 4045:    spline.yp  = new double[n];
 4046:    spline.ypp = new double[n];
 4047: 
 4048:    for (int k=k1; k<=k2; k++) {
 4049:       spline.x[k] = getX(k);
 4050:       spline.y[k] = getY(k);
 4051:    }
 4052: 
 4053:    // This is to simplify expressions later
 4054:    double *x = spline.x;
 4055:    double *y = spline.y;
 4056: 
 4057:    double *a = nullptr;
 4058:    double *b = nullptr;
 4059:    double *c = nullptr;
 4060:    double *gam = nullptr;
 4061:    double *rhs = nullptr;
 4062:    
 4063: 
 4064:       a = new double[n];   // Lower diagonal
 4065:       b = new double[n];   // Diagonal
 4066:       c = new double[n];   // Upper diagonal
 4067:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4068:       rhs = new double[n]; // Right-hand side
 4069: 
 4070:    for (int k=k1; k<=k2; k++) {
 4071:       if (k == k1) {
 4072:          // Bottom level
 4073:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4074:          b[k] = (x[k+1] - x[k])/3.0;
 4075:          c[k] = b[k]/2.0;
 4076:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4077:       } else if (k == n - 1) {
 4078:          // Top level (surface)
 4079:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4080:          b[k] = (x[k] - x[k-1])/3.0;
 4081:          a[k] = b[k]/2.0;
 4082:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4083:       } else {
 4084:          // Intermediate levels
 4085:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4086:          b[k] = (x[k+1] - x[k-1])/3.0;
 4087:          a[k] = (x[k  ] - x[k-1])/6.0;
 4088:          c[k] = (x[k+1] - x[k  ])/6.0;
 4089:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4090:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4091:       }
 4092:    }
 4093: 
 4094:    // Solve the tridiagonal system
 4095:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4096:    
 4097:    spline.yp[k1] = yp_bot;
 4098:    spline.yp[k2] = yp_top;
 4099: 
 4100:    // Compute rest of 1st derivatives using the splines
 4101:    for (int k=k1+1; k<k2; k++) {
 4102:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4103:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4104:    }
 4105:    
 4106:    delete[] a;
 4107:    delete[] b;
 4108:    delete[] c;
 4109:    delete[] gam;
 4110:    delete[] rhs;
 4111: 
 4112: }
 4113: 
 4114: // Array version
 4115: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4116:                                 double y_top, double y_bot, 
 4117:                                 CubicSpline &spline) {
 4118:    auto getX = [x] (int k) { return x[k]; };
 4119:    auto getY = [y] (int k) { return y[k]; };
 4120:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4121: }
 4122: 
 4123: // Lambda version - allows custom access patterns
 4124: template<typename XFunc, typename YFunc>
 4125: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4126:                                 double y_top, double y_bot,
 4127:                                 CubicSpline &spline) {
 4128:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4129: }
 4130: 
 4131: 
 4132: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 4133: {
 4134:    assert("Not implemented");
 4135: 
 4136:    return 0.0;
 4137: }
