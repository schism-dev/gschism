 8104: __global__ void getStructSizes(int* sizes)  {
 8105:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 8106:       sizes[0] = (int)sizeof(Node);
 8107:       sizes[1] = (int)sizeof(Element);
 8108:       sizes[2] = (int)sizeof(Side);
 8109:       sizes[3] = (int)sizeof(NodeBoundary);
 8110:       sizes[4] = (int)sizeof(SideBoundary);
 8111:       sizes[5] = (int)sizeof(BoundarySegment);
 8112: }
