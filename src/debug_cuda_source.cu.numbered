 1420: struct Mesh {
 1421:    public:  
 1422: 
 1423:    int partNum; // Partition number for this mesh.
 1424: 
 1425:    // Pointers to each GPU's local memory (size is the number of partitions).
 1426:    Node**    nodes;  
 1427:    Element** elems;  
 1428:    Side**    sides;  
 1429:    
 1430:    // Local memory
 1431:    Node*    localNodeData; 
 1432:    Element* localElemData;
 1433:    Side*    localSideData; 
 1434: 
 1435:    NodeBoundary *localNodeBoundaryMem; // Array of objects with the boundary information of each node
 1436:    SideBoundary *localSideBoundaryMem; // Array of objects with the boundary information of each side
 1437:    double       *coeffMatrixMem;       // Matrix coefficients for neighbors. [0..numNodes-1], doesn't include the diagonal
 1438:    BoundarySegment *localSegmentMem;   // Array of objects with the boundary segments
 1439:    
 1440:    const int npgb;  // Global number of horizontal nodes
 1441:    const int negb;  // Global number of elements
 1442:    const int nsgb;  // Global number of sides
 1443: 
 1444:    const int np;   // Local number of horizontal nodes 
 1445:    const int ne;   // Local number of elements
 1446:    const int ns;   // Local number of sides
 1447: 
 1448:    int nbp;  // Local number of boundary nodes
 1449:    int nbs;  // Local number of boundary sides
 1450: 
 1451:    int nEntries;  // Total number of matrix elements
 1452: 
 1453:    const int max_np; // Maximum number of horizontal nodes per partition (shared by all partitions)
 1454:    const int max_ne; // Maximum number of elements per partition (shared by all partitions)
 1455:    const int max_ns; // Maximum number of sides per partition (shared by all partitions)
 1456: 
 1457:   
 1458:    // Additional topology information
 1459:    Node    **nodeNeighNodes; // Array of pointers to the nodes neighbors of each node
 1460:    Element **nodeNeighElems; // Array of pointers to the elements neighbors of each node
 1461: 
 1462:    BoundarySegment landBoundarySegment;
 1463:    NodeBoundary landBoundaryNode;
 1464: 
 1465:    // Vertical coordinate system
 1466:    // Sigma levels
 1467:    double h_s; 
 1468:    double h_c; 
 1469: 
 1470:    double theta_b;
 1471:    double theta_f, sinh_theta_f;
 1472:    double *sigma;  // There is a sigma_local on each node for the case ivcor=1
 1473:    double *ztot;
 1474:    double *cs;
 1475:    double *dcs;
 1476: 
 1477:    // // Get's the pointer to the node using the array of global pointers to nodes
 1478:    // __device__ const Node *getGlobalNode(int jn) {
 1479:    //    const int idx = jn / max_np; // Get the index of the partition that contains the node
 1480:    //    return nodes[idx] + idx;
 1481:    // }
 1482: 
 1483:    // // Get's the pointer to the element using the array of global pointers to elements
 1484:    // __device__ const Element *getGlobalElem(int je) {
 1485:    //    const int idx = je / max_ne; // Get the index of the partition that contains the element
 1486:    //    return elems[idx] + idx;
 1487:    // }
 1488: 
 1489:    // // Get's the pointer to the side using the array of global pointers to sides
 1490:    // __device__ const Side *getGlobalSide(int js) {
 1491:    //    const int idx = js / max_ns; // Get the index of the partition that contains the side
 1492:    //    return sides[idx] + idx;
 1493:    // }
 1494: 
 1495:    // // Get's the global index of local node idx
 1496:    // __device__ int getGlobalNodeIndex(int idx) {
 1497:    //    return idx + partNum * max_np;
 1498:    // }
 1499: 
 1500:    // // Get's the global index of local element idx
 1501:    // __device__ int getGlobalElemIndex(int idx) {
 1502:    //    return idx + partNum * max_ne;
 1503:    // }
 1504: 
 1505:    // // Get's the global index of local side idx
 1506:    // __device__ int getGlobalSideIndex(int idx) {
 1507:    //    return idx + partNum * max_ns;
 1508:    // }  
 1509: 
 1510:    __device__ Mesh(int partNum,
 1511:                    int npgb, int negb, int nsgb, 
 1512:                    int np, int ne, int ns,
 1513:                    int max_np, int max_ne, int max_ns, int nseg,
 1514:                    Node **nodesPtr, Element **elemsPtr, Side **sidesPtr,
 1515:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 1516:                    Node    **localNodeNeighNodesMem,
 1517:                    Element **localNodeNeighElemsMem,
 1518:                    double *partCoeffMatrixMem,
 1519:                    NodeBoundary *localNodeBoundaryMem,
 1520:                    SideBoundary *localSideBoundaryMem,
 1521:                    BoundarySegment *localSegmentMem,
 1522:                    int *kb, double h_c, double h_s, double theta_b, double theta_f, double *sigma, double *ztot,
 1523:                    double *cs, double *dcs
 1524:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 1525:                        np(np), ne(ne), ns(ns),
 1526:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
 1527:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
 1528:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
 1529:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
 1530:                        localNodeBoundaryMem(localNodeBoundaryMem), localSideBoundaryMem(localSideBoundaryMem),
 1531:                        localSegmentMem(localSegmentMem),
 1532:                        h_c(h_c), h_s(h_s), theta_b(theta_b), theta_f(theta_f), sigma(sigma), ztot(ztot),
 1533:                        cs(cs), dcs(dcs),
 1534:                        coeffMatrixMem(partCoeffMatrixMem),
 1535:                        landBoundarySegment(true),
 1536:                        landBoundaryNode(true)
 1537:    {
 1538:       printf("Mesh constructor for partition %d\n", partNum);
 1539: 
 1540:       printf("npgb = %d, negb = %d, nsgb = %d, nseg = %d\n", npgb, negb, nsgb, nseg);
 1541:       printf("np = %d, ne = %d, ns = %d\n", np, ne, ns);
 1542:       printf("max_np = %d, max_ne = %d, max_ns = %d\n", max_np, max_ne, max_ns);
 1543:  
 1544:       printf("elemsPtr = %p, elems = %p\n", *elems, elemsMem);
 1545:       
 1546:       sinh_theta_f = sinh(theta_f);
 1547: 
 1548:    }
