 6037: 
 6038:       const int idx = node->idx;
 6039:       Vector2 wind = {xWind[idx], yWind[idx]};
 6040: 
 6041:       if constexpr(nws != 0 && iwindoff != 0) {
 6042:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 6043:       }
 6044: 
 6045:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 6046:       node->setWind(wind);
 6047: 
 6048:       node->pr = pressAir[idx];
 6049:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 6050: 
 6051:    }
