 7212: 
 7213: __global__ void computeMatrixProductAndDotProducts() {
 7214:    // Computes A*p, r'Mr and p'Ap
 7215: 
 7216:    // 1) shared buffer: first half for rMr, second for pAp
 7217:    __shared__ double sdata[2*BLOCK_SIZE];
 7218:    double* s_rMr = sdata;
 7219:    double* s_pAp = sdata + BLOCK_SIZE;
 7220: 
 7221:    const int tid = threadIdx.x;
 7222: 
 7223:    double l_pAp = 0.0;
 7224: 
 7225:    s_rMr[tid] = 0.0;
 7226:    s_pAp[tid] = 0.0;
 7227: 
 7228:    // 2) get your node pointer
 7229:    // NODE(node);   
 7230:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7231:    Node *node = &(mesh->localNodeData[idx_node]); 
 7232:    if (idx_node < mesh->np) {
 7233: 
 7234: 
 7235:    const double diag = node->coeffDiag;
 7236:    const double r    = node->mR;
 7237:    const double p    = node->mP;  
 7238: 
 7239:    // apply preconditioner on the fly:
 7240:    // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7241: 
 7242:    // 4) compute Ap = A.p
 7243:    double Ap = node->coeffDiag * node->mP;
 7244:    for (int j = 0; j < node->numNodes; ++j) {
 7245:       const Node *nbNode = node->nodes[j];
 7246:       Ap += node->coeffMatrix[j] * nbNode->mP;
 7247: 
 7248:    }
 7249: 
 7250:    node->mAp = Ap;
 7251:     
 7252: 
 7253:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 7254:    // const double l_rMr = r*Mr;  // r'Mr
 7255:    l_pAp = p*Ap;  // p'Ap
 7256: 
 7257: 
 7258:    }
 7259: 
 7260:    // 6) write into shared mem
 7261:    // s_rMr[tid] = l_rMr;
 7262:    s_pAp[tid] = l_pAp;
 7263: 
 7264:    __syncthreads();
 7265: 
 7266:    // 7) block-wide tree reduction
 7267:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7268:       if (tid < stride)  {
 7269:          s_pAp[tid] += s_pAp[tid + stride];
 7270:       }
 7271:       __syncthreads();
 7272:    }
 7273: 
 7274:    // 8) thread 0 atomically accumulates into the globals
 7275:    // XXX: This is slower than it needs to be, but it is simple and works
 7276:    if (tid == 0) {
 7277:       atomicAdd(pAp, s_pAp[0]);
 7278:    }
 7279: 
 7280: 
 7281: }
 7282: 
 7283: 
 7284: __global__ void updateSolutionAndDotProducts(void) {
 7285:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7286: 
 7287:    const int tid = threadIdx.x;
 7288: 
 7289:    s_rMr[tid] = 0.0;
 7290: 
 7291:    // get node & bounds-check:
 7292:    NODE(node);
 7293: 
 7294:    
 7295:    // Compute alpha
 7296:    const double alpha = (*rMr_old)/(*pAp);
 7297: 
 7298:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7299: 
 7300: 
 7301:    // load scalars
 7302:    const double diag = node->coeffDiag;
 7303:    const double p    = node->mP;
 7304:    const double Ap   = node->mAp;
 7305:    const double x    = node->mX;
 7306:    const double r    = node->mR;
 7307:    
 7308:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7309: 
 7310:    // 1) update solution & residual
 7311:    const double x_new = x + alpha*p;
 7312:    const double r_new = r - alpha*Ap;
 7313:    node->mX = x_new;
 7314:    node->mR = r_new;
 7315: 
 7316:    // 2) apply Jacobi preconditioner on the fly
 7317:    const double Mr_new = r_new/diag;
 7318: 
 7319: 
 7320:    // 3) local contributions for the two dot-products
 7321:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7322: 
 7323:    // 4) write into shared-mem
 7324:    s_rMr[tid] = l_rMr;
 7325: 
 7326:    __syncthreads();
 7327: 
 7328: 
 7329:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7330:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7331:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7332:       __syncthreads();
 7333:    }
 7334: 
 7335:    // 6) thread 0 atomically folds into the global accumulators
 7336:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7337: 
 7338: 
 7339: }
 7340: 
 7341: 
 7342: __global__ void updateSearchDirection() {
 7343: 
 7344:     NODE(node);
 7345: 
 7346:     // recompute z on-the-fly
 7347:     const double z = node->mR / node->coeffDiag;
 7348:     const double p = node->mP;
 7349: 
 7350:     const double beta = (*rMr_new)/(*rMr_old);
 7351: 
 7352: 
 7353:     // p =z + beta*p
 7354:     node->mP = z + beta*p;
 7355: 
 7356: }
 7357: 
 7358: __global__ void initializePreconditionedResidual(double *scalars) {
 7359: 
 7360:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 7361: 
 7362:     s_rMr[threadIdx.x] = 0.0;
 7363: 
 7364:     NODE(node);
 7365:     const int tid = threadIdx.x;
 7366:     // For the first iteration:
 7367:     // 1. Initial solution x = 0 (already set)
 7368:     // 2. Initial residual r = b (stored in qel)
 7369:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7370: 
 7371: // XXX we should use the guess solution here    
 7372: 
 7373:     // Set initial residual r = b (from qel)
 7374:     node->mR = node->qel;
 7375: 
 7376:     // Compute z = M^-1 * r (preconditioned residual)
 7377:     const double z = node->mR / node->coeffDiag;
 7378: 
 7379:     // Set initial search direction p = z
 7380:     node->mP = z;
 7381: 
 7382:     // Initialize other variables needed for CG
 7383:     node->mX = 0.0;  // Initial solution
 7384:     node->mAp = 0.0; // Will be computed in first iteration
 7385: 
 7386:     // These point to a cupy array in the host code
 7387:     rMr_old = scalars + 0;
 7388:     rMr_new = scalars + 1;
 7389:     pAp     = scalars + 2;
 7390: 
 7391:     // Computes the first r'Mr (reduction)
 7392:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7393: 
 7394:     // 4) write into shared-mem
 7395:     s_rMr[tid] = l_rMr;
 7396: 
 7397:     __syncthreads();
 7398: 
 7399: 
 7400:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7401:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7402:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7403:         __syncthreads();
 7404:     }
 7405: 
 7406:     // 6) thread 0 atomically folds into the global accumulators
 7407:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7408: 
 7409:     *rMr_old = 0.0;
 7410:     *pAp = 0.0;
 7411: }
 7412: 
 7413: 
 7414: 
 7415: 
 7416: extern "C" __global__ void getElementVar(int varCode, double *var, int k = -1, int j = -1) {
 7417:    // Get the value of a variable from an element
 7418:    // varName is the name of the variable to get
 7419:    // var is the array to store the value
 7420:    // k is the vertical level index of the variable to get
 7421: 
 7422:    ELEM(elem);
 7423:    
 7424:    int idx = elem->idx;
 7425:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7426: 
 7427:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7428:    if      (varCode == (int)VarCode::w && k >= 0)       var[idx] = elem->w[k];
 7429:    else if (varCode == (int)VarCode::z && k >= 0)       var[idx] = elem->z[k];
 7430:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = elem->center.x;
 7431:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = elem->center.y;
 7432:    else if (varCode == (int)VarCode::area && k == -1)   var[idx] = elem->area;
 7433:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = elem->depth;
 7434:    else if (varCode == (int)VarCode::radius && k == -1) var[idx] = elem->radius;
 7435:    else if (varCode == (int)VarCode::xlon && k == -1)   var[idx] = elem->xlon;
 7436:    else if (varCode == (int)VarCode::ylat && k == -1)   var[idx] = elem->ylat;
 7437:    else if (varCode == (int)VarCode::ghatx && k == -1)  var[idx] = elem->ghat1.x;
 7438:    else if (varCode == (int)VarCode::ghaty && k == -1)  var[idx] = elem->ghat1.y;
 7439:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(elem->kb);
 7440:    else if (varCode == (int)VarCode::ssign && k == -1 && j > -1)  var[idx] = (double)(elem->ssign[j]);
 7441:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7442:       
 7443:    
 7444: }
 7445: 
 7446: 
 7447: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7448:    // Get the value of a variable from an node
 7449:    // varName is the name of the variable to get
 7450:    // var is the array to store the value
 7451:    // k is the vertical level index of the variable to get
 7452: 
 7453:    NODE(node);
 7454:    
 7455:    int idx = node->idx;
 7456:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7457: 
 7458:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7459:    
 7460:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7461:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7462:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = node->p.y;
 7463:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7464:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 7465:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7466:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7467:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;   
 7468:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7469:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7470:    else if (varCode == (int)VarCode::v && k >= 0)       var[idx] = node->u2[k].y;
 7471:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->u2[k].z;
 7472:    
 7473:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7474:       
 7475:    
 7476: }
 7477: 
 7478: 
 7479: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7480:    // Get the value of a variable from an side
 7481:    // varName is the name of the variable to get
 7482:    // var is the array to store the value
 7483:    // k is the vertical level index of the variable to get
 7484:    SIDE(side);
 7485:    
 7486:    int idx = side->idx;
 7487:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7488: 
 7489:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 7490:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 7491:    else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 7492:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 7493:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 7494:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 7495:    else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 7496:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 7497:    else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 7498:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 7499:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 7500:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 7501:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 7502:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 7503:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 7504:    else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 7505:    else if (varCode == (int)VarCode::bccx && k >= 0)     var[idx] = side->bcc[k].x;
 7506:    else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 7507:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7508:    else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7509:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7510:    else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7511:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 7512:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->isLand:0.0;
 7513:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 7514:    else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 7515:    else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 7516:    else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 7517:    else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 7518:    else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 7519:    else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 7520:    else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 7521:    else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 7522:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7523: }
