 7555: extern "C"
 7556:                                  
 7557:   __global__ void populateMesh(int *i34, int *elnode, int *elside,
 7558:                    double *node_coords, double *node_coords_ll, bool use_ll,
 7559:                    double *wind_rotate_angle,  int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 7560:                    int *isdel, int *isidenode, int *isbnd,
 7561:                    int *nond, int *nlnd, int *iond, int *ilnd, 
 7562:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 7563:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 7564:                    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 7565:                    int *localNodeIndices, int *localElemIndices, int *localSideIndices,
 7566:                    int *localNodePart,    int *localElemPart,    int *localSidePart,
 7567:                    double *drag, double *roughness,
 7568:                    double *emo, double *efa, 
 7569:                    double *umo, double *ufa, 
 7570:                    double *vmo, double *vfa) {
 7571: 
 7572:     mesh->populateMesh(i34, elnode, elside, node_coords, node_coords_ll, use_ll, wind_rotate_angle, 
 7573:                        sharedIdxNodeBoundary, sharedIdxSideBoundary,
 7574:                        isdel, isidenode, isbnd,
 7575:                        nond, nlnd, iond, ilnd, 
 7576:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 7577:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 7578:                        globalNodeIndices, globalElemIndices, globalSideIndices,
 7579:                        localNodeIndices, localElemIndices, localSideIndices,
 7580:                        localNodePart, localElemPart, localSidePart,
 7581:                        drag, roughness,
 7582:                        emo, efa, umo, ufa, vmo, vfa);  // XXXXX Remember to refactor this, removing the parameters that are not used.
 7583:   }
