 4725: 
 4726: 
 4727: 
 4728: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::N2_c(Node *node, int k) const {
 4729:    // Brunt-Väisälä frequency at the center of the layer between levels k-1 and k.
 4730:    const double rho_c = 0.5*(node->rho[k] + node->rho[k-1]);
 4731:    return (grav/rho_c)*(node->rho[k] - node->rho[k-1])/node->Dz(k);
 4732: }
 4733: 
 4734: 
 4735: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::N2(Node *node, int k) const {
 4736:    // Brunt-Väisälä frequency at level k.
 4737:    if (k <= node->kb || k >= ivrt) return 0.0;
 4738:    return (grav/node->rho[k])*(node->rho[k+1] - node->rho[k-1])/(node->z[k+1] - node->z[k-1]);
 4739: }
 4740: 
 4741: 
 4742: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::Fwall(Node *node, int k, double mxl_c) const {
 4743: 
 4744:    
 4745:    // Returns wall proximity function F_wall for the dissipation term in the GLS turbulence model.
 4746:    // k is the layer bottom index.
 4747: 
 4748: 
 4749: 
 4750:    if constexpr (turbSubmodel == MellorYamada || turbSubmodel == KL) {
 4751: 
 4752:       const double z_c = 0.5*(node->z[k] + node->z[k+1]);
 4753:       const double eta2 = node->eta2;
 4754:       const double depth = node->depth;
 4755: 
 4756:       // Distances from the layer midpoint to the surface and bottom
 4757:       const double dist_s = eta2 - z_c;
 4758:       const double dist_b = z_c + depth;
 4759: 
 4760:       assert(dist_s != 0.0 && dist_b != 0.0 && "Zero in proximity function");         
 4761: 
 4762:       return 1.0 + 1.33*pow<2>((1.0/kappa)*mxl_c/dist_b) + 0.25*pow<2>((1.0/kappa)*mxl_c/dist_s);
 4763: 
 4764: 
 4765:    } else {
 4766:       return 1.0; // Other GLS submodels
 4767: 
 4768:    }
 4769: }
 4770: 
 4771: 
 4772: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::mxlmin(double depth) const {
 4773:    // Minimum mixing length for levels below the surface.
 4774:    // Independent of psimin(); do not invert one to get the other.
 4775:    return 2.0 * tkemin() * 0.1 * max(h0, depth);
 4776: }
 4777: 
 4778: 
 4779: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::vegTurbProduction(Node *node, int k) const {
 4780: 
 4781:    // Returns the turbulence production due to vegetation averaged over the current layer.
 4782: 
 4783:    if constexpr(iveg == 1) {
 4784:       
 4785:       const double zbot = node->z[k-1]; // Bottom of the current layer.
 4786:       const double zTopCanopy = node->zTopCanopy();
 4787: 
 4788:       if (zbot < zTopCanopy) { // This means that the current level is within the vegetation layer, either partially or fully
 4789: 
 4790:          const double ztop = node->z[k];   // Top of the current layer.
 4791: 
 4792:          // Fraction of the current layer that is within the vegetation layer. zrat \in (0,1]
 4793:          // Where 1 means that the current level is fully within the vegetation layer.
 4794:          const double zrat = (min(zTopCanopy, ztop) - zbot)/(ztop - zbot);
 4795: 
 4796:          // Velocity at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4797:          const Vector2 ub2_top = (1.0 - zrat)*node->u2[k-1] + zrat*node->u2[k]; // @top of canopy
 4798: 
 4799:          // Magnitude of the velocity at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4800:          // and at the bottom of the layer.
 4801:          const double vmag_top = length(ub2_top);
 4802:          const double vmag_bot = length(node->u2[k-1]);
 4803: 
 4804:          // Volume-averaged velocity cubed.
 4805:          const double vmag3 = 0.5*(pow<3>(vmag_top) + pow<3>(vmag_bot));
 4806: 
 4807:          // Vegetation alpha at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4808:          // and at the bottom of the layer.
 4809:          const double veg_alpha3D_top = (1.0 - zrat)*node->veg_alpha3D[k-1] + zrat*node->veg_alpha3D[k];
 4810:          const double veg_alpha3D_bot = node->veg_alpha3D[k-1];
 4811: 
 4812:          // Volume-averaged vegetation alpha cubed.
 4813:          const double veg_alpha3D = 0.5*(veg_alpha3D_top + veg_alpha3D_bot);
 4814: 
 4815:          return veg_alpha3D*vmag3;
 4816:       } 
 4817:       else {
 4818:          // The current level is not within the vegetation layer, so the production is 0.
 4819:          return 0.0;
 4820:       }
 4821:    } else {
 4822: 
 4823:       // If no vegetation, the production is 0.
 4824:       return 0.0;
 4825:    }
 4826: 
 4827: }
 4828: 
 4829: 
 4830: __device__ void Turbulence<TurbulenceModel::GLS>::computeDiffusivities(Node *node) {
 4831:    // Eddy viscosity/diffusivity from the algebraic stability functions (stabilityModel).
 4832:    // Writes node->dfv, node->dfh (diffusivities for momentum/tracers) and nu_tke, nu_phi (diffusivities for TKE/phi).
 4833: 
 4834:    const int kb = node->kb;
 4835: 
 4836:    for (int k = kb; k < nvrt; k++) {
 4837:       const double tke = this->tke[k];
 4838:       const double mxl = this->mxl[k];
 4839:       const double u = sqrt(tke);  // Characteristic velocity
 4840:       const double lu = mxl*u;     // Characteristic diffusivity 
 4841: 
 4842:       // vertical gradient of density (homogeneous Neumann boundary conditions at the surface and bottom).
 4843:       double drho_dz = 0.0;
 4844:       if (k > kb && k < ivrt) {
 4845:          drho_dz = (node->rho[k+1] - node->rho[k-1])/(node->z[k+1] - node->z[k-1]);
 4846:       }
 4847: 
 4848:       const double N2 =this->N2(node, k); // Brunt-Väisälä frequency
 4849: 
 4850:       // Tsinghua group       
 4851:       const double Gh = clamp(0.5*mxl*mxl*N2/tke, -0.28, 0.0233);
 4852: 
 4853:       double sh, sm, cmiu, cmiup, cmiu1, cmiu2;
 4854:       if constexpr (stabilityModel == Galperin) {
 4855:          sh = 0.49393/(1.0-34.676*Gh);
 4856:          sm = (0.39327-3.0858*Gh)/(1.0-34.676*Gh)/(1.0-6.1272*Gh);
 4857:          cmiu  = sqrt(2.0)*sm;
 4858:          cmiup = sqrt(2.0)*sh;
 4859:          cmiu1 = sqrt(2.0)*0.2;
 4860:          cmiu2 = sqrt(2.0)*0.2;
 4861: 
 4862:       } else if constexpr (stabilityModel == KanthaClayson) {  // Kantha and Clayson
 4863:          // Warner's paper has problem
 4864:          //  Ghp=(Gh-(Gh-0.02)**2)/(Gh+0.0233-0.04) !smoothing
 4865:          const double Ghp = Gh;  /// XXXXX needed?
 4866:          sh = 0.4939/(1.0 - 30.19*Ghp);
 4867:          sm = (0.392 + 17.07*sh*Ghp)/(1.0-6.127*Ghp);
 4868:          cmiu  = sqrt(2.0)*sm;
 4869:          cmiup = sqrt(2.0)*sh;
 4870:          cmiu1 = cmiu/schk();
 4871:          cmiu2 = cmiu/schpsi();
 4872: 
 4873:       } else {
 4874:          assert(false && "Unknown ASM");
 4875: 
 4876:       }
 4877: 
 4878:       node->dfv[k] = clamp(cmiu  * lu, diffmin, diffmax);
 4879:       node->dfh[k] = clamp(cmiup * lu, diffmin, diffmax);
 4880:       nu_tke[k]    = clamp(cmiu1 * lu, diffmin, diffmax);
 4881:       nu_phi[k]    = clamp(cmiu2 * lu, diffmin, diffmax);
 4882:    }
 4883: }
 4884: 
 4885: 
 4886: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::maxMixingLength(Node *node, int k) const {
 4887: // Compute upper bound for the turbulent mixing length based on the distance to the closest "wall" (either surface or bottom).
 4888: 
 4889:    const double z = node->z[k];
 4890:    const double eta2 = node->eta2;
 4891:    const double depth = node->depth;
 4892: 
 4893:    // Distances to the surface and bottom
 4894:    const double dist_s = eta2 - z;
 4895:    const double dist_b = z + depth;
 4896: 
 4897:    // Distance to the closest "wall" (either surface or bottom).  
 4898:    // In the top layer, it is the size of the layer.
 4899:    const double min_dist = (k==ivrt)?node->Dz(ivrt):min(dist_s, dist_b); 
 4900:    assert(min_dist > 0.0 && "Invalid minimum distance");
 4901: 
 4902:    // The limit of the mixing length is the maximum eddy that the closest "wall" allows.
 4903:    return kappa*min_dist;
 4904: }
 4905: 
 4906: 
 4907: 
 4908: template<TurbulenceModel turbulenceModel>
 4909: __device__ __forceinline__ void computeTurbulenceModel(Node *node);
 4910: 
 4911: 
 4912: template<>
 4913: __device__ __forceinline__ void computeTurbulenceModel<TurbulenceModel::Constant>(Node *node) { 
 4914:    // Constant turbulence model
 4915:    // Does nothing since dfv and dfh are already set  in the initialization.
 4916: }
 4917: 
 4918: template<>
 4919: __device__ __forceinline__ void computeTurbulenceModel<TurbulenceModel::GLS>(Node *node) { 
 4920:    // Mellor-Yamada-Galperin & Umlauf-Burchard scheme
 4921: 
 4922:    // Solves the following PDEs:
 4923:    //
 4924:    //    dK/dt = d/dz(nu_q2*dK/dz) + 2*(Prod - diss + Buoy)
 4925:    //    dPhi/dt = d/dz(nu_xl*dPhi/dz) + 2*(l/q2)*(cpsi1*Prod - cpsi2*Fw*diss + cpsi3*Buoy)
 4926:    //
 4927:    // Where K is TKE and Phi is the GLS generic length-scale variable, and Fw is the wall proximity function.
 4928:    // In the code we call them tke and phi. However, we don't store phi, we store mxl (mixing length).
 4929:    // They are related by the equation: Phi = cpsi2*Fw*sqrt(K/cpsi3), but it can be confusing, so be careful.
 4930:    //
 4931:    // The equations are solved using a linear *vertical* FEM formulation.
 4932:    // Elements are linear functions defined on a layer (the interval between two vertical levels).
 4933:    // The shape functions are triangular functions composed of two linear functions over consecutive intervals.
 4934:    
 4935:    
 4936:    // Get the turbulence model
 4937:    // reinterpret_cast is used to avoid stupid compiler errors.
 4938:    Turbulence<TurbulenceModel::GLS> &turb = reinterpret_cast<Turbulence<TurbulenceModel::GLS>&>(node->turb);
 4939:      
 4940:    const int kb = node->kb;
 4941:    const int nqrows = nvrt - kb - 1; // Number of rows of the tridiagonal system
 4942: 
 4943:    double alow_tke[nvrt], alow_phi[nvrt];
 4944:    double bdia_tke[nvrt], bdia_phi[nvrt];
 4945:    double cupp_tke[nvrt], cupp_phi[nvrt];
 4946:    double rhs_tke [nvrt], rhs_phi [nvrt];
 4947:    
 4948:    // Initialize the tridiagonal system
 4949:    for (int kin = 0; kin < nqrows; kin++) {
 4950:       alow_tke[kin]=0.0;
 4951:       bdia_tke[kin]=0.0;
 4952:       cupp_tke[kin]=0.0;
 4953:       rhs_tke [kin]=0.0; 
 4954:       alow_phi[kin]=0.0;
 4955:       bdia_phi[kin]=0.0;
 4956:       cupp_phi[kin]=0.0;
 4957:       rhs_phi [kin]=0.0; 
 4958:    }
 4959: 
 4960: 
 4961: 
 4962:    // For dry or 2D nodes, vertical viscosity and diffusivity are set to their minimum values.
 4963:    if (node->isDry || node->is2D()) {
 4964: 
 4965:       // Minimum diffusivity at each node. In some cases, it is node-dependent (read from file).
 4966:       const double diffmin = turb.diffmin;
 4967: 
 4968:       for (int k = 0; k < nvrt; k++) {
 4969:          turb.tke[k]    = turb.tkemin();
 4970:          turb.mxl[k]    = turb.mxlmin(node->depth);
 4971:          node->dfv[k]   = diffmin;
 4972:          node->dfh[k]   = diffmin;
 4973:          turb.nu_tke[k] = diffmin;
 4974:          turb.nu_phi[k] = diffmin;
 4975:       }
 4976: 
 4977:       return;
 4978:    }
 4979: 
 4980:    assert(node->rho[0] >= -98.0 && "Impossible: dry 2"); /// XXX JMG: Do I need to fill these centinel values?
 4981:    
 4982:    // After here we know that the node is wet and has at least 2 layers.
 4983: 
 4984:    double solution[nvrt], gam[nvrt];
 4985:    
 4986:    const double eta2       = node->eta2;
 4987:    const double depth      = node->depth;
 4988:    const double Cd         = node->Cd; // Drag coefficient
 4989: 
 4990:    constexpr double c0 = 6.50736836993; //pow(16.6, 2.0/3.0); 
 4991:    
 4992:    const double sqU2 = norm2(node->u2[kb + 1]);
 4993:    const double modTau = length(node->tau);
 4994: 
 4995:  
 4996: 
 4997:    const double cpsi1 = turb.cpsi1();
 4998:    const double cpsi2 = turb.cpsi2();
 4999:    // cpsi3 is computed later because it depends on k
 5000: 
 5001: 
 5002:    // Assemble the tridiagonal system
 5003:    // -------------------------------
 5004: 
 5005:    // Loop over each vertical layer (interval between two vertical levels)
 5006:    // Each interval is an element of the vertical FEM formulation.
 5007:    // Two shape functions are defined over each interval. In this function we well call them
 5008:    // p1 and p2. The derivatives of the shape functions are called d1 and d2.
 5009:    // In general, inside the loops, 1 refers to the lower level and 2 refers to the upper level.
 5010:    //
 5011:    // Each interval contributes to two rows (vertical levels) of the tridiagonal system.
 5012:    // Both systems of equations are assembled in the same loop.
 5013:    for (int k = kb + 1, kin = 0; k < ivrt; k++, kin++) {
 5014: 
 5015:       // Indices for the *rows* of the tridiagonal system.
 5016:       const int k1 = k - kb - 1; // Zero at k = kb + 1
 5017:       const int k2 = k - kb;     // One at k = kb + 1
 5018: 
 5019:       // Get the properties of the current interval.
 5020:       const double z  = node->z[k]; // bottom level of the interval
 5021:       const double dz = node->Dz(k + 1);
 5022:       const double rho_c = 0.5*(node->rho[k] + node->rho[k+1]);
 5023:       
 5024:       const Vector2 du_dz   = (node->u2[k+1] - node->u2[k])/dz;
 5025:       const double drho_dz = (node->rho[k+1] - node->rho[k])/dz;
 5026: 
 5027:       // Turbulence production/dissipation terms (at the center of the interval).
 5028:       
 5029:       const double M2 = norm2(du_dz);              // Shear production term
 5030: 
 5031:       const double N2 = turb.N2_c(node, k + 1);      // Brunt-Väisälä frequency (squared, kind of... this is signed), production or dissipation term
 5032: 
 5033:       const double vegProd = turb.vegTurbProduction(node, k + 1);
 5034: 
 5035:       const double cpsi3 = turb.cpsi3(N2); 
 5036: 
 5037: 
 5038:       // Turbulence quantities at half levels (cell [c]enter)
 5039:       const double tke_1     = turb.tke[k];
 5040:       const double tke_2     = turb.tke[k+1];
 5041:       const double mxl_1     = turb.mxl[k];
 5042:       const double mxl_2     = turb.mxl[k+1];
 5043:       const double tke_c     = 0.5*(tke_1 + tke_2);
 5044:       const double mxl_c     = 0.5*(mxl_1 + mxl_2);
 5045:       const double nu_tke_c  = 0.5*(turb.nu_tke[k] + turb.nu_tke[k+1]);
 5046:       const double nu_phi_c  = 0.5*(turb.nu_phi[k] + turb.nu_phi[k+1]);
 5047:       const double dfv_c     = 0.5*(node->dfv[k]   + node->dfv[k+1]);
 5048:       const double dfh_c     = 0.5*(node->dfh[k]   + node->dfh[k+1]);
 5049:       const double Fwall_c   = turb.Fwall(node, k, mxl_c);
 5050: 
 5051:       // Integral of the shape function products:
 5052:       // integral of (phi_i*phi_i)dz = dz/3.0,   integral of (phi_i*phi_i+1)dz = dz/6.0
 5053:       // integral of (phi_i'*phi_i+1')dz = 1/dz, integral of (phi_i'*phi_i+1')dz = -1/dz
 5054:       const double p1p1 = dz/3.0;
 5055:       const double p1p2 = dz/6.0;
 5056:       const double d1d1 =  1.0/dz;
 5057:       const double d1d2 = -1.0/dz;
 5058: 
 5059:       // Production/dissipation related terms
 5060:       const double prod = dfv_c*M2 + veg_cfk*vegProd;
 5061:       const double buoy = dfh_c*N2;
 5062:       const double diss = pow<3>(cmiu0)*sqrt(tke_c)/mxl_c*dz/6.0; //diss/k
 5063: 
 5064:       // Equation for tke
 5065:       // ---------------
 5066: 
 5067:       // First row (of the two rows that the interval contributes to)
 5068:       bdia_tke[k1] += p1p1 + dt*d1d1*nu_tke_c;
 5069:       cupp_tke[k1] += p1p2 + dt*d1d2*nu_tke_c;
 5070:       rhs_tke [k1] += p1p1*tke_1 + p1p2*tke_2;
 5071: 
 5072: 
 5073:       if(prod + buoy >= 0.0) { // Net production
 5074:          rhs_tke[k1] += dt*dz/2.0*(prod + buoy);
 5075:       } else { // Net dissipation
 5076:          const double tmp = dt*dz/6.0*(prod + buoy)/tke_c;
 5077:          bdia_tke[k1] -= 2.0*tmp;
 5078:          cupp_tke[k1] -= tmp;
 5079:       }      
 5080:       
 5081:       bdia_tke[k1] += 2.0*dt*diss;
 5082:       cupp_tke[k1] += dt*diss;
 5083:       
 5084:   
 5085:       // Second row (of the two rows that the interval contributes to)
 5086:       bdia_tke[k2] += p1p1 + dt*d1d1*nu_tke_c;
 5087:       alow_tke[k2] += p1p2 + dt*d1d2*nu_tke_c;
 5088:       rhs_tke [k2] += p1p1*tke_2 + p1p2*tke_1;
 5089: 
 5090:       if (prod + buoy >= 0.0) { // Net production
 5091:          rhs_tke[k2] += dt*dz/2.0*(prod+buoy);
 5092:       } else { // Net dissipation
 5093:          const double tmp = dt*dz/6.0*(prod + buoy)/tke_c;
 5094:          bdia_tke[k2] -= 2.0*tmp;
 5095:          alow_tke[k2] -= tmp;
 5096:       }
 5097:       
 5098:       bdia_tke[k2] += 2.0*dt*diss;
 5099:       alow_tke[k2] += dt*diss;
 5100: 
 5101: 
 5102:       // Equation for xl
 5103:       // ---------------
 5104: 
 5105:       const double rpub = turb.rpub();
 5106:       const double rmub = turb.rmub();
 5107:       const double rnub = turb.rnub();
 5108:       const double psi_1 = turb.phiFromMxl(tke_1, mxl_1); 
 5109:       const double psi_2 = turb.phiFromMxl(tke_2, mxl_2); 
 5110:       const double psi_c = 0.5*(psi_1 + psi_2);
 5111: 
 5112:       // Production/dissipation related terms
 5113:       const double prod_phi = cpsi1*dfv_c*M2 + veg_cfpsi*vegProd;
 5114:       const double buoy_phi = cpsi3*dfh_c*N2;
 5115:       const double diss_phi = cpsi2*Fwall_c*pow<3>(cmiu0)*sqrt(tke_c)/mxl_c*dz/6.0; //diss/k
 5116: 
 5117:       bdia_phi[k1] += p1p1 + dt*d1d1*nu_phi_c;
 5118:       cupp_phi[k1] += p1p2 + dt*d1d2*nu_phi_c;
 5119:       rhs_phi [k1] += p1p1*psi_1 + p1p2*psi_2;
 5120: 
 5121:       if (prod_phi + buoy_phi >= 0.0) { // Net production
 5122:          rhs_phi[k1] += dt*dz/2.0*(prod_phi + buoy_phi)*psi_c/tke_c;
 5123:       } else { // Net dissipation
 5124:          const double tmp = dt*dz/6.0*(prod_phi + buoy_phi)/tke_c;
 5125:          bdia_phi[k1] -= 2.0*tmp;
 5126:          cupp_phi[k1] -= tmp;
 5127:       }
 5128: 
 5129:       // Production/dissipation terms
 5130:       bdia_phi[k1] += 2.0*dt*diss_phi;
 5131:       cupp_phi[k1] += dt*diss_phi;
 5132:  
 5133: 
 5134:       // row k2 (upper)
 5135:       bdia_phi[k2] += p1p1 + dt*d1d1*nu_phi_c;
 5136:       alow_phi[k2] += p1p2 + dt*d1d2*nu_phi_c;
 5137:       rhs_phi [k2] += p1p1*psi_2 + p1p2*psi_1;
 5138: 
 5139:       if (prod_phi + buoy_phi >= 0.0) { // Net production
 5140:          rhs_phi[k2] += dt*dz/2.0*(prod_phi + buoy_phi)*psi_c/tke_c;
 5141:       } else { // Net dissipation
 5142:          const double tmp = dt*dz/6.0*(prod_phi + buoy_phi)/tke_c;
 5143:          bdia_phi[k2] -= 2.0*tmp;
 5144:          alow_phi[k2] -= tmp;
 5145:       }
 5146: 
 5147:       // Production/dissipation terms
 5148:       bdia_phi[k2] += 2.0*dt*diss_phi;
 5149:       alow_phi[k2] += dt*diss_phi;
 5150: 
 5151:    }
 5152: 
 5153:    // BC
 5154:    bdia_phi[0]          += kappa * turb.rnub() * dt * turb.nu_phi[kb + 1] / turb.mxl[kb + 1];
 5155:    bdia_phi[nqrows - 1] += kappa * turb.rnub() * dt * turb.nu_phi[ivrt]   / turb.mxl[ivrt];
 5156: 
 5157: 
 5158:    // Solves for tke.
 5159:    tridag_sch<1>(nqrows, alow_tke, bdia_tke, cupp_tke, rhs_tke, solution, gam);
 5160: 
 5161: 
 5162:    // B.C. (computed using values from previous time except wind)
 5163:    const double tkesrf = max(0.5*c0*modTau,  turb.tkemin()); // Eq. (10) of Zhang & Baptista (2008)
 5164:    const double tkebot = max(0.5*c0*Cd*sqU2, turb.tkemin());
 5165: 
 5166: 
 5167:    // Update TKE.
 5168:    turb.tke[kb]     = tkebot;
 5169:    turb.tke[kb + 1] = tkebot;
 5170:    turb.tke[ivrt]   = tkesrf;
 5171:    for (int k = kb + 2, kin = 1; k < ivrt; k++, kin++) {
 5172:       turb.tke[k] = max(solution[kin], turb.tkemin());
 5173:    }
 5174: 
 5175: 
 5176: 
 5177:  
 5178:    // Solves for phi.
 5179:    tridag_sch<1>(nqrows, alow_phi, bdia_phi, cupp_phi, rhs_phi, solution, gam);
 5180: 
 5181: 
 5182:    // B.C. for the mixing lengths: Bottom and surface (T. Guérin)
 5183:    const double mxlbot = max(turb.mxlmin(depth), kappa*min(2.5, xlsc0*node->Dz(kb + 1))); //"2.5" to prevent over-mixing
 5184:    const double mxlsrf = max(turb.mxlmin(depth), xlsc0*node->Dz(ivrt)*kappa);
 5185: 
 5186:    turb.mxl[kb+1] = mxlbot;
 5187:    turb.mxl[ivrt] = mxlsrf;
 5188:    for (int k = kb + 2, kin = 1; k < ivrt; k++, kin++) {
 5189:       turb.mxl[k] = turb.mxlFromPhi(turb.tke[k], max(solution[kin], turb.psimin()));
 5190: 
 5191:       const double N2 = turb.N2_c(node, k);      // Brunt-Väisälä frequency 
 5192: 
 5193:       // Galperin's clipping
 5194:       if (N2 < 0.0) {
 5195:          const double upper = sqrt(-0.56*turb.tke[k]/N2);
 5196:          turb.mxl[k] = min(turb.mxl[k], upper);
 5197:       }   
 5198: 
 5199: 
 5200: 
 5201:       // Max. mixing length based on dissipation; mxlmin prevails
 5202:       const double mxlmax_dissip = pow<3>(cmiu0*sqrt(turb.tke[k]))/turb.epsmin();
 5203: 
 5204:       // Combined max. mixing length including geometric limit
 5205:       const double mxlmax = min(turb.maxMixingLength(node, k), mxlmax_dissip);
 5206: 
 5207:       // Clamp the mixing length between the minimum and maximum values
 5208:       turb.mxl[k] = clamp(turb.mxl[k], turb.mxlmin(depth), mxlmax);
 5209: 
 5210:       assert(turb.tke[k] >= 0 && "Negative TKE");
 5211: 
 5212: 
 5213:    } // for k
 5214: 
 5215: 
 5216:    // Extrapolate q2, xl to bottom mainly for diffusivities
 5217:    turb.tke[kb] = turb.tke[kb + 1];
 5218:    turb.mxl[kb] = turb.mxl[kb + 1];
 5219: 
 5220: 
 5221:    // Compute vertical diffusivities at new time
 5222:    turb.computeDiffusivities(node);
 5223: 
 5224:    // make all the variables uniform below the bottom level kb
 5225:    for (int k = 0; k < kb; k++) {
 5226:       node->dfv[k] = node->dfv[kb];
 5227:       node->dfh[k] = node->dfh[kb];
 5228:       turb.tke[k] = turb.tke[kb];
 5229:       turb.mxl[k] = turb.mxl[kb];
 5230:       turb.nu_tke[k] = turb.nu_tke[kb];
 5231:       turb.nu_phi[k] = turb.nu_phi[kb];
 5232:    }
 5233: 
 5234:       
 5235: 
 5236: }
 5237: 
 5238: 
 5239: 
 5240: 
 5241: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 5242:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 5243:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 5244: 
 5245: 
 5246:    NODE(node1);
 5247: 
 5248:    node1->clearMatrixRow();
 5249:    node1->qel = 0.0;
 5250: 
 5251:    // THIS IS FOR STRUCTURES XXX
 5252:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 5253: 
 5254:    
 5255:    for (int j=0; j<node1->numElements; j++) {
 5256:       // For each element connected to the node...
 5257: 
 5258:       Point2 x0, x1, x2, x3; // Local horizontal node positions
 5259: 
 5260:       Element *elem = node1->elements[j];
 5261: 
 5262:       // Compute the average gravity
 5263:       const double grav3 = elem->mean(&Node::grav2);
 5264: 
 5265:       // Look at the documentation for the description of the terms in the following integrals
 5266: 
 5267:       // Integral I_1 
 5268:       // \bar{\breve{H}} 
 5269:       const double hhatb = elem->mean(&Side::hhat);        
 5270: 
 5271:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 5272: 
 5273:       const int id1 = elem->nodeLocalIdx(node1);  // Index of node1 in element->nodes[]
 5274:       const double area = elem->area;
 5275: 
 5276:       // Integral I_4
 5277:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 5278:       // Where
 5279:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 5280: 
 5281:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 5282:       // of U over the element.
 5283:       const Vector2 U = elem->mean(&Side::U);
 5284: 
 5285:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 5286: 
 5287:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 5288:       const double I_4_1 = dot(gradPhi_1, U);
 5289: 
 5290: 
 5291:       // Integral of \nabla\phi_i \cdot \pmb{E}
 5292:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 5293: 
 5294:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 5295: 
 5296: 
 5297:       // Normal component of the bed velocity
 5298:       double ubedNormalComp = 0.0;
 5299:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 5300:          Vector3 ubed = {0.0, 0.0, 0.0};
 5301:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 5302:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 5303: 
 5304:          // Computes a unit vector perpendicular to the bottom face. It is computed as the unit vector parallel to (grad(h), 1)
 5305:          const Vector2 gradDepth = elem->grad2(&Node::depth);
 5306:          const Vector3 N = normalize(toVector3(gradDepth, 1.0));
 5307: 
 5308:          // Computes the normal component of the bed velocity
 5309:          ubedNormalComp = dot(ubed, N);
 5310:       } // imm==2
 5311: 
 5312:       const double fricCoeff = grav3*thetai*(1.0 - thetai)*dt*dt*hhatb;
 5313: 
 5314:       if (elem->isTri()) {
 5315: 
 5316:          // To clarify the notation in this section: 
 5317:          //   In formulas, we use the following notation:
 5318:          //       i stands for the node under consideration (node1)
 5319:          //       j (node2) and k (node3) are the other nodes of the triangle.
 5320:          //   However, in the code, we use the following notation:
 5321:          //       id1 is the node under consideration (node1), id2, id3 are the local indices of the other nodes (node2, node3)
 5322:          const int id2 = elem->nxq(1 + id1);
 5323:          const int id3 = elem->nxq(2 + id1);
 5324:          Node *node2 = elem->nodes[id2];
 5325:          Node *node3 = elem->nodes[id3];
 5326: 
 5327:          elem->getLocalHorizontalNodePositionsTri(x0, x1, x2, id1);
 5328: 
 5329:          // integral of phi_i*phi_j
 5330:          const double ipp_ii = (1.0/6.0 )*area;
 5331:          const double ipp_ij = (1.0/12.0)*area;
 5332:          const double ipp_ik = (1.0/12.0)*area;
 5333: 
 5334:          // integral of [(grad phi_i) * (grad phi_j)]
 5335:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x2-x1, x2-x1);
 5336:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x2-x1, x0-x2);
 5337:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a.c = a.(a+b+c-c) = a.a + a.b
 5338: 
 5339:          // Computes the different components of integral I_1 of each node with respect to node i.
 5340:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 5341:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 5342:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 5343: 
 5344:          node1->addToSparseMatrix(node1, I1_ii);
 5345:          node1->addToSparseMatrix(node2, I1_ij); 
 5346:          node1->addToSparseMatrix(node3, I1_ik);
 5347: 
 5348:          #pragma unroll
 5349:          for (int l=0; l<3; l++) {
 5350: 
 5351:             Node *node = elem->nodes[l];
 5352: 
 5353:             // Additional variation in eta due to bed deformation or vertical velocity
 5354:             double extraEta = 0.0;
 5355:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 5356:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1;
 5357: 
 5358: 
 5359:             const double ipp   = elem->intPhiPhiTri(id1, l);
 5360:             const double igpgp = elem->intGradPhiGradPhiTri(id1, l);
 5361: 
 5362:             const double isElemWet = elem->isDry ? 0.0 : 1.0;  // XXXXX I added this to replicate Fortran's code, but Joseph is going to check if it is needed.
 5363: 
 5364:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp*isElemWet;
 5365:            
 5366:          }
 5367: 
 5368: 
 5369:       }
 5370:       else { // Quad
 5371:          // To clarify the notation in this section: 
 5372:          //   In formulas, we use the following notation:
 5373:          //       i stands for the node under consideration (node1)
 5374:          //       j (node2), k (node3), l (node4) are the other nodes of the quad.
 5375:          //   However, in the code, we use the following notation:
 5376:          //       id1 is the node under consideration (node1), id2, id3, id4 are the local indices of the other nodes (node2, node3, node4)
 5377:          const int id2 = elem->nxq(1 + id1);
 5378:          const int id3 = elem->nxq(2 + id1);
 5379:          const int id4 = elem->nxq(3 + id1);
 5380:          Node *node2 = elem->nodes[id2];
 5381:          Node *node3 = elem->nodes[id3];
 5382:          Node *node4 = elem->nodes[id4];   
 5383:          
 5384:          elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 5385: 
 5386:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 5387:          const double ipp_ii = elem->intPhiPhiQuad(id1, id1, x0, x1, x2, x3);
 5388:          const double ipp_ij = elem->intPhiPhiQuad(id1, id2, x0, x1, x2, x3);
 5389:          const double ipp_ik = elem->intPhiPhiQuad(id1, id3, x0, x1, x2, x3);
 5390:          const double ipp_il = elem->intPhiPhiQuad(id1, id4, x0, x1, x2, x3);
 5391: 
 5392:          // integrals of (grad phi_i) * (grad phi_i), (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 5393:          const double igpgp_ii = elem->intGradPhiGradPhiQuad(id1, id1, x0, x1, x2, x3);
 5394:          const double igpgp_ij = elem->intGradPhiGradPhiQuad(id1, id2, x0, x1, x2, x3);
 5395:          const double igpgp_ik = elem->intGradPhiGradPhiQuad(id1, id3, x0, x1, x2, x3);
 5396:          const double igpgp_il = elem->intGradPhiGradPhiQuad(id1, id4, x0, x1, x2, x3);
 5397: 
 5398: 
 5399:          // Computes the different components of integral I_1 of each node with respect to node i.
 5400:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 5401:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 5402:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 5403:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 5404: 
 5405:          node1->addToSparseMatrix(node1, I1_ii);
 5406:          node1->addToSparseMatrix(node2, I1_ij); 
 5407:          node1->addToSparseMatrix(node3, I1_ik);
 5408:          node1->addToSparseMatrix(node4, I1_il);
 5409:   
 5410:          #pragma unroll
 5411:          for (int l=0; l<4; l++) {
 5412: 
 5413:             const Node *node = elem->nodes[l];
 5414: 
 5415:             // Additional variation in eta due to bed deformation or vertical velocity
 5416:             double extraEta = 0.0;
 5417:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 5418:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1; 
 5419: 
 5420:             const double ipp = elem->intPhiPhiQuad(id1, l, x0, x1, x2, x3);
 5421:             const double igpgp = elem->intGradPhiGradPhiQuad(id1, l, x0, x1, x2, x3);
 5422:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp;
 5423: 
 5424:          }         
 5425:       } 
 5426: 
 5427: 
 5428:      node1->qel += (dt/elem->i34)*elem->vsource;
 5429:       
 5430: 
 5431:    } // for all elements connected to the node
 5432:    
 5433: 
 5434:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 5435:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 5436:    NodeBoundary *nodeBnd = node1->nodeBnd;
 5437:    if (nodeBnd != nullptr && !nodeBnd->isLand) {
 5438:    // If it is an open boundary node...
 5439: 
 5440:    // XXXXX DO THIS MORE NATURALLY IN A SideBnd kernel?
 5441: 
 5442:       // At least one open bnd side, maybe two
 5443:       for (int l=0; l<2; l++) { 
 5444: 
 5445:          // Gets each of the sides sharing the node. 
 5446:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 5447: 
 5448:     
 5449: 
 5450:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 5451:          if (sideBnd != nullptr) {
 5452:             // If the side is on a boundary...
 5453: 
 5454:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 5455: 
 5456:             // Get the boundary segment
 5457:             const BoundarySegment *sideSegment = sideBnd->segment;
 5458:             const Side *side = sideBnd->side;
 5459: 
 5460:             // Integral I_3
 5461:             if (sideSegment->ifltype != 0) {
 5462:             // Natural or Flather b.c.
 5463: 
 5464:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 5465:                // especially for Flather b.c.
 5466:                double ri3 = 0.0;
 5467:                if (!side->isDry) {
 5468:                   // If the side is not dry
 5469:                   
 5470:                   // Computes the side flux of (uth, vth)
 5471:                   double Vn = 0.0;
 5472:                   for (int k = side->kb; k < nvrt - 1; k++) {
 5473:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 5474:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 5475: 
 5476:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 5477:                   }
 5478: 
 5479:                   ri3 = 0.5*side->len*Vn;
 5480:                }
 5481: 
 5482:                if (sideSegment->ifltype == -1) { // Flather 1
 5483: 
 5484:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 5485:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 5486: 
 5487:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 5488:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 5489:                   
 5490:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 5491:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 5492: 
 5493:                } 
 5494:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 5495:                   // Reset ri3
 5496:                   ri3 = 0.0;
 5497: 
 5498:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 5499:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 5500: 
 5501:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 5502: 
 5503:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 5504:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 5505: 
 5506:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 5507:                   node1->addToSparseMatrix(node1, con0*2.0);
 5508:                   node1->addToSparseMatrix(node2, con0);
 5509: 
 5510:                } // if Flather or Discharge
 5511: 
 5512:                node1->qel -= thetai*dt*ri3;  
 5513: 
 5514: 
 5515:             } // I_3
 5516:           
 5517: 
 5518:             // Integral I_5
 5519:             if(!side->isDry) {
 5520: 
 5521:                const double Unbar = dot(side->U, side->n);
 5522:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar; 
 5523: 
 5524:             } // I_5
 5525: 
 5526:          } // if is boundary side
 5527: 
 5528:       } // for l
 5529: 
 5530:    } // if isbnd
 5531: 
 5532: 
 5533: }
 5534: 
 5535: 
 5536: 
 5537: extern "C" {
 5538: 
 5539:    __global__ void gatherBFromMesh(double* b) {
 5540:       // b[local] <- qel  (local = idx_node on this device)
 5541:       NODE(node);
 5542:       b[idx_node] = node->qel;
 5543:    }
 5544: 
 5545:    
 5546:    __global__ void scatterXToMesh(double* x) {
 5547:       // mX <- x[local]
 5548:       NODE(node);
 5549:       node->mX = x[idx_node];
 5550:    }
 5551: 
 5552:    __global__ void setupCGSolver(double* data_d, double* b_d, 
 5553:                                  int* indices, int* indptr) {
 5554:       // XXXXXXXXXXXX REMOVE!!!
 5555:       assert(false && "setupCGSolver has beed deprecated");
 5556: 
 5557:       // NODE(node);
 5558:       
 5559:       // const int idx = node->idx;
 5560:       
 5561:       // // Computes the index in the nzz array      
 5562:       // const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx; // idx is there to account for the diagonal element that is not stored in the nodeNeighNodes array
 5563: 
 5564: 
 5565:       // indptr[idx] = nzzIdx;
 5566:       // indices[nzzIdx] = idx;
 5567: 
 5568:       // data_d[nzzIdx]    = node->coeffDiag;
 5569: 
 5570:       // b_d[idx] = node->qel;
 5571: 
 5572:       // for (int k = 0; k < node->numNodes; ++k) {
 5573:       //    const Node* nb = node->nodes[k];
 5574: 
 5575:       //    const int j = nb->idx;
 5576: 
 5577:       //    data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 5578: 
 5579:       //    indices[nzzIdx + k + 1] = j;
 5580:       // }
 5581: 
 5582:    }
