 4573: 
 4574:    __global__ void scaleGravity(double loadtide_coef) {
 4575: 
 4576: 
 4577:       NODE(node);
 4578: 
 4579:       // SAL option: scale gravity
 4580:       if constexpr(iloadtide==2) {  // simple const
 4581:          node->grav2 = grav*(1.0 - loadtide_coef);
 4582: 
 4583:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4584:         
 4585:           const double depth = max(node->depth, 0.0);
 4586:           const double tmp1 = sqrt(depth);
 4587:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4588:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4589:                              2.6969e-13*depth*depth*depth*tmp1;
 4590:           
 4591:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4592:           
 4593: 
 4594: 
 4595:           node->grav2 = grav*(1.0 - beta_bar);
 4596: 
 4597:       } else {  // iloadtide=0,1
 4598:           node->grav2 = grav;
 4599: 
 4600:       }
 4601: 
 4602:    }
 4603: 
