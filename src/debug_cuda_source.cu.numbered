 1417:    NodeBoundary *localNodeBoundaryMem; // Array of objects with the boundary information of each node
 1418:    SideBoundary *localSideBoundaryMem; // Array of objects with the boundary information of each side
 1419:    double       *coeffMatrixMem;       // Matrix coefficients for neighbors. [0..numNodes-1], doesn't include the diagonal
 1420:    BoundarySegment *localSegmentMem;   // Array of objects with the boundary segments
 1421:    
 1422:    const int npgb;  // Global number of horizontal nodes
 1423:    const int negb;  // Global number of elements
 1424:    const int nsgb;  // Global number of sides
 1425: 
 1426:    const int np;   // Local number of horizontal nodes 
 1427:    const int ne;   // Local number of elements
 1428:    const int ns;   // Local number of sides
 1429: 
 1430:    int nbp;  // Local number of boundary nodes
 1431:    int nbs;  // Local number of boundary sides
 1432: 
 1433:    int nEntries;  // Total number of matrix elements
 1434: 
 1435:    const int max_np; // Maximum number of horizontal nodes per partition (shared by all partitions)
 1436:    const int max_ne; // Maximum number of elements per partition (shared by all partitions)
 1437:    const int max_ns; // Maximum number of sides per partition (shared by all partitions)
 1438: 
 1439:   
 1440:    // Additional topology information
 1441:    Node    **nodeNeighNodes; // Array of pointers to the nodes neighbors of each node
 1442:    Element **nodeNeighElems; // Array of pointers to the elements neighbors of each node
 1443: 
 1444:    BoundarySegment landBoundarySegment;
 1445:    NodeBoundary landBoundaryNode;
