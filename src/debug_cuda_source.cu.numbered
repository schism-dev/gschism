  190: // Simple math functions ---------------------------------------------------------------------------
  191: 
  192: __device__ __forceinline__ void solveQuadratic(double A, double B, double C, double &x1, double &x2) {
  193: // Solves the quadratic equation A*x^2 + B*x + C = 0 and returns the two solutions in x1 and x2.
  194: // Outputs:
  195: //        x1: first solution
  196: //        x2: second solution
  197: 
  198:        // Use float-specific absolute value for speed on GPU
  199:     const double absA = fabs(A);
  200:     const double absB = fabs(B);
  201: 
  202:     // 1. Near-linear case: a is effectively 0.
  203:     // We use a small epsilon to prevent division by zero and handle degenerate quads.
  204:     // This branch is almost never taken, so it won't hurt performance.
  205:     if (absA < 1e-14 * (absB + 1e-30)) {
  206:         const double x = -C / B;
  207:         x1 = x;
  208:         x2 = x;
  209:         return;  // Degenerate case: A = 0.
  210:     }
  211: 
  212:    const double delta = max(0.0, B*B - 4.0*A*C);
  213: 
  214:    assert(delta >= 0.0 && "solveQuadratic: negative discriminant");
  215:    const double s = sqrt(delta);
  216: 
  217:    // Numerically stable quadratic roots:
  218:    // q = -0.5*(B + sign(B)*sqrt(delta))
  219:    const double q = -0.5 * (B + copysign(s, B));
  220: 
  221:    x1 = q/A;
  222:    x2 = (fabs(q) > 1e-30) ? (C/q) : x1;   // Moving predicate.
  223: 
  224: }
