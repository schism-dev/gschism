  212: // Simple math functions ---------------------------------------------------------------------------
  213: 
  214: __device__ __forceinline__ void solveQuadratic(double A, double B, double C, double &x1, double &x2) {
  215: // Solves the quadratic equation A*x^2 + B*x + C = 0 and returns the two solutions in x1 and x2.
  216: // Outputs:
  217: //        x1: first solution
  218: //        x2: second solution
  219: 
  220:        // Use float-specific absolute value for speed on GPU
  221:     const double absA = fabs(A);
  222:     const double absB = fabs(B);
  223: 
  224:     // 1. Near-linear case: a is effectively 0.
  225:     // We use a small epsilon to prevent division by zero and handle degenerate quads.
  226:     // This branch is almost never taken, so it won't hurt performance.
  227:     if (absA < 1e-14 * (absB + 1e-30)) {
  228:         const double x = -C / B;
  229:         x1 = x;
  230:         x2 = x;
  231:         return;  // Degenerate case: A = 0.
  232:     }
  233: 
  234:    const double delta = max(0.0, B*B - 4.0*A*C);
  235: 
  236:    assert(delta >= 0.0 && "solveQuadratic: negative discriminant");
  237:    const double s = sqrt(delta);
  238: 
  239:    // Numerically stable quadratic roots:
  240:    // q = -0.5*(B + sign(B)*sqrt(delta))
  241:    const double q = -0.5 * (B + copysign(s, B));
  242: 
  243:    x1 = q/A;
  244:    x2 = (fabs(q) > 1e-30) ? (C/q) : x1;   // Moving predicate.
  245: 
  246: }
