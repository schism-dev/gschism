 2492: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 2493: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 2494: 
 2495: //       if (delta != 0.0) {
 2496: //          // Solves the two linear equations for tt1 and tt2
 2497: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2498: //          const double tt2 = delta2/delta;
 2499: 
 2500: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 2501: //          // Similarly, we use tt2 to compute the intersection point.
 2502: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 2503: //             xIntersect = x3 + (x4 - x3)*tt2;
 2504: //             yIntersect = y3 + (y4 - y3)*tt2;
 2505: 
 2506: //             intersectingSide = side;
 2507: //             nextElement = nghbElems[i];
 2508: 
 2509: //             return true;
