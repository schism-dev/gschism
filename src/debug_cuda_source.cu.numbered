 1179: struct Node {
 1180: 
 1181:    // Geometry information
 1182:    int idx;        // Index of the node
 1183:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1184:    int numNodes;   // Number of nodes neighbors of this node
 1185: 
 1186:    Element **elements; // Array of pointers to the elements that share this node
 1187:    int numElements;    // Number of elements that share this node
 1188: 
 1189:    int numSides;       // Number of sides that are connected to this node
 1190: 
 1191:    Point2 p;
 1192:    Vector2 u2[nvrt];
 1193:    double  w2[nvrt];
 1194:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1195:    double z[nvrt];
 1196:    double lon, lat;
 1197:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1198:    double depth;
 1199: 
 1200:    int kb;       // Bottom index of the node
 1201: 
 1202:    bool isDry;     // True if the node is dry
 1203: 
 1204:    int iadv;     // Advection flag
 1205: 
 1206:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1207:                           // this is nullptr
 1208: 
 1209:    TempVar tmp; // Temporary variable to store different types of variables
 1210: 
 1211:    // Physical information
 1212:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1213:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1214: 
 1215:    double rho[nvrt];     // Density
 1216:    double dfv[nvrt];     // Vertical viscosity
 1217: 
 1218:    double eta1; // Elevation at nodes at previous timestep
 1219:    double eta2; // Elevation at nodes at current timestep
 1220: 
 1221:    double ETP;  // Earth Tidal Potential
 1222: 
 1223:    double pr;    // Air pressure
 1224:    double grav2; // Gravity 
 1225:    
 1226:    Vector2 dav;  // Depth averaged velocity
 1227: 
 1228:    Vector2 tau; // Wind stress vector
 1229: 
 1230:    // Vegetation parameters
 1231:    double veg_h;
 1232:    double veg_nv;
 1233:    double veg_di;
 1234:    double veg_Cd;
 1235:    double veg_h_unbent;
 1236:    double veg_di_unbent;
 1237:    double veg_nv_unbent;
 1238:    double veg_alpha_vert_mean;
 1239:    double veg_alpha0;
 1240:    double veg_alpha3D[nvrt];
 1241: 
 1242:    // Bottom drag parameters
 1243:    double Cd;       // Bottom drag coefficient
 1244:    double rough;    // Bottom roughness length
 1245:    Vector2 tau_bot; // Bottom stress vector
 1246: 
 1247:    double bdef1; // Bottom deformation at previous timestep
 1248:    double bdef2; // Bottom deformation at current timestep
 1249: 
 1250:    double qel; // RHS
 1251:    double coeffDiag; // Diagonal coefficient of the matrix
 1252:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1253: 
 1254:    double mP; // Search direction for conjugate gradient method
 1255:    double mR; // Residual for conjugate gradient method
 1256:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1257:    double mX; // Solution for conjugate gradient method
 1258: 
 1259:    // Meteorological forcing
 1260:    Vector2 u_air;
 1261:    double p_air;
 1262:    double t_air;
 1263:    double q_air;
 1264:    double wind_angle;  // Wind rotation angle
 1265: 
 1266:    __device__ void setWind(Vector2 &u) {
 1267:    // Sets the wind vector taking into account the wind rotation angle
 1268:    
 1269:       const double dir = atan2(-u.x,-u.y);
 1270:       const double speed = length(u);
 1271: 
 1272:       // Calculate new u and v components with added rotation angle
 1273:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1274:    }
 1275: 
 1276: 
 1277:    __device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }
 1278: 
 1279:    __device__ double sigmaTransitionDepth(void) const;
 1280: 
 1281:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1282:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1283:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1284:    
 1285:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1286: 
 1287:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1288: 
 1289:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1290:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1291: 
 1292:    __device__ void clearMatrixRow(void) {
 1293:       // Clear the matrix row for this node
 1294:       coeffDiag = 0.0;
 1295:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1296: 
 1297:    }
 1298: 
 1299:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1300:       // Add the value to the sparse matrix for this node
 1301:       
 1302:       if (node == this) {
 1303:          coeffDiag += value;
 1304:      
 1305:       } else {
 1306:          // Search (linearly)the index of the node in the array of nodes
 1307:          // XXX: This is not efficient, see if we can improve this
 1308:          int i;
 1309:          for (i = 0; i < numNodes; i++) {
 1310:             if (nodes[i] == node) {
 1311:                break;
 1312:             }
 1313:          }
 1314:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1315:          coeffMatrix[i] += value;
 1316:       }
 1317:    }
 1318: 
 1319: 
 1320:    __device__ __inline__ void updateZCoordData(void);
 1321: 
 1322:    __device__ double compZCoord(int k) const;
 1323: 
 1324:    __device__ void updateKb(void);
 1325: 
 1326: 
 1327: 
 1328: };
