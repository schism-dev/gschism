  464: struct Element {
  465: 
  466:    // Geometry information
  467:    int idx;               // Index of the element
  468:    int i34;               // Number of sides for the element 
  469:    Side *sides[4];        // Sides of the element
  470:    Node *nodes[4];        // Nodes of the element
  471:    Element *nghbElems[4]; // Neighbors of the element
  472: 
  473:    int kb;                    // Bottom index of the element
  474:    double area;               // Area of the element
  475:    double ssign[4];           // Sign associated with each side of an element
  476:    double radius;             // Element equivalent radii
  477: 
  478:    Frame frame;
  479: 
  480:    Vector2 gradPhi[4];       // Derivatives of shape functions
  481:    Vector2 gradEta;          // Gradient of free surface elevation
  482:    Vector2 gradPr;           // Gradient of pressure    
  483:    Vector2 gradETP;          // Gradient of Earth Tidal Potential    XXXXX Really used?
  484: 
  485:    bool isDry;                // True if the element is dry
  486: 
  487:    Vector3 center;            // Element center coordinates
  488:    double xlon, ylat;         // Element center lat/lon coordinates in _degrees_
  489:    double depth;              // Depth at element (min of all nodes)
  490:    double z[nvrt];            // z-coord  (local frame - vertical up)
  491: 
  492:    // Physical information
  493:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  494: 
  495:    static const bool isblock = false;              // Always false
  496: 
  497:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  498:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  499: 
  500:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  501: 
  502:    
  503: 
  504:    double vsource;            // Volumetric source/sink term [m^3/s]
  505: 
  506:    double rho[nvrt];          // Density at each prism center
  507:    double rho_mean[nvrt];     // Mean density at each prism center
  508:    CubicSpline rho_spl;
  509:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  510:    double rho_z[nvrt];        // First derivative of density at each prism center
  511:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  512: 
  513:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  514: 
  515:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  516:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  517: 
  518:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  519:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  520: 
  521:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  522:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  523:       // Find the local index of the node in the element (0,1,2,3)
  524:       int res = __ffs((nodes[0] == node) | 
  525:                      ((nodes[1] == node) << 1) | 
  526:                      ((nodes[2] == node) << 2) | 
  527:                      ((nodes[3] == node) << 3)) - 1;
  528:       
  529:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  530:       return res;
  531:    }
  532: 
  533:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  534:       // Find the local index of the side in the element (0,1,2,3)
  535:       int res = __ffs((sides[0] == side) | 
  536:                      ((sides[1] == side) << 1) | 
  537:                      ((sides[2] == side) << 2) | 
  538:                      ((sides[3] == side) << 3)) - 1;
  539:       
  540:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  541:       return res;
  542:    }
  543: 
  544: 
  545:    __inline__ __device__ int findLevel(double z1, int k) const {
  546:       // Starting at index k, find sequentially the level that contains z
  547: 
  548:       // if z is already betweeen z[k] and z[k+1], return k
  549:       if (z1 >= z[k] && z1 < z[k+1]) return k;
  550:       else if (z1 < z[k]) { 
  551:          // Search for increasing levels
  552:          for (int kk = k; kk < nvrt - 1; kk++) {
  553:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  554:          }
  555:          return nvrt - 1;
  556:       }
  557:       else {
  558:          // Search for decreasing levels
  559:          for (int kk = k; kk > 0; kk--) {
  560:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  561:          }
  562:          return 0;
  563:       }
  564:    }
  565: 
  566:    __inline__ __device__ double z_prism(int k) const { return 0.5*(z[k+1] + z[k]); }
  567:    __inline__ __device__ double Dz(int k)      const { return z[k+1] - z[k]; }
  568: 
  569:    // Check if the element is dry using the more up-to-date elevation.
  570:    __inline__ __device__ bool isDry2(void) const;
  571: 
  572:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  573: 
  574:    __inline__ __device__ double computeSignedArea(void) const;
