 2272:    __forceinline__ __device__ void Element::projectNodeVectorsToElementFrame(Vector2 *v) const {
 2273:    // Project the vectors from the node frame to the element frame
 2274: 
 2275:  
 2276:       v[0] = nodes[0]->frame.projHorVec(v[0], frame);
 2277:       v[1] = nodes[1]->frame.projHorVec(v[1], frame);
 2278:       v[2] = nodes[2]->frame.projHorVec(v[2], frame);
 2279:       if (isQuad()) v[3] = nodes[3]->frame.projHorVec(v[3], frame);
 2280:       else          v[3] = Vector2();
 2281:    }
