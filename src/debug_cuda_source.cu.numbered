 2641:    __device__ __forceinline__ T Element::mean(T Side::* field) const {
 2642:       T values[4];
 2643:       getSideValues(field, values);
 2644:       
 2645:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2646:       if constexpr (IsVector2<T>::value && ics == 2) {
 2647: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2648:          projectSideVectorsToElementFrame(values);
 2649: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2650:       }
 2651: 
 2652:       return (values[0] + values[1] + values[2] + values[3])/i34;
