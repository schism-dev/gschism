 4314:    __global__ void computeFlowBcVelocities(double time) {
 4315: 
 4316:       SIDE_BND(sideBnd);
 4317: 
 4318:       const Side *side = sideBnd->side;
 4319:  
 4320:       const bool isDry = side->isDry;
 4321:       const bool isLand = sideBnd->segment->isLand;
 4322: 
 4323:    
 4324:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4325: 
 4326:       if (isDry || isLand) return;
 4327: 
 4328:       // For wet sides in open boundaries...
 4329:       const Vector2 n = side->n;
 4330:       const BoundarySegment *segment = sideBnd->segment;
 4331: 
 4332:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4333: 
 4334:       const int ifltype = segment->ifltype;
 4335: 
 4336:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4337:       const Vector2 r_nuth0 = r_uth0*n;
 4338: 
 4339: 
 4340:       if (ifltype == 1 || ifltype == 2) {
 4341:       
 4342:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4343: 
 4344:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4345:          
 4346:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4347:          
 4348:       } else if (ifltype == -1) { // Flather 1
 4349: 
 4350:          for (int k = 0; k < nvrt; k++) {
 4351: 
 4352:             // uth is the normal vel.; no ramp up
 4353:             const double uth = sideBnd->nuth(k);
 4354:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4355: 
 4356:             sideBnd->ubc[k] += uth*n;
 4357:          }
 4358: 
 4359:       } else if (ifltype == 3 || ifltype == 5) {
 4360:          // vnth0=0 !normal vel.
 4361: 
 4362:          Vector2 r_u1_bar = {0.0, 0.0};
 4363:          // Computes the contribution to the velocity from all tide frequencies
 4364:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4365: 
 4366:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4367:             const Vector2 umo  = sideBnd->umo(jfr); 
 4368: 
 4369:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4370:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4371:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4372:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4373:          }
 4374: 
 4375: 
 4376:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4377: 
 4378:       } // if (ifltype = 3 || ifltype == 5
 4379: 
 4380: 
 4381: 
 4382:    }
 4383: 
 4384:    __global__ void computeElevationBoundaryConditions(double time) {
 4385:       // Compute elevation essential boundary conditions 
 4386: 
 4387:       NODE_BND(nodeBnd); // Each boundary node.
 4388: 
 4389:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4390: 
 4391:       const Node *node = nodeBnd->node;
 4392:       const BoundarySegment *segment = nodeBnd->segment;
 4393:       const int iettype = segment->iettype;
 4394:       
 4395: 
 4396:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4397:       double eic = 0.0;
 4398:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4399:       else                 eic = 0.0;
 4400: 
 4401:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4402:       const double r_eth = ramp*nodeBnd->eth;
 4403:       double r_eta1_bar = 0.0;
 4404: 
 4405: 
 4406:       // Compute tide elevation
 4407:       if (iettype == 3 || iettype == 5) {   
 4408: 
 4409:          if constexpr(iloadtide==1) { // loading tide
 4410:             assert(false && "Loading tide not implemented");
 4411:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4412:          }
 4413:          
 4414:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4415: 
 4416:             const double efa  = nodeBnd->efa[jfr]; 
 4417:             const double emo  = nodeBnd->emo[jfr]; 
 4418: 
 4419:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4420:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4421:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4422: 
 4423:          } // for jfr
 4424: 
 4425:       } // if iettype
 4426: 
 4427:       switch (iettype) {
 4428:          case 1:
 4429:          case 2:
 4430:          case 4:
 4431:             nodeBnd->elbc = r_eic + r_eth;
 4432:             break;
 4433:          case 3:
 4434:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4435:             break;
 4436:          case 5:
 4437:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4438:             break;
 4439:       } // switch
 4440: 
 4441: 
 4442:       //Add inverse barometric effects
 4443:       if (iettype != 0 && inv_atm_bnd == 1) {
 4444:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4445:       }
 4446: 
 4447:    }
 4448: 
 4449: 
 4450:    __global__ void computeHorizontalViscosity(void) { 
 4451: 
 4452:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4453: 
 4454:       SIDE(side);
 4455: 
 4456:       if (side->isDry) return;
 4457: 
 4458:       for (int k = 0; k < nvrt; k++) {
 4459:          side->nuGradU[k] = {0.0, 0.0};
 4460:       }
 4461: 
 4462:       if constexpr(ihorcon == 1) {
 4463:          for (int k = side->kb; k < nvrt - 1; k++) {
 4464:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4465:             // SELFE: A semi-implicit Eulerian–Lagrangian finite-element model for cross-scale ocean circulation
 4466:             // By Zhang and Baptista.
 4467: 
 4468:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4469:             // This is a standard discretization of the Laplacian operator.
 4470:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4471:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4472:             // Gamma is hvis_coef0 in the code.
 4473:             // The value of gamma needs to be < 0.5.
 4474: 
 4475:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4476:             // side under consideration in each of the two possible elements that share the side.
 4477:             Vector2 sumU = {0.0, 0.0};
 4478:             for (int l = 0; l < 2; l++) {
 4479:                const Element *elem = side->elems[l];
 4480: 
 4481:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4482: 
 4483:                // Find the local index of the side in the element
 4484:                const int idxSide = elem->sideLocalIdx(side);
 4485:                // Find the two sides that are connected to the side under consideration
 4486:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4487:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4488: 
 4489:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4490: 
 4491:             }
 4492: 
 4493:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4494:    
 4495:          }
 4496:       }
 4497:       else if constexpr(ihorcon == 2) {
 4498:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4499:       }
 4500: 
 4501: 
 4502:    }
 4503: 
 4504: 
 4505:    __global__ void setEssentialBC(void) {
 4506:       // Set essential boundary conditions 
 4507:       NODE(node); // Each boundary node
 4508:       NodeBoundary *nodeBnd = node->nodeBnd;
 4509:       
 4510: // nodeBnd->isEssentialBC = true;      
 4511:       // Check if this node has essential BC
 4512:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4513:          // Verify BC value is valid
 4514:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4515: 
 4516:        
 4517:          // Set diagonal to 1 and zero off-diagonals
 4518:          node->coeffDiag = 1.0;
 4519: 
 4520:          for (int j = 0; j < node->numNodes; j++) {
 4521:                node->coeffMatrix[j] = 0.0;
 4522:          }
 4523:          
 4524:          // Set solution and RHS to BC value
 4525:          node->mX  = nodeBnd->elbc;
 4526:          node->qel = nodeBnd->elbc;
 4527: 
 4528:       } else {
 4529:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4530: 
 4531:          for (int j = 0; j < node->numNodes; j++) {
 4532:                Node* nbNode = node->nodes[j];
 4533:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4534:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4535:                   // Verify neighbor's BC value
 4536:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4537: 
 4538:                   // Subtract contribution to RHS
 4539:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4540:                   node->coeffMatrix[j] = 0.0;  
 4541:                }
 4542:          }
 4543:       }
 4544:    }
 4545: 
 4546: 
 4547:    __global__ void updateElevation(void) {
 4548:       NODE(node);
 4549: 
 4550:       node->eta2 = node->mX;
 4551: 
 4552:       node->updateZCoordData();
 4553:    }
