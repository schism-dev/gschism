 1972: //===============================================================================
 1973: 
 1974: 
 1975: /**
 1976:  * Find the element that contains the target point.
 1977:  * 
 1978:  * @param x0,y0,z0     Starting position coordinates
 1979:  * @param xt,yt,zt     Target position coordinates
 1980:  * @param dtb          Time step for tracking
 1981:  * @param u_int        Initial velocity components
 1982:  * @param nextElem     Starting/resulting element index
 1983:  * 
 1984:  * @return Status code of type trackExitCodes
 1985:  * 
 1986:  * Uses the Leaded Celestial Walk algorithm to find the element that contains the target point.
 1987:  * This is a variant of the Celestial Walk algorithm that goes from element A containing the starting 
 1988:  * point x0 (in one side) to element B containing the target point xt. To enforce that the next element is
 1989:  * as close the the segment AB as possible, the next point at each iteration is computed
 1990:  * along segment AB, but just after the current element.
 1991:  */
 1992: 
 1993: 
 1994: __device__ __forceinline__ bool celestialWalk(Element *&curElem, Point3 x0, Point3 &xt, const Side *origSide, Side *&lastCrossSide, int jlev) {
 1995: 
 1996:    constexpr int MAX_ITERATIONS = 40;
 1997: 
 1998:    int iter = 0;
 1999:    double fac = 0.00001;
 2000:    while (iter < MAX_ITERATIONS) {
 2001:       iter++;
 2002: 
 2003:       Bool4 isLeft, isObtuse, isBisector;
 2004:       curElem->computePredicates(toPoint2(x0), toPoint2(xt), fac, origSide, isLeft, isObtuse, isBisector, jlev);
 2005: // showPoints(x0, xt, jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2006:       Bool4 isValid = !isLeft & (!isObtuse | isBisector); // bitwise operation are overloaded
 2007: 
 2008: 
 2009:       if (isValid.none()) 
 2010:       // Inside the element if none of the edges is a valid continuation
 2011:       {
 2012:          // Just returns true and the element (curElem) is unchanged).
 2013:          // This means that the algorithm has found the element that contains the target point.
 2014:          return true;
 2015:       }
 2016:       else { // Outside the element
 2017: 
 2018:          // Outside this element. Pick the first valid exit side and cross.
 2019:          lastCrossSide = curElem->sides[isValid.firstOne()];
 2020:          Element *prevElem = curElem;
 2021:          curElem = lastCrossSide->otherElem(curElem);
 2022: 
 2023:          // If it crosses into a dry element or a boundary element, return false. This means that the track will now move 
 2024:          // along the boundary.
 2025:          if (curElem == nullptr || curElem->isDry) {
 2026:          
 2027:             curElem = prevElem;
 2028:             return false;
 2029:          }
 2030:          
 2031:       }
 2032: 
 2033:    }
 2034: 
 2035:   assert(false && "Leaded Celestial Walk: exceeded max iterations");
 2036: }
