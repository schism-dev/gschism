 3124: __device__ double Element::intPhiPhiQuad(int i1, int i2) const {
 3125:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3126:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 3127:    // The formula for the integral is:
 3128:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 3129: 
 3130:    printf("intPhiPhi: TEST\n");
 3131: 
 3132:    const Node *n0 = nodes[0];
 3133:    const Node *n1 = nodes[1];
 3134:    const Node *n2 = nodes[2];
 3135:    const Node *n3 = nodes[3];
 3136: 
 3137:    const Vector2 p0 = n0->p;
 3138:    const Vector2 p1 = n1->p;
 3139:    const Vector2 p2 = n2->p;
 3140:    const Vector2 p3 = n3->p;
 3141: assert(false && "intPhiPhiQuad:CHECK?");
 3142: 
 3143:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 3144:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 3145:    double eta_sum  = iet_n[i1] + iet_n[i2];
 3146:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 3147: 
 3148:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 3149: }
 3150:    
 3151: 
 3152: __device__ double Element::intGradPhiGradPhiQuad(int i1, int i2) const {
 3153:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3154:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 3155:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 3156:    // The formula is also based on the identity:
 3157:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 3158:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 3159: 
 3160:    printf("intGradPhiGradPhi: TEST\n");   
 3161: assert(false && "intGradPhiGradPhi:Do ICS==2");
 3162:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 3163: 
 3164:    const double x0 = nodes[0]->p.x;
 3165:    const double y0 = nodes[0]->p.y;
 3166:    const double x1 = nodes[1]->p.x;
 3167:    const double y1 = nodes[1]->p.y;
 3168:    const double x2 = nodes[2]->p.x;
 3169:    const double y2 = nodes[2]->p.y;
 3170:    const double x3 = nodes[3]->p.x;
 3171:    const double y3 = nodes[3]->p.y;
 3172: 
 3173:    double res = 0.0;
 3174:    
 3175:    // Quadrature points in xi and eta coordinates
 3176:    #pragma unroll
 3177:    for (int i = 0; i < 4; i++) {
 3178:       // For each quadrature point...
 3179: 
 3180:       const Point2 p = GaussPoint(i);
 3181:       const double eta = p.x;
 3182:       const double xi  = p.y;
 3183: 
 3184:       // Jacobian entries at the Gauss point p
 3185:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 3186:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 3187:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 3188:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 3189: 
 3190:       const double detJ = jacobianDet(p);
 3191:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3192: 
 3193:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3194:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 3195:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 3196:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 3197:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 3198: 
 3199:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3200:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3201:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3202:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3203:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3204: 
 3205:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3206:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3207:    }
 3208: 
 3209:    return res;
 3210: }
 3211: 
 3212: 
 3213: /**  Interpolate velocities at a given point (xt,yt,zt)
 3214: 
 3215:    @param xt, yt, zt: coordinates of the point to interpolate
 3216:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3217: 
 3218:    This is done in four steps:
 3219: 
 3220:    1. Find the shape coordinates for the final position in the element.
 3221:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3222:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3223:       z levels at xt, yt at each step.   
 3224:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3225:       horizontally and vertically.
 3226: **/
 3227: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3228:    // Interpolate the velocities at the point xt. 
 3229:    // This function works the same for triangular and quadrilateral elements.
 3230:    double shpCoord[4];
 3231:    Vector3 u_int;
 3232: 
 3233:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa (6)");
 3234: 
 3235:    // First step is to compute the shape coordinates of (xt,yt)
 3236: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3237:    computeShapeCoords(toVector2(xt), shpCoord, fiAnywhere, origSide);
 3238: 
 3239: 
 3240:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 3241: 
 3242:    // Second step is to find the level that contains zt
 3243:    // Uses a binary search to find the level
 3244:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3245:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3246:    int R = nvrt - 1;
 3247: 
 3248:    // Get the z coordinates at the nodes of the element at the levels L and R
 3249:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3250:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3251:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3252: 
 3253:    double zL = interpolate(shpCoord, zLAtNodes);
 3254:    double zR = interpolate(shpCoord, zRAtNodes);
 3255:    
 3256:    // Interpolates vertically the velocities
 3257:    double wght1, wght2;
 3258:    if (xt.z<=zL) {
 3259:       wght1 = 1.0;
 3260:       wght2 = 0.0;
 3261:       xt.z = zL;
 3262:    }
 3263:    else if (xt.z>=zR) {
 3264:       wght1 = 0.0;
 3265:       wght2 = 1.0;
 3266:       xt.z = zR;
 3267:    }
 3268:    else {
 3269:       // Perform a binary search to find the levels between L and R that contain xt.z
 3270:       while (R - L > 1) {
 3271:          int M = (L + R) / 2.0;
 3272: 
 3273:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3274:          double zM = interpolate(shpCoord, zMAtNodes);
 3275:          if (zM < xt.z) 
 3276:          {
 3277:             L = M;
 3278:             zL = zM;
 3279:          }
 3280:          else 
 3281:          {
 3282:             R = M;
 3283:             zR = zM;
 3284:          }
 3285:       }
 3286:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3287:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3288: 
 3289:       wght2 = (xt.z - zL)/(zR - zL);
 3290:       wght1 = 1.0 - wght2;
 3291: 
 3292:    }
 3293: 
 3294: // printf("HEREEEEEE 3, wght1 = %.17f, wght2 = %.17f, shpCoord = (%.17f, %.17f, %.17f, %.17f)\n", wght1, wght2, shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 3295:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3296:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3297:    Vector2 uv = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3298:    double w   = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3299: 
 3300:    // Project the velocity from the local frame to the origSide frame
 3301:    if constexpr(ics == 2) uv = frame.projHorVec(uv, origSide->frame);
 3302:    u_int = {uv.x, uv.y, w};
 3303: 
 3304:    // Neither of the interpolated velocities should be NaN
 3305:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3306: 
 3307:    return u_int;
 3308: 
 3309: }
 3310: 
 3311: 
 3312: 
 3313: 
 3314: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3315: 
 3316:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3317:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3318:    const Node *n1 = side->n1;
 3319:    const Node *n2 = side->n2;
 3320: 
 3321:    bool n1_match = (n1->nodeBnd->segment == segment);
 3322:    bool n2_match = (n2->nodeBnd->segment == segment);
 3323: 
 3324:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3325:    if (n1_match && n2_match) {
 3326:       return 0.5;
 3327:    } else if (n1_match) {
 3328:       return 1.0;
 3329:    } else if (n2_match) {
 3330:       return 0.0;
 3331:    }
 3332: 
 3333:    return 0.0;
 3334: }
 3335: 
 3336: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3337: 
 3338: 
 3339: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 3340: 
 3341:    const double w1 = getBoundaryArrayValueWeight();
 3342:    const double w2 = 1.0 - w1;
 3343:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3344:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3345: 
 3346:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 3347: }
 3348: 
 3349: 
 3350: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 3351:    const double w1 = getBoundaryArrayValueWeight();
 3352:    const double w2 = 1.0 - w1;
 3353:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3354:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3355: 
 3356:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 3357: 
 3358: }
 3359: 
 3360: 
 3361: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 3362:    // Returns the value of the velocity at the side center
 3363:    const double w1 = getBoundaryArrayValueWeight();
 3364:    const double w2 = 1.0 - w1;
 3365:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3366:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3367: 
 3368:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 3369: }
 3370: 
 3371: 
 3372: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 3373:    // Returns the value of the normal component of the velocity at the side center
 3374:    const double w1 = getBoundaryArrayValueWeight();
 3375:    const double w2 = 1.0 - w1;
 3376:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3377:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3378: 
 3379:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 3380: }
