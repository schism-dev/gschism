 4032: 
 4033: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 4034:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 4035:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 4036: 
 4037: 
 4038:    NODE(node1);
 4039: 
 4040:    node1->clearMatrixRow();
 4041:    node1->qel = 0.0;
 4042: 
 4043:    // THIS IS FOR STRUCTURES XXX
 4044:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 4045: 
 4046:    
 4047:    for (int j=0; j<node1->numElements; j++) {
 4048:       // For each element connected to the node...
 4049: 
 4050:       Element *elem = node1->elements[j];
 4051: 
 4052: 
 4053: 
 4054:       // Compute the average gravity
 4055:       const double grav3 = elem->mean(&Node::grav2);
 4056: 
 4057:       // Look at the documentation for the description of the terms in the following integrals
 4058: 
 4059:       // Integral I_1 
 4060:       // \bar{\breve{H}} 
 4061:       const double hhatb = elem->mean(&Side::hhat);        
 4062: 
 4063:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 4064: 
 4065:       const int id1 = elem->nodeLocalIdx(node1); 
 4066:       const double area = elem->area;
 4067: 
 4068:       if (elem->isTri()) {
 4069: 
 4070:          // To clarify the notation in this section: 
 4071:          //   i stands for the node under consideration (node1)
 4072:          //   j (node2) and k (node3) are the other nodes of the triangle.
 4073:          const int id2 = elem->nxq(1 + id1);
 4074:          const int id3 = elem->nxq(2 + id1);
 4075:          Node *node2 = elem->nodes[id2];
 4076:          Node *node3 = elem->nodes[id3];
 4077: 
 4078:          Point2 x1, x2, x3;
 4079:          elem->getLocalHorizontalNodePositionsTri(x1, x2, x3, id1);
 4080: 
 4081: 
 4082:          // integral of phi_i*phi_j
 4083:          const double ipp_ii = (1.0/6.0 )*area;
 4084:          const double ipp_ij = (1.0/12.0)*area;
 4085:          const double ipp_ik = (1.0/12.0)*area;
 4086: 
 4087:          // integral of [(grad phi_i) * (grad phi_j)]
 4088:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 4089:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 4090:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 4091: 
 4092:          // Computes the different components of integral I_1 of each node with respect to node i.
 4093:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4094:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4095:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4096: 
 4097:          node1->addToSparseMatrix(node1, I1_ii);
 4098:          node1->addToSparseMatrix(node2, I1_ij); 
 4099:          node1->addToSparseMatrix(node3, I1_ik);
 4100: 
 4101:       }
 4102:       else { // Quad
 4103:          // XXX IMPLEMENT THIS
 4104:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 4105: 
 4106:          // To clarify the notation in this section: 
 4107:          //   i stands for the node under consideration (node1)
 4108:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 4109:          const int id2 = elem->nxq(1 + id1);
 4110:          const int id3 = elem->nxq(2 + id1);
 4111:          const int id4 = elem->nxq(3 + id1);
 4112:          Node *node2 = elem->nodes[id2];
 4113:          Node *node3 = elem->nodes[id3];
 4114:          Node *node4 = elem->nodes[id4];         
 4115: 
 4116:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 4117:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 4118:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 4119:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 4120:          const double ipp_il = elem->intPhiPhi(id1, id4);
 4121: 
 4122:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 4123:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 4124:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 4125:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 4126:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 4127: 
 4128:          // Computes the different components of integral I_1 of each node with respect to node i.
 4129:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4130:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4131:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4132:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 4133: 
 4134:          node1->addToSparseMatrix(node1, I1_ii);
 4135:          node1->addToSparseMatrix(node2, I1_ij); 
 4136:          node1->addToSparseMatrix(node3, I1_ik);
 4137:          node1->addToSparseMatrix(node4, I1_il);
 4138:   
 4139:       } 
 4140: 
 4141:  
 4142:       // Integral I_4
 4143:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 4144:       // Where
 4145:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 4146: 
 4147:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 4148:       // of U over the element.
 4149:       Vector2 U = {0.0, 0.0};
 4150:       for (int m=0; m < elem->i34; m++) {      
 4151:          const Side *side = elem->sides[m];
 4152: 
 4153:          if constexpr(ics == 1) U += side->U; 
 4154:          else                   U += side->frame.projHorVec(side->U, elem->frame);  // In global coordinates, we must project the side velocity to the element frame
 4155: 
 4156:       }
 4157:       U = U/elem->i34;
 4158: 
 4159: 
 4160:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 4161: 
 4162: 
 4163:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 4164:       const double I_4_1 = dot(gradPhi_1, U);
 4165: 
 4166: 
 4167:       // Integral of \nabla\phi_i \cdot \pmb{E}
 4168:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 4169: 
 4170:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 4171: 
 4172:       // Additional terms 
 4173:       double vnorm = 0.0;
 4174:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 4175:          Vector3 ubed = {0.0, 0.0, 0.0};
 4176:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 4177: 
 4178:          Vector3 gradP = {0.0, 0.0, 1.0};
 4179:          for (int m=0; m < elem->i34; m++) {
 4180:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 4181:            gradP += toVector3(gradP_2D, 0.0);
 4182:          }   
 4183:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 4184:       } // imm==2
 4185: 
 4186:       if (elem->isTri()) {
 4187:          for (int l=0; l<3; l++) {
 4188: 
 4189:             Node *node = elem->nodes[l];
 4190: 
 4191:             double fac = (node == node1) ? 2.0 : 1.0;
 4192:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 4193:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 4194:            
 4195:          }
 4196: 
 4197: 
 4198:          if (!elem->isDry) {
 4199:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 4200: 
 4201:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 4202: 
 4203:          }
 4204: 
 4205:       } // isTri
 4206:       else { // isQuad
 4207:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 4208:          // for (int l=0; l<4; l++) {
 4209:          //   const Node *node = elem->nodes[l];
 4210: 
 4211:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 4212:          //   else        tmp2 = node->bdef2 - node->bdef1;
 4213: 
 4214:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 4215:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 4216:          // }
 4217: 
 4218:       } // isQuad
 4219: 
 4220: 
 4221:      node1->qel += (dt/elem->i34)*elem->vsource;
 4222:       
 4223: 
 4224:    } // for all elements connected to the node
 4225:    
 4226: 
 4227:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 4228:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 4229:    NodeBoundary *nodeBnd = node1->nodeBnd;
 4230:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 4231:       // If it is an open boundary node...
 4232: 
 4233:       // At least one open bnd side, maybe two
 4234:       for (int l=0; l<2; l++) { 
 4235: 
 4236:          // Gets each of the sides sharing the node. 
 4237:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 4238: 
 4239:        
 4240: 
 4241:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 4242:          if (sideBnd != nullptr) {
 4243:             // If the side is on a boundary...
 4244: 
 4245:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 4246: 
 4247:             // Get the boundary segment
 4248:             const BoundarySegment *sideSegment = sideBnd->segment;
 4249:             const Side *side = sideBnd->side;
 4250: 
 4251:             // Integral I_3
 4252:             if (sideSegment->ifltype != 0) {
 4253:             // Natural or Flather b.c.
 4254: 
 4255:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4256:                // especially for Flather b.c.
 4257:                double ri3 = 0.0;
 4258:                if (!side->isDry) {
 4259:                   // If the side is not dry
 4260:                   
 4261:                   // Computes the side flux of (uth, vth)
 4262:                   double Vn = 0.0;
 4263:                   for (int k = side->kb; k < nvrt - 1; k++) {
 4264:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4265:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4266: 
 4267:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 4268:                   }
 4269: 
 4270:                   ri3 = 0.5*side->len*Vn;
 4271:                }
 4272: 
 4273:                if (sideSegment->ifltype == -1) { // Flather 1
 4274: 
 4275:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4276:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4277: 
 4278:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4279:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4280:                   
 4281:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4282:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4283: 
 4284:                } 
 4285:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4286:                   // Reset ri3
 4287:                   ri3 = 0.0;
 4288: 
 4289:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4290: 
 4291:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4292: 
 4293:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4294:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4295: 
 4296:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4297:                   node1->addToSparseMatrix(node1, con0*2.0);
 4298:                   node1->addToSparseMatrix(node2, con0);
 4299: 
 4300:                } // if Flather or Discharge
 4301: 
 4302:                node1->qel -= thetai*dt*ri3;
 4303: 
 4304: 
 4305:             } // I_3
 4306:           
 4307: 
 4308:             // Integral I_5
 4309:             if(!side->isDry) {
 4310: 
 4311:                const double Unbar = dot(side->U, side->n);
 4312:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 4313: 
 4314:             } // I_5
 4315: 
 4316:          } // if is boundary side
 4317: 
 4318:       } // for l
 4319: 
 4320:    } // if isbnd
 4321: 
 4322: 
 4323: }
 4324: 
 4325: 
 4326: 
 4327: extern "C" {
 4328:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 4329:                                   int* indices, int* indptr) {
 4330: 
 4331:       NODE(node);
 4332:       
 4333:       const int idx = node->idx;
 4334:       
 4335:       // Computes the index in the nzz array      
 4336:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 4337: 
 4338: 
 4339:       indptr[idx] = nzzIdx;
 4340:       indices[nzzIdx] = idx;
 4341: 
 4342:       data_d[nzzIdx]    = node->coeffDiag;
 4343: 
 4344:       b_d[idx] = node->qel;
 4345: 
 4346:       for (int k = 0; k < node->numNodes; ++k) {
 4347:          const Node* nb = node->nodes[k];
 4348: 
 4349:          const int j = nb->idx;
 4350: 
 4351:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 4352: 
 4353:          indices[nzzIdx + k + 1] = j;
 4354:       }
 4355: 
 4356:  
 4357:    }
 4358: 
 4359: 
 4360: 
 4361:    __global__ void solverCopyResult(double* x) {
 4362:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 4363:       NODE(node);
 4364:       const int idx = node->idx;
 4365: 
 4366:       node->mX = x[idx];
