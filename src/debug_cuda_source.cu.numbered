 7164: 
 7165: __global__ void computeMatrixProductAndDotProducts() {
 7166:    // Computes A*p, r'Mr and p'Ap
 7167: 
 7168:    // 1) shared buffer: first half for rMr, second for pAp
 7169:    __shared__ double sdata[2*BLOCK_SIZE];
 7170:    double* s_rMr = sdata;
 7171:    double* s_pAp = sdata + BLOCK_SIZE;
 7172: 
 7173:    const int tid = threadIdx.x;
 7174: 
 7175:    double l_pAp = 0.0;
 7176: 
 7177:    s_rMr[tid] = 0.0;
 7178:    s_pAp[tid] = 0.0;
 7179: 
 7180:    // 2) get your node pointer
 7181:    // NODE(node);   
 7182:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7183:    Node *node = &(mesh->localNodeData[idx_node]); 
 7184:       if (idx_node < mesh->np) {
 7185: 
 7186:       const double diag = node->coeffDiag;
 7187:       const double r    = node->mR;
 7188:       const double p    = node->mP;  
 7189: 
 7190:       // apply preconditioner on the fly:
 7191:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7192: 
 7193:       // 4) compute Ap = A.p
 7194:       double Ap = node->coeffDiag * node->mP;
 7195:       for (int j = 0; j < node->numNodes; ++j) {
 7196:          const Node *nbNode = node->nodes[j];
 7197:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7198: 
 7199:       }
 7200: 
 7201:       node->mAp = Ap;
 7202:       
 7203: 
 7204:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7205:       // const double l_rMr = r*Mr;  // r'Mr
 7206:       l_pAp = p*Ap;  // p'Ap
 7207: 
 7208: 
 7209:    }
 7210: 
 7211:    // 6) write into shared mem
 7212:    // s_rMr[tid] = l_rMr;
 7213:    s_pAp[tid] = l_pAp;
 7214: 
 7215:    __syncthreads();
 7216: 
 7217:    // 7) block-wide tree reduction
 7218:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7219:       if (tid < stride)  {
 7220:          s_pAp[tid] += s_pAp[tid + stride];
 7221:       }
 7222:       __syncthreads();
 7223:    }
 7224: 
 7225:    // 8) thread 0 atomically accumulates into the globals
 7226:    // XXX: This is slower than it needs to be, but it is simple and works
 7227:    if (tid == 0) {
 7228:       atomicAdd(pAp, s_pAp[0]);
 7229:    }
 7230: 
 7231: 
 7232: }
 7233: 
 7234: 
 7235: __global__ void updateSolutionAndDotProducts(void) {
 7236:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7237: 
 7238:    const int tid = threadIdx.x;
 7239: 
 7240:    s_rMr[tid] = 0.0;
 7241: 
 7242:    // get node & bounds-check:
 7243:    NODE(node);
 7244: 
 7245:    
 7246:    // Compute alpha
 7247:    const double alpha = (*rMr_old)/(*pAp); 
 7248: 
 7249: 
 7250:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7251: 
 7252: 
 7253:    // load scalars
 7254:    const double diag = node->coeffDiag;
 7255:    const double p    = node->mP;
 7256:    const double Ap   = node->mAp;
 7257:    const double x    = node->mX;
 7258:    const double r    = node->mR;
 7259:    
 7260:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7261: 
 7262:    // 1) update solution & residual
 7263:    const double x_new = x + alpha*p;
 7264:    const double r_new = r - alpha*Ap;
 7265:    node->mX = x_new;
 7266:    node->mR = r_new;
 7267: 
 7268:    // 2) apply Jacobi preconditioner on the fly
 7269:    const double Mr_new = r_new/diag;
 7270: 
 7271: 
 7272:    // 3) local contributions for the two dot-products
 7273:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7274: 
 7275:    // 4) write into shared-mem
 7276:    s_rMr[tid] = l_rMr;
 7277: 
 7278:    __syncthreads();
 7279: 
 7280: 
 7281:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7282:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7283:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7284:       __syncthreads();
 7285:    }
 7286: 
 7287:    // 6) thread 0 atomically folds into the global accumulators
 7288:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7289: 
 7290: 
 7291: }
 7292: 
 7293: 
 7294: __global__ void updateSearchDirection() {
 7295: 
 7296:     NODE(node);
 7297: 
 7298:     // recompute z on-the-fly
 7299:     const double z = node->mR / node->coeffDiag;
 7300:     const double p = node->mP;
 7301: 
 7302:     const double beta = (*rMr_new)/(*rMr_old);
 7303: 
 7304: 
 7305:     // p =z + beta*p
 7306:     node->mP = z + beta*p;
 7307: 
 7308: }
 7309: 
 7310: __global__ void initializeScalars(double *scalars) {
 7311: 
 7312:    // These point to a cupy array in the host code
 7313:    rMr_old = scalars + 0;
 7314:    rMr_new = scalars + 1;
 7315:    pAp     = scalars + 2;
 7316: }
 7317: 
 7318: __global__ void initializePreconditionedResidual(void) {
 7319: 
 7320:     __shared__ double s_rMr[BLOCK_SIZE];  
 7321: 
 7322:     s_rMr[threadIdx.x] = 0.0;
 7323: 
 7324:     NODE_ALL(node, valid);
 7325:     const int tid = threadIdx.x;
 7326:     // For the first iteration:
 7327:     // 1. Initial solution x = 0 (already set)
 7328:     // 2. Initial residual r = b (stored in qel)
 7329:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7330: 
 7331: // XXX we should use the guess solution here    
 7332: 
 7333:     double l_rMr = 0.0;
 7334:     if (valid) {
 7335:       // Set initial residual r = b (from qel)
 7336:       node->mR = node->qel;
 7337: 
 7338:       // Compute z = M^-1 * r (preconditioned residual)
 7339:       const double z = node->mR / node->coeffDiag;
 7340: 
 7341:       // Set initial search direction p = z
 7342:       node->mP = z;
 7343: 
 7344:       // Initialize other variables needed for CG
 7345:       node->mX = 0.0;  // Initial solution
 7346:       node->mAp = 0.0; // Will be computed in first iteration
 7347: 
 7348: 
 7349:       // Computes the first r'Mr (reduction)
 7350:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7351:     }
 7352:     // 4) write into shared-mem
 7353:     s_rMr[tid] = l_rMr;
 7354: 
 7355:     __syncthreads();
 7356: 
 7357: 
 7358:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7359:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7360:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7361:         __syncthreads();
 7362:     }
 7363: 
 7364:     // 6) thread 0 atomically folds into the global accumulators
 7365:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7366: 
 7367:     *rMr_old = 0.0;
 7368:     *pAp = 0.0;
 7369: }
 7370: 
 7371: 
 7372: 
 7373: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7374:    Element *elems = mesh->localElemData;
 7375: 
 7376:    *addr = elems;
 7377:    *sizeElement = sizeof(Element);
 7378:    switch (varCode) {
 7379:       case (int)VarCode::z:
 7380:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7381:          *sizeType = sizeof(double);
 7382:          break;
 7383:       case (int)VarCode::x:
 7384:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7385:          *sizeType = sizeof(Vector2);
 7386:          break;
 7387:       case (int)VarCode::area:
 7388:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7389:          *sizeType = sizeof(double);
 7390:          break;
 7391:       case (int)VarCode::depth:
 7392:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7393:          *sizeType = sizeof(double);
 7394:          break;
 7395:       case (int)VarCode::radius:
 7396:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7397:          *sizeType = sizeof(double);
 7398:          break;
 7399:       case (int)VarCode::lonlat:
 7400:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 7401:          *sizeType = sizeof(double);
 7402:          break;
 7403:       case (int)VarCode::ghat:
 7404:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7405:          *sizeType = sizeof(Vector2);
 7406:          break;
 7407:       case (int)VarCode::kb:
 7408:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 7409:          *sizeType = sizeof(int);
 7410:          break;
 7411:       case (int)VarCode::isdry:
 7412:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 7413:          *sizeType = sizeof(int);
 7414:          break;            
 7415:       case (int)VarCode::w:
 7416:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 7417:          *sizeType = sizeof(double);
 7418:          break;
 7419:       case (int)VarCode::FaceIndices:
 7420:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 7421:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 7422:          *sizeType = sizeof(Node);
 7423:          break;
 7424:       default:
 7425:          *offset = -1;
 7426:    }
 7427: }
