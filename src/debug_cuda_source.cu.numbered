 6920:    __global__ void zeroNodalVelocities(void) {
 6921:       NODE(node);
 6922: 
 6923:       for (int k = 0; k < nvrt; k++) {
 6924:          node->u2[k]   = {0.0, 0.0};
 6925:          node->w2[k]   = 0.0;
 6926:          node->utmp[k] = {0.0, 0.0};         
 6927:       }
 6928:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6929:    }
 6930:  
 6931: 
 6932:    __global__ void computeNodalVerticalVelocities1(void) {
 6933:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6934:    // Adds the element's vertical velocity times the element's area.
 6935:       ELEM(elem);
 6936: 
 6937:       for (int j = 0; j < elem->i34; j++) {
 6938:          Node *node = elem->nodes[j];
 6939: 
 6940:          for (int k = node->kb; k < nvrt; k++) {
 6941:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6942:          }
 6943:          atomicAdd(&(node->tmp.d), elem->area);
 6944:       }
 6945:    }
 6946: 
 6947:    __global__ void computeNodalVerticalVelocities2(void) {
 6948:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6949:    // Divides by the total area of the elements sharing the    node.
 6950:       NODE(node);
 6951: 
 6952: 
 6953:       const double invArea = 1.0 / node->tmp.d;
 6954:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = invArea*node->w2[k];  // node->tmp.d contains the total area of the elements sharing the node
 6955: 
 6956:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6957:    }
 6958: 
 6959: 
 6960:    __global__ void computeNodalHorizontalVelocities1(void) {
 6961: 
 6962:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6963: 
 6964:       ELEM(elem);
 6965: 
 6966:       if (elem->isDry) return;
 6967: 
 6968:       const int kb = elem->kb;
 6969:       const bool isTri = elem->isTri();
 6970: 
 6971:       if constexpr(indvel <= 0) {
 6972:          // Assuming discontinous hvel.
 6973: 
 6974:          if (isTri) { // For triangles
 6975:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6976:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6977: 
 6978:             for (int j = 0; j < 3; j++) {
 6979:                // For every node of the triangle...
 6980:                Node *node = elem->nodes[j];
 6981: 
 6982:                if (node->isDry) continue;
 6983: 
 6984:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 6985:                const Side *s2 = elem->sides[(j + 1) % 3];
 6986:                const Side *s3 = elem->sides[(j + 2) % 3];
 6987: 
 6988:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 6989: 
 6990:                atomicAdd(&(node->tmp.i), 1);
 6991: 
 6992:                for (int k = kb; k < nvrt; k++)  {
 6993:                   Vector2 s1u2 = s1->u2[k];
 6994:                   Vector2 s2u2 = s2->u2[k];
 6995:                   Vector2 s3u2 = s3->u2[k];
 6996: 
 6997:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 6998:                   if constexpr(ics == 2) {
 6999:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 7000:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 7001:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 7002:                   }
 7003: 
 7004:                   Vector2 u = s2u2 + s3u2 - s1u2; // u interpolated linearly at node j.   
 7005:                   u = clampVelocity(u);
 7006:                   atomicAdd(&(node->utmp[k].x), u.x);
 7007:                   atomicAdd(&(node->utmp[k].y), u.y);
 7008: 
 7009:                }
 7010: 
 7011:             }
 7012:          }
 7013:          else { // For quads
 7014:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 7015: 
 7016:          }
 7017: 
 7018:       }
 7019:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 7020:       
 7021:    }
 7022: 
 7023: 
 7024:    __global__ void computeNodalHorizontalVelocities2(void) {
 7025:       NODE(node);
 7026: 
 7027:       const int nodeCount = node->tmp.i;
 7028: 
 7029:       if (nodeCount == 0) 
 7030:       {
 7031:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 7032:          return;
 7033:       }
 7034: 
 7035:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 7036:       
 7037:       const int kb = node->kb;
 7038: 
 7039:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 7040:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 7041:       
 7042:       
 7043:    }   
 7044: 
 7045:  
