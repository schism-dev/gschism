 1551: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1552:    // Computes the 3D normal vector to the element at level k
 1553:    // Returns the normal vector and the area of the element
 1554: 
 1555:       if (isTri()) {
 1556:          // For triangles...
 1557: 
 1558:          // Gets the normal vector to the element (with a length equal to twice the area)
 1559:          if constexpr(ics==1) {
 1560:             const int kb0 = max(k, nodes[0]->kb);
 1561:             const int kb1 = max(k, nodes[1]->kb);
 1562:             const int kb2 = max(k, nodes[2]->kb);
 1563: 
 1564:             const Vector3 n20 = nodes[2]->p3(k) - nodes[0]->p3(k);
 1565:             const Vector3 n10 = nodes[1]->p3(k) - nodes[0]->p3(k);
 1566:             
 1567:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1568:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1569:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1570:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1571: 
 1572:             area3D = sqrt(nx*nx + ny*ny + nz*nz);
 1573: 
 1574:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1575: 
 1576:             return {nx/area3D, ny/area3D, nz/area3D};
 1577: 
 1578:            
 1579:          }
 1580:          else {  // lat/lon
 1581:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1582: 
 1583:          } // if ics
 1584:       }
 1585:       else {
 1586:          // For quads...
 1587: 
 1588:          assert(false && "Element normal vector: quads not yet implemented");
 1589: 
 1590: 
 1591:       }
 1592:    }
 1593: 
 1594: /**
 1595:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1596:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1597:    If the segment is completely inside the element, then it returns true.
 1598: 
 1599:    This function assumes:
 1600:    - The initial point is on a side of the element. 
 1601:    - Its position is given by parameter t in the range [0,1].
 1602:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1603:       intersects the element (elements are convex).
 1604: 
 1605:    To find the intersection point, this function does the following:
 1606:    - it finds the intersection of the line segment with all the element side lines,
 1607:       except for the one that contains the initial point.
 1608:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1609:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1610:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1611:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1612:       track segment is almost parallel to the element side line.
 1613: 
 1614:    Inputs:
 1615:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1616:    @param x2, y2: other end of the line segment
 1617: 
 1618:    Outputs:
 1619:    @param side:  side that intersects the line segment (input and output)
 1620:    @param nextElement (output): element that contains the intersection point
 1621:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1622:    @param zint (input/output): Vertical coordinate of the intersection point
 1623: 
 1624:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1625:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1626:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1627: 
 1628:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1629:    (Delta) being zero.
 1630: 
 1631:    The intersection2 point happens when:
 1632:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1633:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1634:    
 1635:    Assumption: the 4 points (including those of the side segment) are different.
 1636:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1637:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1638:    If true, (xIntersect,yIntersect) is the intersection.				
 1639:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1640: **/
 1641: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1642:                                               double &t, double& tIntersect) {
 1643: 
 1644:    double closest_intersect_t = 1e10;
 1645:    bool found_intersection = false;
 1646: 
 1647:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1648:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1649:    const Point2 x1 = side->point(t);
 1650:    
 1651: 
 1652:    Side *nextSide = nullptr;
 1653:    for (int i = 0; i < i34; i++) {
 1654: 
 1655:       // Element's i-th side 
 1656:       Side *side2 = sides[i];
 1657: 
 1658:       // Skip the side that contains the initial point
 1659:       if (side2 == side) continue;
 1660: 
 1661:       // (x3,y3)-(x4,y4) is the element side line
 1662:       const Point2 x3 = side2->n1->p2();
 1663:       const Point2 x4 = side2->n2->p2();
 1664: 
 1665:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1666:       const double delta = cross(x2 - x1, x3 - x4);
 1667: 
 1668:       if (delta != 0.0) {
 1669: 
 1670:          const double delta1 = cross(x3 - x1, x3 - x4);
 1671:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1672: 
 1673:          // Solves the two linear equations for tt1 and tt2
 1674:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1675:          const double tt2 = delta2/delta;
 1676: 
 1677:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1678:             closest_intersect_t = min(closest_intersect_t, tt1);
 1679:             nextSide = side2;
 1680: 
 1681:             nextElement = nextSide->otherElem(this);
 1682:             tIntersect = max(small, min(tt1, 1.0-small));
 1683:             t = tt2;
 1684: 
 1685:             found_intersection = true;
 1686:          }
 1687:       
 1688:       }
 1689: 
 1690:    }
 1691:    
 1692: printf("AAA 1, found_intersection = %d, nextSide = %p, nextElement = %p\n", found_intersection, nextSide, nextElement);
 1693: 
 1694: 
 1695:    // found_intersection should always be true, since we checked all the sides.  
 1696:    side = nextSide;
 1697: // if (found_intersection) {
 1698: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1699: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1700: // }   
 1701:    // if (!found_intersection) {
 1702:    //    // Check if the segment is parallel to the initial side
 1703:    //    printf("XXX segment: side = %p\n", side);
 1704:    //    printf("XXX %f\n", dot(x2 - x1, side->n1->p2() - side->n2->p2()));
 1705:    //    if (abs(dot(x2 - x1, side->n1->p2() - side->n2->p2())) < small) {
 1706:    //       assert(false && "Segment is parallel to the initial side");
 1707:    //       found_intersection = true;
 1708:    //       nextElement = side->otherElem(this);
 1709:    //       tIntersect = t;
 1710:    //       t = 0.0;
 1711:    //       found_intersection = true;
 1712:    //    }
 1713:    // }
 1714:    return found_intersection;
 1715: }
 1716: 
 1717: 
 1718: 
 1719: 
 1720: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1721:                                               double &t, double& tIntersect) {
 1722: 
 1723:    double closest_intersect_t = 1e10;
 1724:    bool found_intersection = false;
 1725: 
 1726: double minDelta = 1e10; 
 1727: double btt1 = 1e10, btt2;
 1728:    for (int i = 0; i < i34; i++) {
 1729: 
 1730:       Side *side2 = sides[i];
 1731: 
 1732:       // (x3,y3)-(x4,y4) is the element side line
 1733:       const Point2 x3 = side2->n1->p2();
 1734:       const Point2 x4 = side2->n2->p2();
 1735: 
 1736:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1737:       const double delta = cross(x2 - x1, x3 - x4);
 1738: 
 1739:       if (abs(delta) > 0) {
 1740: 
 1741:          const double delta1 = cross(x3 - x1, x3 - x4);
 1742:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1743: 
 1744:          // Solves the two linear equations for tt1 and tt2
 1745:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1746:          const double tt2 = delta2/delta;
 1747: 
 1748: if (abs(tt1) < abs(btt1)) {
 1749:    minDelta = abs(delta);
 1750:    btt1 = tt1;
 1751:    btt2 = tt2;
 1752: }
 1753: 
 1754: if (idx == 0) printf("RRRRRR delta = %e, delta1 = %e, delta2 = %e, tt1 = %e, tt2 = %e\n", delta, delta1, delta2, tt1, tt2);
 1755:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1756:             closest_intersect_t = min(closest_intersect_t, tt1);
 1757:             side = side2;
 1758:             nextElement = side->otherElem(this);
 1759:             t = tt2;
 1760:             tIntersect = max(small, min(tt1, 1.0-small));
 1761:             found_intersection = true;
 1762:          }
 1763:       
 1764:       }
 1765:       else {  // parallel segments
 1766:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1767:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1768: 
 1769:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1770: 
 1771:          // const double dist = dot(x1 - x3, side2->n);
 1772:          // if (abs(dist) < small*length(x3 - x4)) {
 1773:          //    const double2 unitarySide = normalize(x4 - x3);
 1774:          //    const double len = dot(x2 - x1, unitarySide);
 1775:          //    t = t + len;
 1776:          //    t = max(0.0, min(t, 1.0));
 1777:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1778: 
 1779: 
 1780:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1781:          //    // t = tt2;
 1782:          //    found_intersection = true;
 1783:          // }
 1784:       }
 1785: 
 1786: 
 1787:    }
 1788: 
 1789:    if (!found_intersection) {
 1790:       
 1791: if (idx == 0) printf("ZZ No intersection found:\n"
 1792:            "Element %d\n"
 1793:            "in = %d\n"
 1794:            "minDelta = %e\n"
 1795:            "tt1 = %e, tt2 = %e\n"
 1796:            "segment: (%f, %f)-(%f, %f)\n"
 1797:            "Vertices:\n"
 1798:          //   "  Nodes nextElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n"
 1799:            "  Nodes curElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n",
 1800:            IDX(nextElement),
 1801:            (btt1 >= -small && btt2 >= -small && btt2 <= 1.0 + small && btt1 <= 1.0 + small),
 1802:            minDelta,
 1803:            btt1, btt2,
 1804:            x1.x, x1.y,
 1805:            x2.x, x2.y,
 1806:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1807:          //   nextElement->nodes[1]->p.x, nextElement->nodes[1]->p.y,
 1808:          //   nextElement->nodes[2]->p.x, nextElement->nodes[2]->p.y,
 1809:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1810:            nodes[0]->p.x, nodes[0]->p.y,
 1811:            nodes[1]->p.x, nodes[1]->p.y,
 1812:            nodes[2]->p.x, nodes[2]->p.y,
 1813:            nodes[0]->p.x, nodes[0]->p.y);
 1814: 
 1815:    }
 1816: 
 1817:    // assert(found_intersection && "No intersection found");
 1818: 
 1819:    // found_intersection should always be true, since we checked all the sides.  
 1820:    return found_intersection;
 1821: }
