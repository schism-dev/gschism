 4340: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 4341:                 double *node_coords, double *node_coords_ll, bool use_ll,
 4342:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 4343:                 int *isdel, int *isidenode, int *isbnd,
 4344:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 4345:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4346:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4347:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4348:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4349:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 4350:                 double *drag, double *roughness,
 4351:                 double *emo, double *efa, 
 4352:                 double *umo, double *ufa, 
 4353:                 double *vmo, double *vfa) {
 4354: 
 4355:    printf("Populating mesh for partition %d\n", partNum);
 4356: 
 4357:    // XXXXXX THIS function does almost nothing. 
 4358: 
 4359:    nbs = *sharedIdxSideBoundary + 1;
 4360:    nbp = *sharedIdxNodeBoundary + 1;
 4361: 
 4362:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 4363: 
 4364: }
