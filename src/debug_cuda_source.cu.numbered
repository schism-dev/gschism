 6919:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6920:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6921:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6922:                   endif
 6923:                 enddo  !vertical layers
 6924:               enddo !j=1,i34(ie) ! side
 6925:             endif !order of accuracy
