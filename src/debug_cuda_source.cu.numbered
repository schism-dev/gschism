 7664: __global__ void getStructSizes(int* sizes)  {
 7665:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 7666:       sizes[0] = (int)sizeof(Node);
 7667:       sizes[1] = (int)sizeof(Element);
 7668:       sizes[2] = (int)sizeof(Side);
 7669:       sizes[3] = (int)sizeof(NodeBoundary);
 7670:       sizes[4] = (int)sizeof(SideBoundary);
 7671:       sizes[5] = (int)sizeof(BoundarySegment);
 7672: }
