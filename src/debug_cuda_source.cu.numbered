 1132: struct Node {
 1133: 
 1134:    // Geometry information
 1135:    int idx;        // Index of the node
 1136:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1137:    int numNodes;   // Number of nodes neighbors of this node
 1138: 
 1139:    Element **elements; // Array of pointers to the elements that share this node
 1140:    int numElements;    // Number of elements that share this node
 1141: 
 1142:    int numSides;       // Number of sides that are connected to this node
 1143: 
 1144:    Point3 p;
 1145:    Vector3 u2[nvrt];
 1146:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1147:    double z[nvrt];
 1148:    double lon, lat;
 1149:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1150:    double depth;
 1151: 
 1152:    int kb;       // Bottom index of the node
 1153: 
 1154:    bool isDry;     // True if the node is dry
 1155: 
 1156:    int iadv;     // Advection flag
 1157: 
 1158:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1159:                           // this is nullptr
 1160: 
 1161:    TempVar tmp; // Temporary variable to store different types of variables
 1162: 
 1163:    // Physical information
 1164:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1165:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1166: 
 1167:    double rho[nvrt];     // Density
 1168:    double dfv[nvrt];     // Vertical viscosity
 1169: 
 1170:    double eta1; // Elevation at nodes at previous timestep
 1171:    double eta2; // Elevation at nodes at current timestep
 1172: 
 1173:    double ETP;  // Earth Tidal Potential
 1174: 
 1175:    double pr;    // Air pressure
 1176:    double grav2; // Gravity 
 1177:    
 1178:    Vector2 dav;  // Depth averaged velocity
 1179: 
 1180:    Vector2 tau; // Wind stress vector
 1181: 
 1182:    // Vegetation parameters
 1183:    double veg_h;
 1184:    double veg_nv;
 1185:    double veg_di;
 1186:    double veg_Cd;
 1187:    double veg_h_unbent;
 1188:    double veg_di_unbent;
 1189:    double veg_nv_unbent;
 1190:    double veg_alpha_vert_mean;
 1191:    double veg_alpha0;
 1192:    double veg_alpha3D[nvrt];
 1193: 
 1194:    // Bottom drag parameters
 1195:    double Cd;       // Bottom drag coefficient
 1196:    double rough;    // Bottom roughness length
 1197:    Vector2 tau_bot; // Bottom stress vector
 1198: 
 1199:    double bdef1; // Bottom deformation at previous timestep
 1200:    double bdef2; // Bottom deformation at current timestep
 1201: 
 1202:    double qel; // RHS
 1203:    double coeffDiag; // Diagonal coefficient of the matrix
 1204:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1205: 
 1206:    double mP; // Search direction for conjugate gradient method
 1207:    double mR; // Residual for conjugate gradient method
 1208:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1209:    double mX; // Solution for conjugate gradient method
 1210: 
 1211:    // Meteorological forcing
 1212:    Vector2 u_air;
 1213:    double p_air;
 1214:    double t_air;
 1215:    double q_air;
 1216:    double wind_angle;  // Wind rotation angle
 1217: 
 1218:    __device__ void setWind(Vector2 &u) {
 1219:    // Sets the wind vector taking into account the wind rotation angle
 1220:    
 1221:       const double dir = atan2(-u.x,-u.y);
 1222:       const double speed = length(u);
 1223: 
 1224:       // Calculate new u and v components with added rotation angle
 1225:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1226:    }
 1227: 
 1228:    __device__ Point2 p2(void) const { return {p.x, p.y}; }
 1229:    __device__ Point3 p3(int k) const { return {p.x, p.y, z[k]}; }
 1230: 
 1231:    __device__ double sigmaTransitionDepth(void) const;
 1232: 
 1233:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1234:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1235:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1236: 
 1237:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1238: 
 1239:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1240:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1241: 
 1242:    __device__ void clearMatrixRow(void) {
 1243:       // Clear the matrix row for this node
 1244:       coeffDiag = 0.0;
 1245:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1246: 
 1247:    }
 1248: 
 1249:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1250:       // Add the value to the sparse matrix for this node
 1251:       
 1252:       if (node == this) {
 1253:          coeffDiag += value;
 1254:      
 1255:       } else {
 1256:          // Search (linearly)the index of the node in the array of nodes
 1257:          // XXX: This is not efficient, see if we can improve this
 1258:          int i;
 1259:          for (i = 0; i < numNodes; i++) {
 1260:             if (nodes[i] == node) {
 1261:                break;
 1262:             }
 1263:          }
 1264:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1265:          coeffMatrix[i] += value;
 1266:       }
 1267:    }
 1268: 
 1269: 
 1270:    __device__ __inline__ void updateZCoordData(void);
 1271: 
 1272:    __device__ double compZCoord(int k) const;
 1273: 
 1274:    __device__ void updateKb(void);
 1275: 
 1276: 
 1277: 
 1278: };
