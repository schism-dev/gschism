 1925: 
 1926: 
 1927: /**
 1928:  * Find the element that contains the target point.
 1929:  * 
 1930:  * @param x0,y0,z0     Starting position coordinates
 1931:  * @param xt,yt,zt     Target position coordinates
 1932:  * @param dtb          Time step for tracking
 1933:  * @param u_int        Initial velocity components
 1934:  * @param nextElem     Starting/resulting element index
 1935:  * 
 1936:  * @return Status code of type trackExitCodes
 1937:  * 
 1938:  * Uses the Leaded Celestial Walk algorithm to find the element that contains the target point.
 1939:  * This is a variant of the Celestial Walk algorithm that goes from element A containing the starting 
 1940:  * point x0 (in one side) to element B containing the target point xt. To enforce that the next element is
 1941:  * as close the the segment AB as possible, the next point at each iteration is computed
 1942:  * along segment AB, but just after the current element.
 1943:  */
 1944: 
 1945: 
 1946: __device__ __forceinline__ bool celestialWalk(Element *&curElem, Point3 x0, Point3 &xt, const Side *origSide, Side *&lastCrossSide, int jlev) {
 1947: 
 1948:    constexpr int MAX_ITERATIONS = 40;
 1949: 
 1950:    int iter = 0;
 1951:    double fac = 0.00001;
 1952:    while (iter < MAX_ITERATIONS) {
 1953:       iter++;
 1954: 
 1955:       Bool4 isLeft, isObtuse, isBisector;
 1956:       curElem->computePredicates(toPoint2(x0), toPoint2(xt), fac, origSide, isLeft, isObtuse, isBisector, jlev);
 1957: // showPoints(x0, xt, jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 1958:       Bool4 isValid = !isLeft & (!isObtuse | isBisector); // bitwise operation are overloaded
 1959: 
 1960: 
 1961:       if (isValid.none()) 
 1962:       // Inside the element if none of the edges is a valid continuation
 1963:       {
 1964:          // Just returns true and the element (curElem) is unchanged).
 1965:          // This means that the algorithm has found the element that contains the target point.
 1966:          return true;
 1967:       }
 1968:       else { // Outside the element
 1969: 
 1970:          // Outside this element. Pick the first valid exit side and cross.
 1971:          lastCrossSide = curElem->sides[isValid.firstOne()];
 1972:          Element *prevElem = curElem;
 1973:          curElem = lastCrossSide->otherElem(curElem);
 1974: 
 1975:          // If it crosses into a dry element or a boundary element, return false. This means that the track will now move 
 1976:          // along the boundary.
 1977:          if (curElem == nullptr || curElem->isDry) {
 1978:          
 1979:             curElem = prevElem;
 1980:             return false;
 1981:          }
 1982:          
 1983:       }
 1984: 
 1985:    }
 1986: 
 1987:   assert(false && "Leaded Celestial Walk: exceeded max iterations");
 1988: }
 1989: 
 1990: 
