 1609: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000) {
 1610:    return;
 1611:    // Lock the mutex
 1612:    lock(&debugPlotMutex);
 1613:  
 1614:    bool ok = true;
 1615:    if (debugPlotIdx == nullptr) ok = false;
 1616:    if (*debugPlotIdx >= 10000) ok = false;
 1617:    if (ok) {
 1618:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1619:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1620:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1621:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1622:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1623:       (*debugPlotIdx)++;
 1624:    }
 1625: 
 1626:    __threadfence();               // ensure all above writes are visible
 1627:    // Unlock the mutex
 1628:    unlock(&debugPlotMutex);
 1629: 
 1630: }
