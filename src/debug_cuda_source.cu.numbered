 2786: __device__ __inline__ void Node::updateZCoordData(void) {
 2787: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2788: 
 2789:    // assert(!isDry2() && "updateZCoordData: node is dry");
 2790:    // if (isDry2()) {
 2791:    //    kb = -1;  // XXXXXXXX KKKKK
 2792:    //    return;
 2793:    // }
 2794: 
 2795: 
 2796:    if constexpr(ivcor == 2) {  // SZ coordinates
 2797:       
 2798:       // Compute bottom level index
 2799:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 2800:    } 
 2801:    else if (ivcor == 1) {  // Localized sigma
 2802:       // Do nothing
 2803:    }
 2804: 
 2805: 
 2806: }
