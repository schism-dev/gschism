 3694: 
 3695: extern "C" {
 3696:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 3697:                                   int* indices, int* indptr) {
 3698: 
 3699:       NODE(node);
 3700:       
 3701:       const int idx = node->idx;
 3702:       
 3703:       // Computes the index in the nzz array      
 3704:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 3705: 
 3706: 
 3707:       indptr[idx] = nzzIdx;
 3708:       indices[nzzIdx] = idx;
 3709: 
 3710:       data_d[nzzIdx]    = node->coeffDiag;
 3711: 
 3712:       b_d[idx] = node->qel;
 3713: 
 3714:       for (int k = 0; k < node->numNodes; ++k) {
 3715:          const Node* nb = node->nodes[k];
 3716: 
 3717:          const int j = nb->idx;
 3718: 
 3719:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 3720: 
 3721:          indices[nzzIdx + k + 1] = j;
 3722:       }
 3723: 
 3724:  
 3725:    }
