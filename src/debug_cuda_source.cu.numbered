  637:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  638:       // Check if the point (xt,yt) is inside the element
  639:       double shpCoords[4];
  640: 
  641:       bool res = computeShapeCoords(xt, shpCoords, false);
  642: 
  643:       return res;
  644:    }
  645: 
  646:    __inline__ __device__ bool containsPoint(Vector2 &xt, bool fixCoords) const { 
  647:       // Check if the point (xt,yt) is inside the element
  648:       double shpCoords[4];
  649: 
  650:       Vector2 tmp_xt = xt;
  651:       bool res = computeShapeCoords(tmp_xt, shpCoords, fixCoords);
  652: 
  653:       if (fixCoords && res) xt = tmp_xt;
  654: 
  655:       return res;
  656:    }
  657: 
  658:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  659:    {
  660:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  661:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  662:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  663:       
  664:    }
  665: 
  666:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int) const;
  667: 
  668:    // ------------------------------------------------------------------------------------------------
  669:    // These are functions that work on all nodes of the element.
  670:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  671:    //
  672:    // An example of how to use these functions is:
  673:    //   
  674:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  675:    // 
  676:    // Where L is the level at which the field is to be interpolated. The field can be either
  677:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  678:    // There are different versions of getNodalValues for each of these cases.
  679: 
  680:    template<typename T>
  681:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  682:       // Get the values of the field at the nodes of the element
  683:       res[0] = nodes[0]->*field;
  684:       res[1] = nodes[1]->*field;
  685:       res[2] = nodes[2]->*field;
  686:       if (isQuad()) res[3] = nodes[3]->*field;
  687:       else          res[3] = T();
  688:    }
  689: 
  690:    template<typename T>
  691:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  692:       // Get the values of the field at the nodes of the element
  693:       res[0] = (nodes[0]->*field)[level];
  694:       res[1] = (nodes[1]->*field)[level];
  695:       res[2] = (nodes[2]->*field)[level];
  696:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  697:       else          res[3] = T();
  698:    }    
  699: 
  700:    template<typename T>
  701:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  702:       // Get the values of the func at the nodes of the element
  703:       res[0] = (nodes[0]->*func)(level);
  704:       res[1] = (nodes[1]->*func)(level);
  705:       res[2] = (nodes[2]->*func)(level);
  706:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  707:       else          res[3] = T();  // This is 0.0 or a zero vector
  708: 
  709:    }      
  710: 
  711:    template<typename T>
  712:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  713:       // Get the values of the field at the nodes of the element
  714:       res[0] = sides[0]->*field;
  715:       res[1] = sides[1]->*field;
  716:       res[2] = sides[2]->*field;
  717:       if (isQuad()) res[3] = sides[3]->*field;
  718:       else          res[3] = T();
  719:    }
  720: 
  721:    template<typename T>
  722:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  723:       // Get the values of the field at the nodes of the element
  724:       res[0] = (sides[0]->*field)[level];
  725:       res[1] = (sides[1]->*field)[level];
  726:       res[2] = (sides[2]->*field)[level];
  727:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  728:       else          res[3] = T();
  729:    }    
  730: 
  731:    template<typename T>
  732:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  733:       // Get the values of the func at the nodes of the element
  734:       res[0] = (sides[0]->*func)(level);
  735:       res[1] = (sides[1]->*func)(level);
  736:       res[2] = (sides[2]->*func)(level);
  737:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  738:       else          res[3] = T();  // This is 0.0 or a zero vector
  739: 
  740:    }      
  741: 
  742: 
  743:    __device__ double interpolate(int level, const double shapeCoords[4], double (Node::*func)(int) const) const {
  744:       double values[4];
  745:       getNodalValues(level, func, values);
  746: 
  747:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  748:    }
  749: 
  750:    template<typename T>
  751:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  752:       T values[4];
  753:       getNodalValues(field, values);
  754:       
  755:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  756:    }
  757: 
  758: 
  759:    template<typename T>
  760:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  761:       T values[4];
  762:       getNodalValues(level, field, values);
  763: 
  764:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  765:    }
  766: 
  767:    template<typename T>
  768:    __device__ T mean(T Node::* field) const {
  769:       T values[4];
  770:       getNodalValues(field, values);
  771: 
  772:       return (values[0] + values[1] + values[2] + values[3])/i34;
  773:    }
  774: 
  775:    template<typename T>
  776:    __device__ T mean(T Side::* field) const {
  777:       T values[4];
  778:       getSideValues(field, values);
  779:       
  780:       return (values[0] + values[1] + values[2] + values[3])/i34;
  781:    }   
  782: 
  783:    template<typename T>
  784:    __device__ T mean(int level, T (Node::* field)[nvrt]) const {
  785:       T values[4];
  786:       getNodalValues(level, field, values);
  787: 
  788:       return (values[0] + values[1] + values[2] + values[3])/i34;
  789:    }
  790: 
  791:    template<typename T>
  792:    __device__ T mean(int level, T (Side::* field)[nvrt]) const {
  793:       T values[4];
  794:       getSideValues(level, field, values);
  795:       
  796:       return (values[0] + values[1] + values[2] + values[3])/i34;
  797:    }   
  798: 
  799:    // __device__ double mean(double (Node::*func)(int) const) const {
