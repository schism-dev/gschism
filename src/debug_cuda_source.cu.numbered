 2185:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 2186:       // Compute the different time ramps used in the code 
 2187:       // This function is performed by just one thread
 2188: 
 2189:       rampbc = 1.0;
 2190:       if constexpr(ibc == 0) {
 2191:          if (drampbc > 0.0) {
 2192:             rampbc = tanh(2.0*time/86400.0/drampbc);
 2193:          } else {
 2194:             rampbc = 1.0;
 2195:          }
 2196:       }
 2197: 
 2198:       if (nws != 0) {
 2199:          if (drampwind > 0.0) {
 2200:             rampwind = tanh(2.0*time/86400.0/drampwind);
 2201:          } else {
 2202:             rampwind = 1.0;
 2203:          }
 2204:       }
 2205: 
 2206:       if (drampwafo > 0.0) {
 2207:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 2208:       } else {
 2209:          rampwafo = 1.0;
 2210:       }
 2211: 
 2212:       // For source/sinks
 2213:       if (if_source && dramp_ss > 0.0) {
 2214:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 2215:       } else {
 2216:          ramp_ss = 1.0;
 2217:       }
 2218: 
 2219:       if (dramp > 0.0) {
 2220:          ramp = tanh(2.0*time/86400.0/dramp);
 2221:       } else {
 2222:          ramp = 1.0;
 2223:       }
 2224: 
 2225: 
 2226:    }
