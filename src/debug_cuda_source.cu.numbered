10656:    *sizeNode = sizeof(Node);
10657: 
10658:    switch (varCode) {
10659:       case (int)VarCode::depth:
10660:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
10661:          *sizeType = sizeof(double);
10662:          break;
10663:       case (int)VarCode::eta:
10664:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
10665:          *sizeType = sizeof(double);
10666:          break;
10667:       case (int)VarCode::x:
10668:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
10669:          *sizeType = sizeof(Vector2);
10670:          break;
10671:       case (int)VarCode::z:
10672:          *offset = (int)((char*)&nodes[0].z - (char*)nodes);
10673:          *sizeType = sizeof(double);
10674:          break;
10675:       case (int)VarCode::kb:
10676:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
10677:          *sizeType = sizeof(int);
10678:          break;
10679:       case (int)VarCode::isdry:
10680:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
10681:          *sizeType = sizeof(int);
10682:          break;         
10683:       case (int)VarCode::w:
10684:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
10685:          *sizeType = sizeof(double);
10686:          break;
10687:       case (int)VarCode::u:
10688:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
10689:          *sizeType = sizeof(Vector2);
10690:          break;  
10691:       case (int)VarCode::u_air:
10692:          *offset = (int)((char*)&nodes[0].u_air - (char*)nodes);
10693:          *sizeType = sizeof(Vector2);
10694:          break;
10695:       default:
10696:          *offset = -1;    
10697:    }  
10698:    
10699: }
