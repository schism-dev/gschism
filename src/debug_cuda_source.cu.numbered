 5380:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 5381: 
 5382:       NODE_BND(nodeBnd);
 5383: 
 5384:       Node *node = nodeBnd->node;
 5385: 
 5386:       node->ETP = 0.0;
 5387: 
 5388:       // For all tidal potential components
 5389:       for (int j=0; j<ntip; j++) {
 5390: 
 5391:          const double nodeETP = node->computeETP(j, time, tfreq, tamp, tnf, tear, jspc);
 5392: 
 5393:          node->ETP += nodeETP;
 5394: 
 5395:          if constexpr(iloadtide==1) { // loading tide
 5396:             assert(false && "Loading tide not implemented");
 5397:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5398:          }
 5399:          
 5400:       }
 5401: 
 5402:      
 5403:    }
