 3327:    //    return;
 3328:    // }
 3329: 
 3330: 
 3331:    if constexpr(ivcor == 2) {  // SZ coordinates
 3332:       
 3333:       // Compute bottom level index
 3334:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3335:    } 
 3336:    else {  // if (ivcor == 1) Localized sigma
 3337:       // Do nothing
 3338:    }
 3339: 
 3340: 
 3341: }
 3342: 
 3343: 
 3344: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3345:    // Computes the z coordinate at level k.
 3346:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3347:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3348:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3349:    // used 
 3350: 
 3351:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3352:    
 3353:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3354: 
 3355:    if (isDry2()) return 0.0;  
 3356: 
 3357:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3358: 
 3359:    if constexpr(ivcor == 2) {
 3360: 
 3361:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3362:       const double h_c = mesh->h_c;
 3363:       const double theta_f = mesh->theta_f;
 3364:       const double sinh_theta_f = mesh->sinh_theta_f;
 3365: 
 3366: 
 3367:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3368:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3369:       // once per time step/node. XXXX
 3370:       // CHECK: updateZCoordData
 3371: 
 3372:       //  To simplify comparisons, I define index versions of count variables.
 3373:       if      (k == ivrt)     return eta2; 
 3374:       else if (k == izlev)    return -hmod2;
 3375:       else if (k == kb)       return -depth;
 3376:       else if (k < izlev)     return mesh->ztot[k];
 3377:       else if (k > izlev) {
 3378:          const int ksig = k - izlev;
 3379: 
 3380:          if (hmod2 <= h_c) {
 3381:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3382: 
 3383:          } 
 3384:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3385:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3386:             assert(false && "compZCoord: invalid h_c\n");
 3387:          } 
 3388:          else {
 3389:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3390:                    h_c * mesh->sigma[ksig] + 
 3391:                    (hmod2 - h_c) * mesh->cs[ksig];
 3392:          }
 3393:       } else { 
 3394:          assert(false && "compZCoord: invalid level or coordinate system\n");
 3395:       }
 3396: 
 3397:    }
 3398:    else {  // if constexpr(ivcor == 1)
 3399:       if (k <= kb)        return -depth; 
 3400:       else if (k == ivrt) return eta2;
 3401:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3402: 
 3403:    }
 3404:    
 3405:    assert(false && "compZCoord: invalid level or coordinate system\n");
 3406:    return 0.0;
 3407: }
 3408: 
 3409: 
 3410: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3411:    // Computes the bottom drag Cd based on the selected nchi
 3412: 
 3413:    if constexpr(nchi == 0) {
 3414:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3415:       Cd = drag;  // Read from drag file
 3416: 
 3417:    } else if constexpr(nchi == 1) {
 3418:       // 
 3419: 
 3420:       bool ltmp = false; // for WBL iteration
 3421: 
 3422:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3423:       if (isDry || (rough == 0.0)) {
 3424:          Cd = 0.0;
 3425: 
 3426:       } else { //roughness >0 
 3427:          
 3428:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3429: 
 3430:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3431: 
 3432:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3433: 
 3434:       } // if rough
 3435: 
 3436:    } else if constexpr(nchi == -1) {
 3437:    // Manning 
 3438:  
 3439:       const double htot = max(hmin_man, htot2()); 
 3440:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3441: 
 3442:    } else {
 3443:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3444:       
 3445:    } // if nchi
 3446: 
 3447: }
 3448: 
 3449: 
 3450: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3451:    // Checks if a side in on the boundary
 3452:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3453: 
 3454:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3455:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3456: 
 3457:    // Indices of the nodes that form the side
 3458:    const int n1 = side.n1->idx;
 3459:    const int n2 = side.n2->idx;
 3460:    isLand = false;
 3461:    
 3462: 
 3463:    // Check if the side is on a land boundary
 3464:    for (int i = 0; i < nland; i++) {
 3465:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3466:          // Consecutive nodes in the land boundary segment
 3467:          const int b1 = ilnd[i + j*nland];
 3468:          const int b2 = ilnd[i + (j + 1)*nland];
 3469: 
 3470:          assert(b1 != -1 && b2 != -1);
 3471: 
 3472:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3473:             
 3474:             isLand = true;
 3475:             return i;
 3476:          }
 3477:       }
 3478:    }
 3479: 
 3480:    // Check if the side is on an open boundary
 3481:    for (int i = 0; i < nope; i++) {
 3482:       for (int j = 0; j < nond[i] - 1; j++) {
 3483:          // Consecutive nodes in the open boundary segment
 3484:          const int b1 = iond[i + j*nope];
 3485:          const int b2 = iond[i + (j + 1)*nope];
 3486: 
 3487:          assert(b1 != -1 && b2 != -1);
 3488: 
 3489:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3490:             isLand = false;
 3491:             return i;
 3492:          }
 3493:       }
 3494:    }
 3495: 
 3496:    return -1;
 3497: }
 3498: 
 3499: 
 3500: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3501:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3502:                                     double *wind_rotate_angle, 
 3503:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3504:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3505:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3506:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3507:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 3508: 
 3509:    NODE(pnode);  
 3510:    const int i = idx_node;
 3511:    Node &node(*pnode);
 3512: 
 3513:    node.idx = i;
 3514: 
 3515:    const int idxNodeStart = nodeNeighNodesStart[i];
 3516:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3517:    node.numNodes = idxNodeEnd - idxNodeStart;
 3518:    node.nodes = nodeNeighNodes + idxNodeStart;
 3519:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3520: 
 3521: 
 3522: 
 3523:    const int idxElemStart = nodeNeighElemsStart[i];
 3524:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3525:    node.numElements = idxElemEnd - idxElemStart;
 3526:    node.elements = nodeNeighElems + idxElemStart;
 3527: 
 3528: 
 3529:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3530:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3531:       const int partNode = localNodePart[idxNodeGlobal]; 
 3532:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3533: 
 3534:       Node *node_ptr = nodes[partNode] + idxNode;
 3535:       
 3536:       nodeNeighNodes[idx] = node_ptr;
 3537:    }
 3538: 
 3539: 
 3540:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3541:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3542:       const int partElem = localElemPart[idxElemGlobal];
 3543:       const int idxElem  = localElemIndices[idxElemGlobal];
 3544: 
 3545:       Element *elem_ptr = elems[partElem] + idxElem;
 3546: 
 3547:       nodeNeighElems[idx] = elem_ptr;
 3548:    }      
 3549: 
 3550:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 3551:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 3552:    sincosf((float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 3553: 
 3554:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 3555:    if constexpr(ics == 1) {
 3556:       node.p.x   = node_coords[i * 3];
 3557:       node.p.y   = node_coords[i * 3 + 1];
 3558:       node.gz = 0.0;
 3559: 
 3560:    } else {
 3561:       const double lon = deg2rad*node_coords[i * 3];
 3562:       const double lat = deg2rad*node_coords[i * 3 + 1];
 3563: // printf("lat = %f, lon = %f, x = %f, y = %f\n", lat, lon, node.lat, node.lon); 
 3564:       Point3 p = computeXYZfromLatLon(lat, lon);
 3565:       node.p = toVector2(p);
 3566:       node.gz = p.z;
 3567: 
 3568:       #ifdef USE_FRAMES
 3569:       node.setFrame(lat, lon);
 3570:       #endif
 3571: 
 3572: 
 3573:    }
 3574: 
 3575:    node.depth = node_coords[i * 3 + 2];
 3576: 
 3577:    node.numSides = 0;
 3578: 
 3579:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3580:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3581:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3582:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3583:    else assert(false && "populateNodes: selected nchi not implemented.");
 3584:    
 3585:    if constexpr(ivcor == 1) 
 3586:    {  
 3587:       node.kb = kb[i];
 3588:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + i*nvrt];
 3589:    }
 3590: 
 3591:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3592:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3593:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3594: 
 3595:    
 3596:    // Links the node to the boundary information
 3597:    if (isbnd[i] >= 0) {
 3598:      
 3599:       // Get the index of the node boundary
 3600:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3601: 
 3602:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3603:       node.nodeBnd->node = &node;
 3604: 
 3605:       node.nodeBnd->sideBnd1 = nullptr;
 3606:       node.nodeBnd->sideBnd2 = nullptr;
 3607: 
 3608:       if (isbnd[i]>=0) {
 3609: 
 3610:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3611:          
 3612:          node.nodeBnd->segment->ifltype = 3 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3613:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3614: 
 3615:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3616:          node.nodeBnd->segment->clen  = nan("1");
 3617:          node.nodeBnd->segment->carea = nan("1");
 3618: 
 3619:       }
 3620:    } else {
 3621: 
 3622:       node.nodeBnd = nullptr; // For internal nodes
 3623: 
 3624:       if (isbnd[i] == landSegment) {
 3625:          node.nodeBnd = &landBoundaryNode;
 3626:          node.nodeBnd->segment = &landBoundarySegment;
 3627:       }
 3628:       
 3629:    }
 3630:    
 3631:    // XXXX GAUSSIAN HILL VELOCITIES
 3632: #ifdef GAUSSIAN_HILL_VELOCITIES
 3633:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3634:       constexpr double rot_per = 3000.0;
 3635:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3636:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3637:    // XXXXX
 3638: #endif
 3639: 
 3640: }
 3641: 
 3642: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3643:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3644:                                     double *wind_rotate_angle,   
 3645:                                     int *isdel, int *isidenode, int *isbnd,
 3646:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3647:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3648:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3649:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3650:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3651:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3652:                                     double *drag, double *roughness) {
 3653: 
 3654: 
 3655:    SIDE(pside);
 3656:    Side &side(*pside);
 3657:    const int i = idx_side;
 3658: 
 3659:    side.idx = i;  
 3660:    
 3661:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3662:    const double fc   = 2.0*omega_e*sin(sfea0);
 3663:    const double beta = 2.0*omega_e*cos(sfea0);
 3664: 
 3665:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 3666: 
 3667:    // finding the pointer to the nodes that form the side
 3668:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3669:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3670: 
 3671:    const int locidx_n1 = localNodeIndices[idx_n1];
 3672:    const int locidx_n2 = localNodeIndices[idx_n2];
 3673:    const int part_n1 =   localNodePart[idx_n1];
 3674:    const int part_n2 =   localNodePart[idx_n2];
 3675: 
 3676:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3677:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3678: 
 3679: 
 3680:    // Counts the number of sides connected to each node
 3681:    side.n1->numSides++;
 3682:    side.n2->numSides++;
 3683: 
 3684:    // Normal, unitary vector to the side
 3685:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3686:    side.n = normalize(side.n);
 3687: 
 3688:    // Side boundary type
 3689:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3690:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3691: 
 3692:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3693:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3694:    {
 3695:       bool isLand = false;
 3696:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3697:       
 3698:       if (isbs > -1) {
 3699:          // assert(isLand || isbs>=0);
 3700:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3701: 
 3702:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3703: 
 3704:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3705:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3706: 
 3707:          assert (isLand == side.sideBnd->segment->isLand);
 3708: 
 3709:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3710:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3711:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3712: 
 3713:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3714:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3715:          
 3716:          side.sideBnd->side = &side;
 3717: 
 3718:       }
 3719:       else {
 3720:          side.sideBnd = nullptr;
 3721:       }
 3722:    }
 3723:    else 
 3724:    {
 3725:       side.sideBnd = nullptr;
 3726:    }
 3727: 
 3728: 
 3729:    // finding the pointer to the elements that share the side
 3730:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3731:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3732: 
 3733:    if (idx_e1 > -1) {
 3734:       const int locidx_e1 = localElemIndices[idx_e1];
 3735:       const int part_e1 =  localElemPart[idx_e1];
 3736:       side.elems[0] = elems[part_e1] + locidx_e1;
 3737: 
 3738:    }
 3739:    else {
 3740:       side.elems[0] = nullptr;
 3741:    }
 3742: 
 3743:    if (idx_e2 > -1) {
 3744:       const int locidx_e2 = localElemIndices[idx_e2];
 3745:       const int part_e2 =  localElemPart[idx_e2];
 3746:       side.elems[1] = elems[part_e2] + locidx_e2;
 3747:    }
 3748:    else {
 3749:       side.elems[1] = nullptr;
 3750:    }
 3751: 
 3752:    // Compute the center of the side
 3753:    side.center = 0.5*(side.n1->p + side.n2->p);
 3754: 
 3755:    #ifdef USE_FRAMES
 3756:    side.setFrame();
 3757:    #endif
 3758: 
 3759:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3760:    side.shapiro = shapiro0;
 3761: 
 3762: #ifdef GAUSSIAN_HILL_VELOCITIES
 3763: // XXXX
 3764: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3765: constexpr double rot_per=3000.0;
 3766: constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 3767: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3768: // XXXXX      
 3769: #endif
 3770:    // Compute the z level at the center of the side
 3771:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 3772:    
 3773:    // Compute the length of the side
 3774:    const Vector2 vLen = side.n2->p - side.n1->p;
 3775:    side.len = sqrt(dot(vLen, vLen));
 3776: 
 3777: 
 3778:    // Compute the Coriolis coefficient
 3779: 
 3780:    if constexpr(ncor == -1 || ncor == 0) {
 3781:       side.coriolis = coricoef;
 3782:    }
 3783:    else {
 3784:       const double sphi = side.lat();  // Latitude at the center of the side
 3785: 
 3786:       assert(use_ll && "use_ll must be true when ncor > 0");
 3787: 
 3788:       if constexpr(ics == 1) {
 3789:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3790:       }
 3791:       else { // ics == 2
 3792:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 3793:          side.coriolis = 2.0*omega_e*sin(sphi);  
 3794:       }
 3795: 
 3796:    }
 3797: 
 3798: }
 3799: 
 3800: 
 3801: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3802:    double *node_coords, double *node_coords_ll, bool use_ll,
 3803:    double *wind_rotate_angle,   
 3804:    int *isdel, int *isidenode, int *isbnd,
 3805:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3806:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3807:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3808:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3809:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3810:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3811:    double *drag, double *roughness) {
 3812: 
 3813:    ELEM(pelem);
 3814:    Element &elem(*pelem);
 3815:    const int i = idx_elem;
 3816: 
 3817:    elem.idx = i;
 3818: 
 3819:    for (int j = 0; j < i34[i]; j++) {
 3820:       const int idxNode = elnode[i*4 + j];  
 3821:       const int idxSide = elside[i*4 + j];
 3822:       
 3823:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3824:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3825: 
 3826:       // Find the neighboring element  
 3827:       if (elem.sides[j]->elems[0] == &elem) {
 3828:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3829:       }
 3830:       else {
 3831:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3832:       }
 3833:       
 3834:    }
 3835: 
 3836:    elem.i34 = i34[i];
 3837: 
 3838:    // Compute the barycenter of the element and its depth
 3839:    elem.center = {0.0, 0.0};
 3840:    elem.depth = 1e10;
 3841:    for (int j = 0; j < i34[i]; j++) {
 3842: 
 3843:       elem.center += elem.nodes[j]->p/i34[i];
 3844:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 3845:    }
 3846: 
 3847:    #ifdef USE_FRAMES
 3848:    elem.setFrame();
 3849:    #endif
 3850: 
 3851:    elem.area = elem.computeSignedArea(); 
 3852:    elem.radius = sqrt(elem.area)/pi; 
 3853:    
 3854:    // Determines which way the normal vector to each side is oriented.
 3855:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3856:    for (int j = 0; j < i34[i]; j++)  
 3857:    {
 3858:       if (elem.sides[j]->elems[0] == &elem) {
 3859:          elem.ssign[j] =  1.0;
 3860:       }
 3861:       else {
 3862:          elem.ssign[j] = -1.0;
 3863:       }
 3864: 
 3865:    }
 3866: 
 3867:   
 3868: 
 3869:    // Derivatives of shape functions
 3870:    //  For ics=2, this is done in the element frame
 3871:    //  For quads, the derivative is evaluated at centroid
 3872:    for (int j = 0; j < elem.i34; j++) {
 3873:       const double area = elem.area;
 3874:       const int id2 = elem.nxq(1 + j);
 3875:       const int id3 = elem.nxq(2 + j);
 3876:       const int id4 = elem.nxq(3 + j);
 3877:       if (elem.isTri()) {
 3878:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3879:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3880:          // da1/dx = (y1 - y2)/(2*area)
 3881: 
 3882:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 3883:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 3884:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 3885: 
 3886:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 3887:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 3888: 
 3889:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3890: 
 3891:       }
 3892:       else  { // Quad; evaluate at centroid
 3893: 
 3894:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 3895:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 3896:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 3897: 
 3898:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 3899:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 3900: 
 3901:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3902:       } // if Tri
 3903: 
 3904:    } // for j   
 3905:    
 3906:    
 3907: 
 3908: }
 3909: 
 3910: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3911:                                             double *emo, double *efa, 
 3912:                                             double *umo, double *ufa, 
 3913:                                             double *vmo, double *vfa) {
 3914: 
 3915:    NODE_BND(nodeBnd);
 3916:    const int idx = idx_node_bnd;    
 3917: 
 3918:    nodeBnd->idx = idx;
 3919: 
 3920:    // Need to find the segment index and the index of the node on the segment
 3921:    int idxNode = -1;
 3922:    int iseg, i;
 3923:    for (iseg = 0; iseg < nope; iseg++) {
 3924:       // for each segment...
 3925:       for (i = 0; i < nond[iseg]; i++) {
 3926:          idxNode = iond[iseg + i*nope];
 3927:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3928:          
 3929:       }
 3930:    }
 3931: 
 3932:    assert(iseg < nope && "iseg is out of bounds");
 3933: 
 3934: found: // Jumped here when the node was found
 3935: 
 3936:    nodeBnd->isEssentialBC = true;
 3937:    nodeBnd->elbc = 0.0;
 3938: 
 3939:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3940: 
 3941:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 3942:       nodeBnd->efa[jfr] = efa[idx2];
 3943:       nodeBnd->emo[jfr] = emo[idx2];
 3944:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3945:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3946: 
 3947:    }
 3948:         
 3949: 
 3950: }
