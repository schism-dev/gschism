  218: __device__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
  219:     return make_double2(a.x + b.x, a.y + b.y);
  220: }
  221: 
  222: 
  223: 
  224: __device__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
  225:     a.x += b.x;
  226:     a.y += b.y;
  227:     return a;
  228: }
  229: 
  230: __device__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
  231:     return make_double2(a.x - b.x, a.y - b.y);
  232: }
  233: 
  234: __device__ __forceinline__ double2 operator-=(double2& a, const double2& b) {
  235:     a.x -= b.x;
  236:     a.y -= b.y;
  237:     return a;
  238: }
