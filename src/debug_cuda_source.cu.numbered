 1874: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 1875:                    Node *node = &(mesh->localNodeData[idx_node]); \
 1876:                    if (idx_node >= mesh->np) return;
 1877: 
 1878: #define NODE_ALL(node, valid) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x;       \
 1879:                               Node *node = &(mesh->localNodeData[idx_node]); \
 1880:                               const bool valid = (idx_node < mesh->np);                   
 1881: 
 1882: 
 1883: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1884:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 1885:                            if (idx_node_bnd >= mesh->nbp) return;
 1886: 
 1887: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1888:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 1889:                            if (idx_side_bnd >= mesh->nbs) return;                           
