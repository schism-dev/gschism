 9239:             else !simple upwind method
 9240:               do j=1,i34(ie)
 9241:                 jsj=elside(j,ie)
 9242:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 9243:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 9244:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 9245:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 9246:                   endif
 9247:                 enddo  !vertical layers
 9248:               enddo !j=1,i34(ie) ! side
 9249:             endif !order of accuracy
