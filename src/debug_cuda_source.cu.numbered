 8497:          *sizeType = sizeof(Vector2);
 8498:          break;
 8499:       case (int)VarCode::area:
 8500:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 8501:          *sizeType = sizeof(double);
 8502:          break;
 8503:       case (int)VarCode::depth:
 8504:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 8505:          *sizeType = sizeof(double);
 8506:          break;
 8507:       case (int)VarCode::radius:
 8508:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 8509:          *sizeType = sizeof(double);
 8510:          break;
 8511:       case (int)VarCode::ghat:
 8512:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 8513:          *sizeType = sizeof(Vector2);
 8514:          break;
 8515:       case (int)VarCode::kb:
 8516:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 8517:          *sizeType = sizeof(int);
 8518:          break;
 8519:       case (int)VarCode::isdry:
 8520:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 8521:          *sizeType = sizeof(int);
 8522:          break;            
 8523:       case (int)VarCode::w:
 8524:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 8525:          *sizeType = sizeof(double);
 8526:          break;
 8527:       case (int)VarCode::FaceIndices:
 8528:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 8529:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 8530:          *sizeType = sizeof(Node);
 8531:          break;
 8532:       default:
 8533:          *offset = -1;
 8534:    }
 8535: }
