 1176: struct Node {
 1177: 
 1178:    // Geometry information
 1179:    int idx;        // Index of the node
 1180:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1181:    int numNodes;   // Number of nodes neighbors of this node
 1182: 
 1183:    Element **elements; // Array of pointers to the elements that share this node
 1184:    int numElements;    // Number of elements that share this node
 1185: 
 1186:    int numSides;       // Number of sides that are connected to this node
 1187: 
 1188:    Point3 p;
 1189:    Vector3 u2[nvrt];
 1190:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1191:    double z[nvrt];
 1192:    double lon, lat;
 1193:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1194:    double depth;
 1195: 
 1196:    int kb;       // Bottom index of the node
 1197: 
 1198:    bool isDry;     // True if the node is dry
 1199: 
 1200:    int iadv;     // Advection flag
 1201: 
 1202:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1203:                           // this is nullptr
 1204: 
 1205:    TempVar tmp; // Temporary variable to store different types of variables
 1206: 
 1207:    // Physical information
 1208:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1209:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1210: 
 1211:    double rho[nvrt];     // Density
 1212:    double dfv[nvrt];     // Vertical viscosity
 1213: 
 1214:    double eta1; // Elevation at nodes at previous timestep
 1215:    double eta2; // Elevation at nodes at current timestep
 1216: 
 1217:    double ETP;  // Earth Tidal Potential
 1218: 
 1219:    double pr;    // Air pressure
 1220:    double grav2; // Gravity 
 1221:    
 1222:    Vector2 dav;  // Depth averaged velocity
 1223: 
 1224:    Vector2 tau; // Wind stress vector
 1225: 
 1226:    // Vegetation parameters
 1227:    double veg_h;
 1228:    double veg_nv;
 1229:    double veg_di;
 1230:    double veg_Cd;
 1231:    double veg_h_unbent;
 1232:    double veg_di_unbent;
 1233:    double veg_nv_unbent;
 1234:    double veg_alpha_vert_mean;
 1235:    double veg_alpha0;
 1236:    double veg_alpha3D[nvrt];
 1237: 
 1238:    // Bottom drag parameters
 1239:    double Cd;       // Bottom drag coefficient
 1240:    double rough;    // Bottom roughness length
 1241:    Vector2 tau_bot; // Bottom stress vector
 1242: 
 1243:    double bdef1; // Bottom deformation at previous timestep
 1244:    double bdef2; // Bottom deformation at current timestep
 1245: 
 1246:    double qel; // RHS
 1247:    double coeffDiag; // Diagonal coefficient of the matrix
 1248:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1249: 
 1250:    double mP; // Search direction for conjugate gradient method
 1251:    double mR; // Residual for conjugate gradient method
 1252:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1253:    double mX; // Solution for conjugate gradient method
 1254: 
 1255:    // Meteorological forcing
 1256:    Vector2 u_air;
 1257:    double p_air;
 1258:    double t_air;
 1259:    double q_air;
 1260:    double wind_angle;  // Wind rotation angle
 1261: 
 1262:    __device__ void setWind(Vector2 &u) {
 1263:    // Sets the wind vector taking into account the wind rotation angle
 1264:    
 1265:       const double dir = atan2(-u.x,-u.y);
 1266:       const double speed = length(u);
 1267: 
 1268:       // Calculate new u and v components with added rotation angle
 1269:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1270:    }
 1271: 
 1272:    __device__ Point2 p2(void) const { return {p.x, p.y}; }
 1273:    __device__ Point3 p3(int k) const { return {p.x, p.y, z[k]}; }
 1274: 
 1275:    __device__ double sigmaTransitionDepth(void) const;
 1276: 
 1277:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1278:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1279:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1280: 
 1281:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1282: 
 1283:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1284:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1285: 
 1286:    __device__ void clearMatrixRow(void) {
 1287:       // Clear the matrix row for this node
 1288:       coeffDiag = 0.0;
 1289:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1290: 
 1291:    }
 1292: 
 1293:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1294:       // Add the value to the sparse matrix for this node
 1295:       
 1296:       if (node == this) {
 1297:          coeffDiag += value;
 1298:      
 1299:       } else {
 1300:          // Search (linearly)the index of the node in the array of nodes
 1301:          // XXX: This is not efficient, see if we can improve this
 1302:          int i;
 1303:          for (i = 0; i < numNodes; i++) {
 1304:             if (nodes[i] == node) {
 1305:                break;
 1306:             }
 1307:          }
 1308:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1309:          coeffMatrix[i] += value;
 1310:       }
 1311:    }
 1312: 
 1313: 
 1314:    __device__ __inline__ void updateZCoordData(void);
 1315: 
 1316:    __device__ double compZCoord(int k) const;
 1317: 
 1318:    __device__ void updateKb(void);
 1319: 
 1320: 
 1321: 
 1322: };
