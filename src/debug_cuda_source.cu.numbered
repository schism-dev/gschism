 2058: __device__ __forceinline__ void update_bdef(double time, double x0, double y0, double &dep, Vector3 &vel) {
 2059:    // For imm=2, user needs to update bottom depth and velocity
 2060: 
 2061:    dep = min(1.0, 7.0 - (x0 + time));
 2062:    vel = { -1.0, 0.0, 0.0 };
 2063: 
 2064: }
 2065: 
 2066: 
 2067: 
 2068: 
 2069: 
 2070: __inline__ __device__ Point2 Element::outputCoords(void) const {
 2071:    if constexpr(ics == 1)  {
 2072:       return center;
 2073: 
 2074:    } else {
 2075:       const Point2 p0 = nodes[0]->outputCoords();
 2076:       const Point2 p1 = nodes[1]->outputCoords();
 2077:       const Point2 p2 = nodes[2]->outputCoords();
 2078: 
 2079:       if (isTri()) {
 2080:          return (1.0/3.0)*(p0 + p1 + p2);
 2081: 
 2082:       } else {
 2083:          const Point2 p3 = nodes[3]->outputCoords();
 2084:          return (1.0/4.0)*(p0 + p1 + p2 + p3);
 2085:       }
 2086: 
 2087:    }
 2088: }
 2089: 
 2090: 
 2091: __device__ __forceinline__ double Element::centerZ(void) const { 
 2092: // Z coordinate of the element center in the global cartesian coordinates.
 2093: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 2094: 
 2095:    if constexpr(ics==1) { 
 2096:       return 0.0; 
 2097: 
 2098:    } else { 
 2099: 
 2100:       if (isTri())  return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz);
 2101:       else          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz);
 2102:    } 
 2103: }
 2104: 
