  952: struct Side {
  953: 
  954:    // Geometry information
  955:    int idx;               // Index of the side
  956:    Node *n1, *n2;
  957:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  958: 
  959:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
  960:    Vector2 center;        // Location of side center. 
  961:    double zc[nvrt];       // Side center z-coord at each vertical level
  962: 
  963:    Frame frame;
  964: 
  965:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  966:                           // this is nullptr
  967:    
  968:    int kb;                // Bottom index of the side
  969:    bool isDry;            // True if the side is dry
  970:  
  971:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  972: 
  973:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
  974: 
  975:    // Physical information
  976:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  977:    double  w2[nvrt];            // Vertical velocity at each vertical level
  978:    Vector2 btu[nvrt];           // Back-tracked velocity
  979:    Vector2 U;                   // Vertically averaged velocity vector  
  980: 
  981:    Vector2 nuGradU[nvrt];          // nu*grad u
  982: 
  983:    Vector2 bcc[nvrt];           // Baroclinic term
  984:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
  985: 
  986:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
  987:    Vector2 gradEta2;             // Gradient of elevation at current timestep
  988:    Vector2 gradPr;               // Gradient of pressure
  989:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
  990: 
  991: 
  992:    double hhat;                 // \breve{H} in notes
  993: 
  994:    double shapiro;
  995: 
  996:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
  997: 
  998:    double coriolis;             // Coriolis parameter
  999: 
 1000:    // Vegetation parameters
 1001:    double veg_c2;
 1002:    double veg_beta;
 1003: 
 1004:    // Bottom drag parameters.
 1005:    double chi;
 1006:    double chi2;
 1007: 
 1008:    __inline__ __device__ double x(double t) const;
 1009:    __inline__ __device__ double y(double t) const;
 1010:    __inline__ __device__ double lon(void) const;
 1011:    __inline__ __device__ double lat(void) const;
 1012:    __inline__ __device__ Point2 p_t(double t) const;
 1013: 
 1014:    __inline__ __device__ Point3 center3D(int k) const { assert(k < nvrt); return {center.x, center.y, zc[k]}; }
 1015:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
 1016:    __inline__ __device__ double Dz(int k)       const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1017:    __inline__ __device__ double area(int k)     const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1018: 
 1019:    __inline__ __device__ Side* neigh(int index) const { 
 1020:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1021:       assert(index >= 0 && index < 4); 
 1022:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1023: 
 1024:       const int ielem = index & 1;           // 0 or 1
 1025:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1026: 
 1027:       const Element* elem = elems[ielem];
 1028: 
 1029:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1030: 
 1031:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1032: 
 1033:    }
 1034: 
 1035:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1036: 
 1037:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1038: 
 1039:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1040:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1041:    __inline__ __device__ int iadv(void) const;
 1042: 
 1043:    __inline__ __device__ double grav3(void) const;
 1044:    
 1045:    __inline__ __device__ double eta2(void) const;
 1046:    __inline__ __device__ double eta1(void) const;
 1047:    __inline__ __device__ double depth(void) const;
 1048:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1049:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1050: 
 1051:    __inline__ __device__ double dfv(int k) const;
 1052: 
 1053:    __inline__ __device__ double veg_h(void)  const;
 1054:    __inline__ __device__ double veg_nv(void) const;
 1055:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1056:    __inline__ __device__ double veg_alpha3D(int k) const;
 1057:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1058: 
 1059:    __inline__ __device__ double Cd(void) const;
 1060: 
 1061:    __inline__ __device__ Vector2 tau(void) const;
 1062: 
 1063:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1064:    
 1065: 
 1066:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1067:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1068:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1069:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1070:    } 
 1071:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1072:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1073:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
 1074:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
 1075: 
 1076:    // Get valid starting element (for backtracking)
 1077:    __inline__ __device__ Element* getStartElement() {
 1078:       return elems[0] ? elems[0] : elems[1];
 1079:    }
 1080: 
 1081:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
 1082:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
 1083: 
 1084:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
 1085: 
 1086:       // Dot product of the negative velocity vector with the side normal vector
 1087:       const double dot_prod1 = -dot(u, n);
 1088: 
 1089:       // Vector from side center to element 0 centroid
 1090:       const Vector2 v2 = toVector2(elems[0]->center) - center;
 1091: 
 1092:       // Dot product of the vector with the side normal vector
 1093:       const double dot_prod2 = dot(v2, n);
 1094: 
 1095:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
 1096:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
 1097: 
 1098:       if (dot_prod1*dot_prod2 > 0.0) return elems[0];
 1099:       else                           return elems[1];
 1100: 
 1101:  
 1102:    }
 1103: 
 1104:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1105:       // Given an element, returns the other element that shares this side
 1106:       return (elems[0] == elem) ? elems[1] : elems[0];
 1107:    }
 1108: 
 1109:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1110:       // Given a node, returns the other node that shares this side
 1111:       return (n1 == node) ? n2 : n1;
 1112:    }
 1113:  
 1114:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1115: 
 1116: 
 1117: 
 1118: 
 1119: };
