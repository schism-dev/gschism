 6438: #ifdef DONTCOMPILE
 6439: __device__ void computeVerticalAdvection(void) {
 6440:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6441: 
 6442:    sdbt(1:2,:,:)=0.d0
 6443: 
 6444:    const Side *side = FROM kernel;
 6445: 
 6446:    if(side->isDry) return;
 6447: 
 6448:    // If side is wet...
 6449: 
 6450: 
 6451:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6452:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6453:    double ws[nvrt] = {} // w @ side
 6454:    int icount = 0;
 6455:    for (int j=0; j<2; j++) {
 6456:       const Element *elem = side->elements[j];
 6457:        
 6458:       if(elem != nullptr) {
 6459:          icount++;
 6460:          for (int k=0; k<nvrt; k++) {
 6461:             ws[k] = ws[k] + elem->w[k];
 6462:          }
 6463:       }
 6464:    }  // for j
 6465: 
 6466:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6467:    ws = ws/icount;
 6468: 
 6469:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6470:    // Splines allow for a smooth transition between vertical levels.
 6471:    // Splines have continuity restrictions at the internal knots, but
 6472:    // we have to provide the 1st derivatives at the endpoints.
 6473:    const int kbs = side->kbs; 
 6474:    
 6475:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6476:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6477:    initCubicSpline(kbs, nvrt, side, ws, up)
 6478: 
 6479:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6480:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6481:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6482: 
 6483:    // Total advection (average onto side)
 6484:    const Node *node1 = side->nodes[0];
 6485:    const Node *node2 = side->nodes[1];
 6486:    for (int k=kbs(i); k<nvrt; k++) {
 6487: 
 6488:       if constexpr(ics==1) {
 6489:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6490:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6491:       } else {
 6492:          // XXX IMPLEMENT THIS
 6493:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6494:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6495:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6496:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6497:       }  // if ics
 6498: 
 6499: 
 6500:    }
 6501: }
 6502: #endif
 6503: 
 6504: 
 6505: extern "C" {
 6506:    __global__ void computeElemAverageGhat(void) {
 6507:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6508: 
 6509:       ELEM(elem);
 6510:       
 6511:       elem->ghat1= {0.0, 0.0};  
 6512: 
 6513:       if constexpr(ihydraulics != 0) {
 6514:          if (nhtblocks > 0 && elem->isblock) return;
 6515:       }
 6516: 
 6517:       if (elem->isDry) return;
 6518: 
 6519:       // Wet elements.
 6520:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6521:       // tidal potential, horizontal diffusion, and baroclinic etc
 6522:       // Remember to update both fb and F 
 6523:       // If ics=2, ghat1 are in eframe (ll)
 6524:       // cff1-3: coefficients for 2D/3D
 6525:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6526:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6527:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6528: 
 6529:       double av_cff1 = 0.0;  // av. for cff1
 6530:       double av_cff2 = 0.0;  // av. for cff2
 6531:       double av_cff3 = 0.0;  // av. for cff3
 6532:       double av_df = 0.0;  // av. for H^\alpha / H
 6533:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6534:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6535: 
 6536:       const int i34 = elem->i34;
 6537:       const int kb = elem->kb;
 6538: 
 6539:       for (int j=0; j<i34; j++) {
 6540:          // For each node and side in the element...
 6541: 
 6542:          const Node *node = elem->nodes[j];
 6543:          const Side *side = elem->sides[j];
 6544: 
 6545:          const double chi      = side->chi;
 6546:          const double veg_c2   = side->veg_c2;
 6547:          const double veg_beta = side->veg_beta;
 6548:          const double veg_h    = side->veg_h();
 6549:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6550: 
 6551:          // Node - const in elem
 6552:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6553:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6554: 
 6555:          if (elem->depth >= tip_dp) {
 6556:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6557:          }
 6558: 
 6559:          
 6560:          const double htot  = side->htot2();        // Total depth at the side
 6561:          const double zctr2 = side->zTopCanopy();  
 6562: 
 6563:          double cff1; 
 6564:          double cff2; 
 6565:          double cff3;   
 6566:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6567:          // coefficients applied to 2D/3D case 
 6568:             cff1 = side->hhat/htot;
 6569:             cff2 = 0.0;
 6570:             cff3 = 0.0;
 6571:          } else { //3D
 6572:             //Init for no-veg case
 6573:             cff1 = 1.0;
 6574:             cff2 = 1.0;
 6575:             cff3 = 0.0;
 6576: 
 6577:             if constexpr(iveg != 0) {
 6578:                // Computes coefficients used with vegetation terms G1, G2
 6579:                // cff1, cff3 are used for the first two terms in G1, G2:
 6580:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6581:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6582:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6583:                if(veg_h < 0.99*htot) { // submergent vegetation
 6584:                   cff1=1;
 6585:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6586:                   cff3 = veg_c;
 6587: 
 6588:                } else { // emergent vegetation
 6589:                   cff1 = 1.0/(1.0 + veg_c2);
 6590:                   cff2 = cff1;
 6591:                   cff3 = 0.0;
 6592: 
 6593:                }
 6594:             } // if iveg
 6595:          } //  2D/3D
 6596: 
 6597:          av_cff1 += cff1/i34;
 6598:          av_cff2 += cff2/i34;
 6599:          av_cff3 += cff3/i34;
 6600:          av_cff2_chi += cff2*chi/i34;
 6601:          av_cff3_chi += cff3*chi/i34;
 6602:          av_df += min(htot, veg_h)/(htot*i34);
 6603: 
 6604: 
 6605:          // btrack values: U^\star, U^{\star\alpha}
 6606:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6607:          Vector2 Ustar       = {0.0, 0.0}; 
 6608:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6609: 
 6610:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6611:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6612:          } else { //3D
 6613:             for (int k = side->kb; k < nvrt; k++) {
 6614:             
 6615:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6616:                Ustar += w2;
 6617: 
 6618:                if constexpr(iveg != 0) {
 6619:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6620:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6621:                        Ustar_alpha += zrat*w2; // XXXX
 6622:                    }
 6623:                }  // if iveg
 6624:             }  // for k
 6625:          }  //2D/3D
 6626:          
 6627: 
 6628:          // Add btrack & surface stress terms to \breve{G} first
 6629:          if constexpr(ics==1) {
 6630: 
 6631:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6632: 
 6633:          } else {
 6634:             // XXX IMPLEMENT THIS
 6635:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6636:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6637:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6638:          }  // if ics
 6639: 
 6640:          // Surface and bottom stress terms
 6641:          if constexpr(ics==1) {
 6642:             const Vector2 tau    = side->tau();
 6643:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6644: 
 6645:             // Term for surface and bottom stress
 6646:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6647: 
 6648:          } else {
 6649:             assert(false && "computeElemAverageGhat: Not implemented");
 6650:             // XXX IMPLEMENT THIS
 6651:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6652:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6653:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6654:             // tau_x=(vn1+tt1)/2.d0
 6655:             // tau_y=(vn2+ss1)/2.d0
 6656:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6657:          }  // if ics
 6658: 
 6659:          
 6660: 
 6661:          // All terms in F,F^\alpha,f_b except baroclinic
 6662:          // F, f_b: all explicit terms excluding vegetation 
 6663:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6664:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6665:          const double coriolis = side->coriolis;
 6666:          Vector2 F  =  coriolis*side->U;  // F_x
 6667:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6668:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6669: 
 6670:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6671:             
 6672:             for (int k = side->kb; k < nvrt; k++) {
 6673:                if (zctr2 > side->zc[k-1]) {
 6674:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6675:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6676:                    Fa +=  coriolis*w2*zrat;
 6677:                } // if zctr2
 6678:             } // k
 6679:          } // iveg
 6680: 
 6681:          // Integrate horizontal viscosity force vertically
 6682:          for (int k=side->kb + 1; k<nvrt; k++) {
 6683:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6684: 
 6685:             F += levelHorVisc;
 6686: 
 6687:             // Vegetation term
 6688:             if constexpr(iveg!=0) {
 6689:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6690:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6691:                   Fa += levelHorVisc*zrat;
 6692:                } 
 6693:             } // if iveg
 6694:          } // for k
 6695: 
 6696:          fb += side->nuGradU[side->kb];
 6697: 
 6698:          // Add to ghat1
 6699:          if constexpr(ics==2) {
 6700:             // XXX IMPLEMENT THIS
 6701:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6702:             // bigf1=vn1; bigf2=vn2
 6703:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6704:             // botf1=vn1; botf2=vn2
 6705:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6706:             // bigfa1=vn1; bigfa2=vn2
 6707:          } // if ics
 6708: 
 6709:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6710:       } // for j (nodes and sides)
 6711: 
 6712:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6713:          
 6714:       // Finish off terms in F, F^\alpha and f_b
 6715:       const double grav3 = elem->mean(&Node::grav2);
 6716:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6717: 
 6718: 
 6719:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6720:       for (int j=1; j<i34; j++) { 
 6721:          // For each side in the element...
 6722:          const Side *side = elem->sides[j];
 6723:          const double chi = side->chi;
 6724: 
 6725:          const double htot = side->htot2();
 6726:          const double veg_h = side->veg_h();
 6727:          const Vector2 F  = htot*fb;
 6728:          const Vector2 Fa = min(htot, veg_h)*fb;
 6729: 
 6730:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6731:       } // for j
 6732: 
 6733:       //botf1 etc are already in elem frame
 6734:       elem->ghat1 += tmp/i34;
 6735: 
 6736:       // Baroclinic force
 6737:       if constexpr(ibc==0) {
 6738:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6739: 
 6740:          Vector2 Fa = {0.0, 0.0};
 6741:          Vector2 intGradRho = {0.0, 0.0};
 6742:          
 6743:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6744:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6745:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6746: 
 6747:             // \in F [m^2/s/s]
 6748:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6749:          }
 6750: 
 6751:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6752:          const Vector2 F = av_df*Fa; //approx
 6753:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6754: 
 6755:       } // if ibc
 6756: 
 6757: 
 6758: 
 6759:    }
 6760: 
 6761: } // extern "C"
 6762: 
 6763: 
 6764: 
 6765: #ifdef DONTCOMPILE
 6766: __global__ void checkMassConservation(Tracers* sumtr) {
 6767: 
 6768:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6769: 
 6770:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6771: 
 6772:    Element *elem = &(mesh->localElemData[i]);
 6773: 
 6774:    // Skip dry elements
 6775:    if (elem->isDry) return;
 6776: 
 6777:    // Local sum array for this thread
 6778:    double localSum[N_TRACERS] = {0.0};
 6779: 
 6780:    // Sum over vertical levels for this element
 6781:    const int kbe = elem->kbe;
 6782:    const double area = elem->area;
 6783: 
 6784:    for (int k = kbe; k < nvrt; k++) {
 6785:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6786:       
 6787:       // Accumulate tracer mass
 6788:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6789:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6790:       }
 6791:    }
 6792: 
 6793:    
 6794: 
 6795:    //  This function returns per element sums. A reduction must be done on the host side.
 6796: }
 6797: 
 6798: 
 6799: __global__ void transport(void) {
 6800: 
 6801:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6802: 
 6803:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6804: 
 6805:    Element *elem = &(mesh->localElemData[ie]);
 6806: 
 6807:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6808: 
 6809:                for (int m=0; m<ntr; m++) {
 6810:                   for (int k=kbe(ie); k<nvrt; k++) {
 6811:                      // Calculate each polynomial's weight 
 6812:                      wm=0.d0; sum1=0.d0; 
 6813:                      wm1=0.d0; wm2=0.d0; 
 6814:                      for (int i=0; i<elem->nweno2; i++) {
 6815:                   
 6816:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6817:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6818:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6819:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6820:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6821:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6822:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6823:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6824:                      // -----------------Hu and Shu (1999)'s method----------------
 6825:                      b4=b1+b2+b3
 6826: 
 6827: //Error: add PRODUCTION CPP
 6828: #ifdef DEBUG
 6829:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6830:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6831:                     call parallel_abort(errmsg)
 6832:                   }
 6833: #endif
 6834: 
 6835:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6836:                   // !----test-------------- 
 6837:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6838:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6839:                   // !wm(i)=wm1(i)*wm2(i)
 6840:                   // !---------------------- 
 6841:                   sum1=sum1+wm(i)
 6842:                 } // end for i
 6843: 
 6844:                 wm=wm/sum1
 6845: 
 6846:                 for (int j=0; j<elem->i34; j++) {
 6847: 
 6848:                   const Side *side  = elem->sides[j];
 6849:                   const Node *node1 = side->n1;
 6850:                   const Node *node2 = side->n2;
 6851: 
 6852:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6853:                      trsd=0.d0
 6854:                      for (int kk=0; kk<nquad; kk++) {
 6855:                         for (int i=0; i<elem->nweno2; i++) {
 6856:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6857:                         } // end for i   
 6858:                      } // end for kk
 6859:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6860:                   } // outward flux
 6861:                } // end for j=1,i34(ie) ! side
 6862:             }
 6863:          }
 6864:               
 6865: 
 6866: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6867: //             //   calculate each polynomial's weight 
 6868: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6869: //                 wm=0.d0; sum1=0.d0
 6870: //                 do i=1,nweno1(ie) !for each polynomial
 6871: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6872: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6873: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6874: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6875: //                   wm(i)=b2
 6876: //                   sum1=sum1+b2
 6877: //                   !wm(i)=1.d0
 6878: //                   !sum1=sum1+1.d0
 6879: 
 6880: // // Error: PRODUCTION
 6881: // #ifdef DEBUG
 6882: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6883: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6884: //                     call parallel_abort(errmsg)
 6885: //                   endif
 6886: // #endif
 6887: 
 6888: //                 enddo !i
 6889: //                 wm=wm/sum1 !final weight
 6890: 
 6891:                 for (int j=0; j<elem->i34; j++) { // side
 6892:                   const Side *side = elem->sides[j];
 6893:                   const Node *node1 = side->n1;
 6894:                   const Node *node2 = side->n2;
 6895: 
 6896:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6897:                     trsd=0.d0
 6898:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6899:                       for (int i=0; i<elem->nweno1; i++) {
 6900:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6901:                       }
 6902:                     enddo //kk
 6903:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6904:                   } // outward flux
 6905:                 } // end for j=1,i34(ie) ! side
 6906:               } // end for k; ntr 
 6907: 
 6908:             else !simple upwind method
 6909:               do j=1,i34(ie)
 6910:                 jsj=elside(j,ie)
 6911:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6912:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6913:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6914:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6915:                   endif
 6916:                 enddo  !vertical layers
 6917:               enddo !j=1,i34(ie) ! side
 6918:             endif !order of accuracy
 6919: 
 6920:          //  enddo !ie
 6921: // !$OMP     end do
 6922: 
 6923: // !$OMP     master
 6924: //           !message passing
 6925: //           if (nproc>1) then
 6926: //             !make a copy of side concentrations
 6927: //             trsd_tmp0=trsd_tmp 
 6928: 
 6929: //             !this exchange routine swaps interface concentration between two partitions
 6930: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 6931: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 6932: 
 6933: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 6934: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 6935: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 6936: 
 6937: 
 6938: //             !This obtains final values for interface sides
 6939: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 6940: //       :    endif !nproc>1
 6941: //           !message passing end
 6942: // !$OMP     end master
 6943: // !$OMP     barrier
 6944: 
 6945: 
 6946: // !         Do advection; conc @ dry elem will not be changed
 6947: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
