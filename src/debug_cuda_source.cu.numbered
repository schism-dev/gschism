  240: __device__ __forceinline__ double2 operator*(const double2& v, const double s) {
  241:     return make_double2(v.x * s, v.y * s);
  242: }
  243: 
  244: __device__ __forceinline__ double2 operator*(const double s, const double2& v) {
  245:     return v * s;  // reuse the previous operator
  246: }
  247: 
  248: __device__ __forceinline__ double2 operator/(const double2& v, double s) {
  249:     return make_double2(v.x / s, v.y / s);
  250: }
