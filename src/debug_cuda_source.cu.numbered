 8105:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8106:       const Node *node = mesh->localNodeData + idx_node;
 8107: 
 8108:       res[idx_node] = node->mX;
 8109: 
 8110:    }
 8111:    
 8112: }
 8113: 
 8114: 
 8115: __global__ void returnB(double *res) {
