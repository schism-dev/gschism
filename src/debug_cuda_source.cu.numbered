 2110: // Helper functions for computing the local node index at a given offset from another.
 2111: __device__ __inline__ int nxq(int offset, int index, int size) {
 2112:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 2113:    // to the index to make it positive
 2114:    assert(index + offset + 16*size >= 0);
 2115:    return (index + offset + 16*size) % size;  
 2116: }
 2117: 
 2118: __device__ __inline__ int nxq(int index, int size) {
 2119:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 2120:    // to the index to make it positive
 2121:    assert(index + 16*size >= 0);
 2122:    return (index + 16*size) % size; 
 2123: }
