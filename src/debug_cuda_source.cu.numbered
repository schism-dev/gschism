 2788: 
 2789: __device__ void Node::updateKb(void) {
 2790: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2791: 
 2792:    if constexpr(ivcor == 1) return;
 2793: 
 2794: 
 2795:    if (isDry2()) return;
 2796: 
 2797:    if constexpr(ivcor == 2) {  // SZ coordinates
 2798:       
 2799:       // Compute bottom level index
 2800:       if (depth <= mesh->h_s) {
 2801:          kb = izlev;
 2802:          
 2803:       } else {
 2804:          kb = -1;
 2805:          int L = 0;
 2806:          int R = nzlev; 
 2807:          
 2808:          while (L <= R) {
 2809:             int M = (R + L) / 2;
 2810: 
 2811: 
 2812:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2813:             
 2814:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2815:                R = M;
 2816:             } else {
 2817:                L = M;
 2818:             }
 2819: 
 2820:             if (R - L == 1) {
 2821:                kb = L;
 2822:                break;
 2823:             }
 2824:          }
 2825:       }
 2826:    } 
 2827: }
 2828: 
 2829: 
 2830: __device__ __inline__ void Node::updateZCoordData(void) {
 2831: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2832: 
 2833:    if (isDry2()) {
 2834:       kb = -1;
 2835:       return;
 2836:    }
 2837: 
 2838:    if constexpr(ivcor == 2) {  // SZ coordinates
 2839:       
 2840:       // Compute bottom level index
 2841:       if (depth <= mesh->h_s) {
 2842:             kb = izlev;
 2843: 
 2844:       } else {
 2845:          kb = -1;
 2846:          for (int i = 0; i < nzlev - 1; i++) {
 2847:             // XXX Use binary search
 2848:             if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 2849:                kb = i;
 2850:                break;
 2851:             }
 2852:          }
 2853:       }
 2854:    } 
 2855:    else if (ivcor == 1) {  // Localized sigma
 2856:       // Do nothing
 2857:    }
 2858: 
 2859: }
 2860: 
 2861: 
 2862: __device__ double Node::compZCoord(int k) const {
 2863:    // Computes the z coordinate at level k.
 2864:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2865:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2866:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2867:    // used 
 2868:    
 2869:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2870: 
 2871:    if (isDry2()) return 0.0;
 2872: 
 2873:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2874: 
 2875:    if constexpr(ivcor == 2) {
 2876: 
 2877:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2878:       const double h_c = mesh->h_c;
 2879:       const double theta_f = mesh->theta_f;
 2880:       const double sinh_theta_f = mesh->sinh_theta_f;
 2881: 
 2882:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2883:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2884:       // once per time step/node.
 2885:       // CHECK: updateZCoordData
 2886: 
 2887:       //  To simplify comparisons, I define index versions of count variables.
 2888:       if      (k == ivrt)           return eta2; 
 2889:       else if (k == izlev)          return -hmod2;
 2890:       else if (k == kb)             return -depth;
 2891:       else if (k < izlev && k >= 0) return mesh->ztot[k];
 2892:       else if (k > izlev) {
 2893:          const int ksig = k - izlev;
 2894: 
 2895:          if (hmod2 <= h_c) {
 2896: 
 2897:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2898:          } 
 2899:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2900:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2901:             assert(false && "ZCOOR: invalid h_c\n");
 2902:          } 
 2903:          else {
 2904:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2905:                          h_c * mesh->sigma[ksig] + 
 2906:                          (hmod2 - h_c) * mesh->cs[ksig];
 2907:          }
 2908:       } else { 
 2909:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2910:       }
 2911: 
 2912:    }
 2913:    else if constexpr(ivcor == 1) {
 2914:       if (k == kb) return -depth;
 2915:       else if (k == nvrt-1) return eta2;
 2916:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2917:    }
 2918:    
 2919:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2920:    return 0.0;
 2921: }
 2922: 
 2923: 
 2924: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 2925:    // Computes the bottom drag Cd based on the selected nchi
 2926: 
 2927:    if constexpr(nchi == 0) {
 2928:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 2929:       Cd = drag;  // Read from drag file
 2930: 
 2931:    } else if constexpr(nchi == 1) {
 2932:       // 
 2933: 
 2934:       bool ltmp = false; // for WBL iteration
 2935: 
 2936:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 2937:       if (rough == 0.0) {
 2938:          Cd = 0.0;
 2939: 
 2940:       } else { //roughness >0 
 2941:          
 2942:          const double bthick_ori = z[kb + 1] - z[kb];  // thickness of bottom bnd layer
 2943:          const double bthick = max(dzb_min, bthick_ori);
 2944: 
 2945:          assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 2946: 
 2947:          const double tmp = 1.0/(2.5*log(bthick/rough));
 2948:          Cd = tmp*tmp;
 2949:         
 2950: 
 2951:       } // if rough
 2952: 
 2953: 
 2954:       // Ask Joseph XXXXX
 2955:       // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 2956:       // Output warning for WBL if iteration didnt converge
 2957: 
 2958: 
 2959:    } else if constexpr(nchi == -1) {
 2960:    // Manning 
 2961:       Cd = 0.0;
 2962: 
 2963:       if (isDry) return;
 2964: 
 2965:       const double htot = max(hmin_man, htot2()); 
 2966:       Cd = grav2*rmanning*rmanning/pow(htot, 0.333);
 2967: 
 2968:    } else {
 2969:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 2970:       
 2971:    } // if nchi
 2972: }
 2973: 
 2974: 
 2975: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2976:    // Checks if a side in on the boundary
 2977:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2978: 
 2979:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2980:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2981: 
 2982:    // Indices of the nodes that form the side
 2983:    const int n1 = side.n1->idx;
 2984:    const int n2 = side.n2->idx;
 2985:    isLand = false;
 2986:    
 2987: 
 2988:    // Check if the side is on a land boundary
 2989:    for (int i = 0; i < nland; i++) {
 2990:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2991:          // Consecutive nodes in the land boundary segment
 2992:          const int b1 = ilnd[i + j*nland];
 2993:          const int b2 = ilnd[i + (j + 1)*nland];
 2994: 
 2995:          assert(b1 != -1 && b2 != -1);
 2996: 
 2997:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2998:             
 2999:             isLand = true;
 3000:             return i;
 3001:          }
 3002:       }
 3003:    }
 3004: 
 3005:    // Check if the side is on an open boundary
 3006:    for (int i = 0; i < nope; i++) {
 3007:       for (int j = 0; j < nond[i] - 1; j++) {
 3008:          // Consecutive nodes in the open boundary segment
 3009:          const int b1 = iond[i + j*nope];
 3010:          const int b2 = iond[i + (j + 1)*nope];
 3011: 
 3012:          assert(b1 != -1 && b2 != -1);
 3013: 
 3014:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3015:             isLand = false;
 3016:             return i;
 3017:          }
 3018:       }
 3019:    }
 3020: 
 3021:    return -1;
 3022: }
 3023: 
 3024: 
 3025: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3026:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3027:                                     double *wind_rotate_angle, 
 3028:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3029:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3030:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3031:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3032:                                     double *drag, double *roughness, double *rmanning) {
 3033: 
 3034:    NODE(pnode);  
 3035:    const int i = idx_node;
 3036:    Node &node(*pnode);
 3037: 
 3038:    node.idx = i;
 3039: 
 3040:    const int idxNodeStart = nodeNeighNodesStart[i];
 3041:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3042:    node.numNodes = idxNodeEnd - idxNodeStart;
 3043:    node.nodes = nodeNeighNodes + idxNodeStart;
 3044:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3045: 
 3046: 
 3047: 
 3048:    const int idxElemStart = nodeNeighElemsStart[i];
 3049:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3050:    node.numElements = idxElemEnd - idxElemStart;
 3051:    node.elements = nodeNeighElems + idxElemStart;
 3052: 
 3053: 
 3054:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3055:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3056:       const int partNode = localNodePart[idxNodeGlobal]; 
 3057:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3058: 
 3059:       Node *node_ptr = nodes[partNode] + idxNode;
 3060:       
 3061:       nodeNeighNodes[idx] = node_ptr;
 3062:    }
 3063: 
 3064: 
 3065:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3066:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3067:       const int partElem = localElemPart[idxElemGlobal];
 3068:       const int idxElem  = localElemIndices[idxElemGlobal];
 3069: 
 3070:       Element *elem_ptr = elems[partElem] + idxElem;
 3071: 
 3072:       nodeNeighElems[idx] = elem_ptr;
 3073:    }      
 3074: 
 3075:    node.wind_angle = wind_rotate_angle[i];
 3076: 
 3077: 
 3078:    node.p.x   = node_coords[i * 3];
 3079:    node.p.y   = node_coords[i * 3 + 1];
 3080:    node.depth = node_coords[i * 3 + 2];
 3081: 
 3082:    if (use_ll) {
 3083:    node.lon = node_coords_ll[i * 2    ]*deg2rad;
 3084:    node.lat = node_coords_ll[i * 2 + 1]*deg2rad;
 3085:    }
 3086: 
 3087: 
 3088:    node.numSides = 0;
 3089: 
 3090:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3091:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3092:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3093:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3094:    else assert(false && "populateNodes: selected nchi not implemented.");
 3095:    
 3096:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3097:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3098: 
 3099:    
 3100:    // Links the node to the boundary information
 3101:    if (isbnd[i] >= 0) {
 3102:      
 3103:       // Get the index of the node boundary
 3104:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3105: 
 3106:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3107:       node.nodeBnd->node = &node;
 3108: 
 3109:       node.nodeBnd->sideBnd1 = nullptr;
 3110:       node.nodeBnd->sideBnd2 = nullptr;
 3111: 
 3112:       if (isbnd[i]>=0) {
 3113: 
 3114:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3115:          
 3116:          node.nodeBnd->segment->ifltype = (isbnd[i]==0)?3:0;
 3117:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3118: 
 3119:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3120:          node.nodeBnd->segment->clen  = nan("1");
 3121:          node.nodeBnd->segment->carea = nan("1");
 3122: 
 3123:       }
 3124:    } else {
 3125: 
 3126:       node.nodeBnd = nullptr; // For internal nodes
 3127: 
 3128:       if (isbnd[i] == landSegment) {
 3129:          node.nodeBnd = &landBoundaryNode;
 3130:          node.nodeBnd->segment = &landBoundarySegment;
 3131:       }
 3132:       
 3133:    }
 3134:    
 3135:    // XXXX GAUSSIAN HILL VELOCITIES
 3136: #ifdef GAUSSIAN_HILL_VELOCITIES
 3137:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3138:       constexpr double rot_per = 3000.0;
 3139:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3140:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3141:    // XXXXX
 3142: #endif
 3143: 
 3144: }
 3145: 
 3146: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3147:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3148:                                     double *wind_rotate_angle,   
 3149:                                     int *isdel, int *isidenode, int *isbnd,
 3150:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3151:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3152:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3153:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3154:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3155:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3156:                                     double *drag, double *roughness) {
 3157: 
 3158: 
 3159:    SIDE(pside);
 3160:    Side &side(*pside);
 3161:    const int i = idx_side;
 3162: 
 3163:    side.idx = i;  
 3164:    
 3165:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3166:    const double fc   = 2.0*omega_e*sin(sfea0);
 3167:    const double beta = 2.0*omega_e*cos(sfea0);
 3168: 
 3169:    // finding the pointer to the nodes that form the side
 3170:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3171:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3172: 
 3173:    const int locidx_n1 = localNodeIndices[idx_n1];
 3174:    const int locidx_n2 = localNodeIndices[idx_n2];
 3175:    const int part_n1 =   localNodePart[idx_n1];
 3176:    const int part_n2 =   localNodePart[idx_n2];
 3177: 
 3178:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3179:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3180: 
 3181:    // Counts the number of sides connected to each node
 3182:    side.n1->numSides++;
 3183:    side.n2->numSides++;
 3184: 
 3185:    // Normal, unitary vector to the side
 3186:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3187:    side.n = normalize(side.n);
 3188: 
 3189:    // Side boundary type
 3190:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3191:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3192: 
 3193:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3194:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3195:    {
 3196:       bool isLand = false;
 3197:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3198:       
 3199:       if (isbs > -1) {
 3200:          // assert(isLand || isbs>=0);
 3201:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3202: 
 3203:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3204: 
 3205:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3206:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3207: 
 3208:          assert (isLand == side.sideBnd->segment->isLand);
 3209: 
 3210:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3211:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3212:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3213: 
 3214:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3215:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3216:          
 3217:          side.sideBnd->side = &side;
 3218: 
 3219:       }
 3220:       else {
 3221:          side.sideBnd = nullptr;
 3222:       }
 3223:    }
 3224:    else 
 3225:    {
 3226:       side.sideBnd = nullptr;
 3227:    }
 3228: 
 3229: 
 3230:    // finding the pointer to the elements that share the side
 3231:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3232:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3233: 
 3234:    if (idx_e1 > -1) {
 3235:       const int locidx_e1 = localElemIndices[idx_e1];
 3236:       const int part_e1 =  localElemPart[idx_e1];
 3237:       side.elems[0] = elems[part_e1] + locidx_e1;
 3238: 
 3239:    }
 3240:    else {
 3241:       side.elems[0] = nullptr;
 3242:    }
 3243: 
 3244:    if (idx_e2 > -1) {
 3245:       const int locidx_e2 = localElemIndices[idx_e2];
 3246:       const int part_e2 =  localElemPart[idx_e2];
 3247:       side.elems[1] = elems[part_e2] + locidx_e2;
 3248:    }
 3249:    else {
 3250:       side.elems[1] = nullptr;
 3251:    }
 3252: 
 3253:    // Compute the center of the side
 3254:    side.center = 0.5*(side.n1->p + side.n2->p);
 3255: 
 3256:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3257:    side.shapiro = shapiro0;
 3258: 
 3259: #ifdef GAUSSIAN_HILL_VELOCITIES
 3260: // XXXX
 3261: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3262: constexpr double rot_per=3000.0;
 3263: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3264: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3265: // XXXXX      
 3266: #endif
 3267:    // Compute the z level at the center of the side
 3268:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3269:    
 3270:    // Compute the length of the side
 3271:    const Vector2 vLen = side.n2->p - side.n1->p;
 3272:    side.len = sqrt(dot(vLen, vLen));
 3273: 
 3274: 
 3275:    // Compute the Coriolis coefficient
 3276: 
 3277:    if constexpr(ncor == -1 || ncor == 0) {
 3278:       side.coriolis = coricoef;
 3279:    }
 3280:    else {
 3281:       const double sphi = side.lat();  // Latitude at the center of the side
 3282: 
 3283: // XXXXXX ERROR WHEN use_ll is false??????
 3284:       if constexpr(ics == 1) {
 3285:          // XXXXXXX
 3286:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3287:       }
 3288:       else {
 3289:          side.coriolis = 2.0*omega_e*sin(sphi);
 3290:       }
 3291: 
 3292:    }
 3293: }
 3294: 
 3295: 
 3296: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3297:    double *node_coords, double *node_coords_ll, bool use_ll,
 3298:    double *wind_rotate_angle,   
 3299:    int *isdel, int *isidenode, int *isbnd,
 3300:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3301:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3302:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3303:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3304:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3305:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3306:    double *drag, double *roughness) {
 3307: 
 3308:    ELEM(pelem);
 3309:    Element &elem(*pelem);
 3310:    const int i = idx_elem;
 3311: 
 3312:    elem.idx = i;
 3313: 
 3314:    for (int j = 0; j < i34[i]; j++) {
 3315:       const int idxNode = elnode[i*4 + j];  
 3316:       const int idxSide = elside[i*4 + j];
 3317:       
 3318:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3319:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3320: 
 3321:       // Find the neighboring element  
 3322:       if (elem.sides[j]->elems[0] == &elem) {
 3323:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3324:       }
 3325:       else {
 3326:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3327:       }
 3328:       
 3329:    }
 3330: 
 3331:    elem.i34 = i34[i];
 3332: 
 3333:    // Compute the centroid of the element and its depth
 3334:    Vector2 center = {0.0, 0.0};
 3335:    elem.depth = 0.0;
 3336:    for (int j = 0; j < i34[i]; j++) {
 3337: 
 3338:       center += elem.nodes[j]->p/i34[i];
 3339:       elem.depth  += elem.nodes[j]->depth/i34[i];
 3340:    }
 3341:    elem.center = center;
 3342: 
 3343:    
 3344:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3345:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3346: 
 3347:    elem.area = elem.computeSignedArea(); 
 3348:    elem.radius = sqrt(elem.area)/pi; 
 3349:    
 3350:    // Determines which way the normal vector to each side is oriented.
 3351:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3352:    for (int j = 0; j < i34[i]; j++)  
 3353:    {
 3354:       if (elem.sides[j]->elems[0] == &elem) {
 3355:          elem.ssign[j] =  1.0;
 3356:       }
 3357:       else {
 3358:          elem.ssign[j] = -1.0;
 3359:       }
 3360: 
 3361:    }
 3362: 
 3363:    // Derivatives of shape functions
 3364:    //  For ics=2, this is done inside element/ll frame XXX
 3365:    //  For quads, the derivative is evaluated at centroid
 3366:    for (int j = 0; j < elem.i34; j++) {
 3367:       const double area = elem.area;
 3368:       const int id2 = elem.nxq(1 + j);
 3369:       const int id3 = elem.nxq(2 + j);
 3370:       const int id4 = elem.nxq(3 + j);
 3371:       if (elem.isTri()) {
 3372:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3373:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3374:          // da1/dx = (y1 - y2)/(2*area)
 3375:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3376:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3377:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3378:       }
 3379:       else  { // Quad; evaluate at centroid
 3380:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3381:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3382:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3383:       } // if Tri
 3384: 
 3385:    } // for j   
 3386:    
 3387:    
 3388: 
 3389: }
 3390: 
 3391: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3392:                                             double *emo, double *efa, 
 3393:                                             double *umo, double *ufa, 
 3394:                                             double *vmo, double *vfa) {
 3395: 
 3396: 
 3397:    NODE_BND(nodeBnd);
 3398:    const int idx = idx_node_bnd;    
 3399: 
 3400:    nodeBnd->idx = idx;
 3401: 
 3402:    // Need to find the segment index and the index of the node on the segment
 3403:    int idxNode = -1;
 3404:    int iseg, i;
 3405:    for (iseg = 0; iseg < nope; iseg++) {
 3406:       // for each segment...
 3407:       for (i = 0; i < nond[iseg]; i++) {
 3408:          idxNode = iond[iseg + i*nope];
 3409:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3410:          
 3411:       }
 3412:    }
 3413: 
 3414:    assert(iseg < nope && "iseg is out of bounds");
 3415: 
 3416: found: // Jumped here when the node was found
 3417: 
 3418:    nodeBnd->isEssentialBC = true;
 3419:    nodeBnd->elbc = 0.0;
 3420: 
 3421:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3422: 
 3423:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 3424:       nodeBnd->efa[jfr] = efa[idx2];
 3425:       nodeBnd->emo[jfr] = emo[idx2];
 3426:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3427:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3428: 
 3429:    }
 3430:         
 3431: 
 3432: }
 3433: 
 3434: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 3435:                 double *node_coords, double *node_coords_ll, bool use_ll,
 3436:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 3437:                 int *isdel, int *isidenode, int *isbnd,
 3438:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 3439:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3440:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3441:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3442:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3443:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 3444:                 double *drag, double *roughness,
 3445:                 double *emo, double *efa, 
 3446:                 double *umo, double *ufa, 
 3447:                 double *vmo, double *vfa) {
 3448: 
 3449:    // printf("Populating mesh for partition %d\n", partNum);
 3450: 
 3451:    // XXXXXX THIS function does almost nothing. 
 3452: 
 3453:    nbs = *sharedIdxSideBoundary + 1;
 3454:    nbp = *sharedIdxNodeBoundary + 1;
 3455: 
 3456:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 3457: 
 3458: }
 3459: 
 3460: 
 3461: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3462:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3463:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3464: 
 3465: 
 3466:    NODE(node1);
 3467: 
 3468:  
 3469: // // Check bounds: ensure coeffMatrix is within allocated memory XXXX REMOVE
 3470: // const size_t max_elements = 63011136;
 3471: // const size_t offset = node1->coeffMatrix - mesh->coeffMatrixMem;
 3472: 
 3473: // if (offset < 0 || offset >= max_elements) {
 3474: 
 3475: //    printf("Offset is out of bounds: %llu, max_elements = %llu\n", 
 3476: //       (unsigned long long)offset, (unsigned long long)max_elements);
 3477: //    return;  // Out of bounds, skip
 3478: // }
 3479: 
 3480: // // Check if we have enough space for numNodes elements
 3481: // if (offset + node1->numNodes > max_elements) {
 3482: //    printf("Not enough space for numNodes elements: %llu, max_elements = %llu\n", 
 3483: //       (unsigned long long)(offset + node1->numNodes), (unsigned long long)max_elements);
 3484: //    return;  // Not enough space, skip
 3485: // }
 3486: 
 3487:    node1->clearMatrixRow();
 3488:    node1->qel = 0.0;
 3489: 
 3490:    // THIS IS FOR STRUCTURES XXX
 3491:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3492: 
 3493:    
 3494:    for (int j=0; j<node1->numElements; j++) {
 3495:       // For each element connected to the node...
 3496: 
 3497:       Element *elem = node1->elements[j];
 3498: 
 3499: 
 3500:       // Compute the average gravity
 3501:       const double grav3 = elem->mean(&Node::grav2);
 3502: 
 3503:       // Look at the documentation for the description of the terms in the following integrals
 3504: 
 3505:       // Integral I_1 
 3506:       // \bar{\breve{H}} 
 3507:       const double hhatb = elem->mean(&Side::hhat);        
 3508: 
 3509:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3510: 
 3511:       const int id1 = elem->nodeLocalIdx(node1); 
 3512:       const double area = elem->area;
 3513: 
 3514:       if (elem->isTri()) {
 3515: 
 3516:          // To clarify the notation in this section: 
 3517:          //   i stands for the node under consideration (node1)
 3518:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3519:          const int id2 = elem->nxq(1 + id1);
 3520:          const int id3 = elem->nxq(2 + id1);
 3521:          Node *node2 = elem->nodes[id2];
 3522:          Node *node3 = elem->nodes[id3];
 3523: 
 3524:          const Point2 x1 = node1->p;
 3525:          const Point2 x2 = node2->p;
 3526:          const Point2 x3 = node3->p;
 3527: 
 3528:          // integral of phi_i*phi_j
 3529:          const double ipp_ii = (1.0/6.0 )*area;
 3530:          const double ipp_ij = (1.0/12.0)*area;
 3531:          const double ipp_ik = (1.0/12.0)*area;
 3532: 
 3533:          // integral of [(grad phi_i) * (grad phi_j)]
 3534:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3535:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3536:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3537: 
 3538:          // Computes the different components of integral I_1 of each node with respect to node i.
 3539:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3540:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3541:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3542: 
 3543:          node1->addToSparseMatrix(node1, I1_ii);
 3544:          node1->addToSparseMatrix(node2, I1_ij); 
 3545:          node1->addToSparseMatrix(node3, I1_ik);
 3546: 
 3547:       }
 3548:       else { // Quad
 3549:          // XXX IMPLEMENT THIS
 3550:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3551: 
 3552:          // To clarify the notation in this section: 
 3553:          //   i stands for the node under consideration (node1)
 3554:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3555:          const int id2 = elem->nxq(1 + id1);
 3556:          const int id3 = elem->nxq(2 + id1);
 3557:          const int id4 = elem->nxq(3 + id1);
 3558:          Node *node2 = elem->nodes[id2];
 3559:          Node *node3 = elem->nodes[id3];
 3560:          Node *node4 = elem->nodes[id4];         
 3561: 
 3562:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3563:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3564:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3565:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3566:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3567: 
 3568:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3569:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3570:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3571:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3572:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3573: 
 3574:          // Computes the different components of integral I_1 of each node with respect to node i.
 3575:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3576:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3577:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3578:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3579: 
 3580:          node1->addToSparseMatrix(node1, I1_ii);
 3581:          node1->addToSparseMatrix(node2, I1_ij); 
 3582:          node1->addToSparseMatrix(node3, I1_ik);
 3583:          node1->addToSparseMatrix(node4, I1_il);
 3584:   
 3585: 
 3586: 
 3587:       
 3588:       } 
 3589: 
 3590:  
 3591:       // Integral I_4
 3592:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3593:       // Where
 3594:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3595: 
 3596:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3597:       // of U over the element.
 3598:       Vector2 Umean = {0.0, 0.0};
 3599:       for (int m=0; m<elem->i34; m++) {      
 3600:          const Side *side = elem->sides[m];
 3601: 
 3602:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3603:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3604:       }
 3605:       Umean = Umean/elem->i34;
 3606: 
 3607:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3608: 
 3609:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3610:       const double I_4_1 = dot(gradPhi_1, Umean);
 3611: 
 3612:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3613:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3614:      
 3615:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3616: 
 3617:       // Additional terms 
 3618:       double vnorm = 0.0;
 3619:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3620:          Vector3 ubed;
 3621:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3622: 
 3623:          Vector3 gradP = {0.0, 0.0, 1.0};
 3624:          for (int m=0; m < elem->i34; m++) {
 3625:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3626:            gradP += toVector3(gradP_2D, 0.0);
 3627:          }   
 3628:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3629:       } // imm==2
 3630: 
 3631:       if (elem->isTri()) {
 3632:          for (int l=0; l<3; l++) {
 3633:             double fac;
 3634: 
 3635:             Node *node = elem->nodes[l];
 3636: 
 3637:             fac = (node == node1) ? 2.0 : 1.0;
 3638:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3639:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3640:            
 3641:          }
 3642: 
 3643: 
 3644:          if (!elem->isDry) {
 3645:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3646: 
 3647:           node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3648: 
 3649:          }
 3650: 
 3651:       } // isTri
 3652:       else { // isQuad
 3653:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3654:          // for (int l=0; l<4; l++) {
 3655:          //   const Node *node = elem->nodes[l];
 3656: 
 3657:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3658:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3659: 
 3660:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3661:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3662:          // }
 3663: 
 3664:       } // isQuad
 3665: 
 3666: 
 3667:      node1->qel += (dt/elem->i34)*elem->vsource;
 3668:       
 3669: 
 3670:    } // for all elements connected to the node
 3671:    
 3672: 
 3673:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3674:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3675:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3676:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3677:       // If it is an open boundary node...
 3678: 
 3679:       // At least one open bnd side, maybe two
 3680:       for (int l=0; l<2; l++) { 
 3681: 
 3682:          // Gets each of the sides sharing the node. 
 3683:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3684: 
 3685:          // if (sideBnd == nullptr) continue; // Skip if no boundary side
 3686:          
 3687: 
 3688:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3689:          if (sideBnd != nullptr) {
 3690:             // If the side is on a boundary...
 3691: 
 3692:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3693: 
 3694:             // Get the boundary segment
 3695:             const BoundarySegment *sideSegment = sideBnd->segment;
 3696:             const Side *side = sideBnd->side;
 3697: 
 3698:             // Integral I_3
 3699:             if (sideSegment->ifltype != 0) {
 3700:             // Natural or Flather b.c.
 3701: 
 3702:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3703:                // especially for Flather b.c.
 3704:                double ri3 = 0.0;
 3705:                if (!side->isDry) {
 3706:                   // If the side is not dry
 3707:                   
 3708:                   // Computes the side flux of (uth, vth)
 3709:                   double Vn = 0.0;
 3710:                   for (int k = side->kb; k<nvrt-1; k++) {
 3711:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3712:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3713: 
 3714:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3715:                   }
 3716: 
 3717:                   ri3 = 0.5*side->len*Vn;
 3718:                }
 3719: 
 3720:                if (sideSegment->ifltype == -1) { // Flather 1
 3721: 
 3722:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3723:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3724: 
 3725:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3726:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3727:                   
 3728:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3729:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3730: 
 3731:                } 
 3732:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3733:                   // Reset ri3
 3734:                   ri3 = 0.0;
 3735: 
 3736:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3737: 
 3738:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3739: 
 3740:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3741:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3742: 
 3743:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3744:                   node1->addToSparseMatrix(node1, con0*2.0);
 3745:                   node1->addToSparseMatrix(node2, con0);
 3746: 
 3747:                } // if Flather or Discharge
 3748: 
 3749:                node1->qel -= thetai*dt*ri3;
 3750: 
 3751: 
 3752:             } // I_3
 3753:           
 3754: 
 3755:             // Integral I_5
 3756:             if(!side->isDry) {
 3757: 
 3758:                const double Unbar = dot(side->U, side->n);
 3759:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3760: 
 3761:             } // I_5
 3762: 
 3763:          } // if is boundary side
 3764: 
 3765:       } // for l
 3766: 
 3767:    } // if isbnd
 3768: 
 3769: 
 3770: }
 3771: 
 3772: 
 3773: 
 3774: extern "C" {
 3775:    __global__ void setupCGSolvers(double* diag_d, double* data_d, double* b_d, 
 3776:                                   float*  diag_f, float*  data_f, float*  b_f, 
 3777:                                   int* indices, int* indptr) {
 3778: 
 3779:       NODE(node);
 3780:       
 3781:       const int idx = node->idx;
 3782:       
 3783:       // Computes the index in the nzz array      
 3784:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 3785: 
 3786: 
 3787:       indptr[idx] = nzzIdx;
 3788:       indices[nzzIdx] = idx;
 3789: 
 3790:       data_d[nzzIdx]    = node->coeffDiag;
 3791:       data_f[nzzIdx]    = (float)node->coeffDiag;
 3792: 
 3793:       diag_d[idx] = 1.0/node->coeffDiag;
 3794:       diag_f[idx] = (float)(1.0/node->coeffDiag);
 3795: 
 3796:       b_d[idx] = node->qel;
 3797:       b_f[idx] = (float)node->qel;
 3798: 
 3799:       for (int k = 0; k < node->numNodes; ++k) {
 3800:          const Node* nb = node->nodes[k];
 3801: 
 3802:          const int j = nb->idx;
 3803: 
 3804:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 3805:          data_f[nzzIdx + k + 1]    = (float)node->coeffMatrix[k];
 3806: 
 3807:          indices[nzzIdx + k + 1] = j;
 3808:       }
 3809: 
 3810: 
 3811:    }
 3812: 
 3813: 
 3814: 
 3815:    __global__ void solverCopyResult(double* x) {
 3816:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 3817:       NODE(node);
 3818:       const int idx = node->idx;
 3819: 
 3820:       node->mX = x[idx];
 3821:    }
 3822: 
 3823: 
 3824:    __global__ void rollUpElevation(void) {
 3825: 
 3826:       NODE(node);
 3827: 
 3828:       node->eta1 = node->eta2;
 3829: 
 3830:    }
 3831: 
 3832: 
 3833:    __global__ void backtrackAllNodes(void) {
 3834: 
 3835:       // max/min # of sub-divisions
 3836:       const int ndelt_max = max(1.0, dt/dtb_min);
 3837:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3838: 
 3839:       // Removed all references to swild98 XXX
 3840:       // swild98=0.d0 !init
 3841: 
 3842: 
 3843:       SIDE(side);
 3844: 
 3845:       const int kb = side->kb;
 3846: 
 3847: 
 3848:       // Initialize btrack velocities to the actual velocities at the side 
 3849:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3850: 
 3851:       if (side->isDry) return;
 3852: 
 3853: 
 3854:       // Checks that at least one element is not dry
 3855:       const Element *elem1 = side->elems[0];
 3856:       const Element *elem2 = side->elems[1];
 3857: 
 3858: 
 3859:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3860:       
 3861:       // XXXXXX
 3862:       // !swild_tmp to store global coord. of the starting side
 3863:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3864:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3865:       // !Use sframe2 
 3866:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3867: 
 3868: 
 3869:       for (int k = kb; k < nvrt; k++) {
 3870:       //  Initialize (xt,yt,zt), nnel and vel.
 3871:       //  For ics=2, the coordinates are in local frames
 3872:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3873: 
 3874: 
 3875:          const int iadvf = side->iadv();  // Advection flag
 3876: 
 3877:          Point3 xt;
 3878:          if constexpr(ics==1) {
 3879:             xt = side->center3D(k); 
 3880:          }
 3881:          else // lat/lon; in side lat/lon frame
 3882:          {
 3883:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3884:          // XXX IMPLEMENT THIS
 3885:       //          xt=0.d0
 3886:       //          yt=0.d0
 3887:       //          !centroid coord. for nudging
 3888:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3889:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3890:          }  // ics
 3891: 
 3892: 
 3893: 
 3894:          // If on land or open boundary...
 3895:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3896:          
 3897:          const double vmag = length(side->u2[k]);
 3898: 
 3899:          if (vmag <= velmin_btrack) {
 3900:             // No activity 
 3901: 
 3902:             side->btu[k] = side->u2[k];
 3903:             
 3904:          } else {  // do btrack
 3905: 
 3906:             // Compute number of sub-divisions based on local gradients 
 3907:             // XXX IS THIS NECESSARY?
 3908:             double suma = 0.0;
 3909:             int icount = 0;
 3910:             for (int ii=0; ii<2; ii++) {
 3911: 
 3912:                const Element *elem = side->elems[ii];
 3913:                  
 3914:                if (elem == nullptr) continue;
 3915: 
 3916:                icount++;
 3917: 
 3918:                // Not strictly along z; in ll frame for ics=2
 3919: 
 3920:                double utmp[4];
 3921:                double vtmp[4];
 3922:                for (int jj = 0; jj < elem->i34; jj++) {
 3923: 
 3924:                   const Node *node = elem->nodes[jj];
 3925: 
 3926:                   if constexpr(ics==1) {
 3927:                      utmp[jj] = node->u2[k].x;
 3928:                      vtmp[jj] = node->u2[k].y;  
 3929:                   } else {
 3930:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3931:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3932:                   }
 3933:                } // for jj
 3934: 
 3935:                const Vector2 grad_u = elem->grad2(utmp); 
 3936:                const Vector2 grad_v = elem->grad2(vtmp);
 3937: 
 3938:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3939:             } // for ii
 3940: 
 3941:             assert(icount > 0 && "Impossible 77");
 3942: 
 3943:             // '4' is somewhat arbitrary
 3944:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3945: 
 3946:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3947:          
 3948: 
 3949:             Vector3 u_int = {0.0, 0.0, 0.0};
 3950: 
 3951:             side->btrack(k, dt, dtbk, u_int);
 3952:             side->btu[k] = toVector2(u_int);
 3953:                
 3954:          } // if vmag (do backtrack)
 3955: 
 3956:       } // for k=kb,nvrt-1
 3957: 
 3958:    }
 3959: 
 3960: } // extern "C"
 3961: 
 3962: template<int nc>
 3963: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3964: 
 3965: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3966: //
 3967: // a,b,c,rhs: input vectors and are not modified by this program.
 3968: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3969: // rhs is the r.h.s.
 3970: // n: actual rank of the system.
 3971: // rows in u() and rhs();
 3972: // u: output with nc columns (transposed to rows)
 3973: // gam: a working array.
 3974: //
 3975: // NOTES:
 3976: // This is a template function that allows for different numbers of columns in the rhs vector.
 3977: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3978: 
 3979:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3980:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3981: 
 3982:    double bet = b[0];
 3983:    if constexpr (nc == 1) {
 3984:       u[0] = rhs[0]/bet;
 3985:    } else {
 3986:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 3987:    }
 3988: 
 3989:    for (int j = 1; j < n; j++) {
 3990:       gam[j] = c[j - 1]/bet;
 3991:       bet = b[j] - a[j]*gam[j];
 3992: 
 3993:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3994: 
 3995:       if constexpr (nc == 1) {
 3996:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3997:       } else {
 3998:          for (int l = 0; l < nc; l++) {
 3999:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4000:          }
 4001:       }
 4002:    }
 4003: 
 4004:    // Back-substitution
 4005:    for (int j = n - 2; j >= 0; j--) {
 4006:       if constexpr (nc == 1) {
 4007:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4008:       } else {
 4009:          for (int l = 0; l < nc; l++) {
 4010:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4011:          }
 4012:       }
 4013:    }
 4014: }
 4015: 
 4016: 
 4017: 
 4018: // Helper function that contains the core algorithm
 4019: template<typename XAccessor, typename YAccessor>
 4020: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4021:                                     double  yp_top, double  yp_bot, 
 4022:                                     CubicSpline &spline) {
 4023:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4024:    // 
 4025:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4026:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4027:    //
 4028:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4029:    // 
 4030:    // Inputs: 
 4031:    //            n: dimension for x etc; # of data pts (>=2);
 4032:    //            getX, getY: functions to access x,y coordinates
 4033:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4034:    //     Output: 
 4035:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4036: 
 4037:    const int n = k2 - k1 + 1;
 4038:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4039: 
 4040:    // Allocate memory for the splines
 4041:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4042:    spline.x   = new double[n];
 4043:    spline.y   = new double[n];
 4044:    spline.yp  = new double[n];
 4045:    spline.ypp = new double[n];
 4046: 
 4047:    for (int k=k1; k<=k2; k++) {
 4048:       spline.x[k] = getX(k);
 4049:       spline.y[k] = getY(k);
 4050:    }
 4051: 
 4052:    // This is to simplify expressions later
 4053:    double *x = spline.x;
 4054:    double *y = spline.y;
 4055: 
 4056:    double *a = nullptr;
 4057:    double *b = nullptr;
 4058:    double *c = nullptr;
 4059:    double *gam = nullptr;
 4060:    double *rhs = nullptr;
 4061:    
 4062: 
 4063:       a = new double[n];   // Lower diagonal
 4064:       b = new double[n];   // Diagonal
 4065:       c = new double[n];   // Upper diagonal
 4066:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4067:       rhs = new double[n]; // Right-hand side
 4068: 
 4069:    for (int k=k1; k<=k2; k++) {
 4070:       if (k == k1) {
 4071:          // Bottom level
 4072:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4073:          b[k] = (x[k+1] - x[k])/3.0;
 4074:          c[k] = b[k]/2.0;
 4075:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4076:       } else if (k == n - 1) {
 4077:          // Top level (surface)
 4078:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4079:          b[k] = (x[k] - x[k-1])/3.0;
 4080:          a[k] = b[k]/2.0;
 4081:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4082:       } else {
 4083:          // Intermediate levels
 4084:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4085:          b[k] = (x[k+1] - x[k-1])/3.0;
 4086:          a[k] = (x[k  ] - x[k-1])/6.0;
 4087:          c[k] = (x[k+1] - x[k  ])/6.0;
 4088:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4089:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4090:       }
 4091:    }
 4092: 
 4093:    // Solve the tridiagonal system
 4094:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4095:    
 4096:    spline.yp[k1] = yp_bot;
 4097:    spline.yp[k2] = yp_top;
 4098: 
 4099:    // Compute rest of 1st derivatives using the splines
 4100:    for (int k=k1+1; k<k2; k++) {
 4101:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4102:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4103:    }
 4104:    
 4105:    delete[] a;
 4106:    delete[] b;
 4107:    delete[] c;
 4108:    delete[] gam;
 4109:    delete[] rhs;
 4110: 
 4111: }
 4112: 
 4113: // Array version
 4114: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4115:                                 double y_top, double y_bot, 
 4116:                                 CubicSpline &spline) {
 4117:    auto getX = [x] (int k) { return x[k]; };
 4118:    auto getY = [y] (int k) { return y[k]; };
 4119:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4120: }
 4121: 
 4122: // Lambda version - allows custom access patterns
 4123: template<typename XFunc, typename YFunc>
 4124: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4125:                                 double y_top, double y_bot,
 4126:                                 CubicSpline &spline) {
 4127:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4128: }
 4129: 
 4130: 
 4131: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 4132: {
 4133:    assert("Not implemented");
 4134: 
 4135:    return 0.0;
 4136: }
