 2413: 
 2414: 
 2415: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2416: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2417: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2418: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2419:    Vector2 grad = {0.0, 0.0};
 2420:    int count = 0;
 2421: 
 2422:    if constexpr(ics == 2) assert(false && "computeHorGradientAtSide: ics = 2 not implemented");
 2423: 
 2424:    // First element
 2425:    if (elems[0] != nullptr && condition(elems[0])) {
 2426:       grad += elems[0]->grad2(field);
 2427:       count++;
 2428:    }
 2429: 
 2430:    // Second element
 2431:    if (elems[1] != nullptr && condition(elems[1])) {
 2432:       grad += elems[1]->grad2(field);
 2433:       count++;
 2434:    }
 2435: 
 2436:    if (count > 0) {
 2437:       grad = grad/count;
 2438:    }
 2439:    
 2440:    return grad;
 2441: }
 2442: 
 2443: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2 + n2->grav2); }
 2444: __inline__ __device__ int     Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 2445: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 2446: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1 + n2->eta1); }
 2447: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth + n2->depth); } 
 2448: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 2449: 
 2450: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 2451: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 2452: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 2453: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 2454: 
 2455: 
 2456: __inline__ __device__ double  Side::Cd(void)      const { if constexpr(nchi != 0) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 2457: 
 2458: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 2459: 
 2460: /**
 2461:  * This method performs backtracking from the side center until a time -dt back in time 
 2462:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2463:  * intermediate point.
 2464:  *
 2465:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2466:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2467:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2468:  * remaining time.
 2469:  * 
 2470:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2471:  * 
 2472:  * @param uuint, vvint, wwint: Velocities at the final point
 2473:  * @param jlev: Level at which the backtracking is performed
 2474:  * @param dt, dtbk: Tracking timesteps
 2475:  * @return: True if the backtracking was successful, false otherwise
 2476:  */
 2477: __inline__ __device__ bool Side::btrack(
 2478:       int jlev,
 2479:       double dt,            // Tracking time
 2480:       double dtbk,          // Tracking timestep
 2481:       Vector3 &u_int        // Velocities at the initial point
 2482: ) const {
 2483: 
 2484:    // Start from side center
 2485:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2486:  
 2487: 
 2488:    double time_rm = dt; // Remaining time
 2489: 
 2490: 
 2491:    // // Initialize outputs XXX
 2492:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2493:    //    sclr[i] = 0.0;
 2494:    // }
 2495: 
 2496: 
 2497:    // Initial velocities
 2498:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 2499: 
 2500:    // Find the element that is in the direction opposite to the velocity
 2501:    Element* curElem = findElementTowards(toVector2(u_int));
 2502: 
 2503:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2504:    if (curElem == nullptr) {
 2505:       // Make velocity parallel to the side
 2506:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2507:       u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2508:       curElem = otherElem(curElem);
 2509:       
 2510:    }
 2511: 
 2512: 
 2513: 
 2514:    const int MAX_ITERATIONS = 1000; 
 2515:    Element* nextElem = curElem;
 2516:    int iter = 0;
 2517:    while(true) {
 2518: 
 2519:       // Calculate timestep
 2520:       double dtb = min(dtbk, time_rm);
 2521: 
 2522:       // Next point in the backtracking curve
 2523:       Point3 xt = x0 - dtb*u_int;
 2524: 
 2525: 
 2526:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, this);
 2527:       assert(found && "Backtracking failed in btrack");
 2528: 
 2529:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2530:                       // then time_rm needs to be increased by the unused time.
 2531:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2532: 
 2533:       // The current point becomes the next segment's starting point.
 2534:       x0 = xt;
 2535:  
 2536:       curElem = nextElem;
 2537: 
 2538:       iter++;
 2539:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2540:    }
 2541: 
 2542: 
 2543: }
 2544: 
 2545: 
 2546: 
 2547: // /**
 2548: //    For a point (x1,y1) inside the element and a line segment (x1,y1)-(x2,y2), find the intersection point 
 2549: //    (xIntersect,yIntersect) and the side (intersectingSide) that it intersects.
 2550: 
 2551: //    Inputs:
 2552: //    @param x1, y1: point inside the element
 2553: //    @param x2, y2: other end of the line segment
 2554: 
 2555: //    Outputs:
 2556: //    @param intersectingSide:  side that intersects the line segment
 2557: //    @param nextElement: element that contains the intersection point
 2558: //    @param xIntersect, yIntersect: intersection point  
 2559: 
 2560: //    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 2561: //    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 2562: //    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 2563: 
 2564: //    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 2565: //    (Delta) being zero.
 2566: 
 2567: //    The intersection point happens when:
 2568: //    tt1(x2-x1) - tt2(x4-x3) = x3-x1
