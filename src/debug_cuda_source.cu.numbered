  733: struct Element {
  734: 
  735:    // Geometry information
  736:    int idx;                   // Index of the element
  737:    int i34;                   // Number of sides for the element 
  738:    Side *sides[4];            // Sides of the element
  739:    Node *nodes[4];            // Nodes of the element
  740:    Element *nghbElems[4];     // Neighbors of the element
  741: 
  742:    int kb;                    // Bottom index of the element
  743:    double area;               // Area of the element
  744:    double ssign[4];           // Sign associated with each side of an element
  745:    double radius;             // Element equivalent radii
  746: 
  747:    Frame<ics> frame;
  748: 
  749:    Vector2 gradPhi[4];        // Derivatives of shape functions
  750:    Vector2 gradEta;           // Gradient of free surface elevation
  751:    Vector2 gradPr;            // Gradient of pressure    
  752:    Vector2 gradETP;           // Gradient of Earth Tidal Potential    XXXXX Really used?
  753: 
  754:    bool isDry;                // True if the element is dry
  755: 
  756:    Point2 center;            // Element center coordinates (global coordinates)
  757: 
  758:    double depth;              // Depth at element (min of all nodes)
  759:    double z[nvrt];            // z-coord  (local frame - vertical up)
  760: 
  761:    // Physical information
  762:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  763: 
  764:    static const bool isblock = false;              // Always false
  765: 
  766:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  767:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  768: 
  769:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  770:    
  771: 
  772:    double vsource;            // Volumetric source/sink term [m^3/s]
  773: 
  774:    double rho[nvrt];          // Density at each prism center
  775:    double rho_mean[nvrt];     // Mean density at each prism center
  776:    CubicSpline rho_spl;
  777:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  778:    double rho_z[nvrt];        // First derivative of density at each prism center
  779:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  780:    
  781: 
  782:    __inline__ __device__ Point2 outputCoords(void) const;
  783: 
  784:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }  
  785: 
  786:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
  787:    // If ics == 2, convert the global point to the local frame of the element
  788:       
  789:       if constexpr (ics == 1) {
  790:          return p;
  791:       } else {
  792:          const Point3 c = {center.x, center.y, centerZ()};
  793:          return frame.G2L(p - c);
  794:       }
  795:    }
  796: 
  797:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
  798:    // If ics == 2, convert the local point to a global point
  799:       
  800:       if constexpr (ics == 1) {
  801:          return p;
  802:       } else {
  803:          const Point3 c = {center.x, center.y, centerZ()};
  804:          return c + frame.L2G(p);
  805:       }
  806:    }
  807: 
  808:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  809:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  810: 
  811:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  812:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  813: 
  814:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  815:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  816:       // Find the local index of the node in the element (0,1,2,3)
  817:       int res = __ffs((nodes[0] == node) | 
  818:                      ((nodes[1] == node) << 1) | 
  819:                      ((nodes[2] == node) << 2) | 
  820:                      ((nodes[3] == node) << 3)) - 1;
  821:       
  822:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  823:       return res;  
  824:    }
  825: 
  826:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  827:       // Find the local index of the side in the element (0,1,2,3)
  828:       int res = __ffs((sides[0] == side) | 
  829:                      ((sides[1] == side) << 1) | 
  830:                      ((sides[2] == side) << 2) | 
  831:                      ((sides[3] == side) << 3)) - 1;
  832:       
  833:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  834:       return res;
  835:    }
  836: 
  837:    __inline__ __device__ int findLevel(double z1, int k) const {
  838:       // Starting at index k, find sequentially the level that contains z
  839: 
  840:       // For testing purposes, forgets k and performs a full search.
  841:       for (k = kb; k < nvrt - 1; k++) {
  842:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
  843:       }
  844:       return nvrt - 2;
  845: 
  846: 
  847:       // if z is already betweeen z[k] and z[k+1], return k
  848:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
  849:       else if (z1 <  z[k]) { 
  850:          // Search for increasing levels
  851:          for (int kk = k; kk < nvrt - 1; kk++) {
  852:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  853:          }
  854:          return nvrt - 1;
  855:       }
  856:       else {
  857:          // Search for decreasing levels
  858:          for (int kk = k; kk >= kb; kk--) {
  859:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  860:          }
  861:          return 0;
  862:       }
  863:    }
  864: 
  865:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
  866:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
  867: 
  868: 
  869:    __device__ __forceinline__ double centerZ(void) const;
  870: 
  871:    // "Local" horizontal coordinates at the nodes. They are computed from the 3D global node coordinates. For ics == 1 and 2
  872:    // Local is in quotes because for ics == 1, the coordinates are unchanged. It just means that in these coordinates, the element is horizontal.
  873:    __device__ __forceinline__ Point2 getLocalHorizontalNodePosition(int idxNode) const;
  874:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2, 
  875:                                                                        const Vector3& c, const Frame<ics>& dstFrame,int idx = 0) const;
  876:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2, int idx = 0) const;
  877:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3,
  878:                                                                        const Vector3& c, const Frame<ics>& dstFrame) const;
  879:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const;
  880: 
  881: 
  882:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idxNode = 0,1,2,3)
  883:    __device__ __forceinline__ Point2 GaussPoint(int idxNode) const {
  884:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
  885:        assert(idxNode >= 0 && idxNode < 4 && "GaussPoint: idxNode out of range");
  886:        const double eta = (idxNode & 1) ? +g : -g;
  887:        const double xi  = (idxNode & 2) ? +g : -g;
  888:        return {eta, xi};
  889:    }  
  890: 
  891: 
  892: 
  893:    // Shape function Phi at a given point p = (eta,xi), idxNode = node index 0,1,2,3
  894:    __device__ __forceinline__ double Phi_quad(int idxNode, Point2 p) const {
  895:       return 0.25*(1.0 + p.x*eta_n(idxNode))*(1.0 + p.y*xi_n(idxNode));
  896:    }
  897: 
  898:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi)
  899:    __device__ __forceinline__ double dPhi_dxi_quad(int idxNode, Point2 p) const {
  900:       return 0.25*xi_n(idxNode)*(1.0 + p.x*eta_n(idxNode));
  901:    }   
  902: 
  903:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
  904:    __device__ __forceinline__ double dPhi_deta_quad(int idxNode, Point2 p) const {
  905:       return 0.25*(1.0 + p.y*xi_n(idxNode))*eta_n(idxNode);
  906:    }      
  907:    
  908:    __inline__ __device__ double detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
  909: 
  910:    __inline__ __device__ double detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
  911: 
  912:    __inline__ __device__ double detJ_quad(Point2 p, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const 
  913:          { return (1.0/4.0)*area + detJ_eta_quad(x0, x1, x2, x3)*p.x+ detJ_xi_quad(x0, x1, x2, x3)*p.y; }
  914: 
  915:    // Check if the element is dry using the more up-to-date elevation.
  916:    __inline__ __device__ bool isDry2(void) const;
  917: 
  918:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  919: 
  920:    __forceinline__ __device__ bool inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const;
  921: 
  922:    __inline__ __device__ double computeSignedArea(void) const;
  923: 
  924: 
  925:    enum EFixIf { fiNo, fiOnlyInside, fiAnywhere };
  926: 
  927:    __device__ bool computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegShapeCoords = fiNo, const Side *origSide = nullptr) const;
  928:    
  929:    __device__ __forceinline__ void shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const;
  930: 
  931: 
  932:    __device__ __forceinline__ double intPhiPhiTri(int i, int j) const;
  933: 
  934:    __device__ __forceinline__ double intGradPhiGradPhiTri(int i, int j) const;
  935: 
  936:    __device__ __forceinline__ double intPhiPhiQuad(int i, int j, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
  937: 
  938:    __device__ __forceinline__ double intGradPhiGradPhiQuad(int i1, int i2, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
  939: 
  940:    __device__ __forceinline__ Vector2 grad2(double *a) const
  941:    {
  942:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  943:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  944:       if (isQuad()) {
  945:          gx += a[3]*gradPhi[3].x;
  946:          gy += a[3]*gradPhi[3].y;
  947:       }
  948:       return {gx, gy};
  949:    }
  950: 
  951:    __device__ __forceinline__ Vector2 grad2(double Node::* field) const
  952:    {
  953:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  954:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  955:       if (isQuad()) {
  956:          gx += (nodes[3]->*field)*gradPhi[3].x;
  957:          gy += (nodes[3]->*field)*gradPhi[3].y;
  958:       }
  959:       return {gx, gy};
  960:    }
  961: 
  962:    __device__ __forceinline__ Vector3 n(int k, double &area3D) const;
  963:    __device__ __forceinline__ Vector3 n(int k) const {
  964:       double area3D;
  965:       return n(k, area3D);
  966:     }
