 6055:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 6056: 
 6057:       NODE(node);
 6058: 
 6059:       node->ETP = 0.0;
 6060: 
 6061:       if constexpr(ntip == 0) return;
 6062: 
 6063:       // For all tidal potential components
 6064:       for (int j=0; j<ntip; j++) {
 6065: 
 6066:          const double nodeETP = node->computeETP(j, time, tfreq, tamp, tnf, tear, jspc);
 6067: 
 6068:          node->ETP += nodeETP;
 6069: 
 6070:          if constexpr(iloadtide==1) { // loading tide
 6071:             assert(false && "Loading tide not implemented");
 6072:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 6073:          }
 6074:          
 6075:       }
 6076: 
 6077:      
 6078:    }
