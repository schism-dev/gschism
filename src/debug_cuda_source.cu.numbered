 2376: /**
 2377:  * This method performs backtracking from the side center until a time -dt back in time 
 2378:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2379:  * intermediate point.
 2380:  *
 2381:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2382:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2383:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2384:  * remaining time.
 2385:  * 
 2386:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2387:  * 
 2388:  * @param uuint, vvint, wwint: Velocities at the final point
 2389:  * @param jlev: Level at which the backtracking is performed
 2390:  * @param dt, dtbk: Tracking timesteps
 2391:  * @return: True if the backtracking was successful, false otherwise
 2392:  */
 2393: __inline__ __device__ bool Side::btrack(
 2394:       int jlev,
 2395:       double dt,            // Tracking time
 2396:       double dtbk,          // Tracking timestep
 2397:       Vector3 &u_int        // Velocities at the initial point
 2398: ) const {
 2399: 
 2400:    // Start from side center
 2401:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2402: 
 2403:  
 2404:    double time_rm = dt; // Remaining time
 2405: 
 2406: 
 2407:    // // Initialize outputs XXX
 2408:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2409:    //    sclr[i] = 0.0;
 2410:    // }
 2411: 
 2412: 
 2413:    // Initial velocities
 2414:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 2415: 
 2416:    // Find the element that is in the direction opposite to the velocity
 2417:    Element* curElem = findElementTowards(toVector2(u_int));
 2418: 
 2419: 
 2420:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2421:    if (curElem == nullptr) {
 2422:       // Make velocity parallel to the side
 2423:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2424:       // u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2425:       curElem = otherElem(curElem);
 2426:       
 2427:    }
 2428: 
 2429: // Nudges it towards the circumcenter
 2430: // printf("0{{jlev = %d}} side->idx = %d, x0 = %.15e,%.15e,%.15e\n", jlev, idx, x0.x, x0.y, x0.z);
 2431: Vector2 xcirc = {(curElem->nodes[0]->p.x + curElem->nodes[1]->p.x + curElem->nodes[2]->p.x)/3.0,
 2432:                  (curElem->nodes[0]->p.y + curElem->nodes[1]->p.y + curElem->nodes[2]->p.y)/3.0};
 2433: const double eps = 9.013e-3;                 
 2434: x0.x = xcirc.x*eps + (1 - eps)*x0.x;
 2435: x0.y = xcirc.y*eps + (1 - eps)*x0.y;
 2436: 
 2437: 
 2438: 
 2439:    const int MAX_ITERATIONS = 1000; 
 2440:    Element* nextElem = curElem;
 2441:    int iter = 0;
 2442:    while(true) {
 2443: 
 2444:       // Calculate timestep
 2445:       double dtb = min(dtbk, time_rm);
 2446: 
 2447:       // Next point in the backtracking curve
 2448:       Point3 xt = x0 - dtb*u_int;
 2449:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, this);
 2450:       assert(found && "Backtracking failed in btrack");
 2451: 
 2452:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2453: 
 2454:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2455:                       // then time_rm needs to be increased by the unused time.
 2456: 
 2457:       // If the velocity is too small, we stop the backtracking
 2458:       const double vmag = length(toVector2(u_int));
 2459:       if (vmag <= velmin_btrack) break;
 2460: 
 2461:       // The current point becomes the next segment's starting point.
 2462:       x0 = xt;
 2463:  
 2464:       curElem = nextElem;
 2465: 
 2466:       iter++;
 2467:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2468:    }
 2469: 
 2470: 
 2471: }
 2472: 
 2473: 
 2474: 
 2475: // /**
 2476: //    For a point (x1,y1) inside the element and a line segment (x1,y1)-(x2,y2), find the intersection point 
 2477: //    (xIntersect,yIntersect) and the side (intersectingSide) that it intersects.
 2478: 
 2479: //    Inputs:
 2480: //    @param x1, y1: point inside the element
 2481: //    @param x2, y2: other end of the line segment
 2482: 
 2483: //    Outputs:
 2484: //    @param intersectingSide:  side that intersects the line segment
 2485: //    @param nextElement: element that contains the intersection point
 2486: //    @param xIntersect, yIntersect: intersection point  
 2487: 
 2488: //    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 2489: //    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 2490: //    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 2491: 
 2492: //    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 2493: //    (Delta) being zero.
 2494: 
 2495: //    The intersection point happens when:
 2496: //    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 2497: //    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 2498:    
 2499: //    Assumption: the 4 points (including those of the side segment) are different.
 2500: //    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 2501: //    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 2502: //    If true, (xIntersect,yIntersect) is the intersection.				
 2503: //    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 2504: // **/
 2505: // __inline__ __device__ bool Element::findPathIntersection(double x1, double y1, double x2, double y2, 
 2506: //                                                          Side& intersectingSide, Element& nextElement,
 2507: //                                                          double& xIntersect, double& yIntersect) {
 2508: //    for (int i = 0; i < i34; i++) {
 2509: //       const double x3 = nodes[i]->x;
 2510: //       const double y3 = nodes[i]->y;
 2511: //       const double x4 = nodes[nxq(i+1)]->x;
 2512: //       const double y4 = nodes[nxq(i+1)]->y;
 2513: 
 2514: //       const Side& side = sides[i];
 2515: 
 2516: //       xIntersect=-1.e25;
 2517: //       yIntersect=-1.e25;
 2518: 
 2519: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 2520: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 2521: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 2522: 
 2523: //       if (delta != 0.0) {
 2524: //          // Solves the two linear equations for tt1 and tt2
 2525: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2526: //          const double tt2 = delta2/delta;
 2527: 
 2528: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 2529: //          // Similarly, we use tt2 to compute the intersection point.
 2530: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 2531: //             xIntersect = x3 + (x4 - x3)*tt2;
 2532: //             yIntersect = y3 + (y4 - y3)*tt2;
 2533: 
 2534: //             intersectingSide = side;
 2535: //             nextElement = nghbElems[i];
 2536: 
 2537: //             return true;
 2538: //          }
 2539:       
 2540: //       }
 2541: //       else {
 2542: //          // The two segments are parallel
 2543: //          return false;
 2544: //       }
 2545: 
