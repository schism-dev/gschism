  161: // VECTOR/POINT operations ---------------------------------------------------------------------------
  162: 
  163: using Vector2 = double2; 
  164: using Vector3 = double3;
  165: using Point2  = double2;
  166: using Point3  = double3;
  167: 
  168: __device__ __host__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
  169:     return make_double2(a.x + b.x, a.y + b.y);
  170: }
  171: 
  172: __device__ __host__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
  173:     a.x += b.x;
  174:     a.y += b.y;
  175:     return a;
  176: }
  177: 
  178: __device__ __host__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
  179:     return make_double2(a.x - b.x, a.y - b.y);
  180: }
  181: 
  182: __device__ __host__ __forceinline__ double2 operator-=(double2& a, const double2& b) {
  183:     a.x -= b.x;
  184:     a.y -= b.y;
  185:     return a;
  186: }
  187: 
  188: __device__ __host__ __forceinline__ double2 operator*(const double2& v, const double s) {
  189:     return make_double2(v.x * s, v.y * s);
  190: }
  191: 
  192: __device__ __host__ __forceinline__ double2 operator*(const double s, const double2& v) {
  193:     return v * s;  // reuse the previous operator
  194: }
  195: 
  196: __device__ __host__ __forceinline__ double2 operator/(const double2& v, double s) {
  197:     return make_double2(v.x / s, v.y / s);
  198: }
  199: 
  200: __device__ __host__ __forceinline__ double length(const double2& v) {
  201:     return sqrt(v.x*v.x + v.y*v.y);
  202: }
  203: 
  204: __device__ __host__ __forceinline__ double2 normalize(const double2& v) {
  205:     return v / length(v);
  206: }
  207: 
  208: __device__ __host__ __forceinline__ double dot(const double2& v, const double2& w) {
  209:     return v.x*w.x + v.y*w.y;
  210: }
  211: 
  212: __device__ __host__ __forceinline__ double cross(const double2& v, const double2& w) {
  213:     return v.x*w.y - v.y*w.x;
  214: }
  215: 
  216: __device__ __host__ __forceinline__ double2 rot90(const double2& a) {
  217:     return make_double2(a.y, -a.x);
  218: }
  219: 
  220: __device__ __host__ __forceinline__ double3 operator+(const double3& a, const double3& b) {
  221:     return make_double3(a.x + b.x, a.y + b.y, a.z + b.z);
  222: }
  223: 
  224: __device__ __host__ __forceinline__ double3 operator+=(double3& a, const double3& b) {
  225:     a.x += b.x;
  226:     a.y += b.y;
  227:     a.z += b.z;
  228:     return a;
  229: }
  230: 
  231: __device__ __host__ __forceinline__ double3 operator-(const double3& a, const double3& b) {
  232:     return make_double3(a.x - b.x, a.y - b.y, a.z - b.z);
  233: }
  234: 
  235: __device__ __host__ __forceinline__ double3 operator*(const double3& v, double s) {
  236:     return make_double3(v.x * s, v.y * s, v.z * s);
  237: }
  238: 
  239: __device__ __host__ __forceinline__ double3 operator*(double s, const double3& v) {
  240:     return v * s;
  241: }
  242: 
  243: __device__ __host__ __forceinline__ double3 operator/(const double3& v, double s) {
  244:     return make_double3(v.x / s, v.y / s, v.z / s);
  245: }
  246: 
  247: __device__ __host__ __forceinline__ double dot(const double3& v, const double3& w) {
  248:     return v.x*w.x + v.y*w.y + v.z*w.z;
  249: }
  250: 
  251: __device__ __host__ __forceinline__ Vector2 toVector2(const double3& v) {
  252:     return make_double2(v.x, v.y);
  253: }
  254: 
  255: __device__ __host__ __forceinline__ double3 toVector3(const double2& v, double w) {
  256:     return make_double3(v.x, v.y, w);
  257: }
  258: 
  259: __device__ __host__ __forceinline__ Point2 toPoint2(const double3& p) {
  260:     return make_double2(p.x, p.y);
  261: }
  262: 
  263: __device__ __host__ __forceinline__ Point3 toPoint3(const double2& p, double z) {
  264:     return make_double3(p.x, p.y, z);
  265: }
