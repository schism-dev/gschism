 9197: extern "C" __global__ void getNodeVar(int varCode, void *res, int k) {
 9198:    // Packed local order into res. Caller allocates sizePart * nbytes.
 9199:    NODE(node);
 9200: 
 9201:    switch (varCode) {
 9202:       case (int)VarCode::outputCoords: {
 9203:          const Point2 coords = node->outputCoords();
 9204:          double *out = (double *)((char *)res + idx_node * 16);
 9205:          out[0] = coords.x;
 9206:          out[1] = coords.y;
 9207:          break;
 9208:       }
 9209:       case (int)VarCode::depth:
 9210:          *(double *)((char *)res + idx_node * 8) = node->depth;
 9211:          break;
 9212:       case (int)VarCode::kb:
 9213:          *(int *)((char *)res + idx_node * 4) = (int)node->kb;
 9214:          break;
 9215:       case (int)VarCode::eta:
 9216:          *(double *)((char *)res + idx_node * 8) = node->eta2;
 9217:          break;
 9218:       case (int)VarCode::u_air: {
 9219:          double *out = (double *)((char *)res + idx_node * 16);
 9220:          out[0] = node->u_air.x;
 9221:          out[1] = node->u_air.y;
 9222:          break;
 9223:       }
 9224:       case (int)VarCode::isdry:
 9225:          *(int *)((char *)res + idx_node * 4) = (int)node->isDry;
 9226:          break;
 9227:       case (int)VarCode::u: {
 9228:          double *out = (double *)((char *)res + idx_node * nvrt * 16);
 9229:          if (k >= 0) {
 9230:             out[0] = node->u2[k].x;
 9231:             out[1] = node->u2[k].y;
 9232:          } else {
 9233:             for (int lev = 0; lev < nvrt; lev++) {
 9234:                out[lev*2    ] = node->u2[lev].x;
 9235:                out[lev*2 + 1] = node->u2[lev].y;
 9236:             }
 9237:          }
 9238:          break;
 9239:       }
 9240:       case (int)VarCode::z: {
 9241:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9242:          if (k >= 0)
 9243:             out[0] = node->z[k];
 9244:          else
 9245:             for (int lev = 0; lev < nvrt; lev++)
 9246:                out[lev] = node->z[lev];
 9247:          break;
 9248:       }
 9249:       case (int)VarCode::w: {
 9250:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9251:          if (k >= 0)
 9252:             out[0] = node->w2[k];
 9253:          else
 9254:             for (int lev = 0; lev < nvrt; lev++)
 9255:                out[lev] = node->w2[lev];
 9256:          break;
 9257:       }
 9258:       case (int)VarCode::dfh: {
 9259:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9260:          if (k >= 0)
 9261:             out[0] = node->dfh[k];
 9262:          else
 9263:             for (int lev = 0; lev < nvrt; lev++)
 9264:                out[lev] = node->dfh[lev];
 9265:          break;
 9266:       }
 9267:       case (int)VarCode::dfv: {
 9268:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9269:          if (k >= 0)
 9270:             out[0] = node->dfv[k];
 9271:          else
 9272:             for (int lev = 0; lev < nvrt; lev++)
 9273:                out[lev] = node->dfv[lev];
 9274:          break;
 9275:       }
 9276:       case (int)VarCode::tke: {
 9277:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9278:          if (k >= 0)
 9279:             out[0] = node->turb.tke[k];
 9280:          else
 9281:             for (int lev = 0; lev < nvrt; lev++)
 9282:                out[lev] = node->turb.tke[lev];
 9283:          break;
 9284:       }
 9285:       case (int)VarCode::mxl: {
 9286:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9287:          if (k >= 0)
 9288:             out[0] = node->turb.mxl[k];
 9289:          else
 9290:             for (int lev = 0; lev < nvrt; lev++)
 9291:                out[lev] = node->turb.mxl[lev];
 9292:          break;
 9293:       }
 9294:    }
 9295: }
