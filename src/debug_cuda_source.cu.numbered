 1953: struct Mesh {
 1954:    public:  
 1955: 
 1956:    int partNum; // Partition number for this mesh.
 1957: 
 1958:    // Pointers to each GPU's local memory (size is the number of partitions).
 1959:    Node**    nodes;  
 1960:    Element** elems;  
 1961:    Side**    sides;  
 1962:    
 1963:    // Local memory
 1964:    Node*    localNodeData; 
 1965:    Element* localElemData;
 1966:    Side*    localSideData; 
 1967: 
 1968:    NodeBoundary *localNodeBoundaryMem; // Array of objects with the boundary information of each node
 1969:    SideBoundary *localSideBoundaryMem; // Array of objects with the boundary information of each side
 1970:    double       *coeffMatrixMem;       // Matrix coefficients for neighbors. [0..numNodes-1], doesn't include the diagonal
 1971:    BoundarySegment *localSegmentMem;   // Array of objects with the boundary segments
 1972:    
 1973:    const int npgb;  // Global number of horizontal nodes
 1974:    const int negb;  // Global number of elements
 1975:    const int nsgb;  // Global number of sides
 1976: 
 1977:    const int np;   // Local number of horizontal nodes 
 1978:    const int ne;   // Local number of elements
 1979:    const int ns;   // Local number of sides
 1980: 
 1981:    int nbp;  // Local number of boundary nodes
 1982:    int nbs;  // Local number of boundary sides
 1983: 
 1984:    int nEntries;  // Total number of matrix elements
 1985: 
 1986:    const int max_np; // Maximum number of horizontal nodes per partition (shared by all partitions)
 1987:    const int max_ne; // Maximum number of elements per partition (shared by all partitions)
 1988:    const int max_ns; // Maximum number of sides per partition (shared by all partitions)
 1989: 
 1990:   
 1991:    // Additional topology information
 1992:    Node    **nodeNeighNodes;     // Array of pointers to the nodes neighbors of each node
 1993:    Element **nodeNeighElems;     // Array of pointers to the elements neighbors of each node
 1994:    int16_t *nodePermutationSort; // Array of indices for the array nodes such that neighbors nodes are sorted in increasing order of their global index.
 1995: 
 1996:    BoundarySegment *landBoundarySegment;
 1997:    NodeBoundary *landBoundaryNode;
 1998: 
 1999:    // Vertical coordinate system
 2000:    // Sigma levels
 2001:    double h_s; 
 2002:    double h_c; 
 2003: 
 2004:    double theta_b;
 2005:    double theta_f, sinh_theta_f;
 2006:    double *sigma;  // There is a sigma_local on each node for the case ivcor=1
 2007:    double *ztot;
 2008:    double *cs;
 2009:    double *dcs;
 2010: 
 2011: 
 2012: 
 2013:    __device__ Mesh(int partNum,
 2014:                    int npgb, int negb, int nsgb, 
 2015:                    int np, int ne, int ns,
 2016:                    int max_np, int max_ne, int max_ns, int nseg,
 2017:                    NodeBoundary *plandNodeBndMem, BoundarySegment *plandSegMem,
 2018:                    Node **nodesPtr, Element **elemsPtr, Side **sidesPtr,
 2019:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 2020:                    Node    **localNodeNeighNodesMem,
 2021:                    Element **localNodeNeighElemsMem,
 2022:                    int16_t *localNodePermutationSortMem,
 2023:                    double *partCoeffMatrixMem,
 2024:                    NodeBoundary *localNodeBoundaryMem,
 2025:                    SideBoundary *localSideBoundaryMem,
 2026:                    BoundarySegment *localSegmentMem,
 2027:                    int *kb, double h_c, double h_s, double theta_b, double theta_f, double *sigma, double *ztot,
 2028:                    double *cs, double *dcs
 2029:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 2030:                        np(np), ne(ne), ns(ns),
 2031:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
 2032:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
 2033:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
 2034:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
 2035:                        nodePermutationSort(localNodePermutationSortMem), coeffMatrixMem(partCoeffMatrixMem),
 2036:                        localNodeBoundaryMem(localNodeBoundaryMem), localSideBoundaryMem(localSideBoundaryMem),
 2037:                        localSegmentMem(localSegmentMem),
 2038:                        h_c(h_c), h_s(h_s), theta_b(theta_b), theta_f(theta_f), sigma(sigma), ztot(ztot),
 2039:                        cs(cs), dcs(dcs),
 2040:                        landBoundarySegment(plandSegMem),
 2041:                        landBoundaryNode(plandNodeBndMem)
 2042:    {
 2043:       printf("Mesh constructor for partition %d\n", partNum);
 2044: 
 2045:       printf("npgb = %d, negb = %d, nsgb = %d, nseg = %d\n", npgb, negb, nsgb, nseg);
 2046:       printf("np = %d, ne = %d, ns = %d\n", np, ne, ns);
 2047:       printf("max_np = %d, max_ne = %d, max_ns = %d\n", max_np, max_ne, max_ns);
 2048:  
 2049:       printf("elemsPtr = %p, elems = %p\n", *elems, elemsMem);
 2050:       
 2051:       sinh_theta_f = sinh(theta_f);
 2052: 
 2053:       *landBoundaryNode    = NodeBoundary(true);
 2054:       *landBoundarySegment = BoundarySegment(true);   
 2055: 
 2056:    }
 2057: 
 2058:    __device__ void populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 2059:                   double *node_coords, double *node_coords_ll, bool use_ll,
 2060:                   double *wind_rotate_angle, 
 2061:                   int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2062:                   int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2063:                   int16_t *nodePermutationSort, double *crs_data,
 2064:                   int *localNodeNeighNodesStart, int *localNodeNeighElemsStart,
 2065:                   int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2066:                   int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2067:                   int *localNodePart,     int *localElemPart,     int *localSidePart,
 2068:                   double *drag, double *roughness, double *rmanning, 
