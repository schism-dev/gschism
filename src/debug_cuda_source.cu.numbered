 1975: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 1976:                    Side *side = &(mesh->localSideData[idx_side]); \
 1977:                    if (idx_side >= mesh->ns) return;
 1978: 
 1979: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 1980:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 1981:                    if (idx_elem >= mesh->ne) return;
