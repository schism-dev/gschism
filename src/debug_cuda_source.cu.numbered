 7843: //                   !Tally horizontal mass in for inflow case
 7844: //                   if(max_iadjust_mass_consv>0) h_mass_in(:)=h_mass_in(:)-trel_tmp_outside(1:ntr)*flux_adv_hface(k,jsj)*dtb
 7845: //                 endif !iel
