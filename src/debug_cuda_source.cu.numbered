  993:    __device__ Vector3 interpolateVelocities(Point3 xt, const Side *origSide = nullptr) const;
  994: 
  995:    // ------------------------------------------------------------------------------------------------
  996:    // These are functions that work on all nodes/sides of the element.
  997:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  998:    //
  999:    // An example of how to use these functions is:
 1000:    //   
 1001:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 1002:    // 
 1003:    // Where L is the level at which the field is to be interpolated. The field can be either
 1004:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
 1005:    // There are different versions of getNodalValues for each of these cases.
 1006: 
 1007:    template<typename T>
 1008:    __device__ __forceinline__ void getNodalValues(T Node::* field, T res[4]) const;
 1009: 
 1010:    template<typename T>
 1011:    __device__ __forceinline__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const;
 1012:   
 1013:    template<typename T>
 1014:    __device__ __forceinline__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const;
 1015: 
 1016:    template<typename T>
 1017:    __device__ __forceinline__ void getSideValues(T Side::* field, T res[4]) const;
 1018: 
 1019:    template<typename T>
 1020:    __device__ __forceinline__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const;
 1021: 
 1022:    template<typename T>
 1023:    __device__ __forceinline__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const;
 1024: 
 1025:    
 1026:    __forceinline__ __device__ void projectNodeVectorsToElementFrame(Vector2 *v) const;
 1027:    __forceinline__ __device__ void projectSideVectorsToElementFrame(Vector2 *v) const;
 1028: 
 1029: 
 1030:    template<typename T>
 1031:    __device__ __forceinline__ T interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const;
 1032: 
 1033:    template<typename T>
 1034:    __device__ __forceinline__ T interpolate(const double shapeCoords[4], T Node::* field) const;
 1035: 
 1036:    template<typename T>
 1037:    __device__ __forceinline__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const;
 1038: 
 1039:    template<typename T>
 1040:    __device__ __forceinline__ T mean(T Node::* field) const;
 1041: 
 1042:    template<typename T>
 1043:    __device__ __forceinline__ T mean(T Side::* field) const;
 1044: 
 1045:    template<typename T>
 1046:    __device__ __forceinline__ T mean(int level,  T (Side::*func)(int) const) const;
 1047: 
 1048:    template<typename T>
 1049:    __device__ __forceinline__ T mean(int level, T (Node::* field)[nvrt]) const;
 1050: 
 1051:    template<typename T>
 1052:    __device__ __forceinline__ T mean(int level, T (Side::* field)[nvrt]) const;
 1053: 
