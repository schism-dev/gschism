 1626: 
 1627: 
 1628: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1629:                                               double &t, double& tIntersect) {
 1630: 
 1631:    double closest_intersect_t = 1e10;
 1632:    bool found_intersection = false;
 1633: 
 1634: double minDelta = 1e10; 
 1635: double btt1, btt2;
 1636:    for (int i = 0; i < i34; i++) {
 1637: 
 1638:       Side *side2 = sides[i];
 1639: 
 1640:       // (x3,y3)-(x4,y4) is the element side line
 1641:       const Point2 x3 = side2->n1->p2();
 1642:       const Point2 x4 = side2->n2->p2();
 1643: 
 1644:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1645:       const double delta = cross(x2 - x1, x3 - x4);
 1646: 
 1647:       if (abs(delta) > 0) {
 1648: 
 1649:          const double delta1 = cross(x3 - x1, x3 - x4);
 1650:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1651: 
 1652:          // Solves the two linear equations for tt1 and tt2
 1653:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1654:          const double tt2 = delta2/delta;
 1655: 
 1656: if (abs(delta) < minDelta) {
 1657:    minDelta = abs(delta);
 1658:    btt1 = tt1;
 1659:    btt2 = tt2;
 1660: }
 1661: double small = 1e-7;
 1662:          printf("RRRRRR delta = %e, delta1 = %e, delta2 = %e, tt1 = %e, tt2 = %e\n", delta, delta1, delta2, tt1, tt2);
 1663:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1664:             closest_intersect_t = min(closest_intersect_t, tt1);
 1665:             side = side2;
 1666:             nextElement = side->otherElem(this);
 1667:             t = tt2;
 1668:             tIntersect = max(small, min(tt1, 1.0-small));
 1669:             found_intersection = true;
 1670:          }
 1671:       
 1672:       }
 1673:       else {  // parallel segments
 1674:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1675:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1676: 
 1677:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1678: 
 1679:          // const double dist = dot(x1 - x3, side2->n);
 1680:          // if (abs(dist) < small*length(x3 - x4)) {
 1681:          //    const double2 unitarySide = normalize(x4 - x3);
 1682:          //    const double len = dot(x2 - x1, unitarySide);
 1683:          //    t = t + len;
 1684:          //    t = max(0.0, min(t, 1.0));
 1685:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1686: 
 1687: 
 1688:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1689:          //    // t = tt2;
 1690:          //    found_intersection = true;
 1691:          // }
 1692:       }
 1693: 
 1694: 
 1695:    }
 1696: 
 1697:    if (!found_intersection) {
 1698:       
 1699:       printf("ZZ No intersection found:\n"
 1700:            "Element %d\n"
 1701:            "in = %d\n"
 1702:            "minDelta = %e\n"
 1703:            "tt1 = %e, tt2 = %e\n"
 1704:            "segment: (%f, %f)-(%f, %f)\n"
 1705:            "Vertices:\n"
 1706:          //   "  Nodes nextElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n"
 1707:            "  Nodes curElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n",
 1708:            IDX(nextElement),
 1709:            (btt1 >= -small && btt2 >= -small && btt2 <= 1.0 + small && btt1 <= 1.0 + small),
 1710:            minDelta,
 1711:            btt1, btt2,
 1712:            x1.x, x1.y,
 1713:            x2.x, x2.y,
 1714:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1715:          //   nextElement->nodes[1]->p.x, nextElement->nodes[1]->p.y,
 1716:          //   nextElement->nodes[2]->p.x, nextElement->nodes[2]->p.y,
 1717:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1718:            nodes[0]->p.x, nodes[0]->p.y,
 1719:            nodes[1]->p.x, nodes[1]->p.y,
 1720:            nodes[2]->p.x, nodes[2]->p.y,
 1721:            nodes[0]->p.x, nodes[0]->p.y);
 1722: 
 1723:    }
 1724: 
 1725:    // assert(found_intersection && "No intersection found");
 1726: 
 1727:    // found_intersection should always be true, since we checked all the sides.  
 1728:    return found_intersection;
 1729: }
 1730: 
 1731: 
 1732: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1733:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1734: 
 1735:    printf("Tracking segment goes out of water at element %d\n", curElem->idx);
 1736: 
 1737:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1738:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1739:    // curElement.
 1740: 
 1741:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1742:    // And uses this velocity instead to continue the tracking.
 1743: 
 1744:    // computes the intersection point in cartesian coordinates
 1745:    Point2 intersection = nextSide->p_t(tt);
 1746: 
 1747:    // Nudges the point to the barycenter of the element. 
 1748:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1749:    // next segment intersects the element sides.  
 1750:    curElem->nudgeToBarycenter(intersection);
 1751: 
 1752:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1753:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1754:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1755:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1756: 
 1757:    // If the side is an open boundary, the tangential velocity is zero.
 1758:    if (nextSide->isBnd()) vtan = 0.0;
 1759: 
 1760:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1761:    const double us = vtan*nextSide->t().x;
 1762:    const double vs = vtan*nextSide->t().y;
 1763:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1764: 
 1765:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1766:    const double len2 = norm2(intersection - toPoint2(xt));
 1767:    const double vel2 = dot(u_int, u_int);        
 1768:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 1769:    else            dt = 0.0;
 1770: 
 1771:    // The end of this tracking segment is now the intersection point.
 1772:    xt = {intersection.x, intersection.y, zint};
 1773: printf("BBB u_int = %f,%f,%f\n", us, vs, ws);   
 1774:    u_int = {us, vs, ws};
 1775:    
 1776: }
 1777: 
 1778: /**
 1779:  * Tracks a particle through elements and vertical levels in the mesh.
 1780:  * 
 1781:  * @param x0,y0,z0     Starting position coordinates
 1782:  * @param xt,yt,zt     Target position coordinates
 1783:  * @param dtb          Time step for tracking
 1784:  * @param uuint,vvint,wwint Initial velocity components
 1785:  * @param nextElem     Starting/resulting element index
 1786:  * 
 1787:  * @return Status code of type trackExitCodes
 1788:  * 
 1789:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1790:  * of the details are different. The idea is that the code requires less branches and is better fit
 1791:  * for GPU execution.
 1792:  * 
 1793:  * The main ideas here are:
 1794:  * - The starting point is expected to be in the starting element.
 1795:  * - The end point is guaranteed to be inside an element.
 1796:  * - since the starting point is inside the element, there are only two cases: 
 1797:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1798:  *     (b) it does not and (xt,yt) is already in the starting element.
 1799:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1800:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1801:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1802:  * - tt1 can be positive or negative. We only consider the positive values.
 1803:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1804:  * - The next intersection will occur at the smallest positive tt1.
 1805:  * - This intersection will be the next (x0,y0) position.
 1806:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1807:  *   of getting stuck in a loop.
 1808:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1809:  *   was found.
 1810:  */
 1811: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1812:                                                        Element *&nextElem, int &jlev, double &dt) {
 1813: 
 1814:    // First thing is to check if the target point is inside the element. If it is there is nothing
 1815:    // else to do.
 1816: 
 1817:    const Element *curElem = nextElem;
 1818:    if (containsPoint(toPoint2(xt))) {
 1819: printf(" ___BBB0_____ idx = %d, u_int = %.17g,%.17g,%.17g\n", curElem->idx, u_int.x, u_int.y, u_int.z);            
 1820:       curElem->interpolateVelocities(xt, u_int);
 1821: printf(" ___BBB_____ idx = %d, u_int = %.17g,%.17g,%.17g\n", curElem->idx, u_int.x, u_int.y, u_int.z);      
 1822:       return true;
 1823:    }
 1824: 
 1825:    Side *side = nullptr;
 1826: 
 1827:    // 1. Initial checks
 1828:    // Verify starting element is valid (wet)
 1829:    assert(!curElem->isDry && "Starting element is dry");
 1830: 
 1831:    // Checks if track has a zero length.
 1832:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1833:    // assert(len2 > 0.0 && "Zero length track"); 
 1834:    
 1835:    const int MAX_ITERATIONS = 1000;
 1836:    
 1837:    double t;
 1838:    Side *nextSide = nullptr;
 1839:    double tIntersect = 1e10;
 1840:    double zint = x0.z;
 1841: 
 1842:    // Horizontal tracking loop
 1843:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1844:    // (x0,y0) is inside the element but the target point is not.
 1845: 
 1846:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1847: 
 1848:    if (!found_intersection) {
 1849: double shpCoords_0[4];
 1850: double shpCoords_t[4];
 1851: computeShapeCoords(toPoint2(x0), shpCoords_0, false);
 1852: computeShapeCoords(toPoint2(xt), shpCoords_t, false);
 1853:       printf("No intersection found (containsPoint = %d, %d [%.17g, %.17g, %.17g] [%.17g, %.17g, %.17g]):\n"
 1854:            "Elements %d, %d\n"
 1855:            "Side %d\n"
 1856:            "segment: (%f, %f),(%f, %f)\n"
 1857:            "triangle node indices: %d, %d, %d\n"
 1858:            "triangle: (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n",
 1859:            containsPoint(toPoint2(x0)), containsPoint(toPoint2(xt)),
 1860:            shpCoords_0[0], shpCoords_0[1], shpCoords_0[2],
 1861:            shpCoords_t[0], shpCoords_t[1], shpCoords_t[2],
 1862:            IDX(curElem), IDX(nextElem),
 1863:            IDX(nextSide),
 1864:            x0.x, x0.y,
 1865:            xt.x, xt.y,
 1866:            curElem->nodes[0]->idx, curElem->nodes[1]->idx, curElem->nodes[2]->idx,
 1867:            curElem->nodes[0]->p.x, curElem->nodes[0]->p.y,
 1868:            curElem->nodes[1]->p.x, curElem->nodes[1]->p.y,
 1869:            curElem->nodes[2]->p.x, curElem->nodes[2]->p.y,
 1870:            curElem->nodes[0]->p.x, curElem->nodes[0]->p.y);
 1871:    }
 1872:    assert(found_intersection && "No intersection found at %d");
 1873: 
 1874:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1875: 
 1876:    // if the tracking segment goes out of water (either dry or edge boundary)
 1877:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1878: 
 1879: 
 1880:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1881:       nextElem = this;
 1882:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1883:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1884:       return true;    
 1885:    }
 1886: 
 1887: 
 1888:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1889:    int iterations = 0;
 1890:    while (iterations < MAX_ITERATIONS) {
 1891:       iterations++;
 1892:       
 1893:       Element *curElem = nextElem;
 1894: 
 1895:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1896: 
 1897:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1898: printf(" ___CCC_____ idx = %d, zint = %.17g\n", curElem->idx, zint);      
 1899:       // If we are already in the target element, we are done.
 1900:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1901:       if (!found_intersection) break;
 1902: 
 1903: 
 1904: 
 1905:       // if the tracking segment goes out of water (either dry or edge boundary).
 1906:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1907: 
 1908:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1909: 
 1910:          nextElem = curElem;
 1911: 
 1912: 
 1913:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1914:          // In this case, the caller (btrack) needs to take into account the remaining time.
 1915:          return true;
 1916:       }
 1917:       
 1918:       // Update position and element for next iteration
 1919:       side = nextSide;
 1920: 
 1921:    }
 1922: 
 1923:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 1924: 
 1925:  
 1926:    // Interpolate velocities at the final position. This is a conceptually simple step,
 1927:    // but the function is not simple, because it has to search for the vertical level containing zt.
 1928:    nextElem->interpolateVelocities(xt, u_int);
 1929: printf(" ___AAA_____ u_int = %.17g,%.17g,%.17g\n", u_int.x, u_int.y, u_int.z);      
 1930: 
 1931: 
 1932:    return true;
 1933: }
 1934: 
 1935: 
 1936: __inline__ __device__ double Element::computeSignedArea(void) const {
 1937:    // Compute the area of the element
 1938: 
 1939:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 1940: 
 1941:    // In the quad case we need to add the area of the other triangle.
 1942:    if (isQuad()) {
 1943:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1944:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 1945:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1946:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 1947:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 1948:          Error("Negative area found in quad element");
 1949:       }
 1950:       res += ar1;
 1951:    }
 1952: 
 1953:    return res;
 1954: }
 1955: 
 1956: 
 1957: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 1958:                                                                 (nodes[1]->isDry2()) ||
 1959:                                                                 (nodes[2]->isDry2()) ||
 1960:                                                                 (i34==4 && nodes[3]->isDry2());
 1961: }
 1962: 
 1963: 
 1964: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 1965:    // In boundary sides, the element 1 is nullptr
 1966:    return side->elems[1] == nullptr; 
 1967: }
 1968: 
 1969: 
 1970: 
 1971: /**
 1972:    Compute the shape coordinates of the point (xt,yt) in the element.
 1973:    @param xt (input): x-coordinate of the point
 1974:    @param shpCoords (output): shape coordinates of the point
 1975:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 1976:    @return true if the point is inside the element, false otherwise
 1977: **/
 1978: __device__ bool Element::computeShapeCoords(Point2 xt, double shpCoords[4],
 1979:                                             bool fixNegshpCoord) const {
 1980: 
 1981:    // Compute the shape coordinates of the point xt in the element.
 1982:    if (i34==3) {
 1983:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 1984:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 1985:       // and in this case, the pt will be nudged into the element
 1986:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 1987:       // from the local frame, so use additional check.
 1988: 
 1989:       Point2 x0, x1, x2;
 1990: 
 1991:       if constexpr(ics==1) {
 1992:          x0 = nodes[0]->p2();
 1993:          x1 = nodes[1]->p2();
 1994:          x2 = nodes[2]->p2();
 1995:       }
 1996:       else // lat/lon
 1997:       {
 1998:          Error("Not implemented yet");
 1999: #ifdef ICS2
 2000:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2001:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2002:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2003: #endif
 2004:       }
 2005: 
 2006:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2007:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2008:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2009:       shpCoords[3] = 0.0;
 2010:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2011: 
 2012:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2013:       // then we fix the negative shape coordinates.
 2014:       if (fixNegshpCoord && tmpmin<=0.0) {
 2015: 
 2016:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2017:          // keeping the sum of the shape coordinates equal to 1.
 2018:          // I have tested and compared the new algorithm with the old one, and they give
 2019:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2020:          // The new algorithm should be faster since it is branchless.
 2021:          const double a = - tmpmin + 1.0e-2;  // XXX it used to be 1.0e-4 in the comments of the original code
 2022:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2023:          
 2024:          shpCoords[0] = (shpCoords[0] + a)*b;
 2025:          shpCoords[1] = (shpCoords[1] + a)*b;
 2026:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2027: 
 2028:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2029:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2030:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2031:          }
 2032: 
 2033:          // Update the point coordinates for the new shape coordinates
 2034:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2035:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2036:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2037: 
 2038:       }
 2039: 
 2040:       // Check if the point is inside the element
 2041:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2042:    }
 2043:    else {
 2044:       Error("Not implemented yet");
 2045: #ifdef QUADS
 2046:       // Reproject pt in eframe of nel for ics=2
 2047:       if constexpr(ics==1) {
 2048:          xn2 = xt; 
 2049:          yn2 = yt;
 2050:       }
 2051:       else {
 2052:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2053:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2054:       }
 2055: 
 2056:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2057: #endif
 2058:    }
 2059: 
 2060:    return false;  // Never reached
 2061: 
 2062: }
 2063: 
 2064: 
 2065: /**  Interpolate velocities at a given point (xt,yt,zt)
 2066: 
 2067:    @param xt, yt, zt: coordinates of the point to interpolate
 2068:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2069: 
 2070:    This is done in four steps:
 2071: 
 2072:    1. Find the shape coordinates for the final position in the element.
 2073:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2074:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2075:       z levels at xt, yt at each step.   
 2076:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2077:       horizontally and vertically.
 2078: **/
 2079: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2080:    // Interpolate the velocities at the point xt. 
 2081:    // This function works the same for triangular and quadrilateral elements.
 2082:    double shpCoord[4];
 2083: 
 2084: printf(" ___BBB02____ idx = %d, u_int = %.17g,%.17g,%.17g, u1 = %.17g,%.17g,%.17g, u2 = %.17g,%.17g,%.17g, u3 = %.17g,%.17g,%.17g\n", idx, u_int.x, u_int.y, u_int.z, nodes[0]->u2[0].x, nodes[0]->u2[0].y, nodes[0]->u2[0].z, nodes[1]->u2[0].x, nodes[1]->u2[0].y, nodes[1]->u2[0].z, nodes[2]->u2[0].x, nodes[2]->u2[0].y, nodes[2]->u2[0].z);         
 2085:    // First step is to compute the shape coordinates of (xt,yt)
 2086:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2087:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2088: 
 2089:    // Second step is to find the level that contains zt
 2090:    // Uses a binary search to find the level
 2091:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2092:    int L = kbe;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2093:    int R = nvrt - 1;
 2094: 
 2095:    // Get the z coordinates at the nodes of the element at the levels L and R
 2096:    double zLAtNodes[4], zRAtNodes[4];
 2097:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2098:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2099: 
 2100:    double zL = interpolate(shpCoord, zLAtNodes);
 2101:    double zR = interpolate(shpCoord, zRAtNodes);
 2102:    
 2103:    // Interpolates vertically the velocities
 2104:    double wght1, wght2;
 2105:    if (xt.z<=zL) {
 2106:       wght1 = 1.0;
 2107:       wght2 = 0.0;
 2108:    }
 2109:    else if (xt.z>=zR) {
 2110:       wght1 = 0.0;
 2111:       wght2 = 1.0;
 2112:    }
 2113:    else {
 2114:       // Perform a binary search to find the levels between L and R that contain xt.z
 2115:       while (R - L > 1) {
 2116:          int M = (L + R) / 2;
 2117: 
 2118:          double zMAtNodes[4];
 2119:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2120:          double zM = interpolate(shpCoord, zMAtNodes);
 2121:          if (zM < xt.z) 
 2122:          {
 2123:             L = M;
 2124:             zL = zM;
 2125:          }
 2126:          else 
 2127:          {
 2128:             R = M;
 2129:             zR = zM;
 2130:          }
 2131:       }
 2132:       assert(L == R-1);
 2133:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2134: 
 2135:       wght2 = (xt.z - zL)/(zR - zL);
 2136:       wght1 = 1.0 - wght2;
 2137:    }
 2138: 
 2139: 
 2140: // printf("$$$ wght1 = %f, wght2 = %f, zt = %f, zL = %f, zR = %f\n", wght1, wght2, xt.z, zL, zR);
 2141: // printf("$$$ shpCoord = %f, %f, %f, %f\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 2142:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2143: 
 2144:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 2145: printf(" ___BBB2____ idx = %d, wght1 = %.17g, wght2 = %.17g, u1 = %.17g,%.17g,%.17g, u2 = %.17g,%.17g,%.17g, u_int = %.17g,%.17g,%.17g\n", idx, wght1, wght2, interpolate(L, shpCoord, &Node::u2).x, interpolate(L, shpCoord, &Node::u2).y, interpolate(L, shpCoord, &Node::u2).z, interpolate(R, shpCoord, &Node::u2).x, interpolate(R, shpCoord, &Node::u2).y, interpolate(R, shpCoord, &Node::u2).z, u_int.x, u_int.y, u_int.z);      
 2146:    // Neither of the interpolated velocities should be NaN
 2147:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2148: 
 2149: }
 2150: 
