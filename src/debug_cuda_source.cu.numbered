 8094: extern "C" __global__ void getElementVar(int varCode, bool is3D, double *var1, double *var2, int *ivar1, int *ivar2, int k = -1, int j = -1) {
 8095:    // Get the value of a variable from an element
 8096:    // varName is the name of the variable to get
 8097:    // var is the array to store the value
 8098:    // k is the vertical level index of the variable to get
 8099: 
 8100:    ELEM(elem);
 8101:    
 8102:    int idx = elem->idx;
 8103:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8104: 
 8105:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8106:    if      (varCode == (int)VarCode::w)       { var1[idx] = elem->w[k];}
 8107:    else if (varCode == (int)VarCode::z)       { var1[idx] = elem->z[k];}
 8108:    else if (varCode == (int)VarCode::x)       { var1[idx] = elem->center.x; var2[idx] = elem->center.x;}
 8109:    else if (varCode == (int)VarCode::area)    { var1[idx] = elem->area;}
 8110:    else if (varCode == (int)VarCode::depth)   { var1[idx] = elem->depth;}
 8111:    else if (varCode == (int)VarCode::radius)  { var1[idx] = elem->radius;}
 8112:    else if (varCode == (int)VarCode::lonlat)  { var1[idx] = elem->xlon;     var2[idx] = elem->ylat;}
 8113:    else if (varCode == (int)VarCode::ghat)    { var1[idx] = elem->ghat1.x;  var2[idx] = elem->ghat1.y;}
 8114:    else if (varCode == (int)VarCode::kb)      { ivar1[idx] = elem->kb;}
 8115:    else if (varCode == (int)VarCode::ssign && j > -1)  {ivar1[idx] = elem->ssign[j];}
 8116:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 8117:       
 8118:    
 8119: }
 8120: 
 8121: 
 8122: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 8123:    // Get the value of a variable from an node
 8124:    // varName is the name of the variable to get
 8125:    // var is the array to store the value
 8126:    // k is the vertical level index of the variable to get
 8127: 
 8128:    NODE(node);
 8129:    
 8130:    int idx = node->idx;
 8131:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8132: 
 8133:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8134:    
 8135:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 8136:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 8137:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 8138:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 8139:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 8140:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 8141:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;  
 8142:    else if (varCode == (int)VarCode::isdry && k == -1)  var[idx] = node->isDry?1.0:0.0;
 8143:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 8144:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 8145:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 8146:    
 8147:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 8148:       
 8149:    
 8150: }
 8151: 
 8152: 
 8153: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 8154:    // Get the value of a variable from an side
 8155:    // varName is the name of the variable to get
 8156:    // var is the array to store the value
 8157:    // k is the vertical level index of the variable to get
 8158:    SIDE(side);
 8159:    
 8160:    int idx = side->idx;
 8161:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8162: 
 8163:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 8164:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 8165:    // else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 8166:    else if (varCode == (int)VarCode::isdry && k == -1)   var[idx] = side->isDry?1.0:0.0;
 8167:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 8168:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 8169:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 8170:    // else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 8171:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 8172:    // else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 8173:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 8174:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 8175:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 8176:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 8177:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 8178:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 8179:    // else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 8180:    else if (varCode == (int)VarCode::bcc && k >= 0)     var[idx] = side->bcc[k].x;
 8181:    // else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 8182:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 8183:    // else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 8184:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 8185:    // else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 8186:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 8187:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 8188:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 8189:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 8190:    // else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 8191:    // else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 8192:    // else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 8193:    // else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 8194:    // else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 8195:    // else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 8196:    // else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 8197:    // else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 8198:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 8199: }
 8200: 
 8201: 
 8202: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8203:    // Get the value of a variable from an side
 8204:    // varName is the name of the variable to get
 8205:    // var is the array to store the value
 8206:    // k is the vertical level index of the variable to get
 8207:    SIDE_BND(sideBnd);   
 8208: 
 8209:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8210:    if (sideBnd->segment->isLand) idx = -7;
 8211: 
 8212:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8213:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8214: 
 8215: }
