 8142: __global__ void returnMatrix(double *res) {
 8143:    // Debugging: returns the matrix as a CuPy array
 8144: 
 8145:    const int size = mesh->np;
 8146:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8147:       const Node *node = mesh->localNodeData + idx_node;
 8148:       res[idx_node*size + idx_node] = node->coeffDiag;
 8149:       for (int j = 0; j < node->numNodes; j++) {
 8150:          Node* nbNode = node->nodes[j];
 8151:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 8152:       }
 8153: 
 8154:    }
 8155:    
 8156: }
 8157: 
