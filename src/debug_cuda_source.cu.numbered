 3848: extern "C" {
 3849: 
 3850:    __global__ void scaleGravity(double loadtide_coef) {
 3851: 
 3852: 
 3853:       NODE(node);
 3854: 
 3855:       // SAL option: scale gravity
 3856:       if constexpr(iloadtide==2) {  // simple const
 3857:          node->grav2 = grav*(1.0 - loadtide_coef);
 3858: 
 3859:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3860:         
 3861:           const double depth = max(node->depth, 0.0);
 3862:           const double tmp1 = sqrt(depth);
 3863:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3864:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3865:                              2.6969e-13*depth*depth*depth*tmp1;
 3866:           
 3867:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3868:           
 3869: 
 3870: 
 3871:           node->grav2 = grav*(1.0 - beta_bar);
 3872: 
 3873:       } else {  // iloadtide=0,1
 3874:         node->grav2=grav;
 3875: 
 3876:       }
 3877: 
 3878:       printf("scaleGravity: node(%d)->grav2 = %f\n", node->idx, node->grav2);
 3879:    }
