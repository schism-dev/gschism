 1913: 
 1914: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1915:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1916: 
 1917:    printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 1918: 
 1919:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1920:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1921:    // curElement.
 1922: 
 1923:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1924:    // And uses this velocity instead to continue the tracking.
 1925: 
 1926:    // computes the intersection point in cartesian coordinates
 1927:    Point2 intersection = nextSide->p_t(tt);
 1928: 
 1929:    // Nudges the point to the barycenter of the element. 
 1930:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1931:    // next segment intersects the element sides.  
 1932:    curElem->nudgeToBarycenter(intersection);
 1933: 
 1934:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1935:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1936:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1937:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1938: 
 1939:    // If the side is an open boundary, the tangential velocity is zero.
 1940:    if (nextSide->isBnd()) vtan = 0.0;
 1941: 
 1942:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1943:    const double us = vtan*nextSide->t().x;
 1944:    const double vs = vtan*nextSide->t().y;
 1945:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1946: 
 1947:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1948:    const double len2 = norm2(intersection - toPoint2(xt));
 1949:    const double vel2 = dot(u_int, u_int);        
 1950:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 1951:    else            dt = 0.0;
 1952: 
 1953:    // The end of this tracking segment is now the intersection point.
 1954:    xt = {intersection.x, intersection.y, zint};
 1955: printf("BBB u_int = %f,%f,%f\n", us, vs, ws);   
 1956:    u_int = {us, vs, ws};
 1957:    
 1958: }
 1959: 
 1960: /**
 1961:  * Tracks a particle through elements and vertical levels in the mesh.
 1962:  * 
 1963:  * @param x0,y0,z0     Starting position coordinates
 1964:  * @param xt,yt,zt     Target position coordinates
 1965:  * @param dtb          Time step for tracking
 1966:  * @param uuint,vvint,wwint Initial velocity components
 1967:  * @param nextElem     Starting/resulting element index
 1968:  * 
 1969:  * @return Status code of type trackExitCodes
 1970:  * 
 1971:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1972:  * of the details are different. The idea is that the code requires less branches and is better fit
 1973:  * for GPU execution.
 1974:  * 
 1975:  * The main ideas here are:
 1976:  * - The starting point is expected to be in the starting element.
 1977:  * - The end point is guaranteed to be inside an element.
 1978:  * - since the starting point is inside the element, there are only two cases: 
 1979:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1980:  *     (b) it does not and (xt,yt) is already in the starting element.
 1981:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1982:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1983:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1984:  * - tt1 can be positive or negative. We only consider the positive values.
 1985:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1986:  * - The next intersection will occur at the smallest positive tt1.
 1987:  * - This intersection will be the next (x0,y0) position.
 1988:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1989:  *   of getting stuck in a loop.
 1990:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1991:  *   was found.
 1992:  */
 1993: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1994:                                                        Element *&nextElem, int &jlev, double &dt,
 1995:                                                        const Side *origSide) {
 1996: 
 1997: 
 1998:    if (origSide->idx == 7) {
 1999:       printf("AAAA&&&& origSide->idx = %d, u_int = %f,%f,%f, x0 = %f,%f,%f, xt = %f,%f,%f\n", origSide->idx, u_int.x, u_int.y, u_int.z, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z);
 2000:    }
 2001:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2002:    // else to do.
 2003:    // If it is, nudges the point to be inside the element.
 2004:    const Element *curElem = nextElem;
 2005:    if (containsPoint(toPoint2(xt), true)) {
 2006: 
 2007:       curElem->interpolateVelocities(xt, u_int);
 2008: addDebugPlot(x0, xt);
 2009:       return true;
 2010:    }
 2011: 
 2012:    Side *side = nullptr;
 2013: 
 2014:    // 1. Initial checks
 2015:    // Verify starting element is valid (wet)
 2016:    assert(!curElem->isDry && "Starting element is dry");
 2017: 
 2018:    // Checks if track has a zero length.
 2019:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 2020:    // assert(len2 > 0.0 && "Zero length track"); 
 2021:    
 2022:    const int MAX_ITERATIONS = 1000;
 2023:    
 2024:    double t;
 2025:    Side *nextSide = nullptr;
 2026:    double tIntersect = 1e10;
 2027:    double zint = x0.z;
 2028: 
 2029:    // Horizontal tracking loop
 2030:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2031:    // (x0,y0) is inside the element but the target point is not.
 2032: 
 2033:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2034: 
 2035:    assert(found_intersection && "No intersection found at %d");
 2036: 
 2037:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2038: 
 2039:    // if the tracking segment goes out of water (either dry or edge boundary)
 2040:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2041: 
 2042: addDebugPlot(x0, xt, 0x00A0FF);
 2043: printf("BBBXXXX going out of water\n");
 2044:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 2045: addDebugPlot(x0, xt, 0x00A0FF);      
 2046: 
 2047:       nextElem = this;
 2048:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2049:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2050:       return true;    
 2051:    }
 2052: 
 2053: 
 2054:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 2055:    int iterations = 0;
 2056:    while (iterations < MAX_ITERATIONS) {
 2057:       iterations++;
 2058: printf("BBBXXXX iterations = %d\n", iterations);      
 2059:       
 2060:       Element *curElem = nextElem;
 2061: 
 2062:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2063: addDebugPlot(x0, xt);
 2064:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2065: 
 2066:       // If we are already in the target element, we are done.
 2067:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 2068:       if (!found_intersection) break;
 2069: 
 2070: 
 2071: 
 2072:       // if the tracking segment goes out of water (either dry or edge boundary).
 2073:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2074: addDebugPlot(x0, xt, 0x00A0FF);
 2075: printf("BBBXXXX going out of water\n");
 2076:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 2077: addDebugPlot(x0, xt, 0x00A0FF);   
 2078:          nextElem = curElem;
 2079: 
 2080:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 2081:          // In this case, the caller (btrack) needs to take into account the remaining time.
 2082:          return true;
 2083:       }
 2084:       
 2085:       // Update position and element for next iteration
 2086:       side = nextSide;
 2087: 
 2088:    }
 2089: 
 2090:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 2091: 
 2092:  
 2093:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2094:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2095: addDebugPlot(x0, xt);   
 2096: printf("MMMMMM nextElem->idx = %d, u_int = %f,%f,%f\n", nextElem->idx, u_int.x, u_int.y, u_int.z);
 2097:    nextElem->interpolateVelocities(xt, u_int); 
 2098: printf("MMMMMM2 nextElem->idx = %d, u_int = %f,%f,%f\n", nextElem->idx, u_int.x, u_int.y, u_int.z);
 2099: 
 2100:    return true;
 2101: }
 2102: 
 2103: 
 2104: __inline__ __device__ double Element::computeSignedArea(void) const {
 2105:    // Compute the area of the element
 2106: 
 2107:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 2108: 
 2109:    // In the quad case we need to add the area of the other triangle.
 2110:    if (isQuad()) {
 2111:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2112:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 2113:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2114:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 2115:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 2116:          Error("Negative area found in quad element");
 2117:       }
 2118:       res += ar1;
 2119:    }
 2120: 
 2121:    return res;
 2122: }
 2123: 
 2124: 
 2125: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2126:                                                                 (nodes[1]->isDry2()) ||
 2127:                                                                 (nodes[2]->isDry2()) ||
 2128:                                                                 (i34==4 && nodes[3]->isDry2());
 2129: }
 2130: 
 2131: 
 2132: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2133:    // In boundary sides, the element 1 is nullptr
 2134:    return side->elems[1] == nullptr; 
 2135: }
