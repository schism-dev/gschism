 3069: 
 3070: //       const Side& side = sides[i];
 3071: 
 3072: //       xIntersect=-1.e25;
 3073: //       yIntersect=-1.e25;
 3074: 
 3075: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 3076: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 3077: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 3078: 
 3079: //       if (delta != 0.0) {
 3080: //          // Solves the two linear equations for tt1 and tt2
 3081: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 3082: //          const double tt2 = delta2/delta;
 3083: 
 3084: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 3085: //          // Similarly, we use tt2 to compute the intersection point.
 3086: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 3087: //             xIntersect = x3 + (x4 - x3)*tt2;
 3088: //             yIntersect = y3 + (y4 - y3)*tt2;
 3089: 
 3090: //             intersectingSide = side;
 3091: //             nextElement = nghbElems[i];
 3092: 
 3093: //             return true;
 3094: //          }
 3095:       
 3096: //       }
 3097: //       else {
 3098: //          // The two segments are parallel
 3099: //          return false;
 3100: //       }
 3101: 
