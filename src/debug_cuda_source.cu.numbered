 3109: 
 3110: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3111: 
 3112: 
 3113: __device__ void Node::updateKb(void) {
 3114: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3115: 
 3116:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3117: 
 3118: 
 3119:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3120: 
 3121:    if constexpr(ivcor == 2) {  // SZ coordinates
 3122:       
 3123:       // Compute bottom level index
 3124:       if (depth <= mesh->h_s) {
 3125:          kb = izlev;   
 3126:          
 3127:       } else {
 3128:          kb = -1;
 3129:          int L = 0;
 3130:          int R = nzlev; 
 3131:          
 3132:          while (L <= R) {
 3133:             int M = (R + L) / 2;
 3134: 
 3135: 
 3136:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3137:             
 3138:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3139:                R = M;
 3140:             } else {
 3141:                L = M;
 3142:             }
 3143: 
 3144:             if (R - L == 1) {
 3145:                kb = L;
 3146:                break;
 3147:             }
 3148:          }
 3149: 
 3150:          // Checks that the binary search was successful
 3151:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3152:        
 3153:       }
 3154:    } 
 3155: }
 3156: 
 3157: 
 3158: __device__ __inline__ void Node::updateZCoordData(void) {
 3159: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3160: 
 3161:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3162:    // if (isDry2()) {
 3163:    //    kb = -1;  // XXXXXXXX KKKKK
 3164:    //    return;
 3165:    // }
 3166: 
 3167: 
 3168:    if constexpr(ivcor == 2) {  // SZ coordinates
 3169:       
 3170:       // Compute bottom level index
 3171:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3172:    } 
 3173:    else if (ivcor == 1) {  // Localized sigma
 3174:       // Do nothing
 3175:    }
 3176: 
 3177: 
 3178: }
 3179: 
 3180: 
 3181: __device__ double Node::compZCoord(int k) const {
 3182:    // Computes the z coordinate at level k.
 3183:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3184:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3185:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3186:    // used 
 3187: 
 3188:    assert(k >= 0 && k < nvrt && "ZCOOR: invalid level\n");
 3189:    
 3190:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3191: 
 3192:    if (isDry2()) return 0.0;  // XXXX I used to return 0.0
 3193: 
 3194:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 3195: 
 3196:    if constexpr(ivcor == 2) {
 3197: 
 3198:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3199:       const double h_c = mesh->h_c;
 3200:       const double theta_f = mesh->theta_f;
 3201:       const double sinh_theta_f = mesh->sinh_theta_f;
 3202: 
 3203: 
 3204:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3205:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3206:       // once per time step/node.
 3207:       // CHECK: updateZCoordData
 3208: 
 3209:       //  To simplify comparisons, I define index versions of count variables.
 3210:       if      (k == ivrt)     return eta2; 
 3211:       else if (k == izlev)    return -hmod2;
 3212:       else if (k == kb)       return -depth;
 3213:       else if (k < izlev)     return mesh->ztot[k];
 3214:       else if (k > izlev) {
 3215:          const int ksig = k - izlev;
 3216: 
 3217:          if (hmod2 <= h_c) {
 3218:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3219: 
 3220:          } 
 3221:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3222:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3223:             assert(false && "ZCOOR (1): invalid h_c\n");
 3224:          } 
 3225:          else {
 3226:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3227:                    h_c * mesh->sigma[ksig] + 
 3228:                    (hmod2 - h_c) * mesh->cs[ksig];
 3229:          }
 3230:       } else { 
 3231:          assert(false && "ZCOOR (2): invalid level or coordinate system\n");
 3232:       }
 3233: 
 3234:    }
 3235:    else if constexpr(ivcor == 1) {
 3236:       if (k <= kb)        return -depth; 
 3237:       else if (k == ivrt) return eta2;
 3238:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3239:    }
 3240:    
 3241:    assert(false && "ZCOOR (3): invalid level or coordinate system\n");
 3242:    return 0.0;
 3243: }
 3244: 
 3245: 
 3246: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3247:    // Computes the bottom drag Cd based on the selected nchi
 3248: 
 3249:    if constexpr(nchi == 0) {
 3250:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3251:       Cd = drag;  // Read from drag file
 3252: 
 3253:    } else if constexpr(nchi == 1) {
 3254:       // 
 3255: 
 3256:       bool ltmp = false; // for WBL iteration
 3257: 
 3258:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3259:       if (isDry || (rough == 0.0)) {
 3260:          Cd = 0.0;
 3261: 
 3262:       } else { //roughness >0 
 3263:          
 3264:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3265: 
 3266:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3267: 
 3268:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3269: 
 3270:       } // if rough
 3271: 
 3272:    } else if constexpr(nchi == -1) {
 3273:    // Manning 
 3274:  
 3275:       const double htot = max(hmin_man, htot2()); 
 3276:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3277: 
 3278:    } else {
 3279:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3280:       
 3281:    } // if nchi
 3282: 
 3283: }
 3284: 
 3285: 
 3286: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3287:    // Checks if a side in on the boundary
 3288:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3289: 
 3290:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3291:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3292: 
 3293:    // Indices of the nodes that form the side
 3294:    const int n1 = side.n1->idx;
 3295:    const int n2 = side.n2->idx;
 3296:    isLand = false;
 3297:    
 3298: 
 3299:    // Check if the side is on a land boundary
 3300:    for (int i = 0; i < nland; i++) {
 3301:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3302:          // Consecutive nodes in the land boundary segment
 3303:          const int b1 = ilnd[i + j*nland];
 3304:          const int b2 = ilnd[i + (j + 1)*nland];
 3305: 
 3306:          assert(b1 != -1 && b2 != -1);
 3307: 
 3308:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3309:             
 3310:             isLand = true;
 3311:             return i;
 3312:          }
 3313:       }
 3314:    }
 3315: 
 3316:    // Check if the side is on an open boundary
 3317:    for (int i = 0; i < nope; i++) {
 3318:       for (int j = 0; j < nond[i] - 1; j++) {
 3319:          // Consecutive nodes in the open boundary segment
 3320:          const int b1 = iond[i + j*nope];
 3321:          const int b2 = iond[i + (j + 1)*nope];
 3322: 
 3323:          assert(b1 != -1 && b2 != -1);
 3324: 
 3325:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3326:             isLand = false;
 3327:             return i;
 3328:          }
 3329:       }
 3330:    }
 3331: 
 3332:    return -1;
 3333: }
 3334: 
 3335: 
 3336: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3337:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3338:                                     double *wind_rotate_angle, 
 3339:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3340:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3341:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3342:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3343:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 3344: 
 3345:    NODE(pnode);  
 3346:    const int i = idx_node;
 3347:    Node &node(*pnode);
 3348: 
 3349:    node.idx = i;
 3350: 
 3351:    const int idxNodeStart = nodeNeighNodesStart[i];
 3352:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3353:    node.numNodes = idxNodeEnd - idxNodeStart;
 3354:    node.nodes = nodeNeighNodes + idxNodeStart;
 3355:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3356: 
 3357: 
 3358: 
 3359:    const int idxElemStart = nodeNeighElemsStart[i];
 3360:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3361:    node.numElements = idxElemEnd - idxElemStart;
 3362:    node.elements = nodeNeighElems + idxElemStart;
 3363: 
 3364: 
 3365:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3366:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3367:       const int partNode = localNodePart[idxNodeGlobal]; 
 3368:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3369: 
 3370:       Node *node_ptr = nodes[partNode] + idxNode;
 3371:       
 3372:       nodeNeighNodes[idx] = node_ptr;
 3373:    }
 3374: 
 3375: 
 3376:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3377:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3378:       const int partElem = localElemPart[idxElemGlobal];
 3379:       const int idxElem  = localElemIndices[idxElemGlobal];
 3380: 
 3381:       Element *elem_ptr = elems[partElem] + idxElem;
 3382: 
 3383:       nodeNeighElems[idx] = elem_ptr;
 3384:    }      
 3385: 
 3386:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 3387:    sincosf((float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 3388: 
 3389:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 3390:    if constexpr(ics == 1) {
 3391:       node.p.x   = node_coords[i * 3];
 3392:       node.p.y   = node_coords[i * 3 + 1];
 3393:       node.gz = 0.0;
 3394: 
 3395:    } else {
 3396:       const double lat = node_coords[i * 3];
 3397:       const double lon = node_coords[i * 3 + 1];
 3398: printf("lat = %f, lon = %f, x = %f, y = %f\n", lat, lon, node.lat, node.lon);
 3399:       Point3 p = computeXYZfromLatLon(lat, lon);
 3400:       node.p = toVector2(p);
 3401:       node.gz = p.z;
 3402: 
 3403:       node.setFrame(p.y, p.x);
 3404: 
 3405:       node.frame.print();
 3406: 
 3407:    }
 3408: 
 3409:    node.depth = node_coords[i * 3 + 2];
 3410: 
 3411:    node.numSides = 0;
 3412: 
 3413:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3414:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3415:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3416:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3417:    else assert(false && "populateNodes: selected nchi not implemented.");
 3418:    
 3419:    if constexpr(ivcor == 1) 
 3420:    {  
 3421:       node.kb = kb[i];
 3422:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + i*nvrt];
 3423:    }
 3424: 
 3425:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3426:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3427:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3428: 
 3429:    
 3430:    // Links the node to the boundary information
 3431:    if (isbnd[i] >= 0) {
 3432:      
 3433:       // Get the index of the node boundary
 3434:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3435: 
 3436:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3437:       node.nodeBnd->node = &node;
 3438: 
 3439:       node.nodeBnd->sideBnd1 = nullptr;
 3440:       node.nodeBnd->sideBnd2 = nullptr;
 3441: 
 3442:       if (isbnd[i]>=0) {
 3443: 
 3444:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3445:          
 3446:          node.nodeBnd->segment->ifltype = 3 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3447:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3448: 
 3449:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3450:          node.nodeBnd->segment->clen  = nan("1");
 3451:          node.nodeBnd->segment->carea = nan("1");
 3452: 
 3453:       }
 3454:    } else {
 3455: 
 3456:       node.nodeBnd = nullptr; // For internal nodes
 3457: 
 3458:       if (isbnd[i] == landSegment) {
 3459:          node.nodeBnd = &landBoundaryNode;
 3460:          node.nodeBnd->segment = &landBoundarySegment;
 3461:       }
 3462:       
 3463:    }
 3464:    
 3465:    // XXXX GAUSSIAN HILL VELOCITIES
 3466: #ifdef GAUSSIAN_HILL_VELOCITIES
 3467:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3468:       constexpr double rot_per = 3000.0;
 3469:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3470:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3471:    // XXXXX
 3472: #endif
 3473: 
 3474: }
 3475: 
 3476: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3477:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3478:                                     double *wind_rotate_angle,   
 3479:                                     int *isdel, int *isidenode, int *isbnd,
 3480:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3481:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3482:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3483:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3484:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3485:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3486:                                     double *drag, double *roughness) {
 3487: 
 3488: 
 3489:    SIDE(pside);
 3490:    Side &side(*pside);
 3491:    const int i = idx_side;
 3492: 
 3493:    side.idx = i;  
 3494:    
 3495:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3496:    const double fc   = 2.0*omega_e*sin(sfea0);
 3497:    const double beta = 2.0*omega_e*cos(sfea0);
 3498: 
 3499:    // finding the pointer to the nodes that form the side
 3500:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3501:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3502: 
 3503:    const int locidx_n1 = localNodeIndices[idx_n1];
 3504:    const int locidx_n2 = localNodeIndices[idx_n2];
 3505:    const int part_n1 =   localNodePart[idx_n1];
 3506:    const int part_n2 =   localNodePart[idx_n2];
 3507: 
 3508:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3509:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3510: 
 3511:    // Counts the number of sides connected to each node
 3512:    side.n1->numSides++;
 3513:    side.n2->numSides++;
 3514: 
 3515:    // Normal, unitary vector to the side
 3516:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3517:    side.n = normalize(side.n);
 3518: 
 3519:    // Side boundary type
 3520:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3521:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3522: 
 3523:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3524:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3525:    {
 3526:       bool isLand = false;
 3527:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3528:       
 3529:       if (isbs > -1) {
 3530:          // assert(isLand || isbs>=0);
 3531:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3532: 
 3533:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3534: 
 3535:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3536:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3537: 
 3538:          assert (isLand == side.sideBnd->segment->isLand);
 3539: 
 3540:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3541:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3542:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3543: 
 3544:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3545:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3546:          
 3547:          side.sideBnd->side = &side;
 3548: 
 3549:       }
 3550:       else {
 3551:          side.sideBnd = nullptr;
 3552:       }
 3553:    }
 3554:    else 
 3555:    {
 3556:       side.sideBnd = nullptr;
 3557:    }
 3558: 
 3559: 
 3560:    // finding the pointer to the elements that share the side
 3561:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3562:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3563: 
 3564:    if (idx_e1 > -1) {
 3565:       const int locidx_e1 = localElemIndices[idx_e1];
 3566:       const int part_e1 =  localElemPart[idx_e1];
 3567:       side.elems[0] = elems[part_e1] + locidx_e1;
 3568: 
 3569:    }
 3570:    else {
 3571:       side.elems[0] = nullptr;
 3572:    }
 3573: 
 3574:    if (idx_e2 > -1) {
 3575:       const int locidx_e2 = localElemIndices[idx_e2];
 3576:       const int part_e2 =  localElemPart[idx_e2];
 3577:       side.elems[1] = elems[part_e2] + locidx_e2;
 3578:    }
 3579:    else {
 3580:       side.elems[1] = nullptr;
 3581:    }
 3582: 
 3583:    // Compute the center of the side
 3584:    side.center = 0.5*(side.n1->p + side.n2->p);
 3585: 
 3586:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3587:    side.shapiro = shapiro0;
 3588: 
 3589: #ifdef GAUSSIAN_HILL_VELOCITIES
 3590: // XXXX
 3591: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3592: constexpr double rot_per=3000.0;
 3593: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3594: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3595: // XXXXX      
 3596: #endif
 3597:    // Compute the z level at the center of the side
 3598:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3599:    
 3600:    // Compute the length of the side
 3601:    const Vector2 vLen = side.n2->p - side.n1->p;
 3602:    side.len = sqrt(dot(vLen, vLen));
 3603: 
 3604: 
 3605:    // Compute the Coriolis coefficient
 3606: 
 3607:    if constexpr(ncor == -1 || ncor == 0) {
 3608:       side.coriolis = coricoef;
 3609:    }
 3610:    else {
 3611:       const double sphi = side.lat();  // Latitude at the center of the side
 3612: 
 3613:       assert(use_ll && "use_ll must be true when ncor > 0");
 3614: 
 3615:       if constexpr(ics == 1) {
 3616:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3617:       }
 3618:       else { // ics == 2
 3619:          side.coriolis = 2.0*omega_e*sin(sphi);  
 3620:       }
 3621: 
 3622:    }
 3623: 
 3624: }
 3625: 
 3626: 
 3627: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3628:    double *node_coords, double *node_coords_ll, bool use_ll,
 3629:    double *wind_rotate_angle,   
 3630:    int *isdel, int *isidenode, int *isbnd,
 3631:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3632:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3633:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3634:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3635:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3636:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3637:    double *drag, double *roughness) {
 3638: 
 3639:    ELEM(pelem);
 3640:    Element &elem(*pelem);
 3641:    const int i = idx_elem;
 3642: 
 3643:    elem.idx = i;
 3644: 
 3645:    for (int j = 0; j < i34[i]; j++) {
 3646:       const int idxNode = elnode[i*4 + j];  
 3647:       const int idxSide = elside[i*4 + j];
 3648:       
 3649:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3650:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3651: 
 3652:       // Find the neighboring element  
 3653:       if (elem.sides[j]->elems[0] == &elem) {
 3654:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3655:       }
 3656:       else {
 3657:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3658:       }
 3659:       
 3660:    }
 3661: 
 3662:    elem.i34 = i34[i];
 3663: 
 3664:    // Compute the barycenter of the element and its depth
 3665:    elem.center = {0.0, 0.0};
 3666:    elem.depth = 1e10;
 3667:    for (int j = 0; j < i34[i]; j++) {
 3668: 
 3669:       elem.center += elem.nodes[j]->p/i34[i];
 3670:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 3671:    }
 3672: 
 3673:    elem.area = elem.computeSignedArea(); 
 3674:    elem.radius = sqrt(elem.area)/pi; 
 3675:    
 3676:    // Determines which way the normal vector to each side is oriented.
 3677:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3678:    for (int j = 0; j < i34[i]; j++)  
 3679:    {
 3680:       if (elem.sides[j]->elems[0] == &elem) {
 3681:          elem.ssign[j] =  1.0;
 3682:       }
 3683:       else {
 3684:          elem.ssign[j] = -1.0;
 3685:       }
 3686: 
 3687:    }
 3688: 
 3689:    // Derivatives of shape functions
 3690:    //  For ics=2, this is done in the element frame
 3691:    //  For quads, the derivative is evaluated at centroid
 3692:    for (int j = 0; j < elem.i34; j++) {
 3693:       const double area = elem.area;
 3694:       const int id2 = elem.nxq(1 + j);
 3695:       const int id3 = elem.nxq(2 + j);
 3696:       const int id4 = elem.nxq(3 + j);
 3697:       if (elem.isTri()) {
 3698:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3699:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3700:          // da1/dx = (y1 - y2)/(2*area)
 3701: 
 3702:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 3703:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 3704:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 3705: 
 3706:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 3707:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 3708: 
 3709:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3710:       }
 3711:       else  { // Quad; evaluate at centroid
 3712: 
 3713:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 3714:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 3715:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 3716: 
 3717:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 3718:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 3719: 
 3720:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3721:       } // if Tri
 3722: 
 3723:    } // for j   
 3724:    
 3725:    
 3726: 
 3727: }
 3728: 
 3729: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3730:                                             double *emo, double *efa, 
 3731:                                             double *umo, double *ufa, 
 3732:                                             double *vmo, double *vfa) {
 3733: 
 3734:    NODE_BND(nodeBnd);
 3735:    const int idx = idx_node_bnd;    
 3736: 
 3737:    nodeBnd->idx = idx;
 3738: 
 3739:    // Need to find the segment index and the index of the node on the segment
 3740:    int idxNode = -1;
 3741:    int iseg, i;
 3742:    for (iseg = 0; iseg < nope; iseg++) {
 3743:       // for each segment...
 3744:       for (i = 0; i < nond[iseg]; i++) {
 3745:          idxNode = iond[iseg + i*nope];
 3746:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3747:          
 3748:       }
 3749:    }
 3750: 
 3751:    assert(iseg < nope && "iseg is out of bounds");
 3752: 
 3753: found: // Jumped here when the node was found
 3754: 
 3755:    nodeBnd->isEssentialBC = true;
 3756:    nodeBnd->elbc = 0.0;
 3757: 
 3758:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3759: 
 3760:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 3761:       nodeBnd->efa[jfr] = efa[idx2];
 3762:       nodeBnd->emo[jfr] = emo[idx2];
 3763:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3764:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3765: 
 3766:    }
 3767:         
 3768: 
 3769: }
