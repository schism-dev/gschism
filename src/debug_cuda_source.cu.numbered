 6437: #ifdef DONTCOMPILE
 6438: __device__ void computeVerticalAdvection(void) {
 6439:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6440: 
 6441:    sdbt(1:2,:,:)=0.d0
 6442: 
 6443:    const Side *side = FROM kernel;
 6444: 
 6445:    if(side->isDry) return;
 6446: 
 6447:    // If side is wet...
 6448: 
 6449: 
 6450:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6451:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6452:    double ws[nvrt] = {} // w @ side
 6453:    int icount = 0;
 6454:    for (int j=0; j<2; j++) {
 6455:       const Element *elem = side->elements[j];
 6456:        
 6457:       if(elem != nullptr) {
 6458:          icount++;
 6459:          for (int k=0; k<nvrt; k++) {
 6460:             ws[k] = ws[k] + elem->w[k];
 6461:          }
 6462:       }
 6463:    }  // for j
 6464: 
 6465:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6466:    ws = ws/icount;
 6467: 
 6468:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6469:    // Splines allow for a smooth transition between vertical levels.
 6470:    // Splines have continuity restrictions at the internal knots, but
 6471:    // we have to provide the 1st derivatives at the endpoints.
 6472:    const int kbs = side->kbs; 
 6473:    
 6474:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6475:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6476:    initCubicSpline(kbs, nvrt, side, ws, up)
 6477: 
 6478:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6479:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6480:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6481: 
 6482:    // Total advection (average onto side)
 6483:    const Node *node1 = side->nodes[0];
 6484:    const Node *node2 = side->nodes[1];
 6485:    for (int k=kbs(i); k<nvrt; k++) {
 6486: 
 6487:       if constexpr(ics==1) {
 6488:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6489:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6490:       } else {
 6491:          // XXX IMPLEMENT THIS
 6492:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6493:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6494:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6495:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6496:       }  // if ics
 6497: 
 6498: 
 6499:    }
 6500: }
 6501: #endif
 6502: 
 6503: 
 6504: extern "C" {
 6505:    __global__ void computeElemAverageGhat(void) {
 6506:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6507: 
 6508:       ELEM(elem);
 6509:       
 6510:       elem->ghat1= {0.0, 0.0};  
 6511: 
 6512:       if constexpr(ihydraulics != 0) {
 6513:          if (nhtblocks > 0 && elem->isblock) return;
 6514:       }
 6515: 
 6516:       if (elem->isDry) return;
 6517: 
 6518:       // Wet elements.
 6519:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6520:       // tidal potential, horizontal diffusion, and baroclinic etc
 6521:       // Remember to update both fb and F 
 6522:       // If ics=2, ghat1 are in eframe (ll)
 6523:       // cff1-3: coefficients for 2D/3D
 6524:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6525:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6526:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6527: 
 6528:       double av_cff1 = 0.0;  // av. for cff1
 6529:       double av_cff2 = 0.0;  // av. for cff2
 6530:       double av_cff3 = 0.0;  // av. for cff3
 6531:       double av_df = 0.0;  // av. for H^\alpha / H
 6532:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6533:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6534: 
 6535:       const int i34 = elem->i34;
 6536:       const int kb = elem->kb;
 6537: 
 6538:       for (int j=0; j<i34; j++) {
 6539:          // For each node and side in the element...
 6540: 
 6541:          const Node *node = elem->nodes[j];
 6542:          const Side *side = elem->sides[j];
 6543: 
 6544:          const double chi      = side->chi;
 6545:          const double veg_c2   = side->veg_c2;
 6546:          const double veg_beta = side->veg_beta;
 6547:          const double veg_h    = side->veg_h();
 6548:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6549: 
 6550:          // Node - const in elem
 6551:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6552:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6553: 
 6554:          if (elem->depth >= tip_dp) {
 6555:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6556:          }
 6557: 
 6558:          
 6559:          const double htot  = side->htot2();        // Total depth at the side
 6560:          const double zctr2 = side->zTopCanopy();  
 6561: 
 6562:          double cff1; 
 6563:          double cff2; 
 6564:          double cff3;   
 6565:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6566:          // coefficients applied to 2D/3D case 
 6567:             cff1 = side->hhat/htot;
 6568:             cff2 = 0.0;
 6569:             cff3 = 0.0;
 6570:          } else { //3D
 6571:             //Init for no-veg case
 6572:             cff1 = 1.0;
 6573:             cff2 = 1.0;
 6574:             cff3 = 0.0;
 6575: 
 6576:             if constexpr(iveg != 0) {
 6577:                // Computes coefficients used with vegetation terms G1, G2
 6578:                // cff1, cff3 are used for the first two terms in G1, G2:
 6579:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6580:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6581:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6582:                if(veg_h < 0.99*htot) { // submergent vegetation
 6583:                   cff1=1;
 6584:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6585:                   cff3 = veg_c;
 6586: 
 6587:                } else { // emergent vegetation
 6588:                   cff1 = 1.0/(1.0 + veg_c2);
 6589:                   cff2 = cff1;
 6590:                   cff3 = 0.0;
 6591: 
 6592:                }
 6593:             } // if iveg
 6594:          } //  2D/3D
 6595: 
 6596:          av_cff1 += cff1/i34;
 6597:          av_cff2 += cff2/i34;
 6598:          av_cff3 += cff3/i34;
 6599:          av_cff2_chi += cff2*chi/i34;
 6600:          av_cff3_chi += cff3*chi/i34;
 6601:          av_df += min(htot, veg_h)/(htot*i34);
 6602: 
 6603: 
 6604:          // btrack values: U^\star, U^{\star\alpha}
 6605:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6606:          Vector2 Ustar       = {0.0, 0.0}; 
 6607:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6608: 
 6609:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6610:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6611:          } else { //3D
 6612:             for (int k = side->kb; k < nvrt; k++) {
 6613:             
 6614:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6615:                Ustar += w2;
 6616: 
 6617:                if constexpr(iveg != 0) {
 6618:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6619:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6620:                        Ustar_alpha += zrat*w2; // XXXX
 6621:                    }
 6622:                }  // if iveg
 6623:             }  // for k
 6624:          }  //2D/3D
 6625:          
 6626: 
 6627:          // Add btrack & surface stress terms to \breve{G} first
 6628:          if constexpr(ics==1) {
 6629: 
 6630:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6631: 
 6632:          } else {
 6633:             // XXX IMPLEMENT THIS
 6634:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6635:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6636:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6637:          }  // if ics
 6638: 
 6639:          // Surface and bottom stress terms
 6640:          if constexpr(ics==1) {
 6641:             const Vector2 tau    = side->tau();
 6642:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6643: 
 6644:             // Term for surface and bottom stress
 6645:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6646: 
 6647:          } else {
 6648:             assert(false && "computeElemAverageGhat: Not implemented");
 6649:             // XXX IMPLEMENT THIS
 6650:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6651:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6652:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6653:             // tau_x=(vn1+tt1)/2.d0
 6654:             // tau_y=(vn2+ss1)/2.d0
 6655:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6656:          }  // if ics
 6657: 
 6658:          
 6659: 
 6660:          // All terms in F,F^\alpha,f_b except baroclinic
 6661:          // F, f_b: all explicit terms excluding vegetation 
 6662:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6663:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6664:          const double coriolis = side->coriolis;
 6665:          Vector2 F  =  coriolis*side->U;  // F_x
 6666:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6667:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6668: 
 6669:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6670:             
 6671:             for (int k = side->kb; k < nvrt; k++) {
 6672:                if (zctr2 > side->zc[k-1]) {
 6673:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6674:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6675:                    Fa +=  coriolis*w2*zrat;
 6676:                } // if zctr2
 6677:             } // k
 6678:          } // iveg
 6679: 
 6680:          // Integrate horizontal viscosity force vertically
 6681:          for (int k=side->kb + 1; k<nvrt; k++) {
 6682:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6683: 
 6684:             F += levelHorVisc;
 6685: 
 6686:             // Vegetation term
 6687:             if constexpr(iveg!=0) {
 6688:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6689:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6690:                   Fa += levelHorVisc*zrat;
 6691:                } 
 6692:             } // if iveg
 6693:          } // for k
 6694: 
 6695:          fb += side->nuGradU[side->kb];
 6696: 
 6697:          // Add to ghat1
 6698:          if constexpr(ics==2) {
 6699:             // XXX IMPLEMENT THIS
 6700:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6701:             // bigf1=vn1; bigf2=vn2
 6702:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6703:             // botf1=vn1; botf2=vn2
 6704:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6705:             // bigfa1=vn1; bigfa2=vn2
 6706:          } // if ics
 6707: 
 6708:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6709:       } // for j (nodes and sides)
 6710: 
 6711:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6712:          
 6713:       // Finish off terms in F, F^\alpha and f_b
 6714:       const double grav3 = elem->mean(&Node::grav2);
 6715:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6716: 
 6717: 
 6718:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6719:       for (int j=1; j<i34; j++) { 
 6720:          // For each side in the element...
 6721:          const Side *side = elem->sides[j];
 6722:          const double chi = side->chi;
 6723: 
 6724:          const double htot = side->htot2();
 6725:          const double veg_h = side->veg_h();
 6726:          const Vector2 F  = htot*fb;
 6727:          const Vector2 Fa = min(htot, veg_h)*fb;
 6728: 
 6729:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6730:       } // for j
 6731: 
 6732:       //botf1 etc are already in elem frame
 6733:       elem->ghat1 += tmp/i34;
 6734: 
 6735:       // Baroclinic force
 6736:       if constexpr(ibc==0) {
 6737:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6738: 
 6739:          Vector2 Fa = {0.0, 0.0};
 6740:          Vector2 intGradRho = {0.0, 0.0};
 6741:          
 6742:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6743:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6744:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6745: 
 6746:             // \in F [m^2/s/s]
 6747:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6748:          }
 6749: 
 6750:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6751:          const Vector2 F = av_df*Fa; //approx
 6752:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6753: 
 6754:       } // if ibc
 6755: 
 6756: 
 6757: 
 6758:    }
 6759: 
 6760: } // extern "C"
 6761: 
 6762: 
 6763: 
 6764: #ifdef DONTCOMPILE
 6765: __global__ void checkMassConservation(Tracers* sumtr) {
 6766: 
 6767:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6768: 
 6769:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6770: 
 6771:    Element *elem = &(mesh->localElemData[i]);
 6772: 
 6773:    // Skip dry elements
 6774:    if (elem->isDry) return;
 6775: 
 6776:    // Local sum array for this thread
 6777:    double localSum[N_TRACERS] = {0.0};
 6778: 
 6779:    // Sum over vertical levels for this element
 6780:    const int kbe = elem->kbe;
 6781:    const double area = elem->area;
 6782: 
 6783:    for (int k = kbe; k < nvrt; k++) {
 6784:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6785:       
 6786:       // Accumulate tracer mass
 6787:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6788:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6789:       }
 6790:    }
 6791: 
 6792:    
 6793: 
 6794:    //  This function returns per element sums. A reduction must be done on the host side.
 6795: }
 6796: 
 6797: 
 6798: __global__ void transport(void) {
 6799: 
 6800:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6801: 
 6802:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6803: 
 6804:    Element *elem = &(mesh->localElemData[ie]);
 6805: 
 6806:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6807: 
 6808:                for (int m=0; m<ntr; m++) {
 6809:                   for (int k=kbe(ie); k<nvrt; k++) {
 6810:                      // Calculate each polynomial's weight 
 6811:                      wm=0.d0; sum1=0.d0; 
 6812:                      wm1=0.d0; wm2=0.d0; 
 6813:                      for (int i=0; i<elem->nweno2; i++) {
 6814:                   
 6815:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6816:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6817:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6818:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6819:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6820:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6821:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6822:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6823:                      // -----------------Hu and Shu (1999)'s method----------------
 6824:                      b4=b1+b2+b3
 6825: 
 6826: //Error: add PRODUCTION CPP
 6827: #ifdef DEBUG
 6828:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6829:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6830:                     call parallel_abort(errmsg)
 6831:                   }
 6832: #endif
 6833: 
 6834:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6835:                   // !----test-------------- 
 6836:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6837:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6838:                   // !wm(i)=wm1(i)*wm2(i)
 6839:                   // !---------------------- 
 6840:                   sum1=sum1+wm(i)
 6841:                 } // end for i
 6842: 
 6843:                 wm=wm/sum1
 6844: 
 6845:                 for (int j=0; j<elem->i34; j++) {
 6846: 
 6847:                   const Side *side  = elem->sides[j];
 6848:                   const Node *node1 = side->n1;
 6849:                   const Node *node2 = side->n2;
 6850: 
 6851:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6852:                      trsd=0.d0
 6853:                      for (int kk=0; kk<nquad; kk++) {
 6854:                         for (int i=0; i<elem->nweno2; i++) {
 6855:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6856:                         } // end for i   
 6857:                      } // end for kk
 6858:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6859:                   } // outward flux
 6860:                } // end for j=1,i34(ie) ! side
 6861:             }
 6862:          }
 6863:               
 6864: 
 6865: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6866: //             //   calculate each polynomial's weight 
 6867: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6868: //                 wm=0.d0; sum1=0.d0
 6869: //                 do i=1,nweno1(ie) !for each polynomial
 6870: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6871: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6872: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6873: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6874: //                   wm(i)=b2
 6875: //                   sum1=sum1+b2
 6876: //                   !wm(i)=1.d0
 6877: //                   !sum1=sum1+1.d0
 6878: 
 6879: // // Error: PRODUCTION
 6880: // #ifdef DEBUG
 6881: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6882: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6883: //                     call parallel_abort(errmsg)
 6884: //                   endif
 6885: // #endif
 6886: 
 6887: //                 enddo !i
 6888: //                 wm=wm/sum1 !final weight
 6889: 
 6890:                 for (int j=0; j<elem->i34; j++) { // side
 6891:                   const Side *side = elem->sides[j];
 6892:                   const Node *node1 = side->n1;
 6893:                   const Node *node2 = side->n2;
 6894: 
 6895:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6896:                     trsd=0.d0
 6897:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6898:                       for (int i=0; i<elem->nweno1; i++) {
 6899:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6900:                       }
 6901:                     enddo //kk
 6902:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6903:                   } // outward flux
 6904:                 } // end for j=1,i34(ie) ! side
 6905:               } // end for k; ntr 
 6906: 
 6907:             else !simple upwind method
 6908:               do j=1,i34(ie)
 6909:                 jsj=elside(j,ie)
 6910:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6911:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6912:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6913:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6914:                   endif
 6915:                 enddo  !vertical layers
 6916:               enddo !j=1,i34(ie) ! side
 6917:             endif !order of accuracy
 6918: 
 6919:          //  enddo !ie
 6920: // !$OMP     end do
 6921: 
 6922: // !$OMP     master
 6923: //           !message passing
 6924: //           if (nproc>1) then
 6925: //             !make a copy of side concentrations
 6926: //             trsd_tmp0=trsd_tmp 
 6927: 
 6928: //             !this exchange routine swaps interface concentration between two partitions
 6929: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 6930: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 6931: 
 6932: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 6933: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 6934: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 6935: 
 6936: 
 6937: //             !This obtains final values for interface sides
 6938: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 6939: //       :    endif !nproc>1
 6940: //           !message passing end
 6941: // !$OMP     end master
 6942: // !$OMP     barrier
 6943: 
 6944: 
 6945: // !         Do advection; conc @ dry elem will not be changed
 6946: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
