 4490: 
 4491: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 4492:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 4493:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 4494: 
 4495: 
 4496:    NODE(node1);
 4497: 
 4498:    node1->clearMatrixRow();
 4499:    node1->qel = 0.0;
 4500: 
 4501:    // THIS IS FOR STRUCTURES XXX
 4502:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 4503: 
 4504:    
 4505:    for (int j=0; j<node1->numElements; j++) {
 4506:       // For each element connected to the node...
 4507: 
 4508:       Element *elem = node1->elements[j];
 4509: 
 4510: 
 4511: 
 4512:       // Compute the average gravity
 4513:       const double grav3 = elem->mean(&Node::grav2);
 4514: 
 4515:       // Look at the documentation for the description of the terms in the following integrals
 4516: 
 4517:       // Integral I_1 
 4518:       // \bar{\breve{H}} 
 4519:       const double hhatb = elem->mean(&Side::hhat);        
 4520: 
 4521:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 4522: 
 4523:       const int id1 = elem->nodeLocalIdx(node1); 
 4524:       const double area = elem->area;
 4525: 
 4526:       if (elem->isTri()) {
 4527: 
 4528:          // To clarify the notation in this section: 
 4529:          //   i stands for the node under consideration (node1)
 4530:          //   j (node2) and k (node3) are the other nodes of the triangle.
 4531:          const int id2 = elem->nxq(1 + id1);
 4532:          const int id3 = elem->nxq(2 + id1);
 4533:          Node *node2 = elem->nodes[id2];
 4534:          Node *node3 = elem->nodes[id3];
 4535: 
 4536:          Point2 x1, x2, x3;
 4537:          elem->getLocalHorizontalNodePositionsTri(x1, x2, x3, id1);
 4538: 
 4539: 
 4540:          // integral of phi_i*phi_j
 4541:          const double ipp_ii = (1.0/6.0 )*area;
 4542:          const double ipp_ij = (1.0/12.0)*area;
 4543:          const double ipp_ik = (1.0/12.0)*area;
 4544: 
 4545:          // integral of [(grad phi_i) * (grad phi_j)]
 4546:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 4547:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 4548:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 4549: 
 4550:          // Computes the different components of integral I_1 of each node with respect to node i.
 4551:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4552:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4553:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4554: 
 4555:          node1->addToSparseMatrix(node1, I1_ii);
 4556:          node1->addToSparseMatrix(node2, I1_ij); 
 4557:          node1->addToSparseMatrix(node3, I1_ik);
 4558: 
 4559:       }
 4560:       else { // Quad
 4561:          // XXX IMPLEMENT THIS
 4562:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 4563: 
 4564:          // // To clarify the notation in this section: 
 4565:          // //   i stands for the node under consideration (node1)
 4566:          // //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 4567:          // const int id2 = elem->nxq(1 + id1);
 4568:          // const int id3 = elem->nxq(2 + id1);
 4569:          // const int id4 = elem->nxq(3 + id1);
 4570:          // Node *node2 = elem->nodes[id2];
 4571:          // Node *node3 = elem->nodes[id3];
 4572:          // Node *node4 = elem->nodes[id4];         
 4573: 
 4574:          // // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 4575:          // const double ipp_ii = elem->intPhiPhi(id1, id1);
 4576:          // const double ipp_ij = elem->intPhiPhi(id1, id2);
 4577:          // const double ipp_ik = elem->intPhiPhi(id1, id3);
 4578:          // const double ipp_il = elem->intPhiPhi(id1, id4);
 4579: 
 4580:          // // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 4581:          // const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 4582:          // const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 4583:          // const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 4584:          // const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 4585: 
 4586:          // // Computes the different components of integral I_1 of each node with respect to node i.
 4587:          // const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4588:          // const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4589:          // const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4590:          // const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 4591: 
 4592:          // node1->addToSparseMatrix(node1, I1_ii);
 4593:          // node1->addToSparseMatrix(node2, I1_ij); 
 4594:          // node1->addToSparseMatrix(node3, I1_ik);
 4595:          // node1->addToSparseMatrix(node4, I1_il);
 4596:   
 4597:       } 
 4598: 
 4599:  
 4600:       // Integral I_4
 4601:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 4602:       // Where
 4603:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 4604: 
 4605:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 4606:       // of U over the element.
 4607:       Vector2 U = {0.0, 0.0};
 4608:       for (int m=0; m < elem->i34; m++) {      
 4609:          const Side *side = elem->sides[m];
 4610: 
 4611:          if constexpr(ics == 1) U += side->U; 
 4612:          else                   U += side->frame.projHorVec(side->U, elem->frame);  // In global coordinates, we must project the side velocity to the element frame
 4613: 
 4614:       }
 4615:       U = U/elem->i34;
 4616: 
 4617: 
 4618:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 4619: 
 4620: 
 4621:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 4622:       const double I_4_1 = dot(gradPhi_1, U);
 4623: 
 4624: 
 4625:       // Integral of \nabla\phi_i \cdot \pmb{E}
 4626:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 4627: 
 4628:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 4629: 
 4630:       // Additional terms 
 4631:       double vnorm = 0.0;
 4632:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 4633:          Vector3 ubed = {0.0, 0.0, 0.0};
 4634:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 4635:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 4636: 
 4637:          Vector3 gradP = {0.0, 0.0, 1.0};
 4638:          for (int m=0; m < elem->i34; m++) {
 4639:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 4640:            gradP += toVector3(gradP_2D, 0.0);
 4641:          }   
 4642:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 4643:       } // imm==2
 4644: 
 4645:       if (elem->isTri()) {
 4646:          for (int l=0; l<3; l++) {
 4647: 
 4648:             Node *node = elem->nodes[l];
 4649: 
 4650:             double fac = (node == node1) ? 2.0 : 1.0;
 4651:    
 4652:             if      constexpr(imm == 2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 4653:             else if constexpr(imm == 1) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + (node->bdef2 - node->bdef1)); 
 4654:             else                        node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2); 
 4655:            
 4656:          }
 4657: 
 4658: 
 4659:          if (!elem->isDry) {
 4660:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 4661: 
 4662:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 4663: 
 4664:          }
 4665: 
 4666:       } // isTri
 4667:       else { // isQuad
 4668:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 4669:          // for (int l=0; l<4; l++) {
 4670:          //   const Node *node = elem->nodes[l];
 4671: 
 4672:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 4673:          //   else        tmp2 = node->bdef2 - node->bdef1;
 4674: 
 4675:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 4676:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 4677:          // }
 4678: 
 4679:       } // isQuad
 4680: 
 4681: 
 4682:      node1->qel += (dt/elem->i34)*elem->vsource;
 4683:       
 4684: 
 4685:    } // for all elements connected to the node
 4686:    
 4687: 
 4688:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 4689:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 4690:    NodeBoundary *nodeBnd = node1->nodeBnd;
 4691:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 4692:       // If it is an open boundary node...
 4693: 
 4694:       // At least one open bnd side, maybe two
 4695:       for (int l=0; l<2; l++) { 
 4696: 
 4697:          // Gets each of the sides sharing the node. 
 4698:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 4699: 
 4700:        
 4701: 
 4702:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 4703:          if (sideBnd != nullptr) {
 4704:             // If the side is on a boundary...
 4705: 
 4706:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 4707: 
 4708:             // Get the boundary segment
 4709:             const BoundarySegment *sideSegment = sideBnd->segment;
 4710:             const Side *side = sideBnd->side;
 4711: 
 4712:             // Integral I_3
 4713:             if (sideSegment->ifltype != 0) {
 4714:             // Natural or Flather b.c.
 4715: 
 4716:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4717:                // especially for Flather b.c.
 4718:                double ri3 = 0.0;
 4719:                if (!side->isDry) {
 4720:                   // If the side is not dry
 4721:                   
 4722:                   // Computes the side flux of (uth, vth)
 4723:                   double Vn = 0.0;
 4724:                   for (int k = side->kb; k < nvrt - 1; k++) {
 4725:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4726:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4727: 
 4728:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 4729:                   }
 4730: 
 4731:                   ri3 = 0.5*side->len*Vn;
 4732:                }
 4733: 
 4734:                if (sideSegment->ifltype == -1) { // Flather 1
 4735: 
 4736:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4737:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4738: 
 4739:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4740:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4741:                   
 4742:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4743:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4744: 
 4745:                } 
 4746:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4747:                   // Reset ri3
 4748:                   ri3 = 0.0;
 4749: 
 4750:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4751:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 4752: 
 4753:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4754: 
 4755:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4756:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4757: 
 4758:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4759:                   node1->addToSparseMatrix(node1, con0*2.0);
 4760:                   node1->addToSparseMatrix(node2, con0);
 4761: 
 4762:                } // if Flather or Discharge
 4763: 
 4764:                node1->qel -= thetai*dt*ri3;  
 4765: 
 4766: 
 4767:             } // I_3
 4768:           
 4769: 
 4770:             // Integral I_5
 4771:             if(!side->isDry) {
 4772: 
 4773:                const double Unbar = dot(side->U, side->n);
 4774:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar; 
 4775: 
 4776:             } // I_5
 4777: 
 4778:          } // if is boundary side
 4779: 
 4780:       } // for l
 4781: 
 4782:    } // if isbnd
 4783: 
 4784: 
 4785: }
 4786: 
 4787: 
