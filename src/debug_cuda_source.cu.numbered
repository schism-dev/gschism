 8721:          *sizeType = sizeof(Vector2);
 8722:          break;
 8723:       case (int)VarCode::gradETP:
 8724:          *offset = (int)((char*)&sides[0].gradETP.x - (char*)sides);
 8725:          *sizeType = sizeof(Vector2);
 8726:          break;
 8727:       case (int)VarCode::gradPr:
