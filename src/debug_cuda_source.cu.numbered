 8834: #ifdef DONTCOMPILE
 8835: __global__ void checkMassConservation(Tracers* sumtr) {
 8836: 
 8837:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 8838: 
 8839:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 8840: 
 8841:    Element *elem = &(mesh->localElemData[i]);
 8842: 
 8843:    // Skip dry elements
 8844:    if (elem->isDry) return;
 8845: 
 8846:    // Local sum array for this thread
 8847:    double localSum[ntracers] = {0.0};
 8848: 
 8849:    // Sum over vertical levels for this element
 8850:    const int kbe = elem->kbe;
 8851:    const double area = elem->area;
 8852: 
 8853:    for (int k = kbe; k < nvrt; k++) {
 8854:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 8855:       
 8856:       // Accumulate tracer mass
 8857:       for (int tr = 0; tr < ntracers; tr++) {
 8858:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 8859:       }
 8860:    }
 8861: 
 8862:    //  This function returns per element sums. A reduction must be done on the host side.
 8863: }  
 8864: 
 8865: 
 8866: __global__ void transport(void) {
 8867: 
 8868:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 8869: 
 8870:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 8871: 
 8872:    Element *elem = &(mesh->localElemData[ie]);
 8873: 
 8874:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 8875: 
 8876:                for (int m=0; m<ntr; m++) {
 8877:                   for (int k=kbe(ie); k<nvrt; k++) {
 8878:                      // Calculate each polynomial's weight 
 8879:                      wm=0.d0; sum1=0.d0; 
 8880:                      wm1=0.d0; wm2=0.d0; 
 8881:                      for (int i=0; i<elem->nweno2; i++) {
 8882:                   
 8883:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8884:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8885:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8886:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8887:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8888:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 8889:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 8890:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 8891:                      // -----------------Hu and Shu (1999)'s method----------------
 8892:                      b4=b1+b2+b3
 8893: 
 8894: //Error: add PRODUCTION CPP
 8895: #ifdef DEBUG
 8896:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 8897:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 8898:                     call parallel_abort(errmsg)
 8899:                   }
 8900: #endif
 8901: 
 8902:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 8903:                   // !----test-------------- 
 8904:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 8905:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 8906:                   // !wm(i)=wm1(i)*wm2(i)
 8907:                   // !---------------------- 
 8908:                   sum1=sum1+wm(i)
 8909:                 } // end for i
 8910: 
 8911:                 wm=wm/sum1
 8912: 
 8913:                 for (int j=0; j<elem->i34; j++) {
 8914: 
 8915:                   const Side *side  = elem->sides[j];
 8916:                   const Node *node1 = side->n1;
 8917:                   const Node *node2 = side->n2;
 8918: 
 8919:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 8920:                      trsd=0.d0
 8921:                      for (int kk=0; kk<nquad; kk++) {
 8922:                         for (int i=0; i<elem->nweno2; i++) {
 8923:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8924:                         } // end for i   
 8925:                      } // end for kk
 8926:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 8927:                   } // outward flux
 8928:                } // end for j=1,i34(ie) ! side
 8929:             }
 8930:          }
 8931:               
 8932: 
 8933: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 8934: //             //   calculate each polynomial's weight 
 8935: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 8936: //                 wm=0.d0; sum1=0.d0
 8937: //                 do i=1,nweno1(ie) !for each polynomial
 8938: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 8939: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 8940: //                   b1=b1*b1+b2*b2 !smoothness indicator
 8941: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 8942: //                   wm(i)=b2
 8943: //                   sum1=sum1+b2
 8944: //                   !wm(i)=1.d0
 8945: //                   !sum1=sum1+1.d0
 8946: 
 8947: // // Error: PRODUCTION
 8948: // #ifdef DEBUG
 8949: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 8950: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 8951: //                     call parallel_abort(errmsg)
 8952: //                   endif
 8953: // #endif
 8954: 
 8955: //                 enddo !i
 8956: //                 wm=wm/sum1 !final weight
 8957: 
 8958:                 for (int j=0; j<elem->i34; j++) { // side
 8959:                   const Side *side = elem->sides[j];
 8960:                   const Node *node1 = side->n1;
 8961:                   const Node *node2 = side->n2;
 8962: 
 8963:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 8964:                     trsd=0.d0
 8965:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 8966:                       for (int i=0; i<elem->nweno1; i++) {
 8967:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 8968:                       }
 8969:                     enddo //kk
 8970:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 8971:                   } // outward flux
 8972:                 } // end for j=1,i34(ie) ! side
 8973:               } // end for k; ntr 
 8974: 
 8975:             else !simple upwind method
 8976:               do j=1,i34(ie)
 8977:                 jsj=elside(j,ie)
 8978:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 8979:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 8980:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 8981:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 8982:                   endif
 8983:                 enddo  !vertical layers
 8984:               enddo !j=1,i34(ie) ! side
 8985:             endif !order of accuracy
 8986: 
 8987:          //  enddo !ie
 8988: // !$OMP     end do
 8989: 
