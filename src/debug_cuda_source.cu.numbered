 7223: __global__ void printMatrix(void) {
 7224: 
 7225: 
 7226:    // Let only one thread per block print at a time 
 7227: 
 7228:    if (threadIdx.x == 0) {
 7229:       for (int ithread = 0; ithread < blockDim.x; ithread++) {
 7230:          const int idx_node = ithread + blockIdx.x * blockDim.x;
 7231:          if (idx_node >= mesh->np) return;
 7232:          const Node *node = mesh->localNodeData + idx_node;
 7233:          printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7234:          for (int j = 0; j < node->numNodes; j++) {
 7235:             Node* nbNode = node->nodes[j];
 7236:             if (node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7237:          }
 7238:          printf("]\n");
 7239: 
 7240:       }
 7241:    }
 7242: 
 7243: 
 7244: 
 7245: }
