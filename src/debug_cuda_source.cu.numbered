 7064: __global__ void printMatrix(bool full) {
 7065:    // Debugging: print the matrix
 7066: 
 7067:    const int size = mesh->np;
 7068:    double sum = 0.0;
 7069:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7070:       const Node *node = mesh->localNodeData + idx_node;
 7071:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7072:       for (int j = 0; j < node->numNodes; j++) {
 7073:          Node* nbNode = node->nodes[j];
 7074:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7075:          sum += node->coeffMatrix[j];
 7076:       }
 7077:       if (full) printf("]\n");
 7078: 
 7079: 
 7080:    }
 7081:    if (!full) printf("sum=%lf\n", sum);
 7082: }
