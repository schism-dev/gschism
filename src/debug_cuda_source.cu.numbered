 2650: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2651: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2652: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2653: // Only when ics == 2, the origin is at the element center.
 2654: 
 2655:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2656: 
 2657:    const Node *node = nodes[idxNode];
 2658: 
 2659:    if constexpr(ics==1) {
 2660:       return node->p;
 2661: 
 2662:    } else {
 2663:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2664: 
 2665:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2666: 
 2667:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2668:    }
 2669: 
 2670: }
 2671: 
 2672: 
 2673: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, 
 2674:                                                                             const Vector3& c, const Frame<ics>& dstFrame, int idx) const {
 2675: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2676: 
 2677:    const int id1 = idx;
 2678:    const int id2 = nxq(1 + id1);
 2679:    const int id3 = nxq(2 + id1);
 2680: 
 2681:    if constexpr(ics==1) {
 2682:       x0 = nodes[id1]->p;
 2683:       x1 = nodes[id2]->p;
 2684:       x2 = nodes[id3]->p;
 2685: 
 2686:    } else {
 2687: 
 2688:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2689:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2690:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2691: 
 2692:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2693:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2694:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2695: 
 2696:    }
 2697: 
 2698: }
 2699: 
 2700: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2701:    getLocalHorizontalNodePositionsTri(x0, x1, x2, {center.x, center.y, centerZ()}, frame, idx);
 2702: }
 2703: 
 2704: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2705:             Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3,
 2706:             const Vector3& c, const Frame<ics>& dstFrame) const {
 2707: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2708: 
 2709:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2710: 
 2711: 
 2712: 
 2713:    if constexpr(ics==1) {
 2714:       x0 = nodes[0]->p;
 2715:       x1 = nodes[1]->p;
 2716:       x2 = nodes[2]->p;  
 2717:       x3 = nodes[3]->p;
 2718: 
 2719:    } else {
 2720: 
 2721:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2722:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2723:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2724:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2725: 
 2726:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2727:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2728:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2729:       x3 = toVector2(dstFrame.G2L(p3 - c));
 2730:    }
 2731: 
 2732: }
 2733: 
 2734: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2735:    Point2& x0, Point2& x1, Point2& x2, Point2& x3) const
 2736: {
 2737:    getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, {center.x, center.y, centerZ()}, frame);
 2738: }
