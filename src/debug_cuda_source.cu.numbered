 1260:    __device__ __forceinline__ Vector2 grad2(double *a) const
 1261:    {
 1262:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
 1263:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
 1264:       if (isQuad()) {
 1265:          gx += a[3]*gradPhi[3].x;
 1266:          gy += a[3]*gradPhi[3].y;
 1267:       }
 1268:       return {gx, gy};
 1269:    }
 1270: 
 1271:    __device__ __forceinline__ Vector2 grad2(double Node::* field) const
 1272:    {
 1273:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
 1274:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
 1275:       if (isQuad()) {
 1276:          gx += (nodes[3]->*field)*gradPhi[3].x;
 1277:          gy += (nodes[3]->*field)*gradPhi[3].y;
 1278:       }
 1279:       return {gx, gy};
 1280:    }
 1281: 
 1282:    __device__ __forceinline__ Vector3 n(int k, double &area3D) const;
 1283:    __device__ __forceinline__ Vector3 n(int k) const {
 1284:       double area3D;
 1285:       return n(k, area3D);
 1286:     }
