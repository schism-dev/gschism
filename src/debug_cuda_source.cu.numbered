 7747:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7748:                     trsd=0.d0
 7749:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
