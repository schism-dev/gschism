 6951:    __global__ void computeNodalHorizontalVelocities1(void) {
 6952: 
 6953:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6954: 
 6955:       ELEM(elem);
 6956: 
 6957:       if (elem->isDry) return;
 6958: 
 6959:       const int kb = elem->kb;
 6960:       const bool isTri = elem->isTri();
 6961: 
 6962:       if constexpr(indvel <= 0) {
 6963:          // Assuming discontinous hvel.
 6964: 
 6965:          if (isTri) { // For triangles
 6966:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6967:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6968:             #pragma unroll
 6969:             for (int j = 0; j < 3; j++) {
 6970:                // For every node of the triangle...
 6971:                Node *node = elem->nodes[j];
 6972: 
 6973:                if (node->isDry) continue;
 6974: 
 6975:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 6976:                const Side *s2 = elem->sides[(j + 1) % 3];
 6977:                const Side *s3 = elem->sides[(j + 2) % 3];
 6978: 
 6979:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 6980: 
 6981:                atomicAdd(&(node->tmp.i), 1);
 6982: 
 6983:                for (int k = kb; k < nvrt; k++)  {
 6984:                   Vector2 s1u2 = s1->u2[k];
 6985:                   Vector2 s2u2 = s2->u2[k];
 6986:                   Vector2 s3u2 = s3->u2[k];
 6987: 
 6988:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 6989:                   if constexpr(ics == 2) {
 6990:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 6991:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 6992:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 6993:                   }
 6994: 
 6995:                   Vector2 u = s2u2 + s3u2 - s1u2; // u extrapolated linearly at node j.   
 6996:                   u = clampVelocity(u);
 6997:                   atomicAdd(&(node->utmp[k].x), u.x);
 6998:                   atomicAdd(&(node->utmp[k].y), u.y);
 6999: 
 7000:                }
 7001: 
 7002:             }
 7003:          }
 7004:          else { // For quads
 7005: 
 7006: 
 7007:             // Compute the bilinear coordinates of the center of each diagonal.
 7008:             double xi, eta;
 7009:             double shp13[4], shp24[4];
 7010:             Point2 x0, x1, x2, x3;
 7011:             elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 7012:             const Point2 p13 = 0.5 * (x0 + x2);   // Center of sides 1 & 3
 7013:             const Point2 p24 = 0.5 * (x1 + x3);   // Center of sides 2 & 4
 7014: 
 7015:             elem->inverseBilinearQuad(p13, xi, eta, shp13);
 7016:             elem->inverseBilinearQuad(p24, xi, eta, shp24);
 7017: 
 7018: 
 7019: 
 7020: 
 7021:             for (int k = kb; k < nvrt; k++) {
 7022: 
 7023:                //Each quad is split into two triangles. For each triangle we extrapolate as we did for triangles.
 7024:                Vector2 sideU[4];
 7025:                #pragma unroll
 7026:                for (int j = 0; j < 4; j++) {
 7027:                   Vector2 u = elem->sides[j]->u2[k];
 7028:                   if constexpr(ics == 2) u = elem->sides[j]->frame.projHorVec(u, elem->frame);
 7029:                   sideU[j] = u;
 7030:                }
 7031: 
 7032:                Vector2 ud1 = shp13[0]*sideU[0] + shp13[1]*sideU[1] + shp13[2]*sideU[2] + shp13[3]*sideU[3];
 7033:                Vector2 ud2 = shp24[0]*sideU[0] + shp24[1]*sideU[1] + shp24[2]*sideU[2] + shp24[3]*sideU[3];
 7034: 
 7035:                Vector2 ufg0 = clampVelocity(sideU[2] + sideU[3] - ud2);  // node 1: sides 3,4
 7036:                Vector2 ufg1 = clampVelocity(sideU[0] + sideU[3] - ud1);  // node 2: sides 1,4
 7037:                Vector2 ufg2 = clampVelocity(sideU[0] + sideU[1] - ud2);  // node 3: sides 1,2
 7038:                Vector2 ufg3 = clampVelocity(sideU[1] + sideU[2] - ud1);  // node 4: sides 2,3
 7039:                const Vector2 ufg[4] = {ufg0, ufg1, ufg2, ufg3};
 7040:                #pragma unroll
 7041:                for (int j = 0; j < 4; j++) {
 7042:                   Node *node = elem->nodes[j];
 7043:                   if (node->isDry) continue;
 7044: 
 7045:                   if (k == kb) atomicAdd(&(node->tmp.i), 1);
 7046:                   atomicAdd(&(node->utmp[k].x), ufg[j].x);
 7047:                   atomicAdd(&(node->utmp[k].y), ufg[j].y);
 7048:                }
 7049:             }
 7050: 
 7051:          }
 7052: 
 7053:       }
 7054:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 7055:       
 7056:    }
 7057: 
 7058: 
 7059:    __global__ void computeNodalHorizontalVelocities2(void) {
 7060:       NODE(node);
 7061: 
 7062:       const int nodeCount = node->tmp.i;
 7063: 
 7064:       if (nodeCount == 0) 
 7065:       {
 7066:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 7067:          return;
 7068:       }
 7069: 
 7070:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 7071:       
 7072:       const int kb = node->kb;
 7073: 
 7074:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 7075:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 7076:       
 7077:       
 7078:    }   
 7079: 
 7080:  
