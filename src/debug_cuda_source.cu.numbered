 1046:    __device__ __forceinline__ Vector2 grad2(double *a) const
 1047:    {
 1048:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
 1049:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
 1050:       if (isQuad()) {
 1051:          gx += a[3]*gradPhi[3].x;
 1052:          gy += a[3]*gradPhi[3].y;
 1053:       }
 1054:       return {gx, gy};
 1055:    }
 1056: 
 1057:    __device__ __forceinline__ Vector2 grad2(double Node::* field) const
 1058:    {
 1059:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
 1060:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
 1061:       if (isQuad()) {
 1062:          gx += (nodes[3]->*field)*gradPhi[3].x;
 1063:          gy += (nodes[3]->*field)*gradPhi[3].y;
 1064:       }
 1065:       return {gx, gy};
 1066:    }
