 1455:    // Vertical coordinate system
 1456:    // Sigma levels
 1457:    double h_s; 
 1458:    double h_c; 
 1459: 
 1460:    double theta_b;
 1461:    double theta_f, sinh_theta_f;
 1462:    double *sigma;  // There is a sigma_local on each node for the case ivcor=1
 1463:    double *ztot;
 1464:    double *cs;
 1465:    double *dcs;
 1466: 
 1467:    // // Get's the pointer to the node using the array of global pointers to nodes
 1468:    // __device__ const Node *getGlobalNode(int jn) {
