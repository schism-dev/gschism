 1907: 
 1908: __inline__ __device__ void Element::getSidesContainingNode(const Node *node, int &idx1, int &idx2) const {
 1909: // Finds the indices of the two sides that share the node in the element. Assumes that the node is part of the element.
 1910: 
 1911:    idx1 = -1;
 1912:    idx2 = -1;
 1913:    
 1914:    // Check all sides systematically
 1915:    if (sides[0]->n1 == node || sides[0]->n2 == node) {
 1916:       idx1 = 0;
 1917:    }
 1918: 
 1919:    if (sides[1]->n1 == node || sides[1]->n2 == node) {
 1920:       if (idx1 == -1) idx1 = 1;
 1921:       else { idx2 = 1; return; }
 1922:    }
 1923: 
 1924:    if (sides[2]->n1 == node || sides[2]->n2 == node) {
 1925:       if (idx1 == -1) idx1 = 2;
 1926:       else { idx2 = 2; return; }
 1927:    }
 1928: 
 1929:    if (isQuad() && (sides[3]->n1 == node || sides[3]->n2 == node)) {
 1930:       idx2 = 3;
 1931:    }
 1932:    
 1933:    assert(idx1 >= 0 && idx2 >= 0 && "Element should have exactly two sides containing the node");
 1934: }
 1935: 
 1936: 
 1937: __inline__ __device__ bool Element::containsSegment(const Node *node, const Point2 &xt) const {
 1938: // If we call x0 = node->p, this function returns true if the segment x0xt is contained in the element (in the sense that the wedge formed by the node and its
 1939: // adjacent sides (in the element) include the segment x0xt). 
 1940: // This is in a 'closed' sense, meaning that it covers the cases where x0xt is actually along one of these sides.
 1941: 
 1942:    // Find the two sides containing the node
 1943:    int idxSide1, idxSide2;
 1944:    getSidesContainingNode(node, idxSide1, idxSide2);
 1945: 
 1946:    const Vector2 x0 = node->p;
 1947:     
 1948:    // Obtain the normal vector to the two sides containing the node in the direction inward the element
 1949:    // ssign is positive when side->n points outward, so -ssign gives inward direction
 1950:    const Vector2 n1 = -ssign[idxSide1] * sides[idxSide1]->n;
 1951:    const Vector2 n2 = -ssign[idxSide2] * sides[idxSide2]->n;
 1952: 
 1953:    const Vector2 seg = (xt - x0);
 1954:    return (dot(n1, seg) >= -geometricEpsilon && dot(n2, seg) >= -geometricEpsilon);
 1955: 
 1956: }
