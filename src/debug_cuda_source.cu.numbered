 2260: 
 2261: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2262: 
 2263:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2264:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2265:    const Node *n1 = side->n1;
 2266:    const Node *n2 = side->n2;
 2267: 
 2268:    bool n1_match = (n1->nodeBnd->segment == segment);
 2269:    bool n2_match = (n2->nodeBnd->segment == segment);
 2270: 
 2271:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2272:    if (n1_match && n2_match) {
 2273:       return 0.5;
 2274:    } else if (n1_match) {
 2275:       return 1.0;
 2276:    } else if (n2_match) {
 2277:       return 0.0;
 2278:    }
 2279:    return 0.0;
 2280: }
 2281: 
 2282: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2283: 
 2284: 
 2285: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2286: 
 2287:    const double w1 = getBoundaryArrayValueWeight();
 2288:    const double w2 = 1.0 - w1;
 2289:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2290:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2291: 
 2292:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2293: }
 2294: 
 2295: 
 2296: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2297:    const double w1 = getBoundaryArrayValueWeight();
 2298:    const double w2 = 1.0 - w1;
 2299:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2300:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2301: 
 2302:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2303: }
