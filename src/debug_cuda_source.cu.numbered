 7996:          break;
 7997:       // case (int)VarCode::depth:
 7998:       //    *offset = (int)((char*)&sides[0].depth - (char*)sides);
 7999:       //    *sizeType = sizeof(double);
 8000:       //    break;         
 8001:       case (int)VarCode::x:
 8002:          *offset = (int)((char*)&sides[0].center.x - (char*)sides);
 8003:          *sizeType = sizeof(Vector2);
 8004:          break;
 8005:       case (int)VarCode::len:
 8006:          *offset = (int)((char*)&sides[0].len - (char*)sides);
 8007:          *sizeType = sizeof(double);
 8008:          break;
 8009:       case (int)VarCode::kb:
 8010:          *offset = (int)((char*)&sides[0].kb - (char*)sides);
 8011:          *sizeType = sizeof(int);
 8012:          break;
 8013:       case (int)VarCode::isdry:
 8014:          *offset = (int)((char*)&sides[0].isDry - (char*)sides);
 8015:          *sizeType = sizeof(int);
 8016:          break;            
 8017:       case (int)VarCode::w:
 8018:          *offset = (int)((char*)&sides[0].w2 - (char*)sides);
 8019:          *sizeType = sizeof(double);
 8020:          break;
 8021:       case (int)VarCode::u:
 8022:          *offset = (int)((char*)&sides[0].u2[0].x - (char*)sides);
 8023:          *sizeType = sizeof(Vector2);
 8024:          break;   
 8025:       case (int)VarCode::n1:
 8026:          *offset = (int)((char*)&sides[0].n1 - (char*)sides);
 8027:          *sizeType = sizeof(Node);
 8028:          break;
 8029:       case (int)VarCode::n2:
 8030:          *offset = (int)((char*)&sides[0].n2 - (char*)sides);
 8031:          *sizeType = sizeof(Node);
 8032:          break;                   
 8033:       default:
 8034:          *offset = -1;
 8035:    }
 8036: }
