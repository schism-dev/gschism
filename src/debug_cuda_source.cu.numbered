 2729: 
 2730: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2731: 
 2732: 
 2733: __device__ void Node::updateKb(void) {
 2734: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2735: 
 2736:    if constexpr(ivcor == 1) return;
 2737: 
 2738: 
 2739:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 2740: 
 2741:    if constexpr(ivcor == 2) {  // SZ coordinates
 2742:       
 2743:       // Compute bottom level index
 2744:       if (depth <= mesh->h_s) {
 2745:          kb = izlev;   
 2746:          
 2747:       } else {
 2748:          kb = -1;
 2749:          int L = 0;
 2750:          int R = nzlev; 
 2751:          
 2752:          while (L <= R) {
 2753:             int M = (R + L) / 2;
 2754: 
 2755: 
 2756:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2757:             
 2758:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2759:                R = M;
 2760:             } else {
 2761:                L = M;
 2762:             }
 2763: 
 2764:             if (R - L == 1) {
 2765:                kb = L;
 2766:                break;
 2767:             }
 2768:          }
 2769: 
 2770:          // Checks that the binary search was successful
 2771:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 2772:        
 2773:       }
 2774:    } 
 2775: }
 2776: 
 2777: 
 2778: __device__ __inline__ void Node::updateZCoordData(void) {
 2779: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2780: 
 2781:    // assert(!isDry2() && "updateZCoordData: node is dry");
 2782:    // if (isDry2()) {
 2783:    //    kb = -1;  // XXXXXXXX KKKKK
 2784:    //    return;
 2785:    // }
 2786: 
 2787: 
 2788:    if constexpr(ivcor == 2) {  // SZ coordinates
 2789:       
 2790:       // Compute bottom level index
 2791:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 2792:    } 
 2793:    else if (ivcor == 1) {  // Localized sigma
 2794:       // Do nothing
 2795:    }
 2796: 
 2797: 
 2798: }
