 3729:    __global__ void solverCopyResult(double* x) {
 3730:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 3731:       NODE(node);
 3732:       const int idx = node->idx;
 3733: 
 3734:       node->mX = x[idx];
 3735:    }
