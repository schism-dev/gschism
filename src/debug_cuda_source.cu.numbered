 7742: 
 7743: __global__ void computeMatrixProductAndDotProducts() {
 7744:    // Computes A*p, r'Mr and p'Ap
 7745: 
 7746:    // 1) shared buffer: first half for rMr, second for pAp
 7747:    __shared__ double sdata[2*BLOCK_SIZE];
 7748:    double* s_rMr = sdata;
 7749:    double* s_pAp = sdata + BLOCK_SIZE;
 7750: 
 7751:    const int tid = threadIdx.x;
 7752: 
 7753:    double l_pAp = 0.0;
 7754: 
 7755:    s_rMr[tid] = 0.0;
 7756:    s_pAp[tid] = 0.0;
 7757: 
 7758:    // 2) get your node pointer
 7759:    // NODE(node);   
 7760:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7761:    Node *node = &(mesh->localNodeData[idx_node]); 
 7762:       if (idx_node < mesh->np) {
 7763: 
 7764:       const double diag = node->coeffDiag;
 7765:       const double r    = node->mR;
 7766:       const double p    = node->mP;  
 7767: 
 7768:       // apply preconditioner on the fly:
 7769:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7770: 
 7771:       // 4) compute Ap = A.p
 7772:       double Ap = node->coeffDiag * node->mP;
 7773:       for (int j = 0; j < node->numNodes; ++j) {
 7774:          const Node *nbNode = node->nodes[j];
 7775:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7776: 
 7777:       }
 7778: 
 7779:       node->mAp = Ap;
 7780:       
 7781: 
 7782:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7783:       // const double l_rMr = r*Mr;  // r'Mr
 7784:       l_pAp = p*Ap;  // p'Ap
 7785: 
 7786: 
 7787:    }
 7788: 
 7789:    // 6) write into shared mem
 7790:    // s_rMr[tid] = l_rMr;
 7791:    s_pAp[tid] = l_pAp;
 7792: 
 7793:    __syncthreads();
 7794: 
 7795:    // 7) block-wide tree reduction
 7796:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7797:       if (tid < stride)  {
 7798:          s_pAp[tid] += s_pAp[tid + stride];
 7799:       }
 7800:       __syncthreads();
 7801:    }
 7802: 
 7803:    // 8) thread 0 atomically accumulates into the globals
 7804:    // XXX: This is slower than it needs to be, but it is simple and works
 7805:    if (tid == 0) {
 7806:       atomicAdd(pAp, s_pAp[0]);
 7807:    }
 7808: 
 7809: 
 7810: }
 7811: 
 7812: 
 7813: __global__ void updateSolutionAndDotProducts(void) {
 7814:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7815: 
 7816:    const int tid = threadIdx.x;
 7817: 
 7818:    s_rMr[tid] = 0.0;
 7819: 
 7820:    // get node & bounds-check:
 7821:    NODE(node);
 7822: 
 7823:    
 7824:    // Compute alpha
 7825:    const double alpha = (*rMr_old)/(*pAp); 
 7826: 
 7827: 
 7828:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7829: 
 7830: 
 7831:    // load scalars
 7832:    const double diag = node->coeffDiag;
 7833:    const double p    = node->mP;
 7834:    const double Ap   = node->mAp;
 7835:    const double x    = node->mX;
 7836:    const double r    = node->mR;
 7837:    
 7838:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7839: 
 7840:    // 1) update solution & residual
 7841:    const double x_new = x + alpha*p;
 7842:    const double r_new = r - alpha*Ap;
 7843:    node->mX = x_new;
 7844:    node->mR = r_new;
 7845: 
 7846:    // 2) apply Jacobi preconditioner on the fly
 7847:    const double Mr_new = r_new/diag;
 7848: 
 7849: 
 7850:    // 3) local contributions for the two dot-products
 7851:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7852: 
 7853:    // 4) write into shared-mem
 7854:    s_rMr[tid] = l_rMr;
 7855: 
 7856:    __syncthreads();
 7857: 
 7858: 
 7859:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7860:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7861:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7862:       __syncthreads();
 7863:    }
 7864: 
 7865:    // 6) thread 0 atomically folds into the global accumulators
 7866:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7867: 
 7868: 
 7869: }
 7870: 
 7871: 
 7872: __global__ void updateSearchDirection() {
 7873: 
 7874:     NODE(node);
 7875: 
 7876:     // recompute z on-the-fly
 7877:     const double z = node->mR / node->coeffDiag;
 7878:     const double p = node->mP;
 7879: 
 7880:     const double beta = (*rMr_new)/(*rMr_old);
 7881: 
 7882: 
 7883:     // p =z + beta*p
 7884:     node->mP = z + beta*p;
 7885: 
 7886: }
 7887: 
 7888: __global__ void initializeScalars(double *scalars) {
 7889: 
 7890:    // These point to a cupy array in the host code
 7891:    rMr_old = scalars + 0;
 7892:    rMr_new = scalars + 1;
 7893:    pAp     = scalars + 2;
 7894: }
 7895: 
 7896: __global__ void initializePreconditionedResidual(void) {
 7897: 
 7898:     __shared__ double s_rMr[BLOCK_SIZE];  
 7899: 
 7900:     s_rMr[threadIdx.x] = 0.0;
 7901: 
 7902:     NODE_ALL(node, valid);
 7903:     const int tid = threadIdx.x;
 7904:     // For the first iteration:
 7905:     // 1. Initial solution x = 0 (already set)
 7906:     // 2. Initial residual r = b (stored in qel)
 7907:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7908: 
 7909: // XXX we should use the guess solution here    
 7910: 
 7911:     double l_rMr = 0.0;
 7912:     if (valid) {
 7913:       // Set initial residual r = b (from qel)
 7914:       node->mR = node->qel;
 7915: 
 7916:       // Compute z = M^-1 * r (preconditioned residual)
 7917:       const double z = node->mR / node->coeffDiag;
 7918: 
 7919:       // Set initial search direction p = z
 7920:       node->mP = z;
 7921: 
 7922:       // Initialize other variables needed for CG
 7923:       node->mX = 0.0;  // Initial solution
 7924:       node->mAp = 0.0; // Will be computed in first iteration
 7925: 
 7926: 
 7927:       // Computes the first r'Mr (reduction)
 7928:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7929:     }
 7930:     // 4) write into shared-mem
 7931:     s_rMr[tid] = l_rMr;
 7932: 
 7933:     __syncthreads();
 7934: 
 7935: 
 7936:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7937:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7938:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7939:         __syncthreads();
 7940:     }
 7941: 
 7942:     // 6) thread 0 atomically folds into the global accumulators
 7943:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7944: 
 7945:     *rMr_old = 0.0;
 7946:     *pAp = 0.0;
 7947: }
