 2159: /**
 2160:  * This method performs backtracking from the side center until a time -dt back in time 
 2161:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2162:  * intermediate point.
 2163:  *
 2164:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2165:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2166:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2167:  * remaining time.
 2168:  * 
 2169:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2170:  * 
 2171:  * @param uuint, vvint, wwint: Velocities at the final point
 2172:  * @param jlev: Level at which the backtracking is performed
 2173:  * @param dt, dtbk: Tracking timesteps
 2174:  * @return: True if the backtracking was successful, false otherwise
 2175:  */
 2176: __inline__ __device__ bool Side::btrack(
 2177:       int jlev,
 2178:       double dt,            // Tracking time
 2179:       double dtbk,          // Tracking timestep
 2180:       Vector3 &u_int
 2181: ) const {
 2182: 
 2183:    // Start from side center
 2184:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2185:  
 2186: 
 2187:    double time_rm = dt; // Remaining time
 2188: 
 2189: 
 2190:    // // Initialize outputs XXX
 2191:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2192:    //    sclr[i] = 0.0;
 2193:    // }
 2194: 
 2195: 
 2196:    // Initial velocities
 2197:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 2198: 
 2199: // printf("YY 1, u_int = %f,%f\n", u_int.x, u_int.y);
 2200: 
 2201:    // Find the element that is in the direction opposite to the velocity
 2202:    Element* curElem = findElementTowards({u_int.x, u_int.y});
 2203: // printf("YY 2, curElem = %p\n", curElem);
 2204:    const int MAX_ITERATIONS = 1000; 
 2205:    Element* nextElem = curElem;
 2206:    int iter = 0;
 2207:    while(true) {
 2208:       // Calculate timestep
 2209:       double dtb = min(dtbk, time_rm);
 2210: 
 2211:       // Next point in the backtracking curve
 2212:       Point3 xt = x0 - dtb*u_int;
 2213: // printf("YY 3, dtb = %f, curElem = %p, u_int = %f,%f,%f\n", dtb, curElem, u_int.x, u_int.y, u_int.z);
 2214:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb);
 2215: // printf("YY 4, found = %d\n", found);
 2216:       assert(found && "Backtracking failed in btrack");
 2217: // printf("<>T = %f, %f %f %f\n", time_rm - dtb, xt, yt, zt);
 2218:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2219:                       // then time_rm needs to be increased by the unused time.
 2220:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2221: 
 2222:       // The current point becomes the next segment's starting point.
 2223:       x0 = xt;
 2224:  
 2225:       curElem = nextElem;
 2226: 
 2227:       iter++;
 2228:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2229:    }
 2230: 
 2231: 
 2232: }
 2233: 
