 2377: 
 2378: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2379: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2380: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2381: // Only when ics == 2, the origin is at the element center.
 2382: 
 2383:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2384: 
 2385:    const Node *node = nodes[idxNode];
 2386: 
 2387:    if constexpr(ics==1) {
 2388:       return node->p;
 2389: 
 2390:    } else {
 2391:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2392: 
 2393:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2394: 
 2395:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2396:    }
 2397: 
 2398: }
 2399: 
 2400: 
 2401: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, 
 2402:                                                                             const Vector3& c, const Frame<ics>& dstFrame, int idx) const {
 2403: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2404: 
 2405:    const int id1 = idx;
 2406:    const int id2 = nxq(1 + id1);
 2407:    const int id3 = nxq(2 + id1);
 2408: 
 2409:    if constexpr(ics==1) {
 2410:       x0 = nodes[id1]->p;
 2411:       x1 = nodes[id2]->p;
 2412:       x2 = nodes[id3]->p;
 2413: 
 2414:    } else {
 2415: 
 2416:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2417:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2418:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2419: 
 2420:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2421:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2422:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2423: 
 2424:    }
 2425: 
 2426: }
 2427: 
 2428: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2429:    getLocalHorizontalNodePositionsTri(x0, x1, x2, {center.x, center.y, centerZ()}, frame, idx);
 2430: }
 2431: 
 2432: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2433:             Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3,
 2434:             const Vector3& c, const Frame<ics>& dstFrame) const {
 2435: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2436: 
 2437:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2438: 
 2439: 
 2440: 
 2441:    if constexpr(ics==1) {
 2442:       x0 = nodes[0]->p;
 2443:       x1 = nodes[1]->p;
 2444:       x2 = nodes[2]->p;  
 2445:       x3 = nodes[3]->p;
 2446: 
 2447:    } else {
 2448: 
 2449:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2450:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2451:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2452:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2453: 
 2454:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2455:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2456:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2457:       x3 = toVector2(dstFrame.G2L(p3 - c));
 2458:    }
 2459: 
 2460: }
 2461: 
 2462: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2463:    Point2& x0, Point2& x1, Point2& x2, Point2& x3) const
 2464: {
 2465:    getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, {center.x, center.y, centerZ()}, frame);
 2466: }
 2467: 
 2468: 
 2469: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2470: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2471: // Returns the normal vector and the area of the element at this level
 2472:    
 2473:    double nx, ny, nz;
 2474: 
 2475:    if (isTri()) {
 2476:       // For triangles...
 2477: 
 2478:       // Indices of the nodes at level k, taking care of not going below the bed
 2479:       const int k0 = max(k, nodes[0]->kb);
 2480:       const int k1 = max(k, nodes[1]->kb);
 2481:       const int k2 = max(k, nodes[2]->kb);
 2482: 
 2483:       // Gets the element frame coordinates of the nodes at level k
 2484:       Point3 x0, x1, x2;
 2485:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2486:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2487:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2488:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2489: 
 2490:       } else {  // ics == 2
 2491:          Point2 h0, h1, h2;
 2492: 
 2493:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2494: 
 2495:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2496:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2497:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2498:       }
 2499: 
 2500:       const Vector3 n20 = x2 - x0;
 2501:       const Vector3 n10 = x1 - x0; 
 2502: 
 2503:       // Computes the cross product of vectors n20 and n10. 
 2504:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2505:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2506:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2507: 
 2508:   
 2509:    }
 2510:    else {
 2511:       // For quads...
 2512:       Point2 h0, h1, h2, h3;
 2513: 
 2514:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2515: 
 2516:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2517:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2518:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k] - nodes[0]->z[k]);
 2519:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k] - nodes[1]->z[k]);
 2520: 
 2521:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2522:       nx = n20.y*n31.z - n20.z*n31.y;
 2523:       ny = n20.z*n31.x - n20.x*n31.z;
 2524:       nz = n20.x*n31.y - n20.y*n31.x;
 2525: 
 2526:    }
 2527: 
 2528:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2529:    area3D = 0.5*len;
 2530: 
 2531:    const double inv_len = 1.0/len;
 2532: 
 2533:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2534: 
 2535: }
 2536: 
 2537: 
 2538: // Helper functions to get the 2D local node position for the Celestial walk
 2539: __device__ __forceinline__ Point2 Element::getLocalNodePosition(int idx, const Side* origSide) const {
 2540:    const int idx2 = (isTri() && idx == 3) ? 2 : idx;
 2541:    const Node *node = getNodeInOrder(idx2);
 2542: 
 2543:    double z = 0.0;
 2544:    if constexpr(ics == 2) z = node->gz;
 2545:    
 2546:    Point3 p = toPoint3(node->p, z);
 2547: 
 2548:    return toPoint2(origSide->toLocalFrame(p));
 2549: }
 2550: 
 2551: __device__ __forceinline__ Node *Element::getNodeInOrder(int idx) const {
 2552:    return (ssign[idx] > 0) ? sides[idx]->n1 : sides[idx]->n2;
 2553: }
 2554: 
 2555: __device__ __forceinline__ void Element::computePredicates(const Point2 x0, const Point2& xt, double &fac, const Side* origSide,
 2556:                                 Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector, int jlev) const
 2557: // Computes the three per-side predicates needed for the celestial walk
 2558: // (Kuijper, Ermolaev, Devillers, JCGT 7(3), 2018, arXiv:1710.01620).
 2559: //
 2560: // xt is in local frame coordinates for origSide if ics == 2.
 2561: //
 2562: // All work is done unconditionally on 4 sides to keep CUDA threads uniform.
 2563: // For triangles, side 3 is a sentinel: getNode(3) returns getNode(2), making
 2564: // corners[3] == corners[2] and s3 == (0, 0). Predicates that would be
 2565: // meaningless on triangles are masked to a safe value (see comments below).
 2566: {
 2567:    // Project all 4 corner positions once into the local 2D frame.
 2568:    // For triangles, C[3] == C[2] (no garbage, but geometrically degenerate).
 2569:    // getLocalNodePosition only transforms/projects if ics == 2.
 2570:    const Point2 C[4] = {getLocalNodePosition(0, origSide), 
 2571:                         getLocalNodePosition(1, origSide), 
 2572:                         getLocalNodePosition(2, origSide), 
 2573:                         getLocalNodePosition(3, origSide)};
 2574: 
 2575:    // Computes the maximum distance from the starting point to the farthest element node projected on the segment x0xt.
 2576:    // This has nothing to do with the original celestial walk. It is used in the Leaded Celestial 
 2577:    //Walk algorithm to find a point on the segment x0xt that is as close as possible to the starting point,
 2578:    // But still farther towards the target point from the current point.
 2579:    const Vector2 vt0 = xt - x0;
 2580:    double maxProjDist = max(dot(vt0, C[0] - x0), dot(vt0, C[1] - x0));
 2581:    maxProjDist = max(maxProjDist, dot(vt0, C[2] - x0)); 
 2582:    maxProjDist = isQuad() ? max(maxProjDist, dot(vt0, C[3] - x0)) : maxProjDist;
 2583: 
 2584:    fac = max(1.00001*fac, min(1.0, (maxProjDist/dot(vt0, vt0))*1.00001));
 2585:    const Vector2 ixt = x0 + (xt - x0)*fac;
 2586: 
 2587: 
 2588: // if (origSide->idx == 2860848 && jlev == 46) {
 2589: // showPoints(toPoint3(x0,0.0), toPoint3(xt,0.0), jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2590: // showPoints(toPoint3(ixt,0.0), toPoint3(ixt,0.0), jlev, origSide, 0x00FF00u, 'o', 1, 0, 0);
 2591: // printf("this->idx = %d, origSide->idx = %d, ixt = (%.17f, %.17f), x0 = (%.17f, %.17f), xt = (%.17f, %.17f), fac = %.17f\n", this->idx, origSide->idx, ixt.x, ixt.y, x0.x, x0.y, xt.x, xt.y, fac);
 2592: // }
 2593:    // Side I goes from corners[I] to corners[nxq(I+1)] in CCW perimeter order.
 2594:    // (Note: with corners built from getNode in CCW order, no ssign factor is needed
 2595:    //  here the orientation is baked into the corners array.)
 2596:    const int i3 = nxq(3);
 2597:    const Vector2 s0 = C[ 1] - C[ 0];
 2598:    const Vector2 s1 = C[ 2] - C[ 1];
 2599:    const Vector2 s2 = C[i3] - C[ 2];
 2600:    const Vector2 s3 = C[ 0] - C[i3];
 2601:    
 2602:    // Side I goes from C[I] to C[nxq(I+1)] in CCW perimeter order.
 2603:    // The corners array is built from getNode in CCW order, so the orientation
 2604:    // is already correct and no ssign factor is needed in the formulas below.
 2605:    //
 2606:    // i3 = nxq(3): the index of the corner after side 2.
 2607:    //   Triangle: i3 == 0 (the closing corner of the triangle).
 2608:    //   Quad:     i3 == 3.
 2609:    //
 2610:    // The four side direction vectors. For triangles, s3 == (0, 0) since
 2611:    // C[i3] == C[0] (the perimeter has already closed by side 2).
 2612:    isLeft.set(0,  cross(s0, ixt - C[ 0]) > -small);
 2613:    isLeft.set(1,  cross(s1, ixt - C[ 1]) > -small);
 2614:    isLeft.set(2,  cross(s2, ixt - C[ 2]) > -small);
 2615:    isLeft.set(3, (cross(s3, ixt - C[i3]) > -small) || isTri());  
 2616: 
 2617: // printf("idx = %d, cross(s0, xt - C[ 0] ) = %.17f, cross(s1, xt - C[ 1] ) = %.17f, cross(s2, xt - C[ 2] ) = %.17f, cross(s3, xt - C[i3] ) = %.17f\n", idx, cross(s0, xt - C[ 0] ), cross(s1, xt - C[ 1] ), cross(s2, xt - C[ 2] ), cross(s3, xt - C[i3] ));
 2618: 
 2619:    // For triangles, the corner after side 2 is the closing corner where
 2620:    // side 2 meets side 0 (not side 3, which doesn't exist). The "next side
 2621:    // tangent" used by isObtuse and isBisector at that corner is therefore
 2622:    // s0 for triangles, s3 for quads.
 2623:    const Vector2 s3_tri = isTri() ? s0 : s3;
 2624: 
 2625:    // isObtuse.b[I]: true iff the internal face angle at the corner after
 2626:    // side I is obtuse. Equivalent to dot of consecutive side directions > 0
 2627:    // (acute "turn angle" along the perimeter = obtuse internal angle).
 2628:    //
 2629:    // isObtuse.b[3] for triangles: dot(s3, s0) = dot(0, s0) = 0, so the
 2630:    // result is false naturally. No sentinel needed.
 2631:    isObtuse.set(0, dot(s0, s1) > 0.0);
 2632:    isObtuse.set(1, dot(s1, s2) > 0.0);
 2633:    isObtuse.set(2, dot(s2, s3_tri) > 0.0);  // triangle: closes back to s0
 2634:    isObtuse.set(3, dot(s3, s0) > 0.0);  // Always false for triangles (s3=(0,0))
 2635: 
 2636:    // isBisector.b[I]: at the corner after side I, this tests whether xt is
 2637:    // on the "exit through side I" half of the corner cone, separated by the
 2638:    // approximate angular bisector of the celestial walk. The bisector is
 2639:    // perpendicular to the chord across the corner; the test is the sign of
 2640:    // (xt - corner_vertex) projected onto that chord.
 2641:    //
 2642:    // isBisector.b[3] is always masked out by isLeft.b[3] = true for triangles
 2643:    // (the validity rule sets valid_3 = false), so its computed value for
 2644:    // triangles doesn't matter. No sentinel needed.
 2645:    isBisector.set(0, dot(ixt - C[ 1], s0 + s1) < 0.0);
 2646:    isBisector.set(1, dot(ixt - C[ 2], s1 + s2) < 0.0);
 2647:    isBisector.set(2, dot(ixt - C[i3], s2 + s3_tri) < 0.0);
 2648:    isBisector.set(3, dot(ixt - C[ 0], s3 + s0) < 0.0);   
 2649: 
 2650: }
 2651: 
 2652: 
 2653: __inline__ __device__ double Element::computeSignedArea(void) const {
 2654:    // Compute the area of the element
 2655: 
 2656:    Point2 x0, x1, x2, x3;
 2657:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2658: 
 2659: 
 2660:    double res = signedArea(x0, x1, x2);
 2661: 
 2662:    // In the quad case we need to add the area of the other triangle.
 2663:    if (isQuad()) {
 2664:       x3 = getLocalHorizontalNodePosition(3);
 2665:       double ar1 = signedArea(x0, x2, x3);
 2666:       double ar2 = signedArea(x0, x1, x3);
 2667:       double ar3 = signedArea(x1, x2, x3);
 2668:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2669: 
 2670:       res += ar1;
 2671: 
 2672:    }
 2673: 
 2674:    return res;
 2675: }
 2676: 
 2677: 
 2678: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2679:                                                                 (nodes[1]->isDry2()) ||
 2680:                                                                 (nodes[2]->isDry2()) ||
 2681:                                                                 (isQuad() && nodes[3]->isDry2());
 2682: }
 2683: 
 2684: __inline__ __device__ double Element::detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2685:    return (1.0/8.0)*((x1.x - x0.x)*(x2.y - x3.y) - (x2.x - x3.x)*(x1.y - x0.y));
 2686: }
 2687: 
 2688: __inline__ __device__ double Element::detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2689:    return (1.0/8.0)*((x2.x - x1.x)*(x3.y - x0.y) - (x3.x - x0.x)*(x2.y - x1.y));
 2690: }
 2691: 
 2692: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2693:    // In boundary sides, the element 1 is nullptr
 2694:    return side->elems[1] == nullptr; 
 2695: }
 2696: 
 2697: __forceinline__ __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const {
 2698:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 2699:    // For ics == 2, this function uses local frame coordinates.
 2700: 
 2701:    assert(isQuad());
 2702: 
 2703:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 2704:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 2705:    // where vxi, veta, vb are vectors and c is the center of the element.
 2706: 
 2707:    Point2 p0, p1, p2, p3;
 2708: 
 2709:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 2710: 
 2711:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 2712:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 2713:    // vectors vxi and veta connect the centers of opposite sides
 2714:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 2715:    // vb is zero for parallelogram elements.
 2716:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 2717: 
 2718:    //  The bilinear mapping is:
 2719:    //      P(s,t) = C + s*U + t*V + s*t*W
 2720:    //
 2721:    //  where:
 2722:    //    C = centroid (average of four vertices)
 2723:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 2724:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 2725:    //    W = bilinear correction; measures deviation from parallelogram
 2726:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 2727:    //        W = 0 for parallelogram elements.
 2728:    //
 2729:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 2730:    //
 2731:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 2732:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 2733:    //
 2734:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 2735:    //
 2736:    //  Geometrically, (L) projects everything onto the direction
 2737:    //  perpendicular to W, where the mapping is purely affine.
 2738:    //
 2739:    //  The dot product with nb retains the nonlinear term:
 2740:    //
 2741:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 2742:    //
 2743:    //  Geometrically, (Q) projects onto the W direction, where
 2744:    //  the nonlinearity lives.
 2745:    //
 2746:    //  We solve (L) for whichever variable has the larger coefficient
 2747:    //  (better conditioned back-substitution), substitute into (Q),
 2748:    //  and get a scalar quadratic in the other variable.
 2749:    // ================================================================
 2750: 
 2751:    // ---- Basis vectors ----
 2752:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 2753:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 2754:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 2755:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 2756:    // W: nonlinear correction. Difference between quad and parallelogram.
 2757:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 2758:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 2759: 
 2760:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 2761:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 2762:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 2763:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 2764:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 2765: 
 2766:    // ---- nb: direction parallel to W, L1-normalized ----
 2767:    // We don't need a unit vector -- just a well-scaled direction parallel
 2768:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 2769:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 2770:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 2771:    //
 2772:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 2773:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 2774:    // and the quadratic solver takes its linear path (a ~ 0).
 2775:    const double wlen1 = fabs(vb.x) + fabs(vb.y) + 1e-30;
 2776:    const double inv_wlen = 1.0 / wlen1;
 2777:    const Vector2 nb = vb * inv_wlen;
 2778: 
 2779:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 2780:    // cross(nb, .) projects onto the direction PERPENDICULAR to W.
 2781:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 2782:    // What remains is a pure affine relationship between xi and eta.
 2783:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 2784:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 2785:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 2786: 
 2787:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 2788:    // dot(nb, .) projects onto the W direction, where the nonlinearity lives.
 2789:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 2790:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 2791:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 2792:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 2793:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 2794: 
 2795:    // ---- Solve: pick the better-conditioned variable from (L) ----
 2796:    // Back-substitute from (L) dividing by the LARGER coefficient,
 2797:    // minimizing round-off amplification.
 2798:    //
 2799:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 2800:    // that uses predicated moves.
 2801:    //
 2802:    // if (fabs(Ls) > fabs(Lt)) {
 2803:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 2804:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 2805:    //    // Substitute into (Q), multiply by Ls, group by eta:
 2806:    //    const double A = -Qw * Lt;
 2807:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 2808:    //    const double C =  Qs * Lp - Qp * Ls;
 2809: 
 2810:    //    double eta1, eta2;
 2811:    //    solveQuadratic(A, B, C, eta1, eta2);
 2812: 
 2813:    //    // Pick root with smaller |eta| (domain centered at 0).
 2814:    //    // Ternary-> predicated move, no branch divergence.
 2815:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 2816: 
 2817:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 2818:    //    xi = (Lp - Lt * eta) / Ls;
 2819: 
 2820:    // } else {
 2821:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 2822:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 2823:    //    // Substitute into (Q), multiply by Lt, group by xi:
 2824:    //    const double A = -Qw * Ls;
 2825:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 2826:    //    const double C =  Qt * Lp - Qp * Lt;
 2827: 
 2828:    //    double xi1, xi2;
 2829:    //    solveQuadratic(A, B, C, xi1, xi2);
 2830: 
 2831:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 2832: 
 2833:    //    eta = (Lp - Ls * xi) / Lt;
 2834:    // }
 2835:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 2836:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 2837:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 2838:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 2839:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 2840: 
 2841:    // Quadratic:  A*r^2 + B*r + C = 0
 2842:    // (same formula for both cases, just with swapped coefficients)
 2843:    const double A = -Qw * Lb;
 2844:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 2845:    const double C =  Qa * Lp - Qp * La;
 2846: 
 2847:    double r1, r2;
 2848:    solveQuadratic(A, B, C, r1, r2);
 2849: 
 2850:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 2851:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 2852: 
 2853:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 2854:    const double other = (Lp - Lb * r) / La;
 2855: 
 2856:    // Assign to (xi, eta) depending on which variable the quadratic solved
 2857:    xi  = solve_s ? r     : other;
 2858:    eta = solve_s ? other : r;
 2859: 
 2860: 
 2861:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 2862:    xi  = clamp(xi,  -1.0, 1.0);
 2863:    eta = clamp(eta, -1.0, 1.0);
 2864: 
 2865:    // ---- Shape functions ----
 2866:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 2867:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 2868:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 2869:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 2870:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 2871:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 2872:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 2873:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 2874: 
 2875:    return true;
 2876: }
 2877: 
 2878: /**
 2879:    Compute the shape coordinates of the point (xt,yt) in the element.
 2880:    @param xt (input): x-coordinate of the point
 2881:    @param shpCoords (output): shape coordinates of the point
 2882:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2883:    @return true if the point is inside the element, false otherwise
 2884: **/
 2885: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 2886: 
 2887:    // Compute the shape coordinates of the point xt in the element.
 2888:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 2889:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 2890:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 2891:    // from the local frame, so use additional check.
 2892: 
 2893: 
 2894:    Point3 origSideCenter = toPoint3(origSide->center, origSide->centerZ());
 2895: 
 2896:    if (isTri()) { // Triangular element
 2897: 
 2898:       // Horizontal local node coordinates. 
 2899:       Point2 x0, x1, x2;
 2900:       getLocalHorizontalNodePositionsTri(x0, x1, x2, origSideCenter, origSide->frame);
 2901: 
 2902:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2903:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2904:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2905:       shpCoords[3] = 0.0;
 2906: 
 2907:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2908:       const bool res = (tmpmin >= -small);  
 2909:       
 2910:       // When to fix the negative shape coordinates?
 2911:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2912: 
 2913:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2914:       // then we fix the negative shape coordinates.
 2915:       if ((tmpmin < 0) && fix) {
 2916: 
 2917:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2918:          // keeping the sum of the shape coordinates equal to 1.
 2919:          // I have tested and compared the new algorithm with the old one, and they give
 2920:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2921:          // The new algorithm should be faster since it is branchless.
 2922:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 2923:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2924: 
 2925:          shpCoords[0] = (shpCoords[0] + a)*b;
 2926:          shpCoords[1] = (shpCoords[1] + a)*b;
 2927:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2928: 
 2929:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2930:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 2931:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 2932: 
 2933:          // Update the point coordinates for the new shape coordinates
 2934:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2935:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2936: 
 2937:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2938: 
 2939:       }
 2940: 
 2941:       // Return true if the point is inside the element
 2942:       return res;      
 2943:    }
 2944:    else {
 2945:       assert(isQuad() && "computeShapeCoords");
 2946: 
 2947:       // Horizontal local node coordinates with respect to the original side.
 2948:       Point2 x0, x1, x2, x3;
 2949:       getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, origSideCenter, origSide->frame);
 2950: 
 2951:       const double a0 = signedArea(x0, x1, xt);
 2952:       const double a1 = signedArea(x1, x2, xt);
 2953:       const double a2 = signedArea(x2, x3, xt);
 2954:       const double a3 = signedArea(x3, x0, xt);
 2955: 
 2956:       const double minArea = min4(a0, a1, a2, a3);
 2957:       
 2958:       const bool res = (minArea > -small*area);
 2959: 
 2960:       // When to fix the negative shape coordinates?
 2961:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2962: 
 2963:       double xi, eta;    
 2964: 
 2965:       // Converts the point xt to the element frame coordinates and then to bilinear+shape coordinates.
 2966:       // Does nothing if ics == 1.
 2967:       assert(origSide != nullptr);
 2968:       Point2 xt_elem = toPoint2(toLocalFrame(origSide->toGlobal(toPoint3(xt, 0.0))));
 2969: 
 2970:       inverseBilinearQuad(xt_elem, xi, eta, shpCoords);
 2971: 
 2972:       if (fix) {
 2973:          double xn[4] = {x0.x, x1.x, x2.x, x3.x};
 2974:          double yn[4] = {x0.y, x1.y, x2.y, x3.y};
 2975:          xt.x = interpolate(shpCoords, xn);
 2976:          xt.y = interpolate(shpCoords, yn);
 2977:       }
 2978: 
 2979:       return res;
 2980:    }
 2981: 
 2982: 
 2983:    assert(false && "computeShapeCoords: should never reach this point");
 2984:    return false;  // Never reached
 2985: 
 2986: }
 2987: 
 2988: 
 2989: __device__ __forceinline__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2990: // Convert shape coordinates to cartesian coordinates
 2991: 
 2992:    if (isTri()) {
 2993:       // Triangular element
 2994: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 2995:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2996:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2997:    }
 2998:    else {
 2999:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 3000:    }
 3001: 
 3002: }
 3003: 
 3004: 
 3005: 
 3006: __device__ __forceinline__ double Element::intPhiPhiTri(int i, int j) const {
 3007:    // return \int \phi_i*\phi_j dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3008:    
 3009:    return ((i == j) ? (2.0/12.0) : (1.0/12.0))*area;
 3010: }
 3011: 
 3012: __device__ __forceinline__ double Element::intGradPhiGradPhiTri(int i, int j) const {
 3013:    // return \int (grad phi_i).(grad phi_j) dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3014:    // gradPhi[i] is constant over a linear triangle, so the integral is area * dot(gradPhi[i], gradPhi[j]).
 3015:    assert(isTri() && i >= 0 && j >= 0 && i < 3 && j < 3);
 3016:    return area * dot(gradPhi[i], gradPhi[j]);
 3017: }
 3018: 
 3019: __device__ __forceinline__ double Element::intPhiPhiQuad(int i, int j, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3020:    // return \int \phi_i*\phi_j dA for quads, where phi_i and phi_j are the shape functions of the nodes i and j.
 3021:    // The integral can be computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 3022:    // The formula for the integral is:
 3023:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 3024:    
 3025:    const double xi_term  = 1.0 + (xi_n(i) * xi_n(j))/3.0;
 3026:    const double eta_term = 1.0 + (eta_n(i)*eta_n(j))/3.0;
 3027:    const double eta_sum  = eta_n(i) + eta_n(j);
 3028:    const double xi_sum   = xi_n(i)  + xi_n(j);
 3029: 
 3030:    const double detJ_xi  = detJ_xi_quad (x0, x1, x2, x3);  // XXXXX put the 8 inside the function??? xi derivative of the Jacobian determinant
 3031:    const double detJ_eta = detJ_eta_quad(x0, x1, x2, x3);  // eta derivative of the Jacobian determinant
 3032: 
 3033: 
 3034:    return (1.0/16.0)*area*xi_term*eta_term + (1.0/12.0)*(detJ_eta*xi_term*eta_sum + detJ_xi*eta_term*xi_sum);
 3035: }
 3036:    
 3037: 
 3038: __device__ __forceinline__ double Element::intGradPhiGradPhiQuad(int i1, int i2, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3039:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3040:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 3041:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 3042:    // The formula is also based on the identity:
 3043:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 3044:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 3045: 
 3046:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: bad ranges");
 3047: 
 3048: 
 3049: 
 3050:    double res = 0.0;
 3051:    
 3052:    // Quadrature points in xi and eta coordinates
 3053:    #pragma unroll
 3054:    for (int i = 0; i < 4; i++) {
 3055:       // For each quadrature point...
 3056: 
 3057:       const Point2 p = GaussPoint(i);  // Quadrature point in (eta,xi) coordinates
 3058:       const double eta = p.x;
 3059:       const double xi  = p.y;
 3060: 
 3061:       // Jacobian entries at the Gauss point p
 3062:       const double dx_dxi  = 0.25 * ( (x1.x + x2.x - x0.x - x3.x) + eta*(x0.x + x2.x - x1.x - x3.x) );
 3063:       const double dx_deta = 0.25 * ( (x2.x + x3.x - x0.x - x1.x) + xi *(x0.x + x2.x - x1.x - x3.x) );
 3064:       const double dy_dxi  = 0.25 * ( (x1.y + x2.y - x0.y - x3.y) + eta*(x0.y + x2.y - x1.y - x3.y) );
 3065:       const double dy_deta = 0.25 * ( (x2.y + x3.y - x0.y - x1.y) + xi *(x0.y + x2.y - x1.y - x3.y) );      
 3066: 
 3067:       const double detJ = detJ_quad(p, x0, x1, x2, x3);
 3068:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3069: 
 3070:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3071:       const double dPhi_dxi_1  = dPhi_dxi_quad (i1, p);
 3072:       const double dPhi_deta_1 = dPhi_deta_quad(i1, p);
 3073:       const double dPhi_dxi_2  = dPhi_dxi_quad (i2, p);
 3074:       const double dPhi_deta_2 = dPhi_deta_quad(i2, p);
 3075: 
 3076:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3077:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3078:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3079:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3080:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3081: 
 3082:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3083:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3084:    }
 3085: 
 3086:    return res;
 3087: }
 3088: 
 3089: 
 3090: /**  Interpolate velocities at a given point (xt,yt,zt)
 3091: 
 3092:    @param xt, yt, zt: coordinates of the point to interpolate
 3093:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3094: 
 3095:    This is done in four steps:
 3096: 
 3097:    1. Find the shape coordinates for the final position in the element.
 3098:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3099:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3100:       z levels at xt, yt at each step.   
 3101:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3102:       horizontally and vertically.
 3103: **/
 3104: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3105:    // Interpolate the velocities at the point xt. 
 3106:    // This function works the same for triangular and quadrilateral elements.
 3107:    double shpCoord[4];
 3108:    Vector3 u_int;
 3109: 
 3110: 
 3111:    // First step is to compute the shape coordinates of (xt,yt)
 3112: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3113:    computeShapeCoords(toVector2(xt), shpCoord, fiAnywhere, origSide);
 3114: 
 3115:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 3116: 
 3117:    // Second step is to find the level that contains zt
 3118:    // Uses a binary search to find the level
 3119:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3120:    // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3121:    int L = kb - 1; // In some cases, the bottom level of the element is 1 more than the bottom level of the node XXXX (Check)
 3122:    int R = nvrt - 1;
 3123: 
 3124:    // Get the z coordinates at the nodes of the element at the levels L and R
 3125:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3126:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3127:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3128: 
 3129: 
 3130:    double zL = interpolate(shpCoord, zLAtNodes);
 3131:    double zR = interpolate(shpCoord, zRAtNodes);
 3132: 
 3133:    // Interpolates vertically the velocities
 3134:    double wght1, wght2;
 3135:    if (xt.z <= zL) {
 3136:       wght1 = 1.0;
 3137:       wght2 = 0.0;
 3138:       xt.z = zL;
 3139:    }
 3140:    else if (xt.z >= zR) {
 3141:       wght1 = 0.0;
 3142:       wght2 = 1.0;
 3143:       xt.z = zR;
 3144:    }
 3145:    else {
 3146:       // Perform a binary search to find the levels between L and R that contain xt.z
 3147:       while (R - L > 1) {
 3148:          int M = (L + R) / 2.0;
 3149: 
 3150:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3151:          double zM = interpolate(shpCoord, zMAtNodes);
 3152:          if (zM < xt.z) 
 3153:          {
 3154:             L = M;
 3155:             zL = zM;
 3156:          }
 3157:          else 
 3158:          {
 3159:             R = M;
 3160:             zR = zM;
 3161:          }
 3162:       }
 3163:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3164:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3165: 
 3166:       wght2 = (xt.z - zL)/(zR - zL);
 3167:       wght1 = 1.0 - wght2;
 3168: 
 3169:    }
 3170: // printf("XXYYX element %d, L = %d, R = %d, zL = %.17f, zR = %.17f, xt.z = %.17f, wght1 = %.17f, wght2 = %.17f\n", idx, L, R, zL, zR, xt.z, wght1, wght2);
 3171: // printf("HEREEEEEE 3, wght1 = %.17f, wght2 = %.17f, shpCoord = (%.17f, %.17f, %.17f, %.17f)\n", wght1, wght2, shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 3172:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3173:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3174:    Vector2 uv = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3175:    double w   = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3176: 
 3177:    // Project the velocity from the local frame to the origSide frame
 3178:    if constexpr(ics == 2) uv = frame.projHorVec(uv, origSide->frame);
 3179:    u_int = {uv.x, uv.y, w};
 3180: 
 3181:    // Neither of the interpolated velocities should be NaN
 3182:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3183: 
 3184:    return u_int;
 3185: 
 3186: }
 3187: 
 3188: 
 3189: 
 3190: 
 3191: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3192: 
 3193:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3194:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3195:    const Node *n1 = side->n1;
 3196:    const Node *n2 = side->n2;
 3197: 
 3198:    bool n1_match = (n1->nodeBnd->segment == segment);
 3199:    bool n2_match = (n2->nodeBnd->segment == segment);
 3200: 
 3201:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3202:    if (n1_match && n2_match) {
 3203:       return 0.5;
 3204:    } else if (n1_match) {
 3205:       return 1.0;
 3206:    } else if (n2_match) {
 3207:       return 0.0;
 3208:    }
 3209: 
 3210:    return 0.0;
 3211: }
 3212: 
 3213: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3214: 
 3215: 
 3216: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 3217: 
 3218:    const double w1 = getBoundaryArrayValueWeight();
 3219:    const double w2 = 1.0 - w1;
 3220:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3221:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3222: 
 3223:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 3224: }
 3225: 
 3226: 
 3227: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 3228:    const double w1 = getBoundaryArrayValueWeight();
 3229:    const double w2 = 1.0 - w1;
 3230:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3231:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3232: 
 3233:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 3234: 
 3235: }
 3236: 
 3237: 
 3238: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 3239:    // Returns the value of the velocity at the side center
 3240:    const double w1 = getBoundaryArrayValueWeight();
 3241:    const double w2 = 1.0 - w1;
 3242:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3243:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3244: 
 3245:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 3246: }
 3247: 
 3248: 
 3249: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 3250:    // Returns the value of the normal component of the velocity at the side center
 3251:    const double w1 = getBoundaryArrayValueWeight();
 3252:    const double w2 = 1.0 - w1;
 3253:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3254:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3255: 
 3256:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 3257: }
 3258: 
 3259: 
 3260: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3261:    if constexpr(ics == 1) {
 3262:       return center;
 3263: 
 3264:    } else {
 3265:       const Point2 p0 = n1->outputCoords();
 3266:       const Point2 p1 = n2->outputCoords();
 3267:       return (1.0/2.0)*(p0 + p1);
 3268: 
 3269:    }
 3270: }
 3271: 
 3272: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3273: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3274: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3275: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3276: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3277: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3278: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3279: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3280: // Computes the gradient of the field at the side center.
 3281:    Vector2 grad = {0.0, 0.0};
 3282:    int count = 0;
 3283: 
 3284:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3285:    // as the average of the gradients at each element.
 3286:    // First element
 3287:    if (elems[0] != nullptr && condition(elems[0])) {
 3288:       Vector2 elemGrad = elems[0]->grad2(field);
 3289: 
 3290:       // For ics=2, projects the element gradient from its frame to the side frame
 3291:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3292: 
 3293:       grad += elemGrad;
 3294: 
 3295:       count++;
 3296:    }
 3297: 
 3298:    // Second element
 3299:    if (elems[1] != nullptr && condition(elems[1])) {
 3300: 
 3301:       Vector2 elemGrad = elems[1]->grad2(field);
 3302: 
 3303:       // For ics=2, projects the element gradient from its frame to the side frame
 3304:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3305: 
 3306:       grad += elemGrad;
 3307: 
 3308:       count++;
 3309:    }
 3310: 
 3311:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3312:    if (count > 0) {
 3313:       grad = grad*(1.0/count);
 3314:    }
 3315:    
 3316:    return grad;
 3317: }
 3318: 
 3319: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 3320: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 3321: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 3322: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 3323: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 3324: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 3325: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 3326: 
 3327: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 3328: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 3329: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 3330: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 3331: 
 3332: 
 3333: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3334: 
 3335: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3336:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3337:    if constexpr(ics == 1) { 
 3338:       return 0.5*(n1->tau + n2->tau);
 3339: 
 3340:    } else {
 3341:       // Project the tau from the node frames to the side frame
 3342:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3343:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3344: 
 3345:       return 0.5*(stau1 + stau2);
 3346:    }
 3347: }
 3348: 
 3349: /**
 3350:  * This method performs backtracking from the side center until a time -dt back in time 
 3351:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3352:  * intermediate point.
 3353:  *
 3354:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3355:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3356:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3357:  * remaining time.
 3358:  * 
 3359:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3360:  * 
 3361:  * @param uuint, vvint, wwint: Velocities at the final point
 3362:  * @param jlev: Level at which the backtracking is performed
 3363:  * @param dt, dtbk: Tracking timesteps
 3364:   */
 3365: __inline__ __device__ void Side::btrack(
 3366:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3367:       double dt,            // Tracking time
 3368:       double dtbk,          // Tracking timestep
 3369:       Vector3 &u_int        // Velocities at the initial point
 3370: ) const {
 3371: 
 3372:    // Start from side center
 3373:    Point3 x0;
 3374: 
 3375:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3376:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3377: 
 3378:  
 3379:    double time_rm = dt; // Remaining time
 3380:    double time_rm_1 = 1e10;
 3381:    double time_rm_2 = 2e10;
 3382:    double time_rm_3 = 3e10;
 3383: 
 3384: 
 3385:    // Initial velocities
 3386:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3387: 
 3388:    // Find a non dry element for starting the backtracking. At this point there should be at least one.
 3389:    Element* curElem = (!elems[0]->isDry) ? elems[0] : elems[1];  // elems[0] is always non-null 
 3390: 
 3391:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3392: 
 3393: // showPoints(x0, x0, jlev, this, 0xFF0000u, 'x', 1, 0, 0);
 3394: 
 3395: 
 3396:    constexpr int MAX_ITERATIONS = 100; 
 3397:    int iter = 0;
 3398:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3399:    while(true) {
 3400: 
 3401:       // Calculate timestep
 3402:       const double dtb = min(dtbk, time_rm);
 3403: 
 3404:       // Next point in the backtracking curve
 3405:       xt = x0 - dtb*u_int;
 3406: 
 3407:       double t, s; // parameters for the line segments p0pt and p1p2
 3408:       Side *lastCrossSide = nullptr;
 3409:       const bool found = celestialWalk(curElem, x0, xt, this, lastCrossSide, jlev);
 3410: 
 3411: 
 3412:       if (time_rm_3 <= time_rm) {
 3413:       // If backtracking gets stuck, we stop the backtracking and use the velocity at the last x0.
 3414:          xt = x0;
 3415:          break;
 3416:       }
 3417: 
 3418: 
 3419:       if (!found) {
 3420:       // This means that the walk reached a boundary or a dry element.
 3421: 
 3422:          assert(lastCrossSide!=nullptr && "lastCrossSide is nullptr");
 3423: 
 3424:          // Finds the point at the boundary where the line segment x0xt intersects.
 3425:          // Here we will assume that it does intersect the boundary segment, even if in some cases,
 3426:          // due to floating point errors, it does not exactly intersect.
 3427:          // We call p1 and p2 the 2D points of the boundary segment. p0, pt are the 2D versions of x0 and xt.
 3428:          // v1 is the vector from p0 to pt, v2 is the vector from p1 to p2.
 3429:          // To compute the intersection point we start with the parametric equations.
 3430:          // p1 + t*v2 = p0 + s*v1,    t, s in [0,1]
 3431:          // We cross-prouct by v1 to cancel the s term:
 3432:          // cross(v2, v1)*t = cross(p0 - p1, v1)
 3433:          // t = cross(p0 - p1, v1) / cross(v2, v1)
 3434: 
 3435:          // Side coordinates in the origSide frame.
 3436:          const Point2 p1 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n1->p, lastCrossSide->n1->gz)));
 3437:          const Point2 p2 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n2->p, lastCrossSide->n2->gz)));
 3438: 
 3439:          Point2  p0 = {x0.x, x0.y};
 3440:          Point2  pt = {xt.x, xt.y};
 3441: 
 3442:          const Vector2 v1 = pt - p0;
 3443:          const Vector2 v2 = p2 - p1;
 3444: 
 3445: 
 3446: 
 3447:          // We are assuming intersection, so we clamp t to the range [0,1].
 3448:          const double denom = cross(v2, v1);
 3449:          
 3450: 
 3451: 
 3452: 
 3453:          if (abs(denom) < small) {
 3454:             // small denominators are fairly common. They occur when the line segment x0xt 
 3455:             // is parallel to the boundary segment. This occurs after a "collision" with the
 3456:             // boundary, where the backtracking curve startt sliding along the boundary.
 3457:             // In this case, we simply assume that the two lines are very close to each other
 3458:             // and simply compute the closest point to xt (s = 1.0) on the boundary segment (clamped to p1p2)
 3459:             t = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3460:             if (t<0.0000000001) t = 0.0;
 3461:             if (t>0.9999999999) t = 1.0;
 3462: 
 3463:             // s = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3464:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3465: 
 3466:          }
 3467:          else {
 3468:             
 3469:             t = clamp(cross(p0 - p1, v1) / denom, 0.0, 1.0);
 3470:             if (t<0.0000000001) t = 0.0; // XXXXX use constants
 3471:             if (t>0.9999999999) t = 1.0;
 3472:             // From the originaL equation we can solve for s:
 3473:             // p1 + t*v2 = p0 + s*v1    =>   s*v1 = p1 + t*v2 - p0 
 3474:             // Computing the dot product by v1, we get:
 3475:             // s = dot((p1 + t*v2 - p0), v1) / dot(v1, v1)
 3476:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3477:             if (s<0.0000000001) s = 0.0; // XXXXX use constants
 3478: 
 3479:          }
 3480: 
 3481:          assert(curElem!=nullptr && !curElem->isDry && "curElem is nullptr or dry");
 3482: 
 3483: 
 3484:          // We update the new target point to be right at the intersection point,
 3485:          // and the remaining time must include the time we haven't "used".
 3486:          time_rm -= s*dtb;
 3487:          xt = toPoint3(p1 + t*v2, x0.z + s*(xt.z - x0.z)); // I use p1,p2 to compute the intersection point to ensure that it is on the boundary, but the z-coordinate is the same as x0.z
 3488: 
 3489: 
 3490:          // If it is an open boundary, just exits the loop. No sliding along the boundary is performed.
 3491:          if (lastCrossSide->sideBnd!=nullptr && !lastCrossSide->sideBnd->segment->isLand) break;
 3492: 
 3493:          // If it is not an open boundary, the velocity for the next step is computed by interpolating the velocities at the intersection point.
 3494:          // but extracting only the component along the tangent vector v2.
 3495:          Vector2 tangent = normalize(v2);
 3496:          const Vector3 u = curElem->interpolateVelocities(xt, this);
 3497: 
 3498:          const Vector2 u2D = make_double2(u.x, u.y);
 3499:          u_int = toVector3(dot(u2D, tangent)*tangent, u.z);
 3500: 
 3501: 
 3502:       } else {
 3503: 
 3504:          assert(curElem!=nullptr && !curElem->isDry && "Final element is dry or boundary side");
 3505: 
 3506:          time_rm -= dtb; 
 3507: 
 3508:          u_int = curElem->interpolateVelocities(xt, this);
 3509: 
 3510:       }
 3511: 
 3512:       if (time_rm <= 0.0) break; 
 3513: 
 3514:       // If the velocity is too small, we stop the backtracking
 3515:       const double vmag2 = norm2(toVector2(u_int));
 3516:       if (vmag2 <= velmin_btrack_sq)  {
 3517:          time_rm = 0.0; 
 3518:          return; 
 3519:       }
 3520: 
 3521:       // The current point becomes the next segment's starting point.
 3522:       x0 = xt;
 3523:  
 3524:       iter++;
 3525: 
 3526: // XXXXXXXXXXXXXXXXX
 3527: if (iter == 38) {printf("*****iter = %d, time_rm = %.17f\n", iter, time_rm); return;}
 3528:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3529: 
 3530:       assert(time_rm_3 > time_rm && "time_rm is not decreasing");
 3531:       time_rm_3 = time_rm_2;
 3532:       time_rm_2 = time_rm_1;
 3533:       time_rm_1 = time_rm;
 3534:    }
 3535: 
 3536:    assert(curElem != nullptr && "Final element is nullptr");
 3537:    assert(!curElem->isDry && "Final element is dry");
 3538:    
 3539: 
 3540: 
 3541:    // Interpolate the velocities at the final point with respect to the current side frame
 3542:    u_int = curElem->interpolateVelocities(xt, this);
 3543: 
 3544: 
 3545: }
 3546: 
 3547: 
 3548: 
 3549: 
 3550: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3551: 
 3552: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3553: 
 3554:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3555:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3556: 
 3557:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3558:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3559: 
 3560:    double fun_lat = 0.0;
 3561:    switch (jspc[idxComp]) {
 3562:       case 0:
 3563:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3564:          break;
 3565:       case 1:
 3566:          fun_lat = sin(2.0*lat);
 3567:          break;
 3568:       case 2:
 3569:          fun_lat = pow<2>(cos(lat));
 3570:          break;
 3571:       default:
 3572:          assert(false && "computeETP: invalid jspc");
 3573:    }
 3574:    
 3575:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3576: 
 3577: }
 3578: 
 3579: 
 3580: __device__ void Node::updateKb(void) {
 3581: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3582: 
 3583:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3584: 
 3585: 
 3586:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3587: 
 3588:    if constexpr(ivcor == 2) {  // SZ coordinates
 3589:       
 3590:       // Compute bottom level index
 3591:       if (depth <= mesh->h_s) {
 3592:          kb = izlev;   
 3593:          
 3594:       } else {
 3595:          kb = -1;
 3596:          int L = 0;
 3597:          int R = nzlev; 
 3598:          
 3599:          while (L <= R) {
 3600:             int M = (R + L) / 2;
 3601: 
 3602: 
 3603:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3604:             
 3605:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3606:                R = M;
 3607:             } else {
 3608:                L = M;
 3609:             }
 3610: 
 3611:             if (R - L == 1) {
 3612:                kb = L;
 3613:                break;
 3614:             }
 3615:          }
 3616: 
 3617:          // Checks that the binary search was successful
 3618:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3619:        
 3620:       }
 3621:    } 
 3622: }
 3623: 
