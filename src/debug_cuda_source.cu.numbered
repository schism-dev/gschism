 3257: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3258:    if constexpr(ics == 1) {
 3259:       return center;
 3260: 
 3261:    } else {
 3262:       const Point2 p0 = n1->outputCoords();
 3263:       const Point2 p1 = n2->outputCoords();
 3264:       return (1.0/2.0)*(p0 + p1);
 3265: 
 3266:    }
 3267: }
 3268: 
 3269: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3270: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3271: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3272: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3273: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3274: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3275: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3276: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3277: // Computes the gradient of the field at the side center.
 3278:    Vector2 grad = {0.0, 0.0};
 3279:    int count = 0;
 3280: 
 3281:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3282:    // as the average of the gradients at each element.
 3283:    // First element
 3284:    if (elems[0] != nullptr && condition(elems[0])) {
 3285:       Vector2 elemGrad = elems[0]->grad2(field);
 3286: 
 3287:       // For ics=2, projects the element gradient from its frame to the side frame
 3288:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3289: 
 3290:       grad += elemGrad;
 3291: 
 3292:       count++;
 3293:    }
 3294: 
 3295:    // Second element
 3296:    if (elems[1] != nullptr && condition(elems[1])) {
 3297: 
 3298:       Vector2 elemGrad = elems[1]->grad2(field);
 3299: 
 3300:       // For ics=2, projects the element gradient from its frame to the side frame
 3301:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3302: 
 3303:       grad += elemGrad;
 3304: 
 3305:       count++;
 3306:    }
 3307: 
 3308:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3309:    if (count > 0) {
 3310:       grad = grad*(1.0/count);
 3311:    }
 3312:    
 3313:    return grad;
 3314: }
 3315: 
 3316: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 3317: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 3318: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 3319: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 3320: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 3321: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 3322: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 3323: 
 3324: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 3325: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 3326: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 3327: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 3328: 
 3329: 
 3330: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3331: 
 3332: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3333:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3334:    if constexpr(ics == 1) { 
 3335:       return 0.5*(n1->tau + n2->tau);
 3336: 
 3337:    } else {
 3338:       // Project the tau from the node frames to the side frame
 3339:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3340:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3341: 
 3342:       return 0.5*(stau1 + stau2);
 3343:    }
 3344: }
 3345: 
 3346: /**
 3347:  * This method performs backtracking from the side center until a time -dt back in time 
 3348:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3349:  * intermediate point.
 3350:  *
 3351:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3352:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3353:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3354:  * remaining time.
 3355:  * 
 3356:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3357:  * 
 3358:  * @param uuint, vvint, wwint: Velocities at the final point
 3359:  * @param jlev: Level at which the backtracking is performed
 3360:  * @param dt, dtbk: Tracking timesteps
 3361:   */
 3362: __inline__ __device__ void Side::btrack(
 3363:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3364:       double dt,            // Tracking time
 3365:       double dtbk,          // Tracking timestep
 3366:       Vector3 &u_int        // Velocities at the initial point
 3367: ) const {
 3368: 
 3369:    // Start from side center
 3370:    Point3 x0;
 3371: 
 3372:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3373:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3374: 
 3375:  
 3376:    double time_rm = dt; // Remaining time
 3377:    double time_rm_1 = 1e10;
 3378:    double time_rm_2 = 2e10;
 3379:    double time_rm_3 = 3e10;
 3380: 
 3381: 
 3382:    // Initial velocities
 3383:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3384: 
 3385:    // Find a non dry element for starting the backtracking. At this point there should be at least one.
 3386:    Element* curElem = (!elems[0]->isDry) ? elems[0] : elems[1];  // elems[0] is always non-null 
 3387: 
 3388:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3389: 
 3390: // showPoints(x0, x0, jlev, this, 0xFF0000u, 'x', 1, 0, 0);
 3391: 
 3392: 
 3393:    constexpr int MAX_ITERATIONS = 100; 
 3394:    int iter = 0;
 3395:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3396:    while(true) {
 3397: 
 3398:       // Calculate timestep
 3399:       const double dtb = min(dtbk, time_rm);
 3400: 
 3401: // if (iter >= 38) printf("AAAAA iter = %d, curElem->idx = %d, x0 = (%.17f, %.17f, %.17f), time_rm = %.17f, dtb = %.17f, dtbk = %.17f, u_int = (%.17f, %.17f, %.17f)\n", iter, curElem->idx, x0.x, x0.y, x0.z, time_rm, dtb, dtbk, u_int.x, u_int.y, u_int.z);
 3402: 
 3403:       // Next point in the backtracking curve
 3404:       xt = x0 - dtb*u_int;
 3405: // if (jlev == 48 && idx == 1603507)   showPoints(x0, xt, jlev, this, 0xFFFF00u, 'x', 1, 0, 0);
 3406: // // showPoints(x0, xt, jlev, this, 0xFF00FFu, 'o', 1, 15, iter);
 3407: // // if ((jlev==45)) printf("jlev = %d, iter = %d, x0 = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f)\n", jlev, iter, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z);
 3408: // if ((jlev==45))
 3409: // {
 3410: // // const Point3 p1 = toLocalFrame(x0);
 3411: // // const Point3 p2 = toLocalFrame(xt);
 3412: // // printf("jlev = %d, iter = %d, p1 = (%.17f, %.17f, %.17f), p2 = (%.17f, %.17f, %.17f)\n", jlev, iter, p1.x, p1.y, p1.z, p2.x, p2.y, p2.z);
 3413: // showPoints(x0, xt, jlev, this, 0x0000FFu, 'o', 1, 0, 0); 
 3414:     
 3415: // }
 3416: 
 3417:       double t, s; // parameters for the line segments p0pt and p1p2
 3418:       Side *lastCrossSide = nullptr;
 3419:       const bool found = celestialWalk(curElem, x0, xt, this, lastCrossSide, jlev);
 3420: 
 3421: 
 3422: // if (iter >= 38) printf("BBBBB idx = %d, jlev = %d, lastCrossSide->idx = %d, x0 = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f), iter = %d, curElem->idx = %d, time_rm = %.17f, dtb = %.17f, dtbk = %.17f, u_int = (%.17f, %.17f, %.17f)\n", idx, jlev, lastCrossSide->idx, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z, iter, curElem->idx, time_rm, dtb, dtbk, u_int.x, u_int.y, u_int.z);
 3423: 
 3424:       if (time_rm_3 <= time_rm) {
 3425:       // If backtracking gets stuck, we stop the backtracking and use the velocity at the last x0.
 3426:          xt = x0;
 3427:          break;
 3428:       }
 3429: 
 3430: 
 3431:       if (!found) {
 3432:       // This means that the walk reached a boundary or a dry element.
 3433: 
 3434:          assert(lastCrossSide!=nullptr && "lastCrossSide is nullptr");
 3435: 
 3436:          // Finds the point at the boundary where the line segment x0xt intersects.
 3437:          // Here we will assume that it does intersect the boundary segment, even if in some cases,
 3438:          // due to floating point errors, it does not exactly intersect.
 3439:          // We call p1 and p2 the 2D points of the boundary segment. p0, pt are the 2D versions of x0 and xt.
 3440:          // v1 is the vector from p0 to pt, v2 is the vector from p1 to p2.
 3441:          // To compute the intersection point we start with the parametric equations.
 3442:          // p1 + t*v2 = p0 + s*v1,    t, s in [0,1]
 3443:          // We cross-prouct by v1 to cancel the s term:
 3444:          // cross(v2, v1)*t = cross(p0 - p1, v1)
 3445:          // t = cross(p0 - p1, v1) / cross(v2, v1)
 3446: 
 3447:          // Side coordinates in the origSide frame.
 3448:          const Point2 p1 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n1->p, lastCrossSide->n1->gz)));
 3449:          const Point2 p2 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n2->p, lastCrossSide->n2->gz)));
 3450: 
 3451:          Point2  p0 = {x0.x, x0.y};
 3452:          Point2  pt = {xt.x, xt.y};
 3453: 
 3454:          const Vector2 v1 = pt - p0;
 3455:          const Vector2 v2 = p2 - p1;
 3456: 
 3457: 
 3458: 
 3459:          // We are assuming intersection, so we clamp t to the range [0,1].
 3460:          const double denom = cross(v2, v1);
 3461:          
 3462: 
 3463: 
 3464: 
 3465:          if (abs(denom) < small) {
 3466:             // small denominators are fairly common. They occur when the line segment x0xt 
 3467:             // is parallel to the boundary segment. This occurs after a "collision" with the
 3468:             // boundary, where the backtracking curve startt sliding along the boundary.
 3469:             // In this case, we simply assume that the two lines are very close to each other
 3470:             // and simply compute the closest point to xt (s = 1.0) on the boundary segment (clamped to p1p2)
 3471:             t = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3472:             if (t<0.0000000001) t = 0.0;
 3473:             if (t>0.9999999999) t = 1.0;
 3474: 
 3475:             // s = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3476:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3477: 
 3478:          }
 3479:          else {
 3480:             
 3481:             t = clamp(cross(p0 - p1, v1) / denom, 0.0, 1.0);
 3482:             if (t<0.0000000001) t = 0.0; // XXXXX use constants
 3483:             if (t>0.9999999999) t = 1.0;
 3484:             // From the originaL equation we can solve for s:
 3485:             // p1 + t*v2 = p0 + s*v1    =>   s*v1 = p1 + t*v2 - p0 
 3486:             // Computing the dot product by v1, we get:
 3487:             // s = dot((p1 + t*v2 - p0), v1) / dot(v1, v1)
 3488:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3489:             if (s<0.0000000001) s = 0.0; // XXXXX use constants
 3490: 
 3491:          }
 3492: 
 3493:          
 3494:          // else printf("AAAAAAA idx = %d, jlev = %d, t = %.17f, denom = %.17f\n", idx, jlev, t, denom);
 3495:          assert(curElem!=nullptr && !curElem->isDry && "curElem is nullptr or dry");
 3496: 
 3497: 
 3498: 
 3499:          // We update the new target point to be right at the intersection point,
 3500:          // and the remaining time must include the time we haven't "used".
 3501:          time_rm -= s*dtb;
 3502:          xt = toPoint3(p1 + t*v2, x0.z + s*(xt.z - x0.z)); // I use p1,p2 to compute the intersection point to ensure that it is on the boundary, but the z-coordinate is the same as x0.z
 3503: 
 3504: // Point3 xct = {curElem->center.x, curElem->center.y, curElem->centerZ()};
 3505: // xct = toLocalFrame(xct);
 3506: // xt = (1-0.00001)*xt + 0.00001*xct;
 3507:          // If it is an open boundary, just exits the loop. No sliding along the boundary is performed.
 3508:          if (lastCrossSide->sideBnd!=nullptr && !lastCrossSide->sideBnd->segment->isLand) break;
 3509: 
 3510:          // If it is not an open boundary, the velocity for the next step is computed by interpolating the velocities at the intersection point.
 3511:          // but extracting only the component along the tangent vector v2.
 3512:          Vector2 tangent = normalize(v2);
 3513:          const Vector3 u = curElem->interpolateVelocities(xt, this);
 3514: 
 3515:          const Vector2 u2D = make_double2(u.x, u.y);
 3516:          u_int = toVector3(dot(u2D, tangent)*tangent, u.z);
 3517: 
 3518: 
 3519:       } else {
 3520: 
 3521:          assert(curElem!=nullptr && !curElem->isDry && "Final element is dry or boundary side");
 3522: 
 3523:          time_rm -= dtb; 
 3524: 
 3525:          u_int = curElem->interpolateVelocities(xt, this);
 3526: 
 3527:       }
 3528: 
 3529:       if (time_rm <= 0.0) break; 
 3530: 
 3531:       // If the velocity is too small, we stop the backtracking
 3532:       const double vmag2 = norm2(toVector2(u_int));
 3533:       if (vmag2 <= velmin_btrack_sq)  {
 3534: 
 3535:          time_rm = 0.0; 
 3536:          return; 
 3537:       }
 3538: 
 3539:       // The current point becomes the next segment's starting point.
 3540:       x0 = xt;
 3541:  
 3542:       iter++;
 3543: 
 3544: 
 3545:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3546: 
 3547:       assert(time_rm_3 > time_rm && "time_rm is not decreasing");
 3548:       time_rm_3 = time_rm_2;
 3549:       time_rm_2 = time_rm_1;
 3550:       time_rm_1 = time_rm;
 3551:    }
 3552: 
 3553:    assert(curElem != nullptr && "Final element is nullptr");
 3554:    assert(!curElem->isDry && "Final element is dry");
 3555:    
 3556: 
 3557: 
 3558:    // Interpolate the velocities at the final point with respect to the current side frame
 3559:    u_int = curElem->interpolateVelocities(xt, this);
 3560: 
 3561: 
 3562: }
 3563: 
 3564: 
 3565: 
 3566: 
 3567: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3568: 
 3569: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3570: 
 3571:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3572:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3573: 
 3574: 
 3575: 
 3576:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3577:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3578: 
 3579:    double fun_lat = 0.0;
 3580:    switch (jspc[idxComp]) {
 3581:       case 0:
 3582:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3583:          break;
 3584:       case 1:
 3585:          fun_lat = sin(2.0*lat);
 3586:          break;
 3587:       case 2:
 3588:          fun_lat = pow<2>(cos(lat));
 3589:          break;
 3590:       default:
 3591:          assert(false && "computeETP: invalid jspc");
 3592:    }
 3593:    
 3594:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3595: 
 3596: }
 3597: 
 3598: 
 3599: __device__ void Node::updateKb(void) {
 3600: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3601: 
 3602:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3603: 
 3604: 
 3605:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3606: 
 3607:    if constexpr(ivcor == 2) {  // SZ coordinates
 3608:       
 3609:       // Compute bottom level index
 3610:       if (depth <= mesh->h_s) {
 3611:          kb = izlev;   
 3612:          
 3613:       } else {
 3614:          kb = -1;
 3615:          int L = 0;
 3616:          int R = nzlev; 
 3617:          
 3618:          while (L <= R) {
 3619:             int M = (R + L) / 2;
 3620: 
 3621: 
 3622:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3623:             
 3624:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3625:                R = M;
 3626:             } else {
 3627:                L = M;
 3628:             }
 3629: 
 3630:             if (R - L == 1) {
 3631:                kb = L;
 3632:                break;
 3633:             }
 3634:          }
 3635: 
 3636:          // Checks that the binary search was successful
 3637:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3638:        
 3639:       }
 3640:    } 
 3641: }
 3642: 
