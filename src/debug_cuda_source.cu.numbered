 2201:    template<typename T>
 2202:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 2203:       T values[4];
 2204:       getNodalValues(level, func, values);
 2205: 
 2206:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2207:       if constexpr (IsVector2<T>::value && ics == 2) {
 2208: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2209:          projectNodeVectorsToElementFrame(values);
 2210: printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2211:       }
 2212: 
 2213:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2214:    }
 2215: 
 2216:    template<typename T>
 2217:    __device__ __forceinline__ T Element::interpolate(const double shapeCoords[4], T Node::* field) const {
 2218:       T values[4];
 2219:       getNodalValues(field, values);
 2220: 
 2221:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2222:       if constexpr (IsVector2<T>::value && ics == 2) {
 2223: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2224:          projectNodeVectorsToElementFrame(values);
 2225: printf("interpolate 3: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2226:       }
 2227:       
 2228:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2229:    }
 2230: 
 2231: 
 2232:    template<typename T>
 2233:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
 2234:       T values[4];
 2235:       getNodalValues(level, field, values);
 2236:       
 2237: if (shapeCoords[0] > 1.1 || shapeCoords[1] > 1.1 || shapeCoords[2] > 1.1 || 
 2238:     shapeCoords[0] < -0.1 || shapeCoords[1] < -0.1 || shapeCoords[2] < -0.1) printf("XXX shapeCoords = (%.17f, %.17f, %.17f, %.17f)\n", shapeCoords[0], shapeCoords[1], shapeCoords[2], shapeCoords[3]);
 2239:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2240:       if constexpr (IsVector2<T>::value && ics == 2) {
 2241: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2242:          projectNodeVectorsToElementFrame(values);
 2243: // printf("interpolate 4: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2244:       }
 2245: 
 2246:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2247:    }
