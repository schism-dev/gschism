 1882:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 1883:                            if (idx_node_bnd >= mesh->nbp) return;
 1884: 
 1885: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1886:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 1887:                            if (idx_side_bnd >= mesh->nbs) return;                           
