 1514:                    double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 1515:                    int *isdel, int *isidenode, int *isbnd,
 1516:                    int *nond, int *nlnd, int *iond, int *ilnd,
 1517:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 1518:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
