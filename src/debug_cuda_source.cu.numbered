 2025: 
 2026: __inline__ __device__ Point2 Element::outputCoords(void) const {
 2027:    if constexpr(ics == 1)  {
 2028:       return center;
 2029: 
 2030:    } else {
 2031:       const Point2 p0 = nodes[0]->outputCoords();
 2032:       const Point2 p1 = nodes[1]->outputCoords();
 2033:       const Point2 p2 = nodes[2]->outputCoords();
 2034: 
 2035:       if (isTri()) {
 2036:          return (1.0/3.0)*(p0 + p1 + p2);
 2037: 
 2038:       } else {
 2039:          const Point2 p3 = nodes[3]->outputCoords();
 2040:          return (1.0/4.0)*(p0 + p1 + p2 + p3);
 2041:       }
 2042: 
 2043:    }
 2044: }
 2045: 
 2046: __device__ __forceinline__ double Element::centerZ(void) const { 
 2047: // Z coordinate of the element center in the global cartesian coordinates.
 2048: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 2049: 
 2050:    if constexpr(ics==1) { 
 2051:       return 0.0; 
 2052: 
 2053:    } else { 
 2054: 
 2055:       if (isTri())  return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz);
 2056:       else          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz);
 2057:    } 
 2058: }
