 1876:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1877:       // Compute the different time ramps used in the code 
 1878:       // This function is performed by just one thread
 1879: 
 1880:       rampbc = 1.0;
 1881:       if constexpr(ibc == 0) {
 1882:          if (drampbc > 0.0) {
 1883:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1884:          } else {
 1885:             rampbc = 1.0;
 1886:          }
 1887:       }
 1888: 
 1889:       if (nws != 0) {
 1890:          if (drampwind > 0.0) {
 1891:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1892:          } else {
 1893:             rampwind = 1.0;
 1894:          }
 1895:       }
 1896: 
 1897:       if (drampwafo > 0.0) {
 1898:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1899:       } else {
 1900:          rampwafo = 1.0;
 1901:       }
 1902: 
 1903:       // For source/sinks
 1904:       if (if_source && dramp_ss > 0.0) {
 1905:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1906:       } else {
 1907:          ramp_ss = 1.0;
 1908:       }
 1909: 
 1910:       if (dramp > 0.0) {
 1911:          ramp = tanh(2.0*time/86400.0/dramp);
 1912:       } else {
 1913:          ramp = 1.0;
 1914:       }
 1915: 
 1916: 
 1917:    }
