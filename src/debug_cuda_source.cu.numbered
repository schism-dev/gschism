 5721: 
 5722:    __global__ void solverCopyResult(double* x) {
 5723:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 5724:       NODE(node);
 5725:       const int idx = node->idx;
 5726: 
 5727:       node->mX = x[idx];
 5728:    }
 5729: 
 5730: 
 5731:    __global__ void rollUpElevation(void) {
 5732: 
 5733:       NODE(node);
 5734: 
 5735:       node->eta1 = node->eta2;
 5736: 
 5737:    }
 5738: 
 5739: 
 5740:    __global__ void backtrackAllNodes(void) {
 5741: 
 5742:       // max/min # of sub-divisions
 5743:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 5744:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 5745: 
 5746:       SIDE(side);
 5747: 
 5748:       const int kb = side->kb;
 5749: 
 5750: 
 5751:       // Initialize btrack velocities to the actual velocities at the side 
 5752:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 5753:   
 5754:       if (side->isDry) return;
 5755:      
 5756: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 5757: 
 5758:       // Checks that at least one element is not dry
 5759:       const Element *elem1 = side->elems[0];
 5760:       const Element *elem2 = side->elems[1];
 5761: 
 5762: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 5763: 
 5764:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 5765:       
 5766:       // XXXXXX
 5767:       // !swild_tmp to store global coord. of the starting side
 5768:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 5769:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 5770:       // !Use sframe2 
 5771:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 5772: 
 5773: 
 5774:       for (int k = kb; k < nvrt; k++) {
 5775:       //  For ics=2, the coordinates are all in the side's local frame
 5776: 
 5777:          const int iadvf = side->iadv();  // Advection flag   
 5778:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 5779: 
 5780:          const double vmag2 = norm2(side->u2[k]);
 5781: 
 5782:          if (vmag2 <= velmin_btrack_sq) {  
 5783:             // No activity 
 5784: 
 5785:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 5786:             
 5787:          } else {  // do btrack
 5788: 
 5789:             // Compute number of sub-divisions based on local gradients of the velocity field
 5790: 
 5791:             // XXX IS THIS NECESSARY?
 5792:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 5793:             double suma = 0.0;
 5794:             int icount = 0;
 5795:             #pragma unroll
 5796:             for (int l=0; l<2; l++) {
 5797:             // For each element sharing the side...
 5798: 
 5799:                const Element *elem = side->elems[l];
 5800:                  
 5801:                if (elem == nullptr) continue;
 5802: 
 5803:                icount++;
 5804: 
 5805:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 5806:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 5807:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 5808: 
 5809:                double utmp[4];
 5810:                double vtmp[4];
 5811:                #pragma unroll
 5812:                for (int j = 0; j < elem->i34; j++) {
 5813: 
 5814:                   const Node *node = elem->nodes[j];
 5815: 
 5816:                   if constexpr(ics==1) {
 5817:                      utmp[j] = node->u2[k].x;
 5818:                      vtmp[j] = node->u2[k].y;  
 5819: 
 5820:                   } else {
 5821:                      // 'Project' the velocity from the node frame to the element frame
 5822:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 5823:                      utmp[j] = tmp_u2.x;
 5824:                      vtmp[j] = tmp_u2.y;
 5825: 
 5826:                   }
 5827:                } // for j
 5828: 
 5829:                const Vector2 grad_u = elem->grad2(utmp); 
 5830:                const Vector2 grad_v = elem->grad2(vtmp);
 5831:    
 5832:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 5833:             } // for l
 5834: 
 5835:             assert(icount > 0 && "Impossible 77");
 5836: 
 5837:             // '4' is somewhat arbitrary
 5838:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 5839: 
 5840:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 5841:             Vector3 u_int = {0.0, 0.0, 0.0};
 5842: 
 5843:             side->btrack(k, dt, dtbk, u_int);
 5844: 
 5845: 
 5846:             side->btu[k] = {u_int.x, u_int.y};
 5847:                
 5848:          } // if vmag (do backtrack)
 5849: 
 5850: 
 5851:       } // for k=kb,nvrt-1
 5852: 
 5853:    }
 5854: 
 5855: } // extern "C"
 5856: 
 5857: template<int nc>
 5858: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 5859: 
 5860: // Solves a tridiagonal system. Adapted from Numerical Recipes in FORTRAN (pp.43).
 5861: //
 5862: // Although this is a general function, it is used only for equations on vertical levels.
 5863: // nc is the number of components in each unknown: 1 for a scalar, 2 for Vector2.
 5864: // It is not really for nc independent RHS vectors. We only use it for scalar and Vector2.
 5865: // Vector2 is stored as adjacent (x, y), so index of level j, component l is j*nc + l.
 5866: //
 5867: // a, b, c, rhs: inputs, not modified. gam: work array of length n.
 5868: // a, b, c are the three diagonals (b = main). a[0] and c[n-1] are unused.
 5869: // n: rank of the system (number of vertical levels in the 3D momentum solve).
 5870: // rhs, u: length n*nc, packed C order (n levels, nc components per level).
 5871: 
 5872:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 5873:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 5874: 
 5875:    double bet = b[0];
 5876:    if constexpr (nc == 1) {
 5877:       u[0] = rhs[0]/bet;
 5878:    } else {
 5879:       #pragma unroll
 5880:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 5881:    }
 5882: 
 5883:    for (int j = 1; j < n; j++) {
 5884:       gam[j] = c[j - 1]/bet;
 5885:       bet = b[j] - a[j]*gam[j];
 5886: 
 5887:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 5888: 
 5889:       if constexpr (nc == 1) {
 5890:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 5891:       } else {
 5892:          #pragma unroll
 5893:          for (int l = 0; l < nc; l++) {
 5894:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 5895:          }
 5896:       }
 5897:    }
 5898: 
 5899:    // Back-substitution
 5900:    for (int j = n - 2; j >= 0; j--) {
 5901:       if constexpr (nc == 1) {
 5902:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 5903:       } else {
 5904:          for (int l = 0; l < nc; l++) {
 5905:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 5906:          }
 5907:       }
 5908:    }
 5909: }
 5910: 
 5911: 
 5912: 
 5913: // Helper function that contains the core algorithm
 5914: template<typename XAccessor, typename YAccessor>
 5915: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 5916:                                     double  yp_top, double  yp_bot, 
 5917:                                     CubicSpline &spline) {
 5918:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 5919:    // 
 5920:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 5921:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 5922:    //
 5923:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 5924:    // 
 5925:    // Inputs: 
 5926:    //            n: dimension for x etc; # of data pts (>=2);
 5927:    //            getX, getY: functions to access x,y coordinates
 5928:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 5929:    //     Output: 
 5930:    //            spline (CubicSpline): spline structure with x,y,y',y''
 5931: 
 5932:    const int n = k2 - k1 + 1;
 5933:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 5934: 
 5935:    // Allocate memory for the splines
 5936:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 5937:    spline.x   = new double[n];
 5938:    spline.y   = new double[n];
 5939:    spline.yp  = new double[n];
 5940:    spline.ypp = new double[n];
 5941: 
 5942:    for (int k=k1; k<=k2; k++) {
 5943:       spline.x[k] = getX(k);
 5944:       spline.y[k] = getY(k);
 5945:    }
 5946: 
 5947:    // This is to simplify expressions later
 5948:    double *x = spline.x;
 5949:    double *y = spline.y;
 5950: 
 5951:    double *a = nullptr;
 5952:    double *b = nullptr;
 5953:    double *c = nullptr;
 5954:    double *gam = nullptr;
 5955:    double *rhs = nullptr;
 5956:    
 5957: 
 5958:       a = new double[n];   // Lower diagonal
 5959:       b = new double[n];   // Diagonal
 5960:       c = new double[n];   // Upper diagonal
 5961:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 5962:       rhs = new double[n]; // Right-hand side
 5963: 
 5964:    for (int k=k1; k<=k2; k++) {
 5965:       if (k == k1) {
 5966:          // Bottom level
 5967:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 5968:          b[k] = (x[k+1] - x[k])/3.0;
 5969:          c[k] = b[k]/2.0;
 5970:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 5971:       } else if (k == n - 1) {
 5972:          // Top level (surface)
 5973:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 5974:          b[k] = (x[k] - x[k-1])/3.0;
 5975:          a[k] = b[k]/2.0;
 5976:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 5977:       } else {
 5978:          // Intermediate levels
 5979:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 5980:          b[k] = (x[k+1] - x[k-1])/3.0;
 5981:          a[k] = (x[k  ] - x[k-1])/6.0;
 5982:          c[k] = (x[k+1] - x[k  ])/6.0;
 5983:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 5984:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 5985:       }
 5986:    }
 5987: 
 5988:    // Solve the tridiagonal system
 5989:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 5990:    
 5991:    spline.yp[k1] = yp_bot;
 5992:    spline.yp[k2] = yp_top;
 5993: 
 5994:    // Compute rest of 1st derivatives using the splines
 5995:    for (int k=k1+1; k<k2; k++) {
 5996:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 5997:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 5998:    }
 5999:    
 6000:    delete[] a;
 6001:    delete[] b;
 6002:    delete[] c;
 6003:    delete[] gam;
 6004:    delete[] rhs;
 6005: 
 6006: }
 6007: 
 6008: // Array version
 6009: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 6010:                                 double y_top, double y_bot, 
 6011:                                 CubicSpline &spline) {
 6012:    auto getX = [x] (int k) { return x[k]; };
 6013:    auto getY = [y] (int k) { return y[k]; };
 6014:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 6015: }
 6016: 
 6017: // Lambda version - allows custom access patterns
 6018: template<typename XFunc, typename YFunc>
 6019: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 6020:                                 double y_top, double y_bot,
 6021:                                 CubicSpline &spline) {
 6022:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 6023: }
