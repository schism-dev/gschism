 5638: 
 5639:    __global__ void computeVerticalVelocity(void) {
 5640:       // Computes the vertical velocity at the (2D) element's centroid.
 5641:       // In this function we will be considering volumetric elements, with side faces and a 
 5642:       // bottom and a top face. We will call them SFs, BF and TF.
 5643:       // It computes the flux coming from BF and the SFs.
 5644:       // If the bed is moving, it takes that into account.
 5645:       // Since water is incompressible, the integral of the velocity times the normal vector
 5646:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 5647:       // and the BF is equal to the flux going out from the TF.
 5648:       // TF = - BF - sum(SFs).
 5649:       // It then computes the horizontal velocity at the center of TF.
 5650:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 5651:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 5652:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 5653: 
 5654:       ELEM(elem);
 5655: 
 5656:       if (elem->isDry) return;
 5657: 
 5658:       const int kb = elem->kb;
 5659:       const bool isTri = elem->isTri();
 5660: 
 5661:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 5662: 
 5663:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 5664:       const double av_bdef1 = elem->mean(&Node::bdef1);
 5665:       const double av_bdef2 = elem->mean(&Node::bdef2);
 5666: 
 5667:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 5668: 
 5669:       double area3D;
 5670: 
 5671:       // Bottom face flux
 5672:       double bottomFlux = 0.0;
 5673:       Vector2 u2meanBottom = {0.0, 0.0};
 5674:       const Vector2 gradh = elem->grad2(&Node::depth);
 5675:       if constexpr(imm==2) {
 5676:          Vector3 ubed;
 5677: 
 5678:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 5679:          // updateBDEF(ubed);
 5680:      
 5681:          // const double bflux0 = dot(ubed, elem_n1);
 5682: 
 5683:          // elem->w[kb] += ubed.z;
 5684:       }
 5685:       else {
 5686:          Vector2 umean;
 5687:          if constexpr(ics == 1) {
 5688:             u2meanBottom = elem->mean(kb, &Side::u2);
 5689:          }
 5690:          else {
 5691:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 5692:          }
 5693: 
 5694:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 5695:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 5696: 
 5697:          bottomFlux = - dot(gradh, u2meanBottom);
 5698:       } // if imm
 5699: 
 5700:       // Compute w for kb+1 to nvrt-1
 5701:       for (int l = kb; l < nvrt - 1; l++) {
 5702: 
 5703:          // normal vector to the top face of the "volumetric" element (3D)
 5704:          Vector3 elem_n2 = elem->n(l + 1, area3D); 
 5705: 
 5706:          // Compute the total flux at the sides
 5707:          double sideFlux = 0.0;
 5708:          Vector2 u2top = {0.0, 0.0};
 5709:          for (int j = 0; j < elem->i34; j++) {
 5710:             const Side *side = elem->sides[j];
 5711: 
 5712:             const double sideArea = side->area(l);
 5713:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 5714:             const double sign = elem->ssign[j]; 
 5715: 
 5716:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 5717:          }
 5718:          
 5719:          // Compute the horizontal velocity at the center of the top face as an average of the 
 5720:          //velocities at the centers of the sides
 5721:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 5722: 
 5723:          // The flx at the top ace can be computed from the other flows.
 5724:          const double topFlux = - sideFlux - bottomFlux;
 5725:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 5726: 
 5727:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 5728: 
 5729:          elem_n1 = elem_n2;
 5730: 
 5731:          bottomFlux = - topFlux;
 5732:       }
 5733:    }  
 5734: 
