 1455:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1456:       // Compute the different time ramps used in the code 
 1457:       // This function is performed by just one thread
 1458: 
 1459:       if constexpr(ibc == 0) {
 1460:          if (drampbc > 0.0) {
 1461:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1462:          } else {
 1463:             rampbc = 1.0;
 1464:          }
 1465: 
 1466:          if (nws != 0 && drampwind > 0.0) {
 1467:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1468:          } else {
 1469:             rampwind = 1.0;
 1470:          }
 1471:       }
 1472: 
 1473:       if (drampwafo > 0.0) {
 1474:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1475:       } else {
 1476:          rampwafo = 1.0;
 1477:       }
 1478: 
 1479:       // For source/sinks
 1480:       if (if_source && dramp_ss > 0.0) {
 1481:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1482:       } else {
 1483:          ramp_ss = 1.0;
 1484:       }
 1485: 
 1486:       if (dramp > 0.0) {
 1487:          ramp = tanh(2.0*time/86400.0/dramp);
 1488:       } else {
 1489:          ramp = 1.0;
 1490:       }
 1491: 
 1492:       printf("computeTimeRamps: i = %d, time = %f, nws = %d, if_source = %d, ramp = %f, drampbc = %f, drampwind = %f, drampwafo = %f, dramp_ss = %f, dramp = %f\n", 
 1493:              threadIdx.x + blockIdx.x * blockDim.x, time, nws, if_source, ramp, drampbc, drampwind, drampwafo, dramp_ss, dramp);
 1494:    }
 1495:       
 1496: 
 1497:    __global__ void computeBedDeformation(void) {
 1498:       printf("NOT IMPLEMENTED: computeBedDeformation\n");
 1499: 
 1500:    }
