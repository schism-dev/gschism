  165: // VECTOR/POINT operations ---------------------------------------------------------------------------
  166: 
  167: using Vector2 = double2; 
  168: using Vector3 = double3;
  169: using Point2  = double2;
  170: using Point3  = double3;
  171: 
  172: __device__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
  173:     return make_double2(a.x + b.x, a.y + b.y);
  174: }
  175: 
  176: __device__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
  177:     a.x += b.x;
  178:     a.y += b.y;
  179:     return a;
  180: }
  181: 
  182: __device__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
  183:     return make_double2(a.x - b.x, a.y - b.y);
  184: }
  185: 
  186: __device__ __forceinline__ double2 operator-=(double2& a, const double2& b) {
  187:     a.x -= b.x;
  188:     a.y -= b.y;
  189:     return a;
  190: }
  191: 
  192: __device__ __forceinline__ double2 operator*(const double2& v, const double s) {
  193:     return make_double2(v.x * s, v.y * s);
  194: }
  195: 
  196: __device__ __forceinline__ double2 operator*(const double s, const double2& v) {
  197:     return v * s;  // reuse the previous operator
  198: }
  199: 
  200: __device__ __forceinline__ double2 operator/(const double2& v, double s) {
  201:     return make_double2(v.x / s, v.y / s);
  202: }
  203: 
  204: __device__ __forceinline__ double norm2(const double2& v) {
  205:     return v.x*v.x + v.y*v.y;
  206: }
  207: 
  208: __device__ __forceinline__ double length(const double2& v) {
  209:     return sqrt(v.x*v.x + v.y*v.y);
  210: }
  211: 
  212: __device__ __forceinline__ double2 normalize(const double2& v) {
  213:     return v / length(v);
  214: }
  215: 
  216: __device__ __forceinline__ double dot(const double2& v, const double2& w) {
  217:     return v.x*w.x + v.y*w.y;
  218: }
  219: 
  220: __device__ __forceinline__ double cross(const double2& v, const double2& w) {
  221:     return v.x*w.y - v.y*w.x;
  222: }
  223: 
  224: __device__ __forceinline__ double2 rot90(const double2& a) {
  225:     return make_double2(a.y, -a.x);
  226: }
  227: 
  228: __device__ __forceinline__ double3 operator+(const double3& a, const double3& b) {
  229:     return make_double3(a.x + b.x, a.y + b.y, a.z + b.z);
  230: }
  231: 
  232: __device__ __forceinline__ double3 operator+=(double3& a, const double3& b) {
  233:     a.x += b.x;
  234:     a.y += b.y;
  235:     a.z += b.z;
  236:     return a;
  237: }
  238: 
  239: __device__ __forceinline__ double3 operator-(const double3& a, const double3& b) {
  240:     return make_double3(a.x - b.x, a.y - b.y, a.z - b.z);
  241: }
  242: 
  243: __device__ __forceinline__ double3 operator*(const double3& v, double s) {
  244:     return make_double3(v.x * s, v.y * s, v.z * s);
  245: }
  246: 
  247: __device__ __forceinline__ double3 operator*(double s, const double3& v) {
  248:     return v * s;
  249: }
  250: 
  251: __device__ __forceinline__ double3 operator/(const double3& v, double s) {
  252:     return make_double3(v.x / s, v.y / s, v.z / s);
  253: }
  254: 
  255: __device__ __forceinline__ double dot(const double3& v, const double3& w) {
  256:     return v.x*w.x + v.y*w.y + v.z*w.z;
  257: }
  258: 
  259: __device__ __forceinline__ double norm2(const double3& v) {
  260:     return v.x*v.x + v.y*v.y + v.z*v.z;
  261: }
  262: 
  263: __device__ __forceinline__ Vector2 toVector2(const double3& v) {
  264:     return make_double2(v.x, v.y);
  265: }
  266: 
  267: __device__ __forceinline__ double3 toVector3(const double2& v, double w) {
  268:     return make_double3(v.x, v.y, w);
  269: }
  270: 
  271: __device__ __forceinline__ Point2 toPoint2(const double3& p) {
  272:     return make_double2(p.x, p.y);
  273: }
  274: 
  275: __device__ __forceinline__ Point3 toPoint3(const double2& p, double z) {
  276:     return make_double3(p.x, p.y, z);
  277: }
