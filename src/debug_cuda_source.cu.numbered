 2542: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2543:    // Returns the value of the normal component of the velocity at the side center
 2544:    const double w1 = getBoundaryArrayValueWeight();
 2545:    const double w2 = 1.0 - w1;
 2546:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2547:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2548: 
 2549:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2550: }
