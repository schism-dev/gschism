 2770: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2771: 
 2772: 
 2773: __device__ void Node::updateKb(void) {
 2774: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2775: 
 2776:    if constexpr(ivcor == 1) return;
 2777: 
 2778: 
 2779:    if (isDry2()) return;
 2780: 
 2781:    if constexpr(ivcor == 2) {  // SZ coordinates
 2782:       
 2783:       // Compute bottom level index
 2784:       if (depth <= mesh->h_s) {
 2785:          kb = izlev;
 2786:          
 2787:       } else {
 2788:          kb = -1;
 2789:          int L = 0;
 2790:          int R = nzlev; 
 2791:          
 2792:          while (L <= R) {
 2793:             int M = (R + L) / 2;
 2794: 
 2795: // printf("L = %d, R = %d, M = %d, depth = %f, ztot[L] = %f, ztot[R] = %f, ztot[M] = %f\n", L, R, M, depth, mesh->ztot[L], mesh->ztot[R], mesh->ztot[M]);
 2796:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2797:             
 2798:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2799:                R = M;
 2800:             } else {
 2801:                L = M;
 2802:             }
 2803: 
 2804:             if (R - L == 1) {
 2805:                kb = L;
 2806:                break;
 2807:             }
 2808:          }
 2809:       }
 2810:    } 
 2811: }
