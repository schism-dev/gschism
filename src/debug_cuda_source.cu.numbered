 2091: /**
 2092:    Compute the shape coordinates of the point (xt,yt) in the element.
 2093:    @param xt (input): x-coordinate of the point
 2094:    @param shpCoords (output): shape coordinates of the point
 2095: **/
 2096: __device__ void Element::computeShapeCoords(Point2 &xt, ShapeCoords &shpCoords) const {
 2097: 
 2098:    // Compute the shape coordinates of the point xt in the element.
 2099:    if (i34==3) {
 2100:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2101:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2102:       // and in this case, the pt will be nudged into the element
 2103:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2104:       // from the local frame, so use additional check.
 2105: 
 2106:       Point2 x0, x1, x2;
 2107: 
 2108:       if constexpr(ics==1) {
 2109:          x0 = nodes[0]->p;
 2110:          x1 = nodes[1]->p;
 2111:          x2 = nodes[2]->p;
 2112:       }
 2113:       else // lat/lon
 2114:       {
 2115:          Error("Not implemented yet");
 2116:          // globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2117:          // globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2118:          // globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2119:       }
 2120: 
 2121:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2122:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2123:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2124:       shpCoords[3] = 0.0;
 2125: 
 2126:    }
 2127:    else {
 2128:       Error("Not implemented yet");
 2129: #ifdef QUADS
 2130:       // Reproject pt in eframe of nel for ics=2
 2131:       if constexpr(ics==1) {
 2132:          xn2 = xt; 
 2133:          yn2 = yt;
 2134:       }
 2135:       else {
 2136:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2137:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2138:       }
 2139: 
 2140:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2141: #endif
 2142:    }
 2143: 
 2144: 
 2145: }
 2146: 
 2147: 
 2148: __device__ void Element::shapeCoordsToXY(ShapeCoords const &shpCoords, Vector2 &xt) const {
 2149: // Convert shape coordinates to cartesian coordinates
 2150: 
 2151:    assert(false && "shapeCoordsToXY: Not implemented, xt is not modified"); 
 2152:    if (i34 == 3) {
 2153:       // Triangular element
 2154:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2155:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2156:    }
 2157:    else {
 2158:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2159:    }
 2160: 
 2161: }
 2162: 
 2163: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2164:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2165:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2166:    // The formula for the integral is:
 2167:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2168: 
 2169:    printf("intPhiPhi: TEST\n");
 2170: 
 2171:    const Node *n0 = nodes[0];
 2172:    const Node *n1 = nodes[1];
 2173:    const Node *n2 = nodes[2];
 2174:    const Node *n3 = nodes[3];
 2175: 
 2176:    const Vector2 p0 = n0->p;
 2177:    const Vector2 p1 = n1->p;
 2178:    const Vector2 p2 = n2->p;
 2179:    const Vector2 p3 = n3->p;
 2180: 
 2181:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2182:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2183:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2184:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2185: 
 2186:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2187: }
 2188:    
 2189: 
 2190: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2191:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2192:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2193:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2194:    // The formula is also based on the identity:
 2195:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2196:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2197: 
 2198:    printf("intGradPhiGradPhi: TEST\n");   
 2199: 
 2200:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2201: 
 2202:    const double x0 = nodes[0]->p.x;
 2203:    const double y0 = nodes[0]->p.y;
 2204:    const double x1 = nodes[1]->p.x;
 2205:    const double y1 = nodes[1]->p.y;
 2206:    const double x2 = nodes[2]->p.x;
 2207:    const double y2 = nodes[2]->p.y;
 2208:    const double x3 = nodes[3]->p.x;
 2209:    const double y3 = nodes[3]->p.y;
 2210: 
 2211:    double res = 0.0;
 2212:    
 2213:    // Quadrature points in xi and eta coordinates
 2214:    #pragma unroll
 2215:    for (int i = 0; i < 4; i++) {
 2216:       // For each quadrature point...
 2217: 
 2218:       const Point2 p = GaussPoint(i);
 2219:       const double eta = p.x;
 2220:       const double xi  = p.y;
 2221: 
 2222:       // Jacobian entries at the Gauss point p
 2223:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2224:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2225:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2226:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2227: 
 2228:       const double detJ = jacobianDet(p);
 2229:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2230: 
 2231:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2232:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2233:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2234:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2235:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2236: 
 2237:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2238:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2239:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2240:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2241:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2242: 
 2243:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2244:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2245:    }
 2246: 
 2247:    return res;
 2248: }
 2249: 
 2250: 
 2251: /**  Interpolate velocities at a given point (xt,yt,zt)
 2252: 
 2253:    @param xt, yt, zt: coordinates of the point to interpolate
 2254:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2255: 
 2256:    This is done in four steps:
 2257: 
 2258:    1. Find the shape coordinates for the final position in the element.
 2259:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2260:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2261:       z levels at xt, yt at each step.   
 2262:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2263:       horizontally and vertically.
 2264: **/
 2265: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2266:    // Interpolate the velocities at the point xt. 
 2267:    // This function works the same for triangular and quadrilateral elements.
 2268:    ShapeCoords shpCoord;
 2269: 
 2270:    // First step is to compute the shape coordinates of (xt,yt)
 2271:    computeShapeCoords(toVector2(xt), shpCoord);
 2272: 
 2273: if ((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) < -small))   {
 2274:    printf("Invalid shape coordinates: shpCoord[0] = %f, shpCoord[1] = %f, shpCoord[2] = %f, shpCoord[3] = %f, xt = %f, yt = %f, zt = %f\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3], xt.x, xt.y, xt.z);
 2275:    return;
 2276: }
 2277:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2278: 
 2279:    // Second step is to find the level that contains zt
 2280:    // Uses a binary search to find the level
 2281:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2282:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2283:    int R = nvrt - 1;
 2284: 
 2285:    // Get the z coordinates at the nodes of the element at the levels L and R
 2286:    ShapeCoords zLAtNodes, zRAtNodes, zMAtNodes;
 2287:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2288:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2289: 
 2290:    double zL = interpolate(shpCoord, zLAtNodes);
 2291:    double zR = interpolate(shpCoord, zRAtNodes);
 2292:    
 2293:    // Interpolates vertically the velocities
 2294:    double wght1, wght2;
 2295:    if (xt.z<=zL) {
 2296:       wght1 = 1.0;
 2297:       wght2 = 0.0;
 2298:       xt.z = zL;
 2299:    }
 2300:    else if (xt.z>=zR) {
 2301:       wght1 = 0.0;
 2302:       wght2 = 1.0;
 2303:       xt.z = zR;
 2304:    }
 2305:    else {
 2306:       // Perform a binary search to find the levels between L and R that contain xt.z
 2307:       while (R - L > 1) {
 2308:          int M = (L + R) / 2.0;
 2309: 
 2310:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2311:          double zM = interpolate(shpCoord, zMAtNodes);
 2312:          if (zM < xt.z) 
 2313:          {
 2314:             L = M;
 2315:             zL = zM;
 2316:          }
 2317:          else 
 2318:          {
 2319:             R = M;
 2320:             zR = zM;
 2321:          }
 2322:       }
 2323:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 2324:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2325: 
 2326:       wght2 = (xt.z - zL)/(zR - zL);
 2327:       wght1 = 1.0 - wght2;
 2328: 
 2329:    }
 2330: 
 2331: 
 2332:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2333:    u_int = wght1*interpolate(L, shpCoord, &Node::uvw2) + wght2*interpolate(R, shpCoord, &Node::uvw2);
 2334: 
 2335: if (isnan(u_int.x) || isnan(u_int.y) || isnan(u_int.z))  {
 2336: printf("NaN velocities in interpolateVelocities: xt.z = %f, zL = %f, zR = %f, wght1 = %f, wght2 = %f, u_int = %f, %f, %f\n", xt.z, zL, zR, wght1, wght2, u_int.x, u_int.y, u_int.z);
 2337: u_int = {0.0, 0.0, 0.0};
 2338: return;
 2339: }
 2340:    // Neither of the interpolated velocities should be NaN
 2341:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2342: 
 2343: }
 2344: 
 2345: 
 2346: 
 2347: 
 2348: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2349: 
 2350:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2351:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2352:    const Node *n1 = side->n1;
 2353:    const Node *n2 = side->n2;
 2354: 
 2355:    bool n1_match = (n1->nodeBnd->segment == segment);
 2356:    bool n2_match = (n2->nodeBnd->segment == segment);
 2357: 
 2358:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2359:    if (n1_match && n2_match) {
 2360:       return 0.5;
 2361:    } else if (n1_match) {
 2362:       return 1.0;
 2363:    } else if (n2_match) {
 2364:       return 0.0;
 2365:    }
 2366: 
 2367:    return 0.0;
 2368: }
 2369: 
 2370: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2371: 
 2372: 
 2373: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2374: 
 2375:    const double w1 = getBoundaryArrayValueWeight();
 2376:    const double w2 = 1.0 - w1;
 2377:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2378:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2379: 
 2380:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2381: }
 2382: 
 2383: 
 2384: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2385:    const double w1 = getBoundaryArrayValueWeight();
 2386:    const double w2 = 1.0 - w1;
 2387:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2388:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2389: 
 2390:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2391: 
 2392: }
 2393: 
 2394: 
 2395: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2396:    // Returns the value of the velocity at the side center
 2397:    const double w1 = getBoundaryArrayValueWeight();
 2398:    const double w2 = 1.0 - w1;
 2399:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2400:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2401: 
 2402:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2403: }
 2404: 
 2405: 
 2406: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2407:    // Returns the value of the normal component of the velocity at the side center
 2408:    const double w1 = getBoundaryArrayValueWeight();
 2409:    const double w2 = 1.0 - w1;
 2410:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2411:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2412: 
 2413:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2414: }
 2415: 
 2416: 
 2417: 
 2418: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2419: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2420: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 2421: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 2422: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2423: __inline__ __device__ Vector3 Side::interpolateCenterVelocityVertically(Point3 xt) const { 
 2424: // Interpolates the side's center vertically at point xt.
 2425: // 
 2426: // The horizontal velocity (u2) is stored at the side center, but the vertical velocity (w) 
 2427: // is stored at the nodes. Since vertical levels vary in space along the side, we use the 
 2428: // parametric position t of xt along the side to determine which vertical levels bracket 
 2429: // xt.z, then interpolate the center velocity between those levels.
 2430: //
 2431: // This is an approximation used only when backtracking slides along a side.
 2432: //
 2433: // @param xt: A point on the side (not necessarily at the center) whose z-coordinate 
 2434: //            determines the vertical interpolation level
 2435: // @return: Interpolated 3D velocity vector (u, v, w) at the side center at the vertical 
 2436: //          level corresponding to xt.z
 2437: 
 2438:    assert(containsPoint(toPoint2(xt)) && "Point is not on the side");
 2439: 
 2440:    // Convert 2d coordinates to parametric coordinates on the side
 2441:    const double t = dot(toPoint2(xt) - n1->p, t12())/len;
 2442: 
 2443:    // Searches using binary search the vertical level that contains the z-coordinate of the point
 2444:    int L = kb;
 2445:    int R = nvrt - 1;
 2446:    while (R - L > 1) {
 2447:       int M = (L + R) / 2;
 2448:       const double z = (1 - t)*n1->z[M] + t*n2->z[M];
 2449:       if (z < xt.z) L = M;
 2450:       else R = M;
 2451:    }
 2452:    assert(L == R - 1 && "Binary search failed to find the vertical level containing zt");
 2453: 
 2454:    // Interpolates the center velocity at the relative distance of xt.z between the two levels L and R
 2455:    const double z1 = (1 - t)*n1->z[L] + t*n2->z[L];
 2456:    const double z2 = (1 - t)*n1->z[R] + t*n2->z[R];
 2457:    const double weight2 = (xt.z - z1)/(z2 - z1);
 2458:    const double weight1 = 1.0 - weight2;
 2459: 
 2460:    // Interpolate the horizontal velocity
 2461:    const Vector2 u = weight1*u2[L] + weight2*u2[R];
 2462: 
 2463:    // Interpolate the vertical velocity
 2464:    const double w1 = (1 - t)*n1->w2[L] + t*n2->w2[L];
 2465:    const double w2 = (1 - t)*n1->w2[R] + t*n2->w2[R];
 2466:    const double w = weight1*w1 + weight2*w2;
 2467: 
 2468:    return {u.x, u.y, w};
 2469: 
 2470: }
 2471: 
 2472: __forceinline__ __device__ bool Side::containsPoint(Vector2 x) const { 
 2473:    // Check if the point (x,y) is in the side, meaning that it includes points that are close to the side (within geometricEpsilon).
 2474: 
 2475:    const double t = length(x - n1->p)/len; // Parameterization of the point on the side (0 at n1, 1 at n2)
 2476:    return (t >= -2*geometricEpsilon) && (t <= 1.0 + 2*geometricEpsilon) && (abs(relativeSignedDistanceToPoint(x)) <= geometricEpsilon); 
 2477: }
 2478: 
 2479: 
 2480: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2481:    Vector2 grad = {0.0, 0.0};
 2482:    int count = 0;
 2483: 
 2484:    if constexpr(ics == 2) assert(false && "grad2: ics = 2 not implemented");
 2485: 
 2486:    // First element
 2487:    if (elems[0] != nullptr && condition(elems[0])) {
 2488:       grad += elems[0]->grad2(field);
 2489:       count++;
 2490:    }
 2491: 
 2492:    // Second element
 2493:    if (elems[1] != nullptr && condition(elems[1])) {
 2494:       grad += elems[1]->grad2(field);
 2495:       count++;
 2496:    }
 2497: 
 2498:    if (count > 0) {
 2499:       grad = grad*(1.0/count);
 2500:    }
 2501:    
 2502:    return grad;
 2503: }
 2504: 
 2505: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 2506: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 2507: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 2508: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 2509: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 2510: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 2511: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 2512: 
 2513: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 2514: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 2515: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 2516: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 2517: 
 2518: 
 2519: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 2520: 
 2521: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 2522: 
 2523: 
 2524: 
 2525: __inline__ __device__ void backtrackFromPoint(BTPoint &bkPoint, double dt, double dtbk);
 2526: 
 2527: 
 2528: /**
 2529:  * This method performs backtracking from the side center until a time -dt back in time 
 2530:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2531:  * intermediate point.
 2532:  *
 2533:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2534:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2535:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2536:  * remaining time.
 2537:  * 
 2538:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2539:  * 
 2540:  * @param uuint, vvint, wwint: Velocities at the final point
 2541:  * @param jlev: Level at which the backtracking is performed
 2542:  * @param dt, dtbk: Tracking timesteps
 2543:  * @return: backtracked velocity at the final point
 2544:  */
 2545: __inline__ __device__ Vector2 Side::btrack(
 2546:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 2547:       double dt,            // Tracking time
 2548:       double dtbk           // Tracking timestep
 2549: ) const {
 2550: 
 2551:    // Start from side center
 2552:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2553: 
 2554:  
 2555:    double time_rm = dt; // Remaining time
 2556: 
 2557:    BTPoint btPoint(x0, BTPoint::BTPointType::btSide, nullptr, const_cast<Side*>(this));
 2558: 
 2559:    btPoint.u = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 2560: 
 2561:    backtrackFromPoint(btPoint, dt, dtbk);
 2562: 
 2563:    return toVector2(btPoint.u);
 2564: 
 2565: }
 2566: 
 2567: 
 2568: __device__ void findNextPoint(BTPoint &curPoint, double dtbk);
 2569: __device__ void DEAL_WITH_POINT_INTERSECTING_SIDE(BTPoint &curPoint, Point3 &xt, const Side *excludeSide1, const Side *excludeSide2); 
 2570: __device__ void DEAL_WITH_POINT_MOVING_OUTSIDE_SIDE(BTPoint &curPoint, Point3 &xt);
 2571: __device__ void DEAL_WITH_POINT_MOVING_ALONG_SIDE(BTPoint &curPoint, Point3 &xt);
 2572: __device__ void DEAL_WITH_POINT_MOVING_OUTSIDE_NODE(BTPoint &curPoint, Point3 &xt);
 2573: 
 2574: 
 2575: /**
 2576:  * This function performs backtracking from startPoint until a time -dt back in time from the current time. 
 2577:  * The backtracking is performed using the velocities (u,v,w) at each intermediate point (except at open and land boundaries)
 2578:  *
 2579:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2580:  * a maximum length of dtbk*vel_step, where vel_step is the module of the velocity at that step and dtbk is 
 2581:  * the timestep (of the backtracking). The actual length of the segment can be shorter if the backtracking intersects a side or a node.
 2582:  * 
 2583:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2584:  * 
 2585:  * @param startPoint: Starting point of the backtracking
 2586:  * @param klev: Level at which the backtracking is performed
 2587:  * @param dt: Tracking time
 2588:  * @param dtbk: Tracking timestep
 2589:  
 2590:  */
 2591:  __inline__ __device__ void backtrackFromPoint(BTPoint &bkPoint, double dt, double dtbk) {
 2592: 
 2593:    const int MAX_ITERATIONS = 1000; 
 2594: 
 2595:    double remainingTime = dt; 
 2596: 
 2597:    int iter = 0;
 2598: 
 2599:    while (remainingTime > 0.0) {
 2600: printf("1 findNextPoint, bkPoint.type = %d\n", bkPoint.type);      
 2601:       
 2602:       iter++;
 2603: 
 2604:       // If the velocity is too small, we stop the backtracking
 2605:       if (length(bkPoint.u) <= velmin_btrack) break;
 2606: 
 2607:       assert(iter < MAX_ITERATIONS && "Max iterations reached in backtrackFromPoint");
 2608: 
 2609:       // Finds the next point in the backtracking curve. updates bkPoint.
 2610:       findNextPoint(bkPoint, min(dtbk, remainingTime));
 2611: 
 2612: printf("2 findNextPoint: remainingTime = %f, bkPoint.dt = %f, dtbk = %f\n", remainingTime, bkPoint.dt, dtbk);
 2613: 
 2614:       remainingTime -= bkPoint.dt;
 2615:    } 
 2616: 
 2617: }
 2618: 
 2619: /**
 2620:  * Finds the next point in the backtracking curve from the current point.
 2621:  * 
 2622:  * @param curPoint      Current backtracking point (input/output - will be updated to next point)
 2623:  * @param dtbk          Maximum timestep for this segment
 2624:  * 
 2625:  * The function handles three cases based on curPoint.type:
 2626:  * - btElement: Point is in element interior
 2627:  * - btSide: Point is on a side
 2628:  * - btNode: Point is at a node
 2629:  * 
 2630:  * The actual timestep may be less than dtbk if an intersection is found.
 2631:  *
 2632:  * For this algorithms, the interior of an element is defined as the 'skinny' element whose shape coordinates are larger than small. A point that is not in the interior
 2633:  * of an element is either outside the mesh, or on a side or node.
 2634:  */
 2635:  __device__ void findNextPoint(BTPoint &curPoint, double dtbk) {
 2636: 
 2637:    printf("3 findNextPoint curPoint.type = %d\n", curPoint.type);      
 2638: 
 2639:    const Point3 x0 = curPoint.x;
 2640:    const Vector3 u = curPoint.u;
 2641:    
 2642:    // Calculate target point (backward in time)
 2643:    Point3 xt = x0 - dtbk*u;
 2644: 
 2645:    // The current point always 'belongs' to an element (even if it is a node or a side, in which case it is one of the elements sharing the node or the side).
 2646:    // This element is used to interpolate the velocity.
 2647:    const Element *elem = curPoint.elem;  
 2648: 
 2649:    curPoint.dt = dtbk;
 2650: 
 2651:  
 2652:    // How the next point is found depends on the type of the current point:
 2653:    switch (curPoint.type) {
 2654:       
 2655:       case BTPoint::BTPointType::btElement: {  // Starting from element interior...
 2656:          
 2657: 
 2658:          // When starting from the interior of an element, the next point is either in the interior of the same element, or it will intersect a side or a node.
 2659: // printf("4 elem = %p\n", elem);      
 2660: ShapeCoords shpCoord;   
 2661: elem->computeShapeCoords(toVector2(xt), shpCoord);
 2662: printf("4 findNextPoint: xt = %f, %f, shpCoord = %f, %f, %f, %f, elem->containsPoint2(toPoint2(xt)) = %d\n", xt.x, xt.y, shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3], elem->containsPoint2(toPoint2(xt)));
 2663:          
 2664:          // If the target point is still inside the 'skinny' element, the next point is in the element interior
 2665:          if (elem->containsPoint2(toPoint2(xt))) {
 2666:             // Still inside element -> next point is in element interior
 2667:             // In this case, the next point is in the interior of the same element.
 2668: 
 2669:             curPoint.x = xt;
 2670:             curPoint.dt = dtbk;
 2671:             // The rest of fields of curPoint do not change in this case (except for u, which is computed at the end)
 2672: 
 2673:          } else {
 2674:             // Target point is outside -> An intersection with element boundary is *guaranteed*.
 2675:             // In this case, the next point is on a side or a node.
 2676:             DEAL_WITH_POINT_INTERSECTING_SIDE(curPoint, xt, nullptr, nullptr);
 2677:  
 2678:          }
 2679: 
 2680: 
 2681:       }
 2682: 
 2683:       break;
 2684:       
 2685: 
 2686:       case BTPoint::BTPointType::btSide: {  // Starting from a side...
 2687:       
 2688:   
 2689:          // In this case there are three main possibilities:
 2690:          // - xt is in the interior of one of the elements sharing the side.
 2691:          // - x0xt intersects the sides of one of the elements sharing the side (not including the shared side).
 2692:          // - x0xt is collinear with the shared side.
 2693:          // - xt is outside the mesh.
 2694: 
 2695:          const Side *side = curPoint.side;
 2696: 
 2697:          assert(!(side->isDry) && "Side is dry");
 2698: 
 2699:          Element *e1 = side->elems[0];
 2700:          Element *e2 = side->elems[1];
 2701: 
 2702:          assert((e1 != nullptr && !e1->isDry) || (e2 != nullptr && !e2->isDry) && "Side has no wet elements");
 2703: 
 2704:          // e2 can be nullptr if the side is a boundary side.
 2705:          const bool isInsideE1 = e1->containsPoint2(toPoint2(xt));
 2706:          const bool isInsideE2 = (e2 != nullptr && !isInsideE1)?e2->containsPoint2(toPoint2(xt)):false;      
 2707:          
 2708: 
 2709:          // Check if it is inside one of the elements
 2710:          if (isInsideE1 || isInsideE2) {
 2711:             // If it is inside one of the elements, the next point is in the interior of an element.
 2712:             
 2713:             Element *nextElem = isInsideE1?e1:e2;
 2714: printf("5 nextElem = %p, isInsideE1 = %d, isInsideE2 = %d\n", nextElem, isInsideE1, isInsideE2);
 2715:             assert(!(nextElem->isDry) && "Element is dry"); // XXXX 
 2716:             // The new current point will be the target point
 2717:             curPoint.x = xt;
 2718:             curPoint.type = BTPoint::BTPointType::btElement;
 2719:             curPoint.elem = nextElem;
 2720:             curPoint.side = nullptr;
 2721:             curPoint.node = nullptr;
 2722:             curPoint.t = 0.0; 
 2723:             curPoint.dt = dtbk;
 2724:             printf("5 \n");
 2725:          } else {
 2726: 
 2727: printf("HEREREREERE\n");
 2728:             // The element is either along the current side or intersects the sides of one of the elements sharing the side.
 2729: 
 2730:             // Checks if x0xt is collinear with the side in a consistent way.
 2731:             const double lenSide = side->len;
 2732:             const Vector2 v2 = toPoint2(xt) - toPoint2(x0);
 2733:             const double lenX0Xt = length(v2);
 2734:             bool isAlongSide = false;
 2735: 
 2736:             if (lenSide > lenX0Xt) { // if x0xt is shorter than the side...
 2737:                isAlongSide = side->containsPoint(toPoint2(xt));
 2738:             }
 2739:             else { // if x0xt is longer than the side...
 2740:                // Computes a smaller collinear segment that starts at x0 and has length lenSide. The end point of this segment must be on the side.
 2741:                const Point2 xtmp = toPoint2(x0) + v2*lenSide/lenX0Xt;
 2742:                isAlongSide = side->containsPoint(xtmp);
 2743: 
 2744:             }
 2745: 
 2746:             if (isAlongSide) {
 2747:                // x0xt is contained in the same side x0 is on.
 2748: printf("aaa0\n");               
 2749:                DEAL_WITH_POINT_MOVING_ALONG_SIDE(curPoint, xt);
 2750: printf("aaa0, curPoint.type = %d, curPoint.elem = %p\n", curPoint.type, curPoint.elem);                     
 2751:             } else {
 2752: 
 2753: printf("aaa1\n");
 2754:                if (curPoint.elem == nullptr || curPoint.elem->isDry) {
 2755:                   // The segment goes out of water.
 2756:                   DEAL_WITH_POINT_MOVING_OUTSIDE_SIDE(curPoint, xt);
 2757:                   
 2758:                } else {
 2759:                   // x0xt intersects another side of the element.
 2760:                   // Gets the element that is in the direction opposite to the velocity vector (remember that we are backtracking)
 2761:                   curPoint.elem = side->findElementTowards(toVector2(u));
 2762: 
 2763:                   // This is a situation we know how to handle. 
 2764:                   DEAL_WITH_POINT_INTERSECTING_SIDE(curPoint, xt, side, nullptr);
 2765: 
 2766:                }
 2767: 
 2768:             }
 2769:          
 2770:          }
 2771: 
 2772:       }
 2773: 
 2774:       break;
 2775:       
 2776:       case BTPoint::BTPointType::btNode: {  // Starting from a node...
 2777: 
 2778: printf("btNode\n");         
 2779:          
 2780:          const Node *node = curPoint.node;
 2781:          
 2782:          // Check if the xt is inside one of the elements sharing the node
 2783:          for (int i = 0; i < node->numElements; i++) {
 2784:             Element *e = node->elements[i];
 2785: 
 2786:             
 2787:             if (e->containsSegment(node, toPoint2(xt))) {
 2788:                // This means that x0xt is contained in the element (in the sense that the wedge formed by the node and its adjacent sides includes the segment x0xt). 
 2789:                // This is in a 'fat' sense, meaning that it covers the cases where x0xt is actually along one of these sides.
 2790: 
 2791:                
 2792:                if (e->isDry) {
 2793:                   DEAL_WITH_POINT_MOVING_OUTSIDE_NODE(curPoint, xt);
 2794:                   break;
 2795: 
 2796:                }
 2797: 
 2798:                if (e->containsPoint2(toPoint2(xt))) {
 2799:                   // xt is contained in the element
 2800:                   curPoint.x = xt;
 2801:                   curPoint.dt = dtbk;
 2802:                   curPoint.type = BTPoint::BTPointType::btElement;
 2803:                   curPoint.elem = e;
 2804:                   curPoint.side = nullptr;
 2805:                   curPoint.node = nullptr;
 2806:                   break;
 2807: 
 2808:                } else {
 2809:                   // xt must intersect one of the opposite sides of the element
 2810:                   int idxSide1, idxSide2;
 2811:                   e->getSidesContainingNode(node, idxSide1, idxSide2);
 2812:                   const Side *side1 = e->sides[idxSide1];
 2813:                   const Side *side2 = e->sides[idxSide2];
 2814:                   curPoint.elem = e;
 2815:                   DEAL_WITH_POINT_INTERSECTING_SIDE(curPoint, xt, side1, side2);
 2816:                   break;
 2817:                }
 2818:                   
 2819:             } 
 2820:             
 2821: 
 2822:          } 
 2823: 
 2824:          // computes the maximal contiguous block of wet elements containing curPoint.elem.
 2825:          DEAL_WITH_POINT_MOVING_OUTSIDE_NODE(curPoint, xt);    
 2826:          
 2827:       }
 2828: 
 2829:    } // switch
 2830: printf("6 curPoint.type = %d, curPoint.elem = %p\n", curPoint.type, curPoint.elem);
 2831:    // Interpolates the velocities at the next point
 2832:    curPoint.elem->interpolateVelocities(curPoint.x, curPoint.u);
 2833: printf("7 \n");   
 2834: }
 2835: 
 2836: __device__ void DEAL_WITH_POINT_INTERSECTING_SIDE(BTPoint &curPoint, Point3 &xt, const Side *excludeSide1, const Side *excludeSide2) {
 2837:    // This function deals with the case where the segment x0xt intersects a side of the element that is not one of the two sides to exclude.
 2838: 
 2839:    Side *intersectSide = nullptr;
 2840:    Element *nextElem = nullptr;
 2841:    double t, tIntersect;
 2842: 
 2843:    const Point2 x1 = toPoint2(curPoint.x);
 2844:    const Point2 x2 = toPoint2(xt);
 2845:    const Element *elem = curPoint.elem;
 2846: 
 2847:    assert( elem->containsPoint2(x1) && "Starting point is not inside the element");                                    
 2848:    assert(!elem->containsPoint2(x2) && "Ending point is not outside the element");
 2849: 
 2850:    double closest_intersect_t = 1e10;
 2851:    bool found_intersection = false;
 2852:    double tt1, tt2, last_tt2;
 2853:    for (int i = 0; i < elem->i34; i++) {
 2854: 
 2855:       Side *side = elem->sides[i];
 2856: 
 2857:       if (excludeSide1 == side || excludeSide2 == side) continue;
 2858: 
 2859:       // (x3,y3)-(x4,y4) is the element side line
 2860:       const Point2 x3 = side->n1->p;
 2861:       const Point2 x4 = side->n2->p;
 2862: 
 2863:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 2864:       const double delta = cross(x2 - x1, x3 - x4);
 2865: 
 2866:       if (abs(delta) > 0) {
 2867: 
 2868:          const double delta1 = cross(x3 - x1, x3 - x4);
 2869:          const double delta2 = cross(x2 - x1, x3 - x1); 
 2870: 
 2871:          // Solves the two linear equations for tt1 and tt2
 2872:          tt1 = delta1/delta; // delta is not zero, so we can divide
 2873:          tt2 = delta2/delta;
 2874: 
 2875:          if (tt1 >= -geometricEpsilon  && tt1 <= 1.0 + geometricEpsilon) {
 2876: 
 2877:             assert(tt2 >= 0.0 && tt2 <= 1.0 + 3*geometricEpsilon && "tt2 is not in the range [0,1]"); // 3*geometricEpsilon is to ensure that intersection always exists.
 2878: 
 2879:             if (closest_intersect_t > tt1) {
 2880:                intersectSide = side;
 2881:                closest_intersect_t = clamp(tt1, 0, 1.0);
 2882:                nextElem = side->otherElem(elem);
 2883:                found_intersection = true;
 2884:                last_tt2 = tt2;
 2885:             }
 2886: 
 2887:          }
 2888: 
 2889:       }
 2890: 
 2891:    } // for
 2892: 
 2893:    assert(found_intersection && "No intersection found");
 2894: 
 2895:    if (last_tt2 < geometricEpsilon) {
 2896:       curPoint.type = BTPoint::BTPointType::btNode;
 2897:       curPoint.node = intersectSide->n1;
 2898:       curPoint.side = intersectSide;
 2899:       curPoint.t = 0.0; 
 2900: 
 2901:    }
 2902:    else if (last_tt2 > 1.0 - geometricEpsilon) {
 2903:       curPoint.type = BTPoint::BTPointType::btNode;
 2904:       curPoint.node = intersectSide->n2;
 2905:       curPoint.side = intersectSide;
 2906:       curPoint.t = 1.0; 
 2907:       
 2908:    }
 2909:    else {
 2910:       curPoint.type = BTPoint::BTPointType::btSide;
 2911:       curPoint.side = intersectSide;
 2912:       curPoint.node = nullptr;
 2913:       curPoint.t = last_tt2;
 2914:    }
 2915: 
 2916:    curPoint.elem = nextElem;
 2917:    curPoint.dt = curPoint.dt*closest_intersect_t;
 2918:    toPoint2(curPoint.x) = intersectSide->p_t(curPoint.t);
 2919:    curPoint.x.z = (1.0 - closest_intersect_t)*curPoint.x.z + closest_intersect_t*xt.z;
 2920: 
 2921: 
 2922: }
 2923:  
 2924: __device__ void DEAL_WITH_POINT_MOVING_OUTSIDE_SIDE(BTPoint &curPoint, Point3 &xt) {
 2925: // This function deals with the case where the point is moving outside the side. In other words, the point is in a side and it is moving out of the mesh or into a dry element.
 2926: // This is one of the cases where sliding along a side happens.
 2927: 
 2928:    // Instead of the interpolated velocity, we use the tangent of the velocity *at the side center* as the velocity of the point. 
 2929: 
 2930:    const Side *side = curPoint.side;
 2931: 
 2932:    // We start with a point on the side and it is moving along it. First we check that it is a side in a boundary.
 2933:    assert(side->isBnd() || side->otherElem(curPoint.elem)->isDry && "Side is not a boundary between wet and dry elements (or boundary side)");
 2934: 
 2935:    const Vector2 tangent = side->t12();
 2936: 
 2937:    // In this case, the particle slides along the side. The next point is calculated using the tangent component of the side velocity.
 2938:    const Vector3 uSide = side->interpolateCenterVelocityVertically(xt);
 2939:    toVector2(curPoint.u) = dot(toVector2(uSide), tangent)*tangent;
 2940:    curPoint.u.z = uSide.z;
 2941: 
 2942:    // Computes the new location of the point sliding along the side. The z-coordinate is not changed because curPoint.u.z is also unchanged.
 2943:    xt = curPoint.x - curPoint.dt*curPoint.u;   
 2944: 
 2945:    // This is a situation we know how to handle. A point that is moving along a side.
 2946:    DEAL_WITH_POINT_MOVING_ALONG_SIDE(curPoint, xt);
 2947: 
 2948: }
 2949: 
 2950: __device__ void DEAL_WITH_POINT_MOVING_ALONG_SIDE(BTPoint &curPoint, Point3 &xt) {
 2951:    // This function deals with the case where the point is moving along a side.
 2952: 
 2953:    Side *side = curPoint.side;
 2954:    const Point3 x0 = curPoint.x;
 2955:    const Vector2 tangent = side->t12();
 2956:    const double len = length(toPoint2(xt) - toPoint2(x0));
 2957: 
 2958:    const double t = dot(toPoint2(xt) - side->n1->p, tangent)/side->len;  // Parameterization of the location of the point on the side (0 at n1, 1 at n2)
 2959: 
 2960:    if (curPoint.elem == nullptr) curPoint.elem = side->elems[0];  // elems[0] is never nullptr. This is done in case the element is not set yet.
 2961: 
 2962: printf(">>>> t = %f, x0 = %f, %f, %f, xt = %f, %f, %f\n", t, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z);   
 2963:    if (t < geometricEpsilon) {
 2964:       // The point is at a node.
 2965:       curPoint.type = BTPoint::BTPointType::btNode;
 2966:       curPoint.node = side->n1;
 2967:       curPoint.side = side;
 2968:       curPoint.t = 0.0; // Not really needed.
 2969: 
 2970:       
 2971:    }
 2972:    else if (t > 1.0 - geometricEpsilon) {
 2973:       // The point is at a node.
 2974:       curPoint.type = BTPoint::BTPointType::btNode;
 2975:       curPoint.node = side->n2;
 2976:       curPoint.side = side;
 2977:       curPoint.t = 1.0; 
 2978: 
 2979:    }
 2980:    else {
 2981:       // The point is along the side.
 2982:       curPoint.type = BTPoint::BTPointType::btSide;
 2983:       curPoint.node = nullptr;
 2984:       curPoint.side = side;
 2985:       curPoint.t = t;
 2986:       
 2987:    }
 2988: 
 2989:    toPoint2(curPoint.x) = side->p_t(curPoint.t);
 2990:    const double lenFinal = length(toPoint2(curPoint.x) - toPoint2(x0));
 2991:    const double fractionOfLength = lenFinal/len;
 2992: printf("fractionOfLength = %f\n", fractionOfLength);   
 2993:    curPoint.x.z = (1.0 - fractionOfLength)*x0.z + fractionOfLength*xt.z;   
 2994:    curPoint.dt = curPoint.dt*fractionOfLength;
 2995:    
 2996: }
 2997: 
 2998: __device__ void DEAL_WITH_POINT_MOVING_OUTSIDE_NODE(BTPoint &curPoint, Point3 &xt) {
 2999: // This function deals with the case where the point is moving outside from a node. In other words, the point is in a node and it is moving out of the mesh or into a dry element.
 3000: 
 3001:    const Element *elem = curPoint.elem;
 3002:    const Node *node    = curPoint.node;
 3003:    const Point3 x0     = curPoint.x;
 3004: 
 3005:    // computes the sides that delimit the contiguous block of wet elements containing e = curPoint.elem.
 3006: 
 3007:    assert(elem != nullptr && !elem->isDry && "elem cannot be nullptr or dry");
 3008:    assert(node != nullptr && "node cannot be nullptr");
 3009: 
 3010:    const int numSides = node->numSides;
 3011: 
 3012:    int idxStartWet = 0;      // First wet side index
 3013:    int idxEndWet = numSides; // Last wet side index
 3014: 
 3015:    // Finds the first wet side index
 3016:    for (int i = 0; i < numSides; i++) {
 3017:       const int prevIdx = (i + numSides - 1) % numSides;
 3018: 
 3019:       if (node->sides[prevIdx]->isDry && !node->sides[i]->isDry) idxStartWet = i;
 3020: 
 3021:       if (elem->containsSide(node->sides[i])) break;
 3022:    }
 3023: 
 3024:    // Finds the last wet side index
 3025:    for (int i = numSides - 1; i >= 0; i--) {
 3026:       const int nextIdx = (i + 1) % numSides;
 3027: 
 3028:       if (node->sides[nextIdx]->isDry && !node->sides[i]->isDry) idxEndWet = i;
 3029: 
 3030:       if (elem->containsSide(node->sides[i])) break;
 3031:    }
 3032: 
 3033:    // At this point idxStartWet and idxEndWet are the indices of the first and last wet sides in the contiguous block of wet sides containing elem.
 3034:    // If idxStartWet == 0 and idxEndWet == numSides - 1, all the sides are wet. This is only possible if the node is a boundary node.
 3035: 
 3036:    // These two sides are the ones that delimit the contiguous block of wet sides containing elem.
 3037:    Side *s1 = node->sides[idxStartWet];
 3038:    Side *s2 = node->sides[idxEndWet];
 3039: 
 3040:    assert(idxStartWet != 0 || idxEndWet != numSides - 1 || s1->sideBnd != nullptr || s2->sideBnd != nullptr && "Node is not a boundary node");
 3041: 
 3042:    // Now, there are two possibilities: 
 3043:    // - If any (or both) side velocities point away from the node, the point will slide along the side with the highest velocity component pointing away from the node.
 3044:    // - If both side velocities point towards the node, This is considered a death trap and the algorithm will stop here.
 3045:    const Vector3 uSide1 = s1->interpolateCenterVelocityVertically(xt);
 3046:    const Vector3 uSide2 = s2->interpolateCenterVelocityVertically(xt);
 3047:    const double u1tan = dot(toVector2(uSide1), s1->t(node));  // s1->t(node) is the unitary tangent vector to the side s1 pointing towards 'node'.
 3048:    const double u2tan = dot(toVector2(uSide2), s2->t(node));  // s2->t(node) is the unitary tangent vector to the side s2 pointing towards 'node'.
 3049: 
 3050:    if (u1tan < 0.0 || u2tan < 0.0) {
 3051:       // The point will slide along the side with the highest velocity component pointing away from the node.
 3052:       if (u1tan < u2tan) {
 3053:          // sliding along s1
 3054:          toVector2(curPoint.u) = u1tan * s1->t(node);
 3055:          curPoint.u.z = uSide1.z;
 3056:          xt = x0 - curPoint.dt*curPoint.u;
 3057:          curPoint.side = s1;
 3058: 
 3059:          // Once xt and curPoint.u are updated to slide along s1, we can call the function to deal with the case where the point is moving along a side.
 3060:          DEAL_WITH_POINT_MOVING_ALONG_SIDE(curPoint, xt);
 3061:       }
 3062:       else {
 3063:          // sliding along s2
 3064:          toVector2(curPoint.u) = u2tan * s2->t(node);
 3065:          curPoint.u.z = uSide2.z;
 3066:          xt = x0 - curPoint.dt*curPoint.u;
 3067:          curPoint.side = s2;
 3068: 
 3069:          // Once xt and curPoint.u are updated to slide along s2, we can call the function to deal with the case where the point is moving along a side.
 3070:          DEAL_WITH_POINT_MOVING_ALONG_SIDE(curPoint, xt);
 3071:       }
 3072: 
 3073:       return;
 3074:    }
 3075:    else
 3076:    {
 3077:       // DEATH TRAP: Both side velocities point towards the node. This is considered a death trap and the algorithm will stop here.
 3078:       assert(false && "DEATH TRAP: Both side velocities point towards the node. IMPLEMENT THIS CASE");
 3079:    }
 3080: 
 3081: 
 3082: 
 3083: }
 3084: 
 3085: 
 3086: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3087: 
 3088: 
 3089: __device__ void Node::updateKb(void) {
 3090: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3091: 
 3092:    if constexpr(ivcor == 1) return;
 3093: 
 3094: 
 3095:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3096: 
 3097:    if constexpr(ivcor == 2) {  // SZ coordinates
 3098:       
 3099:       // Compute bottom level index
 3100:       if (depth <= mesh->h_s) {
 3101:          kb = izlev;   
 3102:          
 3103:       } else {
 3104:          kb = -1;
 3105:          int L = 0;
 3106:          int R = nzlev; 
 3107:          
 3108:          while (L <= R) {
 3109:             int M = (R + L) / 2;
 3110: 
 3111: 
 3112:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3113:             
 3114:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3115:                R = M;
 3116:             } else {
 3117:                L = M;
 3118:             }
 3119: 
 3120:             if (R - L == 1) {
 3121:                kb = L;
 3122:                break;
 3123:             }
 3124:          }
 3125: 
 3126:          // Checks that the binary search was successful
 3127:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3128:        
 3129:       }
 3130:    } 
 3131: }
 3132: 
 3133: 
 3134: __device__ __inline__ void Node::updateZCoordData(void) {
 3135: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3136: 
 3137:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3138:    // if (isDry2()) {
 3139:    //    kb = -1;  // XXXXXXXX KKKKK
 3140:    //    return;
 3141:    // }
 3142: 
 3143: 
 3144:    if constexpr(ivcor == 2) {  // SZ coordinates
 3145:       
 3146:       // Compute bottom level index
 3147:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3148:    } 
 3149:    else if (ivcor == 1) {  // Localized sigma
 3150:       // Do nothing
 3151:    }
 3152: 
 3153: 
 3154: }
 3155: 
 3156: 
 3157: __device__ double Node::compZCoord(int k) const {
 3158:    // Computes the z coordinate at level k.
 3159:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3160:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3161:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3162:    // used 
 3163: 
 3164:    assert(k >= 0 && k < nvrt && "ZCOOR: invalid level\n");
 3165:    
 3166:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3167: 
 3168:    if (isDry2()) return 0.0;  // XXXX I used to return 0.0
 3169: 
 3170:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 3171: 
 3172:    if constexpr(ivcor == 2) {
 3173: 
 3174:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3175:       const double h_c = mesh->h_c;
 3176:       const double theta_f = mesh->theta_f;
 3177:       const double sinh_theta_f = mesh->sinh_theta_f;
 3178: 
 3179: 
 3180:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3181:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3182:       // once per time step/node.
 3183:       // CHECK: updateZCoordData
 3184: 
 3185:       //  To simplify comparisons, I define index versions of count variables.
 3186:       if      (k == ivrt)     return eta2; 
 3187:       else if (k == izlev)    return -hmod2;
 3188:       else if (k == kb)       return -depth;
 3189:       else if (k < izlev)     return mesh->ztot[k];
 3190:       else if (k > izlev) {
 3191:          const int ksig = k - izlev;
 3192: 
 3193:          if (hmod2 <= h_c) {
 3194:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3195: 
 3196:          } 
 3197:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3198:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3199:             assert(false && "ZCOOR: invalid h_c\n");
 3200:          } 
 3201:          else {
 3202:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3203:                    h_c * mesh->sigma[ksig] + 
 3204:                    (hmod2 - h_c) * mesh->cs[ksig];
 3205:          }
 3206:       } else { 
 3207:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 3208:       }
 3209: 
 3210:    }
 3211:    else if constexpr(ivcor == 1) {
 3212:       if (k == kb) return -depth;
 3213:       else if (k == nvrt-1) return eta2;
 3214:       else if (k > kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 3215:    }
 3216:    
 3217:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 3218:    return 0.0;
 3219: }
 3220: 
 3221: 
 3222: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3223:    // Computes the bottom drag Cd based on the selected nchi
 3224: 
 3225:    if constexpr(nchi == 0) {
 3226:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3227:       Cd = drag;  // Read from drag file
 3228: 
 3229:    } else if constexpr(nchi == 1) {
 3230:       // 
 3231: 
 3232:       bool ltmp = false; // for WBL iteration
 3233: 
 3234:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3235:       if (isDry || (rough == 0.0)) {
 3236:          Cd = 0.0;
 3237: 
 3238:       } else { //roughness >0 
 3239:          
 3240:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3241: 
 3242:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3243: 
 3244:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3245: 
 3246:       } // if rough
 3247: 
 3248:    } else if constexpr(nchi == -1) {
 3249:    // Manning 
 3250:  
 3251:       const double htot = max(hmin_man, htot2()); 
 3252:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3253: 
 3254:    } else {
 3255:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3256:       
 3257:    } // if nchi
 3258: 
 3259: }
 3260: 
 3261: 
 3262: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3263:    // Checks if a side in on the boundary
 3264:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3265: 
 3266:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3267:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3268: 
 3269:    // Indices of the nodes that form the side
 3270:    const int n1 = side.n1->idx;
 3271:    const int n2 = side.n2->idx;
 3272:    isLand = false;
 3273:    
 3274: 
 3275:    // Check if the side is on a land boundary
 3276:    for (int i = 0; i < nland; i++) {
 3277:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3278:          // Consecutive nodes in the land boundary segment
 3279:          const int b1 = ilnd[i + j*nland];
 3280:          const int b2 = ilnd[i + (j + 1)*nland];
 3281: 
 3282:          assert(b1 != -1 && b2 != -1);
 3283: 
 3284:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3285:             
 3286:             isLand = true;
 3287:             return i;
 3288:          }
 3289:       }
 3290:    }
 3291: 
 3292:    // Check if the side is on an open boundary
 3293:    for (int i = 0; i < nope; i++) {
 3294:       for (int j = 0; j < nond[i] - 1; j++) {
 3295:          // Consecutive nodes in the open boundary segment
 3296:          const int b1 = iond[i + j*nope];
 3297:          const int b2 = iond[i + (j + 1)*nope];
 3298: 
 3299:          assert(b1 != -1 && b2 != -1);
 3300: 
 3301:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3302:             isLand = false;
 3303:             return i;
 3304:          }
 3305:       }
 3306:    }
 3307: 
 3308:    return -1;
 3309: }
 3310: 
 3311: 
 3312: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3313:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3314:                                     double *wind_rotate_angle, 
 3315:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3316:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3317:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3318:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3319:                                     double *drag, double *roughness, double *rmanning) {
 3320: 
 3321:    NODE(pnode);  
 3322:    const int i = idx_node;
 3323:    Node &node(*pnode);
 3324: 
 3325:    node.idx = i;
 3326: 
 3327:    const int idxNodeStart = nodeNeighNodesStart[i];
 3328:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3329:    node.numNodes = idxNodeEnd - idxNodeStart;
 3330:    node.nodes = nodeNeighNodes + idxNodeStart;
 3331:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3332: 
 3333: 
 3334: 
 3335:    const int idxElemStart = nodeNeighElemsStart[i];
 3336:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3337:    node.numElements = idxElemEnd - idxElemStart;
 3338:    node.elements = nodeNeighElems + idxElemStart;
 3339: 
 3340: 
 3341:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3342:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3343:       const int partNode = localNodePart[idxNodeGlobal]; 
 3344:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3345: 
 3346:       Node *node_ptr = nodes[partNode] + idxNode;
 3347:       
 3348:       nodeNeighNodes[idx] = node_ptr;
 3349:    }
 3350: 
 3351: 
 3352:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3353:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3354:       const int partElem = localElemPart[idxElemGlobal];
 3355:       const int idxElem  = localElemIndices[idxElemGlobal];
 3356: 
 3357:       Element *elem_ptr = elems[partElem] + idxElem;
 3358: 
 3359:       nodeNeighElems[idx] = elem_ptr;
 3360:    }      
 3361: 
 3362:    node.wind_angle = wind_rotate_angle[i];
 3363: 
 3364: 
 3365:    node.p.x   = node_coords[i * 3];
 3366:    node.p.y   = node_coords[i * 3 + 1];
 3367:    node.depth = node_coords[i * 3 + 2];
 3368: 
 3369:    if (use_ll) {
 3370:    node.lon = node_coords_ll[i * 2    ]*deg2rad;
 3371:    node.lat = node_coords_ll[i * 2 + 1]*deg2rad;
 3372:    }
 3373: 
 3374: 
 3375:    node.numSides = 0;
 3376: 
 3377:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3378:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3379:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3380:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3381:    else assert(false && "populateNodes: selected nchi not implemented.");
 3382:    
 3383:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3384:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3385:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3386: 
 3387:    
 3388:    // Links the node to the boundary information
 3389:    if (isbnd[i] >= 0) {
 3390:      
 3391:       // Get the index of the node boundary
 3392:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3393: 
 3394:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3395:       node.nodeBnd->node = &node;
 3396: 
 3397:       node.nodeBnd->sideBnd1 = nullptr;
 3398:       node.nodeBnd->sideBnd2 = nullptr;
 3399: 
 3400:       if (isbnd[i]>=0) {
 3401: 
 3402:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3403:          
 3404:          node.nodeBnd->segment->ifltype = 3 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3405:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3406: 
 3407:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3408:          node.nodeBnd->segment->clen  = nan("1");
 3409:          node.nodeBnd->segment->carea = nan("1");
 3410: 
 3411:       }
 3412:    } else {
 3413: 
 3414:       node.nodeBnd = nullptr; // For internal nodes
 3415: 
 3416:       if (isbnd[i] == landSegment) {
 3417:          node.nodeBnd = &landBoundaryNode;
 3418:          node.nodeBnd->segment = &landBoundarySegment;
 3419:       }
 3420:       
 3421:    }
 3422:    
 3423:    // XXXX GAUSSIAN HILL VELOCITIES
 3424: #ifdef GAUSSIAN_HILL_VELOCITIES
 3425:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3426:       constexpr double rot_per = 3000.0;
 3427:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3428:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3429:    // XXXXX
 3430: #endif
 3431: 
 3432: }
 3433: 
 3434: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3435:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3436:                                     double *wind_rotate_angle,   
 3437:                                     int *isdel, int *isidenode, int *isbnd,
 3438:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3439:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3440:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3441:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3442:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3443:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3444:                                     double *drag, double *roughness) {
 3445: 
 3446: 
 3447:    SIDE(pside);
 3448:    Side &side(*pside);
 3449:    const int i = idx_side;
 3450: 
 3451:    side.idx = i;  
 3452:    
 3453:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3454:    const double fc   = 2.0*omega_e*sin(sfea0);
 3455:    const double beta = 2.0*omega_e*cos(sfea0);
 3456: 
 3457:    // finding the pointer to the nodes that form the side
 3458:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3459:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3460: 
 3461:    const int locidx_n1 = localNodeIndices[idx_n1];
 3462:    const int locidx_n2 = localNodeIndices[idx_n2];
 3463:    const int part_n1 =   localNodePart[idx_n1];
 3464:    const int part_n2 =   localNodePart[idx_n2];
 3465: 
 3466:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3467:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3468: 
 3469:    // Counts the number of sides connected to each node
 3470:    side.n1->numSides++;
 3471:    side.n2->numSides++;
 3472: 
 3473:    // Normal, unitary vector to the side
 3474:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3475:    side.n = normalize(side.n);
 3476: 
 3477:    // Side boundary type
 3478:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3479:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3480: 
 3481:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3482:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3483:    {
 3484:       bool isLand = false;
 3485:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3486:       
 3487:       if (isbs > -1) {
 3488:          // assert(isLand || isbs>=0);
 3489:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3490: 
 3491:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3492: 
 3493:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3494:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3495: 
 3496:          assert (isLand == side.sideBnd->segment->isLand);
 3497: 
 3498:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3499:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3500:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3501: 
 3502:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3503:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3504:          
 3505:          side.sideBnd->side = &side;
 3506: 
 3507:       }
 3508:       else {
 3509:          side.sideBnd = nullptr;
 3510:       }
 3511:    }
 3512:    else 
 3513:    {
 3514:       side.sideBnd = nullptr;
 3515:    }
 3516: 
 3517: 
 3518:    // finding the pointer to the elements that share the side
 3519:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3520:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3521: 
 3522:    if (idx_e1 > -1) {
 3523:       const int locidx_e1 = localElemIndices[idx_e1];
 3524:       const int part_e1 =  localElemPart[idx_e1];
 3525:       side.elems[0] = elems[part_e1] + locidx_e1;
 3526: 
 3527:    }
 3528:    else {
 3529:       side.elems[0] = nullptr;
 3530:    }
 3531: 
 3532:    if (idx_e2 > -1) {
 3533:       const int locidx_e2 = localElemIndices[idx_e2];
 3534:       const int part_e2 =  localElemPart[idx_e2];
 3535:       side.elems[1] = elems[part_e2] + locidx_e2;
 3536:    }
 3537:    else {
 3538:       side.elems[1] = nullptr;
 3539:    }
 3540: 
 3541:    // Compute the center of the side
 3542:    side.center = 0.5*(side.n1->p + side.n2->p);
 3543: 
 3544:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3545:    side.shapiro = shapiro0;
 3546: 
 3547: #ifdef GAUSSIAN_HILL_VELOCITIES
 3548: // XXXX
 3549: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3550: constexpr double rot_per=3000.0;
 3551: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3552: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3553: // XXXXX      
 3554: #endif
 3555:    // Compute the z level at the center of the side
 3556:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3557:    
 3558:    // Compute the length of the side
 3559:    const Vector2 vLen = side.n2->p - side.n1->p;
 3560:    side.len = sqrt(dot(vLen, vLen));
 3561: 
 3562: 
 3563:    // Compute the Coriolis coefficient
 3564: 
 3565:    if constexpr(ncor == -1 || ncor == 0) {
 3566:       side.coriolis = coricoef;
 3567:    }
 3568:    else {
 3569:       const double sphi = side.lat();  // Latitude at the center of the side
 3570: 
 3571: // XXXXXX ERROR WHEN use_ll is false??????
 3572:       if constexpr(ics == 1) {
 3573:          // XXXXXXX
 3574:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3575:       }
 3576:       else {
 3577:          side.coriolis = 2.0*omega_e*sin(sphi);
 3578:       }
 3579: 
 3580:    }
 3581: }
 3582: 
 3583: 
 3584: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3585:    double *node_coords, double *node_coords_ll, bool use_ll,
 3586:    double *wind_rotate_angle,   
 3587:    int *isdel, int *isidenode, int *isbnd,
 3588:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3589:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3590:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3591:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3592:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3593:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3594:    double *drag, double *roughness) {
 3595: 
 3596:    ELEM(pelem);
 3597:    Element &elem(*pelem);
 3598:    const int i = idx_elem;
 3599: 
 3600:    elem.idx = i;
 3601: 
 3602:    for (int j = 0; j < i34[i]; j++) {
 3603:       const int idxNode = elnode[i*4 + j];  
 3604:       const int idxSide = elside[i*4 + j];
 3605:       
 3606:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3607:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3608: 
 3609:       // Find the neighboring element  
 3610:       if (elem.sides[j]->elems[0] == &elem) {
 3611:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3612:       }
 3613:       else {
 3614:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3615:       }
 3616:       
 3617:    }
 3618: 
 3619:    elem.i34 = i34[i];
 3620: 
 3621:    // Compute the barycenter of the element and its depth
 3622:    elem.center = {0.0, 0.0};
 3623:    elem.depth = 0.0;
 3624:    for (int j = 0; j < i34[i]; j++) {
 3625: 
 3626:       elem.center += elem.nodes[j]->p/i34[i];
 3627:       elem.depth  += elem.nodes[j]->depth/i34[i];
 3628:    }
 3629: 
 3630: 
 3631:    
 3632:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3633:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3634: 
 3635:    elem.area = elem.computeSignedArea(); 
 3636:    elem.radius = sqrt(elem.area)/pi; 
 3637:    
 3638:    // Determines which way the normal vector to each side is oriented.
 3639:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3640:    for (int j = 0; j < i34[i]; j++)  
 3641:    {
 3642:       elem.ssign[j] = (elem.sides[j]->elems[0] == &elem) ? 1.0 : -1.0;
 3643:        
 3644:    }
 3645: 
 3646:    // Derivatives of shape functions
 3647:    //  For ics=2, this is done inside element/ll frame XXX
 3648:    //  For quads, the derivative is evaluated at centroid
 3649:    for (int j = 0; j < elem.i34; j++) {
 3650:       const double area = elem.area;
 3651:       const int id2 = elem.nxq(1 + j);
 3652:       const int id3 = elem.nxq(2 + j);
 3653:       const int id4 = elem.nxq(3 + j);
 3654:       if (elem.isTri()) {
 3655:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3656:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3657:          // da1/dx = (y1 - y2)/(2*area)
 3658:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3659:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3660:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3661:       }
 3662:       else  { // Quad; evaluate at centroid
 3663:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3664:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3665:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3666:       } // if Tri
 3667: 
 3668:    } // for j   
 3669:    
 3670:    
 3671: 
 3672: }
 3673: 
 3674: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3675:                                             double *emo, double *efa, 
 3676:                                             double *umo, double *ufa, 
 3677:                                             double *vmo, double *vfa) {
 3678: 
 3679: 
 3680:    NODE_BND(nodeBnd);
 3681:    const int idx = idx_node_bnd;    
 3682: 
 3683:    nodeBnd->idx = idx;
 3684: 
 3685:    // Need to find the segment index and the index of the node on the segment
 3686:    int idxNode = -1;
 3687:    int iseg, i;
 3688:    for (iseg = 0; iseg < nope; iseg++) {
 3689:       // for each segment...
 3690:       for (i = 0; i < nond[iseg]; i++) {
 3691:          idxNode = iond[iseg + i*nope];
 3692:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3693:          
 3694:       }
 3695:    }
 3696: 
 3697:    assert(iseg < nope && "iseg is out of bounds");
 3698: 
 3699: found: // Jumped here when the node was found
 3700: 
 3701:    nodeBnd->isEssentialBC = true;
 3702:    nodeBnd->elbc = 0.0;
 3703: 
 3704:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3705: 
 3706:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 3707:       nodeBnd->efa[jfr] = efa[idx2];
 3708:       nodeBnd->emo[jfr] = emo[idx2];
 3709:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3710:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3711: 
 3712:    }
 3713:         
 3714: 
 3715: }
