  797: 
  798: // ----------------------------- Frames -----------------------------
  799: 
  800: // Frames are used to transform vectors between different coordinate systems.
  801: // They are templated in such a way that when ics==1, they have (most likely) no overhead.
  802: template<int ICS>
  803: struct Frame {};
  804: 
  805: template<>
  806: struct Frame<1> {
  807:    __forceinline__ __device__ void update(double, double) {}
  808:    __forceinline__ __device__ Vector3 G2L(Vector3 vi) const { return vi; }
  809:    __forceinline__ __device__ Vector3 L2G(Vector3 vi) const { return vi; }
  810:    __forceinline__ __device__ Vector2 projHorVec(Vector2 v, const Frame<1>&) const { return v; }
  811:    __forceinline__ __device__ Vector3 nUp(void)         const { return {0.0, 0.0, 0.0}; }
  812:    __forceinline__ __device__ Vector3 nZonal(void)      const { return {0.0, 0.0, 0.0}; }
  813:    __forceinline__ __device__ Vector3 nMeridional(void) const { return {0.0, 0.0, 0.0}; }
  814: };
  815: 
  816: template<>
  817: struct Frame<2> {
  818:    // Column 0 (East):  (-sin_lon, cos_lon, 0)              - store 2 values, t20=0 implicit
  819:    // Column 1 (North): Normalized oblate ellipsoid vector  - store 3 values
  820:    // Column 2 (Up):    cross(col0, col1)                   - recomputed on demand
  821:     double t00, t10;        // col0 (t20=0 implicit)
  822:     double t01, t11, t21;   // col1
  823: 
  824:    __device__ void update(double lat, double lon) { // XXX use lat, lon instead of ar1, ar2?
  825: 
  826:       assert(lat >= -pi/2.0 && lat <= pi/2.0 && "GRID: lat out of range");
  827:       assert(lon >= -pi     && lon <= pi     && "GRID: lon out of range");
  828: 
  829:       double sin_lon, cos_lon, sin_lat, cos_lat;
  830:       sincos(lon, &sin_lon, &cos_lon); // These functions are faster than sin(ar1) and cos(ar1).
  831:       sincos(lat, &sin_lat, &cos_lat);
  832: 
  833:       t00 = -sin_lon;
  834:       t10 =  cos_lon;
  835:       t01 = -cos_lon*sin_lat;
  836:       t11 = -sin_lon*sin_lat;
  837:       t21 = (rearth_pole/rearth_eq)*cos_lat;
  838: 
  839:       const double col1_norm = sqrt(t01*t01 + t11*t11 + t21*t21);
  840:       assert (col1_norm != 0.0 && "GRID: col1_norm=0");
  841: 
  842:       const double col1_norm_inv = 1.0/col1_norm;
  843:       t01 = t01*col1_norm_inv;
  844:       t11 = t11*col1_norm_inv;
  845:       t21 = t21*col1_norm_inv;
  846: 
  847:       // The 3rd column (col2) is the cross product of the first two and is computed when needed.
  848: 
  849: 
  850:    }
  851: 
  852:    __forceinline__ __device__ void print(void) const {
  853:       printf("frame = [%.16f, %.16f, %.16f, %.16f, %.16f]\n", t00, t10, t01, t11, t21);
  854:    }
  855: 
  856:    __forceinline__ __device__ void getCol2(double &t02, double &t12, double &t22) const {
  857:       // cross(col0, col1), with t20=0 implicitly:
  858:       // |  i       j       k   |
  859:       // | t00     t10      0   |
  860:       // | t01     t11     t21  |
  861:       t02 =  t10*t21;
  862:       t12 = -t00*t21;
  863:       t22 =  t00*t11 - t10*t01;
  864:    }
  865: 
  866: 
  867:    __forceinline__ __device__ Vector2 projHorVec(Vector2 const &vec0, Frame<2> const &frameout) const {
  868:    // Transforms a horizontal vector from one frame to another and projects it to the new local horizontal plane.
  869:    // Inputs:
  870:    //        vec0: vel. in this frame;
  871:    //        frameout: Output frame;
  872:    // Output: 
  873:    //        vel. in new frame  
  874:    //
  875:    // Projects a horizontal vector from frame 1 (this) to frame 2 (frameout),
  876:    // discarding the z-component of the result to keep only the local horizontal
  877:    // plane of frame 2.
  878:    //
  879:    // Since F1 and F2 are global-to-local rotation matrices, transforming from
  880:    // frame 1 to frame 2 requires F2 * F1^{-1} = F2 * F1^T, as rotation matrices
  881:    // are orthogonal. This product is computed as dot products between columns of
  882:    // F1 and columns of F2, which is equivalent to multiplying rows of F1^T by
  883:    // columns of F2.// 
  884: 
  885:       auto const fo = frameout; // Just an alias for the output frame.
  886:       Vector2 res;
  887: 
  888:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  889:       // of t and fo.t are the same.
  890:       const double d00 = t00*fo.t00 + t10*fo.t10;
  891:       const double d10 = t01*fo.t00 + t11*fo.t10;
  892: 
  893:       const double d01 = t00*fo.t01 + t10*fo.t11;
  894:       const double d11 = t01*fo.t01 + t11*fo.t11 + t21*fo.t21;
  895: 
  896:       res.x = vec0.x * d00 + vec0.y * d10;
  897:       res.y = vec0.x * d01 + vec0.y * d11;
  898: 
  899:       return res;
  900:    }
  901: 
  902:    __forceinline__ __device__ Vector3 G2L(Vector3 const &vi) const {
  903:       Vector3 vo;
  904:       double t02, t12, t22;
  905: 
  906:       // Compute the 3rd column of the frame tensor
  907:       getCol2(t02, t12, t22);
  908: 
  909:       vo.x = vi.x*t00 + vi.y*t10;
  910:       vo.y = vi.x*t01 + vi.y*t11 + vi.z*t21;
  911:       vo.z = vi.x*t02 + vi.y*t12 + vi.z*t22;
  912: 
  913:       return vo;
  914:    
  915:    }
  916: 
  917:    __forceinline__ __device__ Vector3 L2G(Vector3 const &vi) const {
  918:       Vector3 vo;
  919:       double t02, t12, t22;
  920: 
  921:    // Compute the 3rd column of the frame tensor
  922:       getCol2(t02, t12, t22);
  923: 
  924:       // F * vi (non-transposed, so we use rows of F)
  925:       vo.x = vi.x*t00 + vi.y*t01 + vi.z*t02;
  926:       vo.y = vi.x*t10 + vi.y*t11 + vi.z*t12;
  927:       vo.z =            vi.y*t21 + vi.z*t22;  // t20=0 term dropped
  928: 
  929:       return vo;
  930:    }
  931: 
  932:    // Unit vectors that define the local frame
  933:    __forceinline__ __device__ Vector3 nUp(void) const {
  934:       // Column 2 = cross(column0, column1)
  935:       return { t10*t21, -t00*t21, t00*t11 - t10*t01 };
  936:    }
  937: 
  938:    __forceinline__ __device__ Vector3 nZonal(void) const {
  939:       // Column 0
  940:       return { t00, t10, 0.0 };
  941:    }
  942: 
  943:    __forceinline__ __device__ Vector3 nMeridional(void) const {
  944:       // Column 1
  945:       return { t01, t11, t21 };
  946:    }
  947: 
  948: };
