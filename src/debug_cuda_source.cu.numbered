 4478: 
 4479: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 4480:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 4481:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 4482: 
 4483: 
 4484:    NODE(node1);
 4485: 
 4486:    node1->clearMatrixRow();
 4487:    node1->qel = 0.0;
 4488: 
 4489:    // THIS IS FOR STRUCTURES XXX
 4490:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 4491: 
 4492:    
 4493:    for (int j=0; j<node1->numElements; j++) {
 4494:       // For each element connected to the node...
 4495: 
 4496:       Point2 x0, x1, x2, x3; // Local horizontal node positions
 4497: 
 4498:       Element *elem = node1->elements[j];
 4499: 
 4500:       // Compute the average gravity
 4501:       const double grav3 = elem->mean(&Node::grav2);
 4502: 
 4503:       // Look at the documentation for the description of the terms in the following integrals
 4504: 
 4505:       // Integral I_1 
 4506:       // \bar{\breve{H}} 
 4507:       const double hhatb = elem->mean(&Side::hhat);        
 4508: 
 4509:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 4510: 
 4511:       const int id1 = elem->nodeLocalIdx(node1);  // Index of node1 in element->nodes[]
 4512:       const double area = elem->area;
 4513: 
 4514:       // Integral I_4
 4515:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 4516:       // Where
 4517:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 4518: 
 4519:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 4520:       // of U over the element.
 4521:       const Vector2 U = elem->mean(&Side::U);
 4522: 
 4523:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 4524: 
 4525:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 4526:       const double I_4_1 = dot(gradPhi_1, U);
 4527: 
 4528: 
 4529:       // Integral of \nabla\phi_i \cdot \pmb{E}
 4530:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 4531: 
 4532:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 4533: 
 4534: 
 4535:       // Normal component of the bed velocity
 4536:       double ubedNormalComp = 0.0;
 4537:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 4538:          Vector3 ubed = {0.0, 0.0, 0.0};
 4539:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 4540:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 4541: 
 4542:          // Computes a unit vector perpendicular to the bottom face. It is computed as the unit vector parallel to (grad(h), 1)
 4543:          const Vector2 gradDepth = elem->grad2(&Node::depth);
 4544:          const Vector3 N = normalize(toVector3(gradDepth, 1.0));
 4545: 
 4546:          // Computes the normal component of the bed velocity
 4547:          ubedNormalComp = dot(ubed, N);
 4548:       } // imm==2
 4549: 
 4550:       const double fricCoeff = grav3*thetai*(1.0 - thetai)*dt*dt*hhatb;
 4551: 
 4552:       if (elem->isTri()) {
 4553: 
 4554:          // To clarify the notation in this section: 
 4555:          //   In formulas, we use the following notation:
 4556:          //       i stands for the node under consideration (node1)
 4557:          //       j (node2) and k (node3) are the other nodes of the triangle.
 4558:          //   However, in the code, we use the following notation:
 4559:          //       id1 is the node under consideration (node1), id2, id3 are the local indices of the other nodes (node2, node3)
 4560:          const int id2 = elem->nxq(1 + id1);
 4561:          const int id3 = elem->nxq(2 + id1);
 4562:          Node *node2 = elem->nodes[id2];
 4563:          Node *node3 = elem->nodes[id3];
 4564: 
 4565:          elem->getLocalHorizontalNodePositionsTri(x0, x1, x2, id1);
 4566: 
 4567:          // integral of phi_i*phi_j
 4568:          const double ipp_ii = (1.0/6.0 )*area;
 4569:          const double ipp_ij = (1.0/12.0)*area;
 4570:          const double ipp_ik = (1.0/12.0)*area;
 4571: 
 4572:          // integral of [(grad phi_i) * (grad phi_j)]
 4573:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x2-x1, x2-x1);
 4574:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x2-x1, x0-x2);
 4575:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a.c = a.(a+b+c-c) = a.a + a.b
 4576: 
 4577:          // Computes the different components of integral I_1 of each node with respect to node i.
 4578:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4579:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4580:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4581: 
 4582:          node1->addToSparseMatrix(node1, I1_ii);
 4583:          node1->addToSparseMatrix(node2, I1_ij); 
 4584:          node1->addToSparseMatrix(node3, I1_ik);
 4585: 
 4586:          #pragma unroll
 4587:          for (int l=0; l<3; l++) {
 4588: 
 4589:             Node *node = elem->nodes[l];
 4590: 
 4591:             // Additional variation in eta due to bed deformation or vertical velocity
 4592:             double extraEta = 0.0;
 4593:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 4594:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1;
 4595: 
 4596: 
 4597:             const double ipp   = elem->intPhiPhiTri(id1, l);
 4598:             const double igpgp = elem->intGradPhiGradPhiTri(id1, l);
 4599: 
 4600:             const double isElemWet = elem->isDry ? 0.0 : 1.0;  // XXXXX I added this to replicate Fortran's code, but Joseph is going to check if it is needed.
 4601: 
 4602:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp*isElemWet;
 4603:            
 4604:          }
 4605: 
 4606: 
 4607:       }
 4608:       else { // Quad
 4609:          // To clarify the notation in this section: 
 4610:          //   In formulas, we use the following notation:
 4611:          //       i stands for the node under consideration (node1)
 4612:          //       j (node2), k (node3), l (node4) are the other nodes of the quad.
 4613:          //   However, in the code, we use the following notation:
 4614:          //       id1 is the node under consideration (node1), id2, id3, id4 are the local indices of the other nodes (node2, node3, node4)
 4615:          const int id2 = elem->nxq(1 + id1);
 4616:          const int id3 = elem->nxq(2 + id1);
 4617:          const int id4 = elem->nxq(3 + id1);
 4618:          Node *node2 = elem->nodes[id2];
 4619:          Node *node3 = elem->nodes[id3];
 4620:          Node *node4 = elem->nodes[id4];   
 4621:          
 4622:          elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 4623: 
 4624:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 4625:          const double ipp_ii = elem->intPhiPhiQuad(id1, id1, x0, x1, x2, x3);
 4626:          const double ipp_ij = elem->intPhiPhiQuad(id1, id2, x0, x1, x2, x3);
 4627:          const double ipp_ik = elem->intPhiPhiQuad(id1, id3, x0, x1, x2, x3);
 4628:          const double ipp_il = elem->intPhiPhiQuad(id1, id4, x0, x1, x2, x3);
 4629: 
 4630:          // integrals of (grad phi_i) * (grad phi_i), (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 4631:          const double igpgp_ii = elem->intGradPhiGradPhiQuad(id1, id1, x0, x1, x2, x3);
 4632:          const double igpgp_ij = elem->intGradPhiGradPhiQuad(id1, id2, x0, x1, x2, x3);
 4633:          const double igpgp_ik = elem->intGradPhiGradPhiQuad(id1, id3, x0, x1, x2, x3);
 4634:          const double igpgp_il = elem->intGradPhiGradPhiQuad(id1, id4, x0, x1, x2, x3);
 4635: 
 4636: 
 4637:          // Computes the different components of integral I_1 of each node with respect to node i.
 4638:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4639:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4640:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4641:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 4642: 
 4643:          node1->addToSparseMatrix(node1, I1_ii);
 4644:          node1->addToSparseMatrix(node2, I1_ij); 
 4645:          node1->addToSparseMatrix(node3, I1_ik);
 4646:          node1->addToSparseMatrix(node4, I1_il);
 4647:   
 4648:          #pragma unroll
 4649:          for (int l=0; l<4; l++) {
 4650: 
 4651:             const Node *node = elem->nodes[l];
 4652: 
 4653:             // Additional variation in eta due to bed deformation or vertical velocity
 4654:             double extraEta = 0.0;
 4655:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 4656:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1; 
 4657: 
 4658:             const double ipp = elem->intPhiPhiQuad(id1, l, x0, x1, x2, x3);
 4659:             const double igpgp = elem->intGradPhiGradPhiQuad(id1, l, x0, x1, x2, x3);
 4660:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp;
 4661: 
 4662:          }         
 4663:       } 
 4664: 
 4665: 
 4666:      node1->qel += (dt/elem->i34)*elem->vsource;
 4667:       
 4668: 
 4669:    } // for all elements connected to the node
 4670:    
 4671: 
 4672:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 4673:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 4674:    NodeBoundary *nodeBnd = node1->nodeBnd;
 4675:    if (nodeBnd != nullptr && !nodeBnd->isLand) {
 4676:    // If it is an open boundary node...
 4677: 
 4678:    // XXXXX DO THIS MORE NATURALLY IN A SideBnd kernel?
 4679: 
 4680:       // At least one open bnd side, maybe two
 4681:       for (int l=0; l<2; l++) { 
 4682: 
 4683:          // Gets each of the sides sharing the node. 
 4684:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 4685: 
 4686:     
 4687: 
 4688:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 4689:          if (sideBnd != nullptr) {
 4690:             // If the side is on a boundary...
 4691: 
 4692:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 4693: 
 4694:             // Get the boundary segment
 4695:             const BoundarySegment *sideSegment = sideBnd->segment;
 4696:             const Side *side = sideBnd->side;
 4697: 
 4698:             // Integral I_3
 4699:             if (sideSegment->ifltype != 0) {
 4700:             // Natural or Flather b.c.
 4701: 
 4702:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4703:                // especially for Flather b.c.
 4704:                double ri3 = 0.0;
 4705:                if (!side->isDry) {
 4706:                   // If the side is not dry
 4707:                   
 4708:                   // Computes the side flux of (uth, vth)
 4709:                   double Vn = 0.0;
 4710:                   for (int k = side->kb; k < nvrt - 1; k++) {
 4711:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4712:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4713: 
 4714:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 4715:                   }
 4716: 
 4717:                   ri3 = 0.5*side->len*Vn;
 4718:                }
 4719: 
 4720:                if (sideSegment->ifltype == -1) { // Flather 1
 4721: 
 4722:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4723:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4724: 
 4725:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4726:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4727:                   
 4728:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4729:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4730: 
 4731:                } 
 4732:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4733:                   // Reset ri3
 4734:                   ri3 = 0.0;
 4735: 
 4736:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4737:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 4738: 
 4739:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4740: 
 4741:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4742:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4743: 
 4744:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4745:                   node1->addToSparseMatrix(node1, con0*2.0);
 4746:                   node1->addToSparseMatrix(node2, con0);
 4747: 
 4748:                } // if Flather or Discharge
 4749: 
 4750:                node1->qel -= thetai*dt*ri3;  
 4751: 
 4752: 
 4753:             } // I_3
 4754:           
 4755: 
 4756:             // Integral I_5
 4757:             if(!side->isDry) {
 4758: 
 4759:                const double Unbar = dot(side->U, side->n);
 4760:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar; 
 4761: 
 4762:             } // I_5
 4763: 
 4764:          } // if is boundary side
 4765: 
 4766:       } // for l
 4767: 
 4768:    } // if isbnd
 4769: 
 4770: 
 4771: }
 4772: 
 4773: 
