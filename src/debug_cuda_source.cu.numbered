 8580: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 8581:    Node *nodes = mesh->localNodeData;
 8582: 
 8583:    *addr = nodes;
 8584:    *sizeNode = sizeof(Node);
 8585: 
 8586:    switch (varCode) {
 8587:       case (int)VarCode::depth:
 8588:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 8589:          *sizeType = sizeof(double);
 8590:          break;
 8591:       case (int)VarCode::eta:
 8592:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 8593:          *sizeType = sizeof(double);
 8594:          break;
 8595:       case (int)VarCode::x:
 8596:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 8597:          *sizeType = sizeof(Vector2);
 8598:          break;
 8599:       case (int)VarCode::z:
 8600:          *offset = (int)((char*)&nodes[0].z - (char*)nodes);
 8601:          *sizeType = sizeof(double);
 8602:          break;
 8603:       case (int)VarCode::kb:
 8604:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 8605:          *sizeType = sizeof(int);
 8606:          break;
 8607:       case (int)VarCode::isdry:
 8608:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 8609:          *sizeType = sizeof(int);
 8610:          break;         
 8611:       case (int)VarCode::w:
 8612:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 8613:          *sizeType = sizeof(double);
 8614:          break;
 8615:       case (int)VarCode::u:
 8616:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 8617:          *sizeType = sizeof(Vector2);
 8618:          break;  
 8619:       case (int)VarCode::u_air:
 8620:          *offset = (int)((char*)&nodes[0].u_air - (char*)nodes);
 8621:          *sizeType = sizeof(Vector2);
 8622:          break;
 8623:       default:
 8624:          *offset = -1;    
 8625:    }  
 8626:    
 8627: }
