 5100: extern "C" {
 5101: 
 5102:    __global__ void scaleGravity(double loadtide_coef) {
 5103: 
 5104: 
 5105:       NODE(node);
 5106: 
 5107:       // SAL option: scale gravity
 5108:       if constexpr(iloadtide==2) {  // simple const
 5109:          node->grav2 = grav*(1.0 - loadtide_coef);
 5110: 
 5111:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 5112:         
 5113:           const double depth = max(node->depth, 0.0);
 5114:           const double tmp1 = sqrt(depth);
 5115:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 5116:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 5117:                              2.6969e-13*depth*depth*depth*tmp1;
 5118:           
 5119:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 5120:           
 5121: 
 5122: 
 5123:           node->grav2 = grav*(1.0 - beta_bar);
 5124: 
 5125:       } else {  // iloadtide=0,1
 5126:           node->grav2 = grav;
 5127: 
 5128:       }
 5129: 
 5130:    }
 5131: 
 5132: 
 5133:    __global__ void setWinds(double *xWind, double *yWind, double *pressAir) {
 5134:       NODE(node);
 5135: 
 5136:       const int idx = node->idx;
 5137:       Vector2 wind = {xWind[idx], yWind[idx]};
 5138: 
 5139:       if constexpr(nws != 0 && iwindoff != 0) {
 5140:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 5141:       }
 5142: 
 5143:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 5144:       node->setWind(wind);
 5145: 
 5146:       node->pr = pressAir[idx];
 5147:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 5148: 
 5149:    }
