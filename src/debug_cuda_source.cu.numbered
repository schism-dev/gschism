  489: 
  490: __forceinline__ __device__ void computeLatLon(Point3 const &p, double &rlat, double &rlon) {
  491: // Given a 3D global point (may not be on the surface of the Earth), find its longitude and latitude in radians
  492: //
  493: 
  494:    const double radius2 = dot(p, p);
  495:    const double radius = sqrt(radius2);
  496:  
  497:    assert(radius != 0.0      && "computeLatLon: radius = 0");
  498:    assert(p.z*p.z <= radius2 && "computeLatLon: p.z <= radius");
  499: 
  500:    rlon = atan2(p.y, p.x); // (-pi,pi]
  501: 
  502:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  503:       rlat = asin(p.z/radius);
  504:    } else {
  505:       rlat = asin(p.z/rearth_pole);
  506:    }
  507:   
  508: }
  509: 
  510: 
  511: __forceinline__ __device__ Point3 computeXYZfromLatLon(double lat, double lon) {
  512: // Compute the 3D Cartesian coordinates from the latitude and longitude
  513: // Inputs:
  514: //        lat: latitude in radians
  515: //        lon: longitude in radians
  516: // Output:
  517: //        x, y, z: 3D Cartesian coordinates
  518: 
  519:    double sin_lat, cos_lat, sin_lon, cos_lon;
  520: 
  521:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeXYZfromLatLon: lat out of range");
  522:    assert(lon >= -pi     && lon <= pi &&     "computeXYZfromLatLon: lon out of range");
  523: 
  524:    sincos(lat, &sin_lat, &cos_lat);
  525:    sincos(lon, &sin_lon, &cos_lon);
  526: 
  527:    const double x = rearth_eq*cos_lat*cos_lon;
  528:    const double y = rearth_eq*cos_lat*sin_lon;
  529:    const double z = rearth_pole*sin_lat;
  530: 
  531:    return make_double3(x, y, z);
  532: }
  533: 
  534: __inline__ __device__ void Error(const char* msg) {
  535:    printf("Error: %s\n", msg);
  536:    assert(false);
  537: }
