 2167: __inline__ __device__ double  Side::etaMeanBnd(void) const { assert(n1->nodeBnd != nullptr && n2->nodeBnd != nullptr && "etaMeanBnd not assigned"); 
 2168:                                                              return 0.5*(n1->nodeBnd->eta_mean + n2->nodeBnd->eta_mean); }
