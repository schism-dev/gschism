 3578:          const int part_e2 =  localElemPart[idx_e2];
 3579:          side.elems[1] = elems[part_e2] + locidx_e2;
 3580:       }
 3581:       else {
 3582:          side.elems[1] = nullptr;
 3583:       }
 3584: 
 3585:       // Compute the center of the side
 3586:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 3587: 
 3588:       assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3589:       side.shapiro = shapiro0;
 3590: 
 3591: #ifdef GAUSSIAN_HILL_VELOCITIES
 3592: // XXXX
 3593: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3594: constexpr double rot_per=3000.0;
 3595: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3596: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3597: // XXXXX      
 3598: #endif
 3599:       // Compute the z level at the center of the side
 3600:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3601: 
 3602:       // Compute the length of the side
 3603:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 3604:       side.len = sqrt(dot(vLen, vLen));
 3605: 
 3606: 
 3607:       // Compute the Coriolis coefficient
 3608: 
 3609:       if constexpr(ncor == -1 || ncor == 0) {
 3610:          side.coriolis = coricoef;
 3611:       }
 3612:       else {
 3613:          const double sphi = side.lat();  // Latitude at the center of the side
 3614: 
 3615:          if constexpr(ics == 1) {
 3616:             side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3617:          }
 3618:          else {
 3619:             side.coriolis = 2.0*omega_e*sin(sphi);
 3620:          }
 3621:       }
 3622: 
 3623: 
 3624:    }
