 1904: struct Mesh {
 1905:    public:  
 1906: 
 1907:    int partNum; // Partition number for this mesh.
 1908: 
 1909:    // Pointers to each GPU's local memory (size is the number of partitions).
 1910:    Node**    nodes;  
 1911:    Element** elems;  
 1912:    Side**    sides;  
 1913:    
 1914:    // Local memory
 1915:    Node*    localNodeData; 
 1916:    Element* localElemData;
 1917:    Side*    localSideData; 
 1918: 
 1919:    NodeBoundary *localNodeBoundaryMem; // Array of objects with the boundary information of each node
 1920:    SideBoundary *localSideBoundaryMem; // Array of objects with the boundary information of each side
 1921:    double       *coeffMatrixMem;       // Matrix coefficients for neighbors. [0..numNodes-1], doesn't include the diagonal
 1922:    BoundarySegment *localSegmentMem;   // Array of objects with the boundary segments
 1923:    
 1924:    const int npgb;  // Global number of horizontal nodes
 1925:    const int negb;  // Global number of elements
 1926:    const int nsgb;  // Global number of sides
 1927: 
 1928:    const int np;   // Local number of horizontal nodes 
 1929:    const int ne;   // Local number of elements
 1930:    const int ns;   // Local number of sides
 1931: 
 1932:    int nbp;  // Local number of boundary nodes
 1933:    int nbs;  // Local number of boundary sides
 1934: 
 1935:    int nEntries;  // Total number of matrix elements
 1936: 
 1937:    const int max_np; // Maximum number of horizontal nodes per partition (shared by all partitions)
 1938:    const int max_ne; // Maximum number of elements per partition (shared by all partitions)
 1939:    const int max_ns; // Maximum number of sides per partition (shared by all partitions)
 1940: 
 1941:   
 1942:    // Additional topology information
 1943:    Node    **nodeNeighNodes;     // Array of pointers to the nodes neighbors of each node
 1944:    Element **nodeNeighElems;     // Array of pointers to the elements neighbors of each node
 1945:    int16_t *nodePermutationSort; // Array of indices for the array nodes such that neighbors nodes are sorted in increasing order of their global index.
 1946: 
 1947:    BoundarySegment *landBoundarySegment;
 1948:    NodeBoundary *landBoundaryNode;
 1949: 
 1950:    // Vertical coordinate system
 1951:    // Sigma levels
 1952:    double h_s; 
 1953:    double h_c; 
 1954: 
 1955:    double theta_b;
 1956:    double theta_f, sinh_theta_f;
 1957:    double *sigma;  // There is a sigma_local on each node for the case ivcor=1
 1958:    double *ztot;
 1959:    double *cs;
 1960:    double *dcs;
 1961: 
 1962: 
 1963: 
 1964:    __device__ Mesh(int partNum,
 1965:                    int npgb, int negb, int nsgb, 
 1966:                    int np, int ne, int ns,
 1967:                    int max_np, int max_ne, int max_ns, int nseg,
 1968:                    NodeBoundary *plandNodeBndMem, BoundarySegment *plandSegMem,
 1969:                    Node **nodesPtr, Element **elemsPtr, Side **sidesPtr,
 1970:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 1971:                    Node    **localNodeNeighNodesMem,
 1972:                    Element **localNodeNeighElemsMem,
 1973:                    int16_t *localNodePermutationSortMem,
 1974:                    double *partCoeffMatrixMem,
 1975:                    NodeBoundary *localNodeBoundaryMem,
 1976:                    SideBoundary *localSideBoundaryMem,
 1977:                    BoundarySegment *localSegmentMem,
 1978:                    int *kb, double h_c, double h_s, double theta_b, double theta_f, double *sigma, double *ztot,
 1979:                    double *cs, double *dcs
 1980:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 1981:                        np(np), ne(ne), ns(ns),
 1982:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
 1983:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
 1984:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
 1985:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
 1986:                        nodePermutationSort(localNodePermutationSortMem), coeffMatrixMem(partCoeffMatrixMem),
 1987:                        localNodeBoundaryMem(localNodeBoundaryMem), localSideBoundaryMem(localSideBoundaryMem),
 1988:                        localSegmentMem(localSegmentMem),
 1989:                        h_c(h_c), h_s(h_s), theta_b(theta_b), theta_f(theta_f), sigma(sigma), ztot(ztot),
 1990:                        cs(cs), dcs(dcs),
 1991:                        landBoundarySegment(plandSegMem),
 1992:                        landBoundaryNode(plandNodeBndMem)
 1993:    {
 1994:       printf("Mesh constructor for partition %d\n", partNum);
 1995: 
 1996:       printf("npgb = %d, negb = %d, nsgb = %d, nseg = %d\n", npgb, negb, nsgb, nseg);
 1997:       printf("np = %d, ne = %d, ns = %d\n", np, ne, ns);
 1998:       printf("max_np = %d, max_ne = %d, max_ns = %d\n", max_np, max_ne, max_ns);
 1999:  
 2000:       printf("elemsPtr = %p, elems = %p\n", *elems, elemsMem);
 2001:       
 2002:       sinh_theta_f = sinh(theta_f);
 2003: 
 2004:       *landBoundaryNode    = NodeBoundary(true);
 2005:       *landBoundarySegment = BoundarySegment(true);   
 2006: 
 2007:    }
