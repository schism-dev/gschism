 1585: // Helper functions for computing the local node index at a given offset from another.
 1586: __device__ __inline__ int nxq(int offset, int index, int size) {
 1587:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1588:    // to the index to make it positive
 1589:    assert(index + offset + 16*size >= 0);
 1590:    return (index + offset + 16*size) % size;  
 1591: }
 1592: 
 1593: __device__ __inline__ int nxq(int index, int size) {
 1594:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1595:    // to the index to make it positive
 1596:    assert(index + 16*size >= 0);
 1597:    return (index + 16*size) % size; 
 1598: }
