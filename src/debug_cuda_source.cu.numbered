  171: struct Bool4 {
  172:    unsigned int m; // bit i = lane i
  173: 
  174:    __device__ __forceinline__ bool get(int i) const { return (m >> i) & 1u; }
  175:    __device__ __forceinline__ void set(int i, bool v) {m = (m & ~(1u << i)) | ((unsigned int)(v) << i); }
  176: 
  177:    __device__ __forceinline__ bool all(void) const { return m == 0x0F; }
  178:    __device__ __forceinline__ bool any(void) const { return m != 0; }
  179:    __device__ __forceinline__ bool none(void) const { return m == 0; }
  180:    __device__ __forceinline__ int firstOne(void) const { return __ffs(m) - 1; }
  181: 
  182: };
  183: 
  184: __device__ __forceinline__ Bool4 operator!(Bool4 x) { x.m = (~x.m) & 0x0F; return x; }
  185: __device__ __forceinline__ Bool4 operator&(Bool4 a, Bool4 b) { return Bool4{(unsigned int)(a.m & b.m)}; }
  186: __device__ __forceinline__ Bool4 operator|(Bool4 a, Bool4 b) { return Bool4{(unsigned int)(a.m | b.m)}; }
