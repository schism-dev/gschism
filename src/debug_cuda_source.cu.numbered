  517: 
  518: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  519:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  520:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  521: }
  522: 
  523: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  524:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  525:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  526: }
  527: 
  528: 
  529: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  530:    x3 = y1*z2 - y2*z1;
  531:    y3 = x2*z1 - x1*z2;
  532:    z3 = x1*y2 - x2*y1;
  533: // XXXXXX IS THIS REPEATED????
  534: }
  535: 
  536: 
  537: __forceinline__ __device__ void computeLatLon(Point3 const &p, double &rlat, double &rlon) {
  538: // Given a 3D global point (may not be on the surface of the Earth), find its longitude and latitude in radians
  539: //
  540: 
  541:    const double radius2 = dot(p, p);
  542:    const double radius = sqrt(radius2);
  543:  
  544:    assert(radius != 0.0      && "computeLatLon: radius = 0");
  545:    assert(p.z*p.z <= radius2 && "computeLatLon: p.z <= radius");
  546: 
  547:    rlon = atan2(p.y, p.x); // (-pi,pi]
  548: 
  549:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  550:       rlat = asin(p.z/radius);
  551:    } else {
  552:       rlat = asin(p.z/rearth_pole);
  553:    }
  554:   
  555: }
  556: 
  557: 
  558: __forceinline__ __device__ Point3 computeXYZfromLatLon(double lat, double lon) {
  559: // Compute the 3D Cartesian coordinates from the latitude and longitude
  560: // Inputs:
  561: //        lat: latitude in radians
  562: //        lon: longitude in radians
  563: // Output:
  564: //        x, y, z: 3D Cartesian coordinates
  565: 
  566:    double sin_lat, cos_lat, sin_lon, cos_lon;
  567: 
  568:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeXYZfromLatLon: lat out of range");
  569:    assert(lon >= -pi     && lon <= pi &&     "computeXYZfromLatLon: lon out of range");
  570: 
  571:    sincos(lat, &sin_lat, &cos_lat);
  572:    sincos(lon, &sin_lon, &cos_lon);
  573: 
  574:    const double x = rearth_eq*cos_lat*cos_lon;
  575:    const double y = rearth_eq*cos_lat*sin_lon;
  576:    const double z = rearth_pole*sin_lat;
  577: 
  578:    return make_double3(x, y, z);
  579: }
  580: 
  581: __inline__ __device__ void Error(const char* msg) {
  582:    printf("Error: %s\n", msg);
  583:    assert(false);
  584: }
