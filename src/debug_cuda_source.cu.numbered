 2626: /**
 2627:  * This method performs backtracking from the side center until a time -dt back in time 
 2628:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2629:  * intermediate point.
 2630:  *
 2631:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2632:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2633:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2634:  * remaining time.
 2635:  * 
 2636:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2637:  * 
 2638:  * @param uuint, vvint, wwint: Velocities at the final point
 2639:  * @param jlev: Level at which the backtracking is performed
 2640:  * @param dt, dtbk: Tracking timesteps
 2641:  * @return: True if the backtracking was successful, false otherwise
 2642:  */
 2643: __inline__ __device__ bool Side::btrack(
 2644:       int jlev,
 2645:       double dt,            // Tracking time
 2646:       double dtbk,          // Tracking timestep
 2647:       Vector3 &u_int        // Velocities at the initial point
 2648: ) const {
 2649: 
 2650:    // Start from side center
 2651:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2652: double dt0 = dt; // XXXXX
 2653: Point3 x00 = x0;
 2654: const int oriJlev = jlev;
 2655:  
 2656:    double time_rm = dt; // Remaining time
 2657: 
 2658: 
 2659: 
 2660: 
 2661:    // Initial velocities
 2662:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->w2[jlev] + n2->w2[jlev])};
 2663: 
 2664:    // Find the element that is in the direction opposite to the velocity
 2665:    Element* curElem = findElementTowards(toVector2(u_int));
 2666: 
 2667: 
 2668:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2669:    if (curElem == nullptr) {
 2670:       // Make velocity parallel to the side
 2671:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2672:       // u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2673:       curElem = otherElem(curElem);
 2674: 
 2675: 
 2676: // if (curElem == nullptr) { u_int = {0.0, 0.0, 0.0}; return true;}
 2677: // assert(curElem!=nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 2678: // printf("@@@@@@@YYYY@@@@@@@@@ curElem = %p, isDry = %d\n", curElem, curElem->isDry);
 2679:       
 2680:    }
 2681: 
 2682:    if (curElem == nullptr || curElem->isDry) { 
 2683:       // This means that the starting side is shared by dry elements (or one dry and one boundary side).
 2684:       u_int = {0.0, 0.0, 0.0}; 
 2685:       return true;
 2686:    }
 2687: 
 2688:    // Nudges it towards the barycenter
 2689:    curElem->nudgeToBarycenter(toPoint2(x0)); // XXXX Necessary?
 2690: 
 2691: 
 2692:    const int MAX_ITERATIONS = 1000; 
 2693:    Element* nextElem = nullptr;
 2694:    int iter = 0;
 2695: assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 2696:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 2697:    while(true) {
 2698: 
 2699:       // Calculate timestep
 2700:       double dtb = min(dtbk, time_rm);
 2701: if (dtb>0.0 && dtb < 1e-5) {
 2702: printf("@@@@@@@@@@@@@@@4 dtbk = %.17g, time_rm = %.17g\n", dtbk, time_rm);
 2703: assert(false && "dtb < 1e-5");
 2704: }
 2705: 
 2706:       // Next point in the backtracking curve
 2707:       xt = x0 - dtb*u_int;
 2708: 
 2709: double shpCoords[4];
 2710: curElem->computeShapeCoords(toPoint2(xt), shpCoords, false);      
 2711: if (idx == 1149 && oriJlev == 1) printf("$$$$$$$$>>$$$$$@5 elem->idx = %d, dtb = %.17g, time_rm = %.17g  shpCoords = %.17g, %.17g, %.17g, u_int = %.17g, %.17g, %.17g, x0 = %.17g, %.17g, %.17g, xt = %.17g, %.17g, %.17g\n", curElem->idx, dtb, time_rm, shpCoords[0], shpCoords[1], shpCoords[2], u_int.x, u_int.y, u_int.z, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z);      
 2712:       
 2713: if (!curElem->containsPoint(toPoint2(x0))) printf("@@@@@@@@@ iter = %d, x0 = %.17g, %.17g, %.17g, xt = %.17g, %.17g, %.17g, dtbk = %.17g, dtb = %.17g, u_int = %.17g, %.17g, %.17g\n", iter, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z, dtbk, dtb, u_int.x, u_int.y, u_int.z);      
 2714: assert(curElem->containsPoint(toPoint2(x0)) && "YYY Starting point is not inside the element");
 2715:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, time_rm, this);
 2716:       assert(found && "Backtracking failed in btrack");
 2717: 
 2718: 
 2719: if (idx == 1149 && oriJlev == 1) printf("$$$$$$$$##$$$$$@5 dtb = %.17g, time_rm = %.17g, idx = %d\n", dtb, time_rm, curElem->idx);
 2720:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2721:                       // then time_rm needs to be increased by the unused time.
 2722: 
 2723:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0                      
 2724: 
 2725:       // If the velocity is too small, we stop the backtracking
 2726:       const double vmag = length(toVector2(u_int));
 2727:       if (vmag <= velmin_btrack) break;
 2728: 
 2729:       // The current point becomes the next segment's starting point.
 2730:       x0 = xt;
 2731:  
 2732:       curElem = nextElem;
 2733: 
 2734:       iter++;
 2735: if (iter>100) {
 2736:    // if (dtb>0.0 && dtb < 1e-5) {
 2737:    //    printf("@@@@@@@@@@@@@@@4 dtbk = %.17g, time_rm = %.17g\n", dtbk, time_rm);
 2738:    //    assert(false && "dtb < 1e-5");
 2739:    //    }
 2740: printf("@@@@@@@@@@@@@@@@ curElem->idx = %d, nextElem->idx = %d, isdry = %d, n1->idx = %d, n2->idx = %d, iter = %d\n", curElem->idx, nextElem->idx, curElem->isDry, n1->idx, n2->idx, iter);
 2741: printf("@@@@@@@@@@@@@@@2 x0 = %.17g, %.17g, %.17g, xt = %.17g, %.17g, %.17g\n", x0.x, x0.y, x0.z, xt.x, xt.y, xt.z);
 2742: printf("@@@@@@@@@@@@@@@3 dtbk = %.17g, dtb = %.17g, u_int = %.17g, %.17g, %.17g, time_rm = %.17g\n", dtbk, dtb, u_int.x, u_int.y, u_int.z, time_rm);
 2743: }
 2744: if (iter>900) return true;
 2745:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2746:    }
 2747: 
 2748:    // Interpolate the velocities at the final point
 2749:    curElem->interpolateVelocities(xt, u_int);
 2750: 
 2751: 
 2752: if (idx == 1149 && oriJlev == 1) printf("$$$$$$$$EEEE elem->idx = %d, u_int = %.17g, %.17g, %.17g\n", curElem->idx, u_int.x, u_int.y, u_int.z);   
 2753: 
 2754:    // if (jlev==9) addDebugPlot(x00, x00 + dt0*u_int, 0xFFCF00, 'x');  // yellow
 2755:    if (oriJlev==1 ) addDebugPlot(x00, x00 + dt0*u_int, 0x00F0FF, '+');  // green
 2756: 
 2757: 
 2758: }
 2759: 
