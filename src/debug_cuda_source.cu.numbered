 1675:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1676:       // Compute the different time ramps used in the code 
 1677:       // This function is performed by just one thread
 1678: 
 1679:       rampbc = 1.0;
 1680:       if constexpr(ibc == 0) {
 1681:          if (drampbc > 0.0) {
 1682:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1683:          } else {
 1684:             rampbc = 1.0;
 1685:          }
 1686:       }
 1687: 
 1688:       if (nws != 0) {
 1689:          if (drampwind > 0.0) {
 1690:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1691:          } else {
 1692:             rampwind = 1.0;
 1693:          }
 1694:       }
 1695: 
 1696:       if (drampwafo > 0.0) {
 1697:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1698:       } else {
 1699:          rampwafo = 1.0;
 1700:       }
 1701: 
 1702:       // For source/sinks
 1703:       if (if_source && dramp_ss > 0.0) {
 1704:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1705:       } else {
 1706:          ramp_ss = 1.0;
 1707:       }
 1708: 
 1709:       if (dramp > 0.0) {
 1710:          ramp = tanh(2.0*time/86400.0/dramp);
 1711:       } else {
 1712:          ramp = 1.0;
 1713:       }
 1714: 
 1715: 
 1716:    }
