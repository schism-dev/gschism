 7632: __global__ void returnMatrix(double *res) {
 7633:    // Debugging: returns the matrix as a CuPy array
 7634: 
 7635:    const int size = mesh->np;
 7636:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7637:       const Node *node = mesh->localNodeData + idx_node;
 7638:       res[idx_node*size + idx_node] = node->coeffDiag;
 7639:       for (int j = 0; j < node->numNodes; j++) {
 7640:          Node* nbNode = node->nodes[j];
 7641:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7642:       }
 7643: 
 7644:    }
 7645:    
 7646: }
 7647: 
 7648: 
 7649: __global__ void computeMatrixProductAndDotProducts() {
 7650:    // Computes A*p, r'Mr and p'Ap
 7651: 
 7652:    // 1) shared buffer: first half for rMr, second for pAp
 7653:    __shared__ double sdata[2*BLOCK_SIZE];
 7654:    double* s_rMr = sdata;
 7655:    double* s_pAp = sdata + BLOCK_SIZE;
 7656: 
 7657:    const int tid = threadIdx.x;
 7658: 
 7659:    double l_pAp = 0.0;
 7660: 
 7661:    s_rMr[tid] = 0.0;
 7662:    s_pAp[tid] = 0.0;
 7663: 
 7664:    // 2) get your node pointer
 7665:    // NODE(node);   
 7666:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7667:    Node *node = &(mesh->localNodeData[idx_node]); 
 7668:       if (idx_node < mesh->np) {
 7669: 
 7670:       const double diag = node->coeffDiag;
 7671:       const double r    = node->mR;
 7672:       const double p    = node->mP;  
 7673: 
 7674:       // apply preconditioner on the fly:
 7675:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7676: 
 7677:       // 4) compute Ap = A.p
 7678:       double Ap = node->coeffDiag * node->mP;
 7679:       for (int j = 0; j < node->numNodes; ++j) {
 7680:          const Node *nbNode = node->nodes[j];
 7681:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7682: 
 7683:       }
 7684: 
 7685:       node->mAp = Ap;
 7686:       
 7687: 
 7688:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7689:       // const double l_rMr = r*Mr;  // r'Mr
 7690:       l_pAp = p*Ap;  // p'Ap
 7691: 
 7692: 
 7693:    }
 7694: 
 7695:    // 6) write into shared mem
 7696:    // s_rMr[tid] = l_rMr;
 7697:    s_pAp[tid] = l_pAp;
 7698: 
 7699:    __syncthreads();
 7700: 
 7701:    // 7) block-wide tree reduction
 7702:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7703:       if (tid < stride)  {
 7704:          s_pAp[tid] += s_pAp[tid + stride];
 7705:       }
 7706:       __syncthreads();
 7707:    }
 7708: 
 7709:    // 8) thread 0 atomically accumulates into the globals
 7710:    // XXX: This is slower than it needs to be, but it is simple and works
 7711:    if (tid == 0) {
 7712:       atomicAdd(pAp, s_pAp[0]);
 7713:    }
 7714: 
 7715: 
 7716: }
 7717: 
 7718: 
 7719: __global__ void updateSolutionAndDotProducts(void) {
 7720:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7721: 
 7722:    const int tid = threadIdx.x;
 7723: 
 7724:    s_rMr[tid] = 0.0;
 7725: 
 7726:    // get node & bounds-check:
 7727:    NODE(node);
 7728: 
 7729:    
 7730:    // Compute alpha
 7731:    const double alpha = (*rMr_old)/(*pAp); 
 7732: 
 7733: 
 7734:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7735: 
 7736: 
 7737:    // load scalars
 7738:    const double diag = node->coeffDiag;
 7739:    const double p    = node->mP;
 7740:    const double Ap   = node->mAp;
 7741:    const double x    = node->mX;
 7742:    const double r    = node->mR;
 7743:    
 7744:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7745: 
 7746:    // 1) update solution & residual
 7747:    const double x_new = x + alpha*p;
 7748:    const double r_new = r - alpha*Ap;
 7749:    node->mX = x_new;
 7750:    node->mR = r_new;
 7751: 
 7752:    // 2) apply Jacobi preconditioner on the fly
 7753:    const double Mr_new = r_new/diag;
 7754: 
 7755: 
 7756:    // 3) local contributions for the two dot-products
 7757:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7758: 
 7759:    // 4) write into shared-mem
 7760:    s_rMr[tid] = l_rMr;
 7761: 
 7762:    __syncthreads();
 7763: 
 7764: 
 7765:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7766:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7767:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7768:       __syncthreads();
 7769:    }
 7770: 
 7771:    // 6) thread 0 atomically folds into the global accumulators
 7772:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7773: 
 7774: 
 7775: }
 7776: 
 7777: 
 7778: __global__ void updateSearchDirection() {
 7779: 
 7780:     NODE(node);
 7781: 
 7782:     // recompute z on-the-fly
 7783:     const double z = node->mR / node->coeffDiag;
 7784:     const double p = node->mP;
 7785: 
 7786:     const double beta = (*rMr_new)/(*rMr_old);
 7787: 
 7788: 
 7789:     // p =z + beta*p
 7790:     node->mP = z + beta*p;
 7791: 
 7792: }
 7793: 
 7794: __global__ void initializeScalars(double *scalars) {
 7795: 
 7796:    // These point to a cupy array in the host code
 7797:    rMr_old = scalars + 0;
 7798:    rMr_new = scalars + 1;
 7799:    pAp     = scalars + 2;
 7800: }
 7801: 
 7802: __global__ void initializePreconditionedResidual(void) {
 7803: 
 7804:     __shared__ double s_rMr[BLOCK_SIZE];  
 7805: 
 7806:     s_rMr[threadIdx.x] = 0.0;
 7807: 
 7808:     NODE_ALL(node, valid);
 7809:     const int tid = threadIdx.x;
 7810:     // For the first iteration:
 7811:     // 1. Initial solution x = 0 (already set)
 7812:     // 2. Initial residual r = b (stored in qel)
 7813:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7814: 
 7815: // XXX we should use the guess solution here    
 7816: 
 7817:     double l_rMr = 0.0;
 7818:     if (valid) {
 7819:       // Set initial residual r = b (from qel)
 7820:       node->mR = node->qel;
 7821: 
 7822:       // Compute z = M^-1 * r (preconditioned residual)
 7823:       const double z = node->mR / node->coeffDiag;
 7824: 
 7825:       // Set initial search direction p = z
 7826:       node->mP = z;
 7827: 
 7828:       // Initialize other variables needed for CG
 7829:       node->mX = 0.0;  // Initial solution
 7830:       node->mAp = 0.0; // Will be computed in first iteration
 7831: 
 7832: 
 7833:       // Computes the first r'Mr (reduction)
 7834:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7835:     }
 7836:     // 4) write into shared-mem
 7837:     s_rMr[tid] = l_rMr;
 7838: 
 7839:     __syncthreads();
 7840: 
 7841: 
 7842:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7843:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7844:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7845:         __syncthreads();
 7846:     }
 7847: 
 7848:     // 6) thread 0 atomically folds into the global accumulators
 7849:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7850: 
 7851:     *rMr_old = 0.0;
 7852:     *pAp = 0.0;
 7853: }
 7854: 
 7855: 
 7856: 
 7857: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7858:    Element *elems = mesh->localElemData;
 7859: 
 7860:    *addr = elems;
 7861:    *sizeElement = sizeof(Element);
 7862:    switch (varCode) {
 7863:       case (int)VarCode::z:
 7864:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7865:          *sizeType = sizeof(double);
 7866:          break;
 7867:       case (int)VarCode::x:
 7868:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7869:          *sizeType = sizeof(Vector2);
 7870:          break;
 7871:       case (int)VarCode::area:
 7872:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7873:          *sizeType = sizeof(double);
 7874:          break;
 7875:       case (int)VarCode::depth:
 7876:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7877:          *sizeType = sizeof(double);
 7878:          break;
 7879:       case (int)VarCode::radius:
 7880:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7881:          *sizeType = sizeof(double);
 7882:          break;
 7883:       case (int)VarCode::lonlat:
 7884:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 7885:          *sizeType = sizeof(double);
 7886:          break;
 7887:       case (int)VarCode::ghat:
 7888:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7889:          *sizeType = sizeof(Vector2);
 7890:          break;
 7891:       case (int)VarCode::kb:
 7892:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 7893:          *sizeType = sizeof(int);
 7894:          break;
 7895:       case (int)VarCode::isdry:
 7896:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 7897:          *sizeType = sizeof(int);
 7898:          break;            
 7899:       case (int)VarCode::w:
 7900:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 7901:          *sizeType = sizeof(double);
 7902:          break;
 7903:       case (int)VarCode::FaceIndices:
 7904:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 7905:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 7906:          *sizeType = sizeof(Node);
 7907:          break;
 7908:       default:
 7909:          *offset = -1;
 7910:    }
 7911: }
