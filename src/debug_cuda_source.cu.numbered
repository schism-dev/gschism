 4665:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4666: 
 4667:       SIDE(side);
 4668: 
 4669: 
 4670:       side->U = {0.0, 0.0}; 
 4671:          
 4672:       if(side->isDry) return;
 4673: 
 4674:       const Node *node1 = side->n1;
 4675:       const Node *node2 = side->n2;
 4676: 
 4677:       // Vertically integrated velocity U (in ll if ics=2)
 4678:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4679:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  
 4680:       }
 4681: 
 4682:    }
 4683: 
 4684:    __global__ void computeBottomDragVegetation(void) {
 4685:       // UNFINISHED. CHECK THIS:
 4686:       // How many kernels are needed? Why so many for loops?
 4687:       // Is the loop on sides needed?
 4688: 
 4689:       NODE(node);
 4690: 
 4691: 
 4692:       const int    kb      = node->kb;
 4693:       const double htot    = node->htot2(); 
 4694:       const double rough   = node->rough;
 4695: 
 4696:       
 4697:       if (node->isDry) {
 4698:          // Default values for dry nodes
 4699:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4700:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4701: 
 4702:          return;
 4703:        
 4704:       }
 4705: 
 4706:       // Compute bottom drag Cd
 4707:       //--------------------------------
 4708: 
 4709:       // nchi = {-1, 0, 1} is the type of bottom drag.
 4710:       if constexpr(nchi == 1) {
 4711: 
 4712:          bool ltmp = false; // for WBL iteration
 4713: 
 4714:          // Cdmax=-1 !max. Cd at node for this process (info only)
 4715:          // Drag at nodes
 4716:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)   XXXXXXXXXXXX
 4717:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 4718:         
 4719:          const double rough = node->rough;
 4720:         
 4721:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4722:          if (node->rough == 0.0) {
 4723:             node->Cd = 0.0;
 4724: 
 4725:          } else { //roughness >0 
 4726:           
 4727:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 4728:             const double bthick = max(dzb_min, bthick_ori);
 4729: 
 4730:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 4731: 
 4732:             double tmp = 1.0/(2.5*log(bthick/rough));
 4733:             node->Cd = tmp*tmp;
 4734: 
 4735:          } // if rough
 4736: 
 4737: 
 4738:          // RECOVER THIS: XXX
 4739:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 4740:          // Output warning for WBL if iteration didn't converge
 4741: 
 4742: 
 4743:       } // nchi==1
 4744: 
 4745: 
 4746:       //   Bottom stress in m^2/s^2
 4747:       if (node->rho[kb + 1] >= -98.0)
 4748:       {
 4749:          const double mag_u = length(node->u2[kb + 1]);
 4750:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 4751: 
 4752:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4753:          // !sediment erosion: this part needs more documentation
 4754:       }
 4755:     
 4756: 
 4757: 
 4758:       // Compute vegetation parameters
 4759:       //--------------------------------
 4760: 
 4761:       // SAV constants
 4762:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4763:       constexpr double veg_cfpsi = 0.16;
 4764: 
 4765:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4766:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4767: 
 4768:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4769:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4770:          int kbin = 0; // bin index
 4771:          for (int k = kb; k < nvrt; k++) {
 4772:             // Computes node height above the bottom level
 4773:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4774:             assert(false && "Vertical variation of vegetation not implemented");
 4775: 
 4776:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4777:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4778:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4779:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4780:             // } else {
 4781:             //    // Find the bin at which the current vertical level is
 4782:             //    while (kbin<nbins_veg_vert) {
 4783:             //       const double zn = node->z[kbin];
 4784:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4785:             //          break;
 4786:             //       } // if
 4787:             //       kbin++;
 4788:             //    } // while
 4789:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4790: 
 4791:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4792:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4793:                
 4794:             //    // Linear interpolation of the vegetation parameters
 4795:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4796:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4797:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4798:             // } // if rl10
 4799: 
 4800:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4801: 
 4802:          } // for k
 4803: 
 4804: 
 4805:       } else { // Ganthy (iveg==2)
 4806:       //  Modify canopy height, diameter, and density
 4807: 
 4808:          // Make sure there is vegetation on this node
 4809:          if (node->veg_h_unbent > 0.0) {
 4810:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4811: 
 4812:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4813:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4814:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4815: 
 4816:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4817:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4818:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4819:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4820:          } // if veg_h_unbent
 4821: 
 4822:          for (int k = 0; k < nvrt; k++) {
 4823:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4824:          } // for k
 4825:       
 4826: 
 4827:       } // if iveg
 4828:      
 4829: 
 4830:       // Compute vertical mean of veg_alpha3D
 4831:       if (iveg != 0) {
 4832:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4833:          double sum1=0.0;
 4834:          double sum2=0.0;
 4835:          // Integrate over each level under the canopy...
 4836:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 4837:             const double Dz = node->Dz(k);
 4838: 
 4839:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 4840:             sum2 += Dz;
 4841: 
 4842:          } // for k
 4843:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4844:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4845: 
 4846:       } // if iveg
 4847: 
 4848:    }
 4849: 
 4850:    __global__ void computeVegetationAndDragParameters(void) {
 4851:       // Computes the vegetation and drag model parameters:
 4852:       // chi, \tilde\chi, beta, \breve{H}
 4853:       
 4854:       SIDE(side);
 4855: 
 4856:       if (side->isDry) return;
 4857: 
 4858:       const double htot = side->htot2();
 4859:       const int    kb   = side->kb;
 4860: 
 4861:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4862: 
 4863:       const double veg_h     = side->veg_h();
 4864:       const double veg_nv    = side->veg_nv();
 4865:       const double veg_c     = side->veg_c();
 4866:       const double veg_beta  = side->veg_beta;
 4867:       const double veg_alpha = side->veg_alpha_vert_mean();
 4868: 
 4869:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4870:       // Velocity magnitude at the bottom level
 4871:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4872:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4873:       side->chi2 = side->Cd()*vmag1;
 4874:       side->chi  = side->chi2;
 4875:       if constexpr(iveg != 0) {
 4876:          const Node *n1 = side->n1;
 4877:          const Node *n2 = side->n2;
 4878:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4879:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4880:       }
 4881: 
 4882:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4883: 
 4884:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4885:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4886:       double magUa = 0.0;
 4887:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4888:          // 3D wet side with veg...
 4889: 
 4890:          double magUa = 0.0;
 4891:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4892:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4893: 
 4894:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4895:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4896:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4897: 
 4898:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4899:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4900: 
 4901:                // Velocity magnitude at the bottom (l) of the level
 4902:                const double ul = length(side->u2[k]);
 4903: 
 4904:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4905:                magUa += Dz*0.5*(uh + ul);
 4906: 
 4907:             } // if HasVegetation
 4908:          } // for k
 4909:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4910: 
 4911:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4912:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4913:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4914:             const double zCpy = side->zTopCanopy();
 4915:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4916:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4917:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4918:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4919:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4920:          } // if isSubmerged
 4921:       } // if iveg   
 4922: 
 4923:       // Computes the friction modified depth, \breve{H} in notes
 4924:       if (side->is2D()) { // 2D
 4925: 
 4926:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4927:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4928: 
 4929:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4930: 
 4931:          side->hhat = htot*htot/fricH; 
 4932: 
 4933:       } else { // 3D
 4934:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4935: 
 4936:          if constexpr(iveg != 0) {
 4937:             
 4938:             if (side->isSubmerged()) { 
 4939:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4940:                side->hhat -= veg_c*Hhat_alpha;
 4941: 
 4942:             } else { // Emergent
 4943:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4944:             }
 4945:          } // if iveg
 4946: 
 4947:          // Enforce positivity for 3D model
 4948:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4949:       } // if 3D
 4950: 
 4951:    }
 4952: 
 4953: 
 4954: 
 4955:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4956:    // Computes the density gradient between two elements, e1 and e2.
 4957:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4958:    // zero in the direction normal to the side. 
 4959:    // 
 4960:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4961:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4962:    //
 4963:    // Input:
 4964:    //    e1: Element
 4965:    //    e2: Neighbor element (or nullptr if boundary)
 4966:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4967:    //    k: Index of the half-level at which the density is interpolated
 4968:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4969:    // 
 4970:    // Output:
 4971:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4972:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4973: 
 4974:       if (e2 == nullptr || e2->isDry) {
 4975:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4976: 
 4977:          Side *side = e1->sides[j];
 4978:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4979:                  
 4980:          if constexpr(ics == 1) {
 4981:             vec = side->n; // Normal vector to the side
 4982:          } else {
 4983:             // IMPLEMENT THIS XXXXXX
 4984:             // !replace with xel, yel?
 4985:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4986:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4987:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4988:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4989:          } //ics
 4990:                    
 4991:          diffRho = 0.0;
 4992: 
 4993:       } else { //internal and wet
 4994:          if constexpr(ics==1) {
 4995:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4996: 
 4997:             // Vector from e1 to e2
 4998:             vec = e2->center - e1->center;
 4999: 
 5000:          } else { 
 5001:             // IMPLEMENT THIS XXXXXX
 5002:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5003:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5004:             //                   alow(j)=xctr2
 5005:             //                   bdia(j)=yctr2
 5006:          } // ics
 5007: 
 5008:          diffRho = rho2 - e1->demeanedDensity(k);
 5009:       }
 5010: 
 5011:    }
 5012: 
 5013:    __global__ void computeDensityCubicSplines(void) {
 5014:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5015: 
 5016:       ELEM(elem);
 5017: 
 5018:       if (elem->isDry) return;
 5019: 
 5020:       const int kb = elem->kb;
 5021: 
 5022:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5023:       if (elem->is2D()) {
 5024:          // In the 2D case, the density is constant at the prism level. 
 5025:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5026:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5027:       } else { //3D
 5028: 
 5029:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5030:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5031:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5032:          ///// XXXX CHECK INDICES!!!!!
 5033:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5034:       } // 2D/3D
 5035: 
 5036:    }
 5037: } // extern "C"
 5038: 
 5039: 
 5040: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5041: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5042: 
 5043:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5044: 
 5045:    const int kb  = elem->kb;
 5046:    const int kb2 = elem2->kb;
 5047: 
 5048:    // z-coordinate of prism of elem
 5049:    const double zp = elem->z_prism(k);
 5050: 
 5051:    double rho = 0.0;
 5052: 
 5053:    if (elem2->is2D()) {
 5054:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5055: 
 5056:    } else {  // 3D
 5057: 
 5058:       // eta_min may be < zmax
 5059:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5060:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5061: 
 5062:       // (Extrapolate density below bottom, we will fix it later)
 5063:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5064:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5065:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5066:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5067:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5068:    } // 2D/3D
 5069:      
 5070: 
 5071:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5072:    // Now we need to fix it.
 5073:    if (elem->z[k] < elem2->z[kb2]) {
 5074:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5075: 
 5076:       // There are two methods to adjust the density at the bottom of the element.
 5077:       // iunder_deep=0: 
 5078:       const double depth1 = abs(elem->z[kb]); // larger depth
 5079: 
 5080:       if (iunder_deep==0) {
 5081: 
 5082:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5083: 
 5084:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5085: 
 5086:       } else { // iunder_deep != 0
 5087: 
 5088:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5089: 
 5090:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5091: 
 5092:          //   Demeaned density at the same z coordinate as
 5093:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5094:          }
 5095: 
 5096:       } // if iunder_deep
 5097:    } // if elem->z[kb] < elem2->z[kb]
 5098: 
 5099:    return rho;
 5100: }
 5101: 
 5102: 
 5103: extern "C" {
 5104:    __global__ void computeDensityGradient(void) {
 5105: 
 5106:       if constexpr(ibc != 0) return;
 5107: 
 5108:          // Compute the horizontal density gradient at each element.
 5109:       // It works in two steps:
 5110:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5111:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5112:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5113:       //             gradRho.r1 = rho1 - rho0
 5114:       //             gradRho.r2 = rho2 - rho0
 5115:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5116:       // 
 5117:       //  NOTE: We use de-meaned densities.
 5118: 
 5119:       ELEM(elem);
 5120: 
 5121:       if (elem->isDry) return;
 5122: 
 5123:       const int kb  = elem->kb;
 5124:       const int i34 = elem->i34;
 5125: 
 5126:       for (int k = kb + 1; k < nvrt; k++) {
 5127:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5128:          //             gradRho.r1 = rho1 - rho0
 5129:          //             gradRho.r2 = rho2 - rho0
 5130:          int icount = 0;
 5131:          double sumRx = 0.0;
 5132:          double sumRy = 0.0;
 5133:          for (int j1=0; j1<i34; j1++) { 
 5134: 
 5135:             const int j2 = elem->nxq(j1 + 1);
 5136: 
 5137:             // Pairs of consecutive neighbor elements of elem
 5138:             const Element *e1 = elem->nghbElems[j1];
 5139:             const Element *e2 = elem->nghbElems[j2];
 5140: 
 5141:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5142:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5143:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5144: 
 5145:             // Compute the density difference and the vector from elem to e1 and e2
 5146:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5147:             double diffRho1, diffRho2;
 5148:             Vector2 vec1, vec2;
 5149:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5150:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5151: 
 5152:             const double rl1 = length(vec1);
 5153:             const double rl2 = length(vec2);
 5154:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5155: 
 5156:             const double delta = cross(vec1, vec2);
 5157:             const double sintheta = abs(delta)/(rl1*rl2);
 5158: 
 5159:             // To avoid problems, avoid elements with small angle between vectors
 5160:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5161:             const bool validEq = (sintheta > sin_one_deg);
 5162: 
 5163:             if (validEq) {
 5164:                // Solve the system of equations to get the density gradient at elem
 5165:                icount++;
 5166:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5167:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5168:                sumRx += Rx;
 5169:                sumRy += Ry;
 5170:             }
 5171:          } // for j1
 5172: 
 5173:          // Compute the average density gradient at elem
 5174:          if (icount==0) {
 5175:            // Bad mesh quality; bail out with 0 b-cc
 5176:            elem->gradRho[k] = {0.0, 0.0};
 5177:          } else {
 5178:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5179:          }
 5180: 
 5181:       } // for k
 5182: 
 5183:    }
 5184: 
 5185:    __global__ void computeBaroclinicTerm(void) {
 5186:    // Computes the baroclinic term at sides (at half levels).
 5187:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5188:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5189: 
 5190:       if (ibc == 1) return;
 5191: 
 5192:       SIDE(side);
 5193: 
 5194:       if (side->isDry) return;
 5195: 
 5196:       const Element *e1 = side->elems[0];
 5197:       const Element *e2 = side->elems[1];      
 5198:       const int kb = side->kb;
 5199:       
 5200:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5201: 
 5202:       // interpolates vertically the density gradient of the two elements at the half level/
 5203: 
 5204:       int k1 = max(kb, nvrt / 2);
 5205:       int k2 = max(kb, nvrt / 2);
 5206: 
 5207:       // Starts the integration at the surface and goes down to the bottom
 5208:       side->bcc[nvrt-1] = {0.0, 0.0};
 5209:       for (int k = nvrt - 2; k >= kb; k--) {
 5210:       // For each prism level (from surface to bottom)...
 5211: 
 5212:          // For both elements, interpolate density gradient at the side's half level.
 5213:          // The gradient at the side is the average of the gradients at the elements.
 5214:          // w1, w2 are used to take into account boundary sides, with just one element.
 5215:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5216:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5217:          const double wsum = w1 + w2;
 5218:          w1 = w1/wsum;
 5219:          w2 = w2/wsum;
 5220:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5221: 
 5222:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5223:          Vector2 gradRho = {0.0, 0.0};
 5224:          if (e1 != nullptr && k > kb) {
 5225:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5226:             
 5227:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5228:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5229:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5230: printf("###### k1 = %d, side->idx = %d, zc[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, zrat = %.16f\n",
 5231:       k1, side->idx, k, side->zc[k], k1, e1->z[k1], k1 + 1, e1->z[k1 + 1], e1->gradRho[k1].x, e1->gradRho[k1].y, zrat);            
 5232:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5233:          }      
 5234:          if (e2 != nullptr && k > kb) {
 5235:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5236:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5237:             
 5238:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5239:          }
 5240: 
 5241:          if constexpr(ics==2) {
 5242:             assert(false && "Not implemented: ics == 2");
 5243:             // IMPLEMENT THIS XXXXXX
 5244:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5245:             // swild(1)=tmp1
 5246:             // swild(2)=tmp2
 5247:          }
 5248:          
 5249:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5250:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5251:          // CHECK INDICES!!! XXX
 5252:          const double grav3 = side->grav3();
 5253:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5254: 
 5255:       } // for
 5256: 
 5257:    }
 5258: 
 5259: 
 5260: 
 5261:    __global__ void computeHorGradientAtSide(void) {
 5262: 
 5263:       // Compute the horizontal density gradient at each element.
 5264:       // It works in two steps:
 5265:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5266:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5267:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5268:       //             gradRho.r1 = rho1 - rho0
 5269:       //             gradRho.r2 = rho2 - rho0
 5270:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5271:       // 
 5272:       //  NOTE: We use de-meaned densities.
 5273: 
 5274:       SIDE(side);
 5275: 
 5276: // printf("side->isDry: %d\n", side->isDry);
 5277:       if (side->isDry) return;
 5278: 
 5279:       // Computes the gradient of the variables at the side center.
 5280:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5281:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5282:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 5283: 
 5284:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5285:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5286:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5287:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5288: 
 5289: 
 5290:    }
 5291: 
 5292: 
 5293:    __global__ void solveMomentumEquations(double time) {
 5294: 
 5295:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5296:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5297: 
 5298:       SIDE(side);
 5299: 
 5300:       if (side->isDry) 
 5301:       {
 5302:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 5303: 
 5304:          return;
 5305:       }
 5306: 
 5307:       const Node *n1 = side->n1;
 5308:       const Node *n2 = side->n2;
 5309: 
 5310:       const int kb = side->kb;
 5311: 
 5312:       const double veg_h = side->veg_h();
 5313:       const double grav3 = side->grav3();
 5314: 
 5315:       if (side->is2D()) {
 5316:          // Warning: Do not use htot2, which is updated.
 5317:          const double htot = side->htot1();
 5318:          const double hhat = side->hhat;
 5319: 
 5320:          // assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5321: 
 5322:          Vector2 tau2 = {0.0, 0.0};
 5323:           
 5324:          if constexpr(ics==1) {
 5325:             tau2 = side->tau();
 5326: 
 5327:          } else {
 5328:             assert(false && "Not implemented: ics == 2");
 5329:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5330:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5331:             // taux2=(vn1+tt1)*0.5d0
 5332:             // tauy2=(vn2+ss1)*0.5d0
 5333:          } // if ics         
 5334: 
 5335:          // hat_gam has units of m/s
 5336: 
 5337:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5338: 
 5339:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5340:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5341: 
 5342:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5343: 
 5344: 
 5345:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 5346:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 5347: 
 5348:          for (int k = 0; k < nvrt; k++) side->u2[k] = {ux, uy};
 5349: 
 5350:       }
 5351:       else { // 3D
 5352: 
 5353:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5354:          // 
 5355:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5356:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5357:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5358:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5359:          // k+1 and k.
 5360: 
 5361: 
 5362:          const int ndim = nvrt - kb;
 5363:          const double zTopCanopy = side->zTopCanopy();
 5364: 
 5365:          // Initialize the tridiagonal system
 5366:          for (int k = kb + 1; k < nvrt; k++) {
 5367:             
 5368:             const int kin = k - (kb + 1);
 5369: 
 5370:             // Vertical viscosity at the face center
 5371:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); ///XXXXX
 5372:  
 5373:             alow[kin] = 0.0;
 5374:             cupp[kin] = 0.0;
 5375:             bdia[kin] = 0.0;
 5376: 
 5377:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5378:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5379: 
 5380:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5381:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5382:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5383: 
 5384:             // First part: layers k, k+1
 5385:             if (k < nvrt - 1) {
 5386:                              
 5387:                if constexpr(iveg != 0) {
 5388: 
 5389:                   // If there is vegetation at this level...
 5390:                   if (zTopCanopy > side->zc[k]) {
 5391:                      // If the canopy is above the k layer...
 5392:                      
 5393:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5394:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5395:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5396:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5397: 
 5398:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5399:                      const double vmag2 = length(ut2);
 5400:                      const double vmag1 = length(side->u2[k]);
 5401:                      const double vmag = 0.5*(vmag1 + vmag2);
 5402:                      
 5403:                      // Computes the vegetation alpha at the face center
 5404:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5405: 
 5406:                      cff1 += veg_alpha_sd*dt*vmag;
 5407: 
 5408:                   } // if (zTopCanopy
 5409:                } // if iveg
 5410: 
 5411:                const double dzz = side->Dz(k + 1);
 5412:                const double tmp = dt*dfz/dzz;
 5413:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5414: 
 5415:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5416:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5417:             }
 5418: 
 5419: 
 5420:             // Second part: layers k-1, k
 5421:             if (k > kb + 1) {
 5422: 
 5423:                double cff1 = 1.0; //init \bar{c^k}
 5424: 
 5425:                if constexpr(iveg != 0) {
 5426:                   // If there is vegetation at this level...
 5427:                   if (zTopCanopy > side->zc[k-1]) {
 5428:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5429:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5430: 
 5431:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5432: 
 5433:                      const double vmag2 = length(ut2);
 5434:                      const double vmag1 = length(side->u2[k-1]);
 5435:                      const double vmag = 0.5*(vmag1 + vmag2);
 5436: 
 5437:                      // Computes the vegetation alpha at the face center
 5438:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5439:                      cff1 += veg_alpha_sd*dt*vmag;
 5440:                   } // if zTopCanopy
 5441: 
 5442:                } // if iveg
 5443: 
 5444:                const double dzz = side->Dz(k);
 5445:                const double tmp = dt*dfz/dzz;
 5446:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5447: 
 5448:                alow[kin] += cff1*dzz/6.0 - tmp;
 5449:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5450: 
 5451:             } else { // Bottom boundary
 5452:                // This occurs at the bottom, where the bottom drag is applied.
 5453: 
 5454:                bdia[kin] += dt*side->chi2; // XXXX
 5455: 
 5456:             } // if (k > kb + 1)
 5457: 
 5458: 
 5459:          } // for (int k
 5460: 
 5461: 
 5462: 
 5463:          // Computes the RHS.
 5464:          // -----------------
 5465: 
 5466:          //	BC to be imposed at the end.
 5467: 
 5468:          const Vector2 gradETP  = side->gradETP;
 5469:          const Vector2 gradPr   = side->gradPr;
 5470:          const Vector2 gradEta1 = side->gradEta1;
 5471:          const Vector2 gradEta2 = side->gradEta2;
 5472: 
 5473:          const Vector2 *btu = side->btu;
 5474:          const Vector2 *u2  = side->u2;
 5475:          const double coriolis = side->coriolis;
 5476:          const Vector2 *nuGradU = side->nuGradU;
 5477: 
 5478: 
 5479:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5480: 
 5481:          for (int k = kb + 1; k < nvrt; k++) {
 5482:             const int kin = k - kb - 1;
 5483: 
 5484:             const double dz_0 = side->Dz(k);
 5485:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5486: 
 5487:             rrhs[kin] = {0.0, 0.0};
 5488:             double dz = 0.0;
 5489: 
 5490:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5491:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5492:             if (k < nvrt  ) dz += dz_1;
 5493:             if (k > kb + 1) dz += dz_0;
 5494: 
 5495:             // Elevation gradient, atmospheric pressure and tidal potential
 5496:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5497: 
 5498:             // Coriolis, advection, wind stress, and horizontal viscosity
 5499:             if (k < nvrt - 1) {
 5500: 
 5501: 
 5502:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5503:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5504:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5505:                                                 
 5506: 
 5507:                //diff stress tensors 1006
 5508:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5509:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5510:                   assert(false && "Not implemented: itur == 5");
 5511:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5512:                }
 5513: 
 5514:             } else { // k == nvrt - 1 SURFACE
 5515:                Vector2 tau2 = {0.0, 0.0};
 5516:                if constexpr(ics==1) {
 5517:                   tau2 = side->tau();
 5518:       
 5519:                } else {
 5520:                   assert(false && "Not implemented: ics == 2");
 5521:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5522:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5523:                   // taux2=(vn1+tt1)*0.5d0
 5524:                   // tauy2=(vn2+ss1)*0.5d0
 5525:                } // if ics
 5526: 
 5527:                rrhs[kin] += dt*tau2;
 5528: 
 5529:             } // if k<nvrt
 5530: 
 5531:             if (k > kb + 1) {
 5532:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5533:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5534:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5535: 
 5536:                // diff stress tensors 1006
 5537:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5538:                   assert(false && "Not implemented: itur == 5");
 5539:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5540:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5541:                }
 5542: 
 5543:             } // if k>kbs + 1
 5544: 
 5545:             // Baroclinic
 5546:             Vector2 *bcc = side->bcc;
 5547:             if constexpr(ibc == 0) {
 5548:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5549:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5550: 
 5551:             } // if ibc==0
 5552: 
 5553:          } // k=kb + 1,nvrt
 5554: 
 5555: 
 5556:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5557: 
 5558:          for (int k = kb + 1; k < nvrt; k++) {  // YYYYYYYYY can be kb 
 5559:             const int kin = k - kb - 1;
 5560: 
 5561:             // Velocity is always clamped to maximum values
 5562:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5563:          } // k
 5564: 
 5565:       } // if side->is2D()
 5566:       
 5567: 
 5568:       // Impose velocity boundary condition at the bottom
 5569:       if constexpr(imm == 2) { // 3D bed deformation model
 5570:          double dep;
 5571:          Vector2 vel;
 5572: 
 5573:          assert(false && "Not implemented: imm == 2");
 5574:          //update_bdef(time, x0, y0, dep, vel);
 5575:          // side->u2[kb] = vel;
 5576: 
 5577:       } else { // imm = 0 or 1
 5578:          if (side->Cd() == 0.0) {
 5579:             side->u2[kb] = side->u2[kb + 1];
 5580: 
 5581:          } else if (side->is3D()) { // 3D no slip bottom   
 5582:             side->u2[kb] = {0.0, 0.0};
 5583:          }
 5584:           
 5585:       } // if imm
 5586: 
 5587:       // The velocities below the bottom level are set to zero
 5588:       for (int k = 0; k <= kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5589: 
 5590: 
 5591:    }
 5592: 
 5593: 
 5594:    __global__ void applyMomentumBC(void) {
 5595: 
 5596:       SIDE_BND(sideBnd);
 5597: 
 5598:       Side *side = sideBnd->side;
 5599:       const BoundarySegment *segment = sideBnd->segment;
 5600:       const Node *n1 = side->n1;
 5601:       const Node *n2 = side->n2;
 5602: 
 5603:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5604: 
 5605:       const bool isLand = segment->isLand;
 5606:       const int ifltype = segment->ifltype;
 5607: 
 5608:       const int kb = side->kb;
 5609: 
 5610:       if (!isLand && ifltype != 0) {
 5611:          const Vector2 *ubc = sideBnd->ubc;
 5612:   
 5613:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5614:             
 5615:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5616:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5617: 
 5618:             if (ifltype == -1) {
 5619:                // Flather 1
 5620: 
 5621:                const double depth = side->depth();
 5622: 
 5623:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5624: 
 5625:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5626: 
 5627:                side->u2[k] = vnorm*side->n;
 5628: 
 5629:             } else if (ifltype == -2) { // Discharge
 5630: 
 5631:                const double eta1 = side->eta1();
 5632:                const double eta2 = side->eta2();
 5633:                const double htot = side->htot2();
 5634: 
 5635:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5636:                assert(false && "Not implemented: Discharge bc");
 5637:                // const double dischrg = discharge(eta1);
 5638:                const double dischrg = 0.0; // XXX REMOVE
 5639:                
 5640: 
 5641:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5642: 
 5643:                const double vnorm = dischrg*eta2/htot;
 5644: 
 5645:                side->u2[k] = vnorm*side->n;
 5646: 
 5647:             }
 5648:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5649:                const double vnorm = dot(side->u2[k], side->n);
 5650: 
 5651:                double rat;
 5652:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5653:                else              rat = segment->vobc2; // outgoing
 5654: 
 5655:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5656: 
 5657:             }
 5658:             else { // not Flather or 3D radiation
 5659:                side->u2[k] = ubc[k];
 5660: 
 5661:             } // if (segment->ifltype...
 5662: 
 5663:          }
 5664: 
 5665:       }
 5666:       else if (isLand) { // if it is land boundary side
 5667: 
 5668:          if constexpr(islip == 0) { // free slip
 5669: 
 5670:             for (int k = kb; k < nvrt; k++) {
 5671: 
 5672:                const Vector2 t = side->t();
 5673:                const Vector2 n = side->n;
 5674: 
 5675:                double vnorm = 0.0; // for most cases
 5676:                const double vtan = dot(side->u2[k], t);
 5677:                
 5678:                side->u2[k] = vtan*t - vnorm*n;
 5679: 
 5680:             }
 5681: 
 5682:          } else { // no slip
 5683:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5684: 
 5685:          }
 5686:       } // if (side segment type...
 5687: 
 5688:    
 5689: 
 5690:    }
 5691: 
 5692: 
 5693:    __global__ void shapiroFilter1(void) {
 5694:       // First step of the Shapiro filter (normally used if indvel<=0)
 5695:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5696: 
 5697:       SIDE(side);
 5698: 
 5699:       // Only internal wet sides are processed
 5700:       if (side->isDry || !(side->isInternal())) return;
 5701: 
 5702:       const int kb = side->kb;
 5703: 
 5704:       for (int mm = 0; mm < niter_shap; mm++) {
 5705: 
 5706:          for (int k = kb + 1; k < nvrt; k++) {
 5707:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5708:             Vector2 suru = {0.0, 0.0};
 5709: 
 5710:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5711: 
 5712:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5713: 
 5714:                int kin = k;
 5715:                if (!(nSide->isDry)) kin = max(k, kb + 1);
 5716:                
 5717:                if constexpr(ics==1) {
 5718:                   suru += nSide->u2[kin];
 5719: 
 5720:                } else {
 5721:                   assert(false && "Not implemented: ics == 2");
 5722:                   // Vector2 vn1, vn2;
 5723:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5724:                   // suru=suru+vn1;
 5725:                   // surv=surv+vn2;
 5726:                }
 5727:             }
 5728: 
 5729: 
 5730:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5731: 
 5732:          }
 5733:       }
 5734:    }
 5735: 
 5736:    __global__ void shapiroFilter2(void) {
 5737:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5738: 
 5739:       SIDE(side);
 5740: 
 5741:       if (side->isDry || !(side->isInternal())) return;
 5742: 
 5743:       const int kb = side->kb;
 5744: 
 5745:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5746: 
 5747:       if (side->is2D()) {
 5748:          side->u2[kb + 1] = side->bcc[kb + 1];
 5749:          side->u2[kb    ] = side->u2 [nvrt - 1];
 5750: 
 5751:       } else {
 5752:          // 3D
 5753:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5754:          
 5755:       }
 5756: 
 5757:    }
 5758: 
 5759: 
 5760:    __global__ void ul0UpdateZCoords(void) {
 5761:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5762:       
 5763:       NODE(node);      
 5764: 
 5765: 
 5766:       if (node->isDry2()) { 
 5767: 
 5768:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 5769: 
 5770:          if constexpr(ivcor != 1) node->kb = 0;
 5771: 
 5772:       } else {
 5773: 
 5774:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 5775:          node->updateKb();
 5776: 
 5777:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5778: 
 5779:       }
 5780: 
 5781:       // We use the temp.b field to store the previous state of isDry.
 5782:       node->tmp.b = node->isDry;
 5783: 
 5784:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5785:       node->isDry = true;
 5786: 
 5787:    }
 5788: 
 5789:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5790:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5791:    {
 5792:       ELEM(elem);
 5793: 
 5794:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5795: 
 5796:       // All the nodes of a wet element are wet.
 5797:       if (!elem->isDry) {
 5798:          elem->nodes[0]->isDry = false;
 5799:          elem->nodes[1]->isDry = false;
 5800:          elem->nodes[2]->isDry = false;
 5801:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 5802: 
 5803:       }
 5804: 
 5805: 
 5806:       elem->kb = 0;
 5807: 
 5808:       if (elem->isDry) return;
 5809: 
 5810:       // Wet
 5811:       const Node *n1 = elem->nodes[0];
 5812:       const Node *n2 = elem->nodes[1];
 5813:       const Node *n3 = elem->nodes[2];  
 5814:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5815: 
 5816:    //    if(elem->isDry2()) { // XXXX
 5817:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5818:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5819:    //        call parallel_abort(errmsg)
 5820:    //    }
 5821: 
 5822: 
 5823:       // Computes element's kb as the minimum of the nodes' kb.
 5824:       const int kb1 = n1->kb;
 5825:       const int kb2 = n2->kb;
 5826:       const int kb3 = n3->kb;
 5827:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5828: 
 5829: 
 5830:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5831: 
 5832: 
 5833:       // Computes the element z as the mean of the nodes z.
 5834:       for (int k = elem->kb; k < nvrt; k++) {
 5835: 
 5836:          // Compute the element z as the mean of the nodes z.
 5837:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5838:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5839:          elem->z[k] /= elem->i34;
 5840: 
 5841:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5842:       }
 5843:                   
 5844:    }
 5845: 
 5846:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5847:    {
 5848:       NODE(node);
 5849:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5850: 
 5851:       if (it == iths) return;
 5852: 
 5853: 
 5854:       if(!node->isDry && node->tmp.b) { // rewetted
 5855:          for (int k=0; k < nvrt; k++) {
 5856: 
 5857:             Vector3 utmp={0.0, 0.0, 0.0};
 5858: 
 5859:             double ttmp=0.0;
 5860:             double stmp=0.0;
 5861:             int icount=0;
 5862:             for (int j = 0; j < node->numNodes; j++) {
 5863: 
 5864: 
 5865:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5866:                if (!node->isDry) { // all indices extended
 5867:                   icount++;
 5868: 
 5869:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5870:                   utmp += node->uvw2(k);
 5871:                   
 5872:                   ttmp += node->tracers[k].tracer[0]; 
 5873:                   stmp += node->tracers[k].tracer[1]; 
 5874:                }
 5875:             }
 5876: 
 5877:             if(icount > 0) {
 5878:                const double inv_icount = 1.0/icount;
 5879:                node->u2[k]     = {inv_icount*utmp.x, inv_icount*utmp.y};
 5880:                node->w2[k]     = inv_icount*utmp.z;
 5881:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5882:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5883:             }
 5884:          }
 5885:       }
 5886:    }
 5887: 
 5888: 
 5889:    __global__ void ul0UpdateSides(int it, int iths) {
 5890: 
 5891:       SIDE(side);
 5892: 
 5893:       // A side is wet if and only if at least one of its elements is wet.
 5894:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5895:  
 5896:       const Node *n1 = side->n1;
 5897:       const Node *n2 = side->n2;
 5898:      
 5899:       const int kb1 = n1->kb;
 5900:       const int kb2 = n2->kb;
 5901: 
 5902:       side->kb = 0; // dry
 5903: 
 5904:       if (isWet) {
 5905: 
 5906:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5907: 
 5908:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5909: 
 5910:          side->kb = min(kb1, kb2);
 5911: 
 5912:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 5913: 
 5914:          for (int k = side->kb; k < nvrt; k++) {
 5915:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5916: 
 5917:          
 5918:             assert(((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0)) && "Weird side (3)");
 5919: 
 5920:             // Compute velocity for re-wetted sides 
 5921:             if ((it != iths) && (side->isDry && isWet)) {
 5922:             
 5923:                Vector2 utmp={0.0, 0.0};
 5924: 
 5925:                int icount=0;
 5926: 
 5927:                // For all the sides on the two elements that share this side
 5928:                for (int j=0; j < 2; j++) {
 5929:                   const Element *elem = side->elems[j];
 5930:                   if (elem == nullptr) continue;
 5931: 
 5932:                   for (int jj=0; jj < elem->i34; jj++) {
 5933:                      const Side *nSide = elem->sides[jj];
 5934:                      if (nSide->isDry) continue;
 5935: 
 5936:                      icount++;
 5937:                      utmp += nSide->u2[k];                     
 5938:                   }
 5939:                }
 5940:                   
 5941:                assert(icount > 0 && "No wet sides around this side");
 5942:                if (icount > 0)  side->u2[k] = utmp/icount;
 5943:                   
 5944:             } // if ((it != iths) && (side->isDry && isWet))
 5945: 
 5946:          } // for k
 5947: 
 5948:       } // if isWet
 5949:    
 5950:       side->isDry = !isWet;
 5951: 
 5952:    }
 5953: 
 5954: 
 5955:    __global__ void zeroNodalVelocities(void) {
 5956:       NODE(node);
 5957: 
 5958:       for (int k = 0; k < nvrt; k++) {
 5959:          node->u2[k]   = {0.0, 0.0};
 5960:          node->w2[k]   = 0.0;
 5961:          node->utmp[k] = {0.0, 0.0};
 5962:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5963:       }
 5964:    }
 5965: 
 5966:  
 5967: 
 5968:    __global__ void computeNodalVerticalVelocities1(void) {
 5969:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5970:    // Adds the element's vertical velocity times the element's area.
 5971:       ELEM(elem);
 5972: 
 5973:       for (int j = 0; j < elem->i34; j++) {
 5974:          Node *node = elem->nodes[j];
 5975: 
 5976:          for (int k = node->kb; k < nvrt; k++) {
 5977:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 5978:          }
 5979:          atomicAdd(&(node->tmp.d), elem->area);
 5980:       }
 5981:    }
 5982: 
 5983:    __global__ void computeNodalVerticalVelocities2(void) {
 5984:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5985:    // Divides by the total area of the elements sharing the    node.
 5986:       NODE(node);
 5987: 
 5988:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5989:    }
 5990: 
 5991: 
 5992:    __global__ void computeNodalHorizontalVelocities1(void) {
 5993:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 5994:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 5995: 
 5996:       ELEM(elem);
 5997: 
 5998:       const int kb = elem->kb;
 5999:       const bool isTri = elem->isTri();
 6000: 
 6001:       if constexpr(indvel <= 0) {
 6002:          // Assuming discontinoius hvel.
 6003: 
 6004: 
 6005:          if (isTri) { // For triangles
 6006:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6007:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6008: 
 6009:             for (int j = 0; j < 3; j++) {
 6010:                // For every node of the triangle...
 6011:                Node *node = elem->nodes[j];
 6012: 
 6013:                const Side *s1 = elem->sides[j];
 6014:                const Side *s2 = elem->sides[(j + 1) % 3];
 6015:                const Side *s3 = elem->sides[(j + 2) % 3];
 6016: 
 6017:                const int numElements = node->numElements;
 6018:                const double inv_numElements = 1.0/numElements;
 6019: 
 6020:                for (int k = kb; k < nvrt; k++)  {
 6021:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated at the node   
 6022:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 6023:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 6024:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 6025:                   atomicAdd(&(node->utmp[k].x), inv_numElements * u.x);
 6026:                   atomicAdd(&(node->utmp[k].y), inv_numElements * u.y);
 6027: 
 6028:                }
 6029: 
 6030:             }
 6031:          }
 6032:          else { // For quads
 6033:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6034: 
 6035:          }
 6036: 
 6037:       }
 6038:       
 6039:    }
 6040: 
 6041: 
 6042:    __global__ void computeNodalHorizontalVelocities2(void) {
 6043:       NODE(node);
 6044: 
 6045:       for (int k = 0; k < nvrt; k++) {
 6046:          node->u2[k] = node->utmp[k];
 6047:          node->w2[k] = node->w2[k];
 6048:       }
 6049:       
 6050:    }   
 6051: 
 6052:    __global__ void computeNodalHorizontalVelocitiesOLD(void) {
 6053:    // XXXX I'm not sure where I got this function from. 
 6054:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 6055:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 6056:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 6057:    // It uses the utmp array as a temporary array to store the velocities.
 6058: 
 6059:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 6060: 
 6061:       SIDE(side);
 6062: 
 6063:       const int kb = side->kb;
 6064: 
 6065:       Node *n1 = side->n1;
 6066:       Node *n2 = side->n2;
 6067: 
 6068:       for (int k = kb; k < nvrt; k++) {
 6069: 
 6070:          // Cast the u2 vector into a Vector2 
 6071:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&(n1->utmp[k]));
 6072:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&(n2->utmp[k]));
 6073: 
 6074:          n1_u2 = side->u2[k]/n1->numSides;
 6075:          n2_u2 = side->u2[k]/n2->numSides;
 6076: 
 6077:       }
 6078: 
 6079: 
 6080:    }
 6081: 
 6082:    __global__ void resetVelocityOpenBndNodes(void) {
 6083:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6084: 
 6085:       NODE_BND(nodebnd);
 6086: 
 6087:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6088:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }
 6089:       }
 6090: 
 6091:    }
 6092: 
 6093: 
 6094:    __global__ void setVelocityOpenBndNodes(void) {
 6095:    // For open boundary nodes sets their velocity to the imposed values.
 6096: 
 6097:       SIDE_BND(sidebnd);
 6098: 
 6099:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6100:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6101:          // to its segment to the average of the side velocity.
 6102: 
 6103:          for (int k = 0; k < nvrt; k++) {
 6104:             Node *n1 = sidebnd->side->n1;
 6105:             Node *n2 = sidebnd->side->n2;
 6106: 
 6107: 
 6108:             Vector2 n1_u2(n1->u2[k]);
 6109:             Vector2 n2_u2(n2->u2[k]);
 6110: 
 6111:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6112:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6113:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6114:             }
 6115:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6116:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6117:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6118:             }
 6119: 
 6120:          }
 6121: 
 6122:       }
 6123: 
 6124:    }
 6125: 
 6126: 
 6127:    __global__ void computeVerticalVelocity(void) {
 6128:       // Computes the vertical velocity at the (2D) element's centroid.
 6129:       // In this function we will be considering volumetric elements, with side faces and a 
 6130:       // bottom and a top face. We will call them SFs, BF and TF.
 6131:       // It computes the flux coming from BF and the SFs.
 6132:       // If the bed is moving, it takes that into account.
 6133:       // Since water is incompressible, the integral of the velocity times the normal vector
 6134:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6135:       // and the BF is equal to the flux going out from the TF.
 6136:       // TF = - BF - sum(SFs).
 6137:       // It then computes the horizontal velocity at the center of TF.
 6138:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6139:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6140:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6141: 
 6142:       ELEM(elem);
 6143: 
 6144:       if (elem->isDry) return;
 6145: 
 6146:       const int kb = elem->kb;
 6147:       const bool isTri = elem->isTri();
 6148: 
 6149:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6150: 
 6151:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6152:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6153:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6154: 
 6155:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6156: 
 6157:       double area3D;
 6158: 
 6159:       // Bottom face flux
 6160:       double bottomFlux = 0.0;
 6161:       Vector2 u2meanBottom = {0.0, 0.0};
 6162:       const Vector2 gradh = elem->grad2(&Node::depth);
 6163:       if constexpr(imm==2) {
 6164:          Vector3 ubed;
 6165: 
 6166:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6167:          // updateBDEF(ubed);
 6168:      
 6169:          // const double bflux0 = dot(ubed, elem_n1);
 6170: 
 6171:          // elem->w[kb] += ubed.z;
 6172:       }
 6173:       else {
 6174:          Vector2 umean;
 6175:          if constexpr(ics == 1) {
 6176:             u2meanBottom = elem->mean(kb, &Side::u2);
 6177:          }
 6178:          else {
 6179:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6180:          }
 6181: 
 6182:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6183:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6184: 
 6185:          bottomFlux = - dot(gradh, u2meanBottom);
 6186:       } // if imm
 6187: 
 6188:       // Compute w for kb+1 to nvrt-1
 6189:       for (int l = kb; l < nvrt - 1; l++) {
 6190: 
 6191:          // normal vector to the top face of the "volumetric" element (3D)
 6192:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6193: 
 6194:          // Compute the total flux at the sides
 6195:          double sideFlux = 0.0;
 6196:          Vector2 u2top = {0.0, 0.0};
 6197:          for (int j = 0; j < elem->i34; j++) {
 6198:             const Side *side = elem->sides[j];
 6199: 
 6200:             const double sideArea = side->area(l);
 6201:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6202:             const double sign = elem->ssign[j]; 
 6203: 
 6204:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6205:          }
 6206:          
 6207:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6208:          //velocities at the centers of the sides
 6209:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6210: 
 6211:          // The flx at the top ace can be computed from the other flows.
 6212:          const double topFlux = - sideFlux - bottomFlux;
 6213:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6214: 
 6215:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6216: 
 6217:          elem_n1 = elem_n2;
 6218: 
 6219:          bottomFlux = - topFlux;
 6220:       }
 6221:    }  
 6222: 
 6223: 
 6224: 
 6225: 
