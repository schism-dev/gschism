 3441: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 3442:                 double *node_coords, double *node_coords_ll, bool use_ll,
 3443:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 3444:                 int *isdel, int *isidenode, int *isbnd,
 3445:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 3446:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3447:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3448:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3449:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3450:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 3451:                 double *drag, double *roughness,
 3452:                 double *emo, double *efa, 
 3453:                 double *umo, double *ufa, 
 3454:                 double *vmo, double *vfa) {
 3455: 
 3456:    // printf("Populating mesh for partition %d\n", partNum);
 3457: 
 3458:    // XXXXXX THIS function does almost nothing. 
 3459: 
 3460:    nbs = *sharedIdxSideBoundary + 1;
 3461:    nbp = *sharedIdxNodeBoundary + 1;
 3462: 
 3463:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 3464: 
 3465: }
 3466: 
 3467: 
 3468: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3469:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3470:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3471: 
 3472: 
 3473:    NODE(node1);
 3474: 
 3475:    node1->clearMatrixRow();
 3476:    node1->qel = 0.0;
 3477: 
 3478:    // THIS IS FOR STRUCTURES XXX
 3479:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3480: 
 3481:    
 3482:    for (int j=0; j<node1->numElements; j++) {
 3483:       // For each element connected to the node...
 3484: 
 3485:       Element *elem = node1->elements[j];
 3486: 
 3487: 
 3488:       // Compute the average gravity
 3489:       const double grav3 = elem->mean(&Node::grav2);
 3490: 
 3491:       // Look at the documentation for the description of the terms in the following integrals
 3492: 
 3493:       // Integral I_1 
 3494:       // \bar{\breve{H}} 
 3495:       const double hhatb = elem->mean(&Side::hhat);        
 3496: 
 3497:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3498: 
 3499:       const int id1 = elem->nodeLocalIdx(node1); 
 3500:       const double area = elem->area;
 3501: 
 3502:       if (elem->isTri()) {
 3503: 
 3504:          // To clarify the notation in this section: 
 3505:          //   i stands for the node under consideration (node1)
 3506:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3507:          const int id2 = elem->nxq(1 + id1);
 3508:          const int id3 = elem->nxq(2 + id1);
 3509:          Node *node2 = elem->nodes[id2];
 3510:          Node *node3 = elem->nodes[id3];
 3511: 
 3512:          const Point2 x1 = node1->p;
 3513:          const Point2 x2 = node2->p;
 3514:          const Point2 x3 = node3->p;
 3515: 
 3516:          // integral of phi_i*phi_j
 3517:          const double ipp_ii = (1.0/6.0 )*area;
 3518:          const double ipp_ij = (1.0/12.0)*area;
 3519:          const double ipp_ik = (1.0/12.0)*area;
 3520: 
 3521:          // integral of [(grad phi_i) * (grad phi_j)]
 3522:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3523:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3524:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3525: 
 3526:          // Computes the different components of integral I_1 of each node with respect to node i.
 3527:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3528:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3529:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3530: 
 3531:          node1->addToSparseMatrix(node1, I1_ii);
 3532:          node1->addToSparseMatrix(node2, I1_ij); 
 3533:          node1->addToSparseMatrix(node3, I1_ik);
 3534: 
 3535:       }
 3536:       else { // Quad
 3537:          // XXX IMPLEMENT THIS
 3538:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3539: 
 3540:          // To clarify the notation in this section: 
 3541:          //   i stands for the node under consideration (node1)
 3542:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3543:          const int id2 = elem->nxq(1 + id1);
 3544:          const int id3 = elem->nxq(2 + id1);
 3545:          const int id4 = elem->nxq(3 + id1);
 3546:          Node *node2 = elem->nodes[id2];
 3547:          Node *node3 = elem->nodes[id3];
 3548:          Node *node4 = elem->nodes[id4];         
 3549: 
 3550:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3551:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3552:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3553:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3554:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3555: 
 3556:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3557:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3558:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3559:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3560:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3561: 
 3562:          // Computes the different components of integral I_1 of each node with respect to node i.
 3563:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3564:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3565:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3566:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3567: 
 3568:          node1->addToSparseMatrix(node1, I1_ii);
 3569:          node1->addToSparseMatrix(node2, I1_ij); 
 3570:          node1->addToSparseMatrix(node3, I1_ik);
 3571:          node1->addToSparseMatrix(node4, I1_il);
 3572:   
 3573: 
 3574: 
 3575:       
 3576:       } 
 3577: 
 3578:  
 3579:       // Integral I_4
 3580:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3581:       // Where
 3582:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3583: 
 3584:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3585:       // of U over the element.
 3586:       Vector2 Umean = {0.0, 0.0};
 3587:       for (int m=0; m<elem->i34; m++) {      
 3588:          const Side *side = elem->sides[m];
 3589: 
 3590:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3591:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3592:       }
 3593:       Umean = Umean/elem->i34;
 3594: 
 3595:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3596: 
 3597:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3598:       const double I_4_1 = dot(gradPhi_1, Umean);
 3599: 
 3600:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3601:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3602:      
 3603:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3604: 
 3605:       // Additional terms 
 3606:       double vnorm = 0.0;
 3607:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3608:          Vector3 ubed;
 3609:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3610: 
 3611:          Vector3 gradP = {0.0, 0.0, 1.0};
 3612:          for (int m=0; m < elem->i34; m++) {
 3613:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3614:            gradP += toVector3(gradP_2D, 0.0);
 3615:          }   
 3616:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3617:       } // imm==2
 3618: 
 3619:       if (elem->isTri()) {
 3620:          for (int l=0; l<3; l++) {
 3621:             double fac;
 3622: 
 3623:             Node *node = elem->nodes[l];
 3624: 
 3625:             fac = (node == node1) ? 2.0 : 1.0;
 3626:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3627:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3628:            
 3629:          }
 3630: 
 3631: 
 3632:          if (!elem->isDry) {
 3633:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3634: 
 3635:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3636: 
 3637:          }
 3638: 
 3639:       } // isTri
 3640:       else { // isQuad
 3641:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3642:          // for (int l=0; l<4; l++) {
 3643:          //   const Node *node = elem->nodes[l];
 3644: 
 3645:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3646:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3647: 
 3648:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3649:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3650:          // }
 3651: 
 3652:       } // isQuad
 3653: 
 3654: 
 3655:      node1->qel += (dt/elem->i34)*elem->vsource;
 3656:       
 3657: 
 3658:    } // for all elements connected to the node
 3659:    
 3660: 
 3661:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3662:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3663:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3664:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3665:       // If it is an open boundary node...
 3666: 
 3667:       // At least one open bnd side, maybe two
 3668:       for (int l=0; l<2; l++) { 
 3669: 
 3670:          // Gets each of the sides sharing the node. 
 3671:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3672: 
 3673:          // if (sideBnd == nullptr) continue; // Skip if no boundary side
 3674:          
 3675: 
 3676:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3677:          if (sideBnd != nullptr) {
 3678:             // If the side is on a boundary...
 3679: 
 3680:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3681: 
 3682:             // Get the boundary segment
 3683:             const BoundarySegment *sideSegment = sideBnd->segment;
 3684:             const Side *side = sideBnd->side;
 3685: 
 3686:             // Integral I_3
 3687:             if (sideSegment->ifltype != 0) {
 3688:             // Natural or Flather b.c.
 3689: 
 3690:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3691:                // especially for Flather b.c.
 3692:                double ri3 = 0.0;
 3693:                if (!side->isDry) {
 3694:                   // If the side is not dry
 3695:                   
 3696:                   // Computes the side flux of (uth, vth)
 3697:                   double Vn = 0.0;
 3698:                   for (int k = side->kb; k < nvrt - 1; k++) {
 3699:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3700:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3701: 
 3702:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 3703:                   }
 3704: 
 3705:                   ri3 = 0.5*side->len*Vn;
 3706:                }
 3707: 
 3708:                if (sideSegment->ifltype == -1) { // Flather 1
 3709: 
 3710:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3711:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3712: 
 3713:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3714:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3715:                   
 3716:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3717:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3718: 
 3719:                } 
 3720:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3721:                   // Reset ri3
 3722:                   ri3 = 0.0;
 3723: 
 3724:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3725: 
 3726:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3727: 
 3728:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3729:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3730: 
 3731:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3732:                   node1->addToSparseMatrix(node1, con0*2.0);
 3733:                   node1->addToSparseMatrix(node2, con0);
 3734: 
 3735:                } // if Flather or Discharge
 3736: 
 3737:                node1->qel -= thetai*dt*ri3;
 3738: 
 3739: 
 3740:             } // I_3
 3741:           
 3742: 
 3743:             // Integral I_5
 3744:             if(!side->isDry) {
 3745: 
 3746:                const double Unbar = dot(side->U, side->n);
 3747:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3748: 
 3749:             } // I_5
 3750: 
 3751:          } // if is boundary side
 3752: 
 3753:       } // for l
 3754: 
 3755:    } // if isbnd
 3756: 
 3757: 
 3758: }
 3759: 
 3760: 
 3761: 
 3762: extern "C" {
 3763:    __global__ void setupCGSolvers(double* diag_d, double* data_d, double* b_d, 
 3764:                                   float*  diag_f, float*  data_f, float*  b_f, 
 3765:                                   int* indices, int* indptr) {
 3766: 
 3767:       NODE(node);
 3768:       
 3769:       const int idx = node->idx;
 3770:       
 3771:       // Computes the index in the nzz array      
 3772:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 3773: 
 3774: 
 3775:       indptr[idx] = nzzIdx;
 3776:       indices[nzzIdx] = idx;
 3777: 
 3778:       data_d[nzzIdx]    = node->coeffDiag;
 3779:       data_f[nzzIdx]    = (float)node->coeffDiag;
 3780: 
 3781:       diag_d[idx] = 1.0/node->coeffDiag;
 3782:       diag_f[idx] = (float)(1.0/node->coeffDiag);
 3783: 
 3784:       b_d[idx] = node->qel;
 3785:       b_f[idx] = (float)node->qel;
 3786: 
 3787:       for (int k = 0; k < node->numNodes; ++k) {
 3788:          const Node* nb = node->nodes[k];
 3789: 
 3790:          const int j = nb->idx;
 3791: 
 3792:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 3793:          data_f[nzzIdx + k + 1]    = (float)node->coeffMatrix[k];
 3794: 
 3795:          indices[nzzIdx + k + 1] = j;
 3796:       }
 3797: 
 3798: 
 3799:    }
 3800: 
 3801: 
 3802: 
 3803:    __global__ void solverCopyResult(double* x) {
 3804:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 3805:       NODE(node);
 3806:       const int idx = node->idx;
 3807: 
 3808:       node->mX = x[idx];
 3809:    }
 3810: 
 3811: 
 3812:    __global__ void rollUpElevation(void) {
 3813: 
 3814:       NODE(node);
 3815: 
 3816:       node->eta1 = node->eta2;
 3817: 
 3818:    }
 3819: 
 3820: 
 3821:    __global__ void backtrackAllNodes(void) {
 3822: 
 3823:       // max/min # of sub-divisions
 3824:       const int ndelt_max = max(1.0, dt/dtb_min);
 3825:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3826: 
 3827:       // Removed all references to swild98 XXX
 3828:       // swild98=0.d0 !init
 3829: 
 3830: 
 3831:       SIDE(side);
 3832: 
 3833:       const int kb = side->kb;
 3834: 
 3835: 
 3836:       // Initialize btrack velocities to the actual velocities at the side 
 3837:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3838: 
 3839:       if (side->isDry) return;
 3840: 
 3841: 
 3842:       // Checks that at least one element is not dry
 3843:       const Element *elem1 = side->elems[0];
 3844:       const Element *elem2 = side->elems[1];
 3845: 
 3846: 
 3847:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3848:       
 3849:       // XXXXXX
 3850:       // !swild_tmp to store global coord. of the starting side
 3851:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3852:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3853:       // !Use sframe2 
 3854:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3855: 
 3856: 
 3857:       for (int k = kb; k < nvrt; k++) {
 3858:       //  Initialize (xt,yt,zt), nnel and vel.
 3859:       //  For ics=2, the coordinates are in local frames
 3860:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3861: 
 3862: 
 3863:          const int iadvf = side->iadv();  // Advection flag
 3864: 
 3865:          Point3 xt;
 3866:          if constexpr(ics==1) {
 3867:             xt = side->center3D(k); 
 3868:          }
 3869:          else // lat/lon; in side lat/lon frame
 3870:          {
 3871:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3872:          // XXX IMPLEMENT THIS
 3873:       //          xt=0.d0
 3874:       //          yt=0.d0
 3875:       //          !centroid coord. for nudging
 3876:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3877:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3878:          }  // ics
 3879: 
 3880: 
 3881: 
 3882:          // If on land or open boundary...
 3883:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3884:          
 3885:          const double vmag = length(side->u2[k]);
 3886: 
 3887:          if (vmag <= velmin_btrack) {
 3888:             // No activity 
 3889: 
 3890:             side->btu[k] = side->u2[k];
 3891:             
 3892:          } else {  // do btrack
 3893: 
 3894:             // Compute number of sub-divisions based on local gradients 
 3895:             // XXX IS THIS NECESSARY?
 3896:             double suma = 0.0;
 3897:             int icount = 0;
 3898:             for (int ii=0; ii<2; ii++) {
 3899: 
 3900:                const Element *elem = side->elems[ii];
 3901:                  
 3902:                if (elem == nullptr) continue;
 3903: 
 3904:                icount++;
 3905: 
 3906:                // Not strictly along z; in ll frame for ics=2
 3907: 
 3908:                double utmp[4];
 3909:                double vtmp[4];
 3910:                for (int jj = 0; jj < elem->i34; jj++) {
 3911: 
 3912:                   const Node *node = elem->nodes[jj];
 3913: 
 3914:                   if constexpr(ics==1) {
 3915:                      utmp[jj] = node->u2[k].x;
 3916:                      vtmp[jj] = node->u2[k].y;  
 3917:                   } else {
 3918:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3919:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3920:                   }
 3921:                } // for jj
 3922: 
 3923:                const Vector2 grad_u = elem->grad2(utmp); 
 3924:                const Vector2 grad_v = elem->grad2(vtmp);
 3925: 
 3926:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3927:             } // for ii
 3928: 
 3929:             assert(icount > 0 && "Impossible 77");
 3930: 
 3931:             // '4' is somewhat arbitrary
 3932:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3933: 
 3934:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3935:          
 3936: 
 3937:             Vector3 u_int = {0.0, 0.0, 0.0};
 3938: 
 3939:             side->btrack(k, dt, dtbk, u_int);
 3940:             side->btu[k] = toVector2(u_int);
 3941:                
 3942:          } // if vmag (do backtrack)
 3943: 
 3944:       } // for k=kb,nvrt-1
 3945: 
 3946:    }
 3947: 
 3948: } // extern "C"
 3949: 
 3950: template<int nc>
 3951: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3952: 
 3953: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3954: //
 3955: // a,b,c,rhs: input vectors and are not modified by this program.
 3956: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3957: // rhs is the r.h.s.
 3958: // n: actual rank of the system.
 3959: // rows in u() and rhs();
 3960: // u: output with nc columns (transposed to rows)
 3961: // gam: a working array.
 3962: //
 3963: // NOTES:
 3964: // This is a template function that allows for different numbers of columns in the rhs vector.
 3965: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3966: 
 3967:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3968:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3969: 
 3970:    double bet = b[0];
 3971:    if constexpr (nc == 1) {
 3972:       u[0] = rhs[0]/bet;
 3973:    } else {
 3974:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 3975:    }
 3976: 
 3977:    for (int j = 1; j < n; j++) {
 3978:       gam[j] = c[j - 1]/bet;
 3979:       bet = b[j] - a[j]*gam[j];
 3980: 
 3981:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3982: 
 3983:       if constexpr (nc == 1) {
 3984:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3985:       } else {
 3986:          for (int l = 0; l < nc; l++) {
 3987:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 3988:          }
 3989:       }
 3990:    }
 3991: 
 3992:    // Back-substitution
 3993:    for (int j = n - 2; j >= 0; j--) {
 3994:       if constexpr (nc == 1) {
 3995:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 3996:       } else {
 3997:          for (int l = 0; l < nc; l++) {
 3998:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 3999:          }
 4000:       }
 4001:    }
 4002: }
 4003: 
 4004: 
 4005: 
 4006: // Helper function that contains the core algorithm
 4007: template<typename XAccessor, typename YAccessor>
 4008: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4009:                                     double  yp_top, double  yp_bot, 
 4010:                                     CubicSpline &spline) {
 4011:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4012:    // 
 4013:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4014:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4015:    //
 4016:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4017:    // 
 4018:    // Inputs: 
 4019:    //            n: dimension for x etc; # of data pts (>=2);
 4020:    //            getX, getY: functions to access x,y coordinates
 4021:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4022:    //     Output: 
 4023:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4024: 
 4025:    const int n = k2 - k1 + 1;
 4026:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4027: 
 4028:    // Allocate memory for the splines
 4029:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4030:    spline.x   = new double[n];
 4031:    spline.y   = new double[n];
 4032:    spline.yp  = new double[n];
 4033:    spline.ypp = new double[n];
 4034: 
 4035:    for (int k=k1; k<=k2; k++) {
 4036:       spline.x[k] = getX(k);
 4037:       spline.y[k] = getY(k);
 4038:    }
 4039: 
 4040:    // This is to simplify expressions later
 4041:    double *x = spline.x;
 4042:    double *y = spline.y;
 4043: 
 4044:    double *a = nullptr;
 4045:    double *b = nullptr;
 4046:    double *c = nullptr;
 4047:    double *gam = nullptr;
 4048:    double *rhs = nullptr;
 4049:    
 4050: 
 4051:       a = new double[n];   // Lower diagonal
 4052:       b = new double[n];   // Diagonal
 4053:       c = new double[n];   // Upper diagonal
 4054:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4055:       rhs = new double[n]; // Right-hand side
 4056: 
 4057:    for (int k=k1; k<=k2; k++) {
 4058:       if (k == k1) {
 4059:          // Bottom level
 4060:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4061:          b[k] = (x[k+1] - x[k])/3.0;
 4062:          c[k] = b[k]/2.0;
 4063:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4064:       } else if (k == n - 1) {
 4065:          // Top level (surface)
 4066:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4067:          b[k] = (x[k] - x[k-1])/3.0;
 4068:          a[k] = b[k]/2.0;
 4069:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4070:       } else {
 4071:          // Intermediate levels
 4072:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4073:          b[k] = (x[k+1] - x[k-1])/3.0;
 4074:          a[k] = (x[k  ] - x[k-1])/6.0;
 4075:          c[k] = (x[k+1] - x[k  ])/6.0;
 4076:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4077:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4078:       }
 4079:    }
 4080: 
 4081:    // Solve the tridiagonal system
 4082:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4083:    
 4084:    spline.yp[k1] = yp_bot;
 4085:    spline.yp[k2] = yp_top;
 4086: 
 4087:    // Compute rest of 1st derivatives using the splines
 4088:    for (int k=k1+1; k<k2; k++) {
 4089:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4090:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4091:    }
 4092:    
 4093:    delete[] a;
 4094:    delete[] b;
 4095:    delete[] c;
 4096:    delete[] gam;
 4097:    delete[] rhs;
 4098: 
 4099: }
 4100: 
 4101: // Array version
 4102: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4103:                                 double y_top, double y_bot, 
 4104:                                 CubicSpline &spline) {
 4105:    auto getX = [x] (int k) { return x[k]; };
 4106:    auto getY = [y] (int k) { return y[k]; };
 4107:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4108: }
 4109: 
 4110: // Lambda version - allows custom access patterns
 4111: template<typename XFunc, typename YFunc>
 4112: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4113:                                 double y_top, double y_bot,
 4114:                                 CubicSpline &spline) {
 4115:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4116: }
 4117: 
 4118: 
 4119: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 4120: {
 4121:    assert("Not implemented");
 4122: 
 4123:    return 0.0;
 4124: }
