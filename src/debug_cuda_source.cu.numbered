 2137:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 2138:       // Compute the different time ramps used in the code 
 2139:       // This function is performed by just one thread
 2140: 
 2141:       rampbc = 1.0;
 2142:       if constexpr(ibc == 0) {
 2143:          if (drampbc > 0.0) {
 2144:             rampbc = tanh(2.0*time/86400.0/drampbc);
 2145:          } else {
 2146:             rampbc = 1.0;
 2147:          }
 2148:       }
 2149: 
 2150:       if (nws != 0) {
 2151:          if (drampwind > 0.0) {
 2152:             rampwind = tanh(2.0*time/86400.0/drampwind);
 2153:          } else {
 2154:             rampwind = 1.0;
 2155:          }
 2156:       }
 2157: 
 2158:       if (drampwafo > 0.0) {
 2159:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 2160:       } else {
 2161:          rampwafo = 1.0;
 2162:       }
 2163: 
 2164:       // For source/sinks
 2165:       if (if_source && dramp_ss > 0.0) {
 2166:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 2167:       } else {
 2168:          ramp_ss = 1.0;
 2169:       }
 2170: 
 2171:       if (dramp > 0.0) {
 2172:          ramp = tanh(2.0*time/86400.0/dramp);
 2173:       } else {
 2174:          ramp = 1.0;
 2175:       }
 2176: 
 2177: 
 2178:    }
