 2421: 
 2422: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2423: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2424: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2425: // Only when ics == 2, the origin is at the element center.
 2426: 
 2427:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2428: 
 2429:    const Node *node = nodes[idxNode];
 2430: 
 2431:    if constexpr(ics==1) {
 2432:       return node->p;
 2433: 
 2434:    } else {
 2435:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2436: 
 2437:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2438: 
 2439:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2440:    }
 2441: 
 2442: }
 2443: 
 2444: 
 2445: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, 
 2446:                                                                             const Vector3& c, const Frame<ics>& dstFrame, int idx) const {
 2447: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2448: 
 2449:    const int id1 = idx;
 2450:    const int id2 = nxq(1 + id1);
 2451:    const int id3 = nxq(2 + id1);
 2452: 
 2453:    if constexpr(ics==1) {
 2454:       x0 = nodes[id1]->p;
 2455:       x1 = nodes[id2]->p;
 2456:       x2 = nodes[id3]->p;
 2457: 
 2458:    } else {
 2459: 
 2460:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2461:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2462:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2463: 
 2464:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2465:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2466:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2467: 
 2468:    }
 2469: 
 2470: }
 2471: 
 2472: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2473:    getLocalHorizontalNodePositionsTri(x0, x1, x2, {center.x, center.y, centerZ()}, frame, idx);
 2474: }
 2475: 
 2476: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2477:             Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3,
 2478:             const Vector3& c, const Frame<ics>& dstFrame) const {
 2479: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2480: 
 2481:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2482: 
 2483: 
 2484: 
 2485:    if constexpr(ics==1) {
 2486:       x0 = nodes[0]->p;
 2487:       x1 = nodes[1]->p;
 2488:       x2 = nodes[2]->p;  
 2489:       x3 = nodes[3]->p;
 2490: 
 2491:    } else {
 2492: 
 2493:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2494:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2495:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2496:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2497: 
 2498:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2499:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2500:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2501:       x3 = toVector2(dstFrame.G2L(p3 - c));
 2502:    }
 2503: 
 2504: }
 2505: 
 2506: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2507:    Point2& x0, Point2& x1, Point2& x2, Point2& x3) const
 2508: {
 2509:    getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, {center.x, center.y, centerZ()}, frame);
 2510: }
 2511: 
 2512: 
 2513: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2514: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2515: // Returns the normal vector and the area of the element at this level
 2516:    
 2517:    double nx, ny, nz;
 2518: 
 2519:    if (isTri()) {
 2520:       // For triangles...
 2521: 
 2522:       // Indices of the nodes at level k, taking care of not going below the bed
 2523:       const int k0 = max(k, nodes[0]->kb);
 2524:       const int k1 = max(k, nodes[1]->kb);
 2525:       const int k2 = max(k, nodes[2]->kb);
 2526: 
 2527:       // Gets the element frame coordinates of the nodes at level k
 2528:       Point3 x0, x1, x2;
 2529:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2530:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2531:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2532:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2533: 
 2534:       } else {  // ics == 2
 2535:          Point2 h0, h1, h2;
 2536: 
 2537:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2538: 
 2539:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2540:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2541:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2542:       }
 2543: 
 2544:       const Vector3 n20 = x2 - x0;
 2545:       const Vector3 n10 = x1 - x0; 
 2546: 
 2547:       // Computes the cross product of vectors n20 and n10. 
 2548:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2549:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2550:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2551: 
 2552:   
 2553:    }
 2554:    else {
 2555:       // For quads...
 2556:       Point2 h0, h1, h2, h3;
 2557: 
 2558:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2559: 
 2560:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2561:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2562:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k] - nodes[0]->z[k]);
 2563:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k] - nodes[1]->z[k]);
 2564: 
 2565:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2566:       nx = n20.y*n31.z - n20.z*n31.y;
 2567:       ny = n20.z*n31.x - n20.x*n31.z;
 2568:       nz = n20.x*n31.y - n20.y*n31.x;
 2569: 
 2570:    }
 2571: 
 2572:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2573:    area3D = 0.5*len;
 2574: 
 2575:    const double inv_len = 1.0/len;
 2576: 
 2577:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2578: 
 2579: }
 2580: 
 2581: 
 2582: // Helper functions to get the 2D local node position for the Celestial walk
 2583: __device__ __forceinline__ Point2 Element::getLocalNodePosition(int idx, const Side* origSide) const {
 2584:    const int idx2 = (isTri() && idx == 3) ? 2 : idx;
 2585:    const Node *node = getNodeInOrder(idx2);
 2586: 
 2587:    double z = 0.0;
 2588:    if constexpr(ics == 2) z = node->gz;
 2589:    
 2590:    Point3 p = toPoint3(node->p, z);
 2591: 
 2592:    return toPoint2(origSide->toLocalFrame(p));
 2593: }
 2594: 
 2595: __device__ __forceinline__ Node *Element::getNodeInOrder(int idx) const {
 2596:    return (ssign[idx] > 0) ? sides[idx]->n1 : sides[idx]->n2;
 2597: }
 2598: 
 2599: __device__ __forceinline__ void Element::computePredicates(const Point2 x0, const Point2& xt, double &fac, const Side* origSide,
 2600:                                 Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector, int jlev) const
 2601: // Computes the three per-side predicates needed for the celestial walk
 2602: // (Kuijper, Ermolaev, Devillers, JCGT 7(3), 2018, arXiv:1710.01620).
 2603: //
 2604: // xt is in local frame coordinates for origSide if ics == 2.
 2605: //
 2606: // All work is done unconditionally on 4 sides to keep CUDA threads uniform.
 2607: // For triangles, side 3 is a sentinel: getNode(3) returns getNode(2), making
 2608: // corners[3] == corners[2] and s3 == (0, 0). Predicates that would be
 2609: // meaningless on triangles are masked to a safe value (see comments below).
 2610: {
 2611:    // Project all 4 corner positions once into the local 2D frame.
 2612:    // For triangles, C[3] == C[2] (no garbage, but geometrically degenerate).
 2613:    // getLocalNodePosition only transforms/projects if ics == 2.
 2614:    const Point2 C[4] = {getLocalNodePosition(0, origSide), 
 2615:                         getLocalNodePosition(1, origSide), 
 2616:                         getLocalNodePosition(2, origSide), 
 2617:                         getLocalNodePosition(3, origSide)};
 2618: 
 2619:    // Computes the maximum distance from the starting point to the farthest element node projected on the segment x0xt.
 2620:    // This has nothing to do with the original celestial walk. It is used in the Leaded Celestial 
 2621:    //Walk algorithm to find a point on the segment x0xt that is as close as possible to the starting point,
 2622:    // But still farther towards the target point from the current point.
 2623:    const Vector2 vt0 = xt - x0;
 2624:    double maxProjDist = max(dot(vt0, C[0] - x0), dot(vt0, C[1] - x0));
 2625:    maxProjDist = max(maxProjDist, dot(vt0, C[2] - x0)); 
 2626:    maxProjDist = isQuad() ? max(maxProjDist, dot(vt0, C[3] - x0)) : maxProjDist;
 2627: 
 2628:    fac = max(1.00001*fac, min(1.0, (maxProjDist/dot(vt0, vt0))*1.00001));
 2629:    const Vector2 ixt = x0 + (xt - x0)*fac;
 2630: 
 2631: 
 2632: // if (origSide->idx == 2860848 && jlev == 46) {
 2633: // showPoints(toPoint3(x0,0.0), toPoint3(xt,0.0), jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2634: // showPoints(toPoint3(ixt,0.0), toPoint3(ixt,0.0), jlev, origSide, 0x00FF00u, 'o', 1, 0, 0);
 2635: // printf("this->idx = %d, origSide->idx = %d, ixt = (%.17f, %.17f), x0 = (%.17f, %.17f), xt = (%.17f, %.17f), fac = %.17f\n", this->idx, origSide->idx, ixt.x, ixt.y, x0.x, x0.y, xt.x, xt.y, fac);
 2636: // }
 2637:    // Side I goes from corners[I] to corners[nxq(I+1)] in CCW perimeter order.
 2638:    // (Note: with corners built from getNode in CCW order, no ssign factor is needed
 2639:    //  here the orientation is baked into the corners array.)
 2640:    const int i3 = nxq(3);
 2641:    const Vector2 s0 = C[ 1] - C[ 0];
 2642:    const Vector2 s1 = C[ 2] - C[ 1];
 2643:    const Vector2 s2 = C[i3] - C[ 2];
 2644:    const Vector2 s3 = C[ 0] - C[i3];
 2645:    
 2646:    // Side I goes from C[I] to C[nxq(I+1)] in CCW perimeter order.
 2647:    // The corners array is built from getNode in CCW order, so the orientation
 2648:    // is already correct and no ssign factor is needed in the formulas below.
 2649:    //
 2650:    // i3 = nxq(3): the index of the corner after side 2.
 2651:    //   Triangle: i3 == 0 (the closing corner of the triangle).
 2652:    //   Quad:     i3 == 3.
 2653:    //
 2654:    // The four side direction vectors. For triangles, s3 == (0, 0) since
 2655:    // C[i3] == C[0] (the perimeter has already closed by side 2).
 2656:    isLeft.set(0,  cross(s0, ixt - C[ 0]) > -small);
 2657:    isLeft.set(1,  cross(s1, ixt - C[ 1]) > -small);
 2658:    isLeft.set(2,  cross(s2, ixt - C[ 2]) > -small);
 2659:    isLeft.set(3, (cross(s3, ixt - C[i3]) > -small) || isTri());  
 2660: 
 2661: // printf("idx = %d, cross(s0, xt - C[ 0] ) = %.17f, cross(s1, xt - C[ 1] ) = %.17f, cross(s2, xt - C[ 2] ) = %.17f, cross(s3, xt - C[i3] ) = %.17f\n", idx, cross(s0, xt - C[ 0] ), cross(s1, xt - C[ 1] ), cross(s2, xt - C[ 2] ), cross(s3, xt - C[i3] ));
 2662: 
 2663:    // For triangles, the corner after side 2 is the closing corner where
 2664:    // side 2 meets side 0 (not side 3, which doesn't exist). The "next side
 2665:    // tangent" used by isObtuse and isBisector at that corner is therefore
 2666:    // s0 for triangles, s3 for quads.
 2667:    const Vector2 s3_tri = isTri() ? s0 : s3;
 2668: 
 2669:    // isObtuse.b[I]: true iff the internal face angle at the corner after
 2670:    // side I is obtuse. Equivalent to dot of consecutive side directions > 0
 2671:    // (acute "turn angle" along the perimeter = obtuse internal angle).
 2672:    //
 2673:    // isObtuse.b[3] for triangles: dot(s3, s0) = dot(0, s0) = 0, so the
 2674:    // result is false naturally. No sentinel needed.
 2675:    isObtuse.set(0, dot(s0, s1) > 0.0);
 2676:    isObtuse.set(1, dot(s1, s2) > 0.0);
 2677:    isObtuse.set(2, dot(s2, s3_tri) > 0.0);  // triangle: closes back to s0
 2678:    isObtuse.set(3, dot(s3, s0) > 0.0);  // Always false for triangles (s3=(0,0))
 2679: 
 2680:    // isBisector.b[I]: at the corner after side I, this tests whether xt is
 2681:    // on the "exit through side I" half of the corner cone, separated by the
 2682:    // approximate angular bisector of the celestial walk. The bisector is
 2683:    // perpendicular to the chord across the corner; the test is the sign of
 2684:    // (xt - corner_vertex) projected onto that chord.
 2685:    //
 2686:    // isBisector.b[3] is always masked out by isLeft.b[3] = true for triangles
 2687:    // (the validity rule sets valid_3 = false), so its computed value for
 2688:    // triangles doesn't matter. No sentinel needed.
 2689:    isBisector.set(0, dot(ixt - C[ 1], s0 + s1) < 0.0);
 2690:    isBisector.set(1, dot(ixt - C[ 2], s1 + s2) < 0.0);
 2691:    isBisector.set(2, dot(ixt - C[i3], s2 + s3_tri) < 0.0);
 2692:    isBisector.set(3, dot(ixt - C[ 0], s3 + s0) < 0.0);   
 2693: 
 2694: }
 2695: 
 2696: 
 2697: __inline__ __device__ double Element::computeSignedArea(void) const {
 2698:    // Compute the area of the element
 2699: 
 2700:    Point2 x0, x1, x2, x3;
 2701:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2702: 
 2703: 
 2704:    double res = signedArea(x0, x1, x2);
 2705: 
 2706:    // In the quad case we need to add the area of the other triangle.
 2707:    if (isQuad()) {
 2708:       x3 = getLocalHorizontalNodePosition(3);
 2709:       double ar1 = signedArea(x0, x2, x3);
 2710:       double ar2 = signedArea(x0, x1, x3);
 2711:       double ar3 = signedArea(x1, x2, x3);
 2712:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2713: 
 2714:       res += ar1;
 2715: 
 2716:    }
 2717: 
 2718:    return res;
 2719: }
 2720: 
 2721: 
 2722: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2723:                                                                 (nodes[1]->isDry2()) ||
 2724:                                                                 (nodes[2]->isDry2()) ||
 2725:                                                                 (isQuad() && nodes[3]->isDry2());
 2726: }
 2727: 
 2728: __inline__ __device__ double Element::detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2729:    return (1.0/8.0)*((x1.x - x0.x)*(x2.y - x3.y) - (x2.x - x3.x)*(x1.y - x0.y));
 2730: }
 2731: 
 2732: __inline__ __device__ double Element::detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2733:    return (1.0/8.0)*((x2.x - x1.x)*(x3.y - x0.y) - (x3.x - x0.x)*(x2.y - x1.y));
 2734: }
