 3474: //    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 3475: //    If true, (xIntersect,yIntersect) is the intersection.				
 3476: //    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 3477: // **/
 3478: // __inline__ __device__ bool Element::findPathIntersection(double x1, double y1, double x2, double y2, 
 3479: //                                                          Side& intersectingSide, Element& nextElement,
