  598: // ----------------------------- Turbulence -----------------------------
  599: 
  600: 
  601: 
  602: constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
  603: constexpr double veg_cfpsi = 0.16;
  604: 
  605: 
  606: template<TurbulenceModel Model>
  607: struct Turbulence {};   
  608: 
  609: // GLS turbulence model
  610: template<>
  611: struct Turbulence<TurbulenceModel::GLS> {
  612:    using enum TurbulenceSubmodel;
  613:    using enum StabilityModel;
  614: 
  615:    double tke[nvrt];    // TKE
  616:    double mxl[nvrt];    // mixing length for GLS
  617:    double nu_tke[nvrt]; // Vertical diffusivity for TKE 
  618:    double nu_phi[nvrt]; // Vertical diffusivity for generic length scale variable (phi)
  619: 
  620:    double diffmin;  // from diffmin.gr3
  621:    double diffmax;  // from diffmax.gr3
  622:    
  623:    
  624: 
  625:    __device__ __forceinline__ constexpr double cpsi1() const {
  626:       if      constexpr (turbSubmodel == MellorYamada)   return 0.9;
  627:       else if constexpr (turbSubmodel == KL)             return 0.9;
  628:       else if constexpr (turbSubmodel == KE)             return 1.44;
  629:       else if constexpr (turbSubmodel == KW)             return 0.555;
  630:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.0;
  631:       else { assert(false && "unknown submodel"); return 0.0; }
  632:    }
  633: 
  634:    
  635:    __device__ __forceinline__ constexpr double cpsi2() const {
  636:       // Returns coefficient cpsi2 for the dissipation term in the GLS turbulence model
  637:       if      constexpr (turbSubmodel == MellorYamada)   return 0.5;
  638:       else if constexpr (turbSubmodel == KL)             return 0.5;
  639:       else if constexpr (turbSubmodel == KE)             return 1.92;
  640:       else if constexpr (turbSubmodel == KW)             return 0.833;
  641:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.22;
  642:       else { assert(false && "unknown submodel"); return 0.0; }
  643:    }
  644: 
  645: 
  646:    __device__ __forceinline__ double Fwall(Node *node, int k, double mxl_c) const;
  647: 
  648:    __device__ __forceinline__ double cpsi3(double N2) const {
  649: 
  650:       // Returns coefficient cpsi3 for the buoyancy production/dissipation term in the GLS turbulence model
  651:       // Remember that N2 is the signed square of the Brunt-Väisälä frequency
  652: 
  653:       if constexpr(icompute_cpsi3 != 0) { assert(false && "compute_cpsi3 not implemented for icompute_cpsi3!=0"); return 0.0; }
  654: 
  655:       if constexpr (turbSubmodel == MellorYamada) {
  656:          return 0.9;   
  657: 
  658:       } else { // Other GLS submodels
  659: 
  660: 
  661:          if (N2 > 0.0) { // unstable (inverse stratification)
  662:             return 1.0;   
  663: 
  664:          } else { // stable (regular stratification)
  665: 
  666:             if      constexpr (turbSubmodel == KL)             return 2.53;
  667:             else if constexpr (turbSubmodel == KE)             return -0.52;
  668:             else if constexpr (turbSubmodel == KW)             return -0.58;
  669:             else if constexpr (turbSubmodel == UmlaufBurchard) return  0.1;
  670:             else { assert(false && "unknown submodel"); return 0.0; }
  671:          }
  672: 
  673:       } //if constexpr (turbSubmodel == TurbulenceSubmodel::MY)
  674: 
  675:    }
  676: 
  677:    
  678:    __device__ __forceinline__ constexpr double rpub(void) const {
  679:       if      constexpr (turbSubmodel == MellorYamada)   return  0.0;
  680:       else if constexpr (turbSubmodel == KL)             return  0.0;
  681:       else if constexpr (turbSubmodel == KE)             return  3.0;
  682:       else if constexpr (turbSubmodel == KW)             return -1.0;
  683:       else if constexpr (turbSubmodel == UmlaufBurchard) return  2.0;
  684:       else { assert(false && "unknown submodel"); return 0.0; }
  685:    }
  686: 
  687: 
  688:    __device__ __forceinline__ constexpr double rmub(void) const {
  689:       if      constexpr (turbSubmodel == MellorYamada)   return 1.0;
  690:       else if constexpr (turbSubmodel == KL)             return 1.0;
  691:       else if constexpr (turbSubmodel == KE)             return 1.5;
  692:       else if constexpr (turbSubmodel == KW)             return 0.5;
  693:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.0;
  694:       else { assert(false && "unknown submodel"); return 0.0; }
  695:    }
  696: 
  697: 
  698:    __device__ __forceinline__ constexpr double rnub(void) const {
  699:       if      constexpr (turbSubmodel == MellorYamada)   return  1.0;
  700:       else if constexpr (turbSubmodel == KL)             return  1.0;
  701:       else if constexpr (turbSubmodel == KE)             return -1.0;
  702:       else if constexpr (turbSubmodel == KW)             return -1.0;
  703:       else if constexpr (turbSubmodel == UmlaufBurchard) return -0.67;
  704:       else { assert(false && "unknown submodel"); return 0.0; }
  705:    }
  706: 
  707: 
  708:    __device__ __forceinline__ constexpr double schk(void) const {
  709:       if      constexpr (turbSubmodel == KL)             return 2.44;
  710:       else if constexpr (turbSubmodel == KE)             return 1.0;
  711:       else if constexpr (turbSubmodel == KW)             return 2.0;
  712:       else if constexpr (turbSubmodel == UmlaufBurchard) return 0.8;
  713:       else { assert(false && "schk not set for this submodel"); return 0.0; }
  714:    }
  715: 
  716: 
  717:    __device__ __forceinline__ constexpr double schpsi(void) const {
  718:       if      constexpr (turbSubmodel == KL)             return 2.44;
  719:       else if constexpr (turbSubmodel == KE)             return 1.3;
  720:       else if constexpr (turbSubmodel == KW)             return 2.0;
  721:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.07;
  722:       else { assert(false && "schpsi not set for this submodel"); return 0.0; }
  723:    }
  724: 
  725: 
  726:    __device__ __forceinline__ constexpr double tkemin(void) const {
  727:       if constexpr (turbSubmodel == MellorYamada || turbSubmodel == KL)
  728:          return 5.0e-6;
  729:       else
  730:          return 7.6e-6; // Warner et al., OM 2005
  731:    }
  732: 
  733: 
  734:    __device__ __forceinline__ constexpr double psimin(void) const {
  735:       if constexpr (turbSubmodel == MellorYamada || turbSubmodel == TurbulenceSubmodel::KL)
  736:          return 1.0e-8;
  737:       else
  738:          return 1.0e-12; // Warner et al., OM 2005
  739:    }
  740: 
  741:    __device__ __forceinline__ constexpr double epsmin(void) const {
  742:       return 1.0e-12;  // GOTM/SCHISM default; floor for dissipative length cap
  743:    }
  744: 
  745:    __device__ __forceinline__ double mxlmin(double depth) const;
  746: 
  747:    
  748:    __device__ __forceinline__ double N2_c(Node *node, int k) const;
  749: 
  750:    __device__ __forceinline__ double N2(Node *node, int k) const;
  751: 
  752: 
  753:    __device__ __forceinline__ double vegTurbProduction(Node *node, int k) const;
  754: 
  755:    __device__ void computeDiffusivities(Node *node);
  756: 
  757:    __device__ __forceinline__ double maxMixingLength(Node *node, int k) const;
  758: 
  759: 
  760:    // Conversions between the generic length-scale variable Phi and the mixing length mxl.
  761:    __device__ __forceinline__ double phiFromMxl(double tke, double mxl) const {
  762:       return pow(cmiu0, rpub()) * pow(tke, rmub()) * pow(mxl, rnub());
  763:    }
  764: 
  765: 
  766:    __device__ __forceinline__ double mxlFromPhi(double tke, double phi) const {
  767:       return pow(phi * pow(cmiu0, -rpub()) * pow(tke, -rmub()), 1.0/rnub());
  768:    }
  769: 
  770: };
