 4142: 
 4143:    __global__ void backtrackAllNodes(void) {
 4144: 
 4145:       // max/min # of sub-divisions
 4146:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4147:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4148: 
 4149: 
 4150:       SIDE(side);
 4151: 
 4152:       const int kb = side->kb;
 4153: 
 4154: 
 4155:       // Initialize btrack velocities to the actual velocities at the side 
 4156:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4157: 
 4158:   
 4159: 
 4160:       if (side->isDry) return;
 4161:       
 4162: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4163: 
 4164:       // Checks that at least one element is not dry
 4165:       const Element *elem1 = side->elems[0];
 4166:       const Element *elem2 = side->elems[1];
 4167: 
 4168: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4169: 
 4170:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4171:       
 4172:       // XXXXXX
 4173:       // !swild_tmp to store global coord. of the starting side
 4174:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4175:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4176:       // !Use sframe2 
 4177:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4178: 
 4179: 
 4180:       for (int k = kb; k < nvrt; k++) {
 4181:       //  Initialize (xt,yt,zt), nnel and vel.
 4182:       //  For ics=2, the coordinates are all in the side's local frame
 4183:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 4184: 
 4185: 
 4186:          const int iadvf = side->iadv();  // Advection flag   
 4187:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4188: 
 4189: 
 4190:          // If on land or open boundary...
 4191:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 4192:          
 4193:          const double vmag = length(side->u2[k]);
 4194: 
 4195:          if (vmag <= velmin_btrack) {
 4196:             // No activity 
 4197: 
 4198:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4199: // addDebugPlot(side->center, side->center, 0x00000F, '+');     
 4200: 
 4201: 
 4202:             
 4203:          } else {  // do btrack
 4204: 
 4205:             // Compute number of sub-divisions based on local gradients of the velocity field
 4206: 
 4207:             // XXX IS THIS NECESSARY?
 4208:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4209:             double suma = 0.0;
 4210:             int icount = 0;
 4211:             for (int l=0; l<2; l++) {
 4212:             // For each element sharing the side...
 4213: 
 4214:                const Element *elem = side->elems[l];
 4215:                  
 4216:                if (elem == nullptr) continue;
 4217: 
 4218:                icount++;
 4219: 
 4220:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 4221:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 4222:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 4223: 
 4224:                double utmp[4];
 4225:                double vtmp[4];
 4226:                for (int j = 0; j < elem->i34; j++) {
 4227: 
 4228:                   const Node *node = elem->nodes[j];
 4229: 
 4230:                   if constexpr(ics==1) {
 4231:                      utmp[j] = node->u2[k].x;
 4232:                      vtmp[j] = node->u2[k].y;  
 4233: 
 4234:                   } else {
 4235:                      // 'Project' the velocity from the node frame to the element frame
 4236:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 4237:                      utmp[j] = tmp_u2.x;
 4238:                      vtmp[j] = tmp_u2.y;
 4239: 
 4240:                   }
 4241:                } // for j
 4242: 
 4243:                const Vector2 grad_u = elem->grad2(utmp); 
 4244:                const Vector2 grad_v = elem->grad2(vtmp);
 4245: 
 4246:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4247:             } // for ii
 4248: 
 4249:             assert(icount > 0 && "Impossible 77");
 4250: 
 4251:             // '4' is somewhat arbitrary
 4252:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4253: 
 4254:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4255: 
 4256:             Vector3 u_int = {0.0, 0.0, 0.0};
 4257: 
 4258:             bool res =side->btrack(k, dt, dtbk, u_int);
 4259: 
 4260:             side->btu[k] = toVector2(u_int);
 4261:                
 4262:          } // if vmag (do backtrack)
 4263: 
 4264: 
 4265:       } // for k=kb,nvrt-1
 4266: 
 4267:    }
 4268: 
 4269: } // extern "C"
 4270: 
 4271: template<int nc>
 4272: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4273: 
 4274: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4275: //
 4276: // a,b,c,rhs: input vectors and are not modified by this program.
 4277: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4278: // rhs is the r.h.s.
 4279: // n: actual rank of the system.
 4280: // rows in u() and rhs();
 4281: // u: output with nc columns (transposed to rows)
 4282: // gam: a working array.
 4283: //
 4284: // NOTES:
 4285: // This is a template function that allows for different numbers of columns in the rhs vector.
 4286: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4287: 
 4288:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4289:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4290: 
 4291:    double bet = b[0];
 4292:    if constexpr (nc == 1) {
 4293:       u[0] = rhs[0]/bet;
 4294:    } else {
 4295:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4296:    }
 4297: 
 4298:    for (int j = 1; j < n; j++) {
 4299:       gam[j] = c[j - 1]/bet;
 4300:       bet = b[j] - a[j]*gam[j];
 4301: 
 4302:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4303: 
 4304:       if constexpr (nc == 1) {
 4305:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4306:       } else {
 4307:          for (int l = 0; l < nc; l++) {
 4308:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4309:          }
 4310:       }
 4311:    }
 4312: 
 4313:    // Back-substitution
 4314:    for (int j = n - 2; j >= 0; j--) {
 4315:       if constexpr (nc == 1) {
 4316:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4317:       } else {
 4318:          for (int l = 0; l < nc; l++) {
 4319:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4320:          }
 4321:       }
 4322:    }
 4323: }
 4324: 
 4325: 
 4326: 
 4327: // Helper function that contains the core algorithm
 4328: template<typename XAccessor, typename YAccessor>
 4329: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4330:                                     double  yp_top, double  yp_bot, 
 4331:                                     CubicSpline &spline) {
 4332:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4333:    // 
 4334:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4335:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4336:    //
 4337:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4338:    // 
 4339:    // Inputs: 
 4340:    //            n: dimension for x etc; # of data pts (>=2);
 4341:    //            getX, getY: functions to access x,y coordinates
 4342:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4343:    //     Output: 
 4344:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4345: 
 4346:    const int n = k2 - k1 + 1;
 4347:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4348: 
 4349:    // Allocate memory for the splines
 4350:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4351:    spline.x   = new double[n];
 4352:    spline.y   = new double[n];
 4353:    spline.yp  = new double[n];
 4354:    spline.ypp = new double[n];
 4355: 
 4356:    for (int k=k1; k<=k2; k++) {
 4357:       spline.x[k] = getX(k);
 4358:       spline.y[k] = getY(k);
 4359:    }
 4360: 
 4361:    // This is to simplify expressions later
 4362:    double *x = spline.x;
 4363:    double *y = spline.y;
 4364: 
 4365:    double *a = nullptr;
 4366:    double *b = nullptr;
 4367:    double *c = nullptr;
 4368:    double *gam = nullptr;
 4369:    double *rhs = nullptr;
 4370:    
 4371: 
 4372:       a = new double[n];   // Lower diagonal
 4373:       b = new double[n];   // Diagonal
 4374:       c = new double[n];   // Upper diagonal
 4375:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4376:       rhs = new double[n]; // Right-hand side
 4377: 
 4378:    for (int k=k1; k<=k2; k++) {
 4379:       if (k == k1) {
 4380:          // Bottom level
 4381:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4382:          b[k] = (x[k+1] - x[k])/3.0;
 4383:          c[k] = b[k]/2.0;
 4384:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4385:       } else if (k == n - 1) {
 4386:          // Top level (surface)
 4387:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4388:          b[k] = (x[k] - x[k-1])/3.0;
 4389:          a[k] = b[k]/2.0;
 4390:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4391:       } else {
 4392:          // Intermediate levels
 4393:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4394:          b[k] = (x[k+1] - x[k-1])/3.0;
 4395:          a[k] = (x[k  ] - x[k-1])/6.0;
 4396:          c[k] = (x[k+1] - x[k  ])/6.0;
 4397:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4398:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4399:       }
 4400:    }
 4401: 
 4402:    // Solve the tridiagonal system
 4403:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4404:    
 4405:    spline.yp[k1] = yp_bot;
 4406:    spline.yp[k2] = yp_top;
 4407: 
 4408:    // Compute rest of 1st derivatives using the splines
 4409:    for (int k=k1+1; k<k2; k++) {
 4410:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4411:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4412:    }
 4413:    
 4414:    delete[] a;
 4415:    delete[] b;
 4416:    delete[] c;
 4417:    delete[] gam;
 4418:    delete[] rhs;
 4419: 
 4420: }
 4421: 
 4422: // Array version
 4423: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4424:                                 double y_top, double y_bot, 
 4425:                                 CubicSpline &spline) {
 4426:    auto getX = [x] (int k) { return x[k]; };
 4427:    auto getY = [y] (int k) { return y[k]; };
 4428:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4429: }
 4430: 
 4431: // Lambda version - allows custom access patterns
 4432: template<typename XFunc, typename YFunc>
 4433: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4434:                                 double y_top, double y_bot,
 4435:                                 CubicSpline &spline) {
 4436:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4437: }
 4438: 
 4439: 
 4440: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 4441: {
 4442:    assert("Not implemented");
 4443: 
 4444:    return 0.0;
 4445: }
 4446: 
 4447: // __device__ void vertLinearInterp(int nc, double zt, int k1, int k2, double *za, double *s_in, double *s_out, int *ibelow) {
 4448: // //     Routine to do vertical linear interpolation in z
 4449: // //     Inputs:
 4450: // //
 4451: // //       nc: actual # of variables 
 4452: // //       k1,k2: lower and upper limits for za, s_in 
 4453: // //       zt: desired interpolation level
 4454: // //       za[0:nvrt-1]: z-coordinates for s_in (must be in ascending order)
 4455: // //       s_in[0:nc-1,0:nvrt-1]: values to be interpolated from; dimensions must match driving program
 4456: 
 4457: // //     Outputs:
 4458: // //       s_out[0:nc-1]: interpolated value @ z=zt (bottom value if ibelow=1). Constant extrapolation
 4459: // //                   is used below bottom or above surface.
 4460: // //       ibelow: flag indicating if zt is below za(k1)
 4461: // //
 4462: 
 4463: //    assert(k1 >= 0 && k2 < nvrt && "vertLinearInterp: k1 or k2 out of bounds");
 4464: //    assert(k1 <= k2 && "vertLinearInterp: k1 > k2");
 4465:    
 4466: //    ibelow = 0;
 4467: 
 4468: //    if (zt < za[k1]) {
 4469: //       // Below bottom
 4470: //       ibelow = 1;
 4471: //       for (int i = 0; i < nc; i++) s_out[i] = s_in[i + k1*nc];
 4472: 
 4473: //    } else if(zt>=za[k2]) {
 4474: //       // Above surface
 4475: //       for (int i = 0; i < nc; i++) s_out[i] = s_in[i + k2*nc];
 4476: 
 4477: //    } else {
 4478: //       // Normal case (between bottom and surface)
 4479:       
 4480: //       // Finds the level index using binary search
 4481: //       int l1 = k1;
 4482: //       int l2 = k2;
 4483: //       int k = (l1 + l2)/2;
 4484: //       while (l2 - l1 > 1) {  // Stop when we have adjacent levels
 4485: //           int k = (l1 + l2)/2;
 4486: //           if (zt >= za[k]) l1 = k;
 4487: //           else             l2 = k;
 4488: //       }
 4489: //       // Now l1 and l2 are adjacent levels and zt is between them
 4490: 
 4491: //       assert(za[l2] - za[l1] > 0.0 && "vertLinearInterp: za[l2] - za[l1] <= 0");
