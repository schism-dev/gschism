  581:    __device__ bool computeShapeCoords(Point2 &xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  582:    
  583:    __device__ void shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const;
  584: 
  585:    __device__ Vector2 grad2(double *a) const
  586:    {
  587:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  588:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  589:       if (isQuad()) {
  590:          gx += a[3]*gradPhi[3].x;
  591:          gy += a[3]*gradPhi[3].y;
  592:       }
  593:       return {gx, gy};
  594:    }
  595: 
  596:    __device__ Vector2 grad2(double Node::* field) const
  597:    {
  598:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  599:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  600:       if (isQuad()) {
  601:          gx += (nodes[3]->*field)*gradPhi[3].x;
  602:          gy += (nodes[3]->*field)*gradPhi[3].y;
  603:       }
  604:       return {gx, gy};
  605:    }
  606: 
  607:    __device__ __forceinline__ Vector3 n(int k, double &area3D) const;
  608:    __device__ __forceinline__ Vector3 n(int k) const {
  609:       double area3D;
  610:       return n(k, area3D);
  611:     }
