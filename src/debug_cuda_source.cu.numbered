 4450: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 4451:                 double *node_coords, double *node_coords_ll, bool use_ll,
 4452:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 4453:                 int *isdel, int *isidenode, int *isbnd,
 4454:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 4455:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4456:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4457:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4458:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4459:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 4460:                 double *drag, double *roughness,
 4461:                 double *emo, double *efa, 
 4462:                 double *umo, double *ufa, 
 4463:                 double *vmo, double *vfa) {
 4464: 
 4465:    printf("Populating mesh for partition %d\n", partNum);
 4466: 
 4467:    // XXXXXX THIS function does almost nothing. 
 4468: 
 4469:    nbs = *sharedIdxSideBoundary + 1;
 4470:    nbp = *sharedIdxNodeBoundary + 1;
 4471: 
 4472:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 4473: 
 4474: }
