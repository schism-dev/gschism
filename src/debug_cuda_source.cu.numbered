  953: struct Side {
  954: 
  955:    // Geometry information
  956:    int idx;               // Index of the side
  957:    Node *n1, *n2;
  958:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  959: 
  960:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
  961:    Vector2 center;        // Location of side center. 
  962:    double zc[nvrt];       // Side center z-coord at each vertical level
  963: 
  964:    Frame frame;
  965: 
  966:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  967:                           // this is nullptr
  968:    
  969:    int kb;                // Bottom index of the side
  970:    bool isDry;            // True if the side is dry
  971:  
  972:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  973: 
  974:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
  975: 
  976:    // Physical information
  977:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  978:    double  w2[nvrt];            // Vertical velocity at each vertical level
  979:    Vector2 btu[nvrt];           // Back-tracked velocity
  980:    Vector2 U;                   // Vertically averaged velocity vector  
  981: 
  982:    Vector2 nuGradU[nvrt];          // nu*grad u
  983: 
  984:    Vector2 bcc[nvrt];           // Baroclinic term
  985:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
  986: 
  987:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
  988:    Vector2 gradEta2;             // Gradient of elevation at current timestep
  989:    Vector2 gradPr;               // Gradient of pressure
  990:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
  991: 
  992: 
  993:    double hhat;                 // \breve{H} in notes
  994: 
  995:    double shapiro;
  996: 
  997:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
  998: 
  999:    double coriolis;             // Coriolis parameter
 1000: 
 1001:    // Vegetation parameters
 1002:    double veg_c2;
 1003:    double veg_beta;
 1004: 
 1005:    // Bottom drag parameters.
 1006:    double chi;
 1007:    double chi2;
 1008: 
 1009:    __inline__ __device__ double x(double t) const;
 1010:    __inline__ __device__ double y(double t) const;
 1011:    __inline__ __device__ double lon(void) const;
 1012:    __inline__ __device__ double lat(void) const;
 1013:    __inline__ __device__ Point2 p_t(double t) const;
 1014: 
 1015:    __inline__ __device__ Point3 center3D(int k) const { assert(k < nvrt); return {center.x, center.y, zc[k]}; }
 1016:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
 1017:    __inline__ __device__ double Dz(int k)       const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1018:    __inline__ __device__ double area(int k)     const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1019: 
 1020:    __inline__ __device__ Side* neigh(int index) const { 
 1021:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1022:       assert(index >= 0 && index < 4); 
 1023:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1024: 
 1025:       const int ielem = index & 1;           // 0 or 1
 1026:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1027: 
 1028:       const Element* elem = elems[ielem];
 1029: 
 1030:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1031: 
 1032:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1033: 
 1034:    }
 1035: 
 1036:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1037: 
 1038:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1039: 
 1040:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1041:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1042:    __inline__ __device__ int iadv(void) const;
 1043: 
 1044:    __inline__ __device__ double grav3(void) const;
 1045:    
 1046:    __inline__ __device__ double eta2(void) const;
 1047:    __inline__ __device__ double eta1(void) const;
 1048:    __inline__ __device__ double depth(void) const;
 1049:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1050:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1051: 
 1052:    __inline__ __device__ double dfv(int k) const;
 1053: 
 1054:    __inline__ __device__ double veg_h(void)  const;
 1055:    __inline__ __device__ double veg_nv(void) const;
 1056:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1057:    __inline__ __device__ double veg_alpha3D(int k) const;
 1058:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1059: 
 1060:    __inline__ __device__ double Cd(void) const;
 1061: 
 1062:    __inline__ __device__ Vector2 tau(void) const;
 1063: 
 1064:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1065:    
 1066: 
 1067:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1068:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1069:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1070:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1071:    } 
 1072:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1073:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1074:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1075:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1076: 
 1077:    // Get valid starting element (for backtracking)
 1078:    __inline__ __device__ Element* getStartElement() {
 1079:       return elems[0] ? elems[0] : elems[1];
 1080:    }
 1081: 
 1082:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
 1083:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
 1084: 
 1085:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
 1086: 
 1087:       // Dot product of the negative velocity vector with the side normal vector
 1088:       const double dot_prod1 = -dot(u, n);
 1089: 
 1090:       // Vector from side center to element 0 centroid
 1091:       const Vector2 v2 = elems[0]->center - center;
 1092: 
 1093:       // Dot product of the vector with the side normal vector
 1094:       const double dot_prod2 = dot(v2, n);
 1095: 
 1096:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
 1097:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
 1098: 
 1099:       if (dot_prod1*dot_prod2 > 0.0) return elems[0];
 1100:       else                           return elems[1];
 1101: 
 1102:  
 1103:    }
 1104: 
 1105:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1106:       // Given an element, returns the other element that shares this side
 1107:       return (elems[0] == elem) ? elems[1] : elems[0];
 1108:    }
 1109: 
 1110:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1111:       // Given a node, returns the other node that shares this side
 1112:       return (n1 == node) ? n2 : n1;
 1113:    }
 1114:  
 1115:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1116: 
 1117: 
 1118: 
 1119: 
 1120: };
