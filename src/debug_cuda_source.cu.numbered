 8431:    SIDE(side);
 8432: 
 8433:    switch (varCode) {
 8434:       case (int)VarCode::outputCoords:
 8435:          const Point2 coords = side->outputCoords();
 8436:          res[side->idx*2    ] = coords.x;
 8437:          res[side->idx*2 + 1] = coords.y;
 8438:          break;
 8439:    }
 8440: }
