 4549:    __global__ void computeFlowBcVelocities(double time) {
 4550: 
 4551:       SIDE_BND(sideBnd);
 4552: 
 4553:       const Side *side = sideBnd->side;
 4554:  
 4555:       const bool isDry = side->isDry;
 4556:       const bool isLand = sideBnd->segment->isLand;
 4557: 
 4558:    
 4559:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4560: 
 4561:       if (isDry || isLand) return;
 4562: 
 4563:       // For wet sides in open boundaries...
 4564:       const Vector2 n = side->n;
 4565:       const BoundarySegment *segment = sideBnd->segment;
 4566: 
 4567:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4568: 
 4569:       const int ifltype = segment->ifltype;
 4570: 
 4571:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4572:       const Vector2 r_nuth0 = r_uth0*n;
 4573: 
 4574: 
 4575:       if (ifltype == 1 || ifltype == 2) {
 4576:       
 4577:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4578: 
 4579:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4580:          
 4581:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4582:          
 4583:       } else if (ifltype == -1) { // Flather 1
 4584: 
 4585:          for (int k = 0; k < nvrt; k++) {
 4586: 
 4587:             // uth is the normal vel.; no ramp up
 4588:             const double uth = sideBnd->nuth(k);
 4589:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4590: 
 4591:             sideBnd->ubc[k] += uth*n;
 4592:          }
 4593: 
 4594:       } else if (ifltype == 3 || ifltype == 5) {
 4595:          // vnth0=0 !normal vel.
 4596: 
 4597:          Vector2 r_u1_bar = {0.0, 0.0};
 4598:          // Computes the contribution to the velocity from all tide frequencies
 4599:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4600: 
 4601:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4602:             const Vector2 umo  = sideBnd->umo(jfr); 
 4603: 
 4604:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4605:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4606:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4607:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4608:          }
 4609: 
 4610: 
 4611:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4612: 
 4613:       } // if (ifltype = 3 || ifltype == 5
 4614: 
 4615: 
 4616: 
 4617:    }
 4618: 
 4619:    __global__ void computeElevationBoundaryConditions(double time) {
 4620:       // Compute elevation essential boundary conditions 
 4621: 
 4622:       NODE_BND(nodeBnd); // Each boundary node.
 4623: 
 4624:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4625: 
 4626:       const Node *node = nodeBnd->node;
 4627:       const BoundarySegment *segment = nodeBnd->segment;
 4628:       const int iettype = segment->iettype;
 4629:       
 4630: 
 4631:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4632:       double eic = 0.0;
 4633:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4634:       else                 eic = 0.0;
 4635: 
 4636:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4637:       const double r_eth = ramp*nodeBnd->eth;
 4638:       double r_eta1_bar = 0.0;
 4639: 
 4640: 
 4641:       // Compute tide elevation
 4642:       if (iettype == 3 || iettype == 5) {   
 4643: 
 4644:          if constexpr(iloadtide==1) { // loading tide
 4645:             assert(false && "Loading tide not implemented");
 4646:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4647:          }
 4648:          
 4649:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4650: 
 4651:             const double efa  = nodeBnd->efa[jfr]; 
 4652:             const double emo  = nodeBnd->emo[jfr]; 
 4653: 
 4654:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4655:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4656:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4657: 
 4658:          } // for jfr
 4659: 
 4660:       } // if iettype
 4661: 
 4662:       switch (iettype) {
 4663:          case 1:
 4664:          case 2:
 4665:          case 4:
 4666:             nodeBnd->elbc = r_eic + r_eth;
 4667:             break;
 4668:          case 3:
 4669:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4670:             break;
 4671:          case 5:
 4672:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4673:             break;
 4674:       } // switch
 4675: 
 4676: 
 4677:       //Add inverse barometric effects
 4678:       if (iettype != 0 && inv_atm_bnd == 1) {
 4679:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4680:       }
 4681: 
 4682:    }
 4683: 
 4684: 
 4685:    __global__ void computeHorizontalViscosity(void) { 
 4686: 
 4687:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4688: 
 4689:       SIDE(side);
 4690: 
 4691:       if (side->isDry) return;
 4692: 
 4693:       for (int k = 0; k < nvrt; k++) {
 4694:          side->nuGradU[k] = {0.0, 0.0};
 4695:       }
 4696: 
 4697:       if constexpr(ihorcon == 1) {
 4698:          for (int k = side->kb; k < nvrt - 1; k++) {
 4699:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4700:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 4701:             // By Zhang and Baptista.
 4702: 
 4703:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4704:             // This is a standard discretization of the Laplacian operator.
 4705:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4706:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4707:             // Gamma is hvis_coef0 in the code.
 4708:             // The value of gamma needs to be < 0.5.
 4709: 
 4710:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4711:             // side under consideration in each of the two possible elements that share the side.
 4712:             Vector2 sumU = {0.0, 0.0};
 4713:             for (int l = 0; l < 2; l++) {
 4714:                const Element *elem = side->elems[l];
 4715: 
 4716:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4717: 
 4718:                // Find the local index of the side in the element
 4719:                const int idxSide = elem->sideLocalIdx(side);
 4720:                // Find the two sides that are connected to the side under consideration
 4721:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4722:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4723: 
 4724:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4725: 
 4726:             }
 4727: 
 4728:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4729:    
 4730:          }
 4731:       }
 4732:       else if constexpr(ihorcon == 2) {
 4733:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4734:       }
 4735: 
 4736: 
 4737:    }
 4738: 
 4739: 
 4740:    __global__ void setEssentialBC(void) {
 4741:       // Set essential boundary conditions 
 4742:       NODE(node); // Each boundary node
 4743:       NodeBoundary *nodeBnd = node->nodeBnd;
 4744:       
 4745: // nodeBnd->isEssentialBC = true;      
 4746:       // Check if this node has essential BC
 4747:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4748:          // Verify BC value is valid
 4749:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4750: 
 4751:        
 4752:          // Set diagonal to 1 and zero off-diagonals
 4753:          node->coeffDiag = 1.0;
 4754: 
 4755:          for (int j = 0; j < node->numNodes; j++) {
 4756:                node->coeffMatrix[j] = 0.0;
 4757:          }
 4758:          
 4759:          // Set solution and RHS to BC value
 4760:          node->mX  = nodeBnd->elbc;
 4761:          node->qel = nodeBnd->elbc;
 4762: 
 4763:       } else {
 4764:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4765: 
 4766:          for (int j = 0; j < node->numNodes; j++) {
 4767:                Node* nbNode = node->nodes[j];
 4768:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4769:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4770:                   // Verify neighbor's BC value
 4771:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4772: 
 4773:                   // Subtract contribution to RHS
 4774:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4775:                   node->coeffMatrix[j] = 0.0;  
 4776:                }
 4777:          }
 4778:       }
 4779:    }
 4780: 
 4781: 
 4782:    __global__ void updateElevation(void) {
 4783:       NODE(node);
 4784: 
 4785:       node->eta2 = node->mX;
 4786: 
 4787:       node->updateZCoordData();
 4788:    }
