 2128:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 2129:       // Compute the different time ramps used in the code 
 2130:       // This function is performed by just one thread
 2131: 
 2132:       rampbc = 1.0;
 2133:       if constexpr(ibc == 0) {
 2134:          if (drampbc > 0.0) {
 2135:             rampbc = tanh(2.0*time/86400.0/drampbc);
 2136:          } else {
 2137:             rampbc = 1.0;
 2138:          }
 2139:       }
 2140: 
 2141:       if (nws != 0) {
 2142:          if (drampwind > 0.0) {
 2143:             rampwind = tanh(2.0*time/86400.0/drampwind);
 2144:          } else {
 2145:             rampwind = 1.0;
 2146:          }
 2147:       }
 2148: 
 2149:       if (drampwafo > 0.0) {
 2150:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 2151:       } else {
 2152:          rampwafo = 1.0;
 2153:       }
 2154: 
 2155:       // For source/sinks
 2156:       if (if_source && dramp_ss > 0.0) {
 2157:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 2158:       } else {
 2159:          ramp_ss = 1.0;
 2160:       }
 2161: 
 2162:       if (dramp > 0.0) {
 2163:          ramp = tanh(2.0*time/86400.0/dramp);
 2164:       } else {
 2165:          ramp = 1.0;
 2166:       }
 2167: 
 2168: 
 2169:    }
