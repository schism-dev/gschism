 3738: 
 3739:    __global__ void backtrackAllNodes(void) {
 3740: 
 3741:       // max/min # of sub-divisions
 3742:       const int ndelt_max = max(1.0, dt/dtb_min);
 3743:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3744: 
 3745:       // Removed all references to swild98 XXX
 3746:       // swild98=0.d0 !init
 3747: 
 3748: 
 3749: 
 3750:       SIDE(side);
 3751: 
 3752:       const int kb = side->kb;
 3753: 
 3754: 
 3755:       // Initialize btrack velocities to the actual velocities at the side 
 3756:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3757: 
 3758:   
 3759: 
 3760:       if (side->isDry) return;
 3761:       
 3762: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 3763: 
 3764:       // Checks that at least one element is not dry
 3765:       const Element *elem1 = side->elems[0];
 3766:       const Element *elem2 = side->elems[1];
 3767: 
 3768: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 3769: 
 3770:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3771:       
 3772:       // XXXXXX
 3773:       // !swild_tmp to store global coord. of the starting side
 3774:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3775:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3776:       // !Use sframe2 
 3777:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3778: 
 3779: 
 3780:       for (int k = kb; k < nvrt; k++) {
 3781:       //  Initialize (xt,yt,zt), nnel and vel.
 3782:       //  For ics=2, the coordinates are in local frames
 3783:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3784: 
 3785: 
 3786:          const int iadvf = side->iadv();  // Advection flag   
 3787:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 3788: 
 3789:          Point3 xt;
 3790:          if constexpr(ics==1) {
 3791:             xt = side->center3D(k); 
 3792:          }
 3793:          else // lat/lon; in side lat/lon frame
 3794:          {
 3795:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3796:          // XXX IMPLEMENT THIS
 3797:       //          xt=0.d0
 3798:       //          yt=0.d0
 3799:       //          !centroid coord. for nudging
 3800:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3801:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3802:          }  // ics
 3803: 
 3804: 
 3805: 
 3806:          // If on land or open boundary...
 3807:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3808:          
 3809:          const double vmag = length(side->u2[k]);
 3810: 
 3811:          if (vmag <= velmin_btrack) {
 3812:             // No activity 
 3813: 
 3814:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 3815: // addDebugPlot(side->center, side->center, 0x00000F, '+');     
 3816: 
 3817: 
 3818:             
 3819:          } else {  // do btrack
 3820: 
 3821:             // Compute number of sub-divisions based on local gradients 
 3822:             // XXX IS THIS NECESSARY?
 3823:             double suma = 0.0;
 3824:             int icount = 0;
 3825:             for (int ii=0; ii<2; ii++) {
 3826: 
 3827:                const Element *elem = side->elems[ii];
 3828:                  
 3829:                if (elem == nullptr) continue;
 3830: 
 3831:                icount++;
 3832: 
 3833:                // Not strictly along z; in ll frame for ics=2
 3834: 
 3835:                double utmp[4];
 3836:                double vtmp[4];
 3837:                for (int jj = 0; jj < elem->i34; jj++) {
 3838: 
 3839:                   const Node *node = elem->nodes[jj];
 3840: 
 3841:                   if constexpr(ics==1) {
 3842:                      utmp[jj] = node->u2[k].x;
 3843:                      vtmp[jj] = node->u2[k].y;  
 3844:                   } else {
 3845:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3846:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3847:                   }
 3848:                } // for jj
 3849: 
 3850:                const Vector2 grad_u = elem->grad2(utmp); 
 3851:                const Vector2 grad_v = elem->grad2(vtmp);
 3852: 
 3853:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3854:             } // for ii
 3855: 
 3856:             assert(icount > 0 && "Impossible 77");
 3857: 
 3858:             // '4' is somewhat arbitrary
 3859:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3860: 
 3861:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3862: 
 3863:             Vector3 u_int = {0.0, 0.0, 0.0};
 3864: 
 3865:             bool res =side->btrack(k, dt, dtbk, u_int);
 3866: 
 3867:             side->btu[k] = toVector2(u_int);
 3868:                
 3869:          } // if vmag (do backtrack)
 3870: 
 3871: 
 3872:       } // for k=kb,nvrt-1
 3873: 
 3874:    }
 3875: 
 3876: } // extern "C"
 3877: 
 3878: template<int nc>
 3879: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3880: 
 3881: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3882: //
 3883: // a,b,c,rhs: input vectors and are not modified by this program.
 3884: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3885: // rhs is the r.h.s.
 3886: // n: actual rank of the system.
 3887: // rows in u() and rhs();
 3888: // u: output with nc columns (transposed to rows)
 3889: // gam: a working array.
 3890: //
 3891: // NOTES:
 3892: // This is a template function that allows for different numbers of columns in the rhs vector.
 3893: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3894: 
 3895:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3896:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3897: 
 3898:    double bet = b[0];
 3899:    if constexpr (nc == 1) {
 3900:       u[0] = rhs[0]/bet;
 3901:    } else {
 3902:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 3903:    }
 3904: 
 3905:    for (int j = 1; j < n; j++) {
 3906:       gam[j] = c[j - 1]/bet;
 3907:       bet = b[j] - a[j]*gam[j];
 3908: 
 3909:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3910: 
 3911:       if constexpr (nc == 1) {
 3912:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3913:       } else {
 3914:          for (int l = 0; l < nc; l++) {
 3915:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 3916:          }
 3917:       }
 3918:    }
 3919: 
 3920:    // Back-substitution
 3921:    for (int j = n - 2; j >= 0; j--) {
 3922:       if constexpr (nc == 1) {
 3923:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 3924:       } else {
 3925:          for (int l = 0; l < nc; l++) {
 3926:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 3927:          }
 3928:       }
 3929:    }
 3930: }
 3931: 
 3932: 
 3933: 
 3934: // Helper function that contains the core algorithm
 3935: template<typename XAccessor, typename YAccessor>
 3936: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3937:                                     double  yp_top, double  yp_bot, 
 3938:                                     CubicSpline &spline) {
 3939:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3940:    // 
 3941:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3942:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3943:    //
 3944:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3945:    // 
 3946:    // Inputs: 
 3947:    //            n: dimension for x etc; # of data pts (>=2);
 3948:    //            getX, getY: functions to access x,y coordinates
 3949:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3950:    //     Output: 
 3951:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3952: 
 3953:    const int n = k2 - k1 + 1;
 3954:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3955: 
 3956:    // Allocate memory for the splines
 3957:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3958:    spline.x   = new double[n];
 3959:    spline.y   = new double[n];
 3960:    spline.yp  = new double[n];
 3961:    spline.ypp = new double[n];
 3962: 
 3963:    for (int k=k1; k<=k2; k++) {
 3964:       spline.x[k] = getX(k);
 3965:       spline.y[k] = getY(k);
 3966:    }
 3967: 
 3968:    // This is to simplify expressions later
 3969:    double *x = spline.x;
 3970:    double *y = spline.y;
 3971: 
 3972:    double *a = nullptr;
 3973:    double *b = nullptr;
 3974:    double *c = nullptr;
 3975:    double *gam = nullptr;
 3976:    double *rhs = nullptr;
 3977:    
 3978: 
 3979:       a = new double[n];   // Lower diagonal
 3980:       b = new double[n];   // Diagonal
 3981:       c = new double[n];   // Upper diagonal
 3982:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3983:       rhs = new double[n]; // Right-hand side
 3984: 
 3985:    for (int k=k1; k<=k2; k++) {
 3986:       if (k == k1) {
 3987:          // Bottom level
 3988:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3989:          b[k] = (x[k+1] - x[k])/3.0;
 3990:          c[k] = b[k]/2.0;
 3991:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3992:       } else if (k == n - 1) {
 3993:          // Top level (surface)
 3994:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3995:          b[k] = (x[k] - x[k-1])/3.0;
 3996:          a[k] = b[k]/2.0;
 3997:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3998:       } else {
 3999:          // Intermediate levels
 4000:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4001:          b[k] = (x[k+1] - x[k-1])/3.0;
 4002:          a[k] = (x[k  ] - x[k-1])/6.0;
 4003:          c[k] = (x[k+1] - x[k  ])/6.0;
 4004:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4005:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4006:       }
 4007:    }
 4008: 
 4009:    // Solve the tridiagonal system
 4010:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4011:    
 4012:    spline.yp[k1] = yp_bot;
 4013:    spline.yp[k2] = yp_top;
 4014: 
 4015:    // Compute rest of 1st derivatives using the splines
 4016:    for (int k=k1+1; k<k2; k++) {
 4017:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4018:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4019:    }
 4020:    
 4021:    delete[] a;
 4022:    delete[] b;
 4023:    delete[] c;
 4024:    delete[] gam;
 4025:    delete[] rhs;
 4026: 
 4027: }
 4028: 
 4029: // Array version
 4030: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4031:                                 double y_top, double y_bot, 
 4032:                                 CubicSpline &spline) {
 4033:    auto getX = [x] (int k) { return x[k]; };
 4034:    auto getY = [y] (int k) { return y[k]; };
 4035:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4036: }
 4037: 
 4038: // Lambda version - allows custom access patterns
 4039: template<typename XFunc, typename YFunc>
 4040: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4041:                                 double y_top, double y_bot,
 4042:                                 CubicSpline &spline) {
 4043:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4044: }
