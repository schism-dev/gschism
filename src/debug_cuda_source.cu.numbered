 1424:                    int max_np, int max_ne, int max_ns, int nseg,
 1425:                    Node **nodesPtr, Element **elemsPtr, Side **sidesPtr,
 1426:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
