 2736: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2737:    // In boundary sides, the element 1 is nullptr
 2738:    return side->elems[1] == nullptr; 
 2739: }
 2740: 
 2741: __forceinline__ __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const {
 2742:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 2743:    // For ics == 2, this function uses local frame coordinates.
 2744: 
 2745:    assert(isQuad());
 2746: 
 2747:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 2748:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 2749:    // where vxi, veta, vb are vectors and c is the center of the element.
 2750: 
 2751:    Point2 p0, p1, p2, p3;
 2752: 
 2753:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 2754: 
 2755:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 2756:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 2757:    // vectors vxi and veta connect the centers of opposite sides
 2758:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 2759:    // vb is zero for parallelogram elements.
 2760:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 2761: 
 2762:    //  The bilinear mapping is:
 2763:    //      P(s,t) = C + s*U + t*V + s*t*W
 2764:    //
 2765:    //  where:
 2766:    //    C = centroid (average of four vertices)
 2767:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 2768:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 2769:    //    W = bilinear correction; measures deviation from parallelogram
 2770:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 2771:    //        W = 0 for parallelogram elements.
 2772:    //
 2773:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 2774:    //
 2775:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 2776:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 2777:    //
 2778:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 2779:    //
 2780:    //  Geometrically, (L) projects everything onto the direction
 2781:    //  perpendicular to W, where the mapping is purely affine.
 2782:    //
 2783:    //  The dot product with nb retains the nonlinear term:
 2784:    //
 2785:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 2786:    //
 2787:    //  Geometrically, (Q) projects onto the W direction, where
 2788:    //  the nonlinearity lives.
 2789:    //
 2790:    //  We solve (L) for whichever variable has the larger coefficient
 2791:    //  (better conditioned back-substitution), substitute into (Q),
 2792:    //  and get a scalar quadratic in the other variable.
 2793:    // ================================================================
 2794: 
 2795:    // ---- Basis vectors ----
 2796:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 2797:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 2798:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 2799:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 2800:    // W: nonlinear correction. Difference between quad and parallelogram.
 2801:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 2802:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 2803: 
 2804:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 2805:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 2806:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 2807:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 2808:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 2809: 
 2810:    // ---- nb: direction parallel to W, L1-normalized ----
 2811:    // We don't need a unit vector -- just a well-scaled direction parallel
 2812:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 2813:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 2814:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 2815:    //
 2816:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 2817:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 2818:    // and the quadratic solver takes its linear path (a ~ 0).
 2819:    const double wlen1 = fabs(vb.x) + fabs(vb.y) + 1e-30;
 2820:    const double inv_wlen = 1.0 / wlen1;
 2821:    const Vector2 nb = vb * inv_wlen;
 2822: 
 2823:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 2824:    // cross(nb, .) projects onto the direction PERPENDICULAR to W.
 2825:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 2826:    // What remains is a pure affine relationship between xi and eta.
 2827:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 2828:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 2829:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 2830: 
 2831:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 2832:    // dot(nb, .) projects onto the W direction, where the nonlinearity lives.
 2833:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 2834:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 2835:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 2836:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 2837:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 2838: 
 2839:    // ---- Solve: pick the better-conditioned variable from (L) ----
 2840:    // Back-substitute from (L) dividing by the LARGER coefficient,
 2841:    // minimizing round-off amplification.
 2842:    //
 2843:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 2844:    // that uses predicated moves.
 2845:    //
 2846:    // if (fabs(Ls) > fabs(Lt)) {
 2847:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 2848:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 2849:    //    // Substitute into (Q), multiply by Ls, group by eta:
 2850:    //    const double A = -Qw * Lt;
 2851:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 2852:    //    const double C =  Qs * Lp - Qp * Ls;
 2853: 
 2854:    //    double eta1, eta2;
 2855:    //    solveQuadratic(A, B, C, eta1, eta2);
 2856: 
 2857:    //    // Pick root with smaller |eta| (domain centered at 0).
 2858:    //    // Ternary-> predicated move, no branch divergence.
 2859:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 2860: 
 2861:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 2862:    //    xi = (Lp - Lt * eta) / Ls;
 2863: 
 2864:    // } else {
 2865:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 2866:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 2867:    //    // Substitute into (Q), multiply by Lt, group by xi:
 2868:    //    const double A = -Qw * Ls;
 2869:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 2870:    //    const double C =  Qt * Lp - Qp * Lt;
 2871: 
 2872:    //    double xi1, xi2;
 2873:    //    solveQuadratic(A, B, C, xi1, xi2);
 2874: 
 2875:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 2876: 
 2877:    //    eta = (Lp - Ls * xi) / Lt;
 2878:    // }
 2879:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 2880:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 2881:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 2882:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 2883:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 2884: 
 2885:    // Quadratic:  A*r^2 + B*r + C = 0
 2886:    // (same formula for both cases, just with swapped coefficients)
 2887:    const double A = -Qw * Lb;
 2888:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 2889:    const double C =  Qa * Lp - Qp * La;
 2890: 
 2891:    double r1, r2;
 2892:    solveQuadratic(A, B, C, r1, r2);
 2893: 
 2894:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 2895:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 2896: 
 2897:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 2898:    const double other = (Lp - Lb * r) / La;
 2899: 
 2900:    // Assign to (xi, eta) depending on which variable the quadratic solved
 2901:    xi  = solve_s ? r     : other;
 2902:    eta = solve_s ? other : r;
 2903: 
 2904: 
 2905:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 2906:    xi  = clamp(xi,  -1.0, 1.0);
 2907:    eta = clamp(eta, -1.0, 1.0);
 2908: 
 2909:    // ---- Shape functions ----
 2910:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 2911:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 2912:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 2913:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 2914:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 2915:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 2916:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 2917:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 2918: 
 2919:    return true;
 2920: }
 2921: 
 2922: /**
 2923:    Compute the shape coordinates of the point (xt,yt) in the element.
 2924:    @param xt (input): x-coordinate of the point
 2925:    @param shpCoords (output): shape coordinates of the point
 2926:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2927:    @return true if the point is inside the element, false otherwise
 2928: **/
 2929: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 2930: 
 2931:    // Compute the shape coordinates of the point xt in the element.
 2932:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 2933:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 2934:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 2935:    // from the local frame, so use additional check.
 2936: 
 2937: 
 2938:    Point3 origSideCenter = toPoint3(origSide->center, origSide->centerZ());
 2939: 
 2940:    if (isTri()) { // Triangular element
 2941: 
 2942:       // Horizontal local node coordinates. 
 2943:       Point2 x0, x1, x2;
 2944:       getLocalHorizontalNodePositionsTri(x0, x1, x2, origSideCenter, origSide->frame);
 2945: 
 2946:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2947:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2948:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2949:       shpCoords[3] = 0.0;
 2950: 
 2951:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2952:       const bool res = (tmpmin >= -small);  
 2953:       
 2954:       // When to fix the negative shape coordinates?
 2955:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2956: 
 2957:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2958:       // then we fix the negative shape coordinates.
 2959:       if ((tmpmin < 0) && fix) {
 2960: 
 2961:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2962:          // keeping the sum of the shape coordinates equal to 1.
 2963:          // I have tested and compared the new algorithm with the old one, and they give
 2964:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2965:          // The new algorithm should be faster since it is branchless.
 2966:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 2967:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2968: 
 2969:          shpCoords[0] = (shpCoords[0] + a)*b;
 2970:          shpCoords[1] = (shpCoords[1] + a)*b;
 2971:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2972: 
 2973:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2974:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 2975:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 2976: 
 2977:          // Update the point coordinates for the new shape coordinates
 2978:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2979:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2980: 
 2981:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2982: 
 2983:       }
 2984: 
 2985:       // Return true if the point is inside the element
 2986:       return res;      
 2987:    }
 2988:    else {
 2989:       assert(isQuad() && "computeShapeCoords");
 2990: 
 2991:       // Horizontal local node coordinates with respect to the original side.
 2992:       Point2 x0, x1, x2, x3;
 2993:       getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, origSideCenter, origSide->frame);
 2994: 
 2995:       const double a0 = signedArea(x0, x1, xt);
 2996:       const double a1 = signedArea(x1, x2, xt);
 2997:       const double a2 = signedArea(x2, x3, xt);
 2998:       const double a3 = signedArea(x3, x0, xt);
 2999: 
 3000:       const double minArea = min4(a0, a1, a2, a3);
 3001:       
 3002:       const bool res = (minArea > -small*area);
 3003: 
 3004:       // When to fix the negative shape coordinates?
 3005:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 3006: 
 3007:       double xi, eta;    
 3008: 
 3009:       // Converts the point xt to the element frame coordinates and then to bilinear+shape coordinates.
 3010:       // Does nothing if ics == 1.
 3011:       assert(origSide != nullptr);
 3012:       Point2 xt_elem = toPoint2(toLocalFrame(origSide->toGlobal(toPoint3(xt, 0.0))));
 3013: 
 3014:       inverseBilinearQuad(xt_elem, xi, eta, shpCoords);
 3015: 
 3016:       if (fix) {
 3017:          double xn[4] = {x0.x, x1.x, x2.x, x3.x};
 3018:          double yn[4] = {x0.y, x1.y, x2.y, x3.y};
 3019:          xt.x = interpolate(shpCoords, xn);
 3020:          xt.y = interpolate(shpCoords, yn);
 3021:       }
 3022: 
 3023:       return res;
 3024:    }
 3025: 
 3026: 
 3027:    assert(false && "computeShapeCoords: should never reach this point");
 3028:    return false;  // Never reached
 3029: 
 3030: }
 3031: 
 3032: 
 3033: __device__ __forceinline__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 3034: // Convert shape coordinates to cartesian coordinates
 3035: 
 3036:    if (isTri()) {
 3037:       // Triangular element
 3038: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 3039:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 3040:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 3041:    }
 3042:    else {
 3043:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 3044:    }
 3045: 
 3046: }
 3047: 
 3048: 
 3049: 
 3050: __device__ __forceinline__ double Element::intPhiPhiTri(int i, int j) const {
 3051:    // return \int \phi_i*\phi_j dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3052:    
 3053:    return ((i == j) ? (2.0/12.0) : (1.0/12.0))*area;
 3054: }
 3055: 
 3056: __device__ __forceinline__ double Element::intGradPhiGradPhiTri(int i, int j) const {
 3057:    // return \int (grad phi_i).(grad phi_j) dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3058:    // gradPhi[i] is constant over a linear triangle, so the integral is area * dot(gradPhi[i], gradPhi[j]).
 3059:    assert(isTri() && i >= 0 && j >= 0 && i < 3 && j < 3);
 3060:    return area * dot(gradPhi[i], gradPhi[j]);
 3061: }
 3062: 
 3063: __device__ __forceinline__ double Element::intPhiPhiQuad(int i, int j, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3064:    // return \int \phi_i*\phi_j dA for quads, where phi_i and phi_j are the shape functions of the nodes i and j.
 3065:    // The integral can be computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 3066:    // The formula for the integral is:
 3067:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 3068:    
 3069:    const double xi_term  = 1.0 + (xi_n(i) * xi_n(j))/3.0;
 3070:    const double eta_term = 1.0 + (eta_n(i)*eta_n(j))/3.0;
 3071:    const double eta_sum  = eta_n(i) + eta_n(j);
 3072:    const double xi_sum   = xi_n(i)  + xi_n(j);
 3073: 
 3074:    const double detJ_xi  = detJ_xi_quad (x0, x1, x2, x3);  // XXXXX put the 8 inside the function??? xi derivative of the Jacobian determinant
 3075:    const double detJ_eta = detJ_eta_quad(x0, x1, x2, x3);  // eta derivative of the Jacobian determinant
 3076: 
 3077: 
 3078:    return (1.0/16.0)*area*xi_term*eta_term + (1.0/12.0)*(detJ_eta*xi_term*eta_sum + detJ_xi*eta_term*xi_sum);
 3079: }
 3080:    
 3081: 
 3082: __device__ __forceinline__ double Element::intGradPhiGradPhiQuad(int i1, int i2, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3083:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3084:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 3085:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 3086:    // The formula is also based on the identity:
 3087:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 3088:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 3089: 
 3090:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: bad ranges");
 3091: 
 3092: 
 3093: 
 3094:    double res = 0.0;
 3095:    
 3096:    // Quadrature points in xi and eta coordinates
 3097:    #pragma unroll
 3098:    for (int i = 0; i < 4; i++) {
 3099:       // For each quadrature point...
 3100: 
 3101:       const Point2 p = GaussPoint(i);  // Quadrature point in (eta,xi) coordinates
 3102:       const double eta = p.x;
 3103:       const double xi  = p.y;
 3104: 
 3105:       // Jacobian entries at the Gauss point p
 3106:       const double dx_dxi  = 0.25 * ( (x1.x + x2.x - x0.x - x3.x) + eta*(x0.x + x2.x - x1.x - x3.x) );
 3107:       const double dx_deta = 0.25 * ( (x2.x + x3.x - x0.x - x1.x) + xi *(x0.x + x2.x - x1.x - x3.x) );
 3108:       const double dy_dxi  = 0.25 * ( (x1.y + x2.y - x0.y - x3.y) + eta*(x0.y + x2.y - x1.y - x3.y) );
 3109:       const double dy_deta = 0.25 * ( (x2.y + x3.y - x0.y - x1.y) + xi *(x0.y + x2.y - x1.y - x3.y) );      
 3110: 
 3111:       const double detJ = detJ_quad(p, x0, x1, x2, x3);
 3112:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3113: 
 3114:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3115:       const double dPhi_dxi_1  = dPhi_dxi_quad (i1, p);
 3116:       const double dPhi_deta_1 = dPhi_deta_quad(i1, p);
 3117:       const double dPhi_dxi_2  = dPhi_dxi_quad (i2, p);
 3118:       const double dPhi_deta_2 = dPhi_deta_quad(i2, p);
 3119: 
 3120:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3121:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3122:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3123:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3124:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3125: 
 3126:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3127:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3128:    }
 3129: 
 3130:    return res;
 3131: }
 3132: 
 3133: 
 3134: /**  Interpolate velocities at a given point (xt,yt,zt)
 3135: 
 3136:    @param xt, yt, zt: coordinates of the point to interpolate
 3137:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3138: 
 3139:    This is done in four steps:
 3140: 
 3141:    1. Find the shape coordinates for the final position in the element.
 3142:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3143:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3144:       z levels at xt, yt at each step.   
 3145:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3146:       horizontally and vertically.
 3147: **/
 3148: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3149:    // Interpolate the velocities at the point xt. 
 3150:    // This function works the same for triangular and quadrilateral elements.
 3151:    double shpCoord[4];
 3152:    Vector3 u_int;
 3153: 
 3154: 
 3155:    // First step is to compute the shape coordinates of (xt,yt)
 3156: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3157:    computeShapeCoords(toVector2(xt), shpCoord, fiAnywhere, origSide);
 3158: 
 3159:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 3160: 
 3161:    // Second step is to find the level that contains zt
 3162:    // Uses a binary search to find the level
 3163:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3164:    // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3165:    int L = kb - 1; // In some cases, the bottom level of the element is 1 more than the bottom level of the node XXXX (Check)
 3166:    int R = nvrt - 1;
 3167: 
 3168:    // Get the z coordinates at the nodes of the element at the levels L and R
 3169:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3170:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3171:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3172: 
 3173: 
 3174:    double zL = interpolate(shpCoord, zLAtNodes);
 3175:    double zR = interpolate(shpCoord, zRAtNodes);
 3176: 
 3177:    // Interpolates vertically the velocities
 3178:    double wght1, wght2;
 3179:    if (xt.z <= zL) {
 3180:       wght1 = 1.0;
 3181:       wght2 = 0.0;
 3182:       xt.z = zL;
 3183:    }
 3184:    else if (xt.z >= zR) {
 3185:       wght1 = 0.0;
 3186:       wght2 = 1.0;
 3187:       xt.z = zR;
 3188:    }
 3189:    else {
 3190:       // Perform a binary search to find the levels between L and R that contain xt.z
 3191:       while (R - L > 1) {
 3192:          int M = (L + R) / 2.0;
 3193: 
 3194:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3195:          double zM = interpolate(shpCoord, zMAtNodes);
 3196:          if (zM < xt.z) 
 3197:          {
 3198:             L = M;
 3199:             zL = zM;
 3200:          }
 3201:          else 
 3202:          {
 3203:             R = M;
 3204:             zR = zM;
 3205:          }
 3206:       }
 3207:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3208:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3209: 
 3210:       wght2 = (xt.z - zL)/(zR - zL);
 3211:       wght1 = 1.0 - wght2;
 3212: 
 3213:    }
 3214: // printf("XXYYX element %d, L = %d, R = %d, zL = %.17f, zR = %.17f, xt.z = %.17f, wght1 = %.17f, wght2 = %.17f\n", idx, L, R, zL, zR, xt.z, wght1, wght2);
 3215: // printf("HEREEEEEE 3, wght1 = %.17f, wght2 = %.17f, shpCoord = (%.17f, %.17f, %.17f, %.17f)\n", wght1, wght2, shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 3216:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3217:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3218:    Vector2 uv = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3219:    double w   = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3220: 
 3221:    // Project the velocity from the local frame to the origSide frame
 3222:    if constexpr(ics == 2) uv = frame.projHorVec(uv, origSide->frame);
 3223:    u_int = {uv.x, uv.y, w};
 3224: 
 3225:    // Neither of the interpolated velocities should be NaN
 3226:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3227: 
 3228:    return u_int;
 3229: 
 3230: }
 3231: 
 3232: 
 3233: 
 3234: 
 3235: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3236: 
 3237:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3238:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3239:    const Node *n1 = side->n1;
 3240:    const Node *n2 = side->n2;
 3241: 
 3242:    bool n1_match = (n1->nodeBnd->segment == segment);
 3243:    bool n2_match = (n2->nodeBnd->segment == segment);
 3244: 
 3245:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3246:    if (n1_match && n2_match) {
 3247:       return 0.5;
 3248:    } else if (n1_match) {
 3249:       return 1.0;
 3250:    } else if (n2_match) {
 3251:       return 0.0;
 3252:    }
 3253: 
 3254:    return 0.0;
 3255: }
 3256: 
 3257: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3258: 
 3259: 
 3260: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 3261: 
 3262:    const double w1 = getBoundaryArrayValueWeight();
 3263:    const double w2 = 1.0 - w1;
 3264:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3265:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3266: 
 3267:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 3268: }
 3269: 
 3270: 
 3271: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 3272:    const double w1 = getBoundaryArrayValueWeight();
 3273:    const double w2 = 1.0 - w1;
 3274:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3275:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3276: 
 3277:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 3278: 
 3279: }
 3280: 
 3281: 
 3282: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 3283:    // Returns the value of the velocity at the side center
 3284:    const double w1 = getBoundaryArrayValueWeight();
 3285:    const double w2 = 1.0 - w1;
 3286:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3287:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3288: 
 3289:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 3290: }
 3291: 
 3292: 
 3293: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 3294:    // Returns the value of the normal component of the velocity at the side center
 3295:    const double w1 = getBoundaryArrayValueWeight();
 3296:    const double w2 = 1.0 - w1;
 3297:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3298:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3299: 
 3300:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 3301: }
 3302: 
 3303: 
 3304: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3305:    if constexpr(ics == 1) {
 3306:       return center;
 3307: 
 3308:    } else {
 3309:       const Point2 p0 = n1->outputCoords();
 3310:       const Point2 p1 = n2->outputCoords();
 3311:       return (1.0/2.0)*(p0 + p1);
 3312: 
 3313:    }
 3314: }
 3315: 
 3316: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3317: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3318: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3319: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3320: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3321: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3322: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3323: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3324: // Computes the gradient of the field at the side center.
 3325:    Vector2 grad = {0.0, 0.0};
 3326:    int count = 0;
 3327: 
 3328:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3329:    // as the average of the gradients at each element.
 3330:    // First element
 3331:    if (elems[0] != nullptr && condition(elems[0])) {
 3332:       Vector2 elemGrad = elems[0]->grad2(field);
 3333: 
 3334:       // For ics=2, projects the element gradient from its frame to the side frame
 3335:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3336: 
 3337:       grad += elemGrad;
 3338: 
 3339:       count++;
 3340:    }
 3341: 
 3342:    // Second element
 3343:    if (elems[1] != nullptr && condition(elems[1])) {
 3344: 
 3345:       Vector2 elemGrad = elems[1]->grad2(field);
 3346: 
 3347:       // For ics=2, projects the element gradient from its frame to the side frame
 3348:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3349: 
 3350:       grad += elemGrad;
 3351: 
 3352:       count++;
 3353:    }
 3354: 
 3355:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3356:    if (count > 0) {
 3357:       grad = grad*(1.0/count);
 3358:    }
 3359:    
 3360:    return grad;
 3361: }
 3362: 
 3363: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 3364: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 3365: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 3366: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 3367: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 3368: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 3369: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 3370: 
 3371: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 3372: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 3373: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 3374: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
