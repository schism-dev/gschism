 2869: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2870: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2871: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 2872: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 2873: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2874: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 2875: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2876: // Computes the gradient of the field at the side center.
 2877:    Vector2 grad = {0.0, 0.0};
 2878:    int count = 0;
 2879: 
 2880:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 2881:    // as the average of the gradients at each element.
 2882:    // First element
 2883:    if (elems[0] != nullptr && condition(elems[0])) {
 2884:       Vector2 elemGrad = elems[0]->grad2(field);
 2885: 
 2886:       // For ics=2, projects the element gradient from its frame to the side frame
 2887:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 2888: 
 2889:       grad += elemGrad;
 2890: 
 2891:       count++;
 2892:    }
 2893: 
 2894:    // Second element
 2895:    if (elems[1] != nullptr && condition(elems[1])) {
 2896: 
 2897:       Vector2 elemGrad = elems[1]->grad2(field);
 2898: 
 2899:       // For ics=2, projects the element gradient from its frame to the side frame
 2900:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 2901: 
 2902:       grad += elemGrad;
 2903: 
 2904:       count++;
 2905:    }
 2906: 
 2907:    // If there are valid elements, returns the average of the gradients at the side's frame.
 2908:    if (count > 0) {
 2909:       grad = grad*(1.0/count);
 2910:    }
 2911:    
 2912:    return grad;
 2913: }
 2914: 
 2915: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 2916: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 2917: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 2918: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 2919: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 2920: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 2921: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 2922: 
 2923: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 2924: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 2925: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 2926: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 2927: 
 2928: 
 2929: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 2930: 
 2931: __inline__ __device__ Vector2 Side::tau(void)    const { 
 2932:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 2933:    if constexpr(ics == 1) { 
 2934:       return 0.5*(n1->tau + n2->tau);
 2935: 
 2936:    } else {
 2937:       // Project the tau from the node frames to the side frame
 2938:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 2939:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 2940: 
 2941:       return 0.5*(stau1 + stau2);
 2942:    }
 2943: }
 2944: 
 2945: /**
 2946:  * This method performs backtracking from the side center until a time -dt back in time 
 2947:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2948:  * intermediate point.
 2949:  *
 2950:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2951:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2952:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2953:  * remaining time.
 2954:  * 
 2955:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2956:  * 
 2957:  * @param uuint, vvint, wwint: Velocities at the final point
 2958:  * @param jlev: Level at which the backtracking is performed
 2959:  * @param dt, dtbk: Tracking timesteps
 2960:  * @return: True if the backtracking was successful, false otherwise
 2961:  */
 2962: __inline__ __device__ bool Side::btrack(
 2963:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 2964:       double dt,            // Tracking time
 2965:       double dtbk,          // Tracking timestep
 2966:       Vector3 &u_int        // Velocities at the initial point
 2967: ) const {
 2968: 
 2969:    // Start from side center
 2970:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2971: 
 2972:  
 2973:    double time_rm = dt; // Remaining time
 2974: 
 2975: 
 2976:    // Initial velocities
 2977:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 2978: 
 2979:    // Find the element that is in the direction opposite to the velocity
 2980:    Element* curElem = findElementTowards(toVector2(u_int));
 2981:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 2982: 
 2983: 
 2984:    // Nudges it towards the barycenter
 2985:    curElem->nudgeToBarycenter(toPoint2(x0)); // XXXX Necessary?
 2986: 
 2987: 
 2988:    const int MAX_ITERATIONS = 100; 
 2989:    Element* nextElem = nullptr;
 2990:    int iter = 0;
 2991:    // assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 2992:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 2993:    while(true) {
 2994: 
 2995:       // Calculate timestep
 2996:       double dtb = min(dtbk, time_rm);
 2997: 
 2998: // if (idx == 18867) printf("iter = %d, side->idx = %d, curElem->idx = %d, dtb = %.17f, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, curElem->idx, dtb, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);      
 2999: 
 3000:       // Next point in the backtracking curve
 3001: // if (iter >= MAX_ITERATIONS - 50)  {
 3002: //    printf("iter = %d, side->idx = %d, dtb = %.17f, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, dtb, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);
 3003: //    addDebugPlot(x0, x0 - dtb*u_int, 0xFF00FF, '+');        
 3004: // }
 3005:         
 3006:       xt = x0 - dtb*u_int;
 3007: 
 3008:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, time_rm, this);
 3009:       assert(found && "Backtracking failed in btrack");
 3010: 
 3011: 
 3012:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 3013:                       // then time_rm needs to be increased by the unused time.
 3014: 
 3015:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0                      
 3016: 
 3017:       // If the velocity is too small, we stop the backtracking
 3018:       const double vmag = length(toVector2(u_int));
 3019:       if (vmag <= velmin_btrack) break;
 3020: 
 3021:       // The current point becomes the next segment's starting point.
 3022:       x0 = xt;
 3023:  
 3024:       curElem = nextElem;
 3025: 
 3026:       iter++;
 3027: 
 3028:       if (iter >= MAX_ITERATIONS) break;
 3029: 
 3030:       // if (iter >= MAX_ITERATIONS - 50) {
 3031:       //    addDebugPlot(center, center, 0xFF001F, 'x');  
 3032:       //    printf("iter = %d, side->idx = %d, elems[0]->idx = %d, elems[1]->idx = %d, curElem->idx = %d, time_rm = %.17f, dtb = %.17f, u_int = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f)\n", iter, idx, elems[0]->idx, elems[1]->idx, curElem->idx, time_rm, dtb, u_int.x, u_int.y, u_int.z, xt.x, xt.y, xt.z);      
 3033:       //    }
 3034:       // assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3035:    }
 3036: 
 3037:    assert(!curElem->isDry && "Final element is dry");
 3038:    assert(curElem->containsPoint(toPoint2(xt)) && "Target point is not inside the final element"); 
 3039: 
 3040:    // Interpolate the velocities at the final point
 3041:    u_int = curElem->interpolateVelocities(xt);
 3042: 
 3043:    // if (idx == 18867) printf("iter = %d, side->idx = %d, curElem->idx = %d, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, curElem->idx, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);         
 3044: 
 3045: 
 3046: }
 3047: 
 3048: 
 3049: 
 3050: // /**
 3051: //    For a point (x1,y1) inside the element and a line segment (x1,y1)-(x2,y2), find the intersection point 
 3052: //    (xIntersect,yIntersect) and the side (intersectingSide) that it intersects.
 3053: 
 3054: //    Inputs:
 3055: //    @param x1, y1: point inside the element
 3056: //    @param x2, y2: other end of the line segment
 3057: 
 3058: //    Outputs:
 3059: //    @param intersectingSide:  side that intersects the line segment
 3060: //    @param nextElement: element that contains the intersection point
 3061: //    @param xIntersect, yIntersect: intersection point  
 3062: 
 3063: //    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 3064: //    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 3065: //    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 3066: 
 3067: //    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 3068: //    (Delta) being zero.
