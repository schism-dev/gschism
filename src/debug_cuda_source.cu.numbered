  481: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  482:    x3 = y1*z2 - y2*z1;
  483:    y3 = x2*z1 - x1*z2;
  484:    z3 = x1*y2 - x2*y1;
  485: // XXXXXX IS THIS REPEATED????
  486: }
