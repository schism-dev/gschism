 2556:    
 2557:    __forceinline__ __device__ void Element::projectNodeVectorsToElementFrame(Vector2 *v) const {
 2558:    // Project the vectors from the node frame to the element frame
 2559: 
 2560:  
 2561:       v[0] = nodes[0]->frame.projHorVec(v[0], frame);
 2562:       v[1] = nodes[1]->frame.projHorVec(v[1], frame);
 2563:       v[2] = nodes[2]->frame.projHorVec(v[2], frame);
 2564:       if (isQuad()) v[3] = nodes[3]->frame.projHorVec(v[3], frame);
 2565:       else          v[3] = Vector2();
 2566:    }
 2567: 
 2568:    __forceinline__ __device__ void Element::projectSideVectorsToElementFrame(Vector2 *v) const {
 2569:    // Project the vectors from the side frame to the element frame
 2570: 
 2571:       v[0] = sides[0]->frame.projHorVec(v[0], frame);
 2572:       v[1] = sides[1]->frame.projHorVec(v[1], frame);
 2573:       v[2] = sides[2]->frame.projHorVec(v[2], frame);
 2574:       if (isQuad()) v[3] = sides[3]->frame.projHorVec(v[3], frame);
 2575:       else          v[3] = Vector2();
 2576:    }
