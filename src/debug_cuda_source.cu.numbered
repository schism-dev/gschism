 6664: 
 6665:    __global__ void computeVegetationAndDragParameters(void) {
 6666:       // Computes the vegetation and drag model parameters:
 6667:       // chi, \tilde\chi, beta, \breve{H}
 6668:       
 6669:       SIDE(side);
 6670: 
 6671:       side->hhat = 0.0;
 6672:       side->chi2 = 0.0;
 6673:       side->chi = 0.0;
 6674:       side->veg_c2 = 0.0;
 6675:       side->veg_beta = 0.0;
 6676: 
 6677:       if (side->isDry) return;
 6678: 
 6679:       const double htot = side->htot2();
 6680:       const int    kb   = side->kb;
 6681: 
 6682:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 6683: 
 6684:       const double veg_h     = side->veg_h();
 6685:       const double veg_nv    = side->veg_nv();
 6686:       const double veg_c     = side->veg_c();
 6687:       const double veg_beta  = side->veg_beta;
 6688:       const double veg_alpha = side->veg_alpha_vert_mean();
 6689: 
 6690:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX recommended to change names, chi->chitilde, chi2->chi
 6691:       // Velocity magnitude at the bottom level
 6692:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0 - dt*swild2(k,1) to u2 (I think this only pertains to iupwind_mom \= 0)
 6693:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 6694:       side->chi2 = side->Cd()*vmag1;
 6695:       side->chi  = side->chi2;
 6696: 
 6697:       if constexpr(iveg != 0) {
 6698:          const Node *n1 = side->n1;
 6699:          const Node *n2 = side->n2;
 6700:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 6701:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 6702:       }
 6703: 
 6704:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 6705: 
 6706:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 6707:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 6708:       double magUa = 0.0;
 6709:       if constexpr(iveg != 0) {
 6710:          if (side->is3D() && veg_h > 0.0) {
 6711:             // 3D wet side with veg...
 6712: 
 6713:             double magUa = 0.0;
 6714:             for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 6715:                if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 6716: 
 6717:                   // Velocity magnitude must be computed at the center of each level to perform the integration.
 6718:                   // The tricky part is to compute that velocity at the level that may be partially submerged.
 6719:                   const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 6720: 
 6721:                   // Velocity magnitude at the top (h) of the level (may be partially submerged)
 6722:                   const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 6723: 
 6724:                   // Velocity magnitude at the bottom (l) of the level
 6725:                   const double ul = length(side->u2[k]);
 6726: 
 6727:                   const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 6728:                   magUa += Dz*0.5*(uh + ul);
 6729: 
 6730:                } // if HasVegetation
 6731:             } // for k
 6732:             const double ua = magUa/min(htot, veg_h); // Vertical average
 6733: 
 6734:             // Computes beta, used for computing the stress term at the top of the canopy.      
 6735:             side->veg_c2 = veg_alpha*dt*ua; // >=0
 6736:             if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 6737:                const double zCpy = side->zTopCanopy();
 6738:                const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 6739:                const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 6740:                const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 6741:                const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 6742:                side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 6743:             } // if isSubmerged
 6744:          } // if is3D
 6745:       } // if iveg   
 6746: 
 6747:       // Computes the friction modified depth, \breve{H} in notes
 6748:       if (side->is2D()) { // 2D
 6749: 
 6750:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 6751:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 6752: 
 6753:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 6754: 
 6755:          side->hhat = htot*htot/fricH; 
 6756: 
 6757:       } else { // 3D
 6758:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 6759: 
 6760:          if constexpr(iveg != 0) {
 6761:             
 6762:             if (side->isSubmerged()) { 
 6763:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 6764:                side->hhat -= veg_c*Hhat_alpha;
 6765: 
 6766:             } else { // Emergent
 6767:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 6768:             }
 6769:          } // if iveg
 6770: 
 6771:          // Enforce positivity for 3D model
 6772:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 6773:       } // if 3D
 6774: 
 6775:    }
 6776: 
 6777: 
 6778: 
 6779:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 6780:    // Computes the density gradient between two elements, e1 and e2.
 6781:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 6782:    // zero in the direction normal to the side. 
 6783:    // 
 6784:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 6785:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 6786:    //
 6787:    // Input:
 6788:    //    e1: Element
 6789:    //    e2: Neighbor element (or nullptr if boundary)
 6790:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 6791:    //    k: Index of the half-level at which the density is interpolated
 6792:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 6793:    // 
 6794:    // Output:
 6795:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 6796:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 6797: 
 6798:       if (e2 == nullptr || e2->isDry) {
 6799:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 6800: 
 6801:          Side *side = e1->sides[j];
 6802:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 6803:                  
 6804:          if constexpr(ics == 1) {
 6805:             vec = side->n; // Normal vector to the side
 6806:          } else {
 6807:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6808:             // IMPLEMENT THIS XXXXXX
 6809:             // !replace with xel, yel?
 6810:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 6811:             //      &eframe(:,:,i),xn1,yn1,tmp)
 6812:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 6813:             //      &eframe(:,:,i),xn2,yn2,tmp)
 6814:          } //ics
 6815:                    
 6816:          diffRho = 0.0;
 6817: 
 6818:       } else { //internal and wet
 6819:          if constexpr(ics==1) {
 6820:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 6821: 
 6822:             // Vector from e1 to e2
 6823:             vec = e2->center - e1->center;
 6824: 
 6825:          } else { 
 6826:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6827:             // Remember that elem->center is in global coordinates
 6828:             // IMPLEMENT THIS XXXXXX
 6829:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 6830:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 6831:             //                   alow(j)=xctr2
 6832:             //                   bdia(j)=yctr2
 6833:          } // ics
 6834: 
 6835:          diffRho = rho2 - e1->demeanedDensity(k);
 6836:       }
 6837: 
 6838:    }
 6839: 
 6840:    __global__ void computeDensityCubicSplines(void) {
 6841:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 6842: 
 6843:       ELEM(elem);
 6844: 
 6845:       if (elem->isDry) return;
 6846: 
 6847:       const int kb = elem->kb;
 6848: 
 6849:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 6850:       if (elem->is2D()) {
 6851:          // In the 2D case, the density is constant at the prism level. 
 6852:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 6853:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 6854:       } else { //3D
 6855: 
 6856:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 6857:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 6858:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 6859:          ///// XXXX CHECK INDICES!!!!!
 6860:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 6861:       } // 2D/3D
 6862: 
 6863:    }
 6864: } // extern "C"
 6865: 
 6866: 
 6867: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 6868: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 6869: 
 6870:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 6871: 
 6872:    const int kb  = elem->kb;
 6873:    const int kb2 = elem2->kb;
 6874: 
 6875:    // z-coordinate of prism of elem
 6876:    const double zp = elem->z_prism(k);
 6877: 
 6878:    double rho = 0.0;
 6879: 
 6880:    if (elem2->is2D()) {
 6881:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 6882: 
 6883:    } else {  // 3D
 6884: 
 6885:       // eta_min may be < zmax
 6886:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 6887:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 6888: 
 6889:       // (Extrapolate density below bottom, we will fix it later)
 6890:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 6891:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 6892:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 6893:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 6894:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 6895:    } // 2D/3D
 6896:      
 6897: 
 6898:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 6899:    // Now we need to fix it.
 6900:    if (elem->z[k] < elem2->z[kb2]) {
 6901:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 6902: 
 6903:       // There are two methods to adjust the density at the bottom of the element.
 6904:       // iunder_deep=0: 
 6905:       const double depth1 = abs(elem->z[kb]); // larger depth
 6906: 
 6907:       if (iunder_deep==0) {
 6908: 
 6909:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 6910: 
 6911:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 6912: 
 6913:       } else { // iunder_deep != 0
 6914: 
 6915:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 6916: 
 6917:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 6918: 
 6919:          //   Demeaned density at the same z coordinate as
 6920:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 6921:          }
 6922: 
 6923:       } // if iunder_deep
 6924:    } // if elem->z[kb] < elem2->z[kb]
 6925: 
 6926:    return rho;
 6927: }
 6928: 
 6929: 
 6930: extern "C" {
 6931:    __global__ void computeDensityGradient(void) {
 6932: 
 6933:       assert(ibc == 1 && "baroclinic formulation is not implemented yet: ibc != 0");
 6934:       if constexpr(ibc != 0) return;
 6935: 
 6936:          // Compute the horizontal density gradient at each element.
 6937:       // It works in two steps:
 6938:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6939:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6940:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6941:       //             gradRho.r1 = rho1 - rho0
 6942:       //             gradRho.r2 = rho2 - rho0
 6943:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6944:       // 
 6945:       //  NOTE: We use de-meaned densities.
 6946: 
 6947:       ELEM(elem);
 6948: 
 6949:       if (elem->isDry) return;
 6950: 
 6951:       const int kb  = elem->kb;
 6952:       const int i34 = elem->i34;
 6953: 
 6954:       for (int k = kb + 1; k < nvrt; k++) {
 6955:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 6956:          //             gradRho.r1 = rho1 - rho0
 6957:          //             gradRho.r2 = rho2 - rho0
 6958:          int icount = 0;
 6959:          double sumRx = 0.0;
 6960:          double sumRy = 0.0;
 6961:          for (int j1=0; j1<i34; j1++) { 
 6962: 
 6963:             const int j2 = elem->nxq(j1 + 1);
 6964: 
 6965:             // Pairs of consecutive neighbor elements of elem
 6966:             const Element *e1 = elem->nghbElems[j1];
 6967:             const Element *e2 = elem->nghbElems[j2];
 6968: 
 6969:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 6970:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 6971:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 6972: 
 6973:             // Compute the density difference and the vector from elem to e1 and e2
 6974:             // getRhoDiffAndVec takes into account boundaries/dry elements
 6975:             double diffRho1, diffRho2;
 6976:             Vector2 vec1, vec2;
 6977:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 6978:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 6979: 
 6980:             const double rl1 = length(vec1);
 6981:             const double rl2 = length(vec2);
 6982:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 6983: 
 6984:             const double delta = cross(vec1, vec2);
 6985:             const double sintheta = abs(delta)/(rl1*rl2);
 6986: 
 6987:             // To avoid problems, avoid elements with small angle between vectors
 6988:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 6989:             const bool validEq = (sintheta > sin_one_deg);
 6990: 
 6991:             if (validEq) {
 6992:                // Solve the system of equations to get the density gradient at elem
 6993:                icount++;
 6994:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 6995:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 6996:                sumRx += Rx;
 6997:                sumRy += Ry;
 6998:             }
 6999:          } // for j1
 7000: 
 7001:          // Compute the average density gradient at elem
 7002:          if (icount==0) {
 7003:            // Bad mesh quality; bail out with 0 b-cc
 7004:            elem->gradRho[k] = {0.0, 0.0};
 7005:          } else {
 7006:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 7007:          }
 7008: 
 7009:       } // for k
 7010: 
 7011:    }
 7012: 
 7013:    __global__ void computeBaroclinicTerm(void) {
 7014:    // Computes the baroclinic term at sides (at half levels).
 7015:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 7016:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 7017: 
 7018:       if (ibc == 1) return;
 7019: 
 7020:       SIDE(side);
 7021: 
 7022:       if (side->isDry) return;
 7023: 
 7024:       const Element *e1 = side->elems[0];
 7025:       const Element *e2 = side->elems[1]; 
 7026:       const int kb = side->kb;
 7027:       
 7028:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 7029: 
 7030:       // interpolates vertically the density gradient of the two elements at the half level/
 7031: 
 7032:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 7033:       int k2 = max(kb, nvrt / 2);
 7034: 
 7035:       // Starts the integration at the surface and goes down to the bottom
 7036:       side->bcc[nvrt-1] = {0.0, 0.0};
 7037:       for (int k = nvrt - 2; k >= kb; k--) {
 7038:       // For each prism level (from surface to bottom)...
 7039: 
 7040:          // For both elements, interpolate density gradient at the side's half level.
 7041:          // The gradient at the side is the average of the gradients at the elements.
 7042:          // w1, w2 are used to take into account boundary sides, with just one element.
 7043:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 7044:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 7045:          const double wsum = w1 + w2;
 7046:          w1 = w1/wsum;
 7047:          w2 = w2/wsum;
 7048:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 7049: 
 7050:          // Linear interpolation of both elements' density gradient at the shared side's level.
 7051:          Vector2 gradRho = {0.0, 0.0};
 7052:          if (e1 != nullptr && k > kb) {
 7053:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 7054:             
 7055:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 7056:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 7057:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 7058: 
 7059:             // Grad(rho) vertically interpolated at the side's half level
 7060:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 7061: 
 7062:             // Projects the element density gradient to the side frame if needed.
 7063:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 7064: 
 7065:             // Adds the contribution of the density gradient at the side's half level
 7066:             gradRho += gradRho1*w1;
 7067:          }      
 7068:          if (e2 != nullptr && k > kb) {
 7069:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 7070:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 7071:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 7072:             
 7073:             // Grad(rho) vertically interpolated at the side's half level
 7074:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 7075: 
 7076:             // Projects the element density gradient to the side frame if needed.
 7077:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 7078: 
 7079:             // Adds the contribution of the density gradient at the side's half level
 7080:             gradRho += gradRho2*w2;
 7081:          }
 7082: 
 7083:          
 7084:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 7085:          // multiplied by -rampbc*(g/rho0) 
 7086:          const double grav3 = side->grav3();
 7087:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 7088: 
 7089:       } // for
 7090: 
 7091:    }
 7092: 
 7093: 
 7094: 
 7095:    __global__ void computeHorGradientAtSide(void) {
 7096: 
 7097:       // Compute the horizontal density gradient at each element.
 7098:       // It works in two steps:
 7099:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 7100:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 7101:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 7102:       //             gradRho.r1 = rho1 - rho0
 7103:       //             gradRho.r2 = rho2 - rho0
 7104:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 7105:       // 
 7106:       //  NOTE: We use de-meaned densities.
 7107: 
 7108:       SIDE(side);
 7109: 
 7110: 
 7111:       if (side->isDry) return;
 7112: 
 7113:       // Computes the gradient of the variables at the side center.
 7114:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 7115:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 7116:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 7117: 
 7118:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 7119:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 7120:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 7121:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 7122: 
 7123:    }
 7124: 
 7125: 
 7126:    __global__ void solveMomentumEquations(double time) {
 7127: 
 7128:       double alow[nvrt], cupp[nvrt], bdia[nvrt]; // a = low, c = up, b = diag
 7129:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 7130: 
 7131:       SIDE(side);
 7132: 
 7133:       if (side->isDry) 
 7134:       {
 7135:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 7136: 
 7137:          return;
 7138:       }
 7139: 
 7140:       const Node *n1 = side->n1;
 7141:       const Node *n2 = side->n2;
 7142: 
 7143:       const int kb = side->kb;
 7144: 
 7145:       const double veg_h = side->veg_h();
 7146:       const double grav3 = side->grav3();
 7147: 
 7148:       if (side->is2D()) {
 7149:          // Remember: Do not use htot2, which is updated.
 7150:          const double htot = side->htot1();
 7151:          const double hhat = side->hhat;
 7152: 
 7153:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 7154: 
 7155:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 7156:          const Vector2 tau2 = side->tau();
 7157: 
 7158:          // hat_gam has units of m/s
 7159: 
 7160:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 7161:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 7162:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 7163: 
 7164:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 7165: 
 7166: 
 7167:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 7168: 
 7169:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 7170: 
 7171:       }
 7172:       else { // 3D
 7173: 
 7174:          // For 3D it is necessary to solve an implicit tridiagonal system.
 7175:          // 
 7176:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 7177:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 7178:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 7179:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 7180:          // k+1 and k.
 7181: 
 7182: 
 7183:          const int ndim = nvrt - kb;
 7184:          const double zTopCanopy = side->zTopCanopy();
 7185: 
 7186:          // Initialize the tridiagonal system
 7187:          for (int k = kb + 1; k < nvrt; k++) {
 7188:             
 7189:             const int kin = k - (kb + 1);
 7190: 
 7191:             // Vertical viscosity at the face center
 7192:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 7193: 
 7194:  
 7195:             alow[kin] = 0.0;
 7196:             cupp[kin] = 0.0;
 7197:             bdia[kin] = 0.0;
 7198: 
 7199:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 7200:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 7201: 
 7202:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 7203:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 7204:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 7205: 
 7206:             // First part: layers k, k+1
 7207:             if (k < nvrt - 1) {
 7208:                              
 7209:                if constexpr(iveg != 0) {
 7210: 
 7211:                   // If there is vegetation at this level...
 7212:                   if (zTopCanopy > side->zc[k]) {
 7213:                      // If the canopy is above the k layer...
 7214:                      
 7215:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 7216:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 7217:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 7218:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 7219: 
 7220:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 7221:                      const double vmag2 = length(ut2);
 7222:                      const double vmag1 = length(side->u2[k]);
 7223:                      const double vmag = 0.5*(vmag1 + vmag2);
 7224:                      
 7225:                      // Computes the vegetation alpha at the face center
 7226:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 7227: 
 7228:                      cff1 += veg_alpha_sd*dt*vmag;
 7229: 
 7230:                   } // if (zTopCanopy
 7231:                } // if iveg
 7232: 
 7233:                const double dzz = side->Dz(k + 1);
 7234:                const double tmp = dt*dfz/dzz;
 7235:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 7236: 
 7237:                cupp[kin] += cff1*dzz/6.0 - tmp;
 7238:                bdia[kin] += cff1*dzz/3.0 + tmp;
 7239:             }
 7240: 
 7241: 
 7242:             // Second part: layers k-1, k
 7243:             if (k > kb + 1) {
 7244: 
 7245:                double cff1 = 1.0; //init \bar{c^k}
 7246: 
 7247:                if constexpr(iveg != 0) {
 7248:                   // If there is vegetation at this level...
 7249:                   if (zTopCanopy > side->zc[k-1]) {
 7250:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 7251:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 7252: 
 7253:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 7254: 
 7255:                      const double vmag2 = length(ut2);
 7256:                      const double vmag1 = length(side->u2[k-1]);
 7257:                      const double vmag = 0.5*(vmag1 + vmag2);
 7258: 
 7259:                      // Computes the vegetation alpha at the face center
 7260:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 7261:                      cff1 += veg_alpha_sd*dt*vmag;
 7262:                   } // if zTopCanopy
 7263: 
 7264:                } // if iveg
 7265: 
 7266:                const double dzz = side->Dz(k);
 7267:                const double tmp = dt*dfz/dzz;
 7268:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 7269: 
 7270:                alow[kin] += cff1*dzz/6.0 - tmp;
 7271:                bdia[kin] += cff1*dzz/3.0 + tmp;
 7272: 
 7273:             } else { // Bottom boundary
 7274:                // This occurs at the bottom, where the bottom drag is applied.
 7275: 
 7276:                bdia[kin] += dt*side->chi2; // XXXX
 7277: 
 7278:             } // if (k > kb + 1)
 7279: 
 7280: 
 7281:          } // for (int k
 7282: 
 7283: 
 7284: 
 7285:          // Computes the RHS.
 7286:          // -----------------
 7287: 
 7288:          //	BC to be imposed at the end.
 7289: 
 7290:          const Vector2 gradETP  = side->gradETP;
 7291:          const Vector2 gradPr   = side->gradPr;
 7292:          const Vector2 gradEta1 = side->gradEta1;
 7293:          const Vector2 gradEta2 = side->gradEta2;
 7294: 
 7295:          const Vector2 *btu = side->btu;
 7296:          const Vector2 *u2  = side->u2;
 7297:          const double coriolis = side->coriolis;
 7298:          const Vector2 *nuGradU = side->nuGradU;
 7299: 
 7300:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 7301:          for (int k = kb + 1; k < nvrt; k++) {
 7302:             const int kin = k - kb - 1;
 7303: 
 7304:             const double dz_0 = side->Dz(k);
 7305:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 7306: 
 7307:             rrhs[kin] = {0.0, 0.0};
 7308:             double dz = 0.0;
 7309: 
 7310:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 7311:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 7312:             if (k < nvrt  ) dz += dz_1;
 7313:             if (k > kb + 1) dz += dz_0;
 7314: 
 7315:             // Elevation gradient, atmospheric pressure and tidal potential
 7316:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 7317: 
 7318:             // Coriolis, advection, wind stress, and horizontal viscosity
 7319:             if (k < nvrt - 1) {
 7320: 
 7321: 
 7322:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 7323:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 7324:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 7325:                                                 
 7326: 
 7327:                //diff stress tensors 1006
 7328:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 7329:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 7330:                   assert(false && "Not implemented: itur == 5");
 7331:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 7332:                }
 7333:                // else assert(false && "itur # Not implemented");
 7334: 
 7335:             } else { // k == nvrt - 1 SURFACE
 7336:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 7337:                const Vector2 tau2 = side->tau();
 7338: 
 7339:                rrhs[kin] += dt*tau2;          
 7340: 
 7341:             } // if k<nvrt
 7342: 
 7343: 
 7344:             if (k > kb + 1) {
 7345:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 7346:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 7347:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 7348: 
 7349:                // diff stress tensors 1006
 7350:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 7351:                   assert(false && "Not implemented: itur == 5");
 7352:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 7353:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 7354:                }
 7355:                // else assert(false && "itur # Not implemented");
 7356: 
 7357: 
 7358:             } // if k>kbs + 1
 7359: 
 7360:             // Baroclinic
 7361:             Vector2 *bcc = side->bcc;
 7362:             if constexpr(ibc == 0) {
 7363:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 7364:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 7365: 
 7366:             } // if ibc==0
 7367: 
 7368:          } // k=kb + 1,nvrt
 7369: 
 7370: 
 7371:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 7372: 
 7373:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 7374:             const int kin = k - kb - 1;
 7375:    
 7376:             // Velocity is always clamped to maximum values
 7377:             side->u2[k] = clampVelocity(soln[kin]);
 7378:          } // k
 7379: 
 7380:       } // if side->is2D()
 7381:       
 7382: 
 7383:       // Impose velocity boundary condition at the bottom
 7384:       if constexpr(imm == 2) { // 3D bed deformation model
 7385:          double dep;
 7386:          Vector2 vel;
 7387: 
 7388:          assert(false && "Not implemented: imm == 2");
 7389:          //update_bdef(time, x0, y0, dep, vel);
 7390:          // side->u2[kb] = vel;
 7391: 
 7392:       } else { // imm = 0 or 1
 7393:          if (side->Cd() == 0.0) {
 7394:             side->u2[kb] = side->u2[kb + 1];
 7395: 
 7396:          } else if (side->is3D()) { // 3D no slip bottom   
 7397:             side->u2[kb] = {0.0, 0.0};
 7398: 
 7399:          }
 7400:           
 7401:       } // if imm
 7402: 
 7403:       // The velocities below the bottom level are set to zero
 7404:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 7405: 
 7406: 
 7407:    }
 7408: 
 7409: 
 7410:    __global__ void applyMomentumBC(void) {
 7411: 
 7412:       SIDE_BND(sideBnd);
 7413: 
 7414:       Side *side = sideBnd->side;
 7415:       const BoundarySegment *segment = sideBnd->segment;
 7416:       const Node *n1 = side->n1;
 7417:       const Node *n2 = side->n2;
 7418: 
 7419:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 7420: 
 7421:       const bool isLand = segment->isLand;
 7422:       const int ifltype = segment->ifltype;
 7423: 
 7424:       const int kb = side->kb;
 7425: 
 7426: 
 7427:       if (!isLand && ifltype != 0) {
 7428:          const Vector2 *ubc = sideBnd->ubc;
 7429:   
 7430:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 7431:             
 7432:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 7433:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 7434: 
 7435:             if (ifltype == -1) {
 7436:                // Flather 1
 7437: 
 7438:                const double depth = side->depth();
 7439: 
 7440:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 7441: 
 7442:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 7443: 
 7444:                side->u2[k] = vnorm*side->n;
 7445: 
 7446:             } else if (ifltype == -2) { // Discharge
 7447: 
 7448:                const double eta1 = side->eta1();
 7449:                const double eta2 = side->eta2();
 7450:                const double htot = side->htot2();
 7451: 
 7452:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 7453:                assert(false && "Not implemented: Discharge bc");
 7454:                // const double dischrg = discharge(eta1);
 7455:                const double dischrg = 0.0; // XXX REMOVE
 7456:                
 7457: 
 7458:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 7459: 
 7460:                const double vnorm = dischrg*eta2/htot;
 7461: 
 7462:                side->u2[k] = vnorm*side->n;
 7463: 
 7464:             }
 7465:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 7466:                const double vnorm = dot(side->u2[k], side->n);
 7467: 
 7468:                double rat;
 7469:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 7470:                else              rat = segment->vobc2; // outgoing
 7471: 
 7472:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 7473: 
 7474:             }
 7475:             else { // not Flather or 3D radiation
 7476:                side->u2[k] = ubc[k];
 7477: 
 7478:             } // if (segment->ifltype...
 7479: 
 7480:          }
 7481: 
 7482:       }
 7483:       else if (isLand) { // if it is land boundary side
 7484: 
 7485:          if constexpr(islip == 0) { // free slip
 7486: 
 7487:             for (int k = kb; k < nvrt; k++) {
 7488: 
 7489:                const Vector2 t = side->t();
 7490:                const Vector2 n = side->n;
 7491: 
 7492:                double vnorm = 0.0; // for most cases
 7493:                const double vtan = dot(side->u2[k], t);
 7494:                
 7495:                side->u2[k] = vtan*t - vnorm*n;
 7496: 
 7497:             }
 7498: 
 7499:          } else { // no slip
 7500:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 7501: 
 7502:          }
 7503:       } // if (side segment type...
 7504: 
 7505:    }
 7506: 
 7507: 
 7508:    __global__ void shapiroFilter1(void) {
 7509:       // First step of the Shapiro filter (normally used if indvel<=0)
 7510:       // Computes the filtered values and stores them in bcc (as a temporary array).
 7511: 
 7512:       SIDE(side);
 7513: 
 7514:       // Only internal wet sides are processed
 7515:       if (side->isDry || !(side->isInternal())) return;
 7516: 
 7517:       const int kb = side->kb;
 7518: 
 7519:       for (int mm = 0; mm < niter_shap; mm++) {
 7520: 
 7521:          for (int k = kb + 1; k < nvrt; k++) {
 7522:             // WARNING: reusing bcc as a temporary array to store the suru values.
 7523:             Vector2 suru = {0.0, 0.0};
 7524: 
 7525:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 7526: 
 7527:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 7528: 
 7529:                int kin = k;
 7530:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 7531:                
 7532:                // Get the velocity at the neighbor's side.
 7533:                Vector2 nSideU2 = nSide->u2[kin];
 7534: 
 7535:                // Projects the velocity to the current side frame if needed.
 7536:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 7537: 
 7538:                suru += nSideU2;
 7539:             }
 7540: 
 7541:             // Reusing bcc as a temporary array to store the suru values.
 7542:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 7543: 
 7544:          }
 7545:       }
 7546:    }
 7547: 
 7548:    __global__ void shapiroFilter2(void) {
 7549:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 7550: 
 7551:       SIDE(side);
 7552: 
 7553: 
 7554:       if (side->isDry || !(side->isInternal())) return;
 7555: 
 7556:       const int kb = side->kb;
 7557: 
 7558:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 7559: 
 7560:       if (side->is2D()) {
 7561:          side->u2[kb + 1] = side->bcc[kb + 1];
 7562:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 7563: 
 7564:       } else {
 7565:          // 3D
 7566:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 7567:          
 7568:       }
 7569: 
 7570:    }
 7571: 
 7572: 
 7573:    __global__ void ul0UpdateZCoords(void) {
 7574:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 7575:       
 7576:       NODE(node);      
 7577: 
 7578: 
 7579:       if (false) { //node->isDry) { XXXXXXX
 7580: 
 7581:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 7582: 
 7583:          if constexpr(ivcor != 1) node->kb = 0;
 7584: 
 7585:       } else {
 7586: 
 7587:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 7588:          node->updateKb();
 7589: 
 7590:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 7591: 
 7592:       }
 7593: 
 7594:       // We use the temp.b field to store the previous state of isDry.
 7595:       node->tmp.b = node->isDry;
 7596: 
 7597:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 7598:       node->isDry = true;
 7599: 
 7600:    }
 7601: 
 7602:    __global__ void ul0ComputeDryElements(void)
 7603:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 7604:    {
 7605:       ELEM(elem);
 7606: 
 7607:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 7608: 
 7609:       elem->kb = 0;
 7610: 
 7611:       if (elem->isDry) return;
 7612: 
 7613: 
 7614:    //    if(elem->isDry2()) { // XXXX
 7615:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 7616:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 7617:    //        call parallel_abort(errmsg)
 7618:    //    }
 7619: 
 7620:       const Node *n1 = elem->nodes[0];
 7621:       const Node *n2 = elem->nodes[1];
 7622:       const Node *n3 = elem->nodes[2];  
 7623:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 7624: 
 7625:       // Computes element's kb as the minimum of the nodes' kb.
 7626:       const int kb1 = n1->kb;
 7627:       const int kb2 = n2->kb;
 7628:       const int kb3 = n3->kb;
 7629:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 7630: 
 7631: 
 7632:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 7633: 
 7634: 
 7635:       // Computes the element z as the mean of the nodes z.
 7636:       for (int k = elem->kb; k < nvrt; k++) {
 7637: 
 7638:          // Compute the element z as the mean of the nodes z.
 7639:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 7640:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 7641:          elem->z[k] /= elem->i34;
 7642: 
 7643:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 7644:       }
 7645:                   
 7646:    }
 7647: 
 7648:    __global__ void ul0ComputeDryNodes(void)
 7649:    // Updates node's isDry based on the elements' isDry. 
 7650:    {
 7651:       NODE(node);
 7652: 
 7653:       node->isDry = true;
 7654: 
 7655:       // A node is wet if at least one of the elements sharing it is wet.
 7656:       for (int j = 0; j < node->numElements; j++) {
 7657:          const Element *elem = node->elements[j];
 7658:          if (!elem->isDry) {
 7659:             node->isDry = false;
 7660:             break;
 7661:          }
 7662:       }
 7663: 
 7664:        
 7665:    }
 7666: 
 7667: 
 7668:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 7669:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 7670:    // node->tmp.b is true if the node was previously dry.
 7671:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 7672:    {
 7673:       NODE(node);
 7674:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 7675: 
 7676:       // Avoid this the first time step.
 7677:       if (it == iths) return;  
 7678: 
 7679:       const bool wasDry = node->tmp.b;
 7680: 
 7681: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 7682: 
 7683:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 7684: 
 7685:          for (int k=0; k < nvrt; k++) {
 7686: 
 7687:             Vector3 utmp={0.0, 0.0, 0.0};
 7688: 
 7689:             double ttmp=0.0;
 7690:             double stmp=0.0;
 7691:             int icount=0;
 7692:             for (int j = 0; j < node->numNodes; j++) {
 7693: 
 7694:                const Node *nbrNode = node->nodes[j];
 7695:                
 7696:                const bool wasNbrDry = nbrNode->tmp.b;
 7697: 
 7698:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 7699:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 7700: 
 7701:                   icount++;
 7702: 
 7703:                   // Assume small element size in wet/dry zone so pframes are close to each other
 7704:                   utmp += nbrNode->uvw2(k);
 7705:                   
 7706:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 7707:                   stmp += nbrNode->tracers[k].tracer[1]; 
 7708:                }
 7709:             }
 7710: 
 7711:             if (icount > 0) {
 7712:                const double inv_icount = 1.0/icount;
 7713:                utmp = inv_icount*utmp;
 7714:                node->u2[k]     = {utmp.x, utmp.y};
 7715:                node->w2[k]     = utmp.z;
 7716:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 7717:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 7718:             } else {
 7719:                node->u2[k] = {0.0, 0.0};
 7720:                node->w2[k] = 0.0;
 7721:                // Initialize tracers to 0.0??? XXXXX
 7722:             }
 7723:          }
 7724:       }
 7725:    }
 7726: 
 7727:   
 7728:    
 7729: 
 7730: 
 7731:    __global__ void ul0UpdateSides(int it, int iths) {
 7732:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 7733:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 7734:    // The dryness of the sides is updated in ul0UpdateSides2.
 7735: 
 7736:       SIDE(side);
 7737: 
 7738:       // A side is wet if and only if at least one of its elements is wet.
 7739:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 7740:  
 7741:       const Node *n1 = side->n1;
 7742:       const Node *n2 = side->n2;
 7743:      
 7744:       const int kb1 = n1->kb;
 7745:       const int kb2 = n2->kb;
 7746: 
 7747:       side->kb = 0; // default when dry
 7748: 
 7749:       if (isWet) {
 7750: 
 7751:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 7752: 
 7753:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 7754: 
 7755:          side->kb = min(kb1, kb2);
 7756: 
 7757:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 7758: 
 7759:          for (int k = side->kb; k < nvrt; k++) {
 7760:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 7761: 
 7762:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 7763: 
 7764:             // Compute velocity for re-wetted sides 
 7765:             if ((it != iths) && (side->isDry && isWet)) {
 7766: 
 7767:                Vector2 utmp={0.0, 0.0};
 7768: 
 7769:                int icount=0;
 7770: 
 7771:                // For all the sides on the two elements that share this side
 7772:                for (int j = 0; j < 2; j++) {
 7773:                   const Element *elem = side->elems[j];
 7774:                   if (elem == nullptr) continue;
 7775: 
 7776:                   for (int jj=0; jj < elem->i34; jj++) {
 7777:                      const Side *nSide = elem->sides[jj];
 7778:                      if (nSide->isDry) continue;
 7779: 
 7780:                      icount++;
 7781:                      utmp += nSide->u2[k];  
 7782:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 7783:                   }
 7784:                }
 7785:                   
 7786:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 7787:                if (icount > 0)  side->u2[k] = utmp/icount;
 7788:                else             side->u2[k] = {0.0, 0.0};
 7789:                   
 7790:             } // if ((it != iths) && (side->isDry && isWet))
 7791: 
 7792:          } // for k
 7793: 
 7794:       } // if isWet 
 7795:       
 7796: 
 7797: 
 7798:    }
 7799: 
 7800:    __global__ void ul0UpdateSides2(void) {
 7801:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 7802:    
 7803:          SIDE(side);
 7804:    
 7805:          const Element *e1 = side->elems[0];
 7806:          const Element *e2 = side->elems[1];
 7807: 
 7808:          // A side is wet if and only if at least one of its elements is wet.
 7809:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 7810: 
 7811:          // Update the side's dryness
 7812:          side->isDry = !isWet;
 7813: 
 7814:    }
 7815: 
 7816: 
 7817:    __global__ void zeroNodalVelocities(void) {
 7818:       NODE(node);
 7819: 
 7820:       for (int k = 0; k < nvrt; k++) {
 7821:          node->u2[k]   = {0.0, 0.0};
 7822:          node->w2[k]   = 0.0;
 7823:          node->utmp[k] = {0.0, 0.0};         
 7824:       }
 7825:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 7826:    }
 7827:  
 7828: 
 7829:    __global__ void computeNodalVerticalVelocities1(void) {
 7830:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7831:    // Adds the element's vertical velocity times the element's area.
 7832:       ELEM(elem);
 7833: 
 7834:       for (int j = 0; j < elem->i34; j++) {
 7835:          Node *node = elem->nodes[j];
 7836: 
 7837:          for (int k = node->kb; k < nvrt; k++) {
 7838:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 7839:          }
 7840:          atomicAdd(&(node->tmp.d), elem->area);
 7841:       }
 7842:    }
 7843: 
 7844:    __global__ void computeNodalVerticalVelocities2(void) {
 7845:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7846:    // Divides by the total area of the elements sharing the    node.
 7847:       NODE(node);
 7848: 
 7849: 
 7850:       const double invArea = 1.0 / node->tmp.d;
 7851:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = invArea*node->w2[k];  // node->tmp.d contains the total area of the elements sharing the node
 7852: 
 7853:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 7854:    }
 7855: 
 7856: 
 7857:    __global__ void computeNodalHorizontalVelocities1(void) {
 7858: 
 7859:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 7860: 
 7861:       ELEM(elem);
 7862: 
 7863:       if (elem->isDry) return;
 7864: 
 7865:       const int kb = elem->kb;
 7866:       const bool isTri = elem->isTri();
 7867: 
 7868:       if constexpr(indvel <= 0) {
 7869:          // Assuming discontinous hvel.
 7870: 
 7871:          if (isTri) { // For triangles
 7872:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 7873:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 7874:             #pragma unroll
 7875:             for (int j = 0; j < 3; j++) {
 7876:                // For every node of the triangle...
 7877:                Node *node = elem->nodes[j];
 7878: 
 7879:                if (node->isDry) continue;
 7880: 
 7881:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 7882:                const Side *s2 = elem->sides[(j + 1) % 3];
 7883:                const Side *s3 = elem->sides[(j + 2) % 3];
 7884: 
 7885:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 7886: 
 7887:                atomicAdd(&(node->tmp.i), 1);
 7888: 
 7889:                for (int k = kb; k < nvrt; k++)  {
 7890:                   Vector2 s1u2 = s1->u2[k];
 7891:                   Vector2 s2u2 = s2->u2[k];
 7892:                   Vector2 s3u2 = s3->u2[k];
 7893: 
 7894:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 7895:                   if constexpr(ics == 2) {
 7896:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 7897:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 7898:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 7899:                   }
 7900: 
 7901:                   Vector2 u = s2u2 + s3u2 - s1u2; // u extrapolated linearly at node j.   
 7902:                   u = clampVelocity(u);
 7903:                   atomicAdd(&(node->utmp[k].x), u.x);
 7904:                   atomicAdd(&(node->utmp[k].y), u.y);
 7905: 
 7906:                }
 7907: 
 7908:             }
 7909:          }
 7910:          else { // For quads
 7911: 
 7912: 
 7913:             // Compute the bilinear coordinates of the center of each diagonal.
 7914:             double xi, eta;
 7915:             double shp13[4], shp24[4];
 7916:             Point2 x0, x1, x2, x3;
 7917:             elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 7918:             const Point2 p13 = 0.5 * (x0 + x2);   // Center of sides 1 & 3
 7919:             const Point2 p24 = 0.5 * (x1 + x3);   // Center of sides 2 & 4
 7920: 
 7921:             elem->inverseBilinearQuad(p13, xi, eta, shp13);
 7922:             elem->inverseBilinearQuad(p24, xi, eta, shp24);
 7923: 
 7924: 
 7925: 
 7926: 
 7927:             for (int k = kb; k < nvrt; k++) {
 7928: 
 7929:                //Each quad is split into two triangles. For each triangle we extrapolate as we did for triangles.
 7930:                Vector2 sideU[4];
 7931:                #pragma unroll
 7932:                for (int j = 0; j < 4; j++) {
 7933:                   Vector2 u = elem->sides[j]->u2[k];
 7934:                   if constexpr(ics == 2) u = elem->sides[j]->frame.projHorVec(u, elem->frame);
 7935:                   sideU[j] = u;
 7936:                }
 7937: 
 7938:                Vector2 ud1 = shp13[0]*sideU[0] + shp13[1]*sideU[1] + shp13[2]*sideU[2] + shp13[3]*sideU[3];
 7939:                Vector2 ud2 = shp24[0]*sideU[0] + shp24[1]*sideU[1] + shp24[2]*sideU[2] + shp24[3]*sideU[3];
 7940: 
 7941:                Vector2 ufg0 = clampVelocity(sideU[2] + sideU[3] - ud2);  // node 1: sides 3,4
 7942:                Vector2 ufg1 = clampVelocity(sideU[0] + sideU[3] - ud1);  // node 2: sides 1,4
 7943:                Vector2 ufg2 = clampVelocity(sideU[0] + sideU[1] - ud2);  // node 3: sides 1,2
 7944:                Vector2 ufg3 = clampVelocity(sideU[1] + sideU[2] - ud1);  // node 4: sides 2,3
 7945:                const Vector2 ufg[4] = {ufg0, ufg1, ufg2, ufg3};
 7946:                #pragma unroll
 7947:                for (int j = 0; j < 4; j++) {
 7948:                   Node *node = elem->nodes[j];
 7949:                   if (node->isDry) continue;
 7950: 
 7951:                   if (k == kb) atomicAdd(&(node->tmp.i), 1);
 7952:                   atomicAdd(&(node->utmp[k].x), ufg[j].x);
 7953:                   atomicAdd(&(node->utmp[k].y), ufg[j].y);
 7954:                }
 7955:             }
 7956: 
 7957:          }
 7958: 
 7959:       }
 7960:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 7961:       
 7962:    }
 7963: 
 7964: 
 7965:    __global__ void computeNodalHorizontalVelocities2(void) {
 7966:       NODE(node);
 7967: 
 7968:       const int nodeCount = node->tmp.i;
 7969: 
 7970:       if (nodeCount == 0) 
 7971:       {
 7972:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 7973:          return;
 7974:       }
 7975: 
 7976:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 7977:       
 7978:       const int kb = node->kb;
 7979: 
 7980:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 7981:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 7982:       
 7983:       
 7984:    }   
 7985: 
 7986:  
