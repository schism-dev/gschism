 1702: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000) {
 1703:    return;
 1704:    // Lock the mutex
 1705:    lock(&debugPlotMutex);
 1706:  
 1707:    bool ok = true;
 1708:    if (debugPlotIdx == nullptr) ok = false;
 1709:    if (*debugPlotIdx >= 10000) ok = false;
 1710:    if (ok) {
 1711:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1712:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1713:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1714:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1715:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1716:       (*debugPlotIdx)++;
 1717:    }
 1718: 
 1719:    __threadfence();               // ensure all above writes are visible
 1720:    // Unlock the mutex
 1721:    unlock(&debugPlotMutex);
 1722: 
 1723: }
 1724: 
 1725: __device__ void addDebugPlot(Vector2 x1, Vector2 x2, unsigned int color = 0xFF0000) {
 1726:    addDebugPlot(toPoint3(x1, 0.0), toPoint3(x2, 0.0), color);
 1727: }
