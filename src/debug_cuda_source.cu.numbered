 3369: 
 3370: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3371:    if constexpr(ics == 1) {
 3372:       return center;
 3373: 
 3374:    } else {
 3375:       const Point2 p0 = n1->outputCoords();
 3376:       const Point2 p1 = n2->outputCoords();
 3377:       return (1.0/2.0)*(p0 + p1);
 3378: 
 3379:    }
 3380: }
 3381: 
 3382: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3383: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3384: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3385: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3386: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3387: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3388: __inline__ __device__ Point3  Side::p3_t(double t) const { return {x(t), y(t), z(t)}; }
 3389: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3390: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3391: // Computes the gradient of the field at the side center.
 3392:    Vector2 grad = {0.0, 0.0};
 3393:    int count = 0;
 3394: 
 3395:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3396:    // as the average of the gradients at each element.
 3397:    // First element
 3398:    if (elems[0] != nullptr && condition(elems[0])) {
 3399:       Vector2 elemGrad = elems[0]->grad2(field);
 3400: 
 3401:       // For ics=2, projects the element gradient from its frame to the side frame
 3402:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3403: 
 3404:       grad += elemGrad;
 3405: 
 3406:       count++;
 3407:    }
 3408: 
 3409:    // Second element
 3410:    if (elems[1] != nullptr && condition(elems[1])) {
 3411: 
 3412:       Vector2 elemGrad = elems[1]->grad2(field);
 3413: 
 3414:       // For ics=2, projects the element gradient from its frame to the side frame
 3415:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3416: 
 3417:       grad += elemGrad;
 3418: 
 3419:       count++;
 3420:    }
 3421: 
 3422:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3423:    if (count > 0) {
 3424:       grad = grad*(1.0/count);
 3425:    }
 3426:    
 3427:    return grad;
 3428: }
 3429: 
 3430: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 3431: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 3432: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 3433: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 3434: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 3435: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 3436: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 3437: 
 3438: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 3439: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 3440: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 3441: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 3442: 
 3443: 
 3444: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3445: 
 3446: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3447:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3448:    if constexpr(ics == 1) { 
 3449:       return 0.5*(n1->tau + n2->tau);
 3450: 
 3451:    } else {
 3452:       // Project the tau from the node frames to the side frame
 3453:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3454:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3455: 
 3456:       return 0.5*(stau1 + stau2);
 3457:    }
 3458: }
