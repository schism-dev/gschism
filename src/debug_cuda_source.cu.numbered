 4252:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4253: 
 4254:       NODE_BND(nodeBnd);
 4255: 
 4256:       Node *node = nodeBnd->node;
 4257: 
 4258:       node->ETP = 0.0;
 4259: 
 4260:       for (int j=0; j<ntip; j++) {
 4261: 
 4262:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4263:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4264: printf("RAAAAMP  ramp = %f, arg = %f\n", ramp, arg);         
 4265:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4266: 
 4267:          if constexpr(iloadtide==1) { // loading tide
 4268:             assert(false && "Loading tide not implemented");
 4269:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4270:          }
 4271:          
 4272:       }
 4273:       
 4274:    }
