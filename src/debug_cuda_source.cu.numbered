 2769: 
 2770: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2771: 
 2772: 
 2773: __device__ void Node::updateKb(void) {
 2774: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2775: 
 2776:    if constexpr(ivcor == 1) return;
 2777: 
 2778: 
 2779:    if (isDry2()) return;
 2780: 
 2781:    if constexpr(ivcor == 2) {  // SZ coordinates
 2782:       
 2783:       // Compute bottom level index
 2784:       if (depth <= mesh->h_s) {
 2785:          kb = izlev;
 2786:          
 2787:       } else {
 2788:          kb = -1;
 2789:          int L = 0;
 2790:          int R = nzlev; 
 2791:          
 2792:          while (L <= R) {
 2793:             int M = (R + L) / 2;
 2794: 
 2795: // printf("L = %d, R = %d, M = %d, depth = %f, ztot[L] = %f, ztot[R] = %f, ztot[M] = %f\n", L, R, M, depth, mesh->ztot[L], mesh->ztot[R], mesh->ztot[M]);
 2796:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2797:             
 2798:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2799:                R = M;
 2800:             } else {
 2801:                L = M;
 2802:             }
 2803: 
 2804:             if (R - L == 1) {
 2805:                kb = L;
 2806:                break;
 2807:             }
 2808:          }
 2809:       }
 2810:    } 
 2811: }
 2812: 
 2813: 
 2814: __device__ __inline__ void Node::updateZCoordData(void) {
 2815: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2816: 
 2817:    if (isDry2()) {
 2818:       kb = -1;
 2819:       return;
 2820:    }
 2821: 
 2822:    if constexpr(ivcor == 2) {  // SZ coordinates
 2823:       
 2824:       // Compute bottom level index
 2825:       if (depth <= mesh->h_s) {
 2826:             kb = izlev;
 2827: 
 2828:       } else {
 2829:          kb = -1;
 2830:          for (int i = 0; i < nzlev; i++) {
 2831:             // XXX Use binary search
 2832:             if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 2833:                kb = i;
 2834:                break;
 2835:             }
 2836:          }
 2837:       }
 2838:    } 
 2839:    else if (ivcor == 1) {  // Localized sigma
 2840:       // Do nothing
 2841:    }
 2842: 
 2843: }
 2844: 
 2845: __device__ double Node::compZCoord(int k) const {
 2846:    // Computes the z coordinate at level k.
 2847:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2848:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2849:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2850:    // used 
 2851:    
 2852:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2853: 
 2854:    if (isDry2()) return 0.0;
 2855: // if (htot2() <= h0) printf("idx = %d, htot2() = %f, h0 = %f\n", idx, htot2(), h0); XXX
 2856: // if (htot2() <= h0) return 0.0; // XXX
 2857:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2858: 
 2859:    if constexpr(ivcor == 2) {
 2860: 
 2861:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2862:       const double h_c = mesh->h_c;
 2863:       const double theta_f = mesh->theta_f;
 2864:       const double sinh_theta_f = mesh->sinh_theta_f;
 2865: 
 2866:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2867:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2868:       // once per time step/node.
 2869:       // CHECK: updateZCoordData
 2870: 
 2871:       //  To simplify comparisons, I define index versions of count variables.
 2872:       if      (k == ivrt)           return eta2; 
 2873:       else if (k == izlev)          return -hmod2;
 2874:       else if (k == kb)             return -depth;
 2875:       else if (k < izlev && k >= 0) return mesh->ztot[k];
 2876:       else if (k > izlev) {
 2877:          const int ksig = k - izlev;
 2878: 
 2879:          if (hmod2 <= h_c) {
 2880: // printf("mesh->sigma[ksig] * (hmod2 + eta2) + eta2 = %e\n", mesh->sigma[ksig] * (hmod2 + eta2) + eta2);            
 2881:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2882:          } 
 2883:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2884:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2885:             assert(false && "ZCOOR: invalid h_c\n");
 2886:          } 
 2887:          else {
 2888: // printf("eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig] = %e\n", eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig]);
 2889:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2890:                          h_c * mesh->sigma[ksig] + 
 2891:                          (hmod2 - h_c) * mesh->cs[ksig];
 2892:          }
 2893:       } else { 
 2894:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2895:       }
 2896: 
 2897:    }
 2898:    else if constexpr(ivcor == 1) {
 2899:       if (k == kb) return -depth;
 2900:       else if (k == nvrt-1) return eta2;
 2901:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2902:    }
 2903:    
 2904:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2905:    return 0.0;
 2906: }
 2907: 
 2908: 
 2909: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2910:    // Checks if a side in on the boundary
 2911:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2912: 
 2913:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2914:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2915: 
 2916:    // Indices of the nodes that form the side
 2917:    const int n1 = side.n1->idx;
 2918:    const int n2 = side.n2->idx;
 2919:    isLand = false;
 2920:    
 2921: 
 2922:    // Check if the side is on a land boundary
 2923:    for (int i = 0; i < nland; i++) {
 2924:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2925:          // Consecutive nodes in the land boundary segment
 2926:          const int b1 = ilnd[i + j*nland];
 2927:          const int b2 = ilnd[i + (j + 1)*nland];
 2928: 
 2929:          assert(b1 != -1 && b2 != -1);
 2930: 
 2931:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2932:             
 2933:             isLand = true;
 2934:             return i;
 2935:          }
 2936:       }
 2937:    }
 2938: 
 2939:    // Check if the side is on an open boundary
 2940:    for (int i = 0; i < nope; i++) {
 2941:       for (int j = 0; j < nond[i] - 1; j++) {
 2942:          // Consecutive nodes in the open boundary segment
 2943:          const int b1 = iond[i + j*nope];
 2944:          const int b2 = iond[i + (j + 1)*nope];
 2945: 
 2946:          assert(b1 != -1 && b2 != -1);
 2947: 
 2948:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2949:             isLand = false;
 2950:             return i;
 2951:          }
 2952:       }
 2953:    }
 2954: // printf("side.idx = %d, n1 = %d, n2 = %d\n", side.idx, n1, n2);             
 2955:    return -1;
 2956: }
 2957: 
 2958: 
 2959: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 2960:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 2961:                                     double *wind_rotate_angle, 
 2962:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2963:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2964:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2965:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 2966:                                     double *drag, double *roughness) {
 2967: 
 2968:    NODE(pnode);  
 2969:    const int i = idx_node;
 2970:    Node &node(*pnode);
 2971: 
 2972:    node.idx = i;
 2973: 
 2974:    const int idxNodeStart = nodeNeighNodesStart[i];
 2975:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2976:    node.numNodes = idxNodeEnd - idxNodeStart;
 2977:    node.nodes = nodeNeighNodes + idxNodeStart;
 2978:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2979: 
 2980: 
 2981: 
 2982:    const int idxElemStart = nodeNeighElemsStart[i];
 2983:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2984:    node.numElements = idxElemEnd - idxElemStart;
 2985:    node.elements = nodeNeighElems + idxElemStart;
 2986: 
 2987: 
 2988:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2989:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2990:       const int partNode = localNodePart[idxNodeGlobal]; 
 2991:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 2992: 
 2993:       Node *node_ptr = nodes[partNode] + idxNode;
 2994:       
 2995:       nodeNeighNodes[idx] = node_ptr;
 2996:    }
 2997: 
 2998: 
 2999:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3000:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3001:       const int partElem = localElemPart[idxElemGlobal];
 3002:       const int idxElem  = localElemIndices[idxElemGlobal];
 3003: 
 3004:       Element *elem_ptr = elems[partElem] + idxElem;
 3005: 
 3006:       nodeNeighElems[idx] = elem_ptr;
 3007:    }      
 3008: 
 3009: // printf("NODE i = %d, node = %p, node.numNodes = %d\n", node.idx, &node, node.numNodes);      
 3010: 
 3011:    node.wind_angle = wind_rotate_angle[i];
 3012: 
 3013: 
 3014:    node.p.x   = node_coords[i * 3];
 3015:    node.p.y   = node_coords[i * 3 + 1];
 3016:    node.depth = node_coords[i * 3 + 2];
 3017: 
 3018:    if (use_ll) {
 3019:    node.lon = node_coords_ll[i * 2    ]*deg2rad;
 3020:    node.lat = node_coords_ll[i * 2 + 1]*deg2rad;
 3021:    }
 3022: 
 3023: 
 3024:    node.numSides = 0;
 3025: 
 3026:    node.Cd = drag[i];
 3027:    node.rough = roughness[i];
 3028:    
 3029:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3030: 
 3031:    
 3032:    // Links the node to the boundary information
 3033:    if (isbnd[i] >= 0) {
 3034: 
 3035:      
 3036:       // Get the index of the node boundary
 3037:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3038: 
 3039:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3040:       node.nodeBnd->node = &node;
 3041: 
 3042:       node.nodeBnd->sideBnd1 = nullptr;
 3043:       node.nodeBnd->sideBnd2 = nullptr;
 3044: 
 3045:       if (isbnd[i]>=0) {
 3046: 
 3047:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3048:          
 3049:          node.nodeBnd->segment->ifltype = (isbnd[i]==0)?3:0;
 3050:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3051: 
 3052:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3053:          node.nodeBnd->segment->clen  = nan("1");
 3054:          node.nodeBnd->segment->carea = nan("1");
 3055: 
 3056:       }
 3057: //          else {  XXXXXX
 3058: //             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3059: // printf("EEEEEPP isbnd[i] = %d, node.nodeBnd->segment = %p\n", isbnd[i], node.nodeBnd->segment);            
 3060: //          }
 3061:       
 3062: 
 3063:    }
 3064:    else {
 3065: 
 3066:       node.nodeBnd = nullptr; // For internal nodes
 3067: 
 3068:       if (isbnd[i] == landSegment) {
 3069:          node.nodeBnd = &landBoundaryNode;
 3070:          node.nodeBnd->segment = &landBoundarySegment;
 3071:       }
 3072:       // node.nodeBnd->node = &node;
 3073:       // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3074:       // // node.nodeBnd = nullptr;
 3075:       // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3076:       
 3077:    }
 3078:    
 3079:    // XXXX GAUSSIAN HILL VELOCITIES
 3080: #ifdef GAUSSIAN_HILL_VELOCITIES
 3081:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3082:       constexpr double rot_per = 3000.0;
 3083:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3084:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3085:    // XXXXX
 3086: #endif
 3087: 
 3088: }
 3089: 
 3090: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3091:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3092:                                     double *wind_rotate_angle,   
 3093:                                     int *isdel, int *isidenode, int *isbnd,
 3094:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3095:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3096:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3097:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3098:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3099:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3100:                                     double *drag, double *roughness) {
 3101: 
 3102: 
 3103:    SIDE(pside);
 3104:    Side &side(*pside);
 3105:    const int i = idx_side;
 3106: 
 3107:    side.idx = i;  
 3108:    
 3109:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3110:    const double fc   = 2.0*omega_e*sin(sfea0);
 3111:    const double beta = 2.0*omega_e*cos(sfea0);
 3112: 
 3113:    // finding the pointer to the nodes that form the side
 3114:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3115:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3116: 
 3117:    const int locidx_n1 = localNodeIndices[idx_n1];
 3118:    const int locidx_n2 = localNodeIndices[idx_n2];
 3119:    const int part_n1 =   localNodePart[idx_n1];
 3120:    const int part_n2 =   localNodePart[idx_n2];
 3121: 
 3122:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3123:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3124: 
 3125:    // Counts the number of sides connected to each node
 3126:    side.n1->numSides++;
 3127:    side.n2->numSides++;
 3128: 
 3129:    // Normal, unitary vector to the side
 3130:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3131:    side.n = normalize(side.n);
 3132: 
 3133:    // Side boundary type
 3134:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3135:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3136: 
 3137:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3138:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3139:    {
 3140:       bool isLand = false;
 3141:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3142:       
 3143:       if (isbs > -1) {
 3144:          // assert(isLand || isbs>=0);
 3145:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3146: 
 3147:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3148: 
 3149:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3150:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3151: 
 3152:          assert (isLand == side.sideBnd->segment->isLand);
 3153: 
 3154:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3155:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3156:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3157: 
 3158:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3159:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3160:          
 3161:          side.sideBnd->side = &side;
 3162: 
 3163:       }
 3164:       else {
 3165:          side.sideBnd = nullptr;
 3166:       }
 3167:    }
 3168:    else 
 3169:    {
 3170:       side.sideBnd = nullptr;
 3171:    }
 3172: 
 3173: 
 3174:    // finding the pointer to the elements that share the side
 3175:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3176:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3177: 
 3178:    if (idx_e1 > -1) {
 3179:       const int locidx_e1 = localElemIndices[idx_e1];
 3180:       const int part_e1 =  localElemPart[idx_e1];
 3181:       side.elems[0] = elems[part_e1] + locidx_e1;
 3182: 
 3183:    }
 3184:    else {
 3185:       side.elems[0] = nullptr;
 3186:    }
 3187: 
 3188:    if (idx_e2 > -1) {
 3189:       const int locidx_e2 = localElemIndices[idx_e2];
 3190:       const int part_e2 =  localElemPart[idx_e2];
 3191:       side.elems[1] = elems[part_e2] + locidx_e2;
 3192:    }
 3193:    else {
 3194:       side.elems[1] = nullptr;
 3195:    }
 3196: 
 3197:    // Compute the center of the side
 3198:    side.center = 0.5*(side.n1->p + side.n2->p);
 3199: 
 3200:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3201:    side.shapiro = shapiro0;
 3202: 
 3203: #ifdef GAUSSIAN_HILL_VELOCITIES
 3204: // XXXX
 3205: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3206: constexpr double rot_per=3000.0;
 3207: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3208: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3209: // XXXXX      
 3210: #endif
 3211:    // Compute the z level at the center of the side
 3212:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3213:    
 3214:    // Compute the length of the side
 3215:    const Vector2 vLen = side.n2->p - side.n1->p;
 3216:    side.len = sqrt(dot(vLen, vLen));
 3217: 
 3218: 
 3219:    // Compute the Coriolis coefficient
 3220: 
 3221:    if constexpr(ncor == -1 || ncor == 0) {
 3222:       side.coriolis = coricoef;
 3223:    }
 3224:    else {
 3225:       const double sphi = side.lat();  // Latitude at the center of the side
 3226: 
 3227: // XXXXXX ERROR WHEN use_ll is false??????
 3228:       if constexpr(ics == 1) {
 3229:          // XXXXXXX
 3230:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3231:       }
 3232:       else {
 3233:          side.coriolis = 2.0*omega_e*sin(sphi);
 3234:       }
 3235: 
 3236:    }
 3237: }
 3238: 
 3239: 
 3240: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3241:    double *node_coords, double *node_coords_ll, bool use_ll,
 3242:    double *wind_rotate_angle,   
 3243:    int *isdel, int *isidenode, int *isbnd,
 3244:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3245:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3246:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3247:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3248:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3249:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3250:    double *drag, double *roughness) {
 3251: 
 3252:    ELEM(pelem);
 3253:    Element &elem(*pelem);
 3254:    const int i = idx_elem;
 3255: 
 3256:    elem.idx = i;
 3257: 
 3258:    for (int j = 0; j < i34[i]; j++) {
 3259:       const int idxNode = elnode[i*4 + j];  
 3260:       const int idxSide = elside[i*4 + j];
 3261:       
 3262:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3263:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3264: 
 3265:       // Find the neighboring element  
 3266:       if (elem.sides[j]->elems[0] == &elem) {
 3267:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3268:       }
 3269:       else {
 3270:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3271:       }
 3272:       
 3273:    }
 3274: 
 3275:    elem.i34 = i34[i];
 3276: 
 3277:    // Compute the centroid of the element and its depth
 3278:    Vector2 center = {0.0, 0.0};
 3279:    elem.depth = 0.0;
 3280:    for (int j = 0; j < i34[i]; j++) {
 3281: 
 3282: // printf("WWW i = %d, node = %p, elem.i34 = %d\n", i, elem.nodes[j], elem.i34);    
 3283: 
 3284: 
 3285:       center += elem.nodes[j]->p/i34[i];
 3286:       elem.depth  += elem.nodes[j]->depth/i34[i];
 3287:    }
 3288:    elem.center = center;
 3289: 
 3290:    
 3291:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3292:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3293: 
 3294:    elem.area = elem.computeSignedArea(); 
 3295:    elem.radius = sqrt(elem.area)/pi; 
 3296:    
 3297:    // Determines which way the normal vector to each side is oriented.
 3298:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3299:    for (int j = 0; j < i34[i]; j++)  
 3300:    {
 3301:       if (elem.sides[j]->elems[0] == &elem) {
 3302:          elem.ssign[j] =  1.0;
 3303:       }
 3304:       else {
 3305:          elem.ssign[j] = -1.0;
 3306:       }
 3307: 
 3308:    }
 3309: 
 3310:    // Derivatives of shape functions
 3311:    //  For ics=2, this is done inside element/ll frame XXX
 3312:    //  For quads, the derivative is evaluated at centroid
 3313:    for (int j = 0; j < elem.i34; j++) {
 3314:       const double area = elem.area;
 3315:       const int id2 = elem.nxq(1 + j);
 3316:       const int id3 = elem.nxq(2 + j);
 3317:       const int id4 = elem.nxq(3 + j);
 3318:       if (elem.isTri()) {
 3319:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3320:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3321:          // da1/dx = (y1 - y2)/(2*area)
 3322:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3323:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3324:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3325:       }
 3326:       else  { // Quad; evaluate at centroid
 3327:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3328:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3329:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3330:       } // if Tri
 3331: 
 3332:    } // for j   
 3333:    
 3334:    
 3335: 
 3336: }
 3337: 
 3338: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3339:                                             double *emo, double *efa, 
 3340:                                             double *umo, double *ufa, 
 3341:                                             double *vmo, double *vfa) {
 3342: 
 3343: 
 3344:    NODE_BND(nodeBnd);
 3345:    const int idx = idx_node_bnd;    
 3346: 
 3347:    nodeBnd->idx = idx;
 3348: 
 3349:    // Need to find the segment index and the index of the node on the segment
 3350:    int idxNode = -1;
 3351:    int iseg, i;
 3352:    for (iseg = 0; iseg < nope; iseg++) {
 3353:       // for each segment...
 3354:       for (i = 0; i < nond[iseg]; i++) {
 3355:          idxNode = iond[iseg + i*nope];
 3356:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3357:          
 3358:       }
 3359:    }
 3360: 
 3361:    assert(iseg < nope && "iseg is out of bounds");
 3362: 
 3363: found: // Jumped here when the node was found
 3364: 
 3365:    nodeBnd->isEssentialBC = true;
 3366:    nodeBnd->elbc = 0.0;
 3367: 
 3368:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3369: 
 3370:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX
 3371:       nodeBnd->efa[jfr] = efa[idx2];
 3372:       nodeBnd->emo[jfr] = emo[idx2];
 3373:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3374:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3375: 
 3376:    }
 3377:         
 3378: 
 3379: }
