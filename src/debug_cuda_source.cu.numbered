  704:    __device__ bool findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement, double &t, 
  705:                                         double& tIntersect);
  706: 
  707:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  708:       // Check if the point (xt,yt) is inside the element
  709:       double shpCoords[4];
  710: 
  711:       bool res = computeShapeCoords(xt, shpCoords, false);
  712: 
  713:       return res;
  714:    }
  715: 
  716:    __inline__ __device__ bool containsPoint(Vector2 &xt, bool fixCoords) const { 
  717:       // Check if the point (xt,yt) is inside the element.
  718:       // If fixCoords is true, and *the point is inside the element*, the point is nudged to be inside the element.
  719:       double shpCoords[4];
  720: 
  721:       Vector2 tmp_xt = xt;
  722:       bool res = computeShapeCoords(tmp_xt, shpCoords, fixCoords);
  723: 
  724:       if (fixCoords && res) xt = tmp_xt;
  725: 
  726:       return res;
  727:    }
  728: 
  729:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  730:    {
  731:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  732:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  733:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  734:       
  735:    }
  736: 
  737:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int) const;
  738: 
  739:    // ------------------------------------------------------------------------------------------------
  740:    // These are functions that work on all nodes of the element.
  741:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  742:    //
  743:    // An example of how to use these functions is:
  744:    //   
  745:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  746:    // 
  747:    // Where L is the level at which the field is to be interpolated. The field can be either
  748:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  749:    // There are different versions of getNodalValues for each of these cases.
  750: 
  751:    template<typename T>
  752:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  753:       // Get the values of the field at the nodes of the element
  754:       res[0] = nodes[0]->*field;
  755:       res[1] = nodes[1]->*field;
  756:       res[2] = nodes[2]->*field;
  757:       if (isQuad()) res[3] = nodes[3]->*field;
  758:       else          res[3] = T();
  759:    }
  760: 
  761:    template<typename T>
  762:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  763:       // Get the values of the field at the nodes of the element
  764:       res[0] = (nodes[0]->*field)[level];
  765:       res[1] = (nodes[1]->*field)[level];
  766:       res[2] = (nodes[2]->*field)[level];
  767:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  768:       else          res[3] = T();
  769:    }    
  770: 
  771:    template<typename T>
  772:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  773:       // Get the values of the func at the nodes of the element
  774:       res[0] = (nodes[0]->*func)(level);
  775:       res[1] = (nodes[1]->*func)(level);
  776:       res[2] = (nodes[2]->*func)(level);
  777:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  778:       else          res[3] = T();  // This is 0.0 or a zero vector
  779: 
  780:    }      
  781: 
  782:    template<typename T>
  783:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  784:       // Get the values of the field at the nodes of the element
  785:       res[0] = sides[0]->*field;
  786:       res[1] = sides[1]->*field;
  787:       res[2] = sides[2]->*field;
  788:       if (isQuad()) res[3] = sides[3]->*field;
  789:       else          res[3] = T();
  790:    }
  791: 
  792:    template<typename T>
  793:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  794:       // Get the values of the field at the nodes of the element
  795:       res[0] = (sides[0]->*field)[level];
  796:       res[1] = (sides[1]->*field)[level];
  797:       res[2] = (sides[2]->*field)[level];
  798:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  799:       else          res[3] = T();
  800:    }    
  801: 
  802:    template<typename T>
  803:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  804:       // Get the values of the func at the nodes of the element
  805:       res[0] = (sides[0]->*func)(level);
  806:       res[1] = (sides[1]->*func)(level);
  807:       res[2] = (sides[2]->*func)(level);
  808:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  809:       else          res[3] = T();  // This is 0.0 or a zero vector
  810: 
  811:    }      
  812: 
  813:    template<typename T>
  814:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
  815:       T values[4];
  816:       getNodalValues(level, func, values);
  817: 
  818:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  819:    }
  820: 
  821:    template<typename T>
  822:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  823:       T values[4];
  824:       getNodalValues(field, values);
  825:       
  826:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  827:    }
  828: 
  829: 
  830:    template<typename T>
  831:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  832:       T values[4];
  833:       getNodalValues(level, field, values);
  834: 
  835:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  836:    }
  837: 
  838:    template<typename T>
  839:    __device__ T mean(T Node::* field) const {
  840:       T values[4];
  841:       getNodalValues(field, values);
  842: 
  843:       assert(i34 == 4 || values[3] == T() && "mean: values[3] is not zero with i34 == 4");
  844: 
  845:       return (values[0] + values[1] + values[2] + values[3])/i34;
  846:    }
  847: 
  848:    template<typename T>
  849:    __device__ T mean(T Side::* field) const {
  850:       T values[4];
  851:       getSideValues(field, values);
  852:       
  853:       assert((i34 == 4) || (values[3] == T()) && "mean: values[3] is not zero with i34 == 4");
  854: 
  855:       return (values[0] + values[1] + values[2] + values[3])/i34;
  856:    }   
  857: 
  858:    template<typename T>
  859:    __device__ T mean(int level, T (Node::* field)[nvrt]) const {
  860:       T values[4];
  861:       getNodalValues(level, field, values);
  862: 
  863:       assert((i34 == 4) || (values[3] == T()) && "mean: values[3] is not zero with i34 == 4");
  864: 
  865:       return (values[0] + values[1] + values[2] + values[3])/i34;
  866:    }
  867: 
  868:    template<typename T>
  869:    __device__ T mean(int level, T (Side::* field)[nvrt]) const {
  870:       T values[4];
  871:       getSideValues(level, field, values);
  872:       
  873:       // assert((i34 == 4) || (values[3] == T()) && "mean: values[3] is not zero with i34 == 4");
  874: 
  875:       return (values[0] + values[1] + values[2] + values[3])/i34;
  876:    }   
  877: 
  878:    // __device__ double mean(double (Node::*func)(int) const) const {
  879:    //    double values[4];
  880:    //    getNodalValues(level, func, values);
  881:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  882:    // }
  883:    // ------------------------------------------------------------------------------------------------
  884: 
  885:    __device__ bool globalToLocal(double xt, double yt, double &xlocal, double &ylocal) const {
  886:       // Convert global coordinates to local coordinates
