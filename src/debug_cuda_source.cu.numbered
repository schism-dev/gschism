 6932: 
 6933:    __global__ void computeVegetationAndDragParameters(void) {
 6934:       // Computes the vegetation and drag model parameters:
 6935:       // chi, \tilde\chi, beta, \breve{H}
 6936:       
 6937:       SIDE(side);
 6938: 
 6939:       side->hhat = 0.0;
 6940:       side->chi2 = 0.0;
 6941:       side->chi = 0.0;
 6942:       side->veg_c2 = 0.0;
 6943:       side->veg_beta = 0.0;
 6944: 
 6945:       if (side->isDry) return;
 6946: 
 6947:       const double htot = side->htot2();
 6948:       const int    kb   = side->kb;
 6949: 
 6950:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 6951: 
 6952:       const double veg_h     = side->veg_h();
 6953:       const double veg_nv    = side->veg_nv();
 6954:       const double veg_c     = side->veg_c();
 6955:       const double veg_beta  = side->veg_beta;
 6956:       const double veg_alpha = side->veg_alpha_vert_mean();
 6957: 
 6958:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX recommended to change names, chi->chitilde, chi2->chi
 6959:       // Velocity magnitude at the bottom level
 6960:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0 - dt*swild2(k,1) to u2 (I think this only pertains to iupwind_mom \= 0)
 6961:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 6962:       side->chi2 = side->Cd()*vmag1;
 6963:       side->chi  = side->chi2;
 6964: 
 6965:       if constexpr(iveg != 0) {
 6966:          const Node *n1 = side->n1;
 6967:          const Node *n2 = side->n2;
 6968:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 6969:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 6970:       }
 6971: 
 6972:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 6973: 
 6974:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 6975:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 6976:       double magUa = 0.0;
 6977:       if constexpr(iveg != 0) {
 6978:          if (side->is3D() && veg_h > 0.0) {
 6979:             // 3D wet side with veg...
 6980: 
 6981:             double magUa = 0.0;
 6982:             for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 6983:                if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 6984: 
 6985:                   // Velocity magnitude must be computed at the center of each level to perform the integration.
 6986:                   // The tricky part is to compute that velocity at the level that may be partially submerged.
 6987:                   const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 6988: 
 6989:                   // Velocity magnitude at the top (h) of the level (may be partially submerged)
 6990:                   const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 6991: 
 6992:                   // Velocity magnitude at the bottom (l) of the level
 6993:                   const double ul = length(side->u2[k]);
 6994: 
 6995:                   const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 6996:                   magUa += Dz*0.5*(uh + ul);
 6997: 
 6998:                } // if HasVegetation
 6999:             } // for k
 7000:             const double ua = magUa/min(htot, veg_h); // Vertical average
 7001: 
 7002:             // Computes beta, used for computing the stress term at the top of the canopy.      
 7003:             side->veg_c2 = veg_alpha*dt*ua; // >=0
 7004:             if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 7005:                const double zCpy = side->zTopCanopy();
 7006:                const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 7007:                const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 7008:                const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 7009:                const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 7010:                side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 7011:             } // if isSubmerged
 7012:          } // if is3D
 7013:       } // if iveg   
 7014: 
 7015:       // Computes the friction modified depth, \breve{H} in notes
 7016:       if (side->is2D()) { // 2D
 7017: 
 7018:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 7019:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 7020: 
 7021:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 7022: 
 7023:          side->hhat = htot*htot/fricH; 
 7024: 
 7025:       } else { // 3D
 7026:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 7027: 
 7028:          if constexpr(iveg != 0) {
 7029:             
 7030:             if (side->isSubmerged()) { 
 7031:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 7032:                side->hhat -= veg_c*Hhat_alpha;
 7033: 
 7034:             } else { // Emergent
 7035:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 7036:             }
 7037:          } // if iveg
 7038: 
 7039:          // Enforce positivity for 3D model
 7040:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 7041:       } // if 3D
 7042: 
 7043:    }
 7044: 
 7045: 
 7046: 
 7047:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 7048:    // Computes the density gradient between two elements, e1 and e2.
 7049:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 7050:    // zero in the direction normal to the side. 
 7051:    // 
 7052:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 7053:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 7054:    //
 7055:    // Input:
 7056:    //    e1: Element
 7057:    //    e2: Neighbor element (or nullptr if boundary)
 7058:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 7059:    //    k: Index of the half-level at which the density is interpolated
 7060:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 7061:    // 
 7062:    // Output:
 7063:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 7064:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 7065: 
 7066:       if (e2 == nullptr || e2->isDry) {
 7067:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 7068: 
 7069:          Side *side = e1->sides[j];
 7070:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 7071:                  
 7072:          if constexpr(ics == 1) {
 7073:             vec = side->n; // Normal vector to the side
 7074:          } else {
 7075:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 7076:             // IMPLEMENT THIS XXXXXX
 7077:             // !replace with xel, yel?
 7078:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 7079:             //      &eframe(:,:,i),xn1,yn1,tmp)
 7080:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 7081:             //      &eframe(:,:,i),xn2,yn2,tmp)
 7082:          } //ics
 7083:                    
 7084:          diffRho = 0.0;
 7085: 
 7086:       } else { //internal and wet
 7087:          if constexpr(ics==1) {
 7088:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 7089: 
 7090:             // Vector from e1 to e2
 7091:             vec = e2->center - e1->center;
 7092: 
 7093:          } else { 
 7094:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 7095:             // Remember that elem->center is in global coordinates
 7096:             // IMPLEMENT THIS XXXXXX
 7097:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 7098:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 7099:             //                   alow(j)=xctr2
 7100:             //                   bdia(j)=yctr2
 7101:          } // ics
 7102: 
 7103:          diffRho = rho2 - e1->demeanedDensity(k);
 7104:       }
 7105: 
 7106:    }
 7107: 
 7108:    __global__ void computeDensityCubicSplines(void) {
 7109:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 7110: 
 7111:       ELEM(elem);
 7112: 
 7113:       if (elem->isDry) return;
 7114: 
 7115:       const int kb = elem->kb;
 7116: 
 7117:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 7118:       if (elem->is2D()) {
 7119:          // In the 2D case, the density is constant at the prism level. 
 7120:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 7121:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 7122:       } else { //3D
 7123: 
 7124:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 7125:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 7126:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 7127:          ///// XXXX CHECK INDICES!!!!!
 7128:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 7129:       } // 2D/3D
 7130: 
 7131:    }
 7132: } // extern "C"
 7133: 
 7134: 
 7135: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 7136: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 7137: 
 7138:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 7139: 
 7140:    const int kb  = elem->kb;
 7141:    const int kb2 = elem2->kb;
 7142: 
 7143:    // z-coordinate of prism of elem
 7144:    const double zp = elem->z_prism(k);
 7145: 
 7146:    double rho = 0.0;
 7147: 
 7148:    if (elem2->is2D()) {
 7149:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 7150: 
 7151:    } else {  // 3D
 7152: 
 7153:       // eta_min may be < zmax
 7154:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 7155:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 7156: 
 7157:       // (Extrapolate density below bottom, we will fix it later)
 7158:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 7159:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 7160:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 7161:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 7162:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 7163:    } // 2D/3D
 7164:      
 7165: 
 7166:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 7167:    // Now we need to fix it.
 7168:    if (elem->z[k] < elem2->z[kb2]) {
 7169:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 7170: 
 7171:       // There are two methods to adjust the density at the bottom of the element.
 7172:       // iunder_deep=0: 
 7173:       const double depth1 = abs(elem->z[kb]); // larger depth
 7174: 
 7175:       if (iunder_deep==0) {
 7176: 
 7177:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 7178: 
 7179:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 7180: 
 7181:       } else { // iunder_deep != 0
 7182: 
 7183:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 7184: 
 7185:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 7186: 
 7187:          //   Demeaned density at the same z coordinate as
 7188:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 7189:          }
 7190: 
 7191:       } // if iunder_deep
 7192:    } // if elem->z[kb] < elem2->z[kb]
 7193: 
 7194:    return rho;
 7195: }
 7196: 
 7197: 
 7198: extern "C" {
 7199:    __global__ void computeDensityGradient(void) {
 7200: 
 7201:       assert(ibc == 1 && "baroclinic formulation is not implemented yet: ibc != 0");
 7202:       if constexpr(ibc != 0) return;
 7203: 
 7204:          // Compute the horizontal density gradient at each element.
 7205:       // It works in two steps:
 7206:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 7207:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 7208:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 7209:       //             gradRho.r1 = rho1 - rho0
 7210:       //             gradRho.r2 = rho2 - rho0
 7211:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 7212:       // 
 7213:       //  NOTE: We use de-meaned densities.
 7214: 
 7215:       ELEM(elem);
 7216: 
 7217:       if (elem->isDry) return;
 7218: 
 7219:       const int kb  = elem->kb;
 7220:       const int i34 = elem->i34;
 7221: 
 7222:       for (int k = kb + 1; k < nvrt; k++) {
 7223:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 7224:          //             gradRho.r1 = rho1 - rho0
 7225:          //             gradRho.r2 = rho2 - rho0
 7226:          int icount = 0;
 7227:          double sumRx = 0.0;
 7228:          double sumRy = 0.0;
 7229:          for (int j1=0; j1<i34; j1++) { 
 7230: 
 7231:             const int j2 = elem->nxq(j1 + 1);
 7232: 
 7233:             // Pairs of consecutive neighbor elements of elem
 7234:             const Element *e1 = elem->nghbElems[j1];
 7235:             const Element *e2 = elem->nghbElems[j2];
 7236: 
 7237:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 7238:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 7239:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 7240: 
 7241:             // Compute the density difference and the vector from elem to e1 and e2
 7242:             // getRhoDiffAndVec takes into account boundaries/dry elements
 7243:             double diffRho1, diffRho2;
 7244:             Vector2 vec1, vec2;
 7245:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 7246:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 7247: 
 7248:             const double rl1 = length(vec1);
 7249:             const double rl2 = length(vec2);
 7250:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 7251: 
 7252:             const double delta = cross(vec1, vec2);
 7253:             const double sintheta = abs(delta)/(rl1*rl2);
 7254: 
 7255:             // To avoid problems, avoid elements with small angle between vectors
 7256:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 7257:             const bool validEq = (sintheta > sin_one_deg);
 7258: 
 7259:             if (validEq) {
 7260:                // Solve the system of equations to get the density gradient at elem
 7261:                icount++;
 7262:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 7263:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 7264:                sumRx += Rx;
 7265:                sumRy += Ry;
 7266:             }
 7267:          } // for j1
 7268: 
 7269:          // Compute the average density gradient at elem
 7270:          if (icount==0) {
 7271:            // Bad mesh quality; bail out with 0 b-cc
 7272:            elem->gradRho[k] = {0.0, 0.0};
 7273:          } else {
 7274:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 7275:          }
 7276: 
 7277:       } // for k
 7278: 
 7279:    }
 7280: 
 7281:    __global__ void computeBaroclinicTerm(void) {
 7282:    // Computes the baroclinic term at sides (at half levels).
 7283:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 7284:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 7285: 
 7286:       if (ibc == 1) return;
 7287: 
 7288:       SIDE(side);
 7289: 
 7290:       if (side->isDry) return;
 7291: 
 7292:       const Element *e1 = side->elems[0];
 7293:       const Element *e2 = side->elems[1]; 
 7294:       const int kb = side->kb;
 7295:       
 7296:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 7297: 
 7298:       // interpolates vertically the density gradient of the two elements at the half level/
 7299: 
 7300:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 7301:       int k2 = max(kb, nvrt / 2);
 7302: 
 7303:       // Starts the integration at the surface and goes down to the bottom
 7304:       side->bcc[nvrt-1] = {0.0, 0.0};
 7305:       for (int k = nvrt - 2; k >= kb; k--) {
 7306:       // For each prism level (from surface to bottom)...
 7307: 
 7308:          // For both elements, interpolate density gradient at the side's half level.
 7309:          // The gradient at the side is the average of the gradients at the elements.
 7310:          // w1, w2 are used to take into account boundary sides, with just one element.
 7311:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 7312:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 7313:          const double wsum = w1 + w2;
 7314:          w1 = w1/wsum;
 7315:          w2 = w2/wsum;
 7316:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 7317: 
 7318:          // Linear interpolation of both elements' density gradient at the shared side's level.
 7319:          Vector2 gradRho = {0.0, 0.0};
 7320:          if (e1 != nullptr && k > kb) {
 7321:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 7322:             
 7323:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 7324:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 7325:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 7326: 
 7327:             // Grad(rho) vertically interpolated at the side's half level
 7328:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 7329: 
 7330:             // Projects the element density gradient to the side frame if needed.
 7331:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 7332: 
 7333:             // Adds the contribution of the density gradient at the side's half level
 7334:             gradRho += gradRho1*w1;
 7335:          }      
 7336:          if (e2 != nullptr && k > kb) {
 7337:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 7338:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 7339:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 7340:             
 7341:             // Grad(rho) vertically interpolated at the side's half level
 7342:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 7343: 
 7344:             // Projects the element density gradient to the side frame if needed.
 7345:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 7346: 
 7347:             // Adds the contribution of the density gradient at the side's half level
 7348:             gradRho += gradRho2*w2;
 7349:          }
 7350: 
 7351:          
 7352:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 7353:          // multiplied by -rampbc*(g/rho0) 
 7354:          const double grav3 = side->grav3();
 7355:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 7356: 
 7357:       } // for
 7358: 
 7359:    }
 7360: 
 7361: 
 7362: 
 7363:    __global__ void computeHorGradientAtSide(void) {
 7364: 
 7365:       // Compute the horizontal density gradient at each element.
 7366:       // It works in two steps:
 7367:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 7368:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 7369:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 7370:       //             gradRho.r1 = rho1 - rho0
 7371:       //             gradRho.r2 = rho2 - rho0
 7372:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 7373:       // 
 7374:       //  NOTE: We use de-meaned densities.
 7375: 
 7376:       SIDE(side);
 7377: 
 7378: 
 7379:       if (side->isDry) return;
 7380: 
 7381:       // Computes the gradient of the variables at the side center.
 7382:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 7383:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 7384:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 7385: 
 7386:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 7387:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 7388:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 7389:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 7390: 
 7391:    }
 7392: 
 7393: 
 7394:    __global__ void solveMomentumEquations(double time) {
 7395: 
 7396:       double alow[nvrt], cupp[nvrt], bdia[nvrt]; // a = low, c = up, b = diag
 7397:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 7398: 
 7399:       SIDE(side);
 7400: 
 7401:       if (side->isDry) 
 7402:       {
 7403:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 7404: 
 7405:          return;
 7406:       }
 7407: 
 7408:       const Node *n1 = side->n1;
 7409:       const Node *n2 = side->n2;
 7410: 
 7411:       const int kb = side->kb;
 7412: 
 7413:       const double veg_h = side->veg_h();
 7414:       const double grav3 = side->grav3();
 7415: 
 7416:       if (side->is2D()) {
 7417:          // Remember: Do not use htot2, which is updated.
 7418:          const double htot = side->htot1();
 7419:          const double hhat = side->hhat;
 7420: 
 7421:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 7422: 
 7423:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 7424:          const Vector2 tau2 = side->tau();
 7425: 
 7426:          // hat_gam has units of m/s
 7427: 
 7428:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 7429:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 7430:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 7431: 
 7432:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 7433: 
 7434: 
 7435:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 7436: 
 7437:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 7438: 
 7439:       }
 7440:       else { // 3D
 7441: 
 7442:          // For 3D it is necessary to solve an implicit tridiagonal system.
 7443:          // 
 7444:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 7445:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 7446:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 7447:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 7448:          // k+1 and k.
 7449: 
 7450:          const double zTopCanopy = side->zTopCanopy();
 7451: 
 7452:          // Initialize the tridiagonal system
 7453:          for (int k = kb + 1; k < nvrt; k++) {
 7454:             
 7455:             const int kin = k - (kb + 1);
 7456: 
 7457:  
 7458:             alow[kin] = 0.0;
 7459:             cupp[kin] = 0.0;
 7460:             bdia[kin] = 0.0;
 7461: 
 7462:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 7463:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 7464: 
 7465:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 7466:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 7467:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 7468: 
 7469:             // First part: layers k, k+1
 7470:             if (k < nvrt - 1) {
 7471:                              
 7472:                if constexpr(iveg != 0) {
 7473: 
 7474:                   // If there is vegetation at this level...
 7475:                   if (zTopCanopy > side->zc[k]) {
 7476:                      // If the canopy is above the k layer...
 7477:                      
 7478:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 7479:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 7480:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 7481:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 7482: 
 7483:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 7484:                      const double vmag2 = length(ut2);
 7485:                      const double vmag1 = length(side->u2[k]);
 7486:                      const double vmag = 0.5*(vmag1 + vmag2);
 7487:                      
 7488:                      // Computes the vegetation alpha at the face center
 7489:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 7490: 
 7491:                      cff1 += veg_alpha_sd*dt*vmag;
 7492: 
 7493:                   } // if (zTopCanopy
 7494:                } // if iveg
 7495: 
 7496:                const double dzz = side->Dz(k + 1);
 7497:                const double dfz = 0.5*(side->dfv(k) + side->dfv(k + 1)); // Vertical viscosity at the face center
 7498:                const double tmp = dt*dfz/dzz;
 7499:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 7500: 
 7501:                cupp[kin] += cff1*dzz/6.0 - tmp;
 7502:                bdia[kin] += cff1*dzz/3.0 + tmp;
 7503:             }
 7504: 
 7505: 
 7506:             // Second part: layers k-1, k
 7507:             if (k > kb + 1) {
 7508: 
 7509:                double cff1 = 1.0; //init \bar{c^k}
 7510: 
 7511:                if constexpr(iveg != 0) {
 7512:                   // If there is vegetation at this level...
 7513:                   if (zTopCanopy > side->zc[k-1]) {
 7514:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 7515:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 7516: 
 7517:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 7518: 
 7519:                      const double vmag2 = length(ut2);
 7520:                      const double vmag1 = length(side->u2[k-1]);
 7521:                      const double vmag = 0.5*(vmag1 + vmag2);
 7522: 
 7523:                      // Computes the vegetation alpha at the face center
 7524:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 7525:                      cff1 += veg_alpha_sd*dt*vmag;
 7526:                   } // if zTopCanopy
 7527: 
 7528:                } // if iveg
 7529: 
 7530:                const double dzz = side->Dz(k);
 7531:                const double dfz = 0.5*(side->dfv(k) + side->dfv(k - 1)); // Vertical viscosity at the face center
 7532:                const double tmp = dt*dfz/dzz;
 7533:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 7534: 
 7535:                alow[kin] += cff1*dzz/6.0 - tmp;
 7536:                bdia[kin] += cff1*dzz/3.0 + tmp;
 7537: 
 7538:             } else { // Bottom boundary
 7539:                // This occurs at the bottom, where the bottom drag is applied.
 7540: 
 7541:                bdia[kin] += dt*side->chi2; // XXXX
 7542: 
 7543:             } // if (k > kb + 1)
 7544: 
 7545: 
 7546:          } // for (int k
 7547: 
 7548: 
 7549: 
 7550:          // Computes the RHS.
 7551:          // -----------------
 7552: 
 7553:          //	BC to be imposed at the end.
 7554: 
 7555:          const Vector2 gradETP  = side->gradETP;
 7556:          const Vector2 gradPr   = side->gradPr;
 7557:          const Vector2 gradEta1 = side->gradEta1;
 7558:          const Vector2 gradEta2 = side->gradEta2;
 7559: 
 7560:          const Vector2 *btu = side->btu;
 7561:          const Vector2 *u2  = side->u2;
 7562:          const double coriolis = side->coriolis;
 7563:          const Vector2 *nuGradU = side->nuGradU;
 7564: 
 7565:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 7566:          for (int k = kb + 1; k < nvrt; k++) {
 7567:             const int kin = k - kb - 1;
 7568: 
 7569:             const double dz_0 = side->Dz(k);
 7570:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 7571: 
 7572:             rrhs[kin] = {0.0, 0.0};
 7573:             double dz = 0.0;
 7574: 
 7575:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 7576:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 7577:             if (k < nvrt  ) dz += dz_1;
 7578:             if (k > kb + 1) dz += dz_0;
 7579: 
 7580:             // Elevation gradient, atmospheric pressure and tidal potential
 7581:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 7582: 
 7583:             // Coriolis, advection, wind stress, and horizontal viscosity
 7584:             if (k < nvrt - 1) {
 7585: 
 7586: 
 7587:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 7588:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 7589:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 7590:                                                 
 7591: 
 7592:                //diff stress tensors 1006
 7593:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 7594:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 7595:                   assert(false && "Not implemented: itur == 5");
 7596:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 7597:                }
 7598:                // else assert(false && "itur # Not implemented");
 7599: 
 7600:             } else { // k == nvrt - 1 SURFACE
 7601:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 7602:                const Vector2 tau2 = side->tau();
 7603: 
 7604:                rrhs[kin] += dt*tau2;          
 7605: 
 7606:             } // if k<nvrt
 7607: 
 7608: 
 7609:             if (k > kb + 1) {
 7610:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 7611:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 7612:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 7613: 
 7614:                // diff stress tensors 1006
 7615:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 7616:                   assert(false && "Not implemented: itur == 5");
 7617:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 7618:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 7619:                }
 7620:                // else assert(false && "itur # Not implemented");
 7621: 
 7622: 
 7623:             } // if k>kbs + 1
 7624: 
 7625:             // Baroclinic
 7626:             Vector2 *bcc = side->bcc;
 7627:             if constexpr(ibc == 0) {
 7628:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 7629:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 7630: 
 7631:             } // if ibc==0
 7632: 
 7633:          } // k=kb + 1,nvrt
 7634: 
 7635: 
 7636:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 7637: 
 7638:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 7639:             const int kin = k - kb - 1;
 7640:    
 7641:             // Velocity is always clamped to maximum values
 7642:             side->u2[k] = clampVelocity(soln[kin]);
 7643:          } // k
 7644: 
 7645:       } // if side->is2D()
 7646:       
 7647: 
 7648:       // Impose velocity boundary condition at the bottom
 7649:       if constexpr(imm == 2) { // 3D bed deformation model
 7650:          double dep;
 7651:          Vector2 vel;
 7652: 
 7653:          assert(false && "Not implemented: imm == 2");
 7654:          //update_bdef(time, x0, y0, dep, vel);
 7655:          // side->u2[kb] = vel;
 7656: 
 7657:       } else { // imm = 0 or 1
 7658:          if (side->Cd() == 0.0) {
 7659:             side->u2[kb] = side->u2[kb + 1];
 7660: 
 7661:          } else if (side->is3D()) { // 3D no slip bottom   
 7662:             side->u2[kb] = {0.0, 0.0};
 7663: 
 7664:          }
 7665:           
 7666:       } // if imm
 7667: 
 7668:       // The velocities below the bottom level are set to zero
 7669:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 7670: 
 7671: 
 7672:    }
 7673: 
 7674: 
 7675:    __global__ void applyMomentumBC(void) {
 7676: 
 7677:       SIDE_BND(sideBnd);
 7678: 
 7679:       Side *side = sideBnd->side;
 7680:       const BoundarySegment *segment = sideBnd->segment;
 7681:       const Node *n1 = side->n1;
 7682:       const Node *n2 = side->n2;
 7683: 
 7684:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 7685: 
 7686:       const bool isLand = segment->isLand;
 7687:       const int ifltype = segment->ifltype;
 7688: 
 7689:       const int kb = side->kb;
 7690: 
 7691: 
 7692:       if (!isLand && ifltype != 0) {
 7693:          const Vector2 *ubc = sideBnd->ubc;
 7694:   
 7695:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 7696:             
 7697:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 7698:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 7699: 
 7700:             if (ifltype == -1) {
 7701:                // Flather 1
 7702: 
 7703:                const double depth = side->depth();
 7704: 
 7705:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 7706: 
 7707:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 7708: 
 7709:                side->u2[k] = vnorm*side->n;
 7710: 
 7711:             } else if (ifltype == -2) { // Discharge
 7712: 
 7713:                const double eta1 = side->eta1();
 7714:                const double eta2 = side->eta2();
 7715:                const double htot = side->htot2();
 7716: 
 7717:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 7718:                assert(false && "Not implemented: Discharge bc");
 7719:                // const double dischrg = discharge(eta1);
 7720:                const double dischrg = 0.0; // XXX REMOVE
 7721:                
 7722: 
 7723:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 7724: 
 7725:                const double vnorm = dischrg*eta2/htot;
 7726: 
 7727:                side->u2[k] = vnorm*side->n;
 7728: 
 7729:             }
 7730:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 7731:                const double vnorm = dot(side->u2[k], side->n);
 7732: 
 7733:                double rat;
 7734:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 7735:                else              rat = segment->vobc2; // outgoing
 7736: 
 7737:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 7738: 
 7739:             }
 7740:             else { // not Flather or 3D radiation
 7741: if (ifltype == 2) printf("XXXXX ubc: %f, %f\n", ubc[k].x, ubc[k].y);
 7742:                side->u2[k] = ubc[k];
 7743: 
 7744:             } // if (segment->ifltype...
 7745: 
 7746:          }
 7747: 
 7748:       }
 7749:       else if (isLand) { // if it is land boundary side
 7750: 
 7751:          if constexpr(islip == 0) { // free slip
 7752: 
 7753:             for (int k = kb; k < nvrt; k++) {
 7754: 
 7755:                const Vector2 t = side->t();
 7756:                const Vector2 n = side->n;
 7757: 
 7758:                double vnorm = 0.0; // for most cases
 7759:                const double vtan = dot(side->u2[k], t);
 7760:                
 7761:                side->u2[k] = vtan*t - vnorm*n;
 7762: 
 7763:             }
 7764: 
 7765:          } else { // no slip
 7766:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 7767: 
 7768:          }
 7769:       } // if (side segment type...
 7770: 
 7771:    }
 7772: 
 7773: 
 7774:    __global__ void shapiroFilter1(void) {
 7775:       // First step of the Shapiro filter (normally used if indvel<=0)
 7776:       // Computes the filtered values and stores them in bcc (as a temporary array).
 7777: 
 7778:       SIDE(side);
 7779: 
 7780:       // Only internal wet sides are processed
 7781:       if (side->isDry || !(side->isInternal())) return;
 7782: 
 7783:       const int kb = side->kb;
 7784: 
 7785:       for (int mm = 0; mm < niter_shap; mm++) {
 7786: 
 7787:          for (int k = kb + 1; k < nvrt; k++) {
 7788:             // WARNING: reusing bcc as a temporary array to store the suru values.
 7789:             Vector2 suru = {0.0, 0.0};
 7790: 
 7791:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 7792: 
 7793:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 7794: 
 7795:                int kin = k;
 7796:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 7797:                
 7798:                // Get the velocity at the neighbor's side.
 7799:                Vector2 nSideU2 = nSide->u2[kin];
 7800: 
 7801:                // Projects the velocity to the current side frame if needed.
 7802:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 7803: 
 7804:                suru += nSideU2;
 7805:             }
 7806: 
 7807:             // Reusing bcc as a temporary array to store the suru values.
 7808:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 7809: 
 7810:          }
 7811:       }
 7812:    }
 7813: 
 7814:    __global__ void shapiroFilter2(void) {
 7815:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 7816: 
 7817:       SIDE(side);
 7818: 
 7819: 
 7820:       if (side->isDry || !(side->isInternal())) return;
 7821: 
 7822:       const int kb = side->kb;
 7823: 
 7824:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 7825: 
 7826:       if (side->is2D()) {
 7827:          side->u2[kb + 1] = side->bcc[kb + 1];
 7828:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 7829: 
 7830:       } else {
 7831:          // 3D
 7832:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 7833:          
 7834:       }
 7835: 
 7836:    }
 7837: 
 7838: 
 7839:    __global__ void ul0UpdateZCoords(void) {
 7840:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 7841:       
 7842:       NODE(node);      
 7843: 
 7844: 
 7845:       if (false) { //node->isDry) { XXXXXXX
 7846: 
 7847:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 7848: 
 7849:          if constexpr(ivcor != 1) node->kb = 0;
 7850: 
 7851:       } else {
 7852: 
 7853:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 7854:          node->updateKb();
 7855: 
 7856:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 7857: 
 7858:       }
 7859: 
 7860:       // We use the temp.b field to store the previous state of isDry.
 7861:       node->tmp.b = node->isDry;
 7862: 
 7863:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 7864:       node->isDry = true;
 7865: 
 7866:    }
 7867: 
 7868:    __global__ void ul0ComputeDryElements(void)
 7869:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 7870:    {
 7871:       ELEM(elem);
 7872: 
 7873:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 7874: 
 7875:       elem->kb = 0;
 7876: 
 7877:       if (elem->isDry) return;
 7878: 
 7879: 
 7880:    //    if(elem->isDry2()) { // XXXX
 7881:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 7882:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 7883:    //        call parallel_abort(errmsg)
 7884:    //    }
 7885: 
 7886:       const Node *n1 = elem->nodes[0];
 7887:       const Node *n2 = elem->nodes[1];
 7888:       const Node *n3 = elem->nodes[2];  
 7889:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 7890: 
 7891:       // Computes element's kb as the minimum of the nodes' kb.
 7892:       const int kb1 = n1->kb;
 7893:       const int kb2 = n2->kb;
 7894:       const int kb3 = n3->kb;
 7895:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 7896: 
 7897: 
 7898:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 7899: 
 7900: 
 7901:       // Computes the element z as the mean of the nodes z.
 7902:       for (int k = elem->kb; k < nvrt; k++) {
 7903: 
 7904:          // Compute the element z as the mean of the nodes z.
 7905:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 7906:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 7907:          elem->z[k] /= elem->i34;
 7908: 
 7909:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 7910:       }
 7911:                   
 7912:    }
 7913: 
 7914:    __global__ void ul0ComputeDryNodes(void)
 7915:    // Updates node's isDry based on the elements' isDry. 
 7916:    {
 7917:       NODE(node);
 7918: 
 7919:       node->isDry = true;
 7920: 
 7921:       // A node is wet if at least one of the elements sharing it is wet.
 7922:       for (int j = 0; j < node->numElements; j++) {
 7923:          const Element *elem = node->elements[j];
 7924:          if (!elem->isDry) {
 7925:             node->isDry = false;
 7926:             break;
 7927:          }
 7928:       }
 7929: 
 7930:        
 7931:    }
 7932: 
 7933: 
 7934:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 7935:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 7936:    // node->tmp.b is true if the node was previously dry.
 7937:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 7938:    {
 7939:       NODE(node);
 7940:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 7941: 
 7942:       // Avoid this the first time step.
 7943:       if (it == iths) return;  
 7944: 
 7945:       const bool wasDry = node->tmp.b;
 7946: 
 7947: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 7948: 
 7949:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 7950: 
 7951:          for (int k=0; k < nvrt; k++) {
 7952: 
 7953:             Vector3 utmp={0.0, 0.0, 0.0};
 7954: 
 7955:             double ttmp=0.0;
 7956:             double stmp=0.0;
 7957:             int icount=0;
 7958:             for (int j = 0; j < node->numNodes; j++) {
 7959: 
 7960:                const Node *nbrNode = node->nodes[j];
 7961:                
 7962:                const bool wasNbrDry = nbrNode->tmp.b;
 7963: 
 7964:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 7965:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 7966: 
 7967:                   icount++;
 7968: 
 7969:                   // Assume small element size in wet/dry zone so pframes are close to each other
 7970:                   utmp += nbrNode->uvw2(k);
 7971:                   
 7972:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 7973:                   stmp += nbrNode->tracers[k].tracer[1]; 
 7974:                }
 7975:             }
 7976: 
 7977:             if (icount > 0) {
 7978:                const double inv_icount = 1.0/icount;
 7979:                utmp = inv_icount*utmp;
 7980:                node->u2[k]     = {utmp.x, utmp.y};
 7981:                node->w2[k]     = utmp.z;
 7982:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 7983:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 7984:             } else {
 7985:                node->u2[k] = {0.0, 0.0};
 7986:                node->w2[k] = 0.0;
 7987:                // Initialize tracers to 0.0??? XXXXX
 7988:             }
 7989:          }
 7990:       }
 7991:    }
 7992: 
 7993:   
 7994:    
 7995: 
 7996: 
 7997:    __global__ void ul0UpdateSides(int it, int iths) {
 7998:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 7999:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 8000:    // The dryness of the sides is updated in ul0UpdateSides2.
 8001: 
 8002:       SIDE(side);
 8003: 
 8004:       // A side is wet if and only if at least one of its elements is wet.
 8005:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 8006:  
 8007:       const Node *n1 = side->n1;
 8008:       const Node *n2 = side->n2;
 8009:      
 8010:       const int kb1 = n1->kb;
 8011:       const int kb2 = n2->kb;
 8012: 
 8013:       side->kb = 0; // default when dry
 8014: 
 8015:       if (isWet) {
 8016: 
 8017:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 8018: 
 8019:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 8020: 
 8021:          side->kb = min(kb1, kb2);
 8022: 
 8023:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 8024: 
 8025:          for (int k = side->kb; k < nvrt; k++) {
 8026:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 8027: 
 8028:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 8029: 
 8030:             // Compute velocity for re-wetted sides 
 8031:             if ((it != iths) && (side->isDry && isWet)) {
 8032: 
 8033:                Vector2 utmp={0.0, 0.0};
 8034: 
 8035:                int icount=0;
 8036: 
 8037:                // For all the sides on the two elements that share this side
 8038:                for (int j = 0; j < 2; j++) {
 8039:                   const Element *elem = side->elems[j];
 8040:                   if (elem == nullptr) continue;
 8041: 
 8042:                   for (int jj=0; jj < elem->i34; jj++) {
 8043:                      const Side *nSide = elem->sides[jj];
 8044:                      if (nSide->isDry) continue;
 8045: 
 8046:                      icount++;
 8047:                      utmp += nSide->u2[k];  
 8048:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 8049:                   }
 8050:                }
 8051:                   
 8052:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 8053:                if (icount > 0)  side->u2[k] = utmp/icount;
 8054:                else             side->u2[k] = {0.0, 0.0};
 8055:                   
 8056:             } // if ((it != iths) && (side->isDry && isWet))
 8057: 
 8058:          } // for k
 8059: 
 8060:       } // if isWet 
 8061:       
 8062: 
 8063: 
 8064:    }
 8065: 
 8066:    __global__ void ul0UpdateSides2(void) {
 8067:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 8068:    
 8069:          SIDE(side);
 8070:    
 8071:          const Element *e1 = side->elems[0];
 8072:          const Element *e2 = side->elems[1];
 8073: 
 8074:          // A side is wet if and only if at least one of its elements is wet.
 8075:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 8076: 
 8077:          // Update the side's dryness
 8078:          side->isDry = !isWet;
 8079: 
 8080:    }
 8081: 
 8082: 
 8083:    __global__ void zeroNodalVelocities(void) {
 8084:       NODE(node);
 8085: 
 8086:       for (int k = 0; k < nvrt; k++) {
 8087:          node->u2[k]   = {0.0, 0.0};
 8088:          node->w2[k]   = 0.0;
 8089:          node->utmp[k] = {0.0, 0.0};         
 8090:       }
 8091:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 8092:    }
 8093:  
 8094: 
 8095:    __global__ void computeNodalVerticalVelocities1(void) {
 8096:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 8097:    // Adds the element's vertical velocity times the element's area.
 8098:       ELEM(elem);
 8099: 
 8100:       for (int j = 0; j < elem->i34; j++) {
 8101:          Node *node = elem->nodes[j];
 8102: 
 8103:          for (int k = node->kb; k < nvrt; k++) {
 8104:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 8105:          }
 8106:          atomicAdd(&(node->tmp.d), elem->area);
 8107:       }
 8108:    }
 8109: 
 8110:    __global__ void computeNodalVerticalVelocities2(void) {
 8111:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 8112:    // Divides by the total area of the elements sharing the    node.
 8113:       NODE(node);
 8114: 
 8115: 
 8116:       const double invArea = 1.0 / node->tmp.d;
 8117:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = invArea*node->w2[k];  // node->tmp.d contains the total area of the elements sharing the node
 8118: 
 8119:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 8120:    }
 8121: 
 8122: 
 8123:    __global__ void computeNodalHorizontalVelocities1(void) {
 8124: 
 8125:       assert(indvel <= 0 && "computeNodalHorizontalVelocities1 only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 8126: 
 8127:       ELEM(elem);
 8128: 
 8129:       if (elem->isDry) return;
 8130: 
 8131:       const int kb = elem->kb;
 8132:       const bool isTri = elem->isTri();
 8133: 
 8134:       if constexpr(indvel <= 0) {
 8135:          // Assuming discontinous hvel.
 8136: 
 8137:          if (isTri) { // For triangles
 8138:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 8139:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 8140:             #pragma unroll
 8141:             for (int j = 0; j < 3; j++) {
 8142:                // For every node of the triangle...
 8143:                Node *node = elem->nodes[j];
 8144: 
 8145:                if (node->isDry) continue;
 8146: 
 8147:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 8148:                const Side *s2 = elem->sides[(j + 1) % 3];
 8149:                const Side *s3 = elem->sides[(j + 2) % 3];
 8150: 
 8151:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 8152: 
 8153:                atomicAdd(&(node->tmp.i), 1);
 8154: 
 8155:                for (int k = kb; k < nvrt; k++)  {
 8156:                   Vector2 s1u2 = s1->u2[k];
 8157:                   Vector2 s2u2 = s2->u2[k];
 8158:                   Vector2 s3u2 = s3->u2[k];
 8159: 
 8160:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 8161:                   if constexpr(ics == 2) {
 8162:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 8163:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 8164:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 8165:                   }
 8166: 
 8167:                   Vector2 u = s2u2 + s3u2 - s1u2; // u extrapolated linearly at node j.   
 8168:                   u = clampVelocity(u);
 8169:                   atomicAdd(&(node->utmp[k].x), u.x);
 8170:                   atomicAdd(&(node->utmp[k].y), u.y);
 8171: 
 8172:                }
 8173: 
 8174:             }
 8175:          }
 8176:          else { // For quads
 8177: 
 8178: 
 8179:             // Compute the bilinear coordinates of the center of each diagonal.
 8180:             // Weights from side-center domain (Fortran shape_c2); eval at node-diagonal midpoints.
 8181:             double xi, eta;
 8182:             double shp13[4], shp24[4];
 8183:             Point2 x0, x1, x2, x3;
 8184:             elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 8185:             const Point2 p13 = 0.5 * (x0 + x2);   // Center of sides 1 & 3
 8186:             const Point2 p24 = 0.5 * (x1 + x3);   // Center of sides 2 & 4
 8187: 
 8188:             elem->inverseBilinearQuad(p13, xi, eta, shp13, true);
 8189:             elem->inverseBilinearQuad(p24, xi, eta, shp24, true);
 8190: 
 8191: 
 8192:             for (int k = kb; k < nvrt; k++) {
 8193: 
 8194:                //Each quad is split into two triangles. For each triangle we extrapolate as we did for triangles.
 8195:                Vector2 sideU[4];
 8196:                #pragma unroll
 8197:                for (int j = 0; j < 4; j++) {
 8198:                   Vector2 u = elem->sides[j]->u2[k];
 8199:                   if constexpr(ics == 2) u = elem->sides[j]->frame.projHorVec(u, elem->frame);
 8200:                   sideU[j] = u;
 8201:                }
 8202: 
 8203:                Vector2 ud1 = shp13[0]*sideU[0] + shp13[1]*sideU[1] + shp13[2]*sideU[2] + shp13[3]*sideU[3];
 8204:                Vector2 ud2 = shp24[0]*sideU[0] + shp24[1]*sideU[1] + shp24[2]*sideU[2] + shp24[3]*sideU[3];
 8205: 
 8206:                Vector2 ufg0 = clampVelocity(sideU[2] + sideU[3] - ud2);  // node 1: sides 3,4
 8207:                Vector2 ufg1 = clampVelocity(sideU[0] + sideU[3] - ud1);  // node 2: sides 1,4
 8208:                Vector2 ufg2 = clampVelocity(sideU[0] + sideU[1] - ud2);  // node 3: sides 1,2
 8209:                Vector2 ufg3 = clampVelocity(sideU[1] + sideU[2] - ud1);  // node 4: sides 2,3
 8210:                const Vector2 ufg[4] = {ufg0, ufg1, ufg2, ufg3};
 8211:                #pragma unroll
 8212:                for (int j = 0; j < 4; j++) {
 8213:                   Node *node = elem->nodes[j];
 8214:                   if (node->isDry) continue;
 8215: 
 8216:                   if (k == kb) atomicAdd(&(node->tmp.i), 1);
 8217:                   atomicAdd(&(node->utmp[k].x), ufg[j].x);
 8218:                   atomicAdd(&(node->utmp[k].y), ufg[j].y);
 8219:                }
 8220:             }
 8221: 
 8222:          }
 8223: 
 8224:       }
 8225:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 8226:       
 8227:    }
 8228: 
 8229: 
 8230:    __global__ void computeNodalHorizontalVelocities2(void) {
 8231:       NODE(node);
 8232: 
 8233:       const int nodeCount = node->tmp.i;
 8234: 
 8235:       if (nodeCount == 0) 
 8236:       {
 8237:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 8238:          return;
 8239:       }
 8240: 
 8241:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 8242:       
 8243:       const int kb = node->kb;
 8244: 
 8245:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 8246:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 8247:      }   
 8248: 
 8249:  
 8250: 
 8251:    __global__ void resetVelocityOpenBndNodes(void) {
 8252:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 8253: 
 8254:       NODE_BND(nodebnd);
 8255:  
 8256:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 8257:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 8258:       }
 8259: 
 8260:    }
 8261: 
 8262: 
 8263:    __global__ void setVelocityOpenBndNodes(void) {
 8264:    // For open boundary nodes sets their velocity to the imposed values.
 8265: 
 8266:       SIDE_BND(sidebnd);
 8267: 
 8268:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 8269:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 8270:          // to its segment to the average of the side velocity.
 8271: 
 8272:          for (int k = 0; k < nvrt; k++) {
 8273:             Node *n1 = sidebnd->side->n1;
 8274:             Node *n2 = sidebnd->side->n2;
 8275: 
 8276: 
 8277:             Vector2 &n1_u2 = n1->u2[k];
 8278:             Vector2 &n2_u2 = n2->u2[k];
 8279: 
 8280:             if (n1->nodeBnd->segment == sidebnd->segment) {
 8281:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 8282:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 8283:             }
 8284:             if (n2->nodeBnd->segment == sidebnd->segment) {
 8285:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 8286:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 8287:             }
 8288: 
 8289:          }
 8290: 
 8291:       }
 8292: 
 8293:    }
 8294: 
 8295: 
 8296:    __global__ void computeVerticalVelocity(void) {
 8297:       // Computes the vertical velocity at the (2D) element's centroid.
 8298:       // In this function we will be considering volumetric elements, with side faces and a 
 8299:       // bottom and a top face. We will call them SFs, BF and TF.
 8300:       // It computes the flux coming from BF and the SFs.
 8301:       // If the bed is moving, it takes that into account.
 8302:       // Since water is incompressible, the integral of the velocity times the normal vector
 8303:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 8304:       // and the BF is equal to the flux going out from the TF.
 8305:       // TF = - BF - sum(SFs).
 8306:       // It then computes the horizontal velocity at the center of TF.
 8307:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 8308:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 8309:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 8310: 
 8311:       ELEM(elem);
 8312: 
 8313:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 8314: 
 8315:       if (elem->isDry) return;
 8316: 
 8317:       const int kb = elem->kb;
 8318:       const bool isTri = elem->isTri();
 8319: 
 8320:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 8321: 
 8322:       // Compute the bottom velocity
 8323:       if constexpr(imm != 0) {
 8324:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 8325:       }
 8326: 
 8327: 
 8328:       double bottomArea3D;
 8329:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 8330: 
 8331:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 8332: 
 8333:       double topArea3D;
 8334: 
 8335:       // Bottom face flux
 8336:       double bottomFlux = 0.0;
 8337:       Vector2 u2meanBottom = {0.0, 0.0};
 8338:       const Vector2 gradh = elem->grad2(&Node::depth);
 8339:       if constexpr(imm==2) {
 8340:          Vector3 ubed;
 8341: 
 8342:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 8343:          // updateBDEF(ubed);
 8344:      
 8345:          // const double bflux0 = dot(ubed, elem_bottom_n);
 8346: 
 8347:          // elem->w[kb] += ubed.z;
 8348:       }
 8349:       else {
 8350: 
 8351:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 8352:   
 8353:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 8354:          // in the direction of motion.
 8355:          const double bottomW = - dot(gradh, u2meanBottom);  
 8356:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 8357: 
 8358:          // VElocity associated to the bed deformation
 8359:          double bedVelocity = 0.0;
 8360:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 8361: 
 8362:          elem->w[kb] = bedVelocity + bottomW; 
 8363: 
 8364:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 8365: 
 8366:          elem->transport.setVerticalAdvectionFlux(kb, 0.0);
 8367:          
 8368:       } // if imm
 8369: 
 8370:       // Compute w for kb+1 to nvrt-1
 8371:       for (int l = kb; l < nvrt - 1; l++) {
 8372: 
 8373:          // normal vector to the top face of the "volumetric" element (3D)
 8374:          Vector3 elem_top_n = elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 8375: 
 8376:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 8377:          assert(elem_top_n.z > 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 8378: 
 8379:          // Compute the total flux at the sides
 8380:          double sideFlux = 0.0;
 8381: 
 8382:          for (int j = 0; j < elem->i34; j++) {
 8383:             const Side *side = elem->sides[j];
 8384:             const int kbs = side->kb;
 8385:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 8386:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 8387:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 8388: 
 8389:             // The area is "clamped" meaning that it takes kb into account.
 8390:             const double sideArea = side->areaClamped(l + 1);
 8391: 
 8392:             const double sign = elem->ssign[j]; 
 8393: 
 8394:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 8395:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 8396:          }
 8397:          
 8398:          // Compute the horizontal velocity at the center of the top face as an average of the 
 8399:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 8400:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 8401: 
 8402:          // The flux at the top ace can be computed from the other flows.
 8403:          // All fluxes are in directions into the prism.
 8404:          const double topFlux = - sideFlux - bottomFlux;
 8405: 
 8406:          elem->transport.setVerticalAdvectionFlux(l + 1, topFlux);
 8407: 
 8408:          // Flux at the top face due to the horizontal velocities only
 8409:          // topFlux = topHorizontalFlux + topVerticalFlux
 8410:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 8411: 
 8412:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + sideFlux + bottomFlux = 0, so:
 8413:          const double topVerticalFlux = topFlux - topHorizontalFlux;  
 8414: 
 8415:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 8416: 
 8417:          bottomFlux = -topFlux;
 8418:          
 8419:       }
 8420: 
 8421:    }  
 8422: 
 8423: 
 8424: 
 8425: 
 8426: 
 8427: 
 8428: 
 8429: // !===============================================================================
 8430: // !===============================================================================
 8431: 
 8432: } // extern "C"
 8433: 
 8434: #ifdef DONTCOMPILE
 8435: __device__ void computeVerticalAdvection(void) {
 8436:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 8437: 
 8438:    sdbt(1:2,:,:)=0.d0
 8439: 
 8440:    const Side *side = FROM kernel;
 8441: 
 8442:    if(side->isDry) return;
 8443: 
 8444:    // If side is wet...
 8445: 
 8446: 
 8447:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 8448:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 8449:    double ws[nvrt] = {} // w @ side
 8450:    int icount = 0;
 8451:    for (int j=0; j<2; j++) {
 8452:       const Element *elem = side->elements[j];
 8453:        
 8454:       if(elem != nullptr) {
 8455:          icount++;
 8456:          for (int k=0; k<nvrt; k++) {
 8457:             ws[k] = ws[k] + elem->w[k];
 8458:          }
 8459:       }
 8460:    }  // for j
 8461: 
 8462:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 8463:    ws = ws/icount;
 8464: 
 8465:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 8466:    // Splines allow for a smooth transition between vertical levels.
 8467:    // Splines have continuity restrictions at the internal knots, but
 8468:    // we have to provide the 1st derivatives at the endpoints.
 8469:    const int kbs = side->kbs; 
 8470:    
 8471:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 8472:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 8473:    initCubicSpline(kbs, nvrt, side, ws, up)
 8474: 
 8475:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 8476:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 8477:    initCubicSpline(kbs, nvrt, side, ws, vp)
 8478: 
 8479:    // Total advection (average onto side)
 8480:    const Node *node1 = side->nodes[0];
 8481:    const Node *node2 = side->nodes[1];
 8482:    for (int k=kbs(i); k<nvrt; k++) {
 8483: 
 8484:       Vector2 bcc1 = node1->bcc[k];
 8485:       Vector2 bcc2 = node2->bcc[k];
 8486:       if constexpr(ics == 2) {
 8487:          // Project the velocities from the node frames to the side frame
 8488:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 8489:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 8490:       }
 8491: 
 8492:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 8493:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 8494: 
 8495:    }
 8496: }
 8497: #endif
 8498: 
 8499: 
 8500: extern "C" {
 8501:    __global__ void computeElemAverageGhat(void) {
 8502:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 8503: 
 8504:       ELEM(elem);
 8505:       
 8506:       elem->ghat1= {0.0, 0.0};  
 8507: 
 8508:       if constexpr(ihydraulics != 0) {
 8509:          if (nhtblocks > 0 && elem->isblock) return;
 8510:       }
 8511: 
 8512:       
 8513:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 8514:       // cff1-3: coefficients for 2D/3D
 8515: 
 8516:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 8517:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 8518:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 8519: 
 8520:       if (elem->isDry) return;
 8521: 
 8522:       // Average of the coefficients
 8523:       double av_cff1 = 0.0;  // av. for cff1
 8524:       double av_cff2 = 0.0;  // av. for cff2
 8525:       double av_cff3 = 0.0;  // av. for cff3
 8526:       double av_df = 0.0;  // av. for H^\alpha / H
 8527:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 8528:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 8529: 
 8530:       const int i34 = elem->i34;
 8531:       const int kb  = elem->kb;
 8532: 
 8533:       for (int j=0; j<i34; j++) {
 8534:          // For each node and side in the element...
 8535: 
 8536:          const Node *node = elem->nodes[j];
 8537:          const Side *side = elem->sides[j];
 8538: 
 8539:          const double chi      = side->chi;
 8540:          const double veg_c2   = side->veg_c2;
 8541:          const double veg_beta = side->veg_beta;
 8542:          const double veg_h    = side->veg_h();
 8543:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 8544: 
 8545:          const Vector2 gradPhi = elem->gradPhi[j];
 8546: 
 8547:          // Node - const in elem
 8548:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 8549:          elem->gradPr  += node->pr  *gradPhi;
 8550: 
 8551:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 8552: 
 8553:         
 8554:          const double htot  = side->htot2();        // Total depth at the side
 8555:          const double zctr2 = side->zTopCanopy();  
 8556: 
 8557:          double cff1; 
 8558:          double cff2; 
 8559:          double cff3;   
 8560:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 8561:          // coefficients applied to 2D/3D case 
 8562:             cff1 = side->hhat/htot;
 8563:             cff2 = 0.0;
 8564:             cff3 = 0.0;
 8565:          } else { //3D
 8566:             //Init for no-veg case
 8567:             cff1 = 1.0;
 8568:             cff2 = 1.0;
 8569:             cff3 = 0.0;
 8570: 
 8571:             if constexpr(iveg != 0) {
 8572:                // Computes coefficients used with vegetation terms G1, G2
 8573:                // cff1, cff3 are used for the first two terms in G1, G2:
 8574:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 8575:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 8576:                // In general, cff1*Ustar - cff3*Ustar_alpha
 8577:                if(veg_h < 0.99*htot) { // submergent vegetation
 8578:                   cff1 = 1.0;
 8579:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 8580:                   cff3 = veg_c;
 8581: 
 8582:                } else { // emergent vegetation
 8583:                   cff1 = 1.0/(1.0 + veg_c2);
 8584:                   cff2 = cff1;
 8585:                   cff3 = 0.0;
 8586: 
 8587:                }
 8588:             } // if iveg
 8589:          } //  2D/3D
 8590: 
 8591:          av_cff1 += cff1/i34;
 8592:          av_cff2 += cff2/i34;
 8593:          av_cff3 += cff3/i34;
 8594:          av_cff2_chi += cff2*chi/i34;
 8595:          av_cff3_chi += cff3*chi/i34;
 8596:          av_df += min(htot, veg_h)/(htot*i34);
 8597: 
 8598: 
 8599:          // btrack values: U^\star, U^{\star\alpha}
 8600:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 8601:          Vector2 Ustar       = {0.0, 0.0}; 
 8602:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 8603: 
 8604:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 8605:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 8606:          } else { //3D
 8607:             for (int k = side->kb + 1; k < nvrt; k++) {
 8608:             
 8609:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 8610:                Ustar += w2;
 8611: 
 8612:                if constexpr(iveg != 0) {
 8613:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 8614:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 8615:                        Ustar_alpha += zrat*w2; // XXXX
 8616:                    }
 8617:                }  // if iveg
 8618:             }  // for k
 8619:          }  //2D/3D
 8620: 
 8621:          // If needed, project the side velocities to the element frame
 8622:          if constexpr(ics==2) {
 8623:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 8624:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 8625:          }
 8626:         
 8627: 
 8628:          // Add btrack & surface stress terms to \breve{G} first
 8629:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 8630: 
 8631: 
 8632:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 8633:          Vector2 tau    = side->tau();  
 8634:          Vector2 ubstar = side->btu[side->kb + 1];  
 8635: 
 8636:          // If needed, project tau and ubstar to the element frame
 8637:          if constexpr(ics==2) {
 8638:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 8639:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 8640:          }
 8641: 
 8642:          // Term for surface and bottom stress
 8643:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 8644: 
 8645: 
 8646:          // All terms in F,F^\alpha,f_b except baroclinic
 8647:          // F, f_b: all explicit terms excluding vegetation 
 8648:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 8649:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 8650:          const double coriolis = side->coriolis;
 8651:          Vector2 F  =  coriolis*side->U;  // F_x
 8652:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 8653:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 8654: 
 8655:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 8656:             
 8657:             for (int k = side->kb; k < nvrt; k++) {
 8658:                if (zctr2 > side->zc[k-1]) {
 8659:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 8660:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 8661:                    Fa +=  coriolis*w2*zrat;
 8662:                } // if zctr2
 8663:             } // k
 8664:          } // iveg
 8665: 
 8666:          // Integrate horizontal viscosity force vertically
 8667:          for (int k=side->kb + 1; k<nvrt; k++) {
 8668:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 8669: 
 8670:             F += levelHorVisc;
 8671: 
 8672:             // Vegetation term
 8673:             if constexpr(iveg!=0) {
 8674:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 8675:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 8676:                   Fa += levelHorVisc*zrat;
 8677:                } 
 8678:             } // if iveg
 8679:          } // for k
 8680: 
 8681:          // Get nu*grad(U) at the side's bottom level
 8682:          Vector2 nuGradU = side->nuGradU[side->kb];
 8683: 
 8684:          fb += nuGradU;
 8685: 
 8686:          // If needed, project vectorsF, fb and Fa to the element frame
 8687:          if constexpr(ics==2) {
 8688:             F    = side->frame.projHorVec(F,    elem->frame);
 8689:             fb   = side->frame.projHorVec(fb,   elem->frame);
 8690:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 8691:          } // if ics
 8692: 
 8693:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 8694:       } // for j (nodes and sides)
 8695: 
 8696:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 8697: 
 8698: 
 8699:       // Finish off terms in F, F^\alpha and f_b
 8700:       const double grav3 = elem->mean(&Node::grav2);
 8701:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 8702:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 8703:       for (int j=0; j<i34; j++) { 
 8704:          // For each side in the element...
 8705:          const Side *side = elem->sides[j];
 8706:          const double chi = side->chi;
 8707: 
 8708:          const double htot = side->htot2();
 8709:          const double veg_h = side->veg_h();
 8710:          const Vector2 F  = htot*fb;
 8711:          const Vector2 Fa = min(htot, veg_h)*fb;
 8712: 
 8713:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 8714:       } // for j
 8715: 
 8716:       // tmp is already in elem frame
 8717:       elem->ghat1 += tmp/i34;
 8718: 
 8719:       // Baroclinic force
 8720:       if constexpr(ibc==0) {
 8721:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 8722: 
 8723:          Vector2 Fa = {0.0, 0.0};
 8724:          Vector2 intGradRho = {0.0, 0.0};
 8725:          
 8726:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 8727:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 8728:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 8729: 
 8730:             // \in F [m^2/s/s]
 8731:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 8732:          }
 8733: 
 8734:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 8735:          const Vector2 F = av_df*Fa; //approx
 8736:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 8737: 
 8738:       } // if ibc 
 8739: 
 8740: 
 8741: 
 8742:    } 
 8743: 
 8744: 
 8745: 
 8746: 
 8747: 
 8748: // ------------------------------------------------------------
 8749: // Transport
 8750: // ------------------------------------------------------------
 8751: 
 8752: __device__ bool TransportElem<TransportModel::Upwind>::use1stOrderUpwind(const Element *elem) const {
 8753:    if (itvd) {
 8754:       // Marked as such in tvd.prop: always 1st order upwind for this element
 8755:       return true;
 8756:    }
 8757: 
 8758:    // If any node of the element is shallow, use 1st order upwind
 8759:    for (int j = 0; j < elem->i34; j++) {
 8760:       if (elem->nodes[j]->htot2() < h_tvd) return true;
 8761:    }
 8762:    return false;
 8763: }
 8764: 
 8765: __device__ void TransportElem<TransportModel::Upwind>::savePrevTraces(const Element *elem) {
 8766:    for (int k = 0; k < nvrt; k++) prevTraces[k] = elem->tracers[k];
 8767: }
 8768: 
 8769: __device__ double TransportElem<TransportModel::Upwind>::maxPrismDt(const Element *elem, int k) const {
 8770:    if (inflow[k] == 0.0) return huge_double;
 8771:    return elem->volume(k - 1) / inflow[k] * (1.0 - 1.0e-6);
 8772: }
 8773: 
 8774: __device__ void TransportElem<TransportModel::Upwind>::setVerticalAdvectionFlux(int k, double flux)
 8775: {
 8776:    Qv[k] = flux;
 8777: }
 8778: 
 8779: __global__ void computeHorizAdvecFluxes(void) {
 8780: 
 8781: 
 8782:    SIDE(side)
 8783: 
 8784:    auto &transport = side->transport;
 8785: 
 8786:    for (int k = 0; k < nvrt; k++) transport.Qh[k] = -1.0e34; // Sentinel value for dry sides.
 8787: 
 8788:    if (side->isDry) return;
 8789: 
 8790:    const bool isLand = (side->sideBnd!=nullptr && side->sideBnd->segment != nullptr && side->sideBnd->segment->isLand);
 8791:    const int kb = side->kb;
 8792: 
 8793:    for (int k = kb + 1; k < nvrt; k++) {
 8794:       if (isLand) {
 8795:          transport.Qh[k] = 0.0;
 8796: 
 8797:       } else {
 8798:          const Vector2 n = side->n; // normal vector to the side
 8799:          const double area = side->area(k); // Area of the side face.
 8800:          const double vnor1 = dot(n, side->u2[k]);
 8801:          const double vnor2 = dot(n, side->u2[k-1]);
 8802:          const double vnor_c = 0.5*(vnor1 + vnor2); // Normal velocity at the face center.
 8803: 
 8804:          transport.Qh[k] = area*vnor_c; 
 8805:       }
 8806: 
 8807:    }
 8808: 
 8809: }
 8810: 
 8811: __global__ void horizontalAdvectionPrepare(void) {
 8812: 
 8813:    // Horizontal advection kernel.
 8814:    // -------------------------------
 8815: 
 8816:    // In this model, equations are written in such a way that concentration at time t+1 are computed from
 8817:    // *differences* of concentrations at the cell underconsideration and concentrations upwind of it. 
 8818:    // (how upwind is determined depends on the scheme)
 8819:    // 
 8820:    // For the 1st order upwind scheme, "upwind concentration" at outflow faces is the concentration at the cell itself.
 8821:    // So only inflow faces contribute to the concentration change at the cell.
 8822: 
 8823:    // In the implementation, we do 1st order independently and then consider TVD as an additional update term computed as 
 8824:    // as a sum over all faces (inflow and outflow).
 8825: 
 8826: 
 8827:    // Compute total inflow and maximum allowed sub-time step
 8828:    ELEM(elem)
 8829: 
 8830:    const int kb = elem->kb;
 8831:    const int i34 = elem->i34;
 8832:    auto &transport = elem->transport;
 8833: 
 8834:    if (elem->isDry) return;
 8835: 
 8836:    // Snapshot current prism tracers for this substep (Update reads prevTraces).
 8837:    transport.savePrevTraces(elem);
 8838: 
 8839:    elem->transport.maxDt = huge_double;
 8840: 
 8841:    for (int k = 0; k < kb + 1; k++) elem->transport.inflow[k] = 0.0;
 8842: 
 8843:    for (int k = kb + 1; k < nvrt; k++) { // For each wet prism in the element...
 8844: 
 8845:       transport.inflow[k] = 0.0;
 8846: 
 8847:       for (int j = 0; j < i34; j++) { // For each side in the element...
 8848:          const Side *side = elem->sides[j];
 8849:          const auto &sideTransport = side->transport;
 8850:          const double ssign = elem->ssign[j];
 8851:          const int kbs = side->kb;
 8852: 
 8853:          if (k <= kbs) continue;
 8854: 
 8855:          // Get the element at the other end of side j.
 8856:          const Element *neighElem = side->otherElem(elem);
 8857:          if (neighElem == nullptr || neighElem->isDry) continue;
 8858: 
 8859:          const double faceQ = sideTransport.Qh[k];
 8860:          const bool inFlux = (ssign*faceQ) < 0.0; // true if the flux points into the element
 8861: 
 8862:          const BoundarySegment *boundarySegment = (side->sideBnd == nullptr) ? nullptr : side->sideBnd->segment;
 8863:          const bool isLand = (boundarySegment != nullptr && boundarySegment->isLand);
 8864: 
 8865:          // Count this side's flux only when water flows into the element, and the water is coming from somewhere 
 8866:          // real: either a wet neighboring element, or an open boundary.         
 8867:          if (isLand || !inFlux) continue;
 8868: 
 8869:          transport.inflow[k] += fabs(faceQ);  // Sum of all inflow fluxes at level k.
 8870: 
 8871:       }
 8872:       
 8873:       // computes the minimum allowed sub-time step for the prism
 8874:       elem->transport.maxDt = min(elem->transport.maxDt, elem->transport.maxPrismDt(elem, k));
 8875:    }
 8876: 
 8877: }
 8878: 
 8879: __global__ void horizontalAdvectionUpdate(double dtb) {
 8880:    ELEM(elem);
 8881: 
 8882:    if (elem->isDry) return;
 8883: 
 8884:    const int kb = elem->kb;
 8885:    auto &transport = elem->transport;
 8886: 
 8887:    for (int k = kb + 1; k < nvrt; k++) {
 8888:       const double vol = elem->volume(k - 1);
 8889:       const double dtb_by_vol = dtb / vol;
 8890:       Tracers adv = transport.prevTraces[k];  // start from old C
 8891: 
 8892:       for (int j = 0; j < elem->i34; j++) {
 8893: 
 8894:          const Side *side = elem->sides[j];
 8895: 
 8896:          if (k <= side->kb) continue;
 8897: 
 8898:          const double faceQ = side->transport.Qh[k];
 8899:          const double sQ = elem->ssign[j] * faceQ;
 8900:          if (sQ >= 0.0) continue;  // outflow or zero: skip (upwind)
 8901: 
 8902:          // outside concentration
 8903:          Tracers Cout = adv;  // default: no change (e.g. land / same as interior)
 8904:          const Element *neigh = side->otherElem(elem);
 8905:          if (neigh != nullptr && !neigh->isDry) {
 8906:             Cout = neigh->transport.prevTraces[k];
 8907:          } else if (side->sideBnd != nullptr && !side->sideBnd->segment->isLand) {
 8908:             // XXXXXXXXXXXXX
 8909:             // Cout.tracer[0] = 0.1;
 8910:             // Cout.tracer[1] = 0.1;
 8911:          } else {
 8912:             continue;
 8913:          }
 8914: 
 8915:          const double coef = dtb_by_vol * fabs(faceQ);
 8916:          #pragma unroll 
 8917:          for (int itr = 0; itr < ntracers; itr++)
 8918:             adv.tracer[itr] += coef * (Cout.tracer[itr] - transport.prevTraces[k].tracer[itr]);
 8919:       }
 8920: 
 8921:       elem->tracers[k] = adv;
 8922:    }
 8923: 
 8924:    // extend below bottom
 8925:    for (int k = 0; k <= kb; k++)
 8926:       elem->tracers[k] = elem->tracers[kb + 1];
 8927: }
 8928: 
 8929: __global__ void verticalAdvectionUpdate(double dt) {
 8930: 
 8931:    ELEM(elem);
 8932: 
 8933:    if (elem->isDry) return;
 8934: 
 8935:    const int kb = elem->kb;
 8936:    auto &transport = elem->transport;
 8937: 
 8938:    // Fortran workshare: trel_tmp = tr_el
 8939:    transport.savePrevTraces(elem);
 8940: 
 8941:    const bool upwindElem = transport.use1stOrderUpwind(elem);
 8942: 
 8943:    // For TransportModel::Upwind this is always the path below (phi=0).
 8944:    double alow[nvrt], bdia[nvrt], cupp[nvrt], rrhs[nvrt], soln[nvrt], gam[nvrt];
 8945: 
 8946:    // Outer tracer loop as in Fortran (m=1..ntr). Matrix is scalar in m.
 8947:    for (int itr = 0; itr < ntracers; itr++) {
 8948:       // ---- upwind / iter_back: phi=0, flux_mod_v1=1, denom=1 ----
 8949:       // Full SB-TVD iteration (rrat, phi, flux_mod_v1/v2, psi1) omitted here;
 8950:       // that is the TVD branch when !upwindElem. Structure is in Fortran L1224-1488.
 8951:       const int nEq  = nvrt - (kb + 1);
 8952:       for (int kin = 0; kin < nEq ; kin++) {
 8953:          alow[kin] = 0.0;
 8954:          cupp[kin] = 0.0;
 8955:          bdia[kin] = 0.0;
 8956:       }
 8957:       for (int k = kb + 1; k < nvrt; k++) {
 8958:          const int kin = k - (kb + 1);
 8959:          const double dt_by_bigv = dt / elem->volume(k - 1);
 8960:          // upwind: denom = 1
 8961:          bdia[kin] += 1.0;
 8962:          rrhs[kin]  = transport.prevTraces[k].tracer[itr] * 1.0;
 8963:          // Upper face inflow: Qv[k] < 0
 8964:          if (k != nvrt - 1 && transport.Qv[k] < 0.0) {
 8965:             const double tmp = dt_by_bigv * fabs(transport.Qv[k]); // * flux_mod_v1(=1)
 8966:             cupp[kin] -= tmp;
 8967:             bdia[kin] += tmp;
 8968:          }
 8969:          // Lower face inflow: Qv[k-1] > 0
 8970:          if (k - 1 != kb && transport.Qv[k - 1] > 0.0) {
 8971:             const double tmp = dt_by_bigv * fabs(transport.Qv[k - 1]);
 8972:             alow[kin] -= tmp;
 8973:             bdia[kin] += tmp;
 8974:          }
 8975:       }
 8976:       tridag_sch<1>(nEq , alow, bdia, cupp, rrhs, soln, gam);
 8977:       for (int k = kb + 1; k < nvrt; k++)
 8978:          elem->tracers[k].tracer[itr] = soln[k - (kb + 1)];
 8979:    }
 8980:    // Extend below bottom
 8981:    for (int k = 0; k <= kb; k++)
 8982:       elem->tracers[k] = elem->tracers[kb + 1];
 8983: }
 8984: 
 8985: 
 8986: // Fortran transport_TVD_imp step 3: non-advection (vertical diffusion).
 8987: // Call after verticalAdvectionUpdate(dt), before nodalTracerUpdate.
 8988: // Requires dfh set (itur!=0 path, or dfh0>0 when itur==0).
 8989: __global__ void verticalDiffusionUpdate(double dt) {
 8990: 
 8991:    ELEM(elem);
 8992: 
 8993:    if (elem->isDry) return;
 8994: 
 8995:    const int kb = elem->kb;
 8996:    auto &transport = elem->transport;
 8997: 
 8998:    // Fortran: trel_tmp = tr_el
 8999:    transport.savePrevTraces(elem);
 9000: 
 9001:    double alow[nvrt], bdia[nvrt], cupp[nvrt], rrhs[nvrt], soln[nvrt], gam[nvrt];
 9002: 
 9003:    for (int itr = 0; itr < ntracers; itr++) {
 9004:       const int nEq = nvrt - (kb + 1);
 9005: 
 9006:       for (int kin = 0; kin < nEq; kin++) {
 9007:          alow[kin] = 0.0;
 9008:          cupp[kin] = 0.0;
 9009:          bdia[kin] = 1.0;
 9010:          rrhs[kin] = 0.0;
 9011:       }
 9012: 
 9013:       // Prism k = kb+1 .. nvrt-1  (Fortran kbe+1 .. nvrt)
 9014:       for (int k = kb + 1; k < nvrt; k++) {
 9015:          const int kin = k - (kb + 1);
 9016:          const double dt_by_bigv = dt / elem->volume(k - 1);
 9017: 
 9018:          // Diffusion at upper face k (Fortran k < nvrt)
 9019:          if (k < nvrt - 1) {
 9020:             const double av_df = elem->mean(k, &Node::dfh);
 9021:             const double av_dz = 0.5 * (elem->z[k + 1] - elem->z[k - 1]);
 9022:             const double tmp   = elem->area * dt_by_bigv * av_df / av_dz;
 9023:             cupp[kin] -= tmp;
 9024:             bdia[kin] += tmp;
 9025:             // settling @ face k: if wsett<=0 bdia -= area*dt_by_bigv*wsett;
 9026:             //                     else cupp -= area*dt_by_bigv*wsett;
 9027:          }
 9028: 
 9029:          // Diffusion at lower face k-1 (Fortran k > kbe+1)
 9030:          if (k > kb + 1) {
 9031:             const double av_df = elem->mean(k - 1, &Node::dfh);
 9032:             const double av_dz = 0.5 * (elem->z[k] - elem->z[k - 2]);
 9033:             const double tmp   = elem->area * dt_by_bigv * av_df / av_dz;
 9034:             alow[kin] -= tmp;
 9035:             bdia[kin] += tmp;
 9036:             // settling @ face k-1: if wsett<=0 alow += ...; else bdia += ...;
 9037:          }
 9038: 
 9039:          // Bottom settling BC (iwsett==1, k==kbe+1): bdia += area*dt_by_bigv*wsett(kb)
 9040: 
 9041:          rrhs[kin] = transport.prevTraces[k].tracer[itr];
 9042:          // if (k == nvrt - 1) rrhs += area * dt_by_bigv * flx_sf;
 9043:          // if (k == kb + 1)   rrhs -= area * dt_by_bigv * flx_bt;
 9044:          // rrhs += dt * bdy_frc;
 9045:       }
 9046: 
 9047:       tridag_sch<1>(nEq, alow, bdia, cupp, rrhs, soln, gam);
 9048: 
 9049:       for (int k = kb + 1; k < nvrt; k++)
 9050:          elem->tracers[k].tracer[itr] = soln[k - (kb + 1)];
 9051:    }
 9052: 
 9053:    for (int k = 0; k <= kb; k++)
 9054:       elem->tracers[k] = elem->tracers[kb + 1];
 9055: }
 9056: 
 9057: __global__ void nodalTracerUpdate(void) {
 9058:    NODE(node);
 9059:    if (node->isDry) return;
 9060: 
 9061:    for (int k = 0; k < nvrt; k++) {
 9062:       Tracers sum = {};
 9063:       double sumA = 0.0;
 9064: 
 9065:       for (int j = 0; j < node->numElements; j++) {
 9066:          const Element *elem = node->elements[j];
 9067:          if (elem->isDry) continue;
 9068: 
 9069:          // Element value at whole level kin (Fortran swild98): prisms kin and kin+1 are
 9070:          // interpolated linearly in z between their centers; surface takes the top prism,
 9071:          // the bed takes the bottom prism.
 9072:          const int kb  = elem->kb;
 9073:          const int kin = max(k, kb);
 9074:          int kLo = kin, kHi = kin + 1;
 9075:          double zrat = 0.0;  // Weight of prism kLo
 9076: 
 9077:          if      (kin == ivrt) { kLo = ivrt;   kHi = ivrt; }
 9078:          else if (kin == kb)   { kLo = kb + 1; kHi = kb + 1; }
 9079:          else zrat = (elem->z[kin + 1] - elem->z[kin]) / (elem->z[kin + 1] - elem->z[kin - 1]);
 9080: 
 9081:          const double A = elem->area;
 9082:          for (int itr = 0; itr < ntracers; itr++)
 9083:             sum.tracer[itr] += A * ((1.0 - zrat)*elem->tracers[kHi].tracer[itr] + zrat*elem->tracers[kLo].tracer[itr]);
 9084:          sumA += A;
 9085:       }
 9086: 
 9087:       if (sumA == 0.0) continue;
 9088:       const double invsumA = 1.0/sumA;
 9089:       for (int itr = 0; itr < ntracers; itr++)
 9090:          node->tracers[k].tracer[itr] = invsumA * sum.tracer[itr];
 9091:    }
 9092: }
 9093: 
 9094: __global__ void computeNodeDensity(void) {
 9095: // Nodal density at whole levels from nodal T, S.
 9096: // Dry nodes get the -99 sentinel. Below the bed, T,S are taken at level k (already extended
 9097: // below kb) and the depth is clamped to the bed, z[max(k,kb)].
 9098:    NODE(node);
 9099: 
 9100:    if (node->isDry) {
 9101:       for (int k = 0; k < nvrt; k++) node->rho[k] = -99.0;
 9102:       return;
 9103:    }
 9104: 
 9105:    const int kb = node->kb;
 9106:    for (int k = 0; k < nvrt; k++) {
 9107:       const double temp = node->tracers[k].tracer[0];
 9108:       const double salt = node->tracers[k].tracer[1];
 9109:       node->rho[k] = eqstate(temp, salt, node->z[max(k, kb)]);
 9110:    }
 9111: }
 9112: 
 9113: __global__ void computeElemDensity(void) {
 9114: // Element (prism) density from element T,S (Fortran erho).
 9115: // Dry elements get the -99 sentinel. Prisms at or below kb hold the kb+1 tracers (see the
 9116: // transport update), and the depth is the whole level z[max(k,kb)], as in Fortran.
 9117:    ELEM(elem);
 9118: 
 9119:    if (elem->isDry) {
 9120:       for (int k = 0; k < nvrt; k++) elem->rho[k] = -99.0;
 9121:       return;
 9122:    }
 9123: 
 9124:    const int kb = elem->kb;
 9125:    for (int k = 0; k < nvrt; k++) {
 9126:       const double temp = elem->tracers[k].tracer[0];
 9127:       const double salt = elem->tracers[k].tracer[1];
 9128:       elem->rho[k] = eqstate(temp, salt, elem->z[max(k, kb)]);
 9129:    }
 9130: }
 9131: 
 9132: 
 9133: __device__ __forceinline__ void atomicMinDouble(double *addr, double val) {
 9134:    unsigned long long *p = (unsigned long long *)addr;
 9135:    unsigned long long old = *p, assumed;
 9136:    do {
 9137:       assumed = old;
 9138:       old = atomicCAS(p, assumed,
 9139:          __double_as_longlong(fmin(val, __longlong_as_double(assumed))));
 9140:    } while (assumed != old);
 9141: }
 9142: 
 9143: __device__ __forceinline__ double blockMin(double v) {
 9144:    __shared__ double sh[32];
 9145:    const int lane = threadIdx.x & 31;
 9146:    const int warp = threadIdx.x >> 5;
 9147:    for (int o = 16; o > 0; o >>= 1)
 9148:       v = fmin(v, __shfl_down_sync(0xffffffffu, v, o));
 9149:    if (lane == 0) sh[warp] = v;
 9150:    __syncthreads();
 9151:    if (warp == 0) {
 9152:       const int nw = blockDim.x >> 5;
 9153:       v = (lane < nw) ? sh[lane] : huge_double;
 9154:       for (int o = 16; o > 0; o >>= 1)
 9155:          v = fmin(v, __shfl_down_sync(0xffffffffu, v, o));
 9156:    }
 9157:    return v;  // only lane 0 of warp 0 is the block min
 9158: }
 9159: 
 9160: extern "C" __global__ void minTransportDt(double *out) {
 9161:    const int idx = threadIdx.x + blockIdx.x * blockDim.x;
 9162:    double v = huge_double;
 9163:    if (idx < mesh->ne) {
 9164:       Element *elem = &mesh->localElemData[idx];
 9165:       if (!elem->isDry) v = elem->transport.maxDt;
 9166:    }
 9167:    __shared__ double sh[32];
 9168:    const int lane = threadIdx.x & 31;
 9169:    const int warp = threadIdx.x >> 5;
 9170:    for (int o = 16; o > 0; o >>= 1)
 9171:       v = fmin(v, __shfl_down_sync(0xffffffffu, v, o));
 9172:    if (lane == 0) sh[warp] = v;
 9173:    __syncthreads();
 9174:    if (warp == 0) {
 9175:       const int nw = (blockDim.x + 31) >> 5;
 9176:       v = (lane < nw) ? sh[lane] : huge_double;
 9177:       for (int o = 16; o > 0; o >>= 1)
 9178:          v = fmin(v, __shfl_down_sync(0xffffffffu, v, o));
 9179:       if (lane == 0) atomicMinDouble(out, v);
 9180:    }
 9181: }
