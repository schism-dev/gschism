 8914:                                  
 8915:   __global__ void populateMesh(int *i34, int *elnode, int *elside,
 8916:                    double *node_coords, double *node_coords_ll, bool use_ll,
 8917:                    double *wind_rotate_angle,  int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 8918:                    int *isdel, int *isidenode, int *isbnd,
 8919:                    int *nond, int *nlnd, int *iond, int *ilnd, 
 8920:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 8921:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 8922:                    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 8923:                    int *localNodeIndices, int *localElemIndices, int *localSideIndices,
 8924:                    int *localNodePart,    int *localElemPart,    int *localSidePart,
 8925:                    double *drag, double *roughness,
 8926:                    double *emo, double *efa, 
 8927:                    double *umo, double *ufa, 
 8928:                    double *vmo, double *vfa) {
 8929: 
 8930:     mesh->populateMesh(i34, elnode, elside, node_coords, node_coords_ll, use_ll, wind_rotate_angle, 
 8931:                        sharedIdxNodeBoundary, sharedIdxSideBoundary,
 8932:                        isdel, isidenode, isbnd,
 8933:                        nond, nlnd, iond, ilnd, 
 8934:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 8935:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 8936:                        globalNodeIndices, globalElemIndices, globalSideIndices,
 8937:                        localNodeIndices, localElemIndices, localSideIndices,
 8938:                        localNodePart, localElemPart, localSidePart,
 8939:                        drag, roughness,
 8940:                        emo, efa, umo, ufa, vmo, vfa);  // XXXXX Remember to refactor this, removing the parameters that are not used.
 8941:   }
