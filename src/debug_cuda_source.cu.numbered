 1501: 
 1502: /**
 1503:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1504:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1505:    If the segment is completely inside the element, then it returns true.
 1506: 
 1507:    This function assumes:
 1508:    - The initial point is on a side of the element. 
 1509:    - Its position is given by parameter t in the range [0,1].
 1510:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1511:       intersects the element (elements are convex).
 1512: 
 1513:    To find the intersection point, this function does the following:
 1514:    - it finds the intersection of the line segment with all the element side lines,
 1515:       except for the one that contains the initial point.
 1516:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1517:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1518:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1519:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1520:       track segment is almost parallel to the element side line.
 1521: 
 1522:    Inputs:
 1523:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1524:    @param x2, y2: other end of the line segment
 1525: 
 1526:    Outputs:
 1527:    @param side:  side that intersects the line segment (input and output)
 1528:    @param nextElement (output): element that contains the intersection point
 1529:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1530:    @param zint (input/output): Vertical coordinate of the intersection point
 1531: 
 1532:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1533:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1534:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1535: 
 1536:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1537:    (Delta) being zero.
 1538: 
 1539:    The intersection2 point happens when:
 1540:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1541:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1542:    
 1543:    Assumption: the 4 points (including those of the side segment) are different.
 1544:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1545:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1546:    If true, (xIntersect,yIntersect) is the intersection.				
 1547:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1548: **/
 1549: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1550:                                               double &t, double& tIntersect) {
 1551: 
 1552:    double closest_intersect_t = 1e10;
 1553:    bool found_intersection = false;
 1554: 
 1555:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1556:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1557:    const Point2 x1 = side->point(t);
 1558:    
 1559: 
 1560:    Side *nextSide = nullptr;
 1561:    for (int i = 0; i < i34; i++) {
 1562: 
 1563:       // Element's i-th side 
 1564:       Side *side2 = sides[i];
 1565: 
 1566:       // Skip the side that contains the initial point
 1567:       if (side2 == side) continue;
 1568: 
 1569:       // (x3,y3)-(x4,y4) is the element side line
 1570:       const Point2 x3 = side2->n1->p2();
 1571:       const Point2 x4 = side2->n2->p2();
 1572: 
 1573:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1574:       const double delta = cross(x2 - x1, x3 - x4);
 1575: 
 1576:       if (delta != 0.0) {
 1577: 
 1578:          const double delta1 = cross(x3 - x1, x3 - x4);
 1579:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1580: 
 1581:          // Solves the two linear equations for tt1 and tt2
 1582:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1583:          const double tt2 = delta2/delta;
 1584: 
 1585:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1586:             closest_intersect_t = min(closest_intersect_t, tt1);
 1587:             nextSide = side2;
 1588: 
 1589:             nextElement = nextSide->otherElem(this);
 1590:             tIntersect = max(small, min(tt1, 1.0-small));
 1591:             t = tt2;
 1592: 
 1593:             found_intersection = true;
 1594:          }
 1595:       
 1596:       }
 1597: 
 1598:    }
 1599:    
 1600: printf("AAA 1, found_intersection = %d, nextSide = %p, nextElement = %p\n", found_intersection, nextSide, nextElement);
 1601: 
 1602: 
 1603:    // found_intersection should always be true, since we checked all the sides.  
 1604:    side = nextSide;
 1605: // if (found_intersection) {
 1606: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1607: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1608: // }   
 1609:    // if (!found_intersection) {
 1610:    //    // Check if the segment is parallel to the initial side
 1611:    //    printf("XXX segment: side = %p\n", side);
 1612:    //    printf("XXX %f\n", dot(x2 - x1, side->n1->p2() - side->n2->p2()));
 1613:    //    if (abs(dot(x2 - x1, side->n1->p2() - side->n2->p2())) < small) {
 1614:    //       assert(false && "Segment is parallel to the initial side");
 1615:    //       found_intersection = true;
 1616:    //       nextElement = side->otherElem(this);
 1617:    //       tIntersect = t;
 1618:    //       t = 0.0;
 1619:    //       found_intersection = true;
 1620:    //    }
 1621:    // }
 1622:    return found_intersection;
 1623: }
 1624: 
