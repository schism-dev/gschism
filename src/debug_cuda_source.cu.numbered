 8366: extern "C" __global__ void getElementVarFunc(int varCode, double *res) {
 8367: 
 8368:    ELEM(elem);
 8369: 
 8370:    switch (varCode) {
 8371:       case (int)VarCode::outputCoords:
 8372:          const Point2 coords = elem->outputCoords();
 8373:          res[elem->idx*2    ] = coords.x;
 8374:          res[elem->idx*2 + 1] = coords.y;
 8375:          break;
 8376:    }
 8377: }
