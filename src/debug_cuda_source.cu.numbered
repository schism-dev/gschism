 5242: extern "C" {
 5243: 
 5244:    __global__ void scaleGravity(double loadtide_coef) {
 5245: 
 5246: 
 5247:       NODE(node);
 5248: 
 5249:       // SAL option: scale gravity
 5250:       if constexpr(iloadtide==2) {  // simple const
 5251:          node->grav2 = grav*(1.0 - loadtide_coef);
 5252: 
 5253:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 5254:         
 5255:           const double depth = max(node->depth, 0.0);
 5256:           const double tmp1 = sqrt(depth);
 5257:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 5258:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 5259:                              2.6969e-13*depth*depth*depth*tmp1;
 5260:           
 5261:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 5262:           
 5263: 
 5264: 
 5265:           node->grav2 = grav*(1.0 - beta_bar);
 5266: 
 5267:       } else {  // iloadtide=0,1
 5268:           node->grav2 = grav;
 5269: 
 5270:       }
 5271: 
 5272:    }
 5273: 
 5274: 
 5275:    __global__ void setWinds(double *xWind, double *yWind, double *pressAir) {
 5276:       NODE(node);
 5277: 
 5278:       const int idx = node->idx;
 5279:       Vector2 wind = {xWind[idx], yWind[idx]};
 5280: 
 5281:       if constexpr(nws != 0 && iwindoff != 0) {
 5282:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 5283:       }
 5284: 
 5285:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 5286:       node->setWind(wind);
 5287: 
 5288:       node->pr = pressAir[idx];
 5289:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 5290: 
 5291:    }
