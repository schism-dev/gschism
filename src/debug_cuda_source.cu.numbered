 2154:    template<typename T>
 2155:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 2156:       // Get the values of the field at the nodes of the element
 2157:       res[0] = nodes[0]->*field;
 2158:       res[1] = nodes[1]->*field;
 2159:       res[2] = nodes[2]->*field;
 2160:       if (isQuad()) res[3] = nodes[3]->*field;
 2161:       else          res[3] = T();
 2162:    }
 2163: 
 2164:    template<typename T>
 2165:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 2166: 
 2167:       assert(level < nvrt && "Level is out of range");
 2168:       // Get the values of the field at the nodes of the element
 2169:       res[0] = (nodes[0]->*field)[max(level, nodes[0]->kb)];
 2170:       res[1] = (nodes[1]->*field)[max(level, nodes[1]->kb)];
 2171:       res[2] = (nodes[2]->*field)[max(level, nodes[2]->kb)];
 2172:       if (isQuad()) res[3] = (nodes[3]->*field)[max(level, nodes[3]->kb)];
 2173:       else          res[3] = T();
 2174:    }    
 2175: 
 2176:    template<typename T>
 2177:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
 2178: 
 2179:       assert(level < nvrt && "Level is out of range");
 2180: 
 2181:       // Get the values of the func at the nodes of the element
 2182:       res[0] = (nodes[0]->*func)(max(level, nodes[0]->kb));
 2183:       res[1] = (nodes[1]->*func)(max(level, nodes[1]->kb));
 2184:       res[2] = (nodes[2]->*func)(max(level, nodes[2]->kb));
 2185:       if (isQuad()) res[3] = (nodes[3]->*func)(max(level, nodes[3]->kb));
 2186:       else          res[3] = T();  // This is 0.0 or a zero vector
 2187: 
 2188:    }      
