 1602: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000) {
 1603:    // Lock the mutex
 1604:    lock(&debugPlotMutex);
 1605:  
 1606:    if (debugPlotIdx == nullptr) return;
 1607:    if (*debugPlotIdx >= 10000) return;
 1608: // printf("addDebugPlot 2, x1 = (%f, %f), x2 = (%f, %f)\n", x1.x, x1.y, x2.x, x2.y);   
 1609:    debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1610:    debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1611:    debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1612:    debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1613:    debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1614:    (*debugPlotIdx)++;
 1615:    // Unlock the mutex
 1616:    unlock(&debugPlotMutex);
 1617: 
 1618: }
