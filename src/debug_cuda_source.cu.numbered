 1547:       printf("npgb = %d, negb = %d, nsgb = %d, nseg = %d\n", npgb, negb, nsgb, nseg);
 1548:       printf("np = %d, ne = %d, ns = %d\n", np, ne, ns);
 1549:       printf("max_np = %d, max_ne = %d, max_ns = %d\n", max_np, max_ne, max_ns);
 1550:  
 1551:       printf("elemsPtr = %p, elems = %p\n", *elems, elemsMem);
 1552:       
 1553:       sinh_theta_f = sinh(theta_f);
 1554: 
