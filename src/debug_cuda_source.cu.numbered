 6692:    __global__ void computeTurbulence(void) {
 6693: 
 6694:       NODE(node);
 6695: 
 6696:       // Calls the templated function to compute the turbulence model parameters.
 6697:       // turbulenceModel is just a class enum version of itur.
 6698:       computeTurbulenceModel<turbulenceModel>(node);
 6699:       
 6700:    }
