 1939: 
 1940: 
 1941: /**
 1942:  * Find the element that contains the target point.
 1943:  * 
 1944:  * @param x0,y0,z0     Starting position coordinates
 1945:  * @param xt,yt,zt     Target position coordinates
 1946:  * @param dtb          Time step for tracking
 1947:  * @param u_int        Initial velocity components
 1948:  * @param nextElem     Starting/resulting element index
 1949:  * 
 1950:  * @return Status code of type trackExitCodes
 1951:  * 
 1952:  * Uses the Leaded Celestial Walk algorithm to find the element that contains the target point.
 1953:  * This is a variant of the Celestial Walk algorithm that goes from element A containing the starting 
 1954:  * point x0 (in one side) to element B containing the target point xt. To enforce that the next element is
 1955:  * as close the the segment AB as possible, the next point at each iteration is computed
 1956:  * along segment AB, but just after the current element.
 1957:  */
 1958: 
 1959: 
 1960: __device__ __forceinline__ bool celestialWalk(Element *&curElem, Point3 x0, Point3 &xt, const Side *origSide, Side *&lastCrossSide, int jlev) {
 1961: 
 1962:    constexpr int MAX_ITERATIONS = 40;
 1963: 
 1964:    int iter = 0;
 1965:    double fac = 0.00001;
 1966:    while (iter < MAX_ITERATIONS) {
 1967:       iter++;
 1968: 
 1969:       Bool4 isLeft, isObtuse, isBisector;
 1970:       curElem->computePredicates(toPoint2(x0), toPoint2(xt), fac, origSide, isLeft, isObtuse, isBisector, jlev);
 1971: // showPoints(x0, xt, jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 1972:       Bool4 isValid = !isLeft & (!isObtuse | isBisector); // bitwise operation are overloaded
 1973: 
 1974: 
 1975:       if (isValid.none()) 
 1976:       // Inside the element if none of the edges is a valid continuation
 1977:       {
 1978:          // Just returns true and the element (curElem) is unchanged).
 1979:          // This means that the algorithm has found the element that contains the target point.
 1980:          return true;
 1981:       }
 1982:       else { // Outside the element
 1983: 
 1984:          // Outside this element. Pick the first valid exit side and cross.
 1985:          lastCrossSide = curElem->sides[isValid.firstOne()];
 1986:          Element *prevElem = curElem;
 1987:          curElem = lastCrossSide->otherElem(curElem);
 1988: 
 1989:          // If it crosses into a dry element or a boundary element, return false. This means that the track will now move 
 1990:          // along the boundary.
 1991:          if (curElem == nullptr || curElem->isDry) {
 1992:          
 1993:             curElem = prevElem;
 1994:             return false;
 1995:          }
 1996:          
 1997:       }
 1998: 
 1999:    }
 2000: 
 2001:   assert(false && "Leaded Celestial Walk: exceeded max iterations");
 2002: }
 2003: 
