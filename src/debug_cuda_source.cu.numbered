 1928:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 1929:                            if (idx_node_bnd >= mesh->nbp) return;
 1930: 
 1931: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1932:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 1933:                            if (idx_side_bnd >= mesh->nbs) return;                           
