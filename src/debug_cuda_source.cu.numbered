 8197: extern "C" __global__ void getElementVar(int varCode, bool is3D, double *var1, double *var2, int *ivar1, int *ivar2, int k = -1, int j = -1) {
 8198:    // Get the value of a variable from an element
 8199:    // varName is the name of the variable to get
 8200:    // var is the array to store the value
 8201:    // k is the vertical level index of the variable to get
 8202: 
 8203:    ELEM(elem);
 8204:    
 8205:    int idx = elem->idx;
 8206:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8207: 
 8208:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8209:    if      (varCode == (int)VarCode::w)       { var1[idx] = elem->w[k];}
 8210:    else if (varCode == (int)VarCode::z)       { var1[idx] = elem->z[k];}
 8211:    else if (varCode == (int)VarCode::x)       { var1[idx] = elem->center.x; var2[idx] = elem->center.x;}
 8212:    else if (varCode == (int)VarCode::area)    { var1[idx] = elem->area;}
 8213:    else if (varCode == (int)VarCode::depth)   { var1[idx] = elem->depth;}
 8214:    else if (varCode == (int)VarCode::radius)  { var1[idx] = elem->radius;}
 8215:    else if (varCode == (int)VarCode::lonlat)  { var1[idx] = elem->xlon;     var2[idx] = elem->ylat;}
 8216:    else if (varCode == (int)VarCode::ghat)    { var1[idx] = elem->ghat1.x;  var2[idx] = elem->ghat1.y;}
 8217:    else if (varCode == (int)VarCode::kb)      { ivar1[idx] = elem->kb;}
 8218:    else if (varCode == (int)VarCode::ssign && j > -1)  {ivar1[idx] = elem->ssign[j];}
 8219:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 8220:       
 8221:    
 8222: }
 8223: 
 8224: 
 8225: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 8226:    // Get the value of a variable from an node
 8227:    // varName is the name of the variable to get
 8228:    // var is the array to store the value
 8229:    // k is the vertical level index of the variable to get
 8230: 
 8231:    NODE(node);
 8232:    
 8233:    int idx = node->idx;
 8234:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8235: 
 8236:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8237:    
 8238:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 8239:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 8240:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 8241:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 8242:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 8243:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 8244:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;  
 8245:    else if (varCode == (int)VarCode::isdry && k == -1)  var[idx] = node->isDry?1.0:0.0;
 8246:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 8247:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 8248:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 8249:    
 8250:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 8251:       
 8252:    
 8253: }
 8254: 
 8255: 
 8256: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 8257:    // Get the value of a variable from an side
 8258:    // varName is the name of the variable to get
 8259:    // var is the array to store the value
 8260:    // k is the vertical level index of the variable to get
 8261:    SIDE(side);
 8262:    
 8263:    int idx = side->idx;
 8264:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8265: 
 8266:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 8267:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 8268:    // else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 8269:    else if (varCode == (int)VarCode::isdry && k == -1)   var[idx] = side->isDry?1.0:0.0;
 8270:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 8271:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 8272:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 8273:    // else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 8274:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 8275:    // else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 8276:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 8277:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 8278:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 8279:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 8280:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 8281:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 8282:    // else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 8283:    else if (varCode == (int)VarCode::bcc && k >= 0)     var[idx] = side->bcc[k].x;
 8284:    // else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 8285:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 8286:    // else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 8287:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 8288:    // else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 8289:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 8290:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 8291:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 8292:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 8293:    // else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 8294:    // else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 8295:    // else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 8296:    // else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 8297:    // else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 8298:    // else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 8299:    // else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 8300:    // else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 8301:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 8302: }
 8303: 
 8304: 
 8305: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8306:    // Get the value of a variable from an side
 8307:    // varName is the name of the variable to get
 8308:    // var is the array to store the value
 8309:    // k is the vertical level index of the variable to get
 8310:    SIDE_BND(sideBnd);   
 8311: 
 8312:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8313:    if (sideBnd->segment->isLand) idx = -7;
 8314: 
 8315:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8316:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8317: 
 8318: }
