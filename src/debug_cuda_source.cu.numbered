  495: 
  496: 
  497: struct Frame {
  498:    // Column 0 (East):  (-sin_lon, cos_lon, 0)              — store 2 values, t20=0 implicit
  499:    // Column 1 (North): Normalized oblate ellipsoid vector  — store 3 values
  500:    // Column 2 (Up):    cross(col0, col1)                   — recomputed on demand
  501:     double t00, t10;        // col0 (t20=0 implicit)
  502:     double t01, t11, t21;   // col1
  503: 
  504:    __device__ void update(double lat, double lon) { // XXX use lat, lon instead of ar1, ar2?
  505: 
  506:       assert(lat >= -pi/2.0 && lat <= pi/2.0 && "GRID: lat out of range");
  507:       assert(lon >= -pi     && lon <= pi     && "GRID: lon out of range");
  508: 
  509:       double sin_lon, cos_lon, sin_lat, cos_lat;
  510:       sincos(lon, &sin_lon, &cos_lon); // These functions are faster than sin(ar1) and cos(ar1).
  511:       sincos(lat, &sin_lat, &cos_lat);
  512: 
  513:       t00 = -sin_lon;
  514:       t10 =  cos_lon;
  515:       t01 = -cos_lon*sin_lat;
  516:       t11 = -sin_lon*sin_lat;
  517:       t21 = (rearth_pole/rearth_eq)*cos_lat;
  518: // printf("lat = %f, lon = %f, cos_lat = %f, sin_lat = %f, cos_lon = %f, sin_lon = %f\n", lat, lon, cos_lat, sin_lat, cos_lon, sin_lon);
  519: // printf("t00 = %f, t10 = %f, t01 = %f, t11 = %f, t21 = %f\n", t00, t10, t01, t11, t21);
  520: 
  521:       const double col1_norm = sqrt(t01*t01 + t11*t11 + t21*t21);
  522:       assert (col1_norm != 0.0 && "GRID: col1_norm=0");
  523: 
  524:       const double col1_norm_inv = 1.0/col1_norm;
  525:       t01 = t01*col1_norm_inv;
  526:       t11 = t11*col1_norm_inv;
  527:       t21 = t21*col1_norm_inv;
  528: 
  529:       // The 3rd column (col2) is the cross product of the first two and is computed when needed.
  530: 
  531: 
  532:    }
  533: 
  534:    __forceinline__ __device__ void print(void) const {
  535:       printf("frame = [%.16f, %.16f, %.16f, %.16f, %.16f]\n", t00, t10, t01, t11, t21);
  536:    }
  537: 
  538:    __forceinline__ __device__ void getCol2(double &t02, double &t12, double &t22) const {
  539:       // cross(col0, col1), with t20=0 implicitly:
  540:       // |  i       j       k   |
  541:       // | t00     t10      0   |
  542:       // | t01     t11     t21  |
  543:       t02 =  t10*t21;
  544:       t12 = -t00*t21;
  545:       t22 =  t00*t11 - t10*t01;
  546:    }
  547: 
  548: 
  549:    __forceinline__ __device__ Vector2 projHorVec(Vector2 const &vec0, Frame const &frameout) const {
  550:    // Transforms a horizontal vector from one frame to another and projects it to the new local horizontal plane.
  551:    // Inputs:
  552:    //        vec0: vel. in this frame;
  553:    //        frameout: Output frame;
  554:    // Output: 
  555:    //        vel. in new frame  
  556:    //
  557:    // Projects a horizontal vector from frame 1 (this) to frame 2 (frameout),
  558:    // discarding the z-component of the result to keep only the local horizontal
  559:    // plane of frame 2.
  560:    //
  561:    // Since F1 and F2 are global-to-local rotation matrices, transforming from
  562:    // frame 1 to frame 2 requires F2 * F1^{-1} = F2 * F1^T, as rotation matrices
  563:    // are orthogonal. This product is computed as dot products between columns of
  564:    // F1 and columns of F2, which is equivalent to multiplying rows of F1^T by
  565:    // columns of F2.// 
  566: 
  567:       auto const fo = frameout; // Just an alias for the output frame.
  568:       Vector2 res;
  569: 
  570:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  571:       // of t and fo.t are the same.
  572:       const double d00 = t00*fo.t00 + t10*fo.t10;
  573:       const double d10 = t01*fo.t00 + t11*fo.t10;
  574: 
  575:       const double d01 = t00*fo.t01 + t10*fo.t11;
  576:       const double d11 = t01*fo.t01 + t11*fo.t11 + t21*fo.t21;
  577: 
  578:       res.x = vec0.x * d00 + vec0.y * d10;
  579:       res.y = vec0.x * d01 + vec0.y * d11;
  580: 
  581:       return res;
  582:    }
  583: 
  584:    __forceinline__ __device__ Vector3 G2L(Vector3 const &vi) const {
  585:       Vector3 vo;
  586:       double t02, t12, t22;
  587: 
  588:       // Compute the 3rd column of the frame tensor
  589:       getCol2(t02, t12, t22);
  590: 
  591:       vo.x = vi.x*t00 + vi.y*t10;
  592:       vo.y = vi.x*t01 + vi.y*t11 + vi.z*t21;
  593:       vo.z = vi.x*t02 + vi.y*t12 + vi.z*t22;
  594: 
  595:       return vo;
  596:    
  597:    }
  598: 
  599:    __forceinline__ __device__ Vector3 L2G(Vector3 const &vi) const {
  600:       Vector3 vo;
  601:       double t02, t12, t22;
  602: 
  603:    // Compute the 3rd column of the frame tensor
  604:       getCol2(t02, t12, t22);
  605: 
  606:       // F * vi (non-transposed, so we use rows of F)
  607:       vo.x = vi.x*t00 + vi.y*t01 + vi.z*t02;
  608:       vo.y = vi.x*t10 + vi.y*t11 + vi.z*t12;
  609:       vo.z =            vi.y*t21 + vi.z*t22;  // t20=0 term dropped
  610: 
  611:       return vo;
  612:    }
  613: 
  614:    // Unit vectors that define the local frame
  615:    __forceinline__ __device__ Vector3 nUp(void) const {
  616:       // Column 2 = cross(column0, column1)
  617:       return { t10*t21, -t00*t21, t00*t11 - t10*t01 };
  618:    }
  619:    __forceinline__ __device__ Vector3 nZonal(void) const {
  620:       // Column 0
  621:       return { t00, t10, 0.0 };
  622:    }
  623:    __forceinline__ __device__ Vector3 nMeridional(void) const {
  624:       // Column 1
  625:       return { t01, t11, t21 };
  626:    }
  627: 
  628: };
