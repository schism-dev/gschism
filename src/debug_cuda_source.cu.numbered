 4443:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4444: 
 4445:       NODE_BND(nodeBnd);
 4446: 
 4447:       Node *node = nodeBnd->node;
 4448: 
 4449:       node->ETP = 0.0;
 4450: 
 4451:       for (int j=0; j<ntip; j++) {
 4452: 
 4453:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4454:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4455:    
 4456:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4457: 
 4458:          if constexpr(iloadtide==1) { // loading tide
 4459:             assert(false && "Loading tide not implemented");
 4460:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4461:          }
 4462:          
 4463:       }
 4464:       
 4465:    }
