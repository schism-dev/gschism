 1672: // Helper functions for computing the local node index at a given offset from another.
 1673: __device__ __inline__ int nxq(int offset, int index, int size) {
 1674:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1675:    // to the index to make it positive
 1676:    assert(index + offset + 16*size >= 0);
 1677:    return (index + offset + 16*size) % size;  
 1678: }
 1679: 
 1680: __device__ __inline__ int nxq(int index, int size) {
 1681:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1682:    // to the index to make it positive
 1683:    assert(index + 16*size >= 0);
 1684:    return (index + 16*size) % size; 
 1685: }
