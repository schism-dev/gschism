 1689:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1690:       // Compute the different time ramps used in the code 
 1691:       // This function is performed by just one thread
 1692: 
 1693:       rampbc = 1.0;
 1694:       if constexpr(ibc == 0) {
 1695:          if (drampbc > 0.0) {
 1696:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1697:          } else {
 1698:             rampbc = 1.0;
 1699:          }
 1700:       }
 1701: 
 1702:       if (nws != 0) {
 1703:          if (drampwind > 0.0) {
 1704:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1705:          } else {
 1706:             rampwind = 1.0;
 1707:          }
 1708:       }
 1709: 
 1710:       if (drampwafo > 0.0) {
 1711:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1712:       } else {
 1713:          rampwafo = 1.0;
 1714:       }
 1715: 
 1716:       // For source/sinks
 1717:       if (if_source && dramp_ss > 0.0) {
 1718:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1719:       } else {
 1720:          ramp_ss = 1.0;
 1721:       }
 1722: 
 1723:       if (dramp > 0.0) {
 1724:          ramp = tanh(2.0*time/86400.0/dramp);
 1725:       } else {
 1726:          ramp = 1.0;
 1727:       }
 1728: 
 1729: 
 1730:    }
