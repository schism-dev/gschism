 8402: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 8403:    Element *elems = mesh->localElemData;
 8404: 
 8405:    *addr = elems;
 8406:    *sizeElement = sizeof(Element);
 8407:    switch (varCode) {
 8408:       case (int)VarCode::z:
 8409:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 8410:          *sizeType = sizeof(double);
 8411:          break;
 8412:       case (int)VarCode::x:
 8413:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 8414:          *sizeType = sizeof(Vector2);
 8415:          break;
 8416:       case (int)VarCode::gradETP:
 8417:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
 8418:          *sizeType = sizeof(Vector2);
 8419:          break;
 8420:       case (int)VarCode::area:
 8421:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 8422:          *sizeType = sizeof(double);
 8423:          break;
 8424:       case (int)VarCode::depth:
 8425:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 8426:          *sizeType = sizeof(double);
 8427:          break;
 8428:       case (int)VarCode::radius:
 8429:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 8430:          *sizeType = sizeof(double);
 8431:          break;
 8432:       case (int)VarCode::ghat:
 8433:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 8434:          *sizeType = sizeof(Vector2);
 8435:          break;
 8436:       case (int)VarCode::kb:
 8437:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 8438:          *sizeType = sizeof(int);
 8439:          break;
 8440:       case (int)VarCode::isdry:
 8441:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 8442:          *sizeType = sizeof(int);
 8443:          break;            
 8444:       case (int)VarCode::w:
 8445:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 8446:          *sizeType = sizeof(double);
 8447:          break;
 8448:       case (int)VarCode::FaceIndices:
 8449:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 8450:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 8451:          *sizeType = sizeof(Node);
 8452:          break;
 8453:       default:
 8454:          *offset = -1;
 8455:    }
 8456: }
