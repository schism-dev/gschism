 2582: //       const double x4 = nodes[nxq(i+1)]->x;
 2583: //       const double y4 = nodes[nxq(i+1)]->y;
 2584: 
 2585: //       const Side& side = sides[i];
 2586: 
 2587: //       xIntersect=-1.e25;
 2588: //       yIntersect=-1.e25;
 2589: 
 2590: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 2591: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 2592: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 2593: 
 2594: //       if (delta != 0.0) {
 2595: //          // Solves the two linear equations for tt1 and tt2
 2596: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2597: //          const double tt2 = delta2/delta;
 2598: 
 2599: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 2600: //          // Similarly, we use tt2 to compute the intersection point.
 2601: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 2602: //             xIntersect = x3 + (x4 - x3)*tt2;
 2603: //             yIntersect = y3 + (y4 - y3)*tt2;
 2604: 
 2605: //             intersectingSide = side;
 2606: //             nextElement = nghbElems[i];
 2607: 
 2608: //             return true;
 2609: //          }
 2610:       
 2611: //       }
 2612: //       else {
 2613: //          // The two segments are parallel
 2614: //          return false;
 2615: //       }
