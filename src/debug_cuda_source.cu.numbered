 1978: //===============================================================================
 1979: 
 1980: 
 1981: /**
 1982:  * Find the element that contains the target point.
 1983:  * 
 1984:  * @param x0,y0,z0     Starting position coordinates
 1985:  * @param xt,yt,zt     Target position coordinates
 1986:  * @param dtb          Time step for tracking
 1987:  * @param u_int        Initial velocity components
 1988:  * @param nextElem     Starting/resulting element index
 1989:  * 
 1990:  * @return Status code of type trackExitCodes
 1991:  * 
 1992:  * Uses the Leaded Celestial Walk algorithm to find the element that contains the target point.
 1993:  * This is a variant of the Celestial Walk algorithm that goes from element A containing the starting 
 1994:  * point x0 (in one side) to element B containing the target point xt. To enforce that the next element is
 1995:  * as close the the segment AB as possible, the next point at each iteration is computed
 1996:  * along segment AB, but just after the current element.
 1997:  */
 1998: 
 1999: 
 2000: __device__ __forceinline__ bool celestialWalk(Element *&curElem, Point3 x0, Point3 &xt, const Side *origSide, Side *&lastCrossSide, int jlev) {
 2001: 
 2002:    constexpr int MAX_ITERATIONS = 40;
 2003: 
 2004:    int iter = 0;
 2005:    double fac = 0.00001;
 2006:    while (iter < MAX_ITERATIONS) {
 2007:       iter++;
 2008: 
 2009:       Bool4 isLeft, isObtuse, isBisector;
 2010:       curElem->computePredicates(toPoint2(x0), toPoint2(xt), fac, origSide, isLeft, isObtuse, isBisector, jlev);
 2011: // showPoints(x0, xt, jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2012:       Bool4 isValid = !isLeft & (!isObtuse | isBisector); // bitwise operation are overloaded
 2013: 
 2014: 
 2015:       if (isValid.none()) 
 2016:       // Inside the element if none of the edges is a valid continuation
 2017:       {
 2018:          // Just returns true and the element (curElem) is unchanged).
 2019:          // This means that the algorithm has found the element that contains the target point.
 2020:          return true;
 2021:       }
 2022:       else { // Outside the element
 2023: 
 2024:          // Outside this element. Pick the first valid exit side and cross.
 2025:          lastCrossSide = curElem->sides[isValid.firstOne()];
 2026:          Element *prevElem = curElem;
 2027:          curElem = lastCrossSide->otherElem(curElem);
 2028: 
 2029:          // If it crosses into a dry element or a boundary element, return false. This means that the track will now move 
 2030:          // along the boundary.
 2031:          if (curElem == nullptr || curElem->isDry) {
 2032:          
 2033:             curElem = prevElem;
 2034:             return false;
 2035:          }
 2036:          
 2037:       }
 2038: 
 2039:    }
 2040: 
 2041:   assert(false && "Leaded Celestial Walk: exceeded max iterations");
 2042: }
 2043: 
 2044: 
 2045: 
 2046: //===============================================================================
 2047: 
 2048: __device__ void lock(int *mutex) {
 2049:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 2050: }
 2051: 
 2052: __device__ void unlock(int *mutex) {
 2053:     atomicExch(mutex, 0);
 2054: }
 2055: 
 2056: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2057: // return;   
 2058:    // Lock the mutex
 2059:    lock(&debugPlotMutex);
 2060:  
 2061:    bool ok = true;
 2062:    if (debugPlotIdx == nullptr) ok = false;
 2063:    if (*debugPlotIdx >= 1000000) ok = false;
 2064:    if (ok) {
 2065:       debugPlot[(*debugPlotIdx) + 0*1000000] = x1.x;
 2066:       debugPlot[(*debugPlotIdx) + 1*1000000] = x1.y;
 2067:       debugPlot[(*debugPlotIdx) + 2*1000000] = x2.x;
 2068:       debugPlot[(*debugPlotIdx) + 3*1000000] = x2.y;
 2069:       debugPlot[(*debugPlotIdx) + 4*1000000] = (double)color;
 2070:       debugPlot[(*debugPlotIdx) + 5*1000000] = (double)(((int)(unsigned char)marker & 0xFF) | ((dashLen & 0xFF) << 8) | ((width & 0xFF) << 16));
 2071:       debugPlot[(*debugPlotIdx) + 6*1000000] = (double)label;
 2072:       (*debugPlotIdx)++;
 2073:    }
 2074: 
 2075:    __threadfence();               // ensure all above writes are visible
 2076:    // Unlock the mutex
 2077:    unlock(&debugPlotMutex);
 2078: 
 2079: }
 2080: 
 2081: __device__ void addDebugPlot(Vector2 x1, Vector2 x2, unsigned int color = 0xA0A0A0, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2082:    addDebugPlot(toPoint3(x1, 0.0), toPoint3(x2, 0.0), color, marker, width, dashLen, label);
 2083: }
