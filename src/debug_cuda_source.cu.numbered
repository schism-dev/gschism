  204: using Vector2 = double2; 
  205: using Vector3 = double3;
  206: using Point2  = double2;
  207: using Point3  = double3;
  208: 
  209: __device__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
  210:     return make_double2(a.x + b.x, a.y + b.y);
  211: }
  212: using Vector2 = double2; 
  213: using Vector3 = double3;
  214: __device__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
  215:     a.x += b.x;
  216:     a.y += b.y;
  217:     return a;
  218: }
  219: 
  220: __device__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
  221:     return make_double2(a.x - b.x, a.y - b.y);
  222: }
  223: 
  224: __device__ __forceinline__ double2 operator-=(double2& a, const double2& b) {
  225:     a.x -= b.x;
  226:     a.y -= b.y;
  227:     return a;
  228: }
  229: 
  230: __device__ __forceinline__ double2 operator*(const double2& v, const double s) {
  231:     return make_double2(v.x * s, v.y * s);
  232: }
  233: 
  234: __device__ __forceinline__ double2 operator*(const double s, const double2& v) {
  235:     return v * s;  // reuse the previous operator
  236: }
  237: 
  238: __device__ __forceinline__ double2 operator/(const double2& v, double s) {
  239:     return make_double2(v.x / s, v.y / s);
  240: }
  241: 
  242: __device__ __forceinline__ double norm2(const double2& v) {
  243:     return v.x*v.x + v.y*v.y;
  244: }
  245: 
  246: __device__ __forceinline__ double length(const double2& v) {
  247:     return sqrt(v.x*v.x + v.y*v.y);
  248: }
  249: 
  250: __device__ __forceinline__ double2 normalize(const double2& v) {
  251:     return v / length(v);
  252: }
  253: 
  254: __device__ __forceinline__ double dot(const double2& v, const double2& w) {
  255:     return v.x*w.x + v.y*w.y;
  256: }
  257: 
  258: __device__ __forceinline__ double cross(const double2& v, const double2& w) {
  259:     return v.x*w.y - v.y*w.x;
  260: }
  261: 
  262: __device__ __forceinline__ double2 rot90(const double2& a) {
  263:     return make_double2(a.y, -a.x);
  264: }
  265: 
  266: __device__ __forceinline__ double3 operator+(const double3& a, const double3& b) {
  267:     return make_double3(a.x + b.x, a.y + b.y, a.z + b.z);
  268: }
  269: 
  270: __device__ __forceinline__ double3 operator+=(double3& a, const double3& b) {
  271:     a.x += b.x;
  272:     a.y += b.y;
  273:     a.z += b.z;
  274:     return a;
  275: }
  276: 
  277: __device__ __forceinline__ double3 operator-(const double3& a, const double3& b) {
  278:     return make_double3(a.x - b.x, a.y - b.y, a.z - b.z);
  279: }
  280: 
  281: __device__ __forceinline__ double3 operator*(const double3& v, double s) {
  282:     return make_double3(v.x * s, v.y * s, v.z * s);
  283: }
  284: 
  285: __device__ __forceinline__ double3 operator*(double s, const double3& v) {
  286:     return v * s;
  287: }
  288: 
  289: __device__ __forceinline__ double3 operator/(const double3& v, double s) {
  290:     return make_double3(v.x / s, v.y / s, v.z / s);
  291: }
  292: 
  293: __device__ __forceinline__ double dot(const double3& v, const double3& w) {
  294:     return v.x*w.x + v.y*w.y + v.z*w.z;
  295: }
  296: 
  297: __device__ __forceinline__ double norm2(const double3& v) {
  298:     return v.x*v.x + v.y*v.y + v.z*v.z;
  299: }
  300: 
  301: __device__ __forceinline__ Vector2 toVector2(const double3& v) {
  302:     return make_double2(v.x, v.y);
  303: }
  304: 
  305: __device__ __forceinline__ double3 toVector3(const double2& v, double w) {
