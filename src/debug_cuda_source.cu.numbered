 2501:    template<typename T>
 2502:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 2503:       // Get the values of the field at the nodes of the element
 2504:       res[0] = nodes[0]->*field;
 2505:       res[1] = nodes[1]->*field;
 2506:       res[2] = nodes[2]->*field;
 2507:       if (isQuad()) res[3] = nodes[3]->*field;
 2508:       else          res[3] = T();
 2509:    }
 2510: 
 2511:    template<typename T>
 2512:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 2513: 
 2514:       assert(level < nvrt && "Level is out of range");
 2515:       // Get the values of the field at the nodes of the element
 2516:       res[0] = (nodes[0]->*field)[max(level, nodes[0]->kb)];
 2517:       res[1] = (nodes[1]->*field)[max(level, nodes[1]->kb)];
 2518:       res[2] = (nodes[2]->*field)[max(level, nodes[2]->kb)];
 2519:       if (isQuad()) res[3] = (nodes[3]->*field)[max(level, nodes[3]->kb)];
 2520:       else          res[3] = T();
 2521:    }    
 2522: 
 2523:    template<typename T>
 2524:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
 2525: 
 2526:       assert(level < nvrt && "Level is out of range");
 2527: 
 2528:       // Get the values of the func at the nodes of the element
 2529:       res[0] = (nodes[0]->*func)(max(level, nodes[0]->kb));
 2530:       res[1] = (nodes[1]->*func)(max(level, nodes[1]->kb));
 2531:       res[2] = (nodes[2]->*func)(max(level, nodes[2]->kb));
 2532:       if (isQuad()) res[3] = (nodes[3]->*func)(max(level, nodes[3]->kb));
 2533:       else          res[3] = T();  // This is 0.0 or a zero vector
 2534: 
 2535:    }      
 2536: 
 2537:    template<typename T>
 2538:    __device__ __forceinline__ void Element::getSideValues(T Side::* field, T res[4]) const {
 2539:       // Get the values of the field at the nodes of the element
 2540:       res[0] = sides[0]->*field;
 2541:       res[1] = sides[1]->*field;
 2542:       res[2] = sides[2]->*field;
 2543:       if (isQuad()) res[3] = sides[3]->*field;
 2544:       else          res[3] = T();
 2545:    }
 2546: 
 2547:    template<typename T>
 2548:    __device__ __forceinline__ void Element::getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
 2549: 
 2550:       assert(level < nvrt && "Level is out of range");
 2551: 
 2552:       // Get the values of the field at the nodes of the element
 2553:       res[0] = (sides[0]->*field)[max(level, sides[0]->kb)];
 2554:       res[1] = (sides[1]->*field)[max(level, sides[1]->kb)];
 2555:       res[2] = (sides[2]->*field)[max(level, sides[2]->kb)];
 2556:       if (isQuad()) res[3] = (sides[3]->*field)[max(level, sides[3]->kb)];
 2557:       else          res[3] = T();
 2558:    }    
 2559: 
 2560:    template<typename T>
 2561:    __device__ __forceinline__ void Element::getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
 2562: 
 2563:       assert(level < nvrt && "Level is out of range");
 2564: 
 2565:       // Get the values of the func at the nodes of the element
 2566:       res[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2567:       res[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2568:       res[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2569:       if (isQuad()) res[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2570:       else          res[3] = T();  // This is 0.0 or a zero vector
 2571: 
 2572:    }      
