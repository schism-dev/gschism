  463: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  464:    x3 = y1*z2 - y2*z1;
  465:    y3 = x2*z1 - x1*z2;
  466:    z3 = x1*y2 - x2*y1;
  467: // XXXXXX IS THIS REPEATED????
  468: }
