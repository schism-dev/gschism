 2555: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2556: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2557: __inline__ __device__ double  Side::lon(void) const { return 0.5*(n1->lon + n2->lon); }
 2558: __inline__ __device__ double  Side::lat(void) const { return 0.5*(n1->lat + n2->lat); }
 2559: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2560: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2561:    Vector2 grad = {0.0, 0.0};
 2562:    int count = 0;
 2563: 
 2564:    if constexpr(ics == 2) assert(false && "grad2: ics = 2 not implemented");
 2565: 
 2566:    // First element
 2567:    if (elems[0] != nullptr && condition(elems[0])) {
 2568:       grad += elems[0]->grad2(field);
 2569:       count++;
 2570:    }
 2571: 
 2572:    // Second element
 2573:    if (elems[1] != nullptr && condition(elems[1])) {
 2574:       grad += elems[1]->grad2(field);
 2575:       count++;
 2576:    }
 2577: 
 2578:    if (count > 0) {
 2579:       grad = grad/count;
 2580:    }
 2581:    
 2582:    return grad;
 2583: }
