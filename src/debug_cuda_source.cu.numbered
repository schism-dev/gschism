 6266: //                   if(isbs(jsj)<=0.or.k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)>=0.d0) then
 6267: //                     !For outflow open bnd side, estimate mass in (open
 6268: //                     !side cannot be interface side)
 6269: //                     if(max_iadjust_mass_consv>0.and.isbs(jsj)>0) then !outflow @open bnd
 6270: //                       h_mass_in(:)=h_mass_in(:)-trel_tmp(1:ntr,k,i)*flux_adv_hface(k,jsj)*dtb
 6271: //                     endif
 6272: 
 6273: //                     cycle
 6274: //                   endif
 6275: 
 6276: //                   !Open bnd side with inflow (must be wet elem) or k<kbs(jsj)+1
 6277: //                   iweno=.false.  !reset to upwind
 6278: //                   ibnd=isbs(jsj) !global bnd #
 6279: //                   !Find node indices on bnd segment for the 2 nodes (for type 4 b.c.)
 6280: //                   nwild(1:2)=0
 6281: //                   do ll=1,2 !nodes
