  187: using Vector2 = double2; 
  188: using Vector3 = double3;
  189: using Point2  = double2;
  190: using Point3  = double3;
  191: 
  192: __device__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
  193:     return make_double2(a.x + b.x, a.y + b.y);
  194: }
  195: using Vector2 = double2; 
  196: using Vector3 = double3;
  197: __device__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
  198:     a.x += b.x;
  199:     a.y += b.y;
  200:     return a;
  201: }
  202: 
  203: __device__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
  204:     return make_double2(a.x - b.x, a.y - b.y);
  205: }
  206: 
  207: __device__ __forceinline__ double2 operator-=(double2& a, const double2& b) {
  208:     a.x -= b.x;
  209:     a.y -= b.y;
  210:     return a;
  211: }
  212: 
  213: __device__ __forceinline__ double2 operator*(const double2& v, const double s) {
  214:     return make_double2(v.x * s, v.y * s);
  215: }
  216: 
  217: __device__ __forceinline__ double2 operator*(const double s, const double2& v) {
  218:     return v * s;  // reuse the previous operator
  219: }
  220: 
  221: __device__ __forceinline__ double2 operator/(const double2& v, double s) {
  222:     return make_double2(v.x / s, v.y / s);
  223: }
  224: 
  225: __device__ __forceinline__ double norm2(const double2& v) {
  226:     return v.x*v.x + v.y*v.y;
  227: }
  228: 
  229: __device__ __forceinline__ double length(const double2& v) {
  230:     return sqrt(v.x*v.x + v.y*v.y);
  231: }
  232: 
  233: __device__ __forceinline__ double2 normalize(const double2& v) {
  234:     return v / length(v);
  235: }
  236: 
  237: __device__ __forceinline__ double dot(const double2& v, const double2& w) {
  238:     return v.x*w.x + v.y*w.y;
  239: }
  240: 
  241: __device__ __forceinline__ double cross(const double2& v, const double2& w) {
  242:     return v.x*w.y - v.y*w.x;
  243: }
  244: 
  245: __device__ __forceinline__ double2 rot90(const double2& a) {
  246:     return make_double2(a.y, -a.x);
  247: }
  248: 
  249: __device__ __forceinline__ double3 operator+(const double3& a, const double3& b) {
  250:     return make_double3(a.x + b.x, a.y + b.y, a.z + b.z);
  251: }
  252: 
  253: __device__ __forceinline__ double3 operator+=(double3& a, const double3& b) {
  254:     a.x += b.x;
  255:     a.y += b.y;
  256:     a.z += b.z;
  257:     return a;
  258: }
  259: 
  260: __device__ __forceinline__ double3 operator-(const double3& a, const double3& b) {
  261:     return make_double3(a.x - b.x, a.y - b.y, a.z - b.z);
