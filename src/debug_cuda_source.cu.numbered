 7841: //                 !if(k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)<0) then !inflow
 7842: //                 !  do jj=1,ntr
 7843: //                 !    adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*abs(flux_adv_hface(k,jsj))*(trel_tmp_outside(jj)-trel_tmp(jj,k,i))
 7844: //                 !  enddo
 7845: //                 !endif
 7846: //                 !!weno correction
 7847: //                 !if (iweno) then
 7848: //                 !  if(k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)<0) then !inflow
 7849: //                 !    do jj=1,ntr
 7850: //                 !      adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*abs(flux_adv_hface(k,jsj))*(trsd_tmp(jj,k,jsj)-trel_tmp_outside(jj))
 7851: //                 !    enddo
 7852: //                 !  else if(k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)>=0) then !outflow
 7853: //                 !    do jj=1,ntr
 7854: //                 !      adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*abs(flux_adv_hface(k,jsj))*(trel_tmp(jj,k,i)-trsd_tmp(jj,k,jsj) )
 7855: //                 !    enddo
 7856: //                 !  endif !inflow or outflow
 7857: //                 !endif !if use weno
 7858: 
 7859: //                 !alternative formulation
 7860: //                 if (k>=kbs(jsj)+1) then
 7861: //                   if (iweno) then !weno
 7862: //                     do jj=1,ntr
 7863: //                       tmp=rk_coef(itd_weno)*dtb_by_bigv*( ssign(j,i)*(flux_adv_hface(k,jsj))*(trel_tmp(jj,k,i)-trsd_tmp(jj,k,jsj)) )
 7864: //                       adv_tr(jj)=adv_tr(jj)+tmp
 7865: //                       if (adv_tr(jj)<tr_min_max(1,jj) .or. adv_tr(jj)>tr_min_max(2,jj) ) then !reset to upwind
 7866: //                         adv_tr(jj)=adv_tr(jj)-tmp !reset to previous value
 7867: //                         if(ssign(j,i)*flux_adv_hface(k,jsj)<0.d0) then  !inflow 
 7868: //                           adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*abs(flux_adv_hface(k,jsj))*(trel_tmp_outside(jj)-trel_tmp(jj,k,i))
 7869: //                         endif
 7870: //                       endif
 7871: //                       !when ntd_weno=1, reduces to: adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*( ssign(j,i)*(flux_adv_hface(k,jsj))*(trel_tmp(jj,k,i)-trsd_tmp(jj,k,jsj)) )
 7872: //                     enddo
 7873: //                   else !upwind
 7874: //                     if(ssign(j,i)*flux_adv_hface(k,jsj)<0) then  !inflow 
 7875: //                       do jj=1,ntr
 7876: //                         adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*abs(flux_adv_hface(k,jsj))*(trel_tmp_outside(jj)-trel_tmp(jj,k,i))
 7877: //                       enddo
 7878: //                     endif
 7879: //                   endif !weno or upwind
