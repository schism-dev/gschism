 1448: struct Side {
 1449: 
 1450:    // Geometry information
 1451:    int idx;               // Index of the side
 1452:    Node *n1, *n2;
 1453:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
 1454: 
 1455:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
 1456:    Vector2 center;        // Location of side center. 
 1457:    double zc[nvrt];       // Side center z-coord at each vertical level
 1458: 
 1459:    Frame<ics> frame;
 1460:    
 1461:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
 1462:                           // this is nullptr
 1463:    
 1464:    int16_t kb;            // Bottom index of the side
 1465:    bool isDry;            // True if the side is dry
 1466:  
 1467:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1468: 
 1469:    // Physical information
 1470:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1471:    Vector2 btu[nvrt];           // Back-tracked velocity
 1472:    Vector2 U;                   // Vertically averaged velocity vector  
 1473: 
 1474:    Vector2 nuGradU[nvrt];          // nu*grad u
 1475: 
 1476:    Vector2 bcc[nvrt];           // Baroclinic term
 1477:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1478: 
 1479:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1480:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1481:    Vector2 gradPr;               // Gradient of pressure
 1482:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1483: 
 1484: 
 1485:    double hhat;                 // \breve{H} in notes
 1486: 
 1487:    double shapiro;
 1488: 
 1489:    double coriolis;             // Coriolis parameter
 1490: 
 1491:    // Vegetation parameters
 1492:    double veg_c2;
 1493:    double veg_beta;
 1494: 
 1495:    // Bottom drag parameters.
 1496:    double chi;
 1497:    double chi2;
 1498: 
 1499:    // Transport model
 1500:    TransportSide<transportModel> transport; // Transport model 
 1501: 
 1502:    __inline__ __device__ Point2 outputCoords(void) const;
 1503: 
 1504:    __inline__ __device__ double x(double t) const;
 1505:    __inline__ __device__ double y(double t) const;
 1506:    __inline__ __device__ double z(double t) const;
 1507:    __inline__ __device__ double lon(void) const;
 1508:    __inline__ __device__ double lat(void) const;
 1509:    __inline__ __device__ Point2 p2_t(double t) const;
 1510: 
 1511:    __device__ void setFrame(void) {
 1512:       if constexpr(ics == 1) return;
 1513: 
 1514:       double lat, lon;
 1515:       const Point3 p = toPoint3(center, centerZ());
 1516: 
 1517:       // Compute the latitude and longitude of the element center
 1518:       computeLatLon(p, lat, lon);
 1519: 
 1520:       frame.update(lat, lon);        
 1521:    }
 1522:    
 1523: 
 1524:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1525:    // If ics == 2, convert the global point to the local frame of the side
 1526:       
 1527:       if constexpr (ics == 1) {
 1528:          return p;
 1529:       } else {
 1530:          const Point3 c = {center.x, center.y, centerZ()};
 1531:          const Point3 local = frame.G2L(p - c);
 1532:          return local;
 1533:       }
 1534:    }
 1535: 
 1536:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1537:       if constexpr (ics == 1) {
 1538:          return p;
 1539:       } else {
 1540:          const Point3 c = {center.x, center.y, centerZ()};
 1541:          return c + frame.L2G(p);
 1542:       }
 1543:    }
 1544: 
 1545: 
 1546:    __device__ __forceinline__ Vector2 projectToLocalFrame(Vector2 const& v, Frame<ics> const& v_frame) const {
 1547:       if constexpr(ics == 1) return v;
 1548:       else return v_frame.projHorVec(v, frame);
 1549:    }
 1550: 
 1551:    __inline__ __device__ double centerZ(void)      const;
 1552:    __inline__ __device__ Point3 center3D(int k)    const { assert(false); assert(k < nvrt); return {center.x, center.y, zc[k]}; }  // USED??? CONSISTENT?? XXXXX
 1553:    __inline__ __device__ double Dz(int k)          const { assert(k < nvrt && k > 0); return zc[k] - zc[k - 1]; }
 1554:    __inline__ __device__ double area(int k)        const { assert(k < nvrt && k > 0); return len*Dz(k + 1); }
 1555:    __inline__ __device__ double areaClamped(int k) const { assert(k < nvrt && k > 0); return len*(zc[max(k + 1, kb)] - zc[max(k, kb)]); }
 1556: 
 1557:    __inline__ __device__ Side* neigh(int index) const { 
 1558:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1559:       assert(index >= 0 && index < 4); 
 1560:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1561: 
 1562:       const int ielem = index & 1;           // 0 or 1
 1563:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1564: 
 1565:       const Element* elem = elems[ielem];
 1566: 
 1567:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1568: 
 1569:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1570: 
 1571:    }
 1572: 
 1573:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1574: 
 1575:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1576: 
 1577:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1578:    __inline__ __device__ bool isOpenBnd(void) const { return isBnd() && sideBnd->segment->ifltype == 0; } // True if the side is an open boundary side
 1579:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1580:    __inline__ __device__ int iadv(void) const;
 1581: 
 1582:    __inline__ __device__ double grav3(void) const;
 1583:    
 1584:    __inline__ __device__ double eta2(void) const;
 1585:    __inline__ __device__ double eta1(void) const;
 1586:    __inline__ __device__ double w2(int k) const;
 1587:    __inline__ __device__ Vector2 u2Bottom(int dummy = 0) const { return u2[kb]; }  // XXXX dummy argument to satisfy the template in mean()
 1588:    __inline__ __device__ double depth(void) const;
 1589:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1590:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1591: 
 1592:    __inline__ __device__ double dfv(int k) const;
 1593: 
 1594:    __inline__ __device__ double veg_h(void)  const;
 1595:    __inline__ __device__ double veg_nv(void) const;
 1596:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1597:    __inline__ __device__ double veg_alpha3D(int k) const;
 1598:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1599: 
 1600:    __inline__ __device__ double Cd(void) const;
 1601: 
 1602:    __inline__ __device__ Vector2 tau(void) const;
 1603: 
 1604:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1605:    
 1606: 
 1607:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1608:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1609:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1610:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1611:    } 
 1612:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1613:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1614:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1615:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1616: 
 1617:    // Get valid starting element (for backtracking)
 1618:    __inline__ __device__ Element* getStartElement() {
 1619:       return elems[0] ? elems[0] : elems[1];
 1620:    }
 1621: 
 1622:    
 1623:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1624:       // Given an element, returns the other element that shares this side
 1625:       return (elems[0] == elem) ? elems[1] : elems[0];
 1626:    }
 1627: 
 1628:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1629:       // Given a node, returns the other node that shares this side
 1630:       return (n1 == node) ? n2 : n1;
 1631:    }
 1632:  
 1633:    __inline__ __device__ void btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1634: 
 1635: 
 1636: 
 1637: 
 1638: };
 1639: 
 1640: 
 1641: // This struct is used to store the boundary information for a node.
 1642: struct NodeBoundary {   
 1643:    int idx;
 1644:    BoundarySegment *segment;
 1645:    Node *node;
 1646:    
 1647:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1648:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1649: 
 1650:    bool isLand;
 1651: 
 1652:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1653:    double elbc;   // Elevation boundary condition
 1654:    double eth;    // Elevation time history
 1655: 
 1656:    double eta_mean; // Mean elevation at nodes
 1657: 
 1658:    bool isEssentialBC;
 1659: 
 1660:    Vector2 uth[nvrt];  // "Time history" velocity
 1661: 
 1662:    // Arrays for harmonic constituents (if needed)
 1663:    // nbfr ? nbfr : 1 is there to avoid a 0-sized array.
 1664:    double  emo[nbfr ? nbfr : 1];  // Elevation amplitude
 1665:    double  efa[nbfr ? nbfr : 1];  // Elevation phase
 1666: 
 1667: 
 1668:    NodeBoundary(void) {
 1669:       isLand = false;
 1670:    }
 1671:    NodeBoundary(bool _isLand) {
 1672:       isLand = _isLand;
 1673:    }
 1674: 
 1675:    
 1676:    __forceinline__ __device__ int numSidesForAverage() const {
 1677:    // Returns the number of sides that are connected to the node and have the same segment.
 1678:    // This is used to compute the average velocity at the node for open boundary nodes.
 1679:       int res = 0;
 1680:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1681:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1682: 
 1683:       return res;
 1684:    }
 1685: 
 1686: 
 1687:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1688:       assert(index == 0 || index == 1); 
 1689:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1690:    }
 1691: 
 1692:    __forceinline__ __device__ void linkSideBoundary(SideBoundary *sb) {
 1693:       if (isLand) return;  // land never uses these links
 1694: 
 1695:       SideBoundary *nullSideBoundary = nullptr;
 1696:       uintptr_t null = (uintptr_t)nullSideBoundary;
 1697: 
 1698:       if (atomicCAS((uintptr_t *)&sideBnd1, null, (uintptr_t)sb) == null) return;
 1699:       if (atomicCAS((uintptr_t *)&sideBnd2, null, (uintptr_t)sb) == null) return;
 1700: 
 1701:       // both slots taken. OK if this side was already linked
 1702:       assert(sideBnd1 == sb || sideBnd2 == sb);
 1703:    }
 1704: 
 1705: 
 1706: };
 1707: 
 1708: struct Node {
 1709: 
 1710:    // Geometry information
 1711:    int idx;            // Global index of the node
 1712:    int16_t part;       // Partition of the node
 1713: 
 1714:    Node **nodes;       // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1715:    int16_t numNodes;   // Number of nodes neighbors of this node
 1716: 
 1717:    Element **elements; // Array of pointers to the elements that share this node
 1718:    int16_t numElements;// Number of elements that share this node
 1719: 
 1720:    int16_t numSides;   // Number of sides that are connected to this node
 1721: 
 1722: 
 1723:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1724:    double gz;          // Global vertical coordinate at the node.
 1725:    Vector2 u2[nvrt];
 1726:    double  w2[nvrt];
 1727:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1728:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1729:    double lon, lat;
 1730:    double depth;
 1731: 
 1732:    Frame<ics> frame;
 1733: 
 1734:    LocalSigma<ivcor> localSigma;  
 1735: 
 1736:    int16_t kb;     // Bottom index of the node
 1737: 
 1738:    bool isDry;     // True if the node is dry
 1739: 
 1740:    int16_t iadv;   // Advection flag
 1741: 
 1742:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1743:                           // this is nullptr
 1744: 
 1745:    TempVar tmp; // Temporary variable to store different types of variables
 1746: 
 1747:    // Physical information
 1748:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1749:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1750: 
 1751:    double rho[nvrt];     // Density
 1752:    double dfv[nvrt];     // Vertical viscosity
 1753:    double dfh[nvrt];     // Horizontal viscosity  XXXX (does it need to exist when transport is not enabled?)
 1754: 
 1755:    Turbulence<turbulenceModel> turb;
 1756: 
 1757:    double eta1; // Elevation at nodes at previous timestep
 1758:    double eta2; // Elevation at nodes at current timestep
 1759: 
 1760:    double ETP;  // Earth Tidal Potential
 1761: 
 1762:    double pr;    // Air pressure
 1763:    double grav2; // Gravity 
 1764:    
 1765:    Vector2 dav;  // Depth averaged velocity
 1766: 
 1767:    Vector2 tau; // Wind stress vector
 1768: 
 1769:    // Vegetation parameters
 1770:    double veg_h;
 1771:    double veg_nv;
 1772:    double veg_di;
 1773:    double veg_Cd;
 1774:    double veg_h_unbent;
 1775:    double veg_di_unbent;
 1776:    double veg_nv_unbent;
 1777:    double veg_alpha_vert_mean;
 1778:    double veg_alpha0;
 1779:    double veg_alpha3D[nvrt];
 1780: 
 1781:    // Bottom drag parameters
 1782:    double Cd;       // Bottom drag coefficient   
 1783: 
 1784:    // These three are mutually exclusive
 1785:    union {
 1786:       double rmanning; // Bottom Manning's coefficient
 1787:       double rough;    // Bottom roughness length
 1788:       double drag;     // Bottom drag coefficient
 1789:    };
 1790:    Vector2 tau_bot; // Bottom stress vector
 1791: 
 1792:    // XXXX REMOVE FOR IMM>0???
 1793:    double bdef1 = 0.0; // Bottom deformation at previous timestep
 1794:    double bdef2 = 0.0; // Bottom deformation at current timestep
 1795: 
 1796:    
 1797:    double qel; // RHS
 1798:    double *coeffDiag;    // Pointer to the diagonal coefficient of the matrix
 1799:    double *coeffRow;     // Pointer to the coefficients of the row of the CRS matrix for this node.
 1800:    int16_t *csrSlot;     // csrSlot[i], is the slot/index of nodes[i] entry the CRS matrix row for this node.
 1801:                          // The index of the diagonal element is coeffDiag - coeffRow.   
 1802: 
 1803:    double mX; // Solution of the FEM system
 1804: 
 1805:    // Meteorological forcing
 1806:    Vector2 u_air;
 1807:    double p_air;  // XXXX is this the same as pr?
 1808:    double t_air;
 1809:    double q_air;
 1810:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1811: 
 1812: 
 1813: 
 1814:    __device__ __forceinline__ int localIndex() const;
 1815:    __device__ __forceinline__ int packedIndex() const;
 1816: 
 1817: 
 1818:    __device__ void setWind(Vector2 &u) {
 1819:    // Sets the wind vector taking into account the mesh angle
 1820:    
 1821:       const double speed = length(u);
 1822: 
 1823:       // Rotate wind vector to the node frame
 1824:       u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1825: 
 1826:       // Sets the surface stress vector due to wind.
 1827:       if constexpr(nws == 0) {
 1828:          tau = {0.0, 0.0};
 1829: 
 1830:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1831:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1832: 
 1833:       } else {
 1834: 
 1835:          double dragcoef;
 1836: 
 1837:          if constexpr(iwind_form == -1) {
 1838:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1839:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1840: 
 1841:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1842:             tau = cff*u_air;
 1843:  
 1844:          } else if constexpr(iwind_form == 1) {
 1845:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1846:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1847: 
 1848:             dragcoef = max(dragcoef, 4.0e-4);
 1849:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1850:             tau = cff*u_air;
 1851: 
 1852:          } else {
 1853:             tau = {0.0, 0.0};
 1854:          }
 1855:       }
 1856:    }
 1857: 
 1858: 
 1859:    __device__ void setFrame(double lat, double lon) {
 1860:       if constexpr(ics == 1) return;
 1861: 
 1862:       frame.update(lat, lon);        
 1863:     }
 1864: 
 1865:    //__device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1866: 
 1867:    __device__ double sigmaTransitionDepth(void) const;
 1868: 
 1869:    __device__ double computeETP(int idxTidalPotential, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const;
 1870: 
 1871:    __inline__ __device__ Point2 outputCoords(void) const {
 1872:       if constexpr(ics == 1)  return p;
 1873:       else                    return {rad2deg*lon, rad2deg*lat};
 1874:    }
 1875: 
 1876:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1877:    // If ics == 2, convert the global point to the local frame
 1878:       
 1879:       if constexpr (ics == 1) {
 1880:          return p;
 1881:       } else {
 1882:          const Point3 c = {p.x, p.y, gz};
 1883:          const Point3 local = frame.G2L(p - c);
 1884:          return local;
 1885:       }
 1886:    }
 1887: 
 1888:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1889:    // If ics == 2, convert the global point to the local frame
 1890:       
 1891:       if constexpr (ics == 1) {
 1892:          return p;
 1893:       } else {
 1894:          const Point3 c = {p.x, p.y, gz};
 1895:          return c + frame.L2G(p);
 1896:       }
 1897:    }
 1898: 
 1899:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1900:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1901:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1902:    
 1903:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1904: 
 1905:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1906:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1907:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }   
 1908: 
 1909:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1910:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1911: 
 1912:    __device__ __forceinline__ void clearMatrixRow(void) {
 1913:       // Clear the matrix row for this node
 1914: 
 1915:       for (int i = 0; i <= numNodes; i++) coeffRow[i] = 0.0;
 1916: 
 1917:    }
 1918: 
 1919:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1920:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1921:       
 1922:       if (node == this) {
 1923:          *coeffDiag += value;
 1924:          return;
 1925:       }
 1926: 
 1927:       int i;
 1928:       for (i = 0; i < numNodes; i++) {
 1929:          if (nodes[i] == node) break;
 1930:       }
 1931: 
 1932:       assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1933:       coeffRow[csrSlot[i]] += value;
 1934:    }
 1935: 
 1936: 
 1937:    __device__ __inline__ void updateZCoordData(void);
 1938: 
 1939:    __device__ __forceinline__ double compZCoord(int k) const;
 1940: 
 1941:    __device__ void updateKb(void);
 1942: 
 1943:    __device__ __forceinline__ void computeBottomDragCd(void);
 1944: 
 1945: 
 1946: 
 1947: };
