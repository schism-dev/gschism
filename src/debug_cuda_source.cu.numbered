 8817: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8818:    // Get the value of a variable from an side
 8819:    // varName is the name of the variable to get
 8820:    // var is the array to store the value
 8821:    // k is the vertical level index of the variable to get
 8822:    SIDE_BND(sideBnd);   
 8823: 
 8824:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8825:    if (sideBnd->segment->isLand) idx = -7;
 8826: 
 8827:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8828:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8829: 
 8830: }
