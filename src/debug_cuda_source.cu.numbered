  265: 
  266: __device__ __forceinline__ double3 operator/(const double3& v, double s) {
  267:     return make_double3(v.x / s, v.y / s, v.z / s);
  268: }
  269: 
  270: __device__ __forceinline__ double dot(const double3& v, const double3& w) {
  271:     return v.x*w.x + v.y*w.y + v.z*w.z;
  272: }
  273: 
  274: __device__ __forceinline__ double norm2(const double3& v) {
  275:     return v.x*v.x + v.y*v.y + v.z*v.z;
