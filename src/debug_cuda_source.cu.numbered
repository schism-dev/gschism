 7162: __global__ void returnMatrix(double *res) {
 7163:    // Debugging: returns the matrix as a CuPy array
 7164: 
 7165:    const int size = mesh->np;
 7166:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7167:       const Node *node = mesh->localNodeData + idx_node;
 7168:       res[idx_node*size + idx_node] = node->coeffDiag;
 7169:       for (int j = 0; j < node->numNodes; j++) {
 7170:          Node* nbNode = node->nodes[j];
 7171:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7172:       }
 7173: 
 7174:    }
 7175:    
 7176: }
