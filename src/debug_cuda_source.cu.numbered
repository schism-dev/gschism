 3741: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3742:                                             double *emo, double *efa, 
 3743:                                             double *umo, double *ufa, 
 3744:                                             double *vmo, double *vfa) {
 3745: 
 3746: 
 3747:    NODE_BND(nodeBnd);
 3748:    const int idx = idx_node_bnd;    
 3749: 
 3750:    nodeBnd->idx = idx;
 3751: 
 3752:    // Need to find the segment index and the index of the node on the segment
 3753:    int idxNode = -1;
 3754:    int iseg, i;
 3755:    for (iseg = 0; iseg < nope; iseg++) {
 3756:       // for each segment...
 3757:       for (i = 0; i < nond[iseg]; i++) {
 3758:          idxNode = iond[iseg + i*nope];
 3759:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3760:          
 3761:       }
 3762:    }
 3763: 
 3764:    assert(iseg < nope && "iseg is out of bounds");
 3765: 
 3766: found: // Jumped here when the node was found
 3767: 
 3768:    nodeBnd->isEssentialBC = true;
 3769:    nodeBnd->elbc = 0.0;
 3770: 
 3771:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3772: 
 3773:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 3774:       nodeBnd->efa[jfr] = efa[idx2];
 3775:       nodeBnd->emo[jfr] = emo[idx2];
 3776:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3777:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3778: 
 3779:    }
 3780:         
 3781: 
 3782: }
