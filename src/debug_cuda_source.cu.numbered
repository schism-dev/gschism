  972:    __device__ void setFrame(void) {
  973:       if constexpr(ics == 1) return;
  974: 
  975:       double lat, lon;
  976:       const Point3 p = toPoint3(center, centerZ());
  977: 
  978:       // Compute the latitude and longitude of the element center
  979:       computeLatLon(p, lat, lon);
  980: 
  981:       frame.update(lat, lon);        
  982:    }
