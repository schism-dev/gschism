  700:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  701:       // Check if the point (xt,yt) is inside the element
  702:       double shpCoords[4];
  703: 
  704:       bool res = computeShapeCoords(xt, shpCoords, false);
  705: 
  706:       return res;
  707:    }
  708: 
  709:    __inline__ __device__ bool containsPoint(Vector2 &xt, bool fixCoords) const { 
  710:       // Check if the point (xt,yt) is inside the element
  711:       double shpCoords[4];
  712: 
  713:       Vector2 tmp_xt = xt;
  714:       bool res = computeShapeCoords(tmp_xt, shpCoords, fixCoords);
  715: 
  716:       if (fixCoords && res) xt = tmp_xt;
  717: 
  718:       return res;
  719:    }
  720: 
  721:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  722:    {
  723:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  724:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  725:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  726:       
  727:    }
