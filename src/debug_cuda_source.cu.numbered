  531: struct Element {
  532: 
  533:    // Geometry information
  534:    int idx;                   // Index of the element
  535:    int i34;                   // Number of sides for the element 
  536:    Side *sides[4];            // Sides of the element
  537:    Node *nodes[4];            // Nodes of the element
  538:    Element *nghbElems[4];     // Neighbors of the element
  539: 
  540:    int kb;                    // Bottom index of the element
  541:    double area;               // Area of the element
  542:    double ssign[4];           // Sign associated with each side of an element
  543:    double radius;             // Element equivalent radii
  544: 
  545:    #ifdef USE_FRAMES
  546:    Frame frame;
  547:    #endif
  548: 
  549:    Vector2 gradPhi[4];        // Derivatives of shape functions
  550:    Vector2 gradEta;           // Gradient of free surface elevation
  551:    Vector2 gradPr;            // Gradient of pressure    
  552:    Vector2 gradETP;           // Gradient of Earth Tidal Potential    XXXXX Really used?
  553: 
  554:    bool isDry;                // True if the element is dry
  555: 
  556:    Vector2 center;            // Element center coordinates
  557:    #ifdef USE_FRAMES
  558:    double zcenter;            // Element center z-coordinate
  559:    #endif
  560:    double xlon, ylat;         // Element center lat/lon coordinates in _degrees_
  561:    double depth;              // Depth at element (min of all nodes)
  562:    double z[nvrt];            // z-coord  (local frame - vertical up)
  563: 
  564:    // Physical information
  565:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  566: 
  567:    static const bool isblock = false;              // Always false
  568: 
  569:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  570:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  571: 
  572:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  573:    
  574: 
  575:    double vsource;            // Volumetric source/sink term [m^3/s]
  576: 
  577:    double rho[nvrt];          // Density at each prism center
  578:    double rho_mean[nvrt];     // Mean density at each prism center
  579:    CubicSpline rho_spl;
  580:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  581:    double rho_z[nvrt];        // First derivative of density at each prism center
  582:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  583:    
  584: 
  585:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  586: 
  587:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  588:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  589: 
  590:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  591:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  592: 
  593:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  594:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  595:       // Find the local index of the node in the element (0,1,2,3)
  596:       int res = __ffs((nodes[0] == node) | 
  597:                      ((nodes[1] == node) << 1) | 
  598:                      ((nodes[2] == node) << 2) | 
  599:                      ((nodes[3] == node) << 3)) - 1;
  600:       
  601:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  602:       return res;  
  603:    }
  604: 
  605:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  606:       // Find the local index of the side in the element (0,1,2,3)
  607:       int res = __ffs((sides[0] == side) | 
  608:                      ((sides[1] == side) << 1) | 
  609:                      ((sides[2] == side) << 2) | 
  610:                      ((sides[3] == side) << 3)) - 1;
  611:       
  612:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  613:       return res;
  614:    }
  615: 
  616: 
  617:    __inline__ __device__ int findLevel(double z1, int k) const {
  618:       // Starting at index k, find sequentially the level that contains z
  619: 
  620:       // For testing purposes, forgets k and performs a full search.
  621:       for (k = kb; k < nvrt - 1; k++) {
  622:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
  623:       }
  624:       return nvrt - 2;
  625: 
  626: 
  627:       // if z is already betweeen z[k] and z[k+1], return k
  628:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
  629:       else if (z1 <  z[k]) { 
  630:          // Search for increasing levels
  631:          for (int kk = k; kk < nvrt - 1; kk++) {
  632:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  633:          }
  634:          return nvrt - 1;
  635:       }
  636:       else {
  637:          // Search for decreasing levels
  638:          for (int kk = k; kk >= kb; kk--) {
  639:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  640:          }
  641:          return 0;
  642:       }
  643:    }
  644: 
  645:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
  646:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
  647: 
  648: 
  649:    __device__ __forceinline__ double centerZ(void) const;
  650: 
  651:    // "Local" horizontal coordinates at the nodes. They are computed from the 3D global node coordinates. For ics == 1 and 2
  652:    // Local is in quotes because for ics == 1, the coordinates are unchanged. It just means that in these coordinates, the element is horizontal.
  653:    __device__ __forceinline__ Point2 getLocalHorizontalNodePosition(int idxNode) const;
  654:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2) const;
  655:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const;
  656: 
  657: 
  658:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idxNode = 0,1,2,3)
  659:    __device__ __forceinline__ Point2 GaussPoint(int idxNode) const {
  660:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
  661:        assert(idxNode >= 0 && idxNode < 4 && "GaussPoint: idxNode out of range");
  662:        const double eta = (idxNode & 1) ? +g : -g;
  663:        const double xi  = (idxNode & 2) ? +g : -g;
  664:        return {eta, xi};
  665:    }  
  666: 
  667:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  668:    __device__ __forceinline__ double etaSign(int idxNode) const {
  669:       // bit1: 0 -> -1, 1 -> +1
  670:       assert(idxNode >= 0 && idxNode < 4 && "etaSign: idxNode out of range");
  671:       return (idxNode & 2) ? 1.0 : -1.0;     // [-1,-1,+1,+1]
  672:    }
  673: 
  674:    __device__ __forceinline__ double xiSign(int idxNode) const {
  675:       // +1 if (bit0 XOR bit1), else -1
  676:       assert(idxNode >= 0 && idxNode < 4 && "xiSign: idxNode out of range");
  677:       return ((idxNode & 1) ^ (idxNode >> 1)) ? 1.0 : -1.0;   // [-1,+1,+1,-1]
  678: 
  679:    }
  680: 
  681:    // Shape function Phi at a given point p = (eta,xi), idxNode = node index 0,1,2,3
  682:    __device__ __forceinline__ double Phi(int idxNode, Point2 p) const {
  683:       return 0.25*(1.0 + p.x*etaSign(idxNode))*(1.0 + p.y*xiSign(idxNode));
  684:    }
  685: 
  686:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi)
  687:    __device__ __forceinline__ double dPhi_dxi(int idxNode, Point2 p) const {
  688:       return 0.25*xiSign(idxNode)*(1.0 + p.x*etaSign(idxNode));
  689:    }   
  690: 
  691:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
  692:    __device__ __forceinline__ double dPhi_deta(int idxNode, Point2 p) const {
  693:       return 0.25*(1.0 + p.y*xiSign(idxNode))*etaSign(idxNode);
  694:    }      
  695:    
  696:    __inline__ __device__ double detJ_eta(void) const;
  697: 
  698:    __inline__ __device__ double detJ_xi(void) const;
  699: 
  700:    __inline__ __device__ double jacobianDet(Point2 p) const { return area/4.0 + detJ_eta()*p.x + detJ_xi()*p.y; }
  701: 
  702:    // Check if the element is dry using the more up-to-date elevation.
  703:    __inline__ __device__ bool isDry2(void) const;
  704: 
  705:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  706: 
  707:    __inline__ __device__ double computeSignedArea(void) const;
  708: 
  709:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  710:       // Nudges the point (x,y) to the barycenter of the element
  711: 
  712:       p = (1.0 - btrack_nudge)*p + btrack_nudge*center;
  713:    }
  714: 
  715:    enum EFixIf { fiNo, fiOnlyInside, fiAnywhere };
  716: 
  717:    __device__ bool computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegShapeCoords = fiNo) const;
  718:    
  719:    __device__ void shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const;
  720: 
  721:    __device__ double intPhiPhi(int i1, int i2) const;
  722: 
  723:    __device__ double intGradPhiGradPhi(int i1, int i2) const;
  724: 
  725:    __device__ Vector2 grad2(double *a) const
  726:    {
  727:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  728:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  729:       if (isQuad()) {
  730:          gx += a[3]*gradPhi[3].x;
  731:          gy += a[3]*gradPhi[3].y;
  732:       }
  733:       return {gx, gy};
  734:    }
  735: 
  736:    __device__ Vector2 grad2(double Node::* field) const
  737:    {
  738:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  739:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  740:       if (isQuad()) {
  741:          gx += (nodes[3]->*field)*gradPhi[3].x;
  742:          gy += (nodes[3]->*field)*gradPhi[3].y;
  743:       }
  744:       return {gx, gy};
  745:    }
  746: 
  747:    __device__ __forceinline__ Vector3 n(int k, double &area3D) const;
  748:    __device__ __forceinline__ Vector3 n(int k) const {
  749:       double area3D;
  750:       return n(k, area3D);
  751:     }
