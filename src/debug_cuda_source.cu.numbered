  338: // Polynomial class
  339: template<int grade>
  340: struct Polynomial {
  341:     // Static assertion to give a clear error message at compile time
  342:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  343: };
  344: 
  345: 
  346: // Explicit specialization for grade 4
  347: template<>
  348: struct Polynomial<4> {
  349:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  350: 
  351:    // Constructor from coefficients
  352:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  353: 
  354:    __device__ __forceinline__ double eval(double x) const {
  355:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  356:    }
  357: };
