 7513: extern "C" __global__ void getElementVar(int varCode, bool is3D, double *var1, double *var2, int *ivar1, int *ivar2, int k = -1, int j = -1) {
 7514:    // Get the value of a variable from an element
 7515:    // varName is the name of the variable to get
 7516:    // var is the array to store the value
 7517:    // k is the vertical level index of the variable to get
 7518: 
 7519:    ELEM(elem);
 7520:    
 7521:    int idx = elem->idx;
 7522:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7523: 
 7524:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7525:    if      (varCode == (int)VarCode::w)       { var1[idx] = elem->w[k];}
 7526:    else if (varCode == (int)VarCode::z)       { var1[idx] = elem->z[k];}
 7527:    else if (varCode == (int)VarCode::x)       { var1[idx] = elem->center.x; var2[idx] = elem->center.x;}
 7528:    else if (varCode == (int)VarCode::area)    { var1[idx] = elem->area;}
 7529:    else if (varCode == (int)VarCode::depth)   { var1[idx] = elem->depth;}
 7530:    else if (varCode == (int)VarCode::radius)  { var1[idx] = elem->radius;}
 7531:    else if (varCode == (int)VarCode::lonlat)  { var1[idx] = elem->xlon;     var2[idx] = elem->ylat;}
 7532:    else if (varCode == (int)VarCode::ghat)    { var1[idx] = elem->ghat1.x;  var2[idx] = elem->ghat1.y;}
 7533:    else if (varCode == (int)VarCode::kb)      { ivar1[idx] = elem->kb;}
 7534:    else if (varCode == (int)VarCode::ssign && j > -1)  {ivar1[idx] = elem->ssign[j];}
 7535:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7536:       
 7537:    
 7538: }
 7539: 
 7540: 
 7541: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7542:    // Get the value of a variable from an node
 7543:    // varName is the name of the variable to get
 7544:    // var is the array to store the value
 7545:    // k is the vertical level index of the variable to get
 7546: 
 7547:    NODE(node);
 7548:    
 7549:    int idx = node->idx;
 7550:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7551: 
 7552:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7553:    
 7554:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7555:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7556:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7557:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 7558:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7559:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7560:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;  
 7561:    else if (varCode == (int)VarCode::isdry && k == -1)  var[idx] = node->isDry?1.0:0.0;
 7562:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7563:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7564:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 7565:    
 7566:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7567:       
 7568:    
 7569: }
 7570: 
 7571: 
 7572: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7573:    // Get the value of a variable from an side
 7574:    // varName is the name of the variable to get
 7575:    // var is the array to store the value
 7576:    // k is the vertical level index of the variable to get
 7577:    SIDE(side);
 7578:    
 7579:    int idx = side->idx;
 7580:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7581: 
 7582:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 7583:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 7584:    // else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 7585:    else if (varCode == (int)VarCode::isdry && k == -1)   var[idx] = side->isDry?1.0:0.0;
 7586:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 7587:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 7588:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 7589:    // else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 7590:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 7591:    // else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 7592:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 7593:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 7594:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 7595:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 7596:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 7597:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 7598:    // else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 7599:    else if (varCode == (int)VarCode::bcc && k >= 0)      var[idx] = side->bcc[k].x;
 7600:    // else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 7601:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7602:    // else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7603:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7604:    // else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7605:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 7606:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 7607:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 7608:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 7609:    else if (varCode == (int)VarCode::chi  && k == -1)    var[idx] = side->chi;
 7610:    // else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 7611:    // else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 7612:    // else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 7613:    // else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 7614:    // else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 7615:    // else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 7616:    // else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 7617:    // else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 7618:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7619: }
 7620: 
 7621: 
 7622: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 7623:    // Get the value of a variable from an side
 7624:    // varName is the name of the variable to get
 7625:    // var is the array to store the value
 7626:    // k is the vertical level index of the variable to get
 7627:    SIDE_BND(sideBnd);   
 7628: 
 7629:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 7630:    if (sideBnd->segment->isLand) idx = -7;
 7631: 
 7632:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 7633:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 7634: 
 7635: }
