 7332: 
 7333: 
 7334: //               bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 7335: //               dtb_by_bigv = dtb/bigv
 7336:     
 7337: // !             Advective flux
 7338: //               if (ntd_weno==1 .or. itd_weno==1) then
 7339: //                 adv_tr(1:ntr)=trel_tmp(1:ntr,k,i) 
 7340: //               else
