 1820:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1821:       // Compute the different time ramps used in the code 
 1822:       // This function is performed by just one thread
 1823: 
 1824:       rampbc = 1.0;
 1825:       if constexpr(ibc == 0) {
 1826:          if (drampbc > 0.0) {
 1827:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1828:          } else {
 1829:             rampbc = 1.0;
 1830:          }
 1831:       }
 1832: 
 1833:       if (nws != 0) {
 1834:          if (drampwind > 0.0) {
 1835:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1836:          } else {
 1837:             rampwind = 1.0;
 1838:          }
 1839:       }
 1840: 
 1841:       if (drampwafo > 0.0) {
 1842:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1843:       } else {
 1844:          rampwafo = 1.0;
 1845:       }
 1846: 
 1847:       // For source/sinks
 1848:       if (if_source && dramp_ss > 0.0) {
 1849:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1850:       } else {
 1851:          ramp_ss = 1.0;
 1852:       }
 1853: 
 1854:       if (dramp > 0.0) {
 1855:          ramp = tanh(2.0*time/86400.0/dramp);
 1856:       } else {
 1857:          ramp = 1.0;
 1858:       }
 1859: 
 1860: 
 1861:    }
