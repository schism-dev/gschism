  372: 
  373: struct Frame {
  374:    double _t[9]; // t stands for tensor.
  375: 
  376:    // Access the tensor in Fortran order
  377:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  378: 
  379:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  380: 
  381:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  382: 
  383:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  384:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  385:       sincos(ar2, &sin_ar2, &cos_ar2);
  386: 
  387:       t(0,0) = -sin_ar1;
  388:       t(1,0) =  cos_ar1;
  389:       t(2,0) =  0.0;
  390:       t(0,1) = -cos_ar1*sin_ar2;
  391:       t(1,1) = -sin_ar1*sin_ar2;
  392: 
  393:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  394: 
  395:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  396:       assert (ar4!=0.0 && "GRID: ar4=0");
  397: 
  398:       const double ar4_inv = 1.0/ar4;
  399:       t(0,1) = t(0,1)*ar4_inv;
  400:       t(1,1) = t(1,1)*ar4_inv;
  401:       t(2,1) = t(2,1)*ar4_inv;
  402: 
  403:       // The third vector is the cross product of the first two
  404:       crossProduct(t(0,0), t(1,0), t(2,0), 
  405:                    t(0,1), t(1,1), t(2,1), 
  406:                    t(0,2), t(1,2), t(2,2));
  407:    }
  408: 
  409: 
  410:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  411:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  412:    // Inputs:
  413:    //        vec0: vel. in this frame;
  414:    //        frameout: Output frame;
  415:    // Output: 
  416:    //        vec1: vel. in new frame  
  417: 
  418:       auto const fo = frameout;
  419:       Vector2 vec1;
  420: 
  421:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  422:       // of t and fo.t are the same.
  423:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  424:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  425: 
  426:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  427:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  428: 
  429:       return vec1;
  430:    }
  431: 
  432:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  433:       // Transform a vector from global to local frame
  434:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  435:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  436:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  437:    }
  438: 
  439:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  440:       // Transform a vector from local to global frame
  441:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  442:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  443:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  444:    }   
  445: 
  446:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  447:    // Tranforms a point from global to local frame     
  448:       G2L(pi - origin0, po);
  449:    }
  450: 
  451:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  452:    // Transforms a point from local to global frame      
  453:       L2G(pi, po);
  454:       po = po + origin0;
  455:    }
  456: 
  457: };
