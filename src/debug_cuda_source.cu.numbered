 7214: __global__ void printMatrix(void) {
 7215: 
 7216: 
 7217:    // Let only one thread per block print at a time 
 7218: 
 7219:    if (threadIdx.x == 0) {
 7220:       for (int ithread = 0; ithread < blockDim.x; ithread++) {
 7221:          const int idx_node = ithread + blockIdx.x * blockDim.x;
 7222:          if (idx_node >= mesh->np) return;
 7223:          const Node *node = mesh->localNodeData + idx_node;
 7224:          printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7225:          for (int j = 0; j < node->numNodes; j++) {
 7226:             Node* nbNode = node->nodes[j];
 7227:             if (node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7228:          }
 7229:          printf("]\n");
 7230: 
 7231:       }
 7232:    }
 7233: 
 7234: 
 7235: 
 7236: }
