  717: struct Element {
  718: 
  719:    // Geometry information
  720:    int idx;                   // Index of the element
  721:    int i34;                   // Number of sides for the element 
  722:    Side *sides[4];            // Sides of the element
  723:    Node *nodes[4];            // Nodes of the element
  724:    Element *nghbElems[4];     // Neighbors of the element
  725: 
  726:    int kb;                    // Bottom index of the element
  727:    double area;               // Area of the element
  728:    double ssign[4];           // Sign associated with each side of an element
  729:    double radius;             // Element equivalent radii
  730: 
  731:    Frame<ics> frame;
  732: 
  733:    Vector2 gradPhi[4];        // Derivatives of shape functions
  734:    Vector2 gradEta;           // Gradient of free surface elevation
  735:    Vector2 gradPr;            // Gradient of pressure    
  736:    Vector2 gradETP;           // Gradient of Earth Tidal Potential    XXXXX Really used?
  737: 
  738:    bool isDry;                // True if the element is dry
  739: 
  740:    Point2 center;            // Element center coordinates (global coordinates)
  741: 
  742:    double depth;              // Depth at element (min of all nodes)
  743:    double z[nvrt];            // z-coord  (local frame - vertical up)
  744: 
  745:    // Physical information
  746:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  747: 
  748:    static const bool isblock = false;              // Always false
  749: 
  750:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  751:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  752: 
  753:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  754:    
  755: 
  756:    double vsource;            // Volumetric source/sink term [m^3/s]
  757: 
  758:    double rho[nvrt];          // Density at each prism center
  759:    double rho_mean[nvrt];     // Mean density at each prism center
  760:    CubicSpline rho_spl;
  761:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  762:    double rho_z[nvrt];        // First derivative of density at each prism center
  763:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  764:    
  765: 
  766:    __inline__ __device__ Point2 outputCoords(void) const;
  767: 
  768:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }  
  769: 
  770:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
  771:    // If ics == 2, convert the global point to the local frame of the element
  772:       
  773:       if constexpr (ics == 1) {
  774:          return p;
  775:       } else {
  776:          const Point3 c = {center.x, center.y, centerZ()};
  777:          return frame.G2L(p - c);
  778:       }
  779:    }
  780: 
  781:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  782:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  783: 
  784:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  785:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  786: 
  787:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  788:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  789:       // Find the local index of the node in the element (0,1,2,3)
  790:       int res = __ffs((nodes[0] == node) | 
  791:                      ((nodes[1] == node) << 1) | 
  792:                      ((nodes[2] == node) << 2) | 
  793:                      ((nodes[3] == node) << 3)) - 1;
  794:       
  795:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  796:       return res;  
  797:    }
  798: 
  799:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  800:       // Find the local index of the side in the element (0,1,2,3)
  801:       int res = __ffs((sides[0] == side) | 
  802:                      ((sides[1] == side) << 1) | 
  803:                      ((sides[2] == side) << 2) | 
  804:                      ((sides[3] == side) << 3)) - 1;
  805:       
  806:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  807:       return res;
  808:    }
  809: 
  810:    __inline__ __device__ int findLevel(double z1, int k) const {
  811:       // Starting at index k, find sequentially the level that contains z
  812: 
  813:       // For testing purposes, forgets k and performs a full search.
  814:       for (k = kb; k < nvrt - 1; k++) {
  815:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
  816:       }
  817:       return nvrt - 2;
  818: 
  819: 
  820:       // if z is already betweeen z[k] and z[k+1], return k
  821:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
  822:       else if (z1 <  z[k]) { 
  823:          // Search for increasing levels
  824:          for (int kk = k; kk < nvrt - 1; kk++) {
  825:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  826:          }
  827:          return nvrt - 1;
  828:       }
  829:       else {
  830:          // Search for decreasing levels
  831:          for (int kk = k; kk >= kb; kk--) {
  832:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  833:          }
  834:          return 0;
  835:       }
  836:    }
  837: 
  838:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
  839:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
  840: 
  841: 
  842:    __device__ __forceinline__ double centerZ(void) const;
  843: 
  844:    // "Local" horizontal coordinates at the nodes. They are computed from the 3D global node coordinates. For ics == 1 and 2
  845:    // Local is in quotes because for ics == 1, the coordinates are unchanged. It just means that in these coordinates, the element is horizontal.
  846:    __device__ __forceinline__ Point2 getLocalHorizontalNodePosition(int idxNode) const;
  847:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2, int idx = 0) const;
  848:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3, int idx = 0) const;
  849: 
  850: 
  851:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idxNode = 0,1,2,3)
  852:    __device__ __forceinline__ Point2 GaussPoint(int idxNode) const {
  853:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
  854:        assert(idxNode >= 0 && idxNode < 4 && "GaussPoint: idxNode out of range");
  855:        const double eta = (idxNode & 1) ? +g : -g;
  856:        const double xi  = (idxNode & 2) ? +g : -g;
  857:        return {eta, xi};
  858:    }  
  859: 
  860:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  861:    __device__ __forceinline__ double etaSign(int idxNode) const {
  862:       // bit1: 0 -> -1, 1 -> +1
  863:       assert(idxNode >= 0 && idxNode < 4 && "etaSign: idxNode out of range");
  864:       return (idxNode & 2) ? 1.0 : -1.0;     // [-1,-1,+1,+1]
  865:    }
  866: 
  867:    __device__ __forceinline__ double xiSign(int idxNode) const {
  868:       // +1 if (bit0 XOR bit1), else -1
  869:       assert(idxNode >= 0 && idxNode < 4 && "xiSign: idxNode out of range");
  870:       return ((idxNode & 1) ^ (idxNode >> 1)) ? 1.0 : -1.0;   // [-1,+1,+1,-1]
  871: 
  872:    }
  873: 
  874:    // Shape function Phi at a given point p = (eta,xi), idxNode = node index 0,1,2,3
  875:    __device__ __forceinline__ double Phi(int idxNode, Point2 p) const {
  876:       return 0.25*(1.0 + p.x*etaSign(idxNode))*(1.0 + p.y*xiSign(idxNode));
  877:    }
  878: 
  879:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi)
  880:    __device__ __forceinline__ double dPhi_dxi(int idxNode, Point2 p) const {
  881:       return 0.25*xiSign(idxNode)*(1.0 + p.x*etaSign(idxNode));
  882:    }   
  883: 
  884:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
  885:    __device__ __forceinline__ double dPhi_deta(int idxNode, Point2 p) const {
  886:       return 0.25*(1.0 + p.y*xiSign(idxNode))*etaSign(idxNode);
  887:    }      
  888:    
  889:    __inline__ __device__ double detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
  890: 
  891:    __inline__ __device__ double detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
  892: 
  893:    __inline__ __device__ double jacobianDetQuad(Point2 p, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const 
  894:          { return area/4.0 + detJ_eta_quad(x0, x1, x2, x3)*p.x + detJ_xi_quad(x0, x1, x2, x3)*p.y; }
  895: 
  896:    // Check if the element is dry using the more up-to-date elevation.
  897:    __inline__ __device__ bool isDry2(void) const;
  898: 
  899:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  900: 
  901:    __device__ bool inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const;
  902: 
  903:    __inline__ __device__ double computeSignedArea(void) const;
  904: 
  905: 
  906:    enum EFixIf { fiNo, fiOnlyInside, fiAnywhere };
  907: 
  908:    __device__ bool computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegShapeCoords = fiNo, const Side *origSide = nullptr) const;
  909:    
  910:    __device__ void shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const;
  911: 
  912: 
  913:    __device__ double intPhiPhiTri(int i, int j) const;
  914: 
  915:    __device__ double intPhiPhiQuad(int i, int j, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
  916: 
  917: 
  918:    __device__ double intGradPhiGradPhiQuad(int i1, int i2, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
  919: 
  920:    __device__ Vector2 grad2(double *a) const
  921:    {
  922:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  923:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  924:       if (isQuad()) {
  925:          gx += a[3]*gradPhi[3].x;
  926:          gy += a[3]*gradPhi[3].y;
  927:       }
  928:       return {gx, gy};
  929:    }
  930: 
  931:    __device__ Vector2 grad2(double Node::* field) const
  932:    {
  933:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  934:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  935:       if (isQuad()) {
  936:          gx += (nodes[3]->*field)*gradPhi[3].x;
  937:          gy += (nodes[3]->*field)*gradPhi[3].y;
  938:       }
  939:       return {gx, gy};
  940:    }
  941: 
  942:    __device__ __forceinline__ Vector3 n(int k, double &area3D) const;
  943:    __device__ __forceinline__ Vector3 n(int k) const {
  944:       double area3D;
  945:       return n(k, area3D);
  946:     }
