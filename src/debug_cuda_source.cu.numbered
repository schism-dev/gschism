 3153: 
 3154: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3155:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3156:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3157:    // 
 3158:    // This kernel is called for all nodes.
 3159: 
 3160: 
 3161:    NODE(node1);
 3162: 
 3163: 
 3164:    node1->clearMatrixRow();
 3165:    node1->qel = 0.0;
 3166: 
 3167:    // THIS IS FOR STRUCTURES XXX
 3168:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3169: 
 3170:    
 3171:    for (int j=0; j<node1->numElements; j++) {
 3172:       // For each element connected to the node...
 3173: 
 3174:       Element *elem = node1->elements[j];
 3175: 
 3176:       // Compute the average gravity
 3177:       const double grav3 = elem->mean(&Node::grav2);
 3178: 
 3179:       // Look at the documentation for the description of the terms in the following integrals
 3180: 
 3181:       // Integral I_1 
 3182:       // \bar{\breve{H}} 
 3183:       const double hhatb = elem->mean(&Side::hhat);        
 3184: 
 3185: 
 3186:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3187: 
 3188:       const int id1 = elem->nodeLocalIdx(node1); 
 3189:       const double area = elem->area;
 3190: 
 3191:       if (elem->isTri()) {
 3192: 
 3193:          // To clarify the notation in this section: 
 3194:          //   i stands for the node under consideration (node1)
 3195:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3196:          const int id2 = elem->nxq(1 + id1);
 3197:          const int id3 = elem->nxq(2 + id1);
 3198:          Node *node2 = elem->nodes[id2];
 3199:          Node *node3 = elem->nodes[id3];
 3200: 
 3201:          const Point2 x1 = node1->p2();
 3202:          const Point2 x2 = node2->p2();
 3203:          const Point2 x3 = node3->p2();
 3204: 
 3205:          // integral of phi_i*phi_j
 3206:          const double ipp_ii = (1.0/6.0 )*area;
 3207:          const double ipp_ij = (1.0/12.0)*area;
 3208:          const double ipp_ik = (1.0/12.0)*area;
 3209: 
 3210:          // integral of [(grad phi_i) * (grad phi_j)]
 3211:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3212:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3213:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3214: 
 3215:          // Computes the different components of integral I_1 of each node with respect to node i.
 3216:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3217:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3218:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3219: 
 3220: if (j==node1->numElements-1) {
 3221: printf("grav3 = %f, thetai = %f, dt = %f, hhatb = %f, area = %f, dot1= %f, dot2 = %f, dot3 = %f\n", grav3, thetai, dt, hhatb, area, dot(x3-x2, x3-x2), dot(x3-x2, x1-x3), dot(x1-x3, x1-x3));
 3222: printf("node idx = %d, x1 = %f, %f, x2 = %f, %f, x3 = %f, %f\n", node1->idx, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y);
 3223: printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 3224: }
 3225: 
 3226:          node1->addToSparseMatrix(node1, I1_ii);
 3227:          node1->addToSparseMatrix(node2, I1_ij); 
 3228:          node1->addToSparseMatrix(node3, I1_ik);
 3229: 
 3230: if (j==node1->numElements-1) printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 3231:      
 3232:       }
 3233:       else { // Quad
 3234:          // XXX IMPLEMENT THIS
 3235:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3236:       } 
 3237: 
 3238:  
 3239:       // Integral I_4
 3240:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3241:       // Where
 3242:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3243: 
 3244:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3245:       // of U over the element.
 3246:       Vector2 Umean = {0.0, 0.0};
 3247:       for (int m=0; m<elem->i34; m++) {      
 3248:          const Side *side = elem->sides[m];
 3249: 
 3250:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3251:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3252:       }
 3253:       Umean = Umean/elem->i34;
 3254: 
 3255:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3256: 
 3257:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3258:       const double I_4_1 = dot(gradPhi_1, Umean);
 3259: 
 3260:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3261:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3262:      
 3263:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3264: if (j==node1->numElements-1) printf("MMMMmm  idx_node = %d, I_4_1 = %.15g, I_4_2 = %.15g, node1->qel = %.15g, gradPhi_1 = %.15g, %.15g, elem->ghat1 = %.15g, %.15g\n", node1->idx, I_4_1, I_4_2, node1->qel, gradPhi_1.x, gradPhi_1.y, elem->ghat1.x, elem->ghat1.y);
 3265: 
 3266:       // Additional terms 
 3267:       double vnorm = 0.0;
 3268:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3269:          Vector3 ubed;
 3270:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3271: 
 3272:          Vector3 gradP = {0.0, 0.0, 1.0};
 3273:          for (int m=0; m < elem->i34; m++) {
 3274:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3275:            gradP += toVector3(gradP_2D, 0.0);
 3276:          }   
 3277:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3278:       } // imm==2
 3279: 
 3280:       if (elem->isTri()) {
 3281:          for (int l=0; l<3; l++) {
 3282:            double fac;
 3283: 
 3284:            Node *node = elem->nodes[l];
 3285: 
 3286:            (node == node1)? fac=2.0 : fac=1.0;
 3287: 
 3288:            if constexpr(imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3289:            else                 node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3290:            
 3291:          }
 3292: 
 3293: 
 3294:          if (!elem->isDry) {
 3295:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3296: 
 3297:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3298:          }
 3299: if (j==node1->numElements-1) printf("&&& node1->qel = %f\n", node1->qel, node1->eta2);
 3300: 
 3301:       } // isTri
 3302:       else { // isQuad
 3303:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3304:          // for (int l=0; l<4; l++) {
 3305:          //   const Node *node = elem->nodes[l];
 3306: 
 3307:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3308:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3309: 
 3310:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3311:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3312:          // }
 3313: 
 3314:       } // isQuad
 3315: 
 3316: 
 3317:       node1->qel += (dt/elem->i34)*elem->vsource;
 3318:       
 3319: 
 3320:    } // for all elements connected to the node
 3321:    
 3322: 
 3323: 
 3324:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3325:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3326:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3327:    if (nodeBnd != nullptr)  { 
 3328:       // If it is an open boundary node...
 3329: 
 3330:       // At least one open bnd side, maybe two
 3331:       for (int l=0; l<2; l++) { 
 3332: 
 3333:          // Gets each of the sides sharing the node. 
 3334:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3335: 
 3336:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 3337: 
 3338:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3339: 
 3340:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3341:          if (sideBnd != nullptr) {
 3342:             // If the side is on a boundary...
 3343: 
 3344:             // Get the boundary segment
 3345:             const BoundarySegment *sideSegment = sideBnd->segment;
 3346:             const Side *side = sideBnd->side;
 3347: 
 3348:             // Integral I_3
 3349:             if (sideSegment->ifltype != 0) {
 3350:             // Natural or Flather b.c.
 3351: 
 3352:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3353:                // especially for Flather b.c.
 3354:                double ri3 = 0.0;
 3355:                if (!side->isDry) {
 3356:                   // If the side is not dry
 3357:                   
 3358:                   // Computes the side flux of (uth, vth)
 3359:                   double Vn = 0.0;
 3360:                   for (int k = side->kb; k<nvrt-1; k++) {
 3361:                      // uth, vth in lat/lon frame if ics=2
 3362:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 3363:                      const double vn1 = dot(sideBnd->uth(k  ), side->n); // outer normal
 3364:                      const double vn2 = dot(sideBnd->uth(k+1), side->n);
 3365: 
 3366:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3367:                   }
 3368: 
 3369:                   ri3 = 0.5*side->len*Vn;
 3370:                }
 3371: 
 3372:                if (sideSegment->ifltype == -1) { // Flather 1
 3373: 
 3374:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3375:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3376: 
 3377:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3378:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3379:                   
 3380:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3381:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3382: 
 3383:                } 
 3384:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3385:                   // Reset ri3
 3386:                   ri3 = 0.0;
 3387: 
 3388:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3389: 
 3390:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3391: 
 3392:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3393:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3394: 
 3395:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3396:                   node1->addToSparseMatrix(node1, con0*2.0);
 3397:                   node1->addToSparseMatrix(node2, con0);
 3398: 
 3399:                } // if Flather or Discharge
 3400: 
 3401:                node1->qel -= thetai*dt*ri3;
 3402: 
 3403:             } // I_3
 3404:           
 3405: 
 3406:             // Integral I_5
 3407:             if(!side->isDry) {
 3408: 
 3409:                const double Unbar = dot(side->U, side->n);
 3410: 
 3411:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3412:                
 3413:             } // I_5
 3414: 
 3415:          } // if is boundary side
 3416: 
 3417:       } // for l
 3418: 
 3419:    } // if isbnd
 3420: 
 3421: 
 3422:    printf("44444444 idx_node = %d, node1->qel = %f\n", node1->idx, node1->qel);
 3423: 
 3424: }
 3425: 
 3426: 
 3427: 
 3428: extern "C" {
 3429:    __global__ void rollUpElevation(void) {
 3430: 
 3431:       NODE(node);
 3432: 
 3433:       node->eta2 += node->eta1;
 3434: 
 3435:    }
 3436: 
 3437: 
 3438:    __global__ void backtrackAllNodes(void) {
 3439: 
 3440:       // max/min # of sub-divisions
 3441:       const int ndelt_max = max(1.0, dt/dtb_min);
 3442:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3443: 
 3444:       // Removed all references to swild98 XXX
 3445:       // swild98=0.d0 !init
 3446: 
 3447: 
 3448:       SIDE(side);
 3449: 
 3450:       const int kb = side->kb;
 3451: 
 3452: 
 3453: 
 3454:       // Initialize btrack velocities to the actual velocities at the side 
 3455:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3456: 
 3457: 
 3458:       if (side->isDry) return;
 3459: 
 3460: 
 3461:       // Checks that at least one element is not dry
 3462:       const Element *elem1 = side->elems[0];
 3463:       const Element *elem2 = side->elems[1];
 3464: 
 3465: 
 3466:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3467:       
 3468:       // XXXXXX
 3469:       // !swild_tmp to store global coord. of the starting side
 3470:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3471:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3472:       // !Use sframe2 
 3473:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3474: 
 3475: 
 3476:       for (int k = kb; k < nvrt; k++) {
 3477:       //  Initialize (xt,yt,zt), nnel and vel.
 3478:       //  For ics=2, the coordinates are in local frames
 3479:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3480: 
 3481: 
 3482:          const int iadvf = side->iadv();  // Advection flag
 3483: 
 3484:          Point3 xt;
 3485:          if constexpr(ics==1) {
 3486:             xt = side->center3D(k); 
 3487:          }
 3488:          else // lat/lon; in side lat/lon frame
 3489:          {
 3490:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3491:          // XXX IMPLEMENT THIS
 3492:       //          xt=0.d0
 3493:       //          yt=0.d0
 3494:       //          !centroid coord. for nudging
 3495:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3496:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3497:          }  // ics
 3498: 
 3499: 
 3500:          // Velocity at the side (in ll frame for ics, same vertical direction)
 3501:          // XXX IS THIS NECESSARY?
 3502:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 3503: 
 3504:          // If on land or open boundary...
 3505:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3506:          
 3507:          const double vmag = length(toVector2(u_int));
 3508: 
 3509:          if (vmag <= velmin_btrack) {
 3510:             // No activity 
 3511: addDebugPlot(side->center, side->center, 0x00FF00);
 3512:             side->btu[k] = side->u2[k];
 3513:             
 3514:          } else {  // do btrack
 3515: 
 3516:             // Compute number of sub-divisions based on local gradients 
 3517:             // XXX IS THIS NECESSARY?
 3518:             double suma = 0.0;
 3519:             int icount = 0;
 3520:             for (int ii=0; ii<2; ii++) {
 3521: 
 3522:                const Element *elem = side->elems[ii];
 3523:                  
 3524:                if (elem == nullptr) continue;
 3525: 
 3526:                icount++;
 3527: 
 3528:                // Not strictly along z; in ll frame for ics=2
 3529: 
 3530:                double utmp[4];
 3531:                double vtmp[4];
 3532:                for (int jj = 0; jj < elem->i34; jj++) {
 3533: 
 3534:                   const Node *node = elem->nodes[jj];
 3535: 
 3536:                   if constexpr(ics==1) {
 3537:                      utmp[jj] = node->u2[k].x;
 3538:                      vtmp[jj] = node->u2[k].y;  
 3539:                   } else {
 3540:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3541:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3542:                   }
 3543:                } // for jj
 3544: 
 3545:                const Vector2 grad_u = elem->grad2(utmp); 
 3546:                const Vector2 grad_v = elem->grad2(vtmp);
 3547: 
 3548:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3549:             } // for ii
 3550: 
 3551:             assert(icount > 0 && "Impossible 77");
 3552: 
 3553:             // '4' is somewhat arbitrary
 3554:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3555: 
 3556:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3557:          
 3558: 
 3559:             Vector3 u_int = {0.0, 0.0, 0.0};
 3560: 
 3561:             side->btrack(k, dt, dtbk, u_int);
 3562:                
 3563:          } // if vmag (do backtrack)
 3564: 
 3565:       } // for j=jmin,nvrt-1
 3566: 
 3567:    }
 3568: } // extern "C"
 3569: 
 3570: template<int nc>
 3571: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3572: 
 3573: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3574: //
 3575: // a,b,c,rhs: input vectors and are not modified by this program.
 3576: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3577: // rhs is the r.h.s.
 3578: // n: actual rank of the system.
 3579: // rows in u() and rhs();
 3580: // u: output with nc columns (transposed to rows)
 3581: // gam: a working array.
 3582: //
 3583: // NOTES:
 3584: // This is a template function that allows for different numbers of columns in the rhs vector.
 3585: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3586: 
 3587:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3588:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3589: 
 3590:    double bet = b[0];
 3591:    if constexpr (nc == 1) {
 3592:       u[0] = rhs[0]/bet;
 3593:    } else {
 3594:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 3595:    }
 3596: 
 3597:    for (int j = 1; j < n; j++) {
 3598:       gam[j] = c[j-1]/bet;
 3599:       bet = b[j] - a[j]*gam[j];
 3600: 
 3601:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3602: 
 3603:       if constexpr (nc == 1) {
 3604:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3605:       } else {
 3606:          for (int k = 0; k < nc; k++) {
 3607:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 3608:          }
 3609:       }
 3610:    }
 3611: 
 3612:    // Back-substitution
 3613:    for (int j=n-1; j>=1; j--) {
 3614:       if constexpr (nc == 1) {
 3615:          u[j] = u[j] - gam[j+1]*u[j-1];
 3616:       } else {
 3617:          for (int k = 0; k < nc; k++) {
 3618:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 3619:          }
 3620:       }
 3621:    }
 3622: }
 3623: 
 3624: 
 3625: 
 3626: // Helper function that contains the core algorithm
 3627: template<typename XAccessor, typename YAccessor>
 3628: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3629:                                     double  yp_top, double  yp_bot, 
 3630:                                     CubicSpline &spline) {
 3631:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3632:    // 
 3633:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3634:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3635:    //
 3636:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3637:    // 
 3638:    // Inputs: 
 3639:    //            n: dimension for x etc; # of data pts (>=2);
 3640:    //            getX, getY: functions to access x,y coordinates
 3641:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3642:    //     Output: 
 3643:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3644: 
 3645:    const int n = k2 - k1 + 1;
 3646:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3647: 
 3648:    // Allocate memory for the splines
 3649:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3650:    spline.x   = new double[n];
 3651:    spline.y   = new double[n];
 3652:    spline.yp  = new double[n];
 3653:    spline.ypp = new double[n];
 3654: 
 3655:    for (int k=k1; k<=k2; k++) {
 3656:       spline.x[k] = getX(k);
 3657:       spline.y[k] = getY(k);
 3658:    }
 3659: 
 3660:    // This is to simplify expressions later
 3661:    double *x = spline.x;
 3662:    double *y = spline.y;
 3663: 
 3664:    double *a = nullptr;
 3665:    double *b = nullptr;
 3666:    double *c = nullptr;
 3667:    double *gam = nullptr;
 3668:    double *rhs = nullptr;
 3669:    
 3670: 
 3671:       a = new double[n];   // Lower diagonal
 3672:       b = new double[n];   // Diagonal
 3673:       c = new double[n];   // Upper diagonal
 3674:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3675:       rhs = new double[n]; // Right-hand side
 3676: 
 3677:    for (int k=k1; k<=k2; k++) {
 3678:       if (k == k1) {
 3679:          // Bottom level
 3680:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3681:          b[k] = (x[k+1] - x[k])/3.0;
 3682:          c[k] = b[k]/2.0;
 3683:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3684:       } else if (k == n - 1) {
 3685:          // Top level (surface)
 3686:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3687:          b[k] = (x[k] - x[k-1])/3.0;
 3688:          a[k] = b[k]/2.0;
 3689:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3690:       } else {
 3691:          // Intermediate levels
 3692:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3693:          b[k] = (x[k+1] - x[k-1])/3.0;
 3694:          a[k] = (x[k  ] - x[k-1])/6.0;
 3695:          c[k] = (x[k+1] - x[k  ])/6.0;
 3696:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3697:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3698:       }
 3699:    }
 3700: 
 3701:    // Solve the tridiagonal system
 3702:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3703:    
 3704:    spline.yp[k1] = yp_bot;
 3705:    spline.yp[k2] = yp_top;
 3706: 
 3707:    // Compute rest of 1st derivatives using the splines
 3708:    for (int k=k1+1; k<k2; k++) {
 3709:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3710:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3711:    }
 3712:    
 3713:    delete[] a;
 3714:    delete[] b;
 3715:    delete[] c;
 3716:    delete[] gam;
 3717:    delete[] rhs;
 3718: 
 3719: }
 3720: 
 3721: // Array version
 3722: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3723:                                 double y_top, double y_bot, 
 3724:                                 CubicSpline &spline) {
 3725:    auto getX = [x] (int k) { return x[k]; };
 3726:    auto getY = [y] (int k) { return y[k]; };
 3727:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3728: }
 3729: 
 3730: // Lambda version - allows custom access patterns
 3731: template<typename XFunc, typename YFunc>
 3732: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3733:                                 double y_top, double y_bot,
 3734:                                 CubicSpline &spline) {
 3735:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3736: }
