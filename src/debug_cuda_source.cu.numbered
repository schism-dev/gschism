 1333: // This struct is used to store the boundary information for a node.
 1334: struct NodeBoundary {   
 1335:    int idx;
 1336:    BoundarySegment *segment;
 1337:    Node *node;
 1338:    
 1339:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1340:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1341: 
 1342:    bool isLand;
 1343: 
 1344:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1345:    double elbc;   // Elevation boundary condition
 1346:    double eth;    // Elevation time history
 1347: 
 1348:    double eta_mean; // Mean elevation at nodes
 1349: 
 1350:    bool isEssentialBC;
 1351: 
 1352:    Vector2 uth[nvrt];  // "Time history" velocity
 1353: 
 1354:    // Arrays for harmonic constituents (if needed)
 1355:    double  emo[nbfr];  // Elevation amplitude
 1356:    double  efa[nbfr];  // Elevation phase
 1357:    Vector2 umo[nbfr];  // velocity amplitude
 1358:    Vector2 ufa[nbfr];  // velocity phase
 1359: 
 1360: 
 1361:    NodeBoundary(void) {
 1362:       isLand = false;
 1363:    }
 1364:    NodeBoundary(bool _isLand) {
 1365:       isLand = _isLand;
 1366:    }
 1367: 
 1368:    
 1369:    __forceinline__ __device__ int numSidesForAverage() const {
 1370:    // Returns the number of sides that are connected to the node and have the same segment.
 1371:    // This is used to compute the average velocity at the node for open boundary nodes.
 1372:       int res = 0;
 1373:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1374:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1375: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1376:       return res;
 1377:    }
 1378: 
 1379: 
 1380:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1381:       assert(index == 0 || index == 1); 
 1382:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1383:    }
 1384: 
 1385:    __forceinline__ __device__ void linkSideBoundary(SideBoundary *sb) {
 1386:       if (isLand) return;  // land never uses these links
 1387:       SideBoundary *null = nullptr;
 1388:       if (atomicCAS((unsigned long long *)&sideBnd1,
 1389:                   (unsigned long long)null,
 1390:                   (unsigned long long)sb) == (unsigned long long)null)
 1391:          return;
 1392:       if (atomicCAS((unsigned long long *)&sideBnd2,
 1393:                   (unsigned long long)null,
 1394:                   (unsigned long long)sb) == (unsigned long long)null)
 1395:          return;
 1396:       // both slots taken. OK if this side was already linked
 1397:       assert(sideBnd1 == sb || sideBnd2 == sb);
 1398:    }
 1399: 
 1400: 
 1401: };
 1402: 
 1403: struct Node {
 1404: 
 1405:    // Geometry information
 1406:    int idx;        // Index of the node
 1407:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1408:    int numNodes;   // Number of nodes neighbors of this node
 1409: 
 1410:    Element **elements; // Array of pointers to the elements that share this node
 1411:    int numElements;    // Number of elements that share this node
 1412: 
 1413:    int numSides;       // Number of sides that are connected to this node
 1414: 
 1415:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1416:    double gz;          // Global vertical coordinate at the node.
 1417:    Vector2 u2[nvrt];
 1418:    double  w2[nvrt];
 1419:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1420:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1421:    double lon, lat;
 1422:    double depth;
 1423: 
 1424:    Frame<ics> frame;
 1425: 
 1426:    LocalSigma<ivcor> localSigma;  
 1427: 
 1428:    int kb;       // Bottom index of the node
 1429: 
 1430:    bool isDry;     // True if the node is dry
 1431: 
 1432:    int iadv;     // Advection flag
 1433: 
 1434:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1435:                           // this is nullptr
 1436: 
 1437:    TempVar tmp; // Temporary variable to store different types of variables
 1438: 
 1439:    // Physical information
 1440:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1441:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1442: 
 1443:    double rho[nvrt];     // Density
 1444:    double dfv[nvrt];     // Vertical viscosity
 1445: 
 1446:    double eta1; // Elevation at nodes at previous timestep
 1447:    double eta2; // Elevation at nodes at current timestep
 1448: 
 1449:    double ETP;  // Earth Tidal Potential
 1450: 
 1451:    double pr;    // Air pressure
 1452:    double grav2; // Gravity 
 1453:    
 1454:    Vector2 dav;  // Depth averaged velocity
 1455: 
 1456:    Vector2 tau; // Wind stress vector
 1457: 
 1458:    // Vegetation parameters
 1459:    double veg_h;
 1460:    double veg_nv;
 1461:    double veg_di;
 1462:    double veg_Cd;
 1463:    double veg_h_unbent;
 1464:    double veg_di_unbent;
 1465:    double veg_nv_unbent;
 1466:    double veg_alpha_vert_mean;
 1467:    double veg_alpha0;
 1468:    double veg_alpha3D[nvrt];
 1469: 
 1470:    // Bottom drag parameters
 1471:    double Cd;       // Bottom drag coefficient   
 1472: 
 1473:    // These three are mutually exclusive
 1474:    union {
 1475:       double rmanning; // Bottom Manning's coefficient
 1476:       double rough;    // Bottom roughness length
 1477:       double drag;     // Bottom drag coefficient
 1478:    };
 1479:    Vector2 tau_bot; // Bottom stress vector
 1480: 
 1481:    // XXXX REMOVE FOR IMM>0???
 1482:    double bdef1 = 0.0; // Bottom deformation at previous timestep
 1483:    double bdef2 = 0.0; // Bottom deformation at current timestep
 1484: 
 1485:    double qel; // RHS
 1486:    double coeffDiag; // Diagonal coefficient of the matrix
 1487:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1488: 
 1489:    // This was used by a previous version of the conjugate gradient method
 1490:    // double mP; // Search direction for conjugate gradient method
 1491:    // double mR; // Residual for conjugate gradient method
 1492:    // double mAp; // Product of matrix and search direction for conjugate gradient method
 1493: 
 1494:    double mX; // Solution of the FEM system
 1495: 
 1496:    // Meteorological forcing
 1497:    Vector2 u_air;
 1498:    double p_air;  // XXXX is this the same as pr?
 1499:    double t_air;
 1500:    double q_air;
 1501:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1502: 
 1503:    __device__ void setWind(Vector2 &u) {
 1504:    // Sets the wind vector taking into account the mesh angle
 1505:    
 1506:       const double speed = length(u);
 1507: 
 1508:       // Rotate wind vector to the node frame
 1509:       u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1510: 
 1511:       // Sets the surface stress vector due to wind.
 1512:       if constexpr(nws == 0) {
 1513:          tau = {0.0, 0.0};
 1514: 
 1515:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1516:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1517: 
 1518:       } else {
 1519: 
 1520:          double dragcoef;
 1521: 
 1522:          if constexpr(iwind_form == -1) {
 1523:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1524:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1525: 
 1526:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1527:             tau = cff*u_air;
 1528:  
 1529:          } else if constexpr(iwind_form == 1) {
 1530:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1531:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1532: 
 1533:             dragcoef = max(dragcoef, 4.0e-4);
 1534:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1535:             tau = cff*u_air;
 1536: 
 1537:          } else {
 1538:             tau = {0.0, 0.0};
 1539:          }
 1540:       }
 1541:    }
 1542: 
 1543: 
 1544:    __device__ void setFrame(double lat, double lon) {
 1545:       if constexpr(ics == 1) return;
 1546: 
 1547:       frame.update(lat, lon);        
 1548:     }
 1549: 
 1550:    //__device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1551: 
 1552:    __device__ double sigmaTransitionDepth(void) const;
 1553: 
 1554:    __device__ double computeETP(int idxTidalPotential, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const;
 1555: 
 1556:    __inline__ __device__ Point2 outputCoords(void) const {
 1557:       if constexpr(ics == 1)  return p;
 1558:       else                    return {rad2deg*lon, rad2deg*lat};
 1559:    }
 1560: 
 1561:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1562:    // If ics == 2, convert the global point to the local frame
 1563:       
 1564:       if constexpr (ics == 1) {
 1565:          return p;
 1566:       } else {
 1567:          const Point3 c = {p.x, p.y, gz};
 1568:          const Point3 local = frame.G2L(p - c);
 1569:          return local;
 1570:       }
 1571:    }
 1572: 
 1573:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1574:    // If ics == 2, convert the global point to the local frame
 1575:       
 1576:       if constexpr (ics == 1) {
 1577:          return p;
 1578:       } else {
 1579:          const Point3 c = {p.x, p.y, gz};
 1580:          return c + frame.L2G(p);
 1581:       }
 1582:    }
 1583: 
 1584:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1585:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1586:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1587:    
 1588:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1589: 
 1590:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1591: 
 1592:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1593:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1594: 
 1595:    __device__ __forceinline__ void clearMatrixRow(void) {
 1596:       // Clear the matrix row for this node
 1597: 
 1598: 
 1599:       coeffDiag = 0.0;
 1600: 
 1601:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1602: 
 1603:    }
 1604: 
 1605:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1606:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1607:       
 1608:       if (node == this) {
 1609:          coeffDiag += value;
 1610:      
 1611:       } else {
 1612:          // Search (linearly) the index of the node in the array of nodes
 1613:          // XXX: This is not efficient, see if we can improve this
 1614:          int i;
 1615:          for (i = 0; i < numNodes; i++) {
 1616:             if (nodes[i] == node) {
 1617:                break;
 1618:             }
 1619:          }
 1620:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1621:          coeffMatrix[i] += value;
 1622:       }
 1623:    }
 1624: 
 1625: 
 1626:    __device__ __inline__ void updateZCoordData(void);
 1627: 
 1628:    __device__ __forceinline__ double compZCoord(int k) const;
 1629: 
 1630:    __device__ void updateKb(void);
 1631: 
 1632:    __device__ __forceinline__ void computeBottomDragCd(void);
 1633: 
 1634: 
 1635: 
 1636: };
