 3753: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3754:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3755:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3756:    // 
 3757:    // This kernel is called for all nodes.
 3758: 
 3759: 
 3760:    NODE(node1);
 3761: 
 3762: 
 3763:    node1->clearMatrixRow();
 3764:    node1->qel = 0.0;
 3765: 
 3766:    // THIS IS FOR STRUCTURES XXX
 3767:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3768: 
 3769:    
 3770:    for (int j=0; j<node1->numElements; j++) {
 3771:       // For each element connected to the node...
 3772: 
 3773:       Element *elem = node1->elements[j];
 3774: 
 3775:       // Compute the average gravity
 3776:       const double grav3 = elem->mean(&Node::grav2);
 3777: 
 3778:       // Look at the documentation for the description of the terms in the following integrals
 3779: 
 3780:       // Integral I_1 
 3781:       // \bar{\breve{H}} 
 3782:       const double hhatb = elem->mean(&Side::hhat);        
 3783: 
 3784:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3785: 
 3786:       const int id1 = elem->nodeLocalIdx(node1); 
 3787:       const double area = elem->area;
 3788: 
 3789:       if (elem->isTri()) {
 3790: 
 3791:          // To clarify the notation in this section: 
 3792:          //   i stands for the node under consideration (node1)
 3793:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3794:          const int id2 = elem->nxq(1 + id1);
 3795:          const int id3 = elem->nxq(2 + id1);
 3796:          Node *node2 = elem->nodes[id2];
 3797:          Node *node3 = elem->nodes[id3];
 3798: 
 3799:          const Point2 x1 = node1->p2();
 3800:          const Point2 x2 = node2->p2();
 3801:          const Point2 x3 = node3->p2();
 3802: 
 3803:          // integral of phi_i*phi_j
 3804:          const double ipp_ii = (1.0/6.0 )*area;
 3805:          const double ipp_ij = (1.0/12.0)*area;
 3806:          const double ipp_ik = (1.0/12.0)*area;
 3807: 
 3808:          // integral of [(grad phi_i) * (grad phi_j)]
 3809:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3810:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3811:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3812: 
 3813:          // Computes the different components of integral I_1 of each node with respect to node i.
 3814:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3815:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3816:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3817: 
 3818:          node1->addToSparseMatrix(node1, I1_ii);
 3819:          node1->addToSparseMatrix(node2, I1_ij); 
 3820:          node1->addToSparseMatrix(node3, I1_ik);
 3821: 
 3822:       }
 3823:       else { // Quad
 3824:          // XXX IMPLEMENT THIS
 3825:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3826: 
 3827:          // To clarify the notation in this section: 
 3828:          //   i stands for the node under consideration (node1)
 3829:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3830:          const int id2 = elem->nxq(1 + id1);
 3831:          const int id3 = elem->nxq(2 + id1);
 3832:          const int id4 = elem->nxq(3 + id1);
 3833:          Node *node2 = elem->nodes[id2];
 3834:          Node *node3 = elem->nodes[id3];
 3835:          Node *node4 = elem->nodes[id4];         
 3836: 
 3837:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3838:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3839:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3840:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3841:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3842: 
 3843:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3844:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3845:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3846:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3847:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3848: 
 3849:          // Computes the different components of integral I_1 of each node with respect to node i.
 3850:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3851:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3852:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3853:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3854: 
 3855:          node1->addToSparseMatrix(node1, I1_ii);
 3856:          node1->addToSparseMatrix(node2, I1_ij); 
 3857:          node1->addToSparseMatrix(node3, I1_ik);
 3858:          node1->addToSparseMatrix(node4, I1_il);
 3859:   
 3860: 
 3861: 
 3862:       
 3863:       } 
 3864: 
 3865:  
 3866:       // Integral I_4
 3867:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3868:       // Where
 3869:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3870: 
 3871:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3872:       // of U over the element.
 3873:       Vector2 Umean = {0.0, 0.0};
 3874:       for (int m=0; m<elem->i34; m++) {      
 3875:          const Side *side = elem->sides[m];
 3876: 
 3877:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3878:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3879:       }
 3880:       Umean = Umean/elem->i34;
 3881: 
 3882:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3883: 
 3884:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3885:       const double I_4_1 = dot(gradPhi_1, Umean);
 3886: 
 3887:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3888:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3889:      
 3890:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3891: 
 3892:       // Additional terms 
 3893:       double vnorm = 0.0;
 3894:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3895:          Vector3 ubed;
 3896:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3897: 
 3898:          Vector3 gradP = {0.0, 0.0, 1.0};
 3899:          for (int m=0; m < elem->i34; m++) {
 3900:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3901:            gradP += toVector3(gradP_2D, 0.0);
 3902:          }   
 3903:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3904:       } // imm==2
 3905: 
 3906:       if (elem->isTri()) {
 3907:          for (int l=0; l<3; l++) {
 3908:             double fac;
 3909: 
 3910:             Node *node = elem->nodes[l];
 3911: 
 3912:             fac = (node == node1) ? 2.0 : 1.0;
 3913:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3914:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3915: // printf("AAA>>>  (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm) = %.15e\n",  (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm));
 3916:            
 3917:          }
 3918: 
 3919: 
 3920:          if (!elem->isDry) {
 3921:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3922: 
 3923:           node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3924: 
 3925:          }
 3926: 
 3927:       } // isTri
 3928:       else { // isQuad
 3929:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3930:          // for (int l=0; l<4; l++) {
 3931:          //   const Node *node = elem->nodes[l];
 3932: 
 3933:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3934:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3935: 
 3936:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3937:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3938:          // }
 3939: 
 3940:       } // isQuad
 3941: 
 3942: 
 3943:      node1->qel += (dt/elem->i34)*elem->vsource;
 3944:       
 3945: 
 3946:    } // for all elements connected to the node
 3947:    
 3948: 
 3949:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3950:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3951:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3952:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3953:       // If it is an open boundary node...
 3954: 
 3955:       // At least one open bnd side, maybe two
 3956:       for (int l=0; l<2; l++) { 
 3957: 
 3958:          // Gets each of the sides sharing the node. 
 3959:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3960: 
 3961: printf("l = %d, sideBnd = %p\n", l, sideBnd);         
 3962: 
 3963:          // if (sideBnd == nullptr) continue; // Skip if no boundary side
 3964: 
 3965:          
 3966: 
 3967:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3968:          if (sideBnd != nullptr) {
 3969:             // If the side is on a boundary...
 3970: 
 3971:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3972: 
 3973:             // Get the boundary segment
 3974:             const BoundarySegment *sideSegment = sideBnd->segment;
 3975:             const Side *side = sideBnd->side;
 3976: 
 3977:             // Integral I_3
 3978:             if (sideSegment->ifltype != 0) {
 3979:             // Natural or Flather b.c.
 3980: 
 3981:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3982:                // especially for Flather b.c.
 3983:                double ri3 = 0.0;
 3984:                if (!side->isDry) {
 3985:                   // If the side is not dry
 3986:                   
 3987:                   // Computes the side flux of (uth, vth)
 3988:                   double Vn = 0.0;
 3989:                   for (int k = side->kb; k<nvrt-1; k++) {
 3990:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3991:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3992: 
 3993:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3994:                   }
 3995: printf("side->idx = %d, side->len = %f, Vn = %f\n",  side->idx, side->len, Vn);
 3996:                   ri3 = 0.5*side->len*Vn;
 3997:                }
 3998: 
 3999:                if (sideSegment->ifltype == -1) { // Flather 1
 4000: 
 4001:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4002:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4003: 
 4004:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4005:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4006:                   
 4007:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4008:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4009: 
 4010:                } 
 4011:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4012:                   // Reset ri3
 4013:                   ri3 = 0.0;
 4014: 
 4015:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4016: 
 4017:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4018: 
 4019:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4020:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4021: 
 4022:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4023:                   node1->addToSparseMatrix(node1, con0*2.0);
 4024:                   node1->addToSparseMatrix(node2, con0);
 4025: 
 4026:                } // if Flather or Discharge
 4027: 
 4028: // printf("node1 = %p, thetai = %f, dt = %f, ri3 = %f\n", node1, thetai, dt, ri3);
 4029:                node1->qel -= thetai*dt*ri3;
 4030: 
 4031: 
 4032:             } // I_3
 4033:           
 4034: 
 4035:             // Integral I_5
 4036:             if(!side->isDry) {
 4037: 
 4038:                const double Unbar = dot(side->U, side->n);
 4039:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 4040: 
 4041:             } // I_5
 4042: 
 4043:          } // if is boundary side
 4044: 
 4045:       } // for l
 4046: 
 4047:    } // if isbnd
 4048: 
 4049: 
 4050: }
 4051: 
 4052: 
 4053: 
 4054: extern "C" {
 4055:    __global__ void rollUpElevation(void) {
 4056: 
 4057:       NODE(node);
 4058: 
 4059:       node->eta1 = node->eta2;
 4060: 
 4061:    }
 4062: 
 4063: 
 4064:    __global__ void backtrackAllNodes(void) {
 4065: 
 4066:       // max/min # of sub-divisions
 4067:       const int ndelt_max = max(1.0, dt/dtb_min);
 4068:       const int ndelt_min = max(1.0, dt/dtb_max); 
 4069: 
 4070:       // Removed all references to swild98 XXX
 4071:       // swild98=0.d0 !init
 4072: 
 4073: 
 4074:       SIDE(side);
 4075: 
 4076:       const int kb = side->kb;
 4077: 
 4078: 
 4079:       // Initialize btrack velocities to the actual velocities at the side 
 4080:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4081: 
 4082:       if (side->isDry) return;
 4083: 
 4084: 
 4085:       // Checks that at least one element is not dry
 4086:       const Element *elem1 = side->elems[0];
 4087:       const Element *elem2 = side->elems[1];
 4088: 
 4089: 
 4090:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4091:       
 4092:       // XXXXXX
 4093:       // !swild_tmp to store global coord. of the starting side
 4094:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4095:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4096:       // !Use sframe2 
 4097:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4098: 
 4099: 
 4100:       for (int k = kb; k < nvrt; k++) {
 4101:       //  Initialize (xt,yt,zt), nnel and vel.
 4102:       //  For ics=2, the coordinates are in local frames
 4103:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 4104: 
 4105: 
 4106:          const int iadvf = side->iadv();  // Advection flag
 4107: 
 4108:          Point3 xt;
 4109:          if constexpr(ics==1) {
 4110:             xt = side->center3D(k); 
 4111:          }
 4112:          else // lat/lon; in side lat/lon frame
 4113:          {
 4114:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 4115:          // XXX IMPLEMENT THIS
 4116:       //          xt=0.d0
 4117:       //          yt=0.d0
 4118:       //          !centroid coord. for nudging
 4119:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 4120:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 4121:          }  // ics
 4122: 
 4123: 
 4124: 
 4125:          // If on land or open boundary...
 4126:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 4127:          
 4128:          const double vmag = length(side->u2[k]);
 4129: 
 4130:          if (vmag <= velmin_btrack) {
 4131:             // No activity 
 4132: 
 4133:             side->btu[k] = side->u2[k];
 4134:             
 4135:          } else {  // do btrack
 4136: 
 4137:             // Compute number of sub-divisions based on local gradients 
 4138:             // XXX IS THIS NECESSARY?
 4139:             double suma = 0.0;
 4140:             int icount = 0;
 4141:             for (int ii=0; ii<2; ii++) {
 4142: 
 4143:                const Element *elem = side->elems[ii];
 4144:                  
 4145:                if (elem == nullptr) continue;
 4146: 
 4147:                icount++;
 4148: 
 4149:                // Not strictly along z; in ll frame for ics=2
 4150: 
 4151:                double utmp[4];
 4152:                double vtmp[4];
 4153:                for (int jj = 0; jj < elem->i34; jj++) {
 4154: 
 4155:                   const Node *node = elem->nodes[jj];
 4156: 
 4157:                   if constexpr(ics==1) {
 4158:                      utmp[jj] = node->u2[k].x;
 4159:                      vtmp[jj] = node->u2[k].y;  
 4160:                   } else {
 4161:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 4162:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 4163:                   }
 4164:                } // for jj
 4165: 
 4166:                const Vector2 grad_u = elem->grad2(utmp); 
 4167:                const Vector2 grad_v = elem->grad2(vtmp);
 4168: 
 4169:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4170:             } // for ii
 4171: 
 4172:             assert(icount > 0 && "Impossible 77");
 4173: 
 4174:             // '4' is somewhat arbitrary
 4175:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4176: 
 4177:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4178:          
 4179: 
 4180:             Vector3 u_int = {0.0, 0.0, 0.0};
 4181: 
 4182:             side->btrack(k, dt, dtbk, u_int);
 4183:             side->btu[k] = toVector2(u_int);
 4184:                
 4185:          } // if vmag (do backtrack)
 4186: 
 4187:       } // for k=kb,nvrt-1
 4188: 
 4189:    }
 4190: 
 4191: } // extern "C"
 4192: 
 4193: template<int nc>
 4194: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4195: 
 4196: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4197: //
 4198: // a,b,c,rhs: input vectors and are not modified by this program.
 4199: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4200: // rhs is the r.h.s.
 4201: // n: actual rank of the system.
 4202: // rows in u() and rhs();
 4203: // u: output with nc columns (transposed to rows)
 4204: // gam: a working array.
 4205: //
 4206: // NOTES:
 4207: // This is a template function that allows for different numbers of columns in the rhs vector.
 4208: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4209: 
 4210:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4211:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4212: 
 4213:    double bet = b[0];
 4214:    if constexpr (nc == 1) {
 4215:       u[0] = rhs[0]/bet;
 4216:    } else {
 4217:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4218:    }
 4219: 
 4220:    for (int j = 1; j < n; j++) {
 4221:       gam[j] = c[j - 1]/bet;
 4222:       bet = b[j] - a[j]*gam[j];
 4223: 
 4224:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4225: 
 4226:       if constexpr (nc == 1) {
 4227:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4228:       } else {
 4229:          for (int l = 0; l < nc; l++) {
 4230:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4231:          }
 4232:       }
 4233:    }
 4234: 
 4235:    // Back-substitution
 4236:    for (int j = n - 2; j >= 0; j--) {
 4237:       if constexpr (nc == 1) {
 4238:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4239:       } else {
 4240:          for (int l = 0; l < nc; l++) {
 4241:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4242:          }
 4243:       }
 4244:    }
 4245: }
 4246: 
 4247: 
 4248: 
 4249: // Helper function that contains the core algorithm
 4250: template<typename XAccessor, typename YAccessor>
 4251: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4252:                                     double  yp_top, double  yp_bot, 
 4253:                                     CubicSpline &spline) {
 4254:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4255:    // 
 4256:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4257:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4258:    //
 4259:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4260:    // 
 4261:    // Inputs: 
 4262:    //            n: dimension for x etc; # of data pts (>=2);
 4263:    //            getX, getY: functions to access x,y coordinates
 4264:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4265:    //     Output: 
 4266:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4267: 
 4268:    const int n = k2 - k1 + 1;
 4269:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4270: 
 4271:    // Allocate memory for the splines
 4272:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4273:    spline.x   = new double[n];
 4274:    spline.y   = new double[n];
 4275:    spline.yp  = new double[n];
 4276:    spline.ypp = new double[n];
 4277: 
 4278:    for (int k=k1; k<=k2; k++) {
 4279:       spline.x[k] = getX(k);
 4280:       spline.y[k] = getY(k);
 4281:    }
 4282: 
 4283:    // This is to simplify expressions later
 4284:    double *x = spline.x;
 4285:    double *y = spline.y;
 4286: 
 4287:    double *a = nullptr;
 4288:    double *b = nullptr;
 4289:    double *c = nullptr;
 4290:    double *gam = nullptr;
 4291:    double *rhs = nullptr;
 4292:    
 4293: 
 4294:       a = new double[n];   // Lower diagonal
 4295:       b = new double[n];   // Diagonal
 4296:       c = new double[n];   // Upper diagonal
 4297:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4298:       rhs = new double[n]; // Right-hand side
 4299: 
 4300:    for (int k=k1; k<=k2; k++) {
 4301:       if (k == k1) {
 4302:          // Bottom level
 4303:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4304:          b[k] = (x[k+1] - x[k])/3.0;
 4305:          c[k] = b[k]/2.0;
 4306:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4307:       } else if (k == n - 1) {
 4308:          // Top level (surface)
 4309:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4310:          b[k] = (x[k] - x[k-1])/3.0;
 4311:          a[k] = b[k]/2.0;
 4312:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4313:       } else {
 4314:          // Intermediate levels
 4315:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4316:          b[k] = (x[k+1] - x[k-1])/3.0;
 4317:          a[k] = (x[k  ] - x[k-1])/6.0;
 4318:          c[k] = (x[k+1] - x[k  ])/6.0;
 4319:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4320:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4321:       }
 4322:    }
 4323: 
 4324:    // Solve the tridiagonal system
 4325:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4326:    
 4327:    spline.yp[k1] = yp_bot;
 4328:    spline.yp[k2] = yp_top;
 4329: 
 4330:    // Compute rest of 1st derivatives using the splines
 4331:    for (int k=k1+1; k<k2; k++) {
 4332:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4333:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4334:    }
 4335:    
 4336:    delete[] a;
 4337:    delete[] b;
 4338:    delete[] c;
 4339:    delete[] gam;
 4340:    delete[] rhs;
 4341: 
 4342: }
 4343: 
 4344: // Array version
 4345: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4346:                                 double y_top, double y_bot, 
 4347:                                 CubicSpline &spline) {
 4348:    auto getX = [x] (int k) { return x[k]; };
 4349:    auto getY = [y] (int k) { return y[k]; };
 4350:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4351: }
 4352: 
 4353: // Lambda version - allows custom access patterns
 4354: template<typename XFunc, typename YFunc>
 4355: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4356:                                 double y_top, double y_bot,
 4357:                                 CubicSpline &spline) {
 4358:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4359: }
 4360: 
 4361: 
 4362: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 4363: {
 4364:    assert("Not implemented");
 4365: 
 4366:    return 0.0;
 4367: }
