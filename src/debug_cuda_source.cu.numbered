  756: 
  757:    __device__ Vector2 grad2(double *a) const
  758:    {
  759:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  760:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  761:       if (isQuad()) {
  762:          gx += a[3]*gradPhi[3].x;
  763:          gy += a[3]*gradPhi[3].y;
  764:       }
  765:       return {gx, gy};
  766:    }
  767: 
  768:    __device__ Vector2 grad2(double Node::* field) const
  769:    {
  770:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  771:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  772:       if (isQuad()) {
  773:          gx += (nodes[3]->*field)*gradPhi[3].x;
  774:          gy += (nodes[3]->*field)*gradPhi[3].y;
  775:       }
  776:       return {gx, gy};
  777:    }
