10015: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
10016:    Element *elems = mesh->localElemData;
10017: 
10018:    *addr = elems;
10019:    *sizeElement = sizeof(Element);
10020:    switch (varCode) {
10021:       case (int)VarCode::z:
10022:          *offset = (int)((char*)&elems[0].z - (char*)elems);
10023:          *sizeType = sizeof(double);
10024:          break;
10025:       case (int)VarCode::x:
10026:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
10027:          *sizeType = sizeof(Vector2);
10028:          break;
10029:       case (int)VarCode::gradETP:
10030:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
10031:          *sizeType = sizeof(Vector2);
10032:          break;
10033:       case (int)VarCode::area:
10034:          *offset = (int)((char*)&elems[0].area - (char*)elems);
10035:          *sizeType = sizeof(double);
10036:          break;
10037:       case (int)VarCode::depth:
10038:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
10039:          *sizeType = sizeof(double);
10040:          break;
10041:       case (int)VarCode::radius:
10042:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
10043:          *sizeType = sizeof(double);
10044:          break;
10045:       case (int)VarCode::ghat:
10046:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
10047:          *sizeType = sizeof(Vector2);
10048:          break;
10049:       case (int)VarCode::kb:
10050:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
10051:          *sizeType = sizeof(int);
10052:          break;
10053:       case (int)VarCode::isdry:
10054:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
10055:          *sizeType = sizeof(int);
10056:          break;            
10057:       case (int)VarCode::w:
10058:          *offset = (int)((char*)&elems[0].w - (char*)elems);
10059:          *sizeType = sizeof(double);
10060:          break;
10061:       case (int)VarCode::FaceIndices:
10062:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
10063:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
10064:          *sizeType = sizeof(Node);
10065:          break;
10066:       default:
10067:          *offset = -1;
10068:    }
10069: }
