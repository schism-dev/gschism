 1648: // Helper functions for computing the local node index at a given offset from another.
 1649: __device__ __inline__ int nxq(int offset, int index, int size) {
 1650:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1651:    // to the index to make it positive
 1652:    assert(index + offset + 16*size >= 0);
 1653:    return (index + offset + 16*size) % size;  
 1654: }
 1655: 
 1656: __device__ __inline__ int nxq(int index, int size) {
 1657:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1658:    // to the index to make it positive
 1659:    assert(index + 16*size >= 0);
 1660:    return (index + 16*size) % size; 
 1661: }
