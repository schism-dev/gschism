 3410: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3411:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3412:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3413:    // 
 3414:    // This kernel is called for all nodes.
 3415: 
 3416: 
 3417:    NODE(node1);
 3418: 
 3419: 
 3420:    node1->clearMatrixRow();
 3421:    node1->qel = 0.0;
 3422: 
 3423:    // THIS IS FOR STRUCTURES XXX
 3424:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3425: 
 3426:    
 3427:    for (int j=0; j<node1->numElements; j++) {
 3428:       // For each element connected to the node...
 3429: 
 3430:       Element *elem = node1->elements[j];
 3431: 
 3432:       // Compute the average gravity
 3433:       const double grav3 = elem->mean(&Node::grav2);
 3434: 
 3435:       // Look at the documentation for the description of the terms in the following integrals
 3436: 
 3437:       // Integral I_1 
 3438:       // \bar{\breve{H}} 
 3439:       const double hhatb = elem->mean(&Side::hhat);        
 3440: 
 3441:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3442: 
 3443:       const int id1 = elem->nodeLocalIdx(node1); 
 3444:       const double area = elem->area;
 3445: 
 3446:       if (elem->isTri()) {
 3447: 
 3448:          // To clarify the notation in this section: 
 3449:          //   i stands for the node under consideration (node1)
 3450:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3451:          const int id2 = elem->nxq(1 + id1);
 3452:          const int id3 = elem->nxq(2 + id1);
 3453:          Node *node2 = elem->nodes[id2];
 3454:          Node *node3 = elem->nodes[id3];
 3455: 
 3456:          const Point2 x1 = node1->p;
 3457:          const Point2 x2 = node2->p;
 3458:          const Point2 x3 = node3->p;
 3459: 
 3460:          // integral of phi_i*phi_j
 3461:          const double ipp_ii = (1.0/6.0 )*area;
 3462:          const double ipp_ij = (1.0/12.0)*area;
 3463:          const double ipp_ik = (1.0/12.0)*area;
 3464: 
 3465:          // integral of [(grad phi_i) * (grad phi_j)]
 3466:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3467:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3468:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3469: 
 3470:          // Computes the different components of integral I_1 of each node with respect to node i.
 3471:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3472:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3473:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3474: 
 3475:          node1->addToSparseMatrix(node1, I1_ii);
 3476:          node1->addToSparseMatrix(node2, I1_ij); 
 3477:          node1->addToSparseMatrix(node3, I1_ik);
 3478: 
 3479:       }
 3480:       else { // Quad
 3481:          // XXX IMPLEMENT THIS
 3482:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3483: 
 3484:          // To clarify the notation in this section: 
 3485:          //   i stands for the node under consideration (node1)
 3486:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3487:          const int id2 = elem->nxq(1 + id1);
 3488:          const int id3 = elem->nxq(2 + id1);
 3489:          const int id4 = elem->nxq(3 + id1);
 3490:          Node *node2 = elem->nodes[id2];
 3491:          Node *node3 = elem->nodes[id3];
 3492:          Node *node4 = elem->nodes[id4];         
 3493: 
 3494:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3495:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3496:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3497:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3498:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3499: 
 3500:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3501:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3502:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3503:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3504:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3505: 
 3506:          // Computes the different components of integral I_1 of each node with respect to node i.
 3507:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3508:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3509:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3510:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3511: 
 3512:          node1->addToSparseMatrix(node1, I1_ii);
 3513:          node1->addToSparseMatrix(node2, I1_ij); 
 3514:          node1->addToSparseMatrix(node3, I1_ik);
 3515:          node1->addToSparseMatrix(node4, I1_il);
 3516:   
 3517: 
 3518: 
 3519:       
 3520:       } 
 3521: 
 3522:  
 3523:       // Integral I_4
 3524:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3525:       // Where
 3526:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3527: 
 3528:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3529:       // of U over the element.
 3530:       Vector2 Umean = {0.0, 0.0};
 3531:       for (int m=0; m<elem->i34; m++) {      
 3532:          const Side *side = elem->sides[m];
 3533: 
 3534:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3535:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3536:       }
 3537:       Umean = Umean/elem->i34;
 3538: 
 3539:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3540: 
 3541:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3542:       const double I_4_1 = dot(gradPhi_1, Umean);
 3543: 
 3544:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3545:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3546:      
 3547:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3548: 
 3549:       // Additional terms 
 3550:       double vnorm = 0.0;
 3551:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3552:          Vector3 ubed;
 3553:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3554: 
 3555:          Vector3 gradP = {0.0, 0.0, 1.0};
 3556:          for (int m=0; m < elem->i34; m++) {
 3557:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3558:            gradP += toVector3(gradP_2D, 0.0);
 3559:          }   
 3560:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3561:       } // imm==2
 3562: 
 3563:       if (elem->isTri()) {
 3564:          for (int l=0; l<3; l++) {
 3565:             double fac;
 3566: 
 3567:             Node *node = elem->nodes[l];
 3568: 
 3569:             fac = (node == node1) ? 2.0 : 1.0;
 3570:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3571:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3572:            
 3573:          }
 3574: 
 3575: 
 3576:          if (!elem->isDry) {
 3577:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3578: 
 3579:           node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3580: 
 3581:          }
 3582: 
 3583:       } // isTri
 3584:       else { // isQuad
 3585:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3586:          // for (int l=0; l<4; l++) {
 3587:          //   const Node *node = elem->nodes[l];
 3588: 
 3589:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3590:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3591: 
 3592:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3593:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3594:          // }
 3595: 
 3596:       } // isQuad
 3597: 
 3598: 
 3599:      node1->qel += (dt/elem->i34)*elem->vsource;
 3600:       
 3601: 
 3602:    } // for all elements connected to the node
 3603:    
 3604: 
 3605:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3606:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3607:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3608:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3609:       // If it is an open boundary node...
 3610: 
 3611:       // At least one open bnd side, maybe two
 3612:       for (int l=0; l<2; l++) { 
 3613: 
 3614:          // Gets each of the sides sharing the node. 
 3615:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3616: 
 3617:          // if (sideBnd == nullptr) continue; // Skip if no boundary side
 3618:          
 3619: 
 3620:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3621:          if (sideBnd != nullptr) {
 3622:             // If the side is on a boundary...
 3623: 
 3624:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3625: 
 3626:             // Get the boundary segment
 3627:             const BoundarySegment *sideSegment = sideBnd->segment;
 3628:             const Side *side = sideBnd->side;
 3629: 
 3630:             // Integral I_3
 3631:             if (sideSegment->ifltype != 0) {
 3632:             // Natural or Flather b.c.
 3633: 
 3634:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3635:                // especially for Flather b.c.
 3636:                double ri3 = 0.0;
 3637:                if (!side->isDry) {
 3638:                   // If the side is not dry
 3639:                   
 3640:                   // Computes the side flux of (uth, vth)
 3641:                   double Vn = 0.0;
 3642:                   for (int k = side->kb; k<nvrt-1; k++) {
 3643:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3644:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3645: 
 3646:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3647:                   }
 3648: 
 3649:                   ri3 = 0.5*side->len*Vn;
 3650:                }
 3651: 
 3652:                if (sideSegment->ifltype == -1) { // Flather 1
 3653: 
 3654:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3655:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3656: 
 3657:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3658:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3659:                   
 3660:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3661:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3662: 
 3663:                } 
 3664:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3665:                   // Reset ri3
 3666:                   ri3 = 0.0;
 3667: 
 3668:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3669: 
 3670:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3671: 
 3672:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3673:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3674: 
 3675:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3676:                   node1->addToSparseMatrix(node1, con0*2.0);
 3677:                   node1->addToSparseMatrix(node2, con0);
 3678: 
 3679:                } // if Flather or Discharge
 3680: 
 3681: // printf("node1 = %p, thetai = %f, dt = %f, ri3 = %f\n", node1, thetai, dt, ri3);
 3682:                node1->qel -= thetai*dt*ri3;
 3683: 
 3684: 
 3685:             } // I_3
 3686:           
 3687: 
 3688:             // Integral I_5
 3689:             if(!side->isDry) {
 3690: 
 3691:                const double Unbar = dot(side->U, side->n);
 3692:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3693: 
 3694:             } // I_5
 3695: 
 3696:          } // if is boundary side
 3697: 
 3698:       } // for l
 3699: 
 3700:    } // if isbnd
 3701: 
 3702: 
 3703: }
 3704: 
 3705: 
 3706: extern "C" {
 3707:    __global__ void setupCGSolver(double* data, int* indices, int* indptr, double* b) {
 3708:       int off = 0;
 3709:       for (int i = 0; i < mesh->np; i++) {
 3710: 
 3711:          const Node *node = mesh->localNodeData + i;
 3712:          indptr[i] = off;
 3713: 
 3714:          // Diagonal first
 3715:          data[off]    = node->coeffDiag;
 3716:          indices[off] = i;
 3717:          ++off;
 3718:          // printf("i = %d, off = %d, node->nodes[i] = %p\n", i, off, node->nodes[i]);
 3719:          // Off-diagonals
 3720:          for (int k = 0; k < node->numNodes; ++k) {
 3721:             const Node* nb = node->nodes[k];
 3722:             // printf("i = %d, k = %d, nb = %p\n", i, k, nb);
 3723:             // Map pointer -> column index by pointer arithmetic
 3724:             int j = nb->idx;
 3725:             // (optionally: if (j == i) data[diag_off] += nd.coeffMatrix[k]; else …)
 3726:             data[off]    = node->coeffMatrix[k];
 3727:             indices[off] = j;
 3728:             ++off;
 3729:             // printf("i = %d, j = %d, off = %d, data[off] = %f\n", i, j, off, data[off]);
 3730:          }
 3731: 
 3732:          // RHS
 3733:          b[i] = node->qel;
 3734:       }
 3735: 
 3736:       indptr[mesh->np] = off;
 3737:    }
 3738:    
 3739: }
 3740: 
 3741: extern "C" {
 3742:    __global__ void setupCGSolver2(double* diag, double* data, int* indices, int* indptr, double* b) {
 3743:       NODE(node);
 3744:       const int idx = node->idx;
 3745:       // Computes the index in the nzz array
 3746: 
 3747:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 3748: 
 3749:       indptr[idx] = nzzIdx;
 3750:       data[nzzIdx]    = node->coeffDiag;
 3751:       indices[nzzIdx] = idx;
 3752: 
 3753:       for (int k = 0; k < node->numNodes; ++k) {
 3754:          const Node* nb = node->nodes[k];
 3755: 
 3756:          int j = nb->idx;
 3757:          // (optionally: if (j == i) data[diag_off] += nd.coeffMatrix[k]; else …)
 3758:          data[nzzIdx + k + 1]    = node->coeffMatrix[k];
 3759:          indices[nzzIdx + k + 1] = j;
 3760:       }
 3761: 
 3762:       diag[idx] = 1.0/node->coeffDiag;
 3763:       b[idx] = node->qel;
 3764:    }
 3765: }
