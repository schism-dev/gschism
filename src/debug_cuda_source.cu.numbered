 8523: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 8524:    Node *nodes = mesh->localNodeData;
 8525: 
 8526:    *addr = nodes;
 8527:    *sizeNode = sizeof(Node);
 8528: 
 8529:    switch (varCode) {
 8530:       case (int)VarCode::depth:
 8531:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 8532:          *sizeType = sizeof(double);
 8533:          break;
 8534:       case (int)VarCode::eta:
 8535:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 8536:          *sizeType = sizeof(double);
 8537:          break;
 8538:       case (int)VarCode::x:
 8539:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 8540:          *sizeType = sizeof(Vector2);
 8541:          break;
 8542:       case (int)VarCode::z:
 8543:          *offset = (int)((char*)&nodes[0].z - (char*)nodes);
 8544:          *sizeType = sizeof(double);
 8545:          break;
 8546:       case (int)VarCode::kb:
 8547:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 8548:          *sizeType = sizeof(int);
 8549:          break;
 8550:       case (int)VarCode::isdry:
 8551:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 8552:          *sizeType = sizeof(int);
 8553:          break;         
 8554:       case (int)VarCode::w:
 8555:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 8556:          *sizeType = sizeof(double);
 8557:          break;
 8558:       case (int)VarCode::u:
 8559:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 8560:          *sizeType = sizeof(Vector2);
 8561:          break;  
 8562:       case (int)VarCode::u_air:
 8563:          *offset = (int)((char*)&nodes[0].u_air - (char*)nodes);
 8564:          *sizeType = sizeof(Vector2);
 8565:          break;
 8566:       default:
 8567:          *offset = -1;    
 8568:    }  
 8569:    
 8570: }
