 2175:    template<typename T>
 2176:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 2177:       // Get the values of the field at the nodes of the element
 2178:       res[0] = nodes[0]->*field;
 2179:       res[1] = nodes[1]->*field;
 2180:       res[2] = nodes[2]->*field;
 2181:       if (isQuad()) res[3] = nodes[3]->*field;
 2182:       else          res[3] = T();
 2183:    }
 2184: 
 2185:    template<typename T>
 2186:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 2187: 
 2188:       assert(level < nvrt && "Level is out of range");
 2189:       // Get the values of the field at the nodes of the element
 2190:       res[0] = (nodes[0]->*field)[max(level, nodes[0]->kb)];
 2191:       res[1] = (nodes[1]->*field)[max(level, nodes[1]->kb)];
 2192:       res[2] = (nodes[2]->*field)[max(level, nodes[2]->kb)];
 2193:       if (isQuad()) res[3] = (nodes[3]->*field)[max(level, nodes[3]->kb)];
 2194:       else          res[3] = T();
 2195:    }    
 2196: 
 2197:    template<typename T>
 2198:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
 2199: 
 2200:       assert(level < nvrt && "Level is out of range");
 2201: 
 2202:       // Get the values of the func at the nodes of the element
 2203:       res[0] = (nodes[0]->*func)(max(level, nodes[0]->kb));
 2204:       res[1] = (nodes[1]->*func)(max(level, nodes[1]->kb));
 2205:       res[2] = (nodes[2]->*func)(max(level, nodes[2]->kb));
 2206:       if (isQuad()) res[3] = (nodes[3]->*func)(max(level, nodes[3]->kb));
 2207:       else          res[3] = T();  // This is 0.0 or a zero vector
 2208: 
 2209:    }      
