 9274: extern "C" __global__ void getElementVar(int varCode, void *res, int k) {
 9275:    ELEM(elem);
 9276: 
 9277:    switch (varCode) {
 9278:       case (int)VarCode::outputCoords: {
 9279:          const Point2 coords = elem->outputCoords();
 9280:          double *out = (double *)((char *)res + idx_elem * 16);
 9281:          out[0] = coords.x;
 9282:          out[1] = coords.y;
 9283:          break;
 9284:       }
 9285:       case (int)VarCode::FaceIndices: {
 9286:          uintptr_t *out = (uintptr_t *)((char *)res + idx_elem * 32);
 9287:          for (int j = 0; j < 4; j++)
 9288:             out[j] = (j < elem->i34 && elem->nodes[j]) ? elem->nodes[j]->idx + 1 : -1;
 9289:          break;
 9290:       }
 9291:       case (int)VarCode::isdry:
 9292:          *(int *)((char *)res + idx_elem * 4) = (int)elem->isDry;
 9293:          break;
 9294:       case (int)VarCode::w: {
 9295:          double *out = (double *)((char *)res + idx_elem * nvrt * 8);
 9296:          if (k >= 0)
 9297:             out[0] = elem->w[k];
 9298:          else
 9299:             for (int lev = 0; lev < nvrt; lev++)
 9300:                out[lev] = elem->w[lev];
 9301:          break;
 9302:       }
 9303:    }
 9304: }
