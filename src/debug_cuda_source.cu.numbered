 2304: __device__ inline void atomicAddInt16Unsafe(int16_t* address, int16_t val)
 2305: {
 2306:     uintptr_t p = (uintptr_t)address;
 2307:     assert((p & 1) == 0);
 2308: 
 2309:     unsigned int* base = (unsigned int*)(p & ~3);
 2310:     unsigned int addend = (p & 2) ? ((unsigned int)val << 16)
 2311:                                   :  (unsigned int)val;
 2312: 
 2313:     atomicAdd(base, addend);
 2314: }
