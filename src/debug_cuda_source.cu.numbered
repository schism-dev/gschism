  401: // Polynomial class
  402: template<int grade>
  403: struct Polynomial {
  404:     // Static assertion to give a clear error message at compile time
  405:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  406: };
  407: 
  408: 
  409: // Explicit specialization for grade 4
  410: template<>
  411: struct Polynomial<4> {
  412:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  413: 
  414:    // Constructor from coefficients
  415:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  416: 
  417:    __device__ __forceinline__ double eval(double x) const {
  418:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  419:    }
  420: };
