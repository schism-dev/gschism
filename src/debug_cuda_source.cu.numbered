  947:    // ------------------------------------------------------------------------------------------------
  948:    // These are functions that work on all nodes/sides of the element.
  949:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  950:    //
  951:    // An example of how to use these functions is:
  952:    //   
  953:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  954:    // 
  955:    // Where L is the level at which the field is to be interpolated. The field can be either
  956:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  957:    // There are different versions of getNodalValues for each of these cases.
  958: 
  959:    template<typename T>
  960:    __device__ __forceinline__ void getNodalValues(T Node::* field, T res[4]) const;
  961: 
  962:    template<typename T>
  963:    __device__ __forceinline__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const;
  964:   
  965:    template<typename T>
  966:    __device__ __forceinline__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const;
