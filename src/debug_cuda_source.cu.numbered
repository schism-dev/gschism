 3451: 
 3452: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3453: 
 3454:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3455:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3456:    const Node *n1 = side->n1;
 3457:    const Node *n2 = side->n2;
 3458: 
 3459:    bool n1_match = (n1->nodeBnd->segment == segment);
 3460:    bool n2_match = (n2->nodeBnd->segment == segment);
 3461: 
 3462:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3463:    if (n1_match && n2_match) {
 3464:       return 0.5;
 3465:    } else if (n1_match) {
 3466:       return 1.0;
 3467:    } else if (n2_match) {
 3468:       return 0.0;
 3469:    }
 3470: 
 3471:    return 0.0;
 3472: }
 3473: 
 3474: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3475: 
 3476: 
 3477: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 3478: 
 3479:    const double w1 = getBoundaryArrayValueWeight();
 3480:    const double w2 = 1.0 - w1;
 3481:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3482:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3483: 
 3484:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 3485: }
 3486: 
 3487: 
 3488: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 3489:    const double w1 = getBoundaryArrayValueWeight();
 3490:    const double w2 = 1.0 - w1;
 3491:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3492:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3493: 
 3494:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 3495: 
 3496: }
