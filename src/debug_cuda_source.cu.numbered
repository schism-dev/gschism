 1810: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1811:                                               double &t, double& tIntersect) {
 1812: 
 1813:    double closest_intersect_t = 1e10;
 1814:    bool found_intersection = false;
 1815: 
 1816: double minDelta = 1e10; 
 1817: double btt1 = 1e10, btt2;
 1818:    for (int i = 0; i < i34; i++) {
 1819: 
 1820:       Side *side2 = sides[i];
 1821: 
 1822:       // (x3,y3)-(x4,y4) is the element side line
 1823:       const Point2 x3 = side2->n1->p2();
 1824:       const Point2 x4 = side2->n2->p2();
 1825: 
 1826:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1827:       const double delta = cross(x2 - x1, x3 - x4);
 1828: 
 1829:       if (abs(delta) > 0) {
 1830: 
 1831:          const double delta1 = cross(x3 - x1, x3 - x4);
 1832:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1833: 
 1834:          // Solves the two linear equations for tt1 and tt2
 1835:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1836:          const double tt2 = delta2/delta;
 1837: 
 1838: if (abs(tt1) < abs(btt1)) {
 1839:    minDelta = abs(delta);
 1840:    btt1 = tt1;
 1841:    btt2 = tt2;
 1842: }
 1843: 
 1844: if (idx == 0) printf("RRRRRR delta = %e, delta1 = %e, delta2 = %e, tt1 = %e, tt2 = %e\n", delta, delta1, delta2, tt1, tt2);
 1845:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1846:             closest_intersect_t = min(closest_intersect_t, tt1);
 1847:             side = side2;
 1848:             nextElement = side->otherElem(this);
 1849:             t = tt2;
 1850:             tIntersect = max(small, min(tt1, 1.0-small));
 1851:             found_intersection = true;
 1852:          }
 1853:       
 1854:       }
 1855:       else {  // parallel segments
 1856:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1857:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1858: 
 1859:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1860: 
 1861:          // const double dist = dot(x1 - x3, side2->n);
 1862:          // if (abs(dist) < small*length(x3 - x4)) {
 1863:          //    const double2 unitarySide = normalize(x4 - x3);
 1864:          //    const double len = dot(x2 - x1, unitarySide);
 1865:          //    t = t + len;
 1866:          //    t = max(0.0, min(t, 1.0));
 1867:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1868: 
 1869: 
 1870:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1871:          //    // t = tt2;
 1872:          //    found_intersection = true;
 1873:          // }
 1874:       }
 1875: 
 1876: 
 1877:    }
 1878: 
 1879:    if (!found_intersection) {
 1880:       
 1881: if (idx == 0) printf("ZZ No intersection found:\n"
 1882:            "Element %d\n"
 1883:            "in = %d\n"
 1884:            "minDelta = %e\n"
 1885:            "tt1 = %e, tt2 = %e\n"
 1886:            "segment: (%f, %f)-(%f, %f)\n"
 1887:            "Vertices:\n"
 1888:          //   "  Nodes nextElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n"
 1889:            "  Nodes curElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n",
 1890:            IDX(nextElement),
 1891:            (btt1 >= -small && btt2 >= -small && btt2 <= 1.0 + small && btt1 <= 1.0 + small),
 1892:            minDelta,
 1893:            btt1, btt2,
 1894:            x1.x, x1.y,
 1895:            x2.x, x2.y,
 1896:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1897:          //   nextElement->nodes[1]->p.x, nextElement->nodes[1]->p.y,
 1898:          //   nextElement->nodes[2]->p.x, nextElement->nodes[2]->p.y,
 1899:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1900:            nodes[0]->p.x, nodes[0]->p.y,
 1901:            nodes[1]->p.x, nodes[1]->p.y,
 1902:            nodes[2]->p.x, nodes[2]->p.y,
 1903:            nodes[0]->p.x, nodes[0]->p.y);
 1904: 
 1905:    }
 1906: 
 1907:    // assert(found_intersection && "No intersection found");
 1908: 
 1909:    // found_intersection should always be true, since we checked all the sides.  
 1910:    return found_intersection;
 1911: }
