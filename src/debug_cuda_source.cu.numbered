 9648: 
 9649: extern "C" __global__ void getNodeVar(int varCode, void *res, int k) {
 9650:    // Packed local order into res. Caller allocates sizePart * nbytes.
 9651:    NODE(node);
 9652: 
 9653:    switch (varCode) {
 9654:       case (int)VarCode::outputCoords: {
 9655:          const Point2 coords = node->outputCoords();
 9656:          double *out = (double *)((char *)res + idx_node * 16);
 9657:          out[0] = coords.x;
 9658:          out[1] = coords.y;
 9659:          break;
 9660:       }
 9661:       case (int)VarCode::depth:
 9662:          *(double *)((char *)res + idx_node * 8) = node->depth;
 9663:          break;
 9664:       case (int)VarCode::kb:
 9665:          *(int *)((char *)res + idx_node * 4) = (int)node->kb;
 9666:          break;
 9667:       case (int)VarCode::eta:
 9668:          *(double *)((char *)res + idx_node * 8) = node->eta2;
 9669:          break;
 9670:       case (int)VarCode::u_air: {
 9671:          double *out = (double *)((char *)res + idx_node * 16);
 9672:          out[0] = node->u_air.x;
 9673:          out[1] = node->u_air.y;
 9674:          break;
 9675:       }
 9676:       case (int)VarCode::isdry:
 9677:          *(int *)((char *)res + idx_node * 4) = (int)node->isDry;
 9678:          break;
 9679:       case (int)VarCode::u: {
 9680:          double *out = (double *)((char *)res + idx_node * nvrt * 16);
 9681:          if (k >= 0) {
 9682:             out[0] = node->u2[k].x;
 9683:             out[1] = node->u2[k].y;
 9684:          } else {
 9685:             for (int lev = 0; lev < nvrt; lev++) {
 9686:                out[lev*2    ] = node->u2[lev].x;
 9687:                out[lev*2 + 1] = node->u2[lev].y;
 9688:             }
 9689:          }
 9690:          break;
 9691:       }
 9692:       case (int)VarCode::z: {
 9693:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9694:          if (k >= 0)
 9695:             out[0] = node->z[k];
 9696:          else
 9697:             for (int lev = 0; lev < nvrt; lev++)
 9698:                out[lev] = node->z[lev];
 9699:          break;
 9700:       }
 9701:       case (int)VarCode::w: {
 9702:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9703:          if (k >= 0)
 9704:             out[0] = node->w2[k];
 9705:          else
 9706:             for (int lev = 0; lev < nvrt; lev++)
 9707:                out[lev] = node->w2[lev];
 9708:          break;
 9709:       }
 9710:       case (int)VarCode::dfh: {
 9711:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9712:          if (k >= 0)
 9713:             out[0] = node->dfh[k];
 9714:          else
 9715:             for (int lev = 0; lev < nvrt; lev++)
 9716:                out[lev] = node->dfh[lev];
 9717:          break;
 9718:       }
 9719:       case (int)VarCode::dfv: {
 9720:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9721:          if (k >= 0)
 9722:             out[0] = node->dfv[k];
 9723:          else
 9724:             for (int lev = 0; lev < nvrt; lev++)
 9725:                out[lev] = node->dfv[lev];
 9726:          break;
 9727:       }
 9728:       case (int)VarCode::tke: {
 9729:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9730:          if (k >= 0)
 9731:             out[0] = getTKE(node->turb, k);
 9732:          else
 9733:             for (int lev = 0; lev < nvrt; lev++)
 9734:                out[lev] = getTKE(node->turb, lev);
 9735:          break;
 9736:       }
 9737:       case (int)VarCode::mxl: {
 9738:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9739:          if (k >= 0)
 9740:             out[0] = getMXL(node->turb, k);
 9741:          else
 9742:             for (int lev = 0; lev < nvrt; lev++)
 9743:                out[lev] = getMXL(node->turb, lev);
 9744:          break;
 9745:       }
 9746:       case (int)VarCode::temp: {
 9747:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9748:          if (k >= 0)
 9749:             out[0] = node->tracers[k].tracer[0];
 9750:          else
 9751:             for (int lev = 0; lev < nvrt; lev++)
 9752:                out[lev] = node->tracers[lev].tracer[0];
 9753:          break;
 9754:       }
 9755:       case (int)VarCode::salt: {
 9756:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9757:          if (k >= 0)
 9758:             out[0] = node->tracers[k].tracer[1];
 9759:          else
 9760:             for (int lev = 0; lev < nvrt; lev++)
 9761:                out[lev] = node->tracers[lev].tracer[1];
 9762:          break;
 9763:       }
 9764:    }
 9765: }
