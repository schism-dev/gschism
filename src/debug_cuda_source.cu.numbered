 2601:    template<typename T>
 2602:    __device__ __forceinline__ T Element::mean(int level, T (Node::* field)[nvrt]) const {
 2603:       T values[4];
 2604:       getNodalValues(level, field, values);
 2605: 
 2606:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2607:       if constexpr (IsVector2<T>::value && ics == 2) {
 2608: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2609:          projectNodeVectorsToElementFrame(values);
 2610: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2611:       }
 2612: 
 2613:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2614:    }
