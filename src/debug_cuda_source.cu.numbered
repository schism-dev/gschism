  987: struct Side {
  988: 
  989:    // Geometry information
  990:    int idx;               // Index of the side
  991:    Node *n1, *n2;
  992:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  993: 
  994:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
  995:    Point2 center;        // Location of side center. 
  996:    double zc[nvrt];       // Side center z-coord at each vertical level
  997: 
  998:    Frame frame;
  999: 
 1000:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
 1001:                           // this is nullptr
 1002:    
 1003:    int kb;                // Bottom index of the side
 1004:    bool isDry;            // True if the side is dry
 1005:  
 1006:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1007: 
 1008:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1009: 
 1010:    // Physical information
 1011:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1012:    Vector2 btu[nvrt];           // Back-tracked velocity
 1013:    Vector2 U;                   // Vertically averaged velocity vector  
 1014: 
 1015:    Vector2 nuGradU[nvrt];          // nu*grad u
 1016: 
 1017:    Vector2 bcc[nvrt];           // Baroclinic term
 1018:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1019: 
 1020:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1021:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1022:    Vector2 gradPr;               // Gradient of pressure
 1023:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1024: 
 1025: 
 1026:    double hhat;                 // \breve{H} in notes
 1027: 
 1028:    double shapiro;
 1029: 
 1030:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1031: 
 1032:    double coriolis;             // Coriolis parameter
 1033: 
 1034:    // Vegetation parameters
 1035:    double veg_c2;
 1036:    double veg_beta;
 1037: 
 1038:    // Bottom drag parameters.
 1039:    double chi;
 1040:    double chi2;
 1041: 
 1042:    __inline__ __device__ double x(double t, bool checkInterval = true) const;
 1043:    __inline__ __device__ double y(double t, bool checkInterval = true) const;
 1044:    __inline__ __device__ double lon(void) const;
 1045:    __inline__ __device__ double lat(void) const;
 1046:    __inline__ __device__ Point2 p_t(double t, bool checkInterval = true) const;
 1047: 
 1048:    __inline__ __device__ Point3 center3D(int k) const { assert(k < nvrt); return {center.x, center.y, zc[k]}; }
 1049:    __inline__ __device__ double Dz(int k)       const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1050:    __inline__ __device__ double area(int k)     const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1051: 
 1052: 
 1053:    __inline__ __device__ Vector3 interpolateCenterVelocityVertically(Point3 xt) const;
 1054: 
 1055:    __inline__ __device__ Side* neigh(int index) const { 
 1056:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1057:       assert(index >= 0 && index < 4); 
 1058:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1059: 
 1060:       const int ielem = index & 1;           // 0 or 1
 1061:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1062: 
 1063:       const Element* elem = elems[ielem];
 1064: 
 1065:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1066: 
 1067:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1068: 
 1069:    }
 1070: 
 1071:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1072: 
 1073:    
 1074:    __forceinline__ __device__ Vector2 t12(void) const { return {-n.y, n.x}; } // Unitary tangent vector from n1 to n2
 1075:    __forceinline__ __device__ Vector2 t21(void) const { return {n.y, -n.x}; } // Unitary tangent vector from n2 to n1
 1076:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1077:    __forceinline__ __device__ Vector2 t(const Node *node) const { if (node == n2) return t12(); else return t21(); } // Tangent vector towards node
 1078: 
 1079: 
 1080:    __forceinline__ __device__ double relativeSignedDistanceToPoint(Vector2 x) const {
 1081:       // Compute the relative (to the length) signed distance from the point to the side. It is positive if the point is to the side where n is pointing, negative otherwise.
 1082:       return dot(x - center, n)/len;
 1083:    }
 1084: 
 1085:    __forceinline__ __device__ bool containsPoint(Vector2 x) const;
 1086: 
 1087: 
 1088:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1089:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1090:    __inline__ __device__ int iadv(void) const;
 1091: 
 1092:    __inline__ __device__ double grav3(void) const;
 1093:    
 1094:    __inline__ __device__ double eta2(void) const;
 1095:    __inline__ __device__ double eta1(void) const;
 1096:    __inline__ __device__ double depth(void) const;
 1097:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1098:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1099:    __inline__ __device__ double w2(int k) const;
 1100: 
 1101:    __inline__ __device__ double dfv(int k) const;
 1102: 
 1103:    __inline__ __device__ double veg_h(void)  const;
 1104:    __inline__ __device__ double veg_nv(void) const;
 1105:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1106:    __inline__ __device__ double veg_alpha3D(int k) const;
 1107:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1108: 
 1109:    __inline__ __device__ double Cd(void) const;
 1110: 
 1111:    __inline__ __device__ Vector2 tau(void) const;
 1112: 
 1113:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1114:    
 1115: 
 1116:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1117:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1118:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1119:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1120:    } 
 1121:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1122:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1123:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1124:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1125: 
 1126:    // Get valid starting element (for backtracking)
 1127:    __inline__ __device__ Element* getStartElement() {
 1128:       return elems[0] ? elems[0] : elems[1];
 1129:    }
 1130: 
 1131:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
 1132:       // From the elements that share this side, find the one that is in the direction opposite to the velocity vector
 1133:       // (unless it is a boundary side or a dry element, in which case we return the only wet element)
 1134: 
 1135:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
 1136: 
 1137:       // Dot product of the negative velocity vector with the side normal vector
 1138:       const double dot_prod1 = -dot(u, n);
 1139: 
 1140:       // Vector from side center to element 0 centroid
 1141:       const Vector2 v2 = elems[0]->center - center;
 1142: 
 1143:       // Dot product of the vector with the side normal vector
 1144:       const double dot_prod2 = dot(v2, n);
 1145: 
 1146:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
 1147:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
 1148: 
 1149:       if (dot_prod1*dot_prod2 > 0.0) return elems[0] ;
 1150:       else                           return elems[1];
 1151: 
 1152:  
 1153:    }
 1154: 
 1155:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1156:       // Given an element, returns the other element that shares this side
 1157:       return (elems[0] == elem) ? elems[1] : elems[0];
 1158:    }
 1159: 
 1160:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1161:       // Given a node, returns the other node that shares this side
 1162:       return (n1 == node) ? n2 : n1;
 1163:    }
 1164:  
 1165:    __inline__ __device__ Vector2 btrack(int jlev, double dt, double dtbk) const;
 1166: 
 1167: 
 1168: 
 1169: 
 1170: };
