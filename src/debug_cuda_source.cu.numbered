 4688:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4689: 
 4690:       SIDE(side);
 4691: 
 4692: 
 4693:       side->U = {0.0, 0.0}; 
 4694:          
 4695:       if(side->isDry) return;
 4696: 
 4697:       const Node *node1 = side->n1;
 4698:       const Node *node2 = side->n2;
 4699: 
 4700:       // Vertically integrated velocity U (in ll if ics=2)
 4701:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4702:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  
 4703:       }
 4704: 
 4705:    }
 4706: 
 4707:    __global__ void computeBottomDragVegetation(void) {
 4708:       // UNFINISHED. CHECK THIS:
 4709:       // How many kernels are needed? Why so many for loops?
 4710:       // Is the loop on sides needed?
 4711: 
 4712:       NODE(node);
 4713: 
 4714: 
 4715:       const int    kb      = node->kb;
 4716:       const double htot    = node->htot2(); 
 4717:       
 4718:       if (node->isDry) {
 4719:          // Default values for dry nodes
 4720:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4721:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4722: 
 4723:          return;
 4724:        
 4725:       }
 4726: 
 4727:       // Computes bottom drag Cd based on the selected nchi
 4728:       node->computeBottomDragCd();
 4729:       
 4730: 
 4731: 
 4732:       //   Bottom stress in m^2/s^2
 4733:       if (node->rho[kb + 1] >= -98.0)
 4734:       {
 4735:          const double mag_u = length(node->u2[kb + 1]);
 4736:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 4737: 
 4738:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4739:          // !sediment erosion: this part needs more documentation
 4740:       }
 4741:     
 4742: 
 4743: 
 4744:       // Compute vegetation parameters
 4745:       //--------------------------------
 4746: 
 4747:       // SAV constants
 4748:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4749:       constexpr double veg_cfpsi = 0.16;
 4750: 
 4751:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4752:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4753: 
 4754:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4755:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4756:          int kbin = 0; // bin index
 4757:          for (int k = kb; k < nvrt; k++) {
 4758:             // Computes node height above the bottom level
 4759:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4760:             assert(false && "Vertical variation of vegetation not implemented");
 4761: 
 4762:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4763:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4764:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4765:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4766:             // } else {
 4767:             //    // Find the bin at which the current vertical level is
 4768:             //    while (kbin<nbins_veg_vert) {
 4769:             //       const double zn = node->z[kbin];
 4770:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4771:             //          break;
 4772:             //       } // if
 4773:             //       kbin++;
 4774:             //    } // while
 4775:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4776: 
 4777:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4778:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4779:                
 4780:             //    // Linear interpolation of the vegetation parameters
 4781:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4782:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4783:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4784:             // } // if rl10
 4785: 
 4786:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4787: 
 4788:          } // for k
 4789: 
 4790: 
 4791:       } else { // Ganthy (iveg==2)
 4792:       //  Modify canopy height, diameter, and density
 4793: 
 4794:          // Make sure there is vegetation on this node
 4795:          if (node->veg_h_unbent > 0.0) {
 4796:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4797: 
 4798:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4799:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4800:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4801: 
 4802:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4803:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4804:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4805:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4806:          } // if veg_h_unbent
 4807: 
 4808:          for (int k = 0; k < nvrt; k++) {
 4809:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4810:          } // for k
 4811:       
 4812: 
 4813:       } // if iveg
 4814:      
 4815: 
 4816:       // Compute vertical mean of veg_alpha3D
 4817:       if (iveg != 0) {
 4818:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4819:          double sum1=0.0;
 4820:          double sum2=0.0;
 4821:          // Integrate over each level under the canopy...
 4822:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 4823:             const double Dz = node->Dz(k);
 4824: 
 4825:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 4826:             sum2 += Dz;
 4827: 
 4828:          } // for k
 4829:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4830:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4831: 
 4832:       } // if iveg
 4833: 
 4834:    }
 4835: 
 4836:    __global__ void computeVegetationAndDragParameters(void) {
 4837:       // Computes the vegetation and drag model parameters:
 4838:       // chi, \tilde\chi, beta, \breve{H}
 4839:       
 4840:       SIDE(side);
 4841: 
 4842:       if (side->isDry) return;
 4843: 
 4844:       const double htot = side->htot2();
 4845:       const int    kb   = side->kb;
 4846: 
 4847:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4848: 
 4849:       const double veg_h     = side->veg_h();
 4850:       const double veg_nv    = side->veg_nv();
 4851:       const double veg_c     = side->veg_c();
 4852:       const double veg_beta  = side->veg_beta;
 4853:       const double veg_alpha = side->veg_alpha_vert_mean();
 4854: 
 4855:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4856:       // Velocity magnitude at the bottom level
 4857:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4858:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4859:       side->chi2 = side->Cd()*vmag1;
 4860:       side->chi  = side->chi2;
 4861:       if constexpr(iveg != 0) {
 4862:          const Node *n1 = side->n1;
 4863:          const Node *n2 = side->n2;
 4864:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4865:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4866:       }
 4867: 
 4868:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4869: 
 4870:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4871:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4872:       double magUa = 0.0;
 4873:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4874:          // 3D wet side with veg...
 4875: 
 4876:          double magUa = 0.0;
 4877:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4878:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4879: 
 4880:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4881:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4882:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4883: 
 4884:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4885:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4886: 
 4887:                // Velocity magnitude at the bottom (l) of the level
 4888:                const double ul = length(side->u2[k]);
 4889: 
 4890:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4891:                magUa += Dz*0.5*(uh + ul);
 4892: 
 4893:             } // if HasVegetation
 4894:          } // for k
 4895:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4896: 
 4897:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4898:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4899:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4900:             const double zCpy = side->zTopCanopy();
 4901:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4902:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4903:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4904:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4905:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4906:          } // if isSubmerged
 4907:       } // if iveg   
 4908: 
 4909:       // Computes the friction modified depth, \breve{H} in notes
 4910:       if (side->is2D()) { // 2D
 4911: 
 4912:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4913:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4914: 
 4915:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4916: 
 4917:          side->hhat = htot*htot/fricH; 
 4918: 
 4919:       } else { // 3D
 4920:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4921: 
 4922:          if constexpr(iveg != 0) {
 4923:             
 4924:             if (side->isSubmerged()) { 
 4925:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4926:                side->hhat -= veg_c*Hhat_alpha;
 4927: 
 4928:             } else { // Emergent
 4929:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4930:             }
 4931:          } // if iveg
 4932: 
 4933:          // Enforce positivity for 3D model
 4934:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4935:       } // if 3D
 4936: 
 4937:    }
 4938: 
 4939: 
 4940: 
 4941:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4942:    // Computes the density gradient between two elements, e1 and e2.
 4943:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4944:    // zero in the direction normal to the side. 
 4945:    // 
 4946:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4947:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4948:    //
 4949:    // Input:
 4950:    //    e1: Element
 4951:    //    e2: Neighbor element (or nullptr if boundary)
 4952:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4953:    //    k: Index of the half-level at which the density is interpolated
 4954:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4955:    // 
 4956:    // Output:
 4957:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4958:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4959: 
 4960:       if (e2 == nullptr || e2->isDry) {
 4961:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4962: 
 4963:          Side *side = e1->sides[j];
 4964:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4965:                  
 4966:          if constexpr(ics == 1) {
 4967:             vec = side->n; // Normal vector to the side
 4968:          } else {
 4969:             // IMPLEMENT THIS XXXXXX
 4970:             // !replace with xel, yel?
 4971:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4972:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4973:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4974:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4975:          } //ics
 4976:                    
 4977:          diffRho = 0.0;
 4978: 
 4979:       } else { //internal and wet
 4980:          if constexpr(ics==1) {
 4981:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4982: 
 4983:             // Vector from e1 to e2
 4984:             vec = e2->center - e1->center;
 4985: 
 4986:          } else { 
 4987:             // IMPLEMENT THIS XXXXXX
 4988:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4989:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4990:             //                   alow(j)=xctr2
 4991:             //                   bdia(j)=yctr2
 4992:          } // ics
 4993: 
 4994:          diffRho = rho2 - e1->demeanedDensity(k);
 4995:       }
 4996: 
 4997:    }
 4998: 
 4999:    __global__ void computeDensityCubicSplines(void) {
 5000:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5001: 
 5002:       ELEM(elem);
 5003: 
 5004:       if (elem->isDry) return;
 5005: 
 5006:       const int kb = elem->kb;
 5007: 
 5008:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5009:       if (elem->is2D()) {
 5010:          // In the 2D case, the density is constant at the prism level. 
 5011:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5012:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5013:       } else { //3D
 5014: 
 5015:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5016:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5017:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5018:          ///// XXXX CHECK INDICES!!!!!
 5019:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5020:       } // 2D/3D
 5021: 
 5022:    }
 5023: } // extern "C"
 5024: 
 5025: 
 5026: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5027: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5028: 
 5029:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5030: 
 5031:    const int kb  = elem->kb;
 5032:    const int kb2 = elem2->kb;
 5033: 
 5034:    // z-coordinate of prism of elem
 5035:    const double zp = elem->z_prism(k);
 5036: 
 5037:    double rho = 0.0;
 5038: 
 5039:    if (elem2->is2D()) {
 5040:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5041: 
 5042:    } else {  // 3D
 5043: 
 5044:       // eta_min may be < zmax
 5045:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5046:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5047: 
 5048:       // (Extrapolate density below bottom, we will fix it later)
 5049:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5050:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5051:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5052:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5053:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5054:    } // 2D/3D
 5055:      
 5056: 
 5057:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5058:    // Now we need to fix it.
 5059:    if (elem->z[k] < elem2->z[kb2]) {
 5060:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5061: 
 5062:       // There are two methods to adjust the density at the bottom of the element.
 5063:       // iunder_deep=0: 
 5064:       const double depth1 = abs(elem->z[kb]); // larger depth
 5065: 
 5066:       if (iunder_deep==0) {
 5067: 
 5068:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5069: 
 5070:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5071: 
 5072:       } else { // iunder_deep != 0
 5073: 
 5074:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5075: 
 5076:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5077: 
 5078:          //   Demeaned density at the same z coordinate as
 5079:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5080:          }
 5081: 
 5082:       } // if iunder_deep
 5083:    } // if elem->z[kb] < elem2->z[kb]
 5084: 
 5085:    return rho;
 5086: }
 5087: 
 5088: 
 5089: extern "C" {
 5090:    __global__ void computeDensityGradient(void) {
 5091: 
 5092:       if constexpr(ibc != 0) return;
 5093: 
 5094:          // Compute the horizontal density gradient at each element.
 5095:       // It works in two steps:
 5096:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5097:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5098:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5099:       //             gradRho.r1 = rho1 - rho0
 5100:       //             gradRho.r2 = rho2 - rho0
 5101:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5102:       // 
 5103:       //  NOTE: We use de-meaned densities.
 5104: 
 5105:       ELEM(elem);
 5106: 
 5107:       if (elem->isDry) return;
 5108: 
 5109:       const int kb  = elem->kb;
 5110:       const int i34 = elem->i34;
 5111: 
 5112:       for (int k = kb + 1; k < nvrt; k++) {
 5113:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5114:          //             gradRho.r1 = rho1 - rho0
 5115:          //             gradRho.r2 = rho2 - rho0
 5116:          int icount = 0;
 5117:          double sumRx = 0.0;
 5118:          double sumRy = 0.0;
 5119:          for (int j1=0; j1<i34; j1++) { 
 5120: 
 5121:             const int j2 = elem->nxq(j1 + 1);
 5122: 
 5123:             // Pairs of consecutive neighbor elements of elem
 5124:             const Element *e1 = elem->nghbElems[j1];
 5125:             const Element *e2 = elem->nghbElems[j2];
 5126: 
 5127:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5128:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5129:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5130: 
 5131:             // Compute the density difference and the vector from elem to e1 and e2
 5132:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5133:             double diffRho1, diffRho2;
 5134:             Vector2 vec1, vec2;
 5135:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5136:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5137: 
 5138:             const double rl1 = length(vec1);
 5139:             const double rl2 = length(vec2);
 5140:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5141: 
 5142:             const double delta = cross(vec1, vec2);
 5143:             const double sintheta = abs(delta)/(rl1*rl2);
 5144: 
 5145:             // To avoid problems, avoid elements with small angle between vectors
 5146:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5147:             const bool validEq = (sintheta > sin_one_deg);
 5148: 
 5149:             if (validEq) {
 5150:                // Solve the system of equations to get the density gradient at elem
 5151:                icount++;
 5152:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5153:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5154:                sumRx += Rx;
 5155:                sumRy += Ry;
 5156:             }
 5157:          } // for j1
 5158: 
 5159:          // Compute the average density gradient at elem
 5160:          if (icount==0) {
 5161:            // Bad mesh quality; bail out with 0 b-cc
 5162:            elem->gradRho[k] = {0.0, 0.0};
 5163:          } else {
 5164:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5165:          }
 5166: 
 5167:       } // for k
 5168: 
 5169:    }
 5170: 
 5171:    __global__ void computeBaroclinicTerm(void) {
 5172:    // Computes the baroclinic term at sides (at half levels).
 5173:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5174:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5175: 
 5176:       if (ibc == 1) return;
 5177: 
 5178:       SIDE(side);
 5179: 
 5180:       if (side->isDry) return;
 5181: 
 5182:       const Element *e1 = side->elems[0];
 5183:       const Element *e2 = side->elems[1];      
 5184:       const int kb = side->kb;
 5185:       
 5186:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5187: 
 5188:       // interpolates vertically the density gradient of the two elements at the half level/
 5189: 
 5190:       int k1 = max(kb, nvrt / 2);
 5191:       int k2 = max(kb, nvrt / 2);
 5192: 
 5193:       // Starts the integration at the surface and goes down to the bottom
 5194:       side->bcc[nvrt-1] = {0.0, 0.0};
 5195:       for (int k = nvrt - 2; k >= kb; k--) {
 5196:       // For each prism level (from surface to bottom)...
 5197: 
 5198:          // For both elements, interpolate density gradient at the side's half level.
 5199:          // The gradient at the side is the average of the gradients at the elements.
 5200:          // w1, w2 are used to take into account boundary sides, with just one element.
 5201:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5202:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5203:          const double wsum = w1 + w2;
 5204:          w1 = w1/wsum;
 5205:          w2 = w2/wsum;
 5206:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5207: 
 5208:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5209:          Vector2 gradRho = {0.0, 0.0};
 5210:          if (e1 != nullptr && k > kb) {
 5211:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5212:             
 5213:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5214:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5215:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5216: printf("###### k1 = %d, side->idx = %d, zc[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, zrat = %.16f\n",
 5217:       k1, side->idx, k, side->zc[k], k1, e1->z[k1], k1 + 1, e1->z[k1 + 1], e1->gradRho[k1].x, e1->gradRho[k1].y, zrat);            
 5218:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5219:          }      
 5220:          if (e2 != nullptr && k > kb) {
 5221:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5222:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5223:             
 5224:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5225:          }
 5226: 
 5227:          if constexpr(ics==2) {
 5228:             assert(false && "Not implemented: ics == 2");
 5229:             // IMPLEMENT THIS XXXXXX
 5230:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5231:             // swild(1)=tmp1
 5232:             // swild(2)=tmp2
 5233:          }
 5234:          
 5235:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5236:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5237:          // CHECK INDICES!!! XXX
 5238:          const double grav3 = side->grav3();
 5239:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5240: 
 5241:       } // for
 5242: 
 5243:    }
 5244: 
 5245: 
 5246: 
 5247:    __global__ void computeHorGradientAtSide(void) {
 5248: 
 5249:       // Compute the horizontal density gradient at each element.
 5250:       // It works in two steps:
 5251:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5252:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5253:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5254:       //             gradRho.r1 = rho1 - rho0
 5255:       //             gradRho.r2 = rho2 - rho0
 5256:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5257:       // 
 5258:       //  NOTE: We use de-meaned densities.
 5259: 
 5260:       SIDE(side);
 5261: 
 5262: // printf("side->isDry: %d\n", side->isDry);
 5263:       if (side->isDry) return;
 5264: 
 5265:       // Computes the gradient of the variables at the side center.
 5266:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5267:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5268:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 5269: 
 5270:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5271:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5272:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5273:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5274: 
 5275: 
 5276:    }
 5277: 
 5278: 
 5279:    __global__ void solveMomentumEquations(double time) {
 5280: 
 5281:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5282:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5283: 
 5284:       SIDE(side);
 5285: 
 5286:       if (side->isDry) 
 5287:       {
 5288:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 5289: 
 5290:          return;
 5291:       }
 5292: 
 5293:       const Node *n1 = side->n1;
 5294:       const Node *n2 = side->n2;
 5295: 
 5296:       const int kb = side->kb;
 5297: 
 5298:       const double veg_h = side->veg_h();
 5299:       const double grav3 = side->grav3();
 5300: 
 5301:       if (side->is2D()) {
 5302:          // Warning: Do not use htot2, which is updated.
 5303:          const double htot = side->htot1();
 5304:          const double hhat = side->hhat;
 5305: 
 5306:          // assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5307: 
 5308:          Vector2 tau2 = {0.0, 0.0};
 5309:           
 5310:          if constexpr(ics==1) {
 5311:             tau2 = side->tau();
 5312: 
 5313:          } else {
 5314:             assert(false && "Not implemented: ics == 2");
 5315:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5316:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5317:             // taux2=(vn1+tt1)*0.5d0
 5318:             // tauy2=(vn2+ss1)*0.5d0
 5319:          } // if ics         
 5320: 
 5321:          // hat_gam has units of m/s
 5322: 
 5323:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5324: 
 5325:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5326:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5327: 
 5328:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5329: 
 5330: 
 5331:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 5332:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 5333: 
 5334:          for (int k = 0; k < nvrt; k++) side->u2[k] = {ux, uy};
 5335: 
 5336:       }
 5337:       else { // 3D
 5338: 
 5339:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5340:          // 
 5341:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5342:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5343:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5344:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5345:          // k+1 and k.
 5346: 
 5347: 
 5348:          const int ndim = nvrt - kb;
 5349:          const double zTopCanopy = side->zTopCanopy();
 5350: 
 5351:          // Initialize the tridiagonal system
 5352:          for (int k = kb + 1; k < nvrt; k++) {
 5353:             
 5354:             const int kin = k - (kb + 1);
 5355: 
 5356:             // Vertical viscosity at the face center
 5357:             const double dfz =  0.5*(side->dfv(k - 1) + side->dfv(k)); ///XXXXX
 5358:  
 5359:             alow[kin] = 0.0;
 5360:             cupp[kin] = 0.0;
 5361:             bdia[kin] = 0.0;
 5362: 
 5363:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5364:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5365: 
 5366:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5367:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5368:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5369: 
 5370:             // First part: layers k, k+1
 5371:             if (k < nvrt - 1) {
 5372:                              
 5373:                if constexpr(iveg != 0) {
 5374: 
 5375:                   // If there is vegetation at this level...
 5376:                   if (zTopCanopy > side->zc[k]) {
 5377:                      // If the canopy is above the k layer...
 5378:                      
 5379:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5380:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5381:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5382:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5383: 
 5384:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5385:                      const double vmag2 = length(ut2);
 5386:                      const double vmag1 = length(side->u2[k]);
 5387:                      const double vmag = 0.5*(vmag1 + vmag2);
 5388:                      
 5389:                      // Computes the vegetation alpha at the face center
 5390:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5391: 
 5392:                      cff1 += veg_alpha_sd*dt*vmag;
 5393: 
 5394:                   } // if (zTopCanopy
 5395:                } // if iveg
 5396: 
 5397:                const double dzz = side->Dz(k + 1);
 5398:                const double tmp = dt*dfz/dzz;
 5399:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5400: 
 5401:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5402:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5403:             }
 5404: 
 5405: 
 5406:             // Second part: layers k-1, k
 5407:             if (k > kb + 1) {
 5408: 
 5409:                double cff1 = 1.0; //init \bar{c^k}
 5410: 
 5411:                if constexpr(iveg != 0) {
 5412:                   // If there is vegetation at this level...
 5413:                   if (zTopCanopy > side->zc[k-1]) {
 5414:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5415:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5416: 
 5417:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5418: 
 5419:                      const double vmag2 = length(ut2);
 5420:                      const double vmag1 = length(side->u2[k-1]);
 5421:                      const double vmag = 0.5*(vmag1 + vmag2);
 5422: 
 5423:                      // Computes the vegetation alpha at the face center
 5424:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5425:                      cff1 += veg_alpha_sd*dt*vmag;
 5426:                   } // if zTopCanopy
 5427: 
 5428:                } // if iveg
 5429: 
 5430:                const double dzz = side->Dz(k);
 5431:                const double tmp = dt*dfz/dzz;
 5432:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5433: 
 5434:                alow[kin] += cff1*dzz/6.0 - tmp;
 5435:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5436: 
 5437:             } else { // Bottom boundary
 5438:                // This occurs at the bottom, where the bottom drag is applied.
 5439: 
 5440:                bdia[kin] += dt*side->chi2; // XXXX
 5441: 
 5442:             } // if (k > kb + 1)
 5443: 
 5444: 
 5445:          } // for (int k
 5446: 
 5447: 
 5448: 
 5449:          // Computes the RHS.
 5450:          // -----------------
 5451: 
 5452:          //	BC to be imposed at the end.
 5453: 
 5454:          const Vector2 gradETP  = side->gradETP;
 5455:          const Vector2 gradPr   = side->gradPr;
 5456:          const Vector2 gradEta1 = side->gradEta1;
 5457:          const Vector2 gradEta2 = side->gradEta2;
 5458: 
 5459:          const Vector2 *btu = side->btu;
 5460:          const Vector2 *u2  = side->u2;
 5461:          const double coriolis = side->coriolis;
 5462:          const Vector2 *nuGradU = side->nuGradU;
 5463: 
 5464: 
 5465:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5466: 
 5467:          for (int k = kb + 1; k < nvrt; k++) {
 5468:             const int kin = k - kb - 1;
 5469: 
 5470:             const double dz_0 = side->Dz(k);
 5471:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5472: 
 5473:             rrhs[kin] = {0.0, 0.0};
 5474:             double dz = 0.0;
 5475: 
 5476:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5477:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5478:             if (k < nvrt  ) dz += dz_1;
 5479:             if (k > kb + 1) dz += dz_0;
 5480: 
 5481:             // Elevation gradient, atmospheric pressure and tidal potential
 5482:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5483: 
 5484:             // Coriolis, advection, wind stress, and horizontal viscosity
 5485:             if (k < nvrt - 1) {
 5486: 
 5487: 
 5488:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5489:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5490:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5491:                                                 
 5492: 
 5493:                //diff stress tensors 1006
 5494:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5495:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5496:                   assert(false && "Not implemented: itur == 5");
 5497:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5498:                }
 5499:                // else assert(false && "itur # Not implemented");
 5500: 
 5501:             } else { // k == nvrt - 1 SURFACE
 5502:                Vector2 tau2 = {0.0, 0.0};
 5503:                if constexpr(ics==1) {
 5504:                   tau2 = side->tau();
 5505:       
 5506:                } else {
 5507:                   assert(false && "Not implemented: ics == 2");
 5508:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5509:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5510:                   // taux2=(vn1+tt1)*0.5d0
 5511:                   // tauy2=(vn2+ss1)*0.5d0
 5512:                } // if ics
 5513: 
 5514:                rrhs[kin] += dt*tau2;
 5515: 
 5516:             } // if k<nvrt
 5517: 
 5518:             if (k > kb + 1) {
 5519:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5520:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5521:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5522: 
 5523:                // diff stress tensors 1006
 5524:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5525:                   assert(false && "Not implemented: itur == 5");
 5526:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5527:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5528:                }
 5529:                // else assert(false && "itur # Not implemented");
 5530: 
 5531: 
 5532:             } // if k>kbs + 1
 5533: 
 5534:             // Baroclinic
 5535:             Vector2 *bcc = side->bcc;
 5536:             if constexpr(ibc == 0) {
 5537:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5538:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5539: 
 5540:             } // if ibc==0
 5541: 
 5542:          } // k=kb + 1,nvrt
 5543: 
 5544: 
 5545:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5546: 
 5547:          for (int k = kb ; k < nvrt; k++) {  // YYYYYYYYY can be kb 
 5548:             const int kin = k - kb - 1;
 5549:    
 5550:             // Velocity is always clamped to maximum values
 5551:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5552:          } // k
 5553: 
 5554:       } // if side->is2D()
 5555:       
 5556: 
 5557:       // Impose velocity boundary condition at the bottom
 5558:       if constexpr(imm == 2) { // 3D bed deformation model
 5559:          double dep;
 5560:          Vector2 vel;
 5561: 
 5562:          assert(false && "Not implemented: imm == 2");
 5563:          //update_bdef(time, x0, y0, dep, vel);
 5564:          // side->u2[kb] = vel;
 5565: 
 5566:       } else { // imm = 0 or 1
 5567:          if (side->Cd() == 0.0) {
 5568:             side->u2[kb] = side->u2[kb + 1];
 5569: 
 5570:          } else if (side->is3D()) { // 3D no slip bottom   
 5571:             side->u2[kb] = {0.0, 0.0};
 5572:          }
 5573:           
 5574:       } // if imm
 5575: 
 5576:       // The velocities below the bottom level are set to zero
 5577:       for (int k = 0; k <= kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5578: 
 5579: 
 5580:    }
 5581: 
 5582: 
 5583:    __global__ void applyMomentumBC(void) {
 5584: 
 5585:       SIDE_BND(sideBnd);
 5586: 
 5587:       Side *side = sideBnd->side;
 5588:       const BoundarySegment *segment = sideBnd->segment;
 5589:       const Node *n1 = side->n1;
 5590:       const Node *n2 = side->n2;
 5591: 
 5592:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5593: 
 5594:       const bool isLand = segment->isLand;
 5595:       const int ifltype = segment->ifltype;
 5596: 
 5597:       const int kb = side->kb;
 5598: 
 5599:       if (!isLand && ifltype != 0) {
 5600:          const Vector2 *ubc = sideBnd->ubc;
 5601:   
 5602:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5603:             
 5604:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5605:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5606: 
 5607:             if (ifltype == -1) {
 5608:                // Flather 1
 5609: 
 5610:                const double depth = side->depth();
 5611: 
 5612:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5613: 
 5614:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5615: 
 5616:                side->u2[k] = vnorm*side->n;
 5617: 
 5618:             } else if (ifltype == -2) { // Discharge
 5619: 
 5620:                const double eta1 = side->eta1();
 5621:                const double eta2 = side->eta2();
 5622:                const double htot = side->htot2();
 5623: 
 5624:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5625:                assert(false && "Not implemented: Discharge bc");
 5626:                // const double dischrg = discharge(eta1);
 5627:                const double dischrg = 0.0; // XXX REMOVE
 5628:                
 5629: 
 5630:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5631: 
 5632:                const double vnorm = dischrg*eta2/htot;
 5633: 
 5634:                side->u2[k] = vnorm*side->n;
 5635: 
 5636:             }
 5637:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5638:                const double vnorm = dot(side->u2[k], side->n);
 5639: 
 5640:                double rat;
 5641:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5642:                else              rat = segment->vobc2; // outgoing
 5643: 
 5644:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5645: 
 5646:             }
 5647:             else { // not Flather or 3D radiation
 5648:                side->u2[k] = ubc[k];
 5649: 
 5650:             } // if (segment->ifltype...
 5651: 
 5652:          }
 5653: 
 5654:       }
 5655:       else if (isLand) { // if it is land boundary side
 5656: 
 5657:          if constexpr(islip == 0) { // free slip
 5658: 
 5659:             for (int k = kb; k < nvrt; k++) {
 5660: 
 5661:                const Vector2 t = side->t();
 5662:                const Vector2 n = side->n;
 5663: 
 5664:                double vnorm = 0.0; // for most cases
 5665:                const double vtan = dot(side->u2[k], t);
 5666:                
 5667:                side->u2[k] = vtan*t - vnorm*n;
 5668: 
 5669:             }
 5670: 
 5671:          } else { // no slip
 5672:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5673: 
 5674:          }
 5675:       } // if (side segment type...
 5676: 
 5677:    
 5678: 
 5679:    }
 5680: 
 5681: 
 5682:    __global__ void shapiroFilter1(void) {
 5683:       // First step of the Shapiro filter (normally used if indvel<=0)
 5684:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5685: 
 5686:       SIDE(side);
 5687: 
 5688:       // Only internal wet sides are processed
 5689:       if (side->isDry || !(side->isInternal())) return;
 5690: 
 5691:       const int kb = side->kb;
 5692: 
 5693:       for (int mm = 0; mm < niter_shap; mm++) {
 5694: 
 5695:          for (int k = kb + 1; k < nvrt; k++) {
 5696:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5697:             Vector2 suru = {0.0, 0.0};
 5698: 
 5699:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5700: 
 5701:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5702: 
 5703:                int kin = k;
 5704:                if (!(nSide->isDry)) kin = max(k, kb + 1);
 5705:                
 5706:                if constexpr(ics==1) {
 5707:                   suru += nSide->u2[kin];
 5708: 
 5709:                } else {
 5710:                   assert(false && "Not implemented: ics == 2");
 5711:                   // Vector2 vn1, vn2;
 5712:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5713:                   // suru=suru+vn1;
 5714:                   // surv=surv+vn2;
 5715:                }
 5716:             }
 5717: 
 5718: 
 5719:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5720: 
 5721:          }
 5722:       }
 5723:    }
 5724: 
 5725:    __global__ void shapiroFilter2(void) {
 5726:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5727: 
 5728:       SIDE(side);
 5729: 
 5730:       if (side->isDry || !(side->isInternal())) return;
 5731: 
 5732:       const int kb = side->kb;
 5733: 
 5734:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5735: 
 5736:       if (side->is2D()) {
 5737:          side->u2[kb + 1] = side->bcc[kb + 1];
 5738:          side->u2[kb    ] = side->u2 [nvrt - 1];
 5739: 
 5740:       } else {
 5741:          // 3D
 5742:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5743:          
 5744:       }
 5745: 
 5746:    }
 5747: 
 5748: 
 5749:    __global__ void ul0UpdateZCoords(void) {
 5750:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5751:       
 5752:       NODE(node);      
 5753: 
 5754: 
 5755:       if (node->isDry2()) { 
 5756: 
 5757:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 5758: 
 5759:          if constexpr(ivcor != 1) node->kb = 0;
 5760: 
 5761:       } else {
 5762: 
 5763:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 5764:          node->updateKb();
 5765: 
 5766:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5767: 
 5768:       }
 5769: 
 5770:       // We use the temp.b field to store the previous state of isDry.
 5771:       node->tmp.b = node->isDry;
 5772: 
 5773:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5774:       node->isDry = true;
 5775: 
 5776:    }
 5777: 
 5778:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5779:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5780:    {
 5781:       ELEM(elem);
 5782: 
 5783:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5784: 
 5785:       // All the nodes of a wet element are wet.
 5786:       if (!elem->isDry) {
 5787:          elem->nodes[0]->isDry = false;
 5788:          elem->nodes[1]->isDry = false;
 5789:          elem->nodes[2]->isDry = false;
 5790:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 5791: 
 5792:       }
 5793: 
 5794: 
 5795:       elem->kb = 0;
 5796: 
 5797:       if (elem->isDry) return;
 5798: 
 5799:       // Wet
 5800:       const Node *n1 = elem->nodes[0];
 5801:       const Node *n2 = elem->nodes[1];
 5802:       const Node *n3 = elem->nodes[2];  
 5803:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5804: 
 5805:    //    if(elem->isDry2()) { // XXXX
 5806:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5807:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5808:    //        call parallel_abort(errmsg)
 5809:    //    }
 5810: 
 5811: 
 5812:       // Computes element's kb as the minimum of the nodes' kb.
 5813:       const int kb1 = n1->kb;
 5814:       const int kb2 = n2->kb;
 5815:       const int kb3 = n3->kb;
 5816:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5817: 
 5818: 
 5819:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5820: 
 5821: 
 5822:       // Computes the element z as the mean of the nodes z.
 5823:       for (int k = elem->kb; k < nvrt; k++) {
 5824: 
 5825:          // Compute the element z as the mean of the nodes z.
 5826:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5827:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5828:          elem->z[k] /= elem->i34;
 5829: 
 5830:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5831:       }
 5832:                   
 5833:    }
 5834: 
 5835:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5836:    {
 5837:       NODE(node);
 5838:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5839: 
 5840:       if (it == iths) return;
 5841: 
 5842: 
 5843:       if(!node->isDry && node->tmp.b) { // rewetted
 5844:          for (int k=0; k < nvrt; k++) {
 5845: 
 5846:             Vector3 utmp={0.0, 0.0, 0.0};
 5847: 
 5848:             double ttmp=0.0;
 5849:             double stmp=0.0;
 5850:             int icount=0;
 5851:             for (int j = 0; j < node->numNodes; j++) {
 5852: 
 5853: 
 5854:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5855:                if (!node->isDry) { // all indices extended
 5856:                   icount++;
 5857: 
 5858:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5859:                   utmp += node->uvw2(k);
 5860:                   
 5861:                   ttmp += node->tracers[k].tracer[0]; 
 5862:                   stmp += node->tracers[k].tracer[1]; 
 5863:                }
 5864:             }
 5865: 
 5866:             if(icount > 0) {
 5867:                const double inv_icount = 1.0/icount;
 5868:                node->u2[k]     = {inv_icount*utmp.x, inv_icount*utmp.y};
 5869:                node->w2[k]     = inv_icount*utmp.z;
 5870:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5871:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5872:             }
 5873:          }
 5874:       }
 5875:    }
 5876: 
 5877: 
 5878:    __global__ void ul0UpdateSides(int it, int iths) {
 5879: 
 5880:       SIDE(side);
 5881: 
 5882:       // A side is wet if and only if at least one of its elements is wet.
 5883:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5884:  
 5885:       const Node *n1 = side->n1;
 5886:       const Node *n2 = side->n2;
 5887:      
 5888:       const int kb1 = n1->kb;
 5889:       const int kb2 = n2->kb;
 5890: 
 5891:       side->kb = 0; // dry
 5892: 
 5893:       if (isWet) {
 5894: 
 5895:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5896: 
 5897:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5898: 
 5899:          side->kb = min(kb1, kb2);
 5900: 
 5901:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 5902: 
 5903:          for (int k = side->kb; k < nvrt; k++) {
 5904:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5905: 
 5906:          
 5907:             assert(((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0)) && "Weird side (3)");
 5908: 
 5909:             // Compute velocity for re-wetted sides 
 5910:             if ((it != iths) && (side->isDry && isWet)) {
 5911:             
 5912:                Vector2 utmp={0.0, 0.0};
 5913: 
 5914:                int icount=0;
 5915: 
 5916:                // For all the sides on the two elements that share this side
 5917:                for (int j=0; j < 2; j++) {
 5918:                   const Element *elem = side->elems[j];
 5919:                   if (elem == nullptr) continue;
 5920: 
 5921:                   for (int jj=0; jj < elem->i34; jj++) {
 5922:                      const Side *nSide = elem->sides[jj];
 5923:                      if (nSide->isDry) continue;
 5924: 
 5925:                      icount++;
 5926:                      utmp += nSide->u2[k];                     
 5927:                   }
 5928:                }
 5929:                   
 5930:                assert(icount > 0 && "No wet sides around this side");
 5931:                if (icount > 0)  side->u2[k] = utmp/icount;
 5932:                   
 5933:             } // if ((it != iths) && (side->isDry && isWet))
 5934: 
 5935:          } // for k
 5936: 
 5937:       } // if isWet
 5938:    
 5939:       side->isDry = !isWet;
 5940: 
 5941:    }
 5942: 
 5943: 
 5944:    __global__ void zeroNodalVelocities(void) {
 5945:       NODE(node);
 5946: 
 5947:       for (int k = 0; k < nvrt; k++) {
 5948:          node->u2[k]   = {0.0, 0.0};
 5949:          node->w2[k]   = 0.0;
 5950:          node->utmp[k] = {0.0, 0.0};
 5951:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5952:       }
 5953:    }
 5954: 
 5955:  
 5956: 
 5957:    __global__ void computeNodalVerticalVelocities1(void) {
 5958:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5959:    // Adds the element's vertical velocity times the element's area.
 5960:       ELEM(elem);
 5961: 
 5962:       for (int j = 0; j < elem->i34; j++) {
 5963:          Node *node = elem->nodes[j];
 5964: 
 5965:          for (int k = node->kb; k < nvrt; k++) {
 5966:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 5967:          }
 5968:          atomicAdd(&(node->tmp.d), elem->area);
 5969:       }
 5970:    }
 5971: 
 5972:    __global__ void computeNodalVerticalVelocities2(void) {
 5973:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5974:    // Divides by the total area of the elements sharing the    node.
 5975:       NODE(node);
 5976: 
 5977:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5978:    }
 5979: 
 5980: 
 5981:    __global__ void computeNodalHorizontalVelocities1(void) {
 5982:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 5983:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 5984: 
 5985:       ELEM(elem);
 5986: 
 5987:       const int kb = elem->kb;
 5988:       const bool isTri = elem->isTri();
 5989: 
 5990:       if constexpr(indvel <= 0) {
 5991:          // Assuming discontinoius hvel.
 5992: 
 5993: 
 5994:          if (isTri) { // For triangles
 5995:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 5996:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 5997: 
 5998:             for (int j = 0; j < 3; j++) {
 5999:                // For every node of the triangle...
 6000:                Node *node = elem->nodes[j];
 6001: 
 6002:                const Side *s1 = elem->sides[j];
 6003:                const Side *s2 = elem->sides[(j + 1) % 3];
 6004:                const Side *s3 = elem->sides[(j + 2) % 3];
 6005: 
 6006:                const int numElements = node->numElements;
 6007:                const double inv_numElements = 1.0/numElements;
 6008: 
 6009:                for (int k = kb; k < nvrt; k++)  {
 6010:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated at the node   
 6011:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 6012:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 6013:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 6014:                   atomicAdd(&(node->utmp[k].x), inv_numElements * u.x);
 6015:                   atomicAdd(&(node->utmp[k].y), inv_numElements * u.y);
 6016: 
 6017:                }
 6018: 
 6019:             }
 6020:          }
 6021:          else { // For quads
 6022:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6023: 
 6024:          }
 6025: 
 6026:       }
 6027:       
 6028:    }
 6029: 
 6030: 
 6031:    __global__ void computeNodalHorizontalVelocities2(void) {
 6032:       NODE(node);
 6033: 
 6034:       for (int k = 0; k < nvrt; k++) {
 6035:          node->u2[k] = node->utmp[k];
 6036:          node->w2[k] = node->w2[k];
 6037:       }
 6038:       
 6039:    }   
 6040: 
 6041:    __global__ void computeNodalHorizontalVelocitiesOLD(void) {
 6042:    // XXXX I'm not sure where I got this function from. 
 6043:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 6044:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 6045:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 6046:    // It uses the utmp array as a temporary array to store the velocities.
 6047: 
 6048:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 6049: 
 6050:       SIDE(side);
 6051: 
 6052:       const int kb = side->kb;
 6053: 
 6054:       Node *n1 = side->n1;
 6055:       Node *n2 = side->n2;
 6056: 
 6057:       for (int k = kb; k < nvrt; k++) {
 6058: 
 6059:          // Cast the u2 vector into a Vector2 
 6060:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&(n1->utmp[k]));
 6061:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&(n2->utmp[k]));
 6062: 
 6063:          n1_u2 = side->u2[k]/n1->numSides;
 6064:          n2_u2 = side->u2[k]/n2->numSides;
 6065: 
 6066:       }
 6067: 
 6068: 
 6069:    }
 6070: 
 6071:    __global__ void resetVelocityOpenBndNodes(void) {
 6072:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6073: 
 6074:       NODE_BND(nodebnd);
 6075: 
 6076:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6077:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }
 6078:       }
 6079: 
 6080:    }
 6081: 
 6082: 
 6083:    __global__ void setVelocityOpenBndNodes(void) {
 6084:    // For open boundary nodes sets their velocity to the imposed values.
 6085: 
 6086:       SIDE_BND(sidebnd);
 6087: 
 6088:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6089:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6090:          // to its segment to the average of the side velocity.
 6091: 
 6092:          for (int k = 0; k < nvrt; k++) {
 6093:             Node *n1 = sidebnd->side->n1;
 6094:             Node *n2 = sidebnd->side->n2;
 6095: 
 6096: 
 6097:             Vector2 n1_u2(n1->u2[k]);
 6098:             Vector2 n2_u2(n2->u2[k]);
 6099: 
 6100:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6101:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6102:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6103:             }
 6104:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6105:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6106:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6107:             }
 6108: 
 6109:          }
 6110: 
 6111:       }
 6112: 
 6113:    }
 6114: 
 6115: 
 6116:    __global__ void computeVerticalVelocity(void) {
 6117:       // Computes the vertical velocity at the (2D) element's centroid.
 6118:       // In this function we will be considering volumetric elements, with side faces and a 
 6119:       // bottom and a top face. We will call them SFs, BF and TF.
 6120:       // It computes the flux coming from BF and the SFs.
 6121:       // If the bed is moving, it takes that into account.
 6122:       // Since water is incompressible, the integral of the velocity times the normal vector
 6123:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6124:       // and the BF is equal to the flux going out from the TF.
 6125:       // TF = - BF - sum(SFs).
 6126:       // It then computes the horizontal velocity at the center of TF.
 6127:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6128:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6129:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6130: 
 6131:       ELEM(elem);
 6132: 
 6133:       if (elem->isDry) return;
 6134: 
 6135:       const int kb = elem->kb;
 6136:       const bool isTri = elem->isTri();
 6137: 
 6138:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6139: 
 6140:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6141:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6142:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6143: 
 6144:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6145: 
 6146:       double area3D;
 6147: 
 6148:       // Bottom face flux
 6149:       double bottomFlux = 0.0;
 6150:       Vector2 u2meanBottom = {0.0, 0.0};
 6151:       const Vector2 gradh = elem->grad2(&Node::depth);
 6152:       if constexpr(imm==2) {
 6153:          Vector3 ubed;
 6154: 
 6155:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6156:          // updateBDEF(ubed);
 6157:      
 6158:          // const double bflux0 = dot(ubed, elem_n1);
 6159: 
 6160:          // elem->w[kb] += ubed.z;
 6161:       }
 6162:       else {
 6163:          Vector2 umean;
 6164:          if constexpr(ics == 1) {
 6165:             u2meanBottom = elem->mean(kb, &Side::u2);
 6166:          }
 6167:          else {
 6168:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6169:          }
 6170: 
 6171:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6172:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6173: 
 6174:          bottomFlux = - dot(gradh, u2meanBottom);
 6175:       } // if imm
 6176: 
 6177:       // Compute w for kb+1 to nvrt-1
 6178:       for (int l = kb; l < nvrt - 1; l++) {
 6179: 
 6180:          // normal vector to the top face of the "volumetric" element (3D)
 6181:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6182: 
 6183:          // Compute the total flux at the sides
 6184:          double sideFlux = 0.0;
 6185:          Vector2 u2top = {0.0, 0.0};
 6186:          for (int j = 0; j < elem->i34; j++) {
 6187:             const Side *side = elem->sides[j];
 6188: 
 6189:             const double sideArea = side->area(l);
 6190:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6191:             const double sign = elem->ssign[j]; 
 6192: 
 6193:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6194:          }
 6195:          
 6196:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6197:          //velocities at the centers of the sides
 6198:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6199: 
 6200:          // The flx at the top ace can be computed from the other flows.
 6201:          const double topFlux = - sideFlux - bottomFlux;
 6202:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6203: 
 6204:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6205: 
 6206:          elem_n1 = elem_n2;
 6207: 
 6208:          bottomFlux = - topFlux;
 6209:       }
 6210:    }  
 6211: 
 6212: 
 6213: 
 6214: 
 6215: 
