 6136: extern "C" {
 6137: 
 6138:    __global__ void scaleGravity(double loadtide_coef) {
 6139: 
 6140: 
 6141:       NODE(node);
 6142: 
 6143:       // SAL option: scale gravity
 6144:       if constexpr(iloadtide==2) {  // simple const
 6145:          node->grav2 = grav*(1.0 - loadtide_coef);
 6146: 
 6147:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 6148:         
 6149:           const double depth = max(node->depth, 0.0);
 6150:           const double tmp1 = sqrt(depth);
 6151:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 6152:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 6153:                              2.6969e-13*depth*depth*depth*tmp1;
 6154:           
 6155:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 6156:           
 6157: 
 6158: 
 6159:           node->grav2 = grav*(1.0 - beta_bar);
 6160: 
 6161:       } else {  // iloadtide=0,1
 6162:           node->grav2 = grav;
 6163: 
 6164:       }
 6165: 
 6166:    }
 6167: 
 6168: 
 6169:    __global__ void setWinds(double *xWind, double *yWind, double *pressAir) {
 6170:       NODE(node);
 6171: 
 6172:       const int idx = node->idx;
 6173:       Vector2 wind = {xWind[idx], yWind[idx]};
 6174: 
 6175:       if constexpr(nws != 0 && iwindoff != 0) {
 6176:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 6177:       }
 6178: 
 6179:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 6180:       node->setWind(wind);
 6181: 
 6182:       node->pr = pressAir[idx];
 6183:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 6184: 
 6185:    }
