 7962:          break;
 7963:       case (int)VarCode::eta:
 7964:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 7965:          *sizeType = sizeof(double);
 7966:          break;
 7967:       case (int)VarCode::x:
 7968:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 7969:          *sizeType = sizeof(Vector2);
 7970:          break;
 7971:       case (int)VarCode::z:
 7972:          *offset = (int)((char*)&nodes[0].z[0] - (char*)nodes);
 7973:          *sizeType = sizeof(double);
 7974:          break;
 7975:       case (int)VarCode::kb:
 7976:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 7977:          *sizeType = sizeof(int);
 7978:          break;
 7979:       case (int)VarCode::isdry:
 7980:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 7981:          *sizeType = sizeof(int);
 7982:          break;         
 7983:       case (int)VarCode::w:
 7984:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 7985:          *sizeType = sizeof(double);
 7986:          break;
 7987:       case (int)VarCode::u:
 7988:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 7989:          *sizeType = sizeof(Vector2);
 7990:          break;         
 7991:       default:
 7992:          *offset = -1;    
 7993:    }  
 7994:    
 7995: }
