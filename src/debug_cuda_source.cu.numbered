 1736: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o') {
 1737: // return;   
 1738:    // Lock the mutex
 1739:    lock(&debugPlotMutex);
 1740:  
 1741:    bool ok = true;
 1742:    if (debugPlotIdx == nullptr) ok = false;
 1743:    if (*debugPlotIdx >= 10000) ok = false;
 1744:    if (ok) {
 1745:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1746:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1747:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1748:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1749:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1750:       debugPlot[(*debugPlotIdx) + 5*10000] = (double)marker;
 1751:       (*debugPlotIdx)++;
 1752:    }
 1753: 
 1754:    __threadfence();               // ensure all above writes are visible
 1755:    // Unlock the mutex
 1756:    unlock(&debugPlotMutex);
 1757: 
 1758: }
