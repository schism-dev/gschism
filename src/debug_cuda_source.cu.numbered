 5073:    __global__ void scaleGravity(double loadtide_coef) {
 5074: 
 5075: 
 5076:       NODE(node);
 5077: 
 5078:       // SAL option: scale gravity
 5079:       if constexpr(iloadtide==2) {  // simple const
 5080:          node->grav2 = grav*(1.0 - loadtide_coef);
 5081: 
 5082:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 5083:         
 5084:           const double depth = max(node->depth, 0.0);
 5085:           const double tmp1 = sqrt(depth);
 5086:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 5087:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 5088:                              2.6969e-13*depth*depth*depth*tmp1;
 5089:           
 5090:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 5091:           
 5092: 
 5093: 
 5094:           node->grav2 = grav*(1.0 - beta_bar);
 5095: 
 5096:       } else {  // iloadtide=0,1
 5097:           node->grav2 = grav;
 5098: 
 5099:       }
 5100: 
 5101:    }
