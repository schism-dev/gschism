 8694:       //    *offset = (int)((char*)&sides[0].w2 - (char*)sides);
 8695:       //    *sizeType = sizeof(double);
 8696:       //    break;
 8697:       case (int)VarCode::u:
 8698:          *offset = (int)((char*)&sides[0].u2[0].x - (char*)sides);
 8699:          *sizeType = sizeof(Vector2);
 8700:          break;   
 8701:       case (int)VarCode::btu:
 8702:          *offset = (int)((char*)&sides[0].btu[0].x - (char*)sides);
 8703:          *sizeType = sizeof(Vector2);
 8704:          break;          
 8705:       case (int)VarCode::U:
 8706:          *offset = (int)((char*)&sides[0].U.x - (char*)sides);
 8707:          *sizeType = sizeof(Vector2);
 8708:          break;
 8709:       case (int)VarCode::gradETP:
 8710:          *offset = (int)((char*)&sides[0].gradETP.x - (char*)sides);
 8711:          *sizeType = sizeof(Vector2);
 8712:          break;
 8713:       case (int)VarCode::gradPr:
 8714:          *offset = (int)((char*)&sides[0].gradPr.x - (char*)sides);
 8715:          *sizeType = sizeof(Vector2);
 8716:          break;
 8717:       case (int)VarCode::gradEta1:
 8718:          *offset = (int)((char*)&sides[0].gradEta1.x - (char*)sides);
 8719:          *sizeType = sizeof(Vector2);
 8720:          break;
 8721:       case (int)VarCode::gradEta2:
 8722:          *offset = (int)((char*)&sides[0].gradEta2.x - (char*)sides);
 8723:          *sizeType = sizeof(Vector2);
 8724:          break;
 8725:       // case (int)VarCode::ghat:
 8726:       //    *offset = (int)((char*)&sides[0].ghat.x - (char*)sides);
 8727:       //    *sizeType = sizeof(Vector2);
 8728:       //    break;   
 8729:       case (int)VarCode::hhat:
 8730:          *offset = (int)((char*)&sides[0].hhat - (char*)sides);
 8731:          *sizeType = sizeof(Vector2);
 8732:          break;      
 8733:       case (int)VarCode::chi:
 8734:          *offset = (int)((char*)&sides[0].chi - (char*)sides);
 8735:          *sizeType = sizeof(double);
 8736:          break;
 8737:       case (int)VarCode::n1:
 8738:          *offset = (int)((char*)&sides[0].n1 - (char*)sides);
 8739:          *sizeType = sizeof(Node);
 8740:          break;
 8741:       case (int)VarCode::n2:
 8742:          *offset = (int)((char*)&sides[0].n2 - (char*)sides);
 8743:          *sizeType = sizeof(Node);
 8744:          break;                   
 8745:       default:
 8746:          *offset = -1;
 8747:    }
 8748: }
