 1864: // Convenience macros for accessing the objects in kernels.
 1865: 
 1866: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 1867:                    Side *side = &(mesh->localSideData[idx_side]); \
 1868:                    if (idx_side >= mesh->ns) return;
 1869: 
 1870: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 1871:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 1872:                    if (idx_elem >= mesh->ne) return;
