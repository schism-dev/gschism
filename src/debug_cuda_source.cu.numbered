 2409: 
 2410: 
 2411: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2412: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2413: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2414: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2415:    Vector2 grad = {0.0, 0.0};
 2416:    int count = 0;
 2417: 
 2418:    if constexpr(ics == 2) assert(false && "computeHorGradientAtSide: ics = 2 not implemented");
 2419: 
 2420:    // First element
 2421:    if (elems[0] != nullptr && condition(elems[0])) {
 2422:       grad += elems[0]->grad2(field);
 2423:       count++;
 2424:    }
 2425: 
 2426:    // Second element
 2427:    if (elems[1] != nullptr && condition(elems[1])) {
 2428:       grad += elems[1]->grad2(field);
 2429:       count++;
 2430:    }
 2431: 
 2432:    if (count > 0) {
 2433:       grad = grad/count;
 2434:    }
 2435:    
 2436:    return grad;
 2437: }
 2438: 
 2439: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2 + n2->grav2); }
 2440: __inline__ __device__ int     Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 2441: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 2442: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1 + n2->eta1); }
 2443: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth + n2->depth); } 
 2444: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 2445: 
 2446: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 2447: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 2448: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 2449: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 2450: 
 2451: __inline__ __device__ double  Side::etaMeanBnd(void) const { assert(n1->nodeBnd != nullptr && n2->nodeBnd != nullptr && "etaMeanBnd not assigned"); 
 2452:                                                              assert(n1->nodeBnd->eta_mean >= -98 && n2->nodeBnd->eta_mean >= -98 && "Bad value for etaMeanBnd");
 2453:                                                              // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2454:                                                              return 0.5*(n1->nodeBnd->eta_mean + n2->nodeBnd->eta_mean); }
 2455: 
 2456: 
 2457: __inline__ __device__ double  Side::Cd(void)      const { if constexpr(nchi != 0) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 2458: 
 2459: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 2460: 
 2461: /**
 2462:  * This method performs backtracking from the side center until a time -dt back in time 
 2463:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2464:  * intermediate point.
 2465:  *
 2466:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2467:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2468:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2469:  * remaining time.
 2470:  * 
 2471:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2472:  * 
 2473:  * @param uuint, vvint, wwint: Velocities at the final point
 2474:  * @param jlev: Level at which the backtracking is performed
 2475:  * @param dt, dtbk: Tracking timesteps
 2476:  * @return: True if the backtracking was successful, false otherwise
 2477:  */
 2478: __inline__ __device__ bool Side::btrack(
 2479:       int jlev,
 2480:       double dt,            // Tracking time
 2481:       double dtbk,          // Tracking timestep
 2482:       Vector3 &u_int        // Velocities at the initial point
 2483: ) const {
 2484: 
 2485:    // Start from side center
 2486:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2487:  
 2488: 
 2489:    double time_rm = dt; // Remaining time
 2490: 
 2491: 
 2492:    // // Initialize outputs XXX
 2493:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2494:    //    sclr[i] = 0.0;
 2495:    // }
 2496: 
 2497: 
 2498:    // Initial velocities
 2499:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 2500: 
 2501:    // Find the element that is in the direction opposite to the velocity
 2502:    Element* curElem = findElementTowards(toVector2(u_int));
 2503: 
 2504:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2505:    if (curElem == nullptr) {
 2506:       // Make velocity parallel to the side
 2507:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2508:       u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2509:       curElem = otherElem(curElem);
 2510:       
 2511:    }
 2512: 
 2513: 
 2514: 
 2515:    const int MAX_ITERATIONS = 1000; 
 2516:    Element* nextElem = curElem;
 2517:    int iter = 0;
 2518:    while(true) {
 2519: 
 2520:       // Calculate timestep
 2521:       double dtb = min(dtbk, time_rm);
 2522: 
 2523:       // Next point in the backtracking curve
 2524:       Point3 xt = x0 - dtb*u_int;
 2525: 
 2526: 
 2527:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, this);
 2528:       assert(found && "Backtracking failed in btrack");
 2529: 
 2530:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2531:                       // then time_rm needs to be increased by the unused time.
 2532:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2533: 
 2534:       // The current point becomes the next segment's starting point.
 2535:       x0 = xt;
 2536:  
 2537:       curElem = nextElem;
 2538: 
 2539:       iter++;
 2540:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2541:    }
 2542: 
 2543: 
 2544: }
 2545: 
 2546: 
 2547: 
 2548: // /**
 2549: //    For a point (x1,y1) inside the element and a line segment (x1,y1)-(x2,y2), find the intersection point 
 2550: //    (xIntersect,yIntersect) and the side (intersectingSide) that it intersects.
 2551: 
 2552: //    Inputs:
 2553: //    @param x1, y1: point inside the element
 2554: //    @param x2, y2: other end of the line segment
 2555: 
 2556: //    Outputs:
 2557: //    @param intersectingSide:  side that intersects the line segment
 2558: //    @param nextElement: element that contains the intersection point
 2559: //    @param xIntersect, yIntersect: intersection point  
 2560: 
 2561: //    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 2562: //    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 2563: //    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 2564: 
 2565: //    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 2566: //    (Delta) being zero.
 2567: 
 2568: //    The intersection point happens when:
 2569: //    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 2570: //    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 2571:    
 2572: //    Assumption: the 4 points (including those of the side segment) are different.
 2573: //    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 2574: //    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 2575: //    If true, (xIntersect,yIntersect) is the intersection.				
 2576: //    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 2577: // **/
