 4226:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4227: 
 4228:       SIDE(side);
 4229: 
 4230: 
 4231:       side->U = {0.0, 0.0}; 
 4232:          
 4233:       if(side->isDry) return;
 4234: 
 4235:       const Node *node1 = side->n1;
 4236:       const Node *node2 = side->n2;
 4237: 
 4238:       // Vertically integrated velocity U (in ll if ics=2)
 4239:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 4240:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 4241:       }
 4242: 
 4243:    }
 4244: 
 4245:    __global__ void computeBottomDragVegetation(void) {
 4246:       // UNFINISHED. CHECK THIS:
 4247:       // How many kernels are needed? Why so many for loops?
 4248:       // Is the loop on sides needed?
 4249: 
 4250:       NODE(node);
 4251: 
 4252:       const int    kb      = node->kb;
 4253:       const double htot    = node->htot2();
 4254:       const double rough   = node->rough;
 4255: 
 4256: 
 4257:       if (node->isDry) {
 4258:          // Default values for dry nodes
 4259:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4260:          /// XXX CHECK INDICES
 4261:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4262:       }
 4263: 
 4264:       // Compute bottom drag Cd
 4265:       //--------------------------------
 4266: 
 4267:       // nchi = {-1, 0, 1} is the type of bottom drag.
 4268:       if (nchi==1) {
 4269: 
 4270:          bool ltmp = false; // for WBL iteration
 4271: 
 4272:          // Cdmax=-1 !max. Cd at node for this process (info only)
 4273:          // Drag at nodes
 4274:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 4275:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 4276:         
 4277:          const double rough = node->rough;
 4278:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4279:          if (node->rough == 0.0) {
 4280:             node->Cd = 0.0;
 4281: 
 4282:          } else { //roughness >0 
 4283:             
 4284:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 4285:             const double bthick = max(dzb_min, bthick_ori);
 4286: 
 4287:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 4288: 
 4289:             double tmp = 1.0/(2.5*log(bthick/rough));
 4290:             node->Cd = tmp*tmp;
 4291: 
 4292:          } // if rough
 4293: 
 4294: 
 4295:          // RECOVER THIS: XXX
 4296:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 4297:          // Output warning for WBL if iteration didn't converge
 4298: 
 4299: 
 4300:       } // nchi==1
 4301: 
 4302:       //   Bottom stress in m^2/s^2
 4303:       if (node->rho[kb + 1] >= -98.0)
 4304:       {
 4305:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 4306:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 4307:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4308:          // !sediment erosion: this part needs more documentation
 4309:       }
 4310: 
 4311:     
 4312:       // Compute vegetation parameters
 4313:       //--------------------------------
 4314: 
 4315:       // SAV constants
 4316:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4317:       constexpr double veg_cfpsi = 0.16;
 4318: 
 4319:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4320:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4321: 
 4322:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4323:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4324:          int kbin = 0; // bin index
 4325:          for (int k = kb; k < nvrt; k++) {
 4326:             // Computes node height above the bottom level
 4327:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4328:             assert(false && "Vertical variation of vegetation not implemented");
 4329: 
 4330:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4331:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4332:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4333:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4334:             // } else {
 4335:             //    // Find the bin at which the current vertical level is
 4336:             //    while (kbin<nbins_veg_vert) {
 4337:             //       const double zn = node->z[kbin];
 4338:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4339:             //          break;
 4340:             //       } // if
 4341:             //       kbin++;
 4342:             //    } // while
 4343:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4344: 
 4345:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4346:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4347:                
 4348:             //    // Linear interpolation of the vegetation parameters
 4349:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4350:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4351:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4352:             // } // if rl10
 4353: 
 4354:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4355: 
 4356:          } // for k
 4357: 
 4358: 
 4359:       } else { // Ganthy (iveg=2)
 4360:       //  Modify canopy height, diameter, and density
 4361: 
 4362:          // Make sure there is vegetation on this node
 4363:          if (node->veg_h_unbent > 0.0) {
 4364:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4365: 
 4366:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4367:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4368:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4369: 
 4370:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4371:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4372:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4373:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4374:          } // if veg_h_unbent
 4375: 
 4376:          for (int k = 0; k < nvrt; k++) {
 4377:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4378:          } // for k
 4379:       
 4380: 
 4381:       } // if iveg
 4382:      
 4383:          
 4384: 
 4385:       // Compute vertical mean of veg_alpha3D
 4386:       if (iveg != 0) {
 4387:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4388:          double sum1=0.0;
 4389:          double sum2=0.0;
 4390:          // Integrate over each level under the canopy...
 4391:          for (int k=kb; k<nvrt-1 && node->z[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 4392:             const double Dz = node->Dz(k);
 4393: 
 4394:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 4395:             sum2 += Dz;
 4396: 
 4397:          } // for k
 4398: 
 4399:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4400:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4401: 
 4402:       } // if iveg
 4403: 
 4404:    }
 4405: 
 4406:    __global__ void computeVegetationAndDragParameters(void) {
 4407:       // Computes the vegetation and drag model parameters:
 4408:       // chi, \tilde\chi, beta, \breve{H}
 4409:       
 4410:       SIDE(side);
 4411: 
 4412:       const double htot = side->htot2();
 4413:       const int    kb   = side->kb;
 4414: 
 4415:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4416: 
 4417:       const double veg_h     = side->veg_h();
 4418:       const double veg_nv    = side->veg_nv();
 4419:       const double veg_c     = side->veg_c();
 4420:       const double veg_beta  = side->veg_beta;
 4421:       const double veg_alpha = side->veg_alpha_vert_mean();
 4422: 
 4423:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4424:       // Velocity magnitude at the bottom level
 4425:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4426:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4427:       side->chi2 = side->Cd()*vmag1;
 4428:       side->chi  = side->chi2;
 4429:       if constexpr(iveg != 0) {
 4430:          const Node *n1 = side->n1;
 4431:          const Node *n2 = side->n2;
 4432:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4433:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4434:       }
 4435: 
 4436:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4437: 
 4438:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4439:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4440:       double magUa = 0.0;
 4441:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4442:          // 3D wet side with veg...
 4443: 
 4444:          double magUa = 0.0;
 4445:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4446:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4447: 
 4448:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4449:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4450:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4451: 
 4452:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4453:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4454: 
 4455:                // Velocity magnitude at the bottom (l) of the level
 4456:                const double ul = length(side->u2[k]);
 4457: 
 4458:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4459:                magUa += Dz*0.5*(uh + ul);
 4460: 
 4461:             } // if HasVegetation
 4462:          } // for k
 4463:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4464: 
 4465:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4466:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4467:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4468:             const double zCpy = side->zTopCanopy();
 4469:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4470:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4471:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4472:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4473:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4474:          } // if isSubmerged
 4475:       } // if iveg   
 4476: 
 4477:       // Computes the friction modified depth, \breve{H} in notes
 4478:       if (side->is2D()) { // 2D
 4479: 
 4480:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4481:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4482: 
 4483:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4484: 
 4485:          side->hhat = htot*htot/fricH; 
 4486: 
 4487:       } else { // 3D
 4488:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4489: 
 4490:          if constexpr(iveg != 0) {
 4491:             
 4492:             if (side->isSubmerged()) { 
 4493:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4494:                side->hhat -= veg_c*Hhat_alpha;
 4495: 
 4496:             } else { // Emergent
 4497:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4498:             }
 4499:          } // if iveg
 4500: 
 4501:          // Enforce positivity for 3D model
 4502:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4503:       } // if 3D
 4504: 
 4505:    }
 4506: 
 4507: 
 4508: 
 4509:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4510:    // Computes the density gradient between two elements, e1 and e2.
 4511:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4512:    // zero in the direction normal to the side. 
 4513:    // 
 4514:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4515:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4516:    //
 4517:    // Input:
 4518:    //    e1: Element
 4519:    //    e2: Neighbor element (or nullptr if boundary)
 4520:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4521:    //    k: Index of the half-level at which the density is interpolated
 4522:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4523:    // 
 4524:    // Output:
 4525:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4526:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4527: 
 4528:       if (e2 == nullptr || e2->isDry) {
 4529:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4530: 
 4531:          Side *side = e1->sides[j];
 4532:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4533:                  
 4534:          if constexpr(ics == 1) {
 4535:             vec = side->n; // Normal vector to the side
 4536:          } else {
 4537:             // IMPLEMENT THIS XXXXXX
 4538:             // !replace with xel, yel?
 4539:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4540:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4541:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4542:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4543:          } //ics
 4544:                    
 4545:          diffRho = 0.0;
 4546: 
 4547:       } else { //internal and wet
 4548:          if constexpr(ics==1) {
 4549:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4550: 
 4551:             // Vector from e1 to e2
 4552:             vec = toVector2(e2->center - e1->center);
 4553: 
 4554:          } else { 
 4555:             // IMPLEMENT THIS XXXXXX
 4556:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4557:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4558:             //                   alow(j)=xctr2
 4559:             //                   bdia(j)=yctr2
 4560:          } // ics
 4561: 
 4562:          diffRho = rho2 - e1->demeanedDensity(k);
 4563:       }
 4564: 
 4565:    }
 4566: 
 4567:    __global__ void computeDensityCubicSplines(void) {
 4568:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4569: 
 4570:       ELEM(elem);
 4571: 
 4572:       if (elem->isDry) return;
 4573: 
 4574:       const int kb = elem->kb;
 4575: 
 4576:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4577:       if (elem->is2D()) {
 4578:          // In the 2D case, the density is constant at the prism level. 
 4579:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4580:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4581:       } else { //3D
 4582: 
 4583:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4584:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4585:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4586:          ///// XXXX CHECK INDICES!!!!!
 4587:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4588:       } // 2D/3D
 4589: 
 4590:    }
 4591: } // extern "C"
 4592: 
 4593: 
 4594: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4595: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4596: 
 4597:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4598: 
 4599:    const int kb  = elem->kb;
 4600:    const int kb2 = elem2->kb;
 4601: 
 4602:    // z-coordinate of prism of elem
 4603:    const double zp = elem->z_prism(k);
 4604: 
 4605:    double rho = 0.0;
 4606: 
 4607:    if (elem2->is2D()) {
 4608:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4609: 
 4610:    } else {  // 3D
 4611: 
 4612:       // eta_min may be < zmax
 4613:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4614:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4615: 
 4616:       // (Extrapolate density below bottom, we will fix it later)
 4617:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4618:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4619:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4620:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4621:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4622:    } // 2D/3D
 4623:      
 4624: 
 4625:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4626:    // Now we need to fix it.
 4627:    if (elem->z[k] < elem2->z[kb2]) {
 4628:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4629: 
 4630:       // There are two methods to adjust the density at the bottom of the element.
 4631:       // iunder_deep=0: 
 4632:       const double depth1 = abs(elem->z[kb]); // larger depth
 4633: 
 4634:       if (iunder_deep==0) {
 4635: 
 4636:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4637: 
 4638:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4639: 
 4640:       } else { // iunder_deep != 0
 4641: 
 4642:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4643: 
 4644:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4645: 
 4646:          //   Demeaned density at the same z coordinate as
 4647:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4648:          }
 4649: 
 4650:       } // if iunder_deep
 4651:    } // if elem->z[kb] < elem2->z[kb]
 4652: 
 4653:    return rho;
 4654: }
 4655: 
 4656: 
 4657: extern "C" {
 4658:    __global__ void computeDensityGradient(void) {
 4659: 
 4660:          // Compute the horizontal density gradient at each element.
 4661:       // It works in two steps:
 4662:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4663:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4664:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4665:       //             gradRho.r1 = rho1 - rho0
 4666:       //             gradRho.r2 = rho2 - rho0
 4667:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4668:       // 
 4669:       //  NOTE: We use de-meaned densities.
 4670: 
 4671:       ELEM(elem);
 4672: 
 4673:       if (elem->isDry) return;
 4674: 
 4675:       const int kb  = elem->kb;
 4676:       const int i34 = elem->i34;
 4677: 
 4678:       for (int k = kb + 1; k < nvrt; k++) {
 4679:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 4680:          //             gradRho.r1 = rho1 - rho0
 4681:          //             gradRho.r2 = rho2 - rho0
 4682:          int icount = 0;
 4683:          double sumRx = 0.0;
 4684:          double sumRy = 0.0;
 4685:          for (int j1=0; j1<i34; j1++) { 
 4686: 
 4687:             const int j2 = elem->nxq(j1 + 1);
 4688: 
 4689:             // Pairs of consecutive neighbor elements of elem
 4690:             const Element *e1 = elem->nghbElems[j1];
 4691:             const Element *e2 = elem->nghbElems[j2];
 4692: 
 4693:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 4694:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 4695:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 4696: 
 4697:             // Compute the density difference and the vector from elem to e1 and e2
 4698:             // getRhoDiffAndVec takes into account boundaries/dry elements
 4699:             double diffRho1, diffRho2;
 4700:             Vector2 vec1, vec2;
 4701:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 4702:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 4703: 
 4704:             const double rl1 = length(vec1);
 4705:             const double rl2 = length(vec2);
 4706:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 4707: 
 4708:             const double delta = cross(vec1, vec2);
 4709:             const double sintheta = abs(delta)/(rl1*rl2);
 4710: 
 4711:             // To avoid problems, avoid elements with small angle between vectors
 4712:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 4713:             const bool validEq = (sintheta > sin_one_deg);
 4714: 
 4715:             if (validEq) {
 4716:                // Solve the system of equations to get the density gradient at elem
 4717:                icount++;
 4718:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 4719:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 4720:                sumRx += Rx;
 4721:                sumRy += Ry;
 4722:             }
 4723:          } // for j1
 4724: 
 4725:          // Compute the average density gradient at elem
 4726:          if (icount==0) {
 4727:            // Bad mesh quality; bail out with 0 b-cc
 4728:            elem->gradRho[k] = {0.0, 0.0};
 4729:          } else {
 4730:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 4731:          }
 4732: 
 4733:       } // for k
 4734: 
 4735:    }
 4736: 
 4737:    __global__ void computeBaroclinicTerm(void) {
 4738:    // Computes the baroclinic term at sides (at half levels).
 4739:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 4740:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 4741: 
 4742:       SIDE(side);
 4743: 
 4744:       if (side->isDry) return;
 4745: 
 4746:       const Element *e1 = side->elems[0];
 4747:       const Element *e2 = side->elems[1];      
 4748:       const int kb = side->kb;
 4749:       
 4750:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 4751: 
 4752:       // interpolates vertically the density gradient of the two elements at the half level/
 4753: 
 4754:       // Starts the integration at the surface and goes down to the bottom
 4755:       int k1 = nvrt - 1;
 4756:       int k2 = nvrt - 1;
 4757: 
 4758:       side->bcc[nvrt-1] = {0.0, 0.0};
 4759:       for (int k = nvrt-2; k >= kb; k--) {
 4760:       // For each prism level (from surface to bottom)...
 4761: 
 4762:          // For both elements, interpolate density gradient at the side's half level.
 4763:          // The gradient at the side is the average of the gradients at the elements.
 4764:          // w1, w2 are used to take into account boundary sides, with just one element.
 4765:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 4766:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 4767:          const double wsum = w1 + w2;
 4768:          w1 = w1/wsum;
 4769:          w2 = w2/wsum;
 4770:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 4771: 
 4772:          // Linear interpolation of both elements' density gradient at the shared side's level.
 4773:          Vector2 gradRho = {0.0, 0.0};
 4774:          if (e1 != nullptr && k > kb) {
 4775:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 4776:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 4777:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 4778:             
 4779:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 4780:          }      
 4781:          if (e2 != nullptr && k > kb) {
 4782:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4783:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4784:             
 4785:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4786:          }
 4787: 
 4788:          if constexpr(ics==2) {
 4789:             // IMPLEMENT THIS XXXXXX
 4790:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4791:             // swild(1)=tmp1
 4792:             // swild(2)=tmp2
 4793:          }
 4794:          
 4795:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4796:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4797:          // CHECK INDICES!!! XXX
 4798:          const double grav3 = side->grav3();
 4799:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4800: 
 4801:       } // for
 4802: 
 4803:    }
 4804: 
 4805: 
 4806: 
 4807:    __global__ void computeHorGradientAtSide(void) {
 4808: 
 4809:       // Compute the horizontal density gradient at each element.
 4810:       // It works in two steps:
 4811:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4812:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4813:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4814:       //             gradRho.r1 = rho1 - rho0
 4815:       //             gradRho.r2 = rho2 - rho0
 4816:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4817:       // 
 4818:       //  NOTE: We use de-meaned densities.
 4819: 
 4820:       SIDE(side);
 4821: 
 4822: // printf("side->isDry: %d\n", side->isDry);
 4823:       if (side->isDry) return;
 4824: 
 4825:       // Computes the gradient of the variables at the side center.
 4826:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 4827:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 4828:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 4829: 
 4830:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 4831:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 4832:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 4833:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 4834: // printf("gradEta1: %.15f, %.15f\n", side->gradEta1.x, side->gradEta1.y);
 4835: // printf("gradEta2: %.15f, %.15f\n", side->gradEta2.x, side->gradEta2.y);
 4836: // printf("gradETP: %.15f, %.15f\n", side->gradETP.x, side->gradETP.y);
 4837: // printf("gradPr: %.15f, %.15f\n", side->gradPr.x, side->gradPr.y);
 4838: 
 4839: 
 4840:    }
 4841: 
 4842: 
 4843:    __global__ void solveMomentumEquations(double time) {
 4844: 
 4845:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 4846:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 4847: 
 4848:       SIDE(side);
 4849: 
 4850: if (side->idx == 285) printf("XXXXXXXXX solveMomentumEquations: side idx = %d, isDry = %d\n", side->idx, side->isDry);      
 4851: 
 4852:       if (side->isDry) 
 4853:       {
 4854:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 4855: 
 4856:          return;
 4857:       }
 4858: 
 4859:       const Node *n1 = side->n1;
 4860:       const Node *n2 = side->n2;
 4861: 
 4862:       const int kb = side->kb;
 4863: 
 4864:       const double veg_h = side->veg_h();
 4865:       const double grav3 = side->grav3();
 4866: 
 4867:       if (side->is2D()) {
 4868:          // Warning: Do not use htot2, which is updated.
 4869:          const double htot = side->htot1();
 4870:          const double hhat = side->hhat;
 4871: 
 4872:          assert(hhat > 0.0 && htot > 0.0 && "Impossible dry 55:");
 4873: 
 4874:          Vector2 tau2 = {0.0, 0.0};
 4875:           
 4876:          if constexpr(ics==1) {
 4877:             tau2 = side->tau();
 4878: 
 4879:          } else {
 4880:             assert(false && "Not implemented: ics == 2");
 4881:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4882:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4883:             // taux2=(vn1+tt1)*0.5d0
 4884:             // tauy2=(vn2+ss1)*0.5d0
 4885:          } // if ics         
 4886: 
 4887:          // hat_gam has units of m/s
 4888: 
 4889:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 4890: 
 4891:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 4892:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 4893: 
 4894:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 4895: 
 4896:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 4897:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 4898: 
 4899:          for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 4900: 
 4901: 
 4902:       }
 4903:       else { // 3D
 4904: 
 4905:          // For 3D it is necessary to solve an implicit tridiagonal system.
 4906:          // 
 4907:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 4908:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 4909:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 4910:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 4911:          // k+1 and k.
 4912: 
 4913: 
 4914:          // // Define layer thickness & viscosity
 4915:          // for (int k=kb + 1; k<nvrt; k++) {
 4916:          //    const double dzz = side->Dz(k - 1);
 4917: 
 4918:          //    assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4919: 
 4920:          //    // Vertical viscosity at the face center
 4921:          //    dfz(k) = 0.25*(n1->dfv[k] + n2->dfv[k] + n1->dfv[k-1] + n2->dfv[k-1]);
 4922:         
 4923:          // }
 4924: 
 4925: 
 4926:          const int ndim = nvrt - kb;
 4927:          const double zTopCanopy = side->zTopCanopy();
 4928: 
 4929:          // Initialize the tridiagonal system
 4930:          for (int k = kb + 1; k<nvrt; k++) {
 4931:             
 4932:             const int kin = k - kb;
 4933: 
 4934:             // Vertical viscosity at the face center
 4935:             const double dfz = 0.25*(side->dfv(k) + side->dfv(k + 1));
 4936:             const double dzz = side->Dz(k);
 4937: 
 4938:             assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4939: 
 4940:             alow[kin] = 0.0;
 4941:             cupp[kin] = 0.0;
 4942:             bdia[kin] = 0.0;
 4943: 
 4944:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 4945:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 4946: 
 4947:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 4948:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 4949:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 4950: 
 4951:             // First part: layers k, k+1
 4952:             if (k < nvrt - 1) {
 4953:                              
 4954:                if constexpr(iveg != 0) {
 4955: 
 4956:                   // If there is vegetation at this level...
 4957:                   if (zTopCanopy > side->zc[k]) {
 4958:                      // If the canopy is above the k layer...
 4959:                      
 4960:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 4961:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 4962:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 4963:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 4964: 
 4965:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 4966:                      const double vmag2 = length(ut2);
 4967:                      const double vmag1 = length(side->u2[k]);
 4968:                      const double vmag = 0.5*(vmag1 + vmag2);
 4969:                      
 4970:                      // Computes the vegetation alpha at the face center
 4971:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 4972: 
 4973:                      cff1 += veg_alpha_sd*dt*vmag;
 4974: 
 4975:                   } // if (zTopCanopy
 4976:                } // if iveg
 4977: 
 4978:                const double tmp = dt*dfz/dzz;
 4979:                cupp[kin] += cff1*dzz/6.0 - tmp;
 4980:                bdia[kin] += cff1*dzz/3.0 + tmp;
 4981:             }
 4982: 
 4983: 
 4984:             // Second part: layers k-1, k
 4985:             if (k > kb + 1) {
 4986: 
 4987:                double cff1 = 1.0; //init \bar{c^k}
 4988: 
 4989:                if constexpr(iveg != 0) {
 4990:                   // If there is vegetation at this level...
 4991:                   if (zTopCanopy > side->zc[k-1]) {
 4992:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 4993:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 4994: 
 4995:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 4996: 
 4997:                      const double vmag2 = length(ut2);
 4998:                      const double vmag1 = length(side->u2[k-1]);
 4999:                      const double vmag = 0.5*(vmag1 + vmag2);
 5000: 
 5001:                      // Computes the vegetation alpha at the face center
 5002:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5003:                      cff1 += veg_alpha_sd*dt*vmag;
 5004:                   } // if zTopCanopy
 5005: 
 5006:                } // if iveg
 5007: 
 5008:                const double tmp = dt*dfz/dzz;
 5009:                alow[kin] += cff1*dzz/6.0 - tmp;
 5010:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5011: 
 5012:             } else { // Bottom boundary
 5013:                // This occurs at the bottom, where the bottom drag is applied.
 5014: 
 5015:                bdia[kin] += dt*side->chi2;
 5016: 
 5017:             } // if (k > kb + 1)
 5018: 
 5019: 
 5020: 
 5021:          } // for (int k
 5022: 
 5023: 
 5024: 
 5025:          // Computes the RHS.
 5026:          // -----------------
 5027: 
 5028:          //	BC to be imposed at the end.
 5029: 
 5030:          const Vector2 gradETP  = side->gradETP;
 5031:          const Vector2 gradPr   = side->gradPr;
 5032:          const Vector2 gradEta1 = side->gradEta1;
 5033:          const Vector2 gradEta2 = side->gradEta2;
 5034: 
 5035:          const Vector2 *btu = side->btu;
 5036:          const Vector2 *u2  = side->u2;
 5037:          const double coriolis = side->coriolis;
 5038:          const Vector2 *nuGradU = side->nuGradU;
 5039: 
 5040: 
 5041:          for (int k = kb + 1; k<nvrt; k++) {
 5042:             const int kin = k - kb;
 5043: 
 5044:             const double dz_0 = side->Dz(k);
 5045:             const double dz_1 = side->Dz(k+1);  
 5046: 
 5047:             rrhs[kin] = {0.0, 0.0};
 5048:             double dz = 0.0;
 5049: 
 5050:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5051:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5052:             if (k < nvrt  ) dz += 0.5*dz_1;
 5053:             if (k > kb + 1) dz += 0.5*dz_0;
 5054: 
 5055:             // Elevation gradient, atmospheric pressure and tidal potential
 5056:             rrhs[kin] = -dz*dt*(grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0);
 5057: 
 5058:             // Coriolis, advection, wind stress, and horizontal viscosity
 5059:             if (k < nvrt - 1) {
 5060: 
 5061: 
 5062:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5063:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5064:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5065: 
 5066:                //diff stress tensors 1006
 5067:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5068:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5069:                   assert(false && "Not implemented: itur == 5");
 5070:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5071:                }
 5072: 
 5073:             } else { // k=nvrt
 5074:                Vector2 tau2 = {0.0, 0.0};
 5075:                if constexpr(ics==1) {
 5076:                   tau2 = side->tau();
 5077:                } else {
 5078:                   assert(false && "Not implemented: ics == 2");
 5079:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5080:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5081:                   // taux2=(vn1+tt1)*0.5d0
 5082:                   // tauy2=(vn2+ss1)*0.5d0
 5083:                } // if ics
 5084: 
 5085:                rrhs[kin] += dt*tau2;
 5086: 
 5087:             } // if k<nvrt
 5088: 
 5089:             if (k > kb + 1) {
 5090:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5091:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5092:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5093: 
 5094: 
 5095:                // diff stress tensors 1006
 5096:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5097:                   assert(false && "Not implemented: itur == 5");
 5098:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5099:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5100:                }
 5101: 
 5102:             } // if k>kbs + 1
 5103: 
 5104:             // Baroclinic
 5105:             Vector2 *bcc = side->bcc;
 5106:             if constexpr(ibc == 0) {
 5107:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5108:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5109: 
 5110:             } // if ibc==0
 5111: 
 5112: 
 5113:          } // k=kb + 1,nvrt
 5114: 
 5115:    // tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 5116:          tridag_sch<2>(nvrt, alow, bdia, cupp, (double *)rrhs, (double *)u, (double *)gam);
 5117: 
 5118: 
 5119:          for (int k=kb + 1; k<nvrt; k++) {
 5120:             const int kin = k - kb;
 5121: 
 5122:             // Velocity is always clamped to maximum values
 5123:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5124:          } // k
 5125: 
 5126:       } // if side->is2D()
 5127:       
 5128: 
 5129:       // Impose velocity boundary condition at the bottom
 5130:       if constexpr(imm == 2) { // 3D bed deformation model
 5131:          double dep;
 5132:          Vector2 vel;
 5133: 
 5134:          assert(false && "Not implemented: imm == 2");
 5135:          //update_bdef(time, x0, y0, dep, vel);
 5136:          // side->u2[kb] = vel;
 5137: 
 5138:       } else { // imm = 0 or 1
 5139:          if (side->Cd() == 0.0) {
 5140:             side->u2[kb] = side->u2[kb + 1];
 5141:          } else if (nvrt - 1 > kb + 1) { // 3D no slip bottom   XXXXX use is3D()?
 5142: printf("XXXXXXXXX computeFlowBcVelocities: 3D no slip bottom, side idx = %d\n", side->idx);
 5143:             side->u2[kb] = {0.0, 0.0};
 5144:          }
 5145:           
 5146:       } // if imm
 5147: 
 5148:       // The velocities below the bottom level are set to zero
 5149:       for (int k=0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5150: 
 5151: 
 5152:    }
 5153: 
 5154: 
 5155:    __global__ void applyMomentumBC(void) {
 5156: 
 5157:       SIDE_BND(sideBnd);
 5158: 
 5159:       Side *side = sideBnd->side;
 5160:       const BoundarySegment *segment = sideBnd->segment;
 5161:       const Node *n1 = side->n1;
 5162:       const Node *n2 = side->n2;
 5163: 
 5164:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5165: 
 5166:       // REMEMEBER, this is a trick, segment can be a pointer or (-1, -2)
 5167:       const bool isLand = segment->isLand;
 5168:       const int ifltype = segment->ifltype;
 5169: 
 5170:       const int kb = side->kb;
 5171: 
 5172:       if (!isLand && ifltype != 0) {
 5173:          const Vector2 *ubc = sideBnd->ubc;
 5174:   
 5175:          for (int k=kb; k < nvrt; k++) {
 5176:             
 5177:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5178:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5179: 
 5180:             if (ifltype == -1) {
 5181:                // Flather 1
 5182: 
 5183:                const double depth = side->depth();
 5184: 
 5185:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5186: 
 5187:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5188: 
 5189:                side->u2[k] = vnorm*side->n;
 5190: 
 5191:             } else if (ifltype == -2) { // Discharge
 5192: 
 5193:                const double eta1 = side->eta1();
 5194:                const double eta2 = side->eta2();
 5195:                const double htot = side->htot2();
 5196: 
 5197:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5198:                assert(false && "Not implemented: Discharge bc");
 5199:                // const double dischrg = discharge(eta1);
 5200:                const double dischrg = 0.0; // XXX REMOVE
 5201:                
 5202: 
 5203:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5204: 
 5205:                const double vnorm = dischrg*eta2/htot;
 5206: 
 5207:                side->u2[k] = vnorm*side->n;
 5208: 
 5209: 
 5210:             }
 5211:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5212:                const double vnorm = dot(side->u2[k], side->n);
 5213: 
 5214:                double rat;
 5215:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5216:                else              rat = segment->vobc2; // outgoing
 5217: 
 5218:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5219:             }
 5220:             else { // not Flather or 3D radiation
 5221:                side->u2[k] = ubc[k];
 5222: 
 5223:             } // if (segment->ifltype...
 5224: 
 5225:          }
 5226: 
 5227:       }
 5228:       else if (isLand) { // if it is land boundary side
 5229: 
 5230:          if constexpr(islip == 0) { // free slip
 5231: 
 5232:             for (int k=kb; k < nvrt; k++) {
 5233: 
 5234:                const Vector2 t = side->t();
 5235:                const Vector2 n = side->n;
 5236: 
 5237:                double vnorm = 0.0; // for most cases
 5238:                const double vtan = dot(side->u2[k], t);
 5239:                
 5240:                side->u2[k] = vtan*t - vnorm*n;
 5241: 
 5242:             }
 5243: 
 5244:          } else { // no slip
 5245:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5246: 
 5247:          }
 5248:       } // if (side segment type...
 5249: 
 5250:    
 5251: 
 5252:    }
 5253: 
 5254: 
 5255:    __global__ void shapiroFilter1(void) {
 5256:       // First step of the Shapiro filter (normally used if indvel<=0)
 5257:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5258: 
 5259:       SIDE(side);
 5260: 
 5261:       // Only internal wet sides are processed
 5262:       if (side->isDry || !(side->isInternal())) return;
 5263: 
 5264:       const int kb = side->kb;
 5265: 
 5266:       for (int mm = 1; mm <= niter_shap; mm++) {
 5267: 
 5268:          for (int k = kb + 1; k < nvrt; k++) {
 5269:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5270:             side->bcc[k] = {0.0, 0.0};
 5271:             Vector2 suru = {0.0, 0.0};
 5272: 
 5273:             for (int j=0; j<4; j++) { // 4 neighbors per side
 5274: 
 5275:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5276: 
 5277:                int kin = k;
 5278:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5279:                
 5280:                if constexpr(ics==1) {
 5281:                   suru += nSide->u2[kin];
 5282: 
 5283:                } else {
 5284:                   assert(false && "Not implemented: ics == 2");
 5285:                   // Vector2 vn1, vn2;
 5286:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5287:                   // suru=suru+vn1;
 5288:                   // surv=surv+vn2;
 5289:                }
 5290:             }
 5291: 
 5292: 
 5293:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5294: 
 5295:          }
 5296:       }
 5297:    }
 5298: 
 5299:    __global__ void shapiroFilter2(void) {
 5300:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5301: 
 5302:       SIDE(side);
 5303: 
 5304: // side->u2[1] = {10.0,-10.0}; 
 5305: // side->u2[0] = {10.0,-10.0};
 5306: // return;      
 5307: 
 5308:       if (side->isDry || !(side->isInternal())) return;
 5309: 
 5310:       const int kb = side->kb;
 5311: 
 5312:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5313: 
 5314:       if (side->is2D()) {
 5315:          // side->u2[kb] = side->u2[nvrt - 1];
 5316:          side->u2[kb + 1] = side->bcc[kb + 1];
 5317:          side->u2[kb    ] = side->u2 [nvrt - 1];
 5318: 
 5319:       } else {
 5320:          // 3D
 5321:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5322:          
 5323:       }
 5324: 
 5325:    }
 5326: 
 5327: 
 5328:    __global__ void ul0UpdateZCoords(void) {
 5329:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5330:       
 5331:       NODE(node);      
 5332: 
 5333:       if (node->isDry2()) { 
 5334: 
 5335:          assert((ivcor != 2) && (node->depth < mesh->h_s) && "Deep depth dry");
 5336: 
 5337:          if constexpr(ivcor != 1) node->kb = 0;
 5338: 
 5339:       } else {
 5340: 
 5341:          node->updateKb();
 5342:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5343: 
 5344:       }
 5345: 
 5346:       // We use the temp.b field to store the previous state of isDry.
 5347:       node->tmp.b = node->isDry;
 5348: 
 5349:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5350:       node->isDry = true;
 5351: 
 5352:    }
 5353: 
 5354:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5355:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5356:    {
 5357:       ELEM(elem);
 5358: 
 5359:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5360: 
 5361:       // All the nodes of a wet element are wet.
 5362:       if (!elem->isDry) {
 5363:          elem->nodes[0]->isDry = false;
 5364:          elem->nodes[1]->isDry = false;
 5365:          elem->nodes[2]->isDry = false;
 5366:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 5367: 
 5368:       }
 5369: 
 5370: 
 5371:       elem->kb = 0;
 5372: 
 5373:       if (elem->isDry) return;
 5374: 
 5375:       // Wet
 5376:       const Node *n1 = elem->nodes[0];
 5377:       const Node *n2 = elem->nodes[1];
 5378:       const Node *n3 = elem->nodes[2];  
 5379:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5380: 
 5381:    //    if(elem->isDry2()) {
 5382:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5383:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5384:    //        call parallel_abort(errmsg)
 5385:    //    }
 5386: 
 5387: 
 5388:       // Computes element's kb as the minimum of the nodes' kb.
 5389:       const int kb1 = n1->kb;
 5390:       const int kb2 = n2->kb;
 5391:       const int kb3 = n3->kb;
 5392:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5393: 
 5394: 
 5395:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5396: 
 5397: 
 5398:       // Computes the element z as the mean of the nodes z.
 5399:       for (int k = elem->kb; k < nvrt; k++) {
 5400: 
 5401:          // Compute the element z as the mean of the nodes z.
 5402:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5403:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5404:          elem->z[k] /= elem->i34;
 5405: 
 5406:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5407:       }
 5408:                   
 5409:    }
 5410: 
 5411:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5412:    {
 5413:       NODE(node);
 5414:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5415: 
 5416:       if (it == iths) return;
 5417: 
 5418: 
 5419:       if(!node->isDry && node->tmp.b) { // rewetted
 5420:          for (int k=0; k < nvrt; k++) {
 5421: 
 5422:             Vector3 utmp={0.0, 0.0, 0.0};
 5423: 
 5424:             double ttmp=0.0;
 5425:             double stmp=0.0;
 5426:             int icount=0;
 5427:             for (int j = 0; j < node->numNodes; j++) {
 5428: 
 5429: 
 5430:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5431:                if (!node->isDry) { // all indices extended
 5432:                   icount++;
 5433: 
 5434:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5435:                   utmp += node->u2[k];
 5436:                   
 5437:                   ttmp += node->tracers[k].tracer[0]; 
 5438:                   stmp += node->tracers[k].tracer[1]; 
 5439:                }
 5440:             }
 5441: 
 5442:             if(icount > 0) {
 5443:                const double inv_icount = 1.0/icount;
 5444:                node->u2[k]     = inv_icount*utmp;
 5445:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5446:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5447:             }
 5448:          }
 5449:       }
 5450:    }
 5451: 
 5452: 
 5453:    __global__ void ul0UpdateSides(int it, int iths) {
 5454: 
 5455:       SIDE(side);
 5456: 
 5457:       // A side is wet if and only if at least one of its elements is wet.
 5458:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5459: 
 5460:       const Node *n1 = side->n1;
 5461:       const Node *n2 = side->n2;
 5462:       const int kb1 = n1->kb;
 5463:       const int kb2 = n2->kb;
 5464: 
 5465:       side->kb = 0; // dry
 5466: 
 5467:       if (isWet) {
 5468: 
 5469:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5470: 
 5471:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5472: 
 5473:          side->kb = min(kb1, kb2);
 5474: 
 5475:          for (int k = side->kb; k < nvrt; k++) {
 5476:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5477: 
 5478:          
 5479:             assert((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0) && "Weird side (3)");
 5480: 
 5481:             // Compute velocity for re-wetted sides 
 5482:             if ((it != iths) && (side->isDry && isWet)) {
 5483:             
 5484:                Vector2 utmp={0.0, 0.0};
 5485: 
 5486:                int icount=0;
 5487: 
 5488:                // For all the sides on the two elements that share this side
 5489:                for (int j=0; j < 2; j++) {
 5490:                   const Element *elem = side->elems[j];
 5491:                   if (elem == nullptr) continue;
 5492: 
 5493:                   for (int jj=0; jj < elem->i34; jj++) {
 5494:                      const Side *nSide = elem->sides[jj];
 5495:                      if (nSide->isDry) continue;
 5496: 
 5497:                      icount++;
 5498:                      utmp += nSide->u2[k];                     
 5499:                   }
 5500:                }
 5501:                   
 5502:                assert(icount > 0 && "No wet sides around this side");
 5503:                if (icount > 0)  side->u2[k] = utmp/icount;
 5504:                   
 5505:             } // if ((it != iths) && (side->isDry && isWet))
 5506: 
 5507:          } // for k
 5508: 
 5509:       } // if isWet
 5510:    
 5511:       side->isDry = !isWet;
 5512: 
 5513:    }
 5514: 
 5515: 
 5516:    __global__ void zeroNodalVelocities(void) {
 5517:       NODE(node);
 5518: 
 5519:       for (int k = 0; k < nvrt; k++) {
 5520:          node->u2[k]   = {0.0, 0.0, 0.0};
 5521:          node->utmp[k] = {0.0, 0.0};
 5522:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5523:       }
 5524:    }
 5525: 
 5526:    __global__ void computeNodalVerticalVelocities1(void) {
 5527:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5528:    // Adds the element's vertical velocity times the element's area.
 5529:       ELEM(elem);
 5530: 
 5531:       for (int j = 0; j < elem->i34; j++) {
 5532:          Node *node = elem->nodes[j];
 5533: 
 5534:          for (int k = node->kb; k < nvrt; k++) {
 5535:             atomicAdd(&(node->u2[k].z), elem->w[k]*elem->area);
 5536:          }
 5537:          atomicAdd(&(node->tmp.d), elem->area);
 5538:       }
 5539:    }
 5540: 
 5541:    __global__ void computeNodalVerticalVelocities2(void) {
 5542:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5543:    // Divides by the total area of the elements sharing the    node.
 5544:       NODE(node);
 5545: 
 5546:       for (int k = node->kb; k < nvrt; k++) node->u2[k].z = node->u2[k].z / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5547:    }
 5548: 
 5549: 
 5550:    __global__ void computeNodalHorizontalVelocities1(void) {
 5551:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 5552:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 5553: 
 5554:       ELEM(elem);
 5555: 
 5556:       const int kb = elem->kb;
 5557:       const bool isTri = elem->isTri();
 5558: 
 5559:       if constexpr(indvel <= 0) {
 5560:          // Assuming discontinoius hvel.
 5561: 
 5562: 
 5563:          if (isTri) { // For triangles
 5564:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated at one node can be
 5565:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 5566: 
 5567:             for (int j = 0; j < 3; j++) {
 5568:                // For every node of the triangle...
 5569:                Node *node = elem->nodes[j];
 5570: 
 5571:                const Side *s1 = elem->sides[j];
 5572:                const Side *s2 = elem->sides[(j + 1) % 3];
 5573:                const Side *s3 = elem->sides[(j + 2) % 3];
 5574: 
 5575:                const int numElements = node->numElements;
 5576: 
 5577:                for (int k = kb; k < nvrt; k++)  {
 5578:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k];
 5579:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 5580:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 5581:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 5582:                   atomicAdd(&(node->utmp[k].x), (1.0/numElements) * u.x);
 5583:                   atomicAdd(&(node->utmp[k].y), (1.0/numElements) * u.y);
 5584: 
 5585:                }
 5586: 
 5587:             }
 5588:          }
 5589:          else { // For quads
 5590: 
 5591:          }
 5592: 
 5593:       }
 5594:       
 5595:    }
 5596: 
 5597: 
 5598:    __global__ void computeNodalHorizontalVelocities2(void) {
 5599:       NODE(node);
 5600: 
 5601:       for (int k = 0; k < nvrt; k++) {
 5602:          node->u2[k] = toVector3(node->utmp[k], node->u2[k].z);
 5603:       }
 5604:       
 5605:    }   
 5606: 
 5607:    __global__ void computeNodalHorizontalVelocitiesOLD(void) {
 5608:    // XXXX I'm not sure where I got this function from. 
 5609:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 5610:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 5611:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 5612:    // It uses the utmp array as a temporary array to store the velocities.
 5613: 
 5614:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 5615: 
 5616:       SIDE(side);
 5617: 
 5618:       const int kb = side->kb;
 5619: 
 5620:       Node *n1 = side->n1;
 5621:       Node *n2 = side->n2;
 5622: 
 5623:       for (int k = kb; k < nvrt; k++) {
 5624: 
 5625:          // Cast the u2 vector into a Vector2 
 5626:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&(n1->utmp[k]));
 5627:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&(n2->utmp[k]));
 5628: 
 5629:          n1_u2 = side->u2[k]/n1->numSides;
 5630:          n2_u2 = side->u2[k]/n2->numSides;
 5631: 
 5632:       }
 5633: 
 5634: 
 5635:    }
 5636: 
 5637:    __global__ void resetVelocityOpenBndNodes(void) {
 5638:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 5639: 
 5640:       NODE_BND(nodebnd);
 5641: 
 5642:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 5643:          for (int k = 0; k < nvrt; k++) nodebnd->node->u2[k] = {0.0, 0.0, 0.0};
 5644:       }
 5645: 
 5646:    }
 5647: 
 5648: 
 5649:    __global__ void setVelocityOpenBndNodes(void) {
 5650:    // For open boundary nodes sets their velocity to the imposed values.
 5651: 
 5652:       SIDE_BND(sidebnd);
 5653: 
 5654:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 5655:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 5656:          // to its segment to the average of the side velocity.
 5657: 
 5658:          for (int k = 0; k < nvrt; k++) {
 5659:             Node *n1 = sidebnd->side->n1;
 5660:             Node *n2 = sidebnd->side->n2;
 5661: 
 5662:             // Cast the u2 vector into a Vector2 
 5663:             Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&n1->u2[k]);
 5664:             Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&n2->u2[k]);
 5665: 
 5666:             if (n1->nodeBnd->segment == sidebnd->segment) {
 5667:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 5668:             }
 5669:             if (n2->nodeBnd->segment == sidebnd->segment) {
 5670:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 5671:             }
 5672: 
 5673:          }
 5674:       }
 5675: 
 5676:    }
 5677: 
 5678: 
 5679:    __global__ void computeVerticalVelocity(void) {
 5680:       // Computes the vertical velocity at the (2D) element's centroid.
 5681:       // In this function we will be considering volumetric elements, with side faces and a 
 5682:       // bottom and a top face. We will call them SFs, BF and TF.
 5683:       // It computes the flux coming from BF and the SFs.
 5684:       // If the bed is moving, it takes that into account.
 5685:       // Since water is incompressible, the integral of the velocity times the normal vector
 5686:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 5687:       // and the BF is equal to the flux going out from the TF.
 5688:       // TF = - BF - sum(SFs).
 5689:       // It then computes the horizontal velocity at the center of TF.
 5690:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 5691:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 5692:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 5693: 
 5694:       ELEM(elem);
 5695: 
 5696:       if (elem->isDry) return;
 5697: 
 5698:       const int kb = elem->kb;
 5699:       const bool isTri = elem->isTri();
 5700: 
 5701:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 5702: 
 5703:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 5704:       const double av_bdef1 = elem->mean(&Node::bdef1);
 5705:       const double av_bdef2 = elem->mean(&Node::bdef2);
 5706: 
 5707:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 5708: 
 5709:       double area3D;
 5710: 
 5711:       // Bottom face flux
 5712:       double bottomFlux = 0.0;
 5713:       Vector2 u2meanBottom = {0.0, 0.0};
 5714:       const Vector2 gradh = elem->grad2(&Node::depth);
 5715:       if constexpr(imm==2) {
 5716:          Vector3 ubed;
 5717: 
 5718:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 5719:          // updateBDEF(ubed);
 5720:      
 5721:          // const double bflux0 = dot(ubed, elem_n1);
 5722: 
 5723:          // elem->w[kb] += ubed.z;
 5724:       }
 5725:       else {
 5726:          Vector2 umean;
 5727:          if constexpr(ics == 1) {
 5728:             u2meanBottom = elem->mean(kb, &Side::u2);
 5729:          }
 5730:          else {
 5731:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 5732:          }
 5733: 
 5734:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 5735:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 5736: 
 5737:          bottomFlux = - dot(gradh, u2meanBottom);
 5738:       } // if imm
 5739: 
 5740:       // Compute w for kb+1 to nvrt-1
 5741:       for (int l = kb; l < nvrt - 1; l++) {
 5742: 
 5743:          // normal vector to the top face of the "volumetric" element (3D)
 5744:          Vector3 elem_n2 = elem->n(l + 1, area3D); 
 5745: 
 5746:          // Compute the total flux at the sides
 5747:          double sideFlux = 0.0;
 5748:          Vector2 u2top = {0.0, 0.0};
 5749:          for (int j = 0; j < elem->i34; j++) {
 5750:             const Side *side = elem->sides[j];
 5751: 
 5752:             const double sideArea = side->area(l);
 5753:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 5754:             const double sign = elem->ssign[j]; 
 5755: 
 5756:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 5757:          }
 5758:          
 5759:          // Compute the horizontal velocity at the center of the top face as an average of the 
 5760:          //velocities at the centers of the sides
 5761:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 5762: 
 5763:          // The flx at the top ace can be computed from the other flows.
 5764:          const double topFlux = - sideFlux - bottomFlux;
 5765:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 5766: 
 5767:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 5768: 
 5769:          elem_n1 = elem_n2;
 5770: 
 5771:          bottomFlux = - topFlux;
 5772:       }
 5773:    }  
 5774: 
 5775: 
 5776: 
 5777: 
