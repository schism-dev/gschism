 7840: //                     endif !itrtype
 7841: 
 7842: //                   enddo !jj
 7843: 
 7844: //                   !Tally horizontal mass in for inflow case
 7845: //                   if(max_iadjust_mass_consv>0) h_mass_in(:)=h_mass_in(:)-trel_tmp_outside(1:ntr)*flux_adv_hface(k,jsj)*dtb
 7846: //                 endif !iel
 7847: 
 7848: //                 !!upwind part
 7849: //                 !if(k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)<0) then !inflow
 7850: //                 !  do jj=1,ntr
 7851: //                 !    adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*abs(flux_adv_hface(k,jsj))*(trel_tmp_outside(jj)-trel_tmp(jj,k,i))
 7852: //                 !  enddo
 7853: //                 !endif
 7854: //                 !!weno correction
 7855: //                 !if (iweno) then
 7856: //                 !  if(k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)<0) then !inflow
 7857: //                 !    do jj=1,ntr
 7858: //                 !      adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*abs(flux_adv_hface(k,jsj))*(trsd_tmp(jj,k,jsj)-trel_tmp_outside(jj))
 7859: //                 !    enddo
