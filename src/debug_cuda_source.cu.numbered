 7085: __global__ void printMatrix(bool full) {
 7086:    // Debugging: print the matrix
 7087: 
 7088:    const int size = mesh->np;
 7089:    double sum = 0.0;
 7090:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7091:       const Node *node = mesh->localNodeData + idx_node;
 7092:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7093:       for (int j = 0; j < node->numNodes; j++) {
 7094:          Node* nbNode = node->nodes[j];
 7095:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7096:          sum += node->coeffMatrix[j];
 7097:       }
 7098:       if (full) printf("]\n");
 7099: 
 7100: 
 7101:    }
 7102:    if (!full) printf("sum=%lf\n", sum);
 7103: }
