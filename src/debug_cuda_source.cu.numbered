 8345: #ifdef OLD_PCG_SOLVER
 8346: __global__ void computeMatrixProductAndDotProducts() {
 8347:    // Computes A*p, r'Mr and p'Ap
 8348: 
 8349:    // 1) shared buffer: first half for rMr, second for pAp
 8350:    __shared__ double sdata[2*BLOCK_SIZE];
 8351:    double* s_rMr = sdata;
 8352:    double* s_pAp = sdata + BLOCK_SIZE;
 8353: 
 8354:    const int tid = threadIdx.x;
 8355: 
 8356:    double l_pAp = 0.0;
 8357: 
 8358:    s_rMr[tid] = 0.0;
 8359:    s_pAp[tid] = 0.0;
 8360: 
 8361:    // 2) get your node pointer
 8362:    // NODE(node);   
 8363:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 8364:    Node *node = &(mesh->localNodeData[idx_node]); 
 8365:       if (idx_node < mesh->np) {
 8366: 
 8367:       const double diag = node->coeffDiag;
 8368:       const double r    = node->mR;
 8369:       const double p    = node->mP;  
 8370: 
 8371:       // apply preconditioner on the fly:
 8372:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 8373: 
 8374:       // 4) compute Ap = A.p
 8375:       double Ap = node->coeffDiag * node->mP;
 8376:       for (int j = 0; j < node->numNodes; ++j) {
 8377:          const Node *nbNode = node->nodes[j];
 8378:          Ap += node->coeffMatrix[j] * nbNode->mP;
 8379: 
 8380:       }
 8381: 
 8382:       node->mAp = Ap;
 8383:       
 8384: 
 8385:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 8386:       // const double l_rMr = r*Mr;  // r'Mr
 8387:       l_pAp = p*Ap;  // p'Ap
 8388: 
 8389: 
 8390:    }
 8391: 
 8392:    // 6) write into shared mem
 8393:    // s_rMr[tid] = l_rMr;
 8394:    s_pAp[tid] = l_pAp;
 8395: 
 8396:    __syncthreads();
 8397: 
 8398:    // 7) block-wide tree reduction
 8399:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8400:       if (tid < stride)  {
 8401:          s_pAp[tid] += s_pAp[tid + stride];
 8402:       }
 8403:       __syncthreads();
 8404:    }
 8405: 
 8406:    // 8) thread 0 atomically accumulates into the globals
 8407:    // XXX: This is slower than it needs to be, but it is simple and works
 8408:    if (tid == 0) {
 8409:       atomicAdd(pAp, s_pAp[0]);
 8410:    }
 8411: 
 8412: 
 8413: }
 8414: 
 8415: 
 8416: __global__ void updateSolutionAndDotProducts(void) {
 8417:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 8418: 
 8419:    const int tid = threadIdx.x;
 8420: 
 8421:    s_rMr[tid] = 0.0;
 8422: 
 8423:    // get node & bounds-check:
 8424:    NODE(node);
 8425: 
 8426:    
 8427:    // Compute alpha
 8428:    const double alpha = (*rMr_old)/(*pAp); 
 8429: 
 8430: 
 8431:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 8432: 
 8433: 
 8434:    // load scalars
 8435:    const double diag = node->coeffDiag;
 8436:    const double p    = node->mP;
 8437:    const double Ap   = node->mAp;
 8438:    const double x    = node->mX;
 8439:    const double r    = node->mR;
 8440:    
 8441:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 8442: 
 8443:    // 1) update solution & residual
 8444:    const double x_new = x + alpha*p;
 8445:    const double r_new = r - alpha*Ap;
 8446:    node->mX = x_new;
 8447:    node->mR = r_new;
 8448: 
 8449:    // 2) apply Jacobi preconditioner on the fly
 8450:    const double Mr_new = r_new/diag;
 8451: 
 8452: 
 8453:    // 3) local contributions for the two dot-products
 8454:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 8455: 
 8456:    // 4) write into shared-mem
 8457:    s_rMr[tid] = l_rMr;
 8458: 
 8459:    __syncthreads();
 8460: 
 8461: 
 8462:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8463:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8464:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8465:       __syncthreads();
 8466:    }
 8467: 
 8468:    // 6) thread 0 atomically folds into the global accumulators
 8469:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 8470: 
 8471: 
 8472: }
 8473: 
 8474: 
 8475: __global__ void updateSearchDirection() {
 8476: 
 8477:     NODE(node);
 8478: 
 8479:     // recompute z on-the-fly
 8480:     const double z = node->mR / node->coeffDiag;
 8481:     const double p = node->mP;
 8482: 
 8483:     const double beta = (*rMr_new)/(*rMr_old);
 8484: 
 8485: 
 8486:     // p =z + beta*p
 8487:     node->mP = z + beta*p;
 8488: 
 8489: }
 8490: 
 8491: __global__ void initializeScalars(double *scalars) {
 8492: 
 8493:    // These point to a cupy array in the host code
 8494:    rMr_old = scalars + 0;
 8495:    rMr_new = scalars + 1;
 8496:    pAp     = scalars + 2;
 8497: }
 8498: 
 8499: __global__ void initializePreconditionedResidual(void) {
 8500: 
 8501:     __shared__ double s_rMr[BLOCK_SIZE];  
 8502: 
 8503:     s_rMr[threadIdx.x] = 0.0;
 8504: 
 8505:     NODE_ALL(node, valid);
 8506:     const int tid = threadIdx.x;
 8507:     // For the first iteration:
 8508:     // 1. Initial solution x = 0 (already set)
 8509:     // 2. Initial residual r = b (stored in qel)
 8510:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 8511: 
 8512: // XXX we should use the guess solution here    
 8513: 
 8514:     double l_rMr = 0.0;
 8515:     if (valid) {
 8516:       // Set initial residual r = b (from qel)
 8517:       node->mR = node->qel;
 8518: 
 8519:       // Compute z = M^-1 * r (preconditioned residual)
 8520:       const double z = node->mR / node->coeffDiag;
 8521: 
 8522:       // Set initial search direction p = z
 8523:       node->mP = z;
 8524: 
 8525:       // Initialize other variables needed for CG
 8526:       node->mX = 0.0;  // Initial solution
 8527:       node->mAp = 0.0; // Will be computed in first iteration
 8528: 
 8529: 
 8530:       // Computes the first r'Mr (reduction)
 8531:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 8532:     }
 8533:     // 4) write into shared-mem
 8534:     s_rMr[tid] = l_rMr;
 8535: 
 8536:     __syncthreads();
 8537: 
 8538: 
 8539:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8540:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8541:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8542:         __syncthreads();
 8543:     }
 8544: 
 8545:     // 6) thread 0 atomically folds into the global accumulators
 8546:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 8547: 
 8548:     *rMr_old = 0.0;
 8549:     *pAp = 0.0;
 8550: }
 8551: #endif
 8552: 
 8553: extern "C" __global__ void getElementVarFunc(int varCode, double *res) {
