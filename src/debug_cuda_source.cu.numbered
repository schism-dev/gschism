 2785: 
 2786: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2787: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2788: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2789: // Only when ics == 2, the origin is at the element center.
 2790: 
 2791:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2792: 
 2793:    const Node *node = nodes[idxNode];
 2794: 
 2795:    if constexpr(ics==1) {
 2796:       return node->p;
 2797: 
 2798:    } else {
 2799:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2800: 
 2801:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2802: 
 2803:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2804:    }
 2805: 
 2806: }
 2807: 
 2808: 
 2809: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, 
 2810:                                                                             const Vector3& c, const Frame<ics>& dstFrame, int idx) const {
 2811: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2812: 
 2813:    const int id1 = idx;
 2814:    const int id2 = nxq(1 + id1);
 2815:    const int id3 = nxq(2 + id1);
 2816: 
 2817:    if constexpr(ics==1) {
 2818:       x0 = nodes[id1]->p;
 2819:       x1 = nodes[id2]->p;
 2820:       x2 = nodes[id3]->p;
 2821: 
 2822:    } else {
 2823: 
 2824:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2825:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2826:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2827: 
 2828:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2829:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2830:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2831: 
 2832:    }
 2833: 
 2834: }
 2835: 
 2836: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2837:    getLocalHorizontalNodePositionsTri(x0, x1, x2, {center.x, center.y, centerZ()}, frame, idx);
 2838: }
 2839: 
 2840: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2841:             Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3,
 2842:             const Vector3& c, const Frame<ics>& dstFrame) const {
 2843: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2844: 
 2845:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2846: 
 2847: 
 2848: 
 2849:    if constexpr(ics==1) {
 2850:       x0 = nodes[0]->p;
 2851:       x1 = nodes[1]->p;
 2852:       x2 = nodes[2]->p;  
 2853:       x3 = nodes[3]->p;
 2854: 
 2855:    } else {
 2856: 
 2857:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2858:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2859:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2860:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2861: 
 2862:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2863:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2864:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2865:       x3 = toVector2(dstFrame.G2L(p3 - c));
 2866:    }
 2867: 
 2868: }
 2869: 
 2870: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2871:    Point2& x0, Point2& x1, Point2& x2, Point2& x3) const
 2872: {
 2873:    getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, {center.x, center.y, centerZ()}, frame);
 2874: }
 2875: 
 2876: 
 2877: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2878: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2879: // Returns the normal vector and the area of the element at this level
 2880:    
 2881:    double nx, ny, nz;
 2882: 
 2883:    if (isTri()) {
 2884:       // For triangles...
 2885: 
 2886:       // Indices of the nodes at level k, taking care of not going below the bed
 2887:       const int k0 = max(k, nodes[0]->kb);
 2888:       const int k1 = max(k, nodes[1]->kb);
 2889:       const int k2 = max(k, nodes[2]->kb);
 2890: 
 2891:       // Gets the element frame coordinates of the nodes at level k
 2892:       Point3 x0, x1, x2;
 2893:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2894:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2895:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2896:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2897: 
 2898:       } else {  // ics == 2
 2899:          Point2 h0, h1, h2;
 2900: 
 2901:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2902: 
 2903:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2904:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2905:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2906:       }
 2907: 
 2908:       const Vector3 n20 = x2 - x0;
 2909:       const Vector3 n10 = x1 - x0; 
 2910: 
 2911:       // Computes the cross product of vectors n20 and n10. 
 2912:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2913:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2914:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2915: 
 2916:   
 2917:    }
 2918:    else {
 2919:       // For quads...
 2920:       Point2 h0, h1, h2, h3;
 2921: 
 2922:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2923: 
 2924:       // Indices of the nodes at level k, taking care of not going below the bed
 2925:       const int k0 = max(k, nodes[0]->kb);
 2926:       const int k1 = max(k, nodes[1]->kb);
 2927:       const int k2 = max(k, nodes[2]->kb);
 2928:       const int k3 = max(k, nodes[3]->kb);
 2929: 
 2930:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2931:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2932:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k2] - nodes[0]->z[k0]);
 2933:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k3] - nodes[1]->z[k1]);
 2934: 
 2935:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2936:       nx = n20.y*n31.z - n20.z*n31.y;
 2937:       ny = n20.z*n31.x - n20.x*n31.z;
 2938:       nz = n20.x*n31.y - n20.y*n31.x;
 2939: 
 2940:    }
 2941: 
 2942:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2943:    area3D = 0.5*len;
 2944: 
 2945:    const double inv_len = 1.0/len;
 2946: 
 2947:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2948: 
 2949: }
 2950: 
 2951: 
 2952: // Helper functions to get the 2D local node position for the Celestial walk
 2953: __device__ __forceinline__ Point2 Element::getLocalNodePosition(int idx, const Side* origSide) const {
 2954:    const int idx2 = (isTri() && idx == 3) ? 2 : idx;
 2955:    const Node *node = getNodeInOrder(idx2);
 2956: 
 2957:    double z = 0.0;
 2958:    if constexpr(ics == 2) z = node->gz;
 2959:    
 2960:    Point3 p = toPoint3(node->p, z);
 2961: 
 2962:    return toPoint2(origSide->toLocalFrame(p));
 2963: }
 2964: 
 2965: __device__ __forceinline__ Node *Element::getNodeInOrder(int idx) const {
 2966:    return (ssign[idx] > 0) ? sides[idx]->n1 : sides[idx]->n2;
 2967: }
 2968: 
 2969: __device__ __forceinline__ void Element::computePredicates(const Point2 x0, const Point2& xt, double &fac, const Side* origSide,
 2970:                                 Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector, int jlev) const
 2971: // Computes the three per-side predicates needed for the celestial walk
 2972: // (Kuijper, Ermolaev, Devillers, JCGT 7(3), 2018, arXiv:1710.01620).
 2973: //
 2974: // xt is in local frame coordinates for origSide if ics == 2.
 2975: //
 2976: // All work is done unconditionally on 4 sides to keep CUDA threads uniform.
 2977: // For triangles, side 3 is a sentinel: getNode(3) returns getNode(2), making
 2978: // corners[3] == corners[2] and s3 == (0, 0). Predicates that would be
 2979: // meaningless on triangles are masked to a safe value (see comments below).
 2980: {
 2981:    // Project all 4 corner positions once into the local 2D frame.
 2982:    // For triangles, C[3] == C[2] (no garbage, but geometrically degenerate).
 2983:    // getLocalNodePosition only transforms/projects if ics == 2.
 2984:    const Point2 C[4] = {getLocalNodePosition(0, origSide), 
 2985:                         getLocalNodePosition(1, origSide), 
 2986:                         getLocalNodePosition(2, origSide), 
 2987:                         getLocalNodePosition(3, origSide)};
 2988: 
 2989:    // Computes the maximum distance from the starting point to the farthest element node projected on the segment x0xt.
 2990:    // This has nothing to do with the original celestial walk. It is used in the Leaded Celestial 
 2991:    //Walk algorithm to find a point on the segment x0xt that is as close as possible to the starting point,
 2992:    // But still farther towards the target point from the current point.
 2993:    const Vector2 vt0 = xt - x0;
 2994:    double maxProjDist = max(dot(vt0, C[0] - x0), dot(vt0, C[1] - x0));
 2995:    maxProjDist = max(maxProjDist, dot(vt0, C[2] - x0)); 
 2996:    maxProjDist = isQuad() ? max(maxProjDist, dot(vt0, C[3] - x0)) : maxProjDist;
 2997: 
 2998:    fac = max(1.00001*fac, min(1.0, (maxProjDist/dot(vt0, vt0))*1.00001));
 2999:    const Vector2 ixt = x0 + (xt - x0)*fac;
 3000: 
 3001: 
 3002: // if (origSide->idx == 2860848 && jlev == 46) {
 3003: // showPoints(toPoint3(x0,0.0), toPoint3(xt,0.0), jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 3004: // showPoints(toPoint3(ixt,0.0), toPoint3(ixt,0.0), jlev, origSide, 0x00FF00u, 'o', 1, 0, 0);
 3005: // printf("this->idx = %d, origSide->idx = %d, ixt = (%.17f, %.17f), x0 = (%.17f, %.17f), xt = (%.17f, %.17f), fac = %.17f\n", this->idx, origSide->idx, ixt.x, ixt.y, x0.x, x0.y, xt.x, xt.y, fac);
 3006: // }
 3007:    // Side I goes from corners[I] to corners[nxq(I+1)] in CCW perimeter order.
 3008:    // (Note: with corners built from getNode in CCW order, no ssign factor is needed
 3009:    //  here the orientation is baked into the corners array.)
 3010:    const int i3 = nxq(3);
 3011:    const Vector2 s0 = C[ 1] - C[ 0];
 3012:    const Vector2 s1 = C[ 2] - C[ 1];
 3013:    const Vector2 s2 = C[i3] - C[ 2];
 3014:    const Vector2 s3 = C[ 0] - C[i3];
 3015:    
 3016:    // Side I goes from C[I] to C[nxq(I+1)] in CCW perimeter order.
 3017:    // The corners array is built from getNode in CCW order, so the orientation
 3018:    // is already correct and no ssign factor is needed in the formulas below.
 3019:    //
 3020:    // i3 = nxq(3): the index of the corner after side 2.
 3021:    //   Triangle: i3 == 0 (the closing corner of the triangle).
 3022:    //   Quad:     i3 == 3.
 3023:    //
 3024:    // The four side direction vectors. For triangles, s3 == (0, 0) since
 3025:    // C[i3] == C[0] (the perimeter has already closed by side 2).
 3026:    isLeft.set(0,  cross(s0, ixt - C[ 0]) > -small);
 3027:    isLeft.set(1,  cross(s1, ixt - C[ 1]) > -small);
 3028:    isLeft.set(2,  cross(s2, ixt - C[ 2]) > -small);
 3029:    isLeft.set(3, (cross(s3, ixt - C[i3]) > -small) || isTri());  
 3030: 
 3031: // printf("idx = %d, cross(s0, xt - C[ 0] ) = %.17f, cross(s1, xt - C[ 1] ) = %.17f, cross(s2, xt - C[ 2] ) = %.17f, cross(s3, xt - C[i3] ) = %.17f\n", idx, cross(s0, xt - C[ 0] ), cross(s1, xt - C[ 1] ), cross(s2, xt - C[ 2] ), cross(s3, xt - C[i3] ));
 3032: 
 3033:    // For triangles, the corner after side 2 is the closing corner where
 3034:    // side 2 meets side 0 (not side 3, which doesn't exist). The "next side
 3035:    // tangent" used by isObtuse and isBisector at that corner is therefore
 3036:    // s0 for triangles, s3 for quads.
 3037:    const Vector2 s3_tri = isTri() ? s0 : s3;
 3038: 
 3039:    // isObtuse.b[I]: true iff the internal face angle at the corner after
 3040:    // side I is obtuse. Equivalent to dot of consecutive side directions > 0
 3041:    // (acute "turn angle" along the perimeter = obtuse internal angle).
 3042:    //
 3043:    // isObtuse.b[3] for triangles: dot(s3, s0) = dot(0, s0) = 0, so the
 3044:    // result is false naturally. No sentinel needed.
 3045:    isObtuse.set(0, dot(s0, s1) > 0.0);
 3046:    isObtuse.set(1, dot(s1, s2) > 0.0);
 3047:    isObtuse.set(2, dot(s2, s3_tri) > 0.0);  // triangle: closes back to s0
 3048:    isObtuse.set(3, dot(s3, s0) > 0.0);  // Always false for triangles (s3=(0,0))
 3049: 
 3050:    // isBisector.b[I]: at the corner after side I, this tests whether xt is
 3051:    // on the "exit through side I" half of the corner cone, separated by the
 3052:    // approximate angular bisector of the celestial walk. The bisector is
 3053:    // perpendicular to the chord across the corner; the test is the sign of
 3054:    // (xt - corner_vertex) projected onto that chord.
 3055:    //
 3056:    // isBisector.b[3] is always masked out by isLeft.b[3] = true for triangles
 3057:    // (the validity rule sets valid_3 = false), so its computed value for
 3058:    // triangles doesn't matter. No sentinel needed.
 3059:    isBisector.set(0, dot(ixt - C[ 1], s0 + s1) < 0.0);
 3060:    isBisector.set(1, dot(ixt - C[ 2], s1 + s2) < 0.0);
 3061:    isBisector.set(2, dot(ixt - C[i3], s2 + s3_tri) < 0.0);
 3062:    isBisector.set(3, dot(ixt - C[ 0], s3 + s0) < 0.0);   
 3063: 
 3064: }
 3065: 
 3066: 
 3067: __inline__ __device__ double Element::computeSignedArea(void) const {
 3068:    // Compute the area of the element
 3069: 
 3070:    Point2 x0, x1, x2, x3;
 3071:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 3072: 
 3073: 
 3074:    double res = signedArea(x0, x1, x2);
 3075: 
 3076:    // In the quad case we need to add the area of the other triangle.
 3077:    if (isQuad()) {
 3078:       x3 = getLocalHorizontalNodePosition(3);
 3079:       double ar1 = signedArea(x0, x2, x3);
 3080:       double ar2 = signedArea(x0, x1, x3);
 3081:       double ar3 = signedArea(x1, x2, x3);
 3082:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 3083: 
 3084:       res += ar1;
 3085: 
 3086:    }
 3087: 
 3088:    return res;
 3089: }
 3090: 
 3091: 
 3092: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 3093:                                                                 (nodes[1]->isDry2()) ||
 3094:                                                                 (nodes[2]->isDry2()) ||
 3095:                                                                 (isQuad() && nodes[3]->isDry2());
 3096: }
 3097: 
 3098: __inline__ __device__ double Element::detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3099:    return (1.0/8.0)*((x1.x - x0.x)*(x2.y - x3.y) - (x2.x - x3.x)*(x1.y - x0.y));
 3100: }
 3101: 
 3102: __inline__ __device__ double Element::detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3103:    return (1.0/8.0)*((x2.x - x1.x)*(x3.y - x0.y) - (x3.x - x0.x)*(x2.y - x1.y));
 3104: }
 3105: 
 3106: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 3107:    // In boundary sides, the element 1 is nullptr
 3108:    return side->elems[1] == nullptr; 
 3109: }
 3110: 
 3111: __forceinline__ __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4],
 3112:                                                              bool useSideCenters) const {
 3113:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 3114:    // For ics == 2, this function uses local frame coordinates.
 3115:    // If useSideCenters, bilinear domain is the side-center quad (side j opposite node j).
 3116: 
 3117:    assert(isQuad());
 3118: 
 3119:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 3120:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 3121:    // where vxi, veta, vb are vectors and c is the center of the element.
 3122: 
 3123:    Point2 p0, p1, p2, p3;
 3124: 
 3125:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 3126: 
 3127:    if (useSideCenters) {
 3128:       const Point2 s0 = 0.5 * (p1 + p2);
 3129:       const Point2 s1 = 0.5 * (p2 + p3);
 3130:       const Point2 s2 = 0.5 * (p3 + p0);
 3131:       const Point2 s3 = 0.5 * (p0 + p1);
 3132:       p0 = s0; p1 = s1; p2 = s2; p3 = s3;
 3133:    }
 3134: 
 3135:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 3136:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 3137:    // vectors vxi and veta connect the centers of opposite sides
 3138:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 3139:    // vb is zero for parallelogram elements.
 3140:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 3141: 
 3142:    //  The bilinear mapping is:
 3143:    //      P(s,t) = C + s*U + t*V + s*t*W
 3144:    //
 3145:    //  where:
 3146:    //    C = centroid (average of four vertices)
 3147:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 3148:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 3149:    //    W = bilinear correction; measures deviation from parallelogram
 3150:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 3151:    //        W = 0 for parallelogram elements.
 3152:    //
 3153:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 3154:    //
 3155:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 3156:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 3157:    //
 3158:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 3159:    //
 3160:    //  Geometrically, (L) projects everything onto the direction
 3161:    //  perpendicular to W, where the mapping is purely affine.
 3162:    //
 3163:    //  The dot product with nb retains the nonlinear term:
 3164:    //
 3165:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 3166:    //
 3167:    //  Geometrically, (Q) projects onto the W direction, where
 3168:    //  the nonlinearity lives.
 3169:    //
 3170:    //  We solve (L) for whichever variable has the larger coefficient
 3171:    //  (better conditioned back-substitution), substitute into (Q),
 3172:    //  and get a scalar quadratic in the other variable.
 3173:    // ================================================================
 3174: 
 3175:    // ---- Basis vectors ----
 3176:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 3177:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 3178:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 3179:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 3180:    // W: nonlinear correction. Difference between quad and parallelogram.
 3181:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 3182:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 3183: 
 3184:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 3185:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 3186:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 3187:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 3188:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 3189: 
 3190:    // ---- nb: direction parallel to W, L1-normalized ----
 3191:    // We don't need a unit vector -- just a well-scaled direction parallel
 3192:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 3193:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 3194:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 3195:    //
 3196:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 3197:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 3198:    // and the quadratic solver takes its linear path (a ~ 0).
 3199:    const double wlen1 = fabs(vb.x) + fabs(vb.y);
 3200:    const Vector2 nb = (wlen1 > 0.0) ? vb*(1.0/wlen1) : Vector2{1.0, 0.0};
 3201: 
 3202:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 3203:    // cross(nb, .) projects onto the direction PERPENDICULAR to W.
 3204:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 3205:    // What remains is a pure affine relationship between xi and eta.
 3206:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 3207:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 3208:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 3209: 
 3210:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 3211:    // dot(nb, .) projects onto the W direction, where the nonlinearity lives.
 3212:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 3213:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 3214:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 3215:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 3216:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 3217: 
 3218:    // ---- Solve: pick the better-conditioned variable from (L) ----
 3219:    // Back-substitute from (L) dividing by the LARGER coefficient,
 3220:    // minimizing round-off amplification.
 3221:    //
 3222:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 3223:    // that uses predicated moves.
 3224:    //
 3225:    // if (fabs(Ls) > fabs(Lt)) {
 3226:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 3227:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 3228:    //    // Substitute into (Q), multiply by Ls, group by eta:
 3229:    //    const double A = -Qw * Lt;
 3230:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 3231:    //    const double C =  Qs * Lp - Qp * Ls;
 3232: 
 3233:    //    double eta1, eta2;
 3234:    //    solveQuadratic(A, B, C, eta1, eta2);
 3235: 
 3236:    //    // Pick root with smaller |eta| (domain centered at 0).
 3237:    //    // Ternary-> predicated move, no branch divergence.
 3238:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 3239: 
 3240:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 3241:    //    xi = (Lp - Lt * eta) / Ls;
 3242: 
 3243:    // } else {
 3244:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 3245:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 3246:    //    // Substitute into (Q), multiply by Lt, group by xi:
 3247:    //    const double A = -Qw * Ls;
 3248:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 3249:    //    const double C =  Qt * Lp - Qp * Lt;
 3250: 
 3251:    //    double xi1, xi2;
 3252:    //    solveQuadratic(A, B, C, xi1, xi2);
 3253: 
 3254:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 3255: 
 3256:    //    eta = (Lp - Ls * xi) / Lt;
 3257:    // }
 3258:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 3259:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 3260:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 3261:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 3262:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 3263: 
 3264:    // Quadratic:  A*r^2 + B*r + C = 0
 3265:    // (same formula for both cases, just with swapped coefficients)
 3266:    const double A = -Qw * Lb;
 3267:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 3268:    const double C =  Qa * Lp - Qp * La;
 3269: 
 3270:    double r1, r2;
 3271:    solveQuadratic(A, B, C, r1, r2);
 3272: 
 3273:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 3274:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 3275: 
 3276:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 3277:    const double other = (Lp - Lb * r) / La;
 3278: 
 3279:    // Assign to (xi, eta) depending on which variable the quadratic solved
 3280:    xi  = solve_s ? r     : other;
 3281:    eta = solve_s ? other : r;
 3282: 
 3283: 
 3284:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 3285:    xi  = clamp(xi,  -1.0, 1.0);
 3286:    eta = clamp(eta, -1.0, 1.0);
 3287: 
 3288:    // ---- Shape functions ----
 3289:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 3290:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 3291:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 3292:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 3293:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 3294:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 3295:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 3296:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 3297: 
 3298:    return true;
 3299: }
 3300: 
 3301: /**
 3302:    Compute the shape coordinates of the point (xt,yt) in the element.
 3303:    @param xt (input): x-coordinate of the point
 3304:    @param shpCoords (output): shape coordinates of the point
 3305:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 3306:    @return true if the point is inside the element, false otherwise
 3307: **/
 3308: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 3309: 
 3310:    // Compute the shape coordinates of the point xt in the element.
 3311:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 3312:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 3313:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 3314:    // from the local frame, so use additional check.
 3315: 
 3316: 
 3317:    Point3 origSideCenter = toPoint3(origSide->center, origSide->centerZ());
 3318: 
 3319:    if (isTri()) { // Triangular element
 3320: 
 3321:       // Horizontal local node coordinates. 
 3322:       Point2 x0, x1, x2;
 3323:       getLocalHorizontalNodePositionsTri(x0, x1, x2, origSideCenter, origSide->frame);
 3324: 
 3325:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 3326:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 3327:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 3328:       shpCoords[3] = 0.0;
 3329: 
 3330:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 3331:       const bool res = (tmpmin >= -small);  
 3332:       
 3333:       // When to fix the negative shape coordinates?
 3334:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 3335: 
 3336:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 3337:       // then we fix the negative shape coordinates.
 3338:       if ((tmpmin < 0) && fix) {
 3339: 
 3340:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 3341:          // keeping the sum of the shape coordinates equal to 1.
 3342:          // I have tested and compared the new algorithm with the old one, and they give
 3343:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 3344:          // The new algorithm should be faster since it is branchless.
 3345:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 3346:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 3347: 
 3348:          shpCoords[0] = (shpCoords[0] + a)*b;
 3349:          shpCoords[1] = (shpCoords[1] + a)*b;
 3350:          shpCoords[2] = (shpCoords[2] + a)*b;          
 3351: 
 3352:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 3353:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 3354:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 3355: 
 3356:          // Update the point coordinates for the new shape coordinates
 3357:          double xcoords[3] = {x0.x, x1.x, x2.x};
 3358:          double ycoords[3] = {x0.y, x1.y, x2.y};
 3359: 
 3360:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 3361: 
 3362:       }
 3363: 
 3364:       // Return true if the point is inside the element
 3365:       return res;      
 3366:    }
 3367:    else {
 3368:       assert(isQuad() && "computeShapeCoords");
 3369: 
 3370:       // Horizontal local node coordinates with respect to the original side.
 3371:       Point2 x0, x1, x2, x3;
 3372:       getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, origSideCenter, origSide->frame);
 3373: 
 3374:       const double a0 = signedArea(x0, x1, xt);
 3375:       const double a1 = signedArea(x1, x2, xt);
 3376:       const double a2 = signedArea(x2, x3, xt);
 3377:       const double a3 = signedArea(x3, x0, xt);
 3378: 
 3379:       const double minArea = min4(a0, a1, a2, a3);
 3380:       
 3381:       const bool res = (minArea > -small*area);
 3382: 
 3383:       // When to fix the negative shape coordinates?
 3384:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 3385: 
 3386:       double xi, eta;    
 3387: 
 3388:       // Converts the point xt to the element frame coordinates and then to bilinear+shape coordinates.
 3389:       // Does nothing if ics == 1.
 3390:       assert(origSide != nullptr);
 3391:       Point2 xt_elem = toPoint2(toLocalFrame(origSide->toGlobal(toPoint3(xt, 0.0))));
 3392: 
 3393:       inverseBilinearQuad(xt_elem, xi, eta, shpCoords);
 3394: 
 3395:       if (fix) {
 3396:          double xn[4] = {x0.x, x1.x, x2.x, x3.x};
 3397:          double yn[4] = {x0.y, x1.y, x2.y, x3.y};
 3398:          xt.x = interpolate(shpCoords, xn);
 3399:          xt.y = interpolate(shpCoords, yn);
 3400:       }
 3401: 
 3402:       return res;
 3403:    }
 3404: 
 3405: 
 3406:    assert(false && "computeShapeCoords: should never reach this point");
 3407:    return false;  // Never reached
 3408: 
 3409: }
 3410: 
 3411: 
 3412: __device__ __forceinline__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 3413: // Convert shape coordinates to cartesian coordinates
 3414: 
 3415:    if (isTri()) {
 3416:       // Triangular element
 3417: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 3418:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 3419:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 3420:    }
 3421:    else {
 3422:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 3423:    }
 3424: 
 3425: }
 3426: 
 3427: 
 3428: 
 3429: __device__ __forceinline__ double Element::intPhiPhiTri(int i, int j) const {
 3430:    // return \int \phi_i*\phi_j dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3431:    
 3432:    return ((i == j) ? (2.0/12.0) : (1.0/12.0))*area;
 3433: }
 3434: 
 3435: __device__ __forceinline__ double Element::intGradPhiGradPhiTri(int i, int j) const {
 3436:    // return \int (grad phi_i).(grad phi_j) dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3437:    // gradPhi[i] is constant over a linear triangle, so the integral is area * dot(gradPhi[i], gradPhi[j]).
 3438:    assert(isTri() && i >= 0 && j >= 0 && i < 3 && j < 3);
 3439:    return area * dot(gradPhi[i], gradPhi[j]);
 3440: }
 3441: 
 3442: __device__ __forceinline__ double Element::intPhiPhiQuad(int i, int j, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3443:    // return \int \phi_i*\phi_j dA for quads, where phi_i and phi_j are the shape functions of the nodes i and j.
 3444:    // The integral can be computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 3445:    // The formula for the integral is:
 3446:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 3447:    
 3448:    const double xi_term  = 1.0 + (xi_n(i) * xi_n(j))/3.0;
 3449:    const double eta_term = 1.0 + (eta_n(i)*eta_n(j))/3.0;
 3450:    const double eta_sum  = eta_n(i) + eta_n(j);
 3451:    const double xi_sum   = xi_n(i)  + xi_n(j);
 3452: 
 3453:    const double detJ_xi  = detJ_xi_quad (x0, x1, x2, x3);  // XXXXX put the 8 inside the function??? xi derivative of the Jacobian determinant
 3454:    const double detJ_eta = detJ_eta_quad(x0, x1, x2, x3);  // eta derivative of the Jacobian determinant
 3455: 
 3456: 
 3457:    return (1.0/16.0)*area*xi_term*eta_term + (1.0/12.0)*(detJ_eta*xi_term*eta_sum + detJ_xi*eta_term*xi_sum);
 3458: }
 3459:    
 3460: 
 3461: __device__ __forceinline__ double Element::intGradPhiGradPhiQuad(int i1, int i2, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3462:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3463:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 3464:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 3465:    // The formula is also based on the identity:
 3466:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 3467:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 3468: 
 3469:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: bad ranges");
 3470: 
 3471: 
 3472: 
 3473:    double res = 0.0;
 3474:    
 3475:    // Quadrature points in xi and eta coordinates
 3476:    #pragma unroll
 3477:    for (int i = 0; i < 4; i++) {
 3478:       // For each quadrature point...
 3479: 
 3480:       const Point2 p = GaussPoint(i);  // Quadrature point in (eta,xi) coordinates
 3481:       const double eta = p.x;
 3482:       const double xi  = p.y;
 3483: 
 3484:       // Jacobian entries at the Gauss point p
 3485:       const double dx_dxi  = 0.25 * ( (x1.x + x2.x - x0.x - x3.x) + eta*(x0.x + x2.x - x1.x - x3.x) );
 3486:       const double dx_deta = 0.25 * ( (x2.x + x3.x - x0.x - x1.x) + xi *(x0.x + x2.x - x1.x - x3.x) );
 3487:       const double dy_dxi  = 0.25 * ( (x1.y + x2.y - x0.y - x3.y) + eta*(x0.y + x2.y - x1.y - x3.y) );
 3488:       const double dy_deta = 0.25 * ( (x2.y + x3.y - x0.y - x1.y) + xi *(x0.y + x2.y - x1.y - x3.y) );      
 3489: 
 3490:       const double detJ = detJ_quad(p, x0, x1, x2, x3);
 3491:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3492: 
 3493:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3494:       const double dPhi_dxi_1  = dPhi_dxi_quad (i1, p);
 3495:       const double dPhi_deta_1 = dPhi_deta_quad(i1, p);
 3496:       const double dPhi_dxi_2  = dPhi_dxi_quad (i2, p);
 3497:       const double dPhi_deta_2 = dPhi_deta_quad(i2, p);
 3498: 
 3499:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3500:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3501:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3502:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3503:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3504: 
 3505:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3506:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3507:    }
 3508: 
 3509:    return res;
 3510: }
 3511: 
 3512: 
 3513: /**  Interpolate velocities at a given point (xt,yt,zt)
 3514: 
 3515:    @param xt, yt, zt: coordinates of the point to interpolate
 3516:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3517: 
 3518:    This is done in four steps:
 3519: 
 3520:    1. Find the shape coordinates for the final position in the element.
 3521:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3522:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3523:       z levels at xt, yt at each step.   
 3524:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3525:       horizontally and vertically.
 3526: **/
 3527: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3528:    // Interpolate the velocities at the point xt. 
 3529:    // This function works the same for triangular and quadrilateral elements.
 3530:    double shpCoord[4];
 3531:    Vector3 u_int;
 3532: 
 3533: 
 3534:    // First step is to compute the shape coordinates of (xt,yt)
 3535: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3536:    computeShapeCoords(toVector2(xt), shpCoord, fiAnywhere, origSide);
 3537: 
 3538:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 3539: 
 3540:    // Second step is to find the level that contains zt
 3541:    // Uses a binary search to find the level
 3542:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3543:    // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3544:    int L = kb - 1; // In some cases, the bottom level of the element is 1 more than the bottom level of the node XXXX (Check)
 3545:    int R = nvrt - 1;
 3546: 
 3547:    // Get the z coordinates at the nodes of the element at the levels L and R
 3548:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3549:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3550:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3551: 
 3552: 
 3553:    double zL = interpolate(shpCoord, zLAtNodes);
 3554:    double zR = interpolate(shpCoord, zRAtNodes);
 3555: 
 3556:    // Interpolates vertically the velocities
 3557:    double wght1, wght2;
 3558:    if (xt.z <= zL) {
 3559:       wght1 = 1.0;
 3560:       wght2 = 0.0;
 3561:       xt.z = zL;
 3562:    }
 3563:    else if (xt.z >= zR) {
 3564:       wght1 = 0.0;
 3565:       wght2 = 1.0;
 3566:       xt.z = zR;
 3567:    }
 3568:    else {
 3569:       // Perform a binary search to find the levels between L and R that contain xt.z
 3570:       while (R - L > 1) {
 3571:          int M = (L + R) / 2.0;
 3572: 
 3573:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3574:          double zM = interpolate(shpCoord, zMAtNodes);
 3575:          if (zM < xt.z) 
 3576:          {
 3577:             L = M;
 3578:             zL = zM;
 3579:          }
 3580:          else 
 3581:          {
 3582:             R = M;
 3583:             zR = zM;
 3584:          }
 3585:       }
 3586:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3587:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3588: 
 3589:       wght2 = (xt.z - zL)/(zR - zL);
 3590:       wght1 = 1.0 - wght2;
 3591: 
 3592:    }
 3593: // printf("XXYYX element %d, L = %d, R = %d, zL = %.17f, zR = %.17f, xt.z = %.17f, wght1 = %.17f, wght2 = %.17f\n", idx, L, R, zL, zR, xt.z, wght1, wght2);
 3594: // printf("HEREEEEEE 3, wght1 = %.17f, wght2 = %.17f, shpCoord = (%.17f, %.17f, %.17f, %.17f)\n", wght1, wght2, shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 3595:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3596:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3597:    Vector2 uv = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3598:    double w   = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3599: 
 3600:    // Project the velocity from the local frame to the origSide frame
 3601:    if constexpr(ics == 2) uv = frame.projHorVec(uv, origSide->frame);
 3602:    u_int = {uv.x, uv.y, w};
 3603: 
 3604:    // Neither of the interpolated velocities should be NaN
 3605:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3606: 
 3607:    return u_int;
 3608: 
 3609: }
 3610: 
 3611: 
 3612: 
 3613: 
 3614: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3615: 
 3616:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3617:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3618:    const Node *n1 = side->n1;
 3619:    const Node *n2 = side->n2;
 3620: 
 3621:    bool n1_match = (n1->nodeBnd->segment == segment);
 3622:    bool n2_match = (n2->nodeBnd->segment == segment);
 3623: 
 3624:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3625:    if (n1_match && n2_match) {
 3626:       return 0.5;
 3627:    } else if (n1_match) {
 3628:       return 1.0;
 3629:    } else if (n2_match) {
 3630:       return 0.0;
 3631:    }
 3632: 
 3633:    return 0.0;
 3634: }
 3635: 
 3636: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3637: 
 3638: 
 3639: 
 3640: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 3641:    // Returns the value of the velocity at the side center
 3642:    const double w1 = getBoundaryArrayValueWeight();
 3643:    const double w2 = 1.0 - w1;
 3644:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3645:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3646: 
 3647:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 3648: }
 3649: 
 3650: 
 3651: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 3652:    // Returns the value of the normal component of the velocity at the side center
 3653:    const double w1 = getBoundaryArrayValueWeight();
 3654:    const double w2 = 1.0 - w1;
 3655:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3656:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3657: 
 3658:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 3659: }
 3660: 
 3661: 
 3662: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3663:    if constexpr(ics == 1) {
 3664:       return center;
 3665: 
 3666:    } else {
 3667:       const Point2 p0 = n1->outputCoords();
 3668:       const Point2 p1 = n2->outputCoords();
 3669:       return (1.0/2.0)*(p0 + p1);
 3670: 
 3671:    }
 3672: }
 3673: 
 3674: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3675: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3676: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3677: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3678: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3679: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3680: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3681: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3682: // Computes the gradient of the field at the side center.
 3683:    Vector2 grad = {0.0, 0.0};
 3684:    int count = 0;
 3685: 
 3686:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3687:    // as the average of the gradients at each element.
 3688:    // First element
 3689:    if (elems[0] != nullptr && condition(elems[0])) {
 3690:       Vector2 elemGrad = elems[0]->grad2(field);
 3691: 
 3692:       // For ics=2, projects the element gradient from its frame to the side frame
 3693:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3694: 
 3695:       grad += elemGrad;
 3696: 
 3697:       count++;
 3698:    }
 3699: 
 3700:    // Second element
 3701:    if (elems[1] != nullptr && condition(elems[1])) {
 3702: 
 3703:       Vector2 elemGrad = elems[1]->grad2(field);
 3704: 
 3705:       // For ics=2, projects the element gradient from its frame to the side frame
 3706:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3707: 
 3708:       grad += elemGrad;
 3709: 
 3710:       count++;
 3711:    }
 3712: 
 3713:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3714:    if (count > 0) {
 3715:       grad = grad*(1.0/count);
 3716:    }
 3717:    
 3718:    return grad;
 3719: }
 3720: 
 3721: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 3722: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 3723: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 3724: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 3725: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 3726: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 3727: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 3728: 
 3729: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 3730: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 3731: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 3732: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 3733: 
 3734: 
 3735: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3736: 
 3737: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3738:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3739:    if constexpr(ics == 1) { 
 3740:       return 0.5*(n1->tau + n2->tau);
 3741: 
 3742:    } else {
 3743:       // Project the tau from the node frames to the side frame
 3744:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3745:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3746: 
 3747:       return 0.5*(stau1 + stau2);
 3748:    }
 3749: }
 3750: 
 3751: /**
 3752:  * This method performs backtracking from the side center until a time -dt back in time 
 3753:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3754:  * intermediate point.
 3755:  *
 3756:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3757:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3758:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3759:  * remaining time.
 3760:  * 
 3761:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3762:  * 
 3763:  * @param uuint, vvint, wwint: Velocities at the final point
 3764:  * @param jlev: Level at which the backtracking is performed
 3765:  * @param dt, dtbk: Tracking timesteps
 3766:   */
 3767: __inline__ __device__ void Side::btrack(
 3768:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3769:       double dt,            // Tracking time
 3770:       double dtbk,          // Tracking timestep
 3771:       Vector3 &u_int        // Velocities at the initial point
 3772: ) const {
 3773: 
 3774:    // Start from side center
 3775:    Point3 x0;
 3776: 
 3777:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3778:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3779: 
 3780:  
 3781:    double time_rm = dt; // Remaining time
 3782:    double time_rm_1 = 1e10;
 3783:    double time_rm_2 = 2e10;
 3784:    double time_rm_3 = 3e10;
 3785: 
 3786: 
 3787:    // Initial velocities
 3788:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3789: 
 3790:    // Find a non dry element for starting the backtracking. At this point there should be at least one.
 3791:    Element* curElem = (!elems[0]->isDry) ? elems[0] : elems[1];  // elems[0] is always non-null 
 3792: 
 3793:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3794: 
 3795: // showPoints(x0, x0, jlev, this, 0xFF0000u, 'x', 1, 0, 0);
 3796: 
 3797: 
 3798:    constexpr int MAX_ITERATIONS = 100; 
 3799:    int iter = 0;
 3800:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3801:    while(true) {
 3802: 
 3803:       // Calculate timestep
 3804:       const double dtb = min(dtbk, time_rm);
 3805: 
 3806:       // Next point in the backtracking curve
 3807:       xt = x0 - dtb*u_int;
 3808: 
 3809:       double t, s; // parameters for the line segments p0pt and p1p2
 3810:       Side *lastCrossSide = nullptr;
 3811:       const bool found = celestialWalk(curElem, x0, xt, this, lastCrossSide, jlev);
 3812: 
 3813: 
 3814:       if (time_rm_3 <= time_rm) {
 3815:       // If backtracking gets stuck, we stop the backtracking and use the velocity at the last x0.
 3816:          xt = x0;
 3817:          break;
 3818:       }
 3819: 
 3820: 
 3821:       if (!found) {
 3822:       // This means that the walk reached a boundary or a dry element.
 3823: 
 3824:          assert(lastCrossSide!=nullptr && "lastCrossSide is nullptr");
 3825: 
 3826:          // Finds the point at the boundary where the line segment x0xt intersects.
 3827:          // Here we will assume that it does intersect the boundary segment, even if in some cases,
 3828:          // due to floating point errors, it does not exactly intersect.
 3829:          // We call p1 and p2 the 2D points of the boundary segment. p0, pt are the 2D versions of x0 and xt.
 3830:          // v1 is the vector from p0 to pt, v2 is the vector from p1 to p2.
 3831:          // To compute the intersection point we start with the parametric equations.
 3832:          // p1 + t*v2 = p0 + s*v1,    t, s in [0,1]
 3833:          // We cross-prouct by v1 to cancel the s term:
 3834:          // cross(v2, v1)*t = cross(p0 - p1, v1)
 3835:          // t = cross(p0 - p1, v1) / cross(v2, v1)
 3836: 
 3837:          // Side coordinates in the origSide frame.
 3838:          const Point2 p1 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n1->p, lastCrossSide->n1->gz)));
 3839:          const Point2 p2 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n2->p, lastCrossSide->n2->gz)));
 3840: 
 3841:          Point2  p0 = {x0.x, x0.y};
 3842:          Point2  pt = {xt.x, xt.y};
 3843: 
 3844:          const Vector2 v1 = pt - p0;
 3845:          const Vector2 v2 = p2 - p1;
 3846: 
 3847: 
 3848: 
 3849:          // We are assuming intersection, so we clamp t to the range [0,1].
 3850:          const double denom = cross(v2, v1);
 3851:          
 3852: 
 3853: 
 3854: 
 3855:          if (abs(denom) < small) {
 3856:             // small denominators are fairly common. They occur when the line segment x0xt 
 3857:             // is parallel to the boundary segment. This occurs after a "collision" with the
 3858:             // boundary, where the backtracking curve startt sliding along the boundary.
 3859:             // In this case, we simply assume that the two lines are very close to each other
 3860:             // and simply compute the closest point to xt (s = 1.0) on the boundary segment (clamped to p1p2)
 3861:             t = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3862:             if (t<0.0000000001) t = 0.0;
 3863:             if (t>0.9999999999) t = 1.0;
 3864: 
 3865:             // s = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3866:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3867: 
 3868:          }
 3869:          else {
 3870:             
 3871:             t = clamp(cross(p0 - p1, v1) / denom, 0.0, 1.0);
 3872:             if (t<0.0000000001) t = 0.0; // XXXXX use constants
 3873:             if (t>0.9999999999) t = 1.0;
 3874:             // From the originaL equation we can solve for s:
 3875:             // p1 + t*v2 = p0 + s*v1    =>   s*v1 = p1 + t*v2 - p0 
 3876:             // Computing the dot product by v1, we get:
 3877:             // s = dot((p1 + t*v2 - p0), v1) / dot(v1, v1)
 3878:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3879:             if (s<0.0000000001) s = 0.0; // XXXXX use constants
 3880: 
 3881:          }
 3882: 
 3883:          assert(curElem!=nullptr && !curElem->isDry && "curElem is nullptr or dry");
 3884: 
 3885: 
 3886:          // We update the new target point to be right at the intersection point,
 3887:          // and the remaining time must include the time we haven't "used".
 3888:          time_rm -= s*dtb;
 3889:          xt = toPoint3(p1 + t*v2, x0.z + s*(xt.z - x0.z)); // I use p1,p2 to compute the intersection point to ensure that it is on the boundary, but the z-coordinate is the same as x0.z
 3890: 
 3891: 
 3892:          // If it is an open boundary, just exits the loop. No sliding along the boundary is performed.
 3893:          if (lastCrossSide->sideBnd!=nullptr && !lastCrossSide->sideBnd->segment->isLand) break;
 3894: 
 3895:          // If it is not an open boundary, the velocity for the next step is computed by interpolating the velocities at the intersection point.
 3896:          // but extracting only the component along the tangent vector v2.
 3897:          Vector2 tangent = normalize(v2);
 3898:          const Vector3 u = curElem->interpolateVelocities(xt, this);
 3899: 
 3900:          const Vector2 u2D = make_double2(u.x, u.y);
 3901:          u_int = toVector3(dot(u2D, tangent)*tangent, u.z);
 3902: 
 3903: 
 3904:       } else {
 3905: 
 3906:          assert(curElem!=nullptr && !curElem->isDry && "Final element is dry or boundary side");
 3907: 
 3908:          time_rm -= dtb; 
 3909: 
 3910:          u_int = curElem->interpolateVelocities(xt, this);
 3911: 
 3912:       }
 3913: 
 3914:       if (time_rm <= 0.0) break; 
 3915: 
 3916:       // If the velocity is too small, we stop the backtracking
 3917:       const double vmag2 = norm2(toVector2(u_int));
 3918:       if (vmag2 <= velmin_btrack_sq)  {
 3919:          time_rm = 0.0; 
 3920:          return; 
 3921:       }
 3922: 
 3923:       // The current point becomes the next segment's starting point.
 3924:       x0 = xt;
 3925:  
 3926:       iter++;
 3927: 
 3928: // XXXXXXXXXXXXXXXXX
 3929: if (iter == 38) {printf("*****iter = %d, time_rm = %.17f\n", iter, time_rm); return;}
 3930:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3931: 
 3932:       assert(time_rm_3 > time_rm && "time_rm is not decreasing");
 3933:       time_rm_3 = time_rm_2;
 3934:       time_rm_2 = time_rm_1;
 3935:       time_rm_1 = time_rm;
 3936:    }
 3937: 
 3938:    assert(curElem != nullptr && "Final element is nullptr");
 3939:    assert(!curElem->isDry && "Final element is dry");
 3940:    
 3941: 
 3942: 
 3943:    // Interpolate the velocities at the final point with respect to the current side frame
 3944:    u_int = curElem->interpolateVelocities(xt, this);
 3945: 
 3946: 
 3947: }
 3948: 
