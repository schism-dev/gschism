 5359:    __global__ void resetBoundaryAreas(void) {
 5360:       // Reset boundary areas and lengths for each segment.
 5361: 
 5362:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 5363:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 5364:       SIDE_BND(sideBnd);
 5365: 
 5366:       BoundarySegment *segment = sideBnd->segment;
 5367: 
 5368:       segment->carea = 0.0;
 5369:       segment->clen = 0.0;
 5370:  
 5371:    }
 5372: 
 5373:    __global__ void computeBoundaryAreas(void) {
 5374:    // Calculation of cross-section areas and lengths for flow b.c.
 5375: 
 5376:       SIDE_BND(sideBnd);
 5377: 
 5378:       const Side *side = sideBnd->side;
 5379:       BoundarySegment *segment = sideBnd->segment;
 5380: 
 5381:       if (segment->ifltype != 0) {
 5382: 
 5383:          const Node *n1 = side->n1;
 5384:          const Node *n2 = side->n2;
 5385: 
 5386:          const double htot = side->htot2();
 5387: 
 5388:          if (!side->isDry) {
 5389:             atomicAdd(&segment->carea, htot*side->len);
 5390:             atomicAdd(&segment->clen, side->len);
 5391:          }
 5392:       }
 5393: 
 5394:    }
 5395: 
 5396: 
 5397:    __global__ void computeFlowBcVelocities(double time) {
 5398: 
 5399:       SIDE_BND(sideBnd);
 5400: 
 5401:       const Side *side = sideBnd->side;
 5402:  
 5403:       const bool isDry = side->isDry;
 5404:       const bool isLand = sideBnd->segment->isLand;
 5405: 
 5406:    
 5407:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 5408: 
 5409:       if (isDry || isLand) return;
 5410: 
 5411:       // For wet sides in open boundaries...
 5412:       const Vector2 n = side->n;
 5413:       const BoundarySegment *segment = sideBnd->segment;
 5414: 
 5415:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 5416: 
 5417:       const int ifltype = segment->ifltype;
 5418: 
 5419:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 5420:       const Vector2 r_nuth0 = r_uth0*n;
 5421: 
 5422: 
 5423:       if (ifltype == 1 || ifltype == 2) {
 5424:       
 5425:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 5426: 
 5427:          const double unth0 = segment->qthcon*ramp/segment->carea;
 5428:          
 5429:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 5430:          
 5431:       } else if (ifltype == -1) { // Flather 1
 5432: 
 5433:          for (int k = 0; k < nvrt; k++) {
 5434: 
 5435:             // uth is the normal vel.; no ramp up
 5436:             const double uth = sideBnd->nuth(k);
 5437:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 5438: 
 5439:             sideBnd->ubc[k] += uth*n;
 5440:          }
 5441: 
 5442:       } else if (ifltype == 3 || ifltype == 5) {
 5443:          // vnth0=0 !normal vel.
 5444: 
 5445:          Vector2 r_u1_bar = {0.0, 0.0};
 5446:          // Computes the contribution to the velocity from all tide frequencies
 5447:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5448: 
 5449:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 5450:             const Vector2 umo  = sideBnd->umo(jfr); 
 5451: 
 5452:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5453:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 5454:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 5455:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 5456: 
 5457:          }
 5458: 
 5459: 
 5460:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 5461: 
 5462:       } // if (ifltype = 3 || ifltype == 5
 5463: 
 5464: 
 5465: 
 5466:    }
 5467: 
 5468:    __global__ void computeElevationBoundaryConditions(double time) {
 5469:       // Compute elevation essential boundary conditions 
 5470: 
 5471:       NODE_BND(nodeBnd); // Each boundary node.
 5472: 
 5473:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 5474: 
 5475:       const Node *node = nodeBnd->node;
 5476:       const BoundarySegment *segment = nodeBnd->segment;
 5477:       const int iettype = segment->iettype;
 5478:       
 5479: 
 5480:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 5481:       double eic = 0.0;
 5482:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 5483:       else                 eic = 0.0;
 5484: 
 5485:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 5486:       const double r_eth = ramp*nodeBnd->eth;
 5487:       double r_eta1_bar = 0.0;
 5488: 
 5489: 
 5490:       // Compute tide elevation
 5491:       if (iettype == 3 || iettype == 5) {   
 5492: 
 5493:          if constexpr(iloadtide==1) { // loading tide
 5494:             assert(false && "Loading tide not implemented");
 5495:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5496:          }
 5497:          
 5498:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5499: 
 5500:             const double efa  = nodeBnd->efa[jfr]; 
 5501:             const double emo  = nodeBnd->emo[jfr]; 
 5502: 
 5503:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5504:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 5505:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 5506: 
 5507:          } // for jfr
 5508: 
 5509:       } // if iettype
 5510: 
 5511:       switch (iettype) {
 5512:          case 1:
 5513:          case 2:
 5514:          case 4:
 5515:             nodeBnd->elbc = r_eic + r_eth;
 5516:             break;
 5517:          case 3:
 5518:             nodeBnd->elbc = r_eic + r_eta1_bar;
 5519:             break;
 5520:          case 5:
 5521:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 5522:             break;
 5523:       } // switch
 5524: 
 5525: 
 5526:       //Add inverse barometric effects
 5527:       if (iettype != 0 && inv_atm_bnd == 1) {
 5528:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 5529:       }
 5530: 
 5531:    }
 5532: 
 5533: 
 5534:    __global__ void computeHorizontalViscosity(void) { 
 5535: 
 5536:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 5537: 
 5538:       SIDE(side);
 5539: 
 5540:       if (side->isDry) return;
 5541: 
 5542:       for (int k = 0; k < nvrt; k++) {
 5543:          side->nuGradU[k] = {0.0, 0.0};
 5544:       }
 5545: 
 5546:       if constexpr(ihorcon == 1) {
 5547:          for (int k = side->kb; k < nvrt - 1; k++) {
 5548:             // Computes the Laplacian by using the simplified formula presented in the paper:
 5549:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 5550:             // By Zhang and Baptista.
 5551: 
 5552:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 5553:             // This is a standard discretization of the Laplacian operator.
 5554:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 5555:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 5556:             // Gamma is hvis_coef0 in the code.
 5557:             // The value of gamma needs to be < 0.5.
 5558: 
 5559:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 5560:             // side under consideration in each of the two possible elements that share the side.
 5561:             Vector2 sumU = {0.0, 0.0};
 5562:             for (int l = 0; l < 2; l++) {
 5563:                const Element *elem = side->elems[l];
 5564: 
 5565:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 5566: 
 5567:                // Find the local index of the side in the element
 5568:                const int idxSide = elem->sideLocalIdx(side);
 5569: 
 5570:                // Find the two sides that are connected to the side under consideration
 5571:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 5572:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 5573: 
 5574:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 5575: 
 5576:             }
 5577: 
 5578:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 5579: 
 5580:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 5581:    
 5582:          }
 5583:       }
 5584:       else if constexpr(ihorcon == 2) {
 5585:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 5586:       }
 5587: 
 5588: 
 5589:    }
 5590: 
 5591: 
 5592:    __global__ void setEssentialBC(void) {
 5593:       // Set essential boundary conditions 
 5594:       NODE(node); // Each boundary node
 5595:       NodeBoundary *nodeBnd = node->nodeBnd;
 5596:       
 5597:  
 5598:       // Check if this node has essential BC
 5599:       if (nodeBnd && nodeBnd->isEssentialBC) {
 5600:          // Verify BC value is valid
 5601:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5602: 
 5603:        
 5604:          // Set diagonal to 1 and zero off-diagonals
 5605:          node->coeffDiag = 1.0;
 5606: 
 5607:          for (int j = 0; j < node->numNodes; j++) {
 5608:                node->coeffMatrix[j] = 0.0;
 5609:          }
 5610:          
 5611:          // Set solution and RHS to BC value
 5612:          node->mX  = nodeBnd->elbc;
 5613:          node->qel = nodeBnd->elbc;
 5614: 
 5615:       } else {
 5616:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 5617: 
 5618:          for (int j = 0; j < node->numNodes; j++) {
 5619:                Node* nbNode = node->nodes[j];
 5620:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 5621:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 5622:                   // Verify neighbor's BC value
 5623:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5624: 
 5625:                   // Subtract contribution to RHS
 5626:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 5627:                   node->coeffMatrix[j] = 0.0;  
 5628:                }
 5629:          }
 5630:       }
 5631:    }
 5632: 
 5633: 
 5634:    __global__ void updateElevation(void) {
 5635:       NODE(node);
 5636: 
 5637: 
 5638:       node->eta2 = node->mX;
 5639: 
 5640:       node->updateZCoordData();
 5641:    }
 5642: 
 5643: 
 5644:    __global__ void computeVerticallyIntegratedVelocity(void) {
 5645: 
 5646:       SIDE(side);
 5647: 
 5648:       side->U = {0.0, 0.0}; 
 5649:          
 5650:       if(side->isDry) return;
 5651: 
 5652:       // Vertically integrated velocity U
 5653:       for (int k = side->kb; k < nvrt - 1; k++) { 
 5654:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 5655:          side->U += side->Dz(k + 1)*uc;  
 5656:       }
 5657: 
 5658:    }
 5659: 
 5660:    __global__ void computeBottomDragVegetation(void) {
 5661:       // UNFINISHED. CHECK THIS:
 5662:       // How many kernels are needed? Why so many for loops?
 5663:       // Is the loop on sides needed?
 5664: 
 5665:       NODE(node);
 5666: 
 5667: 
 5668:       const int    kb      = node->kb;
 5669:       const double htot    = node->htot2(); 
 5670:       
 5671:       if (node->isDry) {
 5672:          // Default values for dry nodes
 5673:          node->veg_alpha_vert_mean = node->veg_alpha0;
 5674:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 5675: 
 5676:          return;
 5677:        
 5678:       }
 5679: 
 5680:       // Computes bottom drag Cd based on the selected nchi
 5681:       node->computeBottomDragCd();
 5682:       
 5683: 
 5684: 
 5685:       //   Bottom stress in m^2/s^2
 5686:       if (node->rho[kb + 1] >= -98.0)
 5687:       {
 5688:          const double mag_u = length(node->u2[kb + 1]);
 5689:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5690: 
 5691:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5692:          // !sediment erosion: this part needs more documentation
 5693:       }
 5694:     
 5695: 
 5696: 
 5697:       // Compute vegetation parameters
 5698:       //--------------------------------
 5699: 
 5700:       // SAV constants
 5701:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5702:       constexpr double veg_cfpsi = 0.16;
 5703: 
 5704:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5705:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5706: 
 5707:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5708:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5709:          int kbin = 0; // bin index
 5710:          for (int k = kb; k < nvrt; k++) {
 5711:             // Computes node height above the bottom level
 5712:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5713:             assert(false && "Vertical variation of vegetation not implemented");
 5714: 
 5715:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5716:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5717:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5718:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5719:             // } else {
 5720:             //    // Find the bin at which the current vertical level is
 5721:             //    while (kbin<nbins_veg_vert) {
 5722:             //       const double zn = node->z[kbin];
 5723:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5724:             //          break;
 5725:             //       } // if
 5726:             //       kbin++;
 5727:             //    } // while
 5728:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5729: 
 5730:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5731:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5732:                
 5733:             //    // Linear interpolation of the vegetation parameters
 5734:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5735:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5736:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5737:             // } // if rl10
 5738: 
 5739:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5740: 
 5741:          } // for k
 5742: 
 5743: 
 5744:       } else { // Ganthy (iveg==2)
 5745:       //  Modify canopy height, diameter, and density
 5746: 
 5747:          // Make sure there is vegetation on this node
 5748:          if (node->veg_h_unbent > 0.0) {
 5749:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5750: 
 5751:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5752:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5753:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5754: 
 5755:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5756:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5757:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5758:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5759:          } // if veg_h_unbent
 5760: 
 5761:          for (int k = 0; k < nvrt; k++) {
 5762:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5763:          } // for k
 5764:       
 5765: 
 5766:       } // if iveg
 5767:      
 5768: 
 5769:       // Compute vertical mean of veg_alpha3D
 5770:       if (iveg != 0) {
 5771:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5772:          double sum1=0.0;
 5773:          double sum2=0.0;
 5774:          // Integrate over each level under the canopy...
 5775:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5776:             const double Dz = node->Dz(k);
 5777: 
 5778:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5779:             sum2 += Dz;
 5780: 
 5781:          } // for k
 5782:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5783:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5784: 
 5785:       } // if iveg
 5786: 
 5787:    }
 5788: 
 5789:    __global__ void computeVegetationAndDragParameters(void) {
 5790:       // Computes the vegetation and drag model parameters:
 5791:       // chi, \tilde\chi, beta, \breve{H}
 5792:       
 5793:       SIDE(side);
 5794: 
 5795:       side->hhat = 0.0;
 5796:       side->chi2 = 0.0;
 5797:       side->chi = 0.0;
 5798:       side->veg_c2 = 0.0;
 5799:       side->veg_beta = 0.0;
 5800: 
 5801:       if (side->isDry) return;
 5802: 
 5803:       const double htot = side->htot2();
 5804:       const int    kb   = side->kb;
 5805: 
 5806:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5807: 
 5808:       const double veg_h     = side->veg_h();
 5809:       const double veg_nv    = side->veg_nv();
 5810:       const double veg_c     = side->veg_c();
 5811:       const double veg_beta  = side->veg_beta;
 5812:       const double veg_alpha = side->veg_alpha_vert_mean();
 5813: 
 5814:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 5815:       // Velocity magnitude at the bottom level
 5816:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 5817:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 5818:       side->chi2 = side->Cd()*vmag1;
 5819:       side->chi  = side->chi2;
 5820:       if constexpr(iveg != 0) {
 5821:          const Node *n1 = side->n1;
 5822:          const Node *n2 = side->n2;
 5823:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5824:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5825:       }
 5826: 
 5827:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5828: 
 5829:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5830:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5831:       double magUa = 0.0;
 5832:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 5833:          // 3D wet side with veg...
 5834: 
 5835:          double magUa = 0.0;
 5836:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5837:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5838: 
 5839:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 5840:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 5841:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5842: 
 5843:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5844:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5845: 
 5846:                // Velocity magnitude at the bottom (l) of the level
 5847:                const double ul = length(side->u2[k]);
 5848: 
 5849:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5850:                magUa += Dz*0.5*(uh + ul);
 5851: 
 5852:             } // if HasVegetation
 5853:          } // for k
 5854:          const double ua = magUa/min(htot, veg_h); // Vertical average
 5855: 
 5856:          // Computes beta, used for computing the stress term at the top of the canopy.      
 5857:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 5858:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5859:             const double zCpy = side->zTopCanopy();
 5860:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5861:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5862:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5863:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5864:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5865:          } // if isSubmerged
 5866:       } // if iveg   
 5867: 
 5868:       // Computes the friction modified depth, \breve{H} in notes
 5869:       if (side->is2D()) { // 2D
 5870: 
 5871:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5872:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5873: 
 5874:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5875: 
 5876:          side->hhat = htot*htot/fricH; 
 5877: 
 5878:       } else { // 3D
 5879:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 5880: 
 5881:          if constexpr(iveg != 0) {
 5882:             
 5883:             if (side->isSubmerged()) { 
 5884:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5885:                side->hhat -= veg_c*Hhat_alpha;
 5886: 
 5887:             } else { // Emergent
 5888:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5889:             }
 5890:          } // if iveg
 5891: 
 5892:          // Enforce positivity for 3D model
 5893:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 5894:       } // if 3D
 5895: 
 5896:    }
 5897: 
 5898: 
 5899: 
 5900:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5901:    // Computes the density gradient between two elements, e1 and e2.
 5902:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5903:    // zero in the direction normal to the side. 
 5904:    // 
 5905:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5906:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 5907:    //
 5908:    // Input:
 5909:    //    e1: Element
 5910:    //    e2: Neighbor element (or nullptr if boundary)
 5911:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 5912:    //    k: Index of the half-level at which the density is interpolated
 5913:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 5914:    // 
 5915:    // Output:
 5916:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 5917:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 5918: 
 5919:       if (e2 == nullptr || e2->isDry) {
 5920:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 5921: 
 5922:          Side *side = e1->sides[j];
 5923:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 5924:                  
 5925:          if constexpr(ics == 1) {
 5926:             vec = side->n; // Normal vector to the side
 5927:          } else {
 5928:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5929:             // IMPLEMENT THIS XXXXXX
 5930:             // !replace with xel, yel?
 5931:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5932:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5933:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5934:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5935:          } //ics
 5936:                    
 5937:          diffRho = 0.0;
 5938: 
 5939:       } else { //internal and wet
 5940:          if constexpr(ics==1) {
 5941:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5942: 
 5943:             // Vector from e1 to e2
 5944:             vec = e2->center - e1->center;
 5945: 
 5946:          } else { 
 5947:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5948:             // Remember that elem->center is in global coordinates
 5949:             // IMPLEMENT THIS XXXXXX
 5950:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5951:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5952:             //                   alow(j)=xctr2
 5953:             //                   bdia(j)=yctr2
 5954:          } // ics
 5955: 
 5956:          diffRho = rho2 - e1->demeanedDensity(k);
 5957:       }
 5958: 
 5959:    }
 5960: 
 5961:    __global__ void computeDensityCubicSplines(void) {
 5962:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5963: 
 5964:       ELEM(elem);
 5965: 
 5966:       if (elem->isDry) return;
 5967: 
 5968:       const int kb = elem->kb;
 5969: 
 5970:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5971:       if (elem->is2D()) {
 5972:          // In the 2D case, the density is constant at the prism level. 
 5973:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5974:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5975:       } else { //3D
 5976: 
 5977:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5978:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5979:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5980:          ///// XXXX CHECK INDICES!!!!!
 5981:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5982:       } // 2D/3D
 5983: 
 5984:    }
 5985: } // extern "C"
 5986: 
 5987: 
 5988: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5989: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5990: 
 5991:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5992: 
 5993:    const int kb  = elem->kb;
 5994:    const int kb2 = elem2->kb;
 5995: 
 5996:    // z-coordinate of prism of elem
 5997:    const double zp = elem->z_prism(k);
 5998: 
 5999:    double rho = 0.0;
 6000: 
 6001:    if (elem2->is2D()) {
 6002:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 6003: 
 6004:    } else {  // 3D
 6005: 
 6006:       // eta_min may be < zmax
 6007:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 6008:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 6009: 
 6010:       // (Extrapolate density below bottom, we will fix it later)
 6011:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 6012:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 6013:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 6014:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 6015:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 6016:    } // 2D/3D
 6017:      
 6018: 
 6019:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 6020:    // Now we need to fix it.
 6021:    if (elem->z[k] < elem2->z[kb2]) {
 6022:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 6023: 
 6024:       // There are two methods to adjust the density at the bottom of the element.
 6025:       // iunder_deep=0: 
 6026:       const double depth1 = abs(elem->z[kb]); // larger depth
 6027: 
 6028:       if (iunder_deep==0) {
 6029: 
 6030:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 6031: 
 6032:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 6033: 
 6034:       } else { // iunder_deep != 0
 6035: 
 6036:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 6037: 
 6038:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 6039: 
 6040:          //   Demeaned density at the same z coordinate as
 6041:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 6042:          }
 6043: 
 6044:       } // if iunder_deep
 6045:    } // if elem->z[kb] < elem2->z[kb]
 6046: 
 6047:    return rho;
 6048: }
 6049: 
 6050: 
 6051: extern "C" {
 6052:    __global__ void computeDensityGradient(void) {
 6053: 
 6054:       if constexpr(ibc != 0) return;
 6055: 
 6056:          // Compute the horizontal density gradient at each element.
 6057:       // It works in two steps:
 6058:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6059:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6060:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6061:       //             gradRho.r1 = rho1 - rho0
 6062:       //             gradRho.r2 = rho2 - rho0
 6063:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6064:       // 
 6065:       //  NOTE: We use de-meaned densities.
 6066: 
 6067:       ELEM(elem);
 6068: 
 6069:       if (elem->isDry) return;
 6070: 
 6071:       const int kb  = elem->kb;
 6072:       const int i34 = elem->i34;
 6073: 
 6074:       for (int k = kb + 1; k < nvrt; k++) {
 6075:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 6076:          //             gradRho.r1 = rho1 - rho0
 6077:          //             gradRho.r2 = rho2 - rho0
 6078:          int icount = 0;
 6079:          double sumRx = 0.0;
 6080:          double sumRy = 0.0;
 6081:          for (int j1=0; j1<i34; j1++) { 
 6082: 
 6083:             const int j2 = elem->nxq(j1 + 1);
 6084: 
 6085:             // Pairs of consecutive neighbor elements of elem
 6086:             const Element *e1 = elem->nghbElems[j1];
 6087:             const Element *e2 = elem->nghbElems[j2];
 6088: 
 6089:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 6090:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 6091:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 6092: 
 6093:             // Compute the density difference and the vector from elem to e1 and e2
 6094:             // getRhoDiffAndVec takes into account boundaries/dry elements
 6095:             double diffRho1, diffRho2;
 6096:             Vector2 vec1, vec2;
 6097:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 6098:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 6099: 
 6100:             const double rl1 = length(vec1);
 6101:             const double rl2 = length(vec2);
 6102:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 6103: 
 6104:             const double delta = cross(vec1, vec2);
 6105:             const double sintheta = abs(delta)/(rl1*rl2);
 6106: 
 6107:             // To avoid problems, avoid elements with small angle between vectors
 6108:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 6109:             const bool validEq = (sintheta > sin_one_deg);
 6110: 
 6111:             if (validEq) {
 6112:                // Solve the system of equations to get the density gradient at elem
 6113:                icount++;
 6114:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 6115:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 6116:                sumRx += Rx;
 6117:                sumRy += Ry;
 6118:             }
 6119:          } // for j1
 6120: 
 6121:          // Compute the average density gradient at elem
 6122:          if (icount==0) {
 6123:            // Bad mesh quality; bail out with 0 b-cc
 6124:            elem->gradRho[k] = {0.0, 0.0};
 6125:          } else {
 6126:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 6127:          }
 6128: 
 6129:       } // for k
 6130: 
 6131:    }
 6132: 
 6133:    __global__ void computeBaroclinicTerm(void) {
 6134:    // Computes the baroclinic term at sides (at half levels).
 6135:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 6136:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 6137: 
 6138:       if (ibc == 1) return;
 6139: 
 6140:       SIDE(side);
 6141: 
 6142:       if (side->isDry) return;
 6143: 
 6144:       const Element *e1 = side->elems[0];
 6145:       const Element *e2 = side->elems[1]; 
 6146:       const int kb = side->kb;
 6147:       
 6148:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 6149: 
 6150:       // interpolates vertically the density gradient of the two elements at the half level/
 6151: 
 6152:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 6153:       int k2 = max(kb, nvrt / 2);
 6154: 
 6155:       // Starts the integration at the surface and goes down to the bottom
 6156:       side->bcc[nvrt-1] = {0.0, 0.0};
 6157:       for (int k = nvrt - 2; k >= kb; k--) {
 6158:       // For each prism level (from surface to bottom)...
 6159: 
 6160:          // For both elements, interpolate density gradient at the side's half level.
 6161:          // The gradient at the side is the average of the gradients at the elements.
 6162:          // w1, w2 are used to take into account boundary sides, with just one element.
 6163:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 6164:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 6165:          const double wsum = w1 + w2;
 6166:          w1 = w1/wsum;
 6167:          w2 = w2/wsum;
 6168:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 6169: 
 6170:          // Linear interpolation of both elements' density gradient at the shared side's level.
 6171:          Vector2 gradRho = {0.0, 0.0};
 6172:          if (e1 != nullptr && k > kb) {
 6173:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 6174:             
 6175:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 6176:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 6177:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6178: 
 6179:             // Grad(rho) vertically interpolated at the side's half level
 6180:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 6181: 
 6182:             // Projects the element density gradient to the side frame if needed.
 6183:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 6184: 
 6185:             // Adds the contribution of the density gradient at the side's half level
 6186:             gradRho += gradRho1*w1;
 6187:          }      
 6188:          if (e2 != nullptr && k > kb) {
 6189:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 6190:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 6191:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6192:             
 6193:             // Grad(rho) vertically interpolated at the side's half level
 6194:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 6195: 
 6196:             // Projects the element density gradient to the side frame if needed.
 6197:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 6198: 
 6199:             // Adds the contribution of the density gradient at the side's half level
 6200:             gradRho += gradRho2*w2;
 6201:          }
 6202: 
 6203:          
 6204:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 6205:          // multiplied by -rampbc*(g/rho0) 
 6206:          const double grav3 = side->grav3();
 6207:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 6208: 
 6209:       } // for
 6210: 
 6211:    }
 6212: 
 6213: 
 6214: 
 6215:    __global__ void computeHorGradientAtSide(void) {
 6216: 
 6217:       // Compute the horizontal density gradient at each element.
 6218:       // It works in two steps:
 6219:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6220:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6221:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6222:       //             gradRho.r1 = rho1 - rho0
 6223:       //             gradRho.r2 = rho2 - rho0
 6224:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6225:       // 
 6226:       //  NOTE: We use de-meaned densities.
 6227: 
 6228:       SIDE(side);
 6229: 
 6230: 
 6231:       if (side->isDry) return;
 6232: 
 6233:       // Computes the gradient of the variables at the side center.
 6234:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 6235:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 6236:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 6237: 
 6238:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 6239:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 6240:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 6241:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 6242: 
 6243:    }
 6244: 
 6245: 
 6246:    __global__ void solveMomentumEquations(double time) {
 6247: 
 6248:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 6249:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 6250: 
 6251:       SIDE(side);
 6252: 
 6253:       if (side->isDry) 
 6254:       {
 6255:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 6256: 
 6257:          return;
 6258:       }
 6259: 
 6260:       const Node *n1 = side->n1;
 6261:       const Node *n2 = side->n2;
 6262: 
 6263:       const int kb = side->kb;
 6264: 
 6265:       const double veg_h = side->veg_h();
 6266:       const double grav3 = side->grav3();
 6267: 
 6268:       if (side->is2D()) {
 6269:          // Remember: Do not use htot2, which is updated.
 6270:          const double htot = side->htot1();
 6271:          const double hhat = side->hhat;
 6272: 
 6273:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 6274: 
 6275:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6276:          const Vector2 tau2 = side->tau();
 6277: 
 6278:          // hat_gam has units of m/s
 6279: 
 6280:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 6281:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 6282:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 6283: 
 6284:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 6285: 
 6286: 
 6287:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 6288: 
 6289:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 6290: 
 6291:       }
 6292:       else { // 3D
 6293: 
 6294:          // For 3D it is necessary to solve an implicit tridiagonal system.
 6295:          // 
 6296:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 6297:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 6298:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 6299:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 6300:          // k+1 and k.
 6301: 
 6302: 
 6303:          const int ndim = nvrt - kb;
 6304:          const double zTopCanopy = side->zTopCanopy();
 6305: 
 6306:          // Initialize the tridiagonal system
 6307:          for (int k = kb + 1; k < nvrt; k++) {
 6308:             
 6309:             const int kin = k - (kb + 1);
 6310: 
 6311:             // Vertical viscosity at the face center
 6312:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 6313: 
 6314:  
 6315:             alow[kin] = 0.0;
 6316:             cupp[kin] = 0.0;
 6317:             bdia[kin] = 0.0;
 6318: 
 6319:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 6320:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 6321: 
 6322:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 6323:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 6324:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 6325: 
 6326:             // First part: layers k, k+1
 6327:             if (k < nvrt - 1) {
 6328:                              
 6329:                if constexpr(iveg != 0) {
 6330: 
 6331:                   // If there is vegetation at this level...
 6332:                   if (zTopCanopy > side->zc[k]) {
 6333:                      // If the canopy is above the k layer...
 6334:                      
 6335:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 6336:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 6337:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 6338:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 6339: 
 6340:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 6341:                      const double vmag2 = length(ut2);
 6342:                      const double vmag1 = length(side->u2[k]);
 6343:                      const double vmag = 0.5*(vmag1 + vmag2);
 6344:                      
 6345:                      // Computes the vegetation alpha at the face center
 6346:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 6347: 
 6348:                      cff1 += veg_alpha_sd*dt*vmag;
 6349: 
 6350:                   } // if (zTopCanopy
 6351:                } // if iveg
 6352: 
 6353:                const double dzz = side->Dz(k + 1);
 6354:                const double tmp = dt*dfz/dzz;
 6355:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6356: 
 6357:                cupp[kin] += cff1*dzz/6.0 - tmp;
 6358:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6359:             }
 6360: 
 6361: 
 6362:             // Second part: layers k-1, k
 6363:             if (k > kb + 1) {
 6364: 
 6365:                double cff1 = 1.0; //init \bar{c^k}
 6366: 
 6367:                if constexpr(iveg != 0) {
 6368:                   // If there is vegetation at this level...
 6369:                   if (zTopCanopy > side->zc[k-1]) {
 6370:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 6371:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 6372: 
 6373:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 6374: 
 6375:                      const double vmag2 = length(ut2);
 6376:                      const double vmag1 = length(side->u2[k-1]);
 6377:                      const double vmag = 0.5*(vmag1 + vmag2);
 6378: 
 6379:                      // Computes the vegetation alpha at the face center
 6380:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 6381:                      cff1 += veg_alpha_sd*dt*vmag;
 6382:                   } // if zTopCanopy
 6383: 
 6384:                } // if iveg
 6385: 
 6386:                const double dzz = side->Dz(k);
 6387:                const double tmp = dt*dfz/dzz;
 6388:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6389: 
 6390:                alow[kin] += cff1*dzz/6.0 - tmp;
 6391:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6392: 
 6393:             } else { // Bottom boundary
 6394:                // This occurs at the bottom, where the bottom drag is applied.
 6395: 
 6396:                bdia[kin] += dt*side->chi2; // XXXX
 6397: 
 6398:             } // if (k > kb + 1)
 6399: 
 6400: 
 6401:          } // for (int k
 6402: 
 6403: 
 6404: 
 6405:          // Computes the RHS.
 6406:          // -----------------
 6407: 
 6408:          //	BC to be imposed at the end.
 6409: 
 6410:          const Vector2 gradETP  = side->gradETP;
 6411:          const Vector2 gradPr   = side->gradPr;
 6412:          const Vector2 gradEta1 = side->gradEta1;
 6413:          const Vector2 gradEta2 = side->gradEta2;
 6414: 
 6415:          const Vector2 *btu = side->btu;
 6416:          const Vector2 *u2  = side->u2;
 6417:          const double coriolis = side->coriolis;
 6418:          const Vector2 *nuGradU = side->nuGradU;
 6419: 
 6420:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 6421:          for (int k = kb + 1; k < nvrt; k++) {
 6422:             const int kin = k - kb - 1;
 6423: 
 6424:             const double dz_0 = side->Dz(k);
 6425:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 6426: 
 6427:             rrhs[kin] = {0.0, 0.0};
 6428:             double dz = 0.0;
 6429: 
 6430:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 6431:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 6432:             if (k < nvrt  ) dz += dz_1;
 6433:             if (k > kb + 1) dz += dz_0;
 6434: 
 6435:             // Elevation gradient, atmospheric pressure and tidal potential
 6436:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 6437: 
 6438:             // Coriolis, advection, wind stress, and horizontal viscosity
 6439:             if (k < nvrt - 1) {
 6440: 
 6441: 
 6442:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 6443:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 6444:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 6445:                                                 
 6446: 
 6447:                //diff stress tensors 1006
 6448:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 6449:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 6450:                   assert(false && "Not implemented: itur == 5");
 6451:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 6452:                }
 6453:                // else assert(false && "itur # Not implemented");
 6454: 
 6455:             } else { // k == nvrt - 1 SURFACE
 6456:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6457:                const Vector2 tau2 = side->tau();
 6458: 
 6459:                rrhs[kin] += dt*tau2;          
 6460: 
 6461:             } // if k<nvrt
 6462: 
 6463: 
 6464:             if (k > kb + 1) {
 6465:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 6466:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 6467:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 6468: 
 6469:                // diff stress tensors 1006
 6470:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 6471:                   assert(false && "Not implemented: itur == 5");
 6472:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 6473:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 6474:                }
 6475:                // else assert(false && "itur # Not implemented");
 6476: 
 6477: 
 6478:             } // if k>kbs + 1
 6479: 
 6480:             // Baroclinic
 6481:             Vector2 *bcc = side->bcc;
 6482:             if constexpr(ibc == 0) {
 6483:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 6484:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 6485: 
 6486:             } // if ibc==0
 6487: 
 6488:          } // k=kb + 1,nvrt
 6489: 
 6490: 
 6491:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 6492: 
 6493:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 6494:             const int kin = k - kb - 1;
 6495:    
 6496:             // Velocity is always clamped to maximum values
 6497:             side->u2[k] = clampVelocity(soln[kin]);
 6498:          } // k
 6499: 
 6500:       } // if side->is2D()
 6501:       
 6502: 
 6503:       // Impose velocity boundary condition at the bottom
 6504:       if constexpr(imm == 2) { // 3D bed deformation model
 6505:          double dep;
 6506:          Vector2 vel;
 6507: 
 6508:          assert(false && "Not implemented: imm == 2");
 6509:          //update_bdef(time, x0, y0, dep, vel);
 6510:          // side->u2[kb] = vel;
 6511: 
 6512:       } else { // imm = 0 or 1
 6513:          if (side->Cd() == 0.0) {
 6514:             side->u2[kb] = side->u2[kb + 1];
 6515: 
 6516:          } else if (side->is3D()) { // 3D no slip bottom   
 6517:             side->u2[kb] = {0.0, 0.0};
 6518: 
 6519:          }
 6520:           
 6521:       } // if imm
 6522: 
 6523:       // The velocities below the bottom level are set to zero
 6524:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 6525: 
 6526: 
 6527:    }
 6528: 
 6529: 
 6530:    __global__ void applyMomentumBC(void) {
 6531: 
 6532:       SIDE_BND(sideBnd);
 6533: 
 6534:       Side *side = sideBnd->side;
 6535:       const BoundarySegment *segment = sideBnd->segment;
 6536:       const Node *n1 = side->n1;
 6537:       const Node *n2 = side->n2;
 6538: 
 6539:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 6540: 
 6541:       const bool isLand = segment->isLand;
 6542:       const int ifltype = segment->ifltype;
 6543: 
 6544:       const int kb = side->kb;
 6545: 
 6546: 
 6547:       if (!isLand && ifltype != 0) {
 6548:          const Vector2 *ubc = sideBnd->ubc;
 6549:   
 6550:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 6551:             
 6552:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 6553:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 6554: 
 6555:             if (ifltype == -1) {
 6556:                // Flather 1
 6557: 
 6558:                const double depth = side->depth();
 6559: 
 6560:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 6561: 
 6562:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 6563: 
 6564:                side->u2[k] = vnorm*side->n;
 6565: 
 6566:             } else if (ifltype == -2) { // Discharge
 6567: 
 6568:                const double eta1 = side->eta1();
 6569:                const double eta2 = side->eta2();
 6570:                const double htot = side->htot2();
 6571: 
 6572:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 6573:                assert(false && "Not implemented: Discharge bc");
 6574:                // const double dischrg = discharge(eta1);
 6575:                const double dischrg = 0.0; // XXX REMOVE
 6576:                
 6577: 
 6578:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 6579: 
 6580:                const double vnorm = dischrg*eta2/htot;
 6581: 
 6582:                side->u2[k] = vnorm*side->n;
 6583: 
 6584:             }
 6585:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 6586:                const double vnorm = dot(side->u2[k], side->n);
 6587: 
 6588:                double rat;
 6589:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 6590:                else              rat = segment->vobc2; // outgoing
 6591: 
 6592:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 6593: 
 6594:             }
 6595:             else { // not Flather or 3D radiation
 6596:                side->u2[k] = ubc[k];
 6597: 
 6598:             } // if (segment->ifltype...
 6599: 
 6600:          }
 6601: 
 6602:       }
 6603:       else if (isLand) { // if it is land boundary side
 6604: 
 6605:          if constexpr(islip == 0) { // free slip
 6606: 
 6607:             for (int k = kb; k < nvrt; k++) {
 6608: 
 6609:                const Vector2 t = side->t();
 6610:                const Vector2 n = side->n;
 6611: 
 6612:                double vnorm = 0.0; // for most cases
 6613:                const double vtan = dot(side->u2[k], t);
 6614:                
 6615:                side->u2[k] = vtan*t - vnorm*n;
 6616: 
 6617:             }
 6618: 
 6619:          } else { // no slip
 6620:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 6621: 
 6622:          }
 6623:       } // if (side segment type...
 6624: 
 6625:    
 6626: 
 6627:    }
 6628: 
 6629: 
 6630:    __global__ void shapiroFilter1(void) {
 6631:       // First step of the Shapiro filter (normally used if indvel<=0)
 6632:       // Computes the filtered values and stores them in bcc (as a temporary array).
 6633: 
 6634:       SIDE(side);
 6635: 
 6636:       // Only internal wet sides are processed
 6637:       if (side->isDry || !(side->isInternal())) return;
 6638: 
 6639:       const int kb = side->kb;
 6640: 
 6641:       for (int mm = 0; mm < niter_shap; mm++) {
 6642: 
 6643:          for (int k = kb + 1; k < nvrt; k++) {
 6644:             // WARNING: reusing bcc as a temporary array to store the suru values.
 6645:             Vector2 suru = {0.0, 0.0};
 6646: 
 6647:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 6648: 
 6649:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 6650: 
 6651:                int kin = k;
 6652:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 6653:                
 6654:                // Get the velocity at the neighbor's side.
 6655:                Vector2 nSideU2 = nSide->u2[kin];
 6656: 
 6657:                // Projects the velocity to the current side frame if needed.
 6658:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 6659: 
 6660:                suru += nSideU2;
 6661:             }
 6662: 
 6663:             // Reusing bcc as a temporary array to store the suru values.
 6664:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 6665: 
 6666:          }
 6667:       }
 6668:    }
 6669: 
 6670:    __global__ void shapiroFilter2(void) {
 6671:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6672: 
 6673:       SIDE(side);
 6674: 
 6675: 
 6676:       if (side->isDry || !(side->isInternal())) return;
 6677: 
 6678:       const int kb = side->kb;
 6679: 
 6680:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6681: 
 6682:       if (side->is2D()) {
 6683:          side->u2[kb + 1] = side->bcc[kb + 1];
 6684:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6685: 
 6686:       } else {
 6687:          // 3D
 6688:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6689:          
 6690:       }
 6691: 
 6692:    }
 6693: 
 6694: 
 6695:    __global__ void ul0UpdateZCoords(void) {
 6696:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6697:       
 6698:       NODE(node);      
 6699: 
 6700: 
 6701:       if (false) { //node->isDry) { XXXXXXX
 6702: 
 6703:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6704: 
 6705:          if constexpr(ivcor != 1) node->kb = 0;
 6706: 
 6707:       } else {
 6708: 
 6709:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6710:          node->updateKb();
 6711: 
 6712:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6713: 
 6714:       }
 6715: 
 6716:       // We use the temp.b field to store the previous state of isDry.
 6717:       node->tmp.b = node->isDry;
 6718: 
 6719:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6720:       node->isDry = true;
 6721: 
 6722:    }
 6723: 
 6724:    __global__ void ul0ComputeDryElements(void)
 6725:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6726:    {
 6727:       ELEM(elem);
 6728: 
 6729:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6730: 
 6731:       elem->kb = 0;
 6732: 
 6733:       if (elem->isDry) return;
 6734: 
 6735: 
 6736:    //    if(elem->isDry2()) { // XXXX
 6737:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6738:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6739:    //        call parallel_abort(errmsg)
 6740:    //    }
 6741: 
 6742:       const Node *n1 = elem->nodes[0];
 6743:       const Node *n2 = elem->nodes[1];
 6744:       const Node *n3 = elem->nodes[2];  
 6745:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6746: 
 6747:       // Computes element's kb as the minimum of the nodes' kb.
 6748:       const int kb1 = n1->kb;
 6749:       const int kb2 = n2->kb;
 6750:       const int kb3 = n3->kb;
 6751:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 6752: 
 6753: 
 6754:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6755: 
 6756: 
 6757:       // Computes the element z as the mean of the nodes z.
 6758:       for (int k = elem->kb; k < nvrt; k++) {
 6759: 
 6760:          // Compute the element z as the mean of the nodes z.
 6761:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6762:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6763:          elem->z[k] /= elem->i34;
 6764: 
 6765:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 6766:       }
 6767:                   
 6768:    }
 6769: 
 6770:    __global__ void ul0ComputeDryNodes(void)
 6771:    // Updates node's isDry based on the elements' isDry. 
 6772:    {
 6773:       NODE(node);
 6774: 
 6775:       node->isDry = true;
 6776: 
 6777:       // A node is wet if at least one of the elements sharing it is wet.
 6778:       for (int j = 0; j < node->numElements; j++) {
 6779:          const Element *elem = node->elements[j];
 6780:          if (!elem->isDry) {
 6781:             node->isDry = false;
 6782:             break;
 6783:          }
 6784:       }
 6785: 
 6786:        
 6787:    }
 6788: 
 6789: 
 6790:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6791:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6792:    // node->tmp.b is true if the node was previously dry.
 6793:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6794:    {
 6795:       NODE(node);
 6796:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6797: 
 6798:       // Avoid this the first time step.
 6799:       if (it == iths) return;  
 6800: 
 6801:       const bool wasDry = node->tmp.b;
 6802: 
 6803: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6804: 
 6805:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 6806: 
 6807:          for (int k=0; k < nvrt; k++) {
 6808: 
 6809:             Vector3 utmp={0.0, 0.0, 0.0};
 6810: 
 6811:             double ttmp=0.0;
 6812:             double stmp=0.0;
 6813:             int icount=0;
 6814:             for (int j = 0; j < node->numNodes; j++) {
 6815: 
 6816:                const Node *nbrNode = node->nodes[j];
 6817:                
 6818:                const bool wasNbrDry = nbrNode->tmp.b;
 6819: 
 6820:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 6821:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 6822: 
 6823:                   icount++;
 6824: 
 6825:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6826:                   utmp += nbrNode->uvw2(k);
 6827:                   
 6828:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 6829:                   stmp += nbrNode->tracers[k].tracer[1]; 
 6830:                }
 6831:             }
 6832: 
 6833:             if (icount > 0) {
 6834:                const double inv_icount = 1.0/icount;
 6835:                utmp = inv_icount*utmp;
 6836:                node->u2[k]     = toVector2(utmp);
 6837:                node->w2[k]     = utmp.z;
 6838:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6839:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6840:             } else {
 6841:                node->u2[k] = {0.0, 0.0};
 6842:                node->w2[k] = 0.0;
 6843:                // Initialize tracers to 0.0??? XXXXX
 6844:             }
 6845:          }
 6846:       }
 6847:    }
 6848: 
 6849:   
 6850:    
 6851: 
 6852: 
 6853:    __global__ void ul0UpdateSides(int it, int iths) {
 6854:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 6855:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 6856:    // The dryness of the sides is updated in ul0UpdateSides2.
 6857: 
 6858:       SIDE(side);
 6859: 
 6860:       // A side is wet if and only if at least one of its elements is wet.
 6861:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6862:  
 6863:       const Node *n1 = side->n1;
 6864:       const Node *n2 = side->n2;
 6865:      
 6866:       const int kb1 = n1->kb;
 6867:       const int kb2 = n2->kb;
 6868: 
 6869:       side->kb = 0; // default when dry
 6870: 
 6871:       if (isWet) {
 6872: 
 6873:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6874: 
 6875:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6876: 
 6877:          side->kb = min(kb1, kb2);
 6878: 
 6879:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6880: 
 6881:          for (int k = side->kb; k < nvrt; k++) {
 6882:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6883: 
 6884:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 6885: 
 6886:             // Compute velocity for re-wetted sides 
 6887:             if ((it != iths) && (side->isDry && isWet)) {
 6888: 
 6889:                Vector2 utmp={0.0, 0.0};
 6890: 
 6891:                int icount=0;
 6892: 
 6893:                // For all the sides on the two elements that share this side
 6894:                for (int j = 0; j < 2; j++) {
 6895:                   const Element *elem = side->elems[j];
 6896:                   if (elem == nullptr) continue;
 6897: 
 6898:                   for (int jj=0; jj < elem->i34; jj++) {
 6899:                      const Side *nSide = elem->sides[jj];
 6900:                      if (nSide->isDry) continue;
 6901: 
 6902:                      icount++;
 6903:                      utmp += nSide->u2[k];  
 6904:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 6905:                   }
 6906:                }
 6907:                   
 6908:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 6909:                if (icount > 0)  side->u2[k] = utmp/icount;
 6910:                else             side->u2[k] = {0.0, 0.0};
 6911:                   
 6912:             } // if ((it != iths) && (side->isDry && isWet))
 6913: 
 6914:          } // for k
 6915: 
 6916:       } // if isWet 
 6917:       
 6918: 
 6919: 
 6920:    }
 6921: 
 6922:    __global__ void ul0UpdateSides2(void) {
 6923:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 6924:    
 6925:          SIDE(side);
 6926:    
 6927:          const Element *e1 = side->elems[0];
 6928:          const Element *e2 = side->elems[1];
 6929: 
 6930:          // A side is wet if and only if at least one of its elements is wet.
 6931:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 6932: 
 6933:          // Update the side's dryness
 6934:          side->isDry = !isWet;
 6935: 
 6936:    }
 6937: 
 6938: 
 6939:    __global__ void zeroNodalVelocities(void) {
 6940:       NODE(node);
 6941: 
 6942:       for (int k = 0; k < nvrt; k++) {
 6943:          node->u2[k]   = {0.0, 0.0};
 6944:          node->w2[k]   = 0.0;
 6945:          node->utmp[k] = {0.0, 0.0};         
 6946:       }
 6947:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6948:    }
 6949:  
 6950: 
 6951:    __global__ void computeNodalVerticalVelocities1(void) {
 6952:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6953:    // Adds the element's vertical velocity times the element's area.
 6954:       ELEM(elem);
 6955: 
 6956:       for (int j = 0; j < elem->i34; j++) {
 6957:          Node *node = elem->nodes[j];
 6958: 
 6959:          for (int k = node->kb; k < nvrt; k++) {
 6960:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6961:          }
 6962:          atomicAdd(&(node->tmp.d), elem->area);
 6963:       }
 6964:    }
 6965: 
 6966:    __global__ void computeNodalVerticalVelocities2(void) {
 6967:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6968:    // Divides by the total area of the elements sharing the    node.
 6969:       NODE(node);
 6970: 
 6971:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 6972: 
 6973:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6974:    }
 6975: 
 6976: 
 6977:    __global__ void computeNodalHorizontalVelocities1(void) {
 6978: 
 6979:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6980: 
 6981:       ELEM(elem);
 6982: 
 6983:       if (elem->isDry) return;
 6984: 
 6985:       const int kb = elem->kb;
 6986:       const bool isTri = elem->isTri();
 6987: 
 6988:       if constexpr(indvel <= 0) {
 6989:          // Assuming discontinous hvel.
 6990: 
 6991:          if (isTri) { // For triangles
 6992:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6993:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6994: 
 6995:             for (int j = 0; j < 3; j++) {
 6996:                // For every node of the triangle...
 6997:                Node *node = elem->nodes[j];
 6998: 
 6999:                if (node->isDry) continue;
 7000: 
 7001:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 7002:                const Side *s2 = elem->sides[(j + 1) % 3];
 7003:                const Side *s3 = elem->sides[(j + 2) % 3];
 7004: 
 7005:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 7006: 
 7007:                atomicAdd(&(node->tmp.i), 1);
 7008: 
 7009:                for (int k = kb; k < nvrt; k++)  {
 7010:                   Vector2 s1u2 = s1->u2[k];
 7011:                   Vector2 s2u2 = s2->u2[k];
 7012:                   Vector2 s3u2 = s3->u2[k];
 7013: 
 7014:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 7015:                   if constexpr(ics == 2) {
 7016:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 7017:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 7018:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 7019:                   }
 7020: 
 7021:                   Vector2 u = s2u2 + s3u2 - s1u2; // u interpolated linearly at node j.   
 7022:                   u = clampVelocity(u);
 7023:                   atomicAdd(&(node->utmp[k].x), u.x);
 7024:                   atomicAdd(&(node->utmp[k].y), u.y);
 7025: 
 7026:                }
 7027: 
 7028:             }
 7029:          }
 7030:          else { // For quads
 7031:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 7032: 
 7033:          }
 7034: 
 7035:       }
 7036:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 7037:       
 7038:    }
 7039: 
 7040: 
 7041:    __global__ void computeNodalHorizontalVelocities2(void) {
 7042:       NODE(node);
 7043: 
 7044:       const int nodeCount = node->tmp.i;
 7045: 
 7046:       if (nodeCount == 0) 
 7047:       {
 7048:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 7049:          return;
 7050:       }
 7051: 
 7052:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 7053:       
 7054:       const int kb = node->kb;
 7055: 
 7056:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 7057:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 7058:       
 7059:       
 7060:    }   
 7061: 
 7062:  
