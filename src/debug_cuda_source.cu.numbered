 7468: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 7469:    Node *nodes = mesh->localNodeData;
 7470: 
 7471:    *addr = nodes;
 7472:    *sizeNode = sizeof(Node);
 7473: 
 7474:    switch (varCode) {
 7475:       case (int)VarCode::depth:
 7476:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 7477:          *sizeType = sizeof(double);
 7478:          break;
 7479:       case (int)VarCode::eta:
 7480:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 7481:          *sizeType = sizeof(double);
 7482:          break;
 7483:       case (int)VarCode::x:
 7484:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 7485:          *sizeType = sizeof(Vector2);
 7486:          break;
 7487:       case (int)VarCode::z:
 7488:          *offset = (int)((char*)&nodes[0].z[0] - (char*)nodes);
 7489:          *sizeType = sizeof(double);
 7490:          break;
 7491:       case (int)VarCode::kb:
 7492:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 7493:          *sizeType = sizeof(int);
 7494:          break;
 7495:       case (int)VarCode::isdry:
 7496:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 7497:          *sizeType = sizeof(int);
 7498:          break;         
 7499:       case (int)VarCode::w:
 7500:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 7501:          *sizeType = sizeof(double);
 7502:          break;
 7503:       case (int)VarCode::u:
 7504:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 7505:          *sizeType = sizeof(Vector2);
 7506:          break;         
 7507:       default:
 7508:          *offset = -1;    
 7509:    }  
 7510:    
 7511: }
