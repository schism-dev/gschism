 6544: #ifdef DONTCOMPILE
 6545: __device__ void computeVerticalAdvection(void) {
 6546:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6547: 
 6548:    sdbt(1:2,:,:)=0.d0
 6549: 
 6550:    const Side *side = FROM kernel;
 6551: 
 6552:    if(side->isDry) return;
 6553: 
 6554:    // If side is wet...
 6555: 
 6556: 
 6557:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6558:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6559:    double ws[nvrt] = {} // w @ side
 6560:    int icount = 0;
 6561:    for (int j=0; j<2; j++) {
 6562:       const Element *elem = side->elements[j];
 6563:        
 6564:       if(elem != nullptr) {
 6565:          icount++;
 6566:          for (int k=0; k<nvrt; k++) {
 6567:             ws[k] = ws[k] + elem->w[k];
 6568:          }
 6569:       }
 6570:    }  // for j
 6571: 
 6572:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6573:    ws = ws/icount;
 6574: 
 6575:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6576:    // Splines allow for a smooth transition between vertical levels.
 6577:    // Splines have continuity restrictions at the internal knots, but
 6578:    // we have to provide the 1st derivatives at the endpoints.
 6579:    const int kbs = side->kbs; 
 6580:    
 6581:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6582:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6583:    initCubicSpline(kbs, nvrt, side, ws, up)
 6584: 
 6585:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6586:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6587:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6588: 
 6589:    // Total advection (average onto side)
 6590:    const Node *node1 = side->nodes[0];
 6591:    const Node *node2 = side->nodes[1];
 6592:    for (int k=kbs(i); k<nvrt; k++) {
 6593: 
 6594:       if constexpr(ics==1) {
 6595:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6596:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6597:       } else {
 6598:          // XXX IMPLEMENT THIS
 6599:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6600:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6601:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6602:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6603:       }  // if ics
 6604: 
 6605: 
 6606:    }
 6607: }
 6608: #endif
 6609: 
 6610: 
 6611: extern "C" {
 6612:    __global__ void computeElemAverageGhat(void) {
 6613:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6614: 
 6615:       ELEM(elem);
 6616:       
 6617:       elem->ghat1= {0.0, 0.0};  
 6618: 
 6619:       if constexpr(ihydraulics != 0) {
 6620:          if (nhtblocks > 0 && elem->isblock) return;
 6621:       }
 6622: 
 6623:       if (elem->isDry) return;
 6624: 
 6625:       // Wet elements.
 6626:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6627:       // tidal potential, horizontal diffusion, and baroclinic etc
 6628:       // Remember to update both fb and F 
 6629:       // If ics=2, ghat1 are in eframe (ll)
 6630:       // cff1-3: coefficients for 2D/3D
 6631:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6632:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6633:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6634: 
 6635:       double av_cff1 = 0.0;  // av. for cff1
 6636:       double av_cff2 = 0.0;  // av. for cff2
 6637:       double av_cff3 = 0.0;  // av. for cff3
 6638:       double av_df = 0.0;  // av. for H^\alpha / H
 6639:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6640:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6641: 
 6642:       const int i34 = elem->i34;
 6643:       const int kb = elem->kb;
 6644: 
 6645:       for (int j=0; j<i34; j++) {
 6646:          // For each node and side in the element...
 6647: 
 6648:          const Node *node = elem->nodes[j];
 6649:          const Side *side = elem->sides[j];
 6650: 
 6651:          const double chi      = side->chi;
 6652:          const double veg_c2   = side->veg_c2;
 6653:          const double veg_beta = side->veg_beta;
 6654:          const double veg_h    = side->veg_h();
 6655:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6656: 
 6657:          // Node - const in elem
 6658:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6659:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6660: 
 6661:          if (elem->depth >= tip_dp) {
 6662:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6663:          }
 6664: 
 6665:          
 6666:          const double htot  = side->htot2();        // Total depth at the side
 6667:          const double zctr2 = side->zTopCanopy();  
 6668: 
 6669:          double cff1; 
 6670:          double cff2; 
 6671:          double cff3;   
 6672:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6673:          // coefficients applied to 2D/3D case 
 6674:             cff1 = side->hhat/htot;
 6675:             cff2 = 0.0;
 6676:             cff3 = 0.0;
 6677:          } else { //3D
 6678:             //Init for no-veg case
 6679:             cff1 = 1.0;
 6680:             cff2 = 1.0;
 6681:             cff3 = 0.0;
 6682: 
 6683:             if constexpr(iveg != 0) {
 6684:                // Computes coefficients used with vegetation terms G1, G2
 6685:                // cff1, cff3 are used for the first two terms in G1, G2:
 6686:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6687:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6688:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6689:                if(veg_h < 0.99*htot) { // submergent vegetation
 6690:                   cff1=1;
 6691:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6692:                   cff3 = veg_c;
 6693: 
 6694:                } else { // emergent vegetation
 6695:                   cff1 = 1.0/(1.0 + veg_c2);
 6696:                   cff2 = cff1;
 6697:                   cff3 = 0.0;
 6698: 
 6699:                }
 6700:             } // if iveg
 6701:          } //  2D/3D
 6702: 
 6703:          av_cff1 += cff1/i34;
 6704:          av_cff2 += cff2/i34;
 6705:          av_cff3 += cff3/i34;
 6706:          av_cff2_chi += cff2*chi/i34;
 6707:          av_cff3_chi += cff3*chi/i34;
 6708:          av_df += min(htot, veg_h)/(htot*i34);
 6709: 
 6710: 
 6711:          // btrack values: U^\star, U^{\star\alpha}
 6712:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6713:          Vector2 Ustar       = {0.0, 0.0}; 
 6714:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6715: 
 6716:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6717:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6718:          } else { //3D
 6719:             for (int k = side->kb; k < nvrt; k++) {
 6720:             
 6721:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6722:                Ustar += w2;
 6723: 
 6724:                if constexpr(iveg != 0) {
 6725:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6726:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6727:                        Ustar_alpha += zrat*w2; // XXXX
 6728:                    }
 6729:                }  // if iveg
 6730:             }  // for k
 6731:          }  //2D/3D
 6732:          
 6733: 
 6734:          // Add btrack & surface stress terms to \breve{G} first
 6735:          if constexpr(ics==1) {
 6736: 
 6737:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6738: 
 6739:          } else {
 6740:             // XXX IMPLEMENT THIS
 6741:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6742:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6743:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6744:          }  // if ics
 6745: 
 6746:          // Surface and bottom stress terms
 6747:          if constexpr(ics==1) {
 6748:             const Vector2 tau    = side->tau();
 6749:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6750: 
 6751:             // Term for surface and bottom stress
 6752:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6753: 
 6754:          } else {
 6755:             assert(false && "computeElemAverageGhat: Not implemented");
 6756:             // XXX IMPLEMENT THIS
 6757:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6758:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6759:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6760:             // tau_x=(vn1+tt1)/2.d0
 6761:             // tau_y=(vn2+ss1)/2.d0
 6762:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6763:          }  // if ics
 6764: 
 6765:          
 6766: 
 6767:          // All terms in F,F^\alpha,f_b except baroclinic
 6768:          // F, f_b: all explicit terms excluding vegetation 
 6769:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6770:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6771:          const double coriolis = side->coriolis;
 6772:          Vector2 F  =  coriolis*side->U;  // F_x
 6773:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6774:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6775: 
 6776:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6777:             
 6778:             for (int k = side->kb; k < nvrt; k++) {
 6779:                if (zctr2 > side->zc[k-1]) {
 6780:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6781:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6782:                    Fa +=  coriolis*w2*zrat;
 6783:                } // if zctr2
 6784:             } // k
 6785:          } // iveg
 6786: 
 6787:          // Integrate horizontal viscosity force vertically
 6788:          for (int k=side->kb + 1; k<nvrt; k++) {
 6789:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6790: 
 6791:             F += levelHorVisc;
 6792: 
 6793:             // Vegetation term
 6794:             if constexpr(iveg!=0) {
 6795:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6796:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6797:                   Fa += levelHorVisc*zrat;
 6798:                } 
 6799:             } // if iveg
 6800:          } // for k
 6801: 
 6802:          fb += side->nuGradU[side->kb];
 6803: 
 6804:          // Add to ghat1
 6805:          if constexpr(ics==2) {
 6806:             // XXX IMPLEMENT THIS
 6807:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6808:             // bigf1=vn1; bigf2=vn2
 6809:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6810:             // botf1=vn1; botf2=vn2
 6811:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6812:             // bigfa1=vn1; bigfa2=vn2
 6813:          } // if ics
 6814: 
 6815:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6816:       } // for j (nodes and sides)
 6817: 
 6818:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6819:          
 6820:       // Finish off terms in F, F^\alpha and f_b
 6821:       const double grav3 = elem->mean(&Node::grav2);
 6822:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6823: 
 6824: 
 6825:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6826:       for (int j=1; j<i34; j++) { 
 6827:          // For each side in the element...
 6828:          const Side *side = elem->sides[j];
 6829:          const double chi = side->chi;
 6830: 
 6831:          const double htot = side->htot2();
 6832:          const double veg_h = side->veg_h();
 6833:          const Vector2 F  = htot*fb;
 6834:          const Vector2 Fa = min(htot, veg_h)*fb;
 6835: 
 6836:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6837:       } // for j
 6838: 
 6839:       //botf1 etc are already in elem frame
 6840:       elem->ghat1 += tmp/i34;
 6841: 
 6842:       // Baroclinic force
 6843:       if constexpr(ibc==0) {
 6844:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6845: 
 6846:          Vector2 Fa = {0.0, 0.0};
 6847:          Vector2 intGradRho = {0.0, 0.0};
 6848:          
 6849:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6850:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6851:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6852: 
 6853:             // \in F [m^2/s/s]
 6854:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6855:          }
 6856: 
 6857:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6858:          const Vector2 F = av_df*Fa; //approx
 6859:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6860: 
 6861:       } // if ibc
 6862: 
 6863: 
 6864: 
 6865:    }
 6866: 
 6867: } // extern "C"
 6868: 
 6869: 
 6870: 
 6871: #ifdef DONTCOMPILE
 6872: __global__ void checkMassConservation(Tracers* sumtr) {
 6873: 
 6874:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6875: 
 6876:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6877: 
 6878:    Element *elem = &(mesh->localElemData[i]);
 6879: 
 6880:    // Skip dry elements
 6881:    if (elem->isDry) return;
 6882: 
 6883:    // Local sum array for this thread
 6884:    double localSum[N_TRACERS] = {0.0};
 6885: 
 6886:    // Sum over vertical levels for this element
 6887:    const int kbe = elem->kbe;
 6888:    const double area = elem->area;
 6889: 
 6890:    for (int k = kbe; k < nvrt; k++) {
 6891:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6892:       
 6893:       // Accumulate tracer mass
 6894:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6895:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6896:       }
 6897:    }
 6898: 
 6899:    
 6900: 
 6901:    //  This function returns per element sums. A reduction must be done on the host side.
 6902: }
 6903: 
 6904: 
 6905: __global__ void transport(void) {
 6906: 
 6907:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6908: 
 6909:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6910: 
 6911:    Element *elem = &(mesh->localElemData[ie]);
 6912: 
 6913:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6914: 
 6915:                for (int m=0; m<ntr; m++) {
 6916:                   for (int k=kbe(ie); k<nvrt; k++) {
 6917:                      // Calculate each polynomial's weight 
 6918:                      wm=0.d0; sum1=0.d0; 
 6919:                      wm1=0.d0; wm2=0.d0; 
 6920:                      for (int i=0; i<elem->nweno2; i++) {
 6921:                   
 6922:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6923:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6924:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6925:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6926:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6927:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6928:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6929:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6930:                      // -----------------Hu and Shu (1999)'s method----------------
 6931:                      b4=b1+b2+b3
 6932: 
 6933: //Error: add PRODUCTION CPP
 6934: #ifdef DEBUG
 6935:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6936:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6937:                     call parallel_abort(errmsg)
 6938:                   }
 6939: #endif
 6940: 
 6941:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6942:                   // !----test-------------- 
 6943:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6944:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6945:                   // !wm(i)=wm1(i)*wm2(i)
 6946:                   // !---------------------- 
 6947:                   sum1=sum1+wm(i)
 6948:                 } // end for i
 6949: 
 6950:                 wm=wm/sum1
 6951: 
 6952:                 for (int j=0; j<elem->i34; j++) {
 6953: 
 6954:                   const Side *side  = elem->sides[j];
 6955:                   const Node *node1 = side->n1;
 6956:                   const Node *node2 = side->n2;
 6957: 
 6958:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6959:                      trsd=0.d0
 6960:                      for (int kk=0; kk<nquad; kk++) {
 6961:                         for (int i=0; i<elem->nweno2; i++) {
 6962:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6963:                         } // end for i   
 6964:                      } // end for kk
 6965:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6966:                   } // outward flux
 6967:                } // end for j=1,i34(ie) ! side
 6968:             }
 6969:          }
 6970:               
 6971: 
 6972: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6973: //             //   calculate each polynomial's weight 
 6974: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6975: //                 wm=0.d0; sum1=0.d0
 6976: //                 do i=1,nweno1(ie) !for each polynomial
 6977: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6978: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6979: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6980: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6981: //                   wm(i)=b2
 6982: //                   sum1=sum1+b2
 6983: //                   !wm(i)=1.d0
 6984: //                   !sum1=sum1+1.d0
 6985: 
 6986: // // Error: PRODUCTION
 6987: // #ifdef DEBUG
 6988: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6989: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6990: //                     call parallel_abort(errmsg)
 6991: //                   endif
 6992: // #endif
 6993: 
 6994: //                 enddo !i
 6995: //                 wm=wm/sum1 !final weight
 6996: 
 6997:                 for (int j=0; j<elem->i34; j++) { // side
 6998:                   const Side *side = elem->sides[j];
 6999:                   const Node *node1 = side->n1;
 7000:                   const Node *node2 = side->n2;
 7001: 
 7002:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7003:                     trsd=0.d0
 7004:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7005:                       for (int i=0; i<elem->nweno1; i++) {
 7006:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7007:                       }
 7008:                     enddo //kk
 7009:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7010:                   } // outward flux
 7011:                 } // end for j=1,i34(ie) ! side
 7012:               } // end for k; ntr 
 7013: 
 7014:             else !simple upwind method
 7015:               do j=1,i34(ie)
 7016:                 jsj=elside(j,ie)
 7017:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7018:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7019:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7020:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7021:                   endif
 7022:                 enddo  !vertical layers
 7023:               enddo !j=1,i34(ie) ! side
 7024:             endif !order of accuracy
 7025: 
 7026:          //  enddo !ie
 7027: // !$OMP     end do
