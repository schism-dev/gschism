 3857: __device__ __forceinline__ int Node::localIndex() const {
 3858:    // Returns the local index of the node in the partition
 3859:    // Local index is just the offset from the start of the partition's node memory
 3860:    return int(this - mesh->nodes[part]);
 3861: }
