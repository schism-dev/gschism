 7989: __global__ void printMatrix(bool full) {
 7990:    // Debugging: print the matrix
 7991: 
 7992:    const int size = mesh->np;
 7993:    double sum = 0.0;
 7994:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7995:       const Node *node = mesh->localNodeData + idx_node;
 7996:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7997:       for (int j = 0; j < node->numNodes; j++) {
 7998:          Node* nbNode = node->nodes[j];
 7999:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 8000:          sum += node->coeffMatrix[j];
 8001:       }
 8002:       if (full) printf("]\n");
 8003: 
 8004: 
 8005:    }
 8006:    if (!full) printf("sum=%lf\n", sum);
 8007: }
