 3374: 
 3375: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 3376:    // Returns the value of the normal component of the velocity at the side center
 3377:    const double w1 = getBoundaryArrayValueWeight();
 3378:    const double w2 = 1.0 - w1;
 3379:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3380:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3381: 
 3382:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 3383: }
