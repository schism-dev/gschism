 7116: #ifdef DONTCOMPILE
 7117: __device__ void computeVerticalAdvection(void) {
 7118:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 7119: 
 7120:    sdbt(1:2,:,:)=0.d0
 7121: 
 7122:    const Side *side = FROM kernel;
 7123: 
 7124:    if(side->isDry) return;
 7125: 
 7126:    // If side is wet...
 7127: 
 7128: 
 7129:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 7130:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 7131:    double ws[nvrt] = {} // w @ side
 7132:    int icount = 0;
 7133:    for (int j=0; j<2; j++) {
 7134:       const Element *elem = side->elements[j];
 7135:        
 7136:       if(elem != nullptr) {
 7137:          icount++;
 7138:          for (int k=0; k<nvrt; k++) {
 7139:             ws[k] = ws[k] + elem->w[k];
 7140:          }
 7141:       }
 7142:    }  // for j
 7143: 
 7144:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 7145:    ws = ws/icount;
 7146: 
 7147:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 7148:    // Splines allow for a smooth transition between vertical levels.
 7149:    // Splines have continuity restrictions at the internal knots, but
 7150:    // we have to provide the 1st derivatives at the endpoints.
 7151:    const int kbs = side->kbs; 
 7152:    
 7153:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7154:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7155:    initCubicSpline(kbs, nvrt, side, ws, up)
 7156: 
 7157:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7158:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7159:    initCubicSpline(kbs, nvrt, side, ws, vp)
 7160: 
 7161:    // Total advection (average onto side)
 7162:    const Node *node1 = side->nodes[0];
 7163:    const Node *node2 = side->nodes[1];
 7164:    for (int k=kbs(i); k<nvrt; k++) {
 7165: 
 7166:       if constexpr(ics==1) {
 7167:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 7168:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 7169:       } else {
 7170:          // XXX IMPLEMENT THIS
 7171:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 7172:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 7173:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 7174:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 7175:       }  // if ics
 7176: 
 7177: 
 7178:    }
 7179: }
 7180: #endif
 7181: 
 7182: 
 7183: extern "C" {
 7184:    __global__ void computeElemAverageGhat(void) {
 7185:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 7186: 
 7187:       ELEM(elem);
 7188:       
 7189:       elem->ghat1= {0.0, 0.0};  
 7190: 
 7191:       if constexpr(ihydraulics != 0) {
 7192:          if (nhtblocks > 0 && elem->isblock) return;
 7193:       }
 7194: 
 7195:       if (elem->isDry) return;
 7196: 
 7197:       // Wet elements.
 7198:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 7199:       // tidal potential, horizontal diffusion, and baroclinic etc
 7200:       // Remember to update both fb and F 
 7201:       // If ics=2, ghat1 are in eframe (ll)
 7202:       // cff1-3: coefficients for 2D/3D
 7203:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7204:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7205:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 7206: 
 7207:       double av_cff1 = 0.0;  // av. for cff1
 7208:       double av_cff2 = 0.0;  // av. for cff2
 7209:       double av_cff3 = 0.0;  // av. for cff3
 7210:       double av_df = 0.0;  // av. for H^\alpha / H
 7211:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7212:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7213: 
 7214:       const int i34 = elem->i34;
 7215:       const int kb = elem->kb;
 7216: 
 7217:       for (int j=0; j<i34; j++) {
 7218:          // For each node and side in the element...
 7219: 
 7220:          const Node *node = elem->nodes[j];
 7221:          const Side *side = elem->sides[j];
 7222: 
 7223:          const double chi      = side->chi;
 7224:          const double veg_c2   = side->veg_c2;
 7225:          const double veg_beta = side->veg_beta;
 7226:          const double veg_h    = side->veg_h();
 7227:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7228: 
 7229:          // Node - const in elem
 7230:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 7231:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 7232: 
 7233:          if (elem->depth >= tip_dp) {
 7234:            elem->gradETP += node->ETP*elem->gradPhi[j];
 7235:          }
 7236: 
 7237:          
 7238:          const double htot  = side->htot2();        // Total depth at the side
 7239:          const double zctr2 = side->zTopCanopy();  
 7240: 
 7241:          double cff1; 
 7242:          double cff2; 
 7243:          double cff3;   
 7244:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7245:          // coefficients applied to 2D/3D case 
 7246:             cff1 = side->hhat/htot;
 7247:             cff2 = 0.0;
 7248:             cff3 = 0.0;
 7249:          } else { //3D
 7250:             //Init for no-veg case
 7251:             cff1 = 1.0;
 7252:             cff2 = 1.0;
 7253:             cff3 = 0.0;
 7254: 
 7255:             if constexpr(iveg != 0) {
 7256:                // Computes coefficients used with vegetation terms G1, G2
 7257:                // cff1, cff3 are used for the first two terms in G1, G2:
 7258:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7259:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7260:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7261:                if(veg_h < 0.99*htot) { // submergent vegetation
 7262:                   cff1=1;
 7263:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7264:                   cff3 = veg_c;
 7265: 
 7266:                } else { // emergent vegetation
 7267:                   cff1 = 1.0/(1.0 + veg_c2);
 7268:                   cff2 = cff1;
 7269:                   cff3 = 0.0;
 7270: 
 7271:                }
 7272:             } // if iveg
 7273:          } //  2D/3D
 7274: 
 7275:          av_cff1 += cff1/i34;
 7276:          av_cff2 += cff2/i34;
 7277:          av_cff3 += cff3/i34;
 7278:          av_cff2_chi += cff2*chi/i34;
 7279:          av_cff3_chi += cff3*chi/i34;
 7280:          av_df += min(htot, veg_h)/(htot*i34);
 7281: 
 7282: 
 7283:          // btrack values: U^\star, U^{\star\alpha}
 7284:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7285:          Vector2 Ustar       = {0.0, 0.0}; 
 7286:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7287: 
 7288:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7289:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7290:          } else { //3D
 7291:             for (int k = side->kb; k < nvrt; k++) {
 7292:             
 7293:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7294:                Ustar += w2;
 7295: 
 7296:                if constexpr(iveg != 0) {
 7297:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7298:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7299:                        Ustar_alpha += zrat*w2; // XXXX
 7300:                    }
 7301:                }  // if iveg
 7302:             }  // for k
 7303:          }  //2D/3D
 7304:          
 7305: 
 7306:          // Add btrack & surface stress terms to \breve{G} first
 7307:          if constexpr(ics==1) {
 7308: 
 7309:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7310: 
 7311:          } else {
 7312:             // XXX IMPLEMENT THIS
 7313:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 7314:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 7315:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 7316:          }  // if ics
 7317: 
 7318:          // Surface and bottom stress terms
 7319:          if constexpr(ics==1) {
 7320:             const Vector2 tau    = side->tau();
 7321:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 7322: 
 7323:             // Term for surface and bottom stress
 7324:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7325: 
 7326:          } else {
 7327:             assert(false && "computeElemAverageGhat: Not implemented");
 7328:             // XXX IMPLEMENT THIS
 7329:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 7330:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 7331:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 7332:             // tau_x=(vn1+tt1)/2.d0
 7333:             // tau_y=(vn2+ss1)/2.d0
 7334:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 7335:          }  // if ics
 7336: 
 7337:          
 7338: 
 7339:          // All terms in F,F^\alpha,f_b except baroclinic
 7340:          // F, f_b: all explicit terms excluding vegetation 
 7341:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7342:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7343:          const double coriolis = side->coriolis;
 7344:          Vector2 F  =  coriolis*side->U;  // F_x
 7345:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7346:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7347: 
 7348:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7349:             
 7350:             for (int k = side->kb; k < nvrt; k++) {
 7351:                if (zctr2 > side->zc[k-1]) {
 7352:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7353:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7354:                    Fa +=  coriolis*w2*zrat;
 7355:                } // if zctr2
 7356:             } // k
 7357:          } // iveg
 7358: 
 7359:          // Integrate horizontal viscosity force vertically
 7360:          for (int k=side->kb + 1; k<nvrt; k++) {
 7361:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7362: 
 7363:             F += levelHorVisc;
 7364: 
 7365:             // Vegetation term
 7366:             if constexpr(iveg!=0) {
 7367:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7368:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7369:                   Fa += levelHorVisc*zrat;
 7370:                } 
 7371:             } // if iveg
 7372:          } // for k
 7373: 
 7374:          fb += side->nuGradU[side->kb];
 7375: 
 7376:          // Add to ghat1
 7377:          if constexpr(ics==2) {
 7378:             // XXX IMPLEMENT THIS
 7379:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7380:             // bigf1=vn1; bigf2=vn2
 7381:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7382:             // botf1=vn1; botf2=vn2
 7383:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7384:             // bigfa1=vn1; bigfa2=vn2
 7385:          } // if ics
 7386: 
 7387:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7388:       } // for j (nodes and sides)
 7389: 
 7390:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7391:          
 7392:       // Finish off terms in F, F^\alpha and f_b
 7393:       const double grav3 = elem->mean(&Node::grav2);
 7394:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7395: 
 7396: 
 7397:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7398:       for (int j=1; j<i34; j++) { 
 7399:          // For each side in the element...
 7400:          const Side *side = elem->sides[j];
 7401:          const double chi = side->chi;
 7402: 
 7403:          const double htot = side->htot2();
 7404:          const double veg_h = side->veg_h();
 7405:          const Vector2 F  = htot*fb;
 7406:          const Vector2 Fa = min(htot, veg_h)*fb;
 7407: 
 7408:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7409:       } // for j
 7410: 
 7411:       //botf1 etc are already in elem frame
 7412:       elem->ghat1 += tmp/i34;
 7413: 
 7414:       // Baroclinic force
 7415:       if constexpr(ibc==0) {
 7416:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7417: 
 7418:          Vector2 Fa = {0.0, 0.0};
 7419:          Vector2 intGradRho = {0.0, 0.0};
 7420:          
 7421:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 7422:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 7423:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7424: 
 7425:             // \in F [m^2/s/s]
 7426:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7427:          }
 7428: 
 7429:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7430:          const Vector2 F = av_df*Fa; //approx
 7431:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7432: 
 7433:       } // if ibc
 7434: 
 7435: 
 7436: 
 7437:    }
 7438: 
 7439: } // extern "C"
 7440: 
 7441: 
 7442: 
 7443: #ifdef DONTCOMPILE
 7444: __global__ void checkMassConservation(Tracers* sumtr) {
 7445: 
 7446:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7447: 
 7448:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7449: 
 7450:    Element *elem = &(mesh->localElemData[i]);
 7451: 
 7452:    // Skip dry elements
 7453:    if (elem->isDry) return;
 7454: 
 7455:    // Local sum array for this thread
 7456:    double localSum[N_TRACERS] = {0.0};
 7457: 
 7458:    // Sum over vertical levels for this element
 7459:    const int kbe = elem->kbe;
 7460:    const double area = elem->area;
 7461: 
 7462:    for (int k = kbe; k < nvrt; k++) {
 7463:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7464:       
 7465:       // Accumulate tracer mass
 7466:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7467:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7468:       }
 7469:    }
 7470: 
 7471:    
 7472: 
 7473:    //  This function returns per element sums. A reduction must be done on the host side.
 7474: }
 7475: 
 7476: 
 7477: __global__ void transport(void) {
 7478: 
 7479:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7480: 
 7481:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7482: 
 7483:    Element *elem = &(mesh->localElemData[ie]);
 7484: 
 7485:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7486: 
 7487:                for (int m=0; m<ntr; m++) {
 7488:                   for (int k=kbe(ie); k<nvrt; k++) {
 7489:                      // Calculate each polynomial's weight 
 7490:                      wm=0.d0; sum1=0.d0; 
 7491:                      wm1=0.d0; wm2=0.d0; 
 7492:                      for (int i=0; i<elem->nweno2; i++) {
 7493:                   
 7494:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7495:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7496:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7497:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7498:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7499:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7500:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7501:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7502:                      // -----------------Hu and Shu (1999)'s method----------------
 7503:                      b4=b1+b2+b3
 7504: 
 7505: //Error: add PRODUCTION CPP
 7506: #ifdef DEBUG
 7507:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7508:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7509:                     call parallel_abort(errmsg)
 7510:                   }
 7511: #endif
 7512: 
 7513:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7514:                   // !----test-------------- 
 7515:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7516:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7517:                   // !wm(i)=wm1(i)*wm2(i)
 7518:                   // !---------------------- 
 7519:                   sum1=sum1+wm(i)
 7520:                 } // end for i
 7521: 
 7522:                 wm=wm/sum1
 7523: 
 7524:                 for (int j=0; j<elem->i34; j++) {
 7525: 
 7526:                   const Side *side  = elem->sides[j];
 7527:                   const Node *node1 = side->n1;
 7528:                   const Node *node2 = side->n2;
 7529: 
 7530:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7531:                      trsd=0.d0
 7532:                      for (int kk=0; kk<nquad; kk++) {
 7533:                         for (int i=0; i<elem->nweno2; i++) {
 7534:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7535:                         } // end for i   
 7536:                      } // end for kk
 7537:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7538:                   } // outward flux
 7539:                } // end for j=1,i34(ie) ! side
 7540:             }
 7541:          }
 7542:               
 7543: 
 7544: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7545: //             //   calculate each polynomial's weight 
 7546: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7547: //                 wm=0.d0; sum1=0.d0
 7548: //                 do i=1,nweno1(ie) !for each polynomial
 7549: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7550: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7551: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7552: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7553: //                   wm(i)=b2
 7554: //                   sum1=sum1+b2
 7555: //                   !wm(i)=1.d0
 7556: //                   !sum1=sum1+1.d0
 7557: 
 7558: // // Error: PRODUCTION
 7559: // #ifdef DEBUG
 7560: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7561: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7562: //                     call parallel_abort(errmsg)
 7563: //                   endif
 7564: // #endif
 7565: 
 7566: //                 enddo !i
 7567: //                 wm=wm/sum1 !final weight
 7568: 
 7569:                 for (int j=0; j<elem->i34; j++) { // side
 7570:                   const Side *side = elem->sides[j];
 7571:                   const Node *node1 = side->n1;
 7572:                   const Node *node2 = side->n2;
 7573: 
 7574:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7575:                     trsd=0.d0
 7576:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7577:                       for (int i=0; i<elem->nweno1; i++) {
 7578:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7579:                       }
 7580:                     enddo //kk
 7581:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7582:                   } // outward flux
 7583:                 } // end for j=1,i34(ie) ! side
 7584:               } // end for k; ntr 
 7585: 
 7586:             else !simple upwind method
 7587:               do j=1,i34(ie)
 7588:                 jsj=elside(j,ie)
 7589:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7590:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7591:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7592:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7593:                   endif
 7594:                 enddo  !vertical layers
 7595:               enddo !j=1,i34(ie) ! side
 7596:             endif !order of accuracy
 7597: 
 7598:          //  enddo !ie
 7599: // !$OMP     end do
 7600: 
