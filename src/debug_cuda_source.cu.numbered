 2202:    template<typename T>
 2203:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 2204:       T values[4];
 2205:       getNodalValues(level, func, values);
 2206: 
 2207:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2208:       if constexpr (IsVector2<T>::value && ics == 2) {
 2209: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2210:          projectNodeVectorsToElementFrame(values);
 2211: printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2212:       }
 2213: 
 2214:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2215:    }
 2216: 
 2217:    template<typename T>
 2218:    __device__ __forceinline__ T Element::interpolate(const double shapeCoords[4], T Node::* field) const {
 2219:       T values[4];
 2220:       getNodalValues(field, values);
 2221: 
 2222:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2223:       if constexpr (IsVector2<T>::value && ics == 2) {
 2224: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2225:          projectNodeVectorsToElementFrame(values);
 2226: printf("interpolate 3: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2227:       }
 2228:       
 2229:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2230:    }
 2231: 
 2232: 
 2233:    template<typename T>
 2234:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
 2235:       T values[4];
 2236:       getNodalValues(level, field, values);
 2237:       
 2238: if (shapeCoords[0] > 1.1 || shapeCoords[1] > 1.1 || shapeCoords[2] > 1.1 || 
 2239:     shapeCoords[0] < -0.1 || shapeCoords[1] < -0.1 || shapeCoords[2] < -0.1) printf("XXX shapeCoords = (%.17f, %.17f, %.17f, %.17f)\n", shapeCoords[0], shapeCoords[1], shapeCoords[2], shapeCoords[3]);
 2240:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2241:       if constexpr (IsVector2<T>::value && ics == 2) {
 2242: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2243:          projectNodeVectorsToElementFrame(values);
 2244: // printf("interpolate 4: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2245:       }
 2246: 
 2247:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2248:    }
