 2294:    template<typename T>
 2295:    __device__ __forceinline__ T Element::mean(int level,  T (Side::*func)(int) const) const {
 2296: 
 2297:       T values[4];
 2298: 
 2299: 
 2300:       values[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2301:       values[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2302:       values[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2303:       if (isQuad()) values[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2304:       else          values[3] = T();
 2305: 
 2306:       if constexpr (IsVector2<T>::value && ics == 2) projectSideVectorsToElementFrame(values);
 2307: 
 2308:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2309:    }
