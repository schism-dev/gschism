 5802: 
 5803: 
 5804:    __global__ void backtrackAllNodes(void) {
 5805: 
 5806:       // max/min # of sub-divisions
 5807:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 5808:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 5809: 
 5810:       SIDE(side);
 5811: 
 5812:       const int kb = side->kb;
 5813: 
 5814: 
 5815:       // Initialize btrack velocities to the actual velocities at the side 
 5816:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 5817:   
 5818:       if (side->isDry) return;
 5819:      
 5820: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 5821: 
 5822:       // Checks that at least one element is not dry
 5823:       const Element *elem1 = side->elems[0];
 5824:       const Element *elem2 = side->elems[1];
 5825: 
 5826: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 5827: 
 5828:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 5829:       
 5830:       // XXXXXX
 5831:       // !swild_tmp to store global coord. of the starting side
 5832:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 5833:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 5834:       // !Use sframe2 
 5835:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 5836: 
 5837: 
 5838:       for (int k = kb; k < nvrt; k++) {
 5839:       //  For ics=2, the coordinates are all in the side's local frame
 5840: 
 5841:          const int iadvf = side->iadv();  // Advection flag   
 5842:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 5843: 
 5844:          const double vmag2 = norm2(side->u2[k]);
 5845: 
 5846:          if (vmag2 <= velmin_btrack_sq) {  
 5847:             // No activity 
 5848: 
 5849:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 5850:             
 5851:          } else {  // do btrack
 5852: 
 5853:             // Compute number of sub-divisions based on local gradients of the velocity field
 5854: 
 5855:             // XXX IS THIS NECESSARY?
 5856:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 5857:             double suma = 0.0;
 5858:             int icount = 0;
 5859:             #pragma unroll
 5860:             for (int l=0; l<2; l++) {
 5861:             // For each element sharing the side...
 5862: 
 5863:                const Element *elem = side->elems[l];
 5864:                  
 5865:                if (elem == nullptr) continue;
 5866: 
 5867:                icount++;
 5868: 
 5869:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 5870:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 5871:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 5872: 
 5873:                double utmp[4];
 5874:                double vtmp[4];
 5875:                #pragma unroll
 5876:                for (int j = 0; j < elem->i34; j++) {
 5877: 
 5878:                   const Node *node = elem->nodes[j];
 5879: 
 5880:                   if constexpr(ics==1) {
 5881:                      utmp[j] = node->u2[k].x;
 5882:                      vtmp[j] = node->u2[k].y;  
 5883: 
 5884:                   } else {
 5885:                      // 'Project' the velocity from the node frame to the element frame
 5886:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 5887:                      utmp[j] = tmp_u2.x;
 5888:                      vtmp[j] = tmp_u2.y;
 5889: 
 5890:                   }
 5891:                } // for j
 5892: 
 5893:                const Vector2 grad_u = elem->grad2(utmp); 
 5894:                const Vector2 grad_v = elem->grad2(vtmp);
 5895:    
 5896:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 5897:             } // for l
 5898: 
 5899:             assert(icount > 0 && "Impossible 77");
 5900: 
 5901:             // '4' is somewhat arbitrary
 5902:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 5903: 
 5904:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 5905:             Vector3 u_int = {0.0, 0.0, 0.0};
 5906: 
 5907:             side->btrack(k, dt, dtbk, u_int);
 5908: 
 5909: 
 5910:             side->btu[k] = {u_int.x, u_int.y};
 5911:                
 5912:          } // if vmag (do backtrack)
 5913: 
 5914: 
 5915:       } // for k=kb,nvrt-1
 5916: 
 5917:    }
 5918: 
 5919: } // extern "C"
 5920: 
 5921: template<int nc>
 5922: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 5923: 
 5924: // Solves a tridiagonal system. Adapted from Numerical Recipes in FORTRAN (pp.43).
 5925: //
 5926: // Although this is a general function, it is used only for equations on vertical levels.
 5927: // nc is the number of components in each unknown: 1 for a scalar, 2 for Vector2.
 5928: // It is not really for nc independent RHS vectors. We only use it for scalar and Vector2.
 5929: // Vector2 is stored as adjacent (x, y), so index of level j, component l is j*nc + l.
 5930: //
 5931: // a, b, c, rhs: inputs, not modified. gam: work array of length n.
 5932: // a, b, c are the three diagonals (b = main). a[0] and c[n-1] are unused.
 5933: // n: rank of the system (number of vertical levels in the 3D momentum solve).
 5934: // rhs, u: length n*nc, packed C order (n levels, nc components per level).
 5935: 
 5936:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 5937:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 5938: 
 5939:    double bet = b[0];
 5940:    if constexpr (nc == 1) {
 5941:       u[0] = rhs[0]/bet;
 5942:    } else {
 5943:       #pragma unroll
 5944:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 5945:    }
 5946: 
 5947:    for (int j = 1; j < n; j++) {
 5948:       gam[j] = c[j - 1]/bet;
 5949:       bet = b[j] - a[j]*gam[j];
 5950: 
 5951:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 5952: 
 5953:       if constexpr (nc == 1) {
 5954:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 5955:       } else {
 5956:          #pragma unroll
 5957:          for (int l = 0; l < nc; l++) {
 5958:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 5959:          }
 5960:       }
 5961:    }
 5962: 
 5963:    // Back-substitution
 5964:    for (int j = n - 2; j >= 0; j--) {
 5965:       if constexpr (nc == 1) {
 5966:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 5967:       } else {
 5968:          for (int l = 0; l < nc; l++) {
 5969:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 5970:          }
 5971:       }
 5972:    }
 5973: }
 5974: 
 5975: 
 5976: 
 5977: // Helper function that contains the core algorithm
 5978: template<typename XAccessor, typename YAccessor>
 5979: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 5980:                                     double  yp_top, double  yp_bot, 
 5981:                                     CubicSpline &spline) {
 5982:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 5983:    // 
 5984:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 5985:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 5986:    //
 5987:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 5988:    // 
 5989:    // Inputs: 
 5990:    //            n: dimension for x etc; # of data pts (>=2);
 5991:    //            getX, getY: functions to access x,y coordinates
 5992:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 5993:    //     Output: 
 5994:    //            spline (CubicSpline): spline structure with x,y,y',y''
 5995: 
 5996:    const int n = k2 - k1 + 1;
 5997:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 5998: 
 5999:    // Allocate memory for the splines
 6000:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 6001:    spline.x   = new double[n];
 6002:    spline.y   = new double[n];
 6003:    spline.yp  = new double[n];
 6004:    spline.ypp = new double[n];
 6005: 
 6006:    for (int k=k1; k<=k2; k++) {
 6007:       spline.x[k] = getX(k);
 6008:       spline.y[k] = getY(k);
 6009:    }
 6010: 
 6011:    // This is to simplify expressions later
 6012:    double *x = spline.x;
 6013:    double *y = spline.y;
 6014: 
 6015:    double *a = nullptr;
 6016:    double *b = nullptr;
 6017:    double *c = nullptr;
 6018:    double *gam = nullptr;
 6019:    double *rhs = nullptr;
 6020:    
 6021: 
 6022:       a = new double[n];   // Lower diagonal
 6023:       b = new double[n];   // Diagonal
 6024:       c = new double[n];   // Upper diagonal
 6025:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 6026:       rhs = new double[n]; // Right-hand side
 6027: 
 6028:    for (int k=k1; k<=k2; k++) {
 6029:       if (k == k1) {
 6030:          // Bottom level
 6031:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 6032:          b[k] = (x[k+1] - x[k])/3.0;
 6033:          c[k] = b[k]/2.0;
 6034:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 6035:       } else if (k == n - 1) {
 6036:          // Top level (surface)
 6037:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 6038:          b[k] = (x[k] - x[k-1])/3.0;
 6039:          a[k] = b[k]/2.0;
 6040:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 6041:       } else {
 6042:          // Intermediate levels
 6043:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 6044:          b[k] = (x[k+1] - x[k-1])/3.0;
 6045:          a[k] = (x[k  ] - x[k-1])/6.0;
 6046:          c[k] = (x[k+1] - x[k  ])/6.0;
 6047:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 6048:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 6049:       }
 6050:    }
 6051: 
 6052:    // Solve the tridiagonal system
 6053:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 6054:    
 6055:    spline.yp[k1] = yp_bot;
 6056:    spline.yp[k2] = yp_top;
 6057: 
 6058:    // Compute rest of 1st derivatives using the splines
 6059:    for (int k=k1+1; k<k2; k++) {
 6060:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 6061:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 6062:    }
 6063:    
 6064:    delete[] a;
 6065:    delete[] b;
 6066:    delete[] c;
 6067:    delete[] gam;
 6068:    delete[] rhs;
 6069: 
 6070: }
 6071: 
 6072: // Array version
 6073: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 6074:                                 double y_top, double y_bot, 
 6075:                                 CubicSpline &spline) {
 6076:    auto getX = [x] (int k) { return x[k]; };
 6077:    auto getY = [y] (int k) { return y[k]; };
 6078:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 6079: }
 6080: 
 6081: // Lambda version - allows custom access patterns
 6082: template<typename XFunc, typename YFunc>
 6083: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 6084:                                 double y_top, double y_bot,
 6085:                                 CubicSpline &spline) {
 6086:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 6087: }
 6088: 
 6089: 
 6090: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 6091: {
 6092:    assert("Not implemented");
 6093: 
 6094:    return 0.0;
 6095: }
