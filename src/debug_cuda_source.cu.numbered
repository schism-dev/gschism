 1962: __device__ void lock(int *mutex) {
 1963:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 1964: }
 1965: 
 1966: __device__ void unlock(int *mutex) {
 1967:     atomicExch(mutex, 0);
 1968: }
