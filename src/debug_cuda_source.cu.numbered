 8306:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8307:       const Node *node = mesh->localNodeData + idx_node;
 8308:       res[idx_node*size + idx_node] = node->coeffDiag;
 8309:       for (int j = 0; j < node->numNodes; j++) {
 8310:          Node* nbNode = node->nodes[j];
 8311:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 8312:       }
 8313: 
 8314:    }
 8315:    
 8316: }
