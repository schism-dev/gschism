 3627: __device__ __inline__ void Node::updateZCoordData(void) {
 3628: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3629: 
 3630:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3631:    // if (isDry2()) {
 3632:    //    kb = -1;  // XXXXXXXX KKKKK
 3633:    //    return;
 3634:    // }
 3635: 
 3636: 
 3637:    if constexpr(ivcor == 2) {  // SZ coordinates
 3638:       
 3639:       // Compute bottom level index
 3640:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3641:    } 
 3642:    else {  // if (ivcor == 1) Localized sigma
 3643:       // Do nothing
 3644:    }
 3645: 
 3646: 
 3647: }
