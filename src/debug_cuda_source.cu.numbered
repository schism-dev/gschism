 1446:    __device__ Mesh(int partNum,
 1447:                    int npgb, int negb, int nsgb, 
 1448:                    int np, int ne, int ns,
 1449:                    int max_np, int max_ne, int max_ns, int nseg,
 1450:                    Node **nodesPtr, Element **elemsPtr, Side **sidesPtr,
 1451:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 1452:                    Node    **localNodeNeighNodesMem,
 1453:                    Element **localNodeNeighElemsMem,
 1454:                    double *partCoeffMatrixMem,
 1455:                    NodeBoundary *localNodeBoundaryMem,
 1456:                    SideBoundary *localSideBoundaryMem,
 1457:                    BoundarySegment *localSegmentMem,
 1458:                    double h_c, double h_s, double theta_b, double theta_f, double *sigma_lcl, double *sigma, double *ztot,
 1459:                    double *cs, double *dcs
 1460:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 1461:                        np(np), ne(ne), ns(ns),
 1462:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
 1463:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
 1464:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
 1465:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
 1466:                        localNodeBoundaryMem(localNodeBoundaryMem), localSideBoundaryMem(localSideBoundaryMem),
 1467:                        localSegmentMem(localSegmentMem),
 1468:                        h_c(h_c), h_s(h_s), theta_b(theta_b), theta_f(theta_f), sigma_lcl(sigma_lcl), sigma(sigma), ztot(ztot),
 1469:                        cs(cs), dcs(dcs),
 1470:                        coeffMatrixMem(partCoeffMatrixMem),
 1471:                        landBoundarySegment(true),
 1472:                        landBoundaryNode(true)
 1473:    {
 1474:       printf("Mesh constructor for partition %d\n", partNum);
 1475: 
 1476:       printf("npgb = %d, negb = %d, nsgb = %d, nseg = %d\n", npgb, negb, nsgb, nseg);
 1477:       printf("np = %d, ne = %d, ns = %d\n", np, ne, ns);
 1478:       printf("max_np = %d, max_ne = %d, max_ns = %d\n", max_np, max_ne, max_ns);
 1479:  
 1480:       printf("elemsPtr = %p, elems = %p\n", *elems, elemsMem);
 1481:       
 1482:       sinh_theta_f = sinh(theta_f);
 1483: 
 1484:    }
