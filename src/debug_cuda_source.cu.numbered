 7759:             else !simple upwind method
 7760:               do j=1,i34(ie)
 7761:                 jsj=elside(j,ie)
 7762:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7763:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7764:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7765:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7766:                   endif
 7767:                 enddo  !vertical layers
 7768:               enddo !j=1,i34(ie) ! side
 7769:             endif !order of accuracy
