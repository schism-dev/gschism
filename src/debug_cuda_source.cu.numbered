 7645: __global__ void returnMatrix(double *res) {
 7646:    // Debugging: returns the matrix as a CuPy array
 7647: 
 7648:    const int size = mesh->np;
 7649:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7650:       const Node *node = mesh->localNodeData + idx_node;
 7651:       res[idx_node*size + idx_node] = node->coeffDiag;
 7652:       for (int j = 0; j < node->numNodes; j++) {
 7653:          Node* nbNode = node->nodes[j];
 7654:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7655:       }
 7656: 
 7657:    }
 7658:    
 7659: }
 7660: 
 7661: __global__ void returnX(double *res) {
 7662:    // Debugging: returns the matrix as a CuPy array
 7663: 
 7664:    const int size = mesh->np;
