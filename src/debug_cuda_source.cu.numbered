 8378: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 8379:    Element *elems = mesh->localElemData;
 8380: 
 8381:    *addr = elems;
 8382:    *sizeElement = sizeof(Element);
 8383:    switch (varCode) {
 8384:       case (int)VarCode::z:
 8385:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 8386:          *sizeType = sizeof(double);
 8387:          break;
 8388:       case (int)VarCode::x:
 8389:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 8390:          *sizeType = sizeof(Vector2);
 8391:          break;
 8392:       case (int)VarCode::gradETP:
 8393:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
 8394:          *sizeType = sizeof(Vector2);
 8395:          break;
 8396:       case (int)VarCode::area:
 8397:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 8398:          *sizeType = sizeof(double);
 8399:          break;
 8400:       case (int)VarCode::depth:
 8401:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 8402:          *sizeType = sizeof(double);
 8403:          break;
 8404:       case (int)VarCode::radius:
 8405:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 8406:          *sizeType = sizeof(double);
 8407:          break;
 8408:       case (int)VarCode::ghat:
 8409:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 8410:          *sizeType = sizeof(Vector2);
 8411:          break;
 8412:       case (int)VarCode::kb:
 8413:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 8414:          *sizeType = sizeof(int);
 8415:          break;
 8416:       case (int)VarCode::isdry:
 8417:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 8418:          *sizeType = sizeof(int);
 8419:          break;            
 8420:       case (int)VarCode::w:
 8421:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 8422:          *sizeType = sizeof(double);
 8423:          break;
 8424:       case (int)VarCode::FaceIndices:
 8425:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 8426:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 8427:          *sizeType = sizeof(Node);
 8428:          break;
 8429:       default:
 8430:          *offset = -1;
 8431:    }
 8432: }
