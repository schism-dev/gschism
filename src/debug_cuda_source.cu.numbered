 4476: 
 4477: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 4478:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 4479:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 4480: 
 4481: 
 4482:    NODE(node1);
 4483: 
 4484:    node1->clearMatrixRow();
 4485:    node1->qel = 0.0;
 4486: 
 4487:    // THIS IS FOR STRUCTURES XXX
 4488:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 4489: 
 4490:    
 4491:    for (int j=0; j<node1->numElements; j++) {
 4492:       // For each element connected to the node...
 4493: 
 4494:       Element *elem = node1->elements[j];
 4495: 
 4496: 
 4497: 
 4498:       // Compute the average gravity
 4499:       const double grav3 = elem->mean(&Node::grav2);
 4500: 
 4501:       // Look at the documentation for the description of the terms in the following integrals
 4502: 
 4503:       // Integral I_1 
 4504:       // \bar{\breve{H}} 
 4505:       const double hhatb = elem->mean(&Side::hhat);        
 4506: 
 4507:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 4508: 
 4509:       const int id1 = elem->nodeLocalIdx(node1); 
 4510:       const double area = elem->area;
 4511: 
 4512:       if (elem->isTri()) {
 4513: 
 4514:          // To clarify the notation in this section: 
 4515:          //   i stands for the node under consideration (node1)
 4516:          //   j (node2) and k (node3) are the other nodes of the triangle.
 4517:          const int id2 = elem->nxq(1 + id1);
 4518:          const int id3 = elem->nxq(2 + id1);
 4519:          Node *node2 = elem->nodes[id2];
 4520:          Node *node3 = elem->nodes[id3];
 4521: 
 4522:          Point2 x1, x2, x3;
 4523:          elem->getLocalHorizontalNodePositionsTri(x1, x2, x3, id1);
 4524: 
 4525: 
 4526:          // integral of phi_i*phi_j
 4527:          const double ipp_ii = (1.0/6.0 )*area;
 4528:          const double ipp_ij = (1.0/12.0)*area;
 4529:          const double ipp_ik = (1.0/12.0)*area;
 4530: 
 4531:          // integral of [(grad phi_i) * (grad phi_j)]
 4532:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 4533:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 4534:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 4535: 
 4536:          // Computes the different components of integral I_1 of each node with respect to node i.
 4537:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4538:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4539:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4540: 
 4541:          node1->addToSparseMatrix(node1, I1_ii);
 4542:          node1->addToSparseMatrix(node2, I1_ij); 
 4543:          node1->addToSparseMatrix(node3, I1_ik);
 4544: 
 4545:       }
 4546:       else { // Quad
 4547:          // XXX IMPLEMENT THIS
 4548:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 4549: 
 4550:          // // To clarify the notation in this section: 
 4551:          // //   i stands for the node under consideration (node1)
 4552:          // //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 4553:          // const int id2 = elem->nxq(1 + id1);
 4554:          // const int id3 = elem->nxq(2 + id1);
 4555:          // const int id4 = elem->nxq(3 + id1);
 4556:          // Node *node2 = elem->nodes[id2];
 4557:          // Node *node3 = elem->nodes[id3];
 4558:          // Node *node4 = elem->nodes[id4];         
 4559: 
 4560:          // // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 4561:          // const double ipp_ii = elem->intPhiPhi(id1, id1);
 4562:          // const double ipp_ij = elem->intPhiPhi(id1, id2);
 4563:          // const double ipp_ik = elem->intPhiPhi(id1, id3);
 4564:          // const double ipp_il = elem->intPhiPhi(id1, id4);
 4565: 
 4566:          // // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 4567:          // const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 4568:          // const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 4569:          // const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 4570:          // const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 4571: 
 4572:          // // Computes the different components of integral I_1 of each node with respect to node i.
 4573:          // const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4574:          // const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4575:          // const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4576:          // const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 4577: 
 4578:          // node1->addToSparseMatrix(node1, I1_ii);
 4579:          // node1->addToSparseMatrix(node2, I1_ij); 
 4580:          // node1->addToSparseMatrix(node3, I1_ik);
 4581:          // node1->addToSparseMatrix(node4, I1_il);
 4582:   
 4583:       } 
 4584: 
 4585:  
 4586:       // Integral I_4
 4587:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 4588:       // Where
 4589:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 4590: 
 4591:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 4592:       // of U over the element.
 4593:       Vector2 U = {0.0, 0.0};
 4594:       for (int m=0; m < elem->i34; m++) {      
 4595:          const Side *side = elem->sides[m];
 4596: 
 4597:          if constexpr(ics == 1) U += side->U; 
 4598:          else                   U += side->frame.projHorVec(side->U, elem->frame);  // In global coordinates, we must project the side velocity to the element frame
 4599: 
 4600:       }
 4601:       U = U/elem->i34;
 4602: 
 4603: 
 4604:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 4605: 
 4606: 
 4607:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 4608:       const double I_4_1 = dot(gradPhi_1, U);
 4609: 
 4610: 
 4611:       // Integral of \nabla\phi_i \cdot \pmb{E}
 4612:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 4613: 
 4614:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 4615: 
 4616:       // Additional terms 
 4617:       double vnorm = 0.0;
 4618:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 4619:          Vector3 ubed = {0.0, 0.0, 0.0};
 4620:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 4621:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 4622: 
 4623:          Vector3 gradP = {0.0, 0.0, 1.0};
 4624:          for (int m=0; m < elem->i34; m++) {
 4625:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 4626:            gradP += toVector3(gradP_2D, 0.0);
 4627:          }   
 4628:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 4629:       } // imm==2
 4630: 
 4631:       if (elem->isTri()) {
 4632:          for (int l=0; l<3; l++) {
 4633: 
 4634:             Node *node = elem->nodes[l];
 4635: 
 4636:             double fac = (node == node1) ? 2.0 : 1.0;
 4637:    
 4638:             if      constexpr(imm == 2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 4639:             else if constexpr(imm == 1) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + (node->bdef2 - node->bdef1)); 
 4640:             else                        node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2); 
 4641:            
 4642:          }
 4643: 
 4644: 
 4645:          if (!elem->isDry) {
 4646:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 4647: 
 4648:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 4649: 
 4650:          }
 4651: 
 4652:       } // isTri
 4653:       else { // isQuad
 4654:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 4655:          // for (int l=0; l<4; l++) {
 4656:          //   const Node *node = elem->nodes[l];
 4657: 
 4658:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 4659:          //   else        tmp2 = node->bdef2 - node->bdef1;
 4660: 
 4661:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 4662:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 4663:          // }
 4664: 
 4665:       } // isQuad
 4666: 
 4667: 
 4668:      node1->qel += (dt/elem->i34)*elem->vsource;
 4669:       
 4670: 
 4671:    } // for all elements connected to the node
 4672:    
 4673: 
 4674:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 4675:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 4676:    NodeBoundary *nodeBnd = node1->nodeBnd;
 4677:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 4678:       // If it is an open boundary node...
 4679: 
 4680:       // At least one open bnd side, maybe two
 4681:       for (int l=0; l<2; l++) { 
 4682: 
 4683:          // Gets each of the sides sharing the node. 
 4684:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 4685: 
 4686:        
 4687: 
 4688:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 4689:          if (sideBnd != nullptr) {
 4690:             // If the side is on a boundary...
 4691: 
 4692:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 4693: 
 4694:             // Get the boundary segment
 4695:             const BoundarySegment *sideSegment = sideBnd->segment;
 4696:             const Side *side = sideBnd->side;
 4697: 
 4698:             // Integral I_3
 4699:             if (sideSegment->ifltype != 0) {
 4700:             // Natural or Flather b.c.
 4701: 
 4702:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4703:                // especially for Flather b.c.
 4704:                double ri3 = 0.0;
 4705:                if (!side->isDry) {
 4706:                   // If the side is not dry
 4707:                   
 4708:                   // Computes the side flux of (uth, vth)
 4709:                   double Vn = 0.0;
 4710:                   for (int k = side->kb; k < nvrt - 1; k++) {
 4711:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4712:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4713: 
 4714:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 4715:                   }
 4716: 
 4717:                   ri3 = 0.5*side->len*Vn;
 4718:                }
 4719: 
 4720:                if (sideSegment->ifltype == -1) { // Flather 1
 4721: 
 4722:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4723:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4724: 
 4725:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4726:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4727:                   
 4728:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4729:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4730: 
 4731:                } 
 4732:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4733:                   // Reset ri3
 4734:                   ri3 = 0.0;
 4735: 
 4736:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4737:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 4738: 
 4739:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4740: 
 4741:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4742:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4743: 
 4744:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4745:                   node1->addToSparseMatrix(node1, con0*2.0);
 4746:                   node1->addToSparseMatrix(node2, con0);
 4747: 
 4748:                } // if Flather or Discharge
 4749: 
 4750:                node1->qel -= thetai*dt*ri3;
 4751: 
 4752: 
 4753:             } // I_3
 4754:           
 4755: 
 4756:             // Integral I_5
 4757:             if(!side->isDry) {
 4758: 
 4759:                const double Unbar = dot(side->U, side->n);
 4760:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 4761: 
 4762:             } // I_5
 4763: 
 4764:          } // if is boundary side
 4765: 
 4766:       } // for l
 4767: 
 4768:    } // if isbnd
 4769: 
 4770: 
 4771: }
 4772: 
 4773: 
 4774: 
 4775: extern "C" {
 4776:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 4777:                                   int* indices, int* indptr) {
 4778: 
 4779:       NODE(node);
 4780:       
 4781:       const int idx = node->idx;
 4782:       
 4783:       // Computes the index in the nzz array      
 4784:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 4785: 
 4786: 
 4787:       indptr[idx] = nzzIdx;
 4788:       indices[nzzIdx] = idx;
 4789: 
 4790:       data_d[nzzIdx]    = node->coeffDiag;
 4791: 
 4792:       b_d[idx] = node->qel;
 4793: 
 4794:       for (int k = 0; k < node->numNodes; ++k) {
 4795:          const Node* nb = node->nodes[k];
 4796: 
 4797:          const int j = nb->idx;
 4798: 
 4799:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 4800: 
 4801:          indices[nzzIdx + k + 1] = j;
 4802:       }
 4803: 
 4804:  
 4805:    }
 4806: 
 4807: 
