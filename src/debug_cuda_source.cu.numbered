 8290: __global__ void printMatrix(bool full) {
 8291:    // Debugging: print the matrix
 8292: 
 8293:    const int size = mesh->np;
 8294:    double sum = 0.0;
 8295:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8296:       const Node *node = mesh->localNodeData + idx_node;
 8297:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 8298:       for (int j = 0; j < node->numNodes; j++) {
 8299:          Node* nbNode = node->nodes[j];
 8300:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 8301:          sum += node->coeffMatrix[j];
 8302:       }
 8303:       if (full) printf("]\n");
 8304: 
 8305: 
 8306:    }
 8307:    if (!full) printf("sum=%lf\n", sum);
 8308: }
