10123: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
10124:    Element *elems = mesh->localElemData;
10125: 
10126:    *addr = elems;
10127:    *sizeElement = sizeof(Element);
10128:    switch (varCode) {
10129:       case (int)VarCode::z:
10130:          *offset = (int)((char*)&elems[0].z - (char*)elems);
10131:          *sizeType = sizeof(double);
10132:          break;
10133:       case (int)VarCode::x:
10134:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
10135:          *sizeType = sizeof(Vector2);
10136:          break;
10137:       case (int)VarCode::gradETP:
10138:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
10139:          *sizeType = sizeof(Vector2);
10140:          break;
10141:       case (int)VarCode::area:
10142:          *offset = (int)((char*)&elems[0].area - (char*)elems);
10143:          *sizeType = sizeof(double);
10144:          break;
10145:       case (int)VarCode::depth:
10146:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
10147:          *sizeType = sizeof(double);
10148:          break;
10149:       case (int)VarCode::radius:
10150:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
10151:          *sizeType = sizeof(double);
10152:          break;
10153:       case (int)VarCode::ghat:
10154:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
10155:          *sizeType = sizeof(Vector2);
10156:          break;
10157:       case (int)VarCode::kb:
10158:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
10159:          *sizeType = sizeof(int);
10160:          break;
10161:       case (int)VarCode::isdry:
10162:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
10163:          *sizeType = sizeof(int);
10164:          break;            
10165:       case (int)VarCode::w:
10166:          *offset = (int)((char*)&elems[0].w - (char*)elems);
10167:          *sizeType = sizeof(double);
10168:          break;
10169:       case (int)VarCode::FaceIndices:
10170:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
10171:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
10172:          *sizeType = sizeof(Node);
10173:          break;
10174:       default:
10175:          *offset = -1;
10176:    }
10177: }
