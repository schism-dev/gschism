  329: // Polynomial class
  330: template<int grade>
  331: struct Polynomial {
  332:     // Static assertion to give a clear error message at compile time
  333:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  334: };
  335: 
  336: 
  337: // Explicit specialization for grade 4
  338: template<>
  339: struct Polynomial<4> {
  340:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  341: 
  342:    // Constructor from coefficients
  343:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  344: 
  345:    __device__ __forceinline__ double eval(double x) const {
  346:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  347:    }
  348: };
