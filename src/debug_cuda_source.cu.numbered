 4611: 
 4612:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4613: 
 4614:       SIDE(side);
 4615: 
 4616:       side->U = {0.0, 0.0}; 
 4617:          
 4618:       if(side->isDry) return;
 4619: 
 4620:       // Vertically integrated velocity U (in ll if ics=2)
 4621:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4622:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 4623:          side->U += side->Dz(k + 1)*uc;  
 4624:       }
 4625: 
 4626:    }
 4627: 
 4628:    __global__ void computeBottomDragVegetation(void) {
 4629:       // UNFINISHED. CHECK THIS:
 4630:       // How many kernels are needed? Why so many for loops?
 4631:       // Is the loop on sides needed?
 4632: 
 4633:       NODE(node);
 4634: 
 4635: 
 4636:       const int    kb      = node->kb;
 4637:       const double htot    = node->htot2(); 
 4638:       
 4639:       if (node->isDry) {
 4640:          // Default values for dry nodes
 4641:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4642:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4643: 
 4644:          return;
 4645:        
 4646:       }
 4647: 
 4648:       // Computes bottom drag Cd based on the selected nchi
 4649:       node->computeBottomDragCd();
 4650:       
 4651: 
 4652: 
 4653:       //   Bottom stress in m^2/s^2
 4654:       if (node->rho[kb + 1] >= -98.0)
 4655:       {
 4656:          const double mag_u = length(node->u2[kb + 1]);
 4657:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 4658: 
 4659:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4660:          // !sediment erosion: this part needs more documentation
 4661:       }
 4662:     
 4663: 
 4664: 
 4665:       // Compute vegetation parameters
 4666:       //--------------------------------
 4667: 
 4668:       // SAV constants
 4669:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4670:       constexpr double veg_cfpsi = 0.16;
 4671: 
 4672:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4673:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4674: 
 4675:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4676:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4677:          int kbin = 0; // bin index
 4678:          for (int k = kb; k < nvrt; k++) {
 4679:             // Computes node height above the bottom level
 4680:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4681:             assert(false && "Vertical variation of vegetation not implemented");
 4682: 
 4683:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4684:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4685:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4686:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4687:             // } else {
 4688:             //    // Find the bin at which the current vertical level is
 4689:             //    while (kbin<nbins_veg_vert) {
 4690:             //       const double zn = node->z[kbin];
 4691:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4692:             //          break;
 4693:             //       } // if
 4694:             //       kbin++;
 4695:             //    } // while
 4696:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4697: 
 4698:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4699:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4700:                
 4701:             //    // Linear interpolation of the vegetation parameters
 4702:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4703:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4704:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4705:             // } // if rl10
 4706: 
 4707:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4708: 
 4709:          } // for k
 4710: 
 4711: 
 4712:       } else { // Ganthy (iveg==2)
 4713:       //  Modify canopy height, diameter, and density
 4714: 
 4715:          // Make sure there is vegetation on this node
 4716:          if (node->veg_h_unbent > 0.0) {
 4717:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4718: 
 4719:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4720:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4721:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4722: 
 4723:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4724:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4725:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4726:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4727:          } // if veg_h_unbent
 4728: 
 4729:          for (int k = 0; k < nvrt; k++) {
 4730:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4731:          } // for k
 4732:       
 4733: 
 4734:       } // if iveg
 4735:      
 4736: 
 4737:       // Compute vertical mean of veg_alpha3D
 4738:       if (iveg != 0) {
 4739:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4740:          double sum1=0.0;
 4741:          double sum2=0.0;
 4742:          // Integrate over each level under the canopy...
 4743:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 4744:             const double Dz = node->Dz(k);
 4745: 
 4746:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 4747:             sum2 += Dz;
 4748: 
 4749:          } // for k
 4750:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4751:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4752: 
 4753:       } // if iveg
 4754: 
 4755:    }
 4756: 
 4757:    __global__ void computeVegetationAndDragParameters(void) {
 4758:       // Computes the vegetation and drag model parameters:
 4759:       // chi, \tilde\chi, beta, \breve{H}
 4760:       
 4761:       SIDE(side);
 4762: 
 4763:       side->hhat = 0.0;
 4764:       side->chi2 = 0.0;
 4765:       side->chi = 0.0;
 4766:       side->veg_c2 = 0.0;
 4767:       side->veg_beta = 0.0;
 4768: 
 4769:       if (side->isDry) return;
 4770: 
 4771:       const double htot = side->htot2();
 4772:       const int    kb   = side->kb;
 4773: 
 4774:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4775: 
 4776:       const double veg_h     = side->veg_h();
 4777:       const double veg_nv    = side->veg_nv();
 4778:       const double veg_c     = side->veg_c();
 4779:       const double veg_beta  = side->veg_beta;
 4780:       const double veg_alpha = side->veg_alpha_vert_mean();
 4781: 
 4782:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4783:       // Velocity magnitude at the bottom level
 4784:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4785:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 4786:       side->chi2 = side->Cd()*vmag1;
 4787:       side->chi  = side->chi2;
 4788:       if constexpr(iveg != 0) {
 4789:          const Node *n1 = side->n1;
 4790:          const Node *n2 = side->n2;
 4791:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4792:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4793:       }
 4794: 
 4795:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4796: 
 4797:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4798:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4799:       double magUa = 0.0;
 4800:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4801:          // 3D wet side with veg...
 4802: 
 4803:          double magUa = 0.0;
 4804:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4805:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4806: 
 4807:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4808:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4809:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4810: 
 4811:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4812:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4813: 
 4814:                // Velocity magnitude at the bottom (l) of the level
 4815:                const double ul = length(side->u2[k]);
 4816: 
 4817:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4818:                magUa += Dz*0.5*(uh + ul);
 4819: 
 4820:             } // if HasVegetation
 4821:          } // for k
 4822:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4823: 
 4824:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4825:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4826:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4827:             const double zCpy = side->zTopCanopy();
 4828:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4829:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4830:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4831:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4832:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4833:          } // if isSubmerged
 4834:       } // if iveg   
 4835: 
 4836:       // Computes the friction modified depth, \breve{H} in notes
 4837:       if (side->is2D()) { // 2D
 4838: 
 4839:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4840:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4841: 
 4842:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4843: 
 4844:          side->hhat = htot*htot/fricH; 
 4845: 
 4846:       } else { // 3D
 4847:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 4848: 
 4849:          if constexpr(iveg != 0) {
 4850:             
 4851:             if (side->isSubmerged()) { 
 4852:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4853:                side->hhat -= veg_c*Hhat_alpha;
 4854: 
 4855:             } else { // Emergent
 4856:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4857:             }
 4858:          } // if iveg
 4859: 
 4860:          // Enforce positivity for 3D model
 4861:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 4862:       } // if 3D
 4863: 
 4864:    }
 4865: 
 4866: 
 4867: 
 4868:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4869:    // Computes the density gradient between two elements, e1 and e2.
 4870:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4871:    // zero in the direction normal to the side. 
 4872:    // 
 4873:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4874:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4875:    //
 4876:    // Input:
 4877:    //    e1: Element
 4878:    //    e2: Neighbor element (or nullptr if boundary)
 4879:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4880:    //    k: Index of the half-level at which the density is interpolated
 4881:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4882:    // 
 4883:    // Output:
 4884:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4885:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4886: 
 4887:       if (e2 == nullptr || e2->isDry) {
 4888:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4889: 
 4890:          Side *side = e1->sides[j];
 4891:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4892:                  
 4893:          if constexpr(ics == 1) {
 4894:             vec = side->n; // Normal vector to the side
 4895:          } else {
 4896:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 4897:             // IMPLEMENT THIS XXXXXX
 4898:             // !replace with xel, yel?
 4899:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4900:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4901:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4902:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4903:          } //ics
 4904:                    
 4905:          diffRho = 0.0;
 4906: 
 4907:       } else { //internal and wet
 4908:          if constexpr(ics==1) {
 4909:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4910: 
 4911:             // Vector from e1 to e2
 4912:             vec = e2->center - e1->center;
 4913: 
 4914:          } else { 
 4915:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 4916:             // IMPLEMENT THIS XXXXXX
 4917:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4918:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4919:             //                   alow(j)=xctr2
 4920:             //                   bdia(j)=yctr2
 4921:          } // ics
 4922: 
 4923:          diffRho = rho2 - e1->demeanedDensity(k);
 4924:       }
 4925: 
 4926:    }
 4927: 
 4928:    __global__ void computeDensityCubicSplines(void) {
 4929:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4930: 
 4931:       ELEM(elem);
 4932: 
 4933:       if (elem->isDry) return;
 4934: 
 4935:       const int kb = elem->kb;
 4936: 
 4937:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4938:       if (elem->is2D()) {
 4939:          // In the 2D case, the density is constant at the prism level. 
 4940:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4941:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4942:       } else { //3D
 4943: 
 4944:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4945:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4946:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4947:          ///// XXXX CHECK INDICES!!!!!
 4948:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4949:       } // 2D/3D
 4950: 
 4951:    }
 4952: } // extern "C"
 4953: 
 4954: 
 4955: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4956: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4957: 
 4958:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4959: 
 4960:    const int kb  = elem->kb;
 4961:    const int kb2 = elem2->kb;
 4962: 
 4963:    // z-coordinate of prism of elem
 4964:    const double zp = elem->z_prism(k);
 4965: 
 4966:    double rho = 0.0;
 4967: 
 4968:    if (elem2->is2D()) {
 4969:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4970: 
 4971:    } else {  // 3D
 4972: 
 4973:       // eta_min may be < zmax
 4974:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4975:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4976: 
 4977:       // (Extrapolate density below bottom, we will fix it later)
 4978:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4979:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4980:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4981:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4982:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4983:    } // 2D/3D
 4984:      
 4985: 
 4986:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4987:    // Now we need to fix it.
 4988:    if (elem->z[k] < elem2->z[kb2]) {
 4989:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4990: 
 4991:       // There are two methods to adjust the density at the bottom of the element.
 4992:       // iunder_deep=0: 
 4993:       const double depth1 = abs(elem->z[kb]); // larger depth
 4994: 
 4995:       if (iunder_deep==0) {
 4996: 
 4997:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4998: 
 4999:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5000: 
 5001:       } else { // iunder_deep != 0
 5002: 
 5003:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5004: 
 5005:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5006: 
 5007:          //   Demeaned density at the same z coordinate as
 5008:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5009:          }
 5010: 
 5011:       } // if iunder_deep
 5012:    } // if elem->z[kb] < elem2->z[kb]
 5013: 
 5014:    return rho;
 5015: }
 5016: 
 5017: 
 5018: extern "C" {
 5019:    __global__ void computeDensityGradient(void) {
 5020: 
 5021:       if constexpr(ibc != 0) return;
 5022: 
 5023:          // Compute the horizontal density gradient at each element.
 5024:       // It works in two steps:
 5025:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5026:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5027:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5028:       //             gradRho.r1 = rho1 - rho0
 5029:       //             gradRho.r2 = rho2 - rho0
 5030:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5031:       // 
 5032:       //  NOTE: We use de-meaned densities.
 5033: 
 5034:       ELEM(elem);
 5035: 
 5036:       if (elem->isDry) return;
 5037: 
 5038:       const int kb  = elem->kb;
 5039:       const int i34 = elem->i34;
 5040: 
 5041:       for (int k = kb + 1; k < nvrt; k++) {
 5042:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5043:          //             gradRho.r1 = rho1 - rho0
 5044:          //             gradRho.r2 = rho2 - rho0
 5045:          int icount = 0;
 5046:          double sumRx = 0.0;
 5047:          double sumRy = 0.0;
 5048:          for (int j1=0; j1<i34; j1++) { 
 5049: 
 5050:             const int j2 = elem->nxq(j1 + 1);
 5051: 
 5052:             // Pairs of consecutive neighbor elements of elem
 5053:             const Element *e1 = elem->nghbElems[j1];
 5054:             const Element *e2 = elem->nghbElems[j2];
 5055: 
 5056:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5057:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5058:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5059: 
 5060:             // Compute the density difference and the vector from elem to e1 and e2
 5061:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5062:             double diffRho1, diffRho2;
 5063:             Vector2 vec1, vec2;
 5064:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5065:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5066: 
 5067:             const double rl1 = length(vec1);
 5068:             const double rl2 = length(vec2);
 5069:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5070: 
 5071:             const double delta = cross(vec1, vec2);
 5072:             const double sintheta = abs(delta)/(rl1*rl2);
 5073: 
 5074:             // To avoid problems, avoid elements with small angle between vectors
 5075:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5076:             const bool validEq = (sintheta > sin_one_deg);
 5077: 
 5078:             if (validEq) {
 5079:                // Solve the system of equations to get the density gradient at elem
 5080:                icount++;
 5081:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5082:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5083:                sumRx += Rx;
 5084:                sumRy += Ry;
 5085:             }
 5086:          } // for j1
 5087: 
 5088:          // Compute the average density gradient at elem
 5089:          if (icount==0) {
 5090:            // Bad mesh quality; bail out with 0 b-cc
 5091:            elem->gradRho[k] = {0.0, 0.0};
 5092:          } else {
 5093:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5094:          }
 5095: 
 5096:       } // for k
 5097: 
 5098:    }
 5099: 
 5100:    __global__ void computeBaroclinicTerm(void) {
 5101:    // Computes the baroclinic term at sides (at half levels).
 5102:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5103:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5104: 
 5105:       if (ibc == 1) return;
 5106: 
 5107:       SIDE(side);
 5108: 
 5109:       if (side->isDry) return;
 5110: 
 5111:       const Element *e1 = side->elems[0];
 5112:       const Element *e2 = side->elems[1];      
 5113:       const int kb = side->kb;
 5114:       
 5115:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5116: 
 5117:       // interpolates vertically the density gradient of the two elements at the half level/
 5118: 
 5119:       int k1 = max(kb, nvrt / 2);
 5120:       int k2 = max(kb, nvrt / 2);
 5121: 
 5122:       // Starts the integration at the surface and goes down to the bottom
 5123:       side->bcc[nvrt-1] = {0.0, 0.0};
 5124:       for (int k = nvrt - 2; k >= kb; k--) {
 5125:       // For each prism level (from surface to bottom)...
 5126: 
 5127:          // For both elements, interpolate density gradient at the side's half level.
 5128:          // The gradient at the side is the average of the gradients at the elements.
 5129:          // w1, w2 are used to take into account boundary sides, with just one element.
 5130:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5131:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5132:          const double wsum = w1 + w2;
 5133:          w1 = w1/wsum;
 5134:          w2 = w2/wsum;
 5135:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5136: 
 5137:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5138:          Vector2 gradRho = {0.0, 0.0};
 5139:          if (e1 != nullptr && k > kb) {
 5140:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5141:             
 5142:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5143:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5144:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5145: 
 5146:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5147:          }      
 5148:          if (e2 != nullptr && k > kb) {
 5149:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5150:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5151:             
 5152:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5153:          }
 5154: 
 5155:          if constexpr(ics==2) {
 5156:             assert(false && "Not implemented: ics == 2");
 5157:             // IMPLEMENT THIS XXXXXX
 5158:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5159:             // swild(1)=tmp1
 5160:             // swild(2)=tmp2
 5161:          }
 5162:          
 5163:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5164:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5165:          // CHECK INDICES!!! XXX
 5166:          const double grav3 = side->grav3();
 5167:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5168: 
 5169:       } // for
 5170: 
 5171:    }
 5172: 
 5173: 
 5174: 
 5175:    __global__ void computeHorGradientAtSide(void) {
 5176: 
 5177:       // Compute the horizontal density gradient at each element.
 5178:       // It works in two steps:
 5179:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5180:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5181:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5182:       //             gradRho.r1 = rho1 - rho0
 5183:       //             gradRho.r2 = rho2 - rho0
 5184:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5185:       // 
 5186:       //  NOTE: We use de-meaned densities.
 5187: 
 5188:       SIDE(side);
 5189: 
 5190: 
 5191:       if (side->isDry) return;
 5192: 
 5193:       // Computes the gradient of the variables at the side center.
 5194:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5195:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5196:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 5197: 
 5198:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5199:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5200:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5201:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5202: 
 5203:    }
 5204: 
 5205: 
 5206:    __global__ void solveMomentumEquations(double time) {
 5207: 
 5208:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5209:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5210: 
 5211:       SIDE(side);
 5212: 
 5213:       if (side->isDry) 
 5214:       {
 5215:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 5216: 
 5217:          return;
 5218:       }
 5219: 
 5220:       const Node *n1 = side->n1;
 5221:       const Node *n2 = side->n2;
 5222: 
 5223:       const int kb = side->kb;
 5224: 
 5225:       const double veg_h = side->veg_h();
 5226:       const double grav3 = side->grav3();
 5227: 
 5228:       if (side->is2D()) {
 5229:          // Remember: Do not use htot2, which is updated.
 5230:          const double htot = side->htot1();
 5231:          const double hhat = side->hhat;
 5232: 
 5233:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5234: 
 5235:          Vector2 tau2 = {0.0, 0.0};
 5236:           
 5237:          if constexpr(ics==1) {
 5238:             tau2 = side->tau();
 5239: 
 5240:          } else {
 5241:             assert(false && "Not implemented: ics == 2");
 5242:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5243:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5244:             // taux2=(vn1+tt1)*0.5d0
 5245:             // tauy2=(vn2+ss1)*0.5d0
 5246:          } // if ics         
 5247: 
 5248:          // hat_gam has units of m/s
 5249: 
 5250:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5251:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5252:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5253: 
 5254:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5255: 
 5256: 
 5257:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 5258: 
 5259:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 5260: 
 5261:       }
 5262:       else { // 3D
 5263: 
 5264:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5265:          // 
 5266:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5267:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5268:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5269:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5270:          // k+1 and k.
 5271: 
 5272: 
 5273:          const int ndim = nvrt - kb;
 5274:          const double zTopCanopy = side->zTopCanopy();
 5275: 
 5276:          // Initialize the tridiagonal system
 5277:          for (int k = kb + 1; k < nvrt; k++) {
 5278:             
 5279:             const int kin = k - (kb + 1);
 5280: 
 5281:             // Vertical viscosity at the face center
 5282:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 5283: 
 5284:  
 5285:             alow[kin] = 0.0;
 5286:             cupp[kin] = 0.0;
 5287:             bdia[kin] = 0.0;
 5288: 
 5289:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5290:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5291: 
 5292:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5293:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5294:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5295: 
 5296:             // First part: layers k, k+1
 5297:             if (k < nvrt - 1) {
 5298:                              
 5299:                if constexpr(iveg != 0) {
 5300: 
 5301:                   // If there is vegetation at this level...
 5302:                   if (zTopCanopy > side->zc[k]) {
 5303:                      // If the canopy is above the k layer...
 5304:                      
 5305:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5306:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5307:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5308:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5309: 
 5310:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5311:                      const double vmag2 = length(ut2);
 5312:                      const double vmag1 = length(side->u2[k]);
 5313:                      const double vmag = 0.5*(vmag1 + vmag2);
 5314:                      
 5315:                      // Computes the vegetation alpha at the face center
 5316:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5317: 
 5318:                      cff1 += veg_alpha_sd*dt*vmag;
 5319: 
 5320:                   } // if (zTopCanopy
 5321:                } // if iveg
 5322: 
 5323:                const double dzz = side->Dz(k + 1);
 5324:                const double tmp = dt*dfz/dzz;
 5325:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5326: 
 5327:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5328:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5329:             }
 5330: 
 5331: 
 5332:             // Second part: layers k-1, k
 5333:             if (k > kb + 1) {
 5334: 
 5335:                double cff1 = 1.0; //init \bar{c^k}
 5336: 
 5337:                if constexpr(iveg != 0) {
 5338:                   // If there is vegetation at this level...
 5339:                   if (zTopCanopy > side->zc[k-1]) {
 5340:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5341:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5342: 
 5343:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5344: 
 5345:                      const double vmag2 = length(ut2);
 5346:                      const double vmag1 = length(side->u2[k-1]);
 5347:                      const double vmag = 0.5*(vmag1 + vmag2);
 5348: 
 5349:                      // Computes the vegetation alpha at the face center
 5350:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5351:                      cff1 += veg_alpha_sd*dt*vmag;
 5352:                   } // if zTopCanopy
 5353: 
 5354:                } // if iveg
 5355: 
 5356:                const double dzz = side->Dz(k);
 5357:                const double tmp = dt*dfz/dzz;
 5358:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5359: 
 5360:                alow[kin] += cff1*dzz/6.0 - tmp;
 5361:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5362: 
 5363:             } else { // Bottom boundary
 5364:                // This occurs at the bottom, where the bottom drag is applied.
 5365: 
 5366:                bdia[kin] += dt*side->chi2; // XXXX
 5367: 
 5368:             } // if (k > kb + 1)
 5369: 
 5370: 
 5371:          } // for (int k
 5372: 
 5373: 
 5374: 
 5375:          // Computes the RHS.
 5376:          // -----------------
 5377: 
 5378:          //	BC to be imposed at the end.
 5379: 
 5380:          const Vector2 gradETP  = side->gradETP;
 5381:          const Vector2 gradPr   = side->gradPr;
 5382:          const Vector2 gradEta1 = side->gradEta1;
 5383:          const Vector2 gradEta2 = side->gradEta2;
 5384: 
 5385:          const Vector2 *btu = side->btu;
 5386:          const Vector2 *u2  = side->u2;
 5387:          const double coriolis = side->coriolis;
 5388:          const Vector2 *nuGradU = side->nuGradU;
 5389: 
 5390: 
 5391:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5392:          for (int k = kb + 1; k < nvrt; k++) {
 5393:             const int kin = k - kb - 1;
 5394: 
 5395:             const double dz_0 = side->Dz(k);
 5396:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5397: 
 5398:             rrhs[kin] = {0.0, 0.0};
 5399:             double dz = 0.0;
 5400: 
 5401:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5402:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5403:             if (k < nvrt  ) dz += dz_1;
 5404:             if (k > kb + 1) dz += dz_0;
 5405: 
 5406:             // Elevation gradient, atmospheric pressure and tidal potential
 5407:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5408: 
 5409:             // Coriolis, advection, wind stress, and horizontal viscosity
 5410:             if (k < nvrt - 1) {
 5411: 
 5412: 
 5413:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5414:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5415:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5416:                                                 
 5417: 
 5418:                //diff stress tensors 1006
 5419:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5420:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5421:                   assert(false && "Not implemented: itur == 5");
 5422:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5423:                }
 5424:                // else assert(false && "itur # Not implemented");
 5425: 
 5426:             } else { // k == nvrt - 1 SURFACE
 5427:                Vector2 tau2 = {0.0, 0.0};
 5428:                if constexpr(ics==1) {
 5429:                   tau2 = side->tau();
 5430:       
 5431:                } else {
 5432:                   assert(false && "Not implemented: ics == 2");
 5433:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5434:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5435:                   // taux2=(vn1+tt1)*0.5d0
 5436:                   // tauy2=(vn2+ss1)*0.5d0
 5437:                } // if ics
 5438: 
 5439:                rrhs[kin] += dt*tau2;
 5440:           
 5441: 
 5442:             } // if k<nvrt
 5443: 
 5444: 
 5445:             if (k > kb + 1) {
 5446:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5447:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5448:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5449: 
 5450:                // diff stress tensors 1006
 5451:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5452:                   assert(false && "Not implemented: itur == 5");
 5453:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5454:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5455:                }
 5456:                // else assert(false && "itur # Not implemented");
 5457: 
 5458: 
 5459:             } // if k>kbs + 1
 5460: 
 5461:             // Baroclinic
 5462:             Vector2 *bcc = side->bcc;
 5463:             if constexpr(ibc == 0) {
 5464:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5465:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5466: 
 5467:             } // if ibc==0
 5468: 
 5469:          } // k=kb + 1,nvrt
 5470: 
 5471: 
 5472:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5473: 
 5474:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 5475:             const int kin = k - kb - 1;
 5476:    
 5477:             // Velocity is always clamped to maximum values
 5478:             side->u2[k] = clampVelocity(soln[kin]);
 5479:          } // k
 5480: 
 5481:       } // if side->is2D()
 5482:       
 5483: 
 5484:       // Impose velocity boundary condition at the bottom
 5485:       if constexpr(imm == 2) { // 3D bed deformation model
 5486:          double dep;
 5487:          Vector2 vel;
 5488: 
 5489:          assert(false && "Not implemented: imm == 2");
 5490:          //update_bdef(time, x0, y0, dep, vel);
 5491:          // side->u2[kb] = vel;
 5492: 
 5493:       } else { // imm = 0 or 1
 5494:          if (side->Cd() == 0.0) {
 5495:             side->u2[kb] = side->u2[kb + 1];
 5496: 
 5497:          } else if (side->is3D()) { // 3D no slip bottom   
 5498:             side->u2[kb] = {0.0, 0.0};
 5499: 
 5500:          }
 5501:           
 5502:       } // if imm
 5503: 
 5504:       // The velocities below the bottom level are set to zero
 5505:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 5506: 
 5507: 
 5508:    }
 5509: 
 5510: 
 5511:    __global__ void applyMomentumBC(void) {
 5512: 
 5513:       SIDE_BND(sideBnd);
 5514: 
 5515:       Side *side = sideBnd->side;
 5516:       const BoundarySegment *segment = sideBnd->segment;
 5517:       const Node *n1 = side->n1;
 5518:       const Node *n2 = side->n2;
 5519: 
 5520:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5521: 
 5522:       const bool isLand = segment->isLand;
 5523:       const int ifltype = segment->ifltype;
 5524: 
 5525:       const int kb = side->kb;
 5526: 
 5527: 
 5528:       if (!isLand && ifltype != 0) {
 5529:          const Vector2 *ubc = sideBnd->ubc;
 5530:   
 5531:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5532:             
 5533:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5534:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5535: 
 5536:             if (ifltype == -1) {
 5537:                // Flather 1
 5538: 
 5539:                const double depth = side->depth();
 5540: 
 5541:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5542: 
 5543:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5544: 
 5545:                side->u2[k] = vnorm*side->n;
 5546: 
 5547:             } else if (ifltype == -2) { // Discharge
 5548: 
 5549:                const double eta1 = side->eta1();
 5550:                const double eta2 = side->eta2();
 5551:                const double htot = side->htot2();
 5552: 
 5553:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5554:                assert(false && "Not implemented: Discharge bc");
 5555:                // const double dischrg = discharge(eta1);
 5556:                const double dischrg = 0.0; // XXX REMOVE
 5557:                
 5558: 
 5559:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5560: 
 5561:                const double vnorm = dischrg*eta2/htot;
 5562: 
 5563:                side->u2[k] = vnorm*side->n;
 5564: 
 5565:             }
 5566:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5567:                const double vnorm = dot(side->u2[k], side->n);
 5568: 
 5569:                double rat;
 5570:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5571:                else              rat = segment->vobc2; // outgoing
 5572: 
 5573:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5574: 
 5575:             }
 5576:             else { // not Flather or 3D radiation
 5577:                side->u2[k] = ubc[k];
 5578: 
 5579:             } // if (segment->ifltype...
 5580: 
 5581:          }
 5582: 
 5583:       }
 5584:       else if (isLand) { // if it is land boundary side
 5585: 
 5586:          if constexpr(islip == 0) { // free slip
 5587: 
 5588:             for (int k = kb; k < nvrt; k++) {
 5589: 
 5590:                const Vector2 t = side->t();
 5591:                const Vector2 n = side->n;
 5592: 
 5593:                double vnorm = 0.0; // for most cases
 5594:                const double vtan = dot(side->u2[k], t);
 5595:                
 5596:                side->u2[k] = vtan*t - vnorm*n;
 5597: 
 5598:             }
 5599: 
 5600:          } else { // no slip
 5601:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5602: 
 5603:          }
 5604:       } // if (side segment type...
 5605: 
 5606:    
 5607: 
 5608:    }
 5609: 
 5610: 
 5611:    __global__ void shapiroFilter1(void) {
 5612:       // First step of the Shapiro filter (normally used if indvel<=0)
 5613:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5614: 
 5615:       SIDE(side);
 5616: 
 5617:       // Only internal wet sides are processed
 5618:       if (side->isDry || !(side->isInternal())) return;
 5619: 
 5620:       const int kb = side->kb;
 5621: 
 5622:       for (int mm = 0; mm < niter_shap; mm++) {
 5623: 
 5624:          for (int k = kb + 1; k < nvrt; k++) {
 5625:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5626:             Vector2 suru = {0.0, 0.0};
 5627: 
 5628:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5629: 
 5630:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 5631: 
 5632:                int kin = k;
 5633:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5634:                
 5635:                if constexpr(ics==1) {
 5636:                   suru += nSide->u2[kin];
 5637: 
 5638:                } else {
 5639:                   assert(false && "Not implemented: ics == 2");
 5640:                   // Vector2 vn1, vn2;
 5641:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5642:                   // suru=suru+vn1;
 5643:                   // surv=surv+vn2;
 5644:                }
 5645:             }
 5646: 
 5647:             // Reusing bcc as a temporary array to store the suru values.
 5648:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5649: 
 5650:          }
 5651:       }
 5652:    }
 5653: 
 5654:    __global__ void shapiroFilter2(void) {
 5655:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5656: 
 5657:       SIDE(side);
 5658: 
 5659: 
 5660:       if (side->isDry || !(side->isInternal())) return;
 5661: 
 5662:       const int kb = side->kb;
 5663: 
 5664:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5665: 
 5666:       if (side->is2D()) {
 5667:          side->u2[kb + 1] = side->bcc[kb + 1];
 5668:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 5669: 
 5670:       } else {
 5671:          // 3D
 5672:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5673:          
 5674:       }
 5675: 
 5676:    }
 5677: 
 5678: 
 5679:    __global__ void ul0UpdateZCoords(void) {
 5680:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5681:       
 5682:       NODE(node);      
 5683: 
 5684: 
 5685:       if (false) { //node->isDry) { XXXXXXX
 5686: 
 5687:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 5688: 
 5689:          if constexpr(ivcor != 1) node->kb = 0;
 5690: 
 5691:       } else {
 5692: 
 5693:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 5694:          node->updateKb();
 5695: 
 5696:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5697: 
 5698:       }
 5699: 
 5700:       // We use the temp.b field to store the previous state of isDry.
 5701:       node->tmp.b = node->isDry;
 5702: 
 5703:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5704:       node->isDry = true;
 5705: 
 5706:    }
 5707: 
 5708:    __global__ void ul0ComputeDryElements(void)
 5709:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 5710:    {
 5711:       ELEM(elem);
 5712: 
 5713:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 5714: 
 5715:       elem->kb = 0;
 5716: 
 5717:       if (elem->isDry) return;
 5718: 
 5719: 
 5720:    //    if(elem->isDry2()) { // XXXX
 5721:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5722:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5723:    //        call parallel_abort(errmsg)
 5724:    //    }
 5725: 
 5726:       const Node *n1 = elem->nodes[0];
 5727:       const Node *n2 = elem->nodes[1];
 5728:       const Node *n3 = elem->nodes[2];  
 5729:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 5730: 
 5731:       // Computes element's kb as the minimum of the nodes' kb.
 5732:       const int kb1 = n1->kb;
 5733:       const int kb2 = n2->kb;
 5734:       const int kb3 = n3->kb;
 5735:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5736: 
 5737: 
 5738:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5739: 
 5740: 
 5741:       // Computes the element z as the mean of the nodes z.
 5742:       for (int k = elem->kb; k < nvrt; k++) {
 5743: 
 5744:          // Compute the element z as the mean of the nodes z.
 5745:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 5746:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5747:          elem->z[k] /= elem->i34;
 5748: 
 5749:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5750:       }
 5751:                   
 5752:    }
 5753: 
 5754:    __global__ void ul0ComputeDryNodes(void)
 5755:    // Updates node's isDry based on the elements' isDry. 
 5756:    {
 5757:       NODE(node);
 5758: 
 5759:       node->isDry = true;
 5760: 
 5761:       // A node is wet if at least one of the elements sharing it is wet.
 5762:       for (int j = 0; j < node->numElements; j++) {
 5763:          const Element *elem = node->elements[j];
 5764:          if (!elem->isDry) {
 5765:             node->isDry = false;
 5766:             break;
 5767:          }
 5768:       }
 5769: 
 5770:        
 5771:    }
 5772: 
 5773: 
 5774:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5775:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 5776:    // node->tmp.b is true if the node was previously dry.
 5777:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 5778:    {
 5779:       NODE(node);
 5780:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5781: 
 5782:       // Avoid this the first time step.
 5783:       if (it == iths) return;  
 5784: 
 5785:       const bool wasDry = node->tmp.b;
 5786: 
 5787: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 5788: 
 5789:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 5790: 
 5791:          for (int k=0; k < nvrt; k++) {
 5792: 
 5793:             Vector3 utmp={0.0, 0.0, 0.0};
 5794: 
 5795:             double ttmp=0.0;
 5796:             double stmp=0.0;
 5797:             int icount=0;
 5798:             for (int j = 0; j < node->numNodes; j++) {
 5799: 
 5800:                const Node *nbrNode = node->nodes[j];
 5801:                
 5802:                const bool wasNbrDry = nbrNode->tmp.b;
 5803: 
 5804:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 5805:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 5806: 
 5807:                   icount++;
 5808: 
 5809:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5810:                   utmp += nbrNode->uvw2(k);
 5811:                   
 5812:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 5813:                   stmp += nbrNode->tracers[k].tracer[1]; 
 5814:                }
 5815:             }
 5816: 
 5817:             if (icount > 0) {
 5818:                const double inv_icount = 1.0/icount;
 5819:                utmp = inv_icount*utmp;
 5820:                node->u2[k]     = toVector2(utmp);
 5821:                node->w2[k]     = utmp.z;
 5822:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5823:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5824:             } else {
 5825:                node->u2[k] = {0.0, 0.0};
 5826:                node->w2[k] = 0.0;
 5827:                // Initialize tracers to 0.0??? XXXXX
 5828:             }
 5829:          }
 5830:       }
 5831:    }
 5832: 
 5833:   
 5834:    
 5835: 
 5836: 
 5837:    __global__ void ul0UpdateSides(int it, int iths) {
 5838:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 5839:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 5840:    // The dryness of the sides is updated in ul0UpdateSides2.
 5841: 
 5842:       SIDE(side);
 5843: 
 5844:       // A side is wet if and only if at least one of its elements is wet.
 5845:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5846:  
 5847:       const Node *n1 = side->n1;
 5848:       const Node *n2 = side->n2;
 5849:      
 5850:       const int kb1 = n1->kb;
 5851:       const int kb2 = n2->kb;
 5852: 
 5853:       side->kb = 0; // default when dry
 5854: 
 5855:       if (isWet) {
 5856: 
 5857:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5858: 
 5859:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5860: 
 5861:          side->kb = min(kb1, kb2);
 5862: 
 5863:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 5864: 
 5865:          for (int k = side->kb; k < nvrt; k++) {
 5866:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5867: 
 5868:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 5869: 
 5870:             // Compute velocity for re-wetted sides 
 5871:             if ((it != iths) && (side->isDry && isWet)) {
 5872: 
 5873:                Vector2 utmp={0.0, 0.0};
 5874: 
 5875:                int icount=0;
 5876: 
 5877:                // For all the sides on the two elements that share this side
 5878:                for (int j = 0; j < 2; j++) {
 5879:                   const Element *elem = side->elems[j];
 5880:                   if (elem == nullptr) continue;
 5881: 
 5882:                   for (int jj=0; jj < elem->i34; jj++) {
 5883:                      const Side *nSide = elem->sides[jj];
 5884:                      if (nSide->isDry) continue;
 5885: 
 5886:                      icount++;
 5887:                      utmp += nSide->u2[k];  
 5888:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 5889:                   }
 5890:                }
 5891:                   
 5892:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 5893:                if (icount > 0)  side->u2[k] = utmp/icount;
 5894:                else             side->u2[k] = {0.0, 0.0};
 5895:                   
 5896:             } // if ((it != iths) && (side->isDry && isWet))
 5897: 
 5898:          } // for k
 5899: 
 5900:       } // if isWet 
 5901:       
 5902: 
 5903: 
 5904:    }
 5905: 
 5906:    __global__ void ul0UpdateSides2(void) {
 5907:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 5908:    
 5909:          SIDE(side);
 5910:    
 5911:          const Element *e1 = side->elems[0];
 5912:          const Element *e2 = side->elems[1];
 5913: 
 5914:          // A side is wet if and only if at least one of its elements is wet.
 5915:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 5916: 
 5917:          // Update the side's dryness
 5918:          side->isDry = !isWet;
 5919: 
 5920:    }
 5921: 
 5922: 
 5923:    __global__ void zeroNodalVelocities(void) {
 5924:       NODE(node);
 5925: 
 5926:       for (int k = 0; k < nvrt; k++) {
 5927:          node->u2[k]   = {0.0, 0.0};
 5928:          node->w2[k]   = 0.0;
 5929:          node->utmp[k] = {0.0, 0.0};
 5930:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5931:       }
 5932:    }
 5933:  
 5934: 
 5935:    __global__ void computeNodalVerticalVelocities1(void) {
 5936:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5937:    // Adds the element's vertical velocity times the element's area.
 5938:       ELEM(elem);
 5939: 
 5940:       for (int j = 0; j < elem->i34; j++) {
 5941:          Node *node = elem->nodes[j];
 5942: 
 5943:          for (int k = node->kb; k < nvrt; k++) {
 5944:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 5945:          }
 5946:          atomicAdd(&(node->tmp.d), elem->area);
 5947:       }
 5948:    }
 5949: 
 5950:    __global__ void computeNodalVerticalVelocities2(void) {
 5951:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5952:    // Divides by the total area of the elements sharing the    node.
 5953:       NODE(node);
 5954: 
 5955:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5956: 
 5957:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 5958:    }
 5959: 
 5960: 
 5961:    __global__ void computeNodalHorizontalVelocities1(void) {
 5962: 
 5963:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 5964:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 5965: 
 5966:       ELEM(elem);
 5967: 
 5968:       if (elem->isDry) return;
 5969: 
 5970:       const int kb = elem->kb;
 5971:       const bool isTri = elem->isTri();
 5972: 
 5973:       if constexpr(indvel <= 0) {
 5974:          // Assuming discontinous hvel.
 5975: 
 5976:          if (isTri) { // For triangles
 5977:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 5978:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 5979: 
 5980:             for (int j = 0; j < 3; j++) {
 5981:                // For every node of the triangle...
 5982:                Node *node = elem->nodes[j];
 5983: 
 5984:                if (node->isDry) continue;
 5985: 
 5986:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 5987:                const Side *s2 = elem->sides[(j + 1) % 3];
 5988:                const Side *s3 = elem->sides[(j + 2) % 3];
 5989: 
 5990:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 5991: 
 5992:                atomicAdd(&(node->tmp.i), 1);
 5993: 
 5994:                for (int k = kb; k < nvrt; k++)  {
 5995:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated linearly at node j.   
 5996:                   u = clampVelocity(u);
 5997:                   atomicAdd(&(node->utmp[k].x), u.x);
 5998:                   atomicAdd(&(node->utmp[k].y), u.y);
 5999: 
 6000:                }
 6001: 
 6002:             }
 6003:          }
 6004:          else { // For quads
 6005:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6006: 
 6007:          }
 6008: 
 6009:       }
 6010:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 6011:       
 6012:    }
 6013: 
 6014: 
 6015:    __global__ void computeNodalHorizontalVelocities2(void) {
 6016:       NODE(node);
 6017: 
 6018:       const int nodeCount = node->tmp.i;
 6019: 
 6020:       if (nodeCount == 0) 
 6021:       {
 6022:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 6023:          return;
 6024:       }
 6025: 
 6026:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 6027:       
 6028:       const int kb = node->kb;
 6029: 
 6030:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 6031:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 6032:       
 6033:       
 6034:    }   
 6035: 
 6036:  
 6037: 
 6038:    __global__ void resetVelocityOpenBndNodes(void) {
 6039:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6040: 
 6041:       NODE_BND(nodebnd);
 6042: 
 6043:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6044:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 6045:       }
 6046: 
 6047:    }
 6048: 
 6049: 
 6050:    __global__ void setVelocityOpenBndNodes(void) {
 6051:    // For open boundary nodes sets their velocity to the imposed values.
 6052: 
 6053:       SIDE_BND(sidebnd);
 6054: 
 6055:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6056:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6057:          // to its segment to the average of the side velocity.
 6058: 
 6059:          for (int k = 0; k < nvrt; k++) {
 6060:             Node *n1 = sidebnd->side->n1;
 6061:             Node *n2 = sidebnd->side->n2;
 6062: 
 6063: 
 6064:             Vector2 n1_u2(n1->u2[k]);
 6065:             Vector2 n2_u2(n2->u2[k]);
 6066: 
 6067:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6068:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6069:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6070:             }
 6071:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6072:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6073:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6074:             }
 6075: 
 6076:          }
 6077: 
 6078:       }
 6079: 
 6080:    }
 6081: 
 6082: 
 6083:    __global__ void computeVerticalVelocity(void) {
 6084:       // Computes the vertical velocity at the (2D) element's centroid.
 6085:       // In this function we will be considering volumetric elements, with side faces and a 
 6086:       // bottom and a top face. We will call them SFs, BF and TF.
 6087:       // It computes the flux coming from BF and the SFs.
 6088:       // If the bed is moving, it takes that into account.
 6089:       // Since water is incompressible, the integral of the velocity times the normal vector
 6090:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6091:       // and the BF is equal to the flux going out from the TF.
 6092:       // TF = - BF - sum(SFs).
 6093:       // It then computes the horizontal velocity at the center of TF.
 6094:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6095:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6096:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6097: 
 6098:       ELEM(elem);
 6099: 
 6100:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 6101: 
 6102:       if (elem->isDry) return;
 6103: 
 6104:       const int kb = elem->kb;
 6105:       const bool isTri = elem->isTri();
 6106: 
 6107:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6108: 
 6109:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6110:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6111:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6112: 
 6113:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6114: 
 6115:       double area3D;
 6116: 
 6117:       // Bottom face flux
 6118:       double bottomFlux = 0.0;
 6119:       Vector2 u2meanBottom = {0.0, 0.0};
 6120:       const Vector2 gradh = elem->grad2(&Node::depth);
 6121:       if constexpr(imm==2) {
 6122:          Vector3 ubed;
 6123: 
 6124:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6125:          // updateBDEF(ubed);
 6126:      
 6127:          // const double bflux0 = dot(ubed, elem_n1);
 6128: 
 6129:          // elem->w[kb] += ubed.z;
 6130:       }
 6131:       else {
 6132:          Vector2 umean;
 6133:          if constexpr(ics == 1) {
 6134:             u2meanBottom = elem->mean(kb, &Side::u2);
 6135:          }
 6136:          else {
 6137:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6138:          }
 6139: 
 6140:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6141:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6142: 
 6143:          bottomFlux = - dot(gradh, u2meanBottom);
 6144:       } // if imm
 6145: 
 6146:       // Compute w for kb+1 to nvrt-1
 6147:       for (int l = kb; l < nvrt - 1; l++) {
 6148: 
 6149:          // normal vector to the top face of the "volumetric" element (3D)
 6150:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6151: 
 6152:          // Compute the total flux at the sides
 6153:          double sideFlux = 0.0;
 6154: 
 6155:          for (int j = 0; j < elem->i34; j++) {
 6156:             const Side *side = elem->sides[j];
 6157: 
 6158:             const double sideArea = side->area(l);
 6159:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6160:             const double sign = elem->ssign[j]; 
 6161: 
 6162:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6163:          }
 6164:          
 6165:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6166:          //velocities at the centers of the sides
 6167:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6168: 
 6169:          // The flx at the top ace can be computed from the other flows.
 6170:          const double topFlux = - sideFlux - bottomFlux;
 6171:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6172: 
 6173:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6174: 
 6175:          elem_n1 = elem_n2;
 6176: 
 6177:          bottomFlux = - topFlux;
 6178:       }
 6179:    }  
 6180: 
 6181: 
 6182: 
 6183: 
 6184: 
 6185: 
 6186: 
 6187: // !===============================================================================
 6188: // !===============================================================================
 6189: 
 6190: } // extern "C"
 6191: 
 6192: #ifdef DONTCOMPILE
 6193: __device__ void computeVerticalAdvection(void) {
 6194:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6195: 
 6196:    sdbt(1:2,:,:)=0.d0
 6197: 
 6198:    const Side *side = FROM kernel;
 6199: 
 6200:    if(side->isDry) return;
 6201: 
 6202:    // If side is wet...
 6203: 
 6204: 
 6205:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6206:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6207:    double ws[nvrt] = {} // w @ side
 6208:    int icount = 0;
 6209:    for (int j=0; j<2; j++) {
 6210:       const Element *elem = side->elements[j];
 6211:        
 6212:       if(elem != nullptr) {
 6213:          icount++;
 6214:          for (int k=0; k<nvrt; k++) {
 6215:             ws[k] = ws[k] + elem->w[k];
 6216:          }
 6217:       }
 6218:    }  // for j
 6219: 
 6220:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6221:    ws = ws/icount;
 6222: 
 6223:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6224:    // Splines allow for a smooth transition between vertical levels.
 6225:    // Splines have continuity restrictions at the internal knots, but
 6226:    // we have to provide the 1st derivatives at the endpoints.
 6227:    const int kbs = side->kbs; 
 6228:    
 6229:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6230:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6231:    initCubicSpline(kbs, nvrt, side, ws, up)
 6232: 
 6233:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6234:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6235:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6236: 
 6237:    // Total advection (average onto side)
 6238:    const Node *node1 = side->nodes[0];
 6239:    const Node *node2 = side->nodes[1];
 6240:    for (int k=kbs(i); k<nvrt; k++) {
 6241: 
 6242:       if constexpr(ics==1) {
 6243:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6244:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6245:       } else {
 6246:          // XXX IMPLEMENT THIS
 6247:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6248:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6249:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6250:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6251:       }  // if ics
 6252: 
 6253: 
 6254:    }
 6255: }
 6256: #endif
 6257: 
 6258: 
 6259: extern "C" {
 6260:    __global__ void computeElemAverageGhat(void) {
 6261:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6262: 
 6263:       ELEM(elem);
 6264:       
 6265:       elem->ghat1= {0.0, 0.0};  
 6266: 
 6267:       if constexpr(ihydraulics != 0) {
 6268:          if (nhtblocks > 0 && elem->isblock) return;
 6269:       }
 6270: 
 6271: 
 6272: 
 6273:       
 6274:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6275:       // tidal potential, horizontal diffusion, and baroclinic etc
 6276:       // Remember to update both fb and F 
 6277:       // If ics=2, ghat1 are in eframe (ll)
 6278:       // cff1-3: coefficients for 2D/3D
 6279:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6280:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6281:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6282: 
 6283:       if (elem->isDry) return;
 6284: 
 6285:       double av_cff1 = 0.0;  // av. for cff1
 6286:       double av_cff2 = 0.0;  // av. for cff2
 6287:       double av_cff3 = 0.0;  // av. for cff3
 6288:       double av_df = 0.0;  // av. for H^\alpha / H
 6289:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6290:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6291: 
 6292:       const int i34 = elem->i34;
 6293:       const int kb = elem->kb;
 6294: 
 6295:       for (int j=0; j<i34; j++) {
 6296:          // For each node and side in the element...
 6297: 
 6298:          const Node *node = elem->nodes[j];
 6299:          const Side *side = elem->sides[j];
 6300: 
 6301:          const double chi      = side->chi;
 6302:          const double veg_c2   = side->veg_c2;
 6303:          const double veg_beta = side->veg_beta;
 6304:          const double veg_h    = side->veg_h();
 6305:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6306: 
 6307:          // Node - const in elem
 6308:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6309:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6310: 
 6311:          if (elem->depth >= tip_dp) {
 6312:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6313:          }
 6314: 
 6315:          
 6316:          const double htot  = side->htot2();        // Total depth at the side
 6317:          const double zctr2 = side->zTopCanopy();  
 6318: 
 6319:          double cff1; 
 6320:          double cff2; 
 6321:          double cff3;   
 6322:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6323:          // coefficients applied to 2D/3D case 
 6324:             cff1 = side->hhat/htot;
 6325:             cff2 = 0.0;
 6326:             cff3 = 0.0;
 6327:          } else { //3D
 6328:             //Init for no-veg case
 6329:             cff1 = 1.0;
 6330:             cff2 = 1.0;
 6331:             cff3 = 0.0;
 6332: 
 6333:             if constexpr(iveg != 0) {
 6334:                // Computes coefficients used with vegetation terms G1, G2
 6335:                // cff1, cff3 are used for the first two terms in G1, G2:
 6336:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6337:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6338:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6339:                if(veg_h < 0.99*htot) { // submergent vegetation
 6340:                   cff1=1;
 6341:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6342:                   cff3 = veg_c;
 6343: 
 6344:                } else { // emergent vegetation
 6345:                   cff1 = 1.0/(1.0 + veg_c2);
 6346:                   cff2 = cff1;
 6347:                   cff3 = 0.0;
 6348: 
 6349:                }
 6350:             } // if iveg
 6351:          } //  2D/3D
 6352: 
 6353:          av_cff1 += cff1/i34;
 6354:          av_cff2 += cff2/i34;
 6355:          av_cff3 += cff3/i34;
 6356:          av_cff2_chi += cff2*chi/i34;
 6357:          av_cff3_chi += cff3*chi/i34;
 6358:          av_df += min(htot, veg_h)/(htot*i34);
 6359: 
 6360: 
 6361:          // btrack values: U^\star, U^{\star\alpha}
 6362:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6363:          Vector2 Ustar       = {0.0, 0.0}; 
 6364:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6365: 
 6366:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6367:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6368:          } else { //3D
 6369:             for (int k = side->kb + 1; k < nvrt; k++) {
 6370:             
 6371:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6372:                Ustar += w2;
 6373: 
 6374:                if constexpr(iveg != 0) {
 6375:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6376:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6377:                        Ustar_alpha += zrat*w2; // XXXX
 6378:                    }
 6379:                }  // if iveg
 6380:             }  // for k
 6381:          }  //2D/3D
 6382:          
 6383: 
 6384:          // Add btrack & surface stress terms to \breve{G} first
 6385:          if constexpr(ics==1) {
 6386: 
 6387:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6388: 
 6389:          } else {
 6390:             assert(false && "computeElemAverageGhat: Not implemented");
 6391:             // XXX IMPLEMENT THIS
 6392:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6393:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6394:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6395:          }  // if ics
 6396: 
 6397:          // Surface and bottom stress terms
 6398:          if constexpr(ics==1) {
 6399:             const Vector2 tau    = side->tau();
 6400:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6401: 
 6402:             // Term for surface and bottom stress
 6403:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6404: 
 6405:          } else {
 6406:             assert(false && "computeElemAverageGhat: Not implemented");
 6407:             // XXX IMPLEMENT THIS
 6408:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6409:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6410:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6411:             // tau_x=(vn1+tt1)/2.d0
 6412:             // tau_y=(vn2+ss1)/2.d0
 6413:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6414:          }  // if ics
 6415: 
 6416:          
 6417: 
 6418:          // All terms in F,F^\alpha,f_b except baroclinic
 6419:          // F, f_b: all explicit terms excluding vegetation 
 6420:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6421:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6422:          const double coriolis = side->coriolis;
 6423:          Vector2 F  =  coriolis*side->U;  // F_x
 6424:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6425:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6426: 
 6427:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6428:             
 6429:             for (int k = side->kb; k < nvrt; k++) {
 6430:                if (zctr2 > side->zc[k-1]) {
 6431:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6432:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6433:                    Fa +=  coriolis*w2*zrat;
 6434:                } // if zctr2
 6435:             } // k
 6436:          } // iveg
 6437: 
 6438:          // Integrate horizontal viscosity force vertically
 6439:          for (int k=side->kb + 1; k<nvrt; k++) {
 6440:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6441: 
 6442:             F += levelHorVisc;
 6443: 
 6444:             // Vegetation term
 6445:             if constexpr(iveg!=0) {
 6446:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6447:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6448:                   Fa += levelHorVisc*zrat;
 6449:                } 
 6450:             } // if iveg
 6451:          } // for k
 6452: 
 6453:          fb += side->nuGradU[side->kb];
 6454: 
 6455:          // Add to ghat1
 6456:          if constexpr(ics==2) {
 6457:             assert(false && "computeElemAverageGhat: Not implemented");
 6458:             // XXX IMPLEMENT THIS
 6459:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6460:             // bigf1=vn1; bigf2=vn2
 6461:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6462:             // botf1=vn1; botf2=vn2
 6463:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6464:             // bigfa1=vn1; bigfa2=vn2
 6465:          } // if ics
 6466: 
 6467:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6468:       } // for j (nodes and sides)
 6469: 
 6470:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6471:          
 6472:       // Finish off terms in F, F^\alpha and f_b
 6473:       const double grav3 = elem->mean(&Node::grav2);
 6474:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6475: 
 6476: 
 6477:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6478:       for (int j=1; j<i34; j++) { 
 6479:          // For each side in the element...
 6480:          const Side *side = elem->sides[j];
 6481:          const double chi = side->chi;
 6482: 
 6483:          const double htot = side->htot2();
 6484:          const double veg_h = side->veg_h();
 6485:          const Vector2 F  = htot*fb;
 6486:          const Vector2 Fa = min(htot, veg_h)*fb;
 6487: 
 6488:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6489:       } // for j
 6490: 
 6491:       //botf1 etc are already in elem frame
 6492:       elem->ghat1 += tmp/i34;
 6493: 
 6494:       // Baroclinic force
 6495:       if constexpr(ibc==0) {
 6496:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6497: 
 6498:          Vector2 Fa = {0.0, 0.0};
 6499:          Vector2 intGradRho = {0.0, 0.0};
 6500:          
 6501:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6502:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6503:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6504: 
 6505:             // \in F [m^2/s/s]
 6506:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6507:          }
 6508: 
 6509:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6510:          const Vector2 F = av_df*Fa; //approx
 6511:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6512: 
 6513:       } // if ibc
 6514: 
 6515: 
 6516: 
 6517:    }
 6518: 
 6519: } // extern "C"
 6520: 
 6521: 
 6522: 
 6523: #ifdef DONTCOMPILE
 6524: __global__ void checkMassConservation(Tracers* sumtr) {
 6525: 
 6526:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6527: 
 6528:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6529: 
 6530:    Element *elem = &(mesh->localElemData[i]);
 6531: 
 6532:    // Skip dry elements
 6533:    if (elem->isDry) return;
 6534: 
 6535:    // Local sum array for this thread
 6536:    double localSum[N_TRACERS] = {0.0};
 6537: 
 6538:    // Sum over vertical levels for this element
 6539:    const int kbe = elem->kbe;
 6540:    const double area = elem->area;
 6541: 
 6542:    for (int k = kbe; k < nvrt; k++) {
 6543:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6544:       
 6545:       // Accumulate tracer mass
 6546:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6547:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6548:       }
 6549:    }
 6550: 
 6551:    //  This function returns per element sums. A reduction must be done on the host side.
 6552: }
 6553: 
 6554: 
 6555: __global__ void transport(void) {
 6556: 
 6557:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6558: 
 6559:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6560: 
 6561:    Element *elem = &(mesh->localElemData[ie]);
 6562: 
 6563:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6564: 
 6565:                for (int m=0; m<ntr; m++) {
 6566:                   for (int k=kbe(ie); k<nvrt; k++) {
 6567:                      // Calculate each polynomial's weight 
 6568:                      wm=0.d0; sum1=0.d0; 
 6569:                      wm1=0.d0; wm2=0.d0; 
 6570:                      for (int i=0; i<elem->nweno2; i++) {
 6571:                   
 6572:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6573:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6574:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6575:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6576:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6577:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6578:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6579:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6580:                      // -----------------Hu and Shu (1999)'s method----------------
 6581:                      b4=b1+b2+b3
 6582: 
 6583: //Error: add PRODUCTION CPP
 6584: #ifdef DEBUG
 6585:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6586:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6587:                     call parallel_abort(errmsg)
 6588:                   }
 6589: #endif
 6590: 
 6591:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6592:                   // !----test-------------- 
 6593:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6594:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6595:                   // !wm(i)=wm1(i)*wm2(i)
 6596:                   // !---------------------- 
 6597:                   sum1=sum1+wm(i)
 6598:                 } // end for i
 6599: 
 6600:                 wm=wm/sum1
 6601: 
 6602:                 for (int j=0; j<elem->i34; j++) {
 6603: 
 6604:                   const Side *side  = elem->sides[j];
 6605:                   const Node *node1 = side->n1;
 6606:                   const Node *node2 = side->n2;
 6607: 
 6608:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6609:                      trsd=0.d0
 6610:                      for (int kk=0; kk<nquad; kk++) {
 6611:                         for (int i=0; i<elem->nweno2; i++) {
 6612:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6613:                         } // end for i   
 6614:                      } // end for kk
 6615:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6616:                   } // outward flux
 6617:                } // end for j=1,i34(ie) ! side
 6618:             }
 6619:          }
 6620:               
 6621: 
 6622: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6623: //             //   calculate each polynomial's weight 
 6624: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6625: //                 wm=0.d0; sum1=0.d0
 6626: //                 do i=1,nweno1(ie) !for each polynomial
 6627: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6628: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6629: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6630: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6631: //                   wm(i)=b2
 6632: //                   sum1=sum1+b2
 6633: //                   !wm(i)=1.d0
 6634: //                   !sum1=sum1+1.d0
 6635: 
 6636: // // Error: PRODUCTION
 6637: // #ifdef DEBUG
 6638: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6639: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6640: //                     call parallel_abort(errmsg)
 6641: //                   endif
 6642: // #endif
 6643: 
 6644: //                 enddo !i
 6645: //                 wm=wm/sum1 !final weight
 6646: 
 6647:                 for (int j=0; j<elem->i34; j++) { // side
 6648:                   const Side *side = elem->sides[j];
 6649:                   const Node *node1 = side->n1;
 6650:                   const Node *node2 = side->n2;
 6651: 
 6652:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6653:                     trsd=0.d0
 6654:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6655:                       for (int i=0; i<elem->nweno1; i++) {
 6656:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6657:                       }
 6658:                     enddo //kk
 6659:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6660:                   } // outward flux
 6661:                 } // end for j=1,i34(ie) ! side
 6662:               } // end for k; ntr 
 6663: 
 6664:             else !simple upwind method
 6665:               do j=1,i34(ie)
 6666:                 jsj=elside(j,ie)
 6667:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6668:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6669:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6670:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6671:                   endif
 6672:                 enddo  !vertical layers
 6673:               enddo !j=1,i34(ie) ! side
 6674:             endif !order of accuracy
 6675: 
 6676:          //  enddo !ie
 6677: // !$OMP     end do
