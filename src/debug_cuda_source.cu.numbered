 2016: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2017: // return;   
 2018:    // Lock the mutex
 2019:    lock(&debugPlotMutex);
 2020:  
 2021:    bool ok = true;
 2022:    if (debugPlotIdx == nullptr) ok = false;
 2023:    if (*debugPlotIdx >= 1000000) ok = false;
 2024:    if (ok) {
 2025:       debugPlot[(*debugPlotIdx) + 0*1000000] = x1.x;
 2026:       debugPlot[(*debugPlotIdx) + 1*1000000] = x1.y;
 2027:       debugPlot[(*debugPlotIdx) + 2*1000000] = x2.x;
 2028:       debugPlot[(*debugPlotIdx) + 3*1000000] = x2.y;
 2029:       debugPlot[(*debugPlotIdx) + 4*1000000] = (double)color;
 2030:       debugPlot[(*debugPlotIdx) + 5*1000000] = (double)(((int)(unsigned char)marker & 0xFF) | ((dashLen & 0xFF) << 8) | ((width & 0xFF) << 16));
 2031:       debugPlot[(*debugPlotIdx) + 6*1000000] = (double)label;
 2032:       (*debugPlotIdx)++;
 2033:    }
 2034: 
 2035:    __threadfence();               // ensure all above writes are visible
 2036:    // Unlock the mutex
 2037:    unlock(&debugPlotMutex);
 2038: 
 2039: }
