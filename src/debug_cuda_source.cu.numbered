  712:    __device__ bool findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement, double &t, 
  713:                                         double& tIntersect);
  714: 
  715:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  716:       // Check if the point (xt,yt) is inside the element
  717:       double shpCoords[4];
  718: 
  719:       bool res = computeShapeCoords(xt, shpCoords, false);
  720: 
  721:       return res;
  722:    }
  723: 
  724:    __inline__ __device__ bool containsPoint(Vector2 &xt, bool fixCoords) const { 
  725:       // Check if the point (xt,yt) is inside the element.
  726:       // If fixCoords is true, and *the point is inside the element*, the point is nudged to be inside the element.
  727:       double shpCoords[4];
  728: 
  729:       Vector2 tmp_xt = xt;
  730:       bool res = computeShapeCoords(tmp_xt, shpCoords, fixCoords);
  731: 
  732:       if (fixCoords && res) xt = tmp_xt;
  733: 
  734:       return res;
  735:    }
  736: 
  737:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  738:    {
  739:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  740:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  741:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  742:       
  743:    }
