 2305: __device__ inline void atomicAddInt16Unsafe(int16_t* address, int16_t val)
 2306: {
 2307:     uintptr_t p = (uintptr_t)address;
 2308:     assert((p & 1) == 0);
 2309: 
 2310:     unsigned int* base = (unsigned int*)(p & ~3);
 2311:     unsigned int addend = (p & 2) ? ((unsigned int)val << 16)
 2312:                                   :  (unsigned int)val;
 2313: 
 2314:     atomicAdd(base, addend);
 2315: }
