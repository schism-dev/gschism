  420: 
  421: __forceinline__ __device__ void computeLatLon(Point3 const &p, double &rlat, double &rlon) {
  422: // Given a 3D global point (may not be on the surface of the Earth), find its longitude and latitude in radians
  423: //
  424: 
  425:    const double radius2 = dot(p, p);
  426:    const double radius = sqrt(radius2);
  427:  
  428:    assert(radius != 0.0      && "computeLatLon: radius = 0");
  429:    assert(p.z*p.z <= radius2 && "computeLatLon: p.z <= radius");
  430: 
  431:    rlon = atan2(p.y, p.x); // (-pi,pi]
  432: 
  433:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  434:       rlat = asin(p.z/radius);
  435:    } else {
  436:       rlat = asin(p.z/rearth_pole);
  437:    }
  438:   
  439: }
  440: 
  441: 
  442: __forceinline__ __device__ Point3 computeXYZfromLatLon(double lat, double lon) {
  443: // Compute the 3D Cartesian coordinates from the latitude and longitude
  444: // Inputs:
  445: //        lat: latitude in radians
  446: //        lon: longitude in radians
  447: // Output:
  448: //        x, y, z: 3D Cartesian coordinates
  449: 
  450:    double sin_lat, cos_lat, sin_lon, cos_lon;
  451: 
  452:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeXYZfromLatLon: lat out of range");
  453:    assert(lon >= -pi     && lon <= pi &&     "computeXYZfromLatLon: lon out of range");
  454: 
  455:    sincos(lat, &sin_lat, &cos_lat);
  456:    sincos(lon, &sin_lon, &cos_lon);
  457: 
  458:    const double x = rearth_eq*cos_lat*cos_lon;
  459:    const double y = rearth_eq*cos_lat*sin_lon;
  460:    const double z = rearth_pole*sin_lat;
  461: 
  462:    return make_double3(x, y, z);
  463: }
