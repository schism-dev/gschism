 7682: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7683:    Element *elems = mesh->localElemData;
 7684: 
 7685:    *addr = elems;
 7686:    *sizeElement = sizeof(Element);
 7687:    switch (varCode) {
 7688:       case (int)VarCode::z:
 7689:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7690:          *sizeType = sizeof(double);
 7691:          break;
 7692:       case (int)VarCode::x:
 7693:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7694:          *sizeType = sizeof(Vector2);
 7695:          break;
 7696:       case (int)VarCode::area:
 7697:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7698:          *sizeType = sizeof(double);
 7699:          break;
 7700:       case (int)VarCode::depth:
 7701:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7702:          *sizeType = sizeof(double);
 7703:          break;
 7704:       case (int)VarCode::radius:
 7705:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7706:          *sizeType = sizeof(double);
 7707:          break;
 7708:       case (int)VarCode::lonlat:
 7709:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 7710:          *sizeType = sizeof(double);
 7711:          break;
 7712:       case (int)VarCode::ghat:
 7713:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7714:          *sizeType = sizeof(Vector2);
 7715:          break;
 7716:       case (int)VarCode::kb:
 7717:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 7718:          *sizeType = sizeof(int);
 7719:          break;
 7720:       case (int)VarCode::isdry:
 7721:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 7722:          *sizeType = sizeof(int);
 7723:          break;            
 7724:       case (int)VarCode::w:
 7725:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 7726:          *sizeType = sizeof(double);
 7727:          break;
 7728:       case (int)VarCode::FaceIndices:
 7729:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 7730:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 7731:          *sizeType = sizeof(Node);
 7732:          break;
 7733:       default:
 7734:          *offset = -1;
 7735:    }
 7736: }
