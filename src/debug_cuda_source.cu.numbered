 7704: __global__ void getStructSizes(int* sizes)  {
 7705:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 7706:       sizes[0] = (int)sizeof(Node);
 7707:       sizes[1] = (int)sizeof(Element);
 7708:       sizes[2] = (int)sizeof(Side);
 7709:       sizes[3] = (int)sizeof(NodeBoundary);
 7710:       sizes[4] = (int)sizeof(SideBoundary);
 7711:       sizes[5] = (int)sizeof(BoundarySegment);
 7712: }
