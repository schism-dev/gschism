 7433: extern "C" __global__ void getElementVar(int varCode, double *var, int k = -1) {
 7434:    // Get the value of a variable from an element
 7435:    // varName is the name of the variable to get
 7436:    // var is the array to store the value
 7437:    // k is the vertical level index of the variable to get
 7438: 
 7439:    ELEM(elem);
 7440:    
 7441:    int idx = elem->idx;
 7442:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7443: 
 7444:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7445:    if      (varCode == (int)VarCode::w && k >= 0)       var[idx] = elem->w[k];
 7446:    else if (varCode == (int)VarCode::z && k >= 0)       var[idx] = elem->z[k];
 7447:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = elem->center.x;
 7448:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = elem->center.y;
 7449:    else if (varCode == (int)VarCode::area && k == -1)   var[idx] = elem->area;
 7450:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = elem->depth;
 7451:    else if (varCode == (int)VarCode::radius && k == -1) var[idx] = elem->radius;
 7452:    else if (varCode == (int)VarCode::xlon && k == -1)   var[idx] = elem->xlon;
 7453:    else if (varCode == (int)VarCode::ylat && k == -1)   var[idx] = elem->ylat;
 7454:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(elem->kb);
 7455:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7456:       
 7457:    
 7458: }
 7459: 
 7460: 
 7461: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7462:    // Get the value of a variable from an node
 7463:    // varName is the name of the variable to get
 7464:    // var is the array to store the value
 7465:    // k is the vertical level index of the variable to get
 7466: 
 7467:    NODE(node);
 7468:    
 7469:    int idx = node->idx;
 7470:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7471: 
 7472:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7473:    
 7474:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7475:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7476:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = node->p.y;
 7477:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7478:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7479:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7480:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;   
 7481:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7482:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7483:    else if (varCode == (int)VarCode::v && k >= 0)       var[idx] = node->u2[k].y;
 7484:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7485:       
 7486:    
 7487: }
 7488: 
 7489: 
 7490: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7491:    // Get the value of a variable from an side
 7492:    // varName is the name of the variable to get
 7493:    // var is the array to store the value
 7494:    // k is the vertical level index of the variable to get
 7495:    SIDE(side);
 7496:    
 7497:    int idx = side->idx;
 7498:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7499: 
 7500:    printf("getSideVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7501:    
 7502:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = side->zc[k];
 7503:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = side->center.x;
 7504:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = side->center.y;
 7505:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = side->u2[k].x;
 7506:    else if (varCode == (int)VarCode::v && k >= 0)       var[idx] = side->u2[k].y;
 7507:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = side->depth();
 7508:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(side->kb);
 7509:    else if (varCode == (int)VarCode::n1 && k == -1)     var[idx] = side->n1->idx;
 7510:    else if (varCode == (int)VarCode::n2 && k == -1)     var[idx] = side->n2->idx;
 7511:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = side->eta2();
 7512:    else if (varCode == (int)VarCode::btu && k >= 0)     var[idx] = side->btu[k].x;
 7513:    else if (varCode == (int)VarCode::btv && k >= 0)     var[idx] = side->btu[k].y;
 7514:    else if (varCode == (int)VarCode::bccx && k >= 0)    var[idx] = side->bcc[k].x;
 7515:    else if (varCode == (int)VarCode::bccy && k >= 0)    var[idx] = side->bcc[k].y;
 7516:    else if (varCode == (int)VarCode::ubc && k >= 0)     var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7517:    else if (varCode == (int)VarCode::vbc && k >= 0)     var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7518:    else if (varCode == (int)VarCode::uth && k >= 0)     var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7519:    else if (varCode == (int)VarCode::vth && k >= 0)     var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7520:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7521: }
