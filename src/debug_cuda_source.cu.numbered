 3641: // /**
 3642: //    For a point (x1,y1) inside the element and a line segment (x1,y1)-(x2,y2), find the intersection point 
 3643: //    (xIntersect,yIntersect) and the side (intersectingSide) that it intersects.
 3644: 
 3645: //    Inputs:
 3646: //    @param x1, y1: point inside the element
 3647: //    @param x2, y2: other end of the line segment
 3648: 
 3649: //    Outputs:
 3650: //    @param intersectingSide:  side that intersects the line segment
 3651: //    @param nextElement: element that contains the intersection point
 3652: //    @param xIntersect, yIntersect: intersection point  
 3653: 
 3654: //    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 3655: //    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 3656: //    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 3657: 
 3658: //    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 3659: //    (Delta) being zero.
 3660: 
 3661: //    The intersection point happens when:
 3662: //    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 3663: //    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 3664:    
 3665: //    Assumption: the 4 points (including those of the side segment) are different.
 3666: //    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 3667: //    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 3668: //    If true, (xIntersect,yIntersect) is the intersection.				
 3669: //    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 3670: // **/
 3671: // __inline__ __device__ bool Element::findPathIntersection(double x1, double y1, double x2, double y2, 
 3672: //                                                          Side& intersectingSide, Element& nextElement,
 3673: //                                                          double& xIntersect, double& yIntersect) {
 3674: //    for (int i = 0; i < i34; i++) {
 3675: //       const double x3 = nodes[i]->x;
 3676: //       const double y3 = nodes[i]->y;
 3677: //       const double x4 = nodes[nxq(i+1)]->x;
 3678: //       const double y4 = nodes[nxq(i+1)]->y;
 3679: 
 3680: //       const Side& side = sides[i];
 3681: 
 3682: //       xIntersect=-1.e25;
 3683: //       yIntersect=-1.e25;
 3684: 
 3685: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 3686: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 3687: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 3688: 
 3689: //       if (delta != 0.0) {
 3690: //          // Solves the two linear equations for tt1 and tt2
 3691: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 3692: //          const double tt2 = delta2/delta;
 3693: 
 3694: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 3695: //          // Similarly, we use tt2 to compute the intersection point.
 3696: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 3697: //             xIntersect = x3 + (x4 - x3)*tt2;
 3698: //             yIntersect = y3 + (y4 - y3)*tt2;
 3699: 
 3700: //             intersectingSide = side;
 3701: //             nextElement = nghbElems[i];
 3702: 
 3703: //             return true;
 3704: //          }
 3705:       
 3706: //       }
 3707: //       else {
 3708: //          // The two segments are parallel
 3709: //          return false;
 3710: //       }
 3711: 
 3712: //    }
 3713: 
 3714: //    return false;
 3715: 
 3716: // }
