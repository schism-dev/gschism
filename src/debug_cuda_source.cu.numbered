 6551: __global__ void computeMatrixProductAndDotProducts() {
 6552:    // Computes A*p, r'Mr and p'Ap
 6553: 
 6554:    // 1) shared buffer: first half for rMr, second for pAp
 6555:    __shared__ double sdata[2*BLOCK_SIZE];
 6556:    double* s_rMr = sdata;
 6557:    double* s_pAp = sdata + BLOCK_SIZE;
 6558: 
 6559:    s_rMr[threadIdx.x] = 0.0;
 6560:    s_pAp[threadIdx.x] = 0.0;
 6561: 
 6562:    // 2) get your node pointer
 6563:    NODE(node);  
 6564:    const int tid = threadIdx.x;
 6565: 
 6566:    const double diag = node->coeffDiag;
 6567:    const double r    = node->mR;
 6568:    const double p    = node->mP;  
 6569: 
 6570:    // apply preconditioner on the fly:
 6571:    const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 6572: 
 6573:    // 4) compute Ap = A.p
 6574:    double Ap = node->coeffDiag * node->mP;
 6575:    for (int j = 0; j < node->numNodes; ++j) {
 6576:       const Node *nbNode = node->nodes[j];
 6577:       Ap += node->coeffMatrix[j] * nbNode->mP;
 6578: 
 6579:    }
 6580:    node->mAp = Ap;
 6581:     
 6582: 
 6583:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 6584:    const double l_rMr = r*Mr;  // r'Mr
 6585:    const double l_pAp = p*Ap;  // p'Ap
 6586: 
 6587:    // 6) write into shared mem
 6588:    s_rMr[tid] = l_rMr;
 6589:    s_pAp[tid] = l_pAp;
 6590: 
 6591:    __syncthreads();
 6592: 
 6593:    // 7) block-wide tree reduction
 6594:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 6595:       if (tid < stride)  s_pAp[tid] += s_pAp[tid + stride];
 6596:       __syncthreads();
 6597:    }
 6598: 
 6599:    // 8) thread 0 atomically accumulates into the globals
 6600:    // XXX: This is slower than it needs to be, but it is simple and works
 6601:    if (tid == 0) atomicAdd(pAp, s_pAp[0]);
 6602: 
 6603: 
 6604: }
 6605: 
 6606: 
 6607: __global__ void updateSolutionAndDotProducts(void) {
 6608:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 6609: 
 6610:    s_rMr[threadIdx.x] = 0.0;
 6611: 
 6612: 
 6613:    // get node & bounds-check:
 6614:    NODE(node);
 6615:    const int tid = threadIdx.x;
 6616: 
 6617: 
 6618:    // Compute alpha
 6619:    const double alpha = (*rMr_old)/(*pAp);
 6620: 
 6621:    // load scalars
 6622:    const double diag = node->coeffDiag;
 6623:    const double p    = node->mP;
 6624:    const double Ap   = node->mAp;
 6625:    const double x    = node->mX;
 6626:    const double r    = node->mR;
 6627:    
 6628:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 6629: 
 6630:    // 1) update solution & residual
 6631:    const double x_new = x + alpha*p;
 6632:    const double r_new = r - alpha*Ap;
 6633:    node->mX = x_new;
 6634:    node->mR = r_new;
 6635: 
 6636:    // 2) apply Jacobi preconditioner on the fly
 6637:    const double Mr_new = r_new/diag;
 6638: 
 6639: 
 6640:    // 3) local contributions for the two dot-products
 6641:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 6642: 
 6643:    // 4) write into shared-mem
 6644:    s_rMr[tid] = l_rMr;
 6645: 
 6646:    __syncthreads();
 6647: 
 6648: 
 6649:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 6650:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 6651:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 6652:       __syncthreads();
 6653:    }
 6654: 
 6655:    // 6) thread 0 atomically folds into the global accumulators
 6656:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 6657: 
 6658: 
 6659: }
 6660: 
 6661: 
 6662: __global__ void updateSearchDirection() {
 6663:     NODE(node);
 6664: 
 6665:     // recompute z on-the-fly
 6666:     const double z = node->mR / node->coeffDiag;
 6667:     const double p = node->mP;
 6668: 
 6669:     const double beta = (*rMr_new)/(*rMr_old);
 6670: 
 6671: // printf("ZZZ updateSearchDirection: beta = %f\n", beta);
 6672: 
 6673:     // p =z + beta*p
 6674:     node->mP = z + beta*p;
 6675: 
 6676: }
 6677: 
 6678: __global__ void initializePreconditionedResidual(double *scalars) {
 6679: 
 6680:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 6681: 
 6682:     s_rMr[threadIdx.x] = 0.0;
 6683: 
 6684:     NODE(node);
 6685:     const int tid = threadIdx.x;
 6686:     // For the first iteration:
 6687:     // 1. Initial solution x = 0 (already set)
 6688:     // 2. Initial residual r = b (stored in qel)
 6689:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 6690: 
 6691: // XXX we should use the guess solution here    
 6692: 
 6693:     // Set initial residual r = b (from qel)
 6694:     node->mR = node->qel;
 6695: 
 6696:     // Compute z = M^-1 * r (preconditioned residual)
 6697:     const double z = node->mR / node->coeffDiag;
 6698: 
 6699:     // Set initial search direction p = z
 6700:     node->mP = z;
 6701: 
 6702:     // Initialize other variables needed for CG
 6703:     node->mX = 0.0;  // Initial solution
 6704:     node->mAp = 0.0; // Will be computed in first iteration
 6705: 
 6706:     // These point to a cupy array in the host code
 6707:     rMr_old = scalars + 0;
 6708:     rMr_new = scalars + 1;
 6709:     pAp     = scalars + 2;
 6710: 
 6711:     // Computes the first r'Mr (reduction)
 6712:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 6713: 
 6714:     // 4) write into shared-mem
 6715:     s_rMr[tid] = l_rMr;
 6716: 
 6717:     __syncthreads();
 6718: 
 6719: 
 6720:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 6721:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 6722:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 6723:         __syncthreads();
 6724:     }
 6725: 
 6726:     // 6) thread 0 atomically folds into the global accumulators
 6727:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 6728: 
 6729:     *rMr_old = 0.0;
 6730:     *pAp = 0.0;
 6731: }
