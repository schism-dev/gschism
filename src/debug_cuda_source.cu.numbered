 1582: __device__ void lock(int *mutex) {
 1583:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 1584: }
 1585: 
 1586: __device__ void unlock(int *mutex) {
 1587:     atomicExch(mutex, 0);
