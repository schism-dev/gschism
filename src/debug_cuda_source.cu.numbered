 7699: __global__ void returnMatrix(double *res) {
 7700:    // Debugging: returns the matrix as a CuPy array
 7701: 
 7702:    const int size = mesh->np;
 7703:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7704:       const Node *node = mesh->localNodeData + idx_node;
 7705:       res[idx_node*size + idx_node] = node->coeffDiag;
 7706:       for (int j = 0; j < node->numNodes; j++) {
 7707:          Node* nbNode = node->nodes[j];
 7708:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7709:       }
 7710: 
 7711:    }
 7712:    
 7713: }
 7714: 
