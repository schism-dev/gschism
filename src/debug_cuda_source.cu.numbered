 1665:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1666:       // Compute the different time ramps used in the code 
 1667:       // This function is performed by just one thread
 1668: 
 1669:       rampbc = 1.0;
 1670:       if constexpr(ibc == 0) {
 1671:          if (drampbc > 0.0) {
 1672:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1673:          } else {
 1674:             rampbc = 1.0;
 1675:          }
 1676:       }
 1677: 
 1678:       if (nws != 0) {
 1679:          if (drampwind > 0.0) {
 1680:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1681:          } else {
 1682:             rampwind = 1.0;
 1683:          }
 1684:       }
 1685: 
 1686:       if (drampwafo > 0.0) {
 1687:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1688:       } else {
 1689:          rampwafo = 1.0;
 1690:       }
 1691: 
 1692:       // For source/sinks
 1693:       if (if_source && dramp_ss > 0.0) {
 1694:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1695:       } else {
 1696:          ramp_ss = 1.0;
 1697:       }
 1698: 
 1699:       if (dramp > 0.0) {
 1700:          ramp = tanh(2.0*time/86400.0/dramp);
 1701:       } else {
 1702:          ramp = 1.0;
 1703:       }
 1704: 
 1705: 
 1706:    }
