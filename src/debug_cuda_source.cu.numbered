 2123: 
 2124: /**
 2125:    Compute the shape coordinates of the point (xt,yt) in the element.
 2126:    @param xt (input): x-coordinate of the point
 2127:    @param shpCoords (output): shape coordinates of the point
 2128:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2129:    @return true if the point is inside the element, false otherwise
 2130: **/
 2131: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2132:                                             bool fixNegshpCoord) const {
 2133: 
 2134:    // Compute the shape coordinates of the point xt in the element.
 2135:    if (i34==3) {
 2136:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2137:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2138:       // and in this case, the pt will be nudged into the element
 2139:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2140:       // from the local frame, so use additional check.
 2141: 
 2142:       Point2 x0, x1, x2;
 2143: 
 2144:       if constexpr(ics==1) {
 2145:          x0 = nodes[0]->p2();
 2146:          x1 = nodes[1]->p2();
 2147:          x2 = nodes[2]->p2();
 2148:       }
 2149:       else // lat/lon
 2150:       {
 2151:          Error("Not implemented yet");
 2152: #ifdef ICS2
 2153:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2154:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2155:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2156: #endif
 2157:       }
 2158: 
 2159:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2160:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2161:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2162:       shpCoords[3] = 0.0;
 2163:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2164: 
 2165:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2166:       // then we fix the negative shape coordinates.
 2167:       if (fixNegshpCoord && tmpmin<=0.0) {
 2168: 
 2169:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2170:          // keeping the sum of the shape coordinates equal to 1.
 2171:          // I have tested and compared the new algorithm with the old one, and they give
 2172:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2173:          // The new algorithm should be faster since it is branchless.
 2174:          const double a = - tmpmin + 1.0e-2;  // XXX it used to be 1.0e-4 in the comments of the original code
 2175:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2176:          
 2177:          shpCoords[0] = (shpCoords[0] + a)*b;
 2178:          shpCoords[1] = (shpCoords[1] + a)*b;
 2179:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2180: 
 2181:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2182:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2183:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2184:          }
 2185: 
 2186:          // Update the point coordinates for the new shape coordinates
 2187:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2188:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2189:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2190: 
 2191:       }
 2192: 
 2193:       // Check if the point is inside the element
 2194:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2195:    }
 2196:    else {
 2197:       Error("Not implemented yet");
 2198: #ifdef QUADS
 2199:       // Reproject pt in eframe of nel for ics=2
 2200:       if constexpr(ics==1) {
 2201:          xn2 = xt; 
 2202:          yn2 = yt;
 2203:       }
 2204:       else {
 2205:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2206:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2207:       }
 2208: 
 2209:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2210: #endif
 2211:    }
 2212: 
 2213:    return false;  // Never reached
 2214: 
 2215: }
 2216: 
 2217: 
 2218: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2219: // Convert shape coordinates to cartesian coordinates
 2220: 
 2221:    if (i34 == 3) {
 2222:       // Triangular element
 2223:       double xcoords[3] = {nodes[0]->p2().x, nodes[1]->p2().x, nodes[2]->p2().x};
 2224:       double ycoords[3] = {nodes[0]->p2().y, nodes[1]->p2().y, nodes[2]->p2().y};
 2225:    }
 2226:    else {
 2227:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2228:    }
 2229: 
 2230: }
 2231: 
 2232: 
 2233: /**  Interpolate velocities at a given point (xt,yt,zt)
 2234: 
 2235:    @param xt, yt, zt: coordinates of the point to interpolate
 2236:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2237: 
 2238:    This is done in four steps:
 2239: 
 2240:    1. Find the shape coordinates for the final position in the element.
 2241:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2242:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2243:       z levels at xt, yt at each step.   
 2244:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2245:       horizontally and vertically.
 2246: **/
 2247: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2248:    // Interpolate the velocities at the point xt. 
 2249:    // This function works the same for triangular and quadrilateral elements.
 2250:    double shpCoord[4];
 2251: 
 2252: printf(" ___BBB02____ idx = %d, u_int = %.17g,%.17g,%.17g, u1 = %.17g,%.17g,%.17g, u2 = %.17g,%.17g,%.17g, u3 = %.17g,%.17g,%.17g\n", idx, u_int.x, u_int.y, u_int.z, nodes[0]->u2[0].x, nodes[0]->u2[0].y, nodes[0]->u2[0].z, nodes[1]->u2[0].x, nodes[1]->u2[0].y, nodes[1]->u2[0].z, nodes[2]->u2[0].x, nodes[2]->u2[0].y, nodes[2]->u2[0].z);         
 2253:    // First step is to compute the shape coordinates of (xt,yt)
 2254:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2255:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2256: 
 2257:    // Second step is to find the level that contains zt
 2258:    // Uses a binary search to find the level
 2259:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2260:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2261:    int R = nvrt - 1;
 2262: 
 2263:    // Get the z coordinates at the nodes of the element at the levels L and R
 2264:    double zLAtNodes[4], zRAtNodes[4];
 2265:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2266:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2267: 
 2268:    double zL = interpolate(shpCoord, zLAtNodes);
 2269:    double zR = interpolate(shpCoord, zRAtNodes);
 2270:    
 2271:    // Interpolates vertically the velocities
 2272:    double wght1, wght2;
 2273:    if (xt.z<=zL) {
 2274:       wght1 = 1.0;
 2275:       wght2 = 0.0;
 2276:    }
 2277:    else if (xt.z>=zR) {
 2278:       wght1 = 0.0;
 2279:       wght2 = 1.0;
 2280:    }
 2281:    else {
 2282:       // Perform a binary search to find the levels between L and R that contain xt.z
 2283:       while (R - L > 1) {
 2284:          int M = (L + R) / 2;
 2285: 
 2286:          double zMAtNodes[4];
 2287:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2288:          double zM = interpolate(shpCoord, zMAtNodes);
 2289:          if (zM < xt.z) 
 2290:          {
 2291:             L = M;
 2292:             zL = zM;
 2293:          }
 2294:          else 
 2295:          {
 2296:             R = M;
 2297:             zR = zM;
 2298:          }
 2299:       }
 2300:       assert(L == R-1);
 2301:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2302: 
 2303:       wght2 = (xt.z - zL)/(zR - zL);
 2304:       wght1 = 1.0 - wght2;
 2305:    }
 2306: 
 2307:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2308:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 2309: 
 2310: Vector3 u1 = wght1*interpolate(L, shpCoord, &Node::u2);
 2311: Vector3 u2 = wght2*interpolate(R, shpCoord, &Node::u2);
 2312: printf("L = %d, R = %d, Element = %d\n", L, R, idx);
 2313: // printf("node1 (%.17g,%.17g), node2 (%.17g,%.17g,%), node3 (%.17g,%.17g)\n", nodes[0]->p2().x, nodes[0]->p2().y, nodes[1]->p2().x, nodes[1]->p2().y, nodes[2]->p2().x, nodes[2]->p2().y);
 2314: printf("element = %d, idx = %d, u_n1 = %.17g,%.17g,%.17g\n", idx, nodes[0]->idx, nodes[0]->u2[L].x, nodes[0]->u2[L].y, nodes[0]->u2[L].z);
 2315: printf("element = %d, idx = %d, u_n2 = %.17g,%.17g,%.17g\n", idx, nodes[1]->idx, nodes[1]->u2[L].x, nodes[1]->u2[L].y, nodes[1]->u2[L].z);
 2316: printf("element = %d, idx = %d, u_n3 = %.17g,%.17g,%.17g\n", idx, nodes[2]->idx, nodes[2]->u2[L].x, nodes[2]->u2[L].y, nodes[2]->u2[L].z);
 2317: printf("element = %d, idx = %d, u_n1 = %.17g,%.17g,%.17g\n", idx, nodes[0]->idx, nodes[0]->u2[R].x, nodes[0]->u2[R].y, nodes[0]->u2[R].z);
 2318: printf("element = %d, idx = %d, u_n2 = %.17g,%.17g,%.17g\n", idx, nodes[1]->idx, nodes[1]->u2[R].x, nodes[1]->u2[R].y, nodes[1]->u2[R].z);
 2319: printf("element = %d, idx = %d, u_n3 = %.17g,%.17g,%.17g\n", idx, nodes[2]->idx, nodes[2]->u2[R].x, nodes[2]->u2[R].y, nodes[2]->u2[R].z);
 2320: printf("element = %d, idx = %d, u_int = %.17g,%.17g,%.17g\n", idx, u_int.x, u_int.y, u_int.z);   
 2321: printf("u1 = %.17g,%.17g,%.17g\n", u1.x, u1.y, u1.z);   
 2322: printf("u2 = %.17g,%.17g,%.17g\n", u2.x, u2.y, u2.z);   
 2323: if(!(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z))) {u_int = {0.0, 0.0, 0.0}; return;}
 2324: 
 2325:    // Neither of the interpolated velocities should be NaN
 2326:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2327: 
 2328: }
 2329: 
 2330: 
