 3630: __device__ __inline__ void Node::updateZCoordData(void) {
 3631: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3632: 
 3633:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3634:    // if (isDry2()) {
 3635:    //    kb = -1;  // XXXXXXXX KKKKK
 3636:    //    return;
 3637:    // }
 3638: 
 3639: 
 3640:    if constexpr(ivcor == 2) {  // SZ coordinates
 3641:       
 3642:       // Compute bottom level index
 3643:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3644:    } 
 3645:    else {  // if (ivcor == 1) Localized sigma
 3646:       // Do nothing
 3647:    }
 3648: 
 3649: 
 3650: }
 3651: 
 3652: 
 3653: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3654:    // Computes the z coordinate at level k.
 3655:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3656:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3657:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3658:    // used 
 3659: 
 3660:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3661:    
 3662:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3663: 
 3664:    if (isDry2()) return 0.0;  
 3665: 
 3666:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3667: 
 3668:    if constexpr(ivcor == 2) {
 3669: 
 3670:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3671:       const double h_c = mesh->h_c;
 3672:       const double theta_f = mesh->theta_f;
 3673:       const double sinh_theta_f = mesh->sinh_theta_f;
 3674: 
 3675: 
 3676:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3677:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3678:       // once per time step/node. XXXX
 3679:       // CHECK: updateZCoordData
 3680: 
 3681:       //  To simplify comparisons, I define index versions of count variables.
 3682:       if      (k == ivrt)     return eta2; 
 3683:       else if (k == izlev)    return -hmod2;
 3684:       else if (k == kb)       return -depth;
 3685:       else if (k < izlev)     return mesh->ztot[k];
 3686:       else if (k > izlev) {
 3687:          const int ksig = k - izlev;
 3688: 
 3689:          if (hmod2 <= h_c) {
 3690:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3691: 
 3692:          } 
 3693:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3694:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3695:             assert(false && "compZCoord: invalid h_c\n");
 3696:          } 
 3697:          else {
 3698:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3699:                    h_c * mesh->sigma[ksig] + 
 3700:                    (hmod2 - h_c) * mesh->cs[ksig];
 3701:          }
 3702:       } else { 
 3703:          assert(false && "compZCoord: invalid level or coordinate system\n");
 3704:       }
 3705: 
 3706:    }
 3707:    else {  // if constexpr(ivcor == 1)
 3708:       if (k <= kb)        return -depth; 
 3709:       else if (k == ivrt) return eta2;
 3710:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3711: 
 3712:    }
 3713:    
 3714:    assert(false && "compZCoord: invalid level or coordinate system\n");
 3715:    return 0.0;
 3716: }
 3717: 
 3718: 
 3719: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3720:    // Computes the bottom drag Cd based on the selected nchi
 3721: 
 3722:    if constexpr(nchi == 0) {
 3723:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3724:       Cd = drag;  // Read from drag file
 3725: 
 3726:    } else if constexpr(nchi == 1) {
 3727:       // 
 3728: 
 3729:       bool ltmp = false; // for WBL iteration
 3730: 
 3731:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3732:       if (isDry || (rough == 0.0)) {
 3733:          Cd = 0.0;
 3734: 
 3735:       } else { //roughness >0 
 3736:          
 3737:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3738: 
 3739:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3740: 
 3741:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3742: 
 3743:       } // if rough
 3744: 
 3745:    } else if constexpr(nchi == -1) {
 3746:    // Manning 
 3747:  
 3748:       const double htot = max(hmin_man, htot2()); 
 3749:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3750: 
 3751:    } else {
 3752:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3753:       
 3754:    } // if nchi
 3755: 
 3756: }
 3757: 
 3758: 
 3759: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3760:    // Checks if a side in on the boundary
 3761:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3762: 
 3763:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3764:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3765: 
 3766:    // Indices of the nodes that form the side
 3767:    //
 3768:    // NOTE: This function is slow. It's to be called from "populate" functions, not from the main loop.
 3769:    const int n1 = side.n1->idx;
 3770:    const int n2 = side.n2->idx;
 3771:    isLand = false;
 3772:    
 3773: 
 3774:    // Check if the side is on a land boundary
 3775:    for (int i = 0; i < nland; i++) {
 3776:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3777:          // Consecutive nodes in the land boundary segment
 3778:          const int b1 = ilnd[i + j*nland];
 3779:          const int b2 = ilnd[i + (j + 1)*nland];
 3780: 
 3781:          assert(b1 != -1 && b2 != -1);
 3782: 
 3783:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3784:             
 3785:             isLand = true;
 3786:             return i;
 3787:          }
 3788:       }
 3789:    }
 3790: 
 3791:    // Check if the side is on an open boundary
 3792:    for (int i = 0; i < nope; i++) {
 3793:       for (int j = 0; j < nond[i] - 1; j++) {
 3794:          // Consecutive nodes in the open boundary segment
 3795:          const int b1 = iond[i + j*nope];
 3796:          const int b2 = iond[i + (j + 1)*nope];
 3797: 
 3798:          assert(b1 != -1 && b2 != -1);
 3799: 
 3800:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3801:             isLand = false;
 3802:             return i;
 3803:          }
 3804:       }
 3805:    }
 3806: 
 3807:    // Check that the nodes are not both on the boundary
 3808:    assert( (side.n1->nodeBnd == nullptr || side.n2->nodeBnd == nullptr)
 3809:         && "side not in ilnd/iond but both nodes are boundary" );
 3810: 
 3811:    return -1;
 3812: }
 3813: 
 3814: 
 3815: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3816:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3817:                                     double *wind_rotate_angle, 
 3818:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3819:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3820:                                     int *localNodeNeighNodesStart, int *localNodeNeighElemsStart, 
 3821:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3822:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3823:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3824:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 3825: 
 3826:    NODE(pnode);  
 3827:    const int i = idx_node;
 3828:    const int iglobal = globalNodeIndices[i];
 3829:    Node &node(*pnode);
 3830: 
 3831:    node.idx = iglobal;
 3832: 
 3833:    // It is important to differentiate between the global and local "start" indices because they
 3834:    // play different, but related, roles in this code. The global "start" indices are used
 3835:    // for the CSR-like indexing of the node and element neighbor arrays in the "global"
 3836:    // (unpartitioned) mesh. The local "start" indices are used for the CSR-like indexing of the 
 3837:    // node and element neighbor arrays in the "local" (partitioned) mesh.
 3838:    const int idxNodeStart = nodeNeighNodesStart[iglobal];
 3839:    const int idxNodeEnd   = nodeNeighNodesStart[iglobal + 1];
 3840:    const int idxNodeLocalStart = localNodeNeighNodesStart[i];
 3841:    node.numNodes = idxNodeEnd - idxNodeStart;
 3842:    node.nodes = nodeNeighNodes + idxNodeLocalStart;
 3843:    node.coeffMatrix = coeffMatrixMem + idxNodeLocalStart;
 3844: 
 3845:    const int idxElemStart = nodeNeighElemsStart[iglobal];
 3846:    const int idxElemEnd   = nodeNeighElemsStart[iglobal + 1]; 
 3847:    const int idxElemLocalStart = localNodeNeighElemsStart[i];
 3848:    node.numElements = idxElemEnd - idxElemStart;
 3849:    node.elements = nodeNeighElems + idxElemLocalStart;
 3850: 
 3851: 
 3852:    for (int idx = idxNodeStart, idxLocal = idxNodeLocalStart; idx < idxNodeEnd; idx++, idxLocal++) {
 3853:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3854:       const int partNode = localNodePart[idxNodeGlobal]; 
 3855:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3856: 
 3857:       Node *node_ptr = nodes[partNode] + idxNode;
 3858:       
 3859:       nodeNeighNodes[idxLocal] = node_ptr;
 3860:    }
 3861: 
 3862: 
 3863:    for (int idx = idxElemStart, idxLocal = idxElemLocalStart; idx < idxElemEnd; idx++, idxLocal++) {
 3864:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3865:       const int partElem = localElemPart[idxElemGlobal];
 3866:       const int idxElem  = localElemIndices[idxElemGlobal];
 3867: 
 3868:       Element *elem_ptr = elems[partElem] + idxElem;
 3869: 
 3870:       nodeNeighElems[idxLocal] = elem_ptr;
 3871:    }      
 3872: 
 3873:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 3874:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 3875: 
 3876:    sincosf(-(float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 3877: 
 3878:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 3879:    if constexpr(ics == 1) {
 3880:       node.p.x   = node_coords[i * 3];
 3881:       node.p.y   = node_coords[i * 3 + 1];
 3882:       node.gz = 0.0;
 3883: 
 3884:       if (use_ll) {                                    // <-- add
 3885:          node.lon = node_coords_ll[i * 2    ]*deg2rad; // <-- add
 3886:          node.lat = node_coords_ll[i * 2 + 1]*deg2rad; // <-- add
 3887:       }  
 3888: 
 3889:    } else {
 3890:       const double lon = deg2rad*node_coords[i * 3];
 3891:       const double lat = deg2rad*node_coords[i * 3 + 1];
 3892: 
 3893:       Point3 p = computeXYZfromLatLon(lat, lon);
 3894:       node.p = toVector2(p);
 3895:       node.gz = p.z;
 3896:       node.lon = lon;
 3897:       node.lat = lat;
 3898: 
 3899:       #ifdef USE_FRAMES
 3900:       node.setFrame(lat, lon);
 3901:       #endif
 3902: 
 3903: 
 3904:    }
 3905: 
 3906:    node.depth = node_coords[i * 3 + 2];
 3907: 
 3908:    node.numSides = 0;
 3909: 
 3910:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3911:    if      constexpr(nchi ==  0) node.drag     = drag[iglobal];
 3912:    else if constexpr(nchi ==  1) node.rough    = roughness[iglobal];
 3913:    else if constexpr(nchi == -1) node.rmanning = rmanning[iglobal];
 3914:    else assert(false && "populateNodes: selected nchi not implemented.");
 3915: 
 3916:    if constexpr(ivcor == 1) 
 3917:    {  
 3918:       node.kb = kb[iglobal];
 3919: 
 3920:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + iglobal*nvrt];
 3921:    }
 3922: 
 3923:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3924:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3925:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3926: 
 3927:    
 3928:    // Links the node to the boundary information
 3929:    if (isbnd[iglobal] >= 0) {
 3930:      
 3931:       // Get the index of the node boundary
 3932:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3933: 
 3934:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3935:       node.nodeBnd->node = &node;
 3936: 
 3937:       node.nodeBnd->sideBnd1 = nullptr;
 3938:       node.nodeBnd->sideBnd2 = nullptr;
 3939: 
 3940:       if (isbnd[iglobal]>=0) {
 3941: 
 3942:          node.nodeBnd->segment = &(localSegmentMem[isbnd[iglobal]]);
 3943:          
 3944:          node.nodeBnd->segment->ifltype = 0; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3945:          node.nodeBnd->segment->iettype = 0; // XXXXXXXXX
 3946: 
 3947:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3948:          node.nodeBnd->segment->clen  = nan("1");
 3949:          node.nodeBnd->segment->carea = nan("1");
 3950: 
 3951:       }
 3952:    } else {
 3953: 
 3954:       node.nodeBnd = nullptr; // For internal nodes
 3955: 
 3956:       if (isbnd[iglobal] == landSegment) {
 3957:          node.nodeBnd = landBoundaryNode;
 3958:          node.nodeBnd->segment = landBoundarySegment;
 3959:       }
 3960:       
 3961:    }
 3962:    
 3963:    // XXXX GAUSSIAN HILL VELOCITIES
 3964:    #ifdef GAUSSIAN_HILL_VELOCITIES
 3965:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3966:          constexpr double rot_per = 3000.0;
 3967:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3968:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3969:       // XXXXX
 3970:    #endif
 3971: 
 3972: }
 3973: 
 3974: 
 3975: 
 3976: 
 3977: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3978:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3979:                                     double *wind_rotate_angle,   
 3980:                                     int *isdel, int *isidenode, int *isbnd,
 3981:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3982:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3983:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3984:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3985:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3986:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3987:                                     double *drag, double *roughness) {
 3988: 
 3989: 
 3990:    SIDE(pside);
 3991:    Side &side(*pside);
 3992:    const int i = idx_side;
 3993:    const int iglobal = globalSideIndices[i];
 3994:    side.idx = iglobal;  
 3995:    
 3996:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3997:    const double fc   = 2.0*omega_e*sin(sfea0);
 3998:    const double beta = 2.0*omega_e*cos(sfea0);
 3999: 
 4000:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 4001: 
 4002:    // finding the pointer to the nodes that form the side
 4003:    const int idx_n1 = isidenode[iglobal*2];
 4004:    const int idx_n2 = isidenode[iglobal*2 + 1];
 4005: 
 4006: if (i % 100 == 0) printf("populateSides: iglobal = %d, idx_n1 = %d, idx_n2 = %d\n", iglobal, idx_n1, idx_n2);
 4007: 
 4008:    const int locidx_n1 = localNodeIndices[idx_n1];
 4009:    const int locidx_n2 = localNodeIndices[idx_n2];
 4010:    const int part_n1 =   localNodePart[idx_n1];
 4011:    const int part_n2 =   localNodePart[idx_n2];
 4012: 
 4013: if (i % 100 == 0) printf("populateSides: i = %d, part_n1 = %d, part_n2 = %d, locidx_n1 = %d, locidx_n2 = %d\n", i, part_n1, part_n2, locidx_n1, locidx_n2);
 4014: if (i % 100 == 0) printf("populateSides: i = %d, nodes[part_n1] = %p, nodes[part_n2] = %p\n", i, mesh->nodes[part_n1], mesh->nodes[part_n2]);
 4015: 
 4016:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 4017:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 4018: // return;
 4019: if (i % 100 == 0) printf("populateSides: 1, i = %d, side.n1 = %p, side.n2 = %p\n", i, side.n1, side.n2);
 4020: 
 4021:    // Counts the number of sides connected to each node
 4022:    atomicAdd(&side.n1->numSides, 1);
 4023:    atomicAdd(&side.n2->numSides, 1);
 4024: 
 4025:    // Side boundary type
 4026:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 4027:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 4028: if (i == 0) printf("populateSides: 2\n");
 4029: // return;
 4030:    if (n1bnd != nullptr && n2bnd != nullptr) 
 4031:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 4032:    {
 4033:       bool isLand = false;
 4034:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 4035:       
 4036:       if (isbs > -1) {
 4037:          // assert(isLand || isbs>=0);
 4038:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 4039: 
 4040:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 4041: 
 4042:          if   (isLand) side.sideBnd->segment = landBoundarySegment;
 4043:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 4044: 
 4045:          assert (isLand == side.sideBnd->segment->isLand);
 4046:          
 4047:          side.sideBnd->side = &side;
 4048: 
 4049:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4050:          n1bnd->linkSideBoundary(side.sideBnd);
 4051:          n2bnd->linkSideBoundary(side.sideBnd);
 4052: 
 4053:       }
 4054:       else {
 4055:          side.sideBnd = nullptr;
 4056:       }
 4057:    }
 4058:    else 
 4059:    {
 4060:       side.sideBnd = nullptr;
 4061:    }
 4062: 
 4063: if (i % 100 == 0) printf("populateSides: 3, i = %d\n", i);
 4064: // return;
 4065:    // finding the pointer to the elements that share the side
 4066:    const int idx_e1 = isdel[iglobal*2];
 4067:    const int idx_e2 = isdel[iglobal*2 + 1];
 4068: 
 4069:    if (idx_e1 > -1) {
 4070:       const int locidx_e1 = localElemIndices[idx_e1];
 4071:       const int part_e1 =  localElemPart[idx_e1];
 4072:       side.elems[0] = elems[part_e1] + locidx_e1;
 4073: 
 4074:    }
 4075:    else {
 4076:       side.elems[0] = nullptr;
 4077:    }
 4078: 
 4079: if (i % 100 == 0) printf("populateSides: 4, i = %d\n", i);
 4080: 
 4081:    if (idx_e2 > -1) {
 4082:       const int locidx_e2 = localElemIndices[idx_e2];
 4083:       const int part_e2 =  localElemPart[idx_e2];
 4084:       side.elems[1] = elems[part_e2] + locidx_e2;
 4085:    }
 4086:    else {
 4087:       side.elems[1] = nullptr;
 4088:    }
 4089: 
 4090: if (i % 100 == 0) printf("populateSides: 5, i = %d\n", i);
 4091: 
 4092:    if (side.elems[1] == nullptr && side.sideBnd == nullptr) {
 4093:       
 4094:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 4095:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 4096:       printf("Side %d has no elements and no boundary. Types = %p, %p\n", i, n1bnd, n2bnd);
 4097:          
 4098:       // printf("idx_e1: %d, idx_e2: %d\n", idx_e1, idx_e2);
 4099:       // printf("elems[0]: %p, elems[1]: %p\n", side.elems[0], side.elems[1]);
 4100:       // printf("sideBnd: %p\n", side.sideBnd);
 4101:       // assert(false && "Side has no elements and no boundary");
 4102:    }
 4103:    // assert(side.elems[1] != nullptr || side.sideBnd != nullptr);
 4104: 
 4105:    // Compute the center of the side
 4106:    side.center = 0.5*(side.n1->p + side.n2->p);
 4107: 
 4108:    #ifdef USE_FRAMES
 4109:    side.setFrame();
 4110:    #endif
 4111: 
 4112: if (i % 100 == 0) printf("populateSides: 6, i = %d\n", i);
 4113: 
 4114:    // Normal, unitary vector to the side
 4115:    if constexpr(ics == 1) {
 4116:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4117:       side.n = normalize(side.n);
 4118:    }
 4119:    else {
 4120:       // Unit side vector in 3D cartesian coordinates
 4121:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4122: 
 4123:       nSide = normalize(nSide);
 4124: 
 4125:       // Its cross product with the unit local z-axis vector (nUp) is the
 4126:       // normal vector we are looking for.
 4127:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4128: 
 4129:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4130:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4131:       side.n = -normalize(n2D); 
 4132: 
 4133:    }
 4134: 
 4135: if (i % 100 == 0) printf("populateSides: 7, i = %d\n", i);
 4136: 
 4137:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4138:    side.shapiro = shapiro0;
 4139: 
 4140:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4141:    // XXXX
 4142:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4143:    constexpr double rot_per=3000.0;
 4144:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4145:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4146:    // XXXXX      
 4147:    #endif
 4148:    // Compute the z level at the center of the side
 4149:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4150:    
 4151:    // Compute the length of the side
 4152:    side.len = length(toPoint3(side.n2->p, side.n2->gz) - toPoint3(side.n1->p, side.n1->gz));
 4153: 
 4154: if (i % 100 == 0) printf("populateSides: 8, i = %d\n", i);
 4155: 
 4156:    // Compute the Coriolis coefficient
 4157: 
 4158:    if constexpr(ncor == -1 || ncor == 0) {
 4159:       side.coriolis = coricoef;
 4160:    }
 4161:    else {
 4162:       const double sphi = side.lat();  // Latitude at the center of the side
 4163: 
 4164:       assert(use_ll && "use_ll must be true when ncor > 0");
 4165: 
 4166:       if constexpr(ics == 1) {
 4167:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4168:       }
 4169:       else { // ics == 2
 4170:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4171:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4172:       }
 4173: 
 4174:    }
 4175: 
 4176: if (i % 100 == 0) printf("populateSides: 9, i = %d\n", i);
 4177: 
 4178: }
 4179: 
 4180: 
 4181: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4182:    double *node_coords, double *node_coords_ll, bool use_ll,
 4183:    double *wind_rotate_angle,   
 4184:    int *isdel, int *isidenode, int *isbnd,
 4185:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4186:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4187:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4188:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4189:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4190:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4191:    double *drag, double *roughness) {
 4192: 
 4193:    ELEM(pelem);
 4194:    Element &elem(*pelem);
 4195:    const int i = idx_elem;
 4196: 
 4197:    elem.idx = i;
 4198: 
 4199:    for (int j = 0; j < i34[i]; j++) {
 4200:       const int idxNode = elnode[i*4 + j];  
 4201:       const int idxSide = elside[i*4 + j];
 4202:       
 4203:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4204:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4205: 
 4206:       // Find the neighboring element  
 4207:       if (elem.sides[j]->elems[0] == &elem) {
 4208:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4209:       }
 4210:       else {
 4211:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4212:       }
 4213:       
 4214:    }
 4215: 
 4216:    elem.i34 = i34[i];
 4217: 
 4218:    // Compute the barycenter of the element and its depth
 4219:    elem.center = {0.0, 0.0};
 4220:    elem.depth = 1e10;
 4221:    for (int j = 0; j < i34[i]; j++) {
 4222: 
 4223:       elem.center += elem.nodes[j]->p/i34[i];
 4224:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4225:    }
 4226: 
 4227:    #ifdef USE_FRAMES
 4228:    elem.setFrame();
 4229:    #endif
 4230: 
 4231:    elem.area = elem.computeSignedArea(); 
 4232:    elem.radius = sqrt(elem.area)/pi; 
 4233:    
 4234:    // Determines which way the normal vector to each side is oriented.
 4235:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4236:    for (int j = 0; j < i34[i]; j++)  
 4237:    {
 4238:       if (elem.sides[j]->elems[0] == &elem) {
 4239:          elem.ssign[j] =  1.0;
 4240:       }
 4241:       else {
 4242:          elem.ssign[j] = -1.0;
 4243:       }
 4244: 
 4245:    }
 4246: 
 4247:   
 4248: 
 4249:    // Derivatives of shape functions
 4250:    //  For ics=2, this is done in the element frame
 4251:    //  For quads, the derivative is evaluated at centroid
 4252:    for (int j = 0; j < elem.i34; j++) {
 4253:       const double area = elem.area;
 4254:       const int id2 = elem.nxq(1 + j);
 4255:       const int id3 = elem.nxq(2 + j);
 4256:       const int id4 = elem.nxq(3 + j);
 4257:       if (elem.isTri()) {
 4258:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4259:          // phi_0 = (x2 - x0)^(x - x0)/((x2 - x0)^(x1 - x0)), where ^ is the cross product
 4260:          // phi_0 = (x2 - x0)^(x - x0)/(2*area)
 4261:          // dphi_0/dx = (x2.y - x0.y)/(2*area)
 4262:          // dphi_0/dy = (x0.x - x2.x)/(2*area)
 4263:          // And so on for the other shape functions.
 4264: 
 4265:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4266:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4267:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4268: 
 4269:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4270:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4271: 
 4272:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4273: 
 4274:       }
 4275:       else  { // Quad, the derivatives are evaluated at the centroid
 4276: 
 4277:          // The derivation is complicated, but it starts by defining the shape functions in terms of the local coordinates (eta, xi).
 4278:          // phi_0 = (1 + eta*eta_n(0))*(1 + xi*xi_n(0))/4
 4279:          // ...
 4280:          // and then the derivatives are computed at the centroid (eta = 0, xi = 0)
 4281: 
 4282:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4283:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4284:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4285: 
 4286:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4287:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4288: 
 4289:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4290: 
 4291:       } // if Tri/Quad
 4292: 
 4293:    } // for j   
 4294:    
 4295:    
 4296: 
 4297: }
 4298: 
 4299: 
 4300: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4301:                                             double *emo, double *efa, 
 4302:                                             double *umo, double *ufa, 
 4303:                                             double *vmo, double *vfa,
 4304:                                             int *ifltype, int *iettype) {
 4305: 
 4306:    NODE_BND(nodeBnd);
 4307:    const int idx = idx_node_bnd;    
 4308: 
 4309:    nodeBnd->idx = idx;
 4310: 
 4311:    // Need to find the segment index and the index of the node on the segment
 4312:    int idxNode = -1;
 4313:    int iseg, i;
 4314:    for (iseg = 0; iseg < nope; iseg++) {
 4315:       // for each segment...
 4316:       for (i = 0; i < nond[iseg]; i++) {
 4317:          idxNode = iond[iseg + i*nope];
 4318:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 4319:          
 4320:       }
 4321:    }
 4322: 
 4323:    assert(iseg < nope && "iseg is out of bounds");
 4324: 
 4325: found: // Jumped here when the node was found
 4326: 
 4327:    nodeBnd->isEssentialBC = true;
 4328:    nodeBnd->elbc = 0.0;
 4329: 
 4330:    nodeBnd->segment->ifltype = ifltype[iseg];
 4331:    nodeBnd->segment->iettype = iettype[iseg];
 4332: 
 4333:    for (int jfr = 0; jfr < nbfr; jfr++) {
 4334: 
 4335:       const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4336: 
 4337:       nodeBnd->efa[jfr] = efa[idx2];
 4338:       nodeBnd->emo[jfr] = emo[idx2];
 4339:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 4340:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 4341: 
 4342:    }
 4343:         
 4344: 
 4345: }
 4346: 
 4347: __device__ void Mesh::populateBoundarySideLinks(void) {
 4348: 
 4349:    SIDE_BND(sideBnd);
 4350: 
 4351:    const Side *side = sideBnd->side;
 4352: 
 4353:    // We assume that the leftSide is the side s that has s->n2 == side->n1
 4354:    // and the rightSide is the side s that has s->n1 == side->n2
 4355:    for (int i = 0; i < mesh->nbs; i++) {
 4356: 
 4357:       Side *s = &mesh->localSideData[i];
 4358: 
 4359:       if (s == side) continue;  // Do not link the side to itself
 4360:    
 4361:       if (s->n1 == side->n2) sideBnd->leftSide  = s;
 4362:       if (s->n2 == side->n1) sideBnd->rightSide = s;
 4363:    }
 4364:    
 4365: }
