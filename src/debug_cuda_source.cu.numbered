  224: // Simple math functions ---------------------------------------------------------------------------
  225: 
  226: __device__ __forceinline__ void solveQuadratic(double A, double B, double C, double &x1, double &x2) {
  227: // Solves the quadratic equation A*x^2 + B*x + C = 0 and returns the two solutions in x1 and x2.
  228: // Outputs:
  229: //        x1: first solution
  230: //        x2: second solution
  231: 
  232:        // Use float-specific absolute value for speed on GPU
  233:     const double absA = fabs(A);
  234:     const double absB = fabs(B);
  235: 
  236:     // 1. Near-linear case: a is effectively 0.
  237:     // We use a small epsilon to prevent division by zero and handle degenerate quads.
  238:     // This branch is almost never taken, so it won't hurt performance.
  239:     if (absA < 1e-14 * (absB + 1e-30)) {
  240:         const double x = -C / B;
  241:         x1 = x;
  242:         x2 = x;
  243:         return;  // Degenerate case: A = 0.
  244:     }
  245: 
  246:    const double delta = max(0.0, B*B - 4.0*A*C);
  247: 
  248:    assert(delta >= 0.0 && "solveQuadratic: negative discriminant");
  249:    const double s = sqrt(delta);
  250: 
  251:    // Numerically stable quadratic roots:
  252:    // q = -0.5*(B + sign(B)*sqrt(delta))
  253:    const double q = -0.5 * (B + copysign(s, B));
  254: 
  255:    x1 = q/A;
  256:    x2 = (fabs(q) > 1e-30) ? (C/q) : x1;   // Moving predicate.
  257: 
  258: }
