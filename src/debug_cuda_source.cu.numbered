 7736: __global__ void returnMatrix(double *res) {
 7737:    // Debugging: returns the matrix as a CuPy array
 7738: 
 7739:    const int size = mesh->np;
 7740:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7741:       const Node *node = mesh->localNodeData + idx_node;
 7742:       res[idx_node*size + idx_node] = node->coeffDiag;
 7743:       for (int j = 0; j < node->numNodes; j++) {
 7744:          Node* nbNode = node->nodes[j];
 7745:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7746:       }
 7747: 
 7748:    }
 7749:    
 7750: }
 7751: 
 7752: 
 7753: __global__ void computeMatrixProductAndDotProducts() {
 7754:    // Computes A*p, r'Mr and p'Ap
 7755: 
 7756:    // 1) shared buffer: first half for rMr, second for pAp
 7757:    __shared__ double sdata[2*BLOCK_SIZE];
 7758:    double* s_rMr = sdata;
 7759:    double* s_pAp = sdata + BLOCK_SIZE;
 7760: 
 7761:    const int tid = threadIdx.x;
 7762: 
 7763:    double l_pAp = 0.0;
 7764: 
 7765:    s_rMr[tid] = 0.0;
 7766:    s_pAp[tid] = 0.0;
 7767: 
 7768:    // 2) get your node pointer
 7769:    // NODE(node);   
 7770:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7771:    Node *node = &(mesh->localNodeData[idx_node]); 
 7772:       if (idx_node < mesh->np) {
 7773: 
 7774:       const double diag = node->coeffDiag;
 7775:       const double r    = node->mR;
 7776:       const double p    = node->mP;  
 7777: 
 7778:       // apply preconditioner on the fly:
 7779:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7780: 
 7781:       // 4) compute Ap = A.p
 7782:       double Ap = node->coeffDiag * node->mP;
 7783:       for (int j = 0; j < node->numNodes; ++j) {
 7784:          const Node *nbNode = node->nodes[j];
 7785:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7786: 
 7787:       }
 7788: 
 7789:       node->mAp = Ap;
 7790:       
 7791: 
 7792:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7793:       // const double l_rMr = r*Mr;  // r'Mr
 7794:       l_pAp = p*Ap;  // p'Ap
 7795: 
 7796: 
 7797:    }
 7798: 
 7799:    // 6) write into shared mem
 7800:    // s_rMr[tid] = l_rMr;
 7801:    s_pAp[tid] = l_pAp;
 7802: 
 7803:    __syncthreads();
 7804: 
 7805:    // 7) block-wide tree reduction
 7806:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7807:       if (tid < stride)  {
 7808:          s_pAp[tid] += s_pAp[tid + stride];
 7809:       }
 7810:       __syncthreads();
 7811:    }
 7812: 
 7813:    // 8) thread 0 atomically accumulates into the globals
 7814:    // XXX: This is slower than it needs to be, but it is simple and works
 7815:    if (tid == 0) {
 7816:       atomicAdd(pAp, s_pAp[0]);
 7817:    }
 7818: 
 7819: 
 7820: }
 7821: 
 7822: 
 7823: __global__ void updateSolutionAndDotProducts(void) {
 7824:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7825: 
 7826:    const int tid = threadIdx.x;
 7827: 
 7828:    s_rMr[tid] = 0.0;
 7829: 
 7830:    // get node & bounds-check:
 7831:    NODE(node);
 7832: 
 7833:    
 7834:    // Compute alpha
 7835:    const double alpha = (*rMr_old)/(*pAp); 
 7836: 
 7837: 
 7838:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7839: 
 7840: 
 7841:    // load scalars
 7842:    const double diag = node->coeffDiag;
 7843:    const double p    = node->mP;
 7844:    const double Ap   = node->mAp;
 7845:    const double x    = node->mX;
 7846:    const double r    = node->mR;
 7847:    
 7848:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7849: 
 7850:    // 1) update solution & residual
 7851:    const double x_new = x + alpha*p;
 7852:    const double r_new = r - alpha*Ap;
 7853:    node->mX = x_new;
 7854:    node->mR = r_new;
 7855: 
 7856:    // 2) apply Jacobi preconditioner on the fly
 7857:    const double Mr_new = r_new/diag;
 7858: 
 7859: 
 7860:    // 3) local contributions for the two dot-products
 7861:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7862: 
 7863:    // 4) write into shared-mem
 7864:    s_rMr[tid] = l_rMr;
 7865: 
 7866:    __syncthreads();
 7867: 
 7868: 
 7869:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7870:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7871:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7872:       __syncthreads();
 7873:    }
 7874: 
 7875:    // 6) thread 0 atomically folds into the global accumulators
 7876:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7877: 
 7878: 
 7879: }
 7880: 
 7881: 
 7882: __global__ void updateSearchDirection() {
 7883: 
 7884:     NODE(node);
 7885: 
 7886:     // recompute z on-the-fly
 7887:     const double z = node->mR / node->coeffDiag;
 7888:     const double p = node->mP;
 7889: 
 7890:     const double beta = (*rMr_new)/(*rMr_old);
 7891: 
 7892: 
 7893:     // p =z + beta*p
 7894:     node->mP = z + beta*p;
 7895: 
 7896: }
 7897: 
 7898: __global__ void initializeScalars(double *scalars) {
 7899: 
 7900:    // These point to a cupy array in the host code
 7901:    rMr_old = scalars + 0;
 7902:    rMr_new = scalars + 1;
 7903:    pAp     = scalars + 2;
 7904: }
 7905: 
 7906: __global__ void initializePreconditionedResidual(void) {
 7907: 
 7908:     __shared__ double s_rMr[BLOCK_SIZE];  
 7909: 
 7910:     s_rMr[threadIdx.x] = 0.0;
 7911: 
 7912:     NODE_ALL(node, valid);
 7913:     const int tid = threadIdx.x;
 7914:     // For the first iteration:
 7915:     // 1. Initial solution x = 0 (already set)
 7916:     // 2. Initial residual r = b (stored in qel)
 7917:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7918: 
 7919: // XXX we should use the guess solution here    
 7920: 
 7921:     double l_rMr = 0.0;
 7922:     if (valid) {
 7923:       // Set initial residual r = b (from qel)
 7924:       node->mR = node->qel;
 7925: 
 7926:       // Compute z = M^-1 * r (preconditioned residual)
 7927:       const double z = node->mR / node->coeffDiag;
 7928: 
 7929:       // Set initial search direction p = z
 7930:       node->mP = z;
 7931: 
 7932:       // Initialize other variables needed for CG
 7933:       node->mX = 0.0;  // Initial solution
 7934:       node->mAp = 0.0; // Will be computed in first iteration
 7935: 
 7936: 
 7937:       // Computes the first r'Mr (reduction)
 7938:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7939:     }
 7940:     // 4) write into shared-mem
 7941:     s_rMr[tid] = l_rMr;
 7942: 
 7943:     __syncthreads();
 7944: 
 7945: 
 7946:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7947:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7948:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7949:         __syncthreads();
 7950:     }
 7951: 
 7952:     // 6) thread 0 atomically folds into the global accumulators
 7953:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7954: 
 7955:     *rMr_old = 0.0;
 7956:     *pAp = 0.0;
 7957: }
 7958: 
 7959: 
 7960: 
 7961: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7962:    Element *elems = mesh->localElemData;
 7963: 
 7964:    *addr = elems;
 7965:    *sizeElement = sizeof(Element);
 7966:    switch (varCode) {
 7967:       case (int)VarCode::z:
 7968:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7969:          *sizeType = sizeof(double);
 7970:          break;
 7971:       case (int)VarCode::x:
 7972:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7973:          *sizeType = sizeof(Vector2);
 7974:          break;
 7975:       case (int)VarCode::area:
 7976:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7977:          *sizeType = sizeof(double);
 7978:          break;
 7979:       case (int)VarCode::depth:
 7980:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7981:          *sizeType = sizeof(double);
 7982:          break;
 7983:       case (int)VarCode::radius:
 7984:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7985:          *sizeType = sizeof(double);
 7986:          break;
 7987:       case (int)VarCode::lonlat:
 7988:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 7989:          *sizeType = sizeof(double);
 7990:          break;
 7991:       case (int)VarCode::ghat:
 7992:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7993:          *sizeType = sizeof(Vector2);
 7994:          break;
 7995:       case (int)VarCode::kb:
 7996:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 7997:          *sizeType = sizeof(int);
 7998:          break;
 7999:       case (int)VarCode::isdry:
 8000:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 8001:          *sizeType = sizeof(int);
 8002:          break;            
 8003:       case (int)VarCode::w:
 8004:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 8005:          *sizeType = sizeof(double);
 8006:          break;
 8007:       case (int)VarCode::FaceIndices:
 8008:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 8009:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 8010:          *sizeType = sizeof(Node);
 8011:          break;
 8012:       default:
 8013:          *offset = -1;
 8014:    }
 8015: }
 8016: 
