 2327:    template<typename T>
 2328:    __device__ __forceinline__ T Element::mean(T Node::* field) const {
 2329:       T values[4];
 2330:       getNodalValues(field, values);
 2331: 
 2332:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2333:       if constexpr (IsVector2<T>::value && ics == 2) {
 2334: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2335:          projectNodeVectorsToElementFrame(values);
