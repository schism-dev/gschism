 4233: extern "C" {
 4234: 
 4235:    __global__ void scaleGravity(double loadtide_coef) {
 4236: 
 4237: 
 4238:       NODE(node);
 4239: 
 4240:       // SAL option: scale gravity
 4241:       if constexpr(iloadtide==2) {  // simple const
 4242:          node->grav2 = grav*(1.0 - loadtide_coef);
 4243: 
 4244:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4245:         
 4246:           const double depth = max(node->depth, 0.0);
 4247:           const double tmp1 = sqrt(depth);
 4248:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4249:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4250:                              2.6969e-13*depth*depth*depth*tmp1;
 4251:           
 4252:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4253:           
 4254: 
 4255: 
 4256:           node->grav2 = grav*(1.0 - beta_bar);
 4257: 
 4258:       } else {  // iloadtide=0,1
 4259:         node->grav2=grav;
 4260: 
 4261:       }
 4262: 
 4263:    }
 4264: 
 4265: 
 4266:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4267: 
 4268:       NODE_BND(nodeBnd);
 4269: 
 4270:       Node *node = nodeBnd->node;
 4271: 
 4272:       node->ETP = 0.0;
 4273: 
 4274:       for (int j=0; j<ntip; j++) {
 4275: 
 4276:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4277:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4278:    
 4279:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4280: 
 4281:          if constexpr(iloadtide==1) { // loading tide
 4282:             assert(false && "Loading tide not implemented");
 4283:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4284:          }
 4285:          
 4286:       }
 4287:       
 4288:    }
