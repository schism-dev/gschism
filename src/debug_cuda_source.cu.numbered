 3472: /**
 3473:  * This method performs backtracking from the side center until a time -dt back in time 
 3474:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3475:  * intermediate point.
 3476:  *
 3477:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3478:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3479:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3480:  * remaining time.
 3481:  * 
 3482:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3483:  * 
 3484:  * @param uuint, vvint, wwint: Velocities at the final point
 3485:  * @param jlev: Level at which the backtracking is performed
 3486:  * @param dt, dtbk: Tracking timesteps
 3487:   */
 3488: __inline__ __device__ void Side::btrack(
 3489:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3490:       double dt,            // Tracking time
 3491:       double dtbk,          // Tracking timestep
 3492:       Vector3 &u_int        // Velocities at the initial point
 3493: ) const {
 3494: 
 3495:    // Start from side center
 3496:    Point3 x0;
 3497: 
 3498:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3499:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3500: 
 3501:  
 3502:    double time_rm = dt; // Remaining time
 3503: 
 3504: 
 3505:    // Initial velocities
 3506:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3507: 
 3508: return;
 3509:    // Find a non dry element for starting the backtracking. At this point there should be at least one.
 3510:    Element* curElem = (!elems[0]->isDry) ? elems[0] : elems[1];  // elems[0] is always non-null 
 3511: 
 3512:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3513: 
 3514: // showPoints(x0, x0, jlev, this, 0xFF0000u, 'x', 1, 0, 0);
 3515: 
 3516: 
 3517:    constexpr int MAX_ITERATIONS = 10; 
 3518:    int iter = 0;
 3519:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3520:    while(true) {
 3521: 
 3522:       // Calculate timestep
 3523:       const double dtb = min(dtbk, time_rm);
 3524: 
 3525:       // Next point in the backtracking curve
 3526:       xt = x0 - dtb*u_int;
 3527: 
 3528: // showPoints(x0, xt, jlev, this, 0xFF00FFu, 'o', 1, 15, iter);
 3529: // if ((jlev==45)) printf("jlev = %d, iter = %d, x0 = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f)\n", jlev, iter, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z);
 3530: if ((jlev==45))
 3531: {
 3532: // const Point3 p1 = toLocalFrame(x0);
 3533: // const Point3 p2 = toLocalFrame(xt);
 3534: // printf("jlev = %d, iter = %d, p1 = (%.17f, %.17f, %.17f), p2 = (%.17f, %.17f, %.17f)\n", jlev, iter, p1.x, p1.y, p1.z, p2.x, p2.y, p2.z);
 3535: showPoints(x0, xt, jlev, this, 0x0000FFu, 'o', 1, 0, 0); 
 3536:     
 3537: }
 3538:       Side *lastCrossSide = nullptr;
 3539:       const bool found = celestialWalk(curElem, x0, xt, this, lastCrossSide, jlev);
 3540: 
 3541: if (idx == 26505 && jlev==45) printf("time_rm = %.17f, dtb = %.17f, dtbk = %.17f, jlev = %d, iter = %d, x0 = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f), found = %d\n", time_rm, dtb, dtbk, jlev, iter, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z, found);
 3542: 
 3543:       // This means that the walk reached a boundary or a dry element.
 3544:       if (!found) {
 3545: 
 3546: u_int = {0.0, 0.0, 0.0};
 3547: time_rm = 0.0;
 3548: return;
 3549: 
 3550: assert(lastCrossSide!=nullptr && "lastCrossSide is nullptr");
 3551:          // Check that the crossing point is not too far from the segment x0xt.
 3552:          const Point2 p1 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n1->p, lastCrossSide->n1->gz)));
 3553:          const Point2 p2 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n2->p, lastCrossSide->n2->gz)));
 3554:          const Vector2 v1 = toPoint2(xt) - toPoint2(x0);
 3555:          const Vector2 v2 = p1 - p2;
 3556:          const Point2  p0 = toPoint2(x0);
 3557:          const Point2  pt = toPoint2(xt);
 3558: 
 3559: 
 3560:          const double denom = cross(v2, v1);
 3561:          double t = clamp(cross(p1 - p0, v1) / denom, 0.0, 1.0);
 3562: 
 3563:          if (abs(denom) < small) t = (norm2(p1 - p0) < norm2(p2 - p0)) ? 0.0 : 1.0;
 3564:          // else printf("AAAAAAA idx = %d, jlev = %d, t = %.17f, denom = %.17f\n", idx, jlev, t, denom);
 3565: assert(curElem!=nullptr && !curElem->isDry && "curElem is nullptr or dry");
 3566:          const double fac = clamp(length(p1 + t*v2 - p0)/length(v1), 0.0, 1.0);
 3567:          time_rm = (1.0 - fac)*dtb;
 3568:          xt = x0 + fac*(xt - x0);
 3569:          Vector2 tangent = normalize(v2);
 3570:          const Vector3 u = curElem->interpolateVelocities(xt, this);
 3571: 
 3572:          const Vector2 u2D = make_double2(u.x, u.y);
 3573:          u_int = toVector3(dot(u2D, tangent)*tangent, u.z);
 3574: 
 3575: 
 3576:    
 3577: 
 3578: 
 3579:          // FIND CROSSING POINT xtp ON BOUNDARY SEGMENT
 3580:          // COMPUTE DISTANCE dtb = distance(x0, xtp) / length(u_int).
 3581:          // COMPUTE U along the boundary segment.
 3582:          // If the velocity is too small, we stop the backtracking
 3583:          // time_rm -= dtb;
 3584:          // MOVE time_rm along the boundary.
 3585:          // X0 = XT
 3586:          // time_rm = 0.0;
 3587: 
 3588:          // u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};//{0.0, 0.0, 0.0}; XXXXX put 0,0,0 back?
 3589: 
 3590: 
 3591:       } else {
 3592: 
 3593:          assert(curElem!=nullptr && !curElem->isDry && "Final element is dry or boundary side");
 3594: 
 3595:          time_rm -= dtb; 
 3596: 
 3597:          assert(curElem->containsPoint(toPoint2(xt), this) && "Target point is not inside the current element");
 3598: // printf("HEREEEEEE 4, xt = (%.17f, %.17f, %.17f)\n", xt.x, xt.y, xt.z);
 3599:          u_int = curElem->interpolateVelocities(xt, this);
 3600: if (idx == 26505 && jlev==45) printf("u_int = (%.17f, %.17f, %.17f), {u2[jlev].x, u2[jlev].y, w2(jlev)} = (%.17f, %.17f, %.17f)\n", u_int.x, u_int.y, u_int.z, u2[jlev].x, u2[jlev].y, w2(jlev));
 3601:       }
 3602: 
 3603: if (iter>20) printf("iter = %d, time_rm = %.17f, dtb = %.17f, dtbk = %.17f, u_int = (%.17f, %.17f, %.17f)\n", iter, time_rm, dtb, dtbk, u_int.x, u_int.y, u_int.z);
 3604:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0                      
 3605: 
 3606:       // If the velocity is too small, we stop the backtracking
 3607:       const double vmag2 = norm2(toVector2(u_int));
 3608:       if (vmag2 <= velmin_btrack_sq) { u_int = {0.0, 0.0, 0.0}; time_rm = 0.0; return; };
 3609: 
 3610:       // The current point becomes the next segment's starting point.
 3611:       x0 = xt;
 3612:  
 3613:       iter++;
 3614: 
 3615: 
 3616:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3617:    }
 3618: 
 3619:    assert(curElem != nullptr && "Final element is nullptr");
 3620:    assert(!curElem->isDry && "Final element is dry");
 3621: 
 3622: // const Point3 p0 = toLocalFrame(toPoint3(curElem->nodes[0]->p, curElem->nodes[0]->gz));
 3623: // const Point3 p1 = toLocalFrame(toPoint3(curElem->nodes[1]->p, curElem->nodes[1]->gz));
 3624: // const Point3 p2 = toLocalFrame(toPoint3(curElem->nodes[2]->p, curElem->nodes[2]->gz));
 3625: // Vector3 xt_Before = xt;
 3626: // curElem->nudgeToBarycenter(toPoint2(xt), this);
 3627: // Vector3 xt_After = xt;
 3628: // showPoints(xt_Before, xt_After, jlev, this, 0x00006Fu, '+', 2, 10, iter);
 3629: // if (!curElem->containsPoint(toPoint2(xt), this)) printf("side->idx = %d, (%.16f,%.16f),(%.16f,%.16f),(%.16f,%.16f)  xt = (%.17f, %.17f, %.17f)\n", idx, p0.x, p0.y, p1.x, p1.y, p2.x, p2.y, xt.x, xt.y, xt.z);
 3630: 
 3631: 
 3632: 
 3633:    // Interpolate the velocities at the final point with respect to the current side frame
 3634:    u_int = curElem->interpolateVelocities(xt, this);
 3635: if (idx == 26505 && jlev==45) printf("AFTER curElem->interpolateVelocities(xt, this), u_int = (%.17f, %.17f, %.17f), {u2[jlev].x, u2[jlev].y, w2(jlev)} = (%.17f, %.17f, %.17f)\n", u_int.x, u_int.y, u_int.z, u2[jlev].x, u2[jlev].y, w2(jlev));
 3636: 
 3637: }
