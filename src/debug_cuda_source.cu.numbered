 5614:    __global__ void computeVerticallyIntegratedVelocity(void) {
 5615: 
 5616:       SIDE(side);
 5617: 
 5618:       side->U = {0.0, 0.0}; 
 5619:          
 5620:       if(side->isDry) return;
 5621: 
 5622:       // Vertically integrated velocity U
 5623:       for (int k = side->kb; k < nvrt - 1; k++) { 
 5624:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 5625:          side->U += side->Dz(k + 1)*uc;  
 5626:       }
 5627: 
 5628:    }
 5629: 
 5630:    __global__ void computeBottomDragVegetation(void) {
 5631:       // UNFINISHED. CHECK THIS:
 5632:       // How many kernels are needed? Why so many for loops?
 5633:       // Is the loop on sides needed?
 5634: 
 5635:       NODE(node);
 5636: 
 5637: 
 5638:       const int    kb      = node->kb;
 5639:       const double htot    = node->htot2(); 
 5640:       
 5641:       if (node->isDry) {
 5642:          // Default values for dry nodes
 5643:          node->veg_alpha_vert_mean = node->veg_alpha0;
 5644:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 5645: 
 5646:          return;
 5647:        
 5648:       }
 5649: 
 5650:       // Computes bottom drag Cd based on the selected nchi
 5651:       node->computeBottomDragCd();
 5652:       
 5653: 
 5654: 
 5655:       //   Bottom stress in m^2/s^2
 5656:       if (node->rho[kb + 1] >= -98.0)
 5657:       {
 5658:          const double mag_u = length(node->u2[kb + 1]);
 5659:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5660: 
 5661:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5662:          // !sediment erosion: this part needs more documentation
 5663:       }
 5664:     
 5665: 
 5666: 
 5667:       // Compute vegetation parameters
 5668:       //--------------------------------
 5669: 
 5670:       // SAV constants
 5671:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5672:       constexpr double veg_cfpsi = 0.16;
 5673: 
 5674:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5675:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5676: 
 5677:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5678:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5679:          int kbin = 0; // bin index
 5680:          for (int k = kb; k < nvrt; k++) {
 5681:             // Computes node height above the bottom level
 5682:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5683:             assert(false && "Vertical variation of vegetation not implemented");
 5684: 
 5685:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5686:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5687:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5688:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5689:             // } else {
 5690:             //    // Find the bin at which the current vertical level is
 5691:             //    while (kbin<nbins_veg_vert) {
 5692:             //       const double zn = node->z[kbin];
 5693:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5694:             //          break;
 5695:             //       } // if
 5696:             //       kbin++;
 5697:             //    } // while
 5698:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5699: 
 5700:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5701:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5702:                
 5703:             //    // Linear interpolation of the vegetation parameters
 5704:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5705:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5706:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5707:             // } // if rl10
 5708: 
 5709:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5710: 
 5711:          } // for k
 5712: 
 5713: 
 5714:       } else { // Ganthy (iveg==2)
 5715:       //  Modify canopy height, diameter, and density
 5716: 
 5717:          // Make sure there is vegetation on this node
 5718:          if (node->veg_h_unbent > 0.0) {
 5719:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5720: 
 5721:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5722:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5723:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5724: 
 5725:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5726:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5727:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5728:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5729:          } // if veg_h_unbent
 5730: 
 5731:          for (int k = 0; k < nvrt; k++) {
 5732:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5733:          } // for k
 5734:       
 5735: 
 5736:       } // if iveg
 5737:      
 5738: 
 5739:       // Compute vertical mean of veg_alpha3D
 5740:       if (iveg != 0) {
 5741:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5742:          double sum1=0.0;
 5743:          double sum2=0.0;
 5744:          // Integrate over each level under the canopy...
 5745:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5746:             const double Dz = node->Dz(k);
 5747: 
 5748:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5749:             sum2 += Dz;
 5750: 
 5751:          } // for k
 5752:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5753:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5754: 
 5755:       } // if iveg
 5756: 
 5757:    }
 5758: 
 5759:    __global__ void computeVegetationAndDragParameters(void) {
 5760:       // Computes the vegetation and drag model parameters:
 5761:       // chi, \tilde\chi, beta, \breve{H}
 5762:       
 5763:       SIDE(side);
 5764: 
 5765:       side->hhat = 0.0;
 5766:       side->chi2 = 0.0;
 5767:       side->chi = 0.0;
 5768:       side->veg_c2 = 0.0;
 5769:       side->veg_beta = 0.0;
 5770: 
 5771:       if (side->isDry) return;
 5772: 
 5773:       const double htot = side->htot2();
 5774:       const int    kb   = side->kb;
 5775: 
 5776:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5777: 
 5778:       const double veg_h     = side->veg_h();
 5779:       const double veg_nv    = side->veg_nv();
 5780:       const double veg_c     = side->veg_c();
 5781:       const double veg_beta  = side->veg_beta;
 5782:       const double veg_alpha = side->veg_alpha_vert_mean();
 5783: 
 5784:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX recommended to change names, chi->chitilde, chi2->chi
 5785:       // Velocity magnitude at the bottom level
 5786:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0 - dt*swild2(k,1) to u2 (I think this only pertains to iupwind_mom \= 0)
 5787:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 5788:       side->chi2 = side->Cd()*vmag1;
 5789:       side->chi  = side->chi2;
 5790: 
 5791:       if constexpr(iveg != 0) {
 5792:          const Node *n1 = side->n1;
 5793:          const Node *n2 = side->n2;
 5794:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5795:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5796:       }
 5797: 
 5798:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5799: 
 5800:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5801:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5802:       double magUa = 0.0;
 5803:       if constexpr(iveg != 0) {
 5804:          if (side->is3D() && veg_h > 0.0) {
 5805:             // 3D wet side with veg...
 5806: 
 5807:             double magUa = 0.0;
 5808:             for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5809:                if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5810: 
 5811:                   // Velocity magnitude must be computed at the center of each level to perform the integration.
 5812:                   // The tricky part is to compute that velocity at the level that may be partially submerged.
 5813:                   const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5814: 
 5815:                   // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5816:                   const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5817: 
 5818:                   // Velocity magnitude at the bottom (l) of the level
 5819:                   const double ul = length(side->u2[k]);
 5820: 
 5821:                   const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5822:                   magUa += Dz*0.5*(uh + ul);
 5823: 
 5824:                } // if HasVegetation
 5825:             } // for k
 5826:             const double ua = magUa/min(htot, veg_h); // Vertical average
 5827: 
 5828:             // Computes beta, used for computing the stress term at the top of the canopy.      
 5829:             side->veg_c2 = veg_alpha*dt*ua; // >=0
 5830:             if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5831:                const double zCpy = side->zTopCanopy();
 5832:                const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5833:                const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5834:                const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5835:                const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5836:                side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5837:             } // if isSubmerged
 5838:          } // if is3D
 5839:       } // if iveg   
 5840: 
 5841:       // Computes the friction modified depth, \breve{H} in notes
 5842:       if (side->is2D()) { // 2D
 5843: 
 5844:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5845:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5846: 
 5847:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5848: 
 5849:          side->hhat = htot*htot/fricH; 
 5850: 
 5851:       } else { // 3D
 5852:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 5853: 
 5854:          if constexpr(iveg != 0) {
 5855:             
 5856:             if (side->isSubmerged()) { 
 5857:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5858:                side->hhat -= veg_c*Hhat_alpha;
 5859: 
 5860:             } else { // Emergent
 5861:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5862:             }
 5863:          } // if iveg
 5864: 
 5865:          // Enforce positivity for 3D model
 5866:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 5867:       } // if 3D
 5868: 
 5869:    }
 5870: 
 5871: 
 5872: 
 5873:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5874:    // Computes the density gradient between two elements, e1 and e2.
 5875:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5876:    // zero in the direction normal to the side. 
 5877:    // 
 5878:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5879:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 5880:    //
 5881:    // Input:
 5882:    //    e1: Element
 5883:    //    e2: Neighbor element (or nullptr if boundary)
 5884:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 5885:    //    k: Index of the half-level at which the density is interpolated
 5886:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 5887:    // 
 5888:    // Output:
 5889:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 5890:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 5891: 
 5892:       if (e2 == nullptr || e2->isDry) {
 5893:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 5894: 
 5895:          Side *side = e1->sides[j];
 5896:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 5897:                  
 5898:          if constexpr(ics == 1) {
 5899:             vec = side->n; // Normal vector to the side
 5900:          } else {
 5901:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5902:             // IMPLEMENT THIS XXXXXX
 5903:             // !replace with xel, yel?
 5904:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5905:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5906:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5907:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5908:          } //ics
 5909:                    
 5910:          diffRho = 0.0;
 5911: 
 5912:       } else { //internal and wet
 5913:          if constexpr(ics==1) {
 5914:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5915: 
 5916:             // Vector from e1 to e2
 5917:             vec = e2->center - e1->center;
 5918: 
 5919:          } else { 
 5920:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5921:             // Remember that elem->center is in global coordinates
 5922:             // IMPLEMENT THIS XXXXXX
 5923:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5924:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5925:             //                   alow(j)=xctr2
 5926:             //                   bdia(j)=yctr2
 5927:          } // ics
 5928: 
 5929:          diffRho = rho2 - e1->demeanedDensity(k);
 5930:       }
 5931: 
 5932:    }
 5933: 
 5934:    __global__ void computeDensityCubicSplines(void) {
 5935:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5936: 
 5937:       ELEM(elem);
 5938: 
 5939:       if (elem->isDry) return;
 5940: 
 5941:       const int kb = elem->kb;
 5942: 
 5943:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5944:       if (elem->is2D()) {
 5945:          // In the 2D case, the density is constant at the prism level. 
 5946:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5947:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5948:       } else { //3D
 5949: 
 5950:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5951:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5952:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5953:          ///// XXXX CHECK INDICES!!!!!
 5954:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5955:       } // 2D/3D
 5956: 
 5957:    }
 5958: } // extern "C"
 5959: 
 5960: 
 5961: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5962: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5963: 
 5964:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5965: 
 5966:    const int kb  = elem->kb;
 5967:    const int kb2 = elem2->kb;
 5968: 
 5969:    // z-coordinate of prism of elem
 5970:    const double zp = elem->z_prism(k);
 5971: 
 5972:    double rho = 0.0;
 5973: 
 5974:    if (elem2->is2D()) {
 5975:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5976: 
 5977:    } else {  // 3D
 5978: 
 5979:       // eta_min may be < zmax
 5980:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5981:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5982: 
 5983:       // (Extrapolate density below bottom, we will fix it later)
 5984:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5985:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5986:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5987:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5988:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5989:    } // 2D/3D
 5990:      
 5991: 
 5992:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5993:    // Now we need to fix it.
 5994:    if (elem->z[k] < elem2->z[kb2]) {
 5995:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5996: 
 5997:       // There are two methods to adjust the density at the bottom of the element.
 5998:       // iunder_deep=0: 
 5999:       const double depth1 = abs(elem->z[kb]); // larger depth
 6000: 
 6001:       if (iunder_deep==0) {
 6002: 
 6003:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 6004: 
 6005:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 6006: 
 6007:       } else { // iunder_deep != 0
 6008: 
 6009:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 6010: 
 6011:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 6012: 
 6013:          //   Demeaned density at the same z coordinate as
 6014:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 6015:          }
 6016: 
 6017:       } // if iunder_deep
 6018:    } // if elem->z[kb] < elem2->z[kb]
 6019: 
 6020:    return rho;
 6021: }
 6022: 
 6023: 
 6024: extern "C" {
 6025:    __global__ void computeDensityGradient(void) {
 6026: 
 6027:       assert(ibc == 1 && "baroclinic formulation is not implemented yet: ibc != 0");
 6028:       if constexpr(ibc != 0) return;
 6029: 
 6030:          // Compute the horizontal density gradient at each element.
 6031:       // It works in two steps:
 6032:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6033:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6034:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6035:       //             gradRho.r1 = rho1 - rho0
 6036:       //             gradRho.r2 = rho2 - rho0
 6037:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6038:       // 
 6039:       //  NOTE: We use de-meaned densities.
 6040: 
 6041:       ELEM(elem);
 6042: 
 6043:       if (elem->isDry) return;
 6044: 
 6045:       const int kb  = elem->kb;
 6046:       const int i34 = elem->i34;
 6047: 
 6048:       for (int k = kb + 1; k < nvrt; k++) {
 6049:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 6050:          //             gradRho.r1 = rho1 - rho0
 6051:          //             gradRho.r2 = rho2 - rho0
 6052:          int icount = 0;
 6053:          double sumRx = 0.0;
 6054:          double sumRy = 0.0;
 6055:          for (int j1=0; j1<i34; j1++) { 
 6056: 
 6057:             const int j2 = elem->nxq(j1 + 1);
 6058: 
 6059:             // Pairs of consecutive neighbor elements of elem
 6060:             const Element *e1 = elem->nghbElems[j1];
 6061:             const Element *e2 = elem->nghbElems[j2];
 6062: 
 6063:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 6064:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 6065:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 6066: 
 6067:             // Compute the density difference and the vector from elem to e1 and e2
 6068:             // getRhoDiffAndVec takes into account boundaries/dry elements
 6069:             double diffRho1, diffRho2;
 6070:             Vector2 vec1, vec2;
 6071:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 6072:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 6073: 
 6074:             const double rl1 = length(vec1);
 6075:             const double rl2 = length(vec2);
 6076:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 6077: 
 6078:             const double delta = cross(vec1, vec2);
 6079:             const double sintheta = abs(delta)/(rl1*rl2);
 6080: 
 6081:             // To avoid problems, avoid elements with small angle between vectors
 6082:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 6083:             const bool validEq = (sintheta > sin_one_deg);
 6084: 
 6085:             if (validEq) {
 6086:                // Solve the system of equations to get the density gradient at elem
 6087:                icount++;
 6088:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 6089:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 6090:                sumRx += Rx;
 6091:                sumRy += Ry;
 6092:             }
 6093:          } // for j1
 6094: 
 6095:          // Compute the average density gradient at elem
 6096:          if (icount==0) {
 6097:            // Bad mesh quality; bail out with 0 b-cc
 6098:            elem->gradRho[k] = {0.0, 0.0};
 6099:          } else {
 6100:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 6101:          }
 6102: 
 6103:       } // for k
 6104: 
 6105:    }
 6106: 
 6107:    __global__ void computeBaroclinicTerm(void) {
 6108:    // Computes the baroclinic term at sides (at half levels).
 6109:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 6110:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 6111: 
 6112:       if (ibc == 1) return;
 6113: 
 6114:       SIDE(side);
 6115: 
 6116:       if (side->isDry) return;
 6117: 
 6118:       const Element *e1 = side->elems[0];
 6119:       const Element *e2 = side->elems[1]; 
 6120:       const int kb = side->kb;
 6121:       
 6122:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 6123: 
 6124:       // interpolates vertically the density gradient of the two elements at the half level/
 6125: 
 6126:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 6127:       int k2 = max(kb, nvrt / 2);
 6128: 
 6129:       // Starts the integration at the surface and goes down to the bottom
 6130:       side->bcc[nvrt-1] = {0.0, 0.0};
 6131:       for (int k = nvrt - 2; k >= kb; k--) {
 6132:       // For each prism level (from surface to bottom)...
 6133: 
 6134:          // For both elements, interpolate density gradient at the side's half level.
 6135:          // The gradient at the side is the average of the gradients at the elements.
 6136:          // w1, w2 are used to take into account boundary sides, with just one element.
 6137:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 6138:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 6139:          const double wsum = w1 + w2;
 6140:          w1 = w1/wsum;
 6141:          w2 = w2/wsum;
 6142:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 6143: 
 6144:          // Linear interpolation of both elements' density gradient at the shared side's level.
 6145:          Vector2 gradRho = {0.0, 0.0};
 6146:          if (e1 != nullptr && k > kb) {
 6147:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 6148:             
 6149:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 6150:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 6151:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6152: 
 6153:             // Grad(rho) vertically interpolated at the side's half level
 6154:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 6155: 
 6156:             // Projects the element density gradient to the side frame if needed.
 6157:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 6158: 
 6159:             // Adds the contribution of the density gradient at the side's half level
 6160:             gradRho += gradRho1*w1;
 6161:          }      
 6162:          if (e2 != nullptr && k > kb) {
 6163:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 6164:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 6165:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6166:             
 6167:             // Grad(rho) vertically interpolated at the side's half level
 6168:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 6169: 
 6170:             // Projects the element density gradient to the side frame if needed.
 6171:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 6172: 
 6173:             // Adds the contribution of the density gradient at the side's half level
 6174:             gradRho += gradRho2*w2;
 6175:          }
 6176: 
 6177:          
 6178:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 6179:          // multiplied by -rampbc*(g/rho0) 
 6180:          const double grav3 = side->grav3();
 6181:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 6182: 
 6183:       } // for
 6184: 
 6185:    }
 6186: 
 6187: 
 6188: 
 6189:    __global__ void computeHorGradientAtSide(void) {
 6190: 
 6191:       // Compute the horizontal density gradient at each element.
 6192:       // It works in two steps:
 6193:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6194:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6195:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6196:       //             gradRho.r1 = rho1 - rho0
 6197:       //             gradRho.r2 = rho2 - rho0
 6198:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6199:       // 
 6200:       //  NOTE: We use de-meaned densities.
 6201: 
 6202:       SIDE(side);
 6203: 
 6204: 
 6205:       if (side->isDry) return;
 6206: 
 6207:       // Computes the gradient of the variables at the side center.
 6208:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 6209:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 6210:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 6211: 
 6212:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 6213:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 6214:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 6215:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 6216: 
 6217:    }
 6218: 
 6219: 
 6220:    __global__ void solveMomentumEquations(double time) {
 6221: 
 6222:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 6223:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 6224: 
 6225:       SIDE(side);
 6226: 
 6227:       if (side->isDry) 
 6228:       {
 6229:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 6230: 
 6231:          return;
 6232:       }
 6233: 
 6234:       const Node *n1 = side->n1;
 6235:       const Node *n2 = side->n2;
 6236: 
 6237:       const int kb = side->kb;
 6238: 
 6239:       const double veg_h = side->veg_h();
 6240:       const double grav3 = side->grav3();
 6241: 
 6242:       if (side->is2D()) {
 6243:          // Remember: Do not use htot2, which is updated.
 6244:          const double htot = side->htot1();
 6245:          const double hhat = side->hhat;
 6246: 
 6247:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 6248: 
 6249:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6250:          const Vector2 tau2 = side->tau();
 6251: 
 6252:          // hat_gam has units of m/s
 6253: 
 6254:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 6255:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 6256:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 6257: 
 6258:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 6259: 
 6260: 
 6261:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 6262: 
 6263:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 6264: 
 6265:       }
 6266:       else { // 3D
 6267: 
 6268:          // For 3D it is necessary to solve an implicit tridiagonal system.
 6269:          // 
 6270:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 6271:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 6272:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 6273:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 6274:          // k+1 and k.
 6275: 
 6276: 
 6277:          const int ndim = nvrt - kb;
 6278:          const double zTopCanopy = side->zTopCanopy();
 6279: 
 6280:          // Initialize the tridiagonal system
 6281:          for (int k = kb + 1; k < nvrt; k++) {
 6282:             
 6283:             const int kin = k - (kb + 1);
 6284: 
 6285:             // Vertical viscosity at the face center
 6286:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 6287: 
 6288:  
 6289:             alow[kin] = 0.0;
 6290:             cupp[kin] = 0.0;
 6291:             bdia[kin] = 0.0;
 6292: 
 6293:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 6294:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 6295: 
 6296:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 6297:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 6298:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 6299: 
 6300:             // First part: layers k, k+1
 6301:             if (k < nvrt - 1) {
 6302:                              
 6303:                if constexpr(iveg != 0) {
 6304: 
 6305:                   // If there is vegetation at this level...
 6306:                   if (zTopCanopy > side->zc[k]) {
 6307:                      // If the canopy is above the k layer...
 6308:                      
 6309:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 6310:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 6311:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 6312:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 6313: 
 6314:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 6315:                      const double vmag2 = length(ut2);
 6316:                      const double vmag1 = length(side->u2[k]);
 6317:                      const double vmag = 0.5*(vmag1 + vmag2);
 6318:                      
 6319:                      // Computes the vegetation alpha at the face center
 6320:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 6321: 
 6322:                      cff1 += veg_alpha_sd*dt*vmag;
 6323: 
 6324:                   } // if (zTopCanopy
 6325:                } // if iveg
 6326: 
 6327:                const double dzz = side->Dz(k + 1);
 6328:                const double tmp = dt*dfz/dzz;
 6329:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6330: 
 6331:                cupp[kin] += cff1*dzz/6.0 - tmp;
 6332:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6333:             }
 6334: 
 6335: 
 6336:             // Second part: layers k-1, k
 6337:             if (k > kb + 1) {
 6338: 
 6339:                double cff1 = 1.0; //init \bar{c^k}
 6340: 
 6341:                if constexpr(iveg != 0) {
 6342:                   // If there is vegetation at this level...
 6343:                   if (zTopCanopy > side->zc[k-1]) {
 6344:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 6345:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 6346: 
 6347:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 6348: 
 6349:                      const double vmag2 = length(ut2);
 6350:                      const double vmag1 = length(side->u2[k-1]);
 6351:                      const double vmag = 0.5*(vmag1 + vmag2);
 6352: 
 6353:                      // Computes the vegetation alpha at the face center
 6354:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 6355:                      cff1 += veg_alpha_sd*dt*vmag;
 6356:                   } // if zTopCanopy
 6357: 
 6358:                } // if iveg
 6359: 
 6360:                const double dzz = side->Dz(k);
 6361:                const double tmp = dt*dfz/dzz;
 6362:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6363: 
 6364:                alow[kin] += cff1*dzz/6.0 - tmp;
 6365:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6366: 
 6367:             } else { // Bottom boundary
 6368:                // This occurs at the bottom, where the bottom drag is applied.
 6369: 
 6370:                bdia[kin] += dt*side->chi2; // XXXX
 6371: 
 6372:             } // if (k > kb + 1)
 6373: 
 6374: 
 6375:          } // for (int k
 6376: 
 6377: 
 6378: 
 6379:          // Computes the RHS.
 6380:          // -----------------
 6381: 
 6382:          //	BC to be imposed at the end.
 6383: 
 6384:          const Vector2 gradETP  = side->gradETP;
 6385:          const Vector2 gradPr   = side->gradPr;
 6386:          const Vector2 gradEta1 = side->gradEta1;
 6387:          const Vector2 gradEta2 = side->gradEta2;
 6388: 
 6389:          const Vector2 *btu = side->btu;
 6390:          const Vector2 *u2  = side->u2;
 6391:          const double coriolis = side->coriolis;
 6392:          const Vector2 *nuGradU = side->nuGradU;
 6393: 
 6394:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 6395:          for (int k = kb + 1; k < nvrt; k++) {
 6396:             const int kin = k - kb - 1;
 6397: 
 6398:             const double dz_0 = side->Dz(k);
 6399:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 6400: 
 6401:             rrhs[kin] = {0.0, 0.0};
 6402:             double dz = 0.0;
 6403: 
 6404:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 6405:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 6406:             if (k < nvrt  ) dz += dz_1;
 6407:             if (k > kb + 1) dz += dz_0;
 6408: 
 6409:             // Elevation gradient, atmospheric pressure and tidal potential
 6410:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 6411: 
 6412:             // Coriolis, advection, wind stress, and horizontal viscosity
 6413:             if (k < nvrt - 1) {
 6414: 
 6415: 
 6416:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 6417:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 6418:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 6419:                                                 
 6420: 
 6421:                //diff stress tensors 1006
 6422:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 6423:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 6424:                   assert(false && "Not implemented: itur == 5");
 6425:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 6426:                }
 6427:                // else assert(false && "itur # Not implemented");
 6428: 
 6429:             } else { // k == nvrt - 1 SURFACE
 6430:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6431:                const Vector2 tau2 = side->tau();
 6432: 
 6433:                rrhs[kin] += dt*tau2;          
 6434: 
 6435:             } // if k<nvrt
 6436: 
 6437: 
 6438:             if (k > kb + 1) {
 6439:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 6440:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 6441:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 6442: 
 6443:                // diff stress tensors 1006
 6444:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 6445:                   assert(false && "Not implemented: itur == 5");
 6446:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 6447:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 6448:                }
 6449:                // else assert(false && "itur # Not implemented");
 6450: 
 6451: 
 6452:             } // if k>kbs + 1
 6453: 
 6454:             // Baroclinic
 6455:             Vector2 *bcc = side->bcc;
 6456:             if constexpr(ibc == 0) {
 6457:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 6458:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 6459: 
 6460:             } // if ibc==0
 6461: 
 6462:          } // k=kb + 1,nvrt
 6463: 
 6464: 
 6465:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 6466: 
 6467:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 6468:             const int kin = k - kb - 1;
 6469:    
 6470:             // Velocity is always clamped to maximum values
 6471:             side->u2[k] = clampVelocity(soln[kin]);
 6472:          } // k
 6473: 
 6474:       } // if side->is2D()
 6475:       
 6476: 
 6477:       // Impose velocity boundary condition at the bottom
 6478:       if constexpr(imm == 2) { // 3D bed deformation model
 6479:          double dep;
 6480:          Vector2 vel;
 6481: 
 6482:          assert(false && "Not implemented: imm == 2");
 6483:          //update_bdef(time, x0, y0, dep, vel);
 6484:          // side->u2[kb] = vel;
 6485: 
 6486:       } else { // imm = 0 or 1
 6487:          if (side->Cd() == 0.0) {
 6488:             side->u2[kb] = side->u2[kb + 1];
 6489: 
 6490:          } else if (side->is3D()) { // 3D no slip bottom   
 6491:             side->u2[kb] = {0.0, 0.0};
 6492: 
 6493:          }
 6494:           
 6495:       } // if imm
 6496: 
 6497:       // The velocities below the bottom level are set to zero
 6498:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 6499: 
 6500: 
 6501:    }
 6502: 
 6503: 
 6504:    __global__ void applyMomentumBC(void) {
 6505: 
 6506:       SIDE_BND(sideBnd);
 6507: 
 6508:       Side *side = sideBnd->side;
 6509:       const BoundarySegment *segment = sideBnd->segment;
 6510:       const Node *n1 = side->n1;
 6511:       const Node *n2 = side->n2;
 6512: 
 6513:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 6514: 
 6515:       const bool isLand = segment->isLand;
 6516:       const int ifltype = segment->ifltype;
 6517: 
 6518:       const int kb = side->kb;
 6519: 
 6520: 
 6521:       if (!isLand && ifltype != 0) {
 6522:          const Vector2 *ubc = sideBnd->ubc;
 6523:   
 6524:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 6525:             
 6526:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 6527:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 6528: 
 6529:             if (ifltype == -1) {
 6530:                // Flather 1
 6531: 
 6532:                const double depth = side->depth();
 6533: 
 6534:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 6535: 
 6536:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 6537: 
 6538:                side->u2[k] = vnorm*side->n;
 6539: 
 6540:             } else if (ifltype == -2) { // Discharge
 6541: 
 6542:                const double eta1 = side->eta1();
 6543:                const double eta2 = side->eta2();
 6544:                const double htot = side->htot2();
 6545: 
 6546:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 6547:                assert(false && "Not implemented: Discharge bc");
 6548:                // const double dischrg = discharge(eta1);
 6549:                const double dischrg = 0.0; // XXX REMOVE
 6550:                
 6551: 
 6552:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 6553: 
 6554:                const double vnorm = dischrg*eta2/htot;
 6555: 
 6556:                side->u2[k] = vnorm*side->n;
 6557: 
 6558:             }
 6559:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 6560:                const double vnorm = dot(side->u2[k], side->n);
 6561: 
 6562:                double rat;
 6563:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 6564:                else              rat = segment->vobc2; // outgoing
 6565: 
 6566:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 6567: 
 6568:             }
 6569:             else { // not Flather or 3D radiation
 6570:                side->u2[k] = ubc[k];
 6571: 
 6572:             } // if (segment->ifltype...
 6573: 
 6574:          }
 6575: 
 6576:       }
 6577:       else if (isLand) { // if it is land boundary side
 6578: 
 6579:          if constexpr(islip == 0) { // free slip
 6580: 
 6581:             for (int k = kb; k < nvrt; k++) {
 6582: 
 6583:                const Vector2 t = side->t();
 6584:                const Vector2 n = side->n;
 6585: 
 6586:                double vnorm = 0.0; // for most cases
 6587:                const double vtan = dot(side->u2[k], t);
 6588:                
 6589:                side->u2[k] = vtan*t - vnorm*n;
 6590: 
 6591:             }
 6592: 
 6593:          } else { // no slip
 6594:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 6595: 
 6596:          }
 6597:       } // if (side segment type...
 6598: 
 6599:    }
 6600: 
 6601: 
 6602:    __global__ void shapiroFilter1(void) {
 6603:       // First step of the Shapiro filter (normally used if indvel<=0)
 6604:       // Computes the filtered values and stores them in bcc (as a temporary array).
 6605: 
 6606:       SIDE(side);
 6607: 
 6608:       // Only internal wet sides are processed
 6609:       if (side->isDry || !(side->isInternal())) return;
 6610: 
 6611:       const int kb = side->kb;
 6612: 
 6613:       for (int mm = 0; mm < niter_shap; mm++) {
 6614: 
 6615:          for (int k = kb + 1; k < nvrt; k++) {
 6616:             // WARNING: reusing bcc as a temporary array to store the suru values.
 6617:             Vector2 suru = {0.0, 0.0};
 6618: 
 6619:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 6620: 
 6621:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 6622: 
 6623:                int kin = k;
 6624:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 6625:                
 6626:                // Get the velocity at the neighbor's side.
 6627:                Vector2 nSideU2 = nSide->u2[kin];
 6628: 
 6629:                // Projects the velocity to the current side frame if needed.
 6630:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 6631: 
 6632:                suru += nSideU2;
 6633:             }
 6634: 
 6635:             // Reusing bcc as a temporary array to store the suru values.
 6636:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 6637: 
 6638:          }
 6639:       }
 6640:    }
 6641: 
 6642:    __global__ void shapiroFilter2(void) {
 6643:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6644: 
 6645:       SIDE(side);
 6646: 
 6647: 
 6648:       if (side->isDry || !(side->isInternal())) return;
 6649: 
 6650:       const int kb = side->kb;
 6651: 
 6652:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6653: 
 6654:       if (side->is2D()) {
 6655:          side->u2[kb + 1] = side->bcc[kb + 1];
 6656:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6657: 
 6658:       } else {
 6659:          // 3D
 6660:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6661:          
 6662:       }
 6663: 
 6664:    }
 6665: 
 6666: 
 6667:    __global__ void ul0UpdateZCoords(void) {
 6668:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6669:       
 6670:       NODE(node);      
 6671: 
 6672: 
 6673:       if (false) { //node->isDry) { XXXXXXX
 6674: 
 6675:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6676: 
 6677:          if constexpr(ivcor != 1) node->kb = 0;
 6678: 
 6679:       } else {
 6680: 
 6681:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6682:          node->updateKb();
 6683: 
 6684:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6685: 
 6686:       }
 6687: 
 6688:       // We use the temp.b field to store the previous state of isDry.
 6689:       node->tmp.b = node->isDry;
 6690: 
 6691:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6692:       node->isDry = true;
 6693: 
 6694:    }
 6695: 
 6696:    __global__ void ul0ComputeDryElements(void)
 6697:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6698:    {
 6699:       ELEM(elem);
 6700: 
 6701:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6702: 
 6703:       elem->kb = 0;
 6704: 
 6705:       if (elem->isDry) return;
 6706: 
 6707: 
 6708:    //    if(elem->isDry2()) { // XXXX
 6709:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6710:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6711:    //        call parallel_abort(errmsg)
 6712:    //    }
 6713: 
 6714:       const Node *n1 = elem->nodes[0];
 6715:       const Node *n2 = elem->nodes[1];
 6716:       const Node *n3 = elem->nodes[2];  
 6717:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6718: 
 6719:       // Computes element's kb as the minimum of the nodes' kb.
 6720:       const int kb1 = n1->kb;
 6721:       const int kb2 = n2->kb;
 6722:       const int kb3 = n3->kb;
 6723:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 6724: 
 6725: 
 6726:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6727: 
 6728: 
 6729:       // Computes the element z as the mean of the nodes z.
 6730:       for (int k = elem->kb; k < nvrt; k++) {
 6731: 
 6732:          // Compute the element z as the mean of the nodes z.
 6733:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6734:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6735:          elem->z[k] /= elem->i34;
 6736: 
 6737:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 6738:       }
 6739:                   
 6740:    }
 6741: 
 6742:    __global__ void ul0ComputeDryNodes(void)
 6743:    // Updates node's isDry based on the elements' isDry. 
 6744:    {
 6745:       NODE(node);
 6746: 
 6747:       node->isDry = true;
 6748: 
 6749:       // A node is wet if at least one of the elements sharing it is wet.
 6750:       for (int j = 0; j < node->numElements; j++) {
 6751:          const Element *elem = node->elements[j];
 6752:          if (!elem->isDry) {
 6753:             node->isDry = false;
 6754:             break;
 6755:          }
 6756:       }
 6757: 
 6758:        
 6759:    }
 6760: 
 6761: 
 6762:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6763:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6764:    // node->tmp.b is true if the node was previously dry.
 6765:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6766:    {
 6767:       NODE(node);
 6768:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6769: 
 6770:       // Avoid this the first time step.
 6771:       if (it == iths) return;  
 6772: 
 6773:       const bool wasDry = node->tmp.b;
 6774: 
 6775: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6776: 
 6777:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 6778: 
 6779:          for (int k=0; k < nvrt; k++) {
 6780: 
 6781:             Vector3 utmp={0.0, 0.0, 0.0};
 6782: 
 6783:             double ttmp=0.0;
 6784:             double stmp=0.0;
 6785:             int icount=0;
 6786:             for (int j = 0; j < node->numNodes; j++) {
 6787: 
 6788:                const Node *nbrNode = node->nodes[j];
 6789:                
 6790:                const bool wasNbrDry = nbrNode->tmp.b;
 6791: 
 6792:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 6793:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 6794: 
 6795:                   icount++;
 6796: 
 6797:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6798:                   utmp += nbrNode->uvw2(k);
 6799:                   
 6800:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 6801:                   stmp += nbrNode->tracers[k].tracer[1]; 
 6802:                }
 6803:             }
 6804: 
 6805:             if (icount > 0) {
 6806:                const double inv_icount = 1.0/icount;
 6807:                utmp = inv_icount*utmp;
 6808:                node->u2[k]     = {utmp.x, utmp.y};
 6809:                node->w2[k]     = utmp.z;
 6810:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6811:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6812:             } else {
 6813:                node->u2[k] = {0.0, 0.0};
 6814:                node->w2[k] = 0.0;
 6815:                // Initialize tracers to 0.0??? XXXXX
 6816:             }
 6817:          }
 6818:       }
 6819:    }
 6820: 
 6821:   
 6822:    
 6823: 
 6824: 
 6825:    __global__ void ul0UpdateSides(int it, int iths) {
 6826:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 6827:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 6828:    // The dryness of the sides is updated in ul0UpdateSides2.
 6829: 
 6830:       SIDE(side);
 6831: 
 6832:       // A side is wet if and only if at least one of its elements is wet.
 6833:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6834:  
 6835:       const Node *n1 = side->n1;
 6836:       const Node *n2 = side->n2;
 6837:      
 6838:       const int kb1 = n1->kb;
 6839:       const int kb2 = n2->kb;
 6840: 
 6841:       side->kb = 0; // default when dry
 6842: 
 6843:       if (isWet) {
 6844: 
 6845:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6846: 
 6847:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6848: 
 6849:          side->kb = min(kb1, kb2);
 6850: 
 6851:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6852: 
 6853:          for (int k = side->kb; k < nvrt; k++) {
 6854:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6855: 
 6856:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 6857: 
 6858:             // Compute velocity for re-wetted sides 
 6859:             if ((it != iths) && (side->isDry && isWet)) {
 6860: 
 6861:                Vector2 utmp={0.0, 0.0};
 6862: 
 6863:                int icount=0;
 6864: 
 6865:                // For all the sides on the two elements that share this side
 6866:                for (int j = 0; j < 2; j++) {
 6867:                   const Element *elem = side->elems[j];
 6868:                   if (elem == nullptr) continue;
 6869: 
 6870:                   for (int jj=0; jj < elem->i34; jj++) {
 6871:                      const Side *nSide = elem->sides[jj];
 6872:                      if (nSide->isDry) continue;
 6873: 
 6874:                      icount++;
 6875:                      utmp += nSide->u2[k];  
 6876:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 6877:                   }
 6878:                }
 6879:                   
 6880:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 6881:                if (icount > 0)  side->u2[k] = utmp/icount;
 6882:                else             side->u2[k] = {0.0, 0.0};
 6883:                   
 6884:             } // if ((it != iths) && (side->isDry && isWet))
 6885: 
 6886:          } // for k
 6887: 
 6888:       } // if isWet 
 6889:       
 6890: 
 6891: 
 6892:    }
 6893: 
 6894:    __global__ void ul0UpdateSides2(void) {
 6895:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 6896:    
 6897:          SIDE(side);
 6898:    
 6899:          const Element *e1 = side->elems[0];
 6900:          const Element *e2 = side->elems[1];
 6901: 
 6902:          // A side is wet if and only if at least one of its elements is wet.
 6903:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 6904: 
 6905:          // Update the side's dryness
 6906:          side->isDry = !isWet;
 6907: 
 6908:    }
