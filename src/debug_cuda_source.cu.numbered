 6408:    __global__ void resetBoundaryAreas(void) {
 6409:       // Reset boundary areas and lengths for each segment.
 6410: 
 6411:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 6412:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 6413:       SIDE_BND(sideBnd);
 6414: 
 6415:       BoundarySegment *segment = sideBnd->segment;
 6416: 
 6417:       segment->carea = 0.0;
 6418:       segment->clen = 0.0;
 6419:  
 6420:    }
 6421: 
 6422:    __global__ void computeBoundaryAreas(void) {
 6423:    // Calculation of cross-section areas and lengths for flow b.c.
 6424: 
 6425:       SIDE_BND(sideBnd);
 6426: 
 6427:       const Side *side = sideBnd->side;
 6428:       BoundarySegment *segment = sideBnd->segment;
 6429: 
 6430:       if (segment->ifltype != 0) {
 6431: 
 6432:          const Node *n1 = side->n1;
 6433:          const Node *n2 = side->n2;
 6434: 
 6435:          const double htot = side->htot2();
 6436: 
 6437:          if (!side->isDry) {
 6438:             atomicAdd(&segment->carea, htot*side->len);
 6439:             atomicAdd(&segment->clen, side->len);
 6440:          }
 6441:       }
 6442: 
 6443:    }
 6444: 
 6445: 
 6446:    __global__ void computeFlowBcVelocities(double time) {
 6447: 
 6448:       SIDE_BND(sideBnd);
 6449: 
 6450:       const Side *side = sideBnd->side;
 6451:  
 6452:       const bool isDry = side->isDry;
 6453:       const bool isLand = sideBnd->segment->isLand;
 6454: 
 6455:    
 6456:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 6457: 
 6458:       if (isDry || isLand) return;
 6459: 
 6460:       // For wet sides in open boundaries...
 6461:       const Vector2 n = side->n;
 6462:       const BoundarySegment *segment = sideBnd->segment;
 6463: 
 6464:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 6465: 
 6466:       const int ifltype = segment->ifltype;
 6467: 
 6468:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 6469:       const Vector2 r_nuth0 = r_uth0*n;
 6470: 
 6471: 
 6472:       if (ifltype == 1 || ifltype == 2) {
 6473:       
 6474:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 6475: 
 6476:          const double unth0 = segment->qthcon*ramp/segment->carea;
 6477: printf("unth0: %f, qthcon: %f, ramp: %f, carea: %f\n", unth0, segment->qthcon, ramp, segment->carea);         
 6478:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 6479:          
 6480:       } else if (ifltype == -1) { // Flather 1
 6481: 
 6482:          for (int k = 0; k < nvrt; k++) {
 6483: 
 6484:             // uth is the normal vel.; no ramp up
 6485:             const double uth = sideBnd->nuth(k);
 6486:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 6487: 
 6488:             sideBnd->ubc[k] += uth*n;
 6489:          }
 6490: 
 6491:       } else if (ifltype == 3 || ifltype == 5) {
 6492:          // vnth0=0 !normal vel.
 6493: 
 6494:          Vector2 r_u1_bar = {0.0, 0.0};
 6495:          // Computes the contribution to the velocity from all tide frequencies
 6496:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 6497: 
 6498:             const Vector2 ufa  = sideBnd->ufa[jfr]; 
 6499:             const Vector2 umo  = sideBnd->umo[jfr]; 
 6500: 
 6501:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 6502:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 6503:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 6504:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 6505: 
 6506:          }
 6507: 
 6508: 
 6509:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 6510: 
 6511:       } // if (ifltype = 3 || ifltype == 5
 6512: 
 6513: 
 6514: 
 6515:    }
 6516: 
 6517:    __global__ void computeElevationBoundaryConditions(double time) {
 6518:       // Compute elevation essential boundary conditions 
 6519: 
 6520:       NODE_BND(nodeBnd); // Each boundary node.
 6521: 
 6522:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 6523: 
 6524:       const Node *node = nodeBnd->node;
 6525:       const BoundarySegment *segment = nodeBnd->segment;
 6526:       const int iettype = segment->iettype;
 6527:       
 6528: 
 6529:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 6530:       double eic = 0.0;
 6531:       if (nramp_elev == 1) eic = nodeBnd->etaic;  // XXXX is etaic ever set?  
 6532:       else                 eic = 0.0;
 6533: 
 6534:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 6535:       const double r_eth = ramp*nodeBnd->eth;
 6536:       double r_eta1_bar = 0.0;
 6537: 
 6538:       // Compute tide elevation
 6539:       if (iettype == 3 || iettype == 5) {   
 6540: 
 6541:          if constexpr(iloadtide==1) { // loading tide
 6542:             assert(false && "Loading tide not implemented");
 6543:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 6544:          }
 6545:          
 6546:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 6547: 
 6548:             const double efa  = nodeBnd->efa[jfr]; 
 6549:             const double emo  = nodeBnd->emo[jfr]; 
 6550: 
 6551:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 6552:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 6553:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 6554: 
 6555: 
 6556:          } // for jfr
 6557: 
 6558:       } // if iettype
 6559: 
 6560:       switch (iettype) {
 6561:          case 1:
 6562:          case 2:
 6563:          case 4:
 6564:             nodeBnd->elbc = r_eic + r_eth;
 6565:             break;
 6566:          case 3:
 6567:             nodeBnd->elbc = r_eic + r_eta1_bar;
 6568:             break;
 6569:          case 5:
 6570:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 6571:             break;
 6572:       } // switch
 6573: 
 6574: 
 6575:       //Add inverse barometric effects
 6576:       if (iettype != 0 && inv_atm_bnd == 1) {
 6577:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 6578:       }
 6579: 
 6580:    }
 6581: 
 6582: 
 6583:    __global__ void computeHorizontalViscosity(void) { 
 6584: 
 6585:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 6586: 
 6587:       SIDE(side);
 6588: 
 6589:       if (side->isDry) return;
 6590: 
 6591:       for (int k = 0; k < nvrt; k++) {
 6592:          side->nuGradU[k] = {0.0, 0.0};
 6593:       }
 6594: 
 6595:       if constexpr(ihorcon == 1) {
 6596:          for (int k = side->kb; k < nvrt - 1; k++) {
 6597:             // Computes the Laplacian by using the simplified formula presented in the paper:
 6598:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 6599:             // By Zhang and Baptista.
 6600: 
 6601:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 6602:             // This is a standard discretization of the Laplacian operator.
 6603:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 6604:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 6605:             // Gamma is hvis_coef0 in the code.
 6606:             // The value of gamma needs to be < 0.5.
 6607: 
 6608:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 6609:             // side under consideration in each of the two possible elements that share the side.
 6610:             Vector2 sumU = {0.0, 0.0};
 6611:             for (int l = 0; l < 2; l++) {
 6612:                const Element *elem = side->elems[l];
 6613: 
 6614:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 6615: 
 6616:                // Find the local index of the side in the element
 6617:                const int idxSide = elem->sideLocalIdx(side);
 6618: 
 6619:                // Find the two sides that are connected to the side under consideration
 6620:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 6621:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 6622: 
 6623:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 6624: 
 6625:             }
 6626: 
 6627:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 6628: 
 6629:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 6630:    
 6631:          }
 6632:       }
 6633:       else if constexpr(ihorcon == 2) {
 6634:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 6635:       }
 6636: 
 6637: 
 6638:    }
 6639: 
 6640: 
 6641:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 6642: 
 6643:       // Set essential boundary conditions 
 6644:       NODE(node); // Each boundary node
 6645:       NodeBoundary *nodeBnd = node->nodeBnd;
 6646:       
 6647:  
 6648:       // Check if this node has essential BC
 6649:       if (nodeBnd && nodeBnd->isEssentialBC) {
 6650: 
 6651:          // Verify BC value is valid
 6652:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 6653: 
 6654:        
 6655:          // Set diagonal to 1 and zero off-diagonals
 6656:          for (int j = 0; j <= node->numNodes; j++) {
 6657:                node->coeffRow[j] = 0.0;
 6658:          }
 6659: 
 6660:          *(node->coeffDiag) = 1.0;
 6661: 
 6662: 
 6663:          // Set solution and RHS to BC value
 6664:          node->mX  = nodeBnd->elbc;
 6665:          node->qel = nodeBnd->elbc;
 6666: 
 6667:       } else {
 6668:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 6669: 
 6670:          for (int j = 0; j < node->numNodes; j++) {
 6671:                const Node* nbNode = node->nodes[j];
 6672:    	         assert(nbNode != nullptr && "setEssentialBC: nbNode is nullptr");
 6673: 
 6674:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 6675: 
 6676:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 6677:                   // Verify neighbor's BC value
 6678:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 6679: 
 6680:                   // Subtract contribution to RHS
 6681:                   node->qel -= node->coeffRow[node->csrSlot[j]]*nbNodeBnd->elbc;
 6682:                   node->coeffRow[node->csrSlot[j]] = 0.0;  
 6683:                }
 6684:          }
 6685: // printf("setEssentialBC: node->qel = nodeBnd->elbc - node->coeffMatrix[j]*nbNodeBnd->elbc\n");
 6686:       }
 6687:    }
 6688: 
 6689: 
 6690:    __global__ void updateElevation(void) {
 6691:       NODE(node);
 6692: 
 6693: 
 6694:       node->eta2 = node->mX;
 6695: 
 6696:       node->updateZCoordData();
 6697:    }
