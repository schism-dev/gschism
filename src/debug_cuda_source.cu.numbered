  425: struct Tracers {
  426:     double tracer[N_TRACERS];
  427: };
  428: 
  429: 
  430: 
  431: struct Frame {
  432:    // Column 0 (East):  (-sin_lon, cos_lon, 0)              — store 2 values, t20=0 implicit
  433:    // Column 1 (North): Normalized oblate ellipsoid vector  — store 3 values
  434:    // Column 2 (Up):    cross(col0, col1)                   — recomputed on demand
  435:     double t00, t10;        // col0 (t20=0 implicit)
  436:     double t01, t11, t21;   // col1
  437: 
  438:    __device__ void update(double lat, double lon) { // XXX use lat, lon instead of ar1, ar2?
  439: 
  440:       double sin_lon, cos_lon, sin_lat, cos_lat;
  441:       sincos(lon, &sin_lon, &cos_lon); // These functions are faster than sin(ar1) and cos(ar1).
  442:       sincos(lat, &sin_lat, &cos_lat);
  443: 
  444:       t00 = -sin_lon;
  445:       t10 =  cos_lon;
  446:       t01 = -cos_lon*sin_lat;
  447:       t11 = -sin_lon*sin_lat;
  448:       t21 = (rearth_pole/rearth_eq)*cos_lat;
  449: // printf("lat = %f, lon = %f, cos_lat = %f, sin_lat = %f, cos_lon = %f, sin_lon = %f\n", lat, lon, cos_lat, sin_lat, cos_lon, sin_lon);
  450: // printf("t00 = %f, t10 = %f, t01 = %f, t11 = %f, t21 = %f\n", t00, t10, t01, t11, t21);
  451: 
  452:       const double col1_norm = sqrt(t01*t01 + t11*t11 + t21*t21);
  453:       assert (col1_norm != 0.0 && "GRID: col1_norm=0");
  454: 
  455:       const double col1_norm_inv = 1.0/col1_norm;
  456:       t01 = t01*col1_norm_inv;
  457:       t11 = t11*col1_norm_inv;
  458:       t21 = t21*col1_norm_inv;
  459: 
  460:       // The 3rd column (col2) is the cross product of the first two and is computed when needed.
  461: 
  462:    }
  463: 
  464:    __forceinline__ __device__ void print(void) const {
  465:       printf("frame = [%.16f, %.16f, %.16f, %.16f, %.16f]\n", t00, t10, t01, t11, t21);
  466:    }
  467: 
  468:    __forceinline__ __device__ void getCol2(double &t02, double &t12, double &t22) const {
  469:       // cross(col0, col1), with t20=0 implicitly:
  470:       // |  i       j       k   |
  471:       // | t00     t10      0   |
  472:       // | t01     t11     t21  |
  473:       t02 =  t10*t21;
  474:       t12 = -t00*t21;
  475:       t22 =  t00*t11 - t10*t01;
  476:    }
  477: 
  478: 
  479:    __forceinline__ __device__ Vector2 projHorVec(Vector2 const &vec0, Frame const &frameout) const {
  480:    // Transforms a horizontal vector from one frame to another and projects it to the new local horizontal plane.
  481:    // Inputs:
  482:    //        vec0: vel. in this frame;
  483:    //        frameout: Output frame;
  484:    // Output: 
  485:    //        vel. in new frame  
  486:    //
  487:    // Projects a horizontal vector from frame 1 (this) to frame 2 (frameout),
  488:    // discarding the z-component of the result to keep only the local horizontal
  489:    // plane of frame 2.
  490:    //
  491:    // Since F1 and F2 are global-to-local rotation matrices, transforming from
  492:    // frame 1 to frame 2 requires F2 * F1^{-1} = F2 * F1^T, as rotation matrices
  493:    // are orthogonal. This product is computed as dot products between columns of
  494:    // F1 and columns of F2, which is equivalent to multiplying rows of F1^T by
  495:    // columns of F2.// 
  496: 
  497:       auto const fo = frameout; // Just an alias for the output frame.
  498:       Vector2 res;
  499: 
  500:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  501:       // of t and fo.t are the same.
  502:       const double d00 = t00*fo.t00 + t10*fo.t10;
  503:       const double d10 = t01*fo.t00 + t11*fo.t10;
  504: 
  505:       const double d01 = t00*fo.t01 + t10*fo.t11;
  506:       const double d11 = t01*fo.t01 + t11*fo.t11 + t21*fo.t21;
  507: 
  508:       res.x = vec0.x * d00 + vec0.y * d10;
  509:       res.y = vec0.x * d01 + vec0.y * d11;
  510: 
  511:       return res;
  512:    }
  513: 
  514:    __forceinline__ __device__ Vector3 G2L(Vector3 const &vi) const {
  515:       Vector3 vo;
  516:       double t02, t12, t22;
  517: 
  518:       getCol2(t02, t12, t22);
  519: 
  520:       vo.x = vi.x*t00 + vi.y*t10;
  521:       vo.y = vi.x*t01 + vi.y*t11 + vi.z*t21;
  522:       vo.z = vi.x*t02 + vi.y*t12 + vi.z*t22;
  523: 
  524:       return vo;
  525:    
  526:    }
  527: 
  528:    __forceinline__ __device__ Vector3 L2G(Vector3 const &vi) const {
  529:       Vector3 vo;
  530:       double t02, t12, t22;
  531: 
  532:       getCol2(t02, t12, t22);
  533: 
  534:       // F * vi (non-transposed, so we use rows of F)
  535:       vo.x = vi.x*t00 + vi.y*t01 + vi.z*t02;
  536:       vo.y = vi.x*t10 + vi.y*t11 + vi.z*t12;
  537:       vo.z =            vi.y*t21 + vi.z*t22;  // t20=0 term dropped
  538: 
  539:       return vo;
  540:    }
  541: 
  542:    // __forceinline__ __device__ Point3 G2L(Point3 const &pi, Point3 const &origin0) const {
  543:    // // Tranforms a point from global to local frame     
  544:    //    return G2L(pi - origin0); // XXXX IS THIS CORRECT?
  545:    // }
  546: 
  547:    // __forceinline__ __device__ Point3 L2G(Point3 const &pi, Point3 const &origin0) const {
  548:    // // Transforms a point from local to global frame      
  549:    //    return L2G(pi) + origin0;  // XXXX IS THIS CORRECT?
  550:    // }
  551: 
  552: };
