 7127: __global__ void printMatrix(bool full) {
 7128:    // Debugging: print the matrix
 7129: 
 7130:    const int size = mesh->np;
 7131:    double sum = 0.0;
 7132:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7133:       const Node *node = mesh->localNodeData + idx_node;
 7134:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7135:       for (int j = 0; j < node->numNodes; j++) {
 7136:          Node* nbNode = node->nodes[j];
 7137:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7138:          sum += node->coeffMatrix[j];
 7139:       }
 7140:       if (full) printf("]\n");
 7141: 
 7142: 
 7143:    }
 7144:    if (!full) printf("sum=%lf\n", sum);
 7145: }
