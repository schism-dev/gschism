 6544:    __global__ void computeBottomDragVegetation(void) {
 6545:       // UNFINISHED. CHECK THIS: XXXXX
 6546:       // How many kernels are needed? Why so many for loops?
 6547:       // Is the loop on sides needed?
 6548: 
 6549:       NODE(node);
 6550: 
 6551:       const int    kb      = node->kb;
 6552:       const double htot    = node->htot2(); 
 6553:       
 6554:       if (node->isDry) {
 6555:          // Default values for dry nodes
 6556:          node->veg_alpha_vert_mean = node->veg_alpha0;
 6557:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 6558: 
 6559:          return;
 6560:        
 6561:       }
 6562: 
 6563:       // Computes bottom drag Cd based on the selected nchi
 6564:       node->computeBottomDragCd();
 6565:       
 6566: 
 6567: 
 6568:       //   Bottom stress in m^2/s^2
 6569:       if (node->rho[kb + 1] >= -98.0)
 6570:       {
 6571:          const double mag_u = length(node->u2[kb + 1]);
 6572:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 6573: 
 6574:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 6575:          // !sediment erosion: this part needs more documentation
 6576:       }
 6577:     
 6578: 
 6579: 
 6580:       // Compute vegetation parameters
 6581:       //--------------------------------
 6582: 
 6583: 
 6584:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 6585:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 6586: 
 6587:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 6588:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 6589:          int kbin = 0; // bin index
 6590:          for (int k = kb; k < nvrt; k++) {
 6591:             // Computes node height above the bottom level
 6592:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 6593:             assert(false && "Vertical variation of vegetation not implemented");
 6594: 
 6595:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 6596:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 6597:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 6598:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 6599:             // } else {
 6600:             //    // Find the bin at which the current vertical level is
 6601:             //    while (kbin<nbins_veg_vert) {
 6602:             //       const double zn = node->z[kbin];
 6603:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 6604:             //          break;
 6605:             //       } // if
 6606:             //       kbin++;
 6607:             //    } // while
 6608:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 6609: 
 6610:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 6611:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 6612:                
 6613:             //    // Linear interpolation of the vegetation parameters
 6614:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 6615:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 6616:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 6617:             // } // if rl10
 6618: 
 6619:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 6620: 
 6621:          } // for k
 6622: 
 6623: 
 6624:       } else { // Ganthy (iveg==2)
 6625:       //  Modify canopy height, diameter, and density
 6626: 
 6627:          // Make sure there is vegetation on this node
 6628:          if (node->veg_h_unbent > 0.0) {
 6629:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 6630: 
 6631:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 6632:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 6633:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 6634: 
 6635:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 6636:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 6637:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 6638:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 6639:          } // if veg_h_unbent
 6640: 
 6641:          for (int k = 0; k < nvrt; k++) {
 6642:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 6643:          } // for k
 6644:       
 6645: 
 6646:       } // if iveg
 6647:      
 6648: 
 6649:       // Compute vertical mean of veg_alpha3D
 6650:       if (iveg != 0) {
 6651:          const double ztop = node->zTopCanopy(); // Top of the canopy
 6652:          double sum1=0.0;
 6653:          double sum2=0.0;
 6654:          // Integrate over each level under the canopy...
 6655:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 6656:             const double Dz = node->Dz(k);
 6657: 
 6658:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 6659:             sum2 += Dz;
 6660: 
 6661:          } // for k
 6662:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 6663:          else             node->veg_alpha_vert_mean = sum1/sum2;
 6664: 
 6665:       } // if iveg
 6666: 
 6667:    }
