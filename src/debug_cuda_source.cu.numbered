 1507: struct Node {
 1508: 
 1509:    // Geometry information
 1510:    int idx;            // Global index of the node
 1511:    int16_t part;       // Partition of the node
 1512: 
 1513:    Node **nodes;       // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1514:    int16_t numNodes;   // Number of nodes neighbors of this node
 1515: 
 1516:    Element **elements; // Array of pointers to the elements that share this node
 1517:    int16_t numElements;// Number of elements that share this node
 1518: 
 1519:    int16_t numSides;   // Number of sides that are connected to this node
 1520: 
 1521: 
 1522:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1523:    double gz;          // Global vertical coordinate at the node.
 1524:    Vector2 u2[nvrt];
 1525:    double  w2[nvrt];
 1526:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1527:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1528:    double lon, lat;
 1529:    double depth;
 1530: 
 1531:    Frame<ics> frame;
 1532: 
 1533:    LocalSigma<ivcor> localSigma;  
 1534: 
 1535:    int16_t kb;     // Bottom index of the node
 1536: 
 1537:    bool isDry;     // True if the node is dry
 1538: 
 1539:    int16_t iadv;   // Advection flag
 1540: 
 1541:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1542:                           // this is nullptr
 1543: 
 1544:    TempVar tmp; // Temporary variable to store different types of variables
 1545: 
 1546:    // Physical information
 1547:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1548:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1549: 
 1550:    double rho[nvrt];     // Density
 1551:    double dfv[nvrt];     // Vertical viscosity
 1552: 
 1553:    double eta1; // Elevation at nodes at previous timestep
 1554:    double eta2; // Elevation at nodes at current timestep
 1555: 
 1556:    double ETP;  // Earth Tidal Potential
 1557: 
 1558:    double pr;    // Air pressure
 1559:    double grav2; // Gravity 
 1560:    
 1561:    Vector2 dav;  // Depth averaged velocity
 1562: 
 1563:    Vector2 tau; // Wind stress vector
 1564: 
 1565:    // Vegetation parameters
 1566:    double veg_h;
 1567:    double veg_nv;
 1568:    double veg_di;
 1569:    double veg_Cd;
 1570:    double veg_h_unbent;
 1571:    double veg_di_unbent;
 1572:    double veg_nv_unbent;
 1573:    double veg_alpha_vert_mean;
 1574:    double veg_alpha0;
 1575:    double veg_alpha3D[nvrt];
 1576: 
 1577:    // Bottom drag parameters
 1578:    double Cd;       // Bottom drag coefficient   
 1579: 
 1580:    // These three are mutually exclusive
 1581:    union {
 1582:       double rmanning; // Bottom Manning's coefficient
 1583:       double rough;    // Bottom roughness length
 1584:       double drag;     // Bottom drag coefficient
 1585:    };
 1586:    Vector2 tau_bot; // Bottom stress vector
 1587: 
 1588:    // XXXX REMOVE FOR IMM>0???
 1589:    double bdef1 = 0.0; // Bottom deformation at previous timestep
 1590:    double bdef2 = 0.0; // Bottom deformation at current timestep
 1591: 
 1592:    
 1593:    double qel; // RHS
 1594:    double *coeffDiag;    // Pointer to the diagonal coefficient of the matrix
 1595:    double *coeffRow;     // Pointer to the coefficients of the row of the CRS matrix for this node.
 1596:    int16_t *csrSlot;     // csrSlot[i], is the slot/index of nodes[i] entry the CRS matrix row for this node.
 1597:                          // The index of the diagonal element is coeffDiag - coeffRow.   
 1598: 
 1599:    double mX; // Solution of the FEM system
 1600: 
 1601:    // Meteorological forcing
 1602:    Vector2 u_air;
 1603:    double p_air;  // XXXX is this the same as pr?
 1604:    double t_air;
 1605:    double q_air;
 1606:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1607: 
 1608: 
 1609: 
 1610: 
 1611:    __device__ void setWind(Vector2 &u) {
 1612:    // Sets the wind vector taking into account the mesh angle
 1613:    
 1614:       const double speed = length(u);
 1615: 
 1616:       // Rotate wind vector to the node frame
 1617:       u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1618: 
 1619:       // Sets the surface stress vector due to wind.
 1620:       if constexpr(nws == 0) {
 1621:          tau = {0.0, 0.0};
 1622: 
 1623:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1624:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1625: 
 1626:       } else {
 1627: 
 1628:          double dragcoef;
 1629: 
 1630:          if constexpr(iwind_form == -1) {
 1631:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1632:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1633: 
 1634:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1635:             tau = cff*u_air;
 1636:  
 1637:          } else if constexpr(iwind_form == 1) {
 1638:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1639:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1640: 
 1641:             dragcoef = max(dragcoef, 4.0e-4);
 1642:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1643:             tau = cff*u_air;
 1644: 
 1645:          } else {
 1646:             tau = {0.0, 0.0};
 1647:          }
 1648:       }
 1649:    }
 1650: 
 1651: 
 1652:    __device__ void setFrame(double lat, double lon) {
 1653:       if constexpr(ics == 1) return;
 1654: 
 1655:       frame.update(lat, lon);        
 1656:     }
 1657: 
 1658:    //__device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1659: 
 1660:    __device__ double sigmaTransitionDepth(void) const;
 1661: 
 1662:    __device__ double computeETP(int idxTidalPotential, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const;
 1663: 
 1664:    __inline__ __device__ Point2 outputCoords(void) const {
 1665:       if constexpr(ics == 1)  return p;
 1666:       else                    return {rad2deg*lon, rad2deg*lat};
 1667:    }
 1668: 
 1669:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1670:    // If ics == 2, convert the global point to the local frame
 1671:       
 1672:       if constexpr (ics == 1) {
 1673:          return p;
 1674:       } else {
 1675:          const Point3 c = {p.x, p.y, gz};
 1676:          const Point3 local = frame.G2L(p - c);
 1677:          return local;
 1678:       }
 1679:    }
 1680: 
 1681:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1682:    // If ics == 2, convert the global point to the local frame
 1683:       
 1684:       if constexpr (ics == 1) {
 1685:          return p;
 1686:       } else {
 1687:          const Point3 c = {p.x, p.y, gz};
 1688:          return c + frame.L2G(p);
 1689:       }
 1690:    }
 1691: 
 1692:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1693:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1694:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1695:    
 1696:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1697: 
 1698:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1699: 
 1700:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1701:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1702: 
 1703:    __device__ __forceinline__ void clearMatrixRow(void) {
 1704:       // Clear the matrix row for this node
 1705: 
 1706:       for (int i = 0; i <= numNodes; i++) coeffRow[i] = 0.0;
 1707: 
 1708:    }
 1709: 
 1710:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1711:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1712:       
 1713:       if (node == this) {
 1714:          *coeffDiag += value;
 1715:          return;
 1716:       }
 1717: 
 1718:       int i;
 1719:       for (i = 0; i < numNodes; i++) {
 1720:          if (nodes[i] == node) break;
 1721:       }
 1722: 
 1723:       assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1724:       coeffRow[csrSlot[i]] += value;
 1725:    }
 1726: 
 1727: 
 1728:    __device__ __inline__ void updateZCoordData(void);
 1729: 
 1730:    __device__ __forceinline__ double compZCoord(int k) const;
 1731: 
 1732:    __device__ void updateKb(void);
 1733: 
 1734:    __device__ __forceinline__ void computeBottomDragCd(void);
 1735: 
 1736: 
 1737: 
 1738: };
