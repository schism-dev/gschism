 1970: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 1971: // return;   
 1972:    // Lock the mutex
 1973:    lock(&debugPlotMutex);
 1974:  
 1975:    bool ok = true;
 1976:    if (debugPlotIdx == nullptr) ok = false;
 1977:    if (*debugPlotIdx >= 1000000) ok = false;
 1978:    if (ok) {
 1979:       debugPlot[(*debugPlotIdx) + 0*1000000] = x1.x;
 1980:       debugPlot[(*debugPlotIdx) + 1*1000000] = x1.y;
 1981:       debugPlot[(*debugPlotIdx) + 2*1000000] = x2.x;
 1982:       debugPlot[(*debugPlotIdx) + 3*1000000] = x2.y;
 1983:       debugPlot[(*debugPlotIdx) + 4*1000000] = (double)color;
 1984:       debugPlot[(*debugPlotIdx) + 5*1000000] = (double)(((int)(unsigned char)marker & 0xFF) | ((dashLen & 0xFF) << 8) | ((width & 0xFF) << 16));
 1985:       debugPlot[(*debugPlotIdx) + 6*1000000] = (double)label;
 1986:       (*debugPlotIdx)++;
 1987:    }
 1988: 
 1989:    __threadfence();               // ensure all above writes are visible
 1990:    // Unlock the mutex
 1991:    unlock(&debugPlotMutex);
 1992: 
 1993: }
 1994: 
 1995: __device__ void addDebugPlot(Vector2 x1, Vector2 x2, unsigned int color = 0xA0A0A0, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 1996:    addDebugPlot(toPoint3(x1, 0.0), toPoint3(x2, 0.0), color, marker, width, dashLen, label);
 1997: }
