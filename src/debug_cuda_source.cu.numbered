 8163: 
 8164: __global__ void computeMatrixProductAndDotProducts() {
 8165:    // Computes A*p, r'Mr and p'Ap
 8166: 
 8167:    // 1) shared buffer: first half for rMr, second for pAp
 8168:    __shared__ double sdata[2*BLOCK_SIZE];
 8169:    double* s_rMr = sdata;
 8170:    double* s_pAp = sdata + BLOCK_SIZE;
 8171: 
 8172:    const int tid = threadIdx.x;
 8173: 
 8174:    double l_pAp = 0.0;
 8175: 
 8176:    s_rMr[tid] = 0.0;
 8177:    s_pAp[tid] = 0.0;
 8178: 
 8179:    // 2) get your node pointer
 8180:    // NODE(node);   
 8181:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 8182:    Node *node = &(mesh->localNodeData[idx_node]); 
 8183:       if (idx_node < mesh->np) {
 8184: 
 8185:       const double diag = node->coeffDiag;
 8186:       const double r    = node->mR;
 8187:       const double p    = node->mP;  
 8188: 
 8189:       // apply preconditioner on the fly:
 8190:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 8191: 
 8192:       // 4) compute Ap = A.p
 8193:       double Ap = node->coeffDiag * node->mP;
 8194:       for (int j = 0; j < node->numNodes; ++j) {
 8195:          const Node *nbNode = node->nodes[j];
 8196:          Ap += node->coeffMatrix[j] * nbNode->mP;
 8197: 
 8198:       }
 8199: 
 8200:       node->mAp = Ap;
 8201:       
 8202: 
 8203:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 8204:       // const double l_rMr = r*Mr;  // r'Mr
 8205:       l_pAp = p*Ap;  // p'Ap
 8206: 
 8207: 
 8208:    }
 8209: 
 8210:    // 6) write into shared mem
 8211:    // s_rMr[tid] = l_rMr;
 8212:    s_pAp[tid] = l_pAp;
 8213: 
 8214:    __syncthreads();
 8215: 
 8216:    // 7) block-wide tree reduction
 8217:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8218:       if (tid < stride)  {
 8219:          s_pAp[tid] += s_pAp[tid + stride];
 8220:       }
 8221:       __syncthreads();
 8222:    }
 8223: 
 8224:    // 8) thread 0 atomically accumulates into the globals
 8225:    // XXX: This is slower than it needs to be, but it is simple and works
 8226:    if (tid == 0) {
 8227:       atomicAdd(pAp, s_pAp[0]);
 8228:    }
 8229: 
 8230: 
 8231: }
 8232: 
 8233: 
 8234: __global__ void updateSolutionAndDotProducts(void) {
 8235:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 8236: 
 8237:    const int tid = threadIdx.x;
 8238: 
 8239:    s_rMr[tid] = 0.0;
 8240: 
 8241:    // get node & bounds-check:
 8242:    NODE(node);
 8243: 
 8244:    
 8245:    // Compute alpha
 8246:    const double alpha = (*rMr_old)/(*pAp); 
 8247: 
 8248: 
 8249:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 8250: 
 8251: 
 8252:    // load scalars
 8253:    const double diag = node->coeffDiag;
 8254:    const double p    = node->mP;
 8255:    const double Ap   = node->mAp;
 8256:    const double x    = node->mX;
 8257:    const double r    = node->mR;
 8258:    
 8259:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 8260: 
 8261:    // 1) update solution & residual
 8262:    const double x_new = x + alpha*p;
 8263:    const double r_new = r - alpha*Ap;
 8264:    node->mX = x_new;
 8265:    node->mR = r_new;
 8266: 
 8267:    // 2) apply Jacobi preconditioner on the fly
 8268:    const double Mr_new = r_new/diag;
 8269: 
 8270: 
 8271:    // 3) local contributions for the two dot-products
 8272:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 8273: 
 8274:    // 4) write into shared-mem
 8275:    s_rMr[tid] = l_rMr;
 8276: 
 8277:    __syncthreads();
 8278: 
 8279: 
 8280:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8281:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8282:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8283:       __syncthreads();
 8284:    }
 8285: 
 8286:    // 6) thread 0 atomically folds into the global accumulators
 8287:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 8288: 
 8289: 
 8290: }
 8291: 
 8292: 
 8293: __global__ void updateSearchDirection() {
 8294: 
 8295:     NODE(node);
 8296: 
 8297:     // recompute z on-the-fly
 8298:     const double z = node->mR / node->coeffDiag;
 8299:     const double p = node->mP;
 8300: 
 8301:     const double beta = (*rMr_new)/(*rMr_old);
 8302: 
 8303: 
 8304:     // p =z + beta*p
 8305:     node->mP = z + beta*p;
 8306: 
 8307: }
 8308: 
 8309: __global__ void initializeScalars(double *scalars) {
 8310: 
 8311:    // These point to a cupy array in the host code
 8312:    rMr_old = scalars + 0;
 8313:    rMr_new = scalars + 1;
 8314:    pAp     = scalars + 2;
 8315: }
 8316: 
 8317: __global__ void initializePreconditionedResidual(void) {
 8318: 
 8319:     __shared__ double s_rMr[BLOCK_SIZE];  
 8320: 
 8321:     s_rMr[threadIdx.x] = 0.0;
 8322: 
 8323:     NODE_ALL(node, valid);
 8324:     const int tid = threadIdx.x;
 8325:     // For the first iteration:
 8326:     // 1. Initial solution x = 0 (already set)
 8327:     // 2. Initial residual r = b (stored in qel)
 8328:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 8329: 
 8330: // XXX we should use the guess solution here    
 8331: 
 8332:     double l_rMr = 0.0;
 8333:     if (valid) {
 8334:       // Set initial residual r = b (from qel)
 8335:       node->mR = node->qel;
 8336: 
 8337:       // Compute z = M^-1 * r (preconditioned residual)
 8338:       const double z = node->mR / node->coeffDiag;
 8339: 
 8340:       // Set initial search direction p = z
 8341:       node->mP = z;
 8342: 
 8343:       // Initialize other variables needed for CG
 8344:       node->mX = 0.0;  // Initial solution
 8345:       node->mAp = 0.0; // Will be computed in first iteration
 8346: 
 8347: 
 8348:       // Computes the first r'Mr (reduction)
 8349:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 8350:     }
 8351:     // 4) write into shared-mem
 8352:     s_rMr[tid] = l_rMr;
 8353: 
 8354:     __syncthreads();
 8355: 
 8356: 
 8357:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8358:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8359:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8360:         __syncthreads();
 8361:     }
 8362: 
 8363:     // 6) thread 0 atomically folds into the global accumulators
 8364:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 8365: 
 8366:     *rMr_old = 0.0;
 8367:     *pAp = 0.0;
 8368: }
 8369: 
