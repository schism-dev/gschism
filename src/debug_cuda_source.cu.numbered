  734: struct Element {
  735: 
  736:    // Geometry information
  737:    int idx;                   // Index of the element
  738:    int i34;                   // Number of sides for the element 
  739:    Side *sides[4];            // Sides of the element
  740:    Node *nodes[4];            // Nodes of the element
  741:    Element *nghbElems[4];     // Neighbors of the element
  742: 
  743:    int kb;                    // Bottom index of the element
  744:    double area;               // Area of the element
  745:    double ssign[4];           // Sign associated with each side of an element
  746:    double radius;             // Element equivalent radii
  747: 
  748:    Frame<ics> frame;
  749: 
  750:    Vector2 gradPhi[4];        // Derivatives of shape functions
  751:    Vector2 gradEta;           // Gradient of free surface elevation
  752:    Vector2 gradPr;            // Gradient of pressure    
  753:    Vector2 gradETP;           // Gradient of Earth Tidal Potential    XXXXX Really used?
  754: 
  755:    bool isDry;                // True if the element is dry
  756: 
  757:    Point2 center;            // Element center coordinates (global coordinates)
  758: 
  759:    double depth;              // Depth at element (min of all nodes)
  760:    double z[nvrt];            // z-coord  (local frame - vertical up)
  761: 
  762:    // Physical information
  763:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  764: 
  765:    static const bool isblock = false;              // Always false
  766: 
  767:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  768:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  769: 
  770:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  771:    
  772: 
  773:    double vsource;            // Volumetric source/sink term [m^3/s]
  774: 
  775:    double rho[nvrt];          // Density at each prism center
  776:    double rho_mean[nvrt];     // Mean density at each prism center
  777:    CubicSpline rho_spl;
  778:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  779:    double rho_z[nvrt];        // First derivative of density at each prism center
  780:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  781:    
  782: 
  783:    __inline__ __device__ Point2 outputCoords(void) const;
  784: 
  785:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }  
  786: 
  787:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
  788:    // If ics == 2, convert the global point to the local frame of the element
  789:       
  790:       if constexpr (ics == 1) {
  791:          return p;
  792:       } else {
  793:          const Point3 c = {center.x, center.y, centerZ()};
  794:          return frame.G2L(p - c);
  795:       }
  796:    }
  797: 
  798:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  799:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  800: 
  801:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  802:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  803: 
  804:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  805:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  806:       // Find the local index of the node in the element (0,1,2,3)
  807:       int res = __ffs((nodes[0] == node) | 
  808:                      ((nodes[1] == node) << 1) | 
  809:                      ((nodes[2] == node) << 2) | 
  810:                      ((nodes[3] == node) << 3)) - 1;
  811:       
  812:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  813:       return res;  
  814:    }
  815: 
  816:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  817:       // Find the local index of the side in the element (0,1,2,3)
  818:       int res = __ffs((sides[0] == side) | 
  819:                      ((sides[1] == side) << 1) | 
  820:                      ((sides[2] == side) << 2) | 
  821:                      ((sides[3] == side) << 3)) - 1;
  822:       
  823:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  824:       return res;
  825:    }
  826: 
  827:    __inline__ __device__ int findLevel(double z1, int k) const {
  828:       // Starting at index k, find sequentially the level that contains z
  829: 
  830:       // For testing purposes, forgets k and performs a full search.
  831:       for (k = kb; k < nvrt - 1; k++) {
  832:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
  833:       }
  834:       return nvrt - 2;
  835: 
  836: 
  837:       // if z is already betweeen z[k] and z[k+1], return k
  838:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
  839:       else if (z1 <  z[k]) { 
  840:          // Search for increasing levels
  841:          for (int kk = k; kk < nvrt - 1; kk++) {
  842:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  843:          }
  844:          return nvrt - 1;
  845:       }
  846:       else {
  847:          // Search for decreasing levels
  848:          for (int kk = k; kk >= kb; kk--) {
  849:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  850:          }
  851:          return 0;
  852:       }
  853:    }
  854: 
  855:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
  856:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
  857: 
  858: 
  859:    __device__ __forceinline__ double centerZ(void) const;
  860: 
  861:    // "Local" horizontal coordinates at the nodes. They are computed from the 3D global node coordinates. For ics == 1 and 2
  862:    // Local is in quotes because for ics == 1, the coordinates are unchanged. It just means that in these coordinates, the element is horizontal.
  863:    __device__ __forceinline__ Point2 getLocalHorizontalNodePosition(int idxNode) const;
  864:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2, int idx = 0) const;
  865:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const;
  866: 
  867: 
  868:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idxNode = 0,1,2,3)
  869:    __device__ __forceinline__ Point2 GaussPoint(int idxNode) const {
  870:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
  871:        assert(idxNode >= 0 && idxNode < 4 && "GaussPoint: idxNode out of range");
  872:        const double eta = (idxNode & 1) ? +g : -g;
  873:        const double xi  = (idxNode & 2) ? +g : -g;
  874:        return {eta, xi};
  875:    }  
  876: 
  877: 
  878: 
  879:    // Shape function Phi at a given point p = (eta,xi), idxNode = node index 0,1,2,3
  880:    __device__ __forceinline__ double Phi_quad(int idxNode, Point2 p) const {
  881:       return 0.25*(1.0 + p.x*eta_n(idxNode))*(1.0 + p.y*xi_n(idxNode));
  882:    }
  883: 
  884:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi)
  885:    __device__ __forceinline__ double dPhi_dxi_quad(int idxNode, Point2 p) const {
  886:       return 0.25*xi_n(idxNode)*(1.0 + p.x*eta_n(idxNode));
  887:    }   
  888: 
  889:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
  890:    __device__ __forceinline__ double dPhi_deta_quad(int idxNode, Point2 p) const {
  891:       return 0.25*(1.0 + p.y*xi_n(idxNode))*eta_n(idxNode);
  892:    }      
  893:    
  894:    __inline__ __device__ double detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
  895: 
  896:    __inline__ __device__ double detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
  897: 
  898:    __inline__ __device__ double detJ_quad(Point2 p, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const 
  899:          { return (1.0/4.0)*area + detJ_eta_quad(x0, x1, x2, x3)*p.x+ detJ_xi_quad(x0, x1, x2, x3)*p.y; }
  900: 
  901:    // Check if the element is dry using the more up-to-date elevation.
  902:    __inline__ __device__ bool isDry2(void) const;
  903: 
  904:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  905: 
  906:    __device__ bool inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const;
  907: 
  908:    __inline__ __device__ double computeSignedArea(void) const;
  909: 
  910: 
  911:    enum EFixIf { fiNo, fiOnlyInside, fiAnywhere };
  912: 
  913:    __device__ bool computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegShapeCoords = fiNo, const Side *origSide = nullptr) const;
  914:    
  915:    __device__ __forceinline__ void shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const;
  916: 
  917: 
  918:    __device__ __forceinline__ double intPhiPhiTri(int i, int j) const;
  919: 
  920:    __device__ __forceinline__ double intGradPhiGradPhiTri(int i, int j) const;
  921: 
  922:    __device__ __forceinline__ double intPhiPhiQuad(int i, int j, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
  923: 
  924:    __device__ __forceinline__ double intGradPhiGradPhiQuad(int i1, int i2, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
  925: 
  926:    __device__ __forceinline__ Vector2 grad2(double *a) const
  927:    {
  928:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  929:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  930:       if (isQuad()) {
  931:          gx += a[3]*gradPhi[3].x;
  932:          gy += a[3]*gradPhi[3].y;
  933:       }
  934:       return {gx, gy};
  935:    }
  936: 
  937:    __device__ __forceinline__ Vector2 grad2(double Node::* field) const
  938:    {
  939:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  940:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  941:       if (isQuad()) {
  942:          gx += (nodes[3]->*field)*gradPhi[3].x;
  943:          gy += (nodes[3]->*field)*gradPhi[3].y;
  944:       }
  945:       return {gx, gy};
  946:    }
  947: 
  948:    __device__ __forceinline__ Vector3 n(int k, double &area3D) const;
  949:    __device__ __forceinline__ Vector3 n(int k) const {
  950:       double area3D;
  951:       return n(k, area3D);
  952:     }
