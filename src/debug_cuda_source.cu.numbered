 7064:    __global__ void resetVelocityOpenBndNodes(void) {
 7065:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 7066: 
 7067:       NODE_BND(nodebnd);
 7068: 
 7069:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 7070:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 7071:       }
 7072: 
 7073:    }
 7074: 
 7075: 
 7076:    __global__ void setVelocityOpenBndNodes(void) {
 7077:    // For open boundary nodes sets their velocity to the imposed values.
 7078: 
 7079:       SIDE_BND(sidebnd);
 7080: 
 7081:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 7082:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 7083:          // to its segment to the average of the side velocity.
 7084: 
 7085:          for (int k = 0; k < nvrt; k++) {
 7086:             Node *n1 = sidebnd->side->n1;
 7087:             Node *n2 = sidebnd->side->n2;
 7088: 
 7089: 
 7090:             Vector2 n1_u2(n1->u2[k]);
 7091:             Vector2 n2_u2(n2->u2[k]);
 7092: 
 7093:             if (n1->nodeBnd->segment == sidebnd->segment) {
 7094:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 7095:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 7096:             }
 7097:             if (n2->nodeBnd->segment == sidebnd->segment) {
 7098:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 7099:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 7100:             }
 7101: 
 7102:          }
 7103: 
 7104:       }
 7105: 
 7106:    }
