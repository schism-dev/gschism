 4577: 
 4578: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 4579:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 4580:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 4581: 
 4582: 
 4583:    NODE(node1);
 4584: 
 4585:    node1->clearMatrixRow();
 4586:    node1->qel = 0.0;
 4587: 
 4588:    // THIS IS FOR STRUCTURES XXX
 4589:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 4590: 
 4591:    
 4592:    for (int j=0; j<node1->numElements; j++) {
 4593:       // For each element connected to the node...
 4594: 
 4595:       Element *elem = node1->elements[j];
 4596: 
 4597: 
 4598: 
 4599:       // Compute the average gravity
 4600:       const double grav3 = elem->mean(&Node::grav2);
 4601: 
 4602:       // Look at the documentation for the description of the terms in the following integrals
 4603: 
 4604:       // Integral I_1 
 4605:       // \bar{\breve{H}} 
 4606:       const double hhatb = elem->mean(&Side::hhat);        
 4607: 
 4608:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 4609: 
 4610:       const int id1 = elem->nodeLocalIdx(node1); 
 4611:       const double area = elem->area;
 4612: 
 4613:       if (elem->isTri()) {
 4614: 
 4615:          // To clarify the notation in this section: 
 4616:          //   i stands for the node under consideration (node1)
 4617:          //   j (node2) and k (node3) are the other nodes of the triangle.
 4618:          const int id2 = elem->nxq(1 + id1);
 4619:          const int id3 = elem->nxq(2 + id1);
 4620:          Node *node2 = elem->nodes[id2];
 4621:          Node *node3 = elem->nodes[id3];
 4622: 
 4623:          Point2 x1, x2, x3;
 4624:          elem->getLocalHorizontalNodePositionsTri(x1, x2, x3, id1);
 4625: 
 4626: 
 4627:          // integral of phi_i*phi_j
 4628:          const double ipp_ii = (1.0/6.0 )*area;
 4629:          const double ipp_ij = (1.0/12.0)*area;
 4630:          const double ipp_ik = (1.0/12.0)*area;
 4631: 
 4632:          // integral of [(grad phi_i) * (grad phi_j)]
 4633:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 4634:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 4635:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 4636: 
 4637:          // Computes the different components of integral I_1 of each node with respect to node i.
 4638:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4639:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4640:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4641: 
 4642:          node1->addToSparseMatrix(node1, I1_ii);
 4643:          node1->addToSparseMatrix(node2, I1_ij); 
 4644:          node1->addToSparseMatrix(node3, I1_ik);
 4645: 
 4646:       }
 4647:       else { // Quad
 4648:          // XXX IMPLEMENT THIS
 4649:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 4650: 
 4651:          // // To clarify the notation in this section: 
 4652:          // //   i stands for the node under consideration (node1)
 4653:          // //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 4654:          // const int id2 = elem->nxq(1 + id1);
 4655:          // const int id3 = elem->nxq(2 + id1);
 4656:          // const int id4 = elem->nxq(3 + id1);
 4657:          // Node *node2 = elem->nodes[id2];
 4658:          // Node *node3 = elem->nodes[id3];
 4659:          // Node *node4 = elem->nodes[id4];         
 4660: 
 4661:          // // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 4662:          // const double ipp_ii = elem->intPhiPhi(id1, id1);
 4663:          // const double ipp_ij = elem->intPhiPhi(id1, id2);
 4664:          // const double ipp_ik = elem->intPhiPhi(id1, id3);
 4665:          // const double ipp_il = elem->intPhiPhi(id1, id4);
 4666: 
 4667:          // // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 4668:          // const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 4669:          // const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 4670:          // const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 4671:          // const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 4672: 
 4673:          // // Computes the different components of integral I_1 of each node with respect to node i.
 4674:          // const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4675:          // const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4676:          // const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4677:          // const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 4678: 
 4679:          // node1->addToSparseMatrix(node1, I1_ii);
 4680:          // node1->addToSparseMatrix(node2, I1_ij); 
 4681:          // node1->addToSparseMatrix(node3, I1_ik);
 4682:          // node1->addToSparseMatrix(node4, I1_il);
 4683:   
 4684:       } 
 4685: 
 4686:  
 4687:       // Integral I_4
 4688:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 4689:       // Where
 4690:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 4691: 
 4692:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 4693:       // of U over the element.
 4694:       Vector2 U = {0.0, 0.0};
 4695:       for (int m=0; m < elem->i34; m++) {      
 4696:          const Side *side = elem->sides[m];
 4697: 
 4698:          if constexpr(ics == 1) U += side->U; 
 4699:          else                   U += side->frame.projHorVec(side->U, elem->frame);  // In global coordinates, we must project the side velocity to the element frame
 4700: 
 4701:       }
 4702:       U = U/elem->i34;
 4703: 
 4704: 
 4705:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 4706: 
 4707: 
 4708:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 4709:       const double I_4_1 = dot(gradPhi_1, U);
 4710: 
 4711: 
 4712:       // Integral of \nabla\phi_i \cdot \pmb{E}
 4713:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 4714: 
 4715:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 4716: 
 4717:       // Additional terms 
 4718:       double vnorm = 0.0;
 4719:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 4720:          Vector3 ubed = {0.0, 0.0, 0.0};
 4721:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 4722:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 4723: 
 4724:          Vector3 gradP = {0.0, 0.0, 1.0};
 4725:          for (int m=0; m < elem->i34; m++) {
 4726:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 4727:            gradP += toVector3(gradP_2D, 0.0);
 4728:          }   
 4729:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 4730:       } // imm==2
 4731: 
 4732:       if (elem->isTri()) {
 4733:          for (int l=0; l<3; l++) {
 4734: 
 4735:             Node *node = elem->nodes[l];
 4736: 
 4737:             double fac = (node == node1) ? 2.0 : 1.0;
 4738:    
 4739:             if      constexpr(imm == 2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 4740:             else if constexpr(imm == 1) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + (node->bdef2 - node->bdef1)); 
 4741:             else                        node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2); 
 4742:            
 4743:          }
 4744: 
 4745: 
 4746:          if (!elem->isDry) {
 4747:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 4748: 
 4749:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 4750: 
 4751:          }
 4752: 
 4753:       } // isTri
 4754:       else { // isQuad
 4755:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 4756:          // for (int l=0; l<4; l++) {
 4757:          //   const Node *node = elem->nodes[l];
 4758: 
 4759:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 4760:          //   else        tmp2 = node->bdef2 - node->bdef1;
 4761: 
 4762:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 4763:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 4764:          // }
 4765: 
 4766:       } // isQuad
 4767: 
 4768: 
 4769:      node1->qel += (dt/elem->i34)*elem->vsource;
 4770:       
 4771: 
 4772:    } // for all elements connected to the node
 4773:    
 4774: 
 4775:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 4776:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 4777:    NodeBoundary *nodeBnd = node1->nodeBnd;
 4778:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 4779:       // If it is an open boundary node...
 4780: 
 4781:       // At least one open bnd side, maybe two
 4782:       for (int l=0; l<2; l++) { 
 4783: 
 4784:          // Gets each of the sides sharing the node. 
 4785:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 4786: 
 4787:        
 4788: 
 4789:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 4790:          if (sideBnd != nullptr) {
 4791:             // If the side is on a boundary...
 4792: 
 4793:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 4794: 
 4795:             // Get the boundary segment
 4796:             const BoundarySegment *sideSegment = sideBnd->segment;
 4797:             const Side *side = sideBnd->side;
 4798: 
 4799:             // Integral I_3
 4800:             if (sideSegment->ifltype != 0) {
 4801:             // Natural or Flather b.c.
 4802: 
 4803:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4804:                // especially for Flather b.c.
 4805:                double ri3 = 0.0;
 4806:                if (!side->isDry) {
 4807:                   // If the side is not dry
 4808:                   
 4809:                   // Computes the side flux of (uth, vth)
 4810:                   double Vn = 0.0;
 4811:                   for (int k = side->kb; k < nvrt - 1; k++) {
 4812:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4813:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4814: 
 4815:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 4816:                   }
 4817: 
 4818:                   ri3 = 0.5*side->len*Vn;
 4819:                }
 4820: 
 4821:                if (sideSegment->ifltype == -1) { // Flather 1
 4822: 
 4823:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4824:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4825: 
 4826:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4827:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4828:                   
 4829:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4830:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4831: 
 4832:                } 
 4833:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4834:                   // Reset ri3
 4835:                   ri3 = 0.0;
 4836: 
 4837:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4838:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 4839: 
 4840:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4841: 
 4842:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4843:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4844: 
 4845:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4846:                   node1->addToSparseMatrix(node1, con0*2.0);
 4847:                   node1->addToSparseMatrix(node2, con0);
 4848: 
 4849:                } // if Flather or Discharge
 4850: 
 4851:                node1->qel -= thetai*dt*ri3;
 4852: 
 4853: 
 4854:             } // I_3
 4855:           
 4856: 
 4857:             // Integral I_5
 4858:             if(!side->isDry) {
 4859: 
 4860:                const double Unbar = dot(side->U, side->n);
 4861:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 4862: 
 4863:             } // I_5
 4864: 
 4865:          } // if is boundary side
 4866: 
 4867:       } // for l
 4868: 
 4869:    } // if isbnd
 4870: 
 4871: 
 4872: }
 4873: 
 4874: 
 4875: 
 4876: extern "C" {
 4877:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 4878:                                   int* indices, int* indptr) {
 4879: 
 4880:       NODE(node);
 4881:       
 4882:       const int idx = node->idx;
 4883:       
 4884:       // Computes the index in the nzz array      
 4885:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 4886: 
 4887: 
 4888:       indptr[idx] = nzzIdx;
 4889:       indices[nzzIdx] = idx;
 4890: 
 4891:       data_d[nzzIdx]    = node->coeffDiag;
 4892: 
 4893:       b_d[idx] = node->qel;
 4894: 
 4895:       for (int k = 0; k < node->numNodes; ++k) {
 4896:          const Node* nb = node->nodes[k];
 4897: 
 4898:          const int j = nb->idx;
 4899: 
 4900:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 4901: 
 4902:          indices[nzzIdx + k + 1] = j;
 4903:       }
 4904: 
 4905:  
 4906:    }
 4907: 
 4908: 
 4909: 
 4910:    __global__ void solverCopyResult(double* x) {
 4911:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 4912:       NODE(node);
 4913:       const int idx = node->idx;
 4914: 
 4915:       node->mX = x[idx];
 4916:    }
 4917: 
 4918: 
 4919:    __global__ void rollUpElevation(void) {
 4920: 
 4921:       NODE(node);
 4922: 
 4923:       node->eta1 = node->eta2;
 4924: 
 4925:    }
 4926: 
 4927: 
 4928:    __global__ void backtrackAllNodes(void) {
 4929: 
 4930:       // max/min # of sub-divisions
 4931:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4932:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4933: 
 4934: 
 4935:       SIDE(side);
 4936: 
 4937:       const int kb = side->kb;
 4938: 
 4939: 
 4940:       // Initialize btrack velocities to the actual velocities at the side 
 4941:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4942: 
 4943:   
 4944: 
 4945:       if (side->isDry) return;
 4946:      
 4947: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4948: 
 4949:       // Checks that at least one element is not dry
 4950:       const Element *elem1 = side->elems[0];
 4951:       const Element *elem2 = side->elems[1];
 4952: 
 4953: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4954: 
 4955:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4956:       
 4957:       // XXXXXX
 4958:       // !swild_tmp to store global coord. of the starting side
 4959:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4960:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4961:       // !Use sframe2 
 4962:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4963: 
 4964: 
 4965:       for (int k = kb; k < nvrt; k++) {
 4966:       //  Initialize (xt,yt,zt), nnel and vel.
 4967:       //  For ics=2, the coordinates are all in the side's local frame
 4968:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 4969: 
 4970:          const int iadvf = side->iadv();  // Advection flag   
 4971:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4972: 
 4973:          // If on land or open boundary...
 4974:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 4975:          
 4976:          const double vmag = length(side->u2[k]);
 4977: 
 4978:          if (vmag <= velmin_btrack) {
 4979:             // No activity 
 4980: 
 4981:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4982: // addDebugPlot(side->center, side->center, 0x00000F, '+');     
 4983: 
 4984:             
 4985:          } else {  // do btrack
 4986: 
 4987:             // Compute number of sub-divisions based on local gradients of the velocity field
 4988: 
 4989:             // XXX IS THIS NECESSARY?
 4990:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4991:             double suma = 0.0;
 4992:             int icount = 0;
 4993:             for (int l=0; l<2; l++) {
 4994:             // For each element sharing the side...
 4995: 
 4996:                const Element *elem = side->elems[l];
 4997:                  
 4998:                if (elem == nullptr) continue;
 4999: 
 5000:                icount++;
 5001: 
 5002:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 5003:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 5004:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 5005: 
 5006:                double utmp[4];
 5007:                double vtmp[4];
 5008:                for (int j = 0; j < elem->i34; j++) {
 5009: 
 5010:                   const Node *node = elem->nodes[j];
 5011: 
 5012:                   if constexpr(ics==1) {
 5013:                      utmp[j] = node->u2[k].x;
 5014:                      vtmp[j] = node->u2[k].y;  
 5015: 
 5016:                   } else {
 5017:                      // 'Project' the velocity from the node frame to the element frame
 5018:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 5019:                      utmp[j] = tmp_u2.x;
 5020:                      vtmp[j] = tmp_u2.y;
 5021: 
 5022:                   }
 5023:                } // for j
 5024: 
 5025:                const Vector2 grad_u = elem->grad2(utmp); 
 5026:                const Vector2 grad_v = elem->grad2(vtmp);
 5027:    
 5028:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 5029:             } // for ii
 5030: 
 5031:             assert(icount > 0 && "Impossible 77");
 5032: 
 5033:             // '4' is somewhat arbitrary
 5034:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 5035:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 5036:             Vector3 u_int = {0.0, 0.0, 0.0};
 5037: 
 5038:             bool res =side->btrack(k, dt, dtbk, u_int);
 5039: 
 5040:             side->btu[k] = toVector2(u_int);
 5041:                
 5042:          } // if vmag (do backtrack)
 5043: 
 5044: 
 5045:       } // for k=kb,nvrt-1
 5046: 
 5047:    }
 5048: 
 5049: } // extern "C"
 5050: 
 5051: template<int nc>
 5052: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 5053: 
 5054: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 5055: //
 5056: // a,b,c,rhs: input vectors and are not modified by this program.
 5057: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 5058: // rhs is the r.h.s.
 5059: // n: actual rank of the system.
 5060: // rows in u() and rhs();
 5061: // u: output with nc columns (transposed to rows)
 5062: // gam: a working array.
 5063: //
 5064: // NOTES:
 5065: // This is a template function that allows for different numbers of columns in the rhs vector.
 5066: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 5067: 
 5068:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 5069:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 5070: 
 5071:    double bet = b[0];
 5072:    if constexpr (nc == 1) {
 5073:       u[0] = rhs[0]/bet;
 5074:    } else {
 5075:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 5076:    }
 5077: 
 5078:    for (int j = 1; j < n; j++) {
 5079:       gam[j] = c[j - 1]/bet;
 5080:       bet = b[j] - a[j]*gam[j];
 5081: 
 5082:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 5083: 
 5084:       if constexpr (nc == 1) {
 5085:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 5086:       } else {
 5087:          for (int l = 0; l < nc; l++) {
 5088:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 5089:          }
 5090:       }
 5091:    }
 5092: 
 5093:    // Back-substitution
 5094:    for (int j = n - 2; j >= 0; j--) {
 5095:       if constexpr (nc == 1) {
 5096:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 5097:       } else {
 5098:          for (int l = 0; l < nc; l++) {
 5099:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 5100:          }
 5101:       }
 5102:    }
 5103: }
 5104: 
 5105: 
 5106: 
 5107: // Helper function that contains the core algorithm
 5108: template<typename XAccessor, typename YAccessor>
 5109: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 5110:                                     double  yp_top, double  yp_bot, 
 5111:                                     CubicSpline &spline) {
 5112:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 5113:    // 
 5114:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 5115:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 5116:    //
 5117:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 5118:    // 
 5119:    // Inputs: 
 5120:    //            n: dimension for x etc; # of data pts (>=2);
 5121:    //            getX, getY: functions to access x,y coordinates
 5122:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 5123:    //     Output: 
 5124:    //            spline (CubicSpline): spline structure with x,y,y',y''
 5125: 
 5126:    const int n = k2 - k1 + 1;
 5127:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 5128: 
 5129:    // Allocate memory for the splines
 5130:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 5131:    spline.x   = new double[n];
 5132:    spline.y   = new double[n];
 5133:    spline.yp  = new double[n];
 5134:    spline.ypp = new double[n];
 5135: 
 5136:    for (int k=k1; k<=k2; k++) {
 5137:       spline.x[k] = getX(k);
 5138:       spline.y[k] = getY(k);
 5139:    }
 5140: 
 5141:    // This is to simplify expressions later
 5142:    double *x = spline.x;
 5143:    double *y = spline.y;
 5144: 
 5145:    double *a = nullptr;
 5146:    double *b = nullptr;
 5147:    double *c = nullptr;
 5148:    double *gam = nullptr;
 5149:    double *rhs = nullptr;
 5150:    
 5151: 
 5152:       a = new double[n];   // Lower diagonal
 5153:       b = new double[n];   // Diagonal
 5154:       c = new double[n];   // Upper diagonal
 5155:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 5156:       rhs = new double[n]; // Right-hand side
 5157: 
 5158:    for (int k=k1; k<=k2; k++) {
 5159:       if (k == k1) {
 5160:          // Bottom level
 5161:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 5162:          b[k] = (x[k+1] - x[k])/3.0;
 5163:          c[k] = b[k]/2.0;
 5164:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 5165:       } else if (k == n - 1) {
 5166:          // Top level (surface)
 5167:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 5168:          b[k] = (x[k] - x[k-1])/3.0;
 5169:          a[k] = b[k]/2.0;
 5170:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 5171:       } else {
 5172:          // Intermediate levels
 5173:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 5174:          b[k] = (x[k+1] - x[k-1])/3.0;
 5175:          a[k] = (x[k  ] - x[k-1])/6.0;
 5176:          c[k] = (x[k+1] - x[k  ])/6.0;
 5177:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 5178:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 5179:       }
 5180:    }
 5181: 
 5182:    // Solve the tridiagonal system
 5183:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 5184:    
 5185:    spline.yp[k1] = yp_bot;
 5186:    spline.yp[k2] = yp_top;
 5187: 
 5188:    // Compute rest of 1st derivatives using the splines
 5189:    for (int k=k1+1; k<k2; k++) {
 5190:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 5191:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 5192:    }
 5193:    
 5194:    delete[] a;
 5195:    delete[] b;
 5196:    delete[] c;
 5197:    delete[] gam;
 5198:    delete[] rhs;
 5199: 
 5200: }
 5201: 
 5202: // Array version
 5203: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 5204:                                 double y_top, double y_bot, 
 5205:                                 CubicSpline &spline) {
 5206:    auto getX = [x] (int k) { return x[k]; };
 5207:    auto getY = [y] (int k) { return y[k]; };
 5208:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5209: }
 5210: 
 5211: // Lambda version - allows custom access patterns
 5212: template<typename XFunc, typename YFunc>
 5213: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 5214:                                 double y_top, double y_bot,
 5215:                                 CubicSpline &spline) {
 5216:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5217: }
 5218: 
 5219: 
 5220: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 5221: {
 5222:    assert("Not implemented");
 5223: 
 5224:    return 0.0;
 5225: }
 5226: 
