  881:    __device__ void trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
  882:                                        double &dt, Point3 &xt, double zint, Vector3 &u_int);
  883:     
  884:    __device__ bool trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
  885:                                                  Element *&nextElem, int &jlev, double &dt,
