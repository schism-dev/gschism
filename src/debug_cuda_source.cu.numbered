  993: 
  994:    // ------------------------------------------------------------------------------------------------
  995:    // These are functions that work on all nodes/sides of the element.
  996:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  997:    //
  998:    // An example of how to use these functions is:
  999:    //   
 1000:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 1001:    // 
 1002:    // Where L is the level at which the field is to be interpolated. The field can be either
 1003:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
 1004:    // There are different versions of getNodalValues for each of these cases.
 1005: 
 1006:    template<typename T>
 1007:    __device__ __forceinline__ void getNodalValues(T Node::* field, T res[4]) const;
 1008: 
 1009:    template<typename T>
 1010:    __device__ __forceinline__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const;
 1011:   
 1012:    template<typename T>
 1013:    __device__ __forceinline__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const;
 1014: 
 1015:    template<typename T>
 1016:    __device__ __forceinline__ void getSideValues(T Side::* field, T res[4]) const;
 1017: 
 1018:    template<typename T>
 1019:    __device__ __forceinline__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const;
 1020: 
 1021:    template<typename T>
 1022:    __device__ __forceinline__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const;
 1023: 
 1024:    
 1025:    __forceinline__ __device__ void projectNodeVectorsToElementFrame(Vector2 *v) const;
 1026:    __forceinline__ __device__ void projectSideVectorsToElementFrame(Vector2 *v) const;
 1027: 
 1028: 
 1029:    template<typename T>
 1030:    __device__ __forceinline__ T interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const;
 1031: 
 1032:    template<typename T>
 1033:    __device__ __forceinline__ T interpolate(const double shapeCoords[4], T Node::* field) const;
 1034: 
 1035:    template<typename T>
 1036:    __device__ __forceinline__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const;
 1037: 
 1038:    template<typename T>
 1039:    __device__ __forceinline__ T mean(T Node::* field) const;
 1040: 
 1041:    template<typename T>
 1042:    __device__ __forceinline__ T mean(T Side::* field) const;
 1043: 
 1044:    template<typename T>
 1045:    __device__ __forceinline__ T mean(int level,  T (Side::*func)(int) const) const;
 1046: 
 1047:    template<typename T>
 1048:    __device__ __forceinline__ T mean(int level, T (Node::* field)[nvrt]) const;
 1049: 
 1050:    template<typename T>
 1051:    __device__ __forceinline__ T mean(int level, T (Side::* field)[nvrt]) const;
 1052: 
 1053: 
 1054: 
 1055:    // __device__ double mean(double (Node::*func)(int) const) const {
 1056:    //    double values[4];
 1057:    //    getNodalValues(level, func, values);
 1058:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 1059:    // }
 1060:    // ------------------------------------------------------------------------------------------------
 1061: 
 1062: 
 1063: 
 1064: 
 1065:    __device__ __forceinline__ Point2 getLocalNodePosition(int idx, const Side* origSide) const;
 1066: 
 1067:    __device__ __forceinline__ Node *getNodeInOrder(int idx) const;
 1068: 
 1069:    __device__ __forceinline__ void computePredicates(const Point2 x0, const Point2& xt, double &fac, const Side* origSide,
 1070:                                                     Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector, int jlev) const;
 1071:     
