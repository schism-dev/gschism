 1594: __device__ void lock(int *mutex) {
 1595:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 1596: }
 1597: 
 1598: __device__ void unlock(int *mutex) {
 1599:     atomicExch(mutex, 0);
