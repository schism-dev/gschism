 4378: 
 4379:    __global__ void backtrackAllNodes(void) {
 4380: 
 4381:       // max/min # of sub-divisions
 4382:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4383:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4384: 
 4385: 
 4386:       SIDE(side);
 4387: 
 4388:       const int kb = side->kb;
 4389: 
 4390: 
 4391:       // Initialize btrack velocities to the actual velocities at the side 
 4392:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4393: 
 4394:   
 4395: 
 4396:       if (side->isDry) return;
 4397:      
 4398: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4399: 
 4400:       // Checks that at least one element is not dry
 4401:       const Element *elem1 = side->elems[0];
 4402:       const Element *elem2 = side->elems[1];
 4403: 
 4404: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4405: 
 4406:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4407:       
 4408:       // XXXXXX
 4409:       // !swild_tmp to store global coord. of the starting side
 4410:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4411:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4412:       // !Use sframe2 
 4413:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4414: 
 4415: 
 4416:       for (int k = kb; k < nvrt; k++) {
 4417:       //  Initialize (xt,yt,zt), nnel and vel.
 4418:       //  For ics=2, the coordinates are all in the side's local frame
 4419:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 4420: 
 4421:          const int iadvf = side->iadv();  // Advection flag   
 4422:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4423: 
 4424:          // If on land or open boundary...
 4425:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 4426:          
 4427:          const double vmag = length(side->u2[k]);
 4428: 
 4429:          if (vmag <= velmin_btrack) {
 4430:             // No activity 
 4431: 
 4432:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4433: // addDebugPlot(side->center, side->center, 0x00000F, '+');     
 4434: 
 4435:             
 4436:          } else {  // do btrack
 4437: 
 4438:             // Compute number of sub-divisions based on local gradients of the velocity field
 4439: 
 4440:             // XXX IS THIS NECESSARY?
 4441:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4442:             double suma = 0.0;
 4443:             int icount = 0;
 4444:             for (int l=0; l<2; l++) {
 4445:             // For each element sharing the side...
 4446: 
 4447:                const Element *elem = side->elems[l];
 4448:                  
 4449:                if (elem == nullptr) continue;
 4450: 
 4451:                icount++;
 4452: 
 4453:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 4454:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 4455:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 4456: 
 4457:                double utmp[4];
 4458:                double vtmp[4];
 4459:                for (int j = 0; j < elem->i34; j++) {
 4460: 
 4461:                   const Node *node = elem->nodes[j];
 4462: 
 4463:                   if constexpr(ics==1) {
 4464:                      utmp[j] = node->u2[k].x;
 4465:                      vtmp[j] = node->u2[k].y;  
 4466: 
 4467:                   } else {
 4468:                      // 'Project' the velocity from the node frame to the element frame
 4469:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 4470:                      utmp[j] = tmp_u2.x;
 4471:                      vtmp[j] = tmp_u2.y;
 4472: 
 4473:                   }
 4474:                } // for j
 4475: 
 4476:                const Vector2 grad_u = elem->grad2(utmp); 
 4477:                const Vector2 grad_v = elem->grad2(vtmp);
 4478:    
 4479:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4480:             } // for ii
 4481: 
 4482:             assert(icount > 0 && "Impossible 77");
 4483: 
 4484:             // '4' is somewhat arbitrary
 4485:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4486:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4487:             Vector3 u_int = {0.0, 0.0, 0.0};
 4488: 
 4489:             bool res =side->btrack(k, dt, dtbk, u_int);
 4490: 
 4491:             side->btu[k] = toVector2(u_int);
 4492:                
 4493:          } // if vmag (do backtrack)
 4494: 
 4495: 
 4496:       } // for k=kb,nvrt-1
 4497: 
 4498:    }
 4499: 
 4500: } // extern "C"
 4501: 
 4502: template<int nc>
 4503: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4504: 
 4505: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4506: //
 4507: // a,b,c,rhs: input vectors and are not modified by this program.
 4508: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4509: // rhs is the r.h.s.
 4510: // n: actual rank of the system.
 4511: // rows in u() and rhs();
 4512: // u: output with nc columns (transposed to rows)
 4513: // gam: a working array.
 4514: //
 4515: // NOTES:
 4516: // This is a template function that allows for different numbers of columns in the rhs vector.
 4517: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4518: 
 4519:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4520:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4521: 
 4522:    double bet = b[0];
 4523:    if constexpr (nc == 1) {
 4524:       u[0] = rhs[0]/bet;
 4525:    } else {
 4526:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4527:    }
 4528: 
 4529:    for (int j = 1; j < n; j++) {
 4530:       gam[j] = c[j - 1]/bet;
 4531:       bet = b[j] - a[j]*gam[j];
 4532: 
 4533:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4534: 
 4535:       if constexpr (nc == 1) {
 4536:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4537:       } else {
 4538:          for (int l = 0; l < nc; l++) {
 4539:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4540:          }
 4541:       }
 4542:    }
 4543: 
 4544:    // Back-substitution
 4545:    for (int j = n - 2; j >= 0; j--) {
 4546:       if constexpr (nc == 1) {
 4547:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4548:       } else {
 4549:          for (int l = 0; l < nc; l++) {
 4550:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4551:          }
 4552:       }
 4553:    }
 4554: }
 4555: 
 4556: 
 4557: 
 4558: // Helper function that contains the core algorithm
 4559: template<typename XAccessor, typename YAccessor>
 4560: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4561:                                     double  yp_top, double  yp_bot, 
 4562:                                     CubicSpline &spline) {
 4563:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4564:    // 
 4565:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4566:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4567:    //
 4568:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4569:    // 
 4570:    // Inputs: 
 4571:    //            n: dimension for x etc; # of data pts (>=2);
 4572:    //            getX, getY: functions to access x,y coordinates
 4573:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4574:    //     Output: 
 4575:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4576: 
 4577:    const int n = k2 - k1 + 1;
 4578:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4579: 
 4580:    // Allocate memory for the splines
 4581:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4582:    spline.x   = new double[n];
 4583:    spline.y   = new double[n];
 4584:    spline.yp  = new double[n];
 4585:    spline.ypp = new double[n];
 4586: 
 4587:    for (int k=k1; k<=k2; k++) {
 4588:       spline.x[k] = getX(k);
 4589:       spline.y[k] = getY(k);
 4590:    }
 4591: 
 4592:    // This is to simplify expressions later
 4593:    double *x = spline.x;
 4594:    double *y = spline.y;
 4595: 
 4596:    double *a = nullptr;
 4597:    double *b = nullptr;
 4598:    double *c = nullptr;
 4599:    double *gam = nullptr;
 4600:    double *rhs = nullptr;
 4601:    
 4602: 
 4603:       a = new double[n];   // Lower diagonal
 4604:       b = new double[n];   // Diagonal
 4605:       c = new double[n];   // Upper diagonal
 4606:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4607:       rhs = new double[n]; // Right-hand side
 4608: 
 4609:    for (int k=k1; k<=k2; k++) {
 4610:       if (k == k1) {
 4611:          // Bottom level
 4612:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4613:          b[k] = (x[k+1] - x[k])/3.0;
 4614:          c[k] = b[k]/2.0;
 4615:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4616:       } else if (k == n - 1) {
 4617:          // Top level (surface)
 4618:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4619:          b[k] = (x[k] - x[k-1])/3.0;
 4620:          a[k] = b[k]/2.0;
 4621:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4622:       } else {
 4623:          // Intermediate levels
 4624:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4625:          b[k] = (x[k+1] - x[k-1])/3.0;
 4626:          a[k] = (x[k  ] - x[k-1])/6.0;
 4627:          c[k] = (x[k+1] - x[k  ])/6.0;
 4628:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4629:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4630:       }
 4631:    }
 4632: 
 4633:    // Solve the tridiagonal system
 4634:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4635:    
 4636:    spline.yp[k1] = yp_bot;
 4637:    spline.yp[k2] = yp_top;
 4638: 
 4639:    // Compute rest of 1st derivatives using the splines
 4640:    for (int k=k1+1; k<k2; k++) {
 4641:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4642:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4643:    }
 4644:    
 4645:    delete[] a;
 4646:    delete[] b;
 4647:    delete[] c;
 4648:    delete[] gam;
 4649:    delete[] rhs;
 4650: 
 4651: }
 4652: 
 4653: // Array version
 4654: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4655:                                 double y_top, double y_bot, 
 4656:                                 CubicSpline &spline) {
 4657:    auto getX = [x] (int k) { return x[k]; };
 4658:    auto getY = [y] (int k) { return y[k]; };
 4659:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4660: }
 4661: 
 4662: // Lambda version - allows custom access patterns
 4663: template<typename XFunc, typename YFunc>
 4664: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4665:                                 double y_top, double y_bot,
 4666:                                 CubicSpline &spline) {
 4667:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4668: }
