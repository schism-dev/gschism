 7516: 
 7517: __global__ void computeMatrixProductAndDotProducts() {
 7518:    // Computes A*p, r'Mr and p'Ap
 7519: 
 7520:    // 1) shared buffer: first half for rMr, second for pAp
 7521:    __shared__ double sdata[2*BLOCK_SIZE];
 7522:    double* s_rMr = sdata;
 7523:    double* s_pAp = sdata + BLOCK_SIZE;
 7524: 
 7525:    const int tid = threadIdx.x;
 7526: 
 7527:    double l_pAp = 0.0;
 7528: 
 7529:    s_rMr[tid] = 0.0;
 7530:    s_pAp[tid] = 0.0;
 7531: 
 7532:    // 2) get your node pointer
 7533:    // NODE(node);   
 7534:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7535:    Node *node = &(mesh->localNodeData[idx_node]); 
 7536:       if (idx_node < mesh->np) {
 7537: 
 7538:       const double diag = node->coeffDiag;
 7539:       const double r    = node->mR;
 7540:       const double p    = node->mP;  
 7541: 
 7542:       // apply preconditioner on the fly:
 7543:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7544: 
 7545:       // 4) compute Ap = A.p
 7546:       double Ap = node->coeffDiag * node->mP;
 7547:       for (int j = 0; j < node->numNodes; ++j) {
 7548:          const Node *nbNode = node->nodes[j];
 7549:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7550: 
 7551:       }
 7552: 
 7553:       node->mAp = Ap;
 7554:       
 7555: 
 7556:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7557:       // const double l_rMr = r*Mr;  // r'Mr
 7558:       l_pAp = p*Ap;  // p'Ap
 7559: 
 7560: 
 7561:    }
 7562: 
 7563:    // 6) write into shared mem
 7564:    // s_rMr[tid] = l_rMr;
 7565:    s_pAp[tid] = l_pAp;
 7566: 
 7567:    __syncthreads();
 7568: 
 7569:    // 7) block-wide tree reduction
 7570:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7571:       if (tid < stride)  {
 7572:          s_pAp[tid] += s_pAp[tid + stride];
 7573:       }
 7574:       __syncthreads();
 7575:    }
 7576: 
 7577:    // 8) thread 0 atomically accumulates into the globals
 7578:    // XXX: This is slower than it needs to be, but it is simple and works
 7579:    if (tid == 0) {
 7580:       atomicAdd(pAp, s_pAp[0]);
 7581:    }
 7582: 
 7583: 
 7584: }
 7585: 
 7586: 
 7587: __global__ void updateSolutionAndDotProducts(void) {
 7588:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7589: 
 7590:    const int tid = threadIdx.x;
 7591: 
 7592:    s_rMr[tid] = 0.0;
 7593: 
 7594:    // get node & bounds-check:
 7595:    NODE(node);
 7596: 
 7597:    
 7598:    // Compute alpha
 7599:    const double alpha = (*rMr_old)/(*pAp); 
 7600: 
 7601: 
 7602:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7603: 
 7604: 
 7605:    // load scalars
 7606:    const double diag = node->coeffDiag;
 7607:    const double p    = node->mP;
 7608:    const double Ap   = node->mAp;
 7609:    const double x    = node->mX;
 7610:    const double r    = node->mR;
 7611:    
 7612:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7613: 
 7614:    // 1) update solution & residual
 7615:    const double x_new = x + alpha*p;
 7616:    const double r_new = r - alpha*Ap;
 7617:    node->mX = x_new;
 7618:    node->mR = r_new;
 7619: 
 7620:    // 2) apply Jacobi preconditioner on the fly
 7621:    const double Mr_new = r_new/diag;
 7622: 
 7623: 
 7624:    // 3) local contributions for the two dot-products
 7625:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7626: 
 7627:    // 4) write into shared-mem
 7628:    s_rMr[tid] = l_rMr;
 7629: 
 7630:    __syncthreads();
 7631: 
 7632: 
 7633:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7634:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7635:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7636:       __syncthreads();
 7637:    }
 7638: 
 7639:    // 6) thread 0 atomically folds into the global accumulators
 7640:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7641: 
 7642: 
 7643: }
 7644: 
 7645: 
 7646: __global__ void updateSearchDirection() {
 7647: 
 7648:     NODE(node);
 7649: 
 7650:     // recompute z on-the-fly
 7651:     const double z = node->mR / node->coeffDiag;
 7652:     const double p = node->mP;
 7653: 
 7654:     const double beta = (*rMr_new)/(*rMr_old);
 7655: 
 7656: 
 7657:     // p =z + beta*p
 7658:     node->mP = z + beta*p;
 7659: 
 7660: }
 7661: 
 7662: __global__ void initializeScalars(double *scalars) {
 7663: 
 7664:    // These point to a cupy array in the host code
 7665:    rMr_old = scalars + 0;
 7666:    rMr_new = scalars + 1;
 7667:    pAp     = scalars + 2;
 7668: }
 7669: 
 7670: __global__ void initializePreconditionedResidual(void) {
 7671: 
 7672:     __shared__ double s_rMr[BLOCK_SIZE];  
 7673: 
 7674:     s_rMr[threadIdx.x] = 0.0;
 7675: 
 7676:     NODE_ALL(node, valid);
 7677:     const int tid = threadIdx.x;
 7678:     // For the first iteration:
 7679:     // 1. Initial solution x = 0 (already set)
 7680:     // 2. Initial residual r = b (stored in qel)
 7681:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7682: 
 7683: // XXX we should use the guess solution here    
 7684: 
 7685:     double l_rMr = 0.0;
 7686:     if (valid) {
 7687:       // Set initial residual r = b (from qel)
 7688:       node->mR = node->qel;
 7689: 
 7690:       // Compute z = M^-1 * r (preconditioned residual)
 7691:       const double z = node->mR / node->coeffDiag;
 7692: 
 7693:       // Set initial search direction p = z
 7694:       node->mP = z;
 7695: 
 7696:       // Initialize other variables needed for CG
 7697:       node->mX = 0.0;  // Initial solution
 7698:       node->mAp = 0.0; // Will be computed in first iteration
 7699: 
 7700: 
 7701:       // Computes the first r'Mr (reduction)
 7702:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7703:     }
 7704:     // 4) write into shared-mem
 7705:     s_rMr[tid] = l_rMr;
 7706: 
 7707:     __syncthreads();
 7708: 
 7709: 
 7710:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7711:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7712:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7713:         __syncthreads();
 7714:     }
 7715: 
 7716:     // 6) thread 0 atomically folds into the global accumulators
 7717:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7718: 
 7719:     *rMr_old = 0.0;
 7720:     *pAp = 0.0;
 7721: }
 7722: 
