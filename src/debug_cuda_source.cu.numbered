  325: 
  326: 
  327: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  328:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  329:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  330: }
  331: 
  332: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  333:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  334:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  335: }
  336: 
  337: 
  338: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  339:    x3 = y1*z2 - y2*z1;
  340:    y3 = x2*z1 - x1*z2;
  341:    z3 = x1*y2 - x2*y1;
  342: }
  343: 
  344: 
  345: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  346: // Given a 3D global point (may not be on surface of earth), find its longitude and latitude in radians
  347: 
  348:    const double radius2 = dot(p, p);
  349:    assert(radius2 != 0.0     && "computeLonLat: radius = 0");
  350:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  351: 
  352:    rlon = atan2(p.y, p.x); // (-pi,pi]
  353: 
  354:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  355:       rlat = asin(p.z/sqrt(radius2));
  356:    } else {
  357:       rlat = asin(p.z/rearth_pole);
  358:    }
  359:   
  360: }
