 9175: extern "C" __global__ void getNodeVar(int varCode, void *res, int k) {
 9176:    // Packed local order into res. Caller allocates sizePart * nbytes.
 9177:    NODE(node);
 9178: 
 9179:    switch (varCode) {
 9180:       case (int)VarCode::outputCoords: {
 9181:          const Point2 coords = node->outputCoords();
 9182:          double *out = (double *)((char *)res + idx_node * 16);
 9183:          out[0] = coords.x;
 9184:          out[1] = coords.y;
 9185:          break;
 9186:       }
 9187:       case (int)VarCode::depth:
 9188:          *(double *)((char *)res + idx_node * 8) = node->depth;
 9189:          break;
 9190:       case (int)VarCode::kb:
 9191:          *(int *)((char *)res + idx_node * 4) = (int)node->kb;
 9192:          break;
 9193:       case (int)VarCode::eta:
 9194:          *(double *)((char *)res + idx_node * 8) = node->eta2;
 9195:          break;
 9196:       case (int)VarCode::u_air: {
 9197:          double *out = (double *)((char *)res + idx_node * 16);
 9198:          out[0] = node->u_air.x;
 9199:          out[1] = node->u_air.y;
 9200:          break;
 9201:       }
 9202:       case (int)VarCode::isdry:
 9203:          *(int *)((char *)res + idx_node * 4) = (int)node->isDry;
 9204:          break;
 9205:       case (int)VarCode::u: {
 9206:          double *out = (double *)((char *)res + idx_node * nvrt * 16);
 9207:          if (k >= 0) {
 9208:             out[0] = node->u2[k].x;
 9209:             out[1] = node->u2[k].y;
 9210:          } else {
 9211:             for (int lev = 0; lev < nvrt; lev++) {
 9212:                out[lev*2    ] = node->u2[lev].x;
 9213:                out[lev*2 + 1] = node->u2[lev].y;
 9214:             }
 9215:          }
 9216:          break;
 9217:       }
 9218:       case (int)VarCode::z: {
 9219:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9220:          if (k >= 0)
 9221:             out[0] = node->z[k];
 9222:          else
 9223:             for (int lev = 0; lev < nvrt; lev++)
 9224:                out[lev] = node->z[lev];
 9225:          break;
 9226:       }
 9227:       case (int)VarCode::w: {
 9228:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9229:          if (k >= 0)
 9230:             out[0] = node->w2[k];
 9231:          else
 9232:             for (int lev = 0; lev < nvrt; lev++)
 9233:                out[lev] = node->w2[lev];
 9234:          break;
 9235:       }
 9236:       case (int)VarCode::dfh: {
 9237:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9238:          if (k >= 0)
 9239:             out[0] = node->dfh[k];
 9240:          else
 9241:             for (int lev = 0; lev < nvrt; lev++)
 9242:                out[lev] = node->dfh[lev];
 9243:          break;
 9244:       }
 9245:       case (int)VarCode::dfv: {
 9246:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9247:          if (k >= 0)
 9248:             out[0] = node->dfv[k];
 9249:          else
 9250:             for (int lev = 0; lev < nvrt; lev++)
 9251:                out[lev] = node->dfv[lev];
 9252:          break;
 9253:       }
 9254:       case (int)VarCode::tke: {
 9255:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9256:          if (k >= 0)
 9257:             out[0] = node->turb.tke[k];
 9258:          else
 9259:             for (int lev = 0; lev < nvrt; lev++)
 9260:                out[lev] = node->turb.tke[lev];
 9261:          break;
 9262:       }
 9263:       case (int)VarCode::mxl: {
 9264:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9265:          if (k >= 0)
 9266:             out[0] = node->turb.mxl[k];
 9267:          else
 9268:             for (int lev = 0; lev < nvrt; lev++)
 9269:                out[lev] = node->turb.mxl[lev];
 9270:          break;
 9271:       }
 9272:    }
 9273: }
