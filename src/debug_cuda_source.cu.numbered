 2257: /**
 2258:  * Find the element that contains the target point.
 2259:  * 
 2260:  * @param x0,y0,z0     Starting position coordinates
 2261:  * @param xt,yt,zt     Target position coordinates
 2262:  * @param dtb          Time step for tracking
 2263:  * @param u_int        Initial velocity components
 2264:  * @param nextElem     Starting/resulting element index
 2265:  * 
 2266:  * @return Status code of type trackExitCodes
 2267:  * 
 2268:  * Uses the Leaded Celestial Walk algorithm to find the element that contains the target point.
 2269:  * This is a variant of the Celestial Walk algorithm that goes from element A containing the starting 
 2270:  * point x0 (in one side) to element B containing the target point xt. To enforce that the next element is
 2271:  * as close the the segment AB as possible, the next point at each iteration is computed
 2272:  * along segment AB, but just after the current element.
 2273:  */
 2274: 
 2275: 
 2276: __device__ __forceinline__ bool celestialWalk(Element *&curElem, Point3 x0, Point3 &xt, const Side *origSide, Side *&lastCrossSide, int jlev) {
 2277: 
 2278:    constexpr int MAX_ITERATIONS = 40;
 2279: 
 2280:    int iter = 0;
 2281:    double fac = 0.00001;
 2282:    while (iter < MAX_ITERATIONS) {
 2283:       iter++;
 2284: 
 2285:       Bool4 isLeft, isObtuse, isBisector;
 2286:       curElem->computePredicates(toPoint2(x0), toPoint2(xt), fac, origSide, isLeft, isObtuse, isBisector, jlev);
 2287: // showPoints(x0, xt, jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2288:       Bool4 isValid = !isLeft & (!isObtuse | isBisector); // bitwise operation are overloaded
 2289: 
 2290: 
 2291:       if (isValid.none()) 
 2292:       // Inside the element if none of the edges is a valid continuation
 2293:       {
 2294:          // Just returns true and the element (curElem) is unchanged).
 2295:          // This means that the algorithm has found the element that contains the target point.
 2296:          return true;
 2297:       }
 2298:       else { // Outside the element
 2299: 
 2300:          // Outside this element. Pick the first valid exit side and cross.
 2301:          lastCrossSide = curElem->sides[isValid.firstOne()];
 2302:          Element *prevElem = curElem;
 2303:          curElem = lastCrossSide->otherElem(curElem);
 2304: 
 2305:          // If it crosses into a dry element or a boundary element, return false. This means that the track will now move 
 2306:          // along the boundary.
 2307:          if (curElem == nullptr || curElem->isDry) {
 2308:          
 2309:             curElem = prevElem;
 2310:             return false;
 2311:          }
 2312:          
 2313:       }
 2314: 
 2315:    }
 2316: 
 2317:   assert(false && "Leaded Celestial Walk: exceeded max iterations");
 2318: }
 2319: 
