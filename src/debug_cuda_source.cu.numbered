 3640: 
 3641: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3642:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3643:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3644: 
 3645: 
 3646:    NODE(node1);
 3647: 
 3648:    node1->clearMatrixRow();
 3649:    node1->qel = 0.0;
 3650: 
 3651:    // THIS IS FOR STRUCTURES XXX
 3652:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3653: 
 3654:    
 3655:    for (int j=0; j<node1->numElements; j++) {
 3656:       // For each element connected to the node...
 3657: 
 3658:       Element *elem = node1->elements[j];
 3659: 
 3660: 
 3661: 
 3662:       // Compute the average gravity
 3663:       const double grav3 = elem->mean(&Node::grav2);
 3664: 
 3665:       // Look at the documentation for the description of the terms in the following integrals
 3666: 
 3667:       // Integral I_1 
 3668:       // \bar{\breve{H}} 
 3669:       const double hhatb = elem->mean(&Side::hhat);        
 3670: 
 3671:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3672: 
 3673:       const int id1 = elem->nodeLocalIdx(node1); 
 3674:       const double area = elem->area;
 3675: 
 3676:       if (elem->isTri()) {
 3677: 
 3678:          // To clarify the notation in this section: 
 3679:          //   i stands for the node under consideration (node1)
 3680:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3681:          const int id2 = elem->nxq(1 + id1);
 3682:          const int id3 = elem->nxq(2 + id1);
 3683:          Node *node2 = elem->nodes[id2];
 3684:          Node *node3 = elem->nodes[id3];
 3685: 
 3686:          Point2 x1, x2, x3;
 3687:          elem->getLocalHorizontalNodePositions(x1, x2, x3);
 3688: 
 3689:          // integral of phi_i*phi_j
 3690:          const double ipp_ii = (1.0/6.0 )*area;
 3691:          const double ipp_ij = (1.0/12.0)*area;
 3692:          const double ipp_ik = (1.0/12.0)*area;
 3693: 
 3694:          // integral of [(grad phi_i) * (grad phi_j)]
 3695:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3696:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3697:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3698: 
 3699:          // Computes the different components of integral I_1 of each node with respect to node i.
 3700:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3701:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3702:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3703: 
 3704:          node1->addToSparseMatrix(node1, I1_ii);
 3705:          node1->addToSparseMatrix(node2, I1_ij); 
 3706:          node1->addToSparseMatrix(node3, I1_ik);
 3707: 
 3708:       }
 3709:       else { // Quad
 3710:          // XXX IMPLEMENT THIS
 3711:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3712: 
 3713:          // To clarify the notation in this section: 
 3714:          //   i stands for the node under consideration (node1)
 3715:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3716:          const int id2 = elem->nxq(1 + id1);
 3717:          const int id3 = elem->nxq(2 + id1);
 3718:          const int id4 = elem->nxq(3 + id1);
 3719:          Node *node2 = elem->nodes[id2];
 3720:          Node *node3 = elem->nodes[id3];
 3721:          Node *node4 = elem->nodes[id4];         
 3722: 
 3723:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3724:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3725:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3726:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3727:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3728: 
 3729:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3730:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3731:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3732:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3733:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3734: 
 3735:          // Computes the different components of integral I_1 of each node with respect to node i.
 3736:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3737:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3738:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3739:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3740: 
 3741:          node1->addToSparseMatrix(node1, I1_ii);
 3742:          node1->addToSparseMatrix(node2, I1_ij); 
 3743:          node1->addToSparseMatrix(node3, I1_ik);
 3744:          node1->addToSparseMatrix(node4, I1_il);
 3745:   
 3746:       } 
 3747: 
 3748:  
 3749:       // Integral I_4
 3750:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3751:       // Where
 3752:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3753: 
 3754:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3755:       // of U over the element.
 3756:       Vector2 U = {0.0, 0.0};
 3757:       for (int m=0; m < elem->i34; m++) {      
 3758:          const Side *side = elem->sides[m];
 3759: 
 3760:          if constexpr(ics == 1) U += side->U; 
 3761:          else                   U += side->frame.projHorVec(side->U, elem->frame);  // In global coordinates, we must project the side velocity to the element frame
 3762:       }
 3763:       U = U/elem->i34;
 3764: 
 3765: 
 3766:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3767: 
 3768: 
 3769:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3770:       const double I_4_1 = dot(gradPhi_1, U);
 3771: 
 3772: 
 3773:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3774:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3775: 
 3776:      
 3777:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3778: 
 3779:       // Additional terms 
 3780:       double vnorm = 0.0;
 3781:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3782:          Vector3 ubed = {0.0, 0.0, 0.0};
 3783:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3784: 
 3785:          Vector3 gradP = {0.0, 0.0, 1.0};
 3786:          for (int m=0; m < elem->i34; m++) {
 3787:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3788:            gradP += toVector3(gradP_2D, 0.0);
 3789:          }   
 3790:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3791:       } // imm==2
 3792: 
 3793:       if (elem->isTri()) {
 3794:          for (int l=0; l<3; l++) {
 3795: 
 3796:             Node *node = elem->nodes[l];
 3797: 
 3798:             double fac = (node == node1) ? 2.0 : 1.0;
 3799:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3800:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3801:            
 3802:          }
 3803: 
 3804: 
 3805:          if (!elem->isDry) {
 3806:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3807: 
 3808:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3809: 
 3810:          }
 3811: 
 3812:       } // isTri
 3813:       else { // isQuad
 3814:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3815:          // for (int l=0; l<4; l++) {
 3816:          //   const Node *node = elem->nodes[l];
 3817: 
 3818:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3819:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3820: 
 3821:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3822:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3823:          // }
 3824: 
 3825:       } // isQuad
 3826: 
 3827: 
 3828:      node1->qel += (dt/elem->i34)*elem->vsource;
 3829:       
 3830: 
 3831:    } // for all elements connected to the node
 3832:    
 3833: 
 3834:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3835:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 3836:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3837:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3838:       // If it is an open boundary node...
 3839: 
 3840:       // At least one open bnd side, maybe two
 3841:       for (int l=0; l<2; l++) { 
 3842: 
 3843:          // Gets each of the sides sharing the node. 
 3844:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3845: 
 3846:        
 3847: 
 3848:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3849:          if (sideBnd != nullptr) {
 3850:             // If the side is on a boundary...
 3851: 
 3852:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3853: 
 3854:             // Get the boundary segment
 3855:             const BoundarySegment *sideSegment = sideBnd->segment;
 3856:             const Side *side = sideBnd->side;
 3857: 
 3858:             // Integral I_3
 3859:             if (sideSegment->ifltype != 0) {
 3860:             // Natural or Flather b.c.
 3861: 
 3862:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3863:                // especially for Flather b.c.
 3864:                double ri3 = 0.0;
 3865:                if (!side->isDry) {
 3866:                   // If the side is not dry
 3867:                   
 3868:                   // Computes the side flux of (uth, vth)
 3869:                   double Vn = 0.0;
 3870:                   for (int k = side->kb; k < nvrt - 1; k++) {
 3871:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3872:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3873: 
 3874:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 3875:                   }
 3876: 
 3877:                   ri3 = 0.5*side->len*Vn;
 3878:                }
 3879: 
 3880:                if (sideSegment->ifltype == -1) { // Flather 1
 3881: 
 3882:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3883:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3884: 
 3885:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3886:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3887:                   
 3888:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3889:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3890: 
 3891:                } 
 3892:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3893:                   // Reset ri3
 3894:                   ri3 = 0.0;
 3895: 
 3896:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3897: 
 3898:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3899: 
 3900:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3901:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3902: 
 3903:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3904:                   node1->addToSparseMatrix(node1, con0*2.0);
 3905:                   node1->addToSparseMatrix(node2, con0);
 3906: 
 3907:                } // if Flather or Discharge
 3908: 
 3909:                node1->qel -= thetai*dt*ri3;
 3910: 
 3911: 
 3912:             } // I_3
 3913:           
 3914: 
 3915:             // Integral I_5
 3916:             if(!side->isDry) {
 3917: 
 3918:                const double Unbar = dot(side->U, side->n);
 3919:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3920: 
 3921:             } // I_5
 3922: 
 3923:          } // if is boundary side
 3924: 
 3925:       } // for l
 3926: 
 3927:    } // if isbnd
 3928: 
 3929: 
 3930: }
 3931: 
 3932: 
 3933: 
 3934: extern "C" {
 3935:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 3936:                                   int* indices, int* indptr) {
 3937: 
 3938:       NODE(node);
 3939:       
 3940:       const int idx = node->idx;
 3941:       
 3942:       // Computes the index in the nzz array      
 3943:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 3944: 
 3945: 
 3946:       indptr[idx] = nzzIdx;
 3947:       indices[nzzIdx] = idx;
 3948: 
 3949:       data_d[nzzIdx]    = node->coeffDiag;
 3950: 
 3951:       b_d[idx] = node->qel;
 3952: 
 3953:       for (int k = 0; k < node->numNodes; ++k) {
 3954:          const Node* nb = node->nodes[k];
 3955: 
 3956:          const int j = nb->idx;
 3957: 
 3958:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 3959: 
 3960:          indices[nzzIdx + k + 1] = j;
 3961:       }
 3962: 
 3963:  
 3964:    }
 3965: 
 3966: 
 3967: 
 3968:    __global__ void solverCopyResult(double* x) {
 3969:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 3970:       NODE(node);
 3971:       const int idx = node->idx;
 3972: 
 3973:       node->mX = x[idx];
 3974:    }
 3975: 
 3976: 
 3977:    __global__ void rollUpElevation(void) {
 3978: 
 3979:       NODE(node);
 3980: 
 3981:       node->eta1 = node->eta2;
 3982: 
 3983:    }
 3984: 
 3985: 
 3986:    __global__ void backtrackAllNodes(void) {
 3987: 
 3988:       // max/min # of sub-divisions
 3989:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 3990:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 3991: 
 3992: 
 3993:       SIDE(side);
 3994: 
 3995:       const int kb = side->kb;
 3996: 
 3997: 
 3998:       // Initialize btrack velocities to the actual velocities at the side 
 3999:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4000: 
 4001:   
 4002: 
 4003:       if (side->isDry) return;
 4004:       
 4005: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4006: 
 4007:       // Checks that at least one element is not dry
 4008:       const Element *elem1 = side->elems[0];
 4009:       const Element *elem2 = side->elems[1];
 4010: 
 4011: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4012: 
 4013:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4014:       
 4015:       // XXXXXX
 4016:       // !swild_tmp to store global coord. of the starting side
 4017:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4018:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4019:       // !Use sframe2 
 4020:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4021: 
 4022: 
 4023:       for (int k = kb; k < nvrt; k++) {
 4024:       //  Initialize (xt,yt,zt), nnel and vel.
 4025:       //  For ics=2, the coordinates are all in the side's local frame
 4026:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 4027: 
 4028: 
 4029:          const int iadvf = side->iadv();  // Advection flag   
 4030:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4031: 
 4032: 
 4033:          // If on land or open boundary...
 4034:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 4035:          
 4036:          const double vmag = length(side->u2[k]);
 4037: 
 4038:          if (vmag <= velmin_btrack) {
 4039:             // No activity 
 4040: 
 4041:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4042: // addDebugPlot(side->center, side->center, 0x00000F, '+');     
 4043: 
 4044: 
 4045:             
 4046:          } else {  // do btrack
 4047: 
 4048:             // Compute number of sub-divisions based on local gradients of the velocity field
 4049: 
 4050:             // XXX IS THIS NECESSARY?
 4051:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4052:             double suma = 0.0;
 4053:             int icount = 0;
 4054:             for (int l=0; l<2; l++) {
 4055:             // For each element sharing the side...
 4056: 
 4057:                const Element *elem = side->elems[l];
 4058:                  
 4059:                if (elem == nullptr) continue;
 4060: 
 4061:                icount++;
 4062: 
 4063:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 4064:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 4065:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 4066: 
 4067:                double utmp[4];
 4068:                double vtmp[4];
 4069:                for (int j = 0; j < elem->i34; j++) {
 4070: 
 4071:                   const Node *node = elem->nodes[j];
 4072: 
 4073:                   if constexpr(ics==1) {
 4074:                      utmp[j] = node->u2[k].x;
 4075:                      vtmp[j] = node->u2[k].y;  
 4076: 
 4077:                   } else {
 4078:                      // 'Project' the velocity from the node frame to the element frame
 4079:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 4080:                      utmp[j] = tmp_u2.x;
 4081:                      vtmp[j] = tmp_u2.y;
 4082: 
 4083:                   }
 4084:                } // for j
 4085: 
 4086:                const Vector2 grad_u = elem->grad2(utmp); 
 4087:                const Vector2 grad_v = elem->grad2(vtmp);
 4088: 
 4089:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4090:             } // for ii
 4091: 
 4092:             assert(icount > 0 && "Impossible 77");
 4093: 
 4094:             // '4' is somewhat arbitrary
 4095:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4096: 
 4097:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4098: 
 4099:             Vector3 u_int = {0.0, 0.0, 0.0};
 4100: 
 4101:             bool res =side->btrack(k, dt, dtbk, u_int);
 4102: 
 4103:             side->btu[k] = toVector2(u_int);
 4104:                
 4105:          } // if vmag (do backtrack)
 4106: 
 4107: 
 4108:       } // for k=kb,nvrt-1
 4109: 
 4110:    }
 4111: 
 4112: } // extern "C"
 4113: 
 4114: template<int nc>
 4115: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4116: 
 4117: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4118: //
 4119: // a,b,c,rhs: input vectors and are not modified by this program.
 4120: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4121: // rhs is the r.h.s.
 4122: // n: actual rank of the system.
 4123: // rows in u() and rhs();
 4124: // u: output with nc columns (transposed to rows)
 4125: // gam: a working array.
 4126: //
 4127: // NOTES:
 4128: // This is a template function that allows for different numbers of columns in the rhs vector.
 4129: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4130: 
 4131:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4132:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4133: 
 4134:    double bet = b[0];
 4135:    if constexpr (nc == 1) {
 4136:       u[0] = rhs[0]/bet;
 4137:    } else {
 4138:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4139:    }
 4140: 
 4141:    for (int j = 1; j < n; j++) {
 4142:       gam[j] = c[j - 1]/bet;
 4143:       bet = b[j] - a[j]*gam[j];
 4144: 
 4145:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4146: 
 4147:       if constexpr (nc == 1) {
 4148:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4149:       } else {
 4150:          for (int l = 0; l < nc; l++) {
 4151:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4152:          }
 4153:       }
 4154:    }
 4155: 
 4156:    // Back-substitution
 4157:    for (int j = n - 2; j >= 0; j--) {
 4158:       if constexpr (nc == 1) {
 4159:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4160:       } else {
 4161:          for (int l = 0; l < nc; l++) {
 4162:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4163:          }
 4164:       }
 4165:    }
 4166: }
 4167: 
 4168: 
 4169: 
 4170: // Helper function that contains the core algorithm
 4171: template<typename XAccessor, typename YAccessor>
 4172: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4173:                                     double  yp_top, double  yp_bot, 
 4174:                                     CubicSpline &spline) {
 4175:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4176:    // 
 4177:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4178:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4179:    //
 4180:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4181:    // 
 4182:    // Inputs: 
 4183:    //            n: dimension for x etc; # of data pts (>=2);
 4184:    //            getX, getY: functions to access x,y coordinates
 4185:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4186:    //     Output: 
 4187:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4188: 
 4189:    const int n = k2 - k1 + 1;
 4190:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4191: 
 4192:    // Allocate memory for the splines
 4193:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4194:    spline.x   = new double[n];
 4195:    spline.y   = new double[n];
 4196:    spline.yp  = new double[n];
 4197:    spline.ypp = new double[n];
 4198: 
 4199:    for (int k=k1; k<=k2; k++) {
 4200:       spline.x[k] = getX(k);
 4201:       spline.y[k] = getY(k);
 4202:    }
 4203: 
 4204:    // This is to simplify expressions later
 4205:    double *x = spline.x;
 4206:    double *y = spline.y;
 4207: 
 4208:    double *a = nullptr;
 4209:    double *b = nullptr;
 4210:    double *c = nullptr;
 4211:    double *gam = nullptr;
 4212:    double *rhs = nullptr;
 4213:    
 4214: 
 4215:       a = new double[n];   // Lower diagonal
 4216:       b = new double[n];   // Diagonal
 4217:       c = new double[n];   // Upper diagonal
 4218:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4219:       rhs = new double[n]; // Right-hand side
 4220: 
 4221:    for (int k=k1; k<=k2; k++) {
 4222:       if (k == k1) {
 4223:          // Bottom level
 4224:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4225:          b[k] = (x[k+1] - x[k])/3.0;
 4226:          c[k] = b[k]/2.0;
 4227:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4228:       } else if (k == n - 1) {
 4229:          // Top level (surface)
 4230:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4231:          b[k] = (x[k] - x[k-1])/3.0;
 4232:          a[k] = b[k]/2.0;
 4233:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4234:       } else {
 4235:          // Intermediate levels
 4236:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4237:          b[k] = (x[k+1] - x[k-1])/3.0;
 4238:          a[k] = (x[k  ] - x[k-1])/6.0;
 4239:          c[k] = (x[k+1] - x[k  ])/6.0;
 4240:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4241:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4242:       }
 4243:    }
 4244: 
 4245:    // Solve the tridiagonal system
 4246:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4247:    
 4248:    spline.yp[k1] = yp_bot;
 4249:    spline.yp[k2] = yp_top;
 4250: 
 4251:    // Compute rest of 1st derivatives using the splines
 4252:    for (int k=k1+1; k<k2; k++) {
 4253:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4254:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4255:    }
 4256:    
 4257:    delete[] a;
 4258:    delete[] b;
 4259:    delete[] c;
 4260:    delete[] gam;
 4261:    delete[] rhs;
 4262: 
 4263: }
 4264: 
 4265: // Array version
 4266: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4267:                                 double y_top, double y_bot, 
 4268:                                 CubicSpline &spline) {
 4269:    auto getX = [x] (int k) { return x[k]; };
 4270:    auto getY = [y] (int k) { return y[k]; };
 4271:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4272: }
 4273: 
 4274: // Lambda version - allows custom access patterns
 4275: template<typename XFunc, typename YFunc>
 4276: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4277:                                 double y_top, double y_bot,
 4278:                                 CubicSpline &spline) {
 4279:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4280: }
