 2332: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2333: // return;   
 2334:    // Lock the mutex
 2335:    lock(&debugPlotMutex);
 2336:  
 2337:    bool ok = true;
 2338:    if (debugPlotIdx == nullptr) ok = false;
 2339:    if (*debugPlotIdx >= 1000000) ok = false;
 2340:    if (ok) {
 2341:       debugPlot[(*debugPlotIdx) + 0*1000000] = x1.x;
 2342:       debugPlot[(*debugPlotIdx) + 1*1000000] = x1.y;
 2343:       debugPlot[(*debugPlotIdx) + 2*1000000] = x2.x;
 2344:       debugPlot[(*debugPlotIdx) + 3*1000000] = x2.y;
 2345:       debugPlot[(*debugPlotIdx) + 4*1000000] = (double)color;
 2346:       debugPlot[(*debugPlotIdx) + 5*1000000] = (double)(((int)(unsigned char)marker & 0xFF) | ((dashLen & 0xFF) << 8) | ((width & 0xFF) << 16));
 2347:       debugPlot[(*debugPlotIdx) + 6*1000000] = (double)label;
 2348:       (*debugPlotIdx)++;
 2349:    }
 2350: 
 2351:    __threadfence();               // ensure all above writes are visible
 2352:    // Unlock the mutex
 2353:    unlock(&debugPlotMutex);
 2354: 
 2355: }
