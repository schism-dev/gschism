 7474: 
 7475: __global__ void computeMatrixProductAndDotProducts() {
 7476:    // Computes A*p, r'Mr and p'Ap
 7477: 
 7478:    // 1) shared buffer: first half for rMr, second for pAp
 7479:    __shared__ double sdata[2*BLOCK_SIZE];
 7480:    double* s_rMr = sdata;
 7481:    double* s_pAp = sdata + BLOCK_SIZE;
 7482: 
 7483:    const int tid = threadIdx.x;
 7484: 
 7485:    double l_pAp = 0.0;
 7486: 
 7487:    s_rMr[tid] = 0.0;
 7488:    s_pAp[tid] = 0.0;
 7489: 
 7490:    // 2) get your node pointer
 7491:    // NODE(node);   
 7492:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7493:    Node *node = &(mesh->localNodeData[idx_node]); 
 7494:    if (idx_node < mesh->np) {
 7495: 
 7496: 
 7497:    const double diag = node->coeffDiag;
 7498:    const double r    = node->mR;
 7499:    const double p    = node->mP;  
 7500: 
 7501:    // apply preconditioner on the fly:
 7502:    // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7503: 
 7504:    // 4) compute Ap = A.p
 7505:    double Ap = node->coeffDiag * node->mP;
 7506:    for (int j = 0; j < node->numNodes; ++j) {
 7507:       const Node *nbNode = node->nodes[j];
 7508:       Ap += node->coeffMatrix[j] * nbNode->mP;
 7509: 
 7510:    }
 7511: 
 7512:    node->mAp = Ap;
 7513:     
 7514: 
 7515:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 7516:    // const double l_rMr = r*Mr;  // r'Mr
 7517:    l_pAp = p*Ap;  // p'Ap
 7518: 
 7519: 
 7520:    }
 7521: 
 7522:    // 6) write into shared mem
 7523:    // s_rMr[tid] = l_rMr;
 7524:    s_pAp[tid] = l_pAp;
 7525: 
 7526:    __syncthreads();
 7527: 
 7528:    // 7) block-wide tree reduction
 7529:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7530:       if (tid < stride)  {
 7531:          s_pAp[tid] += s_pAp[tid + stride];
 7532:       }
 7533:       __syncthreads();
 7534:    }
 7535: 
 7536:    // 8) thread 0 atomically accumulates into the globals
 7537:    // XXX: This is slower than it needs to be, but it is simple and works
 7538:    if (tid == 0) {
 7539:       atomicAdd(pAp, s_pAp[0]);
 7540:    }
 7541: 
 7542: 
 7543: }
 7544: 
 7545: 
 7546: __global__ void updateSolutionAndDotProducts(void) {
 7547:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7548: 
 7549:    const int tid = threadIdx.x;
 7550: 
 7551:    s_rMr[tid] = 0.0;
 7552: 
 7553:    // get node & bounds-check:
 7554:    NODE(node);
 7555: 
 7556:    
 7557:    // Compute alpha
 7558:    const double alpha = (*rMr_old)/(*pAp);
 7559: 
 7560:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7561: 
 7562: 
 7563:    // load scalars
 7564:    const double diag = node->coeffDiag;
 7565:    const double p    = node->mP;
 7566:    const double Ap   = node->mAp;
 7567:    const double x    = node->mX;
 7568:    const double r    = node->mR;
 7569:    
 7570:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7571: 
 7572:    // 1) update solution & residual
 7573:    const double x_new = x + alpha*p;
 7574:    const double r_new = r - alpha*Ap;
 7575:    node->mX = x_new;
 7576:    node->mR = r_new;
 7577: 
 7578:    // 2) apply Jacobi preconditioner on the fly
 7579:    const double Mr_new = r_new/diag;
 7580: 
 7581: 
 7582:    // 3) local contributions for the two dot-products
 7583:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7584: 
 7585:    // 4) write into shared-mem
 7586:    s_rMr[tid] = l_rMr;
 7587: 
 7588:    __syncthreads();
 7589: 
 7590: 
 7591:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7592:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7593:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7594:       __syncthreads();
 7595:    }
 7596: 
 7597:    // 6) thread 0 atomically folds into the global accumulators
 7598:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7599: 
 7600: 
 7601: }
 7602: 
 7603: 
 7604: __global__ void updateSearchDirection() {
 7605: 
 7606:     NODE(node);
 7607: 
 7608:     // recompute z on-the-fly
 7609:     const double z = node->mR / node->coeffDiag;
 7610:     const double p = node->mP;
 7611: 
 7612:     const double beta = (*rMr_new)/(*rMr_old);
 7613: 
 7614: 
 7615:     // p =z + beta*p
 7616:     node->mP = z + beta*p;
 7617: 
 7618: }
 7619: 
 7620: __global__ void initializePreconditionedResidual(double *scalars) {
 7621: 
 7622:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 7623: 
 7624:     s_rMr[threadIdx.x] = 0.0;
 7625: 
 7626:     NODE(node);
 7627:     const int tid = threadIdx.x;
 7628:     // For the first iteration:
 7629:     // 1. Initial solution x = 0 (already set)
 7630:     // 2. Initial residual r = b (stored in qel)
 7631:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7632: 
 7633: // XXX we should use the guess solution here    
 7634: 
 7635:     // Set initial residual r = b (from qel)
 7636:     node->mR = node->qel;
 7637: 
 7638:     // Compute z = M^-1 * r (preconditioned residual)
 7639:     const double z = node->mR / node->coeffDiag;
 7640: 
 7641:     // Set initial search direction p = z
 7642:     node->mP = z;
 7643: 
 7644:     // Initialize other variables needed for CG
 7645:     node->mX = 0.0;  // Initial solution
 7646:     node->mAp = 0.0; // Will be computed in first iteration
 7647: 
 7648:     // These point to a cupy array in the host code
 7649:     rMr_old = scalars + 0;
 7650:     rMr_new = scalars + 1;
 7651:     pAp     = scalars + 2;
 7652: 
 7653:     // Computes the first r'Mr (reduction)
 7654:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7655: 
 7656:     // 4) write into shared-mem
 7657:     s_rMr[tid] = l_rMr;
 7658: 
 7659:     __syncthreads();
 7660: 
 7661: 
 7662:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7663:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7664:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7665:         __syncthreads();
 7666:     }
 7667: 
 7668:     // 6) thread 0 atomically folds into the global accumulators
 7669:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7670: 
 7671:     *rMr_old = 0.0;
 7672:     *pAp = 0.0;
 7673: }
 7674: 
 7675: 
 7676: 
 7677: 
 7678: extern "C" __global__ void getElementVar(int varCode, double *var, int k = -1, int j = -1) {
 7679:    // Get the value of a variable from an element
 7680:    // varName is the name of the variable to get
 7681:    // var is the array to store the value
 7682:    // k is the vertical level index of the variable to get
 7683: 
 7684:    ELEM(elem);
 7685:    
 7686:    int idx = elem->idx;
 7687:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7688: 
 7689:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7690:    if      (varCode == (int)VarCode::w && k >= 0)       var[idx] = elem->w[k];
 7691:    else if (varCode == (int)VarCode::z && k >= 0)       var[idx] = elem->z[k];
 7692:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = elem->center.x;
 7693:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = elem->center.y;
 7694:    else if (varCode == (int)VarCode::area && k == -1)   var[idx] = elem->area;
 7695:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = elem->depth;
 7696:    else if (varCode == (int)VarCode::radius && k == -1) var[idx] = elem->radius;
 7697:    else if (varCode == (int)VarCode::xlon && k == -1)   var[idx] = elem->xlon;
 7698:    else if (varCode == (int)VarCode::ylat && k == -1)   var[idx] = elem->ylat;
 7699:    else if (varCode == (int)VarCode::ghatx && k == -1)  var[idx] = elem->ghat1.x;
 7700:    else if (varCode == (int)VarCode::ghaty && k == -1)  var[idx] = elem->ghat1.y;
 7701:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(elem->kb);
 7702:    else if (varCode == (int)VarCode::ssign && k == -1 && j > -1)  var[idx] = (double)(elem->ssign[j]);
 7703:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7704:       
 7705:    
 7706: }
 7707: 
 7708: 
 7709: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7710:    // Get the value of a variable from an node
 7711:    // varName is the name of the variable to get
 7712:    // var is the array to store the value
 7713:    // k is the vertical level index of the variable to get
 7714: 
 7715:    NODE(node);
 7716:    
 7717:    int idx = node->idx;
 7718:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7719: 
 7720:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7721:    
 7722:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7723:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7724:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = node->p.y;
 7725:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7726:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 7727:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7728:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7729:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;   
 7730:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7731:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7732:    else if (varCode == (int)VarCode::v && k >= 0)       var[idx] = node->u2[k].y;
 7733:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->u2[k].z;
 7734:    
 7735:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7736:       
 7737:    
 7738: }
 7739: 
 7740: 
 7741: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7742:    // Get the value of a variable from an side
 7743:    // varName is the name of the variable to get
 7744:    // var is the array to store the value
 7745:    // k is the vertical level index of the variable to get
 7746:    SIDE(side);
 7747:    
 7748:    int idx = side->idx;
 7749:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7750: 
 7751:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 7752:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 7753:    else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 7754:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 7755:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 7756:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 7757:    else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 7758:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 7759:    else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 7760:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 7761:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 7762:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 7763:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 7764:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 7765:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 7766:    else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 7767:    else if (varCode == (int)VarCode::bccx && k >= 0)     var[idx] = side->bcc[k].x;
 7768:    else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 7769:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7770:    else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7771:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7772:    else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7773:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 7774:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->isLand:0.0;
 7775:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 7776:    else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 7777:    else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 7778:    else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 7779:    else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 7780:    else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 7781:    else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 7782:    else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 7783:    else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 7784:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7785: }
