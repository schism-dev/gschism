 1049: // This struct is used to store the boundary information for a node.
 1050: struct NodeBoundary {   
 1051:    BoundarySegment *segment;
 1052:    Node *node;
 1053:    
 1054:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1055:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1056: 
 1057:    bool isLand;
 1058: 
 1059:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1060:    double elbc;   // Elevation boundary condition
 1061:    double eth;    // Elevation time history
 1062: 
 1063:    double eta_mean; // Mean elevation at nodes
 1064: 
 1065:    bool isEssentialBC;
 1066: 
 1067:    Vector2 uth[nvrt];           // "Time history" velocity
 1068: 
 1069:    // Arrays for harmonic constituents (if needed)
 1070:    double  emo[nbfr];  // Elevation amplitude
 1071:    double  efa[nbfr];  // Elevation phase
 1072:    Vector2 umo[nbfr];  // velocity amplitude
 1073:    Vector2 ufa[nbfr];  // velocity phase
 1074: 
 1075: 
 1076:    NodeBoundary(void) {
 1077:       isLand = false;
 1078:    }
 1079:    NodeBoundary(bool _isLand) {
 1080:       isLand = _isLand;
 1081:    }
 1082: 
 1083:    
 1084:    __forceinline__ __device__ int numSidesForAverage() const {
 1085:    // Returns the number of sides that are connected to the node and have the same segment.
 1086:    // This is used to compute the average velocity at the node for open boundary nodes.
 1087:       int res = 0;
 1088:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1089:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1090: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1091:       return res;
 1092:    }
 1093: 
 1094: 
 1095:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1096:       assert(index == 0 || index == 1); 
 1097:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1098:    }
 1099: 
 1100: 
 1101: };
