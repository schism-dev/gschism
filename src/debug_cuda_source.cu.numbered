 4471: extern "C" {
 4472: 
 4473:    __global__ void scaleGravity(double loadtide_coef) {
 4474: 
 4475: 
 4476:       NODE(node);
 4477: 
 4478:       // SAL option: scale gravity
 4479:       if constexpr(iloadtide==2) {  // simple const
 4480:          node->grav2 = grav*(1.0 - loadtide_coef);
 4481: 
 4482:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4483:         
 4484:           const double depth = max(node->depth, 0.0);
 4485:           const double tmp1 = sqrt(depth);
 4486:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4487:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4488:                              2.6969e-13*depth*depth*depth*tmp1;
 4489:           
 4490:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4491:           
 4492: 
 4493: 
 4494:           node->grav2 = grav*(1.0 - beta_bar);
 4495: 
 4496:       } else {  // iloadtide=0,1
 4497:         node->grav2=grav;
 4498: 
 4499:       }
 4500: 
 4501:    }
