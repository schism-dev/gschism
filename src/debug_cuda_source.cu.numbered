  184: 
  185: using Vector2 = double2; 
  186: using Vector3 = double3;
  187: using Point2  = double2;
  188: using Point3  = double3;
  189: 
  190: __device__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
  191:     return make_double2(a.x + b.x, a.y + b.y);
  192: }
  193: using Vector2 = double2; 
  194: using Vector3 = double3;
  195: __device__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
  196:     a.x += b.x;
  197:     a.y += b.y;
  198:     return a;
  199: }
  200: 
  201: __device__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
  202:     return make_double2(a.x - b.x, a.y - b.y);
  203: }
  204: 
  205: __device__ __forceinline__ double2 operator-=(double2& a, const double2& b) {
  206:     a.x -= b.x;
  207:     a.y -= b.y;
  208:     return a;
  209: }
  210: 
  211: __device__ __forceinline__ double2 operator*(const double2& v, const double s) {
  212:     return make_double2(v.x * s, v.y * s);
  213: }
  214: 
  215: __device__ __forceinline__ double2 operator*(const double s, const double2& v) {
  216:     return v * s;  // reuse the previous operator
  217: }
  218: 
  219: __device__ __forceinline__ double2 operator/(const double2& v, double s) {
  220:     return make_double2(v.x / s, v.y / s);
  221: }
  222: 
  223: __device__ __forceinline__ double norm2(const double2& v) {
  224:     return v.x*v.x + v.y*v.y;
  225: }
  226: 
  227: __device__ __forceinline__ double length(const double2& v) {
  228:     return sqrt(v.x*v.x + v.y*v.y);
  229: }
  230: 
  231: __device__ __forceinline__ double2 normalize(const double2& v) {
  232:     return v / length(v);
  233: }
  234: 
  235: __device__ __forceinline__ double dot(const double2& v, const double2& w) {
  236:     return v.x*w.x + v.y*w.y;
  237: }
  238: 
  239: __device__ __forceinline__ double cross(const double2& v, const double2& w) {
  240:     return v.x*w.y - v.y*w.x;
  241: }
  242: 
  243: __device__ __forceinline__ double2 rot90(const double2& a) {
  244:     return make_double2(a.y, -a.x);
  245: }
  246: 
  247: __device__ __forceinline__ double3 operator+(const double3& a, const double3& b) {
  248:     return make_double3(a.x + b.x, a.y + b.y, a.z + b.z);
  249: }
  250: 
  251: __device__ __forceinline__ double3 operator+=(double3& a, const double3& b) {
  252:     a.x += b.x;
  253:     a.y += b.y;
  254:     a.z += b.z;
  255:     return a;
  256: }
  257: 
  258: __device__ __forceinline__ double3 operator-(const double3& a, const double3& b) {
  259:     return make_double3(a.x - b.x, a.y - b.y, a.z - b.z);
  260: }
  261: 
  262: __device__ __forceinline__ double3 operator*(const double3& v, double s) {
  263:     return make_double3(v.x * s, v.y * s, v.z * s);
  264: }
  265: 
  266: __device__ __forceinline__ double3 operator*(double s, const double3& v) {
  267:     return v * s;
