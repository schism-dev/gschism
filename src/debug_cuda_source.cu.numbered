 3644: __device__ __inline__ void Node::updateZCoordData(void) {
 3645: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3646: 
 3647:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3648:    // if (isDry2()) {
 3649:    //    kb = -1;  // XXXXXXXX KKKKK
 3650:    //    return;
 3651:    // }
 3652: 
 3653: 
 3654:    if constexpr(ivcor == 2) {  // SZ coordinates
 3655:       
 3656:       // Compute bottom level index
 3657:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3658:    } 
 3659:    else {  // if (ivcor == 1) Localized sigma
 3660:       // Do nothing
 3661:    }
 3662: 
 3663: 
 3664: }
