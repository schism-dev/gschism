 2523: 
 2524: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2525: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2526: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 2527: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 2528: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2529: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2530:    Vector2 grad = {0.0, 0.0};
 2531:    int count = 0;
 2532: 
 2533:    if constexpr(ics == 2) assert(false && "grad2: ics = 2 not implemented");
 2534: 
 2535:    // First element
 2536:    if (elems[0] != nullptr && condition(elems[0])) {
 2537:       grad += elems[0]->grad2(field);
 2538:       count++;
 2539:    }
 2540: 
 2541:    // Second element
 2542:    if (elems[1] != nullptr && condition(elems[1])) {
 2543:       grad += elems[1]->grad2(field);
 2544:       count++;
 2545:    }
 2546: 
 2547:    if (count > 0) {
 2548:       grad = grad*(1.0/count);
 2549:    }
 2550:    
 2551:    return grad;
 2552: }
 2553: 
 2554: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 2555: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 2556: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 2557: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 2558: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 2559: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 2560: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 2561: 
 2562: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 2563: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 2564: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 2565: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 2566: 
 2567: 
 2568: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 2569: 
 2570: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 2571: 
 2572: /**
 2573:  * This method performs backtracking from the side center until a time -dt back in time 
 2574:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2575:  * intermediate point.
 2576:  *
 2577:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2578:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2579:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2580:  * remaining time.
 2581:  * 
 2582:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2583:  * 
 2584:  * @param uuint, vvint, wwint: Velocities at the final point
 2585:  * @param jlev: Level at which the backtracking is performed
 2586:  * @param dt, dtbk: Tracking timesteps
 2587:  * @return: True if the backtracking was successful, false otherwise
 2588:  */
 2589: __inline__ __device__ bool Side::btrack(
 2590:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 2591:       double dt,            // Tracking time
 2592:       double dtbk,          // Tracking timestep
 2593:       Vector3 &u_int        // Velocities at the initial point
 2594: ) const {
 2595: 
 2596:    // Start from side center
 2597:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2598: 
 2599:  
 2600:    double time_rm = dt; // Remaining time
 2601: 
 2602: 
 2603:    // Initial velocities
 2604:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 2605: 
 2606:    // Find the element that is in the direction opposite to the velocity
 2607:    Element* curElem = findElementTowards(toVector2(u_int));
 2608:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 2609: 
 2610: 
 2611:    // Nudges it towards the barycenter
 2612:    curElem->nudgeToBarycenter(toPoint2(x0)); // XXXX Necessary?
 2613: 
 2614: 
 2615:    const int MAX_ITERATIONS = 100; 
 2616:    Element* nextElem = nullptr;
 2617:    int iter = 0;
 2618:    // assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 2619:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 2620:    while(true) {
 2621: 
 2622:       // Calculate timestep
 2623:       double dtb = min(dtbk, time_rm);
 2624: 
 2625: // if (idx == 18867) printf("iter = %d, side->idx = %d, curElem->idx = %d, dtb = %.17f, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, curElem->idx, dtb, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);      
 2626: 
 2627:       // Next point in the backtracking curve
 2628: // if (iter >= MAX_ITERATIONS - 50)  {
 2629: //    printf("iter = %d, side->idx = %d, dtb = %.17f, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, dtb, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);
 2630: //    addDebugPlot(x0, x0 - dtb*u_int, 0xFF00FF, '+');        
 2631: // }
 2632:         
 2633:       xt = x0 - dtb*u_int;
 2634: 
 2635:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, time_rm, this);
 2636:       assert(found && "Backtracking failed in btrack");
 2637: 
 2638: 
 2639:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2640:                       // then time_rm needs to be increased by the unused time.
 2641: 
 2642:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0                      
 2643: 
 2644:       // If the velocity is too small, we stop the backtracking
 2645:       const double vmag = length(toVector2(u_int));
 2646:       if (vmag <= velmin_btrack) break;
 2647: 
 2648:       // The current point becomes the next segment's starting point.
 2649:       x0 = xt;
 2650:  
 2651:       curElem = nextElem;
 2652: 
 2653:       iter++;
 2654: 
 2655:       if (iter >= MAX_ITERATIONS) break;
 2656: 
 2657:       // if (iter >= MAX_ITERATIONS - 50) {
 2658:       //    addDebugPlot(center, center, 0xFF001F, 'x');  
 2659:       //    printf("iter = %d, side->idx = %d, elems[0]->idx = %d, elems[1]->idx = %d, curElem->idx = %d, time_rm = %.17f, dtb = %.17f, u_int = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f)\n", iter, idx, elems[0]->idx, elems[1]->idx, curElem->idx, time_rm, dtb, u_int.x, u_int.y, u_int.z, xt.x, xt.y, xt.z);      
 2660:       //    }
 2661:       // assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2662:    }
 2663: 
 2664:    assert(!curElem->isDry && "Final element is dry");
 2665:    assert(curElem->containsPoint(toPoint2(xt)) && "Target point is not inside the final element");
 2666: 
 2667:    // Interpolate the velocities at the final point
 2668:    curElem->interpolateVelocities(xt, u_int);
 2669: 
 2670:    // if (idx == 18867) printf("iter = %d, side->idx = %d, curElem->idx = %d, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, curElem->idx, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);         
 2671: 
 2672: 
 2673: }
 2674: 
 2675: 
