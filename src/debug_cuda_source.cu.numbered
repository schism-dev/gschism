 7176: __global__ void printMatrix(bool full) {
 7177:    // Debugging: print the matrix
 7178: 
 7179:    const int size = mesh->np;
 7180:    double sum = 0.0;
 7181:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7182:       const Node *node = mesh->localNodeData + idx_node;
 7183:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7184:       for (int j = 0; j < node->numNodes; j++) {
 7185:          Node* nbNode = node->nodes[j];
 7186:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7187:          sum += node->coeffMatrix[j];
 7188:       }
 7189:       if (full) printf("]\n");
 7190: 
 7191: 
 7192:    }
 7193:    if (!full) printf("sum=%lf\n", sum);
 7194: }
