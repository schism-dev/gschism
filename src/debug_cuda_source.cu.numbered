 7963:          break;
 7964:       case (int)VarCode::eta:
 7965:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 7966:          *sizeType = sizeof(double);
 7967:          break;
 7968:       case (int)VarCode::x:
 7969:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 7970:          *sizeType = sizeof(Vector2);
 7971:          break;
 7972:       case (int)VarCode::kb:
 7973:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 7974:          *sizeType = sizeof(int);
 7975:          break;
 7976:       case (int)VarCode::isdry:
 7977:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 7978:          *sizeType = sizeof(int);
 7979:          break;         
 7980:       case (int)VarCode::w:
 7981:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 7982:          *sizeType = sizeof(double);
 7983:          break;
 7984:       case (int)VarCode::u:
 7985:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 7986:          *sizeType = sizeof(Vector2);
 7987:          break;         
 7988:       default:
 7989:          *offset = -1;    
 7990:    }  
 7991:    
 7992: }
