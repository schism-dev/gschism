 4726: extern "C" {
 4727: 
 4728:    __global__ void scaleGravity(double loadtide_coef) {
 4729: 
 4730: 
 4731:       NODE(node);
 4732: 
 4733:       // SAL option: scale gravity
 4734:       if constexpr(iloadtide==2) {  // simple const
 4735:          node->grav2 = grav*(1.0 - loadtide_coef);
 4736: 
 4737:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4738:         
 4739:           const double depth = max(node->depth, 0.0);
 4740:           const double tmp1 = sqrt(depth);
 4741:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4742:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4743:                              2.6969e-13*depth*depth*depth*tmp1;
 4744:           
 4745:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4746:           
 4747: 
 4748: 
 4749:           node->grav2 = grav*(1.0 - beta_bar);
 4750: 
 4751:       } else {  // iloadtide=0,1
 4752:           node->grav2 = grav;
 4753: 
 4754:       }
 4755: 
 4756:    }
