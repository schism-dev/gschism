  799:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  800:       // Check if the point (xt,yt) is inside the element
  801:       double shpCoords[4];
  802: 
  803:       bool res = computeShapeCoords(xt, shpCoords, fiNo);
  804: 
  805:       return res;
  806:    }
  807: 
  808:    __inline__ __device__ bool containsPoint(Vector2 &xt, bool fixCoords) const { 
  809:       // Check if the point (xt,yt) is inside the element.
  810:       // If fixCoords is true, and *the point is inside the element*, the point is nudged to be inside the element.
  811:       double shpCoords[4];
  812: 
  813:       Vector2 tmp_xt = xt;
  814:       const EFixIf fixIfCoords = fixCoords ? fiOnlyInside : fiNo;
  815:       bool res = computeShapeCoords(tmp_xt, shpCoords, fixIfCoords);
  816: 
  817:       if (fixCoords && res) xt = tmp_xt;
  818: 
  819:       return res;
  820:    }
  821: 
  822:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  823:    {
  824:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  825:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  826:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  827:       
  828:    }
