 1969:    template<typename T>
 1970:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 1971:       // Get the values of the field at the nodes of the element
 1972:       res[0] = nodes[0]->*field;
 1973:       res[1] = nodes[1]->*field;
 1974:       res[2] = nodes[2]->*field;
 1975:       if (isQuad()) res[3] = nodes[3]->*field;
 1976:       else          res[3] = T();
 1977:    }
 1978: 
 1979:    template<typename T>
 1980:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 1981:       // Get the values of the field at the nodes of the element
 1982:       res[0] = (nodes[0]->*field)[max(level, nodes[0]->kb)];
 1983:       res[1] = (nodes[1]->*field)[max(level, nodes[1]->kb)];
 1984:       res[2] = (nodes[2]->*field)[max(level, nodes[2]->kb)];
 1985:       if (isQuad()) res[3] = (nodes[3]->*field)[max(level, nodes[3]->kb)];
 1986:       else          res[3] = T();
 1987:    }    
 1988: 
 1989:    template<typename T>
 1990:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
 1991:       // Get the values of the func at the nodes of the element
 1992:       res[0] = (nodes[0]->*func)(max(level, nodes[0]->kb));
 1993:       res[1] = (nodes[1]->*func)(max(level, nodes[1]->kb));
 1994:       res[2] = (nodes[2]->*func)(max(level, nodes[2]->kb));
 1995:       if (isQuad()) res[3] = (nodes[3]->*func)(max(level, nodes[3]->kb));
 1996:       else          res[3] = T();  // This is 0.0 or a zero vector
 1997: 
 1998:    }      
 1999: 
 2000:    template<typename T>
 2001:    __device__ __forceinline__ void Element::getSideValues(T Side::* field, T res[4]) const {
 2002:       // Get the values of the field at the nodes of the element
 2003:       res[0] = sides[0]->*field;
 2004:       res[1] = sides[1]->*field;
 2005:       res[2] = sides[2]->*field;
 2006:       if (isQuad()) res[3] = sides[3]->*field;
 2007:       else          res[3] = T();
 2008:    }
 2009: 
 2010:    template<typename T>
 2011:    __device__ __forceinline__ void Element::getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
 2012:       // Get the values of the field at the nodes of the element
 2013:       res[0] = (sides[0]->*field)[max(level, sides[0]->kb)];
 2014:       res[1] = (sides[1]->*field)[max(level, sides[1]->kb)];
 2015:       res[2] = (sides[2]->*field)[max(level, sides[2]->kb)];
 2016:       if (isQuad()) res[3] = (sides[3]->*field)[max(level, sides[3]->kb)];
 2017:       else          res[3] = T();
 2018:    }    
 2019: 
 2020:    template<typename T>
 2021:    __device__ __forceinline__ void Element::getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
 2022:       // Get the values of the func at the nodes of the element
 2023:       res[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2024:       res[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2025:       res[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2026:       if (isQuad()) res[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2027:       else          res[3] = T();  // This is 0.0 or a zero vector
 2028: 
