 2509:    template<typename T>
 2510:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 2511:       T values[4];
 2512:       getNodalValues(level, func, values);
 2513: 
 2514:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2515:       if constexpr (IsVector2<T>::value && ics == 2) {
 2516: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2517:          projectNodeVectorsToElementFrame(values);
 2518: printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2519:       }
 2520: 
 2521:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2522:    }
 2523: 
 2524:    template<typename T>
 2525:    __device__ __forceinline__ T Element::interpolate(const double shapeCoords[4], T Node::* field) const {
 2526:       T values[4];
 2527:       getNodalValues(field, values);
 2528: 
 2529:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2530:       if constexpr (IsVector2<T>::value && ics == 2) {
 2531: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2532:          projectNodeVectorsToElementFrame(values);
 2533: printf("interpolate 3: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2534:       }
 2535:       
 2536:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2537:    }
 2538: 
 2539: 
 2540:    template<typename T>
 2541:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
 2542:       T values[4];
 2543:       getNodalValues(level, field, values);
 2544:       
 2545: if (shapeCoords[0] > 1.1 || shapeCoords[1] > 1.1 || shapeCoords[2] > 1.1 || 
 2546:     shapeCoords[0] < -0.1 || shapeCoords[1] < -0.1 || shapeCoords[2] < -0.1) printf("XXX shapeCoords = (%.17f, %.17f, %.17f, %.17f)\n", shapeCoords[0], shapeCoords[1], shapeCoords[2], shapeCoords[3]);
 2547:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2548:       if constexpr (IsVector2<T>::value && ics == 2) {
 2549: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2550:          projectNodeVectorsToElementFrame(values);
 2551: // printf("interpolate 4: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2552:       }
 2553: 
 2554:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2555:    }
 2556: 
 2557:    template<typename T>
 2558:    __device__ __forceinline__ T Element::mean(T Node::* field) const {
 2559:       T values[4];
 2560:       getNodalValues(field, values);
 2561: 
 2562:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2563:       if constexpr (IsVector2<T>::value && ics == 2) {
 2564: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2565:          projectNodeVectorsToElementFrame(values);
 2566: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2567:       }
 2568: 
 2569:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2570:    }
 2571: 
 2572:    template<typename T>
 2573:    __device__ __forceinline__ T Element::mean(T Side::* field) const {
 2574:       T values[4];
 2575:       getSideValues(field, values);
 2576:       
 2577:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2578:       if constexpr (IsVector2<T>::value && ics == 2) {
 2579: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2580:          projectSideVectorsToElementFrame(values);
 2581: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2582:       }
 2583: 
 2584:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2585:    }   
 2586: 
 2587:    template<typename T>
 2588:    __device__ __forceinline__ T Element::mean(int level,  T (Side::*func)(int) const) const {
 2589: 
 2590:       T values[4];
 2591: 
 2592: 
 2593:       values[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2594:       values[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2595:       values[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2596:       if (isQuad()) values[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2597:       else          values[3] = T();
 2598: 
 2599:       if constexpr (IsVector2<T>::value && ics == 2) projectSideVectorsToElementFrame(values);
 2600: 
 2601:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2602:    }
