 6638: #ifdef DONTCOMPILE
 6639: __device__ void computeVerticalAdvection(void) {
 6640:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6641: 
 6642:    sdbt(1:2,:,:)=0.d0
 6643: 
 6644:    const Side *side = FROM kernel;
 6645: 
 6646:    if(side->isDry) return;
 6647: 
 6648:    // If side is wet...
 6649: 
 6650: 
 6651:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6652:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6653:    double ws[nvrt] = {} // w @ side
 6654:    int icount = 0;
 6655:    for (int j=0; j<2; j++) {
 6656:       const Element *elem = side->elements[j];
 6657:        
 6658:       if(elem != nullptr) {
 6659:          icount++;
 6660:          for (int k=0; k<nvrt; k++) {
 6661:             ws[k] = ws[k] + elem->w[k];
 6662:          }
 6663:       }
 6664:    }  // for j
 6665: 
 6666:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6667:    ws = ws/icount;
 6668: 
 6669:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6670:    // Splines allow for a smooth transition between vertical levels.
 6671:    // Splines have continuity restrictions at the internal knots, but
 6672:    // we have to provide the 1st derivatives at the endpoints.
 6673:    const int kbs = side->kbs; 
 6674:    
 6675:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6676:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6677:    initCubicSpline(kbs, nvrt, side, ws, up)
 6678: 
 6679:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6680:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6681:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6682: 
 6683:    // Total advection (average onto side)
 6684:    const Node *node1 = side->nodes[0];
 6685:    const Node *node2 = side->nodes[1];
 6686:    for (int k=kbs(i); k<nvrt; k++) {
 6687: 
 6688:       if constexpr(ics==1) {
 6689:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6690:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6691:       } else {
 6692:          // XXX IMPLEMENT THIS
 6693:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6694:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6695:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6696:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6697:       }  // if ics
 6698: 
 6699: 
 6700:    }
 6701: }
 6702: #endif
 6703: 
 6704: 
 6705: extern "C" {
 6706:    __global__ void computeElemAverageGhat(void) {
 6707:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6708: 
 6709:       ELEM(elem);
 6710:       
 6711:       elem->ghat1= {0.0, 0.0};  
 6712: 
 6713:       if constexpr(ihydraulics != 0) {
 6714:          if (nhtblocks > 0 && elem->isblock) return;
 6715:       }
 6716: 
 6717:       if (elem->isDry) return;
 6718: 
 6719:       // Wet elements.
 6720:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6721:       // tidal potential, horizontal diffusion, and baroclinic etc
 6722:       // Remember to update both fb and F 
 6723:       // If ics=2, ghat1 are in eframe (ll)
 6724:       // cff1-3: coefficients for 2D/3D
 6725:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6726:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6727:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6728: 
 6729:       double av_cff1 = 0.0;  // av. for cff1
 6730:       double av_cff2 = 0.0;  // av. for cff2
 6731:       double av_cff3 = 0.0;  // av. for cff3
 6732:       double av_df = 0.0;  // av. for H^\alpha / H
 6733:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6734:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6735: 
 6736:       const int i34 = elem->i34;
 6737:       const int kb = elem->kb;
 6738: 
 6739:       for (int j=0; j<i34; j++) {
 6740:          // For each node and side in the element...
 6741: 
 6742:          const Node *node = elem->nodes[j];
 6743:          const Side *side = elem->sides[j];
 6744: 
 6745:          const double chi      = side->chi;
 6746:          const double veg_c2   = side->veg_c2;
 6747:          const double veg_beta = side->veg_beta;
 6748:          const double veg_h    = side->veg_h();
 6749:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6750: 
 6751:          // Node - const in elem
 6752:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6753:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6754: 
 6755:          if (elem->depth >= tip_dp) {
 6756:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6757:          }
 6758: 
 6759:          
 6760:          const double htot  = side->htot2();        // Total depth at the side
 6761:          const double zctr2 = side->zTopCanopy();  
 6762: 
 6763:          double cff1; 
 6764:          double cff2; 
 6765:          double cff3;   
 6766:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6767:          // coefficients applied to 2D/3D case 
 6768:             cff1 = side->hhat/htot;
 6769:             cff2 = 0.0;
 6770:             cff3 = 0.0;
 6771:          } else { //3D
 6772:             //Init for no-veg case
 6773:             cff1 = 1.0;
 6774:             cff2 = 1.0;
 6775:             cff3 = 0.0;
 6776: 
 6777:             if constexpr(iveg != 0) {
 6778:                // Computes coefficients used with vegetation terms G1, G2
 6779:                // cff1, cff3 are used for the first two terms in G1, G2:
 6780:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6781:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6782:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6783:                if(veg_h < 0.99*htot) { // submergent vegetation
 6784:                   cff1=1;
 6785:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6786:                   cff3 = veg_c;
 6787: 
 6788:                } else { // emergent vegetation
 6789:                   cff1 = 1.0/(1.0 + veg_c2);
 6790:                   cff2 = cff1;
 6791:                   cff3 = 0.0;
 6792: 
 6793:                }
 6794:             } // if iveg
 6795:          } //  2D/3D
 6796: 
 6797:          av_cff1 += cff1/i34;
 6798:          av_cff2 += cff2/i34;
 6799:          av_cff3 += cff3/i34;
 6800:          av_cff2_chi += cff2*chi/i34;
 6801:          av_cff3_chi += cff3*chi/i34;
 6802:          av_df += min(htot, veg_h)/(htot*i34);
 6803: 
 6804: 
 6805:          // btrack values: U^\star, U^{\star\alpha}
 6806:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6807:          Vector2 Ustar       = {0.0, 0.0}; 
 6808:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6809: 
 6810:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6811:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6812:          } else { //3D
 6813:             for (int k = side->kb; k < nvrt; k++) {
 6814:             
 6815:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6816:                Ustar += w2;
 6817: 
 6818:                if constexpr(iveg != 0) {
 6819:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6820:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6821:                        Ustar_alpha += zrat*w2; // XXXX
 6822:                    }
 6823:                }  // if iveg
 6824:             }  // for k
 6825:          }  //2D/3D
 6826:          
 6827: 
 6828:          // Add btrack & surface stress terms to \breve{G} first
 6829:          if constexpr(ics==1) {
 6830: 
 6831:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6832: 
 6833:          } else {
 6834:             // XXX IMPLEMENT THIS
 6835:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6836:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6837:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6838:          }  // if ics
 6839: 
 6840:          // Surface and bottom stress terms
 6841:          if constexpr(ics==1) {
 6842:             const Vector2 tau    = side->tau();
 6843:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6844: 
 6845:             // Term for surface and bottom stress
 6846:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6847: 
 6848:          } else {
 6849:             assert(false && "computeElemAverageGhat: Not implemented");
 6850:             // XXX IMPLEMENT THIS
 6851:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6852:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6853:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6854:             // tau_x=(vn1+tt1)/2.d0
 6855:             // tau_y=(vn2+ss1)/2.d0
 6856:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6857:          }  // if ics
 6858: 
 6859:          
 6860: 
 6861:          // All terms in F,F^\alpha,f_b except baroclinic
 6862:          // F, f_b: all explicit terms excluding vegetation 
 6863:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6864:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6865:          const double coriolis = side->coriolis;
 6866:          Vector2 F  =  coriolis*side->U;  // F_x
 6867:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6868:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6869: 
 6870:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6871:             
 6872:             for (int k = side->kb; k < nvrt; k++) {
 6873:                if (zctr2 > side->zc[k-1]) {
 6874:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6875:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6876:                    Fa +=  coriolis*w2*zrat;
 6877:                } // if zctr2
 6878:             } // k
 6879:          } // iveg
 6880: 
 6881:          // Integrate horizontal viscosity force vertically
 6882:          for (int k=side->kb + 1; k<nvrt; k++) {
 6883:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6884: 
 6885:             F += levelHorVisc;
 6886: 
 6887:             // Vegetation term
 6888:             if constexpr(iveg!=0) {
 6889:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6890:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6891:                   Fa += levelHorVisc*zrat;
 6892:                } 
 6893:             } // if iveg
 6894:          } // for k
 6895: 
 6896:          fb += side->nuGradU[side->kb];
 6897: 
 6898:          // Add to ghat1
 6899:          if constexpr(ics==2) {
 6900:             // XXX IMPLEMENT THIS
 6901:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6902:             // bigf1=vn1; bigf2=vn2
 6903:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6904:             // botf1=vn1; botf2=vn2
 6905:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6906:             // bigfa1=vn1; bigfa2=vn2
 6907:          } // if ics
 6908: 
 6909:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6910:       } // for j (nodes and sides)
 6911: 
 6912:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6913:          
 6914:       // Finish off terms in F, F^\alpha and f_b
 6915:       const double grav3 = elem->mean(&Node::grav2);
 6916:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6917: 
 6918: 
 6919:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6920:       for (int j=1; j<i34; j++) { 
 6921:          // For each side in the element...
 6922:          const Side *side = elem->sides[j];
 6923:          const double chi = side->chi;
 6924: 
 6925:          const double htot = side->htot2();
 6926:          const double veg_h = side->veg_h();
 6927:          const Vector2 F  = htot*fb;
 6928:          const Vector2 Fa = min(htot, veg_h)*fb;
 6929: 
 6930:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6931:       } // for j
 6932: 
 6933:       //botf1 etc are already in elem frame
 6934:       elem->ghat1 += tmp/i34;
 6935: 
 6936:       // Baroclinic force
 6937:       if constexpr(ibc==0) {
 6938:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6939: 
 6940:          Vector2 Fa = {0.0, 0.0};
 6941:          Vector2 intGradRho = {0.0, 0.0};
 6942:          
 6943:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6944:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6945:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6946: 
 6947:             // \in F [m^2/s/s]
 6948:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6949:          }
 6950: 
 6951:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6952:          const Vector2 F = av_df*Fa; //approx
 6953:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6954: 
 6955:       } // if ibc
 6956: 
 6957: 
 6958: 
 6959:    }
 6960: 
 6961: } // extern "C"
 6962: 
 6963: 
 6964: 
 6965: #ifdef DONTCOMPILE
 6966: __global__ void checkMassConservation(Tracers* sumtr) {
 6967: 
 6968:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6969: 
 6970:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6971: 
 6972:    Element *elem = &(mesh->localElemData[i]);
 6973: 
 6974:    // Skip dry elements
 6975:    if (elem->isDry) return;
 6976: 
 6977:    // Local sum array for this thread
 6978:    double localSum[N_TRACERS] = {0.0};
 6979: 
 6980:    // Sum over vertical levels for this element
 6981:    const int kbe = elem->kbe;
 6982:    const double area = elem->area;
 6983: 
 6984:    for (int k = kbe; k < nvrt; k++) {
 6985:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6986:       
 6987:       // Accumulate tracer mass
 6988:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6989:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6990:       }
 6991:    }
 6992: 
 6993:    
 6994: 
 6995:    //  This function returns per element sums. A reduction must be done on the host side.
 6996: }
 6997: 
 6998: 
 6999: __global__ void transport(void) {
 7000: 
 7001:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7002: 
 7003:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7004: 
 7005:    Element *elem = &(mesh->localElemData[ie]);
 7006: 
 7007:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7008: 
 7009:                for (int m=0; m<ntr; m++) {
 7010:                   for (int k=kbe(ie); k<nvrt; k++) {
 7011:                      // Calculate each polynomial's weight 
 7012:                      wm=0.d0; sum1=0.d0; 
 7013:                      wm1=0.d0; wm2=0.d0; 
 7014:                      for (int i=0; i<elem->nweno2; i++) {
 7015:                   
 7016:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7017:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7018:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7019:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7020:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7021:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7022:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7023:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7024:                      // -----------------Hu and Shu (1999)'s method----------------
 7025:                      b4=b1+b2+b3
 7026: 
 7027: //Error: add PRODUCTION CPP
 7028: #ifdef DEBUG
 7029:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7030:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7031:                     call parallel_abort(errmsg)
 7032:                   }
 7033: #endif
 7034: 
 7035:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7036:                   // !----test-------------- 
 7037:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7038:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7039:                   // !wm(i)=wm1(i)*wm2(i)
 7040:                   // !---------------------- 
 7041:                   sum1=sum1+wm(i)
 7042:                 } // end for i
 7043: 
 7044:                 wm=wm/sum1
 7045: 
 7046:                 for (int j=0; j<elem->i34; j++) {
 7047: 
 7048:                   const Side *side  = elem->sides[j];
 7049:                   const Node *node1 = side->n1;
 7050:                   const Node *node2 = side->n2;
 7051: 
 7052:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7053:                      trsd=0.d0
 7054:                      for (int kk=0; kk<nquad; kk++) {
 7055:                         for (int i=0; i<elem->nweno2; i++) {
 7056:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7057:                         } // end for i   
 7058:                      } // end for kk
 7059:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7060:                   } // outward flux
 7061:                } // end for j=1,i34(ie) ! side
 7062:             }
 7063:          }
 7064:               
 7065: 
 7066: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7067: //             //   calculate each polynomial's weight 
 7068: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7069: //                 wm=0.d0; sum1=0.d0
 7070: //                 do i=1,nweno1(ie) !for each polynomial
 7071: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7072: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7073: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7074: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7075: //                   wm(i)=b2
 7076: //                   sum1=sum1+b2
 7077: //                   !wm(i)=1.d0
 7078: //                   !sum1=sum1+1.d0
 7079: 
 7080: // // Error: PRODUCTION
 7081: // #ifdef DEBUG
 7082: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7083: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7084: //                     call parallel_abort(errmsg)
 7085: //                   endif
 7086: // #endif
 7087: 
 7088: //                 enddo !i
 7089: //                 wm=wm/sum1 !final weight
 7090: 
 7091:                 for (int j=0; j<elem->i34; j++) { // side
 7092:                   const Side *side = elem->sides[j];
 7093:                   const Node *node1 = side->n1;
 7094:                   const Node *node2 = side->n2;
 7095: 
 7096:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7097:                     trsd=0.d0
 7098:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7099:                       for (int i=0; i<elem->nweno1; i++) {
 7100:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7101:                       }
 7102:                     enddo //kk
 7103:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7104:                   } // outward flux
 7105:                 } // end for j=1,i34(ie) ! side
 7106:               } // end for k; ntr 
 7107: 
 7108:             else !simple upwind method
 7109:               do j=1,i34(ie)
 7110:                 jsj=elside(j,ie)
 7111:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7112:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7113:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7114:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7115:                   endif
 7116:                 enddo  !vertical layers
 7117:               enddo !j=1,i34(ie) ! side
 7118:             endif !order of accuracy
 7119: 
 7120:          //  enddo !ie
 7121: // !$OMP     end do
