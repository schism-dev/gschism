  654:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int) const;
  655: 
  656:    // ------------------------------------------------------------------------------------------------
  657:    // These are functions that work on all nodes of the element.
  658:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  659:    //
  660:    // An example of how to use these functions is:
  661:    //   
  662:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  663:    // 
  664:    // Where L is the level at which the field is to be interpolated. The field can be either
  665:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  666:    // There are different versions of getNodalValues for each of these cases.
  667: 
  668:    template<typename T>
  669:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  670:       // Get the values of the field at the nodes of the element
  671:       res[0] = nodes[0]->*field;
  672:       res[1] = nodes[1]->*field;
  673:       res[2] = nodes[2]->*field;
  674:       if (isQuad()) res[3] = nodes[3]->*field;
  675:       else          res[3] = T();
  676:    }
  677: 
  678:    template<typename T>
  679:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  680:       // Get the values of the field at the nodes of the element
  681:       res[0] = (nodes[0]->*field)[level];
  682:       res[1] = (nodes[1]->*field)[level];
  683:       res[2] = (nodes[2]->*field)[level];
  684:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  685:       else          res[3] = T();
  686:    }    
  687: 
  688:    template<typename T>
  689:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  690:       // Get the values of the func at the nodes of the element
  691:       res[0] = (nodes[0]->*func)(level);
  692:       res[1] = (nodes[1]->*func)(level);
  693:       res[2] = (nodes[2]->*func)(level);
  694:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  695:       else          res[3] = T();  // This is 0.0 or a zero vector
  696: 
  697:    }      
  698: 
  699:    template<typename T>
  700:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  701:       // Get the values of the field at the nodes of the element
  702:       res[0] = sides[0]->*field;
  703:       res[1] = sides[1]->*field;
  704:       res[2] = sides[2]->*field;
  705:       if (isQuad()) res[3] = sides[3]->*field;
  706:       else          res[3] = T();
  707:    }
  708: 
  709:    template<typename T>
  710:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  711:       // Get the values of the field at the nodes of the element
  712:       res[0] = (sides[0]->*field)[level];
  713:       res[1] = (sides[1]->*field)[level];
  714:       res[2] = (sides[2]->*field)[level];
  715:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  716:       else          res[3] = T();
  717:    }    
  718: 
  719:    template<typename T>
  720:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  721:       // Get the values of the func at the nodes of the element
  722:       res[0] = (sides[0]->*func)(level);
  723:       res[1] = (sides[1]->*func)(level);
  724:       res[2] = (sides[2]->*func)(level);
  725:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  726:       else          res[3] = T();  // This is 0.0 or a zero vector
  727: 
  728:    }      
  729: 
  730: 
  731:    __device__ double interpolate(int level, const double shapeCoords[4], double (Node::*func)(int) const) const {
  732:       double values[4];
  733:       getNodalValues(level, func, values);
  734: 
  735:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  736:    }
  737: 
  738:    template<typename T>
  739:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  740:       T values[4];
  741:       getNodalValues(field, values);
  742:       
  743:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  744:    }
  745: 
  746: 
  747:    template<typename T>
  748:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  749:       T values[4];
  750:       getNodalValues(level, field, values);
  751: 
  752:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  753:    }
  754: 
  755:    template<typename T>
  756:    __device__ T mean(T Node::* field) const {
  757:       T values[4];
  758:       getNodalValues(field, values);
  759: 
  760:       return (values[0] + values[1] + values[2] + values[3])/i34;
  761:    }
  762: 
  763:    template<typename T>
  764:    __device__ T mean(T Side::* field) const {
  765:       T values[4];
  766:       getSideValues(field, values);
  767:       
  768:       return (values[0] + values[1] + values[2] + values[3])/i34;
  769:    }   
  770: 
  771:    template<typename T>
  772:    __device__ T mean(int level, T (Node::* field)[nvrt]) const {
  773:       T values[4];
  774:       getNodalValues(level, field, values);
  775: 
  776:       return (values[0] + values[1] + values[2] + values[3])/i34;
  777:    }
  778: 
  779:    template<typename T>
  780:    __device__ T mean(int level, T (Side::* field)[nvrt]) const {
  781:       T values[4];
  782:       getSideValues(level, field, values);
  783:       
  784:       return (values[0] + values[1] + values[2] + values[3])/i34;
  785:    }   
  786: 
