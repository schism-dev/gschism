  950: // This struct is used to store the boundary information for a node.
  951: struct NodeBoundary {   
  952:    BoundarySegment *segment;
  953:    Node *node;
  954:    
  955:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
  956:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
  957: 
  958:    double etaic;  // Elevation at nodes used for essential boundary conditions
  959:    double elbc;   // Elevation boundary condition
  960:    int iettype;   // Type of elevation boundary condition
  961:    double eth;    // Elevation time history
  962: 
  963:    bool isEssentialBC;
  964: 
  965: 
  966:    // Arrays for harmonic constituents (if needed)
  967:    double emo[nbfr];  // Elevation amplitude
  968:    double efa[nbfr];  // Elevation phase
  969:    double umo[nbfr];  // U-velocity amplitude
  970:    double ufa[nbfr];  // U-velocity phase
  971:    double vmo[nbfr];  // V-velocity amplitude
  972:    double vfa[nbfr];  // V-velocity phase 
  973: 
  974:    
  975:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
  976:       assert(index == 0 || index == 1); 
  977:       return (index == 0) ? sideBnd1 : sideBnd2; 
  978:    }
  979: 
  980: 
  981: };
