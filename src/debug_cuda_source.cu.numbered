 7996: __global__ void returnMatrix(double *res) {
 7997:    // Debugging: returns the matrix as a CuPy array
 7998: 
 7999:    const int size = mesh->np;
 8000:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8001:       const Node *node = mesh->localNodeData + idx_node;
 8002:       res[idx_node*size + idx_node] = node->coeffDiag;
 8003:       for (int j = 0; j < node->numNodes; j++) {
 8004:          Node* nbNode = node->nodes[j];
 8005:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 8006:       }
 8007: 
 8008:    }
 8009:    
 8010: }
