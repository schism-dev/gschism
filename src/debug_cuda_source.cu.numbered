 1466: 
 1467: // Helper functions for computing the local node index at a given offset from another.
 1468: __device__ __inline__ int nxq(int offset, int index, int size) {
 1469:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1470:    // to the index to make it positive
 1471:    assert(index + offset + 16*size >= 0);
 1472:    return (index + offset + 16*size) % size;  
 1473: }
 1474: 
 1475: __device__ __inline__ int nxq(int index, int size) {
 1476:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1477:    // to the index to make it positive
 1478:    assert(index + 16*size >= 0);
 1479:    return (index + 16*size) % size; 
 1480: }
