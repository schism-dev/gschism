 3717: 
 3718: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3719: 
 3720: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3721: 
 3722:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3723:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3724: 
 3725: 
 3726: 
 3727:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3728:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3729: 
 3730:    double fun_lat = 0.0;
 3731:    switch (jspc[idxComp]) {
 3732:       case 0:
 3733:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3734:          break;
 3735:       case 1:
 3736:          fun_lat = sin(2.0*lat);
 3737:          break;
 3738:       case 2:
 3739:          fun_lat = pow<2>(cos(lat));
 3740:          break;
 3741:       default:
 3742:          assert(false && "computeETP: invalid jspc");
 3743:    }
 3744:    
 3745:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3746: 
 3747: }
 3748: 
