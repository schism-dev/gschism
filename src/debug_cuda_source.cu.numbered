 9530:          break;
 9531:       case (int)VarCode::x:
 9532:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 9533:          *sizeType = sizeof(Vector2);
 9534:          break;
 9535:       case (int)VarCode::z:
 9536:          *offset = (int)((char*)&nodes[0].z - (char*)nodes);
 9537:          *sizeType = sizeof(double);
 9538:          break;
 9539:       case (int)VarCode::kb:
 9540:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 9541:          *sizeType = sizeof(int);
 9542:          break;
 9543:       case (int)VarCode::isdry:
 9544:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 9545:          *sizeType = sizeof(int);
 9546:          break;         
 9547:       case (int)VarCode::w:
 9548:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 9549:          *sizeType = sizeof(double);
 9550:          break;
 9551:       case (int)VarCode::u:
 9552:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 9553:          *sizeType = sizeof(Vector2);
 9554:          break;  
