 1260: 
 1261:    __device__ __forceinline__ Vector2 grad2(double *a) const
 1262:    {
 1263:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
 1264:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
 1265:       if (isQuad()) {
 1266:          gx += a[3]*gradPhi[3].x;
 1267:          gy += a[3]*gradPhi[3].y;
 1268:       }
 1269:       return {gx, gy};
 1270:    }
 1271: 
 1272:    __device__ __forceinline__ Vector2 grad2(double Node::* field) const
 1273:    {
 1274:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
 1275:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
 1276:       if (isQuad()) {
 1277:          gx += (nodes[3]->*field)*gradPhi[3].x;
 1278:          gy += (nodes[3]->*field)*gradPhi[3].y;
 1279:       }
 1280:       return {gx, gy};
 1281:    }
 1282: 
 1283:    __device__ __forceinline__ Vector3 n(int k, double &area3D) const;
 1284:    __device__ __forceinline__ Vector3 n(int k) const {
 1285:       double area3D;
 1286:       return n(k, area3D);
 1287:     }
