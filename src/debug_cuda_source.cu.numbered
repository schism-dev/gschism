 2711: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2712: 
 2713: 
 2714: __device__ void Node::updateKb(void) {
 2715: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2716: 
 2717:    if constexpr(ivcor == 1) return;
 2718: 
 2719:    if (isDry2()) return;
 2720: 
 2721:    if constexpr(ivcor == 2) {  // SZ coordinates
 2722:       
 2723:       // Compute bottom level index
 2724:       if (depth <= mesh->h_s) {
 2725:          kb = nzlev;
 2726:       } else {
 2727:          kb = -1;
 2728:          int L = 0;
 2729:          int R = nzlev; 
 2730:          
 2731:          while (L <= R) {
 2732:             int M = (R + L) / 2;
 2733: 
 2734: // printf("L = %d, R = %d, M = %d, depth = %f, ztot[L] = %f, ztot[R] = %f, ztot[M] = %f\n", L, R, M, depth, mesh->ztot[L], mesh->ztot[R], mesh->ztot[M]);
 2735:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2736:             
 2737:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2738:                R = M;
 2739:             } else {
 2740:                L = M;
 2741:             }
 2742: 
 2743:             if (R - L == 1) {
 2744:                kb = L;
 2745:                break;
 2746:             }
 2747:          }
 2748:       }
 2749:    } 
 2750: }
 2751: 
 2752: 
 2753: __device__ __inline__ void Node::updateZCoordData(void) {
 2754: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2755: 
 2756:    if (isDry2()) return;
 2757: 
 2758:    if constexpr(ivcor == 2) {  // SZ coordinates
 2759:       
 2760:       // Compute bottom level index
 2761:       if (depth <= mesh->h_s) {
 2762:             kb = nzlev - 1;
 2763:       } else {
 2764:          kb = -1;
 2765:          for (int i = 0; i < nzlev; i++) {
 2766:             // XXX Use binary search
 2767:             if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 2768:                kb = i;
 2769:                break;
 2770:             }
 2771:          }
 2772:       }
 2773:    } 
 2774:    else if (ivcor == 1) {  // Localized sigma
 2775:       // Do nothing
 2776:    }
 2777: 
 2778: }
 2779: 
 2780: __device__ double Node::compZCoord(int k) const {
 2781:    // Computes the z coordinate at level k.
 2782:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2783:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2784:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2785:    // used 
 2786:    
 2787:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2788: 
 2789:   
 2790:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2791: 
 2792:    if constexpr(ivcor == 2) {
 2793: 
 2794:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2795:       const double h_c = mesh->h_c;
 2796:       const double theta_f = mesh->theta_f;
 2797:       const double sinh_theta_f = mesh->sinh_theta_f;
 2798: 
 2799:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2800:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2801:       // once per time step/node.
 2802:       // CHECK: updateZCoordData
 2803: 
 2804:       //  To simplify comparisons, I define index versions of count variables.
 2805:       if      (k == ivrt)           return eta2; 
 2806:       else if (k == izlev)          return -hmod2;
 2807:       else if (k == kb)             return -depth;
 2808:       else if (k < izlev && k >= 0) return mesh->ztot[k];
 2809:       else if (k > izlev) {
 2810:          const int ksig = k - izlev;
 2811: 
 2812:          if (hmod2 <= h_c) {
 2813: // printf("mesh->sigma[ksig] * (hmod2 + eta2) + eta2 = %e\n", mesh->sigma[ksig] * (hmod2 + eta2) + eta2);            
 2814:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2815:          } 
 2816:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2817:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2818:             assert(false && "ZCOOR: invalid h_c\n");
 2819:          } 
 2820:          else {
 2821: // printf("eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig] = %e\n", eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig]);
 2822:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2823:                          h_c * mesh->sigma[ksig] + 
 2824:                          (hmod2 - h_c) * mesh->cs[ksig];
 2825:          }
 2826:       } else { 
 2827:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2828:       }
 2829: 
 2830:    }
 2831:    else if constexpr(ivcor == 1) {
 2832:       if (k == kb) return -depth;
 2833:       else if (k == nvrt-1) return eta2;
 2834:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2835:    }
 2836:    
 2837:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2838:    return 0.0;
 2839: }
 2840: 
 2841: 
 2842: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2843:    // Checks if a side in on the boundary
 2844:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2845: 
 2846:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2847:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2848: 
 2849:    // Indices of the nodes that form the side
 2850:    const int n1 = side.n1->idx;
 2851:    const int n2 = side.n2->idx;
 2852: 
 2853:    // Check if the side is on a land boundary
 2854:    for (int i = 0; i < nland; i++) {
 2855:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2856:          // Consecutive nodes in the land boundary segment
 2857:          const int b1 = ilnd[i*mnlnd + j];
 2858:          const int b2 = ilnd[i*mnlnd + j + 1];
 2859: 
 2860:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2861:             isLand = true;
 2862:             return i;
 2863:          }
 2864:       }
 2865:    }
 2866: 
 2867:    // Check if the side is on an open boundary
 2868:    for (int i = 0; i < nope; i++) {
 2869:       for (int j = 0; j < nond[i] - 1; j++) {
 2870:          // Consecutive nodes in the open boundary segment
 2871:          const int b1 = iond[i*mnond + j];
 2872:          const int b2 = iond[i*mnond + j + 1];
 2873: 
 2874:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2875:             isLand = false;
 2876:             return i;
 2877:          }
 2878:       }
 2879:    }
 2880:    return -1;
 2881: }
 2882: 
 2883: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2884:                 double *node_coords, double *node_coords_ll, bool use_ll,
 2885:                 double *wind_rotate_angle, 
 2886:                 int *isdel, int *isidenode, int *isbnd,
 2887:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 2888:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2889:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2890:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2891:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2892:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 2893:                 double *drag, double *roughness,
 2894:                 double *emo, double *efa, 
 2895:                 double *umo, double *ufa, 
 2896:                 double *vmo, double *vfa) {
 2897: 
 2898:    printf("Populating mesh for partition %d\n", partNum);
 2899: 
 2900:    // Horizontal grid
 2901:    printf("Processing %d nodes\n", np);   
 2902: 
 2903:    
 2904:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 2905:    const double fc   = 2.0*omega_e*sin(sfea0);
 2906:    const double beta = 2.0*omega_e*cos(sfea0);
 2907: 
 2908: 
 2909:    int idxNodeBoundary = 0;  
 2910:    for (int i = 0; i < np; i++)
 2911:    {
 2912: printf("NODE i = %d, np = %d\n", i, np);      
 2913:       Node &node = localNodeData[i];
 2914: 
 2915:       node.idx = i;
 2916: 
 2917:       const int idxNodeStart = nodeNeighNodesStart[i];
 2918:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2919:       node.numNodes = idxNodeEnd - idxNodeStart;
 2920:       node.nodes = nodeNeighNodes + idxNodeStart;
 2921:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2922: 
 2923: 
 2924: 
 2925:       const int idxElemStart = nodeNeighElemsStart[i];
 2926:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2927:       node.numElements = idxElemEnd - idxElemStart;
 2928:       node.elements = nodeNeighElems + idxElemStart;
 2929: 
 2930: 
 2931:       
 2932:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2933:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2934:          const int partNode = localNodePart[idxNodeGlobal]; 
 2935:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2936: 
 2937: 
 2938:          Node *node_ptr = nodes[partNode] + idxNode;
 2939:          
 2940:          nodeNeighNodes[idx] = node_ptr;
 2941:       }
 2942: 
 2943:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2944:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2945:          const int partElem = localElemPart[idxElemGlobal];
 2946:          const int idxElem  = localElemIndices[idxElemGlobal];
 2947: 
 2948:          Element *elem_ptr = elems[partElem] + idxElem;
 2949: 
 2950:          nodeNeighElems[idx] = elem_ptr;
 2951:       }      
 2952: 
 2953: 
 2954:       node.wind_angle = wind_rotate_angle[i];
 2955: 
 2956:       // Element **elements; // pointer to the elements connected to this node
 2957:       // int numElements;   // number of elements shared by this node
 2958: 
 2959:       node.p.x   = node_coords[i * 3];
 2960:       node.p.y   = node_coords[i * 3 + 1];
 2961:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2962:       node.depth = node_coords[i * 3 + 2];
 2963: 
 2964:       node.numSides = 0;
 2965: 
 2966:       node.Cd = drag[i];
 2967:       node.rough = roughness[i];
 2968: printf("NODE idx = %d, Cd = %.16f, rough = %.16f\n", i, node.Cd, node.rough);
 2969:       for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 2970: 
 2971:       // Links the node to the boundary information
 2972:       if (isbnd[i] >= 0) {
 2973:        
 2974:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2975:          node.nodeBnd->node = &node;
 2976: 
 2977:          node.nodeBnd->sideBnd1 = nullptr;
 2978:          node.nodeBnd->sideBnd2 = nullptr;
 2979: 
 2980:          if (isbnd[i]>=0) {
 2981: 
 2982:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2983:             
 2984:             node.nodeBnd->segment->ifltype = (isbnd[i]==0)?3:0;
 2985:             node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 2986: 
 2987:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2988:             node.nodeBnd->segment->clen  = nan("1");
 2989:             node.nodeBnd->segment->carea = nan("1");
 2990: 
 2991:          }
 2992: //          else {  XXXXXX
 2993: //             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2994: // printf("EEEEEPP isbnd[i] = %d, node.nodeBnd->segment = %p\n", isbnd[i], node.nodeBnd->segment);            
 2995: //          }
 2996:          
 2997:          idxNodeBoundary++;
 2998:       }
 2999:       else {
 3000:          node.nodeBnd = nullptr; // For internal nodes
 3001: 
 3002:          if (isbnd[i] == landSegment) {
 3003:             node.nodeBnd = &landBoundaryNode;
 3004:             node.nodeBnd->segment = &landBoundarySegment;
 3005:          }
 3006:          // node.nodeBnd->node = &node;
 3007:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3008:          // // node.nodeBnd = nullptr;
 3009:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3010:         
 3011:       }
 3012: 
 3013:       // XXXX GAUSSIAN HILL VELOCITIES
 3014: #ifdef GAUSSIAN_HILL_VELOCITIES
 3015:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3016:          constexpr double rot_per = 3000.0;
 3017:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3018:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0}; }
 3019:       // XXXXX
 3020: #endif
 3021:    }
 3022: 
 3023:    nbp = idxNodeBoundary;
 3024: 
 3025:    printf("Processing %d sides\n", ns);
 3026:    int idxSideBoundary = 0;
 3027:    for (int i = 0; i < ns; i++)
 3028:    {
 3029: if (i%1000 == 0) printf("SIDE i = %d, ns = %d\n", i, ns);      
 3030:       Side &side = localSideData[i];
 3031:       side.idx = i;
 3032:       // finding the pointer to the nodes that form the side
 3033:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3034:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3035: 
 3036:       const int locidx_n1 = localNodeIndices[idx_n1];
 3037:       const int locidx_n2 = localNodeIndices[idx_n2];
 3038:       const int part_n1 =   localNodePart[idx_n1];
 3039:       const int part_n2 =   localNodePart[idx_n2];
 3040: 
 3041:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3042:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3043: 
 3044:       // Counts the number of sides connected to each node
 3045:       side.n1->numSides++;
 3046:       side.n2->numSides++;
 3047: 
 3048:       // Normal, unitary vector to the side
 3049:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3050:       side.n = normalize(side.n);
 3051: 
 3052:       // Side boundary type
 3053:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 3054:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 3055: 
 3056:       if (n1bnd != nullptr && n2bnd != nullptr) 
 3057:       // If both nodes are on the boundary, then the side may be on the boundary
 3058:       {
 3059:          bool isLand = false;
 3060:          int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3061: 
 3062:          if (isbs > -1) {
 3063:             side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3064:             if      ( isLand) side.sideBnd->segment = &landBoundarySegment;
 3065:             else if (!isLand) side.sideBnd->segment = &(localSegmentMem[isbs]);
 3066: 
 3067:             // Links each node boundary to the side boundary using the first available side boundary pointer
 3068:             if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3069:             else                            n1bnd->sideBnd2 = side.sideBnd;
 3070: 
 3071:             if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3072:             else                            n2bnd->sideBnd2 = side.sideBnd;
 3073:           
 3074:             side.sideBnd->side = &side;
 3075:             idxSideBoundary++;
 3076: 
 3077:          }
 3078:          
 3079: 
 3080:       // }
 3081:       // 
 3082: 
 3083: 
 3084: 
 3085: 
 3086: //       // XXXX YYYY NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 3087: // printf("Here2: %d, idxSideBoundary = %d, side.n1->idx = %d, side.n2->idx = %d\n", i, idxSideBoundary, side.n1->idx, side.n2->idx);      
 3088: //       if (n1bnd != nullptr || n2bnd != nullptr) 
 3089: //       {
 3090: // printf("Here2.5: %d, idxSideBoundary = %d\n", i, idxSideBoundary);           
 3091: //          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3092: // printf("Here2.6: %d, side.sideBnd = %p, n1bnd = %p, n2bnd = %p\n", i, side.sideBnd, n1bnd, n2bnd);           
 3093: // // printf("Here2.7: %d, side.sideBnd->segment = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", i, side.sideBnd->segment, n1bnd->segment, n2bnd->segment);      
 3094: // if (side.sideBnd->segment == nullptr) continue;
 3095: //          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 3096: //          else                  side.sideBnd->segment = n2bnd->segment;
 3097: //          side.sideBnd->side = &side;
 3098: //          idxSideBoundary++;
 3099: // printf("EERRREEEE side.sideBnd = %p, n1bnd = %p, n2bnd = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", side.sideBnd, n1bnd, n2bnd, n1bnd->segment, n2bnd->segment);
 3100:       }
 3101:       else side.sideBnd = nullptr;
 3102: 
 3103:       nbs = idxSideBoundary;
 3104: 
 3105:       // finding the pointer to the elements that share the side
 3106:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 3107:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3108: 
 3109:       if (idx_e1 > -1) {
 3110:          const int locidx_e1 = localElemIndices[idx_e1];
 3111:          const int part_e1 =  localElemPart[idx_e1];
 3112:          side.elems[0] = elems[part_e1] + locidx_e1;
 3113: 
 3114:       }
 3115:       else {
 3116:          side.elems[0] = nullptr;
 3117:       }
 3118: 
 3119:       if (idx_e2 > -1) {
 3120:          const int locidx_e2 = localElemIndices[idx_e2];
 3121:          const int part_e2 =  localElemPart[idx_e2];
 3122:          side.elems[1] = elems[part_e2] + locidx_e2;
 3123:       }
 3124:       else {
 3125:          side.elems[1] = nullptr;
 3126:       }
 3127: 
 3128:       // Compute the center of the side
 3129:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 3130: 
 3131:       assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3132:       side.shapiro = shapiro0;
 3133: 
 3134: #ifdef GAUSSIAN_HILL_VELOCITIES
 3135: // XXXX
 3136: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3137: constexpr double rot_per=3000.0;
 3138: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3139: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3140: // XXXXX      
 3141: #endif
 3142:       // Compute the z level at the center of the side
 3143:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3144: 
 3145:       // Compute the length of the side
 3146:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 3147:       side.len = sqrt(dot(vLen, vLen));
 3148: 
 3149: 
 3150:       // Compute the Coriolis coefficient
 3151: 
 3152:       if constexpr(ncor == -1 || ncor == 0) {
 3153:          side.coriolis = coricoef;
 3154:       }
 3155:       else {
 3156:          const double sphi = side.lat();  // Latitude at the center of the side
 3157: 
 3158:          if constexpr(ics == 1) {
 3159:             side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3160:          }
 3161:          else {
 3162:             side.coriolis = 2.0*omega_e*sin(sphi);
 3163:          }
 3164:       }
 3165: 
 3166: 
 3167:    }
 3168: 
 3169:    printf("Processing %d elements\n", ne);
 3170:    for (int i = 0; i < ne; i++)
 3171:    {
 3172: printf("ELEMENT i = %d, ne = %d\n", i, ne);      
 3173:       Element &elem = localElemData[i];
 3174:       elem.idx = i;
 3175:       for (int j = 0; j < i34[i]; j++) {
 3176:          const int idxNode = elnode[i*4 + j];  
 3177:          const int idxSide = elside[i*4 + j];
 3178:          
 3179:          elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3180:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3181: 
 3182: 
 3183: 
 3184:          // Find the neighboring element  
 3185:          if (elem.sides[j]->elems[0] == &elem) {
 3186:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 3187:          }
 3188:          else {
 3189:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 3190:          }
 3191:          
 3192:       }
 3193: 
 3194:       elem.i34 = i34[i];
 3195: 
 3196:       // Compute the centroid of the element and its depth
 3197:       Vector2 center = {0.0, 0.0};
 3198:       elem.depth = 0.0;
 3199:       for (int j = 0; j < i34[i]; j++) {
 3200:          center += elem.nodes[j]->p2()/i34[i];
 3201:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 3202:       }
 3203:       elem.center.x = center.x;
 3204:       elem.center.y = center.y;
 3205: 
 3206: 
 3207:       
 3208:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3209:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3210: 
 3211:       elem.area = elem.computeSignedArea(); 
 3212:       elem.radius = sqrt(elem.area)/pi; 
 3213:       
 3214:       // Determines which way the normal vector to each side is oriented.
 3215:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3216:       for (int j = 0; j < i34[i]; j++)  
 3217:       {
 3218:          if (elem.sides[j]->elems[0] == &elem) {
 3219:             elem.ssign[j] =  1.0;
 3220:          }
 3221:          else {
 3222:             elem.ssign[j] = -1.0;
 3223:          }
 3224: 
 3225:       }
 3226: 
 3227:       // Derivatives of shape functions
 3228:       //  For ics=2, this is done inside element/ll frame XXX
 3229:       //  For quads, the derivative is evaluated at centroid
 3230:       const int i34 = elem.i34;
 3231:       for (int j = 0; j < i34; j++) {
 3232:          const double area = elem.area;
 3233:          const int id2 = elem.nxq(1 + j);
 3234:          const int id3 = elem.nxq(2 + j);
 3235:          const int id4 = elem.nxq(3 + j);
 3236:          if (elem.isTri()) {
 3237:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3238:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3239:             // da1/dx = (y1 - y2)/(2*area)
 3240:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3241:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3242:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3243:          }
 3244:          else  { // Quad; evaluate at centroid
 3245:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3246:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3247:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3248:          } // if Tri
 3249: 
 3250:       } // for j
 3251: 
 3252:    }
 3253: 
 3254: 
 3255:    // Processing the boundary nodes
 3256:    int idx = 0;
 3257:    for (int iseg = 0; iseg < nope; iseg++) {
 3258:       // for each segment...
 3259:       
 3260:       for (int ind = 0; ind < nlnd[iseg]; ind++) {
 3261:          // for each node on the segment...
 3262: 
 3263:          NodeBoundary *nodeBnd = &localNodeBoundaryMem[idx];
 3264: 
 3265:          nodeBnd->isEssentialBC = true;
 3266:          nodeBnd->elbc = 0.0;
 3267: 
 3268:          for (int jfr = 0; jfr < nbfr; jfr++) {
 3269: 
 3270:             const int idx = iseg*mnond*nbfr + ind*nbfr + jfr;
 3271:             nodeBnd->efa[jfr] = efa[idx];
 3272:             nodeBnd->emo[jfr] = emo[idx];
 3273:             nodeBnd->umo[jfr] = {umo[idx], vmo[idx]};
 3274:             nodeBnd->ufa[jfr] = {ufa[idx], vfa[idx]};
 3275: 
 3276:          }
 3277: 
 3278:          idx++;
 3279:       }
 3280: 
 3281:    }
 3282: 
 3283: }
