 6209:    //            if(icount2>nnode_fl) call parallel_abort('STEP: wrong counting vel')
 6210: 
 6211:    //            uthnd(1:nvrt,j,k)=(1.d0-rat)*ath2(1,1:nvrt,icount2,1,2)+rat*ath2(1,1:nvrt,icount2,2,2) !ll frame if ics=2
 6212:    //            vthnd(1:nvrt,j,k)=(1.d0-rat)*ath2(2,1:nvrt,icount2,1,2)+rat*ath2(2,1:nvrt,icount2,2,2)
 6213:    //          enddo !j
 6214:    //        endif
 6215:    //      enddo !k
 6216:    //    endif !nfltype2
 6217:    }
 6218: 
 6219:    __global__ void resetBoundaryAreas(void) {
 6220:       // Reset boundary areas and lengths for each segment.
 6221: 
 6222:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 6223:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 6224:       SIDE_BND(sideBnd);
 6225: 
 6226:       BoundarySegment *segment = sideBnd->segment;
 6227: 
 6228:       segment->carea = 0.0;
 6229:       segment->clen = 0.0;
 6230:  
 6231:    }
 6232: 
 6233:    __global__ void computeBoundaryAreas(void) {
 6234:    // Calculation of cross-section areas and lengths for flow b.c.
 6235: 
 6236:       SIDE_BND(sideBnd);
 6237: 
 6238:       const Side *side = sideBnd->side;
 6239:       BoundarySegment *segment = sideBnd->segment;
 6240: 
 6241:       if (segment->ifltype != 0) {
 6242: 
 6243:          const Node *n1 = side->n1;
 6244:          const Node *n2 = side->n2;
 6245: 
 6246:          const double htot = side->htot2();
 6247: 
 6248:          if (!side->isDry) {
 6249:             atomicAdd(&segment->carea, htot*side->len);
 6250:             atomicAdd(&segment->clen, side->len);
 6251:          }
 6252:       }
 6253: 
 6254:    }
 6255: 
 6256: 
 6257:    __global__ void computeFlowBcVelocities(double time) {
 6258: 
 6259:       SIDE_BND(sideBnd);
 6260: 
 6261:       const Side *side = sideBnd->side;
 6262:  
 6263:       const bool isDry = side->isDry;
 6264:       const bool isLand = sideBnd->segment->isLand;
 6265: 
 6266:    
 6267:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 6268: 
 6269:       if (isDry || isLand) return;
 6270: 
 6271:       // For wet sides in open boundaries...
 6272:       const Vector2 n = side->n;
 6273:       const BoundarySegment *segment = sideBnd->segment;
 6274: 
 6275:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 6276: 
 6277:       const int ifltype = segment->ifltype;
 6278: 
 6279:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 6280:       const Vector2 r_nuth0 = r_uth0*n;
 6281: 
 6282: 
 6283:       if (ifltype == 1 || ifltype == 2) {
 6284:       
 6285:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 6286: 
 6287:          const double unth0 = segment->qthcon*ramp/segment->carea;
 6288:          
 6289:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 6290:          
 6291:       } else if (ifltype == -1) { // Flather 1
 6292: 
 6293:          for (int k = 0; k < nvrt; k++) {
 6294: 
 6295:             // uth is the normal vel.; no ramp up
 6296:             const double uth = sideBnd->nuth(k);
 6297:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 6298: 
 6299:             sideBnd->ubc[k] += uth*n;
 6300:          }
 6301: 
 6302:       } else if (ifltype == 3 || ifltype == 5) {
 6303:          // vnth0=0 !normal vel.
 6304: 
 6305:          Vector2 r_u1_bar = {0.0, 0.0};
 6306:          // Computes the contribution to the velocity from all tide frequencies
 6307:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 6308: 
 6309:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 6310:             const Vector2 umo  = sideBnd->umo(jfr); 
 6311: 
 6312:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 6313:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 6314:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 6315:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 6316: 
 6317:          }
 6318: 
 6319: 
 6320:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 6321: 
 6322:       } // if (ifltype = 3 || ifltype == 5
 6323: 
 6324: 
 6325: 
 6326:    }
 6327: 
 6328:    __global__ void computeElevationBoundaryConditions(double time) {
 6329:       // Compute elevation essential boundary conditions 
 6330: 
 6331:       NODE_BND(nodeBnd); // Each boundary node.
 6332: 
 6333:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 6334: 
 6335:       const Node *node = nodeBnd->node;
 6336:       const BoundarySegment *segment = nodeBnd->segment;
 6337:       const int iettype = segment->iettype;
 6338:       
 6339: 
 6340:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 6341:       double eic = 0.0;
 6342:       if (nramp_elev == 1) eic = nodeBnd->etaic;  // XXXX is etaic ever set?  
 6343:       else                 eic = 0.0;
 6344: 
 6345:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 6346:       const double r_eth = ramp*nodeBnd->eth;
 6347:       double r_eta1_bar = 0.0;
 6348: 
 6349:       // Compute tide elevation
 6350:       if (iettype == 3 || iettype == 5) {   
 6351: 
 6352:          if constexpr(iloadtide==1) { // loading tide
 6353:             assert(false && "Loading tide not implemented");
 6354:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 6355:          }
 6356:          
 6357:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 6358: 
 6359:             const double efa  = nodeBnd->efa[jfr]; 
 6360:             const double emo  = nodeBnd->emo[jfr]; 
 6361: 
 6362:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 6363:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 6364:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 6365: 
 6366: 
 6367:          } // for jfr
 6368: 
 6369:       } // if iettype
 6370: 
 6371:       switch (iettype) {
 6372:          case 1:
 6373:          case 2:
 6374:          case 4:
 6375:             nodeBnd->elbc = r_eic + r_eth;
 6376:             break;
 6377:          case 3:
 6378:             nodeBnd->elbc = r_eic + r_eta1_bar;
 6379:             break;
 6380:          case 5:
 6381:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 6382:             break;
 6383:       } // switch
 6384: 
 6385: 
 6386:       //Add inverse barometric effects
 6387:       if (iettype != 0 && inv_atm_bnd == 1) {
 6388:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 6389:       }
 6390: 
 6391:    }
 6392: 
 6393: 
 6394:    __global__ void computeHorizontalViscosity(void) { 
 6395: 
 6396:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 6397: 
 6398:       SIDE(side);
 6399: 
 6400:       if (side->isDry) return;
 6401: 
 6402:       for (int k = 0; k < nvrt; k++) {
 6403:          side->nuGradU[k] = {0.0, 0.0};
 6404:       }
 6405: 
 6406:       if constexpr(ihorcon == 1) {
 6407:          for (int k = side->kb; k < nvrt - 1; k++) {
 6408:             // Computes the Laplacian by using the simplified formula presented in the paper:
 6409:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 6410:             // By Zhang and Baptista.
 6411: 
 6412:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 6413:             // This is a standard discretization of the Laplacian operator.
 6414:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 6415:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 6416:             // Gamma is hvis_coef0 in the code.
 6417:             // The value of gamma needs to be < 0.5.
 6418: 
 6419:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 6420:             // side under consideration in each of the two possible elements that share the side.
 6421:             Vector2 sumU = {0.0, 0.0};
 6422:             for (int l = 0; l < 2; l++) {
 6423:                const Element *elem = side->elems[l];
 6424: 
 6425:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 6426: 
 6427:                // Find the local index of the side in the element
 6428:                const int idxSide = elem->sideLocalIdx(side);
 6429: 
 6430:                // Find the two sides that are connected to the side under consideration
 6431:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 6432:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 6433: 
 6434:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 6435: 
 6436:             }
 6437: 
 6438:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 6439: 
 6440:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 6441:    
 6442:          }
 6443:       }
 6444:       else if constexpr(ihorcon == 2) {
 6445:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 6446:       }
 6447: 
 6448: 
 6449:    }
 6450: 
 6451: 
 6452:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 6453: 
 6454:       // Set essential boundary conditions 
 6455:       NODE(node); // Each boundary node
 6456:       NodeBoundary *nodeBnd = node->nodeBnd;
 6457:       
 6458:  
 6459:       // Check if this node has essential BC
 6460:       if (nodeBnd && nodeBnd->isEssentialBC) {
 6461: 
 6462:          // Verify BC value is valid
 6463:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 6464: 
 6465:        
 6466:          // Set diagonal to 1 and zero off-diagonals
 6467:          for (int j = 0; j <= node->numNodes; j++) {
 6468:                node->coeffRow[j] = 0.0;
 6469:          }
 6470: 
 6471:          *(node->coeffDiag) = 1.0;
 6472: 
 6473: 
 6474:          // Set solution and RHS to BC value
 6475:          node->mX  = nodeBnd->elbc;
 6476:          node->qel = nodeBnd->elbc;
 6477: 
 6478:       } else {
 6479:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 6480: 
 6481:          for (int j = 0; j < node->numNodes; j++) {
 6482:                const Node* nbNode = node->nodes[j];
 6483:    	         assert(nbNode != nullptr && "setEssentialBC: nbNode is nullptr");
 6484: 
 6485:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 6486:                assert(nbNodeBnd != nullptr && "setEssentialBC: nbNodeBnd is nullptr");
 6487: 
 6488:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 6489:                   // Verify neighbor's BC value
 6490:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 6491: 
 6492:                   // Subtract contribution to RHS
 6493:                   node->qel -= node->coeffRow[node->csrSlot[j]]*nbNodeBnd->elbc;
 6494:                   node->coeffRow[node->csrSlot[j]] = 0.0;  
 6495:                }
 6496:          }
 6497: // printf("setEssentialBC: node->qel = nodeBnd->elbc - node->coeffMatrix[j]*nbNodeBnd->elbc\n");
 6498:       }
 6499:    }
 6500: 
 6501: 
 6502:    __global__ void updateElevation(void) {
