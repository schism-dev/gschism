 6849: 
 6850: __global__ void computeMatrixProductAndDotProducts() {
 6851:    // Computes A*p, r'Mr and p'Ap
 6852: 
 6853:    // 1) shared buffer: first half for rMr, second for pAp
 6854:    __shared__ double sdata[2*BLOCK_SIZE];
 6855:    double* s_rMr = sdata;
 6856:    double* s_pAp = sdata + BLOCK_SIZE;
 6857: 
 6858:    s_rMr[threadIdx.x] = 0.0;
 6859:    s_pAp[threadIdx.x] = 0.0;
 6860: 
 6861:    // 2) get your node pointer
 6862:    NODE(node);  
 6863:    const int tid = threadIdx.x;
 6864: 
 6865:    const double diag = node->coeffDiag;
 6866:    const double r    = node->mR;
 6867:    const double p    = node->mP;  
 6868: 
 6869:    // apply preconditioner on the fly:
 6870:    const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 6871: 
 6872:    // 4) compute Ap = A.p
 6873:    double Ap = node->coeffDiag * node->mP;
 6874:    for (int j = 0; j < node->numNodes; ++j) {
 6875:       const Node *nbNode = node->nodes[j];
 6876:       Ap += node->coeffMatrix[j] * nbNode->mP;
 6877: 
 6878:    }
 6879:    node->mAp = Ap;
 6880:     
 6881: 
 6882:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 6883:    const double l_rMr = r*Mr;  // r'Mr
 6884:    const double l_pAp = p*Ap;  // p'Ap
 6885: 
 6886:    // 6) write into shared mem
 6887:    s_rMr[tid] = l_rMr;
 6888:    s_pAp[tid] = l_pAp;
 6889: 
 6890:    __syncthreads();
 6891: 
 6892:    // 7) block-wide tree reduction
 6893:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 6894:       if (tid < stride)  s_pAp[tid] += s_pAp[tid + stride];
 6895:       __syncthreads();
 6896:    }
 6897: 
 6898:    // 8) thread 0 atomically accumulates into the globals
 6899:    // XXX: This is slower than it needs to be, but it is simple and works
 6900:    if (tid == 0) atomicAdd(pAp, s_pAp[0]);
 6901: 
 6902: 
 6903: }
 6904: 
 6905: 
 6906: __global__ void updateSolutionAndDotProducts(void) {
 6907:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 6908: 
 6909:    s_rMr[threadIdx.x] = 0.0;
 6910: 
 6911: 
 6912:    // get node & bounds-check:
 6913:    NODE(node);
 6914:    const int tid = threadIdx.x;
 6915: 
 6916: 
 6917:    // Compute alpha
 6918:    const double alpha = (*rMr_old)/(*pAp);
 6919: 
 6920:    // load scalars
 6921:    const double diag = node->coeffDiag;
 6922:    const double p    = node->mP;
 6923:    const double Ap   = node->mAp;
 6924:    const double x    = node->mX;
 6925:    const double r    = node->mR;
 6926:    
 6927:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 6928: 
 6929:    // 1) update solution & residual
 6930:    const double x_new = x + alpha*p;
 6931:    const double r_new = r - alpha*Ap;
 6932:    node->mX = x_new;
 6933:    node->mR = r_new;
 6934: 
 6935:    // 2) apply Jacobi preconditioner on the fly
 6936:    const double Mr_new = r_new/diag;
 6937: 
 6938: 
 6939:    // 3) local contributions for the two dot-products
 6940:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 6941: 
 6942:    // 4) write into shared-mem
 6943:    s_rMr[tid] = l_rMr;
 6944: 
 6945:    __syncthreads();
 6946: 
 6947: 
 6948:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 6949:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 6950:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 6951:       __syncthreads();
 6952:    }
 6953: 
 6954:    // 6) thread 0 atomically folds into the global accumulators
 6955:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 6956: 
 6957: 
 6958: }
 6959: 
 6960: 
 6961: __global__ void updateSearchDirection() {
 6962:     NODE(node);
 6963: 
 6964:     // recompute z on-the-fly
 6965:     const double z = node->mR / node->coeffDiag;
 6966:     const double p = node->mP;
 6967: 
 6968:     const double beta = (*rMr_new)/(*rMr_old);
 6969: 
 6970: // printf("ZZZ updateSearchDirection: beta = %f\n", beta);
 6971: 
 6972:     // p =z + beta*p
 6973:     node->mP = z + beta*p;
 6974: 
 6975: }
 6976: 
 6977: __global__ void initializePreconditionedResidual(double *scalars) {
 6978: 
 6979:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 6980: 
 6981:     s_rMr[threadIdx.x] = 0.0;
 6982: 
 6983:     NODE(node);
 6984:     const int tid = threadIdx.x;
 6985:     // For the first iteration:
 6986:     // 1. Initial solution x = 0 (already set)
 6987:     // 2. Initial residual r = b (stored in qel)
 6988:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 6989: 
 6990: // XXX we should use the guess solution here    
 6991: 
 6992:     // Set initial residual r = b (from qel)
 6993:     node->mR = node->qel;
 6994: 
 6995:     // Compute z = M^-1 * r (preconditioned residual)
 6996:     const double z = node->mR / node->coeffDiag;
 6997: 
 6998:     // Set initial search direction p = z
 6999:     node->mP = z;
 7000: 
 7001:     // Initialize other variables needed for CG
 7002:     node->mX = 0.0;  // Initial solution
 7003:     node->mAp = 0.0; // Will be computed in first iteration
 7004: 
 7005:     // These point to a cupy array in the host code
 7006:     rMr_old = scalars + 0;
 7007:     rMr_new = scalars + 1;
 7008:     pAp     = scalars + 2;
 7009: 
 7010:     // Computes the first r'Mr (reduction)
 7011:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7012: 
 7013:     // 4) write into shared-mem
 7014:     s_rMr[tid] = l_rMr;
 7015: 
 7016:     __syncthreads();
 7017: 
 7018: 
 7019:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7020:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7021:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7022:         __syncthreads();
 7023:     }
 7024: 
 7025:     // 6) thread 0 atomically folds into the global accumulators
 7026:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7027: 
 7028:     *rMr_old = 0.0;
 7029:     *pAp = 0.0;
 7030: }
