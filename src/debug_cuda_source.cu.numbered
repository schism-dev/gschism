 7368: #ifdef DONTCOMPILE
 7369: __global__ void checkMassConservation(Tracers* sumtr) {
 7370: 
 7371:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7372: 
 7373:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7374: 
 7375:    Element *elem = &(mesh->localElemData[i]);
 7376: 
 7377:    // Skip dry elements
 7378:    if (elem->isDry) return;
 7379: 
 7380:    // Local sum array for this thread
 7381:    double localSum[N_TRACERS] = {0.0};
 7382: 
 7383:    // Sum over vertical levels for this element
 7384:    const int kbe = elem->kbe;
 7385:    const double area = elem->area;
 7386: 
 7387:    for (int k = kbe; k < nvrt; k++) {
 7388:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7389:       
 7390:       // Accumulate tracer mass
 7391:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7392:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7393:       }
 7394:    }
 7395: 
 7396:    //  This function returns per element sums. A reduction must be done on the host side.
 7397: }
 7398: 
 7399: 
 7400: __global__ void transport(void) {
 7401: 
 7402:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7403: 
 7404:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7405: 
 7406:    Element *elem = &(mesh->localElemData[ie]);
 7407: 
 7408:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7409: 
 7410:                for (int m=0; m<ntr; m++) {
 7411:                   for (int k=kbe(ie); k<nvrt; k++) {
 7412:                      // Calculate each polynomial's weight 
 7413:                      wm=0.d0; sum1=0.d0; 
 7414:                      wm1=0.d0; wm2=0.d0; 
 7415:                      for (int i=0; i<elem->nweno2; i++) {
 7416:                   
 7417:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7418:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7419:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7420:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7421:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7422:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7423:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7424:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7425:                      // -----------------Hu and Shu (1999)'s method----------------
 7426:                      b4=b1+b2+b3
 7427: 
 7428: //Error: add PRODUCTION CPP
 7429: #ifdef DEBUG
 7430:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7431:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7432:                     call parallel_abort(errmsg)
 7433:                   }
 7434: #endif
 7435: 
 7436:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7437:                   // !----test-------------- 
 7438:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7439:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7440:                   // !wm(i)=wm1(i)*wm2(i)
 7441:                   // !---------------------- 
 7442:                   sum1=sum1+wm(i)
 7443:                 } // end for i
 7444: 
 7445:                 wm=wm/sum1
 7446: 
 7447:                 for (int j=0; j<elem->i34; j++) {
 7448: 
 7449:                   const Side *side  = elem->sides[j];
 7450:                   const Node *node1 = side->n1;
 7451:                   const Node *node2 = side->n2;
 7452: 
 7453:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7454:                      trsd=0.d0
 7455:                      for (int kk=0; kk<nquad; kk++) {
 7456:                         for (int i=0; i<elem->nweno2; i++) {
 7457:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7458:                         } // end for i   
 7459:                      } // end for kk
 7460:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7461:                   } // outward flux
 7462:                } // end for j=1,i34(ie) ! side
 7463:             }
 7464:          }
 7465:               
 7466: 
 7467: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7468: //             //   calculate each polynomial's weight 
 7469: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7470: //                 wm=0.d0; sum1=0.d0
 7471: //                 do i=1,nweno1(ie) !for each polynomial
 7472: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7473: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7474: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7475: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7476: //                   wm(i)=b2
 7477: //                   sum1=sum1+b2
 7478: //                   !wm(i)=1.d0
 7479: //                   !sum1=sum1+1.d0
 7480: 
 7481: // // Error: PRODUCTION
 7482: // #ifdef DEBUG
 7483: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7484: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7485: //                     call parallel_abort(errmsg)
 7486: //                   endif
 7487: // #endif
 7488: 
 7489: //                 enddo !i
 7490: //                 wm=wm/sum1 !final weight
 7491: 
 7492:                 for (int j=0; j<elem->i34; j++) { // side
 7493:                   const Side *side = elem->sides[j];
 7494:                   const Node *node1 = side->n1;
 7495:                   const Node *node2 = side->n2;
 7496: 
 7497:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7498:                     trsd=0.d0
 7499:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7500:                       for (int i=0; i<elem->nweno1; i++) {
 7501:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7502:                       }
 7503:                     enddo //kk
 7504:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7505:                   } // outward flux
 7506:                 } // end for j=1,i34(ie) ! side
 7507:               } // end for k; ntr 
 7508: 
 7509:             else !simple upwind method
 7510:               do j=1,i34(ie)
 7511:                 jsj=elside(j,ie)
 7512:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7513:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7514:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7515:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7516:                   endif
 7517:                 enddo  !vertical layers
 7518:               enddo !j=1,i34(ie) ! side
 7519:             endif !order of accuracy
 7520: 
 7521:          //  enddo !ie
 7522: // !$OMP     end do
