 1765: // Convenience macros for accessing the objects in kernels.
 1766: 
 1767: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 1768:                    Side *side = &(mesh->localSideData[idx_side]); \
 1769:                    if (idx_side >= mesh->ns) return;
 1770: 
 1771: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 1772:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 1773:                    if (idx_elem >= mesh->ne) return;
 1774: 
 1775: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 1776:                    Node *node = &(mesh->localNodeData[idx_node]); \
 1777:                    if (idx_node >= mesh->np) return;
 1778: 
 1779: #define NODE_ALL(node, valid) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x;       \
 1780:                               Node *node = &(mesh->localNodeData[idx_node]); \
 1781:                               const bool valid = (idx_node < mesh->np);                   
 1782: 
 1783: 
 1784: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1785:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 1786:                            if (idx_node_bnd >= mesh->nbp) return;
 1787: 
 1788: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1789:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 1790:                            if (idx_side_bnd >= mesh->nbs) return;                           
