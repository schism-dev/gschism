  397: 
  398: struct Frame {
  399:    // Column 0 (East):  (-sin_lon, cos_lon, 0)              — store 2 values, t20=0 implicit
  400:    // Column 1 (North): Normalized oblate ellipsoid vector  — store 3 values
  401:    // Column 2 (Up):    cross(col0, col1)                   — recomputed on demand
  402:     double t00, t10;        // col0 (t20=0 implicit)
  403:     double t01, t11, t21;   // col1
  404: 
  405:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  406: 
  407:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  408:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  409:       sincos(ar2, &sin_ar2, &cos_ar2);
  410: 
  411:       t00 = -sin_ar1;
  412:       t10 =  cos_ar1;
  413:       t01 = -cos_ar1*sin_ar2;
  414:       t11 = -sin_ar1*sin_ar2;
  415:       t21 = (rearth_pole/rearth_eq)*cos_ar2;
  416: 
  417:       const double col1_norm = sqrt(t01*t01 + t11*t11 + t21*t21);
  418:       assert (col1_norm != 0.0 && "GRID: col1_norm=0");
  419: 
  420:       const double col1_norm_inv = 1.0/col1_norm;
  421:       t01 = t01*col1_norm_inv;
  422:       t11 = t11*col1_norm_inv;
  423:       t21 = t21*col1_norm_inv;
  424: 
  425:       // The 3rd column (col2) is the cross product of the first two and is computed when needed.
  426: 
  427:    }
  428: 
  429:    __forceinline__ __device__ void getCol2(double &t02, double &t12, double &t22) const {
  430:       // cross(col0, col1), with t20=0 implicitly:
  431:       // |  i       j       k   |
  432:       // | t00     t10      0   |
  433:       // | t01     t11     t21  |
  434:       t02 =  t10*t21;
  435:       t12 = -t00*t21;
  436:       t22 =  t00*t11 - t10*t01;
  437:    }
  438: 
  439: 
  440:    __forceinline__ __device__ Vector2 projHorVec(Vector2 const &vec0, Frame const &frameout) const {
  441:    // Transforms a horizontal vector from one frame to another and projects it to the new local horizontal plane.
  442:    // Inputs:
  443:    //        vec0: vel. in this frame;
  444:    //        frameout: Output frame;
  445:    // Output: 
  446:    //        vel. in new frame  
  447:    //
  448:    // Projects a horizontal vector from frame 1 (this) to frame 2 (frameout),
  449:    // discarding the z-component of the result to keep only the local horizontal
  450:    // plane of frame 2.
  451:    //
  452:    // Since F1 and F2 are global-to-local rotation matrices, transforming from
  453:    // frame 1 to frame 2 requires F2 * F1^{-1} = F2 * F1^T, as rotation matrices
  454:    // are orthogonal. This product is computed as dot products between columns of
  455:    // F1 and columns of F2, which is equivalent to multiplying rows of F1^T by
  456:    // columns of F2.// 
  457: 
  458:       auto const fo = frameout; // Just an alias for the output frame.
  459:       Vector2 res;
  460: 
  461:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  462:       // of t and fo.t are the same.
  463:       const double d00 = t00*fo.t00 + t10*fo.t10;
  464:       const double d10 = t01*fo.t00 + t11*fo.t10;
  465: 
  466:       const double d01 = t00*fo.t01 + t10*fo.t11;
  467:       const double d11 = t01*fo.t01 + t11*fo.t11 + t21*fo.t21;
  468: 
  469:       res.x = vec0.x * d00 + vec0.y * d10;
  470:       res.y = vec0.x * d01 + vec0.y * d11;
  471: 
  472:       return res;
  473:    }
  474: 
  475:    __forceinline__ __device__ Vector3 G2L(Vector3 const &vi) const {
  476:       Vector3 vo;
  477:       double t02, t12, t22;
  478: 
  479:       getCol2(t02, t12, t22);
  480: 
  481:       vo.x = vi.x*t00 + vi.y*t10;
  482:       vo.y = vi.x*t01 + vi.y*t11 + vi.z*t21;
  483:       vo.z = vi.x*t02 + vi.y*t12 + vi.z*t22;
  484: 
  485:       return vo;
  486:    
  487:    }
  488: 
  489:    __forceinline__ __device__ Vector3 L2G(Vector3 const &vi) const {
  490:       Vector3 vo;
  491:       double t02, t12, t22;
  492: 
  493:       getCol2(t02, t12, t22);
  494: 
  495:       // F * vi (non-transposed, so we use rows of F)
  496:       vo.x = vi.x*t00 + vi.y*t01 + vi.z*t02;
  497:       vo.y = vi.x*t10 + vi.y*t11 + vi.z*t12;
  498:       vo.z =            vi.y*t21 + vi.z*t22;  // t20=0 term dropped
  499: 
  500:       return vo;
  501:    }
  502: 
  503:    // __forceinline__ __device__ Point3 G2L(Point3 const &pi, Point3 const &origin0) const {
  504:    // // Tranforms a point from global to local frame     
  505:    //    return G2L(pi - origin0); // XXXX IS THIS CORRECT?
  506:    // }
  507: 
  508:    // __forceinline__ __device__ Point3 L2G(Point3 const &pi, Point3 const &origin0) const {
  509:    // // Transforms a point from local to global frame      
  510:    //    return L2G(pi) + origin0;  // XXXX IS THIS CORRECT?
  511:    // }
  512: 
  513: };
