 5151:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 5152: 
 5153:       NODE(node);
 5154: 
 5155:       node->ETP = 0.0;
 5156: 
 5157:       if constexpr(ntip == 0) return;
 5158: 
 5159:       // For all tidal potential components
 5160:       for (int j=0; j<ntip; j++) {
 5161: 
 5162:          const double nodeETP = node->computeETP(j, time, tfreq, tamp, tnf, tear, jspc);
 5163: 
 5164:          node->ETP += nodeETP;
 5165: 
 5166:          if constexpr(iloadtide==1) { // loading tide
 5167:             assert(false && "Loading tide not implemented");
 5168:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5169:          }
 5170:          
 5171:       }
 5172: 
 5173:      
 5174:    }
