 6516: __global__ void getStructSizes(int* sizes)  {
 6517:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 6518:       sizes[0] = (int)sizeof(Node);
 6519:       sizes[1] = (int)sizeof(Element);
 6520:       sizes[2] = (int)sizeof(Side);
 6521:       sizes[3] = (int)sizeof(NodeBoundary);
 6522:       sizes[4] = (int)sizeof(SideBoundary);
 6523:       sizes[5] = (int)sizeof(BoundarySegment);
 6524: }
