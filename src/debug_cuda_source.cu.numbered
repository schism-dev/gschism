 9802: 
 9803: extern "C" __global__ void getNodeVar(int varCode, void *res, int k) {
 9804:    // Packed local order into res. Caller allocates sizePart * nbytes.
 9805:    NODE(node);
 9806: 
 9807:    switch (varCode) {
 9808:       case (int)VarCode::outputCoords: {
 9809:          const Point2 coords = node->outputCoords();
 9810:          double *out = (double *)((char *)res + idx_node * 16);
 9811:          out[0] = coords.x;
 9812:          out[1] = coords.y;
 9813:          break;
 9814:       }
 9815:       case (int)VarCode::depth:
 9816:          *(double *)((char *)res + idx_node * 8) = node->depth;
 9817:          break;
 9818:       case (int)VarCode::kb:
 9819:          *(int *)((char *)res + idx_node * 4) = (int)node->kb;
 9820:          break;
 9821:       case (int)VarCode::eta:
 9822:          *(double *)((char *)res + idx_node * 8) = node->eta2;
 9823:          break;
 9824:       case (int)VarCode::u_air: {
 9825:          double *out = (double *)((char *)res + idx_node * 16);
 9826:          out[0] = node->u_air.x;
 9827:          out[1] = node->u_air.y;
 9828:          break;
 9829:       }
 9830:       case (int)VarCode::isdry:
 9831:          *(int *)((char *)res + idx_node * 4) = (int)node->isDry;
 9832:          break;
 9833:       case (int)VarCode::u: {
 9834:          double *out = (double *)((char *)res + idx_node * nvrt * 16);
 9835:          if (k >= 0) {
 9836:             out[0] = node->u2[k].x;
 9837:             out[1] = node->u2[k].y;
 9838:          } else {
 9839:             for (int lev = 0; lev < nvrt; lev++) {
 9840:                out[lev*2    ] = node->u2[lev].x;
 9841:                out[lev*2 + 1] = node->u2[lev].y;
 9842:             }
 9843:          }
 9844:          break;
 9845:       }
 9846:       case (int)VarCode::z: {
 9847:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9848:          if (k >= 0)
 9849:             out[0] = node->z[k];
 9850:          else
 9851:             for (int lev = 0; lev < nvrt; lev++)
 9852:                out[lev] = node->z[lev];
 9853:          break;
 9854:       }
 9855:       case (int)VarCode::w: {
 9856:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9857:          if (k >= 0)
 9858:             out[0] = node->w2[k];
 9859:          else
 9860:             for (int lev = 0; lev < nvrt; lev++)
 9861:                out[lev] = node->w2[lev];
 9862:          break;
 9863:       }
 9864:       case (int)VarCode::dfh: {
 9865:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9866:          if (k >= 0)
 9867:             out[0] = node->dfh[k];
 9868:          else
 9869:             for (int lev = 0; lev < nvrt; lev++)
 9870:                out[lev] = node->dfh[lev];
 9871:          break;
 9872:       }
 9873:       case (int)VarCode::dfv: {
 9874:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9875:          if (k >= 0)
 9876:             out[0] = node->dfv[k];
 9877:          else
 9878:             for (int lev = 0; lev < nvrt; lev++)
 9879:                out[lev] = node->dfv[lev];
 9880:          break;
 9881:       }
 9882:       case (int)VarCode::tke: {
 9883:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9884:          if (k >= 0)
 9885:             out[0] = getTKE(node->turb, k);
 9886:          else
 9887:             for (int lev = 0; lev < nvrt; lev++)
 9888:                out[lev] = getTKE(node->turb, lev);
 9889:          break;
 9890:       }
 9891:       case (int)VarCode::mxl: {
 9892:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9893:          if (k >= 0)
 9894:             out[0] = getMXL(node->turb, k);
 9895:          else
 9896:             for (int lev = 0; lev < nvrt; lev++)
 9897:                out[lev] = getMXL(node->turb, lev);
 9898:          break;
 9899:       }
 9900:       case (int)VarCode::temp: {
 9901:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9902:          if (k >= 0)
 9903:             out[0] = node->tracers[k].tracer[0];
 9904:          else
 9905:             for (int lev = 0; lev < nvrt; lev++)
 9906:                out[lev] = node->tracers[lev].tracer[0];
 9907:          break;
 9908:       }
 9909:       case (int)VarCode::salt: {
 9910:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9911:          if (k >= 0)
 9912:             out[0] = node->tracers[k].tracer[1];
 9913:          else
 9914:             for (int lev = 0; lev < nvrt; lev++)
 9915:                out[lev] = node->tracers[lev].tracer[1];
 9916:          break;
 9917:       }
 9918:    }
 9919: }
 9920: 
 9921: 
 9922: extern "C" __global__ void getSideVar(int varCode, void *res, int k) {
 9923:    SIDE(side);
 9924: 
 9925:    switch (varCode) {
 9926:       case (int)VarCode::outputCoords: {
 9927:          const Point2 coords = side->outputCoords();
 9928:          double *out = (double *)((char *)res + idx_side * 16);
 9929:          out[0] = coords.x;
 9930:          out[1] = coords.y;
 9931:          break;
 9932:       }
 9933:       case (int)VarCode::n1:
 9934:          *(uintptr_t *)((char *)res + idx_side * 8) = (uintptr_t)((side->n1 != nullptr) ? side->n1->idx + 1 : -1);
 9935:          break;
 9936:       case (int)VarCode::n2:
 9937:          *(uintptr_t *)((char *)res + idx_side * 8) = (uintptr_t)((side->n2 != nullptr) ? side->n2->idx + 1 : -1);
 9938:          break;
 9939:       case (int)VarCode::isdry:
 9940:          *(int *)((char *)res + idx_side * 4) = (int)side->isDry;
 9941:          break;
 9942:    }
 9943: }
