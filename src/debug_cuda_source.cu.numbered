 5722: 
 5723:    __global__ void computeVerticalVelocity(void) {
 5724:       // Computes the vertical velocity at the (2D) element's centroid.
 5725:       // In this function we will be considering volumetric elements, with side faces and a 
 5726:       // bottom and a top face. We will call them SFs, BF and TF.
 5727:       // It computes the flux coming from BF and the SFs.
 5728:       // If the bed is moving, it takes that into account.
 5729:       // Since water is incompressible, the integral of the velocity times the normal vector
 5730:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 5731:       // and the BF is equal to the flux going out from the TF.
 5732:       // TF = - BF - sum(SFs).
 5733:       // It then computes the horizontal velocity at the center of TF.
 5734:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 5735:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 5736:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 5737: 
 5738:       ELEM(elem);
 5739: 
 5740:       if (elem->isDry) return;
 5741: 
 5742:       const int kb = elem->kb;
 5743:       const bool isTri = elem->isTri();
 5744: 
 5745:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 5746: 
 5747:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 5748:       const double av_bdef1 = elem->mean(&Node::bdef1);
 5749:       const double av_bdef2 = elem->mean(&Node::bdef2);
 5750: 
 5751:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 5752: 
 5753:       double area3D;
 5754: 
 5755:       // Bottom face flux
 5756:       double bottomFlux = 0.0;
 5757:       Vector2 u2meanBottom = {0.0, 0.0};
 5758:       const Vector2 gradh = elem->grad2(&Node::depth);
 5759:       if constexpr(imm==2) {
 5760:          Vector3 ubed;
 5761: 
 5762:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 5763:          // updateBDEF(ubed);
 5764:      
 5765:          // const double bflux0 = dot(ubed, elem_n1);
 5766: 
 5767:          // elem->w[kb] += ubed.z;
 5768:       }
 5769:       else {
 5770:          Vector2 umean;
 5771:          if constexpr(ics == 1) {
 5772:             u2meanBottom = elem->mean(kb, &Side::u2);
 5773:          }
 5774:          else {
 5775:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 5776:          }
 5777: 
 5778:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 5779:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 5780: 
 5781:          bottomFlux = - dot(gradh, u2meanBottom);
 5782:       } // if imm
 5783: 
 5784:       // Compute w for kb+1 to nvrt-1
 5785:       for (int l = kb; l < nvrt - 1; l++) {
 5786: 
 5787:          // normal vector to the top face of the "volumetric" element (3D)
 5788:          Vector3 elem_n2 = elem->n(l + 1, area3D); 
 5789: 
 5790:          // Compute the total flux at the sides
 5791:          double sideFlux = 0.0;
 5792:          Vector2 u2top = {0.0, 0.0};
 5793:          for (int j = 0; j < elem->i34; j++) {
 5794:             const Side *side = elem->sides[j];
 5795: 
 5796:             const double sideArea = side->area(l);
 5797:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 5798:             const double sign = elem->ssign[j]; 
 5799: 
 5800:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 5801:          }
 5802:          
 5803:          // Compute the horizontal velocity at the center of the top face as an average of the 
 5804:          //velocities at the centers of the sides
 5805:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 5806: 
 5807:          // The flx at the top ace can be computed from the other flows.
 5808:          const double topFlux = - sideFlux - bottomFlux;
 5809:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 5810: 
 5811:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 5812: 
 5813:          elem_n1 = elem_n2;
 5814: 
 5815:          bottomFlux = - topFlux;
 5816:       }
 5817:    }  
 5818: 
