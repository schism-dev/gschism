  210: // Simple math functions ---------------------------------------------------------------------------
  211: 
  212: __device__ __forceinline__ void solveQuadratic(double A, double B, double C, double &x1, double &x2) {
  213: // Solves the quadratic equation A*x^2 + B*x + C = 0 and returns the two solutions in x1 and x2.
  214: // Outputs:
  215: //        x1: first solution
  216: //        x2: second solution
  217: 
  218:        // Use float-specific absolute value for speed on GPU
  219:     const double absA = fabs(A);
  220:     const double absB = fabs(B);
  221: 
  222:     // 1. Near-linear case: a is effectively 0.
  223:     // We use a small epsilon to prevent division by zero and handle degenerate quads.
  224:     // This branch is almost never taken, so it won't hurt performance.
  225:     if (absA < 1e-14 * (absB + 1e-30)) {
  226:         const double x = -C / B;
  227:         x1 = x;
  228:         x2 = x;
  229:         return;  // Degenerate case: A = 0.
  230:     }
  231: 
  232:    const double delta = max(0.0, B*B - 4.0*A*C);
  233: 
  234:    assert(delta >= 0.0 && "solveQuadratic: negative discriminant");
  235:    const double s = sqrt(delta);
  236: 
  237:    // Numerically stable quadratic roots:
  238:    // q = -0.5*(B + sign(B)*sqrt(delta))
  239:    const double q = -0.5 * (B + copysign(s, B));
  240: 
  241:    x1 = q/A;
  242:    x2 = (fabs(q) > 1e-30) ? (C/q) : x1;   // Moving predicate.
  243: 
  244: }
