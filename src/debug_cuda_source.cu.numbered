  526: 
  527: struct Frame {
  528:    // Column 0 (East):  (-sin_lon, cos_lon, 0)              — store 2 values, t20=0 implicit
  529:    // Column 1 (North): Normalized oblate ellipsoid vector  — store 3 values
  530:    // Column 2 (Up):    cross(col0, col1)                   — recomputed on demand
  531:     double t00, t10;        // col0 (t20=0 implicit)
  532:     double t01, t11, t21;   // col1
  533: 
  534:    __device__ void update(double lat, double lon) { // XXX use lat, lon instead of ar1, ar2?
  535: 
  536:       assert(lat >= -pi/2.0 && lat <= pi/2.0 && "GRID: lat out of range");
  537:       assert(lon >= -pi     && lon <= pi     && "GRID: lon out of range");
  538: 
  539:       double sin_lon, cos_lon, sin_lat, cos_lat;
  540:       sincos(lon, &sin_lon, &cos_lon); // These functions are faster than sin(ar1) and cos(ar1).
  541:       sincos(lat, &sin_lat, &cos_lat);
  542: 
  543:       t00 = -sin_lon;
  544:       t10 =  cos_lon;
  545:       t01 = -cos_lon*sin_lat;
  546:       t11 = -sin_lon*sin_lat;
  547:       t21 = (rearth_pole/rearth_eq)*cos_lat;
  548: // printf("lat = %f, lon = %f, cos_lat = %f, sin_lat = %f, cos_lon = %f, sin_lon = %f\n", lat, lon, cos_lat, sin_lat, cos_lon, sin_lon);
  549: // printf("t00 = %f, t10 = %f, t01 = %f, t11 = %f, t21 = %f\n", t00, t10, t01, t11, t21);
  550: 
  551:       const double col1_norm = sqrt(t01*t01 + t11*t11 + t21*t21);
  552:       assert (col1_norm != 0.0 && "GRID: col1_norm=0");
  553: 
  554:       const double col1_norm_inv = 1.0/col1_norm;
  555:       t01 = t01*col1_norm_inv;
  556:       t11 = t11*col1_norm_inv;
  557:       t21 = t21*col1_norm_inv;
  558: 
  559:       // The 3rd column (col2) is the cross product of the first two and is computed when needed.
  560: 
  561: 
  562:    }
  563: 
  564:    __forceinline__ __device__ void print(void) const {
  565:       printf("frame = [%.16f, %.16f, %.16f, %.16f, %.16f]\n", t00, t10, t01, t11, t21);
  566:    }
  567: 
  568:    __forceinline__ __device__ void getCol2(double &t02, double &t12, double &t22) const {
  569:       // cross(col0, col1), with t20=0 implicitly:
  570:       // |  i       j       k   |
  571:       // | t00     t10      0   |
  572:       // | t01     t11     t21  |
  573:       t02 =  t10*t21;
  574:       t12 = -t00*t21;
  575:       t22 =  t00*t11 - t10*t01;
  576:    }
  577: 
  578: 
  579:    __forceinline__ __device__ Vector2 projHorVec(Vector2 const &vec0, Frame const &frameout) const {
  580:    // Transforms a horizontal vector from one frame to another and projects it to the new local horizontal plane.
  581:    // Inputs:
  582:    //        vec0: vel. in this frame;
  583:    //        frameout: Output frame;
  584:    // Output: 
  585:    //        vel. in new frame  
  586:    //
  587:    // Projects a horizontal vector from frame 1 (this) to frame 2 (frameout),
  588:    // discarding the z-component of the result to keep only the local horizontal
  589:    // plane of frame 2.
  590:    //
  591:    // Since F1 and F2 are global-to-local rotation matrices, transforming from
  592:    // frame 1 to frame 2 requires F2 * F1^{-1} = F2 * F1^T, as rotation matrices
  593:    // are orthogonal. This product is computed as dot products between columns of
  594:    // F1 and columns of F2, which is equivalent to multiplying rows of F1^T by
  595:    // columns of F2.// 
  596: 
  597:       auto const fo = frameout; // Just an alias for the output frame.
  598:       Vector2 res;
  599: 
  600:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  601:       // of t and fo.t are the same.
  602:       const double d00 = t00*fo.t00 + t10*fo.t10;
  603:       const double d10 = t01*fo.t00 + t11*fo.t10;
  604: 
  605:       const double d01 = t00*fo.t01 + t10*fo.t11;
  606:       const double d11 = t01*fo.t01 + t11*fo.t11 + t21*fo.t21;
  607: 
  608:       res.x = vec0.x * d00 + vec0.y * d10;
  609:       res.y = vec0.x * d01 + vec0.y * d11;
  610: 
  611:       return res;
  612:    }
  613: 
  614:    __forceinline__ __device__ Vector3 G2L(Vector3 const &vi) const {
  615:       Vector3 vo;
  616:       double t02, t12, t22;
  617: 
  618:       // Compute the 3rd column of the frame tensor
  619:       getCol2(t02, t12, t22);
  620: 
  621:       vo.x = vi.x*t00 + vi.y*t10;
  622:       vo.y = vi.x*t01 + vi.y*t11 + vi.z*t21;
  623:       vo.z = vi.x*t02 + vi.y*t12 + vi.z*t22;
  624: 
  625:       return vo;
  626:    
  627:    }
  628: 
  629:    __forceinline__ __device__ Vector3 L2G(Vector3 const &vi) const {
  630:       Vector3 vo;
  631:       double t02, t12, t22;
  632: 
  633:    // Compute the 3rd column of the frame tensor
  634:       getCol2(t02, t12, t22);
  635: 
  636:       // F * vi (non-transposed, so we use rows of F)
  637:       vo.x = vi.x*t00 + vi.y*t01 + vi.z*t02;
  638:       vo.y = vi.x*t10 + vi.y*t11 + vi.z*t12;
  639:       vo.z =            vi.y*t21 + vi.z*t22;  // t20=0 term dropped
  640: 
  641:       return vo;
  642:    }
  643: 
  644:    // Unit vectors that define the local frame
  645:    __forceinline__ __device__ Vector3 nUp(void) const {
  646:       // Column 2 = cross(column0, column1)
  647:       return { t10*t21, -t00*t21, t00*t11 - t10*t01 };
  648:    }
  649: 
  650:    __forceinline__ __device__ Vector3 nZonal(void) const {
  651:       // Column 0
  652:       return { t00, t10, 0.0 };
  653:    }
  654: 
  655:    __forceinline__ __device__ Vector3 nMeridional(void) const {
  656:       // Column 1
  657:       return { t01, t11, t21 };
  658:    }
  659: 
  660: };
