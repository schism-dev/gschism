 3713:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3714: 
 3715:       NODE_BND(nodeBnd);
 3716: 
 3717:       Node *node = nodeBnd->node;
 3718: 
 3719:       node->ETP = 0.0;
 3720: 
 3721:       for (int j=0; j<ntip; j++) {
 3722: 
 3723:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3724:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3725:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3726: 
 3727:          if constexpr(iloadtide==1) { // loading tide
 3728:             assert(false && "Loading tide not implemented");
 3729:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3730:          }
 3731:          
 3732:       }
 3733:       
 3734:    }
