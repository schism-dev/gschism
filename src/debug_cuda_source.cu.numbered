 1125: struct Side {
 1126: 
 1127:    // Geometry information
 1128:    int idx;               // Index of the side
 1129:    Node *n1, *n2;
 1130:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
 1131: 
 1132:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
 1133:    Vector2 center;        // Location of side center. 
 1134:    double zc[nvrt];       // Side center z-coord at each vertical level
 1135: 
 1136:    Frame<ics> frame;
 1137:    
 1138:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
 1139:                           // this is nullptr
 1140:    
 1141:    int kb;                // Bottom index of the side
 1142:    bool isDry;            // True if the side is dry
 1143:  
 1144:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1145: 
 1146:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1147: 
 1148:    // Physical information
 1149:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1150:    Vector2 btu[nvrt];           // Back-tracked velocity
 1151:    Vector2 U;                   // Vertically averaged velocity vector  
 1152: 
 1153:    Vector2 nuGradU[nvrt];          // nu*grad u
 1154: 
 1155:    Vector2 bcc[nvrt];           // Baroclinic term
 1156:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1157: 
 1158:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1159:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1160:    Vector2 gradPr;               // Gradient of pressure
 1161:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1162: 
 1163: 
 1164:    double hhat;                 // \breve{H} in notes
 1165: 
 1166:    double shapiro;
 1167: 
 1168:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1169: 
 1170:    double coriolis;             // Coriolis parameter
 1171: 
 1172:    // Vegetation parameters
 1173:    double veg_c2;
 1174:    double veg_beta;
 1175: 
 1176:    // Bottom drag parameters.
 1177:    double chi;
 1178:    double chi2;
 1179: 
 1180:    __inline__ __device__ Point2 outputCoords(void) const;
 1181: 
 1182:    __inline__ __device__ double x(double t) const;
 1183:    __inline__ __device__ double y(double t) const;
 1184:    __inline__ __device__ double z(double t) const;
 1185:    __inline__ __device__ double lon(void) const;
 1186:    __inline__ __device__ double lat(void) const;
 1187:    __inline__ __device__ Point2 p2_t(double t) const;
 1188: 
 1189:    __device__ void setFrame(void) {
 1190:       if constexpr(ics == 1) return;
 1191: 
 1192:       double lat, lon;
 1193:       const Point3 p = toPoint3(center, centerZ());
 1194: 
 1195:       // Compute the latitude and longitude of the element center
 1196:       computeLatLon(p, lat, lon);
 1197: 
 1198:       frame.update(lat, lon);        
 1199:    }
 1200:    
 1201: 
 1202:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1203:    // If ics == 2, convert the global point to the local frame of the side
 1204:       
 1205:       if constexpr (ics == 1) {
 1206:          return p;
 1207:       } else {
 1208:          const Point3 c = {center.x, center.y, centerZ()};
 1209:          const Point3 local = frame.G2L(p - c);
 1210:          return local;
 1211:       }
 1212:    }
 1213: 
 1214: 
 1215:    __device__ __forceinline__ Vector2 projectToLocalFrame(Vector2 const& v, Frame<ics> const& v_frame) const {
 1216:       if constexpr(ics == 1) return v;
 1217:       else return v_frame.projHorVec(v, frame);
 1218:    }
 1219: 
 1220:    __inline__ __device__ double centerZ(void)      const;
 1221:    __inline__ __device__ Point3 center3D(int k)    const { assert(false); assert(k < nvrt); return {center.x, center.y, zc[k]}; }  // USED??? CONSISTENT?? XXXXX
 1222:    __inline__ __device__ double Dz(int k)          const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1223:    __inline__ __device__ double area(int k)        const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1224:    __inline__ __device__ double areaClamped(int k) const { assert(k < nvrt - 1); return len*(zc[max(k + 1, kb)] - zc[max(k, kb)]); }
 1225: 
 1226:    __inline__ __device__ Side* neigh(int index) const { 
 1227:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1228:       assert(index >= 0 && index < 4); 
 1229:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1230: 
 1231:       const int ielem = index & 1;           // 0 or 1
 1232:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1233: 
 1234:       const Element* elem = elems[ielem];
 1235: 
 1236:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1237: 
 1238:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1239: 
 1240:    }
 1241: 
 1242:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1243: 
 1244:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1245: 
 1246:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1247:    __inline__ __device__ bool isOpenBnd(void) const { return isBnd() && sideBnd->segment->ifltype == 0; } // True if the side is an open boundary side
 1248:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1249:    __inline__ __device__ int iadv(void) const;
 1250: 
 1251:    __inline__ __device__ double grav3(void) const;
 1252:    
 1253:    __inline__ __device__ double eta2(void) const;
 1254:    __inline__ __device__ double eta1(void) const;
 1255:    __inline__ __device__ double w2(int k) const;
 1256:    __inline__ __device__ Vector2 u2Bottom(int dummy = 0) const { return u2[kb]; }  // XXXX dummy argument to satisfy the template in mean()
 1257:    __inline__ __device__ double depth(void) const;
 1258:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1259:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1260: 
 1261:    __inline__ __device__ double dfv(int k) const;
 1262: 
 1263:    __inline__ __device__ double veg_h(void)  const;
 1264:    __inline__ __device__ double veg_nv(void) const;
 1265:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1266:    __inline__ __device__ double veg_alpha3D(int k) const;
 1267:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1268: 
 1269:    __inline__ __device__ double Cd(void) const;
 1270: 
 1271:    __inline__ __device__ Vector2 tau(void) const;
 1272: 
 1273:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1274:    
 1275: 
 1276:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1277:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1278:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1279:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1280:    } 
 1281:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1282:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1283:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1284:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1285: 
 1286:    // Get valid starting element (for backtracking)
 1287:    __inline__ __device__ Element* getStartElement() {
 1288:       return elems[0] ? elems[0] : elems[1];
 1289:    }
 1290: 
 1291:    
 1292:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1293:       // Given an element, returns the other element that shares this side
 1294:       return (elems[0] == elem) ? elems[1] : elems[0];
 1295:    }
 1296: 
 1297:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1298:       // Given a node, returns the other node that shares this side
 1299:       return (n1 == node) ? n2 : n1;
 1300:    }
 1301:  
 1302:    __inline__ __device__ void btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1303: 
 1304: 
 1305: 
 1306: 
 1307: };
