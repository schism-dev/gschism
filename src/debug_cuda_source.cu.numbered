 3186: template<int nc>
 3187: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3188: 
 3189: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3190: //
 3191: // a,b,c,r: input vectors and are not modified by this program.
 3192: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3193: // r is the r.h.s.
 3194: // n: actual rank of the system.
 3195: // rows in u() and r();
 3196: // u: output with nc columns (transposed to rows)
 3197: // gam: a working array.
 3198: //
 3199: // NOTES:
 3200: // This is a template function that allows for different numbers of columns in the rhs vector.
 3201: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3202: 
 3203:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3204:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3205: 
 3206:    double bet = b[0];
 3207:    if constexpr (nc == 1) {
 3208:       u[0] = rhs[0]/bet;
 3209:    } else {
 3210:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 3211:    }
 3212: 
 3213:    for (int j = 1; j < n; j++) {
 3214:       gam[j] = c[j-1]/bet;
 3215:       bet = b[j] - a[j]*gam[j];
 3216: 
 3217:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3218: 
 3219:       if constexpr (nc == 1) {
 3220:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3221:       } else {
 3222:          for (int k = 0; k < nc; k++) {
 3223:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 3224:          }
 3225:       }
 3226:    }
 3227: 
 3228:    // Back-substitution
 3229:    for (int j=n-1; j>=1; j--) {
 3230:       if constexpr (nc == 1) {
 3231:          u[j] = u[j] - gam[j+1]*u[j-1];
 3232:       } else {
 3233:          for (int k = 0; k < nc; k++) {
 3234:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 3235:          }
 3236:       }
 3237:    }
 3238: }
 3239: 
 3240: 
 3241: 
 3242: 
 3243: // Helper function that contains the core algorithm
 3244: template<typename XAccessor, typename YAccessor>
 3245: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3246:                                     double  yp_top, double  yp_bot, 
 3247:                                     CubicSpline &spline) {
 3248:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3249:    // 
 3250:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3251:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3252:    //
 3253:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3254:    // 
 3255:    // Inputs: 
 3256:    //            n: dimension for x etc; # of data pts (>=2);
 3257:    //            getX, getY: functions to access x,y coordinates
 3258:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3259:    //     Output: 
 3260:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3261: 
 3262:    const int n = k2 - k1 + 1;
 3263:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3264: 
 3265:    // Allocate memory for the splines
 3266:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3267:    spline.x   = new double[n];
 3268:    spline.y   = new double[n];
 3269:    spline.yp  = new double[n];
 3270:    spline.ypp = new double[n];
 3271: 
 3272:    for (int k=k1; k<=k2; k++) {
 3273:       spline.x[k] = getX(k);
 3274:       spline.y[k] = getY(k);
 3275:    }
 3276: 
 3277:    // This is to simplify expressions later
 3278:    double *x = spline.x;
 3279:    double *y = spline.y;
 3280: 
 3281:    double *a = nullptr;
 3282:    double *b = nullptr;
 3283:    double *c = nullptr;
 3284:    double *gam = nullptr;
 3285:    double *rhs = nullptr;
 3286:    
 3287: 
 3288:       a = new double[n];   // Lower diagonal
 3289:       b = new double[n];   // Diagonal
 3290:       c = new double[n];   // Upper diagonal
 3291:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3292:       rhs = new double[n]; // Right-hand side
 3293: 
 3294:    for (int k=k1; k<=k2; k++) {
 3295:       if (k == k1) {
 3296:          // Bottom level
 3297:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3298:          b[k] = (x[k+1] - x[k])/3.0;
 3299:          c[k] = b[k]/2.0;
 3300:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3301:       } else if (k == n - 1) {
 3302:          // Top level (surface)
 3303:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3304:          b[k] = (x[k] - x[k-1])/3.0;
 3305:          a[k] = b[k]/2.0;
 3306:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3307:       } else {
 3308:          // Intermediate levels
 3309:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3310:          b[k] = (x[k+1] - x[k-1])/3.0;
 3311:          a[k] = (x[k  ] - x[k-1])/6.0;
 3312:          c[k] = (x[k+1] - x[k  ])/6.0;
 3313:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3314:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3315:       }
 3316:    }
 3317: 
 3318:    // Solve the tridiagonal system
 3319:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3320:    
 3321:    spline.yp[k1] = yp_bot;
 3322:    spline.yp[k2] = yp_top;
 3323: 
 3324:    // Compute rest of 1st derivatives using the splines
 3325:    for (int k=k1+1; k<k2; k++) {
 3326:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3327:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3328:    }
 3329:    
 3330:    delete[] a;
 3331:    delete[] b;
 3332:    delete[] c;
 3333:    delete[] gam;
 3334:    delete[] rhs;
 3335: 
 3336: }
 3337: 
 3338: // Array version
 3339: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3340:                                 double y_top, double y_bot, 
 3341:                                 CubicSpline &spline) {
 3342:    auto getX = [x] (int k) { return x[k]; };
 3343:    auto getY = [y] (int k) { return y[k]; };
 3344:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3345: }
 3346: 
 3347: // Lambda version - allows custom access patterns
 3348: template<typename XFunc, typename YFunc>
 3349: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3350:                                 double y_top, double y_bot,
 3351:                                 CubicSpline &spline) {
 3352:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3353: }
 3354: 
 3355: 
 3356: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 3357: {
 3358:    assert("Not implemented");
 3359: 
 3360:    return 0.0;
 3361: }
