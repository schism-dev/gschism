 8138: __global__ void returnMatrix(double *res) {
 8139:    // Debugging: returns the matrix as a CuPy array
 8140: 
 8141:    const int size = mesh->np;
 8142:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8143:       const Node *node = mesh->localNodeData + idx_node;
 8144:       res[idx_node*size + idx_node] = node->coeffDiag;
 8145:       for (int j = 0; j < node->numNodes; j++) {
 8146:          Node* nbNode = node->nodes[j];
 8147:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 8148:       }
 8149: 
 8150:    }
 8151:    
 8152: }
 8153: 
 8154: __global__ void returnX(double *res) {
 8155:    // Debugging: returns the matrix as a CuPy array
 8156: 
 8157:    const int size = mesh->np;
 8158:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8159:       const Node *node = mesh->localNodeData + idx_node;
 8160: 
 8161:       res[idx_node] = node->mX;
 8162: 
 8163:    }
 8164:    
 8165: }
