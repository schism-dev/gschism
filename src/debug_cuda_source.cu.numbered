 2481:    template<typename T>
 2482:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 2483:       // Get the values of the field at the nodes of the element
 2484:       res[0] = nodes[0]->*field;
 2485:       res[1] = nodes[1]->*field;
 2486:       res[2] = nodes[2]->*field;
 2487:       if (isQuad()) res[3] = nodes[3]->*field;
 2488:       else          res[3] = T();
 2489:    }
 2490: 
 2491:    template<typename T>
 2492:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 2493: 
 2494:       assert(level < nvrt && "Level is out of range");
 2495:       // Get the values of the field at the nodes of the element
 2496:       res[0] = (nodes[0]->*field)[max(level, nodes[0]->kb)];
 2497:       res[1] = (nodes[1]->*field)[max(level, nodes[1]->kb)];
 2498:       res[2] = (nodes[2]->*field)[max(level, nodes[2]->kb)];
 2499:       if (isQuad()) res[3] = (nodes[3]->*field)[max(level, nodes[3]->kb)];
 2500:       else          res[3] = T();
 2501:    }    
 2502: 
 2503:    template<typename T>
 2504:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
 2505: 
 2506:       assert(level < nvrt && "Level is out of range");
 2507: 
 2508:       // Get the values of the func at the nodes of the element
 2509:       res[0] = (nodes[0]->*func)(max(level, nodes[0]->kb));
 2510:       res[1] = (nodes[1]->*func)(max(level, nodes[1]->kb));
 2511:       res[2] = (nodes[2]->*func)(max(level, nodes[2]->kb));
 2512:       if (isQuad()) res[3] = (nodes[3]->*func)(max(level, nodes[3]->kb));
 2513:       else          res[3] = T();  // This is 0.0 or a zero vector
 2514: 
 2515:    }      
 2516: 
 2517:    template<typename T>
 2518:    __device__ __forceinline__ void Element::getSideValues(T Side::* field, T res[4]) const {
 2519:       // Get the values of the field at the nodes of the element
 2520:       res[0] = sides[0]->*field;
 2521:       res[1] = sides[1]->*field;
 2522:       res[2] = sides[2]->*field;
 2523:       if (isQuad()) res[3] = sides[3]->*field;
 2524:       else          res[3] = T();
 2525:    }
 2526: 
 2527:    template<typename T>
 2528:    __device__ __forceinline__ void Element::getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
 2529: 
 2530:       assert(level < nvrt && "Level is out of range");
 2531: 
 2532:       // Get the values of the field at the nodes of the element
 2533:       res[0] = (sides[0]->*field)[max(level, sides[0]->kb)];
 2534:       res[1] = (sides[1]->*field)[max(level, sides[1]->kb)];
 2535:       res[2] = (sides[2]->*field)[max(level, sides[2]->kb)];
 2536:       if (isQuad()) res[3] = (sides[3]->*field)[max(level, sides[3]->kb)];
 2537:       else          res[3] = T();
 2538:    }    
 2539: 
 2540:    template<typename T>
 2541:    __device__ __forceinline__ void Element::getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
 2542: 
 2543:       assert(level < nvrt && "Level is out of range");
 2544: 
 2545:       // Get the values of the func at the nodes of the element
 2546:       res[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2547:       res[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2548:       res[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2549:       if (isQuad()) res[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2550:       else          res[3] = T();  // This is 0.0 or a zero vector
 2551: 
 2552:    }      
