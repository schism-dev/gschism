 3751: 
 3752:    __global__ void scaleGravity(double loadtide_coef) {
 3753: 
 3754: 
 3755:       NODE(node);
 3756: 
 3757:       // SAL option: scale gravity
 3758:       if constexpr(iloadtide==2) {  // simple const
 3759:          node->grav2 = grav*(1.0 - loadtide_coef);
 3760: 
 3761:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3762:         
 3763:           const double depth = max(node->depth, 0.0);
 3764:           const double tmp1 = sqrt(depth);
 3765:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3766:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3767:                              2.6969e-13*depth*depth*depth*tmp1;
 3768:           
 3769:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3770:           
 3771: 
 3772: 
 3773:           node->grav2 = grav*(1.0 - beta_bar);
 3774: 
 3775:       } else {  // iloadtide=0,1
 3776:         node->grav2=grav;
 3777: 
 3778:       }
 3779: 
 3780:    }
 3781: 
