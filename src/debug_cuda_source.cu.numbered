 3743: 
 3744: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3745:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3746:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3747: 
 3748: 
 3749:    NODE(node1);
 3750: 
 3751:    node1->clearMatrixRow();
 3752:    node1->qel = 0.0;
 3753: 
 3754:    // THIS IS FOR STRUCTURES XXX
 3755:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3756: 
 3757:    
 3758:    for (int j=0; j<node1->numElements; j++) {
 3759:       // For each element connected to the node...
 3760: 
 3761:       Element *elem = node1->elements[j];
 3762: 
 3763: 
 3764: 
 3765:       // Compute the average gravity
 3766:       const double grav3 = elem->mean(&Node::grav2);
 3767: 
 3768:       // Look at the documentation for the description of the terms in the following integrals
 3769: 
 3770:       // Integral I_1 
 3771:       // \bar{\breve{H}} 
 3772:       const double hhatb = elem->mean(&Side::hhat);        
 3773: 
 3774:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3775: 
 3776:       const int id1 = elem->nodeLocalIdx(node1); 
 3777:       const double area = elem->area;
 3778: 
 3779:       if (elem->isTri()) {
 3780: 
 3781:          // To clarify the notation in this section: 
 3782:          //   i stands for the node under consideration (node1)
 3783:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3784:          const int id2 = elem->nxq(1 + id1);
 3785:          const int id3 = elem->nxq(2 + id1);
 3786:          Node *node2 = elem->nodes[id2];
 3787:          Node *node3 = elem->nodes[id3];
 3788: 
 3789:          const Point2 x1 = node1->p;
 3790:          const Point2 x2 = node2->p;
 3791:          const Point2 x3 = node3->p;
 3792: 
 3793:          // integral of phi_i*phi_j
 3794:          const double ipp_ii = (1.0/6.0 )*area;
 3795:          const double ipp_ij = (1.0/12.0)*area;
 3796:          const double ipp_ik = (1.0/12.0)*area;
 3797: 
 3798:          // integral of [(grad phi_i) * (grad phi_j)]
 3799:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3800:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3801:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3802: 
 3803:          // Computes the different components of integral I_1 of each node with respect to node i.
 3804:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3805:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3806:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3807: 
 3808:          node1->addToSparseMatrix(node1, I1_ii);
 3809:          node1->addToSparseMatrix(node2, I1_ij); 
 3810:          node1->addToSparseMatrix(node3, I1_ik);
 3811: 
 3812:       }
 3813:       else { // Quad
 3814:          // XXX IMPLEMENT THIS
 3815:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3816: 
 3817:          // To clarify the notation in this section: 
 3818:          //   i stands for the node under consideration (node1)
 3819:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3820:          const int id2 = elem->nxq(1 + id1);
 3821:          const int id3 = elem->nxq(2 + id1);
 3822:          const int id4 = elem->nxq(3 + id1);
 3823:          Node *node2 = elem->nodes[id2];
 3824:          Node *node3 = elem->nodes[id3];
 3825:          Node *node4 = elem->nodes[id4];         
 3826: 
 3827:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3828:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3829:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3830:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3831:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3832: 
 3833:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3834:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3835:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3836:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3837:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3838: 
 3839:          // Computes the different components of integral I_1 of each node with respect to node i.
 3840:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3841:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3842:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3843:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3844: 
 3845:          node1->addToSparseMatrix(node1, I1_ii);
 3846:          node1->addToSparseMatrix(node2, I1_ij); 
 3847:          node1->addToSparseMatrix(node3, I1_ik);
 3848:          node1->addToSparseMatrix(node4, I1_il);
 3849:   
 3850:       } 
 3851: 
 3852:  
 3853:       // Integral I_4
 3854:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3855:       // Where
 3856:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3857: 
 3858:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3859:       // of U over the element.
 3860:       Vector2 U = {0.0, 0.0};
 3861:       for (int m=0; m < elem->i34; m++) {      
 3862:          const Side *side = elem->sides[m];
 3863: 
 3864:          if constexpr(ics == 1) U += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3865:          else                   U += side->frame.project_hvec(side->U, elem->frame);
 3866:       }
 3867:       U = U/elem->i34;
 3868: 
 3869: 
 3870:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3871: 
 3872: 
 3873:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3874:       const double I_4_1 = dot(gradPhi_1, U);
 3875: 
 3876: 
 3877:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3878:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3879: 
 3880:      
 3881:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3882: 
 3883:       // Additional terms 
 3884:       double vnorm = 0.0;
 3885:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3886:          Vector3 ubed = {0.0, 0.0, 0.0};
 3887:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3888: 
 3889:          Vector3 gradP = {0.0, 0.0, 1.0};
 3890:          for (int m=0; m < elem->i34; m++) {
 3891:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3892:            gradP += toVector3(gradP_2D, 0.0);
 3893:          }   
 3894:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3895:       } // imm==2
 3896: 
 3897:       if (elem->isTri()) {
 3898:          for (int l=0; l<3; l++) {
 3899: 
 3900:             Node *node = elem->nodes[l];
 3901: 
 3902:             double fac = (node == node1) ? 2.0 : 1.0;
 3903:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3904:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3905:            
 3906:          }
 3907: 
 3908: 
 3909:          if (!elem->isDry) {
 3910:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3911: 
 3912:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3913: 
 3914:          }
 3915: 
 3916:       } // isTri
 3917:       else { // isQuad
 3918:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3919:          // for (int l=0; l<4; l++) {
 3920:          //   const Node *node = elem->nodes[l];
 3921: 
 3922:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3923:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3924: 
 3925:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3926:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3927:          // }
 3928: 
 3929:       } // isQuad
 3930: 
 3931: 
 3932:      node1->qel += (dt/elem->i34)*elem->vsource;
 3933:       
 3934: 
 3935:    } // for all elements connected to the node
 3936:    
 3937: 
 3938:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3939:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 3940:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3941:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3942:       // If it is an open boundary node...
 3943: 
 3944:       // At least one open bnd side, maybe two
 3945:       for (int l=0; l<2; l++) { 
 3946: 
 3947:          // Gets each of the sides sharing the node. 
 3948:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3949: 
 3950:        
 3951: 
 3952:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3953:          if (sideBnd != nullptr) {
 3954:             // If the side is on a boundary...
 3955: 
 3956:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3957: 
 3958:             // Get the boundary segment
 3959:             const BoundarySegment *sideSegment = sideBnd->segment;
 3960:             const Side *side = sideBnd->side;
 3961: 
 3962:             // Integral I_3
 3963:             if (sideSegment->ifltype != 0) {
 3964:             // Natural or Flather b.c.
 3965: 
 3966:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3967:                // especially for Flather b.c.
 3968:                double ri3 = 0.0;
 3969:                if (!side->isDry) {
 3970:                   // If the side is not dry
 3971:                   
 3972:                   // Computes the side flux of (uth, vth)
 3973:                   double Vn = 0.0;
 3974:                   for (int k = side->kb; k < nvrt - 1; k++) {
 3975:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3976:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3977: 
 3978:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 3979:                   }
 3980: 
 3981:                   ri3 = 0.5*side->len*Vn;
 3982:                }
 3983: 
 3984:                if (sideSegment->ifltype == -1) { // Flather 1
 3985: 
 3986:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3987:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3988: 
 3989:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3990:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3991:                   
 3992:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3993:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3994: 
 3995:                } 
 3996:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3997:                   // Reset ri3
 3998:                   ri3 = 0.0;
 3999: 
 4000:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4001: 
 4002:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4003: 
 4004:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4005:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4006: 
 4007:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4008:                   node1->addToSparseMatrix(node1, con0*2.0);
 4009:                   node1->addToSparseMatrix(node2, con0);
 4010: 
 4011:                } // if Flather or Discharge
 4012: 
 4013:                node1->qel -= thetai*dt*ri3;
 4014: 
 4015: 
 4016:             } // I_3
 4017:           
 4018: 
 4019:             // Integral I_5
 4020:             if(!side->isDry) {
 4021: 
 4022:                const double Unbar = dot(side->U, side->n);
 4023:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 4024: 
 4025:             } // I_5
 4026: 
 4027:          } // if is boundary side
 4028: 
 4029:       } // for l
 4030: 
 4031:    } // if isbnd
 4032: 
 4033: 
 4034: }
 4035: 
