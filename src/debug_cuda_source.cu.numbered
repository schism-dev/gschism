 7543: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 7544:    Node *nodes = mesh->localNodeData;
 7545: 
 7546:    *addr = nodes;
 7547:    *sizeNode = sizeof(Node);
 7548: 
 7549:    switch (varCode) {
 7550:       case (int)VarCode::depth:
 7551:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 7552:          *sizeType = sizeof(double);
 7553:          break;
 7554:       case (int)VarCode::eta:
 7555:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 7556:          *sizeType = sizeof(double);
 7557:          break;
 7558:       case (int)VarCode::x:
 7559:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 7560:          *sizeType = sizeof(Vector2);
 7561:          break;
 7562:       case (int)VarCode::z:
 7563:          *offset = (int)((char*)&nodes[0].z[0] - (char*)nodes);
 7564:          *sizeType = sizeof(double);
 7565:          break;
 7566:       case (int)VarCode::kb:
 7567:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 7568:          *sizeType = sizeof(int);
 7569:          break;
 7570:       case (int)VarCode::isdry:
 7571:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 7572:          *sizeType = sizeof(int);
 7573:          break;         
 7574:       case (int)VarCode::w:
 7575:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 7576:          *sizeType = sizeof(double);
 7577:          break;
 7578:       case (int)VarCode::u:
 7579:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 7580:          *sizeType = sizeof(Vector2);
 7581:          break;         
 7582:       default:
 7583:          *offset = -1;    
 7584:    }  
 7585:    
 7586: }
