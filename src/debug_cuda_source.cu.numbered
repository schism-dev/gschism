 8765: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 8766:    Node *nodes = mesh->localNodeData;
 8767: 
 8768:    *addr = nodes;
 8769:    *sizeNode = sizeof(Node);
 8770: 
 8771:    switch (varCode) {
 8772:       case (int)VarCode::depth:
 8773:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 8774:          *sizeType = sizeof(double);
 8775:          break;
 8776:       case (int)VarCode::eta:
 8777:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 8778:          *sizeType = sizeof(double);
 8779:          break;
 8780:       case (int)VarCode::x:
 8781:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 8782:          *sizeType = sizeof(Vector2);
 8783:          break;
 8784:       case (int)VarCode::z:
 8785:          *offset = (int)((char*)&nodes[0].z - (char*)nodes);
 8786:          *sizeType = sizeof(double);
 8787:          break;
 8788:       case (int)VarCode::kb:
 8789:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 8790:          *sizeType = sizeof(int);
 8791:          break;
 8792:       case (int)VarCode::isdry:
 8793:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 8794:          *sizeType = sizeof(int);
 8795:          break;         
 8796:       case (int)VarCode::w:
 8797:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 8798:          *sizeType = sizeof(double);
 8799:          break;
 8800:       case (int)VarCode::u:
 8801:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 8802:          *sizeType = sizeof(Vector2);
 8803:          break;  
 8804:       case (int)VarCode::u_air:
 8805:          *offset = (int)((char*)&nodes[0].u_air - (char*)nodes);
 8806:          *sizeType = sizeof(Vector2);
 8807:          break;
 8808:       default:
 8809:          *offset = -1;    
 8810:    }  
 8811:    
 8812: }
