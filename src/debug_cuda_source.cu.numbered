 1423:    __device__ Mesh(int partNum,
 1424:                    int npgb, int negb, int nsgb, 
 1425:                    int np, int ne, int ns,
 1426:                    int max_np, int max_ne, int max_ns, int nseg,
 1427:                    Node **nodesPtr, Element **elemsPtr, Side **sidesPtr,
 1428:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 1429:                    Node    **localNodeNeighNodesMem,
