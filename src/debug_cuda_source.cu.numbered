 4425:    __global__ void setWinds(double *xWind, double *yWind, double *pressAir) {
 4426:       NODE(node);
 4427: 
 4428:       const int idx = node->idx;
 4429:       Vector2 wind = {xWind[idx], yWind[idx]};
 4430: 
 4431:       if constexpr(nws != 0 && iwindoff != 0) {
 4432:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 4433:       }
 4434: 
 4435:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 4436:       node->setWind(wind);
 4437: 
 4438:       node->pr = pressAir[idx];
 4439:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 4440: 
 4441:    }
