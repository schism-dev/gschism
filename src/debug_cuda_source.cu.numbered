 1511:    __device__ void setFrame(void) {
 1512:       if constexpr(ics == 1) return;
 1513: 
 1514:       double lat, lon;
 1515:       const Point3 p = toPoint3(center, centerZ());
 1516: 
 1517:       // Compute the latitude and longitude of the element center
 1518:       computeLatLon(p, lat, lon);
 1519: 
 1520:       frame.update(lat, lon);        
 1521:    }
 1522:    
 1523: 
 1524:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1525:    // If ics == 2, convert the global point to the local frame of the side
 1526:       
 1527:       if constexpr (ics == 1) {
 1528:          return p;
 1529:       } else {
 1530:          const Point3 c = {center.x, center.y, centerZ()};
 1531:          const Point3 local = frame.G2L(p - c);
 1532:          return local;
 1533:       }
 1534:    }
 1535: 
 1536:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1537:       if constexpr (ics == 1) {
 1538:          return p;
 1539:       } else {
 1540:          const Point3 c = {center.x, center.y, centerZ()};
 1541:          return c + frame.L2G(p);
 1542:       }
 1543:    }
