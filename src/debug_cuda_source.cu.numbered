 5317:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 5318: 
 5319:       NODE(node);
 5320: 
 5321:       node->ETP = 0.0;
 5322: 
 5323:       if constexpr(ntip == 0) return;
 5324: 
 5325:       // For all tidal potential components
 5326:       for (int j=0; j<ntip; j++) {
 5327: 
 5328:          const double nodeETP = node->computeETP(j, time, tfreq, tamp, tnf, tear, jspc);
 5329: 
 5330:          node->ETP += nodeETP;
 5331: 
 5332:          if constexpr(iloadtide==1) { // loading tide
 5333:             assert(false && "Loading tide not implemented");
 5334:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5335:          }
 5336:          
 5337:       }
 5338: 
 5339:      
 5340:    }
