 8377: __global__ void getStructSizes(int* sizes)  {
 8378:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 8379:       printf(">>>>>*** C++ 3 getStructSizes, sizes = %p\n", sizes);
 8380:       sizes[0] = (int)sizeof(Node);
