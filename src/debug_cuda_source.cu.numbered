 3408: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3409:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3410:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3411:    // 
 3412:    // This kernel is called for all nodes.
 3413: 
 3414: 
 3415:    NODE(node1);
 3416: 
 3417: 
 3418:    node1->clearMatrixRow();
 3419:    node1->qel = 0.0;
 3420: 
 3421:    // THIS IS FOR STRUCTURES XXX
 3422:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3423: 
 3424:    
 3425:    for (int j=0; j<node1->numElements; j++) {
 3426:       // For each element connected to the node...
 3427: 
 3428:       Element *elem = node1->elements[j];
 3429: 
 3430:       // Compute the average gravity
 3431:       const double grav3 = elem->mean(&Node::grav2);
 3432: 
 3433:       // Look at the documentation for the description of the terms in the following integrals
 3434: 
 3435:       // Integral I_1 
 3436:       // \bar{\breve{H}} 
 3437:       const double hhatb = elem->mean(&Side::hhat);        
 3438: 
 3439:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3440: 
 3441:       const int id1 = elem->nodeLocalIdx(node1); 
 3442:       const double area = elem->area;
 3443: 
 3444:       if (elem->isTri()) {
 3445: 
 3446:          // To clarify the notation in this section: 
 3447:          //   i stands for the node under consideration (node1)
 3448:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3449:          const int id2 = elem->nxq(1 + id1);
 3450:          const int id3 = elem->nxq(2 + id1);
 3451:          Node *node2 = elem->nodes[id2];
 3452:          Node *node3 = elem->nodes[id3];
 3453: 
 3454:          const Point2 x1 = node1->p;
 3455:          const Point2 x2 = node2->p;
 3456:          const Point2 x3 = node3->p;
 3457: 
 3458:          // integral of phi_i*phi_j
 3459:          const double ipp_ii = (1.0/6.0 )*area;
 3460:          const double ipp_ij = (1.0/12.0)*area;
 3461:          const double ipp_ik = (1.0/12.0)*area;
 3462: 
 3463:          // integral of [(grad phi_i) * (grad phi_j)]
 3464:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3465:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3466:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3467: 
 3468:          // Computes the different components of integral I_1 of each node with respect to node i.
 3469:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3470:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3471:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3472: 
 3473:          node1->addToSparseMatrix(node1, I1_ii);
 3474:          node1->addToSparseMatrix(node2, I1_ij); 
 3475:          node1->addToSparseMatrix(node3, I1_ik);
 3476: 
 3477:       }
 3478:       else { // Quad
 3479:          // XXX IMPLEMENT THIS
 3480:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3481: 
 3482:          // To clarify the notation in this section: 
 3483:          //   i stands for the node under consideration (node1)
 3484:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3485:          const int id2 = elem->nxq(1 + id1);
 3486:          const int id3 = elem->nxq(2 + id1);
 3487:          const int id4 = elem->nxq(3 + id1);
 3488:          Node *node2 = elem->nodes[id2];
 3489:          Node *node3 = elem->nodes[id3];
 3490:          Node *node4 = elem->nodes[id4];         
 3491: 
 3492:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3493:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3494:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3495:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3496:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3497: 
 3498:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3499:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3500:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3501:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3502:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3503: 
 3504:          // Computes the different components of integral I_1 of each node with respect to node i.
 3505:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3506:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3507:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3508:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3509: 
 3510:          node1->addToSparseMatrix(node1, I1_ii);
 3511:          node1->addToSparseMatrix(node2, I1_ij); 
 3512:          node1->addToSparseMatrix(node3, I1_ik);
 3513:          node1->addToSparseMatrix(node4, I1_il);
 3514:   
 3515: 
 3516: 
 3517:       
 3518:       } 
 3519: 
 3520:  
 3521:       // Integral I_4
 3522:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3523:       // Where
 3524:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3525: 
 3526:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3527:       // of U over the element.
 3528:       Vector2 Umean = {0.0, 0.0};
 3529:       for (int m=0; m<elem->i34; m++) {      
 3530:          const Side *side = elem->sides[m];
 3531: 
 3532:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3533:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3534:       }
 3535:       Umean = Umean/elem->i34;
 3536: 
 3537:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3538: 
 3539:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3540:       const double I_4_1 = dot(gradPhi_1, Umean);
 3541: 
 3542:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3543:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3544:      
 3545:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3546: 
 3547:       // Additional terms 
 3548:       double vnorm = 0.0;
 3549:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3550:          Vector3 ubed;
 3551:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3552: 
 3553:          Vector3 gradP = {0.0, 0.0, 1.0};
 3554:          for (int m=0; m < elem->i34; m++) {
 3555:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3556:            gradP += toVector3(gradP_2D, 0.0);
 3557:          }   
 3558:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3559:       } // imm==2
 3560: 
 3561:       if (elem->isTri()) {
 3562:          for (int l=0; l<3; l++) {
 3563:             double fac;
 3564: 
 3565:             Node *node = elem->nodes[l];
 3566: 
 3567:             fac = (node == node1) ? 2.0 : 1.0;
 3568:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3569:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3570:            
 3571:          }
 3572: 
 3573: 
 3574:          if (!elem->isDry) {
 3575:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3576: 
 3577:           node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3578: 
 3579:          }
 3580: 
 3581:       } // isTri
 3582:       else { // isQuad
 3583:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3584:          // for (int l=0; l<4; l++) {
 3585:          //   const Node *node = elem->nodes[l];
 3586: 
 3587:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3588:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3589: 
 3590:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3591:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3592:          // }
 3593: 
 3594:       } // isQuad
 3595: 
 3596: 
 3597:      node1->qel += (dt/elem->i34)*elem->vsource;
 3598:       
 3599: 
 3600:    } // for all elements connected to the node
 3601:    
 3602: 
 3603:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3604:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3605:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3606:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3607:       // If it is an open boundary node...
 3608: 
 3609:       // At least one open bnd side, maybe two
 3610:       for (int l=0; l<2; l++) { 
 3611: 
 3612:          // Gets each of the sides sharing the node. 
 3613:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3614: 
 3615:          // if (sideBnd == nullptr) continue; // Skip if no boundary side
 3616:          
 3617: 
 3618:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3619:          if (sideBnd != nullptr) {
 3620:             // If the side is on a boundary...
 3621: 
 3622:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3623: 
 3624:             // Get the boundary segment
 3625:             const BoundarySegment *sideSegment = sideBnd->segment;
 3626:             const Side *side = sideBnd->side;
 3627: 
 3628:             // Integral I_3
 3629:             if (sideSegment->ifltype != 0) {
 3630:             // Natural or Flather b.c.
 3631: 
 3632:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3633:                // especially for Flather b.c.
 3634:                double ri3 = 0.0;
 3635:                if (!side->isDry) {
 3636:                   // If the side is not dry
 3637:                   
 3638:                   // Computes the side flux of (uth, vth)
 3639:                   double Vn = 0.0;
 3640:                   for (int k = side->kb; k<nvrt-1; k++) {
 3641:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3642:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3643: 
 3644:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3645:                   }
 3646: 
 3647:                   ri3 = 0.5*side->len*Vn;
 3648:                }
 3649: 
 3650:                if (sideSegment->ifltype == -1) { // Flather 1
 3651: 
 3652:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3653:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3654: 
 3655:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3656:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3657:                   
 3658:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3659:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3660: 
 3661:                } 
 3662:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3663:                   // Reset ri3
 3664:                   ri3 = 0.0;
 3665: 
 3666:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3667: 
 3668:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3669: 
 3670:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3671:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3672: 
 3673:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3674:                   node1->addToSparseMatrix(node1, con0*2.0);
 3675:                   node1->addToSparseMatrix(node2, con0);
 3676: 
 3677:                } // if Flather or Discharge
 3678: 
 3679: // printf("node1 = %p, thetai = %f, dt = %f, ri3 = %f\n", node1, thetai, dt, ri3);
 3680:                node1->qel -= thetai*dt*ri3;
 3681: 
 3682: 
 3683:             } // I_3
 3684:           
 3685: 
 3686:             // Integral I_5
 3687:             if(!side->isDry) {
 3688: 
 3689:                const double Unbar = dot(side->U, side->n);
 3690:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3691: 
 3692:             } // I_5
 3693: 
 3694:          } // if is boundary side
 3695: 
 3696:       } // for l
 3697: 
 3698:    } // if isbnd
 3699: 
 3700: 
 3701: }
 3702: 
 3703: 
 3704: 
 3705: extern "C" {
 3706:    __global__ void rollUpElevation(void) {
 3707: 
 3708:       NODE(node);
 3709: 
 3710:       node->eta1 = node->eta2;
 3711: 
 3712:    }
 3713: 
 3714: 
 3715:    __global__ void backtrackAllNodes(void) {
 3716: 
 3717:       // max/min # of sub-divisions
 3718:       const int ndelt_max = max(1.0, dt/dtb_min);
 3719:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3720: 
 3721:       // Removed all references to swild98 XXX
 3722:       // swild98=0.d0 !init
 3723: 
 3724: 
 3725:       SIDE(side);
 3726: 
 3727:       const int kb = side->kb;
 3728: 
 3729: 
 3730:       // Initialize btrack velocities to the actual velocities at the side 
 3731:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3732: 
 3733:       if (side->isDry) return;
 3734: 
 3735: 
 3736:       // Checks that at least one element is not dry
 3737:       const Element *elem1 = side->elems[0];
 3738:       const Element *elem2 = side->elems[1];
 3739: 
 3740: 
 3741:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3742:       
 3743:       // XXXXXX
 3744:       // !swild_tmp to store global coord. of the starting side
 3745:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3746:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3747:       // !Use sframe2 
 3748:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3749: 
 3750: 
 3751:       for (int k = kb; k < nvrt; k++) {
 3752:       //  Initialize (xt,yt,zt), nnel and vel.
 3753:       //  For ics=2, the coordinates are in local frames
 3754:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3755: 
 3756: 
 3757:          const int iadvf = side->iadv();  // Advection flag
 3758: 
 3759:          Point3 xt;
 3760:          if constexpr(ics==1) {
 3761:             xt = side->center3D(k); 
 3762:          }
 3763:          else // lat/lon; in side lat/lon frame
 3764:          {
 3765:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3766:          // XXX IMPLEMENT THIS
 3767:       //          xt=0.d0
 3768:       //          yt=0.d0
 3769:       //          !centroid coord. for nudging
 3770:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3771:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3772:          }  // ics
 3773: 
 3774: 
 3775: 
 3776:          // If on land or open boundary...
 3777:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3778:          
 3779:          const double vmag = length(side->u2[k]);
 3780: 
 3781:          if (vmag <= velmin_btrack) {
 3782:             // No activity 
 3783: 
 3784:             side->btu[k] = side->u2[k];
 3785:             
 3786:          } else {  // do btrack
 3787: 
 3788:             // Compute number of sub-divisions based on local gradients 
 3789:             // XXX IS THIS NECESSARY?
 3790:             double suma = 0.0;
 3791:             int icount = 0;
 3792:             for (int ii=0; ii<2; ii++) {
 3793: 
 3794:                const Element *elem = side->elems[ii];
 3795:                  
 3796:                if (elem == nullptr) continue;
 3797: 
 3798:                icount++;
 3799: 
 3800:                // Not strictly along z; in ll frame for ics=2
 3801: 
 3802:                double utmp[4];
 3803:                double vtmp[4];
 3804:                for (int jj = 0; jj < elem->i34; jj++) {
 3805: 
 3806:                   const Node *node = elem->nodes[jj];
 3807: 
 3808:                   if constexpr(ics==1) {
 3809:                      utmp[jj] = node->u2[k].x;
 3810:                      vtmp[jj] = node->u2[k].y;  
 3811:                   } else {
 3812:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3813:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3814:                   }
 3815:                } // for jj
 3816: 
 3817:                const Vector2 grad_u = elem->grad2(utmp); 
 3818:                const Vector2 grad_v = elem->grad2(vtmp);
 3819: 
 3820:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3821:             } // for ii
 3822: 
 3823:             assert(icount > 0 && "Impossible 77");
 3824: 
 3825:             // '4' is somewhat arbitrary
 3826:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3827: 
 3828:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3829:          
 3830: 
 3831:             Vector3 u_int = {0.0, 0.0, 0.0};
 3832: 
 3833:             side->btrack(k, dt, dtbk, u_int);
 3834:             side->btu[k] = toVector2(u_int);
 3835:                
 3836:          } // if vmag (do backtrack)
 3837: 
 3838:       } // for k=kb,nvrt-1
 3839: 
 3840:    }
 3841: 
 3842: } // extern "C"
 3843: 
 3844: template<int nc>
 3845: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3846: 
 3847: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3848: //
 3849: // a,b,c,rhs: input vectors and are not modified by this program.
 3850: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3851: // rhs is the r.h.s.
 3852: // n: actual rank of the system.
 3853: // rows in u() and rhs();
 3854: // u: output with nc columns (transposed to rows)
 3855: // gam: a working array.
 3856: //
 3857: // NOTES:
 3858: // This is a template function that allows for different numbers of columns in the rhs vector.
 3859: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3860: 
 3861:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3862:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3863: 
 3864:    double bet = b[0];
 3865:    if constexpr (nc == 1) {
 3866:       u[0] = rhs[0]/bet;
 3867:    } else {
 3868:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 3869:    }
 3870: 
 3871:    for (int j = 1; j < n; j++) {
 3872:       gam[j] = c[j - 1]/bet;
 3873:       bet = b[j] - a[j]*gam[j];
 3874: 
 3875:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3876: 
 3877:       if constexpr (nc == 1) {
 3878:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3879:       } else {
 3880:          for (int l = 0; l < nc; l++) {
 3881:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 3882:          }
 3883:       }
 3884:    }
 3885: 
 3886:    // Back-substitution
 3887:    for (int j = n - 2; j >= 0; j--) {
 3888:       if constexpr (nc == 1) {
 3889:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 3890:       } else {
 3891:          for (int l = 0; l < nc; l++) {
 3892:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 3893:          }
 3894:       }
 3895:    }
 3896: }
 3897: 
 3898: 
 3899: 
 3900: // Helper function that contains the core algorithm
 3901: template<typename XAccessor, typename YAccessor>
 3902: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3903:                                     double  yp_top, double  yp_bot, 
 3904:                                     CubicSpline &spline) {
 3905:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3906:    // 
 3907:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3908:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3909:    //
 3910:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3911:    // 
 3912:    // Inputs: 
 3913:    //            n: dimension for x etc; # of data pts (>=2);
 3914:    //            getX, getY: functions to access x,y coordinates
 3915:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3916:    //     Output: 
 3917:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3918: 
 3919:    const int n = k2 - k1 + 1;
 3920:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3921: 
 3922:    // Allocate memory for the splines
 3923:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3924:    spline.x   = new double[n];
 3925:    spline.y   = new double[n];
 3926:    spline.yp  = new double[n];
 3927:    spline.ypp = new double[n];
 3928: 
 3929:    for (int k=k1; k<=k2; k++) {
 3930:       spline.x[k] = getX(k);
 3931:       spline.y[k] = getY(k);
 3932:    }
 3933: 
 3934:    // This is to simplify expressions later
 3935:    double *x = spline.x;
 3936:    double *y = spline.y;
 3937: 
 3938:    double *a = nullptr;
 3939:    double *b = nullptr;
 3940:    double *c = nullptr;
 3941:    double *gam = nullptr;
 3942:    double *rhs = nullptr;
 3943:    
 3944: 
 3945:       a = new double[n];   // Lower diagonal
 3946:       b = new double[n];   // Diagonal
 3947:       c = new double[n];   // Upper diagonal
 3948:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3949:       rhs = new double[n]; // Right-hand side
 3950: 
 3951:    for (int k=k1; k<=k2; k++) {
 3952:       if (k == k1) {
 3953:          // Bottom level
 3954:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3955:          b[k] = (x[k+1] - x[k])/3.0;
 3956:          c[k] = b[k]/2.0;
 3957:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3958:       } else if (k == n - 1) {
 3959:          // Top level (surface)
 3960:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3961:          b[k] = (x[k] - x[k-1])/3.0;
 3962:          a[k] = b[k]/2.0;
 3963:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3964:       } else {
 3965:          // Intermediate levels
 3966:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3967:          b[k] = (x[k+1] - x[k-1])/3.0;
 3968:          a[k] = (x[k  ] - x[k-1])/6.0;
 3969:          c[k] = (x[k+1] - x[k  ])/6.0;
 3970:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3971:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3972:       }
 3973:    }
 3974: 
 3975:    // Solve the tridiagonal system
 3976:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3977:    
 3978:    spline.yp[k1] = yp_bot;
 3979:    spline.yp[k2] = yp_top;
 3980: 
 3981:    // Compute rest of 1st derivatives using the splines
 3982:    for (int k=k1+1; k<k2; k++) {
 3983:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3984:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3985:    }
 3986:    
 3987:    delete[] a;
 3988:    delete[] b;
 3989:    delete[] c;
 3990:    delete[] gam;
 3991:    delete[] rhs;
 3992: 
 3993: }
 3994: 
 3995: // Array version
 3996: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3997:                                 double y_top, double y_bot, 
 3998:                                 CubicSpline &spline) {
 3999:    auto getX = [x] (int k) { return x[k]; };
 4000:    auto getY = [y] (int k) { return y[k]; };
 4001:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4002: }
 4003: 
 4004: // Lambda version - allows custom access patterns
 4005: template<typename XFunc, typename YFunc>
 4006: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4007:                                 double y_top, double y_bot,
 4008:                                 CubicSpline &spline) {
 4009:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4010: }
 4011: 
 4012: 
 4013: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 4014: {
 4015:    assert("Not implemented");
 4016: 
 4017:    return 0.0;
 4018: }
