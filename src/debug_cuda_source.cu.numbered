 7211: 
 7212: __global__ void computeMatrixProductAndDotProducts() {
 7213:    // Computes A*p, r'Mr and p'Ap
 7214: 
 7215:    // 1) shared buffer: first half for rMr, second for pAp
 7216:    __shared__ double sdata[2*BLOCK_SIZE];
 7217:    double* s_rMr = sdata;
 7218:    double* s_pAp = sdata + BLOCK_SIZE;
 7219: 
 7220:    const int tid = threadIdx.x;
 7221: 
 7222:    double l_pAp = 0.0;
 7223: 
 7224:    s_rMr[tid] = 0.0;
 7225:    s_pAp[tid] = 0.0;
 7226: 
 7227:    // 2) get your node pointer
 7228:    // NODE(node);   
 7229:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7230:    Node *node = &(mesh->localNodeData[idx_node]); 
 7231:       if (idx_node < mesh->np) {
 7232: 
 7233:       const double diag = node->coeffDiag;
 7234:       const double r    = node->mR;
 7235:       const double p    = node->mP;  
 7236: 
 7237:       // apply preconditioner on the fly:
 7238:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7239: 
 7240:       // 4) compute Ap = A.p
 7241:       double Ap = node->coeffDiag * node->mP;
 7242:       for (int j = 0; j < node->numNodes; ++j) {
 7243:          const Node *nbNode = node->nodes[j];
 7244:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7245: 
 7246:       }
 7247: 
 7248:       node->mAp = Ap;
 7249:       
 7250: 
 7251:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7252:       // const double l_rMr = r*Mr;  // r'Mr
 7253:       l_pAp = p*Ap;  // p'Ap
 7254: 
 7255: 
 7256:    }
 7257: 
 7258:    // 6) write into shared mem
 7259:    // s_rMr[tid] = l_rMr;
 7260:    s_pAp[tid] = l_pAp;
 7261: 
 7262:    __syncthreads();
 7263: 
 7264:    // 7) block-wide tree reduction
 7265:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7266:       if (tid < stride)  {
 7267:          s_pAp[tid] += s_pAp[tid + stride];
 7268:       }
 7269:       __syncthreads();
 7270:    }
 7271: 
 7272:    // 8) thread 0 atomically accumulates into the globals
 7273:    // XXX: This is slower than it needs to be, but it is simple and works
 7274:    if (tid == 0) {
 7275:       atomicAdd(pAp, s_pAp[0]);
 7276:    }
 7277: 
 7278: 
 7279: }
 7280: 
 7281: 
 7282: __global__ void updateSolutionAndDotProducts(void) {
 7283:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7284: 
 7285:    const int tid = threadIdx.x;
 7286: 
 7287:    s_rMr[tid] = 0.0;
 7288: 
 7289:    // get node & bounds-check:
 7290:    NODE(node);
 7291: 
 7292:    
 7293:    // Compute alpha
 7294:    const double alpha = (*rMr_old)/(*pAp); 
 7295: 
 7296: 
 7297:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7298: 
 7299: 
 7300:    // load scalars
 7301:    const double diag = node->coeffDiag;
 7302:    const double p    = node->mP;
 7303:    const double Ap   = node->mAp;
 7304:    const double x    = node->mX;
 7305:    const double r    = node->mR;
 7306:    
 7307:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7308: 
 7309:    // 1) update solution & residual
 7310:    const double x_new = x + alpha*p;
 7311:    const double r_new = r - alpha*Ap;
 7312:    node->mX = x_new;
 7313:    node->mR = r_new;
 7314: 
 7315:    // 2) apply Jacobi preconditioner on the fly
 7316:    const double Mr_new = r_new/diag;
 7317: 
 7318: 
 7319:    // 3) local contributions for the two dot-products
 7320:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7321: 
 7322:    // 4) write into shared-mem
 7323:    s_rMr[tid] = l_rMr;
 7324: 
 7325:    __syncthreads();
 7326: 
 7327: 
 7328:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7329:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7330:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7331:       __syncthreads();
 7332:    }
 7333: 
 7334:    // 6) thread 0 atomically folds into the global accumulators
 7335:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7336: 
 7337: 
 7338: }
 7339: 
 7340: 
 7341: __global__ void updateSearchDirection() {
 7342: 
 7343:     NODE(node);
 7344: 
 7345:     // recompute z on-the-fly
 7346:     const double z = node->mR / node->coeffDiag;
 7347:     const double p = node->mP;
 7348: 
 7349:     const double beta = (*rMr_new)/(*rMr_old);
 7350: 
 7351: 
 7352:     // p =z + beta*p
 7353:     node->mP = z + beta*p;
 7354: 
 7355: }
 7356: 
 7357: __global__ void initializeScalars(double *scalars) {
 7358: 
 7359:    // These point to a cupy array in the host code
 7360:    rMr_old = scalars + 0;
 7361:    rMr_new = scalars + 1;
 7362:    pAp     = scalars + 2;
 7363: }
 7364: 
 7365: __global__ void initializePreconditionedResidual(void) {
 7366: 
 7367:     __shared__ double s_rMr[BLOCK_SIZE];  
 7368: 
 7369:     s_rMr[threadIdx.x] = 0.0;
 7370: 
 7371:     NODE_ALL(node, valid);
 7372:     const int tid = threadIdx.x;
 7373:     // For the first iteration:
 7374:     // 1. Initial solution x = 0 (already set)
 7375:     // 2. Initial residual r = b (stored in qel)
 7376:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7377: 
 7378: // XXX we should use the guess solution here    
 7379: 
 7380:     double l_rMr = 0.0;
 7381:     if (valid) {
 7382:       // Set initial residual r = b (from qel)
 7383:       node->mR = node->qel;
 7384: 
 7385:       // Compute z = M^-1 * r (preconditioned residual)
 7386:       const double z = node->mR / node->coeffDiag;
 7387: 
 7388:       // Set initial search direction p = z
 7389:       node->mP = z;
 7390: 
 7391:       // Initialize other variables needed for CG
 7392:       node->mX = 0.0;  // Initial solution
 7393:       node->mAp = 0.0; // Will be computed in first iteration
 7394: 
 7395: 
 7396:       // Computes the first r'Mr (reduction)
 7397:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7398:     }
 7399:     // 4) write into shared-mem
 7400:     s_rMr[tid] = l_rMr;
 7401: 
 7402:     __syncthreads();
 7403: 
 7404: 
 7405:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7406:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7407:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7408:         __syncthreads();
 7409:     }
 7410: 
 7411:     // 6) thread 0 atomically folds into the global accumulators
 7412:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7413: 
 7414:     *rMr_old = 0.0;
 7415:     *pAp = 0.0;
 7416: }
 7417: 
 7418: 
 7419: 
 7420: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7421:    Element *elems = mesh->localElemData;
 7422: 
 7423:    *addr = elems;
 7424:    *sizeElement = sizeof(Element);
 7425:    switch (varCode) {
 7426:       case (int)VarCode::z:
 7427:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7428:          *sizeType = sizeof(double);
 7429:          break;
 7430:       case (int)VarCode::x:
 7431:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7432:          *sizeType = sizeof(Vector2);
 7433:          break;
 7434:       case (int)VarCode::area:
 7435:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7436:          *sizeType = sizeof(double);
 7437:          break;
 7438:       case (int)VarCode::depth:
 7439:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7440:          *sizeType = sizeof(double);
 7441:          break;
 7442:       case (int)VarCode::radius:
 7443:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7444:          *sizeType = sizeof(double);
 7445:          break;
 7446:       case (int)VarCode::lonlat:
 7447:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 7448:          *sizeType = sizeof(double);
 7449:          break;
 7450:       case (int)VarCode::ghat:
 7451:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7452:          *sizeType = sizeof(Vector2);
 7453:          break;
 7454:       case (int)VarCode::kb:
 7455:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 7456:          *sizeType = sizeof(int);
 7457:          break;
 7458:       case (int)VarCode::isdry:
 7459:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 7460:          *sizeType = sizeof(int);
 7461:          break;            
 7462:       case (int)VarCode::w:
 7463:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 7464:          *sizeType = sizeof(double);
 7465:          break;
 7466:       case (int)VarCode::FaceIndices:
 7467:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 7468:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 7469:          *sizeType = sizeof(Node);
 7470:          break;
 7471:       default:
 7472:          *offset = -1;
 7473:    }
 7474: }
