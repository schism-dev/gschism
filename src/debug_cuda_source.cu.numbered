 2560: 
 2561: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 2562: 
 2563: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 2564: 
 2565: /**
 2566:  * This method performs backtracking from the side center until a time -dt back in time 
 2567:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2568:  * intermediate point.
 2569:  *
 2570:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2571:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2572:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2573:  * remaining time.
 2574:  * 
 2575:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2576:  * 
 2577:  * @param uuint, vvint, wwint: Velocities at the final point
 2578:  * @param jlev: Level at which the backtracking is performed
 2579:  * @param dt, dtbk: Tracking timesteps
 2580:  * @return: True if the backtracking was successful, false otherwise
 2581:  */
 2582: __inline__ __device__ bool Side::btrack(
 2583:       int jlev,
 2584:       double dt,            // Tracking time
 2585:       double dtbk,          // Tracking timestep
 2586:       Vector3 &u_int        // Velocities at the initial point
 2587: ) const {
 2588: 
 2589:    // Start from side center
 2590:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2591: double dt0 = dt; // XXXXX
 2592: Point3 x00 = x0;
 2593: const int oriJlev = jlev;
 2594:  
 2595:    double time_rm = dt; // Remaining time
 2596: 
 2597: 
 2598: 
 2599: 
 2600:    // Initial velocities
 2601:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->w2[jlev] + n2->w2[jlev])};
 2602: 
 2603:    // Find the element that is in the direction opposite to the velocity
 2604:    Element* curElem = findElementTowards(toVector2(u_int));
 2605:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 2606: 
 2607: 
 2608:    // Nudges it towards the barycenter
 2609:    curElem->nudgeToBarycenter(toPoint2(x0)); // XXXX Necessary?
 2610: 
 2611: 
 2612:    const int MAX_ITERATIONS = 1000; 
 2613:    Element* nextElem = nullptr;
 2614:    int iter = 0;
 2615:    // assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 2616:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 2617:    while(true) {
 2618: 
 2619:       // Calculate timestep
 2620:       double dtb = min(dtbk, time_rm);
 2621: 
 2622:       // Next point in the backtracking curve
 2623:       xt = x0 - dtb*u_int;
 2624: 
 2625:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, time_rm, this);
 2626:       assert(found && "Backtracking failed in btrack");
 2627: 
 2628: 
 2629:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2630:                       // then time_rm needs to be increased by the unused time.
 2631: 
 2632:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0                      
 2633: 
 2634:       // If the velocity is too small, we stop the backtracking
 2635:       const double vmag = length(toVector2(u_int));
 2636:       if (vmag <= velmin_btrack) break;
 2637: 
 2638:       // The current point becomes the next segment's starting point.
 2639:       x0 = xt;
 2640:  
 2641:       curElem = nextElem;
 2642: 
 2643:       iter++;
 2644: 
 2645:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2646:    }
 2647: 
 2648:    assert(!curElem->isDry && "Final element is dry");
 2649:    assert(curElem->containsPoint(toPoint2(xt)) && "Target point is not inside the final element");
 2650: 
 2651:    // Interpolate the velocities at the final point
 2652:    curElem->interpolateVelocities(xt, u_int);
 2653: 
 2654: 
 2655: }
 2656: 
 2657: 
