 2583: /**
 2584:  * This method performs backtracking from the side center until a time -dt back in time 
 2585:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2586:  * intermediate point.
 2587:  *
 2588:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2589:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2590:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2591:  * remaining time.
 2592:  * 
 2593:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2594:  * 
 2595:  * @param uuint, vvint, wwint: Velocities at the final point
 2596:  * @param jlev: Level at which the backtracking is performed
 2597:  * @param dt, dtbk: Tracking timesteps
 2598:  * @return: True if the backtracking was successful, false otherwise
 2599:  */
 2600: __inline__ __device__ bool Side::btrack(
 2601:       int jlev,
 2602:       double dt,            // Tracking time
 2603:       double dtbk,          // Tracking timestep
 2604:       Vector3 &u_int        // Velocities at the initial point
 2605: ) const {
 2606: 
 2607:    // Start from side center
 2608:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2609: 
 2610:  
 2611:    double time_rm = dt; // Remaining time
 2612: 
 2613: 
 2614:    // // Initialize outputs XXX
 2615:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2616:    //    sclr[i] = 0.0;
 2617:    // }
 2618: 
 2619: 
 2620:    // Initial velocities
 2621:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->w2[jlev] + n2->w2[jlev])};
 2622: 
 2623:    // Find the element that is in the direction opposite to the velocity
 2624:    Element* curElem = findElementTowards(toVector2(u_int));
 2625: 
 2626: 
 2627:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2628:    if (curElem == nullptr) {
 2629:       // Make velocity parallel to the side
 2630:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2631:       // u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2632:       curElem = otherElem(curElem);
 2633:       
 2634:    }
 2635: 
 2636: // Nudges it towards the circumcenter
 2637: // printf("0{{jlev = %d}} side->idx = %d, x0 = %.15e,%.15e,%.15e\n", jlev, idx, x0.x, x0.y, x0.z);
 2638: Vector2 xcirc = {(curElem->nodes[0]->p.x + curElem->nodes[1]->p.x + curElem->nodes[2]->p.x)/3.0,
 2639:                  (curElem->nodes[0]->p.y + curElem->nodes[1]->p.y + curElem->nodes[2]->p.y)/3.0};
 2640: const double eps = 9.013e-3;                 
 2641: x0.x = xcirc.x*eps + (1 - eps)*x0.x;
 2642: x0.y = xcirc.y*eps + (1 - eps)*x0.y;
 2643: 
 2644: 
 2645: 
 2646:    const int MAX_ITERATIONS = 1000; 
 2647:    Element* nextElem = curElem;
 2648:    int iter = 0;
 2649:    while(true) {
 2650: 
 2651:       // Calculate timestep
 2652:       double dtb = min(dtbk, time_rm);
 2653: 
 2654:       // Next point in the backtracking curve
 2655:       Point3 xt = x0 - dtb*u_int;
 2656:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, this);
 2657:       assert(found && "Backtracking failed in btrack");
 2658: 
 2659:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2660: 
 2661:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2662:                       // then time_rm needs to be increased by the unused time.
 2663: 
 2664:       // If the velocity is too small, we stop the backtracking
 2665:       const double vmag = length(toVector2(u_int));
 2666:       if (vmag <= velmin_btrack) break;
 2667: 
 2668:       // The current point becomes the next segment's starting point.
 2669:       x0 = xt;
 2670:  
 2671:       curElem = nextElem;
 2672: 
 2673:       iter++;
 2674:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2675:    }
 2676: 
 2677: 
 2678: }
 2679: 
 2680: 
 2681: 
 2682: // /**
 2683: //    For a point (x1,y1) inside the element and a line segment (x1,y1)-(x2,y2), find the intersection point 
 2684: //    (xIntersect,yIntersect) and the side (intersectingSide) that it intersects.
 2685: 
 2686: //    Inputs:
 2687: //    @param x1, y1: point inside the element
 2688: //    @param x2, y2: other end of the line segment
 2689: 
 2690: //    Outputs:
 2691: //    @param intersectingSide:  side that intersects the line segment
 2692: //    @param nextElement: element that contains the intersection point
 2693: //    @param xIntersect, yIntersect: intersection point  
 2694: 
 2695: //    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 2696: //    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 2697: //    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
