 2398: 
 2399: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2400: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2401: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2402: // Only when ics == 2, the origin is at the element center.
 2403: 
 2404:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2405: 
 2406:    const Node *node = nodes[idxNode];
 2407: 
 2408:    if constexpr(ics==1) {
 2409:       return node->p;
 2410: 
 2411:    } else {
 2412:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2413: 
 2414:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2415: 
 2416:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2417:    }
 2418: 
 2419: }
 2420: 
 2421: 
 2422: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, 
 2423:                                                                             const Vector3& c, const Frame<ics>& dstFrame, int idx) const {
 2424: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2425: 
 2426:    const int id1 = idx;
 2427:    const int id2 = nxq(1 + id1);
 2428:    const int id3 = nxq(2 + id1);
 2429: 
 2430:    if constexpr(ics==1) {
 2431:       x0 = nodes[id1]->p;
 2432:       x1 = nodes[id2]->p;
 2433:       x2 = nodes[id3]->p;
 2434: 
 2435:    } else {
 2436: 
 2437:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2438:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2439:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2440: 
 2441:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2442:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2443:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2444: 
 2445:    }
 2446: 
 2447: }
 2448: 
 2449: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2450:    getLocalHorizontalNodePositionsTri(x0, x1, x2, {center.x, center.y, centerZ()}, frame, idx);
 2451: }
 2452: 
 2453: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2454:             Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3,
 2455:             const Vector3& c, const Frame<ics>& dstFrame) const {
 2456: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2457: 
 2458:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2459: 
 2460: 
 2461: 
 2462:    if constexpr(ics==1) {
 2463:       x0 = nodes[0]->p;
 2464:       x1 = nodes[1]->p;
 2465:       x2 = nodes[2]->p;  
 2466:       x3 = nodes[3]->p;
 2467: 
 2468:    } else {
 2469: 
 2470:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2471:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2472:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2473:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2474: 
 2475:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2476:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2477:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2478:       x3 = toVector2(dstFrame.G2L(p3 - c));
 2479:    }
 2480: 
 2481: }
 2482: 
 2483: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2484:    Point2& x0, Point2& x1, Point2& x2, Point2& x3) const
 2485: {
 2486:    getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, {center.x, center.y, centerZ()}, frame);
 2487: }
 2488: 
 2489: 
 2490: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2491: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2492: // Returns the normal vector and the area of the element at this level
 2493:    
 2494:    double nx, ny, nz;
 2495: 
 2496:    if (isTri()) {
 2497:       // For triangles...
 2498: 
 2499:       // Indices of the nodes at level k, taking care of not going below the bed
 2500:       const int k0 = max(k, nodes[0]->kb);
 2501:       const int k1 = max(k, nodes[1]->kb);
 2502:       const int k2 = max(k, nodes[2]->kb);
 2503: 
 2504:       // Gets the element frame coordinates of the nodes at level k
 2505:       Point3 x0, x1, x2;
 2506:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2507:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2508:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2509:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2510: 
 2511:       } else {  // ics == 2
 2512:          Point2 h0, h1, h2;
 2513: 
 2514:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2515: 
 2516:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2517:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2518:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2519:       }
 2520: 
 2521:       const Vector3 n20 = x2 - x0;
 2522:       const Vector3 n10 = x1 - x0; 
 2523: 
 2524:       // Computes the cross product of vectors n20 and n10. 
 2525:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2526:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2527:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2528: 
 2529:   
 2530:    }
 2531:    else {
 2532:       // For quads...
 2533:       Point2 h0, h1, h2, h3;
 2534: 
 2535:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2536: 
 2537:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2538:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2539:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k] - nodes[0]->z[k]);
 2540:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k] - nodes[1]->z[k]);
 2541: 
 2542:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2543:       nx = n20.y*n31.z - n20.z*n31.y;
 2544:       ny = n20.z*n31.x - n20.x*n31.z;
 2545:       nz = n20.x*n31.y - n20.y*n31.x;
 2546: 
 2547:    }
 2548: 
 2549:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2550:    area3D = 0.5*len;
 2551: 
 2552:    const double inv_len = 1.0/len;
 2553: 
 2554:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2555: 
 2556: }
 2557: 
 2558: 
 2559: // Helper functions to get the 2D local node position for the Celestial walk
 2560: __device__ __forceinline__ Point2 Element::getLocalNodePosition(int idx, const Side* origSide) const {
 2561:    const int idx2 = (isTri() && idx == 3) ? 2 : idx;
 2562:    const Node *node = getNodeInOrder(idx2);
 2563: 
 2564:    double z = 0.0;
 2565:    if constexpr(ics == 2) z = node->gz;
 2566:    
 2567:    Point3 p = toPoint3(node->p, z);
 2568: 
 2569:    return toPoint2(origSide->toLocalFrame(p));
 2570: }
 2571: 
 2572: __device__ __forceinline__ Node *Element::getNodeInOrder(int idx) const {
 2573:    return (ssign[idx] > 0) ? sides[idx]->n1 : sides[idx]->n2;
 2574: }
 2575: 
 2576: __device__ __forceinline__ void Element::computePredicates(const Point2 x0, const Point2& xt, double &fac, const Side* origSide,
 2577:                                 Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector, int jlev) const
 2578: // Computes the three per-side predicates needed for the celestial walk
 2579: // (Kuijper, Ermolaev, Devillers, JCGT 7(3), 2018, arXiv:1710.01620).
 2580: //
 2581: // xt is in local frame coordinates for origSide if ics == 2.
 2582: //
 2583: // All work is done unconditionally on 4 sides to keep CUDA threads uniform.
 2584: // For triangles, side 3 is a sentinel: getNode(3) returns getNode(2), making
 2585: // corners[3] == corners[2] and s3 == (0, 0). Predicates that would be
 2586: // meaningless on triangles are masked to a safe value (see comments below).
 2587: {
 2588:    // Project all 4 corner positions once into the local 2D frame.
 2589:    // For triangles, C[3] == C[2] (no garbage, but geometrically degenerate).
 2590:    // getLocalNodePosition only transforms/projects if ics == 2.
 2591:    const Point2 C[4] = {getLocalNodePosition(0, origSide), 
 2592:                         getLocalNodePosition(1, origSide), 
 2593:                         getLocalNodePosition(2, origSide), 
 2594:                         getLocalNodePosition(3, origSide)};
 2595: 
 2596:    // Computes the maximum distance from the starting point to the farthest element node projected on the segment x0xt.
 2597:    // This has nothing to do with the original celestial walk. It is used in the Leaded Celestial 
 2598:    //Walk algorithm to find a point on the segment x0xt that is as close as possible to the starting point,
 2599:    // But still farther towards the target point from the current point.
 2600:    const Vector2 vt0 = xt - x0;
 2601:    double maxProjDist = max(dot(vt0, C[0] - x0), dot(vt0, C[1] - x0));
 2602:    maxProjDist = max(maxProjDist, dot(vt0, C[2] - x0)); 
 2603:    maxProjDist = isQuad() ? max(maxProjDist, dot(vt0, C[3] - x0)) : maxProjDist;
 2604: 
 2605:    fac = max(1.00001*fac, min(1.0, (maxProjDist/dot(vt0, vt0))*1.00001));
 2606:    const Vector2 ixt = x0 + (xt - x0)*fac;
 2607: 
 2608: 
 2609: // if (origSide->idx == 2860848 && jlev == 46) {
 2610: // showPoints(toPoint3(x0,0.0), toPoint3(xt,0.0), jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2611: // showPoints(toPoint3(ixt,0.0), toPoint3(ixt,0.0), jlev, origSide, 0x00FF00u, 'o', 1, 0, 0);
 2612: // printf("this->idx = %d, origSide->idx = %d, ixt = (%.17f, %.17f), x0 = (%.17f, %.17f), xt = (%.17f, %.17f), fac = %.17f\n", this->idx, origSide->idx, ixt.x, ixt.y, x0.x, x0.y, xt.x, xt.y, fac);
 2613: // }
 2614:    // Side I goes from corners[I] to corners[nxq(I+1)] in CCW perimeter order.
 2615:    // (Note: with corners built from getNode in CCW order, no ssign factor is needed
 2616:    //  here the orientation is baked into the corners array.)
 2617:    const int i3 = nxq(3);
 2618:    const Vector2 s0 = C[ 1] - C[ 0];
 2619:    const Vector2 s1 = C[ 2] - C[ 1];
 2620:    const Vector2 s2 = C[i3] - C[ 2];
 2621:    const Vector2 s3 = C[ 0] - C[i3];
 2622:    
 2623:    // Side I goes from C[I] to C[nxq(I+1)] in CCW perimeter order.
 2624:    // The corners array is built from getNode in CCW order, so the orientation
 2625:    // is already correct and no ssign factor is needed in the formulas below.
 2626:    //
 2627:    // i3 = nxq(3): the index of the corner after side 2.
 2628:    //   Triangle: i3 == 0 (the closing corner of the triangle).
 2629:    //   Quad:     i3 == 3.
 2630:    //
 2631:    // The four side direction vectors. For triangles, s3 == (0, 0) since
 2632:    // C[i3] == C[0] (the perimeter has already closed by side 2).
 2633:    isLeft.set(0,  cross(s0, ixt - C[ 0]) > -small);
 2634:    isLeft.set(1,  cross(s1, ixt - C[ 1]) > -small);
 2635:    isLeft.set(2,  cross(s2, ixt - C[ 2]) > -small);
 2636:    isLeft.set(3, (cross(s3, ixt - C[i3]) > -small) || isTri());  
 2637: 
 2638: // printf("idx = %d, cross(s0, xt - C[ 0] ) = %.17f, cross(s1, xt - C[ 1] ) = %.17f, cross(s2, xt - C[ 2] ) = %.17f, cross(s3, xt - C[i3] ) = %.17f\n", idx, cross(s0, xt - C[ 0] ), cross(s1, xt - C[ 1] ), cross(s2, xt - C[ 2] ), cross(s3, xt - C[i3] ));
 2639: 
 2640:    // For triangles, the corner after side 2 is the closing corner where
 2641:    // side 2 meets side 0 (not side 3, which doesn't exist). The "next side
 2642:    // tangent" used by isObtuse and isBisector at that corner is therefore
 2643:    // s0 for triangles, s3 for quads.
 2644:    const Vector2 s3_tri = isTri() ? s0 : s3;
 2645: 
 2646:    // isObtuse.b[I]: true iff the internal face angle at the corner after
 2647:    // side I is obtuse. Equivalent to dot of consecutive side directions > 0
 2648:    // (acute "turn angle" along the perimeter = obtuse internal angle).
 2649:    //
 2650:    // isObtuse.b[3] for triangles: dot(s3, s0) = dot(0, s0) = 0, so the
 2651:    // result is false naturally. No sentinel needed.
 2652:    isObtuse.set(0, dot(s0, s1) > 0.0);
 2653:    isObtuse.set(1, dot(s1, s2) > 0.0);
 2654:    isObtuse.set(2, dot(s2, s3_tri) > 0.0);  // triangle: closes back to s0
 2655:    isObtuse.set(3, dot(s3, s0) > 0.0);  // Always false for triangles (s3=(0,0))
 2656: 
 2657:    // isBisector.b[I]: at the corner after side I, this tests whether xt is
 2658:    // on the "exit through side I" half of the corner cone, separated by the
 2659:    // approximate angular bisector of the celestial walk. The bisector is
 2660:    // perpendicular to the chord across the corner; the test is the sign of
 2661:    // (xt - corner_vertex) projected onto that chord.
 2662:    //
 2663:    // isBisector.b[3] is always masked out by isLeft.b[3] = true for triangles
 2664:    // (the validity rule sets valid_3 = false), so its computed value for
 2665:    // triangles doesn't matter. No sentinel needed.
 2666:    isBisector.set(0, dot(ixt - C[ 1], s0 + s1) < 0.0);
 2667:    isBisector.set(1, dot(ixt - C[ 2], s1 + s2) < 0.0);
 2668:    isBisector.set(2, dot(ixt - C[i3], s2 + s3_tri) < 0.0);
 2669:    isBisector.set(3, dot(ixt - C[ 0], s3 + s0) < 0.0);   
 2670: 
 2671: }
 2672: 
 2673: 
 2674: __inline__ __device__ double Element::computeSignedArea(void) const {
 2675:    // Compute the area of the element
 2676: 
 2677:    Point2 x0, x1, x2, x3;
 2678:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2679: 
 2680: 
 2681:    double res = signedArea(x0, x1, x2);
 2682: 
 2683:    // In the quad case we need to add the area of the other triangle.
 2684:    if (isQuad()) {
 2685:       x3 = getLocalHorizontalNodePosition(3);
 2686:       double ar1 = signedArea(x0, x2, x3);
 2687:       double ar2 = signedArea(x0, x1, x3);
 2688:       double ar3 = signedArea(x1, x2, x3);
 2689:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2690: 
 2691:       res += ar1;
 2692: 
 2693:    }
 2694: 
 2695:    return res;
 2696: }
 2697: 
 2698: 
 2699: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2700:                                                                 (nodes[1]->isDry2()) ||
 2701:                                                                 (nodes[2]->isDry2()) ||
 2702:                                                                 (isQuad() && nodes[3]->isDry2());
 2703: }
 2704: 
 2705: __inline__ __device__ double Element::detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2706:    return (1.0/8.0)*((x1.x - x0.x)*(x2.y - x3.y) - (x2.x - x3.x)*(x1.y - x0.y));
 2707: }
 2708: 
 2709: __inline__ __device__ double Element::detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2710:    return (1.0/8.0)*((x2.x - x1.x)*(x3.y - x0.y) - (x3.x - x0.x)*(x2.y - x1.y));
 2711: }
 2712: 
 2713: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2714:    // In boundary sides, the element 1 is nullptr
 2715:    return side->elems[1] == nullptr; 
 2716: }
 2717: 
 2718: __forceinline__ __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const {
 2719:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 2720:    // For ics == 2, this function uses local frame coordinates.
 2721: 
 2722:    assert(isQuad());
 2723: 
 2724:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 2725:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 2726:    // where vxi, veta, vb are vectors and c is the center of the element.
 2727: 
 2728:    Point2 p0, p1, p2, p3;
 2729: 
 2730:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 2731: 
 2732:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 2733:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 2734:    // vectors vxi and veta connect the centers of opposite sides
 2735:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 2736:    // vb is zero for parallelogram elements.
 2737:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 2738: 
 2739:    //  The bilinear mapping is:
 2740:    //      P(s,t) = C + s*U + t*V + s*t*W
 2741:    //
 2742:    //  where:
 2743:    //    C = centroid (average of four vertices)
 2744:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 2745:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 2746:    //    W = bilinear correction; measures deviation from parallelogram
 2747:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 2748:    //        W = 0 for parallelogram elements.
 2749:    //
 2750:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 2751:    //
 2752:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 2753:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 2754:    //
 2755:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 2756:    //
 2757:    //  Geometrically, (L) projects everything onto the direction
 2758:    //  perpendicular to W, where the mapping is purely affine.
 2759:    //
 2760:    //  The dot product with nb retains the nonlinear term:
 2761:    //
 2762:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 2763:    //
 2764:    //  Geometrically, (Q) projects onto the W direction, where
 2765:    //  the nonlinearity lives.
 2766:    //
 2767:    //  We solve (L) for whichever variable has the larger coefficient
 2768:    //  (better conditioned back-substitution), substitute into (Q),
 2769:    //  and get a scalar quadratic in the other variable.
 2770:    // ================================================================
 2771: 
 2772:    // ---- Basis vectors ----
 2773:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 2774:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 2775:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 2776:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 2777:    // W: nonlinear correction. Difference between quad and parallelogram.
 2778:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 2779:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 2780: 
 2781:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 2782:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 2783:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 2784:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 2785:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 2786: 
 2787:    // ---- nb: direction parallel to W, L1-normalized ----
 2788:    // We don't need a unit vector -- just a well-scaled direction parallel
 2789:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 2790:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 2791:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 2792:    //
 2793:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 2794:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 2795:    // and the quadratic solver takes its linear path (a ~ 0).
 2796:    const double wlen1 = fabs(vb.x) + fabs(vb.y) + 1e-30;
 2797:    const double inv_wlen = 1.0 / wlen1;
 2798:    const Vector2 nb = vb * inv_wlen;
 2799: 
 2800:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 2801:    // cross(nb, .) projects onto the direction PERPENDICULAR to W.
 2802:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 2803:    // What remains is a pure affine relationship between xi and eta.
 2804:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 2805:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 2806:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 2807: 
 2808:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 2809:    // dot(nb, .) projects onto the W direction, where the nonlinearity lives.
 2810:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 2811:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 2812:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 2813:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 2814:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 2815: 
 2816:    // ---- Solve: pick the better-conditioned variable from (L) ----
 2817:    // Back-substitute from (L) dividing by the LARGER coefficient,
 2818:    // minimizing round-off amplification.
 2819:    //
 2820:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 2821:    // that uses predicated moves.
 2822:    //
 2823:    // if (fabs(Ls) > fabs(Lt)) {
 2824:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 2825:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 2826:    //    // Substitute into (Q), multiply by Ls, group by eta:
 2827:    //    const double A = -Qw * Lt;
 2828:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 2829:    //    const double C =  Qs * Lp - Qp * Ls;
 2830: 
 2831:    //    double eta1, eta2;
 2832:    //    solveQuadratic(A, B, C, eta1, eta2);
 2833: 
 2834:    //    // Pick root with smaller |eta| (domain centered at 0).
 2835:    //    // Ternary-> predicated move, no branch divergence.
 2836:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 2837: 
 2838:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 2839:    //    xi = (Lp - Lt * eta) / Ls;
 2840: 
 2841:    // } else {
 2842:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 2843:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 2844:    //    // Substitute into (Q), multiply by Lt, group by xi:
 2845:    //    const double A = -Qw * Ls;
 2846:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 2847:    //    const double C =  Qt * Lp - Qp * Lt;
 2848: 
 2849:    //    double xi1, xi2;
 2850:    //    solveQuadratic(A, B, C, xi1, xi2);
 2851: 
 2852:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 2853: 
 2854:    //    eta = (Lp - Ls * xi) / Lt;
 2855:    // }
 2856:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 2857:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 2858:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 2859:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 2860:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 2861: 
 2862:    // Quadratic:  A*r^2 + B*r + C = 0
 2863:    // (same formula for both cases, just with swapped coefficients)
 2864:    const double A = -Qw * Lb;
 2865:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 2866:    const double C =  Qa * Lp - Qp * La;
 2867: 
 2868:    double r1, r2;
 2869:    solveQuadratic(A, B, C, r1, r2);
 2870: 
 2871:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 2872:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 2873: 
 2874:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 2875:    const double other = (Lp - Lb * r) / La;
 2876: 
 2877:    // Assign to (xi, eta) depending on which variable the quadratic solved
 2878:    xi  = solve_s ? r     : other;
 2879:    eta = solve_s ? other : r;
 2880: 
 2881: 
 2882:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 2883:    xi  = clamp(xi,  -1.0, 1.0);
 2884:    eta = clamp(eta, -1.0, 1.0);
 2885: 
 2886:    // ---- Shape functions ----
 2887:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 2888:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 2889:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 2890:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 2891:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 2892:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 2893:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 2894:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 2895: 
 2896:    return true;
 2897: }
 2898: 
 2899: /**
 2900:    Compute the shape coordinates of the point (xt,yt) in the element.
 2901:    @param xt (input): x-coordinate of the point
 2902:    @param shpCoords (output): shape coordinates of the point
 2903:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2904:    @return true if the point is inside the element, false otherwise
 2905: **/
 2906: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 2907: 
 2908:    // Compute the shape coordinates of the point xt in the element.
 2909:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 2910:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 2911:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 2912:    // from the local frame, so use additional check.
 2913: 
 2914: 
 2915:    Point3 origSideCenter = toPoint3(origSide->center, origSide->centerZ());
 2916: 
 2917:    if (isTri()) { // Triangular element
 2918: 
 2919:       // Horizontal local node coordinates. 
 2920:       Point2 x0, x1, x2;
 2921:       getLocalHorizontalNodePositionsTri(x0, x1, x2, origSideCenter, origSide->frame);
 2922: 
 2923:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2924:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2925:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2926:       shpCoords[3] = 0.0;
 2927: 
 2928:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2929:       const bool res = (tmpmin >= -small);  
 2930:       
 2931:       // When to fix the negative shape coordinates?
 2932:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2933: 
 2934:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2935:       // then we fix the negative shape coordinates.
 2936:       if ((tmpmin < 0) && fix) {
 2937: 
 2938:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2939:          // keeping the sum of the shape coordinates equal to 1.
 2940:          // I have tested and compared the new algorithm with the old one, and they give
 2941:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2942:          // The new algorithm should be faster since it is branchless.
 2943:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 2944:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2945: 
 2946:          shpCoords[0] = (shpCoords[0] + a)*b;
 2947:          shpCoords[1] = (shpCoords[1] + a)*b;
 2948:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2949: 
 2950:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2951:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 2952:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 2953: 
 2954:          // Update the point coordinates for the new shape coordinates
 2955:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2956:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2957: 
 2958:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2959: 
 2960:       }
 2961: 
 2962:       // Return true if the point is inside the element
 2963:       return res;      
 2964:    }
 2965:    else {
 2966:       assert(isQuad() && "computeShapeCoords");
 2967: 
 2968:       // Horizontal local node coordinates with respect to the original side.
 2969:       Point2 x0, x1, x2, x3;
 2970:       getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, origSideCenter, origSide->frame);
 2971: 
 2972:       const double a0 = signedArea(x0, x1, xt);
 2973:       const double a1 = signedArea(x1, x2, xt);
 2974:       const double a2 = signedArea(x2, x3, xt);
 2975:       const double a3 = signedArea(x3, x0, xt);
 2976: 
 2977:       const double minArea = min4(a0, a1, a2, a3);
 2978:       
 2979:       const bool res = (minArea > -small*area);
 2980: 
 2981:       // When to fix the negative shape coordinates?
 2982:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2983: 
 2984:       double xi, eta;    
 2985: 
 2986:       // Converts the point xt to the element frame coordinates and then to bilinear+shape coordinates.
 2987:       // Does nothing if ics == 1.
 2988:       assert(origSide != nullptr);
 2989:       Point2 xt_elem = toPoint2(toLocalFrame(origSide->toGlobal(toPoint3(xt, 0.0))));
 2990: 
 2991:       inverseBilinearQuad(xt_elem, xi, eta, shpCoords);
 2992: 
 2993:       if (fix) {
 2994:          double xn[4] = {x0.x, x1.x, x2.x, x3.x};
 2995:          double yn[4] = {x0.y, x1.y, x2.y, x3.y};
 2996:          xt.x = interpolate(shpCoords, xn);
 2997:          xt.y = interpolate(shpCoords, yn);
 2998:       }
 2999: 
 3000:       return res;
 3001:    }
 3002: 
 3003: 
 3004:    assert(false && "computeShapeCoords: should never reach this point");
 3005:    return false;  // Never reached
 3006: 
 3007: }
 3008: 
 3009: 
 3010: __device__ __forceinline__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 3011: // Convert shape coordinates to cartesian coordinates
 3012: 
 3013:    if (isTri()) {
 3014:       // Triangular element
 3015: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 3016:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 3017:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 3018:    }
 3019:    else {
 3020:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 3021:    }
 3022: 
 3023: }
 3024: 
 3025: 
 3026: 
 3027: __device__ __forceinline__ double Element::intPhiPhiTri(int i, int j) const {
 3028:    // return \int \phi_i*\phi_j dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3029:    
 3030:    return ((i == j) ? (2.0/12.0) : (1.0/12.0))*area;
 3031: }
 3032: 
 3033: __device__ __forceinline__ double Element::intGradPhiGradPhiTri(int i, int j) const {
 3034:    // return \int (grad phi_i).(grad phi_j) dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3035:    // gradPhi[i] is constant over a linear triangle, so the integral is area * dot(gradPhi[i], gradPhi[j]).
 3036:    assert(isTri() && i >= 0 && j >= 0 && i < 3 && j < 3);
 3037:    return area * dot(gradPhi[i], gradPhi[j]);
 3038: }
 3039: 
 3040: __device__ __forceinline__ double Element::intPhiPhiQuad(int i, int j, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3041:    // return \int \phi_i*\phi_j dA for quads, where phi_i and phi_j are the shape functions of the nodes i and j.
 3042:    // The integral can be computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 3043:    // The formula for the integral is:
 3044:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 3045:    
 3046:    const double xi_term  = 1.0 + (xi_n(i) * xi_n(j))/3.0;
 3047:    const double eta_term = 1.0 + (eta_n(i)*eta_n(j))/3.0;
 3048:    const double eta_sum  = eta_n(i) + eta_n(j);
 3049:    const double xi_sum   = xi_n(i)  + xi_n(j);
 3050: 
 3051:    const double detJ_xi  = detJ_xi_quad (x0, x1, x2, x3);  // XXXXX put the 8 inside the function??? xi derivative of the Jacobian determinant
 3052:    const double detJ_eta = detJ_eta_quad(x0, x1, x2, x3);  // eta derivative of the Jacobian determinant
 3053: 
 3054: 
 3055:    return (1.0/16.0)*area*xi_term*eta_term + (1.0/12.0)*(detJ_eta*xi_term*eta_sum + detJ_xi*eta_term*xi_sum);
 3056: }
 3057:    
 3058: 
 3059: __device__ __forceinline__ double Element::intGradPhiGradPhiQuad(int i1, int i2, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3060:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3061:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 3062:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 3063:    // The formula is also based on the identity:
 3064:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 3065:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 3066: 
 3067:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: bad ranges");
 3068: 
 3069: 
 3070: 
 3071:    double res = 0.0;
 3072:    
 3073:    // Quadrature points in xi and eta coordinates
 3074:    #pragma unroll
 3075:    for (int i = 0; i < 4; i++) {
 3076:       // For each quadrature point...
 3077: 
 3078:       const Point2 p = GaussPoint(i);  // Quadrature point in (eta,xi) coordinates
 3079:       const double eta = p.x;
 3080:       const double xi  = p.y;
 3081: 
 3082:       // Jacobian entries at the Gauss point p
 3083:       const double dx_dxi  = 0.25 * ( (x1.x + x2.x - x0.x - x3.x) + eta*(x0.x + x2.x - x1.x - x3.x) );
 3084:       const double dx_deta = 0.25 * ( (x2.x + x3.x - x0.x - x1.x) + xi *(x0.x + x2.x - x1.x - x3.x) );
 3085:       const double dy_dxi  = 0.25 * ( (x1.y + x2.y - x0.y - x3.y) + eta*(x0.y + x2.y - x1.y - x3.y) );
 3086:       const double dy_deta = 0.25 * ( (x2.y + x3.y - x0.y - x1.y) + xi *(x0.y + x2.y - x1.y - x3.y) );      
 3087: 
 3088:       const double detJ = detJ_quad(p, x0, x1, x2, x3);
 3089:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3090: 
 3091:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3092:       const double dPhi_dxi_1  = dPhi_dxi_quad (i1, p);
 3093:       const double dPhi_deta_1 = dPhi_deta_quad(i1, p);
 3094:       const double dPhi_dxi_2  = dPhi_dxi_quad (i2, p);
 3095:       const double dPhi_deta_2 = dPhi_deta_quad(i2, p);
 3096: 
 3097:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3098:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3099:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3100:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3101:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3102: 
 3103:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3104:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3105:    }
 3106: 
 3107:    return res;
 3108: }
 3109: 
 3110: 
 3111: /**  Interpolate velocities at a given point (xt,yt,zt)
 3112: 
 3113:    @param xt, yt, zt: coordinates of the point to interpolate
 3114:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3115: 
 3116:    This is done in four steps:
 3117: 
 3118:    1. Find the shape coordinates for the final position in the element.
 3119:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3120:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3121:       z levels at xt, yt at each step.   
 3122:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3123:       horizontally and vertically.
 3124: **/
 3125: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3126:    // Interpolate the velocities at the point xt. 
 3127:    // This function works the same for triangular and quadrilateral elements.
 3128:    double shpCoord[4];
 3129:    Vector3 u_int;
 3130: 
 3131: 
 3132:    // First step is to compute the shape coordinates of (xt,yt)
 3133: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3134:    computeShapeCoords(toVector2(xt), shpCoord, fiAnywhere, origSide);
 3135: 
 3136:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 3137: 
 3138:    // Second step is to find the level that contains zt
 3139:    // Uses a binary search to find the level
 3140:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3141:    // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3142:    int L = kb - 1; // In some cases, the bottom level of the element is 1 more than the bottom level of the node XXXX (Check)
 3143:    int R = nvrt - 1;
 3144: 
 3145:    // Get the z coordinates at the nodes of the element at the levels L and R
 3146:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3147:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3148:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3149: 
 3150: 
 3151:    double zL = interpolate(shpCoord, zLAtNodes);
 3152:    double zR = interpolate(shpCoord, zRAtNodes);
 3153: 
 3154:    // Interpolates vertically the velocities
 3155:    double wght1, wght2;
 3156:    if (xt.z <= zL) {
 3157:       wght1 = 1.0;
 3158:       wght2 = 0.0;
 3159:       xt.z = zL;
 3160:    }
 3161:    else if (xt.z >= zR) {
 3162:       wght1 = 0.0;
 3163:       wght2 = 1.0;
 3164:       xt.z = zR;
 3165:    }
 3166:    else {
 3167:       // Perform a binary search to find the levels between L and R that contain xt.z
 3168:       while (R - L > 1) {
 3169:          int M = (L + R) / 2.0;
 3170: 
 3171:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3172:          double zM = interpolate(shpCoord, zMAtNodes);
 3173:          if (zM < xt.z) 
 3174:          {
 3175:             L = M;
 3176:             zL = zM;
 3177:          }
 3178:          else 
 3179:          {
 3180:             R = M;
 3181:             zR = zM;
 3182:          }
 3183:       }
 3184:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3185:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3186: 
 3187:       wght2 = (xt.z - zL)/(zR - zL);
 3188:       wght1 = 1.0 - wght2;
 3189: 
 3190:    }
 3191: // printf("XXYYX element %d, L = %d, R = %d, zL = %.17f, zR = %.17f, xt.z = %.17f, wght1 = %.17f, wght2 = %.17f\n", idx, L, R, zL, zR, xt.z, wght1, wght2);
 3192: // printf("HEREEEEEE 3, wght1 = %.17f, wght2 = %.17f, shpCoord = (%.17f, %.17f, %.17f, %.17f)\n", wght1, wght2, shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 3193:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3194:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3195:    Vector2 uv = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3196:    double w   = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3197: 
 3198:    // Project the velocity from the local frame to the origSide frame
 3199:    if constexpr(ics == 2) uv = frame.projHorVec(uv, origSide->frame);
 3200:    u_int = {uv.x, uv.y, w};
 3201: 
 3202:    // Neither of the interpolated velocities should be NaN
 3203:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3204: 
 3205:    return u_int;
 3206: 
 3207: }
 3208: 
 3209: 
 3210: 
 3211: 
 3212: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3213: 
 3214:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3215:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3216:    const Node *n1 = side->n1;
 3217:    const Node *n2 = side->n2;
 3218: 
 3219:    bool n1_match = (n1->nodeBnd->segment == segment);
 3220:    bool n2_match = (n2->nodeBnd->segment == segment);
 3221: 
 3222:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3223:    if (n1_match && n2_match) {
 3224:       return 0.5;
 3225:    } else if (n1_match) {
 3226:       return 1.0;
 3227:    } else if (n2_match) {
 3228:       return 0.0;
 3229:    }
 3230: 
 3231:    return 0.0;
 3232: }
 3233: 
 3234: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3235: 
 3236: 
 3237: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 3238: 
 3239:    const double w1 = getBoundaryArrayValueWeight();
 3240:    const double w2 = 1.0 - w1;
 3241:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3242:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3243: 
 3244:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 3245: }
 3246: 
 3247: 
 3248: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 3249:    const double w1 = getBoundaryArrayValueWeight();
 3250:    const double w2 = 1.0 - w1;
 3251:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3252:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3253: 
 3254:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 3255: 
 3256: }
 3257: 
 3258: 
 3259: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 3260:    // Returns the value of the velocity at the side center
 3261:    const double w1 = getBoundaryArrayValueWeight();
 3262:    const double w2 = 1.0 - w1;
 3263:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3264:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3265: 
 3266:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 3267: }
 3268: 
 3269: 
 3270: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 3271:    // Returns the value of the normal component of the velocity at the side center
 3272:    const double w1 = getBoundaryArrayValueWeight();
 3273:    const double w2 = 1.0 - w1;
 3274:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3275:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3276: 
 3277:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 3278: }
 3279: 
 3280: 
 3281: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3282:    if constexpr(ics == 1) {
 3283:       return center;
 3284: 
 3285:    } else {
 3286:       const Point2 p0 = n1->outputCoords();
 3287:       const Point2 p1 = n2->outputCoords();
 3288:       return (1.0/2.0)*(p0 + p1);
 3289: 
 3290:    }
 3291: }
 3292: 
 3293: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3294: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3295: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3296: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3297: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3298: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3299: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3300: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3301: // Computes the gradient of the field at the side center.
 3302:    Vector2 grad = {0.0, 0.0};
 3303:    int count = 0;
 3304: 
 3305:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3306:    // as the average of the gradients at each element.
 3307:    // First element
 3308:    if (elems[0] != nullptr && condition(elems[0])) {
 3309:       Vector2 elemGrad = elems[0]->grad2(field);
 3310: 
 3311:       // For ics=2, projects the element gradient from its frame to the side frame
 3312:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3313: 
 3314:       grad += elemGrad;
 3315: 
 3316:       count++;
 3317:    }
 3318: 
 3319:    // Second element
 3320:    if (elems[1] != nullptr && condition(elems[1])) {
 3321: 
 3322:       Vector2 elemGrad = elems[1]->grad2(field);
 3323: 
 3324:       // For ics=2, projects the element gradient from its frame to the side frame
 3325:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3326: 
 3327:       grad += elemGrad;
 3328: 
 3329:       count++;
 3330:    }
 3331: 
 3332:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3333:    if (count > 0) {
 3334:       grad = grad*(1.0/count);
 3335:    }
 3336:    
 3337:    return grad;
 3338: }
 3339: 
 3340: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 3341: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 3342: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 3343: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 3344: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 3345: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 3346: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
