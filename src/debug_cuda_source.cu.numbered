 2216: 
 2217: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2218: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2219: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2220: // Only when ics == 2, the origin is at the element center.
 2221: 
 2222:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2223: 
 2224:    const Node *node = nodes[idxNode];
 2225: 
 2226:    if constexpr(ics==1) {
 2227:       return node->p;
 2228: 
 2229:    } else {
 2230:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2231: 
 2232:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2233: 
 2234:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2235:    }
 2236: 
 2237: }
 2238: 
 2239: 
 2240: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2241: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2242: 
 2243:    assert(isTri() && "getLocalHorizontalNodePositions only works for triangles");
 2244: 
 2245:    const int id1 = idx;
 2246:    const int id2 = nxq(1 + id1);
 2247:    const int id3 = nxq(2 + id1);
 2248: 
 2249:    if constexpr(ics==1) {
 2250:       x0 = nodes[id1]->p;
 2251:       x1 = nodes[id2]->p;
 2252:       x2 = nodes[id3]->p;
 2253: 
 2254:    } else {
 2255:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2256: 
 2257:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2258:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2259:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2260: 
 2261:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2262:       x1 = toVector2(frame.G2L(p1 - c));
 2263:       x2 = toVector2(frame.G2L(p2 - c));
 2264: 
 2265:    }
 2266: 
 2267: }
 2268: 
 2269: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const {
 2270: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2271: 
 2272:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2273: 
 2274:    if constexpr(ics==1) {
 2275:       x0 = nodes[0]->p;
 2276:       x1 = nodes[1]->p;
 2277:       x2 = nodes[2]->p;  
 2278:       x3 = nodes[3]->p;
 2279: 
 2280:    } else {
 2281:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2282: 
 2283:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2284:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2285:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2286:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2287: 
 2288:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2289:       x1 = toVector2(frame.G2L(p1 - c));
 2290:       x2 = toVector2(frame.G2L(p2 - c));
 2291:       x3 = toVector2(frame.G2L(p3 - c));
 2292:    }
 2293: 
 2294: }
 2295: 
 2296: 
 2297: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2298: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2299: // Returns the normal vector and the area of the element at this level
 2300: 
 2301:    double nx, ny, nz;
 2302: 
 2303:    if (isTri()) {
 2304:       // For triangles...
 2305: 
 2306:       // Indices of the nodes at level k, taking care of not going below the bed
 2307:       const int k0 = max(k, nodes[0]->kb);
 2308:       const int k1 = max(k, nodes[1]->kb);
 2309:       const int k2 = max(k, nodes[2]->kb);
 2310: 
 2311:       // Gets the element frame coordinates of the nodes at level k
 2312:       Point3 x0, x1, x2;
 2313:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2314:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2315:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2316:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2317: 
 2318:       } else {  // ics == 2
 2319:          Point2 h0, h1, h2;
 2320: 
 2321:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2322: 
 2323:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2324:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2325:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2326:       }
 2327: 
 2328:       const Vector3 n20 = x2 - x0;
 2329:       const Vector3 n10 = x1 - x0; 
 2330: 
 2331:       // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 2332:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2333:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2334:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2335:   
 2336:    }
 2337:    else {
 2338:       // For quads...
 2339:       Point2 h0, h1, h2, h3;
 2340: 
 2341:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2342: 
 2343:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2344:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2345:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k] - nodes[0]->z[k]);
 2346:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k] - nodes[1]->z[k]);
 2347: 
 2348:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2349:       nx = n20.y*n31.z - n20.z*n31.y;
 2350:       ny = n20.z*n31.x - n20.x*n31.z;
 2351:       nz = n20.x*n31.y - n20.y*n31.x;
 2352: 
 2353:    }
 2354: 
 2355:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2356:    area3D = 0.5*len;
 2357: 
 2358:    const double inv_len = 1.0/len;
 2359: 
 2360:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2361: 
 2362: }
 2363: 
 2364: /**
 2365:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 2366:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 2367:    If the segment is completely inside the element, then it returns true.
 2368: 
 2369:    This function assumes:
 2370:    - The initial point is on a side of the element. 
 2371:    - Its position is given by parameter t in the range [0,1].
 2372:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 2373:       intersects the element (elements are convex).
 2374: 
 2375:    To find the intersection point, this function does the following:
 2376:    - it finds the intersection of the line segment with all the element side lines,
 2377:       except for the one that contains the initial point.
 2378:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 2379:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 2380:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 2381:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 2382:       track segment is almost parallel to the element side line.
 2383: 
 2384:    Inputs:
 2385:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 2386:    @param x2, y2: other end of the line segment
 2387: 
 2388:    Outputs:
 2389:    @param side:  side that intersects the line segment (input and output)
 2390:    @param nextElement (output): element that contains the intersection point
 2391:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 2392:    @param zint (input/output): Vertical coordinate of the intersection point
 2393: 
 2394:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 2395:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 2396:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 2397: 
 2398:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 2399:    (Delta) being zero.
 2400: 
 2401:    The intersection2 point happens when:
 2402:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 2403:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 2404:    
 2405:    Assumption: the 4 points (including those of the side segment) are different.
 2406:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 2407:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 2408:    If true, (xIntersect,yIntersect) is the intersection.				
 2409:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 2410: **/
 2411: 
 2412: 
 2413: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 2414:                                               double &t, double& tIntersect, const Side *origSide) {
 2415:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa");
 2416: if (!containsPoint(x1, origSide)) printf("111: x1 = (%f, %f), origSide.center = (%f, %f)\n", x1.x, x1.y, origSide->center.x, origSide->center.y); 
 2417:    assert( containsPoint(x1, origSide) && "Starting point is not inside the element");                                    
 2418:    assert(!containsPoint(x2, origSide) && "Ending point is not outside the element");
 2419: 
 2420:    double closest_intersect_t = 1e10;
 2421:    bool found_intersection = false;
 2422: 
 2423:    for (int i = 0; i < i34; i++) {
 2424: 
 2425:       Side *side2 = sides[i];
 2426: 
 2427:       // (x3,y3)-(x4,y4) is the element side line
 2428:       const Point2 x3 = side2->n1->p;
 2429:       const Point2 x4 = side2->n2->p;
 2430: 
 2431:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 2432:       const double delta = cross(x2 - x1, x3 - x4);
 2433: 
 2434:       if (abs(delta) > 0) {
 2435: 
 2436:          const double delta1 = cross(x3 - x1, x3 - x4);
 2437:          const double delta2 = cross(x2 - x1, x3 - x1); 
 2438: 
 2439:          // Solves the two linear equations for tt1 and tt2
 2440:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2441:          const double tt2 = delta2/delta;
 2442: 
 2443:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 2444:             closest_intersect_t = min(closest_intersect_t, tt1);
 2445:             side = side2;
 2446:             nextElement = side->otherElem(this);
 2447:             t =          clamp(tt2, small, 1.0-small);
 2448:             tIntersect = clamp(tt1, small, 1.0-small);
 2449:             found_intersection = true;
 2450:          }
 2451: 
 2452:       
 2453:       }
 2454:       else {  // parallel segments
 2455: 
 2456:          continue; 
 2457:          assert(false && "Parallel segments should not happen under the new code");
 2458:          // In this case, we check if they are colinear. if they are, we compute the intersection point as:
 2459:          // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 2460: 
 2461:          // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 2462:          const double dist = dot(x1 - x3, side2->n);
 2463:          if (abs(dist) < small*length(x3 - x4)) {
 2464:             const double2 unitarySide = normalize(x4 - x3);
 2465:             const double len = dot(x2 - x1, unitarySide);
 2466:             t = t + len;
 2467:             t = max(0.0, min(t, 1.0));
 2468:             printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 2469: 
 2470: 
 2471:             // tIntersect = max(small, min(tt1, 1.0-small));
 2472:             // t = tt2;
 2473:             found_intersection = true;
 2474:          }
 2475:       }
 2476: 
 2477: 
 2478:    }
 2479: 
 2480:    if (!found_intersection) {if (idx == 15876) printf("11111: No intersection found\n"); return false;}
 2481:    assert(found_intersection && "No intersection found");
 2482: 
 2483:    // found_intersection should always be true, since we checked all the sides.  
 2484:    return found_intersection;
 2485: }
 2486: 
 2487: __inline__ __device__ bool Element::containsPoint(Vector2 xt, const Side *origSide) const { 
 2488:    // Check if the point (xt,yt) is inside the element.
 2489:    // if ics==2, origSide is used to convert the point to the starting point's frame.
 2490:    assert((ics==2 || origSide==nullptr) && "origSide must be nullptr if ics == 1 and vice versa");
 2491: 
 2492:    double shpCoords[4];
 2493:    bool res = computeShapeCoords(xt, shpCoords, fiNo, origSide);
 2494: 
 2495:    return res;
 2496: }
 2497: 
 2498: __inline__ __device__ bool Element::containsPoint(Vector2 &xt, bool fixCoords, const Side *origSide) const { 
 2499:    // Check if the point (xt,yt) is inside the element.
 2500:    // If fixCoords is true, and *the point is inside the element*, the point is nudged to be inside the element.
 2501:    // if ics==2, origSide is used to convert the point to the starting point's frame.
 2502:    assert((ics==2 || origSide==nullptr) && "origSide must be nullptr if ics == 1 and vice versa");
 2503: 
 2504:    double shpCoords[4];
 2505:    Vector2 tmp_xt = xt;
 2506:    const EFixIf fixIfCoords = fixCoords ? fiOnlyInside : fiNo;
 2507:    bool res = computeShapeCoords(tmp_xt, shpCoords, fixIfCoords, origSide);
 2508: 
 2509:    if (fixCoords && res) xt = tmp_xt;
 2510: 
 2511:    return res;
 2512: }
 2513: 
 2514: 
 2515: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 2516:                                              Point3 &xt, double zint, Vector3 &u_int) {
 2517: 
 2518:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 2519:    // Instead, we nudge the intersection point to the barycenter of the current element, and nextElement becomes
 2520:    // curElement.
 2521: 
 2522:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 2523:    // And uses this velocity instead to continue the tracking.
 2524: 
 2525:    // computes the intersection point in cartesian coordinates
 2526:    Point2 intersection = nextSide->p2_t(tt);  // XXXX I don't think this is necessary. THE intersection is already computed in findNextIntersection.
 2527: 
 2528:    // Nudges the point to the barycenter of the element. 
 2529:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 2530:    // next segment intersects the element sides. 
 2531:    // TODO: curElem->nudgeToBarycenter(intersection);  REMEMBER!!! RECOVER??? XXX KKKKK
 2532: 
 2533: 
 2534:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 2535:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 2536:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 2537:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 2538: 
 2539:    // If the side is an open boundary, the tangential velocity is set to zero.
 2540:    if (nextSide->isBnd()) vtan = 0.0;
 2541: 
 2542:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 2543:    const double us = vtan*nextSide->t().x;
 2544:    const double vs = vtan*nextSide->t().y;
 2545:    const double ws = nextSide->w2(jlev); 
 2546: 
 2547:    u_int = {us, vs, ws};
 2548: 
 2549:    // The end of this tracking segment is now the intersection point.
 2550:    xt = {intersection.x, intersection.y, zint};
 2551:    
 2552: }
 2553: 
 2554: /**
 2555:  * Tracks a particle through elements and vertical levels in the mesh.
 2556:  * 
 2557:  * @param x0,y0,z0     Starting position coordinates
 2558:  * @param xt,yt,zt     Target position coordinates
 2559:  * @param dtb          Time step for tracking
 2560:  * @param u_int        Initial velocity components
 2561:  * @param nextElem     Starting/resulting element index
 2562:  * 
 2563:  * @return Status code of type trackExitCodes
 2564:  * 
 2565:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2566:  * of the details are different. The idea is that the code requires less branches and is better fit
 2567:  * for GPU execution.
 2568:  * 
 2569:  * The main ideas here are:
 2570:  * - The starting point is expected to be in the starting element.
 2571:  * - since the starting point is inside the element, there are only two cases: 
 2572:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2573:  *     (b) it does not and (xt,yt) is already in the starting element.
 2574:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2575:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2576:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2577:  * - tt1 can be positive or negative. We only consider the positive values.
 2578:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2579:  * - The next intersection will occur at the smallest positive tt1.
 2580:  * - This intersection will be the next (x0,y0) position.
 2581:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2582:  *   of getting stuck in a loop.
 2583:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2584:  *   was found.
 2585:  * - Notice that curElement is the current element, while this is the element for which the first call to this function was made.
 2586:  */
 2587: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2588:                                                        Element *&nextElem, int &jlev, double &dt, double time_rm,
 2589:                                                        const Side *origSide) {
 2590:                                                             
 2591:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2592:    // else to do. This means that the full step occurred within the current element.
 2593:    assert(!isDry && "Starting element is dry");
 2594:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa");
 2595: Vector2 x0_tmp = toVector2(x0);
 2596: if (!containsPoint(toPoint2(x0), origSide)) {if (idx == 15876) printf("1111: elem->idx = %d, origSide->idx = %d, x0_tmp = (%f, %f), x0 = (%f, %f), origSide.center = (%f, %f)\n", idx, origSide->idx, x0_tmp.x, x0_tmp.y, x0.x, x0.y, origSide->center.x, origSide->center.y); return false;}
 2597: 
 2598:    assert(containsPoint(toPoint2(x0), origSide) && "Starting point is not inside the element");
 2599: 
 2600:    if (containsPoint(toPoint2(xt), true, origSide)) {  // The "true" means that, if the point is very close to the boundary, it is nudged to be definitely inside the element.
 2601: 
 2602:       assert(containsPoint(toPoint2(xt), origSide) && "Target point is not inside the element");
 2603:       assert(!isDry && "Target point is inside a dry element");
 2604: 
 2605:       u_int = interpolateVelocities(xt, origSide);
 2606: 
 2607:       nextElem = this;
 2608: 
 2609:       return true;
 2610:    }
 2611: 
 2612: 
 2613:    
 2614: 
 2615:    assert(norm2(toVector2(xt - x0)) > 0.0 && "Zero length track"); 
 2616:    
 2617:    double t;
 2618:    Side *nextSide = nullptr;
 2619:    double tIntersect = 1e10;
 2620: 
 2621: 
 2622:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2623:    // (x0,y0) is inside the element but the target point is not.
 2624:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect, origSide);
 2625: if (!found_intersection) {if (idx == 15876) printf("111112: No intersection found\n"); return false;}
 2626:    assert(found_intersection && "No intersection found at %d");
 2627: 
 2628:    Point2 xtmp = toPoint2(toLocalFrame(nextSide->p3_t(t), origSide)); // If needed, moves the target point to the intersection point
 2629: 
 2630:    // If the next element is not dry, nudge it to the barycenter to ensure that the point is inside the element.
 2631:    if (nextElem != nullptr && !nextElem->isDry) {
 2632:       assert(nextElem->containsPoint(xtmp, origSide) && "Intersection point is not inside the next element");
 2633:       nextElem->nudgeToBarycenter(xtmp, origSide);
 2634:    }
 2635: 
 2636:    const double zint = (1 - tIntersect)*x0.z + tIntersect*xt.z;
 2637:    xt = {xtmp.x, xtmp.y, zint};
 2638: 
 2639:    // if the tracking segment goes out of water (either dry or edge boundary)
 2640:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2641: 
 2642: 
 2643:       trackGoesOutOfWater(nextSide, this, t, jlev, xt, zint, u_int);
 2644: 
 2645:       assert(this->containsPoint(toPoint2(xt), origSide) && "Target point is not inside the current element");
 2646:       // When this happens, the backtracking stops.
 2647: 
 2648:       dt *= tIntersect;
 2649: 
 2650:       // In this case, the next element is again the current element.
 2651:       nextElem = this;
 2652: 
 2653: // printf("trackGoesOutOfWater: side->idx = %d, dt = %.17f, time_rm = %.17f, u_int = (%.17f, %.17f, %.17f)\n", nextSide->idx, dt, time_rm, u_int.x, u_int.y, u_int.z);
 2654: 
 2655:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2656:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2657:       return true;    
 2658:    }
 2659: 
 2660: 
 2661:    assert(nextElem->containsPoint(toPoint2(xt), origSide) && "Target point is not inside the next element");
 2662:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2663:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2664: 
 2665:    
 2666:    dt *= tIntersect; // reduces the time step to the time it takes to reach the intersection
 2667: 
 2668:    u_int = nextElem->interpolateVelocities(xt, origSide); 
 2669: 
 2670:    assert(nextElem != this && "Next element is the same as the current element");
 2671: 
 2672:    return true;
 2673: }
 2674: 
 2675: 
 2676: __inline__ __device__ double Element::computeSignedArea(void) const {
 2677:    // Compute the area of the element
 2678: 
 2679:    Point2 x0, x1, x2, x3;
 2680:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2681: 
 2682:    double res = signedArea(x0, x1, x2);
 2683: 
 2684:    // In the quad case we need to add the area of the other triangle.
 2685:    if (isQuad()) {
 2686:       x3 = getLocalHorizontalNodePosition(3);
 2687:       double ar1 = signedArea(x0, x2, x3);
 2688:       double ar2 = signedArea(x0, x1, x3);
 2689:       double ar3 = signedArea(x1, x2, x3);
 2690:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2691: 
 2692:       res += ar1 + ar2 + ar3;
 2693:    }
 2694: 
 2695:    return res;
 2696: }
 2697: 
 2698: 
 2699: __inline__ __device__ void Element::nudgeToBarycenter(Point2 &p, const Side *origSide) const {
 2700: // Nudges the point (x,y) to the barycenter of the element
 2701: 
 2702:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa");
 2703: 
 2704:    Point3 c = toLocalFrame(toPoint3(center, centerZ()), origSide); // In local frame coordinates if ics == 2
 2705: 
 2706:    p = (1.0 - btrack_nudge)*p + btrack_nudge*toPoint2(c);
 2707: }
 2708: 
 2709: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2710:                                                                 (nodes[1]->isDry2()) ||
 2711:                                                                 (nodes[2]->isDry2()) ||
 2712:                                                                 (i34==4 && nodes[3]->isDry2());
 2713: }
 2714: 
 2715: __inline__ __device__ double Element::detJ_eta(void) const {
 2716:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2717:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2718: }
 2719: 
 2720: __inline__ __device__ double Element::detJ_xi(void) const {
 2721:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2722:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2723: }
 2724: 
 2725: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2726:    // In boundary sides, the element 1 is nullptr
 2727:    return side->elems[1] == nullptr; 
 2728: }
 2729: 
 2730: __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const {
 2731:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 2732:    // For ics == 2, this function uses local frame coordinates.
 2733: 
 2734:    assert(isQuad());
 2735: 
 2736:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 2737:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 2738:    // where vxi, veta, vb are vectors and c is the center of the element.
 2739: 
 2740:    Point2 p0, p1, p2, p3;
 2741: 
 2742:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 2743: 
 2744:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 2745:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 2746:    // vectors vxi and veta connect the centers of opposite sides
 2747:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 2748:    // vb is zero for parallelogram elements.
 2749:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 2750: 
 2751:    //  The bilinear mapping is:
 2752:    //      P(s,t) = C + s*U + t*V + s*t*W
 2753:    //
 2754:    //  where:
 2755:    //    C = centroid (average of four vertices)
 2756:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 2757:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 2758:    //    W = bilinear correction; measures deviation from parallelogram
 2759:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 2760:    //        W = 0 for parallelogram elements.
 2761:    //
 2762:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 2763:    //
 2764:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 2765:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 2766:    //
 2767:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 2768:    //
 2769:    //  Geometrically, (L) projects everything onto the direction
 2770:    //  perpendicular to W, where the mapping is purely affine.
 2771:    //
 2772:    //  The dot product with nb retains the nonlinear term:
 2773:    //
 2774:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 2775:    //
 2776:    //  Geometrically, (Q) projects onto the W direction, where
 2777:    //  the nonlinearity lives.
 2778:    //
 2779:    //  We solve (L) for whichever variable has the larger coefficient
 2780:    //  (better conditioned back-substitution), substitute into (Q),
 2781:    //  and get a scalar quadratic in the other variable.
 2782:    // ================================================================
 2783: 
 2784:    // ---- Basis vectors ----
 2785:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 2786:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 2787:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 2788:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 2789:    // W: nonlinear correction. Difference between quad and parallelogram.
 2790:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 2791:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 2792: 
 2793:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 2794:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 2795:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 2796:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 2797:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 2798: 
 2799:    // ---- nb: direction parallel to W, L1-normalized ----
 2800:    // We don't need a unit vector -- just a well-scaled direction parallel
 2801:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 2802:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 2803:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 2804:    //
 2805:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 2806:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 2807:    // and the quadratic solver takes its linear path (a ~ 0).
 2808:    const double wlen1 = fabs(vb.x) + fabs(vb.y) + 1e-30;
 2809:    const double inv_wlen = 1.0 / wlen1;
 2810:    const Vector2 nb = vb * inv_wlen;
 2811: 
 2812:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 2813:    // cross(nb, ·) projects onto the direction PERPENDICULAR to W.
 2814:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 2815:    // What remains is a pure affine relationship between xi and eta.
 2816:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 2817:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 2818:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 2819: 
 2820:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 2821:    // dot(nb, ·) projects onto the W direction, where the nonlinearity lives.
 2822:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 2823:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 2824:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 2825:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 2826:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 2827: 
 2828:    // ---- Solve: pick the better-conditioned variable from (L) ----
 2829:    // Back-substitute from (L) dividing by the LARGER coefficient,
 2830:    // minimizing round-off amplification.
 2831:    //
 2832:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 2833:    // that uses predicated moves.
 2834:    //
 2835:    // if (fabs(Ls) > fabs(Lt)) {
 2836:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 2837:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 2838:    //    // Substitute into (Q), multiply by Ls, group by eta:
 2839:    //    const double A = -Qw * Lt;
 2840:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 2841:    //    const double C =  Qs * Lp - Qp * Ls;
 2842: 
 2843:    //    double eta1, eta2;
 2844:    //    solveQuadratic(A, B, C, eta1, eta2);
 2845: 
 2846:    //    // Pick root with smaller |eta| (domain centered at 0).
 2847:    //    // Ternary-> predicated move, no branch divergence.
 2848:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 2849: 
 2850:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 2851:    //    xi = (Lp - Lt * eta) / Ls;
 2852: 
 2853:    // } else {
 2854:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 2855:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 2856:    //    // Substitute into (Q), multiply by Lt, group by xi:
 2857:    //    const double A = -Qw * Ls;
 2858:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 2859:    //    const double C =  Qt * Lp - Qp * Lt;
 2860: 
 2861:    //    double xi1, xi2;
 2862:    //    solveQuadratic(A, B, C, xi1, xi2);
 2863: 
 2864:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 2865: 
 2866:    //    eta = (Lp - Ls * xi) / Lt;
 2867:    // }
 2868:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 2869:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 2870:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 2871:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 2872:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 2873: 
 2874:    // Quadratic:  A*r^2 + B*r + C = 0
 2875:    // (same formula for both cases, just with swapped coefficients)
 2876:    const double A = -Qw * Lb;
 2877:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 2878:    const double C =  Qa * Lp - Qp * La;
 2879: 
 2880:    double r1, r2;
 2881:    solveQuadratic(A, B, C, r1, r2);
 2882: 
 2883:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 2884:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 2885: 
 2886:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 2887:    const double other = (Lp - Lb * r) / La;
 2888: 
 2889:    // Assign to (xi, eta) depending on which variable the quadratic solved
 2890:    xi  = solve_s ? r     : other;
 2891:    eta = solve_s ? other : r;
 2892: 
 2893: 
 2894:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 2895:    xi  = fmin(1.0, fmax(xi,  -1.0));
 2896:    eta = fmin(1.0, fmax(eta, -1.0));
 2897: 
 2898:    // ---- Shape functions ----
 2899:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 2900:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 2901:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 2902:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 2903:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 2904:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 2905:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 2906:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 2907: 
 2908:    return true;
 2909: }
 2910: 
 2911: /**
 2912:    Compute the shape coordinates of the point (xt,yt) in the element.
 2913:    @param xt (input): x-coordinate of the point
 2914:    @param shpCoords (output): shape coordinates of the point
 2915:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2916:    @return true if the point is inside the element, false otherwise
 2917: **/
 2918: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 2919: 
 2920:    // Compute the shape coordinates of the point xt in the element.
 2921:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 2922:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 2923:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 2924:    // from the local frame, so use additional check.
 2925: 
 2926:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa");
 2927: 
 2928:    if (isTri()) { // Triangular element
 2929: 
 2930:       // Horizontal local node coordinates. 
 2931:       Point2 x0 = nodes[0]->p;
 2932:       Point2 x1 = nodes[1]->p;
 2933:       Point2 x2 = nodes[2]->p;
 2934: 
 2935:       // If ics == 2, the node coordinates are transformed to local frame.
 2936:       if constexpr(ics==2) {
 2937:          const Point3 p0 = toPoint3(x0, nodes[0]->gz);
 2938:          const Point3 p1 = toPoint3(x1, nodes[1]->gz);
 2939:          const Point3 p2 = toPoint3(x2, nodes[2]->gz);
 2940: 
 2941:          // Coordinates of the center of the original side
 2942:          const Point3 c = {origSide->center.x, origSide->center.y, origSide->centerZ()}; 
 2943: 
 2944:          // Convert the node coordinates to the local frame centered at the element center
 2945:          x0 = toVector2(origSide->frame.G2L(p0 - c));
 2946:          x1 = toVector2(origSide->frame.G2L(p1 - c));
 2947:          x2 = toVector2(origSide->frame.G2L(p2 - c));
 2948:       }
 2949: 
 2950:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2951:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2952:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2953:       shpCoords[3] = 0.0;
 2954: 
 2955: 
 2956:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2957:       const bool res = (tmpmin >= -small);  
 2958:       
 2959:       // If the point is not inside the element (with a small tolerance), we do not need to fix the negative shape coordinates.
 2960:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2961: 
 2962:       
 2963:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2964:       // then we fix the negative shape coordinates.
 2965:       if ((tmpmin < 0) && fix) {
 2966: 
 2967:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2968:          // keeping the sum of the shape coordinates equal to 1.
 2969:          // I have tested and compared the new algorithm with the old one, and they give
 2970:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2971:          // The new algorithm should be faster since it is branchless.
 2972:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 2973:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2974:          
 2975:          shpCoords[0] = (shpCoords[0] + a)*b;
 2976:          shpCoords[1] = (shpCoords[1] + a)*b;
 2977:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2978: 
 2979:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2980:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 2981:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 2982: 
 2983:          // Update the point coordinates for the new shape coordinates
 2984:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2985:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2986:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2987: 
 2988:       }
 2989: 
 2990:       // Check if the point is inside the element
 2991:       return res;      
 2992:    }
 2993:    else {
 2994:       assert(isQuad() && "computeShapeCoords");
 2995: 
 2996:    //    Point2 p = xt;
 2997: 
 2998:    //    // Reproject p the original side frame for ics=2
 2999:    //    if constexpr(ics == 2) p = origSide->frame.G2L(toPoint3(xt, 0.0));
 3000: 
 3001:    //    bool inside = false;
 3002: 
 3003: 
 3004: 
 3005:    //    if(ifl==0) then
 3006:    //      do i=1,4
 3007:    //        in1=nxq(1,i,i34(ie))
 3008:    //        in2=nxq(2,i,i34(ie))
 3009:    //        swild2(i)=signa2(xel(in1,ie),xel(in2,ie),x,yel(in1,ie),yel(in2,ie),y)
 3010:    //      enddo !i
 3011:    //      tmp=minval(swild2(1:4))/area(ie)
 3012:    //      if(tmp>-small2) then
 3013:    //        inside=1
 3014:    //        call ibilinear(itag,ie,area(ie),xel(1,ie),xel(2,ie),xel(3,ie),xel(4,ie), &
 3015:    //   &yel(1,ie),yel(2,ie),yel(3,ie),yel(4,ie),x,y,xi,eta,shapef,icaseno)
 3016:    //      endif !inside quad
 3017:    //    else !ifl=1 - already inside
 3018:    //      call ibilinear(itag,ie,area(ie),xel(1,ie),xel(2,ie),xel(3,ie),xel(4,ie), &
 3019:    //   &yel(1,ie),yel(2,ie),yel(3,ie),yel(4,ie),x,y,xi,eta,shapef,icaseno)
 3020:    //      !Update pt
 3021:    //      x=dot_product(xel(1:4,ie),shapef(1:4))
 3022:    //      y=dot_product(yel(1:4,ie),shapef(1:4))
 3023:    //    endif !ifl
 3024: 
 3025: 
 3026:    //    return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 3027: 
 3028:    }
 3029: 
 3030:    assert(false && "computeShapeCoords: should never reach this point");
 3031:    return false;  // Never reached
 3032: 
 3033: }
 3034: 
 3035: 
 3036: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 3037: // Convert shape coordinates to cartesian coordinates
 3038: 
 3039:    if (isTri()) {
 3040:       // Triangular element
 3041: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 3042:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 3043:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 3044:    }
 3045:    else {
 3046:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 3047:    }
 3048: 
 3049: }
 3050: 
 3051: __device__ double Element::intPhiPhiQuad(int i1, int i2) const {
 3052:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3053:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 3054:    // The formula for the integral is:
 3055:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 3056: 
 3057:    printf("intPhiPhi: TEST\n");
 3058: 
 3059:    const Node *n0 = nodes[0];
 3060:    const Node *n1 = nodes[1];
 3061:    const Node *n2 = nodes[2];
 3062:    const Node *n3 = nodes[3];
 3063: 
 3064:    const Vector2 p0 = n0->p;
 3065:    const Vector2 p1 = n1->p;
 3066:    const Vector2 p2 = n2->p;
 3067:    const Vector2 p3 = n3->p;
 3068: assert(false && "intPhiPhiQuad:CHECK?");
 3069: 
 3070:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 3071:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 3072:    double eta_sum  = iet_n[i1] + iet_n[i2];
 3073:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 3074: 
 3075:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 3076: }
 3077:    
 3078: 
 3079: __device__ double Element::intGradPhiGradPhiQuad(int i1, int i2) const {
 3080:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3081:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 3082:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 3083:    // The formula is also based on the identity:
 3084:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 3085:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 3086: 
 3087:    printf("intGradPhiGradPhi: TEST\n");   
 3088: assert(false && "intGradPhiGradPhi:Do ICS==2");
 3089:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 3090: 
 3091:    const double x0 = nodes[0]->p.x;
 3092:    const double y0 = nodes[0]->p.y;
 3093:    const double x1 = nodes[1]->p.x;
 3094:    const double y1 = nodes[1]->p.y;
 3095:    const double x2 = nodes[2]->p.x;
 3096:    const double y2 = nodes[2]->p.y;
 3097:    const double x3 = nodes[3]->p.x;
 3098:    const double y3 = nodes[3]->p.y;
 3099: 
 3100:    double res = 0.0;
 3101:    
 3102:    // Quadrature points in xi and eta coordinates
 3103:    #pragma unroll
 3104:    for (int i = 0; i < 4; i++) {
 3105:       // For each quadrature point...
 3106: 
 3107:       const Point2 p = GaussPoint(i);
 3108:       const double eta = p.x;
 3109:       const double xi  = p.y;
 3110: 
 3111:       // Jacobian entries at the Gauss point p
 3112:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 3113:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 3114:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 3115:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 3116: 
 3117:       const double detJ = jacobianDet(p);
 3118:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3119: 
 3120:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3121:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 3122:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 3123:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 3124:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 3125: 
 3126:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3127:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3128:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3129:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3130:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3131: 
 3132:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3133:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3134:    }
 3135: 
 3136:    return res;
 3137: }
 3138: 
 3139: 
 3140: /**  Interpolate velocities at a given point (xt,yt,zt)
 3141: 
 3142:    @param xt, yt, zt: coordinates of the point to interpolate
 3143:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3144: 
 3145:    This is done in four steps:
 3146: 
 3147:    1. Find the shape coordinates for the final position in the element.
 3148:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3149:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3150:       z levels at xt, yt at each step.   
 3151:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3152:       horizontally and vertically.
 3153: **/
 3154: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3155:    // Interpolate the velocities at the point xt. 
 3156:    // This function works the same for triangular and quadrilateral elements.
 3157:    double shpCoord[4];
 3158:    Vector3 u_int;
 3159: 
 3160:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa");
 3161: 
 3162:    // First step is to compute the shape coordinates of (xt,yt)
 3163: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3164:    computeShapeCoords(toVector2(xt), shpCoord, fiOnlyInside, origSide);
 3165: 
 3166:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 3167: 
 3168:    // Second step is to find the level that contains zt
 3169:    // Uses a binary search to find the level
 3170:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3171:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3172:    int R = nvrt - 1;
 3173: 
 3174:    // Get the z coordinates at the nodes of the element at the levels L and R
 3175:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3176:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3177:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3178: 
 3179:    double zL = interpolate(shpCoord, zLAtNodes);
 3180:    double zR = interpolate(shpCoord, zRAtNodes);
 3181:    
 3182:    // Interpolates vertically the velocities
 3183:    double wght1, wght2;
 3184:    if (xt.z<=zL) {
 3185:       wght1 = 1.0;
 3186:       wght2 = 0.0;
 3187:       xt.z = zL;
 3188:    }
 3189:    else if (xt.z>=zR) {
 3190:       wght1 = 0.0;
 3191:       wght2 = 1.0;
 3192:       xt.z = zR;
 3193:    }
 3194:    else {
 3195:       // Perform a binary search to find the levels between L and R that contain xt.z
 3196:       while (R - L > 1) {
 3197:          int M = (L + R) / 2.0;
 3198: 
 3199:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3200:          double zM = interpolate(shpCoord, zMAtNodes);
 3201:          if (zM < xt.z) 
 3202:          {
 3203:             L = M;
 3204:             zL = zM;
 3205:          }
 3206:          else 
 3207:          {
 3208:             R = M;
 3209:             zR = zM;
 3210:          }
 3211:       }
 3212:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3213:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3214: 
 3215:       wght2 = (xt.z - zL)/(zR - zL);
 3216:       wght1 = 1.0 - wght2;
 3217: 
 3218:    }
 3219: 
 3220: 
 3221:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3222:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3223:    toVector2(u_int) = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3224:    u_int.z          = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3225: 
 3226:    // Neither of the interpolated velocities should be NaN
 3227:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3228: 
 3229:    return u_int;
 3230: 
 3231: }
 3232: 
 3233: 
 3234: 
 3235: 
 3236: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3237: 
 3238:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3239:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3240:    const Node *n1 = side->n1;
 3241:    const Node *n2 = side->n2;
 3242: 
 3243:    bool n1_match = (n1->nodeBnd->segment == segment);
 3244:    bool n2_match = (n2->nodeBnd->segment == segment);
 3245: 
 3246:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3247:    if (n1_match && n2_match) {
 3248:       return 0.5;
 3249:    } else if (n1_match) {
 3250:       return 1.0;
 3251:    } else if (n2_match) {
 3252:       return 0.0;
 3253:    }
 3254: 
 3255:    return 0.0;
 3256: }
 3257: 
 3258: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3259: 
 3260: 
 3261: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 3262: 
 3263:    const double w1 = getBoundaryArrayValueWeight();
 3264:    const double w2 = 1.0 - w1;
 3265:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3266:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3267: 
 3268:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 3269: }
 3270: 
 3271: 
 3272: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 3273:    const double w1 = getBoundaryArrayValueWeight();
 3274:    const double w2 = 1.0 - w1;
 3275:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3276:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3277: 
 3278:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 3279: 
 3280: }
 3281: 
 3282: 
 3283: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 3284:    // Returns the value of the velocity at the side center
 3285:    const double w1 = getBoundaryArrayValueWeight();
 3286:    const double w2 = 1.0 - w1;
 3287:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3288:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3289: 
 3290:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 3291: }
 3292: 
 3293: 
 3294: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 3295:    // Returns the value of the normal component of the velocity at the side center
 3296:    const double w1 = getBoundaryArrayValueWeight();
 3297:    const double w2 = 1.0 - w1;
 3298:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3299:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3300: 
 3301:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 3302: }
