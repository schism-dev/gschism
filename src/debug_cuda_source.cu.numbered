 1722: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000) {
 1723:    return;
 1724:    // Lock the mutex
 1725:    lock(&debugPlotMutex);
 1726:  
 1727:    bool ok = true;
 1728:    if (debugPlotIdx == nullptr) ok = false;
 1729:    if (*debugPlotIdx >= 10000) ok = false;
 1730:    if (ok) {
 1731:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1732:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1733:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1734:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1735:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1736:       (*debugPlotIdx)++;
 1737:    }
 1738: 
 1739:    __threadfence();               // ensure all above writes are visible
 1740:    // Unlock the mutex
 1741:    unlock(&debugPlotMutex);
 1742: 
 1743: }
