 7119: #ifdef DONTCOMPILE
 7120: __device__ void computeVerticalAdvection(void) {
 7121:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 7122: 
 7123:    sdbt(1:2,:,:)=0.d0
 7124: 
 7125:    const Side *side = FROM kernel;
 7126: 
 7127:    if(side->isDry) return;
 7128: 
 7129:    // If side is wet...
 7130: 
 7131: 
 7132:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 7133:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 7134:    double ws[nvrt] = {} // w @ side
 7135:    int icount = 0;
 7136:    for (int j=0; j<2; j++) {
 7137:       const Element *elem = side->elements[j];
 7138:        
 7139:       if(elem != nullptr) {
 7140:          icount++;
 7141:          for (int k=0; k<nvrt; k++) {
 7142:             ws[k] = ws[k] + elem->w[k];
 7143:          }
 7144:       }
 7145:    }  // for j
 7146: 
 7147:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 7148:    ws = ws/icount;
 7149: 
 7150:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 7151:    // Splines allow for a smooth transition between vertical levels.
 7152:    // Splines have continuity restrictions at the internal knots, but
 7153:    // we have to provide the 1st derivatives at the endpoints.
 7154:    const int kbs = side->kbs; 
 7155:    
 7156:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7157:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7158:    initCubicSpline(kbs, nvrt, side, ws, up)
 7159: 
 7160:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7161:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7162:    initCubicSpline(kbs, nvrt, side, ws, vp)
 7163: 
 7164:    // Total advection (average onto side)
 7165:    const Node *node1 = side->nodes[0];
 7166:    const Node *node2 = side->nodes[1];
 7167:    for (int k=kbs(i); k<nvrt; k++) {
 7168: 
 7169:       if constexpr(ics==1) {
 7170:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 7171:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 7172:       } else {
 7173:          // XXX IMPLEMENT THIS
 7174:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 7175:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 7176:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 7177:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 7178:       }  // if ics
 7179: 
 7180: 
 7181:    }
 7182: }
 7183: #endif
 7184: 
 7185: 
 7186: extern "C" {
 7187:    __global__ void computeElemAverageGhat(void) {
 7188:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 7189: 
 7190:       ELEM(elem);
 7191:       
 7192:       elem->ghat1= {0.0, 0.0};  
 7193: 
 7194:       if constexpr(ihydraulics != 0) {
 7195:          if (nhtblocks > 0 && elem->isblock) return;
 7196:       }
 7197: 
 7198:       if (elem->isDry) return;
 7199: 
 7200:       // Wet elements.
 7201:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 7202:       // tidal potential, horizontal diffusion, and baroclinic etc
 7203:       // Remember to update both fb and F 
 7204:       // If ics=2, ghat1 are in eframe (ll)
 7205:       // cff1-3: coefficients for 2D/3D
 7206:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7207:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7208:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 7209: 
 7210:       double av_cff1 = 0.0;  // av. for cff1
 7211:       double av_cff2 = 0.0;  // av. for cff2
 7212:       double av_cff3 = 0.0;  // av. for cff3
 7213:       double av_df = 0.0;  // av. for H^\alpha / H
 7214:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7215:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7216: 
 7217:       const int i34 = elem->i34;
 7218:       const int kb = elem->kb;
 7219: 
 7220:       for (int j=0; j<i34; j++) {
 7221:          // For each node and side in the element...
 7222: 
 7223:          const Node *node = elem->nodes[j];
 7224:          const Side *side = elem->sides[j];
 7225: 
 7226:          const double chi      = side->chi;
 7227:          const double veg_c2   = side->veg_c2;
 7228:          const double veg_beta = side->veg_beta;
 7229:          const double veg_h    = side->veg_h();
 7230:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7231: 
 7232:          // Node - const in elem
 7233:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 7234:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 7235: 
 7236:          if (elem->depth >= tip_dp) {
 7237:            elem->gradETP += node->ETP*elem->gradPhi[j];
 7238:          }
 7239: 
 7240:          
 7241:          const double htot  = side->htot2();        // Total depth at the side
 7242:          const double zctr2 = side->zTopCanopy();  
 7243: 
 7244:          double cff1; 
 7245:          double cff2; 
 7246:          double cff3;   
 7247:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7248:          // coefficients applied to 2D/3D case 
 7249:             cff1 = side->hhat/htot;
 7250:             cff2 = 0.0;
 7251:             cff3 = 0.0;
 7252:          } else { //3D
 7253:             //Init for no-veg case
 7254:             cff1 = 1.0;
 7255:             cff2 = 1.0;
 7256:             cff3 = 0.0;
 7257: 
 7258:             if constexpr(iveg != 0) {
 7259:                // Computes coefficients used with vegetation terms G1, G2
 7260:                // cff1, cff3 are used for the first two terms in G1, G2:
 7261:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7262:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7263:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7264:                if(veg_h < 0.99*htot) { // submergent vegetation
 7265:                   cff1=1;
 7266:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7267:                   cff3 = veg_c;
 7268: 
 7269:                } else { // emergent vegetation
 7270:                   cff1 = 1.0/(1.0 + veg_c2);
 7271:                   cff2 = cff1;
 7272:                   cff3 = 0.0;
 7273: 
 7274:                }
 7275:             } // if iveg
 7276:          } //  2D/3D
 7277: 
 7278:          av_cff1 += cff1/i34;
 7279:          av_cff2 += cff2/i34;
 7280:          av_cff3 += cff3/i34;
 7281:          av_cff2_chi += cff2*chi/i34;
 7282:          av_cff3_chi += cff3*chi/i34;
 7283:          av_df += min(htot, veg_h)/(htot*i34);
 7284: 
 7285: 
 7286:          // btrack values: U^\star, U^{\star\alpha}
 7287:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7288:          Vector2 Ustar       = {0.0, 0.0}; 
 7289:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7290: 
 7291:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7292:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7293:          } else { //3D
 7294:             for (int k = side->kb; k < nvrt; k++) {
 7295:             
 7296:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7297:                Ustar += w2;
 7298: 
 7299:                if constexpr(iveg != 0) {
 7300:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7301:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7302:                        Ustar_alpha += zrat*w2; // XXXX
 7303:                    }
 7304:                }  // if iveg
 7305:             }  // for k
 7306:          }  //2D/3D
 7307:          
 7308: 
 7309:          // Add btrack & surface stress terms to \breve{G} first
 7310:          if constexpr(ics==1) {
 7311: 
 7312:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7313: 
 7314:          } else {
 7315:             // XXX IMPLEMENT THIS
 7316:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 7317:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 7318:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 7319:          }  // if ics
 7320: 
 7321:          // Surface and bottom stress terms
 7322:          if constexpr(ics==1) {
 7323:             const Vector2 tau    = side->tau();
 7324:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 7325: 
 7326:             // Term for surface and bottom stress
 7327:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7328: 
 7329:          } else {
 7330:             assert(false && "computeElemAverageGhat: Not implemented");
 7331:             // XXX IMPLEMENT THIS
 7332:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 7333:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 7334:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 7335:             // tau_x=(vn1+tt1)/2.d0
 7336:             // tau_y=(vn2+ss1)/2.d0
 7337:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 7338:          }  // if ics
 7339: 
 7340:          
 7341: 
 7342:          // All terms in F,F^\alpha,f_b except baroclinic
 7343:          // F, f_b: all explicit terms excluding vegetation 
 7344:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7345:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7346:          const double coriolis = side->coriolis;
 7347:          Vector2 F  =  coriolis*side->U;  // F_x
 7348:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7349:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7350: 
 7351:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7352:             
 7353:             for (int k = side->kb; k < nvrt; k++) {
 7354:                if (zctr2 > side->zc[k-1]) {
 7355:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7356:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7357:                    Fa +=  coriolis*w2*zrat;
 7358:                } // if zctr2
 7359:             } // k
 7360:          } // iveg
 7361: 
 7362:          // Integrate horizontal viscosity force vertically
 7363:          for (int k=side->kb + 1; k<nvrt; k++) {
 7364:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7365: 
 7366:             F += levelHorVisc;
 7367: 
 7368:             // Vegetation term
 7369:             if constexpr(iveg!=0) {
 7370:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7371:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7372:                   Fa += levelHorVisc*zrat;
 7373:                } 
 7374:             } // if iveg
 7375:          } // for k
 7376: 
 7377:          fb += side->nuGradU[side->kb];
 7378: 
 7379:          // Add to ghat1
 7380:          if constexpr(ics==2) {
 7381:             // XXX IMPLEMENT THIS
 7382:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7383:             // bigf1=vn1; bigf2=vn2
 7384:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7385:             // botf1=vn1; botf2=vn2
 7386:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7387:             // bigfa1=vn1; bigfa2=vn2
 7388:          } // if ics
 7389: 
 7390:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7391:       } // for j (nodes and sides)
 7392: 
 7393:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7394:          
 7395:       // Finish off terms in F, F^\alpha and f_b
 7396:       const double grav3 = elem->mean(&Node::grav2);
 7397:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7398: 
 7399: 
 7400:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7401:       for (int j=1; j<i34; j++) { 
 7402:          // For each side in the element...
 7403:          const Side *side = elem->sides[j];
 7404:          const double chi = side->chi;
 7405: 
 7406:          const double htot = side->htot2();
 7407:          const double veg_h = side->veg_h();
 7408:          const Vector2 F  = htot*fb;
 7409:          const Vector2 Fa = min(htot, veg_h)*fb;
 7410: 
 7411:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7412:       } // for j
 7413: 
 7414:       //botf1 etc are already in elem frame
 7415:       elem->ghat1 += tmp/i34;
 7416: 
 7417:       // Baroclinic force
 7418:       if constexpr(ibc==0) {
 7419:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7420: 
 7421:          Vector2 Fa = {0.0, 0.0};
 7422:          Vector2 intGradRho = {0.0, 0.0};
 7423:          
 7424:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 7425:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 7426:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7427: 
 7428:             // \in F [m^2/s/s]
 7429:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7430:          }
 7431: 
 7432:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7433:          const Vector2 F = av_df*Fa; //approx
 7434:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7435: 
 7436:       } // if ibc
 7437: 
 7438: 
 7439: 
 7440:    }
 7441: 
 7442: } // extern "C"
 7443: 
 7444: 
