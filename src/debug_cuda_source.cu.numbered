 3773: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3774:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3775:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3776:    // 
 3777:    // This kernel is called for all nodes.
 3778: 
 3779: 
 3780:    NODE(node1);
 3781: 
 3782: 
 3783:    node1->clearMatrixRow();
 3784:    node1->qel = 0.0;
 3785: 
 3786:    // THIS IS FOR STRUCTURES XXX
 3787:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3788: 
 3789:    
 3790:    for (int j=0; j<node1->numElements; j++) {
 3791:       // For each element connected to the node...
 3792: 
 3793:       Element *elem = node1->elements[j];
 3794: 
 3795:       // Compute the average gravity
 3796:       const double grav3 = elem->mean(&Node::grav2);
 3797: 
 3798:       // Look at the documentation for the description of the terms in the following integrals
 3799: 
 3800:       // Integral I_1 
 3801:       // \bar{\breve{H}} 
 3802:       const double hhatb = elem->mean(&Side::hhat);        
 3803: 
 3804:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3805: 
 3806:       const int id1 = elem->nodeLocalIdx(node1); 
 3807:       const double area = elem->area;
 3808: 
 3809:       if (elem->isTri()) {
 3810: 
 3811:          // To clarify the notation in this section: 
 3812:          //   i stands for the node under consideration (node1)
 3813:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3814:          const int id2 = elem->nxq(1 + id1);
 3815:          const int id3 = elem->nxq(2 + id1);
 3816:          Node *node2 = elem->nodes[id2];
 3817:          Node *node3 = elem->nodes[id3];
 3818: 
 3819:          const Point2 x1 = node1->p;
 3820:          const Point2 x2 = node2->p;
 3821:          const Point2 x3 = node3->p;
 3822: 
 3823:          // integral of phi_i*phi_j
 3824:          const double ipp_ii = (1.0/6.0 )*area;
 3825:          const double ipp_ij = (1.0/12.0)*area;
 3826:          const double ipp_ik = (1.0/12.0)*area;
 3827: 
 3828:          // integral of [(grad phi_i) * (grad phi_j)]
 3829:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3830:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3831:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3832: 
 3833:          // Computes the different components of integral I_1 of each node with respect to node i.
 3834:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3835:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3836:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3837: 
 3838:          node1->addToSparseMatrix(node1, I1_ii);
 3839:          node1->addToSparseMatrix(node2, I1_ij); 
 3840:          node1->addToSparseMatrix(node3, I1_ik);
 3841: 
 3842:       }
 3843:       else { // Quad
 3844:          // XXX IMPLEMENT THIS
 3845:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3846: 
 3847:          // To clarify the notation in this section: 
 3848:          //   i stands for the node under consideration (node1)
 3849:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3850:          const int id2 = elem->nxq(1 + id1);
 3851:          const int id3 = elem->nxq(2 + id1);
 3852:          const int id4 = elem->nxq(3 + id1);
 3853:          Node *node2 = elem->nodes[id2];
 3854:          Node *node3 = elem->nodes[id3];
 3855:          Node *node4 = elem->nodes[id4];         
 3856: 
 3857:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3858:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3859:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3860:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3861:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3862: 
 3863:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3864:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3865:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3866:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3867:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3868: 
 3869:          // Computes the different components of integral I_1 of each node with respect to node i.
 3870:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3871:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3872:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3873:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3874: 
 3875:          node1->addToSparseMatrix(node1, I1_ii);
 3876:          node1->addToSparseMatrix(node2, I1_ij); 
 3877:          node1->addToSparseMatrix(node3, I1_ik);
 3878:          node1->addToSparseMatrix(node4, I1_il);
 3879:   
 3880: 
 3881: 
 3882:       
 3883:       } 
 3884: 
 3885:  
 3886:       // Integral I_4
 3887:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3888:       // Where
 3889:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3890: 
 3891:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3892:       // of U over the element.
 3893:       Vector2 Umean = {0.0, 0.0};
 3894:       for (int m=0; m<elem->i34; m++) {      
 3895:          const Side *side = elem->sides[m];
 3896: 
 3897:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3898:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3899:       }
 3900:       Umean = Umean/elem->i34;
 3901: 
 3902:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3903: 
 3904:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3905:       const double I_4_1 = dot(gradPhi_1, Umean);
 3906: 
 3907:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3908:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3909:      
 3910:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3911: 
 3912:       // Additional terms 
 3913:       double vnorm = 0.0;
 3914:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3915:          Vector3 ubed;
 3916:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3917: 
 3918:          Vector3 gradP = {0.0, 0.0, 1.0};
 3919:          for (int m=0; m < elem->i34; m++) {
 3920:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3921:            gradP += toVector3(gradP_2D, 0.0);
 3922:          }   
 3923:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3924:       } // imm==2
 3925: 
 3926:       if (elem->isTri()) {
 3927:          for (int l=0; l<3; l++) {
 3928:             double fac;
 3929: 
 3930:             Node *node = elem->nodes[l];
 3931: 
 3932:             fac = (node == node1) ? 2.0 : 1.0;
 3933:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3934:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3935: // printf("AAA>>>  (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm) = %.15e\n",  (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm));
 3936:            
 3937:          }
 3938: 
 3939: 
 3940:          if (!elem->isDry) {
 3941:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3942: 
 3943:           node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3944: 
 3945:          }
 3946: 
 3947:       } // isTri
 3948:       else { // isQuad
 3949:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3950:          // for (int l=0; l<4; l++) {
 3951:          //   const Node *node = elem->nodes[l];
 3952: 
 3953:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3954:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3955: 
 3956:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3957:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3958:          // }
 3959: 
 3960:       } // isQuad
 3961: 
 3962: 
 3963:      node1->qel += (dt/elem->i34)*elem->vsource;
 3964:       
 3965: 
 3966:    } // for all elements connected to the node
 3967:    
 3968: 
 3969:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3970:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3971:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3972:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3973:       // If it is an open boundary node...
 3974: 
 3975:       // At least one open bnd side, maybe two
 3976:       for (int l=0; l<2; l++) { 
 3977: 
 3978:          // Gets each of the sides sharing the node. 
 3979:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3980: 
 3981:          // if (sideBnd == nullptr) continue; // Skip if no boundary side
 3982:          
 3983: 
 3984:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3985:          if (sideBnd != nullptr) {
 3986:             // If the side is on a boundary...
 3987: 
 3988:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3989: 
 3990:             // Get the boundary segment
 3991:             const BoundarySegment *sideSegment = sideBnd->segment;
 3992:             const Side *side = sideBnd->side;
 3993: 
 3994:             // Integral I_3
 3995:             if (sideSegment->ifltype != 0) {
 3996:             // Natural or Flather b.c.
 3997: 
 3998:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3999:                // especially for Flather b.c.
 4000:                double ri3 = 0.0;
 4001:                if (!side->isDry) {
 4002:                   // If the side is not dry
 4003:                   
 4004:                   // Computes the side flux of (uth, vth)
 4005:                   double Vn = 0.0;
 4006:                   for (int k = side->kb; k<nvrt-1; k++) {
 4007:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4008:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4009: 
 4010:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 4011:                   }
 4012: 
 4013:                   ri3 = 0.5*side->len*Vn;
 4014:                }
 4015: 
 4016:                if (sideSegment->ifltype == -1) { // Flather 1
 4017: 
 4018:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4019:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4020: 
 4021:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4022:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4023:                   
 4024:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4025:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4026: 
 4027:                } 
 4028:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4029:                   // Reset ri3
 4030:                   ri3 = 0.0;
 4031: 
 4032:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4033: 
 4034:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4035: 
 4036:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4037:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4038: 
 4039:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4040:                   node1->addToSparseMatrix(node1, con0*2.0);
 4041:                   node1->addToSparseMatrix(node2, con0);
 4042: 
 4043:                } // if Flather or Discharge
 4044: 
 4045: // printf("node1 = %p, thetai = %f, dt = %f, ri3 = %f\n", node1, thetai, dt, ri3);
 4046:                node1->qel -= thetai*dt*ri3;
 4047: 
 4048: 
 4049:             } // I_3
 4050:           
 4051: 
 4052:             // Integral I_5
 4053:             if(!side->isDry) {
 4054: 
 4055:                const double Unbar = dot(side->U, side->n);
 4056:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 4057: 
 4058:             } // I_5
 4059: 
 4060:          } // if is boundary side
 4061: 
 4062:       } // for l
 4063: 
 4064:    } // if isbnd
 4065: 
 4066: 
 4067: }
 4068: 
 4069: 
 4070: 
 4071: extern "C" {
 4072:    __global__ void rollUpElevation(void) {
 4073: 
 4074:       NODE(node);
 4075: 
 4076:       node->eta1 = node->eta2;
 4077: 
 4078:    }
 4079: 
 4080: 
 4081:    __global__ void backtrackAllNodes(void) {
 4082: 
 4083:       // max/min # of sub-divisions
 4084:       const int ndelt_max = max(1.0, dt/dtb_min);
 4085:       const int ndelt_min = max(1.0, dt/dtb_max); 
 4086: 
 4087:       // Removed all references to swild98 XXX
 4088:       // swild98=0.d0 !init
 4089: 
 4090: 
 4091:       SIDE(side);
 4092: 
 4093:       const int kb = side->kb;
 4094: 
 4095: 
 4096:       // Initialize btrack velocities to the actual velocities at the side 
 4097:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4098: 
 4099:       if (side->isDry) return;
 4100: 
 4101: 
 4102:       // Checks that at least one element is not dry
 4103:       const Element *elem1 = side->elems[0];
 4104:       const Element *elem2 = side->elems[1];
 4105: 
 4106: 
 4107:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4108:       
 4109:       // XXXXXX
 4110:       // !swild_tmp to store global coord. of the starting side
 4111:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4112:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4113:       // !Use sframe2 
 4114:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4115: 
 4116: 
 4117:       for (int k = kb; k < nvrt; k++) {
 4118:       //  Initialize (xt,yt,zt), nnel and vel.
 4119:       //  For ics=2, the coordinates are in local frames
 4120:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 4121: 
 4122: 
 4123:          const int iadvf = side->iadv();  // Advection flag
 4124: 
 4125:          Point3 xt;
 4126:          if constexpr(ics==1) {
 4127:             xt = side->center3D(k); 
 4128:          }
 4129:          else // lat/lon; in side lat/lon frame
 4130:          {
 4131:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 4132:          // XXX IMPLEMENT THIS
 4133:       //          xt=0.d0
 4134:       //          yt=0.d0
 4135:       //          !centroid coord. for nudging
 4136:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 4137:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 4138:          }  // ics
 4139: 
 4140: 
 4141: 
 4142:          // If on land or open boundary...
 4143:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 4144:          
 4145:          const double vmag = length(side->u2[k]);
 4146: 
 4147:          if (vmag <= velmin_btrack) {
 4148:             // No activity 
 4149: 
 4150:             side->btu[k] = side->u2[k];
 4151:             
 4152:          } else {  // do btrack
 4153: 
 4154:             // Compute number of sub-divisions based on local gradients 
 4155:             // XXX IS THIS NECESSARY?
 4156:             double suma = 0.0;
 4157:             int icount = 0;
 4158:             for (int ii=0; ii<2; ii++) {
 4159: 
 4160:                const Element *elem = side->elems[ii];
 4161:                  
 4162:                if (elem == nullptr) continue;
 4163: 
 4164:                icount++;
 4165: 
 4166:                // Not strictly along z; in ll frame for ics=2
 4167: 
 4168:                double utmp[4];
 4169:                double vtmp[4];
 4170:                for (int jj = 0; jj < elem->i34; jj++) {
 4171: 
 4172:                   const Node *node = elem->nodes[jj];
 4173: 
 4174:                   if constexpr(ics==1) {
 4175:                      utmp[jj] = node->u2[k].x;
 4176:                      vtmp[jj] = node->u2[k].y;  
 4177:                   } else {
 4178:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 4179:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 4180:                   }
 4181:                } // for jj
 4182: 
 4183:                const Vector2 grad_u = elem->grad2(utmp); 
 4184:                const Vector2 grad_v = elem->grad2(vtmp);
 4185: 
 4186:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4187:             } // for ii
 4188: 
 4189:             assert(icount > 0 && "Impossible 77");
 4190: 
 4191:             // '4' is somewhat arbitrary
 4192:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4193: 
 4194:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4195:          
 4196: 
 4197:             Vector3 u_int = {0.0, 0.0, 0.0};
 4198: 
 4199:             side->btrack(k, dt, dtbk, u_int);
 4200:             side->btu[k] = toVector2(u_int);
 4201:                
 4202:          } // if vmag (do backtrack)
 4203: 
 4204:       } // for k=kb,nvrt-1
 4205: 
 4206:    }
 4207: 
 4208: } // extern "C"
