  184: using Vector2 = double2; 
  185: using Vector3 = double3;
  186: using Point2  = double2;
  187: using Point3  = double3;
  188: 
  189: __device__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
  190:     return make_double2(a.x + b.x, a.y + b.y);
  191: }
  192: using Vector2 = double2; 
  193: using Vector3 = double3;
  194: __device__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
  195:     a.x += b.x;
  196:     a.y += b.y;
  197:     return a;
  198: }
  199: 
  200: __device__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
  201:     return make_double2(a.x - b.x, a.y - b.y);
  202: }
  203: 
  204: __device__ __forceinline__ double2 operator-=(double2& a, const double2& b) {
  205:     a.x -= b.x;
  206:     a.y -= b.y;
  207:     return a;
  208: }
  209: 
  210: __device__ __forceinline__ double2 operator*(const double2& v, const double s) {
  211:     return make_double2(v.x * s, v.y * s);
  212: }
  213: 
  214: __device__ __forceinline__ double2 operator*(const double s, const double2& v) {
  215:     return v * s;  // reuse the previous operator
  216: }
  217: 
  218: __device__ __forceinline__ double2 operator/(const double2& v, double s) {
  219:     return make_double2(v.x / s, v.y / s);
  220: }
  221: 
  222: __device__ __forceinline__ double norm2(const double2& v) {
  223:     return v.x*v.x + v.y*v.y;
  224: }
  225: 
  226: __device__ __forceinline__ double length(const double2& v) {
  227:     return sqrt(v.x*v.x + v.y*v.y);
  228: }
  229: 
  230: __device__ __forceinline__ double2 normalize(const double2& v) {
  231:     return v / length(v);
  232: }
  233: 
  234: __device__ __forceinline__ double dot(const double2& v, const double2& w) {
  235:     return v.x*w.x + v.y*w.y;
  236: }
  237: 
  238: __device__ __forceinline__ double cross(const double2& v, const double2& w) {
  239:     return v.x*w.y - v.y*w.x;
  240: }
  241: 
  242: __device__ __forceinline__ double2 rot90(const double2& a) {
  243:     return make_double2(a.y, -a.x);
  244: }
  245: 
  246: __device__ __forceinline__ double3 operator+(const double3& a, const double3& b) {
  247:     return make_double3(a.x + b.x, a.y + b.y, a.z + b.z);
  248: }
  249: 
  250: __device__ __forceinline__ double3 operator+=(double3& a, const double3& b) {
  251:     a.x += b.x;
  252:     a.y += b.y;
  253:     a.z += b.z;
  254:     return a;
  255: }
  256: 
  257: __device__ __forceinline__ double3 operator-(const double3& a, const double3& b) {
  258:     return make_double3(a.x - b.x, a.y - b.y, a.z - b.z);
