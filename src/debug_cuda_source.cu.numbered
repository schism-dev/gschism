 1706: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000) {
 1707:    return;
 1708:    // Lock the mutex
 1709:    lock(&debugPlotMutex);
 1710:  
 1711:    bool ok = true;
 1712:    if (debugPlotIdx == nullptr) ok = false;
 1713:    if (*debugPlotIdx >= 10000) ok = false;
 1714:    if (ok) {
 1715:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1716:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1717:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1718:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1719:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1720:       (*debugPlotIdx)++;
 1721:    }
 1722: 
 1723:    __threadfence();               // ensure all above writes are visible
 1724:    // Unlock the mutex
 1725:    unlock(&debugPlotMutex);
 1726: 
 1727: }
