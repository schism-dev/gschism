 3316: 
 3317: //    }
 3318: 
 3319: //    return false;
 3320: 
 3321: // }
 3322: 
 3323: 
 3324: 
 3325: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3326: 
 3327: 
 3328: __device__ void Node::updateKb(void) {
 3329: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3330: 
 3331:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3332: 
 3333: 
 3334:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3335: 
 3336:    if constexpr(ivcor == 2) {  // SZ coordinates
 3337:       
 3338:       // Compute bottom level index
 3339:       if (depth <= mesh->h_s) {
 3340:          kb = izlev;   
 3341:          
 3342:       } else {
 3343:          kb = -1;
 3344:          int L = 0;
 3345:          int R = nzlev; 
 3346:          
 3347:          while (L <= R) {
 3348:             int M = (R + L) / 2;
 3349: 
 3350: 
 3351:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3352:             
 3353:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3354:                R = M;
 3355:             } else {
 3356:                L = M;
 3357:             }
 3358: 
 3359:             if (R - L == 1) {
 3360:                kb = L;
 3361:                break;
 3362:             }
 3363:          }
 3364: 
 3365:          // Checks that the binary search was successful
 3366:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3367:        
 3368:       }
 3369:    } 
 3370: }
 3371: 
 3372: 
 3373: __device__ __inline__ void Node::updateZCoordData(void) {
 3374: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3375: 
 3376:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3377:    // if (isDry2()) {
 3378:    //    kb = -1;  // XXXXXXXX KKKKK
 3379:    //    return;
 3380:    // }
 3381: 
 3382: 
 3383:    if constexpr(ivcor == 2) {  // SZ coordinates
 3384:       
 3385:       // Compute bottom level index
 3386:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3387:    } 
 3388:    else {  // if (ivcor == 1) Localized sigma
 3389:       // Do nothing
 3390:    }
 3391: 
 3392: 
 3393: }
 3394: 
 3395: 
 3396: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3397:    // Computes the z coordinate at level k.
 3398:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3399:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3400:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3401:    // used 
 3402: 
 3403:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3404:    
 3405:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3406: 
 3407:    if (isDry2()) return 0.0;  
 3408: 
 3409:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3410: 
 3411:    if constexpr(ivcor == 2) {
 3412: 
 3413:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3414:       const double h_c = mesh->h_c;
 3415:       const double theta_f = mesh->theta_f;
 3416:       const double sinh_theta_f = mesh->sinh_theta_f;
 3417: 
 3418: 
 3419:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3420:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3421:       // once per time step/node. XXXX
 3422:       // CHECK: updateZCoordData
 3423: 
 3424:       //  To simplify comparisons, I define index versions of count variables.
 3425:       if      (k == ivrt)     return eta2; 
 3426:       else if (k == izlev)    return -hmod2;
 3427:       else if (k == kb)       return -depth;
 3428:       else if (k < izlev)     return mesh->ztot[k];
 3429:       else if (k > izlev) {
 3430:          const int ksig = k - izlev;
 3431: 
 3432:          if (hmod2 <= h_c) {
 3433:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3434: 
 3435:          } 
 3436:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3437:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3438:             assert(false && "compZCoord: invalid h_c\n");
 3439:          } 
 3440:          else {
 3441:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3442:                    h_c * mesh->sigma[ksig] + 
 3443:                    (hmod2 - h_c) * mesh->cs[ksig];
 3444:          }
 3445:       } else { 
 3446:          assert(false && "compZCoord: invalid level or coordinate system\n");
 3447:       }
 3448: 
 3449:    }
 3450:    else {  // if constexpr(ivcor == 1)
 3451:       if (k <= kb)        return -depth; 
 3452:       else if (k == ivrt) return eta2;
 3453:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3454: 
 3455:    }
 3456:    
 3457:    assert(false && "compZCoord: invalid level or coordinate system\n");
 3458:    return 0.0;
 3459: }
 3460: 
 3461: 
 3462: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3463:    // Computes the bottom drag Cd based on the selected nchi
 3464: 
 3465:    if constexpr(nchi == 0) {
 3466:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3467:       Cd = drag;  // Read from drag file
 3468: 
 3469:    } else if constexpr(nchi == 1) {
 3470:       // 
 3471: 
 3472:       bool ltmp = false; // for WBL iteration
 3473: 
 3474:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3475:       if (isDry || (rough == 0.0)) {
 3476:          Cd = 0.0;
 3477: 
 3478:       } else { //roughness >0 
 3479:          
 3480:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3481: 
 3482:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3483: 
 3484:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3485: 
 3486:       } // if rough
 3487: 
 3488:    } else if constexpr(nchi == -1) {
 3489:    // Manning 
 3490:  
 3491:       const double htot = max(hmin_man, htot2()); 
 3492:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3493: 
 3494:    } else {
 3495:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3496:       
 3497:    } // if nchi
 3498: 
 3499: }
 3500: 
 3501: 
 3502: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3503:    // Checks if a side in on the boundary
 3504:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3505: 
 3506:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3507:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3508: 
 3509:    // Indices of the nodes that form the side
 3510:    const int n1 = side.n1->idx;
 3511:    const int n2 = side.n2->idx;
 3512:    isLand = false;
 3513:    
 3514: 
 3515:    // Check if the side is on a land boundary
 3516:    for (int i = 0; i < nland; i++) {
 3517:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3518:          // Consecutive nodes in the land boundary segment
 3519:          const int b1 = ilnd[i + j*nland];
 3520:          const int b2 = ilnd[i + (j + 1)*nland];
 3521: 
 3522:          assert(b1 != -1 && b2 != -1);
 3523: 
 3524:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3525:             
 3526:             isLand = true;
 3527:             return i;
 3528:          }
 3529:       }
 3530:    }
 3531: 
 3532:    // Check if the side is on an open boundary
 3533:    for (int i = 0; i < nope; i++) {
 3534:       for (int j = 0; j < nond[i] - 1; j++) {
 3535:          // Consecutive nodes in the open boundary segment
 3536:          const int b1 = iond[i + j*nope];
 3537:          const int b2 = iond[i + (j + 1)*nope];
 3538: 
 3539:          assert(b1 != -1 && b2 != -1);
 3540: 
 3541:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3542:             isLand = false;
 3543:             return i;
 3544:          }
 3545:       }
 3546:    }
 3547: 
 3548:    return -1;
 3549: }
 3550: 
 3551: 
 3552: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3553:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3554:                                     double *wind_rotate_angle, 
 3555:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3556:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3557:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3558:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3559:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 3560: 
 3561:    NODE(pnode);  
 3562:    const int i = idx_node;
 3563:    Node &node(*pnode);
 3564: 
 3565:    node.idx = i;
 3566: 
 3567:    const int idxNodeStart = nodeNeighNodesStart[i];
 3568:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3569:    node.numNodes = idxNodeEnd - idxNodeStart;
 3570:    node.nodes = nodeNeighNodes + idxNodeStart;
 3571:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3572: 
 3573: 
 3574: 
 3575:    const int idxElemStart = nodeNeighElemsStart[i];
 3576:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3577:    node.numElements = idxElemEnd - idxElemStart;
 3578:    node.elements = nodeNeighElems + idxElemStart;
 3579: 
 3580: 
 3581:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3582:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3583:       const int partNode = localNodePart[idxNodeGlobal]; 
 3584:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3585: 
 3586:       Node *node_ptr = nodes[partNode] + idxNode;
 3587:       
 3588:       nodeNeighNodes[idx] = node_ptr;
 3589:    }
 3590: 
 3591: 
 3592:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3593:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3594:       const int partElem = localElemPart[idxElemGlobal];
 3595:       const int idxElem  = localElemIndices[idxElemGlobal];
 3596: 
 3597:       Element *elem_ptr = elems[partElem] + idxElem;
 3598: 
 3599:       nodeNeighElems[idx] = elem_ptr;
 3600:    }      
 3601: 
 3602:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 3603:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 3604:    sincosf((float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 3605: 
 3606:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 3607:    if constexpr(ics == 1) {
 3608:       node.p.x   = node_coords[i * 3];
 3609:       node.p.y   = node_coords[i * 3 + 1];
 3610:       node.gz = 0.0;
 3611: 
 3612:    } else {
 3613:       const double lon = deg2rad*node_coords[i * 3];
 3614:       const double lat = deg2rad*node_coords[i * 3 + 1];
 3615: // printf("lat = %f, lon = %f, x = %f, y = %f\n", lat, lon, node.lat, node.lon); 
 3616:       Point3 p = computeXYZfromLatLon(lat, lon);
 3617:       node.p = toVector2(p);
 3618:       node.gz = p.z;
 3619:       node.lon = lon;
 3620:       node.lat = lat;
 3621: 
 3622:       #ifdef USE_FRAMES
 3623:       node.setFrame(lat, lon);
 3624:       #endif
 3625: 
 3626: 
 3627:    }
 3628: 
 3629:    node.depth = node_coords[i * 3 + 2];
 3630: 
 3631:    node.numSides = 0;
 3632: 
 3633:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3634:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3635:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3636:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3637:    else assert(false && "populateNodes: selected nchi not implemented.");
 3638:    
 3639:    if constexpr(ivcor == 1) 
 3640:    {  
 3641:       node.kb = kb[i];
 3642:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + i*nvrt];
 3643:    }
 3644: 
 3645:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3646:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3647:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3648: 
 3649:    
 3650:    // Links the node to the boundary information
 3651:    if (isbnd[i] >= 0) {
 3652:      
 3653:       // Get the index of the node boundary
 3654:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3655: 
 3656:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3657:       node.nodeBnd->node = &node;
 3658: 
 3659:       node.nodeBnd->sideBnd1 = nullptr;
 3660:       node.nodeBnd->sideBnd2 = nullptr;
 3661: 
 3662:       if (isbnd[i]>=0) {
 3663: 
 3664:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3665:          
 3666:          node.nodeBnd->segment->ifltype = 3 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3667:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3668: 
 3669:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3670:          node.nodeBnd->segment->clen  = nan("1");
 3671:          node.nodeBnd->segment->carea = nan("1");
 3672: 
 3673:       }
 3674:    } else {
 3675: 
 3676:       node.nodeBnd = nullptr; // For internal nodes
 3677: 
 3678:       if (isbnd[i] == landSegment) {
 3679:          node.nodeBnd = &landBoundaryNode;
 3680:          node.nodeBnd->segment = &landBoundarySegment;
 3681:       }
 3682:       
 3683:    }
 3684:    
 3685:    // XXXX GAUSSIAN HILL VELOCITIES
 3686: #ifdef GAUSSIAN_HILL_VELOCITIES
 3687:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3688:       constexpr double rot_per = 3000.0;
 3689:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3690:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3691:    // XXXXX
 3692: #endif
 3693: 
 3694: }
 3695: 
 3696: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3697:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3698:                                     double *wind_rotate_angle,   
 3699:                                     int *isdel, int *isidenode, int *isbnd,
 3700:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3701:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3702:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3703:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3704:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3705:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3706:                                     double *drag, double *roughness) {
 3707: 
 3708: 
 3709:    SIDE(pside);
 3710:    Side &side(*pside);
 3711:    const int i = idx_side;
 3712: 
 3713:    side.idx = i;  
 3714:    
 3715:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3716:    const double fc   = 2.0*omega_e*sin(sfea0);
 3717:    const double beta = 2.0*omega_e*cos(sfea0);
 3718: 
 3719:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 3720: 
 3721:    // finding the pointer to the nodes that form the side
 3722:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3723:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3724: 
 3725:    const int locidx_n1 = localNodeIndices[idx_n1];
 3726:    const int locidx_n2 = localNodeIndices[idx_n2];
 3727:    const int part_n1 =   localNodePart[idx_n1];
 3728:    const int part_n2 =   localNodePart[idx_n2];
 3729: 
 3730:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3731:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3732: 
 3733: 
 3734:    // Counts the number of sides connected to each node
 3735:    side.n1->numSides++;
 3736:    side.n2->numSides++;
 3737: 
 3738:    // Normal, unitary vector to the side
 3739:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3740:    side.n = normalize(side.n);
 3741: 
 3742:    // Side boundary type
 3743:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3744:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3745: 
 3746:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3747:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3748:    {
 3749:       bool isLand = false;
 3750:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3751:       
 3752:       if (isbs > -1) {
 3753:          // assert(isLand || isbs>=0);
 3754:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3755: 
 3756:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3757: 
 3758:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3759:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3760: 
 3761:          assert (isLand == side.sideBnd->segment->isLand);
 3762: 
 3763:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3764:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3765:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3766: 
 3767:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3768:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3769:          
 3770:          side.sideBnd->side = &side;
 3771: 
 3772:       }
 3773:       else {
 3774:          side.sideBnd = nullptr;
 3775:       }
 3776:    }
 3777:    else 
 3778:    {
 3779:       side.sideBnd = nullptr;
 3780:    }
 3781: 
 3782: 
 3783:    // finding the pointer to the elements that share the side
 3784:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3785:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3786: 
 3787:    if (idx_e1 > -1) {
 3788:       const int locidx_e1 = localElemIndices[idx_e1];
 3789:       const int part_e1 =  localElemPart[idx_e1];
 3790:       side.elems[0] = elems[part_e1] + locidx_e1;
 3791: 
 3792:    }
 3793:    else {
 3794:       side.elems[0] = nullptr;
 3795:    }
 3796: 
 3797:    if (idx_e2 > -1) {
 3798:       const int locidx_e2 = localElemIndices[idx_e2];
 3799:       const int part_e2 =  localElemPart[idx_e2];
 3800:       side.elems[1] = elems[part_e2] + locidx_e2;
 3801:    }
 3802:    else {
 3803:       side.elems[1] = nullptr;
 3804:    }
 3805: 
 3806:    // Compute the center of the side
 3807:    side.center = 0.5*(side.n1->p + side.n2->p);
 3808: 
 3809:    #ifdef USE_FRAMES
 3810:    side.setFrame();
 3811:    #endif
 3812: 
 3813:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3814:    side.shapiro = shapiro0;
 3815: 
 3816: #ifdef GAUSSIAN_HILL_VELOCITIES
 3817: // XXXX
 3818: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3819: constexpr double rot_per=3000.0;
 3820: constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 3821: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3822: // XXXXX      
 3823: #endif
 3824:    // Compute the z level at the center of the side
 3825:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 3826:    
 3827:    // Compute the length of the side
 3828:    const Vector2 vLen = side.n2->p - side.n1->p;
 3829:    side.len = sqrt(dot(vLen, vLen));
 3830: 
 3831: 
 3832:    // Compute the Coriolis coefficient
 3833: 
 3834:    if constexpr(ncor == -1 || ncor == 0) {
 3835:       side.coriolis = coricoef;
 3836:    }
 3837:    else {
 3838:       const double sphi = side.lat();  // Latitude at the center of the side
 3839: 
 3840:       assert(use_ll && "use_ll must be true when ncor > 0");
 3841: 
 3842:       if constexpr(ics == 1) {
 3843:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3844:       }
 3845:       else { // ics == 2
 3846:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 3847:          side.coriolis = 2.0*omega_e*sin(sphi);  
 3848:       }
 3849: 
 3850:    }
 3851: 
 3852: }
 3853: 
 3854: 
 3855: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3856:    double *node_coords, double *node_coords_ll, bool use_ll,
 3857:    double *wind_rotate_angle,   
 3858:    int *isdel, int *isidenode, int *isbnd,
 3859:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3860:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3861:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3862:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3863:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3864:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3865:    double *drag, double *roughness) {
 3866: 
 3867:    ELEM(pelem);
 3868:    Element &elem(*pelem);
 3869:    const int i = idx_elem;
 3870: 
 3871:    elem.idx = i;
 3872: 
 3873:    for (int j = 0; j < i34[i]; j++) {
 3874:       const int idxNode = elnode[i*4 + j];  
 3875:       const int idxSide = elside[i*4 + j];
 3876:       
 3877:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3878:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3879: 
 3880:       // Find the neighboring element  
 3881:       if (elem.sides[j]->elems[0] == &elem) {
 3882:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3883:       }
 3884:       else {
 3885:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3886:       }
 3887:       
 3888:    }
 3889: 
 3890:    elem.i34 = i34[i];
 3891: 
 3892:    // Compute the barycenter of the element and its depth
 3893:    elem.center = {0.0, 0.0};
 3894:    elem.depth = 1e10;
 3895:    for (int j = 0; j < i34[i]; j++) {
 3896: 
 3897:       elem.center += elem.nodes[j]->p/i34[i];
 3898:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 3899:    }
 3900: 
 3901:    #ifdef USE_FRAMES
 3902:    elem.setFrame();
 3903:    #endif
 3904: 
 3905:    elem.area = elem.computeSignedArea(); 
 3906:    elem.radius = sqrt(elem.area)/pi; 
 3907:    
 3908:    // Determines which way the normal vector to each side is oriented.
 3909:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3910:    for (int j = 0; j < i34[i]; j++)  
 3911:    {
 3912:       if (elem.sides[j]->elems[0] == &elem) {
 3913:          elem.ssign[j] =  1.0;
 3914:       }
 3915:       else {
 3916:          elem.ssign[j] = -1.0;
 3917:       }
 3918: 
 3919:    }
 3920: 
 3921:   
 3922: 
 3923:    // Derivatives of shape functions
 3924:    //  For ics=2, this is done in the element frame
 3925:    //  For quads, the derivative is evaluated at centroid
 3926:    for (int j = 0; j < elem.i34; j++) {
 3927:       const double area = elem.area;
 3928:       const int id2 = elem.nxq(1 + j);
 3929:       const int id3 = elem.nxq(2 + j);
 3930:       const int id4 = elem.nxq(3 + j);
 3931:       if (elem.isTri()) {
 3932:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3933:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3934:          // da1/dx = (y1 - y2)/(2*area)
 3935: 
 3936:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 3937:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 3938:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 3939: 
 3940:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 3941:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 3942: 
 3943:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3944: 
 3945:       }
 3946:       else  { // Quad; evaluate at centroid
 3947: 
 3948:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 3949:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 3950:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 3951: 
 3952:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 3953:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 3954: 
 3955:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3956:       } // if Tri
 3957: 
 3958:    } // for j   
 3959:    
 3960:    
 3961: 
 3962: }
 3963: 
 3964: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3965:                                             double *emo, double *efa, 
 3966:                                             double *umo, double *ufa, 
 3967:                                             double *vmo, double *vfa) {
 3968: 
 3969:    NODE_BND(nodeBnd);
 3970:    const int idx = idx_node_bnd;    
 3971: 
 3972:    nodeBnd->idx = idx;
 3973: 
 3974:    // Need to find the segment index and the index of the node on the segment
 3975:    int idxNode = -1;
 3976:    int iseg, i;
 3977:    for (iseg = 0; iseg < nope; iseg++) {
 3978:       // for each segment...
 3979:       for (i = 0; i < nond[iseg]; i++) {
 3980:          idxNode = iond[iseg + i*nope];
 3981:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3982:          
 3983:       }
 3984:    }
 3985: 
 3986:    assert(iseg < nope && "iseg is out of bounds");
 3987: 
 3988: found: // Jumped here when the node was found
 3989: 
 3990:    nodeBnd->isEssentialBC = true;
 3991:    nodeBnd->elbc = 0.0;
 3992: 
 3993:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3994: 
 3995:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 3996:       nodeBnd->efa[jfr] = efa[idx2];
 3997:       nodeBnd->emo[jfr] = emo[idx2];
 3998:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3999:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 4000: 
 4001:    }
 4002:         
 4003: 
 4004: }
