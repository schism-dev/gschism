 2723: 
 2724: //       const Side& side = sides[i];
 2725: 
 2726: //       xIntersect=-1.e25;
 2727: //       yIntersect=-1.e25;
 2728: 
 2729: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 2730: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 2731: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 2732: 
 2733: //       if (delta != 0.0) {
 2734: //          // Solves the two linear equations for tt1 and tt2
 2735: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2736: //          const double tt2 = delta2/delta;
 2737: 
 2738: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 2739: //          // Similarly, we use tt2 to compute the intersection point.
 2740: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 2741: //             xIntersect = x3 + (x4 - x3)*tt2;
 2742: //             yIntersect = y3 + (y4 - y3)*tt2;
