 7137: __global__ void printMatrix(bool full) {
 7138:    // Debugging: print the matrix
 7139: 
 7140:    const int size = mesh->np;
 7141:    double sum = 0.0;
 7142:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7143:       const Node *node = mesh->localNodeData + idx_node;
 7144:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7145:       for (int j = 0; j < node->numNodes; j++) {
 7146:          Node* nbNode = node->nodes[j];
 7147:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7148:          sum += node->coeffMatrix[j];
 7149:       }
 7150:       if (full) printf("]\n");
 7151: 
 7152: 
 7153:    }
 7154:    if (!full) printf("sum=%lf\n", sum);
 7155: }
