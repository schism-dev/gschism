 1076:    
 1077:    // Elevation boundary condition
 1078:    int iettype;  // Type of elevation boundary condition
 1079:    double eth;   // Elevation time history
 1080: 
 1081:    // Flow boundary condition
 1082:    double qthcon;  // Flow time history constant
 1083:    double vobc1;   // Velocity coefficient 1
 1084:    double vobc2;   // Velocity coefficient 2
 1085: 
 1086:    // Tracer boundary conditions
 1087:    // double trobc[natrm];    // Tracer boundary condition nudging factor
 1088:    // int  itrtype[natrm];    // Tracer boundary condition type
 1089: 
 1090:    BoundarySegment(bool _isLand) {
 1091:       isLand = _isLand;
 1092:       clen = 0.0;
 1093:       carea = 0.0;
 1094:       ifltype = 0;
 1095:       iettype = 0;
 1096:       eth = 0.0;
 1097:    }
 1098: 
 1099:    BoundarySegment(void) {
 1100:       isLand = false;
 1101:       clen = 0.0; 
 1102:       carea = 0.0;
 1103:       ifltype = 0;
 1104:       iettype = 0;
 1105:       eth = 0.0;
 1106:    }
 1107: 
