 1290:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
 1291:    {
 1292:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
 1293:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
 1294:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
 1295:       
 1296:    }
