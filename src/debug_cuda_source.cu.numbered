 2071: 
 2072: __device__ __forceinline__ void update_bdef(double time, double x0, double y0, double &dep, Vector3 &vel) {
 2073:    // For imm=2, user needs to update bottom depth and velocity
 2074: 
 2075:    dep = min(1.0, 7.0 - (x0 + time));
 2076:    vel = { -1.0, 0.0, 0.0 };
 2077: 
 2078: }
