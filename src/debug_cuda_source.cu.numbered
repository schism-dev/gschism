 3300: 
 3301: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3302: 
 3303:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3304:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3305:    const Node *n1 = side->n1;
 3306:    const Node *n2 = side->n2;
 3307: 
 3308:    bool n1_match = (n1->nodeBnd->segment == segment);
 3309:    bool n2_match = (n2->nodeBnd->segment == segment);
 3310: 
 3311:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3312:    if (n1_match && n2_match) {
 3313:       return 0.5;
 3314:    } else if (n1_match) {
 3315:       return 1.0;
 3316:    } else if (n2_match) {
 3317:       return 0.0;
 3318:    }
 3319: 
 3320:    return 0.0;
 3321: }
 3322: 
 3323: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3324: 
 3325: 
 3326: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 3327: 
 3328:    const double w1 = getBoundaryArrayValueWeight();
 3329:    const double w2 = 1.0 - w1;
 3330:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3331:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3332: 
 3333:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 3334: }
 3335: 
 3336: 
 3337: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 3338:    const double w1 = getBoundaryArrayValueWeight();
 3339:    const double w2 = 1.0 - w1;
 3340:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3341:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3342: 
 3343:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 3344: 
 3345: }
 3346: 
 3347: 
 3348: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 3349:    // Returns the value of the velocity at the side center
 3350:    const double w1 = getBoundaryArrayValueWeight();
 3351:    const double w2 = 1.0 - w1;
 3352:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3353:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3354: 
 3355:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 3356: }
 3357: 
 3358: 
 3359: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 3360:    // Returns the value of the normal component of the velocity at the side center
 3361:    const double w1 = getBoundaryArrayValueWeight();
 3362:    const double w2 = 1.0 - w1;
 3363:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3364:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3365: 
 3366:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 3367: }
