 8427: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 8428:    Element *elems = mesh->localElemData;
 8429: 
 8430:    *addr = elems;
 8431:    *sizeElement = sizeof(Element);
 8432:    switch (varCode) {
 8433:       case (int)VarCode::z:
 8434:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 8435:          *sizeType = sizeof(double);
 8436:          break;
 8437:       case (int)VarCode::x:
 8438:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 8439:          *sizeType = sizeof(Vector2);
 8440:          break;
 8441:       case (int)VarCode::gradETP:
 8442:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
 8443:          *sizeType = sizeof(Vector2);
 8444:          break;
 8445:       case (int)VarCode::area:
 8446:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 8447:          *sizeType = sizeof(double);
 8448:          break;
 8449:       case (int)VarCode::depth:
 8450:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 8451:          *sizeType = sizeof(double);
 8452:          break;
 8453:       case (int)VarCode::radius:
 8454:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 8455:          *sizeType = sizeof(double);
 8456:          break;
 8457:       case (int)VarCode::ghat:
 8458:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 8459:          *sizeType = sizeof(Vector2);
 8460:          break;
 8461:       case (int)VarCode::kb:
 8462:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 8463:          *sizeType = sizeof(int);
 8464:          break;
 8465:       case (int)VarCode::isdry:
 8466:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 8467:          *sizeType = sizeof(int);
 8468:          break;            
 8469:       case (int)VarCode::w:
 8470:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 8471:          *sizeType = sizeof(double);
 8472:          break;
 8473:       case (int)VarCode::FaceIndices:
 8474:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 8475:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 8476:          *sizeType = sizeof(Node);
 8477:          break;
 8478:       default:
 8479:          *offset = -1;
 8480:    }
 8481: }
