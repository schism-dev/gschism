 7086: extern "C" __global__ void populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 7087:    double *node_coords, double *node_coords_ll, bool use_ll, double *wind_rotate_angle, 
 7088:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 7089:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
