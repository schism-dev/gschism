 1090: struct BoundarySegment {
 1091: 
 1092:    bool isLand;
 1093: 
 1094:    double clen;  // Length of the boundary segment
 1095:    double carea; // Area of the boundary segment
 1096: 
 1097:    int ifltype;  // Type of flow boundary condition
 1098:    
 1099:    // Elevation boundary condition
 1100:    int iettype;  // Type of elevation boundary condition
 1101:    double eth;   // Elevation time history
 1102: 
 1103:    // Flow boundary condition
 1104:    double qthcon;  // Flow time history constant
 1105:    double vobc1;   // Velocity coefficient 1
 1106:    double vobc2;   // Velocity coefficient 2
 1107: 
 1108:    // Tracer boundary conditions
 1109:    // double trobc[natrm];    // Tracer boundary condition nudging factor
 1110:    // int  itrtype[natrm];    // Tracer boundary condition type
 1111: 
 1112:    BoundarySegment(bool _isLand) {
 1113:       isLand = _isLand;
 1114:       clen = 0.0;
 1115:       carea = 0.0;
 1116:       ifltype = 0;
 1117:       iettype = 0;
 1118:       eth = 0.0;
 1119:    }
 1120: 
 1121:    BoundarySegment(void) {
 1122:       isLand = false;
 1123:       clen = 0.0; 
 1124:       carea = 0.0;
 1125:       ifltype = 0;
 1126:       iettype = 0;
 1127:       eth = 0.0;
 1128:    }
 1129: 
 1130:    
 1131: };
