 1958: 
 1959: 
 1960: 
 1961: /**
 1962:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1963:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1964:    If the segment is completely inside the element, then it returns true.
 1965: 
 1966:    This function assumes:
 1967:    - The initial point is on a side of the element. 
 1968:    - Its position is given by parameter t in the range [0,1].
 1969:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1970:       intersects the element (elements are convex).
 1971: 
 1972:    To find the intersection point, this function does the following:
 1973:    - it finds the intersection of the line segment with all the element side lines,
 1974:       except for the one that contains the initial point.
 1975:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1976:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1977:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1978:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1979:       track segment is almost parallel to the element side line.
 1980: 
 1981:    Inputs:
 1982:    @param x1: starting point of the line segment
 1983:    @param x2: other end of the line segment
 1984: 
 1985:    Outputs:
 1986:    @param side:  side that intersects the line segment 
 1987:    @param nextElement (output):  element at that shares the intersection point with this element
 1988:    @param t (output): Parametric value of the intersection point on the side (0 <= t <= 1)
 1989:    @param tIntersect (output): Parametric value of the intersection point on the track segment x1x2 (0 <= tIntersect <= 1)
 1990: 
 1991:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1992:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1993:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1994: 
 1995:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1996:    (Delta) being zero.
 1997: 
 1998:    The intersection2 point happens when:
 1999:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 2000:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 2001:    
 2002:    Assumption: the 4 points (including those of the side segment) are different.
 2003:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 2004:    
 2005: **/
 2006: __device__ void Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 2007:                                               double &t, double &tIntersect) {
 2008:    assert( containsPoint2(x1) && "Starting point is not inside the element");                                    
 2009:    assert(!containsPoint2(x2) && "Ending point is not outside the element");
 2010: 
 2011:    double closest_intersect_t = 1e10;
 2012:    bool found_intersection = false;
 2013: 
 2014:    for (int i = 0; i < i34; i++) {
 2015: 
 2016:       Side *side2 = sides[i];
 2017: 
 2018:       // (x3,y3)-(x4,y4) is the element side line
 2019:       const Point2 x3 = side2->n1->p;
 2020:       const Point2 x4 = side2->n2->p;
 2021: 
 2022:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 2023:       const double delta = cross(x2 - x1, x3 - x4);
 2024: 
 2025:       if (abs(delta) > 0) {
 2026: 
 2027:          const double delta1 = cross(x3 - x1, x3 - x4);
 2028:          const double delta2 = cross(x2 - x1, x3 - x1); 
 2029: 
 2030:          // Solves the two linear equations for tt1 and tt2
 2031:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2032:          const double tt2 = delta2/delta;
 2033: 
 2034:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 2035:             closest_intersect_t = min(closest_intersect_t, tt1);
 2036:             side = side2;
 2037:             nextElement = side->otherElem(this);
 2038:             t =          clamp(tt2, 0, 1.0);
 2039:             tIntersect = clamp(tt1, 0, 1.0);
 2040:             found_intersection = true;
 2041:          }
 2042: 
 2043:       
 2044:       }
 2045:       
 2046:    } // for
 2047: 
 2048:    assert(found_intersection && "No intersection found");
 2049: 
 2050: }
 2051: 
 2052: 
 2053: __forceinline__ __device__ bool Element::containsPoint2(Point2 x) const {
 2054:    // Check if the point (x,y) is inside the element. It does it by computing all the distances from the point to the sides (positive if inside, negative if outside)
 2055:    // And then checking if the minimum relative distance is larger than epsilon
 2056:    
 2057:    // ssign is positive if side->n is pointing outwards the element, negative if it is pointing inwards.
 2058:    double minDist = min3(-ssign[0]*sides[0]->relativeSignedDistanceToPoint(x),
 2059:                          -ssign[1]*sides[1]->relativeSignedDistanceToPoint(x),
 2060:                          -ssign[2]*sides[2]->relativeSignedDistanceToPoint(x));
 2061:    if (isQuad()) minDist = min(minDist, -ssign[3]*sides[3]->relativeSignedDistanceToPoint(x));
 2062: 
 2063:    return minDist > geometricEpsilon;
 2064: }
 2065: 
 2066: 
 2067: 
 2068: 
 2069: __inline__ __device__ double Element::computeSignedArea(void) const {
 2070:    // Compute the area of the element
 2071: 
 2072:    double res = signedArea(nodes[0]->p, nodes[1]->p, nodes[2]->p);
 2073: 
 2074:    // In the quad case we need to add the area of the other triangle.
 2075:    if (isQuad()) {
 2076:       double ar1 = signedArea(nodes[0]->p, nodes[2]->p, nodes[3]->p);
 2077:       double ar2 = signedArea(nodes[0]->p, nodes[1]->p, nodes[3]->p);
 2078:       double ar3 = signedArea(nodes[1]->p, nodes[2]->p, nodes[3]->p);
 2079:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2080: 
 2081:       res += ar1;
 2082:    }
 2083: 
 2084:    return res;
 2085: }
 2086: 
 2087: 
 2088: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2089:                                                                 (nodes[1]->isDry2()) ||
 2090:                                                                 (nodes[2]->isDry2()) ||
 2091:                                                                 (i34==4 && nodes[3]->isDry2());
 2092: }
 2093: 
 2094: __inline__ __device__ double Element::detJ_eta(void) const {
 2095:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2096:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2097: }
 2098: 
 2099: __inline__ __device__ double Element::detJ_xi(void) const {
 2100:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2101:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2102: }
