 7023:    __global__ void resetVelocityOpenBndNodes(void) {
 7024:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 7025: 
 7026:       NODE_BND(nodebnd);
 7027: printf("DDDDDDDDDD\n");
 7028:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 7029:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 7030:       }
 7031: 
 7032:    }
 7033: 
 7034: 
 7035:    __global__ void setVelocityOpenBndNodes(void) {
 7036:    // For open boundary nodes sets their velocity to the imposed values.
 7037: 
 7038:       SIDE_BND(sidebnd);
 7039: 
 7040:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 7041:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 7042:          // to its segment to the average of the side velocity.
 7043: 
 7044:          for (int k = 0; k < nvrt; k++) {
 7045:             Node *n1 = sidebnd->side->n1;
 7046:             Node *n2 = sidebnd->side->n2;
 7047: 
 7048: 
 7049:             Vector2 n1_u2(n1->u2[k]);
 7050:             Vector2 n2_u2(n2->u2[k]);
 7051: 
 7052:             if (n1->nodeBnd->segment == sidebnd->segment) {
 7053:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 7054:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 7055:             }
 7056:             if (n2->nodeBnd->segment == sidebnd->segment) {
 7057:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 7058:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 7059:             }
 7060: 
 7061:          }
 7062: 
 7063:       }
 7064: 
 7065:    }
