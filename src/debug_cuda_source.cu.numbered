 2791: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 2792:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 2793:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 2794:    // 
 2795:    // This kernel is called for all nodes.
 2796: 
 2797: 
 2798:    NODE(node1);
 2799: 
 2800: 
 2801:    node1->clearMatrixRow();
 2802:    node1->qel = 0.0;
 2803: 
 2804:    // THIS IS FOR STRUCTURES XXX
 2805:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 2806: 
 2807:    
 2808:    for (int j=0; j<node1->numElements; j++) {
 2809:       // For each element connected to the node...
 2810: 
 2811:       Element *elem = node1->elements[j];
 2812: 
 2813:       // Compute the average gravity
 2814:       printf("UUU Node::grav2 = %f, %f, %f\n", elem->nodes[0]->grav2, elem->nodes[1]->grav2, elem->nodes[2]->grav2);
 2815:       const double grav3 = elem->mean(&Node::grav2);
 2816: 
 2817:       // Look at the documentation for the description of the terms in the following integrals
 2818: 
 2819:       // Integral I_1 
 2820:       // \bar{\breve{H}} 
 2821:       const double hhatb = elem->mean(&Side::hhat);        
 2822: 
 2823: 
 2824:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 2825: 
 2826:       const int id1 = elem->nodeLocalIdx(node1); 
 2827:       const double area = elem->area;
 2828: 
 2829:       if (elem->isTri()) {
 2830: 
 2831:          // To clarify the notation in this section: 
 2832:          //   i stands for the node under consideration (node1)
 2833:          //   j (node2) and k (node3) are the other nodes of the triangle.
 2834:          const int id2 = elem->nxq(1 + id1);
 2835:          const int id3 = elem->nxq(2 + id1);
 2836:          Node *node2 = elem->nodes[id2];
 2837:          Node *node3 = elem->nodes[id3];
 2838: 
 2839:          const Point2 x1 = node1->p2();
 2840:          const Point2 x2 = node2->p2();
 2841:          const Point2 x3 = node3->p2();
 2842: 
 2843:          // integral of phi_i*phi_j
 2844:          const double ipp_ii = (1.0/6.0 )*area;
 2845:          const double ipp_ij = (1.0/12.0)*area;
 2846:          const double ipp_ik = (1.0/12.0)*area;
 2847: 
 2848:          // integral of [(grad phi_i) * (grad phi_j)]
 2849:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 2850:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 2851:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 2852: 
 2853:          // Computes the different components of integral I_1 of each node with respect to node i.
 2854:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 2855:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 2856:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 2857: 
 2858: if (j==node1->numElements-1) {
 2859: printf("grav3 = %f, thetai = %f, dt = %f, hhatb = %f, area = %f, dot1= %f, dot2 = %f, dot3 = %f\n", grav3, thetai, dt, hhatb, area, dot(x3-x2, x3-x2), dot(x3-x2, x1-x3), dot(x1-x3, x1-x3));
 2860: printf("node idx = %d, x1 = %f, %f, x2 = %f, %f, x3 = %f, %f\n", node1->idx, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y);
 2861: printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 2862: }
 2863: 
 2864:          node1->addToSparseMatrix(node1, I1_ii);
 2865:          node1->addToSparseMatrix(node2, I1_ij); 
 2866:          node1->addToSparseMatrix(node3, I1_ik);
 2867: 
 2868: if (j==node1->numElements-1) printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 2869:      
 2870:       }
 2871:       else { // Quad
 2872:          // XXX IMPLEMENT THIS
 2873:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2874:       } 
 2875: 
 2876:  
 2877:       // Integral I_4
 2878:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 2879:       // Where
 2880:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 2881: 
 2882:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 2883:       // of U over the element.
 2884:       Vector2 Umean = {0.0, 0.0};
 2885:       for (int m=0; m<elem->i34; m++) {      
 2886:          const Side *side = elem->sides[m];
 2887: 
 2888:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 2889:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 2890:       }
 2891:       Umean = Umean/elem->i34;
 2892: 
 2893:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 2894: 
 2895:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 2896:       const double I_4_1 = dot(gradPhi_1, Umean);
 2897: 
 2898:       // Integral of \nabla\phi_i \cdot \pmb{E}
 2899:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 2900:      
 2901:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 2902: if (j==node1->numElements-1) printf("MMMMmm  idx_node = %d, I_4_1 = %.15g, I_4_2 = %.15g, node1->qel = %.15g, gradPhi_1 = %.15g, %.15g, elem->ghat1 = %.15g, %.15g\n", node1->idx, I_4_1, I_4_2, node1->qel, gradPhi_1.x, gradPhi_1.y, elem->ghat1.x, elem->ghat1.y);
 2903: 
 2904:       // Additional terms 
 2905:       double vnorm = 0.0;
 2906:       if (imm == 2)  { // Pre-compute vnorm on the element
 2907:          Vector3 ubed;
 2908:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 2909: 
 2910:          Vector3 gradP = {0.0, 0.0, 1.0};
 2911:          for (int m=0; m < elem->i34; m++) {
 2912:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 2913:            gradP += toVector3(gradP_2D, 0.0);
 2914:          }   
 2915:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 2916:       } // imm==2
 2917: 
 2918:       if (elem->isTri()) {
 2919:          for (int l=0; l<3; l++) {
 2920:            double fac;
 2921: 
 2922:            Node *node = elem->nodes[l];
 2923: 
 2924:            (node == node1)? fac=2.0 : fac=1.0;
 2925: 
 2926:            if (imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 2927:            else        node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 2928:            
 2929:          }
 2930: 
 2931: 
 2932:          if (!elem->isDry) {
 2933:            const Vector2 gradEta = elem->nodes[0]->eta2*elem->gradPhi[0] +
 2934:                                    elem->nodes[1]->eta2*elem->gradPhi[1] +
 2935:                                    elem->nodes[2]->eta2*elem->gradPhi[2];
 2936: 
 2937:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 2938:          }
 2939: if (j==node1->numElements-1) printf("&&& node1->qel = %f\n", node1->qel, node1->eta2);
 2940: 
 2941:       } // isTri
 2942:       else { // isQuad
 2943:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2944:          // for (int l=0; l<4; l++) {
 2945:          //   const Node *node = elem->nodes[l];
 2946: 
 2947:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 2948:          //   else        tmp2 = node->bdef2 - node->bdef1;
 2949: 
 2950:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 2951:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 2952:          // }
 2953: 
 2954:       } // isQuad
 2955: 
 2956: 
 2957:       node1->qel += (dt/elem->i34)*elem->vsource;
 2958:       
 2959: 
 2960:    } // for all elements connected to the node
 2961:    
 2962: 
 2963: 
 2964:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 2965:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 2966:    NodeBoundary *nodeBnd = node1->nodeBnd;
 2967:    if (nodeBnd != nullptr)  { 
 2968:       // If it is an open boundary node...
 2969: 
 2970:       // At least one open bnd side, maybe two
 2971:       for (int l=0; l<2; l++) { 
 2972: 
 2973:          // Gets each of the sides sharing the node. 
 2974:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 2975: 
 2976:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 2977: 
 2978:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 2979: 
 2980: 
 2981:          if (sideBnd != nullptr) {
 2982:             // If the side is on a boundary...
 2983: 
 2984:             // Get the boundary segment
 2985:             const BoundarySegment *sideSegment = sideBnd->segment;
 2986:             const Side *side = sideBnd->side;
 2987: 
 2988:             // Integral I_3
 2989:             if (sideSegment->ifltype != 0) {
 2990:             // Natural or Flather b.c.
 2991: 
 2992:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 2993:                // especially for Flather b.c.
 2994:                double ri3 = 0.0;
 2995:                if (!side->isDry) {
 2996:                   // If the side is not dry
 2997:                   
 2998:                   // Computes the side flux of (uth, vth)
 2999:                   double Vn = 0.0;
 3000:                   for (int k = side->kb; k<nvrt-1; k++) {
 3001:                      // uth, vth in lat/lon frame if ics=2
 3002:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 3003:                      const double vn1 = dot(side->uth[k  ], side->n); // outer normal
 3004:                      const double vn2 = dot(side->uth[k+1], side->n);
 3005: 
 3006:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3007:                   }
 3008: 
 3009:                   ri3 = 0.5*side->length*Vn;
 3010:                }
 3011: 
 3012:                if (sideSegment->ifltype == -1) { // Flather 1
 3013: 
 3014:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3015:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3016: 
 3017:                   const double con0 = (1.0/6.0)*side->length*sqrt(grav*side->depth()); // For coefficient matrix
 3018:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3019:                   
 3020:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3021:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3022: 
 3023:                } 
 3024:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3025:                   // Reset ri3
 3026:                   ri3 = 0.0;
 3027: 
 3028:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3029: 
 3030:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3031: 
 3032:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3033:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3034: 
 3035:                   const double con0 = (1.0/6.0)*side->length*tmp*thetai*dt;
 3036:                   node1->addToSparseMatrix(node1, con0*2.0);
 3037:                   node1->addToSparseMatrix(node2, con0);
 3038: 
 3039:                } // if Flather or Discharge
 3040: 
 3041:                node1->qel -= thetai*dt*ri3;
 3042: 
 3043:             } // I_3
 3044:           
 3045: 
 3046:             // Integral I_5
 3047:             if(!side->isDry) {
 3048: 
 3049:                const double Unbar = dot(side->U, side->n);
 3050: 
 3051:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->length*Unbar;
 3052:                
 3053:             } // I_5
 3054: 
 3055:          } // if is boundary side
 3056: 
 3057:       } // for l
 3058: 
 3059:    } // if isbnd
 3060: 
 3061: 
 3062:    printf("44444444 idx_node = %d, node1->qel = %f\n", node1->idx, node1->qel);
 3063: 
 3064: }
 3065: 
 3066: 
 3067: 
 3068: extern "C" {
 3069:    __global__ void rollUpElevation(void) {
 3070: 
 3071:       NODE(node);
 3072: 
 3073:       node->eta2 += node->eta1;
 3074: 
 3075:    }
 3076: 
 3077: 
 3078:    __global__ void backtrackAllNodes(void) {
 3079: 
 3080:       // max/min # of sub-divisions
 3081:       const int ndelt_max = max(1.0, dt/dtb_min);
 3082:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3083: 
 3084:       // Removed all references to swild98 XXX
 3085:       // swild98=0.d0 !init
 3086: 
 3087: 
 3088:       SIDE(side);
 3089: 
 3090:       const int kb = side->kb;
 3091: 
 3092:       printf("backtrackAllNodes: side->idx = %d, nvrt = %d\n", side->idx, nvrt);
 3093: 
 3094:       // Initialize btrack velocities to the actual velocities at the side 
 3095:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3096: 
 3097: 
 3098:       if (side->isDry) return;
 3099: 
 3100: 
 3101:       // Checks that at least one element is not dry
 3102:       const Element *elem1 = side->elems[0];
 3103:       const Element *elem2 = side->elems[1];
 3104: 
 3105: 
 3106:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3107:       
 3108:       // XXXXXX
 3109:       // !swild_tmp to store global coord. of the starting side
 3110:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3111:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3112:       // !Use sframe2 
 3113:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3114: 
 3115: 
 3116:       for (int k = kb; k < nvrt; k++) {
 3117:       //  Initialize (xt,yt,zt), nnel and vel.
 3118:       //  For ics=2, the coordinates are in local frames
 3119:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3120: 
 3121: 
 3122:          const int iadvf = side->iadv();  // Advection flag
 3123: 
 3124:          Point3 xt;
 3125:          if constexpr(ics==1) {
 3126:             xt = side->center3D(k); 
 3127:          }
 3128:          else // lat/lon; in side lat/lon frame
 3129:          {
 3130:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3131:          // XXX IMPLEMENT THIS
 3132:       //          xt=0.d0
 3133:       //          yt=0.d0
 3134:       //          !centroid coord. for nudging
 3135:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3136:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3137:          }  // ics
 3138: 
 3139: 
 3140:          // Velocity at the side (in ll frame for ics, same vertical direction)
 3141:          // XXX IS THIS NECESSARY?
 3142:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 3143: 
 3144:          // If on land or open boundary...
 3145:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3146:          
 3147:          const double vmag = length(toVector2(u_int));
 3148: 
 3149:          if (vmag <= velmin_btrack) {
 3150:             // No activity 
 3151: 
 3152:             side->btu[k] = side->u2[k];
 3153: 
 3154:             
 3155:          } else {  // do btrack
 3156: 
 3157:           
 3158:             // Compute number of sub-divisions based on local gradients 
 3159:             // XXX IS THIS NECESSARY?
 3160:             double suma = 0.0;
 3161:             int icount = 0;
 3162:             for (int ii=0; ii<2; ii++) {
 3163: 
 3164:                const Element *elem = side->elems[ii];
 3165:                  
 3166:                if (elem == nullptr) continue;
 3167: 
 3168:                icount++;
 3169: 
 3170:                // Not strictly along z; in ll frame for ics=2
 3171: 
 3172:                double utmp[4];
 3173:                double vtmp[4];
 3174:                for (int jj = 0; jj < elem->i34; jj++) {
 3175: 
 3176:                   const Node *node = elem->nodes[jj];
 3177: 
 3178:                   if constexpr(ics==1) {
 3179:                      utmp[jj] = node->u2[k].x;
 3180:                      vtmp[jj] = node->u2[k].y;  
 3181:                   } else {
 3182:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3183:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3184:                   }
 3185:                } // for jj
 3186: 
 3187:                const Vector2 grad_u = elem->grad2(utmp); 
 3188:                const Vector2 grad_v = elem->grad2(vtmp);
 3189: 
 3190:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3191:             } // for ii
 3192: 
 3193:             assert(icount > 0 && "Impossible 77");
 3194: 
 3195:             // '4' is somewhat arbitrary
 3196:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3197: 
 3198:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3199:          
 3200: 
 3201:             Vector3 u_int = {0.0, 0.0, 0.0};
 3202: 
 3203:             side->btrack(k, dt, dtbk, u_int);
 3204: 
 3205:                
 3206:          } // if vmag (do backtrack)
 3207: 
 3208:       } // for j=jmin,nvrt-1
 3209: 
 3210:    }
 3211: } // extern "C"
 3212: 
 3213: template<int nc>
 3214: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3215: 
 3216: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3217: //
 3218: // a,b,c,rhs: input vectors and are not modified by this program.
 3219: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3220: // rhs is the r.h.s.
 3221: // n: actual rank of the system.
 3222: // rows in u() and rhs();
 3223: // u: output with nc columns (transposed to rows)
 3224: // gam: a working array.
 3225: //
 3226: // NOTES:
 3227: // This is a template function that allows for different numbers of columns in the rhs vector.
 3228: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3229: 
 3230:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3231:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3232: 
 3233:    double bet = b[0];
 3234:    if constexpr (nc == 1) {
 3235:       u[0] = rhs[0]/bet;
 3236:    } else {
 3237:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 3238:    }
 3239: 
 3240:    for (int j = 1; j < n; j++) {
 3241:       gam[j] = c[j-1]/bet;
 3242:       bet = b[j] - a[j]*gam[j];
 3243: 
 3244:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3245: 
 3246:       if constexpr (nc == 1) {
 3247:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3248:       } else {
 3249:          for (int k = 0; k < nc; k++) {
 3250:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 3251:          }
 3252:       }
 3253:    }
 3254: 
 3255:    // Back-substitution
 3256:    for (int j=n-1; j>=1; j--) {
 3257:       if constexpr (nc == 1) {
 3258:          u[j] = u[j] - gam[j+1]*u[j-1];
 3259:       } else {
 3260:          for (int k = 0; k < nc; k++) {
 3261:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 3262:          }
 3263:       }
 3264:    }
 3265: }
 3266: 
 3267: 
 3268: 
 3269: // Helper function that contains the core algorithm
 3270: template<typename XAccessor, typename YAccessor>
 3271: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3272:                                     double  yp_top, double  yp_bot, 
 3273:                                     CubicSpline &spline) {
 3274:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3275:    // 
 3276:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3277:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3278:    //
 3279:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3280:    // 
 3281:    // Inputs: 
 3282:    //            n: dimension for x etc; # of data pts (>=2);
 3283:    //            getX, getY: functions to access x,y coordinates
 3284:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3285:    //     Output: 
 3286:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3287: 
 3288:    const int n = k2 - k1 + 1;
 3289:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3290: 
 3291:    // Allocate memory for the splines
 3292:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3293:    spline.x   = new double[n];
 3294:    spline.y   = new double[n];
 3295:    spline.yp  = new double[n];
 3296:    spline.ypp = new double[n];
 3297: 
 3298:    for (int k=k1; k<=k2; k++) {
 3299:       spline.x[k] = getX(k);
 3300:       spline.y[k] = getY(k);
 3301:    }
 3302: 
 3303:    // This is to simplify expressions later
 3304:    double *x = spline.x;
 3305:    double *y = spline.y;
 3306: 
 3307:    double *a = nullptr;
 3308:    double *b = nullptr;
 3309:    double *c = nullptr;
 3310:    double *gam = nullptr;
 3311:    double *rhs = nullptr;
 3312:    
 3313: 
 3314:       a = new double[n];   // Lower diagonal
 3315:       b = new double[n];   // Diagonal
 3316:       c = new double[n];   // Upper diagonal
 3317:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3318:       rhs = new double[n]; // Right-hand side
 3319: 
 3320:    for (int k=k1; k<=k2; k++) {
 3321:       if (k == k1) {
 3322:          // Bottom level
 3323:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3324:          b[k] = (x[k+1] - x[k])/3.0;
 3325:          c[k] = b[k]/2.0;
 3326:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3327:       } else if (k == n - 1) {
 3328:          // Top level (surface)
 3329:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3330:          b[k] = (x[k] - x[k-1])/3.0;
 3331:          a[k] = b[k]/2.0;
 3332:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3333:       } else {
 3334:          // Intermediate levels
 3335:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3336:          b[k] = (x[k+1] - x[k-1])/3.0;
 3337:          a[k] = (x[k  ] - x[k-1])/6.0;
 3338:          c[k] = (x[k+1] - x[k  ])/6.0;
 3339:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3340:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3341:       }
 3342:    }
 3343: 
 3344:    // Solve the tridiagonal system
 3345:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3346:    
 3347:    spline.yp[k1] = yp_bot;
 3348:    spline.yp[k2] = yp_top;
 3349: 
 3350:    // Compute rest of 1st derivatives using the splines
 3351:    for (int k=k1+1; k<k2; k++) {
 3352:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3353:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3354:    }
 3355:    
 3356:    delete[] a;
 3357:    delete[] b;
 3358:    delete[] c;
 3359:    delete[] gam;
 3360:    delete[] rhs;
 3361: 
 3362: }
 3363: 
 3364: // Array version
 3365: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3366:                                 double y_top, double y_bot, 
 3367:                                 CubicSpline &spline) {
 3368:    auto getX = [x] (int k) { return x[k]; };
 3369:    auto getY = [y] (int k) { return y[k]; };
 3370:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3371: }
 3372: 
 3373: // Lambda version - allows custom access patterns
 3374: template<typename XFunc, typename YFunc>
 3375: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3376:                                 double y_top, double y_bot,
 3377:                                 CubicSpline &spline) {
 3378:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3379: }
 3380: 
 3381: 
 3382: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 3383: {
 3384:    assert("Not implemented");
 3385: 
 3386:    return 0.0;
 3387: }
