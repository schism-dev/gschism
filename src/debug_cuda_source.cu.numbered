 1789: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1790:    // Computes the 3D normal vector to the element at level k
 1791:    // Returns the normal vector and the area of the element
 1792: 
 1793:       if (isTri()) {
 1794:          // For triangles...
 1795: 
 1796:          // Gets the normal vector to the element (with a length equal to twice the area)
 1797:          if constexpr(ics==1) {
 1798:             const int kb0 = max(k, nodes[0]->kb);
 1799:             const int kb1 = max(k, nodes[1]->kb);
 1800:             const int kb2 = max(k, nodes[2]->kb);
 1801: 
 1802:             const Vector3 n20 = nodes[2]->p3D(k) - nodes[0]->p3D(k);
 1803:             const Vector3 n10 = nodes[1]->p3D(k) - nodes[0]->p3D(k);
 1804:             
 1805:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1806:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1807:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1808:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1809: 
 1810:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1811:             area3D = 0.5*len;
 1812: 
 1813:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1814: 
 1815:             return {nx/len, ny/len, nz/len};
 1816: 
 1817:            
 1818:          }
 1819:          else {  // lat/lon
 1820:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1821:             return {0.0, 0.0, 0.0};
 1822: 
 1823:          } // if ics
 1824:       }
 1825:       else {
 1826:          // For quads...
 1827: 
 1828:          assert(false && "Element normal vector: quads not yet implemented");
 1829:          return {0.0, 0.0, 0.0};
 1830: 
 1831: 
 1832:       }
 1833:    }
 1834: 
 1835: /**
 1836:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1837:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1838:    If the segment is completely inside the element, then it returns true.
 1839: 
 1840:    This function assumes:
 1841:    - The initial point is on a side of the element. 
 1842:    - Its position is given by parameter t in the range [0,1].
 1843:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1844:       intersects the element (elements are convex).
 1845: 
 1846:    To find the intersection point, this function does the following:
 1847:    - it finds the intersection of the line segment with all the element side lines,
 1848:       except for the one that contains the initial point.
 1849:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1850:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1851:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1852:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1853:       track segment is almost parallel to the element side line.
 1854: 
 1855:    Inputs:
 1856:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1857:    @param x2, y2: other end of the line segment
 1858: 
 1859:    Outputs:
 1860:    @param side:  side that intersects the line segment (input and output)
 1861:    @param nextElement (output): element that contains the intersection point
 1862:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1863:    @param zint (input/output): Vertical coordinate of the intersection point
 1864: 
 1865:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1866:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1867:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1868: 
 1869:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1870:    (Delta) being zero.
 1871: 
 1872:    The intersection2 point happens when:
 1873:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1874:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1875:    
 1876:    Assumption: the 4 points (including those of the side segment) are different.
 1877:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1878:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1879:    If true, (xIntersect,yIntersect) is the intersection.				
 1880:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1881: **/
 1882: 
 1883: 
 1884: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1885:                                               double &t, double& tIntersect) {
 1886:    assert( containsPoint(x1) && "Starting point is not inside the element");                                    
 1887:    assert(!containsPoint(x2) && "Ending point is not outside the element");
 1888: 
 1889:    double closest_intersect_t = 1e10;
 1890:    bool found_intersection = false;
 1891: 
 1892:    for (int i = 0; i < i34; i++) {
 1893: 
 1894:       Side *side2 = sides[i];
 1895: 
 1896:       // (x3,y3)-(x4,y4) is the element side line
 1897:       const Point2 x3 = side2->n1->p;
 1898:       const Point2 x4 = side2->n2->p;
 1899: 
 1900:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1901:       const double delta = cross(x2 - x1, x3 - x4);
 1902: 
 1903:       if (abs(delta) > 0) {
 1904: 
 1905:          const double delta1 = cross(x3 - x1, x3 - x4);
 1906:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1907: 
 1908:          // Solves the two linear equations for tt1 and tt2
 1909:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1910:          const double tt2 = delta2/delta;
 1911: 
 1912:          if (tt1 >= -small2 && tt2 >= -small2 && tt2 <= 1.0 + small2 && tt1 <= 1.0 + small2) {
 1913:             closest_intersect_t = min(closest_intersect_t, tt1);
 1914:             side = side2;
 1915:             nextElement = side->otherElem(this);
 1916:             t = clamp(tt2, 0.0, 1.0);
 1917:             tIntersect = clamp(tt1, small, 1.0-small);
 1918:             found_intersection = true;
 1919:          }
 1920: 
 1921:       
 1922:       }
 1923:       else {  // parallel segments
 1924: 
 1925:          assert(false && "Parallel segments should not happen under the new code");
 1926:          // In this case, we check if they are colinear. if they are, we compute the intersection point as:
 1927:          // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1928: 
 1929:          // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1930:          const double dist = dot(x1 - x3, side2->n);
 1931:          if (abs(dist) < small*length(x3 - x4)) {
 1932:             const double2 unitarySide = normalize(x4 - x3);
 1933:             const double len = dot(x2 - x1, unitarySide);
 1934:             t = t + len;
 1935:             t = max(0.0, min(t, 1.0));
 1936:             printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1937: 
 1938: 
 1939:             // tIntersect = max(small, min(tt1, 1.0-small));
 1940:             // t = tt2;
 1941:             found_intersection = true;
 1942:          }
 1943:       }
 1944: 
 1945: 
 1946:    }
 1947: 
 1948: 
 1949:    assert(found_intersection && "No intersection found");
 1950: 
 1951:    // found_intersection should always be true, since we checked all the sides.  
 1952:    return found_intersection;
 1953: }
 1954: 
 1955: 
 1956: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1957:                                              Point3 &xt, double zint, Vector3 &u_int) {
 1958: 
 1959:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1960:    // Instead, we nudge the intersection point to the barycenter of the current element, and nextElement becomes
 1961:    // curElement.
 1962: 
 1963:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1964:    // And uses this velocity instead to continue the tracking.
 1965: 
 1966:    // computes the intersection point in cartesian coordinates
 1967:    Point2 intersection = nextSide->p_t(tt);  // XXXX I don't think this is necessary. THE intersection is already computed in findNextIntersection.
 1968: 
 1969:    // Nudges the point to the barycenter of the element. 
 1970:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1971:    // next segment intersects the element sides. 
 1972:    // TODO: curElem->nudgeToBarycenter(intersection);  REMEMBER!!! RECOVER??? XXX KKKKK
 1973: 
 1974: 
 1975:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1976:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1977:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1978:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1979: 
 1980:    // If the side is an open boundary, the tangential velocity is set to zero.
 1981:    if (nextSide->isBnd()) vtan = 0.0;
 1982: 
 1983:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1984:    const double us = vtan*nextSide->t().x;
 1985:    const double vs = vtan*nextSide->t().y;
 1986:    const double ws = 0.5*(nextSide->n1->w2[jlev] + nextSide->n2->w2[jlev]);  //  XXXX Why not use the side's velocity?
 1987: 
 1988:    
 1989:    // The end of this tracking segment is now the intersection point.
 1990:    xt = {intersection.x, intersection.y, zint};
 1991: 
 1992: 
 1993:    u_int = {us, vs, ws};
 1994:    
 1995: }
 1996: 
 1997: /**
 1998:  * Tracks a particle through elements and vertical levels in the mesh.
 1999:  * 
 2000:  * @param x0,y0,z0     Starting position coordinates
 2001:  * @param xt,yt,zt     Target position coordinates
 2002:  * @param dtb          Time step for tracking
 2003:  * @param u_int        Initial velocity components
 2004:  * @param nextElem     Starting/resulting element index
 2005:  * 
 2006:  * @return Status code of type trackExitCodes
 2007:  * 
 2008:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2009:  * of the details are different. The idea is that the code requires less branches and is better fit
 2010:  * for GPU execution.
 2011:  * 
 2012:  * The main ideas here are:
 2013:  * - The starting point is expected to be in the starting element.
 2014:  * - since the starting point is inside the element, there are only two cases: 
 2015:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2016:  *     (b) it does not and (xt,yt) is already in the starting element.
 2017:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2018:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2019:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2020:  * - tt1 can be positive or negative. We only consider the positive values.
 2021:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2022:  * - The next intersection will occur at the smallest positive tt1.
 2023:  * - This intersection will be the next (x0,y0) position.
 2024:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2025:  *   of getting stuck in a loop.
 2026:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2027:  *   was found.
 2028:  * - Notice that curElement is the current element, while this is the element for which the first call to this function was made.
 2029:  */
 2030: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2031:                                                        Element *&nextElem, int &jlev, double &dt, double time_rm,
 2032:                                                        const Side *origSide) {
 2033:                                                             
 2034:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2035:    // else to do. This means that the full step occurred within the current element.
 2036:    assert(!isDry && "Starting element is dry");
 2037:    if (containsPoint(toPoint2(xt), true)) {  // The "true" means that, if the point is very close to the boundary, it is nudged to be definitely inside the element.
 2038: 
 2039:       assert(containsPoint(toPoint2(xt)) && "Target point is not inside the element");
 2040:       assert(!isDry && "Target point is inside a dry element");
 2041: 
 2042:       interpolateVelocities(xt, u_int);
 2043: 
 2044:       nextElem = this;
 2045: 
 2046: // if (jlev==10) addDebugPlot(x0, xt, 0x00FF00); // green
 2047:       return true;
 2048:    }
 2049: 
 2050: 
 2051:    assert(containsPoint(toPoint2(x0)) && "XXXX Starting point is not inside the element");
 2052: 
 2053:    assert(norm2(toVector2(xt - x0)) > 0.0 && "Zero length track"); 
 2054:    
 2055:    // const int MAX_ITERATIONS = 1000;
 2056:    
 2057:    double t;
 2058:    Side *nextSide = nullptr;
 2059:    double tIntersect = 1e10;
 2060: 
 2061: 
 2062:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2063:    // (x0,y0) is inside the element but the target point is not.
 2064:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2065:    assert(found_intersection && "No intersection found at %d");
 2066: 
 2067:    dt *= tIntersect; // reduces the time step to the time it takes to reach the intersection
 2068: 
 2069:    Point2 xtmp = nextSide->p_t(t); // moves the target point to the intersection point
 2070: 
 2071:    // If the next element is not dry, nudge it to the barycenter to ensure that the point is inside the element.
 2072:    if (nextElem != nullptr && !nextElem->isDry) nextElem->nudgeToBarycenter(xtmp);
 2073:    
 2074: 
 2075:    const double zint = (1 - tIntersect)*x0.z + tIntersect*xt.z;
 2076:    xt = {xtmp.x, xtmp.y, zint};
 2077: 
 2078:    // if the tracking segment goes out of water (either dry or edge boundary)
 2079:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2080: 
 2081: 
 2082:       trackGoesOutOfWater(nextSide, this, t, jlev, xt, zint, u_int);
 2083: 
 2084: 
 2085:       // When this happens, the backtracking stops.
 2086:       dt = time_rm;
 2087: 
 2088:       // In this case, the next element is again the current element.
 2089:       nextElem = this;
 2090: 
 2091:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2092:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2093:       return true;    
 2094:    }
 2095: 
 2096: 
 2097:    assert(nextElem->containsPoint(toPoint2(xt)) && "Target point is not inside the next element");
 2098:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2099:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2100: 
 2101:    nextElem->interpolateVelocities(xt, u_int); 
 2102: 
 2103:    assert(nextElem != this && "Next element is the same as the current element");
 2104: 
 2105:    return true;
 2106: }
 2107: 
 2108: 
 2109: __inline__ __device__ double Element::computeSignedArea(void) const {
 2110:    // Compute the area of the element
 2111: 
 2112:    double res = signedArea(nodes[0]->p, nodes[1]->p, nodes[2]->p);
 2113: 
 2114:    // In the quad case we need to add the area of the other triangle.
 2115:    if (isQuad()) {
 2116:       double ar1 = signedArea(nodes[0]->p, nodes[2]->p, nodes[3]->p);
 2117:       double ar2 = signedArea(nodes[0]->p, nodes[1]->p, nodes[3]->p);
 2118:       double ar3 = signedArea(nodes[1]->p, nodes[2]->p, nodes[3]->p);
 2119:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2120: 
 2121:       res += ar1;
 2122:    }
 2123: 
 2124:    return res;
 2125: }
 2126: 
 2127: 
 2128: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2129:                                                                 (nodes[1]->isDry2()) ||
 2130:                                                                 (nodes[2]->isDry2()) ||
 2131:                                                                 (i34==4 && nodes[3]->isDry2());
 2132: }
 2133: 
 2134: __inline__ __device__ double Element::detJ_eta(void) const {
 2135:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2136:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2137: }
 2138: 
 2139: __inline__ __device__ double Element::detJ_xi(void) const {
 2140:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2141:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2142: }
 2143: 
 2144: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2145:    // In boundary sides, the element 1 is nullptr
 2146:    return side->elems[1] == nullptr; 
 2147: }
