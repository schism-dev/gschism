 2277: // Convenience macros for accessing the objects in kernels.
 2278: 
 2279: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 2280:                    Side *side = &(mesh->localSideData[idx_side]); \
 2281:                    if (idx_side >= mesh->ns) return;
 2282: 
 2283: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 2284:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 2285:                    if (idx_elem >= mesh->ne) return;
 2286: 
 2287: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 2288:                    Node *node = &(mesh->localNodeData[idx_node]); \
 2289:                    if (idx_node >= mesh->np) return;
 2290: 
 2291: #define NODE_ALL(node, valid) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x;       \
 2292:                               Node *node = &(mesh->localNodeData[idx_node]); \
 2293:                               const bool valid = (idx_node < mesh->np);                   
 2294: 
 2295: 
 2296: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 2297:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 2298:                            if (idx_node_bnd >= mesh->nbp) return;
 2299: 
 2300: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 2301:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 2302:                            if (idx_side_bnd >= mesh->nbs) return;  
