 5099:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 5100: 
 5101:       NODE(node);
 5102: 
 5103:       node->ETP = 0.0;
 5104: 
 5105:       if constexpr(ntip == 0) return;
 5106: 
 5107:       // For all tidal potential components
 5108:       for (int j=0; j<ntip; j++) {
 5109: 
 5110:          const double nodeETP = node->computeETP(j, time, tfreq, tamp, tnf, tear, jspc);
 5111: 
 5112:          node->ETP += nodeETP;
 5113: 
 5114:          if constexpr(iloadtide==1) { // loading tide
 5115:             assert(false && "Loading tide not implemented");
 5116:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5117:          }
 5118:          
 5119:       }
 5120: 
 5121:      
 5122:    }
