 2581: __inline__ __device__ bool Element::containsPoint(Vector2 xt, const Side *origSide) const { 
 2582:    // Check if the point (xt,yt) is inside the element.
 2583:    // if ics==2, origSide is used to convert the point to the starting point's frame.
 2584:    assert((ics==2 || origSide==nullptr) && "origSide must be nullptr if ics == 1 and vice versa (2)");
 2585: 
 2586:    double shpCoords[4];
 2587:    bool res = computeShapeCoords(xt, shpCoords, fiNo, origSide);
 2588: 
 2589:    return res;
 2590: }
 2591: 
 2592: __inline__ __device__ bool Element::containsPoint(Vector2 &xt, bool fixCoords, const Side *origSide) const { 
 2593:    // Check if the point (xt,yt) is inside the element.
 2594:    // If fixCoords is true, and *the point is inside the element*, the point is nudged to be inside the element.
 2595:    // if ics==2, origSide is used to convert the point to the starting point's frame.
 2596:    assert((ics==2 || origSide==nullptr) && "origSide must be nullptr if ics == 1 and vice versa (3)");
 2597: 
 2598:    double shpCoords[4];
 2599:    Vector2 tmp_xt = xt;
 2600:    const EFixIf fixIfCoords = fixCoords ? fiOnlyInside : fiNo;
 2601: printf("HEREEEEEE\n");
 2602:    bool res = computeShapeCoords(tmp_xt, shpCoords, fixIfCoords, origSide);
 2603: 
 2604:    if (fixCoords && res) xt = tmp_xt;
 2605: 
 2606:    return res;
 2607: }
