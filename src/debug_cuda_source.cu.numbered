 1429: struct Mesh {
 1430:    public:  
 1431: 
 1432:    int partNum; // Partition number for this mesh.
 1433: 
 1434:    // Pointers to each GPU's local memory (size is the number of partitions).
 1435:    Node**    nodes;  
 1436:    Element** elems;  
 1437:    Side**    sides;  
 1438:    
 1439:    // Local memory
 1440:    Node*    localNodeData; 
 1441:    Element* localElemData;
 1442:    Side*    localSideData; 
 1443: 
 1444:    NodeBoundary *localNodeBoundaryMem; // Array of objects with the boundary information of each node
 1445:    SideBoundary *localSideBoundaryMem; // Array of objects with the boundary information of each side
 1446:    double       *coeffMatrixMem;       // Matrix coefficients for neighbors. [0..numNodes-1], doesn't include the diagonal
 1447:    BoundarySegment *localSegmentMem;   // Array of objects with the boundary segments
 1448:    
 1449:    const int npgb;  // Global number of horizontal nodes
 1450:    const int negb;  // Global number of elements
 1451:    const int nsgb;  // Global number of sides
 1452: 
 1453:    const int np;   // Local number of horizontal nodes 
 1454:    const int ne;   // Local number of elements
 1455:    const int ns;   // Local number of sides
 1456: 
 1457:    int nbp;  // Local number of boundary nodes
 1458:    int nbs;  // Local number of boundary sides
 1459: 
 1460:    int nEntries;  // Total number of matrix elements
 1461: 
 1462:    const int max_np; // Maximum number of horizontal nodes per partition (shared by all partitions)
 1463:    const int max_ne; // Maximum number of elements per partition (shared by all partitions)
 1464:    const int max_ns; // Maximum number of sides per partition (shared by all partitions)
 1465: 
 1466:   
 1467:    // Additional topology information
 1468:    Node    **nodeNeighNodes; // Array of pointers to the nodes neighbors of each node
 1469:    Element **nodeNeighElems; // Array of pointers to the elements neighbors of each node
 1470: 
 1471:    BoundarySegment landBoundarySegment;
 1472:    NodeBoundary landBoundaryNode;
 1473: 
 1474:    // Vertical coordinate system
 1475:    // Sigma levels
 1476:    double h_s; 
 1477:    double h_c; 
 1478: 
 1479:    double theta_b;
 1480:    double theta_f, sinh_theta_f;
 1481:    double *sigma;  // There is a sigma_local on each node for the case ivcor=1
 1482:    double *ztot;
 1483:    double *cs;
 1484:    double *dcs;
 1485: 
 1486:    // // Get's the pointer to the node using the array of global pointers to nodes
 1487:    // __device__ const Node *getGlobalNode(int jn) {
 1488:    //    const int idx = jn / max_np; // Get the index of the partition that contains the node
 1489:    //    return nodes[idx] + idx;
 1490:    // }
 1491: 
 1492:    // // Get's the pointer to the element using the array of global pointers to elements
 1493:    // __device__ const Element *getGlobalElem(int je) {
 1494:    //    const int idx = je / max_ne; // Get the index of the partition that contains the element
 1495:    //    return elems[idx] + idx;
 1496:    // }
 1497: 
 1498:    // // Get's the pointer to the side using the array of global pointers to sides
 1499:    // __device__ const Side *getGlobalSide(int js) {
 1500:    //    const int idx = js / max_ns; // Get the index of the partition that contains the side
 1501:    //    return sides[idx] + idx;
 1502:    // }
 1503: 
 1504:    // // Get's the global index of local node idx
 1505:    // __device__ int getGlobalNodeIndex(int idx) {
 1506:    //    return idx + partNum * max_np;
 1507:    // }
 1508: 
 1509:    // // Get's the global index of local element idx
 1510:    // __device__ int getGlobalElemIndex(int idx) {
 1511:    //    return idx + partNum * max_ne;
 1512:    // }
 1513: 
 1514:    // // Get's the global index of local side idx
 1515:    // __device__ int getGlobalSideIndex(int idx) {
 1516:    //    return idx + partNum * max_ns;
 1517:    // }  
 1518: 
 1519:    __device__ Mesh(int partNum,
 1520:                    int npgb, int negb, int nsgb, 
 1521:                    int np, int ne, int ns,
 1522:                    int max_np, int max_ne, int max_ns, int nseg,
 1523:                    Node **nodesPtr, Element **elemsPtr, Side **sidesPtr,
 1524:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 1525:                    Node    **localNodeNeighNodesMem,
 1526:                    Element **localNodeNeighElemsMem,
 1527:                    double *partCoeffMatrixMem,
 1528:                    NodeBoundary *localNodeBoundaryMem,
 1529:                    SideBoundary *localSideBoundaryMem,
 1530:                    BoundarySegment *localSegmentMem,
 1531:                    int *kb, double h_c, double h_s, double theta_b, double theta_f, double *sigma, double *ztot,
 1532:                    double *cs, double *dcs
 1533:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 1534:                        np(np), ne(ne), ns(ns),
 1535:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
 1536:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
 1537:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
 1538:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
 1539:                        localNodeBoundaryMem(localNodeBoundaryMem), localSideBoundaryMem(localSideBoundaryMem),
 1540:                        localSegmentMem(localSegmentMem),
 1541:                        h_c(h_c), h_s(h_s), theta_b(theta_b), theta_f(theta_f), sigma(sigma), ztot(ztot),
 1542:                        cs(cs), dcs(dcs),
 1543:                        coeffMatrixMem(partCoeffMatrixMem),
