 4713:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4714: 
 4715:       SIDE(side);
 4716: 
 4717:       side->U = {0.0, 0.0}; 
 4718:          
 4719:       if(side->isDry) return;
 4720: 
 4721:       // Vertically integrated velocity U
 4722:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4723:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 4724:          side->U += side->Dz(k + 1)*uc;  
 4725:       }
 4726: 
 4727:    }
 4728: 
 4729:    __global__ void computeBottomDragVegetation(void) {
 4730:       // UNFINISHED. CHECK THIS:
 4731:       // How many kernels are needed? Why so many for loops?
 4732:       // Is the loop on sides needed?
 4733: 
 4734:       NODE(node);
 4735: 
 4736: 
 4737:       const int    kb      = node->kb;
 4738:       const double htot    = node->htot2(); 
 4739:       
 4740:       if (node->isDry) {
 4741:          // Default values for dry nodes
 4742:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4743:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4744: 
 4745:          return;
 4746:        
 4747:       }
 4748: 
 4749:       // Computes bottom drag Cd based on the selected nchi
 4750:       node->computeBottomDragCd();
 4751:       
 4752: 
 4753: 
 4754:       //   Bottom stress in m^2/s^2
 4755:       if (node->rho[kb + 1] >= -98.0)
 4756:       {
 4757:          const double mag_u = length(node->u2[kb + 1]);
 4758:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 4759: 
 4760:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4761:          // !sediment erosion: this part needs more documentation
 4762:       }
 4763:     
 4764: 
 4765: 
 4766:       // Compute vegetation parameters
 4767:       //--------------------------------
 4768: 
 4769:       // SAV constants
 4770:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4771:       constexpr double veg_cfpsi = 0.16;
 4772: 
 4773:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4774:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4775: 
 4776:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4777:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4778:          int kbin = 0; // bin index
 4779:          for (int k = kb; k < nvrt; k++) {
 4780:             // Computes node height above the bottom level
 4781:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4782:             assert(false && "Vertical variation of vegetation not implemented");
 4783: 
 4784:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4785:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4786:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4787:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4788:             // } else {
 4789:             //    // Find the bin at which the current vertical level is
 4790:             //    while (kbin<nbins_veg_vert) {
 4791:             //       const double zn = node->z[kbin];
 4792:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4793:             //          break;
 4794:             //       } // if
 4795:             //       kbin++;
 4796:             //    } // while
 4797:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4798: 
 4799:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4800:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4801:                
 4802:             //    // Linear interpolation of the vegetation parameters
 4803:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4804:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4805:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4806:             // } // if rl10
 4807: 
 4808:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4809: 
 4810:          } // for k
 4811: 
 4812: 
 4813:       } else { // Ganthy (iveg==2)
 4814:       //  Modify canopy height, diameter, and density
 4815: 
 4816:          // Make sure there is vegetation on this node
 4817:          if (node->veg_h_unbent > 0.0) {
 4818:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4819: 
 4820:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4821:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4822:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4823: 
 4824:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4825:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4826:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4827:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4828:          } // if veg_h_unbent
 4829: 
 4830:          for (int k = 0; k < nvrt; k++) {
 4831:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4832:          } // for k
 4833:       
 4834: 
 4835:       } // if iveg
 4836:      
 4837: 
 4838:       // Compute vertical mean of veg_alpha3D
 4839:       if (iveg != 0) {
 4840:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4841:          double sum1=0.0;
 4842:          double sum2=0.0;
 4843:          // Integrate over each level under the canopy...
 4844:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 4845:             const double Dz = node->Dz(k);
 4846: 
 4847:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 4848:             sum2 += Dz;
 4849: 
 4850:          } // for k
 4851:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4852:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4853: 
 4854:       } // if iveg
 4855: 
 4856:    }
 4857: 
 4858:    __global__ void computeVegetationAndDragParameters(void) {
 4859:       // Computes the vegetation and drag model parameters:
 4860:       // chi, \tilde\chi, beta, \breve{H}
 4861:       
 4862:       SIDE(side);
 4863: 
 4864:       side->hhat = 0.0;
 4865:       side->chi2 = 0.0;
 4866:       side->chi = 0.0;
 4867:       side->veg_c2 = 0.0;
 4868:       side->veg_beta = 0.0;
 4869: 
 4870:       if (side->isDry) return;
 4871: 
 4872:       const double htot = side->htot2();
 4873:       const int    kb   = side->kb;
 4874: 
 4875:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4876: 
 4877:       const double veg_h     = side->veg_h();
 4878:       const double veg_nv    = side->veg_nv();
 4879:       const double veg_c     = side->veg_c();
 4880:       const double veg_beta  = side->veg_beta;
 4881:       const double veg_alpha = side->veg_alpha_vert_mean();
 4882: 
 4883:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4884:       // Velocity magnitude at the bottom level
 4885:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4886:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 4887:       side->chi2 = side->Cd()*vmag1;
 4888:       side->chi  = side->chi2;
 4889:       if constexpr(iveg != 0) {
 4890:          const Node *n1 = side->n1;
 4891:          const Node *n2 = side->n2;
 4892:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4893:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4894:       }
 4895: 
 4896:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4897: 
 4898:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4899:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4900:       double magUa = 0.0;
 4901:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4902:          // 3D wet side with veg...
 4903: 
 4904:          double magUa = 0.0;
 4905:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4906:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4907: 
 4908:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4909:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4910:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4911: 
 4912:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4913:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4914: 
 4915:                // Velocity magnitude at the bottom (l) of the level
 4916:                const double ul = length(side->u2[k]);
 4917: 
 4918:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4919:                magUa += Dz*0.5*(uh + ul);
 4920: 
 4921:             } // if HasVegetation
 4922:          } // for k
 4923:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4924: 
 4925:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4926:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4927:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4928:             const double zCpy = side->zTopCanopy();
 4929:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4930:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4931:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4932:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4933:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4934:          } // if isSubmerged
 4935:       } // if iveg   
 4936: 
 4937:       // Computes the friction modified depth, \breve{H} in notes
 4938:       if (side->is2D()) { // 2D
 4939: 
 4940:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4941:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4942: 
 4943:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4944: 
 4945:          side->hhat = htot*htot/fricH; 
 4946: 
 4947:       } else { // 3D
 4948:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 4949: 
 4950:          if constexpr(iveg != 0) {
 4951:             
 4952:             if (side->isSubmerged()) { 
 4953:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4954:                side->hhat -= veg_c*Hhat_alpha;
 4955: 
 4956:             } else { // Emergent
 4957:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4958:             }
 4959:          } // if iveg
 4960: 
 4961:          // Enforce positivity for 3D model
 4962:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 4963:       } // if 3D
 4964: 
 4965:    }
 4966: 
 4967: 
 4968: 
 4969:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4970:    // Computes the density gradient between two elements, e1 and e2.
 4971:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4972:    // zero in the direction normal to the side. 
 4973:    // 
 4974:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4975:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4976:    //
 4977:    // Input:
 4978:    //    e1: Element
 4979:    //    e2: Neighbor element (or nullptr if boundary)
 4980:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4981:    //    k: Index of the half-level at which the density is interpolated
 4982:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4983:    // 
 4984:    // Output:
 4985:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4986:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4987: 
 4988:       if (e2 == nullptr || e2->isDry) {
 4989:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4990: 
 4991:          Side *side = e1->sides[j];
 4992:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4993:                  
 4994:          if constexpr(ics == 1) {
 4995:             vec = side->n; // Normal vector to the side
 4996:          } else {
 4997:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 4998:             // IMPLEMENT THIS XXXXXX
 4999:             // !replace with xel, yel?
 5000:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5001:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5002:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5003:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5004:          } //ics
 5005:                    
 5006:          diffRho = 0.0;
 5007: 
 5008:       } else { //internal and wet
 5009:          if constexpr(ics==1) {
 5010:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5011: 
 5012:             // Vector from e1 to e2
 5013:             vec = e2->center - e1->center;
 5014: 
 5015:          } else { 
 5016:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5017:             // IMPLEMENT THIS XXXXXX
 5018:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5019:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5020:             //                   alow(j)=xctr2
 5021:             //                   bdia(j)=yctr2
 5022:          } // ics
 5023: 
 5024:          diffRho = rho2 - e1->demeanedDensity(k);
 5025:       }
 5026: 
 5027:    }
 5028: 
 5029:    __global__ void computeDensityCubicSplines(void) {
 5030:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5031: 
 5032:       ELEM(elem);
 5033: 
 5034:       if (elem->isDry) return;
 5035: 
 5036:       const int kb = elem->kb;
 5037: 
 5038:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5039:       if (elem->is2D()) {
 5040:          // In the 2D case, the density is constant at the prism level. 
 5041:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5042:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5043:       } else { //3D
 5044: 
 5045:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5046:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5047:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5048:          ///// XXXX CHECK INDICES!!!!!
 5049:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5050:       } // 2D/3D
 5051: 
 5052:    }
 5053: } // extern "C"
 5054: 
 5055: 
 5056: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5057: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5058: 
 5059:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5060: 
 5061:    const int kb  = elem->kb;
 5062:    const int kb2 = elem2->kb;
 5063: 
 5064:    // z-coordinate of prism of elem
 5065:    const double zp = elem->z_prism(k);
 5066: 
 5067:    double rho = 0.0;
 5068: 
 5069:    if (elem2->is2D()) {
 5070:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5071: 
 5072:    } else {  // 3D
 5073: 
 5074:       // eta_min may be < zmax
 5075:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5076:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5077: 
 5078:       // (Extrapolate density below bottom, we will fix it later)
 5079:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5080:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5081:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5082:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5083:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5084:    } // 2D/3D
 5085:      
 5086: 
 5087:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5088:    // Now we need to fix it.
 5089:    if (elem->z[k] < elem2->z[kb2]) {
 5090:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5091: 
 5092:       // There are two methods to adjust the density at the bottom of the element.
 5093:       // iunder_deep=0: 
 5094:       const double depth1 = abs(elem->z[kb]); // larger depth
 5095: 
 5096:       if (iunder_deep==0) {
 5097: 
 5098:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5099: 
 5100:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5101: 
 5102:       } else { // iunder_deep != 0
 5103: 
 5104:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5105: 
 5106:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5107: 
 5108:          //   Demeaned density at the same z coordinate as
 5109:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5110:          }
 5111: 
 5112:       } // if iunder_deep
 5113:    } // if elem->z[kb] < elem2->z[kb]
 5114: 
 5115:    return rho;
 5116: }
 5117: 
 5118: 
 5119: extern "C" {
 5120:    __global__ void computeDensityGradient(void) {
 5121: 
 5122:       if constexpr(ibc != 0) return;
 5123: 
 5124:          // Compute the horizontal density gradient at each element.
 5125:       // It works in two steps:
 5126:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5127:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5128:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5129:       //             gradRho.r1 = rho1 - rho0
 5130:       //             gradRho.r2 = rho2 - rho0
 5131:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5132:       // 
 5133:       //  NOTE: We use de-meaned densities.
 5134: 
 5135:       ELEM(elem);
 5136: 
 5137:       if (elem->isDry) return;
 5138: 
 5139:       const int kb  = elem->kb;
 5140:       const int i34 = elem->i34;
 5141: 
 5142:       for (int k = kb + 1; k < nvrt; k++) {
 5143:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5144:          //             gradRho.r1 = rho1 - rho0
 5145:          //             gradRho.r2 = rho2 - rho0
 5146:          int icount = 0;
 5147:          double sumRx = 0.0;
 5148:          double sumRy = 0.0;
 5149:          for (int j1=0; j1<i34; j1++) { 
 5150: 
 5151:             const int j2 = elem->nxq(j1 + 1);
 5152: 
 5153:             // Pairs of consecutive neighbor elements of elem
 5154:             const Element *e1 = elem->nghbElems[j1];
 5155:             const Element *e2 = elem->nghbElems[j2];
 5156: 
 5157:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5158:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5159:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5160: 
 5161:             // Compute the density difference and the vector from elem to e1 and e2
 5162:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5163:             double diffRho1, diffRho2;
 5164:             Vector2 vec1, vec2;
 5165:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5166:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5167: 
 5168:             const double rl1 = length(vec1);
 5169:             const double rl2 = length(vec2);
 5170:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5171: 
 5172:             const double delta = cross(vec1, vec2);
 5173:             const double sintheta = abs(delta)/(rl1*rl2);
 5174: 
 5175:             // To avoid problems, avoid elements with small angle between vectors
 5176:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5177:             const bool validEq = (sintheta > sin_one_deg);
 5178: 
 5179:             if (validEq) {
 5180:                // Solve the system of equations to get the density gradient at elem
 5181:                icount++;
 5182:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5183:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5184:                sumRx += Rx;
 5185:                sumRy += Ry;
 5186:             }
 5187:          } // for j1
 5188: 
 5189:          // Compute the average density gradient at elem
 5190:          if (icount==0) {
 5191:            // Bad mesh quality; bail out with 0 b-cc
 5192:            elem->gradRho[k] = {0.0, 0.0};
 5193:          } else {
 5194:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5195:          }
 5196: 
 5197:       } // for k
 5198: 
 5199:    }
 5200: 
 5201:    __global__ void computeBaroclinicTerm(void) {
 5202:    // Computes the baroclinic term at sides (at half levels).
 5203:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5204:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5205: 
 5206:       if (ibc == 1) return;
 5207: 
 5208:       SIDE(side);
 5209: 
 5210:       if (side->isDry) return;
 5211: 
 5212:       const Element *e1 = side->elems[0];
 5213:       const Element *e2 = side->elems[1]; 
 5214:       const int kb = side->kb;
 5215:       
 5216:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5217: 
 5218:       // interpolates vertically the density gradient of the two elements at the half level/
 5219: 
 5220:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 5221:       int k2 = max(kb, nvrt / 2);
 5222: 
 5223:       // Starts the integration at the surface and goes down to the bottom
 5224:       side->bcc[nvrt-1] = {0.0, 0.0};
 5225:       for (int k = nvrt - 2; k >= kb; k--) {
 5226:       // For each prism level (from surface to bottom)...
 5227: 
 5228:          // For both elements, interpolate density gradient at the side's half level.
 5229:          // The gradient at the side is the average of the gradients at the elements.
 5230:          // w1, w2 are used to take into account boundary sides, with just one element.
 5231:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5232:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5233:          const double wsum = w1 + w2;
 5234:          w1 = w1/wsum;
 5235:          w2 = w2/wsum;
 5236:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5237: 
 5238:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5239:          Vector2 gradRho = {0.0, 0.0};
 5240:          if (e1 != nullptr && k > kb) {
 5241:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5242:             
 5243:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5244:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5245:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5246: 
 5247:             // Grad(rho) vertically interpolated at the side's half level
 5248:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 5249: 
 5250:             // Projects the element density gradient to the side frame if needed.
 5251:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 5252: 
 5253:             // Adds the contribution of the density gradient at the side's half level
 5254:             gradRho += gradRho1*w1;
 5255:          }      
 5256:          if (e2 != nullptr && k > kb) {
 5257:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5258:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5259:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5260:             
 5261:             // Grad(rho) vertically interpolated at the side's half level
 5262:             const Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 5263: 
 5264:             // Projects the element density gradient to the side frame if needed.
 5265:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 5266: 
 5267:             // Adds the contribution of the density gradient at the side's half level
 5268:             gradRho += gradRho2*w2;
 5269:          }
 5270: 
 5271:          
 5272:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5273:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5274:          // CHECK INDICES!!! XXX
 5275:          const double grav3 = side->grav3();
 5276:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5277: 
 5278:       } // for
 5279: 
 5280:    }
 5281: 
 5282: 
 5283: 
 5284:    __global__ void computeHorGradientAtSide(void) {
 5285: 
 5286:       // Compute the horizontal density gradient at each element.
 5287:       // It works in two steps:
 5288:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5289:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5290:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5291:       //             gradRho.r1 = rho1 - rho0
 5292:       //             gradRho.r2 = rho2 - rho0
 5293:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5294:       // 
 5295:       //  NOTE: We use de-meaned densities.
 5296: 
 5297:       SIDE(side);
 5298: 
 5299: 
 5300:       if (side->isDry) return;
 5301: 
 5302:       // Computes the gradient of the variables at the side center.
 5303:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5304:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5305:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 5306: 
 5307:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5308:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5309:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5310:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5311: 
 5312:    }
 5313: 
 5314: 
 5315:    __global__ void solveMomentumEquations(double time) {
 5316: 
 5317:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5318:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5319: 
 5320:       SIDE(side);
 5321: 
 5322:       if (side->isDry) 
 5323:       {
 5324:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 5325: 
 5326:          return;
 5327:       }
 5328: 
 5329:       const Node *n1 = side->n1;
 5330:       const Node *n2 = side->n2;
 5331: 
 5332:       const int kb = side->kb;
 5333: 
 5334:       const double veg_h = side->veg_h();
 5335:       const double grav3 = side->grav3();
 5336: 
 5337:       if (side->is2D()) {
 5338:          // Remember: Do not use htot2, which is updated.
 5339:          const double htot = side->htot1();
 5340:          const double hhat = side->hhat;
 5341: 
 5342:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5343: 
 5344:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 5345:          const Vector2 tau2 = side->tau();
 5346: 
 5347:          // hat_gam has units of m/s
 5348: 
 5349:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5350:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5351:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5352: 
 5353:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5354: 
 5355: 
 5356:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 5357: 
 5358:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 5359: 
 5360:       }
 5361:       else { // 3D
 5362: 
 5363:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5364:          // 
 5365:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5366:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5367:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5368:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5369:          // k+1 and k.
 5370: 
 5371: 
 5372:          const int ndim = nvrt - kb;
 5373:          const double zTopCanopy = side->zTopCanopy();
 5374: 
 5375:          // Initialize the tridiagonal system
 5376:          for (int k = kb + 1; k < nvrt; k++) {
 5377:             
 5378:             const int kin = k - (kb + 1);
 5379: 
 5380:             // Vertical viscosity at the face center
 5381:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 5382: 
 5383:  
 5384:             alow[kin] = 0.0;
 5385:             cupp[kin] = 0.0;
 5386:             bdia[kin] = 0.0;
 5387: 
 5388:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5389:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5390: 
 5391:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5392:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5393:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5394: 
 5395:             // First part: layers k, k+1
 5396:             if (k < nvrt - 1) {
 5397:                              
 5398:                if constexpr(iveg != 0) {
 5399: 
 5400:                   // If there is vegetation at this level...
 5401:                   if (zTopCanopy > side->zc[k]) {
 5402:                      // If the canopy is above the k layer...
 5403:                      
 5404:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5405:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5406:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5407:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5408: 
 5409:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5410:                      const double vmag2 = length(ut2);
 5411:                      const double vmag1 = length(side->u2[k]);
 5412:                      const double vmag = 0.5*(vmag1 + vmag2);
 5413:                      
 5414:                      // Computes the vegetation alpha at the face center
 5415:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5416: 
 5417:                      cff1 += veg_alpha_sd*dt*vmag;
 5418: 
 5419:                   } // if (zTopCanopy
 5420:                } // if iveg
 5421: 
 5422:                const double dzz = side->Dz(k + 1);
 5423:                const double tmp = dt*dfz/dzz;
 5424:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5425: 
 5426:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5427:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5428:             }
 5429: 
 5430: 
 5431:             // Second part: layers k-1, k
 5432:             if (k > kb + 1) {
 5433: 
 5434:                double cff1 = 1.0; //init \bar{c^k}
 5435: 
 5436:                if constexpr(iveg != 0) {
 5437:                   // If there is vegetation at this level...
 5438:                   if (zTopCanopy > side->zc[k-1]) {
 5439:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5440:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5441: 
 5442:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5443: 
 5444:                      const double vmag2 = length(ut2);
 5445:                      const double vmag1 = length(side->u2[k-1]);
 5446:                      const double vmag = 0.5*(vmag1 + vmag2);
 5447: 
 5448:                      // Computes the vegetation alpha at the face center
 5449:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5450:                      cff1 += veg_alpha_sd*dt*vmag;
 5451:                   } // if zTopCanopy
 5452: 
 5453:                } // if iveg
 5454: 
 5455:                const double dzz = side->Dz(k);
 5456:                const double tmp = dt*dfz/dzz;
 5457:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5458: 
 5459:                alow[kin] += cff1*dzz/6.0 - tmp;
 5460:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5461: 
 5462:             } else { // Bottom boundary
 5463:                // This occurs at the bottom, where the bottom drag is applied.
 5464: 
 5465:                bdia[kin] += dt*side->chi2; // XXXX
 5466: 
 5467:             } // if (k > kb + 1)
 5468: 
 5469: 
 5470:          } // for (int k
 5471: 
 5472: 
 5473: 
 5474:          // Computes the RHS.
 5475:          // -----------------
 5476: 
 5477:          //	BC to be imposed at the end.
 5478: 
 5479:          const Vector2 gradETP  = side->gradETP;
 5480:          const Vector2 gradPr   = side->gradPr;
 5481:          const Vector2 gradEta1 = side->gradEta1;
 5482:          const Vector2 gradEta2 = side->gradEta2;
 5483: 
 5484:          const Vector2 *btu = side->btu;
 5485:          const Vector2 *u2  = side->u2;
 5486:          const double coriolis = side->coriolis;
 5487:          const Vector2 *nuGradU = side->nuGradU;
 5488: 
 5489: 
 5490:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5491:          for (int k = kb + 1; k < nvrt; k++) {
 5492:             const int kin = k - kb - 1;
 5493: 
 5494:             const double dz_0 = side->Dz(k);
 5495:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5496: 
 5497:             rrhs[kin] = {0.0, 0.0};
 5498:             double dz = 0.0;
 5499: 
 5500:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5501:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5502:             if (k < nvrt  ) dz += dz_1;
 5503:             if (k > kb + 1) dz += dz_0;
 5504: 
 5505:             // Elevation gradient, atmospheric pressure and tidal potential
 5506:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5507: 
 5508:             // Coriolis, advection, wind stress, and horizontal viscosity
 5509:             if (k < nvrt - 1) {
 5510: 
 5511: 
 5512:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5513:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5514:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5515:                                                 
 5516: 
 5517:                //diff stress tensors 1006
 5518:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5519:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5520:                   assert(false && "Not implemented: itur == 5");
 5521:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5522:                }
 5523:                // else assert(false && "itur # Not implemented");
 5524: 
 5525:             } else { // k == nvrt - 1 SURFACE
 5526:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 5527:                const Vector2 tau2 = side->tau();
 5528: 
 5529:                rrhs[kin] += dt*tau2;          
 5530: 
 5531:             } // if k<nvrt
 5532: 
 5533: 
 5534:             if (k > kb + 1) {
 5535:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5536:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5537:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5538: 
 5539:                // diff stress tensors 1006
 5540:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5541:                   assert(false && "Not implemented: itur == 5");
 5542:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5543:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5544:                }
 5545:                // else assert(false && "itur # Not implemented");
 5546: 
 5547: 
 5548:             } // if k>kbs + 1
 5549: 
 5550:             // Baroclinic
 5551:             Vector2 *bcc = side->bcc;
 5552:             if constexpr(ibc == 0) {
 5553:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5554:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5555: 
 5556:             } // if ibc==0
 5557: 
 5558:          } // k=kb + 1,nvrt
 5559: 
 5560: 
 5561:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5562: 
 5563:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 5564:             const int kin = k - kb - 1;
 5565:    
 5566:             // Velocity is always clamped to maximum values
 5567:             side->u2[k] = clampVelocity(soln[kin]);
 5568:          } // k
 5569: 
 5570:       } // if side->is2D()
 5571:       
 5572: 
 5573:       // Impose velocity boundary condition at the bottom
 5574:       if constexpr(imm == 2) { // 3D bed deformation model
 5575:          double dep;
 5576:          Vector2 vel;
 5577: 
 5578:          assert(false && "Not implemented: imm == 2");
 5579:          //update_bdef(time, x0, y0, dep, vel);
 5580:          // side->u2[kb] = vel;
 5581: 
 5582:       } else { // imm = 0 or 1
 5583:          if (side->Cd() == 0.0) {
 5584:             side->u2[kb] = side->u2[kb + 1];
 5585: 
 5586:          } else if (side->is3D()) { // 3D no slip bottom   
 5587:             side->u2[kb] = {0.0, 0.0};
 5588: 
 5589:          }
 5590:           
 5591:       } // if imm
 5592: 
 5593:       // The velocities below the bottom level are set to zero
 5594:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 5595: 
 5596: 
 5597:    }
 5598: 
 5599: 
 5600:    __global__ void applyMomentumBC(void) {
 5601: 
 5602:       SIDE_BND(sideBnd);
 5603: 
 5604:       Side *side = sideBnd->side;
 5605:       const BoundarySegment *segment = sideBnd->segment;
 5606:       const Node *n1 = side->n1;
 5607:       const Node *n2 = side->n2;
 5608: 
 5609:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5610: 
 5611:       const bool isLand = segment->isLand;
 5612:       const int ifltype = segment->ifltype;
 5613: 
 5614:       const int kb = side->kb;
 5615: 
 5616: 
 5617:       if (!isLand && ifltype != 0) {
 5618:          const Vector2 *ubc = sideBnd->ubc;
 5619:   
 5620:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5621:             
 5622:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5623:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5624: 
 5625:             if (ifltype == -1) {
 5626:                // Flather 1
 5627: 
 5628:                const double depth = side->depth();
 5629: 
 5630:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5631: 
 5632:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5633: 
 5634:                side->u2[k] = vnorm*side->n;
 5635: 
 5636:             } else if (ifltype == -2) { // Discharge
 5637: 
 5638:                const double eta1 = side->eta1();
 5639:                const double eta2 = side->eta2();
 5640:                const double htot = side->htot2();
 5641: 
 5642:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5643:                assert(false && "Not implemented: Discharge bc");
 5644:                // const double dischrg = discharge(eta1);
 5645:                const double dischrg = 0.0; // XXX REMOVE
 5646:                
 5647: 
 5648:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5649: 
 5650:                const double vnorm = dischrg*eta2/htot;
 5651: 
 5652:                side->u2[k] = vnorm*side->n;
 5653: 
 5654:             }
 5655:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5656:                const double vnorm = dot(side->u2[k], side->n);
 5657: 
 5658:                double rat;
 5659:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5660:                else              rat = segment->vobc2; // outgoing
 5661: 
 5662:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5663: 
 5664:             }
 5665:             else { // not Flather or 3D radiation
 5666:                side->u2[k] = ubc[k];
 5667: 
 5668:             } // if (segment->ifltype...
 5669: 
 5670:          }
 5671: 
 5672:       }
 5673:       else if (isLand) { // if it is land boundary side
 5674: 
 5675:          if constexpr(islip == 0) { // free slip
 5676: 
 5677:             for (int k = kb; k < nvrt; k++) {
 5678: 
 5679:                const Vector2 t = side->t();
 5680:                const Vector2 n = side->n;
 5681: 
 5682:                double vnorm = 0.0; // for most cases
 5683:                const double vtan = dot(side->u2[k], t);
 5684:                
 5685:                side->u2[k] = vtan*t - vnorm*n;
 5686: 
 5687:             }
 5688: 
 5689:          } else { // no slip
 5690:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5691: 
 5692:          }
 5693:       } // if (side segment type...
 5694: 
 5695:    
 5696: 
 5697:    }
 5698: 
 5699: 
 5700:    __global__ void shapiroFilter1(void) {
 5701:       // First step of the Shapiro filter (normally used if indvel<=0)
 5702:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5703: 
 5704:       SIDE(side);
 5705: 
 5706:       // Only internal wet sides are processed
 5707:       if (side->isDry || !(side->isInternal())) return;
 5708: 
 5709:       const int kb = side->kb;
 5710: 
 5711:       for (int mm = 0; mm < niter_shap; mm++) {
 5712: 
 5713:          for (int k = kb + 1; k < nvrt; k++) {
 5714:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5715:             Vector2 suru = {0.0, 0.0};
 5716: 
 5717:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5718: 
 5719:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 5720: 
 5721:                int kin = k;
 5722:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5723:                
 5724:                // Get the velocity at the neighbor's side.
 5725:                Vector2 nSideU2 = nSide->u2[kin];
 5726: 
 5727:                // Projects the velocity to the current side frame if needed.
 5728:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 5729: 
 5730:                suru += nSideU2;
 5731:             }
 5732: 
 5733:             // Reusing bcc as a temporary array to store the suru values.
 5734:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5735: 
 5736:          }
 5737:       }
 5738:    }
 5739: 
 5740:    __global__ void shapiroFilter2(void) {
 5741:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5742: 
 5743:       SIDE(side);
 5744: 
 5745: 
 5746:       if (side->isDry || !(side->isInternal())) return;
 5747: 
 5748:       const int kb = side->kb;
 5749: 
 5750:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5751: 
 5752:       if (side->is2D()) {
 5753:          side->u2[kb + 1] = side->bcc[kb + 1];
 5754:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 5755: 
 5756:       } else {
 5757:          // 3D
 5758:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5759:          
 5760:       }
 5761: 
 5762:    }
 5763: 
 5764: 
 5765:    __global__ void ul0UpdateZCoords(void) {
 5766:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5767:       
 5768:       NODE(node);      
 5769: 
 5770: 
 5771:       if (false) { //node->isDry) { XXXXXXX
 5772: 
 5773:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 5774: 
 5775:          if constexpr(ivcor != 1) node->kb = 0;
 5776: 
 5777:       } else {
 5778: 
 5779:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 5780:          node->updateKb();
 5781: 
 5782:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5783: 
 5784:       }
 5785: 
 5786:       // We use the temp.b field to store the previous state of isDry.
 5787:       node->tmp.b = node->isDry;
 5788: 
 5789:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5790:       node->isDry = true;
 5791: 
 5792:    }
 5793: 
 5794:    __global__ void ul0ComputeDryElements(void)
 5795:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 5796:    {
 5797:       ELEM(elem);
 5798: 
 5799:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 5800: 
 5801:       elem->kb = 0;
 5802: 
 5803:       if (elem->isDry) return;
 5804: 
 5805: 
 5806:    //    if(elem->isDry2()) { // XXXX
 5807:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5808:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5809:    //        call parallel_abort(errmsg)
 5810:    //    }
 5811: 
 5812:       const Node *n1 = elem->nodes[0];
 5813:       const Node *n2 = elem->nodes[1];
 5814:       const Node *n3 = elem->nodes[2];  
 5815:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 5816: 
 5817:       // Computes element's kb as the minimum of the nodes' kb.
 5818:       const int kb1 = n1->kb;
 5819:       const int kb2 = n2->kb;
 5820:       const int kb3 = n3->kb;
 5821:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 5822: 
 5823: 
 5824:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5825: 
 5826: 
 5827:       // Computes the element z as the mean of the nodes z.
 5828:       for (int k = elem->kb; k < nvrt; k++) {
 5829: 
 5830:          // Compute the element z as the mean of the nodes z.
 5831:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 5832:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5833:          elem->z[k] /= elem->i34;
 5834: 
 5835: if (k>elem->kb && elem->z[k] <= elem->z[k-1]) printf("EEEE elem->isDry = %d, idx1 = %d, idx2 = %d, idx3 = %d, z1[k] = %f, z2[k] = %f, z3[k] = %f, z1[k-1] = %f, z2[k-1] = %f, z3[k-1] = %f, k = %d, kb = %d, kb1 = %d, kb2 = %d, kb3 = %d, kb4 = %d, z[k] = %f, z[k-1] = %f\n", elem->isDry, n1->idx, n2->idx, n3->idx, n1->z[max(k, kb1)], n2->z[max(k, kb2)], n3->z[max(k, kb3)], n1->z[max(k-1, kb1)], n2->z[max(k-1, kb2)], n3->z[max(k-1, kb3)],  k, elem->kb, kb1, kb2, kb3, kb4, elem->z[k], elem->z[k-1]);
 5836:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 5837:       }
 5838:                   
 5839:    }
 5840: 
 5841:    __global__ void ul0ComputeDryNodes(void)
 5842:    // Updates node's isDry based on the elements' isDry. 
 5843:    {
 5844:       NODE(node);
 5845: 
 5846:       node->isDry = true;
 5847: 
 5848:       // A node is wet if at least one of the elements sharing it is wet.
 5849:       for (int j = 0; j < node->numElements; j++) {
 5850:          const Element *elem = node->elements[j];
 5851:          if (!elem->isDry) {
 5852:             node->isDry = false;
 5853:             break;
 5854:          }
 5855:       }
 5856: 
 5857:        
 5858:    }
 5859: 
 5860: 
 5861:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5862:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 5863:    // node->tmp.b is true if the node was previously dry.
 5864:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 5865:    {
 5866:       NODE(node);
 5867:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5868: 
 5869:       // Avoid this the first time step.
 5870:       if (it == iths) return;  
 5871: 
 5872:       const bool wasDry = node->tmp.b;
 5873: 
 5874: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 5875: 
 5876:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 5877: 
 5878:          for (int k=0; k < nvrt; k++) {
 5879: 
 5880:             Vector3 utmp={0.0, 0.0, 0.0};
 5881: 
 5882:             double ttmp=0.0;
 5883:             double stmp=0.0;
 5884:             int icount=0;
 5885:             for (int j = 0; j < node->numNodes; j++) {
 5886: 
 5887:                const Node *nbrNode = node->nodes[j];
 5888:                
 5889:                const bool wasNbrDry = nbrNode->tmp.b;
 5890: 
 5891:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 5892:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 5893: 
 5894:                   icount++;
 5895: 
 5896:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5897:                   utmp += nbrNode->uvw2(k);
 5898:                   
 5899:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 5900:                   stmp += nbrNode->tracers[k].tracer[1]; 
 5901:                }
 5902:             }
 5903: 
 5904:             if (icount > 0) {
 5905:                const double inv_icount = 1.0/icount;
 5906:                utmp = inv_icount*utmp;
 5907:                node->u2[k]     = toVector2(utmp);
 5908:                node->w2[k]     = utmp.z;
 5909:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5910:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5911:             } else {
 5912:                node->u2[k] = {0.0, 0.0};
 5913:                node->w2[k] = 0.0;
 5914:                // Initialize tracers to 0.0??? XXXXX
 5915:             }
 5916:          }
 5917:       }
 5918:    }
 5919: 
 5920:   
 5921:    
 5922: 
 5923: 
 5924:    __global__ void ul0UpdateSides(int it, int iths) {
 5925:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 5926:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 5927:    // The dryness of the sides is updated in ul0UpdateSides2.
 5928: 
 5929:       SIDE(side);
 5930: 
 5931:       // A side is wet if and only if at least one of its elements is wet.
 5932:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5933:  
 5934:       const Node *n1 = side->n1;
 5935:       const Node *n2 = side->n2;
 5936:      
 5937:       const int kb1 = n1->kb;
 5938:       const int kb2 = n2->kb;
 5939: 
 5940:       side->kb = 0; // default when dry
 5941: 
 5942:       if (isWet) {
 5943: 
 5944:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5945: 
 5946:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5947: 
 5948:          side->kb = min(kb1, kb2);
 5949: 
 5950:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 5951: 
 5952:          for (int k = side->kb; k < nvrt; k++) {
 5953:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5954: 
 5955:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 5956: 
 5957:             // Compute velocity for re-wetted sides 
 5958:             if ((it != iths) && (side->isDry && isWet)) {
 5959: 
 5960:                Vector2 utmp={0.0, 0.0};
 5961: 
 5962:                int icount=0;
 5963: 
 5964:                // For all the sides on the two elements that share this side
 5965:                for (int j = 0; j < 2; j++) {
 5966:                   const Element *elem = side->elems[j];
 5967:                   if (elem == nullptr) continue;
 5968: 
 5969:                   for (int jj=0; jj < elem->i34; jj++) {
 5970:                      const Side *nSide = elem->sides[jj];
 5971:                      if (nSide->isDry) continue;
 5972: 
 5973:                      icount++;
 5974:                      utmp += nSide->u2[k];  
 5975:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 5976:                   }
 5977:                }
 5978:                   
 5979:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 5980:                if (icount > 0)  side->u2[k] = utmp/icount;
 5981:                else             side->u2[k] = {0.0, 0.0};
 5982:                   
 5983:             } // if ((it != iths) && (side->isDry && isWet))
 5984: 
 5985:          } // for k
 5986: 
 5987:       } // if isWet 
 5988:       
 5989: 
 5990: 
 5991:    }
 5992: 
 5993:    __global__ void ul0UpdateSides2(void) {
 5994:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 5995:    
 5996:          SIDE(side);
 5997:    
 5998:          const Element *e1 = side->elems[0];
 5999:          const Element *e2 = side->elems[1];
 6000: 
 6001:          // A side is wet if and only if at least one of its elements is wet.
 6002:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 6003: 
 6004:          // Update the side's dryness
 6005:          side->isDry = !isWet;
 6006: 
 6007:    }
 6008: 
 6009: 
 6010:    __global__ void zeroNodalVelocities(void) {
 6011:       NODE(node);
 6012: 
 6013:       for (int k = 0; k < nvrt; k++) {
 6014:          node->u2[k]   = {0.0, 0.0};
 6015:          node->w2[k]   = 0.0;
 6016:          node->utmp[k] = {0.0, 0.0};
 6017:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6018:       }
 6019:    }
 6020:  
 6021: 
 6022:    __global__ void computeNodalVerticalVelocities1(void) {
 6023:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6024:    // Adds the element's vertical velocity times the element's area.
 6025:       ELEM(elem);
 6026: 
 6027:       for (int j = 0; j < elem->i34; j++) {
 6028:          Node *node = elem->nodes[j];
 6029: 
 6030:          for (int k = node->kb; k < nvrt; k++) {
 6031:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6032:          }
 6033:          atomicAdd(&(node->tmp.d), elem->area);
 6034:       }
 6035:    }
 6036: 
 6037:    __global__ void computeNodalVerticalVelocities2(void) {
 6038:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6039:    // Divides by the total area of the elements sharing the    node.
 6040:       NODE(node);
 6041: 
 6042:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 6043: 
 6044:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6045:    }
 6046: 
 6047: 
 6048:    __global__ void computeNodalHorizontalVelocities1(void) {
 6049: 
 6050:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6051:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 6052: 
 6053:       ELEM(elem);
 6054: 
 6055:       if (elem->isDry) return;
 6056: 
 6057:       const int kb = elem->kb;
 6058:       const bool isTri = elem->isTri();
 6059: 
 6060:       if constexpr(indvel <= 0) {
 6061:          // Assuming discontinous hvel.
 6062: 
 6063:          if (isTri) { // For triangles
 6064:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6065:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6066: 
 6067:             for (int j = 0; j < 3; j++) {
 6068:                // For every node of the triangle...
 6069:                Node *node = elem->nodes[j];
 6070: 
 6071:                if (node->isDry) continue;
 6072: 
 6073:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 6074:                const Side *s2 = elem->sides[(j + 1) % 3];
 6075:                const Side *s3 = elem->sides[(j + 2) % 3];
 6076: 
 6077:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 6078: 
 6079:                atomicAdd(&(node->tmp.i), 1);
 6080: 
 6081:                for (int k = kb; k < nvrt; k++)  {
 6082:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated linearly at node j.   
 6083:                   u = clampVelocity(u);
 6084:                   atomicAdd(&(node->utmp[k].x), u.x);
 6085:                   atomicAdd(&(node->utmp[k].y), u.y);
 6086: 
 6087:                }
 6088: 
 6089:             }
 6090:          }
 6091:          else { // For quads
 6092:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6093: 
 6094:          }
 6095: 
 6096:       }
 6097:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 6098:       
 6099:    }
 6100: 
 6101: 
 6102:    __global__ void computeNodalHorizontalVelocities2(void) {
 6103:       NODE(node);
 6104: 
 6105:       const int nodeCount = node->tmp.i;
 6106: 
 6107:       if (nodeCount == 0) 
 6108:       {
 6109:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 6110:          return;
 6111:       }
 6112: 
 6113:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 6114:       
 6115:       const int kb = node->kb;
 6116: 
 6117:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 6118:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 6119:       
 6120:       
 6121:    }   
 6122: 
 6123:  
