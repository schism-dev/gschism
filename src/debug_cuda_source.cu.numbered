 1487: 
 1488: /**
 1489:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1490:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1491:    If the segment is completely inside the element, then it returns true.
 1492: 
 1493:    This function assumes:
 1494:    - The initial point is on a side of the element. 
 1495:    - Its position is given by parameter t in the range [0,1].
 1496:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1497:       intersects the element (elements are convex).
 1498: 
 1499:    To find the intersection point, this function does the following:
 1500:    - it finds the intersection of the line segment with all the element side lines,
 1501:       except for the one that contains the initial point.
 1502:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1503:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1504:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1505:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1506:       track segment is almost parallel to the element side line.
 1507: 
 1508:    Inputs:
 1509:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1510:    @param x2, y2: other end of the line segment
 1511: 
 1512:    Outputs:
 1513:    @param side:  side that intersects the line segment (input and output)
 1514:    @param nextElement (output): element that contains the intersection point
 1515:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1516:    @param zint (input/output): Vertical coordinate of the intersection point
 1517: 
 1518:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1519:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1520:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1521: 
 1522:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1523:    (Delta) being zero.
 1524: 
 1525:    The intersection2 point happens when:
 1526:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1527:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1528:    
 1529:    Assumption: the 4 points (including those of the side segment) are different.
 1530:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1531:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1532:    If true, (xIntersect,yIntersect) is the intersection.				
 1533:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1534: **/
 1535: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1536:                                               double &t, double& tIntersect) {
 1537: 
 1538:    double closest_intersect_t = 1e10;
 1539:    bool found_intersection = false;
 1540: 
 1541:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1542:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1543:    const Point2 x1 = side->point(t);
 1544:    
 1545: 
 1546:    Side *nextSide = nullptr;
 1547:    for (int i = 0; i < i34; i++) {
 1548: 
 1549:       // Element's i-th side 
 1550:       Side *side2 = sides[i];
 1551: 
 1552:       // Skip the side that contains the initial point
 1553:       if (side2 == side) continue;
 1554: 
 1555:       // (x3,y3)-(x4,y4) is the element side line
 1556:       const Point2 x3 = side2->n1->p2();
 1557:       const Point2 x4 = side2->n2->p2();
 1558: 
 1559:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1560:       const double delta = cross(x2 - x1, x3 - x4);
 1561: 
 1562:       if (delta != 0.0) {
 1563: 
 1564:          const double delta1 = cross(x3 - x1, x3 - x4);
 1565:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1566: 
 1567:          // Solves the two linear equations for tt1 and tt2
 1568:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1569:          const double tt2 = delta2/delta;
 1570: 
 1571:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1572:             closest_intersect_t = min(closest_intersect_t, tt1);
 1573:             nextSide = side2;
 1574: 
 1575:             nextElement = nextSide->otherElem(this);
 1576:             tIntersect = max(small, min(tt1, 1.0-small));
 1577:             t = tt2;
 1578: 
 1579:             found_intersection = true;
 1580:          }
 1581:       
 1582:       }
 1583: 
 1584:    }
 1585:    
 1586: printf("AAA 1, found_intersection = %d, nextSide = %p, nextElement = %p\n", found_intersection, nextSide, nextElement);
 1587: 
 1588: 
 1589:    // found_intersection should always be true, since we checked all the sides.  
 1590:    side = nextSide;
 1591: // if (found_intersection) {
 1592: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1593: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1594: // }   
 1595:    // if (!found_intersection) {
 1596:    //    // Check if the segment is parallel to the initial side
 1597:    //    printf("XXX segment: side = %p\n", side);
 1598:    //    printf("XXX %f\n", dot(x2 - x1, side->n1->p2() - side->n2->p2()));
 1599:    //    if (abs(dot(x2 - x1, side->n1->p2() - side->n2->p2())) < small) {
 1600:    //       assert(false && "Segment is parallel to the initial side");
 1601:    //       found_intersection = true;
 1602:    //       nextElement = side->otherElem(this);
 1603:    //       tIntersect = t;
 1604:    //       t = 0.0;
 1605:    //       found_intersection = true;
 1606:    //    }
 1607:    // }
 1608:    return found_intersection;
 1609: }
