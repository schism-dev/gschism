 7229: __global__ void getStructSizes(int* sizes)  {
 7230:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 7231:       sizes[0] = (int)sizeof(Node);
 7232:       sizes[1] = (int)sizeof(Element);
 7233:       sizes[2] = (int)sizeof(Side);
 7234:       sizes[3] = (int)sizeof(NodeBoundary);
 7235:       sizes[4] = (int)sizeof(SideBoundary);
 7236:       sizes[5] = (int)sizeof(BoundarySegment);
 7237: }
