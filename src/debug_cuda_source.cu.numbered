 7590:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 7591:    double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 7592: 
 7593:    mesh->populateNodes(i34, isbnd, sharedIdxNodeBoundary, 
 7594:                        node_coords, node_coords_ll, use_ll, wind_rotate_angle, 
 7595:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 7596:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 7597:                        localNodeIndices, localElemIndices, localSideIndices,
 7598:                        localNodePart, localElemPart, localSidePart,
 7599:                        drag, roughness, rmanning, kb, localSigma);
 7600: }  
