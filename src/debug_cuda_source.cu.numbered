 3373: 
 3374: __device__ double Node::compZCoord(int k) const {
 3375:    // Computes the z coordinate at level k.
 3376:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3377:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3378:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3379:    // used 
 3380: 
 3381:    assert(k >= 0 && k < nvrt && "ZCOOR: invalid level\n");
 3382:    
 3383:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3384: 
 3385:    if (isDry2()) return 0.0;  // XXXX I used to return 0.0
 3386: 
 3387:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 3388: 
 3389:    if constexpr(ivcor == 2) {
 3390: 
 3391:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3392:       const double h_c = mesh->h_c;
 3393:       const double theta_f = mesh->theta_f;
 3394:       const double sinh_theta_f = mesh->sinh_theta_f;
 3395: 
 3396: 
 3397:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3398:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3399:       // once per time step/node.
 3400:       // CHECK: updateZCoordData
 3401: 
 3402:       //  To simplify comparisons, I define index versions of count variables.
 3403:       if      (k == ivrt)     return eta2; 
 3404:       else if (k == izlev)    return -hmod2;
 3405:       else if (k == kb)       return -depth;
 3406:       else if (k < izlev)     return mesh->ztot[k];
 3407:       else if (k > izlev) {
 3408:          const int ksig = k - izlev;
 3409: 
 3410:          if (hmod2 <= h_c) {
 3411:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3412: 
 3413:          } 
 3414:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3415:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3416:             assert(false && "ZCOOR: invalid h_c\n");
 3417:          } 
 3418:          else {
 3419:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3420:                    h_c * mesh->sigma[ksig] + 
 3421:                    (hmod2 - h_c) * mesh->cs[ksig];
 3422:          }
 3423:       } else { 
 3424:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 3425:       }
 3426: 
 3427:    }
 3428:    else if constexpr(ivcor == 1) {
 3429:       if (k == kb) return -depth;
 3430:       else if (k == nvrt-1) return eta2;
 3431:       else if (k > kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 3432:    }
 3433:    
 3434:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 3435:    return 0.0;
 3436: }
 3437: 
 3438: 
 3439: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3440:    // Computes the bottom drag Cd based on the selected nchi
 3441: 
 3442:    if constexpr(nchi == 0) {
 3443:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3444:       Cd = drag;  // Read from drag file
 3445: 
 3446:    } else if constexpr(nchi == 1) {
 3447:       // 
 3448: 
 3449:       bool ltmp = false; // for WBL iteration
 3450: 
 3451:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3452:       if (isDry || (rough == 0.0)) {
 3453:          Cd = 0.0;
 3454: 
 3455:       } else { //roughness >0 
 3456:          
 3457:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3458: 
 3459:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3460: 
 3461:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3462: 
 3463:       } // if rough
 3464: 
 3465:    } else if constexpr(nchi == -1) {
 3466:    // Manning 
 3467:  
 3468:       const double htot = max(hmin_man, htot2()); 
 3469:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3470: 
 3471:    } else {
 3472:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3473:       
 3474:    } // if nchi
 3475: 
 3476: }
 3477: 
 3478: 
 3479: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3480:    // Checks if a side in on the boundary
 3481:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3482: 
 3483:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3484:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3485: 
 3486:    // Indices of the nodes that form the side
 3487:    const int n1 = side.n1->idx;
 3488:    const int n2 = side.n2->idx;
 3489:    isLand = false;
 3490:    
 3491: 
 3492:    // Check if the side is on a land boundary
 3493:    for (int i = 0; i < nland; i++) {
 3494:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3495:          // Consecutive nodes in the land boundary segment
 3496:          const int b1 = ilnd[i + j*nland];
 3497:          const int b2 = ilnd[i + (j + 1)*nland];
 3498: 
 3499:          assert(b1 != -1 && b2 != -1);
 3500: 
 3501:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3502:             
 3503:             isLand = true;
 3504:             return i;
 3505:          }
 3506:       }
 3507:    }
 3508: 
 3509:    // Check if the side is on an open boundary
 3510:    for (int i = 0; i < nope; i++) {
 3511:       for (int j = 0; j < nond[i] - 1; j++) {
 3512:          // Consecutive nodes in the open boundary segment
 3513:          const int b1 = iond[i + j*nope];
 3514:          const int b2 = iond[i + (j + 1)*nope];
 3515: 
 3516:          assert(b1 != -1 && b2 != -1);
 3517: 
 3518:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3519:             isLand = false;
 3520:             return i;
 3521:          }
 3522:       }
 3523:    }
 3524: 
 3525:    return -1;
 3526: }
 3527: 
 3528: 
 3529: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3530:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3531:                                     double *wind_rotate_angle, 
 3532:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3533:                                     int *nodeNeighSidesStart, int *nodeNeighSidesIndices,
 3534:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3535:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3536:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3537:                                     double *drag, double *roughness, double *rmanning) {
 3538: 
 3539:    NODE(pnode);  
 3540:    const int i = idx_node;
 3541:    Node &node(*pnode);
 3542: 
 3543:    node.idx = i;
 3544: 
 3545:    const int idxNodeStart = nodeNeighNodesStart[i];
 3546:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3547:    node.numNodes = idxNodeEnd - idxNodeStart;
 3548:    node.nodes = nodeNeighNodes + idxNodeStart;
 3549:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3550: 
 3551:    const int idxSideStart = nodeNeighSidesStart[i];
 3552:    const int idxSideEnd   = nodeNeighSidesStart[i+1];
 3553:    node.sides = nodeNeighSides + idxSideStart;
 3554: 
 3555: 
 3556: 
 3557:    const int idxElemStart = nodeNeighElemsStart[i];
 3558:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3559:    node.numElements = idxElemEnd - idxElemStart;
 3560:    node.elements = nodeNeighElems + idxElemStart;
 3561: 
 3562: 
 3563:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3564:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3565:       const int partNode = localNodePart[idxNodeGlobal]; 
 3566:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3567: 
 3568:       Node *node_ptr = nodes[partNode] + idxNode;
 3569:       
 3570:       nodeNeighNodes[idx] = node_ptr;
 3571:    }
 3572: 
 3573:    for (int idx = idxSideStart; idx < idxSideEnd; idx++) {
 3574:       const int idxSideGlobal = nodeNeighSidesIndices[idx];
 3575:       const int partSide = localSidePart[idxSideGlobal]; 
 3576:       const int idxSide  = localSideIndices[idxSideGlobal];
 3577: 
 3578:       Side *side_ptr = sides[partSide] + idxSide;
 3579:       
 3580:       nodeNeighSides[idx] = side_ptr;
 3581:    }
 3582: 
 3583: 
 3584:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3585:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3586:       const int partElem = localElemPart[idxElemGlobal];
 3587:       const int idxElem  = localElemIndices[idxElemGlobal];
 3588: 
 3589:       Element *elem_ptr = elems[partElem] + idxElem;
 3590: 
 3591:       nodeNeighElems[idx] = elem_ptr;
 3592:    }      
 3593: 
 3594:    node.wind_angle = wind_rotate_angle[i];
 3595: 
 3596: 
 3597:    node.p.x   = node_coords[i * 3];
 3598:    node.p.y   = node_coords[i * 3 + 1];
 3599:    node.depth = node_coords[i * 3 + 2];
 3600: 
 3601:    if (use_ll) {
 3602:    node.lon = node_coords_ll[i * 2    ]*deg2rad;
 3603:    node.lat = node_coords_ll[i * 2 + 1]*deg2rad;
 3604:    }
 3605: 
 3606: 
 3607:    node.numSides = 0;
 3608: 
 3609:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3610:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3611:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3612:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3613:    else assert(false && "populateNodes: selected nchi not implemented.");
 3614:    
 3615:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3616:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3617:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3618: 
 3619:    
 3620:    // Links the node to the boundary information
 3621:    if (isbnd[i] >= 0) {
 3622:      
 3623:       // Get the index of the node boundary
 3624:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3625: 
 3626:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3627:       node.nodeBnd->node = &node;
 3628: 
 3629:       node.nodeBnd->sideBnd1 = nullptr;
 3630:       node.nodeBnd->sideBnd2 = nullptr;
 3631: 
 3632:       if (isbnd[i]>=0) {
 3633: 
 3634:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3635:          
 3636:          node.nodeBnd->segment->ifltype = 3 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3637:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3638: 
 3639:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3640:          node.nodeBnd->segment->clen  = nan("1");
 3641:          node.nodeBnd->segment->carea = nan("1");
 3642: 
 3643:       }
 3644:    } else {
 3645: 
 3646:       node.nodeBnd = nullptr; // For internal nodes
 3647: 
 3648:       if (isbnd[i] == landSegment) {
 3649:          node.nodeBnd = &landBoundaryNode;
 3650:          node.nodeBnd->segment = &landBoundarySegment;
 3651:       }
 3652:       
 3653:    }
 3654:    
 3655:    // XXXX GAUSSIAN HILL VELOCITIES
 3656: #ifdef GAUSSIAN_HILL_VELOCITIES
 3657:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3658:       constexpr double rot_per = 3000.0;
 3659:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3660:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3661:    // XXXXX
 3662: #endif
 3663: 
 3664: }
 3665: 
 3666: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3667:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3668:                                     double *wind_rotate_angle,   
 3669:                                     int *isdel, int *isidenode, int *isbnd,
 3670:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3671:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3672:                                     int *nodeNeighSidesStart, int *nodeNeighSidesIndices,
 3673:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3674:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3675:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3676:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3677:                                     double *drag, double *roughness) {
 3678: 
 3679: 
 3680:    SIDE(pside);
 3681:    Side &side(*pside);
 3682:    const int i = idx_side;
 3683: 
 3684:    side.idx = i;  
 3685:    
 3686:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3687:    const double fc   = 2.0*omega_e*sin(sfea0);
 3688:    const double beta = 2.0*omega_e*cos(sfea0);
 3689: 
 3690:    // finding the pointer to the nodes that form the side
 3691:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3692:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3693: 
 3694:    const int locidx_n1 = localNodeIndices[idx_n1];
 3695:    const int locidx_n2 = localNodeIndices[idx_n2];
 3696:    const int part_n1 =   localNodePart[idx_n1];
 3697:    const int part_n2 =   localNodePart[idx_n2];
 3698: 
 3699:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3700:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3701: 
 3702:    // Counts the number of sides connected to each node
 3703:    side.n1->numSides++;
 3704:    side.n2->numSides++;
 3705: 
 3706:    // Adds the side to the list of sides connected to each node
 3707:    side.n1->sides[side.n1->numSides - 1] = &side;
 3708:    side.n2->sides[side.n2->numSides - 1] = &side;
 3709: 
 3710: 
 3711:    // Normal, unitary vector to the side
 3712:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3713:    side.n = normalize(side.n);
 3714: 
 3715:    // Side boundary type
 3716:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3717:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3718: 
 3719:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3720:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3721:    {
 3722:       bool isLand = false;
 3723:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3724:       
 3725:       if (isbs > -1) {
 3726:          // assert(isLand || isbs>=0);
 3727:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3728: 
 3729:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3730: 
 3731:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3732:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3733: 
 3734:          assert (isLand == side.sideBnd->segment->isLand);
 3735: 
 3736:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3737:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3738:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3739: 
 3740:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3741:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3742:          
 3743:          side.sideBnd->side = &side;
 3744: 
 3745:       }
 3746:       else {
 3747:          side.sideBnd = nullptr;
 3748:       }
 3749:    }
 3750:    else 
 3751:    {
 3752:       side.sideBnd = nullptr;
 3753:    }
 3754: 
 3755: 
 3756:    // finding the pointer to the elements that share the side
 3757:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3758:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3759: 
 3760:    if (idx_e1 > -1) {
 3761:       const int locidx_e1 = localElemIndices[idx_e1];
 3762:       const int part_e1 =  localElemPart[idx_e1];
 3763:       side.elems[0] = elems[part_e1] + locidx_e1;
 3764: 
 3765:    }
 3766:    else {
 3767:       side.elems[0] = nullptr;
 3768:    }
 3769: 
 3770:    if (idx_e2 > -1) {
 3771:       const int locidx_e2 = localElemIndices[idx_e2];
 3772:       const int part_e2 =  localElemPart[idx_e2];
 3773:       side.elems[1] = elems[part_e2] + locidx_e2;
 3774:    }
 3775:    else {
 3776:       side.elems[1] = nullptr;
 3777:    }
 3778: 
 3779:    // Compute the center of the side
 3780:    side.center = 0.5*(side.n1->p + side.n2->p);
 3781: 
 3782:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3783:    side.shapiro = shapiro0;
 3784: 
 3785: #ifdef GAUSSIAN_HILL_VELOCITIES
 3786: // XXXX
 3787: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3788: constexpr double rot_per=3000.0;
 3789: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3790: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3791: // XXXXX      
 3792: #endif
 3793:    // Compute the z level at the center of the side
 3794:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3795:    
 3796:    // Compute the length of the side
 3797:    const Vector2 vLen = side.n2->p - side.n1->p;
 3798:    side.len = sqrt(dot(vLen, vLen));
 3799: 
 3800: 
 3801:    // Compute the Coriolis coefficient
 3802: 
 3803:    if constexpr(ncor == -1 || ncor == 0) {
 3804:       side.coriolis = coricoef;
 3805:    }
 3806:    else {
 3807:       const double sphi = side.lat();  // Latitude at the center of the side
 3808: 
 3809: // XXXXXX ERROR WHEN use_ll is false??????
 3810:       if constexpr(ics == 1) {
 3811:          // XXXXXXX
 3812:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3813:       }
 3814:       else {
 3815:          side.coriolis = 2.0*omega_e*sin(sphi);
 3816:       }
 3817: 
 3818:    }
 3819: }
 3820: 
 3821: 
 3822: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3823:    double *node_coords, double *node_coords_ll, bool use_ll,
 3824:    double *wind_rotate_angle,   
 3825:    int *isdel, int *isidenode, int *isbnd,
 3826:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3827:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3828:    int *nodeNeighSidesStart, int *nodeNeighSidesIndices,
 3829:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3830:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3831:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3832:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3833:    double *drag, double *roughness) {
 3834: 
 3835:    ELEM(pelem);
 3836:    Element &elem(*pelem);
 3837:    const int i = idx_elem;
 3838: 
 3839:    elem.idx = i;
 3840: 
 3841:    for (int j = 0; j < i34[i]; j++) {
 3842:       const int idxNode = elnode[i*4 + j];  
 3843:       const int idxSide = elside[i*4 + j];
 3844:       
 3845:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3846:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3847: 
 3848:       // Find the neighboring element  
 3849:       if (elem.sides[j]->elems[0] == &elem) {
 3850:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3851:       }
 3852:       else {
 3853:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3854:       }
 3855:       
 3856:    }
 3857: 
 3858:    elem.i34 = i34[i];
 3859: 
 3860:    // Compute the barycenter of the element and its depth
 3861:    elem.center = {0.0, 0.0};
 3862:    elem.depth = 0.0;
 3863:    for (int j = 0; j < i34[i]; j++) {
 3864: 
 3865:       elem.center += elem.nodes[j]->p/i34[i];
 3866:       elem.depth  += elem.nodes[j]->depth/i34[i];
 3867:    }
 3868: 
 3869: 
 3870:    
 3871:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3872:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3873: 
 3874:    elem.area = elem.computeSignedArea(); 
 3875:    elem.radius = sqrt(elem.area)/pi; 
 3876:    
 3877:    // Determines which way the normal vector to each side is oriented.
 3878:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3879:    for (int j = 0; j < i34[i]; j++)  
 3880:    {
 3881:       elem.ssign[j] = (elem.sides[j]->elems[0] == &elem) ? 1.0 : -1.0;
 3882:        
 3883:    }
 3884: 
 3885:    // Derivatives of shape functions
 3886:    //  For ics=2, this is done inside element/ll frame XXX
 3887:    //  For quads, the derivative is evaluated at centroid
 3888:    for (int j = 0; j < elem.i34; j++) {
 3889:       const double area = elem.area;
 3890:       const int id2 = elem.nxq(1 + j);
 3891:       const int id3 = elem.nxq(2 + j);
 3892:       const int id4 = elem.nxq(3 + j);
 3893:       if (elem.isTri()) {
 3894:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3895:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3896:          // da1/dx = (y1 - y2)/(2*area)
 3897:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3898:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3899:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3900:       }
 3901:       else  { // Quad; evaluate at centroid
 3902:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3903:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3904:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3905:       } // if Tri
 3906: 
 3907:    } // for j   
 3908:    
 3909:    
 3910: 
 3911: }
