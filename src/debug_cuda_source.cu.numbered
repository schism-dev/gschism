 4362:    __global__ void computeFlowBcVelocities(double time) {
 4363: 
 4364:       SIDE_BND(sideBnd);
 4365: 
 4366:       const Side *side = sideBnd->side;
 4367:  
 4368:       const bool isDry = side->isDry;
 4369:       const bool isLand = sideBnd->segment->isLand;
 4370: 
 4371:    
 4372:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4373: 
 4374:       if (isDry || isLand) return;
 4375: 
 4376:       // For wet sides in open boundaries...
 4377:       const Vector2 n = side->n;
 4378:       const BoundarySegment *segment = sideBnd->segment;
 4379: 
 4380:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4381: 
 4382:       const int ifltype = segment->ifltype;
 4383: 
 4384:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4385:       const Vector2 r_nuth0 = r_uth0*n;
 4386: 
 4387: 
 4388:       if (ifltype == 1 || ifltype == 2) {
 4389:       
 4390:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4391: 
 4392:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4393:          
 4394:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4395:          
 4396:       } else if (ifltype == -1) { // Flather 1
 4397: 
 4398:          for (int k = 0; k < nvrt; k++) {
 4399: 
 4400:             // uth is the normal vel.; no ramp up
 4401:             const double uth = sideBnd->nuth(k);
 4402:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4403: 
 4404:             sideBnd->ubc[k] += uth*n;
 4405:          }
 4406: 
 4407:       } else if (ifltype == 3 || ifltype == 5) {
 4408:          // vnth0=0 !normal vel.
 4409: 
 4410:          Vector2 r_u1_bar = {0.0, 0.0};
 4411:          // Computes the contribution to the velocity from all tide frequencies
 4412:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4413: 
 4414:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4415:             const Vector2 umo  = sideBnd->umo(jfr); 
 4416: 
 4417:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4418:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4419:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4420:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4421: 
 4422:          }
 4423: 
 4424: 
 4425:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4426: 
 4427:       } // if (ifltype = 3 || ifltype == 5
 4428: 
 4429: 
 4430: 
 4431:    }
 4432: 
 4433:    __global__ void computeElevationBoundaryConditions(double time) {
 4434:       // Compute elevation essential boundary conditions 
 4435: 
 4436:       NODE_BND(nodeBnd); // Each boundary node.
 4437: 
 4438:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4439: 
 4440:       const Node *node = nodeBnd->node;
 4441:       const BoundarySegment *segment = nodeBnd->segment;
 4442:       const int iettype = segment->iettype;
 4443:       
 4444: 
 4445:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4446:       double eic = 0.0;
 4447:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4448:       else                 eic = 0.0;
 4449: 
 4450:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4451:       const double r_eth = ramp*nodeBnd->eth;
 4452:       double r_eta1_bar = 0.0;
 4453: 
 4454: 
 4455:       // Compute tide elevation
 4456:       if (iettype == 3 || iettype == 5) {   
 4457: 
 4458:          if constexpr(iloadtide==1) { // loading tide
 4459:             assert(false && "Loading tide not implemented");
 4460:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4461:          }
 4462:          
 4463:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4464: 
 4465:             const double efa  = nodeBnd->efa[jfr]; 
 4466:             const double emo  = nodeBnd->emo[jfr]; 
 4467: 
 4468:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4469:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4470:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4471: 
 4472:          } // for jfr
 4473: 
 4474:       } // if iettype
 4475: 
 4476:       switch (iettype) {
 4477:          case 1:
 4478:          case 2:
 4479:          case 4:
 4480:             nodeBnd->elbc = r_eic + r_eth;
 4481:             break;
 4482:          case 3:
 4483:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4484:             break;
 4485:          case 5:
 4486:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4487:             break;
 4488:       } // switch
 4489: 
 4490: 
 4491:       //Add inverse barometric effects
 4492:       if (iettype != 0 && inv_atm_bnd == 1) {
 4493:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4494:       }
 4495: 
 4496:    }
 4497: 
 4498: 
 4499:    __global__ void computeHorizontalViscosity(void) { 
 4500: 
 4501:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4502: 
 4503:       SIDE(side);
 4504: 
 4505:       if (side->isDry) return;
 4506: 
 4507:       for (int k = 0; k < nvrt; k++) {
 4508:          side->nuGradU[k] = {0.0, 0.0};
 4509:       }
 4510: 
 4511:       if constexpr(ihorcon == 1) {
 4512:          for (int k = side->kb; k < nvrt - 1; k++) {
 4513:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4514:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 4515:             // By Zhang and Baptista.
 4516: 
 4517:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4518:             // This is a standard discretization of the Laplacian operator.
 4519:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4520:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4521:             // Gamma is hvis_coef0 in the code.
 4522:             // The value of gamma needs to be < 0.5.
 4523: 
 4524:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4525:             // side under consideration in each of the two possible elements that share the side.
 4526:             Vector2 sumU = {0.0, 0.0};
 4527:             for (int l = 0; l < 2; l++) {
 4528:                const Element *elem = side->elems[l];
 4529: 
 4530:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4531: 
 4532:                // Find the local index of the side in the element
 4533:                const int idxSide = elem->sideLocalIdx(side);
 4534: 
 4535:                // Find the two sides that are connected to the side under consideration
 4536:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 4537:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 4538: 
 4539:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4540: 
 4541:             }
 4542: 
 4543:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4544: 
 4545:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 4546:    
 4547:          }
 4548:       }
 4549:       else if constexpr(ihorcon == 2) {
 4550:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4551:       }
 4552: 
 4553: 
 4554:    }
 4555: 
 4556: 
 4557:    __global__ void setEssentialBC(void) {
 4558:       // Set essential boundary conditions 
 4559:       NODE(node); // Each boundary node
 4560:       NodeBoundary *nodeBnd = node->nodeBnd;
 4561:       
 4562:  
 4563:       // Check if this node has essential BC
 4564:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4565:          // Verify BC value is valid
 4566:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4567: 
 4568:        
 4569:          // Set diagonal to 1 and zero off-diagonals
 4570:          node->coeffDiag = 1.0;
 4571: 
 4572:          for (int j = 0; j < node->numNodes; j++) {
 4573:                node->coeffMatrix[j] = 0.0;
 4574:          }
 4575:          
 4576:          // Set solution and RHS to BC value
 4577:          node->mX  = nodeBnd->elbc;
 4578:          node->qel = nodeBnd->elbc;
 4579: 
 4580:       } else {
 4581:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4582: 
 4583:          for (int j = 0; j < node->numNodes; j++) {
 4584:                Node* nbNode = node->nodes[j];
 4585:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4586:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4587:                   // Verify neighbor's BC value
 4588:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4589: 
 4590:                   // Subtract contribution to RHS
 4591:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4592:                   node->coeffMatrix[j] = 0.0;  
 4593:                }
 4594:          }
 4595:       }
 4596:    }
 4597: 
 4598: 
 4599:    __global__ void updateElevation(void) {
 4600:       NODE(node);
 4601: 
 4602: 
 4603:       node->eta2 = node->mX;
 4604: 
 4605:       node->updateZCoordData();
 4606:    }
