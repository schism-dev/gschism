 9216: 
 9217: #ifdef DONTCOMPILE
 9218: __global__ void checkMassConservation(Tracers* sumtr) {
 9219: 
 9220:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 9221: 
 9222:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 9223: 
 9224:    Element *elem = &(mesh->localElemData[i]);
 9225: 
 9226:    // Skip dry elements
 9227:    if (elem->isDry) return;
 9228: 
 9229:    // Local sum array for this thread
 9230:    double localSum[ntracers] = {0.0};
 9231: 
 9232:    // Sum over vertical levels for this element
 9233:    const int kbe = elem->kbe;
 9234:    const double area = elem->area;
 9235: 
 9236:    for (int k = kbe; k < nvrt; k++) {
 9237:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 9238:       
 9239:       // Accumulate tracer mass
 9240:       for (int tr = 0; tr < ntracers; tr++) {
 9241:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 9242:       }
 9243:    }
 9244: 
 9245:    //  This function returns per element sums. A reduction must be done on the host side.
 9246: }  
 9247: 
 9248: 
 9249: __global__ void transport(void) {
 9250: 
 9251:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 9252: 
 9253:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 9254: 
 9255:    Element *elem = &(mesh->localElemData[ie]);
 9256: 
 9257:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 9258: 
 9259:                for (int m=0; m<ntr; m++) {
 9260:                   for (int k=kbe(ie); k<nvrt; k++) {
 9261:                      // Calculate each polynomial's weight 
 9262:                      wm=0.d0; sum1=0.d0; 
 9263:                      wm1=0.d0; wm2=0.d0; 
 9264:                      for (int i=0; i<elem->nweno2; i++) {
 9265:                   
 9266:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 9267:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 9268:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 9269:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 9270:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 9271:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 9272:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 9273:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 9274:                      // -----------------Hu and Shu (1999)'s method----------------
 9275:                      b4=b1+b2+b3
 9276: 
 9277: //Error: add PRODUCTION CPP
 9278: #ifdef DEBUG
 9279:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 9280:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 9281:                     call parallel_abort(errmsg)
 9282:                   }
 9283: #endif
 9284: 
 9285:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 9286:                   // !----test-------------- 
 9287:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 9288:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 9289:                   // !wm(i)=wm1(i)*wm2(i)
 9290:                   // !---------------------- 
 9291:                   sum1=sum1+wm(i)
 9292:                 } // end for i
 9293: 
 9294:                 wm=wm/sum1
 9295: 
 9296:                 for (int j=0; j<elem->i34; j++) {
 9297: 
 9298:                   const Side *side  = elem->sides[j];
 9299:                   const Node *node1 = side->n1;
 9300:                   const Node *node2 = side->n2;
 9301: 
 9302:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 9303:                      trsd=0.d0
 9304:                      for (int kk=0; kk<nquad; kk++) {
 9305:                         for (int i=0; i<elem->nweno2; i++) {
 9306:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 9307:                         } // end for i   
 9308:                      } // end for kk
 9309:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 9310:                   } // outward flux
 9311:                } // end for j=1,i34(ie) ! side
 9312:             }
 9313:          }
 9314:               
 9315: 
 9316: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 9317: //             //   calculate each polynomial's weight 
 9318: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 9319: //                 wm=0.d0; sum1=0.d0
 9320: //                 do i=1,nweno1(ie) !for each polynomial
 9321: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 9322: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 9323: //                   b1=b1*b1+b2*b2 !smoothness indicator
 9324: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 9325: //                   wm(i)=b2
 9326: //                   sum1=sum1+b2
 9327: //                   !wm(i)=1.d0
 9328: //                   !sum1=sum1+1.d0
 9329: 
 9330: // // Error: PRODUCTION
 9331: // #ifdef DEBUG
 9332: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 9333: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 9334: //                     call parallel_abort(errmsg)
 9335: //                   endif
 9336: // #endif
 9337: 
 9338: //                 enddo !i
 9339: //                 wm=wm/sum1 !final weight
 9340: 
 9341:                 for (int j=0; j<elem->i34; j++) { // side
 9342:                   const Side *side = elem->sides[j];
 9343:                   const Node *node1 = side->n1;
 9344:                   const Node *node2 = side->n2;
 9345: 
 9346:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 9347:                     trsd=0.d0
 9348:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 9349:                       for (int i=0; i<elem->nweno1; i++) {
 9350:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 9351:                       }
 9352:                     enddo //kk
 9353:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 9354:                   } // outward flux
 9355:                 } // end for j=1,i34(ie) ! side
 9356:               } // end for k; ntr 
 9357: 
 9358:             else !simple upwind method
 9359:               do j=1,i34(ie)
 9360:                 jsj=elside(j,ie)
 9361:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 9362:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 9363:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 9364:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 9365:                   endif
 9366:                 enddo  !vertical layers
 9367:               enddo !j=1,i34(ie) ! side
 9368:             endif !order of accuracy
 9369: 
 9370:          //  enddo !ie
 9371: // !$OMP     end do
 9372: 
