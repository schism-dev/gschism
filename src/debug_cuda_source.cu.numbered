 6112:    __global__ void resetVelocityOpenBndNodes(void) {
 6113:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6114: 
 6115:       NODE_BND(nodebnd);
 6116: 
 6117:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6118:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }
 6119:       }
 6120: 
 6121:    }
 6122: 
 6123: 
 6124:    __global__ void setVelocityOpenBndNodes(void) {
 6125:    // For open boundary nodes sets their velocity to the imposed values.
 6126: 
 6127:       SIDE_BND(sidebnd);
 6128: 
 6129:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6130:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6131:          // to its segment to the average of the side velocity.
 6132: 
 6133:          for (int k = 0; k < nvrt; k++) {
 6134:             Node *n1 = sidebnd->side->n1;
 6135:             Node *n2 = sidebnd->side->n2;
 6136: 
 6137: 
 6138:             Vector2 n1_u2(n1->u2[k]);
 6139:             Vector2 n2_u2(n2->u2[k]);
 6140: 
 6141:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6142:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6143:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6144:             }
 6145:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6146:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6147:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6148:             }
 6149: 
 6150:          }
 6151: 
 6152:       }
 6153: 
 6154:    }
