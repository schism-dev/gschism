 8225: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 8226:    Element *elems = mesh->localElemData;
 8227: 
 8228:    *addr = elems;
 8229:    *sizeElement = sizeof(Element);
 8230:    switch (varCode) {
 8231:       case (int)VarCode::z:
 8232:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 8233:          *sizeType = sizeof(double);
 8234:          break;
 8235:       case (int)VarCode::x:
 8236:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 8237:          *sizeType = sizeof(Vector2);
 8238:          break;
 8239:       case (int)VarCode::area:
 8240:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 8241:          *sizeType = sizeof(double);
 8242:          break;
 8243:       case (int)VarCode::depth:
 8244:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 8245:          *sizeType = sizeof(double);
 8246:          break;
 8247:       case (int)VarCode::radius:
 8248:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 8249:          *sizeType = sizeof(double);
 8250:          break;
 8251:       case (int)VarCode::ghat:
 8252:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 8253:          *sizeType = sizeof(Vector2);
 8254:          break;
 8255:       case (int)VarCode::kb:
 8256:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 8257:          *sizeType = sizeof(int);
 8258:          break;
 8259:       case (int)VarCode::isdry:
 8260:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 8261:          *sizeType = sizeof(int);
 8262:          break;            
 8263:       case (int)VarCode::w:
 8264:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 8265:          *sizeType = sizeof(double);
 8266:          break;
 8267:       case (int)VarCode::FaceIndices:
 8268:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 8269:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 8270:          *sizeType = sizeof(Node);
 8271:          break;
 8272:       default:
 8273:          *offset = -1;
 8274:    }
 8275: }
