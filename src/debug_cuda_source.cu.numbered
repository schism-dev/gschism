 1463:    //    return nodes[idx] + idx;
 1464:    // }
 1465: 
 1466:    // // Get's the pointer to the element using the array of global pointers to elements
 1467:    // __device__ const Element *getGlobalElem(int je) {
 1468:    //    const int idx = je / max_ne; // Get the index of the partition that contains the element
 1469:    //    return elems[idx] + idx;
 1470:    // }
 1471: 
 1472:    // // Get's the pointer to the side using the array of global pointers to sides
 1473:    // __device__ const Side *getGlobalSide(int js) {
 1474:    //    const int idx = js / max_ns; // Get the index of the partition that contains the side
 1475:    //    return sides[idx] + idx;
 1476:    // }
 1477: 
 1478:    // // Get's the global index of local node idx
 1479:    // __device__ int getGlobalNodeIndex(int idx) {
 1480:    //    return idx + partNum * max_np;
 1481:    // }
 1482: 
 1483:    // // Get's the global index of local element idx
 1484:    // __device__ int getGlobalElemIndex(int idx) {
 1485:    //    return idx + partNum * max_ne;
 1486:    // }
 1487: 
 1488:    // // Get's the global index of local side idx
 1489:    // __device__ int getGlobalSideIndex(int idx) {
 1490:    //    return idx + partNum * max_ns;
 1491:    // }  
 1492: 
 1493:    __device__ Mesh(int partNum,
 1494:                    int npgb, int negb, int nsgb, 
 1495:                    int np, int ne, int ns,
 1496:                    int max_np, int max_ne, int max_ns, int nseg,
 1497:                    Node **nodesPtr, Element **elemsPtr, Side **sidesPtr,
 1498:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 1499:                    Node    **localNodeNeighNodesMem,
 1500:                    Element **localNodeNeighElemsMem,
 1501:                    double *partCoeffMatrixMem,
 1502:                    NodeBoundary *localNodeBoundaryMem,
 1503:                    SideBoundary *localSideBoundaryMem,
 1504:                    BoundarySegment *localSegmentMem,
 1505:                    double h_c, double h_s, double theta_b, double theta_f, double *sigma_lcl, double *sigma, double *ztot,
 1506:                    double *cs, double *dcs
 1507:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 1508:                        np(np), ne(ne), ns(ns),
 1509:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
 1510:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
 1511:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
 1512:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
 1513:                        localNodeBoundaryMem(localNodeBoundaryMem), localSideBoundaryMem(localSideBoundaryMem),
 1514:                        localSegmentMem(localSegmentMem),
 1515:                        h_c(h_c), h_s(h_s), theta_b(theta_b), theta_f(theta_f), sigma_lcl(sigma_lcl), sigma(sigma), ztot(ztot),
 1516:                        cs(cs), dcs(dcs),
 1517:                        coeffMatrixMem(partCoeffMatrixMem),
 1518:                        landBoundarySegment(true),
 1519:                        landBoundaryNode(true)
 1520:    {
 1521:       printf("Mesh constructor for partition %d\n", partNum);
 1522: 
 1523:       printf("npgb = %d, negb = %d, nsgb = %d, nseg = %d\n", npgb, negb, nsgb, nseg);
 1524:       printf("np = %d, ne = %d, ns = %d\n", np, ne, ns);
 1525:       printf("max_np = %d, max_ne = %d, max_ns = %d\n", max_np, max_ne, max_ns);
 1526:  
 1527:       printf("elemsPtr = %p, elems = %p\n", *elems, elemsMem);
 1528:       
 1529:       sinh_theta_f = sinh(theta_f);
 1530: 
