 5192:       node->ETP = 0.0;
 5193: 
 5194:       // For all tidal potential components
 5195:       for (int j=0; j<ntip; j++) {
 5196: 
 5197:          const double nodeETP = node->computeETP(j, time, tfreq, tamp, tnf, tear, jspc);
 5198: 
 5199:          node->ETP += nodeETP;
 5200: 
 5201:          if constexpr(iloadtide==1) { // loading tide
 5202:             assert(false && "Loading tide not implemented");
 5203:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5204:          }
 5205:          
 5206:       }
 5207: 
 5208:      
 5209:    }
