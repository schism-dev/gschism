 2534: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2535:    // Returns the value of the velocity at the side center
 2536:    const double w1 = getBoundaryArrayValueWeight();
 2537:    const double w2 = 1.0 - w1;
 2538:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2539:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2540: 
 2541:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2542: }
