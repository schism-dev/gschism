 1554: __device__ __inline__ double min3(double a, double b, double c) {
 1555:    return min(a, min(b, c));
 1556: }
 1557: 
 1558: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1559:    return min(a, min(b, min(c, d)));
