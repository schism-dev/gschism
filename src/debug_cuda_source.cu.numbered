  873: 
  874: // ----------------------------- Frames -----------------------------
  875: 
  876: // Frames are used to transform vectors between different coordinate systems.
  877: // They are templated in such a way that when ics==1, they have (most likely) no overhead.
  878: template<int ICS>
  879: struct Frame {};
  880: 
  881: template<>
  882: struct Frame<1> {
  883:    __forceinline__ __device__ void update(double, double) {}
  884:    __forceinline__ __device__ Vector3 G2L(Vector3 vi) const { return vi; }
  885:    __forceinline__ __device__ Vector3 L2G(Vector3 vi) const { return vi; }
  886:    __forceinline__ __device__ Vector2 projHorVec(Vector2 v, const Frame<1>&) const { return v; }
  887:    __forceinline__ __device__ Vector3 nUp(void)         const { return {0.0, 0.0, 0.0}; }
  888:    __forceinline__ __device__ Vector3 nZonal(void)      const { return {0.0, 0.0, 0.0}; }
  889:    __forceinline__ __device__ Vector3 nMeridional(void) const { return {0.0, 0.0, 0.0}; }
  890: };
  891: 
  892: template<>
  893: struct Frame<2> {
  894:    // Column 0 (East):  (-sin_lon, cos_lon, 0)              - store 2 values, t20=0 implicit
  895:    // Column 1 (North): Normalized oblate ellipsoid vector  - store 3 values
  896:    // Column 2 (Up):    cross(col0, col1)                   - recomputed on demand
  897:     double t00, t10;        // col0 (t20=0 implicit)
  898:     double t01, t11, t21;   // col1
  899: 
  900:    __device__ void update(double lat, double lon) { // XXX use lat, lon instead of ar1, ar2?
  901: 
  902:       assert(lat >= -pi/2.0 && lat <= pi/2.0 && "GRID: lat out of range");
  903:       assert(lon >= -pi     && lon <= pi     && "GRID: lon out of range");
  904: 
  905:       double sin_lon, cos_lon, sin_lat, cos_lat;
  906:       sincos(lon, &sin_lon, &cos_lon); // These functions are faster than sin(ar1) and cos(ar1).
  907:       sincos(lat, &sin_lat, &cos_lat);
  908: 
  909:       t00 = -sin_lon;
  910:       t10 =  cos_lon;
  911:       t01 = -cos_lon*sin_lat;
  912:       t11 = -sin_lon*sin_lat;
  913:       t21 = (rearth_pole/rearth_eq)*cos_lat;
  914: 
  915:       const double col1_norm = sqrt(t01*t01 + t11*t11 + t21*t21);
  916:       assert (col1_norm != 0.0 && "GRID: col1_norm=0");
  917: 
  918:       const double col1_norm_inv = 1.0/col1_norm;
  919:       t01 = t01*col1_norm_inv;
  920:       t11 = t11*col1_norm_inv;
  921:       t21 = t21*col1_norm_inv;
  922: 
  923:       // The 3rd column (col2) is the cross product of the first two and is computed when needed.
  924: 
  925: 
  926:    }
  927: 
  928:    __forceinline__ __device__ void print(void) const {
  929:       printf("frame = [%.16f, %.16f, %.16f, %.16f, %.16f]\n", t00, t10, t01, t11, t21);
  930:    }
  931: 
  932:    __forceinline__ __device__ void getCol2(double &t02, double &t12, double &t22) const {
  933:       // cross(col0, col1), with t20=0 implicitly:
  934:       // |  i       j       k   |
  935:       // | t00     t10      0   |
  936:       // | t01     t11     t21  |
  937:       t02 =  t10*t21;
  938:       t12 = -t00*t21;
  939:       t22 =  t00*t11 - t10*t01;
  940:    }
  941: 
  942: 
  943:    __forceinline__ __device__ Vector2 projHorVec(Vector2 const &vec0, Frame<2> const &frameout) const {
  944:    // Transforms a horizontal vector from one frame to another and projects it to the new local horizontal plane.
  945:    // Inputs:
  946:    //        vec0: vel. in this frame;
  947:    //        frameout: Output frame;
  948:    // Output: 
  949:    //        vel. in new frame  
  950:    //
  951:    // Projects a horizontal vector from frame 1 (this) to frame 2 (frameout),
  952:    // discarding the z-component of the result to keep only the local horizontal
  953:    // plane of frame 2.
  954:    //
  955:    // Since F1 and F2 are global-to-local rotation matrices, transforming from
  956:    // frame 1 to frame 2 requires F2 * F1^{-1} = F2 * F1^T, as rotation matrices
  957:    // are orthogonal. This product is computed as dot products between columns of
  958:    // F1 and columns of F2, which is equivalent to multiplying rows of F1^T by
  959:    // columns of F2.// 
  960: 
  961:       auto const fo = frameout; // Just an alias for the output frame.
  962:       Vector2 res;
  963: 
  964:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  965:       // of t and fo.t are the same.
  966:       const double d00 = t00*fo.t00 + t10*fo.t10;
  967:       const double d10 = t01*fo.t00 + t11*fo.t10;
  968: 
  969:       const double d01 = t00*fo.t01 + t10*fo.t11;
  970:       const double d11 = t01*fo.t01 + t11*fo.t11 + t21*fo.t21;
  971: 
  972:       res.x = vec0.x * d00 + vec0.y * d10;
  973:       res.y = vec0.x * d01 + vec0.y * d11;
  974: 
  975:       return res;
  976:    }
  977: 
  978:    __forceinline__ __device__ Vector3 G2L(Vector3 const &vi) const {
  979:       Vector3 vo;
  980:       double t02, t12, t22;
  981: 
  982:       // Compute the 3rd column of the frame tensor
  983:       getCol2(t02, t12, t22);
  984: 
  985:       vo.x = vi.x*t00 + vi.y*t10;
  986:       vo.y = vi.x*t01 + vi.y*t11 + vi.z*t21;
  987:       vo.z = vi.x*t02 + vi.y*t12 + vi.z*t22;
  988: 
  989:       return vo;
  990:    
  991:    }
  992: 
  993:    __forceinline__ __device__ Vector3 L2G(Vector3 const &vi) const {
  994:       Vector3 vo;
  995:       double t02, t12, t22;
  996: 
  997:    // Compute the 3rd column of the frame tensor
  998:       getCol2(t02, t12, t22);
  999: 
 1000:       // F * vi (non-transposed, so we use rows of F)
 1001:       vo.x = vi.x*t00 + vi.y*t01 + vi.z*t02;
 1002:       vo.y = vi.x*t10 + vi.y*t11 + vi.z*t12;
 1003:       vo.z =            vi.y*t21 + vi.z*t22;  // t20=0 term dropped
 1004: 
 1005:       return vo;
 1006:    }
 1007: 
 1008:    // Unit vectors that define the local frame
 1009:    __forceinline__ __device__ Vector3 nUp(void) const {
 1010:       // Column 2 = cross(column0, column1)
 1011:       return { t10*t21, -t00*t21, t00*t11 - t10*t01 };
 1012:    }
 1013: 
 1014:    __forceinline__ __device__ Vector3 nZonal(void) const {
 1015:       // Column 0
 1016:       return { t00, t10, 0.0 };
 1017:    }
 1018: 
 1019:    __forceinline__ __device__ Vector3 nMeridional(void) const {
 1020:       // Column 1
 1021:       return { t01, t11, t21 };
 1022:    }
 1023: 
 1024: };
