 2251:    template<typename T>
 2252:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 2253:       T values[4];
 2254:       getNodalValues(level, func, values);
 2255: 
 2256:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2257:       if constexpr (IsVector2<T>::value && ics == 2) {
 2258: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2259:          projectNodeVectorsToElementFrame(values);
 2260: printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2261:       }
 2262: 
 2263:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2264:    }
 2265: 
 2266:    template<typename T>
 2267:    __device__ __forceinline__ T Element::interpolate(const double shapeCoords[4], T Node::* field) const {
 2268:       T values[4];
 2269:       getNodalValues(field, values);
 2270: 
 2271:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2272:       if constexpr (IsVector2<T>::value && ics == 2) {
 2273: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2274:          projectNodeVectorsToElementFrame(values);
 2275: printf("interpolate 3: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2276:       }
 2277:       
 2278:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2279:    }
 2280: 
 2281: 
 2282:    template<typename T>
 2283:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
 2284:       T values[4];
 2285:       getNodalValues(level, field, values);
 2286:       
 2287: if (shapeCoords[0] > 1.1 || shapeCoords[1] > 1.1 || shapeCoords[2] > 1.1 || 
 2288:     shapeCoords[0] < -0.1 || shapeCoords[1] < -0.1 || shapeCoords[2] < -0.1) printf("XXX shapeCoords = (%.17f, %.17f, %.17f, %.17f)\n", shapeCoords[0], shapeCoords[1], shapeCoords[2], shapeCoords[3]);
 2289:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2290:       if constexpr (IsVector2<T>::value && ics == 2) {
 2291: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2292:          projectNodeVectorsToElementFrame(values);
 2293: // printf("interpolate 4: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2294:       }
 2295: 
 2296:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2297:    }
 2298: 
 2299:    template<typename T>
 2300:    __device__ __forceinline__ T Element::mean(T Node::* field) const {
 2301:       T values[4];
 2302:       getNodalValues(field, values);
 2303: 
 2304:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2305:       if constexpr (IsVector2<T>::value && ics == 2) {
 2306: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2307:          projectNodeVectorsToElementFrame(values);
 2308: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2309:       }
 2310: 
 2311:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2312:    }
 2313: 
 2314:    template<typename T>
 2315:    __device__ __forceinline__ T Element::mean(T Side::* field) const {
 2316:       T values[4];
 2317:       getSideValues(field, values);
 2318:       
 2319:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2320:       if constexpr (IsVector2<T>::value && ics == 2) {
 2321: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2322:          projectSideVectorsToElementFrame(values);
 2323: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2324:       }
 2325: 
 2326:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2327:    }   
 2328: 
 2329:    template<typename T>
 2330:    __device__ __forceinline__ T Element::mean(int level,  T (Side::*func)(int) const) const {
 2331: 
 2332:       T values[4];
 2333: 
 2334: 
 2335:       values[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2336:       values[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2337:       values[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2338:       if (isQuad()) values[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2339:       else          values[3] = T();
 2340: 
 2341:       if constexpr (IsVector2<T>::value && ics == 2) projectSideVectorsToElementFrame(values);
 2342: 
 2343:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2344:    }
