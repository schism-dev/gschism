 1598: // Helper functions for computing the local node index at a given offset from another.
 1599: __device__ __inline__ int nxq(int offset, int index, int size) {
 1600:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1601:    // to the index to make it positive
 1602:    assert(index + offset + 16*size >= 0);
 1603:    return (index + offset + 16*size) % size;  
 1604: }
 1605: 
 1606: __device__ __inline__ int nxq(int index, int size) {
 1607:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1608:    // to the index to make it positive
 1609:    assert(index + 16*size >= 0);
 1610:    return (index + 16*size) % size; 
 1611: }
