  888:    __device__ void trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
  889:                                        Point3 &xt, double zint, Vector3 &u_int);
  890:     
  891:    __device__ bool trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
  892:                                                  Element *&nextElem, int &jlev, double &dt, double time_rm,
  893:                                                  const Side *origSide);
