 9397:       printf(">>>>>*** C++ 3 getStructSizes, sizes = %p\n", sizes);
 9398:       sizes[0] = (int)sizeof(Node);
 9399:       sizes[1] = (int)sizeof(Element);
 9400:       sizes[2] = (int)sizeof(Side);
