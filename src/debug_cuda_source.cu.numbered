 2359:                            if (idx_node_bnd >= mesh->nbp) return;
 2360: 
 2361: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 2362:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 2363:                            if (idx_side_bnd >= mesh->nbs) return;  
