 2160: 
 2161: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2162: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2163: // Returns the normal vector and the area of the element at this level
 2164: 
 2165:    if (isTri()) {
 2166:       // For triangles...
 2167: 
 2168:       // Indices of the nodes at level k, taking care of not going below the bed
 2169:       const int k0 = max(k, nodes[0]->kb);
 2170:       const int k1 = max(k, nodes[1]->kb);
 2171:       const int k2 = max(k, nodes[2]->kb);
 2172: 
 2173:       // Gets the element frame coordinates of the nodes at level k
 2174:       Point3 x0, x1, x2;
 2175:       if constexpr(ics==1) {
 2176:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2177:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2178:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2179: 
 2180:       } else {  // ics == 2
 2181:          Vector2 h0, h1, h2;
 2182: 
 2183:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2184: 
 2185:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2186:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2187:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2188:       }
 2189: 
 2190:       const Vector3 n20 = x2 - x0;
 2191:       const Vector3 n10 = x1 - x0; 
 2192: 
 2193:       // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 2194:       const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2195:       const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2196:       const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2197: 
 2198:       const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2199:       area3D = 0.5*len;
 2200: 
 2201:       const double inv_len = 1.0/len;
 2202: 
 2203:       return {nx*inv_len, ny*inv_len, nz*inv_len};
 2204:    
 2205:    }
 2206:    else {
 2207:       // For quads...
 2208: 
 2209:       assert(false && "Element normal vector: quads not yet implemented");
 2210:       return {0.0, 0.0, 0.0};
 2211: 
 2212: 
 2213:    }
 2214: }
 2215: 
 2216: /**
 2217:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 2218:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 2219:    If the segment is completely inside the element, then it returns true.
 2220: 
 2221:    This function assumes:
 2222:    - The initial point is on a side of the element. 
 2223:    - Its position is given by parameter t in the range [0,1].
 2224:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 2225:       intersects the element (elements are convex).
 2226: 
 2227:    To find the intersection point, this function does the following:
 2228:    - it finds the intersection of the line segment with all the element side lines,
 2229:       except for the one that contains the initial point.
 2230:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 2231:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 2232:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 2233:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 2234:       track segment is almost parallel to the element side line.
 2235: 
 2236:    Inputs:
 2237:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 2238:    @param x2, y2: other end of the line segment
 2239: 
 2240:    Outputs:
 2241:    @param side:  side that intersects the line segment (input and output)
 2242:    @param nextElement (output): element that contains the intersection point
 2243:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 2244:    @param zint (input/output): Vertical coordinate of the intersection point
 2245: 
 2246:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 2247:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 2248:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 2249: 
 2250:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 2251:    (Delta) being zero.
 2252: 
 2253:    The intersection2 point happens when:
 2254:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 2255:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 2256:    
 2257:    Assumption: the 4 points (including those of the side segment) are different.
 2258:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 2259:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 2260:    If true, (xIntersect,yIntersect) is the intersection.				
 2261:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 2262: **/
 2263: 
 2264: 
 2265: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 2266:                                               double &t, double& tIntersect, const Side *origSide) {
 2267:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa");
 2268: if (!containsPoint(x1, origSide)) printf("111: x1 = (%f, %f), origSide.center = (%f, %f)\n", x1.x, x1.y, origSide->center.x, origSide->center.y); 
 2269:    assert( containsPoint(x1, origSide) && "Starting point is not inside the element");                                    
 2270:    assert(!containsPoint(x2, origSide) && "Ending point is not outside the element");
 2271: 
 2272:    double closest_intersect_t = 1e10;
 2273:    bool found_intersection = false;
 2274: 
 2275:    for (int i = 0; i < i34; i++) {
 2276: 
 2277:       Side *side2 = sides[i];
 2278: 
 2279:       // (x3,y3)-(x4,y4) is the element side line
 2280:       const Point2 x3 = side2->n1->p;
 2281:       const Point2 x4 = side2->n2->p;
 2282: 
 2283:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 2284:       const double delta = cross(x2 - x1, x3 - x4);
 2285: 
 2286:       if (abs(delta) > 0) {
 2287: 
 2288:          const double delta1 = cross(x3 - x1, x3 - x4);
 2289:          const double delta2 = cross(x2 - x1, x3 - x1); 
 2290: 
 2291:          // Solves the two linear equations for tt1 and tt2
 2292:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2293:          const double tt2 = delta2/delta;
 2294: 
 2295:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 2296:             closest_intersect_t = min(closest_intersect_t, tt1);
 2297:             side = side2;
 2298:             nextElement = side->otherElem(this);
 2299:             t =          clamp(tt2, small, 1.0-small);
 2300:             tIntersect = clamp(tt1, small, 1.0-small);
 2301:             found_intersection = true;
 2302:          }
 2303: 
 2304:       
 2305:       }
 2306:       else {  // parallel segments
 2307: 
 2308:          continue; 
 2309:          assert(false && "Parallel segments should not happen under the new code");
 2310:          // In this case, we check if they are colinear. if they are, we compute the intersection point as:
 2311:          // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 2312: 
 2313:          // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 2314:          const double dist = dot(x1 - x3, side2->n);
 2315:          if (abs(dist) < small*length(x3 - x4)) {
 2316:             const double2 unitarySide = normalize(x4 - x3);
 2317:             const double len = dot(x2 - x1, unitarySide);
 2318:             t = t + len;
 2319:             t = max(0.0, min(t, 1.0));
 2320:             printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 2321: 
 2322: 
 2323:             // tIntersect = max(small, min(tt1, 1.0-small));
 2324:             // t = tt2;
 2325:             found_intersection = true;
 2326:          }
 2327:       }
 2328: 
 2329: 
 2330:    }
 2331: 
 2332: 
 2333: if (!found_intersection) {if (idx == 15876) printf("11111: No intersection found\n"); return false;}
 2334:    assert(found_intersection && "No intersection found");
 2335: 
 2336:    // found_intersection should always be true, since we checked all the sides.  
 2337:    return found_intersection;
 2338: }
 2339: 
 2340: __inline__ __device__ bool Element::containsPoint(Vector2 xt, const Side *origSide) const { 
 2341:    // Check if the point (xt,yt) is inside the element.
 2342:    // if ics==2, origSide is used to convert the point to the starting point's frame.
 2343:    assert((ics==2 || origSide==nullptr) && "origSide must be nullptr if ics == 1 and vice versa");
 2344: 
 2345:    double shpCoords[4];
 2346: if (origSide->idx == 15876) printf("containsPoint 1: xt = (%f, %f), elem->idx = %d, origSide->idx = %d\n", xt.x, xt.y, idx, origSide->idx);
 2347:    bool res = computeShapeCoords(xt, shpCoords, fiNo, origSide);
 2348: if (origSide->idx == 15876) printf("containsPoint 11: shpCoords = (%f, %f, %f, %f), origSide->idx = %d\n", shpCoords[0], shpCoords[1], shpCoords[2], shpCoords[3], origSide->idx);
 2349:    return res;
 2350: }
 2351: 
 2352: __inline__ __device__ bool Element::containsPoint(Vector2 &xt, bool fixCoords, const Side *origSide) const { 
 2353:    // Check if the point (xt,yt) is inside the element.
 2354:    // If fixCoords is true, and *the point is inside the element*, the point is nudged to be inside the element.
 2355:    // if ics==2, origSide is used to convert the point to the starting point's frame.
 2356:    assert((ics==2 || origSide==nullptr) && "origSide must be nullptr if ics == 1 and vice versa");
 2357: 
 2358:    double shpCoords[4];
 2359: if (origSide->idx == 15876) printf("containsPoint 2: xt = (%f, %f), elem->idx = %d, side = %p\n", xt.x, xt.y, idx, origSide);
 2360:    Vector2 tmp_xt = xt;
 2361:    const EFixIf fixIfCoords = fixCoords ? fiOnlyInside : fiNo;
 2362:    bool res = computeShapeCoords(tmp_xt, shpCoords, fixIfCoords, origSide);
 2363: 
 2364:    if (fixCoords && res) xt = tmp_xt;
 2365: 
 2366:    return res;
 2367: }
 2368: 
 2369: 
 2370: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 2371:                                              Point3 &xt, double zint, Vector3 &u_int) {
 2372: 
 2373:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 2374:    // Instead, we nudge the intersection point to the barycenter of the current element, and nextElement becomes
 2375:    // curElement.
 2376: 
 2377:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 2378:    // And uses this velocity instead to continue the tracking.
 2379: 
 2380:    // computes the intersection point in cartesian coordinates
 2381:    Point2 intersection = nextSide->p2_t(tt);  // XXXX I don't think this is necessary. THE intersection is already computed in findNextIntersection.
 2382: 
 2383:    // Nudges the point to the barycenter of the element. 
 2384:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 2385:    // next segment intersects the element sides. 
 2386:    // TODO: curElem->nudgeToBarycenter(intersection);  REMEMBER!!! RECOVER??? XXX KKKKK
 2387: 
 2388: 
 2389:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 2390:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 2391:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 2392:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 2393: 
 2394:    // If the side is an open boundary, the tangential velocity is set to zero.
 2395:    if (nextSide->isBnd()) vtan = 0.0;
 2396: 
 2397:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 2398:    const double us = vtan*nextSide->t().x;
 2399:    const double vs = vtan*nextSide->t().y;
 2400:    const double ws = nextSide->w2(jlev); 
 2401: 
 2402:    u_int = {us, vs, ws};
 2403: 
 2404:    // The end of this tracking segment is now the intersection point.
 2405:    xt = {intersection.x, intersection.y, zint};
 2406:    
 2407: }
 2408: 
 2409: /**
 2410:  * Tracks a particle through elements and vertical levels in the mesh.
 2411:  * 
 2412:  * @param x0,y0,z0     Starting position coordinates
 2413:  * @param xt,yt,zt     Target position coordinates
 2414:  * @param dtb          Time step for tracking
 2415:  * @param u_int        Initial velocity components
 2416:  * @param nextElem     Starting/resulting element index
 2417:  * 
 2418:  * @return Status code of type trackExitCodes
 2419:  * 
 2420:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2421:  * of the details are different. The idea is that the code requires less branches and is better fit
 2422:  * for GPU execution.
 2423:  * 
 2424:  * The main ideas here are:
 2425:  * - The starting point is expected to be in the starting element.
 2426:  * - since the starting point is inside the element, there are only two cases: 
 2427:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2428:  *     (b) it does not and (xt,yt) is already in the starting element.
 2429:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2430:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2431:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2432:  * - tt1 can be positive or negative. We only consider the positive values.
 2433:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2434:  * - The next intersection will occur at the smallest positive tt1.
 2435:  * - This intersection will be the next (x0,y0) position.
 2436:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2437:  *   of getting stuck in a loop.
 2438:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2439:  *   was found.
 2440:  * - Notice that curElement is the current element, while this is the element for which the first call to this function was made.
 2441:  */
 2442: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2443:                                                        Element *&nextElem, int &jlev, double &dt, double time_rm,
 2444:                                                        const Side *origSide) {
 2445:                                                             
 2446:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2447:    // else to do. This means that the full step occurred within the current element.
 2448:    assert(!isDry && "Starting element is dry");
 2449:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa");
 2450: Vector2 x0_tmp = toVector2(x0);
 2451: if (!containsPoint(toPoint2(x0), origSide)) {if (idx == 15876) printf("1111: elem->idx = %d, origSide->idx = %d, x0_tmp = (%f, %f), x0 = (%f, %f), origSide.center = (%f, %f)\n", idx, origSide->idx, x0_tmp.x, x0_tmp.y, x0.x, x0.y, origSide->center.x, origSide->center.y); return false;}
 2452:    assert(containsPoint(toPoint2(x0), origSide) && "Starting point is not inside the element");
 2453: 
 2454:    if (containsPoint(toPoint2(xt), true, origSide)) {  // The "true" means that, if the point is very close to the boundary, it is nudged to be definitely inside the element.
 2455: 
 2456:       assert(containsPoint(toPoint2(xt), origSide) && "Target point is not inside the element");
 2457:       assert(!isDry && "Target point is inside a dry element");
 2458: 
 2459:       u_int = interpolateVelocities(xt, origSide);
 2460: 
 2461:       nextElem = this;
 2462: 
 2463:       return true;
 2464:    }
 2465: 
 2466: 
 2467:    
 2468: 
 2469:    assert(norm2(toVector2(xt - x0)) > 0.0 && "Zero length track"); 
 2470:    
 2471:    double t;
 2472:    Side *nextSide = nullptr;
 2473:    double tIntersect = 1e10;
 2474: 
 2475: 
 2476:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2477:    // (x0,y0) is inside the element but the target point is not.
 2478:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect, origSide);
 2479: if (!found_intersection) {if (idx == 15876) printf("111112: No intersection found\n"); return false;}
 2480:    assert(found_intersection && "No intersection found at %d");
 2481: 
 2482:    Point2 xtmp = toPoint2(toLocalFrame(nextSide->p3_t(t), origSide)); // If needed, moves the target point to the intersection point
 2483: 
 2484:    // If the next element is not dry, nudge it to the barycenter to ensure that the point is inside the element.
 2485:    if (nextElem != nullptr && !nextElem->isDry) {
 2486:       assert(nextElem->containsPoint(xtmp, origSide) && "Intersection point is not inside the next element");
 2487:       nextElem->nudgeToBarycenter(xtmp, origSide);
 2488:    }
 2489: 
 2490:    const double zint = (1 - tIntersect)*x0.z + tIntersect*xt.z;
 2491:    xt = {xtmp.x, xtmp.y, zint};
 2492: 
 2493:    // if the tracking segment goes out of water (either dry or edge boundary)
 2494:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2495: 
 2496: 
 2497:       trackGoesOutOfWater(nextSide, this, t, jlev, xt, zint, u_int);
 2498: 
 2499:       assert(this->containsPoint(toPoint2(xt), origSide) && "Target point is not inside the current element");
 2500:       // When this happens, the backtracking stops.
 2501: 
 2502:       dt *= tIntersect;
 2503: 
 2504:       // In this case, the next element is again the current element.
 2505:       nextElem = this;
 2506: 
 2507: // printf("trackGoesOutOfWater: side->idx = %d, dt = %.17f, time_rm = %.17f, u_int = (%.17f, %.17f, %.17f)\n", nextSide->idx, dt, time_rm, u_int.x, u_int.y, u_int.z);
 2508: 
 2509:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2510:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2511:       return true;    
 2512:    }
 2513: 
 2514: 
 2515:    assert(nextElem->containsPoint(toPoint2(xt), origSide) && "Target point is not inside the next element");
 2516:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2517:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2518: 
 2519:    
 2520:    dt *= tIntersect; // reduces the time step to the time it takes to reach the intersection
 2521: 
 2522:    u_int = nextElem->interpolateVelocities(xt, origSide); 
 2523: 
 2524:    assert(nextElem != this && "Next element is the same as the current element");
 2525: 
 2526:    return true;
 2527: }
 2528: 
 2529: 
 2530: __inline__ __device__ double Element::computeSignedArea(void) const {
 2531:    // Compute the area of the element
 2532: 
 2533:    Point2 x0, x1, x2, x3;
 2534:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2535: 
 2536:    double res = signedArea(x0, x1, x2);
 2537: 
 2538:    // In the quad case we need to add the area of the other triangle.
 2539:    if (isQuad()) {
 2540:       x3 = getLocalHorizontalNodePosition(3);
 2541:       double ar1 = signedArea(x0, x2, x3);
 2542:       double ar2 = signedArea(x0, x1, x3);
 2543:       double ar3 = signedArea(x1, x2, x3);
 2544:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2545: 
 2546:       res += ar1 + ar2 + ar3;
 2547:    }
 2548: 
 2549:    return res;
 2550: }
 2551: 
 2552: 
 2553: __inline__ __device__ void Element::nudgeToBarycenter(Point2 &p, const Side *origSide) const {
 2554: // Nudges the point (x,y) to the barycenter of the element
 2555: 
 2556:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa");
 2557: 
 2558:    Point3 c = toLocalFrame(toPoint3(center, centerZ()), origSide); // In local frame coordinates if ics == 2
 2559: if (origSide->idx == 15876) printf("nudgeToBarycenter 1: center = (%f, %f) p = (%f, %f) elem->idx = %d, origSide->idx = %d, c = (%f, %f)\n", center.x, center.y, p.x, p.y, idx, origSide->idx, c.x, c.y);
 2560:    p = (1.0 - btrack_nudge)*p + btrack_nudge*toPoint2(c);
 2561: }
 2562: 
 2563: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2564:                                                                 (nodes[1]->isDry2()) ||
 2565:                                                                 (nodes[2]->isDry2()) ||
 2566:                                                                 (i34==4 && nodes[3]->isDry2());
 2567: }
 2568: 
 2569: __inline__ __device__ double Element::detJ_eta(void) const {
 2570:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2571:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2572: }
 2573: 
 2574: __inline__ __device__ double Element::detJ_xi(void) const {
 2575:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2576:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2577: }
 2578: 
 2579: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2580:    // In boundary sides, the element 1 is nullptr
 2581:    return side->elems[1] == nullptr; 
 2582: }
 2583: 
 2584: 
 2585: 
 2586: /**
 2587:    Compute the shape coordinates of the point (xt,yt) in the element.
 2588:    @param xt (input): x-coordinate of the point
 2589:    @param shpCoords (output): shape coordinates of the point
 2590:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2591:    @return true if the point is inside the element, false otherwise
 2592: **/
 2593: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 2594: 
 2595:    // Compute the shape coordinates of the point xt in the element.
 2596:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 2597:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 2598:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 2599:    // from the local frame, so use additional check.
 2600: 
 2601:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa");
 2602: 
 2603:    if (isTri()) { // Triangular element
 2604: 
 2605:       // Horizontal local node coordinates. 
 2606:       Point2 x0 = nodes[0]->p;
 2607:       Point2 x1 = nodes[1]->p;
 2608:       Point2 x2 = nodes[2]->p;
 2609: 
 2610:       // If ics == 2, the node coordinates are transformed to local frame.
 2611:       if constexpr(ics==2) {
 2612:          const Point3 p0 = toPoint3(x0, nodes[0]->gz);
 2613:          const Point3 p1 = toPoint3(x1, nodes[1]->gz);
 2614:          const Point3 p2 = toPoint3(x2, nodes[2]->gz);
 2615: 
 2616:          // Coordinates of the center of the original side
 2617:          const Point3 c = {origSide->center.x, origSide->center.y, origSide->centerZ()}; 
 2618: 
 2619:          // Convert the node coordinates to the local frame centered at the element center
 2620:          x0 = toVector2(origSide->frame.G2L(p0 - c));
 2621:          x1 = toVector2(origSide->frame.G2L(p1 - c));
 2622:          x2 = toVector2(origSide->frame.G2L(p2 - c));
 2623:       }
 2624: 
 2625:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2626:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2627:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2628:       shpCoords[3] = 0.0;
 2629: 
 2630: if (origSide->idx == 15876) printf("computeShapeCoords 1: x,y = (%f, %f), elem->idx = %d, shpCoords = (%f, %f, %f, %f)\n", xt.x, xt.y, idx, shpCoords[0], shpCoords[1], shpCoords[2], shpCoords[3]);
 2631: 
 2632:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2633:       const bool res = (tmpmin >= -small);  
 2634:       
 2635:       // If the point is not inside the element (with a small tolerance), we do not need to fix the negative shape coordinates.
 2636:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2637: 
 2638:       
 2639:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2640:       // then we fix the negative shape coordinates.
 2641:       if ((tmpmin < 0) && fix) {
 2642: 
 2643:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2644:          // keeping the sum of the shape coordinates equal to 1.
 2645:          // I have tested and compared the new algorithm with the old one, and they give
 2646:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2647:          // The new algorithm should be faster since it is branchless.
 2648:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 2649:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2650:          
 2651:          shpCoords[0] = (shpCoords[0] + a)*b;
 2652:          shpCoords[1] = (shpCoords[1] + a)*b;
 2653:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2654: 
 2655:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2656:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 2657:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 2658: 
 2659:          // Update the point coordinates for the new shape coordinates
 2660:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2661:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2662:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2663: 
 2664:       }
 2665: 
 2666:       // Check if the point is inside the element
 2667:       return res;      
 2668:    }
 2669:    else {
 2670:       Error("Not implemented yet");
 2671: #ifdef QUADS
 2672:       // Reproject pt in eframe of nel for ics=2
 2673:       if constexpr(ics==1) {
 2674:          xn2 = xt; 
 2675:          yn2 = yt;
 2676:       }
 2677:       else {
 2678:          // Transform the point coordinates to the local frame
 2679:          frame.G2L(xt, xn2);
 2680:          frame.G2L(yt, yn2);
 2681:       }
 2682: 
 2683:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2684: #endif
 2685:    }
 2686: 
 2687:    assert(false && "computeShapeCoords: should never reach this point");
 2688:    return false;  // Never reached
 2689: 
 2690: }
 2691: 
 2692: 
 2693: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2694: // Convert shape coordinates to cartesian coordinates
 2695: 
 2696:    if (i34 == 3) {
 2697:       // Triangular element
 2698:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2699:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2700:    }
 2701:    else {
 2702:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2703:    }
 2704: 
 2705: }
 2706: 
 2707: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2708:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2709:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2710:    // The formula for the integral is:
 2711:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2712: 
 2713:    printf("intPhiPhi: TEST\n");
 2714: 
 2715:    const Node *n0 = nodes[0];
 2716:    const Node *n1 = nodes[1];
 2717:    const Node *n2 = nodes[2];
 2718:    const Node *n3 = nodes[3];
 2719: 
 2720:    const Vector2 p0 = n0->p;
 2721:    const Vector2 p1 = n1->p;
 2722:    const Vector2 p2 = n2->p;
 2723:    const Vector2 p3 = n3->p;
 2724: 
 2725:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2726:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2727:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2728:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2729: 
 2730:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2731: }
 2732:    
 2733: 
 2734: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2735:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2736:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2737:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2738:    // The formula is also based on the identity:
 2739:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2740:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2741: 
 2742:    printf("intGradPhiGradPhi: TEST\n");   
 2743: 
 2744:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2745: 
 2746:    const double x0 = nodes[0]->p.x;
 2747:    const double y0 = nodes[0]->p.y;
 2748:    const double x1 = nodes[1]->p.x;
 2749:    const double y1 = nodes[1]->p.y;
 2750:    const double x2 = nodes[2]->p.x;
 2751:    const double y2 = nodes[2]->p.y;
 2752:    const double x3 = nodes[3]->p.x;
 2753:    const double y3 = nodes[3]->p.y;
 2754: 
 2755:    double res = 0.0;
 2756:    
 2757:    // Quadrature points in xi and eta coordinates
 2758:    #pragma unroll
 2759:    for (int i = 0; i < 4; i++) {
 2760:       // For each quadrature point...
 2761: 
 2762:       const Point2 p = GaussPoint(i);
 2763:       const double eta = p.x;
 2764:       const double xi  = p.y;
 2765: 
 2766:       // Jacobian entries at the Gauss point p
 2767:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2768:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2769:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2770:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2771: 
 2772:       const double detJ = jacobianDet(p);
 2773:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2774: 
 2775:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2776:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2777:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2778:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2779:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2780: 
 2781:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2782:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2783:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2784:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2785:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2786: 
 2787:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2788:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2789:    }
 2790: 
 2791:    return res;
 2792: }
 2793: 
 2794: 
 2795: /**  Interpolate velocities at a given point (xt,yt,zt)
 2796: 
 2797:    @param xt, yt, zt: coordinates of the point to interpolate
 2798:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2799: 
 2800:    This is done in four steps:
 2801: 
 2802:    1. Find the shape coordinates for the final position in the element.
 2803:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2804:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2805:       z levels at xt, yt at each step.   
 2806:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2807:       horizontally and vertically.
 2808: **/
 2809: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 2810:    // Interpolate the velocities at the point xt. 
 2811:    // This function works the same for triangular and quadrilateral elements.
 2812:    double shpCoord[4];
 2813:    Vector3 u_int;
 2814: 
 2815:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa");
 2816: 
 2817:    // First step is to compute the shape coordinates of (xt,yt)
 2818: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 2819:    computeShapeCoords(toVector2(xt), shpCoord, fiOnlyInside, origSide);
 2820: 
 2821:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2822: 
 2823:    // Second step is to find the level that contains zt
 2824:    // Uses a binary search to find the level
 2825:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2826:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2827:    int R = nvrt - 1;
 2828: 
 2829:    // Get the z coordinates at the nodes of the element at the levels L and R
 2830:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 2831:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2832:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2833: 
 2834:    double zL = interpolate(shpCoord, zLAtNodes);
 2835:    double zR = interpolate(shpCoord, zRAtNodes);
 2836:    
 2837:    // Interpolates vertically the velocities
 2838:    double wght1, wght2;
 2839:    if (xt.z<=zL) {
 2840:       wght1 = 1.0;
 2841:       wght2 = 0.0;
 2842:       xt.z = zL;
 2843:    }
 2844:    else if (xt.z>=zR) {
 2845:       wght1 = 0.0;
 2846:       wght2 = 1.0;
 2847:       xt.z = zR;
 2848:    }
 2849:    else {
 2850:       // Perform a binary search to find the levels between L and R that contain xt.z
 2851:       while (R - L > 1) {
 2852:          int M = (L + R) / 2.0;
 2853: 
 2854:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2855:          double zM = interpolate(shpCoord, zMAtNodes);
 2856:          if (zM < xt.z) 
 2857:          {
 2858:             L = M;
 2859:             zL = zM;
 2860:          }
 2861:          else 
 2862:          {
 2863:             R = M;
 2864:             zR = zM;
 2865:          }
 2866:       }
 2867:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 2868:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2869: 
 2870:       wght2 = (xt.z - zL)/(zR - zL);
 2871:       wght1 = 1.0 - wght2;
 2872: 
 2873:    }
 2874: 
 2875: 
 2876:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2877:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 2878:    toVector2(u_int) = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 2879:    u_int.z          = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 2880: 
 2881:    // Neither of the interpolated velocities should be NaN
 2882:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2883: 
 2884:    return u_int;
 2885: 
 2886: }
 2887: 
 2888: 
 2889: 
 2890: 
 2891: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2892: 
 2893:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2894:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2895:    const Node *n1 = side->n1;
 2896:    const Node *n2 = side->n2;
 2897: 
 2898:    bool n1_match = (n1->nodeBnd->segment == segment);
 2899:    bool n2_match = (n2->nodeBnd->segment == segment);
 2900: 
 2901:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2902:    if (n1_match && n2_match) {
 2903:       return 0.5;
 2904:    } else if (n1_match) {
 2905:       return 1.0;
 2906:    } else if (n2_match) {
 2907:       return 0.0;
 2908:    }
 2909: 
 2910:    return 0.0;
 2911: }
 2912: 
 2913: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2914: 
 2915: 
 2916: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2917: 
 2918:    const double w1 = getBoundaryArrayValueWeight();
 2919:    const double w2 = 1.0 - w1;
 2920:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2921:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2922: 
 2923:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2924: }
 2925: 
 2926: 
 2927: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2928:    const double w1 = getBoundaryArrayValueWeight();
 2929:    const double w2 = 1.0 - w1;
 2930:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2931:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2932: 
 2933:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2934: 
 2935: }
 2936: 
 2937: 
 2938: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2939:    // Returns the value of the velocity at the side center
 2940:    const double w1 = getBoundaryArrayValueWeight();
 2941:    const double w2 = 1.0 - w1;
 2942:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2943:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2944: 
 2945:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2946: }
 2947: 
 2948: 
 2949: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2950:    // Returns the value of the normal component of the velocity at the side center
 2951:    const double w1 = getBoundaryArrayValueWeight();
 2952:    const double w2 = 1.0 - w1;
 2953:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2954:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2955: 
 2956:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2957: }
