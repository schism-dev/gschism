 1089: struct Side {
 1090: 
 1091:    // Geometry information
 1092:    int idx;               // Index of the side
 1093:    Node *n1, *n2;
 1094:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
 1095: 
 1096:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
 1097:    Vector2 center;        // Location of side center. 
 1098:    double zc[nvrt];       // Side center z-coord at each vertical level
 1099: 
 1100:    #ifdef USE_FRAMES
 1101:    Frame frame;
 1102:    #endif
 1103: 
 1104:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
 1105:                           // this is nullptr
 1106:    
 1107:    int kb;                // Bottom index of the side
 1108:    bool isDry;            // True if the side is dry
 1109:  
 1110:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1111: 
 1112:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1113: 
 1114:    // Physical information
 1115:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1116:    Vector2 btu[nvrt];           // Back-tracked velocity
 1117:    Vector2 U;                   // Vertically averaged velocity vector  
 1118: 
 1119:    Vector2 nuGradU[nvrt];          // nu*grad u
 1120: 
 1121:    Vector2 bcc[nvrt];           // Baroclinic term
 1122:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1123: 
 1124:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1125:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1126:    Vector2 gradPr;               // Gradient of pressure
 1127:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1128: 
 1129: 
 1130:    double hhat;                 // \breve{H} in notes
 1131: 
 1132:    double shapiro;
 1133: 
 1134:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1135: 
 1136:    double coriolis;             // Coriolis parameter
 1137: 
 1138:    // Vegetation parameters
 1139:    double veg_c2;
 1140:    double veg_beta;
 1141: 
 1142:    // Bottom drag parameters.
 1143:    double chi;
 1144:    double chi2;
 1145: 
 1146:    __inline__ __device__ Point2 outputCoords(void) const;
 1147: 
 1148:    __inline__ __device__ double x(double t) const;
 1149:    __inline__ __device__ double y(double t) const;
 1150:    __inline__ __device__ double z(double t) const;
 1151:    __inline__ __device__ double lon(void) const;
 1152:    __inline__ __device__ double lat(void) const;
 1153:    __inline__ __device__ Point2 p2_t(double t) const;
 1154: 
 1155:    #ifdef USE_FRAMES
 1156:    __device__ void setFrame(void) {
 1157:       double lat, lon;
 1158:       const Point3 p = toPoint3(center, centerZ());
 1159: 
 1160:       // Compute the latitude and longitude of the element center
 1161:       computeLatLon(p, lat, lon);
 1162: 
 1163:       frame.update(lat, lon);        
 1164:    }
 1165:    #endif
 1166: 
 1167:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1168:    // If ics == 2, convert the global point to the local frame of the side
 1169:       
 1170:       if constexpr (ics == 1) {
 1171:          return p;
 1172:       } else {
 1173:          const Point3 c = {center.x, center.y, centerZ()};
 1174:          const Point3 local = frame.G2L(p - c);
 1175:          return local;
 1176:       }
 1177:    }
 1178: 
 1179: 
 1180:    __device__ __forceinline__ Vector2 projectToLocalFrame(Vector2 const& v, Frame const& v_frame) const {
 1181:       if constexpr(ics == 1) return v;
 1182:       else return v_frame.projHorVec(v, frame);
 1183:    }
 1184: 
 1185:    __inline__ __device__ double centerZ(void)      const;
 1186:    __inline__ __device__ Point3 center3D(int k)    const { assert(false); assert(k < nvrt); return {center.x, center.y, zc[k]}; }  // USED??? CONSISTENT?? XXXXX
 1187:    __inline__ __device__ double Dz(int k)          const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1188:    __inline__ __device__ double area(int k)        const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1189:    __inline__ __device__ double areaClamped(int k) const { assert(k < nvrt - 1); return len*(zc[max(k + 1, kb)] - zc[max(k, kb)]); }
 1190: 
 1191:    __inline__ __device__ Side* neigh(int index) const { 
 1192:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1193:       assert(index >= 0 && index < 4); 
 1194:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1195: 
 1196:       const int ielem = index & 1;           // 0 or 1
 1197:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1198: 
 1199:       const Element* elem = elems[ielem];
 1200: 
 1201:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1202: 
 1203:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1204: 
 1205:    }
 1206: 
 1207:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1208: 
 1209:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1210: 
 1211:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1212:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1213:    __inline__ __device__ int iadv(void) const;
 1214: 
 1215:    __inline__ __device__ double grav3(void) const;
 1216:    
 1217:    __inline__ __device__ double eta2(void) const;
 1218:    __inline__ __device__ double eta1(void) const;
 1219:    __inline__ __device__ double w2(int k) const;
 1220:    __inline__ __device__ Vector2 u2Bottom(int dummy = 0) const { return u2[kb]; }  // XXXX dummy argument to satisfy the template in mean()
 1221:    __inline__ __device__ double depth(void) const;
 1222:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1223:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1224: 
 1225:    __inline__ __device__ double dfv(int k) const;
 1226: 
 1227:    __inline__ __device__ double veg_h(void)  const;
 1228:    __inline__ __device__ double veg_nv(void) const;
 1229:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1230:    __inline__ __device__ double veg_alpha3D(int k) const;
 1231:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1232: 
 1233:    __inline__ __device__ double Cd(void) const;
 1234: 
 1235:    __inline__ __device__ Vector2 tau(void) const;
 1236: 
 1237:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1238:    
 1239: 
 1240:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1241:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1242:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1243:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1244:    } 
 1245:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1246:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1247:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1248:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1249: 
 1250:    // Get valid starting element (for backtracking)
 1251:    __inline__ __device__ Element* getStartElement() {
 1252:       return elems[0] ? elems[0] : elems[1];
 1253:    }
 1254: 
 1255:    
 1256:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1257:       // Given an element, returns the other element that shares this side
 1258:       return (elems[0] == elem) ? elems[1] : elems[0];
 1259:    }
 1260: 
 1261:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1262:       // Given a node, returns the other node that shares this side
 1263:       return (n1 == node) ? n2 : n1;
 1264:    }
 1265:  
 1266:    __inline__ __device__ void btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1267: 
 1268: 
 1269: 
 1270: 
 1271: };
