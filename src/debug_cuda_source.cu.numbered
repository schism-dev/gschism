 9841: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 9842:    Element *elems = mesh->localElemData;
 9843: 
 9844:    *addr = elems;
 9845:    *sizeElement = sizeof(Element);
 9846:    switch (varCode) {
 9847:       case (int)VarCode::z:
 9848:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 9849:          *sizeType = sizeof(double);
 9850:          break;
 9851:       case (int)VarCode::x:
 9852:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 9853:          *sizeType = sizeof(Vector2);
 9854:          break;
 9855:       case (int)VarCode::gradETP:
 9856:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
 9857:          *sizeType = sizeof(Vector2);
 9858:          break;
 9859:       case (int)VarCode::area:
 9860:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 9861:          *sizeType = sizeof(double);
 9862:          break;
 9863:       case (int)VarCode::depth:
 9864:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 9865:          *sizeType = sizeof(double);
 9866:          break;
 9867:       case (int)VarCode::radius:
 9868:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 9869:          *sizeType = sizeof(double);
 9870:          break;
 9871:       case (int)VarCode::ghat:
 9872:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 9873:          *sizeType = sizeof(Vector2);
 9874:          break;
 9875:       case (int)VarCode::kb:
 9876:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 9877:          *sizeType = sizeof(int);
 9878:          break;
 9879:       case (int)VarCode::isdry:
 9880:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 9881:          *sizeType = sizeof(int);
 9882:          break;            
 9883:       case (int)VarCode::w:
 9884:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 9885:          *sizeType = sizeof(double);
 9886:          break;
 9887:       case (int)VarCode::FaceIndices:
 9888:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 9889:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 9890:          *sizeType = sizeof(Node);
 9891:          break;
 9892:       default:
 9893:          *offset = -1;
 9894:    }
 9895: }
