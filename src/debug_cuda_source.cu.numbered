 1979: __device__ inline void atomicAddInt16Unsafe(int16_t* address, int16_t val)
 1980: {
 1981:     uintptr_t p = (uintptr_t)address;
 1982:     assert((p & 1) == 0);
 1983: 
 1984:     unsigned int* base = (unsigned int*)(p & ~3);
 1985:     unsigned int addend = (p & 2) ? ((unsigned int)val << 16)
 1986:                                   :  (unsigned int)val;
 1987: 
 1988:     atomicAdd(base, addend);
 1989: }
 1990: 
 1991: Polynomial<4> *polyDischarge; // XXX read from file
 1992: 
 1993: 
 1994: //===============================================================================
 1995: 
 1996: 
 1997: /**
 1998:  * Find the element that contains the target point.
 1999:  * 
 2000:  * @param x0,y0,z0     Starting position coordinates
 2001:  * @param xt,yt,zt     Target position coordinates
 2002:  * @param dtb          Time step for tracking
 2003:  * @param u_int        Initial velocity components
 2004:  * @param nextElem     Starting/resulting element index
 2005:  * 
 2006:  * @return Status code of type trackExitCodes
 2007:  * 
 2008:  * Uses the Leaded Celestial Walk algorithm to find the element that contains the target point.
 2009:  * This is a variant of the Celestial Walk algorithm that goes from element A containing the starting 
 2010:  * point x0 (in one side) to element B containing the target point xt. To enforce that the next element is
 2011:  * as close the the segment AB as possible, the next point at each iteration is computed
 2012:  * along segment AB, but just after the current element.
 2013:  */
 2014: 
 2015: 
 2016: __device__ __forceinline__ bool celestialWalk(Element *&curElem, Point3 x0, Point3 &xt, const Side *origSide, Side *&lastCrossSide, int jlev) {
 2017: 
 2018:    constexpr int MAX_ITERATIONS = 40;
 2019: 
 2020:    int iter = 0;
 2021:    double fac = 0.00001;
 2022:    while (iter < MAX_ITERATIONS) {
 2023:       iter++;
 2024: 
 2025:       Bool4 isLeft, isObtuse, isBisector;
 2026:       curElem->computePredicates(toPoint2(x0), toPoint2(xt), fac, origSide, isLeft, isObtuse, isBisector, jlev);
 2027: // showPoints(x0, xt, jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2028:       Bool4 isValid = !isLeft & (!isObtuse | isBisector); // bitwise operation are overloaded
 2029: 
 2030: 
 2031:       if (isValid.none()) 
 2032:       // Inside the element if none of the edges is a valid continuation
 2033:       {
 2034:          // Just returns true and the element (curElem) is unchanged).
 2035:          // This means that the algorithm has found the element that contains the target point.
 2036:          return true;
 2037:       }
 2038:       else { // Outside the element
 2039: 
 2040:          // Outside this element. Pick the first valid exit side and cross.
 2041:          lastCrossSide = curElem->sides[isValid.firstOne()];
 2042:          Element *prevElem = curElem;
 2043:          curElem = lastCrossSide->otherElem(curElem);
 2044: 
 2045:          // If it crosses into a dry element or a boundary element, return false. This means that the track will now move 
 2046:          // along the boundary.
 2047:          if (curElem == nullptr || curElem->isDry) {
 2048:          
 2049:             curElem = prevElem;
 2050:             return false;
 2051:          }
 2052:          
 2053:       }
 2054: 
 2055:    }
 2056: 
 2057:   assert(false && "Leaded Celestial Walk: exceeded max iterations");
 2058: }
 2059: 
 2060: 
 2061: 
 2062: //===============================================================================
 2063: 
 2064: __device__ void lock(int *mutex) {
 2065:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 2066: }
 2067: 
 2068: __device__ void unlock(int *mutex) {
 2069:     atomicExch(mutex, 0);
 2070: }
 2071: 
 2072: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2073: // return;   
 2074:    // Lock the mutex
 2075:    lock(&debugPlotMutex);
 2076:  
 2077:    bool ok = true;
 2078:    if (debugPlotIdx == nullptr) ok = false;
 2079:    if (*debugPlotIdx >= 1000000) ok = false;
 2080:    if (ok) {
 2081:       debugPlot[(*debugPlotIdx) + 0*1000000] = x1.x;
 2082:       debugPlot[(*debugPlotIdx) + 1*1000000] = x1.y;
 2083:       debugPlot[(*debugPlotIdx) + 2*1000000] = x2.x;
 2084:       debugPlot[(*debugPlotIdx) + 3*1000000] = x2.y;
 2085:       debugPlot[(*debugPlotIdx) + 4*1000000] = (double)color;
 2086:       debugPlot[(*debugPlotIdx) + 5*1000000] = (double)(((int)(unsigned char)marker & 0xFF) | ((dashLen & 0xFF) << 8) | ((width & 0xFF) << 16));
 2087:       debugPlot[(*debugPlotIdx) + 6*1000000] = (double)label;
 2088:       (*debugPlotIdx)++;
 2089:    }
 2090: 
 2091:    __threadfence();               // ensure all above writes are visible
 2092:    // Unlock the mutex
 2093:    unlock(&debugPlotMutex);
 2094: 
 2095: }
 2096: 
 2097: __device__ void addDebugPlot(Vector2 x1, Vector2 x2, unsigned int color = 0xA0A0A0, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2098:    addDebugPlot(toPoint3(x1, 0.0), toPoint3(x2, 0.0), color, marker, width, dashLen, label);
 2099: }
