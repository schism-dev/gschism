 3355: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3356:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3357:    if constexpr(ics == 1) { 
 3358:       return 0.5*(n1->tau + n2->tau);
 3359: 
 3360:    } else {
 3361:       // Project the tau from the node frames to the side frame
 3362:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3363:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3364: 
 3365:       return 0.5*(stau1 + stau2);
 3366:    }
 3367: }
 3368: 
 3369: /**
 3370:  * This method performs backtracking from the side center until a time -dt back in time 
 3371:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3372:  * intermediate point.
 3373:  *
 3374:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3375:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3376:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3377:  * remaining time.
 3378:  * 
 3379:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3380:  * 
 3381:  * @param uuint, vvint, wwint: Velocities at the final point
 3382:  * @param jlev: Level at which the backtracking is performed
 3383:  * @param dt, dtbk: Tracking timesteps
 3384:   */
 3385: __inline__ __device__ void Side::btrack(
 3386:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3387:       double dt,            // Tracking time
 3388:       double dtbk,          // Tracking timestep
 3389:       Vector3 &u_int        // Velocities at the initial point
 3390: ) const {
 3391: 
 3392:    // Start from side center
 3393:    Point3 x0;
 3394: 
 3395:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3396:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3397: 
 3398:  
 3399:    double time_rm = dt; // Remaining time
 3400:    double time_rm_1 = 1e10;
 3401:    double time_rm_2 = 2e10;
 3402:    double time_rm_3 = 3e10;
 3403: 
 3404: 
 3405:    // Initial velocities
 3406:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3407: 
 3408:    // Find a non dry element for starting the backtracking. At this point there should be at least one.
 3409:    Element* curElem = (!elems[0]->isDry) ? elems[0] : elems[1];  // elems[0] is always non-null 
 3410: 
 3411:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3412: 
 3413: // showPoints(x0, x0, jlev, this, 0xFF0000u, 'x', 1, 0, 0);
 3414: 
 3415: 
 3416:    constexpr int MAX_ITERATIONS = 100; 
 3417:    int iter = 0;
 3418:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3419:    while(true) {
 3420: 
 3421:       // Calculate timestep
 3422:       const double dtb = min(dtbk, time_rm);
 3423: 
 3424:       // Next point in the backtracking curve
 3425:       xt = x0 - dtb*u_int;
 3426: 
 3427:       double t, s; // parameters for the line segments p0pt and p1p2
 3428:       Side *lastCrossSide = nullptr;
 3429:       const bool found = celestialWalk(curElem, x0, xt, this, lastCrossSide, jlev);
 3430: 
 3431: 
 3432:       if (time_rm_3 <= time_rm) {
 3433:       // If backtracking gets stuck, we stop the backtracking and use the velocity at the last x0.
 3434:          xt = x0;
 3435:          break;
 3436:       }
 3437: 
 3438: 
 3439:       if (!found) {
 3440:       // This means that the walk reached a boundary or a dry element.
 3441: 
 3442:          assert(lastCrossSide!=nullptr && "lastCrossSide is nullptr");
 3443: 
 3444:          // Finds the point at the boundary where the line segment x0xt intersects.
 3445:          // Here we will assume that it does intersect the boundary segment, even if in some cases,
 3446:          // due to floating point errors, it does not exactly intersect.
 3447:          // We call p1 and p2 the 2D points of the boundary segment. p0, pt are the 2D versions of x0 and xt.
 3448:          // v1 is the vector from p0 to pt, v2 is the vector from p1 to p2.
 3449:          // To compute the intersection point we start with the parametric equations.
 3450:          // p1 + t*v2 = p0 + s*v1,    t, s in [0,1]
 3451:          // We cross-prouct by v1 to cancel the s term:
 3452:          // cross(v2, v1)*t = cross(p0 - p1, v1)
 3453:          // t = cross(p0 - p1, v1) / cross(v2, v1)
 3454: 
 3455:          // Side coordinates in the origSide frame.
 3456:          const Point2 p1 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n1->p, lastCrossSide->n1->gz)));
 3457:          const Point2 p2 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n2->p, lastCrossSide->n2->gz)));
 3458: 
 3459:          Point2  p0 = {x0.x, x0.y};
 3460:          Point2  pt = {xt.x, xt.y};
 3461: 
 3462:          const Vector2 v1 = pt - p0;
 3463:          const Vector2 v2 = p2 - p1;
 3464: 
 3465: 
 3466: 
 3467:          // We are assuming intersection, so we clamp t to the range [0,1].
 3468:          const double denom = cross(v2, v1);
 3469:          
 3470: 
 3471: 
 3472: 
 3473:          if (abs(denom) < small) {
 3474:             // small denominators are fairly common. They occur when the line segment x0xt 
 3475:             // is parallel to the boundary segment. This occurs after a "collision" with the
 3476:             // boundary, where the backtracking curve startt sliding along the boundary.
 3477:             // In this case, we simply assume that the two lines are very close to each other
 3478:             // and simply compute the closest point to xt (s = 1.0) on the boundary segment (clamped to p1p2)
 3479:             t = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3480:             if (t<0.0000000001) t = 0.0;
 3481:             if (t>0.9999999999) t = 1.0;
 3482: 
 3483:             // s = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3484:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3485: 
 3486:          }
 3487:          else {
 3488:             
 3489:             t = clamp(cross(p0 - p1, v1) / denom, 0.0, 1.0);
 3490:             if (t<0.0000000001) t = 0.0; // XXXXX use constants
 3491:             if (t>0.9999999999) t = 1.0;
 3492:             // From the originaL equation we can solve for s:
 3493:             // p1 + t*v2 = p0 + s*v1    =>   s*v1 = p1 + t*v2 - p0 
 3494:             // Computing the dot product by v1, we get:
 3495:             // s = dot((p1 + t*v2 - p0), v1) / dot(v1, v1)
 3496:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3497:             if (s<0.0000000001) s = 0.0; // XXXXX use constants
 3498: 
 3499:          }
 3500: 
 3501:          assert(curElem!=nullptr && !curElem->isDry && "curElem is nullptr or dry");
 3502: 
 3503: 
 3504:          // We update the new target point to be right at the intersection point,
 3505:          // and the remaining time must include the time we haven't "used".
 3506:          time_rm -= s*dtb;
 3507:          xt = toPoint3(p1 + t*v2, x0.z + s*(xt.z - x0.z)); // I use p1,p2 to compute the intersection point to ensure that it is on the boundary, but the z-coordinate is the same as x0.z
 3508: 
 3509: 
 3510:          // If it is an open boundary, just exits the loop. No sliding along the boundary is performed.
 3511:          if (lastCrossSide->sideBnd!=nullptr && !lastCrossSide->sideBnd->segment->isLand) break;
 3512: 
 3513:          // If it is not an open boundary, the velocity for the next step is computed by interpolating the velocities at the intersection point.
 3514:          // but extracting only the component along the tangent vector v2.
 3515:          Vector2 tangent = normalize(v2);
 3516:          const Vector3 u = curElem->interpolateVelocities(xt, this);
 3517: 
 3518:          const Vector2 u2D = make_double2(u.x, u.y);
 3519:          u_int = toVector3(dot(u2D, tangent)*tangent, u.z);
 3520: 
 3521: 
 3522:       } else {
 3523: 
 3524:          assert(curElem!=nullptr && !curElem->isDry && "Final element is dry or boundary side");
 3525: 
 3526:          time_rm -= dtb; 
 3527: 
 3528:          u_int = curElem->interpolateVelocities(xt, this);
 3529: 
 3530:       }
 3531: 
 3532:       if (time_rm <= 0.0) break; 
 3533: 
 3534:       // If the velocity is too small, we stop the backtracking
 3535:       const double vmag2 = norm2(toVector2(u_int));
 3536:       if (vmag2 <= velmin_btrack_sq)  {
 3537:          time_rm = 0.0; 
 3538:          return; 
 3539:       }
 3540: 
 3541:       // The current point becomes the next segment's starting point.
 3542:       x0 = xt;
 3543:  
 3544:       iter++;
 3545: 
 3546: // XXXXXXXXXXXXXXXXX
 3547: if (iter == 38) {printf("*****iter = %d, time_rm = %.17f\n", iter, time_rm); return;}
 3548:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3549: 
 3550:       assert(time_rm_3 > time_rm && "time_rm is not decreasing");
 3551:       time_rm_3 = time_rm_2;
 3552:       time_rm_2 = time_rm_1;
 3553:       time_rm_1 = time_rm;
 3554:    }
 3555: 
 3556:    assert(curElem != nullptr && "Final element is nullptr");
 3557:    assert(!curElem->isDry && "Final element is dry");
 3558:    
 3559: 
 3560: 
 3561:    // Interpolate the velocities at the final point with respect to the current side frame
 3562:    u_int = curElem->interpolateVelocities(xt, this);
 3563: 
 3564: 
 3565: }
 3566: 
