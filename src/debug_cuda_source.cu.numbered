 3868: 
 3869: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3870: 
 3871: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3872: 
 3873:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3874:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3875: 
 3876:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3877:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3878: 
 3879:    double fun_lat = 0.0;
 3880:    switch (jspc[idxComp]) {
 3881:       case 0:
 3882:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3883:          break;
 3884:       case 1:
 3885:          fun_lat = sin(2.0*lat);
 3886:          break;
 3887:       case 2:
 3888:          fun_lat = pow<2>(cos(lat));
 3889:          break;
 3890:       default:
 3891:          assert(false && "computeETP: invalid jspc");
 3892:    }
 3893:    
 3894:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3895: 
 3896: }
 3897: 
 3898: __device__ void Node::updateKb(void) {
 3899: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3900: 
 3901:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3902: 
 3903: 
 3904:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3905: 
 3906:    if constexpr(ivcor == 2) {  // SZ coordinates
 3907:       
 3908:       // Compute bottom level index
 3909:       if (depth <= mesh->h_s) {
 3910:          kb = izlev;   
 3911:          
 3912:       } else {
 3913:          kb = -1;
 3914:          int L = 0;
 3915:          int R = nzlev; 
 3916:          
 3917:          while (L <= R) {
 3918:             int M = (R + L) / 2;
 3919: 
 3920: 
 3921:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3922:             
 3923:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3924:                R = M;
 3925:             } else {
 3926:                L = M;
 3927:             }
 3928: 
 3929:             if (R - L == 1) {
 3930:                kb = L;
 3931:                break;
 3932:             }
 3933:          }
 3934: 
 3935:          // Checks that the binary search was successful
 3936:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3937:        
 3938:       }
 3939:    } 
 3940: }
 3941: 
