 2252:    template<typename T>
 2253:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 2254:       T values[4];
 2255:       getNodalValues(level, func, values);
 2256: 
 2257:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2258:       if constexpr (IsVector2<T>::value && ics == 2) {
 2259: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2260:          projectNodeVectorsToElementFrame(values);
 2261: printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2262:       }
 2263: 
 2264:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2265:    }
 2266: 
 2267:    template<typename T>
 2268:    __device__ __forceinline__ T Element::interpolate(const double shapeCoords[4], T Node::* field) const {
 2269:       T values[4];
 2270:       getNodalValues(field, values);
 2271: 
 2272:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2273:       if constexpr (IsVector2<T>::value && ics == 2) {
 2274: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2275:          projectNodeVectorsToElementFrame(values);
 2276: printf("interpolate 3: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2277:       }
 2278:       
 2279:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2280:    }
 2281: 
 2282: 
 2283:    template<typename T>
 2284:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
 2285:       T values[4];
 2286:       getNodalValues(level, field, values);
 2287:       
 2288: if (shapeCoords[0] > 1.1 || shapeCoords[1] > 1.1 || shapeCoords[2] > 1.1 || 
 2289:     shapeCoords[0] < -0.1 || shapeCoords[1] < -0.1 || shapeCoords[2] < -0.1) printf("XXX shapeCoords = (%.17f, %.17f, %.17f, %.17f)\n", shapeCoords[0], shapeCoords[1], shapeCoords[2], shapeCoords[3]);
 2290:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2291:       if constexpr (IsVector2<T>::value && ics == 2) {
 2292: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2293:          projectNodeVectorsToElementFrame(values);
 2294: // printf("interpolate 4: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2295:       }
 2296: 
 2297:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2298:    }
 2299: 
 2300:    template<typename T>
 2301:    __device__ __forceinline__ T Element::mean(T Node::* field) const {
 2302:       T values[4];
 2303:       getNodalValues(field, values);
 2304: 
 2305:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2306:       if constexpr (IsVector2<T>::value && ics == 2) {
 2307: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2308:          projectNodeVectorsToElementFrame(values);
 2309: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2310:       }
 2311: 
 2312:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2313:    }
 2314: 
 2315:    template<typename T>
 2316:    __device__ __forceinline__ T Element::mean(T Side::* field) const {
 2317:       T values[4];
 2318:       getSideValues(field, values);
 2319:       
 2320:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2321:       if constexpr (IsVector2<T>::value && ics == 2) {
 2322: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2323:          projectSideVectorsToElementFrame(values);
 2324: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2325:       }
 2326: 
 2327:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2328:    }   
 2329: 
 2330:    template<typename T>
 2331:    __device__ __forceinline__ T Element::mean(int level,  T (Side::*func)(int) const) const {
 2332: 
 2333:       T values[4];
 2334: 
 2335: 
 2336:       values[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2337:       values[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2338:       values[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2339:       if (isQuad()) values[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2340:       else          values[3] = T();
 2341: 
 2342:       if constexpr (IsVector2<T>::value && ics == 2) projectSideVectorsToElementFrame(values);
 2343: 
 2344:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2345:    }
