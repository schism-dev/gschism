 8189: __global__ void printMatrix(bool full) {
 8190:    // Debugging: print the matrix
 8191: 
 8192:    const int size = mesh->np;
 8193:    double sum = 0.0;
 8194:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8195:       const Node *node = mesh->localNodeData + idx_node;
 8196:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 8197:       for (int j = 0; j < node->numNodes; j++) {
 8198:          Node* nbNode = node->nodes[j];
 8199:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 8200:          sum += node->coeffMatrix[j];
 8201:       }
 8202:       if (full) printf("]\n");
 8203: 
 8204: 
 8205:    }
 8206:    if (!full) printf("sum=%lf\n", sum);
 8207: }
