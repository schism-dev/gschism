 8476:          *sizeType = sizeof(int);
 8477:          break;            
 8478:       // case (int)VarCode::w:
 8479:       //    *offset = (int)((char*)&sides[0].w2 - (char*)sides);
 8480:       //    *sizeType = sizeof(double);
 8481:       //    break;
 8482:       case (int)VarCode::u:
