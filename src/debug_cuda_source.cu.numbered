 7729: __global__ void returnB(double *res) {
 7730:    // Debugging: returns the matrix as a CuPy array
 7731: 
 7732:    const int size = mesh->np;
 7733:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7734:       const Node *node = mesh->localNodeData + idx_node;
 7735: 
 7736:       res[idx_node] = node->qel;
 7737: 
 7738:    }
 7739:    
 7740: }
