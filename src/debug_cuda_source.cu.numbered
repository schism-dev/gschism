 1218: struct Node {
 1219: 
 1220:    // Geometry information
 1221:    int idx;        // Index of the node
 1222:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1223:    int numNodes;   // Number of nodes neighbors of this node
 1224: 
 1225:    Element **elements; // Array of pointers to the elements that share this node
 1226:    int numElements;    // Number of elements that share this node
 1227: 
 1228:    int numSides;       // Number of sides that are connected to this node
 1229: 
 1230:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1231:    double gz;          // Global vertical coordinate at the node.
 1232:    Vector2 u2[nvrt];
 1233:    double  w2[nvrt];
 1234:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1235:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1236:    double lon, lat;
 1237:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1238:    double depth;
 1239: 
 1240: #ifdef USE_FRAMES
 1241:    Frame frame;
 1242: #endif
 1243: 
 1244: #ifdef USE_LOCALIZED_SIGMA   
 1245:    double localSigma[nvrt];
 1246: #endif
 1247: 
 1248:    int kb;       // Bottom index of the node
 1249: 
 1250:    bool isDry;     // True if the node is dry
 1251: 
 1252:    int iadv;     // Advection flag
 1253: 
 1254:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1255:                           // this is nullptr
 1256: 
 1257:    TempVar tmp; // Temporary variable to store different types of variables
 1258: 
 1259:    // Physical information
 1260:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1261:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1262: 
 1263:    double rho[nvrt];     // Density
 1264:    double dfv[nvrt];     // Vertical viscosity
 1265: 
 1266:    double eta1; // Elevation at nodes at previous timestep
 1267:    double eta2; // Elevation at nodes at current timestep
 1268: 
 1269:    double ETP;  // Earth Tidal Potential
 1270: 
 1271:    double pr;    // Air pressure
 1272:    double grav2; // Gravity 
 1273:    
 1274:    Vector2 dav;  // Depth averaged velocity
 1275: 
 1276:    Vector2 tau; // Wind stress vector
 1277: 
 1278:    // Vegetation parameters
 1279:    double veg_h;
 1280:    double veg_nv;
 1281:    double veg_di;
 1282:    double veg_Cd;
 1283:    double veg_h_unbent;
 1284:    double veg_di_unbent;
 1285:    double veg_nv_unbent;
 1286:    double veg_alpha_vert_mean;
 1287:    double veg_alpha0;
 1288:    double veg_alpha3D[nvrt];
 1289: 
 1290:    // Bottom drag parameters
 1291:    double Cd;       // Bottom drag coefficient   
 1292: 
 1293:    // These three are mutually exclusive
 1294:    union {
 1295:       double rmanning; // Bottom Manning's coefficient
 1296:       double rough;    // Bottom roughness length
 1297:       double drag;     // Bottom drag coefficient
 1298:    };
 1299:    Vector2 tau_bot; // Bottom stress vector
 1300: 
 1301:    double bdef1; // Bottom deformation at previous timestep
 1302:    double bdef2; // Bottom deformation at current timestep
 1303: 
 1304:    double qel; // RHS
 1305:    double coeffDiag; // Diagonal coefficient of the matrix
 1306:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1307: 
 1308:    double mP; // Search direction for conjugate gradient method
 1309:    double mR; // Residual for conjugate gradient method
 1310:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1311:    double mX; // Solution for conjugate gradient method
 1312: 
 1313:    // Meteorological forcing
 1314:    Vector2 u_air;
 1315:    double p_air;  // XXXX is this the same as pr?
 1316:    double t_air;
 1317:    double q_air;
 1318:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1319: 
 1320:    __device__ void setWind(Vector2 &u) {
 1321:    // Sets the wind vector taking into account the mesh angle
 1322:    
 1323:       const double speed = length(u);
 1324: 
 1325:       // Rotate wind vector to the node frame
 1326:       const Vector2 u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1327: 
 1328:       // Sets the surface stress vector due to wind.
 1329:       if constexpr(nws == 0) {
 1330:          tau = {0.0, 0.0};
 1331: 
 1332:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1333:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1334: 
 1335:       } else {
 1336: 
 1337:          double dragcoef;
 1338: 
 1339:          if constexpr(iwind_form == -1) {
 1340:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1341:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1342: 
 1343:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1344:             tau = cff*u_air;
 1345:  
 1346:          } else if constexpr(iwind_form == 1) {
 1347:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1348:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1349: 
 1350:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1351:             tau = cff*u_air;
 1352: 
 1353:          } else {
 1354:             tau = {0.0, 0.0};
 1355:          }
 1356:       }
 1357:    }
 1358: 
 1359: 
 1360:    __device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1361: 
 1362:    // 3D local coordinates at the node. If ics == 1, p coordinates are already projected. If ics == 2, p coordinates are the x,y coordinates of the 3D global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.
 1363:    __device__ Point3 localP3D(void) const { if constexpr(ics==1) { return {p.x, p.y, 0.0}; } else { return frame.G2L(toVector3(p, gz)); } }  
 1364: 
 1365:    __device__ double sigmaTransitionDepth(void) const;
 1366: 
 1367:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1368:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1369:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1370:    
 1371:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1372: 
 1373:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1374: 
 1375:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1376:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1377: 
 1378:    __device__ __forceinline__ void clearMatrixRow(void) {
 1379:       // Clear the matrix row for this node
 1380: 
 1381: 
 1382:       coeffDiag = 0.0;
 1383: 
 1384:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1385: 
 1386:    }
 1387: 
 1388:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1389:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1390:       
 1391:       if (node == this) {
 1392:          coeffDiag += value;
 1393:      
 1394:       } else {
 1395:          // Search (linearly)the index of the node in the array of nodes
 1396:          // XXX: This is not efficient, see if we can improve this
 1397:          int i;
 1398:          for (i = 0; i < numNodes; i++) {
 1399:             if (nodes[i] == node) {
 1400:                break;
 1401:             }
 1402:          }
 1403:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1404:          coeffMatrix[i] += value;
 1405:       }
 1406:    }
 1407: 
 1408: 
 1409:    __device__ __inline__ void updateZCoordData(void);
 1410: 
 1411:    __device__ double compZCoord(int k) const;
 1412: 
 1413:    __device__ void updateKb(void);
 1414: 
 1415:    __device__ __forceinline__ void computeBottomDragCd(void);
 1416: 
 1417: 
 1418: 
 1419: };
