 4192:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4193: 
 4194:       NODE_BND(nodeBnd);
 4195: 
 4196:       Node *node = nodeBnd->node;
 4197: 
 4198:       node->ETP = 0.0;
 4199: 
 4200:       for (int j=0; j<ntip; j++) {
 4201: 
 4202:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4203:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4204:    
 4205:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4206: 
 4207:          if constexpr(iloadtide==1) { // loading tide
 4208:             assert(false && "Loading tide not implemented");
 4209:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4210:          }
 4211:          
 4212:       }
 4213:       
 4214:    }
