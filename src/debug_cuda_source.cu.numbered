 8174: #ifdef OLD_PCG_SOLVER
 8175: __global__ void computeMatrixProductAndDotProducts() {
 8176:    // Computes A*p, r'Mr and p'Ap
 8177: 
 8178:    // 1) shared buffer: first half for rMr, second for pAp
 8179:    __shared__ double sdata[2*BLOCK_SIZE];
 8180:    double* s_rMr = sdata;
 8181:    double* s_pAp = sdata + BLOCK_SIZE;
 8182: 
 8183:    const int tid = threadIdx.x;
 8184: 
 8185:    double l_pAp = 0.0;
 8186: 
 8187:    s_rMr[tid] = 0.0;
 8188:    s_pAp[tid] = 0.0;
 8189: 
 8190:    // 2) get your node pointer
 8191:    // NODE(node);   
 8192:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 8193:    Node *node = &(mesh->localNodeData[idx_node]); 
 8194:       if (idx_node < mesh->np) {
 8195: 
 8196:       const double diag = node->coeffDiag;
 8197:       const double r    = node->mR;
 8198:       const double p    = node->mP;  
 8199: 
 8200:       // apply preconditioner on the fly:
 8201:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 8202: 
 8203:       // 4) compute Ap = A.p
 8204:       double Ap = node->coeffDiag * node->mP;
 8205:       for (int j = 0; j < node->numNodes; ++j) {
 8206:          const Node *nbNode = node->nodes[j];
 8207:          Ap += node->coeffMatrix[j] * nbNode->mP;
 8208: 
 8209:       }
 8210: 
 8211:       node->mAp = Ap;
 8212:       
 8213: 
 8214:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 8215:       // const double l_rMr = r*Mr;  // r'Mr
 8216:       l_pAp = p*Ap;  // p'Ap
 8217: 
 8218: 
 8219:    }
 8220: 
 8221:    // 6) write into shared mem
 8222:    // s_rMr[tid] = l_rMr;
 8223:    s_pAp[tid] = l_pAp;
 8224: 
 8225:    __syncthreads();
 8226: 
 8227:    // 7) block-wide tree reduction
 8228:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8229:       if (tid < stride)  {
 8230:          s_pAp[tid] += s_pAp[tid + stride];
 8231:       }
 8232:       __syncthreads();
 8233:    }
 8234: 
 8235:    // 8) thread 0 atomically accumulates into the globals
 8236:    // XXX: This is slower than it needs to be, but it is simple and works
 8237:    if (tid == 0) {
 8238:       atomicAdd(pAp, s_pAp[0]);
 8239:    }
 8240: 
 8241: 
 8242: }
 8243: 
 8244: 
 8245: __global__ void updateSolutionAndDotProducts(void) {
 8246:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 8247: 
 8248:    const int tid = threadIdx.x;
 8249: 
 8250:    s_rMr[tid] = 0.0;
 8251: 
 8252:    // get node & bounds-check:
 8253:    NODE(node);
 8254: 
 8255:    
 8256:    // Compute alpha
 8257:    const double alpha = (*rMr_old)/(*pAp); 
 8258: 
 8259: 
 8260:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 8261: 
 8262: 
 8263:    // load scalars
 8264:    const double diag = node->coeffDiag;
 8265:    const double p    = node->mP;
 8266:    const double Ap   = node->mAp;
 8267:    const double x    = node->mX;
 8268:    const double r    = node->mR;
 8269:    
 8270:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 8271: 
 8272:    // 1) update solution & residual
 8273:    const double x_new = x + alpha*p;
 8274:    const double r_new = r - alpha*Ap;
 8275:    node->mX = x_new;
 8276:    node->mR = r_new;
 8277: 
 8278:    // 2) apply Jacobi preconditioner on the fly
 8279:    const double Mr_new = r_new/diag;
 8280: 
 8281: 
 8282:    // 3) local contributions for the two dot-products
 8283:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 8284: 
 8285:    // 4) write into shared-mem
 8286:    s_rMr[tid] = l_rMr;
 8287: 
 8288:    __syncthreads();
 8289: 
 8290: 
 8291:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8292:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8293:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8294:       __syncthreads();
 8295:    }
 8296: 
 8297:    // 6) thread 0 atomically folds into the global accumulators
 8298:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 8299: 
 8300: 
 8301: }
 8302: 
 8303: 
 8304: __global__ void updateSearchDirection() {
 8305: 
 8306:     NODE(node);
 8307: 
 8308:     // recompute z on-the-fly
 8309:     const double z = node->mR / node->coeffDiag;
 8310:     const double p = node->mP;
 8311: 
 8312:     const double beta = (*rMr_new)/(*rMr_old);
 8313: 
 8314: 
 8315:     // p =z + beta*p
 8316:     node->mP = z + beta*p;
 8317: 
 8318: }
 8319: 
 8320: __global__ void initializeScalars(double *scalars) {
 8321: 
 8322:    // These point to a cupy array in the host code
 8323:    rMr_old = scalars + 0;
 8324:    rMr_new = scalars + 1;
 8325:    pAp     = scalars + 2;
 8326: }
 8327: 
 8328: __global__ void initializePreconditionedResidual(void) {
 8329: 
 8330:     __shared__ double s_rMr[BLOCK_SIZE];  
 8331: 
 8332:     s_rMr[threadIdx.x] = 0.0;
 8333: 
 8334:     NODE_ALL(node, valid);
 8335:     const int tid = threadIdx.x;
 8336:     // For the first iteration:
 8337:     // 1. Initial solution x = 0 (already set)
 8338:     // 2. Initial residual r = b (stored in qel)
 8339:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 8340: 
 8341: // XXX we should use the guess solution here    
 8342: 
 8343:     double l_rMr = 0.0;
 8344:     if (valid) {
 8345:       // Set initial residual r = b (from qel)
 8346:       node->mR = node->qel;
 8347: 
 8348:       // Compute z = M^-1 * r (preconditioned residual)
 8349:       const double z = node->mR / node->coeffDiag;
 8350: 
 8351:       // Set initial search direction p = z
 8352:       node->mP = z;
 8353: 
 8354:       // Initialize other variables needed for CG
 8355:       node->mX = 0.0;  // Initial solution
 8356:       node->mAp = 0.0; // Will be computed in first iteration
 8357: 
 8358: 
 8359:       // Computes the first r'Mr (reduction)
 8360:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 8361:     }
 8362:     // 4) write into shared-mem
 8363:     s_rMr[tid] = l_rMr;
 8364: 
 8365:     __syncthreads();
 8366: 
 8367: 
 8368:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8369:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8370:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8371:         __syncthreads();
 8372:     }
 8373: 
 8374:     // 6) thread 0 atomically folds into the global accumulators
 8375:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 8376: 
 8377:     *rMr_old = 0.0;
 8378:     *pAp = 0.0;
 8379: }
 8380: #endif
 8381: 
 8382: extern "C" __global__ void getElementVarFunc(int varCode, double *res) {
 8383: 
 8384:    ELEM(elem);
 8385: 
 8386:    switch (varCode) {
 8387:       case (int)VarCode::outputCoords:
 8388:          const Point2 coords = elem->outputCoords();
 8389:          res[elem->idx*2    ] = coords.x;
 8390:          res[elem->idx*2 + 1] = coords.y;
 8391:          break;
 8392:    }
 8393: }
