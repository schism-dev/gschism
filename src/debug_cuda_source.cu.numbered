 3897: __device__ __inline__ void Node::updateZCoordData(void) {
 3898: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3899: 
 3900:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3901:    // if (isDry2()) {
 3902:    //    kb = -1;  // XXXXXXXX KKKKK
 3903:    //    return;
 3904:    // }
 3905: 
 3906: 
 3907:    if constexpr(ivcor == 2) {  // SZ coordinates
 3908:       
 3909:       // Compute bottom level index
 3910:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3911:    } 
 3912:    else {  // if (ivcor == 1) Localized sigma
 3913:       // Do nothing
 3914:    }
 3915: 
 3916: 
 3917: }
