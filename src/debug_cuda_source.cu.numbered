  270: // Polynomial class
  271: template<int grade>
  272: struct Polynomial {
  273:     // Static assertion to give a clear error message at compile time
  274:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  275: };
  276: 
  277: 
  278: // Explicit specialization for grade 4
  279: template<>
  280: struct Polynomial<4> {
  281:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  282: 
  283:    // Constructor from coefficients
  284:    __device__ __host__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  285: 
  286:    __device__ __host__ __forceinline__ double eval(double x) const {
  287:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  288:    }
  289: };
