 1640: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1641:    // Computes the 3D normal vector to the element at level k
 1642:    // Returns the normal vector and the area of the element
 1643: 
 1644:       if (isTri()) {
 1645:          // For triangles...
 1646: 
 1647:          // Gets the normal vector to the element (with a length equal to twice the area)
 1648:          if constexpr(ics==1) {
 1649:             const int kb0 = max(k, nodes[0]->kb);
 1650:             const int kb1 = max(k, nodes[1]->kb);
 1651:             const int kb2 = max(k, nodes[2]->kb);
 1652: 
 1653:             const Vector3 n20 = nodes[2]->p3(k) - nodes[0]->p3(k);
 1654:             const Vector3 n10 = nodes[1]->p3(k) - nodes[0]->p3(k);
 1655:             
 1656:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1657:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1658:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1659:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1660: 
 1661:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1662:             area3D = 0.5*len;
 1663: 
 1664:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1665: 
 1666:             return {nx/len, ny/len, nz/len};
 1667: 
 1668:            
 1669:          }
 1670:          else {  // lat/lon
 1671:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1672: 
 1673:          } // if ics
 1674:       }
 1675:       else {
 1676:          // For quads...
 1677: 
 1678:          assert(false && "Element normal vector: quads not yet implemented");
 1679: 
 1680: 
 1681:       }
 1682:    }
 1683: 
 1684: /**
 1685:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1686:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1687:    If the segment is completely inside the element, then it returns true.
 1688: 
 1689:    This function assumes:
 1690:    - The initial point is on a side of the element. 
 1691:    - Its position is given by parameter t in the range [0,1].
 1692:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1693:       intersects the element (elements are convex).
 1694: 
 1695:    To find the intersection point, this function does the following:
 1696:    - it finds the intersection of the line segment with all the element side lines,
 1697:       except for the one that contains the initial point.
 1698:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1699:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1700:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1701:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1702:       track segment is almost parallel to the element side line.
 1703: 
 1704:    Inputs:
 1705:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1706:    @param x2, y2: other end of the line segment
 1707: 
 1708:    Outputs:
 1709:    @param side:  side that intersects the line segment (input and output)
 1710:    @param nextElement (output): element that contains the intersection point
 1711:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1712:    @param zint (input/output): Vertical coordinate of the intersection point
 1713: 
 1714:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1715:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1716:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1717: 
 1718:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1719:    (Delta) being zero.
 1720: 
 1721:    The intersection2 point happens when:
 1722:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1723:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1724:    
 1725:    Assumption: the 4 points (including those of the side segment) are different.
 1726:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1727:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1728:    If true, (xIntersect,yIntersect) is the intersection.				
 1729:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1730: **/
 1731: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1732:                                               double &t, double& tIntersect) {
 1733: 
 1734:    double closest_intersect_t = 1e10;
 1735:    bool found_intersection = false;
 1736: 
 1737:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1738:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1739:    const Point2 x1 = side->point(t);
 1740:    
 1741: 
 1742:    Side *nextSide = nullptr;
 1743:    for (int i = 0; i < i34; i++) {
 1744: 
 1745:       // Element's i-th side 
 1746:       Side *side2 = sides[i];
 1747: 
 1748:       // Skip the side that contains the initial point
 1749:       if (side2 == side) continue;
 1750: 
 1751:       // (x3,y3)-(x4,y4) is the element side line
 1752:       const Point2 x3 = side2->n1->p2();
 1753:       const Point2 x4 = side2->n2->p2();
 1754: 
 1755:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1756:       const double delta = cross(x2 - x1, x3 - x4);
 1757: 
 1758:       if (delta != 0.0) {
 1759: 
 1760:          const double delta1 = cross(x3 - x1, x3 - x4);
 1761:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1762: 
 1763:          // Solves the two linear equations for tt1 and tt2
 1764:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1765:          const double tt2 = delta2/delta;
 1766: 
 1767:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1768:             closest_intersect_t = min(closest_intersect_t, tt1);
 1769:             nextSide = side2;
 1770: 
 1771:             nextElement = nextSide->otherElem(this);
 1772:             tIntersect = max(small, min(tt1, 1.0-small));
 1773:             t = tt2;
 1774: 
 1775:             found_intersection = true;
 1776:          }
 1777:       
 1778:       }
 1779: 
 1780:    }
 1781: 
 1782:    // found_intersection should always be true, since we checked all the sides.  
 1783:    side = nextSide;
 1784: 
 1785:    return found_intersection;
 1786: }
 1787: 
 1788: 
 1789: 
 1790: 
 1791: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1792:                                               double &t, double& tIntersect) {
 1793: 
 1794:    double closest_intersect_t = 1e10;
 1795:    bool found_intersection = false;
 1796: 
 1797:    for (int i = 0; i < i34; i++) {
 1798: 
 1799:       Side *side2 = sides[i];
 1800: 
 1801:       // (x3,y3)-(x4,y4) is the element side line
 1802:       const Point2 x3 = side2->n1->p2();
 1803:       const Point2 x4 = side2->n2->p2();
 1804: 
 1805:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1806:       const double delta = cross(x2 - x1, x3 - x4);
 1807: 
 1808:       if (abs(delta) > 0) {
 1809: 
 1810:          const double delta1 = cross(x3 - x1, x3 - x4);
 1811:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1812: 
 1813:          // Solves the two linear equations for tt1 and tt2
 1814:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1815:          const double tt2 = delta2/delta;
 1816: 
 1817:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1818:             closest_intersect_t = min(closest_intersect_t, tt1);
 1819:             side = side2;
 1820:             nextElement = side->otherElem(this);
 1821:             t = tt2;
 1822:             tIntersect = max(small, min(tt1, 1.0-small));
 1823:             found_intersection = true;
 1824:          }
 1825:       
 1826:       }
 1827:       else {  // parallel segments
 1828:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1829:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1830: 
 1831:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1832: 
 1833:          // const double dist = dot(x1 - x3, side2->n);
 1834:          // if (abs(dist) < small*length(x3 - x4)) {
 1835:          //    const double2 unitarySide = normalize(x4 - x3);
 1836:          //    const double len = dot(x2 - x1, unitarySide);
 1837:          //    t = t + len;
 1838:          //    t = max(0.0, min(t, 1.0));
 1839:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1840: 
 1841: 
 1842:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1843:          //    // t = tt2;
 1844:          //    found_intersection = true;
 1845:          // }
 1846:       }
 1847: 
 1848: 
 1849:    }
 1850: 
 1851:       
 1852:    assert(found_intersection && "No intersection found");
 1853: 
 1854:    // found_intersection should always be true, since we checked all the sides.  
 1855:    return found_intersection;
 1856: }
 1857: 
 1858: 
 1859: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1860:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1861: 
 1862:    printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 1863: 
 1864:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1865:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1866:    // curElement.
 1867: 
 1868:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1869:    // And uses this velocity instead to continue the tracking.
 1870: 
 1871:    // computes the intersection point in cartesian coordinates
 1872:    Point2 intersection = nextSide->p_t(tt);
 1873: 
 1874:    // Nudges the point to the barycenter of the element. 
 1875:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1876:    // next segment intersects the element sides.  
 1877:    curElem->nudgeToBarycenter(intersection);
 1878: 
 1879:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1880:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1881:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1882:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1883: 
 1884:    // If the side is an open boundary, the tangential velocity is zero.
 1885:    if (nextSide->isBnd()) vtan = 0.0;
 1886: 
 1887:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1888:    const double us = vtan*nextSide->t().x;
 1889:    const double vs = vtan*nextSide->t().y;
 1890:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1891: 
 1892:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1893:    const double len2 = norm2(intersection - toPoint2(xt));
 1894:    const double vel2 = dot(u_int, u_int);        
 1895:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 1896:    else            dt = 0.0;
 1897: 
 1898:    // The end of this tracking segment is now the intersection point.
 1899:    xt = {intersection.x, intersection.y, zint};
 1900: 
 1901:    u_int = {us, vs, ws};
 1902:    
 1903: }
 1904: 
 1905: /**
 1906:  * Tracks a particle through elements and vertical levels in the mesh.
 1907:  * 
 1908:  * @param x0,y0,z0     Starting position coordinates
 1909:  * @param xt,yt,zt     Target position coordinates
 1910:  * @param dtb          Time step for tracking
 1911:  * @param uuint,vvint,wwint Initial velocity components
 1912:  * @param nextElem     Starting/resulting element index
 1913:  * 
 1914:  * @return Status code of type trackExitCodes
 1915:  * 
 1916:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1917:  * of the details are different. The idea is that the code requires less branches and is better fit
 1918:  * for GPU execution.
 1919:  * 
 1920:  * The main ideas here are:
 1921:  * - The starting point is expected to be in the starting element.
 1922:  * - The end point is guaranteed to be inside an element.
 1923:  * - since the starting point is inside the element, there are only two cases: 
 1924:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1925:  *     (b) it does not and (xt,yt) is already in the starting element.
 1926:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1927:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1928:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1929:  * - tt1 can be positive or negative. We only consider the positive values.
 1930:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1931:  * - The next intersection will occur at the smallest positive tt1.
 1932:  * - This intersection will be the next (x0,y0) position.
 1933:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1934:  *   of getting stuck in a loop.
 1935:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1936:  *   was found.
 1937:  */
 1938: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1939:                                                        Element *&nextElem, int &jlev, double &dt,
 1940:                                                        const Side *origSide) {
 1941: 
 1942: 
 1943: 
 1944:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 1945:    // else to do.
 1946:    // If it is, nudges the point to be inside the element.
 1947:    const Element *curElem = nextElem;
 1948:    if (containsPoint(toPoint2(xt), true)) {
 1949: 
 1950:       curElem->interpolateVelocities(xt, u_int);
 1951: 
 1952: addDebugPlot(x0, xt);
 1953:       return true;
 1954:    }
 1955: 
 1956:    Side *side = nullptr;
 1957: 
 1958:    // 1. Initial checks
 1959:    // Verify starting element is valid (wet)
 1960:    assert(!curElem->isDry && "Starting element is dry");
 1961: 
 1962:    // Checks if track has a zero length.
 1963:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1964:    // assert(len2 > 0.0 && "Zero length track"); 
 1965:    
 1966:    const int MAX_ITERATIONS = 1000;
 1967:    
 1968:    double t;
 1969:    Side *nextSide = nullptr;
 1970:    double tIntersect = 1e10;
 1971:    double zint = x0.z;
 1972: 
 1973:    // Horizontal tracking loop
 1974:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1975:    // (x0,y0) is inside the element but the target point is not.
 1976: 
 1977:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1978: 
 1979:    assert(found_intersection && "No intersection found at %d");
 1980: 
 1981:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1982: 
 1983:    // if the tracking segment goes out of water (either dry or edge boundary)
 1984:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1985: 
 1986: addDebugPlot(x0, xt, 0x00A0FF);
 1987:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1988: addDebugPlot(x0, xt, 0x00A0FF);      
 1989: 
 1990:       nextElem = this;
 1991:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1992:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1993:       return true;    
 1994:    }
 1995: 
 1996: 
 1997:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1998:    int iterations = 0;
 1999:    while (iterations < MAX_ITERATIONS) {
 2000:       iterations++;
 2001:       
 2002:       Element *curElem = nextElem;
 2003: 
 2004:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2005: addDebugPlot(x0, xt);
 2006:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2007: 
 2008:       // If we are already in the target element, we are done.
 2009:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 2010:       if (!found_intersection) break;
 2011: 
 2012: 
 2013: 
 2014:       // if the tracking segment goes out of water (either dry or edge boundary).
 2015:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2016: addDebugPlot(x0, xt, 0x00A0FF);
 2017:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 2018: addDebugPlot(x0, xt, 0x00A0FF);   
 2019:          nextElem = curElem;
 2020: 
 2021:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 2022:          // In this case, the caller (btrack) needs to take into account the remaining time.
 2023:          return true;
 2024:       }
 2025:       
 2026:       // Update position and element for next iteration
 2027:       side = nextSide;
 2028: 
 2029:    }
 2030: 
 2031:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 2032: 
 2033:  
 2034:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2035:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2036: addDebugPlot(x0, xt);   
 2037:    nextElem->interpolateVelocities(xt, u_int); 
 2038: 
 2039:    return true;
 2040: }
 2041: 
 2042: 
 2043: __inline__ __device__ double Element::computeSignedArea(void) const {
 2044:    // Compute the area of the element
 2045: 
 2046:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 2047: 
 2048:    // In the quad case we need to add the area of the other triangle.
 2049:    if (isQuad()) {
 2050:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2051:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 2052:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2053:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 2054:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 2055:          Error("Negative area found in quad element");
 2056:       }
 2057:       res += ar1;
 2058:    }
 2059: 
 2060:    return res;
 2061: }
 2062: 
 2063: 
 2064: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2065:                                                                 (nodes[1]->isDry2()) ||
 2066:                                                                 (nodes[2]->isDry2()) ||
 2067:                                                                 (i34==4 && nodes[3]->isDry2());
 2068: }
