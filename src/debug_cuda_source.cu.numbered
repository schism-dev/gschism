 6354: #ifdef DONTCOMPILE
 6355: __device__ void computeVerticalAdvection(void) {
 6356:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6357: 
 6358:    sdbt(1:2,:,:)=0.d0
 6359: 
 6360:    const Side *side = FROM kernel;
 6361: 
 6362:    if(side->isDry) return;
 6363: 
 6364:    // If side is wet...
 6365: 
 6366: 
 6367:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6368:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6369:    double ws[nvrt] = {} // w @ side
 6370:    int icount = 0;
 6371:    for (int j=0; j<2; j++) {
 6372:       const Element *elem = side->elements[j];
 6373:        
 6374:       if(elem != nullptr) {
 6375:          icount++;
 6376:          for (int k=0; k<nvrt; k++) {
 6377:             ws[k] = ws[k] + elem->w[k];
 6378:          }
 6379:       }
 6380:    }  // for j
 6381: 
 6382:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6383:    ws = ws/icount;
 6384: 
 6385:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6386:    // Splines allow for a smooth transition between vertical levels.
 6387:    // Splines have continuity restrictions at the internal knots, but
 6388:    // we have to provide the 1st derivatives at the endpoints.
 6389:    const int kbs = side->kbs; 
 6390:    
 6391:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6392:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6393:    initCubicSpline(kbs, nvrt, side, ws, up)
 6394: 
 6395:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6396:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6397:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6398: 
 6399:    // Total advection (average onto side)
 6400:    const Node *node1 = side->nodes[0];
 6401:    const Node *node2 = side->nodes[1];
 6402:    for (int k=kbs(i); k<nvrt; k++) {
 6403: 
 6404:       if constexpr(ics==1) {
 6405:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6406:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6407:       } else {
 6408:          // XXX IMPLEMENT THIS
 6409:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6410:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6411:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6412:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6413:       }  // if ics
 6414: 
 6415: 
 6416:    }
 6417: }
 6418: #endif
 6419: 
 6420: 
 6421: extern "C" {
 6422:    __global__ void computeElemAverageGhat(void) {
 6423:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6424: 
 6425:       ELEM(elem);
 6426:       
 6427:       elem->ghat1= {0.0, 0.0};  
 6428: 
 6429:       if constexpr(ihydraulics != 0) {
 6430:          if (nhtblocks > 0 && elem->isblock) return;
 6431:       }
 6432: 
 6433:       if (elem->isDry) return;
 6434: 
 6435:       // Wet elements.
 6436:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6437:       // tidal potential, horizontal diffusion, and baroclinic etc
 6438:       // Remember to update both fb and F 
 6439:       // If ics=2, ghat1 are in eframe (ll)
 6440:       // cff1-3: coefficients for 2D/3D
 6441:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6442:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6443:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6444: 
 6445:       double av_cff1 = 0.0;  // av. for cff1
 6446:       double av_cff2 = 0.0;  // av. for cff2
 6447:       double av_cff3 = 0.0;  // av. for cff3
 6448:       double av_df = 0.0;  // av. for H^\alpha / H
 6449:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6450:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6451: 
 6452:       const int i34 = elem->i34;
 6453:       const int kb = elem->kb;
 6454: 
 6455:       for (int j=0; j<i34; j++) {
 6456:          // For each node and side in the element...
 6457: 
 6458:          const Node *node = elem->nodes[j];
 6459:          const Side *side = elem->sides[j];
 6460: 
 6461:          const double chi      = side->chi;
 6462:          const double veg_c2   = side->veg_c2;
 6463:          const double veg_beta = side->veg_beta;
 6464:          const double veg_h    = side->veg_h();
 6465:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6466: 
 6467:          // Node - const in elem
 6468:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6469:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6470: 
 6471:          if (elem->depth >= tip_dp) {
 6472:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6473:          }
 6474: 
 6475:          
 6476:          const double htot  = side->htot2();        // Total depth at the side
 6477:          const double zctr2 = side->zTopCanopy();  
 6478: 
 6479:          double cff1; 
 6480:          double cff2; 
 6481:          double cff3;   
 6482:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6483:          // coefficients applied to 2D/3D case 
 6484:             cff1 = side->hhat/htot;
 6485:             cff2 = 0.0;
 6486:             cff3 = 0.0;
 6487:          } else { //3D
 6488:             //Init for no-veg case
 6489:             cff1 = 1.0;
 6490:             cff2 = 1.0;
 6491:             cff3 = 0.0;
 6492: 
 6493:             if constexpr(iveg != 0) {
 6494:                // Computes coefficients used with vegetation terms G1, G2
 6495:                // cff1, cff3 are used for the first two terms in G1, G2:
 6496:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6497:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6498:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6499:                if(veg_h < 0.99*htot) { // submergent vegetation
 6500:                   cff1=1;
 6501:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6502:                   cff3 = veg_c;
 6503: 
 6504:                } else { // emergent vegetation
 6505:                   cff1 = 1.0/(1.0 + veg_c2);
 6506:                   cff2 = cff1;
 6507:                   cff3 = 0.0;
 6508: 
 6509:                }
 6510:             } // if iveg
 6511:          } //  2D/3D
 6512: 
 6513:          av_cff1 += cff1/i34;
 6514:          av_cff2 += cff2/i34;
 6515:          av_cff3 += cff3/i34;
 6516:          av_cff2_chi += cff2*chi/i34;
 6517:          av_cff3_chi += cff3*chi/i34;
 6518:          av_df += min(htot, veg_h)/(htot*i34);
 6519: 
 6520: 
 6521:          // btrack values: U^\star, U^{\star\alpha}
 6522:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6523:          Vector2 Ustar       = {0.0, 0.0}; 
 6524:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6525: 
 6526:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6527:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6528:          } else { //3D
 6529:             for (int k = side->kb; k < nvrt; k++) {
 6530:             
 6531:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6532:                Ustar += w2;
 6533: 
 6534:                if constexpr(iveg != 0) {
 6535:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6536:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6537:                        Ustar_alpha += zrat*w2; // XXXX
 6538:                    }
 6539:                }  // if iveg
 6540:             }  // for k
 6541:          }  //2D/3D
 6542:          
 6543: 
 6544:          // Add btrack & surface stress terms to \breve{G} first
 6545:          if constexpr(ics==1) {
 6546: 
 6547:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6548: 
 6549:          } else {
 6550:             // XXX IMPLEMENT THIS
 6551:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6552:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6553:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6554:          }  // if ics
 6555: 
 6556:          // Surface and bottom stress terms
 6557:          if constexpr(ics==1) {
 6558:             const Vector2 tau    = side->tau();
 6559:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6560: 
 6561:             // Term for surface and bottom stress
 6562:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6563: 
 6564:          } else {
 6565:             assert(false && "computeElemAverageGhat: Not implemented");
 6566:             // XXX IMPLEMENT THIS
 6567:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6568:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6569:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6570:             // tau_x=(vn1+tt1)/2.d0
 6571:             // tau_y=(vn2+ss1)/2.d0
 6572:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6573:          }  // if ics
 6574: 
 6575:          
 6576: 
 6577:          // All terms in F,F^\alpha,f_b except baroclinic
 6578:          // F, f_b: all explicit terms excluding vegetation 
 6579:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6580:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6581:          const double coriolis = side->coriolis;
 6582:          Vector2 F  =  coriolis*side->U;  // F_x
 6583:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6584:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6585: 
 6586:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6587:             
 6588:             for (int k = side->kb; k < nvrt; k++) {
 6589:                if (zctr2 > side->zc[k-1]) {
 6590:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6591:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6592:                    Fa +=  coriolis*w2*zrat;
 6593:                } // if zctr2
 6594:             } // k
 6595:          } // iveg
 6596: 
 6597:          // Integrate horizontal viscosity force vertically
 6598:          for (int k=side->kb + 1; k<nvrt; k++) {
 6599:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6600: 
 6601:             F += levelHorVisc;
 6602: 
 6603:             // Vegetation term
 6604:             if constexpr(iveg!=0) {
 6605:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6606:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6607:                   Fa += levelHorVisc*zrat;
 6608:                } 
 6609:             } // if iveg
 6610:          } // for k
 6611: 
 6612:          fb += side->nuGradU[side->kb];
 6613: 
 6614:          // Add to ghat1
 6615:          if constexpr(ics==2) {
 6616:             // XXX IMPLEMENT THIS
 6617:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6618:             // bigf1=vn1; bigf2=vn2
 6619:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6620:             // botf1=vn1; botf2=vn2
 6621:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6622:             // bigfa1=vn1; bigfa2=vn2
 6623:          } // if ics
 6624: 
 6625:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6626:       } // for j (nodes and sides)
 6627: 
 6628:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6629:          
 6630:       // Finish off terms in F, F^\alpha and f_b
 6631:       const double grav3 = elem->mean(&Node::grav2);
 6632:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6633: 
 6634: 
 6635:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6636:       for (int j=1; j<i34; j++) { 
 6637:          // For each side in the element...
 6638:          const Side *side = elem->sides[j];
 6639:          const double chi = side->chi;
 6640: 
 6641:          const double htot = side->htot2();
 6642:          const double veg_h = side->veg_h();
 6643:          const Vector2 F  = htot*fb;
 6644:          const Vector2 Fa = min(htot, veg_h)*fb;
 6645: 
 6646:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6647:       } // for j
 6648: 
 6649:       //botf1 etc are already in elem frame
 6650:       elem->ghat1 += tmp/i34;
 6651: 
 6652:       // Baroclinic force
 6653:       if constexpr(ibc==0) {
 6654:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6655: 
 6656:          Vector2 Fa = {0.0, 0.0};
 6657:          Vector2 intGradRho = {0.0, 0.0};
 6658:          
 6659:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6660:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6661:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6662: 
 6663:             // \in F [m^2/s/s]
 6664:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6665:          }
 6666: 
 6667:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6668:          const Vector2 F = av_df*Fa; //approx
 6669:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6670: 
 6671:       } // if ibc
 6672: 
 6673: 
 6674: 
 6675:    }
 6676: 
 6677: } // extern "C"
 6678: 
 6679: 
 6680: 
 6681: #ifdef DONTCOMPILE
 6682: __global__ void checkMassConservation(Tracers* sumtr) {
 6683: 
 6684:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6685: 
 6686:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6687: 
 6688:    Element *elem = &(mesh->localElemData[i]);
 6689: 
 6690:    // Skip dry elements
 6691:    if (elem->isDry) return;
 6692: 
 6693:    // Local sum array for this thread
 6694:    double localSum[N_TRACERS] = {0.0};
 6695: 
 6696:    // Sum over vertical levels for this element
 6697:    const int kbe = elem->kbe;
 6698:    const double area = elem->area;
 6699: 
 6700:    for (int k = kbe; k < nvrt; k++) {
 6701:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6702:       
 6703:       // Accumulate tracer mass
 6704:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6705:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6706:       }
 6707:    }
 6708: 
 6709:    
 6710: 
 6711:    //  This function returns per element sums. A reduction must be done on the host side.
 6712: }
 6713: 
 6714: 
 6715: __global__ void transport(void) {
 6716: 
 6717:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6718: 
 6719:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6720: 
 6721:    Element *elem = &(mesh->localElemData[ie]);
 6722: 
 6723:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6724: 
 6725:                for (int m=0; m<ntr; m++) {
 6726:                   for (int k=kbe(ie); k<nvrt; k++) {
 6727:                      // Calculate each polynomial's weight 
 6728:                      wm=0.d0; sum1=0.d0; 
 6729:                      wm1=0.d0; wm2=0.d0; 
 6730:                      for (int i=0; i<elem->nweno2; i++) {
 6731:                   
 6732:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6733:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6734:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6735:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6736:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6737:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6738:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6739:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6740:                      // -----------------Hu and Shu (1999)'s method----------------
 6741:                      b4=b1+b2+b3
 6742: 
 6743: //Error: add PRODUCTION CPP
 6744: #ifdef DEBUG
 6745:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6746:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6747:                     call parallel_abort(errmsg)
 6748:                   }
 6749: #endif
 6750: 
 6751:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6752:                   // !----test-------------- 
 6753:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6754:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6755:                   // !wm(i)=wm1(i)*wm2(i)
 6756:                   // !---------------------- 
 6757:                   sum1=sum1+wm(i)
 6758:                 } // end for i
 6759: 
 6760:                 wm=wm/sum1
 6761: 
 6762:                 for (int j=0; j<elem->i34; j++) {
 6763: 
 6764:                   const Side *side  = elem->sides[j];
 6765:                   const Node *node1 = side->n1;
 6766:                   const Node *node2 = side->n2;
 6767: 
 6768:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6769:                      trsd=0.d0
 6770:                      for (int kk=0; kk<nquad; kk++) {
 6771:                         for (int i=0; i<elem->nweno2; i++) {
 6772:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6773:                         } // end for i   
 6774:                      } // end for kk
 6775:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6776:                   } // outward flux
 6777:                } // end for j=1,i34(ie) ! side
 6778:             }
 6779:          }
 6780:               
 6781: 
 6782: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6783: //             //   calculate each polynomial's weight 
 6784: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6785: //                 wm=0.d0; sum1=0.d0
 6786: //                 do i=1,nweno1(ie) !for each polynomial
 6787: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6788: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6789: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6790: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6791: //                   wm(i)=b2
 6792: //                   sum1=sum1+b2
 6793: //                   !wm(i)=1.d0
 6794: //                   !sum1=sum1+1.d0
 6795: 
 6796: // // Error: PRODUCTION
 6797: // #ifdef DEBUG
 6798: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6799: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6800: //                     call parallel_abort(errmsg)
 6801: //                   endif
 6802: // #endif
 6803: 
 6804: //                 enddo !i
 6805: //                 wm=wm/sum1 !final weight
 6806: 
 6807:                 for (int j=0; j<elem->i34; j++) { // side
 6808:                   const Side *side = elem->sides[j];
 6809:                   const Node *node1 = side->n1;
 6810:                   const Node *node2 = side->n2;
 6811: 
 6812:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6813:                     trsd=0.d0
 6814:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6815:                       for (int i=0; i<elem->nweno1; i++) {
 6816:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6817:                       }
 6818:                     enddo //kk
 6819:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6820:                   } // outward flux
 6821:                 } // end for j=1,i34(ie) ! side
 6822:               } // end for k; ntr 
 6823: 
 6824:             else !simple upwind method
 6825:               do j=1,i34(ie)
 6826:                 jsj=elside(j,ie)
 6827:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6828:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6829:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6830:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6831:                   endif
 6832:                 enddo  !vertical layers
 6833:               enddo !j=1,i34(ie) ! side
 6834:             endif !order of accuracy
 6835: 
 6836:          //  enddo !ie
 6837: // !$OMP     end do
 6838: 
