 7534: extern "C" __global__ void getElementVar(int varCode, bool is3D, double *var1, double *var2, int *ivar1, int *ivar2, int k = -1, int j = -1) {
 7535:    // Get the value of a variable from an element
 7536:    // varName is the name of the variable to get
 7537:    // var is the array to store the value
 7538:    // k is the vertical level index of the variable to get
 7539: 
 7540:    ELEM(elem);
 7541:    
 7542:    int idx = elem->idx;
 7543:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7544: 
 7545:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7546:    if      (varCode == (int)VarCode::w)       { var1[idx] = elem->w[k];}
 7547:    else if (varCode == (int)VarCode::z)       { var1[idx] = elem->z[k];}
 7548:    else if (varCode == (int)VarCode::x)       { var1[idx] = elem->center.x; var2[idx] = elem->center.x;}
 7549:    else if (varCode == (int)VarCode::area)    { var1[idx] = elem->area;}
 7550:    else if (varCode == (int)VarCode::depth)   { var1[idx] = elem->depth;}
 7551:    else if (varCode == (int)VarCode::radius)  { var1[idx] = elem->radius;}
 7552:    else if (varCode == (int)VarCode::lonlat)  { var1[idx] = elem->xlon;     var2[idx] = elem->ylat;}
 7553:    else if (varCode == (int)VarCode::ghat)    { var1[idx] = elem->ghat1.x;  var2[idx] = elem->ghat1.y;}
 7554:    else if (varCode == (int)VarCode::kb)      { ivar1[idx] = elem->kb;}
 7555:    else if (varCode == (int)VarCode::ssign && j > -1)  {ivar1[idx] = elem->ssign[j];}
 7556:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7557:       
 7558:    
 7559: }
 7560: 
 7561: 
 7562: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7563:    // Get the value of a variable from an node
 7564:    // varName is the name of the variable to get
 7565:    // var is the array to store the value
 7566:    // k is the vertical level index of the variable to get
 7567: 
 7568:    NODE(node);
 7569:    
 7570:    int idx = node->idx;
 7571:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7572: 
 7573:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7574:    
 7575:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7576:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7577:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7578:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 7579:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7580:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7581:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;  
 7582:    else if (varCode == (int)VarCode::isdry && k == -1)  var[idx] = node->isDry?1.0:0.0;
 7583:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7584:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7585:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 7586:    
 7587:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7588:       
 7589:    
 7590: }
 7591: 
 7592: 
 7593: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7594:    // Get the value of a variable from an side
 7595:    // varName is the name of the variable to get
 7596:    // var is the array to store the value
 7597:    // k is the vertical level index of the variable to get
 7598:    SIDE(side);
 7599:    
 7600:    int idx = side->idx;
 7601:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7602: 
 7603:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 7604:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 7605:    // else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 7606:    else if (varCode == (int)VarCode::isdry && k == -1)   var[idx] = side->isDry?1.0:0.0;
 7607:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 7608:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 7609:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 7610:    // else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 7611:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 7612:    // else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 7613:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 7614:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 7615:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 7616:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 7617:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 7618:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 7619:    // else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 7620:    else if (varCode == (int)VarCode::bcc && k >= 0)      var[idx] = side->bcc[k].x;
 7621:    // else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 7622:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7623:    // else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7624:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7625:    // else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7626:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 7627:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 7628:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 7629:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 7630:    else if (varCode == (int)VarCode::chi  && k == -1)    var[idx] = side->chi;
 7631:    // else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 7632:    // else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 7633:    // else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 7634:    // else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 7635:    // else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 7636:    // else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 7637:    // else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 7638:    // else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 7639:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7640: }
 7641: 
 7642: 
 7643: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 7644:    // Get the value of a variable from an side
 7645:    // varName is the name of the variable to get
 7646:    // var is the array to store the value
 7647:    // k is the vertical level index of the variable to get
 7648:    SIDE_BND(sideBnd);   
 7649: 
 7650:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 7651:    if (sideBnd->segment->isLand) idx = -7;
 7652: 
 7653:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 7654:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 7655: 
 7656: }
