 2074: __device__ void lock(int *mutex) {
 2075:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 2076: }
 2077: 
 2078: __device__ void unlock(int *mutex) {
 2079:     atomicExch(mutex, 0);
 2080: }
