 6046:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 6047: 
 6048:       NODE(node);
 6049: 
 6050:       node->ETP = 0.0;
 6051: 
 6052:       if constexpr(ntip == 0) return;
 6053: 
 6054:       // For all tidal potential components
 6055:       for (int j=0; j<ntip; j++) {
 6056: 
 6057:          const double nodeETP = node->computeETP(j, time, tfreq, tamp, tnf, tear, jspc);
 6058: 
 6059:          node->ETP += nodeETP;
 6060: 
 6061:          if constexpr(iloadtide==1) { // loading tide
 6062:             assert(false && "Loading tide not implemented");
 6063:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 6064:          }
 6065:          
 6066:       }
 6067: 
 6068:      
 6069:    }
