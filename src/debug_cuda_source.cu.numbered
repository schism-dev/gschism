 5260:    //            if(icount2>nnode_fl) call parallel_abort('STEP: wrong counting vel')
 5261: 
 5262:    //            uthnd(1:nvrt,j,k)=(1.d0-rat)*ath2(1,1:nvrt,icount2,1,2)+rat*ath2(1,1:nvrt,icount2,2,2) !ll frame if ics=2
 5263:    //            vthnd(1:nvrt,j,k)=(1.d0-rat)*ath2(2,1:nvrt,icount2,1,2)+rat*ath2(2,1:nvrt,icount2,2,2)
 5264:    //          enddo !j
 5265:    //        endif
 5266:    //      enddo !k
 5267:    //    endif !nfltype2
 5268:    }
 5269: 
 5270:    __global__ void resetBoundaryAreas(void) {
 5271:       // Reset boundary areas and lengths for each segment.
 5272: 
 5273:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 5274:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 5275:       SIDE_BND(sideBnd);
 5276: 
 5277:       BoundarySegment *segment = sideBnd->segment;
 5278: 
 5279:       segment->carea = 0.0;
 5280:       segment->clen = 0.0;
 5281:  
 5282:    }
 5283: 
 5284:    __global__ void computeBoundaryAreas(void) {
 5285:    // Calculation of cross-section areas and lengths for flow b.c.
 5286: 
 5287:       SIDE_BND(sideBnd);
 5288: 
 5289:       const Side *side = sideBnd->side;
 5290:       BoundarySegment *segment = sideBnd->segment;
 5291: 
 5292:       if (segment->ifltype != 0) {
 5293: 
 5294:          const Node *n1 = side->n1;
 5295:          const Node *n2 = side->n2;
 5296: 
 5297:          const double htot = side->htot2();
 5298: 
 5299:          if (!side->isDry) {
 5300:             atomicAdd(&segment->carea, htot*side->len);
 5301:             atomicAdd(&segment->clen, side->len);
 5302:          }
 5303:       }
 5304: 
 5305:    }
 5306: 
 5307: 
 5308:    __global__ void computeFlowBcVelocities(double time) {
 5309: 
 5310:       SIDE_BND(sideBnd);
 5311: 
 5312:       const Side *side = sideBnd->side;
 5313:  
 5314:       const bool isDry = side->isDry;
 5315:       const bool isLand = sideBnd->segment->isLand;
 5316: 
 5317:    
 5318:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 5319: 
 5320:       if (isDry || isLand) return;
 5321: 
 5322:       // For wet sides in open boundaries...
 5323:       const Vector2 n = side->n;
 5324:       const BoundarySegment *segment = sideBnd->segment;
 5325: 
 5326:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 5327: 
 5328:       const int ifltype = segment->ifltype;
 5329: 
 5330:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 5331:       const Vector2 r_nuth0 = r_uth0*n;
 5332: 
 5333: 
 5334:       if (ifltype == 1 || ifltype == 2) {
 5335:       
 5336:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 5337: 
 5338:          const double unth0 = segment->qthcon*ramp/segment->carea;
 5339:          
 5340:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 5341:          
 5342:       } else if (ifltype == -1) { // Flather 1
 5343: 
 5344:          for (int k = 0; k < nvrt; k++) {
 5345: 
 5346:             // uth is the normal vel.; no ramp up
 5347:             const double uth = sideBnd->nuth(k);
 5348:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 5349: 
 5350:             sideBnd->ubc[k] += uth*n;
 5351:          }
 5352: 
 5353:       } else if (ifltype == 3 || ifltype == 5) {
 5354:          // vnth0=0 !normal vel.
 5355: 
 5356:          Vector2 r_u1_bar = {0.0, 0.0};
 5357:          // Computes the contribution to the velocity from all tide frequencies
 5358:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5359: 
 5360:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 5361:             const Vector2 umo  = sideBnd->umo(jfr); 
 5362: 
 5363:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5364:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 5365:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 5366:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 5367: 
 5368:          }
 5369: 
 5370: 
 5371:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 5372: 
 5373:       } // if (ifltype = 3 || ifltype == 5
 5374: 
 5375: 
 5376: 
 5377:    }
 5378: 
 5379:    __global__ void computeElevationBoundaryConditions(double time) {
 5380:       // Compute elevation essential boundary conditions 
 5381: 
 5382:       NODE_BND(nodeBnd); // Each boundary node.
 5383: 
 5384:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 5385: 
 5386:       const Node *node = nodeBnd->node;
 5387:       const BoundarySegment *segment = nodeBnd->segment;
 5388:       const int iettype = segment->iettype;
 5389:       
 5390: 
 5391:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 5392:       double eic = 0.0;
 5393:       if (nramp_elev == 1) eic = nodeBnd->etaic;  // XXXX is etaic ever set?  
 5394:       else                 eic = 0.0;
 5395: 
 5396:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 5397:       const double r_eth = ramp*nodeBnd->eth;
 5398:       double r_eta1_bar = 0.0;
 5399: 
 5400:       // Compute tide elevation
 5401:       if (iettype == 3 || iettype == 5) {   
 5402: 
 5403:          if constexpr(iloadtide==1) { // loading tide
 5404:             assert(false && "Loading tide not implemented");
 5405:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5406:          }
 5407:          
 5408:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5409: 
 5410:             const double efa  = nodeBnd->efa[jfr]; 
 5411:             const double emo  = nodeBnd->emo[jfr]; 
 5412: 
 5413:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5414:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 5415:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 5416: 
 5417: 
 5418:          } // for jfr
 5419: 
 5420:       } // if iettype
 5421: 
 5422:       switch (iettype) {
 5423:          case 1:
 5424:          case 2:
 5425:          case 4:
 5426:             nodeBnd->elbc = r_eic + r_eth;
 5427:             break;
 5428:          case 3:
 5429:             nodeBnd->elbc = r_eic + r_eta1_bar;
 5430:             break;
 5431:          case 5:
 5432:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 5433:             break;
 5434:       } // switch
 5435: 
 5436: 
 5437:       //Add inverse barometric effects
 5438:       if (iettype != 0 && inv_atm_bnd == 1) {
 5439:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 5440:       }
 5441: 
 5442:    }
 5443: 
 5444: 
 5445:    __global__ void computeHorizontalViscosity(void) { 
 5446: 
 5447:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 5448: 
 5449:       SIDE(side);
 5450: 
 5451:       if (side->isDry) return;
 5452: 
 5453:       for (int k = 0; k < nvrt; k++) {
 5454:          side->nuGradU[k] = {0.0, 0.0};
 5455:       }
 5456: 
 5457:       if constexpr(ihorcon == 1) {
 5458:          for (int k = side->kb; k < nvrt - 1; k++) {
 5459:             // Computes the Laplacian by using the simplified formula presented in the paper:
 5460:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 5461:             // By Zhang and Baptista.
 5462: 
 5463:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 5464:             // This is a standard discretization of the Laplacian operator.
 5465:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 5466:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 5467:             // Gamma is hvis_coef0 in the code.
 5468:             // The value of gamma needs to be < 0.5.
 5469: 
 5470:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 5471:             // side under consideration in each of the two possible elements that share the side.
 5472:             Vector2 sumU = {0.0, 0.0};
 5473:             for (int l = 0; l < 2; l++) {
 5474:                const Element *elem = side->elems[l];
 5475: 
 5476:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 5477: 
 5478:                // Find the local index of the side in the element
 5479:                const int idxSide = elem->sideLocalIdx(side);
 5480: 
 5481:                // Find the two sides that are connected to the side under consideration
 5482:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 5483:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 5484: 
 5485:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 5486: 
 5487:             }
 5488: 
 5489:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 5490: 
 5491:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 5492:    
 5493:          }
 5494:       }
 5495:       else if constexpr(ihorcon == 2) {
 5496:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 5497:       }
 5498: 
 5499: 
 5500:    }
 5501: 
 5502: 
 5503:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 5504: 
 5505:       // Set essential boundary conditions 
 5506:       NODE(node); // Each boundary node
 5507:       NodeBoundary *nodeBnd = node->nodeBnd;
 5508:       
 5509:  
 5510:       // Check if this node has essential BC
 5511:       if (nodeBnd && nodeBnd->isEssentialBC) {
 5512:          // Verify BC value is valid
 5513:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5514: 
 5515:        
 5516:          // Set diagonal to 1 and zero off-diagonals
 5517:          node->coeffDiag = 1.0;
 5518: 
 5519:          for (int j = 0; j < node->numNodes; j++) {
 5520:                node->coeffMatrix[j] = 0.0;
 5521:          }
 5522:          
 5523:          // Set solution and RHS to BC value
 5524:          node->mX  = nodeBnd->elbc;
 5525:          node->qel = nodeBnd->elbc;
 5526: 
 5527:       } else {
 5528:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 5529: 
 5530:          for (int j = 0; j < node->numNodes; j++) {
 5531:                Node* nbNode = node->nodes[j];
 5532:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 5533:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 5534:                   // Verify neighbor's BC value
 5535:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5536: 
 5537:                   // Subtract contribution to RHS
 5538:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 5539:                   node->coeffMatrix[j] = 0.0;  
 5540:                }
 5541:          }
 5542:       }
 5543:    }
 5544: 
 5545: 
 5546:    __global__ void updateElevation(void) {
 5547:       NODE(node);
 5548: 
 5549: 
 5550:       node->eta2 = node->mX;
 5551: 
 5552:       node->updateZCoordData();
 5553:    }
