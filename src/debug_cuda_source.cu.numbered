 1973: //===============================================================================
 1974: 
 1975: 
 1976: /**
 1977:  * Find the element that contains the target point.
 1978:  * 
 1979:  * @param x0,y0,z0     Starting position coordinates
 1980:  * @param xt,yt,zt     Target position coordinates
 1981:  * @param dtb          Time step for tracking
 1982:  * @param u_int        Initial velocity components
 1983:  * @param nextElem     Starting/resulting element index
 1984:  * 
 1985:  * @return Status code of type trackExitCodes
 1986:  * 
 1987:  * Uses the Leaded Celestial Walk algorithm to find the element that contains the target point.
 1988:  * This is a variant of the Celestial Walk algorithm that goes from element A containing the starting 
 1989:  * point x0 (in one side) to element B containing the target point xt. To enforce that the next element is
 1990:  * as close the the segment AB as possible, the next point at each iteration is computed
 1991:  * along segment AB, but just after the current element.
 1992:  */
 1993: 
 1994: 
 1995: __device__ __forceinline__ bool celestialWalk(Element *&curElem, Point3 x0, Point3 &xt, const Side *origSide, Side *&lastCrossSide, int jlev) {
 1996: 
 1997:    constexpr int MAX_ITERATIONS = 40;
 1998: 
 1999:    int iter = 0;
 2000:    double fac = 0.00001;
 2001:    while (iter < MAX_ITERATIONS) {
 2002:       iter++;
 2003: 
 2004:       Bool4 isLeft, isObtuse, isBisector;
 2005:       curElem->computePredicates(toPoint2(x0), toPoint2(xt), fac, origSide, isLeft, isObtuse, isBisector, jlev);
 2006: // showPoints(x0, xt, jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2007:       Bool4 isValid = !isLeft & (!isObtuse | isBisector); // bitwise operation are overloaded
 2008: 
 2009: 
 2010:       if (isValid.none()) 
 2011:       // Inside the element if none of the edges is a valid continuation
 2012:       {
 2013:          // Just returns true and the element (curElem) is unchanged).
 2014:          // This means that the algorithm has found the element that contains the target point.
 2015:          return true;
 2016:       }
 2017:       else { // Outside the element
 2018: 
 2019:          // Outside this element. Pick the first valid exit side and cross.
 2020:          lastCrossSide = curElem->sides[isValid.firstOne()];
 2021:          Element *prevElem = curElem;
 2022:          curElem = lastCrossSide->otherElem(curElem);
 2023: 
 2024:          // If it crosses into a dry element or a boundary element, return false. This means that the track will now move 
 2025:          // along the boundary.
 2026:          if (curElem == nullptr || curElem->isDry) {
 2027:          
 2028:             curElem = prevElem;
 2029:             return false;
 2030:          }
 2031:          
 2032:       }
 2033: 
 2034:    }
 2035: 
 2036:   assert(false && "Leaded Celestial Walk: exceeded max iterations");
 2037: }
 2038: 
 2039: 
