 2190:    template<typename T>
 2191:    __device__ __forceinline__ T Element::mean(int level,  T (Side::*func)(int) const) const {
 2192: 
 2193:       T values[4];
 2194: 
 2195: 
 2196:       values[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2197:       values[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2198:       values[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2199:       if (isQuad()) values[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2200:       else          values[3] = T();
 2201: 
 2202:       if constexpr (IsVector2<T>::value && ics == 2) projectSideVectorsToElementFrame(values);
 2203: 
 2204:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2205:    }
