 1792: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o') {
 1793: // return;   
 1794:    // Lock the mutex
 1795:    lock(&debugPlotMutex);
 1796:  
 1797:    bool ok = true;
 1798:    if (debugPlotIdx == nullptr) ok = false;
 1799:    if (*debugPlotIdx >= 10000) ok = false;
 1800:    if (ok) {
 1801:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1802:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1803:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1804:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1805:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1806:       debugPlot[(*debugPlotIdx) + 5*10000] = (double)marker;
 1807:       (*debugPlotIdx)++;
 1808:    }
 1809: 
 1810:    __threadfence();               // ensure all above writes are visible
 1811:    // Unlock the mutex
 1812:    unlock(&debugPlotMutex);
 1813: 
 1814: }
