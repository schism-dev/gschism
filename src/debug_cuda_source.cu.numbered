 3843: extern "C" {
 3844: 
 3845:    __global__ void scaleGravity(double loadtide_coef) {
 3846: 
 3847: 
 3848:       NODE(node);
 3849: 
 3850:       // SAL option: scale gravity
 3851:       if constexpr(iloadtide==2) {  // simple const
 3852:          node->grav2 = grav*(1.0 - loadtide_coef);
 3853: 
 3854:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3855:         
 3856:           const double depth = max(node->depth, 0.0);
 3857:           const double tmp1 = sqrt(depth);
 3858:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3859:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3860:                              2.6969e-13*depth*depth*depth*tmp1;
 3861:           
 3862:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3863:           
 3864: 
 3865: 
 3866:           node->grav2 = grav*(1.0 - beta_bar);
 3867: 
 3868:       } else {  // iloadtide=0,1
 3869:         node->grav2=grav;
 3870: 
 3871:       }
 3872: 
 3873:       printf("scaleGravity: node(%d)->grav2 = %f\n", node->idx, node->grav2);
 3874:    }
