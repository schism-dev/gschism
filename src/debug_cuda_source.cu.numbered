 6623:    __global__ void resetVelocityOpenBndNodes(void) {
 6624:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6625: 
 6626:       NODE_BND(nodebnd);
 6627: 
 6628:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6629:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 6630:       }
 6631: 
 6632:    }
 6633: 
 6634: 
 6635:    __global__ void setVelocityOpenBndNodes(void) {
 6636:    // For open boundary nodes sets their velocity to the imposed values.
 6637: 
 6638:       SIDE_BND(sidebnd);
 6639: 
 6640:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6641:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6642:          // to its segment to the average of the side velocity.
 6643: 
 6644:          for (int k = 0; k < nvrt; k++) {
 6645:             Node *n1 = sidebnd->side->n1;
 6646:             Node *n2 = sidebnd->side->n2;
 6647: 
 6648: 
 6649:             Vector2 n1_u2(n1->u2[k]);
 6650:             Vector2 n2_u2(n2->u2[k]);
 6651: 
 6652:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6653:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6654:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6655:             }
 6656:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6657:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6658:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6659:             }
 6660: 
 6661:          }
 6662: 
 6663:       }
 6664: 
 6665:    }
 6666: 
 6667: 
 6668:    __global__ void computeVerticalVelocity(void) {
 6669:       // Computes the vertical velocity at the (2D) element's centroid.
 6670:       // In this function we will be considering volumetric elements, with side faces and a 
 6671:       // bottom and a top face. We will call them SFs, BF and TF.
 6672:       // It computes the flux coming from BF and the SFs.
 6673:       // If the bed is moving, it takes that into account.
 6674:       // Since water is incompressible, the integral of the velocity times the normal vector
 6675:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6676:       // and the BF is equal to the flux going out from the TF.
 6677:       // TF = - BF - sum(SFs).
 6678:       // It then computes the horizontal velocity at the center of TF.
 6679:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6680:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6681:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6682: 
 6683:       ELEM(elem);
 6684: 
 6685:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 6686: 
 6687:       if (elem->isDry) return;
 6688: 
 6689:       const int kb = elem->kb;
 6690:       const bool isTri = elem->isTri();
 6691: 
 6692:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6693: 
 6694:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6695:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6696:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6697: 
 6698:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6699: 
 6700:       double area3D;
 6701: 
 6702:       // Bottom face flux
 6703:       double bottomFlux = 0.0;
 6704:       Vector2 u2meanBottom = {0.0, 0.0};
 6705:       const Vector2 gradh = elem->grad2(&Node::depth);
 6706:       if constexpr(imm==2) {
 6707:          Vector3 ubed;
 6708: 
 6709:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6710:          // updateBDEF(ubed);
 6711:      
 6712:          // const double bflux0 = dot(ubed, elem_n1);
 6713: 
 6714:          // elem->w[kb] += ubed.z;
 6715:       }
 6716:       else {
 6717:          Vector2 umean;
 6718:          if constexpr(ics == 1) {
 6719:             u2meanBottom = elem->mean(kb, &Side::u2);
 6720:          }
 6721:          else {
 6722:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6723:          }
 6724: 
 6725:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6726:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6727: 
 6728:          bottomFlux = - dot(gradh, u2meanBottom);
 6729:       } // if imm
 6730: 
 6731:       // Compute w for kb+1 to nvrt-1
 6732:       for (int l = kb; l < nvrt - 1; l++) {
 6733: 
 6734:          // normal vector to the top face of the "volumetric" element (3D)
 6735:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6736: 
 6737:          // Compute the total flux at the sides
 6738:          double sideFlux = 0.0;
 6739: 
 6740:          for (int j = 0; j < elem->i34; j++) {
 6741:             const Side *side = elem->sides[j];
 6742: 
 6743:             const double sideArea = side->area(l);
 6744:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6745:             const double sign = elem->ssign[j]; 
 6746: 
 6747:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6748:          }
 6749:          
 6750:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6751:          //velocities at the centers of the sides
 6752:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6753: 
 6754:          // The flx at the top ace can be computed from the other flows.
 6755:          const double topFlux = - sideFlux - bottomFlux;
 6756:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6757: 
 6758:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6759: 
 6760:          elem_n1 = elem_n2;
 6761: 
 6762:          bottomFlux = - topFlux;
 6763:       }
 6764:    }  
 6765: 
 6766: 
 6767: 
 6768: 
 6769: 
 6770: 
 6771: 
