 7182: 
 7183:    __global__ void setVelocityOpenBndNodes(void) {
 7184:    // For open boundary nodes sets their velocity to the imposed values.
 7185: 
 7186:       SIDE_BND(sidebnd);
 7187: 
 7188:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 7189:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 7190:          // to its segment to the average of the side velocity.
 7191: 
 7192:          for (int k = 0; k < nvrt; k++) {
 7193:             Node *n1 = sidebnd->side->n1;
 7194:             Node *n2 = sidebnd->side->n2;
 7195: 
 7196: 
 7197:             Vector2 n1_u2(n1->u2[k]);
 7198:             Vector2 n2_u2(n2->u2[k]);
 7199: 
 7200:             if (n1->nodeBnd->segment == sidebnd->segment) {
 7201:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 7202:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 7203:             }
 7204:             if (n2->nodeBnd->segment == sidebnd->segment) {
 7205:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 7206:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 7207:             }
 7208: 
 7209:          }
 7210: 
 7211:       }
 7212: 
 7213:    }
 7214: 
 7215: 
 7216:    __global__ void computeVerticalVelocity(void) {
 7217:       // Computes the vertical velocity at the (2D) element's centroid.
 7218:       // In this function we will be considering volumetric elements, with side faces and a 
 7219:       // bottom and a top face. We will call them SFs, BF and TF.
 7220:       // It computes the flux coming from BF and the SFs.
 7221:       // If the bed is moving, it takes that into account.
 7222:       // Since water is incompressible, the integral of the velocity times the normal vector
 7223:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 7224:       // and the BF is equal to the flux going out from the TF.
 7225:       // TF = - BF - sum(SFs).
 7226:       // It then computes the horizontal velocity at the center of TF.
 7227:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 7228:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 7229:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 7230: 
 7231:       ELEM(elem);
 7232: 
 7233:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 7234: 
 7235:       if (elem->isDry) return;
 7236: 
 7237:       const int kb = elem->kb;
 7238:       const bool isTri = elem->isTri();
 7239: 
 7240:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 7241: 
 7242:       // Compute the bottom velocity
 7243:       if constexpr(imm != 0) {
 7244:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 7245:       }
 7246: 
 7247: 
 7248:       double bottomArea3D;
 7249:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 7250: 
 7251:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 7252: 
 7253:       double topArea3D;
 7254: 
 7255:       // Bottom face flux
 7256:       double bottomFlux = 0.0;
 7257:       Vector2 u2meanBottom = {0.0, 0.0};
 7258:       const Vector2 gradh = elem->grad2(&Node::depth);
 7259:       if constexpr(imm==2) {
 7260:          Vector3 ubed;
 7261: 
 7262:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 7263:          // updateBDEF(ubed);
 7264:      
 7265:          // const double bflux0 = dot(ubed, elem_bottom_n);
 7266: 
 7267:          // elem->w[kb] += ubed.z;
 7268:       }
 7269:       else {
 7270: 
 7271:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 7272:   
 7273:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 7274:          // in the direction of motion.
 7275:          const double bottomW = - dot(gradh, u2meanBottom);  
 7276:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 7277: 
 7278:          // VElocity associated to the bed deformation
 7279:          double bedVelocity = 0.0;
 7280:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 7281: 
 7282:          elem->w[kb] = bedVelocity + bottomW; 
 7283: 
 7284:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 7285:          
 7286:       } // if imm
 7287: 
 7288:       // Compute w for kb+1 to nvrt-1
 7289:       for (int l = kb; l < nvrt - 1; l++) {
 7290: 
 7291:          // normal vector to the top face of the "volumetric" element (3D)
 7292:          Vector3 elem_top_n = elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 7293: 
 7294:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 7295:          assert(elem_top_n.z > 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 7296: 
 7297:          // Compute the total flux at the sides
 7298:          double sideFlux = 0.0;
 7299: 
 7300:          for (int j = 0; j < elem->i34; j++) {
 7301:             const Side *side = elem->sides[j];
 7302:             const int kbs = side->kb;
 7303:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 7304:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 7305:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 7306: 
 7307:             // The area is "clamped" meaning that it takes kb into account.
 7308:             const double sideArea = side->areaClamped(l);
 7309: 
 7310:             const double sign = elem->ssign[j]; 
 7311: 
 7312:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 7313:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 7314:          }
 7315:          
 7316:          // Compute the horizontal velocity at the center of the top face as an average of the 
 7317:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 7318:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 7319: 
 7320:          // The flux at the top ace can be computed from the other flows.
 7321:          // All fluxes are in directions into the prism.
 7322:          const double topFlux = - sideFlux - bottomFlux;
 7323: 
 7324:          // Flux at the top face due to the horizontal velocities only
 7325:          // topFlux = topHorizontalFlux + topVerticalFlux
 7326:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 7327: 
 7328:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + sideFlux + bottomFlux = 0, so:
 7329:          const double topVerticalFlux = topFlux - topHorizontalFlux;  
 7330: 
 7331:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 7332: 
 7333:          bottomFlux = -topFlux;
 7334:          
 7335:       }
 7336: 
 7337:    }  
 7338: 
 7339: 
 7340: 
 7341: 
 7342: 
 7343: 
 7344: 
 7345: // !===============================================================================
 7346: // !===============================================================================
 7347: 
 7348: } // extern "C"
 7349: 
 7350: #ifdef DONTCOMPILE
 7351: __device__ void computeVerticalAdvection(void) {
 7352:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 7353: 
 7354:    sdbt(1:2,:,:)=0.d0
 7355: 
 7356:    const Side *side = FROM kernel;
 7357: 
 7358:    if(side->isDry) return;
 7359: 
 7360:    // If side is wet...
 7361: 
 7362: 
 7363:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 7364:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 7365:    double ws[nvrt] = {} // w @ side
 7366:    int icount = 0;
 7367:    for (int j=0; j<2; j++) {
 7368:       const Element *elem = side->elements[j];
 7369:        
 7370:       if(elem != nullptr) {
 7371:          icount++;
 7372:          for (int k=0; k<nvrt; k++) {
 7373:             ws[k] = ws[k] + elem->w[k];
 7374:          }
 7375:       }
 7376:    }  // for j
 7377: 
 7378:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 7379:    ws = ws/icount;
 7380: 
 7381:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 7382:    // Splines allow for a smooth transition between vertical levels.
 7383:    // Splines have continuity restrictions at the internal knots, but
 7384:    // we have to provide the 1st derivatives at the endpoints.
 7385:    const int kbs = side->kbs; 
 7386:    
 7387:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7388:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7389:    initCubicSpline(kbs, nvrt, side, ws, up)
 7390: 
 7391:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7392:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7393:    initCubicSpline(kbs, nvrt, side, ws, vp)
 7394: 
 7395:    // Total advection (average onto side)
 7396:    const Node *node1 = side->nodes[0];
 7397:    const Node *node2 = side->nodes[1];
 7398:    for (int k=kbs(i); k<nvrt; k++) {
 7399: 
 7400:       Vector2 bcc1 = node1->bcc[k];
 7401:       Vector2 bcc2 = node2->bcc[k];
 7402:       if constexpr(ics == 2) {
 7403:          // Project the velocities from the node frames to the side frame
 7404:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 7405:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 7406:       }
 7407: 
 7408:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 7409:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 7410: 
 7411:    }
 7412: }
 7413: #endif
 7414: 
 7415: 
 7416: extern "C" {
 7417:    __global__ void computeElemAverageGhat(void) {
 7418:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 7419: 
 7420:       ELEM(elem);
 7421:       
 7422:       elem->ghat1= {0.0, 0.0};  
 7423: 
 7424:       if constexpr(ihydraulics != 0) {
 7425:          if (nhtblocks > 0 && elem->isblock) return;
 7426:       }
 7427: 
 7428:       
 7429:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 7430:       // cff1-3: coefficients for 2D/3D
 7431: 
 7432:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7433:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7434:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 7435: 
 7436:       if (elem->isDry) return;
 7437: 
 7438:       // Average of the coefficients
 7439:       double av_cff1 = 0.0;  // av. for cff1
 7440:       double av_cff2 = 0.0;  // av. for cff2
 7441:       double av_cff3 = 0.0;  // av. for cff3
 7442:       double av_df = 0.0;  // av. for H^\alpha / H
 7443:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7444:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7445: 
 7446:       const int i34 = elem->i34;
 7447:       const int kb  = elem->kb;
 7448: 
 7449:       for (int j=0; j<i34; j++) {
 7450:          // For each node and side in the element...
 7451: 
 7452:          const Node *node = elem->nodes[j];
 7453:          const Side *side = elem->sides[j];
 7454: 
 7455:          const double chi      = side->chi;
 7456:          const double veg_c2   = side->veg_c2;
 7457:          const double veg_beta = side->veg_beta;
 7458:          const double veg_h    = side->veg_h();
 7459:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7460: 
 7461:          const Vector2 gradPhi = elem->gradPhi[j];
 7462: 
 7463:          // Node - const in elem
 7464:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 7465:          elem->gradPr  += node->pr  *gradPhi;
 7466: 
 7467:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 7468: 
 7469:         
 7470:          const double htot  = side->htot2();        // Total depth at the side
 7471:          const double zctr2 = side->zTopCanopy();  
 7472: 
 7473:          double cff1; 
 7474:          double cff2; 
 7475:          double cff3;   
 7476:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7477:          // coefficients applied to 2D/3D case 
 7478:             cff1 = side->hhat/htot;
 7479:             cff2 = 0.0;
 7480:             cff3 = 0.0;
 7481:          } else { //3D
 7482:             //Init for no-veg case
 7483:             cff1 = 1.0;
 7484:             cff2 = 1.0;
 7485:             cff3 = 0.0;
 7486: 
 7487:             if constexpr(iveg != 0) {
 7488:                // Computes coefficients used with vegetation terms G1, G2
 7489:                // cff1, cff3 are used for the first two terms in G1, G2:
 7490:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7491:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7492:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7493:                if(veg_h < 0.99*htot) { // submergent vegetation
 7494:                   cff1 = 1.0;
 7495:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7496:                   cff3 = veg_c;
 7497: 
 7498:                } else { // emergent vegetation
 7499:                   cff1 = 1.0/(1.0 + veg_c2);
 7500:                   cff2 = cff1;
 7501:                   cff3 = 0.0;
 7502: 
 7503:                }
 7504:             } // if iveg
 7505:          } //  2D/3D
 7506: 
 7507:          av_cff1 += cff1/i34;
 7508:          av_cff2 += cff2/i34;
 7509:          av_cff3 += cff3/i34;
 7510:          av_cff2_chi += cff2*chi/i34;
 7511:          av_cff3_chi += cff3*chi/i34;
 7512:          av_df += min(htot, veg_h)/(htot*i34);
 7513: 
 7514: 
 7515:          // btrack values: U^\star, U^{\star\alpha}
 7516:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7517:          Vector2 Ustar       = {0.0, 0.0}; 
 7518:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7519: 
 7520:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7521:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7522:          } else { //3D
 7523:             for (int k = side->kb + 1; k < nvrt; k++) {
 7524:             
 7525:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7526:                Ustar += w2;
 7527: 
 7528:                if constexpr(iveg != 0) {
 7529:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7530:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7531:                        Ustar_alpha += zrat*w2; // XXXX
 7532:                    }
 7533:                }  // if iveg
 7534:             }  // for k
 7535:          }  //2D/3D
 7536: 
 7537:          // If needed, project the side velocities to the element frame
 7538:          if constexpr(ics==2) {
 7539:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 7540:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 7541:          }
 7542:         
 7543: 
 7544:          // Add btrack & surface stress terms to \breve{G} first
 7545:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7546: 
 7547: 
 7548:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 7549:          Vector2 tau    = side->tau();  
 7550:          Vector2 ubstar = side->btu[side->kb + 1];  
 7551: 
 7552:          // If needed, project tau and ubstar to the element frame
 7553:          if constexpr(ics==2) {
 7554:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 7555:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 7556:          }
 7557: 
 7558:          // Term for surface and bottom stress
 7559:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7560: 
 7561: 
 7562:          // All terms in F,F^\alpha,f_b except baroclinic
 7563:          // F, f_b: all explicit terms excluding vegetation 
 7564:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7565:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7566:          const double coriolis = side->coriolis;
 7567:          Vector2 F  =  coriolis*side->U;  // F_x
 7568:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7569:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7570: 
 7571:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7572:             
 7573:             for (int k = side->kb; k < nvrt; k++) {
 7574:                if (zctr2 > side->zc[k-1]) {
 7575:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7576:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7577:                    Fa +=  coriolis*w2*zrat;
 7578:                } // if zctr2
 7579:             } // k
 7580:          } // iveg
 7581: 
 7582:          // Integrate horizontal viscosity force vertically
 7583:          for (int k=side->kb + 1; k<nvrt; k++) {
 7584:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7585: 
 7586:             F += levelHorVisc;
 7587: 
 7588:             // Vegetation term
 7589:             if constexpr(iveg!=0) {
 7590:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7591:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7592:                   Fa += levelHorVisc*zrat;
 7593:                } 
 7594:             } // if iveg
 7595:          } // for k
 7596: 
 7597:          // Get nu*grad(U) at the side's bottom level
 7598:          Vector2 nuGradU = side->nuGradU[side->kb];
 7599: 
 7600:          fb += nuGradU;
 7601: 
 7602:          // If needed, project vectorsF, fb and Fa to the element frame
 7603:          if constexpr(ics==2) {
 7604:             F    = side->frame.projHorVec(F,    elem->frame);
 7605:             fb   = side->frame.projHorVec(fb,   elem->frame);
 7606:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 7607:          } // if ics
 7608: 
 7609:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7610:       } // for j (nodes and sides)
 7611: 
 7612:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7613: 
 7614: 
 7615:       // Finish off terms in F, F^\alpha and f_b
 7616:       const double grav3 = elem->mean(&Node::grav2);
 7617:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7618:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7619:       for (int j=0; j<i34; j++) { 
 7620:          // For each side in the element...
 7621:          const Side *side = elem->sides[j];
 7622:          const double chi = side->chi;
 7623: 
 7624:          const double htot = side->htot2();
 7625:          const double veg_h = side->veg_h();
 7626:          const Vector2 F  = htot*fb;
 7627:          const Vector2 Fa = min(htot, veg_h)*fb;
 7628: 
 7629:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7630:       } // for j
 7631: 
 7632:       // tmp is already in elem frame
 7633:       elem->ghat1 += tmp/i34;
 7634: 
 7635:       // Baroclinic force
 7636:       if constexpr(ibc==0) {
 7637:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7638: 
 7639:          Vector2 Fa = {0.0, 0.0};
 7640:          Vector2 intGradRho = {0.0, 0.0};
 7641:          
 7642:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 7643:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 7644:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7645: 
 7646:             // \in F [m^2/s/s]
 7647:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7648:          }
 7649: 
 7650:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7651:          const Vector2 F = av_df*Fa; //approx
 7652:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7653: 
 7654:       } // if ibc
 7655: 
 7656: 
 7657: 
 7658:    }
 7659: 
 7660: } // extern "C"
 7661: 
 7662: 
 7663: 
 7664: #ifdef DONTCOMPILE
 7665: __global__ void checkMassConservation(Tracers* sumtr) {
 7666: 
 7667:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7668: 
 7669:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7670: 
 7671:    Element *elem = &(mesh->localElemData[i]);
 7672: 
 7673:    // Skip dry elements
 7674:    if (elem->isDry) return;
 7675: 
 7676:    // Local sum array for this thread
 7677:    double localSum[N_TRACERS] = {0.0};
 7678: 
 7679:    // Sum over vertical levels for this element
 7680:    const int kbe = elem->kbe;
 7681:    const double area = elem->area;
 7682: 
 7683:    for (int k = kbe; k < nvrt; k++) {
 7684:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7685:       
 7686:       // Accumulate tracer mass
 7687:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7688:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7689:       }
 7690:    }
 7691: 
 7692:    //  This function returns per element sums. A reduction must be done on the host side.
 7693: }
 7694: 
 7695: 
 7696: __global__ void transport(void) {
 7697: 
 7698:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7699: 
 7700:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7701: 
 7702:    Element *elem = &(mesh->localElemData[ie]);
 7703: 
 7704:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7705: 
 7706:                for (int m=0; m<ntr; m++) {
 7707:                   for (int k=kbe(ie); k<nvrt; k++) {
 7708:                      // Calculate each polynomial's weight 
 7709:                      wm=0.d0; sum1=0.d0; 
 7710:                      wm1=0.d0; wm2=0.d0; 
 7711:                      for (int i=0; i<elem->nweno2; i++) {
 7712:                   
 7713:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7714:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7715:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7716:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7717:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7718:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7719:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7720:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7721:                      // -----------------Hu and Shu (1999)'s method----------------
 7722:                      b4=b1+b2+b3
 7723: 
 7724: //Error: add PRODUCTION CPP
 7725: #ifdef DEBUG
 7726:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7727:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7728:                     call parallel_abort(errmsg)
 7729:                   }
 7730: #endif
 7731: 
 7732:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7733:                   // !----test-------------- 
 7734:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7735:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7736:                   // !wm(i)=wm1(i)*wm2(i)
 7737:                   // !---------------------- 
 7738:                   sum1=sum1+wm(i)
 7739:                 } // end for i
 7740: 
 7741:                 wm=wm/sum1
 7742: 
 7743:                 for (int j=0; j<elem->i34; j++) {
 7744: 
 7745:                   const Side *side  = elem->sides[j];
 7746:                   const Node *node1 = side->n1;
 7747:                   const Node *node2 = side->n2;
 7748: 
 7749:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7750:                      trsd=0.d0
 7751:                      for (int kk=0; kk<nquad; kk++) {
 7752:                         for (int i=0; i<elem->nweno2; i++) {
 7753:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7754:                         } // end for i   
 7755:                      } // end for kk
 7756:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7757:                   } // outward flux
 7758:                } // end for j=1,i34(ie) ! side
 7759:             }
 7760:          }
 7761:               
 7762: 
 7763: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7764: //             //   calculate each polynomial's weight 
 7765: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7766: //                 wm=0.d0; sum1=0.d0
 7767: //                 do i=1,nweno1(ie) !for each polynomial
 7768: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7769: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7770: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7771: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7772: //                   wm(i)=b2
 7773: //                   sum1=sum1+b2
 7774: //                   !wm(i)=1.d0
 7775: //                   !sum1=sum1+1.d0
 7776: 
