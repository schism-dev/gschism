 5867:    __global__ void computeVerticallyIntegratedVelocity(void) {
 5868: 
 5869:       SIDE(side);
 5870: 
 5871:       side->U = {0.0, 0.0}; 
 5872:          
 5873:       if(side->isDry) return;
 5874: 
 5875:       // Vertically integrated velocity U
 5876:       for (int k = side->kb; k < nvrt - 1; k++) { 
 5877:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 5878:          side->U += side->Dz(k + 1)*uc;  
 5879:       }
 5880: 
 5881:    }
