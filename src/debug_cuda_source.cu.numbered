 2585: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2586: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2587: __inline__ __device__ double  Side::lon(void) const { return 0.5*(n1->lon + n2->lon); }
 2588: __inline__ __device__ double  Side::lat(void) const { return 0.5*(n1->lat + n2->lat); }
 2589: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2590: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2591:    Vector2 grad = {0.0, 0.0};
 2592:    int count = 0;
 2593: 
 2594:    if constexpr(ics == 2) assert(false && "grad2: ics = 2 not implemented");
 2595: 
 2596:    // First element
 2597:    if (elems[0] != nullptr && condition(elems[0])) {
 2598:       grad += elems[0]->grad2(field);
 2599:       count++;
 2600:    }
 2601: 
 2602:    // Second element
 2603:    if (elems[1] != nullptr && condition(elems[1])) {
 2604:       grad += elems[1]->grad2(field);
 2605:       count++;
 2606:    }
 2607: 
 2608:    if (count > 0) {
 2609:       grad = grad/count;
 2610:    }
 2611:    
 2612:    return grad;
 2613: }
