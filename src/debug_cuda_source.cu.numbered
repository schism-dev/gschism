 9692: __global__ void printMatrix(bool full) {
 9693:    // Debugging: print the FEM matrix row for each local node
 9694: 
 9695:    const int size = mesh->np;
 9696:    double sum = 0.0;
 9697: 
 9698:    for (int idx_node = 0; idx_node < size; idx_node++) {
 9699:       const Node *node = mesh->localNodeData + idx_node;
 9700: 
 9701:       if (full)
 9702:          printf("idx_node = %d [%d] diag=%lf, [",
 9703:                 idx_node, node->numNodes, *(node->coeffDiag));
 9704: 
 9705:       // Full CSR row length = numNodes + 1 (includes diagonal)
 9706:       for (int k = 0; k < node->numNodes + 1; k++)
 9707:          sum += node->coeffRow[k];
 9708: 
 9709:       for (int j = 0; j < node->numNodes; j++) {
 9710:          const Node *nbNode = node->nodes[j];
 9711:          const double aij = node->coeffRow[node->csrSlot[j]];
 9712:          if (full && aij != 0.0)
 9713:             printf("%d:%f,  ", nbNode->idx, aij);
 9714:       }
 9715: 
 9716:       if (full) printf("]\n");
 9717:    }
 9718: 
 9719:    if (!full) printf("sum=%lf\n", sum);
 9720: }
