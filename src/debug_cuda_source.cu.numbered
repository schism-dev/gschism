 2106:    template<typename T>
 2107:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 2108:       // Get the values of the field at the nodes of the element
 2109:       res[0] = nodes[0]->*field;
 2110:       res[1] = nodes[1]->*field;
 2111:       res[2] = nodes[2]->*field;
 2112:       if (isQuad()) res[3] = nodes[3]->*field;
 2113:       else          res[3] = T();
 2114:    }
 2115: 
 2116:    template<typename T>
 2117:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 2118: 
 2119:       assert(level < nvrt && "Level is out of range");
 2120:       // Get the values of the field at the nodes of the element
 2121:       res[0] = (nodes[0]->*field)[max(level, nodes[0]->kb)];
 2122:       res[1] = (nodes[1]->*field)[max(level, nodes[1]->kb)];
 2123:       res[2] = (nodes[2]->*field)[max(level, nodes[2]->kb)];
 2124:       if (isQuad()) res[3] = (nodes[3]->*field)[max(level, nodes[3]->kb)];
 2125:       else          res[3] = T();
 2126:    }    
 2127: 
 2128:    template<typename T>
 2129:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
 2130: 
 2131:       assert(level < nvrt && "Level is out of range");
 2132: 
 2133:       // Get the values of the func at the nodes of the element
 2134:       res[0] = (nodes[0]->*func)(max(level, nodes[0]->kb));
 2135:       res[1] = (nodes[1]->*func)(max(level, nodes[1]->kb));
 2136:       res[2] = (nodes[2]->*func)(max(level, nodes[2]->kb));
 2137:       if (isQuad()) res[3] = (nodes[3]->*func)(max(level, nodes[3]->kb));
 2138:       else          res[3] = T();  // This is 0.0 or a zero vector
 2139: 
 2140:    }      
