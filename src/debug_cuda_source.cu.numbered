 2723: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 2724: 
 2725: //       if (delta != 0.0) {
 2726: //          // Solves the two linear equations for tt1 and tt2
 2727: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
