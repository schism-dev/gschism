  986: struct BoundarySegment {
  987: 
  988:    bool isLand;
  989: 
  990:    double clen;  // Length of the boundary segment
  991:    double carea; // Area of the boundary segment
  992: 
  993:    int ifltype;  // Type of flow boundary condition
  994:    
  995:    // Elevation boundary condition
  996:    int iettype;  // Type of elevation boundary condition
  997:    double eth;   // Elevation time history
  998: 
  999:    // Flow boundary condition
 1000:    double qthcon;  // Flow time history constant
 1001:    double vobc1;   // Velocity coefficient 1
 1002:    double vobc2;   // Velocity coefficient 2
 1003: 
 1004:    // Tracer boundary conditions
 1005:    // double trobc[natrm];    // Tracer boundary condition nudging factor
 1006:    // int  itrtype[natrm];    // Tracer boundary condition type
 1007: 
 1008:    BoundarySegment(bool _isLand) {
 1009:       isLand = _isLand;
 1010:       clen = 0.0;
 1011:       carea = 0.0;
 1012:       ifltype = 0;
 1013:       iettype = 0;
 1014:       eth = 0.0;
 1015:    }
 1016: 
 1017:    BoundarySegment(void) {
 1018:       isLand = false;
 1019:       clen = 0.0; 
 1020:       carea = 0.0;
 1021:       ifltype = 0;
 1022:       iettype = 0;
 1023:       eth = 0.0;
 1024:    }
 1025: 
 1026:    
 1027: };
