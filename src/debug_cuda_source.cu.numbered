 6834: //               endif
 6835: 
 6836: //               !psum=0.d0 !sum of modified fluxes for all inflow bnds
 6837: //               do j=1,i34(i)
 6838: //                 jsj=elside(j,i) !side
 6839: //                 iweno=.true. !use weno reconstruction as default
 6840: //                 iel=ic3(j,i) !neighboring elem
 6841: 
 6842: //                 if(iel/=0) then
 6843: //                   if(idry_e(iel)==1) cycle
 6844: //                   trel_tmp_outside(:)=trel_tmp(:,k,iel)
 6845: //                   !reset to upwind; if Element i uses ELM, it will be overwritten by ELM value eventually
 6846: //                   if(iupwind_e(i)+iupwind_e(iel)>0) then
 6847: //                     iweno=.false.
 6848: //                   endif
 6849: //                 else !land or open bnd side
 6850: //                   !skip land bnd and outflowing open bnd, 
 6851: //                   !in this case iweno is not changed from initial value (.true.), but won't be used
 6852: //                   if(isbs(jsj)<=0.or.k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)>=0.d0) then
 6853: //                     !For outflow open bnd side, estimate mass in (open
 6854: //                     !side cannot be interface side)
 6855: //                     if(max_iadjust_mass_consv>0.and.isbs(jsj)>0) then !outflow @open bnd
 6856: //                       h_mass_in(:)=h_mass_in(:)-trel_tmp(1:ntr,k,i)*flux_adv_hface(k,jsj)*dtb
 6857: //                     endif
 6858: 
 6859: //                     cycle
 6860: //                   endif
 6861: 
 6862: //                   !Open bnd side with inflow (must be wet elem) or k<kbs(jsj)+1
 6863: //                   iweno=.false.  !reset to upwind
 6864: //                   ibnd=isbs(jsj) !global bnd #
