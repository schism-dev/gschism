 3376: 
 3377: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3378: 
 3379: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3380:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3381:    if constexpr(ics == 1) { 
 3382:       return 0.5*(n1->tau + n2->tau);
 3383: 
 3384:    } else {
 3385:       // Project the tau from the node frames to the side frame
 3386:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3387:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3388: 
 3389:       return 0.5*(stau1 + stau2);
 3390:    }
 3391: }
 3392: 
 3393: /**
 3394:  * This method performs backtracking from the side center until a time -dt back in time 
 3395:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3396:  * intermediate point.
 3397:  *
 3398:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3399:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3400:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3401:  * remaining time.
 3402:  * 
 3403:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3404:  * 
 3405:  * @param uuint, vvint, wwint: Velocities at the final point
 3406:  * @param jlev: Level at which the backtracking is performed
 3407:  * @param dt, dtbk: Tracking timesteps
 3408:   */
 3409: __inline__ __device__ void Side::btrack(
 3410:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3411:       double dt,            // Tracking time
 3412:       double dtbk,          // Tracking timestep
 3413:       Vector3 &u_int        // Velocities at the initial point
 3414: ) const {
 3415: 
 3416:    // Start from side center
 3417:    Point3 x0;
 3418: 
 3419:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3420:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3421: 
 3422:  
 3423:    double time_rm = dt; // Remaining time
 3424:    double time_rm_1 = 1e10;
 3425:    double time_rm_2 = 2e10;
 3426:    double time_rm_3 = 3e10;
 3427: 
 3428: 
 3429:    // Initial velocities
 3430:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3431: 
 3432:    // Find a non dry element for starting the backtracking. At this point there should be at least one.
 3433:    Element* curElem = (!elems[0]->isDry) ? elems[0] : elems[1];  // elems[0] is always non-null 
 3434: 
 3435:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3436: 
 3437: // showPoints(x0, x0, jlev, this, 0xFF0000u, 'x', 1, 0, 0);
 3438: 
 3439: 
 3440:    constexpr int MAX_ITERATIONS = 100; 
 3441:    int iter = 0;
 3442:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3443:    while(true) {
 3444: 
 3445:       // Calculate timestep
 3446:       const double dtb = min(dtbk, time_rm);
 3447: 
 3448:       // Next point in the backtracking curve
 3449:       xt = x0 - dtb*u_int;
 3450: 
 3451:       double t, s; // parameters for the line segments p0pt and p1p2
 3452:       Side *lastCrossSide = nullptr;
 3453:       const bool found = celestialWalk(curElem, x0, xt, this, lastCrossSide, jlev);
 3454: 
 3455: 
 3456:       if (time_rm_3 <= time_rm) {
 3457:       // If backtracking gets stuck, we stop the backtracking and use the velocity at the last x0.
 3458:          xt = x0;
 3459:          break;
 3460:       }
 3461: 
 3462: 
 3463:       if (!found) {
 3464:       // This means that the walk reached a boundary or a dry element.
 3465: 
 3466:          assert(lastCrossSide!=nullptr && "lastCrossSide is nullptr");
 3467: 
 3468:          // Finds the point at the boundary where the line segment x0xt intersects.
 3469:          // Here we will assume that it does intersect the boundary segment, even if in some cases,
 3470:          // due to floating point errors, it does not exactly intersect.
 3471:          // We call p1 and p2 the 2D points of the boundary segment. p0, pt are the 2D versions of x0 and xt.
 3472:          // v1 is the vector from p0 to pt, v2 is the vector from p1 to p2.
 3473:          // To compute the intersection point we start with the parametric equations.
 3474:          // p1 + t*v2 = p0 + s*v1,    t, s in [0,1]
 3475:          // We cross-prouct by v1 to cancel the s term:
 3476:          // cross(v2, v1)*t = cross(p0 - p1, v1)
 3477:          // t = cross(p0 - p1, v1) / cross(v2, v1)
 3478: 
 3479:          // Side coordinates in the origSide frame.
 3480:          const Point2 p1 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n1->p, lastCrossSide->n1->gz)));
 3481:          const Point2 p2 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n2->p, lastCrossSide->n2->gz)));
 3482: 
 3483:          Point2  p0 = {x0.x, x0.y};
 3484:          Point2  pt = {xt.x, xt.y};
 3485: 
 3486:          const Vector2 v1 = pt - p0;
 3487:          const Vector2 v2 = p2 - p1;
 3488: 
 3489: 
 3490: 
 3491:          // We are assuming intersection, so we clamp t to the range [0,1].
 3492:          const double denom = cross(v2, v1);
 3493:          
 3494: 
 3495: 
 3496: 
 3497:          if (abs(denom) < small) {
 3498:             // small denominators are fairly common. They occur when the line segment x0xt 
 3499:             // is parallel to the boundary segment. This occurs after a "collision" with the
 3500:             // boundary, where the backtracking curve startt sliding along the boundary.
 3501:             // In this case, we simply assume that the two lines are very close to each other
 3502:             // and simply compute the closest point to xt (s = 1.0) on the boundary segment (clamped to p1p2)
 3503:             t = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3504:             if (t<0.0000000001) t = 0.0;
 3505:             if (t>0.9999999999) t = 1.0;
 3506: 
 3507:             // s = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3508:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3509: 
 3510:          }
 3511:          else {
 3512:             
 3513:             t = clamp(cross(p0 - p1, v1) / denom, 0.0, 1.0);
 3514:             if (t<0.0000000001) t = 0.0; // XXXXX use constants
 3515:             if (t>0.9999999999) t = 1.0;
 3516:             // From the originaL equation we can solve for s:
 3517:             // p1 + t*v2 = p0 + s*v1    =>   s*v1 = p1 + t*v2 - p0 
 3518:             // Computing the dot product by v1, we get:
 3519:             // s = dot((p1 + t*v2 - p0), v1) / dot(v1, v1)
 3520:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3521:             if (s<0.0000000001) s = 0.0; // XXXXX use constants
 3522: 
 3523:          }
 3524: 
 3525:          assert(curElem!=nullptr && !curElem->isDry && "curElem is nullptr or dry");
 3526: 
 3527: 
 3528:          // We update the new target point to be right at the intersection point,
 3529:          // and the remaining time must include the time we haven't "used".
 3530:          time_rm -= s*dtb;
 3531:          xt = toPoint3(p1 + t*v2, x0.z + s*(xt.z - x0.z)); // I use p1,p2 to compute the intersection point to ensure that it is on the boundary, but the z-coordinate is the same as x0.z
 3532: 
 3533: 
 3534:          // If it is an open boundary, just exits the loop. No sliding along the boundary is performed.
 3535:          if (lastCrossSide->sideBnd!=nullptr && !lastCrossSide->sideBnd->segment->isLand) break;
 3536: 
 3537:          // If it is not an open boundary, the velocity for the next step is computed by interpolating the velocities at the intersection point.
 3538:          // but extracting only the component along the tangent vector v2.
 3539:          Vector2 tangent = normalize(v2);
 3540:          const Vector3 u = curElem->interpolateVelocities(xt, this);
 3541: 
 3542:          const Vector2 u2D = make_double2(u.x, u.y);
 3543:          u_int = toVector3(dot(u2D, tangent)*tangent, u.z);
 3544: 
 3545: 
 3546:       } else {
 3547: 
 3548:          assert(curElem!=nullptr && !curElem->isDry && "Final element is dry or boundary side");
 3549: 
 3550:          time_rm -= dtb; 
 3551: 
 3552:          u_int = curElem->interpolateVelocities(xt, this);
 3553: 
 3554:       }
 3555: 
 3556:       if (time_rm <= 0.0) break; 
 3557: 
 3558:       // If the velocity is too small, we stop the backtracking
 3559:       const double vmag2 = norm2(toVector2(u_int));
 3560:       if (vmag2 <= velmin_btrack_sq)  {
 3561:          time_rm = 0.0; 
 3562:          return; 
 3563:       }
 3564: 
 3565:       // The current point becomes the next segment's starting point.
 3566:       x0 = xt;
 3567:  
 3568:       iter++;
 3569: 
 3570: // XXXXXXXXXXXXXXXXX
 3571: if (iter == 38) {printf("*****iter = %d, time_rm = %.17f\n", iter, time_rm); return;}
 3572:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3573: 
 3574:       assert(time_rm_3 > time_rm && "time_rm is not decreasing");
 3575:       time_rm_3 = time_rm_2;
 3576:       time_rm_2 = time_rm_1;
 3577:       time_rm_1 = time_rm;
 3578:    }
 3579: 
 3580:    assert(curElem != nullptr && "Final element is nullptr");
 3581:    assert(!curElem->isDry && "Final element is dry");
 3582:    
 3583: 
 3584: 
 3585:    // Interpolate the velocities at the final point with respect to the current side frame
 3586:    u_int = curElem->interpolateVelocities(xt, this);
 3587: 
 3588: 
 3589: }
 3590: 
 3591: 
 3592: 
 3593: 
 3594: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3595: 
 3596: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3597: 
 3598:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3599:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3600: 
 3601:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3602:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3603: 
 3604:    double fun_lat = 0.0;
 3605:    switch (jspc[idxComp]) {
 3606:       case 0:
 3607:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3608:          break;
 3609:       case 1:
 3610:          fun_lat = sin(2.0*lat);
 3611:          break;
 3612:       case 2:
 3613:          fun_lat = pow<2>(cos(lat));
 3614:          break;
 3615:       default:
 3616:          assert(false && "computeETP: invalid jspc");
 3617:    }
 3618:    
 3619:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3620: 
 3621: }
 3622: 
 3623: __device__ void Node::updateKb(void) {
 3624: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3625: 
 3626:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3627: 
 3628: 
 3629:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3630: 
 3631:    if constexpr(ivcor == 2) {  // SZ coordinates
 3632:       
 3633:       // Compute bottom level index
 3634:       if (depth <= mesh->h_s) {
 3635:          kb = izlev;   
 3636:          
 3637:       } else {
 3638:          kb = -1;
 3639:          int L = 0;
 3640:          int R = nzlev; 
 3641:          
 3642:          while (L <= R) {
 3643:             int M = (R + L) / 2;
 3644: 
 3645: 
 3646:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3647:             
 3648:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3649:                R = M;
 3650:             } else {
 3651:                L = M;
 3652:             }
 3653: 
 3654:             if (R - L == 1) {
 3655:                kb = L;
 3656:                break;
 3657:             }
 3658:          }
 3659: 
 3660:          // Checks that the binary search was successful
 3661:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3662:        
 3663:       }
 3664:    } 
 3665: }
