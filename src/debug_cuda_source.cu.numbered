 8101: extern "C" __global__ void getElementVar(int varCode, bool is3D, double *var1, double *var2, int *ivar1, int *ivar2, int k = -1, int j = -1) {
 8102:    // Get the value of a variable from an element
 8103:    // varName is the name of the variable to get
 8104:    // var is the array to store the value
 8105:    // k is the vertical level index of the variable to get
 8106: 
 8107:    ELEM(elem);
 8108:    
 8109:    int idx = elem->idx;
 8110:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8111: 
 8112:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8113:    if      (varCode == (int)VarCode::w)       { var1[idx] = elem->w[k];}
 8114:    else if (varCode == (int)VarCode::z)       { var1[idx] = elem->z[k];}
 8115:    else if (varCode == (int)VarCode::x)       { var1[idx] = elem->center.x; var2[idx] = elem->center.x;}
 8116:    else if (varCode == (int)VarCode::area)    { var1[idx] = elem->area;}
 8117:    else if (varCode == (int)VarCode::depth)   { var1[idx] = elem->depth;}
 8118:    else if (varCode == (int)VarCode::radius)  { var1[idx] = elem->radius;}
 8119:    else if (varCode == (int)VarCode::lonlat)  { var1[idx] = elem->xlon;     var2[idx] = elem->ylat;}
 8120:    else if (varCode == (int)VarCode::ghat)    { var1[idx] = elem->ghat1.x;  var2[idx] = elem->ghat1.y;}
 8121:    else if (varCode == (int)VarCode::kb)      { ivar1[idx] = elem->kb;}
 8122:    else if (varCode == (int)VarCode::ssign && j > -1)  {ivar1[idx] = elem->ssign[j];}
 8123:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 8124:       
 8125:    
 8126: }
 8127: 
 8128: 
 8129: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 8130:    // Get the value of a variable from an node
 8131:    // varName is the name of the variable to get
 8132:    // var is the array to store the value
 8133:    // k is the vertical level index of the variable to get
 8134: 
 8135:    NODE(node);
 8136:    
 8137:    int idx = node->idx;
 8138:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8139: 
 8140:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8141:    
 8142:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 8143:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 8144:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 8145:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 8146:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 8147:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 8148:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;  
 8149:    else if (varCode == (int)VarCode::isdry && k == -1)  var[idx] = node->isDry?1.0:0.0;
 8150:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 8151:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 8152:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 8153:    
 8154:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 8155:       
 8156:    
 8157: }
 8158: 
 8159: 
 8160: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 8161:    // Get the value of a variable from an side
 8162:    // varName is the name of the variable to get
 8163:    // var is the array to store the value
 8164:    // k is the vertical level index of the variable to get
 8165:    SIDE(side);
 8166:    
 8167:    int idx = side->idx;
 8168:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8169: 
 8170:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 8171:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 8172:    // else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 8173:    else if (varCode == (int)VarCode::isdry && k == -1)   var[idx] = side->isDry?1.0:0.0;
 8174:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 8175:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 8176:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 8177:    // else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 8178:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 8179:    // else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 8180:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 8181:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 8182:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 8183:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 8184:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 8185:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 8186:    // else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 8187:    else if (varCode == (int)VarCode::bcc && k >= 0)     var[idx] = side->bcc[k].x;
 8188:    // else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 8189:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 8190:    // else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 8191:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 8192:    // else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 8193:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 8194:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 8195:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 8196:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 8197:    // else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 8198:    // else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 8199:    // else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 8200:    // else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 8201:    // else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 8202:    // else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 8203:    // else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 8204:    // else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 8205:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 8206: }
 8207: 
 8208: 
 8209: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8210:    // Get the value of a variable from an side
 8211:    // varName is the name of the variable to get
 8212:    // var is the array to store the value
 8213:    // k is the vertical level index of the variable to get
 8214:    SIDE_BND(sideBnd);   
 8215: 
 8216:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8217:    if (sideBnd->segment->isLand) idx = -7;
 8218: 
 8219:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8220:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8221: 
 8222: }
