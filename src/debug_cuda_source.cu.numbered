  450: 
  451: __forceinline__ __device__ void computeLatLon(Point3 const &p, double &rlat, double &rlon) {
  452: // Given a 3D global point (may not be on the surface of the Earth), find its longitude and latitude in radians
  453: //
  454: 
  455:    const double radius2 = dot(p, p);
  456:    const double radius = sqrt(radius2);
  457:  
  458:    assert(radius != 0.0      && "computeLatLon: radius = 0");
  459:    assert(p.z*p.z <= radius2 && "computeLatLon: p.z <= radius");
  460: 
  461:    rlon = atan2(p.y, p.x); // (-pi,pi]
  462: 
  463:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  464:       rlat = asin(p.z/radius);
  465:    } else {
  466:       rlat = asin(p.z/rearth_pole);
  467:    }
  468:   
  469: }
  470: 
  471: 
  472: __forceinline__ __device__ Point3 computeXYZfromLatLon(double lat, double lon) {
  473: // Compute the 3D Cartesian coordinates from the latitude and longitude
  474: // Inputs:
  475: //        lat: latitude in radians
  476: //        lon: longitude in radians
  477: // Output:
  478: //        x, y, z: 3D Cartesian coordinates
  479: 
  480:    double sin_lat, cos_lat, sin_lon, cos_lon;
  481: 
  482:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeXYZfromLatLon: lat out of range");
  483:    assert(lon >= -pi     && lon <= pi &&     "computeXYZfromLatLon: lon out of range");
  484: 
  485:    sincos(lat, &sin_lat, &cos_lat);
  486:    sincos(lon, &sin_lon, &cos_lon);
  487: 
  488:    const double x = rearth_eq*cos_lat*cos_lon;
  489:    const double y = rearth_eq*cos_lat*sin_lon;
  490:    const double z = rearth_pole*sin_lat;
  491: 
  492:    return make_double3(x, y, z);
  493: }
