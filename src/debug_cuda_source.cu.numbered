 4935:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4936: 
 4937:       SIDE(side);
 4938: 
 4939: 
 4940:       side->U = {0.0, 0.0}; 
 4941:          
 4942:       if(side->isDry) return;
 4943: 
 4944:       const Node *node1 = side->n1;
 4945:       const Node *node2 = side->n2;
 4946: 
 4947:       // Vertically integrated velocity U (in ll if ics=2)
 4948:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4949:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  
 4950:       }
 4951: 
 4952:    }
 4953: 
 4954:    __global__ void computeBottomDragVegetation(void) {
 4955:       // UNFINISHED. CHECK THIS:
 4956:       // How many kernels are needed? Why so many for loops?
 4957:       // Is the loop on sides needed?
 4958: 
 4959:       NODE(node);
 4960: 
 4961: 
 4962:       const int    kb      = node->kb;
 4963:       const double htot    = node->htot2(); 
 4964:       const double rough   = node->rough;
 4965: 
 4966:       
 4967:       if (node->isDry) {
 4968:          // Default values for dry nodes
 4969:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4970:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4971: 
 4972:          return;
 4973:        
 4974:       }
 4975: 
 4976:       // Compute bottom drag Cd
 4977:       //--------------------------------
 4978: 
 4979:       // nchi = {-1, 0, 1} is the type of bottom drag.
 4980:       if constexpr(nchi == 1) {
 4981: 
 4982:          bool ltmp = false; // for WBL iteration
 4983: 
 4984:          // Cdmax=-1 !max. Cd at node for this process (info only)
 4985:          // Drag at nodes
 4986:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)   XXXXXXXXXXXX
 4987:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 4988:         
 4989:          const double rough = node->rough;
 4990:         
 4991:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4992:          if (node->rough == 0.0) {
 4993:             node->Cd = 0.0;
 4994: 
 4995:          } else { //roughness >0 
 4996:           
 4997:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 4998:             const double bthick = max(dzb_min, bthick_ori);
 4999: 
 5000:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 5001: 
 5002:             double tmp = 1.0/(2.5*log(bthick/rough));
 5003:             node->Cd = tmp*tmp;
 5004: 
 5005:          } // if rough
 5006: 
 5007: 
 5008:          // RECOVER THIS: XXX
 5009:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 5010:          // Output warning for WBL if iteration didn't converge
 5011: 
 5012: 
 5013:       } // nchi==1
 5014: 
 5015: 
 5016:       //   Bottom stress in m^2/s^2
 5017:       if (node->rho[kb + 1] >= -98.0)
 5018:       {
 5019:          const double mag_u = length(node->u2[kb + 1]);
 5020:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5021: 
 5022:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5023:          // !sediment erosion: this part needs more documentation
 5024:       }
 5025:     
 5026: 
 5027: 
 5028:       // Compute vegetation parameters
 5029:       //--------------------------------
 5030: 
 5031:       // SAV constants
 5032:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5033:       constexpr double veg_cfpsi = 0.16;
 5034: 
 5035:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5036:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5037: 
 5038:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5039:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5040:          int kbin = 0; // bin index
 5041:          for (int k = kb; k < nvrt; k++) {
 5042:             // Computes node height above the bottom level
 5043:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5044:             assert(false && "Vertical variation of vegetation not implemented");
 5045: 
 5046:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5047:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5048:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5049:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5050:             // } else {
 5051:             //    // Find the bin at which the current vertical level is
 5052:             //    while (kbin<nbins_veg_vert) {
 5053:             //       const double zn = node->z[kbin];
 5054:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5055:             //          break;
 5056:             //       } // if
 5057:             //       kbin++;
 5058:             //    } // while
 5059:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5060: 
 5061:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5062:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5063:                
 5064:             //    // Linear interpolation of the vegetation parameters
 5065:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5066:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5067:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5068:             // } // if rl10
 5069: 
 5070:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5071: 
 5072:          } // for k
 5073: 
 5074: 
 5075:       } else { // Ganthy (iveg==2)
 5076:       //  Modify canopy height, diameter, and density
 5077: 
 5078:          // Make sure there is vegetation on this node
 5079:          if (node->veg_h_unbent > 0.0) {
 5080:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5081: 
 5082:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5083:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5084:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5085: 
 5086:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5087:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5088:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5089:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5090:          } // if veg_h_unbent
 5091: 
 5092:          for (int k = 0; k < nvrt; k++) {
 5093:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5094:          } // for k
 5095:       
 5096: 
 5097:       } // if iveg
 5098:      
 5099: 
 5100:       // Compute vertical mean of veg_alpha3D
 5101:       if (iveg != 0) {
 5102:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5103:          double sum1=0.0;
 5104:          double sum2=0.0;
 5105:          // Integrate over each level under the canopy...
 5106:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5107:             const double Dz = node->Dz(k);
 5108: 
 5109:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5110:             sum2 += Dz;
 5111: 
 5112:          } // for k
 5113:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5114:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5115: 
 5116:       } // if iveg
 5117: 
 5118:    }
 5119: 
 5120:    __global__ void computeVegetationAndDragParameters(void) {
 5121:       // Computes the vegetation and drag model parameters:
 5122:       // chi, \tilde\chi, beta, \breve{H}
 5123:       
 5124:       SIDE(side);
 5125: 
 5126:       if (side->isDry) return;
 5127: 
 5128:       const double htot = side->htot2();
 5129:       const int    kb   = side->kb;
 5130: 
 5131:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5132: 
 5133:       const double veg_h     = side->veg_h();
 5134:       const double veg_nv    = side->veg_nv();
 5135:       const double veg_c     = side->veg_c();
 5136:       const double veg_beta  = side->veg_beta;
 5137:       const double veg_alpha = side->veg_alpha_vert_mean();
 5138: 
 5139:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 5140:       // Velocity magnitude at the bottom level
 5141:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 5142:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 5143:       side->chi2 = side->Cd()*vmag1;
 5144:       side->chi  = side->chi2;
 5145:       if constexpr(iveg != 0) {
 5146:          const Node *n1 = side->n1;
 5147:          const Node *n2 = side->n2;
 5148:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5149:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5150:       }
 5151: 
 5152:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5153: 
 5154:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5155:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5156:       double magUa = 0.0;
 5157:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 5158:          // 3D wet side with veg...
 5159: 
 5160:          double magUa = 0.0;
 5161:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5162:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5163: 
 5164:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 5165:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 5166:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5167: 
 5168:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5169:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5170: 
 5171:                // Velocity magnitude at the bottom (l) of the level
 5172:                const double ul = length(side->u2[k]);
 5173: 
 5174:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5175:                magUa += Dz*0.5*(uh + ul);
 5176: 
 5177:             } // if HasVegetation
 5178:          } // for k
 5179:          const double ua = magUa/min(htot, veg_h); // Vertical average
 5180: 
 5181:          // Computes beta, used for computing the stress term at the top of the canopy.      
 5182:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 5183:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5184:             const double zCpy = side->zTopCanopy();
 5185:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5186:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5187:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5188:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5189:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5190:          } // if isSubmerged
 5191:       } // if iveg   
 5192: 
 5193:       // Computes the friction modified depth, \breve{H} in notes
 5194:       if (side->is2D()) { // 2D
 5195: 
 5196:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5197:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5198: 
 5199:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5200: 
 5201:          side->hhat = htot*htot/fricH; 
 5202: 
 5203:       } else { // 3D
 5204:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 5205: 
 5206:          if constexpr(iveg != 0) {
 5207:             
 5208:             if (side->isSubmerged()) { 
 5209:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5210:                side->hhat -= veg_c*Hhat_alpha;
 5211: 
 5212:             } else { // Emergent
 5213:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5214:             }
 5215:          } // if iveg
 5216: 
 5217:          // Enforce positivity for 3D model
 5218:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 5219:       } // if 3D
 5220: 
 5221:    }
 5222: 
 5223: 
 5224: 
 5225:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5226:    // Computes the density gradient between two elements, e1 and e2.
 5227:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5228:    // zero in the direction normal to the side. 
 5229:    // 
 5230:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5231:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 5232:    //
 5233:    // Input:
 5234:    //    e1: Element
 5235:    //    e2: Neighbor element (or nullptr if boundary)
 5236:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 5237:    //    k: Index of the half-level at which the density is interpolated
 5238:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 5239:    // 
 5240:    // Output:
 5241:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 5242:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 5243: 
 5244:       if (e2 == nullptr || e2->isDry) {
 5245:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 5246: 
 5247:          Side *side = e1->sides[j];
 5248:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 5249:                  
 5250:          if constexpr(ics == 1) {
 5251:             vec = side->n; // Normal vector to the side
 5252:          } else {
 5253:             // IMPLEMENT THIS XXXXXX
 5254:             // !replace with xel, yel?
 5255:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5256:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5257:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5258:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5259:          } //ics
 5260:                    
 5261:          diffRho = 0.0;
 5262: 
 5263:       } else { //internal and wet
 5264:          if constexpr(ics==1) {
 5265:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5266: 
 5267:             // Vector from e1 to e2
 5268:             vec = e2->center - e1->center;
 5269: 
 5270:          } else { 
 5271:             // IMPLEMENT THIS XXXXXX
 5272:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5273:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5274:             //                   alow(j)=xctr2
 5275:             //                   bdia(j)=yctr2
 5276:          } // ics
 5277: 
 5278:          diffRho = rho2 - e1->demeanedDensity(k);
 5279:       }
 5280: 
 5281:    }
 5282: 
 5283:    __global__ void computeDensityCubicSplines(void) {
 5284:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5285: 
 5286:       ELEM(elem);
 5287: 
 5288:       if (elem->isDry) return;
 5289: 
 5290:       const int kb = elem->kb;
 5291: 
 5292:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5293:       if (elem->is2D()) {
 5294:          // In the 2D case, the density is constant at the prism level. 
 5295:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5296:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5297:       } else { //3D
 5298: 
 5299:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5300:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5301:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5302:          ///// XXXX CHECK INDICES!!!!!
 5303:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5304:       } // 2D/3D
 5305: 
 5306:    }
 5307: } // extern "C"
 5308: 
 5309: 
 5310: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5311: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5312: 
 5313:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5314: 
 5315:    const int kb  = elem->kb;
 5316:    const int kb2 = elem2->kb;
 5317: 
 5318:    // z-coordinate of prism of elem
 5319:    const double zp = elem->z_prism(k);
 5320: 
 5321:    double rho = 0.0;
 5322: 
 5323:    if (elem2->is2D()) {
 5324:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5325: 
 5326:    } else {  // 3D
 5327: 
 5328:       // eta_min may be < zmax
 5329:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5330:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5331: 
 5332:       // (Extrapolate density below bottom, we will fix it later)
 5333:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5334:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5335:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5336:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5337:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5338:    } // 2D/3D
 5339:      
 5340: 
 5341:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5342:    // Now we need to fix it.
 5343:    if (elem->z[k] < elem2->z[kb2]) {
 5344:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5345: 
 5346:       // There are two methods to adjust the density at the bottom of the element.
 5347:       // iunder_deep=0: 
 5348:       const double depth1 = abs(elem->z[kb]); // larger depth
 5349: 
 5350:       if (iunder_deep==0) {
 5351: 
 5352:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5353: 
 5354:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5355: 
 5356:       } else { // iunder_deep != 0
 5357: 
 5358:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5359: 
 5360:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5361: 
 5362:          //   Demeaned density at the same z coordinate as
 5363:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5364:          }
 5365: 
 5366:       } // if iunder_deep
 5367:    } // if elem->z[kb] < elem2->z[kb]
 5368: 
 5369:    return rho;
 5370: }
 5371: 
 5372: 
 5373: extern "C" {
 5374:    __global__ void computeDensityGradient(void) {
 5375: 
 5376:       if constexpr(ibc != 0) return;
 5377: 
 5378:          // Compute the horizontal density gradient at each element.
 5379:       // It works in two steps:
 5380:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5381:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5382:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5383:       //             gradRho.r1 = rho1 - rho0
 5384:       //             gradRho.r2 = rho2 - rho0
 5385:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5386:       // 
 5387:       //  NOTE: We use de-meaned densities.
 5388: 
 5389:       ELEM(elem);
 5390: 
 5391:       if (elem->isDry) return;
 5392: 
 5393:       const int kb  = elem->kb;
 5394:       const int i34 = elem->i34;
 5395: 
 5396:       for (int k = kb + 1; k < nvrt; k++) {
 5397:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5398:          //             gradRho.r1 = rho1 - rho0
 5399:          //             gradRho.r2 = rho2 - rho0
 5400:          int icount = 0;
 5401:          double sumRx = 0.0;
 5402:          double sumRy = 0.0;
 5403:          for (int j1=0; j1<i34; j1++) { 
 5404: 
 5405:             const int j2 = elem->nxq(j1 + 1);
 5406: 
 5407:             // Pairs of consecutive neighbor elements of elem
 5408:             const Element *e1 = elem->nghbElems[j1];
 5409:             const Element *e2 = elem->nghbElems[j2];
 5410: 
 5411:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5412:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5413:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5414: if (elem->idx == 21) printf("$$AAAXXXXXXXA$$$ rho1 = %.16f, rho2 = %.16f\n", rho1, rho2);            
 5415: 
 5416:             // Compute the density difference and the vector from elem to e1 and e2
 5417:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5418:             double diffRho1, diffRho2;
 5419:             Vector2 vec1, vec2;
 5420:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5421:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5422: 
 5423:             const double rl1 = length(vec1);
 5424:             const double rl2 = length(vec2);
 5425:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5426: 
 5427:             const double delta = cross(vec1, vec2);
 5428:             const double sintheta = abs(delta)/(rl1*rl2);
 5429: 
 5430:             // To avoid problems, avoid elements with small angle between vectors
 5431:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5432:             const bool validEq = (sintheta > sin_one_deg);
 5433: 
 5434:             if (validEq) {
 5435:                // Solve the system of equations to get the density gradient at elem
 5436:                icount++;
 5437:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5438:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5439:                sumRx += Rx;
 5440:                sumRy += Ry;
 5441:             }
 5442:          } // for j1
 5443: 
 5444:          // Compute the average density gradient at elem
 5445:          if (icount==0) {
 5446:            // Bad mesh quality; bail out with 0 b-cc
 5447:            elem->gradRho[k] = {0.0, 0.0};
 5448:          } else {
 5449:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5450:          }
 5451: 
 5452:       } // for k
 5453: 
 5454:    }
 5455: 
 5456:    __global__ void computeBaroclinicTerm(void) {
 5457:    // Computes the baroclinic term at sides (at half levels).
 5458:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5459:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5460: 
 5461:       if (ibc == 1) return;
 5462: 
 5463:       SIDE(side);
 5464: 
 5465:       if (side->isDry) return;
 5466: 
 5467:       const Element *e1 = side->elems[0];
 5468:       const Element *e2 = side->elems[1];      
 5469:       const int kb = side->kb;
 5470:       
 5471:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5472: 
 5473:       // interpolates vertically the density gradient of the two elements at the half level/
 5474: 
 5475:       int k1 = max(kb, nvrt / 2);
 5476:       int k2 = max(kb, nvrt / 2);
 5477: 
 5478:       // Starts the integration at the surface and goes down to the bottom
 5479:       side->bcc[nvrt-1] = {0.0, 0.0};
 5480:       for (int k = nvrt - 2; k >= kb; k--) {
 5481:       // For each prism level (from surface to bottom)...
 5482: 
 5483:          // For both elements, interpolate density gradient at the side's half level.
 5484:          // The gradient at the side is the average of the gradients at the elements.
 5485:          // w1, w2 are used to take into account boundary sides, with just one element.
 5486:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5487:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5488:          const double wsum = w1 + w2;
 5489:          w1 = w1/wsum;
 5490:          w2 = w2/wsum;
 5491:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5492: 
 5493:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5494:          Vector2 gradRho = {0.0, 0.0};
 5495:          if (e1 != nullptr && k > kb) {
 5496:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5497:             
 5498:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5499:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5500:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5501: printf("###### k1 = %d, side->idx = %d, zc[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, zrat = %.16f\n",
 5502:       k1, side->idx, k, side->zc[k], k1, e1->z[k1], k1 + 1, e1->z[k1 + 1], e1->gradRho[k1].x, e1->gradRho[k1].y, zrat);            
 5503:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5504:          }      
 5505:          if (e2 != nullptr && k > kb) {
 5506:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5507:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5508:             
 5509:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5510:          }
 5511: 
 5512:          if constexpr(ics==2) {
 5513:             assert(false && "Not implemented: ics == 2");
 5514:             // IMPLEMENT THIS XXXXXX
 5515:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5516:             // swild(1)=tmp1
 5517:             // swild(2)=tmp2
 5518:          }
 5519:          
 5520:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5521:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5522:          // CHECK INDICES!!! XXX
 5523:          const double grav3 = side->grav3();
 5524:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5525: 
 5526:       } // for
 5527: 
 5528:    }
 5529: 
 5530: 
 5531: 
 5532:    __global__ void computeHorGradientAtSide(void) {
 5533: 
 5534:       // Compute the horizontal density gradient at each element.
 5535:       // It works in two steps:
 5536:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5537:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5538:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5539:       //             gradRho.r1 = rho1 - rho0
 5540:       //             gradRho.r2 = rho2 - rho0
 5541:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5542:       // 
 5543:       //  NOTE: We use de-meaned densities.
 5544: 
 5545:       SIDE(side);
 5546: 
 5547: // printf("side->isDry: %d\n", side->isDry);
 5548:       if (side->isDry) return;
 5549: 
 5550:       // Computes the gradient of the variables at the side center.
 5551:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5552:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5553:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 5554: 
 5555:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5556:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5557:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5558:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5559: 
 5560: 
 5561:    }
 5562: 
 5563: 
 5564:    __global__ void solveMomentumEquations(double time) {
 5565: 
 5566:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5567:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5568: 
 5569:       SIDE(side);
 5570: 
 5571:       if (side->isDry) 
 5572:       {
 5573:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 5574: 
 5575:          return;
 5576:       }
 5577: 
 5578:       const Node *n1 = side->n1;
 5579:       const Node *n2 = side->n2;
 5580: 
 5581:       const int kb = side->kb;
 5582: 
 5583:       const double veg_h = side->veg_h();
 5584:       const double grav3 = side->grav3();
 5585: 
 5586:       if (side->is2D()) {
 5587:          // Warning: Do not use htot2, which is updated.
 5588:          const double htot = side->htot1();
 5589:          const double hhat = side->hhat;
 5590: 
 5591:          // assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5592: 
 5593:          Vector2 tau2 = {0.0, 0.0};
 5594:           
 5595:          if constexpr(ics==1) {
 5596:             tau2 = side->tau();
 5597: 
 5598:          } else {
 5599:             assert(false && "Not implemented: ics == 2");
 5600:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5601:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5602:             // taux2=(vn1+tt1)*0.5d0
 5603:             // tauy2=(vn2+ss1)*0.5d0
 5604:          } // if ics         
 5605: 
 5606:          // hat_gam has units of m/s
 5607: 
 5608:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5609: 
 5610:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5611:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5612: 
 5613:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5614: 
 5615: 
 5616:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 5617:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 5618: 
 5619:          for (int k = 0; k < nvrt; k++) side->u2[k] = {ux, uy};
 5620: 
 5621: 
 5622:       }
 5623:       else { // 3D
 5624: 
 5625:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5626:          // 
 5627:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5628:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5629:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5630:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5631:          // k+1 and k.
 5632: 
 5633: 
 5634:    
 5635: 
 5636: 
 5637:          const int ndim = nvrt - kb;
 5638:          const double zTopCanopy = side->zTopCanopy();
 5639: 
 5640:          // Initialize the tridiagonal system
 5641:          for (int k = kb + 1; k < nvrt; k++) {
 5642:             
 5643:             const int kin = k - (kb + 1);
 5644: 
 5645:             // Vertical viscosity at the face center
 5646:             const double dfz = 1e-6; //0.5*(side->dfv(k) + side->dfv(k + 1)); XXXXX
 5647:            
 5648: 
 5649:             alow[kin] = 0.0;
 5650:             cupp[kin] = 0.0;
 5651:             bdia[kin] = 0.0;
 5652: 
 5653:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5654:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5655: 
 5656:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5657:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5658:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5659: 
 5660:             // First part: layers k, k+1
 5661:             if (k < nvrt - 1) {
 5662:                              
 5663:                if constexpr(iveg != 0) {
 5664: 
 5665:                   // If there is vegetation at this level...
 5666:                   if (zTopCanopy > side->zc[k]) {
 5667:                      // If the canopy is above the k layer...
 5668:                      
 5669:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5670:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5671:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5672:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5673: 
 5674:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5675:                      const double vmag2 = length(ut2);
 5676:                      const double vmag1 = length(side->u2[k]);
 5677:                      const double vmag = 0.5*(vmag1 + vmag2);
 5678:                      
 5679:                      // Computes the vegetation alpha at the face center
 5680:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5681: 
 5682:                      cff1 += veg_alpha_sd*dt*vmag;
 5683: 
 5684:                   } // if (zTopCanopy
 5685:                } // if iveg
 5686: 
 5687:                const double dzz = side->Dz(k + 1);
 5688:                const double tmp = dt*dfz/dzz;
 5689:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5690: 
 5691:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5692:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5693:             }
 5694: 
 5695: 
 5696:             // Second part: layers k-1, k
 5697:             if (k > kb + 1) {
 5698: 
 5699:                double cff1 = 1.0; //init \bar{c^k}
 5700: 
 5701:                if constexpr(iveg != 0) {
 5702:                   // If there is vegetation at this level...
 5703:                   if (zTopCanopy > side->zc[k-1]) {
 5704:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5705:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5706: 
 5707:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5708: 
 5709:                      const double vmag2 = length(ut2);
 5710:                      const double vmag1 = length(side->u2[k-1]);
 5711:                      const double vmag = 0.5*(vmag1 + vmag2);
 5712: 
 5713:                      // Computes the vegetation alpha at the face center
 5714:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5715:                      cff1 += veg_alpha_sd*dt*vmag;
 5716:                   } // if zTopCanopy
 5717: 
 5718:                } // if iveg
 5719: 
 5720:                const double dzz = side->Dz(k);
 5721:                const double tmp = dt*dfz/dzz;
 5722:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5723: 
 5724:                alow[kin] += cff1*dzz/6.0 - tmp;
 5725:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5726: 
 5727:             } else { // Bottom boundary
 5728:                // This occurs at the bottom, where the bottom drag is applied.
 5729: 
 5730:                bdia[kin] += dt*side->chi2; // XXXX
 5731: 
 5732: 
 5733:             } // if (k > kb + 1)
 5734: 
 5735: 
 5736: 
 5737:          } // for (int k
 5738: 
 5739: 
 5740: 
 5741:          // Computes the RHS.
 5742:          // -----------------
 5743: 
 5744:          //	BC to be imposed at the end.
 5745: 
 5746:          const Vector2 gradETP  = side->gradETP;
 5747:          const Vector2 gradPr   = side->gradPr;
 5748:          const Vector2 gradEta1 = side->gradEta1;
 5749:          const Vector2 gradEta2 = side->gradEta2;
 5750: 
 5751:          const Vector2 *btu = side->btu;
 5752:          const Vector2 *u2  = side->u2;
 5753:          const double coriolis = side->coriolis;
 5754:          const Vector2 *nuGradU = side->nuGradU;
 5755: 
 5756: 
 5757:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5758: 
 5759:          for (int k = kb + 1; k < nvrt; k++) {
 5760:             const int kin = k - kb - 1;
 5761: 
 5762:             const double dz_0 = side->Dz(k);
 5763:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5764: 
 5765:             rrhs[kin] = {0.0, 0.0};
 5766:             double dz = 0.0;
 5767: 
 5768:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5769:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5770:             if (k < nvrt  ) dz += dz_1;
 5771:             if (k > kb + 1) dz += dz_0;
 5772: 
 5773:             // Elevation gradient, atmospheric pressure and tidal potential
 5774:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5775: 
 5776:             // Coriolis, advection, wind stress, and horizontal viscosity
 5777:             if (k < nvrt - 1) {
 5778: 
 5779: 
 5780:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5781:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5782:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5783:                                                 
 5784: // if (side->idx == 21) printf("$$BBBB$$$ dz_1 = %.16f, coriolis = %.16f, btu[%d] = %.16f, %.16f, u2[%d] = %.16f, %.16f, nuGradU[%d] = %.16f, %.16f\n", dz_1, coriolis, k, btu[k].x, btu[k].y, k, u2[k].x, u2[k].y, k, nuGradU[k].x, nuGradU[k].y);            
 5785:                //diff stress tensors 1006
 5786:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5787:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5788:                   assert(false && "Not implemented: itur == 5");
 5789:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5790:                }
 5791: 
 5792:             } else { // k == nvrt - 1 SURFACE
 5793:                Vector2 tau2 = {0.0, 0.0};
 5794:                if constexpr(ics==1) {
 5795:                   tau2 = side->tau();
 5796:       
 5797:                } else {
 5798:                   assert(false && "Not implemented: ics == 2");
 5799:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5800:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5801:                   // taux2=(vn1+tt1)*0.5d0
 5802:                   // tauy2=(vn2+ss1)*0.5d0
 5803:                } // if ics
 5804: 
 5805:                rrhs[kin] += dt*tau2;
 5806: 
 5807:             } // if k<nvrt
 5808: 
 5809:             if (k > kb + 1) {
 5810:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5811:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5812:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5813: 
 5814:                // diff stress tensors 1006
 5815:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5816:                   assert(false && "Not implemented: itur == 5");
 5817:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5818:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5819:                }
 5820: 
 5821:             } // if k>kbs + 1
 5822: 
 5823:             // Baroclinic
 5824:             Vector2 *bcc = side->bcc;
 5825:             if constexpr(ibc == 0) {
 5826:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5827:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5828: 
 5829:             } // if ibc==0
 5830: 
 5831:          } // k=kb + 1,nvrt
 5832: 
 5833: 
 5834:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5835: 
 5836:          for (int k = kb + 1; k < nvrt; k++) {  // YYYYYYYYY can be kb 
 5837:             const int kin = k - kb - 1;
 5838: 
 5839:             // Velocity is always clamped to maximum values
 5840:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5841:          } // k
 5842: 
 5843:       } // if side->is2D()
 5844:       
 5845: 
 5846:       // Impose velocity boundary condition at the bottom
 5847:       if constexpr(imm == 2) { // 3D bed deformation model
 5848:          double dep;
 5849:          Vector2 vel;
 5850: 
 5851:          assert(false && "Not implemented: imm == 2");
 5852:          //update_bdef(time, x0, y0, dep, vel);
 5853:          // side->u2[kb] = vel;
 5854: 
 5855:       } else { // imm = 0 or 1
 5856:          if (side->Cd() == 0.0) {
 5857:             side->u2[kb] = side->u2[kb + 1];
 5858: 
 5859:          } else if (side->is3D()) { // 3D no slip bottom   
 5860:             side->u2[kb] = {0.0, 0.0};
 5861:          }
 5862:           
 5863:       } // if imm
 5864: 
 5865:       // The velocities below the bottom level are set to zero
 5866:       for (int k = 0; k <= kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5867: 
 5868: 
 5869:    }
 5870: 
 5871: 
 5872:    __global__ void applyMomentumBC(void) {
 5873: 
 5874:       SIDE_BND(sideBnd);
 5875: 
 5876:       Side *side = sideBnd->side;
 5877:       const BoundarySegment *segment = sideBnd->segment;
 5878:       const Node *n1 = side->n1;
 5879:       const Node *n2 = side->n2;
 5880: 
 5881:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5882: 
 5883:       const bool isLand = segment->isLand;
 5884:       const int ifltype = segment->ifltype;
 5885: 
 5886:       const int kb = side->kb;
 5887: 
 5888:       if (!isLand && ifltype != 0) {
 5889:          const Vector2 *ubc = sideBnd->ubc;
 5890:   
 5891:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5892:             
 5893:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5894:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5895: 
 5896:             if (ifltype == -1) {
 5897:                // Flather 1
 5898: 
 5899:                const double depth = side->depth();
 5900: 
 5901:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5902: 
 5903:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5904: 
 5905:                side->u2[k] = vnorm*side->n;
 5906: 
 5907:             } else if (ifltype == -2) { // Discharge
 5908: 
 5909:                const double eta1 = side->eta1();
 5910:                const double eta2 = side->eta2();
 5911:                const double htot = side->htot2();
 5912: 
 5913:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5914:                assert(false && "Not implemented: Discharge bc");
 5915:                // const double dischrg = discharge(eta1);
 5916:                const double dischrg = 0.0; // XXX REMOVE
 5917:                
 5918: 
 5919:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5920: 
 5921:                const double vnorm = dischrg*eta2/htot;
 5922: 
 5923:                side->u2[k] = vnorm*side->n;
 5924: 
 5925:             }
 5926:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5927:                const double vnorm = dot(side->u2[k], side->n);
 5928: 
 5929:                double rat;
 5930:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5931:                else              rat = segment->vobc2; // outgoing
 5932: 
 5933:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5934: 
 5935:             }
 5936:             else { // not Flather or 3D radiation
 5937:                side->u2[k] = ubc[k];
 5938: 
 5939:             } // if (segment->ifltype...
 5940: 
 5941:          }
 5942: 
 5943:       }
 5944:       else if (isLand) { // if it is land boundary side
 5945: 
 5946:          if constexpr(islip == 0) { // free slip
 5947: 
 5948:             for (int k = kb; k < nvrt; k++) {
 5949: 
 5950:                const Vector2 t = side->t();
 5951:                const Vector2 n = side->n;
 5952: 
 5953:                double vnorm = 0.0; // for most cases
 5954:                const double vtan = dot(side->u2[k], t);
 5955:                
 5956:                side->u2[k] = vtan*t - vnorm*n;
 5957: 
 5958:             }
 5959: 
 5960:          } else { // no slip
 5961:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5962: 
 5963:          }
 5964:       } // if (side segment type...
 5965: 
 5966:    
 5967: 
 5968:    }
 5969: 
 5970: 
 5971:    __global__ void shapiroFilter1(void) {
 5972:       // First step of the Shapiro filter (normally used if indvel<=0)
 5973:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5974: 
 5975:       SIDE(side);
 5976: 
 5977:       // Only internal wet sides are processed
 5978:       if (side->isDry || !(side->isInternal())) return;
 5979: 
 5980:       const int kb = side->kb;
 5981: 
 5982:       for (int mm = 0; mm < niter_shap; mm++) {
 5983: 
 5984:          for (int k = kb + 1; k < nvrt; k++) {
 5985:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5986:             Vector2 suru = {0.0, 0.0};
 5987: 
 5988:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5989: 
 5990:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5991: 
 5992:                int kin = k;
 5993:                if (!(nSide->isDry)) kin = max(k, kb + 1);
 5994:                
 5995:                if constexpr(ics==1) {
 5996:                   suru += nSide->u2[kin];
 5997: 
 5998:                } else {
 5999:                   assert(false && "Not implemented: ics == 2");
 6000:                   // Vector2 vn1, vn2;
 6001:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 6002:                   // suru=suru+vn1;
 6003:                   // surv=surv+vn2;
 6004:                }
 6005:             }
 6006: 
 6007: 
 6008:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 6009: 
 6010:          }
 6011:       }
 6012:    }
 6013: 
 6014:    __global__ void shapiroFilter2(void) {
 6015:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6016: 
 6017:       SIDE(side);
 6018: 
 6019:       if (side->isDry || !(side->isInternal())) return;
 6020: 
 6021:       const int kb = side->kb;
 6022: 
 6023:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6024: 
 6025:       if (side->is2D()) {
 6026:          side->u2[kb + 1] = side->bcc[kb + 1];
 6027:          side->u2[kb    ] = side->u2 [nvrt - 1];
 6028: 
 6029:       } else {
 6030:          // 3D
 6031:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6032:          
 6033:       }
 6034: 
 6035:    }
 6036: 
 6037: 
 6038:    __global__ void ul0UpdateZCoords(void) {
 6039:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6040:       
 6041:       NODE(node);      
 6042: 
 6043: 
 6044:       if (node->isDry2()) { 
 6045: 
 6046:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6047: 
 6048:          if constexpr(ivcor != 1) node->kb = 0;
 6049: 
 6050:       } else {
 6051: 
 6052:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6053:          node->updateKb();
 6054: 
 6055:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6056: 
 6057:       }
 6058: 
 6059:       // We use the temp.b field to store the previous state of isDry.
 6060:       node->tmp.b = node->isDry;
 6061: 
 6062:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6063:       node->isDry = true;
 6064: 
 6065:    }
 6066: 
 6067:    __global__ void ul0ComputeDryElementsAndNodes(void)
 6068:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 6069:    {
 6070:       ELEM(elem);
 6071: 
 6072:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 6073: 
 6074:       // All the nodes of a wet element are wet.
 6075:       if (!elem->isDry) {
 6076:          elem->nodes[0]->isDry = false;
 6077:          elem->nodes[1]->isDry = false;
 6078:          elem->nodes[2]->isDry = false;
 6079:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 6080: 
 6081:       }
 6082: 
 6083: 
 6084:       elem->kb = 0;
 6085: 
 6086:       if (elem->isDry) return;
 6087: 
 6088:       // Wet
 6089:       const Node *n1 = elem->nodes[0];
 6090:       const Node *n2 = elem->nodes[1];
 6091:       const Node *n3 = elem->nodes[2];  
 6092:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 6093: 
 6094:    //    if(elem->isDry2()) { // XXXX
 6095:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6096:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6097:    //        call parallel_abort(errmsg)
 6098:    //    }
 6099: 
 6100: 
 6101:       // Computes element's kb as the minimum of the nodes' kb.
 6102:       const int kb1 = n1->kb;
 6103:       const int kb2 = n2->kb;
 6104:       const int kb3 = n3->kb;
 6105:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 6106: 
 6107: 
 6108:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6109: 
 6110: 
 6111:       // Computes the element z as the mean of the nodes z.
 6112:       for (int k = elem->kb; k < nvrt; k++) {
 6113: 
 6114:          // Compute the element z as the mean of the nodes z.
 6115:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 6116:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6117:          elem->z[k] /= elem->i34;
 6118: 
 6119:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 6120:       }
 6121:                   
 6122:    }
 6123: 
 6124:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6125:    {
 6126:       NODE(node);
 6127:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6128: 
 6129:       if (it == iths) return;
 6130: 
 6131: 
 6132:       if(!node->isDry && node->tmp.b) { // rewetted
 6133:          for (int k=0; k < nvrt; k++) {
 6134: 
 6135:             Vector3 utmp={0.0, 0.0, 0.0};
 6136: 
 6137:             double ttmp=0.0;
 6138:             double stmp=0.0;
 6139:             int icount=0;
 6140:             for (int j = 0; j < node->numNodes; j++) {
 6141: 
 6142: 
 6143:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 6144:                if (!node->isDry) { // all indices extended
 6145:                   icount++;
 6146: 
 6147:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6148:                   utmp += node->uvw2(k);
 6149:                   
 6150:                   ttmp += node->tracers[k].tracer[0]; 
 6151:                   stmp += node->tracers[k].tracer[1]; 
 6152:                }
 6153:             }
 6154: 
 6155:             if(icount > 0) {
 6156:                const double inv_icount = 1.0/icount;
 6157:                node->u2[k]     = {inv_icount*utmp.x, inv_icount*utmp.y};
 6158:                node->w2[k]     = inv_icount*utmp.z;
 6159:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6160:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6161:             }
 6162:          }
 6163:       }
 6164:    }
 6165: 
 6166: 
 6167:    __global__ void ul0UpdateSides(int it, int iths) {
 6168: 
 6169:       SIDE(side);
 6170: 
 6171:       // A side is wet if and only if at least one of its elements is wet.
 6172:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6173: 
 6174:       const Node *n1 = side->n1;
 6175:       const Node *n2 = side->n2;
 6176:       const int kb1 = n1->kb;
 6177:       const int kb2 = n2->kb;
 6178: 
 6179:       side->kb = 0; // dry
 6180: 
 6181:       if (isWet) {
 6182: 
 6183:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6184: 
 6185:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6186: 
 6187:          side->kb = min(kb1, kb2);
 6188: 
 6189:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6190: 
 6191:          for (int k = side->kb; k < nvrt; k++) {
 6192:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6193: 
 6194:          
 6195:             assert(((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0)) && "Weird side (3)");
 6196: 
 6197:             // Compute velocity for re-wetted sides 
 6198:             if ((it != iths) && (side->isDry && isWet)) {
 6199:             
 6200:                Vector2 utmp={0.0, 0.0};
 6201: 
 6202:                int icount=0;
 6203: 
 6204:                // For all the sides on the two elements that share this side
 6205:                for (int j=0; j < 2; j++) {
 6206:                   const Element *elem = side->elems[j];
 6207:                   if (elem == nullptr) continue;
 6208: 
 6209:                   for (int jj=0; jj < elem->i34; jj++) {
 6210:                      const Side *nSide = elem->sides[jj];
 6211:                      if (nSide->isDry) continue;
 6212: 
 6213:                      icount++;
 6214:                      utmp += nSide->u2[k];                     
 6215:                   }
 6216:                }
 6217:                   
 6218:                assert(icount > 0 && "No wet sides around this side");
 6219:                if (icount > 0)  side->u2[k] = utmp/icount;
 6220:                   
 6221:             } // if ((it != iths) && (side->isDry && isWet))
 6222: 
 6223:          } // for k
 6224: 
 6225:       } // if isWet
 6226:    
 6227:       side->isDry = !isWet;
 6228: 
 6229:    }
 6230: 
 6231: 
 6232:    __global__ void zeroNodalVelocities(void) {
 6233:       NODE(node);
 6234: 
 6235:       for (int k = 0; k < nvrt; k++) {
 6236:          node->u2[k]   = {0.0, 0.0};
 6237:          node->w2[k]   = 0.0;
 6238:          node->utmp[k] = {0.0, 0.0};
 6239:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6240:       }
 6241:    }
 6242: 
 6243:  
 6244: 
 6245:    __global__ void computeNodalVerticalVelocities1(void) {
 6246:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6247:    // Adds the element's vertical velocity times the element's area.
 6248:       ELEM(elem);
 6249: 
 6250:       for (int j = 0; j < elem->i34; j++) {
 6251:          Node *node = elem->nodes[j];
 6252: 
 6253:          for (int k = node->kb; k < nvrt; k++) {
 6254:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6255:          }
 6256:          atomicAdd(&(node->tmp.d), elem->area);
 6257:       }
 6258:    }
 6259: 
 6260:    __global__ void computeNodalVerticalVelocities2(void) {
 6261:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6262:    // Divides by the total area of the elements sharing the    node.
 6263:       NODE(node);
 6264: 
 6265:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 6266:    }
 6267: 
 6268: 
 6269:    __global__ void computeNodalHorizontalVelocities1(void) {
 6270:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6271:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 6272: 
 6273:       ELEM(elem);
 6274: 
 6275:       const int kb = elem->kb;
 6276:       const bool isTri = elem->isTri();
 6277: 
 6278:       if constexpr(indvel <= 0) {
 6279:          // Assuming discontinoius hvel.
 6280: 
 6281: 
 6282:          if (isTri) { // For triangles
 6283:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6284:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6285: 
 6286:             for (int j = 0; j < 3; j++) {
 6287:                // For every node of the triangle...
 6288:                Node *node = elem->nodes[j];
 6289: 
 6290:                const Side *s1 = elem->sides[j];
 6291:                const Side *s2 = elem->sides[(j + 1) % 3];
 6292:                const Side *s3 = elem->sides[(j + 2) % 3];
 6293: 
 6294:                const int numElements = node->numElements;
 6295:                const double inv_numElements = 1.0/numElements;
 6296: 
 6297:                for (int k = kb; k < nvrt; k++)  {
 6298:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated at the node   
 6299:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 6300:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 6301:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 6302:                   atomicAdd(&(node->utmp[k].x), inv_numElements * u.x);
 6303:                   atomicAdd(&(node->utmp[k].y), inv_numElements * u.y);
 6304: 
 6305:                }
 6306: 
 6307:             }
 6308:          }
 6309:          else { // For quads
 6310:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6311: 
 6312:          }
 6313: 
 6314:       }
 6315:       
 6316:    }
 6317: 
 6318: 
 6319:    __global__ void computeNodalHorizontalVelocities2(void) {
 6320:       NODE(node);
 6321: 
 6322:       for (int k = 0; k < nvrt; k++) {
 6323:          node->u2[k] = node->utmp[k];
 6324:          node->w2[k] = node->w2[k];
 6325:       }
 6326:       
 6327:    }   
 6328: 
 6329:    __global__ void computeNodalHorizontalVelocitiesOLD(void) {
 6330:    // XXXX I'm not sure where I got this function from. 
 6331:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 6332:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 6333:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 6334:    // It uses the utmp array as a temporary array to store the velocities.
 6335: 
 6336:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 6337: 
 6338:       SIDE(side);
 6339: 
 6340:       const int kb = side->kb;
 6341: 
 6342:       Node *n1 = side->n1;
 6343:       Node *n2 = side->n2;
 6344: 
 6345:       for (int k = kb; k < nvrt; k++) {
 6346: 
 6347:          // Cast the u2 vector into a Vector2 
 6348:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&(n1->utmp[k]));
 6349:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&(n2->utmp[k]));
 6350: 
 6351:          n1_u2 = side->u2[k]/n1->numSides;
 6352:          n2_u2 = side->u2[k]/n2->numSides;
 6353: 
 6354:       }
 6355: 
 6356: 
 6357:    }
 6358: 
 6359:    __global__ void resetVelocityOpenBndNodes(void) {
 6360:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6361: 
 6362:       NODE_BND(nodebnd);
 6363: 
 6364:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6365:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }
 6366:       }
 6367: 
 6368:    }
 6369: 
 6370: 
 6371:    __global__ void setVelocityOpenBndNodes(void) {
 6372:    // For open boundary nodes sets their velocity to the imposed values.
 6373: 
 6374:       SIDE_BND(sidebnd);
 6375: 
 6376:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6377:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6378:          // to its segment to the average of the side velocity.
 6379: 
 6380:          for (int k = 0; k < nvrt; k++) {
 6381:             Node *n1 = sidebnd->side->n1;
 6382:             Node *n2 = sidebnd->side->n2;
 6383: 
 6384: 
 6385:             Vector2 n1_u2(n1->u2[k]);
 6386:             Vector2 n2_u2(n2->u2[k]);
 6387: 
 6388:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6389:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6390:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6391:             }
 6392:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6393:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6394:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6395:             }
 6396: 
 6397:          }
 6398: 
 6399:       }
 6400: 
 6401:    }
 6402: 
 6403: 
 6404:    __global__ void computeVerticalVelocity(void) {
 6405:       // Computes the vertical velocity at the (2D) element's centroid.
 6406:       // In this function we will be considering volumetric elements, with side faces and a 
 6407:       // bottom and a top face. We will call them SFs, BF and TF.
 6408:       // It computes the flux coming from BF and the SFs.
 6409:       // If the bed is moving, it takes that into account.
 6410:       // Since water is incompressible, the integral of the velocity times the normal vector
 6411:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6412:       // and the BF is equal to the flux going out from the TF.
 6413:       // TF = - BF - sum(SFs).
 6414:       // It then computes the horizontal velocity at the center of TF.
 6415:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6416:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6417:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6418: 
 6419:       ELEM(elem);
 6420: 
 6421:       if (elem->isDry) return;
 6422: 
 6423:       const int kb = elem->kb;
 6424:       const bool isTri = elem->isTri();
 6425: 
 6426:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6427: 
 6428:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6429:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6430:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6431: 
 6432:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6433: 
 6434:       double area3D;
 6435: 
 6436:       // Bottom face flux
 6437:       double bottomFlux = 0.0;
 6438:       Vector2 u2meanBottom = {0.0, 0.0};
 6439:       const Vector2 gradh = elem->grad2(&Node::depth);
 6440:       if constexpr(imm==2) {
 6441:          Vector3 ubed;
 6442: 
 6443:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6444:          // updateBDEF(ubed);
 6445:      
 6446:          // const double bflux0 = dot(ubed, elem_n1);
 6447: 
 6448:          // elem->w[kb] += ubed.z;
 6449:       }
 6450:       else {
 6451:          Vector2 umean;
 6452:          if constexpr(ics == 1) {
 6453:             u2meanBottom = elem->mean(kb, &Side::u2);
 6454:          }
 6455:          else {
 6456:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6457:          }
 6458: 
 6459:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6460:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6461: 
 6462:          bottomFlux = - dot(gradh, u2meanBottom);
 6463:       } // if imm
 6464: 
 6465:       // Compute w for kb+1 to nvrt-1
 6466:       for (int l = kb; l < nvrt - 1; l++) {
 6467: 
 6468:          // normal vector to the top face of the "volumetric" element (3D)
 6469:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6470: 
 6471:          // Compute the total flux at the sides
 6472:          double sideFlux = 0.0;
 6473:          Vector2 u2top = {0.0, 0.0};
 6474:          for (int j = 0; j < elem->i34; j++) {
 6475:             const Side *side = elem->sides[j];
 6476: 
 6477:             const double sideArea = side->area(l);
 6478:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6479:             const double sign = elem->ssign[j]; 
 6480: 
 6481:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6482:          }
 6483:          
 6484:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6485:          //velocities at the centers of the sides
 6486:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6487: 
 6488:          // The flx at the top ace can be computed from the other flows.
 6489:          const double topFlux = - sideFlux - bottomFlux;
 6490:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6491: 
 6492:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6493: 
 6494:          elem_n1 = elem_n2;
 6495: 
 6496:          bottomFlux = - topFlux;
 6497:       }
 6498:    }  
 6499: 
