  605: 
  606: template<TurbulenceModel Model>
  607: struct Turbulence {
  608:    __device__ void setDiffLimits(double, double) { assert(false && "setDiffLimits does not exist for this turbulence model"); }
  609: };   
  610: 
  611: // GLS turbulence model
  612: template<>
  613: struct Turbulence<TurbulenceModel::GLS> {
  614:    using enum TurbulenceSubmodel;
  615:    using enum StabilityModel;
  616: 
  617:    double tke[nvrt];    // TKE
  618:    double mxl[nvrt];    // mixing length for GLS
  619:    double nu_tke[nvrt]; // Vertical diffusivity for TKE 
  620:    double nu_phi[nvrt]; // Vertical diffusivity for generic length scale variable (phi)
  621: 
  622:    double diffmin;  // from diffmin.gr3
  623:    double diffmax;  // from diffmax.gr3
  624:    
  625:    __device__ void setDiffLimits(double lo, double hi) {
  626:       diffmin = lo;
  627:       diffmax = hi;
  628:    }
  629: 
  630: 
  631:    __device__ __forceinline__ constexpr double cpsi1() const {
  632:       if      constexpr (turbSubmodel == MellorYamada)   return 0.9;
  633:       else if constexpr (turbSubmodel == KL)             return 0.9;
  634:       else if constexpr (turbSubmodel == KE)             return 1.44;
  635:       else if constexpr (turbSubmodel == KW)             return 0.555;
  636:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.0;
  637:       else { assert(false && "unknown submodel"); return 0.0; }
  638:    }
  639: 
  640:    
  641:    __device__ __forceinline__ constexpr double cpsi2() const {
  642:       // Returns coefficient cpsi2 for the dissipation term in the GLS turbulence model
  643:       if      constexpr (turbSubmodel == MellorYamada)   return 0.5;
  644:       else if constexpr (turbSubmodel == KL)             return 0.5;
  645:       else if constexpr (turbSubmodel == KE)             return 1.92;
  646:       else if constexpr (turbSubmodel == KW)             return 0.833;
  647:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.22;
  648:       else { assert(false && "unknown submodel"); return 0.0; }
  649:    }
  650: 
  651: 
  652:    __device__ __forceinline__ double Fwall(Node *node, int k, double mxl_c) const;
  653: 
  654:    __device__ __forceinline__ double cpsi3(double N2) const {
  655: 
  656:       // Returns coefficient cpsi3 for the buoyancy production/dissipation term in the GLS turbulence model
  657:       // Remember that N2 is the signed square of the Brunt-Väisälä frequency
  658: 
  659:       if constexpr(icompute_cpsi3 != 0) { assert(false && "compute_cpsi3 not implemented for icompute_cpsi3!=0"); return 0.0; }
  660: 
  661:       if constexpr (turbSubmodel == MellorYamada) {
  662:          return 0.9;   
  663: 
  664:       } else { // Other GLS submodels
  665: 
  666: 
  667:          if (N2 > 0.0) { // unstable (inverse stratification)
  668:             return 1.0;   
  669: 
  670:          } else { // stable (regular stratification)
  671: 
  672:             if      constexpr (turbSubmodel == KL)             return 2.53;
  673:             else if constexpr (turbSubmodel == KE)             return -0.52;
  674:             else if constexpr (turbSubmodel == KW)             return -0.58;
  675:             else if constexpr (turbSubmodel == UmlaufBurchard) return  0.1;
  676:             else { assert(false && "unknown submodel"); return 0.0; }
  677:          }
  678: 
  679:       } //if constexpr (turbSubmodel == TurbulenceSubmodel::MY)
  680: 
  681:    }
  682: 
  683:    
  684:    __device__ __forceinline__ constexpr double rpub(void) const {
  685:       if      constexpr (turbSubmodel == MellorYamada)   return  0.0;
  686:       else if constexpr (turbSubmodel == KL)             return  0.0;
  687:       else if constexpr (turbSubmodel == KE)             return  3.0;
  688:       else if constexpr (turbSubmodel == KW)             return -1.0;
  689:       else if constexpr (turbSubmodel == UmlaufBurchard) return  2.0;
  690:       else { assert(false && "unknown submodel"); return 0.0; }
  691:    }
  692: 
  693: 
  694:    __device__ __forceinline__ constexpr double rmub(void) const {
  695:       if      constexpr (turbSubmodel == MellorYamada)   return 1.0;
  696:       else if constexpr (turbSubmodel == KL)             return 1.0;
  697:       else if constexpr (turbSubmodel == KE)             return 1.5;
  698:       else if constexpr (turbSubmodel == KW)             return 0.5;
  699:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.0;
  700:       else { assert(false && "unknown submodel"); return 0.0; }
  701:    }
  702: 
  703: 
  704:    __device__ __forceinline__ constexpr double rnub(void) const {
  705:       if      constexpr (turbSubmodel == MellorYamada)   return  1.0;
  706:       else if constexpr (turbSubmodel == KL)             return  1.0;
  707:       else if constexpr (turbSubmodel == KE)             return -1.0;
  708:       else if constexpr (turbSubmodel == KW)             return -1.0;
  709:       else if constexpr (turbSubmodel == UmlaufBurchard) return -0.67;
  710:       else { assert(false && "unknown submodel"); return 0.0; }
  711:    }
  712: 
  713: 
  714:    __device__ __forceinline__ constexpr double schk(void) const {
  715:       if      constexpr (turbSubmodel == KL)             return 2.44;
  716:       else if constexpr (turbSubmodel == KE)             return 1.0;
  717:       else if constexpr (turbSubmodel == KW)             return 2.0;
  718:       else if constexpr (turbSubmodel == UmlaufBurchard) return 0.8;
  719:       else { assert(false && "schk not set for this submodel"); return 0.0; }
  720:    }
  721: 
  722: 
  723:    __device__ __forceinline__ constexpr double schpsi(void) const {
  724:       if      constexpr (turbSubmodel == KL)             return 2.44;
  725:       else if constexpr (turbSubmodel == KE)             return 1.3;
  726:       else if constexpr (turbSubmodel == KW)             return 2.0;
  727:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.07;
  728:       else { assert(false && "schpsi not set for this submodel"); return 0.0; }
  729:    }
  730: 
  731: 
  732:    __device__ __forceinline__ constexpr double tkemin(void) const {
  733:       if constexpr (turbSubmodel == MellorYamada || turbSubmodel == KL)
  734:          return 5.0e-6;
  735:       else
  736:          return 7.6e-6; // Warner et al., OM 2005
  737:    }
  738: 
  739: 
  740:    __device__ __forceinline__ constexpr double psimin(void) const {
  741:       if constexpr (turbSubmodel == MellorYamada || turbSubmodel == TurbulenceSubmodel::KL)
  742:          return 1.0e-8;
  743:       else
  744:          return 1.0e-12; // Warner et al., OM 2005
  745:    }
  746: 
  747:    __device__ __forceinline__ constexpr double epsmin(void) const {
  748:       return 1.0e-12;  // GOTM/SCHISM default; floor for dissipative length cap
  749:    }
  750: 
  751:    __device__ __forceinline__ double mxlmin(double depth) const;
  752: 
  753:    
  754:    __device__ __forceinline__ double N2_c(Node *node, int k) const;
  755: 
  756:    __device__ __forceinline__ double N2(Node *node, int k) const;
  757: 
  758: 
  759:    __device__ __forceinline__ double vegTurbProduction(Node *node, int k) const;
  760: 
  761:    __device__ void computeDiffusivities(Node *node);
  762: 
  763:    __device__ __forceinline__ double maxMixingLength(Node *node, int k) const;
  764: 
  765: 
  766:    // Conversions between the generic length-scale variable Phi and the mixing length mxl.
  767:    __device__ __forceinline__ double phiFromMxl(double tke, double mxl) const {
  768:       return pow(cmiu0, rpub()) * pow(tke, rmub()) * pow(mxl, rnub());
  769:    }
  770: 
  771: 
  772:    __device__ __forceinline__ double mxlFromPhi(double tke, double phi) const {
  773:       return pow(phi * pow(cmiu0, -rpub()) * pow(tke, -rmub()), 1.0/rnub());
  774:    }
  775: 
  776: };
