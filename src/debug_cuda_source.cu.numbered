 8088:                                          double *node_coords, double *node_coords_ll, bool use_ll,
 8089:                                          double *wind_rotate_angle,   
 8090:                                          int *isdel, int *isidenode, int *isbnd,
 8091:                                          int *nond, int *nlnd, int *iond, int *ilnd,                                  
 8092:                                          int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 8093:                                          int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 8094:                                          int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 8095:                                          int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 8096:                                          int *localNodePart,     int *localElemPart,     int *localSidePart,
 8097:                                          double *drag, double *roughness) {
 8098:    mesh->populateSides(i34, sharedIdxSideBoundary,
 8099:                        node_coords, node_coords_ll, use_ll,
 8100:                        wind_rotate_angle,   
 8101:                        isdel, isidenode, isbnd,
 8102:                        nond, nlnd, iond, ilnd,                                  
 8103:                        nodeNeighNodesStart, nodeNeighNodesIndices, nodeNeighElemsStart, nodeNeighElemsIndices, globalNodeIndices, globalElemIndices, globalSideIndices, localNodeIndices, localElemIndices, localSideIndices, localNodePart, localElemPart, localSidePart, drag, roughness);                          
 8104: 
 8105: }
