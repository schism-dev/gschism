 6184: extern "C" {
 6185: 
 6186:    __global__ void scaleGravity(double loadtide_coef) {
 6187: 
 6188: 
 6189:       NODE(node);
 6190: 
 6191:       // SAL option: scale gravity
 6192:       if constexpr(iloadtide==2) {  // simple const
 6193:          node->grav2 = grav*(1.0 - loadtide_coef);
 6194: 
 6195:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 6196:         
 6197:           const double depth = max(node->depth, 0.0);
 6198:           const double tmp1 = sqrt(depth);
 6199:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 6200:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 6201:                              2.6969e-13*depth*depth*depth*tmp1;
 6202:           
 6203:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 6204:           
 6205: 
 6206: 
 6207:           node->grav2 = grav*(1.0 - beta_bar);
 6208: 
 6209:       } else {  // iloadtide=0,1
 6210:           node->grav2 = grav;
 6211: 
 6212:       }
 6213: 
 6214:    }
 6215: 
 6216: 
 6217:    __global__ void setWinds(double *xWind, double *yWind, double *pressAir) {
 6218:       NODE(node);
 6219: 
 6220:       const int idx = node->idx;
 6221:       Vector2 wind = {xWind[idx], yWind[idx]};
 6222: 
 6223:       if constexpr(nws != 0 && iwindoff != 0) {
 6224:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 6225:       }
 6226: 
 6227:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 6228:       node->setWind(wind);
 6229: 
 6230:       node->pr = pressAir[idx];
 6231:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 6232: 
 6233:    }
 6234: 
 6235:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 6236: 
 6237:       NODE(node);
 6238: 
 6239:       node->ETP = 0.0;
 6240: 
 6241:       if constexpr(ntip == 0) return;
 6242: 
 6243:       // For all tidal potential components
 6244:       for (int j=0; j<ntip; j++) {
 6245: 
 6246:          const double nodeETP = node->computeETP(j, time, tfreq, tamp, tnf, tear, jspc);
 6247: 
 6248:          node->ETP += nodeETP;
 6249: 
 6250:          if constexpr(iloadtide==1) { // loading tide
 6251:             assert(false && "Loading tide not implemented");
 6252:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 6253:          }
 6254:          
 6255:       }
 6256: 
 6257:      
 6258:    }
