 3395: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3396: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3397: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3398: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3399: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3400: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3401: __inline__ __device__ Point3  Side::p3_t(double t) const { return {x(t), y(t), z(t)}; }
 3402: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3403: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3404: // Computes the gradient of the field at the side center.
 3405:    Vector2 grad = {0.0, 0.0};
 3406:    int count = 0;
 3407: 
 3408:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3409:    // as the average of the gradients at each element.
 3410:    // First element
 3411:    if (elems[0] != nullptr && condition(elems[0])) {
 3412:       Vector2 elemGrad = elems[0]->grad2(field);
 3413: 
 3414:       // For ics=2, projects the element gradient from its frame to the side frame
 3415:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3416: 
 3417:       grad += elemGrad;
 3418: 
 3419:       count++;
 3420:    }
 3421: 
 3422:    // Second element
 3423:    if (elems[1] != nullptr && condition(elems[1])) {
 3424: 
 3425:       Vector2 elemGrad = elems[1]->grad2(field);
 3426: 
 3427:       // For ics=2, projects the element gradient from its frame to the side frame
 3428:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3429: 
 3430:       grad += elemGrad;
 3431: 
 3432:       count++;
 3433:    }
 3434: 
 3435:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3436:    if (count > 0) {
 3437:       grad = grad*(1.0/count);
 3438:    }
 3439:    
 3440:    return grad;
 3441: }
