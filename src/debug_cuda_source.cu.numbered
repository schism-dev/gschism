 1655: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1656:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1657: }
 1658: 
 1659: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1660:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1661: }   
 1662: 
 1663: __device__ __inline__ double min3(double a, double b, double c) {
 1664:    return min(a, min(b, c));
 1665: }
 1666: 
 1667: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1668:    return min(a, min(b, min(c, d)));
 1669: }
