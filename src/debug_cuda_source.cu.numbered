  211: // Simple math functions ---------------------------------------------------------------------------
  212: 
  213: __device__ __forceinline__ void solveQuadratic(double A, double B, double C, double &x1, double &x2) {
  214: // Solves the quadratic equation A*x^2 + B*x + C = 0 and returns the two solutions in x1 and x2.
  215: // Outputs:
  216: //        x1: first solution
  217: //        x2: second solution
  218: 
  219:        // Use float-specific absolute value for speed on GPU
  220:     const double absA = fabs(A);
  221:     const double absB = fabs(B);
  222: 
  223:     // 1. Near-linear case: a is effectively 0.
  224:     // We use a small epsilon to prevent division by zero and handle degenerate quads.
  225:     // This branch is almost never taken, so it won't hurt performance.
  226:     if (absA < 1e-14 * (absB + 1e-30)) {
  227:         const double x = -C / B;
  228:         x1 = x;
  229:         x2 = x;
  230:         return;  // Degenerate case: A = 0.
  231:     }
  232: 
  233:    const double delta = max(0.0, B*B - 4.0*A*C);
  234: 
  235:    assert(delta >= 0.0 && "solveQuadratic: negative discriminant");
  236:    const double s = sqrt(delta);
  237: 
  238:    // Numerically stable quadratic roots:
  239:    // q = -0.5*(B + sign(B)*sqrt(delta))
  240:    const double q = -0.5 * (B + copysign(s, B));
  241: 
  242:    x1 = q/A;
  243:    x2 = (fabs(q) > 1e-30) ? (C/q) : x1;   // Moving predicate.
  244: 
  245: }
