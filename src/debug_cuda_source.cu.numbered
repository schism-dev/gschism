 7528:          break;
 7529:       case (int)VarCode::eta:
 7530:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 7531:          *sizeType = sizeof(double);
 7532:          break;
 7533:       case (int)VarCode::x:
 7534:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 7535:          *sizeType = sizeof(Vector2);
 7536:          break;
 7537:       case (int)VarCode::z:
 7538:          *offset = (int)((char*)&nodes[0].z[0] - (char*)nodes);
 7539:          *sizeType = sizeof(double);
 7540:          break;
 7541:       case (int)VarCode::kb:
 7542:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 7543:          *sizeType = sizeof(int);
 7544:          break;
 7545:       case (int)VarCode::isdry:
 7546:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 7547:          *sizeType = sizeof(int);
 7548:          break;         
 7549:       case (int)VarCode::w:
 7550:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 7551:          *sizeType = sizeof(double);
 7552:          break;
 7553:       case (int)VarCode::u:
 7554:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 7555:          *sizeType = sizeof(Vector2);
 7556:          break;         
 7557:       default:
 7558:          *offset = -1;    
 7559:    }  
 7560:    
 7561: }
