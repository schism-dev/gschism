 8371: extern "C" __global__ void getElementVarFunc(int varCode, double *res) {
 8372: 
 8373:    ELEM(elem);
 8374: 
 8375:    switch (varCode) {
 8376:       case (int)VarCode::outputCoords:
 8377:          const Point2 coords = elem->outputCoords();
 8378:          res[elem->idx*2    ] = coords.x;
 8379:          res[elem->idx*2 + 1] = coords.y;
 8380:          break;
 8381:    }
 8382: }
