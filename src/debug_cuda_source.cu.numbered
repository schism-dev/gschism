 6977: __global__ void printMatrix(void) {
 6978: 
 6979: 
 6980:    // Let only one thread per block print at a time 
 6981: 
 6982:    if (threadIdx.x == 0) {
 6983:       for (int ithread = 0; ithread < blockDim.x; ithread++) {
 6984:          const int idx_node = ithread + blockIdx.x * blockDim.x;
 6985:          if (idx_node >= mesh->np) return;
 6986:          const Node *node = mesh->localNodeData + idx_node;
 6987:          printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 6988:          for (int j = 0; j < node->numNodes; j++) {
 6989:             Node* nbNode = node->nodes[j];
 6990:             if (node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 6991:          }
 6992:          printf("]\n");
 6993: 
 6994:       }
 6995:    }
 6996: 
 6997: 
 6998: 
 6999: }
 7000: 
 7001: 
 7002: __global__ void computeMatrixProductAndDotProducts() {
 7003:    // Computes A*p, r'Mr and p'Ap
 7004: 
 7005:    // 1) shared buffer: first half for rMr, second for pAp
 7006:    __shared__ double sdata[2*BLOCK_SIZE];
 7007:    double* s_rMr = sdata;
 7008:    double* s_pAp = sdata + BLOCK_SIZE;
 7009: 
 7010:    s_rMr[threadIdx.x] = 0.0;
 7011:    s_pAp[threadIdx.x] = 0.0;
 7012: 
 7013:    // 2) get your node pointer
 7014:    NODE(node);  
 7015:    const int tid = threadIdx.x;
 7016: 
 7017:    const double diag = node->coeffDiag;
 7018:    const double r    = node->mR;
 7019:    const double p    = node->mP;  
 7020: 
 7021:    // apply preconditioner on the fly:
 7022:    const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7023: 
 7024:    // 4) compute Ap = A.p
 7025:    double Ap = node->coeffDiag * node->mP;
 7026:    for (int j = 0; j < node->numNodes; ++j) {
 7027:       const Node *nbNode = node->nodes[j];
 7028:       Ap += node->coeffMatrix[j] * nbNode->mP;
 7029: 
 7030:    }
 7031:    node->mAp = Ap;
 7032:     
 7033: 
 7034:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 7035:    const double l_rMr = r*Mr;  // r'Mr
 7036:    const double l_pAp = p*Ap;  // p'Ap
 7037: 
 7038:    // 6) write into shared mem
 7039:    s_rMr[tid] = l_rMr;
 7040:    s_pAp[tid] = l_pAp;
 7041: 
 7042:    __syncthreads();
 7043: 
 7044:    // 7) block-wide tree reduction
 7045:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7046:       if (tid < stride)  s_pAp[tid] += s_pAp[tid + stride];
 7047:       __syncthreads();
 7048:    }
 7049: 
 7050:    // 8) thread 0 atomically accumulates into the globals
 7051:    // XXX: This is slower than it needs to be, but it is simple and works
 7052:    if (tid == 0) atomicAdd(pAp, s_pAp[0]);
 7053: 
 7054: 
 7055: }
 7056: 
 7057: 
 7058: __global__ void updateSolutionAndDotProducts(void) {
 7059:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7060: 
 7061:    s_rMr[threadIdx.x] = 0.0;
 7062: 
 7063: 
 7064:    // get node & bounds-check:
 7065:    NODE(node);
 7066:    const int tid = threadIdx.x;
 7067: 
 7068: 
 7069:    // Compute alpha
 7070:    const double alpha = (*rMr_old)/(*pAp);
 7071: 
 7072:    // load scalars
 7073:    const double diag = node->coeffDiag;
 7074:    const double p    = node->mP;
 7075:    const double Ap   = node->mAp;
 7076:    const double x    = node->mX;
 7077:    const double r    = node->mR;
 7078:    
 7079:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7080: 
 7081:    // 1) update solution & residual
 7082:    const double x_new = x + alpha*p;
 7083:    const double r_new = r - alpha*Ap;
 7084:    node->mX = x_new;
 7085:    node->mR = r_new;
 7086: 
 7087:    // 2) apply Jacobi preconditioner on the fly
 7088:    const double Mr_new = r_new/diag;
 7089: 
 7090: 
 7091:    // 3) local contributions for the two dot-products
 7092:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7093: 
 7094:    // 4) write into shared-mem
 7095:    s_rMr[tid] = l_rMr;
 7096: 
 7097:    __syncthreads();
 7098: 
 7099: 
 7100:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7101:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7102:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7103:       __syncthreads();
 7104:    }
 7105: 
 7106:    // 6) thread 0 atomically folds into the global accumulators
 7107:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7108: 
 7109: 
 7110: }
 7111: 
 7112: 
 7113: __global__ void updateSearchDirection() {
 7114:     NODE(node);
 7115: 
 7116:     // recompute z on-the-fly
 7117:     const double z = node->mR / node->coeffDiag;
 7118:     const double p = node->mP;
 7119: 
 7120:     const double beta = (*rMr_new)/(*rMr_old);
 7121: 
 7122: // printf("ZZZ updateSearchDirection: beta = %f\n", beta);
 7123: 
 7124:     // p =z + beta*p
 7125:     node->mP = z + beta*p;
 7126: 
 7127: }
 7128: 
 7129: __global__ void initializePreconditionedResidual(double *scalars) {
 7130: 
 7131:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 7132: 
 7133:     s_rMr[threadIdx.x] = 0.0;
 7134: 
 7135:     NODE(node);
 7136:     const int tid = threadIdx.x;
 7137:     // For the first iteration:
 7138:     // 1. Initial solution x = 0 (already set)
 7139:     // 2. Initial residual r = b (stored in qel)
 7140:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7141: 
 7142: // XXX we should use the guess solution here    
 7143: 
 7144:     // Set initial residual r = b (from qel)
 7145:     node->mR = node->qel;
 7146: 
 7147:     // Compute z = M^-1 * r (preconditioned residual)
 7148:     const double z = node->mR / node->coeffDiag;
 7149: 
 7150:     // Set initial search direction p = z
 7151:     node->mP = z;
 7152: 
 7153:     // Initialize other variables needed for CG
 7154:     node->mX = 0.0;  // Initial solution
 7155:     node->mAp = 0.0; // Will be computed in first iteration
 7156: 
 7157:     // These point to a cupy array in the host code
 7158:     rMr_old = scalars + 0;
 7159:     rMr_new = scalars + 1;
 7160:     pAp     = scalars + 2;
 7161: 
 7162:     // Computes the first r'Mr (reduction)
 7163:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7164: 
 7165:     // 4) write into shared-mem
 7166:     s_rMr[tid] = l_rMr;
 7167: 
 7168:     __syncthreads();
 7169: 
 7170: 
 7171:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7172:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7173:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7174:         __syncthreads();
 7175:     }
 7176: 
 7177:     // 6) thread 0 atomically folds into the global accumulators
 7178:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7179: 
 7180:     *rMr_old = 0.0;
 7181:     *pAp = 0.0;
 7182: }
