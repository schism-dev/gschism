 7202: #ifdef DONTCOMPILE
 7203: __device__ void computeVerticalAdvection(void) {
 7204:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 7205: 
 7206:    sdbt(1:2,:,:)=0.d0
 7207: 
 7208:    const Side *side = FROM kernel;
 7209: 
 7210:    if(side->isDry) return;
 7211: 
 7212:    // If side is wet...
 7213: 
 7214: 
 7215:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 7216:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 7217:    double ws[nvrt] = {} // w @ side
 7218:    int icount = 0;
 7219:    for (int j=0; j<2; j++) {
 7220:       const Element *elem = side->elements[j];
 7221:        
 7222:       if(elem != nullptr) {
 7223:          icount++;
 7224:          for (int k=0; k<nvrt; k++) {
 7225:             ws[k] = ws[k] + elem->w[k];
 7226:          }
 7227:       }
 7228:    }  // for j
 7229: 
 7230:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 7231:    ws = ws/icount;
 7232: 
 7233:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 7234:    // Splines allow for a smooth transition between vertical levels.
 7235:    // Splines have continuity restrictions at the internal knots, but
 7236:    // we have to provide the 1st derivatives at the endpoints.
 7237:    const int kbs = side->kbs; 
 7238:    
 7239:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7240:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7241:    initCubicSpline(kbs, nvrt, side, ws, up)
 7242: 
 7243:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7244:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7245:    initCubicSpline(kbs, nvrt, side, ws, vp)
 7246: 
 7247:    // Total advection (average onto side)
 7248:    const Node *node1 = side->nodes[0];
 7249:    const Node *node2 = side->nodes[1];
 7250:    for (int k=kbs(i); k<nvrt; k++) {
 7251: 
 7252:       Vector2 bcc1 = node1->bcc[k];
 7253:       Vector2 bcc2 = node2->bcc[k];
 7254:       if constexpr(ics == 2) {
 7255:          // Project the velocities from the node frames to the side frame
 7256:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 7257:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 7258:       }
 7259: 
 7260:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 7261:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 7262: 
 7263:    }
 7264: }
 7265: #endif
 7266: 
 7267: 
 7268: extern "C" {
 7269:    __global__ void computeElemAverageGhat(void) {
 7270:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 7271: 
 7272:       ELEM(elem);
 7273:       
 7274:       elem->ghat1= {0.0, 0.0};  
 7275: 
 7276:       if constexpr(ihydraulics != 0) {
 7277:          if (nhtblocks > 0 && elem->isblock) return;
 7278:       }
 7279: 
 7280:       
 7281:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 7282:       // cff1-3: coefficients for 2D/3D
 7283: 
 7284:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7285:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7286:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 7287: 
 7288:       if (elem->isDry) return;
 7289: 
 7290:       // Average of the coefficients
 7291:       double av_cff1 = 0.0;  // av. for cff1
 7292:       double av_cff2 = 0.0;  // av. for cff2
 7293:       double av_cff3 = 0.0;  // av. for cff3
 7294:       double av_df = 0.0;  // av. for H^\alpha / H
 7295:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7296:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7297: 
 7298:       const int i34 = elem->i34;
 7299:       const int kb  = elem->kb;
 7300: 
 7301:       for (int j=0; j<i34; j++) {
 7302:          // For each node and side in the element...
 7303: 
 7304:          const Node *node = elem->nodes[j];
 7305:          const Side *side = elem->sides[j];
 7306: 
 7307:          const double chi      = side->chi;
 7308:          const double veg_c2   = side->veg_c2;
 7309:          const double veg_beta = side->veg_beta;
 7310:          const double veg_h    = side->veg_h();
 7311:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7312: 
 7313:          const Vector2 gradPhi = elem->gradPhi[j];
 7314: 
 7315:          // Node - const in elem
 7316:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 7317:          elem->gradPr  += node->pr  *gradPhi;
 7318: 
 7319:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 7320: 
 7321:         
 7322:          const double htot  = side->htot2();        // Total depth at the side
 7323:          const double zctr2 = side->zTopCanopy();  
 7324: 
 7325:          double cff1; 
 7326:          double cff2; 
 7327:          double cff3;   
 7328:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7329:          // coefficients applied to 2D/3D case 
 7330:             cff1 = side->hhat/htot;
 7331:             cff2 = 0.0;
 7332:             cff3 = 0.0;
 7333:          } else { //3D
 7334:             //Init for no-veg case
 7335:             cff1 = 1.0;
 7336:             cff2 = 1.0;
 7337:             cff3 = 0.0;
 7338: 
 7339:             if constexpr(iveg != 0) {
 7340:                // Computes coefficients used with vegetation terms G1, G2
 7341:                // cff1, cff3 are used for the first two terms in G1, G2:
 7342:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7343:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7344:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7345:                if(veg_h < 0.99*htot) { // submergent vegetation
 7346:                   cff1 = 1.0;
 7347:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7348:                   cff3 = veg_c;
 7349: 
 7350:                } else { // emergent vegetation
 7351:                   cff1 = 1.0/(1.0 + veg_c2);
 7352:                   cff2 = cff1;
 7353:                   cff3 = 0.0;
 7354: 
 7355:                }
 7356:             } // if iveg
 7357:          } //  2D/3D
 7358: 
 7359:          av_cff1 += cff1/i34;
 7360:          av_cff2 += cff2/i34;
 7361:          av_cff3 += cff3/i34;
 7362:          av_cff2_chi += cff2*chi/i34;
 7363:          av_cff3_chi += cff3*chi/i34;
 7364:          av_df += min(htot, veg_h)/(htot*i34);
 7365: 
 7366: 
 7367:          // btrack values: U^\star, U^{\star\alpha}
 7368:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7369:          Vector2 Ustar       = {0.0, 0.0}; 
 7370:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7371: 
 7372:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7373:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7374:          } else { //3D
 7375:             for (int k = side->kb + 1; k < nvrt; k++) {
 7376:             
 7377:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7378:                Ustar += w2;
 7379: 
 7380:                if constexpr(iveg != 0) {
 7381:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7382:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7383:                        Ustar_alpha += zrat*w2; // XXXX
 7384:                    }
 7385:                }  // if iveg
 7386:             }  // for k
 7387:          }  //2D/3D
 7388: 
 7389:          // If needed, project the side velocities to the element frame
 7390:          if constexpr(ics==2) {
 7391:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 7392:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 7393:          }
 7394:         
 7395: 
 7396:          // Add btrack & surface stress terms to \breve{G} first
 7397:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7398: 
 7399: 
 7400:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 7401:          Vector2 tau    = side->tau();  
 7402:          Vector2 ubstar = side->btu[side->kb + 1];  
 7403: 
 7404:          // If needed, project tau and ubstar to the element frame
 7405:          if constexpr(ics==2) {
 7406:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 7407:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 7408:          }
 7409: 
 7410:          // Term for surface and bottom stress
 7411:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7412: 
 7413: 
 7414:          // All terms in F,F^\alpha,f_b except baroclinic
 7415:          // F, f_b: all explicit terms excluding vegetation 
 7416:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7417:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7418:          const double coriolis = side->coriolis;
 7419:          Vector2 F  =  coriolis*side->U;  // F_x
 7420:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7421:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7422: 
 7423:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7424:             
 7425:             for (int k = side->kb; k < nvrt; k++) {
 7426:                if (zctr2 > side->zc[k-1]) {
 7427:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7428:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7429:                    Fa +=  coriolis*w2*zrat;
 7430:                } // if zctr2
 7431:             } // k
 7432:          } // iveg
 7433: 
 7434:          // Integrate horizontal viscosity force vertically
 7435:          for (int k=side->kb + 1; k<nvrt; k++) {
 7436:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7437: 
 7438:             F += levelHorVisc;
 7439: 
 7440:             // Vegetation term
 7441:             if constexpr(iveg!=0) {
 7442:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7443:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7444:                   Fa += levelHorVisc*zrat;
 7445:                } 
 7446:             } // if iveg
 7447:          } // for k
 7448: 
 7449:          // Get nu*grad(U) at the side's bottom level
 7450:          Vector2 nuGradU = side->nuGradU[side->kb];
 7451: 
 7452:          fb += nuGradU;
 7453: 
 7454:          // If needed, project vectorsF, fb and Fa to the element frame
 7455:          if constexpr(ics==2) {
 7456:             F    = side->frame.projHorVec(F,    elem->frame);
 7457:             fb   = side->frame.projHorVec(fb,   elem->frame);
 7458:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 7459:          } // if ics
 7460: 
 7461:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7462:       } // for j (nodes and sides)
 7463: 
 7464:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7465: 
 7466: 
 7467:       // Finish off terms in F, F^\alpha and f_b
 7468:       const double grav3 = elem->mean(&Node::grav2);
 7469:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7470:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7471:       for (int j=0; j<i34; j++) { 
 7472:          // For each side in the element...
 7473:          const Side *side = elem->sides[j];
 7474:          const double chi = side->chi;
 7475: 
 7476:          const double htot = side->htot2();
 7477:          const double veg_h = side->veg_h();
 7478:          const Vector2 F  = htot*fb;
 7479:          const Vector2 Fa = min(htot, veg_h)*fb;
 7480: 
 7481:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7482:       } // for j
 7483: 
 7484:       // tmp is already in elem frame
 7485:       elem->ghat1 += tmp/i34;
 7486: 
 7487:       // Baroclinic force
 7488:       if constexpr(ibc==0) {
 7489:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7490: 
 7491:          Vector2 Fa = {0.0, 0.0};
 7492:          Vector2 intGradRho = {0.0, 0.0};
 7493:          
 7494:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 7495:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 7496:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7497: 
 7498:             // \in F [m^2/s/s]
 7499:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7500:          }
 7501: 
 7502:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7503:          const Vector2 F = av_df*Fa; //approx
 7504:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7505: 
 7506:       } // if ibc
 7507: 
 7508: 
 7509: 
 7510:    }
 7511: 
 7512: } // extern "C"
 7513: 
 7514: 
 7515: 
 7516: #ifdef DONTCOMPILE
 7517: __global__ void checkMassConservation(Tracers* sumtr) {
 7518: 
 7519:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7520: 
 7521:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7522: 
 7523:    Element *elem = &(mesh->localElemData[i]);
 7524: 
 7525:    // Skip dry elements
 7526:    if (elem->isDry) return;
 7527: 
 7528:    // Local sum array for this thread
 7529:    double localSum[N_TRACERS] = {0.0};
 7530: 
 7531:    // Sum over vertical levels for this element
 7532:    const int kbe = elem->kbe;
 7533:    const double area = elem->area;
 7534: 
 7535:    for (int k = kbe; k < nvrt; k++) {
 7536:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7537:       
 7538:       // Accumulate tracer mass
 7539:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7540:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7541:       }
 7542:    }
 7543: 
 7544:    //  This function returns per element sums. A reduction must be done on the host side.
 7545: }
 7546: 
 7547: 
 7548: __global__ void transport(void) {
 7549: 
 7550:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7551: 
 7552:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7553: 
 7554:    Element *elem = &(mesh->localElemData[ie]);
 7555: 
 7556:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7557: 
 7558:                for (int m=0; m<ntr; m++) {
 7559:                   for (int k=kbe(ie); k<nvrt; k++) {
 7560:                      // Calculate each polynomial's weight 
 7561:                      wm=0.d0; sum1=0.d0; 
 7562:                      wm1=0.d0; wm2=0.d0; 
 7563:                      for (int i=0; i<elem->nweno2; i++) {
 7564:                   
 7565:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7566:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7567:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7568:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7569:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7570:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7571:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7572:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7573:                      // -----------------Hu and Shu (1999)'s method----------------
 7574:                      b4=b1+b2+b3
 7575: 
 7576: //Error: add PRODUCTION CPP
 7577: #ifdef DEBUG
 7578:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7579:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7580:                     call parallel_abort(errmsg)
 7581:                   }
 7582: #endif
 7583: 
 7584:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7585:                   // !----test-------------- 
 7586:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7587:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7588:                   // !wm(i)=wm1(i)*wm2(i)
 7589:                   // !---------------------- 
 7590:                   sum1=sum1+wm(i)
 7591:                 } // end for i
 7592: 
 7593:                 wm=wm/sum1
 7594: 
 7595:                 for (int j=0; j<elem->i34; j++) {
 7596: 
 7597:                   const Side *side  = elem->sides[j];
 7598:                   const Node *node1 = side->n1;
 7599:                   const Node *node2 = side->n2;
 7600: 
 7601:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7602:                      trsd=0.d0
 7603:                      for (int kk=0; kk<nquad; kk++) {
 7604:                         for (int i=0; i<elem->nweno2; i++) {
 7605:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7606:                         } // end for i   
 7607:                      } // end for kk
 7608:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7609:                   } // outward flux
 7610:                } // end for j=1,i34(ie) ! side
 7611:             }
 7612:          }
 7613:               
 7614: 
 7615: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7616: //             //   calculate each polynomial's weight 
 7617: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7618: //                 wm=0.d0; sum1=0.d0
 7619: //                 do i=1,nweno1(ie) !for each polynomial
 7620: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7621: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7622: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7623: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7624: //                   wm(i)=b2
 7625: //                   sum1=sum1+b2
 7626: //                   !wm(i)=1.d0
 7627: //                   !sum1=sum1+1.d0
 7628: 
 7629: // // Error: PRODUCTION
 7630: // #ifdef DEBUG
 7631: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7632: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7633: //                     call parallel_abort(errmsg)
 7634: //                   endif
 7635: // #endif
 7636: 
 7637: //                 enddo !i
 7638: //                 wm=wm/sum1 !final weight
 7639: 
 7640:                 for (int j=0; j<elem->i34; j++) { // side
 7641:                   const Side *side = elem->sides[j];
 7642:                   const Node *node1 = side->n1;
 7643:                   const Node *node2 = side->n2;
 7644: 
 7645:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7646:                     trsd=0.d0
 7647:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7648:                       for (int i=0; i<elem->nweno1; i++) {
 7649:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7650:                       }
 7651:                     enddo //kk
 7652:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7653:                   } // outward flux
 7654:                 } // end for j=1,i34(ie) ! side
 7655:               } // end for k; ntr 
 7656: 
 7657:             else !simple upwind method
 7658:               do j=1,i34(ie)
 7659:                 jsj=elside(j,ie)
 7660:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7661:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7662:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7663:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7664:                   endif
 7665:                 enddo  !vertical layers
 7666:               enddo !j=1,i34(ie) ! side
 7667:             endif !order of accuracy
 7668: 
 7669:          //  enddo !ie
 7670: // !$OMP     end do
 7671: 
 7672: // !$OMP     master
 7673: //           !message passing
 7674: //           if (nproc>1) then
 7675: //             !make a copy of side concentrations
 7676: //             trsd_tmp0=trsd_tmp 
 7677: 
 7678: //             !this exchange routine swaps interface concentration between two partitions
 7679: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 7680: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 7681: 
 7682: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 7683: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 7684: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 7685: 
 7686: 
 7687: //             !This obtains final values for interface sides
 7688: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 7689: //       :    endif !nproc>1
 7690: //           !message passing end
 7691: // !$OMP     end master
 7692: // !$OMP     barrier
 7693: 
 7694: 
 7695: // !         Do advection; conc @ dry elem will not be changed
 7696: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 7697: // !$OMP     do reduction(+: h_mass_in)
 7698: //           do i=1,ne
 7699: //             if(idry_e(i)==1) cycle
 7700: 
 7701: 
 7702: // !           Wet elements with 3 wet nodes
 7703: //             do k=kbe(i)+1,nvrt
 7704: 
 7705: 
 7706: //               bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 7707: //               dtb_by_bigv = dtb/bigv
 7708:     
 7709: // !             Advective flux
 7710: //               if (ntd_weno==1 .or. itd_weno==1) then
 7711: //                 adv_tr(1:ntr)=trel_tmp(1:ntr,k,i) 
 7712: //               else
 7713: //                 adv_tr(1:ntr)=(1.d0-rk_coef(itd_weno))*trel_tmp0(1:ntr,k,i)+rk_coef(itd_weno)*trel_tmp(1:ntr,k,i) 
 7714: //               endif
 7715: 
 7716: //               !psum=0.d0 !sum of modified fluxes for all inflow bnds
 7717: //               do j=1,i34(i)
 7718: //                 jsj=elside(j,i) !side
