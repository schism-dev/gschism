 8349: extern "C" __global__ void getElementVarFunc(int varCode, double *res) {
 8350: 
 8351:    ELEM(elem);
 8352: 
 8353:    switch (varCode) {
 8354:       case (int)VarCode::outputCoords:
 8355:          const Point2 coords = elem->outputCoords();
 8356:          res[elem->idx*2    ] = coords.x;
 8357:          res[elem->idx*2 + 1] = coords.y;
 8358:          break;
 8359:    }
 8360: }
 8361: 
 8362: 
 8363: extern "C" __global__ void getSideVarFunc(int varCode, double *res) {
 8364: 
 8365:    SIDE(side);
 8366: 
 8367:    switch (varCode) {
 8368:       case (int)VarCode::outputCoords:
 8369:          const Point2 coords = side->outputCoords();
 8370:          res[side->idx*2    ] = coords.x;
 8371:          res[side->idx*2 + 1] = coords.y;
 8372:          break;
 8373:    }
 8374: }
