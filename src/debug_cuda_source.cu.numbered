 3286: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3287:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3288:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3289:    // 
 3290:    // This kernel is called for all nodes.
 3291: 
 3292: 
 3293:    NODE(node1);
 3294: 
 3295: 
 3296:    node1->clearMatrixRow();
 3297:    node1->qel = 0.0;
 3298: 
 3299:    // THIS IS FOR STRUCTURES XXX
 3300:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3301: 
 3302:    
 3303:    for (int j=0; j<node1->numElements; j++) {
 3304:       // For each element connected to the node...
 3305: 
 3306:       Element *elem = node1->elements[j];
 3307: 
 3308:       // Compute the average gravity
 3309:       const double grav3 = elem->mean(&Node::grav2);
 3310: 
 3311:       // Look at the documentation for the description of the terms in the following integrals
 3312: 
 3313:       // Integral I_1 
 3314:       // \bar{\breve{H}} 
 3315:       const double hhatb = elem->mean(&Side::hhat);        
 3316: 
 3317:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3318: 
 3319:       const int id1 = elem->nodeLocalIdx(node1); 
 3320:       const double area = elem->area;
 3321: 
 3322:       if (elem->isTri()) {
 3323: 
 3324:          // To clarify the notation in this section: 
 3325:          //   i stands for the node under consideration (node1)
 3326:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3327:          const int id2 = elem->nxq(1 + id1);
 3328:          const int id3 = elem->nxq(2 + id1);
 3329:          Node *node2 = elem->nodes[id2];
 3330:          Node *node3 = elem->nodes[id3];
 3331: 
 3332:          const Point2 x1 = node1->p2();
 3333:          const Point2 x2 = node2->p2();
 3334:          const Point2 x3 = node3->p2();
 3335: 
 3336:          // integral of phi_i*phi_j
 3337:          const double ipp_ii = (1.0/6.0 )*area;
 3338:          const double ipp_ij = (1.0/12.0)*area;
 3339:          const double ipp_ik = (1.0/12.0)*area;
 3340: 
 3341:          // integral of [(grad phi_i) * (grad phi_j)]
 3342:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3343:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3344:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3345: 
 3346:          // Computes the different components of integral I_1 of each node with respect to node i.
 3347:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3348:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3349:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3350: 
 3351:          node1->addToSparseMatrix(node1, I1_ii);
 3352:          node1->addToSparseMatrix(node2, I1_ij); 
 3353:          node1->addToSparseMatrix(node3, I1_ik);
 3354: 
 3355:       }
 3356:       else { // Quad
 3357:          // XXX IMPLEMENT THIS
 3358:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3359: 
 3360:          // To clarify the notation in this section: 
 3361:          //   i stands for the node under consideration (node1)
 3362:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3363:          const int id2 = elem->nxq(1 + id1);
 3364:          const int id3 = elem->nxq(2 + id1);
 3365:          const int id4 = elem->nxq(3 + id1);
 3366:          Node *node2 = elem->nodes[id2];
 3367:          Node *node3 = elem->nodes[id3];
 3368:          Node *node4 = elem->nodes[id4];         
 3369: 
 3370:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3371:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3372:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3373:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3374:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3375: 
 3376:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3377:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3378:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3379:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3380:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3381: 
 3382:          // Computes the different components of integral I_1 of each node with respect to node i.
 3383:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3384:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3385:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3386:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3387: 
 3388:          node1->addToSparseMatrix(node1, I1_ii);
 3389:          node1->addToSparseMatrix(node2, I1_ij); 
 3390:          node1->addToSparseMatrix(node3, I1_ik);
 3391:          node1->addToSparseMatrix(node4, I1_il);
 3392:   
 3393: 
 3394: 
 3395:       
 3396:       } 
 3397: 
 3398:  
 3399:       // Integral I_4
 3400:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3401:       // Where
 3402:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3403: 
 3404:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3405:       // of U over the element.
 3406:       Vector2 Umean = {0.0, 0.0};
 3407:       for (int m=0; m<elem->i34; m++) {      
 3408:          const Side *side = elem->sides[m];
 3409: 
 3410:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3411:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3412:       }
 3413:       Umean = Umean/elem->i34;
 3414: 
 3415:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3416: 
 3417:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3418:       const double I_4_1 = dot(gradPhi_1, Umean);
 3419: 
 3420:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3421:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3422:      
 3423: // printf(">>> k = %d, node idx = %d, elem->idx = %d, Umean = %.15e,%.15e, I_4_1 = %.15e, I_4_2 = %.15e, node1->qel = %.15e\n", j, node1->idx, elem->idx, Umean.x, Umean.y, I_4_1, I_4_2, dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2));
 3424: // printf(">>> k = %d, node idx = %d, elem->idx = %d, ghat1 = %.15e,%.15e, gradPhi = %.15e,%.15e\n", j, node1->idx, elem->idx, elem->ghat1.x, elem->ghat1.y, gradPhi_1.x, gradPhi_1.y);
 3425:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3426: 
 3427:       // Additional terms 
 3428:       double vnorm = 0.0;
 3429:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3430:          Vector3 ubed;
 3431:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3432: 
 3433:          Vector3 gradP = {0.0, 0.0, 1.0};
 3434:          for (int m=0; m < elem->i34; m++) {
 3435:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3436:            gradP += toVector3(gradP_2D, 0.0);
 3437:          }   
 3438:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3439:       } // imm==2
 3440: 
 3441:       if (elem->isTri()) {
 3442:          for (int l=0; l<3; l++) {
 3443:             double fac;
 3444: 
 3445:             Node *node = elem->nodes[l];
 3446: 
 3447:             fac = (node == node1) ? 2.0 : 1.0;
 3448:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3449:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3450: // printf("AAA>>>  (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm) = %.15e\n",  (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm));
 3451:            
 3452:          }
 3453: 
 3454: 
 3455:          if (!elem->isDry) {
 3456:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3457: 
 3458:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3459: // printf("BBB>>>  elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta) = %.15e\n",  elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta));
 3460:          }
 3461: 
 3462:       } // isTri
 3463:       else { // isQuad
 3464:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3465:          // for (int l=0; l<4; l++) {
 3466:          //   const Node *node = elem->nodes[l];
 3467: 
 3468:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3469:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3470: 
 3471:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3472:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3473:          // }
 3474: 
 3475:       } // isQuad
 3476: 
 3477: 
 3478:       node1->qel += (dt/elem->i34)*elem->vsource;
 3479:       
 3480: 
 3481:    } // for all elements connected to the node
 3482:    
 3483: 
 3484: 
 3485:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3486:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3487:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3488:    if (nodeBnd != nullptr)  { 
 3489:       // If it is an open boundary node...
 3490: 
 3491:       // At least one open bnd side, maybe two
 3492:       for (int l=0; l<2; l++) { 
 3493: 
 3494:          // Gets each of the sides sharing the node. 
 3495:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3496: 
 3497:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 3498: 
 3499:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3500: 
 3501:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3502:          if (sideBnd != nullptr) {
 3503:             // If the side is on a boundary...
 3504: 
 3505:             // Get the boundary segment
 3506:             const BoundarySegment *sideSegment = sideBnd->segment;
 3507:             const Side *side = sideBnd->side;
 3508: 
 3509:             // Integral I_3
 3510:             if (sideSegment->ifltype != 0) {
 3511:             // Natural or Flather b.c.
 3512: 
 3513:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3514:                // especially for Flather b.c.
 3515:                double ri3 = 0.0;
 3516:                if (!side->isDry) {
 3517:                   // If the side is not dry
 3518:                   
 3519:                   // Computes the side flux of (uth, vth)
 3520:                   double Vn = 0.0;
 3521:                   for (int k = side->kb; k<nvrt-1; k++) {
 3522:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3523:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3524: 
 3525:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3526:                   }
 3527: 
 3528:                   ri3 = 0.5*side->len*Vn;
 3529:                }
 3530: 
 3531:                if (sideSegment->ifltype == -1) { // Flather 1
 3532: 
 3533:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3534:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3535: 
 3536:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3537:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3538:                   
 3539:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3540:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3541: 
 3542:                } 
 3543:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3544:                   // Reset ri3
 3545:                   ri3 = 0.0;
 3546: 
 3547:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3548: 
 3549:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3550: 
 3551:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3552:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3553: 
 3554:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3555:                   node1->addToSparseMatrix(node1, con0*2.0);
 3556:                   node1->addToSparseMatrix(node2, con0);
 3557: 
 3558:                } // if Flather or Discharge
 3559: 
 3560:                node1->qel -= thetai*dt*ri3;
 3561: 
 3562:             } // I_3
 3563:           
 3564: 
 3565:             // Integral I_5
 3566:             if(!side->isDry) {
 3567: 
 3568:                const double Unbar = dot(side->U, side->n);
 3569:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3570: 
 3571:             } // I_5
 3572: 
 3573:          } // if is boundary side
 3574: 
 3575:       } // for l
 3576: 
 3577:    } // if isbnd
 3578: 
 3579: 
 3580: }
 3581: 
 3582: 
 3583: 
 3584: extern "C" {
 3585:    __global__ void rollUpElevation(void) {
 3586: 
 3587:       NODE(node);
 3588: 
 3589:       node->eta1 = node->eta2;
 3590: 
 3591:    }
 3592: 
 3593: 
 3594:    __global__ void backtrackAllNodes(void) {
 3595: 
 3596:       // max/min # of sub-divisions
 3597:       const int ndelt_max = max(1.0, dt/dtb_min);
 3598:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3599: 
 3600:       // Removed all references to swild98 XXX
 3601:       // swild98=0.d0 !init
 3602: 
 3603: 
 3604:       SIDE(side);
 3605: 
 3606:       const int kb = side->kb;
 3607: 
 3608: 
 3609:       // Initialize btrack velocities to the actual velocities at the side 
 3610:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3611: 
 3612:       if (side->isDry) return;
 3613: 
 3614: 
 3615:       // Checks that at least one element is not dry
 3616:       const Element *elem1 = side->elems[0];
 3617:       const Element *elem2 = side->elems[1];
 3618: 
 3619: 
 3620:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3621:       
 3622:       // XXXXXX
 3623:       // !swild_tmp to store global coord. of the starting side
 3624:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3625:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3626:       // !Use sframe2 
 3627:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3628: 
 3629: 
 3630:       for (int k = kb; k < nvrt; k++) {
 3631:       //  Initialize (xt,yt,zt), nnel and vel.
 3632:       //  For ics=2, the coordinates are in local frames
 3633:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3634: 
 3635: 
 3636:          const int iadvf = side->iadv();  // Advection flag
 3637: 
 3638:          Point3 xt;
 3639:          if constexpr(ics==1) {
 3640:             xt = side->center3D(k); 
 3641:          }
 3642:          else // lat/lon; in side lat/lon frame
 3643:          {
 3644:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3645:          // XXX IMPLEMENT THIS
 3646:       //          xt=0.d0
 3647:       //          yt=0.d0
 3648:       //          !centroid coord. for nudging
 3649:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3650:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3651:          }  // ics
 3652: 
 3653: 
 3654: 
 3655:          // If on land or open boundary...
 3656:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3657:          
 3658:          const double vmag = length(side->u2[k]);
 3659: 
 3660:          if (vmag <= velmin_btrack) {
 3661:             // No activity 
 3662: 
 3663:             side->btu[k] = side->u2[k];
 3664:             
 3665:          } else {  // do btrack
 3666: 
 3667:             // Compute number of sub-divisions based on local gradients 
 3668:             // XXX IS THIS NECESSARY?
 3669:             double suma = 0.0;
 3670:             int icount = 0;
 3671:             for (int ii=0; ii<2; ii++) {
 3672: 
 3673:                const Element *elem = side->elems[ii];
 3674:                  
 3675:                if (elem == nullptr) continue;
 3676: 
 3677:                icount++;
 3678: 
 3679:                // Not strictly along z; in ll frame for ics=2
 3680: 
 3681:                double utmp[4];
 3682:                double vtmp[4];
 3683:                for (int jj = 0; jj < elem->i34; jj++) {
 3684: 
 3685:                   const Node *node = elem->nodes[jj];
 3686: 
 3687:                   if constexpr(ics==1) {
 3688:                      utmp[jj] = node->u2[k].x;
 3689:                      vtmp[jj] = node->u2[k].y;  
 3690:                   } else {
 3691:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3692:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3693:                   }
 3694:                } // for jj
 3695: 
 3696:                const Vector2 grad_u = elem->grad2(utmp); 
 3697:                const Vector2 grad_v = elem->grad2(vtmp);
 3698: 
 3699:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3700:             } // for ii
 3701: 
 3702:             assert(icount > 0 && "Impossible 77");
 3703: 
 3704:             // '4' is somewhat arbitrary
 3705:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3706: 
 3707:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3708:          
 3709: 
 3710:             Vector3 u_int = {0.0, 0.0, 0.0};
 3711: 
 3712:             side->btrack(k, dt, dtbk, u_int);
 3713:             side->btu[k] = toVector2(u_int);
 3714:                
 3715:          } // if vmag (do backtrack)
 3716: 
 3717:       } // for k=kb,nvrt-1
 3718: 
 3719:    }
 3720: 
 3721: } // extern "C"
 3722: 
 3723: template<int nc>
 3724: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3725: 
 3726: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3727: //
 3728: // a,b,c,rhs: input vectors and are not modified by this program.
 3729: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3730: // rhs is the r.h.s.
 3731: // n: actual rank of the system.
 3732: // rows in u() and rhs();
 3733: // u: output with nc columns (transposed to rows)
 3734: // gam: a working array.
 3735: //
 3736: // NOTES:
 3737: // This is a template function that allows for different numbers of columns in the rhs vector.
 3738: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3739: 
 3740:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3741:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3742: 
 3743:    double bet = b[0];
 3744:    if constexpr (nc == 1) {
 3745:       u[0] = rhs[0]/bet;
 3746:    } else {
 3747:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 3748:    }
 3749: 
 3750:    for (int j = 1; j < n; j++) {
 3751:       gam[j] = c[j - 1]/bet;
 3752:       bet = b[j] - a[j]*gam[j];
 3753: 
 3754:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3755: 
 3756:       if constexpr (nc == 1) {
 3757:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3758:       } else {
 3759:          for (int l = 0; l < nc; l++) {
 3760:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 3761:          }
 3762:       }
 3763:    }
 3764: 
 3765:    // Back-substitution
 3766:    for (int j = n - 2; j >= 0; j--) {
 3767:       if constexpr (nc == 1) {
 3768:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 3769:       } else {
 3770:          for (int l = 0; l < nc; l++) {
 3771:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 3772:          }
 3773:       }
 3774:    }
 3775: }
 3776: 
 3777: 
 3778: 
 3779: // Helper function that contains the core algorithm
 3780: template<typename XAccessor, typename YAccessor>
 3781: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3782:                                     double  yp_top, double  yp_bot, 
 3783:                                     CubicSpline &spline) {
 3784:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3785:    // 
 3786:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3787:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3788:    //
 3789:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3790:    // 
 3791:    // Inputs: 
 3792:    //            n: dimension for x etc; # of data pts (>=2);
 3793:    //            getX, getY: functions to access x,y coordinates
 3794:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3795:    //     Output: 
 3796:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3797: 
 3798:    const int n = k2 - k1 + 1;
 3799:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3800: 
 3801:    // Allocate memory for the splines
 3802:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3803:    spline.x   = new double[n];
 3804:    spline.y   = new double[n];
 3805:    spline.yp  = new double[n];
 3806:    spline.ypp = new double[n];
 3807: 
 3808:    for (int k=k1; k<=k2; k++) {
 3809:       spline.x[k] = getX(k);
 3810:       spline.y[k] = getY(k);
 3811:    }
 3812: 
 3813:    // This is to simplify expressions later
 3814:    double *x = spline.x;
 3815:    double *y = spline.y;
 3816: 
 3817:    double *a = nullptr;
 3818:    double *b = nullptr;
 3819:    double *c = nullptr;
 3820:    double *gam = nullptr;
 3821:    double *rhs = nullptr;
 3822:    
 3823: 
 3824:       a = new double[n];   // Lower diagonal
 3825:       b = new double[n];   // Diagonal
 3826:       c = new double[n];   // Upper diagonal
 3827:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3828:       rhs = new double[n]; // Right-hand side
 3829: 
 3830:    for (int k=k1; k<=k2; k++) {
 3831:       if (k == k1) {
 3832:          // Bottom level
 3833:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3834:          b[k] = (x[k+1] - x[k])/3.0;
 3835:          c[k] = b[k]/2.0;
 3836:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3837:       } else if (k == n - 1) {
 3838:          // Top level (surface)
 3839:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3840:          b[k] = (x[k] - x[k-1])/3.0;
 3841:          a[k] = b[k]/2.0;
 3842:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3843:       } else {
 3844:          // Intermediate levels
 3845:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3846:          b[k] = (x[k+1] - x[k-1])/3.0;
 3847:          a[k] = (x[k  ] - x[k-1])/6.0;
 3848:          c[k] = (x[k+1] - x[k  ])/6.0;
 3849:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3850:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3851:       }
 3852:    }
 3853: 
 3854:    // Solve the tridiagonal system
 3855:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3856:    
 3857:    spline.yp[k1] = yp_bot;
 3858:    spline.yp[k2] = yp_top;
 3859: 
 3860:    // Compute rest of 1st derivatives using the splines
 3861:    for (int k=k1+1; k<k2; k++) {
 3862:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3863:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3864:    }
 3865:    
 3866:    delete[] a;
 3867:    delete[] b;
 3868:    delete[] c;
 3869:    delete[] gam;
 3870:    delete[] rhs;
 3871: 
 3872: }
 3873: 
 3874: // Array version
 3875: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3876:                                 double y_top, double y_bot, 
 3877:                                 CubicSpline &spline) {
 3878:    auto getX = [x] (int k) { return x[k]; };
 3879:    auto getY = [y] (int k) { return y[k]; };
 3880:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3881: }
 3882: 
 3883: // Lambda version - allows custom access patterns
 3884: template<typename XFunc, typename YFunc>
 3885: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3886:                                 double y_top, double y_bot,
 3887:                                 CubicSpline &spline) {
 3888:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3889: }
 3890: 
 3891: 
 3892: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 3893: {
 3894:    assert("Not implemented");
 3895: 
 3896:    return 0.0;
 3897: }
 3898: 
 3899: // __device__ void vertLinearInterp(int nc, double zt, int k1, int k2, double *za, double *s_in, double *s_out, int *ibelow) {
 3900: // //     Routine to do vertical linear interpolation in z
 3901: // //     Inputs:
 3902: // //
 3903: // //       nc: actual # of variables 
 3904: // //       k1,k2: lower and upper limits for za, s_in 
 3905: // //       zt: desired interpolation level
 3906: // //       za[0:nvrt-1]: z-coordinates for s_in (must be in ascending order)
 3907: // //       s_in[0:nc-1,0:nvrt-1]: values to be interpolated from; dimensions must match driving program
 3908: 
 3909: // //     Outputs:
 3910: // //       s_out[0:nc-1]: interpolated value @ z=zt (bottom value if ibelow=1). Constant extrapolation
 3911: // //                   is used below bottom or above surface.
 3912: // //       ibelow: flag indicating if zt is below za(k1)
 3913: // //
 3914: 
 3915: //    assert(k1 >= 0 && k2 < nvrt && "vertLinearInterp: k1 or k2 out of bounds");
 3916: //    assert(k1 <= k2 && "vertLinearInterp: k1 > k2");
 3917:    
 3918: //    ibelow = 0;
 3919: 
 3920: //    if (zt < za[k1]) {
 3921: //       // Below bottom
 3922: //       ibelow = 1;
 3923: //       for (int i = 0; i < nc; i++) s_out[i] = s_in[i + k1*nc];
 3924: 
 3925: //    } else if(zt>=za[k2]) {
 3926: //       // Above surface
 3927: //       for (int i = 0; i < nc; i++) s_out[i] = s_in[i + k2*nc];
 3928: 
 3929: //    } else {
 3930: //       // Normal case (between bottom and surface)
 3931:       
 3932: //       // Finds the level index using binary search
 3933: //       int l1 = k1;
 3934: //       int l2 = k2;
 3935: //       int k = (l1 + l2)/2;
 3936: //       while (l2 - l1 > 1) {  // Stop when we have adjacent levels
 3937: //           int k = (l1 + l2)/2;
 3938: //           if (zt >= za[k]) l1 = k;
 3939: //           else             l2 = k;
 3940: //       }
 3941: //       // Now l1 and l2 are adjacent levels and zt is between them
 3942: 
