 3181: 
 3182: extern "C" {
 3183:    __global__ void rollUpElevation(void) {
 3184: 
 3185:       NODE(node);
 3186: 
 3187:       node->eta2 += node->eta1;
 3188: 
 3189:    }
 3190: 
 3191: 
 3192:    __global__ void backtrackAllNodes(void) {
 3193: 
 3194:       // max/min # of sub-divisions
 3195:       const int ndelt_max = max(1.0, dt/dtb_min);
 3196:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3197: 
 3198:       // Removed all references to swild98 XXX
 3199:       // swild98=0.d0 !init
 3200: 
 3201: 
 3202:       SIDE(side);
 3203: 
 3204:       const int kb = side->kb;
 3205: 
 3206: 
 3207: 
 3208:       // Initialize btrack velocities to the actual velocities at the side 
 3209:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3210: 
 3211: 
 3212:       if (side->isDry) return;
 3213: 
 3214: 
 3215:       // Checks that at least one element is not dry
 3216:       const Element *elem1 = side->elems[0];
 3217:       const Element *elem2 = side->elems[1];
 3218: 
 3219: 
 3220:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3221:       
 3222:       // XXXXXX
 3223:       // !swild_tmp to store global coord. of the starting side
 3224:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3225:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3226:       // !Use sframe2 
 3227:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3228: 
 3229: 
 3230:       for (int k = kb; k < nvrt; k++) {
 3231:       //  Initialize (xt,yt,zt), nnel and vel.
 3232:       //  For ics=2, the coordinates are in local frames
 3233:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3234: 
 3235: 
 3236:          const int iadvf = side->iadv();  // Advection flag
 3237: 
 3238:          Point3 xt;
 3239:          if constexpr(ics==1) {
 3240:             xt = side->center3D(k); 
 3241:          }
 3242:          else // lat/lon; in side lat/lon frame
 3243:          {
 3244:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3245:          // XXX IMPLEMENT THIS
 3246:       //          xt=0.d0
 3247:       //          yt=0.d0
 3248:       //          !centroid coord. for nudging
 3249:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3250:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3251:          }  // ics
 3252: 
 3253: 
 3254:          // Velocity at the side (in ll frame for ics, same vertical direction)
 3255:          // XXX IS THIS NECESSARY?
 3256:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 3257: 
 3258:          // If on land or open boundary...
 3259:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3260:          
 3261:          const double vmag = length(toVector2(u_int));
 3262: 
 3263:          if (vmag <= velmin_btrack) {
 3264:             // No activity 
 3265: 
 3266:             side->btu[k] = side->u2[k];
 3267:             
 3268:          } else {  // do btrack
 3269: 
 3270:             // Compute number of sub-divisions based on local gradients 
 3271:             // XXX IS THIS NECESSARY?
 3272:             double suma = 0.0;
 3273:             int icount = 0;
 3274:             for (int ii=0; ii<2; ii++) {
 3275: 
 3276:                const Element *elem = side->elems[ii];
 3277:                  
 3278:                if (elem == nullptr) continue;
 3279: 
 3280:                icount++;
 3281: 
 3282:                // Not strictly along z; in ll frame for ics=2
 3283: 
 3284:                double utmp[4];
 3285:                double vtmp[4];
 3286:                for (int jj = 0; jj < elem->i34; jj++) {
 3287: 
 3288:                   const Node *node = elem->nodes[jj];
 3289: 
 3290:                   if constexpr(ics==1) {
 3291:                      utmp[jj] = node->u2[k].x;
 3292:                      vtmp[jj] = node->u2[k].y;  
 3293:                   } else {
 3294:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3295:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3296:                   }
 3297:                } // for jj
 3298: 
 3299:                const Vector2 grad_u = elem->grad2(utmp); 
 3300:                const Vector2 grad_v = elem->grad2(vtmp);
 3301: 
 3302:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3303:             } // for ii
 3304: 
 3305:             assert(icount > 0 && "Impossible 77");
 3306: 
 3307:             // '4' is somewhat arbitrary
 3308:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3309: 
 3310:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3311:          
 3312: 
 3313:             Vector3 u_int = {0.0, 0.0, 0.0};
 3314: 
 3315:             side->btrack(k, dt, dtbk, u_int);
 3316:                
 3317:          } // if vmag (do backtrack)
 3318: 
 3319:       } // for j=jmin,nvrt-1
 3320: 
 3321:    }
 3322: } // extern "C"
 3323: 
 3324: template<int nc>
 3325: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3326: 
 3327: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3328: //
 3329: // a,b,c,rhs: input vectors and are not modified by this program.
 3330: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3331: // rhs is the r.h.s.
 3332: // n: actual rank of the system.
 3333: // rows in u() and rhs();
 3334: // u: output with nc columns (transposed to rows)
 3335: // gam: a working array.
 3336: //
 3337: // NOTES:
 3338: // This is a template function that allows for different numbers of columns in the rhs vector.
 3339: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3340: 
 3341:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3342:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3343: 
 3344:    double bet = b[0];
 3345:    if constexpr (nc == 1) {
 3346:       u[0] = rhs[0]/bet;
 3347:    } else {
 3348:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 3349:    }
 3350: 
 3351:    for (int j = 1; j < n; j++) {
 3352:       gam[j] = c[j-1]/bet;
 3353:       bet = b[j] - a[j]*gam[j];
 3354: 
 3355:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3356: 
 3357:       if constexpr (nc == 1) {
 3358:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3359:       } else {
 3360:          for (int k = 0; k < nc; k++) {
 3361:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 3362:          }
 3363:       }
 3364:    }
 3365: 
 3366:    // Back-substitution
 3367:    for (int j=n-1; j>=1; j--) {
 3368:       if constexpr (nc == 1) {
 3369:          u[j] = u[j] - gam[j+1]*u[j-1];
 3370:       } else {
 3371:          for (int k = 0; k < nc; k++) {
 3372:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 3373:          }
 3374:       }
 3375:    }
 3376: }
 3377: 
 3378: 
 3379: 
 3380: // Helper function that contains the core algorithm
 3381: template<typename XAccessor, typename YAccessor>
 3382: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3383:                                     double  yp_top, double  yp_bot, 
 3384:                                     CubicSpline &spline) {
 3385:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3386:    // 
 3387:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3388:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3389:    //
 3390:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3391:    // 
 3392:    // Inputs: 
 3393:    //            n: dimension for x etc; # of data pts (>=2);
 3394:    //            getX, getY: functions to access x,y coordinates
 3395:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3396:    //     Output: 
 3397:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3398: 
 3399:    const int n = k2 - k1 + 1;
 3400:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3401: 
 3402:    // Allocate memory for the splines
 3403:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3404:    spline.x   = new double[n];
 3405:    spline.y   = new double[n];
 3406:    spline.yp  = new double[n];
 3407:    spline.ypp = new double[n];
 3408: 
 3409:    for (int k=k1; k<=k2; k++) {
 3410:       spline.x[k] = getX(k);
 3411:       spline.y[k] = getY(k);
 3412:    }
 3413: 
 3414:    // This is to simplify expressions later
 3415:    double *x = spline.x;
 3416:    double *y = spline.y;
 3417: 
 3418:    double *a = nullptr;
 3419:    double *b = nullptr;
 3420:    double *c = nullptr;
 3421:    double *gam = nullptr;
 3422:    double *rhs = nullptr;
 3423:    
 3424: 
 3425:       a = new double[n];   // Lower diagonal
 3426:       b = new double[n];   // Diagonal
 3427:       c = new double[n];   // Upper diagonal
 3428:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3429:       rhs = new double[n]; // Right-hand side
 3430: 
 3431:    for (int k=k1; k<=k2; k++) {
 3432:       if (k == k1) {
 3433:          // Bottom level
 3434:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3435:          b[k] = (x[k+1] - x[k])/3.0;
 3436:          c[k] = b[k]/2.0;
 3437:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3438:       } else if (k == n - 1) {
 3439:          // Top level (surface)
 3440:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3441:          b[k] = (x[k] - x[k-1])/3.0;
 3442:          a[k] = b[k]/2.0;
 3443:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3444:       } else {
 3445:          // Intermediate levels
 3446:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3447:          b[k] = (x[k+1] - x[k-1])/3.0;
 3448:          a[k] = (x[k  ] - x[k-1])/6.0;
 3449:          c[k] = (x[k+1] - x[k  ])/6.0;
 3450:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3451:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3452:       }
 3453:    }
 3454: 
 3455:    // Solve the tridiagonal system
 3456:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3457:    
 3458:    spline.yp[k1] = yp_bot;
 3459:    spline.yp[k2] = yp_top;
 3460: 
 3461:    // Compute rest of 1st derivatives using the splines
 3462:    for (int k=k1+1; k<k2; k++) {
 3463:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3464:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3465:    }
 3466:    
 3467:    delete[] a;
 3468:    delete[] b;
 3469:    delete[] c;
 3470:    delete[] gam;
 3471:    delete[] rhs;
 3472: 
 3473: }
 3474: 
 3475: // Array version
 3476: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3477:                                 double y_top, double y_bot, 
 3478:                                 CubicSpline &spline) {
 3479:    auto getX = [x] (int k) { return x[k]; };
 3480:    auto getY = [y] (int k) { return y[k]; };
 3481:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3482: }
 3483: 
 3484: // Lambda version - allows custom access patterns
 3485: template<typename XFunc, typename YFunc>
 3486: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3487:                                 double y_top, double y_bot,
 3488:                                 CubicSpline &spline) {
 3489:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3490: }
 3491: 
 3492: 
 3493: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 3494: {
 3495:    assert("Not implemented");
 3496: 
 3497:    return 0.0;
 3498: }
 3499: 
 3500: // __device__ void vertLinearInterp(int nc, double zt, int k1, int k2, double *za, double *s_in, double *s_out, int *ibelow) {
 3501: // //     Routine to do vertical linear interpolation in z
 3502: // //     Inputs:
 3503: // //
 3504: // //       nc: actual # of variables 
 3505: // //       k1,k2: lower and upper limits for za, s_in 
 3506: // //       zt: desired interpolation level
 3507: // //       za[0:nvrt-1]: z-coordinates for s_in (must be in ascending order)
 3508: // //       s_in[0:nc-1,0:nvrt-1]: values to be interpolated from; dimensions must match driving program
 3509: 
 3510: // //     Outputs:
 3511: // //       s_out[0:nc-1]: interpolated value @ z=zt (bottom value if ibelow=1). Constant extrapolation
 3512: // //                   is used below bottom or above surface.
 3513: // //       ibelow: flag indicating if zt is below za(k1)
 3514: // //
 3515: 
 3516: //    assert(k1 >= 0 && k2 < nvrt && "vertLinearInterp: k1 or k2 out of bounds");
 3517: //    assert(k1 <= k2 && "vertLinearInterp: k1 > k2");
 3518:    
 3519: //    ibelow = 0;
 3520: 
 3521: //    if (zt < za[k1]) {
 3522: //       // Below bottom
