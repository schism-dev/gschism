 5624:    __global__ void computeVerticallyIntegratedVelocity(void) {
 5625: 
 5626:       SIDE(side);
 5627: 
 5628:       side->U = {0.0, 0.0}; 
 5629:          
 5630:       if(side->isDry) return;
 5631: 
 5632:       // Vertically integrated velocity U
 5633:       for (int k = side->kb; k < nvrt - 1; k++) { 
 5634:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 5635:          side->U += side->Dz(k + 1)*uc;  
 5636:       }
 5637: 
 5638:    }
 5639: 
 5640:    __global__ void computeBottomDragVegetation(void) {
 5641:       // UNFINISHED. CHECK THIS:
 5642:       // How many kernels are needed? Why so many for loops?
 5643:       // Is the loop on sides needed?
 5644: 
 5645:       NODE(node);
 5646: 
 5647: 
 5648:       const int    kb      = node->kb;
 5649:       const double htot    = node->htot2(); 
 5650:       
 5651:       if (node->isDry) {
 5652:          // Default values for dry nodes
 5653:          node->veg_alpha_vert_mean = node->veg_alpha0;
 5654:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 5655: 
 5656:          return;
 5657:        
 5658:       }
 5659: 
 5660:       // Computes bottom drag Cd based on the selected nchi
 5661:       node->computeBottomDragCd();
 5662:       
 5663: 
 5664: 
 5665:       //   Bottom stress in m^2/s^2
 5666:       if (node->rho[kb + 1] >= -98.0)
 5667:       {
 5668:          const double mag_u = length(node->u2[kb + 1]);
 5669:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5670: 
 5671:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5672:          // !sediment erosion: this part needs more documentation
 5673:       }
 5674:     
 5675: 
 5676: 
 5677:       // Compute vegetation parameters
 5678:       //--------------------------------
 5679: 
 5680:       // SAV constants
 5681:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5682:       constexpr double veg_cfpsi = 0.16;
 5683: 
 5684:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5685:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5686: 
 5687:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5688:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5689:          int kbin = 0; // bin index
 5690:          for (int k = kb; k < nvrt; k++) {
 5691:             // Computes node height above the bottom level
 5692:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5693:             assert(false && "Vertical variation of vegetation not implemented");
 5694: 
 5695:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5696:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5697:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5698:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5699:             // } else {
 5700:             //    // Find the bin at which the current vertical level is
 5701:             //    while (kbin<nbins_veg_vert) {
 5702:             //       const double zn = node->z[kbin];
 5703:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5704:             //          break;
 5705:             //       } // if
 5706:             //       kbin++;
 5707:             //    } // while
 5708:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5709: 
 5710:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5711:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5712:                
 5713:             //    // Linear interpolation of the vegetation parameters
 5714:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5715:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5716:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5717:             // } // if rl10
 5718: 
 5719:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5720: 
 5721:          } // for k
 5722: 
 5723: 
 5724:       } else { // Ganthy (iveg==2)
 5725:       //  Modify canopy height, diameter, and density
 5726: 
 5727:          // Make sure there is vegetation on this node
 5728:          if (node->veg_h_unbent > 0.0) {
 5729:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5730: 
 5731:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5732:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5733:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5734: 
 5735:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5736:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5737:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5738:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5739:          } // if veg_h_unbent
 5740: 
 5741:          for (int k = 0; k < nvrt; k++) {
 5742:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5743:          } // for k
 5744:       
 5745: 
 5746:       } // if iveg
 5747:      
 5748: 
 5749:       // Compute vertical mean of veg_alpha3D
 5750:       if (iveg != 0) {
 5751:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5752:          double sum1=0.0;
 5753:          double sum2=0.0;
 5754:          // Integrate over each level under the canopy...
 5755:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5756:             const double Dz = node->Dz(k);
 5757: 
 5758:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5759:             sum2 += Dz;
 5760: 
 5761:          } // for k
 5762:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5763:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5764: 
 5765:       } // if iveg
 5766: 
 5767:    }
 5768: 
 5769:    __global__ void computeVegetationAndDragParameters(void) {
 5770:       // Computes the vegetation and drag model parameters:
 5771:       // chi, \tilde\chi, beta, \breve{H}
 5772:       
 5773:       SIDE(side);
 5774: 
 5775:       side->hhat = 0.0;
 5776:       side->chi2 = 0.0;
 5777:       side->chi = 0.0;
 5778:       side->veg_c2 = 0.0;
 5779:       side->veg_beta = 0.0;
 5780: 
 5781:       if (side->isDry) return;
 5782: 
 5783:       const double htot = side->htot2();
 5784:       const int    kb   = side->kb;
 5785: 
 5786:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5787: 
 5788:       const double veg_h     = side->veg_h();
 5789:       const double veg_nv    = side->veg_nv();
 5790:       const double veg_c     = side->veg_c();
 5791:       const double veg_beta  = side->veg_beta;
 5792:       const double veg_alpha = side->veg_alpha_vert_mean();
 5793: 
 5794:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX recommended to change names, chi->chitilde, chi2->chi
 5795:       // Velocity magnitude at the bottom level
 5796:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0 - dt*swild2(k,1) to u2 (I think this only pertains to iupwind_mom \= 0)
 5797:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 5798:       side->chi2 = side->Cd()*vmag1;
 5799:       side->chi  = side->chi2;
 5800:       if constexpr(iveg != 0) {
 5801:          const Node *n1 = side->n1;
 5802:          const Node *n2 = side->n2;
 5803:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5804:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5805:       }
 5806: 
 5807:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5808: 
 5809:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5810:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5811:       double magUa = 0.0;
 5812:       if constexpr(iveg != 0) {
 5813:          if (side->is3D() && veg_h > 0.0) {
 5814:             // 3D wet side with veg...
 5815: 
 5816:             double magUa = 0.0;
 5817:             for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5818:                if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5819: 
 5820:                   // Velocity magnitude must be computed at the center of each level to perform the integration.
 5821:                   // The tricky part is to compute that velocity at the level that may be partially submerged.
 5822:                   const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5823: 
 5824:                   // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5825:                   const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5826: 
 5827:                   // Velocity magnitude at the bottom (l) of the level
 5828:                   const double ul = length(side->u2[k]);
 5829: 
 5830:                   const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5831:                   magUa += Dz*0.5*(uh + ul);
 5832: 
 5833:                } // if HasVegetation
 5834:             } // for k
 5835:             const double ua = magUa/min(htot, veg_h); // Vertical average
 5836: 
 5837:             // Computes beta, used for computing the stress term at the top of the canopy.      
 5838:             side->veg_c2 = veg_alpha*dt*ua; // >=0
 5839:             if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5840:                const double zCpy = side->zTopCanopy();
 5841:                const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5842:                const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5843:                const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5844:                const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5845:                side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5846:             } // if isSubmerged
 5847:          } // if is3D
 5848:       } // if iveg   
 5849: 
 5850:       // Computes the friction modified depth, \breve{H} in notes
 5851:       if (side->is2D()) { // 2D
 5852: 
 5853:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5854:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5855: 
 5856:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5857: 
 5858:          side->hhat = htot*htot/fricH; 
 5859: 
 5860:       } else { // 3D
 5861:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 5862: 
 5863:          if constexpr(iveg != 0) {
 5864:             
 5865:             if (side->isSubmerged()) { 
 5866:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5867:                side->hhat -= veg_c*Hhat_alpha;
 5868: 
 5869:             } else { // Emergent
 5870:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5871:             }
 5872:          } // if iveg
 5873: 
 5874:          // Enforce positivity for 3D model
 5875:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 5876:       } // if 3D
 5877: 
 5878:    }
 5879: 
 5880: 
 5881: 
 5882:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5883:    // Computes the density gradient between two elements, e1 and e2.
 5884:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5885:    // zero in the direction normal to the side. 
 5886:    // 
 5887:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5888:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 5889:    //
 5890:    // Input:
 5891:    //    e1: Element
 5892:    //    e2: Neighbor element (or nullptr if boundary)
 5893:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 5894:    //    k: Index of the half-level at which the density is interpolated
 5895:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 5896:    // 
 5897:    // Output:
 5898:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 5899:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 5900: 
 5901:       if (e2 == nullptr || e2->isDry) {
 5902:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 5903: 
 5904:          Side *side = e1->sides[j];
 5905:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 5906:                  
 5907:          if constexpr(ics == 1) {
 5908:             vec = side->n; // Normal vector to the side
 5909:          } else {
 5910:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5911:             // IMPLEMENT THIS XXXXXX
 5912:             // !replace with xel, yel?
 5913:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5914:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5915:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5916:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5917:          } //ics
 5918:                    
 5919:          diffRho = 0.0;
 5920: 
 5921:       } else { //internal and wet
 5922:          if constexpr(ics==1) {
 5923:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5924: 
 5925:             // Vector from e1 to e2
 5926:             vec = e2->center - e1->center;
 5927: 
 5928:          } else { 
 5929:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5930:             // Remember that elem->center is in global coordinates
 5931:             // IMPLEMENT THIS XXXXXX
 5932:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5933:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5934:             //                   alow(j)=xctr2
 5935:             //                   bdia(j)=yctr2
 5936:          } // ics
 5937: 
 5938:          diffRho = rho2 - e1->demeanedDensity(k);
 5939:       }
 5940: 
 5941:    }
 5942: 
 5943:    __global__ void computeDensityCubicSplines(void) {
 5944:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5945: 
 5946:       ELEM(elem);
 5947: 
 5948:       if (elem->isDry) return;
 5949: 
 5950:       const int kb = elem->kb;
 5951: 
 5952:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5953:       if (elem->is2D()) {
 5954:          // In the 2D case, the density is constant at the prism level. 
 5955:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5956:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5957:       } else { //3D
 5958: 
 5959:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5960:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5961:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5962:          ///// XXXX CHECK INDICES!!!!!
 5963:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5964:       } // 2D/3D
 5965: 
 5966:    }
 5967: } // extern "C"
 5968: 
 5969: 
 5970: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5971: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5972: 
 5973:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5974: 
 5975:    const int kb  = elem->kb;
 5976:    const int kb2 = elem2->kb;
 5977: 
 5978:    // z-coordinate of prism of elem
 5979:    const double zp = elem->z_prism(k);
 5980: 
 5981:    double rho = 0.0;
 5982: 
 5983:    if (elem2->is2D()) {
 5984:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5985: 
 5986:    } else {  // 3D
 5987: 
 5988:       // eta_min may be < zmax
 5989:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5990:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5991: 
 5992:       // (Extrapolate density below bottom, we will fix it later)
 5993:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5994:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5995:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5996:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5997:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5998:    } // 2D/3D
 5999:      
 6000: 
 6001:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 6002:    // Now we need to fix it.
 6003:    if (elem->z[k] < elem2->z[kb2]) {
 6004:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 6005: 
 6006:       // There are two methods to adjust the density at the bottom of the element.
 6007:       // iunder_deep=0: 
 6008:       const double depth1 = abs(elem->z[kb]); // larger depth
 6009: 
 6010:       if (iunder_deep==0) {
 6011: 
 6012:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 6013: 
 6014:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 6015: 
 6016:       } else { // iunder_deep != 0
 6017: 
 6018:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 6019: 
 6020:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 6021: 
 6022:          //   Demeaned density at the same z coordinate as
 6023:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 6024:          }
 6025: 
 6026:       } // if iunder_deep
 6027:    } // if elem->z[kb] < elem2->z[kb]
 6028: 
 6029:    return rho;
 6030: }
 6031: 
 6032: 
 6033: extern "C" {
 6034:    __global__ void computeDensityGradient(void) {
 6035: 
 6036:       assert(ibc == 1 && "baroclinic formulation is not implemented yet: ibc != 0");
 6037:       if constexpr(ibc != 0) return;
 6038: 
 6039:          // Compute the horizontal density gradient at each element.
 6040:       // It works in two steps:
 6041:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6042:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6043:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6044:       //             gradRho.r1 = rho1 - rho0
 6045:       //             gradRho.r2 = rho2 - rho0
 6046:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6047:       // 
 6048:       //  NOTE: We use de-meaned densities.
 6049: 
 6050:       ELEM(elem);
 6051: 
 6052:       if (elem->isDry) return;
 6053: 
 6054:       const int kb  = elem->kb;
 6055:       const int i34 = elem->i34;
 6056: 
 6057:       for (int k = kb + 1; k < nvrt; k++) {
 6058:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 6059:          //             gradRho.r1 = rho1 - rho0
 6060:          //             gradRho.r2 = rho2 - rho0
 6061:          int icount = 0;
 6062:          double sumRx = 0.0;
 6063:          double sumRy = 0.0;
 6064:          for (int j1=0; j1<i34; j1++) { 
 6065: 
 6066:             const int j2 = elem->nxq(j1 + 1);
 6067: 
 6068:             // Pairs of consecutive neighbor elements of elem
 6069:             const Element *e1 = elem->nghbElems[j1];
 6070:             const Element *e2 = elem->nghbElems[j2];
 6071: 
 6072:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 6073:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 6074:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 6075: 
 6076:             // Compute the density difference and the vector from elem to e1 and e2
 6077:             // getRhoDiffAndVec takes into account boundaries/dry elements
 6078:             double diffRho1, diffRho2;
 6079:             Vector2 vec1, vec2;
 6080:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 6081:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 6082: 
 6083:             const double rl1 = length(vec1);
 6084:             const double rl2 = length(vec2);
 6085:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 6086: 
 6087:             const double delta = cross(vec1, vec2);
 6088:             const double sintheta = abs(delta)/(rl1*rl2);
 6089: 
 6090:             // To avoid problems, avoid elements with small angle between vectors
 6091:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 6092:             const bool validEq = (sintheta > sin_one_deg);
 6093: 
 6094:             if (validEq) {
 6095:                // Solve the system of equations to get the density gradient at elem
 6096:                icount++;
 6097:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 6098:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 6099:                sumRx += Rx;
 6100:                sumRy += Ry;
 6101:             }
 6102:          } // for j1
 6103: 
 6104:          // Compute the average density gradient at elem
 6105:          if (icount==0) {
 6106:            // Bad mesh quality; bail out with 0 b-cc
 6107:            elem->gradRho[k] = {0.0, 0.0};
 6108:          } else {
 6109:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 6110:          }
 6111: 
 6112:       } // for k
 6113: 
 6114:    }
 6115: 
 6116:    __global__ void computeBaroclinicTerm(void) {
 6117:    // Computes the baroclinic term at sides (at half levels).
 6118:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 6119:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 6120: 
 6121:       if (ibc == 1) return;
 6122: 
 6123:       SIDE(side);
 6124: 
 6125:       if (side->isDry) return;
 6126: 
 6127:       const Element *e1 = side->elems[0];
 6128:       const Element *e2 = side->elems[1]; 
 6129:       const int kb = side->kb;
 6130:       
 6131:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 6132: 
 6133:       // interpolates vertically the density gradient of the two elements at the half level/
 6134: 
 6135:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 6136:       int k2 = max(kb, nvrt / 2);
 6137: 
 6138:       // Starts the integration at the surface and goes down to the bottom
 6139:       side->bcc[nvrt-1] = {0.0, 0.0};
 6140:       for (int k = nvrt - 2; k >= kb; k--) {
 6141:       // For each prism level (from surface to bottom)...
 6142: 
 6143:          // For both elements, interpolate density gradient at the side's half level.
 6144:          // The gradient at the side is the average of the gradients at the elements.
 6145:          // w1, w2 are used to take into account boundary sides, with just one element.
 6146:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 6147:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 6148:          const double wsum = w1 + w2;
 6149:          w1 = w1/wsum;
 6150:          w2 = w2/wsum;
 6151:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 6152: 
 6153:          // Linear interpolation of both elements' density gradient at the shared side's level.
 6154:          Vector2 gradRho = {0.0, 0.0};
 6155:          if (e1 != nullptr && k > kb) {
 6156:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 6157:             
 6158:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 6159:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 6160:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6161: 
 6162:             // Grad(rho) vertically interpolated at the side's half level
 6163:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 6164: 
 6165:             // Projects the element density gradient to the side frame if needed.
 6166:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 6167: 
 6168:             // Adds the contribution of the density gradient at the side's half level
 6169:             gradRho += gradRho1*w1;
 6170:          }      
 6171:          if (e2 != nullptr && k > kb) {
 6172:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 6173:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 6174:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6175:             
 6176:             // Grad(rho) vertically interpolated at the side's half level
 6177:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 6178: 
 6179:             // Projects the element density gradient to the side frame if needed.
 6180:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 6181: 
 6182:             // Adds the contribution of the density gradient at the side's half level
 6183:             gradRho += gradRho2*w2;
 6184:          }
 6185: 
 6186:          
 6187:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 6188:          // multiplied by -rampbc*(g/rho0) 
 6189:          const double grav3 = side->grav3();
 6190:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 6191: 
 6192:       } // for
 6193: 
 6194:    }
 6195: 
 6196: 
 6197: 
 6198:    __global__ void computeHorGradientAtSide(void) {
 6199: 
 6200:       // Compute the horizontal density gradient at each element.
 6201:       // It works in two steps:
 6202:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6203:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6204:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6205:       //             gradRho.r1 = rho1 - rho0
 6206:       //             gradRho.r2 = rho2 - rho0
 6207:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6208:       // 
 6209:       //  NOTE: We use de-meaned densities.
 6210: 
 6211:       SIDE(side);
 6212: 
 6213: 
 6214:       if (side->isDry) return;
 6215: 
 6216:       // Computes the gradient of the variables at the side center.
 6217:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 6218:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 6219:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 6220: 
 6221:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 6222:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 6223:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 6224:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 6225: 
 6226:    }
 6227: 
 6228: 
 6229:    __global__ void solveMomentumEquations(double time) {
 6230: 
 6231:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 6232:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 6233: 
 6234:       SIDE(side);
 6235: 
 6236:       if (side->isDry) 
 6237:       {
 6238:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 6239: 
 6240:          return;
 6241:       }
 6242: 
 6243:       const Node *n1 = side->n1;
 6244:       const Node *n2 = side->n2;
 6245: 
 6246:       const int kb = side->kb;
 6247: 
 6248:       const double veg_h = side->veg_h();
 6249:       const double grav3 = side->grav3();
 6250: 
 6251:       if (side->is2D()) {
 6252:          // Remember: Do not use htot2, which is updated.
 6253:          const double htot = side->htot1();
 6254:          const double hhat = side->hhat;
 6255: 
 6256:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 6257: 
 6258:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6259:          const Vector2 tau2 = side->tau();
 6260: 
 6261:          // hat_gam has units of m/s
 6262: 
 6263:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 6264:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 6265:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 6266: 
 6267:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 6268: 
 6269: 
 6270:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 6271: 
 6272:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 6273: 
 6274:       }
 6275:       else { // 3D
 6276: 
 6277:          // For 3D it is necessary to solve an implicit tridiagonal system.
 6278:          // 
 6279:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 6280:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 6281:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 6282:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 6283:          // k+1 and k.
 6284: 
 6285: 
 6286:          const int ndim = nvrt - kb;
 6287:          const double zTopCanopy = side->zTopCanopy();
 6288: 
 6289:          // Initialize the tridiagonal system
 6290:          for (int k = kb + 1; k < nvrt; k++) {
 6291:             
 6292:             const int kin = k - (kb + 1);
 6293: 
 6294:             // Vertical viscosity at the face center
 6295:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 6296: 
 6297:  
 6298:             alow[kin] = 0.0;
 6299:             cupp[kin] = 0.0;
 6300:             bdia[kin] = 0.0;
 6301: 
 6302:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 6303:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 6304: 
 6305:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 6306:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 6307:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 6308: 
 6309:             // First part: layers k, k+1
 6310:             if (k < nvrt - 1) {
 6311:                              
 6312:                if constexpr(iveg != 0) {
 6313: 
 6314:                   // If there is vegetation at this level...
 6315:                   if (zTopCanopy > side->zc[k]) {
 6316:                      // If the canopy is above the k layer...
 6317:                      
 6318:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 6319:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 6320:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 6321:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 6322: 
 6323:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 6324:                      const double vmag2 = length(ut2);
 6325:                      const double vmag1 = length(side->u2[k]);
 6326:                      const double vmag = 0.5*(vmag1 + vmag2);
 6327:                      
 6328:                      // Computes the vegetation alpha at the face center
 6329:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 6330: 
 6331:                      cff1 += veg_alpha_sd*dt*vmag;
 6332: 
 6333:                   } // if (zTopCanopy
 6334:                } // if iveg
 6335: 
 6336:                const double dzz = side->Dz(k + 1);
 6337:                const double tmp = dt*dfz/dzz;
 6338:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6339: 
 6340:                cupp[kin] += cff1*dzz/6.0 - tmp;
 6341:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6342:             }
 6343: 
 6344: 
 6345:             // Second part: layers k-1, k
 6346:             if (k > kb + 1) {
 6347: 
 6348:                double cff1 = 1.0; //init \bar{c^k}
 6349: 
 6350:                if constexpr(iveg != 0) {
 6351:                   // If there is vegetation at this level...
 6352:                   if (zTopCanopy > side->zc[k-1]) {
 6353:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 6354:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 6355: 
 6356:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 6357: 
 6358:                      const double vmag2 = length(ut2);
 6359:                      const double vmag1 = length(side->u2[k-1]);
 6360:                      const double vmag = 0.5*(vmag1 + vmag2);
 6361: 
 6362:                      // Computes the vegetation alpha at the face center
 6363:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 6364:                      cff1 += veg_alpha_sd*dt*vmag;
 6365:                   } // if zTopCanopy
 6366: 
 6367:                } // if iveg
 6368: 
 6369:                const double dzz = side->Dz(k);
 6370:                const double tmp = dt*dfz/dzz;
 6371:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6372: 
 6373:                alow[kin] += cff1*dzz/6.0 - tmp;
 6374:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6375: 
 6376:             } else { // Bottom boundary
 6377:                // This occurs at the bottom, where the bottom drag is applied.
 6378: 
 6379:                bdia[kin] += dt*side->chi2; // XXXX
 6380: 
 6381:             } // if (k > kb + 1)
 6382: 
 6383: 
 6384:          } // for (int k
 6385: 
 6386: 
 6387: 
 6388:          // Computes the RHS.
 6389:          // -----------------
 6390: 
 6391:          //	BC to be imposed at the end.
 6392: 
 6393:          const Vector2 gradETP  = side->gradETP;
 6394:          const Vector2 gradPr   = side->gradPr;
 6395:          const Vector2 gradEta1 = side->gradEta1;
 6396:          const Vector2 gradEta2 = side->gradEta2;
 6397: 
 6398:          const Vector2 *btu = side->btu;
 6399:          const Vector2 *u2  = side->u2;
 6400:          const double coriolis = side->coriolis;
 6401:          const Vector2 *nuGradU = side->nuGradU;
 6402: 
 6403:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 6404:          for (int k = kb + 1; k < nvrt; k++) {
 6405:             const int kin = k - kb - 1;
 6406: 
 6407:             const double dz_0 = side->Dz(k);
 6408:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 6409: 
 6410:             rrhs[kin] = {0.0, 0.0};
 6411:             double dz = 0.0;
 6412: 
 6413:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 6414:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 6415:             if (k < nvrt  ) dz += dz_1;
 6416:             if (k > kb + 1) dz += dz_0;
 6417: 
 6418:             // Elevation gradient, atmospheric pressure and tidal potential
 6419:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 6420: 
 6421:             // Coriolis, advection, wind stress, and horizontal viscosity
 6422:             if (k < nvrt - 1) {
 6423: 
 6424: 
 6425:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 6426:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 6427:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 6428:                                                 
 6429: 
 6430:                //diff stress tensors 1006
 6431:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 6432:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 6433:                   assert(false && "Not implemented: itur == 5");
 6434:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 6435:                }
 6436:                // else assert(false && "itur # Not implemented");
 6437: 
 6438:             } else { // k == nvrt - 1 SURFACE
 6439:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6440:                const Vector2 tau2 = side->tau();
 6441: 
 6442:                rrhs[kin] += dt*tau2;          
 6443: 
 6444:             } // if k<nvrt
 6445: 
 6446: 
 6447:             if (k > kb + 1) {
 6448:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 6449:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 6450:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 6451: 
 6452:                // diff stress tensors 1006
 6453:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 6454:                   assert(false && "Not implemented: itur == 5");
 6455:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 6456:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 6457:                }
 6458:                // else assert(false && "itur # Not implemented");
 6459: 
 6460: 
 6461:             } // if k>kbs + 1
 6462: 
 6463:             // Baroclinic
 6464:             Vector2 *bcc = side->bcc;
 6465:             if constexpr(ibc == 0) {
 6466:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 6467:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 6468: 
 6469:             } // if ibc==0
 6470: 
 6471:          } // k=kb + 1,nvrt
 6472: 
 6473: 
 6474:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 6475: 
 6476:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 6477:             const int kin = k - kb - 1;
 6478:    
 6479:             // Velocity is always clamped to maximum values
 6480:             side->u2[k] = clampVelocity(soln[kin]);
 6481:          } // k
 6482: 
 6483:       } // if side->is2D()
 6484:       
 6485: 
 6486:       // Impose velocity boundary condition at the bottom
 6487:       if constexpr(imm == 2) { // 3D bed deformation model
 6488:          double dep;
 6489:          Vector2 vel;
 6490: 
 6491:          assert(false && "Not implemented: imm == 2");
 6492:          //update_bdef(time, x0, y0, dep, vel);
 6493:          // side->u2[kb] = vel;
 6494: 
 6495:       } else { // imm = 0 or 1
 6496:          if (side->Cd() == 0.0) {
 6497:             side->u2[kb] = side->u2[kb + 1];
 6498: 
 6499:          } else if (side->is3D()) { // 3D no slip bottom   
 6500:             side->u2[kb] = {0.0, 0.0};
 6501: 
 6502:          }
 6503:           
 6504:       } // if imm
 6505: 
 6506:       // The velocities below the bottom level are set to zero
 6507:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 6508: 
 6509: 
 6510:    }
 6511: 
 6512: 
 6513:    __global__ void applyMomentumBC(void) {
 6514: 
 6515:       SIDE_BND(sideBnd);
 6516: 
 6517:       Side *side = sideBnd->side;
 6518:       const BoundarySegment *segment = sideBnd->segment;
 6519:       const Node *n1 = side->n1;
 6520:       const Node *n2 = side->n2;
 6521: 
 6522:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 6523: 
 6524:       const bool isLand = segment->isLand;
 6525:       const int ifltype = segment->ifltype;
 6526: 
 6527:       const int kb = side->kb;
 6528: 
 6529: 
 6530:       if (!isLand && ifltype != 0) {
 6531:          const Vector2 *ubc = sideBnd->ubc;
 6532:   
 6533:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 6534:             
 6535:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 6536:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 6537: 
 6538:             if (ifltype == -1) {
 6539:                // Flather 1
 6540: 
 6541:                const double depth = side->depth();
 6542: 
 6543:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 6544: 
 6545:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 6546: 
 6547:                side->u2[k] = vnorm*side->n;
 6548: 
 6549:             } else if (ifltype == -2) { // Discharge
 6550: 
 6551:                const double eta1 = side->eta1();
 6552:                const double eta2 = side->eta2();
 6553:                const double htot = side->htot2();
 6554: 
 6555:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 6556:                assert(false && "Not implemented: Discharge bc");
 6557:                // const double dischrg = discharge(eta1);
 6558:                const double dischrg = 0.0; // XXX REMOVE
 6559:                
 6560: 
 6561:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 6562: 
 6563:                const double vnorm = dischrg*eta2/htot;
 6564: 
 6565:                side->u2[k] = vnorm*side->n;
 6566: 
 6567:             }
 6568:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 6569:                const double vnorm = dot(side->u2[k], side->n);
 6570: 
 6571:                double rat;
 6572:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 6573:                else              rat = segment->vobc2; // outgoing
 6574: 
 6575:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 6576: 
 6577:             }
 6578:             else { // not Flather or 3D radiation
 6579:                side->u2[k] = ubc[k];
 6580: 
 6581:             } // if (segment->ifltype...
 6582: 
 6583:          }
 6584: 
 6585:       }
 6586:       else if (isLand) { // if it is land boundary side
 6587: 
 6588:          if constexpr(islip == 0) { // free slip
 6589: 
 6590:             for (int k = kb; k < nvrt; k++) {
 6591: 
 6592:                const Vector2 t = side->t();
 6593:                const Vector2 n = side->n;
 6594: 
 6595:                double vnorm = 0.0; // for most cases
 6596:                const double vtan = dot(side->u2[k], t);
 6597:                
 6598:                side->u2[k] = vtan*t - vnorm*n;
 6599: 
 6600:             }
 6601: 
 6602:          } else { // no slip
 6603:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 6604: 
 6605:          }
 6606:       } // if (side segment type...
 6607: 
 6608:    }
 6609: 
 6610: 
 6611:    __global__ void shapiroFilter1(void) {
 6612:       // First step of the Shapiro filter (normally used if indvel<=0)
 6613:       // Computes the filtered values and stores them in bcc (as a temporary array).
 6614: 
 6615:       SIDE(side);
 6616: 
 6617:       // Only internal wet sides are processed
 6618:       if (side->isDry || !(side->isInternal())) return;
 6619: 
 6620:       const int kb = side->kb;
 6621: 
 6622:       for (int mm = 0; mm < niter_shap; mm++) {
 6623: 
 6624:          for (int k = kb + 1; k < nvrt; k++) {
 6625:             // WARNING: reusing bcc as a temporary array to store the suru values.
 6626:             Vector2 suru = {0.0, 0.0};
 6627: 
 6628:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 6629: 
 6630:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 6631: 
 6632:                int kin = k;
 6633:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 6634:                
 6635:                // Get the velocity at the neighbor's side.
 6636:                Vector2 nSideU2 = nSide->u2[kin];
 6637: 
 6638:                // Projects the velocity to the current side frame if needed.
 6639:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 6640: 
 6641:                suru += nSideU2;
 6642:             }
 6643: 
 6644:             // Reusing bcc as a temporary array to store the suru values.
 6645:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 6646: 
 6647:          }
 6648:       }
 6649:    }
 6650: 
 6651:    __global__ void shapiroFilter2(void) {
 6652:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6653: 
 6654:       SIDE(side);
 6655: 
 6656: 
 6657:       if (side->isDry || !(side->isInternal())) return;
 6658: 
 6659:       const int kb = side->kb;
 6660: 
 6661:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6662: 
 6663:       if (side->is2D()) {
 6664:          side->u2[kb + 1] = side->bcc[kb + 1];
 6665:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6666: 
 6667:       } else {
 6668:          // 3D
 6669:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6670:          
 6671:       }
 6672: 
 6673:    }
 6674: 
 6675: 
 6676:    __global__ void ul0UpdateZCoords(void) {
 6677:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6678:       
 6679:       NODE(node);      
 6680: 
 6681: 
 6682:       if (false) { //node->isDry) { XXXXXXX
 6683: 
 6684:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6685: 
 6686:          if constexpr(ivcor != 1) node->kb = 0;
 6687: 
 6688:       } else {
 6689: 
 6690:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6691:          node->updateKb();
 6692: 
 6693:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6694: 
 6695:       }
 6696: 
 6697:       // We use the temp.b field to store the previous state of isDry.
 6698:       node->tmp.b = node->isDry;
 6699: 
 6700:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6701:       node->isDry = true;
 6702: 
 6703:    }
 6704: 
 6705:    __global__ void ul0ComputeDryElements(void)
 6706:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6707:    {
 6708:       ELEM(elem);
 6709: 
 6710:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6711: 
 6712:       elem->kb = 0;
 6713: 
 6714:       if (elem->isDry) return;
 6715: 
 6716: 
 6717:    //    if(elem->isDry2()) { // XXXX
 6718:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6719:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6720:    //        call parallel_abort(errmsg)
 6721:    //    }
 6722: 
 6723:       const Node *n1 = elem->nodes[0];
 6724:       const Node *n2 = elem->nodes[1];
 6725:       const Node *n3 = elem->nodes[2];  
 6726:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6727: 
 6728:       // Computes element's kb as the minimum of the nodes' kb.
 6729:       const int kb1 = n1->kb;
 6730:       const int kb2 = n2->kb;
 6731:       const int kb3 = n3->kb;
 6732:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 6733: 
 6734: 
 6735:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6736: 
 6737: 
 6738:       // Computes the element z as the mean of the nodes z.
 6739:       for (int k = elem->kb; k < nvrt; k++) {
 6740: 
 6741:          // Compute the element z as the mean of the nodes z.
 6742:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6743:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6744:          elem->z[k] /= elem->i34;
 6745: 
 6746:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 6747:       }
 6748:                   
 6749:    }
 6750: 
 6751:    __global__ void ul0ComputeDryNodes(void)
 6752:    // Updates node's isDry based on the elements' isDry. 
 6753:    {
 6754:       NODE(node);
 6755: 
 6756:       node->isDry = true;
 6757: 
 6758:       // A node is wet if at least one of the elements sharing it is wet.
 6759:       for (int j = 0; j < node->numElements; j++) {
 6760:          const Element *elem = node->elements[j];
 6761:          if (!elem->isDry) {
 6762:             node->isDry = false;
 6763:             break;
 6764:          }
 6765:       }
 6766: 
 6767:        
 6768:    }
 6769: 
 6770: 
 6771:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6772:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6773:    // node->tmp.b is true if the node was previously dry.
 6774:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6775:    {
 6776:       NODE(node);
 6777:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6778: 
 6779:       // Avoid this the first time step.
 6780:       if (it == iths) return;  
 6781: 
 6782:       const bool wasDry = node->tmp.b;
 6783: 
 6784: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6785: 
 6786:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 6787: 
 6788:          for (int k=0; k < nvrt; k++) {
 6789: 
 6790:             Vector3 utmp={0.0, 0.0, 0.0};
 6791: 
 6792:             double ttmp=0.0;
 6793:             double stmp=0.0;
 6794:             int icount=0;
 6795:             for (int j = 0; j < node->numNodes; j++) {
 6796: 
 6797:                const Node *nbrNode = node->nodes[j];
 6798:                
 6799:                const bool wasNbrDry = nbrNode->tmp.b;
 6800: 
 6801:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 6802:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 6803: 
 6804:                   icount++;
 6805: 
 6806:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6807:                   utmp += nbrNode->uvw2(k);
 6808:                   
 6809:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 6810:                   stmp += nbrNode->tracers[k].tracer[1]; 
 6811:                }
 6812:             }
 6813: 
 6814:             if (icount > 0) {
 6815:                const double inv_icount = 1.0/icount;
 6816:                utmp = inv_icount*utmp;
 6817:                node->u2[k]     = {utmp.x, utmp.y};
 6818:                node->w2[k]     = utmp.z;
 6819:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6820:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6821:             } else {
 6822:                node->u2[k] = {0.0, 0.0};
 6823:                node->w2[k] = 0.0;
 6824:                // Initialize tracers to 0.0??? XXXXX
 6825:             }
 6826:          }
 6827:       }
 6828:    }
 6829: 
 6830:   
 6831:    
 6832: 
 6833: 
 6834:    __global__ void ul0UpdateSides(int it, int iths) {
 6835:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 6836:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 6837:    // The dryness of the sides is updated in ul0UpdateSides2.
 6838: 
 6839:       SIDE(side);
 6840: 
 6841:       // A side is wet if and only if at least one of its elements is wet.
 6842:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6843:  
 6844:       const Node *n1 = side->n1;
 6845:       const Node *n2 = side->n2;
 6846:      
 6847:       const int kb1 = n1->kb;
 6848:       const int kb2 = n2->kb;
 6849: 
 6850:       side->kb = 0; // default when dry
 6851: 
 6852:       if (isWet) {
 6853: 
 6854:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6855: 
 6856:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6857: 
 6858:          side->kb = min(kb1, kb2);
 6859: 
 6860:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6861: 
 6862:          for (int k = side->kb; k < nvrt; k++) {
 6863:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6864: 
 6865:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 6866: 
 6867:             // Compute velocity for re-wetted sides 
 6868:             if ((it != iths) && (side->isDry && isWet)) {
 6869: 
 6870:                Vector2 utmp={0.0, 0.0};
 6871: 
 6872:                int icount=0;
 6873: 
 6874:                // For all the sides on the two elements that share this side
 6875:                for (int j = 0; j < 2; j++) {
 6876:                   const Element *elem = side->elems[j];
 6877:                   if (elem == nullptr) continue;
 6878: 
 6879:                   for (int jj=0; jj < elem->i34; jj++) {
 6880:                      const Side *nSide = elem->sides[jj];
 6881:                      if (nSide->isDry) continue;
 6882: 
 6883:                      icount++;
 6884:                      utmp += nSide->u2[k];  
 6885:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 6886:                   }
 6887:                }
 6888:                   
 6889:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 6890:                if (icount > 0)  side->u2[k] = utmp/icount;
 6891:                else             side->u2[k] = {0.0, 0.0};
 6892:                   
 6893:             } // if ((it != iths) && (side->isDry && isWet))
 6894: 
 6895:          } // for k
 6896: 
 6897:       } // if isWet 
 6898:       
 6899: 
 6900: 
 6901:    }
 6902: 
 6903:    __global__ void ul0UpdateSides2(void) {
 6904:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 6905:    
 6906:          SIDE(side);
 6907:    
 6908:          const Element *e1 = side->elems[0];
 6909:          const Element *e2 = side->elems[1];
 6910: 
 6911:          // A side is wet if and only if at least one of its elements is wet.
 6912:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 6913: 
 6914:          // Update the side's dryness
 6915:          side->isDry = !isWet;
 6916: 
 6917:    }
