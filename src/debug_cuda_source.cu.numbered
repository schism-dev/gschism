 2235: /**
 2236:  * Find the element that contains the target point.
 2237:  * 
 2238:  * @param x0,y0,z0     Starting position coordinates
 2239:  * @param xt,yt,zt     Target position coordinates
 2240:  * @param dtb          Time step for tracking
 2241:  * @param u_int        Initial velocity components
 2242:  * @param nextElem     Starting/resulting element index
 2243:  * 
 2244:  * @return Status code of type trackExitCodes
 2245:  * 
 2246:  * Uses the Leaded Celestial Walk algorithm to find the element that contains the target point.
 2247:  * This is a variant of the Celestial Walk algorithm that goes from element A containing the starting 
 2248:  * point x0 (in one side) to element B containing the target point xt. To enforce that the next element is
 2249:  * as close the the segment AB as possible, the next point at each iteration is computed
 2250:  * along segment AB, but just after the current element.
 2251:  */
 2252: 
 2253: 
 2254: __device__ __forceinline__ bool celestialWalk(Element *&curElem, Point3 x0, Point3 &xt, const Side *origSide, Side *&lastCrossSide, int jlev) {
 2255: 
 2256:    constexpr int MAX_ITERATIONS = 40;
 2257: 
 2258:    int iter = 0;
 2259:    double fac = 0.00001;
 2260:    while (iter < MAX_ITERATIONS) {
 2261:       iter++;
 2262: 
 2263:       Bool4 isLeft, isObtuse, isBisector;
 2264:       curElem->computePredicates(toPoint2(x0), toPoint2(xt), fac, origSide, isLeft, isObtuse, isBisector, jlev);
 2265: // showPoints(x0, xt, jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2266:       Bool4 isValid = !isLeft & (!isObtuse | isBisector); // bitwise operation are overloaded
 2267: 
 2268: 
 2269:       if (isValid.none()) 
 2270:       // Inside the element if none of the edges is a valid continuation
 2271:       {
 2272:          // Just returns true and the element (curElem) is unchanged).
 2273:          // This means that the algorithm has found the element that contains the target point.
 2274:          return true;
 2275:       }
 2276:       else { // Outside the element
 2277: 
 2278:          // Outside this element. Pick the first valid exit side and cross.
 2279:          lastCrossSide = curElem->sides[isValid.firstOne()];
 2280:          Element *prevElem = curElem;
 2281:          curElem = lastCrossSide->otherElem(curElem);
 2282: 
 2283:          // If it crosses into a dry element or a boundary element, return false. This means that the track will now move 
 2284:          // along the boundary.
 2285:          if (curElem == nullptr || curElem->isDry) {
 2286:          
 2287:             curElem = prevElem;
 2288:             return false;
 2289:          }
 2290:          
 2291:       }
 2292: 
 2293:    }
 2294: 
 2295:   assert(false && "Leaded Celestial Walk: exceeded max iterations");
 2296: }
