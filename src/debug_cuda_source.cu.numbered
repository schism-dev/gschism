  170: struct Bool4 {
  171:    unsigned int m; // bit i = lane i
  172: 
  173:    __device__ __forceinline__ bool get(int i) const { return (m >> i) & 1u; }
  174:    __device__ __forceinline__ void set(int i, bool v) {m = (m & ~(1u << i)) | ((unsigned int)(v) << i); }
  175: 
  176:    __device__ __forceinline__ bool all(void) const { return m == 0x0F; }
  177:    __device__ __forceinline__ bool any(void) const { return m != 0; }
  178:    __device__ __forceinline__ bool none(void) const { return m == 0; }
  179:    __device__ __forceinline__ int firstOne(void) const { return __ffs(m) - 1; }
  180: 
  181: };
  182: 
  183: __device__ __forceinline__ Bool4 operator!(Bool4 x) { x.m = (~x.m) & 0x0F; return x; }
  184: __device__ __forceinline__ Bool4 operator&(Bool4 a, Bool4 b) { return Bool4{(unsigned int)(a.m & b.m)}; }
  185: __device__ __forceinline__ Bool4 operator|(Bool4 a, Bool4 b) { return Bool4{(unsigned int)(a.m | b.m)}; }
