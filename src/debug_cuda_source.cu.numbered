 2304: 
 2305: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2306:    // Returns the value of the velocity at the side center
 2307:    const double w1 = getBoundaryArrayValueWeight();
 2308:    const double w2 = 1.0 - w1;
 2309:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2310:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2311: 
 2312:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2313: }
 2314: 
 2315: 
 2316: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2317:    // Returns the value of the normal component of the velocity at the side center
 2318:    const double w1 = getBoundaryArrayValueWeight();
 2319:    const double w2 = 1.0 - w1;
 2320:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2321:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2322: 
 2323:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2324: }
