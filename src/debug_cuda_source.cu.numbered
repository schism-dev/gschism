  981: struct Side {
  982: 
  983:    // Geometry information
  984:    int idx;               // Index of the side
  985:    Node *n1, *n2;
  986:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  987: 
  988:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
  989:    Point2 center;        // Location of side center. 
  990:    double zc[nvrt];       // Side center z-coord at each vertical level
  991: 
  992:    Frame frame;
  993: 
  994:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  995:                           // this is nullptr
  996:    
  997:    int kb;                // Bottom index of the side
  998:    bool isDry;            // True if the side is dry
  999:  
 1000:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1001: 
 1002:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1003: 
 1004:    // Physical information
 1005:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1006:    Vector2 btu[nvrt];           // Back-tracked velocity
 1007:    Vector2 U;                   // Vertically averaged velocity vector  
 1008: 
 1009:    Vector2 nuGradU[nvrt];          // nu*grad u
 1010: 
 1011:    Vector2 bcc[nvrt];           // Baroclinic term
 1012:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1013: 
 1014:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1015:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1016:    Vector2 gradPr;               // Gradient of pressure
 1017:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1018: 
 1019: 
 1020:    double hhat;                 // \breve{H} in notes
 1021: 
 1022:    double shapiro;
 1023: 
 1024:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1025: 
 1026:    double coriolis;             // Coriolis parameter
 1027: 
 1028:    // Vegetation parameters
 1029:    double veg_c2;
 1030:    double veg_beta;
 1031: 
 1032:    // Bottom drag parameters.
 1033:    double chi;
 1034:    double chi2;
 1035: 
 1036:    __inline__ __device__ double x(double t) const;
 1037:    __inline__ __device__ double y(double t) const;
 1038:    __inline__ __device__ double lon(void) const;
 1039:    __inline__ __device__ double lat(void) const;
 1040:    __inline__ __device__ Point2 p_t(double t) const;
 1041: 
 1042:    __inline__ __device__ Point3 center3D(int k) const { assert(k < nvrt); return {center.x, center.y, zc[k]}; }
 1043:    __inline__ __device__ double Dz(int k)       const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1044:    __inline__ __device__ double area(int k)     const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1045: 
 1046: 
 1047:    __inline__ __device__ Vector3 interpolateCenterVelocityVertically(Point3 xt) const;
 1048: 
 1049:    __inline__ __device__ Side* neigh(int index) const { 
 1050:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1051:       assert(index >= 0 && index < 4); 
 1052:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1053: 
 1054:       const int ielem = index & 1;           // 0 or 1
 1055:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1056: 
 1057:       const Element* elem = elems[ielem];
 1058: 
 1059:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1060: 
 1061:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1062: 
 1063:    }
 1064: 
 1065:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1066: 
 1067:    
 1068:    __forceinline__ __device__ Vector2 t12(void) const { return {-n.y, n.x}; } // Unitary tangent vector from n1 to n2
 1069:    __forceinline__ __device__ Vector2 t21(void) const { return {n.y, -n.x}; } // Unitary tangent vector from n2 to n1
 1070:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1071:    __forceinline__ __device__ Vector2 t(const Node *node) const { if (node == n2) return t12(); else return t21(); } // Tangent vector towards node
 1072: 
 1073: 
 1074:    __forceinline__ __device__ double relativeSignedDistanceToPoint(Vector2 x) const {
 1075:       // Compute the relative (to the length) signed distance from the point to the side. It is positive if the point is to the side where n is pointing, negative otherwise.
 1076:       return dot(x - center, n)/len;
 1077:    }
 1078: 
 1079:    __forceinline__ __device__ bool containsPoint(Vector2 x) const;
 1080: 
 1081: 
 1082:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1083:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1084:    __inline__ __device__ int iadv(void) const;
 1085: 
 1086:    __inline__ __device__ double grav3(void) const;
 1087:    
 1088:    __inline__ __device__ double eta2(void) const;
 1089:    __inline__ __device__ double eta1(void) const;
 1090:    __inline__ __device__ double depth(void) const;
 1091:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1092:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1093:    __inline__ __device__ double w2(int k) const;
 1094: 
 1095:    __inline__ __device__ double dfv(int k) const;
 1096: 
 1097:    __inline__ __device__ double veg_h(void)  const;
 1098:    __inline__ __device__ double veg_nv(void) const;
 1099:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1100:    __inline__ __device__ double veg_alpha3D(int k) const;
 1101:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1102: 
 1103:    __inline__ __device__ double Cd(void) const;
 1104: 
 1105:    __inline__ __device__ Vector2 tau(void) const;
 1106: 
 1107:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1108:    
 1109: 
 1110:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1111:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1112:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1113:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1114:    } 
 1115:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1116:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1117:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1118:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1119: 
 1120:    // Get valid starting element (for backtracking)
 1121:    __inline__ __device__ Element* getStartElement() {
 1122:       return elems[0] ? elems[0] : elems[1];
 1123:    }
 1124: 
 1125:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
 1126:       // From the elements that share this side, find the one that is in the direction opposite to the velocity vector
 1127:       // (unless it is a boundary side or a dry element, in which case we return the only wet element)
 1128: 
 1129:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
 1130: 
 1131:       // Dot product of the negative velocity vector with the side normal vector
 1132:       const double dot_prod1 = -dot(u, n);
 1133: 
 1134:       // Vector from side center to element 0 centroid
 1135:       const Vector2 v2 = elems[0]->center - center;
 1136: 
 1137:       // Dot product of the vector with the side normal vector
 1138:       const double dot_prod2 = dot(v2, n);
 1139: 
 1140:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
 1141:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
 1142: 
 1143:       const bool isDry0 = elems[0]==nullptr || elems[0]->isDry;
 1144:       const bool isDry1 = elems[1]==nullptr || elems[1]->isDry;
 1145: 
 1146:       assert(!isDry0 || !isDry1 && "Both elements are dry in findElementTowards");
 1147: 
 1148:       if (dot_prod1*dot_prod2 > 0.0) return !isDry0 ? elems[0] : elems[1];
 1149:       else                           return !isDry1 ? elems[1] : elems[0];
 1150: 
 1151:  
 1152:    }
 1153: 
 1154:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1155:       // Given an element, returns the other element that shares this side
 1156:       return (elems[0] == elem) ? elems[1] : elems[0];
 1157:    }
 1158: 
 1159:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1160:       // Given a node, returns the other node that shares this side
 1161:       return (n1 == node) ? n2 : n1;
 1162:    }
 1163:  
 1164:    __inline__ __device__ Vector2 btrack(int jlev, double dt, double dtbk) const;
 1165: 
 1166: 
 1167: 
 1168: 
 1169: };
