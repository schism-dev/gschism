10268: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
10269:    Node *nodes = mesh->localNodeData;
10270: 
10271:    *addr = nodes;
10272:    *sizeNode = sizeof(Node);
10273: 
10274:    switch (varCode) {
10275:       case (int)VarCode::depth:
10276:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
10277:          *sizeType = sizeof(double);
10278:          break;
10279:       case (int)VarCode::eta:
10280:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
10281:          *sizeType = sizeof(double);
10282:          break;
10283:       case (int)VarCode::x:
10284:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
10285:          *sizeType = sizeof(Vector2);
10286:          break;
10287:       case (int)VarCode::z:
10288:          *offset = (int)((char*)&nodes[0].z - (char*)nodes);
10289:          *sizeType = sizeof(double);
10290:          break;
10291:       case (int)VarCode::kb:
10292:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
10293:          *sizeType = sizeof(int);
10294:          break;
10295:       case (int)VarCode::isdry:
10296:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
10297:          *sizeType = sizeof(int);
10298:          break;         
10299:       case (int)VarCode::w:
10300:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
10301:          *sizeType = sizeof(double);
10302:          break;
10303:       case (int)VarCode::u:
10304:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
10305:          *sizeType = sizeof(Vector2);
10306:          break;  
10307:       case (int)VarCode::u_air:
10308:          *offset = (int)((char*)&nodes[0].u_air - (char*)nodes);
10309:          *sizeType = sizeof(Vector2);
10310:          break;
10311:       default:
10312:          *offset = -1;    
10313:    }  
10314:    
10315: }
