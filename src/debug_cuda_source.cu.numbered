 1785: // Helper functions for computing the local node index at a given offset from another.
 1786: __device__ __inline__ int nxq(int offset, int index, int size) {
 1787:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1788:    // to the index to make it positive
 1789:    assert(index + offset + 16*size >= 0);
 1790:    return (index + offset + 16*size) % size;  
 1791: }
 1792: 
 1793: __device__ __inline__ int nxq(int index, int size) {
 1794:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1795:    // to the index to make it positive
 1796:    assert(index + 16*size >= 0);
 1797:    return (index + 16*size) % size; 
 1798: }
