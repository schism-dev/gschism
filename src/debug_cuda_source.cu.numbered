 3357: 
 3358: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 3359:    const double w1 = getBoundaryArrayValueWeight();
 3360:    const double w2 = 1.0 - w1;
 3361:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3362:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3363: 
 3364:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 3365: 
 3366: }
