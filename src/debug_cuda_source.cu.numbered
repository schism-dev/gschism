 9300: extern "C" __global__ void getElementVar(int varCode, void *res, int k) {
 9301:    ELEM(elem);
 9302: 
 9303:    switch (varCode) {
 9304:       case (int)VarCode::outputCoords: {
 9305:          const Point2 coords = elem->outputCoords();
 9306:          double *out = (double *)((char *)res + idx_elem * 16);
 9307:          out[0] = coords.x;
 9308:          out[1] = coords.y;
 9309:          break;
 9310:       }
 9311:       case (int)VarCode::FaceIndices: {
 9312:          uintptr_t *out = (uintptr_t *)((char *)res + idx_elem * 32);
 9313:          for (int j = 0; j < 4; j++)
 9314:             out[j] = (j < elem->i34 && elem->nodes[j]) ? elem->nodes[j]->idx + 1 : -1;
 9315:          break;
 9316:       }
 9317:       case (int)VarCode::isdry:
 9318:          *(int *)((char *)res + idx_elem * 4) = (int)elem->isDry;
 9319:          break;
 9320:       case (int)VarCode::w: {
 9321:          double *out = (double *)((char *)res + idx_elem * nvrt * 8);
 9322:          if (k >= 0)
 9323:             out[0] = elem->w[k];
 9324:          else
 9325:             for (int lev = 0; lev < nvrt; lev++)
 9326:                out[lev] = elem->w[lev];
 9327:          break;
 9328:       }
 9329:    }
 9330: }
