 6683:    __global__ void computeVerticallyIntegratedVelocity(void) {
 6684: 
 6685:       SIDE(side);
 6686: 
 6687:       side->U = {0.0, 0.0}; 
 6688:          
 6689:       if(side->isDry) return;
 6690: 
 6691:       // Vertically integrated velocity U
 6692:       #pragma unroll 1
 6693:       for (int k = side->kb; k < nvrt - 1; k++) { 
 6694: 
 6695:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 6696: 
 6697:          side->U += side->Dz(k + 1)*uc;  
 6698: 
 6699:       }
 6700:    }
 6701: 
 6702:    __global__ void computeBottomDragVegetation(void) {
 6703:       // UNFINISHED. CHECK THIS: XXXXX
 6704:       // How many kernels are needed? Why so many for loops?
 6705:       // Is the loop on sides needed?
 6706: 
 6707:       NODE(node);
 6708: 
 6709:       const int    kb      = node->kb;
 6710:       const double htot    = node->htot2(); 
 6711:       
 6712:       if (node->isDry) {
 6713:          // Default values for dry nodes
 6714:          node->veg_alpha_vert_mean = node->veg_alpha0;
 6715:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 6716: 
 6717:          return;
 6718:        
 6719:       }
 6720: 
 6721:       // Computes bottom drag Cd based on the selected nchi
 6722:       node->computeBottomDragCd();
 6723:       
 6724: 
 6725: 
 6726:       //   Bottom stress in m^2/s^2
 6727:       if (node->rho[kb + 1] >= -98.0)
 6728:       {
 6729:          const double mag_u = length(node->u2[kb + 1]);
 6730:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 6731: 
 6732:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 6733:          // !sediment erosion: this part needs more documentation
 6734:       }
 6735:     
 6736: 
 6737: 
 6738:       // Compute vegetation parameters
 6739:       //--------------------------------
 6740: 
 6741: 
 6742:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 6743:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 6744: 
 6745:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 6746:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 6747:          int kbin = 0; // bin index
 6748:          for (int k = kb; k < nvrt; k++) {
 6749:             // Computes node height above the bottom level
 6750:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 6751:             assert(false && "Vertical variation of vegetation not implemented");
 6752: 
 6753:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 6754:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 6755:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 6756:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 6757:             // } else {
 6758:             //    // Find the bin at which the current vertical level is
 6759:             //    while (kbin<nbins_veg_vert) {
 6760:             //       const double zn = node->z[kbin];
 6761:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 6762:             //          break;
 6763:             //       } // if
 6764:             //       kbin++;
 6765:             //    } // while
 6766:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 6767: 
 6768:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 6769:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 6770:                
 6771:             //    // Linear interpolation of the vegetation parameters
 6772:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 6773:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 6774:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 6775:             // } // if rl10
 6776: 
 6777:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 6778: 
 6779:          } // for k
 6780: 
 6781: 
 6782:       } else { // Ganthy (iveg==2)
 6783:       //  Modify canopy height, diameter, and density
 6784: 
 6785:          // Make sure there is vegetation on this node
 6786:          if (node->veg_h_unbent > 0.0) {
 6787:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 6788: 
 6789:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 6790:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 6791:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 6792: 
 6793:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 6794:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 6795:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 6796:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 6797:          } // if veg_h_unbent
 6798: 
 6799:          for (int k = 0; k < nvrt; k++) {
 6800:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 6801:          } // for k
 6802:       
 6803: 
 6804:       } // if iveg
 6805:      
 6806: 
 6807:       // Compute vertical mean of veg_alpha3D
 6808:       if (iveg != 0) {
 6809:          const double ztop = node->zTopCanopy(); // Top of the canopy
 6810:          double sum1=0.0;
 6811:          double sum2=0.0;
 6812:          // Integrate over each level under the canopy...
 6813:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 6814:             const double Dz = node->Dz(k);
 6815: 
 6816:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 6817:             sum2 += Dz;
 6818: 
 6819:          } // for k
 6820:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 6821:          else             node->veg_alpha_vert_mean = sum1/sum2;
 6822: 
 6823:       } // if iveg
 6824: 
 6825:    }
