 1833: 
 1834: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1835:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1836: 
 1837:    printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 1838: 
 1839:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1840:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1841:    // curElement.
 1842: 
 1843:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1844:    // And uses this velocity instead to continue the tracking.
 1845: 
 1846:    // computes the intersection point in cartesian coordinates
 1847:    Point2 intersection = nextSide->p_t(tt);
 1848: 
 1849:    // Nudges the point to the barycenter of the element. 
 1850:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1851:    // next segment intersects the element sides.  
 1852:    curElem->nudgeToBarycenter(intersection);
 1853: 
 1854:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1855:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1856:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1857:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1858: 
 1859:    // If the side is an open boundary, the tangential velocity is zero.
 1860:    if (nextSide->isBnd()) vtan = 0.0;
 1861: 
 1862:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1863:    const double us = vtan*nextSide->t().x;
 1864:    const double vs = vtan*nextSide->t().y;
 1865:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1866: 
 1867:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1868:    const double len2 = norm2(intersection - toPoint2(xt));
 1869:    const double vel2 = dot(u_int, u_int);        
 1870:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 1871:    else            dt = 0.0;
 1872: 
 1873:    // The end of this tracking segment is now the intersection point.
 1874:    xt = {intersection.x, intersection.y, zint};
 1875: printf("BBB u_int = %f,%f,%f\n", us, vs, ws);   
 1876:    u_int = {us, vs, ws};
 1877:    
 1878: }
 1879: 
 1880: /**
 1881:  * Tracks a particle through elements and vertical levels in the mesh.
 1882:  * 
 1883:  * @param x0,y0,z0     Starting position coordinates
 1884:  * @param xt,yt,zt     Target position coordinates
 1885:  * @param dtb          Time step for tracking
 1886:  * @param uuint,vvint,wwint Initial velocity components
 1887:  * @param nextElem     Starting/resulting element index
 1888:  * 
 1889:  * @return Status code of type trackExitCodes
 1890:  * 
 1891:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1892:  * of the details are different. The idea is that the code requires less branches and is better fit
 1893:  * for GPU execution.
 1894:  * 
 1895:  * The main ideas here are:
 1896:  * - The starting point is expected to be in the starting element.
 1897:  * - The end point is guaranteed to be inside an element.
 1898:  * - since the starting point is inside the element, there are only two cases: 
 1899:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1900:  *     (b) it does not and (xt,yt) is already in the starting element.
 1901:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1902:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1903:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1904:  * - tt1 can be positive or negative. We only consider the positive values.
 1905:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1906:  * - The next intersection will occur at the smallest positive tt1.
 1907:  * - This intersection will be the next (x0,y0) position.
 1908:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1909:  *   of getting stuck in a loop.
 1910:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1911:  *   was found.
 1912:  */
 1913: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1914:                                                        Element *&nextElem, int &jlev, double &dt) {
 1915: 
 1916:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 1917:    // else to do.
 1918:    // If it is, nudges the point to be inside the element.
 1919:    const Element *curElem = nextElem;
 1920:    if (containsPoint(toPoint2(xt), true)) {
 1921: 
 1922:       curElem->interpolateVelocities(xt, u_int);
 1923: 
 1924:       return true;
 1925:    }
 1926: 
 1927:    Side *side = nullptr;
 1928: 
 1929:    // 1. Initial checks
 1930:    // Verify starting element is valid (wet)
 1931:    assert(!curElem->isDry && "Starting element is dry");
 1932: 
 1933:    // Checks if track has a zero length.
 1934:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1935:    // assert(len2 > 0.0 && "Zero length track"); 
 1936:    
 1937:    const int MAX_ITERATIONS = 1000;
 1938:    
 1939:    double t;
 1940:    Side *nextSide = nullptr;
 1941:    double tIntersect = 1e10;
 1942:    double zint = x0.z;
 1943: 
 1944:    // Horizontal tracking loop
 1945:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1946:    // (x0,y0) is inside the element but the target point is not.
 1947: 
 1948:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1949: 
 1950:    assert(found_intersection && "No intersection found at %d");
 1951: 
 1952:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1953: 
 1954:    // if the tracking segment goes out of water (either dry or edge boundary)
 1955:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1956: 
 1957: 
 1958:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1959: 
 1960:       nextElem = this;
 1961:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1962:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1963:       return true;    
 1964:    }
 1965: 
 1966: 
 1967:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1968:    int iterations = 0;
 1969:    while (iterations < MAX_ITERATIONS) {
 1970:       iterations++;
 1971:       
 1972:       Element *curElem = nextElem;
 1973: 
 1974:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1975: 
 1976:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1977: 
 1978:       // If we are already in the target element, we are done.
 1979:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1980:       if (!found_intersection) break;
 1981: 
 1982: 
 1983: 
 1984:       // if the tracking segment goes out of water (either dry or edge boundary).
 1985:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1986: 
 1987:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1988: 
 1989:          nextElem = curElem;
 1990: 
 1991:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1992:          // In this case, the caller (btrack) needs to take into account the remaining time.
 1993:          return true;
 1994:       }
 1995:       
 1996:       // Update position and element for next iteration
 1997:       side = nextSide;
 1998: 
 1999:    }
 2000: 
 2001:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 2002: 
 2003:  
 2004:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2005:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2006:    nextElem->interpolateVelocities(xt, u_int);
 2007: 
 2008: 
 2009:    return true;
 2010: }
 2011: 
 2012: 
 2013: __inline__ __device__ double Element::computeSignedArea(void) const {
 2014:    // Compute the area of the element
 2015: 
 2016:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 2017: 
 2018:    // In the quad case we need to add the area of the other triangle.
 2019:    if (isQuad()) {
 2020:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2021:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 2022:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2023:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 2024:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 2025:          Error("Negative area found in quad element");
 2026:       }
 2027:       res += ar1;
 2028:    }
 2029: 
 2030:    return res;
 2031: }
 2032: 
 2033: 
 2034: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2035:                                                                 (nodes[1]->isDry2()) ||
 2036:                                                                 (nodes[2]->isDry2()) ||
 2037:                                                                 (i34==4 && nodes[3]->isDry2());
 2038: }
 2039: 
 2040: 
 2041: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2042:    // In boundary sides, the element 1 is nullptr
 2043:    return side->elems[1] == nullptr; 
 2044: }
 2045: 
 2046: 
 2047: 
 2048: /**
 2049:    Compute the shape coordinates of the point (xt,yt) in the element.
 2050:    @param xt (input): x-coordinate of the point
 2051:    @param shpCoords (output): shape coordinates of the point
 2052:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2053:    @return true if the point is inside the element, false otherwise
 2054: **/
 2055: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2056:                                             bool fixNegshpCoord) const {
 2057: 
 2058:    // Compute the shape coordinates of the point xt in the element.
 2059:    if (i34==3) {
 2060:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2061:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2062:       // and in this case, the pt will be nudged into the element
 2063:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2064:       // from the local frame, so use additional check.
 2065: 
 2066:       Point2 x0, x1, x2;
 2067: 
 2068:       if constexpr(ics==1) {
 2069:          x0 = nodes[0]->p2();
 2070:          x1 = nodes[1]->p2();
 2071:          x2 = nodes[2]->p2();
 2072:       }
 2073:       else // lat/lon
 2074:       {
 2075:          Error("Not implemented yet");
 2076: #ifdef ICS2
 2077:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2078:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2079:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2080: #endif
 2081:       }
 2082: 
 2083:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2084:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2085:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2086:       shpCoords[3] = 0.0;
 2087:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2088: 
 2089:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2090:       // then we fix the negative shape coordinates.
 2091:       if (fixNegshpCoord && tmpmin<=0.0) {
 2092: 
 2093:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2094:          // keeping the sum of the shape coordinates equal to 1.
 2095:          // I have tested and compared the new algorithm with the old one, and they give
 2096:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2097:          // The new algorithm should be faster since it is branchless.
 2098:          const double a = - tmpmin + 1.0e-2;  // XXX it used to be 1.0e-4 in the comments of the original code
 2099:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2100:          
 2101:          shpCoords[0] = (shpCoords[0] + a)*b;
 2102:          shpCoords[1] = (shpCoords[1] + a)*b;
 2103:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2104: 
 2105:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2106:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2107:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2108:          }
 2109: 
 2110:          // Update the point coordinates for the new shape coordinates
 2111:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2112:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2113:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2114: 
 2115:       }
 2116: 
 2117:       // Check if the point is inside the element
 2118:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2119:    }
 2120:    else {
 2121:       Error("Not implemented yet");
 2122: #ifdef QUADS
 2123:       // Reproject pt in eframe of nel for ics=2
 2124:       if constexpr(ics==1) {
 2125:          xn2 = xt; 
 2126:          yn2 = yt;
 2127:       }
 2128:       else {
 2129:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2130:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2131:       }
 2132: 
 2133:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2134: #endif
 2135:    }
 2136: 
 2137:    return false;  // Never reached
 2138: 
 2139: }
 2140: 
 2141: 
 2142: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2143: // Convert shape coordinates to cartesian coordinates
 2144: 
 2145:    if (i34 == 3) {
 2146:       // Triangular element
 2147:       double xcoords[3] = {nodes[0]->p2().x, nodes[1]->p2().x, nodes[2]->p2().x};
 2148:       double ycoords[3] = {nodes[0]->p2().y, nodes[1]->p2().y, nodes[2]->p2().y};
 2149:    }
 2150:    else {
 2151:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2152:    }
 2153: 
 2154: }
 2155: 
 2156: 
 2157: /**  Interpolate velocities at a given point (xt,yt,zt)
 2158: 
 2159:    @param xt, yt, zt: coordinates of the point to interpolate
 2160:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2161: 
 2162:    This is done in four steps:
 2163: 
 2164:    1. Find the shape coordinates for the final position in the element.
 2165:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2166:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2167:       z levels at xt, yt at each step.   
 2168:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2169:       horizontally and vertically.
 2170: **/
 2171: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2172:    // Interpolate the velocities at the point xt. 
 2173:    // This function works the same for triangular and quadrilateral elements.
 2174:    double shpCoord[4];
 2175: 
 2176: // printf(" ___BBB02____ idx = %d, u_int = %.17g,%.17g,%.17g, u1 = %.17g,%.17g,%.17g, u2 = %.17g,%.17g,%.17g, u3 = %.17g,%.17g,%.17g\n", idx, u_int.x, u_int.y, u_int.z, nodes[0]->u2[0].x, nodes[0]->u2[0].y, nodes[0]->u2[0].z, nodes[1]->u2[0].x, nodes[1]->u2[0].y, nodes[1]->u2[0].z, nodes[2]->u2[0].x, nodes[2]->u2[0].y, nodes[2]->u2[0].z);         
 2177:    // First step is to compute the shape coordinates of (xt,yt)
 2178:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2179:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2180: 
 2181:    // Second step is to find the level that contains zt
 2182:    // Uses a binary search to find the level
 2183:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2184:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2185:    int R = nvrt - 1;
 2186: 
 2187:    // Get the z coordinates at the nodes of the element at the levels L and R
 2188:    double zLAtNodes[4], zRAtNodes[4];
 2189:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2190:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2191: 
 2192:    double zL = interpolate(shpCoord, zLAtNodes);
 2193:    double zR = interpolate(shpCoord, zRAtNodes);
 2194:    
 2195:    // Interpolates vertically the velocities
 2196:    double wght1, wght2;
 2197:    if (xt.z<=zL) {
 2198:       wght1 = 1.0;
 2199:       wght2 = 0.0;
 2200:    }
 2201:    else if (xt.z>=zR) {
 2202:       wght1 = 0.0;
 2203:       wght2 = 1.0;
 2204:    }
 2205:    else {
 2206:       // Perform a binary search to find the levels between L and R that contain xt.z
 2207:       while (R - L > 1) {
 2208:          int M = (L + R) / 2;
 2209: 
 2210:          double zMAtNodes[4];
 2211:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2212:          double zM = interpolate(shpCoord, zMAtNodes);
 2213:          if (zM < xt.z) 
 2214:          {
 2215:             L = M;
 2216:             zL = zM;
 2217:          }
 2218:          else 
 2219:          {
 2220:             R = M;
 2221:             zR = zM;
 2222:          }
 2223:       }
 2224:       assert(L == R-1);
 2225:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2226: 
 2227:       wght2 = (xt.z - zL)/(zR - zL);
 2228:       wght1 = 1.0 - wght2;
 2229:    }
 2230: 
 2231:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2232:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 2233: 
 2234:    // Neither of the interpolated velocities should be NaN
 2235:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2236: 
 2237: }
