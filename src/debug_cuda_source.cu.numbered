 2774: __device__ __inline__ void Node::updateZCoordData(void) {
 2775: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2776: 
 2777:    // assert(!isDry2() && "updateZCoordData: node is dry");
 2778:    // if (isDry2()) {
 2779:    //    kb = -1;  // XXXXXXXX KKKKK
 2780:    //    return;
 2781:    // }
 2782: 
 2783: 
 2784:    if constexpr(ivcor == 2) {  // SZ coordinates
 2785:       
 2786:       // Compute bottom level index
 2787:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 2788:    } 
 2789:    else if (ivcor == 1) {  // Localized sigma
 2790:       // Do nothing
 2791:    }
 2792: 
 2793: 
 2794: }
