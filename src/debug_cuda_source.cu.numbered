 6384:    __global__ void resetVelocityOpenBndNodes(void) {
 6385:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6386: 
 6387:       NODE_BND(nodebnd);
 6388: 
 6389:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6390:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 6391:       }
 6392: 
 6393:    }
 6394: 
 6395: 
 6396:    __global__ void setVelocityOpenBndNodes(void) {
 6397:    // For open boundary nodes sets their velocity to the imposed values.
 6398: 
 6399:       SIDE_BND(sidebnd);
 6400: 
 6401:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6402:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6403:          // to its segment to the average of the side velocity.
 6404: 
 6405:          for (int k = 0; k < nvrt; k++) {
 6406:             Node *n1 = sidebnd->side->n1;
 6407:             Node *n2 = sidebnd->side->n2;
 6408: 
 6409: 
 6410:             Vector2 n1_u2(n1->u2[k]);
 6411:             Vector2 n2_u2(n2->u2[k]);
 6412: 
 6413:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6414:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6415:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6416:             }
 6417:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6418:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6419:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6420:             }
 6421: 
 6422:          }
 6423: 
 6424:       }
 6425: 
 6426:    }
 6427: 
 6428: 
 6429:    __global__ void computeVerticalVelocity(void) {
 6430:       // Computes the vertical velocity at the (2D) element's centroid.
 6431:       // In this function we will be considering volumetric elements, with side faces and a 
 6432:       // bottom and a top face. We will call them SFs, BF and TF.
 6433:       // It computes the flux coming from BF and the SFs.
 6434:       // If the bed is moving, it takes that into account.
 6435:       // Since water is incompressible, the integral of the velocity times the normal vector
 6436:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6437:       // and the BF is equal to the flux going out from the TF.
 6438:       // TF = - BF - sum(SFs).
 6439:       // It then computes the horizontal velocity at the center of TF.
 6440:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6441:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6442:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6443: 
 6444:       ELEM(elem);
 6445: 
 6446:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 6447: 
 6448:       if (elem->isDry) return;
 6449: 
 6450:       const int kb = elem->kb;
 6451:       const bool isTri = elem->isTri();
 6452: 
 6453:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6454: 
 6455:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6456:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6457:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6458: 
 6459:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6460: 
 6461:       double area3D;
 6462: 
 6463:       // Bottom face flux
 6464:       double bottomFlux = 0.0;
 6465:       Vector2 u2meanBottom = {0.0, 0.0};
 6466:       const Vector2 gradh = elem->grad2(&Node::depth);
 6467:       if constexpr(imm==2) {
 6468:          Vector3 ubed;
 6469: 
 6470:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6471:          // updateBDEF(ubed);
 6472:      
 6473:          // const double bflux0 = dot(ubed, elem_n1);
 6474: 
 6475:          // elem->w[kb] += ubed.z;
 6476:       }
 6477:       else {
 6478:          Vector2 umean;
 6479:          if constexpr(ics == 1) {
 6480:             u2meanBottom = elem->mean(kb, &Side::u2);
 6481:          }
 6482:          else {
 6483:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6484:          }
 6485: 
 6486:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6487:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6488: 
 6489:          bottomFlux = - dot(gradh, u2meanBottom);
 6490:       } // if imm
 6491: 
 6492:       // Compute w for kb+1 to nvrt-1
 6493:       for (int l = kb; l < nvrt - 1; l++) {
 6494: 
 6495:          // normal vector to the top face of the "volumetric" element (3D)
 6496:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6497: 
 6498:          // Compute the total flux at the sides
 6499:          double sideFlux = 0.0;
 6500: 
 6501:          for (int j = 0; j < elem->i34; j++) {
 6502:             const Side *side = elem->sides[j];
 6503: 
 6504:             const double sideArea = side->area(l);
 6505:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6506:             const double sign = elem->ssign[j]; 
 6507: 
 6508:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6509:          }
 6510:          
 6511:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6512:          //velocities at the centers of the sides
 6513:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6514: 
 6515:          // The flx at the top ace can be computed from the other flows.
 6516:          const double topFlux = - sideFlux - bottomFlux;
 6517:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6518: 
 6519:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6520: 
 6521:          elem_n1 = elem_n2;
 6522: 
 6523:          bottomFlux = - topFlux;
 6524:       }
 6525:    }  
 6526: 
 6527: 
 6528: 
 6529: 
 6530: 
 6531: 
 6532: 
 6533: // !===============================================================================
 6534: // !===============================================================================
 6535: 
 6536: } // extern "C"
 6537: 
 6538: #ifdef DONTCOMPILE
 6539: __device__ void computeVerticalAdvection(void) {
 6540:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6541: 
 6542:    sdbt(1:2,:,:)=0.d0
 6543: 
 6544:    const Side *side = FROM kernel;
 6545: 
 6546:    if(side->isDry) return;
 6547: 
 6548:    // If side is wet...
 6549: 
 6550: 
 6551:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6552:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6553:    double ws[nvrt] = {} // w @ side
 6554:    int icount = 0;
 6555:    for (int j=0; j<2; j++) {
 6556:       const Element *elem = side->elements[j];
 6557:        
 6558:       if(elem != nullptr) {
 6559:          icount++;
 6560:          for (int k=0; k<nvrt; k++) {
 6561:             ws[k] = ws[k] + elem->w[k];
 6562:          }
 6563:       }
 6564:    }  // for j
 6565: 
 6566:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6567:    ws = ws/icount;
 6568: 
 6569:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6570:    // Splines allow for a smooth transition between vertical levels.
 6571:    // Splines have continuity restrictions at the internal knots, but
 6572:    // we have to provide the 1st derivatives at the endpoints.
 6573:    const int kbs = side->kbs; 
 6574:    
 6575:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6576:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6577:    initCubicSpline(kbs, nvrt, side, ws, up)
 6578: 
 6579:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6580:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6581:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6582: 
 6583:    // Total advection (average onto side)
 6584:    const Node *node1 = side->nodes[0];
 6585:    const Node *node2 = side->nodes[1];
 6586:    for (int k=kbs(i); k<nvrt; k++) {
 6587: 
 6588:       if constexpr(ics==1) {
 6589:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6590:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6591:       } else {
 6592:          // XXX IMPLEMENT THIS
 6593:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6594:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6595:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6596:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6597:       }  // if ics
 6598: 
 6599: 
 6600:    }
 6601: }
 6602: #endif
 6603: 
 6604: 
 6605: extern "C" {
 6606:    __global__ void computeElemAverageGhat(void) {
 6607:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6608: 
 6609:       ELEM(elem);
 6610:       
 6611:       elem->ghat1= {0.0, 0.0};  
 6612: 
 6613:       if constexpr(ihydraulics != 0) {
 6614:          if (nhtblocks > 0 && elem->isblock) return;
 6615:       }
 6616: 
 6617: 
 6618: 
 6619:       
 6620:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6621:       // tidal potential, horizontal diffusion, and baroclinic etc
 6622:       // Remember to update both fb and F 
 6623:       // If ics=2, ghat1 are in eframe (ll)
 6624:       // cff1-3: coefficients for 2D/3D
 6625:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6626:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6627:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6628: 
 6629:       if (elem->isDry) return;
 6630: 
 6631:       double av_cff1 = 0.0;  // av. for cff1
 6632:       double av_cff2 = 0.0;  // av. for cff2
 6633:       double av_cff3 = 0.0;  // av. for cff3
 6634:       double av_df = 0.0;  // av. for H^\alpha / H
 6635:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6636:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6637: 
 6638:       const int i34 = elem->i34;
 6639:       const int kb = elem->kb;
 6640: 
 6641:       for (int j=0; j<i34; j++) {
 6642:          // For each node and side in the element...
 6643: 
 6644:          const Node *node = elem->nodes[j];
 6645:          const Side *side = elem->sides[j];
 6646: 
 6647:          const double chi      = side->chi;
 6648:          const double veg_c2   = side->veg_c2;
 6649:          const double veg_beta = side->veg_beta;
 6650:          const double veg_h    = side->veg_h();
 6651:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6652: 
 6653:          // Node - const in elem
 6654:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6655:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6656: 
 6657:          if (elem->depth >= tip_dp) {
 6658:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6659:          }
 6660: 
 6661:          
 6662:          const double htot  = side->htot2();        // Total depth at the side
 6663:          const double zctr2 = side->zTopCanopy();  
 6664: 
 6665:          double cff1; 
 6666:          double cff2; 
 6667:          double cff3;   
 6668:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6669:          // coefficients applied to 2D/3D case 
 6670:             cff1 = side->hhat/htot;
 6671:             cff2 = 0.0;
 6672:             cff3 = 0.0;
 6673:          } else { //3D
 6674:             //Init for no-veg case
 6675:             cff1 = 1.0;
 6676:             cff2 = 1.0;
 6677:             cff3 = 0.0;
 6678: 
 6679:             if constexpr(iveg != 0) {
 6680:                // Computes coefficients used with vegetation terms G1, G2
 6681:                // cff1, cff3 are used for the first two terms in G1, G2:
 6682:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6683:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6684:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6685:                if(veg_h < 0.99*htot) { // submergent vegetation
 6686:                   cff1=1;
 6687:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6688:                   cff3 = veg_c;
 6689: 
 6690:                } else { // emergent vegetation
 6691:                   cff1 = 1.0/(1.0 + veg_c2);
 6692:                   cff2 = cff1;
 6693:                   cff3 = 0.0;
 6694: 
 6695:                }
 6696:             } // if iveg
 6697:          } //  2D/3D
 6698: 
 6699:          av_cff1 += cff1/i34;
 6700:          av_cff2 += cff2/i34;
 6701:          av_cff3 += cff3/i34;
 6702:          av_cff2_chi += cff2*chi/i34;
 6703:          av_cff3_chi += cff3*chi/i34;
 6704:          av_df += min(htot, veg_h)/(htot*i34);
 6705: 
 6706: 
 6707:          // btrack values: U^\star, U^{\star\alpha}
 6708:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6709:          Vector2 Ustar       = {0.0, 0.0}; 
 6710:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6711: 
 6712:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6713:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6714:          } else { //3D
 6715:             for (int k = side->kb + 1; k < nvrt; k++) {
 6716:             
 6717:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6718:                Ustar += w2;
 6719: 
 6720:                if constexpr(iveg != 0) {
 6721:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6722:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6723:                        Ustar_alpha += zrat*w2; // XXXX
 6724:                    }
 6725:                }  // if iveg
 6726:             }  // for k
 6727:          }  //2D/3D
 6728:          
 6729: 
 6730:          // Add btrack & surface stress terms to \breve{G} first
 6731:          if constexpr(ics==1) {
 6732: 
 6733:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6734: 
 6735:          } else {
 6736:             assert(false && "computeElemAverageGhat: Not implemented");
 6737:             // XXX IMPLEMENT THIS
 6738:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6739:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6740:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6741:          }  // if ics
 6742: 
 6743:          // Surface and bottom stress terms
 6744:          if constexpr(ics==1) {
 6745:             const Vector2 tau    = side->tau();
 6746:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6747: 
 6748:             // Term for surface and bottom stress
 6749:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6750: 
 6751:          } else {
 6752:             assert(false && "computeElemAverageGhat: Not implemented");
 6753:             // XXX IMPLEMENT THIS
 6754:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6755:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6756:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6757:             // tau_x=(vn1+tt1)/2.d0
 6758:             // tau_y=(vn2+ss1)/2.d0
 6759:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6760:          }  // if ics
 6761: 
 6762:          
 6763: 
 6764:          // All terms in F,F^\alpha,f_b except baroclinic
 6765:          // F, f_b: all explicit terms excluding vegetation 
 6766:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6767:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6768:          const double coriolis = side->coriolis;
 6769:          Vector2 F  =  coriolis*side->U;  // F_x
 6770:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6771:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6772: 
 6773:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6774:             
 6775:             for (int k = side->kb; k < nvrt; k++) {
 6776:                if (zctr2 > side->zc[k-1]) {
 6777:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6778:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6779:                    Fa +=  coriolis*w2*zrat;
 6780:                } // if zctr2
 6781:             } // k
 6782:          } // iveg
 6783: 
 6784:          // Integrate horizontal viscosity force vertically
 6785:          for (int k=side->kb + 1; k<nvrt; k++) {
 6786:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6787: 
 6788:             F += levelHorVisc;
 6789: 
 6790:             // Vegetation term
 6791:             if constexpr(iveg!=0) {
 6792:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6793:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6794:                   Fa += levelHorVisc*zrat;
 6795:                } 
 6796:             } // if iveg
 6797:          } // for k
 6798: 
 6799:          fb += side->nuGradU[side->kb];
 6800: 
 6801:          // Add to ghat1
 6802:          if constexpr(ics==2) {
 6803:             assert(false && "computeElemAverageGhat: Not implemented");
 6804:             // XXX IMPLEMENT THIS
 6805:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6806:             // bigf1=vn1; bigf2=vn2
 6807:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6808:             // botf1=vn1; botf2=vn2
 6809:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6810:             // bigfa1=vn1; bigfa2=vn2
 6811:          } // if ics
 6812: 
 6813:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6814:       } // for j (nodes and sides)
 6815: 
 6816:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6817:          
 6818:       // Finish off terms in F, F^\alpha and f_b
 6819:       const double grav3 = elem->mean(&Node::grav2);
 6820:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6821: 
 6822: 
 6823:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6824:       for (int j=1; j<i34; j++) { 
 6825:          // For each side in the element...
 6826:          const Side *side = elem->sides[j];
 6827:          const double chi = side->chi;
 6828: 
 6829:          const double htot = side->htot2();
 6830:          const double veg_h = side->veg_h();
 6831:          const Vector2 F  = htot*fb;
 6832:          const Vector2 Fa = min(htot, veg_h)*fb;
 6833: 
 6834:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6835:       } // for j
 6836: 
 6837:       //botf1 etc are already in elem frame
 6838:       elem->ghat1 += tmp/i34;
 6839: 
 6840:       // Baroclinic force
 6841:       if constexpr(ibc==0) {
 6842:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6843: 
 6844:          Vector2 Fa = {0.0, 0.0};
 6845:          Vector2 intGradRho = {0.0, 0.0};
 6846:          
 6847:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6848:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6849:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6850: 
 6851:             // \in F [m^2/s/s]
 6852:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6853:          }
 6854: 
 6855:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6856:          const Vector2 F = av_df*Fa; //approx
 6857:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6858: 
 6859:       } // if ibc
 6860: 
 6861: 
 6862: 
 6863:    }
 6864: 
 6865: } // extern "C"
 6866: 
 6867: 
 6868: 
 6869: #ifdef DONTCOMPILE
 6870: __global__ void checkMassConservation(Tracers* sumtr) {
 6871: 
 6872:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6873: 
 6874:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6875: 
 6876:    Element *elem = &(mesh->localElemData[i]);
 6877: 
 6878:    // Skip dry elements
 6879:    if (elem->isDry) return;
 6880: 
 6881:    // Local sum array for this thread
 6882:    double localSum[N_TRACERS] = {0.0};
 6883: 
 6884:    // Sum over vertical levels for this element
 6885:    const int kbe = elem->kbe;
 6886:    const double area = elem->area;
 6887: 
 6888:    for (int k = kbe; k < nvrt; k++) {
 6889:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6890:       
 6891:       // Accumulate tracer mass
 6892:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6893:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6894:       }
 6895:    }
 6896: 
 6897:    //  This function returns per element sums. A reduction must be done on the host side.
 6898: }
 6899: 
 6900: 
 6901: __global__ void transport(void) {
 6902: 
 6903:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6904: 
 6905:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6906: 
 6907:    Element *elem = &(mesh->localElemData[ie]);
 6908: 
 6909:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6910: 
 6911:                for (int m=0; m<ntr; m++) {
 6912:                   for (int k=kbe(ie); k<nvrt; k++) {
 6913:                      // Calculate each polynomial's weight 
 6914:                      wm=0.d0; sum1=0.d0; 
 6915:                      wm1=0.d0; wm2=0.d0; 
 6916:                      for (int i=0; i<elem->nweno2; i++) {
 6917:                   
 6918:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6919:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6920:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6921:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6922:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6923:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6924:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6925:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6926:                      // -----------------Hu and Shu (1999)'s method----------------
 6927:                      b4=b1+b2+b3
 6928: 
 6929: //Error: add PRODUCTION CPP
 6930: #ifdef DEBUG
 6931:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6932:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6933:                     call parallel_abort(errmsg)
 6934:                   }
 6935: #endif
 6936: 
 6937:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6938:                   // !----test-------------- 
 6939:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6940:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6941:                   // !wm(i)=wm1(i)*wm2(i)
 6942:                   // !---------------------- 
 6943:                   sum1=sum1+wm(i)
 6944:                 } // end for i
 6945: 
 6946:                 wm=wm/sum1
 6947: 
 6948:                 for (int j=0; j<elem->i34; j++) {
 6949: 
 6950:                   const Side *side  = elem->sides[j];
 6951:                   const Node *node1 = side->n1;
 6952:                   const Node *node2 = side->n2;
 6953: 
 6954:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6955:                      trsd=0.d0
 6956:                      for (int kk=0; kk<nquad; kk++) {
 6957:                         for (int i=0; i<elem->nweno2; i++) {
 6958:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6959:                         } // end for i   
 6960:                      } // end for kk
 6961:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6962:                   } // outward flux
 6963:                } // end for j=1,i34(ie) ! side
 6964:             }
 6965:          }
 6966:               
 6967: 
 6968: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6969: //             //   calculate each polynomial's weight 
 6970: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6971: //                 wm=0.d0; sum1=0.d0
 6972: //                 do i=1,nweno1(ie) !for each polynomial
 6973: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6974: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6975: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6976: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6977: //                   wm(i)=b2
 6978: //                   sum1=sum1+b2
 6979: //                   !wm(i)=1.d0
 6980: //                   !sum1=sum1+1.d0
