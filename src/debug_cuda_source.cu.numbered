  225: struct Bool4 {
  226:    unsigned int m; // bit i = lane i
  227: 
  228:    __device__ __forceinline__ bool get(int i) const { return (m >> i) & 1u; }
  229:    __device__ __forceinline__ void set(int i, bool v) {m = (m & ~(1u << i)) | ((unsigned int)(v) << i); }
  230: 
  231:    __device__ __forceinline__ bool all(void) const { return m == 0x0F; }
  232:    __device__ __forceinline__ bool any(void) const { return m != 0; }
  233:    __device__ __forceinline__ bool none(void) const { return m == 0; }
  234:    __device__ __forceinline__ int firstOne(void) const { return __ffs(m) - 1; }
  235: 
  236: };
  237: 
  238: __device__ __forceinline__ Bool4 operator!(Bool4 x) { x.m = (~x.m) & 0x0F; return x; }
  239: __device__ __forceinline__ Bool4 operator&(Bool4 a, Bool4 b) { return Bool4{(unsigned int)(a.m & b.m)}; }
  240: __device__ __forceinline__ Bool4 operator|(Bool4 a, Bool4 b) { return Bool4{(unsigned int)(a.m | b.m)}; }
