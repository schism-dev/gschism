 1890: 
 1891: __inline__ __device__ void Element::getSidesContainingNode(const Node *node, int &idx1, int &idx2) const {
 1892: // Finds the indices of the two sides that share the node in the element. Assumes that the node is part of the element.
 1893: 
 1894:    idx1 = -1;
 1895:    idx2 = -1;
 1896:    
 1897:    // Check all sides systematically
 1898:    if (sides[0]->n1 == node || sides[0]->n2 == node) {
 1899:       idx1 = 0;
 1900:    }
 1901: 
 1902:    if (sides[1]->n1 == node || sides[1]->n2 == node) {
 1903:       if (idx1 == -1) idx1 = 1;
 1904:       else { idx2 = 1; return; }
 1905:    }
 1906: 
 1907:    if (sides[2]->n1 == node || sides[2]->n2 == node) {
 1908:       if (idx1 == -1) idx1 = 2;
 1909:       else { idx2 = 2; return; }
 1910:    }
 1911: 
 1912:    if (isQuad() && (sides[3]->n1 == node || sides[3]->n2 == node)) {
 1913:       idx2 = 3;
 1914:    }
 1915:    
 1916:    assert(idx1 >= 0 && idx2 >= 0 && "Element should have exactly two sides containing the node");
 1917: }
 1918: 
 1919: 
 1920: __inline__ __device__ bool Element::containsSegment(const Node *node, const Point2 &xt) const {
 1921: // If we call x0 = node->p, this function returns true if the segment x0xt is contained in the element (in the sense that the wedge formed by the node and its
 1922: // adjacent sides (in the element) include the segment x0xt). 
 1923: // This is in a 'closed' sense, meaning that it covers the cases where x0xt is actually along one of these sides.
 1924: 
 1925:    // Find the two sides containing the node
 1926:    int idxSide1, idxSide2;
 1927:    getSidesContainingNode(node, idxSide1, idxSide2);
 1928: 
 1929:    const Vector2 x0 = node->p;
 1930:     
 1931:    // Obtain the normal vector to the two sides containing the node in the direction inward the element
 1932:    // ssign is positive when side->n points outward, so -ssign gives inward direction
 1933:    const Vector2 n1 = -ssign[idxSide1] * sides[idxSide1]->n;
 1934:    const Vector2 n2 = -ssign[idxSide2] * sides[idxSide2]->n;
 1935: 
 1936:    const Vector2 seg = (xt - x0);
 1937:    return (dot(n1, seg) >= -geometricEpsilon && dot(n2, seg) >= -geometricEpsilon);
 1938: 
 1939: }
