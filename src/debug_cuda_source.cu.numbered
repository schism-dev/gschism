 1900: // Convenience macros for accessing the objects in kernels.
 1901: 
 1902: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 1903:                    Side *side = &(mesh->localSideData[idx_side]); \
 1904:                    if (idx_side >= mesh->ns) return;
 1905: 
 1906: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 1907:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 1908:                    if (idx_elem >= mesh->ne) return;
 1909: 
 1910: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 1911:                    Node *node = &(mesh->localNodeData[idx_node]); \
 1912:                    if (idx_node >= mesh->np) return;
 1913: 
 1914: #define NODE_ALL(node, valid) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x;       \
 1915:                               Node *node = &(mesh->localNodeData[idx_node]); \
 1916:                               const bool valid = (idx_node < mesh->np);                   
 1917: 
 1918: 
 1919: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1920:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 1921:                            if (idx_node_bnd >= mesh->nbp) return;
 1922: 
 1923: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1924:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 1925:                            if (idx_side_bnd >= mesh->nbs) return;                           
