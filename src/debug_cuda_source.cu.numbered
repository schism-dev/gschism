 6702: 
 6703:    __global__ void computeVegetationAndDragParameters(void) {
 6704:       // Computes the vegetation and drag model parameters:
 6705:       // chi, \tilde\chi, beta, \breve{H}
 6706:       
 6707:       SIDE(side);
 6708: 
 6709:       side->hhat = 0.0;
 6710:       side->chi2 = 0.0;
 6711:       side->chi = 0.0;
 6712:       side->veg_c2 = 0.0;
 6713:       side->veg_beta = 0.0;
 6714: 
 6715:       if (side->isDry) return;
 6716: 
 6717:       const double htot = side->htot2();
 6718:       const int    kb   = side->kb;
 6719: 
 6720:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 6721: 
 6722:       const double veg_h     = side->veg_h();
 6723:       const double veg_nv    = side->veg_nv();
 6724:       const double veg_c     = side->veg_c();
 6725:       const double veg_beta  = side->veg_beta;
 6726:       const double veg_alpha = side->veg_alpha_vert_mean();
 6727: 
 6728:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX recommended to change names, chi->chitilde, chi2->chi
 6729:       // Velocity magnitude at the bottom level
 6730:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0 - dt*swild2(k,1) to u2 (I think this only pertains to iupwind_mom \= 0)
 6731:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 6732:       side->chi2 = side->Cd()*vmag1;
 6733:       side->chi  = side->chi2;
 6734: 
 6735:       if constexpr(iveg != 0) {
 6736:          const Node *n1 = side->n1;
 6737:          const Node *n2 = side->n2;
 6738:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 6739:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 6740:       }
 6741: 
 6742:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 6743: 
 6744:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 6745:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 6746:       double magUa = 0.0;
 6747:       if constexpr(iveg != 0) {
 6748:          if (side->is3D() && veg_h > 0.0) {
 6749:             // 3D wet side with veg...
 6750: 
 6751:             double magUa = 0.0;
 6752:             for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 6753:                if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 6754: 
 6755:                   // Velocity magnitude must be computed at the center of each level to perform the integration.
 6756:                   // The tricky part is to compute that velocity at the level that may be partially submerged.
 6757:                   const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 6758: 
 6759:                   // Velocity magnitude at the top (h) of the level (may be partially submerged)
 6760:                   const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 6761: 
 6762:                   // Velocity magnitude at the bottom (l) of the level
 6763:                   const double ul = length(side->u2[k]);
 6764: 
 6765:                   const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 6766:                   magUa += Dz*0.5*(uh + ul);
 6767: 
 6768:                } // if HasVegetation
 6769:             } // for k
 6770:             const double ua = magUa/min(htot, veg_h); // Vertical average
 6771: 
 6772:             // Computes beta, used for computing the stress term at the top of the canopy.      
 6773:             side->veg_c2 = veg_alpha*dt*ua; // >=0
 6774:             if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 6775:                const double zCpy = side->zTopCanopy();
 6776:                const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 6777:                const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 6778:                const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 6779:                const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 6780:                side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 6781:             } // if isSubmerged
 6782:          } // if is3D
 6783:       } // if iveg   
 6784: 
 6785:       // Computes the friction modified depth, \breve{H} in notes
 6786:       if (side->is2D()) { // 2D
 6787: 
 6788:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 6789:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 6790: 
 6791:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 6792: 
 6793:          side->hhat = htot*htot/fricH; 
 6794: 
 6795:       } else { // 3D
 6796:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 6797: 
 6798:          if constexpr(iveg != 0) {
 6799:             
 6800:             if (side->isSubmerged()) { 
 6801:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 6802:                side->hhat -= veg_c*Hhat_alpha;
 6803: 
 6804:             } else { // Emergent
 6805:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 6806:             }
 6807:          } // if iveg
 6808: 
 6809:          // Enforce positivity for 3D model
 6810:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 6811:       } // if 3D
 6812: 
 6813:    }
 6814: 
 6815: 
 6816: 
 6817:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 6818:    // Computes the density gradient between two elements, e1 and e2.
 6819:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 6820:    // zero in the direction normal to the side. 
 6821:    // 
 6822:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 6823:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 6824:    //
 6825:    // Input:
 6826:    //    e1: Element
 6827:    //    e2: Neighbor element (or nullptr if boundary)
 6828:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 6829:    //    k: Index of the half-level at which the density is interpolated
 6830:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 6831:    // 
 6832:    // Output:
 6833:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 6834:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 6835: 
 6836:       if (e2 == nullptr || e2->isDry) {
 6837:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 6838: 
 6839:          Side *side = e1->sides[j];
 6840:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 6841:                  
 6842:          if constexpr(ics == 1) {
 6843:             vec = side->n; // Normal vector to the side
 6844:          } else {
 6845:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6846:             // IMPLEMENT THIS XXXXXX
 6847:             // !replace with xel, yel?
 6848:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 6849:             //      &eframe(:,:,i),xn1,yn1,tmp)
 6850:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 6851:             //      &eframe(:,:,i),xn2,yn2,tmp)
 6852:          } //ics
 6853:                    
 6854:          diffRho = 0.0;
 6855: 
 6856:       } else { //internal and wet
 6857:          if constexpr(ics==1) {
 6858:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 6859: 
 6860:             // Vector from e1 to e2
 6861:             vec = e2->center - e1->center;
 6862: 
 6863:          } else { 
 6864:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6865:             // Remember that elem->center is in global coordinates
 6866:             // IMPLEMENT THIS XXXXXX
 6867:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 6868:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 6869:             //                   alow(j)=xctr2
 6870:             //                   bdia(j)=yctr2
 6871:          } // ics
 6872: 
 6873:          diffRho = rho2 - e1->demeanedDensity(k);
 6874:       }
 6875: 
 6876:    }
 6877: 
 6878:    __global__ void computeDensityCubicSplines(void) {
 6879:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 6880: 
 6881:       ELEM(elem);
 6882: 
 6883:       if (elem->isDry) return;
 6884: 
 6885:       const int kb = elem->kb;
 6886: 
 6887:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 6888:       if (elem->is2D()) {
 6889:          // In the 2D case, the density is constant at the prism level. 
 6890:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 6891:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 6892:       } else { //3D
 6893: 
 6894:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 6895:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 6896:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 6897:          ///// XXXX CHECK INDICES!!!!!
 6898:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 6899:       } // 2D/3D
 6900: 
 6901:    }
 6902: } // extern "C"
 6903: 
 6904: 
 6905: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 6906: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 6907: 
 6908:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 6909: 
 6910:    const int kb  = elem->kb;
 6911:    const int kb2 = elem2->kb;
 6912: 
 6913:    // z-coordinate of prism of elem
 6914:    const double zp = elem->z_prism(k);
 6915: 
 6916:    double rho = 0.0;
 6917: 
 6918:    if (elem2->is2D()) {
 6919:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 6920: 
 6921:    } else {  // 3D
 6922: 
 6923:       // eta_min may be < zmax
 6924:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 6925:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 6926: 
 6927:       // (Extrapolate density below bottom, we will fix it later)
 6928:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 6929:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 6930:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 6931:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 6932:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 6933:    } // 2D/3D
 6934:      
 6935: 
 6936:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 6937:    // Now we need to fix it.
 6938:    if (elem->z[k] < elem2->z[kb2]) {
 6939:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 6940: 
 6941:       // There are two methods to adjust the density at the bottom of the element.
 6942:       // iunder_deep=0: 
 6943:       const double depth1 = abs(elem->z[kb]); // larger depth
 6944: 
 6945:       if (iunder_deep==0) {
 6946: 
 6947:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 6948: 
 6949:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 6950: 
 6951:       } else { // iunder_deep != 0
 6952: 
 6953:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 6954: 
 6955:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 6956: 
 6957:          //   Demeaned density at the same z coordinate as
 6958:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 6959:          }
 6960: 
 6961:       } // if iunder_deep
 6962:    } // if elem->z[kb] < elem2->z[kb]
 6963: 
 6964:    return rho;
 6965: }
 6966: 
 6967: 
 6968: extern "C" {
 6969:    __global__ void computeDensityGradient(void) {
 6970: 
 6971:       assert(ibc == 1 && "baroclinic formulation is not implemented yet: ibc != 0");
 6972:       if constexpr(ibc != 0) return;
 6973: 
 6974:          // Compute the horizontal density gradient at each element.
 6975:       // It works in two steps:
 6976:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6977:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6978:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6979:       //             gradRho.r1 = rho1 - rho0
 6980:       //             gradRho.r2 = rho2 - rho0
 6981:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6982:       // 
 6983:       //  NOTE: We use de-meaned densities.
 6984: 
 6985:       ELEM(elem);
 6986: 
 6987:       if (elem->isDry) return;
 6988: 
 6989:       const int kb  = elem->kb;
 6990:       const int i34 = elem->i34;
 6991: 
 6992:       for (int k = kb + 1; k < nvrt; k++) {
 6993:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 6994:          //             gradRho.r1 = rho1 - rho0
 6995:          //             gradRho.r2 = rho2 - rho0
 6996:          int icount = 0;
 6997:          double sumRx = 0.0;
 6998:          double sumRy = 0.0;
 6999:          for (int j1=0; j1<i34; j1++) { 
 7000: 
 7001:             const int j2 = elem->nxq(j1 + 1);
 7002: 
 7003:             // Pairs of consecutive neighbor elements of elem
 7004:             const Element *e1 = elem->nghbElems[j1];
 7005:             const Element *e2 = elem->nghbElems[j2];
 7006: 
 7007:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 7008:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 7009:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 7010: 
 7011:             // Compute the density difference and the vector from elem to e1 and e2
 7012:             // getRhoDiffAndVec takes into account boundaries/dry elements
 7013:             double diffRho1, diffRho2;
 7014:             Vector2 vec1, vec2;
 7015:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 7016:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 7017: 
 7018:             const double rl1 = length(vec1);
 7019:             const double rl2 = length(vec2);
 7020:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 7021: 
 7022:             const double delta = cross(vec1, vec2);
 7023:             const double sintheta = abs(delta)/(rl1*rl2);
 7024: 
 7025:             // To avoid problems, avoid elements with small angle between vectors
 7026:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 7027:             const bool validEq = (sintheta > sin_one_deg);
 7028: 
 7029:             if (validEq) {
 7030:                // Solve the system of equations to get the density gradient at elem
 7031:                icount++;
 7032:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 7033:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 7034:                sumRx += Rx;
 7035:                sumRy += Ry;
 7036:             }
 7037:          } // for j1
 7038: 
 7039:          // Compute the average density gradient at elem
 7040:          if (icount==0) {
 7041:            // Bad mesh quality; bail out with 0 b-cc
 7042:            elem->gradRho[k] = {0.0, 0.0};
 7043:          } else {
 7044:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 7045:          }
 7046: 
 7047:       } // for k
 7048: 
 7049:    }
 7050: 
 7051:    __global__ void computeBaroclinicTerm(void) {
 7052:    // Computes the baroclinic term at sides (at half levels).
 7053:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 7054:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 7055: 
 7056:       if (ibc == 1) return;
 7057: 
 7058:       SIDE(side);
 7059: 
 7060:       if (side->isDry) return;
 7061: 
 7062:       const Element *e1 = side->elems[0];
 7063:       const Element *e2 = side->elems[1]; 
 7064:       const int kb = side->kb;
 7065:       
 7066:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 7067: 
 7068:       // interpolates vertically the density gradient of the two elements at the half level/
 7069: 
 7070:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 7071:       int k2 = max(kb, nvrt / 2);
 7072: 
 7073:       // Starts the integration at the surface and goes down to the bottom
 7074:       side->bcc[nvrt-1] = {0.0, 0.0};
 7075:       for (int k = nvrt - 2; k >= kb; k--) {
 7076:       // For each prism level (from surface to bottom)...
 7077: 
 7078:          // For both elements, interpolate density gradient at the side's half level.
 7079:          // The gradient at the side is the average of the gradients at the elements.
 7080:          // w1, w2 are used to take into account boundary sides, with just one element.
 7081:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 7082:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 7083:          const double wsum = w1 + w2;
 7084:          w1 = w1/wsum;
 7085:          w2 = w2/wsum;
 7086:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 7087: 
 7088:          // Linear interpolation of both elements' density gradient at the shared side's level.
 7089:          Vector2 gradRho = {0.0, 0.0};
 7090:          if (e1 != nullptr && k > kb) {
 7091:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 7092:             
 7093:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 7094:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 7095:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 7096: 
 7097:             // Grad(rho) vertically interpolated at the side's half level
 7098:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 7099: 
 7100:             // Projects the element density gradient to the side frame if needed.
 7101:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 7102: 
 7103:             // Adds the contribution of the density gradient at the side's half level
 7104:             gradRho += gradRho1*w1;
 7105:          }      
 7106:          if (e2 != nullptr && k > kb) {
 7107:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 7108:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 7109:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 7110:             
 7111:             // Grad(rho) vertically interpolated at the side's half level
 7112:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 7113: 
 7114:             // Projects the element density gradient to the side frame if needed.
 7115:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 7116: 
 7117:             // Adds the contribution of the density gradient at the side's half level
 7118:             gradRho += gradRho2*w2;
 7119:          }
 7120: 
 7121:          
 7122:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 7123:          // multiplied by -rampbc*(g/rho0) 
 7124:          const double grav3 = side->grav3();
 7125:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 7126: 
 7127:       } // for
 7128: 
 7129:    }
 7130: 
 7131: 
 7132: 
 7133:    __global__ void computeHorGradientAtSide(void) {
 7134: 
 7135:       // Compute the horizontal density gradient at each element.
 7136:       // It works in two steps:
 7137:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 7138:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 7139:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 7140:       //             gradRho.r1 = rho1 - rho0
 7141:       //             gradRho.r2 = rho2 - rho0
 7142:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 7143:       // 
 7144:       //  NOTE: We use de-meaned densities.
 7145: 
 7146:       SIDE(side);
 7147: 
 7148: 
 7149:       if (side->isDry) return;
 7150: 
 7151:       // Computes the gradient of the variables at the side center.
 7152:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 7153:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 7154:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 7155: 
 7156:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 7157:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 7158:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 7159:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 7160: 
 7161:    }
 7162: 
 7163: 
 7164:    __global__ void solveMomentumEquations(double time) {
 7165: 
 7166:       double alow[nvrt], cupp[nvrt], bdia[nvrt]; // a = low, c = up, b = diag
 7167:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 7168: 
 7169:       SIDE(side);
 7170: 
 7171:       if (side->isDry) 
 7172:       {
 7173:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 7174: 
 7175:          return;
 7176:       }
 7177: 
 7178:       const Node *n1 = side->n1;
 7179:       const Node *n2 = side->n2;
 7180: 
 7181:       const int kb = side->kb;
 7182: 
 7183:       const double veg_h = side->veg_h();
 7184:       const double grav3 = side->grav3();
 7185: 
 7186:       if (side->is2D()) {
 7187:          // Remember: Do not use htot2, which is updated.
 7188:          const double htot = side->htot1();
 7189:          const double hhat = side->hhat;
 7190: 
 7191:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 7192: 
 7193:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 7194:          const Vector2 tau2 = side->tau();
 7195: 
 7196:          // hat_gam has units of m/s
 7197: 
 7198:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 7199:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 7200:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 7201: 
 7202:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 7203: 
 7204: 
 7205:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 7206: 
 7207:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 7208: 
 7209:       }
 7210:       else { // 3D
 7211: 
 7212:          // For 3D it is necessary to solve an implicit tridiagonal system.
 7213:          // 
 7214:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 7215:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 7216:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 7217:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 7218:          // k+1 and k.
 7219: 
 7220: 
 7221:          const int ndim = nvrt - kb;
 7222:          const double zTopCanopy = side->zTopCanopy();
 7223: 
 7224:          // Initialize the tridiagonal system
 7225:          for (int k = kb + 1; k < nvrt; k++) {
 7226:             
 7227:             const int kin = k - (kb + 1);
 7228: 
 7229:  
 7230:             alow[kin] = 0.0;
 7231:             cupp[kin] = 0.0;
 7232:             bdia[kin] = 0.0;
 7233: 
 7234:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 7235:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 7236: 
 7237:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 7238:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 7239:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 7240: 
 7241:             // First part: layers k, k+1
 7242:             if (k < nvrt - 1) {
 7243:                              
 7244:                if constexpr(iveg != 0) {
 7245: 
 7246:                   // If there is vegetation at this level...
 7247:                   if (zTopCanopy > side->zc[k]) {
 7248:                      // If the canopy is above the k layer...
 7249:                      
 7250:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 7251:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 7252:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 7253:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 7254: 
 7255:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 7256:                      const double vmag2 = length(ut2);
 7257:                      const double vmag1 = length(side->u2[k]);
 7258:                      const double vmag = 0.5*(vmag1 + vmag2);
 7259:                      
 7260:                      // Computes the vegetation alpha at the face center
 7261:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 7262: 
 7263:                      cff1 += veg_alpha_sd*dt*vmag;
 7264: 
 7265:                   } // if (zTopCanopy
 7266:                } // if iveg
 7267: 
 7268:                const double dzz = side->Dz(k + 1);
 7269:                const double dfz = 0.5*(side->dfv(k) + side->dfv(k + 1)); // Vertical viscosity at the face center
 7270:                const double tmp = dt*dfz/dzz;
 7271:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 7272: 
 7273:                cupp[kin] += cff1*dzz/6.0 - tmp;
 7274:                bdia[kin] += cff1*dzz/3.0 + tmp;
 7275:             }
 7276: 
 7277: 
 7278:             // Second part: layers k-1, k
 7279:             if (k > kb + 1) {
 7280: 
 7281:                double cff1 = 1.0; //init \bar{c^k}
 7282: 
 7283:                if constexpr(iveg != 0) {
 7284:                   // If there is vegetation at this level...
 7285:                   if (zTopCanopy > side->zc[k-1]) {
 7286:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 7287:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 7288: 
 7289:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 7290: 
 7291:                      const double vmag2 = length(ut2);
 7292:                      const double vmag1 = length(side->u2[k-1]);
 7293:                      const double vmag = 0.5*(vmag1 + vmag2);
 7294: 
 7295:                      // Computes the vegetation alpha at the face center
 7296:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 7297:                      cff1 += veg_alpha_sd*dt*vmag;
 7298:                   } // if zTopCanopy
 7299: 
 7300:                } // if iveg
 7301: 
 7302:                const double dzz = side->Dz(k);
 7303:                const double dfz = 0.5*(side->dfv(k) + side->dfv(k - 1)); // Vertical viscosity at the face center
 7304:                const double tmp = dt*dfz/dzz;
 7305:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 7306: 
 7307:                alow[kin] += cff1*dzz/6.0 - tmp;
 7308:                bdia[kin] += cff1*dzz/3.0 + tmp;
 7309: 
 7310:             } else { // Bottom boundary
 7311:                // This occurs at the bottom, where the bottom drag is applied.
 7312: 
 7313:                bdia[kin] += dt*side->chi2; // XXXX
 7314: 
 7315:             } // if (k > kb + 1)
 7316: 
 7317: 
 7318:          } // for (int k
 7319: 
 7320: 
 7321: 
 7322:          // Computes the RHS.
 7323:          // -----------------
 7324: 
 7325:          //	BC to be imposed at the end.
 7326: 
 7327:          const Vector2 gradETP  = side->gradETP;
 7328:          const Vector2 gradPr   = side->gradPr;
 7329:          const Vector2 gradEta1 = side->gradEta1;
 7330:          const Vector2 gradEta2 = side->gradEta2;
 7331: 
 7332:          const Vector2 *btu = side->btu;
 7333:          const Vector2 *u2  = side->u2;
 7334:          const double coriolis = side->coriolis;
 7335:          const Vector2 *nuGradU = side->nuGradU;
 7336: 
 7337:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 7338:          for (int k = kb + 1; k < nvrt; k++) {
 7339:             const int kin = k - kb - 1;
 7340: 
 7341:             const double dz_0 = side->Dz(k);
 7342:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 7343: 
 7344:             rrhs[kin] = {0.0, 0.0};
 7345:             double dz = 0.0;
 7346: 
 7347:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 7348:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 7349:             if (k < nvrt  ) dz += dz_1;
 7350:             if (k > kb + 1) dz += dz_0;
 7351: 
 7352:             // Elevation gradient, atmospheric pressure and tidal potential
 7353:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 7354: 
 7355:             // Coriolis, advection, wind stress, and horizontal viscosity
 7356:             if (k < nvrt - 1) {
 7357: 
 7358: 
 7359:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 7360:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 7361:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 7362:                                                 
 7363: 
 7364:                //diff stress tensors 1006
 7365:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 7366:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 7367:                   assert(false && "Not implemented: itur == 5");
 7368:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 7369:                }
 7370:                // else assert(false && "itur # Not implemented");
 7371: 
 7372:             } else { // k == nvrt - 1 SURFACE
 7373:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 7374:                const Vector2 tau2 = side->tau();
 7375: 
 7376:                rrhs[kin] += dt*tau2;          
 7377: 
 7378:             } // if k<nvrt
 7379: 
 7380: 
 7381:             if (k > kb + 1) {
 7382:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 7383:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 7384:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 7385: 
 7386:                // diff stress tensors 1006
 7387:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 7388:                   assert(false && "Not implemented: itur == 5");
 7389:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 7390:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 7391:                }
 7392:                // else assert(false && "itur # Not implemented");
 7393: 
 7394: 
 7395:             } // if k>kbs + 1
 7396: 
 7397:             // Baroclinic
 7398:             Vector2 *bcc = side->bcc;
 7399:             if constexpr(ibc == 0) {
 7400:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 7401:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 7402: 
 7403:             } // if ibc==0
 7404: 
 7405:          } // k=kb + 1,nvrt
 7406: 
 7407: 
 7408:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 7409: 
 7410:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 7411:             const int kin = k - kb - 1;
 7412:    
 7413:             // Velocity is always clamped to maximum values
 7414:             side->u2[k] = clampVelocity(soln[kin]);
 7415:          } // k
 7416: 
 7417:       } // if side->is2D()
 7418:       
 7419: 
 7420:       // Impose velocity boundary condition at the bottom
 7421:       if constexpr(imm == 2) { // 3D bed deformation model
 7422:          double dep;
 7423:          Vector2 vel;
 7424: 
 7425:          assert(false && "Not implemented: imm == 2");
 7426:          //update_bdef(time, x0, y0, dep, vel);
 7427:          // side->u2[kb] = vel;
 7428: 
 7429:       } else { // imm = 0 or 1
 7430:          if (side->Cd() == 0.0) {
 7431:             side->u2[kb] = side->u2[kb + 1];
 7432: 
 7433:          } else if (side->is3D()) { // 3D no slip bottom   
 7434:             side->u2[kb] = {0.0, 0.0};
 7435: 
 7436:          }
 7437:           
 7438:       } // if imm
 7439: 
 7440:       // The velocities below the bottom level are set to zero
 7441:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 7442: 
 7443: 
 7444:    }
 7445: 
 7446: 
 7447:    __global__ void applyMomentumBC(void) {
 7448: 
 7449:       SIDE_BND(sideBnd);
 7450: 
 7451:       Side *side = sideBnd->side;
 7452:       const BoundarySegment *segment = sideBnd->segment;
 7453:       const Node *n1 = side->n1;
 7454:       const Node *n2 = side->n2;
 7455: 
 7456:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 7457: 
 7458:       const bool isLand = segment->isLand;
 7459:       const int ifltype = segment->ifltype;
 7460: 
 7461:       const int kb = side->kb;
 7462: 
 7463: 
 7464:       if (!isLand && ifltype != 0) {
 7465:          const Vector2 *ubc = sideBnd->ubc;
 7466:   
 7467:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 7468:             
 7469:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 7470:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 7471: 
 7472:             if (ifltype == -1) {
 7473:                // Flather 1
 7474: 
 7475:                const double depth = side->depth();
 7476: 
 7477:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 7478: 
 7479:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 7480: 
 7481:                side->u2[k] = vnorm*side->n;
 7482: 
 7483:             } else if (ifltype == -2) { // Discharge
 7484: 
 7485:                const double eta1 = side->eta1();
 7486:                const double eta2 = side->eta2();
 7487:                const double htot = side->htot2();
 7488: 
 7489:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 7490:                assert(false && "Not implemented: Discharge bc");
 7491:                // const double dischrg = discharge(eta1);
 7492:                const double dischrg = 0.0; // XXX REMOVE
 7493:                
 7494: 
 7495:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 7496: 
 7497:                const double vnorm = dischrg*eta2/htot;
 7498: 
 7499:                side->u2[k] = vnorm*side->n;
 7500: 
 7501:             }
 7502:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 7503:                const double vnorm = dot(side->u2[k], side->n);
 7504: 
 7505:                double rat;
 7506:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 7507:                else              rat = segment->vobc2; // outgoing
 7508: 
 7509:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 7510: 
 7511:             }
 7512:             else { // not Flather or 3D radiation
 7513: if (ifltype == 2) printf("XXXXX ubc: %f, %f\n", ubc[k].x, ubc[k].y);
 7514:                side->u2[k] = ubc[k];
 7515: 
 7516:             } // if (segment->ifltype...
 7517: 
 7518:          }
 7519: 
 7520:       }
 7521:       else if (isLand) { // if it is land boundary side
 7522: 
 7523:          if constexpr(islip == 0) { // free slip
 7524: 
 7525:             for (int k = kb; k < nvrt; k++) {
 7526: 
 7527:                const Vector2 t = side->t();
 7528:                const Vector2 n = side->n;
 7529: 
 7530:                double vnorm = 0.0; // for most cases
 7531:                const double vtan = dot(side->u2[k], t);
 7532:                
 7533:                side->u2[k] = vtan*t - vnorm*n;
 7534: 
 7535:             }
 7536: 
 7537:          } else { // no slip
 7538:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 7539: 
 7540:          }
 7541:       } // if (side segment type...
 7542: 
 7543:    }
 7544: 
 7545: 
 7546:    __global__ void shapiroFilter1(void) {
 7547:       // First step of the Shapiro filter (normally used if indvel<=0)
 7548:       // Computes the filtered values and stores them in bcc (as a temporary array).
 7549: 
 7550:       SIDE(side);
 7551: 
 7552:       // Only internal wet sides are processed
 7553:       if (side->isDry || !(side->isInternal())) return;
 7554: 
 7555:       const int kb = side->kb;
 7556: 
 7557:       for (int mm = 0; mm < niter_shap; mm++) {
 7558: 
 7559:          for (int k = kb + 1; k < nvrt; k++) {
 7560:             // WARNING: reusing bcc as a temporary array to store the suru values.
 7561:             Vector2 suru = {0.0, 0.0};
 7562: 
 7563:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 7564: 
 7565:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 7566: 
 7567:                int kin = k;
 7568:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 7569:                
 7570:                // Get the velocity at the neighbor's side.
 7571:                Vector2 nSideU2 = nSide->u2[kin];
 7572: 
 7573:                // Projects the velocity to the current side frame if needed.
 7574:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 7575: 
 7576:                suru += nSideU2;
 7577:             }
 7578: 
 7579:             // Reusing bcc as a temporary array to store the suru values.
 7580:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 7581: 
 7582:          }
 7583:       }
 7584:    }
 7585: 
 7586:    __global__ void shapiroFilter2(void) {
 7587:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 7588: 
 7589:       SIDE(side);
 7590: 
 7591: 
 7592:       if (side->isDry || !(side->isInternal())) return;
 7593: 
 7594:       const int kb = side->kb;
 7595: 
 7596:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 7597: 
 7598:       if (side->is2D()) {
 7599:          side->u2[kb + 1] = side->bcc[kb + 1];
 7600:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 7601: 
 7602:       } else {
 7603:          // 3D
 7604:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 7605:          
 7606:       }
 7607: 
 7608:    }
 7609: 
 7610: 
 7611:    __global__ void ul0UpdateZCoords(void) {
 7612:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 7613:       
 7614:       NODE(node);      
 7615: 
 7616: 
 7617:       if (false) { //node->isDry) { XXXXXXX
 7618: 
 7619:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 7620: 
 7621:          if constexpr(ivcor != 1) node->kb = 0;
 7622: 
 7623:       } else {
 7624: 
 7625:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 7626:          node->updateKb();
 7627: 
 7628:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 7629: 
 7630:       }
 7631: 
 7632:       // We use the temp.b field to store the previous state of isDry.
 7633:       node->tmp.b = node->isDry;
 7634: 
 7635:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 7636:       node->isDry = true;
 7637: 
 7638:    }
 7639: 
 7640:    __global__ void ul0ComputeDryElements(void)
 7641:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 7642:    {
 7643:       ELEM(elem);
 7644: 
 7645:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 7646: 
 7647:       elem->kb = 0;
 7648: 
 7649:       if (elem->isDry) return;
 7650: 
 7651: 
 7652:    //    if(elem->isDry2()) { // XXXX
 7653:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 7654:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 7655:    //        call parallel_abort(errmsg)
 7656:    //    }
 7657: 
 7658:       const Node *n1 = elem->nodes[0];
 7659:       const Node *n2 = elem->nodes[1];
 7660:       const Node *n3 = elem->nodes[2];  
 7661:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 7662: 
 7663:       // Computes element's kb as the minimum of the nodes' kb.
 7664:       const int kb1 = n1->kb;
 7665:       const int kb2 = n2->kb;
 7666:       const int kb3 = n3->kb;
 7667:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 7668: 
 7669: 
 7670:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 7671: 
 7672: 
 7673:       // Computes the element z as the mean of the nodes z.
 7674:       for (int k = elem->kb; k < nvrt; k++) {
 7675: 
 7676:          // Compute the element z as the mean of the nodes z.
 7677:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 7678:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 7679:          elem->z[k] /= elem->i34;
 7680: 
 7681:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 7682:       }
 7683:                   
 7684:    }
 7685: 
 7686:    __global__ void ul0ComputeDryNodes(void)
 7687:    // Updates node's isDry based on the elements' isDry. 
 7688:    {
 7689:       NODE(node);
 7690: 
 7691:       node->isDry = true;
 7692: 
 7693:       // A node is wet if at least one of the elements sharing it is wet.
 7694:       for (int j = 0; j < node->numElements; j++) {
 7695:          const Element *elem = node->elements[j];
 7696:          if (!elem->isDry) {
 7697:             node->isDry = false;
 7698:             break;
 7699:          }
 7700:       }
 7701: 
 7702:        
 7703:    }
 7704: 
 7705: 
 7706:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 7707:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 7708:    // node->tmp.b is true if the node was previously dry.
 7709:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 7710:    {
 7711:       NODE(node);
 7712:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 7713: 
 7714:       // Avoid this the first time step.
 7715:       if (it == iths) return;  
 7716: 
 7717:       const bool wasDry = node->tmp.b;
 7718: 
 7719: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 7720: 
 7721:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 7722: 
 7723:          for (int k=0; k < nvrt; k++) {
 7724: 
 7725:             Vector3 utmp={0.0, 0.0, 0.0};
 7726: 
 7727:             double ttmp=0.0;
 7728:             double stmp=0.0;
 7729:             int icount=0;
 7730:             for (int j = 0; j < node->numNodes; j++) {
 7731: 
 7732:                const Node *nbrNode = node->nodes[j];
 7733:                
 7734:                const bool wasNbrDry = nbrNode->tmp.b;
 7735: 
 7736:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 7737:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 7738: 
 7739:                   icount++;
 7740: 
 7741:                   // Assume small element size in wet/dry zone so pframes are close to each other
 7742:                   utmp += nbrNode->uvw2(k);
 7743:                   
 7744:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 7745:                   stmp += nbrNode->tracers[k].tracer[1]; 
 7746:                }
 7747:             }
 7748: 
 7749:             if (icount > 0) {
 7750:                const double inv_icount = 1.0/icount;
 7751:                utmp = inv_icount*utmp;
 7752:                node->u2[k]     = {utmp.x, utmp.y};
 7753:                node->w2[k]     = utmp.z;
 7754:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 7755:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 7756:             } else {
 7757:                node->u2[k] = {0.0, 0.0};
 7758:                node->w2[k] = 0.0;
 7759:                // Initialize tracers to 0.0??? XXXXX
 7760:             }
 7761:          }
 7762:       }
 7763:    }
 7764: 
 7765:   
 7766:    
 7767: 
 7768: 
 7769:    __global__ void ul0UpdateSides(int it, int iths) {
 7770:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 7771:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 7772:    // The dryness of the sides is updated in ul0UpdateSides2.
 7773: 
 7774:       SIDE(side);
 7775: 
 7776:       // A side is wet if and only if at least one of its elements is wet.
 7777:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 7778:  
 7779:       const Node *n1 = side->n1;
 7780:       const Node *n2 = side->n2;
 7781:      
 7782:       const int kb1 = n1->kb;
 7783:       const int kb2 = n2->kb;
 7784: 
 7785:       side->kb = 0; // default when dry
 7786: 
 7787:       if (isWet) {
 7788: 
 7789:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 7790: 
 7791:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 7792: 
 7793:          side->kb = min(kb1, kb2);
 7794: 
 7795:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 7796: 
 7797:          for (int k = side->kb; k < nvrt; k++) {
 7798:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 7799: 
 7800:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 7801: 
 7802:             // Compute velocity for re-wetted sides 
 7803:             if ((it != iths) && (side->isDry && isWet)) {
 7804: 
 7805:                Vector2 utmp={0.0, 0.0};
 7806: 
 7807:                int icount=0;
 7808: 
 7809:                // For all the sides on the two elements that share this side
 7810:                for (int j = 0; j < 2; j++) {
 7811:                   const Element *elem = side->elems[j];
 7812:                   if (elem == nullptr) continue;
 7813: 
 7814:                   for (int jj=0; jj < elem->i34; jj++) {
 7815:                      const Side *nSide = elem->sides[jj];
 7816:                      if (nSide->isDry) continue;
 7817: 
 7818:                      icount++;
 7819:                      utmp += nSide->u2[k];  
 7820:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 7821:                   }
 7822:                }
 7823:                   
 7824:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 7825:                if (icount > 0)  side->u2[k] = utmp/icount;
 7826:                else             side->u2[k] = {0.0, 0.0};
 7827:                   
 7828:             } // if ((it != iths) && (side->isDry && isWet))
 7829: 
 7830:          } // for k
 7831: 
 7832:       } // if isWet 
 7833:       
 7834: 
 7835: 
 7836:    }
 7837: 
 7838:    __global__ void ul0UpdateSides2(void) {
 7839:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 7840:    
 7841:          SIDE(side);
 7842:    
 7843:          const Element *e1 = side->elems[0];
 7844:          const Element *e2 = side->elems[1];
 7845: 
 7846:          // A side is wet if and only if at least one of its elements is wet.
 7847:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 7848: 
 7849:          // Update the side's dryness
 7850:          side->isDry = !isWet;
 7851: 
 7852:    }
 7853: 
 7854: 
 7855:    __global__ void zeroNodalVelocities(void) {
 7856:       NODE(node);
 7857: 
 7858:       for (int k = 0; k < nvrt; k++) {
 7859:          node->u2[k]   = {0.0, 0.0};
 7860:          node->w2[k]   = 0.0;
 7861:          node->utmp[k] = {0.0, 0.0};         
 7862:       }
 7863:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 7864:    }
 7865:  
 7866: 
 7867:    __global__ void computeNodalVerticalVelocities1(void) {
 7868:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7869:    // Adds the element's vertical velocity times the element's area.
 7870:       ELEM(elem);
 7871: 
 7872:       for (int j = 0; j < elem->i34; j++) {
 7873:          Node *node = elem->nodes[j];
 7874: 
 7875:          for (int k = node->kb; k < nvrt; k++) {
 7876:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 7877:          }
 7878:          atomicAdd(&(node->tmp.d), elem->area);
 7879:       }
 7880:    }
 7881: 
 7882:    __global__ void computeNodalVerticalVelocities2(void) {
 7883:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7884:    // Divides by the total area of the elements sharing the    node.
 7885:       NODE(node);
 7886: 
 7887: 
 7888:       const double invArea = 1.0 / node->tmp.d;
 7889:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = invArea*node->w2[k];  // node->tmp.d contains the total area of the elements sharing the node
 7890: 
 7891:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 7892:    }
 7893: 
 7894: 
 7895:    __global__ void computeNodalHorizontalVelocities1(void) {
 7896: 
 7897:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 7898: 
 7899:       ELEM(elem);
 7900: 
 7901:       if (elem->isDry) return;
 7902: 
 7903:       const int kb = elem->kb;
 7904:       const bool isTri = elem->isTri();
 7905: 
 7906:       if constexpr(indvel <= 0) {
 7907:          // Assuming discontinous hvel.
 7908: 
 7909:          if (isTri) { // For triangles
 7910:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 7911:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 7912:             #pragma unroll
 7913:             for (int j = 0; j < 3; j++) {
 7914:                // For every node of the triangle...
 7915:                Node *node = elem->nodes[j];
 7916: 
 7917:                if (node->isDry) continue;
 7918: 
 7919:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 7920:                const Side *s2 = elem->sides[(j + 1) % 3];
 7921:                const Side *s3 = elem->sides[(j + 2) % 3];
 7922: 
 7923:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 7924: 
 7925:                atomicAdd(&(node->tmp.i), 1);
 7926: 
 7927:                for (int k = kb; k < nvrt; k++)  {
 7928:                   Vector2 s1u2 = s1->u2[k];
 7929:                   Vector2 s2u2 = s2->u2[k];
 7930:                   Vector2 s3u2 = s3->u2[k];
 7931: 
 7932:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 7933:                   if constexpr(ics == 2) {
 7934:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 7935:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 7936:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 7937:                   }
 7938: 
 7939:                   Vector2 u = s2u2 + s3u2 - s1u2; // u extrapolated linearly at node j.   
 7940:                   u = clampVelocity(u);
 7941:                   atomicAdd(&(node->utmp[k].x), u.x);
 7942:                   atomicAdd(&(node->utmp[k].y), u.y);
 7943: 
 7944:                }
 7945: 
 7946:             }
 7947:          }
 7948:          else { // For quads
 7949: 
 7950: 
 7951:             // Compute the bilinear coordinates of the center of each diagonal.
 7952:             double xi, eta;
 7953:             double shp13[4], shp24[4];
 7954:             Point2 x0, x1, x2, x3;
 7955:             elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 7956:             const Point2 p13 = 0.5 * (x0 + x2);   // Center of sides 1 & 3
 7957:             const Point2 p24 = 0.5 * (x1 + x3);   // Center of sides 2 & 4
 7958: 
 7959:             elem->inverseBilinearQuad(p13, xi, eta, shp13);
 7960:             elem->inverseBilinearQuad(p24, xi, eta, shp24);
 7961: 
 7962: 
 7963: 
 7964: 
 7965:             for (int k = kb; k < nvrt; k++) {
 7966: 
 7967:                //Each quad is split into two triangles. For each triangle we extrapolate as we did for triangles.
 7968:                Vector2 sideU[4];
 7969:                #pragma unroll
 7970:                for (int j = 0; j < 4; j++) {
 7971:                   Vector2 u = elem->sides[j]->u2[k];
 7972:                   if constexpr(ics == 2) u = elem->sides[j]->frame.projHorVec(u, elem->frame);
 7973:                   sideU[j] = u;
 7974:                }
 7975: 
 7976:                Vector2 ud1 = shp13[0]*sideU[0] + shp13[1]*sideU[1] + shp13[2]*sideU[2] + shp13[3]*sideU[3];
 7977:                Vector2 ud2 = shp24[0]*sideU[0] + shp24[1]*sideU[1] + shp24[2]*sideU[2] + shp24[3]*sideU[3];
 7978: 
 7979:                Vector2 ufg0 = clampVelocity(sideU[2] + sideU[3] - ud2);  // node 1: sides 3,4
 7980:                Vector2 ufg1 = clampVelocity(sideU[0] + sideU[3] - ud1);  // node 2: sides 1,4
 7981:                Vector2 ufg2 = clampVelocity(sideU[0] + sideU[1] - ud2);  // node 3: sides 1,2
 7982:                Vector2 ufg3 = clampVelocity(sideU[1] + sideU[2] - ud1);  // node 4: sides 2,3
 7983:                const Vector2 ufg[4] = {ufg0, ufg1, ufg2, ufg3};
 7984:                #pragma unroll
 7985:                for (int j = 0; j < 4; j++) {
 7986:                   Node *node = elem->nodes[j];
 7987:                   if (node->isDry) continue;
 7988: 
 7989:                   if (k == kb) atomicAdd(&(node->tmp.i), 1);
 7990:                   atomicAdd(&(node->utmp[k].x), ufg[j].x);
 7991:                   atomicAdd(&(node->utmp[k].y), ufg[j].y);
 7992:                }
 7993:             }
 7994: 
 7995:          }
 7996: 
 7997:       }
 7998:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 7999:       
 8000:    }
 8001: 
 8002: 
 8003:    __global__ void computeNodalHorizontalVelocities2(void) {
 8004:       NODE(node);
 8005: 
 8006:       const int nodeCount = node->tmp.i;
 8007: 
 8008:       if (nodeCount == 0) 
 8009:       {
 8010:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 8011:          return;
 8012:       }
 8013: 
 8014:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 8015:       
 8016:       const int kb = node->kb;
 8017: 
 8018:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 8019:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 8020:       
 8021:       
 8022:    }   
 8023: 
 8024:  
 8025: 
 8026:    __global__ void resetVelocityOpenBndNodes(void) {
 8027:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 8028: 
 8029:       NODE_BND(nodebnd);
 8030: // printf("DDDDDDDDDD\n");  // XXXXXXX
 8031:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 8032:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 8033:       }
 8034: 
 8035:    }
 8036: 
 8037: 
 8038:    __global__ void setVelocityOpenBndNodes(void) {
 8039:    // For open boundary nodes sets their velocity to the imposed values.
 8040: 
 8041:       SIDE_BND(sidebnd);
 8042: 
 8043:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 8044:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 8045:          // to its segment to the average of the side velocity.
 8046: 
 8047:          for (int k = 0; k < nvrt; k++) {
 8048:             Node *n1 = sidebnd->side->n1;
 8049:             Node *n2 = sidebnd->side->n2;
 8050: 
 8051: 
 8052:             Vector2 &n1_u2 = n1->u2[k];
 8053:             Vector2 &n2_u2 = n2->u2[k];
 8054: 
 8055:             if (n1->nodeBnd->segment == sidebnd->segment) {
 8056:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 8057:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 8058:             }
 8059:             if (n2->nodeBnd->segment == sidebnd->segment) {
 8060:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 8061:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 8062:             }
 8063: 
 8064:          }
 8065: 
 8066:       }
 8067: 
 8068:    }
 8069: 
 8070: 
 8071:    __global__ void computeVerticalVelocity(void) {
 8072:       // Computes the vertical velocity at the (2D) element's centroid.
 8073:       // In this function we will be considering volumetric elements, with side faces and a 
 8074:       // bottom and a top face. We will call them SFs, BF and TF.
 8075:       // It computes the flux coming from BF and the SFs.
 8076:       // If the bed is moving, it takes that into account.
 8077:       // Since water is incompressible, the integral of the velocity times the normal vector
 8078:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 8079:       // and the BF is equal to the flux going out from the TF.
 8080:       // TF = - BF - sum(SFs).
 8081:       // It then computes the horizontal velocity at the center of TF.
 8082:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 8083:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 8084:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 8085: 
 8086:       ELEM(elem);
 8087: 
 8088:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 8089: 
 8090:       if (elem->isDry) return;
 8091: 
 8092:       const int kb = elem->kb;
 8093:       const bool isTri = elem->isTri();
 8094: 
 8095:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 8096: 
 8097:       // Compute the bottom velocity
 8098:       if constexpr(imm != 0) {
 8099:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 8100:       }
 8101: 
 8102: 
 8103:       double bottomArea3D;
 8104:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 8105: 
 8106:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 8107: 
 8108:       double topArea3D;
 8109: 
 8110:       // Bottom face flux
 8111:       double bottomFlux = 0.0;
 8112:       Vector2 u2meanBottom = {0.0, 0.0};
 8113:       const Vector2 gradh = elem->grad2(&Node::depth);
 8114:       if constexpr(imm==2) {
 8115:          Vector3 ubed;
 8116: 
 8117:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 8118:          // updateBDEF(ubed);
 8119:      
 8120:          // const double bflux0 = dot(ubed, elem_bottom_n);
 8121: 
 8122:          // elem->w[kb] += ubed.z;
 8123:       }
 8124:       else {
 8125: 
 8126:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 8127:   
 8128:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 8129:          // in the direction of motion.
 8130:          const double bottomW = - dot(gradh, u2meanBottom);  
 8131:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 8132: 
 8133:          // VElocity associated to the bed deformation
 8134:          double bedVelocity = 0.0;
 8135:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 8136: 
 8137:          elem->w[kb] = bedVelocity + bottomW; 
 8138: 
 8139:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 8140:          
 8141:       } // if imm
 8142: 
 8143:       // Compute w for kb+1 to nvrt-1
 8144:       for (int l = kb; l < nvrt - 1; l++) {
 8145: 
 8146:          // normal vector to the top face of the "volumetric" element (3D)
 8147:          Vector3 elem_top_n = elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 8148: 
 8149:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 8150:          assert(elem_top_n.z > 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 8151: 
 8152:          // Compute the total flux at the sides
 8153:          double sideFlux = 0.0;
 8154: 
 8155:          for (int j = 0; j < elem->i34; j++) {
 8156:             const Side *side = elem->sides[j];
 8157:             const int kbs = side->kb;
 8158:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 8159:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 8160:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 8161: 
 8162:             // The area is "clamped" meaning that it takes kb into account.
 8163:             const double sideArea = side->areaClamped(l);
 8164: 
 8165:             const double sign = elem->ssign[j]; 
 8166: 
 8167:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 8168:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 8169:          }
 8170:          
 8171:          // Compute the horizontal velocity at the center of the top face as an average of the 
 8172:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 8173:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 8174: 
 8175:          // The flux at the top ace can be computed from the other flows.
 8176:          // All fluxes are in directions into the prism.
 8177:          const double topFlux = - sideFlux - bottomFlux;
 8178: 
 8179:          // Flux at the top face due to the horizontal velocities only
 8180:          // topFlux = topHorizontalFlux + topVerticalFlux
 8181:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 8182: 
 8183:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + sideFlux + bottomFlux = 0, so:
 8184:          const double topVerticalFlux = topFlux - topHorizontalFlux;  
 8185: 
 8186:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 8187: 
 8188:          bottomFlux = -topFlux;
 8189:          
 8190:       }
 8191: 
 8192:    }  
 8193: 
 8194: 
 8195: 
 8196: 
 8197: 
 8198: 
 8199: 
