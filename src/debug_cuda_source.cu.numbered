 8376: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 8377:    Element *elems = mesh->localElemData;
 8378: 
 8379:    *addr = elems;
 8380:    *sizeElement = sizeof(Element);
 8381:    switch (varCode) {
 8382:       case (int)VarCode::z:
 8383:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 8384:          *sizeType = sizeof(double);
 8385:          break;
 8386:       case (int)VarCode::x:
 8387:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 8388:          *sizeType = sizeof(Vector2);
 8389:          break;
 8390:       case (int)VarCode::gradETP:
 8391:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
 8392:          *sizeType = sizeof(Vector2);
 8393:          break;
 8394:       case (int)VarCode::area:
 8395:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 8396:          *sizeType = sizeof(double);
 8397:          break;
 8398:       case (int)VarCode::depth:
 8399:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 8400:          *sizeType = sizeof(double);
 8401:          break;
 8402:       case (int)VarCode::radius:
 8403:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 8404:          *sizeType = sizeof(double);
 8405:          break;
 8406:       case (int)VarCode::ghat:
 8407:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 8408:          *sizeType = sizeof(Vector2);
 8409:          break;
 8410:       case (int)VarCode::kb:
 8411:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 8412:          *sizeType = sizeof(int);
 8413:          break;
 8414:       case (int)VarCode::isdry:
 8415:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 8416:          *sizeType = sizeof(int);
 8417:          break;            
 8418:       case (int)VarCode::w:
 8419:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 8420:          *sizeType = sizeof(double);
 8421:          break;
 8422:       case (int)VarCode::FaceIndices:
 8423:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 8424:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 8425:          *sizeType = sizeof(Node);
 8426:          break;
 8427:       default:
 8428:          *offset = -1;
 8429:    }
 8430: }
