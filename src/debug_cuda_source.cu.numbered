 5997:    __global__ void zeroNodalVelocities(void) {
 5998:       NODE(node);
 5999: 
 6000:       for (int k = 0; k < nvrt; k++) {
 6001:          node->u2[k]   = {0.0, 0.0};
 6002:          node->w2[k]   = 0.0;
 6003:          node->utmp[k] = {0.0, 0.0};
 6004:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6005:       }
 6006:    }
 6007: 
 6008:  
 6009: 
 6010:    __global__ void computeNodalVerticalVelocities1(void) {
 6011:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6012:    // Adds the element's vertical velocity times the element's area.
 6013:       ELEM(elem);
 6014: 
 6015:       for (int j = 0; j < elem->i34; j++) {
 6016:          Node *node = elem->nodes[j];
 6017: 
 6018:          for (int k = node->kb; k < nvrt; k++) {
 6019:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6020:          }
 6021:          atomicAdd(&(node->tmp.d), elem->area);
 6022:       }
 6023:    }
 6024: 
 6025:    __global__ void computeNodalVerticalVelocities2(void) {
 6026:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6027:    // Divides by the total area of the elements sharing the    node.
 6028:       NODE(node);
 6029: 
 6030:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 6031: 
 6032:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6033:    }
 6034: 
 6035: 
 6036:    __global__ void computeNodalHorizontalVelocities1(void) {
 6037: 
 6038:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6039:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 6040: 
 6041:       ELEM(elem);
 6042: 
 6043:       if (elem->isDry) return;
 6044: 
 6045:       const int kb = elem->kb;
 6046:       const bool isTri = elem->isTri();
 6047: 
 6048:       if constexpr(indvel <= 0) {
 6049:          // Assuming discontinous hvel.
 6050: 
 6051:          if (isTri) { // For triangles
 6052:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6053:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6054: 
 6055:             for (int j = 0; j < 3; j++) {
 6056:                // For every node of the triangle...
 6057:                Node *node = elem->nodes[j];
 6058: 
 6059:                if (node->isDry) continue;
 6060: 
 6061:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 6062:                const Side *s2 = elem->sides[(j + 1) % 3];
 6063:                const Side *s3 = elem->sides[(j + 2) % 3];
 6064: 
 6065: 
 6066:                atomicAdd(&(node->tmp.i), 1);
 6067: 
 6068:                for (int k = kb; k < nvrt; k++)  {
 6069:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated at node j.   XXXX Function for clamping velocities. const vector2 u
 6070:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 6071:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 6072:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 6073:                   atomicAdd(&(node->utmp[k].x), u.x);
 6074:                   atomicAdd(&(node->utmp[k].y), u.y);
 6075: 
 6076:                }
 6077: 
 6078:             }
 6079:          }
 6080:          else { // For quads
 6081:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6082: 
 6083:          }
 6084: 
 6085:       }
 6086:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 6087:       
 6088:    }
 6089: 
 6090: 
 6091:    __global__ void computeNodalHorizontalVelocities2(void) {
 6092:       NODE(node);
 6093: 
 6094:       const int nodeCount = node->tmp.i;
 6095: 
 6096:       if (nodeCount == 0) 
 6097:       {
 6098:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 6099:          return;
 6100:       }
 6101: 
 6102:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 6103:       
 6104:       const int kb = node->kb;
 6105: 
 6106:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 6107:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 6108:       
 6109:       
 6110:    }   
 6111: 
 6112:  
