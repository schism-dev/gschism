  201: using Vector2 = double2; 
  202: using Vector3 = double3;
  203: using Point2  = double2;
  204: using Point3  = double3;
  205: 
  206: __device__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
  207:     return make_double2(a.x + b.x, a.y + b.y);
  208: }
  209: using Vector2 = double2; 
  210: using Vector3 = double3;
  211: __device__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
  212:     a.x += b.x;
  213:     a.y += b.y;
  214:     return a;
  215: }
  216: 
  217: __device__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
  218:     return make_double2(a.x - b.x, a.y - b.y);
  219: }
  220: 
  221: __device__ __forceinline__ double2 operator-=(double2& a, const double2& b) {
  222:     a.x -= b.x;
  223:     a.y -= b.y;
  224:     return a;
  225: }
  226: 
  227: __device__ __forceinline__ double2 operator*(const double2& v, const double s) {
  228:     return make_double2(v.x * s, v.y * s);
  229: }
  230: 
  231: __device__ __forceinline__ double2 operator*(const double s, const double2& v) {
  232:     return v * s;  // reuse the previous operator
  233: }
  234: 
  235: __device__ __forceinline__ double2 operator/(const double2& v, double s) {
  236:     return make_double2(v.x / s, v.y / s);
  237: }
  238: 
  239: __device__ __forceinline__ double norm2(const double2& v) {
  240:     return v.x*v.x + v.y*v.y;
  241: }
  242: 
  243: __device__ __forceinline__ double length(const double2& v) {
  244:     return sqrt(v.x*v.x + v.y*v.y);
  245: }
  246: 
  247: __device__ __forceinline__ double2 normalize(const double2& v) {
  248:     return v / length(v);
  249: }
  250: 
  251: __device__ __forceinline__ double dot(const double2& v, const double2& w) {
  252:     return v.x*w.x + v.y*w.y;
  253: }
  254: 
  255: __device__ __forceinline__ double cross(const double2& v, const double2& w) {
  256:     return v.x*w.y - v.y*w.x;
  257: }
  258: 
  259: __device__ __forceinline__ double2 rot90(const double2& a) {
  260:     return make_double2(a.y, -a.x);
  261: }
  262: 
  263: __device__ __forceinline__ double3 operator+(const double3& a, const double3& b) {
  264:     return make_double3(a.x + b.x, a.y + b.y, a.z + b.z);
  265: }
  266: 
  267: __device__ __forceinline__ double3 operator+=(double3& a, const double3& b) {
  268:     a.x += b.x;
  269:     a.y += b.y;
  270:     a.z += b.z;
  271:     return a;
  272: }
  273: 
  274: __device__ __forceinline__ double3 operator-(const double3& a, const double3& b) {
  275:     return make_double3(a.x - b.x, a.y - b.y, a.z - b.z);
  276: }
  277: 
  278: __device__ __forceinline__ double3 operator*(const double3& v, double s) {
  279:     return make_double3(v.x * s, v.y * s, v.z * s);
  280: }
  281: 
  282: __device__ __forceinline__ double3 operator*(double s, const double3& v) {
  283:     return v * s;
  284: }
  285: 
  286: __device__ __forceinline__ double3 operator/(const double3& v, double s) {
  287:     return make_double3(v.x / s, v.y / s, v.z / s);
  288: }
  289: 
  290: __device__ __forceinline__ double dot(const double3& v, const double3& w) {
  291:     return v.x*w.x + v.y*w.y + v.z*w.z;
  292: }
  293: 
  294: __device__ __forceinline__ double norm2(const double3& v) {
  295:     return v.x*v.x + v.y*v.y + v.z*v.z;
  296: }
  297: 
  298: __device__ __forceinline__ Vector2 toVector2(const double3& v) {
  299:     return make_double2(v.x, v.y);
  300: }
  301: 
  302: __device__ __forceinline__ double3 toVector3(const double2& v, double w) {
