 8729:          *sizeType = sizeof(Vector2);
 8730:          break;
 8731:       case (int)VarCode::gradEta1:
 8732:          *offset = (int)((char*)&sides[0].gradEta1.x - (char*)sides);
 8733:          *sizeType = sizeof(Vector2);
 8734:          break;
 8735:       case (int)VarCode::gradEta2:
 8736:          *offset = (int)((char*)&sides[0].gradEta2.x - (char*)sides);
 8737:          *sizeType = sizeof(Vector2);
 8738:          break;
 8739:       // case (int)VarCode::ghat:
 8740:       //    *offset = (int)((char*)&sides[0].ghat.x - (char*)sides);
 8741:       //    *sizeType = sizeof(Vector2);
 8742:       //    break;   
 8743:       case (int)VarCode::hhat:
 8744:          *offset = (int)((char*)&sides[0].hhat - (char*)sides);
 8745:          *sizeType = sizeof(Vector2);
 8746:          break;      
 8747:       case (int)VarCode::chi:
 8748:          *offset = (int)((char*)&sides[0].chi - (char*)sides);
 8749:          *sizeType = sizeof(double);
 8750:          break;
 8751:       case (int)VarCode::n1:
