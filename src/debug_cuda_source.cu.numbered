 6228:    __global__ void resetBoundaryAreas(void) {
 6229:       // Reset boundary areas and lengths for each segment.
 6230: 
 6231:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 6232:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 6233:       SIDE_BND(sideBnd);
 6234: 
 6235:       BoundarySegment *segment = sideBnd->segment;
 6236: 
 6237:       segment->carea = 0.0;
 6238:       segment->clen = 0.0;
 6239:  
 6240:    }
 6241: 
 6242:    __global__ void computeBoundaryAreas(void) {
 6243:    // Calculation of cross-section areas and lengths for flow b.c.
 6244: 
 6245:       SIDE_BND(sideBnd);
 6246: 
 6247:       const Side *side = sideBnd->side;
 6248:       BoundarySegment *segment = sideBnd->segment;
 6249: 
 6250:       if (segment->ifltype != 0) {
 6251: 
 6252:          const Node *n1 = side->n1;
 6253:          const Node *n2 = side->n2;
 6254: 
 6255:          const double htot = side->htot2();
 6256: 
 6257:          if (!side->isDry) {
 6258:             atomicAdd(&segment->carea, htot*side->len);
 6259:             atomicAdd(&segment->clen, side->len);
 6260:          }
 6261:       }
 6262: 
 6263:    }
 6264: 
 6265: 
 6266:    __global__ void computeFlowBcVelocities(double time) {
 6267: 
 6268:       SIDE_BND(sideBnd);
 6269: 
 6270:       const Side *side = sideBnd->side;
 6271:  
 6272:       const bool isDry = side->isDry;
 6273:       const bool isLand = sideBnd->segment->isLand;
 6274: 
 6275:    
 6276:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 6277: 
 6278:       if (isDry || isLand) return;
 6279: 
 6280:       // For wet sides in open boundaries...
 6281:       const Vector2 n = side->n;
 6282:       const BoundarySegment *segment = sideBnd->segment;
 6283: 
 6284:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 6285: 
 6286:       const int ifltype = segment->ifltype;
 6287: 
 6288:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 6289:       const Vector2 r_nuth0 = r_uth0*n;
 6290: 
 6291: 
 6292:       if (ifltype == 1 || ifltype == 2) {
 6293:       
 6294:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 6295: 
 6296:          const double unth0 = segment->qthcon*ramp/segment->carea;
 6297: printf("unth0: %f, qthcon: %f, ramp: %f, carea: %f\n", unth0, segment->qthcon, ramp, segment->carea);         
 6298:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 6299:          
 6300:       } else if (ifltype == -1) { // Flather 1
 6301: 
 6302:          for (int k = 0; k < nvrt; k++) {
 6303: 
 6304:             // uth is the normal vel.; no ramp up
 6305:             const double uth = sideBnd->nuth(k);
 6306:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 6307: 
 6308:             sideBnd->ubc[k] += uth*n;
 6309:          }
 6310: 
 6311:       } else if (ifltype == 3 || ifltype == 5) {
 6312:          // vnth0=0 !normal vel.
 6313: 
 6314:          Vector2 r_u1_bar = {0.0, 0.0};
 6315:          // Computes the contribution to the velocity from all tide frequencies
 6316:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 6317: 
 6318:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 6319:             const Vector2 umo  = sideBnd->umo(jfr); 
 6320: 
 6321:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 6322:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 6323:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 6324:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 6325: 
 6326:          }
 6327: 
 6328: 
 6329:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 6330: 
 6331:       } // if (ifltype = 3 || ifltype == 5
 6332: 
 6333: 
 6334: 
 6335:    }
 6336: 
 6337:    __global__ void computeElevationBoundaryConditions(double time) {
 6338:       // Compute elevation essential boundary conditions 
 6339: 
 6340:       NODE_BND(nodeBnd); // Each boundary node.
 6341: 
 6342:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 6343: 
 6344:       const Node *node = nodeBnd->node;
 6345:       const BoundarySegment *segment = nodeBnd->segment;
 6346:       const int iettype = segment->iettype;
 6347:       
 6348: 
 6349:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 6350:       double eic = 0.0;
 6351:       if (nramp_elev == 1) eic = nodeBnd->etaic;  // XXXX is etaic ever set?  
 6352:       else                 eic = 0.0;
 6353: 
 6354:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 6355:       const double r_eth = ramp*nodeBnd->eth;
 6356:       double r_eta1_bar = 0.0;
 6357: 
 6358:       // Compute tide elevation
 6359:       if (iettype == 3 || iettype == 5) {   
 6360: 
 6361:          if constexpr(iloadtide==1) { // loading tide
 6362:             assert(false && "Loading tide not implemented");
 6363:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 6364:          }
 6365:          
 6366:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 6367: 
 6368:             const double efa  = nodeBnd->efa[jfr]; 
 6369:             const double emo  = nodeBnd->emo[jfr]; 
 6370: 
 6371:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 6372:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 6373:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 6374: 
 6375: 
 6376:          } // for jfr
 6377: 
 6378:       } // if iettype
 6379: 
 6380:       switch (iettype) {
 6381:          case 1:
 6382:          case 2:
 6383:          case 4:
 6384:             nodeBnd->elbc = r_eic + r_eth;
 6385:             break;
 6386:          case 3:
 6387:             nodeBnd->elbc = r_eic + r_eta1_bar;
 6388:             break;
 6389:          case 5:
 6390:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 6391:             break;
 6392:       } // switch
 6393: 
 6394: 
 6395:       //Add inverse barometric effects
 6396:       if (iettype != 0 && inv_atm_bnd == 1) {
 6397:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 6398:       }
 6399: 
 6400:    }
 6401: 
 6402: 
 6403:    __global__ void computeHorizontalViscosity(void) { 
 6404: 
 6405:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 6406: 
 6407:       SIDE(side);
 6408: 
 6409:       if (side->isDry) return;
 6410: 
 6411:       for (int k = 0; k < nvrt; k++) {
 6412:          side->nuGradU[k] = {0.0, 0.0};
 6413:       }
 6414: 
 6415:       if constexpr(ihorcon == 1) {
 6416:          for (int k = side->kb; k < nvrt - 1; k++) {
 6417:             // Computes the Laplacian by using the simplified formula presented in the paper:
 6418:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 6419:             // By Zhang and Baptista.
 6420: 
 6421:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 6422:             // This is a standard discretization of the Laplacian operator.
 6423:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 6424:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 6425:             // Gamma is hvis_coef0 in the code.
 6426:             // The value of gamma needs to be < 0.5.
 6427: 
 6428:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 6429:             // side under consideration in each of the two possible elements that share the side.
 6430:             Vector2 sumU = {0.0, 0.0};
 6431:             for (int l = 0; l < 2; l++) {
 6432:                const Element *elem = side->elems[l];
 6433: 
 6434:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 6435: 
 6436:                // Find the local index of the side in the element
 6437:                const int idxSide = elem->sideLocalIdx(side);
 6438: 
 6439:                // Find the two sides that are connected to the side under consideration
 6440:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 6441:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 6442: 
 6443:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 6444: 
 6445:             }
 6446: 
 6447:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 6448: 
 6449:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 6450:    
 6451:          }
 6452:       }
 6453:       else if constexpr(ihorcon == 2) {
 6454:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 6455:       }
 6456: 
 6457: 
 6458:    }
 6459: 
 6460: 
 6461:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 6462: 
 6463:       // Set essential boundary conditions 
 6464:       NODE(node); // Each boundary node
 6465:       NodeBoundary *nodeBnd = node->nodeBnd;
 6466:       
 6467:  
 6468:       // Check if this node has essential BC
 6469:       if (nodeBnd && nodeBnd->isEssentialBC) {
 6470: 
 6471:          // Verify BC value is valid
 6472:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 6473: 
 6474:        
 6475:          // Set diagonal to 1 and zero off-diagonals
 6476:          for (int j = 0; j <= node->numNodes; j++) {
 6477:                node->coeffRow[j] = 0.0;
 6478:          }
 6479: 
 6480:          *(node->coeffDiag) = 1.0;
 6481: 
 6482: 
 6483:          // Set solution and RHS to BC value
 6484:          node->mX  = nodeBnd->elbc;
 6485:          node->qel = nodeBnd->elbc;
 6486: 
 6487:       } else {
 6488:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 6489: 
 6490:          for (int j = 0; j < node->numNodes; j++) {
 6491:                const Node* nbNode = node->nodes[j];
 6492:    	         assert(nbNode != nullptr && "setEssentialBC: nbNode is nullptr");
 6493: 
 6494:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 6495:                assert(nbNodeBnd != nullptr && "setEssentialBC: nbNodeBnd is nullptr");
 6496: 
 6497:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 6498:                   // Verify neighbor's BC value
 6499:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 6500: 
 6501:                   // Subtract contribution to RHS
 6502:                   node->qel -= node->coeffRow[node->csrSlot[j]]*nbNodeBnd->elbc;
 6503:                   node->coeffRow[node->csrSlot[j]] = 0.0;  
 6504:                }
 6505:          }
 6506: // printf("setEssentialBC: node->qel = nodeBnd->elbc - node->coeffMatrix[j]*nbNodeBnd->elbc\n");
 6507:       }
 6508:    }
 6509: 
