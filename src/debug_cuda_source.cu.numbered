 6985: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6986: //                     call parallel_abort(errmsg)
 6987: //                   endif
 6988: // #endif
 6989: 
 6990: //                 enddo !i
 6991: //                 wm=wm/sum1 !final weight
 6992: 
 6993:                 for (int j=0; j<elem->i34; j++) { // side
 6994:                   const Side *side = elem->sides[j];
 6995:                   const Node *node1 = side->n1;
 6996:                   const Node *node2 = side->n2;
 6997: 
 6998:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6999:                     trsd=0.d0
 7000:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7001:                       for (int i=0; i<elem->nweno1; i++) {
 7002:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7003:                       }
 7004:                     enddo //kk
 7005:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7006:                   } // outward flux
 7007:                 } // end for j=1,i34(ie) ! side
 7008:               } // end for k; ntr 
 7009: 
 7010:             else !simple upwind method
 7011:               do j=1,i34(ie)
 7012:                 jsj=elside(j,ie)
 7013:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7014:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7015:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7016:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7017:                   endif
 7018:                 enddo  !vertical layers
 7019:               enddo !j=1,i34(ie) ! side
 7020:             endif !order of accuracy
