 1811: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o') {
 1812: // return;   
 1813:    // Lock the mutex
 1814:    lock(&debugPlotMutex);
 1815:  
 1816:    bool ok = true;
 1817:    if (debugPlotIdx == nullptr) ok = false;
 1818:    if (*debugPlotIdx >= 10000) ok = false;
 1819:    if (ok) {
 1820:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1821:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1822:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1823:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1824:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1825:       debugPlot[(*debugPlotIdx) + 5*10000] = (double)marker;
 1826:       (*debugPlotIdx)++;
 1827:    }
 1828: 
 1829:    __threadfence();               // ensure all above writes are visible
 1830:    // Unlock the mutex
 1831:    unlock(&debugPlotMutex);
 1832: 
 1833: }
