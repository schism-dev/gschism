 7047:    __global__ void resetVelocityOpenBndNodes(void) {
 7048:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 7049: 
 7050:       NODE_BND(nodebnd);
 7051: printf("DDDDDDDDDD\n");
 7052:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 7053:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 7054:       }
 7055: 
