  820: struct Side {
  821: 
  822:    // Geometry information
  823:    int idx;               // Index of the side
  824:    Node *n1, *n2;
  825:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  826: 
  827:    double len;         // Length of the side. Used to be called distj; but I think this name is less clear now.
  828:    Vector2 center;        // Location of side center. 
  829:    double zc[nvrt];       // Side center z-coord at each vertical level
  830: 
  831:    Frame frame;
  832: 
  833:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  834:                           // this is nullptr
  835:    
  836:    int kb;                // Bottom index of the side
  837:    bool isDry;             // True if the side is dry
  838:  
  839:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  840: 
  841:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
  842: 
  843:    // Physical information
  844:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  845:    double  w2[nvrt];            // Vertical velocity at each vertical level
  846:    Vector2 btu[nvrt];           // Back-tracked velocity
  847:    Vector2 uth[nvrt];           // "Time history" velocity
  848:    Vector2 U;                   // Vertically averaged velocity vector  
  849: 
  850:    Vector2 d2uv[nvrt];          // divergence of (nu*grad u) XXX COMPUTE!!
  851: 
  852:    Vector2 bcc[nvrt];           // Baroclinic term
  853:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
  854: 
  855:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
  856:    Vector2 gradEta2;             // Gradient of elevation at current timestep
  857:    Vector2 gradPr;               // Gradient of pressure
  858:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
  859: 
  860: 
  861:    double hhat;                 // \breve{H} in notes
  862: 
  863:    double shapiro;
  864: 
  865:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
  866: 
  867:    double coriolis;             // Coriolis parameter
  868: 
  869:    // Vegetation parameters
  870:    double veg_c2;
  871:    double veg_beta;
  872: 
  873:    // Bottom drag parameters.
  874:    double chi;
  875:    double chi2;
  876: 
  877:    __inline__ __device__ double x(double t) const;
  878:    __inline__ __device__ double y(double t) const;
  879:    __inline__ __device__ Point2 p_t(double t) const;
  880: 
  881:    __inline__ __device__ Point3 center3D(int k) const { return {center.x, center.y, zc[k]}; }
  882:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
  883:    __inline__ __device__ double Dz(int k)       const { return zc[k] - zc[k-1]; }
  884: 
  885:    __inline__ __device__ Side* neigh(int index) const { 
  886:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
  887:       assert(index >= 0 && index < 4); 
  888:       assert(elems[0] != nullptr && elems[1] != nullptr);
  889: 
  890:       const int ielem = index & 1;           // 0 or 1
  891:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
  892: 
  893:       const Element* elem = elems[ielem];
  894: 
  895:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
  896: 
  897:       return elem->sides[elem->nxq(locSideIdx + iside)];
  898: 
  899:    }
  900: 
  901:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
  902: 
  903:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
  904: 
  905:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
  906:    __inline__ __device__ bool isBnd2(void) const { return elems[0] == nullptr; } // This is a different type of being boundary. XXXXX CHECK IF THIS THE SAME
  907:    __inline__ __device__ int iadv(void) const;
  908: 
  909:    __inline__ __device__ double grav3(void) const;
  910:    
  911:    __inline__ __device__ double eta2(void) const;
  912:    __inline__ __device__ double eta1(void) const;
  913:    __inline__ __device__ double depth(void) const;
  914:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
  915:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
  916: 
  917:    __inline__ __device__ double dfv(int k) const;
  918: 
  919:    __inline__ __device__ double veg_h(void)  const;
  920:    __inline__ __device__ double veg_nv(void) const;
  921:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
  922:    __inline__ __device__ double veg_alpha3D(int k) const;
  923:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
  924: 
  925:    __inline__ __device__ double etaMeanBnd(void) const;
  926: 
  927:    __inline__ __device__ double Cd(void) const;
  928: 
  929:    __inline__ __device__ Vector2 tau(void) const;
  930: 
  931:    __inline__ __device__ double zb(void) const { return zc[kb]; }
  932:    
  933: 
  934:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
  935:    __inline__ __device__ double zLevelVegRatio(int k) const { 
  936:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
  937:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
  938:    } 
  939:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
  940:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
  941:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  942:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  943: 
  944:    // Get valid starting element (for backtracking)
  945:    __inline__ __device__ Element* getStartElement() {
  946:       return elems[0] ? elems[0] : elems[1];
  947:    }
  948: 
  949:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
  950:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
  951: 
  952:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
  953: 
  954:       // Dot product of the negative velocity vector with the side normal vector
  955:       const double dot_prod1 = -dot(u, n);
  956: 
  957:       // Vector from side center to element 0 centroid
  958:       const Vector2 v2 = toVector2(elems[0]->center) - center;
  959: 
  960:       // Dot product of the vector with the side normal vector
  961:       const double dot_prod2 = dot(v2, n);
  962: 
  963:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
  964:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
  965: 
  966:       if (dot_prod1*dot_prod2 > 0.0) return elems[0];
  967:       else                           return elems[1];
  968: 
  969:  
  970:    }
  971: 
  972:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
  973:       // Given an element, returns the other element that shares this side
  974:       return (elems[0] == elem) ? elems[1] : elems[0];
  975:    }
  976: 
  977:    __forceinline__ __device__ Node* otherNode(Node* node) {
  978:       // Given a node, returns the other node that shares this side
  979:       return (n1 == node) ? n2 : n1;
  980:    }
  981:  
  982:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
  983: 
  984: 
  985: 
  986: 
  987: };
