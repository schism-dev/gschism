 1578: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000) {
 1579:    // Lock the mutex
 1580:    lock(&debugPlotMutex);
 1581:  
 1582:    if (debugPlotIdx == nullptr) return;
 1583:    if (*debugPlotIdx >= 10000) return;
 1584: 
 1585:    debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1586:    debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1587:    debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1588:    debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1589:    debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1590:    (*debugPlotIdx)++;
 1591:    // Unlock the mutex
 1592:    unlock(&debugPlotMutex);
 1593: 
 1594: }
