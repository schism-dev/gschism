 2139: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2140: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2141: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2142: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2143:    Vector2 grad = {0.0, 0.0};
 2144:    int count = 0;
 2145: 
 2146:    if constexpr(ics == 2) assert(false && "computeHorGradientAtSide: ics = 2 not implemented");
 2147: 
 2148:    // First element
 2149:    if (elems[0] != nullptr && condition(elems[0])) {
 2150:       grad += elems[0]->grad2(field);
 2151:       count++;
 2152:    }
 2153: 
 2154:    // Second element
 2155:    if (elems[1] != nullptr && condition(elems[1])) {
 2156:       grad += elems[1]->grad2(field);
 2157:       count++;
 2158:    }
 2159: 
 2160:    if (count > 0) {
 2161:       grad = grad/count;
 2162:    }
 2163:    
 2164:    return grad;
 2165: }
