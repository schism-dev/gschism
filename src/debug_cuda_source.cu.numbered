 7565:          break;
 7566:       case (int)VarCode::eta:
 7567:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 7568:          *sizeType = sizeof(double);
 7569:          break;
 7570:       case (int)VarCode::x:
 7571:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 7572:          *sizeType = sizeof(Vector2);
 7573:          break;
 7574:       case (int)VarCode::z:
 7575:          *offset = (int)((char*)&nodes[0].z[0] - (char*)nodes);
 7576:          *sizeType = sizeof(double);
 7577:          break;
 7578:       case (int)VarCode::kb:
 7579:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 7580:          *sizeType = sizeof(int);
 7581:          break;
 7582:       case (int)VarCode::isdry:
 7583:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 7584:          *sizeType = sizeof(int);
 7585:          break;         
 7586:       case (int)VarCode::w:
 7587:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 7588:          *sizeType = sizeof(double);
 7589:          break;
 7590:       case (int)VarCode::u:
 7591:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 7592:          *sizeType = sizeof(Vector2);
 7593:          break;         
 7594:       default:
 7595:          *offset = -1;    
 7596:    }  
 7597:    
 7598: }
