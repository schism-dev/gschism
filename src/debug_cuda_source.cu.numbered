 4685:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4686: 
 4687:       SIDE(side);
 4688: 
 4689:       side->U = {0.0, 0.0}; 
 4690:          
 4691:       if(side->isDry) return;
 4692: 
 4693:       const Node *node1 = side->n1;
 4694:       const Node *node2 = side->n2;
 4695: 
 4696:       // Vertically integrated velocity U (in ll if ics=2)
 4697:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4698:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  
 4699:       }
 4700: 
 4701:    }
 4702: 
 4703:    __global__ void computeBottomDragVegetation(void) {
 4704:       // UNFINISHED. CHECK THIS:
 4705:       // How many kernels are needed? Why so many for loops?
 4706:       // Is the loop on sides needed?
 4707: 
 4708:       NODE(node);
 4709: 
 4710: 
 4711:       const int    kb      = node->kb;
 4712:       const double htot    = node->htot2(); 
 4713:       
 4714:       if (node->isDry) {
 4715:          // Default values for dry nodes
 4716:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4717:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4718: 
 4719:          return;
 4720:        
 4721:       }
 4722: 
 4723:       // Computes bottom drag Cd based on the selected nchi
 4724:       node->computeBottomDragCd();
 4725:       
 4726: 
 4727: 
 4728:       //   Bottom stress in m^2/s^2
 4729:       if (node->rho[kb + 1] >= -98.0)
 4730:       {
 4731:          const double mag_u = length(node->u2[kb + 1]);
 4732:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 4733: 
 4734:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4735:          // !sediment erosion: this part needs more documentation
 4736:       }
 4737:     
 4738: 
 4739: 
 4740:       // Compute vegetation parameters
 4741:       //--------------------------------
 4742: 
 4743:       // SAV constants
 4744:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4745:       constexpr double veg_cfpsi = 0.16;
 4746: 
 4747:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4748:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4749: 
 4750:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4751:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4752:          int kbin = 0; // bin index
 4753:          for (int k = kb; k < nvrt; k++) {
 4754:             // Computes node height above the bottom level
 4755:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4756:             assert(false && "Vertical variation of vegetation not implemented");
 4757: 
 4758:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4759:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4760:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4761:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4762:             // } else {
 4763:             //    // Find the bin at which the current vertical level is
 4764:             //    while (kbin<nbins_veg_vert) {
 4765:             //       const double zn = node->z[kbin];
 4766:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4767:             //          break;
 4768:             //       } // if
 4769:             //       kbin++;
 4770:             //    } // while
 4771:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4772: 
 4773:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4774:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4775:                
 4776:             //    // Linear interpolation of the vegetation parameters
 4777:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4778:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4779:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4780:             // } // if rl10
 4781: 
 4782:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4783: 
 4784:          } // for k
 4785: 
 4786: 
 4787:       } else { // Ganthy (iveg==2)
 4788:       //  Modify canopy height, diameter, and density
 4789: 
 4790:          // Make sure there is vegetation on this node
 4791:          if (node->veg_h_unbent > 0.0) {
 4792:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4793: 
 4794:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4795:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4796:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4797: 
 4798:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4799:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4800:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4801:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4802:          } // if veg_h_unbent
 4803: 
 4804:          for (int k = 0; k < nvrt; k++) {
 4805:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4806:          } // for k
 4807:       
 4808: 
 4809:       } // if iveg
 4810:      
 4811: 
 4812:       // Compute vertical mean of veg_alpha3D
 4813:       if (iveg != 0) {
 4814:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4815:          double sum1=0.0;
 4816:          double sum2=0.0;
 4817:          // Integrate over each level under the canopy...
 4818:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 4819:             const double Dz = node->Dz(k);
 4820: 
 4821:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 4822:             sum2 += Dz;
 4823: 
 4824:          } // for k
 4825:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4826:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4827: 
 4828:       } // if iveg
 4829: 
 4830:    }
 4831: 
 4832:    __global__ void computeVegetationAndDragParameters(void) {
 4833:       // Computes the vegetation and drag model parameters:
 4834:       // chi, \tilde\chi, beta, \breve{H}
 4835:       
 4836:       SIDE(side);
 4837: 
 4838:       if (side->isDry) return;
 4839: 
 4840:       const double htot = side->htot2();
 4841:       const int    kb   = side->kb;
 4842: 
 4843:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4844: 
 4845:       const double veg_h     = side->veg_h();
 4846:       const double veg_nv    = side->veg_nv();
 4847:       const double veg_c     = side->veg_c();
 4848:       const double veg_beta  = side->veg_beta;
 4849:       const double veg_alpha = side->veg_alpha_vert_mean();
 4850: 
 4851:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4852:       // Velocity magnitude at the bottom level
 4853:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4854:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 4855:       side->chi2 = side->Cd()*vmag1;
 4856:       side->chi  = side->chi2;
 4857:       if constexpr(iveg != 0) {
 4858:          const Node *n1 = side->n1;
 4859:          const Node *n2 = side->n2;
 4860:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4861:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4862:       }
 4863: 
 4864:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4865: 
 4866:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4867:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4868:       double magUa = 0.0;
 4869:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4870:          // 3D wet side with veg...
 4871: 
 4872:          double magUa = 0.0;
 4873:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4874:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4875: 
 4876:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4877:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4878:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4879: 
 4880:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4881:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4882: 
 4883:                // Velocity magnitude at the bottom (l) of the level
 4884:                const double ul = length(side->u2[k]);
 4885: 
 4886:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4887:                magUa += Dz*0.5*(uh + ul);
 4888: 
 4889:             } // if HasVegetation
 4890:          } // for k
 4891:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4892: 
 4893:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4894:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4895:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4896:             const double zCpy = side->zTopCanopy();
 4897:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4898:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4899:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4900:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4901:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4902:          } // if isSubmerged
 4903:       } // if iveg   
 4904: 
 4905:       // Computes the friction modified depth, \breve{H} in notes
 4906:       if (side->is2D()) { // 2D
 4907: 
 4908:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4909:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4910: 
 4911:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4912: 
 4913:          side->hhat = htot*htot/fricH; 
 4914: 
 4915:       } else { // 3D
 4916:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4917: 
 4918:          if constexpr(iveg != 0) {
 4919:             
 4920:             if (side->isSubmerged()) { 
 4921:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4922:                side->hhat -= veg_c*Hhat_alpha;
 4923: 
 4924:             } else { // Emergent
 4925:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4926:             }
 4927:          } // if iveg
 4928: 
 4929:          // Enforce positivity for 3D model
 4930:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 4931:       } // if 3D
 4932: 
 4933:    }
 4934: 
 4935: 
 4936: 
 4937:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4938:    // Computes the density gradient between two elements, e1 and e2.
 4939:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4940:    // zero in the direction normal to the side. 
 4941:    // 
 4942:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4943:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4944:    //
 4945:    // Input:
 4946:    //    e1: Element
 4947:    //    e2: Neighbor element (or nullptr if boundary)
 4948:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4949:    //    k: Index of the half-level at which the density is interpolated
 4950:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4951:    // 
 4952:    // Output:
 4953:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4954:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4955: 
 4956:       if (e2 == nullptr || e2->isDry) {
 4957:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4958: 
 4959:          Side *side = e1->sides[j];
 4960:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4961:                  
 4962:          if constexpr(ics == 1) {
 4963:             vec = side->n; // Normal vector to the side
 4964:          } else {
 4965:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 4966:             // IMPLEMENT THIS XXXXXX
 4967:             // !replace with xel, yel?
 4968:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4969:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4970:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4971:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4972:          } //ics
 4973:                    
 4974:          diffRho = 0.0;
 4975: 
 4976:       } else { //internal and wet
 4977:          if constexpr(ics==1) {
 4978:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4979: 
 4980:             // Vector from e1 to e2
 4981:             vec = e2->center - e1->center;
 4982: 
 4983:          } else { 
 4984:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 4985:             // IMPLEMENT THIS XXXXXX
 4986:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4987:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4988:             //                   alow(j)=xctr2
 4989:             //                   bdia(j)=yctr2
 4990:          } // ics
 4991: 
 4992:          diffRho = rho2 - e1->demeanedDensity(k);
 4993:       }
 4994: 
 4995:    }
 4996: 
 4997:    __global__ void computeDensityCubicSplines(void) {
 4998:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4999: 
 5000:       ELEM(elem);
 5001: 
 5002:       if (elem->isDry) return;
 5003: 
 5004:       const int kb = elem->kb;
 5005: 
 5006:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5007:       if (elem->is2D()) {
 5008:          // In the 2D case, the density is constant at the prism level. 
 5009:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5010:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5011:       } else { //3D
 5012: 
 5013:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5014:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5015:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5016:          ///// XXXX CHECK INDICES!!!!!
 5017:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5018:       } // 2D/3D
 5019: 
 5020:    }
 5021: } // extern "C"
 5022: 
 5023: 
 5024: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5025: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5026: 
 5027:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5028: 
 5029:    const int kb  = elem->kb;
 5030:    const int kb2 = elem2->kb;
 5031: 
 5032:    // z-coordinate of prism of elem
 5033:    const double zp = elem->z_prism(k);
 5034: 
 5035:    double rho = 0.0;
 5036: 
 5037:    if (elem2->is2D()) {
 5038:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5039: 
 5040:    } else {  // 3D
 5041: 
 5042:       // eta_min may be < zmax
 5043:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5044:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5045: 
 5046:       // (Extrapolate density below bottom, we will fix it later)
 5047:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5048:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5049:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5050:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5051:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5052:    } // 2D/3D
 5053:      
 5054: 
 5055:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5056:    // Now we need to fix it.
 5057:    if (elem->z[k] < elem2->z[kb2]) {
 5058:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5059: 
 5060:       // There are two methods to adjust the density at the bottom of the element.
 5061:       // iunder_deep=0: 
 5062:       const double depth1 = abs(elem->z[kb]); // larger depth
 5063: 
 5064:       if (iunder_deep==0) {
 5065: 
 5066:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5067: 
 5068:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5069: 
 5070:       } else { // iunder_deep != 0
 5071: 
 5072:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5073: 
 5074:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5075: 
 5076:          //   Demeaned density at the same z coordinate as
 5077:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5078:          }
 5079: 
 5080:       } // if iunder_deep
 5081:    } // if elem->z[kb] < elem2->z[kb]
 5082: 
 5083:    return rho;
 5084: }
 5085: 
 5086: 
 5087: extern "C" {
 5088:    __global__ void computeDensityGradient(void) {
 5089: 
 5090:       if constexpr(ibc != 0) return;
 5091: 
 5092:          // Compute the horizontal density gradient at each element.
 5093:       // It works in two steps:
 5094:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5095:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5096:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5097:       //             gradRho.r1 = rho1 - rho0
 5098:       //             gradRho.r2 = rho2 - rho0
 5099:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5100:       // 
 5101:       //  NOTE: We use de-meaned densities.
 5102: 
 5103:       ELEM(elem);
 5104: 
 5105:       if (elem->isDry) return;
 5106: 
 5107:       const int kb  = elem->kb;
 5108:       const int i34 = elem->i34;
 5109: 
 5110:       for (int k = kb + 1; k < nvrt; k++) {
 5111:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5112:          //             gradRho.r1 = rho1 - rho0
 5113:          //             gradRho.r2 = rho2 - rho0
 5114:          int icount = 0;
 5115:          double sumRx = 0.0;
 5116:          double sumRy = 0.0;
 5117:          for (int j1=0; j1<i34; j1++) { 
 5118: 
 5119:             const int j2 = elem->nxq(j1 + 1);
 5120: 
 5121:             // Pairs of consecutive neighbor elements of elem
 5122:             const Element *e1 = elem->nghbElems[j1];
 5123:             const Element *e2 = elem->nghbElems[j2];
 5124: 
 5125:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5126:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5127:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5128: 
 5129:             // Compute the density difference and the vector from elem to e1 and e2
 5130:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5131:             double diffRho1, diffRho2;
 5132:             Vector2 vec1, vec2;
 5133:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5134:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5135: 
 5136:             const double rl1 = length(vec1);
 5137:             const double rl2 = length(vec2);
 5138:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5139: 
 5140:             const double delta = cross(vec1, vec2);
 5141:             const double sintheta = abs(delta)/(rl1*rl2);
 5142: 
 5143:             // To avoid problems, avoid elements with small angle between vectors
 5144:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5145:             const bool validEq = (sintheta > sin_one_deg);
 5146: 
 5147:             if (validEq) {
 5148:                // Solve the system of equations to get the density gradient at elem
 5149:                icount++;
 5150:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5151:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5152:                sumRx += Rx;
 5153:                sumRy += Ry;
 5154:             }
 5155:          } // for j1
 5156: 
 5157:          // Compute the average density gradient at elem
 5158:          if (icount==0) {
 5159:            // Bad mesh quality; bail out with 0 b-cc
 5160:            elem->gradRho[k] = {0.0, 0.0};
 5161:          } else {
 5162:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5163:          }
 5164: 
 5165:       } // for k
 5166: 
 5167:    }
 5168: 
 5169:    __global__ void computeBaroclinicTerm(void) {
 5170:    // Computes the baroclinic term at sides (at half levels).
 5171:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5172:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5173: 
 5174:       if (ibc == 1) return;
 5175: 
 5176:       SIDE(side);
 5177: 
 5178:       if (side->isDry) return;
 5179: 
 5180:       const Element *e1 = side->elems[0];
 5181:       const Element *e2 = side->elems[1];      
 5182:       const int kb = side->kb;
 5183:       
 5184:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5185: 
 5186:       // interpolates vertically the density gradient of the two elements at the half level/
 5187: 
 5188:       int k1 = max(kb, nvrt / 2);
 5189:       int k2 = max(kb, nvrt / 2);
 5190: 
 5191:       // Starts the integration at the surface and goes down to the bottom
 5192:       side->bcc[nvrt-1] = {0.0, 0.0};
 5193:       for (int k = nvrt - 2; k >= kb; k--) {
 5194:       // For each prism level (from surface to bottom)...
 5195: 
 5196:          // For both elements, interpolate density gradient at the side's half level.
 5197:          // The gradient at the side is the average of the gradients at the elements.
 5198:          // w1, w2 are used to take into account boundary sides, with just one element.
 5199:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5200:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5201:          const double wsum = w1 + w2;
 5202:          w1 = w1/wsum;
 5203:          w2 = w2/wsum;
 5204:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5205: 
 5206:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5207:          Vector2 gradRho = {0.0, 0.0};
 5208:          if (e1 != nullptr && k > kb) {
 5209:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5210:             
 5211:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5212:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5213:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5214: printf("###### k1 = %d, side->idx = %d, zc[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, zrat = %.16f\n",
 5215:       k1, side->idx, k, side->zc[k], k1, e1->z[k1], k1 + 1, e1->z[k1 + 1], e1->gradRho[k1].x, e1->gradRho[k1].y, zrat);            
 5216:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5217:          }      
 5218:          if (e2 != nullptr && k > kb) {
 5219:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5220:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5221:             
 5222:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5223:          }
 5224: 
 5225:          if constexpr(ics==2) {
 5226:             assert(false && "Not implemented: ics == 2");
 5227:             // IMPLEMENT THIS XXXXXX
 5228:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5229:             // swild(1)=tmp1
 5230:             // swild(2)=tmp2
 5231:          }
 5232:          
 5233:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5234:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5235:          // CHECK INDICES!!! XXX
 5236:          const double grav3 = side->grav3();
 5237:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5238: 
 5239:       } // for
 5240: 
 5241:    }
 5242: 
 5243: 
 5244: 
 5245:    __global__ void computeHorGradientAtSide(void) {
 5246: 
 5247:       // Compute the horizontal density gradient at each element.
 5248:       // It works in two steps:
 5249:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5250:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5251:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5252:       //             gradRho.r1 = rho1 - rho0
 5253:       //             gradRho.r2 = rho2 - rho0
 5254:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5255:       // 
 5256:       //  NOTE: We use de-meaned densities.
 5257: 
 5258:       SIDE(side);
 5259: 
 5260: // printf("side->isDry: %d\n", side->isDry);
 5261:       if (side->isDry) return;
 5262: 
 5263:       // Computes the gradient of the variables at the side center.
 5264:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5265:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5266:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 5267: 
 5268:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5269:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5270:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5271:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5272: 
 5273:    }
 5274: 
 5275: 
 5276:    __global__ void solveMomentumEquations(double time) {
 5277: 
 5278:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5279:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5280: 
 5281:       SIDE(side);
 5282: 
 5283:       if (side->isDry) 
 5284:       {
 5285:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 5286: 
 5287:          return;
 5288:       }
 5289: 
 5290:       const Node *n1 = side->n1;
 5291:       const Node *n2 = side->n2;
 5292: 
 5293:       const int kb = side->kb;
 5294: 
 5295:       const double veg_h = side->veg_h();
 5296:       const double grav3 = side->grav3();
 5297: 
 5298:       if (side->is2D()) {
 5299:          // Warning: Do not use htot2, which is updated.
 5300:          const double htot = side->htot1();
 5301:          const double hhat = side->hhat;
 5302: 
 5303:          // assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5304: 
 5305:          Vector2 tau2 = {0.0, 0.0};
 5306:           
 5307:          if constexpr(ics==1) {
 5308:             tau2 = side->tau();
 5309: 
 5310:          } else {
 5311:             assert(false && "Not implemented: ics == 2");
 5312:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5313:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5314:             // taux2=(vn1+tt1)*0.5d0
 5315:             // tauy2=(vn2+ss1)*0.5d0
 5316:          } // if ics         
 5317: 
 5318:          // hat_gam has units of m/s
 5319: 
 5320:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5321: 
 5322:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5323:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5324: 
 5325:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5326: 
 5327: 
 5328:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 5329:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 5330: 
 5331:          for (int k = 0; k < nvrt; k++) side->u2[k] = {ux, uy};
 5332: 
 5333:       }
 5334:       else { // 3D
 5335: 
 5336:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5337:          // 
 5338:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5339:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5340:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5341:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5342:          // k+1 and k.
 5343: 
 5344: 
 5345:          const int ndim = nvrt - kb;
 5346:          const double zTopCanopy = side->zTopCanopy();
 5347: 
 5348:          // Initialize the tridiagonal system
 5349:          for (int k = kb + 1; k < nvrt; k++) {
 5350:             
 5351:             const int kin = k - (kb + 1);
 5352: 
 5353:             // Vertical viscosity at the face center
 5354:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 5355: 
 5356:  
 5357:             alow[kin] = 0.0;
 5358:             cupp[kin] = 0.0;
 5359:             bdia[kin] = 0.0;
 5360: 
 5361:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5362:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5363: 
 5364:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5365:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5366:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5367: 
 5368:             // First part: layers k, k+1
 5369:             if (k < nvrt - 1) {
 5370:                              
 5371:                if constexpr(iveg != 0) {
 5372: 
 5373:                   // If there is vegetation at this level...
 5374:                   if (zTopCanopy > side->zc[k]) {
 5375:                      // If the canopy is above the k layer...
 5376:                      
 5377:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5378:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5379:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5380:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5381: 
 5382:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5383:                      const double vmag2 = length(ut2);
 5384:                      const double vmag1 = length(side->u2[k]);
 5385:                      const double vmag = 0.5*(vmag1 + vmag2);
 5386:                      
 5387:                      // Computes the vegetation alpha at the face center
 5388:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5389: 
 5390:                      cff1 += veg_alpha_sd*dt*vmag;
 5391: 
 5392:                   } // if (zTopCanopy
 5393:                } // if iveg
 5394: 
 5395:                const double dzz = side->Dz(k + 1);
 5396:                const double tmp = dt*dfz/dzz;
 5397:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5398: 
 5399:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5400:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5401:             }
 5402: 
 5403: 
 5404:             // Second part: layers k-1, k
 5405:             if (k > kb + 1) {
 5406: 
 5407:                double cff1 = 1.0; //init \bar{c^k}
 5408: 
 5409:                if constexpr(iveg != 0) {
 5410:                   // If there is vegetation at this level...
 5411:                   if (zTopCanopy > side->zc[k-1]) {
 5412:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5413:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5414: 
 5415:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5416: 
 5417:                      const double vmag2 = length(ut2);
 5418:                      const double vmag1 = length(side->u2[k-1]);
 5419:                      const double vmag = 0.5*(vmag1 + vmag2);
 5420: 
 5421:                      // Computes the vegetation alpha at the face center
 5422:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5423:                      cff1 += veg_alpha_sd*dt*vmag;
 5424:                   } // if zTopCanopy
 5425: 
 5426:                } // if iveg
 5427: 
 5428:                const double dzz = side->Dz(k);
 5429:                const double tmp = dt*dfz/dzz;
 5430:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5431: 
 5432:                alow[kin] += cff1*dzz/6.0 - tmp;
 5433:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5434: 
 5435:             } else { // Bottom boundary
 5436:                // This occurs at the bottom, where the bottom drag is applied.
 5437: 
 5438:                bdia[kin] += dt*side->chi2; // XXXX
 5439: 
 5440:             } // if (k > kb + 1)
 5441: 
 5442: 
 5443:          } // for (int k
 5444: 
 5445: 
 5446: 
 5447:          // Computes the RHS.
 5448:          // -----------------
 5449: 
 5450:          //	BC to be imposed at the end.
 5451: 
 5452:          const Vector2 gradETP  = side->gradETP;
 5453:          const Vector2 gradPr   = side->gradPr;
 5454:          const Vector2 gradEta1 = side->gradEta1;
 5455:          const Vector2 gradEta2 = side->gradEta2;
 5456: 
 5457:          const Vector2 *btu = side->btu;
 5458:          const Vector2 *u2  = side->u2;
 5459:          const double coriolis = side->coriolis;
 5460:          const Vector2 *nuGradU = side->nuGradU;
 5461: 
 5462: 
 5463:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5464: 
 5465:          for (int k = kb + 1; k < nvrt; k++) {
 5466:             const int kin = k - kb - 1;
 5467: 
 5468:             const double dz_0 = side->Dz(k);
 5469:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5470: 
 5471:             rrhs[kin] = {0.0, 0.0};
 5472:             double dz = 0.0;
 5473: 
 5474:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5475:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5476:             if (k < nvrt  ) dz += dz_1;
 5477:             if (k > kb + 1) dz += dz_0;
 5478: 
 5479:             // Elevation gradient, atmospheric pressure and tidal potential
 5480:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5481: 
 5482:             // Coriolis, advection, wind stress, and horizontal viscosity
 5483:             if (k < nvrt - 1) {
 5484: 
 5485: 
 5486:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5487:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5488:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5489:                                                 
 5490: 
 5491:                //diff stress tensors 1006
 5492:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5493:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5494:                   assert(false && "Not implemented: itur == 5");
 5495:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5496:                }
 5497:                // else assert(false && "itur # Not implemented");
 5498: 
 5499:             } else { // k == nvrt - 1 SURFACE
 5500:                Vector2 tau2 = {0.0, 0.0};
 5501:                if constexpr(ics==1) {
 5502:                   tau2 = side->tau();
 5503:       
 5504:                } else {
 5505:                   assert(false && "Not implemented: ics == 2");
 5506:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5507:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5508:                   // taux2=(vn1+tt1)*0.5d0
 5509:                   // tauy2=(vn2+ss1)*0.5d0
 5510:                } // if ics
 5511: 
 5512:                rrhs[kin] += dt*tau2;
 5513:           
 5514: 
 5515:             } // if k<nvrt
 5516: 
 5517:             if (k > kb + 1) {
 5518:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5519:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5520:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5521: 
 5522:                // diff stress tensors 1006
 5523:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5524:                   assert(false && "Not implemented: itur == 5");
 5525:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5526:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5527:                }
 5528:                // else assert(false && "itur # Not implemented");
 5529: 
 5530: 
 5531:             } // if k>kbs + 1
 5532: 
 5533:             // Baroclinic
 5534:             Vector2 *bcc = side->bcc;
 5535:             if constexpr(ibc == 0) {
 5536:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5537:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5538: 
 5539:             } // if ibc==0
 5540: 
 5541:          } // k=kb + 1,nvrt
 5542: 
 5543: 
 5544:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5545: 
 5546:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 5547:             const int kin = k - kb - 1;
 5548:    
 5549:             // Velocity is always clamped to maximum values
 5550:             side->u2[k] = {clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely)};
 5551:          } // k
 5552: 
 5553:       } // if side->is2D()
 5554:       
 5555: 
 5556:       // Impose velocity boundary condition at the bottom
 5557:       if constexpr(imm == 2) { // 3D bed deformation model
 5558:          double dep;
 5559:          Vector2 vel;
 5560: 
 5561:          assert(false && "Not implemented: imm == 2");
 5562:          //update_bdef(time, x0, y0, dep, vel);
 5563:          // side->u2[kb] = vel;
 5564: 
 5565:       } else { // imm = 0 or 1
 5566:          if (side->Cd() == 0.0) {
 5567:             side->u2[kb] = side->u2[kb + 1];
 5568: 
 5569:          } else if (side->is3D()) { // 3D no slip bottom   
 5570:             side->u2[kb] = {0.0, 0.0};
 5571:          }
 5572:           
 5573:       } // if imm
 5574: 
 5575:       // The velocities below the bottom level are set to zero
 5576:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 5577: 
 5578: 
 5579:    }
 5580: 
 5581: 
 5582:    __global__ void applyMomentumBC(void) {
 5583: 
 5584:       SIDE_BND(sideBnd);
 5585: 
 5586:       Side *side = sideBnd->side;
 5587:       const BoundarySegment *segment = sideBnd->segment;
 5588:       const Node *n1 = side->n1;
 5589:       const Node *n2 = side->n2;
 5590: 
 5591:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5592: 
 5593:       const bool isLand = segment->isLand;
 5594:       const int ifltype = segment->ifltype;
 5595: 
 5596:       const int kb = side->kb;
 5597: 
 5598: 
 5599:       if (!isLand && ifltype != 0) {
 5600:          const Vector2 *ubc = sideBnd->ubc;
 5601:   
 5602:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5603:             
 5604:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5605:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5606: 
 5607:             if (ifltype == -1) {
 5608:                // Flather 1
 5609: 
 5610:                const double depth = side->depth();
 5611: 
 5612:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5613: 
 5614:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5615: 
 5616:                side->u2[k] = vnorm*side->n;
 5617: 
 5618:             } else if (ifltype == -2) { // Discharge
 5619: 
 5620:                const double eta1 = side->eta1();
 5621:                const double eta2 = side->eta2();
 5622:                const double htot = side->htot2();
 5623: 
 5624:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5625:                assert(false && "Not implemented: Discharge bc");
 5626:                // const double dischrg = discharge(eta1);
 5627:                const double dischrg = 0.0; // XXX REMOVE
 5628:                
 5629: 
 5630:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5631: 
 5632:                const double vnorm = dischrg*eta2/htot;
 5633: 
 5634:                side->u2[k] = vnorm*side->n;
 5635: 
 5636:             }
 5637:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5638:                const double vnorm = dot(side->u2[k], side->n);
 5639: 
 5640:                double rat;
 5641:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5642:                else              rat = segment->vobc2; // outgoing
 5643: 
 5644:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5645: 
 5646:             }
 5647:             else { // not Flather or 3D radiation
 5648:                side->u2[k] = ubc[k];
 5649: 
 5650:             } // if (segment->ifltype...
 5651: 
 5652:          }
 5653: 
 5654:       }
 5655:       else if (isLand) { // if it is land boundary side
 5656: 
 5657:          if constexpr(islip == 0) { // free slip
 5658: 
 5659:             for (int k = kb; k < nvrt; k++) {
 5660: 
 5661:                const Vector2 t = side->t();
 5662:                const Vector2 n = side->n;
 5663: 
 5664:                double vnorm = 0.0; // for most cases
 5665:                const double vtan = dot(side->u2[k], t);
 5666:                
 5667:                side->u2[k] = vtan*t - vnorm*n;
 5668: 
 5669:             }
 5670: 
 5671:          } else { // no slip
 5672:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5673: 
 5674:          }
 5675:       } // if (side segment type...
 5676: 
 5677:    
 5678: 
 5679:    }
 5680: 
 5681: 
 5682:    __global__ void shapiroFilter1(void) {
 5683:       // First step of the Shapiro filter (normally used if indvel<=0)
 5684:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5685: 
 5686:       SIDE(side);
 5687: 
 5688:       // Only internal wet sides are processed
 5689:       if (side->isDry || !(side->isInternal())) return;
 5690: 
 5691:       const int kb = side->kb;
 5692: 
 5693:       for (int mm = 0; mm < niter_shap; mm++) {
 5694: 
 5695:          for (int k = kb + 1; k < nvrt; k++) {
 5696:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5697:             Vector2 suru = {0.0, 0.0};
 5698: 
 5699:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5700: 
 5701:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 5702: 
 5703:                int kin = k;
 5704:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5705:                
 5706:                if constexpr(ics==1) {
 5707:                   suru += nSide->u2[kin];
 5708: 
 5709:                } else {
 5710:                   assert(false && "Not implemented: ics == 2");
 5711:                   // Vector2 vn1, vn2;
 5712:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5713:                   // suru=suru+vn1;
 5714:                   // surv=surv+vn2;
 5715:                }
 5716:             }
 5717: 
 5718:             // Reusing bcc as a temporary array to store the suru values.
 5719:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5720: 
 5721:          }
 5722:       }
 5723:    }
 5724: 
 5725:    __global__ void shapiroFilter2(void) {
 5726:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5727: 
 5728:       SIDE(side);
 5729: 
 5730: 
 5731:       if (side->isDry || !(side->isInternal())) return;
 5732: 
 5733:       const int kb = side->kb;
 5734: 
 5735:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5736: 
 5737:       if (side->is2D()) {
 5738:          side->u2[kb + 1] = side->bcc[kb + 1];
 5739:          side->u2[kb    ] = side->u2 [nvrt - 1];
 5740: 
 5741:       } else {
 5742:          // 3D
 5743:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5744:          
 5745:       }
 5746: 
 5747:    }
 5748: 
 5749: 
 5750:    __global__ void ul0UpdateZCoords(void) {
 5751:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5752:       
 5753:       NODE(node);      
 5754: 
 5755: 
 5756:       if (false) {//node->isDry) {  //XXXXXXXXXXXXXXXXX
 5757: 
 5758:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 5759: 
 5760:          if constexpr(ivcor != 1) node->kb = 0;
 5761: 
 5762:       } else {
 5763: 
 5764:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 5765:          node->updateKb();
 5766: 
 5767:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5768: 
 5769:       }
 5770: 
 5771:       // We use the temp.b field to store the previous state of isDry.
 5772:       node->tmp.b = node->isDry;
 5773: 
 5774:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5775:       node->isDry = true;
 5776: 
 5777:    }
 5778: 
 5779:    __global__ void ul0ComputeDryElements(void)
 5780:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 5781:    {
 5782:       ELEM(elem);
 5783: 
 5784:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 5785: 
 5786:       elem->kb = 0;
 5787: 
 5788:       if (elem->isDry) return;
 5789: 
 5790: 
 5791:    //    if(elem->isDry2()) { // XXXX
 5792:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5793:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5794:    //        call parallel_abort(errmsg)
 5795:    //    }
 5796: 
 5797:       const Node *n1 = elem->nodes[0];
 5798:       const Node *n2 = elem->nodes[1];
 5799:       const Node *n3 = elem->nodes[2];  
 5800:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 5801: 
 5802:       // Computes element's kb as the minimum of the nodes' kb.
 5803:       const int kb1 = n1->kb;
 5804:       const int kb2 = n2->kb;
 5805:       const int kb3 = n3->kb;
 5806:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5807: 
 5808: 
 5809:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5810: 
 5811: 
 5812:       // Computes the element z as the mean of the nodes z.
 5813:       for (int k = elem->kb; k < nvrt; k++) {
 5814: 
 5815:          // Compute the element z as the mean of the nodes z.
 5816:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 5817:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5818:          elem->z[k] /= elem->i34;
 5819: 
 5820:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5821:       }
 5822:                   
 5823:    }
 5824: 
 5825:    __global__ void ul0ComputeDryNodes(void)
 5826:    // Updates node's isDry based on the elements' isDry. 
 5827:    {
 5828:       NODE(node);
 5829: 
 5830:       node->isDry = true;
 5831: 
 5832:       // A node is wet if at least one of the elements sharing it is wet.
 5833:       for (int j = 0; j < node->numElements; j++) {
 5834:          const Element *elem = node->elements[j];
 5835:          if (!elem->isDry) {
 5836:             node->isDry = false;
 5837:             break;
 5838:          }
 5839:       }
 5840: 
 5841:        
 5842:    }
 5843: 
 5844: 
 5845:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5846:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 5847:    // node->tmp.b is true if the node was previously dry.
 5848:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 5849:    {
 5850:       NODE(node);
 5851:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5852: 
 5853:       // Avoid this the first time step.
 5854:       if (it == iths) return;  
 5855: 
 5856:       const bool wasDry = node->tmp.b;
 5857: 
 5858: if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 5859: 
 5860:       // assert(node->isDry == node->isDry2() && "These two must be identical at this point"); XXXXX 
 5861:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 5862: 
 5863:          for (int k=0; k < nvrt; k++) {
 5864: 
 5865:             Vector3 utmp={0.0, 0.0, 0.0};
 5866: 
 5867:             double ttmp=0.0;
 5868:             double stmp=0.0;
 5869:             int icount=0;
 5870:             for (int j = 0; j < node->numNodes; j++) {
 5871: 
 5872:                const Node *nbrNode = node->nodes[j];
 5873:                
 5874:                const bool wasNbrDry = nbrNode->tmp.b;
 5875: 
 5876:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 5877:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 5878: 
 5879:                   icount++;
 5880: 
 5881:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5882:                   utmp += nbrNode->uvw2(k);
 5883:                   
 5884:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 5885:                   stmp += nbrNode->tracers[k].tracer[1]; 
 5886:                }
 5887:             }
 5888: 
 5889:             if (icount > 0) {
 5890:                const double inv_icount = 1.0/icount;
 5891:                utmp = inv_icount*utmp;
 5892:                node->u2[k]     = toVector2(utmp);
 5893:                node->w2[k]     = utmp.z;
 5894:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5895:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5896:             } else {
 5897:                node->u2[k] = {0.0, 0.0};
 5898:                node->w2[k] = 0.0;
 5899:                // Initialize tracers to 0.0??? XXXXX
 5900:             }
 5901:          }
 5902:       }
 5903:    }
