 9148: __global__ void printMatrix(bool full) {
 9149:    // Debugging: print the FEM matrix row for each local node
 9150: 
 9151:    const int size = mesh->np;
 9152:    double sum = 0.0;
 9153: 
 9154:    for (int idx_node = 0; idx_node < size; idx_node++) {
 9155:       const Node *node = mesh->localNodeData + idx_node;
 9156: 
 9157:       if (full)
 9158:          printf("idx_node = %d [%d] diag=%lf, [",
 9159:                 idx_node, node->numNodes, *(node->coeffDiag));
 9160: 
 9161:       // Full CSR row length = numNodes + 1 (includes diagonal)
 9162:       for (int k = 0; k < node->numNodes + 1; k++)
 9163:          sum += node->coeffRow[k];
 9164: 
 9165:       for (int j = 0; j < node->numNodes; j++) {
 9166:          const Node *nbNode = node->nodes[j];
 9167:          const double aij = node->coeffRow[node->csrSlot[j]];
 9168:          if (full && aij != 0.0)
 9169:             printf("%d:%f,  ", nbNode->idx, aij);
 9170:       }
 9171: 
 9172:       if (full) printf("]\n");
 9173:    }
 9174: 
 9175:    if (!full) printf("sum=%lf\n", sum);
 9176: }
