 4801:    __global__ void setupMultiGPUCGSolver(double* data_d, double* b_d, 
 4802:                                          int *indices, int *indptr) {
 4803:    // Builds all the A_ij matrices and b_i and x_i vectors for the solver.
 4804: 
 4805:       NODE(node);
 4806: 
 4807:       // Global and local indices of the node.
 4808:       // In this function, I stands for the global index of the current node,
 4809:       // and J stands for the global index of the neighbor node under consideration.
 4810:       // i and j are the local indices of the current node and the neighbor node under consideration.
 4811:       // Notice that i and j may be local to different GPUs.
 4812:       // idxPart is the number of the partition of the *neighbor* node. There is
 4813:       // a biunivocal correspondence between the partitions and the GPUs.
 4814:       const int I = node->idx;      
 4815:       const int i = idx_node;       
 4816:       const int partI = node->part; // Partition of the current node.
 4817:       
 4818: 
 4819:       setBValue(partI, i, node->qel);
 4820: 
 4821:    
 4822:  
 4823:    }
 4824: }
