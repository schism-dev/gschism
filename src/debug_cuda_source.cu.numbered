 7684: __global__ void getStructSizes(int* sizes)  {
 7685:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 7686:       sizes[0] = (int)sizeof(Node);
 7687:       sizes[1] = (int)sizeof(Element);
 7688:       sizes[2] = (int)sizeof(Side);
 7689:       sizes[3] = (int)sizeof(NodeBoundary);
 7690:       sizes[4] = (int)sizeof(SideBoundary);
 7691:       sizes[5] = (int)sizeof(BoundarySegment);
 7692: }
