  367: 
  368: struct Frame {
  369:    double _t[9]; // t stands for tensor.
  370: 
  371:    // Access the tensor in Fortran order
  372:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  373: 
  374:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  375: 
  376:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  377: 
  378:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  379:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  380:       sincos(ar2, &sin_ar2, &cos_ar2);
  381: 
  382:       t(0,0) = -sin_ar1;
  383:       t(1,0) =  cos_ar1;
  384:       t(2,0) =  0.0;
  385:       t(0,1) = -cos_ar1*sin_ar2;
  386:       t(1,1) = -sin_ar1*sin_ar2;
  387: 
  388:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  389: 
  390:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  391:       assert (ar4!=0.0 && "GRID: ar4=0");
  392: 
  393:       const double ar4_inv = 1.0/ar4;
  394:       t(0,1) = t(0,1)*ar4_inv;
  395:       t(1,1) = t(1,1)*ar4_inv;
  396:       t(2,1) = t(2,1)*ar4_inv;
  397: 
  398:       // The third vector is the cross product of the first two
  399:       crossProduct(t(0,0), t(1,0), t(2,0), 
  400:                    t(0,1), t(1,1), t(2,1), 
  401:                    t(0,2), t(1,2), t(2,2));
  402:    }
  403: 
  404: 
  405:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  406:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  407:    // Inputs:
  408:    //        vec0: vel. in this frame;
  409:    //        frameout: Output frame;
  410:    // Output: 
  411:    //        vec1: vel. in new frame  
  412: 
  413:       auto const fo = frameout;
  414:       Vector2 vec1;
  415: 
  416:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  417:       // of t and fo.t are the same.
  418:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  419:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  420: 
  421:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  422:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  423: 
  424:       return vec1;
  425:    }
  426: 
  427:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  428:       // Transform a vector from global to local frame
  429:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  430:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  431:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  432:    }
  433: 
  434:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  435:       // Transform a vector from local to global frame
  436:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  437:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  438:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  439:    }   
  440: 
  441:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  442:    // Tranforms a point from global to local frame     
  443:       G2L(pi - origin0, po);
  444:    }
  445: 
  446:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  447:    // Transforms a point from local to global frame      
  448:       L2G(pi, po);
  449:       po = po + origin0;
  450:    }
  451: 
  452: };
