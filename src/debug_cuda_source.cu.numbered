 8169: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8170:    // Get the value of a variable from an side
 8171:    // varName is the name of the variable to get
 8172:    // var is the array to store the value
 8173:    // k is the vertical level index of the variable to get
 8174:    SIDE_BND(sideBnd);   
 8175: 
 8176:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8177:    if (sideBnd->segment->isLand) idx = -7;
 8178: 
 8179:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8180:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8181: 
 8182: }
