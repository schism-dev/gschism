10038: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
10039:    // Get the value of a variable from an side
10040:    // varName is the name of the variable to get
10041:    // var is the array to store the value
10042:    // k is the vertical level index of the variable to get
10043:    SIDE_BND(sideBnd);   
10044: 
10045:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
10046:    if (sideBnd->segment->isLand) idx = -7;
10047: 
10048:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
10049:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
10050: 
10051: }
