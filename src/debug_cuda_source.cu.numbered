 6513: __global__ void printMatrix(void) {
 6514: 
 6515: 
 6516:    // Let only one thread per block print at a time 
 6517: 
 6518:    if (threadIdx.x == 0) {
 6519:       for (int ithread = 0; ithread < blockDim.x; ithread++) {
 6520:          const int idx_node = ithread + blockIdx.x * blockDim.x;
 6521:          if (idx_node >= mesh->np) return;
 6522:          const Node *node = mesh->localNodeData + idx_node;
 6523:          printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 6524:          for (int j = 0; j < node->numNodes; j++) {
 6525:             Node* nbNode = node->nodes[j];
 6526:             if (node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 6527:          }
 6528:          printf("]\n");
 6529: 
 6530:       }
 6531:    }
 6532: 
 6533: 
 6534: 
 6535: }
