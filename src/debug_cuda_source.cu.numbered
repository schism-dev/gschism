 1744: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o') {
 1745: // return;   
 1746:    // Lock the mutex
 1747:    lock(&debugPlotMutex);
 1748:  
 1749:    bool ok = true;
 1750:    if (debugPlotIdx == nullptr) ok = false;
 1751:    if (*debugPlotIdx >= 10000) ok = false;
 1752:    if (ok) {
 1753:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1754:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1755:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1756:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1757:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1758:       debugPlot[(*debugPlotIdx) + 5*10000] = (double)marker;
 1759:       (*debugPlotIdx)++;
 1760:    }
 1761: 
 1762:    __threadfence();               // ensure all above writes are visible
 1763:    // Unlock the mutex
 1764:    unlock(&debugPlotMutex);
 1765: 
 1766: }
