  175: 
  176: __device__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
  177:     return make_double2(a.x + b.x, a.y + b.y);
  178: }
  179: 
  180: __device__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
  181:     a.x += b.x;
  182:     a.y += b.y;
  183:     return a;
  184: }
  185: 
  186: __device__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
  187:     return make_double2(a.x - b.x, a.y - b.y);
  188: }
  189: 
  190: __device__ __forceinline__ double2 operator-=(double2& a, const double2& b) {
  191:     a.x -= b.x;
  192:     a.y -= b.y;
  193:     return a;
  194: }
  195: 
  196: __device__ __forceinline__ double2 operator*(const double2& v, const double s) {
  197:     return make_double2(v.x * s, v.y * s);
  198: }
  199: 
  200: __device__ __forceinline__ double2 operator*(const double s, const double2& v) {
  201:     return v * s;  // reuse the previous operator
  202: }
  203: 
  204: __device__ __forceinline__ double2 operator/(const double2& v, double s) {
  205:     return make_double2(v.x / s, v.y / s);
  206: }
  207: 
  208: __device__ __forceinline__ double norm2(const double2& v) {
  209:     return v.x*v.x + v.y*v.y;
  210: }
  211: 
  212: __device__ __forceinline__ double length(const double2& v) {
  213:     return sqrt(v.x*v.x + v.y*v.y);
  214: }
  215: 
  216: __device__ __forceinline__ double2 normalize(const double2& v) {
  217:     return v / length(v);
  218: }
  219: 
  220: __device__ __forceinline__ double dot(const double2& v, const double2& w) {
  221:     return v.x*w.x + v.y*w.y;
  222: }
  223: 
  224: __device__ __forceinline__ double cross(const double2& v, const double2& w) {
  225:     return v.x*w.y - v.y*w.x;
  226: }
  227: 
  228: __device__ __forceinline__ double2 rot90(const double2& a) {
  229:     return make_double2(a.y, -a.x);
  230: }
  231: 
  232: __device__ __forceinline__ double3 operator+(const double3& a, const double3& b) {
  233:     return make_double3(a.x + b.x, a.y + b.y, a.z + b.z);
  234: }
  235: 
  236: __device__ __forceinline__ double3 operator+=(double3& a, const double3& b) {
  237:     a.x += b.x;
  238:     a.y += b.y;
  239:     a.z += b.z;
  240:     return a;
  241: }
  242: 
  243: __device__ __forceinline__ double3 operator-(const double3& a, const double3& b) {
  244:     return make_double3(a.x - b.x, a.y - b.y, a.z - b.z);
  245: }
  246: 
  247: __device__ __forceinline__ double3 operator*(const double3& v, double s) {
  248:     return make_double3(v.x * s, v.y * s, v.z * s);
  249: }
  250: 
  251: __device__ __forceinline__ double3 operator*(double s, const double3& v) {
  252:     return v * s;
  253: }
  254: 
  255: __device__ __forceinline__ double3 operator/(const double3& v, double s) {
  256:     return make_double3(v.x / s, v.y / s, v.z / s);
  257: }
  258: 
  259: __device__ __forceinline__ double dot(const double3& v, const double3& w) {
  260:     return v.x*w.x + v.y*w.y + v.z*w.z;
  261: }
  262: 
  263: __device__ __forceinline__ double norm2(const double3& v) {
  264:     return v.x*v.x + v.y*v.y + v.z*v.z;
