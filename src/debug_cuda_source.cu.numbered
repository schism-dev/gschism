 1090: struct Side {
 1091: 
 1092:    // Geometry information
 1093:    int idx;               // Index of the side
 1094:    Node *n1, *n2;
 1095:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
 1096: 
 1097:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
 1098:    Vector2 center;        // Location of side center. 
 1099:    double zc[nvrt];       // Side center z-coord at each vertical level
 1100: 
 1101:    #ifdef USE_FRAMES
 1102:    Frame frame;
 1103:    #endif
 1104: 
 1105:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
 1106:                           // this is nullptr
 1107:    
 1108:    int kb;                // Bottom index of the side
 1109:    bool isDry;            // True if the side is dry
 1110:  
 1111:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1112: 
 1113:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1114: 
 1115:    // Physical information
 1116:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1117:    Vector2 btu[nvrt];           // Back-tracked velocity
 1118:    Vector2 U;                   // Vertically averaged velocity vector  
 1119: 
 1120:    Vector2 nuGradU[nvrt];          // nu*grad u
 1121: 
 1122:    Vector2 bcc[nvrt];           // Baroclinic term
 1123:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1124: 
 1125:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1126:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1127:    Vector2 gradPr;               // Gradient of pressure
 1128:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1129: 
 1130: 
 1131:    double hhat;                 // \breve{H} in notes
 1132: 
 1133:    double shapiro;
 1134: 
 1135:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1136: 
 1137:    double coriolis;             // Coriolis parameter
 1138: 
 1139:    // Vegetation parameters
 1140:    double veg_c2;
 1141:    double veg_beta;
 1142: 
 1143:    // Bottom drag parameters.
 1144:    double chi;
 1145:    double chi2;
 1146: 
 1147:    __inline__ __device__ Point2 outputCoords(void) const;
 1148: 
 1149:    __inline__ __device__ double x(double t) const;
 1150:    __inline__ __device__ double y(double t) const;
 1151:    __inline__ __device__ double z(double t) const;
 1152:    __inline__ __device__ double lon(void) const;
 1153:    __inline__ __device__ double lat(void) const;
 1154:    __inline__ __device__ Point2 p2_t(double t) const;
 1155: 
 1156:    #ifdef USE_FRAMES
 1157:    __device__ void setFrame(void) {
 1158:       double lat, lon;
 1159:       const Point3 p = toPoint3(center, centerZ());
 1160: 
 1161:       // Compute the latitude and longitude of the element center
 1162:       computeLatLon(p, lat, lon);
 1163: 
 1164:       frame.update(lat, lon);        
 1165:    }
 1166:    #endif
 1167: 
 1168:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1169:    // If ics == 2, convert the global point to the local frame of the side
 1170:       
 1171:       if constexpr (ics == 1) {
 1172:          return p;
 1173:       } else {
 1174:          const Point3 c = {center.x, center.y, centerZ()};
 1175:          const Point3 local = frame.G2L(p - c);
 1176:          return local;
 1177:       }
 1178:    }
 1179: 
 1180: 
 1181:    __device__ __forceinline__ Vector2 projectToLocalFrame(Vector2 const& v, Frame const& v_frame) const {
 1182:       if constexpr(ics == 1) return v;
 1183:       else return v_frame.projHorVec(v, frame);
 1184:    }
 1185: 
 1186:    __inline__ __device__ double centerZ(void)      const;
 1187:    __inline__ __device__ Point3 center3D(int k)    const { assert(false); assert(k < nvrt); return {center.x, center.y, zc[k]}; }  // USED??? CONSISTENT?? XXXXX
 1188:    __inline__ __device__ double Dz(int k)          const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1189:    __inline__ __device__ double area(int k)        const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1190:    __inline__ __device__ double areaClamped(int k) const { assert(k < nvrt - 1); return len*(zc[max(k + 1, kb)] - zc[max(k, kb)]); }
 1191: 
 1192:    __inline__ __device__ Side* neigh(int index) const { 
 1193:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1194:       assert(index >= 0 && index < 4); 
 1195:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1196: 
 1197:       const int ielem = index & 1;           // 0 or 1
 1198:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1199: 
 1200:       const Element* elem = elems[ielem];
 1201: 
 1202:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1203: 
 1204:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1205: 
 1206:    }
 1207: 
 1208:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1209: 
 1210:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1211: 
 1212:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1213:    __inline__ __device__ bool isOpenBnd(void) const { return isBnd() && sideBnd->segment->ifltype == 0; } // True if the side is an open boundary side
 1214:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1215:    __inline__ __device__ int iadv(void) const;
 1216: 
 1217:    __inline__ __device__ double grav3(void) const;
 1218:    
 1219:    __inline__ __device__ double eta2(void) const;
 1220:    __inline__ __device__ double eta1(void) const;
 1221:    __inline__ __device__ double w2(int k) const;
 1222:    __inline__ __device__ Vector2 u2Bottom(int dummy = 0) const { return u2[kb]; }  // XXXX dummy argument to satisfy the template in mean()
 1223:    __inline__ __device__ double depth(void) const;
 1224:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1225:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1226: 
 1227:    __inline__ __device__ double dfv(int k) const;
 1228: 
 1229:    __inline__ __device__ double veg_h(void)  const;
 1230:    __inline__ __device__ double veg_nv(void) const;
 1231:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1232:    __inline__ __device__ double veg_alpha3D(int k) const;
 1233:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1234: 
 1235:    __inline__ __device__ double Cd(void) const;
 1236: 
 1237:    __inline__ __device__ Vector2 tau(void) const;
 1238: 
 1239:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1240:    
 1241: 
 1242:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1243:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1244:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1245:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1246:    } 
 1247:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1248:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1249:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1250:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1251: 
 1252:    // Get valid starting element (for backtracking)
 1253:    __inline__ __device__ Element* getStartElement() {
 1254:       return elems[0] ? elems[0] : elems[1];
 1255:    }
 1256: 
 1257:    
 1258:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1259:       // Given an element, returns the other element that shares this side
 1260:       return (elems[0] == elem) ? elems[1] : elems[0];
 1261:    }
 1262: 
 1263:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1264:       // Given a node, returns the other node that shares this side
 1265:       return (n1 == node) ? n2 : n1;
 1266:    }
 1267:  
 1268:    __inline__ __device__ void btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1269: 
 1270: 
 1271: 
 1272: 
 1273: };
