 1612:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1613:       // Compute the different time ramps used in the code 
 1614:       // This function is performed by just one thread
 1615: 
 1616:       rampbc = 1.0;
 1617:       if constexpr(ibc == 0) {
 1618:          if (drampbc > 0.0) {
 1619:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1620:          } else {
 1621:             rampbc = 1.0;
 1622:          }
 1623:       }
 1624: 
 1625:       if (nws != 0) {
 1626:          if (drampwind > 0.0) {
 1627:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1628:          } else {
 1629:             rampwind = 1.0;
 1630:          }
 1631:       }
 1632: 
 1633:       if (drampwafo > 0.0) {
 1634:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1635:       } else {
 1636:          rampwafo = 1.0;
 1637:       }
 1638: 
 1639:       // For source/sinks
 1640:       if (if_source && dramp_ss > 0.0) {
 1641:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1642:       } else {
 1643:          ramp_ss = 1.0;
 1644:       }
 1645: 
 1646:       if (dramp > 0.0) {
 1647:          ramp = tanh(2.0*time/86400.0/dramp);
 1648:       } else {
 1649:          ramp = 1.0;
 1650:       }
 1651: 
 1652: 
 1653:    }
