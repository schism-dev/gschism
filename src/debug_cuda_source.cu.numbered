 3728:    __global__ void computeElevationBoundaryConditions(double time) {
 3729:       // Compute elevation essential boundary conditions 
 3730: 
 3731:       NODE_BND(nodeBnd); // Each boundary node.
 3732: 
 3733:       const Node *node = nodeBnd->node;
 3734:       const int iettype = nodeBnd->iettype;
 3735: 
 3736:       double eic = 0.0;
 3737:       if (nramp_elev==1) eic = nodeBnd->etaic;
 3738:       else               eic = 0.0;
 3739: 
 3740:       const double r_eic = (1.0 - ramp)*eic; 
 3741:       const double r_eth = ramp*nodeBnd->eth;
 3742:       double eta1_bar = r_eic;
 3743: 
 3744: printf("++++>> node[%d]->iettype = %d\n", node->idx, iettype);
 3745:       // Compute tide elevation
 3746:       if (iettype == 3 || iettype == 5) {   
 3747: 
 3748:          if constexpr(iloadtide==1) { // loading tide
 3749:             assert(false && "Loading tide not implemented");
 3750:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3751:          }
 3752:          
 3753:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 3754: 
 3755:             const double efa  = nodeBnd->efa[jfr]; 
 3756:             const double emo  = nodeBnd->emo[jfr]; 
 3757: 
 3758:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 3759:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 3760:             eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 3761: 
 3762:  printf("++++>> jfr = %d, time = %f, ramp = %f, node->idx = %d, amig = %f, face = %f, ff = %f, efa = %f, emo = %f, arg = %f, eta1_bar = %f\n", jfr, time, ramp, node->idx, amig[jfr], face[jfr], ff[jfr], efa, emo, arg, eta1_bar);            
 3763:          } // for jfr
 3764: 
 3765:       } // if iettype
 3766: 
 3767:       switch (iettype) {
 3768:          case 1:
 3769:          case 2:
 3770:             nodeBnd->elbc = r_eth + r_eic;
 3771:             break;
 3772:          case 3:
 3773:             nodeBnd->elbc = eta1_bar + r_eic;
 3774:             break;
 3775:          case 4:
 3776:             nodeBnd->elbc = r_eth + r_eic;
 3777:             break;
 3778:          case 5:
 3779:             nodeBnd->elbc = r_eth + eta1_bar + r_eic;
 3780:             break;
 3781:       } // switch
 3782: 
 3783: 
 3784:       //Add inverse barometric effects
 3785:       if (iettype != 0 && inv_atm_bnd == 1) {
 3786:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 3787:       }
 3788: printf("++++>> nodeBnd->elbc = %f\n", nodeBnd->elbc);
 3789:    }
 3790: 
 3791: 
 3792:    __global__ void setEssentialBC(void) {
 3793:       // Set essential boundary conditions 
 3794:       NODE(node); // Each boundary node
 3795:       NodeBoundary *nodeBnd = node->nodeBnd;
 3796: printf("node idx = %d, nodeBnd = %p, essentialBC = %d\n", node->idx, nodeBnd, nodeBnd ? nodeBnd->isEssentialBC : -1);
 3797:       
 3798: // nodeBnd->isEssentialBC = true;      
 3799:       // Check if this node has essential BC
 3800:       if (nodeBnd && nodeBnd->isEssentialBC) {
 3801:          // Verify BC value is valid
 3802:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 3803: 
 3804:          printf("XX node IDX = %d, nodeBnd->isEssentialBC = %d\n", node->idx, nodeBnd->isEssentialBC);
 3805:          
 3806:          // Set diagonal to 1 and zero off-diagonals
 3807:          node->coeffDiag = 1.0;
 3808:          printf("ZZZZZZZ node->coeffDiag = %16.9f\n", node->coeffDiag);
 3809: 
 3810:          for (int j = 0; j < node->numNodes; j++) {
 3811:                node->coeffMatrix[j] = 0.0;
 3812:                printf("YY node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 3813:          }
 3814:          
 3815:          // Set solution and RHS to BC value
 3816:          node->mX  = nodeBnd->elbc;
 3817:          node->qel = nodeBnd->elbc;
 3818: printf("{{{{ node->mX = %f, node->qel = %f\n", node->mX, node->qel);         
 3819:       } else {
 3820:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 3821: 
 3822:          for (int j = 0; j < node->numNodes; j++) {
 3823:                Node* nbNode = node->nodes[j];
 3824:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 3825:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 3826:                   // Verify neighbor's BC value
 3827:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 3828: 
 3829:                   // Subtract contribution to RHS
 3830:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 3831:                   node->coeffMatrix[j] = 0.0;  
 3832:                   printf("ZZ node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 3833:                }
 3834:          }
 3835:       }
 3836:    }
 3837: 
 3838: 
 3839:    __global__ void updateElevation(void) {
 3840:       NODE(node);
 3841: 
 3842:       node->eta2 = node->mX;
 3843: printf("node[%d]->eta2 = %f, qel = %f\n", node->idx, node->eta2, node->qel);
 3844:    }
 3845: 
