 1742: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o') {
 1743: // return;   
 1744:    // Lock the mutex
 1745:    lock(&debugPlotMutex);
 1746:  
 1747:    bool ok = true;
 1748:    if (debugPlotIdx == nullptr) ok = false;
 1749:    if (*debugPlotIdx >= 10000) ok = false;
 1750:    if (ok) {
 1751:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1752:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1753:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1754:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1755:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1756:       debugPlot[(*debugPlotIdx) + 5*10000] = (double)marker;
 1757:       (*debugPlotIdx)++;
 1758:    }
 1759: 
 1760:    __threadfence();               // ensure all above writes are visible
 1761:    // Unlock the mutex
 1762:    unlock(&debugPlotMutex);
 1763: 
 1764: }
