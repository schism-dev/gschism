  684: struct Element {
  685: 
  686:    // Geometry information
  687:    int idx;                   // Index of the element
  688:    int i34;                   // Number of sides for the element 
  689:    Side *sides[4];            // Sides of the element
  690:    Node *nodes[4];            // Nodes of the element
  691:    Element *nghbElems[4];     // Neighbors of the element
  692: 
  693:    int kb;                    // Bottom index of the element
  694:    double area;               // Area of the element
  695:    double ssign[4];           // Sign associated with each side of an element
  696:    double radius;             // Element equivalent radii
  697: 
  698:    #ifdef USE_FRAMES
  699:    Frame frame;
  700:    #endif
  701: 
  702:    Vector2 gradPhi[4];        // Derivatives of shape functions
  703:    Vector2 gradEta;           // Gradient of free surface elevation
  704:    Vector2 gradPr;            // Gradient of pressure    
  705:    Vector2 gradETP;           // Gradient of Earth Tidal Potential    XXXXX Really used?
  706: 
  707:    bool isDry;                // True if the element is dry
  708: 
  709:    Point2 center;            // Element center coordinates (global coordinates)
  710: 
  711:    double depth;              // Depth at element (min of all nodes)
  712:    double z[nvrt];            // z-coord  (local frame - vertical up)
  713: 
  714:    // Physical information
  715:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  716: 
  717:    static const bool isblock = false;              // Always false
  718: 
  719:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  720:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  721: 
  722:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  723:    
  724: 
  725:    double vsource;            // Volumetric source/sink term [m^3/s]
  726: 
  727:    double rho[nvrt];          // Density at each prism center
  728:    double rho_mean[nvrt];     // Mean density at each prism center
  729:    CubicSpline rho_spl;
  730:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  731:    double rho_z[nvrt];        // First derivative of density at each prism center
  732:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  733:    
  734: 
  735:    __inline__ __device__ Point2 outputCoords(void) const;
  736: 
  737:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }  
  738: 
  739:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
  740:    // If ics == 2, convert the global point to the local frame of the element
  741:       
  742:       if constexpr (ics == 1) {
  743:          return p;
  744:       } else {
  745:          const Point3 c = {center.x, center.y, centerZ()};
  746:          return frame.G2L(p - c);
  747:       }
  748:    }
  749: 
  750:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  751:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  752: 
  753:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  754:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  755: 
  756:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  757:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  758:       // Find the local index of the node in the element (0,1,2,3)
  759:       int res = __ffs((nodes[0] == node) | 
  760:                      ((nodes[1] == node) << 1) | 
  761:                      ((nodes[2] == node) << 2) | 
  762:                      ((nodes[3] == node) << 3)) - 1;
  763:       
  764:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  765:       return res;  
  766:    }
  767: 
  768:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  769:       // Find the local index of the side in the element (0,1,2,3)
  770:       int res = __ffs((sides[0] == side) | 
  771:                      ((sides[1] == side) << 1) | 
  772:                      ((sides[2] == side) << 2) | 
  773:                      ((sides[3] == side) << 3)) - 1;
  774:       
  775:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  776:       return res;
  777:    }
  778: 
  779:    __inline__ __device__ int findLevel(double z1, int k) const {
  780:       // Starting at index k, find sequentially the level that contains z
  781: 
  782:       // For testing purposes, forgets k and performs a full search.
  783:       for (k = kb; k < nvrt - 1; k++) {
  784:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
  785:       }
  786:       return nvrt - 2;
  787: 
  788: 
  789:       // if z is already betweeen z[k] and z[k+1], return k
  790:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
  791:       else if (z1 <  z[k]) { 
  792:          // Search for increasing levels
  793:          for (int kk = k; kk < nvrt - 1; kk++) {
  794:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  795:          }
  796:          return nvrt - 1;
  797:       }
  798:       else {
  799:          // Search for decreasing levels
  800:          for (int kk = k; kk >= kb; kk--) {
  801:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  802:          }
  803:          return 0;
  804:       }
  805:    }
  806: 
  807:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
  808:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
  809: 
  810: 
  811:    __device__ __forceinline__ double centerZ(void) const;
  812: 
  813:    // "Local" horizontal coordinates at the nodes. They are computed from the 3D global node coordinates. For ics == 1 and 2
  814:    // Local is in quotes because for ics == 1, the coordinates are unchanged. It just means that in these coordinates, the element is horizontal.
  815:    __device__ __forceinline__ Point2 getLocalHorizontalNodePosition(int idxNode) const;
  816:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2, int idx = 0) const;
  817:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const;
  818: 
  819: 
  820:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idxNode = 0,1,2,3)
  821:    __device__ __forceinline__ Point2 GaussPoint(int idxNode) const {
  822:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
  823:        assert(idxNode >= 0 && idxNode < 4 && "GaussPoint: idxNode out of range");
  824:        const double eta = (idxNode & 1) ? +g : -g;
  825:        const double xi  = (idxNode & 2) ? +g : -g;
  826:        return {eta, xi};
  827:    }  
  828: 
  829:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  830:    __device__ __forceinline__ double etaSign(int idxNode) const {
  831:       // bit1: 0 -> -1, 1 -> +1
  832:       assert(idxNode >= 0 && idxNode < 4 && "etaSign: idxNode out of range");
  833:       return (idxNode & 2) ? 1.0 : -1.0;     // [-1,-1,+1,+1]
  834:    }
  835: 
  836:    __device__ __forceinline__ double xiSign(int idxNode) const {
  837:       // +1 if (bit0 XOR bit1), else -1
  838:       assert(idxNode >= 0 && idxNode < 4 && "xiSign: idxNode out of range");
  839:       return ((idxNode & 1) ^ (idxNode >> 1)) ? 1.0 : -1.0;   // [-1,+1,+1,-1]
  840: 
  841:    }
  842: 
  843:    // Shape function Phi at a given point p = (eta,xi), idxNode = node index 0,1,2,3
  844:    __device__ __forceinline__ double Phi(int idxNode, Point2 p) const {
  845:       return 0.25*(1.0 + p.x*etaSign(idxNode))*(1.0 + p.y*xiSign(idxNode));
  846:    }
  847: 
  848:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi)
  849:    __device__ __forceinline__ double dPhi_dxi(int idxNode, Point2 p) const {
  850:       return 0.25*xiSign(idxNode)*(1.0 + p.x*etaSign(idxNode));
  851:    }   
  852: 
  853:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
  854:    __device__ __forceinline__ double dPhi_deta(int idxNode, Point2 p) const {
  855:       return 0.25*(1.0 + p.y*xiSign(idxNode))*etaSign(idxNode);
  856:    }      
  857:    
  858:    __inline__ __device__ double detJ_eta(void) const;
  859: 
  860:    __inline__ __device__ double detJ_xi(void) const;
  861: 
  862:    __inline__ __device__ double jacobianDet(Point2 p) const { return area/4.0 + detJ_eta()*p.x + detJ_xi()*p.y; }
  863: 
  864:    // Check if the element is dry using the more up-to-date elevation.
  865:    __inline__ __device__ bool isDry2(void) const;
  866: 
  867:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  868: 
  869:    __device__ bool inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const;
  870: 
  871:    __inline__ __device__ double computeSignedArea(void) const;
  872: 
  873: 
  874:    enum EFixIf { fiNo, fiOnlyInside, fiAnywhere };
  875: 
  876:    __device__ bool computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegShapeCoords = fiNo, const Side *origSide = nullptr) const;
  877:    
  878:    __device__ void shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const;
  879: 
  880:    __device__ double intPhiPhiQuad(int i1, int i2) const;
  881: 
  882:    __device__ double intGradPhiGradPhiQuad(int i1, int i2) const;
  883: 
  884:    __device__ Vector2 grad2(double *a) const
  885:    {
  886:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  887:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  888:       if (isQuad()) {
  889:          gx += a[3]*gradPhi[3].x;
  890:          gy += a[3]*gradPhi[3].y;
  891:       }
  892:       return {gx, gy};
  893:    }
  894: 
  895:    __device__ Vector2 grad2(double Node::* field) const
  896:    {
  897:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  898:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  899:       if (isQuad()) {
  900:          gx += (nodes[3]->*field)*gradPhi[3].x;
  901:          gy += (nodes[3]->*field)*gradPhi[3].y;
  902:       }
  903:       return {gx, gy};
  904:    }
