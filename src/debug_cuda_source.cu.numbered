 2764: 
 2765: __device__ void Node::updateKb(void) {
 2766: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2767: 
 2768:    if constexpr(ivcor == 1) return;
 2769: 
 2770: 
 2771:    if (isDry2()) return;
 2772: 
 2773:    if constexpr(ivcor == 2) {  // SZ coordinates
 2774:       
 2775:       // Compute bottom level index
 2776:       if (depth <= mesh->h_s) {
 2777:          kb = izlev;
 2778:          
 2779:       } else {
 2780:          kb = -1;
 2781:          int L = 0;
 2782:          int R = nzlev; 
 2783:          
 2784:          while (L <= R) {
 2785:             int M = (R + L) / 2;
 2786: 
 2787: // printf("L = %d, R = %d, M = %d, depth = %f, ztot[L] = %f, ztot[R] = %f, ztot[M] = %f\n", L, R, M, depth, mesh->ztot[L], mesh->ztot[R], mesh->ztot[M]);
 2788:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2789:             
 2790:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2791:                R = M;
 2792:             } else {
 2793:                L = M;
 2794:             }
 2795: 
 2796:             if (R - L == 1) {
 2797:                kb = L;
 2798:                break;
 2799:             }
 2800:          }
 2801:       }
 2802:    } 
 2803: }
 2804: 
 2805: 
 2806: __device__ __inline__ void Node::updateZCoordData(void) {
 2807: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2808: 
 2809:    if (isDry2()) return;
 2810: 
 2811:    if constexpr(ivcor == 2) {  // SZ coordinates
 2812:       
 2813:       // Compute bottom level index
 2814:       if (depth <= mesh->h_s) {
 2815:             kb = nzlev - 1;
 2816:       } else {
 2817:          kb = -1;
 2818:          for (int i = 0; i < nzlev; i++) {
 2819:             // XXX Use binary search
 2820:             if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 2821:                kb = i;
 2822:                break;
 2823:             }
 2824:          }
 2825:       }
 2826:    } 
 2827:    else if (ivcor == 1) {  // Localized sigma
 2828:       // Do nothing
 2829:    }
 2830: 
 2831: }
 2832: 
 2833: __device__ double Node::compZCoord(int k) const {
 2834:    // Computes the z coordinate at level k.
 2835:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2836:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2837:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2838:    // used 
 2839:    
 2840:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2841: 
 2842:   
 2843:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2844: 
 2845:    if constexpr(ivcor == 2) {
 2846: 
 2847:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2848:       const double h_c = mesh->h_c;
 2849:       const double theta_f = mesh->theta_f;
 2850:       const double sinh_theta_f = mesh->sinh_theta_f;
 2851: 
 2852:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2853:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2854:       // once per time step/node.
 2855:       // CHECK: updateZCoordData
 2856: 
 2857:       //  To simplify comparisons, I define index versions of count variables.
 2858:       if      (k == ivrt)           return eta2; 
 2859:       else if (k == izlev)          return -hmod2;
 2860:       else if (k == kb)             return -depth;
 2861:       else if (k < izlev && k >= 0) return mesh->ztot[k];
 2862:       else if (k > izlev) {
 2863:          const int ksig = k - izlev;
 2864: 
 2865:          if (hmod2 <= h_c) {
 2866: // printf("mesh->sigma[ksig] * (hmod2 + eta2) + eta2 = %e\n", mesh->sigma[ksig] * (hmod2 + eta2) + eta2);            
 2867:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2868:          } 
 2869:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2870:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2871:             assert(false && "ZCOOR: invalid h_c\n");
 2872:          } 
 2873:          else {
 2874: // printf("eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig] = %e\n", eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig]);
 2875:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2876:                          h_c * mesh->sigma[ksig] + 
 2877:                          (hmod2 - h_c) * mesh->cs[ksig];
 2878:          }
 2879:       } else { 
 2880:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2881:       }
 2882: 
 2883:    }
 2884:    else if constexpr(ivcor == 1) {
 2885:       if (k == kb) return -depth;
 2886:       else if (k == nvrt-1) return eta2;
 2887:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2888:    }
 2889:    
 2890:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2891:    return 0.0;
 2892: }
 2893: 
 2894: 
 2895: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2896:    // Checks if a side in on the boundary
 2897:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2898: 
 2899:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2900:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2901: 
 2902:    // Indices of the nodes that form the side
 2903:    const int n1 = side.n1->idx;
 2904:    const int n2 = side.n2->idx;
 2905:    isLand = false;
 2906:    
 2907: if (n1 == 10) printf("nland = %d, nope = %d, ilnd[0] = %d, ilnd[1*nland] = %d, ilnd[2*nland] = %d, ilnd[3*nland] = %d\n", nland, nope, ilnd[0], ilnd[1*nland], ilnd[2*nland], ilnd[3*nland]);
 2908:    // Check if the side is on a land boundary
 2909:    for (int i = 0; i < nland; i++) {
 2910:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2911:          // Consecutive nodes in the land boundary segment
 2912:          const int b1 = ilnd[i + j*nland];
 2913:          const int b2 = ilnd[i + (j + 1)*nland];
 2914: 
 2915:          assert(b1 != -1 && b2 != -1);
 2916: 
 2917:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2918:             
 2919:             isLand = true;
 2920:             return i;
 2921:          }
 2922:       }
 2923:    }
 2924: 
 2925:    // Check if the side is on an open boundary
 2926:    for (int i = 0; i < nope; i++) {
 2927:       for (int j = 0; j < nond[i] - 1; j++) {
 2928:          // Consecutive nodes in the open boundary segment
 2929:          const int b1 = iond[i + j*nope];
 2930:          const int b2 = iond[i + (j + 1)*nope];
 2931: 
 2932:          assert(b1 != -1 && b2 != -1);
 2933: 
 2934:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2935:             isLand = false;
 2936:             return i;
 2937:          }
 2938:       }
 2939:    }
 2940: printf("side.idx = %d, n1 = %d, n2 = %d\n", side.idx, n1, n2);             
 2941:    return -1;
 2942: }
 2943: 
 2944: 
 2945: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 2946:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 2947:                                     double *wind_rotate_angle, 
 2948:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2949:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2950:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2951:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 2952:                                     double *drag, double *roughness) {
 2953: 
 2954:    NODE(pnode);  
 2955:    const int i = idx_node;
 2956:    Node &node(*pnode);
 2957: 
 2958:    node.idx = i;
 2959: 
 2960:    const int idxNodeStart = nodeNeighNodesStart[i];
 2961:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2962:    node.numNodes = idxNodeEnd - idxNodeStart;
 2963:    node.nodes = nodeNeighNodes + idxNodeStart;
 2964:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2965: 
 2966: 
 2967: 
 2968:    const int idxElemStart = nodeNeighElemsStart[i];
 2969:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2970:    node.numElements = idxElemEnd - idxElemStart;
 2971:    node.elements = nodeNeighElems + idxElemStart;
 2972: 
 2973:    
 2974:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2975:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2976:       const int partNode = localNodePart[idxNodeGlobal]; 
 2977:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 2978: 
 2979:       Node *node_ptr = nodes[partNode] + idxNode;
 2980:       
 2981:       nodeNeighNodes[idx] = node_ptr;
 2982:    }
 2983: 
 2984: 
 2985:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2986:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2987:       const int partElem = localElemPart[idxElemGlobal];
 2988:       const int idxElem  = localElemIndices[idxElemGlobal];
 2989: 
 2990:       Element *elem_ptr = elems[partElem] + idxElem;
 2991: 
 2992:       nodeNeighElems[idx] = elem_ptr;
 2993:    }      
 2994: 
 2995: // printf("NODE i = %d, node = %p, node.numNodes = %d\n", node.idx, &node, node.numNodes);      
 2996: 
 2997:    node.wind_angle = wind_rotate_angle[i];
 2998: 
 2999: 
 3000:    node.p.x   = node_coords[i * 3];
 3001:    node.p.y   = node_coords[i * 3 + 1];
 3002:    node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 3003:    node.depth = node_coords[i * 3 + 2];
 3004: 
 3005:    node.numSides = 0;
 3006: 
 3007:    node.Cd = drag[i];
 3008:    node.rough = roughness[i];
 3009:    
 3010:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3011: 
 3012:    // Links the node to the boundary information
 3013:    if (isbnd[i] >= 0) {
 3014: 
 3015:      
 3016:       // Get the index of the node boundary
 3017:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3018: 
 3019:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3020:       node.nodeBnd->node = &node;
 3021: 
 3022:       node.nodeBnd->sideBnd1 = nullptr;
 3023:       node.nodeBnd->sideBnd2 = nullptr;
 3024: 
 3025:       if (isbnd[i]>=0) {
 3026: 
 3027:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3028:          
 3029:          node.nodeBnd->segment->ifltype = (isbnd[i]==0)?3:0;
 3030:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3031: 
 3032:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3033:          node.nodeBnd->segment->clen  = nan("1");
 3034:          node.nodeBnd->segment->carea = nan("1");
 3035: 
 3036:       }
 3037: //          else {  XXXXXX
 3038: //             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3039: // printf("EEEEEPP isbnd[i] = %d, node.nodeBnd->segment = %p\n", isbnd[i], node.nodeBnd->segment);            
 3040: //          }
 3041:       
 3042: 
 3043:    }
 3044:    else {
 3045: 
 3046:       node.nodeBnd = nullptr; // For internal nodes
 3047: 
 3048:       if (isbnd[i] == landSegment) {
 3049:          node.nodeBnd = &landBoundaryNode;
 3050:          node.nodeBnd->segment = &landBoundarySegment;
 3051:       }
 3052:       // node.nodeBnd->node = &node;
 3053:       // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3054:       // // node.nodeBnd = nullptr;
 3055:       // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3056:       
 3057:    }
 3058: 
 3059:    // XXXX GAUSSIAN HILL VELOCITIES
 3060: #ifdef GAUSSIAN_HILL_VELOCITIES
 3061:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3062:       constexpr double rot_per = 3000.0;
 3063:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3064:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3065:    // XXXXX
 3066: #endif
 3067: 
 3068: }
 3069: 
 3070: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3071:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3072:                                     double *wind_rotate_angle,   
 3073:                                     int *isdel, int *isidenode, int *isbnd,
 3074:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3075:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3076:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3077:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3078:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3079:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3080:                                     double *drag, double *roughness) {
 3081: 
 3082: 
 3083:    SIDE(pside);
 3084:    Side &side(*pside);
 3085:    const int i = idx_side;
 3086: 
 3087:    side.idx = i;  
 3088:    
 3089:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3090:    const double fc   = 2.0*omega_e*sin(sfea0);
 3091:    const double beta = 2.0*omega_e*cos(sfea0);
 3092: 
 3093:    // finding the pointer to the nodes that form the side
 3094:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3095:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3096: 
 3097:    const int locidx_n1 = localNodeIndices[idx_n1];
 3098:    const int locidx_n2 = localNodeIndices[idx_n2];
 3099:    const int part_n1 =   localNodePart[idx_n1];
 3100:    const int part_n2 =   localNodePart[idx_n2];
 3101: 
 3102:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3103:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3104: 
 3105:    // Counts the number of sides connected to each node
 3106:    side.n1->numSides++;
 3107:    side.n2->numSides++;
 3108: 
 3109:    // Normal, unitary vector to the side
 3110:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3111:    side.n = normalize(side.n);
 3112: 
 3113:    // Side boundary type
 3114:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3115:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3116: 
 3117:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3118:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3119:    {
 3120:       bool isLand = false;
 3121:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3122:       
 3123:       if (isbs > -1) {
 3124:          // assert(isLand || isbs>=0);
 3125:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3126: 
 3127:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3128:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3129:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3130: 
 3131:          assert (isLand == side.sideBnd->segment->isLand);
 3132: 
 3133:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3134:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3135:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3136: 
 3137:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3138:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3139:          
 3140:          side.sideBnd->side = &side;
 3141: 
 3142:       }
 3143:       else {
 3144:          side.sideBnd = nullptr;
 3145:       }
 3146:    }
 3147:    else 
 3148:    {
 3149:       side.sideBnd = nullptr;
 3150:    }
 3151: 
 3152: 
 3153:    // finding the pointer to the elements that share the side
 3154:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3155:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3156: 
 3157:    if (idx_e1 > -1) {
 3158:       const int locidx_e1 = localElemIndices[idx_e1];
 3159:       const int part_e1 =  localElemPart[idx_e1];
 3160:       side.elems[0] = elems[part_e1] + locidx_e1;
 3161: 
 3162:    }
 3163:    else {
 3164:       side.elems[0] = nullptr;
 3165:    }
 3166: 
 3167:    if (idx_e2 > -1) {
 3168:       const int locidx_e2 = localElemIndices[idx_e2];
 3169:       const int part_e2 =  localElemPart[idx_e2];
 3170:       side.elems[1] = elems[part_e2] + locidx_e2;
 3171:    }
 3172:    else {
 3173:       side.elems[1] = nullptr;
 3174:    }
 3175: 
 3176:    // Compute the center of the side
 3177:    side.center = 0.5*(side.n1->p2() + side.n2->p2());
 3178: 
 3179:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3180:    side.shapiro = shapiro0;
 3181: 
 3182: #ifdef GAUSSIAN_HILL_VELOCITIES
 3183: // XXXX
 3184: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3185: constexpr double rot_per=3000.0;
 3186: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3187: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3188: // XXXXX      
 3189: #endif
 3190:    // Compute the z level at the center of the side
 3191:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3192: 
 3193:    // Compute the length of the side
 3194:    const Vector2 vLen = side.n2->p2() - side.n1->p2();
 3195:    side.len = sqrt(dot(vLen, vLen));
 3196: 
 3197: 
 3198:    // Compute the Coriolis coefficient
 3199: 
 3200:    if constexpr(ncor == -1 || ncor == 0) {
 3201:       side.coriolis = coricoef;
 3202:    }
 3203:    else {
 3204:       const double sphi = side.lat();  // Latitude at the center of the side
 3205: 
 3206:       if constexpr(ics == 1) {
 3207:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3208:       }
 3209:       else {
 3210:          side.coriolis = 2.0*omega_e*sin(sphi);
 3211:       }
 3212:    }
 3213: }
 3214: 
 3215: 
 3216: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3217:    double *node_coords, double *node_coords_ll, bool use_ll,
 3218:    double *wind_rotate_angle,   
 3219:    int *isdel, int *isidenode, int *isbnd,
 3220:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3221:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3222:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3223:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3224:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3225:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3226:    double *drag, double *roughness) {
 3227: 
 3228:    ELEM(pelem);
 3229:    Element &elem(*pelem);
 3230:    const int i = idx_elem;
 3231:    
 3232:    elem.idx = i;
 3233: 
 3234:    for (int j = 0; j < i34[i]; j++) {
 3235:       const int idxNode = elnode[i*4 + j];  
 3236:       const int idxSide = elside[i*4 + j];
 3237:       
 3238:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3239:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3240: 
 3241: 
 3242:       // Find the neighboring element  
 3243:       if (elem.sides[j]->elems[0] == &elem) {
 3244:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3245:       }
 3246:       else {
 3247:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3248:       }
 3249:       
 3250:    }
 3251: 
 3252:    elem.i34 = i34[i];
 3253: 
 3254:    // Compute the centroid of the element and its depth
 3255:    Vector2 center = {0.0, 0.0};
 3256:    elem.depth = 0.0;
 3257:    for (int j = 0; j < i34[i]; j++) {
 3258:       center += elem.nodes[j]->p2()/i34[i];
 3259:       elem.depth  += elem.nodes[j]->p.z/i34[i];
 3260:    }
 3261:    elem.center = center;
 3262: 
 3263:    
 3264:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3265:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3266: 
 3267:    elem.area = elem.computeSignedArea(); 
 3268:    elem.radius = sqrt(elem.area)/pi; 
 3269:    
 3270:    // Determines which way the normal vector to each side is oriented.
 3271:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3272:    for (int j = 0; j < i34[i]; j++)  
 3273:    {
 3274:       if (elem.sides[j]->elems[0] == &elem) {
 3275:          elem.ssign[j] =  1.0;
 3276:       }
 3277:       else {
 3278:          elem.ssign[j] = -1.0;
 3279:       }
 3280: 
 3281:    }
 3282: 
 3283:    // Derivatives of shape functions
 3284:    //  For ics=2, this is done inside element/ll frame XXX
 3285:    //  For quads, the derivative is evaluated at centroid
 3286:    for (int j = 0; j < elem.i34; j++) {
 3287:       const double area = elem.area;
 3288:       const int id2 = elem.nxq(1 + j);
 3289:       const int id3 = elem.nxq(2 + j);
 3290:       const int id4 = elem.nxq(3 + j);
 3291:       if (elem.isTri()) {
 3292:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3293:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3294:          // da1/dx = (y1 - y2)/(2*area)
 3295:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3296:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3297:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3298:       }
 3299:       else  { // Quad; evaluate at centroid
 3300:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3301:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3302:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3303:       } // if Tri
 3304: 
 3305:    } // for j   
 3306:    
 3307:    
 3308: 
 3309: }
 3310: 
 3311: __device__ void Mesh::populateBoundaryNodes(int *nond, 
 3312:                                             double *emo, double *efa, 
 3313:                                             double *umo, double *ufa, 
 3314:                                             double *vmo, double *vfa) {
 3315: 
 3316:    printf("mesh->nbp = %d, idx = %d\n", mesh->nbp, threadIdx.x + blockIdx.x * blockDim.x);                                             
 3317:    NODE_BND(nodeBnd);
 3318:    const int idx = idx_node_bnd;                                             
 3319: 
 3320:    // Need to compute the segment index and the index of the node on the segment
 3321:    int sumNodes = 0;
 3322:    int iseg;
 3323:    for (iseg = 0; iseg < nope; iseg++) {
 3324:       // for each segment...
 3325:       sumNodes += nond[iseg];
 3326:       if (idx > sumNodes) break;
 3327:    }
 3328:    if (iseg == nope) iseg--;
 3329:    assert(idx <= sumNodes && "idx is out of bounds");
 3330:    sumNodes -= nond[iseg];
 3331: 
 3332:    const int ind  = idx - sumNodes;
 3333: if (idx > 1000) printf("iseg = %d of %d, ind = %d of %d, idx = %d, mesh->nbp = %d\n", iseg, nope, ind, nond[iseg], idx, mesh->nbp);
 3334: 
 3335: 
 3336:    nodeBnd->isEssentialBC = true;
 3337:    nodeBnd->elbc = 0.0;
 3338: 
 3339:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3340: 
 3341:       const int idx = iseg*mnond*nbfr + ind*nbfr + jfr;
 3342:       nodeBnd->efa[jfr] = efa[idx];
 3343:       nodeBnd->emo[jfr] = emo[idx];
 3344:       nodeBnd->umo[jfr] = {umo[idx], vmo[idx]};
 3345:       nodeBnd->ufa[jfr] = {ufa[idx], vfa[idx]};
 3346: 
 3347:    }
 3348:         
 3349: 
 3350: }
 3351: 
