 2781: 
 2782: __device__ void Node::updateKb(void) {
 2783: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2784: 
 2785:    if constexpr(ivcor == 1) return;
 2786: 
 2787: 
 2788:    if (isDry2()) return;
 2789: 
 2790:    if constexpr(ivcor == 2) {  // SZ coordinates
 2791:       
 2792:       // Compute bottom level index
 2793:       if (depth <= mesh->h_s) {
 2794:          kb = izlev;
 2795:          
 2796:       } else {
 2797:          kb = -1;
 2798:          int L = 0;
 2799:          int R = nzlev; 
 2800:          
 2801:          while (L <= R) {
 2802:             int M = (R + L) / 2;
 2803: 
 2804: 
 2805:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2806:             
 2807:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2808:                R = M;
 2809:             } else {
 2810:                L = M;
 2811:             }
 2812: 
 2813:             if (R - L == 1) {
 2814:                kb = L;
 2815:                break;
 2816:             }
 2817:          }
 2818:       }
 2819:    } 
 2820: }
 2821: 
 2822: 
 2823: __device__ __inline__ void Node::updateZCoordData(void) {
 2824: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2825: 
 2826:    if (isDry2()) {
 2827:       kb = -1;
 2828:       return;
 2829:    }
 2830: 
 2831:    if constexpr(ivcor == 2) {  // SZ coordinates
 2832:       
 2833:       // Compute bottom level index
 2834:       if (depth <= mesh->h_s) {
 2835:             kb = izlev;
 2836: 
 2837:       } else {
 2838:          kb = -1;
 2839:          for (int i = 0; i < nzlev; i++) {
 2840:             // XXX Use binary search
 2841:             if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 2842:                kb = i;
 2843:                break;
 2844:             }
 2845:          }
 2846:       }
 2847:    } 
 2848:    else if (ivcor == 1) {  // Localized sigma
 2849:       // Do nothing
 2850:    }
 2851: 
 2852: }
 2853: 
 2854: 
 2855: __device__ double Node::compZCoord(int k) const {
 2856:    // Computes the z coordinate at level k.
 2857:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2858:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2859:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2860:    // used 
 2861:    
 2862:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2863: 
 2864:    if (isDry2()) return 0.0;
 2865: 
 2866:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2867: 
 2868:    if constexpr(ivcor == 2) {
 2869: 
 2870:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2871:       const double h_c = mesh->h_c;
 2872:       const double theta_f = mesh->theta_f;
 2873:       const double sinh_theta_f = mesh->sinh_theta_f;
 2874: 
 2875:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2876:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2877:       // once per time step/node.
 2878:       // CHECK: updateZCoordData
 2879: 
 2880:       //  To simplify comparisons, I define index versions of count variables.
 2881:       if      (k == ivrt)           return eta2; 
 2882:       else if (k == izlev)          return -hmod2;
 2883:       else if (k == kb)             return -depth;
 2884:       else if (k < izlev && k >= 0) return mesh->ztot[k];
 2885:       else if (k > izlev) {
 2886:          const int ksig = k - izlev;
 2887: 
 2888:          if (hmod2 <= h_c) {
 2889: 
 2890:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2891:          } 
 2892:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2893:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2894:             assert(false && "ZCOOR: invalid h_c\n");
 2895:          } 
 2896:          else {
 2897:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2898:                          h_c * mesh->sigma[ksig] + 
 2899:                          (hmod2 - h_c) * mesh->cs[ksig];
 2900:          }
 2901:       } else { 
 2902:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2903:       }
 2904: 
 2905:    }
 2906:    else if constexpr(ivcor == 1) {
 2907:       if (k == kb) return -depth;
 2908:       else if (k == nvrt-1) return eta2;
 2909:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2910:    }
 2911:    
 2912:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2913:    return 0.0;
 2914: }
 2915: 
 2916: 
 2917: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 2918:    // Computes the bottom drag Cd based on the selected nchi
 2919: 
 2920:    if constexpr(nchi == 0) {
 2921:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 2922:       Cd = drag;  // Read from drag file
 2923: 
 2924:    } else if constexpr(nchi == 1) {
 2925:       // 
 2926: 
 2927:       bool ltmp = false; // for WBL iteration
 2928: 
 2929:       assert(false && "computeBottomDragVegetation: nchi == 1 not fully implemented. see below");
 2930:       // Cdmax=-1 !max. Cd at node for this process (info only)
 2931:       // Drag at nodes
 2932: /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)   XXXXXXXXXXXX
 2933: // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 2934:            
 2935:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 2936:       if (rough == 0.0) {
 2937:          Cd = 0.0;
 2938: 
 2939:       } else { //roughness >0 
 2940:          
 2941:          const double bthick_ori = z[kb + 1] - z[kb];  // thickness of bottom bnd layer
 2942:          const double bthick = max(dzb_min, bthick_ori);
 2943: 
 2944:          assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 2945: 
 2946:          double tmp = 1.0/(2.5*log(bthick/rough));
 2947:          Cd = tmp*tmp;
 2948: 
 2949:       } // if rough
 2950: 
 2951: 
 2952:       // RECOVER THIS: XXX
 2953:       // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 2954:       // Output warning for WBL if iteration didn't converge
 2955: 
 2956: 
 2957:    } else if constexpr(nchi == -1) {
 2958:    // Manning 
 2959:       Cd = 0.0;
 2960: 
 2961:       if (isDry) return;
 2962: 
 2963:       const double htot = max(hmin_man, htot2()); 
 2964:       Cd = grav2*rmanning*rmanning/pow(htot, 0.333);
 2965: 
 2966:    } else {
 2967:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 2968:       
 2969:    } // if nchi
 2970: }
 2971: 
 2972: 
 2973: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2974:    // Checks if a side in on the boundary
 2975:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2976: 
 2977:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2978:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2979: 
 2980:    // Indices of the nodes that form the side
 2981:    const int n1 = side.n1->idx;
 2982:    const int n2 = side.n2->idx;
 2983:    isLand = false;
 2984:    
 2985: 
 2986:    // Check if the side is on a land boundary
 2987:    for (int i = 0; i < nland; i++) {
 2988:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2989:          // Consecutive nodes in the land boundary segment
 2990:          const int b1 = ilnd[i + j*nland];
 2991:          const int b2 = ilnd[i + (j + 1)*nland];
 2992: 
 2993:          assert(b1 != -1 && b2 != -1);
 2994: 
 2995:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2996:             
 2997:             isLand = true;
 2998:             return i;
 2999:          }
 3000:       }
 3001:    }
 3002: 
 3003:    // Check if the side is on an open boundary
 3004:    for (int i = 0; i < nope; i++) {
 3005:       for (int j = 0; j < nond[i] - 1; j++) {
 3006:          // Consecutive nodes in the open boundary segment
 3007:          const int b1 = iond[i + j*nope];
 3008:          const int b2 = iond[i + (j + 1)*nope];
 3009: 
 3010:          assert(b1 != -1 && b2 != -1);
 3011: 
 3012:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3013:             isLand = false;
 3014:             return i;
 3015:          }
 3016:       }
 3017:    }
 3018: 
 3019:    return -1;
 3020: }
 3021: 
 3022: 
 3023: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3024:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3025:                                     double *wind_rotate_angle, 
 3026:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3027:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3028:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3029:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3030:                                     double *drag, double *roughness, double *rmanning) {
 3031: 
 3032:    NODE(pnode);  
 3033:    const int i = idx_node;
 3034:    Node &node(*pnode);
 3035: 
 3036:    node.idx = i;
 3037: 
 3038:    const int idxNodeStart = nodeNeighNodesStart[i];
 3039:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3040:    node.numNodes = idxNodeEnd - idxNodeStart;
 3041:    node.nodes = nodeNeighNodes + idxNodeStart;
 3042:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3043: 
 3044: 
 3045: 
 3046:    const int idxElemStart = nodeNeighElemsStart[i];
 3047:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3048:    node.numElements = idxElemEnd - idxElemStart;
 3049:    node.elements = nodeNeighElems + idxElemStart;
 3050: 
 3051: 
 3052:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3053:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3054:       const int partNode = localNodePart[idxNodeGlobal]; 
 3055:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3056: 
 3057:       Node *node_ptr = nodes[partNode] + idxNode;
 3058:       
 3059:       nodeNeighNodes[idx] = node_ptr;
 3060:    }
 3061: 
 3062: 
 3063:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3064:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3065:       const int partElem = localElemPart[idxElemGlobal];
 3066:       const int idxElem  = localElemIndices[idxElemGlobal];
 3067: 
 3068:       Element *elem_ptr = elems[partElem] + idxElem;
 3069: 
 3070:       nodeNeighElems[idx] = elem_ptr;
 3071:    }      
 3072: 
 3073: // printf("NODE i = %d, node = %p, node.numNodes = %d\n", node.idx, &node, node.numNodes);      
 3074: 
 3075:    node.wind_angle = wind_rotate_angle[i];
 3076: 
 3077: 
 3078:    node.p.x   = node_coords[i * 3];
 3079:    node.p.y   = node_coords[i * 3 + 1];
 3080:    node.depth = node_coords[i * 3 + 2];
 3081: 
 3082:    if (use_ll) {
 3083:    node.lon = node_coords_ll[i * 2    ]*deg2rad;
 3084:    node.lat = node_coords_ll[i * 2 + 1]*deg2rad;
 3085:    }
 3086: 
 3087: 
 3088:    node.numSides = 0;
 3089: 
 3090:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3091:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3092:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3093:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3094:    else assert(false && "populateNodes: selected nchi not implemented.");
 3095:    
 3096:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3097: 
 3098:    
 3099:    // Links the node to the boundary information
 3100:    if (isbnd[i] >= 0) {
 3101: 
 3102:      
 3103:       // Get the index of the node boundary
 3104:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3105: 
 3106:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3107:       node.nodeBnd->node = &node;
 3108: 
 3109:       node.nodeBnd->sideBnd1 = nullptr;
 3110:       node.nodeBnd->sideBnd2 = nullptr;
 3111: 
 3112:       if (isbnd[i]>=0) {
 3113: 
 3114:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3115:          
 3116:          node.nodeBnd->segment->ifltype = (isbnd[i]==0)?3:0;
 3117:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3118: 
 3119:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3120:          node.nodeBnd->segment->clen  = nan("1");
 3121:          node.nodeBnd->segment->carea = nan("1");
 3122: 
 3123:       }
 3124: //          else {  XXXXXX
 3125: //             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3126: // printf("EEEEEPP isbnd[i] = %d, node.nodeBnd->segment = %p\n", isbnd[i], node.nodeBnd->segment);            
 3127: //          }
 3128:       
 3129: 
 3130:    }
 3131:    else {
 3132: 
 3133:       node.nodeBnd = nullptr; // For internal nodes
 3134: 
 3135:       if (isbnd[i] == landSegment) {
 3136:          node.nodeBnd = &landBoundaryNode;
 3137:          node.nodeBnd->segment = &landBoundarySegment;
 3138:       }
 3139:       // node.nodeBnd->node = &node;
 3140:       // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3141:       // // node.nodeBnd = nullptr;
 3142:       // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3143:       
 3144:    }
 3145:    
 3146:    // XXXX GAUSSIAN HILL VELOCITIES
 3147: #ifdef GAUSSIAN_HILL_VELOCITIES
 3148:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3149:       constexpr double rot_per = 3000.0;
 3150:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3151:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3152:    // XXXXX
 3153: #endif
 3154: 
 3155: }
 3156: 
 3157: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3158:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3159:                                     double *wind_rotate_angle,   
 3160:                                     int *isdel, int *isidenode, int *isbnd,
 3161:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3162:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3163:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3164:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3165:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3166:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3167:                                     double *drag, double *roughness) {
 3168: 
 3169: 
 3170:    SIDE(pside);
 3171:    Side &side(*pside);
 3172:    const int i = idx_side;
 3173: 
 3174:    side.idx = i;  
 3175:    
 3176:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3177:    const double fc   = 2.0*omega_e*sin(sfea0);
 3178:    const double beta = 2.0*omega_e*cos(sfea0);
 3179: 
 3180:    // finding the pointer to the nodes that form the side
 3181:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3182:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3183: 
 3184:    const int locidx_n1 = localNodeIndices[idx_n1];
 3185:    const int locidx_n2 = localNodeIndices[idx_n2];
 3186:    const int part_n1 =   localNodePart[idx_n1];
 3187:    const int part_n2 =   localNodePart[idx_n2];
 3188: 
 3189:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3190:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3191: 
 3192:    // Counts the number of sides connected to each node
 3193:    side.n1->numSides++;
 3194:    side.n2->numSides++;
 3195: 
 3196:    // Normal, unitary vector to the side
 3197:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3198:    side.n = normalize(side.n);
 3199: 
 3200:    // Side boundary type
 3201:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3202:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3203: 
 3204:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3205:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3206:    {
 3207:       bool isLand = false;
 3208:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3209:       
 3210:       if (isbs > -1) {
 3211:          // assert(isLand || isbs>=0);
 3212:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3213: 
 3214:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3215: 
 3216:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3217:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3218: 
 3219:          assert (isLand == side.sideBnd->segment->isLand);
 3220: 
 3221:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3222:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3223:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3224: 
 3225:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3226:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3227:          
 3228:          side.sideBnd->side = &side;
 3229: 
 3230:       }
 3231:       else {
 3232:          side.sideBnd = nullptr;
 3233:       }
 3234:    }
 3235:    else 
 3236:    {
 3237:       side.sideBnd = nullptr;
 3238:    }
 3239: 
 3240: 
 3241:    // finding the pointer to the elements that share the side
 3242:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3243:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3244: 
 3245:    if (idx_e1 > -1) {
 3246:       const int locidx_e1 = localElemIndices[idx_e1];
 3247:       const int part_e1 =  localElemPart[idx_e1];
 3248:       side.elems[0] = elems[part_e1] + locidx_e1;
 3249: 
 3250:    }
 3251:    else {
 3252:       side.elems[0] = nullptr;
 3253:    }
 3254: 
 3255:    if (idx_e2 > -1) {
 3256:       const int locidx_e2 = localElemIndices[idx_e2];
 3257:       const int part_e2 =  localElemPart[idx_e2];
 3258:       side.elems[1] = elems[part_e2] + locidx_e2;
 3259:    }
 3260:    else {
 3261:       side.elems[1] = nullptr;
 3262:    }
 3263: 
 3264:    // Compute the center of the side
 3265:    side.center = 0.5*(side.n1->p + side.n2->p);
 3266: 
 3267:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3268:    side.shapiro = shapiro0;
 3269: 
 3270: #ifdef GAUSSIAN_HILL_VELOCITIES
 3271: // XXXX
 3272: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3273: constexpr double rot_per=3000.0;
 3274: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3275: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3276: // XXXXX      
 3277: #endif
 3278:    // Compute the z level at the center of the side
 3279:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3280:    
 3281:    // Compute the length of the side
 3282:    const Vector2 vLen = side.n2->p - side.n1->p;
 3283:    side.len = sqrt(dot(vLen, vLen));
 3284: 
 3285: 
 3286:    // Compute the Coriolis coefficient
 3287: 
 3288:    if constexpr(ncor == -1 || ncor == 0) {
 3289:       side.coriolis = coricoef;
 3290:    }
 3291:    else {
 3292:       const double sphi = side.lat();  // Latitude at the center of the side
 3293: 
 3294: // XXXXXX ERROR WHEN use_ll is false??????
 3295:       if constexpr(ics == 1) {
 3296:          // XXXXXXX
 3297:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3298:       }
 3299:       else {
 3300:          side.coriolis = 2.0*omega_e*sin(sphi);
 3301:       }
 3302: 
 3303:    }
 3304: }
 3305: 
 3306: 
 3307: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3308:    double *node_coords, double *node_coords_ll, bool use_ll,
 3309:    double *wind_rotate_angle,   
 3310:    int *isdel, int *isidenode, int *isbnd,
 3311:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3312:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3313:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3314:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3315:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3316:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3317:    double *drag, double *roughness) {
 3318: 
 3319:    ELEM(pelem);
 3320:    Element &elem(*pelem);
 3321:    const int i = idx_elem;
 3322: 
 3323:    elem.idx = i;
 3324: 
 3325:    for (int j = 0; j < i34[i]; j++) {
 3326:       const int idxNode = elnode[i*4 + j];  
 3327:       const int idxSide = elside[i*4 + j];
 3328:       
 3329:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3330:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3331: 
 3332:       // Find the neighboring element  
 3333:       if (elem.sides[j]->elems[0] == &elem) {
 3334:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3335:       }
 3336:       else {
 3337:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3338:       }
 3339:       
 3340:    }
 3341: 
 3342:    elem.i34 = i34[i];
 3343: 
 3344:    // Compute the centroid of the element and its depth
 3345:    Vector2 center = {0.0, 0.0};
 3346:    elem.depth = 0.0;
 3347:    for (int j = 0; j < i34[i]; j++) {
 3348: 
 3349: // printf("WWW i = %d, node = %p, elem.i34 = %d\n", i, elem.nodes[j], elem.i34);    
 3350: 
 3351: 
 3352:       center += elem.nodes[j]->p/i34[i];
 3353:       elem.depth  += elem.nodes[j]->depth/i34[i];
 3354:    }
 3355:    elem.center = center;
 3356: 
 3357:    
 3358:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3359:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3360: 
 3361:    elem.area = elem.computeSignedArea(); 
 3362:    elem.radius = sqrt(elem.area)/pi; 
 3363:    
 3364:    // Determines which way the normal vector to each side is oriented.
 3365:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3366:    for (int j = 0; j < i34[i]; j++)  
 3367:    {
 3368:       if (elem.sides[j]->elems[0] == &elem) {
 3369:          elem.ssign[j] =  1.0;
 3370:       }
 3371:       else {
 3372:          elem.ssign[j] = -1.0;
 3373:       }
 3374: 
 3375:    }
 3376: 
 3377:    // Derivatives of shape functions
 3378:    //  For ics=2, this is done inside element/ll frame XXX
 3379:    //  For quads, the derivative is evaluated at centroid
 3380:    for (int j = 0; j < elem.i34; j++) {
 3381:       const double area = elem.area;
 3382:       const int id2 = elem.nxq(1 + j);
 3383:       const int id3 = elem.nxq(2 + j);
 3384:       const int id4 = elem.nxq(3 + j);
 3385:       if (elem.isTri()) {
 3386:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3387:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3388:          // da1/dx = (y1 - y2)/(2*area)
 3389:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3390:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3391:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3392:       }
 3393:       else  { // Quad; evaluate at centroid
 3394:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3395:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3396:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3397:       } // if Tri
 3398: 
 3399:    } // for j   
 3400:    
 3401:    
 3402: 
 3403: }
 3404: 
 3405: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3406:                                             double *emo, double *efa, 
 3407:                                             double *umo, double *ufa, 
 3408:                                             double *vmo, double *vfa) {
 3409: 
 3410: 
 3411:    NODE_BND(nodeBnd);
 3412:    const int idx = idx_node_bnd;    
 3413: 
 3414:    nodeBnd->idx = idx;
 3415: 
 3416:    // Need to find the segment index and the index of the node on the segment
 3417:    int idxNode = -1;
 3418:    int iseg, i;
 3419:    for (iseg = 0; iseg < nope; iseg++) {
 3420:       // for each segment...
 3421:       for (i = 0; i < nond[iseg]; i++) {
 3422:          idxNode = iond[iseg + i*nope];
 3423:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3424:          
 3425:       }
 3426:    }
 3427: 
 3428:    assert(iseg < nope && "iseg is out of bounds");
 3429: 
 3430: found: // Jumped here when the node was found
 3431: 
 3432:    nodeBnd->isEssentialBC = true;
 3433:    nodeBnd->elbc = 0.0;
 3434: 
 3435:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3436: 
 3437:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX
 3438:       nodeBnd->efa[jfr] = efa[idx2];
 3439:       nodeBnd->emo[jfr] = emo[idx2];
 3440:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3441:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3442: 
 3443:    }
 3444:         
 3445: 
 3446: }
 3447: 
 3448: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 3449:                 double *node_coords, double *node_coords_ll, bool use_ll,
 3450:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 3451:                 int *isdel, int *isidenode, int *isbnd,
 3452:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 3453:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3454:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3455:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3456:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3457:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 3458:                 double *drag, double *roughness,
 3459:                 double *emo, double *efa, 
 3460:                 double *umo, double *ufa, 
 3461:                 double *vmo, double *vfa) {
 3462: 
 3463:    // printf("Populating mesh for partition %d\n", partNum);
 3464: 
 3465:    // XXXXXX THIS function does almost nothing. 
 3466: 
 3467:    nbs = *sharedIdxSideBoundary + 1;
 3468:    nbp = *sharedIdxNodeBoundary + 1;
 3469: 
 3470:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 3471: 
 3472: }
 3473: 
 3474: 
 3475: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3476:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3477:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3478:    // 
 3479:    // This kernel is called for all nodes.
 3480: 
 3481: 
 3482:    NODE(node1);
 3483: 
 3484: 
 3485:    node1->clearMatrixRow();
 3486:    node1->qel = 0.0;
 3487: 
 3488:    // THIS IS FOR STRUCTURES XXX
 3489:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3490: 
 3491:    
 3492:    for (int j=0; j<node1->numElements; j++) {
 3493:       // For each element connected to the node...
 3494: 
 3495:       Element *elem = node1->elements[j];
 3496: 
 3497:       // Compute the average gravity
 3498:       const double grav3 = elem->mean(&Node::grav2);
 3499: 
 3500:       // Look at the documentation for the description of the terms in the following integrals
 3501: 
 3502:       // Integral I_1 
 3503:       // \bar{\breve{H}} 
 3504:       const double hhatb = elem->mean(&Side::hhat);        
 3505: 
 3506:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3507: 
 3508:       const int id1 = elem->nodeLocalIdx(node1); 
 3509:       const double area = elem->area;
 3510: 
 3511:       if (elem->isTri()) {
 3512: 
 3513:          // To clarify the notation in this section: 
 3514:          //   i stands for the node under consideration (node1)
 3515:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3516:          const int id2 = elem->nxq(1 + id1);
 3517:          const int id3 = elem->nxq(2 + id1);
 3518:          Node *node2 = elem->nodes[id2];
 3519:          Node *node3 = elem->nodes[id3];
 3520: 
 3521:          const Point2 x1 = node1->p;
 3522:          const Point2 x2 = node2->p;
 3523:          const Point2 x3 = node3->p;
 3524: 
 3525:          // integral of phi_i*phi_j
 3526:          const double ipp_ii = (1.0/6.0 )*area;
 3527:          const double ipp_ij = (1.0/12.0)*area;
 3528:          const double ipp_ik = (1.0/12.0)*area;
 3529: 
 3530:          // integral of [(grad phi_i) * (grad phi_j)]
 3531:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3532:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3533:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3534: 
 3535:          // Computes the different components of integral I_1 of each node with respect to node i.
 3536:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3537:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3538:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3539: 
 3540:          node1->addToSparseMatrix(node1, I1_ii);
 3541:          node1->addToSparseMatrix(node2, I1_ij); 
 3542:          node1->addToSparseMatrix(node3, I1_ik);
 3543: 
 3544:       }
 3545:       else { // Quad
 3546:          // XXX IMPLEMENT THIS
 3547:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3548: 
 3549:          // To clarify the notation in this section: 
 3550:          //   i stands for the node under consideration (node1)
 3551:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3552:          const int id2 = elem->nxq(1 + id1);
 3553:          const int id3 = elem->nxq(2 + id1);
 3554:          const int id4 = elem->nxq(3 + id1);
 3555:          Node *node2 = elem->nodes[id2];
 3556:          Node *node3 = elem->nodes[id3];
 3557:          Node *node4 = elem->nodes[id4];         
 3558: 
 3559:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3560:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3561:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3562:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3563:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3564: 
 3565:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3566:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3567:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3568:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3569:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3570: 
 3571:          // Computes the different components of integral I_1 of each node with respect to node i.
 3572:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3573:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3574:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3575:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3576: 
 3577:          node1->addToSparseMatrix(node1, I1_ii);
 3578:          node1->addToSparseMatrix(node2, I1_ij); 
 3579:          node1->addToSparseMatrix(node3, I1_ik);
 3580:          node1->addToSparseMatrix(node4, I1_il);
 3581:   
 3582: 
 3583: 
 3584:       
 3585:       } 
 3586: 
 3587:  
 3588:       // Integral I_4
 3589:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3590:       // Where
 3591:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3592: 
 3593:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3594:       // of U over the element.
 3595:       Vector2 Umean = {0.0, 0.0};
 3596:       for (int m=0; m<elem->i34; m++) {      
 3597:          const Side *side = elem->sides[m];
 3598: 
 3599:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3600:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3601:       }
 3602:       Umean = Umean/elem->i34;
 3603: 
 3604:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3605: 
 3606:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3607:       const double I_4_1 = dot(gradPhi_1, Umean);
 3608: 
 3609:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3610:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3611:      
 3612:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3613: 
 3614:       // Additional terms 
 3615:       double vnorm = 0.0;
 3616:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3617:          Vector3 ubed;
 3618:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3619: 
 3620:          Vector3 gradP = {0.0, 0.0, 1.0};
 3621:          for (int m=0; m < elem->i34; m++) {
 3622:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3623:            gradP += toVector3(gradP_2D, 0.0);
 3624:          }   
 3625:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3626:       } // imm==2
 3627: 
 3628:       if (elem->isTri()) {
 3629:          for (int l=0; l<3; l++) {
 3630:             double fac;
 3631: 
 3632:             Node *node = elem->nodes[l];
 3633: 
 3634:             fac = (node == node1) ? 2.0 : 1.0;
 3635:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3636:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3637:            
 3638:          }
 3639: 
 3640: 
 3641:          if (!elem->isDry) {
 3642:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3643: 
 3644:           node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3645: 
 3646:          }
 3647: 
 3648:       } // isTri
 3649:       else { // isQuad
 3650:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3651:          // for (int l=0; l<4; l++) {
 3652:          //   const Node *node = elem->nodes[l];
 3653: 
 3654:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3655:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3656: 
 3657:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3658:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3659:          // }
 3660: 
 3661:       } // isQuad
 3662: 
 3663: 
 3664:      node1->qel += (dt/elem->i34)*elem->vsource;
 3665:       
 3666: 
 3667:    } // for all elements connected to the node
 3668:    
 3669: 
 3670:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3671:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3672:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3673:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3674:       // If it is an open boundary node...
 3675: 
 3676:       // At least one open bnd side, maybe two
 3677:       for (int l=0; l<2; l++) { 
 3678: 
 3679:          // Gets each of the sides sharing the node. 
 3680:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3681: 
 3682:          // if (sideBnd == nullptr) continue; // Skip if no boundary side
 3683:          
 3684: 
 3685:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3686:          if (sideBnd != nullptr) {
 3687:             // If the side is on a boundary...
 3688: 
 3689:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3690: 
 3691:             // Get the boundary segment
 3692:             const BoundarySegment *sideSegment = sideBnd->segment;
 3693:             const Side *side = sideBnd->side;
 3694: 
 3695:             // Integral I_3
 3696:             if (sideSegment->ifltype != 0) {
 3697:             // Natural or Flather b.c.
 3698: 
 3699:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3700:                // especially for Flather b.c.
 3701:                double ri3 = 0.0;
 3702:                if (!side->isDry) {
 3703:                   // If the side is not dry
 3704:                   
 3705:                   // Computes the side flux of (uth, vth)
 3706:                   double Vn = 0.0;
 3707:                   for (int k = side->kb; k<nvrt-1; k++) {
 3708:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3709:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3710: 
 3711:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3712:                   }
 3713: 
 3714:                   ri3 = 0.5*side->len*Vn;
 3715:                }
 3716: 
 3717:                if (sideSegment->ifltype == -1) { // Flather 1
 3718: 
 3719:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3720:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3721: 
 3722:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3723:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3724:                   
 3725:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3726:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3727: 
 3728:                } 
 3729:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3730:                   // Reset ri3
 3731:                   ri3 = 0.0;
 3732: 
 3733:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3734: 
 3735:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3736: 
 3737:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3738:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3739: 
 3740:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3741:                   node1->addToSparseMatrix(node1, con0*2.0);
 3742:                   node1->addToSparseMatrix(node2, con0);
 3743: 
 3744:                } // if Flather or Discharge
 3745: 
 3746: // printf("node1 = %p, thetai = %f, dt = %f, ri3 = %f\n", node1, thetai, dt, ri3);
 3747:                node1->qel -= thetai*dt*ri3;
 3748: 
 3749: 
 3750:             } // I_3
 3751:           
 3752: 
 3753:             // Integral I_5
 3754:             if(!side->isDry) {
 3755: 
 3756:                const double Unbar = dot(side->U, side->n);
 3757:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3758: 
 3759:             } // I_5
 3760: 
 3761:          } // if is boundary side
 3762: 
 3763:       } // for l
 3764: 
 3765:    } // if isbnd
 3766: 
 3767: 
 3768: }
 3769: 
 3770: 
 3771: extern "C" {
 3772:    __global__ void setupCGSolver(double* data, int* indices, int* indptr, double* b) {
 3773:       int off = 0;
 3774:       for (int i = 0; i < mesh->np; i++) {
 3775: 
 3776:          const Node *node = mesh->localNodeData + i;
 3777:          indptr[i] = off;
 3778: 
 3779:          // Diagonal first
 3780:          data[off]    = node->coeffDiag;
 3781:          indices[off] = i;
 3782:          ++off;
 3783:          // printf("i = %d, off = %d, node->nodes[i] = %p\n", i, off, node->nodes[i]);
 3784:          // Off-diagonals
 3785:          for (int k = 0; k < node->numNodes; ++k) {
 3786:             const Node* nb = node->nodes[k];
 3787:             // printf("i = %d, k = %d, nb = %p\n", i, k, nb);
 3788:             // Map pointer -> column index by pointer arithmetic
 3789:             int j = nb->idx;
 3790:             // (optionally: if (j == i) data[diag_off] += nd.coeffMatrix[k]; else ...)
 3791:             data[off]    = node->coeffMatrix[k];
 3792:             indices[off] = j;
 3793:             ++off;
 3794:             // printf("i = %d, j = %d, off = %d, data[off] = %f\n", i, j, off, data[off]);
 3795:          }
 3796: 
 3797:          // RHS
 3798:          b[i] = node->qel;
 3799:       }
 3800: 
 3801:       indptr[mesh->np] = off;
 3802:    }
 3803:    
 3804: }
 3805: 
 3806: extern "C" {
 3807:    __global__ void setupCGSolver2(double* diag, double* data, int* indices, int* indptr, double* b) {
 3808:       NODE(node);
 3809:       const int idx = node->idx;
 3810:       // Computes the index in the nzz array
 3811: 
 3812:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 3813: 
 3814:       indptr[idx] = nzzIdx;
 3815:       data[nzzIdx]    = node->coeffDiag;
 3816:       indices[nzzIdx] = idx;
 3817: 
 3818:       for (int k = 0; k < node->numNodes; ++k) {
 3819:          const Node* nb = node->nodes[k];
 3820: 
 3821:          int j = nb->idx;
 3822:          // (optionally: if (j == i) data[diag_off] += nd.coeffMatrix[k]; else ...)
 3823:          data[nzzIdx + k + 1]    = node->coeffMatrix[k];
 3824:          indices[nzzIdx + k + 1] = j;
 3825:       }
 3826: 
 3827:       diag[idx] = 1.0/node->coeffDiag;
 3828:       b[idx] = node->qel;
 3829:    }
 3830: }
 3831: 
