  884:    __device__ void trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
  885:                                        double &dt, Point3 &xt, double zint, Vector3 &u_int);
  886:     
  887:    __device__ bool trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
  888:                                                  Element *&nextElem, int &jlev, double &dt,
