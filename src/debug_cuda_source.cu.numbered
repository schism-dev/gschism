 3589: 
 3590: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3591: 
 3592: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3593: 
 3594:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3595:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3596: 
 3597:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3598:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3599: 
 3600:    double fun_lat = 0.0;
 3601:    switch (jspc[idxComp]) {
 3602:       case 0:
 3603:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3604:          break;
 3605:       case 1:
 3606:          fun_lat = sin(2.0*lat);
 3607:          break;
 3608:       case 2:
 3609:          fun_lat = pow<2>(cos(lat));
 3610:          break;
 3611:       default:
 3612:          assert(false && "computeETP: invalid jspc");
 3613:    }
 3614:    
 3615:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3616: 
 3617: }
 3618: 
 3619: 
 3620: __device__ void Node::updateKb(void) {
 3621: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3622: 
 3623:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3624: 
 3625: 
 3626:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3627: 
 3628:    if constexpr(ivcor == 2) {  // SZ coordinates
 3629:       
 3630:       // Compute bottom level index
 3631:       if (depth <= mesh->h_s) {
 3632:          kb = izlev;   
 3633:          
 3634:       } else {
 3635:          kb = -1;
 3636:          int L = 0;
 3637:          int R = nzlev; 
 3638:          
 3639:          while (L <= R) {
 3640:             int M = (R + L) / 2;
 3641: 
 3642: 
 3643:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3644:             
 3645:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3646:                R = M;
 3647:             } else {
 3648:                L = M;
 3649:             }
 3650: 
 3651:             if (R - L == 1) {
 3652:                kb = L;
 3653:                break;
 3654:             }
 3655:          }
 3656: 
 3657:          // Checks that the binary search was successful
 3658:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3659:        
 3660:       }
 3661:    } 
 3662: }
 3663: 
