 1091: struct Side {
 1092: 
 1093:    // Geometry information
 1094:    int idx;               // Index of the side
 1095:    Node *n1, *n2;
 1096:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
 1097: 
 1098:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
 1099:    Vector2 center;        // Location of side center. 
 1100:    double zc[nvrt];       // Side center z-coord at each vertical level
 1101: 
 1102:    #ifdef USE_FRAMES
 1103:    Frame frame;
 1104:    #endif
 1105: 
 1106:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
 1107:                           // this is nullptr
 1108:    
 1109:    int kb;                // Bottom index of the side
 1110:    bool isDry;            // True if the side is dry
 1111:  
 1112:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1113: 
 1114:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1115: 
 1116:    // Physical information
 1117:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1118:    Vector2 btu[nvrt];           // Back-tracked velocity
 1119:    Vector2 U;                   // Vertically averaged velocity vector  
 1120: 
 1121:    Vector2 nuGradU[nvrt];          // nu*grad u
 1122: 
 1123:    Vector2 bcc[nvrt];           // Baroclinic term
 1124:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1125: 
 1126:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1127:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1128:    Vector2 gradPr;               // Gradient of pressure
 1129:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1130: 
 1131: 
 1132:    double hhat;                 // \breve{H} in notes
 1133: 
 1134:    double shapiro;
 1135: 
 1136:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1137: 
 1138:    double coriolis;             // Coriolis parameter
 1139: 
 1140:    // Vegetation parameters
 1141:    double veg_c2;
 1142:    double veg_beta;
 1143: 
 1144:    // Bottom drag parameters.
 1145:    double chi;
 1146:    double chi2;
 1147: 
 1148:    __inline__ __device__ Point2 outputCoords(void) const;
 1149: 
 1150:    __inline__ __device__ double x(double t) const;
 1151:    __inline__ __device__ double y(double t) const;
 1152:    __inline__ __device__ double z(double t) const;
 1153:    __inline__ __device__ double lon(void) const;
 1154:    __inline__ __device__ double lat(void) const;
 1155:    __inline__ __device__ Point2 p2_t(double t) const;
 1156:    __inline__ __device__ Point3 p3_t(double t) const;
 1157: 
 1158:    #ifdef USE_FRAMES
 1159:    __device__ void setFrame(void) {
 1160:       double lat, lon;
 1161:       const Point3 p = toPoint3(center, centerZ());
 1162: 
 1163:       // Compute the latitude and longitude of the element center
 1164:       computeLatLon(p, lat, lon);
 1165: 
 1166:       frame.update(lat, lon);        
 1167:    }
 1168:    #endif
 1169: 
 1170:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1171:    // If ics == 2, convert the global point to the local frame of the original side
 1172:       
 1173:       if constexpr (ics == 1) {
 1174:          return p;
 1175:       } else {
 1176: #ifdef USE_FRAMES
 1177:          const Point3 c = {center.x, center.y, centerZ()};
 1178:             const Point3 local = frame.G2L(p - c);
 1179:             return local;
 1180: #else
 1181:          return p;
 1182: #endif
 1183:       }
 1184:    }
 1185: 
 1186:    __inline__ __device__ double centerZ(void)      const;
 1187:    __inline__ __device__ Point3 center3D(int k)    const { assert(false); assert(k < nvrt); return {center.x, center.y, zc[k]}; }  // USED??? CONSISTENT?? XXXXX
 1188:    __inline__ __device__ double Dz(int k)          const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1189:    __inline__ __device__ double area(int k)        const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1190:    __inline__ __device__ double areaClamped(int k) const { assert(k < nvrt - 1); return len*(zc[max(k + 1, kb)] - zc[max(k, kb)]); }
 1191: 
 1192:    __inline__ __device__ Side* neigh(int index) const { 
 1193:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1194:       assert(index >= 0 && index < 4); 
 1195:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1196: 
 1197:       const int ielem = index & 1;           // 0 or 1
 1198:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1199: 
 1200:       const Element* elem = elems[ielem];
 1201: 
 1202:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1203: 
 1204:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1205: 
 1206:    }
 1207: 
 1208:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1209: 
 1210:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1211: 
 1212:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1213:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1214:    __inline__ __device__ int iadv(void) const;
 1215: 
 1216:    __inline__ __device__ double grav3(void) const;
 1217:    
 1218:    __inline__ __device__ double eta2(void) const;
 1219:    __inline__ __device__ double eta1(void) const;
 1220:    __inline__ __device__ double w2(int k) const;
 1221:    __inline__ __device__ Vector2 u2Bottom(int dummy = 0) const { return u2[kb]; }  // XXXX dummy argument to satisfy the template in mean()
 1222:    __inline__ __device__ double depth(void) const;
 1223:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1224:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1225: 
 1226:    __inline__ __device__ double dfv(int k) const;
 1227: 
 1228:    __inline__ __device__ double veg_h(void)  const;
 1229:    __inline__ __device__ double veg_nv(void) const;
 1230:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1231:    __inline__ __device__ double veg_alpha3D(int k) const;
 1232:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1233: 
 1234:    __inline__ __device__ double Cd(void) const;
 1235: 
 1236:    __inline__ __device__ Vector2 tau(void) const;
 1237: 
 1238:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1239:    
 1240: 
 1241:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1242:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1243:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1244:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1245:    } 
 1246:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1247:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1248:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1249:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1250: 
 1251:    // Get valid starting element (for backtracking)
 1252:    __inline__ __device__ Element* getStartElement() {
 1253:       return elems[0] ? elems[0] : elems[1];
 1254:    }
 1255: 
 1256:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
 1257:       // From the elements that share this side, find the one that is in the direction opposite to the velocity vector
 1258:       // (unless it is a boundary side or a dry element, in which case we return the only wet element)
 1259: 
 1260:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
 1261: 
 1262:       // Dot product of the negative velocity vector with the side normal vector
 1263:       const double dot_prod1 = -dot(u, n);
 1264: 
 1265:       // Vector from side center to element 0 centroid
 1266:       const Vector2 v2 = elems[0]->center - center;
 1267: 
 1268:       // Dot product of the vector with the side normal vector
 1269:       const double dot_prod2 = dot(v2, n);
 1270: 
 1271:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
 1272:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
 1273: 
 1274:       const bool isDry0 = elems[0]==nullptr || elems[0]->isDry;
 1275:       const bool isDry1 = elems[1]==nullptr || elems[1]->isDry;
 1276: 
 1277:       assert(!isDry0 || !isDry1 && "Both elements are dry in findElementTowards");
 1278: 
 1279:       if (dot_prod1*dot_prod2 > 0.0) return !isDry0 ? elems[0] : elems[1];
 1280:       else                           return !isDry1 ? elems[1] : elems[0];
 1281: 
 1282:  
 1283:    }
 1284: 
 1285:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1286:       // Given an element, returns the other element that shares this side
 1287:       return (elems[0] == elem) ? elems[1] : elems[0];
 1288:    }
 1289: 
 1290:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1291:       // Given a node, returns the other node that shares this side
 1292:       return (n1 == node) ? n2 : n1;
 1293:    }
 1294:  
 1295:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1296: 
 1297: 
 1298: 
 1299: 
 1300: };
