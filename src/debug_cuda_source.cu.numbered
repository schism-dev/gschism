 3768: 
 3769: 
 3770: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3771: 
 3772: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3773: 
 3774:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3775:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3776: 
 3777: 
 3778: 
 3779:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3780:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3781: 
 3782:    double fun_lat = 0.0;
 3783:    switch (jspc[idxComp]) {
 3784:       case 0:
 3785:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3786:          break;
 3787:       case 1:
 3788:          fun_lat = sin(2.0*lat);
 3789:          break;
 3790:       case 2:
 3791:          fun_lat = pow<2>(cos(lat));
 3792:          break;
 3793:       default:
 3794:          assert(false && "computeETP: invalid jspc");
 3795:    }
 3796:    
 3797:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3798: 
 3799: }
