 3583: 
 3584: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3585: 
 3586: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3587: 
 3588:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3589:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3590: 
 3591:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3592:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3593: 
 3594:    double fun_lat = 0.0;
 3595:    switch (jspc[idxComp]) {
 3596:       case 0:
 3597:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3598:          break;
 3599:       case 1:
 3600:          fun_lat = sin(2.0*lat);
 3601:          break;
 3602:       case 2:
 3603:          fun_lat = pow<2>(cos(lat));
 3604:          break;
 3605:       default:
 3606:          assert(false && "computeETP: invalid jspc");
 3607:    }
 3608:    
 3609:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3610: 
 3611: }
 3612: 
 3613: __device__ void Node::updateKb(void) {
 3614: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3615: 
 3616:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3617: 
 3618: 
 3619:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3620: 
 3621:    if constexpr(ivcor == 2) {  // SZ coordinates
 3622:       
 3623:       // Compute bottom level index
 3624:       if (depth <= mesh->h_s) {
 3625:          kb = izlev;   
 3626:          
 3627:       } else {
 3628:          kb = -1;
 3629:          int L = 0;
 3630:          int R = nzlev; 
 3631:          
 3632:          while (L <= R) {
 3633:             int M = (R + L) / 2;
 3634: 
 3635: 
 3636:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3637:             
 3638:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3639:                R = M;
 3640:             } else {
 3641:                L = M;
 3642:             }
 3643: 
 3644:             if (R - L == 1) {
 3645:                kb = L;
 3646:                break;
 3647:             }
 3648:          }
 3649: 
 3650:          // Checks that the binary search was successful
 3651:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3652:        
 3653:       }
 3654:    } 
 3655: }
 3656: 
 3657: 
 3658: __device__ __inline__ void Node::updateZCoordData(void) {
 3659: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3660: 
 3661:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3662:    // if (isDry2()) {
 3663:    //    kb = -1;  // XXXXXXXX KKKKK
 3664:    //    return;
 3665:    // }
 3666: 
 3667: 
 3668:    if constexpr(ivcor == 2) {  // SZ coordinates
 3669:       
 3670:       // Compute bottom level index
 3671:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3672:    } 
 3673:    else {  // if (ivcor == 1) Localized sigma
 3674:       // Do nothing
 3675:    }
 3676: 
 3677: 
 3678: }
