 2997: 
 2998: __device__ void DEAL_WITH_POINT_INTERSECTING_SIDE2(BTPoint &curPoint, Point3 &xt, const Side *excludeSide1, const Side *excludeSide2) {
 2999:    // This function deals with the case where the segment x0xt intersects a side of the element that is not one of the two sides to exclude.
 3000: // if (it>=115) printf("ZZZZZ1 curPoint.type = %d, curPoint.elem.idx = %d, curPoint.side = %p\n", curPoint.type, curPoint.elem->idx, curPoint.side);
 3001: Element *oldelem = curPoint.elem;
 3002:    Side *intersectSide = nullptr;
 3003:    Element *nextElem = nullptr;
 3004:    double t, tIntersect;
 3005: 
 3006:    const Point2 x1 = toPoint2(curPoint.x);
 3007:    const Point2 x2 = toPoint2(xt);
 3008:    const Element *elem = curPoint.elem;
 3009: 
 3010:    assert(elem != nullptr && "elem is nullptr in DEAL_WITH_POINT_INTERSECTING_SIDE");
 3011: 
 3012:    // assert( elem->containsPoint2(x1) && "Starting point is not inside the element");                                    
 3013:    assert(!elem->containsPoint2(x2) && "Ending point is not outside the element");
 3014: 
 3015:    double closest_intersect_t = 1e10;
 3016:    bool found_intersection = false;
 3017:    double tt1, tt2, last_tt2 = 77777777.0; // XXXXXX
 3018:    for (int i = 0; i < elem->i34; i++) {
 3019: 
 3020:       Side *side = elem->sides[i];
 3021: 
 3022: assert(side != nullptr && "side is nullptr in DEAL_WITH_POINT_INTERSECTING_SIDE");
 3023: 
 3024:       if (excludeSide1 == side || excludeSide2 == side) continue;
 3025: 
 3026:       // (x3,y3)-(x4,y4) is the element side line
 3027:       const Point2 x3 = side->n1->p;
 3028:       const Point2 x4 = side->n2->p;
 3029: 
 3030:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 3031:       const double delta = cross(x2 - x1, x3 - x4);
 3032: 
 3033:       if (abs(delta) > 0) {
 3034: 
 3035:          const double delta1 = cross(x3 - x1, x3 - x4);
 3036:          const double delta2 = cross(x2 - x1, x3 - x1); 
 3037: 
 3038:          // Solves the two linear equations for tt1 and tt2
 3039:          tt1 = delta1/delta; // delta is not zero, so we can divide
 3040:          tt2 = delta2/delta;
 3041: 
 3042:          // Computes a distance to interval [0,1]
 3043:          const double distTo01 = max3(0.0, -tt1, tt1 - 1.0);
 3044: 
 3045:          if (closest_intersect_t > distTo01) {
 3046:             intersectSide = side;
 3047:             closest_intersect_t = distTo01;
 3048:             nextElem = side->otherElem(elem);
 3049:             found_intersection = true;
 3050:             last_tt2 = tt2;
 3051:          }
 3052: 
 3053:       }
 3054: 
 3055:    } // for
 3056: 
 3057:    assert(found_intersection && "No intersection found in DEAL_WITH_POINT_INTERSECTING_SIDE");
 3058:    assert(intersectSide != nullptr && "intersectSide is nullptr in DEAL_WITH_POINT_INTERSECTING_SIDE");
 3059:    
 3060: 
 3061: 
 3062:    // if (nextElem == nullptr) printf("LLLL intersectSide->elems[0]->isDry = %d\n", intersectSide->elems[0]->isDry);
 3063: 
 3064:    // if (nextElem == nullptr && intersectSide->elems[1] != nullptr) printf("LLLL intersectSide->elems[1]->isDry = %d\n", intersectSide->elems[1]->isDry);
 3065:    if (nextElem == nullptr) nextElem = intersectSide->elems[0];  // elems[0] is never nullptr. This is done in case the element is not set yet.
 3066:    assert(nextElem != nullptr && "nextElem is nullptr in DEAL_WITH_POINT_INTERSECTING_SIDE");
 3067: 
 3068: //  printf("YYYYY1 intersectSide = %p, n1 = %d, n2 = %d, last_tt2 = %.16f\n", intersectSide, intersectSide->n1->idx, intersectSide->n2->idx, last_tt2);
 3069: // printf("TTTTTT last_tt2 = %.16f geometricEpsilon = %.16f  intersectSide = %p, sizeof(BTPointType) = %d\n", last_tt2, geometricEpsilon, intersectSide, sizeof(BTPoint::BTPointType));
 3070: // printf("TTTTTT curPoint.type = %d, it = %d\n", curPoint.type, it);
 3071: 
 3072:    if (last_tt2 < geometricEpsilon) {
 3073:       curPoint.type = BTPoint::BTPointType::btNode;
 3074:       curPoint.node = intersectSide->n1;
 3075:       curPoint.side = intersectSide;
 3076:       curPoint.t = 0.0; 
 3077: 
 3078:    }
 3079:    else if (last_tt2 > 1.0 - geometricEpsilon) {
 3080:       curPoint.type = BTPoint::BTPointType::btNode;
 3081:       curPoint.node = intersectSide->n2;
 3082:       curPoint.side = intersectSide;
 3083:       curPoint.t = 1.0; 
 3084:       
 3085:    }
 3086:    else {
 3087: return;
 3088: 
 3089: unsigned long long type_addr = (unsigned long long)&curPoint.side;
 3090: unsigned long long type_size = sizeof(BTPoint::BTPointType);
 3091: unsigned long long align_mask = 15;
 3092: unsigned long long type_offset = (type_addr & align_mask);
 3093: // printf("TTTTTT type_addr = %llu, type_size = %llu, align_mask = %llu, type_offset = %llu\n", type_addr, type_size, align_mask, type_offset);
 3094: curPoint.type= curPoint.type;
 3095:       // curPoint.type = BTPoint::BTPointType::btSide;
 3096:       curPoint.side = intersectSide;
 3097:       curPoint.node = nullptr;
 3098:       curPoint.t = last_tt2;
 3099:    }
 3100: 
 3101:    curPoint.elem = nextElem;
 3102:    curPoint.dt = curPoint.dt*closest_intersect_t;
 3103:    toPoint2(curPoint.x) = intersectSide->p_t(curPoint.t);
 3104:    curPoint.x.z = (1.0 - closest_intersect_t)*curPoint.x.z + closest_intersect_t*xt.z;
 3105: if (it>=115) printf("ZZZZZ2 curPoint.type = %d, oldelem.idx = %d, newelem.idx = %d, IDX(curPoint.side) = %d IDX(curPoint.side->n1) = %d IDX(curPoint.side->n2) = %d\n", curPoint.type, oldelem->idx, nextElem->idx, curPoint.side->idx, curPoint.side->n1->idx, curPoint.side->n2->idx);
 3106: return;
 3107: }
