 7179: extern "C"
 7180:                                  
 7181:   __global__ void populateMesh(int *i34, int *elnode, int *elside,
 7182:                    double *node_coords, double *node_coords_ll, bool use_ll,
 7183:                    double *wind_rotate_angle, 
 7184:                    int *isdel, int *isidenode, int *isbnd,
 7185:                    int *nond, int *nlnd, int *iond, int *ilnd, 
 7186:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 7187:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 7188:                    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 7189:                    int *localNodeIndices, int *localElemIndices, int *localSideIndices,
 7190:                    int *localNodePart,    int *localElemPart,    int *localSidePart,
 7191:                    double *drag, double *roughness,
 7192:                    double *emo, double *efa, 
 7193:                    double *umo, double *ufa, 
 7194:                    double *vmo, double *vfa) {
 7195: 
 7196:     mesh->populateMesh(i34, elnode, elside, node_coords, node_coords_ll, use_ll, wind_rotate_angle, 
 7197:                        isdel, isidenode, isbnd,
 7198:                        nond, nlnd, iond, ilnd, 
 7199:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 7200:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 7201:                        globalNodeIndices, globalElemIndices, globalSideIndices,
 7202:                        localNodeIndices, localElemIndices, localSideIndices,
 7203:                        localNodePart, localElemPart, localSidePart,
 7204:                        drag, roughness,
 7205:                        emo, efa, umo, ufa, vmo, vfa);
 7206:   }
