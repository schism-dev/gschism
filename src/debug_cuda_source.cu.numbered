10160: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
10161:    Node *nodes = mesh->localNodeData;
10162: 
10163:    *addr = nodes;
10164:    *sizeNode = sizeof(Node);
10165: 
10166:    switch (varCode) {
10167:       case (int)VarCode::depth:
10168:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
10169:          *sizeType = sizeof(double);
10170:          break;
10171:       case (int)VarCode::eta:
10172:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
10173:          *sizeType = sizeof(double);
10174:          break;
10175:       case (int)VarCode::x:
10176:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
10177:          *sizeType = sizeof(Vector2);
10178:          break;
10179:       case (int)VarCode::z:
10180:          *offset = (int)((char*)&nodes[0].z - (char*)nodes);
10181:          *sizeType = sizeof(double);
10182:          break;
10183:       case (int)VarCode::kb:
10184:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
10185:          *sizeType = sizeof(int);
10186:          break;
10187:       case (int)VarCode::isdry:
10188:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
10189:          *sizeType = sizeof(int);
10190:          break;         
10191:       case (int)VarCode::w:
10192:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
10193:          *sizeType = sizeof(double);
10194:          break;
10195:       case (int)VarCode::u:
10196:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
10197:          *sizeType = sizeof(Vector2);
10198:          break;  
10199:       case (int)VarCode::u_air:
10200:          *offset = (int)((char*)&nodes[0].u_air - (char*)nodes);
10201:          *sizeType = sizeof(Vector2);
10202:          break;
10203:       default:
10204:          *offset = -1;    
10205:    }  
10206:    
10207: }
