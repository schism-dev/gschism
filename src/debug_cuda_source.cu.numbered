  504:    Side *sides[4];            // Sides of the element
  505:    Node *nodes[4];            // Nodes of the element
  506:    Element *nghbElems[4];     // Neighbors of the element
  507: 
  508:    int kb;                    // Bottom index of the element
  509:    double area;               // Area of the element
  510:    double ssign[4];           // Sign associated with each side of an element. Allows to compute the outward normal vector to the side.
