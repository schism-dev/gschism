 1424:    __device__ Mesh(int partNum,
 1425:                    int npgb, int negb, int nsgb, 
 1426:                    int np, int ne, int ns,
 1427:                    int max_np, int max_ne, int max_ns, int nseg,
 1428:                    Node **nodesPtr, Element **elemsPtr, Side **sidesPtr,
 1429:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 1430:                    Node    **localNodeNeighNodesMem,
 1431:                    Element **localNodeNeighElemsMem,
 1432:                    double *partCoeffMatrixMem,
 1433:                    NodeBoundary *localNodeBoundaryMem,
 1434:                    SideBoundary *localSideBoundaryMem,
 1435:                    BoundarySegment *localSegmentMem,
 1436:                    double h_c, double h_s, double theta_b, double theta_f, double *sigma_lcl, double *sigma, double *ztot,
 1437:                    double *cs, double *dcs
 1438:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 1439:                        np(np), ne(ne), ns(ns),
 1440:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
 1441:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
 1442:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
 1443:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
 1444:                        localNodeBoundaryMem(localNodeBoundaryMem), localSideBoundaryMem(localSideBoundaryMem),
 1445:                        localSegmentMem(localSegmentMem),
 1446:                        h_c(h_c), h_s(h_s), theta_b(theta_b), theta_f(theta_f), sigma_lcl(sigma_lcl), sigma(sigma), ztot(ztot),
 1447:                        cs(cs), dcs(dcs),
 1448:                        coeffMatrixMem(partCoeffMatrixMem),
 1449:                        landBoundarySegment(true),
 1450:                        landBoundaryNode(true)
 1451:    {
 1452:       printf("Mesh constructor for partition %d\n", partNum);
