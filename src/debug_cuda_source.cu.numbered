 1398: struct Side {
 1399: 
 1400:    // Geometry information
 1401:    int idx;               // Index of the side
 1402:    Node *n1, *n2;
 1403:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
 1404: 
 1405:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
 1406:    Vector2 center;        // Location of side center. 
 1407:    double zc[nvrt];       // Side center z-coord at each vertical level
 1408: 
 1409:    Frame<ics> frame;
 1410:    
 1411:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
 1412:                           // this is nullptr
 1413:    
 1414:    int16_t kb;            // Bottom index of the side
 1415:    bool isDry;            // True if the side is dry
 1416:  
 1417:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1418: 
 1419:    Tracers tracers[nvrt]; // Tracer concentrations at nodes
 1420: 
 1421:    // Physical information
 1422:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1423:    Vector2 btu[nvrt];           // Back-tracked velocity
 1424:    Vector2 U;                   // Vertically averaged velocity vector  
 1425: 
 1426:    Vector2 nuGradU[nvrt];          // nu*grad u
 1427: 
 1428:    Vector2 bcc[nvrt];           // Baroclinic term
 1429:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1430: 
 1431:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1432:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1433:    Vector2 gradPr;               // Gradient of pressure
 1434:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1435: 
 1436: 
 1437:    double hhat;                 // \breve{H} in notes
 1438: 
 1439:    double shapiro;
 1440: 
 1441:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1442: 
 1443:    double coriolis;             // Coriolis parameter
 1444: 
 1445:    // Vegetation parameters
 1446:    double veg_c2;
 1447:    double veg_beta;
 1448: 
 1449:    // Bottom drag parameters.
 1450:    double chi;
 1451:    double chi2;
 1452: 
 1453:    __inline__ __device__ Point2 outputCoords(void) const;
 1454: 
 1455:    __inline__ __device__ double x(double t) const;
 1456:    __inline__ __device__ double y(double t) const;
 1457:    __inline__ __device__ double z(double t) const;
 1458:    __inline__ __device__ double lon(void) const;
 1459:    __inline__ __device__ double lat(void) const;
 1460:    __inline__ __device__ Point2 p2_t(double t) const;
 1461: 
 1462:    __device__ void setFrame(void) {
 1463:       if constexpr(ics == 1) return;
 1464: 
 1465:       double lat, lon;
 1466:       const Point3 p = toPoint3(center, centerZ());
 1467: 
 1468:       // Compute the latitude and longitude of the element center
 1469:       computeLatLon(p, lat, lon);
 1470: 
 1471:       frame.update(lat, lon);        
 1472:    }
 1473:    
 1474: 
 1475:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1476:    // If ics == 2, convert the global point to the local frame of the side
 1477:       
 1478:       if constexpr (ics == 1) {
 1479:          return p;
 1480:       } else {
 1481:          const Point3 c = {center.x, center.y, centerZ()};
 1482:          const Point3 local = frame.G2L(p - c);
 1483:          return local;
 1484:       }
 1485:    }
 1486: 
 1487:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1488:       if constexpr (ics == 1) {
 1489:          return p;
 1490:       } else {
 1491:          const Point3 c = {center.x, center.y, centerZ()};
 1492:          return c + frame.L2G(p);
 1493:       }
 1494:    }
 1495: 
 1496: 
 1497:    __device__ __forceinline__ Vector2 projectToLocalFrame(Vector2 const& v, Frame<ics> const& v_frame) const {
 1498:       if constexpr(ics == 1) return v;
 1499:       else return v_frame.projHorVec(v, frame);
 1500:    }
 1501: 
 1502:    __inline__ __device__ double centerZ(void)      const;
 1503:    __inline__ __device__ Point3 center3D(int k)    const { assert(false); assert(k < nvrt); return {center.x, center.y, zc[k]}; }  // USED??? CONSISTENT?? XXXXX
 1504:    __inline__ __device__ double Dz(int k)          const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1505:    __inline__ __device__ double area(int k)        const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1506:    __inline__ __device__ double areaClamped(int k) const { assert(k < nvrt - 1); return len*(zc[max(k + 1, kb)] - zc[max(k, kb)]); }
 1507: 
 1508:    __inline__ __device__ Side* neigh(int index) const { 
 1509:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1510:       assert(index >= 0 && index < 4); 
 1511:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1512: 
 1513:       const int ielem = index & 1;           // 0 or 1
 1514:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1515: 
 1516:       const Element* elem = elems[ielem];
 1517: 
 1518:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1519: 
 1520:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1521: 
 1522:    }
 1523: 
 1524:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1525: 
 1526:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1527: 
 1528:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1529:    __inline__ __device__ bool isOpenBnd(void) const { return isBnd() && sideBnd->segment->ifltype == 0; } // True if the side is an open boundary side
 1530:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1531:    __inline__ __device__ int iadv(void) const;
 1532: 
 1533:    __inline__ __device__ double grav3(void) const;
 1534:    
 1535:    __inline__ __device__ double eta2(void) const;
 1536:    __inline__ __device__ double eta1(void) const;
 1537:    __inline__ __device__ double w2(int k) const;
 1538:    __inline__ __device__ Vector2 u2Bottom(int dummy = 0) const { return u2[kb]; }  // XXXX dummy argument to satisfy the template in mean()
 1539:    __inline__ __device__ double depth(void) const;
 1540:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1541:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1542: 
 1543:    __inline__ __device__ double dfv(int k) const;
 1544: 
 1545:    __inline__ __device__ double veg_h(void)  const;
 1546:    __inline__ __device__ double veg_nv(void) const;
 1547:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1548:    __inline__ __device__ double veg_alpha3D(int k) const;
 1549:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1550: 
 1551:    __inline__ __device__ double Cd(void) const;
 1552: 
 1553:    __inline__ __device__ Vector2 tau(void) const;
 1554: 
 1555:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1556:    
 1557: 
 1558:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1559:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1560:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1561:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1562:    } 
 1563:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1564:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1565:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1566:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1567: 
 1568:    // Get valid starting element (for backtracking)
 1569:    __inline__ __device__ Element* getStartElement() {
 1570:       return elems[0] ? elems[0] : elems[1];
 1571:    }
 1572: 
 1573:    
 1574:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1575:       // Given an element, returns the other element that shares this side
 1576:       return (elems[0] == elem) ? elems[1] : elems[0];
 1577:    }
 1578: 
 1579:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1580:       // Given a node, returns the other node that shares this side
 1581:       return (n1 == node) ? n2 : n1;
 1582:    }
 1583:  
 1584:    __inline__ __device__ void btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1585: 
 1586: 
 1587: 
 1588: 
 1589: };
