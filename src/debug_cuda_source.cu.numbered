 2377: 
 2378: __inline__ __device__ double  Side::Cd(void)      const { if constexpr(nchi != 0) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 2379: 
 2380: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 2381: 
 2382: /**
 2383:  * This method performs backtracking from the side center until a time -dt back in time 
 2384:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2385:  * intermediate point.
 2386:  *
 2387:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2388:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2389:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2390:  * remaining time.
 2391:  * 
 2392:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2393:  * 
 2394:  * @param uuint, vvint, wwint: Velocities at the final point
 2395:  * @param jlev: Level at which the backtracking is performed
 2396:  * @param dt, dtbk: Tracking timesteps
 2397:  * @return: True if the backtracking was successful, false otherwise
 2398:  */
 2399: __inline__ __device__ bool Side::btrack(
 2400:       int jlev,
 2401:       double dt,            // Tracking time
 2402:       double dtbk,          // Tracking timestep
 2403:       Vector3 &u_int        // Velocities at the initial point
 2404: ) const {
 2405: 
 2406:    // Start from side center
 2407:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2408:  
 2409: 
 2410:    double time_rm = dt; // Remaining time
 2411: 
 2412: 
 2413:    // // Initialize outputs XXX
 2414:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2415:    //    sclr[i] = 0.0;
 2416:    // }
 2417: 
 2418: 
 2419:    // Initial velocities
 2420:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 2421: 
 2422:    // Find the element that is in the direction opposite to the velocity
 2423:    Element* curElem = findElementTowards(toVector2(u_int));
 2424: 
 2425:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2426:    if (curElem == nullptr) {
 2427:       // Make velocity parallel to the side
 2428:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2429:       u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2430:       curElem = otherElem(curElem);
 2431:       
 2432:    }
 2433: 
 2434: 
 2435: 
 2436:    const int MAX_ITERATIONS = 1000; 
 2437:    Element* nextElem = curElem;
 2438:    int iter = 0;
 2439:    while(true) {
 2440: 
 2441:       // Calculate timestep
 2442:       double dtb = min(dtbk, time_rm);
 2443: 
 2444:       // Next point in the backtracking curve
 2445:       Point3 xt = x0 - dtb*u_int;
 2446: 
 2447:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, this);
 2448:       assert(found && "Backtracking failed in btrack");
 2449: 
 2450:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2451:                       // then time_rm needs to be increased by the unused time.
 2452:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2453: 
 2454: 
 2455:       // If the velocity is too small, we stop the backtracking
 2456:       const double vmag = length(toVector2(u_int));
 2457:       if (vmag <= velmin_btrack) break;
 2458: 
 2459:       // The current point becomes the next segment's starting point.
 2460:       x0 = xt;
 2461:  
 2462:       curElem = nextElem;
 2463: 
 2464:       iter++;
 2465:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2466:    }
 2467: 
 2468: 
 2469: }
 2470: 
 2471: 
