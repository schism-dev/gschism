 6669:    __global__ void computeBottomDragVegetation(void) {
 6670:       // UNFINISHED. CHECK THIS: XXXXX
 6671:       // How many kernels are needed? Why so many for loops?
 6672:       // Is the loop on sides needed?
 6673: 
 6674:       NODE(node);
 6675: 
 6676:       const int    kb      = node->kb;
 6677:       const double htot    = node->htot2(); 
 6678:       
 6679:       if (node->isDry) {
 6680:          // Default values for dry nodes
 6681:          node->veg_alpha_vert_mean = node->veg_alpha0;
 6682:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 6683: 
 6684:          return;
 6685:        
 6686:       }
 6687: 
 6688:       // Computes bottom drag Cd based on the selected nchi
 6689:       node->computeBottomDragCd();
 6690:       
 6691: 
 6692: 
 6693:       //   Bottom stress in m^2/s^2
 6694:       if (node->rho[kb + 1] >= -98.0)
 6695:       {
 6696:          const double mag_u = length(node->u2[kb + 1]);
 6697:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 6698: 
 6699:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 6700:          // !sediment erosion: this part needs more documentation
 6701:       }
 6702:     
 6703: 
 6704: 
 6705:       // Compute vegetation parameters
 6706:       //--------------------------------
 6707: 
 6708: 
 6709:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 6710:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 6711: 
 6712:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 6713:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 6714:          int kbin = 0; // bin index
 6715:          for (int k = kb; k < nvrt; k++) {
 6716:             // Computes node height above the bottom level
 6717:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 6718:             assert(false && "Vertical variation of vegetation not implemented");
 6719: 
 6720:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 6721:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 6722:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 6723:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 6724:             // } else {
 6725:             //    // Find the bin at which the current vertical level is
 6726:             //    while (kbin<nbins_veg_vert) {
 6727:             //       const double zn = node->z[kbin];
 6728:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 6729:             //          break;
 6730:             //       } // if
 6731:             //       kbin++;
 6732:             //    } // while
 6733:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 6734: 
 6735:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 6736:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 6737:                
 6738:             //    // Linear interpolation of the vegetation parameters
 6739:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 6740:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 6741:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 6742:             // } // if rl10
 6743: 
 6744:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 6745: 
 6746:          } // for k
 6747: 
 6748: 
 6749:       } else { // Ganthy (iveg==2)
 6750:       //  Modify canopy height, diameter, and density
 6751: 
 6752:          // Make sure there is vegetation on this node
 6753:          if (node->veg_h_unbent > 0.0) {
 6754:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 6755: 
 6756:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 6757:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 6758:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 6759: 
 6760:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 6761:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 6762:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 6763:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 6764:          } // if veg_h_unbent
 6765: 
 6766:          for (int k = 0; k < nvrt; k++) {
 6767:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 6768:          } // for k
 6769:       
 6770: 
 6771:       } // if iveg
 6772:      
 6773: 
 6774:       // Compute vertical mean of veg_alpha3D
 6775:       if (iveg != 0) {
 6776:          const double ztop = node->zTopCanopy(); // Top of the canopy
 6777:          double sum1=0.0;
 6778:          double sum2=0.0;
 6779:          // Integrate over each level under the canopy...
 6780:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 6781:             const double Dz = node->Dz(k);
 6782: 
 6783:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 6784:             sum2 += Dz;
 6785: 
 6786:          } // for k
 6787:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 6788:          else             node->veg_alpha_vert_mean = sum1/sum2;
 6789: 
 6790:       } // if iveg
 6791: 
 6792:    }
 6793: 
 6794: 
 6795:    __global__ void computeTurbulence(void) {
 6796: 
 6797:       NODE(node);
 6798: 
 6799:       // Calls the templated function to compute the turbulence model parameters.
 6800:       // turbulenceModel is just a class enum version of itur.
 6801:       computeTurbulenceModel<turbulenceModel>(node);
 6802:       
 6803:    }
 6804: 
 6805: 
 6806:    __global__ void computeVegetationAndDragParameters(void) {
 6807:       // Computes the vegetation and drag model parameters:
 6808:       // chi, \tilde\chi, beta, \breve{H}
 6809:       
 6810:       SIDE(side);
 6811: 
 6812:       side->hhat = 0.0;
 6813:       side->chi2 = 0.0;
 6814:       side->chi = 0.0;
 6815:       side->veg_c2 = 0.0;
 6816:       side->veg_beta = 0.0;
 6817: 
 6818:       if (side->isDry) return;
 6819: 
 6820:       const double htot = side->htot2();
 6821:       const int    kb   = side->kb;
 6822: 
 6823:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 6824: 
 6825:       const double veg_h     = side->veg_h();
 6826:       const double veg_nv    = side->veg_nv();
 6827:       const double veg_c     = side->veg_c();
 6828:       const double veg_beta  = side->veg_beta;
 6829:       const double veg_alpha = side->veg_alpha_vert_mean();
 6830: 
 6831:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX recommended to change names, chi->chitilde, chi2->chi
 6832:       // Velocity magnitude at the bottom level
 6833:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0 - dt*swild2(k,1) to u2 (I think this only pertains to iupwind_mom \= 0)
 6834:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 6835:       side->chi2 = side->Cd()*vmag1;
 6836:       side->chi  = side->chi2;
 6837: 
 6838:       if constexpr(iveg != 0) {
 6839:          const Node *n1 = side->n1;
 6840:          const Node *n2 = side->n2;
 6841:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 6842:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 6843:       }
 6844: 
 6845:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 6846: 
 6847:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 6848:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 6849:       double magUa = 0.0;
 6850:       if constexpr(iveg != 0) {
 6851:          if (side->is3D() && veg_h > 0.0) {
 6852:             // 3D wet side with veg...
 6853: 
 6854:             double magUa = 0.0;
 6855:             for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 6856:                if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 6857: 
 6858:                   // Velocity magnitude must be computed at the center of each level to perform the integration.
 6859:                   // The tricky part is to compute that velocity at the level that may be partially submerged.
 6860:                   const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 6861: 
 6862:                   // Velocity magnitude at the top (h) of the level (may be partially submerged)
 6863:                   const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 6864: 
 6865:                   // Velocity magnitude at the bottom (l) of the level
 6866:                   const double ul = length(side->u2[k]);
 6867: 
 6868:                   const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 6869:                   magUa += Dz*0.5*(uh + ul);
 6870: 
 6871:                } // if HasVegetation
 6872:             } // for k
 6873:             const double ua = magUa/min(htot, veg_h); // Vertical average
 6874: 
 6875:             // Computes beta, used for computing the stress term at the top of the canopy.      
 6876:             side->veg_c2 = veg_alpha*dt*ua; // >=0
 6877:             if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 6878:                const double zCpy = side->zTopCanopy();
 6879:                const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 6880:                const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 6881:                const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 6882:                const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 6883:                side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 6884:             } // if isSubmerged
 6885:          } // if is3D
 6886:       } // if iveg   
 6887: 
 6888:       // Computes the friction modified depth, \breve{H} in notes
 6889:       if (side->is2D()) { // 2D
 6890: 
 6891:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 6892:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 6893: 
 6894:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 6895: 
 6896:          side->hhat = htot*htot/fricH; 
 6897: 
 6898:       } else { // 3D
 6899:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 6900: 
 6901:          if constexpr(iveg != 0) {
 6902:             
 6903:             if (side->isSubmerged()) { 
 6904:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 6905:                side->hhat -= veg_c*Hhat_alpha;
 6906: 
 6907:             } else { // Emergent
 6908:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 6909:             }
 6910:          } // if iveg
 6911: 
 6912:          // Enforce positivity for 3D model
 6913:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 6914:       } // if 3D
 6915: 
 6916:    }
 6917: 
 6918: 
 6919: 
 6920:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 6921:    // Computes the density gradient between two elements, e1 and e2.
 6922:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 6923:    // zero in the direction normal to the side. 
 6924:    // 
 6925:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 6926:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 6927:    //
 6928:    // Input:
 6929:    //    e1: Element
 6930:    //    e2: Neighbor element (or nullptr if boundary)
 6931:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 6932:    //    k: Index of the half-level at which the density is interpolated
 6933:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 6934:    // 
 6935:    // Output:
 6936:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 6937:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 6938: 
 6939:       if (e2 == nullptr || e2->isDry) {
 6940:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 6941: 
 6942:          Side *side = e1->sides[j];
 6943:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 6944:                  
 6945:          if constexpr(ics == 1) {
 6946:             vec = side->n; // Normal vector to the side
 6947:          } else {
 6948:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6949:             // IMPLEMENT THIS XXXXXX
 6950:             // !replace with xel, yel?
 6951:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 6952:             //      &eframe(:,:,i),xn1,yn1,tmp)
 6953:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 6954:             //      &eframe(:,:,i),xn2,yn2,tmp)
 6955:          } //ics
 6956:                    
 6957:          diffRho = 0.0;
 6958: 
 6959:       } else { //internal and wet
 6960:          if constexpr(ics==1) {
 6961:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 6962: 
 6963:             // Vector from e1 to e2
 6964:             vec = e2->center - e1->center;
 6965: 
 6966:          } else { 
 6967:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6968:             // Remember that elem->center is in global coordinates
 6969:             // IMPLEMENT THIS XXXXXX
 6970:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 6971:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 6972:             //                   alow(j)=xctr2
 6973:             //                   bdia(j)=yctr2
 6974:          } // ics
 6975: 
 6976:          diffRho = rho2 - e1->demeanedDensity(k);
 6977:       }
 6978: 
 6979:    }
 6980: 
 6981:    __global__ void computeDensityCubicSplines(void) {
 6982:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 6983: 
 6984:       ELEM(elem);
 6985: 
 6986:       if (elem->isDry) return;
 6987: 
 6988:       const int kb = elem->kb;
 6989: 
 6990:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 6991:       if (elem->is2D()) {
 6992:          // In the 2D case, the density is constant at the prism level. 
 6993:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 6994:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 6995:       } else { //3D
 6996: 
 6997:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 6998:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 6999:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 7000:          ///// XXXX CHECK INDICES!!!!!
 7001:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 7002:       } // 2D/3D
 7003: 
 7004:    }
 7005: } // extern "C"
 7006: 
 7007: 
 7008: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 7009: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 7010: 
 7011:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 7012: 
 7013:    const int kb  = elem->kb;
 7014:    const int kb2 = elem2->kb;
 7015: 
 7016:    // z-coordinate of prism of elem
 7017:    const double zp = elem->z_prism(k);
 7018: 
 7019:    double rho = 0.0;
 7020: 
 7021:    if (elem2->is2D()) {
 7022:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 7023: 
 7024:    } else {  // 3D
 7025: 
 7026:       // eta_min may be < zmax
 7027:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 7028:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 7029: 
 7030:       // (Extrapolate density below bottom, we will fix it later)
 7031:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 7032:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 7033:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 7034:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 7035:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 7036:    } // 2D/3D
 7037:      
 7038: 
 7039:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 7040:    // Now we need to fix it.
 7041:    if (elem->z[k] < elem2->z[kb2]) {
 7042:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 7043: 
 7044:       // There are two methods to adjust the density at the bottom of the element.
 7045:       // iunder_deep=0: 
 7046:       const double depth1 = abs(elem->z[kb]); // larger depth
 7047: 
 7048:       if (iunder_deep==0) {
 7049: 
 7050:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 7051: 
 7052:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 7053: 
 7054:       } else { // iunder_deep != 0
 7055: 
 7056:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 7057: 
 7058:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 7059: 
 7060:          //   Demeaned density at the same z coordinate as
 7061:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 7062:          }
 7063: 
 7064:       } // if iunder_deep
 7065:    } // if elem->z[kb] < elem2->z[kb]
 7066: 
 7067:    return rho;
 7068: }
 7069: 
 7070: 
 7071: extern "C" {
 7072:    __global__ void computeDensityGradient(void) {
 7073: 
 7074:       assert(ibc == 1 && "baroclinic formulation is not implemented yet: ibc != 0");
 7075:       if constexpr(ibc != 0) return;
 7076: 
 7077:          // Compute the horizontal density gradient at each element.
 7078:       // It works in two steps:
 7079:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 7080:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 7081:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 7082:       //             gradRho.r1 = rho1 - rho0
 7083:       //             gradRho.r2 = rho2 - rho0
 7084:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 7085:       // 
 7086:       //  NOTE: We use de-meaned densities.
 7087: 
 7088:       ELEM(elem);
 7089: 
 7090:       if (elem->isDry) return;
 7091: 
 7092:       const int kb  = elem->kb;
 7093:       const int i34 = elem->i34;
 7094: 
 7095:       for (int k = kb + 1; k < nvrt; k++) {
 7096:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 7097:          //             gradRho.r1 = rho1 - rho0
 7098:          //             gradRho.r2 = rho2 - rho0
 7099:          int icount = 0;
 7100:          double sumRx = 0.0;
 7101:          double sumRy = 0.0;
 7102:          for (int j1=0; j1<i34; j1++) { 
 7103: 
 7104:             const int j2 = elem->nxq(j1 + 1);
 7105: 
 7106:             // Pairs of consecutive neighbor elements of elem
 7107:             const Element *e1 = elem->nghbElems[j1];
 7108:             const Element *e2 = elem->nghbElems[j2];
 7109: 
 7110:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 7111:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 7112:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 7113: 
 7114:             // Compute the density difference and the vector from elem to e1 and e2
 7115:             // getRhoDiffAndVec takes into account boundaries/dry elements
 7116:             double diffRho1, diffRho2;
 7117:             Vector2 vec1, vec2;
 7118:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 7119:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 7120: 
 7121:             const double rl1 = length(vec1);
 7122:             const double rl2 = length(vec2);
 7123:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 7124: 
 7125:             const double delta = cross(vec1, vec2);
 7126:             const double sintheta = abs(delta)/(rl1*rl2);
 7127: 
 7128:             // To avoid problems, avoid elements with small angle between vectors
 7129:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 7130:             const bool validEq = (sintheta > sin_one_deg);
 7131: 
 7132:             if (validEq) {
 7133:                // Solve the system of equations to get the density gradient at elem
 7134:                icount++;
 7135:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 7136:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 7137:                sumRx += Rx;
 7138:                sumRy += Ry;
 7139:             }
 7140:          } // for j1
 7141: 
 7142:          // Compute the average density gradient at elem
 7143:          if (icount==0) {
 7144:            // Bad mesh quality; bail out with 0 b-cc
 7145:            elem->gradRho[k] = {0.0, 0.0};
 7146:          } else {
 7147:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 7148:          }
 7149: 
 7150:       } // for k
 7151: 
 7152:    }
 7153: 
 7154:    __global__ void computeBaroclinicTerm(void) {
 7155:    // Computes the baroclinic term at sides (at half levels).
 7156:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 7157:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 7158: 
 7159:       if (ibc == 1) return;
 7160: 
 7161:       SIDE(side);
 7162: 
 7163:       if (side->isDry) return;
 7164: 
 7165:       const Element *e1 = side->elems[0];
 7166:       const Element *e2 = side->elems[1]; 
 7167:       const int kb = side->kb;
 7168:       
 7169:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 7170: 
 7171:       // interpolates vertically the density gradient of the two elements at the half level/
 7172: 
 7173:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 7174:       int k2 = max(kb, nvrt / 2);
 7175: 
 7176:       // Starts the integration at the surface and goes down to the bottom
 7177:       side->bcc[nvrt-1] = {0.0, 0.0};
 7178:       for (int k = nvrt - 2; k >= kb; k--) {
 7179:       // For each prism level (from surface to bottom)...
 7180: 
 7181:          // For both elements, interpolate density gradient at the side's half level.
 7182:          // The gradient at the side is the average of the gradients at the elements.
 7183:          // w1, w2 are used to take into account boundary sides, with just one element.
 7184:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 7185:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 7186:          const double wsum = w1 + w2;
 7187:          w1 = w1/wsum;
 7188:          w2 = w2/wsum;
 7189:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 7190: 
 7191:          // Linear interpolation of both elements' density gradient at the shared side's level.
 7192:          Vector2 gradRho = {0.0, 0.0};
 7193:          if (e1 != nullptr && k > kb) {
 7194:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 7195:             
 7196:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 7197:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 7198:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 7199: 
 7200:             // Grad(rho) vertically interpolated at the side's half level
 7201:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 7202: 
 7203:             // Projects the element density gradient to the side frame if needed.
 7204:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 7205: 
 7206:             // Adds the contribution of the density gradient at the side's half level
 7207:             gradRho += gradRho1*w1;
 7208:          }      
 7209:          if (e2 != nullptr && k > kb) {
 7210:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 7211:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 7212:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 7213:             
 7214:             // Grad(rho) vertically interpolated at the side's half level
 7215:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 7216: 
 7217:             // Projects the element density gradient to the side frame if needed.
 7218:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 7219: 
 7220:             // Adds the contribution of the density gradient at the side's half level
 7221:             gradRho += gradRho2*w2;
 7222:          }
 7223: 
 7224:          
 7225:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 7226:          // multiplied by -rampbc*(g/rho0) 
 7227:          const double grav3 = side->grav3();
 7228:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 7229: 
 7230:       } // for
 7231: 
 7232:    }
 7233: 
 7234: 
 7235: 
 7236:    __global__ void computeHorGradientAtSide(void) {
 7237: 
 7238:       // Compute the horizontal density gradient at each element.
 7239:       // It works in two steps:
 7240:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 7241:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 7242:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 7243:       //             gradRho.r1 = rho1 - rho0
 7244:       //             gradRho.r2 = rho2 - rho0
 7245:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 7246:       // 
 7247:       //  NOTE: We use de-meaned densities.
 7248: 
 7249:       SIDE(side);
 7250: 
 7251: 
 7252:       if (side->isDry) return;
 7253: 
 7254:       // Computes the gradient of the variables at the side center.
 7255:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 7256:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 7257:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 7258: 
 7259:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 7260:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 7261:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 7262:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 7263: 
 7264:    }
 7265: 
 7266: 
 7267:    __global__ void solveMomentumEquations(double time) {
 7268: 
 7269:       double alow[nvrt], cupp[nvrt], bdia[nvrt]; // a = low, c = up, b = diag
 7270:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 7271: 
 7272:       SIDE(side);
 7273: 
 7274:       if (side->isDry) 
 7275:       {
 7276:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 7277: 
 7278:          return;
 7279:       }
 7280: 
 7281:       const Node *n1 = side->n1;
 7282:       const Node *n2 = side->n2;
 7283: 
 7284:       const int kb = side->kb;
 7285: 
 7286:       const double veg_h = side->veg_h();
 7287:       const double grav3 = side->grav3();
 7288: 
 7289:       if (side->is2D()) {
 7290:          // Remember: Do not use htot2, which is updated.
 7291:          const double htot = side->htot1();
 7292:          const double hhat = side->hhat;
 7293: 
 7294:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 7295: 
 7296:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 7297:          const Vector2 tau2 = side->tau();
 7298: 
 7299:          // hat_gam has units of m/s
 7300: 
 7301:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 7302:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 7303:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 7304: 
 7305:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 7306: 
 7307: 
 7308:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 7309: 
 7310:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 7311: 
 7312:       }
 7313:       else { // 3D
 7314: 
 7315:          // For 3D it is necessary to solve an implicit tridiagonal system.
 7316:          // 
 7317:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 7318:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 7319:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 7320:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 7321:          // k+1 and k.
 7322: 
 7323: 
 7324:          const int ndim = nvrt - kb;
 7325:          const double zTopCanopy = side->zTopCanopy();
 7326: 
 7327:          // Initialize the tridiagonal system
 7328:          for (int k = kb + 1; k < nvrt; k++) {
 7329:             
 7330:             const int kin = k - (kb + 1);
 7331: 
 7332:  
 7333:             alow[kin] = 0.0;
 7334:             cupp[kin] = 0.0;
 7335:             bdia[kin] = 0.0;
 7336: 
 7337:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 7338:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 7339: 
 7340:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 7341:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 7342:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 7343: 
 7344:             // First part: layers k, k+1
 7345:             if (k < nvrt - 1) {
 7346:                              
 7347:                if constexpr(iveg != 0) {
 7348: 
 7349:                   // If there is vegetation at this level...
 7350:                   if (zTopCanopy > side->zc[k]) {
 7351:                      // If the canopy is above the k layer...
 7352:                      
 7353:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 7354:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 7355:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 7356:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 7357: 
 7358:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 7359:                      const double vmag2 = length(ut2);
 7360:                      const double vmag1 = length(side->u2[k]);
 7361:                      const double vmag = 0.5*(vmag1 + vmag2);
 7362:                      
 7363:                      // Computes the vegetation alpha at the face center
 7364:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 7365: 
 7366:                      cff1 += veg_alpha_sd*dt*vmag;
 7367: 
 7368:                   } // if (zTopCanopy
 7369:                } // if iveg
 7370: 
 7371:                const double dzz = side->Dz(k + 1);
 7372:                const double dfz = 0.5*(side->dfv(k) + side->dfv(k + 1)); // Vertical viscosity at the face center
 7373:                const double tmp = dt*dfz/dzz;
 7374:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 7375: 
 7376:                cupp[kin] += cff1*dzz/6.0 - tmp;
 7377:                bdia[kin] += cff1*dzz/3.0 + tmp;
 7378:             }
 7379: 
 7380: 
 7381:             // Second part: layers k-1, k
 7382:             if (k > kb + 1) {
 7383: 
 7384:                double cff1 = 1.0; //init \bar{c^k}
 7385: 
 7386:                if constexpr(iveg != 0) {
 7387:                   // If there is vegetation at this level...
 7388:                   if (zTopCanopy > side->zc[k-1]) {
 7389:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 7390:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 7391: 
 7392:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 7393: 
 7394:                      const double vmag2 = length(ut2);
 7395:                      const double vmag1 = length(side->u2[k-1]);
 7396:                      const double vmag = 0.5*(vmag1 + vmag2);
 7397: 
 7398:                      // Computes the vegetation alpha at the face center
 7399:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 7400:                      cff1 += veg_alpha_sd*dt*vmag;
 7401:                   } // if zTopCanopy
 7402: 
 7403:                } // if iveg
 7404: 
 7405:                const double dzz = side->Dz(k);
 7406:                const double dfz = 0.5*(side->dfv(k) + side->dfv(k - 1)); // Vertical viscosity at the face center
 7407:                const double tmp = dt*dfz/dzz;
 7408:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 7409: 
 7410:                alow[kin] += cff1*dzz/6.0 - tmp;
 7411:                bdia[kin] += cff1*dzz/3.0 + tmp;
 7412: 
 7413:             } else { // Bottom boundary
 7414:                // This occurs at the bottom, where the bottom drag is applied.
 7415: 
 7416:                bdia[kin] += dt*side->chi2; // XXXX
 7417: 
 7418:             } // if (k > kb + 1)
 7419: 
 7420: 
 7421:          } // for (int k
 7422: 
 7423: 
 7424: 
 7425:          // Computes the RHS.
 7426:          // -----------------
 7427: 
 7428:          //	BC to be imposed at the end.
 7429: 
 7430:          const Vector2 gradETP  = side->gradETP;
 7431:          const Vector2 gradPr   = side->gradPr;
 7432:          const Vector2 gradEta1 = side->gradEta1;
 7433:          const Vector2 gradEta2 = side->gradEta2;
 7434: 
 7435:          const Vector2 *btu = side->btu;
 7436:          const Vector2 *u2  = side->u2;
 7437:          const double coriolis = side->coriolis;
 7438:          const Vector2 *nuGradU = side->nuGradU;
 7439: 
 7440:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 7441:          for (int k = kb + 1; k < nvrt; k++) {
 7442:             const int kin = k - kb - 1;
 7443: 
 7444:             const double dz_0 = side->Dz(k);
 7445:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 7446: 
 7447:             rrhs[kin] = {0.0, 0.0};
 7448:             double dz = 0.0;
 7449: 
 7450:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 7451:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 7452:             if (k < nvrt  ) dz += dz_1;
 7453:             if (k > kb + 1) dz += dz_0;
 7454: 
 7455:             // Elevation gradient, atmospheric pressure and tidal potential
 7456:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 7457: 
 7458:             // Coriolis, advection, wind stress, and horizontal viscosity
 7459:             if (k < nvrt - 1) {
 7460: 
 7461: 
 7462:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 7463:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 7464:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 7465:                                                 
 7466: 
 7467:                //diff stress tensors 1006
 7468:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 7469:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 7470:                   assert(false && "Not implemented: itur == 5");
 7471:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 7472:                }
 7473:                // else assert(false && "itur # Not implemented");
 7474: 
 7475:             } else { // k == nvrt - 1 SURFACE
 7476:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 7477:                const Vector2 tau2 = side->tau();
 7478: 
 7479:                rrhs[kin] += dt*tau2;          
 7480: 
 7481:             } // if k<nvrt
 7482: 
 7483: 
 7484:             if (k > kb + 1) {
 7485:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 7486:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 7487:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 7488: 
 7489:                // diff stress tensors 1006
 7490:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 7491:                   assert(false && "Not implemented: itur == 5");
 7492:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 7493:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 7494:                }
 7495:                // else assert(false && "itur # Not implemented");
 7496: 
 7497: 
 7498:             } // if k>kbs + 1
 7499: 
 7500:             // Baroclinic
 7501:             Vector2 *bcc = side->bcc;
 7502:             if constexpr(ibc == 0) {
 7503:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 7504:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 7505: 
 7506:             } // if ibc==0
 7507: 
 7508:          } // k=kb + 1,nvrt
 7509: 
 7510: 
 7511:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 7512: 
 7513:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 7514:             const int kin = k - kb - 1;
 7515:    
 7516:             // Velocity is always clamped to maximum values
 7517:             side->u2[k] = clampVelocity(soln[kin]);
 7518:          } // k
 7519: 
 7520:       } // if side->is2D()
 7521:       
 7522: 
 7523:       // Impose velocity boundary condition at the bottom
 7524:       if constexpr(imm == 2) { // 3D bed deformation model
 7525:          double dep;
 7526:          Vector2 vel;
 7527: 
 7528:          assert(false && "Not implemented: imm == 2");
 7529:          //update_bdef(time, x0, y0, dep, vel);
 7530:          // side->u2[kb] = vel;
 7531: 
 7532:       } else { // imm = 0 or 1
 7533:          if (side->Cd() == 0.0) {
 7534:             side->u2[kb] = side->u2[kb + 1];
 7535: 
 7536:          } else if (side->is3D()) { // 3D no slip bottom   
 7537:             side->u2[kb] = {0.0, 0.0};
 7538: 
 7539:          }
 7540:           
 7541:       } // if imm
 7542: 
 7543:       // The velocities below the bottom level are set to zero
 7544:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 7545: 
 7546: 
 7547:    }
 7548: 
 7549: 
 7550:    __global__ void applyMomentumBC(void) {
 7551: 
 7552:       SIDE_BND(sideBnd);
 7553: 
 7554:       Side *side = sideBnd->side;
 7555:       const BoundarySegment *segment = sideBnd->segment;
 7556:       const Node *n1 = side->n1;
 7557:       const Node *n2 = side->n2;
 7558: 
 7559:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 7560: 
 7561:       const bool isLand = segment->isLand;
 7562:       const int ifltype = segment->ifltype;
 7563: 
 7564:       const int kb = side->kb;
 7565: 
 7566: 
 7567:       if (!isLand && ifltype != 0) {
 7568:          const Vector2 *ubc = sideBnd->ubc;
 7569:   
 7570:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 7571:             
 7572:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 7573:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 7574: 
 7575:             if (ifltype == -1) {
 7576:                // Flather 1
 7577: 
 7578:                const double depth = side->depth();
 7579: 
 7580:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 7581: 
 7582:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 7583: 
 7584:                side->u2[k] = vnorm*side->n;
 7585: 
 7586:             } else if (ifltype == -2) { // Discharge
 7587: 
 7588:                const double eta1 = side->eta1();
 7589:                const double eta2 = side->eta2();
 7590:                const double htot = side->htot2();
 7591: 
 7592:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 7593:                assert(false && "Not implemented: Discharge bc");
 7594:                // const double dischrg = discharge(eta1);
 7595:                const double dischrg = 0.0; // XXX REMOVE
 7596:                
 7597: 
 7598:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 7599: 
 7600:                const double vnorm = dischrg*eta2/htot;
 7601: 
 7602:                side->u2[k] = vnorm*side->n;
 7603: 
 7604:             }
 7605:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 7606:                const double vnorm = dot(side->u2[k], side->n);
 7607: 
 7608:                double rat;
 7609:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 7610:                else              rat = segment->vobc2; // outgoing
 7611: 
 7612:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 7613: 
 7614:             }
 7615:             else { // not Flather or 3D radiation
 7616: if (ifltype == 2) printf("XXXXX ubc: %f, %f\n", ubc[k].x, ubc[k].y);
 7617:                side->u2[k] = ubc[k];
 7618: 
 7619:             } // if (segment->ifltype...
 7620: 
 7621:          }
 7622: 
 7623:       }
 7624:       else if (isLand) { // if it is land boundary side
 7625: 
 7626:          if constexpr(islip == 0) { // free slip
 7627: 
 7628:             for (int k = kb; k < nvrt; k++) {
 7629: 
 7630:                const Vector2 t = side->t();
 7631:                const Vector2 n = side->n;
 7632: 
 7633:                double vnorm = 0.0; // for most cases
 7634:                const double vtan = dot(side->u2[k], t);
 7635:                
 7636:                side->u2[k] = vtan*t - vnorm*n;
 7637: 
 7638:             }
 7639: 
 7640:          } else { // no slip
 7641:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 7642: 
 7643:          }
 7644:       } // if (side segment type...
 7645: 
 7646:    }
 7647: 
 7648: 
 7649:    __global__ void shapiroFilter1(void) {
 7650:       // First step of the Shapiro filter (normally used if indvel<=0)
 7651:       // Computes the filtered values and stores them in bcc (as a temporary array).
 7652: 
 7653:       SIDE(side);
 7654: 
 7655:       // Only internal wet sides are processed
 7656:       if (side->isDry || !(side->isInternal())) return;
 7657: 
 7658:       const int kb = side->kb;
 7659: 
 7660:       for (int mm = 0; mm < niter_shap; mm++) {
 7661: 
 7662:          for (int k = kb + 1; k < nvrt; k++) {
 7663:             // WARNING: reusing bcc as a temporary array to store the suru values.
 7664:             Vector2 suru = {0.0, 0.0};
 7665: 
 7666:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 7667: 
 7668:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 7669: 
 7670:                int kin = k;
 7671:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 7672:                
 7673:                // Get the velocity at the neighbor's side.
 7674:                Vector2 nSideU2 = nSide->u2[kin];
 7675: 
 7676:                // Projects the velocity to the current side frame if needed.
 7677:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 7678: 
 7679:                suru += nSideU2;
 7680:             }
 7681: 
 7682:             // Reusing bcc as a temporary array to store the suru values.
 7683:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 7684: 
 7685:          }
 7686:       }
 7687:    }
 7688: 
 7689:    __global__ void shapiroFilter2(void) {
 7690:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 7691: 
 7692:       SIDE(side);
 7693: 
 7694: 
 7695:       if (side->isDry || !(side->isInternal())) return;
 7696: 
 7697:       const int kb = side->kb;
 7698: 
 7699:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 7700: 
 7701:       if (side->is2D()) {
 7702:          side->u2[kb + 1] = side->bcc[kb + 1];
 7703:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 7704: 
 7705:       } else {
 7706:          // 3D
 7707:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 7708:          
 7709:       }
 7710: 
 7711:    }
 7712: 
 7713: 
 7714:    __global__ void ul0UpdateZCoords(void) {
 7715:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 7716:       
 7717:       NODE(node);      
 7718: 
 7719: 
 7720:       if (false) { //node->isDry) { XXXXXXX
 7721: 
 7722:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 7723: 
 7724:          if constexpr(ivcor != 1) node->kb = 0;
 7725: 
 7726:       } else {
 7727: 
 7728:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 7729:          node->updateKb();
 7730: 
 7731:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 7732: 
 7733:       }
 7734: 
 7735:       // We use the temp.b field to store the previous state of isDry.
 7736:       node->tmp.b = node->isDry;
 7737: 
 7738:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 7739:       node->isDry = true;
 7740: 
 7741:    }
 7742: 
 7743:    __global__ void ul0ComputeDryElements(void)
 7744:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 7745:    {
 7746:       ELEM(elem);
 7747: 
 7748:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 7749: 
 7750:       elem->kb = 0;
 7751: 
 7752:       if (elem->isDry) return;
 7753: 
 7754: 
 7755:    //    if(elem->isDry2()) { // XXXX
 7756:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 7757:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 7758:    //        call parallel_abort(errmsg)
 7759:    //    }
 7760: 
 7761:       const Node *n1 = elem->nodes[0];
 7762:       const Node *n2 = elem->nodes[1];
 7763:       const Node *n3 = elem->nodes[2];  
 7764:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 7765: 
 7766:       // Computes element's kb as the minimum of the nodes' kb.
 7767:       const int kb1 = n1->kb;
 7768:       const int kb2 = n2->kb;
 7769:       const int kb3 = n3->kb;
 7770:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 7771: 
 7772: 
 7773:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 7774: 
 7775: 
 7776:       // Computes the element z as the mean of the nodes z.
 7777:       for (int k = elem->kb; k < nvrt; k++) {
 7778: 
 7779:          // Compute the element z as the mean of the nodes z.
 7780:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 7781:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 7782:          elem->z[k] /= elem->i34;
 7783: 
 7784:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 7785:       }
 7786:                   
 7787:    }
 7788: 
 7789:    __global__ void ul0ComputeDryNodes(void)
 7790:    // Updates node's isDry based on the elements' isDry. 
 7791:    {
 7792:       NODE(node);
 7793: 
 7794:       node->isDry = true;
 7795: 
 7796:       // A node is wet if at least one of the elements sharing it is wet.
 7797:       for (int j = 0; j < node->numElements; j++) {
 7798:          const Element *elem = node->elements[j];
 7799:          if (!elem->isDry) {
 7800:             node->isDry = false;
 7801:             break;
 7802:          }
 7803:       }
 7804: 
 7805:        
 7806:    }
 7807: 
 7808: 
 7809:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 7810:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 7811:    // node->tmp.b is true if the node was previously dry.
 7812:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 7813:    {
 7814:       NODE(node);
 7815:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 7816: 
 7817:       // Avoid this the first time step.
 7818:       if (it == iths) return;  
 7819: 
 7820:       const bool wasDry = node->tmp.b;
 7821: 
 7822: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 7823: 
 7824:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 7825: 
 7826:          for (int k=0; k < nvrt; k++) {
 7827: 
 7828:             Vector3 utmp={0.0, 0.0, 0.0};
 7829: 
 7830:             double ttmp=0.0;
 7831:             double stmp=0.0;
 7832:             int icount=0;
 7833:             for (int j = 0; j < node->numNodes; j++) {
 7834: 
 7835:                const Node *nbrNode = node->nodes[j];
 7836:                
 7837:                const bool wasNbrDry = nbrNode->tmp.b;
 7838: 
 7839:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 7840:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 7841: 
 7842:                   icount++;
 7843: 
 7844:                   // Assume small element size in wet/dry zone so pframes are close to each other
 7845:                   utmp += nbrNode->uvw2(k);
 7846:                   
 7847:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 7848:                   stmp += nbrNode->tracers[k].tracer[1]; 
 7849:                }
 7850:             }
 7851: 
 7852:             if (icount > 0) {
 7853:                const double inv_icount = 1.0/icount;
 7854:                utmp = inv_icount*utmp;
 7855:                node->u2[k]     = {utmp.x, utmp.y};
 7856:                node->w2[k]     = utmp.z;
 7857:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 7858:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 7859:             } else {
 7860:                node->u2[k] = {0.0, 0.0};
 7861:                node->w2[k] = 0.0;
 7862:                // Initialize tracers to 0.0??? XXXXX
 7863:             }
 7864:          }
 7865:       }
 7866:    }
 7867: 
 7868:   
 7869:    
 7870: 
 7871: 
 7872:    __global__ void ul0UpdateSides(int it, int iths) {
 7873:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 7874:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 7875:    // The dryness of the sides is updated in ul0UpdateSides2.
 7876: 
 7877:       SIDE(side);
 7878: 
 7879:       // A side is wet if and only if at least one of its elements is wet.
 7880:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 7881:  
 7882:       const Node *n1 = side->n1;
 7883:       const Node *n2 = side->n2;
 7884:      
 7885:       const int kb1 = n1->kb;
 7886:       const int kb2 = n2->kb;
 7887: 
 7888:       side->kb = 0; // default when dry
 7889: 
 7890:       if (isWet) {
 7891: 
 7892:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 7893: 
 7894:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 7895: 
 7896:          side->kb = min(kb1, kb2);
 7897: 
 7898:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 7899: 
 7900:          for (int k = side->kb; k < nvrt; k++) {
 7901:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 7902: 
 7903:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 7904: 
 7905:             // Compute velocity for re-wetted sides 
 7906:             if ((it != iths) && (side->isDry && isWet)) {
 7907: 
 7908:                Vector2 utmp={0.0, 0.0};
 7909: 
 7910:                int icount=0;
 7911: 
 7912:                // For all the sides on the two elements that share this side
 7913:                for (int j = 0; j < 2; j++) {
 7914:                   const Element *elem = side->elems[j];
 7915:                   if (elem == nullptr) continue;
 7916: 
 7917:                   for (int jj=0; jj < elem->i34; jj++) {
 7918:                      const Side *nSide = elem->sides[jj];
 7919:                      if (nSide->isDry) continue;
 7920: 
 7921:                      icount++;
 7922:                      utmp += nSide->u2[k];  
 7923:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 7924:                   }
 7925:                }
 7926:                   
 7927:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 7928:                if (icount > 0)  side->u2[k] = utmp/icount;
 7929:                else             side->u2[k] = {0.0, 0.0};
 7930:                   
 7931:             } // if ((it != iths) && (side->isDry && isWet))
 7932: 
 7933:          } // for k
 7934: 
 7935:       } // if isWet 
 7936:       
 7937: 
 7938: 
 7939:    }
 7940: 
 7941:    __global__ void ul0UpdateSides2(void) {
 7942:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 7943:    
 7944:          SIDE(side);
 7945:    
 7946:          const Element *e1 = side->elems[0];
 7947:          const Element *e2 = side->elems[1];
 7948: 
 7949:          // A side is wet if and only if at least one of its elements is wet.
 7950:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 7951: 
 7952:          // Update the side's dryness
 7953:          side->isDry = !isWet;
 7954: 
 7955:    }
 7956: 
 7957: 
 7958:    __global__ void zeroNodalVelocities(void) {
 7959:       NODE(node);
 7960: 
 7961:       for (int k = 0; k < nvrt; k++) {
 7962:          node->u2[k]   = {0.0, 0.0};
 7963:          node->w2[k]   = 0.0;
 7964:          node->utmp[k] = {0.0, 0.0};         
 7965:       }
 7966:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 7967:    }
 7968:  
 7969: 
 7970:    __global__ void computeNodalVerticalVelocities1(void) {
 7971:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7972:    // Adds the element's vertical velocity times the element's area.
 7973:       ELEM(elem);
 7974: 
 7975:       for (int j = 0; j < elem->i34; j++) {
 7976:          Node *node = elem->nodes[j];
 7977: 
 7978:          for (int k = node->kb; k < nvrt; k++) {
 7979:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 7980:          }
 7981:          atomicAdd(&(node->tmp.d), elem->area);
 7982:       }
 7983:    }
 7984: 
 7985:    __global__ void computeNodalVerticalVelocities2(void) {
 7986:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7987:    // Divides by the total area of the elements sharing the    node.
 7988:       NODE(node);
 7989: 
 7990: 
 7991:       const double invArea = 1.0 / node->tmp.d;
 7992:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = invArea*node->w2[k];  // node->tmp.d contains the total area of the elements sharing the node
 7993: 
 7994:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 7995:    }
 7996: 
 7997: 
 7998:    __global__ void computeNodalHorizontalVelocities1(void) {
 7999: 
 8000:       assert(indvel <= 0 && "computeNodalHorizontalVelocities1 only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 8001: 
 8002:       ELEM(elem);
 8003: 
 8004:       if (elem->isDry) return;
 8005: 
 8006:       const int kb = elem->kb;
 8007:       const bool isTri = elem->isTri();
 8008: 
 8009:       if constexpr(indvel <= 0) {
 8010:          // Assuming discontinous hvel.
 8011: 
 8012:          if (isTri) { // For triangles
 8013:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 8014:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 8015:             #pragma unroll
 8016:             for (int j = 0; j < 3; j++) {
 8017:                // For every node of the triangle...
 8018:                Node *node = elem->nodes[j];
 8019: 
 8020:                if (node->isDry) continue;
 8021: 
 8022:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 8023:                const Side *s2 = elem->sides[(j + 1) % 3];
 8024:                const Side *s3 = elem->sides[(j + 2) % 3];
 8025: 
 8026:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 8027: 
 8028:                atomicAdd(&(node->tmp.i), 1);
 8029: 
 8030:                for (int k = kb; k < nvrt; k++)  {
 8031:                   Vector2 s1u2 = s1->u2[k];
 8032:                   Vector2 s2u2 = s2->u2[k];
 8033:                   Vector2 s3u2 = s3->u2[k];
 8034: 
 8035:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 8036:                   if constexpr(ics == 2) {
 8037:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 8038:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 8039:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 8040:                   }
 8041: 
 8042:                   Vector2 u = s2u2 + s3u2 - s1u2; // u extrapolated linearly at node j.   
 8043:                   u = clampVelocity(u);
 8044:                   atomicAdd(&(node->utmp[k].x), u.x);
 8045:                   atomicAdd(&(node->utmp[k].y), u.y);
 8046: 
 8047:                }
 8048: 
 8049:             }
 8050:          }
 8051:          else { // For quads
 8052: 
 8053: 
 8054:             // Compute the bilinear coordinates of the center of each diagonal.
 8055:             double xi, eta;
 8056:             double shp13[4], shp24[4];
 8057:             Point2 x0, x1, x2, x3;
 8058:             elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 8059:             const Point2 p13 = 0.5 * (x0 + x2);   // Center of sides 1 & 3
 8060:             const Point2 p24 = 0.5 * (x1 + x3);   // Center of sides 2 & 4
 8061: 
 8062:             elem->inverseBilinearQuad(p13, xi, eta, shp13);
 8063:             elem->inverseBilinearQuad(p24, xi, eta, shp24);
 8064: 
 8065: 
 8066: 
 8067: 
 8068:             for (int k = kb; k < nvrt; k++) {
 8069: 
 8070:                //Each quad is split into two triangles. For each triangle we extrapolate as we did for triangles.
 8071:                Vector2 sideU[4];
 8072:                #pragma unroll
 8073:                for (int j = 0; j < 4; j++) {
 8074:                   Vector2 u = elem->sides[j]->u2[k];
 8075:                   if constexpr(ics == 2) u = elem->sides[j]->frame.projHorVec(u, elem->frame);
 8076:                   sideU[j] = u;
 8077:                }
 8078: 
 8079:                Vector2 ud1 = shp13[0]*sideU[0] + shp13[1]*sideU[1] + shp13[2]*sideU[2] + shp13[3]*sideU[3];
 8080:                Vector2 ud2 = shp24[0]*sideU[0] + shp24[1]*sideU[1] + shp24[2]*sideU[2] + shp24[3]*sideU[3];
 8081: 
 8082:                Vector2 ufg0 = clampVelocity(sideU[2] + sideU[3] - ud2);  // node 1: sides 3,4
 8083:                Vector2 ufg1 = clampVelocity(sideU[0] + sideU[3] - ud1);  // node 2: sides 1,4
 8084:                Vector2 ufg2 = clampVelocity(sideU[0] + sideU[1] - ud2);  // node 3: sides 1,2
 8085:                Vector2 ufg3 = clampVelocity(sideU[1] + sideU[2] - ud1);  // node 4: sides 2,3
 8086:                const Vector2 ufg[4] = {ufg0, ufg1, ufg2, ufg3};
 8087:                #pragma unroll
 8088:                for (int j = 0; j < 4; j++) {
 8089:                   Node *node = elem->nodes[j];
 8090:                   if (node->isDry) continue;
 8091: 
 8092:                   if (k == kb) atomicAdd(&(node->tmp.i), 1);
 8093:                   atomicAdd(&(node->utmp[k].x), ufg[j].x);
 8094:                   atomicAdd(&(node->utmp[k].y), ufg[j].y);
 8095:                }
 8096:             }
 8097: 
 8098:          }
 8099: 
 8100:       }
 8101:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 8102:       
 8103:    }
 8104: 
 8105: 
 8106:    __global__ void computeNodalHorizontalVelocities2(void) {
 8107:       NODE(node);
 8108: 
 8109:       const int nodeCount = node->tmp.i;
 8110: 
 8111:       if (nodeCount == 0) 
 8112:       {
 8113:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 8114:          return;
 8115:       }
 8116: 
 8117:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 8118:       
 8119:       const int kb = node->kb;
 8120: 
 8121:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 8122:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 8123:       
 8124:       
 8125:    }   
 8126: 
 8127:  
 8128: 
 8129:    __global__ void resetVelocityOpenBndNodes(void) {
 8130:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 8131: 
 8132:       NODE_BND(nodebnd);
 8133: // printf("DDDDDDDDDD\n");  // XXXXXXX
 8134:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 8135:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 8136:       }
 8137: 
 8138:    }
 8139: 
 8140: 
 8141:    __global__ void setVelocityOpenBndNodes(void) {
 8142:    // For open boundary nodes sets their velocity to the imposed values.
 8143: 
 8144:       SIDE_BND(sidebnd);
 8145: 
 8146:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 8147:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 8148:          // to its segment to the average of the side velocity.
 8149: 
 8150:          for (int k = 0; k < nvrt; k++) {
 8151:             Node *n1 = sidebnd->side->n1;
 8152:             Node *n2 = sidebnd->side->n2;
 8153: 
 8154: 
 8155:             Vector2 &n1_u2 = n1->u2[k];
 8156:             Vector2 &n2_u2 = n2->u2[k];
 8157: 
 8158:             if (n1->nodeBnd->segment == sidebnd->segment) {
 8159:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 8160:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 8161:             }
 8162:             if (n2->nodeBnd->segment == sidebnd->segment) {
 8163:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 8164:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 8165:             }
 8166: 
 8167:          }
 8168: 
 8169:       }
 8170: 
 8171:    }
 8172: 
 8173: 
 8174:    __global__ void computeVerticalVelocity(void) {
 8175:       // Computes the vertical velocity at the (2D) element's centroid.
 8176:       // In this function we will be considering volumetric elements, with side faces and a 
 8177:       // bottom and a top face. We will call them SFs, BF and TF.
 8178:       // It computes the flux coming from BF and the SFs.
 8179:       // If the bed is moving, it takes that into account.
 8180:       // Since water is incompressible, the integral of the velocity times the normal vector
 8181:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 8182:       // and the BF is equal to the flux going out from the TF.
 8183:       // TF = - BF - sum(SFs).
 8184:       // It then computes the horizontal velocity at the center of TF.
 8185:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 8186:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 8187:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 8188: 
 8189:       ELEM(elem);
 8190: 
 8191:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 8192: 
 8193:       if (elem->isDry) return;
 8194: 
 8195:       const int kb = elem->kb;
 8196:       const bool isTri = elem->isTri();
 8197: 
 8198:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 8199: 
 8200:       // Compute the bottom velocity
 8201:       if constexpr(imm != 0) {
 8202:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 8203:       }
 8204: 
 8205: 
 8206:       double bottomArea3D;
 8207:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 8208: 
 8209:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 8210: 
 8211:       double topArea3D;
 8212: 
 8213:       // Bottom face flux
 8214:       double bottomFlux = 0.0;
 8215:       Vector2 u2meanBottom = {0.0, 0.0};
 8216:       const Vector2 gradh = elem->grad2(&Node::depth);
 8217:       if constexpr(imm==2) {
 8218:          Vector3 ubed;
 8219: 
 8220:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 8221:          // updateBDEF(ubed);
 8222:      
 8223:          // const double bflux0 = dot(ubed, elem_bottom_n);
 8224: 
 8225:          // elem->w[kb] += ubed.z;
 8226:       }
 8227:       else {
 8228: 
 8229:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 8230:   
 8231:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 8232:          // in the direction of motion.
 8233:          const double bottomW = - dot(gradh, u2meanBottom);  
 8234:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 8235: 
 8236:          // VElocity associated to the bed deformation
 8237:          double bedVelocity = 0.0;
 8238:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 8239: 
 8240:          elem->w[kb] = bedVelocity + bottomW; 
 8241: 
 8242:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 8243:          
 8244:       } // if imm
 8245: 
 8246:       // Compute w for kb+1 to nvrt-1
 8247:       for (int l = kb; l < nvrt - 1; l++) {
 8248: 
 8249:          // normal vector to the top face of the "volumetric" element (3D)
 8250:          Vector3 elem_top_n = elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 8251: 
 8252:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 8253:          assert(elem_top_n.z > 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 8254: 
 8255:          // Compute the total flux at the sides
 8256:          double sideFlux = 0.0;
 8257: 
 8258:          for (int j = 0; j < elem->i34; j++) {
 8259:             const Side *side = elem->sides[j];
 8260:             const int kbs = side->kb;
 8261:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 8262:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 8263:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 8264: 
 8265:             // The area is "clamped" meaning that it takes kb into account.
 8266:             const double sideArea = side->areaClamped(l + 1);
 8267: 
 8268:             const double sign = elem->ssign[j]; 
 8269: 
 8270:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 8271:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 8272:          }
 8273:          
 8274:          // Compute the horizontal velocity at the center of the top face as an average of the 
 8275:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 8276:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 8277: 
 8278:          // The flux at the top ace can be computed from the other flows.
 8279:          // All fluxes are in directions into the prism.
 8280:          const double topFlux = - sideFlux - bottomFlux;
 8281: 
 8282:          // Flux at the top face due to the horizontal velocities only
 8283:          // topFlux = topHorizontalFlux + topVerticalFlux
 8284:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 8285: 
 8286:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + sideFlux + bottomFlux = 0, so:
 8287:          const double topVerticalFlux = topFlux - topHorizontalFlux;  
 8288: 
 8289:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 8290: 
 8291:          bottomFlux = -topFlux;
 8292:          
 8293:       }
 8294: 
 8295:    }  
 8296: 
 8297: 
 8298: 
 8299: 
