 2078: /**
 2079:    Compute the shape coordinates of the point (xt,yt) in the element.
 2080:    @param xt (input): x-coordinate of the point
 2081:    @param shpCoords (output): shape coordinates of the point
 2082:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2083:    @return true if the point is inside the element, false otherwise
 2084: **/
 2085: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2086:                                             bool fixNegshpCoord) const {
 2087: 
 2088:    // Compute the shape coordinates of the point xt in the element.
 2089:    if (i34==3) {
 2090:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2091:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2092:       // and in this case, the pt will be nudged into the element
 2093:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2094:       // from the local frame, so use additional check.
 2095: 
 2096:       Point2 x0, x1, x2;
 2097: 
 2098:       if constexpr(ics==1) {
 2099:          x0 = nodes[0]->p2();
 2100:          x1 = nodes[1]->p2();
 2101:          x2 = nodes[2]->p2();
 2102:       }
 2103:       else // lat/lon
 2104:       {
 2105:          Error("Not implemented yet");
 2106: #ifdef ICS2
 2107:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2108:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2109:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2110: #endif
 2111:       }
 2112: 
 2113:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2114:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2115:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2116:       shpCoords[3] = 0.0;
 2117:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2118: 
 2119:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2120:       // then we fix the negative shape coordinates.
 2121:       if (fixNegshpCoord && tmpmin<=0.0) {
 2122: 
 2123:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2124:          // keeping the sum of the shape coordinates equal to 1.
 2125:          // I have tested and compared the new algorithm with the old one, and they give
 2126:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2127:          // The new algorithm should be faster since it is branchless.
 2128:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2129:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2130:          
 2131:          shpCoords[0] = (shpCoords[0] + a)*b;
 2132:          shpCoords[1] = (shpCoords[1] + a)*b;
 2133:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2134: 
 2135:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2136:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2137:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2138:          }
 2139: 
 2140:          // Update the point coordinates for the new shape coordinates
 2141:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2142:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2143:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2144: 
 2145:       }
 2146: 
 2147:       // Check if the point is inside the element
 2148:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2149:    }
 2150:    else {
 2151:       Error("Not implemented yet");
 2152: #ifdef QUADS
 2153:       // Reproject pt in eframe of nel for ics=2
 2154:       if constexpr(ics==1) {
 2155:          xn2 = xt; 
 2156:          yn2 = yt;
 2157:       }
 2158:       else {
 2159:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2160:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2161:       }
 2162: 
 2163:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2164: #endif
 2165:    }
 2166: 
 2167:    return false;  // Never reached
 2168: 
 2169: }
 2170: 
 2171: 
 2172: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2173: // Convert shape coordinates to cartesian coordinates
 2174: 
 2175:    if (i34 == 3) {
 2176:       // Triangular element
 2177:       double xcoords[3] = {nodes[0]->p2().x, nodes[1]->p2().x, nodes[2]->p2().x};
 2178:       double ycoords[3] = {nodes[0]->p2().y, nodes[1]->p2().y, nodes[2]->p2().y};
 2179:    }
 2180:    else {
 2181:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2182:    }
 2183: 
 2184: }
