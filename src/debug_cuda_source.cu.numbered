 1910:                               const bool valid = (idx_node < mesh->np);                   
 1911: 
 1912: 
 1913: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1914:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 1915:                            if (idx_node_bnd >= mesh->nbp) return;
 1916: 
 1917: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1918:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 1919:                            if (idx_side_bnd >= mesh->nbs) return;                           
