 5297: 
 5298:       if constexpr(nws != 0 && iwindoff != 0) {
 5299:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 5300:       }
 5301: 
 5302:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 5303:       node->setWind(wind);
 5304: 
 5305:       node->pr = pressAir[idx];
 5306:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 5307: 
 5308:    }
