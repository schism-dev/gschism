  632: 
  633:    __inline__ __device__ bool containsPoint(Vector2 &xt, bool fixCoords) const { 
  634:       // Check if the point (xt,yt) is inside the element
  635:       double shpCoords[4];
  636: 
  637:       Vector2 tmp_xt = xt;
  638:       bool res = computeShapeCoords(tmp_xt, shpCoords, fixCoords);
  639: 
  640:       if (fixCoords && res) xt = tmp_xt;
  641: 
  642:       return res;
  643:    }
  644: 
  645:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  646:    {
  647:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  648:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  649:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  650:       
  651:    }
