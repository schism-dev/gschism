 7180:   __global__ void populateMesh(int *i34, int *elnode, int *elside,
 7181:                    double *node_coords, double *wind_rotate_angle, 
 7182:                    int *isdel, int *isidenode, int *isbnd,
 7183:                    int *nond, int *nlnd, int *iond, int *ilnd, 
 7184:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 7185:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 7186:                    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 7187:                    int *localNodeIndices, int *localElemIndices, int *localSideIndices,
 7188:                    int *localNodePart,    int *localElemPart,    int *localSidePart,
 7189:                    double *emo, double *efa, 
 7190:                    double *umo, double *ufa, 
 7191:                    double *vmo, double *vfa) {
 7192: 
 7193:     mesh->populateMesh(i34, elnode, elside, node_coords, wind_rotate_angle, 
 7194:                        isdel, isidenode, isbnd,
 7195:                        nond, nlnd, iond, ilnd, 
 7196:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 7197:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 7198:                        globalNodeIndices, globalElemIndices, globalSideIndices,
 7199:                        localNodeIndices, localElemIndices, localSideIndices,
 7200:                        localNodePart, localElemPart, localSidePart,
 7201:                        emo, efa, umo, ufa, vmo, vfa);
 7202:   }
