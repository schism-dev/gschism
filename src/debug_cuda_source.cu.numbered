 4439: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 4440:                 double *node_coords, double *node_coords_ll, bool use_ll,
 4441:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 4442:                 int *isdel, int *isidenode, int *isbnd,
 4443:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 4444:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4445:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4446:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4447:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4448:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 4449:                 double *drag, double *roughness,
 4450:                 double *emo, double *efa, 
 4451:                 double *umo, double *ufa, 
 4452:                 double *vmo, double *vfa) {
 4453: 
 4454:    printf("Populating mesh for partition %d\n", partNum);
 4455: 
 4456:    // XXXXXX THIS function does almost nothing. 
 4457: 
 4458:    nbs = *sharedIdxSideBoundary + 1;
 4459:    nbp = *sharedIdxNodeBoundary + 1;
 4460: 
 4461:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 4462: 
 4463: }
