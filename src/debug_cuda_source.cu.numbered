  489:    double ssign[4];           // Sign associated with each side of an element
  490:    double radius;             // Element equivalent radii
  491: 
  492:    Frame frame;
  493: 
  494:    Vector2 gradPhi[4];       // Derivatives of shape functions
  495:    Vector2 gradEta;          // Gradient of free surface elevation
  496:    Vector2 gradPr;           // Gradient of pressure    
  497:    Vector2 gradETP;          // Gradient of Earth Tidal Potential    XXXXX Really used?
  498: 
  499:    bool isDry;                // True if the element is dry
  500: 
  501:    Vector2 center;         // Element center coordinates
  502:    double xlon, ylat;         // Element center lat/lon coordinates in _degrees_
  503:    double depth;              // Depth at element (min of all nodes)
  504:    double z[nvrt];            // z-coord  (local frame - vertical up)
  505: 
  506:    // Physical information
  507:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  508: 
  509:    static const bool isblock = false;              // Always false
  510: 
  511:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  512:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  513: 
  514:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  515: 
  516:    
  517: 
  518:    double vsource;            // Volumetric source/sink term [m^3/s]
  519: 
  520:    double rho[nvrt];          // Density at each prism center
  521:    double rho_mean[nvrt];     // Mean density at each prism center
  522:    CubicSpline rho_spl;
  523:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  524:    double rho_z[nvrt];        // First derivative of density at each prism center
  525:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  526: 
  527:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  528: 
  529:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  530:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  531: 
  532:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  533:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  534: 
  535:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  536:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  537:       // Find the local index of the node in the element (0,1,2,3)
  538:       int res = __ffs((nodes[0] == node) | 
  539:                      ((nodes[1] == node) << 1) | 
  540:                      ((nodes[2] == node) << 2) | 
  541:                      ((nodes[3] == node) << 3)) - 1;
  542:       
  543:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  544:       return res;  
  545:    }
  546: 
  547:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  548:       // Find the local index of the side in the element (0,1,2,3)
  549:       int res = __ffs((sides[0] == side) | 
  550:                      ((sides[1] == side) << 1) | 
  551:                      ((sides[2] == side) << 2) | 
  552:                      ((sides[3] == side) << 3)) - 1;
  553:       
  554:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  555:       return res;
  556:    }
  557: 
  558: 
  559:    __inline__ __device__ int findLevel(double z1, int k) const {
  560:       // Starting at index k, find sequentially the level that contains z
  561: 
  562:       // For testing purposes, forgets k and performs a full search.
  563:       for (k = kb; k < nvrt - 1; k++) {
  564:          if (idx==46) printf("((()))))) kk = %d, z[%d] = %.16f, z[%d] = %.16f\n", k, k, z[k], k + 1, z[k + 1]);            
  565:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
  566:       }
  567:       return nvrt - 2;
  568: 
  569: 
  570:       // if z is already betweeen z[k] and z[k+1], return k
  571:       if (idx==46) for (int kkk=0; kkk<nvrt; kkk++) printf("##>>>>  z[%d] = %.16f\n", kkk, z[kkk]);             
  572: if (idx==46) printf("##>>>>#### kk = %d, z1 = %.16f, z[%d] = %.16f, z[%d] = %.16f\n", k, z1, k, z[k], k + 1, z[k + 1]);       
  573:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
  574:       else if (z1 <  z[k]) { 
  575:          // Search for increasing levels
  576:          for (int kk = k; kk < nvrt - 1; kk++) {
  577: if (idx==46) printf("##>>#### kk = %d, z[%d] = %.16f, z[%d] = %.16f\n", kk, kk, z[kk], kk + 1, z[kk + 1]);            
  578:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  579:          }
  580:          return nvrt - 1;
  581:       }
  582:       else {
  583:          // Search for decreasing levels
  584:          for (int kk = k; kk >= kb; kk--) {
  585: if (idx==46) printf("###>>### kk = %d, z[%d] = %.16f, z[%d] = %.16f\n", kk, kk, z[kk], kk + 1, z[kk + 1]);             
  586:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  587:          }
  588:          return 0;
  589:       }
  590:    }
  591: 
  592:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
  593:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
  594: 
  595:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  596:    __device__ __forceinline__ Point2 GaussPoint(int idx) const {
  597:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
  598:        assert(idx >= 0 && idx < 4 && "GaussPoint: idx out of range");
  599:        const double eta = (idx & 1) ? +g : -g;
  600:        const double xi  = (idx & 2) ? +g : -g;
  601:        return {eta, xi};
  602:    }  
  603: 
  604:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  605:    __device__ __forceinline__ double etaSign(int idx) const {
  606:       // bit1: 0 -> -1, 1 -> +1
  607:       assert(idx >= 0 && idx < 4 && "etaSign: idx out of range");
  608:       return (idx & 2) ? 1.0 : -1.0;     // [-1,-1,+1,+1]
  609:    }
  610: 
  611:    __device__ __forceinline__ double xiSign(int idx) const {
  612:       // +1 if (bit0 XOR bit1), else -1
  613:       assert(idx >= 0 && idx < 4 && "xiSign: idx out of range");
  614:       return ((idx & 1) ^ (idx >> 1)) ? 1.0 : -1.0;   // [-1,+1,+1,-1]
  615: 
  616:    }
  617: 
  618:    // Shape function Phi_idx at a given point p = (eta,xi), idx = 0,1,2,3
  619:    __device__ __forceinline__ double Phi(int idx, Point2 p) const {
  620:       return 0.25*(1.0 + p.x*etaSign(idx))*(1.0 + p.y*xiSign(idx));
  621:    }
  622: 
  623:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi) 
  624:    __device__ __forceinline__ double dPhi_dxi(int idx, Point2 p) const {
  625:       return 0.25*xiSign(idx)*(1.0 + p.x*etaSign(idx));
  626:    }   
  627: 
  628:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
  629:    __device__ __forceinline__ double dPhi_deta(int idx, Point2 p) const {
  630:       return 0.25*(1.0 + p.y*xiSign(idx))*etaSign(idx);
  631:    }      
  632:    
  633:    __inline__ __device__ double detJ_eta(void) const;
  634: 
  635:    __inline__ __device__ double detJ_xi(void) const;
  636: 
  637:    __inline__ __device__ double jacobianDet(Point2 p) const { return area/4.0 + detJ_eta()*p.x + detJ_xi()*p.y; }
  638: 
  639:    // Check if the element is dry using the more up-to-date elevation.
  640:    __inline__ __device__ bool isDry2(void) const;
  641: 
  642:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  643: 
  644:    __inline__ __device__ double computeSignedArea(void) const;
  645: 
  646:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  647:       // Nudges the point (x,y) to the barycenter of the element
  648:       p = (1-eps)*p + eps*center;
  649:    }
  650: 
  651:    __device__ bool computeShapeCoords(Point2 &xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  652:    
  653:    __device__ void shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const;
  654: 
  655:    __device__ double intPhiPhi(int i1, int i2) const;
  656: 
  657:    __device__ double intGradPhiGradPhi(int i1, int i2) const;
  658: 
  659:    __device__ Vector2 grad2(double *a) const
  660:    {
  661:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  662:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  663:       if (isQuad()) {
  664:          gx += a[3]*gradPhi[3].x;
  665:          gy += a[3]*gradPhi[3].y;
  666:       }
  667:       return {gx, gy};
  668:    }
  669: 
  670:    __device__ Vector2 grad2(double Node::* field) const
  671:    {
  672:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  673:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  674:       if (isQuad()) {
  675:          gx += (nodes[3]->*field)*gradPhi[3].x;
  676:          gy += (nodes[3]->*field)*gradPhi[3].y;
  677:       }
  678:       return {gx, gy};
  679:    }
  680: 
  681:    __device__ __forceinline__ Vector3 n(int k, double &area3D) const;
  682:    __device__ __forceinline__ Vector3 n(int k) const {
  683:       double area3D;
  684:       return n(k, area3D);
  685:     }
