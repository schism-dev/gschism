 8013: __global__ void returnMatrix(double *res) {
 8014:    // Debugging: returns the matrix as a CuPy array
 8015: 
 8016:    const int size = mesh->np;
 8017:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8018:       const Node *node = mesh->localNodeData + idx_node;
 8019:       res[idx_node*size + idx_node] = node->coeffDiag;
 8020:       for (int j = 0; j < node->numNodes; j++) {
 8021:          Node* nbNode = node->nodes[j];
 8022:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 8023:       }
 8024: 
 8025:    }
 8026:    
 8027: }
