 3259: extern "C" {
 3260:    __global__ void rollUpElevation(void) {
 3261: 
 3262:       NODE(node);
 3263: 
 3264:       node->eta2 += node->eta1;
 3265: 
 3266:    }
 3267: 
 3268: 
 3269:    __global__ void backtrackAllNodes(void) {
 3270: 
 3271:       // max/min # of sub-divisions
 3272:       const int ndelt_max = max(1.0, dt/dtb_min);
 3273:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3274: 
 3275:       // Removed all references to swild98 XXX
 3276:       // swild98=0.d0 !init
 3277: 
 3278: 
 3279:       SIDE(side);
 3280: 
 3281:       const int kb = side->kb;
 3282: 
 3283: 
 3284: 
 3285:       // Initialize btrack velocities to the actual velocities at the side 
 3286:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3287: 
 3288: 
 3289:       if (side->isDry) return;
 3290: 
 3291: 
 3292:       // Checks that at least one element is not dry
 3293:       const Element *elem1 = side->elems[0];
 3294:       const Element *elem2 = side->elems[1];
 3295: 
 3296: 
 3297:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3298:       
 3299:       // XXXXXX
 3300:       // !swild_tmp to store global coord. of the starting side
 3301:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3302:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3303:       // !Use sframe2 
 3304:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3305: 
 3306: 
 3307:       for (int k = kb; k < nvrt; k++) {
 3308:       //  Initialize (xt,yt,zt), nnel and vel.
 3309:       //  For ics=2, the coordinates are in local frames
 3310:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3311: 
 3312: 
 3313:          const int iadvf = side->iadv();  // Advection flag
 3314: 
 3315:          Point3 xt;
 3316:          if constexpr(ics==1) {
 3317:             xt = side->center3D(k); 
 3318:          }
 3319:          else // lat/lon; in side lat/lon frame
 3320:          {
 3321:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3322:          // XXX IMPLEMENT THIS
 3323:       //          xt=0.d0
 3324:       //          yt=0.d0
 3325:       //          !centroid coord. for nudging
 3326:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3327:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3328:          }  // ics
 3329: 
 3330: 
 3331:          // Velocity at the side (in ll frame for ics, same vertical direction)
 3332:          // XXX IS THIS NECESSARY?
 3333:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 3334: 
 3335:          // If on land or open boundary...
 3336:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3337:          
 3338:          const double vmag = length(toVector2(u_int));
 3339: 
 3340:          if (vmag <= velmin_btrack) {
 3341:             // No activity 
 3342: 
 3343:             side->btu[k] = side->u2[k];
 3344:             
 3345:          } else {  // do btrack
 3346: 
 3347:             // Compute number of sub-divisions based on local gradients 
 3348:             // XXX IS THIS NECESSARY?
 3349:             double suma = 0.0;
 3350:             int icount = 0;
 3351:             for (int ii=0; ii<2; ii++) {
 3352: 
 3353:                const Element *elem = side->elems[ii];
 3354:                  
 3355:                if (elem == nullptr) continue;
 3356: 
 3357:                icount++;
 3358: 
 3359:                // Not strictly along z; in ll frame for ics=2
 3360: 
 3361:                double utmp[4];
 3362:                double vtmp[4];
 3363:                for (int jj = 0; jj < elem->i34; jj++) {
 3364: 
 3365:                   const Node *node = elem->nodes[jj];
 3366: 
 3367:                   if constexpr(ics==1) {
 3368:                      utmp[jj] = node->u2[k].x;
 3369:                      vtmp[jj] = node->u2[k].y;  
 3370:                   } else {
 3371:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3372:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3373:                   }
 3374:                } // for jj
 3375: 
 3376:                const Vector2 grad_u = elem->grad2(utmp); 
 3377:                const Vector2 grad_v = elem->grad2(vtmp);
 3378: 
 3379:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3380:             } // for ii
 3381: 
 3382:             assert(icount > 0 && "Impossible 77");
 3383: 
 3384:             // '4' is somewhat arbitrary
 3385:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3386: 
 3387:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3388:          
 3389: 
 3390:             Vector3 u_int = {0.0, 0.0, 0.0};
 3391: 
 3392:             side->btrack(k, dt, dtbk, u_int);
 3393:                
 3394:          } // if vmag (do backtrack)
 3395: 
 3396:       } // for j=jmin,nvrt-1
 3397: 
 3398:    }
 3399: } // extern "C"
 3400: 
 3401: template<int nc>
 3402: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3403: 
 3404: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3405: //
 3406: // a,b,c,rhs: input vectors and are not modified by this program.
 3407: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3408: // rhs is the r.h.s.
 3409: // n: actual rank of the system.
 3410: // rows in u() and rhs();
 3411: // u: output with nc columns (transposed to rows)
 3412: // gam: a working array.
 3413: //
 3414: // NOTES:
 3415: // This is a template function that allows for different numbers of columns in the rhs vector.
 3416: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3417: 
 3418:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3419:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3420: 
 3421:    double bet = b[0];
 3422:    if constexpr (nc == 1) {
 3423:       u[0] = rhs[0]/bet;
 3424:    } else {
 3425:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 3426:    }
 3427: 
 3428:    for (int j = 1; j < n; j++) {
 3429:       gam[j] = c[j-1]/bet;
 3430:       bet = b[j] - a[j]*gam[j];
 3431: 
 3432:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3433: 
 3434:       if constexpr (nc == 1) {
 3435:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3436:       } else {
 3437:          for (int k = 0; k < nc; k++) {
 3438:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 3439:          }
 3440:       }
 3441:    }
 3442: 
 3443:    // Back-substitution
 3444:    for (int j=n-1; j>=1; j--) {
 3445:       if constexpr (nc == 1) {
 3446:          u[j] = u[j] - gam[j+1]*u[j-1];
 3447:       } else {
 3448:          for (int k = 0; k < nc; k++) {
 3449:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 3450:          }
 3451:       }
 3452:    }
 3453: }
 3454: 
 3455: 
 3456: 
 3457: // Helper function that contains the core algorithm
 3458: template<typename XAccessor, typename YAccessor>
 3459: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3460:                                     double  yp_top, double  yp_bot, 
 3461:                                     CubicSpline &spline) {
 3462:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3463:    // 
 3464:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3465:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3466:    //
 3467:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3468:    // 
 3469:    // Inputs: 
 3470:    //            n: dimension for x etc; # of data pts (>=2);
 3471:    //            getX, getY: functions to access x,y coordinates
 3472:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3473:    //     Output: 
 3474:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3475: 
 3476:    const int n = k2 - k1 + 1;
 3477:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3478: 
 3479:    // Allocate memory for the splines
 3480:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3481:    spline.x   = new double[n];
 3482:    spline.y   = new double[n];
 3483:    spline.yp  = new double[n];
 3484:    spline.ypp = new double[n];
 3485: 
 3486:    for (int k=k1; k<=k2; k++) {
 3487:       spline.x[k] = getX(k);
 3488:       spline.y[k] = getY(k);
 3489:    }
 3490: 
 3491:    // This is to simplify expressions later
 3492:    double *x = spline.x;
 3493:    double *y = spline.y;
 3494: 
 3495:    double *a = nullptr;
 3496:    double *b = nullptr;
 3497:    double *c = nullptr;
 3498:    double *gam = nullptr;
 3499:    double *rhs = nullptr;
 3500:    
 3501: 
 3502:       a = new double[n];   // Lower diagonal
 3503:       b = new double[n];   // Diagonal
 3504:       c = new double[n];   // Upper diagonal
 3505:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3506:       rhs = new double[n]; // Right-hand side
 3507: 
 3508:    for (int k=k1; k<=k2; k++) {
 3509:       if (k == k1) {
 3510:          // Bottom level
 3511:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3512:          b[k] = (x[k+1] - x[k])/3.0;
 3513:          c[k] = b[k]/2.0;
 3514:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3515:       } else if (k == n - 1) {
 3516:          // Top level (surface)
 3517:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3518:          b[k] = (x[k] - x[k-1])/3.0;
 3519:          a[k] = b[k]/2.0;
 3520:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3521:       } else {
 3522:          // Intermediate levels
 3523:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3524:          b[k] = (x[k+1] - x[k-1])/3.0;
 3525:          a[k] = (x[k  ] - x[k-1])/6.0;
 3526:          c[k] = (x[k+1] - x[k  ])/6.0;
 3527:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3528:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3529:       }
 3530:    }
 3531: 
 3532:    // Solve the tridiagonal system
 3533:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3534:    
 3535:    spline.yp[k1] = yp_bot;
 3536:    spline.yp[k2] = yp_top;
 3537: 
 3538:    // Compute rest of 1st derivatives using the splines
 3539:    for (int k=k1+1; k<k2; k++) {
 3540:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3541:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3542:    }
 3543:    
 3544:    delete[] a;
 3545:    delete[] b;
 3546:    delete[] c;
 3547:    delete[] gam;
 3548:    delete[] rhs;
 3549: 
 3550: }
 3551: 
 3552: // Array version
 3553: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3554:                                 double y_top, double y_bot, 
 3555:                                 CubicSpline &spline) {
 3556:    auto getX = [x] (int k) { return x[k]; };
 3557:    auto getY = [y] (int k) { return y[k]; };
 3558:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3559: }
 3560: 
 3561: // Lambda version - allows custom access patterns
 3562: template<typename XFunc, typename YFunc>
 3563: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3564:                                 double y_top, double y_bot,
 3565:                                 CubicSpline &spline) {
 3566:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3567: }
