 1699: // Helper functions for computing the local node index at a given offset from another.
 1700: __device__ __inline__ int nxq(int offset, int index, int size) {
 1701:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1702:    // to the index to make it positive
 1703:    assert(index + offset + 16*size >= 0);
 1704:    return (index + offset + 16*size) % size;  
 1705: }
 1706: 
 1707: __device__ __inline__ int nxq(int index, int size) {
 1708:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1709:    // to the index to make it positive
 1710:    assert(index + 16*size >= 0);
 1711:    return (index + 16*size) % size; 
 1712: }
