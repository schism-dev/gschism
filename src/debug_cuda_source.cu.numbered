  598: // ----------------------------- Transport -----------------------------
  599: 
  600: enum class TransportModel : int {
  601:    TVD  = 3, // itr_met == 3  explicit TVD horiz, implicit TVD vert
  602:    WENO = 4, // itr_met == 4  later
  603: };
  604: 
  605: constexpr TransportModel transportModel = static_cast<TransportModel>(itr_met);
  606: 
  607: 
  608: template<TransportModel Model>
  609: struct Transport {
  610:    Tracers prevTraces[nvrt]; // elem->tracers at previous substep
  611:    bool itvd;                // Read from tvd.prop; 0 means always 1st order upwind
  612:    
  613: 
  614:    __device__ __forceinline__  maxStableSubstep() const {
  615:       assert(false && "maxStableSubstep not implemented for this transport model");
  616:    }
  617: 
  618:    // flag that indicates if 1st order upwind is used
  619:    __device__ __forceinline__ bool use1stOrderUpwind(const Element *elem) const {
  620:       if (itvd) {
  621:          // If the element is marked as such in tvd.prop, use 1st order upwind for this element
  622:          return true;
  623: 
  624:       } else {
  625: 
  626:          // If *any* of the nodes of the element is shallow, use 1st order upwind
  627:          for (int j = 0; j < elem->i34; j++) {
  628:             const double htot = elem->nodes[j]->htot2();
  629:             if (htot < h_tvd) {
  630:                return true;
  631:             }
  632:          }  
  633:       }
  634:       return false;
  635:    }
  636: 
  637:    __device__ __forceinline__ void savePrevTraces(const Element *elem) {
  638:       for (int k = 0; k < nvrt; k++) prevTraces[k] = elem->tracers[k];
  639:    }
  640: 
  641: 
  642: 
  643: };
