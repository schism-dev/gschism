 4166: 
 4167:    __global__ void backtrackAllNodes(void) {
 4168: 
 4169:       // max/min # of sub-divisions
 4170:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4171:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4172: 
 4173: 
 4174:       SIDE(side);
 4175: 
 4176:       const int kb = side->kb;
 4177: 
 4178: 
 4179:       // Initialize btrack velocities to the actual velocities at the side 
 4180:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4181: 
 4182:   
 4183: 
 4184:       if (side->isDry) return;
 4185:       
 4186: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4187: 
 4188:       // Checks that at least one element is not dry
 4189:       const Element *elem1 = side->elems[0];
 4190:       const Element *elem2 = side->elems[1];
 4191: 
 4192: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4193: 
 4194:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4195:       
 4196:       // XXXXXX
 4197:       // !swild_tmp to store global coord. of the starting side
 4198:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4199:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4200:       // !Use sframe2 
 4201:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4202: 
 4203: 
 4204:       for (int k = kb; k < nvrt; k++) {
 4205:       //  Initialize (xt,yt,zt), nnel and vel.
 4206:       //  For ics=2, the coordinates are all in the side's local frame
 4207:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 4208: 
 4209: 
 4210:          const int iadvf = side->iadv();  // Advection flag   
 4211:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4212: 
 4213: 
 4214:          // If on land or open boundary...
 4215:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 4216:          
 4217:          const double vmag = length(side->u2[k]);
 4218: 
 4219:          if (vmag <= velmin_btrack) {
 4220:             // No activity 
 4221: 
 4222:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4223: // addDebugPlot(side->center, side->center, 0x00000F, '+');     
 4224: 
 4225: 
 4226:             
 4227:          } else {  // do btrack
 4228: 
 4229:             // Compute number of sub-divisions based on local gradients of the velocity field
 4230: 
 4231:             // XXX IS THIS NECESSARY?
 4232:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4233:             double suma = 0.0;
 4234:             int icount = 0;
 4235:             for (int l=0; l<2; l++) {
 4236:             // For each element sharing the side...
 4237: 
 4238:                const Element *elem = side->elems[l];
 4239:                  
 4240:                if (elem == nullptr) continue;
 4241: 
 4242:                icount++;
 4243: 
 4244:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 4245:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 4246:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 4247: 
 4248:                double utmp[4];
 4249:                double vtmp[4];
 4250:                for (int j = 0; j < elem->i34; j++) {
 4251: 
 4252:                   const Node *node = elem->nodes[j];
 4253: 
 4254:                   if constexpr(ics==1) {
 4255:                      utmp[j] = node->u2[k].x;
 4256:                      vtmp[j] = node->u2[k].y;  
 4257: 
 4258:                   } else {
 4259:                      // 'Project' the velocity from the node frame to the element frame
 4260:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 4261:                      utmp[j] = tmp_u2.x;
 4262:                      vtmp[j] = tmp_u2.y;
 4263: 
 4264:                   }
 4265:                } // for j
 4266: 
 4267:                const Vector2 grad_u = elem->grad2(utmp); 
 4268:                const Vector2 grad_v = elem->grad2(vtmp);
 4269: 
 4270:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4271:             } // for ii
 4272: 
 4273:             assert(icount > 0 && "Impossible 77");
 4274: 
 4275:             // '4' is somewhat arbitrary
 4276:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4277: 
 4278:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4279: 
 4280:             Vector3 u_int = {0.0, 0.0, 0.0};
 4281: 
 4282:             bool res =side->btrack(k, dt, dtbk, u_int);
 4283: 
 4284:             side->btu[k] = toVector2(u_int);
 4285:                
 4286:          } // if vmag (do backtrack)
 4287: 
 4288: 
 4289:       } // for k=kb,nvrt-1
 4290: 
 4291:    }
 4292: 
 4293: } // extern "C"
 4294: 
 4295: template<int nc>
 4296: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4297: 
 4298: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4299: //
 4300: // a,b,c,rhs: input vectors and are not modified by this program.
 4301: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4302: // rhs is the r.h.s.
 4303: // n: actual rank of the system.
 4304: // rows in u() and rhs();
 4305: // u: output with nc columns (transposed to rows)
 4306: // gam: a working array.
 4307: //
 4308: // NOTES:
 4309: // This is a template function that allows for different numbers of columns in the rhs vector.
 4310: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4311: 
 4312:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4313:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4314: 
 4315:    double bet = b[0];
 4316:    if constexpr (nc == 1) {
 4317:       u[0] = rhs[0]/bet;
 4318:    } else {
 4319:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4320:    }
 4321: 
 4322:    for (int j = 1; j < n; j++) {
 4323:       gam[j] = c[j - 1]/bet;
 4324:       bet = b[j] - a[j]*gam[j];
 4325: 
 4326:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4327: 
 4328:       if constexpr (nc == 1) {
 4329:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4330:       } else {
 4331:          for (int l = 0; l < nc; l++) {
 4332:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4333:          }
 4334:       }
 4335:    }
 4336: 
 4337:    // Back-substitution
 4338:    for (int j = n - 2; j >= 0; j--) {
 4339:       if constexpr (nc == 1) {
 4340:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4341:       } else {
 4342:          for (int l = 0; l < nc; l++) {
 4343:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4344:          }
 4345:       }
 4346:    }
 4347: }
 4348: 
 4349: 
 4350: 
 4351: // Helper function that contains the core algorithm
 4352: template<typename XAccessor, typename YAccessor>
 4353: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4354:                                     double  yp_top, double  yp_bot, 
 4355:                                     CubicSpline &spline) {
 4356:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4357:    // 
 4358:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4359:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4360:    //
 4361:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4362:    // 
 4363:    // Inputs: 
 4364:    //            n: dimension for x etc; # of data pts (>=2);
 4365:    //            getX, getY: functions to access x,y coordinates
 4366:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4367:    //     Output: 
 4368:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4369: 
 4370:    const int n = k2 - k1 + 1;
 4371:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4372: 
 4373:    // Allocate memory for the splines
 4374:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4375:    spline.x   = new double[n];
 4376:    spline.y   = new double[n];
 4377:    spline.yp  = new double[n];
 4378:    spline.ypp = new double[n];
 4379: 
 4380:    for (int k=k1; k<=k2; k++) {
 4381:       spline.x[k] = getX(k);
 4382:       spline.y[k] = getY(k);
 4383:    }
 4384: 
 4385:    // This is to simplify expressions later
 4386:    double *x = spline.x;
 4387:    double *y = spline.y;
 4388: 
 4389:    double *a = nullptr;
 4390:    double *b = nullptr;
 4391:    double *c = nullptr;
 4392:    double *gam = nullptr;
 4393:    double *rhs = nullptr;
 4394:    
 4395: 
 4396:       a = new double[n];   // Lower diagonal
 4397:       b = new double[n];   // Diagonal
 4398:       c = new double[n];   // Upper diagonal
 4399:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4400:       rhs = new double[n]; // Right-hand side
 4401: 
 4402:    for (int k=k1; k<=k2; k++) {
 4403:       if (k == k1) {
 4404:          // Bottom level
 4405:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4406:          b[k] = (x[k+1] - x[k])/3.0;
 4407:          c[k] = b[k]/2.0;
 4408:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4409:       } else if (k == n - 1) {
 4410:          // Top level (surface)
 4411:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4412:          b[k] = (x[k] - x[k-1])/3.0;
 4413:          a[k] = b[k]/2.0;
 4414:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4415:       } else {
 4416:          // Intermediate levels
 4417:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4418:          b[k] = (x[k+1] - x[k-1])/3.0;
 4419:          a[k] = (x[k  ] - x[k-1])/6.0;
 4420:          c[k] = (x[k+1] - x[k  ])/6.0;
 4421:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4422:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4423:       }
 4424:    }
 4425: 
 4426:    // Solve the tridiagonal system
 4427:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4428:    
 4429:    spline.yp[k1] = yp_bot;
 4430:    spline.yp[k2] = yp_top;
 4431: 
 4432:    // Compute rest of 1st derivatives using the splines
 4433:    for (int k=k1+1; k<k2; k++) {
 4434:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4435:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4436:    }
 4437:    
 4438:    delete[] a;
 4439:    delete[] b;
 4440:    delete[] c;
 4441:    delete[] gam;
 4442:    delete[] rhs;
 4443: 
 4444: }
 4445: 
 4446: // Array version
 4447: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4448:                                 double y_top, double y_bot, 
 4449:                                 CubicSpline &spline) {
 4450:    auto getX = [x] (int k) { return x[k]; };
 4451:    auto getY = [y] (int k) { return y[k]; };
 4452:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4453: }
 4454: 
 4455: // Lambda version - allows custom access patterns
 4456: template<typename XFunc, typename YFunc>
 4457: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4458:                                 double y_top, double y_bot,
 4459:                                 CubicSpline &spline) {
 4460:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4461: }
 4462: 
 4463: 
 4464: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 4465: {
 4466:    assert("Not implemented");
 4467: 
 4468:    return 0.0;
 4469: }
 4470: 
 4471: // __device__ void vertLinearInterp(int nc, double zt, int k1, int k2, double *za, double *s_in, double *s_out, int *ibelow) {
 4472: // //     Routine to do vertical linear interpolation in z
 4473: // //     Inputs:
 4474: // //
 4475: // //       nc: actual # of variables 
 4476: // //       k1,k2: lower and upper limits for za, s_in 
 4477: // //       zt: desired interpolation level
 4478: // //       za[0:nvrt-1]: z-coordinates for s_in (must be in ascending order)
 4479: // //       s_in[0:nc-1,0:nvrt-1]: values to be interpolated from; dimensions must match driving program
 4480: 
 4481: // //     Outputs:
 4482: // //       s_out[0:nc-1]: interpolated value @ z=zt (bottom value if ibelow=1). Constant extrapolation
 4483: // //                   is used below bottom or above surface.
 4484: // //       ibelow: flag indicating if zt is below za(k1)
 4485: // //
 4486: 
 4487: //    assert(k1 >= 0 && k2 < nvrt && "vertLinearInterp: k1 or k2 out of bounds");
 4488: //    assert(k1 <= k2 && "vertLinearInterp: k1 > k2");
 4489:    
 4490: //    ibelow = 0;
 4491: 
 4492: //    if (zt < za[k1]) {
 4493: //       // Below bottom
