 4423:    __global__ void computeFlowBcVelocities(double time) {
 4424: 
 4425:       SIDE_BND(sideBnd);
 4426: 
 4427:       const Side *side = sideBnd->side;
 4428:  
 4429:       const bool isDry = side->isDry;
 4430:       const bool isLand = sideBnd->segment->isLand;
 4431: 
 4432:    
 4433:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4434: 
 4435:       if (isDry || isLand) return;
 4436: 
 4437:       // For wet sides in open boundaries...
 4438:       const Vector2 n = side->n;
 4439:       const BoundarySegment *segment = sideBnd->segment;
 4440: 
 4441:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4442: 
 4443:       const int ifltype = segment->ifltype;
 4444: 
 4445:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4446:       const Vector2 r_nuth0 = r_uth0*n;
 4447: 
 4448: 
 4449:       if (ifltype == 1 || ifltype == 2) {
 4450:       
 4451:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4452: 
 4453:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4454:          
 4455:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4456:          
 4457:       } else if (ifltype == -1) { // Flather 1
 4458: 
 4459:          for (int k = 0; k < nvrt; k++) {
 4460: 
 4461:             // uth is the normal vel.; no ramp up
 4462:             const double uth = sideBnd->nuth(k);
 4463:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4464: 
 4465:             sideBnd->ubc[k] += uth*n;
 4466:          }
 4467: 
 4468:       } else if (ifltype == 3 || ifltype == 5) {
 4469:          // vnth0=0 !normal vel.
 4470: 
 4471:          Vector2 r_u1_bar = {0.0, 0.0};
 4472:          // Computes the contribution to the velocity from all tide frequencies
 4473:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4474: 
 4475:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4476:             const Vector2 umo  = sideBnd->umo(jfr); 
 4477: 
 4478:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4479:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4480:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4481:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4482:          }
 4483: 
 4484: 
 4485:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4486: 
 4487:       } // if (ifltype = 3 || ifltype == 5
 4488: 
 4489: 
 4490: 
 4491:    }
 4492: 
 4493:    __global__ void computeElevationBoundaryConditions(double time) {
 4494:       // Compute elevation essential boundary conditions 
 4495: 
 4496:       NODE_BND(nodeBnd); // Each boundary node.
 4497: 
 4498:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4499: 
 4500:       const Node *node = nodeBnd->node;
 4501:       const BoundarySegment *segment = nodeBnd->segment;
 4502:       const int iettype = segment->iettype;
 4503:       
 4504: 
 4505:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4506:       double eic = 0.0;
 4507:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4508:       else                 eic = 0.0;
 4509: 
 4510:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4511:       const double r_eth = ramp*nodeBnd->eth;
 4512:       double r_eta1_bar = 0.0;
 4513: 
 4514: 
 4515:       // Compute tide elevation
 4516:       if (iettype == 3 || iettype == 5) {   
 4517: 
 4518:          if constexpr(iloadtide==1) { // loading tide
 4519:             assert(false && "Loading tide not implemented");
 4520:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4521:          }
 4522:          
 4523:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4524: 
 4525:             const double efa  = nodeBnd->efa[jfr]; 
 4526:             const double emo  = nodeBnd->emo[jfr]; 
 4527: 
 4528:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4529:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4530:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4531: 
 4532:          } // for jfr
 4533: 
 4534:       } // if iettype
 4535: 
 4536:       switch (iettype) {
 4537:          case 1:
 4538:          case 2:
 4539:          case 4:
 4540:             nodeBnd->elbc = r_eic + r_eth;
 4541:             break;
 4542:          case 3:
 4543:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4544:             break;
 4545:          case 5:
 4546:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4547:             break;
 4548:       } // switch
 4549: 
 4550: 
 4551:       //Add inverse barometric effects
 4552:       if (iettype != 0 && inv_atm_bnd == 1) {
 4553:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4554:       }
 4555: 
 4556:    }
 4557: 
 4558: 
 4559:    __global__ void computeHorizontalViscosity(void) { 
 4560: 
 4561:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4562: 
 4563:       SIDE(side);
 4564: 
 4565:       if (side->isDry) return;
 4566: 
 4567:       for (int k = 0; k < nvrt; k++) {
 4568:          side->nuGradU[k] = {0.0, 0.0};
 4569:       }
 4570: 
 4571:       if constexpr(ihorcon == 1) {
 4572:          for (int k = side->kb; k < nvrt - 1; k++) {
 4573:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4574:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 4575:             // By Zhang and Baptista.
 4576: 
 4577:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4578:             // This is a standard discretization of the Laplacian operator.
 4579:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4580:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4581:             // Gamma is hvis_coef0 in the code.
 4582:             // The value of gamma needs to be < 0.5.
 4583: 
 4584:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4585:             // side under consideration in each of the two possible elements that share the side.
 4586:             Vector2 sumU = {0.0, 0.0};
 4587:             for (int l = 0; l < 2; l++) {
 4588:                const Element *elem = side->elems[l];
 4589: 
 4590:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4591: 
 4592:                // Find the local index of the side in the element
 4593:                const int idxSide = elem->sideLocalIdx(side);
 4594:                // Find the two sides that are connected to the side under consideration
 4595:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4596:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4597: 
 4598:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4599: 
 4600:             }
 4601: 
 4602:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4603:    
 4604:          }
 4605:       }
 4606:       else if constexpr(ihorcon == 2) {
 4607:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4608:       }
 4609: 
 4610: 
 4611:    }
 4612: 
 4613: 
 4614:    __global__ void setEssentialBC(void) {
 4615:       // Set essential boundary conditions 
 4616:       NODE(node); // Each boundary node
 4617:       NodeBoundary *nodeBnd = node->nodeBnd;
 4618:       
 4619: // nodeBnd->isEssentialBC = true;      
 4620:       // Check if this node has essential BC
 4621:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4622:          // Verify BC value is valid
 4623:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4624: 
 4625:        
 4626:          // Set diagonal to 1 and zero off-diagonals
 4627:          node->coeffDiag = 1.0;
 4628: 
 4629:          for (int j = 0; j < node->numNodes; j++) {
 4630:                node->coeffMatrix[j] = 0.0;
 4631:          }
 4632:          
 4633:          // Set solution and RHS to BC value
 4634:          node->mX  = nodeBnd->elbc;
 4635:          node->qel = nodeBnd->elbc;
 4636: 
 4637:       } else {
 4638:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4639: 
 4640:          for (int j = 0; j < node->numNodes; j++) {
 4641:                Node* nbNode = node->nodes[j];
 4642:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4643:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4644:                   // Verify neighbor's BC value
 4645:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4646: 
 4647:                   // Subtract contribution to RHS
 4648:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4649:                   node->coeffMatrix[j] = 0.0;  
 4650:                }
 4651:          }
 4652:       }
 4653:    }
 4654: 
 4655: 
 4656:    __global__ void updateElevation(void) {
 4657:       NODE(node);
 4658: 
 4659:       node->eta2 = node->mX;
 4660: 
 4661:       node->updateZCoordData();
 4662:    }
 4663: 
