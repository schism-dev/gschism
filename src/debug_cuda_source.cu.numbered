  322: __device__ __forceinline__ double clamp(double x, double minval, double maxval) {
  323:    assert(minval <= maxval && "clamp: minval > maxval");
  324:    return fmin(fmax(x, minval), maxval);
  325: }
  326: 
  327: __device__ __forceinline__ int clamp(int x, int minval, int maxval) {
  328:    assert(minval <= maxval && "clamp: minval > maxval");
  329:    return max(minval, min(x, maxval));
  330: }
