 1896: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 1897:                    Side *side = &(mesh->localSideData[idx_side]); \
 1898:                    if (idx_side >= mesh->ns) return;
 1899: 
