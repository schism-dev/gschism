 1577: // Helper functions for computing the local node index at a given offset from another.
 1578: __device__ __inline__ int nxq(int offset, int index, int size) {
 1579:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1580:    // to the index to make it positive
 1581:    assert(index + offset + 16*size >= 0);
 1582:    return (index + offset + 16*size) % size;  
 1583: }
 1584: 
 1585: __device__ __inline__ int nxq(int index, int size) {
 1586:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1587:    // to the index to make it positive
 1588:    assert(index + 16*size >= 0);
 1589:    return (index + 16*size) % size; 
 1590: }
