 7975: __global__ void printMatrix(bool full) {
 7976:    // Debugging: print the matrix
 7977: 
 7978:    const int size = mesh->np;
 7979:    double sum = 0.0;
 7980:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7981:       const Node *node = mesh->localNodeData + idx_node;
 7982:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7983:       for (int j = 0; j < node->numNodes; j++) {
 7984:          Node* nbNode = node->nodes[j];
 7985:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7986:          sum += node->coeffMatrix[j];
 7987:       }
 7988:       if (full) printf("]\n");
 7989: 
 7990: 
 7991:    }
 7992:    if (!full) printf("sum=%lf\n", sum);
 7993: }
