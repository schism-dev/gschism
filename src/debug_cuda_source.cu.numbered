 8185: __global__ void returnMatrix(double *res) {
 8186:    // Debugging: returns the matrix as a CuPy array
 8187: 
 8188:    const int size = mesh->np;
 8189:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8190:       const Node *node = mesh->localNodeData + idx_node;
 8191:       res[idx_node*size + idx_node] = node->coeffDiag;
 8192:       for (int j = 0; j < node->numNodes; j++) {
 8193:          Node* nbNode = node->nodes[j];
 8194:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 8195:       }
 8196: 
 8197:    }
 8198:    
 8199: }
