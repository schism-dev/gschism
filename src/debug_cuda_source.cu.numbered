 1785: // Convenience macros for accessing the objects in kernels.
 1786: 
 1787: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 1788:                    Side *side = &(mesh->localSideData[idx_side]); \
 1789:                    if (idx_side >= mesh->ns) return;
 1790: 
 1791: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 1792:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 1793:                    if (idx_elem >= mesh->ne) return;
 1794: 
 1795: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 1796:                    Node *node = &(mesh->localNodeData[idx_node]); \
 1797:                    if (idx_node >= mesh->np) return;
 1798: 
 1799: #define NODE_ALL(node, valid) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x;       \
 1800:                               Node *node = &(mesh->localNodeData[idx_node]); \
 1801:                               const bool valid = (idx_node < mesh->np);                   
 1802: 
 1803: 
 1804: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1805:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 1806:                            if (idx_node_bnd >= mesh->nbp) return;
 1807: 
 1808: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1809:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 1810:                            if (idx_side_bnd >= mesh->nbs) return;                           
