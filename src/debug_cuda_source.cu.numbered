 1699:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1700:       // Compute the different time ramps used in the code 
 1701:       // This function is performed by just one thread
 1702: 
 1703:       rampbc = 1.0;
 1704:       if constexpr(ibc == 0) {
 1705:          if (drampbc > 0.0) {
 1706:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1707:          } else {
 1708:             rampbc = 1.0;
 1709:          }
 1710:       }
 1711: 
 1712:       if (nws != 0) {
 1713:          if (drampwind > 0.0) {
 1714:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1715:          } else {
 1716:             rampwind = 1.0;
 1717:          }
 1718:       }
 1719: 
 1720:       if (drampwafo > 0.0) {
 1721:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1722:       } else {
 1723:          rampwafo = 1.0;
 1724:       }
 1725: 
 1726:       // For source/sinks
 1727:       if (if_source && dramp_ss > 0.0) {
 1728:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1729:       } else {
 1730:          ramp_ss = 1.0;
 1731:       }
 1732: 
 1733:       if (dramp > 0.0) {
 1734:          ramp = tanh(2.0*time/86400.0/dramp);
 1735:       } else {
 1736:          ramp = 1.0;
 1737:       }
 1738: 
 1739: 
 1740:    }
