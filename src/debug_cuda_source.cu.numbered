 2504: 
 2505:    template<typename T>
 2506:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 2507:       T values[4];
 2508:       getNodalValues(level, func, values);
 2509: 
 2510:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2511:       if constexpr (IsVector2<T>::value && ics == 2) {
 2512: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2513:          projectNodeVectorsToElementFrame(values);
 2514: printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2515:       }
 2516: 
 2517:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2518:    }
 2519: 
 2520:    template<typename T>
 2521:    __device__ __forceinline__ T Element::interpolate(const double shapeCoords[4], T Node::* field) const {
 2522:       T values[4];
 2523:       getNodalValues(field, values);
 2524: 
 2525:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2526:       if constexpr (IsVector2<T>::value && ics == 2) {
 2527: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2528:          projectNodeVectorsToElementFrame(values);
 2529: printf("interpolate 3: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2530:       }
 2531:       
 2532:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2533:    }
 2534: 
 2535: 
 2536:    template<typename T>
 2537:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
 2538:       T values[4];
 2539:       getNodalValues(level, field, values);
 2540:       
 2541: if (shapeCoords[0] > 1.1 || shapeCoords[1] > 1.1 || shapeCoords[2] > 1.1 || 
 2542:     shapeCoords[0] < -0.1 || shapeCoords[1] < -0.1 || shapeCoords[2] < -0.1) printf("XXX shapeCoords = (%.17f, %.17f, %.17f, %.17f)\n", shapeCoords[0], shapeCoords[1], shapeCoords[2], shapeCoords[3]);
 2543:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2544:       if constexpr (IsVector2<T>::value && ics == 2) {
 2545: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2546:          projectNodeVectorsToElementFrame(values);
 2547: // printf("interpolate 4: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2548:       }
 2549: 
 2550:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2551:    }
 2552: 
 2553:    template<typename T>
 2554:    __device__ __forceinline__ T Element::mean(T Node::* field) const {
 2555:       T values[4];
 2556:       getNodalValues(field, values);
 2557: 
 2558:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2559:       if constexpr (IsVector2<T>::value && ics == 2) {
 2560: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2561:          projectNodeVectorsToElementFrame(values);
 2562: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2563:       }
 2564: 
 2565:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2566:    }
 2567: 
 2568:    template<typename T>
 2569:    __device__ __forceinline__ T Element::mean(T Side::* field) const {
 2570:       T values[4];
 2571:       getSideValues(field, values);
 2572:       
 2573:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2574:       if constexpr (IsVector2<T>::value && ics == 2) {
 2575: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2576:          projectSideVectorsToElementFrame(values);
 2577: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2578:       }
 2579: 
 2580:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2581:    }   
 2582: 
 2583:    template<typename T>
 2584:    __device__ __forceinline__ T Element::mean(int level,  T (Side::*func)(int) const) const {
 2585: 
 2586:       T values[4];
 2587: 
 2588: 
 2589:       values[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2590:       values[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2591:       values[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2592:       if (isQuad()) values[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2593:       else          values[3] = T();
 2594: 
 2595:       if constexpr (IsVector2<T>::value && ics == 2) projectSideVectorsToElementFrame(values);
 2596: 
 2597:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2598:    }
