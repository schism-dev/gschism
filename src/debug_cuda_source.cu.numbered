 7247: __global__ void printMatrix(void) {
 7248:    // Debugging: print the matrix
 7249: 
 7250:    const int size = mesh->np;
 7251:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7252:       const Node *node = mesh->localNodeData + idx_node;
 7253:       printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7254:       for (int j = 0; j < node->numNodes; j++) {
 7255:          Node* nbNode = node->nodes[j];
 7256:          if (node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7257:       }
 7258:       printf("]\n");
 7259: 
 7260:    }
 7261: 
 7262: }
 7263: 
 7264: 
 7265: __global__ void returnMatrix(double *res) {
 7266:    // Debugging: returns the matrix as a CuPy array
 7267: 
 7268:    const int size = mesh->np;
 7269:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7270:       const Node *node = mesh->localNodeData + idx_node;
 7271:       res[idx_node*size + idx_node] = node->coeffDiag;
 7272:       for (int j = 0; j < node->numNodes; j++) {
 7273:          Node* nbNode = node->nodes[j];
 7274:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7275:       }
 7276: 
 7277:    }
 7278:    
 7279: }
 7280: 
 7281: 
 7282: __global__ void computeMatrixProductAndDotProducts() {
 7283:    // Computes A*p, r'Mr and p'Ap
 7284: 
 7285:    // 1) shared buffer: first half for rMr, second for pAp
 7286:    __shared__ double sdata[2*BLOCK_SIZE];
 7287:    double* s_rMr = sdata;
 7288:    double* s_pAp = sdata + BLOCK_SIZE;
 7289: 
 7290:    const int tid = threadIdx.x;
 7291: 
 7292:    double l_pAp = 0.0;
 7293: 
 7294:    s_rMr[tid] = 0.0;
 7295:    s_pAp[tid] = 0.0;
 7296: 
 7297:    // 2) get your node pointer
 7298:    // NODE(node);   
 7299:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7300:    Node *node = &(mesh->localNodeData[idx_node]); 
 7301:    if (idx_node < mesh->np) {
 7302: 
 7303: 
 7304:    const double diag = node->coeffDiag;
 7305:    const double r    = node->mR;
 7306:    const double p    = node->mP;  
 7307: 
 7308:    // apply preconditioner on the fly:
 7309:    // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7310: 
 7311:    // 4) compute Ap = A.p
 7312:    double Ap = node->coeffDiag * node->mP;
 7313:    for (int j = 0; j < node->numNodes; ++j) {
 7314:       const Node *nbNode = node->nodes[j];
 7315:       Ap += node->coeffMatrix[j] * nbNode->mP;
 7316: 
 7317:    }
 7318: 
 7319:    node->mAp = Ap;
 7320:     
 7321: 
 7322:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 7323:    // const double l_rMr = r*Mr;  // r'Mr
 7324:    l_pAp = p*Ap;  // p'Ap
 7325: 
 7326: 
 7327:    }
 7328: 
 7329:    // 6) write into shared mem
 7330:    // s_rMr[tid] = l_rMr;
 7331:    s_pAp[tid] = l_pAp;
 7332: 
 7333:    __syncthreads();
 7334: 
 7335:    // 7) block-wide tree reduction
 7336:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7337:       if (tid < stride)  {
 7338:          s_pAp[tid] += s_pAp[tid + stride];
 7339:       }
 7340:       __syncthreads();
 7341:    }
 7342: 
 7343:    // 8) thread 0 atomically accumulates into the globals
 7344:    // XXX: This is slower than it needs to be, but it is simple and works
 7345:    if (tid == 0) {
 7346:       atomicAdd(pAp, s_pAp[0]);
 7347:    }
 7348: 
 7349: 
 7350: }
 7351: 
 7352: 
 7353: __global__ void updateSolutionAndDotProducts(void) {
 7354:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7355: 
 7356:    const int tid = threadIdx.x;
 7357: 
 7358:    s_rMr[tid] = 0.0;
 7359: 
 7360:    // get node & bounds-check:
 7361:    NODE(node);
 7362: 
 7363:    
 7364:    // Compute alpha
 7365:    const double alpha = (*rMr_old)/(*pAp);
 7366: 
 7367:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7368: 
 7369: 
 7370:    // load scalars
 7371:    const double diag = node->coeffDiag;
 7372:    const double p    = node->mP;
 7373:    const double Ap   = node->mAp;
 7374:    const double x    = node->mX;
 7375:    const double r    = node->mR;
 7376:    
 7377:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7378: 
 7379:    // 1) update solution & residual
 7380:    const double x_new = x + alpha*p;
 7381:    const double r_new = r - alpha*Ap;
 7382:    node->mX = x_new;
 7383:    node->mR = r_new;
 7384: 
 7385:    // 2) apply Jacobi preconditioner on the fly
 7386:    const double Mr_new = r_new/diag;
 7387: 
 7388: 
 7389:    // 3) local contributions for the two dot-products
 7390:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7391: 
 7392:    // 4) write into shared-mem
 7393:    s_rMr[tid] = l_rMr;
 7394: 
 7395:    __syncthreads();
 7396: 
 7397: 
 7398:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7399:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7400:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7401:       __syncthreads();
 7402:    }
 7403: 
 7404:    // 6) thread 0 atomically folds into the global accumulators
 7405:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7406: 
 7407: 
 7408: }
 7409: 
 7410: 
 7411: __global__ void updateSearchDirection() {
 7412: 
 7413:     NODE(node);
 7414: 
 7415:     // recompute z on-the-fly
 7416:     const double z = node->mR / node->coeffDiag;
 7417:     const double p = node->mP;
 7418: 
 7419:     const double beta = (*rMr_new)/(*rMr_old);
 7420: 
 7421: 
 7422:     // p =z + beta*p
 7423:     node->mP = z + beta*p;
 7424: 
 7425: }
 7426: 
 7427: __global__ void initializePreconditionedResidual(double *scalars) {
 7428: 
 7429:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 7430: 
 7431:     s_rMr[threadIdx.x] = 0.0;
 7432: 
 7433:     NODE(node);
 7434:     const int tid = threadIdx.x;
 7435:     // For the first iteration:
 7436:     // 1. Initial solution x = 0 (already set)
 7437:     // 2. Initial residual r = b (stored in qel)
 7438:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7439: 
 7440: // XXX we should use the guess solution here    
 7441: 
 7442:     // Set initial residual r = b (from qel)
 7443:     node->mR = node->qel;
 7444: 
 7445:     // Compute z = M^-1 * r (preconditioned residual)
 7446:     const double z = node->mR / node->coeffDiag;
 7447: 
 7448:     // Set initial search direction p = z
 7449:     node->mP = z;
 7450: 
 7451:     // Initialize other variables needed for CG
 7452:     node->mX = 0.0;  // Initial solution
 7453:     node->mAp = 0.0; // Will be computed in first iteration
 7454: 
 7455:     // These point to a cupy array in the host code
 7456:     rMr_old = scalars + 0;
 7457:     rMr_new = scalars + 1;
 7458:     pAp     = scalars + 2;
 7459: 
 7460:     // Computes the first r'Mr (reduction)
 7461:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7462: 
 7463:     // 4) write into shared-mem
 7464:     s_rMr[tid] = l_rMr;
 7465: 
 7466:     __syncthreads();
 7467: 
 7468: 
 7469:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7470:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7471:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7472:         __syncthreads();
 7473:     }
 7474: 
 7475:     // 6) thread 0 atomically folds into the global accumulators
 7476:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7477: 
 7478:     *rMr_old = 0.0;
 7479:     *pAp = 0.0;
 7480: }
 7481: 
 7482: 
 7483: 
 7484: 
 7485: extern "C" __global__ void getElementVar(int varCode, double *var, int k = -1, int j = -1) {
 7486:    // Get the value of a variable from an element
 7487:    // varName is the name of the variable to get
 7488:    // var is the array to store the value
 7489:    // k is the vertical level index of the variable to get
 7490: 
 7491:    ELEM(elem);
 7492:    
 7493:    int idx = elem->idx;
 7494:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7495: 
 7496:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7497:    if      (varCode == (int)VarCode::w && k >= 0)       var[idx] = elem->w[k];
 7498:    else if (varCode == (int)VarCode::z && k >= 0)       var[idx] = elem->z[k];
 7499:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = elem->center.x;
 7500:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = elem->center.y;
 7501:    else if (varCode == (int)VarCode::area && k == -1)   var[idx] = elem->area;
 7502:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = elem->depth;
 7503:    else if (varCode == (int)VarCode::radius && k == -1) var[idx] = elem->radius;
 7504:    else if (varCode == (int)VarCode::xlon && k == -1)   var[idx] = elem->xlon;
 7505:    else if (varCode == (int)VarCode::ylat && k == -1)   var[idx] = elem->ylat;
 7506:    else if (varCode == (int)VarCode::ghatx && k == -1)  var[idx] = elem->ghat1.x;
 7507:    else if (varCode == (int)VarCode::ghaty && k == -1)  var[idx] = elem->ghat1.y;
 7508:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(elem->kb);
 7509:    else if (varCode == (int)VarCode::ssign && k == -1 && j > -1)  var[idx] = (double)(elem->ssign[j]);
 7510:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7511:       
 7512:    
 7513: }
 7514: 
 7515: 
 7516: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7517:    // Get the value of a variable from an node
 7518:    // varName is the name of the variable to get
 7519:    // var is the array to store the value
 7520:    // k is the vertical level index of the variable to get
 7521: 
 7522:    NODE(node);
 7523:    
 7524:    int idx = node->idx;
 7525:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7526: 
 7527:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7528:    
 7529:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7530:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7531:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = node->p.y;
 7532:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7533:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 7534:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7535:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7536:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;   
 7537:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7538:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7539:    else if (varCode == (int)VarCode::v && k >= 0)       var[idx] = node->u2[k].y;
 7540:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->u2[k].z;
 7541:    
 7542:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7543:       
 7544:    
 7545: }
 7546: 
 7547: 
 7548: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7549:    // Get the value of a variable from an side
 7550:    // varName is the name of the variable to get
 7551:    // var is the array to store the value
 7552:    // k is the vertical level index of the variable to get
 7553:    SIDE(side);
 7554:    
 7555:    int idx = side->idx;
 7556:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7557: 
 7558:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 7559:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 7560:    else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 7561:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 7562:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 7563:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 7564:    else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 7565:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 7566:    else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 7567:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 7568:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 7569:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 7570:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 7571:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 7572:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 7573:    else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 7574:    else if (varCode == (int)VarCode::bccx && k >= 0)     var[idx] = side->bcc[k].x;
 7575:    else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 7576:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7577:    else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7578:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7579:    else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7580:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 7581:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->isLand:0.0;
 7582:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 7583:    else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 7584:    else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 7585:    else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 7586:    else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 7587:    else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 7588:    else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 7589:    else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 7590:    else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 7591:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7592: }
