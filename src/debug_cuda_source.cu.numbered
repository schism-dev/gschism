  764: 
  765:    __device__ bool findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement, double &t, 
  766:                                         double& tIntersect);
  767: 
  768:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  769:       // Check if the point (xt,yt) is inside the element
  770:       double shpCoords[4];
  771: 
  772:       bool res = computeShapeCoords(xt, shpCoords, fiNo);
  773: 
  774:       return res;
  775:    }
  776: 
  777:    __inline__ __device__ bool containsPoint(Vector2 &xt, bool fixCoords) const { 
  778:       // Check if the point (xt,yt) is inside the element.
  779:       // If fixCoords is true, and *the point is inside the element*, the point is nudged to be inside the element.
  780:       double shpCoords[4];
  781: 
  782:       Vector2 tmp_xt = xt;
  783:       const EFixIf fixIfCoords = fixCoords ? fiOnlyInside : fiNo;
  784:       bool res = computeShapeCoords(tmp_xt, shpCoords, fixIfCoords);
  785: 
  786:       if (fixCoords && res) xt = tmp_xt;
  787: 
  788:       return res;
  789:    }
  790: 
  791:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  792:    {
  793:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  794:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  795:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  796:       
  797:    }
  798: 
  799:    __device__ Vector3 interpolateVelocities(Point3 xt) const;
  800: 
  801:    // ------------------------------------------------------------------------------------------------
  802:    // These are functions that work on all nodes of the element.
  803:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  804:    //
  805:    // An example of how to use these functions is:
  806:    //   
  807:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  808:    // 
  809:    // Where L is the level at which the field is to be interpolated. The field can be either
  810:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  811:    // There are different versions of getNodalValues for each of these cases.
  812: 
  813:    template<typename T>
  814:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  815:       // Get the values of the field at the nodes of the element
  816:       res[0] = nodes[0]->*field;
  817:       res[1] = nodes[1]->*field;
  818:       res[2] = nodes[2]->*field;
  819:       if (isQuad()) res[3] = nodes[3]->*field;
  820:       else          res[3] = T();
  821:    }
  822: 
  823:    template<typename T>
  824:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  825:       // Get the values of the field at the nodes of the element
  826:       res[0] = (nodes[0]->*field)[level];
  827:       res[1] = (nodes[1]->*field)[level];
  828:       res[2] = (nodes[2]->*field)[level];
  829:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  830:       else          res[3] = T();
  831:    }    
  832: 
  833:    template<typename T>
  834:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  835:       // Get the values of the func at the nodes of the element
  836:       res[0] = (nodes[0]->*func)(level);
  837:       res[1] = (nodes[1]->*func)(level);
  838:       res[2] = (nodes[2]->*func)(level);
  839:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  840:       else          res[3] = T();  // This is 0.0 or a zero vector
  841: 
  842:    }      
  843: 
  844:    template<typename T>
  845:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  846:       // Get the values of the field at the nodes of the element
  847:       res[0] = sides[0]->*field;
  848:       res[1] = sides[1]->*field;
  849:       res[2] = sides[2]->*field;
  850:       if (isQuad()) res[3] = sides[3]->*field;
  851:       else          res[3] = T();
  852:    }
  853: 
  854:    template<typename T>
  855:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  856:       // Get the values of the field at the nodes of the element
  857:       res[0] = (sides[0]->*field)[level];
  858:       res[1] = (sides[1]->*field)[level];
  859:       res[2] = (sides[2]->*field)[level];
  860:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  861:       else          res[3] = T();
  862:    }    
  863: 
  864:    template<typename T>
  865:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  866:       // Get the values of the func at the nodes of the element
  867:       res[0] = (sides[0]->*func)(level);
  868:       res[1] = (sides[1]->*func)(level);
  869:       res[2] = (sides[2]->*func)(level);
  870:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  871:       else          res[3] = T();  // This is 0.0 or a zero vector
  872: 
  873:    }      
  874: 
  875:    template<typename T>
  876:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
  877:       T values[4];
  878:       getNodalValues(level, func, values);
  879: 
  880:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  881:    }
  882: 
  883:    template<typename T>
  884:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  885:       T values[4];
  886:       getNodalValues(field, values);
  887:       
  888:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  889:    }
  890: 
  891: 
  892:    template<typename T>
  893:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  894:       T values[4];
  895:       getNodalValues(level, field, values);
  896: 
  897:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  898:    }
  899: 
  900:    template<typename T>
  901:    __device__ T mean(T Node::* field) const {
  902:       T values[4];
  903:       getNodalValues(field, values);
  904: 
  905:       assert(i34 == 4 || values[3] == T() && "mean: values[3] is not zero with i34 == 4");
  906: 
  907:       return (values[0] + values[1] + values[2] + values[3])/i34;
  908:    }
  909: 
  910:    template<typename T>
  911:    __device__ T mean(T Side::* field) const {
  912:       T values[4];
  913:       getSideValues(field, values);
  914:       
  915:       assert((i34 == 4) || (values[3] == T()) && "mean: values[3] is not zero with i34 == 4");
  916: 
  917:       return (values[0] + values[1] + values[2] + values[3])/i34;
  918:    }   
  919: 
  920:    template<typename T>
  921:    __device__ T mean(int level, T (Node::* field)[nvrt]) const {
  922:       T values[4];
  923:       getNodalValues(level, field, values);
  924: 
  925:       assert((i34 == 4) || (values[3] == T()) && "mean: values[3] is not zero with i34 == 4");
  926: 
  927:       return (values[0] + values[1] + values[2] + values[3])/i34;
  928:    }
  929: 
  930:    template<typename T>
  931:    __device__ T mean(int level, T (Side::* field)[nvrt]) const {
  932:       T values[4];
  933:       getSideValues(level, field, values);
  934:       
  935:       // assert((i34 == 4) || (values[3] == T()) && "mean: values[3] is not zero with i34 == 4");
  936: 
  937:       return (values[0] + values[1] + values[2] + values[3])/i34;
  938:    }   
  939: 
  940:    // __device__ double mean(double (Node::*func)(int) const) const {
  941:    //    double values[4];
  942:    //    getNodalValues(level, func, values);
  943:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  944:    // }
