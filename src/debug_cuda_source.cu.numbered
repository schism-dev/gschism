 5109: extern "C" {
 5110: 
 5111:    __global__ void scaleGravity(double loadtide_coef) {
 5112: 
 5113: 
 5114:       NODE(node);
 5115: 
 5116:       // SAL option: scale gravity
 5117:       if constexpr(iloadtide==2) {  // simple const
 5118:          node->grav2 = grav*(1.0 - loadtide_coef);
 5119: 
 5120:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 5121:         
 5122:           const double depth = max(node->depth, 0.0);
 5123:           const double tmp1 = sqrt(depth);
 5124:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 5125:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 5126:                              2.6969e-13*depth*depth*depth*tmp1;
 5127:           
 5128:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 5129:           
 5130: 
 5131: 
 5132:           node->grav2 = grav*(1.0 - beta_bar);
 5133: 
 5134:       } else {  // iloadtide=0,1
 5135:           node->grav2 = grav;
 5136: 
 5137:       }
 5138: 
 5139:    }
