 6661: __global__ void printMatrix(void) {
 6662: 
 6663: 
 6664:    // Let only one thread per block print at a time 
 6665: 
 6666:    if (threadIdx.x == 0) {
 6667:       for (int ithread = 0; ithread < blockDim.x; ithread++) {
 6668:          const int idx_node = ithread + blockIdx.x * blockDim.x;
 6669:          if (idx_node >= mesh->np) return;
 6670:          const Node *node = mesh->localNodeData + idx_node;
 6671:          printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 6672:          for (int j = 0; j < node->numNodes; j++) {
 6673:             Node* nbNode = node->nodes[j];
 6674:             if (node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 6675:          }
 6676:          printf("]\n");
 6677: 
 6678:       }
 6679:    }
 6680: 
 6681: 
 6682: 
 6683: }
 6684: 
 6685: 
 6686: __global__ void computeMatrixProductAndDotProducts() {
 6687:    // Computes A*p, r'Mr and p'Ap
 6688: 
 6689:    // 1) shared buffer: first half for rMr, second for pAp
 6690:    __shared__ double sdata[2*BLOCK_SIZE];
 6691:    double* s_rMr = sdata;
 6692:    double* s_pAp = sdata + BLOCK_SIZE;
 6693: 
 6694:    s_rMr[threadIdx.x] = 0.0;
 6695:    s_pAp[threadIdx.x] = 0.0;
 6696: 
 6697:    // 2) get your node pointer
 6698:    NODE(node);  
 6699:    const int tid = threadIdx.x;
 6700: 
 6701:    const double diag = node->coeffDiag;
 6702:    const double r    = node->mR;
 6703:    const double p    = node->mP;  
 6704: 
 6705:    // apply preconditioner on the fly:
 6706:    const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 6707: 
 6708:    // 4) compute Ap = A.p
 6709:    double Ap = node->coeffDiag * node->mP;
 6710:    for (int j = 0; j < node->numNodes; ++j) {
 6711:       const Node *nbNode = node->nodes[j];
 6712:       Ap += node->coeffMatrix[j] * nbNode->mP;
 6713: 
 6714:    }
 6715:    node->mAp = Ap;
 6716:     
 6717: 
 6718:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 6719:    const double l_rMr = r*Mr;  // r'Mr
 6720:    const double l_pAp = p*Ap;  // p'Ap
 6721: 
 6722:    // 6) write into shared mem
 6723:    s_rMr[tid] = l_rMr;
 6724:    s_pAp[tid] = l_pAp;
 6725: 
 6726:    __syncthreads();
 6727: 
 6728:    // 7) block-wide tree reduction
 6729:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 6730:       if (tid < stride)  s_pAp[tid] += s_pAp[tid + stride];
 6731:       __syncthreads();
 6732:    }
 6733: 
 6734:    // 8) thread 0 atomically accumulates into the globals
 6735:    // XXX: This is slower than it needs to be, but it is simple and works
 6736:    if (tid == 0) atomicAdd(pAp, s_pAp[0]);
 6737: 
 6738: 
 6739: }
 6740: 
 6741: 
 6742: __global__ void updateSolutionAndDotProducts(void) {
 6743:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 6744: 
 6745:    s_rMr[threadIdx.x] = 0.0;
 6746: 
 6747: 
 6748:    // get node & bounds-check:
 6749:    NODE(node);
 6750:    const int tid = threadIdx.x;
 6751: 
 6752: 
 6753:    // Compute alpha
 6754:    const double alpha = (*rMr_old)/(*pAp);
 6755: 
 6756:    // load scalars
 6757:    const double diag = node->coeffDiag;
 6758:    const double p    = node->mP;
 6759:    const double Ap   = node->mAp;
 6760:    const double x    = node->mX;
 6761:    const double r    = node->mR;
 6762:    
 6763:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 6764: 
 6765:    // 1) update solution & residual
 6766:    const double x_new = x + alpha*p;
 6767:    const double r_new = r - alpha*Ap;
 6768:    node->mX = x_new;
 6769:    node->mR = r_new;
 6770: 
 6771:    // 2) apply Jacobi preconditioner on the fly
 6772:    const double Mr_new = r_new/diag;
 6773: 
 6774: 
 6775:    // 3) local contributions for the two dot-products
 6776:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 6777: 
 6778:    // 4) write into shared-mem
 6779:    s_rMr[tid] = l_rMr;
 6780: 
 6781:    __syncthreads();
 6782: 
 6783: 
 6784:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 6785:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 6786:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 6787:       __syncthreads();
 6788:    }
 6789: 
 6790:    // 6) thread 0 atomically folds into the global accumulators
 6791:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 6792: 
 6793: 
 6794: }
 6795: 
 6796: 
 6797: __global__ void updateSearchDirection() {
 6798:     NODE(node);
 6799: 
 6800:     // recompute z on-the-fly
 6801:     const double z = node->mR / node->coeffDiag;
 6802:     const double p = node->mP;
 6803: 
 6804:     const double beta = (*rMr_new)/(*rMr_old);
 6805: 
 6806: // printf("ZZZ updateSearchDirection: beta = %f\n", beta);
 6807: 
 6808:     // p =z + beta*p
 6809:     node->mP = z + beta*p;
 6810: 
 6811: }
 6812: 
 6813: __global__ void initializePreconditionedResidual(double *scalars) {
 6814: 
 6815:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 6816: 
 6817:     s_rMr[threadIdx.x] = 0.0;
 6818: 
 6819:     NODE(node);
 6820:     const int tid = threadIdx.x;
 6821:     // For the first iteration:
 6822:     // 1. Initial solution x = 0 (already set)
 6823:     // 2. Initial residual r = b (stored in qel)
 6824:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 6825: 
 6826: // XXX we should use the guess solution here    
 6827: 
 6828:     // Set initial residual r = b (from qel)
 6829:     node->mR = node->qel;
 6830: 
 6831:     // Compute z = M^-1 * r (preconditioned residual)
 6832:     const double z = node->mR / node->coeffDiag;
 6833: 
 6834:     // Set initial search direction p = z
 6835:     node->mP = z;
 6836: 
 6837:     // Initialize other variables needed for CG
 6838:     node->mX = 0.0;  // Initial solution
 6839:     node->mAp = 0.0; // Will be computed in first iteration
 6840: 
 6841:     // These point to a cupy array in the host code
 6842:     rMr_old = scalars + 0;
 6843:     rMr_new = scalars + 1;
 6844:     pAp     = scalars + 2;
 6845: 
 6846:     // Computes the first r'Mr (reduction)
 6847:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 6848: 
 6849:     // 4) write into shared-mem
 6850:     s_rMr[tid] = l_rMr;
 6851: 
 6852:     __syncthreads();
 6853: 
 6854: 
 6855:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 6856:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 6857:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 6858:         __syncthreads();
 6859:     }
 6860: 
 6861:     // 6) thread 0 atomically folds into the global accumulators
 6862:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 6863: 
 6864:     *rMr_old = 0.0;
 6865:     *pAp = 0.0;
 6866: }
 6867: 
 6868: 
 6869: 
 6870: 
 6871: 
