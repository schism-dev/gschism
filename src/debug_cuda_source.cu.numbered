 1565: __device__ __inline__ double min3(double a, double b, double c) {
 1566:    return min(a, min(b, c));
 1567: }
 1568: 
 1569: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1570:    return min(a, min(b, min(c, d)));
 1571: }
