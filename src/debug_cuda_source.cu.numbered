 2150: 
 2151: /**
 2152:    Compute the shape coordinates of the point (xt,yt) in the element.
 2153:    @param xt (input): x-coordinate of the point
 2154:    @param shpCoords (output): shape coordinates of the point
 2155:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2156:    @return true if the point is inside the element, false otherwise
 2157: **/
 2158: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2159:                                             bool fixNegshpCoord) const {
 2160: 
 2161:    // Compute the shape coordinates of the point xt in the element.
 2162:    if (i34==3) {
 2163:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2164:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2165:       // and in this case, the pt will be nudged into the element
 2166:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2167:       // from the local frame, so use additional check.
 2168: 
 2169:       Point2 x0, x1, x2;
 2170: 
 2171:       if constexpr(ics==1) {
 2172:          x0 = nodes[0]->p;
 2173:          x1 = nodes[1]->p;
 2174:          x2 = nodes[2]->p;
 2175:       }
 2176:       else // lat/lon
 2177:       {
 2178:          Error("Not implemented yet");
 2179:          // globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2180:          // globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2181:          // globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2182:       }
 2183: 
 2184:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2185:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2186:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2187:       shpCoords[3] = 0.0;
 2188: 
 2189:       const double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2190:       const bool res = (tmpmin >= -small);     
 2191: 
 2192:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2193:       // then we fix the negative shape coordinates.
 2194:       if ((tmpmin < 1.0e-4) && fixNegshpCoord) {
 2195: 
 2196:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2197:          // keeping the sum of the shape coordinates equal to 1.
 2198:          // I have tested and compared the new algorithm with the old one, and they give
 2199:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2200:          // The new algorithm should be faster since it is branchless.
 2201:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2202:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2203:          
 2204:          shpCoords[0] = (shpCoords[0] + a)*b;
 2205:          shpCoords[1] = (shpCoords[1] + a)*b;
 2206:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2207: 
 2208:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2209:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2210:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2211:          }
 2212: 
 2213:          // Update the point coordinates for the new shape coordinates
 2214:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2215:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2216:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2217: 
 2218:       }
 2219: 
 2220:       // Check if the point is inside the element
 2221:       return res;      
 2222:    }
 2223:    else {
 2224:       Error("Not implemented yet");
 2225: #ifdef QUADS
 2226:       // Reproject pt in eframe of nel for ics=2
 2227:       if constexpr(ics==1) {
 2228:          xn2 = xt; 
 2229:          yn2 = yt;
 2230:       }
 2231:       else {
 2232:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2233:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2234:       }
 2235: 
 2236:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2237: #endif
 2238:    }
 2239: 
 2240:    assert(false && "computeShapeCoords: should never reach this point");
 2241:    return false;  // Never reached
 2242: 
 2243: }
 2244: 
 2245: 
 2246: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2247: // Convert shape coordinates to cartesian coordinates
 2248: 
 2249:    if (i34 == 3) {
 2250:       // Triangular element
 2251:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2252:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2253:    }
 2254:    else {
 2255:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2256:    }
 2257: 
 2258: }
 2259: 
 2260: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2261:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2262:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2263:    // The formula for the integral is:
 2264:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2265: 
 2266:    printf("intPhiPhi: TEST\n");
 2267: 
 2268:    const Node *n0 = nodes[0];
 2269:    const Node *n1 = nodes[1];
 2270:    const Node *n2 = nodes[2];
 2271:    const Node *n3 = nodes[3];
 2272: 
 2273:    const Vector2 p0 = n0->p;
 2274:    const Vector2 p1 = n1->p;
 2275:    const Vector2 p2 = n2->p;
 2276:    const Vector2 p3 = n3->p;
 2277: 
 2278:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2279:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2280:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2281:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2282: 
 2283:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2284: }
 2285:    
 2286: 
 2287: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2288:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2289:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2290:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2291:    // The formula is also based on the identity:
 2292:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2293:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2294: 
 2295:    printf("intGradPhiGradPhi: TEST\n");   
 2296: 
 2297:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2298: 
 2299:    const double x0 = nodes[0]->p.x;
 2300:    const double y0 = nodes[0]->p.y;
 2301:    const double x1 = nodes[1]->p.x;
 2302:    const double y1 = nodes[1]->p.y;
 2303:    const double x2 = nodes[2]->p.x;
 2304:    const double y2 = nodes[2]->p.y;
 2305:    const double x3 = nodes[3]->p.x;
 2306:    const double y3 = nodes[3]->p.y;
 2307: 
 2308:    double res = 0.0;
 2309:    
 2310:    // Quadrature points in xi and eta coordinates
 2311:    #pragma unroll
 2312:    for (int i = 0; i < 4; i++) {
 2313:       // For each quadrature point...
 2314: 
 2315:       const Point2 p = GaussPoint(i);
 2316:       const double eta = p.x;
 2317:       const double xi  = p.y;
 2318: 
 2319:       // Jacobian entries at the Gauss point p
 2320:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2321:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2322:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2323:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2324: 
 2325:       const double detJ = jacobianDet(p);
 2326:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2327: 
 2328:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2329:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2330:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2331:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2332:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2333: 
 2334:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2335:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2336:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2337:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2338:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2339: 
 2340:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2341:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2342:    }
 2343: 
 2344:    return res;
 2345: }
 2346: 
 2347: 
 2348: /**  Interpolate velocities at a given point (xt,yt,zt)
 2349: 
 2350:    @param xt, yt, zt: coordinates of the point to interpolate
 2351:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2352: 
 2353:    This is done in four steps:
 2354: 
 2355:    1. Find the shape coordinates for the final position in the element.
 2356:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2357:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2358:       z levels at xt, yt at each step.   
 2359:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2360:       horizontally and vertically.
 2361: **/
 2362: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2363:    // Interpolate the velocities at the point xt. 
 2364:    // This function works the same for triangular and quadrilateral elements.
 2365:    double shpCoord[4];
 2366: 
 2367:    // First step is to compute the shape coordinates of (xt,yt)
 2368:    computeShapeCoords(toVector2(xt), shpCoord, true);
 2369: 
 2370:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2371: 
 2372:    // Second step is to find the level that contains zt
 2373:    // Uses a binary search to find the level
 2374:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2375:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2376:    int R = nvrt - 1;
 2377: 
 2378:    // Get the z coordinates at the nodes of the element at the levels L and R
 2379:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 2380:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2381:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2382: 
 2383:    double zL = interpolate(shpCoord, zLAtNodes);
 2384:    double zR = interpolate(shpCoord, zRAtNodes);
 2385:    
 2386:    // Interpolates vertically the velocities
 2387:    double wght1, wght2;
 2388:    if (xt.z<=zL) {
 2389:       wght1 = 1.0;
 2390:       wght2 = 0.0;
 2391:       xt.z = zL;
 2392:    }
 2393:    else if (xt.z>=zR) {
 2394:       wght1 = 0.0;
 2395:       wght2 = 1.0;
 2396:       xt.z = zR;
 2397:    }
 2398:    else {
 2399:       // Perform a binary search to find the levels between L and R that contain xt.z
 2400:       while (R - L > 1) {
 2401:          int M = (L + R) / 2.0;
 2402: 
 2403:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2404:          double zM = interpolate(shpCoord, zMAtNodes);
 2405:          if (zM < xt.z) 
 2406:          {
 2407:             L = M;
 2408:             zL = zM;
 2409:          }
 2410:          else 
 2411:          {
 2412:             R = M;
 2413:             zR = zM;
 2414:          }
 2415:       }
 2416:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 2417:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2418: 
 2419:       wght2 = (xt.z - zL)/(zR - zL);
 2420:       wght1 = 1.0 - wght2;
 2421: 
 2422:    }
 2423: 
 2424: 
 2425:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2426:    u_int = wght1*interpolate(L, shpCoord, &Node::uvw2) + wght2*interpolate(R, shpCoord, &Node::uvw2);
 2427: 
 2428:    // Neither of the interpolated velocities should be NaN
 2429:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2430: 
 2431: }
 2432: 
 2433: 
 2434: 
 2435: 
 2436: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2437: 
 2438:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2439:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2440:    const Node *n1 = side->n1;
 2441:    const Node *n2 = side->n2;
 2442: 
 2443:    bool n1_match = (n1->nodeBnd->segment == segment);
 2444:    bool n2_match = (n2->nodeBnd->segment == segment);
 2445: 
 2446:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2447:    if (n1_match && n2_match) {
 2448:       return 0.5;
 2449:    } else if (n1_match) {
 2450:       return 1.0;
 2451:    } else if (n2_match) {
 2452:       return 0.0;
 2453:    }
 2454: 
 2455:    return 0.0;
 2456: }
 2457: 
 2458: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2459: 
 2460: 
 2461: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2462: 
 2463:    const double w1 = getBoundaryArrayValueWeight();
 2464:    const double w2 = 1.0 - w1;
 2465:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2466:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2467: 
 2468:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2469: }
 2470: 
 2471: 
 2472: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2473:    const double w1 = getBoundaryArrayValueWeight();
 2474:    const double w2 = 1.0 - w1;
 2475:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2476:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2477: 
 2478:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2479: 
 2480: }
 2481: 
 2482: 
 2483: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2484:    // Returns the value of the velocity at the side center
 2485:    const double w1 = getBoundaryArrayValueWeight();
 2486:    const double w2 = 1.0 - w1;
 2487:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2488:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2489: 
 2490:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2491: }
 2492: 
 2493: 
 2494: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2495:    // Returns the value of the normal component of the velocity at the side center
 2496:    const double w1 = getBoundaryArrayValueWeight();
 2497:    const double w2 = 1.0 - w1;
 2498:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2499:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2500: 
 2501:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2502: }
